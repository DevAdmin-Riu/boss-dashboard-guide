    # OrderFilter 로직 그대로 가져옴
    def filter_charge_status(qs, _, value):
        if value:
            qs = qs.exclude(order__status=OrderStatus.CANCELED)
            charge_status_values = set([])
            if OrderChargeStatusFilter.PENDING in value:
                charge_status_values.update(
                    [
                        ChargeStatus.PENDING,
                    ]
                )
            if OrderChargeStatusFilter.PARTIALLY_REFUNDED in value:
                charge_status_values.update([ChargeStatus.PARTIALLY_REFUNDED])
            if OrderChargeStatusFilter.CHARGED in value:
                charge_status_values.update(
                    [ChargeStatus.FULLY_CHARGED, ChargeStatus.PARTIALLY_CHARGED]
                )
            # FULLY_REFUNDED인경우 is_active가 false로 바뀌기때문에 아래와 같은 로직.
            if OrderChargeStatusFilter.FULLY_REFUNDED in value:
                qs = qs.filter(
                    Q(order__payments__charge_status__in=[ChargeStatus.FULLY_REFUNDED])
                    | Q(
                        order__payments__is_active=True,
                        order__payments__charge_status__in=charge_status_values,
                    )
                )
            elif charge_status_values:
                qs = qs.filter(
                    order__payments__is_active=True,
                    order__payments__charge_status__in=charge_status_values,
                )
            # FULLY_REFUNDED 도 없고 charge_status_values도 없는 경우에는 qs 그대로 돌려주는게 좋음.

        return qs

    # OrderFilter 로직 그대로 가져옴
    def filter_pay_method(qs, _, value):
        latest_payment = (
            Payment.objects.filter(order=OuterRef("order_id")).order_by("-pk").values("pk")[:1]
        )

        if value:
            qs = qs.annotate(
                latest_payment_id=Subquery(latest_payment),
                payment_is_toss_riu_pay=Case(
                    When(
                        order__payments__pk=F("latest_payment_id"),
                        then=F("order__payments__is_toss_riu_pay"),
                    ),
                ),
                payment_token=Case(
                    When(
                        order__payments__pk=F("latest_payment_id"), then=F("order__payments__token")
                    ),
                ),
                payment_credits=Case(
                    When(
                        order__payments__pk=F("latest_payment_id"),
                        then=F("order__payments__cashable_credits")
                        + F("order__payments__non_cashable_credits"),
                    ),
                ),
                payment_rcoins=Case(
                    When(
                        order__payments__pk=F("latest_payment_id"),
                        then=F("order__payments__rcoins"),
                    ),
                ),
            )

            card_filter = Q(payment_token__iexact=INICIS_PAY_METHOD_CARD) | Q(
                payment_token__iexact=TOSS_PAY_METHOD_CARD
            )
