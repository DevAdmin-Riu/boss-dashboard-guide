@app.task(name="stats.tasks.update_collected_at")
def update_collected_at_for_couriers_delivery_fee():
    """
    매일 실행되는 스케줄러.
    최근 15일 이내의 CouriersDeliveryFee 중 is_collected_corrected가 False인 것들을 조회하고,
    trackingDetails의 kind가 '집화처리'인 경우 collected_at 필드를 업데이트.
    """
    logger.info("update_collected_at_for_couriers_delivery_fee started.")

    # 기준 날짜 계산
    today = timezone.now()
    target_start_date = today - timedelta(days=15)

    # is_collected_corrected가 False이고 오늘 제외, 최근 15일 내 생성된 항목
    target_delivery_fees = CouriersDeliveryFee.objects.filter(
        Q(is_collected_corrected=False) & Q(created__lt=today, created__gte=target_start_date)
    )

    total_count = target_delivery_fees.count()
    success_count = 0
    skip_count = 0
    failure_count = 0

    logger.info(f"Found {total_count} couriers_delivery_fees for processing.")

    sweet_tracker_config = get_plugins_manager().get_sweet_tracker_plugin_config()

    for delivery_fee in target_delivery_fees:
        try:
            # delivery_info에서 필요한 정보 추출
            delivery_info = delivery_fee.delivery_info
            tracking_number = delivery_info.get("tracking_number")
            courier_code = delivery_info.get("courier_code")

            # 굿스플로에서 발급한 송장번호가 들어가므로 자릿수 체크는 하지 않음
            # 환불송장번호 발급 대기 전 "-" 가 들어가 있는 경우 예외처리만 함
            tracking_number_numeric_only = remove_all_non_numeric(tracking_number)
            if not tracking_number_numeric_only or not courier_code:
                logger.warning(
                    f"Skipping CouriersDeliveryFee ID {delivery_fee.id}: Invalid tracking_number={tracking_number}, courier_code={courier_code}"
                )
                skip_count += 1
                continue

            # API 호출
            response = send_sweet_tracker_request(
                sweet_tracker_config=sweet_tracker_config,
                code=courier_code,
                number=tracking_number_numeric_only,
            )

            # JSON 응답 처리
            tracking_details = response.get("trackingDetails", [])
            collected_detail = next(
                (detail for detail in tracking_details if detail.get("level") == 2),
                None,
            )

            if collected_detail:
                # Unix 밀리초 타임스탬프 -> Python datetime으로 변환
                collected_time = collected_detail.get("time")
                naive_datetime = datetime.fromtimestamp(collected_time / 1000)
                current_timezone = timezone.get_current_timezone()
                collected_at = timezone.make_aware(naive_datetime, current_timezone)

                # 모델 업데이트
                delivery_fee.collected_at = collected_at
                delivery_fee.is_collected_corrected = True
                delivery_fee.save()
                success_count += 1
            else:
                logger.warning(
                    f"No '집화처리' detail found for CouriersDeliveryFee ID {delivery_fee.id}"
                )
                skip_count += 1

        except Exception as e:
            import traceback

            traceback_str = traceback.format_exc()
            logger.error(
                f"Error processing CouriersDeliveryFee ID {delivery_fee.id}: {e} {traceback_str}"
            )
            failure_count += 1

    logger.info(
        f"update_collected_at_for_couriers_delivery_fee completed: "
        f"Total={total_count}, Success={success_count}, Skipped={skip_count}, Failed={failure_count}."
    )


@app.task(name="stats.tasks.update_return_tracking_numbers")
def update_return_tracking_numbers():
    """
    매일 새벽 4시에 실행되는 스케줄러.
    - 지정된 API 호출
    - CouriersDeliveryFee의 tracking_number 업데이트
    - 수신 처리
    """
    logger.info("update_tracking_numbers started.")

    goodsflow_plugin_config = get_plugins_manager().get_plugin_config_dot_map(GOODSFLOW_PLUGIN_ID)

    if goodsflow_plugin_config.is_prod_mode == True:
        config_base_url = goodsflow_plugin_config.base_url
        goodsFLOW_api_key = goodsflow_plugin_config.api_key
    else:
        config_base_url = goodsflow_plugin_config.dev_base_url
        goodsFLOW_api_key = goodsflow_plugin_config.dev_api_key

    trace_results_url = "delivery/api/v2/traceresults/"
    check_trace_results_url = "delivery/api/v2/traceresults/check-traceresults/"
    headers = build_api_header(goodsflow_plugin_config)
    headers["goodsFLOW-Api-Key"] = goodsFLOW_api_key

    # GET 요청
    try:
        combined_url = urljoin(config_base_url, trace_results_url)
        response = requests.get(combined_url, headers=headers)
        response_data = response.json()
        items = response_data.get("data", {}).get("items", [])
    except Exception as e:
        logger.error(f"Error fetching traceresults: {e}")
        return

    if not items:
        logger.info("No items found in traceresults API.")
        return

    # 처리 대상 필터링 및 업데이트
    update_items = []
    for item in items:
        unique_cd = item.get("uniqueCd", "")
        seq = item.get("seq")
        sheet_no = item.get("sheetNo")

        # 수신 처리에 필요한 데이터 추가
        update_items.append({"uniqueCd": unique_cd, "seq": seq})

        # uniqueCd "-R" 처리 및 변환
        if unique_cd.endswith("-R"):

            # CouriersDeliveryFee 업데이트
            try:
                courier_fee = CouriersDeliveryFee.objects.filter(
                    Q(delivery_info__unique_cd=unique_cd)
                ).first()

                if courier_fee:
                    courier_fee.delivery_info["tracking_number"] = sheet_no
                    courier_fee.save()
                    logger.info(
                        f"Updated CouriersDeliveryFee ID {courier_fee.id} with tracking_number {sheet_no}"
                    )

                else:
                    logger.warning(f"No CouriersDeliveryFee found for unique_cd {unique_cd}")
            except Exception as e:
                logger.error(f"Error updating CouriersDeliveryFee for uniqueCd {unique_cd}: {e}")

    # POST 요청으로 수신 처리
    if update_items:
        post_data = {"data": {"items": update_items}}
        try:
            post_response = requests.post(
                urljoin(config_base_url, check_trace_results_url), json=post_data, headers=headers
            )
            post_response_data = post_response.json()

            if post_response_data.get("success"):
                logger.info(f"Successfully processed {len(update_items)} traceresults.")
            else:
                logger.error(f"Failed to process traceresults: {post_response_data}")
        except Exception as e:
            logger.error(f"Error sending traceresults check-traceresults: {e}")
    else:
        logger.info("No items to process for traceresults check-traceresults.")

    logger.info("update_tracking_numbers completed.")


# mobile_app_info 정보를 가져와서 보스몰에 대한 안드로이드, iOS 앱 딥링크 URL을 가져옴
def make_app_deep_link_dict() -> Dict[str, str]:
    android_app_info = MobileAppInfo.objects.filter(type=MobileAppType.STOREFRONT_ANDROID).first()
    ios_app_info = MobileAppInfo.objects.filter(type=MobileAppType.STOREFRONT_IOS).first()
    android_deep_link = android_app_info.deep_link if android_app_info else ""
    ios_deep_link = ios_app_info.deep_link if ios_app_info else ""
    return {"android": android_deep_link, "ios": ios_deep_link}


