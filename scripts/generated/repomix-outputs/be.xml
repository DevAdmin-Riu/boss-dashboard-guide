from typing import Dict, Set, Tuple

from django.core.exceptions import ObjectDoesNotExist, ValidationError

from ....account.models import Brand
from ....product.models import BrandProductVariant, Product, ProductVariant
from ....site.models import RegionInfo
from ....vendor import VENDOR_CODE_PREFIX
from ....vendor.models import Maker, Vendor
from ...core.utils import get_duplicated_values


def validate_data_is_non_null(details):
    if details is None or len(details) <= 0:
        error_msg = "일괄 설정 데이터 비어 있음"
        raise ValidationError(error_msg)


def validate_duplicate(details, make_detail_code_func):
    check_codes = [make_detail_code_func(detail) for detail in details]
    duplicates = get_duplicated_values(check_codes)
    if duplicates:
        error_msg = "데이터 중복: {}".format((", ").join(duplicates))
        raise ValidationError(error_msg)


def validate_region(details) -> Dict[str, RegionInfo]:
    errors = []
    error_region_codes = set()
    region_ids = set()
    for detail in details:
        region_id = detail.get("region")
        if region_id:
            region_ids.add(region_id)
        else:
            region_code = detail.get("region_code")
            error_region_codes.add(region_code)

    if error_region_codes:
        error_msg = "권역 코드 오류: {}".format(", ".join(error_region_codes))
        raise ValidationError(error_msg)

    sorted_region_ids = sorted(region_ids)
    region_dict = {}
    for region_id in sorted_region_ids:
        try:
            region = RegionInfo.objects.get(id=region_id)
            region_dict[region_id] = region
        except ObjectDoesNotExist:
            errors.append(region_id)
            continue

    if len(errors) > 0:
        error_msg = "권역 Id 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return region_dict


def validate_brand_code(details) -> Dict[str, Brand]:
    errors = []
    brand_codes = set()
    for detail in details:
        brand_code = detail.get("brand_code")
        if brand_code:
            brand_codes.add(brand_code)

    sorted_brand_codes = sorted(brand_codes)
    brand_dict = {}
    for brand_code in sorted_brand_codes:
        try:
            brand = Brand.objects.get(code=brand_code)
            brand_dict[brand_code] = brand
        except ObjectDoesNotExist:
            errors.append(brand_code)
            continue

    if len(errors) > 0:
        error_msg = "브랜드 코드 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return brand_dict


def validate_vendor_code(
    details, allow_empty: bool = False, make_detail_code_fn=None
) -> Dict[str, Vendor]:
    empty_errors = []
    errors = []
    vendor_codes = set()
    for detail in details:
        vendor_code = detail.get("vendor_code")
        if vendor_code:
            vendor_codes.add(vendor_code)
        elif allow_empty == False:
            empty_errors.append(f"{make_detail_code_fn(detail)}")

    if empty_errors:
        error_msg = "협력사 코드 없음 오류: {}".format(", ".join(empty_errors))
        raise ValidationError(error_msg)

    sorted_vendor_codes = sorted(vendor_codes)
    vendor_dict = {}
    for vendor_code in sorted_vendor_codes:
        try:
            prefix = VENDOR_CODE_PREFIX
            if vendor_code.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = vendor_code[prefix_length:]
                vendor = Vendor.objects.get(id=pk_value)
                vendor_dict[vendor_code] = vendor
            else:
                errors.append(vendor_code)
        except Exception:
            errors.append(vendor_code)
            continue

    if len(errors) > 0:
        error_msg = "협력사 코드 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return vendor_dict


def validate_product_sku(details) -> Tuple[Set[Product], Dict[str, ProductVariant], Set[str]]:
    errors = []
    skus = set()
    for detail in details:
        product_sku = detail.get("product_sku")
        skus.add(product_sku)

    sorted_skus = sorted(skus)
    pv_dict = {}
    product_dict = set()
    for sku in sorted_skus:
        try:
            variant = ProductVariant.objects.select_related(
                "product", "product__category", "product__product_type"
            ).get(sku=sku)
            pv_dict[sku] = variant
            product_dict.add(variant.product)
        except ObjectDoesNotExist:
            errors.append(sku)
            continue

    if len(errors) > 0:
        error_msg = "제품코드 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return product_dict, pv_dict, skus


def validate_maker(cls, details, required: bool = False) -> Dict[str, Maker]:
    empty_errors = []
    errors = []
    maker_names = set()
    for detail in details:
        maker_name = detail.get("maker_name")
        if maker_name:
            maker_names.add(maker_name)
        elif required:
            empty_errors.append(cls.make_detail_code(detail))

    maker_dict = {}
    for maker_name in maker_names:
        try:
            maker = Maker.objects.get(name=maker_name)
            maker_dict[maker_name] = maker
        except ObjectDoesNotExist:
            errors.append(maker_name)
            continue

    if errors or empty_errors:
        error_msg = ""
        if empty_errors:
            error_msg = error_msg + "제조사 이름 없음: {}".format(", ".join(empty_errors))
        if errors:
            if error_msg:
                error_msg = error_msg + ", "
            error_msg = error_msg + "제조사 이름 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return maker_dict


def validate_brand_product_variant(cls, details, brand_dict, pv_dict):
    errors = []
    for detail in details:
        brand_code = detail.get("brand_code")
        if brand_code is None:
            continue

        product_sku = detail.get("product_sku")
        product_variant = pv_dict[product_sku]
        brand = brand_dict[brand_code]
        try:
            BrandProductVariant.objects.get(brand=brand, product_variant=product_variant)
        except ObjectDoesNotExist:
            errors.append(cls.make_detail_code(detail))

    if len(errors) > 0:
        error_msg = "브랜드 상품으로 연결되지 않은 데이터 존재: {}".format(", ".join(errors))
        raise ValidationError(error_msg)
