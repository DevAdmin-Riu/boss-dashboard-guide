    # ProductVariant model의 get_first_image 함수를 참고해서 작성됨.
    def resolve_thumbnail(root: OrderLineModel, info, *, size=255):
        def build_image_response(image, info, size):
            return Image(
                alt=image.alt,
                url=info.context.build_absolute_uri(
                    get_product_image_thumbnail(image, size, method="thumbnail")
                ),
            )

        def process_variant_images(variant, info, size):
            def handle_variant_images(images, variant, info, size):
                if images:
                    # sort_order, pk 순으로 정렬 후 첫 번째 이미지 사용
                    sorted_images = sorted(images, key=lambda img: (img.sort_order, img.pk))
                    return build_image_response(sorted_images[0], info, size)
                return load_product_images_from_variant(variant, info, size)

            if not variant:
                return None
            return (
                ImagesByProductVariantIdLoader(info.context)
                .load(variant.id)
                .then(lambda images: handle_variant_images(images, variant, info, size))
            )

        def load_product_images_from_variant(variant, info, size):
            def load_images_by_product(product, info, size):
                def handle_product_images(product_images, info, size):
                    if product_images:
                        # sort_order, pk 순으로 정렬 후 첫 번째 이미지 사용
                        sorted_product_images = sorted(
                            product_images, key=lambda img: (img.sort_order, img.pk)
                        )
                        return build_image_response(sorted_product_images[0], info, size)
                    return None

                if not product:
                    return None
                return (
                    ImagesByProductIdLoader(info.context)
                    .load(product.id)
                    .then(lambda product_images: handle_product_images(product_images, info, size))
                )

            return (
                ProductByIdAllLoader(info.context)
                .load(variant.product_id)
                .then(lambda product: load_images_by_product(product, info, size))
            )

        if root.variant_id:
            return (
                ProductVariantByIdLoader(info.context)
                .load(root.variant_id)
                .then(lambda variant: process_variant_images(variant, info, size))
            )
        return None

