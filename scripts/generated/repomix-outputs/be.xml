        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: "User" = context.user
        # 협력사인 경우 권한 체크 패스하고 validation 처리
        if user.is_vendor_staff:
            return True
        return super().check_permissions(context, **data)

    @classmethod
    def make_detail_code(cls, detail):
        order_number = detail.get("order_number")
        fulfillment_order = detail.get("fulfillment_order")
        return f"{NON_B2B_ORDER_PREFIX}{order_number}-{fulfillment_order}"

    @classmethod
    def validate_details_is_non_null(cls, details):
        if details is None or len(details) <= 0:
            error_msg = "일괄 출고 정보 변경 데이터가 비어 있습니다."
            raise ValidationError(error_msg)

    @classmethod
    def validate_delivery_method_and_tracking_number(cls, details):
        by_courier_errors = []
        courier_errors = []
        digit_allowed_errors = []
        by_truck_service_errors = []
        delivery_method_errors = []
        for detail in details:
            delivery_method = detail.get("delivery_method")
            detail_code = cls.make_detail_code(detail)
            if delivery_method == OrderDeliveryMethods.BY_COURIER:
                courier_id = detail.get("courier_id")
                tracking_number = detail.get("tracking_number")
                courier = None
                if not courier_id:
                    by_courier_errors.append(detail_code)
                else:
                    try:
                        _, courier_pk = graphene.Node.from_global_id(courier_id)
                        courier: "Courier" = courier_models.Courier.objects.get(pk=courier_pk)
                        detail["courier"] = courier
                    except ObjectDoesNotExist:
                        courier_errors.append(detail_code)
                if not tracking_number:
                    by_courier_errors.append(detail_code)
                else:
                    tracking_number_numeric_only = remove_all_non_numeric(tracking_number)
                    detail["tracking_number"] = tracking_number_numeric_only
                    if (
                        check_courier_digit_allowed_values(tracking_number_numeric_only, courier)
                        == False
                    ):
                        digit_allowed_errors.append(detail_code)

            elif delivery_method == OrderDeliveryMethods.BY_TRUCK_SERVICE:
                if detail.get("courier_id") or detail.get("tracking_number"):
                    by_truck_service_errors.append(detail_code)
            else:
                delivery_method_errors.append(detail_code)

        if by_courier_errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 택배 배송인 경우 택배사 Id, 송장번호가 필요합니다: {', '.join(by_courier_errors)}"
            )
        if by_truck_service_errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 화물차 배송인 경우 택배사 Id, 송장번호가 필요 없습니다: {', '.join(by_truck_service_errors)}"
            )
        if delivery_method_errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 배송 방식은 택배 / 화물차 중 하나여야 합니다.: {', '.join(delivery_method_errors)}"
            )
        if courier_errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 존재하지 않는 택배사 Id가 있습니다: {', '.join(courier_errors)}"
            )
        if digit_allowed_errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 송장번호 길이가 택배사 송장번호 자릿수와 다릅니다: {', '.join(digit_allowed_errors)}"
            )

    @classmethod
    def validate_fulfillment(cls, details):
        errors = []
        for detail in details:
            order_number = detail.get("order_number")
            fulfillment_order = detail.get("fulfillment_order")
            try:
                fulfillment = models.Fulfillment.objects.select_related(
                    "vendor__vendor_staff_user"
                ).get(order_id=order_number, fulfillment_order=fulfillment_order)
                detail["fulfillment"] = fulfillment
            except ObjectDoesNotExist:
                errors.append(cls.make_detail_code(detail))

        if errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 존재하지 않는 출고 정보가 있습니다: {', '.join(errors)}"
            )

    @classmethod
    def validate_is_fulfilled_by_vendor(cls, details):
        errors = []
        for detail in details:
            fulfillment: "Fulfillment" = detail.get("fulfillment")
            if not fulfillment.is_fulfilled_by_vendor:
                errors.append(cls.make_detail_code(detail))

        if errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 직거래 상품이 아닌 출고 정보가 있습니다: {', '.join(errors)}"
            )

    @classmethod
    def validate_vendor_user(cls, user: "User", details):
        # 스태프인 경우는 모든 협력사 출고 정보 변경 가능
        if user.is_staff:
            return

        errors = []
        for detail in details:
            fulfillment: "Fulfillment" = detail.get("fulfillment")
            if fulfillment.vendor.vendor_staff_user != user:
                errors.append(cls.make_detail_code(detail))

        if errors:
            raise ValidationError(
                f"일괄 출고 정보 변경 데이터 중 다른 협력사 출고 정보가 있습니다: {', '.join(errors)}"
            )

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        cls.validate_details_is_non_null(details)
        cls.validate_delivery_method_and_tracking_number(details)
        cls.validate_fulfillment(details)
        cls.validate_is_fulfilled_by_vendor(details)
        cls.validate_vendor_user(info.context.user, details)
        return details

    @classmethod
    def save_bulk(cls, user, details):
        update_fulfillment_list = []
        create_order_event_list = []
        for detail in details:
            fulfillment: "Fulfillment" = detail.get("fulfillment")
            order = fulfillment.order
            delivery_method = detail.get("delivery_method")

            order_event_parameters = {
                "fulfillment": fulfillment.composed_id,
                "before_delivery_method": fulfillment.delivery_method,
                "after_delivery_method": delivery_method,
            }

            fulfillment.delivery_method = delivery_method
            if delivery_method == OrderDeliveryMethods.BY_COURIER:
                courier: "Courier" = detail.get("courier")
                tracking_number = detail.get("tracking_number")
                fulfillment.courier = courier
                fulfillment.tracking_number = tracking_number

                formatted_tracking_number = make_formated_tracking_number_for_order_event(
                    courier_name=courier.name, tracking_number=tracking_number
                )

                order_event_parameters.update(
                    {
                        "tracking_number": formatted_tracking_number,
                    }
                )
            else:
                etc_delivery_man_info = detail.get("etc_delivery_man_info")
                if etc_delivery_man_info:
                    fulfillment.etc_delivery_man_info = etc_delivery_man_info
                order_event_parameters.update(
                    {
                        "etc_delivery_man_info": etc_delivery_man_info,
                    }
                )

            order_event = models.OrderEvent(
                order=order,
                type=OrderEvents.FBV_TRACKING_UPDATED,
                user=user,
                parameters=order_event_parameters,
            )

            update_fulfillment_list.append(fulfillment)
            create_order_event_list.append(order_event)

        if update_fulfillment_list:
            models.Fulfillment.objects.bulk_update(
                update_fulfillment_list,
                [
                    "delivery_method",
                    "courier",
                    "tracking_number",
                    "etc_delivery_man_info",
                ],
            )
        if create_order_event_list:
            models.OrderEvent.objects.bulk_create(create_order_event_list)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        user = info.context.user
        input_data = data.get("input")
        details = cls.clean_details(info=info, input_data=input_data)
        cls.save_bulk(user, details)
        return FulfillmentBulkUpdateForFbv()


