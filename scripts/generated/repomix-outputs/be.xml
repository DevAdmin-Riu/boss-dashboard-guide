            .load(root.id)
            .then(
                lambda fulfillment_lines: (
                    FulfillmentByIdLoader(info.context)
                    .load(fulfillment_lines[0].fulfillment_id)
                    .then(lambda fulfillment: fulfillment.created if fulfillment else None)
                    if len(fulfillment_lines) > 0
                    else None
                )
            )
        )

    def resolve_direct_shipping_cost_price_exclude_vat(root: OrderLineModel, info):
        def calculate_direct_shipping_cost_price_exclude_vat(variant_region, delivery_request_date):
            if variant_region:
                unit_cost_price_amount = variant_region.get_cost_price(
                    root.is_tax_free, delivery_request_date
                ).amount
                # 부가세를 제외한 금액으로 변환
                return calc_to_exclude_vat(unit_cost_price_amount, root.is_tax_free)
            return None

        def load_variant_region(order, user):
            region_id = user.region_id if user else None
            if region_id:
                # get_product_variant_region 호출 후 .then을 사용해 calculate_direct_shipping_cost_price 연결
                return get_product_variant_region_using_loader(
                    root.variant_id, region_id, info
                ).then(
                    lambda variant_region: calculate_direct_shipping_cost_price_exclude_vat(
                        variant_region, root.delivery_request_date
                    )
                )
            return None

        def load_user(order):
            if order.user_id:
                return (
                    UserByIdLoader(info.context)
                    .load(order.user_id)
                    .then(lambda user: load_variant_region(order, user))
                )
            return None

        return OrderByIdLoader(info.context).load(root.order_id).then(load_user)

    def resolve_need_delivery_additional_fee(root: OrderLineModel, info):
        """
        OrderLine에서 도서산간 추가 배송비 적용 여부를 결정하는 resolver.
        ProductVariant와 BrandProductVariant의 데이터를 비동기적으로 로드하여 계산함.
        """

        def _calculate_need_delivery_additional_fee(
            variant: "ProductVariantModel",
            bp_bundle: "BpBundleModel",
            bpv: "BrandProductVariantModel",
        ):
            if bp_bundle:
                return bp_bundle.need_delivery_additional_fee

            # BrandProductVariant가 없으면 기본적으로 True를 반환
            need_delivery_additional_fee_from_bpv = (
                bpv.need_delivery_additional_fee if bpv else True
            )

            return variant.need_delivery_additional_fee and need_delivery_additional_fee_from_bpv

        variant_loader = ProductVariantByIdLoader(info.context).load(root.variant_id)
        bp_bundle_loader = (
            BpBundleByIdLoader(info.context).load(root.bp_bundle_id)
            if root.bp_bundle_id
            else Promise.resolve(None)
        )
        bpv_loader = (
            BrandProductVariantByIdLoader(info.context).load(root.brand_product_variant_id)
            if root.brand_product_variant_id
            else Promise.resolve(None)
        )

        return Promise.all([variant_loader, bp_bundle_loader, bpv_loader]).then(
            lambda results: _calculate_need_delivery_additional_fee(*results)
        )


