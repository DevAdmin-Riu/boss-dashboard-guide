    @staticmethod
    def validate_for_box_spec_and_qty_per_box(cleaned_input, can_sale_by_inner):
        qty_per_box = cleaned_input.get("qty_per_box")
        if qty_per_box is not None and qty_per_box <= 0:
            raise ValidationError("아우터박스 입상 수량이 0 보다 커야합니다.")
        box_length = cleaned_input.get("box_length")
        if box_length is not None and box_length <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")
        box_width = cleaned_input.get("box_width")
        if box_width is not None and box_width <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")
        box_height = cleaned_input.get("box_height")
        if box_height is not None and box_height <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")

        if (
            (box_length is not None and is_valid_decimal(box_length, 5, 1) == False)
            or (box_width is not None and is_valid_decimal(box_width, 5, 1) == False)
            or (box_height is not None and is_valid_decimal(box_height, 5, 1) == False)
        ):
            raise ValidationError(
                "아우터박스 박스 규격 값은 1 ~ 9999 사이의 값을 mm 단위로 입력하세요."
            )

        if can_sale_by_inner:
            inner_qty_per_box = cleaned_input.get("inner_qty_per_box")
            if inner_qty_per_box is not None and inner_qty_per_box <= 0:
                raise ValidationError("이너박스 입상 수량이 0 보다 커야합니다.")
            inner_box_length = cleaned_input.get("inner_box_length")
            if inner_box_length is not None and inner_box_length <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")
            inner_box_width = cleaned_input.get("inner_box_width")
            if inner_box_width is not None and inner_box_width <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")
            inner_box_height = cleaned_input.get("inner_box_height")
            if inner_box_height is not None and inner_box_height <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")

            if (
                (inner_box_length is not None and is_valid_decimal(inner_box_length, 5, 1) == False)
                or (
                    inner_box_width is not None and is_valid_decimal(inner_box_width, 5, 1) == False
                )
                or (
                    inner_box_height is not None
                    and is_valid_decimal(inner_box_height, 5, 1) == False
                )
            ):
                raise ValidationError(
                    "이너박스 박스 규격 값은 1 ~ 9999 사이의 값을 mm 단위로 입력하세요."
                )

    @classmethod
    def save_outer_variant(cls, instance: ProductModel, cleaned_input):
        outer_variant: "ProductVariantModel" = instance.variants.filter(outer__isnull=True).first()

        update_fields = set()

        #  새 필드를 추가/수정할 때 이 부분만 건드리면 됩니다.
        FIELD_MAP = {
            "track_inventory": "track_inventory",
            "can_sale_by_inner": "can_sale_by_inner",
            "is_sub_pv": "is_sub_pv",
            "required_exp_date_mgmt": "required_exp_date_mgmt",
            "allow_auto_consignment": "allow_auto_consignment",
            "show_before_price": "show_before_price",
            "before_price": "before_price_amount",
            "base_price": "price_amount",
            "consignment_delivery_fee": "consignment_delivery_fee_amount",
            "base_sell_price_exclude_vat": "base_sell_price_exclude_vat",
            "base_sell_price_set_date": "base_sell_price_set_date",
            "market_lowest_price_exclude_vat": "market_lowest_price_exclude_vat",
            "market_lowest_price_set_date": "market_lowest_price_set_date",
            "market_lowest_price_source": "market_lowest_price_source",
            "note": "note",
            "po_note": "po_note",
            "maker": "maker",
            "country_of_origin": "country_of_origin",
            "qty_per_box": "qty_per_box",
            "qty_per_box_unit_type": "qty_per_box_unit_type",
            "sales_status": "sales_status",
            "sales_unit_type": "sales_unit_type",
            "stock_adjust_factor": "stock_adjust_factor",
            "box_length": "box_length",
            "box_width": "box_width",
            "box_height": "box_height",
            "pallet_qty": "pallet_qty",
            "pallet_m": "pallet_m",
            "pallet_n": "pallet_n",
            "pallet_o": "pallet_o",
            "is_deferred": "is_deferred",
            "is_adjust_price": "is_adjust_price",
            "qty_per_delivery_box": "qty_per_delivery_box",
            "priority_level": "priority_level",
            "need_to_inspect": "need_to_inspect",
            "inspect_reason": "inspect_reason",
            "inspect_type": "inspect_type",
            "inspect_memo": "inspect_memo",
            "inspect_report_template": "inspect_report_template",
            "force_sold_out_notice": "force_sold_out_notice",
            "is_seasonal": "is_seasonal",
            "peak_season_start_date": "peak_season_start_date",
            "peak_season_end_date": "peak_season_end_date",
            "stock_status_by_daily": "stock_status_by_daily",
            "is_vendor_track_inventory": "is_vendor_track_inventory",
        }

        for input_key, model_field in FIELD_MAP.items():
            if input_key in cleaned_input:
                value = cleaned_input[input_key]
                setattr(outer_variant, model_field, value)
                update_fields.add(model_field)
                if (
                    outer_variant.first_available_for_purchase is None
                    and model_field == "sales_status"
                    and value == SalesStatus.ON_SALE
                ):
                    first_available_for_purchase_filed = "first_available_for_purchase"
                    setattr(outer_variant, first_available_for_purchase_filed, kst_timezone_date())
                    update_fields.add(first_available_for_purchase_filed)

        if "is_deferred" in update_fields and outer_variant.is_deferred:
            DEFERRED_ZERO_FIELDS = [
                "before_price_amount",
                "price_amount",
                "price_vat",
                "consignment_delivery_fee_amount",
                "cost_price_exclude_vat",
                "consignment_cost_price_exclude_vat",
                "delivery_fee_amount",
                "change_price_amount",
                "change_cost_price_amount",
                "change_delivery_fee_amount",
            ]
            for field in DEFERRED_ZERO_FIELDS:
                if hasattr(outer_variant, field):
                    setattr(outer_variant, field, Decimal(0))
                    update_fields.add(field)

        if outer_variant.show_before_price:
            BrandUpdateProductVariant.validate_before_price(
                price=outer_variant.price_amount or Decimal(0),
                before_price=outer_variant.before_price_amount or Decimal(0),
            )

        if update_fields:
            outer_variant.save(update_fields=list(update_fields))

        return outer_variant

