            required=True,
        )

    class Meta:
        description = "본부수익금 정산 정보 Bulk Create"
        model = models.BrandMileageMonthlySettlement
        permissions = (AccountPermissions.MANAGE_MONTHLY_SETTLEMENT,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input", [])
        instances = [cls.get_instance(info, **item) for item in input_data]
        cleaned_inputs = [
            # super().clean_input(info, instance, item)
            # 왜인지 위의방식으로 안됨.
            # clean_input 마지막 인자 필요. 기존 Argument input의 타입과 다르므로.
            super(BrandMileageMonthlySettlementBulkCreate, cls).clean_input(
