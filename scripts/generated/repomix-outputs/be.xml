    if before_statuses is None:
        last_status_created_at_qs = (
            models.PurchaseOrderLineStatusHistory.objects.filter(
                purchase_order_line=OuterRef("pk"), after_status=after_status
            )
            .order_by("-pk")
            .values("created_at")[:1]
        )
    else:
        last_status_created_at_qs = (
            models.PurchaseOrderLineStatusHistory.objects.filter(
                purchase_order_line=OuterRef("pk"),
                before_status__in=before_statuses,
                after_status=after_status,
            )
            .order_by("-pk")
            .values("created_at")[:1]
        )
    qs = qs.annotate(last_status_created_at=Subquery(last_status_created_at_qs))
