# 재고 관리 아우터/이너 정책:
#    https://docs.google.com/spreadsheets/d/146YDAmpvgXdV06PCOFKvnaqBdaJ8u5nM__QJplVN9Kw/edit?gid=536884272#gid=536884272
def get_avg_sales_combined_qty_consider_inner(pv: "ProductVariant", target_field: str):
    outer: ProductVariant = pv.outer
    is_inner = outer is not None
    can_sale_by_inner = pv.can_sale_by_inner

    if is_inner:
        outer_track_inventory = outer.track_inventory
        if not can_sale_by_inner or outer.track_inventory:
            return None
    else:
        outer_track_inventory = pv.track_inventory
        if outer_track_inventory == False:
            return None

    inner_only_track_inventory_mode = outer_track_inventory == False and can_sale_by_inner
    if is_inner:
        outer_qty = (
            Decimal(0) if inner_only_track_inventory_mode else getattr(outer, target_field, None)
        )
    else:
        outer_qty = getattr(pv, target_field, None)

    converted_inner_qty_to_outer_base = Decimal(0)
    if can_sale_by_inner:
        if is_inner:
            pack_count = calc_pack_count(pv, outer)
            if pack_count > 0:
                inner_qty = getattr(pv, target_field, None)
                if inner_qty is not None:
                    converted_inner_qty_to_outer_base = my_round(inner_qty / pack_count, 2)
        elif pv.inner:
            pack_count = calc_pack_count(pv.inner, pv)
            if pack_count > 0:
                inner_qty = getattr(pv.inner, target_field, None)
                if inner_qty is not None:
                    converted_inner_qty_to_outer_base = my_round(inner_qty / pack_count, 2)

    if outer_qty is None:
        return None
    return outer_qty + converted_inner_qty_to_outer_base


def get_avg_sales_seperated_value_consider_inner(pv: "ProductVariant", value):
    if value is None:
        return None
    avg_qty = None
    is_inner = pv.outer is not None
    if is_inner:
        pack_count = calc_pack_count(pv, pv.outer)
        if pack_count > 0:
            inner_avg = value
            avg_qty = my_round(inner_avg / pack_count, 2)
    else:
        avg_qty = value
    return avg_qty


def get_avg_sales_seperated_qty_consider_inner(pv: "ProductVariant", target_field: str):
    value = getattr(pv, target_field, None)
    return get_avg_sales_seperated_value_consider_inner(pv, value)


def calc_basic_stock_qty(pv: "ProductVariant", avg_sales_daily_qty_field_name):
    po_lead_time = get_po_lead_time_consider_inner(pv)
    if po_lead_time is None:
        return None
    avg_sales_daily_qty_consider_inner = get_avg_sales_combined_qty_consider_inner(
        pv, avg_sales_daily_qty_field_name
    )
    if avg_sales_daily_qty_consider_inner is None:
        return None
    return my_round(avg_sales_daily_qty_consider_inner * po_lead_time, 2)


def calc_safety_stock_qty(pv: "ProductVariant", avg_sales_daily_qty_field_name):
    avg_sales_daily_qty_consider_inner = get_avg_sales_combined_qty_consider_inner(
        pv, avg_sales_daily_qty_field_name
    )
    if avg_sales_daily_qty_consider_inner is None:
        return None
    return my_round(avg_sales_daily_qty_consider_inner * 30 * pv.priority_level_factor, 2)


def calc_rop(pv: "ProductVariant", avg_sales_daily_qty_field_name):
    safety_stock_qty = calc_safety_stock_qty(pv, avg_sales_daily_qty_field_name)
    if safety_stock_qty is None:
        return None
    basic_stock_qty = calc_basic_stock_qty(pv, avg_sales_daily_qty_field_name)
    if basic_stock_qty is None:
        return None
    stock_adjust_factor = get_stock_adjust_factor_consider_inner(pv)
    if stock_adjust_factor is None:
        return None
    return my_round(safety_stock_qty + basic_stock_qty + stock_adjust_factor, 2)


