# Create your models here.
from django.conf import settings
from django.core.validators import MinLengthValidator
from django.db import models
from django.db.models import JSONField  # type: ignore
from django.utils.timezone import now

from ..account.models import Brand
from ..core.permissions import TaxInvoicePermissions
from ..core.utils.json_serializer import CustomJsonEncoder
from ..order.models import Order
from . import TaxInvoiceStatus


class TaxInvoice(models.Model):
    order = models.ForeignKey(
        Order, related_name="tax_invoices", null=True, on_delete=models.SET_NULL
    )
    b2b_brand = models.ForeignKey(
        Brand, related_name="tax_invoices", null=True, on_delete=models.SET_NULL
    )
    is_tax_free = models.BooleanField(null=False)
    is_b2b = models.BooleanField(default=False)
    # deprecated: 환불 처리 시 금액 계산 기준이 되는 세금계산서 (= 주문 시점 발행 요청된 세금계산서 ) 판단용 제어 변수
    is_on_payment = models.BooleanField(default=True)
    is_from_riu = models.BooleanField(default=True)
    is_to_hq = models.BooleanField(default=False)
    is_reverse_fee = models.BooleanField(default=False)
    status = models.CharField(max_length=255, choices=TaxInvoiceStatus.CHOICES)
    requested = models.DateTimeField(default=now)
    issued = models.DateTimeField(null=True)
    mgt_key = models.CharField(null=True, max_length=24, validators=[MinLengthValidator(24)])
    nts_confirm_num = models.CharField(
        null=True, max_length=24, validators=[MinLengthValidator(24)]
    )

    # 세금계산서 작성일: captured 날짜로 초기 세팅 (필요 시 운영자에 의해 세금계산서 발행 전에 수정될 수 있음)
    write_date = models.DateField(null=True)
    # 세금계산서 자동 발행 신청일: 운영자가 발행하지 않은 건 requested 상태 건에 대해서 scheduler 가 자동으로 popbill 에 발행 신청
    # write_date + 4일 후로 세팅 (필요 시 운영자에 의해 수정될 수 있음)
    auto_issue_date = models.DateField(null=True)
    # 발행 금액 수정 여부
    is_modified = models.BooleanField(null=False, default=False)
    # 발행 금액 - 환불 시 자동계산되어 변경되거나 운영자에 의해 수정될 수 있음
    total_amount = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )

    # -----
    # is_modified_after_issued, origin_amount migration 설명
    # is_modified 가 False 이면 수정된 적이 없으므로, is_modified_after_issued = False, origin_amount = total_amount 와 같게 migration
    # is_modified 가 True 이면 언제 수정된 건지 데이터로 파악하는 것은 어려워서 두 값 모두 null 상태로 migration
    # -----

    # 발행 후 환불로 인해 발행 금액 수정 여부
    is_modified_after_issued = models.BooleanField(null=True, default=False)
    # 최초 발행 금액
    origin_amount = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        null=True,
        default=0,
    )
    # 세금계산서 issued 된 금액
    issued_amount = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        null=True,
        default=0,
    )

    invoicer_biz_info = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)
    invoicee_biz_info = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    class Meta:
        ordering = (
            "-order_id",
            "write_date",
        )
        permissions = ((TaxInvoicePermissions.MANAGE_TAXINVOICE.codename, "세금계산서 관리"),)
</file>

