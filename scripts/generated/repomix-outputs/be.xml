def can_edit_address(user, address):
    """Determine whether the user can edit the given address.

    This method assumes that an address can be edited by:
    - users with proper permissions (staff)
    - customers associ1595
    ated to the given address.
    """
    # address의 user는 1명이라고 가정(원래 운영상 그러함 애초에 M2M이 잘못됨..)
    address_user = address.user_addresses.first()
    if user.brand_id == address_user.brand_id and (
        user.is_hq_staff_admin or user.is_hq_staff_supervisor_all
    ):
        return True
    elif user.hq_staff_brand_stores.filter(
        brand_store_id=address_user.owned_brand_store.id
    ).exists():
        return True
    else:
        return (
            user.has_perm(AccountPermissions.MANAGE_ADDRESS)
            or user.addresses.filter(pk=address.pk).exists()
        )


class SetPassword(CreateToken):
    class Arguments:
        token = graphene.String(
            description="A one-time token required to set the password.", required=True
        )
        login_id = graphene.String(required=True, description="Login id of a user.")
        password = graphene.String(required=True, description="Password of a user.")
        request_origin = RequestOriginTypeEnum(
            required=True, description="로그인한 사이트(보스몰 / 대시보드)"
        )

    class Meta:
        description = "비밀번호 변경"
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        login_id = data["login_id"]
        password = data["password"]
        token = data["token"]

        try:
            cls._set_password_for_user(login_id, password, token)
        except ValidationError as e:
            errors = validation_error_to_error_type(e)
            return cls.handle_typed_errors(errors)

        return super().perform_mutation(root, info, **data)

    @classmethod
    def _set_password_for_user(cls, login_id, password, token):
        try:
            user: models.User = models.User.objects.get(login_id=login_id)
        except ObjectDoesNotExist:
            raise ValidationError(
                {
                    "login_id": ValidationError(
                        "존재하지 않는 로그인 아이디입니다.",
                        code=AccountErrorCode.NOT_FOUND,
                    )
                }
            )
        if not default_token_generator.check_token(user, token):
            raise ValidationError(
                {"token": ValidationError(INVALID_TOKEN, code=AccountErrorCode.INVALID)}
            )
        try:
            password_validation.validate_password(password, user)
        except ValidationError as error:
            raise ValidationError({"password": error})
        user.set_password(password)
        user.wrong_login_try = 0
        user.save(update_fields=["password", "wrong_login_try"])
        account_events.customer_password_reset_event(user=user)


