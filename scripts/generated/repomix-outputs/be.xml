    url_send_sms = config.url_send_sms
    receiver_phone_consider_test_mode = get_receiver_phone_consider_test_mode(receiver_phone)
    if receiver_phone_consider_test_mode is None:
        logger.error(
            f"sms 수신 휴대폰 번호가 유효하지 않습니다. {receiver_phone} -> {receiver_phone_consider_test_mode}"
        )
        return
    sms_data = {
        "key": config.ALIGO_APIKEY,
        "userid": config.ALIGO_USERID,
        "sender": config.sender_phone,
        "receiver": receiver_phone_consider_test_mode,
        "msg": message,
        "testmode_yn": "N" if config.is_prod_mode else "Y",
    }
    response = requests.post(url_send_sms, data=sms_data)
    result = response.json()
    return result


