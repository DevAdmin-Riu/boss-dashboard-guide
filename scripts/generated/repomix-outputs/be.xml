        if payment and payment.charge_status in (
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        ):
            return Money(
                payment.captured_amount
                + payment.captured_cashable_credits
                + payment.captured_non_cashable_credits
                + payment.captured_rcoins,
                payment.currency,
            )
        return zero_money()

    @property
    def total_captured_paid(self):
        payment: Payment = self.get_last_payment()
        if payment and payment.charge_status in (
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        ):
            return Money(payment.captured_amount, payment.currency)
        return zero_money()

    @property
    def total_captured_cashable_credits(self):
        payment: Payment = self.get_last_payment()
        if payment and payment.charge_status in (
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        ):
