def send_kakaotalk_to_customer_on_order(
    order: "Order", payment: "Payment", pay_method: str, gateway_response: dict
):
    from ..payment.gateways.handle_by_pg import get_vact_info

    try:
        # 스태프 주문은 알리고 이벤트 발송 안함
        if order.type != OrderType.BY_USER:
            return

        is_vbank = is_vbank_pay(pay_method)

        # 카드와 포인트 전부 주문 즉시 결제까지 완료한 것이어서, 카드결제용 템플릿에서도 "주문이 완료되었다"라는 안내만 있고 카드로 결제했다는 문구가 없으니 그대로 사용
        talk_event_code = AligoEvents.ORDER_BY_VBANK if is_vbank else AligoEvents.ORDER_BY_CARD

        parameters = {"order_id": order.id}
        plugin_manager = get_plugins_manager()
        if is_vbank:
            server_mode_str = settings.SERVER_MODE
            server_mode_enum = ServerModeEnum(server_mode_str)
            include_vact_time = is_prod_server_mode(server_mode_enum) == False
            vact_info = get_vact_info(
                payment,
                gateway_response,
                include_vact_time=include_vact_time,
                plugin_manager=plugin_manager,
            )
            if vact_info is None:
                logger.error(f"알리고 이벤트 발송 실패: {order.id} {payment.id} {payment.gateway}")
                return
            else:
                parameters["vact_bank_code"] = vact_info.vact_bank_code
                parameters["vact_bank_name"] = vact_info.vact_bank_name
                parameters["vact_num"] = vact_info.vact_num
                parameters["vact_name"] = vact_info.vact_name
                parameters["vact_date"] = vact_info.vact_date
                parameters["vact_amount"] = vact_info.vact_amount

                if (
                    vact_info.vact_bank_code is None
                    or vact_info.vact_bank_name is None
                    or vact_info.vact_num is None
                    or vact_info.vact_name is None
                    or vact_info.vact_date is None
                    or vact_info.vact_amount is None
                ):
                    logger.error(
                        f"알리고 이벤트 발송 실패 - 입금정보 오류: {order.id} {payment.id} {payment.gateway} {parameters}"
                    )
                    return
        plugin_manager.send_kakaotalk(talk_event_code=talk_event_code, parameters=parameters)
    except Exception as E:
        logger.error(f"{send_kakaotalk_to_customer_on_order.__name__} error: {E}")


def send_kakaotalk_to_vendor_on_fbv_order(order: "Order", receiver_phone: str, vendor_name: str):
    try:
        talk_event_code = AligoEvents.FBV_ORDER

        parameters = {
            "order_id": order.id,
            "vendor_name": vendor_name,
            RECEIVER_PHONE: receiver_phone,
        }

        get_plugins_manager().send_kakaotalk(talk_event_code=talk_event_code, parameters=parameters)
        return True
    except Exception as E:
        logger.error(f"{send_kakaotalk_to_vendor_on_fbv_order.__name__} error: {E}")
        return False


