from collections import defaultdict

from ...banner.models import Banner, Popup
from ...bbs.models import Notice
from ..core.dataloaders import DataLoader


class BrandsByBannerIdLoader(DataLoader):
    context_key = "brands_by_banner_id"

    def batch_load(self, keys):
        through_table = Banner.available_brands.through
        banner_brand_relations = through_table.objects.filter(banner_id__in=keys).prefetch_related(
            "brand"
        )

        address_map = defaultdict(list)

        for entry in banner_brand_relations:
            address_map[entry.banner_id].append(entry.brand)

        return [address_map[banner_id] for banner_id in keys]


class BrandsByPopupIdLoader(DataLoader):
    context_key = "brands_by_popup_id"

    def batch_load(self, keys):
        through_table = Popup.available_brands.through
        popup_brand_relations = through_table.objects.filter(popup_id__in=keys).prefetch_related(
            "brand"
        )

        address_map = defaultdict(list)

        for entry in popup_brand_relations:
            address_map[entry.popup_id].append(entry.brand)

        return [address_map[poopup_id] for poopup_id in keys]


class NoticeByIdLoader(DataLoader):
    context_key = "notice_by_id"

    def batch_load(self, keys):
        notices = Notice.objects.in_bulk(keys)
        return [notices.get(notice_id) for notice_id in keys]
