def send_kakao(
    config,
    token,
    talk_code,
    template_code,
    template_info,
    receiver_phone,
    replace_dict: dict,
    receiver_phone_bulk=None,
    bulk_mode: bool = False,
):
    template_content = template_info["templtContent"]
    replace_message = replace_all_using_replace_dict(template_content, replace_dict)
    template_buttons = template_info["buttons"]
    json_button = json.dumps({"button": template_buttons})
    if talk_code == AligoEvents.FULFILLMENT_BY_CJ.name:
        json_button = replace_all_using_replace_dict(json_button, replace_dict)

    url_send_kakao = config.url_send_kakao
    for_send_kakao_data = {
        "apikey": config.ALIGO_APIKEY,
        "userid": config.ALIGO_USERID,
        "senderkey": config.ALIGO_SENDERKEY,
        "token": token,
        "tpl_code": template_code,
        "sender": config.sender_phone,
        "testMode": "N" if config.is_prod_mode else "Y",
    }
    if not bulk_mode:
        receiver_phone_consider_test_mode = get_receiver_phone_consider_test_mode(receiver_phone)
        if receiver_phone_consider_test_mode is None:
            error_message = f"수신 휴대폰 번호가 유효하지 않습니다. {receiver_phone} -> {receiver_phone_consider_test_mode}"
            logger.error(error_message)
            raise Exception(error_message)

        for_send_kakao_data["receiver_1"] = receiver_phone_consider_test_mode
        for_send_kakao_data["subject_1"] = template_info["templtName"]
        for_send_kakao_data["message_1"] = replace_message
        for_send_kakao_data["button_1"] = json_button
        if talk_code == AligoEvents.BRAND_NOTICE:
            for_send_kakao_data["emtitle_1"] = "가맹본부 공지 알림"
        if talk_code == AligoEvents.DEACTIVATE_WARNING_ALARM:
            for_send_kakao_data["emtitle_1"] = "포장보스 계정 비활성화 전환 예정 안내"
    else:
        for idx, phone in enumerate(receiver_phone_bulk):
            receiver_param = "receiver_" + str(idx + 1)
            subject_param = "subject_" + str(idx + 1)
            message_param = "message_" + str(idx + 1)
            button_param = "button_" + str(idx + 1)
            receiver_phone_consider_test_mode = get_receiver_phone_consider_test_mode(phone)
            if receiver_phone_consider_test_mode is None:
                error_message = f"수신 휴대폰 번호가 유효하지 않습니다. {receiver_phone} -> {receiver_phone_consider_test_mode}"
                logger.error(error_message)
                continue
            for_send_kakao_data[receiver_param] = receiver_phone_consider_test_mode
            for_send_kakao_data[subject_param] = template_info["templtName"]
            for_send_kakao_data[message_param] = replace_message
            for_send_kakao_data[button_param] = json_button
            if talk_code == AligoEvents.BRAND_NOTICE:
                emtitle_param = "emtitle_" + str(idx + 1)
                for_send_kakao_data[emtitle_param] = "가맹본부 공지 알림"
            if talk_code == AligoEvents.DEACTIVATE_WARNING_ALARM:
                emtitle_param = "emtitle_" + str(idx + 1)
                for_send_kakao_data[emtitle_param] = "포장보스 계정 비활성화 전환 예정 안내"

    response = requests.post(url_send_kakao, data=for_send_kakao_data)
    result = response.json()
    return result


def make_parameters_related_to_purchase(
    close_date: Date,
    purchases: List[Purchase],
):
    if not purchases:
        return None

    close_date_str = close_date.strftime("%Y년 %m월")
    first_purchase = purchases[0]
    vendor = first_purchase.vendor
    purchase_order = first_purchase.purchase_order
    b2b_url = make_b2b_url_path(purchase_order.is_b2b)
    first_po_line = first_purchase.purchase_order_line
    first_po_line_code = first_po_line.code
    first_po_line_product_name = first_po_line.product_name
    po_line_count = len(purchases)
    po_line_count_minus_one = to_locale_number(po_line_count - 1)
    po_line_code = (
        first_po_line_code
        if po_line_count == 1
        else f"{first_po_line_code} 외 {po_line_count_minus_one}건"
    )
    po_line_product_name = (
        first_po_line_product_name
        if po_line_count == 1
        else f"{first_po_line_product_name} 외 {po_line_count_minus_one}건"
    )
    receiver_phone, receiver_email, _ = get_account_manager_info(vendor)
    parameters = {
        "close_date": close_date_str,
        RECEIVER_PHONE: receiver_phone,
        "receiver_email": receiver_email,
        "use_delegated_management_for_po": vendor.use_delegated_management_for_po,
        "po_line_code": po_line_code,
        "po_line_product_name": po_line_product_name,
        "b2b_url": b2b_url,
    }
    return parameters


def make_parameters_related_to_sales_b2b_settlement(sales_b2b_settlement: SalesB2bSettlement):
    if not sales_b2b_settlement:
        return {}

    close_date_str = sales_b2b_settlement.sales_close_date.strftime("%Y년 %m월")
    close_date_url = sales_b2b_settlement.sales_close_date.strftime("%Y-%m")
    paid_date_str = sales_b2b_settlement.paid_date.strftime("%Y년 %m월")
    total_include_vat = sales_b2b_settlement.taxable_total + sales_b2b_settlement.taxfree_total
    vat_amount = calc_vat_by_price_include_vat(sales_b2b_settlement.taxable_total, False)
    total_exclude_vat = total_include_vat - vat_amount
    unpaid_amount = sales_b2b_settlement.unpaid_amount
    total_receivable_amount = total_include_vat + unpaid_amount
    parameters = {
        "close_date": close_date_str,
        "close_date_url": close_date_url,
        "paid_date": paid_date_str,
        "total_exclude_vat": to_locale_number(total_exclude_vat),
        "vat_amount": to_locale_number(vat_amount),
        "total_include_vat": to_locale_number(total_include_vat),
        "unpaid_amount": to_locale_number(unpaid_amount),
        "total_receivable_amount": to_locale_number(total_receivable_amount),
    }
    return parameters


