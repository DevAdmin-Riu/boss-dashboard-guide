import datetime
import logging
from decimal import Decimal

from django.db import transaction

from ....order.models import RefundOrderLine
from ....stats.models import Sales
from ...models import Transaction

logger = logging.getLogger(__name__)


def _change_refunded_at(line: str):
    tid_index = 2
    refunded_at_index = 5
    refund_amount_index = 6
    data_array = line.split("|")
    if len(data_array) < 7:
        logger.error(f"이니시스 승인대사 데이터 index 오류: {line}")
        return
    tid = data_array[tid_index]
    refunded_at = data_array[refunded_at_index]
    refund_amount = data_array[refund_amount_index]

    refund_order_line = RefundOrderLine.objects.filter(inicis_cancel_tid=tid).first()
    if refund_order_line is None:
        logger.error(f"이니시스 승인대사 데이터 refund_order_line 없음: {line}")
        return
    transaction: Transaction = refund_order_line.transaction
    if transaction is None:
        logger.error(
            f"이니시스 승인대사 데이터 transaction 없음: {line} refund_order_line={refund_order_line}"
        )
        return
    if transaction.amount != Decimal(refund_amount):
        logger.error(
            f"이니시스 승인대사 데이터 refund_amount 불일치: {line} transaction={transaction} {transaction.amount}"
        )
        return

    new_refunded_at = datetime.datetime.strptime(refunded_at, "%Y%m%d").astimezone()
    RefundOrderLine.objects.filter(inicis_cancel_tid=tid).update(refunded_at=new_refunded_at)
    Sales.objects.filter(refund_order_line__transaction=transaction).update(
        evented_at=new_refunded_at
    )

    logger.info(
        f"이니시스 승인대사 데이터로 매입취소일 변경 완료 tid:{tid} 취소일:{new_refunded_at}"
    )


# https://manual.inicis.com/iniweb/urlsvc.html#popup_41
# response trimmed 예시 = "신용카드|riupackTES|StdpayCARDriupackTES20231129110111289884|10799|20231129||150|승인|0||<br>신용카드|riupackTES|INIAPIRPAYriupackTES20231129110315838290|10799|00010101|20231129|150|매입후취소|0||<br>신용카드|riupackTES|StdpayCARDriupackTES20231129111127423198|10800|20231129||270|승인|0||<br>"


@transaction.atomic()
def process_inicis_change_refunded_at(
    response: str,
):
    trimmed_response = response.strip()
    error_code = trimmed_response[:4]

    if error_code in ["0001", "0002", "0003"]:
        logger.error(f"이니시스 승인대사 요청 api 호출 에러: {trimmed_response}")
        return

    lines = trimmed_response.split("<br>")
    for line in lines:
        if line is None or line == "":
            continue
        trimmed_line = line.strip()
        # 거래 상태: 신용카드 : 승인, 매입전취소, 매입후취소 / 휴대폰 : 승인, 환불, 취소 / 그 외 : 승인, 취소
        if "승인" in trimmed_line:
            continue
        _change_refunded_at(trimmed_line)
