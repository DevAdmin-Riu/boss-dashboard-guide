class ExtendedCheckoutComplete(BaseMutation):
    order = graphene.Field(
        Order, description="CheckoutCompleteInput 이 입력된 경우 정상 결제 처리된 order가 리턴됨."
    )
    payment = graphene.Field(
        Payment,
        description="CheckoutPaymentCreateInput 이 입력된 경우 생성된 payment가 리턴됨 - 토스 결제 위젯에서 사용",
    )

    class Arguments:
        ext_checkout_note_update_input = ExtCheckoutNoteUpdateInput(
            required=False,
            description="CheckoutNoteUpdate Mutation Input",
        )
        ext_checkout_shipping_address_update_input = ExtCheckoutShippingAddressUpdateInput(
            required=False,
            description="CheckoutShippingAddressUpdate Mutation Input",
        )
        ext_checkout_picking_order_update_input = ExtCheckoutPickingOrderUpdateInput(
            required=False,
            description="CheckoutPickingOrderUpdate Mutation Input",
        )
        ext_checkout_package_order_update_input = ExtCheckoutPackageOrderUpdateInput(
            required=False,
            description="CheckoutPackageOrderUpdate Mutation Input",
        )
        ext_checkout_payment_create_input = ExtCheckoutPaymentCreateInput(
            required=False,
            description="CheckoutPaymentCreate Mutation Input",
        )
        ext_checkout_complete_input = ExtCheckoutCompleteInput(
            required=False,
            description="CheckoutComplete Mutation Input",
        )

    class Meta:
        description = "확장된 Checkout Complete, 여러개의 Mutation을 한번에 수행함."
        error_type_class = ExtendedCheckoutError
        error_type_field = "extended_checkout_errors"

    # payment 생성 시 값 초기화 - PG 결제창 오픈 전에, 즉 ext_checkout_payment_create_input 입력이 있는 경우에만 호출
    @classmethod
    def init_checkout_values(cls, checkout_id):
        pk = from_global_id_strict_type(checkout_id, Checkout, field="checkout_id")
        models.Checkout.objects.filter(pk=pk).update(picking_info=dict())
        models.CheckoutLine.objects.filter(checkout_id=pk).update(etc_delivery_fee=0)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        ext_checkout_note_update_input = data.get("ext_checkout_note_update_input")
        ext_checkout_shipping_address_update_input = data.get(
            "ext_checkout_shipping_address_update_input"
        )
        ext_checkout_picking_order_update_input = data.get(
            "ext_checkout_picking_order_update_input"
        )
        ext_checkout_package_order_update_input = data.get(
            "ext_checkout_package_order_update_input"
        )
        ext_checkout_payment_create_input = data.get("ext_checkout_payment_create_input")
        ext_checkout_complete_input = data.get("ext_checkout_complete_input")

        # 만약 모든 input이 존재하지 않는다면 error 처리 한다.
        if not any(
            [
                ext_checkout_note_update_input,
                ext_checkout_shipping_address_update_input,
                ext_checkout_picking_order_update_input,
                ext_checkout_package_order_update_input,
                ext_checkout_payment_create_input,
                ext_checkout_complete_input,
            ]
        ):
            raise ValidationError("적어도 하나의 Mutation Input이 필요합니다.")

        checkout_complete_error_message = None
        order = None
        payment = None

        # PG 결제 전에 payment 생성을 위해서 호출 할 때는 ext_checkout_payment_create_input 입력 필수
        # PG를 갔다오고 난 뒤의 CheckoutComplete 를 위해서 호출 할 때는 ext_checkout_payment_create_input 입력 없어야 함
        if ext_checkout_payment_create_input:
            # checkout의 node를 가지고 온뒤, 해당 checkout line의 etc_delivery_fee를 0으로 초기화한다.
            checkout_id = ext_checkout_payment_create_input.checkout_id
            cls.init_checkout_values(checkout_id)

        # CheckoutNoteUpdate을 수행한다.
        try:
            if ext_checkout_note_update_input:
                CheckoutNoteUpdate.perform_mutation(_root, info, **ext_checkout_note_update_input)
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_NOTE_UPDATE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )

        # CheckoutShippingAddressUpdate을 수행한다.
        try:
            if ext_checkout_shipping_address_update_input:
                CheckoutShippingAddressUpdate.perform_mutation(
                    _root, info, **ext_checkout_shipping_address_update_input
                )
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_SHIPPING_ADDRESS_UPDATE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )

        # CheckoutPickingOrderUpdate 수행한다.
        try:
            if ext_checkout_picking_order_update_input:
                CheckoutPickingOrderUpdate.perform_mutation(
                    _root, info, **ext_checkout_picking_order_update_input
                )
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_PICKING_ORDER_UDATE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )

        # CheckoutPackageOrderUpdate 수행한다.
        try:
            if ext_checkout_package_order_update_input:
                CheckoutPackageOrderUpdate.perform_mutation(
                    _root, info, **ext_checkout_package_order_update_input
                )
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_PACKAGE_ORDER_UPDATE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )

        # CheckoutPaymentCreate을 수행한다.
        try:
            if ext_checkout_payment_create_input:
                checkout_payment_create = CheckoutPaymentCreate.perform_mutation(
                    _root, info, **ext_checkout_payment_create_input
                )
                payment = checkout_payment_create.payment
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_PAYMENT_CREATE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )

        # CheckoutComplete을 수행한다.
        try:
            if ext_checkout_complete_input:
                checkout_complete = CheckoutComplete.perform_mutation(
                    _root, info, **ext_checkout_complete_input
                )
                order = checkout_complete.order
                checkout_complete_error_message = checkout_complete.error_message
        except Exception as e:
            error_mutation = ErrorMutationEnum.CHECKOUT_COMPLETE
            message = e.messages[0] if hasattr(e, "messages") and e.messages else str(e)
            raise ValidationError(
                message=message,
                params={"error_mutation": error_mutation},
            )
        # CheckoutComplete의 경우 Exception 발생하지 않지만 error_message로 넘어올수도 있도록 로직 되어 있음. 아래와 같이 일관성 있게 처리 해서 front에서 처리.
        if checkout_complete_error_message:
            error_mutation = ErrorMutationEnum.CHECKOUT_COMPLETE
            raise ValidationError(
                message=checkout_complete_error_message,
                params={"error_mutation": error_mutation},
            )

        return ExtendedCheckoutComplete(order=order, payment=payment)


