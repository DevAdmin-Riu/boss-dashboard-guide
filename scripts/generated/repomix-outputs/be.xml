    sales_group_by_brand = make_sales_group_by_brand(sales)
    create_list = []
    for brand, sales in sales_group_by_brand.items():
        taxable_total = sum(s.unit_price * s.quantity for s in sales if not s.is_tax_free)
        taxable_total += sum(
            calc_to_include_vat(s.b2b_delivery_fee_exclude_vat, False) for s in sales
        )
        tax_free_total = sum(s.unit_price * s.quantity for s in sales if s.is_tax_free)

        brand_tax_invoices = make_tax_invoice_request_on_close_b2b_sales(
            close_date=close_date,
            brand=brand,
            taxable_total=taxable_total,
            tax_free_total=tax_free_total,
        )
        create_list.extend(brand_tax_invoices)

    if create_list:
        TaxInvoice.objects.bulk_create(create_list)


