        inner_incidental_cost = (
            0 if is_deferred else cleaned_input.get("inner_incidental_cost", Decimal(0))
        )
        can_sale_by_inner = cleaned_input.get("can_sale_by_inner")
        inner_sales_status = cleaned_input.get("inner_sales_status", SalesStatus.ON_SALE)
        # 제품 상태를 판매대기로 한 경우 판매 개시일을 null 처리
        first_available_for_purchase = (
            None if inner_sales_status == SalesStatus.PENDING else kst_timezone_date()
        )

        inner_variant = models.ProductVariant.objects.create(
            product=instance,
            track_inventory=True,
            is_vendor_track_inventory=False,
            can_sale_by_inner=can_sale_by_inner,
            allow_auto_consignment=False,
            outer=instance.default_variant,
            base_sell_price_exclude_vat=inner_base_sell_price_exclude_vat,
            base_sell_price_set_date=inner_base_sell_price_set_date,
            market_lowest_price_exclude_vat=inner_market_lowest_price_exclude_vat,
            market_lowest_price_set_date=inner_market_lowest_price_set_date,
            market_lowest_price_source=inner_market_lowest_price_source,
            qty_per_box=inner_qty_per_box,
            box_length=inner_box_length,
            box_width=inner_box_width,
            box_height=inner_box_height,
            inner_moq=inner_moq,
            inner_uoq=inner_uoq,
            inner_incidental_cost_amount=inner_incidental_cost,
            sales_status=inner_sales_status,
            first_available_for_purchase=first_available_for_purchase,
            force_sold_out_notice=inner_force_sold_out_notice,
        )

        inner_stocks = cleaned_input.get("inner_stocks")
        cls.create_variant_stocks(inner_variant, inner_stocks)

        return inner_variant

    @classmethod
    @transaction.atomic
    def save(cls, info, product: ProductModel, cleaned_input):
        product.save()

        if not product.product_type.has_variants:
            site_settings = info.context.site.settings
            outer_variant = cls.save_outer_variant(
                info, product, cleaned_input, site_settings.track_inventory_by_default
            )
            has_inner_variant = (
                product.check_has_inner_variant() and outer_variant.check_has_inner_variant()
            )
            if has_inner_variant:
                inner_variant = cls.save_inner_variant(product, cleaned_input, outer_variant)
                ProductVariantCreate.validate_inner_qty_per_box(outer_variant, inner_variant)
                outer_variant.inner = inner_variant
                outer_variant.save(update_fields=["inner"])
                reset_inner_variant_cost_price(outer_variant, inner_variant)

        attributes = cleaned_input.get("attributes")
        if attributes:
            AttributeAssignmentMixin.save(product, attributes)

    @classmethod
    def create_variant_stocks(cls, variant: ProductVariantModel, stocks):
        if stocks:
            warehouse_ids = [stock["warehouse"] for stock in stocks]
            warehouses = cls.get_nodes_or_error(warehouse_ids, "warehouse", only_type=Warehouse)
            create_stocks(variant, stocks, warehouses)
        else:
            create_stock_by_first_warehouse_if_not_exist(variant)

    @classmethod
    def _save_m2m(cls, info, instance, cleaned_data):
        collections = cleaned_data.get("collections", None)
        if collections is not None:
            instance.collections.set(collections)

    @staticmethod
    def save_default_product_variant_vendor(
        root, info, variant: ProductVariantModel, cleaned_input
    ):
        default_pvv_create_input = cleaned_input.get("default_pvv_create_input", None)
        if default_pvv_create_input:
            vendor_code = default_pvv_create_input.pop("vendor_code", None)
            if vendor_code is None:
                raise ValidationError("기본 협력사 코드는 필수 입력 항목입니다.")
            prefix = vendor_models.VENDOR_CODE_PREFIX
            prefix_length = len(prefix)
            vendor_pk = vendor_code[prefix_length:]
            vendor = vendor_models.Vendor.objects.filter(pk=vendor_pk).first()
            if not vendor:
                raise ValidationError(f"등록하려고 하는 기본 협력사의 협력사 코드를 확인하세요.")
            manage_event = {
                "type": ProductVariantManageEventType.TYPE_VENDOR,
                "title": "기본 협력사 등록",
                "reason": "제품 생성 시 등록",
                "change_details": "",
            }
            product_variant_vendor_create_input = {
                "product_variant": graphene.Node.to_global_id("ProductVariant", variant.id),
                "vendor": graphene.Node.to_global_id("Vendor", vendor.id),
                "manage_event": manage_event,
                **default_pvv_create_input,
            }
            response = ProductVariantVendorCreate.mutate(
                root,
                info,
                input=product_variant_vendor_create_input,
            )
            if response.errors:
                raise ValidationError(f"기본 제품 협력사 생성 에러 - {response.errors[0].message}")

    @staticmethod
    def save_brand_product_variant(root, info, variant: ProductVariantModel, cleaned_input):
        # 직거래 상품 생성 시 비옵션형만 생성함
        bpv_crete_input = cleaned_input.get("bpv_create_input", None)
        if bpv_crete_input:
            brand_code = bpv_crete_input.pop("brand_code", None)
            if brand_code is None:
                raise ValidationError("브랜드 코드는 필수 입력 항목입니다.")
            brand = account_models.Brand.objects.filter(code=brand_code).first()
            if not brand:
                raise ValidationError(f"등록하려고 하는 가맹본부의 브랜드코드를 확인하세요.")
            response = BrandAddProducts.mutate(
                root,
                info,
                brand_id=graphene.Node.to_global_id("Brand", brand.id),
                is_fulfilled_by_vendor=True,
                products=[graphene.Node.to_global_id("Product", variant.product.id)],
            )
            if response.errors:
                raise ValidationError(f"상품 생성 에러 - {response.errors[0].message}")

            bp: BrandProductModel = models.BrandProduct.objects.filter(
                brand=brand, product=variant.product
            ).first()
            if bp:
                update_fields = []
                bp.is_rcoin_reward_for_using_point = False
                update_fields.append("is_rcoin_reward_for_using_point")
                is_only_payable_by_cash = bpv_crete_input.get("is_only_payable_by_cash", None)
                if is_only_payable_by_cash is not None:
                    bp.is_only_payable_by_cash = is_only_payable_by_cash
                    update_fields.append("is_only_payable_by_cash")
                bp.save(update_fields=update_fields)

            bpv: BrandProductVariantModel = models.BrandProductVariant.objects.filter(
                brand=brand, product_variant=variant
            ).first()
            if bpv:
                is_deferred = variant.is_deferred
                update_fields = []
                price_amount = 0 if is_deferred else bpv_crete_input.get("price", None)
                if price_amount is not None:
                    bpv.price_amount = price_amount
                    update_fields.append("price_amount")
                price_vat = 0 if is_deferred else bpv_crete_input.get("price_vat", None)
                if price_vat is not None:
                    bpv.price_vat = price_vat
                    update_fields.append("price_vat")
                before_price_amount = (
                    0 if is_deferred else bpv_crete_input.get("before_price", None)
                )
                if before_price_amount is not None:
                    bpv.before_price_amount = before_price_amount
                    update_fields.append("before_price_amount")
                show_before_price = (
                    False if is_deferred else bpv_crete_input.get("show_before_price", None)
                )
                if show_before_price is not None:
                    bpv.show_before_price = show_before_price
                    update_fields.append("show_before_price")
                bpv.sales_status = SalesStatus.ON_SALE
                update_fields.append("sales_status")
                bpv.stopped_at = None
                update_fields.append("stopped_at")
                bpv.stopped_reason = None
                update_fields.append("stopped_reason")
                bpv.stopped_reason_etc = ""
                update_fields.append("stopped_reason_etc")
                bpv.force_no_normal_display = True
                update_fields.append("force_no_normal_display")
                bpv.need_delivery_additional_fee = False
                update_fields.append("need_delivery_additional_fee")
                bpv.save(update_fields=update_fields)

    @classmethod
    def post_save_action(cls, root, info, instance: ProductModel, cleaned_input):
        info.context.plugins.product_created(instance)
        default_variant: ProductVariantModel = instance.default_variant
        if default_variant:
            ProductCreate.save_default_product_variant_vendor(
                root, info, default_variant, cleaned_input
            )
            ProductCreate.save_brand_product_variant(root, info, default_variant, cleaned_input)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(root, info, instance, cleaned_input)
        response = cls.success_response(instance)
        return response


