class PurchaseOrderBulkCreate(BaseMutation):
    created_purchase_order_vendor_ids = graphene.List(
        graphene.NonNull(graphene.String),
        description="List of failed purchase orders.",
    )
    failed_purchase_order_vendor_ids = graphene.List(
        graphene.NonNull(graphene.String),
        description="List of failed purchase orders.",
    )
    error_msgs = graphene.List(
        graphene.String,
        description="List of errors that occurred executing the mutation.",
    )

    class Arguments:
        orders_to_create = graphene.List(
            graphene.NonNull(PurchaseOrderBulkCreateInput),
            required=True,
            description="List of purchase orders to be created.",
        )

    class Meta:
        description = "Creates multiple purchase orders at once."
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        orders_to_create = data.get("orders_to_create")
        created_purchase_order_vendor_ids = []
        failed_purchase_order_vendor_ids = []
        errors = []

        for order_to_create in orders_to_create:
            input_data = order_to_create.get("input")
            try:
                PurchaseOrderCreate.perform_mutation(_root, info, input=input_data)
                created_purchase_order_vendor_ids.append(input_data.get("vendor"))
            except ValidationError as e:
                failed_purchase_order_vendor_ids.append(input_data.get("vendor"))
                errors.append(str(e))

        return PurchaseOrderBulkCreate(
            created_purchase_order_vendor_ids=created_purchase_order_vendor_ids,
            failed_purchase_order_vendor_ids=failed_purchase_order_vendor_ids,
            error_msgs=errors,
        )
