        input = SalesB2bSettlementSendInput(required=True)

    class Meta:
        description = "B2b 마감명세서 발송"
        model = models.SalesB2bSettlement
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def validate_status(cls, cleaned_input):
        brand = cleaned_input.get("brand")
        sales_close_date = cleaned_input.get("sales_close_date")
        b2b_sales_qs = StatsBrandQueries.sales_qs_exclude_canceled()
        b2b_sales_qs = b2b_sales_qs.filter(order_type__in=ORDER_TYPES_FOR_B2B)
        b2b_statuses = (
            b2b_sales_qs.filter(brand=brand, sales_close_date=sales_close_date)
            .values_list("b2b_status", flat=True)
            .distinct()
        )

        b2b_statuses_set = set(b2b_statuses)
        if (
            SalesB2bStatus.REQ_REVISION in b2b_statuses_set
            or SalesB2bStatus.REVISION in b2b_statuses_set
        ):
            raise ValidationError(
                f"수정요청, 또는 수정상태의 매출데이터갸 있다면, 발송대기 처리해야 마감명세서를 발송할 수 있습니다."
            )

