def bulk_create_po_line_status_histories(
    purchase_order_lines: List["PurchaseOrderLine"],
    after_status: PurchaseOrderLineStatus,
    user: Optional["User"],
    before_status: PurchaseOrderLineStatus = None,
    before_status_list: List[PurchaseOrderLineStatus] = None,
    reason: str = "",
):
    histories = []
    if before_status_list:
        for line, before_status in zip(purchase_order_lines, before_status_list):
            histories.append(
                PurchaseOrderLineStatusHistory(
                    purchase_order_line=line,
                    before_status=before_status,
                    after_status=after_status,
