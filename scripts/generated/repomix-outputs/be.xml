        qty_after=qty_after,
        qty=qty,
        event_type=event_type,
        brand=brand,
        description=description,
    )


def create_fbv_delivery_condition_by_base_user_condition(user: "User"):
    from ..vendor.models import FbvDeliveryCondition

    brand_id = user.brand_id
    base_condition_qs = FbvDeliveryCondition.objects.filter(
        user__brand_id=brand_id, is_base_user=True
    )
    base_condition_list = list(base_condition_qs)
    create_list = []
    for base_condition in base_condition_list:
        new_condition: FbvDeliveryCondition = copy.deepcopy(base_condition)
        new_condition.pk = None
        new_condition.user = user
        new_condition.is_base_user = False
        create_list.append(new_condition)
    FbvDeliveryCondition.objects.bulk_create(create_list)


def transfer_fbv_delivery_condition(ex_owner: "User", user: "User"):
    from ..vendor.models import FbvDeliveryCondition

    FbvDeliveryCondition.objects.filter(user=ex_owner).update(user=user)
