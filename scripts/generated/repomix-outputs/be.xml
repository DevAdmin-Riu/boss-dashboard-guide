    @classmethod
    def clean_details(cls, info, input_data):
        details = []
        details_input = input_data.get("to_details")
        for detail in details_input:
            rack_location_id = detail.get("to_rack_location")
            to_rack_location: StockModel = graphene.Node.get_node_from_global_id(
                info, rack_location_id, only_type=RackLocation
            )
