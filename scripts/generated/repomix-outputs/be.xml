from typing import Dict, List

import graphene
from django.core.exceptions import ObjectDoesNotExist, ValidationError
from django.db import transaction

from ....account.models import User
from ....order import OrderLineB2bStatus, models
from ....order.actions import update_on_change_qty_of_deferred_pay
from ....order.actions_b2b import (
    bulk_create_order_line_b2b_status_histories,
    send_email_b2b_order_line_pending_to_riu,
    send_email_b2b_order_line_rejected_to_brand,
)
from ....order.events import (
    order_b2b_canceled_event,
    order_b2b_pending_event,
    order_b2b_received_event,
    order_b2b_rejected_event,
)
from ....order.models import OrderLine as OrderLineModel
from ....product.models import BrandProductVariant
from ...core.mutations import BaseMutation, ModelMutation
from ...core.scalars import PositiveDecimal
from ...core.types.common import OrderError
from ...core.utils import from_global_id_strict_type
from ...product.bulk_mutations.utils import validate_data_is_non_null
from ..types import OrderLine


def validate_order_lines(details) -> Dict[str, OrderLineModel]:
    order_line_pks = []
    for detail in details:
        order_line_id = detail.get("order_line_id")
        if order_line_id:
            order_line_pk = from_global_id_strict_type(order_line_id, OrderLine)
            order_line_pks.append(order_line_pk)

    errors = []
    order_line_dict = {}
    order_lines = []
    for order_line_id in order_line_pks:
        try:
            order_line = models.OrderLine.objects.get(id=order_line_id)
            order_line_dict[order_line_id] = order_line
            order_lines.append(order_line)
        except ObjectDoesNotExist:
            errors.append(order_line_id)
            continue

    if len(errors) > 0:
        error_msg = "주문 아이디 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return order_line_dict, order_lines


class OrderLineB2bUpdateInput(graphene.InputObjectType):
    quantity = PositiveDecimal(description="주문 수량")
    unit_price = PositiveDecimal(description="판매가 (부가세 포함)")
    unit_price_vat = PositiveDecimal(description="판매가 (부가세)")
    b2b_delivery_fee_exclude_vat = PositiveDecimal(description="B2B 배송비 (부가세별도)")


class OrderLineB2bUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of an order line to update.")
        input = OrderLineB2bUpdateInput(
            description="Fields required to update a order line.", required=True
        )

    class Meta:
        description = "Updates a order line for an order."
        model = models.OrderLine
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def get_qs_for_instances(cls):
        return models.OrderLine.objects.select_related("brand_product_variant").all()

    @classmethod
    def validate_b2b_delivery_fee(cls, instance: OrderLineModel, cleaned_input):
        bpv: BrandProductVariant = instance.brand_product_variant
        if bpv.include_sales_b2b_delivery_fee:
            b2b_delivery_fee_exclude_vat = cleaned_input.get(
                "b2b_delivery_fee_exclude_vat", instance.b2b_delivery_fee_exclude_vat
            )
            if b2b_delivery_fee_exclude_vat != 0:
                raise ValidationError(
                    "판매가에 배송비 포함된 상품의 주문에서는 b2b 배송비(판매) 값은 0 이어야 합니다."
                )

    @classmethod
    def clean_input(cls, info, instance: OrderLineModel, data):
        unit_price = data.pop("unit_price", None)
        cleaned_input = super().clean_input(info, instance, data)
        if unit_price is not None:
            cleaned_input["unit_price_gross_amount"] = unit_price
        cls.validate_b2b_delivery_fee(instance, cleaned_input)
        return cleaned_input

    @classmethod
    def post_save_action(cls, info, instance: OrderLineModel, cleaned_input):
        update_on_change_qty_of_deferred_pay([instance])


class OrderLinesB2bRejectDetailInput(graphene.InputObjectType):
    order_line_id = graphene.ID(required=True, description="OrderLine ID")


class OrderLinesB2bRejectInput(graphene.InputObjectType):
    details = graphene.List(
        OrderLinesB2bRejectDetailInput,
        required=True,
        description="거부 처리할 b2b 반품 주문 상세 정보 리스트",
    )
    reason = graphene.String(required=True, description="거부 사유")


class OrderLinesB2bReject(BaseMutation):
    order_lines = graphene.List(OrderLine)

    class Arguments:
        input = OrderLinesB2bRejectInput(description="거부 처리 입력 필드", required=True)

    class Meta:
        description = "B2b 반품 주문 거부 처리."
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_b2b_status(cls, order_lines: List[OrderLineModel]):
        invalid_lines = [
            line for line in order_lines if line.b2b_status not in [OrderLineB2bStatus.PENDING]
        ]
        if invalid_lines:
            invalid_ids = ", ".join([line.composed_id_with_prefix for line in invalid_lines])
            raise ValidationError(f"거부할 수 없는 상태의 OrderLine이 존재합니다. {invalid_ids}")

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        _, order_lines = validate_order_lines(details)
        cls.validate_b2b_status(order_lines)
        return details, order_lines

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        user: "User" = info.context.user
        input_data = data.get("input")
        reason = input_data.get("reason")
        _, order_lines = cls.clean_details(info=info, input_data=input_data)

        target_instance_ids = [instance.pk for instance in order_lines]
        models.OrderLine.objects.filter(pk__in=target_instance_ids).update(
            b2b_status=OrderLineB2bStatus.REJECTED, b2b_reject_reason=reason
        )
        order_b2b_rejected_event(user=user, reason=reason, order_lines=order_lines)
        bulk_create_order_line_b2b_status_histories(
            order_lines,
            before_status=OrderLineB2bStatus.PENDING,
            after_status=OrderLineB2bStatus.REJECTED,
            user=user,
            reason=reason,
        )
        send_email_b2b_order_line_rejected_to_brand(info, order_lines, reason)
        return OrderLinesB2bReject(order_lines=order_lines)


class OrderLinesB2bPending(BaseMutation):
    order_lines = graphene.List(OrderLine)

    class Arguments:
        order_line_ids = graphene.List(
            graphene.ID,
            required=True,
            description="재등록 처리할 OrderLine ID 리스트",
        )

    class Meta:
        description = "OrderLine 발송 처리"
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_b2b_status(cls, order_lines: List[OrderLineModel]):
        invalid_lines = [
            line for line in order_lines if line.b2b_status not in [OrderLineB2bStatus.REJECTED]
        ]
        if invalid_lines:
            invalid_ids = ", ".join([line.composed_id_with_prefix for line in invalid_lines])
            raise ValidationError(f"재등록할 수 없는 상태의 주문이 존재합니다. {invalid_ids}")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, order_line_ids):
        user: "User" = info.context.user
        order_lines: List[OrderLineModel] = cls.get_nodes_or_error(
            order_line_ids, "order_line_ids", OrderLine
        )
        cls.validate_b2b_status(order_lines)

        if order_lines:
            for order_line in order_lines:
                order_line.b2b_status = OrderLineB2bStatus.PENDING

            models.OrderLine.objects.bulk_update(order_lines, ["b2b_status"])

            order_b2b_pending_event(user=user, order_lines=order_lines)
            bulk_create_order_line_b2b_status_histories(
                order_lines,
                before_status=OrderLineB2bStatus.REJECTED,
                after_status=OrderLineB2bStatus.PENDING,
                user=user,
            )
            send_email_b2b_order_line_pending_to_riu(order_lines)
        return OrderLinesB2bPending(order_lines=order_lines)


class OrderLinesB2bReceiveDetailInput(graphene.InputObjectType):
    order_line_id = graphene.ID(required=True, description="OrderLine ID")
    qty = PositiveDecimal(required=True, description="주문 수량")
    unit_price = PositiveDecimal(required=True, description="판매가 (부가세 포함)")
    unit_price_vat = PositiveDecimal(description="판매가 (부가세)")
    b2b_delivery_fee_exclude_vat = graphene.Int(description="B2B 배송비 (부가세별도)")


class OrderLinesB2bReceiveInput(graphene.InputObjectType):
    details = graphene.List(
        OrderLinesB2bReceiveDetailInput,
        required=True,
        description="거부 처리할 b2b 반품 주문 상세 정보 리스트",
    )


class OrderLinesB2bReceive(BaseMutation):
    order_lines = graphene.List(OrderLine)

    class Arguments:
        input = OrderLinesB2bReceiveInput(description="접수 처리 입력 필드", required=True)

    class Meta:
        description = "B2B 주문 접수 처리"
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_b2b_status(cls, order_lines: List[OrderLineModel]):
        invalid_order_lines = [
            line for line in order_lines if line.b2b_status not in [OrderLineB2bStatus.PENDING]
        ]
        if invalid_order_lines:
            invalid_codes = ", ".join([line.b2b_status for line in invalid_order_lines])
            raise ValidationError(f"접수할 수 없는 상태의 OrderLine이 존재합니다. {invalid_codes}")

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        order_line_dict, order_lines = validate_order_lines(details)
        cls.validate_b2b_status(order_lines)
        return details, order_lines, order_line_dict

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        user: "User" = info.context.user
        input_data = data.get("input")
        details, _, order_line_dict = cls.clean_details(info=info, input_data=input_data)

        update_order_lines = []
        for detail in details:
            order_line_pk = from_global_id_strict_type(detail.get("order_line_id"), OrderLine)
            order_line: OrderLineModel = order_line_dict[order_line_pk]
            order_line.quantity = detail.get("qty")
            order_line.unit_price_gross_amount = detail.get("unit_price")
            order_line.unit_price_vat = detail.get("unit_price_vat")
            order_line.b2b_delivery_fee_exclude_vat = detail.get("b2b_delivery_fee_exclude_vat", 0)
            order_line.b2b_status = OrderLineB2bStatus.RECEIVED
            update_order_lines.append(order_line)

        if update_order_lines:
            models.OrderLine.objects.bulk_update(
                update_order_lines,
                [
                    "quantity",
                    "unit_price_gross_amount",
                    "unit_price_vat",
                    "b2b_delivery_fee_exclude_vat",
                    "b2b_status",
                ],
            )
            update_on_change_qty_of_deferred_pay(update_order_lines)

        order_b2b_received_event(user=user, order_lines=update_order_lines)
        bulk_create_order_line_b2b_status_histories(
            update_order_lines,
            before_status=OrderLineB2bStatus.PENDING,
            after_status=OrderLineB2bStatus.RECEIVED,
