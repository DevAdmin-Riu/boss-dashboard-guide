    @one_of_permissions_required([AccountPermissions.MANAGE_HQ_STAT])
    def resolve_brand_user_stats(self, _info, id, **kwargs):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = StatsBrandQueries.filter_sales_brand_id(qs, id)
        qs = StatsBrandQueries.filter_sales_is_main_pv(qs)

        stat_date = kwargs.get("stat_date")
        period = kwargs.get("period")
        first = kwargs.get("first")
        sort_field = kwargs.get("sort_field")
        sort_direction = kwargs.get("sort_direction")

        if stat_date:
            qs = StatsBrandQueries.filter_sales_evented_at_range(qs, stat_date)
        elif period:
            qs = filter_by_period(qs, period, "evented_at")

        qs = (
            qs.values("user_id")
            .annotate(stat_order_count=Count("order_id", distinct=True))
            .annotate(stat_quantity=Coalesce(Sum("bundle_qty"), 0))
            .annotate(
                stat_total_price_exclude_vat=Coalesce(
                    Sum("total_price_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                user_info=Subquery(
                    Sales.objects.filter(user_id=OuterRef("user_id"))
                    .order_by("-evented_at", "-id")
                    .values("user_info")[:1]
                ),
                brand_store_name=Subquery(
                    BrandStore.objects.filter(owner_user_id=OuterRef("user_id")).values("name")[:1]
                ),
            )
        )

        if sort_field == BrandUserStatSortMode.ORDER_COUNT:
            sorting_field = "stat_order_count"
        elif sort_field == BrandUserStatSortMode.CAPTURED_TOTAL:
            sorting_field = "stat_total_price_exclude_vat"
        else:
            sorting_field = None

        if sorting_field:
            if sort_direction == OrderDirection.DESC:
                sorting_field = f"-{sorting_field}"
            qs = qs.order_by(sorting_field)

        if first:
            qs = qs[:first]

        for record in qs:
            record["user_id"] = graphene.Node.to_global_id("User", record.get("user_id"))

        return qs

    @one_of_permissions_required([AccountPermissions.MANAGE_HQ_STAT])
    def resolve_brand_product_stats(self, _info, id, **kwargs):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = StatsBrandQueries.filter_sales_brand_id(qs, id)
        qs = StatsBrandQueries.filter_sales_is_main_pv(qs)
        brand_id = get_brand_id_from_query(id)

        stat_date = kwargs.get("stat_date")
        period = kwargs.get("period")
        first = kwargs.get("first")
        sort_field = kwargs.get("sort_field")
        sort_direction = kwargs.get("sort_direction")

        if stat_date:
            qs = StatsBrandQueries.filter_sales_evented_at_range(qs, stat_date)
        elif period:
            qs = filter_by_period(qs, period, "evented_at")

        subquery_qs = qs.model.objects.filter(
            brand_id=brand_id, is_main_pv=True, bp_sku=OuterRef("bp_sku")
        )

        qs = (
            qs.values("bp_sku")
            .annotate(stat_quantity=Coalesce(Sum("bundle_qty"), 0))
            .annotate(
                stat_total_price_exclude_vat=Coalesce(
                    Sum("total_price_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                stat_unit_price=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("unit_price")[:1]
                ),
                stat_brand_unit_cost_price=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("brand_unit_cost_price")[:1]
                ),
                stat_brand_unit_delivery_fee=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("brand_unit_delivery_fee")[:1]
                ),
                is_inner=Subquery(
                    subquery_qs.annotate(
                        inner_flag=Case(
                            When(variant__outer__isnull=False, then=Value(True)),
                            default=Value(False),
                            output_field=BooleanField(),
                        )
                    ).values("inner_flag")[:1]
                ),
                product_info=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("product_info")[:1]
                ),
                qty_per_box_unit_type=Subquery(
                    subquery_qs.values("variant__qty_per_box_unit_type")[:1]
                ),
                is_tax_free=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("is_tax_free")[:1]
                ),
                is_exclusive=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("is_exclusive")[:1]
                ),
                is_fulfilled_by_vendor=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("is_fulfilled_by_vendor")[:1]
                ),
                variant_sales_status=Subquery(
                    subquery_qs.order_by("-evented_at", "-id").values("variant__sales_status")[:1]
                ),
                bpv_sales_status=Subquery(
                    BrandProductVariant.objects.filter(
                        brand_id=brand_id, product_variant_id=OuterRef("variant_id")
                    ).values("sales_status")[:1]
                ),
                bp_bundle_sales_status=Subquery(
                    BpBundle.objects.filter(id=OuterRef("bp_bundle_id")).values("sales_status")[:1]
                ),
            )
        )

        if sort_field == BrandProductStatSortMode.QUANTITY:
            sorting_field = "stat_quantity"
        elif sort_field == BrandProductStatSortMode.TOTAL:
            sorting_field = "stat_total_price_exclude_vat"
        else:
            sorting_field = None

        if sorting_field:
            if sort_direction == OrderDirection.DESC:
                sorting_field = f"-{sorting_field}"

            qs = qs.order_by(sorting_field)

        if first:
            qs = qs[:first]

        return qs

    def resolve_exclusive_variant_monthly_stock_info_for_brand(self, _info, **kwargs):
        id = kwargs.get("id")
        brand_id = get_brand_id_from_query(id)
        stat_date = kwargs.get("stat_date")

        # 1. 전용상품 쿼리셋 가져오기
        exclusive_bpv_qs = StatsBrandQueries.get_exclusive_bpv_qs(brand_ids=[brand_id])

        # 2. product_variant_id 추출
        variant_ids = exclusive_bpv_qs.values_list("product_variant_id", flat=True)

        # 3. 스냅샷 데이터 집계
        aggregated_data = StatsBrandQueries.get_aggregated_snapshot_data(variant_ids, stat_date)

        # 4. 전용상품 정보를 미리 캐싱
        bpv_map = {bpv.product_variant_id: bpv for bpv in exclusive_bpv_qs}

        # 5. 집계된 데이터 처리
        result_map = StatsBrandQueries.process_aggregated_snapshot_data(aggregated_data, bpv_map)

        # 6. 결과 반환
        return [
            {
                "stat_date": stat_date,
                "in_stock_exclusive_variants_count": result["in_stock_exclusive_variants_count"],
                "total_exclusive_bpv_cost": result["total_exclusive_bpv_cost"],
                "total_exclusive_pv_cost": result["total_exclusive_pv_cost"],
                "critical_exclusive_variants_count": result["critical_exclusive_variants_count"],
                "critical_total_exclusive_bpv_cost": result["critical_total_exclusive_bpv_cost"],
                "critical_total_exclusive_pv_cost": result["critical_total_exclusive_pv_cost"],
            }
            for stat_date, result in result_map.items()
        ]

    def resolve_exclusive_variant_monthly_stock_info_for_brands(self, _info, **kwargs):
        ids = kwargs.get("ids")
        stat_date = kwargs.get("stat_date")

        # 1. 브랜드 필터링
        if ids:
            brand_ids = [get_brand_id_from_query(id) for id in ids]
        else:
            brand_qs = Brand.objects.all()
            brand_ids = list(brand_qs.values_list("id", flat=True))

        # 2. 전용상품 쿼리셋 가져오기
        exclusive_bpv_qs = StatsBrandQueries.get_exclusive_bpv_qs(brand_ids=brand_ids)

        # 3. product_variant_id와 brand_id 매핑
        variant_to_brand_map = defaultdict(list)
        for bpv in exclusive_bpv_qs:
            variant_to_brand_map[bpv.product_variant_id].append(bpv.brand_product.brand_id)

        # 4. 스냅샷 데이터 집계
        variant_ids = list(variant_to_brand_map.keys())
        aggregated_data = StatsBrandQueries.get_aggregated_snapshot_data(variant_ids, stat_date)

        # 5. 전용상품 정보를 미리 캐싱
        bpv_map = {
            (bpv.product_variant_id, bpv.brand_product.brand_id): bpv for bpv in exclusive_bpv_qs
        }

        # 6. 집계된 데이터 처리
        result_map = StatsBrandQueries.process_aggregated_snapshot_data(
            aggregated_data, bpv_map, variant_to_brand_map
        )

        # 7. 결과 반환
        return [
            {
                "brand_id": brand_id,
                "brand_global_id": graphene.Node.to_global_id("Brand", brand_id),
                "stat_date": stat_date,
                "in_stock_exclusive_variants_count": result["in_stock_exclusive_variants_count"],
                "total_exclusive_bpv_cost": result["total_exclusive_bpv_cost"],
                "total_exclusive_pv_cost": result["total_exclusive_pv_cost"],
                "critical_exclusive_variants_count": result["critical_exclusive_variants_count"],
                "critical_total_exclusive_bpv_cost": result["critical_total_exclusive_bpv_cost"],
                "critical_total_exclusive_pv_cost": result["critical_total_exclusive_pv_cost"],
            }
            for (brand_id, stat_date), result in result_map.items()
        ]


class StatsBrandMutations(graphene.ObjectType):
    pass
