            return ~(vendor_filter | no_delivery_condition_q)

        filters = brand_filter & force_no_normal_display_filter & visible_outer_variant_filter()

        brand: Brand = user.brand
        if BrandServiceType.FBV in brand.enabled_services:
            filters &= Q(is_fulfilled_by_vendor=True) & exclude_vendor_filter() | Q(
                is_fulfilled_by_vendor=False
            )
