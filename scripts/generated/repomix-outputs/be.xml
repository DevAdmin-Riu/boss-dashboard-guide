def create_payment_information(
    payment: Payment,
    payment_token: str = None,
    amount: Decimal = None,
    customer_id: str = None,
    store_source: bool = False,
    additional_data: Optional[dict] = None,
    cashable_credits: Decimal = None,
    non_cashable_credits: Decimal = None,
    rcoins: Decimal = None,
) -> PaymentData:
    """Extract order information along with payment details.

    Returns information required to process payment and additional
    shipping addresses for optional fraud-prevention mechanisms.
    """
    if payment.checkout:
        shipping = payment.checkout.shipping_address
    elif payment.order:
        shipping = payment.order.shipping_address
    else:
        shipping = None

    shipping_address = AddressData(**shipping.as_data()) if shipping else None

    order_id = payment.order.pk if payment.order else None
    graphql_payment_id = graphene.Node.to_global_id("Payment", payment.pk)

    if amount is None:
        amount = payment.total
    if cashable_credits is None:
        cashable_credits = 0
    if non_cashable_credits is None:
        non_cashable_credits = 0
    if rcoins is None:
        rcoins = 0

    return PaymentData(
        token=payment_token,
        amount=amount,
        currency=payment.currency,
        shipping=shipping_address,
        order_id=order_id,
        payment_id=payment.pk,
        graphql_payment_id=graphql_payment_id,
        customer_ip_address=payment.customer_ip_address,
        customer_id=customer_id,
        customer_email=payment.billing_email,
        reuse_source=store_source,
        data=additional_data or {},
        cashable_credits=cashable_credits,
        non_cashable_credits=non_cashable_credits,
        rcoins=rcoins,
    )


def divide_credits_by_cashable_and_non_cashable(checkout_owner_user: User, credits: int):
    if not checkout_owner_user:
        return credits, 0
    # 사용 충전금은 출금 불가 충전금 먼저 차감 정책
    non_cashable_credits = min(credits, checkout_owner_user.non_cashable_credits)
    cashable_credits = credits - non_cashable_credits

    return cashable_credits, non_cashable_credits


def create_payment(
    *,
    gateway: str,
    is_toss_riu_pay: bool,
    total: Decimal,
    currency: str,
    email: str,
    customer_ip_address: str = "",
    payment_token: Optional[str] = "",
    extra_data: Dict = None,
    checkout: Checkout = None,
    order: Order = None,
    return_url: str = None,
    amount: Decimal = Decimal(0),
    cashable_credits: int = 0,
    non_cashable_credits: int = 0,
    rcoins: int = 0,
    tax: int = 0,
    taxfree: int = 0,
) -> Payment:
    """Create a payment instance.

    This method is responsible for creating payment instances that works for
    both Django views and GraphQL mutations.
    """
    if extra_data is None:
        extra_data = {}

    data = {
        "is_active": True,
        "customer_ip_address": customer_ip_address,
        "extra_data": json.dumps(extra_data),
        "token": payment_token,
    }

    if checkout:
        data["checkout"] = checkout
    elif order:
        data["order"] = order
    else:
        raise TypeError("Must provide checkout or order to create a payment.")

    defaults = {
        "billing_email": email if email else "",
        "currency": currency,
        "gateway": gateway,
        "is_toss_riu_pay": is_toss_riu_pay,
        "total": total,
        "return_url": return_url,
        "amount": amount,
        "cashable_credits": cashable_credits,
        "non_cashable_credits": non_cashable_credits,
        "rcoins": rcoins,
        "origin_amount": amount,
        "origin_cashable_credits": cashable_credits,
        "origin_non_cashable_credits": non_cashable_credits,
        "origin_rcoins": rcoins,
        "captured_amount": 0,
        "captured_cashable_credits": 0,
        "captured_non_cashable_credits": 0,
        "captured_rcoins": 0,
        "tax": tax,
        "taxfree": taxfree,
    }

    payment, _ = Payment.objects.get_or_create(defaults=defaults, **data)

    logger.info(f"payment_debug: create_payment get_or_create {payment}")

    return payment


def get_already_processed_transaction(payment: "Payment", gateway_response: GatewayResponse):
    transaction = payment.transactions.filter(
