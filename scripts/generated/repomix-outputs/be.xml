    def get_aggregated_snapshot_data(variant_ids, stat_date):
        """
        스냅샷 필터링 및 데이터베이스 집계
        """
        trunc_func = StatsBrandQueries.get_trunc_function(StatReportingMode.MONTHLY)
        snapshot_qs = ProductVariantMonthlyStockSnapshot.objects.filter(variant_id__in=variant_ids)

        if stat_date:
            snapshot_qs = filter_range_field(snapshot_qs, "stat_date", stat_date)

        return snapshot_qs.values(
            "stat_date",
            "variant_id",
        ).annotate(
            trunc_stat_date=trunc_func("stat_date"),
            total_quantity=Sum("sum_of_stock_qty"),
            critical_count=Count(
                Case(
                    When(stock_status_by_daily=StockStatusByEstShortage.CRITICAL, then=1),
                    output_field=IntegerField(),
                )
            ),
        )

    @staticmethod
    def process_single_brand_exclusive_variant_stock_info(
        result_map, key, bpv: "BrandProductVariant", total_quantity, critical_count
    ):
        """
        단일 브랜드 데이터를 처리하여 결과 집계
        """
        cost_price_exclude_vat = Decimal(bpv.cost_price_exclude_vat or 0)
        delivery_fee_amount = Decimal(bpv.delivery_fee_amount or 0)
        pv: ProductVariant = bpv.product_variant
        is_tax_free = pv.product.is_tax_free

        if total_quantity > 0:
            # 재고 금액 계산
            if is_tax_free:
                bpv_cost = total_quantity * (cost_price_exclude_vat + delivery_fee_amount)
                pv_cost = total_quantity * (pv.cost_price_exclude_vat + pv.delivery_fee_amount)
            else:
                bpv_cost = total_quantity * (
                    my_round(cost_price_exclude_vat * Decimal(1.1)) + delivery_fee_amount
                )
                pv_cost = total_quantity * (
                    my_round(pv.cost_price_exclude_vat * Decimal(1.1)) + pv.delivery_fee_amount
                )

            # 일반 재고 집계
            result_map[key]["in_stock_exclusive_variants_count"] += 1
            result_map[key]["total_exclusive_bpv_cost"] += bpv_cost
            result_map[key]["total_exclusive_pv_cost"] += pv_cost

            # 악성 재고 집계
            if critical_count > 0:
                result_map[key]["critical_exclusive_variants_count"] += critical_count
                result_map[key]["critical_total_exclusive_bpv_cost"] += bpv_cost
                result_map[key]["critical_total_exclusive_pv_cost"] += pv_cost

    @staticmethod
    def process_aggregated_snapshot_data(aggregated_snapshot_data, bpv_map, variant_to_brand=None):
        """
        집계된 전용상품 및 스냅샷 데이터를 처리하여 결과 반환
        """
        result_map = defaultdict(
            lambda: {
                "in_stock_exclusive_variants_count": 0,
                "total_exclusive_bpv_cost": 0,
                "total_exclusive_pv_cost": 0,
                "critical_exclusive_variants_count": 0,
                "critical_total_exclusive_bpv_cost": 0,
                "critical_total_exclusive_pv_cost": 0,
            }
        )

        for data in aggregated_snapshot_data:
            stat_date = data["trunc_stat_date"]
            variant_id = data["variant_id"]
            total_quantity = data["total_quantity"]
            critical_count = data["critical_count"]

            if variant_to_brand is None:
                # 단일 브랜드 처리
                bpv = bpv_map.get(variant_id)
                if not bpv:
                    continue

                StatsBrandQueries.process_single_brand_exclusive_variant_stock_info(
                    result_map, stat_date, bpv, total_quantity, critical_count
                )
                continue
            else:
                # 여러 브랜드 처리
                for brand_id in variant_to_brand.get(variant_id, []):
                    bpv = bpv_map.get((variant_id, brand_id))
                    if not bpv:
                        continue

                    StatsBrandQueries.process_single_brand_exclusive_variant_stock_info(
                        result_map, (brand_id, stat_date), bpv, total_quantity, critical_count
                    )

        return result_map

    @one_of_permissions_required([AccountPermissions.MANAGE_HQ_STAT])
    def resolve_brand_order_stats(self, _info, id, **kwargs):
        filter = kwargs.get("filter")
        stat_date = filter.get("stat_date")
        is_fulfilled_by_vendor = filter.get("is_fulfilled_by_vendor")
        mode = filter.get("mode")
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = StatsBrandQueries.filter_sales_brand_id(qs, id)
        qs = StatsBrandQueries.filter_sales_evented_at_range(qs, stat_date)
        qs = StatsBrandQueries.filter_sales_is_fulfilled_by_vendor(qs, is_fulfilled_by_vendor)

        trunc_func = StatsBrandQueries.get_trunc_function(mode)
        qs = StatsBrandQueries.calculate_order_stats(qs, trunc_func)

        # 결과를 리스트로 변환
        result_list = list(qs)

        # 결과 리스트의 각 항목에 대해 global_brand_id 필드 값을 설정
        for result in result_list:
            result["brand_global_id"] = graphene.Node.to_global_id("Brand", result["brand_id"])

        return result_list

