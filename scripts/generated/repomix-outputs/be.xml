                    pallet_o = detail.get("pallet_o")
                    if pallet_o is not None:
                        pv.pallet_o = pallet_o

                maker_name = detail.get("maker_name")
                if maker_name is not None:
                    pv.maker = makers[maker_name]
                country_of_origin = detail.get("country_of_origin")
                if country_of_origin is not None:
                    pv.country_of_origin = country_of_origin
                if product.product_type.has_variants:
                    variant_name = normalize_newlines_to_space(detail.get("variant_name"))
                    if variant_name is not None:
                        pv.name = variant_name
                priority_level = detail.get("priority_level")
                if priority_level is not None:
                    pv.priority_level = priority_level
                stock_adjust_factor = detail.get("stock_adjust_factor")
                if stock_adjust_factor is not None:
