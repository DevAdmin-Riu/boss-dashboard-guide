from typing import TYPE_CHECKING

from django.core.exceptions import ValidationError

from .. import CategoryKind
from . import make_category_code, make_serial_number, make_sku

if TYPE_CHECKING:
    from ..models import ProductVariant, ProductVariantVendor


def validate_track_inventory(variant: "ProductVariant"):
    if variant.can_sale_by_inner and variant.is_sub_pv:
        raise ValidationError("부자재 제품은 이너박스 운영으로 설정할 수 있습니다.")
    if variant.track_inventory:
        if variant.is_for_credits_refill:
            raise ValidationError("충전금 제품은 위탁제품으로 설정해야합니다.")
        if variant.is_dev_pv:
            raise ValidationError("개발비 제품은 위탁제품으로 설정해야합니다.")
    else:
        if variant.allow_auto_consignment:
            raise ValidationError("재고 운영 제품만 자동 위탁을 허용할 수 있습니다.")
        if variant.is_sub_pv:
            raise ValidationError("재고 운영 제품만 부자재로 설정할 수 있습니다.")

        if not variant.pk:
            variant_vendor = variant.get_default_variant_vendor()
            if variant_vendor and variant_vendor.consignment_product_price_exclude_vat <= 0:
                raise ValidationError(
                    "기본 협력사의 위탁 상품가가 0 이하면 재고 미운영으로 설정할 수 없습니다."
                )
            if variant.sub_pv is not None and variant.main_pvs_relation.exists():
                raise ValidationError(
                    "부자재 - 부자재 필요 제품 관계로 연결된 경우 재고 미운영으로 설정할 수 없습니다."
                )


def validate_is_vendor_track_inventory(variant: "ProductVariant"):
    if variant.is_vendor_track_inventory:
        if variant.outer_id:
            raise ValidationError("이너 제품은 협력사 위탁재고로 설정할 수 없습니다.")
        if not variant.track_inventory:
            raise ValidationError("협력사 위탁재고 제품은 재고운영으로 설정해야 합니다.")
        if variant.is_sub_pv:
            raise ValidationError("협력사 위탁재고 제품은 부자재 제품으로 설정할 수 없습니다.")
        if variant.is_adjust_price:
            raise ValidationError(
                "협력사 위탁재고 제품은 납품 시 금액확정 제품으로 설정할 수 없습니다."
            )
        if variant.allow_auto_consignment:
            raise ValidationError("협력사 위탁재고 제품은 자동 위탁 전환으로 설정할 수 없습니다.")


def validate_is_adjust_price(variant: "ProductVariant"):
    if variant.is_adjust_price:
        if variant.track_inventory:
            raise ValidationError("위탁 제품만 납품 시 금액 확정 제품으로 설정할 수 있습니다.")
        if variant.product.is_fulfilled_by_vendor:
            raise ValidationError("직거래 제품은 납품 시 금액 확정 제품으로 설정할 수 없습니다.")
        if variant.allow_auto_consignment:
            raise ValidationError(
                "자동 위탁 허용 제품은 납품 시 금액 확정 제품으로 설정할 수 없습니다."
            )


# 개발비 제품은 무조건 설정되는 값.
def construct_value_forcefully_in_case_is_dev_pv(variant: "ProductVariant"):
    if variant.is_dev_pv:
        variant.allow_auto_consignment = False
        variant.can_sale_by_inner = False
        variant.auto_turn_off_allow_auto_consignment = False
        variant.is_sub_pv = False
        variant.required_exp_date_mgmt = False


# variant의 코드들을 업데이트 해줌.
def update_variant_codes(variant: "ProductVariant"):
    update_fields = []

    if not variant.category_code:
        variant.category_code = make_category_code(variant)
        update_fields.append("category_code")

    if not variant.serial_number:
        variant.serial_number = make_serial_number(variant)
        update_fields.append("serial_number")

    if not variant.sku:
        variant.sku = make_sku(variant)
        update_fields.append("sku")

    if update_fields:  # 변경된 필드가 있을 경우만 save 호출
        variant.save(update_fields=update_fields)


def validate_product_info_noti(variant: "ProductVariant"):
    if not variant.product.product_info_notification:
        if not (
            variant.is_for_credits_refill
            or variant.is_dev_pv
            or variant.product.category.kind == CategoryKind.B2B
        ):
            raise ValidationError("상품 정보 고시는 필수 입력 항목입니다.")


def validate_dev_pv_of(variant: "ProductVariant"):
    dev_pv_of = variant.dev_pv_of
    if dev_pv_of is not None:
        if not variant.is_dev_pv:
            raise ValidationError("개발비 제품이어야만 제품을 연동할 수 있습니다.")
        # 연동된 제품이 전용 제품이 아닌 경우 에러.
        if not dev_pv_of.product.is_exclusive:
            raise ValidationError("연동된 제품은 전용 제품이어야 합니다.")
        if dev_pv_of.is_inner:
            raise ValidationError("연동된 제품은 이너박스가 될 수 없습니다.")


def reset_po_lead_time_by_pvv(
    pv: "ProductVariant",
    pvv: "ProductVariantVendor",
    from_bulk_update_mode: bool = False,
):
    if pvv.lead_time is None or pvv.lead_time <= 0:
        return False
    pv.po_lead_time = pvv.lead_time
    if from_bulk_update_mode == False:
        pv.save(update_fields=["po_lead_time"])
    return True
