# order당 하나씩 생성되는 모델. created(자동 생성, 결제 시점에 생성됨), 생성시점의 적립율, 적립여부(적립됬는지), order pk, 적립 당시 적립금액.(적립여부가 false이면 값이 비어있어야함.)
class RcoinsReward(models.Model):
    created = models.DateTimeField(auto_now_add=True)
    rate = models.DecimalField(
        max_digits=4,  # 총 4자리: 최대값 100.0
        decimal_places=1,  # 소수점 1자리까지 허용
        default=0.0,
        verbose_name="퍼센트 (%)",
    )
    order = models.OneToOneField(
        "order.Order",
        related_name="rcoins_reward",
        on_delete=models.CASCADE,
    )
    is_rewarded = models.BooleanField(default=False)
    rcoins = models.PositiveIntegerField(default=0, null=False)

    def __str__(self):
        return f"{self.order} - {self.rcoins}%"

    class Meta:
        ordering = ("-pk",)

    # is_settlement_mode의 경우 스케쥴러가 실행될때, 환불 시에, is_rewarded가 true인 경우에 재정산해야 하므로 true로 넘겨줘야한다.
    def update_rcoins(self, is_settlement_mode: bool = False):
        from ..core.utils.math import my_round
        from ..order.utils import (
            get_last_captured_cashable_credits_of_order_line,
            get_last_captured_non_cashable_credits_of_order_line,
        )

        order = self.order

        reward_lines = self.reward_lines.all()

        # 적립 대상 충전금에는 출금가능/출금불가 모두 포함
        order_total_captured_cashable_credits = sum(
            get_last_captured_cashable_credits_of_order_line(order_line)
            for order_line in order.lines.all()
        )
        order_total_captured_non_cashable_credits = sum(
            get_last_captured_non_cashable_credits_of_order_line(order_line)
            for order_line in order.lines.all()
        )

        order_total_captured_credits = (
            order_total_captured_cashable_credits + order_total_captured_non_cashable_credits
        )

        total_target_amount = 0

        # 현금전용(포인트지급)
        total_cash_only_true_and_rcoin_reward_true = 0

        # 현금전용(포인트미지급)
        total_cash_only_true_and_rcoin_reward_false = 0

        # 전체(포인트지급)
        total_cash_only_false_and_rcoin_reward_true = 0

        # 전체(포인트미지급)
        total_cash_only_false_and_rcoin_reward_false = 0

        for reward_line in reward_lines:
            order_line = reward_line.order_line
            order_line_target_quantity = order_line.quantity - order_line.quantity_refunded
            order_line_target_total_price_amount = (
                order_line_target_quantity * order_line.unit_price_gross_amount
            )
            if reward_line.is_only_payable_by_cash and reward_line.is_rcoin_reward_for_using_point:
                total_cash_only_true_and_rcoin_reward_true += order_line_target_total_price_amount
            elif (
                not reward_line.is_only_payable_by_cash
                and reward_line.is_rcoin_reward_for_using_point
            ):
                total_cash_only_false_and_rcoin_reward_true += order_line_target_total_price_amount
            elif (
                reward_line.is_only_payable_by_cash
                and not reward_line.is_rcoin_reward_for_using_point
            ):
                total_cash_only_true_and_rcoin_reward_false += order_line_target_total_price_amount
            elif (
                not reward_line.is_only_payable_by_cash
                and not reward_line.is_rcoin_reward_for_using_point
            ):
                total_cash_only_false_and_rcoin_reward_false += order_line_target_total_price_amount

        # order_total_captured_cashable_credits에서 '현금전용(포인트지급) > 현금전용(포인트미지급) > 전체(포인트지급) > 전체(포인트미지급)' 순서대로 0 이 될떄까지 차감하면서 포인트 지급의 경우에만 total_target_amount에 더한다.
        # 현금전용(포인트지급)
        if total_cash_only_true_and_rcoin_reward_true > 0:
            if order_total_captured_credits > 0:
                if order_total_captured_credits >= total_cash_only_true_and_rcoin_reward_true:
                    total_target_amount += total_cash_only_true_and_rcoin_reward_true
                    order_total_captured_credits -= total_cash_only_true_and_rcoin_reward_true
                else:
                    total_target_amount += order_total_captured_credits
                    order_total_captured_credits = 0

        # 현금전용(포인트미지급)
        if total_cash_only_true_and_rcoin_reward_false > 0:
            if order_total_captured_credits > 0:
                if order_total_captured_credits >= total_cash_only_true_and_rcoin_reward_false:
                    order_total_captured_credits -= total_cash_only_true_and_rcoin_reward_false
                else:
                    order_total_captured_credits = 0

        # 전체(포인트지급)
        if total_cash_only_false_and_rcoin_reward_true > 0:
            if order_total_captured_credits > 0:
                if order_total_captured_credits >= total_cash_only_false_and_rcoin_reward_true:
                    total_target_amount += total_cash_only_false_and_rcoin_reward_true
                    order_total_captured_credits -= total_cash_only_false_and_rcoin_reward_true
                else:
                    total_target_amount += order_total_captured_credits
                    order_total_captured_credits = 0

        # 전체(포인트미지급)
        if total_cash_only_false_and_rcoin_reward_false > 0:
            if order_total_captured_credits > 0:
                if order_total_captured_credits >= total_cash_only_false_and_rcoin_reward_false:
                    order_total_captured_credits -= total_cash_only_false_and_rcoin_reward_false

        rate = self.rate
        rcoins = my_round(total_target_amount * rate / 100)

        # 적립할 포인트(rcoins)가 0 이상인 경우에만 적립.
        with transaction.atomic():
            before_is_reward = self.is_rewarded
            self.is_rewarded = True if is_settlement_mode else False
            is_rewarded_changed = before_is_reward != self.is_rewarded
            # is_rewarded가 바뀐 경우 에는 차액이 아니라 적혀있던 금액을 그대로 적립힌다. 안바뀐경우 이면서 is_settlement_mode가 True인 경우에는 차액만큼만 바꾼다.
            rcoins_changed = rcoins if is_rewarded_changed else (rcoins - self.rcoins)
            self.rcoins = rcoins
            self.save()

            if is_settlement_mode:
                user = order.user
                if rcoins_changed > 0:
                    user.increase_rcoins(
                        rcoins_changed,
                        RcoinsEventType.REWARD,
                        f"주문({order.composed_id_with_prefix})으로 인한 적립",
                        staff=None,
                    )
                elif rcoins_changed < 0:
                    user.decrease_rcoins(
                        abs(rcoins_changed),
                        RcoinsEventType.REWARD_CANCEL,
                        f"주문({order.composed_id_with_prefix})의 환불로 인한 적립 취소",
                        staff=None,
                    )


# order_line당 하나씩 생성되는 모델. 위의 모델 fk, order_line fk, 해당 상품의 현금전용 여부(스냅샷), 해당 상품의 포인트지급 여부(스냅샷)
class RcoinsRewardLine(models.Model):
    reward = models.ForeignKey(
