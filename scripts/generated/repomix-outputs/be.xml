class OrderLinesB2bCancel(BaseMutation):
    order_lines = graphene.List(OrderLine)

    class Arguments:
        order_line_ids = graphene.List(
            graphene.ID,
            required=True,
            description="취소 처리할 OrderLine ID 리스트",
        )

    class Meta:
        description = "B2B OrderLine 취소 처리"
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_b2b_status(cls, order_lines: List[OrderLineModel]):
        invalid_lines = [
            line
            for line in order_lines
            if line.b2b_status
            not in [
                OrderLineB2bStatus.PENDING,
                OrderLineB2bStatus.REJECTED,
                OrderLineB2bStatus.RECEIVED,
            ]
        ]
        if invalid_lines:
            invalid_codes = ", ".join([line.b2b_status for line in invalid_lines])
