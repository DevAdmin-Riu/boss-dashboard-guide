import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ...core.mutations import BaseMutation
from ...core.types.common import ProductError
from ..types import BrandProduct
from ..types.brand_products import BrandProductVariant
from ..types.products import Product, ProductVariant
from ..types.variant_vendors import ProductVariantVendor
from .brand_products import (
    BrandProductVariantManageEventInput,
    BrandUpdateProductInput,
    BrandUpdateProductVariantInput,
    ExtendedBrandProductUpdate,
)
from .products import (
    ExtendedProductUpdate,
    ExtendedProductUpdateAdditionalInput,
    ProductInput,
    ProductVariantInput,
)
from .variant_vendors import ProductVariantVendorUpdate, ProductVariantVendorUpdateInput


class FbvMixedProductUpdate(BaseMutation):
    product = graphene.Field(Product, description="Updated product.")
    product_variant = graphene.Field(ProductVariant, description="Updated product variant.")
    product_variant_vendor = graphene.Field(
        ProductVariantVendor, description="Updated product variant vendor."
    )
    brand_product = graphene.Field(BrandProduct, description="Updated brand product.")
    brand_product_variant = graphene.Field(
        BrandProductVariant, description="Updated brand product variant."
    )

    class Arguments:
        product_id = graphene.ID(description="ID of a product to update.")
        product_input = ProductInput(description="Fields required to update a product.")
        product_variant_id = graphene.ID(description="ID of a product variant to update.")
        product_variant_input = ProductVariantInput(
            description="Fields required to update a product variant"
        )
        additional_input = ExtendedProductUpdateAdditionalInput(
            required=True, description="Fields required to update a product variant"
        )
        brand_product_id = graphene.ID(description="ID of a brand product to update.")
        brand_product_input = BrandUpdateProductInput(
            description="Fields required to update a brand product."
        )
        brand_product_variant_id = graphene.ID(
            description="ID of a brand product variant to update."
        )
        brand_product_variant_input = BrandUpdateProductVariantInput(
            description="Fields required to update a product variant"
        )
        bpv_manage_event = BrandProductVariantManageEventInput(
            description="상품 관리 이력", required=True
        )
        product_variant_vendor_id = graphene.ID(
            description="ID of a product variant vendor to update."
        )
        product_variant_vendor_input = ProductVariantVendorUpdateInput(
            description="Fields required to update a product variant vendor."
        )

    class Meta:
        description = "Update a brand product and a brand product variant."
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        product_id = data.get("product_id")
        product_input = data.get("product_input")
        product_variant_id = data.get("product_variant_id")
        product_variant_input = data.get("product_variant_input")
        additional_input = data.get("additional_input")

        product = None
        product_variant = None
        if (product_id and product_input) or (product_variant_id and product_variant_input):
            response = ExtendedProductUpdate.mutate(
                root,
                info,
                product_id=product_id,
                product_input=product_input,
                product_variant_id=product_variant_id,
                product_variant_input=product_variant_input,
                additional_input=additional_input,
            )
            if response.errors:
                raise ValidationError(f"제품 정보 수정 에러 - {response.errors[0].message}")

            # 벡엔드 mutate 호출 시 BaseMutation 은 snake_case 리턴 argument 선언된 채로 리턴됨
            product = response.product
            product_variant = response.product_variant

        brand_product_id = data.get("brand_product_id")
        brand_product_input = data.get("brand_product_input")
        brand_product_variant_id = data.get("brand_product_variant_id")
        brand_product_variant_input = data.get("brand_product_variant_input")
        bpv_manage_event = data.get("bpv_manage_event")

        brand_product = None
        brand_product_variant = None
        if (brand_product_id and brand_product_input) or (
            brand_product_variant_id and brand_product_variant_input
        ):
            response = ExtendedBrandProductUpdate.mutate(
                root,
                info,
                brand_product_id=brand_product_id,
                brand_product_input=brand_product_input,
                brand_product_variant_id=brand_product_variant_id,
                brand_product_variant_input=brand_product_variant_input,
                manage_event=bpv_manage_event,
            )
            if response.errors:
                raise ValidationError(f"상품 정보 수정 에러 - {response.errors[0].message}")

            # 벡엔드 mutate 호출 시 BaseMutation 은 snake_case 리턴 argument 선언된 채로 리턴됨
            brand_product = response.brand_product
            brand_product_variant = response.brand_product_variant

        product_variant_vendor_id = data.get("product_variant_vendor_id")
        product_variant_vendor_input = data.get("product_variant_vendor_input")

        product_variant_vendor = None
        if product_variant_vendor_id and product_variant_vendor_input:
            response = ProductVariantVendorUpdate.mutate(
                root,
                info,
                id=product_variant_vendor_id,
                input=product_variant_vendor_input,
            )
            if response.errors:
                raise ValidationError(f"기본협력사 정보 수정 에러 - {response.errors[0].message}")

            # 벡엔드 mutate 호출 시 modelMutation 은 camelCase return_field_name 이 리턴됨
            product_variant_vendor = response.productVariantVendor

        return FbvMixedProductUpdate(
            product=product,
            product_variant=product_variant,
            product_variant_vendor=product_variant_vendor,
            brand_product=brand_product,
            brand_product_variant=brand_product_variant,
        )
