def _get_inicis_vbank_captured_date(payment_id: int, gateway_response: str):
    fn_name = _get_inicis_vbank_captured_date.__name__
    if gateway_response is None or type(gateway_response) != str:
        logger.error(f"=== (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
        return None

    try:
        response_key_value_pairs = gateway_response.split("&")
        captured_date_str = None
        dt_trans = None
        tm_trans = None
        for key_value_pair in response_key_value_pairs:
            key_value = key_value_pair.split("=")
            key = key_value[0]
            if key == INICIS_P_AUTH_DT:
                key_value_len = len(key_value)
                if key_value_len <= 1:
                    return None
                else:
                    value = key_value[1]
                    captured_date_str = value
            elif key == INICIS_DT_TRANS:
                key_value_len = len(key_value)
                if key_value_len <= 1:
                    return None
                else:
                    value = key_value[1]
                    dt_trans = value
            elif key == INICIS_TM_TRANS:
                key_value_len = len(key_value)
                if key_value_len <= 1:
                    tm_trans = None
                else:
                    value = key_value[1]
                    tm_trans = value

        if captured_date_str is None:
            if dt_trans:
                if tm_trans:
                    captured_date_str = dt_trans + tm_trans
                else:
                    captured_date_str = dt_trans + "000000"

        if captured_date_str is not None:
            return datetime.datetime.strptime(captured_date_str, "%Y%m%d%H%M%S").astimezone()
    except:
        logger.error(f"==+ (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")

    return None


