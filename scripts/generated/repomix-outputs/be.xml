import json
import logging

from django.core.handlers.wsgi import WSGIRequest
from django.http import Http404, HttpRequest, HttpResponse, HttpResponseBadRequest

from ....core.transactions import transaction_with_commit_on_errors
from ... import ChargeStatus, PaymentFailedType, TransactionKind
from ...interface import GatewayConfig
from ...models import Payment
from ..process_vbank_noti import process_vbank_noti
from ..utils import create_payment_failed_transaction
from .utils import (
    call_toss_brand_pay_access_token_api,
    get_payment_id_by_toss_order_id,
    get_toss_plugin_configs,
)

logger = logging.getLogger(__name__)


@transaction_with_commit_on_errors()
def handle_webhook(request: WSGIRequest, gateway_config: "GatewayConfig"):
    if request.get_full_path().find("/deposit-callback") != -1:
        return handle_deposit_callback(request, gateway_config)
    if request.get_full_path().find("/bp-auth-callback") != -1:
        return handle_brand_pay_auth_callback(request, gateway_config)

    raise Http404("path does not exist")


def handle_brand_pay_auth_callback(request: WSGIRequest, gateway_config: "GatewayConfig"):
    fn_name = handle_deposit_callback.__name__

    gateway_response = request.GET.dict()
    if not gateway_response:
        logger.warning(f"payment_debug: {fn_name} request: {request}")
        return HttpRequest("OK")

    code = gateway_response.get("code")
    customer_key = gateway_response.get("customerKey")

    if not code or not customer_key:
        logger.warning(f"payment_debug: {fn_name} gateway_response: {gateway_response}")
        return HttpRequest("OK")

    logger.info(f"payment_debug: {fn_name} code: {code} customer_key: {customer_key}")

    plugin_configs = get_toss_plugin_configs(gateway_config)
    # 매출인식인 경우 리다이렉트 url 을 브랜드 별로 별도로 설정해야 함
    is_success = call_toss_brand_pay_access_token_api(plugin_configs, code, customer_key)
    if is_success:
        return HttpResponse("OK")
    return HttpResponseBadRequest("토큰 발급 실패")


def handle_deposit_callback(request: WSGIRequest, gateway_config: "GatewayConfig"):
    fn_name = handle_deposit_callback.__name__
    body = request.body.decode("EUC-KR")
    logger.warning(f"payment_debug: {fn_name} {body}")

    gateway_response = json.loads(body)
    toss_order_id = gateway_response.get("orderId")
    secret = gateway_response.get("secret")
    status = gateway_response.get("status")
    if status != "DONE":
        logger.warning(f"payment_debug: {fn_name} status {status}")
        return HttpResponse("OK")

    payment_id = get_payment_id_by_toss_order_id(toss_order_id)
    payment = Payment.objects.filter(pk=payment_id).first()
    if not payment:
        error_msg = f"payment_debug: {fn_name} Payment is not exists {payment_id}"
        logger.error(f"{error_msg}")
        return HttpResponseBadRequest(error_msg)

    if payment.charge_status == ChargeStatus.FULLY_CHARGED:
        logger.warning(f"payment_debug: {fn_name} already charged {payment}")
        return HttpResponse("OK")

    if not payment.order:
        error_msg = f"payment_debug: {fn_name} Payment.order is not exists {payment_id}"
        logger.error(f"{error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리를 위한 주문이 존재하지 않습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    last_pending_transaction = payment.get_last_transaction(TransactionKind.ACTION_TO_CONFIRM)
    if last_pending_transaction is None:
        error_msg = f"payment_debug: {fn_name} last_pending_transaction is not exists {payment_id}"
        logger.error(f"{error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리를 위한 가상계좌 결제 정보가 존재하지 않습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    last_pending_transaction_secret = last_pending_transaction.gateway_response.get("secret")
    if secret != last_pending_transaction_secret:
        error_msg = f"payment_debug: {fn_name} last_pending_transaction is not exists {payment_id}"
        logger.error(f"{error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리 시크릿 값과 가상계좌 결제 정보의 시크릿 값이 일치하지 않습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    is_success, failed_msg = process_vbank_noti(
        payment=payment,
        gateway_response=gateway_response,
        is_mobile=None,
    )

    if not is_success:
        error_msg = f"{failed_msg} - {gateway_response}"
        logger.error(f"payment_debug: {error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    # 200 응답되지 않을 경우, 7회까지 노티가 재전송됩니다.
    # 재전송 정책 관련 문서: https://docs.tosspayments.com/guides/webhook#%EC%9B%B9%ED%9B%85-%EC%9E%AC%EC%A0%84%EC%86%A1-%EC%A0%95%EC%B1%85
    return HttpResponse("OK")
