from collections import defaultdict

from ....stats.models import Sales
from ...core.dataloaders import DataLoader


class BundleOtherSalesByBpBundleIdLoader(DataLoader):
    @classmethod
    def exclude_sales(cls, context, order_id: int, sales_id: int):
        context_key = f"bundle_other_sales_by_bp_bundle_id_{order_id}_{sales_id}"
        loader = cls(context, context_key)
        loader.order_id = order_id
        loader.sales_id = sales_id
        return loader

    def batch_load(self, keys):
        order_id = self.order_id
        sales_id = self.sales_id

        sales = (
            Sales.objects.exclude(id=sales_id)
            .filter(order_id=order_id, bp_bundle_id__in=keys)
            .order_by("pk")
        )
        other_sales_dict = defaultdict(list)

        for sale in sales:
            other_sales_dict[sale.bp_bundle_id].append(sale)

        return [other_sales_dict[bp_bundle_id] for bp_bundle_id in keys]
