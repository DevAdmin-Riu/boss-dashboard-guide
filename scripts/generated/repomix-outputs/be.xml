    account_number = graphene.String(required=False, description="가상계좌 환불 시 입금계좌")
    account_holder_name = graphene.String(required=False, description="가상계좌 환불 시 입금자명")


class OrderRefund(BaseMutation):
    order = graphene.Field(Order, description="A refunded order.")
    refund_transaction = graphene.Field(TransactionType, description="A refunded transaction")

    class Arguments:
        id = graphene.ID(required=True, description="ID of the order to refund.")
        input = OrderRefundInput(required=True, description="Fields required to refund an order.")

    class Meta:
        description = "Refund an order."
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_user_permission(
        cls, info, access_site: RequestOriginType, order: OrderModel, is_fbv: bool
    ):
        user = info.context.user
        is_staff = user.is_staff
        if access_site == RequestOriginType.MALL:
            if order.user_id != user.id:
                ValidationError(f"환불할려는 유저와 주문자의 정보가 다릅니다.")
            if is_staff:
                ValidationError(f"is_staff 유저가 보스몰에서 환불을 시도하려 했습니다.")
        else:
            if is_fbv:
                is_vendor_staff = user.is_vendor_staff
                if not is_vendor_staff:
                    ValidationError(
                        f"협력사 계정이 아닌 유저가 대시보드에서 환불을 시도하려 했습니다."
                    )
            else:
                if not is_staff:
                    ValidationError(f"is_staff 아닌 유저가 대시보드에서 환불을 시도하려 했습니다.")

    @classmethod
    def validate_order_type(cls, order: OrderModel):
        if order.type == OrderType.BY_STAFF_FOR_ETC:
            raise ValidationError("기타 배송 주문은 환불할 수 없습니다.")

    @classmethod
    def validate_b2b_order_type(cls, order: OrderModel):
        if order.is_b2b_order:
            raise ValidationError("B2B 주문은 환불할 수 없습니다.")

    @classmethod
    def validate_and_get_is_fbv_vendor_id(cls, info, input, all_cancel_refund: Optional[bool]):
        input_refund_lines = input.get("refund_lines")
        order_line_vendor_id_list = []
        for input_refund_line in input_refund_lines:
            order_line = cls.get_node_or_error(
                info, input_refund_line.get("order_line_id"), only_type=OrderLine
            )
            order_line_vendor_id_list.append(order_line.vendor_id)
        if not all_cancel_refund and len(set(order_line_vendor_id_list)) > 1:
            raise ValidationError("환불 시 여러 협력사 상품이 혼합될 수 없습니다.")

        # 섞여있는 경우는 없다고 가정한다. 전체 위소인 경우 false가 됨 order_line_vendor_id_list 가 아예 비어 있음.
        is_fbv = bool(order_line_vendor_id_list and order_line_vendor_id_list[0] is not None)
        vendor_id = order_line_vendor_id_list[0] if is_fbv else None
        return is_fbv, vendor_id

    @classmethod
    def make_refund_data(
        cls, info, order: OrderModel, payment: "Payment", input, is_fbv=False
    ) -> Tuple[RefundData, List[RefundOrderLineData]]:
        from ....order.utils import make_refund_order_line_data

        amount = input.get("amount")
        cashable_credits = input.get("cashable_credits")
        non_cashable_credits = input.get("non_cashable_credits")
        rcoins = input.get("rcoins")
        input_refund_lines = input.get("refund_lines")

        if (
            (amount is None or amount < 0)
            or (cashable_credits is None or cashable_credits < 0)
            or (non_cashable_credits is None or non_cashable_credits < 0)
            or (rcoins is None or rcoins < 0)
        ):
            raise ValidationError(
                "환불할 금액, 충전금, 포인트값이 전달되지 않았거나 음수가 포함되어 있습니다. 입력된 값을 확인 후 다시 시도해 주세요."
            )

        if input_refund_lines is None or len(input_refund_lines) == 0:
            raise Exception("환불 품목 정보가 누락되었습니다.")

        amount = Decimal(amount)
        cashable_credits = Decimal(cashable_credits)
        non_cashable_credits = Decimal(non_cashable_credits)
        rcoins = Decimal(rcoins)

        refund_lines = []

        for input_refund_line in input_refund_lines:
            order_line = cls.get_node_or_error(
                info, input_refund_line.get("order_line_id"), only_type=OrderLine
            )
            refund_line = RefundOrderLineData(
                order_line=order_line,
                refund_quantity=Decimal(input_refund_line.get("qty")),
                return_delivery_fee=Decimal(input_refund_line.get("return_delivery_fee")),
            )
            refund_lines.append(refund_line)

        refund_data, refund_order_line_data_ary = make_refund_order_line_data(
            refund_amount=amount,
            refund_cashable_credits=cashable_credits,
            refund_non_cashable_credits=non_cashable_credits,
            refund_rcoins=rcoins,
            refund_lines=refund_lines,
            order=order,
            payment=payment,
            is_fbv=is_fbv,
        )

        return refund_data, refund_order_line_data_ary

    @classmethod
    def make_pg_refund_data(
        cls,
        order: OrderModel,
        payment: "Payment",
        refund_data: RefundData,
        pg_refund_bank_info: PgRefundBankInfo,
    ) -> Union[
        "InicisCardRefundData", "InicisVbankRefundData", "TossCardRefundData", "TossVbankRefundData"
    ]:
        # 포인트 only 결제이거나, 후불결제면 아무것도 하지 않고 리턴
        if payment.is_points_only_pay() or payment.is_deferred_pay():
            return None
        refund_amount = int(refund_data.amount)
        # PG 환불이 없는 경우
        if refund_amount == 0:
            return None

        remain_refundable_amount = cls.validate_refund_amount(payment, refund_amount)

        refund_lines = refund_data.refund_lines
        refund_tax_free_total = 0
        refund_taxable_total = 0
        for refund_line in refund_lines:
            order_line = refund_line.order_line
            if not order_line.is_main_pv:
                continue
            qty_for_price = int(refund_line.refund_quantity / order_line.bundle_info_qty)
            if order_line.is_tax_free:
                refund_tax_free_total += order_line.unit_price_gross_amount * qty_for_price
            else:
                refund_taxable_total += order_line.unit_price_gross_amount * qty_for_price

        refund_tax_free_total = my_round(refund_tax_free_total)
        refund_taxable_total = my_round(refund_taxable_total)
        refund_tax_amount = calc_vat_by_price_exclude_vat(refund_taxable_total, False)

        if payment.gateway == PaymentGatewayType.INICIS:
            return cls.make_inicis_refund_data(
                order,
                payment,
                refund_amount,
                remain_refundable_amount,
                refund_tax_amount,
                refund_tax_free_total,
                pg_refund_bank_info,
            )
        elif payment.gateway == PaymentGatewayType.TOSS:
            return cls.make_toss_refund_data(
                order,
                payment,
                refund_amount,
                remain_refundable_amount,
                refund_tax_free_total,
                pg_refund_bank_info,
            )
        return None

    @classmethod
    def make_pg_refund_bank_info(cls, payment: "Payment", input) -> PgRefundBankInfo:
        input_bank_code = input.get("bank_code")
        return PgRefundBankInfo(
            account_number=input.get("account_number"),
            account_holder_name=input.get("account_holder_name"),
            bank_code=convert_to_pg_bank_code(payment.gateway, input_bank_code),
        )

    @classmethod
    def validate_refund_amount(cls, payment: "Payment", refund_amount: int):
        prev_captured_amount = int(payment.captured_amount)
        remain_refund_amount = prev_captured_amount - refund_amount
        if remain_refund_amount < 0:
            error_message = "남은 환불보다 많은 금액을 PG로 환불 요청하려고 하고 있습니다."
            raise ValidationError(error_message)
        return remain_refund_amount

    @classmethod
    def make_toss_refund_data(
        cls,
        order: OrderModel,
        payment: "Payment",
        refund_amount: int,
        remain_refundable_amount: int,
        refund_tax_free_amount: int,
        pg_refund_bank_info: PgRefundBankInfo,
    ) -> Union["TossCardRefundData", "TossVbankRefundData"]:
        if payment.is_vbank_pay():
            # 가상계좌 결제 건은 ACTION_TO_CONFIRM 상태에 결제 승인 gateway_response 가 저장되고, CAPTURE 에는 입금 정보가 저장되어 있음
            last_action_to_confirm_transaction = payment.get_last_transaction(
                TransactionKind.ACTION_TO_CONFIRM
            )
            payment_key = get_toss_payment_key(
                payment.id, last_action_to_confirm_transaction.gateway_response
            )
        elif payment.is_card_pay():
            last_action_to_confirm_transaction = payment.get_last_transaction(
                TransactionKind.CAPTURE
            )
            payment_key = get_toss_payment_key(
                payment.id, last_action_to_confirm_transaction.gateway_response
            )
        else:
            error_message = "토스로 환불할 수 없는 결제 수단입니다."
            raise ValidationError(error_message)
        if payment_key is None:
            error_message = "토스 환불을 위한 결제 정보를 찾을 수 없습니다."
            raise ValidationError(error_message)

        if payment.is_card_pay():
            return TossCardRefundData(
                payment_key=payment_key,
                refund_reason=f"고객 요청에 의한 환불: {order.composed_id_with_prefix}/pid={payment.id}",
                refund_amount=refund_amount,
                remain_refundable_amount=remain_refundable_amount,
                refund_tax_free_amount=refund_tax_free_amount,
            )
        elif payment.is_vbank_pay():
            return TossVbankRefundData(
                payment_key=payment_key,
                refund_reason=f"고객 요청에 의한 환불: {order.composed_id_with_prefix}/pid={payment.id}",
                refund_amount=refund_amount,
                remain_refundable_amount=remain_refundable_amount,
                refund_tax_free_amount=refund_tax_free_amount,
                pg_refund_bank_info=pg_refund_bank_info,
            )
        error_message = "환불할 수 없는 결제 수단입니다."
        raise ValidationError(error_message)

    @classmethod
    def make_inicis_refund_data(
        cls,
        order: OrderModel,
        payment: "Payment",
        refund_amount: int,
        remain_refundable_amount: int,
        refund_tax_amount: int,
        refund_tax_free_amount: int,
        pg_refund_bank_info: PgRefundBankInfo,
    ) -> Union["InicisCardRefundData", "InicisVbankRefundData"]:
        last_captured_transaction = payment.get_last_transaction(TransactionKind.CAPTURE)
        mid = get_inicis_last_captured_mid(payment, last_captured_transaction.gateway_response)
        tid = get_inicis_last_captured_tid(payment, last_captured_transaction.gateway_response)
        if mid is None or tid is None:
            error_message = "이니시스 환불을 위한 결제 정보를 찾을 수 없습니다."
            raise ValidationError(error_message)

        if payment.is_card_pay():
            return InicisCardRefundData(
                mid=mid,
                tid=tid,
                remain_refundable_amount=remain_refundable_amount,
                refund_reason=f"고객 요청에 의한 환불: {order.composed_id_with_prefix}/pid={payment.id}",
                refund_amount=refund_amount,
                refund_tax_amount=refund_tax_amount,
                refund_tax_free_amount=refund_tax_free_amount,
            )
        elif payment.is_vbank_pay():
            return InicisVbankRefundData(
                mid=mid,
                tid=tid,
                remain_refundable_amount=remain_refundable_amount,
                refund_reason=f"고객 요청에 의한 환불: {order.composed_id_with_prefix}/pid={payment.id}",
                refund_amount=refund_amount,
                pg_refund_bank_info=pg_refund_bank_info,
            )
        error_message = "환불할 수 없는 결제 수단입니다."
        raise ValidationError(error_message)

    # 현재 보스몰에서는 전체취소만 가능하며,
    # 교환 반품일 때는 대시보드에서 부분취소 처리 가능하므로
    # 보스몰에서만 현재 들어온 금액이 전체금액과 동일한지 비교
    # 추후에 부분 취소 기능이 만들어지면 해당 함수는 제거 필요
    @classmethod
    def validate_fully_refunded_by_user(cls, payment: "Payment", input):
        amount = input.get("amount")
        cashable_credits = input.get("cashable_credits")
        non_cashable_credits = input.get("non_cashable_credits")
        rcoins = input.get("rcoins")
        if (
            payment.captured_amount != Decimal(amount)
            or payment.captured_cashable_credits != Decimal(cashable_credits)
            or payment.captured_non_cashable_credits != Decimal(non_cashable_credits)
            or payment.captured_rcoins != Decimal(rcoins)
        ):
            if payment.captured_amount != Decimal(amount):
                logger.error(
                    f"validate_fully_refunded_by_user amount missmatch: {payment.captured_amount} != {Decimal(amount)}"
                )
            if payment.captured_cashable_credits != Decimal(cashable_credits):
                logger.error(
                    f"validate_fully_refunded_by_user cashable_credits missmatch: {payment.captured_cashable_credits} != {Decimal(cashable_credits)}"
                )
            if payment.captured_non_cashable_credits != Decimal(non_cashable_credits):
                logger.error(
                    f"validate_fully_refunded_by_user non_cashable_credits missmatch: {payment.captured_non_cashable_credits} != {Decimal(non_cashable_credits)}"
                )
            if payment.captured_rcoins != Decimal(rcoins):
                logger.error(
                    f"validate_fully_refunded_by_user rcoins missmatch: {payment.captured_rcoins} != {Decimal(rcoins)}"
                )
            error_message = "금액이 맞지 않습니다."
            raise ValidationError(error_message)

    @classmethod
    def validate_refund_bank_info(cls, input):
        bank_code = input.get("bank_code")
        account_number = input.get("account_number")
        account_holder_name = input.get("account_holder_name")

        if not bank_code or not account_number or not account_holder_name:
            error_message = "환불 계좌 정보가 누락되었습니다."
            raise ValidationError(error_message)

    @classmethod
    def validate_inicis_payment_merchant_id(cls, payment: "Payment", order: OrderModel):
        if payment.gateway != PaymentGatewayType.INICIS:
            return

        if not (is_card_pay(payment.token) or is_vbank_pay(payment.token)):
            return

        server_mode = settings.SERVER_MODE
        server_mode_enum = ServerModeEnum(server_mode)

        if is_prod_server_mode(server_mode_enum):
            return

        last_captured_transaction = payment.get_last_transaction(TransactionKind.CAPTURE)

        if last_captured_transaction is None:
            raise ValidationError("환불할 수 없는 결제 건입니다.")

        mid = get_inicis_last_captured_mid(payment, last_captured_transaction.gateway_response)

        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(INICIS_GATEWAY_PLUGIN_ID)
        plugin_configs = change_inicis_plugin_configs(plugin_configs, order.brand)
        if plugin_configs is None:
            raise ValidationError("결제 정보 오류로 환불할 수 없는 결제 건입니다.")
        merchant_id = plugin_configs.merchant_id

        if mid != merchant_id:
            raise ValidationError(
                "결제 시점의 mid와 환불 시점의 mid가 일치하지 않아 환불 할 수 없는 결제 건 입니다."
            )

    @classmethod
    def validate_is_already_po_line_received(cls, order: OrderModel):
        po_lines = (
            PurchaseOrderLine.objects.select_related("order_line")
            .filter(order_line__order_id=order.id)
            .order_by("pk")
        )
        if check_is_already_po_line_received(po_lines):
            raise ValidationError("이미 출고 처리된 주문은 취소할 수 없습니다.")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        from ....order.utils import make_create_list_for_refund_order_line

        order: OrderModel = cls.get_node_or_error(
            info,
            data.get("id"),
            only_type=Order,
            qs=models.Order.objects.select_for_update("lines"),
        )
        input = data.get("input")
        is_all_cancel_refund = input.get("all_cancel_refund")
        access_site = input.get("request_origin_type")

        # get_is_fbv_and_vendor_id는 validation도 수행함. 하나의 vendor만 가능함.
        is_fbv, _ = cls.validate_and_get_is_fbv_vendor_id(info, input, is_all_cancel_refund)

        # pg 환불 필요 모드: 전체 취소 이거나 직거래 상품 환불이 아닌 경우
        need_pg_refund_mode = is_all_cancel_refund or not is_fbv

        cls.validate_user_permission(info, access_site, order, is_fbv)
        cls.validate_b2b_order_type(order)
        # 전체 취소가 아닌 경우에만 주문 타입을 체크
        if not is_all_cancel_refund:
            cls.validate_order_type(order)

        payment = order.get_last_payment()
        clean_refund_payment(payment)
        cls.validate_inicis_payment_merchant_id(payment, order)

        if payment.is_vbank_pay() and need_pg_refund_mode:
            cls.validate_refund_bank_info(input)

        # 출고 전 고객에 의한 전체 주문 취소 시 호출됨
        if is_all_cancel_refund == True:
            cls.validate_is_already_po_line_received(order)
            pending_and_by_staff = (
                payment.charge_status == ChargeStatus.PENDING
                and order.type == OrderType.BY_STAFF_FOR_BRAND
            )
            if not order.can_refund_by_user() and not pending_and_by_staff:
                raise ValidationError("주문취소 할 수 없는 주문건 입니다.")
            cls.validate_fully_refunded_by_user(payment, input)
            deallocate_stock_for_order(order)

            # 위탁 주문의 발주서는 모두 취소 처리
            cancel_consignment_po_line_ids = order.lines.filter(
                track_inventory=False, purchase_order_line_id__isnull=False
            ).values_list("purchase_order_line_id", flat=True)
            PurchaseOrderLine.objects.filter(pk__in=cancel_consignment_po_line_ids).update(
                status=PurchaseOrderLineStatus.CANCELED
            )

            # payment가 PENDING상태이고, order의 type이 BY_STAFF_FOR_BRAND이면 바로 리턴하고 뒤의 로직들은 수행하지 않음.
            if pending_and_by_staff:
                events.order_canceled_event(
                    order=order, user=info.context.user, cancel_type=OrderEvents.CANCELED
                )
                order.status = OrderStatus.CANCELED
                order.save(update_fields=["status"])
                return OrderRefund(order=order, refund_transaction=None)

        refund_data, refund_order_line_data_ary = cls.make_refund_data(
            info, order, payment, input, is_fbv
        )

        pg_refund_bank_info = None
        if need_pg_refund_mode:
            pg_refund_bank_info = (
                cls.make_pg_refund_bank_info(payment, input) if payment.is_vbank_pay() else None
            )

        pg_refund_data = cls.make_pg_refund_data(order, payment, refund_data, pg_refund_bank_info)
        staff_user: User = info.context.user

        # gateway.refund  로 환불될 금액 성분이 None 으로 전달되면 전액 환불 처리되므로 주의
        transaction = try_payment_refund_action(
            order,
            staff_user,
            payment,
            gateway.refund,
            payment,
            transaction_kind=TransactionKind.REFUND,
            refund_data=refund_data,
        )

        # Confirm that we changed the status to refund. Some payment can receive
        # asynchronous webhook with update status
        if transaction and transaction.kind == TransactionKind.REFUND:
            order_line_refunded(refund_data=refund_data)

            order_refunded(
                order=order,
                user=staff_user,
                payment=payment,
                refund_data=refund_data,
            )
            (
                diff_tax_free_tax_invoice_total,
                diff_taxable_tax_invoice_total,
            ) = tax_invoice_refunded(
                order=order,
                requester=staff_user,
                refund_data=refund_data,
            )

            pg_refund_response = None
            if need_pg_refund_mode and pg_refund_data:
                pg_refund_response = process_pg_refund(
                    order=order,
                    payment=payment,
                    refund_transaction=transaction,
                    staff_user=staff_user,
                    pg_refund_data=pg_refund_data,
                )

            create_list = make_create_list_for_refund_order_line(
                order=order,
                payment=payment,
                transaction=transaction,
                pg_refund_response=pg_refund_response,
                refund_order_line_data_ary=refund_order_line_data_ary,
            )

            if len(create_list) > 0:
                refund_order_lines = models.RefundOrderLine.objects.bulk_create(create_list)
                # 실제 pg 환불이 일어난 환불 (전체주문 취소 거나 직거래 상품 환불이 아닌 경우) 에만 환불 매출 기록
                if need_pg_refund_mode:
                    create_sales_stat_list = make_create_stats_sales_by_refund_order_lines(
                        refund_order_lines=refund_order_lines,
                        is_migration_mode=False,
                        diff_tax_free_tax_invoice_total=diff_tax_free_tax_invoice_total,
                        diff_taxable_tax_invoice_total=diff_taxable_tax_invoice_total,
                    )
                    if create_sales_stat_list and len(create_sales_stat_list) > 0:
                        Sales.objects.bulk_create(create_sales_stat_list)

            # 직거래 상품은 rcoins reward 와 무괂
            if not is_fbv:
                try:
                    rcoins_reward: RcoinsRewardModel = order.rcoins_reward
                    is_rewarded = rcoins_reward.is_rewarded
                    if is_rewarded:
                        rcoins_reward.update_rcoins(is_settlement_mode=True)
                    else:
                        rcoins_reward.update_rcoins(is_settlement_mode=False)
                except RcoinsRewardModel.DoesNotExist:
                    pass

        return OrderRefund(order=order, refund_transaction=transaction)


