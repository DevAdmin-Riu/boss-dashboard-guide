import logging
from datetime import timedelta

from ..celeryconf import app
from ..core.utils.kst_time import kst_date
from .models import RcoinsReward

logger = logging.getLogger()


@app.task(name="points.tasks.give_point_reward_using_reward_model")
def give_point_reward_using_reward_model():
    # 스케쥴러 작성. order당 하나씩 생성되는 모델의 created가 21일 경과한 데이터들을 대상.
    # 충전금 사용 금액 중에서 '현금전용(포인트지급) > 현금전용(포인트미지급) > 전체(포인트지급) > 전체(포인트미지급)' 기준에 따라 포인트 지급 대상 금액을 구하고,
    # 거기에 적립율을 곱해서 구함. 적립된 경우 적립여부 true로 교환해주고, 적립금도 넣어줌. rcoin event 함수도 수행함

    logger.info("give_point_reward_using_reward_model started.")

    today = kst_date()
    target_before_date = today - timedelta(days=21)

    target_rewards_qs = (
        RcoinsReward.objects.filter(created__date__lte=target_before_date, is_rewarded=False)
        .select_related("order")
        .prefetch_related(
            "reward_lines", "reward_lines__order_line", "order__lines", "order__lines__refund_lines"
        )
    )

    for target_reward in target_rewards_qs:
        target_reward.update_rcoins(is_settlement_mode=True)

    logger.info("give_point_reward_using_reward_model ended.")
