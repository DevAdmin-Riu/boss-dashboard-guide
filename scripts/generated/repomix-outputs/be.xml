import logging
import time
from datetime import date, datetime, timedelta

from django.core.management.base import BaseCommand

from ....core.utils.kst_time import kst_timezone_date
from ....core.utils.log import logging_elapsed_time
from ...tasks import (
    generate_all_variants_last_month_monthly_sales,
    generate_all_variants_last_week_weekly_sales,
    generate_all_variants_yesterday_daily_sales,
)

logger = logging.getLogger(__name__)


def reset_wrong_sales_stats(target_start_date):
    start_time = time.time()

    today = kst_timezone_date()
    target_date: date = target_start_date

    while target_date <= today:
        # Daily task 실행
        try:
            print(f"==== {target_date}: Running daily task...")
            restart_time = time.time()
            # 주의: Celery task 실행 시 JSON 직력화에서 date 는 ISO 8601 형식으로 변환되므로, YYYY-MM-DD 형식으로 다루기 위해 str 캐스팅해서 전달
            generate_all_variants_yesterday_daily_sales.apply_async(
                kwargs={"target_date": str(target_date)}
            )
            logging_elapsed_time(restart_time, f"==== {target_date}: finished daily task...")
        except Exception as e:
            logger.error(f"==== Daily task Error occurred on {target_date}: {e}")

        # Weekly task 실행 (월요일만 실행)
        try:
            if target_date.weekday() == 0:  # Monday = 0
                print(f">>>> {target_date}: Running weekly task...")
                restart_time = time.time()
                # 주의: Celery task 실행 시 JSON 직력화에서 date 는 ISO 8601 형식으로 변환되므로, YYYY-MM-DD 형식으로 다루기 위해 str 캐스팅해서 전달
                generate_all_variants_last_week_weekly_sales.apply_async(
                    kwargs={"target_date": str(target_date)}
                )
                logging_elapsed_time(restart_time, f">>>> {target_date}: finished weekly task...")
        except Exception as e:
            logger.error(f">>>> Weekly task Error occurred on {target_date}: {e}")

        # Monthly task 실행 (매월 1일만 실행)
        try:
            if target_date.day == 1:
                print(f"++++ {target_date}: Running monthly task...")
                restart_time = time.time()
                # 주의: Celery task 실행 시 JSON 직력화에서 date 는 ISO 8601 형식으로 변환되므로, YYYY-MM-DD 형식으로 다루기 위해 str 캐스팅해서 전달
                generate_all_variants_last_month_monthly_sales.apply_async(
                    kwargs={"target_date": str(target_date)}
                )
                logging_elapsed_time(restart_time, f"++++ {target_date}: finished monthly task...")
        except Exception as e:
            logger.error(f"++++ Monthly task Error occurred on {target_date}: {e}")

        target_date += timedelta(days=1)

    logging_elapsed_time(start_time, f"finish reset_wrong_sales_stats")


class Command(BaseCommand):
    help = "판매량 집계 오류 데이터 변경을 위한 기존 데이터 마이그레이션"

    def add_arguments(self, parser):
        parser.add_argument("start_date", nargs="?", help="The start_date in YYYY-MM-DD format")

    def handle(self, *args, **options):
        start_date_str = options["start_date"]

        if not start_date_str:
            self.stdout.write(
                self.style.ERROR("Usage: python manage.py reset_wrong_sales_stats YYYY-MM-DD")
            )
            return

        try:
            target_start_date = datetime.strptime(start_date_str, "%Y-%m-%d").astimezone().date()
        except Exception:
            self.stdout.write(
                self.style.ERROR("Usage: python manage.py reset_wrong_sales_stats YYYY-MM-DD.")
            )
            return

        # Your logic with the parsed date goes here
        self.stdout.write(
            self.style.SUCCESS(
                f"=== 판매량 집계 오류 데이터 변경 작업 진행 중: start date={target_start_date} ~"
            )
        )

        reset_wrong_sales_stats(target_start_date)
