from django.core.exceptions import ValidationError

from ...account import AddressDirectShippingStatus
from ...account.error_codes import AccountErrorCode
from ...account.forms import get_address_form
from ...account.models import Address
from ...account.validators import validate_possible_number


class I18nMixin:
    """A mixin providing methods necessary to fulfill the internationalization process.

    It is to be used with BaseMutation or ModelMutation.
    """

    @classmethod
    def construct_instance(cls, info, instance, cleaned_data):
        pass

    @classmethod
    def clean_instance(cls, info, instance):
        pass

    @classmethod
    def validate_address_form(cls, address_data: dict, instance=None):
        phone = address_data.get("phone", None)
        if phone:
            try:
                validate_possible_number(phone, address_data.get("country"))
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {"phone": ValidationError(f"'{phone}' {phoneValidErrorMsg}", code=exc.code)}
                ) from exc

        address_form, _ = get_address_form(
            address_data, address_data.get("country"), instance=instance
        )
        if not address_form.is_valid():
            raise ValidationError(address_form.errors.as_data())
        return address_form

    @classmethod
    def validate_warehouse_address(cls, address_data: dict, instance=None, info=None):
        required_valid_error_msg = "필드에 입력된 내용이 없습니다."
        if address_data.get("country") is None:
            raise ValidationError(
                {
                    "country": ValidationError(
                        f"'country' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )
        first_name = address_data.get("first_name")
        if first_name is None or not first_name.strip():
            raise ValidationError(
                {
                    "first_name": ValidationError(
                        f"'first_name' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )
        phone = address_data.get("phone")
        if phone is None or not phone.strip():
            raise ValidationError(
                {
                    "phone": ValidationError(
                        f"'phone' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )

        address_form = cls.validate_address_form(address_data, instance)
        if not instance:
            instance = Address()

        cls.construct_instance(info, instance, address_form.cleaned_data)
        cls.clean_instance(info, instance)
        return instance

    @classmethod
    def validate_address(cls, address_data: dict, instance=None, info=None):
        required_valid_error_msg = "필드에 입력된 내용이 없습니다."
        if address_data.get("country") is None:
            raise ValidationError(
                {
                    "country": ValidationError(
                        f"'country' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )
        first_name = address_data.get("first_name")
        if first_name is None or not first_name.strip():
            raise ValidationError(
                {
                    "first_name": ValidationError(
                        f"'first_name' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )
        phone = address_data.get("phone")
        if phone is None or not phone.strip():
            raise ValidationError(
                {
                    "phone": ValidationError(
                        f"'phone' {required_valid_error_msg}",
                        code=AccountErrorCode.REQUIRED,
                    )
                }
            )

        if instance:
            if address_data.get("is_direct_shipping") is None:
                address_data["is_direct_shipping"] = instance.is_direct_shipping
            if address_data.get("direct_shipping_days") is None:
                address_data["direct_shipping_days"] = instance.direct_shipping_days
            if address_data.get("direct_shipping_code") is None:
                address_data["direct_shipping_code"] = instance.direct_shipping_code
            if address_data.get("direct_shipping_detail") is None:
                address_data["direct_shipping_detail"] = instance.direct_shipping_detail
            if address_data.get("direct_shipping_status") is None:
                address_data["direct_shipping_status"] = instance.direct_shipping_status
            if address_data.get("direct_shipping_reject_reason") is None:
                address_data["direct_shipping_reject_reason"] = (
                    instance.direct_shipping_reject_reason
                )

        status = address_data.get("direct_shipping_status")
        if status is None:
            address_data["direct_shipping_status"] = AddressDirectShippingStatus.NONE

        address_form = cls.validate_address_form(address_data, instance)
        if not instance:
            instance = Address()

        cls.construct_instance(info, instance, address_form.cleaned_data)
        cls.clean_instance(info, instance)
        return instance
