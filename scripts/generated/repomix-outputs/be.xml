class FulfillmentSortField(graphene.Enum):
    NUMBER = ["order_id", "pk"]
    STATUS = ["status", "pk"]
    CREATION_DATE = ["created", "pk"]
    ORDER_CREATION_DATE = ["order__created", "pk"]
    DELIVERY_START_DATE = ["delivery_start_date", "pk"]
    REPRINTING = ["stock_rack", "order_line_sku", "pk"]

    @property
    def description(self):
        if self.name in FulfillmentSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort fulfillments by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_order_creation_date(qs: QuerySet) -> QuerySet:
        return qs.select_related("order")

    @staticmethod
    def qs_with_reprinting(qs: QuerySet) -> QuerySet:
        """
        items.sort(key=lambda item: item.get("orderItems")[0].get("itemCode"))
        위에는 송장 재출력 시 sorting 하는 코드입니다.
        해당 qs_with_reprinting 함수는 위의 코드를 구현한 것 입니다.
        """

        # 먼저, 각 fulfillment에 대한 최소 line ID를 구합니다.
        min_line_id = (
            FulfillmentLine.objects.filter(fulfillment=OuterRef(OuterRef("pk")))
            .order_by("id")
            .values("id")[:1]
        )

        # Subquery를 사용하여 해당 ID의 Line 객체의 특정 필드를 가져옵니다.
        qs = (
            qs.annotate(
                first_fulfillment_line_id=Subquery(
                    FulfillmentLine.objects.filter(id=Subquery(min_line_id)).values("id")[:1],
                )
            )
            .annotate(
                stock_detail_line_id=Subquery(
                    StockDetailLine.objects.filter(
                        fulfillment_line=OuterRef("first_fulfillment_line_id")
                    ).values("id")[:1],
                ),
                order_line_sku=Subquery(
                    FulfillmentLine.objects.filter(id=OuterRef("first_fulfillment_line_id")).values(
                        "order_line__product_sku"
                    )[:1],
                ),
            )
            .annotate(
                stock_rack=Subquery(
                    StockDetailLine.objects.filter(id=OuterRef("stock_detail_line_id")).values(
                        "rack_location__name"
                    )[:1],
                ),
            )
        )
        return qs


class FulfillmentSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = FulfillmentSortField
        type_name = "fulfillments"
