def add_to_rack_stock_detail(
    location: RackLocation,
    stock_detail: StockDetail,
    quantity: Decimal,
    product_variant: ProductVariant,
    source_rsd: RackStockDetail = None,
):
    rack_stock_detail = (
        RackStockDetail.objects.filter(location=location, stock_detail=stock_detail).first()
        if stock_detail
        else None
    )
    if rack_stock_detail:
        rack_stock_detail.increase_remain_stock(quantity, source_rsd)
    else:
        rack_stock_detail = RackStockDetail.objects.filter(
            location=location, product_variant=product_variant, stock_detail__isnull=True
        ).first()
        if rack_stock_detail:
            rack_stock_detail.increase_remain_stock_with_stock_detail(
                quantity, stock_detail, source_rsd
            )
        else:
            RackStockDetail.objects.create(
                location=location,
                product_variant=product_variant,
                stock_detail=stock_detail,
                remain_quantity=quantity,
                memo=source_rsd.memo if source_rsd else "",
                memo_updated_at=(source_rsd.memo_updated_at if source_rsd else None),
                memo_updated_writer=(source_rsd.memo_updated_writer if source_rsd else None),
            )
