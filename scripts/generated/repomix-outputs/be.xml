            taxed_variant_price = plugin_manager.apply_taxes_to_product(variant_price)
            return VariantAvailability(
                on_sale=False,
                price=taxed_variant_price,
            )

        plugin_manager_promise = PluginManagerLoader(info.context).load(1)

        return (
            ProductByIdAllLoader(info.context)
            .load(root.product_id)
            .then(
                lambda product: (
                    Promise.all(
                        [
                            get_user_product_variant_for_loader(
                                variant=root,
                                product=product,
                                context=info.context,
                                raise_exception=False,
                            ),
                            plugin_manager_promise,
                        ]
                    ).then(get_variant_availability_price)
                    if product
                    else None
                )
            )
        )

