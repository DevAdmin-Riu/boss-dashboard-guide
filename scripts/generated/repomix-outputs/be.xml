import graphene
from django.contrib.auth import password_validation
from django.core.exceptions import ValidationError

from saleor.account.models import Brand as BrandModel
from saleor.account.models import User as UserModel
from saleor.graphql.brand_store.enums import HqStaffRoleEnum
from saleor.graphql.core.mutations import ModelMutation
from saleor.graphql.core.types.common import AccountError

from ....account.validators import validate_possible_number
from ....core.permissions import AccountPermissions, get_permissions


class HqStaffInput(graphene.InputObjectType):
    first_name = graphene.String(description="The first name of the user.")
    email = graphene.String(description="The email address of the user.")
    login_id = graphene.String(required=True, description="The unique login id of the user.")


class HqStaffCreateInput(HqStaffInput):
    brand = graphene.ID(
        required=True, description="ID of the franchise brand that customer belongs to."
    )
    password = graphene.String(required=False, description="The password of the user.")
    aligo_phone = graphene.String(description="휴대폰 번호", required=True)
    hq_staff_role = HqStaffRoleEnum(required=True, description="본부 직원 권한")


class HqStaffUpdateInput(HqStaffInput):
    login_id = graphene.String(description="The unique login id of the user.")
    aligo_phone = graphene.String(description="휴대폰 번호")  # 필수 아님.
    hq_staff_role = HqStaffRoleEnum(description="본부 직원 권한")


class HqStaffCreate(ModelMutation):
    brand = graphene.Field(
        "saleor.graphql.account.types.Brand",
        description="가맹본부",
    )

    class Arguments:
        input = HqStaffCreateInput(required=True, description="사용자(가맹본부) 정보")

    class Meta:
        description = "Register a new user."
        exclude = ["password"]
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_staff_permissions(cls, info, instance, data):
        requestor = info.context.user
        brand_global_id = data.get("brand")
        hq_staff_role = data.get("hq_staff_role")
        old_hq_staff_role = instance.hq_staff_role if instance else None
        brand_id_number = None

        if brand_global_id:
            _type, brand_id = graphene.Node.from_global_id(brand_global_id)
            brand_id_number = int(brand_id)
        elif instance.brand_id:
            brand_id_number = instance.brand_id

        if requestor.is_staff:
            pass
            # 바꾸려는 유저의 brand_id가 동일하면서 requesetor가 admin인 경우.
        elif brand_id_number == requestor.brand_id and requestor.is_hq_staff_admin:
            pass
        elif requestor.id == instance.id:
            # 본부직원 본인이 자신의 권한을 바꾸는 경우는 불가...
            if hq_staff_role and hq_staff_role != old_hq_staff_role:
                raise ValidationError("본부직원이 자신의 권한을 변경할 수 없습니다.")
            pass
        else:
            raise ValidationError("해당 기능의 권한이 없습니다.")

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):

        cls.check_staff_permissions(info, instance, data)

        password = data.get("password")
        if password:
            try:
                password_validation.validate_password(password, instance)
            except ValidationError as error:
                raise ValidationError({"password": error})

        aligo_phone = data.get("aligo_phone")
        if aligo_phone:
            try:
                data["aligo_phone"] = validate_possible_number(aligo_phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {
                        "phone": ValidationError(
                            f"'{aligo_phone}' {phoneValidErrorMsg}", code=exc.code
                        )
                    }
                ) from exc

        return super().clean_input(info, instance, data, input_cls=None)

    @classmethod
    def construct_instance(cls, info, instance: UserModel, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        if cls == HqStaffCreate:
            instance.is_hq_staff = True
            instance.switched_brand = instance.brand
        return instance

    @classmethod
    def save(cls, info, user, cleaned_input):
        if cls == HqStaffCreate:
            password = cleaned_input.get("password") or user.brand.code
            user.set_password(password)
        user.save()
        if cls == HqStaffCreate:
            permissions = get_permissions([AccountPermissions.MANAGE_HQ_STAT.value])
            for permission in permissions:
                user.user_permissions.add(permission)

    @classmethod
    def success_response(cls, instance):
        response = super().success_response(instance)
        response.brand = instance.brand
        return response


class HqStaffUpdate(HqStaffCreate):
    class Arguments:
        id = graphene.ID(required=True, description="ID of the user.")
        input = HqStaffUpdateInput(required=True, description="사용자(가맹본부) 정보")

    class Meta:
        description = "Update a hq staff user."
        exclude = ["password"]
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"


class HqStaffBrandUpdateInput(graphene.InputObjectType):
    brand = graphene.ID(description="변경할 브랜드", required=True)


class HqStaffBrandUpdate(ModelMutation):
    class Arguments:
        input = HqStaffBrandUpdateInput(description="가맹본부 직원 브랜드 변경", required=True)

    class Meta:
        description = "브랜드 변경"
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def validate_permissions(cls, user: "UserModel"):
        if user.is_anonymous:
            raise ValidationError("로그인이 필요합니다.")
        if user.is_hq_staff is False:
            raise ValidationError("가맹본부 직원만 브랜드 변경 가능합니다.")

    @classmethod
    def validate_brand_group(cls, user: "UserModel", new_brand_id: int):
        """
        유저가 속한 브랜드 그룹과 변경하려는 브랜드가 동일한 그룹에 속해 있는지 확인합니다.
        """
        # 유저가 속한 브랜드와 브랜드 그룹 확인
        old_brand = user.brand
        if not old_brand or not old_brand.brand_group:
            raise ValidationError("현재 브랜드가 속한 브랜드 그룹이 존재하지 않습니다.")

        # 변경하려는 브랜드 확인
        try:
            new_brand = BrandModel.objects.get(pk=new_brand_id)
        except BrandModel.DoesNotExist:
            raise ValidationError("변경하려는 브랜드가 존재하지 않습니다.")

        # 변경하려는 브랜드가 동일한 브랜드 그룹에 속해 있는지 확인
        if new_brand.brand_group != old_brand.brand_group:
            raise ValidationError(
                "변경하려는 브랜드는 현재 브랜드와 동일한 그룹에 속하지 않습니다."
            )

    @classmethod
    def perform_mutation(cls, root, info, **data):
        user = info.context.user
        cls.validate_permissions(user)

        input_data = data.get("input")
        brand_global_id = input_data.get("brand")
        _type, brand_id = graphene.Node.from_global_id(brand_global_id)

        # 브랜드 그룹 검증
        cls.validate_brand_group(user, brand_id)

        user.brand_id = brand_id
        user.switched_brand_id = brand_id
        user.save(update_fields=["brand_id", "switched_brand_id"])

        return cls.success_response(user)
