logger = logging.getLogger()


def _charged_order_qs_for_sales_stats():
    charge_status_values = (
        ChargeStatus.PARTIALLY_CHARGED,
        ChargeStatus.FULLY_CHARGED,
        ChargeStatus.PARTIALLY_REFUNDED,
    )

    order_status_filter = ~Q(status=OrderStatus.CANCELED)
    charge_status_filter = Q(
        payments__is_active=True,
        payments__charge_status__in=charge_status_values,
    )
    fully_refunded_filter = Q(
        payments__charge_status=ChargeStatus.FULLY_REFUNDED,
    )

    qs = Order.objects.filter(order_status_filter & (charge_status_filter | fully_refunded_filter))
    return qs


def _charged_order_line_qs_for_sales_stats():
    charge_status_values = (
        ChargeStatus.PARTIALLY_CHARGED,
        ChargeStatus.FULLY_CHARGED,
        ChargeStatus.PARTIALLY_REFUNDED,
    )

    order_status_filter = ~Q(order__status=OrderStatus.CANCELED)
    order_line_b2b_status_filter = ~Q(b2b_status=OrderLineB2bStatus.CANCELED)
    charge_status_filter = Q(
        order__payments__is_active=True,
        order__payments__charge_status__in=charge_status_values,
    )
    fully_refunded_filter = Q(
        order__payments__charge_status=ChargeStatus.FULLY_REFUNDED,
    )
    captured_at_exists_filter = Q(order__captured_at__isnull=False)

    qs = OrderLine.objects.filter(
        order_status_filter
        & order_line_b2b_status_filter
        & (charge_status_filter | fully_refunded_filter)
        & captured_at_exists_filter
    )
    return qs


def filter_for_refunded_transactions(brand_id):
    brand_filter = Q(payment__order__brand_id=brand_id)
    kind_filter = Q(kind__in=[TransactionKind.REFUND])
    order_status_filter = ~Q(payment__order__status=OrderStatus.CANCELED)

    qs = Transaction.objects.filter(brand_filter & kind_filter & order_status_filter)
    return qs


def make_target_range_for_manual_brand_stats_gathering():
    now = kst_timezone_now()
    hour = now.hour
    if hour == 2 or hour == 3:
        # 오전 3시 스케쥴러에 의한 자동 집계와 충돌 방지 정책 1: 수동 집계 불가 시간 체크
        logger.info(
            f"자동 집계와 데이터 충돌 방지 정책: 수동 집계 불가 시간입니다. (AM 02:00:00 ~ AM 03:59:59)"
        )
        return None

    # 오전 3시 스케쥴러에 의한 자동 집계와 충돌 방지 정책 2:
    # 수동 집계를 오전 0시 ~ 오전 2시 이전에 돌리면 **today - 2** 데이터 까지만 집계, 오전 3시 ~ 자정까지에 요청하면 **today - 1** 까지 집계,
    time_delta = 2 if hour <= 2 else 1

    today = kst_timezone_date()
    lte_day = today - timedelta(days=time_delta)
    target_date_range = {"lte": lte_day}
    return target_date_range


def make_target_range_for_yesterday_stats():
    today = kst_timezone_date()
    yesterday = today - timedelta(days=1)
    # 스케쥴러에 의한 매출 집계는 전날 데이터만 집계함
    target_date_range = {"gte": yesterday, "lte": yesterday}
    return target_date_range


