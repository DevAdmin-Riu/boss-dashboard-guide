import django_filters
import graphene
from graphene_django.filter.filterset import GlobalIDMultipleChoiceFilter

from saleor.pre_founder.models import PreFounder as PreFounderModel

from ..core.enums import GenderTypeEnum
from ..core.filters import EnumFilter, ListObjectTypeFilter, ObjectTypeFilter
from ..core.types import FilterInputObjectType
from ..core.types.common import DateRangeInput, PriceRangeInput
from ..utils.filters import filter_by_query_param, filter_range_field
from .enums import (
    PreFounderConsultationResultEnum,
    PreFounderEvalStatusEnum,
    PreFounderLeadSourceEnum,
)


class PreFounderFilter(django_filters.FilterSet):
    def filter_pre_founder_search(qs, _, value):
        search_fields = ["name", "phone"]
        return filter_by_query_param(qs, value, search_fields)

    def filter_first_consultation_user_search(qs, _, value):
        search_fields = [
            "first_consultation__create_user__first_name, first_consultation__create_user__login_id"
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_last_consultation_user_search(qs, _, value):
        search_fields = [
            "last_consultation__create_user__first_name, last_consultation__create_user__login_id"
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_gender(qs, _, value):
        if value:
            qs = qs.filter(gender=value)
        return qs

    def filter_lead_source(qs, _, value):
        if value:
            qs = qs.filter(lead_source__in=value)
        return qs

    def filter_eval_status(qs, _, value):
        if value:
            qs = qs.filter(eval_status__in=value)
        return qs

    def filter_last_consultation_result(qs, _, value):
        if value:
            qs = qs.filter(last_consultation__result__in=value)
        return qs

    def filter_desired_region(qs, _, value):
        if value:
            region_pks = [graphene.Node.from_global_id(region_gid)[1] for region_gid in value]
            qs = qs.filter(desired_region_id__in=region_pks)
        return qs

    def filter_eval_total_score(qs, _, value):
        return filter_range_field(qs, "eval_total_score", value)

    def filter_birth_date_range(qs, _, value):
        return filter_range_field(qs, "birth_date", value)

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    def filter_first_consultation_date_range(qs, _, value):
        return filter_range_field(qs, "first_consultation__consultation_date__date", value)

    def filter_last_consultation_date_range(qs, _, value):
        return filter_range_field(qs, "last_consultation__consultation_date__date", value)

    pre_founder_search = django_filters.CharFilter(method=filter_pre_founder_search)
    first_consultation_user_search = django_filters.CharFilter(
        method=filter_first_consultation_user_search
    )
    last_consultation_user_search = django_filters.CharFilter(
        method=filter_last_consultation_user_search
    )
    gender = EnumFilter(input_class=GenderTypeEnum, method=filter_gender)
    lead_source = ListObjectTypeFilter(
        input_class=PreFounderLeadSourceEnum, method=filter_lead_source
    )
    eval_status = ListObjectTypeFilter(
        input_class=PreFounderEvalStatusEnum, method=filter_eval_status
    )
    last_consultation_result = ListObjectTypeFilter(
        input_class=PreFounderConsultationResultEnum, method=filter_last_consultation_result
    )
    desired_region = GlobalIDMultipleChoiceFilter(method=filter_desired_region)
    eval_total_score = ObjectTypeFilter(input_class=PriceRangeInput, method=filter_eval_total_score)
    birth_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_birth_date_range)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)
    first_consultation_date = ObjectTypeFilter(
        input_class=DateRangeInput, method=filter_first_consultation_date_range
    )
    last_consultation_date = ObjectTypeFilter(
        input_class=DateRangeInput, method=filter_last_consultation_date_range
    )

    class Meta:
        model = PreFounderModel
        fields = []


class PreFounderFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = PreFounderFilter
