def get_stock_control_filtered_pv_qs():
    # 재고 운영 아우터 제품
    outer_track_inventory_filter = Q(outer__isnull=True) & Q(track_inventory=True)
    # 아우터는 재고 미운영 이고 이너 운영하는 이너 제품
    inner_can_sale_by_inner_filter = (
        Q(outer__isnull=False) & Q(outer__track_inventory=False) & Q(can_sale_by_inner=True)
    )
    pv_qs = get_stock_control_prefetched_pv_qs()
    pv_qs = (
        pv_qs.filter(outer_track_inventory_filter | inner_can_sale_by_inner_filter)
        .exclude(product__is_fulfilled_by_vendor=True)
        .filter(sales_status__in=[SalesStatus.ON_SALE])
        .filter(po_lead_time__isnull=False)
    )
    return pv_qs


def get_stock_status_by_daily_filtered_pv_qs():
    # 재고 운영 아우터 제품
    outer_track_inventory_filter = Q(outer__isnull=True) & Q(track_inventory=True)
    # 아우터는 재고 미운영 이고 이너 운영하는 이너 제품
    inner_can_sale_by_inner_filter = (
        Q(outer__isnull=False) & Q(outer__track_inventory=False) & Q(can_sale_by_inner=True)
    )
    pv_qs = get_stock_control_prefetched_pv_qs()
    pv_qs = (
        pv_qs.filter(outer_track_inventory_filter | inner_can_sale_by_inner_filter)
        .exclude(product__is_fulfilled_by_vendor=True)
        .filter(sales_status__in=[SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED])
    )
    return pv_qs


@app.task(name="stats.tasks.reset_variants_is_safety_status_and_send_alarm")
def reset_variants_is_safety_status_and_send_alarm(send_alarm_mode: Optional[bool] = True):
    pv_qs = get_stock_control_filtered_pv_qs()
    pv_qs = (
        pv_qs.filter(priority_level__isnull=False)
        .filter(last_30_days_avg_sales_daily_qty__isnull=False)
        .filter(last_3_months_avg_sales_daily_qty__isnull=False)
    )

    update_list = []
    alarm_list = []
    orderable_qty_list = []
    orderable_qty_incl_short_term_list = []
    orderable_qty_incl_long_term_list = []
    for variant in pv_qs:
        try:
            update_flag, alarm_flag, orderable_qty_incl_short_term = reset_variant_is_safety_status(
                variant
            )
            if update_flag:
                update_list.append(variant)
            if send_alarm_mode and alarm_flag:
                alarm_list.append(variant)
                orderable_qty = get_orderable_qty_by_prefetched_data(variant, until_short_term=None)
                orderable_qty_list.append(orderable_qty)
                orderable_qty_incl_short_term_list.append(orderable_qty_incl_short_term)
                orderable_qty_incl_long_term = get_orderable_qty_by_prefetched_data(
                    variant, until_short_term=False
                )
