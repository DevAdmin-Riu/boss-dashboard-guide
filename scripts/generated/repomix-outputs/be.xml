def make_target_range_for_manual_variant_monthly_sales():
    now = kst_timezone_now()
    day = now.day
    hour = now.hour
    if day == 1 and (hour <= 1):
        # 매월 1일 오전 1시 스케쥴러에 의한 자동 집계와 충돌 방지 정책 1: 수동 집계 불가 시간 체크
        logger.info(
            f"자동 집계와 데이터 충돌 방지 정책: 수동 집계 불가 시간입니다.  매월 1일 (AM 00:00:00 ~ AM 01:59:59)."
        )
        return None

    today = kst_timezone_date()
    lt_day = today.replace(day=1)
    target_date_range = {"lt": lt_day}
    return target_date_range


@app.task
def generate_all_variant_monthly_sales():
    target_date_range = make_target_range_for_manual_variant_monthly_sales()
    if target_date_range is None:
        logger.error(f"target_date_range is None")
        return
    generate_variant_sales(
        trunc_func=TruncMonth,
        target_date_range=target_date_range,
    )


def calc_last_n_months_avg_sales_monthly_qty(
    last_n_month_sales: Iterable[ProductVariantMonthlySales],
    n_month_ago: int,
) -> float:
    if not last_n_month_sales:
        return Decimal(0)

    sum_of_last_n_month_sales_qty = sum(sales.quantity for sales in last_n_month_sales)
    return sum_of_last_n_month_sales_qty / n_month_ago


def set_variant_last_n_month_avg_sales_monthly_qty(
    target_date: date, n_month_ago, loader_func, update_field, variant: ProductVariant = None
):
    if n_month_ago != 2 and n_month_ago != 3:
        logger.error(f"n_month_ago is invalid: {n_month_ago}")
        return

    this_month_first_day = target_date.replace(day=1)
    n_months_ago_first_day = this_month_first_day - relativedelta(months=n_month_ago)

    target_variants_qs = ProductVariant.objects.filter(outer__isnull=True).filter(
        first_available_for_purchase__lte=n_months_ago_first_day
    )
    if variant:
        target_variants_qs = target_variants_qs.filter(pk=variant.pk)

    target_variant_ids = target_variants_qs.values_list("id", flat=True)
    sales_map = loader_func(target_variant_ids)
    update_list = []
    for variant in target_variants_qs:
        last_n_month_sales = sales_map.get(variant.id, [])
        last_n_months_avg_sales_monthly_qty = my_round(
            calc_last_n_months_avg_sales_monthly_qty(last_n_month_sales, n_month_ago),
            MONTHLY_STAT_QTY_DECIMAL_PLACES,
        )
        if n_month_ago == 3:
            variant.last_3_months_avg_sales_monthly_qty = last_n_months_avg_sales_monthly_qty
        elif n_month_ago == 2:
            variant.last_2_months_avg_sales_monthly_qty = last_n_months_avg_sales_monthly_qty
        update_list.append(variant)

    update_fields = [update_field]
    ProductVariant.objects.bulk_update(update_list, update_fields)

    if not variant:
        # 14일 ~ n_months_ago_first_day 미 경과 제품인 경우 last_30_days_avg_sales_daily_qty x 30으로 월 평균 계산
        fourteen_days_ago = target_date - timedelta(days=14)
        recent_created_variants_qs = ProductVariant.objects.filter(outer__isnull=True).filter(
            first_available_for_purchase__gt=n_months_ago_first_day,
            first_available_for_purchase__lte=fourteen_days_ago,
        )
        if n_month_ago == 3:
            recent_created_variants_qs.update(
                last_3_months_avg_sales_monthly_qty=Func(
                    F("last_30_days_avg_sales_daily_qty") * 30,
                    MONTHLY_STAT_QTY_DECIMAL_PLACES,
                    function="ROUND",
                    output_field=FloatField(),
                )
            )
        elif n_month_ago == 2:
            recent_created_variants_qs.update(
                last_2_months_avg_sales_monthly_qty=Func(
                    F("last_30_days_avg_sales_daily_qty") * 30,
                    MONTHLY_STAT_QTY_DECIMAL_PLACES,
                    function="ROUND",
                    output_field=FloatField(),
                )
            )


def make_target_range_for_last_month_monthly_sales(target_date: date):
    this_month_first_day = target_date.replace(day=1)
    prev_month_first_day = this_month_first_day - relativedelta(months=1)
    target_date_range = {"gte": prev_month_first_day, "lt": this_month_first_day}
    return target_date_range


def make_target_range_for_this_month_monthly_sales(target_date: date):
    this_month_first_day = target_date.replace(day=1)
    next_month_first_day = this_month_first_day + relativedelta(months=1)
    target_date_range = {"gte": this_month_first_day, "lt": next_month_first_day}
    return target_date_range


@app.task(name="stats.tasks.generate_all_variants_last_month_monthly_sales")
@transaction.atomic()
def generate_all_variants_last_month_monthly_sales(target_date: Optional[str] = None):
    from_scheduler = target_date is None
    today = kst_timezone_date()
    if from_scheduler:
        target_date = today
    else:
        # Celery의 apply_async를 통해 전달된 인자는 JSON 직렬화를 거치기 때문에, target_date를 문자열에서 date 객체로 다시 변환
        target_date = datetime.strptime(target_date, "%Y-%m-%d").astimezone().date()

    target_date_range = make_target_range_for_last_month_monthly_sales(target_date)
    logger.info(f"{target_date}: generate_all_variants_last_month_monthly_sales")
    generate_variant_sales(
        trunc_func=TruncMonth,
        target_date_range=target_date_range,
    )
    if today.month == target_date.month:
        logger.info(f">>>> {target_date}: set_variant_last_n_month_avg_sales_monthly_qty")
        set_variant_last_n_month_avg_sales_monthly_qty(
            target_date=target_date,
            n_month_ago=3,
            loader_func=Last3MonthSalesByProductVariantIdLoader.load_3_month_sales,
            update_field="last_3_months_avg_sales_monthly_qty",
        )
        set_variant_last_n_month_avg_sales_monthly_qty(
            target_date=target_date,
            n_month_ago=2,
            loader_func=Last2MonthSalesByProductVariantIdLoader.load_2_month_sales,
            update_field="last_2_months_avg_sales_monthly_qty",
        )


