def make_aligo_replace_dict_related_to_order_or_notice(
    talk_event_code: AligoEvents,
    parameters: dict,
    order: Optional["Order"] = None,
):
    replace_dict = {}
    user_name = parameters.get("user_name")
    vendor_name = parameters.get("vendor_name")
    order_id = parameters.get("order_id")
    if user_name:
        replace_dict["#{회원명}"] = f"{user_name}"
    if vendor_name:
        replace_dict["#{협력사명}"] = f"{vendor_name}"
    if order_id:
        replace_dict["#{주문번호}"] = f"{order_id}"
    reason = parameters.get("reason")
    if reason:
        if talk_event_code in [AligoEvents.REJECT_ADDRESS]:
            replace_dict["#{반려사유}"] = f"{reason}"

    if order:
        replace_dict["#{주문번호}"] = f"{order.id}"
        if talk_event_code in [AligoEvents.CANCEL_ORDER]:
            kst_create_date = to_kst_date_from_utc_datetime(order.created)
            replace_dict["#{주문일}"] = kst_create_date
        else:
            lines = order.lines.all()
            length = len(lines)
            first_product_name = lines[0].product_name if length > 0 else "상품없음"
            product_name = (
                f"{first_product_name} 외 {length - 1}건" if length > 1 else f"{first_product_name}"
            )
            replace_dict["#{상품명}"] = product_name

        if talk_event_code in [AligoEvents.ORDER_BY_CARD, AligoEvents.ORDER_BY_VBANK]:
            locale_total = to_locale_number(order.total_gross_amount)
            replace_dict["#{최종 결제 금액}"] = f"{locale_total}원"

        if talk_event_code in [AligoEvents.ORDER_BY_VBANK]:
            vact_name = parameters.get("vact_name")
            vact_bank_name = parameters.get("vact_bank_name")
            vact_num = parameters.get("vact_num")
            vact_date = parameters.get("vact_date")
            replace_dict["#{예금주}"] = vact_name if vact_name else "-"
            replace_dict["#{입금은행}"] = vact_bank_name if vact_bank_name else "-"
            replace_dict["#{계좌번호}"] = vact_num if vact_num else "-"
            replace_dict["#{입금기한}"] = vact_date if vact_date else "-"

        if talk_event_code in [
            AligoEvents.FULFILLMENT_BY_CJ,
            AligoEvents.FULFILLMENT_BY_ETC,
        ]:
            replace_dict["#{택배사}"] = parameters.get("courier_name")
            replace_dict["#{송장번호}"] = parameters.get("tracking_number")
            uniconde_tracking_number_tag = convert_to_unicode("#{송장번호}")
            replace_dict[uniconde_tracking_number_tag] = parameters.get("tracking_number")
    else:
        if talk_event_code in [AligoEvents.BRAND_NOTICE]:
            replace_dict["#{브랜드명}"] = parameters.get("brand_name")
            replace_dict["#{공지사항 제목}"] = parameters.get("notice_title")
        elif talk_event_code in [AligoEvents.NEW_FOOD_REQUEST_REPLY]:
            replace_dict["#{상품명}"] = parameters.get("product_name_for_new")
        elif talk_event_code in [AligoEvents.REFUND_EXCHANGE_QA]:
            replace_dict["#{문의일}"] = parameters.get("q_created_at")
            replace_dict["#{문의구분}"] = parameters.get("q_type")
        elif talk_event_code in [
            AligoEvents.REFUND_EXCHANGE_APPROVE,
            AligoEvents.REFUND_EXCHANGE_REFUSED,
        ]:
            replace_dict["#{문의종류}"] = parameters.get("q_type")
            replace_dict["#{설명}"] = parameters.get("reason")
            replace_dict["#{문의사유}"] = parameters.get("q_reason_type")
        elif talk_event_code in [AligoEvents.DEACTIVATE_WARNING_ALARM]:
            replace_dict["#{전환예정일자}"] = parameters.get("deactivate_date")

    return replace_dict


def send_kakao_friend_talk_reorder_notice_to_customer(
    user: "User", bpv_name_list: List[str], app_deep_link_dict: dict, config: any
):
    talk_event_code = AligoFriendTalkEvents.REORDER_NOTICE
    if user is None:
        exception_message = f"친구톡 발송 실패 user 오브젝트 없음: {talk_event_code}"
        raise Exception(exception_message)

    receiver_phone = format_as_numeric_only_phone_number(user.aligo_phone)
    if receiver_phone is None:
        exception_message = f"친구톡 발송 실패 user.aligo_phone 형식 오류: {talk_event_code} user.aligo_phone={user.aligo_phone}"
        raise Exception(exception_message)
    user_name = user.first_name
    receiver_phone = receiver_phone

    bpv_name_list_expr = "\n".join([f"  ● {name}" for name in bpv_name_list[:3]])
    if len(bpv_name_list) > 3:
        bpv_name_list_expr += f"\n  ● 그 외 {len(bpv_name_list) - 3}종"
    friend_talk_subject = "고객님이 주문하신 상품의 재구매 시점이 다가오고 있습니다."
    friend_talk_message_template = Template(
        textwrap.dedent(
            """\
        $user_name 님, 이전에 구매하신 상품의 재고가 소진될 가능성이 있어 재구매를 안내드립니다.

        아래 상품을 확인하시고, 필요한 경우 재구매를 진행해 주세요.

        $bpv_name_list_expr

        더 자세한 내용은 하단의 버튼을 클릭해 확인해주세요.
        """
        )
    )
    friend_talk_message = friend_talk_message_template.substitute(
        user_name=user_name, bpv_name_list_expr=bpv_name_list_expr
    )
    button_text = "재구매 바로가기"

    aligo_friend_talk_event = create_send_aligo_friend_talk_event(
        type=talk_event_code, bpv_name_list_expr=bpv_name_list_expr, user=user
    )
    aligo_friend_talk_event_id = aligo_friend_talk_event.id if aligo_friend_talk_event else None

    task_send_kakao_friend_talk.delay(
        talk_code=talk_event_code,
