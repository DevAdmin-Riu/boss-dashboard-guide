import logging
from typing import Optional

from django.conf import settings
from django.db import transaction

from ...order.events import external_notification_event
from .. import ChargeStatus, TransactionKind
from ..models import Payment, Transaction
from ..utils import post_captured
from .process_auth_completed import _process_auth_completed_credits_refill_fully_charged
from .utils import make_vbank_success_message

logger = logging.getLogger(__name__)


def _process_vbank_noti_update_payment(payment: Payment):
    charge_status = ChargeStatus.FULLY_CHARGED
    payment.charge_status = charge_status
    payment.captured_amount = payment.amount
    payment.save()
    logger.info(f"payment_debug: _process_vbank_noti_update_payment {payment} {charge_status}")


def _process_vbank_noti_create_transaction(
    payment: Payment,
    pay_method: str,
    gateway_response,
) -> Transaction:
    kind = TransactionKind.CAPTURE

    txn = Transaction.objects.create(
        payment=payment,
        token=pay_method,
        kind=kind,
        is_success=True,
        amount=payment.amount,
        cashable_credits=payment.cashable_credits,
        non_cashable_credits=payment.non_cashable_credits,
        rcoins=payment.rcoins,
        currency=settings.DEFAULT_CURRENCY,
        gateway_response=gateway_response,
        # 신규 생성 Transaction은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
        is_converted=True,
    )

    return txn


def _process_vbank_noti_add_order_event(payment: Payment, is_mobile: Optional[bool]):
    message = make_vbank_success_message(is_mobile)
    external_notification_event(
        order=payment.order,
        user=None,
        message=message,
        parameters={
            "service": payment.gateway,
            "method": payment.token,
            "mobile": is_mobile if is_mobile is not None else "-",
        },
    )
    logger.info(f"payment_debug: _process_vbank_noti_add_order_event {payment} {message}")


def process_vbank_noti(
    payment: Payment,
    gateway_response,
    is_mobile: Optional[bool],
):
    is_success = True
    failed_msg = None
    is_for_credits_refill = payment.order.is_for_credits_refill
    try:
        with transaction.atomic():
            pay_method = payment.token
            _process_vbank_noti_update_payment(payment=payment)
            captured_transaction = _process_vbank_noti_create_transaction(
                payment=payment,
                pay_method=pay_method,
                gateway_response=gateway_response,
            )
            # 충전금 충전 상품 구입인 경우에 post_captured를 실행하지 않는다.
            if is_for_credits_refill:
                _process_auth_completed_credits_refill_fully_charged(
                    order=payment.order, payment=payment, user=payment.order.user
                )
            else:
                post_captured(payment=payment, captured_transaction=captured_transaction)
            _process_vbank_noti_add_order_event(
                payment=payment,
                is_mobile=is_mobile,
            )
    except Exception as e:
        is_success = False
        failed_msg = f"process_vbank_noti Exception: {payment.id} {e}"

    return is_success, failed_msg
