# PG 사 입금 기한이 23:59:00 (이니시스 모바일), 그외 23:59:59 (이니시스 PC, 토스) 로 처리된 것 확인 용도록 테스트 서버에서만 시:분:초 포함되어 출력
def get_inicis_vact_date(gateway_response, include_vact_time):
    vact_time_only = gateway_response.get(INICIS_VACT_TIME, None)
    # 입금기한 시간을 PC 용 키로 변환하지 않은 예전 데이터를 위한 처리
    if vact_time_only is None:
        vact_time_only = gateway_response.get(INICIS_P_VACT_TIME, None)
    vact_date_only = gateway_response.get(INICIS_VACT_DATE, None)
    vact_date_time = datetime.datetime.strptime(
        f"{vact_date_only} {vact_time_only}", "%Y%m%d %H%M%S"
    ).astimezone()
    if include_vact_time:
        vact_date = vact_date_time.strftime("%Y-%m-%d %H:%M:%S")
