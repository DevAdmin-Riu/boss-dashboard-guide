class FbvDeliveryConditionSetBaseUser(BaseMutation):
    old_base_condition = graphene.Field(FbvDeliveryCondition)
    new_base_condition = graphene.Field(FbvDeliveryCondition)

    class Arguments:
        vendor_id = graphene.ID(required=True, description="협력사 Id")
        user_id = graphene.ID(required=True, description="유저 Id")

    class Meta:
        description = "협력사 기준 매장 설정"
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, vendor_id, user_id):
        vendor = cls.get_node_or_error(info, vendor_id, field="vendor_id", only_type=Vendor)
        user = cls.get_node_or_error(info, user_id, field="user_id", only_type=User)
        if not user.brand_id:
            raise ValidationError("해당 유저는 브랜드에 속해 있지 않습니다.")

        brand_id = user.brand_id

        # 2. 기존 기준 매장 검색 (같은 brand-vendor 조합에서 True인 것)
        old_base_condition: FbvDeliveryConditionModel = (
            models.FbvDeliveryCondition.objects.select_related("user__brand", "vendor")
            .filter(vendor=vendor, user__brand_id=brand_id, is_base_user=True)
            .first()
        )

        # 3. 있으면 False 처리
        if old_base_condition:
            if old_base_condition.user_id == user.id:
                old_base_condition = None
            else:
                old_base_condition.is_base_user = False
                old_base_condition.save(update_fields=["is_base_user"])

        # 4. 새로운 기준 매장 등록/갱신
        new_instance, _created = models.FbvDeliveryCondition.objects.get_or_create(
            vendor=vendor,
            user=user,
            defaults={"is_base_user": True},
        )
        new_base_condition: FbvDeliveryConditionModel = new_instance
        if not new_base_condition.is_base_user:
            new_base_condition.is_base_user = True
            new_base_condition.save(update_fields=["is_base_user"])

        return FbvDeliveryConditionSetBaseUser(
            old_base_condition=old_base_condition,
            new_base_condition=new_base_condition,
        )
