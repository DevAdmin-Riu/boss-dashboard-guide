import graphene

from saleor.brand_store import models
from saleor.core.exceptions import PermissionDenied


def resolve_brand_store(info, id):
    requester = info.context.user
    _model, brand_store_pk = graphene.Node.from_global_id(id)
    brand_store = models.BrandStore.objects.filter(pk=brand_store_pk).first()
    if requester.is_staff:
        return brand_store
    elif requester.is_hq_staff and requester.brand_id == brand_store.brand_id:
        return brand_store
    # 일반 유저.
    elif not requester.is_hq_staff and requester.brand_store_id == brand_store.id:
        return brand_store

    # 일반 매장 인 경우 다른 매장 정보는 볼 수 없음
    return PermissionDenied(user=requester, fn=resolve_brand_store)


def resolve_brand_stores(info, **kwargs):
    requester = info.context.user
    if requester.is_hq_staff:
        qs = models.BrandStore.objects.filter(brand_id=requester.brand_id)
    elif requester.is_staff:
        qs = models.BrandStore.objects.all()
    else:
        return PermissionDenied(user=requester, fn=resolve_brand_stores)
    return qs.distinct()


def resolve_store_sales(info, brand_store_id, year):
    requester = info.context.user
    _model, brand_store_pk = graphene.Node.from_global_id(brand_store_id)

    brand_store = models.BrandStore.objects.filter(pk=brand_store_pk).first()
    store_sales = models.StoreSales.objects.filter(brand_store_id=brand_store_pk, year=year).first()
    if requester.is_staff:
        return store_sales
    # 본부 계정은 본부 브랜드의 매장들 조회가능.
    elif requester.is_hq_staff and requester.brand_id == brand_store.brand_id:
        return store_sales
    return PermissionDenied(user=requester, fn=resolve_brand_store)
