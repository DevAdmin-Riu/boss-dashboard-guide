        if value:
            _, vendor_id = graphene.Node.from_global_id(value)
            qs = qs.filter(lines__vendor_id=vendor_id)
        return qs

    def filter_warehouse_addresses(qs, _, value):
        if value:
            warehouse_addresses = get_nodes(value, "WarehouseAddress", AddressModel)
            qs = qs.filter(
                lines__stock_detail_lines__rack_location__sector__address__in=warehouse_addresses
            )
        return qs

