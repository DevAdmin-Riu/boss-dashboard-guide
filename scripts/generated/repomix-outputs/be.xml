class PurchaseOrderSend(BaseMutation):
    purchase_order = graphene.Field(PurchaseOrder, description="발송된 발주서")

    class Arguments:
        id = graphene.ID(required=True, description="ID of an purchase order to update.")
        sent_email_input = PurchaseOrderSentEmailInput(description="발송 이메일 정보")

    class Meta:
        description = "발주서 발송"
        model = models.PurchaseOrder
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        id = data.get("id")
        purchase_order: PurchaseOrderModel = cls.get_node_or_error(
            info, id, field="id", only_type=PurchaseOrder
        )
        if purchase_order.is_sent:
            raise ValidationError("이미 발송된 발주서입니다.")

        user = info.context.user
        purchase_order.is_sent = True
        purchase_order.save(update_fields=["is_sent"])
        # 발송 시 expected_purchase_date가 asking_purchase_date로 변경하고, 접수 대기 상태로 변경
        purchase_order.lines.update(
            expected_purchase_date=F("asking_purchase_date"), status=PurchaseOrderLineStatus.PENDING
        )
        events.add_po_manage_event(
            purchase_order=purchase_order,
            user=user,
            type=PurchaseOrderManageEventType.SENT,
        )
        purchase_order_lines = purchase_order.lines.all()
        bulk_create_po_line_status_histories(
            purchase_order_lines,
            before_status=PurchaseOrderLineStatus.DRAFT,
            after_status=PurchaseOrderLineStatus.PENDING,
            user=user,
        )

        sent_email_input: PurchaseOrderSentEmailInput = data.pop("sent_email_input", None)
        if sent_email_input:
            response = PurchaseOrderSentEmailCreate.mutate(root, info, input=sent_email_input)
            if response.errors:
                raise ValidationError(
                    f"발주서 이메일 발송 과정 에러 - {response.errors[0].message}"
                )
        return PurchaseOrderSend(purchase_order=purchase_order)


