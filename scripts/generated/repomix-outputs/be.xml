def decrease_stock_by_purchase_order_lines(
    user: "User",
    purchase_order_lines: List["PurchaseOrderLine"],
):
    from collections import defaultdict

    # 에러 타입별 메시지 매핑
    ERROR_MESSAGES = {
        1: "원 발주상세정보, 로케이션 정보 오류",
        2: "입고상세정보 오류",
        3: "입고상세 잔여 재고 부족 오류",
        4: "가용 재고 부족 오류",
        5: "로케이션 재고 데이터 오류",
        6: "로케이션 재고 수량 부족",
    }

    errors = defaultdict(list)  # 기본값이 list인 딕셔너리 생성
    for purchase_order_line in purchase_order_lines:
        purchase_order = purchase_order_line.purchase_order
        if purchase_order.is_take_back_decrease_stock_fix_version() == False:
            continue
        take_back_purchase_order_line: "PurchaseOrderLine" = (
            purchase_order_line.take_back_purchase_order_line
        )
        rack_location = purchase_order_line.take_back_rack_location
        error_type = decrease_stock_from_take_back_purchase_order(
            user=user,
            purchase_order=purchase_order,
            take_back_purchase_order_line=take_back_purchase_order_line,
            quantity=purchase_order_line.quantity,
            rack_location=purchase_order_line.take_back_rack_location,
        )
        if error_type > 0:
            if error_type == 6:
                errors[error_type].append(f"{purchase_order_line.code}:{rack_location.name}")
            else:
                errors[error_type].append(purchase_order_line.code)
            continue
        take_back_purchase_order_line.take_back_quantity += purchase_order_line.quantity
        take_back_purchase_order_line.save(update_fields=["take_back_quantity"])

    if errors:
        error_messages = [
            f"{ERROR_MESSAGES.get(error_type, f'알 수 없는 오류 ({error_type})')}: {', '.join(codes)}"
            for error_type, codes in errors.items()
        ]
        raise Exception("\n".join(error_messages))


# 부분입고가 없어져서 재고, 위탁 구분 없이 purchase_order_line.purchase_quantity 수량으로 매입 데이터 생성하면됨
def add_purchase_by_purchase_order_lines(
    purchase_order_lines: List["PurchaseOrderLine"], common_purchase_order: "PurchaseOrder" = None
):
    create_list = []
    for po_line in purchase_order_lines:
        variant: ProductVariant = po_line.variant
        # 위탁 재고 출고 발주 건에 대해서는 매입데이터 생성 안함
        if variant.is_vendor_track_inventory:
            continue
        purchase_order = (
            po_line.purchase_order if common_purchase_order is None else common_purchase_order
        )
        purchase = _make_purchase_by_purchase_order(
            purchase_order=purchase_order,
            purchase_order_line=po_line,
        )
        if purchase:
            create_list.append(purchase)
    if create_list:
        Purchase.objects.bulk_create(create_list)


