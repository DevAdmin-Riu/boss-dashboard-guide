class AccountSignUp(ModelMutation):
    class Arguments:
        input = AccountSignUpInput(description="Fields required to create a user.", required=True)

    requires_confirmation = graphene.Boolean(
        description="Informs whether users need to confirm their email address."
    )

    class Meta:
        description = "Register a new user."
        exclude = ["password"]
        model = models.User
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def mutate(cls, root, info, **data):
        response = super().mutate(root, info, **data)
        response.requires_confirmation = False
        return response

    @classmethod
    def clean_input(cls, info, instance, input_data, input_cls=None):
        password = input_data["password"]
        try:
            password_validation.validate_password(password, instance)
        except ValidationError as error:
            raise ValidationError({"password": error})

        aligo_phone = input_data.get("aligo_phone")
        if aligo_phone:
            try:
                input_data["aligo_phone"] = validate_possible_number(aligo_phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {
                        "phone": ValidationError(
                            f"'{aligo_phone}' {phoneValidErrorMsg}", code=exc.code
                        )
                    }
                ) from exc

        return super().clean_input(info, instance, input_data, input_cls=None)

    @classmethod
    def construct_instance(cls, info, instance: models.User, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        instance.switched_brand = instance.brand
        return instance

    @classmethod
    @transaction.atomic()
    def save(cls, info, user, cleaned_input):
        password = cleaned_input["password"]
        user.set_password(password)
        user.save()
        account_events.customer_account_created_event(user=user)
        info.context.plugins.customer_created(customer=user)

    @classmethod
    def post_save_action(cls, info, instance: "UserModel", cleaned_input):
        create_fbv_delivery_condition_by_base_user_condition(instance)

        staff_email = (
            instance.brand.staff.email if instance.brand and instance.brand.staff else None
        )
        context = {
            "brand_name": instance.brand.name,
            "user_id": instance.login_id,
            "user_phone": utils.format_as_hypenated_phone_number(instance.aligo_phone) or "-",
            "user_email": instance.email,
            "user_biz_reg_no": instance.biz_reg_no,
        }
        transaction.on_commit(
            lambda staff_email=staff_email, context=context: emails.send_templated_mail_account_signup_notice.delay(
                staff_email=staff_email, context=context
            )
        )


