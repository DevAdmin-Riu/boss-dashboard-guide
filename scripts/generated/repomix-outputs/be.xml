from ....core.utils.filename import make_unique_filename
from ....product import CategoryKind, models
from ....product.error_codes import ProductErrorCode
from ....product.thumbnails import create_category_background_image_thumbnails
from ....product.utils import delete_categories
from ...core.mutations import ModelDeleteMutation, ModelMutation
from ...core.types import Upload
from ...core.types.common import ProductError
from ...core.utils import (
    clean_seo_fields,
    validate_image_file,
    validate_slug_and_generate_if_needed,
)
from ..enums import CategoryKindEnum, CategoryTypeEnum
from ..types import Category


class CategoryInput(graphene.InputObjectType):
    name = graphene.String(description="Category name.")
    slug = graphene.String(description="Category slug.")
    background_image = Upload(description="Background image file.")
    background_image_alt = graphene.String(description="Alt text for an image.")
    type = CategoryTypeEnum(description="식자재이거나 포장재거나, 대분류로도 쓰임")
    kind = CategoryKindEnum(description="제품 구분. ")
    shipment_inspection_file = Upload(description="B2B 카테고리별 출하검사서 파일 양식")


class CategoryCreateInput(CategoryInput):
    code = graphene.String(description="Category code.", required=True)


class CategoryCreate(ModelMutation):
    class Arguments:
        input = CategoryCreateInput(
            required=True, description="Fields required to create a category."
        )
        parent_id = graphene.ID(
            description=(
                "ID of the parent category. If empty, category will be top level " "category."
            ),
            name="parent",
        )

    class Meta:
        description = "Creates a new category."
        model = models.Category
        permissions = (ProductPermissions.MANAGE_CATEGORY,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        try:
            cleaned_input = validate_slug_and_generate_if_needed(instance, "name", cleaned_input)
        except ValidationError as error:
            error.code = ProductErrorCode.REQUIRED.value
            raise ValidationError({"slug": error})
        parent_id = data.get("parent_id")
        type = data.get("type")
        kind = data.get("kind")
        if parent_id:
            parent = cls.get_node_or_error(info, parent_id, field="parent", only_type=Category)
            cleaned_input["parent"] = parent
            # request에서 type이 넘어오는 경우. Create의 경우 방어 로직. parent의 type과 넘어온 type이 다른 경우. error 노출
            if type and parent.type != type:
                raise ValidationError(
                    "하위 카테고리의 type과 상위 카테고리의 type이 동일해야 합니다.",
                    ProductErrorCode.INVALID,
                )
            # request에서 kind이 넘어오는 경우. Create의 경우 방어 로직. parent의 kind과 넘어온 kind이 다른 경우. error 노출
            if kind and parent.kind != kind:
                raise ValidationError(
                    "하위 카테고리의 kind와 상위 카테고리의 kind는 동일해야 합니다.",
                    ProductErrorCode.INVALID,
                )

        # request에서 type이 넘어오는 경우 + parentㄱㅏ 있는 경우, parent의 type과 넘어온 type이 다른 경우. error 노출
        if type and instance.parent and instance.parent.type != type:
            raise ValidationError(
                "하위 카테고리의 type과 상위 카테고리의 type이 동일해야 합니다.",
                ProductErrorCode.INVALID,
            )

        # request에서 kind이 넘어오는 경우 + parentㄱㅏ 있는 경우, parent의 kind과 넘어온 kind이 다른 경우. error 노출
        if kind and instance.parent and instance.parent.kind != kind:
            raise ValidationError(
                "하위 카테고리의 kind과 상위 카테고리의 kind이 동일해야 합니다.",
                ProductErrorCode.INVALID,
            )

        if data.get("background_image"):
            image_data = info.context.FILES.get(data["background_image"])
            validate_image_file(image_data, "background_image")
            new_file_name = make_unique_filename(image_data.name)
            image_data.name = new_file_name
        if data.get("shipment_inspection_file"):
            if kind != CategoryKind.B2B:
                raise ValidationError(
                    "출하검사서 양식은 구분이 B2B인 카테고리에서만 첨부할 수 있습니다.",
                    ProductErrorCode.INVALID,
                )

            shipment_inspection_file_data = info.context.FILES.get(data["shipment_inspection_file"])
            cleaned_input["shipment_inspection_file_name"] = shipment_inspection_file_data.name
        clean_seo_fields(cleaned_input)
        return cleaned_input

    @classmethod
    def perform_mutation(cls, root, info, **data):
        parent_id = data.pop("parent_id", None)
        data["input"]["parent_id"] = parent_id
        return super().perform_mutation(root, info, **data)

    @classmethod
    @transaction.atomic
    def save(cls, info, instance: models.Category, cleaned_input):
        instance.save()
        # instance의 모든 자손들의 type들을 cleaned_input의 caterogy_type 값으로 지정한다.
        # category model의 오버라이딩된 save를 수행하기위해 save사용(update쓰면 안됨)
        for descendant in instance.get_descendants():
            descendant.type = cleaned_input.get("type")
            descendant.kind = cleaned_input.get("kind")
            descendant.save(update_fields=["type", "kind"])

        # level이 1보다 큰 경우 생성하지 못한다.
        if instance.get_level() > 1:
            raise ValidationError(
                "카테고리는 2번째 depth까지만 생성할 수 있습니다.", ProductErrorCode.INVALID
            )

        if cleaned_input.get("background_image"):
            create_category_background_image_thumbnails.delay(instance.pk)


class CategoryUpdate(CategoryCreate):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a category to update.")
        input = CategoryInput(required=True, description="Fields required to update a category.")

    class Meta:
        description = "Updates a category."
        model = models.Category
        permissions = (ProductPermissions.MANAGE_CATEGORY,)
        error_type_class = ProductError
        error_type_field = "product_errors"


class CategoryDelete(ModelDeleteMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a category to delete.")

    class Meta:
        description = "Deletes a category."
        model = models.Category
        permissions = (ProductPermissions.MANAGE_CATEGORY,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        if not cls.check_permissions(info.context, **data):
            raise PermissionDenied(user=info.context.user, cls=cls)

        node_id = data.get("id")
        instance = cls.get_node_or_error(info, node_id, only_type=Category)

        db_id = instance.id

        delete_categories([db_id])

        instance.id = db_id
        return cls.success_response(instance)
