        search_fields = [
            "user__brand__code",
            "user__brand__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_user_search(qs, _, value):
        search_fields = [
            "user__first_name",
            "user__login_id",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand(qs, _, value):
        if value:
            _, brand_id = graphene.Node.from_global_id(value)
            qs = qs.filter(user__brand_id=brand_id)

        return qs

    brand_search = django_filters.CharFilter(method=filter_brand_search)
    user_search = django_filters.CharFilter(method=filter_user_search)
    brand = GlobalIDFilter(method=filter_brand)

    class Meta:
        model = FbvDeliveryCondition
        fields = {"vendor": ["exact"], "user": ["exact"]}


class FbvDeliveryConditionFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = FbvDeliveryConditionFilter


class MakerFilter(django_filters.FilterSet):
    def filter_maker_search(qs, _, value):
        if value:
            prefix = MAKER_CODE_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        return qs.filter(pk=pk_value)
                    except:
                        raise ValidationError(f"제조사코드 형식을 확인해 주세요. {value}")

        search_fields = ["name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    maker_search = django_filters.CharFilter(method=filter_maker_search)

    class Meta:
        model = Maker
        fields = []


class MakerFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = MakerFilter
