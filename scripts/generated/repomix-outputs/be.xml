import graphene
from django.db.models import Case, Count, Max, QuerySet, Sum, Value, When
from django.db.models.functions import Coalesce

from ..core.types import SortInputObjectType


class UserSortField(graphene.Enum):
    FIRST_NAME = ["first_name", "last_name", "pk"]
    LOGIN_ID = ["login_id"]
    EMAIL = ["email", "pk"]
    BIZ_REG_NO = ["biz_reg_no", "pk"]
    PHONE = ["phone", "pk"]
    ORDER_COUNT = ["order_count", "pk"]
    MONEY_SPENT = ["money_spent", "pk"]
    BRAND = ["brand_name", "pk"]
    CREATION_DATE = ["date_joined", "pk"]
    REQUESTED_DS_APPROVAL = ["requested_ds_approval", "pk"]

    @property
    def description(self):
        if self.name in UserSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort users by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_order_count(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(order_count=Count("orders__id"))

    @staticmethod
    def qs_with_money_spent(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(money_spent=Coalesce(Sum("orders__total_gross_amount"), 0))

    @staticmethod
    def qs_with_brand(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(
            brand_name=Case(When(brand__isnull=False, then="brand__name"), default=Value(""))
        )

    @staticmethod
    def qs_with_phone(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(
            phone=Case(
                When(
                    default_shipping_address__isnull=False,
                    then="default_shipping_address__phone",
                ),
                default=Value(""),
            )
        )


class UserSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = UserSortField
        type_name = "users"


class PermissionGroupSortField(graphene.Enum):
    NAME = ["name", "pk"]

    @property
    def description(self):
        # pylint: disable=no-member
        if self in [PermissionGroupSortField.NAME]:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort permission group accounts by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)


class PermissionGroupSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = PermissionGroupSortField
        type_name = "permission group"


class BrandSortField(graphene.Enum):
    NAME = ["name", "pk"]
    EMAIL = ["email", "name", "pk"]
    LAST_CREATION_DATE = ["last_notice_created_at", "pk"]
    NUMBER_OF_NOTICES = ["number_of_notices", "pk"]

    @property
    def description(self):
        if self.name in BrandSortField.__enum__._member_names_:
            sort_name = self.name.lower()
            return f"Sort franchise brands by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_last_creation_date(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(last_notice_created_at=Max("from_hq_notices__created_at"))

    @staticmethod
    def qs_with_number_of_notices(queryset: QuerySet) -> QuerySet:
        return queryset.annotate(number_of_notices=Count("from_hq_notices__id"))


class BrandSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = BrandSortField
        type_name = "brands"
