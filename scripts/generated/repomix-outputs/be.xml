class BrandAddProducts(BaseMutation):
    brand = graphene.Field(
        Brand, description="Franchise brand for which products will be available."
    )

    class Arguments:
        brand_id = graphene.Argument(
            graphene.ID, required=True, description="ID of a franchise brand."
        )
        is_fulfilled_by_vendor = graphene.Boolean(
            required=True, description="협력사가 출고하는 제품(직거래 상품) 여부"
        )
        products = graphene.List(graphene.ID, required=True, description="List of product IDs.")

    class Meta:
        description = "assign products to brand"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def validate_fulfilled_by_vendor(
        cls, brand: BrandModel, is_fulfilled_by_vendor: bool, product_instances: List[ProductModel]
    ):
        if is_fulfilled_by_vendor:
            if BrandServiceType.FBV not in brand.enabled_services:
                raise ValidationError(
                    "발주원을 이용하지 않는 브랜드에 직거래 상품을 추가할 수 없습니다."
                )

            is_fulfilled_by_boss_md_products = [
                product_instance
                for product_instance in product_instances
                if product_instance.is_fulfilled_by_vendor == False
            ]
            if is_fulfilled_by_boss_md_products:
                raise ValidationError(
                    "직거래 상품 리스트 페이지에서 보스 상품을 추가할 수 없습니다."
                )
        else:
            is_fulfilled_by_vendor_products = [
                product_instance
                for product_instance in product_instances
                if product_instance.is_fulfilled_by_vendor == True
            ]
            if is_fulfilled_by_vendor_products:
                raise ValidationError(
                    "보스 상품 리스트 페이지에서 직거래 상품을 추가할 수 없습니다."
                )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, brand_id, is_fulfilled_by_vendor, products):
        brand: BrandModel = cls.get_node_or_error(info, brand_id, field="brand_id", only_type=Brand)
        if brand is None:
            raise ValidationError("brand_id 오류", code=ProductErrorCode.INVALID)

        product_instances: List[ProductModel] = cls.get_nodes_or_error(
            products, "products", only_type=Product
        )

        cls.validate_fulfilled_by_vendor(brand, is_fulfilled_by_vendor, product_instances)

        if brand.is_direct_shipping == False:
            direct_shipping_products = [
                product_instance
                for product_instance in product_instances
                if product_instance.is_direct_shipping == True
            ]
            count = len(direct_shipping_products)
            if count > 0:
                error_msg = f"직배송 상품 취급 안하는 브랜드에 직배송 상품을 {count}개 연결하려고 하고 있습니다. 확인 후 다시 시도해 주세요."
                raise ValidationError(error_msg, code=ProductErrorCode.INVALID)
        else:
            direct_shipping_vendor = brand.direct_shipping_vendor
            product_instance_pks = [product.pk for product in product_instances]
            invalid_list = models.ProductVariantVendor.objects.filter(
                product_variant__product_id__in=product_instance_pks,
                product_variant__product__is_direct_shipping=True,
            ).exclude(vendor=direct_shipping_vendor)
            if invalid_list.exists():
                invalid_skus = ", ".join([item.product_variant.sku for item in invalid_list])
                raise ValidationError(
                    f"브랜드의 직배송 협력사와 다른 직배송 협력사로 등록된 상품을 연결할 수 없습니다. 등록 불가 상품코드: {invalid_skus}",
                    code=ProductErrorCode.INVALID.value,
                )

        brand.products.add(*product_instances)

        count = len(product_instances)
        if count:
            instance_ids = [instance.pk for instance in product_instances]
            brand_products_qs = brand.brand_products.select_related("product").filter(
                product_id__in=instance_ids
            )
            brand_products: List[BrandProductModel] = list(brand_products_qs)
            create_brand_product_variants(brand, brand_products)
            set_brand_product_name_and_is_exclusive(brand_products)
        return BrandAddProducts(brand=brand)


