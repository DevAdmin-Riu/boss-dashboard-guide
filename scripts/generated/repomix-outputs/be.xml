    }


# 결제일을 captured_transaction.gateway_response 에서 추출해서 세팅하므로 호출 순서 주의
def post_captured(payment: Payment, captured_transaction: "Transaction", requester: User = None):
    order: "Order" = payment.order
    order_type = order.type
    # b2b 주문은 post_captured 처리 안함.
    # 혹시 실수로 호출되어도 매출데이터 생성등 post_captured 로직 수행 안되도록 예외 처리 추가함
    if order.is_b2b_order:
        return

    captured_date = get_last_captured_date(payment, captured_transaction)

    if captured_date:
        order.captured_at = captured_date
        order.is_first = False
        if order.user is not None:
            first_order = (
                order.user.orders.filter(captured_at__isnull=False).order_by("captured_at").first()
            )
            order.is_first = first_order is None or first_order == order
            # order생성시(유저가 주문시) order.brand가 존재하는 경우. brand의 first_day가 null인 경우 현재 일자를 넣는다.
            brand = order.user.brand
            if brand and not brand.first_day:
                # captured_date의 날짜까지만 first_day로 넣는다.
                brand.first_day = captured_date.date()
                brand.save(update_fields=["first_day"])

        else:
            order.is_first = False
        order.save(update_fields=["captured_at", "is_first"])

        # 악성재고 처리용 오픈몰주문과 기타 배송 주문인 경우에는 세금계산서 발행 요청 안함
        if order_type in [
            OrderType.BY_STAFF_FOR_BAD_STOCK,
            OrderType.BY_STAFF_FOR_ETC,
        ]:
            logger.info(
                f"tax invoice 발행이 필요없는 주문: {payment.id} / {order.id} - order type={order_type}"
            )
        elif order.tax_invoice_request_flag == False:
            logger.info(
                f"tax invoice 발행 안함 주문: {payment.id} / {order.id} - order type={order_type}"
            )
        else:
            if requester is None:
                requester = order.user
            create_tax_invoice_request_on_order(
                requester=requester,
                payment=payment,
                captured_date=captured_date,
            )

        # 기타 배송 주문인 경우에는 매출 데이터 생성 안함
        if order_type in [OrderType.BY_STAFF_FOR_ETC]:
            logger.info(
                f"매출 데이터 기록안하는 주문: {payment.id} / {order.id} - order type={order_type}"
            )
        else:
            order_lines = order.lines.all()
            create_sales_stat_list: List[Sales] = make_create_stats_sales_by_order_lines(
                order_lines=order_lines
            )
            if create_sales_stat_list and len(create_sales_stat_list) > 0:
                Sales.objects.bulk_create(create_sales_stat_list)
                if order.user:
                    for order_line in order_lines:
                        reset_reorder_notice_schedule_data(order.user_id, order_line.variant_id)

        # plugin_configs, brand의 enable_rcoin_reward_for_using_point 값이 모두 True인 경우에 RcoinsRewardLine을 생성한다.
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
        enable_rcoin_reward_for_using_point = plugin_configs.enable_rcoin_reward_for_using_point
        if enable_rcoin_reward_for_using_point and order.brand:
            enable_rcoin_reward_for_using_point = order.brand.enable_rcoin_reward_for_using_point

        if enable_rcoin_reward_for_using_point and payment.credits_incl_non_cashable > 0:
            is_rcoin_reward_for_using_point = order.lines.filter(
                Q(brand_product_variant__brand_product__is_rcoin_reward_for_using_point=True)
                | Q(bp_bundle__is_rcoin_reward_for_using_point=True)
            ).exists()

            if is_rcoin_reward_for_using_point:
                enable_rcoin_reward_for_using_point_percent = (
                    plugin_configs.enable_rcoin_reward_for_using_point_percent
                )
                # RcoinsReward 및 RcoinsRewardLine 에 값을 넣는다.
                rcoins_reward = RcoinsReward.objects.create(
                    rate=Decimal(enable_rcoin_reward_for_using_point_percent),
                    order=order,
                )
                # rcoins reward 계산식(update_rcoins)에서 충전금 혜택이 없는 상품에 사용된 결제금액을 고려해야 해서 전체 order_lines 에 대해서 RcoinsRewardLine 생성함
                order_lines: List[OrderLine] = order.lines.all()
                for order_line in order_lines:
                    bp_bundle: BpBundle = order_line.bp_bundle
                    if bp_bundle:
                        is_rcoin_reward_for_using_point = bp_bundle.is_rcoin_reward_for_using_point
                        is_only_payable_by_cash = bp_bundle.is_only_payable_by_cash
                    else:
                        # 대행 주문에서는 bpv가 없지만 payment.credits_incl_non_cashable 조건에서 이미 걸러짐. 즉 없는 경우는 가정 안해도 됨.
                        bpv = order_line.brand_product_variant
                        is_rcoin_reward_for_using_point = (
                            bpv.brand_product.is_rcoin_reward_for_using_point
                        )
                        is_only_payable_by_cash = bpv.brand_product.is_only_payable_by_cash
                    RcoinsRewardLine.objects.create(
                        reward=rcoins_reward,
                        order_line=order_line,
                        is_rcoin_reward_for_using_point=is_rcoin_reward_for_using_point,
                        is_only_payable_by_cash=is_only_payable_by_cash,
                    )
                rcoins_reward.update_rcoins(is_settlement_mode=False)


def get_payment_charge_status_enum_name(charge_status: str):
    for name, enum_value in PaymentChargeStatusEnum._meta.enum.__members__.items():
        if enum_value.value == charge_status:
            return name


def get_charge_status_text(status: ChargeStatus):
    status_mapping = {
