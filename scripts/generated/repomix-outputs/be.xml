class BrandProductReorder(BaseMutation):
    brand = graphene.Field(Brand)

    class Arguments:
        brand_id = graphene.ID(
            required=True,
            description="Id of brand that brand products order will be altered.",
        )
        moves = graphene.List(
            ReorderInput,
            required=True,
            description="The list of brand product reordering operations.",
        )

    class Meta:
        description = "브랜드 상품의 진열 순서 변경"
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def perform_mutation(cls, _root, info, brand_id, moves):
        pk = from_global_id_strict_type(brand_id, only_type=Brand, field="id")

        try:
            brand = account_models.Brand.objects.prefetch_related("brand_products").get(pk=pk)
        except ObjectDoesNotExist:
            raise ValidationError(
                {
                    "brand_id": ValidationError(
                        (f"Couldn't resolve to a brand type: {brand_id}"),
                        code=ProductErrorCode.NOT_FOUND,
                    )
                }
            )

        brand_products_m2m = brand.brand_products
        operations = {}

        for move_info in moves:
            brand_product_pk = from_global_id_strict_type(
                move_info.id, only_type=BrandProduct, field="moves"
            )

            try:
                m2m_info = brand_products_m2m.get(id=int(brand_product_pk))
            except ObjectDoesNotExist:
                raise ValidationError(
                    {
                        "moves": ValidationError(
                            f"Couldn't resolve to a brand product: {move_info.id}",
                            code=ProductErrorCode.NOT_FOUND,
                        )
                    }
                )
            operations[m2m_info.pk] = move_info.sort_order

        with transaction.atomic():
            perform_reordering(brand_products_m2m, operations)

        return BrandProductReorder(brand=brand)


