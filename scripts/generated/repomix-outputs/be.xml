import graphene
from django.db.models import (
    Case,
    CharField,
    Count,
    ExpressionWrapper,
    F,
    OuterRef,
    Q,
    QuerySet,
    Subquery,
    Value,
    When,
)

from ...order import OrderStatus
from ...order.models import FulfillmentLine, StockDetailLine
from ...payment.models import Payment
from ..core.types import SortInputObjectType


class OrderSortField(graphene.Enum):
    NUMBER = ["pk"]
    CREATION_DATE = ["created", "status", "pk"]
    BRAND = ["user_brand_name", "pk"]
    CUSTOMER = ["user_first_name", "pk"]
    PAYMENT = ["last_charge_status", "status", "pk"]
    FULFILLMENT_STATUS = ["status", "user_email", "pk"]
    DELIVERY_STATUS = ["delivery_status", "pk"]
    TOTAL = ["total_gross_amount", "status", "pk"]

    @property
    def description(self):
        if self.name in OrderSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort orders by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_payment(qs: QuerySet) -> QuerySet:
        subquery = Subquery(
            Payment.objects.filter(order_id=OuterRef("pk"))
            .order_by("-pk")
            .values_list("charge_status")[:1]
        )
        return qs.annotate(last_charge_status=ExpressionWrapper(subquery, output_field=CharField()))

    @staticmethod
    def qs_with_customer(qs: QuerySet) -> QuerySet:
        return qs.annotate(
            user_first_name=Case(
                When(user__isnull=False, then="user__first_name"), default=Value("")
            )
        )

    @staticmethod
    def qs_with_brand(qs: QuerySet) -> QuerySet:
        return qs.annotate(
            user_brand_name=Case(When(brand__isnull=False, then="brand__name"), default=Value(""))
        )

    @staticmethod
    def qs_with_delivery_status(qs: QuerySet) -> QuerySet:
        qs = qs.annotate(
            fulfillment_count=Count("fulfillments"),
            tracking_complete_count=Count(
                "fulfillments", filter=Q(fulfillments__is_tracking_completed=True)
            ),
            tracking_number_count=Count(
                "fulfillments", filter=~Q(fulfillments__tracking_number__exact="")
            ),
        )

        return qs.annotate(
            delivery_status=ExpressionWrapper(
                Case(
                    When(status=OrderStatus.CANCELED, then=Value("5.취소")),
                    When(status=OrderStatus.UNFULFILLED, then=Value("0.배송대기")),
                    When(
                        status=OrderStatus.PARTIALLY_FULFILLED,
                        then=Value("1.배송대기-부분출고"),
                    ),
                    When(
                        Q(status=OrderStatus.FULFILLED)
                        & Q(fulfillment_count=F("tracking_complete_count")),
                        then=Value("4.배송완료"),
                    ),
                    When(
                        Q(status=OrderStatus.FULFILLED)
                        & Q(fulfillment_count=F("tracking_number_count")),
                        then=Value("3.배송중"),
                    ),
                    When(status=OrderStatus.FULFILLED, then=Value("2.배송준비중")),
                    default=Value(""),
                ),
                output_field=CharField(),
            )
        )


class OrderSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = OrderSortField
        type_name = "orders"


class OrderLineSortField(graphene.Enum):
    NUMBER = ["number", "pk"]
    ORDER_ID = ["order_id", "pk"]
    ORDER_CREATION_DATE = ["order__created", "pk"]

    @property
    def description(self):
        if self.name in OrderLineSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort order lines by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_number(qs: QuerySet) -> QuerySet:
        max_sub_id = 10000
        return qs.annotate(number=F("order_id") * max_sub_id + max_sub_id - F("sub_id"))

    @staticmethod
    def qs_with_order_creation_date(qs: QuerySet) -> QuerySet:
        return qs.select_related("order")


class OrderLineSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = OrderLineSortField
        type_name = "order lines"


