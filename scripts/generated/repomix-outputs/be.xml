        )
        po_lines = [po_line]
        cls.validate_po_type(po_lines)
        cls.validate_status(po_lines)
        return details, po_line

    @classmethod
    def copy_purchase_order(cls, source_purchase_order: PurchaseOrderModel, reason):
        new_purchase_order = copy.deepcopy(source_purchase_order)
        new_purchase_order.pk = None
        new_purchase_order.parent_id = source_purchase_order.pk
        new_purchase_order.note = reason
        new_purchase_order.created = timezone.now()
        new_purchase_order.save()

        return new_purchase_order

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        user: "User" = info.context.user
        input_data = data.get("input")
        reason = input_data.get("reason")
        details, po_line = cls.clean_details(info=info, input_data=input_data)

        first_detail = details[0]
        po_line.expected_purchase_date = first_detail.get("req_epd")
        req_quantity = first_detail.get("req_quantity")
        po_line.quantity = req_quantity
        po_line.note = first_detail.get("note")
        po_line.status = PurchaseOrderLineStatus.RECEIVED
        po_line.save(update_fields=["expected_purchase_date", "quantity", "note", "status"])
        source_purchase_order = po_line.purchase_order
        is_b2b = source_purchase_order.is_b2b
        if is_b2b:
            order_line: OrderLineModel = po_line.order_line
            order_line.quantity = req_quantity
            order_line.save(update_fields=["quantity"])

        po_lines = [po_line]
        bulk_create_po_line_status_histories(
            po_lines,
            before_status=PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
            after_status=PurchaseOrderLineStatus.RECEIVED,
            user=user,
        )
        send_notice_po_approved_req_split_delivery_to_vendor(info, po_lines)

        po_line_req_split_delivery: PoLineReqSplitDeliveryModel = (
            models.PoLineReqSplitDelivery.objects.filter(
                purchase_order_line=po_line, is_approved=False
            ).last()
        )
        po_line_req_split_delivery.is_approved = True
        po_line_req_split_delivery.approved_at = timezone.now()
        po_line_req_split_delivery.save(update_fields=["is_approved", "approved_at"])

        details_except_first = details[1:]
        bulk_create_list = []
        pending_pairs: List[Tuple[PurchaseOrderLineModel, OrderLineModel]] = []
        for detail in details_except_first:
            req_epd = detail.get("req_epd")
            req_quantity = detail.get("req_quantity")
            note = detail.get("note")
            new_po = cls.copy_purchase_order(source_purchase_order, reason)
            new_po_line: PurchaseOrderLineModel = copy.deepcopy(po_line)
            new_po_line.pk = None
            new_po_line.purchase_order = new_po
            new_po_line.parent_id = po_line.pk
            new_po_line.status = PurchaseOrderLineStatus.PENDING
            new_po_line.asking_purchase_date = req_epd
            new_po_line.expected_purchase_date = req_epd
            new_po_line.quantity = req_quantity
            new_po_line.note = note
            if is_b2b:
                new_po_line.purchase_date = kst_timezone_date()
                new_po_line.purchase_user = user
                new_po_line.purchase_quantity = req_quantity
            else:
                new_po_line.purchase_date = None
                new_po_line.purchase_user = None
                new_po_line.purchase_quantity = 0
            new_po_line.take_back_quantity = 0
            new_po_line.etc_exclude_vat = 0
            new_po_line.dev_cost_exclude_vat = 0
            if is_b2b:
                new_order_line: OrderLineModel = copy.deepcopy(po_line.order_line)
                new_order_line.pk = None
                new_order_line.purchase_order_line = None  # 나중에 설정
                new_order_line.quantity = req_quantity
                pending_pairs.append((new_po_line, new_order_line))
            bulk_create_list.append(new_po_line)

        if len(bulk_create_list) > 0:
            created_po_lines: List[PurchaseOrderLineModel] = (
                models.PurchaseOrderLine.objects.bulk_create(bulk_create_list)
            )
            for (_orig_po_line_obj, orig_order_line_obj), created_po_line in zip(
                pending_pairs, created_po_lines
            ):
                orig_order_line_obj.purchase_order_line = created_po_line
                created_po_line.order_line = orig_order_line_obj
                orig_order_line_obj.save()
                created_po_line.save(update_fields=["order_line"])

            add_po_manage_event_on_approve_req_split_delivery(
                user, po_line, reason, bulk_create_list
            )
            bulk_create_po_line_status_histories(
                bulk_create_list,
                before_status=PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
                after_status=PurchaseOrderLineStatus.PENDING,
                user=user,
            )
        return PurchaseOrderLineApproveReqSplitDelivery(purchase_order_line=po_line)


