@app.task
def send_templated_mail_will_be_stopped_alarm_in_package(
    brand_name,
    package_name,
    brand_product_name,
    staff_email,
):
    mail_title_for_log = "패키지 상품 중 단종예정 상품 발생 시 알림 메일 발송"
    recipient_list = []
    if staff_email:
        recipient_list.append(staff_email)
    context = {
        "brand_name": brand_name,
        "package_name": package_name,
        "brand_product_name": brand_product_name,
    }
    if len(recipient_list) == 0:
        logger.info(f"{mail_title_for_log}을 위한 담당MD 이메일 설정을 확인하세요. {context}")
        return

    send_kwargs, ctx = get_email_context()
    ctx.update(context)
    send_templated_mail_consider_test_mode(
        mail_title_for_log=mail_title_for_log,
        template_name="product/will_be_stopped_alarm_in_package_to_md",
        recipient_list=recipient_list,
        context=ctx,
        **send_kwargs,
    )


