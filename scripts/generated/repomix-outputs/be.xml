logger = logging.getLogger()


def send_kakaotalk_to_customer_on_refund_status(refund_qa: RefundQA):
    event_code = None
    reason = None
    if refund_qa.is_refused:
        event_code = AligoEvents.REFUND_EXCHANGE_REFUSED
        reason = refund_qa.a_refuse_reason
    else:
        event_code = AligoEvents.REFUND_EXCHANGE_APPROVE
        reason = refund_qa.a_approve_message

    is_by_staff_for_bad_stock_order_type = refund_qa.order.type == OrderType.BY_STAFF_FOR_BAD_STOCK
    # 오픈몰 주문인 경우는 user_info 가 존재하지 않음. 관리자가 주문하여 관리자가 반품하는 경우.
    if is_by_staff_for_bad_stock_order_type == True:
        return
    user_info = User.objects.filter(login_id=refund_qa.q_writer).first()
    parameters = {
        RECEIVER_PHONE: user_info.aligo_phone,
        "user_name": user_info.first_name,
        "order_id": refund_qa.order_id,
        "q_type": RefundQuestionType[refund_qa.q_type].label,
        "q_reason_type": get_question_reason(refund_qa.q_reason_type),
        "reason": reason,
    }
    get_plugins_manager().send_kakaotalk(talk_event_code=event_code, parameters=parameters)


