from typing import Dict, List, Tuple

import graphene
from django.core.exceptions import ValidationError

from ...core.permissions import TaxInvoicePermissions
from ...taxinvoice import TaxInvoiceStatus, models
from ...taxinvoice.models import TaxInvoice as TaxInvoiceModel
from ...taxinvoice.utils import get_invoicee_biz_reg_info_by_tax_invoice
from ..core.mutations import BaseMutation, ModelMutation
from ..core.scalars import PositiveInteger
from ..core.types.common import TaxInvoiceError
from ..core.utils import from_global_id_strict_type
from ..product.bulk_mutations.utils import validate_data_is_non_null
from .types import TaxInvoice


class TaxInvoiceIssue(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of the tax invoice.")

    class Meta:
        description = "Creates a ready to send tax invoice."
        model = models.TaxInvoice
        # 매출인식몰인 경우 가맹본부가 세금계산서 발행을 직접 콘트롤 필요해서 퍼미션 제거함
        error_type_class = TaxInvoiceError
        error_type_field = "tax_invoice_errors"

    @staticmethod
    def clean_tax_invoice(tax_invoice: TaxInvoiceModel):
        if tax_invoice is None:
            raise ValidationError("세금계산서 발행 정보가 존재하지 않습니다.")

        is_b2b = tax_invoice.is_b2b
        if not is_b2b:
            raise ValidationError("B2B 거래만 수동 세금계산서 발행 요청을 할 수 있습니다.")

        invoicee_biz_reg_info = get_invoicee_biz_reg_info_by_tax_invoice(tax_invoice)

        if invoicee_biz_reg_info is None:
            raise ValidationError(
                "세금계산서 발행을 위한 공급받는자 정보가 없습니다.",
            )

        if not invoicee_biz_reg_info.biz_reg_no:
            raise ValidationError(
                "세금계산서 발행을 위한 주문자 사업자등록번호 정보가 없습니다.",
            )

        if tax_invoice.write_date is None:
            raise ValidationError(
                f"세금계산서 작성일자 정보가 존재하지 않습니다. 작성일자를 입력한 후 다시 시도해 주세요. {tax_invoice.id}",
            )

        if tax_invoice.status == TaxInvoiceStatus.ISSUED:
            raise ValidationError(
                f"이미 세금계산서가 발행되었습니다. {tax_invoice.id}, status={tax_invoice.status}"
            )

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        tax_invoice = cls.get_node_or_error(info, data["id"], only_type=TaxInvoice, field="id")
        cls.clean_tax_invoice(tax_invoice)
        tax_invoice = info.context.plugins.tax_invoice_issue(
            tax_invoice=tax_invoice, requester=info.context.user
        )
        return TaxInvoiceIssue(taxInvoice=tax_invoice)


class TaxInvoiceBulkIssue(BaseMutation):
    tax_invoice_list = graphene.List(TaxInvoice)

    class Arguments:
        ids = graphene.List(
            graphene.NonNull(graphene.ID), required=True, description="List of tax invoice IDs."
        )

    class Meta:
        description = "세금계산서 일괄발행용 Mutation"
        permissions = (TaxInvoicePermissions.MANAGE_TAXINVOICE,)
        error_type_class = TaxInvoiceError
        error_type_field = "tax_invoice_errors"

    @classmethod
    def perform_mutation(cls, root, info, **data):
        tax_invoices_global_ids = data.get("ids")
        errors = []
        tax_invoice_list = []
        for tax_invoice_global_id in tax_invoices_global_ids:
            try:
                result = TaxInvoiceIssue.perform_mutation(root, info, id=tax_invoice_global_id)
                tax_invoice_list.append(result.taxInvoice)
            except ValidationError as e:
                errors.append(e)
        if errors:
            raise ValidationError(errors)

        return TaxInvoiceBulkIssue(tax_invoice_list=tax_invoice_list)


def validate_tax_invoice_list(
    details,
) -> Tuple[Dict[str, "TaxInvoiceModel"], List["TaxInvoiceModel"]]:
    global_ids = [d["id"] for d in details if d.get("id")]
    db_ids = [from_global_id_strict_type(gid, TaxInvoice) for gid in global_ids]
    qs = models.TaxInvoice.objects.filter(id__in=db_ids)
    instance_list_by_db_id = {str(instance.id): instance for instance in qs}
    # mutation 로직에서 global_id 를 키로 사용하는 것이 편리하므로 global_id 를 키로 사용한 dict 생성
    instance_dict: Dict[str, "TaxInvoiceModel"] = {}
    errors = []
    for gid, db_id in zip(global_ids, db_ids):
        instance = instance_list_by_db_id.get(db_id)
        if instance:
            instance_dict[gid] = instance
        else:
            errors.append(gid)
    if errors:
        raise ValidationError(f"세금계산서 아이디 오류: {', '.join(errors)}")
    # 입력 순서대로 객체 리스트
    instance_list = [instance_dict[gid] for gid in global_ids]
    return instance_dict, instance_list


class TaxInvoiceBulkOfflineIssueDetailInput(graphene.InputObjectType):
    id = graphene.ID(required=True, description="tax invoice ID")
    write_date = graphene.types.datetime.Date(
        required=True, description="작성일. ISO 8601 standard."
    )
    total_amount = PositiveInteger(required=True, description="발행금액")


class TaxInvoiceBulkOfflineIssueInput(graphene.InputObjectType):
    details = graphene.List(
        TaxInvoiceBulkOfflineIssueDetailInput,
        required=True,
        description="수기 발행 처리",
    )


class TaxInvoiceBulkOfflineIssue(BaseMutation):
    tax_invoice_list = graphene.List(TaxInvoice)

    class Arguments:
        input = TaxInvoiceBulkOfflineIssueInput(
            required=True,
            description="수기 발행 처리 입력 필드",
        )

    class Meta:
        description = "세금계산서 일괄 수기 발행"
        permissions = (TaxInvoicePermissions.MANAGE_TAXINVOICE,)
        error_type_class = TaxInvoiceError
        error_type_field = "tax_invoice_errors"

    @classmethod
    def validate_is_b2b(cls, tax_invoice_list):
        invalid_list = [line for line in tax_invoice_list if line.is_b2b == False]
        if invalid_list:
            invalid_codes = ", ".join([line.id for line in invalid_list])
            raise ValidationError(
                f"b2b 용 세금계산서만 수기 발행 신청할 수 있습니다. {invalid_codes}"
            )

    @classmethod
    def validate_values(cls, details):
        for detail in details:
            total_amount = detail.get("total_amount")
            if total_amount is None or total_amount <= 0:
                raise ValidationError("세금계산서 발행금액은 0보다 큰 값만 허용합니다.")

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        tax_invoice_dict, tax_invoice_list = validate_tax_invoice_list(details)
        cls.validate_is_b2b(tax_invoice_list)
        cls.validate_values(details)
        return details, tax_invoice_dict, tax_invoice_list

    @classmethod
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        details, tax_invoice_dict, _ = cls.clean_details(info=info, input_data=input_data)
        update_list = []
        for detail in details:
            gid = detail.get("id")
            tax_invoice = tax_invoice_dict[gid]
            write_date = detail.get("write_date")
            total_amount = detail.get("total_amount")
            tax_invoice.status = TaxInvoiceStatus.OFFLINE_ISSUED
            tax_invoice.write_date = write_date
            tax_invoice.total_amount = total_amount
            tax_invoice.is_modified = total_amount != tax_invoice.origin_amount
            update_list.append(tax_invoice)

        if update_list:
            models.TaxInvoice.objects.bulk_update(
                update_list, ["status", "write_date", "total_amount"]
            )

        return TaxInvoiceBulkOfflineIssue(tax_invoice_list=update_list)
