import graphene
from django.db.models import F, QuerySet

from ..core.types import SortInputObjectType


class PurchaseOrderSortField(graphene.Enum):
    PURCHASE_ORDER = ["pk"]
    VENDOR_CODE = ["vendor__pk", "pk"]
    VENDOR_NAME = ["vendor__name", "pk"]

    @property
    def description(self):
        if self.name in PurchaseOrderSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort orders by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_vendor_code(qs: QuerySet) -> QuerySet:
        return qs.select_related("vendor")

    @staticmethod
    def qs_with_vendor_name(qs: QuerySet) -> QuerySet:
        return qs.select_related("vendor")


class PurchaseOrderSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = PurchaseOrderSortField
        type_name = "purchase_orders"


class PurchaseOrderLineSortField(graphene.Enum):
    PO_LINE_NO = ["po_line_no", "pk"]
    PO_DATE = ["purchase_order__purchase_order_date", "pk"]
    EXPECTED_PURCHASE_DATE = ["expected_purchase_date", "pk"]

    @property
    def description(self):
        if self.name in PurchaseOrderLineSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Sort orders by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_po_line_no(qs: QuerySet) -> QuerySet:
        max_sort_order = 1000
        return qs.annotate(
            po_line_no=F("purchase_order_id") * max_sort_order
            + max_sort_order
            - (F("sort_order") + 1)
        )

    @staticmethod
    def qs_with_po_date(qs: QuerySet) -> QuerySet:
        return qs.select_related("purchase_order")


class PurchaseOrderLineSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = PurchaseOrderLineSortField
        type_name = "purchase_order_lines"
