import os
import traceback


def format_traceback_with_short_filenames(tb, n=5):
    formatted_tb_lines = traceback.format_tb(tb)
    short_tb_lines = []
    for line in formatted_tb_lines:
        parts = line.split(", ")
        if len(parts) >= 2:
            file_part = parts[0]  # e.g., '  File "/path/to/file.py", line 10'
            file_path = file_part.split('"')[1]  # e.g., '/path/to/file.py'
            short_file_name = os.path.basename(file_path)  # e.g., 'file.py'
            short_file_part = file_part.replace(file_path, short_file_name)
            parts[0] = f"== {short_file_part}"
            short_tb_lines.append(", ".join(parts))
        else:
            short_tb_lines.append(f"== {line}")
    return "".join(short_tb_lines[-n:])
