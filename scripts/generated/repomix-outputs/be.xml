    def filter_required_exp_date_mgmt(qs, _, value):
        if value is not None:
            qs = qs.filter(required_exp_date_mgmt=value)
        return qs

    def filter_need_to_stock_exists(qs, _, value):
        qs = qs.annotate(
            need_to_stock_exists=Exists(
                PurchaseOrderLine.objects.filter(
                    variant=OuterRef("pk"),
                    status__in=STOCKABLE_STATUSES,
                    purchase_order__is_sent=True,
                    purchase_order__event_type__in=STOCKABLE_PO_EVENT_TYPES,
                    purchase_order__is_not_orderable_before_stocked=False,
                )
            )
        )
        if value is True:
            qs = qs.filter(need_to_stock_exists=True)
        elif value is False:
            qs = qs.filter(need_to_stock_exists=False)
        return qs

    def filter_need_to_stock_date_range(qs, _, value):
        qs = qs.annotate(
            need_to_stock_exists=Exists(
                PurchaseOrderLine.objects.filter(
                    variant=OuterRef("pk"),
