# ExtendedCheckoutComplete 내부 호출 용도로만 사용: 프론트엔드에서 단독 호출 금지
class CheckoutPickingOrderUpdate(BaseMutation):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        input = PickingOrderInput(
            required=True, description="이너박스가 포함된 체크아웃 정보를 업데이트한다."
        )

    class Meta:
        description = "합포장 주문 박스별 이너 상품 정보와 합포장 배송비를 checkout에 반영"
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @classmethod
    def validate_picking_order_delivery_fee(
        cls, box_spec: BoxSpecForPickingOrder, picking_info, picking_order_delivery_fee
    ):
        box_count = len(picking_info["boxes"])
        calc_delivery_fee = box_count * (box_spec.delivery_fee + box_spec.box_price)
        if not picking_info["isPickingOrderDeliveryFeeFree"]:
            if calc_delivery_fee != picking_order_delivery_fee:
                raise ValidationError(
                    f"합포장 정보에 오류가 있습니다. 합포장 배송비: {picking_order_delivery_fee} != {calc_delivery_fee}"
                )

    @classmethod
    def validate_picking_order_volumn_threshold(
        cls,
        box_spec: BoxSpecForPickingOrder,
        inner_checkout_lines: List[CheckoutLineModel],
        picking_info,
    ):
        outer_volumn_threshold = (
            box_spec.length * box_spec.width * box_spec.height * box_spec.threshold / 100
        )
        for obj in picking_info["boxes"]:
            line_volumn = 0
            for line in obj["lines"]:
                sku = line["sku"]
                checkout_line = next(
                    (x for x in inner_checkout_lines if x.variant.sku == sku), None
                )
                variant: ProductVariantModel = checkout_line.variant
                inner_line_volumn = variant.box_length * variant.box_width * variant.box_height
                line_volumn += inner_line_volumn * line["quantity"]
            if line_volumn > outer_volumn_threshold:
                index = obj["index"]
                raise ValidationError(
                    f"합포장 정보에 오류가 있습니다. 박스별 이너 상품의 부피가 기준치를 초과했습니다. {index}번 박스: {line_volumn} > {outer_volumn_threshold}"
                )

    @classmethod
    def validate_checkout_line(
        cls, inner_checkout_lines: List[CheckoutLineModel], checkout_line: CheckoutLineModel
    ):
        if checkout_line not in inner_checkout_lines:
            raise ValidationError(
                "합포장 정보에 오류가 있습니다. 합포장 배송비 지정을 위한 주문 상품 지정 오류입니다."
            )

    @classmethod
    def validate_picking_info(cls, inner_checkout_lines: List[CheckoutLineModel], picking_info):
        merged_lines = defaultdict(int)

        for obj in picking_info["boxes"]:
            for line in obj["lines"]:
                sku = line["sku"]
                quantity = line["quantity"]
                merged_lines[sku] += quantity

        for inner_checkout_line in inner_checkout_lines:
            sku = inner_checkout_line.variant.sku
            if sku not in merged_lines:
                raise ValidationError("합포장 정보에 오류가 있습니다. 제품코드: {sku}")
            if merged_lines[sku] != inner_checkout_line.quantity:
                raise ValidationError(
                    "합포장 정보에 오류가 있습니다. {sku} 수량: {merged_lines[sku]} != {inner_checkout_line.quantity}"
                )

        total_quantity_of_merged_lines = sum(merged_lines.values())
        total_quantity_of_checkout_lines = sum(line.quantity for line in inner_checkout_lines)
        if total_quantity_of_merged_lines != total_quantity_of_checkout_lines:
            raise ValidationError(
                "합포장 정보에 오류가 있습니다. 합포장 수량: {total_quantity_of_merged_lines} != {total_quantity_of_checkout_lines}"
            )

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        checkout_id = input_data.get("checkout_id")
        picking_info = input_data.get("picking_info")
        checkout_line_id = input_data.get("checkout_line_id")
        picking_order_delivery_fee = input_data.get("picking_order_delivery_fee")

        box_spec = BoxSpecForPickingOrder.objects.first()
        if box_spec is None:
            raise ValidationError("합포장 박스 정보가 없습니다. 관리자에게 문의하세요.")

        cls.validate_picking_order_delivery_fee(box_spec, picking_info, picking_order_delivery_fee)

        checkout: CheckoutModel = cls.get_node_or_error(info, checkout_id, only_type=Checkout)
        checkout_line: CheckoutLineModel = cls.get_node_or_error(
            info, checkout_line_id, only_type=CheckoutLine
        )

        inner_checkout_lines_qs = checkout.lines.select_related(
            "variant",
        ).filter(is_selected=True, variant__outer__isnull=False)
        inner_checkout_lines: List[CheckoutLineModel] = list(inner_checkout_lines_qs)

        cls.validate_checkout_line(inner_checkout_lines, checkout_line)
        cls.validate_picking_info(inner_checkout_lines, picking_info)
        cls.validate_picking_order_volumn_threshold(box_spec, inner_checkout_lines, picking_info)

        checkout.picking_info = picking_info
        checkout.save(update_fields=["picking_info"])

        # 지정한 체크아웃라인에 합포장 배송비 전액 반영
        checkout_line.etc_delivery_fee = F("etc_delivery_fee") + picking_order_delivery_fee
        checkout_line.save(update_fields=["etc_delivery_fee"])

        return CheckoutPickingOrderUpdate(checkout=checkout)


