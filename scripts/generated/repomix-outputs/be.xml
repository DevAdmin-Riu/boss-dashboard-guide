def handle_process_payment_redirect(user_agent):
    server_mode = settings.SERVER_MODE
    server_mode_enum = ServerModeEnum(server_mode)
    if is_prod_server_mode(server_mode_enum):
        logger.info(f"payment_debug: handle_process_payment_redirect {server_mode_enum}")
        return HttpResponse(
            """
            <meta http-equiv="refresh" content="0;url=https://pojangboss.com/process-payment/" />
            """
        )
    if is_stage_server_mode(server_mode_enum):
        logger.info(f"payment_debug: handle_process_payment_redirect {server_mode_enum}")
        return HttpResponse(
            """
            <meta http-equiv="refresh" content="0;url=https://stage.pojangboss.com/process-payment/" />
            """
        )
    if is_local_server_mode(server_mode_enum):
        android_emulator = "ReactNativeWebViewAndroidEmulator" in user_agent
        if android_emulator:
            logger.info(
                f"payment_debug: handle_process_payment_redirect {server_mode_enum} android_emulator mode."
            )
