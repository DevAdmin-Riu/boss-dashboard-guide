            inner_variant.sales_status = sales_status
            update_fields.append("sales_status")
            # 제품 상태를 정상으로 변경할 때 판매개시일이 null 이면 현재 날짜를 판매개시일로 처리
            if (
                inner_variant.first_available_for_purchase is None
