def annotate_bpv_riu_unit_profit(qs):
    qs = qs.annotate(
        # 매장판매가
        bpv_mall_price_exclude_vat=F("price_amount") - F("price_vat"),
        # 브랜드판매가
        bpv_price_exclude_vat=F("cost_price_exclude_vat") + Round(F("delivery_fee_amount") / 1.1),
        pv_cost_price_exclude_vat=F("product_variant__cost_price_exclude_vat"),
        # 공급원가
        pv_price_exclude_vat=Case(
            When(
                product_variant__outer_id__isnull=False,
                then=F("pv_cost_price_exclude_vat")
                + Round(F("product_variant__inner_incidental_cost_amount") / 1.1),
            ),
            When(
                Q(product_variant__track_inventory=True)
                & Q(product_variant__product__is_fulfilled_by_vendor=True),
                then=F("pv_cost_price_exclude_vat"),
            ),
            When(
                Q(product_variant__track_inventory=True)
                & Q(product_variant__product__is_fulfilled_by_vendor=False),
                then=F("pv_cost_price_exclude_vat")
                + Round(F("product_variant__delivery_fee_amount") / 1.1),
            ),
            default=F("product_variant__consignment_cost_price_exclude_vat")
            + Round(F("product_variant__consignment_delivery_fee_amount") / 1.1),
        ),
    )
    qs = qs.annotate(
        riu_unit_profit=Case(
            # contract_type == MILEAGE 일 때
            # (매장 판매가 - (공급원가 + (매장 판매가 - 브랜드 판매가) × 적립율(%))
            When(
                brand__contract_type=BrandContractType.MILEAGE,
                then=(
                    (
                        F("bpv_mall_price_exclude_vat")
                        - (
                            F("pv_price_exclude_vat")
                            + Round(
                                (F("bpv_mall_price_exclude_vat") - F("bpv_price_exclude_vat"))
                                * F("brand__mileage_rate")
                                / 100.0
                            )
                        )
                    )
                ),
            ),
            # 그 외의 경우
            # 브랜드 판매가 - 공급원가
            default=F("bpv_price_exclude_vat") - F("pv_price_exclude_vat"),
        )
    )
    return qs


class BrandProductVariantFilter(django_filters.FilterSet):
    def filter_bp_sku_list(qs, _, value):
        return qs.filter(bp_sku__in=value)

    def filter_brand_product_variant_price(qs, _, value):
        price_lte = value.get("lte")
        price_gte = value.get("gte")
        if price_lte:
            qs = qs.filter(price_amount__lte=price_lte)
        if price_gte:
            qs = qs.filter(price_amount__gte=price_gte)

        return qs

    def filter_riu_minus_profit(qs, _, value):
        if value == True:
            qs = annotate_bpv_riu_unit_profit(qs)
            qs = qs.filter(riu_unit_profit__lt=0)
        return qs

    def filter_brand_product_variant_available_quantity(qs, _, value):
        available_quantity_lte = value.get("lte")
        available_quantity_gte = value.get("gte")

        if available_quantity_lte or available_quantity_gte:
            qs = (
                qs.annotate(
                    total_quantity_allocated=Coalesce(
                        Sum("product_variant__stocks__allocations__quantity_allocated"),
                        0,
                    )
                )
                .annotate(total_quantity=Coalesce(Sum("product_variant__stocks__quantity"), 0))
                .annotate(total_available=F("total_quantity") - F("total_quantity_allocated"))
            )

            if available_quantity_lte:
                qs = qs.filter(total_available__lte=available_quantity_lte)
            if available_quantity_gte:
                qs = qs.filter(total_available__gte=available_quantity_gte)

        return qs

    def filter_brand_product_exclusive(qs, _, value):
        if value is not None:
            qs = qs.filter(brand_product__is_exclusive=value)
        return qs

    def filter_product_exclusive(qs, _, value):
        if value is not None:
            qs = qs.filter(brand_product__product__is_exclusive=value)
        return qs

    def filter_is_inner(qs, _, value):
        if value == True:
            qs = qs.filter(product_variant__outer__isnull=False)
        if value == False:
            qs = qs.filter(product_variant__outer__isnull=True)
        return qs

    def filter_is_only_payable_by_cash(qs, _, value):
        if value is not None:
            qs = qs.filter(brand_product__is_only_payable_by_cash=value)
        return qs

    def filter_include_sales_b2b_delivery_fee(qs, _, value):
        if value is not None:
            qs = qs.filter(include_sales_b2b_delivery_fee=value)
        return qs

    def filter_is_fulfilled_by_vendor(qs, _, value):
        if value is not None:
            qs = qs.filter(brand_product__product__is_fulfilled_by_vendor=value)
        return qs

    def filter_category_kind(qs, _, value):
        if value:
            qs = qs.filter(brand_product__product__category__kind__in=value)
        return qs

    def filter_brand_product_search(qs, _, value):
        search_fields = ["bp_sku", "brand_product__name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_product_search(qs, _, value):
        search_fields = ["product_variant__sku", "brand_product__product__name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_pv_sales_status(qs, _, value):
        if value:
            return qs.filter(product_variant__sales_status__in=value)
        return qs

    def filter_exclude_pv_sales_status_stopped(qs, _, value):
        if value:
            return qs.exclude(product_variant__sales_status=SalesStatus.STOPPED)
        return qs

    def filter_bpv_sales_status(qs, _, value):
        if value:
            return qs.filter(sales_status__in=value)
        return qs

    def filter_pv_stopped_range(qs, _, value):
        if value:
            qs = qs.filter(product_variant__sales_status=SalesStatusEnum.STOPPED)
        return filter_range_field(qs, "product_variant__stopped_at", value)

    def filter_first_sale_range(qs, _, value):
        return filter_range_field(qs, "product_variant__first_available_for_purchase", value)

    def filter_stock_shortage_status(qs, _, value):
        if value:
            cutoff_date = kst_timezone_date() - timedelta(days=90)

            qs = qs.annotate(
                total_quantity=Coalesce(Sum("product_variant__stocks__quantity"), 0)
            ).annotate(
                estimate_shortage=Case(
                    When(
                        total_quantity__lte=0,
                        then=Value(0),
                    ),
                    When(
                        product_variant__last_3_months_avg_sales_daily_qty__lte=0,
                        then=Value(sys.maxsize),
                    ),
                    default=Func(
                        F("total_quantity")
                        / F("product_variant__last_3_months_avg_sales_daily_qty"),
                        function="ROUND",
                        template="%(function)s(COALESCE(NULLIF(%(expressions)s, 0), NULL), 1)",
                    ),
                ),
                is_newly_launched=Case(
                    When(
                        product_variant__first_available_for_purchase__gt=cutoff_date,
                        then=Value(True),
                    ),
                    default=Value(False),
                    output_field=BooleanField(),
                ),
            )

            qs = qs.exclude(estimate_shortage__isnull=True)

            filters = Q()
            if StockStatusByEstShortage.NORMAL in value:
                filters |= Q(is_newly_launched=True)
                filters |= Q(
                    is_newly_launched=False,
                    estimate_shortage__lt=StockStatusThresholdPyEnum.NORMAL.value,
                )
            if StockStatusByEstShortage.SLOW_CYCLE in value:
                filters |= Q(
                    is_newly_launched=False,
                    estimate_shortage__gte=StockStatusThresholdPyEnum.NORMAL.value,
                    estimate_shortage__lt=StockStatusThresholdPyEnum.SLOW_CYCLE.value,
                )
            if StockStatusByEstShortage.WARNING in value:
                filters |= Q(
                    is_newly_launched=False,
                    estimate_shortage__gte=StockStatusThresholdPyEnum.SLOW_CYCLE.value,
                    estimate_shortage__lt=StockStatusThresholdPyEnum.WARNING.value,
                )
            if StockStatusByEstShortage.CRITICAL in value:
                filters |= Q(
                    is_newly_launched=False,
                    estimate_shortage__gte=StockStatusThresholdPyEnum.WARNING.value,
                )
            qs = qs.filter(filters)
        return qs

    def filter_categories(qs, _, value):
        if value:
            categories = get_nodes(value, "Category", Category)
            qs = filter_brand_product_variants_by_categories(qs, categories)
        return qs

    def filter_brand_search(qs, _, value):
        if value:
            search_fields = [
                "brand__name",
                "brand__code",
            ]
            qs = filter_by_query_param(qs, value, search_fields)
        return qs.distinct()

    def filter_vendor_search(qs, _, value):
        return filter_vendor_search_factory(
            field_name="product_variant__default_variant_vendor__vendor_id",
            search_fields=["product_variant__default_variant_vendor__vendor__name"],
        )(qs, _, value)

    def filter_external_product_search(qs, _, value):
