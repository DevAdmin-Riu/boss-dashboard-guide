            raise PermissionDenied(user=context.user, cls=cls)
        return True


class BsTrainingDocInput(graphene.InputObjectType):
    owner_brand = graphene.ID(required=True, description="교육자료 소속 브랜드 ID")
    type = BsTrainingDocTypeEnum(required=True, description="교육자료 타입")
    tags = graphene.List(graphene.ID, description="교육자료 태그 Ids")
    title = graphene.String(description="BsTrainingDoc title.")
    content = graphene.JSONString(description="BsTrainingDoc content.")
    is_published = graphene.Boolean(
        description="Determines if notice is visible in the storefront."
    )
    publication_date = graphene.String(description="Publication date. ISO 8601 standard.")


class BsTrainingDocCreate(ModelMutation):
    class Arguments:
        input = BsTrainingDocInput(required=True, description="교육자료 생성 입력")

    class Meta:
        description = "교육자료 생성"
        model = models.BsTrainingDoc
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        cleaned_input["writer"] = info.context.user
        is_published = cleaned_input.get("is_published")
        publication_date = cleaned_input.get("publication_date")
        if is_published and not publication_date:
            cleaned_input["publication_date"] = date.today()
        if publication_date == "":
            cleaned_input["publication_date"] = None

        # 기존 최초 공개일 값 임시 저장 - post_save_action에서 푸시 알림 전송을 위한 비교용
        if instance and instance.pk:
            cleaned_input["_old_first_published_at"] = instance.first_published_at
        else:
            cleaned_input["_old_first_published_at"] = None

        return cleaned_input

    @classmethod
    def check_permissions(cls, context, **data):
        if context.user.is_staff:
            if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
                return True
            else:
                return False

        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        if cls == BsTrainingDocCreate:
            writer_global_brand_id = data["input"]["owner_brand"]
            _, owner_brand_id = graphene.Node.from_global_id(writer_global_brand_id)
            if not (owner_brand_id == str(brand_id) and is_active and is_hq_staff):
                raise PermissionDenied(user=context.user, cls=cls)
            return True

        if cls.__name__ in ["BsTrainingDocUpdate"]:
            id = data["id"]
            _, doc_pk = graphene.Node.from_global_id(id)
            bs_training_doc = models.BsTrainingDoc.objects.get(pk=doc_pk)
            if not (bs_training_doc.owner_brand_id == brand_id and is_active and is_hq_staff):
                raise PermissionDenied(user=context.user, cls=cls)
            return True

    @classmethod
    def post_save_action(cls, info, instance, cleaned_input):
        old_first_published_at = cleaned_input.get("_old_first_published_at")
        new_first_published_at = instance.first_published_at
        if old_first_published_at != new_first_published_at:
            transaction.on_commit(
                lambda: send_push_notification_on_bs_training_doc_published(info, instance)
            )


class BsTrainingDocUpdate(BsTrainingDocCreate):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a bs_training_doc to update.")
        input = BsTrainingDocInput(
            required=True, description="Fields required to update a bs_training_doc."
        )

    class Meta:
        description = "Updates an existing bs_training_doc."
