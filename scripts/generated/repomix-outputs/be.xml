    @staticmethod
    def get_trunc_function(mode):
        if mode == StatReportingMode.DAILY:
            return TruncDay
        elif mode == StatReportingMode.WEEKLY:
            return TruncWeek
        elif mode == StatReportingMode.MONTHLY:
            return TruncMonth
        elif mode == StatReportingMode.TWICE_PER_MONTH:
            return TruncTwicePerMonth
        else:
            raise ValidationError(f"지원하지 않는 통계 모드: {mode}")

    # 전용 상품 재고 관련 헬퍼
    @staticmethod
    def get_exclusive_bpv_qs(brand_ids=None):
        """
