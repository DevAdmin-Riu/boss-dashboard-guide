)
from saleor.graphql.core.types.common import AccountError
from saleor.graphql.core.utils import validate_image_file

from ...core.mutations import BaseMutation

if TYPE_CHECKING:
    from saleor.account.models import DirectShippingImage as DirectShippingImageModel


class DirectShippingImageCreate(BaseMutation):
    image = graphene.Field(DirectShippingImage)

    class Arguments:
        input = DirectShippingImageCreateInput(
            required=True, description="신규 추가할 직배송 상세 이미지"
        )

    class Meta:
        description = "Create a direct shipping image."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def create_image(cls, info, direct_shipping_detail, input_data):
        type = input_data.get("type")
        image_data = info.context.FILES.get(input_data["image"])
        description = input_data.get("description", "")
        validate_image_file(image_data, "image")
        image = direct_shipping_detail.images.create(
            image=image_data, description=description, type=type
        )

        create_direct_shipping_image_thumbnails.delay(image.pk)

        return image

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        direct_shipping_detail = cls.get_node_or_error(
            info,
            input_data["direct_shipping_detail"],
            field="direct_shipping_detail",
            only_type=DirectShippingDetail,
        )
        image = cls.create_image(info, direct_shipping_detail, input_data)

