import logging
import traceback
from decimal import Decimal
from typing import Optional

from django.conf import settings
from django.db import transaction

from ...account import BrandReverseFeeDepositEventType
from ...account.models import Brand, User
from ...checkout.complete_checkout import complete_checkout
from ...checkout.models import Checkout
from ...checkout.utils import get_delivery_box_count_of_non_fbv_order_lines
from ...core.utils.kst_time import to_kst_timezone_format
from ...core.utils.str_utils import to_locale_number
from ...order import OrderStatus, OrderType
from ...order.emails import send_payment_fail_email
from ...order.events import external_notification_event, send_kakaotalk_to_customer_on_order
from ...order.models import Order
from ...points import CreditsEventType, CreditsEventViewMode, PointsEventType
from ...points.actions import create_credits_event
from .. import ChargeStatus, TransactionKind
from ..interface import BrandPaymentValues
from ..models import Payment, Transaction
from ..utils import post_captured
from .utils import (
    calc_brand_payment_values,
    calc_paying_charge_exclude_vat,
    get_plugin_configs_by_payment,
    is_card_pay,
    is_deferred_pay,
    is_points_only_pay,
    is_vbank_pay,
    make_combine_pay_method_text,
    make_order_events_message,
    sum_of_reverse_fee_deposit_items,
)

logger = logging.getLogger(__name__)


def get_checkout(payment: "Payment") -> Optional[Checkout]:
    if not payment.checkout:
        return None
    # Lock checkout in the same way as in checkoutComplete
    return (
        Checkout.objects.select_for_update(of=("self",))
        .prefetch_related(
            "lines__variant__product",
            "lines__brand_product_variant__brand",
        )
        .filter(pk=payment.checkout.pk)
        .first()
    )


def _decrease_user_credits_and_rcoins(payment: Payment, points_event_type: PointsEventType):
    # 가상계좌도 주문 시점에 충전금, 포인트 차감
    order: Order = payment.order
    user: User = order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
    if user:
        combined_pay_method = make_combine_pay_method_text(payment)
        event_desc = (
            f"주문번호:{payment.order.composed_id_with_prefix} 결제방식:{combined_pay_method}"
        )
        total_credits = (payment.cashable_credits or 0) + (payment.non_cashable_credits or 0)
        if total_credits > 0:
            qty_before = user.credits_incl_non_cashable
            qty_after = qty_before - total_credits
            create_credits_event(
                total_before=qty_before,
                total_after=qty_after,
                qty_before=qty_before,
                qty_after=qty_after,
                qty=total_credits,
                type=points_event_type,
                user=user,
                staff=None,
                description=event_desc,
                view_mode=CreditsEventViewMode.ONLY_MALL,
                # ONLY_MALL view_mode 에서 is_cashable 은 통합금액 이벤트이므로 무의미함
                is_cashable=True,
            )

        if payment.cashable_credits is not None and payment.cashable_credits > 0:
            user.decrease_cashable_credits(
                payment.cashable_credits,
                points_event_type,
                event_desc,
                staff=None,
                event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
                allow_minus=True,
            )
        if payment.non_cashable_credits is not None and payment.non_cashable_credits > 0:
            user.decrease_non_cashable_credits(
                payment.non_cashable_credits,
                points_event_type,
                event_desc,
                staff=None,
                event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
            )
        if payment.rcoins is not None and payment.rcoins > 0:
            user.decrease_rcoins(payment.rcoins, points_event_type, event_desc, staff=None)


def _process_auth_completed_clean_pay_method(
    pay_method: str,
):
    return (
        is_card_pay(pay_method)
        or is_vbank_pay(pay_method)
        or is_points_only_pay(pay_method)
        or is_deferred_pay(pay_method)
    )


def _process_auth_completed_update_payment(
    payment: Payment,
    pay_method: str,
):
    # 결제 방법이 세팅이 된 후 calc_brand_payment_values 호출 필요함
    payment.token = pay_method
    if is_card_pay(pay_method) or is_points_only_pay(pay_method) or is_deferred_pay(pay_method):
        charge_status = (
            ChargeStatus.PENDING
            if (
                is_deferred_pay(pay_method)
                and payment.checkout.order_type in [OrderType.BY_STAFF_FOR_BRAND]
            )
            else ChargeStatus.FULLY_CHARGED
        )
        payment.captured_amount = payment.amount
        payment.captured_cashable_credits = payment.cashable_credits
        payment.captured_non_cashable_credits = payment.non_cashable_credits
        payment.captured_rcoins = payment.rcoins
    elif is_vbank_pay(pay_method):
        charge_status = ChargeStatus.PENDING
        payment.captured_cashable_credits = payment.cashable_credits
        payment.captured_non_cashable_credits = payment.non_cashable_credits
        payment.captured_rcoins = payment.rcoins

    checkout = get_checkout(payment)
    brand: Brand = checkout.user.brand if checkout.user else None
    is_reverse_fee_contract_type = brand and brand.is_reverse_fee_contract_type

    # 본부수익금 계산식에 payment.captured_rcoins 값이 이용되므로 값 세팅 후 세팅된 payment 를 전달해서 계산 필요함
    brand_payment_values_for_not_fbv: BrandPaymentValues = calc_brand_payment_values(
        checkout=checkout, payment=payment, is_fbv=False
    )
    brand_payment_values_for_fbv: BrandPaymentValues = calc_brand_payment_values(
        checkout=checkout, payment=payment, is_fbv=True
    )
    # 더하기는 BrandPaymentValues 정의하는 곳에 처리되어 있음.
    brand_payment_values = (
        brand_payment_values_for_not_fbv + brand_payment_values_for_fbv
        if not (brand_payment_values_for_not_fbv is None and brand_payment_values_for_fbv is None)
        else None
    )

    payment.brand_paying_charge_exclude_vat = (
        brand_payment_values.brand_paying_charge_exclude_vat if brand_payment_values else 0
    )
    # 매출인식몰인 경우에는 브랜드정보의 결제수수료율로 계산된 payment.brand_paying_charge_exclude_vat 값으로 실제 paying_charge_exclude_vat를 세팅하면됨
    if is_reverse_fee_contract_type:
        paying_charge_exclude_vat = payment.brand_paying_charge_exclude_vat
    elif is_points_only_pay(pay_method) or is_deferred_pay(pay_method):
        paying_charge_exclude_vat = 0
    else:
        plugin_configs = get_plugin_configs_by_payment(payment)
        is_toss_riu_pay = payment.is_toss_riu_pay
        card_paying_charge_rate = (
            Decimal(plugin_configs.bp_card_paying_charge_rate)
            if is_toss_riu_pay
            else Decimal(plugin_configs.card_paying_charge_rate)
        )
        paying_charge_exclude_vat = calc_paying_charge_exclude_vat(
            pay_method,
            payment.amount,
            card_paying_charge_rate,
            Decimal(plugin_configs.vbank_paying_charge_exclude_vat),
        )

    payment.paying_charge_exclude_vat = paying_charge_exclude_vat
    payment.final_paying_charge_exclude_vat = payment.paying_charge_exclude_vat
    payment.final_brand_paying_charge_exclude_vat = payment.brand_paying_charge_exclude_vat
    payment.charge_status = charge_status
    payment.save()

    logger.info(f"payment_debug: _process_auth_completed_update_payment {payment} {charge_status}")


def _process_auth_completed_create_transaction(
    payment: Payment,
    pay_method: str,
    gateway_response,
) -> Transaction:
    order_type = payment.checkout.order_type
    if (
        is_card_pay(pay_method)
        or is_points_only_pay(pay_method)
        or (
            is_deferred_pay(pay_method)
            and order_type
            in [OrderType.BY_STAFF_FOR_BAD_STOCK, OrderType.BY_STAFF_FOR_ETC, OrderType.BY_USER]
        )
    ):
        kind = TransactionKind.CAPTURE
    else:
        kind = TransactionKind.ACTION_TO_CONFIRM

    txn = Transaction.objects.create(
        payment=payment,
        token=pay_method,
        kind=kind,
        is_success=True,
        amount=payment.amount,
        cashable_credits=payment.cashable_credits,
        non_cashable_credits=payment.non_cashable_credits,
        rcoins=payment.rcoins,
        currency=settings.DEFAULT_CURRENCY,
        gateway_response=gateway_response,
        # 신규 생성 Transaction은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
        is_converted=True,
    )

    return txn


def _process_auth_completed_create_order(
    payment: Payment,
    creator_user: "User" = None,
) -> Order:
    try:
        checkout = get_checkout(payment)
        order = complete_checkout(
            payment=payment,
            checkout=checkout,
            creator_user=creator_user,
        )
    except Exception as e:
        logger.warn(f"_process_auth_completed_create_order exception: {e}")
        raise
    # Refresh the payment to assign the newly created order
    payment.refresh_from_db()
    return order


def _process_auth_completed_decrease_points(
    payment: Payment,
    pay_method: str,
    order: Order,
):
    if is_card_pay(pay_method):
        points_event_type = PointsEventType.CARD_PAYMENT
    elif is_vbank_pay(pay_method):
        points_event_type = PointsEventType.VBANK_PAYMENT
    elif is_points_only_pay(pay_method):
        points_event_type = PointsEventType.POINTS_PAYMENT
    elif is_deferred_pay(pay_method):
        points_event_type = PointsEventType.DEFERRED_PAYMENT

    logger.info(
        f"payment_debug: _process_auth_completed_decrease_points if used {payment} {points_event_type}"
    )

    # 가상 계좌 혼합 결제는 PENDING 상태에서 차감함. 가상계좌 입금 안해서 주문 취소 되면 자동 환불 됨
    _decrease_user_credits_and_rcoins(payment, points_event_type)

    # 브랜드가 매출인식몰 계약타입 인경우 선결제금에서 계약단가총액 차감.
    brand: Brand = order.brand
    # 매출인식 브랜드 가맹본부 대행주문은 고려안함
    user: User = order.user
    non_fbv_delivery_box_count = get_delivery_box_count_of_non_fbv_order_lines(order)
    # 기타배송비항목(화물차, 소분비용)은 첫번째 line 에 모두 세팅되어서, 직거래 제품에 값이 세팅될 수도 있는 관계로 모든 라인 sum 으로 처리 필요
    total_etc_delivery_fee = order.total_etc_delivery_fee
    # 차감 항목 요소 변경 시 CheckoutPaymentCreate.validate_reverse_fee_deposit 도 같이 고려되어야 함
    decrease_deposit_amount = sum_of_reverse_fee_deposit_items(
        non_fbv_total_brand_cost=order.brand_total_cost_price_amount_not_fbv,
        non_fbv_subtotal_delivery_additional_fee=order.unit_delivery_additional_fee
        * non_fbv_delivery_box_count,
        total_etc_delivery_fee=total_etc_delivery_fee,
    )
    if brand and brand.is_reverse_fee_contract_type and decrease_deposit_amount > 0:
        brand.decrease_reverse_fee_deposit(
            reverse_fee_deposit_amount=decrease_deposit_amount,
            event_type=BrandReverseFeeDepositEventType.ORDER,
            description=f"주문번호:{order.composed_id_with_prefix} ({points_event_type})",
            user=user,
        )
        if order.total_captured_rcoins > 0:
            brand.increase_reverse_fee_deposit(
                reverse_fee_deposit_amount=order.total_captured_rcoins,
                event_type=BrandReverseFeeDepositEventType.INCREASE_BY_RCOINS,
                description=f"주문번호:{order.composed_id_with_prefix} ({points_event_type})",
                user=user,
            )


def _process_auth_completed_add_order_event(
    payment: Payment,
    pay_method: str,
    success_msg,
    is_mobile: Optional[bool],
):
    message = make_order_events_message(
        is_success=True,
        success_msg=success_msg,
        failed_msg=None,
        pay_method=pay_method,
        payment=payment,
        is_mobile=is_mobile,
    )
    external_notification_event(
        order=payment.order,
        user=None,
        message=message,
        parameters={
            "service": payment.gateway,
            "method": payment.token,
            "mobile": is_mobile if is_mobile is not None else "-",
        },
    )
    logger.info(f"payment_debug: _process_auth_completed_add_order_event {payment} {message}")


def _process_auth_completed_credits_refill_fully_charged(
    order: Order, payment: Payment, user: User
):
    if payment.charge_status == ChargeStatus.FULLY_CHARGED:
        user.increase_cashable_credits(
            payment.amount,
            CreditsEventType.RECHARGE,
            f"주문번호:{order.composed_id_with_prefix} 충전금용 상품 결제로 인한 충전",
            staff=None,
            event_view_mode=CreditsEventViewMode.ALL,
        )
        order.status = OrderStatus.FULFILLED
        order.save(update_fields=["status"])
        # order의 모든 line들에 대해서 quantity_fulfilled를 quantity로 세팅한다(즉 모두 출고됐다고 간주)
        for line in order.lines.all():
            line.quantity_fulfilled = line.quantity
            line.save(update_fields=["quantity_fulfilled"])


def _process_auth_completed_credits_refill_set_order(order: Order):
    order.is_for_credits_refill = True
    order.save(update_fields=["is_for_credits_refill"])


def process_auth_completed(
    checkout: Checkout,
    payment: Payment,
    pay_method: str,
    gateway_response: dict,
    success_msg,
    is_mobile: bool,
    # 대행 주문의 경우에만 값을 받아서 처리함.
    creator_user: "User" = None,
):
    is_success = True
    failed_msg = None
    order = None

    any_is_for_credits_refill, all_is_for_credits_refill = checkout.is_for_credits_refill_checkout()

    if _process_auth_completed_clean_pay_method(pay_method) == False:
        is_success = False
        success_msg = None
        failed_msg = f"알수 없는 pay_method: {pay_method}"
        return is_success, success_msg, failed_msg, order

    # 프론트엔드에서 포인트 충전용 제품이 장바구니에 있으면 포인트, 적립금 사용 ui 를 숨김 처리하여 포인트+적립금 사용이 금지되어 있음
    # 아래의 validation 만으로는 포인트+적립금 혼합 결제 인 경우 그 사용 금액에 대한 validation 이 안되어 불완전하므로
    # 프론트엔드 제약이 없어지면 validation 로직 보완 필요하고,  validation 하는 위치도 PaymentCreate 쪽으로 이동 시키는 정리가 좋을 듯 함
    if any_is_for_credits_refill and (
        not is_vbank_pay(pay_method) or payment.credits_incl_non_cashable > 0 or payment.rcoins > 0
    ):
        is_success = False
        success_msg = None
        failed_msg = f"포인트 충전용 제품은 충전금(또는 포인트) 결제가 불가합니다."
        return is_success, success_msg, failed_msg, order

    try:
        with transaction.atomic():
            _process_auth_completed_update_payment(payment=payment, pay_method=pay_method)
            auth_completed_transaction = _process_auth_completed_create_transaction(
                payment=payment,
                pay_method=pay_method,
                gateway_response=gateway_response,
            )
            order = _process_auth_completed_create_order(payment=payment, creator_user=creator_user)

            # 포인트 충전용 제품과 일반 상품이 장바구니에 섞여 있는 것을 허용하지 않는 프론트엔드 제약이 있음(백엔드 제약도 존재함. validate_is_for_points_refill 함수)
            # 충전용 제품과 일반 상품 혼합 주문에 대한 제약이 없어질 경우 포인트 충전 처리가 안되는 버그 발생함
            if all_is_for_credits_refill:
                _process_auth_completed_credits_refill_set_order(order=order)
                _process_auth_completed_credits_refill_fully_charged(
                    order=order, payment=payment, user=checkout.user
                )
                return is_success, success_msg, failed_msg, order

            _process_auth_completed_decrease_points(
                payment=payment, pay_method=pay_method, order=order
            )

            if auth_completed_transaction.kind == TransactionKind.CAPTURE:
                post_captured(
                    payment=payment,
                    captured_transaction=auth_completed_transaction,
                    requester=creator_user,
                )

            _process_auth_completed_add_order_event(
                payment=payment,
                pay_method=pay_method,
                success_msg=success_msg,
                is_mobile=is_mobile,
            )
        transaction.on_commit(
            lambda order=order, payment=payment, pay_method=pay_method, gateway_response=gateway_response: send_kakaotalk_to_customer_on_order(
                order=order,
                payment=payment,
                pay_method=pay_method,
                gateway_response=gateway_response,
            )
        )
    except Exception as e:
        is_success = False
        success_msg = None
        failed_msg = f"_process_auth_completed Exception: {payment.id} {e}"

        from ...account.utils import format_as_numeric_only_phone_number

        user: User = checkout.user
        user_phone = format_as_numeric_only_phone_number(user.aligo_phone) if user else None
        amount = payment.total if payment else Decimal(0)
        traceback_str = traceback.format_exc()
        context = {
            "payment_id": payment.id if payment else "-",
            "payment_method": make_combine_pay_method_text(payment) if payment else "-",
            "payment_date": to_kst_timezone_format(payment.created) if payment else "-",
            "amount": to_locale_number(amount),
            "user_name": user.first_name if user else "-",
            "user_phone": user_phone if user_phone else "-",
            "error_message": f"{e}: {traceback_str}",
        }
        send_payment_fail_email(context=context)

    return is_success, success_msg, failed_msg, order
