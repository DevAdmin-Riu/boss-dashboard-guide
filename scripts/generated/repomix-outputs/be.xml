@app.task
def generate_variants_sales_on_change_exclude_stock_avg_stats(order_line_ids):
    order_lines = order_models.OrderLine.objects.select_related("order", "variant").filter(
        id__in=order_line_ids
    )
    today = kst_timezone_date()
    need_to_check_stock_ctrl_status = False
    for order_line in order_lines:
        order_captured_at = order_line.order.captured_at
        if not order_captured_at:
            continue
        variant = order_line.variant
        if not variant:
            continue

        target_date = order_captured_at.date()
        # 결제일이 오늘 보다 과거면 결제일 기준으로 일 판매량 집계를 다시 함
        if today > target_date:
            need_to_check_stock_ctrl_status = True
            target_date_range = make_target_range_for_target_date_daily_sales(target_date)
            generate_variant_sales(
                trunc_func=TruncDay, target_date_range=target_date_range, variant=variant
            )
            set_variant_last_7_days_avg_sales_daily_qty(today, variant=variant)
            set_variant_last_15_days_avg_sales_daily_qty(today, variant=variant)
            set_variant_last_30_days_avg_sales_daily_qty(today, variant=variant)
            set_variant_last_3_months_avg_sales_daily_qty(today, variant=variant)

            # 결제일이 속한 주 첫번째 날이 이번주 보다 작으면 결제일 기준 주간 판매량 집계를 다시 함
            this_week_first_day_from_today = today - timedelta(days=target_date.weekday())
            this_week_first_day_from_target_date = target_date - timedelta(
                days=target_date.weekday()
            )
            if this_week_first_day_from_today > this_week_first_day_from_target_date:
                target_date_range = make_target_range_for_this_week_weekly_sales(target_date)
                generate_variant_sales(
                    trunc_func=TruncWeek, target_date_range=target_date_range, variant=variant
                )

            # 결제월이 이번달 보다 과거면 결제일 기준으로 월 판매량 집계를 다시 함
            if today.month > target_date.month:
                target_date_range = make_target_range_for_this_month_monthly_sales(target_date)
                generate_variant_sales(
                    trunc_func=TruncMonth, target_date_range=target_date_range, variant=variant
                )
                set_variant_last_n_month_avg_sales_monthly_qty(
                    target_date=today,
                    n_month_ago=3,
                    loader_func=Last3MonthSalesByProductVariantIdLoader.load_3_month_sales,
                    update_field="last_3_months_avg_sales_monthly_qty",
                    variant=variant,
                )
                set_variant_last_n_month_avg_sales_monthly_qty(
                    target_date=today,
                    n_month_ago=2,
                    loader_func=Last2MonthSalesByProductVariantIdLoader.load_2_month_sales,
                    update_field="last_2_months_avg_sales_monthly_qty",
                    variant=variant,
                )

    if need_to_check_stock_ctrl_status:
        reset_variants_is_safety_status_and_send_alarm(True)
        check_productvariant_is_sales_surge()
        reset_variants_need_to_reorder_status_and_send_alarm()


