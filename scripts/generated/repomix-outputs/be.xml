    @transaction.atomic()
    def decrease_available_paid_notice_count(
        self,
        delta: int,
        type: "PaidNoticeCountEventType",
        description: str,
        from_user: "User",
        to_fbv_vendor: "Vendor" = None,
    ):
        if self.available_paid_notice_count < delta:
            raise ValidationError("남아 있는 유료 알림 카운트 보다 많이 차감하려고 합니다.")

        before = self.available_paid_notice_count
        after = self.available_paid_notice_count - delta
        self.available_paid_notice_count = after
        Brand.objects.filter(pk=self.pk).update(
            available_paid_notice_count=F("available_paid_notice_count") - delta
        )

        return create_available_paid_notice_count_event(
            before=before,
            after=after,
            delta=delta,
            type=type,
            brand=self,
            from_user=from_user,
            to_fbv_vendor=to_fbv_vendor,
            description=description,
        )

    @transaction.atomic()
    def increase_available_paid_notice_count(
        self, delta: int, type: "PaidNoticeCountEventType", description: str, from_user: "User"
    ):
        before = self.available_paid_notice_count
        after = self.available_paid_notice_count + delta
        self.available_paid_notice_count = after
        Brand.objects.filter(pk=self.pk).update(
            available_paid_notice_count=F("available_paid_notice_count") + delta
        )

        return create_available_paid_notice_count_event(
            before=before,
            after=after,
            delta=delta,
            type=type,
            brand=self,
            from_user=from_user,
            description=description,
        )

    @transaction.atomic()
    def decrease_available_digital_contract_count(
        self,
        delta: int,
        type: "DigitalContractCountEventType",
        description: str,
        from_user: "User",
        document_id: str = None,
        allow_minus_decrease: bool = False,
    ):
        if type == DigitalContractCountEventType.DIGITAL_CONTRACT_CREATED:
            if document_id is None:
                raise ValidationError("전자계약 문서 id 오류입니다.")
            if is_duplicate_document_id_event(document_id):
                logger.warning(f"이미 차감 처리 완료된 전자계약 생성입니다.{document_id}")
                return

        if not allow_minus_decrease and self.available_digital_contract_count < delta:
            # 수동 차감인 경우에는 minus 허용 안함
            raise ValidationError("남아 있는 전자계약 카운트 보다 많이 차감하려고 합니다.")

        before = self.available_digital_contract_count
        after = self.available_digital_contract_count - delta
        self.available_digital_contract_count = after
        Brand.objects.filter(pk=self.pk).update(
            available_digital_contract_count=F("available_digital_contract_count") - delta
        )

        return create_available_digital_contract_count_event(
            before=before,
            after=after,
            delta=delta,
            type=type,
            brand=self,
            from_user=from_user,
            description=description,
            document_id=document_id,
        )

    @transaction.atomic()
    def increase_available_digital_contract_count(
        self, delta: int, type: "DigitalContractCountEventType", description: str, from_user: "User"
    ):
        before = self.available_digital_contract_count
        after = self.available_digital_contract_count + delta
        self.available_digital_contract_count = after
        Brand.objects.filter(pk=self.pk).update(
            available_digital_contract_count=F("available_digital_contract_count") + delta
        )

        return create_available_digital_contract_count_event(
            before=before,
            after=after,
            delta=delta,
            type=type,
            brand=self,
            from_user=from_user,
            description=description,
        )

