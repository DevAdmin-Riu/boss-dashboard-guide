class ModusignTemplate(graphene.ObjectType):
    id = graphene.String()
    title = graphene.String()
    created_at = graphene.DateTime()
    updated_at = graphene.DateTime()


class ModusignTemplateList(graphene.ObjectType):
    count = graphene.Int(description="조건에 맞는 템플릿 총 개수")
    templates = graphene.List(ModusignTemplate)


class ModusignTemplateListFilterInput(graphene.InputObjectType):
    brand_code = graphene.String(required=True)
    title = graphene.String()


class ModusignDocument(graphene.ObjectType):
    id = graphene.String()
    title = graphene.String()
    status = graphene.Field(ModusignDocStatusEnum)
    started_at = graphene.DateTime()
    updated_at = graphene.DateTime()


class ModusignDocumentList(graphene.ObjectType):
    count = graphene.Int(description="조건에 맞는 문서 총 개수")
    documents = graphene.List(ModusignDocument)


class ModusignDocumentListFilterInput(graphene.InputObjectType):
    brand_code = graphene.String()
    status = graphene.Field(ModusignDocStatusEnum)
    title = graphene.String()
    startedAtGte = graphene.Date(description="Start date.(YYYY-MM-DD)")
    startedAtLte = graphene.Date(description="End date.(YYYY-MM-DD)")
    updatedAtGte = graphene.Date(description="Start date.(YYYY-MM-DD)")
    updatedAtLte = graphene.Date(description="End date.(YYYY-MM-DD)")


class ModusignQueries(graphene.ObjectType):
    modusign_template_list = graphene.Field(
        ModusignTemplateList,
        filters=graphene.Argument(ModusignTemplateListFilterInput),
        limit=graphene.Int(),
        offset=graphene.Int(),
    )
    modusign_document_list = graphene.Field(
        ModusignDocumentList,
        filters=graphene.Argument(ModusignDocumentListFilterInput),
        limit=graphene.Int(),
        offset=graphene.Int(),
    )

    def resolve_modusign_template_list(
        root, _info, filters: ModusignTemplateListFilterInput = None, limit=10, offset=0
    ):
        title = filters.title if filters else None
        brand_code = filters.brand_code if filters else None
        response, error_msg = call_modusign_view_template_list_api(
            limit=limit,
            offset=offset,
            brand_code=brand_code,
            title=title,
        )
        if error_msg:
            raise ValidationError(error_msg)
        if not response:
            return ModusignTemplateList(count=0, templates=[])

        raws = response.get(MODUSIGN_TEMPLATES_FIELD, [])
        parsed_list = []

        for raw in raws:
            parsed_list.append(
                ModusignTemplate(
                    id=raw.get(MODUSIGN_ID_FIELD),
                    title=raw.get(MODUSIGN_TITLE_FIELD),
                    created_at=parse_datetime_from_zulu_time(raw.get(MODUSIGN_CREATED_AT_FIELD)),
                    updated_at=parse_datetime_from_zulu_time(raw.get(MODUSIGN_UPDATED_AT_FIELD)),
                )
            )

        return ModusignTemplateList(
            count=response.get(MODUSIGN_COUNT_FIELD, len(parsed_list)),
            templates=parsed_list,
        )

    def resolve_modusign_document_list(
        root, _info, filters: ModusignDocumentListFilterInput = None, limit=10, offset=0
    ):
        status = filters.status if filters else None
        title = filters.title if filters else None
        brand_code = filters.brand_code if filters else None
        started_at_gte = filters.startedAtGte if filters else None
        started_at_lte = filters.startedAtLte if filters else None
        updated_at_gte = filters.updatedAtGte if filters else None
        updated_at_lte = filters.updatedAtLte if filters else None

        response, error_msg = call_modusign_view_document_list_api(
            limit=limit,
            offset=offset,
            brand_code=brand_code,
            title=title,
            status=status,
            started_at_gte=started_at_gte,
            started_at_lte=started_at_lte,
            updated_at_gte=updated_at_gte,
            updated_at_lte=updated_at_lte,
        )
        if error_msg:
            raise ValidationError(error_msg)
        if not response:
            return ModusignDocumentList(count=0, templates=[])

        raws = response.get(MODUSIGN_DOCUMENTS_FIELD, [])
        parsed_list = []

        for raw in raws:
            parsed_list.append(
                ModusignDocument(
                    id=raw.get(MODUSIGN_ID_FIELD),
                    title=raw.get(MODUSIGN_TITLE_FIELD),
                    status=raw.get(MODUSIGN_STATUS_FIELD),
                    started_at=parse_datetime_from_zulu_time(raw.get(MODUSIGN_STARTED_AT_FIELD)),
                    updated_at=parse_datetime_from_zulu_time(raw.get(MODUSIGN_UPDATED_AT_FIELD)),
                )
            )

        return ModusignDocumentList(
            count=response.get(MODUSIGN_COUNT_FIELD, len(parsed_list)),
            documents=parsed_list,
        )


class ModusignMutations(graphene.ObjectType):
    modusign_template_create = ModusignTemplateCreate.Field()
    modusign_template_metadata_update = ModusignTemplateMetadataUpdate.Field()
    modusign_document_create = ModusignDocumentCreate.Field()
    modusign_template_view = ModusignTemplateView.Field()
    modusign_document_view = ModusignDocumentView.Field()
