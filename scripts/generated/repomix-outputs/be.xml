from typing import TYPE_CHECKING

from django.db.models import Sum

from ...order import OrderStatus
from ...product import models
from ..utils.filters import filter_by_period

if TYPE_CHECKING:
    from ...core.models import PublishedQuerySet
    from ...product.models import (
        AttributeQuerySet,
        BpBundleQueryset,
        BrandProductPackageQueryset,
        ProductsQueryset,
        ProductVariantQueryset,
    )


def resolve_attributes(info, qs=None, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    attribute_qs: AttributeQuerySet = models.Attribute.objects
    qs = qs or attribute_qs.get_visible_to_user(brand_store_owner_user)
    return qs.distinct()


def resolve_attribute_by_slug(slug):
    return models.Attribute.objects.filter(slug=slug).first()


def resolve_category_by_slug(slug):
    return models.Category.objects.filter(slug=slug).first()


def resolve_categories(info, level=None, **_kwargs):
    qs = models.Category.objects.prefetch_related("children")
    if level is not None:
        qs = qs.filter(level=level)
    return qs.distinct()


def resolve_collection_by_slug(info, slug):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: PublishedQuerySet = models.Collection.objects
    return qs.visible_to_user(brand_store_owner_user).filter(slug=slug).first()


def resolve_collections(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: PublishedQuerySet = models.Collection.objects
    return qs.visible_to_user(brand_store_owner_user).distinct()


def resolve_digital_contents(info):
    return models.DigitalContent.objects.all()


def resolve_product_by_slug(info, slug):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductsQueryset = models.Product.objects
    return qs.visible_to_user(brand_store_owner_user).filter(slug=slug).first()


def resolve_products(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductsQueryset = models.Product.objects
    qs = qs.visible_to_user(brand_store_owner_user)
    return qs.distinct()


def resolve_inner_products(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductsQueryset = models.Product.objects
    qs = qs.inner_visible_to_user(brand_store_owner_user)
    return qs.distinct()


def resolve_outer_products(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductsQueryset = models.Product.objects
    return qs.outer_visible_to_user(brand_store_owner_user).distinct()


def resolve_product_types(info, **_kwargs):
    return models.ProductType.objects.all().distinct()


def resolve_product_variant_by_sku(info, sku):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductVariantQueryset = models.ProductVariant.objects.select_related("outer", "inner")
    return qs.visible_to_user(brand_store_owner_user).filter(sku=sku).first()


def resolve_product_variants(info, depend_on_user, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: ProductVariantQueryset = models.ProductVariant.objects.select_related("outer", "inner")
    if depend_on_user is True:
        qs = qs.visible_to_user(brand_store_owner_user)
    return qs.distinct()


def resolve_report_product_sales(period):
    qs = models.ProductVariant.objects.select_related("outer", "inner")

    exclude_status = [OrderStatus.CANCELED]
    qs = qs.exclude(order_lines__order__status__in=exclude_status)

    # filter by period
    qs = filter_by_period(qs, period, "order_lines__order__captured_at")

    qs = qs.annotate(quantity_ordered=Sum("order_lines__quantity"))
    qs = qs.filter(quantity_ordered__isnull=False)
    return qs.order_by("-quantity_ordered")


def resolve_product_variant_manage_events(_info, **_kwargs):
    return models.ProductVariantManageEvent.objects.all()


def resolve_brand_product_variant_manage_events(_info, **_kwargs):
    return models.BrandProductVariantManageEvent.objects.all()


def resolve_brand_dev_cost_events(info, **_kwargs):
    qs = models.BrandDevCostEvent.objects.all()
    return qs.distinct()


def resolve_brand_products(_info, **_kwargs):
    qs = models.BrandProduct.objects.all()
    return qs.distinct()


def resolve_brand_product_variants(info, **_kwargs):
    qs = models.BrandProductVariant.objects.all()
    return qs.distinct()


def resolve_bp_bundles(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: BpBundleQueryset = models.BpBundle.objects
    return qs.visible_to_user(brand_store_owner_user).distinct()


def resolve_brand_product_packages(info, **_kwargs):
    brand_store_owner_user = info.context.brand_store_owner_user
    qs: BrandProductPackageQueryset = models.BrandProductPackage.objects
    return qs.visible_to_user(brand_store_owner_user).distinct()
