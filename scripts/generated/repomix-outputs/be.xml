                name="unique_user_bpv",
            ),
            # ⭐ bundle이 있는 경우: user + bundle 고유
            models.UniqueConstraint(
                fields=["user", "bp_bundle"],
                condition=Q(bp_bundle__isnull=False),
                name="unique_user_bundle",
            ),
            # ⭐ 둘 다 NULL이면 안 됨
            models.CheckConstraint(
                check=(
                    Q(brand_product_variant__isnull=False, bp_bundle__isnull=True)
                    | Q(brand_product_variant__isnull=True, bp_bundle__isnull=False)
                ),
                name="check_either_bpv_or_bundle",
            ),
        ]

    def save(self, *args, **kwargs):
        user = self.user
        if (
            user.is_brand_user
            and not user.is_brand_store_owner
            and not user.is_hq_staff
            and not user.is_staff
        ):
            raise ValidationError("일반 직원은 찜하기 생성 불가합니다.")
        super().save(*args, **kwargs)


class CustomerNote(models.Model):
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL, blank=True, null=True, on_delete=models.SET_NULL
    )
    date = models.DateTimeField(db_index=True, auto_now_add=True)
    content = models.TextField()
    is_public = models.BooleanField(default=True)
    customer = models.ForeignKey(
        settings.AUTH_USER_MODEL, related_name="notes", on_delete=models.CASCADE
    )

    class Meta:
        ordering = ("date",)


class CustomerEvent(models.Model):
    """Model used to store events that happened during the customer lifecycle."""

    date = models.DateTimeField(default=timezone.now, editable=False)
    type = models.CharField(
        max_length=255,
        choices=[(type_name.upper(), type_name) for type_name, _ in CustomerEvents.CHOICES],
    )
    order = models.ForeignKey("order.Order", on_delete=models.SET_NULL, null=True)
    parameters = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)
    user = models.ForeignKey(User, related_name="events", on_delete=models.CASCADE)

    class Meta:
        ordering = ("date",)

    def __repr__(self):
