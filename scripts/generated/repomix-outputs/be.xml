class CreditsEventCreate(ModelMutation):
    user = graphene.Field(User, description="User related to credits event.")

    class Meta:
        description = "create credits event."
        model = models.CreditsEvent
        permissions = (AccountPermissions.MANAGE_POINTS,)
        error_type_class = PointsEventError
        error_type_field = "points_event_errors"

    class Arguments:
