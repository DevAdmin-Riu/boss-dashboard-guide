def updated_inline_style_ranges(obj, text, search_str, replace_str):
    str_len_diff = len(search_str) - len(replace_str)
    inline_style_ranges = obj["inlineStyleRanges"]

    for inline_style in inline_style_ranges:
        if inline_style["offset"] > text.find(search_str):
            inline_style["offset"] = inline_style["offset"] - str_len_diff

    return inline_style_ranges


def replace_page_content_string(obj, search_str, replace_str):
    if isinstance(obj, dict):
        for key, value in obj.items():
            if isinstance(value, str):
                if search_str in obj[key]:
                    obj["inlineStyleRanges"] = updated_inline_style_ranges(
                        obj, value, search_str, replace_str
                    )
                    obj[key] = value.replace(search_str, replace_str)
            else:
                replace_page_content_string(value, search_str, replace_str)
    elif isinstance(obj, list):
        for i in range(len(obj)):
            if isinstance(obj[i], str):
                obj[i] = obj[i].replace(search_str, replace_str)
            else:
                replace_page_content_string(obj[i], search_str, replace_str)
