class VendorCreate(ModelMutation):
    class Arguments:
        input = VendorCreateInput(description="Fields required to create a vendor.", required=True)

    class Meta:
        description = "Creates a new vendor."
        model = models.Vendor
        permissions = (VendorPermissions.MANAGE_VENDOR,)
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @staticmethod
    def validate_biz_reg_no(cleaned_input):
        biz_reg_no = cleaned_input.get("biz_reg_no")
        if biz_reg_no:
            digits = re.sub(r"\D", "", biz_reg_no)
            if len(digits) == 10:
                formatted_biz_reg_no = f"{digits[:3]}-{digits[3:5]}-{digits[5:]}"
                cleaned_input["biz_reg_no"] = formatted_biz_reg_no
            else:
                raise ValidationError(
                    "사업자 등록증 번호 자릿수 오류입니다. '-' 를 제외하고 10자리 숫자가 필요합니다."
                )

        return cleaned_input

    @staticmethod
    def validate_direct_shipping_data(cleaned_input):
        is_direct_shipping = cleaned_input.get("is_direct_shipping")
        if is_direct_shipping == False:
            is_using_new_food_request = cleaned_input.get("is_using_new_food_request")
            if is_using_new_food_request == True:
                raise ValidationError(
                    "직배송 협력사가 아닌 경우에는 신규 식자재 요청 사용 여부를 체크할 수 없습니다."
                )

    @staticmethod
    def validate_biz_images(info, cleaned_input, data):
        image_fields = ["biz_reg_image", "account_image"]
        for image_field in image_fields:
            if cleaned_input.get(image_field):
                image_data = info.context.FILES.get(data[image_field])
                validate_image_file(image_data, image_field)

    @classmethod
    def validate_order_manager(cls, cleaned_input):
        managers = cleaned_input.get("managers")
        order_manager = get_main_order_manager_from_vendor_managers(managers)
        if not order_manager:
            raise ValidationError(
                "협력사 생성 시 주문 담당자 이메일/연락처 항목으로 협력사 어드민 계정을 생성하므로 주문 담당자 정보는 필수입니다."
            )

    @staticmethod
    def validate_use_delegated_management_for_po(instance: VendorModel, cleaned_input):
        contact_type = cleaned_input.get(
            "contact_type", instance.contact_type if instance.pk else None
        )
        use_delegated_management_for_po = cleaned_input.get(
            "use_delegated_management_for_po",
            instance.use_delegated_management_for_po if instance.pk else None,
        )
        if (
            contact_type == VendorContactTypeEnum.INTERNET
            and use_delegated_management_for_po == False
        ):
            raise ValidationError("쇼핑몰 타입의 협력사는 위탁발주대행을 사용해야 합니다.")

    @staticmethod
    def validate_use_auto_consignment_po(instance: VendorModel, cleaned_input):
        use_auto_consignment_po = cleaned_input.get(
            "use_auto_consignment_po",
            instance.use_auto_consignment_po if instance.pk else None,
        )
        auto_consignment_po_time = cleaned_input.get(
            "auto_consignment_po_time",
            instance.auto_consignment_po_time if instance.pk else None,
        )
        if use_auto_consignment_po and auto_consignment_po_time is None:
            raise ValidationError("자동위탁발주 사용인 경우 자동발주 시간을 입력해야 합니다.")

    @staticmethod
    def validate_use_product_options(instance: VendorModel, cleaned_input):
        use_boss_product = cleaned_input.get(
            "use_boss_product", instance.use_boss_product if instance.pk else None
        )
        use_b2b_product = cleaned_input.get(
            "use_b2b_product", instance.use_b2b_product if instance.pk else None
        )
        use_fbv_product = cleaned_input.get(
            "use_fbv_product", instance.use_fbv_product if instance.pk else None
        )
        if not any([use_boss_product, use_b2b_product, use_fbv_product]):
