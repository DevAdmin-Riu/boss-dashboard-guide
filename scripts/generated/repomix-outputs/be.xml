import django_filters
import graphene
from django.db.models import Q
from graphene_django.filter import GlobalIDFilter, GlobalIDMultipleChoiceFilter

from ...schedule import RepeatType
from ...schedule.models import Schedule as ScheduleModel
from ..core.filters import ObjectTypeFilter
from ..core.types import FilterInputObjectType
from ..core.types.common import DateRangeInput
from ..utils.filters import filter_overlap_range_field


class ScheduleFilter(django_filters.FilterSet):
    def filter_related_user(qs, _, value):
        # 작성자이거나, 참여자인 일정 모두 포함
        if value:
            _, user_id = graphene.Node.from_global_id(value)
            qs = qs.filter(Q(writer_id=user_id) | Q(participants__id=user_id)).distinct()

        return qs

    def filter_active_period(qs, _, value):
        start = value.get("gte")
        end = value.get("lte")

        # 1. 반복 없음: 기존과 동일
        overlap = qs.filter(repeat_type=RepeatType.NONE)
        overlap = filter_overlap_range_field(overlap, "start__date", "end__date", value)

        # 2. 무한 반복
        infinite_repeat = qs.exclude(repeat_type=RepeatType.NONE).filter(repeat_until__isnull=True)
        # 무한 반복은 일정 시작이 active_period 끝보다 이전이면 포함
        if end:
            infinite_repeat = infinite_repeat.filter(start__date__lte=end)

        # 3. 유한 반복
        finite_repeat = qs.exclude(repeat_type=RepeatType.NONE).filter(repeat_until__isnull=False)
        # 반복 종료일이 active_period 시작 이후면 포함
        if start:
            finite_repeat = finite_repeat.filter(repeat_until__gte=start)

        return overlap | infinite_repeat | finite_repeat

    writer = GlobalIDFilter(field_name="writer_id")
    participant = GlobalIDFilter(field_name="participants")
    related_user = GlobalIDFilter(method=filter_related_user)

    writers = GlobalIDMultipleChoiceFilter(
        field_name="writer_id",
    )

    active_period = ObjectTypeFilter(input_class=DateRangeInput, method=filter_active_period)

    class Meta:
        model = ScheduleModel
        fields = []


class ScheduleFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = ScheduleFilter
