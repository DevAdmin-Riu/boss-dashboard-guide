                )
            params = {
                "P_MID": plugin_configs.merchant_id,
                "P_TID": payment_transaction_id,
            }

            org_response = requests.get(auth_url, params=params)
            response_key_value_pairs = org_response.text.split("&")
            for key_value_pair in response_key_value_pairs:
                key_value = key_value_pair.split("=")
                key_value_len = len(key_value)

                if key_value_len <= 1:
                    logger.warn(f"key_value_pair = {key_value_pair} - {org_response.text}")

                key = key_value[0]
                value = key_value[1] if key_value_len > 1 else ""

                if key == "P_TYPE":
                    gateway_response[INICIS_PAY_METHOD] = value
                elif key == INICIS_VACT_BANK_CODE_OF_MOBILE:
                    gateway_response[INICIS_VACT_BANK_CODE] = value
                elif key == "P_FN_NM":
                    gateway_response[INICIS_VACT_BANK_NAME] = value
                elif key == "P_VACT_NUM":
                    gateway_response[INICIS_VACT_NUM] = value
                elif key == "P_VACT_NAME":
                    gateway_response[INICIS_VACT_NAME] = value
                elif key == "P_AMT":
                    gateway_response[INICIS_VACT_TOT_PRICE] = value
                elif key == INICIS_P_VACT_DATE:
                    gateway_response[INICIS_VACT_DATE] = value
                elif key == INICIS_P_VACT_TIME:
                    gateway_response[INICIS_VACT_TIME] = value
                else:
                    gateway_response[key] = value
            result_code = gateway_response["P_STATUS"]
            result_msg = gateway_response["P_RMESG1"]
            pay_method = gateway_response[INICIS_PAY_METHOD]

            is_auth_completed = result_code == "00"
            if not is_auth_completed:
                is_success = False
                success_msg = None
                failed_msg = f"이니시스 인증 실패: {result_msg} ({result_code}) {org_response}"
