import logging

import graphene
from django.conf import settings
from django.core.exceptions import ValidationError
from django.db import transaction
from django.db.models import Q

from ....core.permissions import PaymentPermissions
from ....order import OrderDeliveryMethods, OrderType
from ....order.events import payment_charge_status_update
from ....order.models import Order as OrderModel
from ....payment import ChargeStatus, TransactionKind, models
from ....payment.emails import send_email_when_payment_charge_status_update
from ....payment.models import Payment as PaymentModel
from ....payment.models import Transaction as TransactionModel
from ....payment.utils import post_captured
from ....purchaseorder import CONSIGNMENT_AFTER_FULFILL_STATUSES
from ...core.mutations import ModelMutation
from ...core.types import Upload
from ...core.types import common as common_types
from ...order.types import Order
from ..enums import PaymentChargeStatusEnum

logger = logging.getLogger(__name__)


class UpdateStaffPaymentChargeStatusInput(graphene.InputObjectType):
    charge_status = PaymentChargeStatusEnum(
        required=True,
        description="대행 주문 결제 상태 변경을 위한 정보",
    )
    receipt_file = Upload(description="결제 완료 증빙 파일.")
    receipt_refused_reason = graphene.String(
        description="결제 완료 반려 사유",
    )


class UpdateStaffPaymentChargeStatus(ModelMutation):
    order = graphene.Field(Order)

    class Arguments:
        id = graphene.ID(required=True, description="payment id")
        input = UpdateStaffPaymentChargeStatusInput(
            required=True, description="대행 주문 결제 승인을 위한 정보"
        )

    class Meta:
        description = "대행 주문의 경우 결제 상태 변경을 위한 Mutation"
        model = models.Payment
        permissions = (PaymentPermissions.MANAGE_PAYMENT_STATUS,)
        error_type_class = common_types.PaymentError
        error_type_field = "payment_errors"

    class Meta:
        description = "대행 주문의 경우 결제 상태 변경을 위한 Mutation"
        model = models.Payment
        permissions = (PaymentPermissions.MANAGE_PAYMENT_STATUS,)
        error_type_class = common_types.PaymentError
        error_type_field = "payment_errors"

    @classmethod
    def validate_charge_status_itself(cls, old_charge_status, new_charge_status):
        possible_new_charge_status = [
            ChargeStatus.PENDING,
            ChargeStatus.BEING_APPROVED,
            ChargeStatus.FULLY_CHARGED,
        ]
        # 결제상태가 FULLY_CHARGED인 경우 변경 불가.
        possible_old_charge_status = [
            ChargeStatus.PENDING,
            ChargeStatus.BEING_APPROVED,
        ]

        # old_charge_status가 possible_old_charge_status 안에 없는 경우 error
        if old_charge_status not in possible_old_charge_status:
            raise ValidationError(f"현재 결제 상태({old_charge_status})는 변경할 수 없습니다.")

        # new_charge_status가 possible_new_charge_status안에 없는 경우 error
        if new_charge_status not in possible_new_charge_status:
            raise ValidationError(f"대행 주문 결제 상태를 변경할 수 없습니다.")

    @classmethod
    def validate_when_change_to_being_approved(
        cls, old_charge_status, new_charge_status, receipt_file
    ):
        # 새 charge_status being_approved로 변경 시. 파일 존재해야함, 이전 charge_status는 pending이어야 함.
        if new_charge_status == ChargeStatus.BEING_APPROVED:
            if old_charge_status != ChargeStatus.PENDING:
                raise ValidationError(
                    "결제 대기 상태가 아니므로 대행 주문 결제 상태를 변경할 수 없습니다."
                )
            if not receipt_file:
                raise ValidationError("결제 증빙 파일이 필요합니다.")

    @classmethod
    def validate_when_change_to_pending(
        cls, old_charge_status, new_charge_status, recepit_refused_reason
    ):
        # 새 charge_status pending으로 변경 시. 이전 charge_status는 being_approved여야함.
        if new_charge_status == ChargeStatus.PENDING:
            if old_charge_status != ChargeStatus.BEING_APPROVED:
                raise ValidationError("결제 증빙 상태가 아니므로 반려 할 수 없습니다.")
            if not recepit_refused_reason:
                raise ValidationError("반려 사유를 입력해주세요.")

    # 새 charge_status fully_charged 결제상태 완료로 변경 시 validation. 이전 charge_status는 being_approved 여야함. 반려사유는 굳이 필요 없음.
    @classmethod
    def validate_when_change_to_fully_charged(
        cls, old_charge_status, new_charge_status, order: OrderModel
    ):
        if new_charge_status == ChargeStatus.FULLY_CHARGED:
            if old_charge_status == ChargeStatus.FULLY_CHARGED:
                raise ValidationError("이미 결제 완료되었습니다.")
            if old_charge_status != ChargeStatus.BEING_APPROVED:
                raise ValidationError("결제 증빙 상태가 아니므로 결제 완료 할 수 없습니다.")
            # 택배가 아닌 위탁 주문이 모두 출고 지시된 후에만 결제완료 처리가능
            if order.delivery_method != OrderDeliveryMethods.BY_COURIER:
                yet_dispatch_fulfillment_consignment_order_lines = order.lines.filter(
                    Q(track_inventory=False)
                    & ~Q(purchase_order_line__status__in=CONSIGNMENT_AFTER_FULFILL_STATUSES)
                )
                if yet_dispatch_fulfillment_consignment_order_lines.exists():
                    raise ValidationError(
                        "택배가 아닌 위탁 주문이 모두 출고 지시된 후에만 결제 완료 할 수 있습니다."
                    )

    @classmethod
    def clean_input(cls, info, instance: "PaymentModel", data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data, input_cls)
        new_charge_status = cleaned_input["charge_status"]
        receipt_refused_reason = cleaned_input.get("receipt_refused_reason")
        receipt_file = cleaned_input.get("receipt_file")
        old_charge_status = instance.charge_status

        if instance.order.type != OrderType.BY_STAFF_FOR_BRAND:
            raise ValidationError("결제 상태 변경 요청은 대행 주문만 가능합니다.")

        cls.validate_charge_status_itself(old_charge_status, new_charge_status)
        cls.validate_when_change_to_being_approved(
            old_charge_status, new_charge_status, receipt_file
        )

        cls.validate_when_change_to_pending(
            old_charge_status, new_charge_status, receipt_refused_reason
        )

        cls.validate_when_change_to_fully_charged(
            old_charge_status, new_charge_status, instance.order
        )

        return cleaned_input

    @classmethod
    @transaction.atomic
    def save(cls, info, instance: PaymentModel, cleaned_input):

        # 결제 완료로 바뀐 경우.
        if instance.charge_status == ChargeStatus.FULLY_CHARGED:
            pay_method = instance.token
            kind = TransactionKind.CAPTURE
            captured_transaction = TransactionModel.objects.create(
                payment=instance,
                token=pay_method,
                kind=kind,
                is_success=True,
                amount=instance.amount,
                cashable_credits=instance.cashable_credits,
                non_cashable_credits=instance.non_cashable_credits,
                rcoins=instance.rcoins,
                currency=settings.DEFAULT_CURRENCY,
                gateway_response={},
                # 신규 생성 Transaction은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
                is_converted=True,
            )
            post_captured(
                payment=instance,
                captured_transaction=captured_transaction,
                requester=info.context.user,
            )

        super().save(info, instance, cleaned_input)

    @classmethod
    def post_save_action(cls, info, instance: models.Payment, cleaned_input):
        # charge_status 바뀔때마다 order event 추가
        payment_charge_status_update(payment=instance, user=info.context.user)

        # charge_status 바뀔때마다 결제상태 변경시 주문을 입력한 사람에게 해당 결제상태 변경에 대한 내용을 메일로 보내줌.
        order: OrderModel = instance.order
        recipient_list = [order.creator_user.email]
        transaction.on_commit(
            lambda recipient_list=recipient_list, charge_status=instance.charge_status, order_id=order.id, changer_name=info.context.user.first_name, receipt_refused_reason=instance.receipt_refused_reason: send_email_when_payment_charge_status_update.delay(
                recipient_list=recipient_list,
                charge_status=charge_status,
                order_id=order_id,
                changer_name=changer_name,
                receipt_refused_reason=receipt_refused_reason,
            )
        )

    @classmethod
    def success_response(cls, instance: models.Payment):
        response = super().success_response(instance)
        response.order = instance.order
        return response
