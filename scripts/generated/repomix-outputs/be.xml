class ProductVariantPriceMixin:
    def get_price(self, delivery_request_date=None) -> "Money":
        currency = settings.DEFAULT_CURRENCY
        if (
            delivery_request_date is None
            or self.change_price_confirmed_date is None
            or delivery_request_date < self.change_price_confirmed_date
        ):
            return Money(self.price_amount, currency)
        return (
            Money(self.change_price_amount, currency)
            if self.change_price_amount
            else zero_money(currency)
        )

    def get_cost_price(self, is_tax_free: bool, delivery_request_date=None) -> "Money":
        currency = settings.DEFAULT_CURRENCY
        if (
            delivery_request_date is None
            or self.change_price_confirmed_date is None
            or delivery_request_date < self.change_price_confirmed_date
        ):
            cost_price_include_vat = calc_to_include_vat(self.cost_price_exclude_vat, is_tax_free)
            return (
                Money(cost_price_include_vat, currency)
                if cost_price_include_vat
                else zero_money(currency)
            )
        return (
            Money(self.change_cost_price_amount, currency)
            if self.change_cost_price_amount
            else zero_money(currency)
        )

    def get_delivery_fee(self, delivery_request_date=None) -> "Money":
        currency = settings.DEFAULT_CURRENCY
        if (
            delivery_request_date is None
            or self.change_price_confirmed_date is None
            or delivery_request_date < self.change_price_confirmed_date
        ):
            return Money(self.delivery_fee_amount, currency)
        return (
            Money(self.change_delivery_fee_amount, currency)
            if self.change_delivery_fee_amount
            else zero_money(currency)
        )


