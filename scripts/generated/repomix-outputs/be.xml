from typing import Iterable, List

from django.conf import settings
from django.db.models import Prefetch, Subquery

from ...core.prices import calc_to_exclude_vat, calc_total_exclude_vat_by_unit_exclude_vat_and_qty
from ...core.utils.export_to_excel import (
    ExcelCellInfo,
    export_excel_cell_info_rows_to_workbook,
    make_excel_cell_info,
)
from ...purchaseorder import ALREADY_STOCKED_STATUSES
from ...purchaseorder.models import PurchaseOrderLine
from ...stats.utils import (
    get_latest_stocked_date_info_using_prefetched_data,
    get_total_stocks_qty_by_prefetched_data,
)
from ...terminology import (
    term_of_bpv_sales_status,
    term_of_pv_sales_status,
    term_of_stock_status_by_est_shortage_enum,
)
from ...warehouse.availability import (
    calc_est_shortage_info,
    get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data,
)
from ...warehouse.models import Stock, Warehouse
from .. import SalesStatus
from ..models import BrandProductVariant, ProductVariant, get_avg_sales_combined_qty_consider_inner


def get_pv_qs_for_exclusive_product_list(pv_ids):
    query_warehouse = Subquery(
        Warehouse.objects.filter(
            shipping_zones__countries__contains=settings.DEFAULT_COUNTRY
        ).values("pk")
    )
    filtered_stocks = Stock.objects.filter(warehouse__in=query_warehouse).prefetch_related(
        "allocations",
    )
    latest_stocked_po_line_ids = (
        PurchaseOrderLine.objects.filter(
            status__in=ALREADY_STOCKED_STATUSES,
        )
        .order_by("variant_id", "-purchase_date", "-pk")
        .distinct("variant_id")  # PostgreSQL 전용: variant_id별 최신 row 하나
        .values_list("pk", flat=True)
    )
    filter_latest_stocked_po_lines = PurchaseOrderLine.objects.filter(
        pk__in=latest_stocked_po_line_ids
    )
    pv_qs = (
        ProductVariant.objects.select_related("inner", "outer")
        .prefetch_related(
            Prefetch("stocks", queryset=filtered_stocks, to_attr="prefetched_stocks"),
            Prefetch("outer__stocks", queryset=filtered_stocks, to_attr="prefetched_outer_stocks"),
            Prefetch("inner__stocks", queryset=filtered_stocks, to_attr="prefetched_inner_stocks"),
            Prefetch(
                "purchase_order_lines",
                queryset=filter_latest_stocked_po_lines,
                to_attr="prefetched_latest_stocked_po_lines",
            ),
        )
        .filter(id__in=pv_ids)
    )
    return pv_qs


def export_monthly_exclusive_product_list_to_brand(
    brand_product_variants_prefetched: Iterable[BrandProductVariant],
):
    rows: List[List[ExcelCellInfo]] = []
    pv_ids = [bpv.product_variant_id for bpv in brand_product_variants_prefetched]
    pv_qs = get_pv_qs_for_exclusive_product_list(pv_ids)
    pv_map = {pv.id: pv for pv in pv_qs}

    for bpv in brand_product_variants_prefetched:
        pv = pv_map.get(bpv.product_variant_id)
        brand_product = bpv.brand_product

        # 재고수량
        prefetched_stocks = getattr(pv, "prefetched_stocks", [])
        total_stock_qty = get_total_stocks_qty_by_prefetched_data(prefetched_stocks)
        # bpv.sales_status가 단종이면서 total_stock_quantity_int가 0 인 경우에는 append하지않고 건너띈다.
        if bpv.sales_status == SalesStatus.STOPPED and total_stock_qty == 0:
            continue

        is_tax_free = pv.product.is_tax_free
        # 제품코드
        product_sku = pv.sku
        # 상품명
        brand_product_name = brand_product.name
        # 제품상태
        pv_sales_status = term_of_pv_sales_status(pv)
        # 판매상태
        bpv_sales_status = term_of_bpv_sales_status(bpv)
        # 계약 매입가
        cost_price_exclude_vat = bpv.cost_price_exclude_vat
        delivery_fee_exclude_vat = calc_to_exclude_vat(bpv.delivery_fee_amount, False)
        if delivery_fee_exclude_vat is None:
            delivery_fee_exclude_vat = 0
        unit_brand_price_exclude_vat = (
            cost_price_exclude_vat + delivery_fee_exclude_vat
            if cost_price_exclude_vat is not None
            else None
        )
        # 재고금액
        total_stock_price_exclude_vat = (
            calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
                unit_brand_price_exclude_vat, total_stock_qty, is_tax_free
            )
            if unit_brand_price_exclude_vat is not None
            else None
        )
        # 최근 30 일 평균 판매량 ( 14일 미만 시 입력된 예상 판매량,  14일 ~ 90일 미만 사이에는 그 기간의 일 평균 판매량, 90일 이상인 경구 최근 3개월 일 평균 판매량)
        avg_sales_daily_qty_consider_inner = get_avg_sales_combined_qty_consider_inner(
            pv, "last_30_days_avg_sales_daily_qty"
        )
        last_30_days_avg_sales_daily_qty = avg_sales_daily_qty_consider_inner
        # 예상 소진 기간(일), 재고 상태
        total_stock_qty_to_outer_base_consider_inner = (
            get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data(pv)
        )
        est_shortage_info = calc_est_shortage_info(
            variant=pv,
            total_stock_qty=total_stock_qty_to_outer_base_consider_inner,
            detail_info_mode=False,
        )
        stock_status_text, stock_status_num = term_of_stock_status_by_est_shortage_enum(
            pv.stock_status_by_daily
        )
        latest_stocked_date = get_latest_stocked_date_info_using_prefetched_data(pv)

        rows.append(
            [
                make_excel_cell_info(title="제품코드", value=product_sku),
                make_excel_cell_info(title="상품명", value=brand_product_name),
                make_excel_cell_info(title="전용여부", value="전용"),
                make_excel_cell_info(title="제품상태", value=pv_sales_status),
                make_excel_cell_info(title="판매상태", value=bpv_sales_status),
                make_excel_cell_info(
                    title="계약 매입가",
                    value=(
                        unit_brand_price_exclude_vat
                        if unit_brand_price_exclude_vat is not None
                        else "-"
                    ),
                ),
                make_excel_cell_info(title="재고수량", value=total_stock_qty),
                make_excel_cell_info(
                    title="재고금액",
                    value=(
                        total_stock_price_exclude_vat
                        if total_stock_price_exclude_vat is not None
                        else "-"
                    ),
                ),
                make_excel_cell_info(
                    title="최근 30일 일 평균 판매량",
                    value=last_30_days_avg_sales_daily_qty,
                    ndigits=2,
                ),
                make_excel_cell_info(
                    title="예상 소진 기간(일)",
                    value=(
                        est_shortage_info.est_shortage_period
                        if est_shortage_info and est_shortage_info.est_shortage_period is not None
                        else "-"
                    ),
                    ndigits=1,
                ),
                make_excel_cell_info(title="재고 상태", value=stock_status_text),
                make_excel_cell_info(
                    title="최근 입고일",
                    value=latest_stocked_date,
                ),
                make_excel_cell_info(title="stock_status_num", value=stock_status_num),
            ]
        )

    if len(rows) == 0:
        return None

    # items를 title의 값이 stock_status_num순으로 내림차순으로 정렬 후 제거
    rows.sort(
        key=lambda row: next((cell.value for cell in row if cell.title == "stock_status_num"), 0),
        reverse=True,
    )
    for row in rows:
        row[:] = [cell for cell in row if cell.title != "stock_status_num"]

    return export_excel_cell_info_rows_to_workbook(
        rows=rows, auto_adjusted_width=True, include_index=True, show_exclude_vat_legend=True
    )
