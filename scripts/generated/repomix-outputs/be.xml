    @staticmethod
    def resolve_user(root: models.Checkout, info):
        requestor = info.context.user
        brand_store_owner_user = info.context.brand_store_owner_user
        if requestor_has_access(requestor, root.user, AccountPermissions.VIEW_STAFF):
            return root.user
        elif brand_store_owner_user == root.user:
            return root.user
        raise PermissionDenied(user=requestor, cls=Checkout, fn=Checkout.resolve_user)

    # def resolve_totalPrice(root: models.Checkout, info):
