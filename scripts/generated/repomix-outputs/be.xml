class BsOpsCheckTemplate(CountableDjangoObjectType):
    brand = graphene.Field(
        "saleor.graphql.account.types.Brand",
        description="브랜드",
    )
    create_user = graphene.Field(
        "saleor.graphql.account.types.User",
        description="생성자",
    )
    categories = graphene.List(
        "saleor.graphql.brand_store_ops_check.types.BsOpsCheckTemplateCategory",
        description="점검 양식 카테고리 목록",
    )
    reports = PrefetchingConnectionField(
        "saleor.graphql.brand_store_ops_check.types.BsOpsCheckReport",
        description="점검 보고 목록",
    )
    reports_count = graphene.Field(
        BsOpsCheckReportCount,
        description="점검 보고서 개수",
    )
    category_items_count = graphene.Int(
        description="점검 양식 카테고리 항목 개수",
    )

    class Meta:
        description = "점검 양식"
        model = models.BsOpsCheckTemplate
        interfaces = [relay.Node]
        fields = "__all__"

    def resolve_brand(root: models.BsOpsCheckTemplate, info):
        if root.brand_id:
            return BrandByIdLoader(info.context).load(root.brand_id)
        else:
            return None

    def resolve_create_user(root: models.BsOpsCheckTemplate, info):
        if root.create_user_id:
            return UserByIdLoader(info.context).load(root.create_user_id)
        else:
            return None

    def resolve_categories(root: models.BsOpsCheckTemplate, info):
        return BsOpsCheckTemplateCategoriesByTemplateIdAndLevelLoader(info.context).load(
            (root.id, 0)
        )

    def resolve_reports(root: models.BsOpsCheckTemplate, info, **kwargs):
        return BsOpsCheckReportsByTemplateIdLoader(info.context).load(root.id)

    def resolve_reports_count(root: models.BsOpsCheckTemplate, info):
        return (
            BsOpsCheckReportsByTemplateIdLoader(info.context)
            .load(root.id)
            .then(
                lambda reports: BsOpsCheckReportCount(
                    not_submitted_count=len([r for r in reports if not r.is_submitted]),
                    submitted_count=len([r for r in reports if r.is_submitted]),
                )
            )
        )

    def resolve_category_items_count(root: models.BsOpsCheckTemplate, info):
        categories_loader = BsOpsCheckTemplateCategoriesByTemplateIdAndLevelLoader(info.context)
        items_loader = BsOpsCheckTemplateCategoryItemsByCategoryIdLoader(info.context)

        def _count_items(categories):
            if not categories:
                return 0
            item_promises = [items_loader.load(cat.id) for cat in categories]
            return Promise.all(item_promises).then(
                lambda item_lists: sum(len(items) for items in item_lists)
            )

        # level 1에만 아이템이 있음.
        return categories_loader.load((root.id, 1)).then(_count_items)


