def handle_net_cancel(net_cancel_url, params, is_mobile, pay_method, payment: "Payment"):
    logger.info(f"payment_debug: handle_net_cancel {payment}")
    try:
        org_response = None
        if is_mobile:
            org_response = requests.post(net_cancel_url, data=params)
            responseObj = {}
            response_key_value_pairs = org_response.text.split("&")
            for key_value_pair in response_key_value_pairs:
                key_value = key_value_pair.split("=")
                key_value_len = len(key_value)

                if key_value_len <= 1:
                    logger.warn(f"key_value_pair = {key_value_pair} - {org_response.text}")

                key = key_value[0]
                value = key_value[1] if key_value_len > 1 else ""
                responseObj[key] = value

            is_success = responseObj["P_STATUS"] == "00"
            noti_msg = f"{responseObj['P_TID']} {responseObj['P_RMESG1']}"
        else:
            org_response = requests.post(net_cancel_url, data=params)
            response = org_response.json()
            result_code = response.get("resultCode")
            result_msg = response.get("resultMsg")
            tid = response.get("mid")
            is_success = result_code == "0000"
            noti_msg = f"{tid} {result_msg}"
    except Exception as e:
        is_success = False
        logger.error(f"net_cancel exception: {net_cancel_url} - {org_response} {e}")

    if is_success:
        logger.info(f"inicis net cancel success: ({pay_method}) is_mobile={is_mobile} {noti_msg}")
    else:
        logger.error(f"inicis net cancel error:  ({pay_method}) is_mobile={is_mobile} {noti_msg}")
    return is_success


