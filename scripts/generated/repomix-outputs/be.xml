    @classmethod
    def clean_brand_product_package(cls, order_type, details):
        # 패키지 상품은 대행주문 (운영admin, 가맹본부admin) 에서만 허용
        if order_type not in ORDER_TYPES_BY_STAFF_OR_HQ_STAFF_FOR_BRAND:
            return details

        # bpp -> bpv 구성품으로 쪼개서 가격, 수량 설정
        def append_new_order_line(new_order_lines: list, new_order_line: dict):
            """
            new_order_lines 리스트에 동일한 bp_sku가 존재하면 qty를 누적하고,
            존재하지 않으면 새로 추가한다.
            """
            bp_sku = new_order_line.get("bp_sku")
            for existing_line in new_order_lines:
                if existing_line.get("bp_sku") == bp_sku:
                    existing_line["qty"] += new_order_line.get("qty", 0)
                    existing_line["etc_delivery_fee"] += new_order_line.get("etc_delivery_fee", 0)
                    existing_line["b2b_delivery_fee_exclude_vat"] += new_order_line.get(
                        "b2b_delivery_fee_exclude_vat", 0
                    )
                    return
            # 동일한 bp_sku가 없으면 새로 추가
            new_order_lines.append(new_order_line)

        cleaned_details = []
        for detail in details:
            order_lines = detail.get("order_lines")
            new_order_lines = []
            for order_line in order_lines:
                sku = order_line.get("bp_sku")
                bpp_qty = order_line.get("qty")
                try:
                    bpp: BrandProductPackageModel = (
                        product_models.BrandProductPackage.objects.prefetch_related(
                            "brand_product_variant_package_infos",
                            "brand_product_variant_package_infos__brand_product_variant",
                            "brand_product_variant_package_infos__brand_product_variant__product_variant",
                        ).get(bp_sku=sku)
                    )
                    bpvp_info_list: List[BrandProductVariantPackageInfoModel] = list(
                        bpp.brand_product_variant_package_infos.all()
                    )
                    etc_delivery_fee = order_line.get("etc_delivery_fee", 0)
                    b2b_delivery_fee_exclude_vat = order_line.get("b2b_delivery_fee_exclude_vat", 0)
                    for idx, bpvp_info in enumerate(bpvp_info_list):
                        bpv: BrandProductVariantModel = bpvp_info.brand_product_variant
                        pv: ProductVariantModel = bpv.product_variant
                        new_order_line = {
                            **order_line,
                            "bp_sku": bpv.bp_sku,
                            "price": my_round(bpv.price_amount, pv.price_decimal_places),
                            "price_vat": my_round(bpv.price_vat, pv.price_decimal_places),
                            "qty": bpp_qty * bpvp_info.quantity,
                            "etc_delivery_fee": etc_delivery_fee if idx == 0 else 0,
                            "b2b_delivery_fee_exclude_vat": (
                                b2b_delivery_fee_exclude_vat if idx == 0 else 0
                            ),
                        }
                        append_new_order_line(new_order_lines, new_order_line)
                except ObjectDoesNotExist:
                    append_new_order_line(new_order_lines, order_line)
            # detail 에 교체된 order_lines 적용
            new_detail = {**detail, "order_lines": new_order_lines}
            cleaned_details.append(new_detail)
        return cleaned_details

    @classmethod
    def clean_basic_info_for_hq_staff_order(cls, order_type, details):
        if order_type != OrderType.BY_HQ_STAFF_FOR_BRAND:
            return details
        for detail in details:
            detail["delivery_method"] = OrderDeliveryMethods.BY_COURIER
            order_lines = detail.get("order_lines")
            for order_line in order_lines:
                order_line["tax_invoice_request_flag"] = True
                order_line["calc_mileage"] = True
                order_line["exclude_stock_avg_stats"] = False
                # 그외 택배 아님 배송방식에 사용되는 입력값은 사용되지 않으므로 무시 하면됨
        return details

    @classmethod
    def clean_price_for_hq_staff_order(
        cls,
        order_type,
        details,
        pv_dict: Dict[str, "ProductVariantModel"],
        bpv_dict: Dict[str, "BrandProductVariantModel"],
        bp_bundle_dict: Dict[str, "BpBundleModel"],
    ):
        # 가맹본부 대행주문은 가격을 입력 안하고 bpv 값으로 처리
        if order_type != OrderType.BY_HQ_STAFF_FOR_BRAND:
            return details

        for detail in details:
            order_lines = detail.get("order_lines")
            for order_line in order_lines:
                sku = order_line.get("bp_sku")
                bp_bundle = bp_bundle_dict.get(sku)
                if bp_bundle:
                    main_pv = pv_dict[sku]
                    order_line["price"] = my_round(
                        bp_bundle.price_amount, main_pv.price_decimal_places
                    )
                    order_line["price_vat"] = my_round(
                        bp_bundle.price_vat, main_pv.price_decimal_places
                    )
                else:
                    pv = pv_dict[sku]
                    bpv = bpv_dict[sku]
                    order_line["price"] = my_round(bpv.price_amount, pv.price_decimal_places)
                    order_line["price_vat"] = my_round(bpv.price_vat, pv.price_decimal_places)
        return details

    @classmethod
    def validate_customer_login_id(cls, order_type, details):
        brands_dict = {}
        user_list = []
        if order_type not in ORDER_TYPES_WITH_BRAND_USER:
            return brands_dict, user_list

        errors = []
        brand_errors = []
        reverse_fee_contract_type_errors = []
        login_ids = set()
        for detail in details:
            customer_login_id = detail.get("customer_login_id")
            login_ids.add(customer_login_id)

        sorted_login_ids = sorted(login_ids)
        for login_id in sorted_login_ids:
            try:
                user: UserModel = account_models.User.objects.select_related("brand").get(
                    login_id=login_id
                )
                user_list.append(user)
                if user.brand is None:
                    brand_errors.append(login_id)
                    continue
                brands_dict[login_id] = user.brand
                if user.brand.is_reverse_fee_contract_type:
                    reverse_fee_contract_type_errors.append(login_id)
            except ObjectDoesNotExist:
                errors.append(login_id)
                continue

        if len(errors) > 0:
            error_msg = "회원 아이디 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)
        if len(brand_errors) > 0:
            error_msg = "브랜드 회원이 아닌 회원 아이디 오류: {}".format(", ".join(brand_errors))
            raise ValidationError(error_msg)
        if len(reverse_fee_contract_type_errors) > 0:
            error_msg = "매출인식 계약 브랜드 회원 오류: {}".format(
                ", ".join(reverse_fee_contract_type_errors)
            )
            raise ValidationError(error_msg)
        return brands_dict, user_list

    @classmethod
    def validate_sku(cls, order_type, all_order_lines):
        sku_errors = []
        pv_errors = []
        bpv_errors = []
        bp_bundle_errors = []
        direct_shipping_errors = []
        inner_variant_errors = []
        skus = set()
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            if sku is not None:
                skus.add(sku)
            else:
                sku_errors.append(sku)

        if sku_errors:
            if is_exist_brand_user_order_type:
                raise ValidationError("상품코드가 입력되지 않은 주문이 존재합니다.")
            else:
                raise ValidationError("제품코드가 입력되지 않은 주문이 존재합니다.")

        sorted_skus = sorted(skus)
        pv_dict = {}
        bpv_dict = {}
        bp_bundle_dict = {}
        for sku in sorted_skus:
            try:
                is_bp_bundle_case = False
                if is_exist_brand_user_order_type:
                    bp_bundle: BpBundleModel = (
                        product_models.BpBundle.objects.prefetch_related(
                            Prefetch(
                                "bp_bundle_infos",
                                queryset=product_models.BpBundleInfo.objects.order_by(
                                    "-is_main", "id"
                                ),
                            )
                        )
                        .filter(bp_sku=sku)
                        .first()
                    )
                    if bp_bundle:
                        bp_bundle_dict[sku] = bp_bundle
                        main_pv = bp_bundle.main_pv
                        if not main_pv:
                            bp_bundle_errors.append(sku)
                            continue
                        pv_dict[sku] = main_pv
                        is_bp_bundle_case = True
                    else:
                        bpv: BrandProductVariantModel = (
                            product_models.BrandProductVariant.objects.select_related(
                                "product_variant", "product_variant__product"
                            ).get(bp_sku=sku)
                        )
                        bpv_dict[sku] = bpv
                        variant: ProductVariantModel = bpv.product_variant
                else:
                    variant: ProductVariantModel = (
                        product_models.ProductVariant.objects.select_related("product").get(sku=sku)
                    )
                if not is_bp_bundle_case:
                    if variant.product.is_direct_shipping:
                        direct_shipping_errors.append(sku)
                        continue
                    if variant.outer_id is not None:
                        inner_variant_errors.append(sku)
                        continue
                    pv_dict[sku] = variant
            except ObjectDoesNotExist:
                if is_exist_brand_user_order_type:
                    bpv_errors.append(sku)
                else:
                    pv_errors.append(sku)
                continue

        if len(pv_errors) > 0:
            error_msg = "제품코드 오류: {}".format(", ".join(pv_errors))
            raise ValidationError(error_msg)
        if len(bpv_errors) > 0:
            error_msg = "상품코드 오류: {}".format(", ".join(bpv_errors))
            raise ValidationError(error_msg)
        if len(bp_bundle_errors) > 0:
            error_msg = "세트상품 대표구성품 오류: {}".format(", ".join(bp_bundle_errors))
            raise ValidationError(error_msg)
        if len(direct_shipping_errors) > 0:
            error_msg = "직배송 제품 오류: {}".format(", ".join(direct_shipping_errors))
            raise ValidationError(error_msg)
        if len(inner_variant_errors) > 0:
            error_msg = "이너박스 제품 오류: {}".format(", ".join(inner_variant_errors))
            raise ValidationError(error_msg)

        return pv_dict, bpv_dict, bp_bundle_dict

    @classmethod
    def validate_decimal_order_qty(
        cls, order_type, all_order_lines, pv_dict: Dict[str, "ProductVariantModel"]
    ):
        errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            pv = pv_dict[sku]
            qty = order_line.get("qty", 0)
            try:
                decimal_value = Decimal(str(qty))  # 문자열로 변환 후 Decimal로 정확하게 파싱
            except InvalidOperation:
                errors.append(sku)
            else:
                actual_decimal_places = get_actual_decimal_places(decimal_value)
                if actual_decimal_places > pv.order_qty_decimal_places:
                    errors.append(sku)

        if errors:
            error_msg = "주문 수량 소수점 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_decimal_price(
        cls, order_type, all_order_lines, pv_dict: Dict[str, "ProductVariantModel"]
    ):
        price_errors = []
        price_vat_errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            variant = pv_dict[sku]
            price = order_line.get("price", 0)
            try:
                decimal_value = Decimal(str(price))  # 문자열로 변환 후 Decimal로 정확하게 파싱
            except InvalidOperation:
                price_errors.append(sku)
            else:
                actual_decimal_places = get_actual_decimal_places(decimal_value)
                if actual_decimal_places > variant.price_decimal_places:
                    price_errors.append(sku)
            price_vat = order_line.get("price_vat", 0)
            try:
                decimal_value = Decimal(str(price_vat))  # 문자열로 변환 후 Decimal로 정확하게 파싱
            except InvalidOperation:
                price_vat_errors.append(sku)
            else:
                actual_decimal_places = get_actual_decimal_places(decimal_value)
                if actual_decimal_places > variant.price_decimal_places:
                    price_vat_errors.append(sku)

        if price_errors:
            error_msg = "판매가 소수점 오류: {}".format(", ".join(price_errors))
            raise ValidationError(error_msg)
        if price_vat_errors:
            error_msg = "판매가 부가세 소수점 오류: {}".format(", ".join(price_vat_errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_price_vat(
        cls, order_type, all_order_lines, pv_dict: Dict[str, "ProductVariantModel"]
    ):
        tax_free_price_vat_errors = []
        taxable_price_vat_errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            variant = pv_dict[sku]
            price_vat = order_line.get("price_vat", 0)
            if variant.product.is_tax_free:
                if price_vat != 0:
                    tax_free_price_vat_errors.append(sku)
            else:
                price = order_line.get("price", 0)
                if check_vat_value(price_vat, price, variant.price_decimal_places) == False:
                    taxable_price_vat_errors.append(sku)

        if tax_free_price_vat_errors:
            error_msg = "{} 상품 부가세 오류: {}".format(
                term_of_is_tax_free(True), ", ".join(tax_free_price_vat_errors)
            )
            raise ValidationError(error_msg)

        if taxable_price_vat_errors:
            error_msg = "{} 상품 부가세 오류: {}".format(
                term_of_is_tax_free(False), ", ".join(taxable_price_vat_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_deferred_pv(
        cls,
        order_type,
        all_order_lines,
        pv_dict: Dict[str, "ProductVariantModel"],
        bp_bundle_dict: Dict[str, "BpBundleModel"],
    ):
        errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            bp_bundle = bp_bundle_dict.get(sku)
            if not bp_bundle:
                variant = pv_dict[sku]
                if variant.is_deferred:
                    price = order_line.get("price")
                    price_vat = order_line.get("price_vat")
                    if price != 0 or price_vat != 0:
                        errors.append(sku)

        if errors:
            error_msg = "후정산 상품 판매가 또는 부가세 0 아님 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_orderable_qty(
        cls,
        info,
        order_type,
        all_order_lines,
        pv_dict: Dict[str, "ProductVariantModel"],
        bp_bundle_dict: Dict[str, "BpBundleModel"],
    ):
        # B2B 주문은 모두 위탁으로 처리하므로, 주문가능 수량 체크 불필요
        if order_type in ORDER_TYPES_FOR_B2B:
            return

        total_order_qty_dict = defaultdict(int)
        pv_dict_for_total_qty: Dict[str, "ProductVariantModel"] = {}
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for order_line in all_order_lines:
            sku = (
                order_line.get("bp_sku")
                if is_exist_brand_user_order_type
                else order_line.get("product_sku")
            )
            qty = order_line.get("qty", 0)
            bp_bundle = bp_bundle_dict.get(sku)
            if not bp_bundle:
                pv = pv_dict[sku]
                if pv.track_inventory == False:
                    continue
                if order_type == OrderType.BY_STAFF_FOR_ETC:
                    decrease_stock_flag = order_line.get("decrease_stock_flag")
                    if decrease_stock_flag == False:
                        continue
                elif order_type in ORDER_TYPES_BY_STAFF_OR_HQ_STAFF_FOR_BRAND:
                    delivery_method = order_line.get("delivery_method")
                    # 기타 배송인 경우 주문 된 상품을 모아서 배송 처리하는 건이라서 재고제품도 재고 수가 부족 에러 체크 안하는 것이 운영 상 편하다는 정책 적용
                    if delivery_method != OrderDeliveryMethods.BY_COURIER:
                        continue
                pv_dict_for_total_qty[pv.sku] = pv
                total_order_qty_dict[pv.sku] += qty
            else:
                bp_bundle_infos: List[BpBundleInfoModel] = bp_bundle.bp_bunde_infos_by_prefetched
                for bp_bundle_info in bp_bundle_infos:
                    pv = bp_bundle_info.pv
                    pv_dict_for_total_qty[pv.sku] = pv
                    total_order_qty_dict[pv.sku] += qty * bp_bundle_info.quantity

        country = info.context.country.code
        orderable_qty_errors = []
        for pv_sku, total_order_qty in total_order_qty_dict.items():
            pv = pv_dict_for_total_qty.get(pv_sku)
            try:
                check_stock_quantity_by_contury(pv, country, total_order_qty)
            except InsufficientStock as e:
                orderable_quantity = get_orderable_qty(e.item, country, until_short_term=True)
                error_msg = (
                    f"({pv_sku}) 총 주문수량={total_order_qty} > 주문가능수량={orderable_quantity}"
                )
                orderable_qty_errors.append(error_msg)
        if orderable_qty_errors:
            error_msg = "주문 가능 수량 부족: {}".format(", ".join(orderable_qty_errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_decrease_stock_flag(cls, order_type, details):
        if order_type != OrderType.BY_STAFF_FOR_ETC:
            return

        decrease_stock_flag_errors = []
        for detail in details:
            detail_code = cls.make_detail_code(order_type, detail)
            order_lines = detail.get("order_lines")
            for order_line in order_lines:
                # 기타 주문은 브랜드 유저가 없으므로 제품코드로 주문 처리됨
                sku = order_line.get("product_sku")
                # 위탁 제품도 재고 출고 유형으로 출고 될 수 있으므로 재고 반영 여부는 필수 입력 항목으로 처리
                decrease_stock_flag = order_line.get("decrease_stock_flag")
                if decrease_stock_flag is None:
                    decrease_stock_flag_errors.append(f"{detail_code}:{sku}")

        if decrease_stock_flag_errors:
            error_msg = "기타 배송 주문 재고 제품 재고 반영 여부 오류: {}".format(
                ", ".join(decrease_stock_flag_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_delivery_method(cls, order_type, details):
        if order_type == OrderType.BY_STAFF_FOR_B2B:
            errors = []
            for detail in details:
                detail_code = cls.make_detail_code(order_type, detail)
                delivery_method = detail.get("delivery_method")
                if (
                    delivery_method is None
                    or delivery_method != OrderDeliveryMethods.BY_TRUCK_SERVICE
                ):
                    errors.append(f"{detail_code}")

            if errors:
                error_msg = "B2B 주문 배송방법 오류: {}".format(", ".join(errors))
                raise ValidationError(error_msg)
        elif order_type not in [OrderType.BY_STAFF_FOR_BAD_STOCK, OrderType.BY_STAFF_FOR_ETC]:
            fulfill_type_errors = []
            for detail in details:
                detail_code = cls.make_detail_code(order_type, detail)
                delivery_method = detail.get("delivery_method")
                if delivery_method != OrderDeliveryMethods.BY_COURIER:
                    fulfill_type = detail.get("fulfill_type")
                    if fulfill_type not in [
                        FulfillType.ALL_TRACK_INVENTORY,
                        FulfillType.ALL_CONSIGNMENT,
                    ]:
                        fulfill_type_errors.append(f"{detail_code}")

            if fulfill_type_errors:
                error_msg = "출고 유형 에러 오류: {}".format(", ".join(fulfill_type_errors))
                raise ValidationError(error_msg)

    @classmethod
    def validate_order_line_value_empty(cls, order_type, details):
        price_errors = []
        price_vat_errors = []
        qty_errors = []
        calc_mileage_errors = []
        exclude_stock_avg_stats_errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for detail in details:
            detail_code = cls.make_detail_code(order_type, detail)
            order_lines = detail.get("order_lines")
            for order_line in order_lines:
                sku = (
                    order_line.get("bp_sku")
                    if is_exist_brand_user_order_type
                    else order_line.get("product_sku")
                )
                price = order_line.get("price")
                price_vat = order_line.get("price_vat")
                qty = order_line.get("qty")
                if order_type != OrderType.BY_STAFF_FOR_ETC:
                    if price is None or price < 0:
                        price_errors.append(f"{detail_code}:{sku}")
                    if price_vat is None or price_vat < 0:
                        price_vat_errors.append(f"{detail_code}:{sku}")
                if qty is None or qty <= 0:
                    qty_errors.append(f"{detail_code}:{sku}")

                if order_type == OrderType.BY_STAFF_FOR_BRAND:
                    calc_mileage = order_line.get("calc_mileage")
                    if calc_mileage is None:
                        calc_mileage_errors.append(f"{detail_code}:{sku}")
                    exclude_stock_avg_stats = order_line.get("exclude_stock_avg_stats")
                    if exclude_stock_avg_stats is None:
                        exclude_stock_avg_stats_errors.append(f"{detail_code}:{sku}")

        if len(price_errors) > 0:
            error_msg = "상품 판매가격 오류 주문: {}".format(", ".join(price_errors))
            raise ValidationError(error_msg)
        if len(price_vat_errors) > 0:
            error_msg = "상품 판매가격 부가세 오류 주문: {}".format(", ".join(price_vat_errors))
            raise ValidationError(error_msg)

        if len(qty_errors) > 0:
            error_msg = "상품 주문 수량 오류 주문: {}".format(", ".join(qty_errors))
            raise ValidationError(error_msg)

        if len(calc_mileage_errors) > 0:
            error_msg = "본부수익금 적용 여부 오류 주문: {}".format(", ".join(calc_mileage_errors))
            raise ValidationError(error_msg)

        if len(exclude_stock_avg_stats_errors) > 0:
            error_msg = "수요예측제외 여부 오류 주문: {}".format(
                ", ".join(exclude_stock_avg_stats_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_b2b_delivery_fee(
        cls,
        order_type,
        details,
        pv_dict: Dict[str, "ProductVariantModel"],
        brands_dict: Dict[str, "Brand"],
    ):
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        if not is_exist_brand_user_order_type:
            return

        bpv_errors = []
        errors = []
        for detail in details:
            detail_code = cls.make_detail_code(order_type, detail)
            order_lines = detail.get("order_lines")
            customer_login_id = detail.get("customer_login_id")
            brand = brands_dict[customer_login_id]
            for order_line in order_lines:
                b2b_delivery_fee_exclude_vat = order_line.get("b2b_delivery_fee_exclude_vat", 0)
                if b2b_delivery_fee_exclude_vat > 0:
                    sku = order_line.get("bp_sku")
                    variant = pv_dict[sku]
                    try:
                        bpv: BrandProductVariantModel = (
                            product_models.BrandProductVariant.objects.get(
                                product_variant=variant, brand=brand
                            )
                        )
                        if bpv.include_sales_b2b_delivery_fee:
                            errors.append(detail_code)
                    except ObjectDoesNotExist:
                        bpv_errors.append(detail_code)
                        continue
        if len(bpv_errors) > 0:
            error_msg = "상품 정보 없음 오류: {}".format(", ".join(bpv_errors))
            raise ValidationError(error_msg)
        if len(errors) > 0:
            error_msg = "판매가에 배송비 포함 상품에 b2b 배송비 입력 오류: {}".format(
                ", ".join(errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_fulfilled_by_vendor(
        cls, order_type, details, pv_dict: Dict[str, "ProductVariantModel"]
    ):
        by_staff_for_b2b_errors = []
        by_staff_for_etc_errors = []
        by_staff_for_bad_stock_errors = []
        by_staff_for_brand_errors = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for detail in details:
            detail_code = cls.make_detail_code(order_type, detail)
            order_lines = detail.get("order_lines")
            delivery_method = detail.get("delivery_method")
            for order_line in order_lines:
                sku = (
                    order_line.get("bp_sku")
                    if is_exist_brand_user_order_type
                    else order_line.get("product_sku")
                )
                variant = pv_dict[sku]
                if variant.product.is_fulfilled_by_vendor:
                    if order_type == OrderType.BY_STAFF_FOR_BAD_STOCK:
                        by_staff_for_bad_stock_errors.append(f"{detail_code}:{sku}")
                    elif order_type == OrderType.BY_STAFF_FOR_ETC:
                        by_staff_for_etc_errors.append(f"{detail_code}:{sku}")
                    elif order_type in [
                        OrderType.BY_STAFF_FOR_B2B,
                        OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
                    ]:
                        by_staff_for_b2b_errors.append(f"{detail_code}:{sku}")
                    elif order_type == OrderType.BY_STAFF_FOR_BRAND:
                        etc_delivery_fee = order_line.get("etc_delivery_fee", 0)
                        if (
                            delivery_method != OrderDeliveryMethods.BY_COURIER
                            or etc_delivery_fee > 0
                        ):
                            by_staff_for_brand_errors.append(f"{detail_code}:{sku}")
        if len(by_staff_for_bad_stock_errors) > 0:
            error_msg = "오픈몰 주문에 직거래 상품 포함 오류: {}".format(
                ", ".join(by_staff_for_bad_stock_errors)
            )
            raise ValidationError(error_msg)
        if len(by_staff_for_etc_errors) > 0:
            error_msg = "기타 배송 주문에 직거래 상품 포함 오류: {}".format(
                ", ".join(by_staff_for_etc_errors)
            )
            raise ValidationError(error_msg)
        if len(by_staff_for_b2b_errors) > 0:
            error_msg = "B2B 주문에 직거래 상품 포함 오류: {}".format(
                ", ".join(by_staff_for_b2b_errors)
            )
            raise ValidationError(error_msg)
        if len(by_staff_for_brand_errors) > 0:
            error_msg = "대행 주문에 포함된 직거래 상품 배송 방식 및 기타배송비 오류: {}".format(
                ", ".join(by_staff_for_brand_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_hq_staff(
        cls,
        info,
        order_type,
        details,
        pv_dict: Dict[str, "ProductVariantModel"],
        bpv_dict: Dict[str, "BrandProductVariantModel"],
        bp_bundle_dict: Dict[str, "BpBundleModel"],
        user_list: List["UserModel"],
    ):
        if order_type != OrderType.BY_HQ_STAFF_FOR_BRAND:
            return

        requester: "UserModel" = info.context.user
        if not requester.is_hq_staff:
            return

        if any(requester.brand_id != user.brand_id for user in user_list):
            raise ValidationError(f"다른 가맹본부의 유저에게 대행 주문할 수 없습니다.")

        if requester.brand.contract_type in [BrandContractType.REVERSE_FEE, BrandContractType.B2B]:
            raise ValidationError(
                "가맹본부가 직접 대행주문을 할 수 있는 계약방식이 아닙니다. 고객센터로 문의해 주세요."
            )

        sum_of_payment = 0
        for detail in details:
            shipping_address = detail.get("shipping_address")
            unit_additional_fee_exclude_vat = (
                get_unit_delivery_additional_fee_exclude_vat_by_address(shipping_address)
            )
            need_additional_fee = unit_additional_fee_exclude_vat > 0
            unit_additional_fee = calc_to_include_vat(unit_additional_fee_exclude_vat, False)
            delivery_method = detail.get("delivery_method")
            order_lines = detail.get("order_lines")
            delivery_box_count = 0
            for order_line in order_lines:
                sku = order_line.get("bp_sku")
                qty = order_line.get("qty", 0)
                if need_additional_fee and delivery_method == OrderDeliveryMethods.BY_COURIER:
                    delivery_box_count += (
                        get_delivery_box_count_by_staff_order_line_info_consider_bundle(
                            sku, qty, bp_bundle_dict, pv_dict, bpv_dict
                        )
                    )
                bp_bundle = bp_bundle_dict.get(sku)
                if bp_bundle:
                    sum_of_payment += Decimal(qty) * bp_bundle.price_amount
                else:
                    bpv = bpv_dict[sku]
                    sum_of_payment += Decimal(qty) * bpv.price_amount
            if need_additional_fee:
                if delivery_method == OrderDeliveryMethods.BY_COURIER:
                    sum_of_payment += unit_additional_fee * delivery_box_count
                else:
                    additional_fee_for_etc_delivery = detail.get(
                        "additional_fee_for_etc_delivery", 0
                    )
                    sum_of_payment += Decimal(additional_fee_for_etc_delivery)

        if requester.credits_incl_non_cashable < sum_of_payment:
            credits_total = to_locale_number(requester.credits_incl_non_cashable)
            total_price = to_locale_number(sum_of_payment)
            raise ValidationError(
                f"보유하신 충전금이 부족해서 요청하신 주문을 생성하지 못했습니다. 보유 충전금={credits_total} < 주문 총액={total_price}"
            )

    @classmethod
    def clean_details(cls, info, order_type, input_data):
        all_order_lines = []
        details = input_data.get("details")
        cls.validate_details_is_non_null(details)
        cls.validate_order_lines_is_non_null(order_type, details)
        cleaned_details = cls.clean_basic_info_for_hq_staff_order(order_type, details)
        cleaned_details = cls.clean_brand_product_package(order_type, cleaned_details)
        brands_dict, user_list = cls.validate_customer_login_id(order_type, cleaned_details)
        cls.validate_decrease_stock_flag(order_type, cleaned_details)
        cls.validate_delivery_method(order_type, cleaned_details)
        cls.validate_tax_invoice_request_flag(order_type, cleaned_details)

        for detail in cleaned_details:
            shipping_address = detail.get("shipping_address")
            cls.validate_address(shipping_address, instance=None, info=info)
            order_lines = detail.get("order_lines")
            delivery_method = detail.get("delivery_method")
            # validate_orderable_qty 내부에서 배송 방법이 택배인 건들에 대해서만 주문가능 수량 체크하는 로직을 유지하기 위해서 order_line 에 배송방법을 추가해 줌
            for order_line in order_lines:
                order_line["delivery_method"] = delivery_method
            all_order_lines.extend(order_lines)

        pv_dict, bpv_dict, bp_bundle_dict = cls.validate_sku(order_type, all_order_lines)
        cleaned_details = cls.clean_price_for_hq_staff_order(
            order_type, cleaned_details, pv_dict, bpv_dict, bp_bundle_dict
        )

        cls.validate_order_line_value_empty(order_type, cleaned_details)
        cls.validate_b2b_delivery_fee(order_type, cleaned_details, pv_dict, brands_dict)
        cls.validate_decimal_order_qty(order_type, all_order_lines, pv_dict)
        if order_type != OrderType.BY_STAFF_FOR_ETC:
            cls.validate_deferred_pv(order_type, all_order_lines, pv_dict, bp_bundle_dict)
            cls.validate_decimal_price(order_type, all_order_lines, pv_dict)
            cls.validate_price_vat(order_type, all_order_lines, pv_dict)
        cls.validate_orderable_qty(info, order_type, all_order_lines, pv_dict, bp_bundle_dict)
        cls.validate_fulfilled_by_vendor(order_type, cleaned_details, pv_dict)
        cls.validate_hq_staff(
            info, order_type, cleaned_details, pv_dict, bpv_dict, bp_bundle_dict, user_list
        )
        return cleaned_details, pv_dict, bp_bundle_dict

    @classmethod
    def build_checkout_create_by_staff_inputs(
        cls,
        order_type,
        details,
        pv_dict: Dict[str, "ProductVariantModel"],
        bp_bundle_dict: Dict[str, "BpBundleModel"],
    ):
        checkout_create_by_staff_inputs = []
        is_exist_brand_user_order_type = order_type in ORDER_TYPES_WITH_BRAND_USER
        for detail in details:
            staff_note = detail.get("staff_note")
            customer_note = detail.get("customer_note")
            customer_login_id = detail.get("customer_login_id")
            order_lines = detail.get("order_lines")
            checkout_lines = []
            for order_line in order_lines:
                sku = (
                    order_line.get("bp_sku")
                    if is_exist_brand_user_order_type
                    else order_line.get("product_sku")
                )
                if order_type == OrderType.BY_STAFF_FOR_ETC:
                    price = order_line.get("price", 0)
                    price_vat = order_line.get("price_vat", 0)
                else:
                    price = order_line.get("price")
                    price_vat = order_line.get("price_vat")
                qty = order_line.get("qty")
                calc_mileage = order_line.get("calc_mileage", True)
                exclude_stock_avg_stats = order_line.get("exclude_stock_avg_stats", False)
                decrease_stock_flag = order_line.get("decrease_stock_flag", True)
                etc_delivery_fee = order_line.get("etc_delivery_fee", 0)
                b2b_delivery_fee_exclude_vat = order_line.get("b2b_delivery_fee_exclude_vat", 0)
                bp_bundle = bp_bundle_dict.get(sku)
                variant = pv_dict.get(sku) if not bp_bundle else None
                checkout_line_input = {
                    "bp_bundle_id": (
                        graphene.Node.to_global_id("BpBundle", bp_bundle.id) if bp_bundle else None
                    ),
                    "variant_id": (
                        graphene.Node.to_global_id("ProductVariant", variant.id)
                        if variant
                        else None
                    ),
                    "quantity": qty,
                    "price": price,
                    "price_vat": price_vat,
                    "calc_mileage": calc_mileage,
                    "exclude_stock_avg_stats": exclude_stock_avg_stats,
                    "decrease_stock_flag": decrease_stock_flag,
                    "etc_delivery_fee": etc_delivery_fee,
                    "b2b_delivery_fee_exclude_vat": b2b_delivery_fee_exclude_vat,
                }
                checkout_lines.append(checkout_line_input)
            etc_info = {}
            if order_type == OrderType.BY_STAFF_FOR_BAD_STOCK:
                etc_info = {
                    "open_mall_name": detail.get("open_mall_name"),
                    "open_mall_order_number": detail.get("open_mall_order_number"),
                }
            delivery_method = detail.get("delivery_method")
            fulfill_type = detail.get("fulfill_type")
            additional_fee_for_etc_delivery = (
                detail.get("additional_fee_for_etc_delivery", 0)
                if delivery_method != OrderDeliveryMethods.BY_COURIER
                else 0
            )
            checkout_create_by_staff_input = {
                "lines": checkout_lines,
                "shipping_address": detail.get("shipping_address"),
                "order_type": order_type,
                "staff_note": staff_note,
                "delivery_method": delivery_method,
                "fulfill_type": fulfill_type,
                "estimated_arrival_date": detail.get("estimated_arrival_date"),
                "additional_fee_for_etc_delivery": additional_fee_for_etc_delivery,
                "note": customer_note,
                "customer_login_id": customer_login_id,
                "alt_invoicee_biz_info": (
                    detail.get("alt_invoicee_biz_info")
                    if order_type == OrderType.BY_STAFF_FOR_BRAND
                    else None
                ),
                "tax_invoice_request_flag": detail.get("tax_invoice_request_flag"),
                "etc_info": etc_info,
            }
            checkout_create_by_staff_inputs.append(checkout_create_by_staff_input)

        return checkout_create_by_staff_inputs

    @classmethod
    def call_checkout_create_by_staff_mutation(
        cls,
        root,
        info,
        order_type,
        details,
        checkout_create_by_staff_inputs,
    ):
        checkouts = []
        for detail, checkout_create_by_staff_input in zip(details, checkout_create_by_staff_inputs):
            response = CheckoutCreateByStaff.mutate(
                root, info, input=checkout_create_by_staff_input
            )
            detail_code = cls.make_detail_code(order_type, detail)
            if response.errors:
                raise ValidationError(
                    f"{detail_code}: checkout 생성 과정 에러 - {response.errors[0].message}"
                )

            checkout = response.checkout
            if checkout:
                checkouts.append(checkout)
            else:
                raise ValidationError(f"{detail_code}: checkout 생성 실패")

        return checkouts

    @classmethod
    def build_payment_inputs(cls, order_type, checkouts: List[Checkout]):
        payment_inputs = []
        is_hq_staff_order_type = order_type == OrderType.BY_HQ_STAFF_FOR_BRAND
        gateway = (
            PaymentGatewayType.RIU_POINTS
            if is_hq_staff_order_type
            else PaymentGatewayType.RIU_DEFFERRED
        )
        token = RIU_PAY_METHOD_POINTS_ONLY if is_hq_staff_order_type else RIU_PAY_METHOD_DEFERRED
        for checkout in checkouts:
            checkout_id = graphene.Node.to_global_id("Checkout", checkout.token)
            input = {
                "gateway": gateway,
                "token": token,
            }
            payment_input = {"checkout_id": checkout_id, "input": input}
            payment_inputs.append(payment_input)

        return payment_inputs

    @classmethod
    def call_checkout_payment_create_mutation(cls, root, info, order_type, details, payment_inputs):
        payments = []
        for detail, payment_input in zip(details, payment_inputs):
            checkout_id = payment_input.get("checkout_id")
            input = payment_input.get("input")
            response = CheckoutPaymentCreate.mutate(
                root, info, checkout_id=checkout_id, input=input
            )
            detail_code = cls.make_detail_code(order_type, detail)
            if response.errors:
                raise ValidationError(
                    f"{detail_code}: payment 생성 과정 에러 - {response.errors[0].message}"
                )

            payment = response.payment
            if payment:
                payments.append(payment)
            else:
                raise ValidationError(f"{detail_code}: payment 생성 실패")

        return payments

    @classmethod
    def call_checkout_complete_mutation(
        cls, root, info, order_type, details, checkouts: List[Checkout]
    ):
        orders = []
        for detail, checkout in zip(details, checkouts):
            checkout_id = graphene.Node.to_global_id("Checkout", checkout.token)
            response = CheckoutComplete.mutate(root, info, checkout_id=checkout_id)
            detail_code = cls.make_detail_code(order_type, detail)
            if response.errors:
                raise ValidationError(
                    f"{detail_code}: order 생성 과정 에러 - {response.errors[0].message}"
                )

            order = response.order
            if order:
                orders.append(order)
            else:
                raise ValidationError(f"{detail_code}: order 생성 실패")

        return orders

    # 엑셀 정보의 주소를 list로 만들어서 한번에 주소를 조회하여 postal_code를 업데이트 한다.
    @classmethod
    def update_postal_codes_in_details(cls, root, info, input_data):
        details = input_data.get("details")
        addresses = []
        postal_codes = []
        for detail in details:
            addresses.append(detail.get("shipping_address").get("street_address_1"))
            postal_codes.append(detail.get("shipping_address").get("postal_code", None))
        postal_code_response = GetPostalCodesFromAddressesBulk.mutate(
            root, info, addresses=addresses, postal_codes=postal_codes
        )
        postal_code_results = postal_code_response.postal_codes
        postal_code_errors = postal_code_response.account_errors

        if len(postal_code_errors) > 0:
            raise ValidationError(f"{postal_code_errors[0].message}")

        for idx, find_postal_code in enumerate(postal_code_results):
            details[idx].shipping_address.update({"postal_code": find_postal_code.postal_code})

    @classmethod
    def add_order_shipping_address_to_user_if_new(cls, order: models.Order):
        user = order.user
        if user is None:
            return
        address_to_copy = order.shipping_address
        target_postal_code = address_to_copy.postal_code

        address_exists = user.addresses.filter(postal_code=target_postal_code).exists()

        if address_exists:
            return

        address_to_copy.id = None
        address_to_copy.save()
        user.addresses.add(address_to_copy)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        order_type = data.get("type")
        cls.validate_order_type(order_type)

        input_data = data.get("input")
        cls.update_postal_codes_in_details(root, info, input_data)

        details, pv_dict, bp_bundle_dict = cls.clean_details(
            info=info, order_type=order_type, input_data=input_data
        )
        request_count = len(details)
        logger.info(
            f"order_by_staff_debug: OrderBulkCreateByStaff mutation {order_type} 요청 주문 개수:{request_count}"
        )

        checkout_create_inputs = cls.build_checkout_create_by_staff_inputs(
            order_type, details, pv_dict, bp_bundle_dict
        )
        checkouts = cls.call_checkout_create_by_staff_mutation(
            root, info, order_type, details, checkout_create_inputs
        )
        checkout_count = len(checkouts)
        logger.info(
            f"order_by_staff_debug: call_checkout_create_mutation mutation {order_type} checkout 개수:{checkout_count}"
        )
        if request_count != checkout_count:
            raise ValidationError(
                "checkout 생성 과정 오류 발생으로 대행 주문 요청이 취소되었습니다."
            )

        payment_inputs = cls.build_payment_inputs(order_type, checkouts)
        payments = cls.call_checkout_payment_create_mutation(
            root, info, order_type, details, payment_inputs
        )
        payment_count = len(payments)
        logger.info(
            f"order_by_staff_debug: call_checkout_payment_create_mutation mutation {order_type} payment 개수:{payment_count}"
        )
        if request_count != payment_count:
            raise ValidationError(
                "payment 생성 과정 오류 발생으로 대행 주문 요청이 취소되었습니다."
            )

        orders = cls.call_checkout_complete_mutation(root, info, order_type, details, checkouts)
        for order in orders:
            cls.add_order_shipping_address_to_user_if_new(order)

        order_count = len(orders)
        logger.info(
            f"order_by_staff_debug: call_checkout_complete_mutation mutation {order_type} order 개수:{order_count}"
        )
        if request_count != order_count:
            raise ValidationError("order 생성 과정 오류 발생으로 대행 주문 요청이 취소되었습니다.")

        hq_staff_user = None
        if order_type == OrderType.BY_HQ_STAFF_FOR_BRAND:
            hq_staff_user = info.context.user
            hq_staff_user.refresh_from_db()

        return OrderBulkCreateByStaff(order_count=order_count, hq_staff_user=hq_staff_user)
