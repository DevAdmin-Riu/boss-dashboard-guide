    )
    variants = graphene.List(ProductVariant, description="List of variants for the product.")
    outer_variants = graphene.List(
        ProductVariant, description="List of outer variants for the product."
    )
    inner_variants = graphene.List(
        ProductVariant, description="List of inner variants for the product."
    )
    images = graphene.List(lambda: ProductImage, description="List of images for the product.")
    collections = graphene.List(
        lambda: Collection, description="List of collections for the product."
    )
    description = graphene.String(
        description="Description of the product.",
        deprecation_reason="Use the `descriptionJson` field instead.",
        required=True,
    )
    category_id = graphene.ID(description="대량 데이터 쿼리 성능 개선을 위해 id 만 리턴")
    product_type_id = graphene.ID(description="대량 데이터 쿼리 성능 개선을 위해 id 만 리턴")
    default_variant_id = graphene.ID(description="대량 데이터 쿼리 성능 개선을 위해 id 만 리턴")

    brand_product = graphene.Field(
        BrandProduct,
        description="브랜드 상품 정보",
    )

    product_info_notification = GenericScalar(description="상품 정보 고시")

    class Meta:
        description = "Represents an individual item for sale in the storefront."
        interfaces = [relay.Node]
        model = models.Product
        only_fields = [
            "category",
            "charge_taxes",
            "is_tax_free",
            "id",
            "name",
            "slug",
            "product_type",
            "updated_at",
            "weight",
            "default_variant",
            "moq",
            "uoq",
            "allow_mixed_multiple_of_uoq",
            "is_exclusive",
            "is_fulfilled_by_vendor",
        ]

    def resolve_category_id(root: ProductModel, _info):
        if root.category_id:
            return graphene.Node.to_global_id("Category", root.category_id)
        return None

    def resolve_product_type_id(root: ProductModel, _info):
        if root.product_type_id:
            return graphene.Node.to_global_id("ProductType", root.product_type_id)
        return None

    def resolve_default_variant_id(root: ProductModel, _info):
        if root.default_variant_id:
            return graphene.Node.to_global_id("ProductVariant", root.default_variant_id)
        return None

    def resolve_default_variant(root: ProductModel, info):
        default_variant_id = root.default_variant_id
        if default_variant_id is None:
            return None
        return ProductVariantByIdLoader(info.context).load(root.default_variant_id)

    def resolve_category(root: ProductModel, info):
        category_id = root.category_id
        if category_id is None:
            return None

        return CategoryByIdLoader(info.context).load(category_id)

    def resolve_thumbnail(root: ProductModel, info, *, size=255):
        def return_first_thumbnail(images):
            image = images[0] if images else None
            if image:
                url = get_product_image_thumbnail(image, size, method="thumbnail")
                alt = image.alt
                return Image(alt=alt, url=info.context.build_absolute_uri(url))
            return None

        return ImagesByProductIdLoader(info.context).load(root.id).then(return_first_thumbnail)

    def resolve_name(root: ProductModel, info):
        context = info.context
        user = context.user
        if not user.is_anonymous and user.is_brand_user:
            brand_product = BrandProductByProductIdLoader(context).load(root.id)

            def get_product_name_with_brand_product(brand_product):
                if brand_product and brand_product.name:
                    return brand_product.name
                return root.name

            return brand_product.then(get_product_name_with_brand_product)

        return root.name

    def resolve_pricing(root: ProductModel, info):
        context = info.context
        variants = ProductVariantsByProductIdLoader(context).load(root.id)
        brand_product = BrandProductByProductIdLoader(context).load(root.id)

        def calculate_pricing_with_variants(variants):
            def calculate_pricing_with_brand_prodcut(brand_product):
                availability = get_product_availability(
                    variants=variants,
                    plugins=context.plugins,
                    user=context.user,
                    brand_product=brand_product,
                )
                return ProductPricingInfo(**asdict(availability))

            return brand_product.then(calculate_pricing_with_brand_prodcut)

        return variants.then(calculate_pricing_with_variants)

    def resolve_delivery_fee(root: ProductModel, info):
        context = info.context
        variants = ProductVariantsByProductIdLoader(context).load(root.id)
        brand_product = BrandProductByProductIdLoader(context).load(root.id)

        def calculate_delivery_fee_info_variants(variants):
            def calculate_delivery_fee_info_brand_product(brand_product):
                availability = get_product_availability_delivery_fee(
                    variants=variants,
                    user=context.user,
                    brand_product=brand_product,
                )
                return DeliveryFeeInfo(**asdict(availability))

            return brand_product.then(calculate_delivery_fee_info_brand_product)

        return variants.then(calculate_delivery_fee_info_variants)

    def resolve_attributes(root: ProductModel, info):
        return SelectedAttributesByProductIdLoader(info.context).load(root.id)

    def resolve_image_by_id(root: ProductModel, info, id):
        pk = get_database_id(info, id, ProductImage)
        try:
            return root.images.get(pk=pk)
        except models.ProductImage.DoesNotExist:
            raise GraphQLError("Product image not found.")

    def resolve_images(root: ProductModel, info, **_kwargs):
        return ImagesByProductIdLoader(info.context).load(root.id)

    def resolve_variants(root: ProductModel, info, **_kwargs):
        return ProductVariantsByProductIdLoader(info.context).load(root.id)

    def resolve_outer_variants(root: ProductModel, info, **_kwargs):
        return (
            ProductVariantsByProductIdLoader(info.context)
            .load(root.id)
            .then(lambda variants: [variant for variant in variants if variant.outer_id is None])
        )

    def resolve_inner_variants(root: ProductModel, info, **_kwargs):
        return (
            ProductVariantsByProductIdLoader(info.context)
            .load(root.id)
            .then(
                lambda variants: [variant for variant in variants if variant.outer_id is not None]
            )
        )

    def resolve_collections(root: ProductModel, info, *_args):
        return CollectionsByProductIdLoader(info.context).load(root.id)

