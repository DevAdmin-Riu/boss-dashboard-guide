import logging

from ..celeryconf import app
from ..core.utils.kst_time import kst_date
from ..order.utils import update_stats_sales_info_on_tax_invoice_issued
from ..plugins.manager import get_plugins_manager
from ..taxinvoice import TaxInvoiceStatus
from ..taxinvoice.models import TaxInvoice

logger = logging.getLogger()


@app.task(name="taxinvoice.tasks.create_tax_invoice_issue")
def create_tax_invoice_issue():
    check_date = kst_date()

    # 재고 소진용 대행 주문은 발행 요청 등록을 주문시점에도 하지 않고, 수동 등록 mutation 에서도 하지 않는 것으로 차단되어 여기서는 굳이 order type 필터링은 하지 않음
    target_tax_invoices_qs = TaxInvoice.objects.filter(
        status=TaxInvoiceStatus.REQUESTED,
        auto_issue_date__lte=check_date,
        write_date__isnull=False,
    ).exclude(total_amount=0)

    target_tax_invoices = list(target_tax_invoices_qs)

    target_list_count = len(target_tax_invoices)
    logger.info(f"create_tax_invoice_issue target_tax_invoices count: {target_list_count}")

    manager = get_plugins_manager()
    update_stats_sales_list = []
    for tax_invoice in target_tax_invoices:
        try:
            return_tax_invoice: TaxInvoice = manager.tax_invoice_issue(
                tax_invoice=tax_invoice, requester=None
            )
            if return_tax_invoice and return_tax_invoice.status == TaxInvoiceStatus.ISSUED:
                update_stats_sales_list.append(return_tax_invoice)
        except Exception as e:
            logger.error(f"create_tax_invoice_issue error: {e}")

    update_stats_sales_info_on_tax_invoice_issued(update_stats_sales_list)

    updated_list_count = len(update_stats_sales_list)
    if updated_list_count < target_list_count:
        logger.error(f"세금계산서 발행 실패: {target_list_count - updated_list_count}")
