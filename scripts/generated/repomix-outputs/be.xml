import logging
import os

import firebase_admin
from firebase_admin import credentials, messaging

from saleor.account import RequestOriginType


def get_firebase_project_name_from_target_app_type(target_app_type: RequestOriginType) -> str:
    # target_app_type에 따라 firebase project name 리턴
    target_app_type_to_project = {
        RequestOriginType.MALL: "storefront",
        RequestOriginType.DASHBOARD: "dashboard",
    }

    for app_type, project_name in target_app_type_to_project.items():
        if target_app_type.startswith(app_type):
            return project_name
    raise ValueError(
        f"Invalid target app type: {target_app_type}. Expected one of {list(target_app_type_to_project.keys())}"
    )


# Firebase Admin SDK를 초기화
def initialize_firebase(project_name: str):
    # 이미 초기화된 앱이 있는지 확인
    try:
        return firebase_admin.get_app(project_name)
    except ValueError:
        # 앱이 초기화되지 않은 경우에만 초기화
        base_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "firebase")
        credential_path = os.path.join(base_dir, f"{project_name}-firebase-adminsdk.json")

        if not os.path.exists(credential_path):
            raise FileNotFoundError(f"Firebase credential file not found: {credential_path}")

        cred = credentials.Certificate(credential_path)

        app = firebase_admin.initialize_app(cred, name=project_name)
        logging.info(f"Initializing Firebase app with name: {project_name}")

        return app


# FCM 메시지 전송 함수
def send_fcm_message(
    fcm_token: str, target_app_type: RequestOriginType, title: str, content: str, data: dict = None
) -> bool:
    project_name = get_firebase_project_name_from_target_app_type(target_app_type)
    app = initialize_firebase(project_name)

    message = messaging.Message(
        notification=messaging.Notification(title=title, body=content),
        token=fcm_token,
        data=data or {},
    )

    try:
        messaging.send(message, app=app)
    except Exception as e:
        logging.error(f"FCM 전송 실패: {target_app_type} - {title} - {e}")
        return False
    return True
