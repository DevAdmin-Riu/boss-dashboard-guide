from collections import defaultdict
from typing import TYPE_CHECKING, Dict, List

import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ....core.permissions import OrderPermissions
from ....order import NON_B2B_ORDER_PREFIX, models
from ....order.models import OrderLine as OrderLineModel
from ....product.models import ProductVariant
from ....warehouse import models as warehouse_models
from ...core.mutations import BaseMutation
from ...core.types.common import OrderError
from ..types import OrderLine
from .fulfillments import OrderFulfillForPicking

if TYPE_CHECKING:
    from ....warehouse.models import BatchPicking


class PickingOrderFulfillInput(graphene.InputObjectType):
    order_line_ids = graphene.List(
        graphene.ID, required=True, description="이너 order_line id 리스트"
    )


class PickingOrderFulfill(BaseMutation):
    class Arguments:
        input = PickingOrderFulfillInput(
            required=True, description="소분 후 출고 처리할 이너 order lines 정보"
        )

    class Meta:
        description = "피킹 대기 화면에서 소분 후 출고 처리"
        permissions = (OrderPermissions.MANAGE_FULFILLMENT,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def merge_order_liens(cls, order_lines: List[OrderLineModel]):
        merged_lines: Dict[str, dict] = defaultdict(dict)
        for order_line in order_lines:
            inner_variant: ProductVariant = order_line.variant
            outer_variant: ProductVariant = inner_variant.outer
            sku = outer_variant.sku
            outer_virtual_allocate = order_line.outer_virtual_allocate
            if sku not in merged_lines:
                merged_lines[sku] = {
                    "outer_virtual_allocate": 0,
                    "inner_variant": inner_variant,
                    "outer_variant": outer_variant,
                }
            merged_lines[sku]["outer_virtual_allocate"] += outer_virtual_allocate
        return merged_lines

    @classmethod
    def validate_order_lines(cls, order_lines: List[OrderLineModel]):
        if len(order_lines) == 0:
            raise ValidationError("피킹 진행 대상이 비어 있습니다.")

        filtered_list = filter(lambda obj: obj.variant.outer_id is None, order_lines)
        has_false_condition = len(list(filtered_list)) > 0

        if has_false_condition:
            raise ValidationError("피킹 진행 대상에 아우터 제품이 포함되어 있습니다.")

    @classmethod
    def validate_virtual_allocated(cls, order_lines: List[OrderLineModel]):
        errors = []
        for order_line in order_lines:
            allocations_qs = order_line.allocations.filter(quantity_virtual_allocated__gt=0)
            if allocations_qs.count() > 0:
                errors.append(
                    f"{NON_B2B_ORDER_PREFIX}{order_line.order_id}: {order_line.variant.sku}"
                )

        if errors:
            error_msg = "추가 소분 필요 주문-제품 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def start_batch_picking(cls, requestor, order_lines: List[OrderLineModel]):
        batch_picking = warehouse_models.BatchPicking.objects.create(user=requestor)

        for order_line in order_lines:
            order_line.batch_picking = batch_picking
        models.OrderLine.objects.bulk_update(order_lines, ["batch_picking"])

        return batch_picking

    @classmethod
    def clean_input(cls, _info, data):
        cleaned_input = data.get("input")
        order_line_ids = cleaned_input.get("order_line_ids")
        order_lines: List[OrderLineModel] = cls.get_nodes_or_error(
            order_line_ids,
            "id",
            OrderLine,
            qs=(
                models.OrderLine.objects.select_related("variant")
                .prefetch_related("variant__outer", "allocations")
                .select_for_update(of=("self",))
            ),
        )
        cls.validate_order_lines(order_lines)
        cls.validate_virtual_allocated(order_lines)

        merged_order_lines = cls.merge_order_liens(order_lines)

        return order_line_ids, order_lines, merged_order_lines

    @classmethod
    def call_order_fulfill_for_picking_mutation(
        cls,
        root,
        info,
        order_line_ids,
        batch_picking: "BatchPicking",
    ):
        order_fulfill_for_picking_input = {
            "order_line_ids": order_line_ids,
            "batch_picking_id": graphene.Node.to_global_id("BatchPicking", batch_picking.id),
        }
        response = OrderFulfillForPicking.mutate(root, info, input=order_fulfill_for_picking_input)
        if response.errors:
            raise ValidationError(f"합포장 출고 처리 에러 - {response.errors[0].message}")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        requestor = info.context.user
        order_line_ids, order_lines, merged_order_lines = cls.clean_input(info, data)

        batch_picking = cls.start_batch_picking(requestor, order_lines)
        cls.call_order_fulfill_for_picking_mutation(root, info, order_line_ids, batch_picking)

        return PickingOrderFulfill()
