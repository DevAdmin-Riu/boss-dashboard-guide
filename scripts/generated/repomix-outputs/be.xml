        raise Exception(exception_message)

    order: Order = order_models.Order.objects.filter(id=order_id).first()
    if order is None:
        exception_message = f"알림톡 발송 실패 order 오브젝트 없음: {talk_event_code}, {parameters}"
        raise Exception(exception_message)

    # 스태프 주문은 알리고 이벤트 발송 안함
    if order.type != OrderType.BY_USER:
        return

    user = order.user
    if user is None:
