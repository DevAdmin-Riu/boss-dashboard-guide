def send_templated_mail_notify_vact_count(manager_email, context):
    mail_title_for_log = "가상계좌 추가 필요 메일 발송"
    recipient_list = []
    if manager_email:
        recipient_list.append(manager_email)

    if len(recipient_list) == 0:
        logger.info(f"{mail_title_for_log}을 위한 담당자 이메일 설정을 확인하세요. {context}")
        return

    send_kwargs, ctx = get_email_context()
    ctx.update(context)
    send_templated_mail_consider_test_mode(
        mail_title_for_log=mail_title_for_log,
        template_name="vacs/notify_vact_count",
        recipient_list=recipient_list,
        context=ctx,
        **send_kwargs,
    )
