from typing import TYPE_CHECKING

from django.core.exceptions import ValidationError

from saleor.order import OrderType
from saleor.product.models import ProductVariant

if TYPE_CHECKING:
    from saleor.order.models import OrderLine


def validate_is_fbv(order_line: "OrderLine"):
    vendor_exists = order_line.vendor_id is not None
    if order_line.is_fulfilled_by_vendor != vendor_exists:
        raise ValidationError("is_fulfilled_by_vendor와 vendor 설정이 일치하지 않습니다.")


def validate_is_dev_variant(order_line: "OrderLine"):
    if not order_line.pk:
        variant: ProductVariant = order_line.variant
        order = order_line.order

        if not variant or not variant.is_dev_pv:
            return

        # 개발비 제품은 대행, B2B 주문만 허용 (가맹본부 대행주문에서는 주문 불가)
        allowed_order_types = {
            OrderType.BY_STAFF_FOR_BRAND,  # 대행 주문
            OrderType.BY_STAFF_FOR_B2B,  # B2B주문
        }

        if order.type not in allowed_order_types:
            raise ValidationError("개발비 제품은 대행,B2B 주문에서만 사용할 수 있습니다.")

        if not order.user or not order.user.is_hq_staff:
            raise ValidationError("개발비는 가맹본부에게만 청구할 수 있습니다.")

        # 수량이 1보다 큰 경우 에러.
        if order_line.quantity > 1:
            raise ValidationError("개발비 제품은 수량이 1개만 허용됩니다.")
