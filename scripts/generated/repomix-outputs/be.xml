class PreFounderMixin:
    @classmethod
    def clean_basic_documents(cls, info, instance, data):
        basic_documents = data.get("basic_documents") or []
        for item in basic_documents:
            if isinstance(item, dict) and "file" in item:
                file_key = item["file"]
                if file_key is not None:
                    item["file"] = info.context.FILES.get(file_key, item["file"])

        return basic_documents

    @classmethod
    def upsert_basic_documents(cls, info, instance, cleaned_input):
        basic_documents_data = cleaned_input.get("basic_documents")
        if not basic_documents_data:
            return

        for doc in basic_documents_data:
            doc_type = doc.get("type")
            if not doc_type:
                continue

            doc_instance, created = PreFounderBasicDocumentModel.objects.get_or_create(
                pre_founder=instance, type=doc_type
            )

            # file 키가 존재하면 (None 포함) 의도적 변경으로 해석
            if "file" in doc:
                new_file = doc["file"]
                if new_file is None:
                    doc_instance.delete()
                else:
                    doc_instance.file = new_file
                    doc_instance.file_name = new_file.name if new_file else ""
                    doc_instance.save()

    @classmethod
    def construct_instance(cls, info, instance, cleaned_data):
        cleaned_data["address"] = cls.prepare_address(cleaned_data, instance)
        return super().construct_instance(info, instance, cleaned_data)


