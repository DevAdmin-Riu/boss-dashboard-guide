    plugin_configs = get_plugins_manager().get_plugin_config_dot_map(ALIGO_PLUGIN_ID)
    if not plugin_configs:
        return None
    try:
        server_mode = settings.SERVER_MODE
        server_mode_enum = ServerModeEnum(server_mode)
        is_prod_mode = plugin_configs.is_prod_mode and is_prod_server_mode(server_mode_enum)
        target_phone = receiver_phone if is_prod_mode else plugin_configs.dev_test_phone
