class BpBundleInfoBulkAdd(BpBundleInfoAdd):
    bp_bundle = graphene.Field(BpBundle, description="브랜드 세트 상품")

    class Arguments:
        input = graphene.List(
            BpBundleInfoAddInput,
            required=True,
            description="Fields required when creating bp bundle info.",
        )

    class Meta:
        description = "create bp bundle info bulk."
        model = models.BpBundleInfo
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def construct_instances(cls, info, instances: List[BpBundleInfoModel], cleaned_inputs):
        for instance, cleaned_input in zip(instances, cleaned_inputs):
            cls.construct_instance(info, instance, cleaned_input)
        return instances

    @classmethod
    def clean_instances(cls, info, instances):
        for instance in instances:
            super().clean_instance(info, instance)

    @classmethod
    def save(cls, info, instances):
        models.BpBundleInfo.objects.bulk_create(instances)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input", [])
        instances: List[BpBundleInfoModel] = [cls.get_instance(info, **item) for item in input_data]
        if len(instances) == 0:
            raise ValidationError("추가할 세트 상품 정보가 없습니다.")
        cleaned_inputs = [
            # super().clean_input(info, instance, item)
            # 왜인지 위의방식으로 안됨.
            # clean_input 마지막 인자 필요. 기존 Argument input의 타입과 다르므로.
            super(BpBundleInfoBulkAdd, cls).clean_input(info, instance, item, BpBundleInfoAddInput)
            for instance, item in zip(instances, input_data)
        ]
        instances = cls.construct_instances(info, instances, cleaned_inputs)
        cls.clean_instances(info, instances)
        cls.save(info, instances)
        bp_bundle: BpBundleModel = instances[0].bp_bundle
        for instance, cleaned_input in zip(instances, cleaned_inputs):
            cls.post_save_action(info, instance, cleaned_input)
        return cls(bp_bundle=bp_bundle)


