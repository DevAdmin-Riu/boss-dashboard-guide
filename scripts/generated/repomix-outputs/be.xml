class BsTrainingDocPublishedQuerySet(PublishedQuerySet):
    @staticmethod
    def user_has_access_to_all(user: "User"):
        return user.from_dashboard and user.is_staff

    def visible_to_user(self, user: "User"):
        if not user.is_authenticated:
            return self.none()
        if self.user_has_access_to_all(user):
            return self.all()
        if user.from_dashboard and user.is_hq_staff:
            return self.filter(owner_brand_id=user.brand_id).distinct()
        return self.published().filter(owner_brand_id=user.brand_id).distinct()


