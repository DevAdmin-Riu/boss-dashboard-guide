    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        updated_product = None
        updated_variant = None

        product_id = data.get("product_id")
        product_input = data.get("product_input")
        product_variant_id = data.get("product_variant_id")
        product_variant_input = data.get("product_variant_input")
        additional_input = data.get("additional_input")
        product_to_be_changed_info_create_input = data.get(
            "product_to_be_changed_info_create_input"
        )

        # 수정 전 instance들
        before_product = (
            cls.get_node_or_error(info, product_id, field="product_id", only_type=Product)
            if product_id
            else None
        )
        before_variant = (
            cls.get_node_or_error(
                info,
                product_variant_id,
                field="product_variant_id",
                only_type=ProductVariant,
            )
            if product_variant_id
            else None
        )
        before_inner_variant = before_variant.inner if before_variant else None
        # 아래 코드 위치 이동 금지. 수정전 스냅샷 찍는 거임.
        before_product_m2m_and_related_values, before_variant_m2m_and_related_values = (
            prepare_m2m_and_related_values(before_product, before_variant)
        )

        # 수정 작업
        if product_id and product_input:
            product_input["skip_pv_save"] = True
            product_update_result = ProductUpdate.perform_mutation(
                _root,
                info,
                id=product_id,
                input=product_input,
            )
            updated_product = product_update_result.product

        if product_variant_id and product_variant_input:
            product_variant_update_result = ProductVariantUpdate.perform_mutation(
                _root,
                info,
                id=product_variant_id,
                input=product_variant_input,
            )
            updated_variant = product_variant_update_result.productVariant
            updated_product = updated_variant.product
        if product_to_be_changed_info_create_input:
            product_to_be_changed_info_create_result = (
                ProductToBeChangedInfoCreate.perform_mutation(
                    _root,
                    info,
                    input=product_to_be_changed_info_create_input,
                )
            )
            updated_variant = product_to_be_changed_info_create_result.product_variant
            updated_product = updated_variant.product

        # 특이 사항을 처리 하는 경우 id가 넘어오므로 여기에서 수정 필요.(변경 이력 뽑기 전에)
        product_to_be_changed_info_id = (
            additional_input.get("product_to_be_changed_info_id") if additional_input else None
        )
        product_to_be_changed_info = None
        if product_to_be_changed_info_id:
            product_to_be_changed_info = cls.get_node_or_error(
                info, product_to_be_changed_info_id, only_type=ProductToBeChangedInfo
            )
            # product나 variant 업데이트 없는 경우가 있어서 None으로 바꾸기 전에 넣어준다.
            updated_variant = product_to_be_changed_info.product_variant
            updated_product = updated_variant.product

            product_to_be_changed_info.product_variant = None
            product_to_be_changed_info.save(update_fields=["product_variant"])

        manage_event = additional_input.get("manage_event")
        if manage_event:
            product_changes, variant_changes, inner_variant_changes = (
                make_total_change_summary_for_product_and_variant(
                    before_variant=before_variant,
                    before_inner_variant=before_inner_variant,
                    before_product=before_product,
                    before_product_m2m_and_related_values=before_product_m2m_and_related_values,
                    before_variant_m2m_and_related_values=before_variant_m2m_and_related_values,
                    updated_variant=updated_variant,
                    updated_product=updated_product,
                )
            )
            change_details = "\n".join(product_changes + variant_changes + inner_variant_changes)
            manage_event["change_details"] = change_details
            pv = updated_variant or before_variant or updated_product.default_variant
            manage_event_instance = add_pv_manage_event(pv=pv, manage_event=manage_event, info=info)
            # 특이 사항이 처리 된 경우, 해당 처리 때 manage_event_instance를 넣어준다.
            if product_to_be_changed_info:
                product_to_be_changed_info.product_variant_manage_event = manage_event_instance
                product_to_be_changed_info.save(update_fields=["product_variant_manage_event"])

        # 반환
        return ExtendedProductUpdate(
            product=updated_product,
            product_variant=updated_variant,
        )


class ProductVariantOnSale(BaseMutation):
    pv = graphene.Field(ProductVariant, description="Updated product variant.")

    class Arguments:
        id = graphene.ID(required=True, description="ID of a product variant to update.")
        recipient_list = graphene.List(
            graphene.String, required=True, description="받는 사람 리스트"
        )

    class Meta:
        description = "제품 상태를 정상으로 변경하고 bpv 로 연결된 md 에게 알림 메일 발송"
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def add_pv_manage_event(cls, info, before_pv, updated_pv):
        _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
            before_variant=before_pv,
            before_inner_variant=None,
            before_product=None,
            before_product_m2m_and_related_values=None,
            before_variant_m2m_and_related_values=None,
            updated_variant=updated_pv,
            updated_product=None,
        )

        change_details = "\n".join(variant_changes)
        manage_event = {
            "type": ProductVariantManageEventType.TYPE_STATUS,
            "title": "판매 개시 알림",
            "reason": "신규 제품의 판매 개시 알림",
            "change_details": change_details,
        }
        add_pv_manage_event(pv=updated_pv, manage_event=manage_event, info=info)

    @classmethod
    def send_notify(cls, pv: ProductVariantModel, recipient_list):
        context = {
            "sku": pv.sku,
            "product_name": pv.product.name,
            "variant_name": pv.name_for_email,
            "spec_text": make_product_spec_text_by_attribute(convert_to_simple_attribute(pv)),
            "can_sale_by_inner": terms_of_can_sale_by_inner(pv.is_inner),
            "is_exclusive": terms_of_is_exclusive(pv.product.is_exclusive),
            "pv_sales_status": term_of_pv_sales_status(pv),
        }
        transaction.on_commit(
            lambda context=context, recipient_list=recipient_list: send_templated_mail_notify_pv_on_sale(
                context, recipient_list
            )
        )

    @classmethod
    def post_save_action(cls, info, before_pv, updated_pv, recipient_list):
        cls.add_pv_manage_event(info, before_pv, updated_pv)
        cls.send_notify(updated_pv, recipient_list)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, id, recipient_list):
        pv: ProductVariantModel = cls.get_node_or_error(
            info, id, field="id", only_type=ProductVariant
        )
        if pv.first_available_for_purchase is not None:
            ValidationError(f"이미 판매 개시 처리된 제품에서 호출할 수 없는 기능입니다.")
        before_pv = deepcopy(pv)
        pv.sales_status = SalesStatus.ON_SALE
        pv.first_available_for_purchase = kst_timezone_date()
        pv.save(update_fields=["sales_status", "first_available_for_purchase"])
        cls.post_save_action(info, before_pv, pv, recipient_list)
        return ProductVariantOnSale(pv=pv)
