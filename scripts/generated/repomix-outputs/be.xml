class BpBundleInfoBulkDelete(BaseMutation):
    bp_bundle = graphene.Field(BpBundle, description="브랜드 세트 상품")

    class Arguments:
        ids = graphene.List(
            graphene.ID,
            required=True,
            description="List of BpBundleInfo IDs to delete.",
        )

    class Meta:
        description = "create bp bundle."
        model = models.BpBundleInfo
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        ids = data.get("ids")
        instances: List[BpBundleInfoModel] = cls.get_nodes_or_error(ids, "ids", BpBundleInfo)
        if len(instances) == 0:
            raise ValidationError("제거할 세트 상품 정보가 없습니다.")
        for instance in instances:
            BpBundleInfoDelete.clean_instance(instance)
        bp_bundle = instances[0].bp_bundle
        instances_ids = [instance.id for instance in instances]
        models.BpBundleInfo.objects.filter(id__in=instances_ids).delete()
        return cls(bp_bundle=bp_bundle)


class BpBundleInfoSetMain(BaseMutation):
    bp_bundle = graphene.Field(BpBundle, description="브랜드 세트 상품")

    class Arguments:
        bp_bundle_info_id = graphene.ID(required=True)

    class Meta:
        description = "브랜드 세트 상품 대표 구성품 설정"
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, bp_bundle_info_id):
        bp_bundle_info: Optional[BpBundleInfoModel] = cls.get_node_or_error(
            info,
            bp_bundle_info_id,
            field="bp_bundle_info_id",
            only_type=BpBundleInfo,
            qs=models.BpBundleInfo.objects.select_related("bp_bundle"),
        )
        bp_bundle = bp_bundle_info.bp_bundle
        bp_bundle.bp_bundle_infos.filter(is_main=True).update(is_main=False)
        bp_bundle_info.is_main = True
        bp_bundle_info.save(update_fields=["is_main"])
        # fresh 데이터 다시 조회
        bp_bundle = models.BpBundle.objects.prefetch_related(
            Prefetch(
                "bp_bundle_infos",
                queryset=models.BpBundleInfo.objects.order_by("-is_main", "id"),
            )
        ).get(pk=bp_bundle.pk)
        return BpBundleInfoSetMain(bp_bundle=bp_bundle)
