def _make_product_variant_sales_obj(
    trunc_func, stat_date, variant_id, quantity
) -> Union[ProductVariantDailySales, ProductVariantWeeklySales, ProductVariantMonthlySales]:
    if trunc_func not in [TruncDay, TruncWeek, TruncMonth]:
        return None

    if trunc_func == TruncDay:
        sales_obj = ProductVariantDailySales(
            date=kst_date(stat_date),
            variant_id=variant_id,
            quantity=quantity,
        )
    elif trunc_func == TruncWeek:
        sales_obj = ProductVariantWeeklySales(
            date=kst_date(stat_date),
            variant_id=variant_id,
            quantity=quantity,
        )
    else:
        sales_obj = ProductVariantMonthlySales(
            date=kst_date(stat_date),
            variant_id=variant_id,
            quantity=quantity,
        )
    return sales_obj


def _bulk_delete_prev_product_variant_sales(trunc_func, target_date_range, variant=None):
    if trunc_func not in [TruncDay, TruncWeek, TruncMonth]:
        return
    if trunc_func == TruncDay:
        delete_qs = ProductVariantDailySales.objects.all()
    elif trunc_func == TruncWeek:
        delete_qs = ProductVariantWeeklySales.objects.all()
    else:
        delete_qs = ProductVariantMonthlySales.objects.all()
    delete_qs = filter_range_field(delete_qs, "date", target_date_range)
    if variant:
        delete_qs = delete_qs.filter(variant_id=variant.pk)
    delete_qs.delete()


def _bulk_create_product_variant_sales(trunc_func, create_set):
    create_list = list(create_set.values())
    if not create_list:
        return
    if trunc_func not in [TruncDay, TruncWeek, TruncMonth]:
        return
    if trunc_func == TruncDay:
        ProductVariantDailySales.objects.bulk_create(create_list, batch_size=3000)
    elif trunc_func == TruncWeek:
        ProductVariantWeeklySales.objects.bulk_create(create_list, batch_size=3000)
    else:
        ProductVariantMonthlySales.objects.bulk_create(create_list, batch_size=3000)


@transaction.atomic
def generate_variant_sales(trunc_func, target_date_range, variant=None):
    order_line_qs = _charged_order_line_qs_for_sales_stats()
    order_line_qs = order_line_qs.exclude(exclude_stock_avg_stats=True)
    if target_date_range:
        order_line_qs = filter_range_field(
            order_line_qs, "order__captured_at__date", target_date_range
        )
    if variant:
        order_line_qs = order_line_qs.filter(variant_id=variant.pk)

    order_line_qs = (
        order_line_qs.annotate(stat_date=trunc_func("order__captured_at"))
        .values("stat_date", "variant_id")
        .annotate(total_quantity=Coalesce(Sum("quantity", output_field=FloatField()), 0))
        .values(
            "stat_date",
            "variant_id",
            "total_quantity",
        )
        .order_by("stat_date")
    )

    order_lines = list(order_line_qs)

    variant_map = {
        variant.id: variant
        for variant in ProductVariant.objects.select_related("outer")
        .prefetch_related("sub_pv_relation")
        .filter(id__in=[item["variant_id"] for item in order_lines])
    }

    create_set = {}
    for record in order_lines:
        stat_date = record.get("stat_date")
        variant_id = record.get("variant_id")
        quantity = Decimal(record.get("total_quantity"))
        iter_pv = variant_map[variant_id]
        if iter_pv.outer is None:
            outer_variant_id = variant_id
            outer_quantity = quantity
        else:
            outer_variant = iter_pv.outer
            outer_variant_id = outer_variant.id
            pack_count = calc_pack_count(iter_pv, outer_variant)
            outer_quantity = convert_to_outer_quantity(quantity, pack_count)

            # 이너 판매량
            inner_pv_key = stat_date.strftime("%Y%m%d") + f"_{variant_id}"
            sales_obj = _make_product_variant_sales_obj(trunc_func, stat_date, variant_id, quantity)
            create_set[inner_pv_key] = sales_obj

        outer_pv_key = stat_date.strftime("%Y%m%d") + f"_{outer_variant_id}"
        if outer_pv_key in create_set:
            sales_obj: Union[
                ProductVariantDailySales, ProductVariantWeeklySales, ProductVariantMonthlySales
            ] = create_set[outer_pv_key]
            sales_obj.quantity += outer_quantity
        else:
            sales_obj = _make_product_variant_sales_obj(
                trunc_func, stat_date, outer_variant_id, outer_quantity
            )
            create_set[outer_pv_key] = sales_obj

        # 부자재 제품 소모량 집계
        if iter_pv.outer is None and iter_pv.sub_pv is not None:
            sub_pv = iter_pv.sub_pv
            sub_pv_key = stat_date.strftime("%Y%m%d") + f"_{sub_pv.id}"
            if sub_pv_key in create_set:
                sales_obj: Union[
                    ProductVariantDailySales, ProductVariantWeeklySales, ProductVariantMonthlySales
                ] = create_set[sub_pv_key]
                sales_obj.quantity += quantity
            else:
                sales_obj = _make_product_variant_sales_obj(
                    trunc_func, stat_date, sub_pv.id, quantity
                )
                create_set[sub_pv_key] = sales_obj

    # 합포장 상자 소모량 집계
    try:
        box_spec = BoxSpecForPickingOrder.objects.first()
        sub_pv = box_spec.sub_pv if box_spec else None
        if sub_pv:
            order_qs = _charged_order_qs_for_sales_stats()
            picking_order_qs = order_qs.filter(lines__is_picking_order=True).distinct()
            if target_date_range:
                picking_order_qs = filter_range_field(
                    picking_order_qs, "captured_at__date", target_date_range
                )
            picking_order_qs = (
                picking_order_qs.annotate(stat_date=trunc_func("captured_at"))
                .values(
                    "stat_date",
                    "picking_info",
                )
                .order_by("stat_date")
            )
            picking_orders = list(picking_order_qs)
            for record in picking_orders:
                stat_date = record.get("stat_date")
                picking_info = record.get("picking_info")
                boxes = picking_info.get("boxes")
                box_count = len(boxes)
                sub_pv_key = stat_date.strftime("%Y%m%d") + f"_{sub_pv.id}"
                if sub_pv_key in create_set:
                    sales_obj: Union[
                        ProductVariantDailySales,
                        ProductVariantWeeklySales,
                        ProductVariantMonthlySales,
                    ] = create_set[sub_pv_key]
                    sales_obj.quantity += box_count
                else:
                    sales_obj = _make_product_variant_sales_obj(
                        trunc_func, stat_date, sub_pv.id, box_count
                    )
                    create_set[sub_pv_key] = sales_obj
    except Exception as e:
        logger.error(f"합포장 상자 소모량 집계중 에러: {e}")

    _bulk_delete_prev_product_variant_sales(trunc_func, target_date_range, variant)
    _bulk_create_product_variant_sales(trunc_func, create_set)


