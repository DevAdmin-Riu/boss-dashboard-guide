                if is_vendor_track_inventory is not None:
                    pv.is_vendor_track_inventory = is_vendor_track_inventory

            pv = set_box_size_attribute_using_product_variant(pv)
            update_product_variant_list.append(pv)

        if update_product_variant_list:
            models.ProductVariant.objects.bulk_update(
                update_product_variant_list,
                [
                    "name",
                    "delivery_fee_amount",
                    "qty_per_box",
                    "box_length",
                    "box_width",
                    "box_height",
                    "track_inventory",
                    "can_sale_by_inner",
                    "allow_auto_consignment",
                    "required_exp_date_mgmt",
                    "pallet_qty",
                    "pallet_m",
                    "pallet_n",
                    "pallet_o",
                    "priority_level",
                    "sales_status",
                    "first_available_for_purchase",
                    "maker",
                    "country_of_origin",
                    "qty_per_box_unit_type",
                    "sales_unit_type",
                    "stock_adjust_factor",
                    "base_sell_price_exclude_vat",
                    "base_sell_price_set_date",
                    "market_lowest_price_exclude_vat",
                    "market_lowest_price_source",
                    "market_lowest_price_set_date",
                    "is_seasonal",
                    "peak_season_start_date",
                    "peak_season_end_date",
                    "stock_status_by_daily",
                    "is_vendor_track_inventory",
                ],
            )
        if update_product_list:
            models.Product.objects.bulk_update(update_product_list, ["name"])
        if update_brand_product_list:
            models.BrandProduct.objects.bulk_update(
                update_brand_product_list, ["name", "is_only_payable_by_cash"]
            )
        if update_brand_product_variant_list:
            models.BrandProductVariant.objects.bulk_update(
                update_brand_product_variant_list,
                ["show_before_price", "before_price_amount", "price_amount", "price_vat"],
            )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor")
        details, product_variant_dict, makers, brand_product_variant_dict = cls.clean_details(
            info=info, is_fulfilled_by_vendor=is_fulfilled_by_vendor, input_data=input_data
        )
        # product_variants는 Dict[str, ProductVariantModel] 형태임. deepcopy를 이용해서, 스냅샷을 저장.
        before_product_variants = {
            sku: (deepcopy(product_variant), deepcopy(product_variant.product))
            for sku, product_variant in product_variant_dict.items()
        }
        # 각 item마다 prepare_m2m_and_related_values를 저장해 놓는다. product_variant, product 둘다 써야함.
        before_product_variant_m2m_and_related_values = {
            sku: prepare_m2m_and_related_values(product_variant[1], product_variant[0])
            for sku, product_variant in before_product_variants.items()
        }

        cls.update_product_pv_bp_and_bpv(
            details=details,
            product_variant_dict=product_variant_dict,
            makers=makers,
            brand_product_variant_dict=brand_product_variant_dict,
        )

        manage_event = input_data.get("manage_event")
        if manage_event:
            # before_product_variants의 모든sku에 대해서 for문 실행
            for sku, (before_product_variant, before_product) in before_product_variants.items():
                # prouct_variants에서 sku에 해당 하는 값을 찾는다.
                updated_pv = product_variant_dict[sku]
                updated_product = updated_pv.product

                before_product_m2m_and_related_values, before_variant_m2m_and_related_values = (
                    before_product_variant_m2m_and_related_values[sku]
                )

                # make_total_change_summary_for_product_and_variant 함수를 이용해서 변경된 내용을 찾는다.
                product_changes, variant_changes, _ = (
                    make_total_change_summary_for_product_and_variant(
                        before_variant=before_product_variant,
                        before_inner_variant=None,
                        before_product=before_product,
                        before_product_m2m_and_related_values=before_product_m2m_and_related_values,
                        before_variant_m2m_and_related_values=before_variant_m2m_and_related_values,
                        updated_variant=updated_pv,
                        updated_product=updated_product,
                    )
                )
                change_details = "\n".join(product_changes + variant_changes)
                manage_event["change_details"] = change_details
                add_pv_manage_event(pv=updated_pv, manage_event=manage_event, info=info)

        return ProductVariantBulkUpdate()


class ProductVariantBulkDelete(ModelBulkDeleteMutation):
    class Arguments:
        ids = graphene.List(
            graphene.ID,
            required=True,
            description="List of product variant IDs to delete.",
        )

    class Meta:
        description = "Deletes product variants."
        model = models.ProductVariant
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def clean_instance(cls, info, instance: ProductVariantModel):
        if instance.outer is not None:
            raise ValidationError("이너박스 제품은 삭제할 수 없습니다.")

        if instance.brand_product_variants.exists():
            raise ValidationError("브랜드 상품에 연결된 제품은 삭제할 수 없습니다.")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, ids, **data):
        _, pks = resolve_global_ids_to_primary_keys(ids, ProductVariant)
        product_pks = list(
            models.Product.objects.filter(variants__in=pks).distinct().values_list("pk", flat=True)
        )

        count, errors, valid_instances = super().perform_mutation(_root, info, ids, **data)

        # set new product default variant if any has been removed
        products = models.Product.objects.filter(pk__in=product_pks, default_variant__isnull=True)
        for product in products:
            product.default_variant = product.variants.filter(outer__isnull=True).first()
            product.save(update_fields=["default_variant"])

        return count, errors, valid_instances


class ProductVariantStocksCreate(BaseMutation):
    product_variant = graphene.Field(ProductVariant, description="Updated product variant.")

    class Arguments:
        variant_id = graphene.ID(
            required=True,
            description="ID of a product variant for which stocks will be created.",
        )
        stocks = graphene.List(
            graphene.NonNull(StockInput),
            required=True,
            description="Input list of 아우터 stocks to create.",
        )
        inner_stocks = graphene.List(
            graphene.NonNull(StockInput),
            description="Input list of 이너 stocks to create.",
        )

    class Meta:
        description = "Creates stocks for product variant."
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = BulkStockError
        error_type_field = "bulk_stock_errors"

    @classmethod
    def perform_mutation(cls, root, info, **data):
        errors = defaultdict(list)
        stocks = data["stocks"]
        outer_variant: ProductVariantModel = cls.get_node_or_error(
            info,
            data["variant_id"],
            only_type=ProductVariant,
            qs=models.ProductVariant.objects.select_related("inner"),
        )
        if stocks:
            warehouses = cls.clean_stocks_input(outer_variant, stocks, errors)
            if errors:
                raise ValidationError(errors)
            create_stocks(outer_variant, stocks, warehouses)
        else:
            create_stock_by_first_warehouse_if_not_exist(outer_variant)

        inner_variant = outer_variant.inner
        if inner_variant:
            inner_stocks = data["inner_stocks"]
            if inner_stocks:
                warehouses = cls.clean_stocks_input(inner_variant, inner_stocks, errors)
                if errors:
                    raise ValidationError(errors)
                create_stocks(inner_variant, inner_stocks, warehouses)
            else:
                create_stock_by_first_warehouse_if_not_exist(inner_variant)
        return cls(product_variant=outer_variant)

    @classmethod
    def clean_stocks_input(cls, variant, stocks_data, errors):
        warehouse_ids = [stock["warehouse"] for stock in stocks_data]
        cls.check_for_duplicates(warehouse_ids, errors)
        warehouses = cls.get_nodes_or_error(warehouse_ids, "warehouse", only_type=Warehouse)
        existing_stocks = variant.stocks.filter(warehouse__in=warehouses).values_list(
            "warehouse__pk", flat=True
        )
        error_msg = "Stock for this warehouse already exists for this product variant."
        indexes = []
        for warehouse_pk in existing_stocks:
            warehouse_id = graphene.Node.to_global_id("Warehouse", warehouse_pk)
            indexes.extend([i for i, id in enumerate(warehouse_ids) if id == warehouse_id])
        cls.update_errors(errors, error_msg, "warehouse", StockErrorCode.UNIQUE, indexes)

        return warehouses

    @classmethod
    def check_for_duplicates(cls, warehouse_ids, errors):
        duplicates = {id for id in warehouse_ids if warehouse_ids.count(id) > 1}
        error_msg = "Duplicated warehouse ID."
        indexes = []
        for duplicated_id in duplicates:
            indexes.append([i for i, id in enumerate(warehouse_ids) if id == duplicated_id][-1])
        cls.update_errors(errors, error_msg, "warehouse", StockErrorCode.UNIQUE, indexes)

    @classmethod
    def update_errors(cls, errors, msg, field, code, indexes):
        for index in indexes:
            error = ValidationError(msg, code=code, params={"index": index})
            errors[field].append(error)


class ProductVariantStocksUpdate(ProductVariantStocksCreate):
    class Meta:
        description = "Update stocks for product variant."
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = BulkStockError
        error_type_field = "bulk_stock_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        errors = defaultdict(list)
        stocks = data["stocks"]
        outer_variant: ProductVariantModel = cls.get_node_or_error(
            info,
            data["variant_id"],
            only_type=ProductVariant,
            qs=models.ProductVariant.objects.select_related("inner"),
        )
        if stocks:
            warehouse_ids = [stock["warehouse"] for stock in stocks]
            cls.check_for_duplicates(warehouse_ids, errors)
            if errors:
                raise ValidationError(errors)
            warehouses = cls.get_nodes_or_error(warehouse_ids, "warehouse", only_type=Warehouse)
            cls.update_or_create_variant_stocks(outer_variant, stocks, warehouses)

        inner_variant = outer_variant.inner
        if inner_variant:
            inner_stocks = data["inner_stocks"]
            if inner_stocks:
                warehouse_ids = [stock["warehouse"] for stock in inner_stocks]
                cls.check_for_duplicates(warehouse_ids, errors)
                if errors:
                    raise ValidationError(errors)
                warehouses = cls.get_nodes_or_error(warehouse_ids, "warehouse", only_type=Warehouse)
                cls.update_or_create_variant_stocks(inner_variant, inner_stocks, warehouses)
        return cls(product_variant=outer_variant)

    @classmethod
    def update_or_create_variant_stocks(cls, variant, stocks_data, warehouses):
        for stock_data, warehouse in zip(stocks_data, warehouses):
            stock, _ = warehouse_models.Stock.objects.get_or_create(
                product_variant=variant, warehouse=warehouse
            )


class ProductVariantStocksDelete(BaseMutation):
