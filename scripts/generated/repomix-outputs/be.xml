from django.core.exceptions import ValidationError
from django.db.models import Q

from saleor.graphql.utils.filters import filter_by_query_param
from saleor.vendor import VENDOR_CODE_PREFIX


def filter_vendor_search_factory(
    *, field_name="pk", search_fields=None, is_db_value_with_prefix=False
):
    """
    협력업체 검색 필터를 동적으로 생성하는 함수.

    :param is_db_value_with_prefix: DB의 값에 prefix 포함 여부.
    :param field_name: str - 필터링할 기본 필드명 (기본값: "pk")
    :param search_fields: list[str] - 추가적으로 검색할 필드 목록 (기본값: ["name"])
    :return: 협력업체 검색 필터 함수
    """
    if search_fields is None:
        search_fields = ["name"]

    def filter_vendor_search(qs, name, value):
        """
        협력업체 코드 또는 일반 검색어를 필터링하는 함수.

        :param qs: QuerySet - 검색할 QuerySet
        :param name: str - 필드명 (Django Filter에서 자동 전달, 사용 안 함)
        :param value: str - 검색 값 (협력업체 코드 또는 일반 검색어)
        :return: QuerySet - 필터링된 결과
        """
        if not value:
            return qs

        code_prefix = VENDOR_CODE_PREFIX
        value = value.strip()

        # 여러 개의 값이 입력된 경우 ('\n' 포함된 경우)
        query_values = [v.strip() for v in value.split("\n") if v.strip()]

        if value.startswith(code_prefix):

            pk_values = []
            for query in query_values:
                # 협력업체 코드 검색 (접두사가 있는 경우)
                if query.startswith(code_prefix):
                    prefix_length = len(code_prefix)
                    pk_value = (
                        query[prefix_length:].strip() if is_db_value_with_prefix is False else query
                    )
                    if pk_value == "":
                        continue
                    elif pk_value:
                        pk_values.append(pk_value)
                    else:
                        raise ValidationError(f"협력업체 코드 형식을 확인해 주세요. {query}")
            return qs.filter(**{f"{field_name}__in": pk_values})
        else:
            # 일반 검색어 처리 (여러 개 입력 가능)
            return filter_by_query_param(qs, value, search_fields)

    return filter_vendor_search
