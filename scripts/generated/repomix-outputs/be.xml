import logging
from urllib.parse import urlencode

from django.contrib.auth.tokens import default_token_generator

from ..account import events as account_events
from ..celeryconf import app
from ..core.emails import get_email_context
from ..core.utils.emails import send_templated_mail_consider_test_mode
from ..core.utils.url import prepare_url
from ..plugins.email.utils import get_ceo_email_list, get_settlement_manager_email_list

logger = logging.getLogger(__name__)

ACCOUNT_DELETE_TEMPLATE = "account/account_delete"
PASSWORD_RESET_TEMPLATE = "account/password_reset"


def send_user_password_reset_email_with_url(redirect_url, user):
    """Trigger sending a password reset email for the given user."""
    token = default_token_generator.make_token(user)
    _send_password_reset_email_with_url.delay(
        user.login_id, user.email, redirect_url, user.pk, token
    )


@app.task
