class ProductVariantRegionPriceBulkUpdateOrCreate(BaseMutation):
    class Arguments:
        input = ProductVariantRegionPriceBulkInput(
            required=True, description="권역별 제품 가격 및 리드타임 리스트"
        )

    class Meta:
        description = "제품가 bulk update (직배송 제품인 경우 권역별 설정 및 리드타임 포함)"
        error_type_class = ProductError
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        product_sku = detail.get("product_sku")
        region_name = detail.get("region_name")
        return f"({product_sku}:{region_name})"

    @classmethod
    def validate_value_empty(cls, details):
        lead_time_errors = []
        region_errors = []
        price_errors = []
        for detail in details:
            is_direct_shipping = detail.get("is_direct_shipping")
            region_id = detail.get("region")
            lead_time = detail.get("lead_time")
            price = detail.get("price")
            consignment_delivery_fee = detail.get("consignment_delivery_fee")
            inner_incidental_cost = detail.get("inner_incidental_cost")
            detail_code = cls.make_detail_code(detail)

            if is_direct_shipping:
                if lead_time is None or lead_time <= 0:
                    lead_time_errors.append(detail_code)
                if region_id is None:
                    region_errors.append(detail_code)
            if price is None or price < 0:
                price_errors.append(detail_code)

        if len(price_errors) > 0:
            error_msg = "제품 판매가 오류 제품코드: {}".format(", ".join(price_errors))
            raise ValidationError(error_msg)
        if len(region_errors) > 0:
            error_msg = "권역 오류 제품코드: {}".format(", ".join(region_errors))
            raise ValidationError(error_msg)
        if len(lead_time_errors) > 0:
            error_msg = "리드타임 오류 제품코드: {}".format(", ".join(lead_time_errors))
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data):
        region_info = RegionInfo.objects.all()
        details = []
        details_input = input_data.get("details")
        for detail in details_input:
            region_code_input = detail.get("region_code")
            region_code_array = [code.strip() for code in region_code_input.split(",")]
            for region_code in region_code_array:
                region = region_info.filter(code=region_code).first()
                product_sku = detail.get("product_sku")
                is_direct_shipping = detail.get("is_direct_shipping")
                lead_time = detail.get("lead_time")
                disabled_days = detail.get("disabled_days")
                price = detail.get("price")
                consignment_delivery_fee = detail.get("consignment_delivery_fee")
                inner_incidental_cost = detail.get("inner_incidental_cost")

                detail_line = {
                    "product_sku": product_sku,
                    "is_direct_shipping": is_direct_shipping,
                    "region": region.id if region else None,
                    "region_name": region.name if region else None,
                    "region_code": region_code,
                    "lead_time": lead_time,
                    "disabled_days": disabled_days,
                    "price": price,
                    "consignment_delivery_fee": consignment_delivery_fee,
                    "inner_incidental_cost": inner_incidental_cost,
                }

                details.append(detail_line)

        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        cls.validate_value_empty(details)

        validate_region(details)
        _, product_variants, _ = validate_product_sku(details)

        return details, product_variants

    @classmethod
    def update_or_create_product_variant(cls, details, product_variants):
        update_product_variant_region_list = []
        create_product_variant_region_list = []
        update_product_variant_list = []
        for detail in details:
            sku = detail.get("product_sku")
            price = detail.get("price")
            product_variant = product_variants[sku]

            is_direct_shipping = detail.get("is_direct_shipping")
            if is_direct_shipping:
                region_id = detail.get("region")
                lead_time = detail.get("lead_time")
                disabled_days = detail.get("disabled_days")

                try:
                    product_variant_region = models.ProductVariantRegion.objects.get(
                        region_id=region_id, product_variant=product_variant
                    )
                    product_variant_region.lead_time = lead_time
                    product_variant_region.disabled_days = disabled_days
                    product_variant_region.price_amount = price
                    update_product_variant_region_list.append(product_variant_region)
                except:
                    obj = models.ProductVariantRegion(
                        region_id=region_id,
                        product_variant=product_variant,
                        lead_time=lead_time,
                        disabled_days=disabled_days,
                        price_amount=price,
                    )
                    create_product_variant_region_list.append(obj)
            else:
                consignment_delivery_fee = detail.get("consignment_delivery_fee")
                if consignment_delivery_fee is not None:
                    product_variant.consignment_delivery_fee_amount = consignment_delivery_fee

                inner_incidental_cost = detail.get("inner_incidental_cost")
                if inner_incidental_cost is not None:
                    product_variant.inner_incidental_cost_amount = inner_incidental_cost
                update_product_variant_list.append(product_variant)

        if update_product_variant_region_list:
            models.ProductVariantRegion.objects.bulk_update(
                update_product_variant_region_list,
                [
                    "lead_time",
                    "disabled_days",
                    "price_amount",
                ],
            )
        if create_product_variant_region_list:
            models.ProductVariantRegion.objects.bulk_create(create_product_variant_region_list)

        if update_product_variant_list:
            models.ProductVariant.objects.bulk_update(
                update_product_variant_list,
                [
                    "price_amount",
                    "consignment_delivery_fee_amount",
                    "inner_incidental_cost_amount",
                ],
            )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        details, product_variants = cls.clean_details(info, input_data)

        # product_variants는 Dict[str, ProductVariantModel] 형태임. deepcopy를 이용해서, 스냅샷을 저장.
        before_product_variants = {
            sku: (deepcopy(product_variant), deepcopy(product_variant.product))
            for sku, product_variant in product_variants.items()
        }
        # 각 item마다 prepare_m2m_and_related_values를 저장해 놓는다. product_variant, product 둘다 써야함.
        before_product_variant_m2m_and_related_values = {
            sku: prepare_m2m_and_related_values(product_variant[1], product_variant[0])
            for sku, product_variant in before_product_variants.items()
        }

        cls.update_or_create_product_variant(details=details, product_variants=product_variants)

        manage_event = input_data.get("manage_event")
        if manage_event:
            # before_product_variants의 모든sku에 대해서 for문 실행
            for sku, (before_product_variant, before_product) in before_product_variants.items():
                # prouct_variants에서 sku에 해당 하는 값을 찾는다.
                updated_pv = product_variants[sku]
                updated_product = updated_pv.product

                before_product_m2m_and_related_values, before_variant_m2m_and_related_values = (
                    before_product_variant_m2m_and_related_values[sku]
                )

                # make_total_change_summary_for_product_and_variant 함수를 이용해서 변경된 내용을 찾는다.
                product_changes, variant_changes, _ = (
                    make_total_change_summary_for_product_and_variant(
                        before_variant=before_product_variant,
                        before_inner_variant=None,
                        before_product=before_product,
                        before_product_m2m_and_related_values=before_product_m2m_and_related_values,
                        before_variant_m2m_and_related_values=before_variant_m2m_and_related_values,
                        updated_variant=updated_pv,
                        updated_product=updated_product,
                    )
                )
                change_details = "\n".join(product_changes + variant_changes)
                manage_event["change_details"] = change_details
                add_pv_manage_event(pv=updated_pv, manage_event=manage_event, info=info)

        return ProductVariantRegionPriceBulkUpdateOrCreate()
