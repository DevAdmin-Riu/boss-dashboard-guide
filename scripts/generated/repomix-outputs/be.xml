    @staticmethod
    def qs_with_stock_status(qs: QuerySet) -> QuerySet:
        allocation_qs = (
            Allocation.objects.filter(stock=OuterRef("pk"))
            .values("stock")
            .annotate(total_quantity_allocated=Sum("quantity_allocated"))
        )
        stock_qs = (
            Stock.objects.filter(product_variant=OuterRef("pk"))
            .annotate(
                total_quantity_allocated=Coalesce(
                    Subquery(allocation_qs.values("total_quantity_allocated")), 0
                )
            )
            .values("product_variant_id")
            .annotate(total_quantity=Coalesce(Sum("quantity"), 0))
            .annotate(
                available_quantity=F("total_quantity")
                - Coalesce(Sum("total_quantity_allocated"), 0)
            )
        )

        # 가용재고 0 -> 가용재고 값이 작은 것 순 -> 단종 -> 위탁 순으로 소팅
        qs = qs.annotate(
            available_quantity=Coalesce(Subquery(stock_qs.values("available_quantity")), 0)
        ).annotate(
            stock_status=Case(
                When(track_inventory=False, then=sys.maxsize),
                When(sales_status=SalesStatus.STOPPED, then=sys.maxsize - 1),
                When(available_quantity__lte=0, then=sys.maxsize * (-1)),
                default=F("available_quantity"),
