class StockDetailAdjustToZeroInput(graphene.InputObjectType):
    stock = graphene.ID(required=True, description="음수처리된 부자재 재고 조정을 위한 stock id")
    reason = graphene.String(description="입고사유")


class StockDetailAdjustToZero(BaseMutation):
    stock = graphene.Field(Stock)

    class Arguments:
        input = StockDetailAdjustToZeroInput(
            description="음수처리된 부자재 재고 조정를 위한 input 형식", required=True
        )

    class Meta:
        description = "음수처리된 부자재 재고 조정"
        error_type_class = StockError
        error_type_field = "stock_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        stock_id = input_data.get("stock")

        stock: Optional[StockModel] = graphene.Node.get_node_from_global_id(
            info, stock_id, only_type=Stock
        )
        if stock is None:
            raise ValidationError("존재하지 않는 stock id 입니다.")

        if stock.quantity >= 0:
            raise ValidationError(
                "음수가 된 부자재 재고에 대한 조정기능입니다. 음수가 아닌 부자재 재고는 조정할 수 없습니다."
            )

        if stock.product_variant.is_sub_pv == False:
            raise ValidationError("부자재 재고만 조정 가능합니다.")

        before_quantity = stock.quantity
        stock.adjust_stock_to_zero_for_sub_pv()
        stock.details.filter(remain_quantity__lt=0).delete()
        target_rack_stock_detail: RackStockDetailModel = models.RackStockDetail.objects.filter(
            product_variant=stock.product_variant, remain_quantity__lt=0
        ).first()
        rack_location = target_rack_stock_detail.location
        rack_location_count = models.RackStockDetail.objects.filter(
            location=rack_location, product_variant=stock.product_variant
        ).count()
        if rack_location_count > 1:
            target_rack_stock_detail.delete()
        else:
            target_rack_stock_detail.remain_quantity = 0
            target_rack_stock_detail.stock_detail = None
            target_rack_stock_detail.save(update_fields=["remain_quantity", "stock_detail"])

        requestor = info.context.user
        reason = input_data.get("reason")
        create_adjust_to_zero_stock_detail_event(
            stock,
            user=requestor,
            reason=reason,
            before_quantity=before_quantity,
            after_quantity=0,
        )

        return StockDetailAdjustToZero(stock=stock)


