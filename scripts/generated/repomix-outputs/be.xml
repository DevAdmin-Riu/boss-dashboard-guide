    )
    if po_line is None:
        return ClosestToBeStockedInfo(closest_to_be_stocked_date="-", closest_to_be_stocked_qty="-")
    return ClosestToBeStockedInfo(
        closest_to_be_stocked_date=po_line.expected_purchase_date.strftime("%Y-%m-%d"),
        closest_to_be_stocked_qty=get_to_be_stocked_qty_by_po_line(po_line),
    )


def get_monthly_sales_qty_by_prefetched_data(
    prefetched_monthly_sales: List[ProductVariantMonthlySales], target_date
) -> Optional[int]:
    monthly_sale: ProductVariantMonthlySales = next(
        (s for s in prefetched_monthly_sales if s.date == target_date), None
    )
    return monthly_sale.quantity if monthly_sale else None


def get_weekly_sales_qty_by_prefetched_data(
    prefetched_weekly_sales: List[ProductVariantWeeklySales], target_date
) -> Optional[int]:
    weekly_sale: ProductVariantWeeklySales = next(
        (s for s in prefetched_weekly_sales if s.date == target_date), None
    )
    return weekly_sale.quantity if weekly_sale else None


def get_total_sales_qty_by_prefetched_data(prefetched_sales: List[Sales]):
    total_quantity = sum(sale.quantity or 0 for sale in prefetched_sales)
    return total_quantity


def get_total_stocks_qty_by_prefetched_data(prefetched_stocks: List[Stock]):
    total_quantity = sum(stock.quantity or 0 for stock in prefetched_stocks)
    return total_quantity


def get_total_allocated_qty_by_prefetched_data(prefetched_stocks: List[Stock]):
    total_allocated_qty = 0
    for stock in prefetched_stocks:
        allocations: List[Allocation] = stock.allocations.all()
        total_allocated_qty += sum(alloc.quantity_allocated or 0 for alloc in allocations)
    return total_allocated_qty


def get_total_virtual_allocated_qty_by_prefetched_data(prefetched_stocks: List[Stock]):
    total_virtual_allocated_qty = 0
    for stock in prefetched_stocks:
        allocations: List[Allocation] = stock.allocations.all()
        total_virtual_allocated_qty += sum(
            alloc.quantity_virtual_allocated or 0 for alloc in allocations
        )
    return total_virtual_allocated_qty


def get_total_quantity_can_not_sell_by_prefetched_data(
    prefetched_rack_stocks: List[RackStockDetail],
):
    total_quantity = sum(
        rack_stock_detail.remain_quantity or 0
        for rack_stock_detail in prefetched_rack_stocks
        if rack_stock_detail.location.can_not_sell_to_customers
    )
    return total_quantity


def get_available_qty_by_prefetched_data(
    prefetched_stocks: List[Stock], prefetched_rack_stocks: List[RackStockDetail]
):
    total_qty = get_total_stocks_qty_by_prefetched_data(prefetched_stocks)
    qty_allocated = get_total_allocated_qty_by_prefetched_data(prefetched_stocks)
    qty_can_not_sell = get_total_quantity_can_not_sell_by_prefetched_data(prefetched_rack_stocks)
    return total_qty - qty_allocated - qty_can_not_sell


def get_qty_to_be_stocked_by_prefetched_data(
    prefetched_to_be_stocked_po_lines: List[PurchaseOrderLine], until_short_term: bool
) -> Decimal:
    if not prefetched_to_be_stocked_po_lines:
        return Decimal(0)

    # 단기 입고 예정을 고려하는 경우 필터링 추가
    if until_short_term:
        today = kst_timezone_date()
        one_days_later = today + timedelta(days=1)

        prefetched_to_be_stocked_po_lines = [
            pol
            for pol in prefetched_to_be_stocked_po_lines
            if today <= pol.expected_purchase_date <= one_days_later
        ]

    # 총 입고 예정 수량 계산
    total_quantity = sum(
        pol.quantity or 0
        for pol in prefetched_to_be_stocked_po_lines
        if pol.status in STOCKABLE_STATUSES_USING_QUANITY
    )
    total_purchase_quantity = sum(
        pol.purchase_quantity or 0
        for pol in prefetched_to_be_stocked_po_lines
        if pol.status in STOCKABLE_STATUSES_USING_PURCHASE_QUANITY
    )

    # 음수 방지 및 최종 값 반환
    return max(total_quantity + total_purchase_quantity, Decimal(0))


def get_latest_stocked_po_line_by_prefetched_data(
    prefetched_latest_stocked_po_lines: List[PurchaseOrderLine],
):
    if prefetched_latest_stocked_po_lines and len(prefetched_latest_stocked_po_lines) > 0:
        return prefetched_latest_stocked_po_lines[0]
    return None


def get_latest_stock_detail_event_by_prefetched_data(
    prefetched_stocks: List[Stock],
) -> StockDetailEvent:
    for stock in prefetched_stocks:
        if stock.latest_divide_stock_detail_event:
            return stock.latest_divide_stock_detail_event[0]

    return None


def get_latest_stocked_date_info_using_prefetched_data(pv: ProductVariant):
    is_inner = pv.is_inner
    prefetched_latest_stocked_po_lines = (
        getattr(pv, "prefetched_outer_latest_stocked_po_lines", [])
        if is_inner
        else getattr(pv, "prefetched_latest_stocked_po_lines", [])
    )
    latest_stocked_po_line = get_latest_stocked_po_line_by_prefetched_data(
        prefetched_latest_stocked_po_lines
    )
    if latest_stocked_po_line is None or latest_stocked_po_line.purchase_date is None:
        return "-"
    return latest_stocked_po_line.purchase_date.strftime("%Y-%m-%d")


def get_stock_this_month_sales_avg_qty(this_month_sales_quantity, first_available_for_purchase):
    today = kst_timezone_date()

    # 1일이거나 이번 달 판매량이 0이면 그대로 반환
    if today.day == 1 or this_month_sales_quantity == 0:
        return this_month_sales_quantity

    is_first_available_this_month = (
        first_available_for_purchase.year == today.year
        and first_available_for_purchase.month == today.month
    )

    def calculate_average(start_date, end_date):
        days_from_start_to_yesterday = (end_date - start_date).days
        return Decimal(
            this_month_sales_quantity
            if days_from_start_to_yesterday == 0
            else this_month_sales_quantity / days_from_start_to_yesterday
        )

    if is_first_available_this_month:
        return calculate_average(first_available_for_purchase, today)

    start_of_month = today.replace(day=1)
    return calculate_average(start_of_month, today)
