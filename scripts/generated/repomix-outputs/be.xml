import logging
from decimal import Decimal
from typing import TYPE_CHECKING, Iterable

from ..core.prices import calc_vat_by_price_include_vat, quantize_price
from ..core.taxes import zero_taxed_money
from ..plugins.manager import get_plugins_manager
from .define import CalcCheckoutTotalMode

if TYPE_CHECKING:
    from prices import TaxedMoney

    from .models import Checkout, CheckoutLine

logger = logging.getLogger(__name__)


def checkout_subtotal_delivery_addtional_fee(
    *, checkout: "Checkout", lines: Iterable["CheckoutLine"], plugin_manager=None
) -> "TaxedMoney":
    """CheckoutLines 중 주문 시 선택된 lines의 도서산간 추가 요금의 총액"""
    plugin_manager_loaded = plugin_manager or get_plugins_manager()
    calculated_checkout_subtotal_delivery_additional_fee = (
        plugin_manager_loaded.calculate_checkout_subtotal_delivery_additional_fee(checkout, lines)
    )
    return quantize_price(calculated_checkout_subtotal_delivery_additional_fee, checkout.currency)


def checkout_subtotal(
    *, checkout: "Checkout", lines: Iterable["CheckoutLine"], plugin_manager=None
) -> "TaxedMoney":
    """CheckoutLines 중 주문 시 선택된 lines의 상품가(unit_price) * 수량의 합계"""
    plugin_manager_loaded = plugin_manager or get_plugins_manager()
    calculated_checkout_subtotal = plugin_manager_loaded.calculate_checkout_subtotal(
        checkout, lines, mode=CalcCheckoutTotalMode.ALL
    )
    return quantize_price(calculated_checkout_subtotal, checkout.currency)


def checkout_total(
    *,
    checkout: "Checkout",
    lines: Iterable["CheckoutLine"],
    plugin_manager=None,
) -> "TaxedMoney":
    """주문 결제 총액(부가세 포함 가격) = CheckoutLines 중 주문 시 선택된 lines의 상품가(unit_price) * 수량의 합계 +  도서산간지역 추가 배송비"""
    plugin_manager_loaded = plugin_manager or get_plugins_manager()
    calculated_checkout_total = plugin_manager_loaded.calculate_checkout_total(checkout, lines)
    return max(
        quantize_price(calculated_checkout_total, checkout.currency),
        zero_taxed_money(checkout.currency),
    )


def calculate_checkout_total(
    *,
    checkout: "Checkout",
) -> "TaxedMoney":
    only_selected_checkout_lines = checkout.get_selected_lines()
    total = checkout_total(
        checkout=checkout,
        lines=only_selected_checkout_lines,
    )
    return max(total, zero_taxed_money(total.currency))


def checkout_subtotal_etc_delivery_fee(
    *, checkout: "Checkout", lines: Iterable["CheckoutLine"], plugin_manager=None
) -> "TaxedMoney":
    """CheckoutLines 중 주문 시 선택된 lines의 상품 매입가(unit_brand_cost_price) * 수량의 합계"""
    plugin_manager_loaded = plugin_manager or get_plugins_manager()
    calculated_checkout_subtotal_etc_delivery_fee = (
        plugin_manager_loaded.calculate_checkout_subtotal_etc_delivery_fee(checkout, lines)
    )
    return max(
        quantize_price(calculated_checkout_subtotal_etc_delivery_fee, checkout.currency),
        zero_taxed_money(checkout.currency),
    )


def checkout_subtotal_brand_cost(
    *, checkout: "Checkout", lines: Iterable["CheckoutLine"], plugin_manager=None
) -> "TaxedMoney":
    """CheckoutLines 중 주문 시 선택된 lines의 상품 매입가(unit_brand_cost_price) * 수량의 합계"""
    plugin_manager_loaded = plugin_manager or get_plugins_manager()
    calculated_checkout_subtotal_brand_cost = (
        plugin_manager_loaded.calculate_checkout_subtotal_brand_cost(
            checkout, lines, mode=CalcCheckoutTotalMode.ALL
        )
    )
    return max(
        quantize_price(calculated_checkout_subtotal_brand_cost, checkout.currency),
        zero_taxed_money(checkout.currency),
    )


def _checkout_subtotal_with_mode(
    *, checkout: "Checkout", lines: Iterable["CheckoutLine"], mode: CalcCheckoutTotalMode
) -> Decimal:
    """면세/과세별 상품 금액 합계"""
    calculated_checkout_subtotal = get_plugins_manager().calculate_checkout_subtotal(
        checkout, lines, mode=mode
    )
    return quantize_price(calculated_checkout_subtotal, checkout.currency).gross.amount


def calculate_checkout_tax_and_taxfree(
    *,
    checkout: "Checkout",
    lines: Iterable["CheckoutLine"],
    pay_cashable_credits: int,
    pay_rcoins: int
):
    tax_free_total = _checkout_subtotal_with_mode(
        checkout=checkout, lines=lines, mode=CalcCheckoutTotalMode.ONLY_TAX_FREE
    )
    taxable_total = _checkout_subtotal_with_mode(
        checkout=checkout, lines=lines, mode=CalcCheckoutTotalMode.ONLY_TAXABLE
    )
    subtotal_delivery_additional_fee = checkout_subtotal_delivery_addtional_fee(
        checkout=checkout, lines=lines
    )
    taxable_total += subtotal_delivery_additional_fee.gross.amount

    if pay_cashable_credits > 0:
        point_taxable = (
            taxable_total if pay_cashable_credits > taxable_total else pay_cashable_credits
        )
        point_tax_free = pay_cashable_credits - point_taxable

        taxable_total = taxable_total - point_taxable
        tax_free_total = tax_free_total - point_tax_free

    if pay_rcoins > 0:
        rcoins_tax_free = min(tax_free_total, pay_rcoins)
        rcoins_taxable = pay_rcoins - rcoins_tax_free
        tax_free_total = tax_free_total - rcoins_tax_free
        taxable_total = taxable_total - rcoins_taxable

    tax = calc_vat_by_price_include_vat(taxable_total, False)
    taxfree = tax_free_total

    return tax, taxfree
