    def resolve_fulfillment_lines_by_variant(
        self, info, fulfillment_filter, fulfillment_line_filter, is_inspect_completed
    ):
        return resolve_fulfillment_lines_by_variant(
            info, fulfillment_filter, fulfillment_line_filter, is_inspect_completed
        )

    def resolve_fulfillment_tracking_info(self, _info, courier_code, tracking_number):
        return resolve_fulfillment_tracking_info(courier_code, tracking_number)
