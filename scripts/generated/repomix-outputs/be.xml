def compare_dates_with_offset(order_created, days):
    """
    주어진 주문 생성 날짜(order_created)에 지정된 일수(days)를 더한 날짜와 현재 날짜를 비교하는 기능을 수행합니다. 이 함수는 시간대 정보를 제거한 후 날짜만 비교합니다.

    매개변수 order_created: 주문 생성 날짜를 나타내는 datetime 객체입니다.
    매개변수 days: 주문 생성 날짜에 더할 일수입니다.

    반환값: 현재 날짜가 주문 생성 날짜에 지정된 일수를 더한 날짜보다 크면 True를 반환합니다. 그렇지 않으면 False를 반환합니다.
    """
    from datetime import datetime, timedelta

    if order_created is None:
        raise ValueError("order_created 매개변수는 필수입니다.")

    if days is None:
        raise ValueError("days 매개변수는 필수입니다.")

    order_created_naive = order_created.replace(tzinfo=None)
    current_date = datetime.now()
    order_created_plus_days = order_created_naive + timedelta(days=days)

    return current_date.date() > order_created_plus_days.date()
