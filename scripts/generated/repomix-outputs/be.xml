            required=True, description="재점검 항목 생성을 위한 Input"
        )

    class Meta:
        description = "재점검 항목을 생성합니다."
        model = BsOpsCheckModels.BsOpsRecheckReportItem
        error_type_class = BrandStoreOpsCheckError
        error_type_field = "brand_store_ops_check_errors"

    @classmethod
    def post_save_action(cls, info, instance, _cleaned_input):
        transaction.on_commit(
            lambda: send_push_notification_on_bs_ops_recheck_report_item_create(info, instance)
        )


class BsOpsRecheckReportItemSubmit(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="재점검 항목 ID")
        input = BsOpsRecheckReportItemSubmitInput(
            required=True, description="재점검 제출을 위한 Input"
        )

    class Meta:
        description = "재점검 항목을 제출하는 뮤테이션"
        model = BsOpsCheckModels.BsOpsRecheckReportItem
        error_type_class = BrandStoreOpsCheckError
        error_type_field = "brand_store_ops_check_errors"

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        if instance.status not in {
            BsOpsRecheckReportItemStatus.REQUESTED,
            BsOpsRecheckReportItemStatus.RE_REQUESTED,
        }:
            raise ValidationError("현재 상태에서는 제출할 수 없습니다.")

        answer_json = cleaned_input.get("answer_json") or {}
        if not bool(answer_json):
            raise ValidationError("답변 내용이 비어있습니다.")

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance, cleaned_input):
        instance.answer_json = cleaned_input["answer_json"]
        instance.status = BsOpsRecheckReportItemStatus.SUBMITTED
        return instance

    @classmethod
    def post_save_action(cls, info, instance, _cleaned_input):
        transaction.on_commit(
            lambda: send_push_notification_on_bs_ops_recheck_report_item_submit(info, instance)
        )


class BsOpsRecheckReportItemStatusUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="재점검 항목 ID")
        input = BsOpsRecheckReportItemStatusUpdateInput(
            required=True, description="재점검 상태 변경을 위한 Input"
        )

    class Meta:
        description = "재점검 항목 상태를 변경합니다"
        model = BsOpsCheckModels.BsOpsRecheckReportItem
        error_type_class = BrandStoreOpsCheckError
        error_type_field = "brand_store_ops_check_errors"

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)

        status = cleaned_input.get("status")
        reject_reason = cleaned_input.get("reject_reason")

        # 상태 제한: RE_REQUESTED 또는 COMPLETED만 허용
        if status not in {
            BsOpsRecheckReportItemStatus.RE_REQUESTED,
            BsOpsRecheckReportItemStatus.COMPLETED,
        }:
            raise ValidationError("허용되지 않은 상태입니다.")

        # reject_reason이 있으면 status는 반드시 RE_REQUESTED
        if reject_reason and status != BsOpsRecheckReportItemStatus.RE_REQUESTED:
            raise ValidationError("사유가 있는 경우 상태는 '재요청'만 가능합니다.")

        return cleaned_input


