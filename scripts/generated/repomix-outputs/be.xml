def send_kakaotalk_to_user_on_ds_address_status(address: "Address", user: "User"):
    direct_shipping_status = address.direct_shipping_status
    if direct_shipping_status == AddressDirectShippingStatus.APPROVED:
        talk_event_code = AligoEvents.APPROVE_ADDRESS
    elif direct_shipping_status == AddressDirectShippingStatus.REJECTED:
        talk_event_code = AligoEvents.REJECT_ADDRESS
