        default=0,
    )
    # 환불 시점 재계산된 브랜드 계약 결제 수수료
    final_brand_paying_charge_exclude_vat = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )

    customer_ip_address = models.GenericIPAddressField(blank=True, null=True)
    extra_data = models.TextField(blank=True, default="")
    return_url = models.URLField(blank=True, null=True)

    # 필드 삭제 금지: 현금영수증 발행하던 시기의 승인번호 정보가 남아 있어서 필드는 남겨두되 사용하지 않음
    cshr_auth_no = models.CharField(max_length=20, blank=True, null=True, unique=True)

    # 대행 주문의 경우 결제 증빙 파일을 담기 위한 필드.
    receipt_file = models.FileField(
        upload_to=upload_to_for_receipt_approval_file, null=True, blank=True
    )
    # 대행 주문의 경우 결제 증빙 반려 시 반려 사유 필드.
    receipt_refused_reason = models.TextField(blank=True, null=True, default=None)
    # 토스 보스 페이 여부
    is_toss_riu_pay = models.BooleanField(default=False)

    class Meta:
        # last payment가 유의미하므로 ordering 변경 금지
        ordering = ("pk",)
        permissions = (
            (PaymentPermissions.MANAGE_PAYMENT_STATUS.codename, "결제상태 수정(대행주문 시)"),
        )

    def __repr__(self):
        return "Payment(gateway=%s, is_active=%s, created=%s, charge_status=%s)" % (
            self.gateway,
            self.is_active,
            self.created,
            self.charge_status,
        )

    @property
    def credits_incl_non_cashable(self):
        return self.cashable_credits + self.non_cashable_credits

    def get_total(self):
        return Money(self.total, self.currency or settings.DEFAULT_CURRENCY)

    def get_authorized_amount(self):
        money = zero_money()

        # Query all the transactions which should be prefetched
        # to optimize db queries
        transactions = self.transactions.all()

        # There is no authorized amount anymore when capture is succeeded
        # since capture can only be made once, even it is a partial capture
        if any([txn.kind == TransactionKind.CAPTURE and txn.is_success for txn in transactions]):
            return money

        # Filter the succeeded auth transactions
        authorized_txns = [
            txn
            for txn in transactions
            if txn.kind == TransactionKind.AUTH and txn.is_success and not txn.action_required
        ]

        # Calculate authorized amount from all succeeded auth transactions
        for txn in authorized_txns:
            money += Money(txn.amount, self.currency or settings.DEFAULT_CURRENCY)

        # If multiple partial capture is supported later though it's unlikely,
        # the authorized amount should exclude the already captured amount here
        return money

    def get_total_return_delivery_fee(self):
        total_return_delivery_fee = Decimal(0)
        refund_lines = self.refund_lines.all()
        for refund_line in refund_lines:
            total_return_delivery_fee += refund_line.return_delivery_fee
        return total_return_delivery_fee

    def get_last_vbank_pending_transaction(self):
        if self.charge_status == ChargeStatus.PENDING:
            return self.get_last_transaction(TransactionKind.ACTION_TO_CONFIRM)
        return None

    def get_last_transaction(self):
        return max(self.transactions.all(), default=None, key=attrgetter("pk"))

    def get_last_transaction(self, filter_kind: TransactionKind):
        transaction: Transaction = self.transactions.filter(
            kind=filter_kind, is_success=True
        ).last()
        return transaction

    def get_captured_total(self):
        return Money(
            self.captured_total,
            self.currency or settings.DEFAULT_CURRENCY,
        )

    @property
    def captured_total(self):
        return (
            self.captured_amount
            + self.captured_cashable_credits
            + self.captured_non_cashable_credits
            + self.captured_rcoins
        )

    def get_captured_amount(self):
        return Money(self.captured_amount, self.currency or settings.DEFAULT_CURRENCY)

    def get_charge_amount(self):
        """Retrieve the maximum capture possible."""
        return self.total - self.captured_total

    @property
    def is_authorized(self):
        return any(
            [
                txn.kind == TransactionKind.AUTH and txn.is_success and not txn.action_required
                for txn in self.transactions.all()
            ]
        )

    @property
    def not_charged(self):
        return self.charge_status == ChargeStatus.NOT_CHARGED

    def can_authorize(self):
        return self.is_active and self.not_charged

    def can_capture(self):
        if not (self.is_active and self.not_charged):
            return False
        return True

    def can_void(self):
        return self.is_active and self.not_charged and self.is_authorized

    def can_refund(self):
        can_refund_charge_status = (
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        )
        return self.is_active and self.charge_status in can_refund_charge_status

    def can_confirm(self):
        return self.is_active and self.not_charged

    def is_card_pay(self):
        pay_method = self.token
        return is_card_pay(pay_method)

    def is_vbank_pay(self):
        pay_method = self.token
        return is_vbank_pay(pay_method)

    def is_points_only_pay(self):
        pay_method = self.token
        return is_points_only_pay(pay_method)

    def is_deferred_pay(self):
        pay_method = self.token
        return is_deferred_pay(pay_method)


