        brand_id = input.get("brand_id")
        brand_product_id = input.get("brand_product_id")
        variant_id = input.get("variant_id")

        brand = cls.get_node_or_error(info, brand_id, field="brand_id", only_type=Brand)
        if brand is None:
            raise ValidationError("brand_id 오류", code=ProductErrorCode.INVALID)

        brand_product = cls.get_node_or_error(
            info, brand_product_id, field="brand_id", only_type=BrandProduct
        )
        if brand_product is None:
