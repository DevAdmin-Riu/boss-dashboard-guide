    @require_active_plugin
    def get_plugin_config_dot_map(self):
        config = {item["name"]: item["value"] for item in self.configuration}

        configJson = DotMap(config)
        is_prod_mode = configJson.is_prod_mode
        configJson.base_url = configJson.base_url if is_prod_mode else configJson.dev_base_url
        configJson.api_key = configJson.api_key if is_prod_mode else configJson.dev_api_key
        return configJson

    def webhook(self, request: WSGIRequest, path: str, previous_value) -> HttpResponse:
        if not self.validate_plugin():
            return HttpResponseServerError()

        config = self.get_plugin_config_dot_map()
        if path.startswith(WEBHOOK_PATH):
            return handle_webhook(request, config)
        return HttpResponseNotFound()

    @require_active_plugin
    def get_goodsflow_config(self):
        config = self.get_plugin_config_dot_map()
        request_opt_url = build_absolute_uri_adjust_https(
            f"/plugins/{self.PLUGIN_ID + WEBHOOK_PATH + REQUEST_OTP_URL}"
        )
        request_print_url = build_absolute_uri_adjust_https(
            f"/plugins/{self.PLUGIN_ID + WEBHOOK_PATH + REQUEST_PRINT_URL}"
        )
        request_return_url = build_absolute_uri_adjust_https(
            f"/plugins/{self.PLUGIN_ID + WEBHOOK_PATH + REQUEST_RETURN_URL}"
        )
        request_return_cancel_url = build_absolute_uri_adjust_https(
            f"/plugins/{self.PLUGIN_ID + WEBHOOK_PATH + REQUEST_RETURN_CANCEL_URL}"
        )
        response_print_url = build_absolute_uri_adjust_https(
            f"/plugins/{self.PLUGIN_ID + WEBHOOK_PATH + RESPONSE_PRINT_URL}"
        )
        web_print_url = urljoin(config.base_url, config.web_print_url)
        web_contract_url = urljoin(config.base_url, config.web_contract_url)
        return [
            {"field": "request_opt_url", "value": request_opt_url},
            {"field": "request_print_url", "value": request_print_url},
            {"field": "request_return_url", "value": request_return_url},
            {"field": "request_return_cancel_url", "value": request_return_cancel_url},
            {"field": "response_print_url", "value": response_print_url},
            {"field": "web_print_url", "value": web_print_url},
            {"field": "web_contract_url", "value": web_contract_url},
        ]
