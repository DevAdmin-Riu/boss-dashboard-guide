from dataclasses import dataclass
from typing import Generic, Optional, Type, TypeVar

import graphene
from django.core.exceptions import ValidationError

from saleor.graphql.core.utils import from_global_id_strict_type

T = TypeVar("T")  # 모델 타입 제네릭 변수


@dataclass(frozen=True)
class MoveOperation(Generic[T]):
    item: T
    parent_changed: bool
    new_parent: Optional[T]
    move: int


class ItemMoveHandler(Generic[T]):
    model_class: Type[T]
    gql_type_name: str
    relation_field_name: str
    container_field_name: Optional[str]  # ex. 'template'

    def __init__(
        self,
        model_class: Type[T],
        gql_type_name: str,
        relation_field_name: str = "parent_id",
        container_field_name: Optional[str] = None,  # 추가됨
    ):
        self.model_class = model_class
        self.gql_type_name = gql_type_name
        self.relation_field_name = relation_field_name
        self.container_field_name = container_field_name

    def get_move_operation(self, cls, info, move_input, qs) -> MoveOperation[T]:
        item = cls.get_node_or_error(
            info, move_input.item_id, field="item", only_type=self.gql_type_name, qs=qs
        )

        new_parent = None
        parent_changed = False

        if move_input.parent_id is not None:
            parent_pk = from_global_id_strict_type(
                move_input.parent_id, only_type=self.gql_type_name, field="parent_id"
            )
            current_parent_id = getattr(item, self.relation_field_name)
            if int(parent_pk) != current_parent_id:
                new_parent = cls.get_node_or_error(
                    info,
                    move_input.parent_id,
                    field="parent_id",
                    only_type=self.gql_type_name,
                    qs=qs,
                )
                parent_changed = True

                # 🧩 상위 컨테이너가 다르면 오류
                if self.container_field_name and getattr(
                    item, self.container_field_name
                ) != getattr(new_parent, self.container_field_name):
                    raise ValidationError("같은 템플릿 내에서만 이동할 수 있습니다.")
        elif move_input.parent_id is None and getattr(item, self.relation_field_name) is not None:
            parent_changed = True

        return MoveOperation(
            item=item,
            new_parent=new_parent,
            parent_changed=parent_changed,
            move=move_input.move,
        )

    @staticmethod
    def clean_move(move_input):
        if move_input.parent_id and move_input.item_id == move_input.parent_id:
            raise ValidationError("항목을 자신의 부모로 설정할 수 없습니다.")

    @staticmethod
    def clean_operation(operation: MoveOperation[T]):
        if operation.new_parent and operation.item.is_ancestor_of(operation.new_parent):
            raise ValidationError("항목을 자신의 하위 항목으로 이동시킬 수 없습니다.")

    @staticmethod
    def perform_change_parent(operation: MoveOperation[T]):
        if not operation.parent_changed:
            return

        operation.item.move_to(operation.new_parent)
        operation.item.sort_order = None
        operation.item.save()
