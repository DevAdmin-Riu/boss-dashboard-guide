class BrandMileageMonthlySettlementUpdate(BrandMileageMonthlySettlementCreate):
    class Arguments:
        id = graphene.ID(
            description="ID of a BrandMileageMonthlySettlement to update.", required=True
        )
        input = BrandMileageMonthlySettlementUpdateInput(
            required=True, description="본부수익금 정산 정보"
        )

    class Meta:
        description = "본부수익금 정산 정보 Update"
        model = models.BrandMileageMonthlySettlement
        permissions = (AccountPermissions.MANAGE_MONTHLY_SETTLEMENT,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    # is_hq_staff이거나 permissions를 가진 유저이거나 check_permissions override
    @classmethod
    def check_permissions(cls, context, permissions=None, **data):
        if context.user.is_hq_staff:
            return True
        else:
            return super().check_permissions(context, permissions, **data)

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        # 확정에서 지급검토로 변환하는 경우 validation
        settlemnt_status = cleaned_input.get("settlement_status")
        # is_staff가 CONFIRMED으로 돌리는 경우 admin이 CONFIRMED 상태로 돌리는 반려인 경우이므로 반려사유가 존재해야 한다.
        if settlemnt_status == BrandMonthlySettlementStatus.CONFIRMED:
            if info.context.user.is_staff:
                reject_reason = cleaned_input.get("reject_reason")
                if reject_reason is None:
                    raise ValidationError(
                        "반려 사유를 입력해주세요.",
                    )
            else:
                raise ValidationError(
                    "확정으로 본부수익금 정산 상태를 변경할 수 없습니다.",
                )
        elif settlemnt_status == BrandMonthlySettlementStatus.REVIEWING_BY_ADMIN:
            # 가맹본부가 확정에서 지급검토로 바꾸는 경우
            if info.context.user.is_hq_staff:
                if cleaned_input.get("tax_invoice_image_by_hq_staff") is None:
                    raise ValidationError(
                        "본부 세금계산서 이미지를 첨부해주세요.",
                    )
        elif settlemnt_status in [
            BrandMonthlySettlementStatus.PAID,
            BrandMonthlySettlementStatus.WAITING_FOR_PAYMENT,
        ]:
            if info.context.user.is_hq_staff:
                raise ValidationError(
                    "가맹본부는 지급대기, 지급완료로 본부수익금 정산 상태를 변경할 수 없습니다.",
                )

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance: BrandMileageMonthlySettlementModel, cleaned_data):
        # 가맹본부가 확정에서 지급검토로 바꾸는 경우 settlement_review_requested_date를 현재 시각으로 업데이트한다.
        if (
            cleaned_data.get("settlement_status") == BrandMonthlySettlementStatus.REVIEWING_BY_ADMIN
            and instance.settlement_status == BrandMonthlySettlementStatus.CONFIRMED
        ):
            instance.settlement_review_requested_date = timezone.now()

            # NOTE post_save_action에 있는게 더 위치상 맞지만, 이전 instance와 비교하는 로직이 필요해 해당 위치에 구현
            # 가맹본부 담당자가 본부수익금 검토요청 시 -> MD 및 우리쪽 회계담당자에게 메일 전송
            brand = instance.brand
            staff_email = brand.staff.email if brand and brand.staff else None
            brand_name = brand.name if brand else ""
            date = instance.date
            date_str = date.strftime("%Y-%m")
            transaction.on_commit(
                lambda staff_email=staff_email, brand_name=brand_name, date=date_str: send_templated_mail_brand_settlement_requested.delay(
                    is_fbv=False,
                    staff_email=staff_email,
                    brand_name=brand_name,
                    date=date,
                )
            )
        # admin이 CONFIRMED 상태로 돌리는 반려인 경우 settlement_review_rejected_date를 현재 시각으로 업데이트 한다.
        elif (
            cleaned_data.get("settlement_status") == BrandMonthlySettlementStatus.CONFIRMED
            and instance.settlement_status == BrandMonthlySettlementStatus.REVIEWING_BY_ADMIN
        ):
            instance.settlement_review_rejected_date = timezone.now()

            # NOTE post_save_action에 있는게 더 위치상 맞지만, 이전 instance와 비교하는 로직이 필요해 해당 위치에 구현
            reject_reason = cleaned_data.get("reject_reason")
            brand = instance.brand
            brand_name = brand.name
            recipient_list = get_brand_accounting_person_email_list(brand)
            date = instance.date
            date_str = date.strftime("%Y-%m")
            transaction.on_commit(
                lambda recipient_list=recipient_list, brand_name=brand_name, date=date_str, reject_reason=reject_reason: send_templated_mail_brand_settlement_reject.delay(
                    is_fbv=False,
                    recipient_list=recipient_list,
                    brand_name=brand_name,
                    date=date,
                    reject_reason=reject_reason,
                )
            )
        # WAITING_FOR_PAYMENT 상태로 돌리는 경우는 승인이므로 settlement_review_approved_date를 현재 시각으로 업데이트 한다.
        elif (
            cleaned_data.get("settlement_status")
            == BrandMonthlySettlementStatus.WAITING_FOR_PAYMENT
            and instance.settlement_status == BrandMonthlySettlementStatus.REVIEWING_BY_ADMIN
        ):
            instance.settlement_review_approved_date = timezone.now()
            instance.settlement_review_approved_user = info.context.user
        # PAID 상태로 만드는 경우에는 settlement_paid_date를 현재 시각으로 업데이트한다.
        elif cleaned_data.get("settlement_status") == BrandMonthlySettlementStatus.PAID and (
            instance.settlement_status == BrandMonthlySettlementStatus.WAITING_FOR_PAYMENT
        ):
            instance.settlement_paid_date = timezone.now()
            instance.settlement_paid_user = info.context.user

            # NOTE post_save_action에 있는게 더 위치상 맞지만, 이전 instance와 비교하는 로직이 필요해 해당 위치에 구현
            # 지급완료 시 -> 브랜드몰 회계담당자에게 메일 전송명
            brand = instance.brand
            brand_name = brand.name
            recipient_list = get_brand_accounting_person_email_list(brand)
            date = instance.date
            date_str = date.strftime("%Y-%m")
            transaction.on_commit(
                lambda recipient_list=recipient_list, brand_name=brand_name, date=date_str: send_templated_mail_brand_settlement_paid.delay(
                    is_fbv=False,
                    recipient_list=recipient_list,
                    brand_name=brand_name,
                    date=date,
                )
            )

        # 위의 로직이 기존 instance의 상태를 봐야하므로 super().는 뒤에 함.
        instance = super().construct_instance(info, instance, cleaned_data)
        return instance


class BrandMileageMonthlySettlementStatusBulkUpdate(BaseBulkMutation):
    class Arguments:
        ids = graphene.List(
            graphene.ID, required=True, description="List of BrandMileageMonthlySettlement IDs."
        )
        settlement_status = BrandMonthlySettlementStatusEnum(
            required=True, description="본부수익금 정산 상태"
        )

    class Meta:
        description = "본부수익금 정산 상태를 일괄 처리"
        model = models.BrandMileageMonthlySettlement
        permissions = (AccountPermissions.MANAGE_MONTHLY_SETTLEMENT,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def perform_mutation(cls, _root, info, ids, **data):
        # data에 해당 기능 수행 유저를 넣어준다.
        data["settlement_review_approved_user"] = info.context.user
        return super().perform_mutation(_root, info, ids, **data)

    @classmethod
    def bulk_action(cls, queryset, settlement_status, settlement_review_approved_user):
        current_time = timezone.now()

        # 각 brand를 가져와서 brand 정보를 이용해서 send_templated_mail_for_hq_staff_in_case_mileage_settlement_paid 메일을 보낸다.
        for brand_mileage_monthly_settlement in queryset:
            brand = brand_mileage_monthly_settlement.brand
            brand_name = brand.name
            recipient_list = get_brand_accounting_person_email_list(brand)
            date = brand_mileage_monthly_settlement.date
            date_str = date.strftime("%Y-%m")
            transaction.on_commit(
                lambda recipient_list=recipient_list, brand_name=brand_name, date=date_str: send_templated_mail_brand_settlement_paid.delay(
                    is_fbv=False,
                    recipient_list=recipient_list,
                    brand_name=brand_name,
                    date=date,
                )
            )

        # 현재는 프론트에서 일괄 업데이트는 paid로 바꾸는 경우만 있어 아래와 같이 처리, 향후 추가하게되면 다른 필드 업데이트도 해야함.
        if settlement_status == BrandMonthlySettlementStatus.PAID:
            queryset.update(
                settlement_status=settlement_status,
                settlement_paid_date=current_time,
                settlement_paid_user=settlement_review_approved_user,
            )
        else:
            queryset.update(
                settlement_status=settlement_status,
            )


