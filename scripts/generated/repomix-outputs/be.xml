@app.task(name="stats.tasks.generate_brands_last_3_month_monthly_avg_sales_price")
@transaction.atomic()
def generate_brands_last_3_month_monthly_avg_sales_price(target_date: Optional[str] = None):
    # from django.db import connection
    # reset_queries()
    from_scheduler = target_date is None
    today = kst_timezone_date()
    if from_scheduler:
        target_date = today
    else:
        # Celery의 apply_async를 통해 전달된 인자는 JSON 직렬화를 거치기 때문에, target_date를 문자열에서 date 객체로 다시 변환
        target_date = datetime.strptime(target_date, "%Y-%m-%d").astimezone().date()

    # 오늘 날짜 기준
    first_day_of_this_month = target_date.replace(day=1)

    # 직전 3개월: 이번 달 제외
    recent_month_starts = [
        first_day_of_this_month - relativedelta(months=i) for i in range(1, 4)  # 1,2,3개월 전
    ]

    three_months_ago = recent_month_starts[2]

    brands_qs = Brand.objects.filter(
        first_day__lte=three_months_ago,
        is_running=True,
        is_boss_market=False,
    ).exclude(contract_type=BrandContractType.B2B)

    sales_per_month_subqs = []
    for month_start in recent_month_starts:
        month_end = month_start + relativedelta(months=1)
        subquery = (
            Sales.objects.filter(
                brand=OuterRef("pk"),
                evented_at__date__gte=month_start,
                evented_at__date__lt=month_end,
            )
            .values("brand")
            .annotate(
                month_sales=Coalesce(
                    Sum(F("unit_price") * F("quantity")), Value(0, output_field=DecimalField())
                )
            )
            .values("month_sales")
        )
        sales_per_month_subqs.append(subquery)

    brands_qs = brands_qs.annotate(
        sales_month_0=Coalesce(Subquery(sales_per_month_subqs[0]), Value(0)),
        sales_month_1=Coalesce(Subquery(sales_per_month_subqs[1]), Value(0)),
        sales_month_2=Coalesce(Subquery(sales_per_month_subqs[2]), Value(0)),
    ).annotate(
        last_3_month_avg_annot=Round(
            (F("sales_month_0") + F("sales_month_1") + F("sales_month_2")) / 3
        )
    )
    brands_qs.update(last_3_month_monthly_avg_sales_price=F("last_3_month_avg_annot"))

