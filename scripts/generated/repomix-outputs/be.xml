    @staticmethod
    def calculate_order_stats(
        qs, trunc_func, group_by_field="brand_id", stat_date_field: str = "evented_at"
    ):
        return (
            qs.annotate(stat_date=trunc_func(stat_date_field))
            .annotate(
                total_price_exclude_vat_only_fbv=Case(
                    When(is_fulfilled_by_vendor=True, then=F("total_price_exclude_vat")),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                total_price_include_vat_only_fbv=Case(
                    When(
                        is_fulfilled_by_vendor=True,
                        then=F("quantity") * F("unit_price"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                brand_paying_charge_exclude_vat_only_fbv=Case(
                    When(
                        is_fulfilled_by_vendor=True,
                        then=F("brand_paying_charge_exclude_vat"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                brand_paying_charge_include_vat_only_fbv=Case(
                    When(
                        is_fulfilled_by_vendor=True,
                        then=Round(F("brand_paying_charge_exclude_vat") * 1.1),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                brand_total_cost_exclude_vat_only_fbv=Case(
                    When(is_fulfilled_by_vendor=True, then=F("brand_total_cost_price_exclude_vat")),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                brand_total_cost_include_vat_only_fbv=Case(
                    When(
                        is_fulfilled_by_vendor=True,
                        then=F("quantity") * F("brand_unit_cost_price"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                total_cost_exclude_vat_only_fbv=Case(
                    When(
                        is_fulfilled_by_vendor=True,
                        then=F("quantity") * F("unit_cost_price_exclude_vat"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                total_cost_include_vat_only_fbv=Case(
                    When(
                        Q(is_fulfilled_by_vendor=True) & Q(is_tax_free=True),
                        then=F("quantity") * F("unit_cost_price_exclude_vat"),
                    ),
                    When(
                        Q(is_fulfilled_by_vendor=True) & Q(is_tax_free=False),
                        then=F("quantity") * Round(F("unit_cost_price_exclude_vat") * 1.1),
                    ),
                    default=Value(0),
