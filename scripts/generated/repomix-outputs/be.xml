from typing import Optional, Tuple

import graphene
import jwt
from django.core.exceptions import ValidationError
from django.middleware.csrf import _compare_masked_tokens, _get_new_csrf_token  # type: ignore
from django.utils import timezone
from django.utils.crypto import get_random_string
from graphene.types.generic import GenericScalar

from ....account import RequestOriginType, models
from ....account.error_codes import AccountErrorCode
from ....account.models import User as UserModel
from ....core.jwt import (
    JWT_REFRESH_TOKEN_COOKIE_NAME,
    JWT_REFRESH_TYPE,
    PERMISSIONS_FIELD,
    create_access_token,
    create_refresh_token,
    get_user_from_payload,
    jwt_decode,
)
from ....core.permissions import get_permissions_from_names
from ...core.mutations import BaseMutation
from ...core.types.common import AccountError
from ..enums import RequestOriginTypeEnum
from ..types import User


def get_payload(token):
    try:
        payload = jwt_decode(token)
    except jwt.ExpiredSignature:
        raise ValidationError(
            "Signature has expired", code=AccountErrorCode.JWT_SIGNATURE_EXPIRED.value
        )
    except jwt.DecodeError:
        raise ValidationError(
            "Error decoding signature", code=AccountErrorCode.JWT_DECODE_ERROR.value
        )
    except jwt.InvalidTokenError:
        raise ValidationError("Invalid token", code=AccountErrorCode.JWT_INVALID_TOKEN.value)
    return payload


def get_user(payload):
    try:
        user = get_user_from_payload(payload)
    except Exception:
        user = None
    if not user:
        raise ValidationError("Invalid token", code=AccountErrorCode.JWT_INVALID_TOKEN.value)
    permissions = payload.get(PERMISSIONS_FIELD)
    if permissions is not None:
        user.effective_permissions = get_permissions_from_names(permissions)
    return user


class CreateToken(BaseMutation):
    """Mutation that authenticates a user and returns token and user data."""

    class Arguments:
        login_id = graphene.String(required=True, description="LoginId of a user.")
        password = graphene.String(required=True, description="Password of a user.")
        request_origin = RequestOriginTypeEnum(
            required=True, description="로그인한 사이트(보스몰 / 대시보드)"
        )
        storefront_build_number = graphene.String(description="보스몰 빌드 번호")
        dashboard_build_number = graphene.String(description="대시보드 빌드 번호")
        extra_data = graphene.JSONString(
            description="유저 추가 정보 - User agent 정보 등 유저 특이 사항 분석을 위한 데이터"
        )

    class Meta:
        description = "Create JWT token."
        error_type_class = AccountError
        error_type_field = "account_errors"

    token = graphene.String(description="JWT token, required to authenticate.")
    refresh_token = graphene.String(
        description="JWT refresh token, required to re-generate access token."
    )
    csrf_token = graphene.String(description="CSRF token required to re-generate access token.")
    user = graphene.Field(User, description="A user instance.")
    is_reactivated = graphene.Boolean(
        description="비활성화 상태에서 로그인 여부", default_value=False
    )

    @classmethod
    def _retrieve_user_from_password(
        cls, user, password
    ) -> Tuple[Optional[models.User], Optional[AccountErrorCode]]:
        # 로그인 시도 5회 이상 인 경우. 무조건 로그인 불가.
        if user.wrong_login_try >= 5:
            return user, AccountErrorCode.TOO_MANY_WRONG_LOGIN_TRY
        if user.check_password(password):
            return user, None
        else:
            return user, AccountErrorCode.INVALID_PASSWORD

    @classmethod
    def _retrieve_user_from_credentials(
        cls, login_id, password
    ) -> Tuple[Optional[models.User], Optional[AccountErrorCode]]:
        user = models.User.objects.filter(login_id=login_id).first()
        if user:
            return cls._retrieve_user_from_password(user, password)
        else:
            return None, AccountErrorCode.NOT_FOUND

    @classmethod
    def get_user_and_error(
        cls, _info, data
    ) -> Tuple[Optional[UserModel], Optional[AccountErrorCode]]:
        user, error_code = cls._retrieve_user_from_credentials(data["login_id"], data["password"])
        return user, error_code

    @classmethod
    def check_errors(cls, user: UserModel, error_code: AccountErrorCode):
        if error_code == AccountErrorCode.NOT_FOUND:
            raise ValidationError(
                {
                    "login_id": ValidationError(
                        "존재하지 않는 아이디입니다.<br/>아이디를 확인해주세요.",
                        code=AccountErrorCode.NOT_FOUND,
                    )
                }
            )
        elif error_code == AccountErrorCode.INVALID_PASSWORD:
            # 동시성 이슈는 고려하지 않음.
            user.wrong_login_try += 1
            user.save(update_fields=["wrong_login_try"])

            error_msg = (
                f"비밀번호가 일치하지 않습니다.<br/>(남은 재시도 횟수: {5 - user.wrong_login_try})<br/>모두 소진 시 비밀번호 찾기를 "
                f"이용하셔야합니다."
            )
            if user.wrong_login_try == 5:
                error_msg = f"비밀번호가 5회 이상 일치하지않아 계정이 잠겼습니다.<br/>비밀번호 찾기를 이용해주세요."

            raise ValidationError(
                {
                    "password": ValidationError(
                        error_msg,
                        code=AccountErrorCode.INVALID_PASSWORD,
                    )
                }
            )
        elif error_code == AccountErrorCode.TOO_MANY_WRONG_LOGIN_TRY:
            raise ValidationError(
                {
                    "password": ValidationError(
                        "비밀번호가 5회 이상 일치하지않아 계정이 잠겼습니다.<br/>비밀번호 찾기를 이용해주세요.",
                        code=AccountErrorCode.TOO_MANY_WRONG_LOGIN_TRY,
                    )
                }
            )

    @classmethod
    def validate_user_request_origin(cls, user: UserModel):
        if user.request_origin == RequestOriginType.MALL:
            if user.is_vendor_staff:
                raise ValidationError("포장보스몰에서 이용할 수 있는 계정이 아닙니다.")

    @classmethod
    def perform_mutation(cls, root, info, **data):
        user, error_code = cls.get_user_and_error(info, data)
        cls.check_errors(user, error_code)

        user.request_origin = data.get("request_origin", user.request_origin)
        cls.validate_user_request_origin(user)

        access_token = create_access_token(user)
        csrf_token = _get_new_csrf_token()
        refresh_token = create_refresh_token(user, {"csrfToken": csrf_token})
        info.context.refresh_token = refresh_token
        info.context._cached_user = user
        user.last_login = timezone.now()
        user.wrong_login_try = 0
        user.storefront_build_number = data.get(
            "storefront_build_number", user.storefront_build_number
        )
        user.dashboard_build_number = data.get(
            "dashboard_build_number", user.dashboard_build_number
        )
        user.extra_data = data.get("extra_data", user.extra_data)
        updated_fields = [
            "last_login",
            "wrong_login_try",
            "storefront_build_number",
            "dashboard_build_number",
            "extra_data",
        ]
        is_reactivated = False
        if not user.is_active:
            user.is_active = True
            is_reactivated = True
            updated_fields.append("is_active")
        user.save(update_fields=updated_fields)
        return cls(
            user=user,
            token=access_token,
            refresh_token=refresh_token,
            csrf_token=csrf_token,
            is_reactivated=is_reactivated,
        )


class RefreshToken(BaseMutation):
    """Mutation that refresh user token and returns token and user data."""

    token = graphene.String(description="JWT token, required to authenticate.")
    user = graphene.Field(User, description="A user instance.")

    class Arguments:
        refresh_token = graphene.String(required=False, description="Refresh token.")
        csrf_token = graphene.String(
            required=False,
            description=(
                "CSRF token required to refresh token. This argument is "
                "required when refreshToken is provided as a cookie."
            ),
        )

    # "If it fails it will try to take refreshToken from the http-only cookie -"
    # f"{JWT_REFRESH_TOKEN_COOKIE_NAME}. csrfToken is required when refreshToken "
    # "is provided as a cookie."
    class Meta:
        description = "Refresh JWT token."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def get_refresh_token_payload(cls, refresh_token):
        try:
            payload = get_payload(refresh_token)
        except ValidationError as e:
            raise ValidationError({"refreshToken": e})
        return payload

    @classmethod
    def get_refresh_token(cls, info, data):
        request = info.context
        refresh_token = request.COOKIES.get(JWT_REFRESH_TOKEN_COOKIE_NAME, None)
        refresh_token = data.get("refresh_token") or refresh_token
        return refresh_token

    @classmethod
    def clean_refresh_token(cls, refresh_token):
        if not refresh_token:
            raise ValidationError(
                {
                    "refreshToken": ValidationError(
                        "Missing refreshToken",
                        code=AccountErrorCode.JWT_MISSING_TOKEN.value,
                    )
                }
            )
        payload = cls.get_refresh_token_payload(refresh_token)
        if payload["type"] != JWT_REFRESH_TYPE:
            raise ValidationError(
                {
                    "refreshToken": ValidationError(
                        "Incorrect refreshToken",
                        code=AccountErrorCode.JWT_INVALID_TOKEN.value,
                    )
                }
            )
        return payload

    @classmethod
    def clean_csrf_token(cls, csrf_token, payload):
        is_valid = _compare_masked_tokens(csrf_token, payload["csrfToken"])
        if not is_valid:
            raise ValidationError(
                {
                    "csrfToken": ValidationError(
                        "Invalid csrf token",
                        code=AccountErrorCode.JWT_INVALID_CSRF_TOKEN.value,
                    )
                }
            )

    @classmethod
    def get_user(cls, payload):
        try:
            user = get_user(payload)
        except ValidationError as e:
            raise ValidationError({"refreshToken": e})
        return user

    @classmethod
    def perform_mutation(cls, root, info, **data):
        refresh_token = cls.get_refresh_token(info, data)
        payload = cls.clean_refresh_token(refresh_token)

        # None when we got refresh_token from cookie.
        if not data.get("refresh_token"):
            csrf_token = data.get("csrf_token")
            cls.clean_csrf_token(csrf_token, payload)

        user = get_user(payload)
        token = create_access_token(user)
        return cls(user=user, token=token)


class VerifyToken(BaseMutation):
    """Mutation that confirms if token is valid and also returns user data."""

    user = graphene.Field(User, description="User assigned to token.")
    is_valid = graphene.Boolean(
        required=True,
        default_value=False,
        description="Determine if token is valid or not.",
    )
    payload = GenericScalar(description="JWT payload.")

    class Arguments:
        token = graphene.String(required=True, description="JWT token to validate.")

    class Meta:
        description = "Verify JWT token."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def get_payload(cls, token):
        try:
            payload = get_payload(token)
        except ValidationError as e:
            raise ValidationError({"token": e})
        return payload

    @classmethod
    def get_user(cls, payload):
        try:
            user = get_user(payload)
        except ValidationError as e:
            raise ValidationError({"token": e})
        return user

    @classmethod
    def perform_mutation(cls, root, info, **data):
        token = data["token"]
        payload = cls.get_payload(token)
        user = cls.get_user(payload)
        return cls(user=user, is_valid=True, payload=payload)


class DeactivateAllUserTokens(BaseMutation):
    class Meta:
        description = "Deactivate all JWT tokens of the currently authenticated user."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        return context.user.is_authenticated

    @classmethod
    def perform_mutation(cls, root, info, **data):
        user = info.context.user
        user.jwt_token_key = get_random_string()
        user.save(update_fields=["jwt_token_key"])
        return cls()
