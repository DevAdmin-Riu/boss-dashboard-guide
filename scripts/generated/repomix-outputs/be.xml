    @classmethod
    def update_direct_shipping_detail(cls, address: "AddressModel", cleaned_input):
        direct_shipping_detail = cleaned_input.get("direct_shipping_detail")

        if direct_shipping_detail or direct_shipping_detail == {}:
            ds_detail_instance = models.DirectShippingDetail.objects.filter(
                pk=address.direct_shipping_detail_id
            ).first()
            if ds_detail_instance:
                update_fields = []
                exist_normal_key = direct_shipping_detail.get("exist_normal_key")
                if exist_normal_key is not None:
                    ds_detail_instance.exist_normal_key = exist_normal_key
                    update_fields.append("exist_normal_key")
                exist_card_key = direct_shipping_detail.get("exist_card_key")
                if exist_card_key is not None:
                    ds_detail_instance.exist_card_key = exist_card_key
                    update_fields.append("exist_card_key")
                exist_number_key = direct_shipping_detail.get("exist_number_key")
                if exist_number_key is not None:
                    ds_detail_instance.exist_number_key = exist_number_key
                    update_fields.append("exist_number_key")
                caution = direct_shipping_detail.get("caution")
                if caution is not None:
                    ds_detail_instance.caution = caution
                    update_fields.append("caution")
                ds_detail_instance.save(update_fields=update_fields)
                cleaned_input["direct_shipping_detail"] = ds_detail_instance
            else:
                cleaned_input = BaseAddressUpdate.create_direct_shipping_detail(cleaned_input)

        return cleaned_input

    @classmethod
    def clean_input(cls, info, instance, input_data):
        # Method check_permissions cannot be used for permission check, because
        # it doesn't have the address instance.
        user = info.context.user
        if not can_edit_address(user, instance):
            raise PermissionDenied(user=user, cls=cls)
        return super().clean_input(info, instance, input_data)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        context_user = info.context.user
        is_staff = context_user.is_staff
        instance = cls.get_instance(info, **data)
        cleaned_input = cls.clean_input(info=info, instance=instance, input_data=data.get("input"))
        cleaned_input = AddressInput.validate_direct_shipping_code(
            is_staff, cleaned_input, instance
        )
        cleaned_input = cls.update_direct_shipping_detail(instance, cleaned_input)
        address = cls.validate_address(cleaned_input, instance=instance)
        user = address.user_addresses.first()
        cls.clean_instance(info, address)
        cls.save(info, address, cleaned_input)
        cls._save_m2m(info, address, cleaned_input)

        success_response = cls.success_response(address)
