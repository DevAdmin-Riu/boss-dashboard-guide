            "product_variant__default_variant_vendor__external_product_name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_tax_free(qs, _, value):
        if value is not None:
            qs = qs.filter(brand_product__product__is_tax_free=value)
        return qs

    def filter_track_inventory(qs, _, value):
        if value is not None:
            qs = qs.filter(product_variant__track_inventory=value)
        return qs

    def filter_is_deferred(qs, _, value):
        if value is not None:
            qs = qs.filter(product_variant__is_deferred=value)
        return qs

    def filter_is_adjust_price(qs, _, value):
        if value is not None:
            qs = qs.filter(product_variant__is_adjust_price=value)
        return qs

    def filter_brand_is_running(qs, _, value):
        if value is not None:
            qs = qs.filter(brand__is_running=value)
        return qs

    bp_sku = ListObjectTypeFilter(input_class=graphene.String, method=filter_bp_sku_list)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    vendor_search = django_filters.CharFilter(method=filter_vendor_search)
    external_product_search = django_filters.CharFilter(method=filter_external_product_search)
    brand_product_search = django_filters.CharFilter(method=filter_brand_product_search)
