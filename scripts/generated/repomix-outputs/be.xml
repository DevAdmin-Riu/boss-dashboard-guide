from datetime import timedelta

from graphene import Date

from ..account.models import Address
from ..core.utils.kst_time import kst_timezone_date
from . import EXP_DATE_WARNING_THRESHOLD, StockDetailExpDateStatus
from .models import RackLocation, RackSector


def get_exp_date_status(exp_date: Date):
    if exp_date is None:
        return StockDetailExpDateStatus.NORMAL

    today = kst_timezone_date()
    warning_threshold = today + timedelta(days=EXP_DATE_WARNING_THRESHOLD)

    if exp_date <= today:
        return StockDetailExpDateStatus.EXCEEDED
    elif exp_date < warning_threshold:
        return StockDetailExpDateStatus.WARNING
    return StockDetailExpDateStatus.NORMAL


def make_full_location_text(rack_location: RackLocation):
    if not rack_location:
        return "-"

    str_list = []
    rack_sector: RackSector = rack_location.sector
    if rack_sector:
        str_list.append(rack_sector.name)
    warehouse_address: Address = rack_sector.address if rack_sector else None
    if warehouse_address:
        str_list.append(warehouse_address.company_name)
    str_list.append(rack_location.name)
    return " / ".join(str_list)
