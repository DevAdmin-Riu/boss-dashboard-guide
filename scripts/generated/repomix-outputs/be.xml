import math

from ..account import RequestOriginType
from ..core.utils.kst_time import kst_timezone_now
from ..graphql.bbs.utils import send_push_notification_by_parameters
from .models import ScheduleAlarm


def push_notification_on_schedule_alarm(
    schedule_alarm: ScheduleAlarm,
):
    schedule = schedule_alarm.schedule
    user_ids = schedule.participants.values_list("id", flat=True)
    request_origin = RequestOriginType.DASHBOARD
    title = "일정 알림"
    link_url = ""

    now = kst_timezone_now()
    datetime_before = schedule.start - now
    minutes_before = minutes_before = math.ceil(datetime_before.total_seconds() / 60)

    if minutes_before >= 60:
        hours = minutes_before // 60
        minutes = minutes_before % 60
        if minutes == 0:
            time_text = f"{hours}시간 후"
        else:
            time_text = f"{hours}시간 {minutes}분 후"
    elif minutes_before > 0:
        time_text = f"{minutes_before}분 후"
    else:
        time_text = "지금"

    content = f"{time_text} [{schedule.title}] 일정이 시작됩니다."

    send_push_notification_by_parameters(
        user_ids=user_ids,
        app_type=request_origin,
        parameters={
            "title": title,
            "content": content,
            "data": {
                "link_url": link_url,
            },
        },
    )
