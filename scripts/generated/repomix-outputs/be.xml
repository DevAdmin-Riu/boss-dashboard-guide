class GroupsByUserIdAndPermissionNameLoader(DataLoader):
    context_key = "groups_by_user_id"

    def batch_load(self, keys):
        # key는 튜플임.
        user_ids = [key[0] for key in keys]
        permission_names = [key[1] for key in keys]

        through_table_user_group = User.groups.through
        through_table_group_permission = auth_models.Group.permissions.through

        user_groups_subquery = through_table_user_group.objects.filter(user_id__in=user_ids).values(
            "group_id"
        )

        group_permissions_relations = (
            through_table_group_permission.objects.filter(
                group_id__in=Subquery(user_groups_subquery), permission__name__in=permission_names
            )
            .select_related("permission", "permission__content_type", "group")
            .prefetch_related("group__user_set")
        )

        group_map = defaultdict(list)

        for relation in group_permissions_relations:
            group = relation.group
            permission = relation.permission

            for user in group.user_set.all():
                if (str(user.id), permission.name) in keys:
                    group_map[(str(user.id), permission.name)].append(group)

        return [group_map[(user_id, permission_name)] for user_id, permission_name in keys]


class UserEffectivePermissionsByUserIdLoader(DataLoader):
    context_key = "user_effective_permissions_by_user_id"

    def batch_load(self, keys):
        through_table_user_permission = User.user_permissions.through
        through_table_user_group = User.groups.through
        through_table_group_permission = auth_models.Group.permissions.through

        user_permission_relations = through_table_user_permission.objects.filter(
            user_id__in=keys
        ).select_related("permission", "permission__content_type")

        user_groups_subquery = through_table_user_group.objects.filter(user_id__in=keys).values(
            "group_id"
        )

        group_permissins_relations = (
            through_table_group_permission.objects.filter(
                group_id__in=Subquery(user_groups_subquery)
            )
            .select_related("permission", "permission__content_type")
            .prefetch_related("group__user_set")
        )

        # 중복 방지를 위해 set 사용
        permission_map = defaultdict(set)

        # 사용자의 직접 권한 추가 (중복 방지)
        for relation in user_permission_relations:
            permission = relation.permission
            permission_map[relation.user_id].add(permission)

        # 그룹에서 상속된 권한 추가 (중복 방지)
        for relation in group_permissins_relations:
            permission = relation.permission
            for user in relation.group.user_set.all():
                permission_map[user.id].add(permission)

        # set을 list로 변환
        return [list(permission_map[user_id]) for user_id in keys]


