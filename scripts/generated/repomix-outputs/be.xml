            return DirectShippingDetailByIdLoader(info.context).load(root.direct_shipping_detail_id)
        else:
            return None

    def resolve_region_info(root: RegionInfoModel, info):
        return (
            RegionInfoAllLoader(info.context)
            .load(1)
            .then(
                # 모든 region info all을 가지고와서, 코드가 00인것은 제외하고 나머지 중에서 root의 post_code가 pcode_start, pcode_end 사이에 있는 단 한개의 값을 return한다.
                lambda region_infos: [
                    region_info
                    for region_info in region_infos
                    if region_info.code != "00"
                    and region_info.pcode_start <= root.postal_code
                    and region_info.pcode_end >= root.postal_code
                ][0]
            )
        )


