import graphene
from django.contrib.auth.models import AnonymousUser

from ...account.models import User
from ...page import models
from ...page.utils import replace_page_content_string
from ...taxinvoice.interface import BizRegInfo
from ...taxinvoice.utils import get_biz_reg_info_by_brand


def resolve_page(info, global_page_id=None, slug=None):
    assert global_page_id or slug, "No page ID or slug provided."
    user: User = info.context.user

    if slug is not None:
        page = models.Page.objects.visible_to_user(user).filter(slug=slug).first()
    else:
        _type, page_pk = graphene.Node.from_global_id(global_page_id)
        page = models.Page.objects.visible_to_user(user).filter(pk=page_pk).first()

    if user != AnonymousUser():
        is_brand_user = user.is_brand_user
        is_reverse_fee_contract_type = (
            user.brand.is_reverse_fee_contract_type if is_brand_user else False
        )
        if is_reverse_fee_contract_type:
            content = page.content
            reverse_fee_mail_order_sales = user.brand.reverse_fee_mail_order_sales
            brand_biz_info = user.brand.biz_info
            reverse_fee_mail_order_sales["biz_reg_no"] = brand_biz_info.get("bizRegNo", "")
            reverse_fee_mail_order_sales["ceo_name"] = brand_biz_info.get("bizRepName", "")
            reverse_fee_mail_order_sales["corp_name"] = brand_biz_info.get("bizName", "")
            reverse_fee_mail_order_sales["address"] = brand_biz_info.get("bizAddress", "")
            reverse_fee_mail_order_sales["phone"] = brand_biz_info.get("bizContact", "")

            for key, value in reverse_fee_mail_order_sales.items():
                old_value = "{%s}" % key
                replace_page_content_string(content, old_value, value)

            page.content = content

    return page


def resolve_pages(info, **_kwargs):
    user = info.context.user
    return models.Page.objects.visible_to_user(user).distinct()
