import base64
import copy
import hashlib
import logging
import socket
from typing import TYPE_CHECKING, Union

import requests
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad
from django.core.exceptions import ValidationError
from django.db import transaction

from ....core.utils.kst_time import kst_timezone_now
from ....order import OrderEvents
from ....order.events import pg_refund_event
from ....plugins.manager import get_plugins_manager
from ... import PgRefundEventStatus, models
from .define import INICIS_GATEWAY_PLUGIN_ID
from .interface import InicisCardRefundData, InicisRefundResponse, InicisVbankRefundData

logger = logging.getLogger(__name__)

if TYPE_CHECKING:
    from ....account.models import User
    from ....order.models import Order
    from ...models import InicisApiKey, Payment, Transaction


# 이니시스 가상계좌 AES-128-cbc 암호화 함수
def encrypt_with_aes_utf8_iv(refundAcctNum, key, iv):
    key = key.encode("utf-8")[:16]
    iv = iv.encode("utf-8")[:16]
    data = pad(refundAcctNum.encode("utf-8"), 16)
    cipher = AES.new(key, AES.MODE_CBC, iv=iv)
    encrypted_data = cipher.encrypt(data)
    encrypted_base64_data = base64.b64encode(encrypted_data)
    return encrypted_base64_data.decode("utf-8")


# https://manual.inicis.com/pay/cancel.html
def process_inicis_refund(
    order: "Order",
    payment: "Payment",
    refund_transaction: "Transaction",
    staff_user: "User",
    pg_refund_data: Union[InicisCardRefundData, InicisVbankRefundData],
) -> InicisRefundResponse:

    price = pg_refund_data.refund_amount
    if price <= 0:
        return None

    request_params = None
    response = None
    order_event_params = None
    pg_refund_event_obj = None
    is_success = False
    error_msg = None
    inicis_refund_response = None
    try:
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(INICIS_GATEWAY_PLUGIN_ID)

        with transaction.atomic():
            inicis_refund_url = (
                "https://iniapi.inicis.com/api/v1/refund"
                if plugin_configs.is_prod_mode
                else "https://stginiapi.inicis.com/api/v1/refund"
            )
            headers = {
                "Content-Type": "application/x-www-form-urlencoded;charset=utf-8",
            }
            now = kst_timezone_now()
            timestamp = now.strftime("%Y%m%d%H%M%S")
            hostname = socket.gethostname()
            clientIp = socket.gethostbyname(hostname)

            type = "PartialRefund"
            paymethod = pg_refund_data.pg_refund_pay_method
            mid = pg_refund_data.mid
            inicis_api_key: InicisApiKey = models.InicisApiKey.objects.filter(mid=mid).first()
            if inicis_api_key is None:
                raise ValidationError(
                    f"결제에 사용된 mid={mid} 에 대한 Inicis Api Key 정보가 없어서 환불을 진행할 수 없습니다."
                )
            INIAPIKey = inicis_api_key.ini_api_key
            tid = pg_refund_data.tid
            msg = pg_refund_data.refund_reason
            confirmPrice = pg_refund_data.remain_refundable_amount

            if payment.is_card_pay():
                hashData = f"{INIAPIKey}{type}{paymethod}{timestamp}{clientIp}{mid}{tid}{price}{confirmPrice}"
                hashData = hashlib.sha512(hashData.encode()).hexdigest()
                request_params = {
                    "type": type,
                    "paymethod": paymethod,
                    "timestamp": timestamp,
                    "clientIp": clientIp,
                    "mid": mid,
                    "tid": tid,
                    "msg": msg,
                    "price": price,
                    "confirmPrice": confirmPrice,
                    "tax": pg_refund_data.refund_tax_amount,
                    "taxFree": pg_refund_data.refund_tax_free_amount,
                    "hashData": hashData,
                }
            elif payment.is_vbank_pay():
                pg_refund_bank_info = pg_refund_data.pg_refund_bank_info
                if pg_refund_bank_info is None or pg_refund_bank_info.bank_code is None:
                    logger.error(f"refund_debug: {pg_refund_bank_info}")
                    raise ValidationError("환불 은행 정보 오류로 환불을 진행할 수 없습니다.")
                INIAPIIv = inicis_api_key.ini_api_iv
                refundAcctNum = pg_refund_bank_info.account_number
                encrypted_account_number = encrypt_with_aes_utf8_iv(
                    refundAcctNum, INIAPIKey, INIAPIIv
                )
                hashData = f"{INIAPIKey}{type}{paymethod}{timestamp}{clientIp}{mid}{tid}{price}{confirmPrice}{encrypted_account_number}"
                hashData = hashlib.sha512(hashData.encode()).hexdigest()
                request_params = {
                    "type": type,
                    "paymethod": paymethod,
                    "timestamp": timestamp,
                    "clientIp": clientIp,
                    "mid": mid,
                    "tid": tid,
                    "msg": msg,
                    "price": price,
                    "confirmPrice": confirmPrice,
                    "refundAcctNum": encrypted_account_number,
                    "refundBankCode": pg_refund_bank_info.bank_code,
                    "refundAcctName": pg_refund_bank_info.account_holder_name,
                    "hashData": hashData,
                }
            order_event_params = copy.deepcopy(request_params)
            # 프론트엔드에서 enum compare 하기 위해서 name 값으로 세팅
            pg_refund_event_status = PgRefundEventStatus.REQUESTED
            order_event_params["paymethod"] = paymethod.name
            order_event_params["status"] = pg_refund_event_status.name
            # 이니시스 환불 요청 상태 이벤트 기록
            pg_refund_event_obj = models.PgRefundEvent.objects.create(
                pay_method=paymethod,
                status=pg_refund_event_status,
                order=order,
                payment=payment,
                transaction=refund_transaction,
                user=staff_user,
                request_parameters=request_params,
                refund_amount=price,
                before_captured_amount=price + confirmPrice,
                after_captured_amount=confirmPrice,
            )
            pg_refund_event(
                order=order,
                type=OrderEvents.INICIS_REFUND,
                staff_user=staff_user,
                params=order_event_params,
            )

            org_response = requests.post(inicis_refund_url, headers=headers, data=request_params)
            response = org_response.json()
            result_code = response.get("resultCode")
            if result_code == "00":
                is_success = True
                inicis_refund_response = InicisRefundResponse(
                    tid=response.get("tid"),
                    prtcDate=response.get("prtcDate"),
                    prtcTime=response.get("prtcTime"),
                )
            else:
                error_msg = response.get("resultMsg")

    except Exception as e:
        logger.error(f"inicis refund exception:  ({pg_refund_data}) - {e}")
        error_msg = f"이니시스 환불 처리 오류"

    if is_success:
        logger.info(f"inicis refund success: ({pg_refund_data})")
    else:
        logger.error(f"inicis refund error:  ({pg_refund_data}) - {request_params} - {response}")

    # 이니시스 환불 요청 결과 이벤트 기록
    if order_event_params:
        pg_refund_event_status = (
            PgRefundEventStatus.SUCCESS if is_success else PgRefundEventStatus.FAIL
        )
        order_event_params["status"] = pg_refund_event_status.name

        if response:
            order_event_params["resultMsg"] = response.get("resultMsg")
            pg_refund_event_obj.response_parameters = response
            pg_refund_event_obj.status = pg_refund_event_status
            pg_refund_event_obj.save(update_fields=["status", "response_parameters"])

            refund_transaction.gateway_response = response
            refund_transaction.save(update_fields=["gateway_response"])

        pg_refund_event(
            order=order,
            type=OrderEvents.INICIS_REFUND,
            staff_user=staff_user,
            params=order_event_params,
        )

    if error_msg:
        raise ValidationError(f"이니시스 결제 환불 처리에 실패했습니다. {error_msg}")

    return inicis_refund_response
