    @classmethod
    def add_change_price_details(cls, base_info, details, brands, product_variants):
        create_list = []
        for detail in details:
            external_sku = detail.get("external_sku")
            product_sku = detail.get("product_sku")
            brand_code = detail.get("brand_code")
            region_id = detail.get("region")
            base_price = detail.get("base_price")
            delivery_fee = detail.get("delivery_fee")
            cost_price = detail.get("cost_price")
            price = detail.get("price")

            product_variant = product_variants[product_sku]
            brand = brands[brand_code] if brand_code else None

            reserve_change_detail = models.ReserveChangePriceDetails(
                base_info=base_info,
                product_variant=product_variant,
                brand=brand,
                region_id=region_id,
                external_sku=external_sku,
                base_price_amount=base_price,
                price_amount=price,
                cost_price_amount=cost_price,
                delivery_fee_amount=delivery_fee,
            )

            # 권역 데이터가 있는 것만 가격 변경 데이터에 추가
            if brand:
                brand_product_variant = models.BrandProductVariant.objects.get(
                    brand=brand, product_variant=product_variant
                )
                try:
                    models.BrandProductVariantRegion.objects.get(
                        brand_product_variant=brand_product_variant, region_id=region_id
                    )
                    create_list.append(reserve_change_detail)
                except ObjectDoesNotExist:
                    pass
            else:
                try:
                    models.ProductVariantRegion.objects.get(
                        product_variant=product_variant, region_id=region_id
                    )
                    create_list.append(reserve_change_detail)
                except ObjectDoesNotExist:
                    pass

        if len(create_list) > 0:
            models.ReserveChangePriceDetails.objects.bulk_create(create_list)

    @classmethod
    def make_detail_code(cls, detail):
        product_sku = detail.get("product_sku")
        region_name = detail.get("region_name")
        brand_code = detail.get("brand_code")
        if brand_code:
            return f"({product_sku}:{region_name}:{brand_code})"
        return f"({product_sku}:{region_name}:기준제품)"

    @classmethod
    def validate_reserved(cls, reserved):
        if reserved is None:
            error_msg = "반영일 데이터 누락"
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)

        check_date = kst_timezone_date()
        if check_date >= reserved:
            error_msg = "반영일은 내일 이후로 지정해야 합니다."
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)

    @classmethod
    def validate_value_empty(cls, details):
        delivery_fee_errors = []
        cost_price_errors = []
        price_errors = []
        for detail in details:
            delivery_fee = detail.get("delivery_fee")
            cost_price = detail.get("cost_price")
            price = detail.get("price")
            detail_code = cls.make_detail_code(detail)

            if delivery_fee is None or delivery_fee < 0:
                delivery_fee_errors.append(detail_code)
            if cost_price is None or cost_price < 0:
                cost_price_errors.append(detail_code)
            if price is None or price < 0:
                price_errors.append(detail_code)

        if len(price_errors) > 0:
            error_msg = "판매가 오류 (상품:권역:브랜드): {}".format(", ".join(price_errors))
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)
        if len(cost_price_errors) > 0:
            error_msg = "매입가 오류 (상품:권역:브랜드): {}".format(", ".join(cost_price_errors))
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)
        if len(delivery_fee_errors) > 0:
            error_msg = "택배비 오류 (상품:권역:브랜드): {}".format(", ".join(delivery_fee_errors))
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)

    @classmethod
    def validate_already_reserved(cls, details, brands, product_variants):
        errors = []
        for detail in details:
            product_sku = detail.get("product_sku")
            brand_code = detail.get("brand_code")
            product_variant = product_variants[product_sku]
            brand = brands[brand_code] if brand_code else None
            try:
                models.ReserveChangePriceDetails.objects.get(
                    product_variant=product_variant,
                    brand=brand,
                    is_applied=False,
                )
                errors.append(cls.make_detail_code(detail))
                continue
            except ObjectDoesNotExist:
                pass

        if len(errors) > 0:
            error_msg = "이미 예약 등록된 (상품:권역:브랜드) 존재: {}".format(", ".join(errors))
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)

    @classmethod
    def validate_base_price(cls, details, product_variants):
        errors = []
        base_price_dict = {}
        keys_of_already_regiter = []
        for detail in details:
            product_sku = detail.get("product_sku")
            region_id = detail.get("region")
            base_price = detail.get("base_price")
            detail_code = cls.make_detail_code(detail)

            if base_price is None or base_price <= 0:
                errors.append(detail_code)
            else:
                check_key = f"{product_sku}-{region_id}"
                if check_key not in keys_of_already_regiter:
                    keys_of_already_regiter.append(check_key)
                    product_variant = product_variants[product_sku]
                    try:
                        prev_detail = models.ReserveChangePriceDetails.objects.get(
                            product_variant=product_variant,
                            region_id=region_id,
                            brand=None,
                            is_applied=False,
                        )
                        if check_key in base_price_dict:
                            if base_price_dict[check_key] != prev_detail.base_price_amount:
                                errors.append(detail_code)
                        base_price_dict[check_key] = base_price
                    except ObjectDoesNotExist:
                        pass

                if check_key in base_price_dict:
                    if base_price_dict[check_key] != base_price:
                        errors.append(detail_code)
                else:
                    base_price_dict[check_key] = base_price

        if len(errors) > 0:
            error_msg = "기준가 오류 (상품:권역:브랜드): {}".format(", ".join(errors))
            raise ValidationError(error_msg, code=ProductErrorCode.INVALID.value)

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        region_info = RegionInfo.objects.all()
        reserved = cleaned_input.get("reserved")
        details = []
        details_input = cleaned_input.get("details")
        for detail in details_input:
            region_code_input = detail.get("region_code")
            region_code_array = [code.strip() for code in region_code_input.split(",")]
            for region_code in region_code_array:
                region = region_info.filter(code=region_code).first()
                external_sku = detail.get("external_sku")
                product_sku = detail.get("product_sku")
                brand_code = detail.get("brand_code")
                base_price = detail.get("base_price")
                price = detail.get("price")
                cost_price = detail.get("cost_price")
                delivery_fee = detail.get("delivery_fee")

                detail_line = {
                    "external_sku": external_sku,
                    "product_sku": product_sku,
                    "brand_code": brand_code,
                    "region": region.id if region else None,
                    "region_name": region.name if region else None,
                    "region_code": region_code,
                    "base_price": base_price,
                    "price": price,
                    "cost_price": cost_price,
                    "delivery_fee": delivery_fee,
                }

                details.append(detail_line)

        cls.validate_reserved(reserved)
        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        cls.validate_value_empty(details)

        validate_region(details)
        brands = validate_brand_code(details)
        _, product_variants, _ = validate_product_sku(details)
        validate_brand_product_variant(cls, details, brands, product_variants)
        cls.validate_already_reserved(details, brands, product_variants)
        cls.validate_base_price(details, product_variants)

        cleaned_input["details"] = details
        return cleaned_input, brands, product_variants

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input, brands, product_variants = cls.clean_input(info, instance, data)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input)
        response = cls.success_response(instance)

        details = cleaned_input.get("details")
        cls.add_change_price_details(
            base_info=instance,
            details=details,
            brands=brands,
            product_variants=product_variants,
        )

        return response


class CancelReserveChangePriceBase(ModelDeleteMutation):
