class AttributeAssignmentMixin:
    """Handles cleaning of the attribute input and creating the proper relations.

    1. You should first call ``clean_input``, to transform and attempt to resolve
       the provided input into actual objects. It will then perform a few
       checks to validate the operations supplied by the user are possible and allowed.
    2. Once everything is ready and all your data is saved inside a transaction,
       you shall call ``save`` with the cleaned input to build all the required
       relations. Once the ``save`` call is done, you are safe from continuing working
       or to commit the transaction.

    Note: you shall never call ``save`` outside of a transaction and never before
    the targeted instance owns a primary key. Failing to do so, the relations will
    be unable to build or might only be partially built.
    """

    @classmethod
    def _resolve_attribute_nodes(
        cls,
        qs: QuerySet,
        *,
        global_ids: List[str],
        pks: Iterable[int],
        slugs: Iterable[str],
    ):
        """Retrieve attributes nodes from given global IDs and/or slugs."""
        qs = qs.filter(Q(pk__in=pks) | Q(slug__in=slugs))
        nodes = list(qs)  # type: List[models.Attribute]

        if not nodes:
            raise ValidationError(
                (f"Could not resolve to a node: ids={global_ids}" f" and slugs={list(slugs)}"),
                code=ProductErrorCode.NOT_FOUND.value,
            )

        nodes_pk_list = set()
        nodes_slug_list = set()
        for node in nodes:
            nodes_pk_list.add(node.pk)
            nodes_slug_list.add(node.slug)

        for pk, global_id in zip(pks, global_ids):
            if pk not in nodes_pk_list:
                raise ValidationError(
                    f"Could not resolve {global_id!r} to Attribute",
                    code=ProductErrorCode.NOT_FOUND.value,
                )

        for slug in slugs:
            if slug not in nodes_slug_list:
                raise ValidationError(
                    f"Could not resolve slug {slug!r} to Attribute",
                    code=ProductErrorCode.NOT_FOUND.value,
                )

        return nodes

    @classmethod
    def _resolve_attribute_global_id(cls, global_id: str) -> int:
        """Resolve an Attribute global ID into an internal ID (int)."""
        graphene_type, internal_id = from_global_id(global_id)
        if graphene_type != "Attribute":
            raise ValidationError(
                f"Must receive an Attribute id, got {graphene_type}.",
                code=ProductErrorCode.INVALID.value,
            )
        if not internal_id.isnumeric():
            raise ValidationError(
                f"An invalid ID value was passed: {global_id}",
                code=ProductErrorCode.INVALID.value,
            )
        return int(internal_id)

    @classmethod
    def _pre_save_values(cls, attribute: AttributeModel, values: List[str]):
        """Lazy-retrieve or create the database objects from the supplied raw values."""
        get_or_create = attribute.values.get_or_create
        return tuple(
            get_or_create(
                attribute=attribute,
                slug=slugify(value, allow_unicode=True),
                defaults={"name": value},
            )[0]
            for value in values
            if value is not None
        )

    @classmethod
    def _validate_input(cls, cleaned_input: List[Tuple[AttributeModel, List[str]]], attributes_qs):
        errors = validate_attributes_input(cleaned_input)

        supplied_attribute_pk = [attribute.pk for attribute, _ in cleaned_input]

        # Asserts all required attributes are supplied
        missing_required_attributes = attributes_qs.filter(
            Q(value_required=True) & ~Q(pk__in=supplied_attribute_pk)
        )

        if missing_required_attributes:
            ids = [
                graphene.Node.to_global_id("Attribute", attr.pk)
                for attr in missing_required_attributes
            ]
            error = ValidationError(
                "All attributes flagged as having a value required must be supplied.",
                code=ProductErrorCode.REQUIRED.value,
                params={"attributes": ids},
            )
            errors.append(error)

        if errors:
            raise ValidationError(errors)

    @classmethod
    def clean_input_for_variant_bulk_update(
        cls, raw_input: List[AttributeValueInput], product_type: ProductTypeModel
    ) -> Tuple[
        List[Tuple[AttributeModel, List[str]]],
        List[Tuple[AttributeModel, List[str]]],
        List[str],
        List[str],
    ]:
        product_attributes_cleaned_input: List[Tuple[AttributeModel, List[str]]] = []
        variant_attributes_cleaned_input: List[Tuple[AttributeModel, List[str]]] = []
        slug_errors = []
        value_errors = []

        if raw_input:
            product_attributes_qs = product_type.product_attributes
            product_attributes: List[AttributeModel] = list(product_attributes_qs.all())
            product_attributes_slugs = [attr.slug for attr in product_attributes]
            variant_attributes_qs = product_type.variant_attributes
            variant_attributes: List[AttributeModel] = list(variant_attributes_qs.all())
            variant_attributes_slugs = [attr.slug for attr in variant_attributes]

            attributes_qs = models.Attribute.objects.prefetch_related("values")
            attributes: List[AttributeModel] = list(attributes_qs)
            attributes_slugs = [attr.slug for attr in attributes]
            attributes_values_dict = {
                attr.slug: [value.slug for value in attr.values.all()] for attr in attributes
            }
            for attribute_input in raw_input:
                attribute_slug = attribute_input.get("slug")

                if attribute_slug not in attributes_slugs:
                    slug_errors.append(attribute_slug)
                    continue

                attribute = attributes[attributes_slugs.index(attribute_slug)]
                values = attribute_input.get("values")

                is_update_attribute = False
                if attribute_slug in product_attributes_slugs:
                    product_attributes_cleaned_input.append((attribute, values))
                    is_update_attribute = True
                elif attribute_slug in variant_attributes_slugs:
                    variant_attributes_cleaned_input.append((attribute, values))
                    is_update_attribute = True

                if is_update_attribute:
                    if attribute.is_directly_assigned == False:
                        for value in values:
                            attribute_values = attributes_values_dict.get(attribute_slug)
                            if value is not None and value.lower() not in (
                                attr.lower() for attr in attribute_values
                            ):
                                value_errors.append(f"{attribute_slug}: {value}")

        return (
            product_attributes_cleaned_input,
            variant_attributes_cleaned_input,
            slug_errors,
            value_errors,
        )

    @classmethod
    def clean_input(
        cls, raw_input: List[AttributeValueInput], attributes_qs: QuerySet
    ) -> List[Tuple[AttributeModel, List[str]]]:
        """Resolve and prepare the input for further checks.

        :param raw_input: The user's attributes input.
        :param attributes_qs:
            A queryset of attributes, the attribute values must be prefetched.
            Prefetch is needed by ``_pre_save_values`` during save.
        :param is_variant: Whether the input is for a variant or a product.

        :raises ValidationError: contain the message.
        :return: The resolved data
        """

        # Mapping to associate the input values back to the resolved attribute nodes
        pks = {}
        slugs = {}

        # Temporary storage of the passed ID for error reporting
        global_ids = []

        for attribute_input in raw_input:
            global_id = attribute_input.get("id")
            slug = attribute_input.get("slug")
            values = attribute_input["values"]

            # 직접 입력 타입 value 좌우 공백은 제거해서 다루기 위해 value 가공
            values = [value.strip() if value is not None else value for value in values]

            if global_id:
                internal_id = cls._resolve_attribute_global_id(global_id)
                global_ids.append(global_id)
                pks[internal_id] = values
            elif slug:
                slugs[slug] = values
            else:
                raise ValidationError(
                    "You must whether supply an ID or a slug",
                    code=ProductErrorCode.REQUIRED.value,
                )

        attributes = cls._resolve_attribute_nodes(
            attributes_qs, global_ids=global_ids, pks=pks.keys(), slugs=slugs.keys()
        )
        cleaned_input = []
        for attribute in attributes:
            values = pks.get(attribute.pk, None)

            # Retrieve the primary key by slug if it
            # was not resolved through a global ID but a slug
            if values is None:
                values = slugs[attribute.slug]

            cleaned_input.append((attribute, values))
        cls._validate_input(cleaned_input, attributes_qs)
        return cleaned_input

    @classmethod
    def save(
        cls,
        instance: Union[ProductModel, ProductVariantModel],
        cleaned_input: List[Tuple[AttributeModel, List[str]]],
    ):
        """Save the cleaned input into the database against the given instance.

        Note: this should always be ran inside a transaction.

        :param instance: the product or variant to associate the attribute against.
        :param cleaned_input: the cleaned user input (refer to clean_attributes)
        """
        for attribute, values in cleaned_input:
            if attribute.is_directly_assigned:
                associate_directly_attribute_values_to_instance(instance, attribute, values)
            else:
                if attribute.slug == AttributeSlugEnum.BOX_SIZE.value:
                    raise ValidationError(
                        "박스 타입 값을 직접 입력할 수 없습니다.(장폭고 수정시 자동 수정)"
                    )
                else:
                    attribute_values = cls._pre_save_values(attribute, values)
                    associate_attribute_values_to_instance(instance, attribute, *attribute_values)


class ProductCreate(ModelMutation):
    class Arguments:
        input = ProductCreateInput(
            required=True, description="Fields required to create a product."
        )

    class Meta:
        description = "Creates a new product."
        model = models.Product
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def clean_attributes(
        cls, attributes: List[AttributeValueInput], product_type: ProductTypeModel
    ) -> List[Tuple[AttributeModel, List[str]]]:
        attributes_qs = product_type.product_attributes
        attributes = AttributeAssignmentMixin.clean_input(attributes, attributes_qs)
        return attributes

    @staticmethod
    def validate_stock_control_fields(cleaned_input):
        stock_adjust_factor = cleaned_input.get("stock_adjust_factor")
        if stock_adjust_factor is not None and (
            stock_adjust_factor < -1000 or stock_adjust_factor > 1000
        ):
            raise ValidationError("재발주점 더하기 보정값은 -1000 ~ 1000 사이의 값을 입력하세요.")
        return cleaned_input

    @staticmethod
    def validate_for_box_spec_and_qty_per_box(cleaned_input):
        qty_per_box = cleaned_input.get("qty_per_box")
        if qty_per_box is None or qty_per_box <= 0:
            raise ValidationError("아우터박스 입상 수량이 0 보다 커야합니다.")
        box_length = cleaned_input.get("box_length")
        if box_length is None or box_length <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")
        box_width = cleaned_input.get("box_width")
        if box_width is None or box_width <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")
        box_height = cleaned_input.get("box_height")
        if box_height is None or box_height <= 0:
            raise ValidationError("아우터박스 박스 규격 값은 0 보다 커야합니다.")

        if (
            is_valid_decimal(box_length, 5, 1) == False
            or is_valid_decimal(box_width, 5, 1) == False
            or is_valid_decimal(box_height, 5, 1) == False
        ):
            raise ValidationError(
                "아우터박스 박스 규격 값은 1 ~ 9999 사이의 값을 mm 단위로 입력하세요."
            )

        can_sale_by_inner = cleaned_input.get("can_sale_by_inner")
        if can_sale_by_inner:
            inner_qty_per_box = cleaned_input.get("inner_qty_per_box")
            if inner_qty_per_box is None or inner_qty_per_box <= 0:
                raise ValidationError("이너박스 입상 수량이 0 보다 커야합니다.")
            inner_box_length = cleaned_input.get("inner_box_length")
            if inner_box_length is None or inner_box_length <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")
            inner_box_width = cleaned_input.get("inner_box_width")
            if inner_box_width is None or inner_box_width <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")
            inner_box_height = cleaned_input.get("inner_box_height")
            if inner_box_height is None or inner_box_height <= 0:
                raise ValidationError("이너박스 박스 규격 값은 0 보다 커야합니다.")

            if (
                is_valid_decimal(inner_box_length, 5, 1) == False
                or is_valid_decimal(inner_box_width, 5, 1) == False
                or is_valid_decimal(inner_box_height, 5, 1) == False
            ):
                raise ValidationError(
                    "이너박스 박스 규격 값은 1 ~ 9999 사이의 값을 mm 단위로 입력하세요."
                )

    @classmethod
    def clean_input_for_fbv_case(
        cls, instance: ProductModel, product_type: ProductTypeModel, cleaned_input
    ):
        if product_type.has_variants:
            raise ValidationError("직거래 상품은 옵션 제품을 지원하지 않습니다.")

        # 직거래 상품은 납품 시 금액 확정 불가
        cleaned_input["is_adjust_price"] = False
        cleaned_input["allow_mixed_multiple_of_uoq"] = False
        cleaned_input["is_sub_pv"] = False
        cleaned_input["required_exp_date_mgmt"] = False
        cleaned_input["is_direct_shipping"] = False
        cleaned_input["is_exclusive"] = True
        cleaned_input["allow_auto_consignment"] = False
        cleaned_input["can_sale_by_inner"] = False
        cleaned_input["is_vendor_track_inventory"] = False

        if instance.pk:
            ProductUpdate.validate_for_box_spec_and_qty_per_box(cleaned_input, False)
        else:
            ProductCreate.validate_for_box_spec_and_qty_per_box(cleaned_input)

        return cleaned_input

    @classmethod
    def clean_input_for_normal_case(
        cls, instance: ProductModel, product_type: ProductTypeModel, cleaned_input
    ):
        # 직거래 상품이 아닌 경우 후정산 불가
        cleaned_input["is_deferred"] = False

        if product_type.has_variants:
            return cleaned_input

        if instance.pk:
            default_variant: ProductVariantModel = instance.default_variant
            can_sale_by_inner = cleaned_input.get(
                "can_sale_by_inner", default_variant.can_sale_by_inner
            )
            ProductUpdate.validate_for_box_spec_and_qty_per_box(cleaned_input, can_sale_by_inner)
        else:
            ProductCreate.validate_for_box_spec_and_qty_per_box(cleaned_input)

        if not cls == ProductCreate:
            default_variant = instance.default_variant
            ProductVariantUpdate.validate_sub_pv(default_variant, cleaned_input)

        cleaned_input = ProductCreate.validate_stock_control_fields(cleaned_input)

        stocks = cleaned_input.get("stocks")
        if stocks:
            cls.check_for_duplicates_in_stocks(stocks)

        return cleaned_input

    @classmethod
    def clean_input(cls, info, instance: ProductModel, data):
        cleaned_input = super().clean_input(info, instance, data)

        description = cleaned_input.get("description_json")
        cleaned_input["description_plaintext"] = (
            parse_draftjs_content_to_string(description) if description else ""
        )

        is_fulfilled_by_vendor = (
            instance.is_fulfilled_by_vendor
            if instance.pk
            else cleaned_input.get("is_fulfilled_by_vendor")
        )

        product_type: ProductTypeModel = (
            instance.product_type if instance.pk else cleaned_input.get("product_type")
        )
        if cls == ProductCreate:
            try:
                cleaned_input = validate_slug_and_generate_if_needed(
                    instance, "name", cleaned_input
                )
            except ValidationError as error:
                error.code = ProductErrorCode.REQUIRED.value
                raise ValidationError({"slug": error})

            category = cleaned_input.get("category")
            if not category:
                raise ValidationError(
                    "카테고리는 필수 입력 항목입니다.", code=ProductErrorCode.REQUIRED.value
                )

            if product_type.has_variants == False and not is_fulfilled_by_vendor:
                sales_status = cleaned_input.get("sales_status")
                if sales_status is not None and sales_status not in [
                    SalesStatus.PENDING,
                    SalesStatus.ON_SALE,
                ]:
                    raise ValidationError(
                        "제품 생성 시 제품 상태는 판매대기 또는 정상 상태만 허용됩니다."
                    )
                can_sale_by_inner = cleaned_input.get("can_sale_by_inner")
                if can_sale_by_inner:
                    inner_sales_status = cleaned_input.get("inner_sales_status")
                    if inner_sales_status is not None and inner_sales_status not in [
                        SalesStatus.PENDING,
                        SalesStatus.ON_SALE,
                    ]:
                        raise ValidationError(
                            "제품 생성 시 이너 박스 제품 상태는 판매대기 또는 정상 상태만 허용됩니다."
                        )

        attributes = cleaned_input.get("attributes")
        if attributes and product_type:
            try:
                cleaned_input["attributes"] = cls.clean_attributes(attributes, product_type)
            except ValidationError as exc:
                raise ValidationError({"attributes": exc})

        if is_fulfilled_by_vendor:
            cleaned_input = cls.clean_input_for_fbv_case(instance, product_type, cleaned_input)
        else:
            cleaned_input = cls.clean_input_for_normal_case(instance, product_type, cleaned_input)

        return cleaned_input

    @classmethod
    def check_for_duplicates_in_stocks(cls, stocks_data):
        warehouse_ids = [stock["warehouse"] for stock in stocks_data]
        duplicates = get_duplicated_values(warehouse_ids)
        if duplicates:
            error_msg = "Duplicated warehouse ID: {}".format(", ".join(duplicates))
            raise ValidationError(
                {"stocks": ValidationError(error_msg, code=ProductErrorCode.UNIQUE)}
            )

    @classmethod
    def get_instance(cls, info, **data):
        """Prefetch related fields that are needed to process the mutation."""
        # If we are updating an instance and want to update its attributes,
        # prefetch them.

        object_id = data.get("id")
        if object_id and data.get("attributes"):
            # Prefetches needed by AttributeAssignmentMixin and
            # associate_attribute_values_to_instance
            qs = cls.Meta.model.objects.prefetch_related(
                "product_type__product_attributes__values",
                "product_type__attributeproduct",
            )
            return cls.get_node_or_error(info, object_id, only_type="Product", qs=qs)

        return super().get_instance(info, **data)

