        PurchaseOrderLineInspect.objects.filter(
            purchase_order_line_id=OuterRef("purchase_order_line_id"),
            is_canceled=False,
        )
        .order_by("-created_at")
        .values("id")[:1]
    )

    # target purchase_order_line 안에서 최신 id 뽑기
    target_latest_ids = (
        PurchaseOrderLineInspect.objects.filter(
            purchase_order_line_id__in=po_line_ids,
            is_canceled=False,
        )
        .annotate(latest_id=Subquery(latest_inspects))
        .values_list("latest_id", flat=True)
        .distinct()
    )

    PurchaseOrderLineInspect.objects.filter(id__in=target_latest_ids).update(is_canceled=True)
