class CreateOtp(BaseMutation):
    otp = graphene.String(description="OTP, required to authenticate.")

    class Arguments:
        input = CreateOtpInput(description="Fields required to create otp.", required=True)

    class Meta:
        description = "Create OTP."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input", {})
        mode = input_data["mode"]
        receiver_phone = validate_possible_number(input_data[RECEIVER_PHONE])
        login_id = input_data.get("login_id", None)

        if mode == VerifyOtpMode.INQUIRY_ID:
            _check_validation_to_inquiry_id(receiver_phone)
        elif mode == VerifyOtpMode.INQUIRY_PASSWORD:
            _check_validation_to_inquiry_password(receiver_phone, login_id)
        elif mode != VerifyOtpMode.SIGNUP:
            raise ValidationError("휴대폰 번호 인증에 실패했습니다. 고객센터에 문의해 주세요.")

        otp = get_topt_at()

        if mode == VerifyOtpMode.INQUIRY_ID:
            message = f"포장보스 아이디 찾기 인증번호: {otp}"
        elif mode == VerifyOtpMode.INQUIRY_PASSWORD:
            message = f"포장보스 비밀번호 찾기 인증번호: {otp}"
        else:
            message = f"포장보스 회원가입 인증번호: {otp}"

        get_plugins_manager().send_sms(
            receiver_phone=format_as_numeric_only_phone_number(receiver_phone),
            message=message,
        )

        if settings.DEBUG:
            return cls(otp=message)
        return cls()


