class CheckoutLinesSelectedAndDeliveryRequestDateUpdate(BaseMutation):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        input = graphene.List(
            graphene.NonNull(CheckoutLinesSelectedAndDeliveryRequestDateUpdateInput),
            required=True,
            description="List of checkout line selection inputs",
        )

    class Meta:
        description = "checkout line 선택 및 배송요청일 업데이트"
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @staticmethod
    def validate_checkout_lines_permissions(
        line_ids: List[int], lines: List["models.CheckoutLine"], info
    ) -> "models.Checkout":
        if len(line_ids) != len(set(line_ids)):
            logger.error(
                f"checkout.CheckoutLinesSelectedAndDeliveryRequestDateUpdate: 중복된 line_ids가 존재합니다. line_ids: {line_ids}"
            )
            raise ValidationError("장바구니 설정 에러. 에러 지속 시 CS에게 문의 주세요.")

        checkout = lines[0].checkout
        if not all(line.checkout_id == checkout.token for line in lines):
            logger.error(
                f"checkout.CheckoutLinesSelectedAndDeliveryRequestDateUpdate: checkout token이 일치하지 않습니다. lines: {lines}"
            )
            raise ValidationError("장바구니 설정 에러. 에러 지속 시 CS에게 문의 주세요.")

        valid_user_ids = {info.context.user.id, info.context.brand_store_owner_user.id}
        if checkout.user_id not in valid_user_ids:
            logger.error(
                f"checkout.CheckoutLinesSelectedAndDeliveryRequestDateUpdate: checkout user_id가 유효하지 않습니다. checkout.user_id: {checkout.user_id}, valid_user_ids: {valid_user_ids}"
            )
            raise ValidationError("장바구니 설정 에러. 에러 지속 시 CS에게 문의 주세요.")

        return checkout

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        input = data.get("input")
        line_ids = []
        delivery_request_date_map = {}

        for item in input:
            for line_id in item.lines:
                db_id = graphene.Node.from_global_id(line_id)[1]
                line_ids.append(db_id)
                delivery_request_date_map[db_id] = item.delivery_request_date

        lines = list(
            models.CheckoutLine.objects.prefetch_related("checkout", "checkout__user").filter(
                id__in=line_ids
            )
        )
        if not lines:
            logger.error(
                f"checkout.CheckoutLinesSelectedAndDeliveryRequestDateUpdate: No checkout lines found for line_ids: {line_ids}"
            )
            raise ValidationError("장바구니 설정 에러. 에러 지속 시 CS에게 문의 주세요.")

        checkout = cls.validate_checkout_lines_permissions(line_ids, lines, info)

        # 먼저 모든 checkout의 is_selected False 처리
        models.CheckoutLine.objects.filter(checkout_id=checkout.token).update(is_selected=False)

        # 선택된 line만 True 처리 + 날짜 업데이트
        for line in lines:
            line.is_selected = True
            line.delivery_request_date = delivery_request_date_map.get(str(line.id))
            if line.delivery_request_date and not line.vendor_id:
                logger.error(
                    f"checkout.CheckoutLinesSelectedAndDeliveryRequestDateUpdate: delivery_request_date가 설정된 라인에 vendor_id가 없습니다. line.id: {line.id}, delivery_request_date: {line.delivery_request_date}"
                )
                raise ValidationError("장바구니 설정 에러. 에러 지속 시 CS에게 문의 주세요.")

        models.CheckoutLine.objects.bulk_update(lines, ["is_selected", "delivery_request_date"])

        return cls(checkout=checkout)
