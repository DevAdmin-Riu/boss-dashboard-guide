# Order Model의 get_delivery_count를 참조해서 작성됨.
class OrderDeliveryInfoByOrderIdLoader(DataLoader):
    context_key = "order_delivery_info_by_order_id"

    def batch_load(self, keys):
        from .types import OrderDeliveryInfo

        # Order와 관련된 Line 및 Fulfillment 객체들을 로드합니다.
        orders = Order.objects.filter(pk__in=keys).prefetch_related(
            "lines__variant__product",
            "fulfillments__lines__order_line__variant__product",
            "lines__purchase_order_line",
        )

        # Order별로 필요한 데이터 생성
        # 배송정보 숫자에서. 취소는 전액환불 + 배송대기 조합이거나 order status가 CANCEL 경우 이므로 프론트에서 처리.
        # 전체 수는 Order의 get_total_quantity, 반품은 quantity_refunded,
        # 배송중은 취소, 환불이 안된것, 송장번호 미입력 중에서, 배송완료가 안된 것
        # 배송완료는 취소, 환불이 안된 것 중에서 is_tracking_completed가 True인것.
        # 미배송은 전체 숫자에서 위의 숫자들 제외한 숫자.

        # 직배송인 경우 1만 더하고, 직배송이 아닌 경우 line의 quantity를 더한 값이 quantity_total이다.
        # 직배송의경우 orderline당 fulfillment가 1개만 생성된다는 점 감안함.
        # 환불의 경우 직배송중에 환불한 quantity가 존재하는 경우 +1만 한다, 이외의 경우 quantity_refunded를 더함.
        order_map = {}

        for order in orders:
            quantity_total = 0
            quantity_refunded = 0
            fbv_quantity_total = 0
            fbv_quantity_refunded = 0
            order_lines: List[OrderLine] = order.lines.all()
            for line in order_lines:
                if line.is_fulfilled_by_vendor:
                    fbv_quantity_total += line.quantity
                    fbv_quantity_refunded += line.quantity_refunded

                if not line.variant.product.is_direct_shipping:
                    quantity_total += get_ordered_or_fulfill_qty(line, order)
                    quantity_refunded += line.quantity_refunded
                else:
                    quantity_total += 1
                    if line.quantity_refunded > 0:
                        quantity_refunded += 1

            excluded_fulfillments = [
                f
                for f in order.fulfillments.all()
                if f.status not in [FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
            ]

            quantity_tracking = sum(
                (1 if line.order_line.variant.product.is_direct_shipping else line.quantity)
                for fulfillment in excluded_fulfillments
                if fulfillment.tracking_number and not fulfillment.is_tracking_completed
                for line in fulfillment.lines.all()
            )

            quantity_tracking_completed = sum(
                (1 if line.order_line.variant.product.is_direct_shipping else line.quantity)
                for fulfillment in excluded_fulfillments
                if fulfillment.is_tracking_completed
                for line in fulfillment.lines.all()
            )

            quantity_before_delivery = (
                quantity_total - quantity_refunded - quantity_tracking - quantity_tracking_completed
            )

            fbv_quantity_tracking = sum(
                line.quantity
                for fulfillment in excluded_fulfillments
                if fulfillment.is_fulfilled_by_vendor
                and fulfillment.tracking_number
                and not fulfillment.is_tracking_completed
                for line in fulfillment.lines.all()
            )

            fbv_quantity_tracking_completed = sum(
                line.quantity
                for fulfillment in excluded_fulfillments
                if fulfillment.is_fulfilled_by_vendor and fulfillment.is_tracking_completed
                for line in fulfillment.lines.all()
            )

            fbv_quantity_before_delivery = (
                fbv_quantity_total
                - fbv_quantity_refunded
                - fbv_quantity_tracking
                - fbv_quantity_tracking_completed
            )

            order_map[order.pk] = OrderDeliveryInfo(
                quantity_total=quantity_total,
                quantity_before_delivery=quantity_before_delivery,
                quantity_tracking=quantity_tracking,
                quantity_tracking_completed=quantity_tracking_completed,
                quantity_refunded=quantity_refunded,
                fbv_quantity_total=fbv_quantity_total,
                fbv_quantity_before_delivery=fbv_quantity_before_delivery,
                fbv_quantity_tracking=fbv_quantity_tracking,
                fbv_quantity_tracking_completed=fbv_quantity_tracking_completed,
                fbv_quantity_refunded=fbv_quantity_refunded,
            )

        return [order_map.get(order_id) for order_id in keys]


