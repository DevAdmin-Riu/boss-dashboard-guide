from enum import Enum
from functools import wraps
from typing import Iterable, Union

from graphql.execution.base import ResolveInfo

from ..core.exceptions import PermissionDenied
from ..plugins.manager import PluginsManager
from ..plugins.site_settings.define import SITE_SETTINGS_PLUGIN_ID


def context(f):
    def decorator(func):
        def wrapper(*args, **kwargs):
            info = next(arg for arg in args if isinstance(arg, ResolveInfo))
            return func(info.context, *args, **kwargs)

        return wrapper

    return decorator


def account_passes_test(test_func):
    """Determine if user/app has permission to access to content."""

    def decorator(f):
        @wraps(f)
        @context(f)
        def wrapper(context, *args, **kwargs):
            if test_func(context):
                return f(*args, **kwargs)
            raise PermissionDenied(user=context.user, fn=account_passes_test)

        return wrapper

    return decorator


def _permission_required(perms: Iterable[Enum], context):
    if context.user.has_perms(perms):
        return True
    return False


def permission_required(perm: Union[Enum, Iterable[Enum]]):
    def check_perms(context):
        if isinstance(perm, Enum):
            perms = (perm,)
        else:
            perms = perm
        return _permission_required(perms, context)

    return account_passes_test(check_perms)


def one_of_permissions_required(perms: Iterable[Enum]):
    def check_perms(context):
        for perm in perms:
            has_perm = _permission_required((perm,), context)
            if has_perm:
                return True
        return False

    return account_passes_test(check_perms)


# 기존에 있던 one_of_permissions_required_or_hq_staff 제거 됨.
# 향후 vendor_staff 한테도 생성이나 수정시 권한 부여하고 해당 권한 이용하는것으로 바꾸는게 좋을듯.
def one_of_permissions_required_or_vendor_staff(permissions):
    def check_perms(context):
        if not context.user.is_anonymous and context.user.is_vendor_staff:
            return True
        for perm in permissions:
            has_perm = _permission_required((perm,), context)
            if has_perm:
                return True

        return False

    return account_passes_test(check_perms)


staff_member_required = account_passes_test(
    lambda context: context.user.is_active and context.user.is_staff
)

vendor_staff_member_required = account_passes_test(
    lambda context: context.user.is_active and context.user.is_vendor_staff
)


def push_notification_required(f):
    @wraps(f)
    @context(f)
    def wrapper(context, *args, **kwargs):
        plugins_manager: PluginsManager = getattr(context, "plugins_manager", None)
        plugin_configs = plugins_manager.get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
        if not plugin_configs.get("push_notification_enable", False):
            return

        return f(*args, **kwargs)

    return wrapper
