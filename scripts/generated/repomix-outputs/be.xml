    @classmethod
    def make_detail_code(cls, detail):
        sku = detail.get("product_sku")
        if not sku:
            sku = detail.get("bp_sku")
        region_name = detail.get("region_name")
        return f"({sku}:{region_name})"

    @classmethod
    def validate_value_empty(cls, details, brand: BrandModel):
        is_create = cls == BrandProductVariantBulkCreate
        is_b2b_contract_type_brand = brand.contract_type == BrandContractType.B2B

        price_errors = []
        price_vat_errors = []
        cost_price_errors = []
        delivery_fee_errors = []
        for detail in details:
            price = detail.get("price")
            price_vat = detail.get("price_vat")
            cost_price_exclude_vat = detail.get("cost_price_exclude_vat")
            delivery_fee = detail.get("delivery_fee")
            detail_code = cls.make_detail_code(detail)

            if is_create:
                if price is None or price < 0:
                    price_errors.append(detail_code)
                if price_vat is None or price_vat < 0:
                    price_vat_errors.append(detail_code)
                if is_b2b_contract_type_brand:
                    detail["cost_price_exclude_vat"] = 0
                    detail["delivery_fee"] = 0
                else:
                    if cost_price_exclude_vat is None or cost_price_exclude_vat < 0:
                        cost_price_errors.append(detail_code)
                    if delivery_fee is None or delivery_fee < 0:
                        delivery_fee_errors.append(detail_code)
            else:
                if price is not None and price < 0:
                    price_errors.append(detail_code)
                if price_vat is not None and price_vat < 0:
                    price_vat_errors.append(detail_code)
                if is_b2b_contract_type_brand:
                    detail["cost_price_exclude_vat"] = 0
                    detail["delivery_fee"] = 0
                else:
                    if cost_price_exclude_vat is not None and cost_price_exclude_vat < 0:
                        cost_price_errors.append(detail_code)
                    if delivery_fee is not None and delivery_fee < 0:
                        delivery_fee_errors.append(detail_code)

        if len(price_errors) > 0:
            error_msg = "매장 판매가 오류 제품코드: {}".format(", ".join(price_errors))
            raise ValidationError(error_msg)
        if len(price_vat_errors) > 0:
            error_msg = "매장 판매가 부가세 오류 제품코드: {}".format(", ".join(price_vat_errors))
            raise ValidationError(error_msg)
        if len(cost_price_errors) > 0:
            error_msg = "브랜드 매입가 오류 제품코드: {}".format(", ".join(cost_price_errors))
            raise ValidationError(error_msg)
        if len(delivery_fee_errors) > 0:
            error_msg = "브랜드 배송비 오류 제품코드: {}".format(", ".join(delivery_fee_errors))
            raise ValidationError(error_msg)

        return details

    @classmethod
    def validate_sku(cls, details, is_update_mode):
        skus = set()
        brand_product_names_by_sku = {}
        is_exclusives_by_sku = {}
        is_only_payable_by_cash_by_sku = {}
        is_rcoin_reward_for_using_point_by_sku = {}
        for detail in details:
            sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
            brand_product_name = normalize_newlines_to_space(detail.get("brand_product_name"))
            is_exclusive = detail.get("is_exclusive")
            is_only_payable_by_cash = detail.get("is_only_payable_by_cash")
            is_rcoin_reward_for_using_point = detail.get("is_rcoin_reward_for_using_point")
            if brand_product_name is not None:
                brand_product_names_by_sku[sku] = brand_product_name.strip()
            if is_exclusive is not None:
                is_exclusives_by_sku[sku] = is_exclusive
            if is_only_payable_by_cash is not None:
                is_only_payable_by_cash_by_sku[sku] = is_only_payable_by_cash
            if is_rcoin_reward_for_using_point is not None:
                is_rcoin_reward_for_using_point_by_sku[sku] = is_rcoin_reward_for_using_point
            skus.add(sku)

        pv_errors = []
        bpv_errors = []
        do_not_sale_inner_errors = []
        sorted_skus = sorted(skus)
        pv_map = {}
        product_map: Dict[int, ProductModel] = {}
        brand_product_names_by_product_id = {}
        is_exclusives_by_product_id = {}
        is_only_payable_by_cash_by_product_id = {}
        is_rcoin_reward_for_using_point_by_product_id = {}
        brand_product_name_mixed_errors = []
        is_exclusive_mixed_errors = []
        is_exclusive_false_errors = []
        is_only_payable_by_cash_mixed_errors = []
        is_rcoin_reward_for_using_point_mixed_errors = []
        for sku in sorted_skus:
            try:
                if is_update_mode:
                    bpv: BrandProductVariantModel = (
                        models.BrandProductVariant.objects.select_related(
                            "product_variant", "product_variant__product"
                        ).get(bp_sku=sku)
                    )
                    variant: ProductVariantModel = bpv.product_variant
                else:
                    variant: ProductVariantModel = models.ProductVariant.objects.select_related(
                        "product"
                    ).get(sku=sku)
                if variant.outer_id and variant.can_sale_by_inner == False:
                    do_not_sale_inner_errors.append(sku)
                    continue
                pv_map[sku] = variant
                product = variant.product
                product_map[product.id] = product
                if sku in brand_product_names_by_sku:
                    if product.id in brand_product_names_by_product_id:
                        if (
                            brand_product_names_by_product_id[product.id]
                            != brand_product_names_by_sku[sku]
                        ):
                            brand_product_name_mixed_errors.append(sku)
                    else:
                        brand_product_names_by_product_id[product.id] = brand_product_names_by_sku[
                            sku
                        ]
                if sku in is_exclusives_by_sku:
                    if product.id in is_exclusives_by_product_id:
                        if is_exclusives_by_product_id[product.id] != is_exclusives_by_sku[sku]:
                            is_exclusive_mixed_errors.append(sku)
                    else:
                        is_exclusives_by_product_id[product.id] = is_exclusives_by_sku[sku]
                        if product.is_exclusive and is_exclusives_by_sku[sku] == False:
                            is_exclusive_false_errors.append(sku)

                if sku in is_only_payable_by_cash_by_sku:
                    if product.id in is_only_payable_by_cash_by_product_id:
                        if (
                            is_only_payable_by_cash_by_product_id[product.id]
                            != is_only_payable_by_cash_by_sku[sku]
                        ):
                            is_only_payable_by_cash_mixed_errors.append(sku)
                    else:
                        is_only_payable_by_cash_by_product_id[product.id] = (
                            is_only_payable_by_cash_by_sku[sku]
                        )

                if sku in is_rcoin_reward_for_using_point_by_sku:
                    if product.id in is_rcoin_reward_for_using_point_by_product_id:
                        if (
                            is_rcoin_reward_for_using_point_by_product_id[product.id]
                            != is_rcoin_reward_for_using_point_by_sku[sku]
                        ):
                            is_rcoin_reward_for_using_point_mixed_errors.append(sku)
                    else:
                        is_rcoin_reward_for_using_point_by_product_id[product.id] = (
                            is_rcoin_reward_for_using_point_by_sku[sku]
                        )
            except ObjectDoesNotExist:
                if is_update_mode:
                    bpv_errors.append(sku)
                else:
                    pv_errors.append(sku)
                continue

        if len(pv_errors) > 0:
            error_msg = "제품코드 오류: {}".format(", ".join(pv_errors))
            raise ValidationError(error_msg)

        if len(bpv_errors) > 0:
            error_msg = "상품코드 오류: {}".format(", ".join(bpv_errors))
            raise ValidationError(error_msg)

        if len(do_not_sale_inner_errors) > 0:
            error_msg = "판매하지 않는 이너 박스 제품 등록 오류: {}".format(
                ", ".join(do_not_sale_inner_errors)
            )
            raise ValidationError(error_msg)

        if len(brand_product_name_mixed_errors) > 0:
            error_msg = "서로 다른 상품명으로 변경 요청 오류: {}".format(
                ", ".join(brand_product_name_mixed_errors)
            )
            raise ValidationError(error_msg)

        if len(is_exclusive_mixed_errors) > 0:
            error_msg = "서로 다른 전용상품 여부로 변경 요청 오류: {}".format(
                ", ".join(is_exclusive_mixed_errors)
            )
            raise ValidationError(error_msg)

        if len(is_exclusive_false_errors) > 0:
            error_msg = "전용 제품에 전용 아님 상품으로 변경 요청 오류: {}".format(
                ", ".join(is_exclusive_false_errors)
            )
            raise ValidationError(error_msg)

        if len(is_only_payable_by_cash_mixed_errors) > 0:
            error_msg = "서로 다른 현금전용 여부로 변경 요청 오류: {}".format(
                ", ".join(is_only_payable_by_cash_mixed_errors)
            )
            raise ValidationError(error_msg)

        if len(is_rcoin_reward_for_using_point_mixed_errors) > 0:
            error_msg = "서로 다른 충전금 사용시 포인트 적립 여부로 변경 요청 오류: {}".format(
                ", ".join(is_rcoin_reward_for_using_point_mixed_errors)
            )
            raise ValidationError(error_msg)

        return (
            set(product_map.values()),
            pv_map,
            brand_product_names_by_product_id,
            is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id,
        )

    @classmethod
    def validate_fulfilled_by_vendor(
        cls,
        is_update_mode,
        brand: BrandModel,
        is_fulfilled_by_vendor: bool,
        product_variants: Dict[str, ProductVariantModel],
        details,
    ):
        if is_fulfilled_by_vendor:
            if BrandServiceType.FBV not in brand.enabled_services:
                raise ValidationError(
                    "직거래 상품 취급 안하는 브랜드로 직거래 상품 추가할 수 없습니다."
                )

            errors = []
            for detail in details:
                sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
                product_variant = product_variants[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor == False:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

            if errors:
                error_msg = (
                    "직거래 상품 일괄 추가에서 보스 제품 추가 시도 오류 제품코드: {}".format(
                        ", ".join(errors)
                    )
                )
                raise ValidationError(error_msg)
        else:
            errors = []
            for detail in details:
                sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
                product_variant = product_variants[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

            if errors:
                error_msg = (
                    "보스 상품 일괄 추가에서 직거래 상품 추가 시도 오류 제품코드: {}".format(
                        ", ".join(errors)
                    )
                )
                raise ValidationError(error_msg)

    @classmethod
    def clean_details(
        cls, info, input_data, brand: BrandModel, is_fulfilled_by_vendor: bool, is_update_mode: bool
    ):
        region_info = RegionInfo.objects.all()
        details = []
        details_input = input_data.get("details")
        for detail in details_input:
            region_code_input = detail.get("region_code")
            region_code_array = [code.strip() for code in region_code_input.split(",")]
            for region_code in region_code_array:
                region = region_info.filter(code=region_code).first()
                product_sku = detail.get("product_sku") if is_update_mode == False else None
                bp_sku = detail.get("bp_sku") if is_update_mode else None
                brand_product_name = normalize_newlines_to_space(detail.get("brand_product_name"))
                is_exclusive = detail.get("is_exclusive")
                price = detail.get("price")
                price_vat = detail.get("price_vat")
                cost_price_exclude_vat = detail.get("cost_price_exclude_vat")
                delivery_fee = detail.get("delivery_fee")
                is_only_payable_by_cash = detail.get("is_only_payable_by_cash")
                is_rcoin_reward_for_using_point = detail.get("is_rcoin_reward_for_using_point")
                need_delivery_additional_fee = detail.get("need_delivery_additional_fee")
                include_sales_b2b_delivery_fee = detail.get("include_sales_b2b_delivery_fee", False)
                sales_status = detail.get("sales_status")
                stopped_at = detail.get("stopped_at")
                stopped_reason = detail.get("stopped_reason")
                stopped_reason_etc = detail.get("stopped_reason_etc")
                force_no_normal_display = detail.get("force_no_normal_display")

                detail_line = {
                    "product_sku": product_sku,
                    "bp_sku": bp_sku,
                    "brand_product_name": brand_product_name,
                    "is_exclusive": is_exclusive,
                    "region": region.id if region else None,
                    "region_name": region.name if region else None,
                    "region_code": region_code,
                    "price": price,
                    "price_vat": price_vat,
                    "cost_price_exclude_vat": cost_price_exclude_vat,
                    "delivery_fee": delivery_fee,
                    "is_only_payable_by_cash": is_only_payable_by_cash,
                    "is_rcoin_reward_for_using_point": is_rcoin_reward_for_using_point,
                    "need_delivery_additional_fee": need_delivery_additional_fee,
                    "include_sales_b2b_delivery_fee": include_sales_b2b_delivery_fee,
                    "sales_status": sales_status,
                    "stopped_at": stopped_at,
                    "stopped_reason": stopped_reason,
                    "stopped_reason_etc": stopped_reason_etc,
                    "force_no_normal_display": force_no_normal_display,
                }

                details.append(detail_line)

        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        validate_region(details)
        (
            product_set,
            product_variants,
            brand_product_names_by_product_id,
            is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id,
        ) = cls.validate_sku(details, is_update_mode)
        details = cls.validate_value_empty(details, brand)
        cls.validate_direct_shipping_vendor(is_update_mode, brand, product_variants, details)
        cls.validate_is_adjust_price(is_update_mode, brand, product_variants, details)

        if is_update_mode:
            cls.validate_brand_product_variant_exist(brand, product_variants, details)
        else:
            cls.validate_fulfilled_by_vendor(
                is_update_mode, brand, is_fulfilled_by_vendor, product_variants, details
            )

        return (
            details,
            product_set,
            product_variants,
            brand_product_names_by_product_id,
            is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id,
        )

    @classmethod
    def add_brand_products(
        cls,
        brand,
        product_set: Set[ProductModel],
        brand_product_names_by_product_id,
        is_exclusives_by_product_id,
        is_only_payable_by_cash_by_product_id,
        is_rcoin_reward_for_using_point_by_product_id,
    ):
        create_list = []

        # BrandProduct에서 기존의 brand를 가진 BrandProduct가 있는지 확인한다.
        max_sort_order = SortableModel.get_max_sort_order(
            models.BrandProduct.objects.filter(brand=brand)
        )
        max_sort_order = max_sort_order + 1 if max_sort_order is not None else 1

        for product in product_set:
            try:
                models.BrandProduct.objects.get(brand=brand, product=product)
            except:
                brand_product: BrandProductModel = models.BrandProduct(
                    brand=brand, product=product, name=product.name
                )
                brand_product.sort_order = max_sort_order
                max_sort_order += 1
                if product.id in brand_product_names_by_product_id:
                    brand_product.name = brand_product_names_by_product_id[product.id]
                if product.is_exclusive:
                    brand_product.is_exclusive = True
                else:
                    if product.id in is_exclusives_by_product_id:
                        brand_product.is_exclusive = is_exclusives_by_product_id[product.id]

                if product.id in is_only_payable_by_cash_by_product_id:
                    brand_product.is_only_payable_by_cash = is_only_payable_by_cash_by_product_id[
                        product.id
                    ]
                if product.id in is_rcoin_reward_for_using_point_by_product_id:
                    brand_product.is_rcoin_reward_for_using_point = (
                        is_rcoin_reward_for_using_point_by_product_id[product.id]
                    )

                create_list.append(brand_product)

        return models.BrandProduct.objects.bulk_create(create_list) if len(create_list) > 0 else []

    @classmethod
    def add_brand_product_variants(cls, brand, pv_map, created_brand_products, details):
        create_list = []
        for detail in details:
            # 상품 추가는 제품코드로 진행
            sku = detail.get("product_sku")
            price = detail.get("price")
            price_vat = detail.get("price_vat")
            delivery_fee = detail.get("delivery_fee")
            cost_price_exclude_vat = detail.get("cost_price_exclude_vat")
            need_delivery_additional_fee = detail.get("need_delivery_additional_fee")
            include_sales_b2b_delivery_fee = detail.get("include_sales_b2b_delivery_fee", False)
            sales_status = detail.get("sales_status")
            stopped_at = detail.get("stopped_at")
            stopped_reason = detail.get("stopped_reason")
            stopped_reason_etc = detail.get("stopped_reason_etc")
            force_no_normal_display = detail.get("force_no_normal_display")
            product_variant = pv_map[sku]

            brand_product_variant = next(
                (
                    x
                    for x in create_list
                    if x.brand == brand and x.product_variant == product_variant
                ),
                None,
            )
            if brand_product_variant:
                # 이미 생성 리스트에 포함됨
                continue

            try:
                models.BrandProductVariant.objects.get(brand=brand, product_variant=product_variant)
            except:
                product = product_variant.product
                brand_product = models.BrandProduct.objects.get(brand=brand, product=product)
                if brand_product is None:
                    brand_product = next(
                        (
                            x
                            for x in created_brand_products
                            if x.brand == brand and x.product == product
                        ),
                        None,
                    )

                if brand_product is None:
                    error_msg = f"brand_product 를 찾을 수 없음, {detail}"
                    raise ValidationError(error_msg)

                bpv_obj: BrandProductVariantModel = models.BrandProductVariant(
                    brand=brand,
                    brand_product=brand_product,
                    product_variant=product_variant,
                    price_amount=price,
                    price_vat=price_vat,
                    cost_price_exclude_vat=cost_price_exclude_vat,
                    delivery_fee_amount=delivery_fee,
                    need_delivery_additional_fee=need_delivery_additional_fee,
                    include_sales_b2b_delivery_fee=include_sales_b2b_delivery_fee,
                    sales_status=sales_status,
                    stopped_at=stopped_at,
                    stopped_reason=stopped_reason,
                    stopped_reason_etc=stopped_reason_etc,
                    force_no_normal_display=force_no_normal_display,
                )
                bpv_obj.generate_bp_sku()
                create_list.append(bpv_obj)
        return (
            models.BrandProductVariant.objects.bulk_create(create_list)
            if len(create_list) > 0
            else []
        )

    @classmethod
    def add_brand_product_variant_regions(
        cls, brand, pv_map, created_brand_product_variants, details
    ):
        create_list = []
        for detail in details:
            # 상품 추가는 제품코드로 진행
            sku = detail.get("product_sku")
            region_id = detail.get("region")
            price = detail.get("price")
            price_vat = detail.get("price_vat")
            delivery_fee = detail.get("delivery_fee")
            cost_price_exclude_vat = detail.get("cost_price_exclude_vat")
            sales_status = detail.get("sales_status")
            stopped_at = detail.get("stopped_at")
            stopped_reason = detail.get("stopped_reason")
            stopped_reason_etc = detail.get("stopped_reason_etc")
            force_no_normal_display = detail.get("force_no_normal_display")

            product_variant: ProductVariantModel = pv_map[sku]
            product: ProductModel = product_variant.product
            if product.is_direct_shipping == False:
                continue

            brand_product_variant = models.BrandProductVariant.objects.get(
                brand=brand, product_variant=product_variant
            )
            if brand_product_variant is None:
                brand_product_variant = next(
                    (
                        x
                        for x in created_brand_product_variants
                        if x.brand == brand and x.product_variant == product_variant
                    ),
                    None,
                )

            if brand_product_variant is None:
                error_msg = f"brand_product_variant 를 찾을 수 없음, {detail}"
                raise ValidationError(error_msg)

            brand_product_variant_region = next(
                (
                    x
                    for x in create_list
                    if x.region_id == region_id and x.brand_product_variant == brand_product_variant
                ),
                None,
            )
            if brand_product_variant_region:
                # 이미 생성 리스트에 포함됨
                continue

            try:
                models.BrandProductVariantRegion.objects.get(
                    region_id=region_id, brand_product_variant=brand_product_variant
                )
            except:
                create_list.append(
                    models.BrandProductVariantRegion(
                        region_id=region_id,
                        brand_product_variant=brand_product_variant,
                        price_amount=price,
                        price_vat=price_vat,
                        cost_price_exclude_vat=cost_price_exclude_vat,
                        delivery_fee_amount=delivery_fee,
                        sales_status=sales_status,
                        stopped_at=stopped_at,
                        stopped_reason=stopped_reason,
                        stopped_reason_etc=stopped_reason_etc,
                        force_no_normal_display=force_no_normal_display,
                    )
                )
        return (
            models.BrandProductVariantRegion.objects.bulk_create(create_list)
            if len(create_list) > 0
            else []
        )

    @classmethod
    def validate_direct_shipping_vendor(
        cls,
        is_update_mode,
        brand: BrandModel,
        product_variants: Dict[str, ProductVariantModel],
        details,
    ):
        errors = []
        direct_shipping_vendor = brand.direct_shipping_vendor
        for detail in details:
            sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
            product_variant = product_variants[sku]
            product = product_variant.product
            if product.is_direct_shipping == True:
                invalid_list = models.ProductVariantVendor.objects.filter(
                    product_variant=product_variant,
                ).exclude(vendor=direct_shipping_vendor)
                if invalid_list.exists():
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

        if len(errors) > 0:
            error_msg = (
                "브랜드의 직배송 협력사와 다르게 직배송 협력사가 설정된 오류 제품코드: {}".format(
                    ", ".join(errors)
                )
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_is_adjust_price(
        cls,
        is_update_mode,
        brand: BrandModel,
        product_variants: Dict[str, ProductVariantModel],
        details,
    ):
        errors = []
        for detail in details:
            sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
            product_variant = product_variants[sku]
            if product_variant.is_adjust_price:
                if brand.contract_type == BrandContractType.B2B:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

        if len(errors) > 0:
            error_msg = "B2B 브랜드에 납품 시 납품금액 확정 제품 등록 불가 제품코드: {}".format(
                ", ".join(errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_brand_product_variant_exist(
        cls, brand, product_variants: Dict[str, ProductVariantModel], details
    ):
        for detail in details:
            sku = detail.get("bp_sku")
            region_id = detail.get("region")
            product_variant = product_variants[sku]
            product = product_variant.product
            try:
                models.BrandProduct.objects.get(brand=brand, product=product)
            except:
                error_msg = f"업데이트를 위해서는 이미 등록된 상품이어야 합니다. brand_product 를 찾을 수 없음, {detail}"
                raise ValidationError(error_msg)

            try:
                brand_product_variant = models.BrandProductVariant.objects.get(
                    brand=brand, product_variant=product_variant
                )
            except:
                error_msg = f"업데이트를 위해서는 이미 등록된 상품이어야 합니다. brand_product_variant 를 찾을 수 없음, {detail}"
                raise ValidationError(error_msg)

            if product.is_direct_shipping:
                try:
                    models.BrandProductVariantRegion.objects.get(
                        region_id=region_id, brand_product_variant=brand_product_variant
                    )
                except:
                    error_msg = f"업데이트를 위해서는 이미 등록된 상품이어야 합니다. brand_product_variant_region 를 찾을 수 없음, {detail}"
                    raise ValidationError(error_msg)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        brand = cls.get_node_or_error(info, input_data["brand"], only_type=Brand)
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor")
        (
            details,
            product_set,
            pv_map,
            brand_product_names_by_product_id,
            is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id,
        ) = cls.clean_details(
            info=info,
            input_data=input_data,
            brand=brand,
            is_fulfilled_by_vendor=is_fulfilled_by_vendor,
            is_update_mode=False,
        )

        created_brand_products = cls.add_brand_products(
            brand=brand,
            product_set=product_set,
            brand_product_names_by_product_id=brand_product_names_by_product_id,
            is_exclusives_by_product_id=is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id=is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id=is_rcoin_reward_for_using_point_by_product_id,
        )
        created_brand_product_variants = cls.add_brand_product_variants(
            brand=brand,
            pv_map=pv_map,
            created_brand_products=created_brand_products,
            details=details,
        )
        created_brand_product_variant_regions = cls.add_brand_product_variant_regions(
            brand=brand,
            pv_map=pv_map,
            created_brand_product_variants=created_brand_product_variants,
            details=details,
        )

        return BrandProductVariantBulkCreate(
            brand_products=created_brand_products,
            brand_product_variants=created_brand_product_variants,
            brand_product_variant_regions=created_brand_product_variant_regions,
        )


class BrandProductVariantBulkUpdate(BrandProductVariantBulkCreate):
    class Arguments:
        input = BrandProductVariantBulkUpdateInput(
            required=True, description="권역별 브랜드 상품 가격 및 노출 여부 리스트"
        )

    class Meta:
        description = "권역별 브랜드 상품 가격 및 노출 여부 bulk update"
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        bp_sku = detail.get("bp_sku")
        region_name = detail.get("region_name")
        return f"({bp_sku}:{region_name})"

    @classmethod
    def update_brand_products(
        cls,
        brand,
        product_set: Set[ProductModel],
        brand_product_names_by_product_id,
        is_exclusives_by_product_id,
        is_only_payable_by_cash_by_product_id,
        is_rcoin_reward_for_using_point_by_product_id,
    ):
        update_list = []
        for product in product_set:
            try:
                brand_product: BrandProductModel = models.BrandProduct.objects.get(
                    brand=brand, product=product
                )
                need_to_update = False

                if product.id in is_only_payable_by_cash_by_product_id:
                    brand_product.is_only_payable_by_cash = is_only_payable_by_cash_by_product_id[
                        product.id
                    ]
                    need_to_update = True
                if product.id in is_rcoin_reward_for_using_point_by_product_id:
                    brand_product.is_rcoin_reward_for_using_point = (
                        is_rcoin_reward_for_using_point_by_product_id[product.id]
                    )
                    need_to_update = True
                if product.id in brand_product_names_by_product_id:
                    brand_product.name = brand_product_names_by_product_id[product.id]
                    need_to_update = True
                if product.is_exclusive:
                    brand_product.is_exclusive = True
                    need_to_update = True
                else:
                    if product.id in is_exclusives_by_product_id:
                        brand_product.is_exclusive = is_exclusives_by_product_id[product.id]
                        need_to_update = True
                if need_to_update:
                    update_list.append(brand_product)
            except:
                raise ValidationError(
                    "브랜드 상품 정보를 찾을 수 없습니다. Product ID:{product.id}"
                )

        if update_list:
            models.BrandProduct.objects.bulk_update(
                update_list,
                [
                    "name",
                    "is_exclusive",
                    "is_only_payable_by_cash",
                    "is_rcoin_reward_for_using_point",
                ],
            )

    @classmethod
    def update_brand_product_variants(cls, is_update_mode, brand, product_variants, details):
        brand_product_variant_update_list = []
        brand_product_variant_region_update_list = []
        brand_product_packages = []
        brand_product_package_ids = set()
        for detail in details:
            sku = detail.get("bp_sku") if is_update_mode else detail.get("product_sku")
            region_id = detail.get("region")
            price = detail.get("price")
            price_vat = detail.get("price_vat")
            delivery_fee = detail.get("delivery_fee")
            cost_price_exclude_vat = detail.get("cost_price_exclude_vat")
            need_delivery_additional_fee = detail.get("need_delivery_additional_fee")
            include_sales_b2b_delivery_fee = detail.get("include_sales_b2b_delivery_fee", False)
            sales_status = detail.get("sales_status")
            stopped_at = detail.get("stopped_at")
            stopped_reason = detail.get("stopped_reason")
            stopped_reason_etc = detail.get("stopped_reason_etc")
            force_no_normal_display = detail.get("force_no_normal_display")
            detail_code = cls.make_detail_code(detail)

            product_variant: ProductVariantModel = product_variants[sku]
            product: ProductModel = product_variant.product
            try:
                brand_product_variant: BrandProductVariantModel = (
                    models.BrandProductVariant.objects.get(
                        brand=brand, product_variant=product_variant
                    )
                )

                if price is not None:
                    brand_product_variant.price_amount = price
                if price_vat is not None:
                    brand_product_variant.price_vat = price_vat
                if cost_price_exclude_vat is not None:
                    brand_product_variant.cost_price_exclude_vat = cost_price_exclude_vat
                if delivery_fee is not None:
                    brand_product_variant.delivery_fee_amount = delivery_fee
                if need_delivery_additional_fee is not None:
                    brand_product_variant.need_delivery_additional_fee = (
                        need_delivery_additional_fee
                    )
                if include_sales_b2b_delivery_fee is not None:
                    brand_product_variant.include_sales_b2b_delivery_fee = (
                        include_sales_b2b_delivery_fee
                    )
                if sales_status is not None:
                    brand_product_variant.sales_status = sales_status
                if stopped_at is not None:
                    brand_product_variant.stopped_at = stopped_at
                if stopped_reason is not None:
                    brand_product_variant.stopped_reason = stopped_reason
                if stopped_reason_etc is not None:
                    brand_product_variant.stopped_reason_etc = stopped_reason_etc
                if force_no_normal_display is not None:
                    brand_product_variant.force_no_normal_display = force_no_normal_display
                brand_product_variant_update_list.append(brand_product_variant)
                # brand_product_variant가 속한 brand_product_package의 모든 값을 가져와서 중복되지 않는 brand_product_package만 추가
                for brand_product_package in brand_product_variant.brand_product_packages.all():
                    if brand_product_package.id not in brand_product_package_ids:
                        brand_product_package_ids.add(brand_product_package.id)
                        brand_product_packages.append(brand_product_package)

            except:
                raise ValidationError(f"브랜드 옵션 상품 정보를 찾을 수 없습니다. {detail_code}")

            if product.is_direct_shipping:
                try:
                    brand_product_variant_region: BrandProductVariantRegionModel = (
                        models.BrandProductVariantRegion.objects.get(
                            region_id=region_id, brand_product_variant=brand_product_variant
                        )
                    )
                    if price is not None:
                        brand_product_variant_region.price_amount = price
                    if price_vat is not None:
                        brand_product_variant_region.price_vat = price_vat
                    if cost_price_exclude_vat is not None:
                        brand_product_variant_region.cost_price_exclude_vat = cost_price_exclude_vat
                    if delivery_fee is not None:
                        brand_product_variant_region.delivery_fee_amount = delivery_fee
                    brand_product_variant_region_update_list.append(brand_product_variant_region)
                except:
                    raise ValidationError(
                        f"브랜드 옵션 리전 상품 정보를 찾을 수 없습니다. {detail_code}"
                    )

        updated_brand_product_variants = (
            models.BrandProductVariant.objects.bulk_update(
                brand_product_variant_update_list,
                [
                    "price_amount",
                    "price_vat",
                    "cost_price_exclude_vat",
                    "delivery_fee_amount",
                    "need_delivery_additional_fee",
                    "include_sales_b2b_delivery_fee",
                    "sales_status",
                    "stopped_at",
                    "stopped_reason",
                    "stopped_reason_etc",
                    "force_no_normal_display",
                ],
            )
            if len(brand_product_variant_update_list) > 0
            else []
        )
        updated_brand_product_variant_regions = (
            models.BrandProductVariantRegion.objects.bulk_update(
                brand_product_variant_region_update_list,
                [
                    "price_amount",
                    "price_vat",
                    "cost_price_exclude_vat",
                    "delivery_fee_amount",
                    "sales_status",
                    "stopped_at",
                    "stopped_reason",
                    "stopped_reason_etc",
                    "force_no_normal_display",
                ],
            )
            if len(brand_product_variant_region_update_list) > 0
            else []
        )

        # update 후 중복이 제거된 brand_product_packages에 대해서 etc_delivery_fee 계산하는 로직
        for brand_product_package in brand_product_packages:
            brand_product_package.update_and_save_etc_delivery_fee()
        return updated_brand_product_variants, updated_brand_product_variant_regions

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        brand = cls.get_node_or_error(info, input_data["brand"], only_type=Brand)
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor")
        (
            details,
            product_set,
            pv_map,
            brand_product_names_by_product_id,
            is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id,
        ) = cls.clean_details(
            info=info,
            input_data=input_data,
            brand=brand,
            is_fulfilled_by_vendor=is_fulfilled_by_vendor,
            is_update_mode=True,
        )

        before_brand_product_and_variant = {
            sku: (
                models.BrandProduct.objects.get(brand=brand, product=product_variant.product),
                models.BrandProductVariant.objects.get(
                    brand=brand, product_variant=product_variant
                ),
            )
            for sku, product_variant in pv_map.items()
        }

        # update 에 필요한 brand_product, brand_product_variant, brand_product_variant_region 는 get 으로 가져와서 없는 경우 exception 발생으로 오류 처리되도록 함
        cls.update_brand_products(
            brand=brand,
            product_set=product_set,
            brand_product_names_by_product_id=brand_product_names_by_product_id,
            is_exclusives_by_product_id=is_exclusives_by_product_id,
            is_only_payable_by_cash_by_product_id=is_only_payable_by_cash_by_product_id,
            is_rcoin_reward_for_using_point_by_product_id=is_rcoin_reward_for_using_point_by_product_id,
        )
        (
            updated_brand_product_variants,
            updated_brand_product_variant_regions,
        ) = cls.update_brand_product_variants(
            is_update_mode=True,
            brand=brand,
            product_variants=pv_map,
            details=details,
        )

        manage_event = input_data.get("manage_event")
        if manage_event:
            for sku, (
                before_brand_product,
                before_brand_product_variant,
            ) in before_brand_product_and_variant.items():
                updated_brand_product = models.BrandProduct.objects.get(
                    brand=brand, product=pv_map[sku].product
                )
                updated_bpv = models.BrandProductVariant.objects.get(
                    brand=brand, product_variant=pv_map[sku]
                )

                brand_product_changes = generate_change_summary(
                    before_brand_product,
                    updated_brand_product,
                    None,
                    None,
                    ExtendedBrandProductUpdate.EXCLUDE_FIELDS_FOR_BRAND_PRODUCT,
                    ExtendedBrandProductUpdate.FIELD_NAME_MAPPING_FOR_BRAND_PRODUCT,
                    True,
                )
                brand_variant_changes = generate_change_summary(
                    before_brand_product_variant,
                    updated_bpv,
                    None,
                    None,
                    ExtendedBrandProductUpdate.EXCLUDE_FIELDS_FOR_BRAND_VARIANT,
                    ExtendedBrandProductUpdate.FIELD_NAME_MAPPING_FOR_BRAND_VARIANT,
                    True,
                )
                change_details = "\n".join(brand_product_changes + brand_variant_changes)
                manage_event["change_details"] = change_details
                add_bpv_manage_event(bpv=updated_bpv, manage_event=manage_event, info=info)

        return BrandProductVariantBulkUpdate(
            brand_product_variants=updated_brand_product_variants,
            brand_product_variant_regions=updated_brand_product_variant_regions,
        )
