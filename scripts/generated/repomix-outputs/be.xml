            )
            for instance, item in zip(instances, input_data)
        ]
        instances = cls.construct_instances(info, instances, cleaned_inputs)
        cls.clean_instances(info, instances)
        cls.save(info, instances)
        for instance, cleaned_input in zip(instances, cleaned_inputs):
            cls.post_save_action(info, instance, cleaned_input)
        return cls(brandMileageMonthlySettlementList=instances)

