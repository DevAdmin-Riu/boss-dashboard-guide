from collections import defaultdict

from ...order.models import RefundOrderLine
from ...payment import TransactionKind
from ...payment.models import Payment, PgRefundEvent, Transaction
from ..core.dataloaders import DataLoader


class PaymentByIdLoader(DataLoader):
    context_key = "payment_by_id"

    def batch_load(self, keys):
        payments = Payment.objects.in_bulk(keys)
        return [payments.get(payment_id) for payment_id in keys]


class TransactionByIdLoader(DataLoader):
    context_key = "transaction_by_id"

    def batch_load(self, keys):
        transactions = Transaction.objects.in_bulk(keys)
        return [transactions.get(transaction_id) for transaction_id in keys]


class PaymentsByOrderIdLoader(DataLoader):
    context_key = "payments_by_order_id"

    def batch_load(self, keys):
        # 모든 payments를 batch 로 로딩 후, 제일 처음 것을 last_payment 로 취하므로 order_by 변경 불가
        payments = Payment.objects.filter(order_id__in=keys).order_by("-pk")
        orders_to_payments = defaultdict(list)

        for payment in payments:
            orders_to_payments[payment.order_id].append(payment)

        return [orders_to_payments[order_id] for order_id in keys]


class TransactionsByPaymentIdLoader(DataLoader):
    context_key = "transactions_by_payment_id"

    def batch_load(self, keys):
        # 모든 transactions를 batch 로 로딩 후, 제일 처음 것을 last_transaction 로 취하므로 order_by 변경 불가
        transactions = Transaction.objects.filter(payment_id__in=keys).order_by("-pk")
        payments_to_transactions = defaultdict(list)

        for transaction in transactions:
            payments_to_transactions[transaction.payment_id].append(transaction)

        return [payments_to_transactions[payment_id] for payment_id in keys]


class SuccessCapturedTransactionsByPaymentIdLoader(DataLoader):
    context_key = "success_captured_transactions_by_payment_id"

    def batch_load(self, keys):
        # 모든 transactions를 batch 로 로딩 후, 제일 처음 것을 last_transaction 로 취하므로 order_by 변경 불가
        transactions = Transaction.objects.filter(
            payment_id__in=keys, kind=TransactionKind.CAPTURE, is_success=True
        ).order_by("-pk")
        payments_to_transactions = defaultdict(list)

        for transaction in transactions:
            payments_to_transactions[transaction.payment_id].append(transaction)

        return [payments_to_transactions[payment_id] for payment_id in keys]


class RefundOrderLinesByPaymentIdLoader(DataLoader):
    context_key = "refund_order_lines_by_payment_id"

    def batch_load(self, keys):
        refund_order_lines = RefundOrderLine.objects.filter(payment_id__in=keys)
        refund_order_lines_map = defaultdict(list)
        for refund_order_line in refund_order_lines:
            refund_order_lines_map[refund_order_line.payment_id].append(refund_order_line)
        return [refund_order_lines_map[payment_id] for payment_id in keys]


class PgRefundEventsByTransactionIdLoader(DataLoader):
    context_key = "pg_refund_events_by_transaction_id"

    def batch_load(self, keys):
        pg_refund_event = PgRefundEvent.objects.filter(transaction_id__in=keys)
        pg_refund_event_map = defaultdict(list)
        for refund_event in pg_refund_event:
            pg_refund_event_map[refund_event.transaction_id].append(refund_event)
        return [pg_refund_event_map[transaction_id] for transaction_id in keys]
