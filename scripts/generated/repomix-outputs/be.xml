def calc_average_unit_cost_price_exclude_vat_by_order_line(
    order_line: "OrderLine", fulfillment_lines=None
):
    fulfillment_lines_qs = order_line.fulfillment_lines.all()
    fulfillment_lines: List[FulfillmentLine] = fulfillment_lines or list(fulfillment_lines_qs)
    total_cost_include_vat = Decimal(0)
    total_quantity = Decimal(0)
    for fulfillment_line in fulfillment_lines:
        total_cost_include_vat += calc_total_include_vat_by_unit_exclude_vat_and_qty(
            fulfillment_line.unit_cost_price_exclude_vat,
            fulfillment_line.quantity,
            order_line.is_tax_free,
        )
        total_quantity += fulfillment_line.quantity

    average_unit_cost_price = (
        (total_cost_include_vat / total_quantity if total_quantity != 0 else 0)
        if total_cost_include_vat is not None and total_quantity is not None
        else None
    )
    average_unit_cost_price_exclude_vat = (
        calc_to_exclude_vat(average_unit_cost_price, order_line.is_tax_free)
        if average_unit_cost_price
        else None
    )
    return average_unit_cost_price_exclude_vat


def make_sales_vendor_info(order_line: "OrderLine", fulfillment_lines=None):
    vendors = []
    fulfillment_lines_qs = order_line.fulfillment_lines.all()
    fulfillment_lines: List[FulfillmentLine] = fulfillment_lines or list(fulfillment_lines_qs)
    for fulfillment_line in fulfillment_lines:
        vendor: Vendor = fulfillment_line.vendor
        if vendor:
            info = make_simple_vendor_parameters(vendor)
            vendors.append(info)
    if len(vendors) > 0:
        unique_data = {tuple(item.items()) for item in vendors}
        vendors = [dict(item) for item in unique_data]
        vendor_info = {
            "vendors": vendors,
        }
    else:
        vendor_info = {}

    return vendor_info


def _make_common_sales_stats(
    order: "Order",
    order_line: "OrderLine",
    variant: "ProductVariant",
    payment: "Payment",
    refund_order_line: "RefundOrderLine" = None,
    # user_info정보에 들어갈 brand_force임.
    brand_force: "Brand" = None,
):
    is_tax_free = order_line.is_tax_free
    bp_bundle: BpBundle = order_line.bp_bundle

    user: User = order.user
    # 오픈몰 주문이 아닌 이상 order_line에 bpv가 있으므로 아래 brand는 사실상 의미 없음.
    brand: Brand = user.brand if user else None
    if not bp_bundle:
        brand_product: BrandProduct = None
        is_exclusive = False
        bpv = None
        # bpv가 존재하는 경우 bpv, brand를 덮어쓴다.
        if order_line.brand_product_variant:
            bpv: BrandProductVariant = order_line.brand_product_variant
            brand: Brand = bpv.brand
        elif brand:
            brand_product_variants: Iterable[BrandProductVariant] = (
                variant.brand_product_variants.all()
            )
            bpv: BrandProductVariant = next(
                (bpv for bpv in brand_product_variants if bpv.brand_id == brand.id),
                None,
            )
        brand_product = bpv.brand_product if bpv else None
        is_exclusive = brand_product.is_exclusive if brand_product else False
        bp_sku = bpv.bp_sku if bpv else ""
        brand_product_name = brand_product.name if brand_product else "-"
    else:
        is_exclusive = bp_bundle.is_exclusive
        bp_sku = bp_bundle.bp_sku
        brand_product_name = bp_bundle.name

    average_unit_cost_price_exclude_vat = calc_average_unit_cost_price_exclude_vat_by_order_line(
        order_line
    )

    tax_invoices: Iterable[TaxInvoice] = order.tax_invoices.all()
    issued_tax_invoice = next(
        (
            tax_invoice
            for tax_invoice in tax_invoices
            if tax_invoice.is_tax_free == is_tax_free
            and tax_invoice.status == TaxInvoiceStatus.ISSUED
        ),
        None,
    )

    if refund_order_line and refund_order_line.transaction:
        refund_transaction_id = refund_order_line.transaction.id
    else:
        refund_transaction_id = None

    order_info = {
        "orderNumber": order.id,
        "capturedAt": order.captured_at,
        "orderEtcInfo": order.etc_info,
        "paymentNumber": payment.id,
        "paymentMethod": make_combine_pay_method_text(payment),
        "refundTxnNumber": refund_transaction_id,
    }
    product_info = {
        "productSku": order_line.product_sku,
        "productName": order_line.product_name,
        "variantName": order_line.variant_name,
        "brandProductName": brand_product_name,
        "attributeData": convert_to_simple_attribute(variant),
    }

    vendor_info = make_sales_vendor_info(order_line)

    if user:
        user_info = {
            "loginId": user.login_id,
            "firstName": user.first_name,
            "phone": format_as_numeric_only_phone_number(user.aligo_phone) or "-",
            # user가 매장을 가진경우 매장의 값을 사용하고 아니면 user의 값을 사용함.
            "bizRegNo": user.brand_store.biz_reg_no if user.brand_store else user.biz_reg_no,
        }
        brand_info = {
            # brand_force가 존재하는 경우 우선사용한다. bpv가 아니라 중복적으로 기존 브랜드몰에도 한번더 찍기 위한 용도라서 해당 부분은 강제 주입.
            "brandCode": (brand_force.code if brand_force else (brand.code if brand else "-")),
            "brandName": (brand_force.name if brand_force else (brand.name if brand else "-")),
        }
    else:
        user_info = {}
        brand_info = {}

    staff: User = brand.staff if brand else None
    if staff:
        md_info = {
            "firstName": staff.first_name,
            "phone": format_as_numeric_only_phone_number(staff.aligo_phone) or "-",
        }
    else:
        md_info = {}

    return (
        is_exclusive,
        average_unit_cost_price_exclude_vat,
        issued_tax_invoice,
        user,
        brand,
        order_info,
        product_info,
        bp_sku,
        vendor_info,
        user_info,
        brand_info,
        md_info,
    )


def update_stats_sales_info_on_tax_invoice_issued(
    tax_invoices: Iterable["TaxInvoice"],
):
    for tax_invoice in tax_invoices:
        order: Order = tax_invoice.order
        if order is None:
            logger.error(f"order is None. tax_invoice_id: {tax_invoice.id}")
            continue
        is_tax_free = tax_invoice.is_tax_free
        # 주문 건에는 세금계산서 발행 금액 업데이트
        # 환불 건의 발행 금액 차액은 환불 시점에 반품배송비를 제외하고 기록하므로 여기서 issued 된 것으로 업데이트 하지 않음
        Sales.objects.filter(
            order=order, is_tax_free=is_tax_free, refund_order_line__isnull=True
        ).update(
            tax_invoice_amount=tax_invoice.issued_amount,
        )
        # 세금계산서 id 는 주문/환불 건 모두 업데이트
        Sales.objects.filter(order=order, is_tax_free=is_tax_free).update(
            issued_tax_invoice=tax_invoice,
        )


def update_stats_sales_info_on_order_fulfilled(
    order_lines: Iterable["OrderLine"],
):
    for order_line in order_lines:
        fulfillment_lines = list(order_line.fulfillment_lines.select_related("vendor").all())
        average_unit_cost_price_exclude_vat = (
            calc_average_unit_cost_price_exclude_vat_by_order_line(order_line, fulfillment_lines)
        )
        vendor_info = make_sales_vendor_info(order_line, fulfillment_lines)
        Sales.objects.filter(order_line=order_line).update(
            unit_cost_price_exclude_vat=average_unit_cost_price_exclude_vat,
            vendor_info=vendor_info,
        )


def make_create_stats_sales_by_refund_order_line(
    refund_order_line: "RefundOrderLine",
    is_migration_mode=bool,
    diff_tax_free_tax_invoice_total=Decimal(0),
    diff_taxable_tax_invoice_total=Decimal(0),
    brand_force: "Brand" = None,
    is_order_from_boss_mrkt: bool = False,
):
    order_line: OrderLine = refund_order_line.order_line
    if order_line is None:
        raise Exception(f"order_line is None. refund_order_line: {refund_order_line.id}")

    order: Order = order_line.order
    if order is None:
        raise Exception(f"order is None. order_line_id: {order_line.id}")

    payment: Payment = refund_order_line.payment
    if payment is None:
        raise Exception(f"payment is None. order_line_id: {order_line.id}")

    variant: ProductVariant = order_line.variant
    if variant is None:
        raise Exception(f"variant is None. order_line_id: {order_line.id}")

    product: Product = variant.product
    if product is None:
        raise Exception(f"product is None. order_line_id: {order_line.id}")

    (
        is_exclusive,
        average_unit_cost_price_exclude_vat,
        issued_tax_invoice,
        user,
        brand,
        order_info,
        product_info,
        bp_sku,
        vendor_info,
        user_info,
        brand_info,
        md_info,
    ) = _make_common_sales_stats(
        order=order,
        order_line=order_line,
        variant=variant,
        payment=payment,
        refund_order_line=refund_order_line,
        brand_force=brand_force,
    )

    is_tax_free = order_line.is_tax_free
    diff_tax_invoice_amount = Decimal(0)
    if is_migration_mode:
        if issued_tax_invoice and issued_tax_invoice.is_modified_after_issued:
            diff_tax_invoice_amount = (
                issued_tax_invoice.total_amount - issued_tax_invoice.issued_amount
            )
    # 세금계산서 발행이 안되어 있어도 환불 시 세금계산서 정산 금액은 기록해 둠
    else:
        # 악성재고 처리용 오픈몰 주문, 기타배송주문, B2B 주문은 세금계산서 발행 없음
        if order.type in [
            OrderType.BY_STAFF_FOR_BAD_STOCK,
            OrderType.BY_STAFF_FOR_ETC,
            OrderType.BY_STAFF_FOR_B2B,
            OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
        ]:
            diff_tax_invoice_amount = Decimal(0)
        else:
            if is_tax_free:
                diff_tax_invoice_amount = diff_tax_free_tax_invoice_total
            else:
                # 발행 전 수정 건 및 면세상품만 구매후 반품배송비 발생 환불한 경우 반품배송비 세금계산서를 저장할 공간이 없어서 db 에는 반품배송비 관련 보정값은 적용하지 않고
                # 프론트엔드 환불 건 세금계산서 정보에 무조건 반품배송비 값 추가해서 표시
                diff_tax_invoice_amount = (
                    diff_taxable_tax_invoice_total - refund_order_line.return_delivery_fee
                )

    bundle_info_qty = order_line.bundle_info_qty
    return Sales(
        order_type=order.type,
        # from refund_order_line
        evented_at=refund_order_line.refunded_at,
        quantity=refund_order_line.quantity,
        bundle_qty=refund_order_line.quantity / bundle_info_qty,
        is_main_pv=order_line.is_main_pv,
        amount=refund_order_line.amount,
        cashable_credits=refund_order_line.cashable_credits,
        non_cashable_credits=refund_order_line.non_cashable_credits,
        rcoins=refund_order_line.rcoins,
        amount_exclude_vat=calc_to_exclude_vat(refund_order_line.amount, is_tax_free),
        cashable_credits_exclude_vat=calc_to_exclude_vat(
            refund_order_line.cashable_credits, is_tax_free
        ),
        non_cashable_credits_exclude_vat=calc_to_exclude_vat(
            refund_order_line.non_cashable_credits, is_tax_free
        ),
        rcoins_exclude_vat=calc_to_exclude_vat(refund_order_line.rcoins, is_tax_free),
        total_price_exclude_vat=calc_to_exclude_vat(
            order_line.unit_price_gross_amount * refund_order_line.quantity, is_tax_free
        ),
        return_delivery_fee=refund_order_line.return_delivery_fee,
        mileage_exclude_vat=refund_order_line.diff_mileage_exclude_vat,
        brand_paying_charge_exclude_vat=refund_order_line.diff_brand_paying_charge_exclude_vat,
        paying_charge_exclude_vat=refund_order_line.diff_paying_charge_exclude_vat,
        # from order_line
        unit_price=order_line.unit_price_gross_amount,
        unit_delivery_fee=order_line.unit_delivery_fee_amount,
        unit_inner_incidental_cost=order_line.unit_inner_incidental_cost_amount,
        brand_unit_cost_price=order_line.brand_unit_cost_price_amount,
        brand_unit_cost_price_exclude_vat=calc_to_exclude_vat(
            order_line.brand_unit_cost_price_amount, is_tax_free
        ),
        brand_total_cost_price_exclude_vat=calc_to_exclude_vat(
            order_line.brand_unit_cost_price_amount * refund_order_line.quantity,
            is_tax_free,
        ),
        brand_unit_delivery_fee=order_line.brand_unit_delivery_fee_amount,
        track_inventory=order_line.track_inventory,
        is_tax_free=is_tax_free,
        calc_mileage=order_line.calc_mileage,
        exclude_stock_avg_stats=order_line.exclude_stock_avg_stats,
        is_fulfilled_by_vendor=order_line.is_fulfilled_by_vendor,
        fulfill_vendor=order_line.vendor,
        # from product
        is_direct_shipping=product.is_direct_shipping,
        category_type=product.category.type,
        # from brand_product or bp_bundle
        is_exclusive=is_exclusive,
        # from fulfillment
        unit_cost_price_exclude_vat=average_unit_cost_price_exclude_vat,
        # 발행 후 환불 시 세금계산서 발행 금액 차액
        tax_invoice_amount=diff_tax_invoice_amount,
        # foreignkeys
        user_id=user.id if user else None,
        brand_id=brand_force.id if brand_force else (brand.id if brand else None),
        is_order_from_boss_mrkt=is_order_from_boss_mrkt,
        order_id=order.id,
        variant_id=variant.id,
        order_line_id=order_line.id,
        bp_bundle_id=order_line.bp_bundle_id,
        refund_order_line_id=refund_order_line.id,
        issued_tax_invoice_id=issued_tax_invoice.id if issued_tax_invoice else None,
        # 본부 수익금 계산 기준 정보
        mileage_rate=order_line.mileage_rate if order_line.calc_mileage else Decimal(0),
        card_paying_charge_rate=order_line.card_paying_charge_rate,
        vbank_paying_charge_exclude_vat=order_line.vbank_paying_charge_exclude_vat,
        # 기타 정보들
        order_info=order_info,
        product_info=product_info,
        bp_sku=bp_sku,
        vendor_info=vendor_info,
        user_info=user_info,
        brand_info=brand_info,
        md_info=md_info,
    )


def make_create_stats_sales_by_refund_order_lines(
    refund_order_lines: Iterable["RefundOrderLine"],
    is_migration_mode=bool,
    diff_tax_free_tax_invoice_total=Decimal(0),
    diff_taxable_tax_invoice_total=Decimal(0),
):
    create_list = []
    for refund_order_line in refund_order_lines:
        stats_sales = make_create_stats_sales_by_refund_order_line(
            refund_order_line=refund_order_line,
            is_migration_mode=is_migration_mode,
            diff_tax_free_tax_invoice_total=diff_tax_free_tax_invoice_total,
            diff_taxable_tax_invoice_total=diff_taxable_tax_invoice_total,
        )
        create_list.append(stats_sales)

        order_line: OrderLine = refund_order_line.order_line
        # NOTE: order user brand가 bpv의 brand와 다르면 보스장터라고 가정한다. 향후 보스장터외 몰들이 추가될 경우에는 수정 필요.
        if order_line.order.user and order_line.brand_product_variant:
            user_brand = order_line.order.user.brand
            user_brand_id = user_brand.id
            if user_brand_id != order_line.brand_product_variant.brand.id:
                stats_sales = make_create_stats_sales_by_refund_order_line(
                    refund_order_line=refund_order_line,
                    is_migration_mode=is_migration_mode,
                    diff_tax_free_tax_invoice_total=diff_tax_free_tax_invoice_total,
                    diff_taxable_tax_invoice_total=diff_taxable_tax_invoice_total,
                    brand_force=user_brand,
                    is_order_from_boss_mrkt=True,
                )
                create_list.append(stats_sales)

    return create_list


def make_create_stats_sales_by_order_line(
    order_line: "OrderLine",
    brand_force: "Brand" = None,
    is_order_from_boss_mrkt: bool = False,
    is_b2b: bool = False,
):
    order: Order = order_line.order
    if order is None:
        raise Exception(f"order is None. order_line_id: {order_line.id}")

    payment: Payment = get_last_payment(order)
    if payment is None:
        raise Exception(f"payment is None. order_line_id: {order_line.id}")

    variant: ProductVariant = order_line.variant
    if variant is None:
        raise Exception(f"variant is None. order_line_id: {order_line.id}")

    product: Product = variant.product
    if product is None:
        raise Exception(f"product is None. order_line_id: {order_line.id}")

    is_b2b_take_back = is_b2b and order.type == OrderType.BY_STAFF_FOR_B2B_TAKE_BACK

    (
        is_exclusive,
        average_unit_cost_price_exclude_vat,
        issued_tax_invoice,
        user,
        brand,
        order_info,
        product_info,
        bp_sku,
        vendor_info,
        user_info,
        brand_info,
        md_info,
    ) = _make_common_sales_stats(
        order=order,
        order_line=order_line,
        variant=variant,
        payment=payment,
        brand_force=brand_force,
    )
    is_tax_free = order_line.is_tax_free

    multiply_factor = -1 if is_b2b_take_back else 1
    order_line_amount = order_line.amount * multiply_factor
    order_line_cashable_credits = order_line.cashable_credits * multiply_factor
    order_line_non_cashable_credits = order_line.non_cashable_credits * multiply_factor
    order_line_rcoins = order_line.rcoins * multiply_factor
    # 주문 수량 보다 더 많이 출고한 경우 출고 수량으로 매출 데이터 생성
    sales_qty = get_ordered_or_fulfill_qty(order_line) * multiply_factor
    b2b_delivery_fee_exclude_vat = order_line.b2b_delivery_fee_exclude_vat
    evented_at = order.captured_at if is_b2b == False else kst_datetime()

    return Sales(
        # from order
        evented_at=evented_at,
        b2b_order_created_at=order.created if is_b2b else None,
        # 납품일을 거래명세서 출력일로 표시해서 반품발주서는 거래명세서 출력단계는 없지만 날자 세팅은 함
        b2b_invoice_printed_at=kst_datetime() if is_b2b_take_back else None,
        b2b_order_completed_at=kst_datetime() if is_b2b_take_back else None,
        order_type=order.type,
        # from order_line
        amount=order_line_amount,
        cashable_credits=order_line_cashable_credits,
        non_cashable_credits=order_line_non_cashable_credits,
        rcoins=order_line_rcoins,
        amount_exclude_vat=calc_to_exclude_vat(order_line_amount, is_tax_free),
        cashable_credits_exclude_vat=calc_to_exclude_vat(order_line_cashable_credits, is_tax_free),
        non_cashable_credits_exclude_vat=calc_to_exclude_vat(
            order_line_non_cashable_credits, is_tax_free
        ),
        rcoins_exclude_vat=calc_to_exclude_vat(order_line_rcoins, is_tax_free),
        total_price_exclude_vat=calc_to_exclude_vat(
            order_line.unit_price_gross_amount * sales_qty, is_tax_free
        ),
        mileage_exclude_vat=order_line.mileage_exclude_vat,
        brand_paying_charge_exclude_vat=order_line.brand_paying_charge_exclude_vat,
        paying_charge_exclude_vat=order_line.paying_charge_exclude_vat,
        quantity=sales_qty,
        bundle_qty=order_line.bundle_qty * multiply_factor,
        is_main_pv=order_line.is_main_pv,
        unit_price=order_line.unit_price_gross_amount,
        b2b_delivery_fee_exclude_vat=b2b_delivery_fee_exclude_vat,
        unit_delivery_fee=order_line.unit_delivery_fee_amount,
        unit_inner_incidental_cost=order_line.unit_inner_incidental_cost_amount,
        brand_unit_cost_price=order_line.brand_unit_cost_price_amount,
        brand_unit_cost_price_exclude_vat=calc_to_exclude_vat(
            order_line.brand_unit_cost_price_amount, is_tax_free
        ),
        brand_total_cost_price_exclude_vat=calc_to_exclude_vat(
            order_line.brand_unit_cost_price_amount * sales_qty, is_tax_free
        ),
        brand_unit_delivery_fee=order_line.brand_unit_delivery_fee_amount,
        track_inventory=order_line.track_inventory,
        is_tax_free=is_tax_free,
        calc_mileage=order_line.calc_mileage,
        exclude_stock_avg_stats=order_line.exclude_stock_avg_stats,
        is_fulfilled_by_vendor=order_line.is_fulfilled_by_vendor,
        fulfill_vendor=order_line.vendor,
        # from product
        is_direct_shipping=product.is_direct_shipping,
        category_type=product.category.type,
        # from brand_product or bp_bundle
        is_exclusive=is_exclusive,
        # from fulfillment
        unit_cost_price_exclude_vat=average_unit_cost_price_exclude_vat,
        # from taxinvoice
        tax_invoice_amount=(issued_tax_invoice.issued_amount if issued_tax_invoice else None),
        # foreignkeys
        user_id=user.id if user else None,
        brand_id=brand_force.id if brand_force else (brand.id if brand else None),
        is_order_from_boss_mrkt=is_order_from_boss_mrkt,
        order_id=order.id,
        variant_id=variant.id,
        order_line_id=order_line.id,
        bp_bundle_id=order_line.bp_bundle_id,
        issued_tax_invoice_id=issued_tax_invoice.id if issued_tax_invoice else None,
        # 본부 수익금 계산 기준 정보
