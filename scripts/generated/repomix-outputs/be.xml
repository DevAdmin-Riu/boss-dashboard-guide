        product_variant = cls.get_node_or_error(
            info, variant_id, field="brand_id", only_type=ProductVariant
        )
        if product_variant is None:
            raise ValidationError("variant_id 오류", code=ProductErrorCode.INVALID)

        cls.validate_is_adjust_price(brand, product_variant)

        models.BrandProductVariant.objects.create(
            brand=brand,
            brand_product=brand_product,
            product_variant=product_variant,
            sales_status=SalesStatus.STOPPED,
            stopped_reason=StoppedReasonType.ETC,
