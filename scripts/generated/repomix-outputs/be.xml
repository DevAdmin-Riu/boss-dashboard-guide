        instance = super(CustomerCreate, cls).construct_instance(info, instance, cleaned_data)
        return instance

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        # 만약 기존(instance)의 user의 brand_store_role이 이미 OWNER라면 OWNER에서 다른 권한으로는 변경 불가.
        if (
            instance.brand_store_role == BrandStoreRole.OWNER
            and cleaned_input.get("brand_store_role")
            and cleaned_input.get("brand_store_role") != BrandStoreRole.OWNER
        ):
            raise ValidationError("점주 권한에서 다른 권한으로 수정 불가 합니다.")

        return cleaned_input

    @classmethod
    @transaction.atomic
    def save(cls, info, user, cleaned_input):
        user.save()
        brand_store_role = cleaned_input.get("brand_store_role")
        if brand_store_role:
            user.brand_store_user.role = brand_store_role
            user.brand_store_user.save()
