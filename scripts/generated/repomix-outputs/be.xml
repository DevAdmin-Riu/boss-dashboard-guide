class NoticeFilter(django_filters.FilterSet):
    def filter_user_search(qs, _, value):
        search_fields = [
            "writer__first_name",
            "writer__login_id",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_title_search(qs, _, value):
        fields = ["title"]
        qs = filter_by_query_param(qs, value, fields)
        return qs

    def filter_available_brand(qs, _, value):
        if value:
            _, brand_id = graphene.Node.from_global_id(value)
            available_filter = Q(available_to_all_brands=True) | Q(available_brands__id=brand_id)
            qs = qs.filter(available_filter)
        return qs

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created_at__date", value)

    def filter_owner_brand_search(qs, _, value):
        search_fields = [
            "owner_brand__code",
            "owner_brand__name",
        ]
        return filter_by_query_param(qs, value, search_fields)

    user_search = django_filters.CharFilter(method=filter_user_search)
    # 운영 Admin에서 본부 -> 매장 공지사항에서만 쓰이는 필터
    owner_brand_search = django_filters.CharFilter(method=filter_owner_brand_search)
    title_search = django_filters.CharFilter(method=filter_title_search)
    available_brand = GlobalIDFilter(method=filter_available_brand)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)

    class Meta:
        model = models.Notice
        fields = ["is_hq_notice", "is_fixed"]


class NoticeFilterInput(FilterInputObjectType):
