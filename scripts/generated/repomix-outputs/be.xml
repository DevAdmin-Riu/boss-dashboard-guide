    offset,
    brand_code,
    title,
    status,
    started_at_gte,
    started_at_lte,
    updated_at_gte,
    updated_at_lte,
):
    api_tag = "문서 리스트 조회"
    response_json = None
    error_msg = None
    try:
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(MODUSIGN_PLUGIN_ID)
        headers = get_modusign_api_headers(plugin_configs)

        url = f"{MODUSIGN_DOCUMENTS_URL}?offset={offset}&limit={limit}"
        if brand_code:
            meta_data_filter = json.dumps({MODUSIGN_BRAND_CODE_META_DATA_FIELD: brand_code})
            encoded_meta_data_filter = quote(meta_data_filter, safe="")
            url = url + f"&{MODUSIGN_METADATAS_FIELD}={encoded_meta_data_filter}"
        filters = []
        if title:
            filter = f"contains({MODUSIGN_TITLE_FIELD}, '{title}')"
            filters.append(filter)
        if status:
            filter = f"{MODUSIGN_STATUS_FIELD} eq '{status}'"
            filters.append(filter)
        if started_at_gte:
            kst_datetime = to_datetime_astimezone(started_at_gte)
            filter = f"{MODUSIGN_STARTED_AT_FIELD} ge '{kst_datetime}'"
            filters.append(filter)
        if started_at_lte:
            kst_datetime = to_datetime_astimezone(started_at_lte, end_of_day=True)
            filter = f"{MODUSIGN_STARTED_AT_FIELD} le '{kst_datetime}'"
            filters.append(filter)
        if updated_at_gte:
            kst_datetime = to_datetime_astimezone(updated_at_gte)
            filter = f"{MODUSIGN_UPDATED_AT_FIELD} ge '{kst_datetime}'"
            filters.append(filter)
        if updated_at_lte:
            kst_datetime = to_datetime_astimezone(updated_at_lte, end_of_day=True)
            filter = f"{MODUSIGN_UPDATED_AT_FIELD} le '{kst_datetime}'"
            filters.append(filter)

        if filters:
            all_filter = " and ".join(filters)
            encoded_filter = quote(all_filter, safe="")
            url = url + f"&filter={encoded_filter}"

        response = requests.get(url=url, headers=headers)
