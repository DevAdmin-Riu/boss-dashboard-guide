from collections import defaultdict
from typing import Dict, List

from django.db import transaction

from ..account.models import User
from ..core.utils import build_absolute_dashboard_uri
from ..core.utils.str_utils import to_locale_number
from . import OrderLineB2bStatus
from .emails import (
    send_email_b2b_order_line_pending_to_riu_task,
    send_email_b2b_order_line_rejected_to_brand_task,
)
from .models import OrderLine, OrderLineB2bStatusHistory


def make_order_lines_group_by_user(
    order_lines: List[OrderLine],
) -> Dict[User, List[OrderLine]]:
    order_lines_group_by_vendor = defaultdict(list)
    for order_line in order_lines:
        user = order_line.order.user
        order_lines_group_by_vendor[user].append(order_line)
    return order_lines_group_by_vendor


def make_parameters_related_to_b2b_order(
    order_lines: List["OrderLine"],
):
    if not order_lines:
        return None
    first_order_line = order_lines[0]
    order = first_order_line.order
    user = order.user
    first_order_line_composed_id = first_order_line.composed_id_with_prefix
    first_po_line_product_name = first_order_line.get_variant_name()
    line_count = len(order_lines)
    line_count_minus_one = to_locale_number(line_count - 1)
    line_id = (
        first_order_line_composed_id
        if line_count == 1
        else f"{first_order_line_composed_id} 외 {line_count_minus_one}건"
    )
    line_product_name = (
        first_po_line_product_name
        if line_count == 1
        else f"{first_po_line_product_name} 외 {line_count_minus_one}건"
    )
    parameters = {
        "receiver_email": user.email,
        "line_id": line_id,
        "line_product_name": line_product_name,
    }
    return parameters


def bulk_create_order_line_b2b_status_histories(
    order_lines: List["OrderLine"],
    after_status: OrderLineB2bStatus,
    user: "User",
    before_status: OrderLineB2bStatus = None,
    before_status_list: List[OrderLineB2bStatus] = None,
    reason: str = "",
):
    histories = []
    if before_status_list:
        for line, before_status in zip(order_lines, before_status_list):
            histories.append(
                OrderLineB2bStatusHistory(
                    order_line=line,
                    before_status=before_status,
                    after_status=after_status,
