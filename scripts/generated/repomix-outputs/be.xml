            .annotate(user_login_id=F("user__login_id"))
            .order_by("vendor_id", "user_brand_name", "user_login_id")
        )


class FbvDeliveryCondition(models.Model):
    created = models.DateTimeField(auto_now_add=True)
    vendor = models.ForeignKey(
        "Vendor",
        related_name="fbv_delivery_conditions",
        on_delete=models.PROTECT,
    )
    user = models.ForeignKey(
        "account.User",
        related_name="fbv_delivery_conditions",
        null=True,
        on_delete=models.SET_NULL,
    )
    is_base_user = models.BooleanField(default=False)
    disallow_delivery_date = models.BooleanField(default=True)
    possible_delivery_days = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)
    minimum_order_price = models.PositiveIntegerField(default=0)

    objects = FbvDeliveryConditionQuerySet.as_manager()

    class Meta:
        unique_together = ("vendor", "user")


class Maker(models.Model):
    name = models.CharField(max_length=50, unique=True)

    @property
    def code(self):
