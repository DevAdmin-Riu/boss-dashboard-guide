    )


def list_payment_sources(gateway: str, customer_id: str) -> List["CustomerSource"]:
    plugin_manager = get_plugins_manager()
    return plugin_manager.list_payment_sources(gateway, customer_id)


def get_client_token(gateway: str, customer_id: str = None) -> str:
    plugin_manager = get_plugins_manager()
    token_config = TokenConfig(customer_id=customer_id)
    return plugin_manager.get_client_token(gateway, token_config)


def list_gateways() -> List["PaymentGateway"]:
    return get_plugins_manager().list_payment_gateways()


def _fetch_gateway_response(fn, *args, **kwargs):
    response, error = None, None
    try:
        response = fn(*args, **kwargs)
        validate_gateway_response(response)
    except GatewayError:
        logger.exception("Gateway response validation failed!")
        response = None
        error = ERROR_MSG
    except PaymentError:
        logger.exception("Error encountered while executing payment gateway.")
        error = ERROR_MSG
        response = None
    return response, error


def _make_refund_gateway_response(
    payment_information: PaymentData, transaction_kind: TransactionKind
):
    error = None
    response = GatewayResponse(
        is_success=True,
        action_required=False,
        kind=transaction_kind,
        amount=payment_information.amount,
        cashable_credits=payment_information.cashable_credits,
        non_cashable_credits=payment_information.non_cashable_credits,
        rcoins=payment_information.rcoins,
        currency=payment_information.currency,
        transaction_id=payment_information.token,
        error=error,
    )
    return response, error


def _get_past_transaction_token(
    payment: Payment, kind: str  # for kind use "TransactionKind"
) -> Optional[str]:
    txn = payment.transactions.filter(kind=kind, is_success=True).last()
    if txn is None:
        raise PaymentError(f"Cannot find successful {kind} transaction.")
    return txn.token


def _validate_refund_amount(
    payment: Payment,
    amount: Decimal,
    cashable_credits: Decimal,
    non_cashable_credits: Decimal,
    rcoins: Decimal,
):
    if amount < 0:
        raise PaymentError("환불 금액이 음수입니다.")
    if amount > payment.captured_amount:
        raise PaymentError("환불할 금액이 남아 있는 결제 금액 보다 큰 값입니다.")
    if cashable_credits < 0:
        raise PaymentError("현금 출금 가능 충전금 환불이 음수입니다.")
    if (
        payment.captured_cashable_credits > 0
        and cashable_credits > payment.captured_cashable_credits
    ):
        raise PaymentError("충전금 환불이 남아 있는 결제에 사용된 충전금 보다 큰 값입니다.")
    if non_cashable_credits < 0:
        raise PaymentError("현금 출금 불가 충전금 환불이 음수입니다.")
    if (
        payment.captured_non_cashable_credits > 0
        and non_cashable_credits > payment.captured_non_cashable_credits
    ):
        raise PaymentError("충전금 환불이 남아 있는 결제에 사용된 충전금 보다 큰 값입니다.")
    if rcoins < 0:
        raise PaymentError("포인트 환불이 음수입니다.")
    if rcoins > payment.captured_rcoins:
        raise PaymentError("포인트 환불이 남아 있는 결제에 사용된 포인트 보다 큰 값입니다.")


def payment_refund_or_void(payment: Optional[Payment]):
    if payment is None:
        return

    logger.warn(f"payment_refund_or_void payment: {payment}")

    if payment.can_refund():
        refund(payment, transaction_kind=TransactionKind.AUTO_REFUND)
    elif payment.can_void():
        void(payment)
