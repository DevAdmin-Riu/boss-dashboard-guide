class OrderUpdate(ModelMutation, I18nMixin):
    class Arguments:
        id = graphene.ID(required=True, description="ID of an order to update.")
        input = OrderUpdateInput(required=True, description="Fields required to update an order.")

    class Meta:
        description = "Updates an order."
        model = models.Order
        permissions = (OrderPermissions.MANAGE_ORDER_INFO,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_charge_additional_to_non_charge_additional(
        cls, info, instance: OrderModel, shipping_address: dict
    ):
        # 이전/변경 주소의 우편번호가 국내 5자리인 경우에만 주소 변경 시 도서산간 변경되는 것 체크
        if not check_exact_digit_length(shipping_address.postal_code, 5):
            return
        if not check_exact_digit_length(instance.shipping_address.postal_code, 5):
            return

        prev_charge_additional_fee_flag = check_charge_delivery_additional_fee(
            instance.shipping_address
        )
        now_charge_additional_fee_flag = check_charge_delivery_additional_fee(shipping_address)
        if prev_charge_additional_fee_flag != now_charge_additional_fee_flag:
            raise ValidationError(
                "도서산간 추가요금 발생 지역과 그 외 지역의 배송지 변경은 허용하지 않습니다. 도서산간 추가요금 데이터 변환이 필요하므로 필요시 시스템 관리자에게 확인해 주세요."
            )

    @classmethod
    def clean_input(cls, info, instance: OrderModel, data):
        shipping_address = data.pop("shipping_address", None)
        cleaned_input = super().clean_input(info, instance, data)

        if shipping_address:
            # cls.validate_address 에서 instance.shipping_address 가 변경되므로 validate_charge_additional_to_non_charge_additional 를 먼저 수행해야 함
            cls.validate_charge_additional_to_non_charge_additional(
                info, instance, shipping_address
            )
            shipping_address = cls.validate_address(
                shipping_address, instance=instance.shipping_address, info=info
            )
            cleaned_input["shipping_address"] = shipping_address

        return cleaned_input

    @staticmethod
    def _save_addresses(info, instance: OrderModel, cleaned_input):
        shipping_address = cleaned_input.get("shipping_address")
        if shipping_address:
            shipping_address.save()
            instance.shipping_address = shipping_address.get_copy()

    @classmethod
    def get_instance(cls, info, **data):
        instance = super().get_instance(info, **data)
        return instance

    @classmethod
    @transaction.atomic()
    def save(cls, info, instance: OrderModel, cleaned_input):
        cls._save_addresses(info, instance, cleaned_input)
        estimated_arrival_date = cleaned_input.get("estimated_arrival_date")

        if estimated_arrival_date:
            instance.estimated_arrival_date = estimated_arrival_date

        # estimated_arrival_date_doesnt_matter 값이 True로 넘어오는 경우 estimated_arrival_date를 None으로 변경.
        estimated_arrival_date_doesnt_matter = cleaned_input.get(
            "estimated_arrival_date_doesnt_matter", False
        )
        if estimated_arrival_date_doesnt_matter:
            instance.estimated_arrival_date = None

        info.context.plugins.order_updated(instance)
        instance.save(
            update_fields=[
                "shipping_address",
                "estimated_arrival_date",
            ]
        )


