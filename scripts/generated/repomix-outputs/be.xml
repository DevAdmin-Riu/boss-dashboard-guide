    @classmethod
    def upsert_etc_files(cls, info, instance, cleaned_input):
        etc_files_data = cleaned_input.get("etc_files")
        if not etc_files_data:
            return

        for fd in etc_files_data:
            t = fd.get("type")
            if not t:
                continue

            obj, created = models.BrandEtcFile.objects.get_or_create(brand=instance, type=t)

            # file 키가 존재하면 (None 포함) 의도적 변경으로 해석
            if "file" in fd:
                new_file = fd["file"]
                if new_file is None:
                    # 삭제 의도: 스토리지에서 제거 + DB null
                    if obj.file:
                        obj.file.delete(save=False)
                    obj.file = None
                    obj.file_name = ""
                else:
                    # 교체 의도: 기존 파일 삭제 후 교체 (파일명 정책은 필요시 별도 적용)
                    if obj.file:
                        obj.file.delete(save=False)
                    obj.file = new_file
                    obj.file_name = new_file.name

            # 그 외 필드들도 "키가 존재하면"만 덮어쓰기
            for key in ("description", "contract_date", "start_date", "end_date"):
                if key in fd:
                    setattr(obj, key, fd[key])

            obj.save()

