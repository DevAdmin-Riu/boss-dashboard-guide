# 리턴이 None 인 경우 예외 처리 필수
def change_toss_plugin_configs(plugin_configs, brand: "Brand"):
    if brand and brand.is_reverse_fee_contract_type:
        # 매출인식몰 테스트 시 is_prod_mode 를 키는 것은 실제 라이브 결제가 이루어질 위험이 있음
        # 대신 dev 용 mid 를 잠시 xxxx 로 변경한 후 매출인식몰 결제 테스트하면 됨
        plugin_configs.client_key = brand.reverse_fee_toss_client_key
        plugin_configs.secret_key = brand.reverse_fee_toss_secret_key
        # 매출인식인 경우 브랜드 페이 결제는 허용하지 않음
        plugin_configs.bp_client_key = None
        plugin_configs.bp_secret_key = None
