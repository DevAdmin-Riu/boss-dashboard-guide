from ..core.connection import CountableDjangoObjectType
from ..core.types import Image
from .dataloaders import BrandsByBannerIdLoader, BrandsByPopupIdLoader, NoticeByIdLoader


class Banner(CountableDjangoObjectType):
    available_brands = graphene.List(Brand, description="이 배너를 노출할 브랜드 리스트")
    pc_image = graphene.Field(Image, size=graphene.Int(description="Size of the image."))
    mobile_image = graphene.Field(Image, size=graphene.Int(description="Size of the image."))

    class Meta:
        description = "배너 링크 정보"
        interfaces = [relay.Node]
        model = models.Banner
        only_fields = [
            "id",
            "name",
            "description",
            "link_url",
            "start",
            "end",
            "visible_to_brand",
            "updated_at",
            "available_to_all_brands",
        ]

    @staticmethod
    def resolve_available_brands(root: models.Banner, info, **_kwargs):
        return (
            BrandsByBannerIdLoader(info.context)
            .load(root.id)
            .then(
                # name으로 ordering
                lambda brands: sorted(brands, key=lambda brand: brand.name)
            )
        )

    @staticmethod
    def resolve_pc_image(root: models.Banner, info, size=None, **_kwargs):
        return Image.get_adjusted(
            image=root.pc_image,
            alt="banner-image-pc",
            size=size,
            rendition_key_set="banner_images",
            info=info,
        )

    @staticmethod
    def resolve_mobile_image(root: models.Banner, info, size=None, **_kwargs):
        return Image.get_adjusted(
            image=root.mobile_image,
            alt="banner-image-mobile",
            size=size,
            rendition_key_set="banner_images",
            info=info,
        )


class Popup(CountableDjangoObjectType):
    available_brands = graphene.List(Brand, description="이 팝업을 노출할 브랜드 리스트")
    pc_image = graphene.Field(Image, size=graphene.Int(description="Size of the image."))
    mobile_image = graphene.Field(Image, size=graphene.Int(description="Size of the image."))
    notice = graphene.Field(Notice, description="이 팝업과 연결된 공지사항")

    class Meta:
        description = "팝업 링크 정보"
        interfaces = [relay.Node]
        model = models.Popup
        only_fields = [
            "id",
            "name",
