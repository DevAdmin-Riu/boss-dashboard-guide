from typing import TYPE_CHECKING

from django.conf import settings
from django.core.validators import MinValueValidator
from django.db import models, transaction
from django.db.models import Q

from ..points import (
    CreditsEventType,
    CreditsEventViewMode,
    DigitalContractCountEventType,
    PaidNoticeCountEventType,
    RcoinsEventType,
)

if TYPE_CHECKING:
    from ..account.models import User


# DB 트리거로 레코드 삽입될 수 있는 모델이므로 모델명, 필드명 변경 시 트리거도 수정해야 함 (after_vacs_notification)
class CreditsEvent(models.Model):
    created = models.DateTimeField(auto_now_add=True)
    description = models.CharField(max_length=100)
    total_before = models.IntegerField(null=False, default=0)
    total_after = models.IntegerField(null=False, default=0)
    qty_before = models.IntegerField(null=False)
    qty_after = models.IntegerField(null=False)
    qty = models.IntegerField(null=False, validators=[MinValueValidator(1)])
    type = models.CharField(null=False, choices=CreditsEventType.choices, max_length=100)
    is_cashable = models.BooleanField(default=True, blank=True)
    view_mode = models.CharField(
        choices=CreditsEventViewMode.choices, max_length=100, default=CreditsEventViewMode.ALL
    )
    user: "User" = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        blank=True,
        null=True,
        related_name="credits_events",
        on_delete=models.SET_NULL,
    )
    staff: "User" = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        blank=True,
        null=True,
        related_name="proc_credits_events",
        on_delete=models.SET_NULL,
    )

    def __str__(self):
        return self.description

    class Meta:
        ordering = ("-pk",)


class RcoinsEvent(models.Model):
