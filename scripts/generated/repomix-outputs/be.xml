        if "inner_base_sell_price_exclude_vat" in cleaned_input:
            inner_variant.base_sell_price_exclude_vat = cleaned_input.get(
                "inner_base_sell_price_exclude_vat"
            )
            update_fields.append("base_sell_price_exclude_vat")
        if "inner_base_sell_price_set_date" in cleaned_input:
