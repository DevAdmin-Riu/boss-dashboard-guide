from dataclasses import dataclass
from typing import TYPE_CHECKING, Iterable, Optional

import opentracing
from prices import Money, MoneyRange, TaxedMoney, TaxedMoneyRange

from ... import settings
from ...core.taxes import zero_money
from ...plugins.manager import get_plugins_manager
from ..models import BrandProduct, Product, ProductVariant
from .brand_products_variant import (
    get_brand_product_variant_by_brand_product,
    get_brand_product_variant_region_by_brand_product,
    get_product_variant_region,
    get_user_product_variant,
)

if TYPE_CHECKING:
    # flake8: noqa
    from ...account.models import User
    from ...plugins.manager import PluginsManager


@dataclass
class ProductAvailability:
    on_sale: bool
    price_range: Optional[TaxedMoneyRange]


@dataclass
class ProductAvailabilityCostPrice:
    cost_price_range: Optional[MoneyRange]


@dataclass
class ProductAvailabilityDeliveryFee:
    delivery_fee_range: Optional[MoneyRange]


@dataclass
class VariantAvailability:
    on_sale: bool
    price: TaxedMoney


@dataclass
class VariantAvailabilityDeliverFee:
    delivery_fee: Money


def get_product_price_range(
    *,
    variants: Iterable[ProductVariant],
) -> Optional[MoneyRange]:
    with opentracing.global_tracer().start_active_span("get_product_price_range"):
        if variants:
            prices = [variant.get_price() for variant in variants]
            return MoneyRange(min(prices), max(prices))

        return None


def get_product_availability(
    *,
    variants: Iterable[ProductVariant],
    plugins: Optional["PluginsManager"] = None,
    user: Optional["User"] = None,
    brand_product: Optional[BrandProduct] = None,
) -> ProductAvailability:
    with opentracing.global_tracer().start_active_span("get_product_availability"):
        if not plugins:
            plugins = get_plugins_manager()

        region = user.region
        if brand_product is None:
            for variant in variants:
                if variant.product.is_direct_shipping:
                    variant_region = get_product_variant_region(variant=variant, region=region)
                    variant.price = (
                        variant_region.get_price()
                        if variant_region
                        else zero_money(settings.DEFAULT_CURRENCY)
                    )
        else:
            if brand_product.product.is_direct_shipping:
                for variant in variants:
                    brand_product_variant_region = (
                        get_brand_product_variant_region_by_brand_product(
                            variant=variant, brand_product=brand_product, region=region
                        )
                    )
                    variant.price = (
                        brand_product_variant_region.get_price()
                        if brand_product_variant_region
                        else zero_money(settings.DEFAULT_CURRENCY)
                    )
            else:
                for variant in variants:
                    brand_product_variant = get_brand_product_variant_by_brand_product(
                        brand_product=brand_product, variant=variant
                    )
                    variant.price = (
                        brand_product_variant.get_price() if brand_product_variant else 0
                    )

        taxed_price_range = None
        price_range = get_product_price_range(variants=variants)
        if price_range is not None:
            taxed_price_range = TaxedMoneyRange(
                start=plugins.apply_taxes_to_product(price_range.start),
                stop=plugins.apply_taxes_to_product(price_range.stop),
            )

        return ProductAvailability(
            on_sale=False,
            price_range=taxed_price_range,
        )


def get_product_delivery_fee_range(
    *,
    variants: Iterable[ProductVariant],
) -> Optional[MoneyRange]:
    if variants:

        def exclude_none(x):
            return x.delivery_fee != None

        def get_delivery_fee(x):
            return x.delivery_fee

        filteredVariants = list(filter(exclude_none, variants))
        delivery_fees = list(map(get_delivery_fee, filteredVariants))
        if len(delivery_fees) > 0:
            return MoneyRange(min(delivery_fees), max(delivery_fees))

    return None


def get_product_availability_delivery_fee(
    *,
    variants: Iterable[ProductVariant],
    user: Optional["User"] = None,
    brand_product: Optional[BrandProduct] = None,
) -> ProductAvailability:
    region = user.region
    if brand_product is None:
        for variant in variants:
            if variant.product.is_direct_shipping:
                variant_region = get_product_variant_region(variant=variant, region=region)
                variant.delivery_fee = (
                    variant_region.get_delivery_fee()
                    if variant_region
                    else zero_money(settings.DEFAULT_CURRENCY)
                )
            # 브랜드 판매가 아니고 직배송 제품이 아닌 경우, 실제 판매 시 배송비는 재고 제품 출고인지, 위탁 제품 출고인지에 따라 달라짐
            # 고객에게 배송비 팩터를 보여줄 경우 이슈가 될 수 있으므로 다른 구조 필요
    else:
        if brand_product.product.is_direct_shipping:
            for variant in variants:
                brand_product_variant_region = get_brand_product_variant_region_by_brand_product(
                    variant=variant, brand_product=brand_product, region=region
                )
                variant.delivery_fee = (
                    brand_product_variant_region.get_delivery_fee()
                    if brand_product_variant_region
                    else zero_money(settings.DEFAULT_CURRENCY)
                )
        else:
            for variant in variants:
                brand_product_variant = get_brand_product_variant_by_brand_product(
                    brand_product=brand_product, variant=variant
                )
                variant.delivery_fee = (
                    brand_product_variant.get_delivery_fee()
                    if brand_product_variant
                    else zero_money(settings.DEFAULT_CURRENCY)
                )

    delivery_fee = get_product_delivery_fee_range(
        variants=variants,
    )

    return ProductAvailabilityDeliveryFee(
        delivery_fee_range=delivery_fee,
    )


def get_variant_availability_cost_price(
    variant: ProductVariant,
    user: Optional["User"] = None,
) -> Money:
    user_product_variant = get_user_product_variant(variant, user, raise_exception=False)
    return user_product_variant.cost_price_exclude_vat if user_product_variant else None


def get_variant_availability_ds_lead_time(
    variant: ProductVariant,
    product: Product,
    user: Optional["User"] = None,
):
    if product.is_direct_shipping:
        user_product_variant = get_product_variant_region(variant=variant, region=user.region)
        return user_product_variant.lead_time if user_product_variant else 0
    return 0


def get_variant_availability_disabled_days(
    variant: ProductVariant,
    product: Product,
    user: Optional["User"] = None,
):
    if product.is_direct_shipping:
        user_product_variant = get_product_variant_region(variant=variant, region=user.region)
        return user_product_variant.disabled_days if user_product_variant else {}
    return {}
