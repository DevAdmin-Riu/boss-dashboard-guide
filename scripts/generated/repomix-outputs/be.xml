class TaxInvoiceQueries(graphene.ObjectType):
    tax_invoice_list = FilterInputConnectionField(
        TaxInvoice,
        filter=TaxInvoiceFilterInput(description="Filtering options for TaxInvoices."),
        description="List of TaxInvoices.",
    )
    tax_invoice = graphene.Field(
        TaxInvoice,
        id=graphene.Argument(graphene.ID, description="ID of the tax invoice.", required=True),
        description="Look up a tax invoice by ID.",
    )
    tax_invoice_url = graphene.String(
        id=graphene.Argument(graphene.ID, description="ID of the tax invoice.", required=True),
        description="Look up a tax invoice by ID and retrieve the URL.",
    )

    def resolve_tax_invoice_url(self, info, id):
        tax_invoice = graphene.Node.get_node_from_global_id(info, id, TaxInvoice)
        if tax_invoice is None or tax_invoice.status != TaxInvoiceStatus.ISSUED:
            return None
        url = info.context.plugins.tax_invoice_get_url(tax_invoice)
        return url

    def resolve_tax_invoice_list(self, info, **_kwargs):
        qs = (
            models.TaxInvoice.objects.select_related("order", "order__user", "order__user__brand")
            .all()
            .distinct()
        )
        return qs

    def resolve_tax_invoice(self, info, id):
        return graphene.Node.get_node_from_global_id(info, id, TaxInvoice)


