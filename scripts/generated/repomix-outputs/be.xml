def _send_email_in_case_no_track_inventory_with_etc_delivery(
    order_lines: List["OrderLine"], checkout: "Checkout", order_composed_id_with_prefix
):
    user: "User" = checkout.user
    user_id = "-"
    brand_name = "-"
    contact_no = "-"
    brand = None
    if user:
        user_id = user.login_id
        brand = user.brand
        brand_name = user.brand.name
        contact_no = format_as_hypenated_phone_number(user.aligo_phone) or "-"

    # order_lines를 이용해서 sku와 quantity를 키로하는 딕셔너리 리스트를 만든다.
    infos = []
    for order_line in order_lines:
        variant: ProductVariant = order_line.variant
        product = variant.product

        default_variant_vendor = (
            (
                ProductVariantVendor.objects.filter(id=variant.default_variant_vendor_id)
                .select_related("vendor")
                .first()
            )
            if variant.default_variant_vendor_id is not None
            else None
        )
        vendor = (
            default_variant_vendor.vendor if variant.default_variant_vendor_id is not None else None
        )

        # 주문번호
        order_no = order_composed_id_with_prefix
        # 브랜드코드
        brand_code = brand.code if brand is not None else "-"
        # 브랜드명
        brand_name = brand.name if brand is not None else "-"
        # 매장명
        user_first_name = user.first_name if user is not None else "-"
        # 주소
        address_str = f"{checkout.shipping_address.street_address_1} {checkout.shipping_address.street_address_2}"
        # 연락처
        contact_no = contact_no
        # 제품코드
        sku = variant.sku
        # 제품명
        product_name = product.name
        # 규격
        spec_text = make_product_spec_text_by_attribute(convert_to_simple_attribute(variant))
        # 입수량
        qty_per_box_with_unit_type = f"{int(variant.qty_per_box):,}{variant.qty_per_box_unit_type}"
        # 협력사명
        vendor_name_with_code = f"{vendor.code}: {vendor.name}" if vendor is not None else "-"
        # 협력사 상품 ID
        external_sku = (
            default_variant_vendor.external_sku if default_variant_vendor is not None else "-"
        )
        # 협력사 상품명
        external_product_name = (
            default_variant_vendor.external_product_name
            if default_variant_vendor is not None
            else "-"
        )

        # 주문수량
        quantity = to_locale_number(order_line.quantity)
        # 제품메모
        note = variant.note if variant.note else "-"
        infos.append(
            {
                "order_no": order_no,
                "brand_code": brand_code,
                "brand_name": brand_name,
                "user_first_name": user_first_name,
                "address_str": address_str,
                "contact_no": contact_no,
                "sku": sku,
                "product_name": product_name,
                "spec_text": spec_text,
                "qty_per_box_with_unit_type": qty_per_box_with_unit_type,
                "vendor_name_with_code": vendor_name_with_code,
                "external_sku": external_sku,
                "external_product_name": external_product_name,
                "quantity": quantity,
                "note": note,
            }
        )

    transaction.on_commit(
        lambda infos=infos, order_id=order_composed_id_with_prefix, user_id=user_id, brand_name=brand_name: send_email_in_case_no_track_inventory_with_etc_delivery.delay(
            infos=infos,
            order_id=order_id,
            user_id=user_id,
            brand_name=brand_name,
        )
    )


def _send_email_in_case_etc_delivery_order_maded(
    checkout: "Checkout",
    order_composed_id_with_prefix,
    estimated_arrival_date,
):
    user = checkout.user
    user_id = "-"
    brand_name = "-"
    if user:
        user_id = user.login_id
        brand = user.brand
        brand_name = user.brand.name
        staff_email = brand.staff.email if brand.staff else None
    estimated_arrival_date_str = (
        estimated_arrival_date.strftime("%Y-%m-%d") if estimated_arrival_date else "상관없음"
    )

    fulfill_type = checkout.fulfill_type
    context = {
        "order_id": order_composed_id_with_prefix,
        "estimated_arrival_date": estimated_arrival_date_str,
        "user_id": user_id,
        "brand_name": brand_name,
        "fulfill_type": term_of_fulfill_type(fulfill_type),
    }
    transaction.on_commit(
        lambda staff_email=staff_email, fulfill_type=fulfill_type, context=context: send_email_in_case_etc_delivery_order_maded.delay(
            staff_email=staff_email,
            fulfill_type=fulfill_type,
            context=context,
        )
    )


# 통합공급망 상품에는 세트 상품 고려 안함
def _create_order_line_fulfilled_by_vendor(
    *,
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    payment: "Payment",
    checkout_subtotal_amount: Decimal,
    brand_payment_values: BrandPaymentValues,
) -> OrderLine:
    variant, variant_region, bp_bundle = base_calculations.get_product_variant_info(
        checkout, line=checkout_line
    )
    if bp_bundle is not None:
        raise ValidationError("상품 정보 오류: 통합공급망 제품은 세트 상품을 취급하지 않습니다.")

    product = variant.product

    is_tax_free = product.is_tax_free
    product_name = str(product)
    variant_name = str(variant)

    checkout_line_qty = checkout_line.quantity
    country = checkout_line.checkout.get_country()
    delivery_method = checkout.delivery_method

    calc_mileage = checkout_line.calc_mileage
    exclude_stock_avg_stats = checkout_line.exclude_stock_avg_stats
    decrease_stock_flag = checkout_line.decrease_stock_flag
    etc_delivery_fee = checkout_line.etc_delivery_fee
    bpv: BrandProductVariant = checkout_line.brand_product_variant

    if brand_payment_values:
        brand: "Brand" = checkout.user.brand if checkout.user else None
        brand_payment_values.card_paying_charge_rate = (
            brand.fbv_card_paying_charge_rate if brand else Decimal(0)
        )
        brand_payment_values.vbank_paying_charge_exclude_vat = (
            brand.fbv_vbank_paying_charge_exclude_vat if brand else Decimal(0)
        )

    if (
        variant.track_inventory
        and decrease_stock_flag
        and delivery_method == OrderDeliveryMethods.BY_COURIER
    ):
        orderable_quantity = get_orderable_qty(variant, country, until_short_term=True)
        check_stock_quantity_by_orderable_qty(
            variant,
            orderable_quantity,
            checkout_line_qty,
            bp_name=bpv.brand_product.name if bpv else None,
        )

    unit_price_amount = base_calculations.checkout_line_unit_price(checkout, checkout_line)
    unit_price_vat = base_calculations.checkout_line_unit_price_vat(checkout, checkout_line)

    (brand, brand_product, bpv, _brand_product_variant_region, _bp_bundle) = (
        base_calculations.get_brand_product_info(checkout, line=checkout_line)
    )

    # 브랜드 상품에 이름 설정이 된 경우, 상품명을 brandproduct.name 으로 대체
    if brand and brand_product and brand_product.name:
        product_name = brand_product.name

    if bpv:
        brand_unit_cost_price = bpv.get_cost_price(is_tax_free)
    else:
        brand_unit_cost_price = None

    # 기타 배송비 포함 line 상품가 총액
    manager = get_plugins_manager()
    line_total_amount = manager.calculate_checkout_line_total_decimal(checkout, checkout_line)

    # 충전금, 포인트인 경우
    line_total_amount_mul_rate = line_total_amount
    # 카드결제인경우
    if is_card_pay(payment.token):
        line_total_amount_mul_rate = (
            line_total_amount * brand_payment_values.card_paying_charge_rate
        )
    # 가상계좌인 경우
    elif is_vbank_pay(payment.token):
        line_total_amount_mul_rate = (
            line_total_amount * brand_payment_values.vbank_paying_charge_exclude_vat
        )

    # 오픈몰의 경우 brand_payment_values 값이 없음.
    line_price_mul_charge_rate_sum = (
        brand_payment_values.line_price_mul_charge_rate_sum if brand_payment_values else 0
    )

    order_line_payment_values = calc_order_line_payment_values(
        payment=payment,
        brand_payment_values=brand_payment_values,
        line_price_mul_charge_rate_sum=line_price_mul_charge_rate_sum,
        line_price_mul_charge_rate=line_total_amount_mul_rate,
        checkout_subtotal_amount=checkout_subtotal_amount,
        line_total_amount=line_total_amount,
    )

    vendor = checkout_line.vendor
    delivery_request_date = checkout_line.delivery_request_date

    line = OrderLine(
        product_name=product_name,
        variant_name=variant_name,
        product_sku=variant.sku,
        # 통합공급망 출고 유형은 배송방식 택배 아님인 경우 모두 재고로, 모두 위탁으로 출고 선택의 적용을 받지 않음
        # 재고 제품은 재고관리를 위해 재고 출고, 위탁 제품은 위탁 출고로 다룸
        track_inventory=variant.track_inventory,
        quantity=checkout_line_qty,
        bundle_qty=checkout_line_qty,
        variant=variant,
        unit_price_gross_amount=unit_price_amount,
        unit_price_vat=unit_price_vat,
        brand_unit_cost_price=brand_unit_cost_price,
        **vars(order_line_payment_values),
        mileage_exclude_vat=Decimal(0),
        is_tax_free=is_tax_free,
        is_converted=True,
        calc_mileage=calc_mileage,
        exclude_stock_avg_stats=exclude_stock_avg_stats,
        decrease_stock_flag=decrease_stock_flag,
        etc_delivery_fee=etc_delivery_fee,
        brand_product_variant=bpv,
        is_fulfilled_by_vendor=True,
        vendor=vendor,
        delivery_request_date=delivery_request_date,
        card_paying_charge_rate=(
            brand_payment_values.card_paying_charge_rate if brand_payment_values else Decimal(0)
        ),
        vbank_paying_charge_exclude_vat=(
            brand_payment_values.vbank_paying_charge_exclude_vat
            if brand_payment_values
            else Decimal(0)
        ),
    )

    return [line]


def _get_order_line_product_name(
    product: "Product",
    brand: "Brand",
    bp_bundle: "BpBundle",
    bp: "BrandProduct",
):
    product_name = str(product)
    if not brand:
        return product_name
    if bp_bundle:
        return bp_bundle.name
    elif bp and bp.name:
        return bp.name
    return product_name


def _get_brand_usit_cost_price(
    product: "Product",
    checkout_line: "CheckoutLine",
    bp_bundle: "BpBundle",
    is_main_pv: bool,
    bpv: "BrandProductVariant",
    bpv_region: "BrandProductVariantRegion",
    currency,
):
    is_tax_free = product.is_tax_free
    if bp_bundle:
        brand_unit_cost_price_amount = (
            calc_to_include_vat(bp_bundle.cost_price_exclude_vat, is_tax_free)
            if is_main_pv
            else Decimal(0)
        )
        brand_unit_delivery_fee_amount = bp_bundle.delivery_fee_amount if is_main_pv else Decimal(0)
        brand_unit_cost_price = Money(brand_unit_cost_price_amount, currency)
        brand_unit_delivery_fee = Money(brand_unit_delivery_fee_amount, currency)
    else:
        delivery_request_date = checkout_line.delivery_request_date
        if bpv_region:
            brand_unit_cost_price = bpv_region.get_cost_price(is_tax_free, delivery_request_date)
            brand_unit_delivery_fee = bpv_region.get_delivery_fee(delivery_request_date)
        elif bpv:
            brand_unit_cost_price = bpv.get_cost_price(is_tax_free, delivery_request_date)
            brand_unit_delivery_fee = bpv.get_delivery_fee(delivery_request_date)
        else:
            brand_unit_cost_price = zero_money(currency)
            brand_unit_delivery_fee = zero_money(currency)

    return brand_unit_cost_price, brand_unit_delivery_fee


def _get_brand_total_cost_price(
    brand_unit_cost_price: Money,
    brand_unit_delivery_fee: Money,
    variant: "ProductVariant",
    order_qty_consider_bundle,
):
    brand_total_cost_price_amount = quantize_krw(
        brand_unit_cost_price.amount * order_qty_consider_bundle
    )
    box_count = get_delivery_box_count_consider_adjust_price_pv(variant, order_qty_consider_bundle)
    brand_total_delivery_fee_amount = quantize_krw(brand_unit_delivery_fee.amount * box_count)

    return brand_total_cost_price_amount, brand_total_delivery_fee_amount


def _create_order_line_consider_bundle_and_sibling(
    *,
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    payment: "Payment",
    checkout_subtotal_amount: Decimal,
    brand_payment_values: BrandPaymentValues,
    variant: "ProductVariant",
    variant_region: "ProductVariantRegion",
    order_line_track_inventory: bool,
    qty_to_be_fulfilled,
) -> OrderLine:

    currency = checkout.currency
    delivery_method = checkout.delivery_method
    is_b2b_order_type = checkout.order_type in [
        OrderType.BY_STAFF_FOR_B2B,
        OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
    ]

    checkout_line_qty = checkout_line.quantity
    calc_mileage = checkout_line.calc_mileage
    exclude_stock_avg_stats = checkout_line.exclude_stock_avg_stats
    decrease_stock_flag = checkout_line.decrease_stock_flag
    etc_delivery_fee = checkout_line.etc_delivery_fee
    b2b_delivery_fee_exclude_vat = checkout_line.b2b_delivery_fee_exclude_vat
    brand_product_package = checkout_line.brand_product_package

    product = variant.product
    is_tax_free = product.is_tax_free
    variant_name = str(variant)

    (
        brand,
        bp,
        bpv,
        bpv_region,
        bp_bundle,
    ) = base_calculations.get_brand_product_info(checkout, line=checkout_line)

    if not bp_bundle:
        is_main_pv = True
    else:
        main_pv = bp_bundle.main_pv
        if main_pv is None:
            raise ValidationError("세트 상품 대표 구성품 설정 오류")
        is_main_pv = main_pv.pk == variant.pk

    # 세트 상품은 대표 구성품에 대해서만 가격 관리하고 대표가 아닌 구성품은 가격 0 처리
    unit_price_amount = base_calculations.checkout_line_unit_price(
        checkout, checkout_line, is_main_pv
    )
    unit_price_vat = base_calculations.checkout_line_unit_price_vat(
        checkout, checkout_line, is_main_pv
    )

    is_picking_order = variant.outer is not None
    if is_picking_order:
        box_size = get_box_size_from_box_spec_for_picking_order()
    else:
        box_size = get_box_size_from_variant_for_checkout_complete(
            variant, brand, checkout, payment, order_line_track_inventory
        )

    product_name = _get_order_line_product_name(product, brand, bp_bundle, bp)

    delivery_request_date = checkout_line.delivery_request_date

    qty_for_brand_cost_consider_bundle_main_pv = qty_to_be_fulfilled
    if bp_bundle:
        qty_for_brand_cost_consider_bundle_main_pv = checkout_line_qty if is_main_pv else 0

    brand_unit_cost_price, brand_unit_delivery_fee = _get_brand_usit_cost_price(
        product, checkout_line, bp_bundle, is_main_pv, bpv, bpv_region, currency
    )
    brand_total_cost_price_amount, brand_total_delivery_fee_amount = _get_brand_total_cost_price(
        brand_unit_cost_price,
        brand_unit_delivery_fee,
        variant,
        qty_for_brand_cost_consider_bundle_main_pv,
    )

    # 택배 배송이 아닌 화물차, 퀵, 직접 배송, 고객 수령 일 때는 배송비 0원으로
    if delivery_method != OrderDeliveryMethods.BY_COURIER:
        unit_delivery_fee = zero_money(currency)
    else:
        if variant_region:
            unit_delivery_fee = variant_region.get_delivery_fee(delivery_request_date)
        else:
            if order_line_track_inventory:
                unit_delivery_fee = variant.get_delivery_fee(delivery_request_date)
            else:
                unit_delivery_fee = variant.get_consignment_delivery_fee()
        unit_delivery_fee = unit_delivery_fee or zero_money(currency)

    unit_inner_incidental_cost_amount = variant.inner_incidental_cost_amount or Decimal(0)

    # 기타 배송비 포함 line 상품가 총액
    manager = get_plugins_manager()
    line_total_amount = manager.calculate_checkout_line_total_decimal(
        checkout, checkout_line, qty_for_brand_cost_consider_bundle_main_pv
    )

    # 충전금, 포인트인 경우
    line_total_amount_mul_rate = line_total_amount
    # 카드결제인경우
    if is_card_pay(payment.token):
        line_total_amount_mul_rate = (
            line_total_amount * brand_payment_values.card_paying_charge_rate
        )
    # 가상계좌인 경우
    elif is_vbank_pay(payment.token):
        line_total_amount_mul_rate = (
            line_total_amount * brand_payment_values.vbank_paying_charge_exclude_vat
        )

    # 오픈몰의 경우 brand_payment_values 값이 없음.
    line_price_mul_charge_rate_sum = (
        brand_payment_values.line_price_mul_charge_rate_sum if brand_payment_values else 0
    )

    order_line_payment_values = calc_order_line_payment_values(
        payment=payment,
        brand_payment_values=brand_payment_values,
        line_price_mul_charge_rate_sum=line_price_mul_charge_rate_sum,
        line_price_mul_charge_rate=line_total_amount_mul_rate,
        checkout_subtotal_amount=checkout_subtotal_amount,
        line_total_amount=line_total_amount,
    )

    mileage_exclude_vat = (
        calc_order_line_mileage_exclude_vat(
            # etc_delivery_fee는 mileage계산시 고려되면 안된다.
            total_price=line_total_amount - etc_delivery_fee,
            captured_rcoins=order_line_payment_values.rcoins,
            brand_total_cost_price=brand_total_cost_price_amount,
            brand_total_delivery_fee=brand_total_delivery_fee_amount,
            brand_paying_charge_exclude_vat=order_line_payment_values.brand_paying_charge_exclude_vat,
            # 본부수익금 적용 여부가 False 면 mileate_rate 를 0% 로 처리해서 본부수익금을 0원으로 만든다.
            mileage_rate=(brand_payment_values.mileage_rate if calc_mileage else Decimal(0)),
            is_tax_free=is_tax_free,
        )
        if brand_payment_values
        else 0
    )

    create_order_line = OrderLine(
        b2b_status=OrderLineB2bStatus.PENDING if is_b2b_order_type else OrderLineB2bStatus.NA,
        product_name=product_name,
        variant_name=variant_name,
        box_size=box_size,
        product_sku=variant.sku,
        track_inventory=order_line_track_inventory,
        quantity=qty_to_be_fulfilled,
        bundle_qty=checkout_line_qty,
        variant=variant,
        unit_price_gross_amount=unit_price_amount,
        unit_price_vat=unit_price_vat,
        unit_delivery_fee=unit_delivery_fee,
        unit_inner_incidental_cost_amount=unit_inner_incidental_cost_amount,
        brand_unit_cost_price=brand_unit_cost_price,
        brand_unit_delivery_fee=brand_unit_delivery_fee,
        **vars(order_line_payment_values),
        mileage_exclude_vat=mileage_exclude_vat,
        is_tax_free=is_tax_free,
        # 신규 생성 주문은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
        is_converted=True,
        calc_mileage=calc_mileage,
        exclude_stock_avg_stats=exclude_stock_avg_stats,
        decrease_stock_flag=decrease_stock_flag,
        etc_delivery_fee=etc_delivery_fee,
        b2b_delivery_fee_exclude_vat=b2b_delivery_fee_exclude_vat,
        is_picking_order=is_picking_order,
        inner_pack_count=calc_pack_count(variant, variant.outer),
        bp_bundle=bp_bundle,
        is_main_pv=is_main_pv,
        brand_product_package=brand_product_package,
        brand_product_variant=bpv,
        # brand가 없는 경우 brand_payment_values가 없음.(오픈몰의 경우)
        mileage_rate=(brand_payment_values.mileage_rate if brand_payment_values else Decimal(0)),
        card_paying_charge_rate=(
            brand_payment_values.card_paying_charge_rate if brand_payment_values else Decimal(0)
        ),
        vbank_paying_charge_exclude_vat=(
            brand_payment_values.vbank_paying_charge_exclude_vat
            if brand_payment_values
            else Decimal(0)
        ),
    )
    return create_order_line


def _reset_brand_payment_values_consider_bp_bundle(
    bp_bundle: "BpBundle", bpv: "BrandProductVariant", brand_payment_values: "BrandPaymentValues"
):
    # 보스장터에는 세트 상품 고려 안함
    if bp_bundle:
        return
    # bpv가 존재하는 경우 해당 brand를 사용하여 brand_payment_values 업데이트한다.
    if not bp_bundle and brand_payment_values and bpv and bpv.brand:
        bpv_brand: Brand = bpv.brand
        brand_payment_values.mileage_rate = (
            bpv.mileage_rate if bpv.mileage_rate is not None else bpv_brand.mileage_rate
        )
        brand_payment_values.card_paying_charge_rate = bpv_brand.card_paying_charge_rate
        brand_payment_values.vbank_paying_charge_exclude_vat = (
            bpv_brand.vbank_paying_charge_exclude_vat
        )


def _check_stock_quantity_consider_bp_bundle(
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    pv_list: List["ProductVariant"],
    pv_qty_list: List[Decimal],
    orderable_qty_list: List[Decimal],
    bp_name: str,
):
    if not checkout_line.decrease_stock_flag:
        return
    if checkout.delivery_method != OrderDeliveryMethods.BY_COURIER:
        return

    for pv, pv_qty, orderable_quantity in zip(pv_list, pv_qty_list, orderable_qty_list):
        check_stock_quantity_by_orderable_qty(pv, orderable_quantity, pv_qty, bp_name=bp_name)


def _create_order_line_for_bp_bundle(
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    payment: "Payment",
    checkout_subtotal_amount: Decimal,
    brand_payment_values: "BrandPaymentValues",
    pv_list: List["ProductVariant"],
    pv_qty_list: List[Decimal],
):
    # 세트 상품은 재고 택배로만 출고
    order_line_track_inventory = True

    create_order_lines = []
    for pv, pv_qty in zip(pv_list, pv_qty_list):
        _order_line = _create_order_line_consider_bundle_and_sibling(
            checkout=checkout,
            checkout_line=checkout_line,
            payment=payment,
            checkout_subtotal_amount=checkout_subtotal_amount,
            brand_payment_values=brand_payment_values,
            variant=pv,
            variant_region=None,
            order_line_track_inventory=order_line_track_inventory,
            qty_to_be_fulfilled=pv_qty,
        )
        create_order_lines.append(_order_line)
    return create_order_lines


def _create_order_line_for_non_bp_bundle(
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    payment: "Payment",
    checkout_subtotal_amount: Decimal,
    brand_payment_values: "BrandPaymentValues",
    pv: "ProductVariant",
    pv_region: "ProductVariantRegion",
    orderable_qty: Decimal,
):
    checkout_line_qty = checkout_line.quantity
    delivery_method = checkout.delivery_method

    is_b2b_order_type = checkout.order_type in [
        OrderType.BY_STAFF_FOR_B2B,
        OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
    ]
    is_by_staff_for_brand_order_type = checkout.order_type in [
        OrderType.BY_STAFF_FOR_BRAND,
    ]

    big_brother_order_line_qty = checkout_line_qty
    sibling_order_line_qty = 0
    # B2B 주문: 화물차 배송이고, 위탁으로 출고 처리함
    if is_b2b_order_type:
        order_line_track_inventory = False
    # 택배가 아닌 대행 주문의 출고 유형은 모두 재고로, 또는 모두 위탁으로 중 입력된 방식으로 결정함
    elif is_by_staff_for_brand_order_type and delivery_method != OrderDeliveryMethods.BY_COURIER:
        fulfill_type = checkout.fulfill_type
        if fulfill_type == FulfillType.ALL_TRACK_INVENTORY:
            order_line_track_inventory = True
        elif fulfill_type == FulfillType.ALL_CONSIGNMENT:
            order_line_track_inventory = False
        else:
            raise ValidationError("택배 배송이 아닌 대행 주문에 출고 유형이 잘못되었습니다.")
    else:
        # 자동 위탁 변경 재고상품인 경우 수량이 부족하면 해당 order_line 은 위탁 주문으로 처리
        # 위탁 제품인데 주문 수량 이상의 available_quantity 가 존재하면 재고 주문으로 처리
        order_line_track_inventory = pv.track_inventory
        if order_line_track_inventory:
            if pv.allow_auto_consignment and checkout_line_qty > orderable_qty:
                if orderable_qty <= 0:
                    order_line_track_inventory = False
                else:
                    big_brother_order_line_qty = orderable_qty
                    sibling_order_line_qty = checkout_line_qty - big_brother_order_line_qty
        else:
            if checkout_line_qty <= orderable_qty:
                order_line_track_inventory = True

    create_order_lines = []
    big_brother_order_line = _create_order_line_consider_bundle_and_sibling(
        checkout=checkout,
        checkout_line=checkout_line,
        payment=payment,
        checkout_subtotal_amount=checkout_subtotal_amount,
        brand_payment_values=brand_payment_values,
        variant=pv,
        variant_region=pv_region,
        order_line_track_inventory=order_line_track_inventory,
        qty_to_be_fulfilled=big_brother_order_line_qty,
    )
    create_order_lines.append(big_brother_order_line)
    if sibling_order_line_qty > 0:
        sibling_order_line = _create_order_line_consider_bundle_and_sibling(
            checkout=checkout,
            checkout_line=checkout_line,
            payment=payment,
            checkout_subtotal_amount=checkout_subtotal_amount,
            brand_payment_values=brand_payment_values,
            variant=pv,
            variant_region=pv_region,
            order_line_track_inventory=False,
            qty_to_be_fulfilled=sibling_order_line_qty,
        )
        create_order_lines.append(sibling_order_line)
    return create_order_lines


def _create_order_line(
    *,
    checkout: "Checkout",
    checkout_line: "CheckoutLine",
    payment: "Payment",
    checkout_subtotal_amount: Decimal,
    brand_payment_values: "BrandPaymentValues",
) -> List[OrderLine]:
    """Create a line for the given order.

    :raises InsufficientStock: when there is not enough items in stock for this variant.
    """

    pv, variant_region, bp_bundle = base_calculations.get_product_variant_info(
        checkout, line=checkout_line
    )

    checkout_line_qty = checkout_line.quantity
    country = checkout_line.checkout.get_country()

    bp_bundle: BpBundle = checkout_line.bp_bundle
    bpv: BrandProductVariant = checkout_line.brand_product_variant
    _reset_brand_payment_values_consider_bp_bundle(bp_bundle, bpv, brand_payment_values)
    pv_list = []
    pv_qty_list = []
    if bp_bundle:
        bp_name = bp_bundle.name
        bp_bundle_infos = bp_bundle.bp_bunde_infos_by_prefetched
        pv_list = [info.pv for info in bp_bundle_infos]
        pv_qty_list = [info.quantity * checkout_line_qty for info in bp_bundle_infos]
    else:
        bp_name = bpv.brand_product.name if bpv else None
        pv_list = [pv]
        pv_qty_list = [checkout_line_qty]

    orderable_qty_list = []
    for pv in pv_list:
        orderable_quantity = get_orderable_qty(pv, country, until_short_term=True)
        orderable_qty_list.append(orderable_quantity)

    _check_stock_quantity_consider_bp_bundle(
        checkout,
        checkout_line,
        pv_list,
        pv_qty_list,
        orderable_qty_list,
        bp_name,
    )

    if bp_bundle:
        return _create_order_line_for_bp_bundle(
            checkout,
            checkout_line,
            payment,
            checkout_subtotal_amount,
            brand_payment_values,
            pv_list,
            pv_qty_list,
        )
    return _create_order_line_for_non_bp_bundle(
        checkout,
        checkout_line,
        payment,
        checkout_subtotal_amount,
        brand_payment_values,
        pv=pv_list[0],
        pv_region=variant_region,
        orderable_qty=orderable_qty_list[0],
    )


def _prepare_order_data(
    *,
    checkout: "Checkout",
    lines: List["CheckoutLine"],
    payment: "Payment",
    creator_user: "User" = None
) -> dict:
    """Run checks and return all the data from a given checkout to create an order.

    :raises InsufficientStock:
    """
    order_data = {}

    manager = get_plugins_manager()
    checkout_subtotal = manager.calculate_checkout_subtotal(
        checkout, lines, mode=CalcCheckoutTotalMode.ALL
    )
    checkout_subtotal_amount = checkout_subtotal.gross.amount
    checkout_subtotal_delivery_additional_fee = (
        manager.calculate_checkout_subtotal_delivery_additional_fee(checkout=checkout, lines=lines)
    )
    checkout_subtotal_delivery_additional_fee_amount = (
        checkout_subtotal_delivery_additional_fee.gross.amount
    )
    checkout_total = base_calculations.base_checkout_total(
        subtotal=checkout_subtotal,
        subtotal_delivery_additional_fee=checkout_subtotal_delivery_additional_fee,
        currency=checkout.currency,
    )

    order_type = checkout.order_type
    unit_additional_fee = 0
    if order_type in [OrderType.BY_USER, OrderType.BY_STAFF_FOR_BRAND]:
        if checkout.delivery_method == OrderDeliveryMethods.BY_COURIER:
            unit_additional_fee_exclude_vat = (
                get_unit_delivery_additional_fee_exclude_vat_by_address(checkout.shipping_address)
            )
            if unit_additional_fee_exclude_vat > 0:
                unit_additional_fee = calc_to_include_vat(unit_additional_fee_exclude_vat, False)

    order_data.update(
        _process_shipping_data_for_order(
            checkout, unit_additional_fee, checkout_subtotal_delivery_additional_fee_amount
        )
    )
    order_data.update(_process_user_data_for_order(checkout))

    order_data.update(
        {
            "language_code": get_language(),
            "tracking_client_id": checkout.tracking_code or "",
            "total": checkout_total,
            "etc_info": checkout.etc_info or {},
            "picking_info": checkout.picking_info or {},
            "metadata": checkout.metadata,
            "private_metadata": checkout.private_metadata,
            "type": checkout.order_type,
            "staff_note": checkout.staff_note,
            "customer_note": checkout.note,
            "creator_user": (
                creator_user
                if checkout.order_type in ORDER_TYPES_BY_STAFF_OR_HQ_STAFF_FOR_BRAND
                else None
            ),
            "tax_invoice_request_flag": checkout.tax_invoice_request_flag,
            "alt_invoicee_biz_info": checkout.alt_invoicee_biz_info,
            "delivery_method": checkout.delivery_method,
            "estimated_arrival_date": checkout.estimated_arrival_date,
        }
    )

    brand_payment_values_for_not_fbv: Union[BrandPaymentValues, None] = calc_brand_payment_values(
        checkout=checkout, payment=payment, is_fbv=False
    )
    brand_payment_values_for_fbv: Union[BrandPaymentValues, None] = calc_brand_payment_values(
        checkout=checkout, payment=payment, is_fbv=True
    )
    # 가상계좌이면서 둘다, brand_paying_charge_exclude_vat 이 0보다 큰 경우(즉 둘다 수수료가 있는 경우) 보스 상품에만 부과함.
    if is_vbank_pay(payment.token):
        if (
            brand_payment_values_for_not_fbv
            and brand_payment_values_for_not_fbv.brand_paying_charge_exclude_vat > 0
            and brand_payment_values_for_fbv
            and brand_payment_values_for_fbv.brand_paying_charge_exclude_vat > 0
        ):
            brand_payment_values_for_fbv.brand_paying_charge_exclude_vat = Decimal(0)

    order_lines: List[OrderLine] = []
    sum_of_brand_paying_charge_exclude_vat = 0
    for index, line in enumerate(lines):
        is_fulfilled_by_vendor = line.is_fulfilled_by_vendor
        create_order_line_fn = (
            _create_order_line_fulfilled_by_vendor if is_fulfilled_by_vendor else _create_order_line
        )
        brand_payment_values = (
            brand_payment_values_for_fbv
            if is_fulfilled_by_vendor
            else brand_payment_values_for_not_fbv
        )
        create_order_lines = create_order_line_fn(
            checkout=checkout,
            checkout_line=line,
            payment=payment,
            checkout_subtotal_amount=checkout_subtotal_amount,
            brand_payment_values=brand_payment_values,
        )
        order_lines.extend(create_order_lines)
        for create_order_line in create_order_lines:
            sum_of_brand_paying_charge_exclude_vat += (
                create_order_line.brand_paying_charge_exclude_vat
            )

    order_data["lines"] = order_lines

    # 더하기는 BrandPaymentValues 정의하는 곳에 처리되어 있음.
    brand_payment_values = (
        brand_payment_values_for_not_fbv + brand_payment_values_for_fbv
        if not (brand_payment_values_for_not_fbv is None and brand_payment_values_for_fbv is None)
        else None
    )

    if brand_payment_values:
        brand_payment_values.brand_paying_charge_exclude_vat = (
            sum_of_brand_paying_charge_exclude_vat
        )

    if brand_payment_values:
        order_data.update(
            {
                "brand_total_cost_price_amount": brand_payment_values.brand_total_cost_price_amount,
                "final_brand_total_cost_price_amount": brand_payment_values.brand_total_cost_price_amount,
                "brand_total_delivery_fee_amount": brand_payment_values.brand_total_delivery_fee_amount,
                "final_brand_total_delivery_fee_amount": brand_payment_values.brand_total_delivery_fee_amount,
            }
        )

    manager.preprocess_order_creation(checkout)
    return order_data


def _set_sibling_order_lines_for_created_order_lines(order_lines):
    """
    bulk_create 로 새로 생성된 order_lines 에 대해서만
    variant_id 가 같은 두 개의 order_line 간 sibling_line 설정
    """
    # variant_id 별로 묶기
    grouped = defaultdict(list)
    for ol in order_lines:
        grouped[ol.variant_id].append(ol)

    # sibling 관계 설정
    to_update = []
    for variant_id, lines in grouped.items():
        if len(lines) == 2:
            # 두 개일 때만 처리
            line_true = next((line for line in lines if line.track_inventory), None)
            line_false = next((line for line in lines if not line.track_inventory), None)

            if line_true and line_false:
                line_true.sibling_order_line_id = line_false.id
                line_false.sibling_order_line_id = line_true.id
                to_update.extend([line_true, line_false])

    # bulk update (sibling_order_line_id 필드만)
    if to_update:
        OrderLine.objects.bulk_update(to_update, ["sibling_order_line_id"])


@transaction.atomic()
def _create_order(
    *, payment: "Payment", checkout: "Checkout", order_data: dict, user: "User"
) -> Order:
    """Create an order from the checkout.

    Each order will get a private copy of the shipping address (if shipping).

    If any of the addresses is new and the user is logged in the address
    will also get saved to that user's address book.

    Current user's language is saved in the order so we can later determine
    which language to use when sending email.
    """
    order = Order.objects.filter(checkout_token=checkout.token).first()
    if order is not None:
        logger.info(f"payment_debug: _create_order. 이미 생성된 order 리턴 {payment} {order}")
        return order

    order_lines = order_data.pop("lines")

    order = Order.objects.create(**order_data, checkout_token=checkout.token)

    for idx, line in enumerate(order_lines):
        line.order_id = order.pk
        line.sub_id = idx + 1

    order_lines = OrderLine.objects.bulk_create(order_lines)
    _set_sibling_order_lines_for_created_order_lines(order_lines)
    country_code = checkout.get_country()

    # 재발주점 시스템 도입하면서 재고 소진, (구) 안전재고 이하인 경우 알림 메일 발송 로직은 제거됨
    # for line in order_lines:
    #     variant = line.variant
    #     quantity = line.quantity
    #     country = checkout.get_country()
    #     orderable_qty_incl_short_term = get_orderable_qty(variant, country, until_short_term=True)
    #     _send_email_in_case_under_stock(
    #         variant, checkout, orderable_qty_incl_short_term, quantity, order.pk, line
    #     )

    if order.is_b2b_order == False and order.delivery_method != OrderDeliveryMethods.BY_COURIER:
        # b2b 주문이 아닌경우 기타배송인데 매장 주문가능재고 아래인 order_lines들
        order_lines_under_orderable_qty_for_etc_delivery = []
        for line in order_lines:
            # 재고 주문인 경우 allocate 처리 (위탁 제품이지만 재고 보유인 경우 재고주문으로 변환된 것 포함)
            if line.track_inventory and line.decrease_stock_flag == True:
                quantity = line.quantity
                if quantity > get_orderable_qty(
                    line.variant, checkout.get_country(), until_short_term=True
                ):
                    order_lines_under_orderable_qty_for_etc_delivery.append(line)

        if order_lines_under_orderable_qty_for_etc_delivery:
            _send_email_in_case_no_track_inventory_with_etc_delivery(
                order_lines_under_orderable_qty_for_etc_delivery,
                checkout,
                order.composed_id_with_prefix,
            )

    for line in order_lines:
        # 재고 주문인 경우 allocate 처리 (위탁 제품이지만 재고 보유인 경우 재고주문으로 변환된 것 포함)
        if line.track_inventory and line.decrease_stock_flag == True:
            is_picking_order = line.is_picking_order
            if is_picking_order:
                allocate_inner_variant_stock(line, country_code)
            else:
                allocate_stock(line, country_code, line.quantity)

    # 모든 payments 의 is_active 를 False 로 하고, 현재 order_id 를 세팅한  payment만 is_active True 처리
    checkout.payments.update(is_active=False)
    payment.is_active = True
    payment.order = order
    payment.save()

    transaction.on_commit(lambda order=order, user=user: order_created(order=order, user=user))

    if order.is_b2b_order == False and order.delivery_method != OrderDeliveryMethods.BY_COURIER:
        _send_email_in_case_etc_delivery_order_maded(
            checkout,
            order.composed_id_with_prefix,
            order.estimated_arrival_date,
        )

    # Send the order confirmation email
    # 유저에게 보내는 메일은 모두 주석 처리
    # transaction.on_commit(
    #     lambda: send_order_confirmation.delay(order.pk, checkout.redirect_url, user.pk)
    # )

    # StaffNotificationRecipient 테이블에 기록된 staff 에게 order confirm 이메일 보내는 루틴인데 운영안함
    # transaction.on_commit(
    #     lambda: send_staff_order_confirmation.delay(order.pk, checkout.redirect_url)
    # )

    try:
        # order_lines를 vendor 별로 그룹화
        vendor_line_map = defaultdict(list)
        for line in order_lines:
            if line.vendor_id:
                vendor_line_map[line.vendor].append(line)

        brand = order.user.brand if order.user else None
        staff_email = brand.staff.email if brand and brand.staff else None

        for vendor, lines in vendor_line_map.items():
            try:
                context = {
                    "order_number": f"{order}",
                    "vendor_name": vendor.name,
                    "vendor_code": vendor.code,
                    "dashboard_url": build_absolute_dashboard_uri(),
                }

                if vendor.use_fbv_alarm:
                    brand_name = order.brand.name if order.brand else "-"
                    context.update({"brand_name": brand_name})
                    recipient_list = get_vendor_main_order_manager_email_list(vendor)
                    template_name = "order/notify_fbv_order_to_vendor"

                    transaction.on_commit(
                        lambda rl=recipient_list, tn=template_name, ctx=context: send_templated_mail_fbv_order(
                            rl, tn, ctx
                        )
                    )

                    if (
                        brand
                        and brand.use_fbv_paid_notice
                        and brand.available_paid_notice_count > 0
                    ):
                        receiver_phone = get_vendor_main_order_manager_phone(vendor)
                        send_result = send_kakaotalk_to_vendor_on_fbv_order(
                            order, receiver_phone, vendor.name
                        )

                        if send_result:
                            description = f"직거래 상품 주문 알림 - {order.composed_id_with_prefix} - {vendor.name}"
                            brand.decrease_available_paid_notice_count(
                                delta=1,
                                type=PaidNoticeCountEventType.USE_FOR_FBV_ORDER,
                                description=description,
                                from_user=order.user,
                                to_fbv_vendor=vendor,
                            )
                else:
                    if staff_email is not None:
                        template_name = "order/notify_fbv_order_to_md"
                        transaction.on_commit(
                            lambda se=staff_email, tn=template_name, ctx=context: send_templated_mail_fbv_order(
                                se, tn, ctx
                            )
                        )

            except Exception as ve:
                logger.error(f"[FBV 알림] {vendor.name} 알림 실패 - {ve}")
                continue

    except Exception as e:
        logger.error(f"직거래 주문 알림 처리 중 오류 - {e}")
        pass

    logger.info(f"payment_debug: _create_order {payment} {order}")
    return order


def _prepare_checkout(checkout: "Checkout", tracking_code, redirect_url, payment):
    """Prepare checkout object to complete the checkout process."""
    only_selected_checkout_lines = checkout.get_selected_lines()

    clean_checkout_shipping_address(checkout)
    clean_checkout_payment(
        checkout, only_selected_checkout_lines, CheckoutErrorCode, last_payment=payment
    )

    if redirect_url:
        try:
            validate_storefront_url(redirect_url)
        except ValidationError as error:
            raise ValidationError({"redirect_url": error}, code=AccountErrorCode.INVALID.value)

    to_update = []
    if redirect_url and redirect_url != checkout.redirect_url:
        checkout.redirect_url = redirect_url
        to_update.append("redirect_url")

    if tracking_code and tracking_code != checkout.tracking_code:
        checkout.tracking_code = tracking_code
        to_update.append("tracking_code")

    if to_update:
        to_update.append("last_change")
        checkout.save(update_fields=to_update)


def _get_order_data(checkout: "Checkout", payment: "Payment", creator_user: "User" = None) -> dict:
    """Prepare data that will be converted to order and its lines."""
    only_selected_checkout_lines: List["CheckoutLine"] = list(checkout.get_selected_lines())
    try:
        order_data = _prepare_order_data(
            checkout=checkout,
            lines=only_selected_checkout_lines,
            payment=payment,
            creator_user=creator_user,
        )
    except InsufficientStock as e:
        productStockErrorMsg = "해당 상품의 재고가 부족합니다."
        item_name = e.item.display_product(bp_name=e.bp_name)
        raise ValidationError(f"{productStockErrorMsg}: {item_name}", code=e.code)
    except TaxError as tax_error:
        raise ValidationError(
            "세금 계산이 불가능합니다. %s" % str(tax_error),
            code=CheckoutErrorCode.TAX_ERROR.value,
        )
    except Exception as e:
        logger.warn(f"_prepare_order_data exception: {e}")
        raise ValidationError(f"_prepare_order_data exception: {e}")
    return order_data


# 선택된 상품만 구매 처리되고 남은 상품들을 다시 장바구니(checkout)  에 남기는 처리
# 대행주문은 장바구니에 있는 모든 상품 구매므로 삭제처리
def _clean_checkout_for_checkout_complete(
    payment: "Payment",
    checkout: "Checkout",
):
    # 스태프에 의한 주문인 경우 checkout lines 는 모두 selected 상태이므로 checkout 정리
    if checkout.order_type != OrderType.BY_USER:
        checkout.delete()
    else:
        checkout.lines.filter(is_selected=True).delete()
        new_checkout = Checkout.objects.create(
            user=checkout.user,
        )
        # 이전 checkoutline 의 checkout 을 신규 생성된 new_checkout 으로 연결 후 이전 것 제거
        checkout.lines.update(checkout=new_checkout)
        checkout.delete()
        # 새로 생성된 checkout 의 line 의 quantity 를 업데이트
        update_checkout_quantity(new_checkout)

    logger.info(f"payment_debug: _clean_checkout {payment}")


# 포장보스 결제과정 (이니시스, 포인트only, 대행주문) 에서 불필요한 부분 정리
def complete_checkout(
    payment: "Payment",
    checkout: "Checkout",
    tracking_code=None,
    redirect_url=None,
    creator_user: "User" = None,
) -> Tuple[Optional[Order], bool, dict]:
    _prepare_checkout(
        checkout=checkout,
        tracking_code=tracking_code,
        redirect_url=redirect_url,
        payment=payment,
    )

    try:
        order_data = _get_order_data(checkout, payment, creator_user)
    except ValidationError as e:
        logger.warn(f"_get_order_data exception: {e}")
        gateway.payment_refund_or_void(payment)
        raise

    try:
        order = _create_order(
            payment=payment,
            checkout=checkout,
            order_data=order_data,
            user=checkout.user,  # type: ignore
        )
        _clean_checkout_for_checkout_complete(payment=payment, checkout=checkout)
    except InsufficientStock as e:
        logger.warn(f"_create_order exception: {e}")
        gateway.payment_refund_or_void(payment)
        productStockErrorMsg = "해당 상품의 재고가 부족합니다."
        item_name = e.item.display_product(bp_name=e.bp_name)
        raise ValidationError(f"{productStockErrorMsg} {item_name}", code=e.code)
    except Exception as e:
        logger.warn(f"_create_order exception: {e}")
        gateway.payment_refund_or_void(payment)
        raise

    return order
