    sales_status = pv.sales_status if pv else None
    if sales_status is None:
        return "-"
    if sales_status == SalesStatus.ON_SALE:
        return "정상"
    elif sales_status == SalesStatus.WILL_BE_STOPPED:
        return "단종 예정"
    elif sales_status == SalesStatus.STOPPED:
        return "단종"
    elif sales_status == SalesStatus.PENDING:
        return "판매대기"
    return "-"


def term_of_bpv_sales_status(bpv: BrandProductVariant):
    sales_status = bpv.sales_status if bpv else None
    if sales_status is None:
        return "-"
    if sales_status == SalesStatus.ON_SALE:
        return "판매"
    elif sales_status == SalesStatus.WILL_BE_STOPPED:
        return "중단 예정"
    elif sales_status == SalesStatus.STOPPED:
        return "중단"
    return "-"


