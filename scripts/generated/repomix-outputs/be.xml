                        brand_product_variant.show_before_price = show_before_price
                        update_brand_product_variant_list.append(brand_product_variant)
                    before_price = bpv_update_input.get("before_price")
                    if before_price is not None:
                        brand_product_variant.before_price_amount = before_price
                        update_brand_product_variant_list.append(brand_product_variant)
                    price = bpv_update_input.get("price")
                    if price is not None:
                        brand_product_variant.price_amount = price
                        update_brand_product_variant_list.append(brand_product_variant)
                    price_vat = bpv_update_input.get("price_vat")
                    if price_vat is not None:
                        brand_product_variant.price_vat = price_vat
                        update_brand_product_variant_list.append(brand_product_variant)

            is_inner = pv.outer is not None
            if is_inner == False:
                track_inventory = detail.get("track_inventory")
