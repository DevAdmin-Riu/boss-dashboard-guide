                    after_status=after_status,
                    user=user,
                    reason=reason,
                )
            )
    if histories:
        PurchaseOrderLineStatusHistory.objects.bulk_create(histories)


def calc_po_line_vat_amount(
    quantity,
    cost_price_exclude_vat,
    etc_exclude_vat,
    take_back_unit_cost_delivery_fee_exclude_vat,
    b2b_delivery_fee_exclude_vat,
    is_tax_free,
):
    quantity = Decimal(quantity)
    cost_price_exclude_vat = Decimal(cost_price_exclude_vat)
    etc_exclude_vat = Decimal(etc_exclude_vat)
    # 위탁반품발주서 위탁반품 배송비
    take_back_unit_cost_delivery_fee_exclude_vat = Decimal(
        take_back_unit_cost_delivery_fee_exclude_vat
    )
    b2b_delivery_fee_exclude_vat = Decimal(b2b_delivery_fee_exclude_vat)

    vat_target_amount = (
        etc_exclude_vat
        + b2b_delivery_fee_exclude_vat
        + calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            take_back_unit_cost_delivery_fee_exclude_vat, quantity, False
        )
    )
    if is_tax_free == False:
        vat_target_amount += calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            cost_price_exclude_vat, quantity, is_tax_free
        )
    return my_round(float(vat_target_amount) * 0.1)


def _make_po_line_for_auto_consignment_po(
    po: "PurchaseOrder", order_line: "OrderLine", po_line_status, sort_order
):
    vendor: Vendor = po.vendor
    order: Order = order_line.order
    variant: ProductVariant = order_line.variant
    variant_vendor: ProductVariantVendor = variant.get_default_variant_vendor()
    quantity = order_line.quantity
    is_tax_free = order_line.is_tax_free
    shipping_address = order.shipping_address
    product_price_exclude_vat = variant_vendor.consignment_product_price_exclude_vat
    delivery_fee_exclude_vat = variant_vendor.consignment_delivery_fee_exclude_vat
    cost_price_exclude_vat = product_price_exclude_vat + delivery_fee_exclude_vat
    consignment_unit_delivery_additional_fee_exclude_vat = (
        vendor.consignment_unit_delivery_additional_fee_exclude_vat
        if check_charge_delivery_additional_fee(shipping_address)
        else 0
    )
    vat_amount = calc_po_line_vat_amount(
        quantity,
        cost_price_exclude_vat,
        etc_exclude_vat=0,
        take_back_unit_cost_delivery_fee_exclude_vat=0,
        b2b_delivery_fee_exclude_vat=0,
        is_tax_free=is_tax_free,
    )
    if order.estimated_arrival_date:
        asking_purchase_date = order.estimated_arrival_date
    else:
        asking_purchase_date = po.purchase_order_date

    return PurchaseOrderLine(
        sort_order=sort_order,
        purchase_order=po,
        asking_purchase_date=asking_purchase_date,
        expected_purchase_date=asking_purchase_date,
        variant=variant,
        variant_name=variant.name,
        product_sku=variant.sku,
        product_name=variant.product.name,
        external_product_name=variant_vendor.external_product_name,
        external_sku=variant_vendor.external_sku,
        quantity=quantity,
        purchase_quantity=quantity,
        status=po_line_status,
        attribute_data=convert_to_simple_attribute(variant),
        product_price_exclude_vat=product_price_exclude_vat,
        delivery_fee_exclude_vat=delivery_fee_exclude_vat,
        cost_price_exclude_vat=cost_price_exclude_vat,
        consignment_unit_delivery_additional_fee_exclude_vat=consignment_unit_delivery_additional_fee_exclude_vat,
        vat_amount=vat_amount,
        is_tax_free=is_tax_free,
        shipping_address=shipping_address,
        order_line=order_line,
        note=variant.po_note,
    )


def _make_auto_consignment_po_email_info(vendor: "Vendor", po_lines: List["PurchaseOrderLine"]):
    main_order_manager = get_main_order_manager_from_vendor_managers(vendor.managers)
    if not main_order_manager:
        return False, None, None, None
    _, manager_email, _manager_name, error_msg = get_main_order_manager_info(vendor)
    if not manager_email:
        return False, None, None, None

    first_po_line = po_lines[0]
    po = first_po_line.purchase_order
    event_type = po.event_type
    event_type_lebel = term_of_po_event_type(event_type, False)
    first_po_line_product_name = first_po_line.product_name
    line_count = len(po_lines)

    title = f"[㈜리우][{event_type_lebel}] {first_po_line_product_name}"
    if line_count > 1:
        title = f"{title} 외 {line_count - 1} 건"
    title = f"{title} 발주 요청의 건"

    recipient_list = [manager_email]
    cc_list = get_sub_order_manager_email_list(vendor)

    return True, title, recipient_list, cc_list


def _bulk_create_auto_consignment_po(order_lines: List["OrderLine"]):
    order_lines_group_by_vendor = make_order_lines_group_by_vendor(order_lines)
    version = PurchaseOrder.LATEST_VESRSION
    today = kst_date()
    event_type = PurchaseOrderEventType.CONSIGNMENT

    created_po_list = []
    created_po_line_list = []
    purchase_orders = []
    for vendor, order_lines in order_lines_group_by_vendor.items():
        vendor_data = make_vendor_parameters(vendor) if vendor else {}
        purchase_order = PurchaseOrder(
            version=version,
            vendor=vendor,
            vendor_data=vendor_data,
            purchase_order_date=today,
            event_type=event_type,
            # 자동 위탁 발주는 생성 후 발송까지 하도록 되어 있어서 생성시 발송 상태로 세팅
            is_sent=True,
        )
        purchase_orders.append(purchase_order)

    if purchase_orders:
        # 발주서 생성
        created_po_list = PurchaseOrder.objects.bulk_create(purchase_orders)
        # 자동 위탁 발주는 생성 후 발송까지 하도록 되어 있어서 생성시 접수대기 상태로 세팅
        po_line_status = PurchaseOrderLineStatus.PENDING
        po_lines = []
        for po in created_po_list:
            vendor = po.vendor
            order_lines = order_lines_group_by_vendor[vendor]
            sort_order = 1
            for order_line in order_lines:
                po_line = _make_po_line_for_auto_consignment_po(
                    po, order_line, po_line_status, sort_order
                )
                po_lines.append(po_line)
                sort_order = sort_order + 1
        if po_lines:
            created_po_line_list: List[PurchaseOrderLine] = PurchaseOrderLine.objects.bulk_create(
                po_lines
            )
            update_order_lines = []
            for po_line in created_po_line_list:
                order_line: OrderLine = po_line.order_line
                order_line.purchase_order_line = po_line
                update_order_lines.append(order_line)
            OrderLine.objects.bulk_update(update_order_lines, ["purchase_order_line"])
            bulk_create_po_line_status_histories(
                created_po_line_list,
                before_status=None,
                after_status=po_line_status,
                user=None,
            )
            events.bulk_add_po_manage_event(
                created_po_list,
                user=None,
                type=PurchaseOrderManageEventType.CREATED,
                parameters={"message": "자동 위탁 발주 생성"},
            )

    return created_po_list, created_po_line_list


def _save_po_sent_email_file(
    po_sent_email: PurchaseOrderSentEmail,
    po_lines: List[PurchaseOrderLine],
    delivery_method: OrderDeliveryMethods,
):
    po = po_sent_email.purchase_order
    today = kst_timezone_now().strftime("%Y%m%d_%H%M%S")
    file_name = f"주식회사_리우_부자재_발주서_{today}.xlsx"
    wb = export_auto_consignment_po(po, po_lines, delivery_method)
    if wb is None:
        logger.error(f"{po.code}: 위탁 발주서 발송 첨부 엑셀파일 생성 실패")
        return

    file_data = BytesIO()
    wb.save(file_data)
    file_data.seek(0)
    bytes_dat = file_data.getvalue()
    po_sent_email.file.save(file_name, ContentFile(bytes_dat))


def _bulk_send_auto_consignment_po(
    created_po_list: List["PurchaseOrder"],
    created_po_line_list: List["PurchaseOrderLine"],
    delivery_method: OrderDeliveryMethods,
):
    events.bulk_add_po_manage_event(
        created_po_list,
        user=None,
        type=PurchaseOrderManageEventType.SENT,
        parameters={"message": "자동 위탁 발주 발송"},
    )
    po_lines_group_by_vendor = make_po_lines_group_by_vendor(created_po_line_list)
    po_lines_list_for_notice = []
    po_sent_email_list: List[PurchaseOrderSentEmail] = []
    po_manage_event_list = []
    consignment_po_manager_email_list = get_consignment_purchase_manager_email_list()
    from_email = consignment_po_manager_email_list[0] if consignment_po_manager_email_list else None
    if from_email:
        for vendor, po_lines in po_lines_group_by_vendor.items():
            is_ok, title, recipient_list, cc_list = _make_auto_consignment_po_email_info(
                vendor, po_lines
            )
            if is_ok:
                po = po_lines[0].purchase_order
                po_sent_email = PurchaseOrderSentEmail(
                    purchase_order=po,
                    title=title,
                    from_email=from_email,
                    recipient_list=recipient_list,
                    cc_list=cc_list,
                )
                po_sent_email_list.append(po_sent_email)
                po_lines_list_for_notice.append(po_lines)
                po_manage_event = PurchaseOrderManageEvent(
                    purchase_order=po,
                    user=None,
                    type=PurchaseOrderManageEventType.VENDOR_EMAIL_SENT,
                    parameters={
                        "message": f"발주서 이메일 전송.\n보낸 사람 : {po_sent_email.from_email}\n받는 사람 : {po_sent_email.recipient_list}\n참조 : {po_sent_email.cc_list}"
                    },
                )
                po_manage_event_list.append(po_manage_event)
    if po_sent_email_list:
        PurchaseOrderSentEmail.objects.bulk_create(po_sent_email_list)
        PurchaseOrderManageEvent.objects.bulk_create(po_manage_event_list)

        for po_sent_email, po_lines in zip(po_sent_email_list, po_lines_list_for_notice):
            _save_po_sent_email_file(po_sent_email, po_lines, delivery_method)
            send_notice_po_sent_to_vendor(
                user_name="포장보스", po_sent_email=po_sent_email, po_lines=po_lines
            )


# 매시 정각 자동 위탁 발주 설정된 협력사의 위탁 주문에 대해서 process_auto_consignment_po task 에서 호출
@transaction.atomic()
def bulk_create_and_send_auto_consignment_po(
    order_lines: List["OrderLine"], delivery_method: OrderDeliveryMethods
):
    created_po_list, created_po_line_list = _bulk_create_auto_consignment_po(order_lines)
    if created_po_list:
        _bulk_send_auto_consignment_po(created_po_list, created_po_line_list, delivery_method)


