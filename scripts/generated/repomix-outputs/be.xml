from .utils import filter_order_search_factory


class OrderFilter(django_filters.FilterSet):
    def filter_user_search(qs, _, value):
        search_fields = [
            "user__first_name",
            "user__login_id",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand_search(qs, _, value):
        search_fields = [
            "brand__code",
            "brand__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand_store_search(qs, _, value):
        search_fields = [
            "user__owned_brand_store__code",
            "user__owned_brand_store__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_product_search(qs, _, value):
        search_fields = ["lines__product_sku", "lines__product_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs.distinct()

    def filter_creator_user_search(qs, _, value):
        search_fields = ["creator_user__first_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_order_search(qs, _, value):
        return filter_order_search_factory(field_name="pk")(qs, _, value)

    def filter_payment_search(qs, _, value):
        pk_fields = ["payments__pk"]
        qs = filter_pk_fields(qs, value, pk_fields)
        return qs

    def filter_by_customer_id(qs, _, value):
        if value:
            _, user_id = graphene.Node.from_global_id(value)
            qs = qs.filter(user_id=user_id)

        return qs

    def filter_delivery_status(qs, _, value):
        if value:

            def standby_delivery_filter():
                statuses = set([OrderStatus.UNFULFILLED, OrderStatus.PARTIALLY_FULFILLED])
                return Q(status__in=statuses)

            def complete_delivery_filter():
                statuses = set([OrderStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 배송완료 상태가 False 상태인 것이 존재하면 제외
                q2 = ~Q(fulfillment_count__gt=F("tracking_complete_count"))
                return q1 & q2

            def tracking_delivery_filter():
                statuses = set([OrderStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 송장번호가 비어 있는 것은 제외
                q2 = ~Q(fulfillment_count__gt=F("tracking_number_count"))
                # 모두 배송완료된 것은 제외
                q3 = ~Q(fulfillment_count=F("tracking_complete_count"))
                return q1 & q2 & q3

            def ready_to_delivery_filter():
                statuses = set([OrderStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 모두 송장번호가 입력된 것 제외
                q2 = ~Q(fulfillment_count=F("tracking_number_count"))
                return q1 & q2

            def refunded_delivery_filter():
                q = Q(quantity_refunded_count__gt=0)
                return q

            qs = qs.annotate(
                fulfillment_count=Count("fulfillments"),
                tracking_complete_count=Count(
                    "fulfillments", filter=Q(fulfillments__is_tracking_completed=True)
                ),
                tracking_number_count=Count(
                    "fulfillments",
                    filter=~Q(fulfillments__tracking_number__exact="")
                    # 취소, 환불은 제외 함.
                    & ~Q(
                        fulfillments__status__in=[
                            FulfillmentStatus.CANCELED,
                            FulfillmentStatus.REFUNDED,
                        ]
                    ),
                ),
                quantity_refunded_count=Sum("lines__quantity_refunded"),
            )

            filter_list = []
            if OrderDeliveryStatusFilter.STANDBY_DELIVERY in value:
                filter_list.append(standby_delivery_filter())

            if OrderDeliveryStatusFilter.READY_TO_DELIVERY in value:
                filter_list.append(ready_to_delivery_filter())

            if OrderDeliveryStatusFilter.BEFORE_DELIVERY in value:
                filter_list.append(standby_delivery_filter())
                filter_list.append(ready_to_delivery_filter())

            if OrderDeliveryStatusFilter.TRACKING_DELIVERY in value:
                filter_list.append(tracking_delivery_filter())

            if OrderDeliveryStatusFilter.COMPLETED_DELIVERY in value:
                filter_list.append(complete_delivery_filter())

            if OrderDeliveryStatusFilter.REFUNDED_DELIVERY in value:
                filter_list.append(refunded_delivery_filter())

            filter_union = None
            for q in filter_list:
                if filter_union:
                    filter_union |= q
                else:
                    filter_union = q

            qs = qs.filter(filter_union)

        return qs

    def filter_charge_status(qs, _, value):
        if value:
            qs = qs.exclude(status=OrderStatus.CANCELED)
            charge_status_values = set([])
            if OrderChargeStatusFilter.PENDING in value:
                charge_status_values.update(
                    [
                        ChargeStatus.PENDING,
                    ]
                )
            if OrderChargeStatusFilter.BEING_APPROVED in value:
                charge_status_values.update([ChargeStatus.BEING_APPROVED])
            if OrderChargeStatusFilter.PARTIALLY_REFUNDED in value:
                charge_status_values.update([ChargeStatus.PARTIALLY_REFUNDED])
            if OrderChargeStatusFilter.CHARGED in value:
                charge_status_values.update(
                    [ChargeStatus.FULLY_CHARGED, ChargeStatus.PARTIALLY_CHARGED]
                )
            # FULLY_REFUNDED인경우 is_active가 false로 바뀌기때문에 아래와 같은 로직.
            if OrderChargeStatusFilter.FULLY_REFUNDED in value:
                qs = qs.filter(
                    Q(payments__charge_status__in=[ChargeStatus.FULLY_REFUNDED])
                    | Q(
                        payments__is_active=True,
                        payments__charge_status__in=charge_status_values,
                    )
                )
            elif charge_status_values:
                qs = qs.filter(
                    payments__is_active=True,
                    payments__charge_status__in=charge_status_values,
                )
            # FULLY_REFUNDED 도 없고 charge_status_values도 없는 경우에는 qs 그대로 돌려주는게 좋음.

        return qs

    def filter_pay_method(qs, _, value):
        latest_payment = (
            Payment.objects.filter(order=OuterRef("pk")).order_by("-pk").values("pk")[:1]
        )

        if value:
            qs = qs.annotate(
                latest_payment_id=Subquery(latest_payment),
                payment_is_toss_riu_pay=Case(
                    When(payments__pk=F("latest_payment_id"), then=F("payments__is_toss_riu_pay")),
                ),
                payment_token=Case(
                    When(payments__pk=F("latest_payment_id"), then=F("payments__token")),
                ),
                payment_credits=Case(
                    When(
                        payments__pk=F("latest_payment_id"),
                        then=F("payments__cashable_credits") + F("payments__non_cashable_credits"),
                    ),
                ),
                payment_rcoins=Case(
                    When(payments__pk=F("latest_payment_id"), then=F("payments__rcoins")),
                ),
            )

            card_filter = Q(payment_token__iexact=INICIS_PAY_METHOD_CARD) | Q(
                payment_token__iexact=TOSS_PAY_METHOD_CARD
            )
            toss_riu_pay_card_filter = Q(payment_is_toss_riu_pay=True) & card_filter
            normal_card_filter = Q(payment_is_toss_riu_pay=False) & card_filter
            vbank_filter = Q(payment_token__iexact=INICIS_PAY_METHOD_VBANK) | Q(
                payment_token__iexact=TOSS_PAY_METHOD_VBANK
            )
            if OrderPayMethodFilter.IS_TOSS_RIU_CARD_PAY in value:
                qs = qs.filter(toss_riu_pay_card_filter)
            else:
                qs = qs.exclude(toss_riu_pay_card_filter)
            if OrderPayMethodFilter.IS_NORMAL_CARD_PAY in value:
                qs = qs.filter(normal_card_filter)
            else:
                qs = qs.exclude(normal_card_filter)
            if OrderPayMethodFilter.IS_VBANK_PAY in value:
                qs = qs.filter(vbank_filter)
            else:
                qs = qs.exclude(vbank_filter)
            if OrderPayMethodFilter.IS_CREDITS_PAY in value:
                qs = qs.filter(payment_credits__gt=0)
            else:
                qs = qs.exclude(payment_credits__gt=0)
            if OrderPayMethodFilter.IS_RCOIN_PAY in value:
                qs = qs.filter(payment_rcoins__gt=0)
            else:
                qs = qs.exclude(payment_rcoins__gt=0)
        return qs

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    def filter_captured_at_range(qs, _, value):
        return filter_range_field(qs, "captured_at__date", value)

    # 매장주가 주문내역 조회 시 취소된 건은 제외하고 노출하기 위한 필터링에만 사용
    # 주문 리스트에서 배송 상태 필터는 filter_delivery_status 사용
    def filter_status(qs, _, value):
        query_objects = qs.none()

        valTmp = copy.deepcopy(value)
        if OrderStatusFilter.READY_TO_FULFILL in value:
            valTmp.remove(OrderStatusFilter.READY_TO_FULFILL)
        if OrderStatusFilter.READY_TO_CAPTURE in value:
            valTmp.remove(OrderStatusFilter.READY_TO_CAPTURE)

        if valTmp:
            query_objects |= qs.filter(status__in=valTmp)

        # 아래는 의미 없는 코드임. 이미 위에서 partially_fulfilled, unfulfilled가 포함됨.
        # if OrderStatusFilter.READY_TO_FULFILL in value:
        #     query_objects |= qs.ready_to_fulfill()
        #

        # 아래 또한 의미 없음. not-charged, is_status true인 경우는 order가 생성 안되어 있음.
        # if OrderStatusFilter.READY_TO_CAPTURE in value:
        #     qs = qs.distinct()
        #     query_objects = query_objects.distinct()
        #     query_objects |= qs.ready_to_capture()

        return qs & query_objects

    def filter_type(qs, _, value):
        if value:
            return qs.filter(type__in=value)
        return qs

    def filter_brands(qs, _, value):
        if value:
            brands = get_nodes(value, "Brand", BrandModel)
            qs = qs.filter(brand__in=brands)
        return qs

    user_search = django_filters.CharFilter(method=filter_user_search)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    brand_store_search = django_filters.CharFilter(method=filter_brand_store_search)
    product_search = django_filters.CharFilter(method=filter_product_search)
    creator_user_search = django_filters.CharFilter(method=filter_creator_user_search)
    order_search = django_filters.CharFilter(method=filter_order_search)
    payment_search = django_filters.CharFilter(method=filter_payment_search)

    # 실적관리에서 여러 브랜드 선택해서 비교 시 사용
    brands = GlobalIDMultipleChoiceFilter(method=filter_brands)
    # 가맹본부 어드민에서 매장별 주문 조회 시 이용
    customer_id = GlobalIDFilter(method=filter_by_customer_id)

    status = ListObjectTypeFilter(input_class=OrderStatusFilter, method=filter_status)
    type = ListObjectTypeFilter(input_class=OrderTypeEnum, method=filter_type)
    delivery_status = ListObjectTypeFilter(
        input_class=OrderDeliveryStatusFilter, method=filter_delivery_status
    )
    charge_status = ListObjectTypeFilter(
        input_class=OrderChargeStatusFilter, method=filter_charge_status
    )
    pay_method = ListObjectTypeFilter(input_class=OrderPayMethodFilter, method=filter_pay_method)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)
    captured_at = ObjectTypeFilter(input_class=DateRangeInput, method=filter_captured_at_range)

    class Meta:
        model = Order
        fields = []


