class ShopQueries(graphene.ObjectType):
    shop = graphene.Field(Shop, description="Return information about the shop.", required=True)
    holidays_by_range = graphene.List(
        HolidayInfo,
        gte=graphene.Argument(graphene.String, description="조회 시작일 YYYY-MM-DD 형식"),
        lte=graphene.Argument(graphene.String, description="조회 종료일 YYYY-MM-DD 형식"),
        description="입력된 from~to range 사이의 휴일 정보",
    )
    holidays = FilterInputConnectionField(
        HolidayInfo,
        filter=HolidayInfoFilterInput(description="Filtering options for holiday info."),
        description="List of the shop's holiday.",
    )
    regions = graphene.List(
        RegionInfo,
        description="권역 리스트",
    )

    def resolve_shop(self, _info):
        return Shop()

    def resolve_holidays_by_range(_, _info, gte, lte):
        return site_models.HolidayInfo.objects.filter(holiday__gte=gte, holiday__lte=lte)

    def resolve_holidays(self, _info, **_kwargs):
        return site_models.HolidayInfo.objects.all().distinct()

    def resolve_regions(self, _info, **_kwargs):
        return site_models.RegionInfo.objects.all()


