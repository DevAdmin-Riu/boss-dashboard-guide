class ExclusiveBpvGradeInfoByBrandIdLoader(DataLoader):
    context_key = "exclusive_bpv_grade_info_by_brand_id"

    def batch_load(self, brand_ids):
        from .types import ExclusiveBpvGradeInfo

        # 브랜드의 월 평균 매출 (null 이면 0으로 간주해서 Basic 등급이 선택되도록)
        # 과세/면세 상품 혼합 매출, 재고금액에 대해 면세 포함 여부 무시하고 그냥 부가세 별도 금액으로 표시하는 것으로 요청 받음
        brand_qs = Brand.objects.filter(id__in=brand_ids).annotate(
            avg_sales_exclude_vat=Coalesce(
                Round(F("last_3_month_monthly_avg_sales_price") / 1.1), 0
            )
        )

        # grade 매핑 Subquery
        grade_qs = BrandExclusiveBpvGrade.objects.filter(
            from_avg_sales_price_exclude_vat__lte=OuterRef("avg_sales_exclude_vat"),
            to_avg_sales_price_exclude_vat__gt=OuterRef("avg_sales_exclude_vat"),
        ).order_by(
            "from_avg_sales_price_exclude_vat"
        )  # 혹시 구간이 겹치더라도 가장 낮은 from 값 우선

        brand_qs = brand_qs.annotate(
            grade_type=Subquery(grade_qs.values("type")[:1]),
            from_avg=Subquery(grade_qs.values("from_avg_sales_price_exclude_vat")[:1]),
            to_avg=Subquery(grade_qs.values("to_avg_sales_price_exclude_vat")[:1]),
            a_rate=Subquery(grade_qs.values("a_rate")[:1]),
            b_rate=Subquery(grade_qs.values("b_rate")[:1]),
        )

        brand_map = {
            b.id: ExclusiveBpvGradeInfo(
                type=b.grade_type,
                from_avg_sales_price_exclude_vat=b.from_avg,
                to_avg_sales_price_exclude_vat=b.to_avg,
                rate=b.a_rate if b.exclusive_bpv_type == BrandExclusiveBpvType.A else b.b_rate,
            )
            for b in brand_qs
        }

        return [brand_map.get(brand_id) for brand_id in brand_ids]


