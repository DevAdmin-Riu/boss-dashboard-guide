        error_type_field = "warehouse_errors"

    @classmethod
    def get_type_for_model(cls):
        return WarehouseAddressType

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        instance = cls.get_instance(info, **data)
        cleaned_input = cls.clean_input(info=info, instance=instance, input_data=data.get("input"))
        address = cls.validate_warehouse_address(cleaned_input, instance=instance)
        warehouse = address.warehouse_addresses.first()
        cls.clean_instance(info, address)
        cls.save(info, address, cleaned_input)
        cls._save_m2m(info, address, cleaned_input)

        success_response = cls.success_response(address)
        success_response.warehouse = warehouse
        success_response.address = address
        return success_response


# 발주서 납품 주소로 사용되었을 수 있으므로 한번 창고 주소로 등록된 주소는 삭제 하지 않고, 창고-주소 관계만 끊음
class WarehouseAddressDelete(BaseMutation):
    warehouse = graphene.Field(
        Warehouse, description="A warehouse instance for which the address was updated."
    )

    class Arguments:
        id = graphene.ID(required=True, description="ID of the address to delete.")

    class Meta:
        description = "물류센터 주소록 관계 끊기"
        permissions = (WarehousePermissions.MANAGE_LOCATION,)
        error_type_class = WarehouseError
        error_type_field = "warehouse_errors"

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        node_id = data.get("id")
        instance = cls.get_node_or_error(info, node_id, only_type=WarehouseAddressType)
        warehouse = instance.warehouse_addresses.first()
        if not warehouse:
            raise ValidationError("이미 창고 주소에서 제거된 주소입니다.")
        warehouse.addresses.remove(instance)
        return WarehouseAddressDelete(warehouse=warehouse)
