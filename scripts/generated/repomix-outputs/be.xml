class BrandCreateDevCostEvent(BaseMutation):
    brand_dev_cost_event = graphene.Field(
        BrandDevCostEvent, description="Brand related to brand dev cost event."
    )

    class Arguments:
        brand_id = graphene.ID(required=True, description="brand ID")
        input = BrandCreateDevCostEventInput(
            required=True, description="Fields required when creating brand dev cost."
        )

    class Meta:
        description = "create brand dev cost event."
        permissions = (AccountPermissions.MANAGE_BRANDS,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: UserModel = context.user
        return user.is_authenticated and user.is_staff

    @staticmethod
    def clean_input(brand: BrandModel, input: BrandCreateDevCostEventInput):
        type = input.type
        if type not in [BrandDevCostEventType.INCREASE, BrandDevCostEventType.DECREASE]:
            raise ValidationError(
                f"브랜드 상품 개발비 내역을 수동으로 생성할 수 있는 타입 정의가 아닙니다. {type}"
            )

        if type == BrandDevCostEventType.DECREASE and brand.remain_dev_cost < input.qty:
            raise ValidationError("남아 있는 상품 개발비보다 더 많이 차감할 수 없습니다.")
        return input

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        brand: BrandModel = cls.get_node_or_error(
            info, data["brand_id"], only_type=Brand, field="brandId"
        )
        cleaned_input = cls.clean_input(brand, data["input"])
        qty = cleaned_input.qty
        type = cleaned_input.type
        description = f"관리자 상품 개발비 변경: {cleaned_input.description}"

        if type == BrandDevCostEventType.INCREASE:
            result = brand.increase_remain_dev_cost(qty, type, description)
        elif type == BrandDevCostEventType.DECREASE:
            result = brand.decrease_remain_dev_cost(qty, type, description)
        else:
            result = None
        return BrandCreateDevCostEvent(brand_dev_cost_event=result)


