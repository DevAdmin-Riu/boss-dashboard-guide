            # 해당 브랜드의 모든 유저들의 switched_brand를 brand로 변경
            brand_users.update(switched_brand=instance)
            boss_market_brand = models.Brand.objects.get(is_boss_market=True)
            # 각 유저의 favorites와 checkouts를 순회하면서 관련 데이터를 삭제
            for user in brand_users.all():
                user.favorites.filter(brand_product_variant__brand=boss_market_brand).delete()
                for checkout in user.checkouts.all():
                    checkout.lines.filter(brand_product_variant__brand=boss_market_brand).delete()

