from .types import (
    PurchaseOrder,
    PurchaseOrderLine,
    PurchaseOrderLineCount,
    PurchaseOrderLineCountFilterInput,
    PurchaseOrderLineInspect,
)


class PurchaseOrderQueries(graphene.ObjectType):
    purchase_order = graphene.Field(
        PurchaseOrder,
        id=graphene.Argument(graphene.ID, description="ID of the purchase order.", required=True),
        description="Look up a purchase order by ID.",
    )
    purchase_orders = FilterInputConnectionField(
        PurchaseOrder,
        sort_by=PurchaseOrderSortingInput(description="Sort purchase orders."),
        filter=PurchaseOrderFilterInput(description="Filtering options for purchase orders."),
        description="List of the shop's purchase order.",
    )
    purchase_order_line = graphene.Field(
        PurchaseOrderLine,
        id=graphene.Argument(graphene.ID, description="ID of the purchase order.", required=True),
        description="Look up a purchase order by ID.",
    )
    purchase_order_lines = FilterInputConnectionField(
        PurchaseOrderLine,
        sort_by=PurchaseOrderLineSortingInput(description="Sort purchase order lines."),
        filter=PurchaseOrderLineFilterInput(
            description="Filtering options for purchase order lines."
        ),
        description="List of the shop's purchase order.",
    )
    purchase_order_line_count = graphene.Field(
        PurchaseOrderLineCount,
        description="발주품목 상태별 purchase order line 카운트",
        filter=graphene.Argument(
            PurchaseOrderLineCountFilterInput,
            required=True,
        ),
    )
    po_line_inspect_list = FilterInputConnectionField(
        PurchaseOrderLineInspect,
        filter=PurchaseOrderLineInspectFilterInput(),
        description="입고 검수 내역",
    )

    def resolve_purchase_order_line_count(root, _info, **kwargs):
        po_line_qs = models.PurchaseOrderLine.objects.all()
        filter = kwargs.get("filter")
        po_event_type = filter.get("po_event_type")
        if po_event_type:
            po_line_qs = po_line_qs.filter(purchase_order__event_type__in=po_event_type)
        vendor_id = filter.get("vendor_id")
        if vendor_id:
            _, vendor_pk = graphene.Node.from_global_id(vendor_id)
            po_line_qs = po_line_qs.filter(purchase_order__vendor_id=vendor_pk)
        is_b2b = filter.get("is_b2b")
        if is_b2b is not None:
            po_line_qs = po_line_qs.filter(purchase_order__is_b2b=is_b2b)

        delegated_management_q = Q(purchase_order__vendor__use_delegated_management_for_po=True)

        apply_delegated_filter = not is_b2b

        delegated_pending_filter = Q(status=PurchaseOrderLineStatus.PENDING)
        if apply_delegated_filter:
            delegated_pending_filter &= delegated_management_q

        delegated_received_courier_non_adjust_price_filter = (
            Q(status=PurchaseOrderLineStatus.RECEIVED)
            & Q(order_line__order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER])
            & Q(order_line__variant__is_adjust_price=False)
        )
        delegated_received_courier_adjust_price_filter = (
            Q(status=PurchaseOrderLineStatus.RECEIVED)
            & Q(order_line__order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER])
            & Q(order_line__variant__is_adjust_price=True)
        )
        if apply_delegated_filter:
            delegated_received_courier_non_adjust_price_filter &= delegated_management_q
            delegated_received_courier_adjust_price_filter &= delegated_management_q

        delegated_received_non_courier_filter = Q(status=PurchaseOrderLineStatus.RECEIVED) & ~Q(
            order_line__order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER]
        )
        if apply_delegated_filter:
            delegated_received_non_courier_filter &= delegated_management_q

        delegated_dispatch_fulfillment_filter = Q(
            status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT
        )
        if apply_delegated_filter:
            delegated_dispatch_fulfillment_filter &= delegated_management_q

        # 각 상태별 개수를 집계
        po_line_counts = po_line_qs.aggregate(
            draft_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.DRAFT)),
            pending_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.PENDING)),
            delegated_pending_count=Count("id", filter=delegated_pending_filter),
            rejected_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.REJECTED)),
            received_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.RECEIVED)),
            delegated_received_count_by_courier_non_adjust_price=Count(
                "id", filter=delegated_received_courier_non_adjust_price_filter
            ),
            delegated_received_count_by_courier_adjust_price=Count(
                "id", filter=delegated_received_courier_adjust_price_filter
            ),
            delegated_received_count_by_non_courier=Count(
                "id", filter=delegated_received_non_courier_filter
            ),
            req_split_delivery_count=Count(
                "id", filter=Q(status=PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY)
            ),
            req_epd_update_count=Count(
                "id", filter=Q(status=PurchaseOrderLineStatus.REQ_EPD_UPDATE)
            ),
            dispatch_fulfillment_count=Count(
                "id", filter=Q(status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT)
            ),
            delegated_dispatch_fulfillment_count=Count(
                "id", filter=delegated_dispatch_fulfillment_filter
            ),
            # 부분 배송확정된 건도 배송확정 페이지에 노출되므로 카운트 표시에는 부분배송확정 건도 포함
            delivery_confirmed_count=Count(
                "id",
                filter=Q(status=PurchaseOrderLineStatus.DELIVERY_CONFIRMED)
                | Q(status=PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED),
            ),
            invoice_printed_count=Count(
                "id", filter=Q(status=PurchaseOrderLineStatus.INVOICE_PRINTED)
            ),
            inspected_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.INSPECTED)),
            to_be_inspected_count=Count(
                "id", filter=Q(status=PurchaseOrderLineStatus.TO_BE_INSPECTED)
            ),
            stocked_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.STOCKED)),
            delivered_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.DELIVERED)),
            canceled_count=Count("id", filter=Q(status=PurchaseOrderLineStatus.CANCELED)),
        )

        consignment_courier_q = Q(status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT) & Q(
            order_line__order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER]
        )
        if apply_delegated_filter:
            consignment_courier_q &= delegated_management_q

        consignment_delegated_dispatch_fulfillment_count_by_courier = po_line_qs.filter(
            consignment_courier_q
        ).aggregate(count=Count("order_line__fulfillment_lines__id"))["count"]
        po_line_counts["consignment_delegated_dispatch_fulfillment_count_by_courier"] = (
            consignment_delegated_dispatch_fulfillment_count_by_courier
        )

        consignment_non_courier_q = Q(status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT) & ~Q(
            order_line__order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER]
        )
        if apply_delegated_filter:
            consignment_non_courier_q &= delegated_management_q

        consignment_delegated_dispatch_fulfillment_count_by_non_courier = po_line_qs.filter(
            consignment_non_courier_q
        ).aggregate(count=Count("order_line__fulfillment_lines__id"))["count"]
        po_line_counts["consignment_delegated_dispatch_fulfillment_count_by_non_courier"] = (
            consignment_delegated_dispatch_fulfillment_count_by_non_courier
        )

        return PurchaseOrderLineCount(**po_line_counts)

    def resolve_purchase_order(self, info, id):
        return graphene.Node.get_node_from_global_id(info, id, PurchaseOrder)

    def resolve_purchase_orders(self, info, **_kwargs):
        return resolve_purchase_orders(info, **_kwargs)

    def resolve_purchase_order_line(self, info, id):
        return graphene.Node.get_node_from_global_id(info, id, PurchaseOrderLine)

    def resolve_purchase_order_lines(self, info, **_kwargs):
        return resolve_purchase_order_lines(info, **_kwargs)

    def resolve_po_line_inspect_list(self, info, **_kwargs):
        return resolve_po_line_inspect_list(info, **_kwargs)


class PurchaseOrderMutations(graphene.ObjectType):
    purchase_order_create = PurchaseOrderCreate.Field()
    purchase_order_update = PurchaseOrderUpdate.Field()
    purchase_order_send = PurchaseOrderSend.Field()
    purchase_order_sent_email_create = PurchaseOrderSentEmailCreate.Field()
    purchase_order_lines_add = PurchaseOrderLinesAdd.Field()
    purchase_order_lines_receive = PurchaseOrderLinesReceive.Field()
    purchase_order_lines_reject = PurchaseOrderLinesReject.Field()
    purchase_order_lines_send = PurchaseOrderLinesSend.Field()
    purchase_order_lines_dispatch_fulfillment = PurchaseOrderLinesDispatchFulfillment.Field()
    purchase_order_lines_req_epd_update = PurchaseOrderLinesReqEpdUpdate.Field()
    purchase_order_lines_approve_req_epd_update = PurchaseOrderLinesApproveReqEpdUpdate.Field()
    purchase_order_line_req_split_delivery = PurchaseOrderLineReqSplitDelivery.Field()
    purchase_order_line_approve_req_split_delivery = (
        PurchaseOrderLineApproveReqSplitDelivery.Field()
    )
    purchase_order_lines_vendor_ordered = PurchaseOrderLinesVendorOrdered.Field()
    purchase_order_lines_delivery_confirmed = PurchaseOrderLinesDeliveryConfirmed.Field()
    purchase_order_lines_delivered = PurchaseOrderLinesDelivered.Field()
    purchase_order_lines_cancel = PurchaseOrderLinesCancel.Field()
    purchase_order_lines_invoice_print = PurchaseOrderLinesInvoicePrint.Field()
    purchase_order_lines_inspect = PurchaseOrderLinesInspect.Field()
    purchase_order_line_update = PurchaseOrderLineUpdate.Field()
    purchase_order_line_attach_delivery_confirm_doc = (
        PurchaseOrderLineAttachDeliveryConfirmDoc.Field()
    )
    purchase_order_line_bulk_update = PurchaseOrderLineBulkUpdate.Field()
    purchase_order_line_delete = PurchaseOrderLineDelete.Field()
    purchase_order_stock_lines_add = PurchaseOrderStockLinesAdd.Field()

    po_lines_invoice_sent_email_create = PoLinesInvoiceSentEmailCreate.Field()

