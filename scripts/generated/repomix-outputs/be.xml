import base64
import json
import logging
from urllib.parse import urljoin

import requests
from django.core.handlers.wsgi import WSGIRequest
from django.db import transaction
from django.http import Http404, JsonResponse
from django.utils import timezone
from dotmap import DotMap

from saleor.bbs.models import RefundInspect, RefundProductReturnTracking
from saleor.stats.models import CouriersDeliveryFee

from ...courier.models import Courier
from ...order import TrackingNumberType
from ...order.actions import fulfillment_set_tracking_number, update_or_create_picking_line
from ...order.models import Fulfillment
from ...stats.actions import (
    create_couriers_delivery_fee,
    create_couriers_delivery_fee_when_return,
    update_couriers_delivery_fee_when_print,
)
from .define import (
    REQUEST_OTP_URL,
    REQUEST_PRINT_URL,
    REQUEST_RETURN_CANCEL_URL,
    REQUEST_RETURN_URL,
    RESPONSE_PRINT_URL,
)
from .utils import (
    make_goodsflow_order_data,
    make_goodsflow_order_data_by_batch_picking_ids,
    make_goodsflow_return_cancel_data,
    parse_fulfillment_id_from_transUniqueCd,
)

logger = logging.getLogger(__name__)


def handle_webhook(request: WSGIRequest, config: any):
    full_path = request.get_full_path()
    if full_path.find(REQUEST_OTP_URL) != -1:
        return handle_request_otp(request, config)
    if full_path.find(REQUEST_PRINT_URL) != -1:
        return handle_request_print(request, config)
    if full_path.find(RESPONSE_PRINT_URL) != -1:
        return handle_response_print(request)
    if full_path.find(REQUEST_RETURN_CANCEL_URL) != -1:
        return handle_request_return_cancel(request, config)
    if full_path.find(REQUEST_RETURN_URL) != -1:
        return handle_request_return(request, config)

    raise Http404("path does not exist")


def build_api_header(config):
    headers = {
        "Content-Type": "application/json;charset=utf-8",
        "goodsFLOW-Api-Key": config.api_key,
        "Accept-charset": "UTF-8",
    }
    return headers


def handle_request_otp(request: WSGIRequest, config: any):
    headers = build_api_header(config)

    api_otp_url = urljoin(config.base_url, config.api_otp_url)
    api_otp_url = urljoin(api_otp_url, config.partner_code)
    response = requests.post(api_otp_url, headers=headers)
    response = response.json()
    return JsonResponse(response, safe=False)


def handle_request_print(request: WSGIRequest, config: any):
    response = request.body.decode("EUC-KR")
    jsonData = json.loads(response)
    is_retry = jsonData.get("isRetry", False) if jsonData else False
    is_picking_order = jsonData.get("isPickingOrder", False) if jsonData else False

    headers = build_api_header(config)

    try:
        if is_picking_order:
            batch_picking_ids = jsonData.get("batchPickingIds")
            data = make_goodsflow_order_data_by_batch_picking_ids(config, batch_picking_ids)
        else:
            fulfillment_ids = jsonData.get("selectedFulfillmentIds")
            only_selected = jsonData.get("onlySelected")
            if only_selected:
                data = make_goodsflow_order_data(config, is_retry, None, True, fulfillment_ids)
            else:
                if is_retry:
                    id = jsonData.get("fulfillmentId")
                    data = make_goodsflow_order_data(config, is_retry, id)
                else:
                    data = make_goodsflow_order_data(config)
    except Exception as e:
        logger.error(f"goodsflow order data 생성 실패: {e}")
        return JsonResponse(
            {"success": False, "error": {"message": f"goodsflow order data 생성 실패. {e}"}}
        )

    if data is None:
        return JsonResponse(
            {"success": False, "error": {"message": "goodsflow order data 생성 실패"}}
        )

    api_print_url = urljoin(config.base_url, config.api_print_url)
    api_print_url = urljoin(api_print_url, config.partner_code)
    response = requests.post(api_print_url, headers=headers, data=data)
    response = response.json()

    # response가 success인 경우에만 동작해야함.
    success = response.get("success", False)
    if success:
        jsonGoodsFlowData = json.loads(data)

        items = jsonGoodsFlowData.get("data").get("items")

        item_set = {}
        for dotMapItem in items:
            dotMapItem = DotMap(dotMapItem)
            transUniqueCd = dotMapItem.transUniqueCd
            item_set[f"{transUniqueCd}"] = dotMapItem

        for transUniqueCd in item_set:
            dotMapItem = item_set[f"{transUniqueCd}"]
            transUniqueCd = transUniqueCd
            fulfillment_id = parse_fulfillment_id_from_transUniqueCd(transUniqueCd)
            fulfillment: Fulfillment = Fulfillment.objects.filter(pk=fulfillment_id).first()
            create_couriers_delivery_fee(dotMapItem, fulfillment)

    return JsonResponse(response, safe=False)


def handle_request_return(request: WSGIRequest, config: any):
    response = request.body.decode("EUC-KR")
    jsonData = json.loads(response)
    headers = build_api_header(config)

    fulfillment_ids = jsonData.get("selectedFulfillmentIds")
    data = make_goodsflow_order_data(config, False, None, True, fulfillment_ids, True)
    config_base_url = None
    goodsFLOW_api_key = None

    if config.is_prod_mode == True:
        config_base_url = config.base_url
        goodsFLOW_api_key = config.api_key
    else:
        config_base_url = config.dev_base_url
        goodsFLOW_api_key = config.dev_api_key

    headers["goodsFLOW-Api-Key"] = goodsFLOW_api_key

    api_return_url = urljoin(config_base_url, config.api_return_url)
    api_return_url = urljoin(api_return_url, config.partner_code)
    response = requests.post(api_return_url, headers=headers, data=data)
    response = response.json()

    success = response.get("success", False)
    # 반품 신청 response가 success인 경우에만 동작해야함.
    if success:
        jsonGoodsFlowData = json.loads(data)

        items = jsonGoodsFlowData.get("data").get("items")

        item_set = {}
        for dotMapItem in items:
            dotMapItem = DotMap(dotMapItem)
            transUniqueCd = dotMapItem.transUniqueCd
            item_set[f"{transUniqueCd}"] = dotMapItem

        for transUniqueCd in item_set:
            transUniqueCd = transUniqueCd

            fulfillment_id = parse_fulfillment_id_from_transUniqueCd(transUniqueCd)
            fulfillment: Fulfillment = Fulfillment.objects.filter(pk=fulfillment_id).first()

            create_couriers_delivery_fee_when_return(fulfillment)

    return JsonResponse(response, safe=False)


def handle_request_return_cancel(request: WSGIRequest, config: any):
    request_data = request.body.decode("EUC-KR")
    json_data = json.loads(request_data)
    headers = build_api_header(config)

    trans_unique_cd = json_data.get("transUniqueCd")
    courier_delivery_id = json_data.get("id")
    config_base_url = config.base_url if config.is_prod_mode else config.dev_base_url
    goodsFLOW_api_key = config.api_key if config.is_prod_mode else config.dev_api_key

    headers["goodsFLOW-Api-Key"] = goodsFLOW_api_key

    api_return_url = urljoin(config_base_url, config.api_return_cancel_url)
    data = make_goodsflow_return_cancel_data(trans_unique_cd)
    response = requests.post(api_return_url, headers=headers, json=data)
    response = response.json()
    id = base64.b64decode(courier_delivery_id).decode("utf-8").split(":")[1]

    success = response.get("success", False)
    if success == False:
        return JsonResponse(response, safe=False)

    try:
        with transaction.atomic():
            couriers_delivery_find_row = CouriersDeliveryFee.objects.filter(pk=id).first()
            order_id = couriers_delivery_find_row.order_id
            fulfillment_id = couriers_delivery_find_row.fulfillment_id
            tracking_number = couriers_delivery_find_row.delivery_info["tracking_number"]

            # bbs_couriersdeliveryfee Table에서 반품취소에 필요한 column들 update
            couriers_delivery_find_row.is_return_cancel = True
            couriers_delivery_find_row.return_cancel_date = timezone.now()
            couriers_delivery_find_row.save()

            # bbs_refundinspect Table (반품 상품 검수 테이블)에 연관된 fulfillment_id row에 검수 완료 상태로 변경 및 메모에 "반품 취소로 인한 검수 불량 처리"
            refund_inspect_row = RefundInspect.objects.filter(fulfillment=fulfillment_id).first()

            refund_inspect_row.inspect = False
            refund_inspect_row.memo = "반품 취소로 인한 검수 불량 처리"
            refund_inspect_row.save()

            # bbs_refundproductreturntracking Table order_id, tracking_number 로 select해서 해당 row delete
            RefundProductReturnTracking.objects.filter(
                order=order_id, tracking_number=tracking_number
            ).first().delete()
    except Exception as e:
        logger.error(f"반품 취소 성공 후 데이터 처리 실패 Transaction rolled back due to: {e}")

    return JsonResponse(response, safe=False)


@transaction.atomic
def handle_response_print(request: WSGIRequest):
    response = request.body.decode("EUC-KR")
    jsonData = json.loads(response)
    data = jsonData.get("data")
    items = data.get("items")

    item_set = {}
    for dotMapItem in items:
        dotMapItem = DotMap(dotMapItem)
        transUniqueCd = dotMapItem.transUniqueCd
        item_set[f"{transUniqueCd}"] = dotMapItem

    save_count = 0
    picking_order_fulfillments = []

    for transUniqueCd in item_set:
        dotMapItem = item_set[f"{transUniqueCd}"]
        transUniqueCd = transUniqueCd
        code_goodsflow = dotMapItem.deliverCode
        tracking_number = dotMapItem.sheetNo

        # logger.info(f"goodsflow updated:{transUniqueCd}, {code_goodsflow}, {tracking_number}")

        fulfillment_id = parse_fulfillment_id_from_transUniqueCd(transUniqueCd)
        fulfillment: Fulfillment = Fulfillment.objects.filter(pk=fulfillment_id).first()
        courier = Courier.objects.filter(code_goodsflow=code_goodsflow).first()
        update_couriers_delivery_fee_when_print(fulfillment, courier, tracking_number)
        fulfillment_set_tracking_number(
            fulfillment, courier, tracking_number, TrackingNumberType.GOODSFLOW
        )
        save_count = save_count + 1
        if fulfillment.is_picking_order:
            picking_order_fulfillments.append(fulfillment)

    if picking_order_fulfillments:
        update_or_create_picking_line(picking_order_fulfillments, update_only=False)

    success = save_count > 0 and save_count == len(item_set)

    response = {
        "success": success,
        "message": (
            ""
            if success
            else f"출고 테이블에 운송장 정보 업데이트 실패가 존재합니다. 에러 개수: {len(item_set) - save_count}"
        ),
    }

    return JsonResponse(response, safe=False)
