class BrandStore(FranchiseContractInfo):
    created = models.DateTimeField(auto_now_add=True, null=True)
    code = models.CharField(unique=True, max_length=10)

    brand = models.ForeignKey(
        "account.Brand",
        related_name="brand_stores",
        on_delete=models.CASCADE,
    )

    # 매장명
    name = models.CharField(max_length=256)

    owner_user = models.OneToOneField(
        "account.User",
        related_name="owned_brand_store",
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
    )

    # 유형. 직영점 or 가맹점.
    type = models.CharField(
        max_length=20,
        choices=BrandStoreType.choices,
        default=BrandStoreType.FRANCHISEE,
    )

    # 상태. 준비, 운영, 운영중단 3가지 상태.
    status = models.CharField(
        max_length=20, choices=BrandStoreStatus.choices, default=BrandStoreStatus.OPERATING
    )

    # 연락처, 이메일은 점주/점장 User의 값 사용.

    # 계약. 신규, 양수, 명의변경 중 하나.
    contract = models.CharField(
        max_length=20,
        choices=BrandStoreContract.choices,
        default=BrandStoreContract.NEW,
    )

    # 세금 계산서 관련 정보. 이전 값들은 점장의 값들을 전부다 가져와서 그대로 넣는다. biz_reg_addr의 경우 property를 사용한다.
    biz_reg_no = models.CharField(max_length=10, blank=True, null=True)
    biz_reg_corp_name = models.CharField(max_length=200, blank=True, null=True)
    biz_reg_ceo_name = models.CharField(max_length=100, blank=True, null=True)
    biz_reg_biz_type = models.CharField(max_length=100, blank=True, null=True)
    biz_reg_biz_class = models.CharField(max_length=100, blank=True, null=True)

    # 운영정보. JSON Field dict로 사용. 일부는 char choice.
    operational_type = models.CharField(
        max_length=20,
        choices=OperationalType.choices,
        default=OperationalType.LIVELIHOOD,
    )
    operational_business_area = models.CharField(
        max_length=20,
        choices=OperationalBusiness.choices,
        default=OperationalBusiness.HOUSE,
    )
    operational_floor = models.CharField(
        max_length=20,
        choices=OperationalFloor.choices,
        default=OperationalFloor.OTHER,
    )
    operational_special_remarks = models.TextField(blank=True, null=True)
    # 아래 JSON필드 설명은 OperInfoInput 참조.
    operational_info = models.JSONField(
        null=True, blank=True, default=dict, encoder=CustomJsonEncoder
    )

    # 문서 정보(파일, 파일명)는 BrandStoreFranchiseDocument 모델에서 관리.
    # 계약 정보는 FranchiseContractInfo 추상 모델에서 관리.

    # 계약 정보. 계약일정
    # 계약일정. 계약시작일, 개점일, 계약종료예정일
    contract_date = models.DateField(null=True, blank=True)
    contract_start_date = models.DateField(null=True, blank=True)
    opening_date = models.DateField(null=True, blank=True)
    contract_expected_end_date = models.DateField(null=True, blank=True)

    # 계약 정보. 기타정보
    # 계약 이행 보증금
    contract_performance_deposit = models.PositiveIntegerField(null=True, blank=True)
    # 특약
    special_terms = models.TextField(blank=True, null=True)

    # 영업 구역 - 유저가 카카오 지도 통해 그린 다각형 영역 정보.
    service_area = models.JSONField(blank=True, default=list, encoder=CustomJsonEncoder)

    # 매장으로 전환된 예비창업자
    pre_founder = models.ForeignKey(
        "pre_founder.PreFounder",
        related_name="brand_stores",
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
    )

    def __str__(self):
        return f"{self.brand.name} - {self.name}"

    class Meta:
        ordering = ("name",)
        constraints = [
            models.UniqueConstraint(fields=["brand", "name"], name="unique_brand_name_per_brand")
        ]

    def save(self, *args, **kwargs):
        from saleor.graphql.brand_store.utils import generate_brand_store_code

        if self.code is None or self.code == "":
            while True:
                code = generate_brand_store_code()
                if not BrandStore.objects.filter(code=code).exists():
                    self.code = code
                    break

        try:
            super().save(*args, **kwargs)
        except IntegrityError as e:
            if "unique_brand_name_per_brand" in str(e):
                raise ValidationError("매장명이 기존의 매장과 중복입니다. 매장명을 변경해주세요.")
            raise
        except Exception as e:
            raise ValidationError(
                "매장 저장 중 알 수 없는 오류가 발생했습니다. 관리자에게 문의해주세요."
            )

    @property
    def address(self):
        # 매장 주소는 점장(OWNER)의 주소를 사용하며 없으면 None
        owner_user = self.owner_user

        return owner_user.brand_store_address_instance if owner_user else None

    @property
    def biz_reg_addr(self):
        brand_store_address = self.address
        return (
            f"{brand_store_address.street_address_1} {brand_store_address.street_address_2}"
            if brand_store_address
            else None
        )

    @property
    def email(self):
        # 매장 이메일은 점장(OWNER)의 이메일을 사용하며 없으면 None
        owner_user = self.owner_user

        return owner_user.email if owner_user else None

    @property
    def phone(self):
        # 매장 전화번호는 점장(OWNER)의 전화번호를 사용하며 없으면 None
        owner_user = self.owner_user

        return owner_user.aligo_phone if owner_user else None


class HqStaffBrandStore(models.Model):
    date = models.DateTimeField(default=now, editable=False)
    # 매장.
    brand_store = models.ForeignKey(
        BrandStore,
        related_name="hq_staff_brand_stores",
        on_delete=models.CASCADE,
    )

    # User의 id.
    user = models.ForeignKey(
        "account.User",
        related_name="hq_staff_brand_stores",
        on_delete=models.CASCADE,
    )

    # 권한. 본부 직원의 권한. 본부 직원은 매장에 대한 역할을 가질 수 있다. 주, 부 담당자.
    role = models.CharField(
        max_length=20,
        choices=HqStaffBrandStoreRoleType.choices,
        default=HqStaffBrandStoreRoleType.MAIN,
        blank=True,
    )

    def save(self, *args, **kwargs):
        # 만약 MAIN이라면 기존의 MAIN은 SUB로 변경한다. 주 담당자는 1명만..
        if self.role == HqStaffBrandStoreRoleType.MAIN:
            # 기존의 MAIN은 SUB로 변경한다.
            HqStaffBrandStore.objects.filter(
                brand_store=self.brand_store,
                role=HqStaffBrandStoreRoleType.MAIN,
            ).update(role=HqStaffBrandStoreRoleType.SUB)
        super().save(*args, **kwargs)

    class Meta:
        constraints = [
            models.UniqueConstraint(fields=["brand_store", "user"], name="unique_brandstore_user"),
            # brand_store에 MAIN role을 가진 건 단 하나만
            models.UniqueConstraint(
                fields=["brand_store"],
                condition=Q(role=HqStaffBrandStoreRoleType.MAIN),
                name="unique_main_role_per_brandstore",
            ),
        ]


class BrandStoreUser(models.Model):
