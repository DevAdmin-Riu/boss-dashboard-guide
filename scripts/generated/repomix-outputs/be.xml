        refund_delivery_additional_fee = refund_data.refund_delivery_additional_fee
        order.final_brand_total_cost_price_amount = (
            order.final_brand_total_cost_price_amount - refund_brand_total_cost_price
        )
        order.final_brand_total_delivery_fee_amount = (
