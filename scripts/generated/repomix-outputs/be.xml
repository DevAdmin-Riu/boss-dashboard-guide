    def get_type_for_model(cls):
        return BpBundleInfo

    @classmethod
    def post_save_action(cls, info, instance: BpBundleInfoModel, cleaned_input):
        bp_bundle: BpBundleModel = instance.bp_bundle
        is_main_exist = bp_bundle.bp_bundle_infos.filter(is_main=True).exists()
        if not is_main_exist:
            instance.is_main = True
