    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        stock_detail_id = input_data.get("stock_detail")
        stock_detail: StockDetailModel = graphene.Node.get_node_from_global_id(
            info, stock_detail_id, only_type=StockDetail
        )
        if stock_detail is None:
            raise ValidationError("존재하지 않는 제품 stock detail id 입니다.")
        stock: StockModel = stock_detail.stock
        if stock.product_variant.product.is_fulfilled_by_vendor:
            raise ValidationError("직거래 상품은 재고 이동이 불가합니다.")

        from_rack_location_id = input_data.get("from_rack_location")
        from_rack_location: RackLocationModel = graphene.Node.get_node_from_global_id(
            info, from_rack_location_id, only_type=RackLocation
        )
        if from_rack_location is None:
            raise ValidationError("존재하지 않는 제품 rack location id 입니다.")

        from_quantity = input_data.get("from_quantity")

        from_rack_stock_detail: RackStockDetailModel = models.RackStockDetail.objects.filter(
            location=from_rack_location, stock_detail=stock_detail
        ).first()
        if from_rack_stock_detail is None:
            raise ValidationError("이동할 로케이션에 선택된 재고번호가 존재하지 않습니다.")
        if from_rack_stock_detail.remain_quantity < from_quantity:
            raise ValidationError(
                "로케이션 데이터에 남아 있는 재고량 보다 많이 이동할 수 없습니다."
            )

        to_details = cls.clean_details(info=info, input_data=input_data)

        sum_of_to_quantity = sum([detail.get("to_quantity") for detail in to_details])
        if from_quantity != sum_of_to_quantity:
            raise ValidationError("이동할 수량과 이동될 로케이션 수량의 합이 일치하지 않습니다.")

        from_rack_stock_detail.decrease_remain_stock(from_quantity)
        to_location_qty_info_list = []
        for detail in to_details:
            to_rack_location = detail.get("to_rack_location")
            to_quantity = detail.get("to_quantity")
            add_to_rack_stock_detail(
                location=to_rack_location,
                stock_detail=stock_detail,
                quantity=to_quantity,
                product_variant=stock.product_variant,
                source_rsd=from_rack_stock_detail,
            )
            to_location_qty_info_list.append(f"{to_rack_location.name}: {to_quantity}")

        requestor = info.context.user
        reason = input_data.get("reason", "-")
        create_move_stock_detail_event(
            stock=stock,
            stock_detail=stock_detail,
            user=requestor,
            from_quantity=from_quantity,
            reason=reason,
            from_location=from_rack_location.name,
            to_location_qty_info=", ".join(to_location_qty_info_list),
        )

