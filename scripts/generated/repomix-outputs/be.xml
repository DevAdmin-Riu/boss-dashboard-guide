class PvEstimateBulkUpdateInput(graphene.InputObjectType):
    details = graphene.List(
        PvEstimateBulkUpdateDetail,
        required=True,
        description="견적 관리 수정 정보",
    )


class PvEstimateBulkUpdate(BaseMutation):
    class Arguments:
        input = PvEstimateBulkUpdateInput(required=True, description="견적 관리 수정 정보 리스트")

    class Meta:
        description = "견적관리 bulk update"
        error_type_class = ProductError
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        code = detail.get("code")
        return f"{code}"

    @classmethod
    def validate_code(cls, details) -> Dict[str, PvEstimateModel]:
        errors = []
        codes = set()
        for detail in details:
            code = detail.get("code")
            codes.add(code)

        sorted_codes = sorted(codes)
        pv_estimate_dict = {}
        for code in sorted_codes:
            try:
                prefix = PvEstimateModel.ID_PREFIX
                if code.startswith(prefix):
                    prefix_length = len(prefix)
                    pk_value = code[prefix_length:]
                    pv_estimate = PvEstimateModel.objects.get(id=pk_value)
                    pv_estimate_dict[code] = pv_estimate
                else:
                    errors.append(code)
            except Exception:
                errors.append(code)
                continue

        if len(errors) > 0:
            error_msg = "견적관리 코드 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

        return pv_estimate_dict

    @classmethod
    def validate_pv_estimate_dict(
        cls,
        pv_estimate_dict: Dict[str, PvEstimateModel],
    ):
        errors = []
        for code, pv_estimate in pv_estimate_dict.items():
            if pv_estimate.type == PvEstimateType.OLD or pv_estimate.status == PvEstimateStatus.NA:
                errors.append(code)
        if errors:
            error_msg = "기등록 견적 관리의 상태는 변경할 수 없습니다: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_status(
        cls,
        details,
    ):
        errors = []
        for detail in details:
            status = detail.get("status")
            if status not in [
                PvEstimateStatus.APPROVED,
                PvEstimateStatus.REJECTED,
            ]:
                code = cls.make_detail_code(detail)
                errors.append(f"{code}: {status}")
        if errors:
            error_msg = "변경 불가 상태 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        pv_estimate_dict = cls.validate_code(details)
        cls.validate_pv_estimate_dict(pv_estimate_dict)
        cls.validate_status(details)
        return details, pv_estimate_dict

    @classmethod
    def update_pv_estimates(
        cls,
        details,
        pv_estimate_dict: Dict[str, PvEstimateModel],
    ):
        update_list = []
        for detail in details:
            code = detail.get("code")
            status = detail.get("status")
            pv_estimate = pv_estimate_dict[code]
            pv_estimate.status = status
            # AI 임베딩 생성
            searchable_text = pv_estimate.get_searchable_text()
            if searchable_text:
                ai_model = get_estimate_embedding_model()
                embedding = ai_model.encode(searchable_text)
                pv_estimate.embedding = embedding
            else:
                pv_estimate.embedding = None

            update_list.append(pv_estimate)
        if update_list:
            models.PvEstimate.objects.bulk_update(update_list, ["status"], batch_size=3000)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        details, pv_estimate_dict = cls.clean_details(info, input_data)
        cls.update_pv_estimates(details=details, pv_estimate_dict=pv_estimate_dict)
        return PvEstimateBulkUpdate()
