def get_model_fields_for_generate_change(model, exclude_fields=None, noManyToMany=False):
    """
    주어진 모델의 모든 필드 이름을 반환합니다.
    특정 필드 이름은 제외할 수 있습니다.

    Args:
        model: Django 모델 클래스
        exclude_fields (list): 제외할 필드 이름 리스트 (기본값: None)

    Returns:
        list: 필드 이름 리스트
    """
    if exclude_fields is None:
        exclude_fields = []
    field_list = [field for field in model._meta.get_fields() if field not in exclude_fields]
    # exclude_fields중에서 str만 모은다.
    exclude_fields_str = [field for field in exclude_fields if isinstance(field, str)]
    # str list는 name으로 한번더 걸러준다.
    field_list = [field for field in field_list if field.name not in exclude_fields_str]
    if noManyToMany:
        field_list = [field for field in field_list if not field.many_to_many]
    return field_list


def generate_change_summary(
    before_instance,
    after_instance,
    before_m2m_and_related_values,
    after_m2m_and_related_values,
    exclude_fields,
    field_mapping,
    noManyToMany=False,
):
    changes = []

    def append_changes_for_m2m_and_reverse_related_field(cur_field, cur_changes):
        if before_m2m_and_related_values is None or after_m2m_and_related_values is None:
            return cur_changes
        if cur_field.name == "directly_attributes":
            return cur_changes
        before_values = before_m2m_and_related_values.get(cur_field.name, [])
        after_values = after_m2m_and_related_values.get(cur_field.name, [])
        before_values_set = set(before_values)
        after_values_set = set(after_values)

        added_items = after_values_set - before_values_set
        removed_items = before_values_set - after_values_set

        if added_items or removed_items:
            if cur_field.name == "main_pvs_relation":
                added_items = {item.main_pv for item in added_items}
                removed_items = {item.main_pv for item in removed_items}
            added_str = ", ".join(str(item) for item in added_items)
            removed_str = ", ".join(str(item) for item in removed_items)
            field_display_name = field_mapping.get(cur_field.name, cur_field.name)
            if added_str and removed_str:
                cur_changes.append(
                    f"{field_display_name}: 추가 [{added_str}] | 제거 [{removed_str}]"
                )
            elif added_str:
                cur_changes.append(f"{field_display_name}: 추가 [{added_str}]")
            elif removed_str:
                cur_changes.append(f"{field_display_name}: 제거 [{removed_str}]")
        return cur_changes

    def append_changes_for_normal_or_one_field(cur_field, cur_changes):
        before_value = getattr(before_instance, cur_field.name, None)
        after_value = getattr(after_instance, cur_field.name, None)

        # Choices 필드 처리
        if hasattr(cur_field, "choices") and cur_field.choices:
            before_value = dict(cur_field.choices).get(before_value, before_value)
            after_value = dict(cur_field.choices).get(after_value, after_value)

        # 필드 표시 이름 설정
        field_display_name = field_mapping.get(cur_field.name, cur_field.name)

        # list 요소 중 값이 바뀐 요소만 before_value, after_value로 재할당한다.
        if isinstance(before_value, list) and isinstance(after_value, list):
            before_value_new = [item for item in before_value if item not in after_value]
            after_value_new = [item for item in after_value if item not in before_value]
            before_value = before_value_new
            after_value = after_value_new

        # 값이 변경된 경우 추가
        if before_value != after_value:
            if field.name == "sub_pv_relation":
                before_value = before_value.sub_pv if before_value else None
                after_value = after_value.sub_pv if after_value else None

            before_value = "없음" if before_value is None else before_value
            after_value = "없음" if after_value is None else after_value
            cur_changes.append(f"{field_display_name}: {before_value} -> {after_value}")

        return cur_changes

    if before_instance and after_instance:
        model = type(before_instance)

        fields = get_model_fields_for_generate_change(model, exclude_fields, noManyToMany)

        for field in fields:
            if field.name == "attributes":
                if before_m2m_and_related_values is None or after_m2m_and_related_values is None:
                    continue
                before_values = before_m2m_and_related_values.get(field.name, [])
                after_values = after_m2m_and_related_values.get(field.name, [])
                before_dict = {item["name"]: item["value"] for item in before_values}
                after_dict = {item["name"]: item["value"] for item in after_values}

                for name in before_dict.keys() | after_dict.keys():  # 두 딕셔너리의 키 합집합 순회
                    before_value = before_dict.get(name, "없음")
                    after_value = after_dict.get(name)

                    if before_value != after_value:  # 값이 다를 경우 변경 내용을 추가
                        changes.append(f"{name} : {before_value} -> {after_value}")

            # Many-to-Many 필드 및 역방향 참조 처리
            elif field.many_to_many:
                changes = append_changes_for_m2m_and_reverse_related_field(field, changes)
            elif field.is_relation:
                if field.one_to_one or field.many_to_one:
                    changes = append_changes_for_normal_or_one_field(field, changes)
                else:
                    changes = append_changes_for_m2m_and_reverse_related_field(field, changes)
            # 일반필드
            else:
                changes = append_changes_for_normal_or_one_field(field, changes)

    return changes


def get_name_value_attributes_of_product_or_variant(
    *, model, m2m_values, instance, relation_name, related_field_name
):
    """
    특정 모델 인스턴스와 관련된 M2M 필드에서 name-value 형식의 데이터를 추출합니다.

    Args:
        model (Model): Django 모델 클래스.
        m2m_values (dict): Many-to-Many 필드와 관련된 값들.
        instance (Model): Django 모델 인스턴스 (예: Product 또는 ProductVariant).
        relation_name (str): 조회할 M2M 관계 이름.
        related_field_name (str): instance를 참조하는 필드 이름 (예: 'product' 또는 'variant').

    Returns:
        list: [{ "name": name, "value": [values...] }] 형식의 리스트.
    """
    related_m2m_values = m2m_values.get(relation_name, [])

    # 필드 이름에 따라 필터 동적으로 설정
    filter_kwargs = {
        related_field_name: instance,
        "assignment__in": related_m2m_values,
    }

    # M2M 필드를 통해 연결된 `AssignedProductAttribute` 데이터를 가져옴
    assigned_attributes = model.objects.filter(**filter_kwargs)

    # Name-Value 형식의 데이터를 생성
    name_value_list = [
        {
            "name": assigned_attribute.assignment.attribute.name,
            "value": (
                [value.name for value in assigned_attribute.values.all()]
                if hasattr(assigned_attribute, "values")
                else [assigned_attribute.value]
            ),
        }
        for assigned_attribute in assigned_attributes
    ]

    return name_value_list


def prepare_m2m_and_related_values(product=None, variant=None):
    """
    주어진 product와 variant에서 M2M 필드 및 관계형(Relation) 필드 값을 준비하여 반환합니다.

    Args:
        product (Model, optional): Product 모델 인스턴스.
        variant (Model, optional): ProductVariant 모델 인스턴스.

    Returns:
        tuple: (product_values, variant_values)
    """

    def prepare_values(
        instance,
        assigned_model,
        directly_assigned_model,
        relation_name,
        directly_relation_name,
        related_field_name,
    ):
        values = {}

        if instance:
            for field in instance._meta.get_fields():
                if not hasattr(instance, field.name):
                    continue

                # Many-to-Many 필드 처리
                if field.many_to_many:
                    values[field.name] = list(getattr(instance, field.name).all())
                # 역방향 참조(RelatedManager) 필드 처리
                elif field.is_relation:
                    related_object = getattr(instance, field.name)
                    # One-to-One 역방향 참조 처리
                    if field.one_to_one:
                        values[field.name] = related_object
                    # RelatedManager 처리 (e.g., ForeignKey의 역방향)
                    elif isinstance(related_object, models.Manager):
                        values[field.name] = list(related_object.all())
                # 일반 Relation 필드 처리 (ForeignKey 등)
                else:
                    values[field.name] = getattr(instance, field.name, None)

        # Assigned attributes
        assigned_attributes = get_name_value_attributes_of_product_or_variant(
            model=assigned_model,
            m2m_values=values,
            instance=instance,
            relation_name=relation_name,
            related_field_name=related_field_name,
        )

        # Directly assigned attributes
        directly_assigned_attributes = get_name_value_attributes_of_product_or_variant(
            model=directly_assigned_model,
            m2m_values=values,
            instance=instance,
            relation_name=directly_relation_name,
            related_field_name=related_field_name,
        )

        # Remove processed keys
        values.pop(relation_name, None)
        values.pop(directly_relation_name, None)

        values["attributes"] = assigned_attributes + directly_assigned_attributes

        return values

    product_values = (
        prepare_values(
            product,
            AssignedProductAttribute,
            DirectlyAssignedProductAttribute,
            "attributesrelated",
            "directlyattributesrelated",
            "product",
        )
        if product
        else {}
    )

    variant_values = (
        prepare_values(
            variant,
            AssignedVariantAttribute,
            DirectlyAssignedVariantAttribute,
            "attributesrelated",
            "directlyattributesrelated",
            "variant",
        )
        if variant
        else {}
    )

    return product_values, variant_values


def make_total_change_summary_for_product_and_variant(
    *,
    before_variant,
    before_inner_variant,
    before_product,
    before_product_m2m_and_related_values,
    before_variant_m2m_and_related_values,
    updated_variant,
    updated_product,
):
    from .mutations.products import ExtendedProductUpdate

    updated_inner_variant = updated_variant.inner if updated_variant else None

    (
        updated_product_m2m_and_related_values,
        updated_variant_m2m_and_related_values,
    ) = prepare_m2m_and_related_values(updated_product, updated_variant)

    # 변경 내역 생성
    product_changes = generate_change_summary(
        before_product,
        updated_product,
        before_product_m2m_and_related_values,
        updated_product_m2m_and_related_values,
        ExtendedProductUpdate.EXCLUDE_FIELDS_FOR_PRODUCT,
        ExtendedProductUpdate.FIELD_NAME_MAPPING_FOR_PRODUCT,
    )
    variant_changes = generate_change_summary(
        before_variant,
        updated_variant,
        before_variant_m2m_and_related_values,
        updated_variant_m2m_and_related_values,
        ExtendedProductUpdate.EXCLUDE_FIELDS_FOR_VARIANT,
        ExtendedProductUpdate.FIELD_NAME_MAPPING_FOR_VARIANT,
    )
    inner_variant_changes = generate_change_summary(
        before_inner_variant,
        updated_inner_variant,
        {},
        {},
        ExtendedProductUpdate.EXCLUDE_FIELDS_FOR_VARIANT,
        ExtendedProductUpdate.FIELD_NAME_MAPPING_FOR_VARIANT,
        True,
    )
    # inner_variant_changes에서 models.ProductVariant.can_sale_by_inner.field.name에 해당 하는 값을 제거한다.
    inner_variant_changes = [
        change
        for change in inner_variant_changes
        if not change.startswith(
            ExtendedProductUpdate.FIELD_NAME_MAPPING_FOR_VARIANT.get(
                ProductVariant.can_sale_by_inner.field.name
            )
        )
    ]
    # 변경사항존재 & 이너박스 운영여부 True인 경우에만
    inner_variant_changes = (
        ["", "이너박스 변경 사항"] + inner_variant_changes
        if inner_variant_changes and updated_variant.can_sale_by_inner
        else []
    )

    return product_changes, variant_changes, inner_variant_changes


def filter_pv_estimate_search_factory(
    *,
    field_name="pk",
):
    def filter_pv_estimate_search(qs, name, value):
        if not value:
            return qs

        prefix = PvEstimate.ID_PREFIX
        value = value.strip()

        # 여러 개의 값이 입력된 경우 ('\n' 포함된 경우)
        query_values = [v.strip() for v in value.split("\n") if v.strip()]
        query_objects = Q()

        for query in query_values:
            if query.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = query[prefix_length:].strip()  # 접두사 제거 후 검색

                if not pk_value:
                    raise ValidationError(f"견적ID 형식을 확인해 주세요. {query}")

                try:
                    pk = pk_value
                    query_objects |= Q(**{field_name: pk})
                except ValueError:
                    raise ValidationError(f"견적ID 형식을 확인해 주세요. {query}")
            else:
                raise ValidationError(f"견적ID 형식을 확인해 주세요. {query}")
        return qs.filter(query_objects).distinct()

    return filter_pv_estimate_search


def count_outer_visible_products(products: "QuerySet[Product]"):
    from .types.products import OuterVisibleProductCountInfo

    boss_quantity_total = sum(1 for p in products if not p.is_fulfilled_by_vendor)
    fbv_quantity_total = sum(1 for p in products if p.is_fulfilled_by_vendor)
    return OuterVisibleProductCountInfo(
        boss_quantity_total=boss_quantity_total,
        fbv_quantity_total=fbv_quantity_total,
    )
