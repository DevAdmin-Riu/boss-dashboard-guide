    mail_title_for_log = "신규 식자재 요청 메일 발송"
    recipient_list = []
    if staff_email:
        recipient_list.append(staff_email)

    if len(recipient_list) == 0:
        logger.info(f"{mail_title_for_log}을 위한 담당MD 이메일 설정을 확인하세요. {context}")
        return

    send_kwargs, ctx = get_email_context()
