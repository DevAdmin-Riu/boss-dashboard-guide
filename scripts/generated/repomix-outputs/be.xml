def get_result_by_user_using_brand_store(
    info, root, func_when_brand_store_user, result_when_not_owner
):
    def get_result_by_brand_store_user(brand_store_user):
        return (
            BrandStoreByIdLoader(info.context)
            .load(brand_store_user.brand_store_id)
            .then(
                lambda brand_store: (
                    func_when_brand_store_user(brand_store) if brand_store else None
                )
            )
        )

    return (
        BrandStoreUserByUserIdLoader(info.context)
        .load(root.id)
        .then(
            lambda brand_store_user: (
                get_result_by_brand_store_user(brand_store_user)
                if brand_store_user
                else result_when_not_owner
            )
        )
    )


