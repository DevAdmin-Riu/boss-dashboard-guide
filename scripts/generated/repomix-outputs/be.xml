class CustomerRefundQuestionProductReturned(BaseMutation):
    refund_question = graphene.Field(RefundQA, description="RefundQA instance")

    class Arguments:
        id = graphene.ID(required=True, description="교환/반품/취소 문의 사항 ID")

    class Meta:
        description = "교환/반품에 대한 상품 회수를 할 때 상품 받은 일시 업데이트"
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def post_save_action(cls, info, instance: RefundQAModel):
        models.RefundQAHistory.objects.create(
            refund_qa=instance,
            user=info.context.user,
            status=RefundStatusType.REFUND_PENDING,
        )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        id = data.get("id")
        refund_qa: RefundQAModel = cls.get_node_or_error(info, id, only_type=RefundQA)

        if refund_qa.status != RefundStatusType.COLLECTED_INSPECT:
            raise ValidationError("회수 및 검수 상태가 아닙니다.")
        if refund_qa.is_product_returned != True:
            raise ValidationError("상품 회수 승인건이 아닙니다.")

        if refund_qa.status == RefundStatusType.STOCK_INCLUDED_REQUESTED:
            # 재고 포함 요청 상태일 때 재고포함 승인으로 변경
            refund_qa.status = RefundStatusType.STOCK_INCLUDED_APPROVED
        else:
            # 환불 대기 상태로 변경
            refund_qa.status = RefundStatusType.REFUND_PENDING
        refund_qa.product_returned_at = kst_datetime()
        refund_qa.save(update_fields=["product_returned_at", "status"])
