import os
import uuid

from .kst_time import kst_timezone_now


def make_unique_filename(filename):
    filename_split = filename.split(".")
    if len(filename_split) > 1:
        ext = filename_split[-1]
        name = "".join(filename_split[:-1])
    else:
        ext = None
        name = filename
    now = kst_timezone_now()
    now_timestamp = int(now.timestamp())

    new_file_name = (
        f"{name}_{now_timestamp}_{uuid.uuid4()}.{ext}"
        if ext
        else f"{name}_{now_timestamp}_{uuid.uuid4()}"
    )

    return new_file_name


