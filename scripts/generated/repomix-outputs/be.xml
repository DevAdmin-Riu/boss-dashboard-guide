class SelectedAttributesByProductIdLoader(DataLoader):
    context_key = "selectedattributes_by_product"

    def batch_load(self, keys):
        def with_products_and_assigned_attributes(
            result: Tuple[
                List[Product],
                List[List[AssignedProductAttribute]],
                List[List[DirectlyAssignedProductAttribute]],
            ]
        ):
            products, assigned_attributes, directly_assigned_attributes = result
            assigned_product_attribute_ids = [a.id for attrs in assigned_attributes for a in attrs]
            product_type_ids = list({p.product_type_id for p in products})
            assigned_attributes_dict = dict(zip(keys, assigned_attributes))
            directly_assigned_attributes_dict = dict(zip(keys, directly_assigned_attributes))

            def with_attributeproducts_and_values(
                result: Tuple[List[List[AttributeProduct]], List[List[AttributeValue]]]
            ):
                attribute_products, attribute_values = result
                attribute_ids = list({ap.attribute_id for aps in attribute_products for ap in aps})
                attribute_products_dict = dict(zip(product_type_ids, attribute_products))
                attribute_values_dict = dict(zip(assigned_product_attribute_ids, attribute_values))

                def with_attributes(attributes: List[Attribute]):
                    id_to_attribute_dict = dict(zip(attribute_ids, attributes))
                    selected_attributes_map = defaultdict(list)
                    for key, product in zip(keys, products):
                        attribute_products_by_product_type = attribute_products_dict[
                            product.product_type_id
                        ]
                        assigned_product_attributes = assigned_attributes_dict[key]
                        directly_assigned_product_attributes = directly_assigned_attributes_dict[
                            key
                        ]
                        for attribute_product in attribute_products_by_product_type:
                            attribute = id_to_attribute_dict[attribute_product.attribute_id]
                            if attribute.is_directly_assigned:
                                directly_assigned_product_attribute: (
                                    DirectlyAssignedProductAttribute
                                ) = next(
                                    (
                                        apa
                                        for apa in directly_assigned_product_attributes
                                        if apa.assignment_id == attribute_product.id
                                    ),
                                    None,
                                )
                                directly_assigned_value = (
                                    directly_assigned_product_attribute.value
                                    if directly_assigned_product_attribute
                                    else ""
                                )
                                values = [
                                    AttributeValue(
                                        name=directly_assigned_value,
                                        slug=None,
                                    )
                                ]
                            else:
                                assigned_product_attribute: AssignedProductAttribute = next(
                                    (
                                        apa
                                        for apa in assigned_product_attributes
                                        if apa.assignment_id == attribute_product.id
                                    ),
                                    None,
                                )
                                if assigned_product_attribute:
                                    values = attribute_values_dict[assigned_product_attribute.id]
                                else:
                                    values = []
                            selected_attributes_map[key].append(
                                {"values": values, "attribute": attribute}
                            )
                    return [selected_attributes_map[key] for key in keys]

                return (
                    AttributeByIdLoader(self.context).load_many(attribute_ids).then(with_attributes)
                )

            attribute_products = AttributeProductsByProductTypeIdLoader(self.context).load_many(
                product_type_ids
            )
            attribute_values = AttributeValuesByAssignedProductAttributeIdLoader(
                self.context
            ).load_many(assigned_product_attribute_ids)
            return Promise.all([attribute_products, attribute_values]).then(
                with_attributeproducts_and_values
            )

        products = ProductByIdAllLoader(self.context).load_many(keys)
        assigned_attributes = AssignedProductAttributesByProductIdLoader(self.context).load_many(
            keys
        )
        directly_assigned_attributes = DirectlyAssignedProductAttributesByProductIdLoader(
            self.context
        ).load_many(keys)

        return Promise.all([products, assigned_attributes, directly_assigned_attributes]).then(
            with_products_and_assigned_attributes
        )


class SelectedAttributesByProductVariantIdLoader(DataLoader):
    context_key = "selectedattributes_by_productvariant"

    def batch_load(self, keys):
        def with_variants_and_assigned_attributed(
            results: Tuple[
                List[ProductVariant],
                List[AssignedVariantAttribute],
                List[DirectlyAssignedVariantAttribute],
            ]
        ):
            product_variants, assigned_attributes, directly_assigned_attributes = results
            product_ids = list({v.product_id for v in product_variants})
            assigned_variant_attribute_ids = [a.id for attrs in assigned_attributes for a in attrs]
            assigned_attributes_dict = dict(zip(keys, assigned_attributes))
            directly_assigned_attributes_dict = dict(zip(keys, directly_assigned_attributes))

            def with_products_and_attribute_values(
                results: Tuple[List[Product], List[List[AttributeValue]]]
            ):
                products, attribute_values = results
                product_type_ids = list({p.product_type_id for p in products})
                products_dict = dict(zip(product_ids, products))
                attribute_values_dict = dict(zip(assigned_variant_attribute_ids, attribute_values))

                def with_attribute_variants(attribute_variants: List[List[AttributeVariant]]):
                    attribute_ids = list(
                        {ap.attribute_id for aps in attribute_variants for ap in aps}
                    )
                    attribute_variants_dict = dict(zip(product_type_ids, attribute_variants))

                    def with_attributes(attributes: List[Attribute]):
                        id_to_attribute_dict = dict(zip(attribute_ids, attributes))
                        selected_attributes_map = defaultdict(list)
                        for key, product_variant in zip(keys, product_variants):
                            product = products_dict[product_variant.product_id]
                            attribute_variants_by_product_type = attribute_variants_dict[
                                product.product_type_id
                            ]
                            assigned_variant_attributes = assigned_attributes_dict[key]
                            directly_assigned_variant_attributes = (
                                directly_assigned_attributes_dict[key]
                            )
                            for attribute_variant in attribute_variants_by_product_type:
                                attribute = id_to_attribute_dict[attribute_variant.attribute_id]
                                if attribute.is_directly_assigned:
                                    directly_assigned_variant_attribute: (
                                        DirectlyAssignedVariantAttribute
                                    ) = next(
                                        (
                                            apa
                                            for apa in directly_assigned_variant_attributes
                                            if apa.assignment_id == attribute_variant.id
                                        ),
                                        None,
                                    )
                                    directly_assigned_value = (
                                        directly_assigned_variant_attribute.value
                                        if directly_assigned_variant_attribute
                                        else ""
                                    )
                                    values = [
                                        AttributeValue(
                                            name=directly_assigned_value,
                                            slug=None,
                                        )
                                    ]
                                else:
                                    assigned_variant_attribute: AssignedVariantAttribute = next(
                                        (
                                            apa
                                            for apa in assigned_variant_attributes
                                            if apa.assignment_id == attribute_variant.id
                                        ),
                                        None,
                                    )
                                    if assigned_variant_attribute:
                                        values = attribute_values_dict[
                                            assigned_variant_attribute.id
                                        ]
                                    else:
                                        values = []
                                selected_attributes_map[key].append(
                                    {"values": values, "attribute": attribute}
                                )
                        return [selected_attributes_map[key] for key in keys]

                    return (
                        AttributeByIdLoader(self.context)
                        .load_many(attribute_ids)
                        .then(with_attributes)
                    )

                return (
                    AttributeVariantsByProductTypeIdLoader(self.context)
                    .load_many(product_type_ids)
                    .then(with_attribute_variants)
                )

            products = ProductByIdAllLoader(self.context).load_many(product_ids)
            attribute_values = AttributeValuesByAssignedVariantAttributeIdLoader(
                self.context
            ).load_many(assigned_variant_attribute_ids)

            return Promise.all([products, attribute_values]).then(
                with_products_and_attribute_values
            )

        product_variants = ProductVariantByIdLoader(self.context).load_many(keys)
        assigned_attributes = AssignedVariantAttributesByProductVariantId(self.context).load_many(
            keys
        )
        directly_assigned_attributes = DirectlyAssignedVariantAttributesByProductVariantId(
            self.context
        ).load_many(keys)

        return Promise.all(
            [product_variants, assigned_attributes, directly_assigned_attributes]
        ).then(with_variants_and_assigned_attributed)
