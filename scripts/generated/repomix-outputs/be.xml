from datetime import timedelta

from ..celeryconf import app
from ..core.utils.kst_time import kst_timezone_date
from . import EXP_DATE_WARNING_THRESHOLD
from .models import StockDetail, StockDetailExpDateStatus


# 매일 1시에 호출되어 유통기한 상태 관리
@app.task(name="warehouse.tasks.set_exp_date_status")
def set_exp_date_status():
    today = kst_timezone_date()
    warning_threshold = today + timedelta(days=EXP_DATE_WARNING_THRESHOLD)

    # 정상 상태: 유통기한이 warning_threshold 이후인 경우
    StockDetail.objects.filter(exp_date__gte=warning_threshold).update(
        exp_date_status=StockDetailExpDateStatus.NORMAL
    )

    # 위험 상태: 유통기한이 내일 ~ warning_threshold 이내인 경우
    StockDetail.objects.filter(exp_date__gt=today, exp_date__lt=warning_threshold).update(
        exp_date_status=StockDetailExpDateStatus.WARNING
    )

    # 초과 상태: 유통기한이 오늘 이전인 경우
    StockDetail.objects.filter(exp_date__lte=today).update(
        exp_date_status=StockDetailExpDateStatus.EXCEEDED
    )
