    from ..stats.tasks import get_stock_status_by_daily_filtered_pv_qs

    update_pv_list = []
    pv_qs = get_stock_status_by_daily_filtered_pv_qs()
    pv_list = list(pv_qs)
    for pv in pv_list:
        total_stock_qty = get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data(pv)
        is_inner = pv.is_inner
        prefetched_latest_stocked_po_lines = (
            getattr(pv, "prefetched_outer_latest_stocked_po_lines", [])
            if is_inner
            else getattr(pv, "prefetched_latest_stocked_po_lines", [])
        )
        latest_stocked_po_line = get_latest_stocked_po_line_by_prefetched_data(
            prefetched_latest_stocked_po_lines
        )
        est_shortage_info = calc_est_shortage_info(
            variant=pv,
            total_stock_qty=total_stock_qty,
            latest_stocked_po_line=latest_stocked_po_line,
            detail_info_mode=False,
        )
        if pv.stock_status_by_daily != est_shortage_info.stock_status_by_daily:
            pv.stock_status_by_daily = est_shortage_info.stock_status_by_daily
            update_pv_list.append(pv)

    if update_pv_list:
        ProductVariant.objects.bulk_update(update_pv_list, ["stock_status_by_daily"])
    logger.info(f"set_pv_stock_status_by_daily done. updated pv count = {len(update_pv_list)}")
