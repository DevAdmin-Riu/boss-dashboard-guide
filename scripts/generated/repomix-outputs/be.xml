class NoticeCreate(ModelMutation):
    class Arguments:
        input = NoticeInput(required=True, description="Fields required to create a notice.")

    class Meta:
        description = "Creates a new notice."
        model = models.Notice
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        cleaned_input["writer"] = info.context.user
        is_published = cleaned_input.get("is_published")
        publication_date = cleaned_input.get("publication_date")
        if is_published and not publication_date:
            cleaned_input["publication_date"] = date.today()
        if publication_date == "":
            cleaned_input["publication_date"] = None
        return cleaned_input

    @classmethod
    def get_type_for_model(cls):
        return Notice

    @classmethod
    def check_permissions(cls, context, **data):
        if context.user.is_staff:
            if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
                return True
            else:
                return False

        # 아래 퍼미션 체크는 가맹본부->매장 공지 기준으로 작성됨. 포장보스 -> 가맹본부, 매장의 경우 위에서 걸러짐.
        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        if cls.__name__ in ["NoticeCreate", "NoticeFromHqCreate"]:
            writer_global_brand_id = data["input"]["owner_brand"]
            _, owner_brand_id = graphene.Node.from_global_id(writer_global_brand_id)
            if not (owner_brand_id == str(brand_id) and is_active and is_hq_staff):
                raise PermissionDenied(user=context.user, cls=cls)
            return True

        # NoticeUpdate의 경우
        if cls.__name__ in ["NoticeUpdate", "NoticeFromHqUpdate"]:
            id = data["id"]
            _, notice_id = graphene.Node.from_global_id(id)
            notice: NoticeModel = models.Notice.objects.get(pk=notice_id)
            if not (notice.owner_brand_id == brand_id and is_active and is_hq_staff):
                raise PermissionDenied(user=context.user, cls=cls)
            return True


