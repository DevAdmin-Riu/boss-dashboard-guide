def create_brand_product_variants(brand: "Brand", brand_products: List[BrandProduct]):
    try:
        create_list: List[BrandProductVariant] = []
        for brand_product in brand_products:
            product: Product = brand_product.product
            # 아우터 거나 이너로도 파는 이너박스 제품만 추가
            target_pv_list: List[ProductVariant] = product.variants.filter(
                Q(outer_id__isnull=True) | Q(can_sale_by_inner=True)
            )
            for pv in target_pv_list:
                if product.is_fulfilled_by_vendor:
                    cost_price_exclude_vat = (
                        pv.cost_price_exclude_vat
                        if pv.track_inventory
                        else pv.consignment_cost_price_exclude_vat
                    )
                else:
                    cost_price_exclude_vat = 0
                bpv_obj = BrandProductVariant(
                    brand=brand,
                    brand_product=brand_product,
                    product_variant=pv,
                    price_amount=0,
                    price_vat=0,
                    cost_price_exclude_vat=cost_price_exclude_vat,
                    delivery_fee_amount=0,
                    sales_status=SalesStatus.STOPPED,
                    stopped_reason=StoppedReasonType.ETC,
                    stopped_reason_etc="최초 생성",
                )
                bpv_obj.generate_bp_sku()
                create_list.append(bpv_obj)

        created_brand_product_variants = (
            BrandProductVariant.objects.bulk_create(create_list) if len(create_list) > 0 else []
        )

        create_bpvr_list: List[BrandProductVariantRegion] = []
        for created_brand_product_variant in created_brand_product_variants:
            if created_brand_product_variant.brand_product.product.is_direct_shipping:
                create_bpvr_list.append(
                    BrandProductVariantRegion(
                        region_id=DEFAULT_REGIONINFO_PK,
                        brand_product_variant=created_brand_product_variant,
                        sales_status=SalesStatus.STOPPED,
                        stopped_reason=StoppedReasonType.ETC,
                        stopped_reason_etc="최초 생성",
                        price_amount=created_brand_product_variant.price_amount,
                        cost_price_exclude_vat=created_brand_product_variant.cost_price_exclude_vat,
                        delivery_fee_amount=created_brand_product_variant.delivery_fee_amount,
                    )
                )

        if len(create_bpvr_list) > 0:
            BrandProductVariantRegion.objects.bulk_create(create_bpvr_list)

    except IntegrityError:
        msg = "브랜드 제품 옵션 정보 생성에 실패했습니다. (중복 오류 체크)"
        raise ValidationError(msg)


