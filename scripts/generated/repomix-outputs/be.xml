class VendorStaffBulkCreate(BaseMutation):
    total_vendor_count = graphene.Int(description="전체 협력사 수")
    already_create_vendor_staff_count = graphene.Int(
        description="이미 관리자 계정이 생성된 협력사 수"
    )
    create_vendor_staff_count = graphene.Int(description="생성된 계정 수")
    create_vendor_staff_fail_count = graphene.Int(description="계정 생성 실패 수")

    class Meta:
        description = "협력사 계정이 없는 모든 협력사에 대해서 어드민 접속용 계정 생성"
        permissions = (VendorPermissions.MANAGE_VENDOR,)
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @classmethod
    def perform_mutation(cls, _root, _info, **data):
        already_create_vendor_staff_count = models.Vendor.objects.filter(
            vendor_staff_user__isnull=False
        ).count()
        target_vendors_qs = models.Vendor.objects.filter(vendor_staff_user__isnull=True)
        target_vendors = list(target_vendors_qs)
        update_list = []
        fail_count = 0
        for vendor in target_vendors:
            vendor_staff_user_dict, _ = make_vendor_staff_user(vendor)
            if vendor_staff_user_dict:
                vendor.vendor_staff_user = account_models.User.objects.create_user(
                    **vendor_staff_user_dict
                )
                update_list.append(vendor)
            else:
                fail_count += 1

        if update_list:
            models.Vendor.objects.bulk_update(
                update_list, batch_size=3000, fields=["vendor_staff_user_id"]
            )
        return cls(
            total_vendor_count=already_create_vendor_staff_count + len(target_vendors),
            already_create_vendor_staff_count=already_create_vendor_staff_count,
            create_vendor_staff_count=len(update_list),
            create_vendor_staff_fail_count=fail_count,
        )


