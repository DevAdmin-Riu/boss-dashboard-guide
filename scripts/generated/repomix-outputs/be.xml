import graphene
from django.db.models import Count, Sum
from django.db.models.fields.json import KeyTextTransform

from ....stats.models import CouriersDeliveryFee as CouriersDeliveryFeeModel
from ...core.fields import FilterInputConnectionField
from ...core.types.common import DateRangeInput
from ...utils.filters import filter_range_field
from .filters import CouriersDeliveryFeeFilterInput
from .types import CouriersDeliveryFee, DeliveryFeeStats


class CouriersDeliveryFeeQueries(graphene.ObjectType):
    couriers_delivery_fees = FilterInputConnectionField(
        CouriersDeliveryFee,
        filter=CouriersDeliveryFeeFilterInput(description="Filtering options for purchases."),
        description="List of the shop's purchase.",
    )

    couriers_delivery_fees_stats = graphene.List(
        DeliveryFeeStats,
        collected_at=graphene.Argument(
            DateRangeInput,
            description="집화처리일 기간",
            required=True,
        ),
    )

    def resolve_couriers_delivery_fees(self, info, **_kwargs):
        return CouriersDeliveryFeeModel.objects.all().distinct()

    def resolve_couriers_delivery_fees_stats(self, _info, **kwargs):

        qs = CouriersDeliveryFeeModel.objects.all()
        collected_at = kwargs.get("collected_at")
        qs = filter_range_field(
            qs.filter(is_collected_corrected=True), "collected_at__date", collected_at
        )

        qs = (
            qs.values("product_info__box_size_type", "is_return", "delivery_fee")
            .annotate(
                count=Count("id"),
                delivery_fee_sum=Sum("delivery_fee"),
                box_size_type=KeyTextTransform("box_size_type", "product_info"),
            )
            .order_by()
        )

        return list(qs)
