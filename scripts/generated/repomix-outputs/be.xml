from decimal import ROUND_HALF_UP, Decimal
from typing import TYPE_CHECKING, Union

from babel.numbers import get_currency_precision
from django.conf import settings

from .utils.math import my_round

if TYPE_CHECKING:
    from prices import Money, TaxedMoney, TaxedMoneyRange


def quantize_price(
    price: Union["TaxedMoney", "Money", Decimal, "TaxedMoneyRange", int],
    currency: str,
    rounding=ROUND_HALF_UP,
    precision: int = None,
) -> Union["TaxedMoney", "Money", Decimal, "TaxedMoneyRange"]:
    if isinstance(price, int):
        price = Decimal(price)

    if precision is None:
        precision = get_currency_precision(currency)
    number_places = Decimal(10) ** -precision
    return price.quantize(number_places, rounding=rounding)


def quantize_krw(
    krw: Union["TaxedMoney", "Money", Decimal, "TaxedMoneyRange", int],
    rounding=ROUND_HALF_UP,
) -> Union["TaxedMoney", "Money", Decimal, "TaxedMoneyRange"]:
    return quantize_price(krw, settings.DEFAULT_CURRENCY, rounding)


def calc_to_exclude_vat(price_include_vat: Decimal, is_tax_free: bool, precision: int = 0):
    if price_include_vat is None:
        return None
    if is_tax_free:
        return my_round(price_include_vat, ndigits=precision)
    correction_factor = -1 if price_include_vat < 0 else 1
    corrected_price = price_include_vat * correction_factor
    return my_round(corrected_price / Decimal(1.1), ndigits=precision) * correction_factor


def calc_to_include_vat(price_exclude_vat: Decimal, is_tax_free: bool, precision: int = 0):
    if price_exclude_vat is None:
        return None
    if is_tax_free:
        return my_round(price_exclude_vat, ndigits=precision)
    correction_factor = -1 if price_exclude_vat < 0 else 1
    corrected_price = price_exclude_vat * correction_factor
    return my_round(corrected_price * Decimal(1.1), ndigits=precision) * correction_factor


def calc_vat_by_price_include_vat(
    price_include_vat: Decimal, is_tax_free: bool, precision: int = 0
):
    if price_include_vat is None:
        return None
    price_exclude_vat = calc_to_exclude_vat(price_include_vat, is_tax_free, precision)
    return my_round(price_include_vat, ndigits=precision) - price_exclude_vat


def calc_vat_by_price_exclude_vat(
    price_exclude_vat: Decimal, is_tax_free: bool, precision: int = 0
):
    if price_exclude_vat is None:
        return None
    price_include_vat = calc_to_include_vat(price_exclude_vat, is_tax_free, precision)
    return calc_vat_by_price_include_vat(price_include_vat, is_tax_free, precision)


# 부가세 포함가로 부분 합을 모두 더한 후 부가세 별도로 한꺼번에 변환할 때 사용
def calc_total_include_vat_by_unit_exclude_vat_and_qty(
    unit_exclude_vat: Decimal, qty: int, is_tax_free: bool, precision: int = 0
):
    # 단가를 부가세 포함가로 변경 시 소수점 둘째자리까지로 계산 후 리턴때만 요청한 precision 으로 리턴한다
    unit_include_vat = calc_to_include_vat(unit_exclude_vat, is_tax_free, 2)
    total_include_vat = unit_include_vat * qty
    return my_round(total_include_vat, precision)


# 부가세 별도가를 입력으로 사용 시 수량을 곱할 경우에는 부가세 포함가로 변환한 후 수량을 곱한 다음에 부가세 별도로 변환해서 리턴
def calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
    unit_exclude_vat: Decimal, qty: int, is_tax_free: bool, precision: int = 0
):
    total_include_vat = calc_total_include_vat_by_unit_exclude_vat_and_qty(
        unit_exclude_vat, qty, is_tax_free, precision
    )
    return calc_to_exclude_vat(total_include_vat, is_tax_free, precision)


def check_vat_value(vat_value: Decimal, price_include_vat: Decimal, precision: int = 0):
    from decimal import ROUND_CEILING, ROUND_FLOOR, Decimal, getcontext

    """
    vat_value: VAT 값 (Decimal)
    price: VAT 포함 가격 (Decimal)
    precision: 소수점 자리수 (int)

    리턴: dict { is_valid: bool, ceil: Decimal }
    """
    getcontext().prec = 28  # 충분히 높은 정밀도 설정
    base_vat = price_include_vat - calc_to_exclude_vat(price_include_vat, False, precision)
    multiple_precision = 1 if precision < 1 else 10**precision

    base_vat_scaled = Decimal(base_vat * multiple_precision).quantize(
        Decimal("1.000000000"), rounding=ROUND_FLOOR
    )
    floor = (base_vat_scaled // 1) / multiple_precision
    ceil = (Decimal(base_vat_scaled.to_integral_value(rounding=ROUND_CEILING))) / multiple_precision

    is_valid = vat_value == floor or vat_value == ceil
    return is_valid
