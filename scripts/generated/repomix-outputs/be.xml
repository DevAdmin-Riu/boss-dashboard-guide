@transaction.atomic
def cancel_order(
    order: "Order",
    staff_user: Optional["User"],
    cancel_type: OrderEvents = OrderEvents.CANCELED,
):
    """Cancel order.

    Release allocation of unfulfilled order items.
    """
    from ..warehouse.management import deallocate_stock_for_order

    # 충전금 + 포인트 + 가상계좌로 결제 후, 입금 안한 경우 자동 취소 시 충전금, 포인트 자동 환불을 위한 로직
    payment = order.get_last_payment()
    if payment:
        # 선결제금 자동 환불 추가
        brand: Brand = order.brand
        # 환불로 차감된 후 취소인 경우일 수도 있으므로 차감되어 남은 매입 총액 만큼만 돌려줌. line의 fbv가 false 경우만 해당.
        increase_deposit_amount = sum_of_reverse_fee_deposit_items(
            non_fbv_total_brand_cost=order.final_brand_total_cost_price_amount_not_fbv,
            non_fbv_subtotal_delivery_additional_fee=order.final_refund_delivery_additional_fee,
            total_etc_delivery_fee=order.total_etc_delivery_fee,
        )
        if brand and brand.is_reverse_fee_contract_type and increase_deposit_amount > 0:
            # 주문취소는 출고 전 전체 취소로만 사용되고 있어서 도서산간지역 추가 요금은 주문 시점 전체 금액으로만 관리함
            #  개별 환불되는 경우 주문 취소가 아니라 전체 환불로 처리함
            # 매출인식 브랜드가 아닌 경우에는 가맹점에게 도서산간추가요금은 환불 처리 안함
            # 단, 매출인식브랜드는
            #     * 가맹본부가 리우 귀책이면 배송비를 리우가 전액 부담하니 도서산간지역 배송비까지 모두 환불.
            #     * 가맹점 귀책이면 “반품배송비” 를 12000원이 아니라 도서산간지역 요금을 더한 금액으로 입력해서 처리할 수 있음
            user: "User" = order.user
            brand.increase_reverse_fee_deposit(
                reverse_fee_deposit_amount=increase_deposit_amount,
                event_type=BrandReverseFeeDepositEventType.CANCEL_ORDER,
                description=f"주문번호:{order.composed_id_with_prefix} (주문취소)",
                user=user,
            )
            if order.total_captured_rcoins > 0:
                brand.decrease_reverse_fee_deposit(
                    reverse_fee_deposit_amount=order.total_captured_rcoins,
                    event_type=BrandReverseFeeDepositEventType.DECREASE_BY_RCOINS,
                    description=f"주문번호:{order.composed_id_with_prefix} (주문취소)",
                    user=user,
                )

        changed_fields = []
        user: "User" = (
            order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
        )
        event_desc = f"주문번호:{order.composed_id_with_prefix} (주문 취소)"
        total_credits = payment.captured_cashable_credits + payment.captured_non_cashable_credits
        if total_credits > 0 and user:
            qty_before = user.credits_incl_non_cashable
            qty_after = qty_before + total_credits
            create_credits_event(
                total_before=qty_before,
                total_after=qty_after,
                qty_before=qty_before,
                qty_after=qty_after,
                qty=total_credits,
                type=CreditsEventType.CANCEL_ORDER,
                user=user,
                staff=None,
                description=event_desc,
                view_mode=CreditsEventViewMode.ONLY_MALL,
                # ONLY_MALL view_mode 에서 is_cashable 은 통합금액 이벤트이므로 무의미함
                is_cashable=True,
            )

        if payment.captured_cashable_credits > 0:
            cashable_credits = payment.captured_cashable_credits
            payment.captured_cashable_credits -= Decimal(cashable_credits)
            changed_fields.append("captured_cashable_credits")
            if user:
                user.increase_cashable_credits(
                    cashable_credits,
                    CreditsEventType.CANCEL_ORDER,
                    event_desc,
                    staff=None,
                    event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
                )
        if payment.captured_non_cashable_credits > 0:
            non_cashable_credits = payment.captured_non_cashable_credits
            payment.captured_non_cashable_credits -= Decimal(non_cashable_credits)
            changed_fields.append("captured_non_cashable_credits")
            if user:
                user.increase_non_cashable_credits(
                    non_cashable_credits,
                    CreditsEventType.CANCEL_ORDER,
                    event_desc,
                    staff=None,
                    event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
                )
        if payment.captured_rcoins > 0:
            rcoins = payment.captured_rcoins
            payment.captured_rcoins -= Decimal(rcoins)
            changed_fields.append("captured_rcoins")
            if user:
                user.increase_rcoins(
                    rcoins,
                    RcoinsEventType.CANCEL_ORDER,
                    event_desc,
                    staff=None,
                )
        if len(changed_fields) > 0:
            payment.save(update_fields=changed_fields)

    events.order_canceled_event(order=order, user=staff_user, cancel_type=cancel_type)

    deallocate_stock_for_order(order)

    order.status = OrderStatus.CANCELED
    order.save(update_fields=["status"])

    manager = get_plugins_manager()
    manager.order_cancelled(order)
    manager.order_updated(order)

    # 주문 취소를 수행한 관리자에게 확인 메일을 굳이 보낼 필요 없어서 보내지 않기로 정책 변경
    # send_order_canceled_confirmation(order, user)

    # 매장에 의한 주문 인 경우에만 알리고 이벤트 발송
    if order.type == OrderType.BY_USER:
        parameters = {"order_id": order.id}
        get_plugins_manager().send_kakaotalk(
            talk_event_code=AligoEvents.CANCEL_ORDER, parameters=parameters
        )

    # 위탁 주문의 발주서는 모두 취소 처리
    cancel_consignment_po_line_ids = order.lines.filter(
        track_inventory=False, purchase_order_line_id__isnull=False
    ).values_list("purchase_order_line_id", flat=True)
    PurchaseOrderLine.objects.filter(pk__in=cancel_consignment_po_line_ids).update(
        status=PurchaseOrderLineStatus.CANCELED
    )


