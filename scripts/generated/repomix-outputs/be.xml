class Stock(CountableDjangoObjectType):
    quantity = PositiveDecimal(
        required=True,
        description="Quantity of a product in the warehouse's possession, "
        "including the allocated stock that is waiting for shipment.",
    )
    quantity_allocated = PositiveDecimal(required=True, description="Quantity allocated for orders")
    details = graphene.List(lambda: StockDetail, description="상세 재고 현황")
    detail_events = graphene.List(lambda: StockDetailEvent, description="재고 입고/로스 이력")

    class Meta:
        description = "Represents stock."
        model = models.Stock
        interfaces = [graphene.relay.Node]
        only_fields = [
            "warehouse",
            "product_variant",
            "quantity",
            "quantity_allocated",
        ]

    def resolve_warehouse(root: StockModel, info):
        if root.warehouse_id:
            return WarehouseByIdLoader(info.context).load(root.warehouse_id)
        else:
            return None

    def resolve_product_variant(root: StockModel, info):
        if root.product_variant_id:
            return ProductVariantByIdLoader(info.context).load(root.product_variant_id)
        else:
            return None

    def resolve_quantity(root: StockModel, *_args):
        return root.quantity

    def resolve_quantity_allocated(root: StockModel, info):
        def calculate_quantity_allocated(allocations):
            # allocations의 quantity_allocated 합계를 계산
            return sum(allocation.quantity_allocated for allocation in allocations)

        # AllocationsByStockIdLoader를 사용하여 allocations 가져오기
        return (
            AllocationsByStockIdLoader(info.context)
            .load(root.id)
            .then(calculate_quantity_allocated)
        )

    def resolve_details(root: StockModel, info):
        return StockDetailByStockIdLoader(info.context).load(root.pk)

    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_detail_events(root: StockModel, info):
        return StockDetailEventsByStockIdLoader(info.context).load(root.pk)


