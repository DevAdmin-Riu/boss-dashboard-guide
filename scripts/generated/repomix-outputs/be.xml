def calc_order_line_payment_values(
    *,
    payment: "Payment",
    brand_payment_values: "BrandPaymentValues",
    line_price_mul_charge_rate_sum: Decimal,
    line_price_mul_charge_rate: Decimal,
    checkout_subtotal_amount: Decimal,
    line_total_amount: Decimal,
):
    rate = (
        Decimal(0)
        if checkout_subtotal_amount == 0
        else Decimal(line_total_amount / checkout_subtotal_amount)
    )
    # line_price_mul_charge_rate_sum가 0인 경우도 처리 됨
    brand_paying_charge_rate = (
        Decimal(0)
        if line_price_mul_charge_rate_sum == 0
        else Decimal(line_price_mul_charge_rate / line_price_mul_charge_rate_sum)
    )
    brand_paying_charge_exclude_vat = (
        quantize_krw(
            brand_payment_values.brand_paying_charge_exclude_vat * brand_paying_charge_rate
        )
        if brand_payment_values
        else Decimal(0.0)
    )
    return OrderLinePaymentValues(
        amount=quantize_krw(payment.amount * rate),
        cashable_credits=quantize_krw(payment.cashable_credits * rate),
        non_cashable_credits=quantize_krw(payment.non_cashable_credits * rate),
        rcoins=quantize_krw(payment.rcoins * rate),
        paying_charge_exclude_vat=quantize_krw(payment.paying_charge_exclude_vat * rate),
        brand_paying_charge_exclude_vat=brand_paying_charge_exclude_vat,
    )


def calc_remaining_order_line_payment_values(
    payment: "Payment",
    brand_payment_values: "BrandPaymentValues",
    order_lines: Iterable["OrderLine"],
):
    used_amount = reduce(
        lambda acc, order_line: acc + Decimal(order_line.amount),
        order_lines,
        Decimal(0.0),
    )
    used_cashable_credits = reduce(
        lambda acc, order_line: acc + Decimal(order_line.cashable_credits),
        order_lines,
        Decimal(0.0),
    )
    used_non_cashable_credits = reduce(
        lambda acc, order_line: acc + Decimal(order_line.non_cashable_credits),
        order_lines,
        Decimal(0.0),
    )
    used_rcoins = reduce(
        lambda acc, order_line: acc + Decimal(order_line.rcoins),
        order_lines,
        Decimal(0.0),
    )
    used_paying_charge_exclude_vat = reduce(
        lambda acc, order_line: acc + Decimal(order_line.paying_charge_exclude_vat),
        order_lines,
        Decimal(0.0),
    )
    used_brand_paying_charge_exclude_vat = (
        reduce(
            lambda acc, order_line: acc + Decimal(order_line.brand_paying_charge_exclude_vat),
            order_lines,
            Decimal(0.0),
        )
        if brand_payment_values
        else Decimal(0.0)
    )

    return OrderLinePaymentValues(
        amount=quantize_krw(payment.amount - used_amount),
        cashable_credits=quantize_krw(payment.cashable_credits - used_cashable_credits),
        non_cashable_credits=quantize_krw(payment.non_cashable_credits - used_non_cashable_credits),
        rcoins=quantize_krw(payment.rcoins - used_rcoins),
        paying_charge_exclude_vat=quantize_krw(
            payment.paying_charge_exclude_vat - used_paying_charge_exclude_vat
        ),
        brand_paying_charge_exclude_vat=(
            quantize_krw(
                brand_payment_values.brand_paying_charge_exclude_vat
                - used_brand_paying_charge_exclude_vat
            )
            if brand_payment_values
            else 0
        ),
    )


def calc_order_line_mileage_exclude_vat(
    total_price: Decimal,
    captured_rcoins: Decimal,
    brand_total_cost_price: Decimal,
    brand_total_delivery_fee: Decimal,
    brand_paying_charge_exclude_vat: Decimal,
    mileage_rate: Decimal,
    is_tax_free: bool,
    return_delivery_fee: Decimal = Decimal(0),
):
    """
    ### 계산된 최종 본부수익금은 반올림 처리해서 리턴

    * total_price: 상품 판매가는 과세/면세 상품에 따라 공급가액 계산.
    * captured_rcoins: 사용된 포인트는 부가세 포함가격이며, 과세/면세 상품에 따라 공급가액 계산으로 공식 수정
    * brand_total_cost_price: 상품 매입가는 과세/면세 상품에 따라 공급가액 계산.
    * brand_paying_charge_exclude_vat: 결제 수수료는 부가세 별도 공급가액임.
    * brand_total_delivery_fee: 배송비는 부가세 포함가격이며, 상품 종류와 관계 없이 과세 처리해서 공급가액 계산.
    """

    total_price_exclude_vat = calc_to_exclude_vat(total_price, is_tax_free)
    captured_rcoins_exclude_vat = calc_to_exclude_vat(captured_rcoins, is_tax_free)
    brand_total_cost_price_exclude_vat = calc_to_exclude_vat(brand_total_cost_price, is_tax_free)
    brand_total_delivery_fee_exclude_vat = calc_to_exclude_vat(brand_total_delivery_fee, False)
    return_delivery_fee_exclude_vat = calc_to_exclude_vat(return_delivery_fee, False)

    return my_round(
        (
            total_price_exclude_vat
            - return_delivery_fee_exclude_vat
            - captured_rcoins_exclude_vat
            - brand_total_cost_price_exclude_vat
            - brand_total_delivery_fee_exclude_vat
            - brand_paying_charge_exclude_vat
        )
        * mileage_rate
        / 100
    )


