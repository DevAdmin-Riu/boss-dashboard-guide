import datetime  # 시간 라이브러리

import pyotp  # pyotp

# otp에 사용할 키 - base32 방식 A-Z 2-7까지를 이용하고 = 는 채워야하는 공간 패딩 처리용
# otp_key = pyotp.random_base32()
otp_key = "GTLSR44X6OOK4D2QDHWREBE3N5QN52BE"

# otp 값 발급 주기
interval = 60
allowIntervalTick = 3

# totp 생성
totp = pyotp.TOTP(otp_key, interval=interval)


def get_topt_at():
    return totp.now()


def get_topt_prev(tickCounter):
    now = datetime.datetime.now()
    now_timestamp = int(now.timestamp())
    return totp.at(now_timestamp - interval * tickCounter)


def get_topt_next():
    now = datetime.datetime.now()
    now_timestamp = int(now.timestamp())
    return totp.at(now_timestamp + interval)


def verify_totp(value: str):
    if get_topt_at() == value:
        return True

    for tickCounter in range(1, allowIntervalTick + 1):
        if get_topt_prev(tickCounter) == value:
            return True

    return False
