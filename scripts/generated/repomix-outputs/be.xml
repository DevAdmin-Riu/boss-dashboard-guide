            "use_microwave",
            "design_memo",
            "function_memo",
            "etc_memo",
            "is_exclusive",
            "by_product_variant",
        ]

    def resolve_request_number(root: RequestBossProductModel, _info):
        return root.request_number

    @staticmethod
    def resolve_req_staff(root: RequestBossProductModel, info):
        if root.staff_id:
            return UserByIdLoader(info.context).load(root.staff_id)
        return None

    def resolve_images(root: RequestBossProductModel, info, size=None, **_kwargs):
        return RequestBossProductImagesByRequestBossProductIdLoader(info.context).load(root.id)

    def resolve_brand(root: RequestBossProductModel, info):
        if root.brand_id:
            return BrandByIdLoader(info.context).load(root.brand_id)
        else:
            return None

    def resolve_all_status_histories(root: RequestBossProductModel, info):
        return (
            RequestBossProductStatusHistoryByRequestBossProductIdLoader(info.context)
            .load(root.id)
            .then(lambda histories: sorted(histories, key=lambda history: history.id, reverse=True))
        )

    def resolve_status_histories(root: RequestBossProductModel, info, status_list=None):
        if status_list is None:
            return None

        def get_status_histories(
            histories: List[RequestBossProductStatusHistoryModel],
            status_list: List[RequestBossProductStatus],
        ):
            # 상태별 해당 history 를 찾는 로직을 개념적으로 처리하기 위해 id 순으로 소팅
            histories = sorted(histories, key=lambda history: history.id, reverse=False)
            filtered_id_list = []

            for status in status_list:
                if status == RequestBossProductStatus.ACCEPTED:
                    history_id = next((h.id for h in histories if h.after_status == status), None)
                else:
                    history_id = next(
                        (h.id for h in reversed(histories) if h.after_status == status), None
                    )

                if history_id is not None:
                    filtered_id_list.append(history_id)

            result_histories = [
                history
                for history in histories
                if any(history.id == filtered_id for filtered_id in filtered_id_list)
            ]

            return result_histories

        return (
            RequestBossProductStatusHistoryByRequestBossProductIdLoader(info.context)
            .load(root.id)
            .then(lambda histories: get_status_histories(histories, status_list))
        )

    def resolve_estimate_list(root: RequestBossProductModel, _info):
        return RequestBossProductEstimatesByRequestBossProductIdLoader(_info.context).load(root.id)

    def resolve_picked_estimate(root: RequestBossProductModel, _info):
        def get_picked_estimate(estimates: List[RequestBossProductEstimateModel]):
            return next((estimate for estimate in estimates if estimate.is_picked), None)

        return (
            RequestBossProductEstimatesByRequestBossProductIdLoader(_info.context)
            .load(root.id)
            .then(lambda estimates: get_picked_estimate(estimates))
        )


