from ....vendor import VENDOR_CODE_PREFIX, FbvPurchaseCostEventType
from ....vendor import models as vendor_models
from ....vendor.utils import get_vendor_id_from_query
from ...account.filters import get_brand_id_from_query
from ...order.enums import FulfillmentTrackingNumberEmptyFilter, OrderStatusFilter
from ...order.filters import FulfillmentFilter, OrderLineFilter
from ...utils.filters import filter_range_field, make_query_objects_by_query_param
from .types import (
    FbvOrderLineCount,
    FbvOrderLineCountFilterInput,
    FbvPurchaseCostStatsForHq,
    FbvPurchaseCostStatsForHqFilterInput,
    FbvPurchaseCostStatsForVendor,
    FbvPurchaseCostStatsForVendorFilterInput,
)


class StatsVendorQueries(graphene.ObjectType):
    fbv_purchase_cost_stats_for_hq = graphene.List(
        FbvPurchaseCostStatsForHq,
        description="가맹본부가 보는 협력사별 채무 통계",
        brand_id=graphene.Argument(graphene.ID, required=True, description="가맹본부 ID"),
        filter=graphene.Argument(
            FbvPurchaseCostStatsForHqFilterInput,
            required=True,
        ),
    )
    fbv_purchase_cost_stats_for_vendor = graphene.List(
        FbvPurchaseCostStatsForVendor,
        description="협력사가 보는 가맹본부별 채무 통계",
        vendor_id=graphene.Argument(graphene.ID, required=True, description="협력사 ID"),
        filter=graphene.Argument(
            FbvPurchaseCostStatsForVendorFilterInput,
            required=True,
        ),
    )
    fbv_order_line_count = graphene.Field(
        FbvOrderLineCount,
        description="협력사 어드민용 상태별 order line 카운트",
        vendor_id=graphene.Argument(graphene.ID, required=True, description="협력사 ID"),
        filter=graphene.Argument(
            FbvOrderLineCountFilterInput,
            required=True,
        ),
    )

    @staticmethod
    def filter_brand_for_fbv_purchase_cost_event(id):
        brand_id = get_brand_id_from_query(id)
        qs = vendor_models.FbvPurchaseCostEvent.objects.filter(brand_id=brand_id)
        return qs

    @staticmethod
    def filter_vendor_for_fbv_purchase_cost_event(id):
        vendor_id = get_vendor_id_from_query(id)
        qs = vendor_models.FbvPurchaseCostEvent.objects.filter(vendor_id=vendor_id)
        return qs

    @staticmethod
    def filter_created_range(qs, value):
        return filter_range_field(qs, "created__date", value)

    @staticmethod
    def filter_vendor_search_for_fbv_purchase_cost_event(qs, value):
        if value:
            prefix = VENDOR_CODE_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        return qs.filter(vendor_id=pk_value)
                    except:
                        raise ValidationError(f"협력업체코드 형식을 확인해 주세요. {value}")

            search_fields = ["vendor__name"]
            vendor_name_filter = make_query_objects_by_query_param(qs, value, search_fields)[1]
            vendor_biz_reg_no_filter = Q(vendor__biz_reg_no=value)
            return qs.filter(vendor_name_filter | vendor_biz_reg_no_filter)
        return qs

    @staticmethod
    def filter_brand_search_for_fbv_purchase_cost_event(qs, value):
        if value:
            search_fields = [
                "brand__code",
                "brand__name",
            ]
            brand_name_filter = make_query_objects_by_query_param(qs, value, search_fields)[1]
            brand_biz_reg_no_filter = Q(brand__biz_info__bizRegNo=value)
            return qs.filter(brand_name_filter | brand_biz_reg_no_filter)
        return qs

    def resolve_fbv_purchase_cost_stats_for_hq(root, _info, **kwargs):
        brand_id = kwargs.get("brand_id")
        filter = kwargs.get("filter")
        stat_date = filter.get("stat_date")
        vendor_search = filter.get("vendor_search")

        qs = StatsVendorQueries.filter_brand_for_fbv_purchase_cost_event(brand_id)
        common_qs = StatsVendorQueries.filter_vendor_search_for_fbv_purchase_cost_event(
            qs, vendor_search
        )

        start_month_date = stat_date.get("gte")

        start_amount_subquery = (
            common_qs.filter(vendor=OuterRef("vendor_id"), created__date__lt=start_month_date)
            .order_by("-pk")
            .values("amount_after")[:1]
        )
        final_remain_amount_subquery = (
            common_qs.filter(vendor=OuterRef("vendor_id"))
            .order_by("-pk")
            .values("amount_after")[:1]
        )

        qs = StatsVendorQueries.filter_created_range(common_qs, stat_date)
        qs = (
            qs.annotate(
                start_amount=Coalesce(Subquery(start_amount_subquery), Value(0)),
                final_remain_amount=Coalesce(Subquery(final_remain_amount_subquery), Value(0)),
                purchase=Case(
                    When(
                        type=FbvPurchaseCostEventType.PURCHASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                increase=Case(
                    When(
                        type=FbvPurchaseCostEventType.INCREASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                decrease=Case(
                    When(
                        type=FbvPurchaseCostEventType.DECREASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                settlement=Case(
                    When(
                        type=FbvPurchaseCostEventType.SETTLEMENT,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
            )
            .values("vendor_id", "start_amount", "final_remain_amount")
            .annotate(
                total_purchase=Sum("purchase"),
                total_increase=Sum("increase"),
                total_decrease=Sum("decrease"),
                total_settlement=Sum("settlement"),
            )
            .annotate(
                remain_amount=F("start_amount")
                + F("total_purchase")
                + F("total_increase")
                - F("total_decrease")
                - F("total_settlement"),
            )
            .values(
                "vendor_id",
                "start_amount",
                "total_purchase",
                "total_increase",
                "total_decrease",
                "total_settlement",
                "remain_amount",
                "final_remain_amount",
            )
            .order_by("vendor_id")
        )

        result_list = list(qs)
        vendor_map = {
            vendor.id: vendor
            for vendor in vendor_models.Vendor.objects.filter(
                id__in=[item["vendor_id"] for item in result_list]
            )
        }

        for result in result_list:
            result["vendor"] = vendor_map[result["vendor_id"]]

        return result_list

    def resolve_fbv_purchase_cost_stats_for_vendor(root, _info, **kwargs):
        vendor_id = kwargs.get("vendor_id")
        filter = kwargs.get("filter")
        stat_date = filter.get("stat_date")
        brand_search = filter.get("brand_search")

        qs = StatsVendorQueries.filter_vendor_for_fbv_purchase_cost_event(vendor_id)
        common_qs = StatsVendorQueries.filter_brand_search_for_fbv_purchase_cost_event(
            qs, brand_search
        )

        start_month_date = stat_date.get("gte")

        start_amount_subquery = (
            common_qs.filter(brand=OuterRef("brand_id"), created__date__lt=start_month_date)
            .order_by("-pk")
            .values("amount_after")[:1]
        )
        final_remain_amount_subquery = (
            common_qs.filter(brand=OuterRef("brand_id")).order_by("-pk").values("amount_after")[:1]
        )

        qs = StatsVendorQueries.filter_created_range(common_qs, stat_date)
        qs = (
            qs.annotate(
                start_amount=Coalesce(Subquery(start_amount_subquery), Value(0)),
                final_remain_amount=Coalesce(Subquery(final_remain_amount_subquery), Value(0)),
                purchase=Case(
                    When(
                        type=FbvPurchaseCostEventType.PURCHASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                increase=Case(
                    When(
                        type=FbvPurchaseCostEventType.INCREASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                decrease=Case(
                    When(
                        type=FbvPurchaseCostEventType.DECREASE,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
                settlement=Case(
                    When(
                        type=FbvPurchaseCostEventType.SETTLEMENT,
                        then=F("amount"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                ),
            )
            .values("brand_id", "start_amount", "final_remain_amount")
            .annotate(
                total_purchase=Sum("purchase"),
                total_increase=Sum("increase"),
                total_decrease=Sum("decrease"),
                total_settlement=Sum("settlement"),
            )
            .annotate(
                remain_amount=F("start_amount")
                + F("total_purchase")
                + F("total_increase")
                - F("total_decrease")
                - F("total_settlement"),
            )
            .values(
                "brand_id",
                "start_amount",
                "total_purchase",
                "total_increase",
                "total_decrease",
                "total_settlement",
                "remain_amount",
                "final_remain_amount",
            )
            .order_by("brand_id")
        )

        result_list = list(qs)
        brand_map = {
            brand.id: brand
            for brand in account_models.Brand.objects.filter(
                id__in=[item["brand_id"] for item in result_list]
            )
        }

        for result in result_list:
            result["brand"] = brand_map[result["brand_id"]]
        return result_list

    def resolve_fbv_order_line_count(root, _info, **kwargs):
        order_line_qs = order_models.OrderLine.objects.exclude(
            order__status=OrderStatus.CANCELED
        ).filter(is_fulfilled_by_vendor=True)
        fulfillment_qs = order_models.Fulfillment.objects.exclude(
            order__status=OrderStatus.CANCELED
        ).filter(is_fulfilled_by_vendor=True)

        vendor_id = kwargs.get("vendor_id")
        order_line_qs = OrderLineFilter.filter_fulfill_vendor_id(order_line_qs, _info, vendor_id)
        fulfillment_qs = FulfillmentFilter.filter_fulfill_vendor_id(
            fulfillment_qs, _info, vendor_id
        )

        filter = kwargs.get("filter")
        order_created = filter.get("order_created")
        if order_created:
            order_line_qs = OrderLineFilter.filter_order_created_range(
                order_line_qs, _info, order_created
            )
            fulfillment_qs = FulfillmentFilter.filter_order_created_range(
                fulfillment_qs, _info, order_created
            )
        brand_search = filter.get("brand_search")
        if brand_search:
            order_line_qs = OrderLineFilter.filter_brand_search(order_line_qs, _info, brand_search)
            fulfillment_qs = FulfillmentFilter.filter_brand_search(
                fulfillment_qs, _info, brand_search
            )
        order_search = filter.get("order_search")
        if order_search:
            order_line_qs = OrderLineFilter.filter_order_search(order_line_qs, _info, order_search)
            fulfillment_qs = FulfillmentFilter.filter_order_search(
                fulfillment_qs, _info, order_search
            )
        product_search = filter.get("product_search")
        if product_search:
            order_line_qs = OrderLineFilter.filter_product_search(
                order_line_qs, _info, product_search
            )
            fulfillment_qs = FulfillmentFilter.filter_product_search(
                fulfillment_qs, _info, product_search
            )

        ready_to_fulfill_qs = OrderLineFilter.filter_order_status(
            order_line_qs, _info, [OrderStatusFilter.READY_TO_FULFILL]
        )
        before_fulfilled = ready_to_fulfill_qs.count()

        by_courier_fulfillment_qs = FulfillmentFilter.filter_delivery_methods(
            fulfillment_qs, _info, [OrderDeliveryMethods.BY_COURIER]
        )
        before_completed_by_courier_fulfillment_qs = FulfillmentFilter.filter_tracking_completed(
            by_courier_fulfillment_qs, _info, False
        )
        tracking_number_empty_qs = FulfillmentFilter.filter_tracking_number_empty(
            before_completed_by_courier_fulfillment_qs,
            _info,
            [FulfillmentTrackingNumberEmptyFilter.EMPTY],
        )
        before_delivery_info = tracking_number_empty_qs.count()

        tracking_number_filled_qs = FulfillmentFilter.filter_tracking_number_empty(
            before_completed_by_courier_fulfillment_qs,
            _info,
            [FulfillmentTrackingNumberEmptyFilter.FILLED],
        )
        before_completed_by_courier = tracking_number_filled_qs.count()

        completed_by_courier_fulfillment_qs = FulfillmentFilter.filter_tracking_completed(
            by_courier_fulfillment_qs, _info, True
        )
        completed_by_courier = completed_by_courier_fulfillment_qs.count()

        by_truck_service_fulfillment_qs = FulfillmentFilter.filter_delivery_methods(
            fulfillment_qs, _info, [OrderDeliveryMethods.BY_TRUCK_SERVICE]
        )
        before_tracking_completed_by_truck_service_qs = FulfillmentFilter.filter_tracking_completed(
            by_truck_service_fulfillment_qs, _info, False
        )
        before_completed_by_truck_service = before_tracking_completed_by_truck_service_qs.count()
        completed_by_truck_service_qs = FulfillmentFilter.filter_tracking_completed(
            by_truck_service_fulfillment_qs, _info, True
        )
        completed_by_truck_service = completed_by_truck_service_qs.count()

        return FbvOrderLineCount(
            before_fulfilled=before_fulfilled,
            before_delivery_info=before_delivery_info,
            before_completed_by_courier=before_completed_by_courier,
            before_completed_by_truck_service=before_completed_by_truck_service,
            completed_by_courier=completed_by_courier,
            completed_by_truck_service=completed_by_truck_service,
        )
