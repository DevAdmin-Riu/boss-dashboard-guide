        default=0,
    )
    is_tax_free = models.BooleanField(default=False)
    # 발주 상품 별 메모 관리
    note = models.TextField(null=True, blank=True)

    # 위탁 상품 발주인 경우에는 배송지 주소 정보 연결
    shipping_address = models.ForeignKey(
        Address, related_name="+", blank=True, null=True, on_delete=models.SET_NULL
    )

    # 위탁 상품 발주인 경우, unique_together를 위한 주문 내역 정보 연결
    order_line = models.ForeignKey(
