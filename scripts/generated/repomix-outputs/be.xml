def get_stock_control_prefetched_pv_qs():
    from ..graphql.purchaseorder.filters import filter_to_be_stocked_by_purchase_order_lines_qs

    query_warehouse = Subquery(
        Warehouse.objects.filter(
            shipping_zones__countries__contains=settings.DEFAULT_COUNTRY
        ).values("pk")
    )
    filter_to_be_stocked_po_lines = filter_to_be_stocked_by_purchase_order_lines_qs(
        PurchaseOrderLine.objects.select_related("purchase_order").all()
    )
    latest_stocked_po_line_ids = (
        PurchaseOrderLine.objects.filter(
            status__in=ALREADY_STOCKED_STATUSES,
        )
        .order_by("variant_id", "-purchase_date", "-pk")
        .distinct("variant_id")  # PostgreSQL 전용: variant_id별 최신 row 하나
        .values_list("pk", flat=True)
    )
    filter_latest_stocked_po_lines = PurchaseOrderLine.objects.filter(
        pk__in=latest_stocked_po_line_ids
    )
    filtered_stocks = Stock.objects.filter(warehouse__in=query_warehouse).prefetch_related(
        "allocations",
    )
    filtered_rack_stocks = RackStockDetail.objects.select_related("location")
    pv_qs = ProductVariant.objects.select_related("inner", "outer").prefetch_related(
        Prefetch(
            "purchase_order_lines",
            queryset=filter_to_be_stocked_po_lines,
            to_attr="prefetched_to_be_stocked_po_lines",
        ),
        Prefetch(
            "outer__purchase_order_lines",  # inner → outer 로 따라가서 prefetch
            queryset=filter_to_be_stocked_po_lines,
            to_attr="prefetched_outer_to_be_stocked_po_lines",
        ),
        Prefetch(
            "purchase_order_lines",
            queryset=filter_latest_stocked_po_lines,
            to_attr="prefetched_latest_stocked_po_lines",
        ),
        Prefetch(
            "outer__purchase_order_lines",  # inner → outer 로 따라가서 prefetch
            queryset=filter_latest_stocked_po_lines,
            to_attr="prefetched_outer_latest_stocked_po_lines",
        ),
        Prefetch("stocks", queryset=filtered_stocks, to_attr="prefetched_stocks"),
        Prefetch("rack_stocks", queryset=filtered_rack_stocks, to_attr="prefetched_rack_stocks"),
        Prefetch("outer__stocks", queryset=filtered_stocks, to_attr="prefetched_outer_stocks"),
        Prefetch(
            "outer__rack_stocks",
            queryset=filtered_rack_stocks,
            to_attr="prefetched_outer_rack_stocks",
        ),
        Prefetch("inner__stocks", queryset=filtered_stocks, to_attr="prefetched_inner_stocks"),
        Prefetch(
            "inner__rack_stocks",
            queryset=filtered_rack_stocks,
            to_attr="prefetched_inner_rack_stocks",
        ),
    )
    return pv_qs


def get_closest_to_be_stocked_po_line_by_prefetched_data(
    prefetched_to_be_stocked_po_lines: List["PurchaseOrderLine"],
    rank: int = 1,
) -> Optional["PurchaseOrderLine"]:
    # 유효한 expected_purchase_date 가 있는 항목만 필터링
    valid_po_lines = [
        po_line
        for po_line in prefetched_to_be_stocked_po_lines
        if getattr(po_line, "expected_purchase_date", None)
    ]

    if not valid_po_lines:
        return None

    # expected_purchase_date 기준으로 오름차순 정렬
    sorted_po_lines = sorted(valid_po_lines, key=lambda po_line: po_line.expected_purchase_date)

    # rank는 1-based index → 리스트 인덱스로 변환
    index = rank - 1

    if 0 <= index < len(sorted_po_lines):
        return sorted_po_lines[index]

    return None


