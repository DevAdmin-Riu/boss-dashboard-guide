    def resolve_b2b_order_line_count(root, _info, **kwargs):
        order_line_qs = models.OrderLine.objects.all()
        filter = kwargs.get("filter")
        brand_id = filter.get("brand_id")
        if brand_id:
            _, brand_pk = graphene.Node.from_global_id(brand_id)
            order_line_qs = order_line_qs.filter(order__brand_id=brand_pk)

        # 각 상태별 개수를 집계
        order_line_counts = order_line_qs.aggregate(
            pending_count=Count("id", filter=Q(b2b_status=OrderLineB2bStatus.PENDING)),
            rejected_count=Count("id", filter=Q(b2b_status=OrderLineB2bStatus.REJECTED)),
            received_count=Count("id", filter=Q(b2b_status=OrderLineB2bStatus.RECEIVED)),
            delivery_count=Count(
                "id",
                filter=Q(b2b_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT)
                & Q(purchase_order_line__status=PurchaseOrderLineStatus.INVOICE_PRINTED),
            ),
            dispatch_fulfillment_count=Count(
                "id",
                filter=Q(b2b_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT)
                & ~Q(purchase_order_line__status=PurchaseOrderLineStatus.INVOICE_PRINTED),
            ),
            completed_count=Count("id", filter=Q(b2b_status=OrderLineB2bStatus.COMPLETED)),
            canceled_count=Count("id", filter=Q(b2b_status=OrderLineB2bStatus.CANCELED)),
        )

        return B2bOrderLineCount(**order_line_counts)

