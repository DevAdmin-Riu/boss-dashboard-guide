from typing import TYPE_CHECKING

import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ....account import models as account_models
from ....product.models import BrandProductVariant
from ...account.types import User
from ...core.mutations import BaseMutation
from ...core.types.common import AccountError
from ...core.utils import from_global_id_strict_type
from ...product.types.bp_bundle import BpBundle
from ...product.types.products import Product

if TYPE_CHECKING:
    pass


class FavoritesCreate(BaseMutation):
    user = graphene.Field(User, description="An updated user instance.")

    class Arguments:
        # 둘 중 하나는 필수 입력되어야 함
        product_id = graphene.ID(description="ID of the product.")
        bp_bundle_id = graphene.ID(description="ID of the bp_bundle.")

    class Meta:
        description = "Adds a favorite item to the favorites."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        product_id = data.get("product_id")
        bp_bundle_id = data.get("bp_bundle_id")
        original_user = info.context.user
        brand_store_owner_user = info.context.brand_store_owner_user
        if product_id:
            product = cls.get_node_or_error(info, product_id, only_type=Product)
            brand_product_variant = BrandProductVariant.objects.filter(
                brand=brand_store_owner_user.switched_brand, product_variant=product.default_variant
            ).first()
            bp_bundle = None
        elif bp_bundle_id:
            product = None
            brand_product_variant = None
            bp_bundle = cls.get_node_or_error(info, bp_bundle_id, only_type=BpBundle)
        else:
            raise ValidationError("찜하기에 추가할 상품 정보가 입력되지 않았습니다.")

        if brand_product_variant:
            if account_models.Favorites.objects.filter(
                user=brand_store_owner_user, brand_product_variant=brand_product_variant
            ).first():
                raise ValidationError("이미 찜하기에 추가된 상품입니다.")
        elif bp_bundle:
            if account_models.Favorites.objects.filter(
                user=brand_store_owner_user, bp_bundle=bp_bundle
            ).first():
                raise ValidationError("이미 찜하기에 추가된 상품입니다.")
        else:
            raise ValidationError("찜하기에 추가할 상품 정보 오류입니다.")

        new_favorite = account_models.Favorites(
            user=brand_store_owner_user,
            product=product,
            brand_product_variant=brand_product_variant,
            bp_bundle=bp_bundle,
        )
        new_favorite.save()

        # 여기서 user는 요청자를 돌려줘야함. 추가된 favorite은 User Type에서 resolver를 통해서 불러옴.
        return cls(user=original_user)


class FavoritesDelete(BaseMutation):
    user = graphene.Field(User, description="An updated user instance.")

    class Arguments:
        # 둘 중 하나는 필수 입력되어야 함
        product_id = graphene.ID(description="ID of the product.")
        bp_bundle_id = graphene.ID(description="ID of the bp_bundle.")

    class Meta:
        description = "Delete the favorite out of the favorites."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        product_id = data.get("product_id")
        bp_bundle_id = data.get("bp_bundle_id")
        original_user = info.context.user
        brand_store_owner_user = info.context.brand_store_owner_user
        # 단종된 제품인 경우, cls.get_node_or_error를 통해 불러오는 중에 에러 발생. - ProductsQueryset의 visible_to_user 메서드에서 단종된 제품은 제외하고 불러오기 때문.
        # 단종된 제품이 찜 리스트에 남아있는 경우 삭제는 가능해야 하기 때문에 get_node_or_error를 통해 불러오지 않고, pk를 통해 불러옴.
        if product_id:
            product_pk = from_global_id_strict_type(product_id, Product, field="id")
            favorites = account_models.Favorites.objects.filter(
                user=brand_store_owner_user, product_id=product_pk
            )
            favorites.delete()
        elif bp_bundle_id:
            bp_bundle_pk = from_global_id_strict_type(bp_bundle_id, BpBundle, field="id")
            favorites = account_models.Favorites.objects.filter(
                user=brand_store_owner_user, bp_bundle_id=bp_bundle_pk
            )
            favorites.delete()
        else:
            raise ValidationError("찜하기에서 삭제할 상품 정보가 입력되지 않았습니다.")

        # 여기서 user는 요청자를 돌려줘야함. favorite은 User Type에서 resolver를 통해서 불러옴.
        return cls(user=original_user)
