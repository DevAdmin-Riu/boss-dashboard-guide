logger = logging.getLogger(__name__)


def get_quantity_allocated_by_stock_qs(stock_qs) -> Decimal:
    if not stock_qs:
        return 0
    return stock_qs.aggregate(
        quantity_allocated=Coalesce(Sum("allocations__quantity_allocated"), 0)
    )["quantity_allocated"]


def get_quantity_virtual_allocated_by_stock_qs(stock_qs) -> Decimal:
    if not stock_qs:
        return 0
    return stock_qs.aggregate(
        quantity_virtual_allocated=Coalesce(Sum("allocations__quantity_virtual_allocated"), 0)
    )["quantity_virtual_allocated"]


def get_available_quantity_by_stock_qs_and_variant(stock_qs, variant) -> Decimal:

    total_quantity = stock_qs.aggregate(total_quantity=Coalesce(Sum("quantity"), 0))[
        "total_quantity"
    ]

    quantity_allocated = stock_qs.aggregate(
        quantity_allocated=Coalesce(Sum("allocations__quantity_allocated"), 0)
    )["quantity_allocated"]

    quantity_can_not_sell = RackStockDetail.objects.get_variant_remain_quantity_only_can_not_sell(
        variant
    )

    # NOTE : 마이너스 값도 리턴될 수 있도록 수정 되었음.
    return total_quantity - quantity_allocated - quantity_can_not_sell


def get_total_stock_quantity_by_stock_qs(stock_qs) -> Decimal:
    results = stock_qs.aggregate(
        total_quantity=Coalesce(Sum("quantity"), 0),
    )
    total_quantity = results["total_quantity"]
    return total_quantity


def get_total_stock_quantity_by_stock_detail_qs(stock_detail_qs) -> Decimal:
    results = stock_detail_qs.aggregate(
        total_quantity=Coalesce(Sum("remain_quantity"), 0),
    )
    total_quantity = results["total_quantity"]

    return total_quantity


# 실제 주문가능 수량: 아우터는 아우터 수량만으로, 이너는 소분될 것을 고려한 수량으로 리턴
def get_orderable_qty_by_stock_qs(
    pv: "ProductVariant",
    stock_qs: StockQuerySet,
    country_code: str,
    # until_short_term 을 None 으로 요청하면 입고 예정 수량을 고려하지 않은 가용재고 수량을 리턴
    until_short_term: Optional[bool],
) -> Decimal:
    outer = pv.outer

    # 아우터
    if outer is None:
        available_quantity = get_available_quantity_by_stock_qs_and_variant(stock_qs, pv)
        quantity_virtual_allocated = get_quantity_virtual_allocated_by_stock_qs(stock_qs)
        availalbe_qty_consider_vitual_alloc = available_quantity - quantity_virtual_allocated
        qty_to_be_stocked = (
            get_qty_to_be_stocked_consider_inner(pv, until_short_term=until_short_term)
            if until_short_term is not None
            else 0
        )
        return max(availalbe_qty_consider_vitual_alloc + qty_to_be_stocked, 0)

    # 이너
    inner_available_quantity = get_available_quantity_by_stock_qs_and_variant(stock_qs, pv)
    inner_quantity_virtual_allocated = get_quantity_virtual_allocated_by_stock_qs(stock_qs)

    pack_count = calc_pack_count(pv, outer)
    outer_stock_qs = Stock.objects.get_variant_stocks_for_country(country_code, outer)
    outer_available_quantity = get_available_quantity_by_stock_qs_and_variant(outer_stock_qs, pv)
    inner_availalbe_qty_consider_vitual_alloc = (
        inner_available_quantity
        + outer_available_quantity * pack_count
        - inner_quantity_virtual_allocated
    )
    qty_to_be_stocked = (
        get_qty_to_be_stocked_consider_inner(pv, until_short_term=until_short_term)
        if until_short_term is not None
        else 0
    )

    return max(inner_availalbe_qty_consider_vitual_alloc + qty_to_be_stocked, 0)


# 실제 주문가능 수량: 아우터는 아우터 수량만으로, 이너는 소분될 것을 고려한 수량으로 리턴
def get_orderable_qty_by_prefetched_data(
    pv: "ProductVariant",
    # until_short_term 을 None 으로 요청하면 입고 예정 수량을 고려하지 않은 가용재고 수량을 리턴
    until_short_term: Optional[bool],
) -> Decimal:
    outer = pv.outer
    prefetched_stocks = getattr(pv, "prefetched_stocks", [])
    prefetched_rack_stocks = getattr(pv, "prefetched_rack_stocks", [])

    # 아우터
    if outer is None:
        available_quantity = get_available_qty_by_prefetched_data(
            prefetched_stocks, prefetched_rack_stocks
        )
        quantity_virtual_allocated = get_total_virtual_allocated_qty_by_prefetched_data(
            prefetched_stocks
        )
        availalbe_qty_consider_vitual_alloc = available_quantity - quantity_virtual_allocated
        qty_to_be_stocked = (
            get_qty_to_be_stocked_by_prefetched_data(
                getattr(pv, "prefetched_to_be_stocked_po_lines", []),
                until_short_term=until_short_term,
            )
            if until_short_term is not None
            else 0
        )
        return max(availalbe_qty_consider_vitual_alloc + qty_to_be_stocked, 0)

    # 이너
    inner_available_quantity = get_available_qty_by_prefetched_data(
        prefetched_stocks, prefetched_rack_stocks
    )
    inner_quantity_virtual_allocated = get_total_virtual_allocated_qty_by_prefetched_data(
        prefetched_stocks,
    )
    pack_count = calc_pack_count(pv, outer)
    outer_available_quantity = get_available_qty_by_prefetched_data(
        getattr(pv, "prefetched_outer_stocks", []), getattr(pv, "prefetched_outer_rack_stocks", [])
    )
    inner_availalbe_qty_consider_vitual_alloc = (
        inner_available_quantity
        + outer_available_quantity * pack_count
        - inner_quantity_virtual_allocated
    )
    qty_to_be_stocked = (
        get_qty_to_be_stocked_by_prefetched_data(
            getattr(pv, "prefetched_outer_to_be_stocked_po_lines", []),
            until_short_term=until_short_term,
        )
        if until_short_term is not None
        else 0
    )
    return max(inner_availalbe_qty_consider_vitual_alloc + qty_to_be_stocked * pack_count, 0)


# 안전재고 상태, 소진임박 상태, 재발주점 상태 판정용으로 아우터 기준으로 변환된 수량 리턴
def get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
    pv: "ProductVariant",
    # until_short_term 을 None 으로 요청하면 입고 예정 수량을 고려하지 않은 가용재고 수량을 리턴
    until_short_term: Optional[bool],
) -> Decimal:
    is_inner = pv.is_inner
    if is_inner:
        outer_available_qty = get_available_qty_by_prefetched_data(
            getattr(pv, "prefetched_outer_stocks", []),
            getattr(pv, "prefetched_outer_rack_stocks", []),
        )
        outer_virtual_allocated_qty = get_total_virtual_allocated_qty_by_prefetched_data(
            getattr(pv, "prefetched_outer_stocks", []),
        )
        outer_availalbe_qty_consider_vitual_alloc = (
            outer_available_qty - outer_virtual_allocated_qty
        )
        qty_to_be_stocked = (
            get_qty_to_be_stocked_by_prefetched_data(
                getattr(pv, "prefetched_outer_to_be_stocked_po_lines", []),
                until_short_term=until_short_term,
            )
            if until_short_term is not None
            else 0
        )
        outer_orderable_qty = max(outer_availalbe_qty_consider_vitual_alloc + qty_to_be_stocked, 0)

        inner_available_qty = get_available_qty_by_prefetched_data(
            getattr(pv, "prefetched_stocks", []),
            getattr(pv, "prefetched_rack_stocks", []),
        )
        inner_virtual_allocated_qty = get_total_virtual_allocated_qty_by_prefetched_data(
            getattr(pv, "prefetched_stocks", []),
        )
        inner_availalbe_qty_consider_vitual_alloc = (
            inner_available_qty - inner_virtual_allocated_qty
        )
        pack_count = calc_pack_count(pv, pv.outer)
    else:
        outer_available_qty = get_available_qty_by_prefetched_data(
            getattr(pv, "prefetched_stocks", []),
            getattr(pv, "prefetched_rack_stocks", []),
        )
        outer_virtual_allocated_qty = get_total_virtual_allocated_qty_by_prefetched_data(
            getattr(pv, "prefetched_stocks", []),
        )
        outer_availalbe_qty_consider_vitual_alloc = (
            outer_available_qty - outer_virtual_allocated_qty
        )
        qty_to_be_stocked = (
            get_qty_to_be_stocked_by_prefetched_data(
                getattr(pv, "prefetched_to_be_stocked_po_lines", []),
                until_short_term=until_short_term,
            )
            if until_short_term is not None
            else 0
        )
        outer_orderable_qty = max(outer_availalbe_qty_consider_vitual_alloc + qty_to_be_stocked, 0)

        prefetched_inner_stocks = getattr(pv, "prefetched_inner_stocks", [])
        prefetched_inner_rack_stocks = getattr(pv, "prefetched_inner_rack_stocks", [])
        inner_available_qty = get_available_qty_by_prefetched_data(
            prefetched_inner_stocks, prefetched_inner_rack_stocks
        )
        inner_virtual_allocated_qty = get_total_virtual_allocated_qty_by_prefetched_data(
            prefetched_inner_stocks
        )
        inner_availalbe_qty_consider_vitual_alloc = (
            inner_available_qty - inner_virtual_allocated_qty
        )
        pack_count = calc_pack_count(pv.inner, pv)

    converted_inner_orderable_qty_to_outer_base = (
        my_round(inner_availalbe_qty_consider_vitual_alloc / pack_count, 2) if pack_count > 0 else 0
    )
    return outer_orderable_qty + converted_inner_orderable_qty_to_outer_base


# NOTE 아래 함수 로직 수정시 QtyToBeStockedShortTermByProductVariantIdLoader, QtyToBeStockedLongTermByProductVariantIdLoader 도 수정 필요.
def get_qty_to_be_stocked_by_variant(variant, until_short_term: bool):
    to_be_stocked = get_qty_to_be_stocked_consider_inner(variant, until_short_term)
    return to_be_stocked


# NOTE 아래 함수 로직 수정시 QtyToBeStockedShortTermByProductVariantIdLoader, QtyToBeStockedLongTermByProductVariantIdLoader 도 수정 필요.
def _get_qty_to_be_stocked_by_variant(variant, until_short_term: bool) -> Decimal:
    purchase_order_lines_qs = PurchaseOrderLine.objects.filter(variant=variant)
    purchase_order_lines_qs = filter_to_be_stocked_by_purchase_order_lines_qs(
        purchase_order_lines_qs
    )

    # 단기 입고 에정은 현재 정책은 내일까지 입고 예정 수량으로 제한
    if until_short_term:
        today = kst_timezone_date()
        one_days_later = today + timedelta(days=1)
        purchase_order_lines_qs = purchase_order_lines_qs.filter(
            expected_purchase_date__range=(today, one_days_later)
        )

    total_quantities = purchase_order_lines_qs.aggregate(
        total_quantity=Coalesce(
            Sum(
                "quantity",
                filter=Q(status__in=STOCKABLE_STATUSES_USING_QUANITY),
            ),
            0,
        ),
        total_purchase_quantity=Coalesce(
            Sum(
                "purchase_quantity",
                filter=Q(status__in=STOCKABLE_STATUSES_USING_PURCHASE_QUANITY),
            ),
            0,
        ),
    )
    return total_quantities["total_quantity"] + total_quantities["total_purchase_quantity"]


# NOTE 아래 함수 로직 수정시 QtyToBeStockedShortTermByProductVariantIdLoader, QtyToBeStockedLongTermByProductVariantIdLoader 도 수정 필요.
def get_qty_to_be_stocked_consider_inner(variant, until_short_term: bool) -> Decimal:
    outer = variant.outer

    # 아우터
    if outer is None:
        return _get_qty_to_be_stocked_by_variant(variant, until_short_term=until_short_term)
    # 이너
    else:
        pack_count = calc_pack_count(variant, outer)
        return (
            _get_qty_to_be_stocked_by_variant(outer, until_short_term=until_short_term) * pack_count
        )


def get_outer_base_qty_to_be_stocked_consider_inner(variant, until_short_term: bool) -> Decimal:
    if variant.outer_id is None:
        return _get_qty_to_be_stocked_by_variant(variant, until_short_term=until_short_term)
    outer = variant.outer
    return _get_qty_to_be_stocked_by_variant(outer, until_short_term=until_short_term)


def check_stock_quantity_by_orderable_qty(
    variant: "ProductVariant",
    orderable_qty: Decimal,
    order_qty: Decimal,
    no_allow_auto_consignment=False,
    bp_name=None,
):
    if variant.track_inventory:
        # no_allow_auto_consignment가 True인 경우, 자동위탁 관계없이 무조건 재고여부만 체크 해야함.
        if no_allow_auto_consignment:
            if order_qty > orderable_qty:
                raise InsufficientStock(variant, bp_name=bp_name)
        else:
            if not variant.allow_auto_consignment and order_qty > orderable_qty:
                raise InsufficientStock(variant, bp_name=bp_name)


def check_stock_quantity_by_contury(
    variant: "ProductVariant",
    country_code: str,
    order_qty: Decimal,
    no_allow_auto_consignment=False,
    bp_name=None,
):
    if variant.track_inventory:
        stock_qs = Stock.objects.get_variant_stocks_for_country(country_code, variant)
        if not stock_qs:
            raise InsufficientStock(variant, bp_name=bp_name)
        orderable_quantity = get_orderable_qty_by_stock_qs(
            variant, stock_qs, country_code, until_short_term=True
        )
        check_stock_quantity_by_orderable_qty(
            variant, orderable_quantity, order_qty, no_allow_auto_consignment, bp_name=bp_name
        )


def get_quantity_virtual_allocated(variant: "ProductVariant", country_code: str) -> Decimal:
    stock_qs = Stock.objects.get_variant_stocks_for_country(country_code, variant)
