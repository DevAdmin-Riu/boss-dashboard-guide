from django.core.exceptions import ValidationError
from django.core.validators import MaxValueValidator, MinValueValidator
from django.db import IntegrityError, models
from django.utils.translation import gettext_lazy
from mptt.managers import TreeManager
from mptt.models import MPTTModel

from ..account.models import PossiblePhoneNumberField, User
from ..brand_store.models import FranchiseContractInfo, FranchiseDocument
from ..core import GenderType
from ..core.models import ConsultationModel
from ..core.utils.json_serializer import CustomJsonEncoder
from . import (
    PreFounderBasicDocumentType,
    PreFounderConsultationMethod,
    PreFounderConsultationResult,
    PreFounderEvalStatus,
    PreFounderLeadSource,
)
from .utils import upload_to_for_pre_founder_basic_document


class PreFounder(FranchiseContractInfo):
    brand = models.ForeignKey(
        "account.Brand",
        on_delete=models.CASCADE,
        related_name="pre_founders",
    )
    created = models.DateTimeField(auto_now_add=True)
    sequence = models.PositiveIntegerField(
        help_text="브랜드 내에서의 일련번호(생성 순)", editable=False
    )
    name = models.CharField(max_length=255)
    phone = PossiblePhoneNumberField()
    gender = models.CharField(max_length=10, choices=GenderType.choices)
    birth_date = models.DateField(blank=True, null=True)
    email = models.EmailField(blank=True, null=True)
    biz_reg_no = models.CharField(max_length=10, blank=True, null=True)
    lead_source = models.CharField(
        max_length=50, choices=PreFounderLeadSource.choices, help_text="유입 경로"
    )
    lead_source_etc = models.CharField(
        max_length=255, blank=True, null=True, help_text="유입 경로 - 기타"
    )
    desired_region = models.ForeignKey(
        "site.RegionInfo",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="+",
        help_text="창업 희망 지역",
    )
    address = models.ForeignKey(
        "account.Address",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="+",
        help_text="자택 주소",
    )
    memo = models.TextField(blank=True, null=True, help_text="메모(특이사항)")

    # 문서 정보(파일, 파일명)는 PfFranchiseDocument 모델에서 관리.
    # 계약 정보는 FranchiseContractInfo 추상 모델에서 관리.

    # 예비창업자 평가 관련 필드(캐싱 역할 및 리스트 필터 위해 필드로 정의)
    # PreFounderEvalItem, PreFounderEvalAnswer 데이터 변경에 따라 업데이트 필요
    eval_status = models.CharField(
        max_length=20,
        choices=PreFounderEvalStatus.choices,
        default=PreFounderEvalStatus.NOT_EVALUATED,
        help_text="예비창업자 평가 상태",
    )
    eval_total_score = models.FloatField(
        blank=True, null=True, help_text="예비창업자 평가 점수 합계 (0.00 ~ 5.00)"
    )

    first_consultation = models.ForeignKey(
        "PreFounderConsultation",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="+",
        help_text="해당 예비창업자에 대한 최초 상담 내역(등록이 아닌 상담일 기준)",
    )
    last_consultation = models.ForeignKey(
        "PreFounderConsultation",
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="+",
        help_text="해당 예비창업자에 대한 최종 상담 내역(등록이 아닌 상담일 기준)",
    )

    def __str__(self):
        return f"{self.brand.name} - {self.name} - {self.phone}"

    def save(self, *args, **kwargs):
        if not self.pk:
            last_sequence = (
                PreFounder.objects.select_for_update()
                .filter(brand=self.brand)
                .aggregate(models.Max("sequence"))["sequence__max"]
            )
            self.sequence = (last_sequence or 0) + 1

        try:
            super().save(*args, **kwargs)
        except IntegrityError as e:
            if "unique_pre_founder_name_phone" in str(e):
                raise ValidationError("이미 같은 이름과 연락처를 가진 예비창업자가 존재합니다.")
            raise
        except Exception as e:
            raise ValidationError(
                "예비창업자 정보 저장 중 알 수 없는 오류가 발생했습니다. 관리자에게 문의해주세요."
            )

    class Meta:
        ordering = ("-sequence",)
        constraints = [
            models.UniqueConstraint(
                fields=["brand", "name", "phone"], name="unique_pre_founder_name_phone"
            )
        ]


