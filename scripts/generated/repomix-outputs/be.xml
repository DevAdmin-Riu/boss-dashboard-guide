        model = PreFounderModel
        error_type_class = PreFounderError
        error_type_field = "pre_founder_errors"

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        cleaned_input["basic_documents"] = cls.clean_basic_documents(info, instance, cleaned_input)
        return cleaned_input

    @classmethod
    def prepare_address(cls, cleaned_data, *args):
        address_data = cleaned_data.get("address")
        if address_data is None:
            return None
        address_form = cls.validate_address_form(address_data)
        return address_form.save()

