# 재고 발주서 입고완료로 입고 시, 재고 발주서 부분입고 -> 입고완료로 상태 변경 시에 호출
def use_auto_turn_off_allow_auto_consignment(
    purchase_order_lines: List["PurchaseOrderLine"],
):
    for line in purchase_order_lines:
        variant = line.variant
        # 재고 운영여부, 자동위탁여부, 그리고 auto_turn_off_allow_auto_consignment까지 모두 true인 경우
        if (
            variant.track_inventory
            and variant.allow_auto_consignment
            and variant.auto_turn_off_allow_auto_consignment
        ):
            variant.allow_auto_consignment = False
            variant.auto_turn_off_allow_auto_consignment = False
            variant.save(
                update_fields=["allow_auto_consignment", "auto_turn_off_allow_auto_consignment"]
            )


def decrease_stock_from_take_back_purchase_order(
    user: "User",
    purchase_order: "PurchaseOrder",
    take_back_purchase_order_line: "PurchaseOrderLine",
    quantity,
    rack_location: "RackLocation",
) -> int:
    if take_back_purchase_order_line is None or rack_location is None:
        error_type = 1
        return error_type

    stock_detail = StockDetail.objects.filter(
        purchase_order_line=take_back_purchase_order_line
    ).first()
    if stock_detail is None:
        error_type = 2
        return error_type
    if stock_detail.remain_quantity < quantity:
        error_type = 3
        return error_type

    stock = stock_detail.stock
    quantity_allocated = stock.allocations.get_quantity_allocated()
    if stock.quantity - quantity_allocated < quantity:
        error_type = 4
        return error_type

    rack_stock_detail = RackStockDetail.objects.filter(
        location=rack_location, stock_detail=stock_detail
    ).first()
    if rack_stock_detail is None:
        error_type = 5
        return error_type
    if rack_stock_detail.remain_quantity < quantity:
        error_type = 6
        return error_type

    stock.decrease_stock(quantity)
    stock_detail.decrease_remain_stock(quantity)
    rack_stock_detail.decrease_remain_stock(quantity)

    reason = f"반품발주서: {purchase_order.code}, 원 발주서 발주상세번호: {take_back_purchase_order_line.code}"
    create_take_back_stock_detail_event(
        stock, user=user, quantity=quantity, reason=reason, rack_location=rack_location
    )
    return 0


def set_consignment_po_line_status_on_order_fulfilled(
    requester: "User",
    order: "Order",
    fulfillment_lines: List["FulfillmentLine"],
    quantities: List[Decimal],
    b2b_delivery_fee_exclude_vat_list: List[Decimal],
):
    po_line_map: Dict[int, PurchaseOrderLine] = {}
    b2b_order_line_map: Dict[int, OrderLine] = {}
    is_consignment_by_non_courier_order_line_map: Dict[int, OrderLine] = {}
    for line, purchase_quantity, b2b_delivery_fee_exclude_vat in zip(
        fulfillment_lines, quantities, b2b_delivery_fee_exclude_vat_list
    ):
        order_line = line.order_line
        variant: ProductVariant = order_line.variant
        if order_line.track_inventory == False or variant.is_vendor_track_inventory:
            po_line: PurchaseOrderLine = order_line.purchase_order_line
            is_adjust_price_order_line_case = check_adjust_price_order_line(
                order_line, order.delivery_method
            )
            is_consignment_by_non_courier_order_line_case = (
                check_consignment_by_non_courier_order_line(order_line, order.delivery_method)
            )
            # 납품 시 금액확정 제품은 박스 당 수량에 고려하여 출고되므로 출고량을 sum 해야 함
            if is_adjust_price_order_line_case:
                if po_line.status == PurchaseOrderLineStatus.RECEIVED:
                    po_line.purchase_quantity = purchase_quantity
                    po_line_map[po_line.id] = po_line
                elif po_line.status == PurchaseOrderLineStatus.DISPATCH_FULFILLMENT:
                    po_line.purchase_quantity += purchase_quantity
                    # 납품 시 금액확정 제품은 입고 수량이 누적된 상태 마지막 것으로 po_line_set 에 반영되어야 함
                    po_line_map[po_line.id] = po_line
            elif is_consignment_by_non_courier_order_line_case:
                # 위탁 화물차 주문은 한방에 출고 처리함
                if po_line.status == PurchaseOrderLineStatus.RECEIVED:
                    po_line.purchase_quantity = purchase_quantity
                    po_line_map[po_line.id] = po_line
            if po_line.status == PurchaseOrderLineStatus.RECEIVED:
                po_line.status = PurchaseOrderLineStatus.DISPATCH_FULFILLMENT
                po_line.purchase_date = kst_timezone_date()
                if is_consignment_by_non_courier_order_line_case:
                    is_consignment_by_non_courier_order_line_map[order_line.id] = order_line
                if order.is_b2b_order:
                    po_line.b2b_delivery_fee_exclude_vat = b2b_delivery_fee_exclude_vat
                    order_line.b2b_status = OrderLineB2bStatus.DISPATCH_FULFILLMENT
                    b2b_order_line_map[order_line.id] = order_line
                if not is_adjust_price_order_line_case:
                    po_line_map[po_line.id] = po_line

    po_lines = list(po_line_map.values())
    b2b_order_lines = list(b2b_order_line_map.values())
    is_consignment_by_non_courier_order_lines = list(
        is_consignment_by_non_courier_order_line_map.values()
    )

    if po_lines:
        PurchaseOrderLine.objects.bulk_update(
            po_lines,
            ["status", "purchase_date", "purchase_quantity", "b2b_delivery_fee_exclude_vat"],
        )
        add_purchase_by_purchase_order_lines(po_lines)
        if order.is_b2b_order:
            add_sales_for_b2b_order(po_lines)
        bulk_create_po_line_status_histories(
            po_lines,
            before_status=PurchaseOrderLineStatus.RECEIVED,
            after_status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
            user=requester,
        )
        add_po_manage_event_with_type(requester, po_lines, PurchaseOrderManageEventType.FULFILLED)

    if b2b_order_lines:
        OrderLine.objects.bulk_update(b2b_order_lines, ["b2b_status"])
        order_b2b_fulfilled_event(user=requester, order_lines=b2b_order_lines)
        bulk_create_order_line_b2b_status_histories(
            b2b_order_lines,
            before_status=OrderLineB2bStatus.RECEIVED,
            after_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT,
            user=requester,
        )

    if is_consignment_by_non_courier_order_lines:
        from ..order.actions import update_on_change_qty_of_deferred_pay

        update_on_change_qty_of_deferred_pay(is_consignment_by_non_courier_order_lines)


def _cancel_fulfillment_and_restock_vendor_track_inventory(user, po_lines: List[PurchaseOrderLine]):
    fulfillment_map: Dict[int, Fulfillment] = {}
    vendor_track_inventory_fulfillment_map: Dict[int, Tuple[Fulfillment, Warehouse]] = {}
    for line in po_lines:
        order_line: OrderLine = line.order_line
        fulfillment_lines: List[FulfillmentLine] = order_line.fulfillment_lines.all()
        for fulfillment_line in fulfillment_lines:
            fulfillment = fulfillment_line.fulfillment
            fulfillment.status = FulfillmentStatus.CANCELED
            fulfillment_map[fulfillment.id] = fulfillment_line.fulfillment
            variant: ProductVariant = order_line.variant
            if (
                order_line.track_inventory
                and order_line.decrease_stock_flag
                and variant.is_vendor_track_inventory
            ):
                stock: Stock = fulfillment_line.stock
                vendor_track_inventory_fulfillment_map[fulfillment.id] = (
                    fulfillment_line.fulfillment,
                    stock.warehouse,
                )
                rack_location: RackLocation = None
                stock_detail_lines: List[StockDetailLine] = (
                    fulfillment_line.stock_detail_lines.all()
                )
                for stock_detail_line in stock_detail_lines:
                    rack_location: RackLocation = stock_detail_line.rack_location
                    if rack_location:
                        break
                if not rack_location:
                    rack_location: Optional[RackLocation] = (
                        RackLocation.objects.filter(
                            can_picking=True, rack_stocks__product_variant=variant
                        )
                        .annotate(total_quantity=Coalesce(Sum("rack_stocks__remain_quantity"), 0))
                        .order_by("-total_quantity")
                        .first()
                    )
                    if not rack_location:
                        raise ValidationError(
                            "위탁재고 출고 건의 재고를 되돌리기할 피킹 로케이션이 설정되어 있지 않습니다."
                        )
                increase_stock_using_stock_detail(
                    user,
                    fulfillment.order,
                    fulfillment_line,
                    order_line,
                    stock.warehouse,
                    fulfillment_line.quantity,
                    allocate=True,
                    rack_location=rack_location,
                )

    fulfillment_list = list(fulfillment_map.values())
    if fulfillment_list:
        Fulfillment.objects.bulk_update(fulfillment_list, ["status"])
        for fulfillment in fulfillment_list:
            fulfillment_canceled_event(order=fulfillment.order, user=user, fulfillment=fulfillment)

    vendor_track_inventory_fulfillment_list = list(vendor_track_inventory_fulfillment_map.values())
    if vendor_track_inventory_fulfillment_list:
        for fulfillment, warehouse in vendor_track_inventory_fulfillment_list:
            fulfillment_restocked_items_event(
                order=fulfillment.order,
                user=user,
                fulfillment=fulfillment,
                warehouse_pk=warehouse.pk if warehouse else None,
            )


def _revert_update_order_line_quantity_fulfilled(po_lines: List[PurchaseOrderLine]):
    order_lines: List[OrderLine] = []
    for line in po_lines:
        order_line: OrderLine = line.order_line
        order_line.quantity_fulfilled = 0
        order_lines.append(order_line)

    if order_lines:
        OrderLine.objects.bulk_update(order_lines, ["quantity_fulfilled"])


def _revert_order_fulfilled(user, po_lines: List[PurchaseOrderLine]):
    orders_set: Set[Order] = set()
    for line in po_lines:
        order_line: OrderLine = line.order_line
        order: Order = order_line.order
        status = get_order_status_depending_on_fulfillments(order)
        order.status = status
        orders_set.add(order)
    orders = list(orders_set)
    if orders:
        Order.objects.bulk_update(orders, ["status"])
        order_events = []
        for order in orders:
            order_event = OrderEvent(
                order=order,
                type=OrderEvents.REVERT_FULFILLMENT_CANCELED,
                user=user,
                parameters={},
            )
            order_events.append(order_event)
        OrderEvent.objects.bulk_create(order_events)


def _revert_add_purchase_by_purchase_order_lines(
    po_lines: List["PurchaseOrderLine"],
):
    po_lines_pk_list = [po_line.pk for po_line in po_lines]
    Purchase.objects.filter(purchase_order_line_id__in=po_lines_pk_list).update(
        status=PurchaseStatus.CANCELED
    )


def _revert_add_sales_for_b2b_order(
    po_lines: List["PurchaseOrderLine"],
):
    order_lines_pk_list = [po_line.order_line_id for po_line in po_lines]
    b2b_sales_qs = (
        StatsBrandQueries.sales_qs_exclude_canceled()
        .filter(order_type__in=ORDER_TYPES_FOR_B2B)
        .filter(order_line_id__in=order_lines_pk_list)
    )
    cannot_revert = b2b_sales_qs.filter(
        b2b_status__in=[
            SalesB2bStatus.BEFORE_SEND,
            SalesB2bStatus.PENDING,
            SalesB2bStatus.REQ_REVISION,
            SalesB2bStatus.REVISION,
            SalesB2bStatus.CLOSED,
        ]
    ).exists()
    if cannot_revert:
        raise ValidationError(
            "b2b 매출 마감 처리가 진행중이거나 완료된 주문이 포함되어서 되돌리기 할 수 없습니다."
        )
    b2b_sales_qs.update(b2b_status=SalesB2bStatus.CANCELED)


def _revert_set_consignment_po_line_status_on_order_fulfilled(
    user: "User",
    po_lines: List["PurchaseOrderLine"],
):
    order_map: Dict[int, Order] = {}
    b2b_order_line_map: Dict[int, OrderLine] = {}
    is_consignment_by_non_courier_order_line_map: Dict[int, OrderLine] = {}
    for po_line in po_lines:
        order_line: OrderLine = po_line.order_line
        order = order_line.order
        order_map[order.id] = order
        po_line.purchase_date = None
        if check_consignment_by_non_courier_order_line(order_line, order.delivery_method):
            po_line.purchase_quantity = po_line.quantity
            is_consignment_by_non_courier_order_line_map[order_line.id] = order_line
        if order.is_b2b_order:
            order_line.b2b_status = OrderLineB2bStatus.RECEIVED
            b2b_order_line_map[order_line.id] = order_line
    if po_lines:
        PurchaseOrderLine.objects.bulk_update(
            po_lines,
            ["purchase_date", "purchase_quantity"],
        )
        _revert_add_purchase_by_purchase_order_lines(po_lines)
        if order.is_b2b_order:
            _revert_add_sales_for_b2b_order(po_lines)

    b2b_order_lines = list(b2b_order_line_map.values())
    is_consignment_by_non_courier_order_lines = list(
        is_consignment_by_non_courier_order_line_map.values()
    )

    if b2b_order_lines:
        OrderLine.objects.bulk_update(b2b_order_lines, ["b2b_status"])
        orders = list(order_map.values())
        if orders:
            order_events = []
            for order in orders:
                filtered_order_lines: List[OrderLine] = [
                    po_line.order_line
                    for po_line in po_lines
                    if po_line.order_line.order_id == order.pk
                ]
                order_event = OrderEvent(
                    order=order,
                    type=OrderEvents.REVERT_FULFILLMENT_CANCELED,
                    user=user,
                    parameters={
                        "message": ", ".join(
                            [line.composed_id_with_prefix for line in filtered_order_lines]
                        )
                    },
                )
                order_events.append(order_event)
            OrderEvent.objects.bulk_create(order_events)

        bulk_create_order_line_b2b_status_histories(
            b2b_order_lines,
            before_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT,
            after_status=OrderLineB2bStatus.RECEIVED,
            user=user,
        )

    if is_consignment_by_non_courier_order_lines:
        from ..order.actions import update_on_change_qty_of_deferred_pay

        update_on_change_qty_of_deferred_pay(is_consignment_by_non_courier_order_lines)


def revert_consignment_po_to_received(user, po_lines: List[PurchaseOrderLine]):
    _cancel_fulfillment_and_restock_vendor_track_inventory(user, po_lines)
    _revert_update_order_line_quantity_fulfilled(po_lines)
    _revert_order_fulfilled(user, po_lines)
    _revert_set_consignment_po_line_status_on_order_fulfilled(user, po_lines)


def set_consignment_po_line_status_on_update_tracking_info(
    user: "User", fulfillment_lines: List["FulfillmentLine"], is_by_courier: bool
):
    po_line_map: Dict[int, PurchaseOrderLine] = {}
    order_line_map: Dict[int, OrderLine] = {}
    for fulfillment_line in fulfillment_lines:
        if fulfillment_line.order_line.track_inventory == False:
            order_line = fulfillment_line.order_line
            order_line_map[order_line.id] = order_line

    order_lines = list(order_line_map.values())
    for order_line in order_lines:
        po_line: PurchaseOrderLine = order_line.purchase_order_line
        if po_line.status in [
            PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
            PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED,
        ]:
            is_delivery_confirmed = (
                not Fulfillment.objects.filter(
                    lines__order_line_id=order_line.pk, tracking_number__exact=""
                ).exists()
                if is_by_courier
                else True
            )
            po_line.status = (
                PurchaseOrderLineStatus.DELIVERY_CONFIRMED
                if is_delivery_confirmed
                else PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED
            )
            po_line_map[po_line.id] = po_line

    po_lines = list(po_line_map.values())
    if po_lines:
        PurchaseOrderLine.objects.bulk_update(po_lines, ["status"])
        bulk_create_po_line_status_histories(
            po_lines,
            before_status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
            after_status=PurchaseOrderLineStatus.DELIVERY_CONFIRMED,
            user=user,
        )
        add_po_manage_event_with_type(
            user, po_lines, PurchaseOrderManageEventType.DELIVERY_CONFIRMED
        )


def _reset_fulfillment_tracking_number_and_etc_delivery_info(
