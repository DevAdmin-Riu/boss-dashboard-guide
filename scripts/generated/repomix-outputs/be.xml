def filter_fields_containing_value(*search_fields: str):
    """Create a icontains filters through given fields on a given query set object."""

    def _filter_qs(qs, _, value):
        if value:
            qs = filter_by_query_param(qs, value, search_fields)
        return qs

    return _filter_qs


# 직접입력 방식은 속성 검색에서 제외함
def _clean_product_attributes_filter_input(
    filter_value,
) -> Dict[int, List[Optional[int]]]:
    attributes = Attribute.objects.prefetch_related("values").exclude(
        input_type=AttributeInputType.DIRECTLY
    )
    attributes_map: Dict[str, int] = {attribute.slug: attribute.pk for attribute in attributes}
    values_map: Dict[str, Dict[str, int]] = {
        attr.slug: {value.slug: value.pk for value in attr.values.all()} for attr in attributes
    }
    queries: Dict[int, List[Optional[int]]] = defaultdict(list)
    # Convert attribute:value pairs into a dictionary where
    # attributes are keys and values are grouped in lists
    for attr_slug, val_slugs in filter_value:
        if attr_slug not in attributes_map:
            raise ValueError("Unknown attribute name: %r" % (attr_slug,))
        attr_pk = attributes_map[attr_slug]
        attr_val_pk = [
            values_map[attr_slug][val_slug]
            for val_slug in val_slugs
            if val_slug in values_map[attr_slug]
        ]
        queries[attr_pk] += attr_val_pk

    return queries


def _clean_product_directly_assigned_attributes_filter_input(
    filter_value,
) -> Dict[int, str]:
    attributes = Attribute.objects.filter(input_type=AttributeInputType.DIRECTLY)
    attributes_map: Dict[str, int] = {attribute.slug: attribute.pk for attribute in attributes}
    queries: Dict[int, str] = defaultdict(list)
    for attr_slug, value in filter_value:
        if attr_slug not in attributes_map:
            raise ValueError("Unknown attribute name: %r" % (attr_slug,))
        attr_pk = attributes_map[attr_slug]
        queries[attr_pk] = value

    return queries


def filter_products_by_attributes(qs, filter_value):
    queries = _clean_product_attributes_filter_input(filter_value)
    filters = [
        Q(
            Exists(
                AssignedProductAttribute.objects.filter(
                    assignment__attribute__id=key, product__id=OuterRef("pk"), values__pk__in=values
                )
            )
        )
        | Q(
            Exists(
                AssignedVariantAttribute.objects.filter(
                    assignment__attribute__id=key,
                    variant__product__id=OuterRef("pk"),
                    values__pk__in=values,
                )
            )
        )
        for key, values in queries.items()
    ]

    return qs.filter(*filters)


def filter_product_variants_by_directly_assigned_attributes(qs, filter_value):
    queries = _clean_product_directly_assigned_attributes_filter_input(filter_value)
    filters = [
        Q(
            Exists(
                DirectlyAssignedProductAttribute.objects.filter(
                    assignment__attribute__id=key,
                    product__id=OuterRef("product__pk"),
                    value__icontains=value,
                )
            )
        )
        | Q(
            Exists(
                DirectlyAssignedVariantAttribute.objects.filter(
                    assignment__attribute__id=key,
                    variant__id=OuterRef("pk"),
                    value__icontains=value,
                )
            )
        )
        for key, value in queries.items()
    ]

    return qs.filter(*filters)


def filter_products_by_variant_cost_price_exclude_vat(qs, cost_price_lte=None, cost_price_gte=None):
    if cost_price_lte:
        qs = qs.filter(variants__cost_price_exclude_vat__lte=cost_price_lte)
    if cost_price_gte:
        qs = qs.filter(variants__cost_price_exclude_vat__gte=cost_price_gte)
    return qs


# outer 제품들의 배송비를 기준으로 필터링
def filter_products_by_variant_delivery_fee(qs, delivery_fee_lte=None, delivery_fee_gte=None):
    if delivery_fee_lte:
        qs = qs.filter(variants__delivery_fee_amount__lte=delivery_fee_lte).filter(
            variants__outer__isnull=True
        )
    if delivery_fee_gte:
        qs = qs.filter(variants__delivery_fee_amount__gte=delivery_fee_gte).filter(
            variants__outer__isnull=True
        )
    return qs


def filter_products_by_categories(qs, categories):
    categories = [category.get_descendants(include_self=True) for category in categories]
    ids = {category.id for tree in categories for category in tree}
    return qs.filter(category__in=ids)


def filter_product_variants_by_categories(qs, categories):
    categories = [category.get_descendants(include_self=True) for category in categories]
    ids = {category.id for tree in categories for category in tree}
    return qs.filter(product__category__in=ids)


def filter_brand_product_variants_by_categories(qs, categories):
    categories = [category.get_descendants(include_self=True) for category in categories]
    ids = {category.id for tree in categories for category in tree}
    return qs.filter(brand_product__product__category__in=ids)


def filter_products_by_collections(qs, collections):
    return qs.filter(collections__in=collections)


def _filter_stock_availability(stock_qs, stock_availability):
    if stock_availability == StockAvailability.OUT_OF_STOCK:
        stock_qs = stock_qs.filter(orderable_qty_incl_short_term__lte=0)
    else:
        stock_qs = stock_qs.none()
    return stock_qs


# 재고제품이거나 재고가 있는 위탁제품 필터링
def _filter_stock_control(stock_qs):
    track_inventory_filter = Q(product_variant__track_inventory=True)
    non_track_inventory_filter = Q(product_variant__track_inventory=False)
    stock_qs = stock_qs.filter(track_inventory_filter | (non_track_inventory_filter))

    return stock_qs


def _get_total_quantity_allocated_qs():
    allocation_qs = (
        Allocation.objects.filter(stock=OuterRef("pk"))
        .values("stock")
        .annotate(total_quantity_allocated=Sum("quantity_allocated"))
        .order_by()
    )

    return allocation_qs


def _get_to_be_stocked_qs(until_short_term: bool):
    purchase_order_lines_qs = PurchaseOrderLine.objects.filter(
        variant=OuterRef("product_variant__pk")
    )
    purchase_order_lines_qs = filter_to_be_stocked_by_purchase_order_lines_qs(
        purchase_order_lines_qs
    )

    if until_short_term:
        today = kst_timezone_date()
        one_days_later = today + timedelta(days=1)
        purchase_order_lines_qs = purchase_order_lines_qs.filter(
            expected_purchase_date__range=(today, one_days_later)
        )

    return (
        purchase_order_lines_qs.values("variant")
        .annotate(
            qty_to_be_stocked=ExpressionWrapper(
                Coalesce(
                    Sum(
                        "quantity",
                        filter=Q(status__in=STOCKABLE_STATUSES_USING_QUANITY),
                    ),
                    0,
                )
                + Coalesce(
                    Sum(
                        "purchase_quantity",
                        filter=Q(status__in=STOCKABLE_STATUSES_USING_PURCHASE_QUANITY),
                    ),
                    0,
                ),
                output_field=DecimalField(),
            )
        )
        .values("qty_to_be_stocked")
    )


def filter_product_variants_by_stock_availability(qs, stock_availability):
    total_quantity_allocated_qs = _get_total_quantity_allocated_qs()
    to_be_stocked_short_term_qs = _get_to_be_stocked_qs(until_short_term=True)

    stock_qs = (
        Stock.objects.annotate(
            total_quantity_allocated=Coalesce(
                Subquery(total_quantity_allocated_qs.values("total_quantity_allocated")), 0
            )
        )
        .annotate(
            qty_to_be_stocked_short_term=Subquery(to_be_stocked_short_term_qs),
        )
        .values("product_variant_id")
        .annotate(total_quantity=Coalesce(Sum("quantity"), 0))
        .annotate(
            total_available=F("total_quantity") - Coalesce(Sum("total_quantity_allocated"), 0)
        )
        .annotate(
            orderable_qty_incl_short_term=F("total_available")
            + Coalesce(Sum("qty_to_be_stocked_short_term"), 0)
        )
        .order_by()
    )
    stock_qs = _filter_stock_availability(stock_qs, stock_availability)
    stock_qs = stock_qs.values_list("product_variant_id", flat=True)

    return qs.filter(id__in=Subquery(stock_qs))


def filter_product_variants_for_stock_control(qs, value):
    if value == True:
        stock_qs = (
            Stock.objects.select_related("product_variant")
            .values("product_variant_id")
            .annotate(total_quantity=Coalesce(Sum("quantity"), 0))
            .order_by()
        )
        stock_qs = _filter_stock_control(stock_qs)
        stock_qs = stock_qs.values_list("product_variant_id", flat=True)

        return qs.filter(id__in=Subquery(stock_qs))
    return qs


