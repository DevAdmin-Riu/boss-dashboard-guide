class AddressDirectShippingStatusUpdateInput(graphene.InputObjectType):
    direct_shipping_status = AddressDirectShippingStatusEnum(
        required=True, description="직배송지 승인 상태"
    )
    direct_shipping_reject_reason = graphene.String(description="직배송 배송지 승인 거절 사유")

    @staticmethod
    def validate_direct_shipping_status(is_staff, cleaned_input, instance):
        direct_shipping_status = cleaned_input.get("direct_shipping_status", None)

        if direct_shipping_status == AddressDirectShippingStatusEnum.APPROVED:
            if is_staff == False:
                raise ValidationError("관리자만 승인할 수 있습니다.")
            direct_shipping_code = instance.direct_shipping_code
            if direct_shipping_code is None or not direct_shipping_code:
                raise ValidationError(
                    "직배송지 코드를 입력하지 않았습니다. 코드를 입력한 후 승인하세요."
                )
            direct_shipping_days = instance.direct_shipping_days
            if direct_shipping_days is None:
                raise ValidationError(
                    "직배송상품 배송가능 요일을 입력하지 않았습니다. 배송가능 요일을 입력한 후 승인하세요."
                )
        elif direct_shipping_status == AddressDirectShippingStatusEnum.REJECTED:
            if is_staff == False:
                raise ValidationError("관리자만 반려할 수 있습니다.")
            direct_shipping_reject_reason = cleaned_input.get("direct_shipping_reject_reason", None)
            if direct_shipping_reject_reason:
                direct_shipping_reject_reason = direct_shipping_reject_reason.strip()
                cleaned_input["direct_shipping_reject_reason"] = direct_shipping_reject_reason
            if direct_shipping_reject_reason is None or not direct_shipping_reject_reason:
                raise ValidationError("직배송지 승인 반려 시 반려 사유를 입력해야 합니다.")

        return cleaned_input


