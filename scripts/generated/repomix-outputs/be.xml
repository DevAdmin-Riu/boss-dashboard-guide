class OrgCodeQuerySet(models.QuerySet):
    def for_user(self, user):
        if user.is_anonymous or not user.is_brand_user:
            return None
        qs1 = self.filter(is_private=True, brand=user.brand_id)
        qs2 = self.filter(is_private=False)
        return qs1 or qs2

    def for_brand(self, user):
        if user.is_anonymous or not user.is_brand_user:
            return None
        qs = self.filter(is_private=False, brand__isnull=True)
        return qs

    def with_counts(self):
        num_vacts = models.Count("org_vacts")
        num_vacts_available = models.Count(
            "org_vacts",
            filter=(
                models.Q(org_vacts__user__isnull=True)
                & models.Q(org_vacts__brand__isnull=True)
                & models.Q(org_vacts__acct_st=AccountStatus.READY.value)
            ),
        )
        qs = self.select_related("brand")
        qs = qs.annotate(number_of_vacts=num_vacts, number_of_vacts_available=num_vacts_available)
        return qs


