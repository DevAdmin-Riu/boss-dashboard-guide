            for instance, item in zip(instances, input_data)
        ]
        instances = cls.construct_instances(info, instances, cleaned_inputs)
        cls.clean_instances(info, instances)
        cls.save(info, instances)
        for instance, cleaned_input in zip(instances, cleaned_inputs):
            cls.post_save_action(info, instance, cleaned_input)
        return cls(brandMileageMonthlySettlementList=instances)

    @classmethod
    def construct_instances(cls, info, instances, cleaned_inputs):
        for instance, cleaned_input in zip(instances, cleaned_inputs):
            cls.construct_instance(info, instance, cleaned_input)
        return instances

    @classmethod
    def clean_instances(cls, info, instances):
        error_brand_names = []
        for instance in instances:
            error_brand_name = super().clean_instance(info, instance)
            if error_brand_name:
                error_brand_names.append(error_brand_name)
        if error_brand_names:
            raise ValidationError(
                f"`{', '.join(error_brand_names)}` 위 브랜드들의 정산 계좌 정보가 없습니다. 브랜드 상세 페이지에서 입력해주세요.",
