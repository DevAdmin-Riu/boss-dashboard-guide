        _, warehouses_pks = resolve_global_ids_to_primary_keys(data["warehouse_ids"], Warehouse)
        if warehouses_pks:
            warehouse_models.Stock.objects.filter(
                product_variant=outer_variant, warehouse__pk__in=warehouses_pks
            ).delete()

        inner_variant = outer_variant.inner
        if inner_variant:
            _, warehouses_pks = resolve_global_ids_to_primary_keys(
                data["inner_warehouse_ids"], Warehouse
            )
            if warehouses_pks:
                warehouse_models.Stock.objects.filter(
                    product_variant=inner_variant, warehouse__pk__in=warehouses_pks
                ).delete()

        return cls(product_variant=outer_variant)


