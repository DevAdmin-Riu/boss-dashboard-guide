class BrandStoreCreate(CustomerCreate):
    class Arguments:
        input = BrandStoreCreateInput(required=True, description="매장 & 점주/점장 정보")

    class Meta:
        description = "신규로 가입 또는 대시보드에서 매장생성시 사용되는 뮤테이션"
        exclude = ["password"]
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def get_pre_founder_contract_fields(cls, pre_founder):
        """
        예비창업자의 계약 관련 필드를 딕셔너리로 반환
        """
        contract_fields = [
            "franchise_disclosure_document_provided_type",
            "franchise_disclosure_document_provided_date",
            "nearby_brand_stores_info_provided_type",
            "nearby_brand_stores_info_provided_date",
            "franchise_agreement_provided_type",
            "franchise_agreement_provided_date",
            "projected_sales_statement_provided_type",
            "projected_sales_statement_provided_date",
            "franchise_deposit_type",
            "franchise_deposit_date",
            "franchise_deposit_amount",
            "is_consulted",
            "franchise_consultation_date",
        ]

        return {
            field: getattr(pre_founder, field)
            for field in contract_fields
            if (getattr(pre_founder, field, None)) is not None
        }

    @classmethod
    def copy_pre_founder_franchise_document_file(
        cls, document: PreFounderFranchiseDocumentModel, brand_store: BrandStoreModel
    ):
        """
        파일을 새로운 경로로 복사하여 반환.
        """
        file_field = document.file
        if not file_field:
            return None

        # 기존 파일 읽기
        with default_storage.open(file_field.name, "rb") as file:
            file_content = file.read()

        # 새로운 파일 경로 생성 (upload_to_for_franchise_document 활용)
        dummy_instance = BrandStoreFranchiseDocumentModel(
            type=document.type, brand_store=brand_store
        )
        new_file_path = upload_to_for_franchise_document(dummy_instance, document.file_name)

        # 파일 복사
        default_storage.save(new_file_path, ContentFile(file_content))
        return new_file_path

    @classmethod
    def get_pre_founder_franchise_document_inputs(
        cls, pre_founder: PreFounderModel, brand_store: BrandStoreModel
    ):
        """
        예비창업자의 문서 데이터를 가져와 franchise_documents 형식으로 변환.
        파일을 복사하여 ContentFile 객체로 반환.
        """
        pre_founder_documents = PreFounderFranchiseDocumentModel.objects.filter(
            pre_founder=pre_founder
        ).only("file", "type", "file_name")

        franchise_document_inputs = []
        for document in pre_founder_documents:
            # 파일 복사
            new_file_path = cls.copy_pre_founder_franchise_document_file(document, brand_store)
            content_file = ContentFile(
                default_storage.open(new_file_path).read(), name=new_file_path
            )

            # franchise_documents 입력 데이터 생성
            franchise_document_inputs.append(
                {
                    "type": document.type,
                    "file": content_file,
                    "file_name": document.file_name,
                }
            )

        return franchise_document_inputs

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        brand_global_id = data.get("brand")
        _type, brand_id = graphene.Node.from_global_id(brand_global_id)
        brand_id_number = int(brand_id)

        requestor = info.context.user
        # AnonymousUser 인 경우 점주/점장으로 가입하는 경우이므로 pass
        if requestor == AnonymousUser():
            pass
        elif requestor.is_staff:
            pass
        # 바꾸려는 유저의 brand_id가 동일하면서 requesetor가 admin인 경우.
        elif brand_id_number == requestor.brand_id and (
            requestor.is_hq_staff_admin or requestor.is_hq_staff_supervisor_all
        ):
            pass
        else:
            raise ValidationError("해당 기능의 권한이 없습니다.")

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance: UserModel, cleaned_input):
        instance = super().construct_instance(info, instance, cleaned_input)

        # I18nMixin 내부에서도 호출되어서 UserModel 인 경우에만 처리되도록 제한 필요함
        if instance.__class__ == UserModel and cls == BrandStoreCreate:
            pre_founder = cleaned_input.get("pre_founder", None)
            created_from_pre_founder = pre_founder is not None

            # 예비창업자의 계약 관련 필드를 가져온다.
            contract_fields = {}
            if created_from_pre_founder:
                contract_fields = cls.get_pre_founder_contract_fields(pre_founder)

            # 매장을 생성한다.
            # 점주 계정을 이메일 대신 매장코드로 생성하기 위해 매장 먼저 생성으로 변경함
            # 매장 생성 (construct_instance) > 점주 유저 생성 (save) >  매장-점주 관계 (owner_user) 설정 (post_save_action)
            brand_store = BrandStoreModel.objects.create(
                brand=instance.brand,
                name=cleaned_input.get("brand_store_name") or instance.first_name,
                type=cleaned_input.get("brand_store_type"),
                status=cleaned_input.get("brand_store_status"),
                contract=cleaned_input.get("brand_store_contract"),
                biz_reg_no=cleaned_input.get("biz_reg_no"),
                biz_reg_corp_name=cleaned_input.get("biz_reg_corp_name"),
                biz_reg_ceo_name=cleaned_input.get("biz_reg_ceo_name"),
                biz_reg_biz_type=cleaned_input.get("biz_reg_biz_type"),
                biz_reg_biz_class=cleaned_input.get("biz_reg_biz_class"),
                pre_founder=pre_founder,
                **contract_fields,
            )

            instance.hq_staff_role = HqStaffRole.ADMIN
            instance.login_id = cleaned_input.get("login_id") or brand_store.code
            # 브랜드코드를 비밀번호로 사용한다.
            # 비밀번호를 입력하지 않은 경우 브랜드코드로 생성됨.
            password = cleaned_input.get("password") or instance.brand.code
            instance.set_password(password)
            instance.brand_store_address = instance.default_shipping_address
            instance.switched_brand = instance.brand
            return instance, brand_store
        return instance, None

    @classmethod
    def post_save_action(
        cls,
        info,
        instance: UserModel,
        cleaned_input,
        brand_store: BrandStoreModel,
    ):
        if instance.__class__ != UserModel or cls != BrandStoreCreate:
            return
        brand_store.owner_user = instance
        brand_store.save(update_fields=["owner_user"])

        # 점주/점장과 매장을 연결한다.
        BrandStoreUserModel.objects.create(
            user=instance,
            brand_store=brand_store,
            role=BrandStoreRole.OWNER,
        )

        # 매장 생성 이벤트를 남긴다.
        # 예비창업자로부터 전환 여부에 따라 다르게 남긴다.
        pre_founder = brand_store.pre_founder
        created_from_pre_founder = pre_founder is not None
        if created_from_pre_founder:
            franchise_document_inputs = cls.get_pre_founder_franchise_document_inputs(
                pre_founder, brand_store
            )
            inputs_for_upsert = {"franchise_documents": franchise_document_inputs}

            # upsert_franchise_documents 호출
            BrandStoreContractInfoUpdate.upsert_franchise_documents(
                info, brand_store, inputs_for_upsert
            )

            pre_founder_name = getattr(pre_founder, "name", None)
            pre_founder_phone = getattr(pre_founder, "phone", None)

            contents_lines = [
                "전환 생성.",
                f"전환된 예비창업자: {pre_founder_name}({pre_founder_phone})",
            ]
            contents = "\n".join(contents_lines)

            BrandStoreManageEventModel.objects.create(
                brand_store=brand_store,
                type=BrandStoreManageEventType.CREATE,
                contents=contents,
            )
        else:
            BrandStoreManageEventModel.objects.create(
                brand_store=brand_store,
                type=BrandStoreManageEventType.CREATE,
                contents="신규 생성.",
            )

        # 꺼내는 김에 validtion하는 부분도 같이함..
        hq_staff_brand_store_main = cleaned_input.get("hq_staff_brand_store_main")

        if hq_staff_brand_store_main:
            if (
                not hq_staff_brand_store_main.is_hq_staff
                or hq_staff_brand_store_main.hq_staff_role == HqStaffRole.ADMIN
                or hq_staff_brand_store_main.brand_id != instance.brand_id
            ):
                raise ValidationError("주 담당자로 불가능한 직원입니다.")
            else:
                # 매장과 본부 직원을 연결한다.
                HqStaffBrandStoreModel.objects.create(
                    brand_store=brand_store,
                    user=hq_staff_brand_store_main,
                    role=HqStaffBrandStoreRoleType.MAIN,
                )

        hq_staff_brand_store_sub = cleaned_input.get("hq_staff_brand_store_sub")

        if hq_staff_brand_store_sub:
            if (
                not hq_staff_brand_store_sub.is_hq_staff
                or hq_staff_brand_store_sub.hq_staff_role == HqStaffRole.ADMIN
                or hq_staff_brand_store_main.brand_id != instance.brand_id
            ):
                raise ValidationError("부 담당자로 불가능한 직원입니다.")
            else:
                # 매장과 본부 직원을 연결한다.
                HqStaffBrandStoreModel.objects.create(
                    brand_store=brand_store,
                    user=hq_staff_brand_store_sub,
                    role=HqStaffBrandStoreRoleType.SUB,
                )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        """Perform model mutation.

        Depending on the input data, `mutate` either creates a new instance or
        updates an existing one. If `id` argument is present, it is assumed
        that this is an "update" mutation. Otherwise, a new instance is
        created based on the model associated with this mutation.
        """
        instance = cls.get_instance(info, **data)
        input_data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, input_data)
        instance, brand_store = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, brand_store)
        return cls.success_response(instance)


class BrandStoreBulkCreate(BaseMutation):
    user_list = graphene.List(User)

    class Arguments:
        input = BrandStoreBulkCreateInput(required=True, description="매장 일괄 생성 입력")

    class Meta:
        description = "매장 일괄 생성"
        error_type_class = AccountError
        error_type_field = "account_errors"

    # 엑셀 정보의 주소를 list로 만들어서 한번에 주소를 조회하여 postal_code를 업데이트 한다.
    @classmethod
    def update_postal_codes_in_details(cls, root, info, input_data):
        details = input_data.get("details")
        addresses = []
        postal_codes = []
        for detail in details:
            addresses.append(detail.get("default_shipping_address").get("street_address_1"))
            postal_codes.append(detail.get("default_shipping_address").get("postal_code", None))
        postal_code_response = GetPostalCodesFromAddressesBulk.mutate(
            root, info, addresses=addresses, postal_codes=postal_codes
        )
        postal_code_results = postal_code_response.postal_codes
        postal_code_errors = postal_code_response.account_errors

        if len(postal_code_errors) > 0:
            raise ValidationError(f"{postal_code_errors[0].message}")

        for idx, find_postal_code in enumerate(postal_code_results):
            details[idx].default_shipping_address.update(
                {"postal_code": find_postal_code.postal_code}
            )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        details = input_data.get("details")

        cls.update_postal_codes_in_details(root, info, input_data)

        user_list = []
        errors = []
        savepoint = transaction.savepoint()

        for input in details:
            try:
                response = BrandStoreCreate.mutate(root, info, input=input)
                if response.user:
                    user_list.append(response.user)
                if response.account_errors:
                    tmp_Errors = [
                        AccountError(
                            field=error.field,
                            message=f"{input.get('brand_store_name')} : {error.message}",
                            code=error.code,
                        )
                        for error in response.account_errors
                    ]
                    errors.extend(tmp_Errors)
            except Exception as e:
                errors.append(
                    AccountError(
                        field="user",
                        message=f"{input.get('brand_store_name')} : {e}",
                        code=AccountErrorCode.INVALID,
                    )
                )
        # errors 존재하는경우 rollback하고 user_list는 비워줌.
        if errors:
            user_list = []
            transaction.savepoint_rollback(savepoint)

        return cls(user_list=user_list, account_errors=errors)


class BrandStoreOwnerChange(BrandStoreCreate):
    class Arguments:
        input = BrandStoreOwnerChangeInput(required=True, description="매장 & 점주/점장 정보")

    class Meta:
        description = "양도/양수 시에 사용되는 뮤테이션. 기존 점주/점장 정보를 정리하고 새로 생성된 유저를 점주/점장으로 등록한다."
        exclude = ["password"]
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic
    def save(cls, info, user: UserModel, cleaned_input):
        password = cleaned_input.get("password")
        if password:
            user.set_password(password)
        CustomerCreate.save(info, user, cleaned_input)

        brand_store: BrandStoreModel = cleaned_input.get("brand_store")
        biz_reg_no = cleaned_input.get("biz_reg_no")
        brand_store_name = cleaned_input.get("brand_store_name") or user.first_name
        biz_reg_corp_name = cleaned_input.get("biz_reg_corp_name")
        biz_reg_ceo_name = cleaned_input.get("biz_reg_ceo_name")
        biz_reg_biz_type = cleaned_input.get("biz_reg_biz_type")
        biz_reg_biz_class = cleaned_input.get("biz_reg_biz_class")

        # 이전 owner 꺼낸후 권한 변경. owner_user는 무조건 존재한다고 가정함.
        ex_owner = brand_store.owner_user
        brand_store_user = BrandStoreUserModel.objects.get(user=ex_owner, brand_store=brand_store)
        brand_store_user.role = BrandStoreRole.EX_OWNER
        brand_store_user.save(update_fields=["role"])

        # ex_owner 주소 관련 초기화.
        ex_owner.addresses.all().delete()
        ex_owner.default_shipping_address = None
        ex_owner.brand_store_address = None
        ex_owner.jwt_token_key = get_random_string()  # 로그인이 풀리도록 토큰 초기화.
        ex_owner.save()

        # 직거래 배송 조건도 새로운 오너에게 승계 처리
        transfer_fbv_delivery_condition(ex_owner, user)

        # 새로 생성된 유저와 매장 연결.
        brand_store.owner_user = user
        # 양도/양수이므로 해당 계약으로 바꿔준다.
        brand_store.contract = BrandStoreContract.TRANSFER
        brand_store.name = brand_store_name
        brand_store.biz_reg_no = biz_reg_no
        brand_store.biz_reg_corp_name = biz_reg_corp_name
        brand_store.biz_reg_ceo_name = biz_reg_ceo_name
        brand_store.biz_reg_biz_type = biz_reg_biz_type
        brand_store.biz_reg_biz_class = biz_reg_biz_class
        brand_store.save()

        # 점주/점장과 매장을 연결한다.
        BrandStoreUserModel.objects.create(
            user=user,
            brand_store=brand_store,
            role=BrandStoreRole.OWNER,
        )
        BrandStoreManageEventModel.objects.create(
            brand_store=brand_store,
            type=BrandStoreManageEventType.ETC,
            contents="양도/양수",
        )


class BrandStoreBasicInfoUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="매장 ID")
        input = BrandStoreBasicInfoUpdateInput(
            required=True, description="매장 기본 정보 업데이트 내용"
        )

    class Meta:
        description = "매장 기본 정보를 업데이트한다."
        model = BrandStoreModel
        error_type_class = BrandStoreError
        error_type_field = "brand_store_errors"

    @classmethod
    def clean_input(cls, info, instance: BrandStoreModel, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        brand_id_number = instance.brand_id

        requestor = info.context.user
        if requestor.is_staff:
            pass
        # 바꾸려는 유저의 brand_id가 동일하면서 requesetor가 admin인 경우.
        elif brand_id_number == requestor.brand_id and (
            requestor.is_hq_staff_admin or requestor.is_hq_staff_supervisor_all
        ):
            pass
        else:
            if requestor.hq_staff_brand_stores.filter(brand_store_id=instance.id).exists():
                pass
            elif instance.owner_user_id == requestor.id:
                pass
            else:
                raise ValidationError("해당 기능의 권한이 없습니다.")

        aligo_phone = cleaned_input.get("aligo_phone")
        if aligo_phone:
            try:
                cleaned_input["aligo_phone"] = validate_possible_number(aligo_phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {
                        "phone": ValidationError(
                            f"'{aligo_phone}' {phoneValidErrorMsg}", code=exc.code
                        )
                    }
                ) from exc

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance, cleaned_data):
        old_brand_store_instance = deepcopy(instance)
        new_brand_store_instance = super().construct_instance(info, instance, cleaned_data)
        changes_list_brand_store = get_changed_simple_fields_with_json(
            old_brand_store_instance,
            new_brand_store_instance,
            SIMPLE_DISPLAY_FIELDS_FOR_BRAND_STORE,
            FIELD_NAME_MAPPING_FOR_BRAND_STORE,
        )
        old_email = old_brand_store_instance.owner_user.email
        new_email = cleaned_data.get("email", None)
        old_aligo_phone = old_brand_store_instance.owner_user.aligo_phone
        new_aligo_phone = cleaned_data.get("aligo_phone", None)
        if new_email and old_email != new_email:
            changes_list_brand_store.append(f"이메일: {old_email} -> {new_email}")
            new_brand_store_instance.owner_user.email = new_email
        if new_aligo_phone and (old_aligo_phone) != (new_aligo_phone):
            changes_list_brand_store.append(
                f"전화번호: {format_as_numeric_only_phone_number(old_aligo_phone)} -> {(format_as_numeric_only_phone_number((new_aligo_phone)))}"
            )
            new_brand_store_instance.owner_user.aligo_phone = new_aligo_phone

        changes_str = "\n".join(changes_list_brand_store)
        if changes_str:
            add_brand_store_manage_event(
                brand_store=new_brand_store_instance,
                user=info.context.user,
                type=BrandStoreManageEventType.BASIC_INFO_UPDATED,
                contents=f"{changes_str}",
            )
        return new_brand_store_instance

    @classmethod
    def save(cls, info, instance, cleaned_input):
        instance.save()

        brand_store_address = cleaned_input.get("brand_store_address", {})
        brand_store_address_id = brand_store_address.get("id", None)
        brand_store_address_input = brand_store_address.get("input", None)

        owner_user = instance.owner_user

        if brand_store_address_id:
            brand_store_address_instance = cls.get_node_or_error(info, brand_store_address_id)
            # 주소 자체가 잘못 됬으면 에러.
            if brand_store_address_instance.id != owner_user.brand_store_address_id:
                raise ValidationError("잘못된 주소 정보입니다.")

            else:
                AccountAddressUpdate.perform_mutation(None, info, **brand_store_address)
        # id가 없고 input만 있는 경우 생성하고, brandStore의 점주/점장에 연결, brand_store_address_id로도 연결.
        elif brand_store_address_input:
            owner_user_global_id = graphene.Node.to_global_id("User", owner_user.id)
            address_create = AddressCreate.perform_mutation(
                None,
                info,
                user_id=owner_user_global_id,
                input=brand_store_address_input,
            )
            owner_user.brand_store_address = address_create.address
            owner_user.default_shipping_address = address_create.address

        # 전화번호나 이메일이 수정됬을수도 있어서 savd내에서 한번은 실행 되어야 함.
        owner_user.save()


class BrandStoreContractInfoUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="업데이트할 매장의 ID")
        input = BrandStoreContractInfoUpdateInput(
            required=True, description="계약 관련 정보 업데이트 내용"
        )

    class Meta:
        description = "매장의 계약 관련 정보를 업데이트한다."
        model = BrandStoreModel
        error_type_class = BrandStoreError
        error_type_field = "brand_store_errors"

    @classmethod
    def construct_instance(cls, info, instance, cleaned_data):
        old_brand_store_instance = deepcopy(instance)
        new_brand_store_instance = super().construct_instance(info, instance, cleaned_data)
        changes_list_brand_store = get_changed_simple_fields_with_json(
            old_brand_store_instance,
            new_brand_store_instance,
            SIMPLE_DISPLAY_FIELDS_FOR_BRAND_STORE,
            FIELD_NAME_MAPPING_FOR_BRAND_STORE,
        )
        changes_str = "\n".join(changes_list_brand_store)
        if changes_str:
            add_brand_store_manage_event(
                brand_store=new_brand_store_instance,
                user=info.context.user,
                type=BrandStoreManageEventType.CONT_INFO_UPDATED,
                contents=f"{changes_str}",
            )
        return new_brand_store_instance

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        brand_id_number = instance.brand_id

        requestor = info.context.user
        if requestor.is_staff:
            pass
        # 바꾸려는 유저의 brand_id가 동일하면서 requesetor가 admin인 경우.
        elif brand_id_number == requestor.brand_id and (
            requestor.is_hq_staff_admin or requestor.is_hq_staff_supervisor_all
        ):
            pass
        else:
            if requestor.hq_staff_brand_stores.filter(brand_store_id=instance.id).exists():
                pass
            else:
                raise ValidationError("해당 기능의 권한이 없습니다.")

        franchise_documents = cleaned_input.get("franchise_documents") or []
        for item in franchise_documents:
            if isinstance(item, dict) and "file" in item:
                file_key = item["file"]
                if file_key is not None:
                    item["file"] = info.context.FILES.get(file_key, item["file"])

        return cleaned_input

    @classmethod
    def upsert_franchise_documents(cls, info, instance, cleaned_input):
        franchise_documents_data = cleaned_input.get("franchise_documents")
        if not franchise_documents_data:
            return

        existing_documents = BrandStoreFranchiseDocumentModel.objects.filter(
            brand_store=instance, type__in=[doc["type"] for doc in franchise_documents_data]
        ).values_list("type", "id", "file")

        # 기존 문서를 딕셔너리로 변환 (type을 키로 사용)
        existing_documents_dict = {
            doc[0]: {
                "id": doc[1],
                "file": doc[2],
            }
            for doc in existing_documents
        }

        new_documents = []
        updated_documents = []

        for doc in franchise_documents_data:
            doc_type = doc.get("type")
            if not doc_type:
                continue

            # 기존 문서가 있는 경우 업데이트
            if doc_type in existing_documents_dict:
                doc_instance = BrandStoreFranchiseDocumentModel.objects.get(
                    pk=existing_documents_dict[doc_type]["id"]
                )
                new_file = doc.get("file")
                if new_file is None:
                    doc_instance.delete()
                else:
                    doc_instance.file = new_file
                    doc_instance.file_name = new_file.name if new_file else ""
                    updated_documents.append(doc_instance)
            else:
                file = doc.get("file")
                # 새로운 문서 생성
                new_documents.append(
                    BrandStoreFranchiseDocumentModel(
                        brand_store=instance,
                        type=doc_type,
                        file=file,
                        file_name=file.name if file else "",
                    )
                )

        # bulk_create 및 bulk_update 호출
        if new_documents:
            BrandStoreFranchiseDocumentModel.objects.bulk_create(new_documents)
        if updated_documents:
            BrandStoreFranchiseDocumentModel.objects.bulk_update(
                updated_documents, ["file", "file_name"]
            )

    @classmethod
    def post_save_action(cls, info, instance, cleaned_input):
        cls.upsert_franchise_documents(info, instance, cleaned_input)


