def split_emails(emails: Optional[str]) -> List[str]:
    if emails is None:
        return []
    return [email.strip() for email in emails.split(",") if email.strip()]


# send_templated_mail_consider_test_mode에서 전달된 recipient_list를 테스트 모드면 테스트 담당자 번호로 치환해서 발송 처리
