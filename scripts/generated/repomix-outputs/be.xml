def _reconcile_tax_invoice(
    tax_invoice_qs,
    is_tax_free: bool,
    expected_total: Decimal,  # 환불, 납품 확정 고려한 세금계산서 총 금액
    requester,
    order,
    return_delivery_fee,
    is_reverse_fee,
    is_from_riu,
    is_to_hq,
    bulk_tax_invoices,
):
    if expected_total is None:
        return bulk_tax_invoices, 0

    issued_tax_invoice_qs = tax_invoice_qs.filter(
        is_tax_free=is_tax_free, status=TaxInvoiceStatus.ISSUED
    )
    issued_sum = issued_tax_invoice_qs.aggregate(total=Coalesce(Sum("issued_amount"), Decimal(0)))[
        "total"
    ]
    issued_tax_invoices = list(issued_tax_invoice_qs)
    for issued_tax_invoice in issued_tax_invoices:
        issued_tax_invoice.is_modified_after_issued = True
        bulk_tax_invoices.append(issued_tax_invoice)

    # 정산 필요 금액
    reconcile_amount = expected_total - issued_sum
    request_tax_invoice: TaxInvoice = tax_invoice_qs.filter(
        is_tax_free=is_tax_free, status=TaxInvoiceStatus.REQUESTED
    ).first()

    if reconcile_amount != 0:
        if request_tax_invoice:
            request_tax_invoice.total_amount = reconcile_amount
            request_tax_invoice.is_modified = True
            order_events.tax_invoice_modified_event(
                tax_invoice=request_tax_invoice,
                requester=requester,
                return_delivery_fee=return_delivery_fee,
            )
            bulk_tax_invoices.append(request_tax_invoice)
        else:
            create_tax_invoice_request(
                requester=requester,
                order=order,
                request_datetime=datetime.datetime.now(),
                taxable_total=0 if is_tax_free else reconcile_amount,
                tax_free_total=reconcile_amount if is_tax_free else 0,
                is_reverse_fee=is_reverse_fee,
                is_from_riu=is_from_riu,
                is_to_hq=is_to_hq,
            )
    else:
        if request_tax_invoice:
            request_tax_invoice.total_amount = 0
            request_tax_invoice.status = TaxInvoiceStatus.CANCELED
            order_events.tax_invoice_canceled_event(
                tax_invoice=request_tax_invoice, requester=requester
            )
            bulk_tax_invoices.append(request_tax_invoice)
    return bulk_tax_invoices, reconcile_amount


def _modify_or_create_tax_invoice_on_refund_or_adjust_price(
    order: "Order",
    requester: "User",
    is_reverse_fee: bool,
    is_from_riu: bool,
    is_to_hq: bool,
    taxable_total_after_event,
    tax_free_total_after_event,
    return_delivery_fee: Decimal = Decimal(0),
):
    bulk_tax_invoices = []
    diff_tax_free_tax_invoice_total = Decimal(0)
    diff_taxable_tax_invoice_total = Decimal(0)

    tax_invoice_qs = (
        TaxInvoice.objects.filter(order=order, is_from_riu=is_from_riu, is_to_hq=is_to_hq)
        .exclude(status=TaxInvoiceStatus.CANCELED)
        .order_by("pk")
    )

    if tax_free_total_after_event is not None:
        bulk_tax_invoices, diff_tax_free_tax_invoice_total = _reconcile_tax_invoice(
            tax_invoice_qs,
            is_tax_free=True,
            expected_total=tax_free_total_after_event,
            requester=requester,
            order=order,
            return_delivery_fee=return_delivery_fee,
            is_reverse_fee=is_reverse_fee,
            is_from_riu=is_from_riu,
            is_to_hq=is_to_hq,
            bulk_tax_invoices=bulk_tax_invoices,
        )
    if taxable_total_after_event is not None:
        bulk_tax_invoices, diff_taxable_tax_invoice_total = _reconcile_tax_invoice(
            tax_invoice_qs,
            is_tax_free=False,
            expected_total=taxable_total_after_event,
            requester=requester,
            order=order,
            return_delivery_fee=return_delivery_fee,
            is_reverse_fee=is_reverse_fee,
            is_from_riu=is_from_riu,
            is_to_hq=is_to_hq,
            bulk_tax_invoices=bulk_tax_invoices,
        )

    if bulk_tax_invoices:
        TaxInvoice.objects.bulk_update(
            bulk_tax_invoices, ["total_amount", "is_modified", "is_modified_after_issued", "status"]
        )

    return diff_tax_free_tax_invoice_total, diff_taxable_tax_invoice_total


def tax_invoice_refunded(
    order: "Order",
    requester: "User",
    refund_data: RefundData,
):
    diff_tax_free_tax_invoice_total = Decimal(0)
    diff_taxable_tax_invoice_total = Decimal(0)

    # 악성재고 처리용 오픈몰 주문, 기타주문, B2B 주문은 세금계산서 발행 없음
    order_type = order.type
    if order_type in [
        OrderType.BY_STAFF_FOR_BAD_STOCK,
        OrderType.BY_STAFF_FOR_ETC,
        OrderType.BY_STAFF_FOR_B2B,
        OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
    ]:
        return diff_tax_free_tax_invoice_total, diff_taxable_tax_invoice_total

    if refund_data is None:
        return diff_tax_free_tax_invoice_total, diff_taxable_tax_invoice_total

    is_reverse_fee = order.is_reverse_fee_contract_type
    # fbv가 아닌 것을 하나라도 포함하는지를 확인하는 변수.
    is_any_lines_not_fbv = any([not line.is_fulfilled_by_vendor for line in order.lines.all()])

    if is_reverse_fee:
        brand = order.brand
        # 매출 인식 브랜드인 경우 선결제금 환불 세금계산서 (리우->가맹본부)는 수정 발행
        if is_any_lines_not_fbv:
            if brand.use_to_hq_tax_invoice:
                is_from_riu = True
                is_to_hq = True
                # vendor_id_list 를 [None] 으로 줘서 직거래는 제외한 값을 계산
                taxable_total_after_refund = (
                    get_total_brand_cost_price_by_order_lines_consider_refunded(
                        order.get_lines_taxable([None])
                    )
                )
                tax_free_total_after_refund = (
                    get_total_brand_cost_price_by_order_lines_consider_refunded(
                        order.get_lines_tax_free([None])
                    )
                )
                _modify_or_create_tax_invoice_on_refund_or_adjust_price(
                    order=order,
                    requester=requester,
                    is_reverse_fee=is_reverse_fee,
                    is_from_riu=is_from_riu,
                    is_to_hq=is_to_hq,
                    taxable_total_after_event=taxable_total_after_refund,
                    tax_free_total_after_event=tax_free_total_after_refund,
                )
        if brand.use_from_hq_tax_invoice == False:
            return diff_tax_free_tax_invoice_total, diff_taxable_tax_invoice_total

    is_from_riu = False if is_reverse_fee else True
    is_to_hq = True if order_type == OrderType.BY_HQ_STAFF_FOR_BRAND else False
    taxable_total_after_refund = refund_data.taxable_total_for_tax_invoice
    tax_free_total_after_refund = refund_data.tax_free_total_for_tax_invoice
    return _modify_or_create_tax_invoice_on_refund_or_adjust_price(
        order=order,
        requester=requester,
        is_reverse_fee=is_reverse_fee,
        is_from_riu=is_from_riu,
        is_to_hq=is_to_hq,
        taxable_total_after_event=taxable_total_after_refund,
        tax_free_total_after_event=tax_free_total_after_refund,
        return_delivery_fee=refund_data.return_delivery_fee,
    )


# 출금 불가 충전금 (non_cashable_credits) 는 세금계산서 발행 금액과 무관
def calc_tax_invoice_amount(
    *,
    payment: "Payment",
    prev_captured_amount: Decimal = None,
    prev_captured_cashable_credits: Decimal = None,
    refund_amount: Decimal = 0,
    refund_cashable_credits: Decimal = 0,
    refund_order_taxable_total: Decimal = 0,
    sum_of_return_delivery_fee: Decimal = 0,  # 환불 시 반품배송비는 전액 과세 세금계산서 발행으로 처리
):
    is_vbank_pay = payment.is_vbank_pay()
    is_deferred_pay = payment.is_deferred_pay()

    if prev_captured_amount is None:
        prev_captured_amount = payment.captured_amount
    if prev_captured_cashable_credits is None:
        prev_captured_cashable_credits = payment.captured_cashable_credits

    # 세금계산서 발행 대상 금액 = 충전금 + 현금영수증 미발행 가상계좌 결제 금액
    taxinvoice_total = prev_captured_cashable_credits - refund_cashable_credits
    if is_vbank_pay or is_deferred_pay:
        taxinvoice_total = taxinvoice_total + prev_captured_amount - refund_amount

    # 마이너스 세금계산서 발행 케이스도 고려
    if taxinvoice_total != 0:
        order: Order = payment.order
        prev_taxable_total_consider_refunded_incl_etc_delivery_fee = (
            order.taxable_total_consider_refunded_incl_etc_delivery_fee()
        )
        taxable_total = (
            order.subtotal_delivery_additional_fee
            + prev_taxable_total_consider_refunded_incl_etc_delivery_fee
            - refund_order_taxable_total
            + sum_of_return_delivery_fee
        )
        taxable = min(taxable_total, taxinvoice_total)
        return my_round(taxable), my_round(taxinvoice_total - taxable)

    return Decimal(0), Decimal(0)


def create_tax_invoice_request(
    *,
    requester: "User",
    order: "Order",
    request_datetime: datetime.datetime,
    taxable_total,
    tax_free_total,
    is_reverse_fee,
    is_from_riu,
    is_to_hq,
):
    tax_free_tax_invoice = None
    taxable_tax_invoice = None
    plugin_configs = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
    auto_issue_day_after = int(plugin_configs.auto_issue_day_after)
    write_date = kst_date(request_datetime)
    auto_issue_date = write_date + datetime.timedelta(days=auto_issue_day_after)
    status = TaxInvoiceStatus.REQUESTED

    create_list = []
    if tax_free_total != 0:
        tax_free_tax_invoice = TaxInvoice(
            is_tax_free=True,
            origin_amount=tax_free_total,
            total_amount=tax_free_total,
            issued_amount=None,
            order=order,
            write_date=write_date,
            auto_issue_date=auto_issue_date,
            status=status,
            is_reverse_fee=is_reverse_fee,
            is_from_riu=is_from_riu,
            is_to_hq=is_to_hq,
            is_b2b=False,
        )
        invoicer_biz_info = get_invoicer_biz_reg_info_by_tax_invoice(tax_free_tax_invoice)
        invoicee_biz_info = get_invoicee_biz_reg_info_by_tax_invoice(tax_free_tax_invoice)
        tax_free_tax_invoice.invoicer_biz_info = (
            asdict(invoicer_biz_info) if invoicer_biz_info else {}
        )
        tax_free_tax_invoice.invoicee_biz_info = (
            asdict(invoicee_biz_info) if invoicee_biz_info else {}
        )
        create_list.append(tax_free_tax_invoice)
        order_events.tax_invoice_requested_event(
            tax_invoice=tax_free_tax_invoice, requester=requester
        )
    if taxable_total != 0:
        taxable_tax_invoice = TaxInvoice(
            is_tax_free=False,
            origin_amount=taxable_total,
            total_amount=taxable_total,
            issued_amount=None,
            order=order,
            write_date=write_date,
            auto_issue_date=auto_issue_date,
            status=status,
            is_reverse_fee=is_reverse_fee,
            is_from_riu=is_from_riu,
            is_to_hq=is_to_hq,
            is_b2b=False,
        )
        invoicer_biz_info = get_invoicer_biz_reg_info_by_tax_invoice(taxable_tax_invoice)
        invoicee_biz_info = get_invoicee_biz_reg_info_by_tax_invoice(taxable_tax_invoice)
        taxable_tax_invoice.invoicer_biz_info = (
            asdict(invoicer_biz_info) if invoicer_biz_info else {}
        )
        taxable_tax_invoice.invoicee_biz_info = (
            asdict(invoicee_biz_info) if invoicee_biz_info else {}
        )
        create_list.append(taxable_tax_invoice)
        order_events.tax_invoice_requested_event(
            tax_invoice=taxable_tax_invoice, requester=requester
        )
    if create_list:
        TaxInvoice.objects.bulk_create(create_list)
    return tax_free_tax_invoice, taxable_tax_invoice


def make_tax_invoice_request_on_close_b2b_sales(
    close_date: Date,
    brand: "Brand",
    taxable_total,
    tax_free_total,
) -> List[TaxInvoice]:
    tax_free_tax_invoice = None
    taxable_tax_invoice = None
    write_date = close_date
    # b2b 세금계산서는 자동 발행일 설정 하지 않는 정책으로 변경
    auto_issue_date = None
    status = TaxInvoiceStatus.REQUESTED

    popbill_plugin_configs = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
    invoicer_biz_info = get_biz_reg_info_by_popbill_plugin_configs(popbill_plugin_configs)
    invoicee_biz_info = get_biz_reg_info_by_brand(brand)
    invoicer_biz_info = asdict(invoicer_biz_info) if invoicer_biz_info else {}
    invoicee_biz_info = asdict(invoicee_biz_info) if invoicee_biz_info else {}

    create_list = []
    if tax_free_total != 0:
        tax_free_tax_invoice = TaxInvoice(
            order=None,
            b2b_brand=brand,
            is_tax_free=True,
            origin_amount=tax_free_total,
            total_amount=tax_free_total,
            issued_amount=None,
            write_date=write_date,
            auto_issue_date=auto_issue_date,
            status=status,
            is_reverse_fee=False,
            is_from_riu=True,
            is_to_hq=True,
            is_b2b=True,
            invoicer_biz_info=invoicer_biz_info,
            invoicee_biz_info=invoicee_biz_info,
        )
        create_list.append(tax_free_tax_invoice)
    if taxable_total != 0:
        taxable_tax_invoice = TaxInvoice(
            order=None,
            b2b_brand=brand,
            is_tax_free=False,
            origin_amount=taxable_total,
            total_amount=taxable_total,
            issued_amount=None,
            write_date=write_date,
            auto_issue_date=auto_issue_date,
            status=status,
            is_reverse_fee=False,
            is_from_riu=True,
            is_to_hq=True,
            is_b2b=True,
            invoicer_biz_info=invoicer_biz_info,
            invoicee_biz_info=invoicee_biz_info,
        )
        create_list.append(taxable_tax_invoice)

    return create_list


def create_tax_invoie_request_on_adjust_price(
    requester: "User",
    order: "Order",
) -> Tuple[bool, str]:
    order.refresh_from_db()
    is_reverse_fee = order.is_reverse_fee_contract_type
    order_type = order.type

    if is_reverse_fee:
        brand = order.brand
        # 납품 시 납품금액 확정은 직거래 아닌 제품에서 발생
        # 매출 인식 브랜드인 경우 선결제금 세금계산서 (리우->가맹본부)는 항상 발행
        if brand.use_to_hq_tax_invoice:
            is_from_riu = True
            is_to_hq = True
            # vendor_id_list 를 [None] 으로 줘서 직거래는 제외한 값을 계산
            taxable_total = order.taxable_origin_total_brand_cost_price([None])
            tax_free_total = order.tax_free_origin_total_brand_cost_price([None])
            _modify_or_create_tax_invoice_on_refund_or_adjust_price(
                order=order,
                requester=requester,
                is_reverse_fee=is_reverse_fee,
                is_from_riu=is_from_riu,
                is_to_hq=is_to_hq,
                taxable_total_after_event=taxable_total,
                tax_free_total_after_event=tax_free_total,
            )
        if brand.use_from_hq_tax_invoice == False:
            logger.info(
                f"납품 금액 확정: 브랜드 설정으로 인해 tax invoice를 발행하지 않는 주문 : {order.id}"
            )
            return
    is_from_riu = False if is_reverse_fee else True
    is_to_hq = True if order_type == OrderType.BY_HQ_STAFF_FOR_BRAND else False
    payment = order.get_last_payment()
    (
        taxable_total,
        tax_free_total,
    ) = calc_tax_invoice_amount(payment=payment)
    _modify_or_create_tax_invoice_on_refund_or_adjust_price(
        order=order,
        requester=requester,
        is_reverse_fee=is_reverse_fee,
        is_from_riu=is_from_riu,
        is_to_hq=is_to_hq,
        taxable_total_after_event=taxable_total,
        tax_free_total_after_event=tax_free_total,
    )


def create_tax_invoice_request_on_order(
    requester: "User",
    payment: "Payment",
    captured_date: datetime.datetime,
) -> Tuple[bool, str]:
    if payment is None:
        logger.error(f"payment is None.")
        return False, "세금계산서 발행 정보 등록을 위한 주문의 결제 정보가 존재하지 않습니다."

    order: Order = payment.order
    if order is None:
        logger.error(f"order is None: {payment.id}")
        return False, "세금계산서 발행 정보 등록을 위한 주문이 존재하지 않습니다."

    if order.tax_invoice_exists():
        logger.error(f"tax invoice already requested or issued: {payment.id} / {order.id}")
        return False, "이미 세금계산서 발행 정보가 등록되어 있습니다."

    is_reverse_fee = order.is_reverse_fee_contract_type
    order_type = order.type

    # fbv가 아닌 것을 하나라도 포함하는지를 확인하는 변수.
    is_any_lines_not_fbv = any([not line.is_fulfilled_by_vendor for line in order.lines.all()])

    if is_reverse_fee:
        brand = order.brand
        # 매출인식 + 직거래는 리우->가맹본부 세금계산서 발행 요청 안함
        if is_any_lines_not_fbv:
            # 매출 인식 브랜드인 경우 선결제금 세금계산서 (리우->가맹본부)는 항상 발행
            if brand.use_to_hq_tax_invoice:
                is_from_riu = True
                is_to_hq = True
                # vendor_id_list 를 [None] 으로 줘서 직거래는 제외한 값을 계산
                taxable_total = order.taxable_origin_total_brand_cost_price([None])
                tax_free_total = order.tax_free_origin_total_brand_cost_price([None])
                create_tax_invoice_request(
                    requester=requester,
                    order=order,
                    request_datetime=captured_date,
                    taxable_total=taxable_total,
                    tax_free_total=tax_free_total,
                    is_reverse_fee=is_reverse_fee,
                    is_from_riu=is_from_riu,
                    is_to_hq=is_to_hq,
                )
        if brand.use_from_hq_tax_invoice == False:
            logger.info(
                f"브랜드 설정으로 인해 tax invoice를 발행 하지 않는 주문 : {payment.id} / {order.id}"
            )
            return (
                False,
                "해당 주문은 세금계산서를 자체적으로 발행하는 본부 매출 인식 브랜드로 포장보스를 통해 세금계산서를 발행하지 않습니다.",
            )

    # 카드 결제 포인트 사용이 없으면 세금계산서 발행 없음
    # 현금영수증 발행 가상계좌건 중 포인트 사용이 없으면 세금계산서 발행 없음 - (현금영수증 발행 가상계좌 사용 안해서 조건문 제거됨)
    # 포인트 + 충전금 으로만 구성된 결제에서 포인트 사용이 없으면 세금계산서 발행 없음
    if payment.captured_cashable_credits <= 0:
        is_card_pay = payment.is_card_pay()
        is_points_only_pay = payment.is_points_only_pay()
        if is_card_pay or is_points_only_pay:
            logger.info(
                f"tax invoice 발행이 필요없는 주문: {payment.id} / {order.id} - cashable_credits={payment.captured_cashable_credits}, pay_method={payment.token}"
            )
            return False, "결제 방식이 세금계산서 발행을 하지 않는 주문입니다."

    is_from_riu = False if is_reverse_fee else True
    is_to_hq = True if order_type == OrderType.BY_HQ_STAFF_FOR_BRAND else False
    (
        taxable_total,
        tax_free_total,
    ) = calc_tax_invoice_amount(payment=payment)
    create_tax_invoice_request(
        requester=requester,
        order=order,
        request_datetime=captured_date,
        taxable_total=taxable_total,
        tax_free_total=tax_free_total,
        is_reverse_fee=is_reverse_fee,
        is_from_riu=is_from_riu,
        is_to_hq=is_to_hq,
    )
    return True, ""
