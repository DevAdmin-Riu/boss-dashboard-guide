class RequestBossProductChangeStatus(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="보스 상품 요청 ID")
        input = RequestBossProductChangeStatusInput(
            required=True,
            description="보스 상품 등록 요청 상태 변경",
        )

    class Meta:
        description = "보스 상품 등록 요청 상태 변경"
        model = models.RequestBossProduct
        permissions = (BbsPermissions.MANAGE_REQUEST_BOSS_PRODUCT,)
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    # is_hq_staff이거나 permissions를 가진 유저이거나 check_permissions override
    @classmethod
    def check_permissions(cls, context, permissions=None, **data):
        if context.user.is_hq_staff:
            return True
        else:
            return super().check_permissions(context, permissions, **data)

    @classmethod
    def clean_input(cls, info, instance: RequestBossProductModel, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data, input_cls)
        after_status = cleaned_input.pop("after_status", None)
        if after_status not in [
            RequestBossProductStatus.ACCEPTED,
            RequestBossProductStatus.REQ_ADDITIONAL,
            RequestBossProductStatus.VENDOR_PRICE,
            RequestBossProductStatus.BRAND_PRICE,
            RequestBossProductStatus.REQ_ESTIMATE_FIX,
            RequestBossProductStatus.PENDING_CONFIRM,
            RequestBossProductStatus.COMPLETED,
            RequestBossProductStatus.CANCELED,
        ]:
            raise ValidationError(f"{after_status}: 변경할 수 없는 상태입니다.")
        now = timezone.now()
        cleaned_input["updated_at"] = now
        cleaned_input["status_changed_at"] = now
        cleaned_input["status"] = after_status
        return cleaned_input

    @classmethod
    def get_before_status(cls, instance: RequestBossProductModel):
        return instance.status

    @classmethod
    def post_save_action(
        cls,
        info,
        instance: RequestBossProductModel,
        cleaned_input,
        before_status,
    ):
        reason = cleaned_input.get("reason", "")

        after_status = instance.status

        need_to_price_info_status_list = [
            RequestBossProductStatus.BRAND_PRICE,
            RequestBossProductStatus.PENDING_CONFIRM,
        ]
        price_info = (
            make_req_boss_prod_price_info(instance)
            if after_status in need_to_price_info_status_list
            else None
        )

        models.RequestBossProductStatusHistory.objects.create(
            request=instance,
            before_status=before_status,
            after_status=instance.status,
            writer=info.context.user,
            reason=reason,
            price_info=price_info,
        )

        send_to_staff_status_list = [
            RequestBossProductStatus.REQ_ESTIMATE_FIX,
            RequestBossProductStatus.BRAND_PRICE,
        ]
        send_to_po_manager_status_list = [
            RequestBossProductStatus.VENDOR_PRICE,
        ]
        send_to_hq_staff_status_list = [
            RequestBossProductStatus.REQ_ADDITIONAL,
            RequestBossProductStatus.PENDING_CONFIRM,
            RequestBossProductStatus.COMPLETED,
            RequestBossProductStatus.CANCELED,
        ]

        if after_status in send_to_hq_staff_status_list:
            hq_staff: User = instance.hq_staff
            hq_staff_email = hq_staff.email if hq_staff and hq_staff.email else None
            if hq_staff_email:
                send_templated_mail_fn = None
                context = {
                    "request_number": instance.request_number,
                    "product_name": instance.product_name,
                    "dashboard_url": build_absolute_dashboard_uri(),
                }
                if after_status == RequestBossProductStatus.REQ_ADDITIONAL:
                    context.update(
                        {
                            "reason": reason,
                        }
                    )
                    if before_status == RequestBossProductStatus.ACCEPTED:
                        send_templated_mail_fn = send_templated_mail_req_boss_product_req_additional
                elif after_status == RequestBossProductStatus.PENDING_CONFIRM:
                    send_templated_mail_fn = send_templated_mail_req_boss_product_pending_confirm
                elif after_status == RequestBossProductStatus.COMPLETED:
                    send_templated_mail_fn = send_templated_mail_req_boss_product_completed
                elif after_status == RequestBossProductStatus.CANCELED:
                    send_templated_mail_fn = send_templated_mail_req_boss_product_canceled

                if send_templated_mail_fn:
                    transaction.on_commit(
                        lambda: send_templated_mail_fn(
                            hq_staff_email=hq_staff_email, context=context
                        )
                    )
        else:
            brand = instance.brand
            context = {
                "request_number": instance.request_number,
                "brand_code": brand.code,
                "brand_name": brand.name,
                "product_name": instance.product_name,
                "dashboard_url": build_absolute_dashboard_uri(),
            }
            if after_status in send_to_staff_status_list:
                staff_email = brand.staff.email if brand and brand.staff else None
                if staff_email:
                    if after_status == RequestBossProductStatus.REQ_ESTIMATE_FIX:
                        context.update(
                            {
                                "reason": reason,
                            }
                        )
                        send_templated_mail_fn = (
                            send_templated_mail_req_boss_product_req_estimate_fix
                        )
                    elif after_status == RequestBossProductStatus.BRAND_PRICE:
                        send_templated_mail_fn = send_templated_mail_req_boss_product_brand_price
                    else:
                        send_templated_mail_fn = None

                    if send_templated_mail_fn:
                        transaction.on_commit(
                            lambda: send_templated_mail_fn(staff_email=staff_email, context=context)
                        )
            elif after_status in send_to_po_manager_status_list:
                if after_status == RequestBossProductStatus.VENDOR_PRICE:
                    send_templated_mail_fn = send_templated_mail_req_boss_product_vendor_price
                else:
                    send_templated_mail_fn = None

                if send_templated_mail_fn:
                    transaction.on_commit(lambda: send_templated_mail_fn(context=context))

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        before_status = cls.get_before_status(instance)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, before_status)
        return cls.success_response(instance)


