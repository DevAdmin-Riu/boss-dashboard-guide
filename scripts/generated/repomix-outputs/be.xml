            no_delivery_condition_only_user_q = Q(
                variants__variant_vendors__vendor__fbv_delivery_conditions__user_id=user.id
            )
            no_delivery_condition_q = (
                Q(
                    variants__variant_vendors__vendor__is_active=True,
                    variants__variant_vendors__vendor__use_fbv_product=True,
                )
                & ~no_delivery_condition_only_user_q
            )

            return ~(vendor_filter | no_delivery_condition_q)

        filters = (
            can_sale_by_bpv_inner_filter
            & brand_filter
            & force_no_normal_display_filter
            & (no_direct_shipping_filter() | direct_shipping_filter(user))
        )

        brand: Brand = user.brand
        if BrandServiceType.FBV in brand.enabled_services:
            filters &= Q(is_fulfilled_by_vendor=True) & exclude_vendor_filter() | Q(
