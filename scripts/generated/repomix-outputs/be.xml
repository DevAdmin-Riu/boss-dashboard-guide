        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_vender(cls, user: User, purchase_order_lines: List[PurchaseOrderLineModel]):
        if user.is_vendor_staff == False or user.is_staff:
            return
        invalid_po_lines = [
            line for line in purchase_order_lines if line.purchase_order.vendor != user.vendor
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(f"다른 협력사 제품을 접수할 수 없습니다. {invalid_codes}")

    @classmethod
    def validate_status(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.status not in [PurchaseOrderLineStatus.PENDING]
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(f"접수할 수 없는 상태의 발주 품목이 존재합니다. {invalid_codes}")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_line_ids):
        user: "User" = info.context.user
        purchase_order_lines: List[PurchaseOrderLineModel] = cls.get_nodes_or_error(
            purchase_order_line_ids,
            "purchase_order_line_ids",
            PurchaseOrderLine,
            qs=models.PurchaseOrderLine.objects.select_related("purchase_order", "order_line"),
        )
        cls.validate_status(purchase_order_lines)
        cls.validate_vender(user, purchase_order_lines)

        non_take_back_type_po_lines = [
            line
            for line in purchase_order_lines
            if line.purchase_order.is_take_back_po == False
            and line.purchase_order.is_consignment_take_back_po == False
        ]
        non_take_back_type_target_ids = [instance.pk for instance in non_take_back_type_po_lines]
        models.PurchaseOrderLine.objects.filter(pk__in=non_take_back_type_target_ids).update(
            status=PurchaseOrderLineStatus.RECEIVED
        )
        bulk_create_po_line_status_histories(
            non_take_back_type_po_lines,
            before_status=PurchaseOrderLineStatus.PENDING,
            after_status=PurchaseOrderLineStatus.RECEIVED,
            user=user,
        )

        # 재고 반품 발주서인 경우 접수 시점에 재고 감소 처리
        decrease_stock_po_lines = [
            line for line in purchase_order_lines if line.purchase_order.is_take_back_po
        ]
        decrease_stock_by_purchase_order_lines(user, decrease_stock_po_lines)
        # 반품 발주서 / 위탁 반품 발주서 접수 시에 매입 데이터 생성
        take_back_type_po_lines = [
            line
            for line in purchase_order_lines
            if line.purchase_order.is_take_back_po
            or line.purchase_order.is_consignment_take_back_po
        ]
        take_back_type_target_ids = [instance.pk for instance in take_back_type_po_lines]
        models.PurchaseOrderLine.objects.filter(pk__in=take_back_type_target_ids).update(
            status=PurchaseOrderLineStatus.DELIVERED
        )
        add_purchase_by_purchase_order_lines(take_back_type_po_lines)
        bulk_create_po_line_status_histories(
            take_back_type_po_lines,
            before_status=PurchaseOrderLineStatus.PENDING,
            after_status=PurchaseOrderLineStatus.DELIVERED,
            user=user,
        )
        add_po_manage_event_with_type(
            user, purchase_order_lines, PurchaseOrderManageEventType.RECEIVED
        )

        b2b_take_back_order_lines = [
            line.order_line
            for line in purchase_order_lines
            if line.purchase_order.is_b2b == True
            and line.purchase_order.is_consignment_take_back_po
        ]
        b2b_take_back_order_line_ids = [instance.pk for instance in b2b_take_back_order_lines]
        order_models.OrderLine.objects.filter(pk__in=b2b_take_back_order_line_ids).update(
            b2b_status=OrderLineB2bStatus.COMPLETED
        )
        # B2b 반품 주문인 경우 매출 데이터 생성 하고 완료 처리
        b2b_take_back_type_po_lines = [
            line
            for line in purchase_order_lines
            if line.purchase_order.is_b2b == True
            and line.purchase_order.is_consignment_take_back_po
        ]
        add_sales_for_b2b_order(b2b_take_back_type_po_lines)
        order_b2b_completed_event(user=user, order_lines=b2b_take_back_order_lines)
        bulk_create_order_line_b2b_status_histories(
            b2b_take_back_order_lines,
            before_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT,
            after_status=OrderLineB2bStatus.COMPLETED,
            user=user,
        )

        initial_order_po_lines = [
            line for line in purchase_order_lines if line.purchase_order.is_initial_order
        ]
        send_email_po_received_to_riu(initial_order_po_lines)
        return PurchaseOrderLinesReceive(purchase_order_lines=purchase_order_lines)


