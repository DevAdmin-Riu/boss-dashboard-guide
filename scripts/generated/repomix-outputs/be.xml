def update_daily_sales_stats(
    *,
    days: int,
    avg_field: str,
    target_date: date = None,
    variant: ProductVariant = None,
):
    from django.db import connection

    target_date = target_date or kst_date()
    # 판매 개시 1일 경과된 후 부터 일 평균 데이터 집계
    # after_days = days if days < 14 else 14
    after_days = 1

    variant_filter_sql = ""
    if variant:
        variant_filter_sql = f"AND id={variant.pk}"

    # reset_queries()
    with connection.cursor() as cursor:
        cursor.execute(
            f"""
            WITH variant_base AS (
                SELECT T1.id AS variant_id, T1.first_available_for_purchase as first_available_for_purchase
                FROM product_productvariant T1
                LEFT OUTER JOIN product_productvariant T2 ON (T1.outer_id = T2.id)
                INNER JOIN product_product ON (T1.product_id = product_product.id)
                WHERE (
                    (T1.outer_id IS NULL AND T1.track_inventory = true) OR
                    (T1.outer_id IS NOT NULL AND T2.track_inventory = false AND T1.can_sale_by_inner = true)
                )
                AND NOT (product_product.is_fulfilled_by_vendor)
                AND %s::date - T1.first_available_for_purchase >= %s
                {variant_filter_sql}
            ),
            date_range_per_variant AS (
                SELECT
                    v.variant_id,
                    gs.date
                FROM variant_base v
                JOIN LATERAL (
                    SELECT generate_series(
                        GREATEST(v.first_available_for_purchase, %s::date - %s * INTERVAL '1 days'),
                        %s::date - INTERVAL '1 day',
                        INTERVAL '1 day'
                    )::date AS date
                ) AS gs ON %s::date - v.first_available_for_purchase >= %s
            ),
            sales_data AS (
                SELECT
                    dr.variant_id,
                    dr.date,
                    COALESCE(s.quantity, 0) AS quantity
                FROM date_range_per_variant dr
                LEFT JOIN stats_productvariantdailysales s
                    ON dr.variant_id = s.variant_id AND dr.date = s.date
            ),
            stats AS (
                SELECT
                    variant_id,
                    ROUND(AVG(quantity), %s) AS avg_daily_qty
                FROM sales_data
                GROUP BY variant_id
            )
            UPDATE product_productvariant pv
            SET
                {avg_field} = stats.avg_daily_qty
            FROM stats
            WHERE stats.variant_id = pv.id;
            """,
            [
                target_date,
                after_days,
                target_date,
                days,
                target_date,
                target_date,
                after_days,
                DAILY_STAT_QTY_DECIMAL_PLACES,
            ],
        )
    # print_connection_queries(connection, "update_daily_sales_stats")


