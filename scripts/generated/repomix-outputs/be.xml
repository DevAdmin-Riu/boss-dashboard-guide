class Transaction(CountableDjangoObjectType):
    number = graphene.String(description="User-friendly number of a transaction.")
    pg_refund_event = graphene.Field(PgRefundEvent, description="PG 결제 취소 처리 내역")
    vact_info = graphene.Field(VactInfo, description="가상계좌 입금 정보")

    class Meta:
        description = "An object representing a single payment."
        interfaces = [relay.Node]
        model = models.Transaction
        filter_fields = ["id"]
        only_fields = [
            "id",
            "created",
            "payment",
            "token",
            "kind",
            "is_success",
            "error",
            "gateway_response",
            "amount",
            "cashable_credits",
            "non_cashable_credits",
            "rcoins",
            "return_delivery_fee",
            "refund_info",
        ]

    def resolve_payment(root: TransactionModel, info):
        if root.payment_id:
            return PaymentByIdLoader(info.context).load(root.payment_id)
        else:
            return None

    def resolve_number(root: TransactionModel, _info):
        return str(root.pk)

    def resolve_pg_refund_event(root: TransactionModel, info):
        # 카드 환불 트랜잭션인 경우에만 한개 존재
        return (
            PgRefundEventsByTransactionIdLoader(info.context)
            .load(root.id)
            .then(lambda events: events[0] if events else None)
        )

    def resolve_vact_info(root: TransactionModel, info):
        payment: PaymentModel = root.payment
        server_mode_str = settings.SERVER_MODE
        server_mode_enum = ServerModeEnum(server_mode_str)
        include_vact_time = is_prod_server_mode(server_mode_enum) == False

        def _get_vact_info_with_plugin_manager(plugin_manager):
            vact_info = get_vact_info(
                payment,
                root.gateway_response,
                include_vact_time=include_vact_time,
                plugin_manager=plugin_manager,
            )
            return vact_info

        plugin_manager_promise = PluginManagerLoader(info.context).load(1)
        return plugin_manager_promise.then(
            lambda plugin_manager: _get_vact_info_with_plugin_manager(plugin_manager=plugin_manager)
        )


