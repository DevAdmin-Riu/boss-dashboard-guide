            return root.quantity

        def load_po_line(order: OrderModel):
            if can_fulfill_more_than_ordered(root, order.delivery_method):
                return (
                    PurchaseOrderLineByIdLoader(info.context)
                    .load(root.purchase_order_line_id)
                    .then(get_fulfill_qty)
                )
            return root.quantity

        return OrderByIdLoader(info.context).load(root.order_id).then(load_po_line)

