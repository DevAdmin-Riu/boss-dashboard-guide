                    raise ValidationError(
                        "이너 제품이 브랜드 상품에 연결되어 있어 이너박스 미운영으로 변경할 수 없습니다."
                    )
            inner_variant.can_sale_by_inner = can_sale_by_inner
            update_fields.append("can_sale_by_inner")
        if "is_deferred" in cleaned_input:
            is_deferred = cleaned_input["is_deferred"]
            if is_deferred:
                inner_variant.inner_incidental_cost_amount = Decimal(0)
                update_fields.append("inner_incidental_cost_amount")

        if update_fields:
            inner_variant.save(update_fields=update_fields)

        return inner_variant

    @classmethod
    def save(cls, info, instance: ProductModel, cleaned_input):
        instance.save()

        # ProductUpdate 후 ProductVariantUpdate 를 바로 이어서 호출하는 경우 여기서 pv 를 save 할 필요 없음
        # pv 필수 정보가 None 인 상태의 productUpdate 에서 pv save 가 호출되면, save 안의 validation 로직으로 raise exception 나는 이슈 회피용
        skip_pv_save = cleaned_input.pop("skip_pv_save", False)
        # 비옵션형 제품인 경우 아우터/이너 정보 입력이 있는 경우 업데이트만 함
        if not skip_pv_save and not instance.product_type.has_variants:
            outer_variant = cls.save_outer_variant(instance, cleaned_input)
            has_inner_variant = (
                instance.check_has_inner_variant() and outer_variant.check_has_inner_variant()
            )
            if has_inner_variant:
                inner_variant = cls.save_inner_variant(instance, cleaned_input, outer_variant)
                ProductVariantCreate.validate_inner_qty_per_box(outer_variant, inner_variant)
                reset_inner_variant_cost_price(outer_variant, inner_variant)

        # Recalculate the "minimal variant price"
        update_product_minimal_variant_price_task.delay(instance.pk)
        update_product_minimal_variant_cost_price_task.delay(instance.pk)
        update_product_minimal_variant_delivery_fee_task.delay(instance.pk)

        attributes = cleaned_input.get("attributes")
        if attributes:
            AttributeAssignmentMixin.save(instance, attributes)
        info.context.plugins.product_updated(instance)

    @classmethod
    def post_save_action(cls, info, instance: ProductModel, cleaned_input, prev_is_exclusive):
        if prev_is_exclusive == False and cleaned_input.get("is_exclusive") == True:
            models.BrandProduct.objects.filter(product=instance).update(is_exclusive=True)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        instance: ProductModel = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        prev_is_exclusive = instance.is_exclusive
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, prev_is_exclusive)
        return cls.success_response(instance)


