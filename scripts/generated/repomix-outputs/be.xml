def get_user_product_variant_for_loader(
    variant: ProductVariant,
    product: Product,
    context,
    raise_exception: bool,
    use_brand_instead_of_switched_brand: bool = False,
):
    if product is None:
        raise Exception("제품 정보 오류: product is None")

    is_direct_shipping = product.is_direct_shipping

    brand_store_owner_user = context.brand_store_owner_user
    # 만약 use_brand_instead_of_switched_brand이 true이면, brand를 사용하고, 아니면 switched_brand를 사용한다. user가 없으면 brand는 None이다.
    # 기존의 get_user_product_variant 함수와 달리 brand_id 만 가져와서 넘긴다. brand를 쓰는 경우 불필요한 쿼리가 호출되기 때문.
    brand_id = (
        brand_store_owner_user.switched_brand_id
        if brand_store_owner_user
        and brand_store_owner_user.switched_brand_id
        and not brand_store_owner_user.is_anonymous
        else None
    )
    brand_id = (
        brand_store_owner_user.brand_id
        if (
            brand_store_owner_user
            and not brand_store_owner_user.is_anonymous
            and use_brand_instead_of_switched_brand
        )
        else brand_id
    )
    region = (
        brand_store_owner_user.region
        if brand_store_owner_user and not brand_store_owner_user.is_anonymous
        else None
    )
    # NOTE 직배송의 경우에 로더 고려안됨. 향후 직배송시 작업 필요.
    if brand_id is None:
        if is_direct_shipping:
            result = Promise.resolve(get_product_variant_region(variant=variant, region=region))
        else:
            result = ProductVariantsByIdLoader(context).load(variant.id)
    else:
        if product.is_direct_shipping:
            # 직배송의 경우 기존 get_user_product_variant 함수가 brand id가 아닌 brand를 쓰는 것으로 되어 있어 따로 만들지 않고 None 처리 한다. 향수 직배송 사용 시 수정필요.
            result = Promise.resolve(None)
        else:
            result = BrandProductVariantByProductVariantIdAndBrandIdLoader(context).load(
                (variant.id, brand_id)
            )

    if raise_exception and result is None:
        sku = variant.sku
        raise Exception(
            f"제품 정보 오류: 판매 제품 정보 구성을 확인해 주세요. {sku} / user={brand_store_owner_user} / {brand_id}"
        )

    return result


