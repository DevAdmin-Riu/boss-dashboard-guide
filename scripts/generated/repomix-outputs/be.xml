            user_product_variants, plugin_manager = data
            user_product_variant = (
                user_product_variants[0] if len(user_product_variants) > 0 else None
            )
            variant_price = (
                user_product_variant.get_price()
                if user_product_variant
                else zero_money(settings.DEFAULT_CURRENCY)
