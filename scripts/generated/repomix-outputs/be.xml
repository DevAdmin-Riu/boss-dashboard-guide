import logging
import warnings
from datetime import timedelta
from decimal import Decimal
from typing import TYPE_CHECKING, List, Optional

from django.conf import settings

from ...account import PaymentGatewayType
from ...checkout import base_calculations
from ...core.prices import quantize_krw
from ...core.utils.kst_time import kst_timezone_now
from ...plugins.manager import get_plugins_manager
from .. import PaymentFailedType, TransactionKind
from ..interface import BrandPaymentValues
from .define import RIU_PAY_METHOD_DEFERRED, RIU_PAY_METHOD_POINTS_ONLY
from .inicis.define import (
    INICIS_GATEWAY_PLUGIN_ID,
    INICIS_PAY_METHOD_CARD,
    INICIS_PAY_METHOD_VBANK,
    INICIS_PAY_METHOD_VCARD,
)
from .toss.define import TOSS_GATEWAY_PLUGIN_ID, TOSS_PAY_METHOD_CARD, TOSS_PAY_METHOD_VBANK

if TYPE_CHECKING:
    from ...account.models import Brand
    from ...checkout.models import Checkout
    from ...graphql.payment.types import VactInfo
    from ..interface import GatewayConfig
    from ..models import Payment

logger = logging.getLogger(__name__)


def get_supported_currencies(config: "GatewayConfig", gateway_name: str) -> List[str]:
    """Return supported currencies for given gateway configuration.

    If supported currencies are not specified, the default currency is used
    and a warning is raised.
    """
    supp_currencies = config.supported_currencies
    if not supp_currencies:
        currencies = [settings.DEFAULT_CURRENCY]
        warnings.warn(
            f"Default currency used for {gateway_name}. "
            "DEFAULT_CURRENCY setting is deprecated, "
            "please configure supported currencies for this gateway."
        )
    else:
        currencies = [c.strip() for c in supp_currencies.split(",")]

    return currencies


def get_plugin_configs_by_payment(payment: "Payment"):
    gateway = payment.gateway
    if gateway == PaymentGatewayType.INICIS:
        plugin_id = INICIS_GATEWAY_PLUGIN_ID
    elif gateway == PaymentGatewayType.TOSS:
        plugin_id = TOSS_GATEWAY_PLUGIN_ID
    else:
        raise Exception("Invalid payment gateway")

    plugin_configs = get_plugins_manager().get_plugin_config_dot_map(plugin_id)
    return plugin_configs


def append_vact_info_to_success_msg(success_msg, vact_info: "VactInfo"):
    success_msg = f"{success_msg} 입금은행=({vact_info.vact_bank_code}) {vact_info.vact_bank_name}"
    success_msg = f"{success_msg} 계좌번호={vact_info.vact_num}"
    success_msg = f"{success_msg} 예금주={vact_info.vact_name}"
    success_msg = f"{success_msg} 입금기한={vact_info.vact_date}"
    success_msg = f"{success_msg} 입금금액={vact_info.vact_amount}"
    return success_msg


def is_card_pay(pay_method: str):
    if not pay_method:
        return False
    upper_pay_method = pay_method.upper()
    return (
        upper_pay_method == INICIS_PAY_METHOD_CARD
        or upper_pay_method == INICIS_PAY_METHOD_VCARD
        or upper_pay_method == TOSS_PAY_METHOD_CARD
    )


def is_vbank_pay(pay_method: str):
    if not pay_method:
        return False
    upper_pay_method = pay_method.upper()
    return upper_pay_method == INICIS_PAY_METHOD_VBANK or upper_pay_method == TOSS_PAY_METHOD_VBANK


def is_points_only_pay(pay_method: str):
    if not pay_method:
        return False
    upper_pay_method = pay_method.upper()
    return upper_pay_method == RIU_PAY_METHOD_POINTS_ONLY


# 대행주문 및 오픈몰주문이 아래 경우에 해당함.
def is_deferred_pay(pay_method: str):
    if not pay_method:
        return False
    upper_pay_method = pay_method.upper()
    return upper_pay_method == RIU_PAY_METHOD_DEFERRED


def make_vbank_success_message(is_mobile: Optional[bool]):
    if is_mobile is None:
        payment_platform = None
    else:
        payment_platform = "모바일" if is_mobile else "PC 웹"

    if payment_platform:
        return f"({payment_platform}) 가상계좌: 입금 통보됨"
    else:
        return f"가상계좌: 입금 통보됨"


def make_combine_pay_method_text(payment: "Payment"):
    combine_pay_method = []
    pay_method = payment.token
    if not is_points_only_pay(pay_method):
        if payment.is_toss_riu_pay:
            combine_pay_method.append("카드 (리우페이)")
        elif is_card_pay(pay_method):
            combine_pay_method.append("카드 (일반)")
        elif is_vbank_pay(pay_method):
            combine_pay_method.append("가상계좌")
        elif is_deferred_pay(pay_method):
            combine_pay_method.append("후불결제")

    if payment.credits_incl_non_cashable > 0:
        combine_pay_method.append("충전금")

    if payment.rcoins > 0:
        combine_pay_method.append("포인트")

    combined_text = " + ".join(combine_pay_method)
    return combined_text


def make_order_events_message(
    is_success, success_msg, failed_msg, pay_method, payment: "Payment", is_mobile: Optional[bool]
):
    from .handle_by_pg import get_pg_name

    order_events_message = success_msg if is_success else failed_msg
    payment_method = make_combine_pay_method_text(payment)
    if is_mobile is not None and (is_points_only_pay(pay_method) or is_deferred_pay(pay_method)):
        payment_platform = None
    else:
        payment_platform = "모바일" if is_mobile else "PC 웹"

    pg_name = get_pg_name(payment)
    if pg_name:
        return_msg = f"{pg_name}:"
    else:
        return_msg = ""

    if payment_platform:
        return_msg = f"{return_msg} ({payment_platform})"

    return_msg = f"{return_msg} {payment_method}: {order_events_message}"
    return return_msg


def get_vbank_valid_until(valid_days: str):
    now = kst_timezone_now()
    valid_until = now + timedelta(int(valid_days))
    return valid_until.strftime("%Y%m%d")


def get_vbank_valid_days(plugin_configs, checkout: "Checkout"):
    is_direct_shipping = checkout.is_direct_shipping()
    return (
        plugin_configs.direct_shpping_vbank_valid_days
        if is_direct_shipping
        else plugin_configs.vbank_valid_days
    )


def calc_paying_charge_exclude_vat(
    pay_method: str,
    pay_amount: Decimal,
    card_paying_charge_rate: Decimal,
    vbank_paying_charge_exclude_vat: Decimal,
):
    if is_card_pay(pay_method):
        return quantize_krw(pay_amount * card_paying_charge_rate / 100)
    elif is_vbank_pay(pay_method):
        return quantize_krw(Decimal(vbank_paying_charge_exclude_vat))
    return 0


def calc_brand_payment_values(*, checkout: "Checkout", payment: "Payment", is_fbv: bool):
    brand: "Brand" = checkout.user.brand if checkout.user else None
    if not brand:
        return None

    only_selected_checkout_lines = [
        line for line in checkout.get_selected_lines() if line.is_fulfilled_by_vendor is is_fbv
    ]

    brand_line_cost_price_totals = [
        base_calculations.base_checkout_line_brand_total_cost_price_decimal(checkout, line)
        for line in only_selected_checkout_lines
    ]
    brand_total_cost_price_amount = Decimal(
        max(
            sum(brand_line_cost_price_totals),
            0,
        )
    )

    brand_line_delivery_fee_totals = [
        base_calculations.base_checkout_line_brand_total_delivery_fee(checkout, line).amount
        for line in only_selected_checkout_lines
    ]
    brand_total_delivery_fee_amount = Decimal(
        max(
            sum(brand_line_delivery_fee_totals),
            0,
        )
    )

    brand_paying_charge_exclude_vat = 0
    # 라인의 금액과 수수료율(또는 수수료)를 곱해서 나온 금액을 전부 더한 금액이다. 수수료 배분시에 분모에 사용됨.
    # card_paying_charge_rate, vbank_paying_charge_exclude_vat 가 각 라인마다 전부 동일하다면 상계되서 금액으로 배분됨.
    line_price_mul_charge_rate_sum = 0

    if is_fbv:
        vbank_paying_charge_exclude_vat_of_brand = brand.fbv_vbank_paying_charge_exclude_vat
    else:
        vbank_paying_charge_exclude_vat_of_brand = brand.vbank_paying_charge_exclude_vat

    for line in only_selected_checkout_lines:
        if line.brand_product_variant and line.brand_product_variant.brand:
            bpv_brand: Brand = line.brand_product_variant.brand
            # 직거래 상품은 보스 장터에 진열되지 않으므로 무조건 brand의 결제 수수료 정보를 사용
            if is_fbv:
                card_paying_charge_rate_consider_switched_brand = brand.fbv_card_paying_charge_rate
                vbank_paying_charge_exclude_vat_consider_switched_brand = (
                    brand.fbv_vbank_paying_charge_exclude_vat
                )
            else:
                card_paying_charge_rate_consider_switched_brand = bpv_brand.card_paying_charge_rate
                vbank_paying_charge_exclude_vat_consider_switched_brand = (
                    bpv_brand.vbank_paying_charge_exclude_vat
                )

            total_line_price = base_calculations.base_checkout_line_total_decimal(checkout, line)
            if is_card_pay(payment.token):
                brand_paying_charge_exclude_vat += calc_paying_charge_exclude_vat(
                    payment.token,
                    total_line_price,
                    card_paying_charge_rate_consider_switched_brand,
                    vbank_paying_charge_exclude_vat_consider_switched_brand,
                )
                line_price_mul_charge_rate_sum += (
                    total_line_price * card_paying_charge_rate_consider_switched_brand
                )
            elif is_vbank_pay(payment.token):
                line_price_mul_charge_rate_sum += (
                    total_line_price * vbank_paying_charge_exclude_vat_consider_switched_brand
                )
            else:
                line_price_mul_charge_rate_sum += total_line_price
    # 가상계좌인경우 수수료는 brand의 값을 사용하면 됨.
    # 수수료가 분배될때 수수료가 0인 브랜드의 상품에는 분배되지 않음.(분배할때)
    if is_vbank_pay(payment.token):
        brand_paying_charge_exclude_vat = quantize_krw(
            Decimal(vbank_paying_charge_exclude_vat_of_brand)
        )

    return BrandPaymentValues(
        is_fbv=is_fbv,
        brand_total_cost_price_amount=brand_total_cost_price_amount,
        brand_total_delivery_fee_amount=brand_total_delivery_fee_amount,
        brand_paying_charge_exclude_vat=brand_paying_charge_exclude_vat,
        line_price_mul_charge_rate_sum=line_price_mul_charge_rate_sum,
    )


def make_cancel_payment_message(cancel_success):
    cancel_result_msg = "결제 처리 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다."
    if cancel_success:
        cancel_result_msg = f"{cancel_result_msg} - 승인 결제 건 취소 처리됨"
    else:
        cancel_result_msg = f"{cancel_result_msg} - 승인 결제 건 취소 처리 실패"
    return cancel_result_msg


def create_payment_failed_transaction(
    payment: "Payment", type: PaymentFailedType, message: str, parameters: dict
):
    from ..models import Transaction

    logger.info(f"payment_debug: create_payment_failed_transaction {payment} {type} {message}")

    Transaction.objects.create(
        payment=payment,
        token=payment.token,
        kind=TransactionKind.PAYMENT_FAILED,
        gateway_response={
            "type": type.value,
            "message": message,
            "parameters": parameters,
        },
        # 신규 생성 Transaction은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
        is_converted=True,
    )


def sum_of_reverse_fee_deposit_items(
    non_fbv_total_brand_cost, non_fbv_subtotal_delivery_additional_fee, total_etc_delivery_fee
):
    """
    * brand cost, 도서산간 추가비용은 직거래 제품은 제외한 보스 상품 것만 차감함
    * 기타배송비항목(화물차, 소분비용)은 첫번째 line 에 모두 세팅되어서, 직거래 제품에 값이 세팅될 수도 있는 관계로 주의 필요
    """
    return (
        non_fbv_total_brand_cost + non_fbv_subtotal_delivery_additional_fee + total_etc_delivery_fee
    )
