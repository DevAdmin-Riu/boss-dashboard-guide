from datetime import datetime, timedelta
from typing import TYPE_CHECKING, List

from dateutil.rrule import DAILY, FR, MO, MONTHLY, SA, SU, TH, TU, WE, WEEKLY, YEARLY, rrule

from ..core.utils.kst_time import kst_timezone_now
from . import RepeatAnchorType, RepeatType

if TYPE_CHECKING:
    from .models import Schedule


def get_byweekday_and_bysetpos(datetime: datetime):
    weekday = datetime.weekday()  # 0=월, 6=일
    week_of_month = (datetime.day - 1) // 7 + 1  # 1~5
    weekday_map = [MO, TU, WE, TH, FR, SA, SU]
    return weekday_map[weekday], week_of_month


def generate_alarm_datetimes(schedule: "Schedule") -> List[datetime]:
    if not schedule.has_alarm or not schedule.alarm_offset_minutes:
        return []

    days_ahead = 7
    now = kst_timezone_now()
    start = schedule.start
    offset = timedelta(minutes=schedule.alarm_offset_minutes)
    until = schedule.repeat_until or (now + timedelta(days=days_ahead))
    freq_map = {
        RepeatType.DAILY: DAILY,
        RepeatType.WEEKLY: WEEKLY,
        RepeatType.MONTHLY: MONTHLY,
        RepeatType.YEARLY: YEARLY,
    }

    if schedule.repeat_type == RepeatType.NONE:
        alarm_dt = round_to_15min(start - offset)
        return [alarm_dt] if alarm_dt >= now else []

    until_dt = datetime.combine(date=until, time=datetime.max.time(), tzinfo=start.tzinfo)

    if (
        schedule.repeat_type == RepeatType.MONTHLY
        and schedule.repeat_anchor_type == RepeatAnchorType.WEEKDAY
    ):
        byweekday, bysetpos = get_byweekday_and_bysetpos(start)
        rule = rrule(
            freq=MONTHLY,
            dtstart=start,
            interval=schedule.repeat_interval,
            until=until_dt,
            byweekday=byweekday,
            bysetpos=bysetpos,
        )
    else:
        rule = rrule(
            freq=freq_map[schedule.repeat_type],
            dtstart=start,
            interval=schedule.repeat_interval,
            until=until_dt,
        )

    return [dt for dt in (round_to_15min(dt - offset) for dt in rule) if dt >= now]


def round_to_15min(dt: datetime) -> datetime:
    """15분 단위로 내림"""
    minute = (dt.minute // 15) * 15
    return dt.replace(minute=minute, second=0, microsecond=0)
