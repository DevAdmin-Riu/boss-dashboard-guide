def generate_token(config):
    url_get_token = config.url_get_token
    for_token_data = {"apikey": config.ALIGO_APIKEY, "userid": config.ALIGO_USERID}
    response = requests.post(url_get_token, data=for_token_data)
    result = response.json()
    result_code = result["code"]
    if result_code != 0:
        converted_result_text = convert_unicode_to_kr(response.text)
        logger.error(f"response.text: {converted_result_text}")
        return None, result_code
    return result["token"], result_code


def get_template_list(config, token):
    url_get_template_list = config.url_get_template_list
    for_template_list_data = {
        "apikey": config.ALIGO_APIKEY,
        "userid": config.ALIGO_USERID,
        "senderkey": config.ALIGO_SENDERKEY,
        "token": token,
    }
    response = requests.post(url_get_template_list, data=for_template_list_data)
    result = response.json()
    template_list = list()
    for each_template_info in result["list"]:
        template_list.append(each_template_info["templtCode"])
    return template_list


