    tracking_numbers = graphene.List(
        graphene.String, description="반품한 기존 송장번호", required=True
    )
    consignment_fulfillment_ids = graphene.List(
        graphene.ID, required=True, description="fulfillment row id"
    )


# 반품 송장건에 대해서 기록 하는 mutation
class CustomerRefundProductReturnTrackingCreate(ModelMutation):
    tracking_numbers = graphene.List(RefundProductReturnTracking)

    class Arguments:
        id = graphene.ID(required=True, description="주문 id(order.id)")
        input = CustomerRefundProductReturnTrackingCreateInput(
            required=True, description="송장 반품에 대한 입력 값"
        )

    class Meta:
        description = "반품한 기존 송장번호 목록"
        model = models.RefundProductReturnTracking

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        id = data.get("id")
        input = data.get("input")
        tracking_numbers = input.get("tracking_numbers")
        fulfillment_ids = input.get("fulfillment_ids")
        consignment_fulfillment_ids = input.get("consignment_fulfillment_ids")
        refund_qa_id = input.get("refund_qa_id")

        order_info = cls.get_node_or_error(info, id, only_type=Order)
        refund_qa_info = cls.get_node_or_error(info, refund_qa_id, only_type=RefundQA)

        created_trackings = []
        created_refund_inspect = []
        if len(tracking_numbers) > 0 and len(fulfillment_ids) > 0:
            # 반품 송장번호 저장
            for tracking_number in tracking_numbers:
                tracking = models.RefundProductReturnTracking.objects.create(
                    tracking_number=tracking_number,
                    order_id=order_info.id,
                )
                created_trackings.append(tracking)

            # 검수를 위해 데이터 저장
            find_fulfillments = cls.get_nodes_or_error(
                fulfillment_ids, field="id", only_type=Fulfillment
            )

            for find_fulfillment in find_fulfillments:
                consignment_check = False

                if len(consignment_fulfillment_ids) > 0:
                    # find_fulfillment 값을 base64로 인코딩
                    encoded_find_fulfillment = graphene.Node.to_global_id(
                        "Fulfillment", find_fulfillment.id
                    )
                    # 위탁 리스트에 값 있는지 확인
                    consignment_check = encoded_find_fulfillment in consignment_fulfillment_ids

                refund_inspect = models.RefundInspect.objects.create(
                    refund_qa=refund_qa_info,
                    fulfillment=find_fulfillment,
                    inspect=None,
                    consignment=consignment_check,
                )
                created_refund_inspect.append(refund_inspect)

        return cls(tracking_numbers=created_trackings)


