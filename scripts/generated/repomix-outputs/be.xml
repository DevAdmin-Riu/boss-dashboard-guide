class CustomerRefundQuestionReply(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="교환/반품/취소 문의 사항 ID")
        input = CustomerRefundQuestionReplyInput(
            required=True,
            description="교환/반품/취소 문의에 대한 답변 등록을 위한 입력값",
        )

    class Meta:
        description = "교환/반품/취소 문의에 대한 답변 등록"
        model = models.RefundQA
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance: RefundQAModel, data):
        if instance.is_fbv:
            raise ValidationError("직거래 상품에서 호출할 수 없는 기능입니다.")
        if instance.q_type == RefundQuestionType.CANCEL:
            raise ValidationError("주문 취소 건은 승인/거부 처리할 수 없습니다.")
        if instance.status != RefundStatusType.ACCEPTED:
            raise ValidationError("접수 상태에서만 호출할 수 있는 기능입니다.")

        cleaned_input = super().clean_input(info, instance, data)
        cleaned_input["a_writer"] = info.context.user
        cleaned_input["a_created_at"] = kst_datetime()

        if instance.q_type == RefundQuestionType.ETC:
            cleaned_input["status"] = RefundStatusType.QUESTION_CLOSE
        else:
            is_product_returned = cleaned_input.get("is_product_returned")
            is_refused = cleaned_input.get("is_refused")

            # 문의 승인
            if is_refused == False:
                # 상품 회수 여부 True
                if is_product_returned:
                    # 상품 회수한다면 "회수 및 검수" 상태로 변경
                    if instance.q_type == RefundQuestionType.REFUND:
                        cleaned_input["status"] = RefundStatusType.COLLECTED_INSPECT
                        # 교환 일 때 "교환 대기" 상태로
                    elif instance.q_type == RefundQuestionType.EXCHANGE:
                        cleaned_input["status"] = RefundStatusType.CHANGE_PENDING
                # 상품 회수 여부 False
                else:
                    # 상품 회수 안하고 "환불 대기" 상태로
                    if instance.q_type == RefundQuestionType.REFUND:
                        cleaned_input["status"] = RefundStatusType.REFUND_PENDING
                    # 상품 회수 안하고 "교환 대기" 상태로
                    elif instance.q_type == RefundQuestionType.EXCHANGE:
                        cleaned_input["status"] = RefundStatusType.CHANGE_PENDING
            # 문의 거부
            else:
                cleaned_input["status"] = RefundStatusType.REJECT
        return cleaned_input

    @classmethod
    def get_type_for_model(cls):
        return RefundQA

    @classmethod
    def post_save_action(cls, info, instance: RefundQAModel, cleaned_input):
        transaction.on_commit(lambda: send_kakaotalk_to_customer_on_refund_status(instance))

        models.RefundQAHistory.objects.create(
            refund_qa=instance,
            user=info.context.user,
            status=instance.status,
            memo=instance.a_refuse_reason if instance.is_refused else instance.a_approve_message,
        )


