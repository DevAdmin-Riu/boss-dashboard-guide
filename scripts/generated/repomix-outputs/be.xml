            "link_url",
            "start",
            "end",
            "visible_to_brand",
            "visible_to_hq_brand",
            "updated_at",
            "is_hq_popup",
            "available_to_all_brands",
        ]

    @staticmethod
    def resolve_available_brands(root: models.Popup, info, **_kwargs):
        return (
            BrandsByPopupIdLoader(info.context)
            .load(root.id)
            .then(
                # name으로 ordering
                lambda brands: sorted(brands, key=lambda brand: brand.name)
            )
        )

    @staticmethod
    def resolve_pc_image(root: models.Popup, info, size=None, **_kwargs):
        return Image.get_adjusted(
