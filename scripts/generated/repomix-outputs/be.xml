    @classmethod
    def validate_po_type(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.purchase_order.is_take_back_po
            or line.purchase_order.is_consignment_po
            or line.purchase_order.is_consignment_take_back_po
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(
                f"재고발주서 전용 출고 지시 요청을 할 수 없는 다른 발주 타입에 속한 발주 품목이 존재합니다. {invalid_codes}"
            )

    @classmethod
    def validate_status(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.status not in [PurchaseOrderLineStatus.RECEIVED]
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(
                f"출고 지시할 수 없는 상태의 발주 품목이 존재합니다. {invalid_codes}"
            )

    @classmethod
    def validate_stocked_quantity_list(
        cls,
        purchase_order_lines: List[PurchaseOrderLineModel],
        stocked_quantity_list: List["int"],
    ):
        for quantity in stocked_quantity_list:
            if quantity <= 0:
                raise ValidationError("출고 지시 수량은 0 이상의 값만 입력 가능합니다.")

        overstock_errors = []
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
        allowed_overstocking_rate = Decimal(plugin_configs.allowed_overstocking_rate)
        for purchase_order_line, stocked_quantity in zip(
            purchase_order_lines, stocked_quantity_list
        ):
            quantity = purchase_order_line.quantity
            if stocked_quantity > quantity * (100 + allowed_overstocking_rate) / 100:
                overstock_errors.append(purchase_order_line.code)
        if overstock_errors:
            error_msg = (
                "출고 지시 수량이 발주 수량의 {}%를 초과할 수 없습니다. (발주상세번호: {})".format(
                    allowed_overstocking_rate, ", ".join(overstock_errors)
                )
            )
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data):
        user: "User" = info.context.user
        details = input_data.get("details")
        validate_data_is_non_null(details)
        po_line_dict, po_lines = validate_po_lines(details)
        stocked_quantity_list = []
        for detail in details:
            purchase_quantity = detail.get("purchase_quantity")
            stocked_quantity_list.append(purchase_quantity)
        cls.validate_stocked_quantity_list(po_lines, stocked_quantity_list)
        cls.validate_po_type(po_lines)
        cls.validate_status(po_lines)
        cls.validate_vender(user, po_lines)
        return details, po_line_dict

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        details, po_line_dict = cls.clean_details(info=info, input_data=input_data)

        update_po_lines = []
        for detail in details:
            po_line_id = detail.get("po_line_id")
            po_line: PurchaseOrderLineModel = po_line_dict[po_line_id]
            purchase_quantity = detail.get("purchase_quantity")
            po_line.purchase_quantity = purchase_quantity
            po_line.status = PurchaseOrderLineStatus.DISPATCH_FULFILLMENT
            update_po_lines.append(po_line)

        if update_po_lines:
            models.PurchaseOrderLine.objects.bulk_update(
                update_po_lines, ["purchase_quantity", "status"]
            )
            user: "User" = info.context.user
            add_po_manage_event_with_type(
                user, update_po_lines, PurchaseOrderManageEventType.FULFILLED
            )
            bulk_create_po_line_status_histories(
                update_po_lines,
                before_status=PurchaseOrderLineStatus.RECEIVED,
                after_status=PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
                user=user,
            )

        return PurchaseOrderLinesDispatchFulfillment(purchase_order_lines=update_po_lines)


