def handle_vbank(request: WSGIRequest, gateway_config: GatewayConfig):
    json_request = json.dumps(request.POST)
    logger.info(f"payment_debug: handle_vbank {json_request}")

    valid_ips = ["203.238.37.15", "39.115.212.9", "183.109.71.153"]
    ip_address = get_client_ip(request)
    if ip_address is None or ip_address not in valid_ips:
        error_msg = "Inicis: Ip address is not valid - %s" % ip_address
        logger.error(f"{error_msg}")
        return HttpResponseBadRequest(error_msg)

    payment_id = request.POST.get("no_oid")
    payment = Payment.objects.filter(pk=payment_id).first()
    if not payment:
        error_msg = f"Inicis: Payment is not exists {payment_id}"
        logger.error(f"{error_msg}")
        return HttpResponseBadRequest(error_msg)

    gateway_response = request.body.decode("EUC-KR")

    if payment.charge_status == ChargeStatus.FULLY_CHARGED:
        logger.info(f"payment_debug: handle_vbank already charged {payment}")
        return HttpResponse("OK")

    if not payment.order:
        error_msg = f"Inicis: Payment.order is not exists {payment_id}"
        logger.error(f"{error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리를 위한 주문이 존재하지 않습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    is_success, failed_msg = process_vbank_noti(
        payment=payment,
        gateway_response=gateway_response,
        is_mobile=False,
    )

    if not is_success:
        error_msg = f"{failed_msg} - {gateway_response}"
        logger.error(f"{error_msg}")
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.SYSTEM_FAILED,
            message="입금 통보 처리 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다.",
            parameters={
                "payment_id": payment_id,
                "gateway_response": gateway_response,
            },
        )
        return HttpResponseBadRequest(error_msg)

    # OK" 문자열이 응답되지 않을 경우, 24시간동안 약 10분 주기로 10회까지 노티가 재전송됩니다.
    return HttpResponse("OK")


