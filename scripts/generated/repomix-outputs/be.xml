def validate_login_id(details) -> Dict[str, User]:
    errors = []
    login_ids = set()
    for detail in details:
        login_id = detail.get("login_id")
        login_ids.add(login_id)

    sorted_login_ids = sorted(login_ids)
    users = {}
    for login_id in sorted_login_ids:
        try:
            user = User.objects.get(login_id=login_id)
            users[login_id] = user
        except Exception:
            errors.append(login_id)
            continue

    if len(errors) > 0:
        error_msg = "매장 로그인 아이디 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return users


def get_fbv_brand_products(brand: "Brand", vendor: "Vendor"):
    vendor_product_variant_ids = product_models.ProductVariantVendor.objects.filter(
        vendor=vendor
    ).values_list("product_variant_id", flat=True)
    vendor_filter = Q(product__variants__id__in=vendor_product_variant_ids)
    fbv_filter = Q(product__is_fulfilled_by_vendor=True)
    sales_status_filter = Q(
        brand_product_variants__sales_status__in=[SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED]
    )
    force_no_normal_display_filter = Q(brand_product_variants__force_no_normal_display=False)
    price_filter = Q(
        brand_product_variants__price_amount__isnull=False,
        brand_product_variants__cost_price_exclude_vat__isnull=False,
        brand_product_variants__delivery_fee_amount__isnull=False,
    )
    outer_bpv_filter = Q(brand_product_variants__product_variant__isnull=False) & Q(
        brand_product_variants__product_variant__outer__isnull=True
    )
    brand_products = brand.brand_products.filter(
        vendor_filter
        & fbv_filter
