            "label": "공급자 상호",
        },
        "invoicerAddr": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "공급자 주소",
            "label": "공급자 주소",
        },
        "invoicerBizType": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "공급자 업태",
            "label": "공급자 업태",
        },
        "invoicerBizClass": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "공급자 종목",
            "label": "공급자 종목",
        },
        "LinkID": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "수정 시 개발자에게 문의하세요",
            "label": "LinkID",
        },
        "SecretKey": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "수정 시 개발자에게 문의하세요",
            "label": "SecretKey",
        },
    }

    @require_active_plugin
    def get_plugin_config_dot_map(self):
        config = {item["name"]: item["value"] for item in self.configuration}
        configJson = DotMap(config)
        return configJson

    def raise_plugin_error(self):
        raise ValidationError("팝빌 플러그 인이 비활성화 모드로 되어 있습니다")

    def raise_popbill_exception(self, response):
        error_message = unquote(response.message)
        raise ValidationError(error_message)

    def validate_plugin(self):
        return self.active

    def tax_invoice_issue(
        self,
        tax_invoice: "TaxInvoice",
        requester: "User",
        previous_value: Any,
    ) -> Any:
        if not self.validate_plugin():
            self.raise_plugin_error()

        response, do_not_retry_auto_issue = create_tax_invoice_issue(tax_invoice)

        if response is None:
            # 세금계산서 발행 불가 조건인 경우 자동 발행 날짜를 초기화해서 다시 시도하지 않도록 함
            if do_not_retry_auto_issue:
                tax_invoice.auto_issue_date = None
                tax_invoice.save(update_fields=["auto_issue_date"])
            return None

        invoicer_biz_info: BizRegInfo = get_invoicer_biz_reg_info_by_tax_invoice(tax_invoice)
        invoicee_biz_info: BizRegInfo = get_invoicee_biz_reg_info_by_tax_invoice(tax_invoice)

        if type(response).__name__ == "PopbillException":
            amount_exclude_vat = calc_to_exclude_vat(
                tax_invoice.total_amount, tax_invoice.is_tax_free
            )
            rounded_total_amount = my_round(tax_invoice.total_amount)
            vat = rounded_total_amount - amount_exclude_vat

            context = {
                "error_code": response.code,
                "error_message": unquote(response.message),
                "invoicer_biz_reg_no": invoicer_biz_info.biz_reg_no,
                "invoicer_biz_reg_corp_name": invoicer_biz_info.biz_reg_corp_name,
                "invoicer_biz_reg_ceo_name": invoicer_biz_info.biz_reg_ceo_name,
                "invoicee_biz_reg_no": invoicee_biz_info.biz_reg_no,
                "invoicee_biz_reg_corp_name": invoicee_biz_info.biz_reg_corp_name,
                "invoicee_biz_reg_ceo_name": invoicee_biz_info.biz_reg_ceo_name,
                "is_tax_free": term_of_is_tax_free(tax_invoice.is_tax_free),
                "amount_exclude_vat": amount_exclude_vat,
                "vat": vat,
                "total_amount": rounded_total_amount,
                "write_date": tax_invoice.write_date,
            }
            send_issue_fail_email(context)
            self.raise_popbill_exception(response)

        tax_invoice.nts_confirm_num = response["nts_confirm_num"]
        tax_invoice.mgt_key = response["mgt_key"]
        tax_invoice.issued = response["issued"]
        tax_invoice.status = TaxInvoiceStatus.ISSUED
        tax_invoice.issued_amount = tax_invoice.total_amount
        tax_invoice.invoicer_biz_info = asdict(invoicer_biz_info) if invoicer_biz_info else {}
        tax_invoice.invoicee_biz_info = asdict(invoicee_biz_info) if invoicee_biz_info else {}
        tax_invoice.save(
            update_fields=[
                "nts_confirm_num",
                "issued",
                "mgt_key",
                "status",
                "issued_amount",
                "invoicer_biz_info",
                "invoicee_biz_info",
            ]
        )

        if tax_invoice.is_b2b == False:
            tax_invoice_issued_event(
                tax_invoice=tax_invoice,
                requester=requester,
            )
            update_stats_sales_info_on_tax_invoice_issued([tax_invoice])

        return tax_invoice

    def tax_invoice_get_url(
        self,
        tax_invoice: "TaxInvoice",
        previous_value: Any,
    ) -> Any:
        if not self.validate_plugin():
            self.raise_plugin_error()
        response = get_view_url(tax_invoice)
        if type(response).__name__ == "PopbillException":
            self.raise_popbill_exception(response)
        return response
