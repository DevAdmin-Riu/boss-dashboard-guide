class RcoinsBulkIncreaseDetail(graphene.InputObjectType):
    login_id = graphene.String(required=True, description="회원 로그인 id")
    amount = graphene.Int(required=True, description="충전할 rcoin")


class RcoinsBulkIncreaseInput(graphene.InputObjectType):
    reason = graphene.String(description="충전 사유", required=True)
    details = graphene.List(
        RcoinsBulkIncreaseDetail,
        required=True,
        description="포인트(Rcoin) 일괄 증가 정보",
    )


class RcoinsBulkIncrease(BaseMutation):
    class Arguments:
        input = RcoinsBulkIncreaseInput(required=True, description="포인트(Rcoin) 일괄 증가 입력")

    class Meta:
        description = "포인트(Rcoin) 일괄 증가"
        permissions = (AccountPermissions.MANAGE_POINTS,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def make_detail_code(cls, detail):
        login_id = detail.get("login_id")
        return f"{login_id}"

    @classmethod
    def validate_value_empty(cls, details):
        login_id_errors = []
        amount_errors = []
        for detail in details:
            login_id = detail.get("login_id")
            amount = detail.get("amount")
            detail_code = cls.make_detail_code(detail)
            if not login_id:
                login_id_errors.append(detail_code)
            if amount is None or amount <= 0:
                amount_errors.append(detail_code)
        if login_id_errors:
            error_msg = "로그인 아이디 오류: {}".format(", ".join(login_id_errors))
            raise ValidationError(error_msg)
        if amount_errors:
            error_msg = "충전할 포인트 금액 오류: {}".format(", ".join(amount_errors))
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        cls.validate_value_empty(details)
        users = validate_user(details)
        return details, users

    @classmethod
    def update_rcoins(cls, info, details, users: Dict[str, UserModel], reason: str):
        for detail in details:
            login_id = detail.get("login_id")
            amount = detail.get("amount")
            user = users[login_id]
            user.increase_rcoins(
                qty=amount,
                description=reason,
                type=RcoinsEventType.RECHARGE,
                staff=info.context.user,
            )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        reason = input_data.get("reason")
        details, users = cls.clean_details(info=info, input_data=input_data)
        cls.update_rcoins(info=info, details=details, users=users, reason=reason)
        return RcoinsBulkIncrease()


class BrandGroupBulkDelete(ModelBulkDeleteMutation):
