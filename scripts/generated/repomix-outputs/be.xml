class RefundOrderLineInput(graphene.InputObjectType):
    order_line_id = graphene.ID(description="orderline ID", required=True)
    quantity = PositiveDecimal(description="orderline quantity", required=True)

    @staticmethod
    def validate_refund_orderline(cleaned_input):
        q_order_line_info: List[RefundOrderLineInput] = cleaned_input.get("q_order_line_info")
        order: OrderModel = cleaned_input.get("order")

        for q_order_line in q_order_line_info:
            _, order_line_id = graphene.Node.from_global_id(q_order_line.order_line_id)
            order_line: OrderLine = (
                order.lines.filter(id=order_line_id).select_related("purchase_order_line").first()
            )
            if not order_line:
                raise ValidationError("환불할 주문 정보가 잘못 되었습니다.")
            ordered_or_fulfilled_qty = get_ordered_or_fulfill_qty(order_line, order)
            if ordered_or_fulfilled_qty < q_order_line.quantity:
                raise ValidationError("환불가능한 상품 수 보다 더 많은 상품을 환불할 수 없습니다.")


