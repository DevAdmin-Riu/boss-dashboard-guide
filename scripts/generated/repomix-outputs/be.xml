)
from .models import CouriersDeliveryFee, Purchase, ReorderNoticeSchedule, Sales, SalesB2bSettlement
from .utils import make_purchases_group_by_vendor, make_sales_group_by_brand

logger = logging.getLogger()


def create_couriers_delivery_fee(
    dotMapItem: DotMap,
    fulfillment: "Fulfillment",
):
    # fulfillment를 관련된 데이터를 미리 로드하여 가져옴
    fulfillment_fetched = (
        Fulfillment.objects.select_related("order")
        .prefetch_related(
            Prefetch(
                "lines",
                queryset=FulfillmentLine.objects.select_related(
                    "order_line", "order_line__variant", "order_line__variant__product"
                ).all(),
                to_attr="lines_list",
            )
        )
        .get(id=fulfillment.id)
    )  # id로 특정 fulfillment 객체를 가져옴

    order = fulfillment_fetched.order
    # line은 한개만 있다고 봐도 무방.
    fulfillment_line = fulfillment_fetched.lines_list[0]

    variant = fulfillment_line.order_line.variant

    order_items = dotMapItem.orderItems
    # order_items의 각 요소안의 itemName들을 " "로 조인한다.
    item_names = " ".join(item["itemName"] for item in order_items)
    # order_items의 첫번째 요소의 uniqueCd를 가져온다.
    uniqueCd = order_items[0]["uniqueCd"]
    # dotMapItem의 rcvAddr1과 rcvAddr2를 조인해서 rcv_addr로 만든다.
    rcv_addr = f"{dotMapItem.rcvAddr1} {dotMapItem.rcvAddr2}"

    order_line = fulfillment_line.order_line
    order_line_box_size = order_line.box_size

    product_info = {
        "product_sku": variant.sku,
        "product_name": variant.product.name,
        "brand_product_name": item_names if item_names else "-",
        "box_size_type": order_line_box_size,
    }
    delivery_info = {
        "trans_unique_cd": dotMapItem.transUniqueCd,
        "unique_cd": uniqueCd,
        "rcv_name": dotMapItem.rcvName,
        "rcv_tel1": dotMapItem.rcvTel1,
        "rcv_addr": rcv_addr,
        # 아래 정보는 update시에 추가됨.
        # "courier_id": courier.id,
        # "courier_name": courier.name,
        # "tracking_number": tracking_number,
    }

    box_size_attribute = Attribute.objects.get(slug=AttributeSlugEnum.BOX_SIZE.value)
    box_size_attribute_id = box_size_attribute.id
    box_size_attribute_values = AttributeValue.objects.filter(attribute_id=box_size_attribute_id)

    box_size_attribute = box_size_attribute_values.filter(slug=order_line_box_size).first()
    delivery_fee = box_size_attribute.value.get("delivery_fee") if box_size_attribute else 0

    # 재출력요청을 위해 창을 열었다 닫기만 할 경우, 이미 송장번호가 저장되었던 delivery_info가 덮어씌워지는 문제가 있음
    # 실제로 재출력을 한 경우, created 날짜가 재출력한 날짜로 바뀌는 편이 집하처리 task 대상에 포함될 수 있어서 created 만 업데이트 함
    instance, created = CouriersDeliveryFee.objects.get_or_create(
        fulfillment=fulfillment_fetched,
        is_return=False,
        defaults={
            "created": kst_timezone_now(),
            "order": order,
            "product_info": product_info,
            "delivery_info": delivery_info,
            "delivery_fee": delivery_fee,
        },
    )

    if not created:
        instance.created = kst_timezone_now()
        instance.save(update_fields=["created"])


def update_couriers_delivery_fee_when_print(
    fulfillment: "Fulfillment",
    courier: "Courier",
    tracking_number: str,
    is_return: Optional[bool] = False,
):
    courier_delivery_fee = CouriersDeliveryFee.objects.filter(
        fulfillment=fulfillment, is_return=is_return
    ).first()
    # courier_delivery_fee가 없는 경우 return 한다.
    if courier_delivery_fee is None:
        return

    delivery_info = courier_delivery_fee.delivery_info
    delivery_info["courier_id"] = courier.id
    delivery_info["courier_name"] = courier.name
    delivery_info["tracking_number"] = tracking_number
    delivery_info["courier_code"] = courier.code
    courier_delivery_fee.save()


def create_couriers_delivery_fee_when_return(
    fulfillment: "Fulfillment",
):
    # fulfillment를 사용해서 CouriersDeliveryFee에서 값을 가지고온다.
    courier_delivery_fee = CouriersDeliveryFee.objects.filter(
        fulfillment=fulfillment, is_return=False
    ).first()
    # courier_delivery_fee가 없는 경우 return 한다.
    if courier_delivery_fee is None:
        return
    # courier_delivery_fee를 복사해서 is_return을 True로 바꾼다.(pk None으로 만들어야 새로 만듬.)
    new_courier_delivery_fee = deepcopy(courier_delivery_fee)
    new_courier_delivery_fee.pk = None
