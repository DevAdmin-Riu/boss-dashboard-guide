        is_po_line_delivery_confirmed = graphene.Boolean(description="PO Line 배송확정 여부")
        input = FulfillmentUpdateTrackingInput(
            required=True, description="Fields required to update an fulfillment."
        )

    class Meta:
        description = "Updates a fulfillment for an order."
        permissions = (OrderPermissions.MANAGE_DELIVERY_STATUS,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: "User" = context.user
        # 협력사인 경우 권한 체크 패스하고 validation 처리
        if user.is_vendor_staff:
            return True
        return super().check_permissions(context, **data)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        is_po_line_delivery_confirmed = data.get("is_po_line_delivery_confirmed")
        fulfillment: FulfillmentModel = cls.get_node_or_error(
            info, data.get("id"), only_type=Fulfillment
        )
        order = fulfillment.order

        input = data.get("input")
        user = info.context.user

        delivery_method = input.get("delivery_method")
        if delivery_method is not None:
            if not fulfillment.is_fulfilled_by_vendor and not fulfillment.is_b2b:
                raise ValidationError(
                    "직거래 상품 주문 또는 B2B 주문 출고만 배송방식을 변경할 수 있습니다."
                )
            if delivery_method not in [
                OrderDeliveryMethods.BY_COURIER,
                OrderDeliveryMethods.BY_TRUCK_SERVICE,
            ]:
                raise ValidationError("택배, 화물차 중에서만 배송방식을 변경할 수 있습니다.")
            if delivery_method == fulfillment.delivery_method and fulfillment.is_b2b == False:
                raise ValidationError("이미 동일한 배송방식입니다.")
            models.OrderEvent.objects.create(
                order=order,
                type=OrderEvents.FBV_TRACKING_UPDATED,
                user=user,
                parameters={
                    "fulfillment": fulfillment.composed_id,
                    "before_delivery_method": fulfillment.delivery_method,
                    "after_delivery_method": delivery_method,
                },
            )
            fulfillment.delivery_method = delivery_method
            fulfillment.save(update_fields=["delivery_method"])

        tracking_completed = input.get("is_tracking_completed")
        if tracking_completed is not None:
            is_tracking_completed = tracking_completed == True
            if is_tracking_completed and not fulfillment.can_tracking_completed():
                raise ValidationError("배송완료 처리할 수 없는 출고입니다.")
            fulfillment_tracking_completed(
                fulfillment, user, is_tracking_completed, "관리자 배송완료 처리"
            )

        is_by_courier = fulfillment.delivery_method == OrderDeliveryMethods.BY_COURIER
        # 기존 배송방식(택배)의 경우
        if is_by_courier:
            courier_id = input.get("courier_id") or None
            tracking_number = input.get("tracking_number") or None
            is_exist_direct_shipping = fulfillment.lines.filter(
                order_line__variant__product__is_direct_shipping=True
            ).exists()
            if courier_id is not None and tracking_number is not None:
                if is_exist_direct_shipping:
                    raise ValidationError(
                        "직배송 제품이 있는 출고에 송장번호를 세팅할 수 없습니다."
                    )
                courier = cls.get_node_or_error(info, courier_id, only_type="Courier", field="id")
                tracking_number_numeric_only = remove_all_non_numeric(tracking_number)
                if (
                    check_courier_digit_allowed_values(tracking_number_numeric_only, courier)
                    == False
                ):
                    raise ValidationError(
                        f"송장번호 자리수 오류: {tracking_number} ({courier.name})"
                    )
                fulfillment_set_tracking_number(
                    fulfillment,
                    courier,
                    tracking_number_numeric_only,
                    TrackingNumberType.MANUAL,
                    user,
                )

                if fulfillment.is_picking_order:
                    update_or_create_picking_line([fulfillment], update_only=True)

                if is_po_line_delivery_confirmed:
                    set_consignment_po_line_status_on_update_tracking_info(
                        user, fulfillment, is_by_courier
                    )

            tracking_direct_shipping = input.get("is_tracking_direct_shipping")
            if tracking_direct_shipping is not None:
                if not is_exist_direct_shipping:
                    raise ValidationError(
                        "직배송 제품이 없는 출고에 직배송 배송시작여부 여부를 변경할 수 없습니다."
                    )
                is_tracking_direct_shipping = tracking_direct_shipping == True
                fulfillment_tracking_direct_shipping(fulfillment, user, is_tracking_direct_shipping)
        # 기타 배송방식의 경우
        else:
            etc_delivery_man_info = input.get("etc_delivery_man_info") or None
            if etc_delivery_man_info is not None:
                fulfillment_set_tracking_etc_delivery(fulfillment, user, etc_delivery_man_info)
                if is_po_line_delivery_confirmed:
                    set_consignment_po_line_status_on_update_tracking_info(
                        user, fulfillment, is_by_courier
                    )

        return FulfillmentUpdateTracking(fulfillment=fulfillment, order=order)


