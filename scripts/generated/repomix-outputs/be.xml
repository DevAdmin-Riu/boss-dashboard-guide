import graphene

from saleor.core.exceptions import PermissionDenied
from saleor.schedule import models


def resolve_schedule(info, id):
    user = info.context.user
    _model, schedule_pk = graphene.Node.from_global_id(id)
    schedule = models.Schedule.objects.filter(pk=schedule_pk).first()
    if user.is_staff:
        return schedule
    elif user.is_hq_staff and schedule.writer.brand_id == user.brand_id:
        return schedule

    return PermissionDenied(user=user, fn=resolve_schedule)


def resolve_schedules(info, **kwargs):
    user = info.context.user
    if user.is_hq_staff:
        qs = models.Schedule.objects.filter(writer__brand_id=user.brand_id)
    elif user.is_staff:
        qs = models.Schedule.objects.all()
    else:
        return PermissionDenied(user=user, fn=resolve_schedules)
    return qs.distinct()
