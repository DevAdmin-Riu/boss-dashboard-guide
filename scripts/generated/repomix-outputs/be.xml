        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def validate_is_adjust_price(cls, brand: "BrandModel", variant: "ProductVariantModel"):
        if variant.is_adjust_price:
            if brand.contract_type == BrandContractType.B2B:
                raise ValidationError(
                    "b2b 브랜드에 납품 시 금액확정 제품을 상품등록할 수 없습니다."
                )

