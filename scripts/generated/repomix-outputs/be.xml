@transaction.atomic
def cancel_fulfillment(
    fulfillment: "Fulfillment",
    user: "User",
    warehouse: "Warehouse",
    is_refund: bool,
    rack_location: "RackLocation",
):
    """Cancel fulfillment.

    Return products to corresponding stocks.
    """
    fulfillment = Fulfillment.objects.select_for_update().get(pk=fulfillment.pk)
    restock_fulfillment_lines(fulfillment, user, warehouse, is_refund, rack_location)
    if is_refund:
        events.fulfillment_refunded_event(
            order=fulfillment.order, user=user, fulfillment=fulfillment
        )
    else:
        events.fulfillment_canceled_event(
            order=fulfillment.order, user=user, fulfillment=fulfillment
        )

    events.fulfillment_restocked_items_event(
        order=fulfillment.order,
        user=user,
        fulfillment=fulfillment,
        warehouse_pk=warehouse.pk if warehouse else None,
    )
    fulfillment.status = FulfillmentStatus.REFUNDED if is_refund else FulfillmentStatus.CANCELED
    fulfillment.save(update_fields=["status"])
    update_order_status(fulfillment.order)
    get_plugins_manager().order_updated(fulfillment.order)


def decrease_stock_on_fulfillment(order_line: OrderLine, quantity, warehouse_pk):
    """Fulfill order line with given quantity."""
    from ..warehouse.management import decrease_stock

    # 위탁 제품의 재고 주문도 decrease_stock 처리 필요하므로, order_line 에 저장된 재고 주문 정보로 decrease_stock 처리
    # 기타 배송 주문인 경우 decrease_stock_flag 값은 재고반영여부로 입력된 대로, 그 외 다른 주문 타입은 기본값으로 재고 반영 모드로 처리
    if order_line.track_inventory and order_line.decrease_stock_flag == True:
        decrease_stock(order_line, quantity, warehouse_pk)


def update_order_line_quantity_fulfilled(order: Order, order_line, quantity):
    if can_fulfill_more_than_ordered(order_line, order.delivery_method):
        OrderLine.objects.filter(pk=order_line.pk).update(
            quantity_fulfilled=F("quantity_fulfilled") + quantity
        )
    else:
        updated = OrderLine.objects.filter(
            pk=order_line.pk, quantity__gte=F("quantity_fulfilled") + quantity
        ).update(quantity_fulfilled=F("quantity_fulfilled") + quantity)

        if not updated:
            raise ValidationError("출고 대기 수량보다 많이 출고할 수 없습니다.")

    # 향후 해당 order_line 또는 fulfillment_line.order_line의 quantity_fulfilled를 쓰는 경우에는 아래와 같이 refresh_from_db()를 통해 최신 정보를 가져와서 사용해야 함
    # order_line.refresh_from_db()


def _create_fulfillment_lines(
    order: Order,
    fulfillment: Fulfillment,
    warehouse_pk: str,
    lines_for_warehouse: List[Dict],
) -> Tuple[List[FulfillmentLine], List[int], List[int]]:
    fulfillment_lines = []
    quantities: List[int] = []
    b2b_delivery_fee_exclude_vat_list: List[int] = []
    for line in lines_for_warehouse:
        quantity = line.get("quantity", 0)
        if quantity <= 0:
            continue

        order_line: OrderLine = line["order_line"]
        variant: ProductVariant = order_line.variant
        # 재고 주문인 경우 여기서는 default_variant_vendor 정보로만 세팅. 실제 출고에 사용된 상품의 협력사는 _fulfillment_from_stock_detail 에서 StockDetailLine 에 저장됨
        variant_vendor: ProductVariantVendor = variant.get_default_variant_vendor()

        # 재고, 위탁재고 출고는 창고 정보 필요
        need_stock = order_line.track_inventory
        # 위탁, 위탁재고 출고는 발주서 정보 필요
        need_po = order_line.track_inventory == False or variant.is_vendor_track_inventory

        stock = None
        if need_stock:
            if warehouse_pk is None:
                err_msg = "창고 ID가 필요합니다."
                raise ValidationError(
                    {
                        "fulfillment": ValidationError(
                            err_msg, code=OrderErrorCode.WAREHOUSE_ID_REQUIRED
                        )
                    }
                )
            stock = variant.stocks.filter(warehouse=warehouse_pk).first()
            if stock is None:
                error_context = {
                    "order_line": order_line,
                    "warehouse_pk": warehouse_pk,
                }
                raise InsufficientStock(variant, error_context)

        if need_po:
            purchase_order_line: PurchaseOrderLine = order_line.purchase_order_line
            if purchase_order_line is None:
                raise ValidationError(
                    "위탁 상품인 경우 발주 정보가 없으면 출고 처리할 수 없습니다."
                )
            if purchase_order_line.status not in [
                PurchaseOrderLineStatus.RECEIVED,
                PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
            ]:
                raise ValidationError(
                    f"위탁 상품을 출고 지시할 수 있는 상태가 아닙니다. {purchase_order_line.status}"
                )

            purchase_order_variant_vendor = ProductVariantVendor.objects.filter(
                product_variant=variant,
                vendor=purchase_order_line.purchase_order.vendor,
            ).first()
            # 발주서 품목에 snapshot 으로 된 정보 사용
            if purchase_order_variant_vendor:
                variant_vendor = purchase_order_variant_vendor
            variant_vendor.external_sku = purchase_order_line.external_sku
            variant_vendor.external_product_name = purchase_order_line.external_product_name

        decrease_stock_on_fulfillment(order_line, quantity, warehouse_pk)
        update_order_line_quantity_fulfilled(order, order_line, quantity)
        fulfillment_lines.append(
            FulfillmentLine(
                order_line=order_line,
                track_inventory=order_line.track_inventory,
                fulfillment=fulfillment,
                quantity=quantity,
                stock=stock,
                # 아래 vendor 정보는 _fulfillment_from_stock_detail 에서 재고인 경우 stock_detail의 vendor로 덮어진다.
                vendor=variant_vendor.vendor if variant_vendor else None,
                external_sku=variant_vendor.external_sku if variant_vendor else "",
                external_product_name=(
                    variant_vendor.external_product_name if variant_vendor else ""
                ),
            )
        )
        quantities.append(quantity)
        b2b_delivery_fee_exclude_vat = line.get("b2b_delivery_fee_exclude_vat", 0)
        b2b_delivery_fee_exclude_vat_list.append(b2b_delivery_fee_exclude_vat)
    return fulfillment_lines, quantities, b2b_delivery_fee_exclude_vat_list


def _create_fulfillment_lines_by_vendor(
    order: Order,
    requester: "User",
    fulfillment: Fulfillment,
    lines: List[Dict],
) -> List[FulfillmentLine]:
    from ..purchaseorder.actions import make_purchase_for_fulfilled_by_vendor

    fulfillment_lines = []
    purchases = []
    for line in lines:
        quantity = line["quantity"]
        if quantity <= 0:
            continue

        order_line: OrderLine = line["order_line"]
        order_line_track_inventory = order_line.track_inventory
        vendor = order_line.vendor
        variant: ProductVariant = order_line.variant
        unit_cost_price_exclude_vat = (
            variant.cost_price_exclude_vat
            if order_line_track_inventory
            else variant.consignment_cost_price_exclude_vat
        )
        if order_line_track_inventory:
            stock = variant.stocks.first()
            if stock is None:
                raise ValidationError("제품-물류센터 정보 오류입니다.")
        else:
            stock = None

        variant_vendor: ProductVariantVendor = variant.variant_vendors.filter(vendor=vendor).first()
        decrease_stock_on_fulfillment(order_line, quantity, warehouse_pk=None)
        update_order_line_quantity_fulfilled(order, order_line, quantity)
        fulfillment_lines.append(
            FulfillmentLine(
                order_line=order_line,
                track_inventory=order_line_track_inventory,
                unit_cost_price_exclude_vat=unit_cost_price_exclude_vat,
                fulfillment=fulfillment,
                quantity=quantity,
                stock=stock,
                vendor=vendor,
                external_sku=variant_vendor.external_sku if variant_vendor else "",
                external_product_name=(
                    variant_vendor.external_product_name if variant_vendor else ""
                ),
            )
        )
        purchase = make_purchase_for_fulfilled_by_vendor(
            requester=requester, order_line=order_line, quantity=quantity
        )
        purchases.append(purchase)

    return fulfillment_lines, purchases


def decrease_stock_of_sub_pv(
    requester: "User", sub_pv: "ProductVariant", quantity: int, reason: str
):
    if sub_pv is None:
        return

    rack_locations_qs = (
        RackLocation.objects.filter(rack_stocks__product_variant=sub_pv)
        .annotate(total_quantity=Coalesce(Sum("rack_stocks__remain_quantity"), 0))
        .order_by("-total_quantity")
    )
    rack_locations = list(rack_locations_qs)
    stock: Optional[Stock] = None
    first_rack_location = None
    rack_location_count = 0
    for i, rack_location in enumerate(rack_locations):
        if not first_rack_location:
            first_rack_location = rack_location
        rack_location_count = rack_location_count + 1
        is_last_rack_location = i == len(rack_locations) - 1
        rack_stock_details_qs = RackStockDetail.objects.filter(
            location=rack_location, product_variant=sub_pv
        ).order_by("-remain_quantity")
        rack_stock_details: List[RackStockDetail] = list(rack_stock_details_qs)
        remain_fulfillment = quantity
        for j, rack_stock_detail in enumerate(rack_stock_details):
            is_last_rack_stock_detail = j == len(rack_stock_details) - 1
            stock_detail = rack_stock_detail.stock_detail
            stock = stock_detail.stock
            if is_last_rack_location and is_last_rack_stock_detail:
                fulfillment_quantity = remain_fulfillment
            else:
                if remain_fulfillment >= rack_stock_detail.remain_quantity:
                    fulfillment_quantity = rack_stock_detail.remain_quantity
                else:
                    fulfillment_quantity = remain_fulfillment

            stock_detail.decrease_remain_stock_for_sub_pv(fulfillment_quantity)
            rack_stock_detail.decrease_remain_stock_for_sub_pv(fulfillment_quantity)

            remain_fulfillment = remain_fulfillment - fulfillment_quantity
            if remain_fulfillment <= 0:
                break

        if remain_fulfillment <= 0:
            break

    if stock is None:
        raise ValidationError("부자재 재고가 관리되고 있는 물류센터 정보가 없습니다.")

    stock.decrease_stock_for_sub_pv(quantity)
    create_fulfillment_stock_detail_event(
        stock,
        user=requester,
        quantity=quantity,
        reason=reason,
        rack_location=first_rack_location,
        rack_location_count=rack_location_count,
    )


def _add_stock_detail_event_on_fbv_fulfillment(
    requester: "User", order: "Order", fulfillment_lines: List["FulfillmentLine"]
):
    stock_detail_event_reason = f"주문번호:{order.composed_id_with_prefix}"
    brand: Brand = order.brand
    if brand:
        stock_detail_event_reason = (
            f"주문번호:{order.composed_id_with_prefix} / {brand.name}({brand.code})"
