class BulkAssignMainPvsToSubPv(BaseMutation):
    sub_pv = graphene.Field(ProductVariant, description="mutation 실행 후 리턴할 sub_pv")

    class Arguments:
        input = BulkAssignMainPvsToSubPvInput(required=True)

    class Meta:
        description = "Assign main_pvs to sub_pv"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @staticmethod
    def validate_sub_pv(sub_pv: ProductVariantModel):
        if sub_pv.is_sub_pv == False:
            raise ValidationError(f"부자재로 등록할 수 없는 제품입니다.: {sub_pv.sku}")
        if sub_pv.track_inventory == False:
            raise ValidationError(
                f"재고 운영 중인 제품만 부자재로 등록할 수 있습니다.: {sub_pv.sku}"
            )
        if sub_pv.outer is not None:
            raise ValidationError(f"아우터 제품만 부자재로 등록할 수 있습니다. {sub_pv.sku}")

    @staticmethod
    def validate_main_pvs(main_pvs: List[ProductVariantModel]):
        no_track_inventory_skus = [pv.sku for pv in main_pvs if pv.track_inventory == False]
        if no_track_inventory_skus:
            error_msg = f"재고 운영 중인 제품만 부자재 필요 제품으로 등록할 수 있습니다.: {', '.join(no_track_inventory_skus)}"
            raise ValidationError(error_msg)
        inner_variant_skus = [pv.sku for pv in main_pvs if pv.outer is not None]
        if inner_variant_skus:
            error_msg = f"아우터 제품만 부자재 필요 제품으로 등록할 수 있습니다.: {', '.join(inner_variant_skus)}"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        sub_pv_id = input_data.get("sub_pv_id")
        main_pv_ids = input_data.get("main_pv_ids")
        manage_event = input_data.get("manage_event")
        sub_pv = cls.get_node_or_error(info, sub_pv_id, field="sub_pv_id", only_type=ProductVariant)
        main_pvs = cls.get_nodes_or_error(main_pv_ids, "main_pv_ids", ProductVariant)
        before_main_pvs = deepcopy(main_pvs)
        before_main_pvs_m2m_and_related_values_list = []
        for before_main_pv in before_main_pvs:
            _, before_product_variant_m2m_and_related_values = prepare_m2m_and_related_values(
                None, before_main_pv
            )
            before_main_pvs_m2m_and_related_values_list.append(
                before_product_variant_m2m_and_related_values
            )
        before_sub_pv = deepcopy(sub_pv)
        _, before_sub_pv_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_sub_pv
        )

        BulkAssignMainPvsToSubPv.validate_sub_pv(sub_pv)
        BulkAssignMainPvsToSubPv.validate_main_pvs(main_pvs)

        # main_pvs 중에 sub_pv 가 연결된 것이 있으면 제거하고 이 요청으로 다시 연결
        models.SubProductVariantRelation.objects.filter(main_pv__in=main_pvs).delete()
        relations = [
            models.SubProductVariantRelation(sub_pv=sub_pv, main_pv=main_pv) for main_pv in main_pvs
        ]
        models.SubProductVariantRelation.objects.bulk_create(relations)

        if manage_event:
            _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                before_variant=before_sub_pv,
                before_inner_variant=None,
                before_product=None,
                before_product_m2m_and_related_values=None,
                before_variant_m2m_and_related_values=before_sub_pv_m2m_and_related_values,
                updated_variant=sub_pv,
                updated_product=None,
            )
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=sub_pv, manage_event=manage_event, info=info)

            for before_main_pv, before_main_pvs_m2m_and_related_values, main_pv in zip(
                before_main_pvs, before_main_pvs_m2m_and_related_values_list, main_pvs
            ):
                _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                    before_variant=before_main_pv,
                    before_inner_variant=None,
                    before_product=None,
                    before_product_m2m_and_related_values=None,
                    before_variant_m2m_and_related_values=before_main_pvs_m2m_and_related_values,
                    updated_variant=main_pv,
                    updated_product=None,
                )
                change_details = "\n".join(variant_changes)
                manage_event["change_details"] = change_details
                add_pv_manage_event(pv=main_pv, manage_event=manage_event, info=info)
        return BulkAssignMainPvsToSubPv(sub_pv=sub_pv)


