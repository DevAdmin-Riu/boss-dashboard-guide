from datetime import timedelta
from typing import List

from django.db import transaction
from django.utils import timezone

from ..account.models import User
from ..celeryconf import app
from ..core.utils import build_absolute_dashboard_uri
from ..graphql.bbs.events import push_notification_on_bs_training_doc_published
from ..plugins.manager import get_plugins_manager
from ..plugins.site_settings.define import SITE_SETTINGS_PLUGIN_ID
from . import RequestBossProductStatus
from .emails import send_templated_mail_req_boss_product_canceled
from .models import BsTrainingDoc, RequestBossProduct, RequestBossProductStatusHistory


@app.task(name="bbs.tasks.cancel_request_boss_product")
@transaction.atomic()
def cancel_request_boss_product():
    today = timezone.now()
    max_target_date = today - timedelta(days=30)

    target_qs = RequestBossProduct.objects.filter(
        status__in=[
            RequestBossProductStatus.REQ_ADDITIONAL,
            RequestBossProductStatus.PENDING_CONFIRM,
        ],
        status_changed_at__lte=max_target_date,
    )
    targets: List[RequestBossProduct] = list(target_qs)
    target_qs.update(status=RequestBossProductStatus.CANCELED, status_changed_at=today)

    canceled_history_list = []
    for target in targets:
        before_status = target.status
        canceled_history = RequestBossProductStatusHistory(
            request=target,
            before_status=before_status,
            after_status=RequestBossProductStatus.CANCELED,
        )
        canceled_history_list.append(canceled_history)

        hq_staff: User = target.hq_staff
        hq_staff_email = hq_staff.email if hq_staff and hq_staff.email else None
        if hq_staff_email:
            context = {
                "request_number": target.request_number,
                "product_name": target.product_name,
                "dashboard_url": build_absolute_dashboard_uri(),
            }
            transaction.on_commit(
                lambda hq_staff_email=hq_staff_email, context=context: send_templated_mail_req_boss_product_canceled(
                    hq_staff_email=hq_staff_email, context=context
                )
            )
    if canceled_history_list:
        RequestBossProductStatusHistory.objects.bulk_create(canceled_history_list)


@app.task(name="bbs.tasks.send_push_notification_on_bs_training_doc_auto_publication")
@transaction.atomic()
def send_push_notification_on_bs_training_doc_auto_publication():
    plugins_config = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
    push_notification_enable = plugins_config.get("push_notification_enable", False)
    if not push_notification_enable:
        return

    today = timezone.now()

    target_qs = BsTrainingDoc.objects.filter(
        is_published=False, publication_date__isnull=False, publication_date=today.date()
    )
    targets: List[BsTrainingDoc] = list(target_qs)
    target_qs.update(first_published_at=today)

    for target in targets:
        push_notification_on_bs_training_doc_published(target)
