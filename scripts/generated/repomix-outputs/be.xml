        "self", null=True, blank=True, related_name="children", on_delete=models.CASCADE
    )
    created_at = models.DateTimeField(auto_now_add=True)
    content = models.TextField()
    writer = models.ForeignKey(
        User,
        on_delete=models.SET_NULL,
        blank=True,
        null=True,
        related_name="+",
    )
    is_active = models.BooleanField(default=True, help_text="삭제 여부")

    objects = models.Manager()
    tree = TreeManager()

    def clean(self):
        if self.pk and not self.is_active:
            raise ValidationError("이미 삭제된 댓글입니다.")

    def save(self, *args, **kwargs):
        info = getattr(self, "_info", None)
        if info and not self.pk:
            self.writer = info.context.user

        super().save(*args, **kwargs)  # 먼저 저장해서 MPTT 구조 갱신

        if self.get_level() > 1:
            raise ValidationError("답글은 1단계까지만 가능합니다.")

    def get_ordering_queryset(self):
        return (
            self.pre_founder_consultation.comments.filter(parent_id=None)
            if not self.parent
            else self.parent.children.all()
        )

    class Meta:
        ordering = ("created_at",)
