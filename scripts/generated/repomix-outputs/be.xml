                has_being_displayed_variant=Exists(
                    BrandProductVariant.objects.filter(
                        brand_product=OuterRef("pk")  # BrandProduct의 외부 참조
                    ).filter(
                        ~Q(sales_status=SalesStatus.STOPPED)  # STOPPED가 아닌 경우
                        & Q(force_no_normal_display=False)  # force_no_normal_display가 False인 경우
                    )
                )
            ).filter(has_being_displayed_variant=True)
        return qs

    brand_product_search = django_filters.CharFilter(method=filter_brand_product_search)
    product_search = django_filters.CharFilter(method=filter_product_search)

    is_direct_shipping = django_filters.BooleanFilter(method=filter_is_direct_shipping)
    is_brand_running = django_filters.BooleanFilter(method=filter_is_brand_running)
    is_fulfilled_by_vendor = django_filters.BooleanFilter(method=filter_is_fulfilled_by_vendor)
    is_dev_pv = django_filters.BooleanFilter(method=filter_is_dev_pv)
