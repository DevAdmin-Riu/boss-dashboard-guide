import django_filters

from saleor.brand_store_ops_check import models
from saleor.graphql.brand_store_ops_check.enums import BsOpsRecheckReportItemStatusEnum
from saleor.graphql.core.filters import ListObjectTypeFilter, ObjectTypeFilter
from saleor.graphql.core.types import FilterInputObjectType
from saleor.graphql.core.types.common import DateRangeInput
from saleor.graphql.utils.filters import filter_by_query_param, filter_range_field


class BsOpsCheckTemplateFilter(django_filters.FilterSet):

    def filter_brand_search(qs, _, value):
        search_fields = [
            "brand__code",
            "brand__name",
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_title_search(qs, _, value):
        fields = ["title"]
        qs = filter_by_query_param(qs, value, fields)
        return qs

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created_at__date", value)

    def filter_visible_date_range(qs, _, value):
        return filter_range_field(qs, "visible_date__date", value)

    brand_search = django_filters.CharFilter(method=filter_brand_search)
    title_search = django_filters.CharFilter(method=filter_title_search)
    visible_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_visible_date_range)

    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)

