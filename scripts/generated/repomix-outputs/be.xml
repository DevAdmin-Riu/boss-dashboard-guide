from collections import defaultdict
from typing import Dict

import graphene
from django.core.exceptions import ObjectDoesNotExist, ValidationError
from django.db import transaction

from ...account import models
from ...account.error_codes import AccountErrorCode
from ...account.models import User as UserModel
from ...core.permissions import AccountPermissions
from ...points import RcoinsEventType
from ..core.mutations import BaseBulkMutation, BaseMutation, ModelBulkDeleteMutation
from ..core.types.common import AccountError, StaffError
from ..product.bulk_mutations.utils import validate_data_is_non_null, validate_duplicate
from .types import BrandGroup, User
from .utils import CustomerDeleteMixin, StaffDeleteMixin


def validate_user(details) -> Dict[str, UserModel]:
    errors = []
    login_ids = set()
    for detail in details:
        login_id = detail.get("login_id")
        if login_id:
            login_ids.add(login_id)

    users = {}
    for login_id in login_ids:
        try:
            user = models.User.objects.get(login_id=login_id)
            users[login_id] = user
        except ObjectDoesNotExist:
            errors.append(login_id)
            continue

    if len(errors) > 0:
        error_msg = "매장 로그인 아이디 오류: {}".format(", ".join(errors))
        raise ValidationError(error_msg)

    return users


class UserBulkDelete(ModelBulkDeleteMutation):
    class Arguments:
        ids = graphene.List(graphene.ID, required=True, description="List of user IDs to delete.")

    class Meta:
        abstract = True


class CustomerBulkDelete(CustomerDeleteMixin, UserBulkDelete):
    class Meta:
        description = "Deletes customers."
        model = models.User
        permissions = (AccountPermissions.MANAGE_USER_INFO,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        count, errors, valid_instances = super().perform_mutation(root, info, **data)
        cls.post_process(info, count)
        return count, errors, valid_instances


class StaffBulkDelete(StaffDeleteMixin, UserBulkDelete):
    class Meta:
        description = "Deletes staff users."
        model = models.User
        error_type_class = StaffError
        error_type_field = "staff_errors"

    @classmethod
    def perform_mutation(cls, _root, info, ids, **data):
        instances = cls.get_nodes_or_error(ids, "id", User)
        errors = cls.clean_instances(info, instances)
        count = len(instances)
        valid_instances = []
        if not errors and count:
            clean_instance_ids = [instance.pk for instance in instances]
            qs = models.User.objects.filter(pk__in=clean_instance_ids)
            cls.bulk_action(queryset=qs, **data)
            valid_instances = instances
        else:
            count = 0
        return count, errors, valid_instances

    @classmethod
    def clean_instances(cls, info, users):
        errors = defaultdict(list)
        requestor = info.context.user
        cls.check_if_users_can_be_deleted(info, users, "ids", errors)
        cls.check_if_requestor_can_manage_users(requestor, users, "ids", errors)
        cls.check_if_removing_left_not_manageable_permissions(requestor, users, "ids", errors)
        return ValidationError(errors) if errors else {}


class UserBulkSetActive(BaseBulkMutation):
