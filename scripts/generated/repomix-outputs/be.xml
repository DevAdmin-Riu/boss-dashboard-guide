    # list에서는 쓰이지 않고 오직 Mall에서 하나의 brand에서만 쓰이는 정보이므로 Loader 구현하지 않음.
    def resolve_fbv_mall_landing_brand_products(root: BrandModel, info, bp_count=5):
        if BrandServiceType.FBV not in root.enabled_services:
            return []

        brand_store_owner_user = info.context.brand_store_owner_user
        days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        any_day_true_q = Q()

        for day in days:
            any_day_true_q |= Q(**{f"possible_delivery_days__{day}": True})

        valid_fbv_delivery_conditions: FbvDeliveryConditionModel = (
            vendor_models.FbvDeliveryCondition.objects.filter(
                user=brand_store_owner_user, vendor__is_active=True, vendor__use_fbv_product=True
            )
            .filter(Q(disallow_delivery_date=True) | any_day_true_q)
            .select_related("vendor")
        )

        fbv_mall_landing_brand_products = []

        for valid_fbv_delivery_condition in valid_fbv_delivery_conditions:
            vendor = valid_fbv_delivery_condition.vendor
            brand_products = get_fbv_brand_products(root, vendor)

            total_brand_product_count = brand_products.count()
            if total_brand_product_count == 0:
                continue

            if bp_count is not None:
                brand_products = brand_products[:bp_count]

            brand_product_info = BrandProductListType(
                total_count=total_brand_product_count, brand_products=brand_products
            )

            fbv_item = FbvBrandProductsGroupByVendor(
                vendor=vendor, brand_product_info=brand_product_info
            )

            fbv_mall_landing_brand_products.append(fbv_item)

        return fbv_mall_landing_brand_products

    # 매장 리스트는 active 여부 무관하게 전체 노출
    # 필드가 ConnectionField이므로 loader처리 하지 않음.
