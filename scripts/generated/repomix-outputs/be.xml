"""Contain functions which are base for calculating checkout properties.

It's recommended to use functions from calculations.py module to take in account plugin
manager.
"""

from decimal import Decimal
from typing import TYPE_CHECKING, List, Tuple

from django.core.exceptions import ValidationError
from prices import Money, TaxedMoney

from ..core.prices import calc_to_include_vat, quantize_price
from ..core.taxes import zero_taxed_money
from ..order import OrderDeliveryMethods, OrderType
from ..product.utils.brand_products_variant import (
    get_brand_product_variant_by_brand_product,
    get_brand_product_variant_region_by_brand_product,
    get_product_variant_region,
)

if TYPE_CHECKING:
    # flake8: noqa
    from ..account.models import Brand
    from ..product.models import (
        BpBundle,
        BrandProduct,
        BrandProductVariant,
        BrandProductVariantRegion,
        ProductVariant,
        ProductVariantRegion,
    )
    from .models import Checkout, CheckoutLine


def base_checkout_subtotal_delivery_additional_fee(
    checkout: "Checkout", lines: List["CheckoutLine"]
) -> TaxedMoney:
    """도서산간 추가 배송비
    * 결제 금액과 비교를 위해 부가세 포함단가 * 배송 박스 수량으로 리턴함
    """

    from .utils import (
        get_delivery_box_count_by_checkout,
        get_unit_delivery_additional_fee_exclude_vat_by_address,
    )

    order_type = checkout.order_type
    if order_type in [
        OrderType.BY_STAFF_FOR_BAD_STOCK,
        OrderType.BY_STAFF_FOR_ETC,
        OrderType.BY_STAFF_FOR_B2B,
        OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
    ]:
        return zero_taxed_money(checkout.currency)

    if checkout.delivery_method == OrderDeliveryMethods.BY_COURIER:
        unit_additional_fee_exclude_vat = get_unit_delivery_additional_fee_exclude_vat_by_address(
            checkout.shipping_address
        )
        if unit_additional_fee_exclude_vat <= 0:
            return zero_taxed_money(checkout.currency)
        unit_delivery_additional_fee = calc_to_include_vat(unit_additional_fee_exclude_vat, False)
        delivery_box_count = get_delivery_box_count_by_checkout(checkout, lines)
        subtotal_delivery_additional_fee_amount = unit_delivery_additional_fee * delivery_box_count
        subtotal_delivery_additional_fee_money = Money(
            subtotal_delivery_additional_fee_amount, checkout.currency
        )
    else:
        subtotal_delivery_additional_fee_money = Money(
            checkout.additional_fee_for_etc_delivery, checkout.currency
        )
    return TaxedMoney(
        net=subtotal_delivery_additional_fee_money, gross=subtotal_delivery_additional_fee_money
    )


def base_checkout_subtotal(line_totals: List[Decimal], currency: str) -> TaxedMoney:
    """Return the total cost of all checkout lines."""
    total_amount = sum(line_totals)
    total_money = [Money(total_amount, currency)]
    return sum(total_money, zero_taxed_money(currency))


def base_checkout_total(
    *,
    subtotal: TaxedMoney,
    subtotal_delivery_additional_fee: TaxedMoney,
    currency: str,
) -> TaxedMoney:
    total = subtotal + subtotal_delivery_additional_fee
    return max(total, zero_taxed_money(currency))


def base_checkout_subtotal_brand_cost(
    subtotal: TaxedMoney,
    currency: str,
) -> TaxedMoney:
    """Return the total cost of the checkout."""
    total = subtotal
    return max(total, zero_taxed_money(currency))


def get_brand_product_info(
    checkout: "Checkout", line: "CheckoutLine"
) -> Tuple["Brand", "BrandProduct", "BrandProductVariant", "BrandProductVariantRegion", "BpBundle"]:
    order_type = checkout.order_type
    # 오픈몰 주문, 기타 배송 주문인 경우에는 브랜드 상품 정보 없이 주문 처리됨
    if order_type in [OrderType.BY_STAFF_FOR_BAD_STOCK, OrderType.BY_STAFF_FOR_ETC]:
        return None, None, None, None, None

    if checkout is None or checkout.user is None:
        raise ValidationError("체크아웃 정보 오류")

    variant: ProductVariant = line.variant
    bp_bundle: BpBundle = line.bp_bundle
    if variant is None and bp_bundle is None:
        raise ValidationError("상품 정보 오류 (1)")

    if bp_bundle:
        brand = bp_bundle.brand
        return brand, None, None, None, bp_bundle

    product = variant.product
    if product is None:
        raise ValidationError("상품 정보 오류 (2)")

    # checkout line에 이미 bpv가 있는 경우 해당 값을 우선 사용한다.
    brand_product_variant = line.brand_product_variant
    if brand_product_variant:
        brand = brand_product_variant.brand
        brand_product = brand_product_variant.brand_product
    else:
        brand = checkout.user.switched_brand
        brand_product: BrandProduct = (
            brand.brand_products.filter(product=product).first() if brand else None
        )
        if brand and brand_product is None:
            raise ValidationError("매장 상품 정보 오류")
        brand_product_variant = get_brand_product_variant_by_brand_product(
            brand_product=brand_product, variant=variant
        )

    if brand and brand_product_variant is None:
        raise ValidationError("매장 상품 옵션 정보 오류")

    if product.is_direct_shipping:
        region = checkout.user.region
        brand_product_variant_region = get_brand_product_variant_region_by_brand_product(
            brand_product=brand_product, variant=variant, region=region
        )
    else:
        brand_product_variant_region = None

    return brand, brand_product, brand_product_variant, brand_product_variant_region, None


def get_product_variant_info(
    checkout: "Checkout", line: "CheckoutLine"
) -> Tuple["ProductVariant", "ProductVariantRegion", "BpBundle"]:
    if checkout is None:
        raise ValidationError("체크아웃 정보 오류 (1)")

    variant: ProductVariant = line.variant
    bp_bundle: BpBundle = line.bp_bundle
    if variant is None and bp_bundle is None:
        raise ValidationError("상품 정보 오류 (1)")

    if bp_bundle:
        return None, None, bp_bundle

    # 스태프 주문인 경우 직배송 상품은 취급 안함
    if checkout.order_type != OrderType.BY_USER:
        return variant, None, None

    product = variant.product
    if product is None:
        raise ValidationError("상품 정보 오류 (2)")

    if checkout.user is None:
        raise ValidationError("체크아웃 정보 오류 (2)")

    if product.is_direct_shipping:
        region = checkout.user.region
        variant_region = get_product_variant_region(variant=variant, region=region)
    else:
        variant_region = None

    return variant, variant_region, None


def checkout_line_unit_price(
    checkout: "Checkout", line: "CheckoutLine", is_main_pv: bool = True
) -> Decimal:
    # 스태프 주문인 경우에는 일괄 등록 시 입력된 가격을 checkout_line 에 기록해 두었다가 그 값으로 판매가 계산
    # 가맹본부 대행 주문은 bpv 가격 사용
    bp_bundle: BpBundle = line.bp_bundle
    if (
        checkout.order_type != OrderType.BY_USER
        and checkout.order_type != OrderType.BY_HQ_STAFF_FOR_BRAND
    ):
        if bp_bundle:
            if is_main_pv:
                return line.price
            return Decimal(0)
        return line.price

    if bp_bundle:
        if is_main_pv:
            return bp_bundle.price_amount
        return Decimal(0)

    _, _, brand_product_variant, brand_product_variant_region, _ = get_brand_product_info(
        checkout, line
    )
    delivery_request_date = line.delivery_request_date
    if brand_product_variant_region:
        variant_price = brand_product_variant_region.get_price(delivery_request_date)
    elif brand_product_variant:
        variant_price = brand_product_variant.get_price(delivery_request_date)
    else:
        variant: ProductVariant = line.variant
        variant_price = variant.get_price(delivery_request_date)
    return variant_price.amount


def checkout_line_unit_price_vat(
    checkout: "Checkout", line: "CheckoutLine", is_main_pv: bool = True
) -> Decimal:
    # 스태프 주문인 경우에는 일괄 등록 시 입력된 가격을 checkout_line 에 기록해 두었다가 그 값으로 판매가 계산
    # 가맹본부 대행 주문은 bpv 가격 사용
    bp_bundle: BpBundle = line.bp_bundle
    if (
        checkout.order_type != OrderType.BY_USER
        and checkout.order_type != OrderType.BY_HQ_STAFF_FOR_BRAND
    ):
        if bp_bundle:
            if is_main_pv:
                return line.price_vat
            return Decimal(0)
        return line.price_vat

    if bp_bundle:
        if is_main_pv:
            return bp_bundle.price_vat
        return Decimal(0)

    _, _, brand_product_variant, brand_product_variant_region, _ = get_brand_product_info(
        checkout, line
    )
    if brand_product_variant_region:
        return brand_product_variant_region.price_vat
    if brand_product_variant:
        return brand_product_variant.price_vat
    variant: ProductVariant = line.variant
    return variant.price_vat


def base_checkout_line_total_decimal(
    checkout: "Checkout", line: "CheckoutLine", line_qty: Decimal = None
) -> Decimal:
    """Return the total price of this line."""

    bp_bundle: BpBundle = line.bp_bundle
    if bp_bundle:
        main_pv = bp_bundle.main_pv
        precision = main_pv.price_decimal_places
        unit_price = checkout_line_unit_price(checkout, line, True)
    else:
        variant: "ProductVariant" = line.variant
        precision = variant.price_decimal_places
        unit_price = checkout_line_unit_price(checkout, line)

    # TODO: 기타배송비를 상품가 토탈에 더할 경우 주문된 금액의 과세/면세 금액 계산 이슈가 있어서 분리 필요
    # 현재 Payment.tax , Payment.taxfree 는 이니시스 결제 시 tax, taxfree 값 전달용으로만 사용하고 있음
    apply_line_qty = line_qty if line_qty is not None else line.quantity
    amount = apply_line_qty * unit_price + line.etc_delivery_fee
    return quantize_price(amount, checkout.currency, precision=precision)


def base_checkout_line_total_taxed_money(checkout: "Checkout", line: "CheckoutLine") -> TaxedMoney:
    checkout_line_total_decimal = base_checkout_line_total_decimal(checkout, line)
    return TaxedMoney(net=checkout_line_total_decimal, gross=checkout_line_total_decimal)


def base_checkout_line_brand_total_cost_price_decimal(
    checkout: "Checkout", line: "CheckoutLine"
) -> Decimal:
    """Return the total cost price of this line."""

    checkout_line_qty = line.quantity
    bp_bundle: BpBundle = line.bp_bundle
    if bp_bundle:
        main_pv = bp_bundle.main_pv
        is_tax_free = main_pv.product.is_tax_free
        cost_price_include_vat = calc_to_include_vat(bp_bundle.cost_price_exclude_vat, is_tax_free)
        amount = checkout_line_qty * cost_price_include_vat
        precision = main_pv.price_decimal_places
        return quantize_price(amount, checkout.currency, precision=precision)

    _, _, brand_product_variant, brand_product_variant_region, _ = get_brand_product_info(
        checkout, line
    )
    variant: "ProductVariant" = line.variant
    is_tax_free = variant.product.is_tax_free
    delivery_request_date = line.delivery_request_date
    if brand_product_variant_region:
        variant_cost_price = brand_product_variant_region.get_cost_price(
            is_tax_free, delivery_request_date
        )
    elif brand_product_variant:
        variant_cost_price = brand_product_variant.get_cost_price(
            is_tax_free, delivery_request_date
        )
    else:
        variant_cost_price = variant.get_cost_price(is_tax_free, delivery_request_date)
    amount = checkout_line_qty * variant_cost_price.amount
    precision = variant.price_decimal_places
    return quantize_price(amount, checkout.currency, precision=precision)


def base_checkout_line_brand_total_delivery_fee(
    checkout: "Checkout", line: "CheckoutLine"
) -> Money:
    """Return the total delivery fee of this line."""
    checkout_line_qty = line.quantity
    bp_bundle: BpBundle = line.bp_bundle
    if bp_bundle:
        amount = Money(checkout_line_qty * bp_bundle.delivery_fee_amount, checkout.currency)
        return quantize_price(amount, amount.currency)

    _, _, brand_product_variant, brand_product_variant_region, _ = get_brand_product_info(
        checkout, line
    )
    variant: "ProductVariant" = line.variant
    delivery_request_date = line.delivery_request_date
    if brand_product_variant_region:
        variant_delivery_fee = brand_product_variant_region.get_delivery_fee(delivery_request_date)
    elif brand_product_variant:
        variant_delivery_fee = brand_product_variant.get_delivery_fee(delivery_request_date)
    else:
        variant_delivery_fee = variant.get_delivery_fee(delivery_request_date)
    amount = checkout_line_qty * variant_delivery_fee
    return quantize_price(amount, amount.currency)
