        if mode == VerifyOtpMode.INQUIRY_ID:
            check_empty_input_value(receiver_phone, RECEIVER_PHONE, "핸드폰 번호")
            try:
                users = models.User.objects.filter(aligo_phone=receiver_phone).exclude(
                    login_id__startswith=WITHDRAWN_USER_PREFIX
                )
                if len(users) <= 0:
                    raise ValidationError("입력한 정보와 일치하는 회원정보를 찾을 수 없습니다.")
                login_ids = []
                for user in users:
                    login_ids.append(user.login_id)
            except Exception:
                raise ValidationError("입력한 정보와 일치하는 회원정보를 찾을 수 없습니다.")
        elif mode == VerifyOtpMode.INQUIRY_PASSWORD:
            check_empty_input_value(login_id, "login_id", "로그인 아이디")
            check_empty_input_value(receiver_phone, RECEIVER_PHONE, "핸드폰 번호")
            try:
                user = models.User.objects.get(login_id=login_id, aligo_phone=receiver_phone)
                token = default_token_generator.make_token(user)
            except ObjectDoesNotExist:
                raise ValidationError("입력한 정보와 일치하는 회원정보를 찾을 수 없습니다.")
            except Exception:
                raise ValidationError("토큰 생성 실패")

        elif mode != VerifyOtpMode.SIGNUP:
            raise ValidationError("휴대폰 번호 인증에 실패했습니다. 고객센터에 문의해 주세요.")

        return cls(is_valid=verify_totp(otp), token=token, login_ids=login_ids)
