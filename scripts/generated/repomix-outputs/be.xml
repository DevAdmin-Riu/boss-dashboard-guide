@transaction.atomic()
def apply_change_price_target(change_price_base: ReserveChangePriceBase):
    details = ReserveChangePriceDetails.objects.filter(
        base_info=change_price_base, is_applied=False
    )
    timezone_now = timezone.now()
    check_date = change_price_base.reserved

    logger.info(f"apply_change_price_target details count: {len(details)}")
    for detail in details:
        variant = detail.product_variant
        product = variant.product
        try:
            brand = detail.brand
            region = detail.region
            is_direct_shipping = product.is_direct_shipping
            if is_direct_shipping:
                if brand is None:
                    update_object = ProductVariantRegion.objects.get(
                        product_variant=variant, region=region
                    )
                else:
                    brand_product_variant = BrandProductVariant.objects.get(
                        brand=brand, product_variant=variant
                    )
                    update_object = BrandProductVariantRegion.objects.get(
                        brand_product_variant=brand_product_variant, region=region
                    )
            else:
                if brand is None:
                    update_object = ProductVariant.objects.get(pk=variant.pk)
                else:
                    update_object = BrandProductVariant.objects.get(
                        brand=brand, product_variant=variant
                    )

            update_object.price_amount = detail.price_amount
            update_object.cost_price_exclude_vat = calc_to_exclude_vat(
                detail.cost_price_amount, product.is_tax_free
            )
            update_object.delivery_fee_amount = detail.delivery_fee_amount

            update_fields = [
                "price_amount",
                "cost_price_exclude_vat",
                "delivery_fee_amount",
            ]

            if check_date >= update_object.change_price_confirmed_date:
                update_object.change_price_amount = None
                update_object.change_cost_price_amount = None
                update_object.change_delivery_fee_amount = None
                update_object.change_price_confirmed_date = None

                update_fields.extend(
                    [
                        "change_price_amount",
                        "change_cost_price_amount",
                        "change_delivery_fee_amount",
                        "change_price_confirmed_date",
                    ]
                )

            update_object.save(update_fields=update_fields)
        except ObjectDoesNotExist:
            pass

        detail.is_applied = True
        detail.applied = timezone_now
        detail.save(update_fields=["is_applied", "applied"])

    change_price_base.is_applied = True
    change_price_base.applied = timezone_now
    change_price_base.save(update_fields=["is_applied", "applied"])


@app.task(name="product.tasks.change_brand_product_price")
def change_brand_product_price():
    check_date = kst_timezone_date()

    targets_qs = ReserveChangePriceBase.objects.filter(reserved=check_date, is_applied=False)
    targets = list(targets_qs)
    logger.info(f"apply_change_price_target count: {len(targets)}")

    exception_count = 0
    for target in targets:
        try:
            apply_change_price_target(target)
        except Exception as e:
            exception_count = exception_count + 1
            logger.error(f"change_brand_product_price error: {e}")

    if exception_count > 0:
        logger.error(f"change_brand_product_price exception_count: {exception_count}")


