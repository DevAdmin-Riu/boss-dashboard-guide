        )(qs, _, value)

    def filter_maker_search(qs, _, value):
        if value:
            prefix = MAKER_CODE_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        return qs.filter(maker_id=pk_value)
                    except:
                        raise ValidationError(f"제조사코드 형식을 확인해 주세요. {value}")

        search_fields = ["maker__name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_stock_availability(qs: "ProductVariantQueryset", _, value):
        if value:
            stock_availability = value
            qs = (
                qs.filter(sales_status=SalesStatus.ON_SALE)
                .filter(track_inventory=True)
                .filter(outer__isnull=True)
            )
            if stock_availability == StockAvailability.OUT_OF_STOCK:
                qs = filter_product_variants_by_stock_availability(qs, value)
            elif stock_availability == StockAvailability.OUT_OF_SAFETY_STOCK:
                qs = qs.filter(is_safety=False)
            elif stock_availability == StockAvailability.IN_OF_SAFETY_STOCK:
                qs = qs.filter(is_safety=True)
            elif stock_availability == StockAvailability.OUT_OF_ROP:
                qs = qs.filter(
                    Q(need_to_reorder_7=True)
                    | Q(need_to_reorder_15=True)
                    | Q(need_to_reorder_30=True)
                )
            elif stock_availability == StockAvailability.IN_OF_ROP:
                qs = qs.filter(
                    Q(need_to_reorder_7=False)
                    & Q(need_to_reorder_15=False)
                    & Q(need_to_reorder_30=False)
                )
            else:
                qs = qs.none()
        return qs

