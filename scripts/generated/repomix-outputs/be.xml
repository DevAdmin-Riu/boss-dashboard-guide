    name = models.CharField(max_length=250)
    slug = models.SlugField(max_length=255, unique=True, allow_unicode=True)
    description = models.TextField(blank=True)
    description_json = JSONField(blank=True, default=dict)
    parent = models.ForeignKey(
        "self", null=True, blank=True, related_name="children", on_delete=models.CASCADE
    )
    background_image = VersatileImageField(upload_to="category-backgrounds", blank=True, null=True)
    background_image_alt = models.CharField(max_length=128, blank=True)
    type = models.CharField(
        max_length=30,
        choices=CategoryType.choices,
        default=CategoryType.PACKAGING,
    )
    kind = models.CharField(
        max_length=30, choices=CategoryKind.choices, default=CategoryKind.STANDARD
    )

    # 한글자 코드. 제품의 코드를 생성할때 작성되며 수정되지 않는다.
    code = models.CharField(max_length=1, blank=True, null=True)

    shipment_inspection_file = models.FileField(
        upload_to=upload_to_for_category_shipment_inspection_file, null=True, blank=True
    )
    shipment_inspection_file_name = models.CharField(max_length=255, blank=True, null=True)

    objects = models.Manager()
    tree = TreeManager()

    def save(self, *args, **kwargs):
        if self.pk:
            # 아래 부분을 clean에 안넣은 이유는, CategoryCreate에서 하위 category일괄 save하는 부분이 있어서.(clean이 아니고 save에서 체크해야됨)
            variants = list(
                ProductVariant.objects.filter(product__category_id=self.pk).only(
                    "is_for_credits_refill", "is_dev_pv"
                )
            )

            if variants:
                is_for_credits_refill_values = {v.is_for_credits_refill for v in variants}
                is_dev_pv_values = {v.is_dev_pv for v in variants}

                if len(is_for_credits_refill_values) > 1:
                    raise ValidationError("is_for_credits_refill 값이 모두 동일하지 않습니다.")

                if len(is_dev_pv_values) > 1:
                    raise ValidationError("is_dev_pv 값이 모두 동일하지 않습니다.")

                if self.kind == CategoryKind.STANDARD:
                    if True in is_for_credits_refill_values or True in is_dev_pv_values:
                        raise ValidationError(
                            "STANDARD 카테고리는 모든 variant의 is_for_credits_refill, is_dev_pv가 False여야 합니다."
                        )
                elif self.kind == CategoryKind.CREDITS_REFILL:
                    if not (is_for_credits_refill_values == {True} and is_dev_pv_values == {False}):
                        raise ValidationError(
                            "POINTS_REFILL 카테고리는 is_for_credits_refill=True, is_dev_pv=False 여야 합니다."
                        )
                elif self.kind == CategoryKind.DEV:
                    if not (is_for_credits_refill_values == {False} and is_dev_pv_values == {True}):
                        raise ValidationError(
                            "DEV 카테고리는 is_for_credits_refill=False, is_dev_pv=True 여야 합니다."
                        )

        super().save(*args, **kwargs)

    class Meta:
        permissions = ((ProductPermissions.MANAGE_CATEGORY.codename, "카테고리 관리"),)
        constraints = [
            # 부모가 없는 경우 (parent IS NULL) → type + code 유니크
            UniqueConstraint(
                fields=["type", "code"],
                condition=Q(parent__isnull=True),
                name="unique_type_code_without_parent",
            ),
            # 부모가 있는 경우 (parent IS NOT NULL) → type + parent_id + code 유니크
            UniqueConstraint(
                fields=["type", "parent", "code"],
                condition=Q(parent__isnull=False),
                name="unique_type_parent_code",
            ),
        ]

    def __str__(self) -> str:
        return self.name


