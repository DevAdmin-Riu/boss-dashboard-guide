from collections import defaultdict

from django.db.models import Case, DecimalField, F, Q, Sum, Value, When
from django.db.models.functions import Coalesce

from ....purchaseorder import STOCKABLE_PO_EVENT_TYPES
from ....stats import PurchaseStatus, PurchaseType, models
from ...utils.filters import filter_by_query_param, filter_range_field
from ...vendor.utils import filter_vendor_search_factory
from .types import PoEventTypeEnum, PurchasesStatsByVendor


def resolve_purchases(_info, **_kwargs):
    qs = models.Purchase.objects.all()
    return qs.distinct()


def resolve_purchases_stats_by_vendor(_info, filter, **_kwargs):
    stat_date = filter.get("stat_date")
    is_b2b = filter.get("is_b2b")
    vendor_search = filter.get("vendor_search")
    pay_methods = filter.get("pay_methods")
    po_event_types = filter.get("po_event_types")
    vendor_contact_type = filter.get("vendor_contact_type")

    # FBV 제외 조건
    FBV_CONDITION = Q(variant__product__is_fulfilled_by_vendor=True)

    # 금액 집계용 Case/When 헬퍼 함수
    def create_purchase_sum(field_name, filter_condition):
        return Sum(
            Case(
                When(
                    type__in=[PurchaseType.TAKE_BACK, PurchaseType.CONSIGNMENT_TAKE_BACK],
                    then=-F(field_name),
                ),
                default=F(field_name),
                output_field=DecimalField(),
            ),
            filter=filter_condition,
        )

    qs = models.Purchase.objects.exclude(status=PurchaseStatus.CANCELED)

    # Note: Date filtering moved to individual aggregations for dual date criteria
    # - Total purchases: filtered by purchase_date (납품일)
    # - Closed purchases: filtered by purchase_close_date (마감일)

    if is_b2b is not None:
        qs = qs.filter(purchase_order__is_b2b=is_b2b)

    if vendor_search:
        qs = filter_vendor_search_factory(
            field_name="vendor_id",
            search_fields=["vendor__name"],
        )(qs, None, vendor_search)

    if pay_methods:
        qs = qs.filter(vendor__pay_method__in=pay_methods)

    if po_event_types:
        event_type_filter = Q()
        if PoEventTypeEnum.STOCKABLE_PO_EVENT_TYPES in po_event_types:
            event_type_filter |= Q(purchase_order__event_type__in=STOCKABLE_PO_EVENT_TYPES)
        if PoEventTypeEnum.NON_STOCKABLE_PO_EVENT_TYPES in po_event_types:
            event_type_filter |= ~Q(purchase_order__event_type__in=STOCKABLE_PO_EVENT_TYPES)
        qs = qs.filter(event_type_filter)

    # Filter by vendor contact type
    if vendor_contact_type:
        qs = qs.filter(vendor__contact_type__in=vendor_contact_type)

    qs = qs.annotate(
        purchase_amount_exclude_vat=(
            Coalesce(F("cost_price_exclude_vat"), Value(0))
            + Coalesce(F("dev_cost_exclude_vat"), Value(0))
            + Coalesce(F("etc_exclude_vat"), Value(0))
            + Coalesce(F("b2b_delivery_fee_exclude_vat"), Value(0))
            + (
                Coalesce(F("take_back_unit_cost_delivery_fee_exclude_vat"), Value(0))
                * Coalesce(F("purchase_order_line__quantity"), Value(0))
            )
        )
    )

    # Exclude FBV purchases
    qs = qs.exclude(FBV_CONDITION)

    # Build vendor maps after all filtering for efficiency
    vendor_ids = qs.values_list("vendor_id", flat=True).distinct()
    vendors = models.Vendor.objects.filter(id__in=vendor_ids)
    vendor_map = {v.id: v for v in vendors}

    purchase_event_types_qs = qs.values("vendor_id", "purchase_order__event_type").distinct()

    vendor_event_types_map = defaultdict(list)
    stockable_enums = set(STOCKABLE_PO_EVENT_TYPES)

    for item in purchase_event_types_qs:
        vendor_id = item["vendor_id"]
        event_type = item["purchase_order__event_type"]

        if vendor_id is None or event_type is None:
            continue

        # 중복을 피해 event type을 리스트에 추가합니다.
        if event_type in stockable_enums:
            if PoEventTypeEnum.STOCKABLE_PO_EVENT_TYPES not in vendor_event_types_map[vendor_id]:
                vendor_event_types_map[vendor_id].append(PoEventTypeEnum.STOCKABLE_PO_EVENT_TYPES)
        else:
            if (
                PoEventTypeEnum.NON_STOCKABLE_PO_EVENT_TYPES
                not in vendor_event_types_map[vendor_id]
            ):
                vendor_event_types_map[vendor_id].append(
                    PoEventTypeEnum.NON_STOCKABLE_PO_EVENT_TYPES
                )

    # Apply filter_range_field for total purchases (납품일 기준)
    total_purchases_qs = filter_range_field(qs, "purchase_date", stat_date) if stat_date else qs

    # Apply filter_range_field for closed purchases (마감일 기준)
    closed_purchases_qs = (
        filter_range_field(
            qs.filter(status=PurchaseStatus.CLOSED), "purchase_close_date", stat_date
        )
        if stat_date
        else qs.filter(status=PurchaseStatus.CLOSED)
    )

    # Filter 조건 준비
    total_filter = Q(id__in=total_purchases_qs.values("id"))
    closed_filter = Q(id__in=closed_purchases_qs.values("id"))

    vendor_stats = (
        qs.values(
            "vendor_id",
        )
        .order_by()
        .annotate(
            # --- 전체 매입 금액 집계 (납품일 기준) ---
            total_purchases_amount_exclude_vat=create_purchase_sum(
                "purchase_amount_exclude_vat", total_filter
            ),
            total_purchases_vat=create_purchase_sum("vat_amount", total_filter),
            # --- 마감 매입 금액 집계 (마감일 기준) ---
            total_closed_purchases_amount_exclude_vat=create_purchase_sum(
                "purchase_amount_exclude_vat", closed_filter
            ),
            total_closed_purchases_vat=create_purchase_sum("vat_amount", closed_filter),
        )
    )

    results = []
    for stats in vendor_stats:
        vendor_id = stats["vendor_id"]
        vendor = vendor_map.get(vendor_id)

        # Skip if vendor not found (data integrity check)
        if not vendor:
            continue

        total_excl_vat = stats["total_purchases_amount_exclude_vat"] or 0
        total_vat = stats["total_purchases_vat"] or 0
        total_closed_excl_vat = stats["total_closed_purchases_amount_exclude_vat"] or 0
        total_closed_vat = stats["total_closed_purchases_vat"] or 0

        po_event_types = vendor_event_types_map.get(vendor_id, [])

        # Calculate total amounts
        total_purchases_amount = total_excl_vat + total_vat
        total_closed_purchases_amount = total_closed_excl_vat + total_closed_vat

        # Skip vendors with both total and closed amounts = 0
        if total_purchases_amount == 0 and total_closed_purchases_amount == 0:
            continue

        results.append(
            PurchasesStatsByVendor(
                vendor_code=vendor.code,
                vendor_name=vendor.name,
                vendor_pay_method=vendor.pay_method,
                vendor_contact_type=vendor.contact_type,
                po_event_types=po_event_types,
                total_purchases_amount_exclude_vat=total_excl_vat,
                total_purchases_vat=total_vat,
                total_purchases_amount=total_purchases_amount,
                total_closed_purchases_amount_exclude_vat=total_closed_excl_vat,
                total_closed_purchases_vat=total_closed_vat,
                total_closed_purchases_amount=total_closed_purchases_amount,
            )
        )

    return results
