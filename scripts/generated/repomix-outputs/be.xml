class BatchPickingFilter(django_filters.FilterSet):
    def filter_batch_code(qs, _, value):
        if "-" in value:
            try:
                splits = value.split("-")
                batch_date = splits[0]
                sub_id = splits[1]
                return qs.filter(batch_date=batch_date, sub_id=sub_id)
            except:
                raise ValidationError(f"배치코드형식을 확인해 주세요. #{value}")
        else:
            raise ValidationError(f"배치코드형식을 확인해 주세요. #{value}")

    def filter_batch_date_range(qs, _, value):
        return filter_range_field(qs, "batch_date", value)

    def filter_need_to_tracking_number(qs, _, value):
        if value is not None:
            qs = qs.annotate(
                need_to_tracking_number_count=Count(
                    "fulfillments", filter=Q(fulfillments__tracking_number__exact="")
                ),
            )
            if value:
                qs = qs.filter(need_to_tracking_number_count__gt=0)
            else:
                qs = qs.filter(need_to_tracking_number_count=0)
        return qs

    def filter_warehouse_addresses(qs, _, value):
        if value:
            warehouse_addresses = get_nodes(value, "WarehouseAddress", AddressModel)
            qs = qs.filter(fulfillments__order__shipping_address__in=warehouse_addresses).distinct()
        return qs

    batch_code = django_filters.CharFilter(method=filter_batch_code)
    batch_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_batch_date_range)
    need_to_tracking_number = django_filters.BooleanFilter(method=filter_need_to_tracking_number)
    warehouse_addresses = GlobalIDMultipleChoiceFilter(method=filter_warehouse_addresses)
    id = GlobalIDFilter(field_name="id")

    class Meta:
        model = BatchPicking
        fields = []


