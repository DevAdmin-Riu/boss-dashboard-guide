    def resolve_number_of_req_boss_product(self, info, brand_id=None):
        if brand_id is None:
            qs = models.RequestBossProduct.objects.all()
        else:
            _, brand_id = graphene.Node.from_global_id(brand_id)
            qs = models.RequestBossProduct.objects.filter(brand_id=brand_id)
        results = qs.aggregate(
            request=Count(
                "id",
                filter=Q(
                    status__in=[
                        RequestBossProductStatus.REQUESTED,
                        RequestBossProductStatus.ACCEPTED,
                        RequestBossProductStatus.REQ_ADDITIONAL,
                    ]
                ),
            ),
            estimate=Count(
                "id",
                filter=Q(
                    status__in=[
                        RequestBossProductStatus.VENDOR_PRICE,
                        RequestBossProductStatus.BRAND_PRICE,
                        RequestBossProductStatus.REQ_ESTIMATE_FIX,
                    ]
                ),
            ),
            confirm=Count(
                "id",
                filter=Q(
                    status__in=[
                        RequestBossProductStatus.PENDING_CONFIRM,
                        RequestBossProductStatus.CONFIRMED,
                    ]
                ),
            ),
        )

        return NumberOfReqBossProduct(
            request=results["request"],
            estimate=results["estimate"],
            confirm=results["confirm"],
        )

