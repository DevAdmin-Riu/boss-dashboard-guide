class VendorFilter(django_filters.FilterSet):
    def filter_vendor_search(qs, _, value):
        return filter_vendor_search_factory(search_fields=["name"])(qs, _, value)

    def filter_is_active(qs, _, value):
        if value is not None:
            qs = qs.filter(is_active=value)
        return qs

    def filter_use_boss_product(qs, _, value):
        if value is not None:
            qs = qs.filter(use_boss_product=value)
        return qs

    def filter_use_b2b_product(qs, _, value):
        if value is not None:
            qs = qs.filter(use_b2b_product=value)
        return qs

    def filter_use_fbv_product(qs, _, value):
        if value is not None:
            qs = qs.filter(use_fbv_product=value)
        return qs

    def filter_fbv_brand(qs, _, value):
        if value:
            _, brand_id = graphene.Node.from_global_id(value)
            qs = qs.filter(fbv_brands_relation__brand_id=brand_id)

        return qs

    def filter_use_fbv_alarm(qs, _, value):
        if value is not None:
            qs = qs.filter(use_fbv_product=True, use_fbv_alarm=value)
        return qs

    def filter_is_created_staff_user(qs, _, value):
        if value == True:
            qs = qs.filter(vendor_staff_user__isnull=False)
        elif value == False:
            qs = qs.filter(vendor_staff_user__isnull=True)
        return qs

    def filter_is_direct_shipping(qs, _, value):
        if value == True:
            qs = qs.filter(is_direct_shipping=True)
        elif value == False:
            qs = qs.filter(is_direct_shipping=False)
        return qs

    def filter_biz_reg_no(qs, _, value):
        if value:
            normalized_value = remove_all_non_numeric(value)
            qs = qs.annotate(
                clean_biz_reg_no=RegexpReplace(
                    F("biz_reg_no"),
                    Value("[^0-9]"),  # 숫자가 아닌 모든 문자 제거
                    Value(""),
                )
            )
            return qs.filter(clean_biz_reg_no=normalized_value)
        return qs

    def filter_has_liability_insurance(qs, _, value):
        if value is not None:
            qs = qs.filter(has_liability_insurance=value)
        return qs

    def filter_use_po_email(qs, _, value):
        if value is not None:
            qs = qs.filter(use_po_email=value)
        return qs

    def filter_use_delegated_management_for_po(qs, _, value):
        if value is not None:
            qs = qs.filter(use_delegated_management_for_po=value)
        return qs

    def filter_use_auto_consignment_po(qs, _, value):
        if value is not None:
            qs = qs.filter(use_auto_consignment_po=value)
        return qs

    def filter_is_riu(qs, _, value):
        if value is not None:
            qs = qs.filter(is_riu=value)
        return qs

    vendor_search = django_filters.CharFilter(method=filter_vendor_search)

    is_active = django_filters.BooleanFilter(method=filter_is_active)
    use_boss_product = django_filters.BooleanFilter(method=filter_use_boss_product)
    use_b2b_product = django_filters.BooleanFilter(method=filter_use_b2b_product)
    use_fbv_product = django_filters.BooleanFilter(method=filter_use_fbv_product)
    fbv_brand = GlobalIDFilter(method=filter_fbv_brand)
    use_fbv_alarm = django_filters.BooleanFilter(method=filter_use_fbv_alarm)
    is_created_staff_user = django_filters.BooleanFilter(method=filter_is_created_staff_user)
    is_direct_shipping = django_filters.BooleanFilter(method=filter_is_direct_shipping)
    biz_reg_no = django_filters.CharFilter(method=filter_biz_reg_no)
    has_liability_insurance = django_filters.BooleanFilter(method=filter_has_liability_insurance)
    use_po_email = django_filters.BooleanFilter(method=filter_use_po_email)
    use_delegated_management_for_po = django_filters.BooleanFilter(
        method=filter_use_delegated_management_for_po
    )
    use_auto_consignment_po = django_filters.BooleanFilter(method=filter_use_auto_consignment_po)
    is_riu = django_filters.BooleanFilter(method=filter_is_riu)
    ids = GlobalIDMultipleChoiceFilter(field_name="id")

    class Meta:
        model = Vendor
        fields = []


class VendorFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = VendorFilter


class VendorHistoryFilter(django_filters.FilterSet):
    def filter_title(qs, _, value):
        search_fields = ["title"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

