    INSPECTED = "INSPECTED", "검수완료"
    STOCKED = "STOCKED", "입고완료"
    DELIVERED = "DELIVERED", "배송완료"
    CANCELED = "CANCELED", "취소"

    @classmethod
    def get_statuses_using_quantity(cls):
        return {cls.RECEIVED, cls.REQ_SPLIT_DELIVERY, cls.REQ_EPD_UPDATE}

    @classmethod
    def get_statuses_using_purchase_quantity(cls):
        return {
            cls.DISPATCH_FULFILLMENT,
            cls.PARTIALLY_DELIVERY_CONFIRMED,
            cls.DELIVERY_CONFIRMED,
            cls.INVOICE_PRINTED,
            cls.TO_BE_INSPECTED,
            cls.INSPECTED,
        }

    @classmethod
    def get_stockable_statuses(cls):
        return cls.get_statuses_using_quantity() | cls.get_statuses_using_purchase_quantity()

    @classmethod
    def get_already_stocked_statuses(cls):
        return {cls.STOCKED, cls.DELIVERED}

    # 위탁 발주서 상태가 출고지시 이후 단계인 경우
    @classmethod
    def get_consignment_after_fulfill_statuses(cls):
        return {
            cls.DISPATCH_FULFILLMENT,
            cls.PARTIALLY_DELIVERY_CONFIRMED,
            cls.DELIVERY_CONFIRMED,
            cls.INVOICE_PRINTED,
            cls.DELIVERED,
        }


STOCKABLE_STATUSES_USING_QUANITY = PurchaseOrderLineStatus.get_statuses_using_quantity()
STOCKABLE_STATUSES_USING_PURCHASE_QUANITY = (
    PurchaseOrderLineStatus.get_statuses_using_purchase_quantity()
)
STOCKABLE_STATUSES = PurchaseOrderLineStatus.get_stockable_statuses()
ALREADY_STOCKED_STATUSES = PurchaseOrderLineStatus.get_already_stocked_statuses()
CONSIGNMENT_AFTER_FULFILL_STATUSES = (
    PurchaseOrderLineStatus.get_consignment_after_fulfill_statuses()
)


