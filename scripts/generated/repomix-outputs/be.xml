    @transaction.atomic()
    def decrease_reverse_fee_deposit(
        self,
        *,
        reverse_fee_deposit_amount: int,
        event_type: "BrandReverseFeeDepositEventType",
        description: str,
        user: "User",
    ):

        from ..vendor import FbvPurchaseCostEventType
        from ..vendor.models import FbvPurchaseCostEvent, Vendor
        from ..vendor.utils import get_fbv_purchase_cost_remain_amount

        if self.is_reverse_fee_contract_type == False:
            raise ValidationError(
                "매출인식몰이 아닌 브랜드는 할수 없는 동작입니다.",
                code=AccountErrorCode.NOT_REVERSE_FEE_CONTRACT.value,
            )
        if (
            self.reverse_fee_deposit - reverse_fee_deposit_amount
            < self.reverse_fee_deposit_min_limitation
        ):
            raise ValidationError("외상 사용한도를 초과합니다.")

        qty_before = self.reverse_fee_deposit
        qty_after = self.reverse_fee_deposit - reverse_fee_deposit_amount
        self.reverse_fee_deposit = qty_after
        Brand.objects.filter(pk=self.pk).update(
            reverse_fee_deposit=F("reverse_fee_deposit") - reverse_fee_deposit_amount
        )

        # Vendor중 is_riu가 True인 Vendor를 가져온다.
        vendor_riu = Vendor.objects.filter(is_riu=True).first()

        amount_before = get_fbv_purchase_cost_remain_amount(self, vendor_riu)
        amount_after = amount_before + reverse_fee_deposit_amount

        # qty_after와 amount_after값의 절대값이 다른 경우 Error
        if abs(qty_after) != abs(amount_after):
            # error log만 남기고, ValidationError은 시스템 에러라고만 설명함.
            logging.error(
                f"qty_after와 amount_after값이 다릅니다. qty_after: {qty_after}, amount_after: {amount_after}"
            )
            raise ValidationError("시스템 에러입니다. 관리자에게 문의하세요.")

        event_type_mapping = {
            BrandReverseFeeDepositEventType.ORDER: FbvPurchaseCostEventType.PURCHASE,
            BrandReverseFeeDepositEventType.REFUND: FbvPurchaseCostEventType.REFUND,
            BrandReverseFeeDepositEventType.CANCEL_ORDER: FbvPurchaseCostEventType.CANCEL_ORDER,
            BrandReverseFeeDepositEventType.INCREASE_BY_ADMIN: FbvPurchaseCostEventType.DECREASE,
            BrandReverseFeeDepositEventType.DECREASE_BY_ADMIN: FbvPurchaseCostEventType.INCREASE,
            BrandReverseFeeDepositEventType.INCREASE: FbvPurchaseCostEventType.SETTLEMENT,
            BrandReverseFeeDepositEventType.INCREASE_BY_RCOINS: FbvPurchaseCostEventType.INCREASE_BY_RCOINS,
            BrandReverseFeeDepositEventType.DECREASE_BY_RCOINS: FbvPurchaseCostEventType.DECREASE_BY_RCOINS,
        }

        FbvPurchaseCostEvent.objects.create(
            user=user,
            brand=self,
            vendor=vendor_riu,
            amount=reverse_fee_deposit_amount,
            type=event_type_mapping.get(event_type, event_type),
            description=description,
            amount_before=amount_before,
            amount_after=amount_after,
        )

        return create_reverse_fee_deposit_event(
            qty_before=qty_before,
            qty_after=qty_after,
            qty=reverse_fee_deposit_amount,
            event_type=event_type,
            brand=self,
            description=description,
        )

