    class Meta:
        filterset_class = VendorHistoryFilter


class FbvPurchaseCostEventFilter(django_filters.FilterSet):
    def filter_type(qs, _, value):
        if value:
            return qs.filter(type__in=value)
        return qs

    def filter_created(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    type = ListObjectTypeFilter(input_class=FbvPurchaseCostEventTypeEnum, method=filter_type)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created)

