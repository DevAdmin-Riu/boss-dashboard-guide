from datetime import date

import graphene
from graphene_django.registry import get_global_registry

from ...bbs import models
from ...core.exceptions import PermissionDenied
from ...core.permissions import BbsPermissions
from ..core.mutations import BaseBulkMutation, ModelBulkDeleteMutation
from ..core.types.common import BbsError

registry = get_global_registry()


class NoticeBulkDelete(ModelBulkDeleteMutation):
    class Arguments:
        ids = graphene.List(graphene.ID, required=True, description="List of notice IDs to delete.")

    class Meta:
        description = "Deletes notices."
        model = models.Notice
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
            return True
        else:
            ids = data["ids"]
            instance_model = cls._meta.model
            model_type = registry.get_type_for_model(instance_model)
            notices = cls.get_nodes_or_error(ids, "id", model_type)

            for notice, node_id in zip(notices, ids):
                if not (notice.owner_brand_id == brand_id and is_active and is_hq_staff):
                    raise PermissionDenied(user=context.user, cls=cls)

            return True


class NoticeBulkPublish(BaseBulkMutation):
    class Arguments:
        ids = graphene.List(
            graphene.ID, required=True, description="List of notice IDs to (un)publish."
        )
        is_published = graphene.Boolean(
            required=True, description="Determine if notices will be published or not."
        )

    class Meta:
        description = "Publish notices."
        model = models.Notice
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def bulk_action(cls, queryset, is_published):
        if is_published:
            publication_date = date.today()
        else:
            publication_date = None
        queryset.update(is_published=is_published, publication_date=publication_date)

    @classmethod
    def check_permissions(cls, context, **data):
        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
            return True
        else:
            ids = data["ids"]
            instance_model = cls._meta.model
            model_type = registry.get_type_for_model(instance_model)
            notices = cls.get_nodes_or_error(ids, "id", model_type)

            for notice, node_id in zip(notices, ids):
                if not (notice.owner_brand_id == brand_id and is_active and is_hq_staff):
                    raise PermissionDenied(user=context.user, cls=cls)

            return True
