    is_tax_free = order_line.is_tax_free
    attribute_data = convert_to_simple_attribute(order_line.variant)

    # 직거래 상품은 리우가 가맹본부에서 매입해서 판매하는 것으로 고려하므로 가맹본부 판매가를 부가세 별도로 변환해서 저장
    unit_cost_price_exclude_vat = calc_to_exclude_vat(
        order_line.brand_unit_cost_price_amount, is_tax_free
    )

    parameters = {}
    parameters["product"] = make_product_parameters(
        product_name=order_line.product_name,
        variant_name=order_line.variant_name,
        quantity=quantity,
        unit_cost_price_exclude_vat=unit_cost_price_exclude_vat,
        is_tax_free=is_tax_free,
        attributes=attribute_data,
    )
    parameters["vendor"] = make_vendor_parameters(vendor)

    total_cost_price = order_line.brand_unit_cost_price_amount * quantity
    cost_price_exclude_vat = calc_to_exclude_vat(total_cost_price, is_tax_free)
    vat_amount = total_cost_price - cost_price_exclude_vat

    return Purchase(
        type=PurchaseType.FULFILLED_BY_VENDOR,
        purchase_date=kst_date(),
        user=requester,
        product_sku=order_line.product_sku,
        vat_amount=vat_amount,
        cost_price_exclude_vat=cost_price_exclude_vat,
        vendor=vendor,
        variant=order_line.variant,
        parameters=parameters,
    )


def calc_vat_amount_of_purchse(
    *,
    cost_price_exclude_vat: Decimal,
    is_tax_free: bool,
    is_take_back: bool,
    etc_exclude_vat: Decimal,
    dev_cost_exclude_vat: Decimal,
    take_back_total_delivery_fee_exclude_vat: Decimal,
    b2b_delivery_fee_exclude_vat: Decimal,
    price_decimal_places: int = 0,
):
    vat_target_amount_exclude_vat = (
        etc_exclude_vat
        + dev_cost_exclude_vat
        + take_back_total_delivery_fee_exclude_vat
        + b2b_delivery_fee_exclude_vat
    )
    if is_take_back:
        vat_target_amount_exclude_vat = -vat_target_amount_exclude_vat
    if is_tax_free == False:
        vat_target_amount_exclude_vat += cost_price_exclude_vat

    vat_amount = calc_vat_by_price_exclude_vat(
        vat_target_amount_exclude_vat, False, precision=price_decimal_places
    )
    return vat_amount


def _make_purchase_by_purchase_order(
    purchase_order: "PurchaseOrder",
    purchase_order_line: "PurchaseOrderLine",
):
    vendor = purchase_order.vendor
    purchase_type = purchase_order.event_type

    variant = purchase_order_line.variant
    stocked_quantity = purchase_order_line.purchase_quantity

    unit_cost_price_exclude_vat = purchase_order_line.cost_price_exclude_vat
    etc_exclude_vat = purchase_order_line.etc_exclude_vat
    b2b_delivery_fee_exclude_vat = purchase_order_line.b2b_delivery_fee_exclude_vat
    take_back_unit_cost_delivery_fee_exclude_vat = (
        purchase_order_line.take_back_unit_cost_delivery_fee_exclude_vat
    )

    is_take_back = purchase_order.is_take_back_po or purchase_order.is_consignment_take_back_po

    is_tax_free = purchase_order_line.is_tax_free
    price_decimal_places = variant.price_decimal_places
    if purchase_order.is_track_inventory_po:
        cost_price_exclude_vat = calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            unit_cost_price_exclude_vat,
            stocked_quantity,
            is_tax_free,
            precision=price_decimal_places,
        )
        dev_cost_exclude_vat = purchase_order_line.dev_cost_exclude_vat
    elif purchase_order.is_consignment_po:
        cost_price_exclude_vat = calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            unit_cost_price_exclude_vat,
            stocked_quantity,
            is_tax_free,
            precision=price_decimal_places,
        )
        dev_cost_exclude_vat = 0
    elif is_take_back:
        cost_price_exclude_vat = calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            unit_cost_price_exclude_vat,
            stocked_quantity,
            is_tax_free,
            precision=price_decimal_places,
        )
        dev_cost_exclude_vat = 0
    else:
        cost_price_exclude_vat = 0
        etc_exclude_vat = 0
        dev_cost_exclude_vat = 0

    # 위탁 반품인 경우에만 take_back_unit_cost_delivery_fee_exclude_vat 가 0 이 아닐 수 있음.
    take_back_total_delivery_fee_exclude_vat = calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
        take_back_unit_cost_delivery_fee_exclude_vat, stocked_quantity, False
    )

    if is_take_back:
        total_amount_exclude_vat = (
            cost_price_exclude_vat
            - etc_exclude_vat
            - dev_cost_exclude_vat
            - take_back_total_delivery_fee_exclude_vat
        )
    else:
        total_amount_exclude_vat = (
            cost_price_exclude_vat
            + etc_exclude_vat
            + dev_cost_exclude_vat
            + b2b_delivery_fee_exclude_vat
        )

    if total_amount_exclude_vat == 0:
        return None

    vat_amount = calc_vat_amount_of_purchse(
        cost_price_exclude_vat=cost_price_exclude_vat,
        is_tax_free=is_tax_free,
        is_take_back=is_take_back,
        etc_exclude_vat=etc_exclude_vat,
        dev_cost_exclude_vat=dev_cost_exclude_vat,
        take_back_total_delivery_fee_exclude_vat=take_back_total_delivery_fee_exclude_vat,
        b2b_delivery_fee_exclude_vat=b2b_delivery_fee_exclude_vat,
        price_decimal_places=price_decimal_places,
    )

    purchase_date = purchase_order_line.purchase_date
    user = purchase_order_line.purchase_user

    parameters = {}
    parameters["product"] = make_product_parameters(
        product_name=purchase_order_line.product_name,
        variant_name=purchase_order_line.variant_name,
        quantity=stocked_quantity,
        unit_cost_price_exclude_vat=unit_cost_price_exclude_vat,
        is_tax_free=is_tax_free,
        attributes=purchase_order_line.attribute_data,
        delivery_fee_exclude_vat=purchase_order_line.delivery_fee_exclude_vat,
    )
    parameters["vendor"] = make_vendor_parameters(vendor)

    return Purchase(
        type=purchase_type,
        purchase_date=purchase_date,
        user=user,
        product_sku=purchase_order_line.product_sku,
        vat_amount=vat_amount,
        cost_price_exclude_vat=cost_price_exclude_vat,
        dev_cost_exclude_vat=dev_cost_exclude_vat,
        etc_exclude_vat=etc_exclude_vat,
        b2b_delivery_fee_exclude_vat=b2b_delivery_fee_exclude_vat,
        purchase_order=purchase_order,
        purchase_order_line=purchase_order_line,
        vendor=vendor,
        variant=variant,
        parameters=parameters,
        take_back_unit_cost_delivery_fee_exclude_vat=take_back_unit_cost_delivery_fee_exclude_vat,
        consignment_unit_delivery_additional_fee_exclude_vat=purchase_order_line.consignment_unit_delivery_additional_fee_exclude_vat,
    )


def stock_purchase_order_stock_lines(
    user: "User",
    purchase_order: "PurchaseOrder",
    purchase_order_lines: List["PurchaseOrderLine"],
    stocked_quantity_list: List["int"],
    exp_date_list: List["Date"],
    rack_locations: List["RackLocation"],
    stocked_date: datetime.date,
):
    if len(purchase_order_lines) != len(stocked_quantity_list):
        logger.error(
            f"입고 제품 라인 개수와 입고 수량 정보가 불일치 합니다. {purchase_order_lines} {stocked_quantity_list}"
        )
        raise ValidationError("입고 제품 라인 개수와 입고 수량 정보가 불일치 합니다.")

    # 개발비 제품은 배송확정단계에서 거래명세서 출력으로 입고 처리되므로, before_status 가 일반 입고와 다름
    before_status_list = []
    for purchase_order_line, stocked_quantity in zip(purchase_order_lines, stocked_quantity_list):
        # 출고 지시 때 지정된 납품 수량을 변경 없이 입고 처리하고, 부분 입고 시스템은 제거되었으므로 입고 수량 누적하지 않고 실제 입고 수량으로 변경
        purchase_order_line.purchase_quantity = stocked_quantity
        purchase_order_line.purchase_date = stocked_date
        purchase_order_line.purchase_user = user
        before_status_list.append(purchase_order_line.status)
        purchase_order_line.status = PurchaseOrderLineStatus.STOCKED
        purchase_order_line.save(
            update_fields=["purchase_quantity", "purchase_date", "purchase_user", "status"]
        )
    bulk_create_po_line_status_histories(
        purchase_order_lines,
        before_status_list=before_status_list,
        after_status=PurchaseOrderLineStatus.STOCKED,
        user=user,
    )

    warehouse = purchase_order.warehouse
    if warehouse:
        if len(purchase_order_lines) != len(rack_locations):
            logger.error(
                f"입고 제품 라인 개수와 입고 위치 정보가 불일치 합니다. {purchase_order_lines} {rack_locations}"
            )
            raise ValidationError("입고 제품 라인 개수와 입고 위치 정보가 불일치 합니다.")

        for purchase_order_line, stocked_quantity, rack_location, exp_date in zip(
            purchase_order_lines, stocked_quantity_list, rack_locations, exp_date_list
        ):
            if rack_location is None:
                continue

            variant = purchase_order_line.variant
            cost_price_exclude_vat = purchase_order_line.cost_price_exclude_vat
            stock: Stock = variant.stocks.filter(
                warehouse=warehouse, product_variant=variant
            ).first()

            if stock is None:
                raise ValidationError(
                    f"제품의 재고 정보에 물류센터가 연결되어 있지 않습니다. {variant.sku}"
                )

            vendor_data = purchase_order.vendor_data
            vendor = purchase_order.vendor
            stock.increase_stock(stocked_quantity)
            try:
                stock_detail: StockDetail = purchase_order_line.stock_detail
            except Exception as E:
                stock_detail = None
            if stock_detail:
                # 부분 입고는 시스템으로 불가해서 이쪽으로는 실행될 일은 없음
                stock_detail.increase_remain_stock(stocked_quantity)
            else:
                stock_detail = StockDetail.objects.create(
                    stock=stock,
                    remain_quantity=stocked_quantity,
                    cost_price_exclude_vat=cost_price_exclude_vat,
                    vendor=vendor,
                    vendor_name=vendor_data["name"],
                    purchase_order_line=purchase_order_line,
                    stocked_at=to_datetime_astimezone(stocked_date),
                    exp_date=exp_date,
                    exp_date_status=get_exp_date_status(exp_date),
                )

            rack_stock_detail = RackStockDetail.objects.filter(
                location=rack_location, stock_detail=stock_detail
            ).first()
            if rack_stock_detail:
                rack_stock_detail.increase_remain_stock(stocked_quantity)
            else:
                RackStockDetail.objects.create(
                    location=rack_location,
                    product_variant=variant,
                    stock_detail=stock_detail,
                    remain_quantity=stocked_quantity,
                )

            create_purchase_stock_detail_event(
                stock,
                stock_detail,
                user=user,
                purchase_order_line=purchase_order_line,
                rack_location=rack_location,
                stocked_quantity=stocked_quantity,
            )

    return purchase_order_lines


