class UserManager(BaseUserManager):
    def create_user(
        self,
        login_id,
        email,
        password=None,
        is_staff=False,
        is_active=True,
        is_hq_staff=False,
        is_vendor_staff=False,
        **extra_fields,
    ):
        """Create a user instance with the given email and password."""
        email = UserManager.normalize_email(email)
        # Google OAuth2 backend send unnecessary username field
        extra_fields.pop("username", None)

        user = self.model(
            login_id=login_id,
            email=email,
            is_active=is_active,
            is_staff=is_staff,
            is_hq_staff=is_hq_staff,
            is_vendor_staff=is_vendor_staff,
            **extra_fields,
        )
        if password:
            user.set_password(password)
        user.save()
        return user

    def create_superuser(self, login_id, password=None, **extra_fields):
        return self.create_user(
            login_id=login_id,
            email=login_id,
            password=password,
            is_staff=True,
            is_superuser=True,
            is_hq_staff=False,
            is_vendor_staff=False,
            **extra_fields,
        )

    def customers(self):
        return self.get_queryset().filter((Q(is_staff=False) & Q(is_vendor_staff=False)))

    # deprecated Type의 loader 사용으로 변경 됨에 따라 아래는 더이상 사용하지 않음.
    def customers_for_download(self):
        from ..order.models import Order
        from ..vacs.models import RiuVact

        qs = self.get_queryset()
        order_qs = (
            Order.objects.filter(user=models.OuterRef("pk"))
            .values("user")
            .annotate(
                number_of_orders=models.Count("pk"),
                last_order_date=models.Max("created"),
                order_totals=models.Sum("total_gross_amount"),
            )
        )
        vact_qs = (
            RiuVact.objects.select_related("bank_code")
            .filter(user=models.OuterRef("pk"))
            .order_by("-pk")
        )
        qs = qs.annotate(
            number_of_orders=Coalesce(models.Subquery(order_qs.values("number_of_orders")), 0),
            last_order_date=models.Subquery(order_qs.values("last_order_date")),
            order_totals=Coalesce(models.Subquery(order_qs.values("order_totals")), 0),
            vact_acct_no=models.Subquery(vact_qs.values("acct_no")[:1]),
            vact_bank_name=models.Subquery(vact_qs.values("bank_code__bank_name")[:1]),
        )
        qs = qs.select_related("default_shipping_address", "brand")
        qs = qs.filter((Q(is_staff=False)) | (Q(is_staff=True) & Q(orders__isnull=False)))
        return qs

    def staff(self):
        return self.get_queryset().filter(is_staff=True)

    def hq_staff(self):
        return self.get_queryset().filter(is_hq_staff=True)

    def vendor(self):
        return self.get_queryset().filter(is_vendor_staff=True)


