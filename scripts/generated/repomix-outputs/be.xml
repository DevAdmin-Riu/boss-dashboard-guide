            qs = qs.filter(is_main_pv=value)
        return qs

    def filter_is_picking_order(qs, _, value):
        if value is not None:
            qs = qs.filter(is_picking_order=value)
        return qs

    def filter_fulfilled(qs, _, value):
        qs = qs.exclude(order__status=OrderStatus.CANCELED)
        if value is not None:
            qs = annotate_order_line_ordered_or_fulfill_qty(qs)
            if value == False:
                qs = qs.exclude(
                    ordered_or_fulfill_qty__lte=F("quantity_fulfilled") + F("quantity_refunded")
                )
            elif value == True:
                qs = qs.filter(
                    ordered_or_fulfill_qty__lte=F("quantity_fulfilled") + F("quantity_refunded")
                )
        return qs

    def filter_order_status(qs: OrderLineQueryset, _, value):
        query_objects = qs.none()

        valTmp = copy.deepcopy(value)
        if OrderStatusFilter.READY_TO_FULFILL in value:
            valTmp.remove(OrderStatusFilter.READY_TO_FULFILL)
        if OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED in value:
            valTmp.remove(OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED)

        if value:
            query_objects |= qs.filter(order__status__in=valTmp)

        if OrderStatusFilter.READY_TO_FULFILL in value:
            query_objects |= qs.ready_to_fulfill()

        if OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED in value:
            query_objects |= qs.ready_to_fulfill_plus_being_approved()

        return qs & query_objects

