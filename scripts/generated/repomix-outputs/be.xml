        return_field_name = "checkout"
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @staticmethod
    def get_pvs_and_bp_bundles_of_checkout_lines(cls, lines):
        bp_bundle_ids = [
            line.get("bp_bundle_id") for line in lines if line.get("bp_bundle_id") is not None
        ]
        variant_ids = [
            line.get("variant_id") for line in lines if line.get("variant_id") is not None
        ]
        brand_product_variant_ids = [
            line.get("brand_product_variant_id")
            for line in lines
            if line.get("brand_product_variant_id") is not None
        ]
        if bp_bundle_ids:
            bp_bundles = cls.get_nodes_or_error(
                bp_bundle_ids,
                "bp_bundle_id",
                BpBundle,
                qs=product_models.BpBundle.objects.prefetch_related("pvs"),
            )
        else:
            bp_bundles = []
        if variant_ids:
            variants = cls.get_nodes_or_error(
                variant_ids,
                "variant_id",
                ProductVariant,
                qs=product_models.ProductVariant.objects.select_related(
                    "product", "outer", "inner"
                ).prefetch_related("product__product_type"),
            )
        else:
            variants = []
        if brand_product_variant_ids:
            brand_product_variants = cls.get_nodes_or_error(
                brand_product_variant_ids, "brand_product_variant_id", BrandProductVariant
            )
        else:
            brand_product_variants = []
        bp_bundle_map = {str(obj.id): obj for obj in bp_bundles}
        variant_map = {str(obj.id): obj for obj in variants}
        bpv_map = {str(obj.id): obj for obj in brand_product_variants}
        pvs_by_input_sequence = []
        bpvs_by_input_sequence = []
        bp_bundles_by_input_sequence = []
        bp_names_by_input_sequence = []
        for line in lines:
            bp_bundle_id = line.get("bp_bundle_id")
            if bp_bundle_id:
                _, pk = graphene.Node.from_global_id(bp_bundle_id)
                bp_bundle: BpBundleModel = bp_bundle_map[pk]
                bp_bundles_by_input_sequence.append(bp_bundle)
                pvs_by_input_sequence.append(None)
                bpvs_by_input_sequence.append(None)
                bp_names_by_input_sequence.append(bp_bundle.name)
            else:
                bp_bundles_by_input_sequence.append(None)
                variant_id = line.get("variant_id")
                _, pk = graphene.Node.from_global_id(variant_id)
                pvs_by_input_sequence.append(variant_map[pk])
                bpv_id = line.get("brand_product_variant_id")
                if bpv_id:
                    _, pk = graphene.Node.from_global_id(bpv_id)
                    bpv: BrandProductVariantModel = bpv_map[pk]
                    bpvs_by_input_sequence.append(bpv_map[pk])
                    bp_names_by_input_sequence.append(bpv.brand_product.name)
                else:
                    bpvs_by_input_sequence.append(None)
                    bp_names_by_input_sequence.append(None)

        return (
            variants,
            bp_bundles,
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            bpvs_by_input_sequence,
            bp_names_by_input_sequence,
        )

    @classmethod
    def process_checkout_lines(cls, lines, country, user, order_type, delivery_method):
        (
            variants,
            bp_bundles,
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            _bpvs_by_input_sequence,
            _bp_names_by_input_sequence,
        ) = CheckoutCreateByStaff.get_pvs_and_bp_bundles_of_checkout_lines(cls, lines)
        quantities = [line.get("quantity") for line in lines]
        prices = [line.get("price") for line in lines]
        price_vat_list = [line.get("price_vat") for line in lines]
        calc_mileges = [line.get("calc_mileage") for line in lines]
        exclude_stock_avg_stats_list = [line.get("exclude_stock_avg_stats") for line in lines]
        decrease_stock_flags = [line.get("decrease_stock_flag") for line in lines]
        etc_delivery_fees = [line.get("etc_delivery_fee", 0) for line in lines]
        b2b_delivery_fees_exclude_vat = [
            line.get("b2b_delivery_fee_exclude_vat", 0) for line in lines
        ]

        validate_variants_on_sale(variants, user, pvs_by_input_sequence)
        validate_bp_bundles_on_sale(bp_bundles, user)
        check_lines_quantity(
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            quantities,
            country,
            order_type=order_type,
            delivery_method=delivery_method,
            decrease_stock_flags=decrease_stock_flags,
        )

        return (
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            quantities,
            prices,
            price_vat_list,
            calc_mileges,
            exclude_stock_avg_stats_list,
            decrease_stock_flags,
            etc_delivery_fees,
            b2b_delivery_fees_exclude_vat,
        )

    @classmethod
    def retrieve_shipping_address(cls, data: dict) -> Optional[models.Address]:
        address = data.get("shipping_address")
        if address is not None and address.country is not None:
            return cls.validate_address(address)
        return None

    @classmethod
    def clean_input(cls, info, instance: CheckoutModel, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)
        delivery_method = cleaned_input.get("delivery_method", OrderDeliveryMethods.BY_COURIER)
        cleaned_input["delivery_method"] = delivery_method
        fulfill_type = cleaned_input.get("fulfill_type", FulfillType.AS_IS)
        cleaned_input["fulfill_type"] = fulfill_type
        order_type = cleaned_input.get("order_type")
        user = instance.user
        country = info.context.country.code

        # set country to one from shipping address
        shipping_address = cleaned_input.get("shipping_address")
        if shipping_address and shipping_address.country:
            if shipping_address.country != country:
                country = shipping_address.country
        cleaned_input["country"] = country

        # Resolve and process the lines, retrieving the variants and quantities
        lines = data.pop("lines", None)
        if lines:
            (
                cleaned_input["pvs_by_input_sequence"],
                cleaned_input["bp_bundles_by_input_sequence"],
                cleaned_input["quantities"],
                cleaned_input["prices"],
                cleaned_input["price_vat_list"],
                cleaned_input["calc_mileages"],
                cleaned_input["exclude_stock_avg_stats_list"],
                cleaned_input["decrease_stock_flags"],
                cleaned_input["etc_delivery_fees"],
                cleaned_input["b2b_delivery_fees_exclude_vat"],
            ) = cls.process_checkout_lines(lines, country, user, order_type, delivery_method)

        # alt_invoicee_biz_info에서 숫자를 제외한 모든 문자를 제거한다.
        alt_invoicee_biz_info = cleaned_input.get("alt_invoicee_biz_info")
        if alt_invoicee_biz_info:
            if alt_invoicee_biz_info.get("biz_reg_no"):
                biz_reg_no = "".join(filter(str.isdigit, alt_invoicee_biz_info["biz_reg_no"]))
                if len(biz_reg_no) != 10:
                    raise ValidationError("사업자등록번호는 숫자 10자리여야 합니다.")
                alt_invoicee_biz_info["biz_reg_no"] = biz_reg_no
            cleaned_input["alt_invoicee_biz_info"] = alt_invoicee_biz_info

        cleaned_input["shipping_address"] = cls.retrieve_shipping_address(data)
        return cleaned_input

    @classmethod
    def save_addresses(cls, instance: CheckoutModel, cleaned_input: dict):
        shipping_address = cleaned_input.get("shipping_address")

        updated_fields = ["last_change"]

        if shipping_address:
            shipping_address.save()
            instance.shipping_address = shipping_address.get_copy()
            updated_fields.append("shipping_address")

        # Note django will simply return if the list is empty
        instance.save(update_fields=updated_fields)

    @classmethod
    @transaction.atomic()
    def save(cls, info, instance: CheckoutModel, cleaned_input):
        # Create the checkout object
        instance.save()
        country = cleaned_input["country"]
        instance.set_country(country, commit=True)

        # Retrieve the lines to create
        pvs_by_input_sequence = cleaned_input.get("pvs_by_input_sequence")
        bp_bundles_by_input_sequence = cleaned_input.get("bp_bundles_by_input_sequence")
        quantities = cleaned_input.get("quantities")
        prices = cleaned_input.get("prices")
        price_vat_list = cleaned_input.get("price_vat_list")
        calc_mileages = cleaned_input.get("calc_mileages")
        exclude_stock_avg_stats_list = cleaned_input.get("exclude_stock_avg_stats_list")
        decrease_stock_flags = cleaned_input.get("decrease_stock_flags")
        etc_delivery_fees = cleaned_input.get("etc_delivery_fees")
        b2b_delivery_fees_exclude_vat = cleaned_input.get("b2b_delivery_fees_exclude_vat")

        for (
            variant,
            bp_bundle,
            quantity,
            price,
            price_vat,
            calc_mileage,
            exclude_stock_avg_stats,
            decrease_stock_flag,
            etc_delivery_fee,
            b2b_delivery_fee_exclude_vat,
        ) in zip(
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            quantities,
            prices,
            price_vat_list,
            calc_mileages,
            exclude_stock_avg_stats_list,
            decrease_stock_flags,
            etc_delivery_fees,
            b2b_delivery_fees_exclude_vat,
        ):
            add_pv_or_bp_bundle_to_checkout(
                instance,
                variant,
                bp_bundle,
                quantity,
                price,
                price_vat,
                calc_mileage,
                exclude_stock_avg_stats,
                decrease_stock_flag,
                etc_delivery_fee,
                b2b_delivery_fee_exclude_vat,
            )
        info.context.plugins.checkout_quantity_changed(instance)
        # Save provided addresses and associate them to the checkout
        cls.save_addresses(instance, cleaned_input)

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        order_type = input_data.get("order_type")
        user: UserModel = None
        if order_type in ORDER_TYPES_WITH_BRAND_USER:
            customer_login_id = input_data.get("customer_login_id")
            if customer_login_id:
                try:
                    input_data.pop("customer_login_id")
                    user = account_models.User.objects.get(login_id=customer_login_id)
                except ObjectDoesNotExist:
                    raise ValidationError("대행주문: 매장 로그인 id 오류입니다.")
            else:
                raise ValidationError("대행주문: 매장 로그인 id가 입력되지 않았습니다.")

        checkout = CheckoutModel(user=user)

        cleaned_input = cls.clean_input(info, checkout, input_data)
        checkout = cls.construct_instance(info, checkout, cleaned_input)
        cls.clean_instance(info, checkout)
        cls.save(info, checkout, cleaned_input)
        cls._save_m2m(info, checkout, cleaned_input)
        info.context.plugins.checkout_created(checkout)
        return CheckoutCreateByStaff(checkout=checkout, created=True)


class PickingOrderInput(graphene.InputObjectType):
    checkout_id = graphene.ID(required=True, description="The ID of the checkout.")
