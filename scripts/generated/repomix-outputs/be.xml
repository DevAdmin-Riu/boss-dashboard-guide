from collections import defaultdict
from dataclasses import dataclass
from typing import Dict, List, Optional

from ..graphql.purchaseorder.filters import filter_to_be_stocked_by_purchase_order_lines_qs
from ..order.models import OrderLine
from ..product.models import ProductVariant, ProductVariantVendor
from ..vendor.models import Vendor
from . import STOCKABLE_STATUSES_USING_PURCHASE_QUANITY, STOCKABLE_STATUSES_USING_QUANITY
from .models import PurchaseOrder, PurchaseOrderLine


@dataclass
class ClosestToBeStockedInfo:
    closest_to_be_stocked_date: str
    closest_to_be_stocked_qty: int


def get_to_be_stocked_qty_by_po_line(po_line: PurchaseOrderLine) -> int:
    if po_line.status in STOCKABLE_STATUSES_USING_QUANITY:
        return int(po_line.quantity)
    if po_line.status in STOCKABLE_STATUSES_USING_PURCHASE_QUANITY:
        return int(po_line.purchase_quantity)
    return 0


def get_closest_to_be_stocked_po_line(variant: ProductVariant) -> Optional[PurchaseOrderLine]:
    po_line_qs = variant.purchase_order_lines.all()
    to_be_stocked_po_line_qs = filter_to_be_stocked_by_purchase_order_lines_qs(po_line_qs)
    closest_to_be_stocked_po_line: PurchaseOrderLine = to_be_stocked_po_line_qs.order_by(
        "-expected_purchase_date"
    ).first()
    return closest_to_be_stocked_po_line


def get_closest_to_be_stocked_info(variant: ProductVariant) -> ClosestToBeStockedInfo:
    po_line: PurchaseOrderLine = get_closest_to_be_stocked_po_line(variant)
    if po_line is None:
        return ClosestToBeStockedInfo(closest_to_be_stocked_date="-", closest_to_be_stocked_qty="-")
    return ClosestToBeStockedInfo(
        closest_to_be_stocked_date=po_line.expected_purchase_date.strftime("%Y-%m-%d"),
        closest_to_be_stocked_qty=get_to_be_stocked_qty_by_po_line(po_line),
    )


def make_order_lines_group_by_vendor(
    order_lines: List[OrderLine],
) -> Dict[Vendor, List[OrderLine]]:
    order_lines_group_by_vendor = defaultdict(list)
    for order_line in order_lines:
        variant: ProductVariant = order_line.variant
        default_variant_vendor: ProductVariantVendor = (
            variant.default_variant_vendor if variant else None
        )
        vendor = default_variant_vendor.vendor if default_variant_vendor else None
        if vendor:
            order_lines_group_by_vendor[vendor].append(order_line)
    return order_lines_group_by_vendor


def make_order_lines_group_by_order(
    order_lines: List[OrderLine],
) -> Dict[Vendor, List[OrderLine]]:
    order_lines_group_by_order = defaultdict(list)
    for order_line in order_lines:
        order = order_line.order
        order_lines_group_by_order[order].append(order_line)
    return order_lines_group_by_order


def make_po_lines_group_by_vendor(
    po_lines: List[PurchaseOrderLine],
) -> Dict[Vendor, List[PurchaseOrderLine]]:
    po_lines_group_by_vendor = defaultdict(list)
    for po_line in po_lines:
        vendor = po_line.purchase_order.vendor
        po_lines_group_by_vendor[vendor].append(po_line)
    return po_lines_group_by_vendor


def make_track_or_consignment_url_path(
    purchase_order: PurchaseOrder,
):
    is_consignment = purchase_order.is_consignment_po or purchase_order.is_consignment_take_back_po
    track_or_consignment_url = "consignment" if is_consignment else "track-inventory"
    return track_or_consignment_url


def make_b2b_url_path(
    is_b2b: bool,
):
    if is_b2b:
        return "/b2b"
    return ""
