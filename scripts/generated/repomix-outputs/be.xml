from datetime import datetime

from django.conf import settings
from django.contrib.postgres.fields.jsonb import KeyTextTransform
from django.db.models import Q, TextField
from django.db.models.functions import Cast
from pytz import timezone

from ..core.enums import ReportingPeriod


def make_query_objects_by_query_param(queryset, query_value, search_fields):
    model = queryset.model
    query_objects = Q()
    for field in search_fields:
        # JSONField 내부 접근 추정
        if "__" in field:
            try:
                top_field, sub_field = field.split("__", 1)
                model_field = model._meta.get_field(top_field)
            except Exception:
                model_field = None
            if (
                model_field
                and hasattr(model_field, "get_internal_type")
                and model_field.get_internal_type() == "JSONField"
            ):
                # JSONField인 경우: annotate 후 필터
                annotated_field = f"{top_field}_{sub_field}_text"
                queryset = queryset.annotate(
                    **{
                        annotated_field: Cast(
                            KeyTextTransform(sub_field, top_field), output_field=TextField()
                        )
                    }
                )
                query_objects |= Q(**{f"{annotated_field}__contains": query_value})
                continue  # 다음 필드로
        query_objects |= Q(**{f"{field}__contains": query_value})
    return queryset, query_objects


def make_query_objects_by_pk_fields(queryset, query_value, pk_fields):
    query_objects = Q()
    for field in pk_fields:
        query_objects |= Q(**{f"{field}": query_value})
    return queryset, query_objects


def filter_by_query_param(queryset, query, search_fields):
    """Filter queryset according to given parameters.

    Keyword Arguments:
        queryset - queryset to be filtered
        query - search string (which may contain multiple values separated by '\n')
        search_fields - fields considered in filtering
    """
    if not query:
        return queryset

    # 엔터를 포함하는 경우 여러 개의 값으로 분리
    query_values = [q.strip() for q in query.split("\n") if q.strip()]

    # 엔터가 없는 일반 검색일 경우 기존 방식 적용
    if len(query_values) == 1:
        queryset, query_objects = make_query_objects_by_query_param(
            queryset, query_values[0], search_fields
        )
        return queryset.filter(query_objects).distinct()

    # 엔터가 포함된 경우 WHERE IN 조건을 적용
    query_objects = Q()
    for field in search_fields:
        query_objects |= Q(**{f"{field}__in": query_values})

    return queryset.filter(query_objects).distinct()


def filter_pk_fields(queryset, query, pk_fields):
    """Filter queryset according to given parameters.

    Keyword Arguments:
        queryset - queryset to be filtered
        query - search string (which may contain multiple values separated by '\n')
        pk_fields - fields considered in filtering (exact equal)
    """
    if not query:
        return queryset

    # 엔터를 포함하는 경우 여러 개의 값으로 분리
    query_values = [q.strip() for q in query.split("\n") if q.strip()]

    # 엔터가 없는 일반 검색일 경우 기존 방식 적용
    if len(query_values) == 1:
        queryset, query_objects = make_query_objects_by_pk_fields(
            queryset, query_values[0], pk_fields
        )
        return queryset.filter(query_objects).distinct()

    # 엔터가 포함된 경우 WHERE IN 조건을 적용
    query_objects = Q()
    for field in pk_fields:
        query_objects |= Q(**{f"{field}__in": query_values})

    return queryset.filter(query_objects).distinct()


def reporting_period_to_date(period):
    tz = timezone(settings.TIME_ZONE)
    now = datetime.now(tz=tz)
    if period == ReportingPeriod.TODAY:
        start_date = now.replace(hour=0, minute=0, second=0, microsecond=0)
    elif period == ReportingPeriod.THIS_MONTH:
        start_date = now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    else:
        raise ValueError("Unknown period: %s" % period)
    return start_date


def filter_by_period(queryset, period, field_name):
    start_date = reporting_period_to_date(period)
    return queryset.filter(**{"%s__gte" % field_name: start_date})


def filter_range_field(qs, field, value):
    gte, lte, gt, lt = value.get("gte"), value.get("lte"), value.get("gt"), value.get("lt")
    if gte:
        lookup = {f"{field}__gte": gte}
        qs = qs.filter(**lookup)
    if lte:
        lookup = {f"{field}__lte": lte}
        qs = qs.filter(**lookup)
    if gt:
        lookup = {f"{field}__gt": gt}
        qs = qs.filter(**lookup)
    if lt:
        lookup = {f"{field}__lt": lt}
        qs = qs.filter(**lookup)
    return qs


def filter_overlap_range_field(qs, start_field, end_field, value):
    """
    주어진 기간(value: {"gte": 시작일, "lte": 종료일})과
    모델의 (start_field, end_field)가 겹치는 레코드만 필터링
    """
    gte, lte = value.get("gte"), value.get("lte")
    if gte:
        qs = qs.filter(**{f"{end_field}__gte": gte})
    if lte:
        qs = qs.filter(**{f"{start_field}__lte": lte})
    return qs
