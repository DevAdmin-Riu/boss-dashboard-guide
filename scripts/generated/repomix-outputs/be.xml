            box_height = detail.get("box_height")
            if box_height is not None:
                pv.box_height = box_height
            sales_status = detail.get("sales_status")
            if sales_status is not None:
                pv.sales_status = sales_status
                # 제품 상태를 정상으로 변경할 때 판매개시일이 null 이면 현재 날짜를 판매개시일로 처리
                if pv.first_available_for_purchase is None and sales_status == SalesStatus.ON_SALE:
                    pv.first_available_for_purchase = kst_timezone_date()

            product = pv.product
            if product.product_type.has_variants == False:
                product_name = normalize_newlines_to_space(detail.get("product_name"))
