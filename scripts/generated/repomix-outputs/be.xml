class RackLocationSortField(graphene.Enum):
    NAME = ["sector__name", "name", "pk"]

    @property
    def description(self):
        if self.name in RackLocationSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Rack stock detail events by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_sector_name(qs: QuerySet) -> QuerySet:
        return qs.select_related("sector")


class RackLocationSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = RackLocationSortField
        type_name = "rack location"


class RackStockDetailSortField(graphene.Enum):
    REMAIN_QUANTITY = ["remain_quantity", "pk"]
    SKU = ["product_variant__sku", "remain_quantity", "pk"]
    LOCATION_NAME = ["location__name", "remain_quantity", "pk"]
    STOCKED_AT = ["stock_detail_stocked_at", "remain_quantity", "pk"]
    EXP_DATE = ["stock_detail_exp_date", "remain_quantity", "pk"]

    @property
    def description(self):
        if self.name in RackStockDetailSortField.__enum__._member_names_:
            sort_name = self.name.lower().replace("_", " ")
            return f"Rack stock detail by {sort_name}."
        raise ValueError("Unsupported enum value: %s" % self.value)

    @staticmethod
    def qs_with_sku(qs: QuerySet) -> QuerySet:
        return qs.select_related("product_variant")

    @staticmethod
    def qs_with_location_name(qs: QuerySet) -> QuerySet:
        return qs.select_related("location")

    @staticmethod
    def qs_with_stocked_at(qs: QuerySet) -> QuerySet:
        return qs.select_related("stock_detail").annotate(
            stock_detail_stocked_at=Max("stock_detail__stocked_at")
        )

    @staticmethod
    def qs_with_exp_date(qs: QuerySet) -> QuerySet:
        return qs.select_related("stock_detail").annotate(
            stock_detail_exp_date=Max("stock_detail__exp_date")
        )


class RackStockDetailSortingInput(SortInputObjectType):
    class Meta:
        sort_enum = RackStockDetailSortField
        type_name = "rack stock detail"
