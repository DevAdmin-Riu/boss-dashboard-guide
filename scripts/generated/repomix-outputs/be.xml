    # 패키지 판매여부(BrandProductVariant처럼 복잡하게 필요 없음.)
    visible = models.BooleanField(default=False)
    # 보스몰에서 화물차 배송방법 선택 시 부과되는 화물차 배송비로 아래 공식으로 계산된 값을 저장해 둠
    #    = 대시보드 화물차 배송비 입력값(etc_delivery_origin_fee) - 패키지에 포함된 모든 상품의 브랜드 배송비 총합
    # 위 계산식 값이 음수가 되는 경우 0원 처리되어 저장됨
    etc_delivery_fee = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
    # 대시보드 화물차 배송비 입력값
    etc_delivery_origin_fee = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
    # 보스몰에서 화물차 배송방법 선택 시 부과되는 도서산간지역 추가 요금
    # 택뱅배송은 사이트 설정 도서산간지역 추가요금을 박스별로 부과하므로 이 값은 화물차 배송에만 사용됨
    additional_fee_for_etc_delivery = models.IntegerField(default=0)
    thumbnail_image = VersatileImageField(
        upload_to=upload_to_for_brand_package_thumbnail_image, blank=True, null=True
    )
    detail_image = VersatileImageField(
        upload_to=upload_to_for_brand_package_detail_image, blank=True, null=True
    )
    brand_product_variants = models.ManyToManyField(
        "BrandProductVariant",
        through="BrandProductVariantPackageInfo",
        related_name="brand_product_packages",
    )
    is_by_courier_allowed = models.BooleanField(default=True)
    is_by_truck_service_allowed = models.BooleanField(default=True)

    objects = BrandProductPackageQueryset.as_manager()

    @property
    def brand_product_variant_package_info(self):
        return self.brand_product_variant_package_infos.select_related(
            "brand_product_variant"
        ).all()

    @property
    def total_price_wo_etc_delivery_fee(self):
        return sum(
            [
                info.brand_product_variant.price_amount * info.quantity
                for info in self.brand_product_variant_package_info
            ]
        )

    @property
    def calculated_etc_delivery_fee(self):
        return self.etc_delivery_origin_fee - sum(
            [
                info.brand_product_variant.delivery_fee_amount * info.quantity
                for info in self.brand_product_variant_package_info
            ]
        )

    def update_and_save_etc_delivery_fee(self):
        self.etc_delivery_fee = (
            self.calculated_etc_delivery_fee if self.calculated_etc_delivery_fee > 0 else 0
        )
        self.save(update_fields=["etc_delivery_fee"])


