        super().clean_instance(info, instance)
        if cls == BrandFbvSettlementCreate or cls == BrandFbvSettlementBulkCreate:
            if (
                instance.brand.settlement_account_info is None
                or instance.brand.settlement_account_info == {}
            ):
                # 여러개가 들어온 BulkCreate의 경우 그중에 에러가 난 brand의 이름들을 모아서 clean_instance 밖에서 처리해줘야 한다.
                if cls == BrandFbvSettlementBulkCreate:
                    error_brand_name = instance.brand.name
                    return error_brand_name
                raise ValidationError(
                    "직거래 상품 정산 정보가 없습니다. 브랜드 상세 페이지에서 입력해주세요.",
                )

    @classmethod
    def post_save_action(cls, info, instance: BrandFbvSettlementModel, cleaned_input):
        if cls == BrandFbvSettlementCreate or cls == BrandFbvSettlementBulkCreate:
            brand = instance.brand
            brand_name = brand.name
            recipient_list = get_brand_accounting_person_email_list(brand)
            date_str = BrandFbvSettlementCreate.make_settlement_date(instance.date)
            transaction.on_commit(
