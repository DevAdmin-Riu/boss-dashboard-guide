@transaction_with_commit_on_errors()
def handle_webhook(request: WSGIRequest, gateway_config: "GatewayConfig"):
    if request.get_full_path().find("/request") != -1:
        return handle_request(request, gateway_config)

    if request.get_full_path().find("/openInicisModule") != -1:
        return handle_openInicisModule(request, gateway_config)

    if request.get_full_path().find("/return") != -1:
        return handle_return(request, gateway_config)

    if request.get_full_path().find("/close") != -1:
        return handle_parent_window_close()

    if request.get_full_path().find("/mreturn") != -1:
        return handle_mreturn(request, gateway_config)

    if request.get_full_path().find("/vbank") != -1:
        return handle_vbank(request, gateway_config)

    if request.get_full_path().find("/mvbank") != -1:
        return handle_mvbank(request, gateway_config)

    raise Http404("path does not exist")


def handle_request(request: WSGIRequest, gateway_config: "GatewayConfig"):
    checkout_id = request.GET.get("id")
    product_names = request.GET.get("names")
    method = request.GET.get("method")

    payment = get_inicis_payment(checkout_id)

    logger.info(f"payment_debug: handle_request {payment} {checkout_id}")

    if not payment:
        return HttpResponseBadRequest("Inicis: Payment not exists")

    checkout = get_checkout(payment)
    if not checkout:
        return HttpResponseBadRequest("Inicis: Checkout not exists")

    user_agent = request.META.get("HTTP_USER_AGENT", None)
    if user_agent is None:
        return HttpResponseBadRequest("Inicis: There is no user agent")

    brand = checkout.user.brand if checkout.user else None
    try:
        validate_brand_pg_info(payment.gateway, brand)
    except ValidationError as e:
        return HttpResponseBadRequest(e.message)
    plugin_configs = get_inicis_plugin_configs(gateway_config)
    plugin_configs = change_inicis_plugin_configs(plugin_configs, brand)
    if not plugin_configs:
        return HttpResponseBadRequest("Inicis: Plugin configs not exists")

    keywords = ["Mobile", "Opera Mini", "Android"]
    is_mobile = False
    if any(word in user_agent for word in keywords):
        is_mobile = True

    if is_mobile:
        params = make_inicis_params_for_mobile(
            plugin_configs=plugin_configs,
            payment=payment,
            checkout=checkout,
            method=method,
            product_names=product_names,
        )
    else:
        params = make_inicis_params_for_pc(
            plugin_configs=plugin_configs,
            payment=payment,
            checkout=checkout,
            pay_method=method,
            product_names=product_names,
            checkout_id=checkout_id,
        )

    return JsonResponse(params, safe=False)


def handle_openInicisModule(request: WSGIRequest, gateway_config: "GatewayConfig"):
    checkout_id = request.GET.get("id")
    product_names = request.GET.get("names")
    method = request.GET.get("method")

    payment = get_inicis_payment(checkout_id)
    if not payment:
        return HttpResponseBadRequest("Inicis: Payment not exists")

    checkout = get_checkout(payment)
    if not checkout:
        return HttpResponseBadRequest("Inicis: Checkout not exists")

    brand = checkout.user.brand if checkout.user else None
    try:
        validate_brand_pg_info(payment.gateway, brand)
    except ValidationError as e:
        return HttpResponseBadRequest(e.message)
    plugin_configs = get_inicis_plugin_configs(gateway_config)
    plugin_configs = change_inicis_plugin_configs(plugin_configs, brand)
    if not plugin_configs:
        return HttpResponseBadRequest("Inicis: Plugin configs not exists")

    params = make_inicis_params_for_pc(
        plugin_configs=plugin_configs,
        payment=payment,
        checkout=checkout,
        pay_method=method,
        product_names=product_names,
        checkout_id=checkout_id,
    )
    context = {"params": params}

    if plugin_configs.is_prod_mode:
        return render(request, "inicis.html", context)
    return render(request, "inicis_dev.html", context)


# https://manual.inicis.com/pay/stdpay_pc.html
def handle_return(request: WSGIRequest, gateway_config: GatewayConfig):
    # Parse data
    result_code = request.POST.get("resultCode")
    result_msg = request.POST.get("resultMsg")
    payment_id = request.POST.get("orderNumber")
    auth_token = request.POST.get("authToken")
    auth_url = request.POST.get("authUrl")
    net_cancel_url = request.POST.get("netCancelUrl")
    merchant_id = request.POST.get("mid")

    # Prepare for the next auth request
    timestamp = str(math.trunc(time.time() * 1000))
    signature = "authToken=%s&timestamp=%s" % (auth_token, timestamp)
    signature = hashlib.sha256(signature.encode()).hexdigest()
    params = {
        "signature": signature,
        "mid": merchant_id,
        "authToken": auth_token,
        "timestamp": timestamp,
        "format": "JSON",
    }

    is_mobile = False
    is_success = True
    is_auth_completed = False
    success_msg = None
    failed_msg = None
    gateway_response = {}

    payment = Payment.objects.filter(pk=payment_id).first()
    if not payment:
        failed_msg = f"Payment is not exists: pk={payment_id}"
        logger.error(f"{failed_msg}")
        raise ValidationError("결제가 취소되었습니다.", code=CheckoutErrorCode.PAYMENT_CANCEL.value)

    logger.info(f"payment_debug: handle_return {payment_id} {payment} {result_code} {result_msg}")

    if result_code != "0000":
        is_success = False
        failed_msg = result_msg
        create_payment_failed_transaction(
            payment=payment,
            type=PaymentFailedType.INICIS_RETURN_FAILED,
            message=result_msg,
            parameters={"payment_id": payment_id, "result_code": result_code},
        )
    else:
        success_msg = result_msg

    if is_success:
        org_response = None
        result_code = None
        result_msg = None
        pay_method = None
        try:
            checkout = get_checkout(payment)
            brand = checkout.user.brand if checkout.user else None
            validate_brand_pg_info(payment.gateway, brand)
            plugin_configs = get_inicis_plugin_configs(gateway_config)
            plugin_configs = change_inicis_plugin_configs(plugin_configs, brand)
            if not plugin_configs:
                raise ValidationError(
                    "결제 정보 오류로 결제가 취소되었습니다.",
                    code=CheckoutErrorCode.PAYMENT_CANCEL.value,
                )

            org_response = requests.post(auth_url, data=params)
            gateway_response = org_response.json()
            result_code = gateway_response.get("resultCode")
            result_msg = gateway_response.get("resultMsg")
            pay_method = gateway_response.get(INICIS_PAY_METHOD)
            is_auth_completed = result_code == "0000"
            if not is_auth_completed:
                is_success = False
                success_msg = None
                failed_msg = f"이니시스 인증 실패: {result_msg} ({result_code}) {org_response}"
                create_payment_failed_transaction(
                    payment=payment,
                    type=PaymentFailedType.INICIS_AUTH_FAILED,
                    message=result_msg,
                    parameters={
                        "payment_id": payment_id,
                        "result_code": result_code,
                        "pay_method": pay_method,
                        "gateway_response": gateway_response,
                    },
                )
        except Exception as e:
            is_success = False
            failed_msg = f"이니시스 auth exception: {auth_url} - {org_response} {e}"
            create_payment_failed_transaction(
                payment=payment,
                type=PaymentFailedType.SYSTEM_FAILED,
                message="이니시스 인증 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다.",
                parameters={
                    "payment_id": payment_id,
                    "result_code": result_code,
                    "pay_method": pay_method,
                    "gateway_response": gateway_response,
                },
            )

        logger.info(f"payment_debug: 인증 요청 결과 수신 {payment} {result_code} {result_msg}")

    if is_auth_completed:
        try:
            checkout = get_checkout(payment)
            if is_vbank_pay(pay_method):
                server_mode_str = settings.SERVER_MODE
                server_mode_enum = ServerModeEnum(server_mode_str)
                include_vact_time = is_prod_server_mode(server_mode_enum) == False
                vact_info = get_inicis_vact_info(
                    gateway_response, include_vact_time=include_vact_time
                )
                success_msg = append_vact_info_to_success_msg(success_msg, vact_info)
            is_success, success_msg, failed_msg, _ = process_auth_completed(
                checkout=checkout,
                payment=payment,
                pay_method=pay_method,
                gateway_response=gateway_response,
                success_msg=success_msg,
                is_mobile=is_mobile,
            )
        except Exception as e:
            is_success = False
            failed_msg = "주문 처리 중 오류가 발생했습니다."
            logger.error(f"payment_debug: handle_return {failed_msg} - {e}")
            create_payment_failed_transaction(
                payment=payment,
                type=PaymentFailedType.SYSTEM_FAILED,
                message=failed_msg,
                parameters={
                    "payment_id": payment_id,
                    "result_code": result_code,
                    "pay_method": pay_method,
                    "gateway_response": gateway_response,
                },
            )

        # 이니니스 인증 성공 상태인데 내부 db 처리 과정에서 오류라면 이니시스로 net_cancel 요청 처리해서 결제 승인 자체를 취소 처리함
        if not is_success:
            cancel_success = handle_net_cancel(
                net_cancel_url, params, is_mobile, pay_method, payment
            )
            create_payment_failed_transaction(
                payment=payment,
                type=PaymentFailedType.SYSTEM_FAILED,
                message=make_cancel_payment_message(cancel_success),
                parameters={
                    "payment_id": payment_id,
                    "result_code": result_code,
                    "pay_method": pay_method,
                    "gateway_response": gateway_response,
                },
            )

    if not is_success:
        logger.error(f"{failed_msg} - {gateway_response}")

    logger.info(f"payment_debug: end of handle_return {payment}")

    return handle_window_close()


