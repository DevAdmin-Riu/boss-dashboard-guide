    tax_free_total_for_tax_invoice: Decimal = 0
    refund_lines: Iterable["RefundOrderLineData"] = None
    is_fbv: bool = False

    def __str__(self):
        input_data = f"refundData: {self.amount} {self.cashable_credits} {self.non_cashable_credits}  {self.rcoins} {self.return_delivery_fee}"
        calc_pay_data = (
            f"{self.new_paying_charge_exclude_vat} {self.new_brand_paying_charge_exclude_vat}"
        )
        calc_etc_data = f"{self.refund_brand_total_cost_price} {self.refund_brand_total_delivery_fee} {self.refund_delivery_additional_fee}"
        calc_tax_invoide_data = (
            f"{self.taxable_total_for_tax_invoice} {self.tax_free_total_for_tax_invoice}"
        )
        return f"{input_data} / {calc_pay_data} / {calc_etc_data} / {calc_tax_invoide_data}"


