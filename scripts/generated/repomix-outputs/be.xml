def order_line_refunded(refund_data: RefundData):
    if refund_data is None:
        return

    cancel_consignment_po_line_ids = []
    refund_lines = refund_data.refund_lines
    if refund_lines and len(refund_lines) > 0:
        bulk_order_lines = []
        for refund_line in refund_lines:
            order_line: OrderLine = refund_line.order_line
            order_line.quantity_refunded += refund_line.refund_quantity
            if order_line.bp_bundle:
                bundle_info_qty = order_line.bundle_info_qty
                bundle_refunded_qty = int(refund_line.refund_quantity / bundle_info_qty)
                order_line.bundle_refunded_qty += bundle_refunded_qty
            bulk_order_lines.append(order_line)
            # 위탁 주문 중 출고가 하나도 안되었고, 환불 수량이 주문 수량 이상(전체환불)인 건의 발주서는 취소 처리
            if (
                order_line.track_inventory == False
                and order_line.quantity_fulfilled <= 0
                and order_line.quantity <= order_line.quantity_refunded
            ):
                cancel_consignment_po_line_ids.append(order_line.purchase_order_line_id)
        OrderLine.objects.bulk_update(
            bulk_order_lines, ["quantity_refunded", "bundle_refunded_qty"]
        )

    if len(cancel_consignment_po_line_ids) > 0:
        PurchaseOrderLine.objects.filter(pk__in=cancel_consignment_po_line_ids).update(
            status=PurchaseOrderLineStatus.CANCELED
        )


