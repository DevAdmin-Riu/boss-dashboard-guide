class BaseOuterBaseQtyToBeStockedLoader(DataLoader):
    """
    Outer / Inner Variant 별로 입고 예정 수량을 계산하는 공통 로직.
    단기 / 장기는 get_queryset 에서 필터 조건만 다르게 구현.
    """

    context_key = None  # subclass 에서 정의해야 함

    def batch_load(self, keys):
        variants = ProductVariant.objects.filter(id__in=keys).select_related("outer")

        # 아우터 / 이너 분리
        outer_variants = {v.id: v for v in variants if v.outer is None}
        outer_variants_for_inner = {v.outer.id: v.outer for v in variants if v.outer is not None}
        outer_variants.update(outer_variants_for_inner)
        inner_variants = {v.id: v.outer for v in variants if v.outer is not None}

        # PurchaseOrderLine 쿼리셋 생성 (subclass 에서 필터링 정의)
        po_lines_qs = self.get_queryset(
            PurchaseOrderLine.objects.filter(variant_id__in=outer_variants.keys())
        )
        po_lines_qs = filter_to_be_stocked_by_purchase_order_lines_qs(po_lines_qs)

        # 수량 집계
        purchase_order_aggregates = (
            po_lines_qs.values("variant_id")
            .annotate(
                total_quantity=Coalesce(
                    Sum("quantity", filter=Q(status__in=STOCKABLE_STATUSES_USING_QUANITY)), 0
                ),
                total_purchase_quantity=Coalesce(
                    Sum(
                        "purchase_quantity",
                        filter=Q(status__in=STOCKABLE_STATUSES_USING_PURCHASE_QUANITY),
                    ),
                    0,
                ),
            )
            .order_by()
        )

        outer_qty_map = {
            entry["variant_id"]: entry["total_quantity"] + entry["total_purchase_quantity"]
            for entry in purchase_order_aggregates
        }

        # 최종 매핑
        qty_map = defaultdict(int)

        # 아우터 → 그대로 적용
        for variant in variants:
            if variant.id not in inner_variants:
                qty_map[variant.id] = outer_qty_map.get(variant.id, Decimal(0))

        # 이너 → outer 수량 * pack_count
        for variant in variants:
            if variant.id in inner_variants:
                pack_count = calc_pack_count(variant, inner_variants[variant.id])
                qty_map[variant.id] = (
                    outer_qty_map.get(inner_variants[variant.id].id, Decimal(0)) * pack_count
                )

        return [qty_map.get(variant_id) for variant_id in keys]

    def get_queryset(self, qs):
        """
        Subclass 에서 override 해서 short-term, long-term 필터링 조건 정의
        """
        raise NotImplementedError


