class AccountDelete(ModelDeleteMutation):
    class Arguments:
        token = graphene.String(
            description=(
                "A one-time token required to remove account. "
                "Sent by email using AccountRequestDeletion mutation."
            ),
            required=True,
        )

    class Meta:
        description = "Remove user account."
        model = models.User
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        return context.user.is_authenticated

    @classmethod
    def clean_instance(cls, info, instance):
        super().clean_instance(info, instance)
        if instance.is_staff:
            raise ValidationError(
                "Cannot delete a staff or mall_staff account.",
                code=AccountErrorCode.DELETE_STAFF_ACCOUNT,
            )

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        user = info.context.user
        cls.clean_instance(info, user)

        token = data.pop("token")
        if not default_token_generator.check_token(user, token):
            raise ValidationError(
                {"token": ValidationError(INVALID_TOKEN, code=AccountErrorCode.INVALID)}
            )

        db_id = user.id

        user.delete()
        # After the instance is deleted, set its ID to the original database's
        # ID so that the success response contains ID of the deleted object.
        user.id = db_id
        return cls.success_response(user)


class AccountAddressCreate(ModelMutation, I18nMixin):
    user = graphene.Field(User, description="A user instance for which the address was created.")

    class Arguments:
        input = AddressInput(description="Fields required to create address.", required=True)

    class Meta:
        description = "Create a new address for the customer."
        model = models.Address
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        return context.user.is_authenticated

    @classmethod
    def post_save_action(
        cls,
        _info,
        address: "AddressModel",
        user: "UserModel",
    ):
        # 점주/ 점장이 아닌 경우 주소 생성 불가. hq_staff, staff는 가능
        if not user.is_brand_store_owner and not user.is_staff and not user.is_hq_staff:
            raise ValidationError(
                "점주/점장이 아닌 경우 주소를 생성할 수 없습니다.",
                code=AccountErrorCode.INVALID,
            )
        user.addresses.add(address)
        if not user.default_shipping_address:
            utils.set_user_default_shipping_address(user, address)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        user = info.context.user
        input_data = data.get("input")
        cleaned_input = cls.clean_input(info=info, instance=AddressModel(), input_data=input_data)
        BaseAddressUpdate.street_address_input_validation(cls, input_data)
        cleaned_input = BaseAddressUpdate.create_direct_shipping_detail(cleaned_input)
        address = cls.validate_address(cleaned_input)
        cls.clean_instance(info, address)
        cls.save(info, address, cleaned_input)
        cls._save_m2m(info, address, cleaned_input)
        cls.post_save_action(info, address, user)
        return AccountAddressCreate(user=user, address=address)


