class GetPostalCodesFromAddressesBulk(BaseMutation):
    postal_codes = graphene.List(
        PostalCodesOutput, description="우편번호 조회 결과 리스트 (성공 및 실패 포함)"
    )

    class Arguments:
        addresses = graphene.List(graphene.String, required=True, description="주소 리스트")
        postal_codes = graphene.List(graphene.String, required=False, description="우편번호 리스트")

    class Meta:
        description = "여러 주소를 기반으로 각각의 우편번호를 조회합니다."
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def clean_input(cls, addresses):
        if not addresses or not all(addresses):
            raise ValidationError("유효하지 않은 주소 목록입니다.")

    @staticmethod
    def create_result(address, postal_code=None, error_code=None, error_message=None):
        return {
            "address": address,
            "postal_code": postal_code,
            "error_code": error_code,
            "error_message": error_message,
        }

    @staticmethod
    def fetch_postal_code(address_and_postal_code, base_url, service_key):
        try:
            address, postal_code = address_and_postal_code
            # 우편번호가 입력되어 있고, 5자리 이상이면 그대로 리턴 (외국 우편번호 체계 + 5자리 국내 우편번호면 입력된 값 그대로 사용)
            if postal_code is not None and len(postal_code.replace(" ", "")) >= 5:
                return GetPostalCodesFromAddressesBulk.create_result(
                    address,
                    postal_code=postal_code,
                )

            params = {
                "ServiceKey": service_key,
                "srchwrd": address,
                "countPerPage": 10,
                "currentPage": 1,
            }
            response = requests.get(base_url, params=params, timeout=5)
            response.raise_for_status()

            postal_codes = GetPostalCodesFromAddressesBulk.find_postal_codes(response.text)
            if not postal_codes:
                return GetPostalCodesFromAddressesBulk.create_result(
                    address,
                    error_code=AccountErrorCode.NOT_FOUND,
                    error_message=f"{address}: 우편번호가 조회되지 않았습니다.",
                )
            elif len(set(postal_codes)) > 1:
                return GetPostalCodesFromAddressesBulk.create_result(
                    address,
                    error_code=AccountErrorCode.MULTIPLE_POSTAL_CODE_FOUND,
                    error_message=f"{address}: 여러 개의 우편번호가 조회되었습니다. 더 구체적인 주소를 입력하세요. 또는 우편번호를 직접 입력하세요.",
                )
            else:
                return GetPostalCodesFromAddressesBulk.create_result(
                    address,
                    postal_code=postal_codes[0],
                )

        except Exception as e:
            return {
                "address": address,
                "error_code": AccountErrorCode.API_ERROR,
                "error_message": f"{address}: 오류 발생 - {str(e)}",
            }

    @staticmethod
    def find_postal_codes(xml_data):
        start_tag = "<zipNo>"
        end_tag = "</zipNo>"
        postal_codes = []
        start_idx = 0

        while True:
            start_idx = xml_data.find(start_tag, start_idx)
            if start_idx == -1:
                break

            start_idx += len(start_tag)
            end_idx = xml_data.find(end_tag, start_idx)
            if end_idx == -1:
                break

            postal_code = xml_data[start_idx:end_idx].strip()
            postal_codes.append(postal_code)

        return postal_codes

    @classmethod
    def perform_mutation(cls, root, info, **data):
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(OPEN_DATA_PLUGIN_ID)

        base_url = plugin_configs["getPostalCodeBaseUrl"]
        service_key = plugin_configs["serviceKey"]

        addresses = data.get("addresses")
        postal_codes = data.get("postal_codes")
        cls.clean_input(addresses)
        results = []
        try:
            fetch_postal_code_with_args = partial(
                cls.fetch_postal_code, base_url=base_url, service_key=service_key
            )
            with concurrent.futures.ThreadPoolExecutor() as executor:
                results = list(
                    executor.map(fetch_postal_code_with_args, zip(addresses, postal_codes))
                )
        except Exception as e:
            raise ValidationError(f"API 호출 중 오류 발생: {str(e)}")

        postal_codes = []
        errors = []
        for result in results:
            if result["postal_code"]:
                postal_codes.append(
                    PostalCodesOutput(address=result["address"], postal_code=result["postal_code"])
                )
            else:
                errors.append(
                    AccountError(code=result["error_code"], message=result["error_message"])
                )

        return cls(postal_codes=postal_codes, account_errors=errors)


