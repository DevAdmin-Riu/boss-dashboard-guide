                )
                error_msg = f"로케이션 재고 수량이 일치하지 않는 제품: {sku_list}"
            raise ValidationError(error_msg)

        invalid_rack_stock_details_qs = models.RackStockDetail.objects.select_related(
            "product_variant"
        ).filter(remain_quantity__gt=0, stock_detail__isnull=True)
        invalid_rack_stock_details: List[RackStockDetailModel] = list(invalid_rack_stock_details_qs)

        invalid_rack_stock_details_count = len(invalid_rack_stock_details)

        if invalid_rack_stock_details_count > 0:
