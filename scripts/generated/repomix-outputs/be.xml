class ProductImageCreate(BaseMutation):
    product = graphene.Field(Product)
    image = graphene.Field(ProductImage)

    class Arguments:
        input = ProductImageCreateInput(
            required=True, description="Fields required to create a product image."
        )

    class Meta:
        description = "Create a product image."
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        data = data.get("input")
        product = cls.get_node_or_error(info, data["product"], field="product", only_type=Product)

        # product를 copy하여(스냅샷) before_product에 저장한다.
        before_product = deepcopy(product)
        # 수정전 관계 필드들 스냅샷.
        before_product_m2m_and_related_values, _ = prepare_m2m_and_related_values(
            before_product, None
        )

        image_data = info.context.FILES.get(data["image"])
        validate_image_file(image_data, "image")
        new_file_name = make_unique_filename(image_data.name)
        image_data.name = new_file_name

        image = product.images.create(image=image_data, alt=data.get("alt", ""))
        transaction.on_commit(lambda: create_product_thumbnails.delay(image.pk))

        product_changes, _, _ = make_total_change_summary_for_product_and_variant(
            before_variant=None,
            before_inner_variant=None,
            before_product=before_product,
            before_product_m2m_and_related_values=before_product_m2m_and_related_values,
            before_variant_m2m_and_related_values=None,
            updated_variant=None,
            updated_product=product,
        )

        change_details = "\n".join(product_changes)
        manage_event = {
            "type": ProductVariantManageEventType.TYPE_IMAGE,
            "title": "이미지 추가",
            "reason": "",
            "change_details": change_details,
        }
        add_pv_manage_event(pv=product.default_variant, manage_event=manage_event, info=info)

        return ProductImageCreate(product=product, image=image)


