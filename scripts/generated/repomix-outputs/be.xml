from typing import List

from saleor.bbs import RefundReasonType

from ...account import RequestOriginType
from ...account.models import User
from ...app.models import MobileDevice
from ...bbs.models import (
    PushNotification,
    PushSendEvent,
    RequestBossProduct,
    RequestBossProductEstimate,
)
from ...core.firebase import send_fcm_message
from .types import PushSendEventParameters


def get_question_reason(q_reason_type):
    for reason_type in RefundReasonType:
        if reason_type.value == q_reason_type:
            return reason_type.label

    return "-"


def make_req_boss_prod_price_info(request: RequestBossProduct):
    estimates: List[RequestBossProductEstimate] = request.estimates.order_by(
        "id"
    )  # estimate_id 순으로 정렬
    price_info_list = []

    for estimate in estimates:
        price_info_list.append(
            {
                "estimate_id": estimate.id,
                "sub_id": estimate.sub_id,
                "is_picked": estimate.is_picked,
                "vendor_product_price_exclude_vat": estimate.vendor_product_price_exclude_vat,
                "vendor_delivery_fee_exclude_vat": estimate.vendor_delivery_fee_exclude_vat,
                "delivery_fee_exclude_vat": estimate.delivery_fee_exclude_vat,
                "vendor_consignment_product_price_exclude_vat": estimate.vendor_consignment_product_price_exclude_vat,
                "vendor_consignment_delivery_fee_exclude_vat": estimate.vendor_consignment_delivery_fee_exclude_vat,
                "consignment_delivery_fee_exclude_vat": estimate.consignment_delivery_fee_exclude_vat,
                "brand_product_price_exclude_vat": estimate.brand_product_price_exclude_vat,
                "brand_delivery_fee_exclude_vat": estimate.brand_delivery_fee_exclude_vat,
                "mall_product_price_exclude_vat": request.mall_product_price_exclude_vat,
            }
        )

    return price_info_list


def send_push_notification_by_instance(
    user_ids: List[int], app_type: RequestOriginType, push_notification: PushNotification
):
    title = push_notification.title
    content = push_notification.content
    data = push_notification.data if push_notification.data else {}
    push_send_events = []

    unique_user_ids = set(user_ids)
    user_map = {u.id: u for u in User.objects.filter(id__in=unique_user_ids)}
    target_mobile_devices = MobileDevice.objects.filter(
        user__in=user_ids, request_origin=app_type
    ).distinct()
    devices = target_mobile_devices.values_list("user_id", "fcm_token")

    # 1. 모든 기기에 FCM 메시지 전송
    for user_id, fcm_token in devices:
        send_fcm_message(fcm_token, app_type, title, content, data)

    # 2. user별로 한 번만 PushSendEvent 생성
    for user_id in unique_user_ids:
        user = user_map.get(user_id)
        if user:
            push_send_events.append(
                PushSendEvent(
                    push_notification=push_notification,
                    user=user,
                    target_app_type=app_type,
                    parameters={
                        "title": title,
                        "content": content,
                        "data": data,
                    },
                )
            )

    PushSendEvent.objects.bulk_create(push_send_events)


def send_push_notification_by_parameters(
    user_ids: List[int], app_type: RequestOriginType, parameters: PushSendEventParameters
):
    title = parameters["title"]
    content = parameters["content"]
    data = parameters["data"] if "data" in parameters else {}
    push_send_events = []

    unique_user_ids = set(user_ids)
    user_map = {u.id: u for u in User.objects.filter(id__in=unique_user_ids)}
    target_mobile_devices = MobileDevice.objects.filter(
        user__in=user_ids, request_origin=app_type
    ).distinct()
    devices = target_mobile_devices.values_list("user_id", "fcm_token")

    # 1. 모든 기기에 FCM 메시지 전송
    for user_id, fcm_token in devices:
        send_fcm_message(fcm_token, app_type, title, content, data)

    # 2. user별로 한 번만 PushSendEvent 생성
    for user_id in unique_user_ids:
        user = user_map.get(user_id)
        if user:
            push_send_events.append(
                PushSendEvent(
                    push_notification=None,
                    user=user,
                    target_app_type=app_type,
                    parameters=parameters,
                )
            )

    PushSendEvent.objects.bulk_create(push_send_events)
