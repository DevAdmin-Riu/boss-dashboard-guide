        error_type_field = "order_errors"

    @classmethod
    def clean_input(cls, _info, data):
        cleaned_input = data.get("input")
        order_line_ids = cleaned_input.get("order_line_ids")
        order_lines: List[OrderLineModel] = cls.get_nodes_or_error(
            order_line_ids,
            "id",
            OrderLine,
            qs=models.OrderLine.objects.select_related("variant", "order"),
        )
        orders = {order_line.order for order_line in order_lines}
        return order_lines, orders, cleaned_input.get("batch_picking_id")

    @classmethod
    def call_order_fulfill_mutation(
        cls,
        root,
        info,
        order_lines: List[OrderLineModel],
        orders: List[OrderModel],
        batch_picking_id: str,
    ):
        box_spec = BoxSpecForPickingOrder.objects.first()
        sub_pv = box_spec.sub_pv if box_spec else None
        requester = info.context.user
        country_code = settings.DEFAULT_COUNTRY
        for order in orders:
            stock_detail_event_reason = f"주문번호:{order.composed_id_with_prefix}"
            brand: "Brand" = order.brand
            if brand:
                stock_detail_event_reason = (
                    f"주문번호:{order.composed_id_with_prefix} / {brand.name}({brand.code})"
                )
            picking_info = order.picking_info
            boxes = picking_info.get("boxes")
            sub_pv_quantity = len(boxes)
            decrease_stock_of_sub_pv(requester, sub_pv, sub_pv_quantity, stock_detail_event_reason)
            for box in boxes:
                lines = box.get("lines")
                order_fulfill_line_input_list = []
                for line in lines:
                    sku = line.get("sku")
                    quantity = line.get("quantity")
                    order_line = next(
                        (
                            order_line
                            for order_line in order_lines
                            if order_line.variant.sku == sku and order_line.order_id == order.id
                        ),
                        None,
                    )
                    inner_variant: ProductVariant = order_line.variant
                    inner_stock: Stock = (
                        Stock.objects.select_for_update(of=("self",))
                        .get_variant_stocks_for_country(country_code, inner_variant)
                        .order_by("pk")
                        .first()
                    )

                    order_fulfill_line_input = {
                        "order_line_id": graphene.Node.to_global_id("OrderLine", order_line.id),
                        "stocks": [
                            {
                                "quantity": quantity,
                                "warehouse": graphene.Node.to_global_id(
                                    "Warehouse", inner_stock.warehouse_id
                                ),
                            }
                        ],
                    }
                    order_fulfill_line_input_list.append(order_fulfill_line_input)

                order_fulfill_input = {
                    "is_picking_order": True,
                    "lines": order_fulfill_line_input_list,
                    "batch_picking_id": batch_picking_id,
                }
                response = OrderFulfill.mutate(
                    root,
                    info,
                    order=graphene.Node.to_global_id("Order", order.id),
                    input=order_fulfill_input,
                )
                if response.errors:
                    raise ValidationError(
                        f"{NON_B2B_ORDER_PREFIX}{order.id} OrderFulfill 에러 - {response.errors[0].message}"
                    )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        order_lines, orders, batch_picking_id = cls.clean_input(info, data)

        cls.call_order_fulfill_mutation(root, info, order_lines, orders, batch_picking_id)

