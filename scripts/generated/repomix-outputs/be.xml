from typing import Optional

from ..account.models import Brand, User
from ..core.utils.regex import remove_all_non_numeric
from ..core.utils.str_utils import is_non_empty_str
from ..plugins.manager import get_plugins_manager
from ..plugins.taxinvoicing.define import POPBILL_PLUGIN_ID
from .interface import BizRegInfo
from .models import TaxInvoice


def get_biz_reg_info_by_brand(brand: "Brand") -> Optional[BizRegInfo]:
    brand_biz_info = brand.biz_info
    if not brand_biz_info:
        return None
    return BizRegInfo(
        biz_reg_no=remove_all_non_numeric(brand_biz_info.get("bizRegNo", "")),
        biz_reg_corp_name=brand_biz_info.get("bizName", ""),
        biz_reg_ceo_name=brand_biz_info.get("bizRepName", ""),
        biz_reg_address=brand_biz_info.get("bizAddress", ""),
        biz_reg_type=brand_biz_info.get("bizType", ""),
        biz_reg_class=brand_biz_info.get("bizClass", ""),
        biz_reg_email=brand_biz_info.get("taxInvoiceInChargePersonEmail", ""),
    )


def get_biz_reg_info_by_user(user: "User") -> Optional[BizRegInfo]:
    if not user:
        return None
    brand_store = user.brand_store
    # brand_store가 없으면 user의 정보로 biz_reg_info를 생성(hq_staff 등)
    if not brand_store:
        return BizRegInfo(
            biz_reg_no=remove_all_non_numeric(user.biz_reg_no),
            biz_reg_corp_name=user.biz_reg_corp_name,
            biz_reg_ceo_name=user.biz_reg_ceo_name,
            biz_reg_address=user.biz_reg_addr,
            biz_reg_type=user.biz_reg_biz_type,
            biz_reg_class=user.biz_reg_biz_class,
            biz_reg_email=user.email,
        )

    return BizRegInfo(
        biz_reg_no=remove_all_non_numeric(brand_store.biz_reg_no),
        biz_reg_corp_name=brand_store.biz_reg_corp_name,
        biz_reg_ceo_name=brand_store.biz_reg_ceo_name,
        biz_reg_address=brand_store.biz_reg_addr,
        biz_reg_type=brand_store.biz_reg_biz_type,
        biz_reg_class=brand_store.biz_reg_biz_class,
        biz_reg_email=brand_store.email,
    )


def get_biz_reg_info_by_popbill_plugin_configs(popbill_plugin_configs) -> Optional[BizRegInfo]:
    if not popbill_plugin_configs:
        return None
    return BizRegInfo(
        biz_reg_no=remove_all_non_numeric(popbill_plugin_configs.invoicerCorpNum),
        biz_reg_corp_name=popbill_plugin_configs.invoicerCorpName,
        biz_reg_ceo_name=popbill_plugin_configs.invoicerCEOName,
        biz_reg_address=popbill_plugin_configs.invoicerAddr,
        biz_reg_type=popbill_plugin_configs.invoicerBizType,
        biz_reg_class=popbill_plugin_configs.invoicerBizClass,
    )


# 합포장 거래명세서에서는 선결제금이 아님 물품 거래의 공급자이므로 get_tax_invoicer_info_by_brand 호출해서 사용해야 함
def get_invoicer_biz_reg_info_by_brand(brand: "Brand") -> Optional[BizRegInfo]:
    if brand and brand.is_reverse_fee_contract_type:
        return get_biz_reg_info_by_brand(brand)

    popbill_plugin_configs = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
    return get_biz_reg_info_by_popbill_plugin_configs(popbill_plugin_configs)


# 세금계산서 발행 시에는 공급자가 리우 여부인지를 고려한 get_tax_invoicer_info_by_tax_invoice 호출해서 사용해야 함
def get_invoicer_biz_reg_info_by_tax_invoice(tax_invoice: "TaxInvoice") -> Optional[BizRegInfo]:
    if tax_invoice.is_from_riu:
        popbill_plugin_configs = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
        return get_biz_reg_info_by_popbill_plugin_configs(popbill_plugin_configs)

    order = tax_invoice.order
    brand = order.brand if order else None
    if not brand:
        return None
    return get_biz_reg_info_by_brand(brand)


def get_invoicee_biz_reg_info_by_tax_invoice_for_b2b(
    tax_invoice: "TaxInvoice",
) -> Optional[BizRegInfo]:
    b2b_brand = tax_invoice.b2b_brand
    if b2b_brand is None:
        return None
    return get_biz_reg_info_by_brand(b2b_brand)


def get_invoicee_biz_reg_info_by_tax_invoice(tax_invoice: "TaxInvoice") -> Optional[BizRegInfo]:
    is_b2b = tax_invoice.is_b2b
    if is_b2b:
        return get_invoicee_biz_reg_info_by_tax_invoice_for_b2b(tax_invoice)

    order = tax_invoice.order
    if order is None:
        return None

    if tax_invoice.is_to_hq:
        brand = order.brand if order else None
        if not brand:
            return None
        return get_biz_reg_info_by_brand(brand)

    user = order.user if order else None
    if not user:
        return None
    invoicee_biz_reg_info = get_biz_reg_info_by_user(user)

    # alt_invoicee_biz_info 에 biz_reg_no (사업자등록번호), biz_corp_name (상호), biz_ceo_name (대표자명) 필드가 있고 그 값이 있는 경우
    # 매장 세금계산서 공급받는자 정보를 user 정보 대신 이 정보로 대체함
    if order.alt_invoicee_biz_info:
        alt_biz_reg_no = order.alt_invoicee_biz_info.get("biz_reg_no")
        alt_biz_corp_name = order.alt_invoicee_biz_info.get("biz_corp_name")
        alt_biz_ceo_name = order.alt_invoicee_biz_info.get("biz_ceo_name")
        use_alt_biz_info = (
            is_non_empty_str(alt_biz_reg_no)
            and is_non_empty_str(alt_biz_corp_name)
            and is_non_empty_str(alt_biz_ceo_name)
        )
        if use_alt_biz_info:
            invoicee_biz_reg_info.biz_reg_no = alt_biz_reg_no.strip()
            invoicee_biz_reg_info.biz_reg_corp_name = alt_biz_corp_name.strip()
            invoicee_biz_reg_info.biz_reg_ceo_name = alt_biz_ceo_name.strip()
    return invoicee_biz_reg_info
