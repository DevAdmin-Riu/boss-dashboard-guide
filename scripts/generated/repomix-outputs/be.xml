            required=True,
        ),
        stat_date=graphene.Argument(
            DateRangeInput,
            description="aggregation period: 월 매출 모드 므로 gte는 YYYY-MM-01 로, lte 는 말일로 세팅",
            required=True,
        ),
        include_boss_mrkt=graphene.Boolean(
            description="보스장터 매출 포함 여부",
            required=True,
        ),
        brand_search=graphene.String(description="브랜드 코드/브랜드명.", required=False),
        is_running=graphene.Boolean(
            description="브랜드 운영 여부",
            required=False,
        ),
    )

    sales_stats_by_product = graphene.List(
        SalesStatsByProduct,
        description="제품별 매출 실적 통계",
        stat_date=graphene.Argument(
            DateRangeInput,
            description="aggregation period: 월별 매출 모드에서는 gte는 YYYY-MM-01 로, lte 는 말일로 세팅",
            required=True,
        ),
        brand_ids=graphene.List(
            graphene.ID, description="IDs of franchise brands.", required=False
        ),
        product_variant_ids=graphene.List(
            graphene.ID, description="IDs of product variants.", required=False
        ),
        brand_search=graphene.String(description="브랜드 코드/브랜드명", required=False),
        product_search=graphene.String(description="제품코드/제품명", required=False),
        vendor_search=graphene.String(description="협력사 코드/협력사명", required=False),
        is_monthly_mode=graphene.Boolean(
            description="월별 매출 모드 여부",
            required=True,
        ),
    )

    sales_stats_by_product_for_brand = graphene.List(
        SalesStatsByProductForBrand,
        description="제품별 매출 실적 통계(브랜드)",
        stat_date=graphene.Argument(
            DateRangeInput,
            description="aggregation period",
            required=True,
        ),
        brand_id=graphene.ID(description="브랜드 ID", required=True),
        include_boss_mrkt=graphene.Boolean(
            description="보스장터 매출 포함 여부",
            required=True,
        ),
        product_search=graphene.String(description="제품코드/제품명", required=False),
        vendor_search=graphene.String(description="협력사 코드/협력사명", required=False),
        is_exclusive=graphene.Boolean(
            description="전용 제품 여부",
            required=False,
        ),
        track_inventory=graphene.Boolean(
            description="재고 운영 여부",
            required=False,
        ),
        is_inner=graphene.Boolean(
            description="이너 상품 여부",
            required=False,
        ),
        is_sub_pv=graphene.Boolean(
            description="부자재 상품 여부",
            required=False,
        ),
        is_fulfilled_by_vendor=graphene.Boolean(
            description="직거래 상품 여부",
            required=False,
        ),
        category_kind=graphene.List(
            CategoryKindEnum,
            description="카테고리 종류",
            required=False,
        ),
        sales_status=graphene.List(
            SalesStatusEnum,
            description="제품 상태",
            required=False,
        ),
    )
    b2b_sales_stats = graphene.List(
        B2bSalesStats,
        description="b2b 매출 마감용 통계",
        sales_close_date=graphene.Argument(
            DateRangeInput,
            description="aggregation period: 월 매출 모드 므로 gte는 YYYY-MM-01 로, lte 는 말일로 세팅",
            required=True,
        ),
        include_only_sent=graphene.Boolean(
            description="마감 명세서 발송된 이력이 있는 건만 조회 여부", required=True
        ),
        only_before_send=graphene.Boolean(
            description="마감명세서 발송 페이지 요청시 발송대기 상태인 것만 집계 여부",
            required=False,
        ),
        brand_search=graphene.String(description="브랜드 코드/브랜드명", required=False),
    )
    b2b_sales_stats_by_brand = graphene.List(
        B2bSalesStatsByBrand,
        description="브랜드별 월별 b2b 매출 통계",
        filter=graphene.Argument(B2bSalesStatsByBrandFilterInput, required=True),
    )

    def resolve_sales(self, info, **_kwargs):
        qs = models.Sales.objects.all().distinct()
        return qs

    @staticmethod
    def filter_brand_search(qs, value):
        if value:
            search_fields = [
                "brand__name",
                "brand__code",
            ]
            qs = filter_by_query_param(qs, value, search_fields)
        return qs

    @staticmethod
    def filter_product_search(qs, value):
        if value:
            search_fields = [
                "variant__sku",
                "variant__product__name",
            ]
            qs = filter_by_query_param(qs, value, search_fields)
        return qs

    @staticmethod
    def filter_vendor_search(qs, value):
        # 구조상 filter_vendor_search_factory 적용 못함.
        if value:
            split_values = value.split("\n")
            query = Q()
            for split_value in split_values:
                # 여기서는 contains로 되어있지만 정확히 매치되어야만 조회되는 것으로 확인됨.
                query |= Q(vendor_info__contains={"vendors": [{"code": split_value}]})
                query |= Q(vendor_info__contains={"vendors": [{"name": split_value}]})
            qs = qs.filter(query)
        return qs

    @staticmethod
    def filter_vendor_from_product_search(qs, value):
        if value:
            qs = filter_vendor_search_factory(
                field_name="variant__default_variant_vendor__vendor__id",
                search_fields=[
                    "variant__default_variant_vendor__vendor__name",
                ],
            )(qs, None, value)
        return qs

    @staticmethod
    def calculate_b2b_stats(qs, include_only_sent, stat_date_field: str = "sales_close_date"):
        trunc_func = TruncMonth

        qs = (
            qs.annotate(stat_date=trunc_func(stat_date_field))
            .annotate(b2b_delivery_fee_total=Round(F("b2b_delivery_fee_exclude_vat") * 1.1))
            .annotate(
                taxable_total=Case(
                    When(is_tax_free=False, then=F("quantity") * F("unit_price")),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .annotate(
                taxfree_total=Case(
                    When(
                        is_tax_free=True,
                        then=F("quantity") * F("unit_price"),
                    ),
                    default=Value(0),
                    output_field=IntegerField(),
                )
            )
            .values("brand_id", "stat_date")
            .annotate(
                stat_taxable_total=Coalesce(Sum("taxable_total", output_field=IntegerField()), 0)
                + Coalesce(Sum("b2b_delivery_fee_total", output_field=IntegerField()), 0)
            )
            .annotate(
                stat_taxfree_total=Coalesce(Sum("taxfree_total", output_field=IntegerField()), 0)
            )
            .values(
                "brand_id",
                "stat_date",
                "stat_taxable_total",
                "stat_taxfree_total",
            )
            .order_by("brand_id", "stat_date")
        )

        result_list = list(qs)
        brand_ids = {item["brand_id"] for item in result_list}
        brand_map = {
            brand.id: brand for brand in account_models.Brand.objects.filter(id__in=brand_ids)
        }

        stat_dates = {item["stat_date"] for item in result_list}
        # 같은 브랜드에서는 마감은 한달에 제일 마지막 것 하나만 유효함
        settlement_qs = (
            models.SalesB2bSettlement.objects.annotate(
                stat_date=TruncMonth("sales_close_date"),
                unpaid_amount_int=Cast("unpaid_amount", output_field=IntegerField()),
            )
            .filter(
                brand_id__in=brand_ids,
                stat_date__in=stat_dates,
            )
            .order_by("brand_id", "stat_date", "-sales_close_date")  # 중요: 가장 마지막 마감일 우선
            .distinct("brand_id", "stat_date")  # 브랜드/월별 하나만
            .values("brand_id", "stat_date", "unpaid_amount_int")
        )
        settlement_map = {
            (row["brand_id"], row["stat_date"]): row["unpaid_amount_int"] for row in settlement_qs
        }

        filtered_result_list = []
        for result in result_list:
            brand_id = result.pop("brand_id", None)
            if not brand_id:
                continue

            brand = brand_map.get(brand_id, {})
            result["brand"] = brand

            key = (brand_id, result["stat_date"])
            unpaid_amount = settlement_map.get(key)
            if include_only_sent and unpaid_amount is None:
                continue  # settlement_map 에 해당 키가 없으면 제외
            result["unpaid_amount"] = unpaid_amount

            filtered_result_list.append(result)

        return filtered_result_list

    @staticmethod
    def calculate_order_stats(qs, column_type: str, stat_date_field: str = "evented_at"):
        trunc_func = TruncMonth

        qs = (
            qs.annotate(stat_date=trunc_func(stat_date_field))
            .values("brand_id", "stat_date")
            .annotate(
                stat_total_price_exclude_vat=Coalesce(
                    Sum("total_price_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                stat_cost_price_exclude_vat=Coalesce(
                    Sum(
                        F("quantity") * F("unit_cost_price_exclude_vat"),
                        output_field=IntegerField(),
                    ),
                    0,
                )
            )
            .annotate(
                stat_delivery_fee=Coalesce(
                    Sum(
                        F("quantity") * F("unit_delivery_fee"),
                        output_field=IntegerField(),
                    ),
                    0,
                )
            )
            .annotate(
                stat_paying_charge_exclude_vat=Coalesce(
                    Sum("paying_charge_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                stat_mileage_exclude_vat=Coalesce(
                    Sum("mileage_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                stat_b2b_delivery_fee_exclude_vat=Coalesce(
                    Sum("b2b_delivery_fee_exclude_vat", output_field=IntegerField()), 0
                )
            )
            .annotate(
                stat_total_brand_cost_price_exclude_vat=Coalesce(
                    Sum(
                        F("quantity") * F("brand_unit_cost_price_exclude_vat"),
                        output_field=IntegerField(),
                    ),
                    0,
                )
            )
            .values(
                "brand_id",
                "stat_date",
                "stat_total_price_exclude_vat",
                "stat_cost_price_exclude_vat",
                "stat_delivery_fee",
                "stat_paying_charge_exclude_vat",
                "stat_mileage_exclude_vat",
                "stat_b2b_delivery_fee_exclude_vat",
                "stat_total_brand_cost_price_exclude_vat",
            )
            .order_by("brand_id", "stat_date")
        )
        result_list = list(qs)
        # 결과 리스트의 각 항목에 대해 global_brand_id 필드 값을 설정
        for result in result_list:
            result["column_type"] = column_type
            result["brand_global_id"] = graphene.Node.to_global_id("Brand", result["brand_id"])

        return result_list

    def resolve_sales_stats(self, _info, columns: SalesStatsColumnsInput, stat_date, **kwargs):
        brand_search = kwargs.get("brand_search")
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        if brand_search:
            qs = StatsBrandQueries.filter_sales_brand_search(qs, brand_search)

        include_boss_mrkt = kwargs.get("include_boss_mrkt")
        if not include_boss_mrkt:
            # 브랜드 필터를 안하는 경우, 보스마켓 용 Sales 기록은 제외해야 두번 집계되는 이슈 안생김
            qs = StatsBrandQueries.filter_sales_exclude_boss_mrkt(qs)

        qs = StatsBrandQueries.filter_sales_evented_at_range(qs, stat_date)

        # 필수 파라미터가 아니므로, kwargs.get() 를 사용하여 가져옴.
        # resolve_sales_stats() 함수의 파라미터에 다른 파라미터와 같이 직접 선언하면 null 또는 값 미전달 시 오류 발생
        is_running = kwargs.get("is_running")
        qs = StatsBrandQueries.filter_sales_brand_is_running(qs, is_running)

        combined_qs_list = []
        if columns.total:
            total_qs = qs.filter()
            combined_qs_list.extend(StatsSalesQueries.calculate_order_stats(total_qs, "TOTAL"))
        if columns.exclusive:
            exclusive_qs = qs.filter(is_exclusive=True)
            combined_qs_list.extend(
                StatsSalesQueries.calculate_order_stats(exclusive_qs, "EXCLUSIVE")
            )
        if columns.packaging:
            packaging_qs = qs.filter(category_type=CategoryTypeEnum.PACKAGING.value)
            combined_qs_list.extend(
                StatsSalesQueries.calculate_order_stats(
                    packaging_qs, CategoryTypeEnum.PACKAGING.value
                )
            )
        if columns.food:
            food_qs = qs.filter(category_type=CategoryTypeEnum.FOOD.value)
            combined_qs_list.extend(
                StatsSalesQueries.calculate_order_stats(food_qs, CategoryTypeEnum.FOOD.value)
            )
        if columns.equipment:
            equipment_qs = qs.filter(category_type=CategoryTypeEnum.EQUIPMENT.value)
            combined_qs_list.extend(
                StatsSalesQueries.calculate_order_stats(
                    equipment_qs, CategoryTypeEnum.EQUIPMENT.value
                )
            )

        return combined_qs_list

    def resolve_b2b_sales_count(self, _info, **kwargs):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = qs.filter(order_type__in=ORDER_TYPES_FOR_B2B)
        filter = kwargs.get("filter")
        brand_id = filter.get("brand_id")
        if brand_id is not None:
            _, brand_pk = graphene.Node.from_global_id(brand_id)
            qs = qs.filter(brand_id=brand_pk)

        b2b_sales_count = qs.aggregate(
            stand_by_count=Count("id", filter=Q(b2b_status=SalesB2bStatus.STANDBY)),
            req_revision_count=Count("id", filter=Q(b2b_status=SalesB2bStatus.REQ_REVISION)),
            revision_count=Count("id", filter=Q(b2b_status=SalesB2bStatus.REVISION)),
        )

        return B2bSalesCount(**b2b_sales_count)

    def resolve_b2b_sales_stats(self, info, **kwargs):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = qs.filter(order_type__in=ORDER_TYPES_FOR_B2B)
        user: "User" = info.context.user
        if user.is_hq_staff:
            qs = qs.filter(brand_id=user.brand_id)
        else:
            brand_search = kwargs.get("brand_search")
            qs = StatsBrandQueries.filter_sales_brand_search(qs, brand_search)
        sales_close_date = kwargs.get("sales_close_date")
        include_only_sent = kwargs.get("include_only_sent")
        qs = StatsBrandQueries.filter_sales_close_date_range(qs, sales_close_date)
        only_before_send = kwargs.get("only_before_send", False)
        if only_before_send:
            qs = qs.filter(b2b_status=SalesB2bStatus.BEFORE_SEND)
        qs = qs.exclude(b2b_status=SalesB2bStatus.CLOSED)
        return StatsSalesQueries.calculate_b2b_stats(qs, include_only_sent)

    def resolve_b2b_sales_stats_by_brand(self, _info, filter, **_kwargs):
        return resolve_b2b_sales_stats_by_brand(_info, filter, **_kwargs)

    def resolve_sales_stats_by_product(self, _info, stat_date, is_monthly_mode, **kwargs):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        product_variant_global_ids = kwargs.get("product_variant_ids", None)
        if product_variant_global_ids:
            product_variant_ids = [
                from_global_id_strict_type(id, only_type="ProductVariant", field="pk")
                for id in product_variant_global_ids
            ]
            qs = qs.filter(variant_id__in=product_variant_ids)

        brand_global_ids = kwargs.get("brand_ids", None)
        if brand_global_ids:
            brand_ids = [get_brand_id_from_query(id) for id in brand_global_ids]
            qs = qs.filter(brand_id__in=brand_ids)
        else:
            # 브랜드 필터를 안하는 경우, 보스마켓 용 Sales 기록은 제외해야 두번 집계되는 이슈 안생김
            qs = StatsBrandQueries.filter_sales_exclude_boss_mrkt(qs)

        brand_search = kwargs.get("brand_search")
        if brand_search:
            qs = StatsSalesQueries.filter_brand_search(qs, brand_search)

        product_search = kwargs.get("product_search")
        if product_search:
            qs = StatsSalesQueries.filter_product_search(qs, product_search)

        vendor_search = kwargs.get("vendor_search")
        if vendor_search:
            qs = StatsSalesQueries.filter_vendor_from_product_search(qs, vendor_search)

        qs = filter_range_field(qs, "evented_at__date", stat_date)

        def add_annotate_to_qs(qs):
            return qs.annotate(
                number_of_users=Count("user_id", distinct=True),
                quantity=Sum(
                    Case(
                        When(quantity__gte=0, then="quantity"),
                        default=0,
                        output_field=IntegerField(),
                    )
                ),
                product_sku=KeyTextTransform("productSku", "product_info"),
            ).order_by()

        if is_monthly_mode:
            qs = qs.annotate(stat_date=TruncMonth("evented_at")).values("variant_id", "stat_date")
            qs = add_annotate_to_qs(qs)
        else:
            # 이 경우에 stat_date는 null로 리턴 됨.
            qs = qs.values("variant_id")
            qs = add_annotate_to_qs(qs)

        return list(qs)

    def resolve_sales_stats_by_product_for_brand(self, _info, stat_date, brand_id, **kwargs):
        brand_id = from_global_id_strict_type(brand_id, only_type="Brand", field="pk")
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        qs = qs.filter(brand_id=brand_id)
        qs = filter_range_field(qs, "evented_at__date", stat_date)

        include_boss_mrkt = kwargs.get("include_boss_mrkt")
        if not include_boss_mrkt:
            # 브랜드 필터를 안하는 경우, 보스마켓 용 Sales 기록은 제외해야 두번 집계되는 이슈 안생김
            qs = StatsBrandQueries.filter_sales_exclude_boss_mrkt(qs)

        product_search = kwargs.get("product_search")
        if product_search:
            qs = StatsSalesQueries.filter_product_search(qs, product_search)

        vendor_search = kwargs.get("vendor_search")
        if vendor_search:
            qs = StatsSalesQueries.filter_vendor_search(qs, vendor_search)

        is_exclusive = kwargs.get("is_exclusive")
        if is_exclusive is not None:
            qs = qs.filter(variant__product__is_exclusive=is_exclusive)

        track_inventory = kwargs.get("track_inventory")
        if track_inventory is not None:
            qs = qs.filter(variant__track_inventory=track_inventory)

        is_inner = kwargs.get("is_inner")
        if is_inner is not None:
            qs = qs.filter(variant__outer__isnull=not is_inner)

        is_sub_pv = kwargs.get("is_sub_pv")
        if is_sub_pv is not None:
            qs = qs.filter(variant__is_sub_pv=is_sub_pv)

        is_fulfilled_by_vendor = kwargs.get("is_fulfilled_by_vendor")
        if is_fulfilled_by_vendor is not None:
            qs = qs.filter(variant__product__is_fulfilled_by_vendor=is_fulfilled_by_vendor)

        category_kind = kwargs.get("category_kind")
        if category_kind is not None:
            qs = qs.filter(variant__product__category__kind__in=category_kind)

        sales_status = kwargs.get("sales_status")
        if sales_status is not None:
            qs = qs.filter(variant__sales_status__in=sales_status)

        qs = (
            # NOTE 단순히 vendors안의 값으로 group by 하기 위해 annotate 사용. 출고시 여러 협력사가 2가지 이상으로 존재하는 경우 고려하지 않음. 그 경우에는 따로 group by 될 거고, 데이터 상으로는 크게 문제 없을듯.
            qs.annotate(
                vendor_code=KeyTextTransform("vendors", "vendor_info")  # JSON 필드 내 특정 키 추출
            )
            .values("variant_id", "vendor_code")
            .order_by()
            .annotate(
                stat_cost_price_exclude_vat=Sum(
                    F("quantity") * Coalesce(F("unit_cost_price_exclude_vat"), Value(0))
                ),
                stat_brand_cost_price_exclude_vat=Sum(F("brand_total_cost_price_exclude_vat")),
                stat_total_price_exclude_vat=Sum(F("total_price_exclude_vat")),
                number_of_users=Count("user_id", distinct=True),
                quantity=Sum(
                    Case(
                        When(quantity__gte=0, then="quantity"),
                        default=0,
                        output_field=IntegerField(),
                    )
                ),
            )
            .distinct()
        )

        variant_ids = list(qs.values_list("variant_id", flat=True))

        variants = ProductVariantModel.objects.filter(id__in=variant_ids)
        variant_map = {variant.id: variant for variant in variants}

        brand_product_variant = BrandProductVariantModel.objects.filter(
            product_variant_id__in=variant_ids,
            brand_id=brand_id,
        )
        brand_product_variant_map = {bpv.product_variant_id: bpv for bpv in brand_product_variant}

        brand = account_models.Brand.objects.get(pk=brand_id)
        is_brand_reverse_fee = brand.is_reverse_fee_contract_type

        return [
            SalesStatsByProductForBrand(
                variant=variant_map.get(sale["variant_id"]),
                brand_product_variant=brand_product_variant_map.get(sale["variant_id"]),
                stat_cost_price_exclude_vat=sale["stat_cost_price_exclude_vat"],
                stat_brand_cost_price_exclude_vat=sale["stat_brand_cost_price_exclude_vat"],
                stat_total_price_exclude_vat=sale["stat_total_price_exclude_vat"],
                vendor_info=sale["vendor_code"],
                is_brand_reverse_fee=is_brand_reverse_fee,
                number_of_users=sale["number_of_users"],
                quantity=sale["quantity"],
            )
            for sale in qs
        ]


class StatsSalesMutations(graphene.ObjectType):
    sales_b2b_cancel = SalesB2bCancel.Field()
    sales_b2b_update = SalesB2bUpdate.Field()
    sales_b2b_bulk_before_send = SalesB2bBulkBeforeSend.Field()
    sales_b2b_bulk_req_revision = SalesB2bBulkReqRevision.Field()
    sales_b2b_settlement_send = SalesB2bSettlementSend.Field()
    sales_b2b_close = SalesB2bClose.Field()
