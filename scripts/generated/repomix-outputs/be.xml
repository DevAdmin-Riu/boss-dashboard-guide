class OrderLineChangeTrackInventoryBeforeFulfilled(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of an order line to update.")
        input = OrderLineChangeTrackInventoryInput(
            description="Fields required to update a order line.", required=True
        )

    class Meta:
        description = "OrderLine의 track_inventory를 변경한다."
        model = models.OrderLine
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def clean_input(cls, info, instance: OrderLineModel, data):
        cleaned_input = super().clean_input(info, instance, data)
        # 합포장인경우 error: 만일 정책 변경 시 합포장 allocation 로직 처리 해야함
        if instance.is_picking_order:
            raise ValidationError("합포장 주문은 출고유형을 변경할 수 없습니다.")

        pv: ProductVariant = instance.variant
        if pv.is_vendor_track_inventory:
            raise ValidationError("위탁 재고 제품 주문은 출고유형을 변경할 수 없습니다.")

        if instance.order.type in [
            OrderType.BY_STAFF_FOR_B2B,
            OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
        ]:
            raise ValidationError("B2B 주문은 출고유형을 변경할 수 없습니다.")

        # 기타배송 주문인 경우 출고유형 변경 불허: 만일 허용으로 정책 변경 시 decrease_stock_flag 에 따라 allocation 로직 처리 해야함
        if instance.order.type == OrderType.BY_STAFF_FOR_ETC:
            raise ValidationError("기타 배송 주문은 출고유형을 변경할 수 없습니다.")

        input_track_inventory = data.get("track_inventory")
        # input_track_inventory와 instance의 track_inventory가 서로 같으면 validation error
        if instance.track_inventory == input_track_inventory:
            raise ValidationError("변경 요청한 '출고유형' 값이 기존 '출고유형' 값과 동일합니다.")
        # 이 이후 부터는 다르다게 바뀐다고 가정.

        # input_track_inventory가 True인 경우 즉 재고로 바뀌는 경우
        if input_track_inventory:
            # order_line의 quantity_fulfilled가 0이 아닌 경우, 즉 출고된게 있는 경우 error
            if (
                instance.quantity_fulfilled
                > instance.fulfillment_lines.filter(stock_id__isnull=False).count()
            ):
                raise ValidationError(
                    "위탁으로 출고된 제품이 있는 경우 해당 버튼으로 출고유형을 변경할 수 없습니다."
                )
            # order_line의 quantity_refunded가 0이 아닌 경우, 즉 출고된게 있는 경우 error
            if instance.quantity_refunded > 0:
                raise ValidationError(
                    "환불(반품)된 제품이 있는 경우 출고유형을 변경할 수 없습니다."
                )

            try:
                box_size = get_box_size_from_variant(instance.variant)
                cleaned_input["box_size"] = box_size
            except Exception as e:
                error_msg = "박스사이즈 속성 값이 설정되지 않은 제품은 재고 출고 유형으로 변경할 수 없습니다. 제품 속성을 확인해주세요."
                raise ValidationError(error_msg)

        return cleaned_input

    @classmethod
    @transaction.atomic()
    def save(cls, info, instance: "OrderLineModel", cleaned_input):
        super().save(info, instance, cleaned_input)

        # save에서 바뀌는 track_inventory에 맞게 allocate, deallocate등을 수행함.
        country_code = settings.DEFAULT_COUNTRY
        # 재고로 바뀌는 경우
        if instance.track_inventory:
            allocate_stock(instance, country_code, instance.quantity)
        # 위탁으로 바뀌는 경우
        else:
            instance.allocations.all().delete()

        # instance.sales_stats의 모든 track_inventory 값을 instance.track_inventory 값으로 바꾼다.
        instance.sales_stats.update(track_inventory=instance.track_inventory)

        # 만약 orderline에 연결된 purchase_order_line이 존재하면 삭제한다.
        if instance.purchase_order_line:
            purchase_order_line = instance.purchase_order_line
            purchase_order = purchase_order_line.purchase_order

            # purchase_order_line.purchases가 존재하는지 확인
            if purchase_order_line.purchases.exists():
                purchase_order_line.purchases.all().delete()

            # 발주서에 해당 항목 제거
            purchase_order_line.delete()

            # purchase_order에 남아있는 purchase_order_line의 개수가 1개인 경우 purchase_order도 삭제
            if purchase_order.lines.count() == 0:
                purchase_order.delete()

            instance.purchase_order_line = None

    @classmethod
    def post_save_action(cls, info, instance: "OrderLineModel", cleaned_input):
        if instance.track_inventory:
            before_track_inventory_str = "위탁"
            after_track_inventory_str = "재고"
        else:
            before_track_inventory_str = "재고"
            after_track_inventory_str = "위탁"

        order_event_parameters = {
            "order_line": instance.composed_id_with_prefix,
            "sku": instance.product_sku,
            "before_track_inventory_str": before_track_inventory_str,
            "after_track_inventory_str": after_track_inventory_str,
            "is_after_fulfilled": False,
        }

        models.OrderEvent.objects.create(
            order=instance.order,
            user=info.context.user,
            type=OrderEvents.CHANGE_ORDER_LINE_TRACK_INVENTORY,
            parameters=order_event_parameters,
        )


