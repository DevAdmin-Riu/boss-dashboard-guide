        update_brand_product_list = []
        update_brand_product_variant_list = []
        for detail in details:
            sku = detail.get("product_sku")
            pv = product_variant_dict[sku]
            brand_product_variant = brand_product_variant_dict.get(sku)
            brand_product = None
            if brand_product_variant:
                brand_product = brand_product_variant.brand_product
            else:
                brand_product = None
            can_sale_by_inner = detail.get("can_sale_by_inner")
            if can_sale_by_inner is not None:
                pv.can_sale_by_inner = can_sale_by_inner
            qty_per_box = detail.get("qty_per_box")
