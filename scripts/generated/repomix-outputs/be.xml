class StockDetailEventFilter(django_filters.FilterSet):
    def filter_date(qs, _, value):
        return filter_range_field(qs, "date__date", value)

    def filter_stocked_date(qs, _, value):
        return filter_range_field(qs, "stocked_date__date", value)

    def filter_variant_id(qs, _, value):
        if value:
            _, variant_pk = graphene.Node.from_global_id(value)
            qs = qs.filter(stock__product_variant_id=variant_pk)
        return qs

    def filter_fbv_brand_id(qs, _, value):
        if value:
            _, brand_pk = graphene.Node.from_global_id(value)
            qs = qs.filter(stock__product_variant__brand_product_variants__brand_id=brand_pk)
        return qs

    def filter_fbv_vendor_id(qs, _, value):
        if value:
            _, vendor_pk = graphene.Node.from_global_id(value)
            qs = qs.filter(stock__product_variant__default_variant_vendor__vendor_id=vendor_pk)
        return qs

    def filter_is_fbv(qs, _, value):
        if value is not None:
            qs = qs.filter(stock__product_variant__product__is_fulfilled_by_vendor=value)
        return qs

    def filter_type(qs, _, value):
        if value:
            return qs.filter(type__in=value)
        return qs

    def filter_exclude_type(qs, _, value):
        if value:
            qs = qs.exclude(type__in=value)
        return qs

    def filter_product_search(qs, _, value):
        search_fields = [
            "stock__product_variant__sku",
            "stock__product_variant__product__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_vendor_search(qs, _, value):
        # 구조상 filter_vendor_search_factory 적용 못함.
        search_fields = ["parameters__vendor"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_to_location_search(qs, _, value):
        if value:
            # type이 PURCHASE, ETC_PURCHASE, TAKE_BACK, FULFILLMENT_CANCEL인 경우에는 parameters의 location 으로 검색
            location_filter = Q(
                type__in=[
                    StockDetailEvents.PURCHASE,
                    StockDetailEvents.ETC_PURCHASE,
                    StockDetailEvents.TAKE_BACK,
                    StockDetailEvents.FULFILLMENT_CANCEL,
                ]
            ) & Q(parameters__location__icontains=value)

            # type이 COMBINE, DIVIDE인 경우에는 parameters의 to_location 으로 검색
            to_location_filter = Q(
                type__in=[StockDetailEvents.COMBINE, StockDetailEvents.DIVIDE]
            ) & Q(parameters__to_location__icontains=value)

            # type이 MOVE인 경우에는 parameters의 to_location_qty_info 으로 검색
            # to_location_qty_info: "locationA: quantityA, locationB: quantityB, ..." 형태
            to_location_qty_info_filter = Q(type=StockDetailEvents.MOVE) & Q(
                parameters__to_location_qty_info__icontains=value
            )

            qs = qs.filter(location_filter | to_location_filter | to_location_qty_info_filter)

        return qs

    date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_date)
    stocked_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_stocked_date)
    variant_id = GlobalIDFilter(method=filter_variant_id)
    fbv_brand_id = GlobalIDFilter(method=filter_fbv_brand_id)
    fbv_vendor_id = GlobalIDFilter(method=filter_fbv_vendor_id)
    stock = GlobalIDFilter(field_name="stock_id")
    type = ListObjectTypeFilter(input_class=StockDetailEventsEnum, method=filter_type)
    exclude_type = ListObjectTypeFilter(
        input_class=StockDetailEventsEnum, method=filter_exclude_type
    )
    product_search = django_filters.CharFilter(method=filter_product_search)
    vendor_search = django_filters.CharFilter(method=filter_vendor_search)
    to_location_search = django_filters.CharFilter(method=filter_to_location_search)
    is_fbv = django_filters.BooleanFilter(method=filter_is_fbv)

    class Meta:
        model = StockDetailEvent
        fields = []


