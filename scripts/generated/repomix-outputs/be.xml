from datetime import datetime

from django.conf import settings
from django.core.exceptions import ValidationError
from django.db import models
from django.db.models import JSONField  # type: ignore
from django.utils.timezone import now

from ..account.models import Address, PossiblePhoneNumberField, User
from ..core.models import SentEmailModel, SortableModel
from ..core.permissions import PurchaseOrderPermissions
from ..core.utils.filename import (
    upload_to_for_delivery_confirm_doc,
    upload_to_for_inspect_report,
    upload_to_for_po_line_shipment_inspection_sent_email,
    upload_to_for_po_lines_invoice_sent_email,
    upload_to_for_purchase_order_sent_email,
)
from ..core.utils.json_serializer import CustomJsonEncoder
from ..product import ORDER_QTY_DECIMAL_PLACES, ORDER_QTY_MAX_DIGITS
from ..product.models import ProductVariant
from ..vendor.models import Vendor
from . import (
    PURCHASE_OREDER_CODE_PREFIX,
    PURCHASE_OREDER_INSPECT_CODE_PREFIX,
    STOCKABLE_PO_EVENT_TYPES,
    PoLineVendorOrderStatus,
    PurchaseOrderEventType,
    PurchaseOrderLineInspectResult,
    PurchaseOrderLineStatus,
    PurchaseOrderManageEventType,
)


class PurchaseOrder(models.Model):
    VERSION_1_0 = 1  # 2025-03-13 배포 이전 빌드에서 생성된 발주서 버전
    VERSION_2_0 = 2  # since 2025-03-13 배포예정~
    LATEST_VESRSION = 2

    version = models.IntegerField(default=VERSION_1_0)

    def is_take_back_decrease_stock_fix_version(self):
        return self.version >= self.VERSION_2_0

    # 발주 담당자
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
        related_name="+",
    )
    vendor = models.ForeignKey(
        Vendor,
        related_name="purchase_orders",
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
    )
    # 발주시점 snapshot 으로 정보 저장
    vendor_data = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    created = models.DateTimeField(default=now, editable=False)
    purchase_order_date = models.DateField(null=True, blank=True)
    is_sent = models.BooleanField(default=False)
    # 분할 납품 요청 시 복사될 경우 이전 발주서 정보 저장
    parent = models.ForeignKey(
        "self", null=True, blank=True, related_name="children", on_delete=models.CASCADE
    )
    event_type = models.CharField(
        max_length=30,
        choices=PurchaseOrderEventType.choices,
        default=PurchaseOrderEventType.INITIAL_ORDER,
    )

    # 재고 보관 상품 발주서 납품 장소 정보
    #   납품장소가 다른 경우 별도로 발주 등록
    #   내부 물류창고가 아닌 외부 업체가 납품 장소인 경우에는 warehouse 가 null 로 저장
    # 위탁, 취소 발주에서는 사용 안함
    warehouse = models.ForeignKey(
        "warehouse.Warehouse",
        related_name="purchase_orders",
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
    )
    # 재고 보관 상품 발주서 납품 장소 물류 주소
    warehouse_address = models.ForeignKey(
        Address,
        related_name="+",
        null=True,
        blank=True,
        on_delete=models.PROTECT,
    )
    delivery_warehouse_name = models.CharField(max_length=50, blank=True)
    delivery_warehouse_manager = models.CharField(max_length=50, blank=True)
    phone = PossiblePhoneNumberField(blank=True, default="")
    street_address_1 = models.CharField(max_length=256, blank=True)
    street_address_2 = models.CharField(max_length=256, blank=True)
    postal_code = models.CharField(max_length=20, blank=True)

    # 발주서 메모 관리
    note = models.TextField(null=True, blank=True)
    # 선주문 불가. True인 경우 입고전 보스몰에서 주문 불가
    is_not_orderable_before_stocked = models.BooleanField(default=False)
    # 패키지 구성품(화물차를 위한 재고발주)을 위한 발주서인 경우.
    is_for_package_order = models.BooleanField(default=False)
    is_b2b = models.BooleanField(default=False)

    @property
    def code(self):
        return f"{PURCHASE_OREDER_CODE_PREFIX}{str(self.pk).zfill(7)}"

    def __str__(self):
        return f"{self.code}"

    class Meta:
        ordering = ("-pk",)
        permissions = (
            (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER.codename, "발주서 관리"),
            (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER_STOCK.codename, "발주서 재고 입고"),
            (
                PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER_STATUS.codename,
                "발주서 입고 상태 변경",
            ),
            (
                PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER_EMAIL_SEND.codename,
                "발주서 메일 전송",
            ),
        )

    @property
    def is_track_inventory_po(self):
        event_type = self.event_type
        return event_type in STOCKABLE_PO_EVENT_TYPES

    @property
    def is_initial_order(self):
        return self.event_type == PurchaseOrderEventType.INITIAL_ORDER

    @property
    def is_take_back_po(self):
        return self.event_type == PurchaseOrderEventType.TAKE_BACK

    @property
    def is_consignment_po(self):
        return self.event_type == PurchaseOrderEventType.CONSIGNMENT

    @property
    def is_consignment_take_back_po(self):
        return self.event_type == PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK


class PurchaseOrderLine(SortableModel):
    purchase_order = models.ForeignKey(
        PurchaseOrder, related_name="lines", editable=False, on_delete=models.CASCADE
    )
    asking_purchase_date = models.DateField(null=True, blank=True)

    variant = models.ForeignKey(
        ProductVariant,
        related_name="purchase_order_lines",
        on_delete=models.SET_NULL,
        blank=True,
        null=True,
    )

    variant_name = models.CharField(max_length=386, default="", blank=True)

    product_sku = models.CharField(max_length=255)
    product_name = models.CharField(max_length=386)

    external_sku = models.CharField(max_length=100, blank=True)
    external_product_name = models.CharField(max_length=255, blank=True)

    # 발주 수량 (위탁 상품인 경우 OrderLine quantity)
    quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
        default=0,
    )

    # 입고 예정일(협력사에게 제공받은 예정일. 기본값은 입고요청일과 동일하게 한다.)
    expected_purchase_date = models.DateField(null=True, blank=True)
    # 협력사에 의한 납품예정일 변경 요청일
    req_epd_update = models.DateField(null=True, blank=True)
    # 협력사에 의한 납품예정일 변경 사유
    req_epd_update_reason = models.TextField(null=True, blank=True)
    # 협력사에 의한 거부 사유
    reject_reason = models.TextField(null=True, blank=True)

    status = models.CharField(
        max_length=30,
        choices=PurchaseOrderLineStatus.choices,
        default=PurchaseOrderLineStatus.DRAFT,
    )
    # 분할 납품 요청 시 복사될 경우 이전 발주서 제품 정보 저장
    parent = models.ForeignKey(
        "self", null=True, blank=True, related_name="children", on_delete=models.CASCADE
    )

    # 각 발주 타입별 매입데이터 기준일
    #   * 초도,재발주인 경우 실제 상품 입고일로 세팅 - 부분입고 적용하면서 최종 입고일의 의미가 됨
    #   * 위탁 발주인 경우 출고일로 세팅
    #   * 반품 발주인 경우 발주일로 세팅
    #   * b2b 발주인 경우 발주일로 세팅
    purchase_date = models.DateField(null=True, blank=True)
    # 초도,재발주인 경우 실제 상품 입고 운영자
    # 위탁, 반품, b2b인 경우 발주서 생성 운영자
    purchase_user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
        related_name="+",
    )
    # 초도,재발주인 경우 실제 상품 입고 수량: 출고 지시 시점에 세팅되고 입고 시점에는 수량 변경 불가
    # 위탁발주, 반품발주인 경우 발주서 생성시 발주 수량으로 세팅
    purchase_quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
        default=0,
    )
    # 위탁 반품 발주의 경우 누적 반품 수량 - 재고상품은 stock_detail 의 remain_quantity 를 사용하지만, 위탁상품은 그럴 수 없어서 반품 수량 누적 구조 필요
    take_back_quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
        default=0,
    )
    # 재고반품발주서 전용: 반품재고 location
    take_back_rack_location = models.ForeignKey(
        "warehouse.RackLocation",
        null=True,
        blank=True,
        default=None,
        on_delete=models.SET_NULL,
        related_name="+",
    )
    # 재고반품발주서 전용: 반품발주서 작성 원 발주상세
    take_back_purchase_order_line = models.ForeignKey(
        "self", null=True, blank=True, default=None, on_delete=models.CASCADE, related_name="+"
    )

    attribute_data = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    # 위탁 발주의 경우에만 ProductVariantVendor의  consignment_product_price_exclude_vat, consignment_delivery_fee_exclude_vat snapshot 으로 저장
    # 상품가 (부가세 별도, 위탁일때만 값 존재)"
    product_price_exclude_vat = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
