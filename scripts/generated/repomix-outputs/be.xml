from decimal import Decimal
from math import ceil
from typing import TYPE_CHECKING

from ...core.utils.math import my_round

if TYPE_CHECKING:
    from ...product.models import ProductVariant


def calc_pack_count_by_qty_per_box_value(inner_qty_per_box, outer_qty_per_box):
    if inner_qty_per_box is None or outer_qty_per_box is None:
        return Decimal(0)
    if inner_qty_per_box <= 0 or outer_qty_per_box <= 0:
        return Decimal(0)
    return ceil(outer_qty_per_box / inner_qty_per_box)


def calc_pack_count(inner_variant: "ProductVariant", outer_variant: "ProductVariant"):
    if inner_variant is None or outer_variant is None:
        return Decimal(0)
    if inner_variant.qty_per_box is None or outer_variant.qty_per_box is None:
        return Decimal(0)
    if inner_variant.qty_per_box <= 0 or outer_variant.qty_per_box <= 0:
        return Decimal(0)
    return calc_pack_count_by_qty_per_box_value(
        inner_variant.qty_per_box, outer_variant.qty_per_box
    )


def convert_to_outer_quantity(inner_quantity: int, pack_count: int):
    if inner_quantity <= 0 or pack_count <= 0:
        return 0
    return my_round(inner_quantity / pack_count, 1)


def calc_outer_cost_by_inner_cost(inner_cost: Decimal, pack_count: int):
    if pack_count <= 0:
        return None

    return my_round(inner_cost * pack_count)


def calc_inner_cost_by_outer_cost(outer_cost: Decimal, pack_count: int):
    if pack_count <= 0:
        return None

    return my_round(outer_cost / pack_count)


def calc_inner_cost_by_outer_variant(outer_variant: "ProductVariant", pack_count: int):
    if outer_variant is None:
        return None
    if outer_variant.cost_price_exclude_vat is None:
        return None

    return calc_inner_cost_by_outer_cost(outer_variant.cost_price_exclude_vat, pack_count)
