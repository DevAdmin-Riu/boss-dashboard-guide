def get_inicis_payment(
    checkout_id: str,
    check_if_active=True,
) -> Optional["Payment"]:
    if checkout_id is None or not checkout_id.strip():
        logger.warning("Missing checkout ID. Reference %s", checkout_id)
        return None
    try:
        _type, db_checkout_id = from_global_id(checkout_id)
    except Exception:
        logger.warning(
            "Unable to decode the checkout ID %s",
            checkout_id,
        )
        return None
    payments = (
        payment_models.Payment.objects.prefetch_related("order", "checkout")
        .select_for_update(of=("self",))
        .filter(checkout_id=db_checkout_id, gateway=INICIS_GATEWAY_PLUGIN_ID)
    )
    if check_if_active:
        payments = payments.filter(is_active=True)
    payment = payments.first()
    if not payment:
        logger.warning(
            "Payment for %s (%s) was not found",
            checkout_id,
            db_checkout_id,
        )
    return payment


def get_inicis_refunded_at(pg_refund_response: InicisRefundResponse):
    refunded_at_str = pg_refund_response.prtcDate + pg_refund_response.prtcTime
    return datetime.datetime.strptime(refunded_at_str, "%Y%m%d%H%M%S").astimezone()


def get_inicis_receipt_url(payment: "Payment", gateway_response):
    tid = get_inicis_last_captured_tid(payment, gateway_response)
    if tid:
        return f"https://iniweb.inicis.com/receipt/iniReceipt.jsp?noTid={tid}"
    return None
