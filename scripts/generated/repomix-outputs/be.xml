def _get_vact_date_time_by_payment(payment: Payment):
    if payment.gateway == PaymentGatewayType.INICIS:
        return _get_inicis_vact_date_time_by_payment(payment)
    elif payment.gateway == PaymentGatewayType.TOSS:
        return _get_toss_vact_date_time_by_payment(payment)
    return None


def cancel_order_by_vbank_date_expired(payment: Payment, vact_date_datetime: datetime):
    now = kst_timezone_now()
    check_date = now.replace(hour=0, minute=0, second=0, microsecond=0)
    if check_date > vact_date_datetime:
        order = Order.objects.filter(pk=payment.order_id).first()
        if order is None:
            logger.error(
                f"check_cancel_order order is invalid: {payment.id}:order_id={payment.order_id}"
            )
            return
        logger.info(
            f"check_cancel_order cancel_order: {payment.id}/{order.id}:vact_date={vact_date_datetime}"
        )
        cancel_order(order, None, cancel_type=OrderEvents.CANCELED_BY_VBANK_DATE_EXPIRED)


@app.task(name="order.tasks.check_cancel_order")
def check_cancel_order():
    target_payments_qs = (
        Payment.objects.annotate(upper_token=Upper("token"))
        .filter(
            charge_status=ChargeStatus.PENDING,
            upper_token__in=[INICIS_PAY_METHOD_VBANK, TOSS_PAY_METHOD_VBANK],
        )
        .exclude(order__status=OrderStatus.CANCELED)
    )
    target_payments = list(target_payments_qs)
    logger.info(f"check_cancel_order target_payments count: {len(target_payments)}")

    exception_count = 0
    for payment in target_payments:
        try:
            vact_date_time = _get_vact_date_time_by_payment(payment)
            if vact_date_time is not None:
                cancel_order_by_vbank_date_expired(payment, vact_date_time)
        except Exception as e:
            exception_count = exception_count + 1
            logger.error(f"check_cancel_order error: {e}")

    if exception_count > 0:
        logger.error(f"check_cancel_order exception_count: {exception_count}")
