from django.db import transaction


class BpSkuSequence(models.Model):
    brand = models.OneToOneField(
        "account.Brand", on_delete=models.CASCADE, related_name="bp_sku_sequence"
    )
    last_number = models.PositiveIntegerField(default=0)

    @classmethod
    @transaction.atomic
    def get_next_number(cls, brand):
        seq, _ = cls.objects.select_for_update().get_or_create(brand=brand)
        seq.last_number += 1
        seq.save()
        return seq.last_number


class BpSkuMixin(models.Model):
    bp_sku = models.CharField(max_length=30, editable=False, blank=True, unique=True)

    class Meta:
        abstract = True

    # bulk_create 로직에서는 save 가 호출되지 않으므로 수동 호출 필요
    def generate_bp_sku(self):
        """bulk_create 같은 경우를 위해 수동으로 호출"""
        if not self.bp_sku:
            next_number = BpSkuSequence.get_next_number(self.brand)
            self.bp_sku = f"{self.brand.code}-{next_number:04d}"

    def save(self, *args, **kwargs):
        if not self.bp_sku:
            self.generate_bp_sku()
        super().save(*args, **kwargs)


if settings.DEBUG:
    from django.db.models.signals import class_prepared

    def ensure_brand_field(sender, **kwargs):
        if issubclass(sender, BpSkuMixin) and not sender._meta.abstract:
            if "brand" not in [f.name for f in sender._meta.local_fields]:
                raise TypeError(f"{sender.__name__} must define a ForeignKey 'brand' field.")

    class_prepared.connect(ensure_brand_field)


