import django_filters

from saleor.graphql.order.enums import OrderTypeEnum

from ....stats.models import CouriersDeliveryFee
from ...core.filters import ListObjectTypeFilter, ObjectTypeFilter
from ...core.types import FilterInputObjectType
from ...core.types.common import DateRangeInput
from ...order.utils import filter_order_search_factory
from ...product.enums import BoxSizeTypeEnum
from ...utils.filters import filter_by_query_param, filter_range_field


class CouriersDeliveryFeeFilter(django_filters.FilterSet):

    def filter_order_search(qs, _, value):
        return filter_order_search_factory(field_name="order_id")(qs, _, value)

    def filter_product_search(qs, _, value):
        search_fields = [
            "product_info__product_sku",
            "product_info__product_name",
            "product_info__brand_product_name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_box_size_type(qs, _, value):
        if value:
            return qs.filter(product_info__box_size_type__in=[item for item in value])
        return qs

    def filter_tracking_number(qs, _, value):
        # value에서 하이픈("-")을 제거한 tracking_number을 찾아서 필터링합니다.
        if value:
            tracking_number = value.replace("-", "")
            return qs.filter(delivery_info__tracking_number=tracking_number)
        return qs

    def filter_is_return(qs, _, value):
        if value is not None:
            return qs.filter(is_return=value)
        return qs

    def filter_created(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    def filter_collected_at(qs, _, value):
        return filter_range_field(
            qs.filter(is_collected_corrected=True), "collected_at__date", value
        )

    def filter_order_type(qs, _, value):
        if value:
            return qs.filter(order__type__in=value)
        return qs

    order_search = django_filters.CharFilter(method=filter_order_search)
    product_search = django_filters.CharFilter(method=filter_product_search)
    box_size_type = ListObjectTypeFilter(input_class=BoxSizeTypeEnum, method=filter_box_size_type)
    tracking_number = django_filters.CharFilter(method=filter_tracking_number)
    is_return = django_filters.BooleanFilter(method=filter_is_return)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created)
    collected_at = ObjectTypeFilter(input_class=DateRangeInput, method=filter_collected_at)
    order_type = ListObjectTypeFilter(input_class=OrderTypeEnum, method=filter_order_type)

    class Meta:
        model = CouriersDeliveryFee
        fields = []


class CouriersDeliveryFeeFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = CouriersDeliveryFeeFilter
