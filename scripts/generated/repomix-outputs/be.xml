class RackStockDetail(models.Model):
    location = models.ForeignKey(
        RackLocation, null=False, on_delete=models.CASCADE, related_name="rack_stocks"
    )
    # 제품 입고하지 않고 창고 정리하면서 제품 이동을 위한 로케이션 설정 시 제품 코드는 있으나, 입고 내역은 없는 자리가 생길 수 있음
    product_variant = models.ForeignKey(
        ProductVariant, null=False, on_delete=models.CASCADE, related_name="rack_stocks"
    )
    stock_detail = models.ForeignKey(
        StockDetail, null=True, on_delete=models.SET_NULL, related_name="rack_stocks"
    )
    remain_quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
        default=0,
    )
    objects = RackStockDetailQuerySet.as_manager()
    memo = models.TextField(blank=True)
    memo_updated_at = models.DateTimeField(null=True, blank=True, default=None)
    memo_updated_writer = models.ForeignKey(
        User,
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
        related_name="+",
    )

    class Meta:
        unique_together = (("location", "product_variant", "stock_detail"),)

    def increase_remain_stock(self, quantity: int, source_rsd: "RackStockDetail" = None):
        self.remain_quantity = self.remain_quantity + quantity
        if (
            source_rsd
            and source_rsd.memo_updated_writer is not None
            and self.memo_updated_writer is None
        ):
            self.memo = source_rsd.memo
            self.memo_updated_at = source_rsd.memo_updated_at
            self.memo_updated_writer = source_rsd.memo_updated_writer
            RackStockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") + quantity,
                memo=source_rsd.memo,
                memo_updated_at=source_rsd.memo_updated_at,
                memo_updated_writer=source_rsd.memo_updated_writer,
            )
        else:
            RackStockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") + quantity
            )

    def increase_remain_stock_with_stock_detail(
        self, quantity: int, stock_detail: StockDetail, source_rsd: "RackStockDetail" = None
    ):
        self.remain_quantity = self.remain_quantity + quantity
        if (
            source_rsd
            and source_rsd.memo_updated_writer is not None
            and self.memo_updated_writer is None
        ):
            self.memo = source_rsd.memo
            self.memo_updated_at = source_rsd.memo_updated_at
            self.memo_updated_writer = source_rsd.memo_updated_writer
            RackStockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") + quantity,
                stock_detail=stock_detail,
                memo=source_rsd.memo,
                memo_updated_at=source_rsd.memo_updated_at,
                memo_updated_writer=source_rsd.memo_updated_writer,
            )
        else:
            RackStockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") + quantity, stock_detail=stock_detail
            )

    def decrease_remain_stock(self, quantity: int):
        self.remain_quantity = self.remain_quantity - quantity
        if self.remain_quantity <= 0:
            rack_location_count = RackStockDetail.objects.filter(
                location_id=self.location_id, product_variant_id=self.product_variant_id
            ).count()
            if rack_location_count > 1 or self.location.is_only_can_stock:
                self.delete()
            else:
                RackStockDetail.objects.filter(pk=self.pk).update(
                    remain_quantity=0, stock_detail=None
                )
        else:
            RackStockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") - quantity
            )

    # 부자재 재고 감소: 음수 허용
    def decrease_remain_stock_for_sub_pv(self, quantity: int):
        self.remain_quantity = self.remain_quantity - quantity
        RackStockDetail.objects.filter(pk=self.pk).update(
            remain_quantity=F("remain_quantity") - quantity
        )


