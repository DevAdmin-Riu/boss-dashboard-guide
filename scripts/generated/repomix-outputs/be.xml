from collections import defaultdict

from ...checkout.models import Checkout, CheckoutLine
from ..core.dataloaders import DataLoader


class CheckoutLinesByCheckoutTokenLoader(DataLoader):
    context_key = "checkoutlines_by_checkout"

    def batch_load(self, keys):
        lines = list(
            CheckoutLine.objects.filter(checkout_id__in=keys)
            .select_related(
                "variant",
                "variant__product",
                "variant__product__product_type",
                "brand_product_variant",
                "brand_product_variant__brand",
                "brand_product_variant__brand_product",
            )
            .prefetch_related("checkout")
        )
        line_map = defaultdict(list)
        for variant in lines:
            line_map[variant.checkout_id].append(variant)
        return [line_map.get(checkout_id, []) for checkout_id in keys]


class PluginManagerLoader(DataLoader):
    context_key = "plugin_manager"

    def batch_load(self, keys):
        from ...plugins.manager import get_plugins_manager

        plugin_manager = get_plugins_manager()

        return [plugin_manager for _ in keys]


class CheckoutByTokenLoader(DataLoader):
    context_key = "checkout_by_token"

    def batch_load(self, keys):
        checkouts = Checkout.objects.filter(token__in=keys)
        return [checkouts.get(token) for token in keys]
