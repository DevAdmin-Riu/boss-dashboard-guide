# 최소주문 수량, 배수 주문, 교차 주문을 위한 주문 수량 체크는 CheckoutLinesUpdate mutation 에서 처리할 수 없으므로 CheckoutPaymentCreate 에서 처리함
def check_line_quantity_with_moq(variant: ProductVariantModel, quantity, bp_name=None):
    product = variant.product
    allow_mixed_multiple_of_uoq = product.allow_mixed_multiple_of_uoq
    if allow_mixed_multiple_of_uoq == True:
        return

    moq = product.moq
    if quantity < moq:
        moq = convert_qty_precision_with_product(moq, product)
        raise ValidationError(
            f"{variant.display_product(bp_name=bp_name)} 상품의 주문 수량은 최소 주문 수량({moq}개)보다 커야합니다.",
            code=PaymentErrorCode.INVALID,
        )


def check_line_quantity_with_multiple_of_uoq(variant: ProductVariantModel, quantity, bp_name=None):
    product = variant.product
    allow_mixed_multiple_of_uoq = product.allow_mixed_multiple_of_uoq
    if allow_mixed_multiple_of_uoq == True:
        return

    moq = product.moq
    uoq = product.uoq
    is_multiple = is_integer_multiple(quantity - moq, uoq)
    if is_multiple == False:
        uoq = convert_qty_precision_with_product(uoq, product)
        raise ValidationError(
            f"{variant.display_product(bp_name=bp_name)} 상품은 배수 주문 상품입니다. (주문 수량 - 최소주문수량)을 {uoq}의 정수 배수로 입력해주세요.",
            code=PaymentErrorCode.INVALID,
        )


def check_lines_quantity_with_allow_mixed_multiple_of_uoq(
    variants: List[ProductVariantModel],
    bp_bundles: List[BpBundleModel],
    quantities,
    bpv_list: List[BrandProductVariantModel],
):
    allow_mixed_multiple_of_uoq_items = []
    allow_mixed_multiple_of_uoq_items_bpvs = []

    for variant, bp_bundle, quantity, bpv in zip(variants, bp_bundles, quantities, bpv_list):
        if bp_bundle:
            continue
        product = variant.product
        allow_mixed_multiple_of_uoq = product.allow_mixed_multiple_of_uoq
        if allow_mixed_multiple_of_uoq == False:
            continue

        uoq = product.uoq
        moq = product.moq
        product_obj = {
            "variant": variant,
            "product_total_quantity": quantity,
            "moq": moq,
            "uoq": uoq,
        }

        result = None
        for item in allow_mixed_multiple_of_uoq_items:
            variant: ProductVariantModel = item["variant"]
            if variant.product == product:
                result = item
                break

        if result:
            result["product_total_quantity"] += quantity
        else:
            allow_mixed_multiple_of_uoq_items.append(product_obj)
            allow_mixed_multiple_of_uoq_items_bpvs.append(bpv)

    for item, bpv in zip(allow_mixed_multiple_of_uoq_items, allow_mixed_multiple_of_uoq_items_bpvs):
        variant: ProductVariantModel = item["variant"]
        product = variant.product
        product_total_quantity = item["product_total_quantity"]
        uoq = item["uoq"]
        moq = item["moq"]

        if product_total_quantity < moq:
            moq = convert_qty_precision_with_product(moq, product)
            bp_name = bpv.brand_product.name if bpv else None
            raise ValidationError(
                f"{variant.display_product(bp_name=bp_name)} 상품은 배수 및 교차 주문 상품입니다. 주문 수량은 최소 주문 수량({moq}개)보다 커야합니다.",
                code=PaymentErrorCode.INVALID,
            )

        is_multiple = is_integer_multiple(product_total_quantity - moq, uoq)
        if is_multiple == False:
            uoq = convert_qty_precision_with_product(uoq, product)
            bp_name = bpv.brand_product.name if bpv else None
            raise ValidationError(
                f"{variant.display_product(bp_name=bp_name)} 상품은 배수 및 교차 주문 상품입니다. (해당 상품 옵션들의 주문 수량 합계 - 최소주문수량) 을 {uoq}의 정수 배수가 되도록 입력해주세요.",
                code=PaymentErrorCode.INVALID,
            )


# ExtendedCheckoutComplete 내부 호출 용도로만 사용: 프론트엔드에서 단독 호출 금지
class CheckoutPaymentCreate(BaseMutation, I18nMixin):
    checkout = graphene.Field(Checkout, description="Related checkout object.")
    payment = graphene.Field(Payment, description="A newly created payment.")

    class Arguments:
        checkout_id = graphene.ID(description="Checkout ID.", required=True)
        input = PaymentInput(description="Data required to create a new payment.", required=True)

    class Meta:
        description = "Create a new payment for given checkout."
        error_type_class = common_types.PaymentError
        error_type_field = "payment_errors"

    @classmethod
    def validate_payment_amount(
        cls, checkout: CheckoutModel, checkout_total, amount, credits, rcoins
    ):
        if amount + credits + rcoins != checkout_total.gross.amount:
            logger.info(
                "payment_debug: 결제금액={amount} + {credits} + {rcoins} != 장바구니 토탈={checkout_total.gross.amount}"
            )
            raise ValidationError(
                "상품 가격이 변경되어 구매할 수 없습니다. 장바구니의 상품을 다시 담고 시도해주세요."
            )
        # 직거래 상품 주문인 경우 포인트 사용 불가
        checkout_lines = checkout.get_selected_lines()
        if any(line.is_fulfilled_by_vendor and rcoins > 0 for line in checkout_lines):
            raise ValidationError("직거래 상품 주문 시 포인트를 사용할 수 없습니다.")

    @classmethod
    def validate_bpv_displayed_in_stores(
        cls, checkout: CheckoutModel, only_selected_checkout_lines: List[CheckoutLineModel]
    ):
        # 보스몰 주문이 아니면 상품-매장 진열관계 체크 안함
        if checkout.order_type != OrderType.BY_USER:
            return

        user: "User" = checkout.user
        errors = []
        brand_store = user.brand_store
        for line in only_selected_checkout_lines:
            bpv: BrandProductVariantModel = line.brand_product_variant
            if line.bp_bundle or not bpv:
                continue
            displayed_qs = bpv.displayed_in_stores.all()
            if displayed_qs.exists() and (
                not brand_store or not displayed_qs.filter(pk=brand_store.pk).exists()
            ):
                errors.append(bpv.bp_sku)

        if errors:
            error_bp_sku_codes = ", ".join(errors)
            raise ValidationError(
                f"더 이상 매장에서 판매할 수 없는 상품이 장바구니에 포함되어 있습니다. 장바구니에서 제거 후 다시 시도해 주세요. {error_bp_sku_codes}"
            )

    @classmethod
    def validate_minus_credits(
        cls, checkout: CheckoutModel, only_selected_checkout_lines: List[CheckoutLineModel]
    ):
        # 보스몰 주문이 아니면 충전금 음수여도 주문 허용
        # 가맹본부 대행주문인 경우에는 가맹본부의 충전금이 차감되므로 가맹점 충전금 음수 여부는 체크 안함
        if checkout.order_type != OrderType.BY_USER:
            return
        user: User = checkout.user
        if user.credits_incl_non_cashable < 0:
            invalid = any(
                line.bp_bundle or (line.variant and line.variant.is_for_credits_refill == False)
                for line in only_selected_checkout_lines
            )
            if invalid:
                raise ValidationError(
                    "충전금이 (-) 마이너스 상태여서 주문처리할 수 없습니다. 충전금을 충전한 후 다시 시도해 주세요."
                )

    @classmethod
    def validate_reverse_fee_deposit(
        cls, checkout: CheckoutModel, only_selected_checkout_lines: List[CheckoutLineModel]
    ):
        user: User = checkout.user
        brand = user.brand if user else None
        if brand and brand.is_reverse_fee_contract_type:
            non_fbv_only_selected_checkout_lines = [
                line
                for line in only_selected_checkout_lines
                if line.is_fulfilled_by_vendor is False
            ]
            non_fbv_subtotal_brand_cost = checkout_subtotal_brand_cost(
                checkout=checkout, lines=non_fbv_only_selected_checkout_lines
            )
            non_fbv_subtotal_delivery_additional_fee = checkout_subtotal_delivery_addtional_fee(
                checkout=checkout, lines=non_fbv_only_selected_checkout_lines
            )
            # 기타배송비항목(화물차, 소분비용)은 첫번째 line 에 모두 세팅되어서, 직거래 제품에 값이 세팅될 수도 있는 관계로 모든 라인 sum 으로 처리 필요
            total_etc_delivery_fee = checkout_subtotal_etc_delivery_fee(
                checkout=checkout, lines=only_selected_checkout_lines
            )
            decrease_deposit_amount = sum_of_reverse_fee_deposit_items(
                non_fbv_total_brand_cost=non_fbv_subtotal_brand_cost.gross.amount,
                non_fbv_subtotal_delivery_additional_fee=non_fbv_subtotal_delivery_additional_fee.gross.amount,
                total_etc_delivery_fee=total_etc_delivery_fee.gross.amount,
            )
            reverse_fee_deposit = brand.reverse_fee_deposit
            if (
                reverse_fee_deposit - decrease_deposit_amount
                < brand.reverse_fee_deposit_min_limitation
            ):
                raise ValidationError(
                    "가맹본부의 사정으로 인해 주문이 불가능합니다. 가맹본부에 직접 문의해주시기 바랍니다."
                )

    @classmethod
    def check_line_qty_consider_bundle(
        cls, checkout: "CheckoutModel", checkout_lines: List[CheckoutLineModel], country, order_type
    ):
        delivery_method = checkout.delivery_method
        # 기타 배송인 경우 주문 된 상품을 모아서 배송 처리하는 건이라서 재고제품도 재고 수가 부족 에러 체크 안하는 것이 운영 상 편하다는 정책 적용
        if delivery_method != OrderDeliveryMethods.BY_COURIER:
            return
        bp_bundles: List[BpBundleModel] = [line.bp_bundle for line in checkout_lines]
        pv_list: List[ProductVariantModel] = [line.variant for line in checkout_lines]
        quantities = [line.quantity for line in checkout_lines]
        bpv_list: List[BrandProductVariantModel] = [
            line.brand_product_variant if line.brand_product_variant else None
            for line in checkout_lines
        ]
        decrease_stock_flags = [line.decrease_stock_flag for line in checkout_lines]

        total_order_qty_dict = defaultdict(int)
        pv_dict_for_total_qty: Dict[str, "ProductVariantModel"] = {}
        bp_name_dict_for_total_qty: Dict[str, str] = {}
        for pv, bp_bundle, qty, bpv, decrease_stock_flag in zip(
            pv_list, bp_bundles, quantities, bpv_list, decrease_stock_flags
        ):
            if qty <= 0:
                raise ValidationError("주문 수량은 0보다 큰 숫자만 가능합니다.")
            settings.MAX_CHECKOUT_LINE_QUANTITY = settings.MAX_CHECKOUT_LINE_QUANTITY
            # 가맹본부 대행 주문 인 경우에도 주문 수량 제한 안 함
            if order_type == OrderType.BY_USER and qty > settings.MAX_CHECKOUT_LINE_QUANTITY:
                raise ValidationError(
                    "한 번에 주문 가능한 최대 수량은 %d개 입니다."
                    % settings.MAX_CHECKOUT_LINE_QUANTITY
                )

            if decrease_stock_flag == False:
                continue

            if not bp_bundle:
                if pv.track_inventory == False:
                    continue
                pv_dict_for_total_qty[pv.sku] = pv
                bp_name_dict_for_total_qty[pv.sku] = bpv.brand_product.name if bpv else None
                total_order_qty_dict[pv.sku] += qty
            else:
                bp_bundle_infos: List[BpBundleInfoModel] = bp_bundle.bp_bunde_infos_by_prefetched
                for bp_bundle_info in bp_bundle_infos:
                    pv = bp_bundle_info.pv
                    pv_dict_for_total_qty[pv.sku] = pv
                    bp_name_dict_for_total_qty[pv.sku] = bp_bundle.name
                    total_order_qty_dict[pv.sku] += qty * bp_bundle_info.quantity

            if not bp_bundle and order_type != OrderType.BY_STAFF_FOR_B2B_TAKE_BACK:
                bp_name = bpv.brand_product.name if bpv else None
                check_line_quantity_with_moq(pv, qty, bp_name)
                check_line_quantity_with_multiple_of_uoq(pv, qty, bp_name)

        check_lines_quantity_with_allow_mixed_multiple_of_uoq(
            pv_list, bp_bundles, quantities, bpv_list=bpv_list
        )

        for pv_sku, total_order_qty in total_order_qty_dict.items():
            pv = pv_dict_for_total_qty.get(pv_sku)
            bp_name = bp_name_dict_for_total_qty.get(pv_sku)
            try:
                check_stock_quantity_by_contury(pv, country, total_order_qty, bp_name=bp_name)
            except InsufficientStock as e:
                orderable_quantity = get_orderable_qty(e.item, country, until_short_term=True)
                message = "" + "%(item_name)s 의 재고가 부족합니다. %(remaining)d 개의 재고가 남아있습니다.(입고 예정 수량 포함)" % {
                    "remaining": orderable_quantity,
                    "item_name": e.item.display_product(bp_name=e.bp_name),
                }
                raise ValidationError(message)

    @classmethod
    def process_checkout_lines(
        cls, checkout: "CheckoutModel", checkout_lines: List[CheckoutLineModel], country, order_type
    ):
        validate_deferred_pv(checkout, checkout_lines)
        cls.check_line_qty_consider_bundle(checkout, checkout_lines, country, order_type)

    @classmethod
    def perform_mutation(cls, _root, info, checkout_id, **data):
        logger.info(
            f"payment_debug: payment.CheckoutPaymentCreate mutation {checkout_id} ===== payment start!!!"
        )

        checkout_id = from_global_id_strict_type(
            checkout_id, only_type=Checkout, field="checkout_id"
        )
        checkout: CheckoutModel = (
            models.Checkout.objects.select_related("user", "user__brand")
            .prefetch_related(
                "lines__variant__product__collections",
                "lines__bp_bundle__bp_bundle_infos",
            )
            .get(pk=checkout_id)
        )

        only_selected_checkout_lines = checkout.get_selected_lines()

        cls.process_checkout_lines(
            checkout,
            checkout_lines=only_selected_checkout_lines,
            country=checkout.get_country(),
            order_type=checkout.order_type,
        )

        input_data = data["input"]
        gateway = input_data["gateway"]

        checkout_owner_user: User = checkout.user
        brand = checkout_owner_user.brand if checkout_owner_user else None

        order_type = checkout.order_type
        if order_type == OrderType.BY_USER:
            validate_brand_pg_info(gateway, brand)

        checkout_total = calculate_checkout_total(checkout=checkout)

        is_order_by_hq_staff = order_type == OrderType.BY_HQ_STAFF_FOR_BRAND
        is_order_by_staff = order_type != OrderType.BY_USER
        checkout_total_amount = checkout_total.gross.amount
        if is_order_by_hq_staff:
            amount = 0
            credits = checkout_total_amount
            rcoins = 0
        elif is_order_by_staff:
            amount = checkout_total_amount
            credits = 0
            rcoins = 0
        else:
            amount = input_data.get("amount", 0)
            credits = input_data.get("credits", 0)
            rcoins = input_data.get("rcoins", 0)

        clean_checkout_shipping_address(checkout)
        cls.validate_bpv_displayed_in_stores(checkout, only_selected_checkout_lines)
        cls.validate_minus_credits(checkout, only_selected_checkout_lines)
        cls.validate_reverse_fee_deposit(checkout, only_selected_checkout_lines)
        cls.validate_payment_amount(checkout, checkout_total, amount, credits, rcoins)

        extra_data = {
            "customer_user_agent": (
                f"스태프 주문: {order_type}"
                if is_order_by_staff
                else info.context.META.get("HTTP_USER_AGENT")
            ),
        }

        cancel_active_payments(checkout)

        cashable_credits, non_cashable_credits = divide_credits_by_cashable_and_non_cashable(
            checkout_owner_user=checkout_owner_user,
            credits=credits,
        )

        tax, taxfree = calculate_checkout_tax_and_taxfree(
            checkout=checkout,
            lines=only_selected_checkout_lines,
            pay_cashable_credits=cashable_credits,
            pay_rcoins=rcoins,
        )

        payment = create_payment(
            gateway=gateway,
            is_toss_riu_pay=False if amount <= 0 else input_data.get("is_toss_riu_pay", False),
            payment_token=input_data.get("token", ""),
            currency=settings.DEFAULT_CURRENCY,
            email=checkout_owner_user.email if checkout_owner_user else "",
            extra_data=extra_data,
            # FIXME this is not a customer IP address. It is a client storefront ip
            customer_ip_address=get_client_ip(info.context),
            checkout=checkout,
            return_url=input_data.get("return_url", ""),
            total=amount + credits + rcoins,
            amount=amount,
            cashable_credits=cashable_credits,
            non_cashable_credits=non_cashable_credits,
            rcoins=rcoins,
            tax=tax,
            taxfree=taxfree,
        )
        return CheckoutPaymentCreate(payment=payment, checkout=checkout)
