import logging
from collections import defaultdict
from typing import Dict, Iterable, List

import graphene
from django.core.exceptions import ObjectDoesNotExist, ValidationError
from django.db import transaction

from .... import settings
from ....core.permissions import WarehousePermissions
from ....warehouse import models
from ....warehouse.availability import (
    get_total_stock_quantity,
    get_total_stock_quantity_by_stock_details,
)
from ....warehouse.models import RackLocation as RackLocationModel
from ....warehouse.models import RackSector as RackSectorModel
from ....warehouse.models import StockDetail as StockDetailModel
from ...core.mutations import BaseMutation
from ...core.scalars import PositiveDecimal
from ...core.types.common import StockError
from ...product.bulk_mutations.utils import validate_data_is_non_null, validate_product_sku
from ..utils import make_rack_location_obj, make_rack_secotr_obj, make_rack_stock_detail_obj

logger = logging.getLogger()


class RackLocationSyncDetails(graphene.InputObjectType):
    sector_name = graphene.String(required=True, description="구역명")
    location_name = graphene.String(required=True, description="로케이션명")
    can_picking = graphene.Boolean(required=True, description="피킹 가능여부")
    can_stock = graphene.Boolean(required=True, description="입고 가능여부")
    product_sku = graphene.String(required=True, description="제품 코드")
    quantity = PositiveDecimal(required=True, description="재고 수")
    safety_picking_stock = PositiveDecimal(description="알림 발송을 위한 로케이션 기준 재고 수")


class RackLocationSyncInput(graphene.InputObjectType):
    details = graphene.List(
        RackLocationSyncDetails,
        required=True,
        description="제품 로케이션 별 수량 sync 데이터",
    )


class RackLocationSync(BaseMutation):
    class Arguments:
        input = RackLocationSyncInput(
            required=True, description="로케이션별 재고 수 sync 용 입력 데이터"
        )

    class Meta:
        description = "로케이션별 재고 수 sync"
        permissions = (WarehousePermissions.MANAGE_STOCKS,)
        error_type_class = StockError
        error_type_field = "stock_errors"

    @classmethod
    def make_detail_code(cls, detail):
        sector_name = detail.get("sector_name")
        location_name = detail.get("location_name")
        sku = detail.get("product_sku")
        return f"({sector_name}:{location_name}:{sku})"

    @classmethod
    def validate_value_empty(cls, details):
        sector_name_errors = []
        location_name_errors = []
        sku_errors = []
        quantity_errors = []
        for detail in details:
            sector_name = detail.get("sector_name")
            location_name = detail.get("location_name")
            sku = detail.get("product_sku")
            quantity = detail.get("quantity")
            detail_code = cls.make_detail_code(detail)

            if sector_name is None or sector_name == "":
                sector_name_errors.append(detail_code)
            if location_name is None or location_name == "":
                location_name_errors.append(detail_code)
            if sku is None or sku == "":
                sku_errors.append(detail_code)
            if quantity is None or quantity < 0:
                quantity_errors.append(detail_code)

        if len(quantity_errors) > 0:
            error_msg = "재고수량 오류 제품코드: {}".format(", ".join(quantity_errors))
            raise ValidationError(error_msg)
        if len(sku_errors) > 0:
            error_msg = "제품코드 오류 제품코드: {}".format(", ".join(sku_errors))
            raise ValidationError(error_msg)
        if len(location_name_errors) > 0:
            error_msg = "로케이션명 오류 제품코드: {}".format(", ".join(location_name_errors))
            raise ValidationError(error_msg)
        if len(sector_name_errors) > 0:
            error_msg = "구역명 오류 제품코드: {}".format(", ".join(sector_name_errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_stock_quantity(cls, details, product_variants):
        merged_by_sku = defaultdict(int)
        for detail in details:
            sku = detail.get("product_sku")
            quantity = detail.get("quantity")
            merged_by_sku[sku] += quantity

        errors = []
        country_code = settings.DEFAULT_COUNTRY
        for sku, quantity in merged_by_sku.items():
            variant = product_variants[sku]
            stock_quantity = get_total_stock_quantity(variant, country_code)
            if quantity != stock_quantity:
                errors.append(f"{sku}: 전체 재고 {quantity}!={stock_quantity}")
            stock_detail_quantity = get_total_stock_quantity_by_stock_details(variant)
            if quantity != stock_detail_quantity:
                errors.append(f"{sku}: 재고 상세 전체 재고 {quantity}!={stock_detail_quantity}")

        if errors:
            error_msg = "제품 재고 수량 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data):
        details = []
        details_input = input_data.get("details")
        for detail in details_input:
            sector_name = detail.get("sector_name")
            if sector_name:
                sector_name = sector_name.strip()
            location_name = detail.get("location_name")
            if location_name:
                location_name = location_name.strip()
            can_picking = detail.get("can_picking")
            can_stock = detail.get("can_stock")
            sku = detail.get("product_sku")
            quantity = detail.get("quantity")
            safety_picking_stock = detail.get("safety_picking_stock", 0)

            detail_line = {
                "sector_name": sector_name,
                "location_name": location_name,
                "can_picking": can_picking,
                "can_stock": can_stock,
                "product_sku": sku,
                "quantity": quantity,
                "safety_picking_stock": safety_picking_stock,
            }

            details.append(detail_line)

        validate_data_is_non_null(details)
        cls.validate_value_empty(details)

        _, product_variants, skus = validate_product_sku(details)

        cls.validate_stock_quantity(details, product_variants)

        return details, product_variants, skus

    @classmethod
    def clear_previous_rack_location_details(cls, skus):
        models.RackStockDetail.objects.filter(
            stock_detail__stock__product_variant__sku__in=skus
        ).delete()

    @classmethod
    def create_new_rack_sectors(cls, details):
        sector_names = set()
        for detail in details:
            sector_name = detail.get("sector_name")
            sector_names.add(sector_name)

        sorted_sector_names = sorted(sector_names)
        rack_sectors = {}
        create_list = []
        for sector_name in sorted_sector_names:
            try:
                rack_sector = models.RackSector.objects.get(name=sector_name)
                rack_sectors[sector_name] = rack_sector
            except ObjectDoesNotExist:
                rack_sector = make_rack_secotr_obj(name=sector_name)
                create_list.append(rack_sector)
                continue

        if create_list:
            created_rack_sectors: List[RackSectorModel] = models.RackSector.objects.bulk_create(
                create_list
            )
            for created_rack_sector in created_rack_sectors:
                rack_sectors[created_rack_sector.name] = created_rack_sector

        return rack_sectors

    @classmethod
    def create_new_rack_locations(cls, details, rack_sectors, make_detail_code_fn):
        errors = []
        sector_location_objects_dict: Dict[str, dict] = defaultdict(dict)
        for detail in details:
            sector_name = detail.get("sector_name")
            location_name = detail.get("location_name")
            can_picking = detail.get("can_picking")
            can_stock = detail.get("can_stock")
            safety_picking_stock = detail.get("safety_picking_stock")
            key = f"{sector_name}~{location_name}"
            if key not in sector_location_objects_dict:
                sector_location_objects_dict[key] = {
                    "sector_name": sector_name,
                    "location_name": location_name,
                    "can_picking": can_picking,
                    "can_stock": can_stock,
                    "safety_picking_stock": safety_picking_stock,
                    "detail_code": make_detail_code_fn(detail),
                }

        rack_locations = {}
        create_list = []
        update_list = []
        for _, sector_location_dict in sector_location_objects_dict.items():
            sector_name = sector_location_dict.get("sector_name")
            location_name = sector_location_dict.get("location_name")
            detail_code = sector_location_dict.get("detail_code")
            can_picking = sector_location_dict.get("can_picking")
            can_stock = sector_location_dict.get("can_stock")
            safety_picking_stock = sector_location_dict.get("safety_picking_stock")
            try:
                rack_location: RackLocationModel = models.RackLocation.objects.get(
                    name=location_name
                )
                if rack_location.sector != rack_sectors.get(sector_name):
                    errors.append(detail_code)
                else:
                    rack_locations[location_name] = rack_location
                    rack_location.can_picking = can_picking
                    rack_location.can_stock = can_stock
                    rack_location.safety_picking_stock = safety_picking_stock
                    update_list.append(rack_location)
            except ObjectDoesNotExist:
                sector = rack_sectors[sector_name]
                rack_location = make_rack_location_obj(
                    sector=sector,
                    name=location_name,
                    can_picking=can_picking,
                    can_stock=can_stock,
                    safety_picking_stock=safety_picking_stock,
                )
                create_list.append(rack_location)
                continue

        if len(errors) > 0:
            error_msg = "구역-로케이션명 오류: {}".format(", ".join(errors))
            raise ValidationError(error_msg)

        if create_list:
            created_rack_locations: List[RackLocationModel] = (
                models.RackLocation.objects.bulk_create(create_list)
            )
            for created_rack_location in created_rack_locations:
                rack_locations[created_rack_location.name] = created_rack_location

        if update_list:
            models.RackLocation.objects.bulk_update(
                update_list, ["can_picking", "can_stock", "safety_picking_stock"]
            )

        return rack_locations

    @classmethod
    def create_rack_location_details(cls, details, rack_locations, product_variants):
        create_list = []
        assigned_stock_details = {}
        for detail in details:
            location_name = detail.get("location_name")
            sku = detail.get("product_sku")
            quantity = detail.get("quantity")

            rack_location = rack_locations[location_name]
            variant = product_variants[sku]

            if quantity == 0:
                rack_stock_detail = make_rack_stock_detail_obj(
                    location=rack_location,
                    product_variant=variant,
                    stock_detail=None,
                    remain_quantity=0,
                )
                create_list.append(rack_stock_detail)
            else:
                stock_details_qs = models.StockDetail.objects.filter(
                    stock__product_variant=variant, remain_quantity__gt=0
                ).order_by("stocked_at")
                stock_details: Iterable[StockDetailModel] = list(stock_details_qs)

                remain_qty = quantity
                for stock_detail in stock_details:
                    assigned_stock_detail_qty = assigned_stock_details.get(stock_detail.id, 0)
                    stock_detail_remain_qty = (
                        stock_detail.remain_quantity - assigned_stock_detail_qty
                    )
                    location_qty = min(remain_qty, stock_detail_remain_qty)
                    if location_qty == 0:
                        continue

                    if stock_detail.id in assigned_stock_details.keys():
                        assigned_stock_details[stock_detail.id] += location_qty
                    else:
                        assigned_stock_details[stock_detail.id] = location_qty

                    remain_qty = remain_qty - location_qty
                    rack_stock_detail = make_rack_stock_detail_obj(
                        location=rack_location,
                        product_variant=variant,
                        stock_detail=stock_detail,
                        remain_quantity=location_qty,
                    )
                    create_list.append(rack_stock_detail)
                    if remain_qty <= 0:
                        break

            if remain_qty != 0:
                raise ValidationError("제고 상세 재고 수량 체크 오류입니다.")

        if create_list:
            models.RackStockDetail.objects.bulk_create(create_list)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        details, product_variants, skus = cls.clean_details(info, input_data)

        cls.clear_previous_rack_location_details(skus)

        rack_sectors = cls.create_new_rack_sectors(details)
        rack_locations = cls.create_new_rack_locations(details, rack_sectors, cls.make_detail_code)

        cls.create_rack_location_details(details, rack_locations, product_variants)

        return RackLocationSync()
