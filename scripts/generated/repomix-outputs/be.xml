    mall_password = EncryptedCharField(max_length=256, blank=True, null=True)

    pay_method = models.CharField(
        max_length=20,
        choices=VendorPayMethod.choices,
        default=VendorPayMethod.CARD_PRE,
    )
    pay_account = models.CharField(max_length=256, blank=True, null=True)

    note = models.TextField(null=True, blank=True)

    managers = JSONField(blank=True, default=list, encoder=CustomJsonEncoder)
    purchase_by = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    biz_reg_image = VersatileImageField(
        upload_to=upload_to_for_vendor_biz_reg_images, blank=True, null=True
    )
    account_image = VersatileImageField(
        upload_to=upload_to_for_vendor_account_images, blank=True, null=True
    )
    # 협력사 어드민 계정
    vendor_staff_user = models.OneToOneField(
        User,
        related_name="vendor",
        on_delete=models.SET_NULL,
        blank=True,
        null=True,
    )
    # 포장보스 상품 취급 여부
    use_boss_product = models.BooleanField(default=True)
    # b2b 상품 취급 여부
    use_b2b_product = models.BooleanField(default=False)
    # 직거래 상품 취급 여부
    use_fbv_product = models.BooleanField(default=False)
    # 직거래 상품 주문 시 알림 발송 여부: True 이면 메인 주문 담당자에게 알림 발송
    use_fbv_alarm = models.BooleanField(default=True)

    # 차량 당 적재중량, 차량 당 팔레트 수, 차량당 박스 수(예상) 등 배송 관련 정보
