import graphene
from django.db.models import Count, Q

from ...account import RequestOriginType
from ...bbs import RefundStatusType, models
from .types import CustomerQuestionCount


def resolve_notice(info, global_notice_id):
    user = info.context.user
    _type, notice_id = graphene.Node.from_global_id(global_notice_id)
    if user.from_dashboard and user.is_hq_staff:
        notice_qs = models.Notice.objects.filter(pk=notice_id)
        notice_first = notice_qs.first()
        if notice_first.is_hq_notice:
            notice = notice_qs.published().filter(available_brands__in=[user.brand]).first()
        else:
            notice = notice_first
    else:
        notice = models.Notice.objects.visible_to_user(user).filter(pk=notice_id).first()
    return notice


def resolve_from_boss_notices(info, **_kwargs):
    user = info.context.user
    qs = models.Notice.objects.visible_to_user(user).filter(owner_brand__isnull=True).distinct()
    return qs


def resolve_from_hq_notices(info, id=None, **_kwargs):
    user = info.context.user
    brand_id = None

    if id:
        try:
            _type, brand_id = graphene.Node.from_global_id(id)
        except Exception:
            raise Exception("Invalid global ID")
    elif not user.is_staff:
        raise Exception("브랜드 ID가 필요합니다 (staff가 아닌 경우).")

    if user.from_dashboard:
        if user.is_staff:
            qs = models.Notice.objects.exclude(owner_brand__isnull=True)
        else:
            qs = models.Notice.objects.filter(owner_brand=brand_id)
    else:
        qs = models.Notice.objects.visible_to_user_for_from_hq_notices(user)
        if brand_id:
            qs = qs.filter(owner_brand=brand_id)

    return qs.distinct()


def resolve_brand_store_request_to_hq(info, id):
    user = info.context.user
    _type, request_id = graphene.Node.from_global_id(id)
    if user.from_dashboard:
        if user.is_staff:
            qs = models.BrandStoreRequestToHq.objects.filter(pk=request_id)
        else:
            qs = models.BrandStoreRequestToHq.objects.filter(pk=request_id, brand__id=user.brand_id)
    else:
        qs = models.BrandStoreRequestToHq.objects.visible_to_user(user).filter(pk=request_id)
    return qs.first()


def resolve_brand_store_request_to_hq_list(info, **_kwargs):
    user = info.context.user
    if user.from_dashboard:
        if user.is_staff:
            qs = models.BrandStoreRequestToHq.objects.all()
        else:
            qs = models.BrandStoreRequestToHq.objects.filter(brand_id=user.brand_id)
    else:
        qs = models.BrandStoreRequestToHq.objects.visible_to_user(user)
    return qs.distinct()


def resolve_from_hq_notices_wo_id(info):
    switched_brand_id = info.context.user.switched_brand_id
    global_brand_id = graphene.Node.to_global_id("Brand", switched_brand_id)

    return resolve_from_hq_notices(info, global_brand_id)


def resolve_customer_q_a(info, global_qa_id):
    user = info.context.user
    _type, qa_pk = graphene.Node.from_global_id(global_qa_id)
    customer_question = models.CustomerQA.objects.visible_to_user(user).filter(pk=qa_pk).first()
    return customer_question


def resolve_brand_history(info, global_history_id):
    _type, history_pk = graphene.Node.from_global_id(global_history_id)
    history = models.BrandHistory.objects.filter(pk=history_pk).first()
    return history


def resolve_brand_histories(info, **_kwargs):
    return models.BrandHistory.objects.all().distinct()


def resolve_customer_q_a_list(info, **_kwargs):
    user = info.context.user
    return models.CustomerQA.objects.visible_to_user(user).all().distinct()


def resolve_bs_training_tag_list(info, **_kwargs):
    return models.BsTrainingTag.objects.all().distinct()


def resolve_bs_training_doc(info, global_doc_id):
    user = info.context.user
    _type, doc_pk = graphene.Node.from_global_id(global_doc_id)
    doc = models.BsTrainingDoc.objects.visible_to_user(user).filter(pk=doc_pk).first()
    return doc


def resolve_bs_training_doc_list(info, **_kwargs):
    user = info.context.user
    return models.BsTrainingDoc.objects.visible_to_user(user).distinct()


def resolve_refund_questions_by_user(info, **_kwargs):
    user = info.context.user
    return models.RefundQA.objects.filter(q_writer=user).distinct()


# status는 문의 상태를 의미함
def resolve_refund_questions(info, **_kwargs):
    qs = models.RefundQA.objects.all().distinct()

    return qs


def resolve_customer_question_get_count(info, **kwargs):
    qs = models.RefundQA.objects.all()
    filter_data = kwargs.get("filter")

    is_fbv_value = None
    vendor_value = None

    if filter_data:
        is_fbv_value = filter_data.get("is_fbv")
        vendor_value = filter_data.get("vendor")

    if is_fbv_value is not None:
        qs = qs.filter(is_fbv=is_fbv_value)

    if vendor_value is not None:
        _, vendor_id = graphene.Node.from_global_id(vendor_value)
        qs = qs.filter(vendor_id=vendor_id)

    customer_count = qs.aggregate(
        requested_count=Count("id", filter=Q(status=RefundStatusType.REQUESTED)),
        accepted_count=Count("id", filter=Q(status=RefundStatusType.ACCEPTED)),
        collected_inspect_count=Count("id", filter=Q(status=RefundStatusType.COLLECTED_INSPECT)),
        reject_count=Count("id", filter=Q(status=RefundStatusType.REJECT)),
        refund_pending_count=Count("id", filter=Q(status=RefundStatusType.REFUND_PENDING)),
        refund_success_count=Count("id", filter=Q(status=RefundStatusType.REFUND_SUCCESS)),
        change_pending_count=Count("id", filter=Q(status=RefundStatusType.CHANGE_PENDING)),
        change_success_count=Count("id", filter=Q(status=RefundStatusType.CHANGE_SUCCESS)),
        stock_included_requested_count=Count(
            "id", filter=Q(status=RefundStatusType.STOCK_INCLUDED_REQUESTED)
        ),
        stock_included_approved_count=Count(
            "id", filter=Q(status=RefundStatusType.STOCK_INCLUDED_APPROVED)
        ),
        question_close_count=Count("id", filter=Q(status=RefundStatusType.QUESTION_CLOSE)),
    )

    return CustomerQuestionCount(
        requested_count=customer_count["requested_count"],
        accepted_count=customer_count["accepted_count"],
        collected_inspect_count=customer_count["collected_inspect_count"],
        reject_count=customer_count["reject_count"],
        refund_pending_count=customer_count["refund_pending_count"],
        refund_success_count=customer_count["refund_success_count"],
        change_pending_count=customer_count["change_pending_count"],
        change_success_count=customer_count["change_success_count"],
        stock_included_requested_count=customer_count["stock_included_requested_count"],
        stock_included_approved_count=customer_count["stock_included_approved_count"],
        question_close_count=customer_count["question_close_count"],
    )


def resolve_request_fbv_product_list(info, **_kwargs):
    return models.RequestFbvProduct.objects.all().distinct()


def resolve_request_boss_product_list(info, **_kwargs):
    return models.RequestBossProduct.objects.all().distinct()


def resolve_push_send_event_list(info, **_kwargs):
    user = info.context.user
    target_app_type = RequestOriginType.DASHBOARD if user.from_dashboard else RequestOriginType.MALL

    return models.PushSendEvent.objects.filter(
        user=user, target_app_type=target_app_type
    ).distinct()
