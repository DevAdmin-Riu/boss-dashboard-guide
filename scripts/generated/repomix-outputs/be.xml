                f"{api_tag} 실패: {response_json} response.status_code={response.status_code}"
            )
            logger.error(f"modusign_debug: {error_msg}")
    except Exception as e:
        error_msg = f"{api_tag} api 호출 오류: {e}"
        logger.error(f"modusign_debug: {error_msg}")
    return response_json, error_msg
