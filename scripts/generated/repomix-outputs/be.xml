    def get_node(cls, info, pk):
        if info.context:
            brand_store_owner_user = info.context.brand_store_owner_user
            qs = cls._meta.model.objects.all()
            if (
                not brand_store_owner_user.is_staff
                and not brand_store_owner_user.is_hq_staff
                and not brand_store_owner_user.is_vendor_staff
            ):
                qs = qs.visible_to_user(brand_store_owner_user)
            return qs.filter(pk=pk).first()
        return None

