    def filter_request_number(qs, _, value):
        if value:
            prefix = REQUEST_BOSS_PRODUCT_NUMBER_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        return qs.filter(id=pk_value)
                    except:
                        raise ValidationError(f"상품요청 접수번호 형식을 확인해 주세요. {value}")
            else:
                raise ValidationError(f"상품요청 접수번호 형식을 확인해 주세요. {value}")
        return qs

    def filter_status(qs, _, value):
