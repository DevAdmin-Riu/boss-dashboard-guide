import logging

from celery import shared_task
from django.core.files.storage import default_storage
from django.db import models, transaction
from django.db.models.signals import post_delete, pre_save
from django.dispatch import receiver

from .brand_store.models import BrandStoreFranchiseDocument
from .pre_founder.models import PreFounderBasicDocument, PreFounderFranchiseDocument
from .product.models import ProductVariant

logger = logging.getLogger()


@shared_task
def delete_file_from_storage(file_name: str):
    """
    스토리지에서 파일 삭제 (비동기)
    """
    if file_name and default_storage.exists(file_name):
        default_storage.delete(file_name)
        logger.info(f"auto_delete: {file_name}")


def delete_file_if_changed(instance, field):
    if not instance.pk:
        return
    try:
        old_instance = instance.__class__.objects.get(pk=instance.pk)
    except instance.__class__.DoesNotExist:
        return

    old_file = getattr(old_instance, field.name)
    new_file = getattr(instance, field.name)

    if old_file and old_file != new_file:
        file_name = old_file.name
        transaction.on_commit(lambda: delete_file_from_storage.delay(file_name))


# exclude_auto_cleanup_fileds: 자동정리 대상에서 제외하고 싶은 필드가 있다면, 모델의 Meta에 exclude_auto_cleanup_fileds를 정의
def _inner_auto_delete_changed_files(instance):
    exclude = getattr(instance._meta, "exclude_auto_cleanup_fileds", [])
    for field in instance._meta.get_fields():
        if isinstance(field, models.FileField) and field.name not in exclude:
            delete_file_if_changed(instance, field)


def _inner_auto_delete_orphan_files(instance):
    exclude = getattr(instance._meta, "exclude_auto_cleanup_fileds", [])
    for field in instance._meta.get_fields():
        if isinstance(field, models.FileField) and field.name not in exclude:
            file = getattr(instance, field.name)
            if file:
                file_name = file.name
                transaction.on_commit(lambda: delete_file_from_storage.delay(file_name))


# sender 를 정의하지 않으면 모든 모델의 pre_save 때마다 호출되어, 불필요한 오버헤드가 생길 수 있으므로
# 필요한 모델만 sender 로 정의해서 receiver 등록하는 것으로 정책 잡음


@receiver(pre_save, sender=ProductVariant)
@receiver(pre_save, sender=PreFounderBasicDocument)
@receiver(pre_save, sender=PreFounderFranchiseDocument)
@receiver(pre_save, sender=BrandStoreFranchiseDocument)
def auto_delete_changed_files(sender, instance, **kwargs):
    _inner_auto_delete_changed_files(instance)


@receiver(post_delete, sender=ProductVariant)
@receiver(post_delete, sender=PreFounderBasicDocument)
@receiver(post_delete, sender=PreFounderFranchiseDocument)
@receiver(post_delete, sender=BrandStoreFranchiseDocument)
def auto_delete_orphan_files(sender, instance, **kwargs):
    _inner_auto_delete_orphan_files(instance)
