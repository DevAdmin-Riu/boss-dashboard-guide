class BrandStoreRequestToHq(models.Model):
    brand = models.ForeignKey(Brand, on_delete=models.CASCADE, related_name="hq_requests")
    brand_store = models.ForeignKey(
        BrandStore, on_delete=models.CASCADE, related_name="requests_to_hq"
    )

    title = models.CharField(max_length=255)
    content = models.JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    status = models.CharField(
        max_length=20,
        choices=BrandStoreRequestStatus.choices,
        default=BrandStoreRequestStatus.WAITING,
    )

    accepted_at = models.DateTimeField(null=True, blank=True)
    done_at = models.DateTimeField(null=True, blank=True)

    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    objects = BrandStoreRequestToHqQuerySet.as_manager()

    class Meta:
        ordering = ("-pk",)

    def clean(self):
        if not self.pk:
            return  # 새 객체는 제한 없음

        old = BrandStoreRequestToHq.objects.get(pk=self.pk)
        if old.status != self.status:
            if old.status == BrandStoreRequestStatus.DONE:
                raise ValidationError("완료 상태에서는 다른 상태로 변경할 수 없습니다.")
            if (
                old.status == BrandStoreRequestStatus.ACCEPTED
                and self.status == BrandStoreRequestStatus.WAITING
            ):
                raise ValidationError("접수 상태에서 대기 상태로 변경할 수 없습니다.")
            if (
                old.status == BrandStoreRequestStatus.WAITING
                and self.status == BrandStoreRequestStatus.DONE
            ):
                raise ValidationError("대기 상태에서 완료 상태로 변경할 수 없습니다.")

        super().clean()

    def save(self, *args, **kwargs):
        if self.pk:
            old = BrandStoreRequestToHq.objects.get(pk=self.pk)
            if old.status != self.status:
                if self.status == BrandStoreRequestStatus.ACCEPTED:
                    self.accepted_at = kst_timezone_now()
                elif self.status == BrandStoreRequestStatus.DONE:
                    self.done_at = kst_timezone_now()

        super().save(*args, **kwargs)

    def __str__(self):
        return f"[{self.get_status_display()}] {self.title}"


