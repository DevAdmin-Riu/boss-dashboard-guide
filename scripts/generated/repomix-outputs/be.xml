class BsOpsRecheckReportItem(models.Model):
    # report_item 타고가면 brand_store있지만 너무 멀어서,, 따로 저장해둠.
    brand_store = models.ForeignKey(
        BrandStore,
        on_delete=models.CASCADE,
        related_name="recheck_items",
        blank=True,
    )
    report_item = models.OneToOneField(
        BsOpsCheckReportItem,
        on_delete=models.PROTECT,
        related_name="recheck_item_relation",
    )
    status = models.CharField(
        max_length=50,
        choices=BsOpsRecheckReportItemStatus.choices,
        default=BsOpsRecheckReportItemStatus.REQUESTED,
    )
    answer_json = models.JSONField(default=dict, blank=True)
    reject_reason = models.CharField(max_length=255, blank=True, null=True)
    created_at = models.DateTimeField(auto_now_add=True)
    submitted_at = models.DateTimeField(null=True, blank=True)
    completed_at = models.DateTimeField(null=True, blank=True)

    def save(self, *args, **kwargs):
        info = getattr(self, "_info", None)
        if info and not self.pk:
            create_user = info.context.user
            if not create_user.is_hq_staff:
                raise ValidationError("재점검 요청은 본부 직원만 가능합니다.")
            else:
                self.create_user = create_user
                self.brand_store_id = self.report_item.report.brand_store_id

        if self.pk:
            old = BsOpsRecheckReportItem.objects.get(pk=self.pk)
            old_status = old.status
            new_status = self.status

            if old_status == BsOpsRecheckReportItemStatus.COMPLETED:
                raise ValidationError("완료된 항목은 더 이상 수정할 수 없습니다.")

            if old_status != new_status:
                if new_status == BsOpsRecheckReportItemStatus.SUBMITTED:
                    self.submitted_at = kst_timezone_now()
                elif (
                    old_status == BsOpsRecheckReportItemStatus.SUBMITTED
                    and new_status == BsOpsRecheckReportItemStatus.RE_REQUESTED
                ):
                    self.submitted_at = None
                elif new_status == BsOpsRecheckReportItemStatus.COMPLETED:
                    self.completed_at = kst_timezone_now()

        super().save(*args, **kwargs)

    def clean(self):
        super().clean()
        if not self.pk:
            return  # 새 객체는 상태 변경 검증 필요 없음
        # 이전 상태 → 변경될 상태 허용 규칙
        valid_transitions = {
            BsOpsRecheckReportItemStatus.REQUESTED: [BsOpsRecheckReportItemStatus.SUBMITTED],
            BsOpsRecheckReportItemStatus.SUBMITTED: [
                BsOpsRecheckReportItemStatus.RE_REQUESTED,
                BsOpsRecheckReportItemStatus.COMPLETED,
            ],
            BsOpsRecheckReportItemStatus.RE_REQUESTED: [BsOpsRecheckReportItemStatus.SUBMITTED],
        }
        # 기존 상태
        old_status = BsOpsRecheckReportItem.objects.get(pk=self.pk).status
        new_status = self.status
        # 상태가 바뀌는 경우에만 검사
        if old_status != new_status:
            allowed = valid_transitions.get(old_status, [])
            if new_status not in allowed:
                raise ValidationError("상태 변경 에러입니다.")

    objects = BsOpsRecheckReportItemQueryset.as_manager()

    class Meta:
        ordering = ["-pk"]


