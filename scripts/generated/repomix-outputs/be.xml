def _calc_refund_order_line_payment_values(
    refund_total_values: RefundOrderLinePaymentValues,
    refund_total_amount: Decimal,
    refund_order_line_price_minus_return_delivery_fee: Decimal,
    refund_order_line_mul_rate_sum: Decimal,
    refund_order_line_mul_rate: Decimal,
):
    # refund_total_amount는 이미 반품 배송비가 제외된 상태임.
    rate = Decimal(0)
    if refund_total_amount != 0:
        rate = Decimal(refund_order_line_price_minus_return_delivery_fee / refund_total_amount)
    # line_price_mul_charge_rate_sum가 0인 경우도 처리 됨
    brand_paying_charge_rate = Decimal(
        Decimal(0)
        if refund_order_line_mul_rate_sum == 0
        else refund_order_line_mul_rate / (refund_order_line_mul_rate_sum)
    )
    return RefundOrderLinePaymentValues(
        amount=quantize_krw(refund_total_values.amount * rate),
        cashable_credits=quantize_krw(refund_total_values.cashable_credits * rate),
        non_cashable_credits=quantize_krw(refund_total_values.non_cashable_credits * rate),
        rcoins=quantize_krw(refund_total_values.rcoins * rate),
        diff_paying_charge_exclude_vat=quantize_krw(
            refund_total_values.diff_paying_charge_exclude_vat * rate
        ),
        diff_brand_paying_charge_exclude_vat=quantize_krw(
            refund_total_values.diff_brand_paying_charge_exclude_vat * brand_paying_charge_rate
        ),
    )


def _calc_remaining_refund_order_line_payment_values(
    refund_total_values: RefundOrderLinePaymentValues,
    refund_order_line_payment_values_list: Iterable[RefundOrderLinePaymentValues],
):
    used_amount = reduce(
        lambda acc, refund_order_line: acc + Decimal(refund_order_line.amount),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )
    used_cashable_credits = reduce(
        lambda acc, refund_order_line: acc + Decimal(refund_order_line.cashable_credits),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )
    used_non_cashable_credits = reduce(
        lambda acc, refund_order_line: acc + Decimal(refund_order_line.non_cashable_credits),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )
    used_rcoins = reduce(
        lambda acc, refund_order_line: acc + Decimal(refund_order_line.rcoins),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )
    used_diff_paying_charge_exclude_vat = reduce(
        lambda acc, refund_order_line: acc
        + Decimal(refund_order_line.diff_paying_charge_exclude_vat),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )
    used_diff_brand_paying_charge_exclude_vat = reduce(
        lambda acc, refund_order_line: acc
        + Decimal(refund_order_line.diff_brand_paying_charge_exclude_vat),
        refund_order_line_payment_values_list,
        Decimal(0.0),
    )

    return RefundOrderLinePaymentValues(
        amount=quantize_krw(refund_total_values.amount - used_amount),
        cashable_credits=quantize_krw(refund_total_values.cashable_credits - used_cashable_credits),
        non_cashable_credits=quantize_krw(
            refund_total_values.non_cashable_credits - used_non_cashable_credits
        ),
        rcoins=quantize_krw(refund_total_values.rcoins - used_rcoins),
        diff_paying_charge_exclude_vat=quantize_krw(
            refund_total_values.diff_paying_charge_exclude_vat - used_diff_paying_charge_exclude_vat
        ),
        diff_brand_paying_charge_exclude_vat=quantize_krw(
            refund_total_values.diff_brand_paying_charge_exclude_vat
            - used_diff_brand_paying_charge_exclude_vat
        ),
    )


def _calc_refund_order_line_mileage_exclude_vat(
    order_line: "OrderLine",
    refund_quantity: Decimal,
    return_delivery_fee: Decimal,
    refund_order_line_payment_values: RefundOrderLinePaymentValues,
    mileage_rate: Decimal,
):
    is_tax_free = order_line.is_tax_free

    last_captured_amount = get_last_captured_amount_of_order_line(order_line)
    last_captured_cashable_credits = get_last_captured_cashable_credits_of_order_line(order_line)
    last_captured_non_cashable_credits = get_last_captured_non_cashable_credits_of_order_line(
        order_line
    )
    last_captured_rcoins = get_last_captured_rcoins_of_order_line(order_line)
    last_captured_total = (
        last_captured_amount
        + last_captured_cashable_credits
        + last_captured_non_cashable_credits
        + last_captured_rcoins
    )
    refund_total_amount = (
        refund_order_line_payment_values.amount
        + refund_order_line_payment_values.cashable_credits
        + refund_order_line_payment_values.non_cashable_credits
        + refund_order_line_payment_values.rcoins
    )
    total_price = quantize_krw(last_captured_total - refund_total_amount)
    acc_return_delivery_fee = (
        get_acc_return_delivery_fee_amount_of_order_line(order_line) + return_delivery_fee
    )

    captured_rcoins = last_captured_rcoins - refund_order_line_payment_values.rcoins

    last_refundable_qty = get_last_refundable_qty_of_order_line(order_line)
    final_quantity = last_refundable_qty - refund_quantity
    brand_total_cost_price = quantize_krw(order_line.brand_unit_cost_price_amount * final_quantity)
    brand_total_delivery_fee = quantize_krw(
        order_line.brand_unit_delivery_fee_amount * final_quantity
    )

    brand_paying_charge_exclude_vat = (
        get_last_brand_paying_charge_exclude_vat_of_order_line(order_line)
        + refund_order_line_payment_values.diff_brand_paying_charge_exclude_vat
    )

    return calc_order_line_mileage_exclude_vat(
        total_price=total_price,
        captured_rcoins=captured_rcoins,
        brand_total_cost_price=brand_total_cost_price,
        brand_total_delivery_fee=brand_total_delivery_fee,
        brand_paying_charge_exclude_vat=brand_paying_charge_exclude_vat,
        # 본부수익금 적용 여부가 False 면 mileate_rate 를 0% 로 처리해서 본부수익금을 0원으로 만든다.
        mileage_rate=mileage_rate if order_line.calc_mileage else Decimal(0),
        is_tax_free=is_tax_free,
        return_delivery_fee=acc_return_delivery_fee,
    )


def make_refund_order_line_data(
    refund_amount: Decimal,
    refund_cashable_credits: Decimal,
    refund_non_cashable_credits: Decimal,
    refund_rcoins: Decimal,
    refund_lines: Iterable["RefundOrderLineData"],
    order: "Order",
    payment: "Payment",
    refund_transaction: "Transaction" = None,
    is_migration_mode: bool = False,
    is_fbv: bool = False,
):
    from ..taxinvoice.actions import calc_tax_invoice_amount
    from .models import RefundOrderLine

    prev_captured_amount = payment.captured_amount
    prev_captured_cashable_credits = payment.captured_cashable_credits

    # 이번 반품 품목들의 반품배송비 합계
    sum_of_return_delivery_fee = reduce(
        lambda acc, refund_line: acc + quantize_krw(refund_line.return_delivery_fee),
        refund_lines,
        Decimal(0.0),
    )

    if is_migration_mode == False and sum_of_return_delivery_fee > payment.captured_total:
        raise Exception("반품배송비가 환불가능한 결제 금액보다 더 크게 입력되었습니다.")

    prev_paying_charge_exclude_vat = payment.final_paying_charge_exclude_vat
    prev_brand_paying_charge_exclude_vat = payment.final_brand_paying_charge_exclude_vat
    new_paying_charge_exclude_vat = 0
    new_brand_paying_charge_exclude_vat = 0
    refund_order_line_mul_rate_sum = 0

    pay_method = payment.token
    if refund_amount > 0:
        # migration 에서 payment.is_vank_pay()  호출 시 에러로 아래와 같이 처리함
        # 환불시 해당 수수료를 분배하는 방식은 처음에 분배하는 방식과 유사함. 각 ((라인별 환불금액 - 반품배송수수료) * 각 수수료율)이 sum대비 차지하는 비율대로 나눈다.
        if is_vbank_pay(pay_method):
            plugin_configs = get_plugin_configs_by_payment(payment)
            # 환불시 새로운 브랜드 수수료 가상계좌의 경우. 전체 수수료를 기존 수수료 + orderline에 들어있는 수수료의 합으로 한다.
            # (보스장터 상품의 경우 환불시에도 가상계좌 수수료를 따로 본부수익금 계산에 넣지않음. 어차피 매출에 %였으므로).
            # 섞여있었을 경우. 기존 수수료가 브랜드의 가상계좌수수료 였을꺼고, orderline에 해당 값이 배분 되었을 것이므로, 가상계좌 수수료가 한번더 더해지는 기존 방식과 동일.

            # 이니시스 PG는 가상계좌 환불 시 마다 고정 수수료 추가 부과함
            add_vbank_paying_charge_mode = (
                True if payment.gateway == PaymentGatewayType.INICIS else False
            )
            if add_vbank_paying_charge_mode:
                new_brand_paying_charge_exclude_vat = prev_brand_paying_charge_exclude_vat
                for order_line in order.lines.all():
                    new_brand_paying_charge_exclude_vat += (
                        order_line.brand_paying_charge_exclude_vat
                    )
                new_paying_charge_exclude_vat = prev_paying_charge_exclude_vat + Decimal(
                    plugin_configs.vbank_paying_charge_exclude_vat
                )
            else:
                new_brand_paying_charge_exclude_vat = prev_brand_paying_charge_exclude_vat
                new_paying_charge_exclude_vat = prev_paying_charge_exclude_vat

            for refund_line in refund_lines:
                order_line = refund_line.order_line
                if not order_line.is_main_pv:
                    continue
                qty_for_price = int(refund_line.refund_quantity / order_line.bundle_info_qty)
                refund_amount_in_line = quantize_krw(
                    order_line.unit_price_gross_amount * qty_for_price
                    - refund_line.return_delivery_fee
                )
                if add_vbank_paying_charge_mode:
                    refund_order_line_mul_rate_sum += (
                        refund_amount_in_line * order_line.vbank_paying_charge_exclude_vat
                    )
        elif is_card_pay(pay_method):
            plugin_configs = get_plugin_configs_by_payment(payment)
            # 카드의 경우. 새로운 브랜드 수수료(전체)는, prev_brand_paying_charge_exclude_vat 에서, 환불되는 상품의 금액 * 그 상품의 rate를 계산해서 제하는 방식으로 한다.
            # (기존에는 그냥 전체 환불 금액 * rate만 빼서 새로운 charge 구하는 방식)
            new_brand_paying_charge_exclude_vat = prev_brand_paying_charge_exclude_vat
            refund_amount_tmp_for_braynd_paying_charge_exclude_vat = refund_amount
            for refund_line in refund_lines:
                order_line = refund_line.order_line
                if not order_line.is_main_pv:
                    continue
                qty_for_price = int(refund_line.refund_quantity / order_line.bundle_info_qty)
                refund_amount_in_line = quantize_krw(
                    order_line.unit_price_gross_amount * qty_for_price
                    - refund_line.return_delivery_fee
                )
                # refund_amount_in_line의 합이 refund_amount_tmp_for_braynd_paying_charge_exclude_vat 가 될때까지만 아래 로직으로 new_brand_paying_charge_exclude_vat 에서 뺀다.
                if refund_amount_tmp_for_braynd_paying_charge_exclude_vat > 0:
                    before_refund_amount_tmp_for_braynd_paying_charge_exclude_vat = (
                        refund_amount_tmp_for_braynd_paying_charge_exclude_vat
                    )
                    refund_amount_tmp_for_braynd_paying_charge_exclude_vat -= refund_amount_in_line
                    # 빼고도 양수면refund_amount_in_line  전체를 다하고, 마이너스면은 남은 부분(빼기전부분)만 해야한다.
                    if refund_amount_tmp_for_braynd_paying_charge_exclude_vat >= 0:
                        new_brand_paying_charge_exclude_vat -= calc_paying_charge_exclude_vat(
                            payment.token,
                            refund_amount_in_line,
                            order_line.card_paying_charge_rate,
                            order_line.vbank_paying_charge_exclude_vat,
                        )
                    else:
                        new_brand_paying_charge_exclude_vat -= calc_paying_charge_exclude_vat(
                            payment.token,
                            before_refund_amount_tmp_for_braynd_paying_charge_exclude_vat,
                            order_line.card_paying_charge_rate,
                            order_line.vbank_paying_charge_exclude_vat,
                        )

                refund_order_line_mul_rate_sum += (
                    refund_amount_in_line * order_line.card_paying_charge_rate
                )
            new_captured_amount = prev_captured_amount - refund_amount
            card_paying_charge_rate = (
                Decimal(plugin_configs.bp_card_paying_charge_rate)
                if payment.is_toss_riu_pay
                else Decimal(plugin_configs.card_paying_charge_rate)
            )
            new_paying_charge_exclude_vat = calc_paying_charge_exclude_vat(
                payment.token,
                new_captured_amount,
                card_paying_charge_rate,
                Decimal(plugin_configs.vbank_paying_charge_exclude_vat),
            )
    # amount가 0 이상인 경우에는 위의 식만으로 충분. 아래의 경우는 0이상이 아니면서(즉 0이면서), 환불금액(충전금,포인트)가 있는 경우임.
    elif refund_cashable_credits > 0 or refund_non_cashable_credits > 0 or refund_rcoins > 0:
        new_brand_paying_charge_exclude_vat = prev_brand_paying_charge_exclude_vat
        new_paying_charge_exclude_vat = prev_paying_charge_exclude_vat
        for refund_line in refund_lines:
            order_line = refund_line.order_line
            if not order_line.is_main_pv:
                continue
            qty_for_price = int(refund_line.refund_quantity / order_line.bundle_info_qty)
            refund_amount_in_line = quantize_krw(
                order_line.unit_price_gross_amount * qty_for_price - refund_line.return_delivery_fee
            )
            refund_order_line_mul_rate_sum += refund_amount_in_line

    refund_total_amount = (
        refund_amount + refund_cashable_credits + refund_non_cashable_credits + refund_rcoins
    )
    refund_total_values = RefundOrderLinePaymentValues(
        amount=refund_amount,
        cashable_credits=refund_cashable_credits,
        non_cashable_credits=refund_non_cashable_credits,
        rcoins=refund_rcoins,
        diff_paying_charge_exclude_vat=new_paying_charge_exclude_vat
        - prev_paying_charge_exclude_vat,
        diff_brand_paying_charge_exclude_vat=new_brand_paying_charge_exclude_vat
        - prev_brand_paying_charge_exclude_vat,
    )
    refund_order_line_data_ary: List[RefundOrderLineData] = []

    refund_brand_total_cost_price = Decimal(0)
    refund_brand_total_delivery_fee = Decimal(0)
    refund_order_taxable_total = Decimal(0)
    refund_delivery_box_count = 0
    refund_delivery_additional_fee = 0
    refund_order_line_payment_values_list: List[RefundOrderLinePaymentValues] = []

    for refund_line, next_item in zip(
        refund_lines,
        refund_lines[1:] + [None],
    ):
        order_line: OrderLine = refund_line.order_line
        if is_migration_mode and order_line.is_converted == False:
            raise Exception(
                f"변환되지 않은 주문 건의 환불 데이터를 변환하려고 하고 있습니다. order_id:{order.id}. 환불일:{refund_transaction.created}, 결제일:{order.captured_at}"
            )
        quantity = refund_line.refund_quantity
        return_delivery_fee = refund_line.return_delivery_fee
        if is_migration_mode == False:
            if quantity <= 0:
                raise Exception("환불 상품 수량이 0 이하입니다.")
            if quantity > order_line.quantity_refundable:
                raise Exception("상품 환불 수량이 환불 가능한 수량보다 큽니다.")

        if order_line.is_main_pv:
            qty_for_price = int(quantity / order_line.bundle_info_qty)
            refund_order_line_price = quantize_krw(
                qty_for_price * order_line.unit_price_gross_amount
            )
            refund_order_line_price_minus_return_delivery_fee = (
                refund_order_line_price - return_delivery_fee
            )
            refund_brand_total_cost_price += quantize_krw(
                qty_for_price * order_line.brand_unit_cost_price_amount
            )
            refund_brand_total_delivery_fee += quantize_krw(
                qty_for_price * order_line.brand_unit_delivery_fee_amount
            )
        else:
            refund_order_line_price = 0
            refund_order_line_price_minus_return_delivery_fee = 0
            refund_brand_total_cost_price += 0
            refund_brand_total_delivery_fee += 0

        if order_line.is_tax_free == False:
            refund_order_taxable_total += refund_order_line_price

        if order_line.need_delivery_additional_fee:
            refund_delivery_box_count += get_delivery_box_count_consider_adjust_price_pv(
                order_line.variant, quantity
            )

        refund_order_line_mul_rate = 0
        if is_vbank_pay(pay_method):
            refund_order_line_mul_rate = (
                refund_order_line_price - refund_line.return_delivery_fee
            ) * refund_line.order_line.vbank_paying_charge_exclude_vat
        elif is_card_pay(pay_method):
            refund_order_line_mul_rate = (
                refund_order_line_price - refund_line.return_delivery_fee
            ) * refund_line.order_line.card_paying_charge_rate
        if next_item is not None:
            refund_order_line_payment_values = _calc_refund_order_line_payment_values(
                refund_total_values=refund_total_values,
                refund_total_amount=refund_total_amount,
                refund_order_line_price_minus_return_delivery_fee=refund_order_line_price_minus_return_delivery_fee,
                refund_order_line_mul_rate_sum=Decimal(refund_order_line_mul_rate_sum),
                refund_order_line_mul_rate=refund_order_line_mul_rate,
            )
            refund_order_line_payment_values_list.append(refund_order_line_payment_values)
        else:
            refund_order_line_payment_values = _calc_remaining_refund_order_line_payment_values(
                refund_total_values, refund_order_line_payment_values_list
            )

        new_mileage_exclude_vat = _calc_refund_order_line_mileage_exclude_vat(
            order_line=order_line,
            refund_quantity=quantity,
            return_delivery_fee=return_delivery_fee,
            refund_order_line_payment_values=refund_order_line_payment_values,
            mileage_rate=order_line.mileage_rate,
        )
        refund_order_line_data = RefundOrderLineData(
            order_line=order_line,
            refund_quantity=quantity,
            return_delivery_fee=return_delivery_fee,
            refund_order_line_payment_values=refund_order_line_payment_values,
            mileage_exclude_vat=new_mileage_exclude_vat,
        )
        refund_order_line_data_ary.append(refund_order_line_data)

    # 이전 환불 데이터 마이그레이션 호출에서는 refund_data 리턴 불필요
    if is_migration_mode:
        refund_data = None
    else:
        # 악성재고 처리용 오픈몰 주문, 기타배송주문, B2B 주문은 세금계산서 발행 없음
        if order.type in [
            OrderType.BY_STAFF_FOR_BAD_STOCK,
            OrderType.BY_STAFF_FOR_ETC,
            OrderType.BY_STAFF_FOR_B2B,
            OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
        ]:
            taxable_total_for_tax_invoice = Decimal(0)
            tax_free_total_for_tax_invoice = Decimal(0)
        else:
            prev_cumulative_return_delivery_fee_amount = (
                RefundOrderLine.objects.filter(order_id=order.id).aggregate(
                    Sum("return_delivery_fee")
                )["return_delivery_fee__sum"]
                or 0
            )

            # 매출인식 브랜드 선결제금 처리를 위해서만 사용 (매출인식브랜드가 아니면 도서산간추가요금은 환불대상이 아님)
            # 택배 배송일 때만 도서산간지역 추가요금이 환불 대상이 됨
            if order.delivery_method == OrderDeliveryMethods.BY_COURIER:
                unit_additional_fee_exclude_vat = (
                    get_unit_delivery_additional_fee_exclude_vat_by_address(order.shipping_address)
                )
                if unit_additional_fee_exclude_vat > 0:
                    unit_additional_fee = calc_to_include_vat(
                        unit_additional_fee_exclude_vat, False
                    )
                    refund_delivery_additional_fee = unit_additional_fee * refund_delivery_box_count

            (
                taxable_total_for_tax_invoice,
                tax_free_total_for_tax_invoice,
            ) = calc_tax_invoice_amount(
                payment=payment,
                prev_captured_amount=prev_captured_amount,
                prev_captured_cashable_credits=prev_captured_cashable_credits,
                refund_amount=refund_amount,
                refund_cashable_credits=refund_cashable_credits,
                refund_order_taxable_total=refund_order_taxable_total,
                sum_of_return_delivery_fee=sum_of_return_delivery_fee
                + prev_cumulative_return_delivery_fee_amount,
            )

        refund_data = RefundData(
            amount=refund_amount,
            cashable_credits=refund_cashable_credits,
            non_cashable_credits=refund_non_cashable_credits,
            rcoins=refund_rcoins,
            return_delivery_fee=sum_of_return_delivery_fee,
            new_paying_charge_exclude_vat=new_paying_charge_exclude_vat,
            new_brand_paying_charge_exclude_vat=new_brand_paying_charge_exclude_vat,
            refund_brand_total_cost_price=refund_brand_total_cost_price,
            refund_brand_total_delivery_fee=refund_brand_total_delivery_fee,
            refund_delivery_additional_fee=refund_delivery_additional_fee,
            taxable_total_for_tax_invoice=taxable_total_for_tax_invoice,
            tax_free_total_for_tax_invoice=tax_free_total_for_tax_invoice,
            refund_lines=refund_lines,
            is_fbv=is_fbv,
        )

    return refund_data, refund_order_line_data_ary


def make_create_list_for_refund_order_line(
    order: "Order",
    payment: "Payment",
    transaction: "Transaction",
    pg_refund_response: Union["InicisRefundResponse", "TossRefundResponse"],
    refund_order_line_data_ary: Iterable[RefundOrderLineData],
    is_migration_mode: bool = False,
):
    from ..payment.gateways.handle_by_pg import get_refunded_at
    from .models import RefundOrderLine

    create_list = []
    for refund_order_line_data in refund_order_line_data_ary:
        order_line = refund_order_line_data.order_line
        refund_order_line_payment_values = refund_order_line_data.refund_order_line_payment_values
        diff_paying_charge_exclude_vat = (
            refund_order_line_payment_values.diff_paying_charge_exclude_vat
        )
        new_paying_charge_exclude_vat = (
            get_last_paying_charge_exclude_vat_of_order_line(order_line)
            + diff_paying_charge_exclude_vat
        )
        diff_brand_paying_charge_exclude_vat = (
            refund_order_line_payment_values.diff_brand_paying_charge_exclude_vat
        )
        new_brand_paying_charge_exclude_vat = (
            get_last_brand_paying_charge_exclude_vat_of_order_line(order_line)
            + diff_brand_paying_charge_exclude_vat
        )
        new_mileage_exclude_vat = refund_order_line_data.mileage_exclude_vat
        diff_mileage_exclude_vat = (
            new_mileage_exclude_vat - get_last_mileage_exclude_vat_of_order_line(order_line)
        )
        last_captured_amount = get_last_captured_amount_of_order_line(order_line)
        last_captured_cashable_credits = get_last_captured_cashable_credits_of_order_line(
            order_line
        )
        last_captured_non_cashable_credits = get_last_captured_non_cashable_credits_of_order_line(
            order_line
        )
        last_captured_rcoins = get_last_captured_rcoins_of_order_line(order_line)
        last_refundable_qty = get_last_refundable_qty_of_order_line(order_line)

        inicis_cancel_tid = (
            pg_refund_response.tid if isinstance(pg_refund_response, InicisRefundResponse) else None
        )
        remain_quantity = last_refundable_qty - refund_order_line_data.refund_quantity
        captured_amount = last_captured_amount - refund_order_line_payment_values.amount
        captured_cashable_credits = (
            last_captured_cashable_credits - refund_order_line_payment_values.cashable_credits
        )
        captured_non_cashable_credits = (
            last_captured_non_cashable_credits
            - refund_order_line_payment_values.non_cashable_credits
        )
        captured_rcoins = last_captured_rcoins - refund_order_line_payment_values.rcoins
        refund_order_line = RefundOrderLine(
            order_id=order.pk,
            payment_id=payment.pk,
            transaction_id=transaction.pk,
            inicis_cancel_tid=inicis_cancel_tid,
            order_line_id=order_line.pk,
            quantity=refund_order_line_data.refund_quantity * -1,
            amount=refund_order_line_payment_values.amount * -1,
            cashable_credits=refund_order_line_payment_values.cashable_credits * -1,
            non_cashable_credits=refund_order_line_payment_values.non_cashable_credits * -1,
            rcoins=refund_order_line_payment_values.rcoins * -1,
            return_delivery_fee=refund_order_line_data.return_delivery_fee,
            remain_quantity=remain_quantity,
            captured_amount=captured_amount,
            captured_cashable_credits=captured_cashable_credits,
            captured_non_cashable_credits=captured_non_cashable_credits,
            captured_rcoins=captured_rcoins,
            paying_charge_exclude_vat=new_paying_charge_exclude_vat,
            diff_paying_charge_exclude_vat=diff_paying_charge_exclude_vat,
            brand_paying_charge_exclude_vat=new_brand_paying_charge_exclude_vat,
            diff_brand_paying_charge_exclude_vat=diff_brand_paying_charge_exclude_vat,
            mileage_exclude_vat=new_mileage_exclude_vat,
            diff_mileage_exclude_vat=diff_mileage_exclude_vat,
        )
        # 이전 데이터 변환 모드 거나 pg_response 로 부터 환불일을 못 가져온 경우 transaction의 created 로 환불일 지정
        refunded_at = None
        if is_migration_mode == False and pg_refund_response:
            refunded_at = get_refunded_at(payment.gateway, pg_refund_response)
        if not refunded_at:
            refund_order_line.refunded_at = transaction.created

        create_list.append(refund_order_line)
    return create_list


def make_formated_tracking_number_for_order_event(courier_name: str, tracking_number: str):
    tracking_number_format = "{courier_name} ({tracking_number})"
    formatted_tracking_number = tracking_number_format.format(
        courier_name=courier_name, tracking_number=tracking_number
    )
    return formatted_tracking_number


def check_consignment_by_non_courier_order_line(order_line: "OrderLine", delivery_method) -> bool:
    return (
        delivery_method != OrderDeliveryMethods.BY_COURIER and order_line.track_inventory == False
    )


# 납품 시 금액 확정은 보스몰 택배 주문에서만 적용
def check_adjust_price_order_line(order_line: "OrderLine", delivery_method) -> bool:
    variant: "ProductVariant" = order_line.variant
    return delivery_method == OrderDeliveryMethods.BY_COURIER and variant.is_adjust_price


# 택배가 아닌 위탁 주문, 납품 시 금액 확정 제품 주문인 경우 주문 수량과 다르게 출고 가능함
def can_fulfill_more_than_ordered(order_line: "OrderLine", delivery_method) -> bool:
    return check_consignment_by_non_courier_order_line(
        order_line, delivery_method
    ) or check_adjust_price_order_line(order_line, delivery_method)


# 주문수량과 다르게 출고할수 있는 주문인 경우 출고수량
# 발주서 작성되고 출고 지시된 이후에만 출고 수량 으로 리턴되고, 그렇지 않은 경우 OrderLine.quantity 값을 그대로 리턴함
def get_ordered_or_fulfill_qty(line: "OrderLine", order: "Order" = None):
    order = order or line.order
    delivery_method = order.delivery_method
    if can_fulfill_more_than_ordered(line, delivery_method):
        purchase_order_line: "PurchaseOrderLine" = line.purchase_order_line
        # 위탁 발주서 상태가 출고지시 이후 단계인 경우, 출고지시 시점에 입력된 출고 수량을 리턴함
        if purchase_order_line and purchase_order_line.status in CONSIGNMENT_AFTER_FULFILL_STATUSES:
            return purchase_order_line.purchase_quantity
    return line.quantity
