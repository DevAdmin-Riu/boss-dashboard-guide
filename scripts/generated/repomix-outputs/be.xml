from typing import TYPE_CHECKING, List

from django.core.exceptions import ValidationError
from django.db import transaction

from .. import CategoryType

if TYPE_CHECKING:
    # flake8: noqa
    from datetime import date, datetime

    from django.db.models.query import QuerySet

    from ..models import Product, ProductVariant


@transaction.atomic
def delete_categories(categories_ids: List[str]):
    """Delete categories and perform all necessary actions.

    Set products of deleted categories as unpublished, delete categories
    and update products minimal variant prices.
    """
    from ..models import Category, Product

    categories = Category.objects.select_for_update().filter(pk__in=categories_ids)
    categories.prefetch_related("products")

    products = Product.objects.none()
    for category in categories:
        products = products | collect_categories_tree_products(category)

    if products.count() > 0:
        raise Exception("카테고리에 연결된 제품이 존재하면 삭제할 수 없습니다.")

    categories.delete()


def collect_categories_tree_products(category: "Category") -> "QuerySet[Product]":
    """Collect products from all levels in category tree."""
    products = category.products.all()
    descendants = category.get_descendants()
    for descendant in descendants:
        products = products | descendant.products.all()
    return products


# make_category_code를 작성함. 인자는 product_variant. category를 타고 가서 각 카테고리의 필드 값을 이용해서 3자리 숫자를 만들어줌. 무조건 3자리여야함. 아니면 에러.
def make_category_code(product_variant: "ProductVariant") -> str:
    from ..models import Category

    product_category = (
        Category.objects.select_related("parent")
        .filter(id=product_variant.product.category_id)
        .first()
    )

    prefix = "t" if product_variant.product.is_fulfilled_by_vendor else ""
    first_code = CategoryType.get_code(product_category.type)
    second_code = (
        product_category.parent.code
        if (
            product_category.parent
            and product_category.parent.code
            and product_category.parent.level == 0
        )
        else "~"
    )
    third_code = (
        product_category.code
        if (product_category and product_category.code and product_category.level == 1)
        else "~"
    )

    category_code = prefix + first_code + second_code + third_code

    # category_code에 ~ 가 포함되면 에러.
    if "~" in category_code:
        raise ValidationError("잘못된 카테고리로 생성 시도.")

    return category_code


# make_serial_number 코드를 작성함. ID + 105000임. outer_id가 존재하는 경우 outer_id + 105000임. 숫자 6자리 fillzero해야함.
def make_serial_number(product_variant: "ProductVariant") -> str:
    serial_number = str(
        (product_variant.outer_id if product_variant.outer_id else product_variant.id) + 105000
    )

    return serial_number.zfill(6)


# make_sku 함수를 만든다. 카테고리코드 + 일련번호 + -IN(outer 존재시).
def make_sku(product_variant: "ProductVariant") -> str:
    category_code = (
        product_variant.category_code
        if product_variant.category_code
        else make_category_code(product_variant)
    )
    serial_number = (
        product_variant.serial_number
        if product_variant.serial_number
        else make_serial_number(product_variant)
    )

    sku = f"{category_code}-{serial_number}"
    if product_variant.outer_id:
        sku += "-IN"

    return sku
