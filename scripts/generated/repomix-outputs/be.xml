        # product_variant 일련번호 + outer_id 쌍은 유니크해야함. null은 하나의 값을 간주되도록 condition 설정해서 unique설정.(제한 2개 필요함)
        constraints = [
            UniqueConstraint(
                fields=["serial_number"],
                condition=Q(outer__isnull=True),
                name="unique_product_serial_number",
            ),
            UniqueConstraint(
                fields=["serial_number", "outer"],
                condition=Q(outer__isnull=False),
                name="unique_product_outer",
            ),
        ]

    def __str__(self) -> str:
        return self.name or self.sku

    def check_has_inner_variant(self) -> bool:
        return not self.is_for_credits_refill and not self.is_dev_pv

    # 카테고리에 맞게 variants를 업데이트 해줌.
    def construct_category_kind_flags(self):
        if not self.pk:
            if self.product.category.kind == CategoryKind.STANDARD:
                self.is_for_credits_refill = False
                self.is_dev_pv = False
            elif self.product.category.kind == CategoryKind.CREDITS_REFILL:
                self.is_for_credits_refill = True
                self.is_dev_pv = False
            elif self.product.category.kind == CategoryKind.DEV:
                self.is_for_credits_refill = False
                self.is_dev_pv = True

    def save(self, *args, **kwargs):
        validate_track_inventory(self)
        validate_is_adjust_price(self)
        validate_is_vendor_track_inventory(self)
        # construct_category_kind_flags 뒤에 수행, 강제로 주입되는 값임. 다른 값의 변경은 허용하지만 해당 함수에서 정하는 값들은 무조건 정해진 갑승로 간다.
        construct_value_forcefully_in_case_is_dev_pv(self)

        # 제품 정보 고시에 대한 validation
        validate_product_info_noti(self)

        # 개발 연동된 제품에 대한 validation
        validate_dev_pv_of(self)

        super().save(*args, **kwargs)  # 먼저 저장하여 ID를 생성

        # 제품 ID 생성 이후, 관련 코드들 전부 생성.
        update_variant_codes(self)

    @property
    def pallet_qty_consider_mno(self) -> str:
        if self.pallet_qty is not None:
            return self.pallet_qty
        if self.pallet_m is not None and self.pallet_n is not None and self.pallet_o is not None:
            return self.pallet_m * self.pallet_n + self.pallet_o
        return None

    @property
    def name_for_email(self) -> str:
        return self.name if self.name else "-"

    @property
    def need_delivery_additional_fee(self) -> bool:
        # 자동 출고 상품이 아니고, 아우터 제품인 경우에만 배송지가 도서산간인 경우 추가요금 부과 대상 제품으로 판단
        return self.is_auto_fulfillment == False and self.outer_id is None

    @property
    def is_auto_fulfillment(self) -> bool:
        """
        ### 자동 출고 제품
            * 현재는 충전금 리필제품만 주문 시점에 자동 출고 처리하고 있음, is_for_credits_refill 로 판단해서 처리 중
            * 자동출고 유형은 배송이 의미가 없으므로 배송완료까지 처리하는 작업을 할 필요가 있음
                * TODO: is_auto_fulfillment 로 출고 처리만 별도로 하는 코드로 리팩토링 필요 (https://trello.com/c/0EPlZFJS 작업 카드에서 진행)
            * 도서산간지역 추가 비용 시 배송 상자 카운트에서 제외 처리 함
                * _get_delivery_box_count
        """
        return self.is_for_credits_refill

    def get_consignment_delivery_fee(self) -> "Money":
        currency = settings.DEFAULT_CURRENCY
        return Money(self.consignment_delivery_fee_amount, currency)

    def get_default_variant_vendor(self):
        # 이너의 default_variant_vendor 는 outer 것으로 리턴
        outer_variant: ProductVariant = self.outer
        if outer_variant:
            return outer_variant.default_variant_vendor
        return self.default_variant_vendor

