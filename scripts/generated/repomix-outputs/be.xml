    """
    주문 검색 필터를 동적으로 생성하는 함수.

    :param field_name: str - 필터링할 필드명 (기본값: "pk")
    :param field_name_for_sub: str | None - 주문 상세 검색 시 사용할 필드명
    :param is_it_for_sub: bool - 주문 상세 검색 여부
    :param prefix: NON_B2B_ORDER_PREFIX or B2B_ORDER_PREFIX - 주문 번호 접두사
    :return: 주문 검색 필터 함수
    """

    def filter_order_search(qs, name, value):
        """
        주문 번호(#123456) 또는 주문 상세 번호(#123456-S1)를 검색하는 필터.
        B2B 주문 번호(B-#123456) 또는 B2B 주문 상세 번호(B-#123456-S1)를 검색하는 필터.

        :param qs: QuerySet - 검색할 QuerySet
        :param name: str - 필드명 (Django Filter에서 자동 전달, 사용 안 함)
        :param value: str - 검색 값 (예: "#123456", "#123456-S1", 여러 개의 값)
        :return: QuerySet - 필터링된 결과
        """
        if not value:
            return qs

        # 엔터('\n')가 포함된 경우 여러 개의 값으로 분리
        query_values = [v.strip() for v in value.split("\n") if v.strip()]
        query_objects = Q()

        for query in query_values:
            if not query.startswith(prefix):
                raise ValidationError(
                    f"주문번호 형식을 확인해 주세요. {query} ({prefix}을 붙여서 다시 시도해 주세요)"
                )

            pk_value = query[len(prefix) :]  # prefix 제거

            # "-"가 포함된 경우 상세 주문 필터링
            if "-" in pk_value:
                splits = pk_value.split("-")
                if len(splits) != 2:
                    raise ValidationError(f"주문 상세 번호 형식을 확인해 주세요. {query}")

                order_id, sub_id_format = splits
                if not sub_id_format.startswith("S"):
                    raise ValidationError(f"주문 상세 번호 형식을 확인해 주세요. {query}")

                try:
                    sub_id = int(sub_id_format[1:])  # "S1" -> 1
                except ValueError:
                    raise ValidationError(f"주문 상세 번호 형식을 확인해 주세요. {query}")

                if field_name_for_sub:
                    query_objects |= Q(
                        **{
                            f"{field_name_for_sub}__order_id": order_id,
                            f"{field_name_for_sub}__sub_id": sub_id,
                        }
                    )
                else:
                    query_objects |= Q(order_id=order_id, sub_id=sub_id)
            else:
                query_objects |= Q(**{field_name: pk_value})

        try:
            return qs.filter(query_objects).distinct()
        except:
            raise ValidationError(
                f"주문번호 형식을 확인해 주세요. {value} ({prefix}을 안 붙인 경우 {prefix}을 붙여서 다시 시도해 주세요)"
            )

    return filter_order_search


def check_is_already_po_line_received(po_lines: List["PurchaseOrderLine"]):
    allow_po_line_statuses = [
        PurchaseOrderLineStatus.CANCELED,
        PurchaseOrderLineStatus.DRAFT,
        PurchaseOrderLineStatus.PENDING,
    ]
    return any(po_line.status not in allow_po_line_statuses for po_line in po_lines)
