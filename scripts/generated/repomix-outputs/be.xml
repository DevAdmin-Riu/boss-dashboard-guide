from datetime import datetime, timedelta
from datetime import timezone as datetime_timezone

from django.utils import timezone as django_timezone
from pytz import timezone


def kst_timezone_now():
    tz = timezone("Asia/Seoul")
    return datetime.now(tz=tz)


def kst_timezone_date():
    kst_timezone = kst_timezone_now()
    return kst_timezone.date()


def to_kst_date_format_from_utc_datetime(utc_datetime, format: str):
    kst_timezone = datetime_timezone(timedelta(hours=9))
    kst_datetime = utc_datetime.astimezone(kst_timezone)
    kst_date = kst_datetime.strftime(format)

    return kst_date


def to_datetime_astimezone(target_date: datetime.date, end_of_day: bool = False) -> datetime:
    """
    주어진 날짜를 기준으로 datetime 객체를 생성합니다.

    :param target_date: 변환할 날짜 (date 객체)
    :param end_of_day: True이면 하루의 끝 시간(23:59:59)으로,
                       False(기본값)이면 하루의 시작 시간(00:00:00)으로 설정합니다.
    :return: 타임존이 적용된 datetime 객체
    """
    if end_of_day:
        # 하루의 끝 시간으로 설정
        time_to_combine = datetime.max.time()
    else:
        # 하루의 시작 시간으로 설정
        time_to_combine = datetime.min.time()

    dt = datetime.combine(target_date, time_to_combine)
    return dt.astimezone()


def to_kst_date_from_utc_datetime(utc_datetime):
    return to_kst_date_format_from_utc_datetime(utc_datetime=utc_datetime, format="%Y-%m-%d")


def kst_datetime(dt: datetime = None):
    """한국 시간대(Asia/Seoul) 기준으로 datetime을 리턴

    - 인자 없이 호출 시 kst_timezone_now()와 유사한 결과를 리턴

    Args:
        dt : 한국 시간으로 변환할 datetime (timezone 정보가 없을 경우 한국 시간대로 간주하며, 설정하지 않으면 now를 리턴)
    """
    tz = timezone("Asia/Seoul")
    if not dt:
        dt = django_timezone.now()
    if django_timezone.is_aware(dt):
        kst_dt = django_timezone.localtime(dt, tz)
    else:
        kst_dt = django_timezone.make_aware(dt, tz)
    return kst_dt


def kst_date(dt: datetime = None):
    """한국 시간대(Asia/Seoul) 기준으로 datetime을 리턴

    - 인자 없이 호출 시 kst_timezone_date()와 유사한 결과를 리턴

    Args:
        dt : 한국 시간으로 변환할 datetime (timezone 정보가 없을 경우 한국 시간대로 간주하며, 설정하지 않으면 today를 리턴)
    """
    return kst_datetime(dt).date()


def to_kst_timezone_format(dt: datetime = None):
    kst_dt = kst_datetime(dt)
    return kst_dt.strftime("%Y-%m-%d %H:%M:%S")


def get_first_day_of_month_with_relativedelta(relativedelta_value, today=None):
    if today is None:
        today = kst_timezone_date()
    this_month_first_day = today.replace(day=1)
    target_date = this_month_first_day - relativedelta_value
    return target_date


def get_monday_with_timedelta(timedelta_value, today=None):
    if today is None:
        today = kst_timezone_date()
    this_week_monday = today - timedelta(days=today.weekday())
    target_date = this_week_monday - timedelta_value
    return target_date


def calc_days_diff_from_today(from_date):
    now = kst_date()
    days_diff = (now - from_date).days
    return days_diff


# 2025-06-26T01:42:35.000Z 형식의 문자열을 datetime 으로 변환
def parse_datetime_from_zulu_time(zulu_time: str) -> datetime:
    if not zulu_time:
        return None
    try:
        return datetime.fromisoformat(zulu_time.replace("Z", "+00:00"))
    except Exception:
        return None
