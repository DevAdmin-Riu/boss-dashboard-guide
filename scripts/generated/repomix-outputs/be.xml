def _make_reorder_notice_schedules(sales_data):
    grouped_data = defaultdict(list)
    for user_id, variant_id, evented_at, quantity in sales_data:
        grouped_data[(user_id, variant_id)].append({"evented_at": evented_at, "quantity": quantity})

    schedules = []
    for (user_id, variant_id), records in grouped_data.items():
        if len(records) < 3:
            continue

        durations = []
        for i in range(1, len(records)):
            prev_quantity = records[i]["quantity"]
            if prev_quantity > 0:
                current_evented_at = records[i - 1]["evented_at"].astimezone()
                current_evented_at = current_evented_at.replace(
                    hour=12, minute=0, second=0, microsecond=0
                )
                prev_evented_at = records[i]["evented_at"].astimezone()
                prev_evented_at = prev_evented_at.replace(
                    hour=12, minute=0, second=0, microsecond=0
                )
                days_diff = (current_evented_at - prev_evented_at).days
                durations.append(my_round(days_diff / prev_quantity, 2))

        if len(durations) < 2:
            continue

        avg_consumption_duration = math.ceil(sum(durations) / len(durations))

        last_record = records[0]
        last_quantity = last_record["quantity"]
        last_evented_at = last_record["evented_at"].astimezone()

        estimated_duration = int(last_quantity * avg_consumption_duration)
        scheduled_at = last_evented_at + timedelta(days=estimated_duration) - timedelta(days=7)

        scheduled_at = scheduled_at.replace(hour=12, minute=0, second=0, microsecond=0)
        today = kst_timezone_now().replace(hour=12, minute=0, second=0, microsecond=0)
        if today < scheduled_at:
            schedule = ReorderNoticeSchedule(
                user_id=user_id,
                variant_id=variant_id,
                scheduled_at=scheduled_at,
                last_evented_at=last_evented_at,
                last_quantity=last_quantity,
                avg_consumption_duration=avg_consumption_duration,
            )
            schedules.append(schedule)
    return schedules


def reset_all_reorder_notice_schedule_data():
    sql_query = """
    WITH ranked_sales AS (
        SELECT
            id,
            evented_at,
            quantity,
            variant_id,
            user_id,
            ROW_NUMBER() OVER (
                PARTITION BY user_id, variant_id
                ORDER BY evented_at DESC
            ) AS rank,
            COUNT(*) OVER (
                PARTITION BY user_id, variant_id
            ) AS total_count
        FROM stats_sales
        where quantity > 0 and user_id is not null and is_order_from_boss_mrkt = false
    )
    SELECT
        user_id, variant_id, evented_at, quantity
    FROM ranked_sales
    WHERE rank <= 3 AND total_count >= 3
    ORDER BY user_id, variant_id, rank;
    """
    with connection.cursor() as cursor:
        cursor.execute(sql_query)
        sales_data = cursor.fetchall()
        schedules = _make_reorder_notice_schedules(sales_data)

        ReorderNoticeSchedule.objects.all().delete()
        if schedules:
            ReorderNoticeSchedule.objects.bulk_create(schedules)


def reset_reorder_notice_schedule_data(user_id, variant_id):
    if user_id is None:
        return

    template = Template(
        """
    SELECT
        user_id, variant_id, evented_at, quantity
    FROM stats_sales
    WHERE quantity > 0 and user_id = $user_id and variant_id = $variant_id and is_order_from_boss_mrkt = false
    ORDER BY evented_at DESC
    LIMIT 3;
    """
    )
    sql_query = template.substitute(user_id=user_id, variant_id=variant_id)
    with connection.cursor() as cursor:
        try:
            cursor.execute(sql_query)
            sales_data = cursor.fetchall()
            schedules: List[ReorderNoticeSchedule] = _make_reorder_notice_schedules(sales_data)

            if schedules:
                schedule = schedules[0]
                ReorderNoticeSchedule.objects.update_or_create(
                    user_id=user_id,
                    variant_id=variant_id,
                    is_sent=False,
                    defaults={
                        "scheduled_at": schedule.scheduled_at,
                        "last_evented_at": schedule.last_evented_at,
                        "last_quantity": schedule.last_quantity,
                        "avg_consumption_duration": schedule.avg_consumption_duration,
                        "updated": kst_timezone_now(),
                    },
                )
        except Exception as e:
            logger.error(f"Failed to reset reorder notice schedule data: {e}")
            return


