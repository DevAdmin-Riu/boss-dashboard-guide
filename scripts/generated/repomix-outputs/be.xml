def set_renewal_mileage_of_order_line(target_date):
    start_time = time.time()
    restart_time = time.time()

    order_line_target_date = target_date
    order_lines = (
        OrderLine.objects.exclude(order__status=OrderStatus.CANCELED)
        .exclude(order__captured_at__isnull=True)
        .exclude(is_converted=True)
        .filter(order__captured_at__gte=order_line_target_date)
        .prefetch_related(
            "order",
            "order__lines",
            "order__payments",
            "order__tax_invoices",
            "variant",
            "variant__product",
            "variant__product__category",
        )
    )
    # reset_queries()

    target_order_lines_count = len(order_lines)
    restart_time = logging_elapsed_time(
        restart_time, f"target order_lines 조회: {target_order_lines_count}"
    )

    update_list = make_update_order_lines_for_renewal_mileage(order_lines=order_lines)

    # print_connection_queries(connection, "make_update_order_lines_for_renewal_mileage")

    restart_time = logging_elapsed_time(
        restart_time, f"make update order line list: {len(update_list)}"
    )

    if update_list and len(update_list) > 0:
        OrderLine.objects.bulk_update(
            objs=update_list,
            batch_size=3000,
            fields=[
                "category_type",
                "is_tax_free",
                "amount",
                "cashable_credits",
                "non_cashable_credits",
                "rcoins",
                "mileage_amount_exclude_vat",
                "paying_charge_exclude_vat",
                "brand_paying_charge_exclude_vat",
                "is_converted",
            ],
        )
        target_order_lines_count = len(update_list)
        restart_time = logging_elapsed_time(
            restart_time,
            f"bulk_update order line: {target_order_lines_count}",
        )

        updated_order_lines = OrderLine.objects.filter(
            id__in=[obj.id for obj in update_list]
        ).prefetch_related(
            "order",
            "order__user",
            "order__user__brand",
            "order__user__brand__staff",
            "order__payments",
            "order__tax_invoices",
            "fulfillment_lines",
            "fulfillment_lines__vendor",
            "variant",
            "variant__attributes",
            "variant__attributes__assignment",
            "variant__attributes__values",
            "variant__attributes__assignment__attribute",
            "variant__attributes__assignment__attribute__values",
            "variant__product",
            "variant__product__attributes",
            "variant__product__attributes__assignment",
            "variant__product__attributes__values",
            "variant__product__attributes__assignment__attribute",
            "variant__product__attributes__assignment__attribute__values",
            "variant__product__category",
            "variant__brand_product_variants",
            "variant__brand_product_variants__brand_product",
        )

        # reset_queries()

        create_sales_stat_list = make_create_stats_sales_by_order_lines(
            order_lines=updated_order_lines
        )
        restart_time = logging_elapsed_time(
            restart_time, f"make create_sales_stat_list: {target_order_lines_count}"
        )
        # print_connection_queries(connection, "make_create_stats_sales_by_order_lines")

        if create_sales_stat_list and target_order_lines_count > 0:
            inner_start_time = restart_time
            chunk_size = 1000
            for chunk in [
                create_sales_stat_list[i : i + chunk_size]
                for i in range(0, target_order_lines_count, chunk_size)
            ]:
                Sales.objects.bulk_create(chunk)
                inner_start_time = logging_elapsed_time(
                    inner_start_time,
                    f"bulk_create chunk: {len(chunk)}",
                )

        restart_time = logging_elapsed_time(
            restart_time, f"bulk_create sales: {target_order_lines_count}"
        )

    logging_elapsed_time(
        start_time,
        f"finish set_renewal_mileage_of_order_line: {target_order_lines_count}",
    )


def parse_refunded_products_info(refunded_products_info) -> List[dict]:
    parsed_refunded_products_info = []

    refunded_products = refunded_products_info.split(",")
    count = len(refunded_products)

    for i in range(count):
        product_info = refunded_products[i]

        # '×' 문자가 일반 'x' 문자가 아닌 특수 문자임 - split 시 주의
        sku_and_qty = product_info.split("×")

        if sku_and_qty and len(sku_and_qty) == 2:
            info = {
                "sku": sku_and_qty[0].strip(),
                "quantity": Decimal(sku_and_qty[1].strip()),
            }

            if info["quantity"] > 0:
                parsed_refunded_products_info.append(info)

    return parsed_refunded_products_info


# 본부수익금 계산 로직 변경 이후 추가된 구조 고려해서 점검 필요함.
def set_renewal_mileage_of_refund_line(target_date):
    start_time = time.time()
    restart_time = time.time()

    refund_transactions: List[Transaction] = (
        Transaction.objects.exclude(payment__order__status=OrderStatus.CANCELED)
        .exclude(is_converted=True)
        .filter(kind="refund", created__gte=target_date)
        .prefetch_related("payment__order")
    )

    refund_transactions_length = len(refund_transactions)
    restart_time = logging_elapsed_time(
        restart_time, f"target refund transactions 조회: {refund_transactions_length}"
    )

    inner_restart_time = time.time()
    update_list = []
    for index, refund_transaction in enumerate(refund_transactions):
        if index % 50 == 0:
            inner_restart_time = logging_elapsed_time(
                inner_restart_time, f"{index+1}/{refund_transactions_length}"
            )
        try:
            refund_info = refund_transaction.refund_info
            refunded_products_info = (
                refund_info.get("refund_products_info", None) if refund_info else None
            )
            if refunded_products_info is None:
                logger.error(
                    f"refund_products_info is None. refund_transaction: {refund_transaction}"
                )
                continue
            parsed_refunded_products_info = parse_refunded_products_info(refunded_products_info)

            refund_lines = []
            for parsed_refunded_product in parsed_refunded_products_info:
                sku = parsed_refunded_product["sku"]
                quantity = parsed_refunded_product["quantity"]
                order_line = OrderLine.objects.filter(
                    order=refund_transaction.payment.order, variant__sku=sku
                ).first()
                if order_line is None:
                    logger.error(
                        f"order_line is None. refund_transaction: {refund_transaction}, sku: {sku}"
                    )
                    continue

                refund_line = RefundOrderLineData(
                    order_line=order_line,
                    refund_quantity=quantity,
                    return_delivery_fee=Decimal(0),
                )
                refund_lines.append(refund_line)

            if len(refund_lines) == 0:
                logger.error(f"refund_lines is empty. refund_transaction: {refund_transaction}")
                continue

            # 반품배송비는 이전 환불 시스템에서 품목별로 입력받지 않았으므로, 첫번째 품목에 전액 할당한다
            return_delivery_fee = refund_transaction.return_delivery_fee
            refund_lines[0].return_delivery_fee = return_delivery_fee

            payment = refund_transaction.payment
            order = payment.order
            _, refund_order_line_data_ary = make_refund_order_line_data(
                refund_amount=refund_transaction.amount,
                refund_cashable_credits=refund_transaction.cashable_credits,
                refund_non_cashable_credits=refund_transaction.non_cashable_credits,
                refund_rcoins=refund_transaction.rcoins,
                refund_lines=refund_lines,
                order=order,
                payment=payment,
                refund_transaction=refund_transaction,
                is_migration_mode=True,
            )

            create_list = make_create_list_for_refund_order_line(
                order=order,
                payment=payment,
                transaction=refund_transaction,
                pg_refund_response=None,
                refund_order_line_data_ary=refund_order_line_data_ary,
                is_migration_mode=True,
            )

            if create_list and len(create_list) > 0:
                refund_order_lines = RefundOrderLine.objects.bulk_create(create_list)
                create_sales_stat_list = make_create_stats_sales_by_refund_order_lines(
                    refund_order_lines=refund_order_lines, is_migration_mode=True
                )
                if create_sales_stat_list and len(create_sales_stat_list) > 0:
                    Sales.objects.bulk_create(create_sales_stat_list)

            refund_transaction.is_converted = True
            update_list.append(refund_transaction)
        except Exception as e:
            import traceback

            traceback_str = traceback.format_exc()
            logger.error(f"refund_transaction: {refund_transaction}, {traceback_str}")

    if update_list and len(update_list) > 0:
        Transaction.objects.bulk_update(
            objs=update_list,
            batch_size=3000,
            fields=[
                "is_converted",
            ],
        )
        restart_time = logging_elapsed_time(
            restart_time, f"bulk_update transactions: {refund_transactions_length}"
        )

    logging_elapsed_time(
        start_time,
        f"finish set_renewal_mileage_of_refund_line: {refund_transactions_length}",
    )


class Command(BaseCommand):
    help = "본부수익금 계산 로직 변경을 위한 기존 데이터 마이그레이션"

    def add_arguments(self, parser):
        parser.add_argument("start_date", nargs="?", help="The start_date in YYYY-MM-DD format")

    @transaction.atomic
    def handle(self, *args, **options):
        start_date_str = options["start_date"]

        if not start_date_str:
            self.stdout.write(
                self.style.ERROR("Usage: python manage.py renewal_mileage YYYY-MM-DD")
            )
            return

        try:
            target_date = datetime.datetime.strptime(start_date_str, "%Y-%m-%d").astimezone()
        except Exception:
            self.stdout.write(
                self.style.ERROR("Usage: python manage.py renewal_mileage YYYY-MM-DD.")
            )
            return

        # Your logic with the parsed date goes here
        self.stdout.write(
            self.style.SUCCESS(
                f"=== 본부수익금 산출 방식 변경 작업 진행 중: start date={target_date} ~"
            )
        )

        # 본부수익금 계산 로직 변경 이후 추가된 구조 고려해서 점검 필요함. -> 실수로 커맨드 실행 시 본부 수익금 계산되지 않도록 주석처리
