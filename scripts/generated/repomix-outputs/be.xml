"""Checkout-related utility functions."""

import logging
from decimal import Decimal
from math import ceil
from typing import TYPE_CHECKING, Iterable, List, Optional, Tuple

from django.core.exceptions import ValidationError
from django.db.models import IntegerField, Sum
from django.db.models.functions import Cast

from ..checkout import base_calculations, calculations
from ..core.taxes import zero_taxed_money
from ..courier.models import CourierDeliveryAdditionalFee
from ..order import OrderDeliveryMethods, OrderType
from ..product.models import BpBundle, BpBundleInfo, BrandProductVariant, ProductVariant
from .models import Checkout, CheckoutLine

logger = logging.getLogger(__name__)

if TYPE_CHECKING:
    from ..account.models import Address
    from ..order.models import Order, OrderLine


def update_checkout_quantity(checkout):
    """Update the total quantity in checkout."""
    total_lines = checkout.lines.aggregate(total_quantity=Sum("quantity"))["total_quantity"]
    if not total_lines:
        total_lines = 0
    checkout.quantity = total_lines
    checkout.save(update_fields=["quantity"])


def check_new_quantity_of_line(
    checkout,
    variant,
    bp_bundle,
    brand_product_variant,
    quantity=1,
    replace=False,
    brand_product_package=None,
) -> Tuple[int, Optional[CheckoutLine]]:
    """Check if a given one is in line and return the new quantity + line."""
    line: CheckoutLine = checkout.lines.filter(
        variant=variant,
        bp_bundle=bp_bundle,
        brand_product_variant=brand_product_variant,
        brand_product_package=brand_product_package,
    ).first()
    line_quantity = 0 if line is None else line.quantity

    new_quantity = quantity if replace else (quantity + line_quantity)

    if new_quantity < 0:
        raise ValueError("%r은(는) 유효한 수량이 아닙니다. (결과: %r)" % (quantity, new_quantity))

    return new_quantity, line


def add_pv_or_bp_bundle_to_checkout(
    checkout: "Checkout",
    variant: "ProductVariant",
    bp_bundle: "BpBundle",
    quantity=1,
    price=0,
    price_vat=0,
    calc_mileage=True,
    exclude_stock_avg_stats=False,
    decrease_stock_flag=True,
    etc_delivery_fee=0,
    b2b_delivery_fee_exclude_vat=0,
    replace=False,
    brand_product_package=None,
    brand_product_variant=None,
    vendor_id=None,
):
    """Add a product variant to checkout.

    If `replace` is truthy then any previous quantity is discarded instead
    of added to.
    """

    if variant is None and bp_bundle is None:
        raise ValidationError(
            "장바구니 상품 구성 오류 입니다. 단품, 세트 상품 정보가 모두 없습니다."
        )

    user = checkout.user
    brand = user.brand if user else None
    brand_product_variant = (
        (brand_product_variant or variant.get_brand_product_variant(brand)) if variant else None
    )

    new_quantity, line = check_new_quantity_of_line(
        checkout,
        variant,
        bp_bundle,
        brand_product_variant,
        quantity=quantity,
        replace=replace,
        brand_product_package=brand_product_package,
    )

    if new_quantity == 0:
        if line is not None:
            line.delete()
    elif line is None:
        create_kwargs = {
            "checkout": checkout,
            "variant": variant,
            "bp_bundle": bp_bundle,
            "brand_product_variant": brand_product_variant,
            "quantity": new_quantity,
            "price": price,
            "price_vat": price_vat,
            "calc_mileage": calc_mileage,
            "exclude_stock_avg_stats": exclude_stock_avg_stats,
            "decrease_stock_flag": decrease_stock_flag,
            "is_selected": True,
            "etc_delivery_fee": etc_delivery_fee,
            "b2b_delivery_fee_exclude_vat": b2b_delivery_fee_exclude_vat,
            "brand_product_package": brand_product_package,
            "vendor_id": vendor_id,
        }
        checkout.lines.create(**create_kwargs)
    elif new_quantity > 0:
        line.quantity = new_quantity
        line.save(update_fields=["quantity"])
    update_checkout_quantity(checkout)


def _check_new_checkout_address(checkout: "Checkout", address):
    """Check if and address in checkout has changed and if to remove old one."""
    old_address = checkout.shipping_address

    has_address_changed = any(
        [
            not address and old_address,
            address and not old_address,
            address and old_address and address != old_address,
        ]
    )

    # 스태프 주문인 경우에는 유저 address 와 무관하므로 old_address 삭제 로직 pass
    if checkout.order_type != OrderType.BY_USER:
        return has_address_changed, False

    remove_old_address = (
        has_address_changed
        and old_address is not None
        and (not checkout.user or old_address not in checkout.user.addresses.all())
    )

    return has_address_changed, remove_old_address


def change_shipping_address_in_checkout(checkout, address):
    """Save shipping address in checkout if changed.

    Remove previously saved address if not connected to any user.
    """
    changed, remove = _check_new_checkout_address(checkout, address)
    if changed:
        if remove:
            checkout.shipping_address.delete()
        checkout.shipping_address = address
        checkout.save(update_fields=["shipping_address", "last_change"])


def is_fully_paid(checkout: "Checkout", lines: Iterable[CheckoutLine]):
    """Check if provided payment methods cover the checkout's total amount.

    Note that these payments may not be captured or charged at all.
    """
    payments = [payment for payment in checkout.payments.all() if payment.is_active]
    payments_total = int(sum([p.total for p in payments]))
    checkout_total = calculations.checkout_total(checkout=checkout, lines=lines)
    checkout_total = max(checkout_total, zero_taxed_money(checkout_total.currency)).gross
    if payments_total != checkout_total.amount:
        subtotal_delivery_additional_fee = (
            base_calculations.base_checkout_subtotal_delivery_additional_fee(checkout, lines)
        )
        logger.warning(
            f"is_fully_paid error: payments_total: {payments_total}, checkout_total: {checkout_total.amount}, subtotal_delivery_additional_fee: {subtotal_delivery_additional_fee.gross.amount}"
        )
        for line in lines:
            line_total = base_calculations.base_checkout_line_total_decimal(checkout, line)
            logger.warning(
                f"is_fully_paid error: checkout_line({line.pk}): sku={line.variant.sku}, quantity={line.quantity}, line_total={line_total}"
            )

    return payments_total == checkout_total.amount


def cancel_active_payments(checkout: "Checkout"):
    checkout.payments.filter(is_active=True).update(is_active=False)


# order_qty 에는 납품 수량이 변경되어도 원래 주문 수량을 입력:  2.5 -> 2.51 이 납품되어도 2박스로 증가되면 곤란
def get_delivery_box_count_consider_adjust_price_pv(pv: "ProductVariant", order_qty):
    if pv.is_adjust_price:
        return ceil(order_qty / pv.qty_per_delivery_box)
    return order_qty


def get_checkout_line_delivery_box_count_consider_bundle(line: "CheckoutLine"):
    bp_bundle: BpBundle = line.bp_bundle
    if not bp_bundle:
        return get_delivery_box_count_consider_adjust_price_pv(line.variant, line.quantity)
    bp_bundle_infos: List[BpBundleInfo] = bp_bundle.bp_bunde_infos_by_prefetched
    checkout_line_qty = line.quantity
    count = 0
    for bp_bundle_info in bp_bundle_infos:
        count += checkout_line_qty * bp_bundle_info.quantity
    return count


def get_delivery_box_count_by_staff_non_bp_bundle_order_line_info(
    pv: "ProductVariant", bpv: "BrandProductVariant", qty
):
    need_delivery_additional_fee = (
        pv.need_delivery_additional_fee and bpv.need_delivery_additional_fee
    )
    if need_delivery_additional_fee:
        return get_delivery_box_count_consider_adjust_price_pv(pv, qty)
    return 0


def get_delivery_box_count_by_staff_order_line_info_consider_bundle(
    sku, checkout_line_qty, bp_bundle_dict, pv_dict, bpv_dict
):
    bp_bundle: BpBundle = bp_bundle_dict.get(sku)
    if not bp_bundle:
        bpv = bpv_dict[sku]
        pv = pv_dict[sku]
        return get_delivery_box_count_by_staff_non_bp_bundle_order_line_info(
            pv, bpv, checkout_line_qty
        )

    count = 0
    need_delivery_additional_fee = bp_bundle.need_delivery_additional_fee
    if need_delivery_additional_fee:
        bp_bundle_infos: List[BpBundleInfo] = bp_bundle.bp_bunde_infos_by_prefetched
        for bp_bundle_info in bp_bundle_infos:
            count += checkout_line_qty * bp_bundle_info.quantity
    return count


def get_delivery_box_count_by_checkout(
    checkout: "Checkout",
    lines: List["CheckoutLine"],
) -> int:
    if checkout.delivery_method != OrderDeliveryMethods.BY_COURIER:
        return 0

    delivery_box_count = 0
    for line in lines:
        # 배송지가 도서산간인 경우 추가요금 부과 대상 제품만 일반 택배 배송 카운트로 처리
        if line.need_delivery_additional_fee:
            delivery_box_count += get_checkout_line_delivery_box_count_consider_bundle(line)

    # 합포장 주문용 박스 수량은 picking_info에서 가져옴
    picking_info = checkout.picking_info
    if picking_info:
        picking_boxes_info = picking_info.get("boxes")
        if picking_boxes_info:
            delivery_box_count_for_picking_order = len(picking_boxes_info)
            delivery_box_count += delivery_box_count_for_picking_order

    return delivery_box_count


def get_delivery_box_count_by_order_lines(order: "Order", lines: List["OrderLine"]) -> int:
    delivery_box_count = 0
    for line in lines:
        # 배송지가 도서산간인 경우 추가요금 부과 대상 제품만 일반 택배 배송 카운트로 처리
        if line.need_delivery_additional_fee:
            delivery_box_count += get_delivery_box_count_consider_adjust_price_pv(
                line.variant, line.quantity - line.quantity_refunded
            )

    # 합포장 주문은 환불 불가로 환불을 고려할 때도 처음 주문 시 합포장용 박스 수량이 모두 카운트됨
    picking_info = order.picking_info
    if picking_info:
        picking_boxes_info = picking_info.get("boxes")
        if picking_boxes_info:
            delivery_box_count_for_picking_order = len(picking_boxes_info)
            delivery_box_count += delivery_box_count_for_picking_order

    return delivery_box_count


def get_delivery_box_count_of_non_fbv_order_lines(order: "Order") -> int:
    if order.delivery_method != OrderDeliveryMethods.BY_COURIER:
        return 0

    lines: List[OrderLine] = order.lines.filter(is_fulfilled_by_vendor=False)
    return get_delivery_box_count_by_order_lines(order, lines)


def get_delivery_box_count_consider_refunded_by_order(order: "Order") -> int:
    if order.delivery_method != OrderDeliveryMethods.BY_COURIER:
        return 0

    lines: List[OrderLine] = order.lines.all()
    return get_delivery_box_count_by_order_lines(order, lines)


def get_unit_delivery_additional_fee_exclude_vat_by_postal_code(postal_code: int) -> Decimal:
    delivery_additional_fee: CourierDeliveryAdditionalFee = (
        CourierDeliveryAdditionalFee.objects.annotate(
            pcode_start_int=Cast("pcode_start", IntegerField()),
            pcode_end_int=Cast("pcode_end", IntegerField()),
        )
        .filter(
            pcode_start_int__lte=int(postal_code),
            pcode_end_int__gte=int(postal_code),
        )
        .first()
    )
    if not delivery_additional_fee:
        return Decimal(0)
    return delivery_additional_fee.unit_additional_fee_exclude_vat


def get_unit_delivery_additional_fee_exclude_vat_by_address(address: "Address") -> Decimal:
    if address is None:
        return Decimal(0)
    try:
        postal_code = int(address.postal_code)
        unit_additional_fee_exclude_vat = (
            get_unit_delivery_additional_fee_exclude_vat_by_postal_code(postal_code)
        )
        return unit_additional_fee_exclude_vat
    except Exception as e:
        error_message = str(e)
        logger.error(
            f"도서산간 추가 배송비 구하기 오류: postal_code={address.postal_code} {error_message}"
        )
        return Decimal(0)


def check_charge_delivery_additional_fee(address: "Address") -> bool:
    unit_additional_fee_exclude_vat = get_unit_delivery_additional_fee_exclude_vat_by_address(
        address
    )
    return unit_additional_fee_exclude_vat > 0
