# https://blog.naver.com/PostView.nhn?blogId=wideeyed&logNo=221551624153&parentCategoryNo=&categoryNo=50&viewDate=&isShowPopularPosts=true&from=search

from decimal import ROUND_HALF_EVEN, ROUND_HALF_UP, Decimal


def my_round(in_number, ndigits=0, rounding_rule=ROUND_HALF_UP):
    """rounding_rule==1: ROUND_HALF_UP, Round to nearest, ties away from zero
    rounding_rule==2: ROUND_HALF_EVEN, Round to nearest, ties to even"""
    # make float expression
    if ndigits > 0:
        expression = "0." + "0" * ndigits
        number = in_number
    else:  # 0 or negative
        expression = "0"
        number = in_number / (10 ** (-ndigits))

    # round by rounding rule
    if rounding_rule == ROUND_HALF_EVEN:
        round_number = Decimal(number).quantize(Decimal(expression), rounding=ROUND_HALF_EVEN)
    else:
        round_number = Decimal(number).quantize(Decimal(expression), rounding=ROUND_HALF_UP)

    if ndigits > 0:
        return round_number
    else:  # 0 or negative
        return int(round_number * (10 ** (-ndigits)))


def is_integer_multiple(a, b):
    if b == 0:
        # b가 0일 경우 a가 어떤 정수의 배수인지 확인할 수 없음
        return False

    result = Decimal(a) / Decimal(b)
    if result % 1 == 0:
        return True
    else:
        return False


def is_valid_decimal(value, max_digits, decimal_places):
    try:
        dec = Decimal(value)
        # Get digits before and after the decimal point
        sign, digits, exponent = dec.as_tuple()
        number_of_digits = len(digits)
        number_of_decimal_places = abs(exponent)

        # Check if the total number of digits is within max_digits
        if number_of_digits - number_of_decimal_places > (max_digits - decimal_places):
            return False

        # Check if the number of decimal places is within decimal_places
        if number_of_decimal_places > decimal_places:
            return False

        # Check if the integer part is within the allowed range
        integer_part = number_of_digits - number_of_decimal_places
        if integer_part > (max_digits - decimal_places):
            return False

        return True
    except Exception:
        return False
