def send_email_to_po_manager_in_case_initial_po(
    purchase_order_lines: List["PurchaseOrderLine"],
    stocked_quantity_list: List["int"],
    stocked_date: datetime.date,
):
    for purchase_order_line, stocked_quantity in zip(purchase_order_lines, stocked_quantity_list):
        # 부분입고 허용으로 각 발주제품의 첫 입고시점에만 발송
        if purchase_order_line.purchase_quantity != stocked_quantity:
            continue
        variant = purchase_order_line.variant
        sku = variant.sku
        product = variant.product
        product_name = product.name
        quantity = int(purchase_order_line.quantity)
        stocked_date_str = stocked_date.strftime("%Y-%m-%d")
        spec_text = make_product_spec_text_by_attribute(convert_to_simple_attribute(variant))

        transaction.on_commit(
            lambda sku=sku, product_name=product_name, spec_text=spec_text, quantity=quantity, stocked_date_str=stocked_date_str: send_email_to_po_manager_in_case_initial_po_task.delay(
                sku=sku,
                product_name=product_name,
                spec_text=spec_text,
                quantity=quantity,
                stocked_date_str=stocked_date_str,
            )
        )


