    def resolve_status_histories(
        root: PurchaseOrderLineModel,
        info,
        after_status_list: List[PurchaseOrderLineStatus] = None,
        before_statuses_list: List[List[PurchaseOrderLineStatus]] = None,
    ):
        if not after_status_list:
            return None

        def get_status_histories(
            histories: List[PurchaseOrderLineStatusHistoryModel],
            after_status_list: List[PurchaseOrderLineStatus],
            before_statuses_list: List[List[PurchaseOrderLineStatus]],
        ):
            # 상태별 해당 history 를 찾는 로직을 개념적으로 처리하기 위해 id 순으로 소팅
            histories = sorted(histories, key=lambda history: history.id, reverse=True)
            filtered_id_list = []

            if not before_statuses_list:
                before_statuses_list = [None] * len(after_status_list)

            for after_status, before_statuses in zip(after_status_list, before_statuses_list):
                if before_statuses is None:
                    history_id = next(
                        (h.id for h in histories if h.after_status == after_status), None
                    )
                else:
                    history_id = next(
                        (
                            h.id
                            for h in histories
                            if h.after_status == after_status and h.before_status in before_statuses
                        ),
                        None,
                    )
                if history_id is not None:
                    filtered_id_list.append(history_id)

            result_histories = [
                history
                for history in histories
                if any(history.id == filtered_id for filtered_id in filtered_id_list)
            ]

            return result_histories

        return (
            PurchaseOrderLineStatusHistoryByPurchaseOrderLineIdLoader(info.context)
            .load(root.id)
            .then(
                lambda histories: get_status_histories(
                    histories, after_status_list, before_statuses_list
                )
            )
        )

    def resolve_req_split_delivery(root: PurchaseOrderLineModel, info):
        if root.status == PurchaseOrderLineStatus.CANCELED:
            return None
        # return root.req_split_deliveries.last()
        return (
            PoLineReqSplitDeliveriesByPoLinesId(info.context)
            .load(root.id)
            .then(lambda deliveries: deliveries[-1] if deliveries else None)
        )

    def resolve_consignment_order_line(root: PurchaseOrderLineModel, info):
        return OrderLineByPurchaseOrderLineIdLoader(info.context).load(root.id)

    def resolve_shipping_address(root: PurchaseOrderLineModel, info):
        if root.shipping_address_id:
            return AddressByIdLoader(info.context).load(root.shipping_address_id)
        return None

    def resolve_purchase_order(root: PurchaseOrderLineModel, info):
        if root.purchase_order_id:
            return PurchaseOrderByIdLoader(info.context).load(root.purchase_order_id)
        return None

    def resolve_order_line(root: PurchaseOrderLineModel, info):
        if root.order_line_id:
            return OrderLineByIdLoader(info.context).load(root.order_line_id)
        return None

    def resolve_variant(root: PurchaseOrderLineModel, info):
        if root.variant_id:
            return ProductVariantByIdLoader(info.context).load(root.variant_id)
        return None

    def resolve_purchase(root: PurchaseOrderLineModel, info):
        return (
            PurchaseByPurchaseOrderLineIdLoader(info.context)
            .load(root.id)
            .then(lambda purchases: purchases[0] if purchases else None)
        )

    def resolve_variant_id(root: PurchaseOrderLineModel, _info):
        if root.variant_id:
            return graphene.Node.to_global_id("ProductVariant", root.variant_id)
        return None

    def resolve_remain_quantity(root: PurchaseOrderLineModel, info):
        def calculate_remain_quantity(results):
            purchase_order: PurchaseOrderModel
            stock_detail: StockDetailModel
            purchase_order, stock_detail = results

            # 위탁이면 남은 수량을 입고 - 반품 수량으로 계산
            if purchase_order.is_consignment_po:
                return root.purchase_quantity - root.take_back_quantity

            # 재고 관리 발주인 경우, 재고가 없으면 0을 반환하고, 존재하면 남은 재고 수량 반환
            if purchase_order.is_track_inventory_po:
                return stock_detail.remain_quantity if stock_detail else 0

            # 그 외 발주 타입(재고 반품, 위탁 반품)에서는 발주 수량을 그대로 반환
            return 0

        # PurchaseOrder와 StockDetail을 비동기적으로 로드
        purchase_order_loader = PurchaseOrderByIdLoader(info.context).load(root.purchase_order_id)
        stock_detail_loader = StockDetailByPurchaseOrderLineIdLoader(info.context).load(root.id)

        # 두 개의 결과를 모두 받은 후에 처리
        return Promise.all([purchase_order_loader, stock_detail_loader]).then(
            calculate_remain_quantity
        )

    def resolve_stock_detail(root: PurchaseOrderLineModel, info):
        return StockDetailByPurchaseOrderLineIdLoader(info.context).load(root.id)


