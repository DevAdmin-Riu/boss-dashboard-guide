COLOR_PATTERN = r"^(#[0-9a-fA-F]{3}|#(?:[0-9a-fA-F]{2}){2,4}|(rgb|hsl)a?\((-?\d+%?[,\s]+){2,3}\s*[\d\.]+%?\))$"  # noqa
color_pattern = re.compile(COLOR_PATTERN)


class AttributeValue(CountableDjangoObjectType):
    name = graphene.String(description=AttributeValueDescriptions.NAME)
    slug = graphene.String(description=AttributeValueDescriptions.SLUG)
    input_type = AttributeInputTypeEnum(description=AttributeDescriptions.INPUT_TYPE)
    can_delete = graphene.Boolean(description="삭제 가능 여부: 제품에 사용 중이면 삭제 불가")
    value = GenericScalar(description="AttributeValue 에 연결된 설정 값 정보")

    class Meta:
        description = "Represents a value of an attribute."
        only_fields = ["id"]
        interfaces = [relay.Node]
        model = models.AttributeValue

    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_input_type(root: AttributeValueModel, info, *_args):
        if root.attribute_id:
            return (
                AttributeByIdLoader(info.context)
                .load(root.attribute_id)
                .then(lambda attribute: attribute.input_type)
            )
        else:
            return None

    def resolve_can_delete(root: AttributeValueModel, info):
        def check_can_delete(results):
            product_types, product_variant_types = results
            return not product_types and not product_variant_types

        product_types_promise = ProductTypesByAttributeIdLoader(info.context).load(
            root.attribute_id
        )
        product_variant_types_promise = ProductVariantTypesByAttributeIdLoader(info.context).load(
            root.attribute_id
        )

        return Promise.all([product_types_promise, product_variant_types_promise]).then(
            check_can_delete
        )


class Attribute(CountableDjangoObjectType):
    input_type = AttributeInputTypeEnum(description=AttributeDescriptions.INPUT_TYPE)

    name = graphene.String(description=AttributeDescriptions.NAME)
    slug = graphene.String(description=AttributeDescriptions.SLUG)

    values = graphene.List(
        AttributeValue,
        description=AttributeDescriptions.VALUES,
    )
    choices = FilterInputConnectionField(
        AttributeValue,
        sort_by=AttributeChoicesSortingInput(),
        filter=AttributeChoiceFilterInput(),
        description=AttributeDescriptions.VALUES,
    )
    value_required = graphene.Boolean(
        description=AttributeDescriptions.VALUE_REQUIRED,
        required=True,
    )
    visible_in_storefront = graphene.Boolean(
        description=AttributeDescriptions.VISIBLE_IN_STOREFRONT, required=True
    )
    filterable_in_dashboard = graphene.Boolean(
        description=AttributeDescriptions.FILTERABLE_IN_DASHBOARD, required=True
    )
    available_in_grid = graphene.Boolean(
        description=AttributeDescriptions.AVAILABLE_IN_GRID, required=True
    )
    is_variant_only = graphene.Boolean(
        description=AttributeDescriptions.IS_VARIANT_ONLY, required=True
    )
    can_delete = graphene.Boolean(description="삭제 가능 여부: 제품에 사용 중이면 삭제 불가")
    use_value = graphene.Boolean(
        description="metadata 사용 여부: 예시-boxSize 속성 값에 대해 기준 택배 단가 설정 사용"
    )

    class Meta:
        description = (
            "Custom attribute of a product. Attributes can be assigned to products and "
            "variants at the product type level."
        )
        only_fields = ["id", "product_types", "product_variant_types"]
        interfaces = [relay.Node, ObjectWithMetadata]
        model = models.Attribute

    def resolve_product_types(root: AttributeModel, info):
        return ProductTypesByAttributeIdLoader(info.context).load(root.id)

    def resolve_product_variant_types(root: AttributeModel, info):
        return ProductVariantTypesByAttributeIdLoader(info.context).load(root.id)

    @staticmethod
    def resolve_values(root: AttributeModel, info):
        if root.is_directly_assigned:
            return []
        return AttributeValuesByAttributeIdLoader(info.context).load(root.id)

    @staticmethod
    def resolve_choices(root: AttributeModel, _info, **_kwargs):
        if root.is_directly_assigned:
            return []
        return root.values.all()

    @staticmethod
    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_private_meta(root: AttributeModel, _info):
        return resolve_private_meta(root, _info)

    @staticmethod
    def resolve_meta(root: AttributeModel, _info):
        return resolve_meta(root, _info)

    @staticmethod
    def resolve_value_required(root: AttributeModel, *_args):
        return root.value_required

    @staticmethod
    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_visible_in_storefront(root: AttributeModel, *_args):
        return root.visible_in_storefront

    @staticmethod
    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_filterable_in_dashboard(root: AttributeModel, *_args):
        return root.filterable_in_dashboard

    @staticmethod
    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_available_in_grid(root: AttributeModel, *_args):
        return root.available_in_grid

    def resolve_can_delete(root: AttributeModel, info):
        def check_can_delete(results):
            product_types, product_variant_types = results
            return not product_types and not product_variant_types

        product_types_promise = ProductTypesByAttributeIdLoader(info.context).load(root.id)
        product_variant_types_promise = ProductVariantTypesByAttributeIdLoader(info.context).load(
            root.id
        )

        return Promise.all([product_types_promise, product_variant_types_promise]).then(
            check_can_delete
        )


class SelectedAttribute(graphene.ObjectType):
    attribute = graphene.Field(
        Attribute,
        default_value=None,
        description=AttributeDescriptions.NAME,
        required=True,
    )
    values = graphene.List(AttributeValue, description="Values of an attribute.", required=True)

    class Meta:
        description = "Represents a custom attribute."


class AttributeInput(graphene.InputObjectType):
    slug = graphene.String(required=True, description=AttributeDescriptions.SLUG)
