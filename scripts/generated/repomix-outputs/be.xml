# ExtendedCheckoutComplete 내부 호출 용도로만 사용: 프론트엔드에서 단독 호출 금지
class CheckoutPackageOrderUpdate(BaseMutation):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        checkout_id = graphene.ID(description="The ID of the checkout.", required=True)
        brand_product_package_id = graphene.ID(description="패키지 ID", required=True)
        input = PackageOrderInput(required=True, description="패키지 상품 주문의 경우 추가 정보.")

    class Meta:
        description = "패키지 주문 정보 업데이트"
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, checkout_id, brand_product_package_id, input):
        checkout: CheckoutModel = cls.get_node_or_error(
            info, checkout_id, only_type=Checkout, field="checkout_id"
        )
        # get_node로 하는 경우 다른 브랜드몰(보스장터)에서 결제 시도시 에러나기때문에 아래와 같이 처리.
        _, brand_product_package_id_from_global_id = graphene.Node.from_global_id(
            brand_product_package_id
        )
        brand_product_package: BrandProductPackageModel = (
            product_models.BrandProductPackage.objects.get(
                pk=brand_product_package_id_from_global_id
            )
        )
        delivery_method = input.get("delivery_method", OrderDeliveryMethods.BY_COURIER)
        estimated_arrival_date = input.get("estimated_arrival_date")

        # brand_product_package_id를 가진 chekcout lines들의 delivery_method, package_shipping_date를 update 한다.
        additional_fee_for_etc_delivery = 0
        if delivery_method != OrderDeliveryMethods.BY_COURIER:
            if check_charge_delivery_additional_fee(checkout.shipping_address):
                additional_fee_for_etc_delivery = (
                    brand_product_package.additional_fee_for_etc_delivery
                )

        checkout.delivery_method = delivery_method
        checkout.estimated_arrival_date = estimated_arrival_date
        checkout.additional_fee_for_etc_delivery = additional_fee_for_etc_delivery
        checkout.save(
            update_fields=[
                "delivery_method",
                "estimated_arrival_date",
                "additional_fee_for_etc_delivery",
            ]
        )
        # delivery_method가 BY_COURIER가 아닌 경우, brand_product_pacakge에 있는 etc_delivery_fee를 checkoutline중 1군데에만 넣어준다.
        if delivery_method != OrderDeliveryMethods.BY_COURIER:
            etc_delivery_fee = brand_product_package.etc_delivery_fee
            checkout_line = models.CheckoutLine.objects.filter(
                checkout_id=checkout.pk, brand_product_package_id=brand_product_package.id
            ).first()
            checkout_line.etc_delivery_fee = F("etc_delivery_fee") + etc_delivery_fee
            checkout_line.save(update_fields=["etc_delivery_fee"])

        return CheckoutPackageOrderUpdate(checkout=checkout)


