def format_address(address, include_phone=True, inline=False, latin=False):
    address_data = address.as_data()
    street_address_format = (
        "{name}\n{phone}\n\n({postal_code}) {street_address_1} {street_address_2}"
    )
    formatted_address = street_address_format.format(
        name=address_data["first_name"],
        phone=address_data["phone"],
        postal_code=address_data["postal_code"],
        street_address_1=address_data["street_address_1"],
        street_address_2=address_data["street_address_2"],
    )
    address_lines = formatted_address.split("\n")
    return {"address_lines": address_lines, "inline": inline}
