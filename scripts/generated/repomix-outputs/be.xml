    mail_title_for_log = "도입 문의 메일 발송"

    recipient_list = get_inquire_about_service_manager_email_list()

    context = {
        "company_name": inquire_about_service.company_name,
        "business_type": inquire_about_service.business_type,
        "phone": format_as_hypenated_phone_number(inquire_about_service.phone) or "-",
        "email": inquire_about_service.email,
        "num_of_stores": inquire_about_service.num_of_stores,
        "inquiry_content": inquire_about_service.inquiry_content,
        "inquiry_path": inquire_about_service.inquiry_path.label,
    }
    if len(recipient_list) == 0:
        logger.info(f"{mail_title_for_log}을 위한 담당자 이메일 설정을 확인하세요. {context}")
        return

    send_kwargs, ctx = get_email_context()
