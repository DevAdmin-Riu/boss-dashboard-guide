class BbsUploadImage(BaseMutation):
    success = graphene.Boolean()
    image_url = graphene.String()

    class Arguments:
        input = BbsImageUploadInput(
            required=True, description="Fields required to upload an image."
        )

    class Meta:
        description = "Upload an image. This mutation must be sent as a `multipart` request."
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def check_permissions(cls, context, permissions=None, **data):
        if context.user.is_hq_staff:
            return True
        else:
            return super().check_permissions(context, permissions, **data)

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        data = data.get("input")
        image_data = info.context.FILES.get(data["image"])
        image_data.name = image_data.name.replace(" ", "_")
        validate_image_file(image_data, "image")

        # 로컬 환경일 때
        if settings.DEBUG:
            path = default_storage.save(f"bbs/{image_data.name}", image_data)
            image_url = f"http://localhost:8080{settings.MEDIA_URL}{path}"
        else:  # 실서버 환경일 때
            s3 = boto3.client(
                "s3",
                aws_access_key_id=settings.AWS_ACCESS_KEY_ID,
                aws_secret_access_key=settings.AWS_SECRET_ACCESS_KEY,
                region_name=settings.AWS_S3_REGION_NAME,
            )

            try:
                key = f"bbs/{image_data.name}"
                s3.upload_fileobj(image_data, settings.AWS_MEDIA_BUCKET_NAME, key)
                image_url = f"https://{settings.AWS_MEDIA_CUSTOM_DOMAIN}/{key}"
            except NoCredentialsError:
                return BbsUploadImage(success=False, image_url=None)

        return BbsUploadImage(success=True, image_url=image_url)


