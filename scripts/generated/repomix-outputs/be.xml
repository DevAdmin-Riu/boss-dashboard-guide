import graphene
from django.contrib.auth import password_validation
from django.core.exceptions import ValidationError
from django.db import transaction

from saleor.account.models import User as UserModel
from saleor.graphql.brand_store.enums import BrandStoreRoleEnum
from saleor.graphql.core.types.common import AccountError

from ....account.validators import validate_possible_number
from ....brand_store import BrandStoreRole
from ....brand_store.models import BrandStoreUser as BrandStoreUserModel
from ...brand_store.types import BrandStore as BrandStoreType
from .base import UserCreateInput
from .staff import CustomerCreate


class StoreWorkerCreateInput(UserCreateInput):
    brand_store_role = BrandStoreRoleEnum(required=True, description="매장 직원 권한")
    brand_store = graphene.ID(
        required=True, description="ID of the brand store that customer belongs to."
    )
    password = graphene.String(
        description="비밀번호, 필수는 아님.",
    )


class StoreWorkerCreate(CustomerCreate):
    brand_store = graphene.Field(
        BrandStoreType,
        description="매장 직원이 소속된 매장",
    )

    class Arguments:
        input = StoreWorkerCreateInput(required=True, description="매장 직원 생성에 필요한 정보")

    class Meta:
        description = "Create a new store worker."
        exclude = ["password"]
        model = UserModel
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def clean_input(cls, info, instance, data, input_cls=None):
        input_brand_store_role = data.get("brand_store_role")
        if (
            input_brand_store_role == BrandStoreRole.OWNER
            and instance.brand_store_role != BrandStoreRole.OWNER
        ):
            raise ValidationError("직원에게 점주 권한을 부여할 수 없습니다.")

        cleaned_input = super().clean_input(info, instance, data)
        brand_store_global_id = data.get("brand_store")
        brand_store = (
            cls.get_node_or_error(
                info, brand_store_global_id, only_type=BrandStoreType, field="brand_store"
            )
            if brand_store_global_id
            else instance.brand_store_user.brand_store
        )
        cleaned_input["brand_store"] = brand_store

        _type, brand_store_id = (
            graphene.Node.from_global_id(brand_store_global_id)
            if brand_store_global_id
            else (None, instance.brand_store_user.brand_store_id)
        )
        brand_store_id = int(brand_store_id)

        brand_id = (
            cleaned_input.get("brand").id if cleaned_input.get("brand") else instance.brand_id
        )

        if brand_id and brand_id != brand_store.brand.id:
            raise ValidationError("매장 브랜드정보에 오류가 있습니다.")
        requestor = info.context.user
        owned_brand_store = requestor.owned_brand_store_instance
        requestor_brand_store_role = requestor.brand_store_role

        if requestor.is_staff:
            pass
        elif brand_store.brand_id == requestor.brand_id and (
            requestor.is_hq_staff_admin or requestor.is_hq_staff_supervisor_all
        ):
            pass
        elif requestor.hq_staff_brand_stores.filter(brand_store_id=brand_store_id).exists():
            pass
        elif (
            owned_brand_store
            and owned_brand_store.id == brand_store_id
            and requestor_brand_store_role == BrandStoreRole.OWNER
        ):
            # 바꾸려는 유저의 brand_store_id가 동일하면서 requesetor가 owner 경우.
            pass
        else:
            raise ValidationError("해당 기능의 권한이 없습니다.")

        password = data.get("password")
        if password:
            try:
                password_validation.validate_password(password, instance)
            except ValidationError as error:
                raise ValidationError({"password": error})

        aligo_phone = data.get("aligo_phone")
        if aligo_phone:
            try:
                data["aligo_phone"] = validate_possible_number(aligo_phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {
                        "phone": ValidationError(
                            f"'{aligo_phone}' {phoneValidErrorMsg}", code=exc.code
                        )
                    }
                ) from exc

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        if instance.__class__ == UserModel and cls == StoreWorkerCreate:
            brand_store = cleaned_data.get("brand_store")
            brand = brand_store.brand
            instance.brand = brand
            instance.switched_brand = brand
            brand_store = cleaned_data.get("brand_store")
            password = cleaned_data.get("password") or brand_store.brand.code
            instance.set_password(password)
        return instance

    @classmethod
    @transaction.atomic
    def save(cls, info, user, cleaned_input):
        user.save()
        brand_store_role = cleaned_input.get("brand_store_role")
        brand_store = cleaned_input.get("brand_store")

        BrandStoreUserModel.objects.create(
            user=user,
            brand_store=brand_store,
            role=brand_store_role,
        )

    @classmethod
    def success_response(cls, instance):
        response = super().success_response(instance)
        response.brand_store = instance.brand_store
        return response


