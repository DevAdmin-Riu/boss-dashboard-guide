class PurchaseUpdateInput(graphene.InputObjectType):
    dev_cost_exclude_vat = PositiveDecimal(description="개발비 (부가세 별도)")
    etc_exclude_vat = PositiveDecimal(description="기타비용 (부가세 별도)")
    b2b_delivery_fee_exclude_vat = PositiveDecimal(description="b2b 배송비 (부가세 별도)")

    vendor = graphene.ID(description="협력사 id")

    unit_cost_price_exclude_vat = PositiveDecimal(description="매입가 (부가세 별도)")
    quantity = PositiveDecimal(description="수량")


class PurchaseUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="매입마감 결산 매입 데이터 id")
        input = PurchaseUpdateInput(required=True, description="매입마감 수정을 위한 Input")

    class Meta:
        description = "매입 마감 수정"
        model = models.Purchase
        permissions = (PurchasePermissions.MANAGE_PURCHASE,)
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def check_is_take_back(cls, instance: PurchaseModel):
        purchase_order = instance.purchase_order
        return purchase_order.is_take_back_po or purchase_order.is_consignment_take_back_po

    @classmethod
    def clean_input(cls, info, instance: PurchaseModel, data, input_cls=None):
        if instance.status not in [
            PurchaseStatus.STANDBY,
            PurchaseStatus.REQ_REVISION,
            PurchaseStatus.REVISION,
        ]:
            raise ValidationError("대기, 수정, 또는 수정 요청 상태일 때만 수정할 수 있습니다.")

        is_take_back = cls.check_is_take_back(instance)
        # is_take_back 가 true 인 경우, etc_exclude_vat 값, dev_cost_exclude_vat, vendor 중 하나라도 존재하면 안됨.
        if is_take_back:
            if (
                "b2b_delivery_fee_exclude_vat" in data
                or "etc_exclude_vat" in data
                or "dev_cost_exclude_vat" in data
                or "vendor" in data
            ):
                raise ValidationError(
                    "반품 매입은 기타비용, 개발비, B2B 배송비, 협력사 정보를 수정할 수 없습니다.",
                    code=StatsErrorCode.INVALID,
                )

        cleaned_data = super().clean_input(info, instance, data)
        return cleaned_data

    @classmethod
    def construct_instance(cls, info, instance: PurchaseModel, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)

        purchase_ordeer = instance.purchase_order
        is_take_back = (
            purchase_ordeer.is_take_back_po or purchase_ordeer.is_consignment_take_back_po
        )

        # instance의 parameters(JSON Field)안의 product안의 unit_cost_price_exclude_vat 필드를 cleaned_data의 unit_cost_price_exclude_vat로 업데이트
        # cleaned_data에 unit_cost_price_exclude_vat 값이 넘어오지 않은 경우 업데이트 하지 않는다.
        if "unit_cost_price_exclude_vat" in cleaned_data:
            instance.parameters["product"]["unit_cost_price_exclude_vat"] = str(
                cleaned_data["unit_cost_price_exclude_vat"]
            )

        if "vendor" in cleaned_data:
            vendor = instance.vendor
            # code랑 이름만 업데이트한다.
            instance.parameters["vendor"]["code"] = vendor.code
            instance.parameters["vendor"]["name"] = vendor.name

        # instance의 parameters(JSON Field)안의 product안의 quantity 필드를 cleaned_data의 quantity로 업데이트. cleaned_data의 quantity는 절대 값을 취해서 음수가 아니도록 한다.
        # cleaned_data에 quantity 값이 넘어오지 않은 경우 업데이트 하지 않는다.
        if "quantity" in cleaned_data:
            instance.parameters["product"]["quantity"] = str(abs(cleaned_data["quantity"]))

        variant = instance.purchase_order_line.variant
        price_decimal_places = variant.price_decimal_places

        quantity = Decimal(instance.parameters["product"]["quantity"])
        instance.cost_price_exclude_vat = my_round(
            Decimal(instance.parameters["product"]["unit_cost_price_exclude_vat"]) * quantity,
            price_decimal_places,
        )

        # 위탁 반품인 경우에만 take_back_unit_cost_delivery_fee_exclude_vat 가 0 이 아닐 수 있음.
        take_back_total_delivery_fee_exclude_vat = (
            calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
                instance.take_back_unit_cost_delivery_fee_exclude_vat, quantity, False
            )
        )

        vat_amount = calc_vat_amount_of_purchse(
            cost_price_exclude_vat=instance.cost_price_exclude_vat,
            is_tax_free=variant.product.is_tax_free,
            is_take_back=is_take_back,
            etc_exclude_vat=instance.etc_exclude_vat,
            dev_cost_exclude_vat=instance.dev_cost_exclude_vat,
            take_back_total_delivery_fee_exclude_vat=take_back_total_delivery_fee_exclude_vat,
            b2b_delivery_fee_exclude_vat=instance.b2b_delivery_fee_exclude_vat,
            price_decimal_places=price_decimal_places,
        )

        instance.vat_amount = vat_amount

        if instance.status == PurchaseStatus.REQ_REVISION:
            instance.status = PurchaseStatus.REVISION

        return instance
