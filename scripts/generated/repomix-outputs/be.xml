            required=True, description="Fields required to create an fulfillment."
        )

    class Meta:
        description = "Creates new fulfillments for an order."
        permissions = (OrderPermissions.MANAGE_FULFILLMENT,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: "User" = context.user
        # 협력사인 경우 권한 체크 패스하고 validation 처리
        if user.is_vendor_staff:
            return True
        return super().check_permissions(context, **data)

    @classmethod
    def clean_lines(cls, order_lines: List[OrderLineModel], quantities, delivery_method):
        for order_line, line_quantities in zip(order_lines, quantities):
            if can_fulfill_more_than_ordered(order_line, delivery_method):
                continue

            line_quantity_unfulfilled = order_line.quantity_unfulfilled
            if sum(line_quantities) > line_quantity_unfulfilled:
                msg = (
                    "Only %(quantity)d item%(item_pluralize)s remaining "
                    "to fulfill: %(order_line)s."
                ) % {
                    "quantity": line_quantity_unfulfilled,
                    "item_pluralize": pluralize(line_quantity_unfulfilled),
                    "order_line": order_line,
                }
                order_line_global_id = graphene.Node.to_global_id("OrderLine", order_line.pk)
                raise ValidationError(
                    {
                        "order_line_id": ValidationError(
                            msg,
                            code=OrderErrorCode.FULFILL_ORDER_LINE,
                            params={"order_line": order_line_global_id},
                        )
                    }
                )

    @classmethod
    def check_warehouses_for_duplicates(cls, warehouse_ids):
        for warehouse_ids_for_line in warehouse_ids:
            duplicates = get_duplicated_values(warehouse_ids_for_line)
            if duplicates:
                raise ValidationError(
                    {
                        "warehouse": ValidationError(
                            "Duplicated warehouse ID.",
                            code=OrderErrorCode.DUPLICATED_INPUT_ITEM,
                            params={"warehouse": duplicates.pop()},
                        )
                    }
                )

    @classmethod
    def check_lines_for_duplicates(cls, lines_ids):
        duplicates = get_duplicated_values(lines_ids)
        if duplicates:
            raise ValidationError(
                {
                    "orderLineId": ValidationError(
                        "Duplicated order line ID.",
                        code=OrderErrorCode.DUPLICATED_INPUT_ITEM,
                        params={"order_line": duplicates.pop()},
                    )
                }
            )

    @classmethod
    def check_total_quantity_of_items(cls, quantities_for_lines):
        flat_quantities = sum(quantities_for_lines, [])
        if sum(flat_quantities) <= 0:
            raise ValidationError(
                {
                    "lines": ValidationError(
                        "Total quantity must be larger than 0.",
                        code=OrderErrorCode.ZERO_QUANTITY,
                    )
                }
            )

    @classmethod
    def validate_is_fulfilled_by_vendor(cls, is_fulfilled_by_vendor, order_lines):
        if is_fulfilled_by_vendor:
            not_fullfilled_by_vendor_order_lines = [
                order_line for order_line in order_lines if not order_line.is_fulfilled_by_vendor
            ]
            if not_fullfilled_by_vendor_order_lines:
                raise ValidationError("직거래 상품 출고 모드에 보스 제품 주문이 포함되어 있습니다.")
        else:
            fulfilled_by_vendor_order_lines = [
                order_line for order_line in order_lines if order_line.is_fulfilled_by_vendor
            ]
            if fulfilled_by_vendor_order_lines:
                raise ValidationError("보스 제품 출고 모드에 직거래 상품 주문이 포함되어 있습니다.")

    @classmethod
    def clean_input(
        cls, input_data, order: OrderModel, is_fulfilled_by_vendor, order_lines_from_bulk=None
    ):
        payment = order.get_last_payment()
        charge_status = payment.charge_status

        lines = input_data["lines"]

        warehouse_ids_for_lines = [
            [stock["warehouse"] for stock in line["stocks"] if "warehouse" in stock]
            for line in lines
        ]
        cls.check_warehouses_for_duplicates(warehouse_ids_for_lines)

        quantities_for_lines = [[stock["quantity"] for stock in line["stocks"]] for line in lines]

        lines_ids = [line["order_line_id"] for line in lines]
        cls.check_lines_for_duplicates(lines_ids)

        qs_for_order_line = models.OrderLine.objects.select_related(
            "variant", "variant__default_variant_vendor", "variant__default_variant_vendor__vendor"
        )

        order_lines: List[OrderLineModel] = order_lines_from_bulk or cls.get_nodes_or_error(
            lines_ids, field="lines", only_type=OrderLine, qs=qs_for_order_line
        )

        cls.validate_is_fulfilled_by_vendor(is_fulfilled_by_vendor, order_lines)

        delivery_method = input_data.get("delivery_method", order.delivery_method)
        cls.clean_lines(order_lines, quantities_for_lines, delivery_method)

        cls.check_total_quantity_of_items(quantities_for_lines)

        lines_for_warehouses_dict = defaultdict(list)
        lines_track_inventory = []
        lines_non_track_inventory = []
        lines_direct_shipping = []
        lines_non_direct_shipping = []
        for line, order_line in zip(lines, order_lines):
            if is_fulfilled_by_vendor == False:
                if order_line.track_inventory:
                    lines_track_inventory.append(order_line)
                else:
                    product: Product = order_line.variant.product
                    lines_non_track_inventory.append(order_line)
                    if product:
                        if product.is_direct_shipping:
                            lines_direct_shipping.append(order_line)
                        else:
                            lines_non_direct_shipping.append(order_line)

            b2b_delivery_fee_exclude_vat = int(line.get("b2b_delivery_fee_exclude_vat", 0))
            for stock in line["stocks"]:
                if stock["quantity"] > 0:
                    warehouse_pk = (
                        from_global_id_strict_type(
                            stock["warehouse"], only_type=Warehouse, field="warehouse"
                        )
                        if "warehouse" in stock
                        else None
                    )

                    lines_for_warehouses_dict[warehouse_pk].append(
                        {
                            "order_line": order_line,
                            "quantity": stock["quantity"],
                            "b2b_delivery_fee_exclude_vat": b2b_delivery_fee_exclude_vat,
                        }
                    )

        if len(lines_track_inventory) * len(lines_non_track_inventory) > 0:
            raise ValidationError(
                "위탁 / 보관 제품 동시 출고 정책 위반",
                code=OrderErrorCode.VIOLATION_FULFILLMENT_RULE,
            )
        if len(lines_direct_shipping) * len(lines_non_direct_shipping) > 0:
            raise ValidationError(
                "직배송 / 일반위탁 제품 동시 출고 정책 위반",
                code=OrderErrorCode.VIOLATION_FULFILLMENT_RULE,
            )

        # 재고 주문이거나 택배 주문인 경우엔 결제 완료 상태인 건만 출고 처리 가능
        if (
            len(lines_non_track_inventory) == 0
            or order.delivery_method in [OrderDeliveryMethods.BY_COURIER]
        ) and charge_status in [ChargeStatus.PENDING, ChargeStatus.BEING_APPROVED]:
            raise ValidationError(
                f"결제가 완료되지 않은 재고 주문, 위탁 택배주문은 출고할 수 없습니다. 주문번호: {order.composed_id_with_prefix}"
            )

        input_data["order_lines"] = order_lines
        input_data["quantities"] = quantities_for_lines
        input_data["lines_for_warehouses_dict"] = lines_for_warehouses_dict
        return input_data

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, order, **data):
        order_instance_from_bulk = data.get("order_instance")
        order_lines_from_bulk = data.get("order_lines")

        order: OrderModel = order_instance_from_bulk or cls.get_node_or_error(
            info,
            order,
            field="order",
            only_type=Order,
            qs=models.Order.objects.prefetch_related("lines"),
        )
        input_data = data.get("input")
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor", False)
        cleaned_input = cls.clean_input(
            input_data, order, is_fulfilled_by_vendor, order_lines_from_bulk
        )

        user = info.context.user
        lines_for_warehouses_dict = cleaned_input["lines_for_warehouses_dict"]
        if is_fulfilled_by_vendor:
            fulfillments = create_fulfillments_by_vendor(
                user,
                order,
                dict(lines_for_warehouses_dict),
            )
        else:
            delivery_method = cleaned_input.get("delivery_method", order.delivery_method)
            is_picking_order = cleaned_input.get("is_picking_order", False)
            batch_picking_id = cleaned_input.get("batch_picking_id")
            if is_picking_order and batch_picking_id is not None:
                batch_picking = cls.get_node_or_error(
                    info, batch_picking_id, only_type="BatchPicking"
                )
            else:
                batch_picking = None

            try:
                fulfillments = create_fulfillments(
                    user,
                    order,
                    dict(lines_for_warehouses_dict),
                    delivery_method,
                    is_picking_order,
                    batch_picking,
                )
            except InsufficientStock as e:
                order_line_global_id = graphene.Node.to_global_id(
                    "OrderLine", e.context["order_line"].pk
                )
                warehouse_global_id = graphene.Node.to_global_id(
                    "Warehouse", e.context["warehouse_pk"]
                )
                productStockErrorMsg = "해당 상품의 재고가 부족합니다."
                raise ValidationError(
                    {
                        "stocks": ValidationError(
                            f"{productStockErrorMsg}: {e.item}",
                            code=OrderErrorCode.INSUFFICIENT_STOCK,
                            params={
                                "order_line": order_line_global_id,
                                "warehouse": warehouse_global_id,
                            },
                        )
                    }
                )

        for fulfillment in fulfillments:
            delivery_method = order.delivery_method
            if delivery_method == OrderDeliveryMethods.BY_COURIER:
                # 택배니 line은 하나 라고 가정.
                fulfillment_line = fulfillment.lines.first()
                order_line = fulfillment_line.order_line
                purchase_order_line: PurchaseOrderLine = order_line.purchase_order_line
                purchase_order: PurchaseOrder = (
                    purchase_order_line.purchase_order if purchase_order_line else None
                )
                if purchase_order and not purchase_order.is_track_inventory_po:
                    if order_line.variant.is_dev_pv:
                        # FulfillmentUpdateTracking 에서 출고 가능한지 보는 로직 회피용으로 tracking_number 업데이트함.
                        fulfillment.tracking_number = 1
                        fulfillment.save(update_fields=["tracking_number"])
                        # mutate가 아니라 perform_mutation이라서 try catch로 안감싸도 어차피 뚫고 에러 발생할듯.
                        FulfillmentUpdateTracking.perform_mutation(
                            _root,
                            info,
                            **{
                                "id": graphene.Node.to_global_id("Fulfillment", fulfillment.id),
                                "is_po_line_delivery_confirmed": True,
                                "input": {
                                    "tracking_number": "1",
                                    "courier_id": graphene.Node.to_global_id(
                                        "Courier", COURIER_ID_OF_UNKNOWN
                                    ),
                                    "is_tracking_completed": True,
                                },
                            },
                        )

        return OrderFulfill(fulfillments=fulfillments, order=order)


class OrderFulfillBulkInput(graphene.InputObjectType):
    # OrderFulfill의 Arguments를 포함하는 Input을 구성한다.
    orderId = graphene.ID(description="ID of the order to be fulfilled.", required=True)
    input = OrderFulfillInput(
        required=True, description="Fields required to create an fulfillment."
    )


class OrderFulfillBulk(BaseMutation):
    class Arguments:
        orders_to_fulfill = graphene.List(
            OrderFulfillBulkInput,
            required=True,
            description="List of orders to be fulfilled.",
        )

    class Meta:
        description = "Creates new fulfillments for orders."
        permissions = (OrderPermissions.MANAGE_FULFILLMENT,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: "User" = context.user
        # 협력사인 경우 권한 체크 패스하고 validation 처리
        if user.is_vendor_staff:
            return True
        return super().check_permissions(context, **data)

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        user: "User" = info.context.user

        import time

        orders_to_fulfill = data.get("orders_to_fulfill")
        errors = []

        # 1. 주문 ID들을 모아서 한 번에 Order 객체들을 로드
        order_ids = [
            graphene.Node.from_global_id(order_to_fulfill.get("orderId"))[1]
            for order_to_fulfill in orders_to_fulfill
        ]
        orders_qs = models.Order.objects.prefetch_related("lines", "payments").filter(
            pk__in=order_ids
        )
        orders_map = {str(order.pk): order for order in orders_qs}

        # 2. 모든 주문의 input에 있는 lines에서 주문 라인 글로벌 ID들을 추출하여 한 번에 OrderLine 객체들을 로드
        all_order_line_ids = []
        for order_to_fulfill in orders_to_fulfill:
            input_data = order_to_fulfill.get("input")
            if input_data and "lines" in input_data:
                for line in input_data["lines"]:
                    line_global_id = line.get("order_line_id")
                    if line_global_id:
                        all_order_line_ids.append(graphene.Node.from_global_id(line_global_id)[1])
        qs_for_order_line = (
            models.OrderLine.objects.filter(pk__in=all_order_line_ids)
            .select_related(
                "order",
                "variant",
                "variant__default_variant_vendor",
                "variant__default_variant_vendor__vendor",
            )
            .prefetch_related("order__payments")
        )
        all_order_lines = list(qs_for_order_line)

        # 3. 각 주문 처리시, 해당 주문에 속하는 주문 라인들만 골라서 perform_mutation 호출
        counter = 0
        is_adjust_price_order_line_map: Dict[int, OrderLine] = {}
        for order_to_fulfill in orders_to_fulfill:
            counter += 1

            order_global_id = order_to_fulfill.get("orderId")
            order_pk = graphene.Node.from_global_id(order_global_id)[1]
            order: OrderModel = orders_map.get(order_pk)
            input_data = order_to_fulfill.get("input")

            if input_data and "lines" in input_data:
                # 해당 주문의 input에서 각 line의 주문 라인 글로벌 ID를 추출
                current_line_ids = [
                    graphene.Node.from_global_id(line.get("order_line_id"))[1]
                    for line in input_data["lines"]
                ]
                # all_order_lines에서 현재 주문에 해당하는 주문 라인 인스턴스만 선택
                order_lines = [line for line in all_order_lines if str(line.pk) in current_line_ids]
                # 원래 input 순서를 유지하도록 정렬 (current_line_ids 순서 기준)
                order_lines.sort(key=lambda line: current_line_ids.index(str(line.pk)))
            else:
                order_lines = []

            for order_line in order_lines:
                is_adjust_price_order_line_case = check_adjust_price_order_line(
                    order_line, order.delivery_method
                )
                if is_adjust_price_order_line_case:
                    is_adjust_price_order_line_map[order_line.id] = order_line

            try:
                OrderFulfill.perform_mutation(
                    _root,
                    info,
                    order=order,
                    input=input_data,
                    order_instance=order,  # 추가 인자: 주문 인스턴스
                    order_lines=order_lines,  # 추가 인자: 해당 주문에 속한 OrderLine 객체들
                )
            except Exception as e:
                errors.append(e)

            # 50건마다 1초 휴식
            if counter % 50 == 0:
                time.sleep(1)

        if errors:
            raise ValidationError(errors)

        # 납품 시 납품 금액 확정은 박스당 중량으로 분할 출고 되므로 요청된 출고 처리 완료 후 뒷처리 필요
        is_adjust_price_order_lines = list(is_adjust_price_order_line_map.values())
        if is_adjust_price_order_lines:
            from ....order.actions import update_on_change_qty_on_adjust_price

            order_lines_group_by_order = make_order_lines_group_by_order(
                is_adjust_price_order_lines
            )
            for order, order_lines in order_lines_group_by_order.items():
                update_on_change_qty_on_adjust_price(user, order, order_lines)

        return OrderFulfillBulk()


class FulfillmentUpdateTracking(BaseMutation):
