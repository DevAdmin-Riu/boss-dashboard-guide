class FbvPurchaseCostEventCreate(ModelMutation):

    class Arguments:
        input = FbvPurchaseCostEventCreateInput(
            required=True, description="가맹본부 협력사 채무 변동 정보"
        )

    class Meta:
        description = "가맹본부 협력사 채무 변동 내역 생성"
        model = models.FbvPurchaseCostEvent
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)

        type = cleaned_input.get("type")
        if type not in [
            FbvPurchaseCostEventType.DECREASE,
            FbvPurchaseCostEventType.INCREASE,
            FbvPurchaseCostEventType.SETTLEMENT,
        ]:
            raise ValidationError(
                f"{type}: 가맹본부 협력사 채무 변동 내역으로 추가할 수 없는 타입입니다."
            )
        amount = cleaned_input.get("amount")
        if amount <= 0:
            raise ValidationError("가맹본부 협력사 채무 변동 금액은 0보다 커야합니다.")

        return cleaned_input

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        instance: FbvPurchaseCostEventModel = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        instance = cls.construct_instance(info, instance, cleaned_input)

        if instance.type in [
            FbvPurchaseCostEventType.SETTLEMENT,
            FbvPurchaseCostEventType.DECREASE,
        ]:
            instance = decrease_fbv_purchase_cost_remain_amount(
                user=info.context.user,
                brand=instance.brand,
                vendor=instance.vendor,
                amount=instance.amount,
                type=instance.type,
                description=instance.description,
            )
        elif instance.type in [FbvPurchaseCostEventType.INCREASE]:
            instance = increase_fbv_purchase_cost_remain_amount(
                user=info.context.user,
                brand=instance.brand,
                vendor=instance.vendor,
                amount=instance.amount,
                type=instance.type,
                description=instance.description,
            )
        else:
            raise ValidationError("가맹본부 협력사 채무 변동 내역으로 추가할 수 없는 타입입니다.")

        return cls.success_response(instance)


