    class Arguments:
        input = RequestFbvProductCreateInput(
            required=True, description="직거래 상품 등록 요청 입력"
        )

    class Meta:
        description = "직거래 상품 등록 요청"
        model = models.RequestFbvProduct
        permissions = (BbsPermissions.MANAGE_REQUEST_FPV_PRODUCT,)
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def check_permissions(cls, context, permissions=None, **data):
        requester: "User" = context.user
        if not requester.is_hq_staff:
            raise PermissionDenied(user=requester, cls=cls)
        return True

    @classmethod
    def clean_input(cls, info, instance: RequestFbvProductModel, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data, input_cls)
        if cls == RequestFbvProductUpdate:
            cleaned_input["last_changed_at"] = timezone.now()
        cleaned_input["status"] = RequestFbvProductStatus.REQUESTED
        return cleaned_input

    @classmethod
    def get_before_status(cls, instance: RequestFbvProductModel):
        return None if instance.pk is None else instance.status

    @classmethod
    def post_save_action(
        cls,
        info,
        instance: RequestFbvProductModel,
        cleaned_input,
        before_status,
    ):
        is_retry = before_status is not None
        models.RequestFbvProductStatusHistory.objects.create(
            request=instance,
            before_status=before_status,
            after_status=instance.status,
            writer=info.context.user,
            reason="반려 후 재접수" if is_retry else "요청 등록",
        )
        brand = instance.brand
        staff_email = brand.staff.email if brand and brand.staff else None
        if staff_email:
            context = {
                "brand_name": brand.name,
                "product_name": instance.product_name,
                "dashboard_url": build_absolute_dashboard_uri(),
            }

            transaction.on_commit(
                lambda: send_templated_mail_req_fbv_product_requested(
                    staff_email=staff_email, context=context, is_retry=is_retry
                )
            )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        before_status = cls.get_before_status(instance)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, before_status)
        return cls.success_response(instance)


