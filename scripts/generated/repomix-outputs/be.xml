    *,
    brand_name: str,
    notice_title: str,
    receiver_phone_bulk: List[str],
):
    try:
        parameters = {
            "brand_name": brand_name,
            "notice_title": notice_title,
            RECEIVER_PHONE_BULK: receiver_phone_bulk,
        }
        get_plugins_manager().send_kakaotalk(
            talk_event_code=AligoEvents.BRAND_NOTICE, parameters=parameters
        )
        return True
    except Exception as E:
        logger.error(
            f"{send_kakaotalk_to_users_on_send_notice_from_hq_notification.__name__} error: {E}"
        )
        return False


def push_notification_on_request_to_hq_create(request: BrandStoreRequestToHq):
    brand_store = request.brand_store

    user_ids = brand_store.hq_staff_brand_stores.values_list("user_id", flat=True)
    request_origin = RequestOriginType.DASHBOARD
    title = "매장 요청 등록 알림"
