class NumberOfNonStoppedBrandProductVariantsByBrandIdLoader(DataLoader):
    context_key = "number_of_non_stopped_brand_product_variants_by_brand_id"

    def batch_load(self, keys):
        from .types import NumberOfBrandProductVariants

        # 여러 brand_id에 대해 한 번에 쿼리 실행
        results = (
            BrandProductVariant.objects.filter(brand_product__brand_id__in=keys)
            .exclude(product_variant__sales_status=SalesStatus.STOPPED)
            .values("brand_product__brand_id")
            .annotate(
                total=Count("id"),
                exclusive=Count("id", filter=Q(brand_product__is_exclusive=True)),
                exclusive_direct_shipping_only=Count(
                    "id",
                    filter=Q(
                        brand_product__is_exclusive=True,
                        brand_product__product__is_direct_shipping=True,
                    ),
                ),
                common_direct_shipping_only=Count(
                    "id",
                    filter=Q(
                        brand_product__is_exclusive=False,
                        brand_product__product__is_direct_shipping=True,
                    ),
                ),
                fulfilled_by_vendor=Count(
                    "id", filter=Q(brand_product__product__is_fulfilled_by_vendor=True)
                ),
            )
        )

        # 결과를 brand_id를 키로 한 사전 형태로 정리
        results_map = {result["brand_product__brand_id"]: result for result in results}

        # 각 brand_id에 대해 결과 매핑
        return [
            NumberOfBrandProductVariants(
                total=results_map.get(brand_id, {}).get("total", 0),
                exclusive=results_map.get(brand_id, {}).get("exclusive", 0),
                common=(
                    results_map.get(brand_id, {}).get("total", 0)
                    - results_map.get(brand_id, {}).get("exclusive", 0)
                ),
                exclusive_direct_shipping_only=results_map.get(brand_id, {}).get(
                    "exclusive_direct_shipping_only", 0
                ),
                common_direct_shipping_only=results_map.get(brand_id, {}).get(
                    "common_direct_shipping_only", 0
                ),
                fulfilled_by_vendor=results_map.get(brand_id, {}).get("fulfilled_by_vendor", 0),
            )
            for brand_id in keys
        ]


def _get_exclusive_bpv_qs(brand_ids):
    return (
        BrandProductVariant.objects.filter(
            brand_product__brand_id__in=brand_ids, brand_product__is_exclusive=True
        )
        .exclude(product_variant__sales_status=SalesStatus.STOPPED)
        .values(
            "id",  # BrandProductVariant ID
            "brand_product__brand_id",
            "cost_price_exclude_vat",
            "delivery_fee_amount",
            "product_variant__product__is_tax_free",
            "product_variant__id",
            "product_variant__outer_id",
            "product_variant__inner_id",
            "product_variant__cost_price_exclude_vat",
            "product_variant__delivery_fee_amount",
        )
    )


def _collect_exclusive_bpv_variant_ids(bpv_list):
    variant_ids = set()
    all_variant_ids = set()
    outer_variant_ids = set()
    for bpv in bpv_list:
        variant_ids.add(bpv["product_variant__id"])
        all_variant_ids.add(bpv["product_variant__id"])
        if bpv["product_variant__outer_id"]:
            all_variant_ids.add(bpv["product_variant__outer_id"])
            outer_variant_ids.add(bpv["product_variant__outer_id"])
        if bpv["product_variant__inner_id"]:
            all_variant_ids.add(bpv["product_variant__inner_id"])
            # inner_id가 존재한다는 건 현재 variant가 outer임 → outer_variant_ids에 추가
            outer_variant_ids.add(bpv["product_variant__id"])
    return variant_ids, outer_variant_ids, all_variant_ids


def _build_exclusive_bpv_stock_map(all_variant_ids):
    country_code = settings.DEFAULT_COUNTRY
    stock_qs = (
        Stock.objects.for_country(country_code)
        .filter(product_variant_id__in=all_variant_ids)
        .values("product_variant_id")
        .annotate(total_quantity=Coalesce(Sum("quantity"), 0))
    )
    return {s["product_variant_id"]: s["total_quantity"] for s in stock_qs}


def _build_exclusive_bpv_pv_map(variant_ids):
    pv_qs = ProductVariant.objects.select_related("inner", "outer").filter(id__in=variant_ids)
    return {pv.id: pv for pv in pv_qs}


def _build_exclusive_bpv_latest_po_line_map(outer_variant_ids):
    latest_stocked_po_lines_qs = (
        PurchaseOrderLine.objects.filter(
            variant_id__in=outer_variant_ids,
            status__in=ALREADY_STOCKED_STATUSES,
        )
        .order_by("variant_id", "-purchase_date", "-pk")
        .distinct("variant_id")  # variant_id별 최신 한 개만
    )
    return {po_line.variant_id: po_line for po_line in latest_stocked_po_lines_qs}


def _get_inner_and_outer_pv(pv_id, pv_map):
    pv: ProductVariant = pv_map.get(pv_id)
    if pv.is_inner:
        outer_pv = pv.outer
        inner_pv = pv
    else:
        outer_pv = pv
        inner_pv = pv.inner
    return inner_pv, outer_pv


def _calc_exclusive_bpv_total_qty(pv_id, pv_map, stock_map):
    inner_pv, outer_pv = _get_inner_and_outer_pv(pv_id, pv_map)
    outer_qty = stock_map.get(outer_pv.id, 0)
    converted_inner_qty_to_outer_base = 0
    if inner_pv is not None:
        pack_count = calc_pack_count(inner_pv, outer_pv)
        if pack_count > 0:
            inner_qty = stock_map.get(inner_pv.id, 0)
            converted_inner_qty_to_outer_base = my_round(inner_qty / pack_count, 2)
    return outer_qty + converted_inner_qty_to_outer_base


class ExclusiveVariantsStockInfoByBrandIdLoader(DataLoader):
    context_key = "exclusive_variants_stock_info_by_brand_id"

    def batch_load(self, brand_ids):
        bpv_qs = _get_exclusive_bpv_qs(brand_ids)
        bpv_list = list(bpv_qs)
        variant_ids, _, all_variant_ids = _collect_exclusive_bpv_variant_ids(bpv_list)
        stock_map = _build_exclusive_bpv_stock_map(all_variant_ids)
        pv_map = _build_exclusive_bpv_pv_map(variant_ids)

        # brand_id 기준으로 집계
        result_map = defaultdict(
            lambda: {"in_stock_count": 0, "total_bpv_cost": 0, "total_pv_cost": 0}
        )

        for bpv in bpv_qs:
            brand_id = bpv["brand_product__brand_id"]
            pv_id = bpv["product_variant__id"]
            total_quantity = _calc_exclusive_bpv_total_qty(pv_id, pv_map, stock_map)
            if total_quantity > 0:
                is_tax_free = bpv["product_variant__product__is_tax_free"]
                if is_tax_free:
                    bpv_cost = total_quantity * (
                        Decimal(bpv["cost_price_exclude_vat"] or 0)
                        + Decimal(bpv["delivery_fee_amount"] or 0)
                    )
                    pv_cost = total_quantity * (
                        Decimal(bpv["product_variant__cost_price_exclude_vat"] or 0)
                        + Decimal(bpv["product_variant__delivery_fee_amount"] or 0)
                    )
                else:
                    bpv_cost = total_quantity * (
                        my_round(Decimal(bpv["cost_price_exclude_vat"] or 0) * Decimal(1.1))
                        + Decimal(bpv["delivery_fee_amount"] or 0)
                    )
                    pv_cost = total_quantity * (
                        my_round(
                            Decimal(bpv["product_variant__cost_price_exclude_vat"] or 0)
                            * Decimal(1.1)
                        )
                        + Decimal(bpv["product_variant__delivery_fee_amount"] or 0)
                    )
                result_map[brand_id]["in_stock_count"] += 1
                result_map[brand_id]["total_bpv_cost"] += bpv_cost
                result_map[brand_id]["total_pv_cost"] += pv_cost

        # 결과 반환
        return [result_map[brand_id] for brand_id in brand_ids]


