        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_unique_value_for_invoice(cls, cleaned_input):
        vendor_code_set = set()
        combined_user_code_set = set()
        invoice_po_lines: List["PurchaseOrderLineModel"] = cleaned_input.get("purchase_order_lines")
        for po_line in invoice_po_lines:
            vendor = po_line.purchase_order.vendor
            vendor_code_set.add(vendor.code)

            order_line = po_line.order_line
            if order_line:
                user_name = order_line.order.user.first_name
                postal_code = po_line.shipping_address.postal_code
                combined_user_code = f"{user_name}({postal_code})"
                combined_user_code_set.add(combined_user_code)

        if len(vendor_code_set) > 1:
            raise ValidationError(
                "거래명세서 추가 발송은 한 번에 하나의 협력사에게만 발송할 수 있습니다. 협력사를 다시 확인해주세요. (협력사코드: {})".format(
                    ", ".join(vendor_code_set)
                )
            )

        if len(combined_user_code_set) > 1:
            raise ValidationError(
                "거래명세서 추가 발송은 한 번에 하나의 고객사에게만 발송할 수 있습니다. 주문번호 및 고객사를 다시 확인해주세요. (담당자 및 납품 장소 우편번호: {})".format(
                    ", ".join(combined_user_code_set)
                )
            )

    @classmethod
    def clean_input(cls, info, instance: PoLinesInvoiceSentEmailModel, input_data):
        cleaned_input = super().clean_input(info, instance, input_data)

        cls.validate_unique_value_for_invoice(cleaned_input)

        return cleaned_input

    @classmethod
    def post_save_action(cls, info, instance: PoLinesInvoiceSentEmailModel, cleaned_input):
        shipment_inspection_input_list = cleaned_input.get("shipment_inspection_input_list")
        shipment_inspection_instance_list: List["PoLineShipmentInspectionSentEmailModel"] = []
        # 실무에서 B2B 발주는 품목 종류는 적고, 품목당 발주 수량이 많은 성격이라고 함. 이에 따라 bulk 뮤테이션이 아닌 아래 로직으로 처리.
        for shipment_inspection_input in shipment_inspection_input_list:
            shipment_inspection_response = PoLineShipmentInspectionSentEmailCreate.perform_mutation(
                _root=None, info=info, input=shipment_inspection_input
            )
            shipment_inspection_instance_list.append(
                shipment_inspection_response.poLineShipmentInspectionSentEmail
            )

        purchase_order_lines: List[PurchaseOrderLineModel] = cleaned_input.get(
            "purchase_order_lines"
        )
        updated_po_code_list = []
        for purchase_order_line in purchase_order_lines:
            purchase_order = purchase_order_line.purchase_order
            po_code = purchase_order.code
            if po_code in updated_po_code_list:
                continue
            updated_po_code_list.append(po_code)

            events.add_po_manage_event(
                purchase_order=purchase_order,
                user=info.context.user,
                type=PurchaseOrderManageEventType.BRAND_INVOICE_EMAIL_SENT,
                parameters={
                    "message": f"거래명세서 이메일 전송.\n보낸 사람 : {instance.from_email}\n받는 사람 : {instance.recipient_list}\n참조 : {instance.cc_list}"
                },
            )

        send_email_po_lines_invoice_to_brand(
            user_name=info.context.user.first_name,
            po_lines_invoice_sent_email=instance,
            po_line_shipment_inspection_sent_email_list=shipment_inspection_instance_list,
        )


