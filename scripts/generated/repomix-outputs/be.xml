def _get_refund_data(
    payment: "Payment",
    refund_data: RefundData,
) -> Dict:
    from ..payment.utils import make_refund_json_data

    refund_json_data = make_refund_json_data(refund_data)
    parameters = refund_json_data
    parameters["pay_method"] = payment.token
    parameters["is_toss_riu_pay"] = payment.is_toss_riu_pay

    return {"parameters": parameters}


