import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ...core.permissions import AccountPermissions
from ...courier import models
from ...courier.models import CourierDeliveryAdditionalFee as CourierDeliveryAdditionalFeeModel
from ..core.mutations import BaseMutation, ModelBulkDeleteMutation
from ..core.scalars import PositiveDecimal
from ..core.types.common import CourierError
from ..product.bulk_mutations.utils import validate_data_is_non_null


class CourierBulkDelete(ModelBulkDeleteMutation):
