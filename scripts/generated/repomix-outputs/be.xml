                qty_per_box_unit_type = detail.get("qty_per_box_unit_type")
                if qty_per_box_unit_type is not None:
                    pv.qty_per_box_unit_type = qty_per_box_unit_type
                sales_unit_type = detail.get("sales_unit_type")
                if sales_unit_type is not None:
                    pv.sales_unit_type = sales_unit_type
                product_attributes_cleaned_input = detail.get("product_attributes_cleaned_input")
                if product_attributes_cleaned_input:
                    AttributeAssignmentMixin.save(pv.product, product_attributes_cleaned_input)
                variant_attributes_cleaned_input = detail.get("variant_attributes_cleaned_input")
                if variant_attributes_cleaned_input:
                    AttributeAssignmentMixin.save(pv, variant_attributes_cleaned_input)

                base_sell_price_exclude_vat = detail.get("base_sell_price_exclude_vat")
                if base_sell_price_exclude_vat is not None:
                    pv.base_sell_price_exclude_vat = base_sell_price_exclude_vat
                base_sell_price_set_date = detail.get("base_sell_price_set_date")
                if base_sell_price_set_date is not None:
                    pv.base_sell_price_set_date = base_sell_price_set_date
                market_lowest_price_exclude_vat = detail.get("market_lowest_price_exclude_vat")
                if market_lowest_price_exclude_vat is not None:
                    pv.market_lowest_price_exclude_vat = market_lowest_price_exclude_vat
                market_lowest_price_source = detail.get("market_lowest_price_source")
                if market_lowest_price_source is not None:
                    pv.market_lowest_price_source = market_lowest_price_source
                market_lowest_price_set_date = detail.get("market_lowest_price_set_date")
                if market_lowest_price_set_date is not None:
                    pv.market_lowest_price_set_date = market_lowest_price_set_date
                is_seasonal = detail.get("is_seasonal")
