import graphene
from django.core.exceptions import ValidationError
from django.db import transaction
from django.db.models import Subquery
from django.utils import timezone

from ...account import BrandServiceType, BrandVacsFeeEventType
from ...account.models import Brand as BrandModel
from ...core.permissions import AccountPermissions
from ...core.utils.str_utils import to_locale_number
from ...vacs import AccountStatus
from ...vacs.emails import send_templated_mail_notify_vact_count
from ...vacs.error_codes import VacsErrorCode
from ...vacs.models import OrgCode, RiuVact
from ..account.types import Brand, User
from ..core.mutations import BaseMutation, ModelMutation
from ..core.types.common import VacsError


class VactAssign(BaseMutation):
    user = graphene.Field(User, description="User with a virtual account assigned.")

    class Meta:
        description = "assign a virtual account."
        error_type_class = VacsError
        error_type_field = "vacs_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        return context.user.is_authenticated and context.user.is_brand_user

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        requester = info.context.user

        user_vact = RiuVact.objects.filter(user=requester)
        if user_vact:
            raise ValidationError(
                "이미 할당된 가상계좌가 있습니다.",
                code=VacsErrorCode.ALREADY_ASSIGNED.value,
            )

        org_codes = OrgCode.objects.for_user(requester)
        new_vact = (
            RiuVact.objects.select_for_update()
            .filter(
                user=None,
                brand=None,
                acct_st=AccountStatus.READY.value,
                org_code__in=Subquery(org_codes.values("org_cd")),
            )
            .first()
        )

        if new_vact:
            new_vact.user = requester
            new_vact.assigned_at = timezone.now()
            new_vact.acct_st = AccountStatus.ASSIGNED.value
            new_vact.save()

            brand: BrandModel = requester.brand
            if BrandServiceType.FBV in brand.enabled_services:
                vacs_create_fee_exclude_bat = brand.vacs_create_fee_exclude_vat
                brand.increase_remain_vacs_fee_exclude_vat(
                    user=requester,
                    amount_exclude_vat=vacs_create_fee_exclude_bat,
                    type=BrandVacsFeeEventType.CREATE_FEE,
                    description="충전 계좌 발급 수수료",
                )

            org_info = OrgCode.objects.filter(org_cd=new_vact.org_code_id).first()
            vact_cnt = RiuVact.objects.filter(
                user=None, brand=None, acct_st=AccountStatus.READY.value, org_code=new_vact.org_code
            ).count()

            if vact_cnt <= org_info.min_qty:
                try:
                    context = {
                        "org_cd": org_info.org_cd,
                        "org_name": org_info.org_name,
                        "num_of_vacts": to_locale_number(vact_cnt),
                    }
                    send_templated_mail_notify_vact_count.delay(org_info.manager_email, context)
                except Exception as E:
                    pass

        else:
            raise ValidationError(
                "할당 가능한 가상계좌가 없습니다.",
                code=VacsErrorCode.INSUFFICIENT_VACT.value,
            )

        return VactAssign(user=requester)


class VirtualAccountInput(graphene.InputObjectType):
    org_name = graphene.String(description="가상계좌 발급 기관 이름", required=True)
    manager_email = graphene.String(description="가상계좌 발급 기관 담당자 이메일", required=True)
    manager_name = graphene.String(description="가상계좌 발급 기관 담당자 이름", required=True)
    manager_phone = graphene.String(description="가상계좌 발급 기관 담당자 연락처", required=True)
    # is_private = graphene.Boolean(description="가상계좌 발급 정보 적용 여부")
    min_qty = graphene.Int(
        description="알람 잔여 가상계좌 수량(해당 수량 이하로 떨어지면 담당자에게 연락)"
    )
    brand = graphene.ID(description="가상계좌 발급 코드를 할당할 브랜드 ID.", required=True)


class VirtualAccountCreateInput(VirtualAccountInput):
    org_cd = graphene.String(description="가상계좌 발급 기관 코드", required=True)


class VirtualAccountCreate(ModelMutation):
    class Arguments:
        input = VirtualAccountCreateInput(
            description="Fields required to create org code info.", required=True
        )

    class Meta:
        description = "Creates new virtual account org info."
        model = OrgCode
        permissions = (AccountPermissions.ONLY_SUPER_USER,)
        error_type_class = VacsError
        error_type_field = "vacs_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)
        # 리우의 가상계좌가 아닌 경우 is_private가 True 값을 가져야 할당이 가능.
        # 리우 가상계좌는 이미 설정되어 있으므로 이후 추가되는 가상계좌 발급 기관 정보에서 is_private는 무조건 True.
        cleaned_input["is_private"] = True

        return cleaned_input


class VirtualAccountUpdate(VirtualAccountCreate):
