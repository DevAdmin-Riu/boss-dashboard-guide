class StockDetailLoss(BaseMutation):
    stock = graphene.Field(Stock)

    class Arguments:
        input = StockDetailLossInput(description="재고 로스 처리를 위한 input 형식", required=True)

    class Meta:
        description = "특정 로케이션의 재고를 로스 처리"
        error_type_class = StockError
        error_type_field = "stock_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        quantity = input_data.get("quantity")
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor")
        rack_location = None
        if is_fulfilled_by_vendor:
            stock_id = input_data.get("stock")
            if stock_id is None:
                raise ValidationError("직거래 상품 로스 처리 시 stock id를 입력해야 합니다.")
            stock: StockModel = graphene.Node.get_node_from_global_id(
                info, stock_id, only_type=Stock
            )
            if stock is None:
                raise ValidationError("존재하지 않는 stock id 입니다.")
        else:
            stock_detail_id = input_data.get("stock_detail")
            rack_location_id = input_data.get("rack_location")
            if stock_detail_id is None:
                raise ValidationError("보스 제품 로스 처리 시 stock detail id를 입력해야 합니다.")
            if rack_location_id is None:
                raise ValidationError("보스 제품 로스 처리 시 rack location id를 입력해야 합니다.")

            stock_detail: StockDetailModel = graphene.Node.get_node_from_global_id(
                info, stock_detail_id, only_type=StockDetail
            )
            if stock_detail is None:
                raise ValidationError("존재하지 않는 stock_detail_id 입니다.")

            rack_location: RackLocationModel = graphene.Node.get_node_from_global_id(
                info, rack_location_id, only_type=RackLocation
            )
            if rack_location is None:
                raise ValidationError("존재하지 않는 location id 입니다.")

            rack_stock_detail: RackStockDetailModel = models.RackStockDetail.objects.filter(
                location=rack_location, stock_detail=stock_detail
            ).first()
            if rack_stock_detail is None:
                raise ValidationError("로스 처리할 로케이션에 선택된 재고번호가 존재하지 않습니다.")
            if rack_stock_detail.remain_quantity < quantity:
                raise ValidationError(
                    "로케이션 데이터에 남아 있는 재고량 보다 많이 로스 처리할 수 없습니다."
                )

            stock: StockModel = stock_detail.stock

        quantity_allocated = stock.allocations.get_quantity_allocated()
        if stock.quantity - quantity_allocated < quantity:
            raise ValidationError("남아 있는 가용 재고량 보다 많이 로스 처리할 수 없습니다.")
        stock.decrease_stock(quantity)

        requestor = info.context.user
        reason = input_data.get("reason", "-")
        if not is_fulfilled_by_vendor:
            stock_detail.decrease_remain_stock(quantity)
            rack_stock_detail.decrease_remain_stock(quantity)
            send_loss_stock_detail_event_email(
                stock,
                user=requestor,
                quantity=quantity,
                reason=reason,
                rack_location=rack_location,
            )
        create_loss_stock_detail_event(
            stock,
            user=requestor,
            quantity=quantity,
            reason=reason,
            rack_location=rack_location,
        )

        return StockDetailLoss(stock=stock)


