class CustomerQuestionStatusUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of an RefundQA")
        input = CustomerQuestionStatusUpdateInput(required=True)

    class Meta:
        description = "신청된 문의 접수 상태로 변경 mutation"
        model = models.RefundQA
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance: RefundQAModel, data):
        cleaned_input = super().clean_input(info, instance, data)
        input_status = cleaned_input.get("status")

        if instance.is_fbv:
            if input_status not in [RefundStatusType.ACCEPTED]:
                raise ValidationError(
                    "직거래 상품 주문의 교환/환불 신청건에서 관리되지 않는 상태로 변경 요청되었습니다."
                )

        if input_status == RefundStatusType.ACCEPTED:
            if instance.status != RefundStatusType.REQUESTED:
                raise ValidationError("신청 건에 대해서만 접수 처리를 할 수 있습니다.")
            cleaned_input["status"] = input_status
        elif input_status == RefundStatusType.STOCK_INCLUDED_REQUESTED:
            if instance.status != RefundStatusType.REFUND_SUCCESS:
                raise ValidationError(
                    "환불 완료된 건에 대해서만 재고 포함 요청 처리를 할 수 있습니다."
                )
        elif input_status == RefundStatusType.REJECT:
            if instance.status != RefundStatusType.COLLECTED_INSPECT:
                raise ValidationError("검수단계 상태에서만 반려할 수 있습니다.")
        elif input_status == RefundStatusType.QUESTION_CLOSE:
            if (
                instance.status == RefundStatusType.REFUND_SUCCESS
                or instance.status == RefundStatusType.ACCEPTED
                or instance.status == RefundStatusType.STOCK_INCLUDED_REQUESTED
                or instance.status == RefundStatusType.REJECT
                or instance.status == RefundStatusType.CHANGE_SUCCESS
                or instance.status == RefundStatusType.REFUND_PENDING
            ):
                pass
            else:
                raise ValidationError(
                    "처리 완료는 환불 완료, 재고 재포함 요청된 상태에서만 할 수 있습니다."
                )

        cleaned_input["status"] = input_status
        return cleaned_input

    @classmethod
    def post_save_action(cls, info, instance: RefundQAModel, cleaned_input):
        memo = cleaned_input.get("memo")
        models.RefundQAHistory.objects.create(
            refund_qa=instance, user=info.context.user, status=instance.status, memo=memo
        )


class NoticeBrandsAssign(BaseMutation):
    notice = graphene.Field(Notice, description="mutation 실행 후 리턴할 notice")

