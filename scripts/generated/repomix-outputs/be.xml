from enum import Enum
from typing import Iterable, List

from django.contrib.auth.models import Permission


class BasePermissionEnum(Enum):
    @property
    def codename(self):
        return self.value.split(".")[1]


class AccountPermissions(BasePermissionEnum):
    VIEW_STAFF = "account.view_staff"
    MANAGE_ADDRESS = "account.manage_address"
    MANAGE_USER_INFO = "account.manage_user_info"
    MANAGE_BRANDS = "account.manage_brands"
    MANAGE_MONTHLY_SETTLEMENT_BY_FBV = "account.manage_monthly_settlement_by_fbv"
    MANAGE_MONTHLY_SETTLEMENT = "account.manage_monthly_settlement"
    MANAGE_POINTS = "account.manage_points"
    MANAGE_HQ_STAT = "account.manage_hq_stat"

    # Model에 추가 금지. 권한 부여가 불가능한 권한임. 권한부여가 불가하기 떄문에 super_user만 사용 가능한 권한임.
    # 참고로 Super user도 아래 권한을 가지지는 않음. 권한 체크시에만 아래 권한 사용..!
    ONLY_SUPER_USER = "account.only_super_user"
