from ....stats.error_codes import StatsErrorCode
from ....stats.models import Purchase as PurchaseModel
from ...core.mutations import BaseBulkMutation, ModelMutation
from ...core.scalars import PositiveDecimal
from ...core.types.common import StatsError
from .types import *


class PurchaseCancel(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a purchase to cancel.")

    class Meta:
        description = "매입 취소"
        model = models.Purchase
        permissions = (PurchasePermissions.MANAGE_PURCHASE,)
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def perform_mutation(cls, root, info, **data):
        purchase: PurchaseModel = cls.get_instance(info, **data)
        purchase.status = PurchaseStatus.CANCELED
        purchase.save(update_fields=["status"])
        return cls.success_response(purchase)


class PurchaseBulkClose(BaseBulkMutation):
    class Arguments:
        ids = graphene.List(graphene.ID, required=True, description="매입마감 대상 purchase ids")
        purchase_close_date = graphene.Date(
            required=True,
            description="매입마감 처리할 마감일 => (YYYY-MM-DD) 월 마감이므로 DD는 Trunc 하고 사용",
        )

    class Meta:
        description = "매입 마감"
        model = models.Purchase
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def clean_instance(cls, info, instance: PurchaseModel, purchase_close_date):
        if instance.status != PurchaseStatus.PENDING:
            raise ValidationError("검토 상태인 매입만 마감할 수 있습니다.")
        if instance.purchase_close_date != purchase_close_date:
            raise ValidationError("검토 요청 시 결정된 마감월이 일치하지 않습니다.")

    @classmethod
    def bulk_action(cls, queryset, **data):
        queryset.update(status=PurchaseStatus.CLOSED)

    @classmethod
    def post_save_action(cls, info, instances: List[PurchaseModel], purchase_close_date):
        send_email_purchase_close_to_riu(purchase_close_date, instances)


class PurchaseBulkPending(BaseBulkMutation):
    class Arguments:
        ids = graphene.List(
            graphene.ID, required=True, description="매입 데이터 검토 요청 purchase ids"
        )
        purchase_close_date = graphene.Date(
            required=True,
            description="매입마감 처리할 마감일 => (YYYY-MM-DD) 월 마감이므로 DD는 Trunc 하고 사용",
        )
        pending_reason = graphene.String(description="검토 요청 사유")

    class Meta:
        description = "매입 검토 요청"
        model = models.Purchase
        permissions = (PurchasePermissions.MANAGE_PURCHASE,)
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def clean_instance(cls, info, instance: PurchaseModel, **kwargs):
        if instance.status != PurchaseStatus.STANDBY and instance.status != PurchaseStatus.REVISION:
            raise ValidationError("대기 또는 수정 상태인 매입만 검토 요청할 수 있습니다.")

    @classmethod
    def bulk_action(cls, queryset, purchase_close_date, **kwargs):
        update_data = {
            "purchase_close_date": purchase_close_date,
            "status": PurchaseStatus.PENDING,
        }

        # pending_reason이 제공된 경우에만 업데이트
        pending_reason = kwargs.get("pending_reason")
        if pending_reason is not None:
            update_data["pending_reason"] = pending_reason

        queryset.update(**update_data)

    @classmethod
    def post_save_action(cls, info, instances: List[PurchaseModel], purchase_close_date, **kwargs):
        send_notice_purchase_pending_to_vendor(purchase_close_date, instances)


