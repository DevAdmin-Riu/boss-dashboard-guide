    for fulfillment_line in fulfillment_lines:
        order_line: OrderLine = fulfillment_line.order_line
        if order_line.track_inventory and order_line.decrease_stock_flag == True:
            stock: Stock = fulfillment_line.stock
            quantity = fulfillment_line.quantity
            create_fulfillment_stock_detail_event(
                stock,
                user=requester,
                quantity=quantity,
                reason=stock_detail_event_reason,
                rack_location=None,
                rack_location_count=0,
            )


def _fulfillment_from_stock_detail(
    requester: "User", order: "Order", fulfillment_lines: List["FulfillmentLine"]
):
    stock_detail_event_reason = f"주문번호:{order.composed_id_with_prefix}"
    brand: Brand = order.brand
    if brand:
        stock_detail_event_reason = (
            f"주문번호:{order.composed_id_with_prefix} / {brand.name}({brand.code})"
        )
    bulk_update_lines = []
    order_lines = []
    errors = []
    sub_pv_quantity_dict = {}
    for fulfillment_line in fulfillment_lines:
        order_line: OrderLine = fulfillment_line.order_line
        order_lines.append(order_line)
        unit_cost_price_exclude_vat = Decimal(0)
        product_price_exclude_vat = Decimal(0)
        delivery_fee_exclude_vat = Decimal(0)
        vendor_id = fulfillment_line.vendor_id

        stock_detail_decrease_mode = (
            order_line.decrease_stock_flag == True and order_line.is_fulfilled_by_vendor == False
        )
        if order_line.track_inventory and stock_detail_decrease_mode == True:
            stock: Stock = fulfillment_line.stock
            variant = stock.product_variant
            sub_pv = variant.sub_pv
            quantity = fulfillment_line.quantity

            if sub_pv_quantity_dict.get(sub_pv) is None:
                sub_pv_quantity_dict[sub_pv] = quantity
            else:
                sub_pv_quantity_dict[sub_pv] += quantity

            # _create_fulfillment_lines 과정에서 decrease_stock 으로 deallocate 처리와 함께 stock.decrease_stock 은 처리되었으니, 여기서 중복 차감하면 안됨
            rack_location: Optional[RackLocation] = (
                RackLocation.objects.filter(can_picking=True, rack_stocks__product_variant=variant)
                .annotate(total_quantity=Coalesce(Sum("rack_stocks__remain_quantity"), 0))
                .order_by("-total_quantity")
                .first()
            )

            if rack_location is None:
                total_remain_qty = 0
            else:
                rack_stock_details_qs = (
                    RackStockDetail.objects.order_by_stock_detail_stocked_at()
                    .select_related("stock_detail", "location")
                    .filter(location=rack_location, product_variant=variant, remain_quantity__gt=0)
                )
                rack_stock_details: List[RackStockDetail] = list(rack_stock_details_qs)

                total_remain_qty = sum(
                    rack_stock_detail.remain_quantity for rack_stock_detail in rack_stock_details
                )
            if total_remain_qty < quantity:
                sku = stock.product_variant.sku
                email_context = {
                    "sku": sku,
                    "product_name": stock.product_variant.product.name,
                    "location": rack_location.name if rack_location else "-",
                    "safety_picking_stock": (
                        to_locale_number(rack_location.safety_picking_stock)
                        if rack_location
                        else "-"
                    ),
                    "remain_quantity": to_locale_number(total_remain_qty),
                    "fulfillment_quantity": to_locale_number(quantity),
                    "fulfillment_composed_id_with_prefix": fulfillment_line.fulfillment.composed_id_with_prefix,
                }
                send_templated_mail_out_of_picking_stock(email_context)
                errors.append(sku)
            else:
                remain_fulfillment = quantity
                sum_of_cost_price_include_vat = 0
                for rack_stock_detail in rack_stock_details:
                    stock_detail = rack_stock_detail.stock_detail
                    if remain_fulfillment >= rack_stock_detail.remain_quantity:
                        fulfillment_quantity = rack_stock_detail.remain_quantity
                    else:
                        fulfillment_quantity = remain_fulfillment

                    sum_of_cost_price_include_vat += (
                        calc_total_include_vat_by_unit_exclude_vat_and_qty(
                            stock_detail.cost_price_exclude_vat,
                            fulfillment_quantity,
                            order_line.is_tax_free,
                        )
                    )

                    events.add_stock_detail_line(
                        fulfillment_line=fulfillment_line,
                        stock_detail=stock_detail,
                        rack_stock_detail=rack_stock_detail,
                        quantity=fulfillment_quantity,
                    )
                    vendor_id = stock_detail.vendor_id

                    stock_detail.decrease_remain_stock(fulfillment_quantity)
                    rack_stock_detail.decrease_remain_stock(fulfillment_quantity)

                    remain_fulfillment = remain_fulfillment - fulfillment_quantity
                    if remain_fulfillment <= 0:
                        break

                unit_cost_price_include_vat = Decimal(sum_of_cost_price_include_vat / quantity)
                unit_cost_price_exclude_vat = quantize_krw(
                    calc_to_exclude_vat(unit_cost_price_include_vat, order_line.is_tax_free)
                )

                create_fulfillment_stock_detail_event(
                    stock,
                    user=requester,
                    quantity=quantity,
                    reason=stock_detail_event_reason,
                    rack_location=rack_location,
                    rack_location_count=1,
                )
        elif order_line.track_inventory and stock_detail_decrease_mode == False:
            variant: "ProductVariant" = order_line.variant
            default_variant_vendor: ProductVariantVendor = variant.get_default_variant_vendor()
            if default_variant_vendor:
                product_price_exclude_vat = default_variant_vendor.product_price_exclude_vat
                delivery_fee_exclude_vat = default_variant_vendor.delivery_fee_exclude_vat
                unit_cost_price_exclude_vat = product_price_exclude_vat + delivery_fee_exclude_vat
        else:
            # 위탁 상품인 경우 _create_fulfillment_lines 에서 확정 상태 발주서가 없는 경우 예외 처리했으므로 여기서는 항상 발주서에 발주제품 정보가 있는 것으로 판단
            purchase_order_line: PurchaseOrderLine = order_line.purchase_order_line
            unit_cost_price_exclude_vat = purchase_order_line.cost_price_exclude_vat
            product_price_exclude_vat = purchase_order_line.product_price_exclude_vat
            delivery_fee_exclude_vat = purchase_order_line.delivery_fee_exclude_vat

        fulfillment_line.vendor_id = vendor_id
        fulfillment_line.unit_cost_price_exclude_vat = unit_cost_price_exclude_vat
        fulfillment_line.product_price_exclude_vat = product_price_exclude_vat
        fulfillment_line.delivery_fee_exclude_vat = delivery_fee_exclude_vat
        bulk_update_lines.append(fulfillment_line)

    if errors:
        error_msg = "피킹 로케이션 재고 부족으로 출고 불가 제품 리스트: {}".format(
            ", ".join(errors)
        )
        raise ValidationError(error_msg)

    if bulk_update_lines and len(bulk_update_lines) > 0:
        FulfillmentLine.objects.bulk_update(
            bulk_update_lines,
            [
                "unit_cost_price_exclude_vat",
                "vendor",
                "external_sku",
                "external_product_name",
                "product_price_exclude_vat",
                "delivery_fee_exclude_vat",
            ],
        )

        order_lines = list(set(order_lines))
        update_stats_sales_info_on_order_fulfilled(order_lines)

        for sub_pv, quantity in sub_pv_quantity_dict.items():
            decrease_stock_of_sub_pv(requester, sub_pv, quantity, stock_detail_event_reason)


@transaction.atomic()
def create_fulfillments(
    requester: "User",
    order: "Order",
    lines_for_warehouses_dict: Dict,
    delivery_method: OrderDeliveryMethodsEnum,
    is_picking_order: bool = False,
    batch_picking: "BatchPicking" = None,
) -> List[Fulfillment]:
    from ..purchaseorder.actions import set_consignment_po_line_status_on_order_fulfilled

    fulfillments: List[Fulfillment] = []
    fulfillment_lines: List[FulfillmentLine] = []
    quantities: List[int] = []
    b2b_delivery_fee_exclude_vat_list: List[int] = []
    is_b2b = order.is_b2b_order
    for warehouse_pk in lines_for_warehouses_dict:
        fulfillment = Fulfillment.objects.create(
            order=order,
            delivery_method=delivery_method,
            is_picking_order=is_picking_order,
            batch_picking=batch_picking,
            is_b2b=is_b2b,
        )
        fulfillments.append(fulfillment)
        lines_for_warehouse = lines_for_warehouses_dict[warehouse_pk]
        f_lines, qtys, b2b_dfev_list = _create_fulfillment_lines(
            order,
            fulfillment,
            warehouse_pk,
            lines_for_warehouse,
        )
        fulfillment_lines.extend(f_lines)
        quantities.extend(qtys)
        b2b_delivery_fee_exclude_vat_list.extend(b2b_dfev_list)

    # _create_fulfillment_lines 에서 update를 통해 order_line의 quantity_fulfilled를 증가 되었으나 order_line의 quantity_fulfilled를 사용하는 로직이 있으므로 최신 정보를 가져와서 사용해야 함
    # order와 fulfillment.order는 동일.
    order = Order.objects.prefetch_related("lines").get(pk=order.pk)
    FulfillmentLine.objects.bulk_create(fulfillment_lines)
    order_fulfilled(
        order=order,
        fulfillments=fulfillments,
        user=requester,
        fulfillment_lines=fulfillment_lines,
    )
    if fulfillment_lines:
        # 출고 취소가 fulfillment_line 단위로 이루어 져서 출고 취소용 데이터 관리를 위해서 fulfillmentLine 을 생성한 후에 호출 함
        _fulfillment_from_stock_detail(requester, order, fulfillment_lines)
        # 위탁 발주서 출고인 경우 위탁 발주서 상태를 FULFILLED 로 변경하고 매입데이터 생성
        # 위탁 발주서 전체 품목에 대해 매입데이터는 생성되어, 이미 FULFILLED 로 변경된 발주서인 경우 아래 로직은 실행되지 않음
        set_consignment_po_line_status_on_order_fulfilled(
            requester, order, fulfillment_lines, quantities, b2b_delivery_fee_exclude_vat_list
        )

    return fulfillments


@transaction.atomic()
def create_fulfillments_by_vendor(
    requester: "User",
    order: "Order",
    lines_for_warehouses_dict: Dict,
):
    fulfillments: List[Fulfillment] = []
    fulfillment_lines: List[FulfillmentLine] = []
    purchases: List[Purchase] = []
    for warehouse_pk in lines_for_warehouses_dict:
        lines_for_warehouse = lines_for_warehouses_dict[warehouse_pk]
        if not lines_for_warehouse:
            continue
        # 직거래 상품 출고인 경우 order_line 은 하나의 출고로 진행
        first_fulfillment_line_input = lines_for_warehouse[0]
        order_line: OrderLine = first_fulfillment_line_input["order_line"]
        vendor = order_line.vendor
        fulfillment = Fulfillment.objects.create(
            order=order, vendor=vendor, is_fulfilled_by_vendor=True
        )
        fulfillments.append(fulfillment)
        fulfillment_line, purchase = _create_fulfillment_lines_by_vendor(
            order,
            requester,
            fulfillment,
            lines_for_warehouse,
        )

        fulfillment_lines.extend(fulfillment_line)
        purchases.extend(purchase)

    # _create_fulfillment_lines 에서 update를 통해 order_line의 quantity_fulfilled를 증가 되었으나 order_line의 quantity_fulfilled를 사용하는 로직이 있으므로 최신 정보를 가져와서 사용해야 함
    # order와 fulfillment.order는 동일.
    order = Order.objects.prefetch_related("lines").get(pk=order.pk)
    FulfillmentLine.objects.bulk_create(fulfillment_lines)
    order_fulfilled(
        order=order,
        fulfillments=fulfillments,
        user=requester,
        fulfillment_lines=fulfillment_lines,
    )
    Purchase.objects.bulk_create(purchases)

    if fulfillment_lines:
        order_lines = []
        for fulfillment_line in fulfillment_lines:
            order_line = fulfillment_line.order_line
            order_lines.append(order_line)

        order_lines = list(set(order_lines))
        update_stats_sales_info_on_order_fulfilled(order_lines)
        add_fbv_purchase_cost_event_on_order_fulfilled(requester, order, fulfillment_lines)
        _add_stock_detail_event_on_fbv_fulfillment(requester, order, fulfillment_lines)

    return fulfillments


def update_order_total_amount_on_change_qty(order_lines: List[OrderLine]):
    order_ids = set(order_line.order_id for order_line in order_lines)

    def make_amount_subquery(price_field):
        qs = OrderLine.objects.filter(order=OuterRef("id"))
        qs = annotate_order_line_ordered_or_fulfill_qty(qs)
        return (
            qs.values("order")
            .annotate(
                total=Sum(
                    ExpressionWrapper(
                        F(price_field) * F("ordered_or_fulfill_qty"), output_field=DecimalField()
                    )
                    + F("etc_delivery_fee")
                )
            )
            .values("total")
            .order_by("order")
        )

    Order.objects.filter(id__in=order_ids).update(
        total_gross_amount=Subquery(make_amount_subquery("unit_price_gross_amount"))
        + F("subtotal_delivery_additional_fee")
    )


def update_payment_captured_amount_of_deferred_pay(order_lines: List[OrderLine]):
    order_ids = set(order_line.order_id for order_line in order_lines)

    total_gross_amount_subquery = Order.objects.filter(id=OuterRef("order_id")).values(
        "total_gross_amount"
    )[:1]

    # Payment.tax, taxfree 값도 변경되는 것이 맞겠으나, 현재는 이 값은 이니시스 결제시 결제 요청 인자로만 사용되고 있어서 무시함
    Payment.objects.filter(order_id__in=order_ids).update(
        captured_amount=Subquery(total_gross_amount_subquery),
        amount=Subquery(total_gross_amount_subquery),
        total=Subquery(total_gross_amount_subquery),
    )


def update_payment_captured_point_on_adjust_price(
    order: "Order", delta_cashable_credits, delta_non_cashable_credits
):
    if delta_cashable_credits == 0 and delta_non_cashable_credits == 0:
        return

    total_gross_amount_subquery = Order.objects.filter(id=OuterRef("order_id")).values(
        "total_gross_amount"
    )[:1]

    Payment.objects.filter(order_id=order.id).update(
        captured_cashable_credits=F("captured_cashable_credits") + delta_cashable_credits,
        cashable_credits=F("cashable_credits") + delta_cashable_credits,
        captured_non_cashable_credits=F("captured_non_cashable_credits")
        + delta_non_cashable_credits,
        non_cashable_credits=F("non_cashable_credits") + delta_non_cashable_credits,
        total=Subquery(total_gross_amount_subquery),
    )


def update_sales_on_adjust_price(order: Order, order_lines: List[OrderLine]):
    user: User = order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
    user_owned_non_cashable_credits = user.non_cashable_credits
    update_list = []
    sum_of_cashable_credits = 0
    sum_of_non_cashable_credits = 0
    for order_line in order_lines:
        po_line: PurchaseOrderLine = order_line.purchase_order_line
        new_qty = po_line.purchase_quantity
        old_qty = order_line.quantity
        if old_qty != new_qty:
            # 보스 장터에는 납품 시 납품금액 확정 제품 운영하지 않음
            # 환불이 아닌 매출 데이터를 찾아서 업데이트
            sales = Sales.objects.filter(
                order_line=order_line, refund_order_line__isnull=True, is_order_from_boss_mrkt=False
            ).first()
            if not sales:
                raise ValidationError(
                    "출고처리된 주문에 대한 sales 데이터가 없어서 출고 처리 오류 발생"
                )
            unit_price = sales.unit_price
            new_price = new_qty * unit_price
            old_price = sales.quantity * unit_price
            sales.quantity = new_qty
            diff_price = new_price - old_price
            # 충전금을 더 받아야 하는 경우, 주문한 유저의 출금 불가 충전금 > 출금 가능 충전금 순으로 사용
            if diff_price > 0:
                delta_non_cashable_credits = min(diff_price, user_owned_non_cashable_credits)
                user_owned_non_cashable_credits -= delta_non_cashable_credits
                delta_cashable_credits = diff_price - delta_non_cashable_credits
            # 충전금을 차감해야 하는 경우 사용된 출금 가능 충전금 > 출금 불가 충전금 순으로 돌려줌
            elif diff_price < 0:
                plus_diff_price = diff_price * (-1)
                delta_cashable_credits = min(plus_diff_price, sales.cashable_credits)
                delta_non_cashable_credits = plus_diff_price - delta_cashable_credits
                delta_cashable_credits = delta_cashable_credits * (-1)
                delta_non_cashable_credits = delta_non_cashable_credits * (-1)
            else:
                delta_cashable_credits = 0
                delta_non_cashable_credits = 0
            sum_of_cashable_credits = sum_of_cashable_credits + delta_cashable_credits
            sum_of_non_cashable_credits = sum_of_non_cashable_credits + delta_non_cashable_credits
            # 차액은 모두 충전금으로 처리 (기존 충전금 사용금액이 있을 수 있으므로 합산)
            sales.cashable_credits += delta_cashable_credits
            sales.non_cashable_credits += delta_non_cashable_credits
            if sales.calc_mileage:
                brand_total_cost_price_amount = new_qty * sales.brand_unit_cost_price
                # 2.5kg 당 1박스로 설정되어서 2.5 를 주문 했는데, 2.51이 납품되었다고 해서 2박스로 가지는 않으므로 원 주문 수량으로 배송 박스 수 계산
                box_count = get_delivery_box_count_consider_adjust_price_pv(
                    order_line.variant, old_qty
                )
                brand_total_delivery_fee_amount = box_count * sales.brand_unit_delivery_fee
                sales.mileage_exclude_vat = calc_order_line_mileage_exclude_vat(
                    total_price=new_price,
                    captured_rcoins=sales.rcoins,
                    brand_total_cost_price=brand_total_cost_price_amount,
                    brand_total_delivery_fee=brand_total_delivery_fee_amount,
                    brand_paying_charge_exclude_vat=sales.brand_paying_charge_exclude_vat,
                    mileage_rate=sales.mileage_rate,
                    is_tax_free=sales.is_tax_free,
                )
            update_list.append(sales)
    if update_list:
        Sales.objects.bulk_update(
            update_list,
            ["quantity", "cashable_credits", "non_cashable_credits", "mileage_exclude_vat"],
        )
    return sum_of_cashable_credits, sum_of_non_cashable_credits


def update_user_credits_on_adjust_price(
    requester, order: "Order", delta_cashable_credits, delta_non_cashable_credits
):
    # 가맹본부 대행주문이면 대행 주문한 본부 계정에서 충전금 처리
    user: User = order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
    event_desc = f"납품금액 확정 주문번호:{order.composed_id_with_prefix}"
    qty = delta_cashable_credits + delta_non_cashable_credits
    if qty != 0:
        qty_before = user.credits_incl_non_cashable
        qty_after = qty_before + qty * (-1)
        create_credits_event(
            total_before=qty_before,
            total_after=qty_after,
            qty_before=qty_before,
            qty_after=qty_after,
            qty=abs(qty),
            type=(
                CreditsEventType.ADJUST_PRICE_DEDUCTION
                if qty > 0
                else CreditsEventType.ADJUST_PRICE_RECHARGE
            ),
            user=user,
            staff=None,
            description=event_desc,
            view_mode=CreditsEventViewMode.ONLY_MALL,
            # ONLY_MALL view_mode 에서 is_cashable 은 통합금액 이벤트이므로 무의미함
            is_cashable=True,
        )

    if delta_cashable_credits > 0:
        user.decrease_cashable_credits(
            delta_cashable_credits,
            CreditsEventType.ADJUST_PRICE_DEDUCTION,
            event_desc,
            staff=requester,
            event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
            allow_minus=True,
        )
    elif delta_cashable_credits < 0:
        user.increase_cashable_credits(
            delta_cashable_credits * (-1),
            CreditsEventType.ADJUST_PRICE_RECHARGE,
            event_desc,
            event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
            staff=requester,
        )
    if delta_non_cashable_credits > 0:
        user.decrease_cashable_credits(
            delta_non_cashable_credits,
            CreditsEventType.ADJUST_PRICE_DEDUCTION,
            event_desc,
            event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
            staff=requester,
        )
    elif delta_non_cashable_credits < 0:
        user.increase_non_cashable_credits(
            delta_non_cashable_credits * (-1),
            CreditsEventType.ADJUST_PRICE_RECHARGE,
            event_desc,
            staff=requester,
            event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
        )


def update_on_change_qty_of_deferred_pay(order_lines: List[OrderLine]):
    update_order_total_amount_on_change_qty(order_lines)
    update_payment_captured_amount_of_deferred_pay(order_lines)


def update_on_change_qty_on_adjust_price(requester, order: "Order", order_lines: List[OrderLine]):
    update_order_total_amount_on_change_qty(order_lines)
    delta_cashable_credits, delta_non_cashable_credits = update_sales_on_adjust_price(
        order, order_lines
    )
    # 충전금 증감, 세금계산서 추가 발행은 보스몰 주문, 가맹본부 대행주문에서만 처리
    if order.type == OrderType.BY_USER or order.type == OrderType.BY_HQ_STAFF_FOR_BRAND:
        if delta_cashable_credits != 0 or delta_non_cashable_credits != 0:
            update_user_credits_on_adjust_price(
                requester, order, delta_cashable_credits, delta_non_cashable_credits
            )
            update_payment_captured_point_on_adjust_price(
                order, delta_cashable_credits, delta_non_cashable_credits
            )
        # 납품 시 금액확정 제품 출고 시 세금계산서 발행액은 차이가 있을 수 있으므로 세금계산서 추가 발행은 있을 수 있음
        create_tax_invoie_request_on_adjust_price(requester, order)
