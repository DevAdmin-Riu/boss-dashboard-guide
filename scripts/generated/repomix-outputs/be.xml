from typing import Any

from django.db import models, transaction
from django.db.models import JSONField  # type: ignore
from django.db.models import F, Max, Q

from . import JobStatus
from .utils.json_serializer import CustomJsonEncoder
from .utils.kst_time import kst_date


# 동시성 이슈에서 자유롭지 않음.
class SortableModel(models.Model):
    sort_order = models.IntegerField(editable=False, db_index=True, null=True)

    class Meta:
        abstract = True

    def get_ordering_queryset(self):
        raise NotImplementedError("알수 없는 ordering queryset")

    @staticmethod
    def get_max_sort_order(qs):
        existing_max = qs.aggregate(Max("sort_order"))
        return existing_max.get("sort_order__max")

    def save(self, *args, **kwargs):
        if self.pk is None or self.sort_order is None:
            qs = self.get_ordering_queryset()
            existing_max = SortableModel.get_max_sort_order(qs)
            self.sort_order = 1 if existing_max is None else existing_max + 1
        super().save(*args, **kwargs)

    def delete(self, *args, **kwargs):
        if self.sort_order is not None:
            qs = self.get_ordering_queryset()
            qs.filter(sort_order__gt=self.sort_order).update(sort_order=F("sort_order") - 1)
        super().delete(*args, **kwargs)


# 동시성 이슈에서 자유롭지 않음.
class SubIdModel(models.Model):
