from typing import TYPE_CHECKING

import graphene
from django.core.exceptions import ValidationError

from ....account.emails import send_templated_mail_complain
from ...core.mutations import BaseMutation

if TYPE_CHECKING:
    from ....account.models import Brand, User


class SendComplainInput(graphene.InputObjectType):
    writer_name = graphene.String(description="작성자 이름")
    writer_phone = graphene.String(description="작성자 전화번호")
    writer_email = graphene.String(description="작성자 이메일")
    content = graphene.String(required=True, description="메일 내용")
    agree = graphene.Boolean(required=True, description="개인정보 처리 방침 동의 여부")


class SendComplain(BaseMutation):
    class Arguments:
        input = SendComplainInput(
            description="고객의 소리 대표이사에게 메일 발송 입력", required=True
        )

    class Meta:
        description = "고객의 소리 대표이사에게 메일 발송"

    @classmethod
    def perform_mutation(cls, root, info, **data):
        requester: User = info.context.user
        if not requester or requester.is_hq_staff == False:
            raise ValidationError("가맹본부만 이용할 수 있는 기능입니다.")

        brand: Brand = requester.brand
        if not brand:
            raise ValidationError("가맹본부만 이용할 수 있는 기능입니다.")

        input_data = data.get("input")
        agree = input_data.get("agree")
        if not agree:
            raise ValidationError("개인정보 처리 방침에 동의해주세요.")

        content = input_data.get("content")
        if not content:
            raise ValidationError("메일 내용을 입력해주세요.")

        writer_name = input_data.get("writer_name")
        writer_phone = input_data.get("writer_phone")
        writer_email = input_data.get("writer_email")
        if writer_phone:
            if writer_email:
                writer_contact_info = f"{writer_phone} ({writer_email})"
            else:
                writer_contact_info = writer_phone
        elif writer_email:
            writer_contact_info = writer_email
        else:
            writer_contact_info = "입력 없음"

        context = {
            "brand_code": brand.code,
            "brand_name": brand.name,
            "writer_name": writer_name if writer_name else "입력 없음",
            "writer_contact_info": writer_contact_info,
            "content": content,
        }

        send_templated_mail_complain.delay(context)

        return cls()
