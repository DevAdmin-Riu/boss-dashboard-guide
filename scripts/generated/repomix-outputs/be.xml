class AccountUpdate(BaseCustomerCreate):
    class Arguments:
        input = AccountInput(
            description="Fields required to update the account of the logged-in user.",
            required=True,
        )

    class Meta:
        description = "Updates the account of the logged-in user."
        exclude = ["password"]
        model = models.User
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        return context.user.is_authenticated

    @classmethod
    def clean_input(cls, info, instance, input_data):
        cleaned_input = super().clean_input(info, instance, input_data)
        brand_id = input_data.get("brand_id", "")
        if brand_id:
            brand: BrandModel = cls.get_node_or_error(info, brand_id, only_type=Brand)
            cleaned_input["brand"] = brand

            if brand.is_reverse_fee_contract_type:
                # Front에서 "외상"기준으로 받으므로 - 붙여서 저장한다.
                reverse_fee_deposit_alarm_threshold = -input_data.get(
                    "minus_reverse_fee_deposit_alarm_threshold"
                )
                # reverse_fee_deposit_alarm_threshold를 data에 다시 업데이트 한다.
                cleaned_input["reverse_fee_deposit_alarm_threshold"] = (
                    reverse_fee_deposit_alarm_threshold
                )

                if (
                    reverse_fee_deposit_alarm_threshold is None
                    or reverse_fee_deposit_alarm_threshold
                    < brand.reverse_fee_deposit_min_limitation
                ):
                    raise ValidationError(
                        "외상 경고 금액 설정은 외상 한도 금액 이하만 가능합니다.",
                        code=AccountErrorCode.INVALID,
                    )

                # min_qty = data.get("min_qty")
                # if min_qty is None or min_qty < 0:
                #     raise ValidationError(
                #         "잔여 가상계좌 알림 개수는 0개 이상의 숫자만 입력 가능합니다.",
                #         code=AccountErrorCode.INVALID,
                #     )

                org_info = OrgCode.objects.filter(brand=brand).first()
                cleaned_input["org_info"] = org_info
                # if org_info is None:
                #     raise ValidationError(
                #         "매출 인식 브랜드의 경우, 가상계좌 발급 기관 정보 연동은 필수입니다. 고객센터에 문의해 주세요.",
                #         code=AccountErrorCode.INVALID,
                #     )

        return cleaned_input

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        user = info.context.user
        data["id"] = graphene.Node.to_global_id("User", user.id)

        input_data = data.get("input")
        instance = cls.get_instance(info, **data)
        cleaned_input = cls.clean_input(info=info, instance=instance, input_data=input_data)

        # 위치가 잘못됨. 브랜드 수정으로 빠져야함(프론트와 같이.)
        brand: BrandModel = cleaned_input.get("brand", None)
        is_reverse_fee_contract_type = brand.is_reverse_fee_contract_type if brand else False
        if is_reverse_fee_contract_type:
            reverse_fee_deposit_alarm_threshold = cleaned_input.get(
                "reverse_fee_deposit_alarm_threshold"
            )
            if reverse_fee_deposit_alarm_threshold is not None:
                brand.reverse_fee_deposit_alarm_threshold = reverse_fee_deposit_alarm_threshold
                brand.save(update_fields=["reverse_fee_deposit_alarm_threshold"])

            min_qty = cleaned_input.get("min_qty")
            org_info = cleaned_input.get("org_info")
            if min_qty is not None and org_info is not None:
                org_info.min_qty = min_qty
                org_info.save(update_fields=["min_qty"])

        return super().perform_mutation(root, info, **data)


class AccountRequestDeletion(BaseMutation):
