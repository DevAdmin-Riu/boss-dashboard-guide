        },
    ]

    CONFIG_STRUCTURE = {
        "user_name": {
            "type": ConfigurationTypeField.STRING,
            "help_text": "모두싸인 관리자 계정명 (수정불가)",
            "label": "USER NAME",
        },
        "api_key": {
