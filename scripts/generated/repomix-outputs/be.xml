from collections import Counter

import graphene
from django.core.exceptions import ValidationError
from django.db.models import Prefetch

from saleor.brand_store_ops_check import BsOpsCheckTemplateCategoryItemFormType
from saleor.brand_store_ops_check import models as BsOpsCheckModels


class TopSubmittedBrandStore(graphene.ObjectType):
    brand_store = graphene.Field(
        "saleor.graphql.brand_store.types.BrandStore",
        description="브랜드 매장",
    )
    submitted_count = graphene.Int(
        description="제출된 보고서 수",
    )


class BsOpsCheckTemplateReportsSummary(graphene.ObjectType):
    top_five_submitted_brand_stores = graphene.List(
        TopSubmittedBrandStore,
        description="횟수 기준 상위 5개 브랜드 매장 목록 및 제출 수",
    )
    total_reports_count = graphene.Int(
        description="전체 점검 보고서 수",
    )
    submitted_brand_stores_distinct_count = graphene.Int(
        description="점검 보고서가 제출된 브랜드 매장 수 (중복 제외)",
    )
    total_expected_fine = graphene.Int(description="전체 예상 과태료 합계")
    total_expected_suspension = graphene.Int(description="전체 예상 영업정지 합계")


class BsOpsCheckReportSummaryCount(graphene.ObjectType):
    total = graphene.Int(
        description="전체 카운트",
    )
    yes = graphene.Int(
        description="예",
    )
    no = graphene.Int(
        description="아니오",
    )
    zero = graphene.Int(
        description="0",
    )
    one = graphene.Int(
        description="1",
    )
    two = graphene.Int(
        description="2",
    )
    three = graphene.Int(
        description="3",
    )
    four = graphene.Int(
        description="4",
    )
    five = graphene.Int(
        description="5",
    )
    etc = graphene.Int(
        description="기타",
    )


class BsOpsCheckReportSummary(graphene.ObjectType):
    report = graphene.Field(
        "saleor.graphql.brand_store_ops_check.types.BsOpsCheckReport",
        description="점검 보고서",
    )
    summary_count = graphene.Field(
        BsOpsCheckReportSummaryCount,
        description="점검 보고서 요약 카운트",
    )
    total_expected_fine = graphene.Int(
        description="전체 예상 과태료 합계",
    )
    total_expected_suspension = graphene.Int(
        description="전체 예상 영업정지 합계",
    )


def resolve_bs_ops_check_template_reports_summary(
    info,
    date_range,
    template_id=None,
):
    requestor = info.context.user
    is_staff = requestor.is_staff
    brand_id = requestor.brand_id

    if is_staff:
        qs = BsOpsCheckModels.BsOpsCheckReport.objects.all()
    else:
        qs = BsOpsCheckModels.BsOpsCheckReport.objects.filter(brand_store__brand_id=brand_id)

    reports = (
        qs.filter(
            created_at__date__gte=date_range.gte,
            created_at__date__lte=date_range.lte,
        )
        .select_related("brand_store")
        .prefetch_related(
            Prefetch(
                "items",
                queryset=BsOpsCheckModels.BsOpsCheckReportItem.objects.select_related(
                    "category_item"
                ),
                to_attr="prefetched_items",
            )
        )
    )

    if template_id:
        _, db_id = graphene.Node.from_global_id(template_id)
        reports = reports.filter(template_id=db_id)

    reports = list(reports)

    total_reports_count = len(reports)

    submitted_store_ids = set(
        r.brand_store_id for r in reports if r.brand_store_id and r.is_submitted
    )
    submitted_brand_stores_distinct_count = len(submitted_store_ids)

    submitted_counter = Counter(
        r.brand_store_id for r in reports if r.brand_store_id and r.is_submitted
    )
    top_brand_store_stats = submitted_counter.most_common(5)
    top_brand_store_ids = [store_id for store_id, _ in top_brand_store_stats]

    brand_stores = {
        bs.id: bs for bs in BsOpsCheckModels.BrandStore.objects.filter(id__in=top_brand_store_ids)
    }

    top_five_submitted_brand_stores = [
        TopSubmittedBrandStore(brand_store=brand_stores.get(store_id), submitted_count=count)
        for store_id, count in top_brand_store_stats
        if store_id in brand_stores
    ]
    total_expected_fine = 0
    total_expected_suspension = 0
    for report in reports:
        for item in getattr(report, "prefetched_items", []):
            answer = item.answer_json or {}
            category_item = item.category_item

            if (
                answer.get("type") == BsOpsCheckTemplateCategoryItemFormType.YES_NO
                and answer.get("value") == "false"
                and category_item
            ):
                total_expected_fine += category_item.expected_fine or 0
                total_expected_suspension += category_item.expected_suspension or 0

    return BsOpsCheckTemplateReportsSummary(
        total_reports_count=total_reports_count,
        submitted_brand_stores_distinct_count=submitted_brand_stores_distinct_count,
        top_five_submitted_brand_stores=top_five_submitted_brand_stores,
        total_expected_fine=total_expected_fine,
        total_expected_suspension=total_expected_suspension,
    )


def resolve_bs_ops_check_report_summary(_info, report_id):
    _type, report_id = graphene.Node.from_global_id(report_id)

    report = (
        BsOpsCheckModels.BsOpsCheckReport.objects.filter(id=report_id)
        .prefetch_related(
            Prefetch(
                "items",
                queryset=BsOpsCheckModels.BsOpsCheckReportItem.objects.select_related(
                    "category_item"
                ),
                to_attr="prefetched_items",
            )
        )
        .first()
    )
    if not report:
        return None

    items = getattr(report, "prefetched_items", [])

    summary_count = Counter(
        {
            "total": len(items),
            "yes": 0,
            "no": 0,
            "zero": 0,
            "one": 0,
            "two": 0,
            "three": 0,
            "four": 0,
            "five": 0,
            "etc": 0,
        }
    )

    total_expected_fine = 0
    total_expected_suspension = 0

    for item in items:
        answer = item.answer_json or {}
        a_type = answer.get("type")
        value = str(answer.get("value", "")).strip()

        if a_type == BsOpsCheckTemplateCategoryItemFormType.YES_NO:
            if value == "true":
                summary_count["yes"] += 1
            else:
                summary_count["no"] += 1
                if item.category_item:
                    total_expected_fine += item.category_item.expected_fine or 0
                    total_expected_suspension += item.category_item.expected_suspension or 0

        elif a_type == BsOpsCheckTemplateCategoryItemFormType.SCORE:
            if value == "0":
                summary_count["zero"] += 1
            elif value == "1":
                summary_count["one"] += 1
            elif value == "2":
                summary_count["two"] += 1
            elif value == "3":
                summary_count["three"] += 1
            elif value == "4":
                summary_count["four"] += 1
            elif value == "5":
                summary_count["five"] += 1
            else:
                summary_count["etc"] += 1

        elif a_type == BsOpsCheckTemplateCategoryItemFormType.SELECT:
            summary_count["etc"] += 1

        else:
            summary_count["etc"] += 1

    # 4. 총합 검증
    counted_total = (
        summary_count["yes"]
        + summary_count["no"]
        + summary_count["zero"]
        + summary_count["one"]
        + summary_count["two"]
        + summary_count["three"]
        + summary_count["four"]
        + summary_count["five"]
        + summary_count["etc"]
    )

    if counted_total != summary_count["total"]:
        raise ValidationError(
            f"요약 수치 불일치: total={summary_count['total']} / counted={counted_total}"
        )

    # 5. 결과 리턴
    return BsOpsCheckReportSummary(
        report=report,
        summary_count=BsOpsCheckReportSummaryCount(**summary_count),
        total_expected_fine=total_expected_fine,
        total_expected_suspension=total_expected_suspension,
    )
