    brand_info = JSONField(blank=True, default=dict, encoder=DjangoJSONEncoder)
    md_info = JSONField(blank=True, default=dict, encoder=DjangoJSONEncoder)

    # 보스장터 주문여부.
    is_order_from_boss_mrkt = models.BooleanField(default=False)

    class Meta:
        ordering = ("-evented_at", "-pk")
        indexes = [
            models.Index(fields=["bp_sku"], name="idx_sales_bp_sku"),
            models.Index(fields=["variant"], name="idx_sales_variant"),
            models.Index(fields=["brand"], name="idx_sales_brand"),
            models.Index(fields=["user"], name="idx_sales_user"),
            models.Index(fields=["brand", "variant"], name="idx_sales_brand_variant"),
        ]

    @property
    def is_mixed_track_inventory(self):
        # order_line 의 fulfillment_lines의 track_inventory가 True, False가 섞여있는 경우 True 반환
        if self.order_line:
            return self.order_line.is_mixed_track_inventory


