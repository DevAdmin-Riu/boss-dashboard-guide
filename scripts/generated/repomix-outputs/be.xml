def make_product_search_filter_condition_by_phrase(phrase):
    """Return matching products for storefront views.

    * Fuzzy storefront search that is resistant to small typing errors made
    by user. Name and description is matched using search vector.
    * 제품명 정확하게 일치하는 제품도 포함되도록 필터 조건 추가함

    Args:
        phrase (str): searched phrase

    """
    ft_by_sku = Q(variants__sku__icontains=phrase)
    ft_in_search_vector = Q(search_vector=phrase)

    # 제품명 입력 시 띄워쓰기를 하지 않아 제품명의 search_vector 가 검색어로 활용 못하고 있음
    ft_by_name = Q(name__icontains=phrase)
    return ft_in_search_vector | ft_by_sku | ft_by_name

    # ft_by_exact_equal_name = Q(name=phrase)

    # return ft_in_search_vector | ft_by_sku | ft_by_exact_equal_name


def make_brand_product_search_filter_condition_by_phrase(phrase):
    """
    * 브랜드회원인 경우 brandproduct 에 있는 name, search_vector 이용해서 검색 처리

    Args:
        phrase (str): searched phrase

    """

    # 상품명 입력 시 띄워쓰기를 하지 않아 search vector 이용한 검색 기능을 활용 못하고 있음
    ft_by_name = Q(brandproduct_name__icontains=phrase)
    return ft_by_name

    # ft_in_search_vector = Q(brandproduct_search_vector=phrase)
    # ft_by_exact_equal_name = Q(brandproduct_name=phrase)

    # return ft_in_search_vector | ft_by_sku | ft_by_exact_equal_name


