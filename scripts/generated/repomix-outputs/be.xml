class AddressInput(graphene.InputObjectType):
    first_name = graphene.String(description="Given name.")
    last_name = graphene.String(description="Family name.")
    company_name = graphene.String(description="Company or organization.")
    street_address_1 = graphene.String(description="Address.")
    street_address_2 = graphene.String(description="Address.")
    city = graphene.String(description="City.")
    city_area = graphene.String(description="District.")
    postal_code = graphene.String(description="Postal code.")
    country = CountryCodeEnum(description="Country.")
    country_area = graphene.String(description="State or province.")
    phone = graphene.String(description="Phone number.")
    is_direct_shipping = graphene.Boolean(description="직배송 가능 여부")
    direct_shipping_code = graphene.String(description="직배송 배송지 코드")
    direct_shipping_days = graphene.Field(DaysOfWeekInput, description="직배송 가능 요일")
    direct_shipping_detail = graphene.Field(DirectShippingDetailInput, description="직배송 상세")

    @staticmethod
    def validate_direct_shipping_code(is_staff, cleaned_input, instance=None):
        if is_staff == False:
            return cleaned_input

        is_direct_shipping = cleaned_input.get("is_direct_shipping", False)
        direct_shipping_code = cleaned_input.get("direct_shipping_code", None)
        if direct_shipping_code:
            direct_shipping_code = direct_shipping_code.strip()
            cleaned_input["direct_shipping_code"] = direct_shipping_code

        if is_direct_shipping:
            if direct_shipping_code is None or not direct_shipping_code:
                raise ValidationError("직배송 가능 배송지는 배송지 코드가 입력되어야 합니다.")

        if direct_shipping_code:
            # 주문 주소를 복사해서 새로운 instance 를 생성하는 이유로 db Unique 속성 이용 못하고, 주소 생성, 수정 시 중복코드 안 생성되도록 체크함
            if instance is None or instance.direct_shipping_code != direct_shipping_code:
                try:
                    _ = models.Address.objects.filter(user_addresses__isnull=False).get(
                        direct_shipping_code=direct_shipping_code
                    )
                except ObjectDoesNotExist:
                    pass
                else:
                    raise ValidationError(f"[{direct_shipping_code}]는 중복된 배송지 코드입니다.")

        return cleaned_input


