    @property
    def total_captured_rcoins(self):
        payment: Payment = self.get_last_payment()
        if payment and payment.charge_status in (
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        ):
            return payment.captured_rcoins
        return 0

    @property
    def total_balance(self):
        return self.total_captured - self.total.gross

    # 직거래인 것은 제외하려고 할때, vendor_id_list 를 [None] 으로 입력해서 호출
    def get_lines_tax_free(self, vendor_id_list: Optional[List[Optional[int]]] = None):
        return [
            line
            for line in self
            if line.is_tax_free and (vendor_id_list is None or line.vendor_id in vendor_id_list)
        ]

    # 직거래인 것은 제외하려고 할때, vendor_id_list 를 [None] 으로 입력해서 호출
    def get_lines_taxable(self, vendor_id_list: Optional[List[Optional[int]]] = None):
        return [
            line
            for line in self
            if not line.is_tax_free and (vendor_id_list is None or line.vendor_id in vendor_id_list)
        ]

    def get_lines_tax_free_only_is_adjust_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return [
            line
            for line in self
            if line.is_tax_free
            and line.variant.is_adjust_price
            and (vendor_id_list is None or line.vendor_id in vendor_id_list)
        ]

    def get_lines_taxable_only_is_adjust_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return [
            line
            for line in self
            if not line.is_tax_free
            and line.variant.is_adjust_price
            and (vendor_id_list is None or line.vendor_id in vendor_id_list)
        ]

    def taxable_total_consider_refunded(self, vendor_id_list: Optional[List[Optional[int]]] = None):
        return get_paid_lines_total_amount_consider_refunded(self.get_lines_taxable(vendor_id_list))

    def taxable_total_consider_refunded_incl_etc_delivery_fee(
        self, vendor_id_list: Optional[List[int]] = None
    ):
        return (
            get_paid_lines_total_amount_consider_refunded(self.get_lines_taxable(vendor_id_list))
            + self.total_etc_delivery_fee
        )

    @property
    def total_etc_delivery_fee(self):
        return sum([line.etc_delivery_fee for line in self])

    # 환불 수량은 고려하지 않고, 납품시 변경 수량 고려한 주문 수량에 대해서  매출인식 브랜드에 대해 선결제금 과세 세금계산서 발행용 금액
    def taxable_origin_total_brand_cost_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return get_origin_total_brand_cost_price_by_order_lines(
            self.get_lines_taxable(vendor_id_list)
        )

    # 환불 수량은 고려하지 않고, 납품시 변경 수량 고려한 주문 수량에 대해서 매출인식 브랜드에 대해 선결제금 면세 세금계산서 발행용 금액
    def tax_free_origin_total_brand_cost_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return get_origin_total_brand_cost_price_by_order_lines(
            self.get_lines_tax_free(vendor_id_list)
        )

    # (납품시 수량-주문수량) 차이에 대해 리우->가맹점 세금계산서 발행용
    def taxable_total_price_after_adjust_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return get_total_price_by_order_lines_after_adjust_price(
            self.get_lines_taxable_only_is_adjust_price(vendor_id_list)
        )

    # (납품시 수량-주문수량) 차이에 대해 리우->가맹점 세금계산서 발행용
    def tax_free_diff_total_price_on_adjust_price(
        self, vendor_id_list: Optional[List[Optional[int]]] = None
    ):
        return get_total_price_by_order_lines_after_adjust_price(
            self.get_lines_tax_free_only_is_adjust_price(vendor_id_list)
        )

    @property
    def brand_total_cost_price_amount_not_fbv(self):
        total = self.lines.filter(is_fulfilled_by_vendor=False).aggregate(
            total_cost=Sum(F("quantity") * F("brand_unit_cost_price_amount"))
        )["total_cost"]
        return total or Decimal("0")

    @property
    def final_brand_total_cost_price_amount_not_fbv(self):
        total = self.lines.filter(is_fulfilled_by_vendor=False).aggregate(
            total_cost=Sum(
                (F("quantity") - F("quantity_refunded")) * F("brand_unit_cost_price_amount")
            )
        )["total_cost"]
        return total or Decimal("0")

    # 결제 방식별 사요 여부
    def get_pay_info(self, payment):
        last_payment: Payment = payment or self.get_last_payment()
        is_card_pay = False
        is_vbank_pay = False
        is_deferred_pay = False
        is_credits_pay = False
        is_rcoins_pay = False

        if last_payment:
            is_toss_riu_pay = last_payment.is_toss_riu_pay
            is_card_pay = last_payment.is_card_pay()
            is_vbank_pay = last_payment.is_vbank_pay()
            is_deferred_pay = last_payment.is_deferred_pay()
            is_credits_pay = last_payment.credits_incl_non_cashable > 0
            is_rcoins_pay = last_payment.rcoins > 0

        from saleor.graphql.order.types import OrderPayInfo

        return OrderPayInfo(
            is_toss_riu_pay=is_toss_riu_pay,
            is_card_pay=is_card_pay,
            is_vbank_pay=is_vbank_pay,
            is_deferred_pay=is_deferred_pay,
            is_credits_pay=is_credits_pay,
            is_rcoins_pay=is_rcoins_pay,
        )


class OrderLineQueryset(models.QuerySet):
    def ready_to_fulfill(self):
        # 환불한 상품 수량 관리가 되고 있어서 환불 후 출고 대상 리스트를 뽑아 줘도 환불된 상품이 다시 출고되지 않게 되어
        # 결제 금액 비교 대신 payment 상태가 결제한 적이 있고 완전 환불이 아닌 조건으로 변경함
        statuses = {OrderStatus.UNFULFILLED, OrderStatus.PARTIALLY_FULFILLED}
        charge_statuses = {ChargeStatus.FULLY_CHARGED, ChargeStatus.PARTIALLY_REFUNDED}
        qs = self.filter(
            order__status__in=statuses,
            order__payments__is_active=True,
            order__payments__charge_status__in=charge_statuses,
        )
        qs = qs.exclude(order__status=OrderStatus.CANCELED)
        return qs

    def ready_to_fulfill_plus_being_approved(self):
        # ready_to_fulfill 에 being_approved 상태만 추가
        statuses = {OrderStatus.UNFULFILLED, OrderStatus.PARTIALLY_FULFILLED}
        charge_statuses = {
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
            ChargeStatus.BEING_APPROVED,
        }
        qs = self.filter(
            order__status__in=statuses,
            order__payments__is_active=True,
            order__payments__charge_status__in=charge_statuses,
        )
        qs = qs.exclude(order__status=OrderStatus.CANCELED)
        return qs


