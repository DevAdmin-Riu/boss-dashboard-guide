        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_created(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    def filter_only_recent_ones(qs, _, value):
        if value is True:
            latest_event_subquery = (
                qs.filter(
                    user=OuterRef("user"),
                )
                .order_by("-created", "-pk")
                .values("pk")[:1]
            )
            return qs.filter(pk__in=Subquery(latest_event_subquery))
        return qs

    def filter_biz_reg_no(qs, _, value):
        if value:
            normalized_value = remove_all_non_numeric(value)
            qs = qs.annotate(
                clean_biz_reg_no=RegexpReplace(
                    F("user__biz_reg_no"),
                    Value("[^0-9]"),  # 숫자가 아닌 모든 문자 제거
                    Value(""),
                )
            )
            return qs.filter(clean_biz_reg_no=normalized_value)
        return qs

    user_search = django_filters.CharFilter(method=filter_user_search)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    brand_store_search = django_filters.CharFilter(method=filter_brand_store_search)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created)
    only_recent_ones = django_filters.BooleanFilter(method=filter_only_recent_ones)
    biz_reg_no = django_filters.CharFilter(method=filter_biz_reg_no)

    class Meta:
        abstract = True


