                brand_products__brand_product_variants__regions__delivery_fee_amount__isnull=False,
            )
            sales_status_filter = Q(
                brand_products__brand_product_variants__regions__sales_status__in=[
                    SalesStatus.ON_SALE,
                    SalesStatus.WILL_BE_STOPPED,
                ]
            )
            return direct_shipping_filter & region_filter & price_filter & sales_status_filter

        def exclude_vendor_filter():
            days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
            all_days_false_q = Q()
            for day in days:
                all_days_false_q &= Q(**{f"possible_delivery_days__{day}": False})

            valid_vendor_ids = (
                FbvDeliveryCondition.objects.filter(
                    user=user,
