class ProductVariantRegionPriceBulkDetail(graphene.InputObjectType):
    product_sku = graphene.String(required=True, description="제품 코드")
    is_direct_shipping = graphene.Boolean(description="직배송 제품 여부")
    region_code = graphene.String(description="권역 코드")
    lead_time = graphene.Int(description="직배송 제품 리드 타임(생산 소요 시간)")
    disabled_days = GenericScalar(description="배송 불가 요일 json")
    price = PositiveDecimal(description="오픈몰 판매가")
    consignment_delivery_fee = PositiveDecimal(description="아우터박스 위탁 판매 택배비")
    inner_incidental_cost = PositiveDecimal(description="이너박스 판매 시 소분 비용")


class ProductVariantRegionPriceBulkInput(graphene.InputObjectType):
