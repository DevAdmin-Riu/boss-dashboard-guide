<file path="saleor/payment/gateways/handle_by_pg.py">
import logging
from typing import TYPE_CHECKING, Union

from django.core.exceptions import ValidationError

from ...account import PaymentGatewayType, PgType
from ...plugins.manager import get_plugins_manager
from .inicis.interface import InicisCardRefundData, InicisRefundResponse, InicisVbankRefundData
from .inicis.process_inicis_refund import process_inicis_refund
from .inicis.utils import (
    convert_to_inicis_bank_code,
    get_inicis_captured_date,
    get_inicis_refunded_at,
    get_inicis_vact_date,
    get_inicis_vact_info,
)
from .toss.define import TOSS_GATEWAY_PLUGIN_ID
from .toss.interface import TossCardRefundData, TossRefundResponse, TossVbankRefundData
from .toss.process_toss_refund import process_toss_refund
from .toss.utils import (
    convert_to_toss_bank_code,
    get_toss_captured_date,
    get_toss_refunded_at,
    get_toss_vact_date,
    get_toss_vact_info,
)

if TYPE_CHECKING:
    from ...account.models import Brand, User
    from ...graphql.payment.types import VactInfo
    from ...order.models import Order
    from ..models import Payment, Transaction


logger = logging.getLogger(__name__)


def get_last_captured_date(payment: "Payment", captured_transaction: "Transaction"):
    is_points_only_pay = payment.is_points_only_pay()
    is_deferred_pay = payment.is_deferred_pay()
    if is_points_only_pay:
        return payment.created
    elif is_deferred_pay:
        return captured_transaction.created
    elif payment.gateway == PaymentGatewayType.INICIS:
        return get_inicis_captured_date(payment, captured_transaction)
    elif payment.gateway == PaymentGatewayType.TOSS:
        return get_toss_captured_date(payment, captured_transaction)
    return None


def get_vact_info(
    payment: "Payment", gateway_response, include_vact_time: bool, plugin_manager: None
) -> "VactInfo":
    if payment.gateway == PaymentGatewayType.INICIS:
        return get_inicis_vact_info(gateway_response, include_vact_time=include_vact_time)
    elif payment.gateway == PaymentGatewayType.TOSS:
        plugin_manager = plugin_manager or get_plugins_manager()
        plugin_configs = plugin_manager.get_plugin_config_dot_map(TOSS_GATEWAY_PLUGIN_ID)
        return get_toss_vact_info(
            gateway_response, include_vact_time=include_vact_time, plugin_configs=plugin_configs
        )
    return None


def get_vact_date(payment: "Payment", gateway_response, include_vact_time: bool) -> str:
    if payment.gateway == PaymentGatewayType.INICIS:
        return get_inicis_vact_date(gateway_response, include_vact_time=include_vact_time)
    elif payment.gateway == PaymentGatewayType.TOSS:
        return get_toss_vact_date(gateway_response, include_vact_time=include_vact_time)
    return None


def get_pg_name(payment: "Payment") -> str:
    if payment.gateway == PaymentGatewayType.INICIS:
        return "이니시스"
    elif payment.gateway == PaymentGatewayType.TOSS:
        return "토스"
    return None


def process_pg_refund(
    payment: "Payment",
    order: "Order",
    refund_transaction: "Transaction",
    pg_refund_data: Union[
        InicisCardRefundData, InicisVbankRefundData, TossCardRefundData, TossVbankRefundData
    ],
    staff_user: "User",
) -> Union[InicisRefundResponse, TossRefundResponse]:
    if payment.gateway == PaymentGatewayType.INICIS:
        return process_inicis_refund(
            payment=payment,
            order=order,
            refund_transaction=refund_transaction,
            staff_user=staff_user,
            pg_refund_data=pg_refund_data,
        )
    elif payment.gateway == PaymentGatewayType.TOSS:
        return process_toss_refund(
            payment=payment,
            order=order,
            refund_transaction=refund_transaction,
            staff_user=staff_user,
            pg_refund_data=pg_refund_data,
        )
    return None


def validate_brand_pg_info(gateway: PaymentGatewayType, brand: "Brand"):
    if brand:
        pg_type = brand.pg_type
        if pg_type == PgType.INICIS:
            if gateway != PaymentGatewayType.INICIS:
                raise ValidationError(
                    "해당 브랜드에 설정된 결제 PG 와 다른 PG 로 결제시도 되었습니다. 새로 고침 후 다시 시도해 주세요."
                )
            if brand.is_reverse_fee_contract_type:
                if (
                    not brand.reverse_fee_inicis_merchant_id
                    or not brand.reverse_fee_inicis_sign_key
                ):
                    raise ValidationError(
                        "매출 인식 브랜드에 결제 PG 정보가 설정되지 않았습니다. 고객센터에 문의해 주세요."
                    )
        elif pg_type == PgType.TOSS:
            if gateway != PaymentGatewayType.TOSS:
                raise ValidationError(
                    "해당 브랜드에 설정된 결제 PG 와 다른 PG 로 결제시도 되었습니다. 새로 고침 후 다시 시도해 주세요."
                )
            if brand.is_reverse_fee_contract_type:
                if not brand.reverse_fee_toss_client_key or not brand.reverse_fee_toss_secret_key:
                    raise ValidationError(
                        "매출 인식 브랜드에 결제 PG 정보가 설정되지 않았습니다. 고객센터에 문의해 주세요."
                    )
        else:
            raise ValidationError(
                "해당 브랜드에 설정된 결제 PG 정보가 잘못되었습니다. 고객센터에 문의해 주세요."
            )


def convert_to_pg_bank_code(gateway: PaymentGatewayType, bank_code: str):
    if gateway == PaymentGatewayType.INICIS:
        return convert_to_inicis_bank_code(bank_code)
    elif gateway == PaymentGatewayType.TOSS:
        return convert_to_toss_bank_code(bank_code)
    return None


def get_refunded_at(
    gateway: PaymentGatewayType, pg_refund_response: Union[InicisRefundResponse, TossRefundResponse]
):
    if gateway == PaymentGatewayType.INICIS:
        return get_inicis_refunded_at(pg_refund_response)
    elif gateway == PaymentGatewayType.TOSS:
        return get_toss_refunded_at(pg_refund_response)
    return None
