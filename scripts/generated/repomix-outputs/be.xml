class BrandCreateVacsFeeEvent(BaseMutation):
    brand_vacs_fee_event = graphene.Field(
        BrandVacsFeeEvent,
        description="생섣뇐 충전 수수료 내역",
    )

    class Arguments:
        brand_id = graphene.ID(required=True, description="brand ID")
        input = BrandVacsFeeEventInput(
            required=True, description="Fields required when creating brand reverse fee deposit."
        )

    class Meta:
        description = "충전 수수료 내역 수동 생성"
        permissions = (AccountPermissions.MANAGE_BRANDS,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: UserModel = context.user
        return user.is_authenticated and user.is_staff

    @staticmethod
    def clean_input(brand: BrandModel, input: BrandVacsFeeEventInput):
        type = input.type
        if input.type == BrandVacsFeeEventType.DECREASE:
            if brand.remain_vacs_fee_exclude_vat < input.amount_exclude_vat:
                raise ValidationError("남아 있는 충전 수수료보다 더 많이 차감할 수 없습니다.")
        else:
            raise ValidationError(
                f"충전 수수료 내역을 수동으로 생성할 수 있는 타입 정의가 아닙니다. {type}"
            )

        return input

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        requester = info.context.user
        brand: BrandModel = cls.get_node_or_error(
            info, data["brand_id"], only_type=Brand, field="brandId"
        )
        cleaned_input = cls.clean_input(brand, data["input"])
        amount_exclude_vat = cleaned_input.amount_exclude_vat
        type = cleaned_input.type
        description = cleaned_input.description

        if type == BrandVacsFeeEventType.DECREASE:
            result = brand.decrease_remain_vacs_fee_exclude_vat(
                requester, amount_exclude_vat, type, description
            )
        else:
            result = None

        return BrandCreateVacsFeeEvent(brand_vacs_fee_event=result)


