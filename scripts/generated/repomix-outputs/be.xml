import json
import logging
from sqlite3 import IntegrityError

from django.core.exceptions import ObjectDoesNotExist
from django.core.handlers.wsgi import WSGIRequest
from django.http import Http404, HttpResponse, HttpResponseBadRequest

from ...account.models import Brand
from ...points import DigitalContractCountEventType
from .define import (
    DOCUMENT_STARTED,
    MODUSIGN_BRAND_CODE_META_DATA_FIELD,
    MODUSIGN_DOCUMENT_FIELD,
    MODUSIGN_EVENT_FIELD,
    MODUSIGN_ID_FIELD,
    MODUSIGN_METADATAS_FIELD,
)
from .utils import MODUSIGN_TITLE_FIELD, call_modusign_get_document_api

logger = logging.getLogger(__name__)


def handle_webhook(request: WSGIRequest, config: any):
    full_path = request.get_full_path()
    if full_path.find(DOCUMENT_STARTED) != -1:
        return handle_document_started(request, config)

    raise Http404("path does not exist")


def handle_document_started(request: WSGIRequest, config: any):
    response = request.body.decode("EUC-KR")
    json_data = json.loads(response)

    try:
        event = json_data.get(MODUSIGN_EVENT_FIELD)
        if not event:
            error_msg = f"modusign_debug: 응답 데이터 형식 오류: {json_data}"
            logger.info(error_msg)
            return HttpResponseBadRequest(error_msg)
        event_type = event.get("type")
        if event_type != "document_started":
            logger.info(f"modusign_debug: 구독하지 않은 이벤트 타입={event_type}")
            return HttpResponse(error_msg)
        document = json_data.get(MODUSIGN_DOCUMENT_FIELD)
        if not document:
            error_msg = f"modusign_debug: 응답 데이터 형식 오류: {json_data}"
            logger.info(error_msg)
            return HttpResponseBadRequest(error_msg)
        document_id = document.get(MODUSIGN_ID_FIELD)
        response, error_msg = call_modusign_get_document_api(document_id)
        if error_msg:
            logger.info(f"modusign_debug: {error_msg}")
            return HttpResponseBadRequest(error_msg)
        if not response:
            error_msg = f"modusign_debug: 문서 데이터 오류: {json_data}"
            logger.info(error_msg)
            return HttpResponseBadRequest(error_msg)

        metadatas = response.get(MODUSIGN_METADATAS_FIELD)
        brand_code = next(
            (
                meta["value"]
                for meta in metadatas
                if meta["key"] == MODUSIGN_BRAND_CODE_META_DATA_FIELD
            ),
            None,  # 없을 경우 None 반환
        )
        if not brand_code:
            error_msg = f"modusign_debug: 응답 데이터 메타 데이터 형식 오류: {json_data}"
            logger.info(error_msg)
            return HttpResponseBadRequest(error_msg)
        try:
            brand = Brand.objects.get(code=brand_code)
        except ObjectDoesNotExist:
            error_msg = "브랜드 코드 오류 입니다."
            raise HttpResponseBadRequest(error_msg)

        try:
            document_title = response.get(MODUSIGN_TITLE_FIELD)
            brand.decrease_available_digital_contract_count(
                delta=1,
                type=DigitalContractCountEventType.DIGITAL_CONTRACT_CREATED,
                description=f"문서명: {document_title}",
                from_user=None,
                document_id=document_id,
                allow_minus_decrease=True,
            )
        except IntegrityError:
            logger.info(f"modusign_debug: 이미 차감된 계약문서입니다. {document_id}")
            return HttpResponse("OK")
        logger.info(f"modusign_debug: 웹훅으로 차감 처리 계약문서입니다. {document_id}")
        return HttpResponse("OK")
    except Exception as e:
        logger.error(f"modusign_debug: 웹훅 처리 오류 {json_data} {e}")
        raise HttpResponseBadRequest("FAIL")


