    # 위탁발주대행 여부
    use_delegated_management_for_po = models.BooleanField(default=True)
    # 리우 여부. 단 1개만 존재하며 해당 값이 True이면 주식회사 리우를 뜻함.
    is_riu = models.BooleanField(default=False)
    # 발주서 이메일 발송 여부
    use_po_email = models.BooleanField(default=False)
    # 자동 위탁 발주 사용
