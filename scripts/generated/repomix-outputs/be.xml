from copy import deepcopy
from typing import Dict, List, Tuple

import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ....product import CategoryKind, models
from ....product.models import ProductVariant as ProductVariantModel
from ....product.models import ProductVariantVendor as ProductVariantVendorModel
from ....product.utils.product_variant import reset_po_lead_time_by_pvv
from ....product.utils.variant_prices import reset_variant_cost_price_by_default_variant_vendor
from ....vendor.models import Vendor
from ...core.mutations import BaseMutation
from ...core.types.common import ProductError
from ...core.utils import get_duplicated_values
from ..mutations.input_object_types import DefaultProductVariantVendorInput
from ..utils import (
    add_pv_manage_event,
    make_total_change_summary_for_product_and_variant,
    prepare_m2m_and_related_values,
)
from .products import ProductVariantManageEventInput
from .utils import (
    validate_data_is_non_null,
    validate_duplicate,
    validate_product_sku,
    validate_vendor_code,
)


class ProductVariantVendorBulkDetails(DefaultProductVariantVendorInput):
    product_sku = graphene.String(required=True, description="제품 코드")
    vendor_code = graphene.String(required=True, description="협력사 코드")
    is_default = graphene.Boolean(description="기본협력사 여부")


class ProductVariantVendorBulkInput(graphene.InputObjectType):
    is_fulfilled_by_vendor = graphene.Boolean(
        required=True, description="협력사가 출고하는 제품(직거래 상품) 여부"
    )
    details = graphene.List(
        ProductVariantVendorBulkDetails,
        required=True,
        description="제품 협력사 정보",
    )
    manage_event = ProductVariantManageEventInput(description="제품 관리 이력", required=True)


class ProductVariantVendorBulkUpdateOrCreate(BaseMutation):
    class Arguments:
        input = ProductVariantVendorBulkInput(required=True, description="제품 협력사 정보")

    class Meta:
        description = "제품 협력사 정보 일괄 등록 및 수정"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        product_sku = detail.get("product_sku")
        vendor_code = detail.get("vendor_code")
        return f"({product_sku}:{vendor_code})"

    @classmethod
    def validate_value_empty(
        cls,
        details,
        product_variants: Dict[str, ProductVariantModel],
        update_product_variant_vendors: Dict[str, ProductVariantVendorModel],
        is_fulfilled_by_vendor: bool,
    ):
        price_errors = []
        delivery_fee_errors = []
        consignment_price_errors = []
        consignment_delivery_fee_errors = []
        moq_errors = []
        pricing_basis_qty_errors = []
        lead_time_errors = []
        for detail in details:
            sku = detail.get("product_sku")
            product_variant = product_variants[sku]
            is_b2b_catetory_kind = product_variant.product.category.kind == CategoryKind.B2B
            product_price_exclude_vat = detail.get("product_price_exclude_vat")
            delivery_fee_exclude_vat = detail.get("delivery_fee_exclude_vat")
            consignment_product_price_exclude_vat = detail.get(
                "consignment_product_price_exclude_vat"
            )
            consignment_delivery_fee_exclude_vat = detail.get(
                "consignment_delivery_fee_exclude_vat"
            )
            moq = detail.get("moq")
            pricing_basis_qty = detail.get("pricing_basis_qty")
            lead_time = detail.get("lead_time")

            detail_code = cls.make_detail_code(detail)
            is_create = detail_code not in update_product_variant_vendors

            if delivery_fee_exclude_vat is not None and delivery_fee_exclude_vat < 0:
                delivery_fee_errors.append(detail_code)
            if (
                consignment_delivery_fee_exclude_vat is not None
                and consignment_delivery_fee_exclude_vat < 0
            ):
                consignment_delivery_fee_errors.append(detail_code)

            if is_create:
                if is_fulfilled_by_vendor == False:
                    if is_b2b_catetory_kind:
                        detail["product_price_exclude_vat"] = 0
                    else:
                        if product_price_exclude_vat is None or product_price_exclude_vat < 0:
                            price_errors.append(detail_code)
                    if (
                        consignment_product_price_exclude_vat is None
                        or consignment_product_price_exclude_vat < 0
                    ):
                        consignment_price_errors.append(detail_code)
                if moq is None or moq <= 0:
                    moq_errors.append(detail_code)
                if lead_time is None or lead_time <= 0:
                    lead_time_errors.append(detail_code)
            else:
                if moq is not None and moq <= 0:
                    moq_errors.append(detail_code)
                if lead_time is not None and lead_time <= 0:
                    lead_time_errors.append(detail_code)
            if pricing_basis_qty is not None and pricing_basis_qty <= 0:
                pricing_basis_qty_errors.append(detail_code)

        if len(price_errors) > 0:
            error_msg = "협력사 재고 상품가 오류 제품코드: {}".format(", ".join(price_errors))
            raise ValidationError(error_msg)
        if len(delivery_fee_errors) > 0:
            error_msg = "협력사 재고 택배비 오류 제품코드: {}".format(
                ", ".join(delivery_fee_errors)
            )
            raise ValidationError(error_msg)
        if len(consignment_price_errors) > 0:
            error_msg = "협력사 위탁 상품가 오류 제품코드: {}".format(
                ", ".join(consignment_price_errors)
            )
            raise ValidationError(error_msg)
        if len(consignment_delivery_fee_errors) > 0:
            error_msg = "협력사 위탁 택배비 오류 제품코드: {}".format(
                ", ".join(consignment_delivery_fee_errors)
            )
        if len(moq_errors) > 0:
            error_msg = "협력사 MOQ 오류 제품코드: {}".format(", ".join(moq_errors))
            raise ValidationError(error_msg)
        if len(pricing_basis_qty_errors) > 0:
            error_msg = "협력사 기본 발주 수량 오류 제품코드: {}".format(
                ", ".join(pricing_basis_qty_errors)
            )
            raise ValidationError(error_msg)
        if len(lead_time_errors) > 0:
            error_msg = "협력사 L/T 오류 제품코드: {}".format(", ".join(lead_time_errors))
            raise ValidationError(error_msg)
        return details

    @classmethod
    def validate_outer_variants_only(cls, product_variants: Dict[str, ProductVariantModel]):
        inner_variants = [
            variant for variant in product_variants.values() if variant.outer is not None
        ]
        inner_variant_count = len(inner_variants)

        if inner_variant_count > 5:
            raise ValidationError(
                f"협력사 일괄 등록은 아우터 제품코드로 진행하세요. 이너 제품 코드 오류 {inner_variants[0].sku} 외 {inner_variant_count-1}개"
            )

        if inner_variant_count > 0:
            errors = []
            for inner_variant in inner_variants:
                errors.append(inner_variant.sku)
            raise ValidationError(
                f"협력사 일괄 등록은 아우터 제품코드로 진행하세요. 이너 제품 코드 오류 ({', '.join(errors)})"
            )

    @classmethod
    def validate_fbv_vendor_condition(
        cls,
        details,
        product_variants: Dict[str, ProductVariantModel],
        vendors: Dict[str, Vendor],
        update_product_variant_vendors_dict: Dict[str, ProductVariantVendorModel],
        is_fulfilled_by_vendor,
    ):
        if not is_fulfilled_by_vendor:
            return

        only_one_errors = []
        not_use_fbv_errors = []
        create_product_variant_vendors_dict = {}
        for detail in details:
            detail_code = cls.make_detail_code(detail)
            is_create = detail_code not in update_product_variant_vendors_dict
            if is_create:
                sku = detail.get("product_sku")
                product_variant = product_variants[sku]
                if (
                    product_variant.variant_vendors.exists()
                    or sku in create_product_variant_vendors_dict
                ):
                    only_one_errors.append(detail_code)
                else:
                    create_product_variant_vendors_dict[sku] = product_variant

                vendor_code = detail.get("vendor_code")
                vendor = vendors[vendor_code]
                if vendor.use_fbv_product == False:
                    not_use_fbv_errors.append(detail_code)

        if len(only_one_errors) > 0:
            error_msg = "직거래 상품 협력사 2개 이상 추가 시도 오류 제품코드: {}".format(
                (", ").join(only_one_errors)
            )
            raise ValidationError(error_msg)

        if len(not_use_fbv_errors) > 0:
            error_msg = "직거래 상품 취급하지 않는 협력사 추가 시도 오류 제품코드: {}".format(
                (", ").join(not_use_fbv_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_b2b_delivery_fee(
        cls,
        product_variants: Dict[str, ProductVariantModel],
        update_product_variant_vendors_dict: Dict[str, ProductVariantVendorModel],
        details,
    ):
        include_purchase_b2b_delivery_fee_errors = []
        errors = []
        for detail in details:
            sku = detail.get("product_sku")
            pv = product_variants[sku]
            category = pv.product.category
            if category.kind == CategoryKind.B2B:
                detail_code = cls.make_detail_code(detail)
                is_create = detail_code not in update_product_variant_vendors_dict
                if is_create:
                    include_purchase_b2b_delivery_fee = detail.get(
                        "include_purchase_b2b_delivery_fee"
                    )
                    if include_purchase_b2b_delivery_fee is None:
                        include_purchase_b2b_delivery_fee_errors.append(detail_code)
                    purchase_b2b_delivery_fee_exclude_vat = detail.get(
                        "purchase_b2b_delivery_fee_exclude_vat"
                    )
                    if include_purchase_b2b_delivery_fee and (
                        purchase_b2b_delivery_fee_exclude_vat is not None
                        and purchase_b2b_delivery_fee_exclude_vat != 0
                    ):
                        errors.append(detail_code)
                else:
                    pvv = update_product_variant_vendors_dict.get(detail_code)
                    include_purchase_b2b_delivery_fee = detail.get(
                        "include_purchase_b2b_delivery_fee", pvv.include_purchase_b2b_delivery_fee
                    )
                    purchase_b2b_delivery_fee_exclude_vat = detail.get(
                        "purchase_b2b_delivery_fee_exclude_vat",
                        pvv.purchase_b2b_delivery_fee_exclude_vat,
                    )
                    if (
                        include_purchase_b2b_delivery_fee
                        and purchase_b2b_delivery_fee_exclude_vat != 0
                    ):
                        errors.append(detail_code)

        if errors:
            error_msg = (
                "배송비에 매입가가 포함이면서 매입 b2b 배송비는 0 아님 오류 제품코드: {}".format(
                    ", ".join(errors)
                )
            )
            raise ValidationError(error_msg)
        if include_purchase_b2b_delivery_fee_errors:
            error_msg = "배송비에 매입가가 포함여부 누락 오류 제품코드: {}".format(
                ", ".join(include_purchase_b2b_delivery_fee_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_vendor_product_price(
        cls,
        details,
        product_variants: Dict[str, ProductVariantModel],
        update_product_variant_vendors_dict: Dict[str, ProductVariantVendorModel],
    ) -> List[str]:
        track_inventory_price_errors = []
        non_track_inventory_price_errors = []
        for detail in details:
            product_price_exclude_vat = detail.get("product_price_exclude_vat")
            consignment_product_price_exclude_vat = detail.get(
                "consignment_product_price_exclude_vat"
            )

            # 일괄 수정 시, 입력 받은 협력사 상품가 값이 없는 경우엔 기존 제품 협력사의 협력사 상품가 정보를 validation에 사용
            detail_code = cls.make_detail_code(detail)
            is_create = detail_code not in update_product_variant_vendors_dict
            if not is_create:
                product_variant_vendor = update_product_variant_vendors_dict.get(detail_code)
                if product_price_exclude_vat is None:
                    product_price_exclude_vat = product_variant_vendor.product_price_exclude_vat
                if consignment_product_price_exclude_vat is None:
                    consignment_product_price_exclude_vat = (
                        product_variant_vendor.consignment_product_price_exclude_vat
                    )

            sku = detail.get("product_sku")
            product_variant = product_variants[sku]
            track_inventory = product_variant.track_inventory
            if track_inventory:
                if product_price_exclude_vat <= 0 and consignment_product_price_exclude_vat <= 0:
                    track_inventory_price_errors.append(detail_code)
            else:
                if consignment_product_price_exclude_vat <= 0:
                    non_track_inventory_price_errors.append(detail_code)

        if len(track_inventory_price_errors) > 0:
            error_msg = "재고 운영 제품의 재고 판매 협력사 상품가 및 위탁 판매 협력사 상품가 중 하나만 0원 허용 오류 제품코드: {}".format(
                (", ").join(track_inventory_price_errors)
            )
            raise ValidationError(error_msg)
        if len(non_track_inventory_price_errors) > 0:
            error_msg = "재고 미운영 제품의 위탁 판매 상품가 0원 미허용 오류 제품코드: {}".format(
                (", ").join(non_track_inventory_price_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_default_vendor(
        cls, details, product_variants: Dict[str, ProductVariantModel]
    ) -> List[str]:
        turn_on_default_vendor_skus = [
            detail.get("product_sku") for detail in details if detail.get("is_default") == True
        ]
        duplicates = get_duplicated_values(turn_on_default_vendor_skus)
        if duplicates:
            error_msg = "기본협력사 중복 설정 오류 제품코드: {}".format((", ").join(duplicates))
            raise ValidationError(error_msg)

        active_errors = []
        turn_off_active_details = [detail for detail in details if detail.get("is_active") == False]
        for detail in turn_off_active_details:
            sku = detail.get("product_sku")
            vendor_code = detail.get("vendor_code")
            detail_code = cls.make_detail_code(detail)

            is_default = detail.get("is_default")
            if is_default:
                active_errors.append(detail_code)
            else:
                if (
                    sku not in turn_on_default_vendor_skus
                    and product_variants[sku].default_variant_vendor.vendor.code == vendor_code
                ):
                    active_errors.append(detail_code)

        if active_errors:
            error_msg = "기본협력사 활성화 끄려는 시도 오류 제품코드: {}".format(
                (", ").join(active_errors)
            )
            raise ValidationError(error_msg)

        return turn_on_default_vendor_skus

    @classmethod
    def check_update_or_create(
        cls, details, product_variants: Dict[str, ProductVariantModel], vendors: Dict[str, Vendor]
    ) -> Dict[str, ProductVariantVendorModel]:
        update_product_variant_vendors_dict = {}
        for detail in details:
            sku = detail.get("product_sku")
            vendor_code = detail.get("vendor_code")
            product_variant = product_variants[sku]
            vendor = vendors[vendor_code]
            detail_code = cls.make_detail_code(detail)
            try:
                product_variant_vendor: ProductVariantVendorModel = (
                    models.ProductVariantVendor.objects.get(
                        product_variant=product_variant, vendor=vendor
                    )
                )
                update_product_variant_vendors_dict[detail_code] = product_variant_vendor
            except:
                continue

        return update_product_variant_vendors_dict

    @classmethod
    def validate_fulfilled_by_vendor(
        cls,
        is_fulfilled_by_vendor: bool,
        product_variants: Dict[str, ProductVariantModel],
        details,
    ):
        if is_fulfilled_by_vendor:
            errors = []
            for detail in details:
                sku = detail.get("product_sku")
                product_variant = product_variants[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor == False:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

            if errors:
                error_msg = "직거래 상품 협력사 정보 일괄 생성/수정에서 보스 제품 협력사 생성/추가 시도 오류 제품코드: {}".format(
                    ", ".join(errors)
                )
                raise ValidationError(error_msg)
        else:
            errors = []
            for detail in details:
                sku = detail.get("product_sku")
                product_variant = product_variants[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

            if errors:
                error_msg = "보스 제품 협력사 정보 일괄 생성/수정에서 직거래 상품 협력사 생성/추가 시도 오류 제품코드: {}".format(
                    ", ".join(errors)
                )
                raise ValidationError(error_msg)

    @classmethod
    def clean_details(
        cls, info, input_data, is_fulfilled_by_vendor: bool
    ) -> Tuple[list, Dict[str, ProductVariantModel], Dict[str, Vendor]]:
        details = input_data.get("details")

        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)

        _, product_variants, _ = validate_product_sku(details)
        cls.validate_fulfilled_by_vendor(is_fulfilled_by_vendor, product_variants, details)

        if is_fulfilled_by_vendor == False:
            cls.validate_outer_variants_only(product_variants)

        vendors = validate_vendor_code(
            details, allow_empty=False, make_detail_code_fn=cls.make_detail_code
        )
        update_product_variant_vendors_dict = cls.check_update_or_create(
            details, product_variants, vendors
        )
        cls.validate_b2b_delivery_fee(
            product_variants, update_product_variant_vendors_dict, details
        )
        cls.validate_fbv_vendor_condition(
            details,
            product_variants,
            vendors,
            update_product_variant_vendors_dict,
            is_fulfilled_by_vendor,
        )
        details = cls.validate_value_empty(
            details, product_variants, update_product_variant_vendors_dict, is_fulfilled_by_vendor
        )
        cls.validate_vendor_product_price(
            details, product_variants, update_product_variant_vendors_dict
        )

        turn_on_default_vendor_skus = cls.validate_default_vendor(details, product_variants)

        return (
            details,
            product_variants,
            vendors,
            update_product_variant_vendors_dict,
            turn_on_default_vendor_skus,
        )

    @classmethod
    def update_or_create_product_variant_vendor(
        cls,
        details,
        product_variants: Dict[str, ProductVariantModel],
        vendors: Dict[str, Vendor],
        update_product_variant_vendors_dict: Dict[str, ProductVariantVendorModel],
        turn_on_default_vendor_skus: List[str],
    ):
        update_product_variant_vendor_list = []
        create_product_variant_vendor_list = []
        update_product_variant_list = []
        update_product_variant_list_after_bulk_create = []
        for detail in details:
            sku = detail.get("product_sku")
            vendor_code = detail.get("vendor_code")
            product_variant = product_variants[sku]
            vendor = vendors[vendor_code]

            check_update_product_variant = sku in turn_on_default_vendor_skus
            detail_code = cls.make_detail_code(detail)
            is_create = detail_code not in update_product_variant_vendors_dict

            if is_create:
                product_variant_vendor = models.ProductVariantVendor(
                    vendor=vendor,
                    product_variant=product_variant,
                )
                create_product_variant_vendor_list.append(product_variant_vendor)
                if check_update_product_variant:
                    # bulk_create 후에 check_update_product_variant 로직을 돌려야 해서 아래와 같이 flag 를 False 로 변경 후, 처리 리스트에 정보 추가
                    check_update_product_variant = False
                    update_product_variant_list_after_bulk_create.append(
                        {"product_variant": product_variant, "vendor": vendor}
                    )
            else:
                product_variant_vendor = update_product_variant_vendors_dict[detail_code]
                update_product_variant_vendor_list.append(product_variant_vendor)
                if check_update_product_variant == False:
                    if product_variant.get_default_variant_vendor() == product_variant_vendor:
                        check_update_product_variant = True

            external_sku = detail.get("external_sku")
            if external_sku is not None:
                product_variant_vendor.external_sku = external_sku
            external_product_name = detail.get("external_product_name")
            if external_product_name is not None:
                product_variant_vendor.external_product_name = external_product_name
            moq = detail.get("moq")
            if moq is not None:
                product_variant_vendor.moq = moq
            pricing_basis_qty = detail.get("pricing_basis_qty")
            if pricing_basis_qty is not None:
                product_variant_vendor.pricing_basis_qty = pricing_basis_qty
            lead_time = detail.get("lead_time")
            if lead_time is not None:
                product_variant_vendor.lead_time = lead_time
                if check_update_product_variant == False:
                    if product_variant.get_default_variant_vendor() == product_variant_vendor:
                        check_update_product_variant = True
            product_price_exclude_vat = detail.get("product_price_exclude_vat")
            if product_price_exclude_vat is not None:
                product_variant_vendor.product_price_exclude_vat = product_price_exclude_vat
            delivery_fee_exclude_vat = detail.get("delivery_fee_exclude_vat")
            if delivery_fee_exclude_vat is not None:
                product_variant_vendor.delivery_fee_exclude_vat = delivery_fee_exclude_vat
            consignment_product_price_exclude_vat = detail.get(
                "consignment_product_price_exclude_vat"
            )
            if consignment_product_price_exclude_vat is not None:
                product_variant_vendor.consignment_product_price_exclude_vat = (
                    consignment_product_price_exclude_vat
                )
            consignment_delivery_fee_exclude_vat = detail.get(
                "consignment_delivery_fee_exclude_vat"
            )
            if consignment_delivery_fee_exclude_vat is not None:
                product_variant_vendor.consignment_delivery_fee_exclude_vat = (
                    consignment_delivery_fee_exclude_vat
                )
            note = detail.get("note")
            if note is not None:
                product_variant_vendor.note = note
            note_for_unit_price = detail.get("note_for_unit_price")
            if note_for_unit_price is not None:
                product_variant_vendor.note_for_unit_price = note_for_unit_price
            is_active = detail.get("is_active")
            if is_active is not None:
                product_variant_vendor.is_active = is_active
            include_purchase_b2b_delivery_fee = detail.get("include_purchase_b2b_delivery_fee")
            if include_purchase_b2b_delivery_fee is not None:
                product_variant_vendor.include_purchase_b2b_delivery_fee = (
                    include_purchase_b2b_delivery_fee
                )
            purchase_b2b_delivery_fee_exclude_vat = detail.get(
                "purchase_b2b_delivery_fee_exclude_vat"
            )
            if purchase_b2b_delivery_fee_exclude_vat is not None:
                product_variant_vendor.purchase_b2b_delivery_fee_exclude_vat = (
                    purchase_b2b_delivery_fee_exclude_vat
                )

            if check_update_product_variant:
                outer_variant, inner_variant = reset_variant_cost_price_by_default_variant_vendor(
                    product_variant,
                    product_variant.inner,
                    product_variant_vendor,
                    save_default_variant_vendor=True,
                    from_bulk_update_mode=True,
                )
                reset_po_lead_time_by_pvv(
                    outer_variant, product_variant_vendor, from_bulk_update_mode=True
                )
                update_product_variant_list.append(outer_variant)
                if inner_variant:
                    update_product_variant_list.append(inner_variant)

        if update_product_variant_vendor_list:
            models.ProductVariantVendor.objects.bulk_update(
                update_product_variant_vendor_list,
                [
                    "external_sku",
                    "external_product_name",
                    "moq",
                    "pricing_basis_qty",
                    "lead_time",
                    "product_price_exclude_vat",
                    "delivery_fee_exclude_vat",
                    "consignment_product_price_exclude_vat",
                    "consignment_delivery_fee_exclude_vat",
                    "note",
                    "note_for_unit_price",
                    "is_active",
                    "include_purchase_b2b_delivery_fee",
                    "purchase_b2b_delivery_fee_exclude_vat",
                ],
            )
        if create_product_variant_vendor_list:
            created_product_variant_vendors = models.ProductVariantVendor.objects.bulk_create(
                create_product_variant_vendor_list
            )

            if update_product_variant_list_after_bulk_create:
                for update_product_variant in update_product_variant_list_after_bulk_create:
                    product_variant = update_product_variant["product_variant"]
                    vendor = update_product_variant["vendor"]
                    product_variant_vendor = next(
                        (
                            created_product_variant_vendor
                            for created_product_variant_vendor in created_product_variant_vendors
                            if created_product_variant_vendor.product_variant == product_variant
                            and created_product_variant_vendor.vendor == vendor
                        ),
                        None,
                    )
                    if product_variant_vendor:
                        outer_variant, inner_variant = (
                            reset_variant_cost_price_by_default_variant_vendor(
                                product_variant,
                                product_variant.inner,
                                product_variant_vendor,
                                save_default_variant_vendor=True,
                                from_bulk_update_mode=True,
                            )
                        )
                        reset_po_lead_time_by_pvv(
                            outer_variant, product_variant_vendor, from_bulk_update_mode=True
                        )
                        update_product_variant_list.append(outer_variant)
                        if inner_variant:
                            update_product_variant_list.append(inner_variant)

        if update_product_variant_list:
            models.ProductVariant.objects.bulk_update(
                update_product_variant_list,
                [
                    "cost_price_exclude_vat",
                    "consignment_cost_price_exclude_vat",
                    "default_variant_vendor",
                    "po_lead_time",
                ],
            )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        is_fulfilled_by_vendor = input_data.get("is_fulfilled_by_vendor")
        (
            details,
            product_variants,
            vendors,
            update_product_variant_vendors_dict,
            turn_on_default_vendor_skus,
        ) = cls.clean_details(
            info=info, input_data=input_data, is_fulfilled_by_vendor=is_fulfilled_by_vendor
        )

        # product_variants는 Dict[str, ProductVariantModel] 형태임. deepcopy를 이용해서, 스냅샷을 저장.
        before_product_variants = {
            sku: (deepcopy(product_variant), deepcopy(product_variant.product))
            for sku, product_variant in product_variants.items()
        }
        # 각 item마다 prepare_m2m_and_related_values를 저장해 놓는다. product_variant, product 둘다 써야함.
        before_product_variant_m2m_and_related_values = {
            sku: prepare_m2m_and_related_values(product_variant[1], product_variant[0])
            for sku, product_variant in before_product_variants.items()
        }

        cls.update_or_create_product_variant_vendor(
            details=details,
            product_variants=product_variants,
            vendors=vendors,
            update_product_variant_vendors_dict=update_product_variant_vendors_dict,
            turn_on_default_vendor_skus=turn_on_default_vendor_skus,
        )

        manage_event = input_data.get("manage_event")
        if manage_event:
            # before_product_variants의 모든sku에 대해서 for문 실행
            for sku, (before_product_variant, before_product) in before_product_variants.items():
                # prouct_variants에서 sku에 해당 하는 값을 찾는다.
                updated_pv = product_variants[sku]
                updated_product = updated_pv.product

                before_product_m2m_and_related_values, before_variant_m2m_and_related_values = (
                    before_product_variant_m2m_and_related_values[sku]
                )

                # make_total_change_summary_for_product_and_variant 함수를 이용해서 변경된 내용을 찾는다.
                product_changes, variant_changes, _ = (
                    make_total_change_summary_for_product_and_variant(
                        before_variant=before_product_variant,
                        before_inner_variant=None,
                        before_product=before_product,
                        before_product_m2m_and_related_values=before_product_m2m_and_related_values,
                        before_variant_m2m_and_related_values=before_variant_m2m_and_related_values,
                        updated_variant=updated_pv,
                        updated_product=updated_product,
                    )
                )

                change_details = "\n".join(product_changes + variant_changes)
                manage_event["change_details"] = change_details
                add_pv_manage_event(pv=updated_pv, manage_event=manage_event, info=info)

        return ProductVariantVendorBulkUpdateOrCreate()
