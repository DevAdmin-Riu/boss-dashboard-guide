from typing import TYPE_CHECKING, List

from django.db.models import Count, ExpressionWrapper, F, FloatField, Sum

from ...pre_founder import PreFounderEvalStatus
from ...pre_founder.models import (
    PreFounder,
    PreFounderEvalAnswer,
    PreFounderEvalItem,
    PreFounderEvalSnapshot,
)

if TYPE_CHECKING:
    from .types import PreFounderEvalSnapshotData


# 스냅샷 데이터 생성 필요 여부
def _check_need_eval_snapshot_create(new_status: PreFounderEvalStatus, score_changed: bool) -> bool:
    if new_status == PreFounderEvalStatus.EVALUATED and score_changed:
        return True
    return False


def _calc_eval_total_score(weighted_sum: int, weight_sum: int):
    if weight_sum == 0:
        return None
    return round((weighted_sum) / weight_sum, 2)


def make_pre_founder_eval_snapshot_data(
    eval_items: List[PreFounderEvalItem], eval_answers: List[PreFounderEvalAnswer]
) -> List["PreFounderEvalSnapshotData"]:
    eval_data: List["PreFounderEvalSnapshotData"] = []

    answers_by_item_id = {answer.item_id: answer for answer in eval_answers}

    for item in eval_items:
        item_data = {
            "name": item.name,
            "description": item.description,
            "weight": item.weight,
        }
        answer = answers_by_item_id.get(item.id)
        answer_data = {
            "score": answer.score if answer else 0.0,
            "reason": answer.reason if answer else "",
        }
        eval_data.append(
            {
                "item": item_data,
                "answer": answer_data,
            }
        )
    return eval_data


def update_pre_founder_eval_info(pre_founder: PreFounder):
    weighted_expr = ExpressionWrapper(
        F("eval_answers__score") * F("eval_answers__item__weight"), output_field=FloatField()
    )
    row = (
        PreFounder.objects.filter(pk=pre_founder.pk)
        .annotate(
            answered_count=Count("eval_answers__id"),
            weight_sum=Sum("eval_answers__item__weight"),
            weighted_sum=Sum(weighted_expr),
        )
        .values(
            "id", "eval_total_score", "eval_status", "answered_count", "weight_sum", "weighted_sum"
        )
        .first()
    )
    if row is None:
        return

    old_status = row["eval_status"]
    old_score = row["eval_total_score"]
    answered_count = row["answered_count"] or 0
    weight_sum = row["weight_sum"] or 0
    weighted_sum = row["weighted_sum"]

    new_score = None
    items = list(PreFounderEvalItem.objects.filter(brand_id=pre_founder.brand_id))
    items_count = len(items)
    if items_count == 0 or answered_count == 0:
        new_status = PreFounderEvalStatus.NOT_EVALUATED
    elif answered_count >= items_count:
        new_status = PreFounderEvalStatus.EVALUATED
        new_score = _calc_eval_total_score(weighted_sum, weight_sum)
    else:
        new_status = PreFounderEvalStatus.IN_EVALUATION

    update_kwargs = {}
    status_changed = old_status != new_status
    score_changed = old_score != new_score
    if status_changed:
        update_kwargs["eval_status"] = new_status
        pre_founder.eval_status = new_status
    if score_changed:
        update_kwargs["eval_total_score"] = new_score
        pre_founder.eval_total_score = new_score

    if _check_need_eval_snapshot_create(new_status, score_changed):
        answers = PreFounderEvalAnswer.objects.filter(pre_founder=pre_founder)
        PreFounderEvalSnapshot.objects.create(
            pre_founder_id=row["id"],
            eval_data=make_pre_founder_eval_snapshot_data(items, answers),
        )

    if update_kwargs:
        PreFounder.objects.filter(pk=pre_founder.pk).update(**update_kwargs)


def update_all_pre_founder_eval_info_for_brand(brand_id: int):
    weighted_expr = ExpressionWrapper(
        F("eval_answers__score") * F("eval_answers__item__weight"), output_field=FloatField()
    )
    qs = (
        PreFounder.objects.filter(brand_id=brand_id)
        .annotate(
            answered_count=Count("eval_answers__id"),
            weight_sum=Sum("eval_answers__item__weight"),
            weighted_sum=Sum(weighted_expr),
        )
        .values(
            "id", "eval_total_score", "eval_status", "answered_count", "weight_sum", "weighted_sum"
        )
    )

    items = list(PreFounderEvalItem.objects.filter(brand_id=brand_id))
    items_count = len(items)

    to_update: list[PreFounder] = []
    snapshots: list[PreFounderEvalSnapshot] = []

    for row in qs.iterator():
        old_status = row["eval_status"]
        old_score = row["eval_total_score"]
        answered_count = row["answered_count"] or 0
        weight_sum = row["weight_sum"] or 0
        weighted_sum = row["weighted_sum"]

        new_score = None

        if items_count == 0 or answered_count == 0:
            new_status = PreFounderEvalStatus.NOT_EVALUATED
        elif answered_count >= items_count:
            new_status = PreFounderEvalStatus.EVALUATED
            new_score = _calc_eval_total_score(weighted_sum, weight_sum)
        else:
            new_status = PreFounderEvalStatus.IN_EVALUATION

        status_changed = old_status != new_status
        score_changed = old_score != new_score
        if status_changed or score_changed:
            pre_founder = PreFounder(pk=row["id"])
            pre_founder.eval_total_score = new_score
            pre_founder.eval_status = new_status
            to_update.append(pre_founder)

        if _check_need_eval_snapshot_create(new_status, score_changed):
            answers = PreFounderEvalAnswer.objects.filter(pre_founder=pre_founder)
            snapshots.append(
                PreFounderEvalSnapshot(
                    pre_founder_id=row["id"],
                    eval_data=make_pre_founder_eval_snapshot_data(items, answers),
                )
            )

    if to_update:
        PreFounder.objects.bulk_update(to_update, fields=["eval_total_score", "eval_status"])

    if snapshots:
        PreFounderEvalSnapshot.objects.bulk_create(snapshots)
