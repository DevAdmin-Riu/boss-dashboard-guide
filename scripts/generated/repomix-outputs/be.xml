import logging
from datetime import datetime
from typing import TYPE_CHECKING

import pytz
from popbill import PopbillException, Taxinvoice, TaxinvoiceDetail, TaxinvoiceService

from ...core.prices import calc_to_exclude_vat
from ...core.utils.math import my_round
from ...payment import ChargeStatus
from ...taxinvoice.models import TaxInvoice
from ...taxinvoice.utils import (
    get_invoicee_biz_reg_info_by_tax_invoice,
    get_invoicer_biz_reg_info_by_tax_invoice,
)
from ..email.utils import get_recipient_email_consider_test_mode
from ..manager import get_plugins_manager
from .define import POPBILL_PLUGIN_ID

if TYPE_CHECKING:
    from ...account.models import Brand

logger = logging.getLogger(__name__)


def convert_to_popbill_bank_code(bank_code: str) -> str:
    if not bank_code:
        return None
    return f"00{bank_code}"


def get_current_date_time_zone():
    return datetime.now(tz=pytz.utc)


def getTaxInvoiceService(popbill_plugin_config):
    # config/settings.py 작성한 LinkID, SecretKey를 이용해 TaxinvoiceService 객체 생성
    taxinvoiceService = TaxinvoiceService(
        popbill_plugin_config.LinkID, popbill_plugin_config.SecretKey
    )

    # 연동환경 설정값, 개발용(True), 상업용(False)
    taxinvoiceService.IsTest = not popbill_plugin_config.is_prod_mode

    # 인증토큰 IP제한기능 사용여부, 권장(True)
    taxinvoiceService.IPRestrictOnOff = True

    # 팝빌 API 서비스 고정 IP 사용여부, true-사용, false-미사용, 기본값(false)
    taxinvoiceService.UseStaticIP = False

    # 로컬시스템 시간 사용여부, 권장(True)
    taxinvoiceService.UseLocalTimeYN = True

    # 전자세금계산서 발행을 위해 인증서를 등록합니다. (등록방법은 사이트/API 두가지 방식이 있습니다.)
    # 1. 팝빌사이트 로그인 > [전자세금계산서] > [환경설정] > [인증서 관리] 메뉴에서 등록
    # 2. 인증서 등록 팝업 URL (getTaxCertURL API)을 이용하여 등록
    return taxinvoiceService


# 공급자 문서번호, 1~24자리, (영문, 숫자, '-', '_') 조합으로
# 사업자별로 중복되지 않도록 구성
def make_MgtKey(date_time: datetime, tax_invoice_id: str):
    time_tag = date_time.strftime("%Y%m%d%H%M%S")
    return f"{time_tag}-{tax_invoice_id}"


def create_tax_invoice_issue(tax_invoice: TaxInvoice):
    """
    작성된 세금계산서 데이터를 팝빌에 저장과 동시에 발행(전자서명)하여 "발행완료" 상태로 처리합니다.
    - 세금계산서 국세청 전송 정책 [https://docs.popbill.com/taxinvoice/ntsSendPolicy?lang=python]
    - "발행완료"된 전자세금계산서는 국세청 전송 이전에 발행취소(CancelIssue API) 함수로 국세청 신고 대상에서 제외할 수 있습니다.
    - 임시저장(Register API) 함수와 발행(Issue API) 함수를 한 번의 프로세스로 처리합니다.
    - 세금계산서 발행을 위해서 공급자의 인증서가 팝빌 인증서버에 사전등록 되어야 합니다.
        └ 위수탁발행의 경우, 수탁자의 인증서 등록이 필요합니다.
    - https://docs.popbill.com/taxinvoice/python/api#RegistIssue
    """

    is_b2b = tax_invoice.is_b2b
    order = tax_invoice.order
    if is_b2b == False and order is None:
        logger.error("세금계산서 발행을 위한 주문 정보가 없습니다.")
        return None, True

    # tax_invoic.is_from_riu (공급자 리우 여부)에 따라 공급자 정보 달라짐
    invoicer_biz_reg_info = get_invoicer_biz_reg_info_by_tax_invoice(tax_invoice)
    if not invoicer_biz_reg_info:
        logger.error("세금계산서 발행을 위한 공급자 정보를 생성하지 못했습니다.")
        return None, False

    invoicee_biz_reg_info = get_invoicee_biz_reg_info_by_tax_invoice(tax_invoice)
    if not invoicee_biz_reg_info:
        logger.error("세금계산서 발행을 위한 공급받는자 정보를 생성하지 못했습니다.")
        return None, False

    is_tax_free = tax_invoice.is_tax_free
    total_amount = tax_invoice.total_amount

    if is_b2b:
        close_date = tax_invoice.write_date.strftime("%Y년 %m월")
        product_name = f"{close_date} 상품 대금"
    else:
        payment_status = order.get_payment_status()
        if total_amount > 0 and payment_status not in [
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
        ]:
            logger.error(
                f"결제 상태가 유효하지 않습니다. order={order}, payment_status={payment_status} "
            )
            return None, True

        lines = order.get_lines_tax_free() if is_tax_free else order.get_lines_taxable()

        length = len(lines)
        first_product_name = lines[0].product_name if length > 0 else None
        if first_product_name:
            product_name = (
                f"{first_product_name} 외 {length - 1}건" if length > 1 else f"{first_product_name}"
            )
        else:
            product_name = "반품배송비"

    # 공급가액 합계
    total_amount_exclude_vat = calc_to_exclude_vat(total_amount, is_tax_free)
    rounded_total_amount = my_round(total_amount)

    current_date_time_zone = get_current_date_time_zone()
    MgtKey = make_MgtKey(current_date_time_zone, tax_invoice.id)

    # 요청 시 인자: Popbill 요청 Tutorial(https://docs.popbill.com/taxinvoice/tutorial/python) 참조
    try:
        # 팝빌회원 사업자번호: 매출인식 가맹본부 사업자 번호도 팝빌에 서브 회원으로 등록해서 실제 공급자 사업자 번호와 동일한 번호 사용
        CorpNum = invoicer_biz_reg_info.biz_reg_no

        # 세금계산서 정보
        taxinvoice = Taxinvoice(
            # 작성일자, 날짜형식(yyyyMMdd) ex)20220805
            writeDate=tax_invoice.write_date.strftime("%Y%m%d"),
            # 과금방향, {정과금} 기재
            chargeDirection="정과금",
            # 발행형태, {정발행, 위수탁} 중 기재
            issueType="정발행",
            # {영수, 청구, 없음} 중 기재
            purposeType="영수",
            # 과세형태, {과세, 영세, 면세} 중 기재
            taxType="면세" if is_tax_free else "과세",
            ######################################################################
            #                             공급자 정보
            ######################################################################
            # 공급자 사업자번호 , '-' 없이 10자리 기재.
            invoicerCorpNum=invoicer_biz_reg_info.biz_reg_no,
            # 공급자 상호
            invoicerCorpName=invoicer_biz_reg_info.biz_reg_corp_name,
            # 공급자 문서번호, 1~24자리, (영문, 숫자, '-', '_') 조합으로
            # 사업자별로 중복되지 않도록 구성
            invoicerMgtKey=MgtKey,
            # 공급자 대표자 성명
            invoicerCEOName=invoicer_biz_reg_info.biz_reg_ceo_name,
            # 공급자 주소
            invoicerAddr=invoicer_biz_reg_info.biz_reg_address,
            # 공급자 종목
            invoicerBizClass=invoicer_biz_reg_info.biz_reg_class,
            # 공급자 업태
            invoicerBizType=invoicer_biz_reg_info.biz_reg_type,
            ######################################################################
            #                            공급받는자 정보
            ######################################################################
            # 공급받는자 구분, [사업자, 개인, 외국인] 중 기재
            invoiceeType="사업자",
            # 공급받는자 사업자번호
            # - {invoiceeType}이 "사업자" 인 경우, 사업자번호 (하이픈 ('-') 제외 10자리)
            # - {invoiceeType}이 "개인" 인 경우, 주민등록번호 (하이픈 ('-') 제외 13자리)
            # - {invoiceeType}이 "외국인" 인 경우, "9999999999999" (하이픈 ('-') 제외 13자리)
            invoiceeCorpNum=invoicee_biz_reg_info.biz_reg_no,
            # 공급받는자 상호
            invoiceeCorpName=invoicee_biz_reg_info.biz_reg_corp_name,
            # 공급받는자 대표자 성명
            invoiceeCEOName=invoicee_biz_reg_info.biz_reg_ceo_name,
            ######################################################################
            #                          세금계산서 기재정보
            ######################################################################
            # 합계금액
            totalAmount=rounded_total_amount,
            # 공급가액 합계
            supplyCostTotal=total_amount_exclude_vat,
            # 세액 합계 = 합계금액 - 공급가액 합계
            taxTotal=rounded_total_amount - total_amount_exclude_vat,
            ######################################################################
            #                           상세항목(품목) 정보
            ######################################################################
            # 상세항목 0~99개 까지 작성가능.
            # 일련번호 (serialNum) 는 1부터 99까지 순차기재.
            # 일련번호, 1부터 순차기재 - 여러 품목도 XXX 외 1건 으로 한 줄만 표시
            # 단가(unitCost)=총액
            # 공급가액(supplyCost)=공급가액 총합
            # 세액(tax)=총액 - 공급가액 총합
            detailList=[
                TaxinvoiceDetail(
                    serialNum=1,
                    itemName=product_name,
                    qty=1,
                    unitCost=rounded_total_amount,
                    supplyCost=total_amount_exclude_vat,
                    tax=rounded_total_amount - total_amount_exclude_vat,
                )
            ],
        )

        # 공급받는자 담당자 메일주소
        # 팝빌 개발환경에서 테스트하는 경우에도 안내 메일이 전송되므로,
        # 실제 거래처의 메일주소가 기재되지 않도록 주의
        if invoicee_biz_reg_info.biz_reg_email:
            taxinvoice.invoiceeEmail1 = get_recipient_email_consider_test_mode(
                invoicee_biz_reg_info.biz_reg_email
            )

        # 공급받는자 주소
        if invoicee_biz_reg_info.biz_reg_address:
            taxinvoice.invoiceeAddr = invoicee_biz_reg_info.biz_reg_address

        # 공급받는자 업태
        if invoicee_biz_reg_info.biz_reg_type:
            taxinvoice.invoiceeBizType = invoicee_biz_reg_info.biz_reg_type

        # 공급받는자 종목
        if invoicee_biz_reg_info.biz_reg_class:
            taxinvoice.invoiceeBizClass = invoicee_biz_reg_info.biz_reg_class

        popbill_plugin_configs = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
        response = getTaxInvoiceService(popbill_plugin_configs).registIssue(CorpNum, taxinvoice)
        if response is None:
            logger.error("팝빌 세금계산서 발행 리턴 정보가 없습니다.")
            return None, False
        return {
            "nts_confirm_num": response.ntsConfirmNum,
            "issued": current_date_time_zone,
            "mgt_key": MgtKey,
        }, False
    except PopbillException as PE:
        return PE, False


def get_view_url(tax_invoice: TaxInvoice):
    """
    팝빌 사이트와 동일한 세금계산서 1건의 상세 정보 페이지의 팝업 URL을 반환합니다.
    - 반환되는 URL은 보안 정책상 30초 동안 유효하며, 시간을 초과한 후에는 해당 URL을 통한 페이지 접근이 불가합니다.
    - https://docs.popbill.com/taxinvoice/python/api#GetPopUpURL
    """
    try:
        invoicer_biz_reg_info = get_invoicer_biz_reg_info_by_tax_invoice(tax_invoice)
        if not invoicer_biz_reg_info:
            return None
        popbill_plugin_config = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
        # 팝빌회원 사업자번호: 매출인식 가맹본부 사업자 번호도 팝빌에 서브 회원으로 등록해서 실제 공급자 사업자 번호와 동일한 번호 사용
        CorpNum = invoicer_biz_reg_info.biz_reg_no
        # 세금계산서 발행유형, SELL : 매출 , BUY : 매입 , TRUSTEE : 수탁
        MgtKeyType = "SELL"
        # 문서번호
        MgtKey = tax_invoice.mgt_key
        url = getTaxInvoiceService(popbill_plugin_config).getViewURL(CorpNum, MgtKeyType, MgtKey)
        return url
    except PopbillException as PE:
        return PE
