                    filter=(
                        Q(addresses__is_direct_shipping=True)
                        & Q(addresses__direct_shipping_status=AddressDirectShippingStatus.REQUESTED)
                    ),
                )
            )
            qs = qs.filter(need_to_confirm_direct_shpping_count__gt=0)
        return qs

    def filter_orderable(qs, _, value):
        if value == True:
            return qs.filter(
                Q(brand_store_user__isnull=True)
                | Q(brand_store_user__role__in=[BrandStoreRole.OWNER])
            )
        return qs

    def filter_is_b2b(qs, _, value):
