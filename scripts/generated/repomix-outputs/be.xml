    )


class InspectStockUpAndInspectCheckCombineMutation(BaseMutation):
    refund_inspect = graphene.Field(RefundInspect)

    class Arguments:
        id = graphene.ID(required=True, description="교환/반품/취소 문의 ID")
        input = InspectStockUpAndInspectCheckCombineMutationInput(required=True)

    class Meta:
        description = "반품 시 입고처리 하는 mutation 이후에 각각의 검수도 상태 변경"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        id = data.get("id")
        input = data.get("input")
        inspect_input = input.get("inspect_input")
        refund_inspect_id = input.get("refund_inspect_id")
        fulfillment_cancellation = input.get("fulfillment_cancellation")
        inspect = inspect_input.get("inspect")

        refund_qa: RefundQAModel = cls.get_node_or_error(
            info,
            id,
            only_type=RefundQA,
        )

        inspect_status_change_response = None

        if inspect == True and refund_qa.status == RefundStatusType.STOCK_INCLUDED_REQUESTED:
            fulfillment_cancel_response = FulfillmentCancel.mutate(
                root,
                info,
                id=fulfillment_cancellation.id,
                input=fulfillment_cancellation.input,
            )
            if fulfillment_cancel_response.errors:
                raise ValidationError(
                    f"FulfillmentCancel mutation 실패 - {fulfillment_cancel_response.errors[0].message}"
                )

        if refund_qa.status == RefundStatusType.COLLECTED_INSPECT:
            inspect_status_change_response = InspectStatusChangeMutation.mutate(
                root,
                info,
                id=refund_inspect_id,
                input=inspect_input,
            )
            if inspect_status_change_response.errors:
                raise ValidationError(
                    f"InspectStatusChangeMutation mutation 실패 - {inspect_status_change_response.errors[0].message}"
                )

        if refund_qa.status == RefundStatusType.STOCK_INCLUDED_REQUESTED:
            inspect_status_change_response = InspectStatusChangeAndStockAddMutation.mutate(
                root, info, id=refund_inspect_id, input=inspect_input
            )
            if inspect_status_change_response.errors:
                raise ValidationError(
                    f"InspectStatusChangeMutation mutation 실패 - {inspect_status_change_response.errors[0].message}"
                )

        return cls(
            # return_field_name 지정없이 ModelMutation 기본 return_filed_name으로 get_model_name 으로 camelCase 변수로 사용
            refund_inspect=inspect_status_change_response.refundInspect
        )


