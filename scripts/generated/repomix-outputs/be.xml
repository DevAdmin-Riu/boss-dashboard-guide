def task_send_kakaotalk(
    talk_code: str,
    receiver_phone: str,
    parameters: dict,
    replace_dict: dict,
    config: any,
):
    template_code = "-"
    code = "-"
    error_mesage = "-"
    try:
        logger.info(f"알림톡 발송 시작 inside task : {talk_code}, {receiver_phone}, {parameters}")
        if not receiver_phone:
            raise Exception(f"수신 휴대폰 번호가 비어 있습니다.")

        if receiver_phone.startswith("010") == False:
            raise Exception(f"수신 휴대폰 번호가 유효하지 않습니다.")

        config = DotMap(config)
        if config.has_key(talk_code) == False:
            logger.error(f"알림톡 템플릿코드가 플러그인 설정에 정의되어 있지 않습니다.")
            # 알림톡 발송 안하는 것으로 정책 변경된 경우 무의미한 템플릿 코드로 변경해서 운영중이므로, raise 하지 않음
            return

        template_code = config[talk_code]
        token, result_code = generate_token(config)
        if token is None:
            raise Exception(f"알림톡 토큰 생성 실패: {result_code}")

        template_list = get_template_list(config, token)
        if template_list is None or len(template_list) == 0:
            raise Exception(f"알림톡 템플릿 리스트가 비어 있습니다.")

        try:
            template_list.index(template_code)
        except:
            logger.error(f"템플릿 코드 오류 {talk_code}, {template_code}")
            # 알림톡 발송 안하는 것으로 정책 변경된 경우 무의미한 템플릿 코드로 변경해서 운영중이므로, raise 하지 않음
            return

        template_info = get_template_info(config, token, template_code)
        result = send_kakao(
            config,
            token,
            talk_code,
            template_code,
            template_info,
            receiver_phone,
            replace_dict,
        )
        logger.info(f"알림톡 발송 결과: {talk_code}, {template_code}, {receiver_phone}, {result}")

        code = result.get("code") if result else None
        if str(code) == "0":
            aligo_event_id = parameters.get("aligo_event_id")
            if aligo_event_id:
                update_send_aligo_event_success(aligo_event_id=aligo_event_id)
            inquire_about_service_id = parameters.get("inquire_about_service_id")
            if inquire_about_service_id:
                update_send_aligo_event_success_inquire_about(
                    inquire_about_service_id=inquire_about_service_id
                )
        else:
            code = code if code else "-"
            error_mesage = result.get("message", "-") if result else "-"
            error_message = unquote(error_mesage)
            raise Exception(error_message)

    except Exception as e:
        logger.error(f"알림톡 발송 실패: {talk_code}, {receiver_phone}, {parameters}, {e}")
        context = {
            "error_code": str(code),
            "error_message": str(e),
            "talk_code": talk_code,
            "template_code": template_code,
            RECEIVER_PHONE: receiver_phone,
        }
