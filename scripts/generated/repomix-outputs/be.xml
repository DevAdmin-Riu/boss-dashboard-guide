        description="sweet tracker api 호출하여 실시간 배송 정보 조회",
    )

    @permission_required(AccountPermissions.VIEW_STAFF)
    def resolve_fulfillment(self, info, **data):
        return resolve_fulfillment(info, data.get("id"))

    def resolve_fulfillments(self, info, created=None, status=None, **_kwargs):
        return resolve_fulfillments(info, created, status)

    def resolve_fulfillment_lines(self, info, **_kwargs):
