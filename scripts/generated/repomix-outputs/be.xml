class ProductVariantBulkUpdate(BaseMutation):
    class Arguments:
        input = ProductVariantBulkUpdateInput(
            required=True, description="제품 상세 정보 일괄 변경 입력"
        )

    class Meta:
        description = "제품 상세 정보 bulk update"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        product_sku = detail.get("product_sku")
        return f"{product_sku}"

    @classmethod
    def validate_value_empty(cls, details):
        qty_per_box_errors = []
        box_size_errors = []
        stock_adjust_factor_errors = []
        for detail in details:
            qty_per_box = detail.get("qty_per_box")
            box_length = detail.get("box_length")
            box_width = detail.get("box_width")
            box_height = detail.get("box_height")
            stock_adjust_factor = detail.get("stock_adjust_factor")

            detail_code = cls.make_detail_code(detail)

            if qty_per_box is not None and qty_per_box <= 0:
                qty_per_box_errors.append(detail_code)

            if (
                (
                    box_length is not None
                    and (box_length <= 0 or is_valid_decimal(box_length, 5, 1) == False)
                )
                or (
                    box_width is not None
                    and (box_width <= 0 or is_valid_decimal(box_width, 5, 1) == False)
                )
                or (
                    box_height is not None
                    and (box_height <= 0 or is_valid_decimal(box_height, 5, 1) == False)
                )
            ):
                box_size_errors.append(detail_code)

            if stock_adjust_factor is not None and (
                stock_adjust_factor < -1000 or stock_adjust_factor > 1000
            ):
                stock_adjust_factor_errors.append(detail_code)

        if len(qty_per_box_errors) > 0:
            error_msg = "입수량 오류 제품코드: {}".format(", ".join(qty_per_box_errors))
            raise ValidationError(error_msg)
        if len(box_size_errors) > 0:
            error_msg = "박스 규격 오류 제품코드: {}".format(", ".join(box_size_errors))
            raise ValidationError(error_msg)
        if len(stock_adjust_factor_errors) > 0:
            error_msg = "재발주점 보정값 오류 제품코드: {}".format(
                ", ".join(stock_adjust_factor_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_can_sale_by_inner(
        cls, details, product_variant_dict: Dict[str, ProductVariantModel]
    ):
        sub_pv_errors = []
        for detail in details:
            sku = detail.get("product_sku")
            product_variant = product_variant_dict[sku]
            can_sale_by_inner = detail.get("can_sale_by_inner", product_variant.can_sale_by_inner)
            if can_sale_by_inner:
                if product_variant.sub_pv:
                    sub_pv_errors.append(sku)
        if sub_pv_errors:
            error_msg = "부자재 제품 이너박스 운영 오류 제품코드: {}".format(
                ", ".join(sub_pv_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_track_inventory(
        cls, details, product_variant_dict: Dict[str, ProductVariantModel]
    ):
        allow_auto_consignment_errors = []
        sub_pv_errors = []
        for detail in details:
            sku = detail.get("product_sku")
            product_variant = product_variant_dict[sku]
            track_inventory = detail.get("track_inventory", product_variant.track_inventory)
            allow_auto_consignment = detail.get(
                "allow_auto_consignment", product_variant.allow_auto_consignment
            )
            is_inner = product_variant.outer is not None

            if track_inventory == False:
                if product_variant.sub_pv is not None or product_variant.main_pvs_relation.exists():
                    sub_pv_errors.append(sku)
                if not is_inner:
                    if allow_auto_consignment:
                        allow_auto_consignment_errors.append(sku)

        if allow_auto_consignment_errors:
            error_msg = "자동 위탁 허용하며 재고 미운영 시도 오류 제품코드: {}".format(
                ", ".join(allow_auto_consignment_errors)
            )
            raise ValidationError(error_msg)
        if sub_pv_errors:
            error_msg = "부자재로 연결된 제품 재고 미운영 시도 오류 제품코드: {}".format(
                ", ".join(sub_pv_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def clean_attributes(cls, details, product_variant_dict: Dict[str, ProductVariantModel]):
        detail_slug_errors = []
        detail_value_errors = []
        for detail in details:
            sku = detail.get("product_sku")
            attributes = detail.get("attributes")
            product_variant = product_variant_dict[sku]
            product = product_variant.product
            product_type = product.product_type
            detail_code = cls.make_detail_code(detail)

            (
                product_attributes_cleaned_input,
                variant_attributes_cleaned_input,
                slug_errors,
                value_errors,
            ) = AttributeAssignmentMixin.clean_input_for_variant_bulk_update(
                attributes, product_type
            )
            detail["product_attributes_cleaned_input"] = product_attributes_cleaned_input
            detail["variant_attributes_cleaned_input"] = variant_attributes_cleaned_input
            if slug_errors:
                slug_error_list = ", ".join(slug_errors)
                detail_slug_errors.append(f"{detail_code}: {slug_error_list}")
            if value_errors:
                value_error_list = ", ".join(value_errors)
                detail_value_errors.append(f"{detail_code}: {value_error_list}")

        if len(detail_slug_errors) > 0:
            error_msg = "속성 slug 오류 제품코드: {}".format(", ".join(detail_slug_errors))
            raise ValidationError(error_msg)
        if len(detail_value_errors) > 0:
            error_msg = "속성 값 오류 제품코드: {}".format(", ".join(detail_value_errors))
            raise ValidationError(error_msg)

    @classmethod
    def validate_fulfilled_by_vendor(
        cls,
        is_fulfilled_by_vendor: bool,
        product_variant_dict: Dict[str, ProductVariantModel],
        details,
    ):
        brand_product_variant_dict = {}
        if is_fulfilled_by_vendor:
            errors = []
            bpv_update_input_errors = []
            bpv_code_errors = []
            for detail in details:
                sku = detail.get("product_sku")
                detail_code = cls.make_detail_code(detail)
                product_variant = product_variant_dict[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor == False:
                    errors.append(detail_code)
                bpv_update_input = detail.get("bpv_update_input")
                if not bpv_update_input:
                    bpv_update_input_errors.append(detail_code)
                else:
                    brand_code = bpv_update_input.get("brand_code")
                    if not brand_code:
                        bpv_update_input_errors.append(detail_code)
                    else:
                        bpv = (
                            models.BrandProductVariant.objects.filter(
                                brand__code=brand_code, product_variant=product_variant
                            )
                            .select_related("brand_product")
                            .first()
                        )
                        if not bpv:
                            bpv_code_errors.append(detail_code)
                        else:
                            brand_product_variant_dict[sku] = bpv

            if errors:
                error_msg = (
                    "직거래 상품 일괄 수정에서 보스 제품 수정 시도 오류 제품코드: {}".format(
                        ", ".join(errors)
                    )
                )
                raise ValidationError(error_msg)
            if bpv_update_input_errors:
                error_msg = "직거래 상품 일괄 수정 시 브랜드 코드 정보가 있어야 합니다. 제품코드: {}".format(
                    ", ".join(bpv_update_input_errors)
                )
                raise ValidationError(error_msg)
            if bpv_code_errors:
                error_msg = "직거래 상품 일괄 수정 시 브랜드 코드 - 제품 코드 관계가 잘못되어 있습니다. 제품코드: {}".format(
                    ", ".join(bpv_code_errors)
                )
                raise ValidationError(error_msg)
        else:
            errors = []
            for detail in details:
                sku = detail.get("product_sku")
                product_variant = product_variant_dict[sku]
                product = product_variant.product
                if product.is_fulfilled_by_vendor:
                    detail_code = cls.make_detail_code(detail)
                    errors.append(detail_code)

            if errors:
                error_msg = (
                    "보스 제품 일괄 수정에서 직거래 상품 수정 시도 오류 제품코드: {}".format(
                        ", ".join(errors)
                    )
                )
                raise ValidationError(error_msg)
        return brand_product_variant_dict

    @classmethod
    def clean_details(cls, info, input_data, is_fulfilled_by_vendor: bool):
        details = input_data.get("details")
        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        cls.validate_value_empty(details)

        _, product_variant_dict, _ = validate_product_sku(details)
        makers = validate_maker(cls, details, required=False)
        brand_product_variant_dict = cls.validate_fulfilled_by_vendor(
            is_fulfilled_by_vendor, product_variant_dict, details
        )

        if is_fulfilled_by_vendor == False:
            cls.validate_track_inventory(details, product_variant_dict)
            cls.validate_can_sale_by_inner(details, product_variant_dict)
        cls.clean_attributes(details, product_variant_dict)

        return details, product_variant_dict, makers, brand_product_variant_dict

    @classmethod
    def update_product_pv_bp_and_bpv(
        cls,
        details,
        product_variant_dict: Dict[str, ProductVariantModel],
        makers: Dict[str, Maker],
        brand_product_variant_dict: Dict[str, BrandProductVariantModel],
