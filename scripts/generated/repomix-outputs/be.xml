    sales_ids = graphene.List(graphene.ID, required=True, description="B2B 매출마감 대상 sales ids")


class SalesB2bClose(BaseMutation):
    class Arguments:
        input = SalesB2bCloseInput(required=True)

    class Meta:
        description = "B2B 매출 마감"
        error_type_class = StatsError
        error_type_field = "stats_errors"

    @classmethod
    def validate_sales_data(cls, brand: BrandModel, sales_close_date, sales_list: List[SalesModel]):
        b2b_sales_qs = StatsBrandQueries.sales_qs_exclude_canceled()
        b2b_sales_qs = b2b_sales_qs.filter(order_type__in=ORDER_TYPES_FOR_B2B)
        b2b_sales_qs = b2b_sales_qs.filter(
            brand=brand,
            sales_close_date=sales_close_date,
        ).values_list("id", "order_type")
        data_pairs = list(b2b_sales_qs)
        db_ids = {id for id, _ in data_pairs}
        input_ids = {s.id for s in sales_list}
        missing = input_ids - db_ids
        if len(missing) > 0:
            raise ValidationError(f"마감 매출 데이터가 일치하지 않습니다. 누락: {missing}")

        order_types_set = {order_type for _, order_type in data_pairs}
        if not order_types_set.issubset(ORDER_TYPES_FOR_B2B):
            raise ValidationError(
                "b2b 매출이 아닌 데이터에 대해서 b2b 매출 마감 처리를 할 수 없습니다."
            )

    @classmethod
    def set_b2b_status_to_closed(cls, brand: BrandModel, sales_close_date):
        b2b_sales_qs = StatsBrandQueries.sales_qs_exclude_canceled()
        b2b_sales_qs = b2b_sales_qs.filter(order_type__in=ORDER_TYPES_FOR_B2B)
        b2b_sales_qs.filter(
            brand=brand,
            sales_close_date=sales_close_date,
        ).update(b2b_status=SalesB2bStatus.CLOSED)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        brand_id = input_data.get("brand")
        sales_close_date = input_data.get("sales_close_date")
        sales_ids = input_data.get("sales_ids")
        brand = cls.get_node_or_error(info, brand_id, only_type=Brand)
        sales_list = cls.get_nodes_or_error(sales_ids, "id", Sales)
        cls.validate_sales_data(brand, sales_close_date, sales_list)

        cls.set_b2b_status_to_closed(brand, sales_close_date)
        send_email_sales_b2b_close_to_riu(sales_close_date, sales_list)
        create_tax_invoices_on_close_b2b_sales(sales_close_date, sales_list)
        return SalesB2bClose()


