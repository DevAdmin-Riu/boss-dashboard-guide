    @staticmethod
    def sales_qs_for_brands_order_stats(is_fulfilled_by_vendor, stat_date, mode, ids):
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        # 보스 장터용 매출 데이터는 제외
        qs = qs.exclude(brand__is_boss_market=True)
        # 본부수익금 정산 모드인 경우 brand 계약 타입이 수익배분, 공급수수료 방식만 필터
        if is_fulfilled_by_vendor == False:
            qs = qs.filter(
                brand__contract_type__in=[BrandContractType.MILEAGE, BrandContractType.FEE]
            )
        if ids:
            qs = StatsBrandQueries.filter_sales_brand_ids(qs, ids)
        qs = StatsBrandQueries.filter_sales_evented_at_range(qs, stat_date)
        qs = StatsBrandQueries.filter_sales_is_fulfilled_by_vendor(qs, is_fulfilled_by_vendor)

        trunc_func = StatsBrandQueries.get_trunc_function(mode)
        qs = StatsBrandQueries.calculate_order_stats(qs, trunc_func, group_by_field="brand_id")

        # 본부수익금 정산모드에서만 stat_mileage_exclude_vat이 0이 아닌 항목만 필터링 (DB 레벨)
        if is_fulfilled_by_vendor == False:
            qs = qs.exclude(stat_mileage_exclude_vat=0)

        return qs

    @staticmethod
    def sales_qs_exclude_canceled():
        order_status_filter = ~Q(order__status=OrderStatus.CANCELED)
        order_line_b2b_status_filter = ~Q(order_line__b2b_status=OrderLineB2bStatus.CANCELED)
        sales_b2b_status_filter = ~Q(b2b_status=SalesB2bStatus.CANCELED)
        qs = (
            Sales.objects.filter(order_status_filter)
            .filter(order_line_b2b_status_filter)
            .filter(sales_b2b_status_filter)
        )
        return qs

