class ProductsQueryset(UserAccessQuerySet):
    def exlude_stopped_variants(self):
        return self.filter(variants__isnull=False).exclude(
            variants__sales_status=SalesStatus.STOPPED
        )

    def filter_displayed_in_stores(self, qs, user, filters):
        qs = qs.filter(filters)
        brand_store = user.brand_store
        # 매장이 없으면 가맹본부이므로 매장-상품 진열관계 무시하고 노출
        if not brand_store:
            return qs.distinct()
        bpv_displayed_in_store = BrandStoreDisplay.objects.filter(
            bpv=OuterRef("brand_products__brand_product_variants__pk"),
            brand_store=brand_store,
        )
        bpv_displayed_anywhere = BrandStoreDisplay.objects.filter(
            bpv=OuterRef("brand_products__brand_product_variants__pk")
        )
        qs = qs.annotate(
            has_display_in_store=Exists(bpv_displayed_in_store),
            has_any_display=Exists(bpv_displayed_anywhere),
        )
        # 해당 매장에 진열되었거나, 진열된 매장이 없는 상품만
        qs = qs.filter(Q(has_display_in_store=True) | Q(has_any_display=False)).distinct()
        return qs

    def inner_visible_to_user(self, user):
        can_sale_by_inner_filter = (
            Q(variants__isnull=False)
            & Q(variants__outer__isnull=False)
            & Q(variants__can_sale_by_inner=True)
        )
        if self.user_has_access_to_all(user):
            return self.filter(can_sale_by_inner_filter)

        if user.is_anonymous or not user.is_brand_user:
            return self.none()

        qs: models.QuerySet = self
        is_hq_staff_from_dashboard = self.is_hq_staff_from_dashboard(user)
        if is_hq_staff_from_dashboard:
            brand_filter = Q(brand_products__brand_id=user.brand_id)
            return qs.filter(brand_filter).distinct()

        # 이 brand_filter 는 보스장터/보스몰 전환 시에만 사용하므로 switched_brand_id 만 필터되어야 함
        brand_filter = Q(brand_products__brand_id=user.switched_brand_id)
        force_no_normal_display_filter = Q(
            brand_products__brand_product_variants__force_no_normal_display=False
        )

        def visible_inner_variant_filter():
            price_filter = Q(
                brand_products__brand_product_variants__price_amount__isnull=False,
                brand_products__brand_product_variants__cost_price_exclude_vat__isnull=False,
                brand_products__brand_product_variants__delivery_fee_amount__isnull=False,
            )
            can_sale_by_bpv_inner_filter = (
                Q(brand_products__brand_product_variants__product_variant__isnull=False)
                & Q(brand_products__brand_product_variants__product_variant__outer__isnull=False)
                & Q(brand_products__brand_product_variants__product_variant__can_sale_by_inner=True)
            )
            sales_status_filter = Q(
                brand_products__brand_product_variants__sales_status__in=[
                    SalesStatus.ON_SALE,
                    SalesStatus.WILL_BE_STOPPED,
                ]
            )
            return can_sale_by_bpv_inner_filter & price_filter & sales_status_filter

        filters = brand_filter & force_no_normal_display_filter & visible_inner_variant_filter()
        return self.filter_displayed_in_stores(qs, user, filters)

    def outer_visible_to_user(self, user):
        from ..vendor.models import FbvDeliveryCondition

        outer_filter = Q(variants__isnull=False) & Q(variants__outer__isnull=True)
        if self.user_has_access_to_all(user):
