logger = logging.getLogger()


def send_sweet_tracker_request(sweet_tracker_config, code, number):
    tracking_info_request_url = sweet_tracker_config.tracking_info_url
    tracker_api_key = sweet_tracker_config.api_key

    url_format = "{request_url}?t_key={key}&t_code={code}&t_invoice={number}"
    target_url = url_format.format(
        request_url=tracking_info_request_url, key=tracker_api_key, code=code, number=number
    )
    # logger.info(f"send_sweet_tracker_request target_url: {target_url}")
    response = requests.get(target_url)
    response.raise_for_status()
    return response.json()


def check_tracking_fulfillment(sweet_tracker_config, fulfillment: Fulfillment):
    response = None
    tracking_number = fulfillment.tracking_number
    try:
        courier: Courier = fulfillment.courier

        tracking_number_numeric_only = remove_all_non_numeric(tracking_number)
        if check_courier_digit_allowed_values(tracking_number_numeric_only, courier) == False:
            logger.error(
                f"invalid tracking_number: {tracking_number_numeric_only} / digit_allowed_values: {courier.digit_allowed_values} / code: {courier.code}"
            )
            return

        response = send_sweet_tracker_request(
            sweet_tracker_config, courier.code, tracking_number_numeric_only
        )
        completeYN = response.get("completeYN", None)
        if completeYN is None:
            logger.error(f"response: {response}")
        else:
            if completeYN == "Y":
                fulfillment_tracking_completed(fulfillment, None, True, "sweettracker 조회")
    except Exception as e:
        logger.error(f"{e}: exception - {courier.name} {courier.code} {tracking_number}")


def check_tracking_completed_of_direct_shipping():
    target_date = kst_timezone_date()
    target_fulfillments = (
        Fulfillment.objects.exclude(
            status__in=[FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
        )
        .exclude(order__status=OrderStatus.CANCELED)
        .exclude(tracking_number__exact="")
        .filter(tracking_number_type=TrackingNumberType.DIRECT_SHIPPING)
        .filter(is_tracking_completed=False, order__delivery_request_date__lt=target_date)
    )

    logger.info(
        f"check_tracking_completed_of_direct_shipping target_fulfillments count: {len(target_fulfillments)}"
    )
    for fulfillment in target_fulfillments:
        fulfillment_tracking_completed(fulfillment, None, True, "직배송 주문 도착일 경과")


@app.task(name="order.tasks.check_tracking_completed")
def check_tracking_completed():
    try:
        check_tracking_completed_of_direct_shipping()
    except Exception as e:
        logger.error(f"check_tracking_completed_of_direct_shipping exception: {e}")
        pass

    sweet_tracker_config = get_plugins_manager().get_sweet_tracker_plugin_config()
    tracker_api_key = sweet_tracker_config.api_key
    max_days = sweet_tracker_config.max_days

    if tracker_api_key is None or tracker_api_key == "":
        logger.error("tracker_api_key is not set.")
        return
    else:
        logger.info(f"tracker_api_key: {tracker_api_key}")

    today = timezone.now()
    max_target_date = today - timedelta(days=1)
    min_target_date = today - timedelta(days=max_days)
    target_fulfillments_qs = (
        Fulfillment.objects.exclude(
            status__in=[FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
        )
        .exclude(order__status=OrderStatus.CANCELED)
        .exclude(
            tracking_number_type__in=[TrackingNumberType.DIRECT_SHIPPING, TrackingNumberType.ETC]
        )
        .exclude(tracking_number__exact="")
        .exclude(created__lt=min_target_date)
        .filter(is_tracking_completed=False, created__lt=max_target_date)
        .exclude(courier__can_trace=False)
    )
    target_fulfillments = list(target_fulfillments_qs)
    logger.info(f"check_tracking_completed target_fulfillments count: {len(target_fulfillments)}")

    exception_count = 0
    for fulfillment in target_fulfillments:
        try:
            check_tracking_fulfillment(sweet_tracker_config, fulfillment)
        except Exception as e:
            exception_count = exception_count + 1
            logger.error(f"check_tracking_completed error: {e}")

    if exception_count > 0:
        logger.error(f"check_tracking_completed exception_count: {exception_count}")


def _get_inicis_vact_date_time_by_payment(payment: Payment):
    transaction = payment.get_last_transaction(TransactionKind.ACTION_TO_CONFIRM)
    if transaction is None:
        logger.error(f"check_cancel_order transaction not found: {payment.id}")
        return None

    gateway_response = transaction.gateway_response
    if gateway_response is None:
        logger.error(
            f"check_cancel_order transaction is invalid: {payment.id} / {transaction.id}:gateway_response={gateway_response}"
        )
        return None

    pay_method = gateway_response.get(INICIS_PAY_METHOD, None)
    if pay_method is None or not is_vbank_pay(pay_method):
        logger.error(
            f"check_cancel_order transaction is invalid: {payment.id} / {transaction.id}:pay_method={pay_method}"
        )
        return None

    # 시간은 제외하고 날짜만 %Y-%m-%d 형식으로 가져옴
    vact_date = get_inicis_vact_date(gateway_response, include_vact_time=False)
    if vact_date is None:
        logger.error(
            f"check_cancel_order transaction is invalid: {payment.id} / {transaction.id}:vact_date={vact_date}"
        )
        return None

    #  astimezone: settings.py 의 TIME_ZONE 설정(Asiz/Seoul) timezone 으로 변환
    vact_date_datetime = datetime.datetime.strptime(vact_date, "%Y-%m-%d").astimezone()
    if vact_date_datetime is None:
        logger.error(
            f"check_cancel_order transaction is invalid: {payment.id} / {transaction.id}:vact_date={vact_date}"
        )
        return None

    return vact_date_datetime


def _get_toss_vact_date_time_by_payment(payment: Payment):
