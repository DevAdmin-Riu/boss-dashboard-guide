class AssignSubPvToMainPv(BaseMutation):
    main_pv = graphene.Field(ProductVariant, description="mutation 실행 후 리턴할 main_pv")

    class Arguments:
        input = AssignSubPvToMainPvInput(required=True)

    class Meta:
        description = "Assign main_pv to sub_pv"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        sub_pv_id = input_data.get("sub_pv_id")
        main_pv_id = input_data.get("main_pv_id")
        manage_event = input_data.get("manage_event")
        sub_pv = cls.get_node_or_error(info, sub_pv_id, field="sub_pv_id", only_type=ProductVariant)
        main_pv = cls.get_node_or_error(
            info, main_pv_id, field="main_pv_id", only_type=ProductVariant
        )
        before_main_pv = deepcopy(main_pv)
        before_sub_pv = deepcopy(sub_pv)
        _, before_main_pv_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_main_pv
        )
        _, before_sub_pv_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_sub_pv
        )

        BulkAssignMainPvsToSubPv.validate_sub_pv(sub_pv)
        BulkAssignMainPvsToSubPv.validate_main_pvs([main_pv])

        models.SubProductVariantRelation.objects.filter(main_pv=main_pv).delete()
        models.SubProductVariantRelation.objects.create(sub_pv=sub_pv, main_pv=main_pv)
        if manage_event:
            _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                before_variant=before_sub_pv,
                before_inner_variant=None,
                before_product=None,
                before_product_m2m_and_related_values=None,
                before_variant_m2m_and_related_values=before_sub_pv_m2m_and_related_values,
                updated_variant=sub_pv,
                updated_product=None,
            )
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=sub_pv, manage_event=manage_event, info=info)

            _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                before_variant=before_main_pv,
                before_inner_variant=None,
                before_product=None,
                before_product_m2m_and_related_values=None,
                before_variant_m2m_and_related_values=before_main_pv_m2m_and_related_values,
                updated_variant=main_pv,
                updated_product=None,
            )
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=main_pv, manage_event=manage_event, info=info)

        return AssignSubPvToMainPv(main_pv=main_pv)


class UnassignSubPvFromMainPvInput(graphene.InputObjectType):
    main_pv_id = graphene.Argument(graphene.ID, required=True, description="ID of a main_pv.")
    sub_pv_id = graphene.Argument(graphene.ID, required=True, description="ID of a sub_pv.")
    manage_event = ProductVariantManageEventInput(description="제품 관리 이력", required=True)


class UnassignSubPvFromMainPv(BaseMutation):
    main_pv = graphene.Field(ProductVariant, description="mutation 실행 후 리턴할 main_pv")

    class Arguments:
        input = UnassignSubPvFromMainPvInput(required=True)

    class Meta:
        description = "Unassign sub_pv from main_pv"
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        sub_pv_id = input_data.get("sub_pv_id")
        main_pv_id = input_data.get("main_pv_id")
        manage_event = input_data.get("manage_event")
        sub_pv = cls.get_node_or_error(info, sub_pv_id, field="sub_pv_id", only_type=ProductVariant)
        main_pv = cls.get_node_or_error(
            info, main_pv_id, field="main_pv_id", only_type=ProductVariant
        )
        before_main_pv = deepcopy(main_pv)
        before_sub_pv = deepcopy(sub_pv)
        _, before_main_pv_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_main_pv
        )
        _, before_sub_pv_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_sub_pv
        )

        models.SubProductVariantRelation.objects.filter(main_pv=main_pv).delete()

        if manage_event:
            _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                before_variant=before_sub_pv,
                before_inner_variant=None,
                before_product=None,
                before_product_m2m_and_related_values=None,
                before_variant_m2m_and_related_values=before_sub_pv_m2m_and_related_values,
                updated_variant=sub_pv,
                updated_product=None,
            )
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=sub_pv, manage_event=manage_event, info=info)

            _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
                before_variant=before_main_pv,
                before_inner_variant=None,
                before_product=None,
                before_product_m2m_and_related_values=None,
                before_variant_m2m_and_related_values=before_main_pv_m2m_and_related_values,
                updated_variant=main_pv,
                updated_product=None,
            )
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=main_pv, manage_event=manage_event, info=info)

        return UnassignSubPvFromMainPv(main_pv=main_pv)
