class DigitalContractCountEventCreate(ModelMutation):
    brand = graphene.Field(Brand, description="브랜드")

    class Meta:
        description = "전자계약 카운트 충전/차감 이벤트 생성"
        model = models.DigitalContractCountEvent
        error_type_class = PointsEventError
        error_type_field = "points_event_errors"

    class Arguments:
        brand_id = graphene.ID(required=True, description="브랜드ID")
        input = DigitalContractCountEventCreateInput(
            required=True, description="전자계약 카운트 충전/차감 생성 입력"
        )

    @staticmethod
    def clean_input(brand: BrandModel, input: DigitalContractCountEventCreateInput):
        if (
            input.type == DigitalContractCountEventType.DEDUCTION
            and brand.available_digital_contract_count < input.delta
        ):
            raise ValidationError(
                "전자계약 카운트 수동 차감 실패: 브랜드 전자계약 카운트가 부족합니다."
            )
        if (
            input.type == DigitalContractCountEventType.DIGITAL_CONTRACT_CREATED
            and not input.document_id
        ):
            raise ValidationError(
                "전자계약 문서 생성으로 이용횟수 차감시 문서 ID 정보가 필요합니다."
            )

        return input

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        brand: BrandModel = cls.get_node_or_error(info, data["brand_id"], only_type=Brand)
        cleaned_input = cls.clean_input(brand, data["input"])
        delta = cleaned_input.delta
        type = cleaned_input.type

        if delta is not None and delta > 0:
            if type == DigitalContractCountEventType.RECHARGE:
                description = f"관리자 충전: {cleaned_input.description}"
                brand.increase_available_digital_contract_count(
                    delta, type, description, from_user=info.context.user
                )
            elif type == DigitalContractCountEventType.DEDUCTION:
                description = f"관리자 수동차감: {cleaned_input.description}"
                brand.decrease_available_digital_contract_count(
                    delta, type, description, from_user=info.context.user
                )
            elif type == DigitalContractCountEventType.DIGITAL_CONTRACT_CREATED:
                description = f"전자계약 문서 생성: {cleaned_input.description}"
                document_id = cleaned_input.document_id
                brand.decrease_available_digital_contract_count(
                    delta,
                    type,
                    description,
                    from_user=info.context.user,
                    document_id=document_id,
                    allow_minus_decrease=True,
                )
            else:
                raise ValidationError(
                    f"전자계약 카운트 변경 실패: 허용하지 않는 이벤트 타입입니다. {type}"
                )

        return DigitalContractCountEventCreate(brand=brand)
