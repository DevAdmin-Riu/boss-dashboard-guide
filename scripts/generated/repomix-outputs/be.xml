        pk_fields = ["order__payments__pk"]
        qs = filter_pk_fields(qs, value, pk_fields)
        return qs

    # 발주서가 작성되지 않은 경우에는 기본 발주업체를 기준으로 필터링 purchaseVendorSearch
    # 발주서가 작성된 경우에는 발주서에 등록된 vendor를 기준으로 필터링
    def filter_purchase_vendor_search(qs, _, value):
        if value:
            prefix = VENDOR_CODE_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        default_variant_vendor_filter = (
                            Q(purchase_order_line__status=PurchaseOrderLineStatus.CANCELED)
                            | Q(purchase_order_line__isnull=True)
                        ) & Q(variant__default_variant_vendor__vendor_id=pk_value)
                        purchase_order_vendor_filter = (
                            ~Q(purchase_order_line__status=PurchaseOrderLineStatus.CANCELED)
                            & Q(purchase_order_line__isnull=False)
                        ) & Q(purchase_order_line__purchase_order__vendor_id=pk_value)
                        return qs.filter(
                            default_variant_vendor_filter | purchase_order_vendor_filter
                        ).distinct()
                    except:
                        raise ValidationError(f"협력업체코드 형식을 확인해 주세요. {value}")

            default_variant_vendor_filter = (
                Q(purchase_order_line__isnull=True)
                & make_query_objects_by_query_param(
                    qs, value, ["variant__default_variant_vendor__vendor__name"]
                )[1]
            )
            purchase_order_vendor_filter = (
                Q(purchase_order_line__isnull=False)
                & make_query_objects_by_query_param(
                    qs, value, ["purchase_order_line__purchase_order__vendor__name"]
                )[1]
            )
            return qs.filter(
                default_variant_vendor_filter | purchase_order_vendor_filter
            ).distinct()
        return qs

    # 직거래 상품 주문 상세에서 담당 협력사 검색용
    def filter_fulfill_vendor_search(qs, _, value):
        if value:
            prefix = VENDOR_CODE_PREFIX
            if value.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = value[prefix_length:]
                if pk_value:
                    try:
                        return qs.filter(vendor_id=pk_value)
                    except:
                        raise ValidationError(f"협력업체코드 형식을 확인해 주세요. {value}")

        search_fields = ["vendor__name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_purchase_order_search(qs, _, value):
        return filter_purchase_order_search_factory(
            field_name="purchase_order_line__purchase_order_id",
            field_name_for_sub_po="purchase_order_line__purchase_order_id",
            field_name_for_sub_sort_order="purchase_order_line__sort_order",
            is_it_for_sub=True,
        )(qs, _, value)

    def filter_brand_id(qs, _, value):
        if value:
            _, brand_pk = graphene.Node.from_global_id(value)
            qs = qs.filter(order__brand__id=brand_pk)
        return qs

    def filter_fulfill_vendor_id(qs, _, value):
        if value:
            _, vendor_pk = graphene.Node.from_global_id(value)
            qs = qs.filter(vendor_id=vendor_pk)
        return qs

    def filter_is_main_pv(qs, _, value):
