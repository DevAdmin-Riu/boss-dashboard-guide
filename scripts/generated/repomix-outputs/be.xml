from django.core.exceptions import ValidationError
from django.db.models import Q

from saleor.purchaseorder import PURCHASE_OREDER_CODE_PREFIX


def filter_purchase_order_search_factory(
    *,
    field_name="pk",
    field_name_for_sub_po=None,
    field_name_for_sub_sort_order=None,
    is_it_for_sub=False
):
    """
    발주서 검색 필터를 동적으로 생성하는 함수.

    :param is_it_for_sub:
    :param field_name_for_sub_sort_order:
    :param field_name_for_sub_po:
    :param field_name: str - 발주서 ID를 검색할 필드명 (기본값: "pk")
    :param field_name_for_sub: str | None - 발주서 상세 검색 시 사용할 필드명
    :return: 발주서 검색 필터 함수
    """

    def filter_purchase_order_search(qs, name, value):
        """
        발주서 번호 또는 발주 상세 번호를 검색하는 필터.

        :param qs: QuerySet - 검색할 QuerySet
        :param name: str - 필드명 (Django Filter에서 자동 전달, 사용 안 함)
        :param value: str - 검색 값 (예: "PO1234", "PO1234-1", 여러 개의 값)
        :return: QuerySet - 필터링된 결과
        """
        if not value:
            return qs

        prefix = PURCHASE_OREDER_CODE_PREFIX
        value = value.strip()

        # 여러 개의 값이 입력된 경우 ('\n' 포함된 경우)
        query_values = [v.strip() for v in value.split("\n") if v.strip()]
        query_objects = Q()

        for query in query_values:
            # 발주서 코드 검색 (접두사 확인)
            if query.startswith(prefix):
                prefix_length = len(prefix)
                pk_value = query[prefix_length:].strip()  # 접두사 제거 후 검색

                if not pk_value:
                    raise ValidationError(f"발주번호 형식을 확인해 주세요. {query}")

                try:
                    splits = pk_value.split("-")
                    purchase_order_id = splits[0]
                    splits_count = len(splits)

                    if splits_count == 1:
                        query_objects |= Q(**{field_name: purchase_order_id})

                    elif splits_count == 2 and is_it_for_sub:
                        sub_id = int(splits[1])

                        if field_name_for_sub_po:
                            query_objects |= Q(
                                **{
                                    field_name_for_sub_po: purchase_order_id,
                                    field_name_for_sub_sort_order: sub_id,
                                }
                            )
                        else:
                            query_objects |= Q(
                                purchase_order_id=purchase_order_id,
                                sort_order=sub_id,
                            )
                    # 위의 조건들을 만족하지 못해도 error 처리.
                    else:
                        raise ValidationError(
                            f"발주서번호 또는 발주상세번호 형식을 확인해 주세요. {query}"
                        )
                except ValueError:
                    raise ValidationError(
                        f"발주서번호 또는 발주상세번호 형식을 확인해 주세요. {query}"
                    )

            else:
                raise ValidationError(f"발주번호 형식을 확인해 주세요. {query}")

        return qs.filter(query_objects).distinct()

    return filter_purchase_order_search
