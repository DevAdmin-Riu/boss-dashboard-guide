    def resolve_remain_outer_virtual_allocate(root: OrderLineModel, info):
        def get_outer_virtual_allocation(allocations, outer_variant_id):
            # outer_variant_id에 해당하는 할당 객체를 찾고, StockByIdLoader를 이용해 stock을 가져옴
            stock_ids = [allocation.stock_id for allocation in allocations]

            def fetch_stocks(stocks):
                for allocation, stock in zip(allocations, stocks):
                    if stock and stock.product_variant_id == outer_variant_id:
                        return allocation.quantity_virtual_allocated
                return 0

            return StockByIdLoader(info.context).load_many(stock_ids).then(fetch_stocks)

        def load_outer_variant(inner_variant):
            if inner_variant.outer_id is None:
                return 0
            return (
                ProductVariantByIdLoader(info.context)
                .load(inner_variant.outer_id)
                .then(lambda outer_variant: load_allocations(root, outer_variant.id))
            )

        def load_allocations(order_line, outer_variant_id):
            return (
                AllocationsByOrderLineIdLoader(info.context)
                .load(order_line.id)
                .then(
                    lambda allocations: get_outer_virtual_allocation(allocations, outer_variant_id)
                )
            )

        if root.variant_id:
            return (
                ProductVariantByIdLoader(info.context)
                .load(root.variant_id)
                .then(load_outer_variant)
            )
        return 0

