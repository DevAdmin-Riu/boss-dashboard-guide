        order: Order = order_line.order
        order_map[order.id] = order
        fulfillment_lines: List[FulfillmentLine] = order_line.fulfillment_lines.all()
        for fulfillment_line in fulfillment_lines:
            fulfillment = fulfillment_line.fulfillment
            fulfillment.tracking_number = ""
            fulfillment.etc_delivery_man_info = {}
            fulfillment_map[fulfillment_line.fulfillment.id] = fulfillment_line.fulfillment
    fulfillment_list = list(fulfillment_map.values())
    if fulfillment_list:
        Fulfillment.objects.bulk_update(
            fulfillment_list, ["tracking_number", "etc_delivery_man_info"]
        )
    orders = list(order_map.values())
    if orders:
        order_events = []
        for order in orders:
            filtered_order_lines: List[OrderLine] = [
                po_line.order_line
                for po_line in po_lines
                if po_line.order_line.order_id == order.pk
            ]
            order_event = OrderEvent(
                order=order,
                type=OrderEvents.REVERT_TRACKING_UPDATED,
                user=user,
                parameters={
                    "message": ", ".join(
                        [line.composed_id_with_prefix for line in filtered_order_lines]
                    )
                },
            )
            order_events.append(order_event)
        OrderEvent.objects.bulk_create(order_events)


def revert_consignment_po_to_dispatch_fulfillment(user, po_lines: List[PurchaseOrderLine]):
