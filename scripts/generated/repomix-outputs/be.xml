def update_or_create_picking_line(
    picking_order_fulfillments: List["Fulfillment"],
    update_only: bool = False,
):
    from ..warehouse.models import BatchPicking, PickingLine

    create_list: List["Fulfillment"] = []
    update_list: List["Fulfillment"] = []
    for fulfillment in picking_order_fulfillments:
        is_exist_picking_line = fulfillment.lines.filter(picking_line__isnull=False).exists()
        if is_exist_picking_line:
            update_list.append(fulfillment)
        elif update_only == False:
            create_list.append(fulfillment)

    if update_list:
        for fulfillment in update_list:
            PickingLine.objects.filter(fulfillment_line__fulfillment=fulfillment).update(
                tracking_number=fulfillment.tracking_number
            )

    if create_list:
        all_fulfillment_lines = []
        create_picking_lines = []
        goodsflow_plugin_config = get_plugins_manager().get_plugin_config_dot_map(
            GOODSFLOW_PLUGIN_ID
        )
        for fulfillment in create_list:
            batch_picking: BatchPicking = fulfillment.batch_picking
            batch_code = batch_picking.code
            fulfillment_lines_qs: List["FulfillmentLine"] = fulfillment.lines.select_related(
                "order_line",
                "order_line__variant",
                "order_line__order",
                "order_line__order__shipping_address",
                "order_line__order__user",
                "order_line__order__user__brand",
            ).prefetch_related(
                "stock_detail_lines",
                "stock_detail_lines__rack_location",
            )

            fulfillment_lines: List["FulfillmentLine"] = list(fulfillment_lines_qs)
            all_fulfillment_lines.extend(fulfillment_lines)
            for fulfillment_line in fulfillment_lines:
                location = None
                stock_detail_lines: List[StockDetailLine] = (
                    fulfillment_line.stock_detail_lines.all()
                )
                for stock_detail_line in stock_detail_lines:
                    rack_location: RackLocation = stock_detail_line.rack_location
                    if rack_location:
                        location = rack_location.name
                        break
                if location is None:
                    raise ValidationError(
                        f"로케이션 정보가 없는 상태로 출고되어서 합포장 피킹 정보를 생성할 수 없습니다. {fulfillment.composed_id_with_prefix} / fulfillment_line_id={fulfillment_line.id}"
                    )
                order_line: "OrderLine" = fulfillment_line.order_line
                variant: "ProductVariant" = order_line.variant
                order: "Order" = order_line.order
                invoicer_biz_reg_info = get_invoicer_biz_reg_info_by_brand(order.brand)
                invoicee_user: "User" = order.user
                receiver_address = order.shipping_address
                attribute_data = convert_to_simple_attribute(variant)
                rcv_tel = (
                    format_as_numeric_only_phone_number(receiver_address.phone)
                    if receiver_address
                    else ""
                )
                picking_line = PickingLine(
