import logging

from django.conf import settings
from popbill import AccountCheckService, PopbillException

from ...core import ServerModeEnum
from ...core.utils.server_mode import is_local_server_mode
from ..manager import get_plugins_manager
from ..taxinvoicing.define import POPBILL_PLUGIN_ID
from ..taxinvoicing.utils import convert_to_popbill_bank_code

logger = logging.getLogger(__name__)


def getAccountCheckService(plugin_config):
    # config/settings.py 작성한 LinkID, SecretKey를 이용해 AccountCheckService 객체 생성
    accountCheckService = AccountCheckService(plugin_config.LinkID, plugin_config.SecretKey)

    # 연동환경 설정값, 개발용(True), 상업용(False)
    accountCheckService.IsTest = not plugin_config.is_prod_mode

    # 인증토큰 IP제한기능 사용여부, 권장(True)
    accountCheckService.IPRestrictOnOff = True

    # 팝빌 API 서비스 고정 IP 사용여부, true-사용, false-미사용, 기본값(false)
    accountCheckService.UseStaticIP = False

    # 로컬시스템 시간 사용여부, 권장(True)
    accountCheckService.UseLocalTimeYN = True

    return accountCheckService


def get_account_name(bank_code: str, account_number):
    try:
        plugin_config = get_plugins_manager().get_plugin_config_dot_map(POPBILL_PLUGIN_ID)
        if plugin_config.is_prod_mode == False:
            server_mode_str = settings.SERVER_MODE
            server_mode_enum = ServerModeEnum(server_mode_str)
            if is_local_server_mode(server_mode_enum):
                logger.info(
                    f"local test mode 에서는 popbill account api test 모드 작동 안되어, 테스트를 건너뜁"
                )
                return True

        CorpNum = plugin_config.CorpNum
        popbill_bank_code = convert_to_popbill_bank_code(bank_code)
        if not popbill_bank_code:
            logger.error(
                f"Popbill account Api - check_account_info def Err : bank_code is not valid"
            )
            return False

        response = getAccountCheckService(plugin_config).checkAccountInfo(
            CorpNum=CorpNum, BankCode=popbill_bank_code, AccountNumber=account_number
        )
        return response.accountName
    except PopbillException as PE:
        logger.error(f"Popbill account Api - get_account_name def Err : {PE}")
        return False
    except Exception as e:
        logger.error(f"Popbill account Api - get_account_name def Err : {e}")
        return False
