    #     plugin_manager_promise = PluginManagerLoader(info.context).load(1)

    #     return Promise.all([lines_promise, plugin_manager_promise]).then(calculate_total_price)

    @staticmethod
    def resolve_subtotal_brand_cost_price(root: models.Checkout, info):
        def calculate_subtotal_brand_cost_price(data):
            lines, plugin_manager = data
            taxed_total = calculations.checkout_subtotal_brand_cost(
                checkout=root, lines=lines, plugin_manager=plugin_manager
            )
            return max(taxed_total, zero_taxed_money())

        lines_promise = CheckoutLinesByCheckoutTokenLoader(info.context).load(root.token)
        plugin_manager_promise = PluginManagerLoader(info.context).load(1)

        return Promise.all([lines_promise, plugin_manager_promise]).then(
            calculate_subtotal_brand_cost_price
        )

    @staticmethod
    def resolve_subtotal_price(root: models.Checkout, info):
        def calculate_subtotal_price(data):
            lines, plugin_manager = data
            return calculations.checkout_subtotal(
                checkout=root, lines=lines, plugin_manager=plugin_manager
            )

        lines_promise = CheckoutLinesByCheckoutTokenLoader(info.context).load(root.token)
        plugin_manager_promise = PluginManagerLoader(info.context).load(1)

        return Promise.all([lines_promise, plugin_manager_promise]).then(calculate_subtotal_price)

    @staticmethod
    def resolve_lines(root: models.Checkout, info, *_args):
        return CheckoutLinesByCheckoutTokenLoader(info.context).load(root.token)

    @staticmethod
    def resolve_available_payment_gateways(root: models.Checkout, info):
