    )
    configJsonDotMap.secret_key = (
        configJsonDotMap.secret_key if is_prod_mode else configJsonDotMap.dev_secret_key
    )
    configJsonDotMap.bp_client_key = (
        configJsonDotMap.bp_client_key if is_prod_mode else configJsonDotMap.dev_client_key
    )
    configJsonDotMap.bp_secret_key = (
        configJsonDotMap.bp_secret_key if is_prod_mode else configJsonDotMap.dev_secret_key
    )
    return DotMap(configJsonDotMap)


def get_toss_plugin_configs(gateway_config: "GatewayConfig"):
    configJsonDotMap = DotMap(gateway_config.connection_params)
    return adjust_toss_plugin_configs_by_prod_mode(configJsonDotMap)


# PG 종류에 상관없이 입금기한 경과 로직 처리를 위해 출력 포맷은 %Y-%m-%d 으로 통일
# PG 사 입금 기한이 23:59:00 (이니시스 모바일), 그외 23:59:59 (이니시스 PC, 토스) 로 처리된 것 확인 용도록 테스트 서버에서만 시:분:초 포함되어 출력
def get_toss_vact_date(gateway_response, include_vact_time):
    virtual_account = gateway_response.get(TOSS_VIRTUAL_ACCOUNT, {})
    vact_date_time_iso_format = virtual_account.get(TOSS_VIRTUAL_ACCOUNT_DUE_DATE, None)
    if not vact_date_time_iso_format:
        return None
    vact_date_time = datetime.fromisoformat(vact_date_time_iso_format)
    if include_vact_time:
        vact_date = vact_date_time.strftime("%Y-%m-%d %H:%M:%S")
    else:
        vact_date = vact_date_time.strftime("%Y-%m-%d")
    return vact_date


def _get_toss_vact_bank_code_and_name(gateway_response):
    virtual_account = gateway_response.get(TOSS_VIRTUAL_ACCOUNT, {})
    bank_code = virtual_account.get(TOSS_VIRTUAL_ACCOUNT_BANK_CODE, None)
    bank_name = get_toss_bank_name_by_code(bank_code)
    return bank_code, bank_name


def _get_toss_vact_name(plugin_configs):
    return plugin_configs.vbank_name


def _get_toss_vact_num(gateway_response):
    virtual_account = gateway_response.get(TOSS_VIRTUAL_ACCOUNT, {})
    return virtual_account.get(TOSS_VIRTUAL_ACCOUNT_ACCOUNT_NUMBER, None)


def _get_toss_vact_amount(gateway_response):
    return gateway_response.get(TOSS_TOTAL_AMOUNT, None)


def get_toss_vact_info(gateway_response, include_vact_time, plugin_configs) -> "VactInfo":
    from ....graphql.payment.types import VactInfo

    vact_bank_code, vact_bank_name = _get_toss_vact_bank_code_and_name(gateway_response)
    vact_num = _get_toss_vact_num(gateway_response)
    vact_name = _get_toss_vact_name(plugin_configs)
    vact_date = get_toss_vact_date(gateway_response, include_vact_time)
    vact_amount = _get_toss_vact_amount(gateway_response)
    return VactInfo(
        vact_bank_code=vact_bank_code,
        vact_bank_name=vact_bank_name,
        vact_num=vact_num,
        vact_name=vact_name,
        vact_date=vact_date,
        vact_amount=vact_amount,
    )


def get_toss_receipt_url(gateway_response):
    receipt = gateway_response.get(TOSS_RECEIPT, {})
    receipt_url = receipt.get("url", None)
    if not receipt_url:
        return None
    return receipt_url


def _get_toss_vbank_captured_date(payment_id: int, gateway_response):
    fn_name = _get_toss_vbank_captured_date.__name__
    if gateway_response is None:
        logger.error(f"=== (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
        return None
    try:
        vbank_noti_created_at = gateway_response.get(TOSS_VBANK_NOTI_CREATED_AT)
        return datetime.fromisoformat(vbank_noti_created_at).astimezone()
    except:
        logger.error(f"==+ (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
    return None


def _get_toss_card_captured_date(payment_id: int, gateway_response):
    fn_name = _get_toss_card_captured_date.__name__
    if gateway_response is None:
        logger.error(f"=== (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
        return None

    try:
        approved_at = gateway_response.get(TOSS_APPROVED_AT)
        return datetime.fromisoformat(approved_at)
    except:
        logger.error(f"==+ (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
    return None


def get_toss_payment_key(payment_id: int, gateway_response):
    fn_name = get_toss_payment_key.__name__
    if gateway_response is None:
        logger.error(f"=== (INVALID) {fn_name} {payment_id}: gateway_response={gateway_response}")
        return None

    return gateway_response.get(TOSS_PAYMENT_KEY)


def get_toss_captured_date(payment: "Payment", captured_transaction: "Transaction"):
    """
    gateway_response 구조에서 결제일을 못 찾는 경우 captured_transaction 생성일 사용
    """

    payment_id = payment.id
    gateway_response = captured_transaction.gateway_response
    if payment.is_vbank_pay():
        gateway_captured_date = _get_toss_vbank_captured_date(payment_id, gateway_response)
    else:
        gateway_captured_date = _get_toss_card_captured_date(payment_id, gateway_response)

    if gateway_captured_date is None:
        gateway_captured_date = captured_transaction.created

    return gateway_captured_date


def get_toss_api_headers(is_toss_riu_pay, plugin_configs, idempotent_key=None):
    secret_key = plugin_configs.bp_secret_key if is_toss_riu_pay else plugin_configs.secret_key
    encoded_key = base64.b64encode(f"{secret_key}:".encode("utf-8")).decode("utf-8")
    authorizations = f"Basic {encoded_key}"
    headers = {
        "Authorization": authorizations,
        "Content-Type": "application/json",
    }
    if idempotent_key:
        headers["Idempotency-Key"] = idempotent_key
    return headers


def call_toss_payment_confirm_api(
    is_toss_riu_pay, plugin_configs, toss_payment_key, toss_order_id, amount, customer_key
):
    gateway_response = None
    confirm_success = False
    system_failed_message = None
    try:
        headers = get_toss_api_headers(
            is_toss_riu_pay, plugin_configs, idempotent_key=str(uuid.uuid4())
        )
        obj = {"paymentKey": toss_payment_key, "orderId": toss_order_id, "amount": int(amount)}
        if is_toss_riu_pay:
            obj["customerKey"] = str(customer_key) if customer_key else ""
        url = TOSS_BRAND_PAY_CONFIRM_URL if is_toss_riu_pay else TOSS_PAYMENTS_CONFIRM_URL
        response = post_with_retries(url=url, headers=headers, json=obj)
        confirm_success = response.status_code == 200
        gateway_response = response.json()
        logger.info(
            f"payment_debug: call_toss_payment_confirm_api confirm_success={confirm_success} response.status_code={response.status_code} toss_payment_key={toss_payment_key} customer_key={customer_key} gateway_response={gateway_response}"
        )
    except Exception as e:
        logger.error(
            f"payment_debug: Error in call_toss_payment_confirm_api: confirm_success={confirm_success} {e}"
        )
        system_failed_message = (
            "토스 결제 승인 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다."
        )

    return confirm_success, gateway_response, system_failed_message


def call_toss_payment_cancel_api(
    is_toss_riu_pay,
    plugin_configs,
    toss_refund_data: Union["TossCardRefundData", "TossVbankRefundData"],
    is_refund_mode: bool,
):
    gateway_response = None
    cancel_success = False
    system_failed_message = None
    try:
        cancel_url = TOSS_PAYMENTS_CANCEL_URL.format(payment_key=toss_refund_data.payment_key)
        headers = get_toss_api_headers(
            is_toss_riu_pay, plugin_configs, idempotent_key=str(uuid.uuid4())
        )
        obj = {
            "cancelReason": toss_refund_data.refund_reason,
            "cancelAmount": toss_refund_data.refund_amount,
            "taxFreeAmount": toss_refund_data.refund_tax_free_amount,
        }
        if is_refund_mode:
            if is_vbank_pay(toss_refund_data.pg_refund_pay_method):
                pg_refund_bank_info = toss_refund_data.pg_refund_bank_info
                refund_receive_account = {
                    "bank": pg_refund_bank_info.bank_code,
                    "accountNumber": pg_refund_bank_info.account_number,
                    "holderName": pg_refund_bank_info.account_holder_name,
                }
                obj["refundReceiveAccount"] = refund_receive_account
        response = post_with_retries(url=cancel_url, headers=headers, json=obj)
        cancel_success = response.status_code == 200
        gateway_response = response.json()
        logger.info(
            f"payment_debug: call_toss_payment_cancel_api cancel_success={cancel_success} obj={obj} response.status_code={response.status_code}"
        )
    except Exception as e:
        logger.error(
            f"payment_debug: Error in call_toss_payment_cancel_api: cancel_success={cancel_success} {e}"
        )
        system_failed_message = (
            "토스 결제 취소 과정에서 오류가 발생해서 결제 취소가 정상적으로 처리되지 않았습니다."
        )

    return cancel_success, gateway_response, system_failed_message


def call_toss_brand_pay_access_token_api(plugin_configs, code, customer_key):
    fn_name = call_toss_brand_pay_access_token_api.__name__
    gateway_response = None
    is_success = False
    try:
        headers = get_toss_api_headers(True, plugin_configs, idempotent_key=str(uuid.uuid4()))
        obj = {"grantType": "AuthorizationCode", "customerKey": customer_key, "code": code}
        response = post_with_retries(url=TOSS_BRAND_PAY_ACCESS_TOKEN_URL, headers=headers, json=obj)
        is_success = response.status_code == 200
        gateway_response = response.json()
        logger.info(
            f"payment_debug: {fn_name} {customer_key} is_success={is_success} response.status_code={response.status_code} gateway_response={gateway_response}"
        )
    except Exception as e:
        logger.error(f"payment_debug: Error in {fn_name}: is_success={is_success} {e}")
    return is_success


def get_toss_error_code_and_message(gateway_response):
    error_code = gateway_response.get("code", None)
    error_message = gateway_response.get("message", None)
    return error_code, error_message


def get_toss_refunded_at(pg_refund_response: TossRefundResponse):
    return pg_refund_response.canceledAt


def make_toss_order_id(payment: "Payment"):
    return f"{TOSS_ORDER_ID_PREFIX}{str(payment.pk).zfill(7)}"


def get_payment_id_by_toss_order_id(toss_order_id: str):
    return int(toss_order_id.replace(TOSS_ORDER_ID_PREFIX, ""))
