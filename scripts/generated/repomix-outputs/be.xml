        description = "공지가 속한 브랜드의 매장들에게 알림톡을 전송함."
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        if context.user.is_staff:
            if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
                return True
            else:
                return False

        # 아래 퍼미션 체크는 가맹본부->매장 공지 기준으로 작성됨
        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        id = data["id"]
        _, notice_id = graphene.Node.from_global_id(id)
        notice = models.Notice.objects.get(pk=notice_id)
        if not (notice.owner_brand_id == brand_id and is_active and is_hq_staff):
            raise PermissionDenied(user=context.user, cls=cls)
        return True

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        id = data.get("id")
        notice: NoticeModel = cls.get_node_or_error(
            info,
            id,
            only_type=Notice,
        )

        owner_brand = notice.owner_brand
        if not owner_brand:
            raise ValidationError("가맹본부가 매장에게 보내는 공지가 아닙니다.")
        notice_title = notice.title
        brand_users: List[User] = account_models.User.objects.filter(brand=owner_brand)

        receiver_phone_bulk = [user.aligo_phone for user in brand_users]
        parameters = {
            "brand_name": owner_brand.name,
            "notice_title": notice_title,
            RECEIVER_PHONE_BULK: receiver_phone_bulk,
        }

        get_plugins_manager().send_kakaotalk(
            talk_event_code=AligoEvents.BRAND_NOTICE, parameters=parameters
        )

        return NoticeBrandKakaotalk(notice=notice)


