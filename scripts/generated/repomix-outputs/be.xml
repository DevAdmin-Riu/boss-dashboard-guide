from datetime import timedelta
from itertools import chain
from typing import Optional

import graphene
from django.contrib.auth import models as auth_models
from django.db.models import Case, Count, Exists, IntegerField, OuterRef, Q, Value, When
from django.utils import timezone
from graphql_relay import from_global_id
from i18naddress import get_validation_rules

from ...account import BrandMonthlySettlementStatus, models
from ...brand_store.models import BrandStore as BrandStoreModel
from ...core.exceptions import PermissionDenied
from ...payment import gateway
from ...payment.utils import fetch_customer_id
from ..stats.brand.schema import StatsBrandQueries
from ..utils.filters import filter_range_field
from .types import (
    AddressValidationData,
    Brand,
    BrandGroup,
    BrandSettlementCount,
    ChoiceValue,
    NumberOfBrands,
)
from .utils import get_allowed_fields_camel_case, get_required_fields_camel_case

USER_SEARCH_FIELDS = (
    "email",
    "first_name",
    "last_name",
    "default_shipping_address__first_name",
    "default_shipping_address__last_name",
    "default_shipping_address__city",
    "default_shipping_address__country",
)


def resolve_customers(info, **_kwargs):
    qs = models.User.objects.customers()
    return qs.distinct()


def resolve_fbv_customers(info, vendor_id, **_kwargs):
    _model, vendor_pk = graphene.Node.from_global_id(vendor_id)
    qs = models.User.objects.customers().filter(brand__fbv_vendors__id=vendor_pk).distinct()
    return qs


def resolve_permission_groups(info, **_kwargs):
    return auth_models.Group.objects.all().distinct()


def resolve_permission_group_by_name(info, name):
    name = name.strip()
    return auth_models.Group.objects.filter(name__exact=name).first()


def resolve_staff_users(info, **_kwargs):
    qs = models.User.objects.staff()
    return qs.distinct()


def resolve_user(info, id):
    _model, user_pk = graphene.Node.from_global_id(id)
    return models.User.objects.filter(pk=user_pk).first()


def resolve_address_validation_rules(
    info,
    country_code: str,
    country_area: Optional[str],
    city: Optional[str],
    city_area: Optional[str],
):
    params = {
        "country_code": country_code,
        "country_area": country_area,
        "city": city,
        "city_area": city_area,
    }
    rules = get_validation_rules(params)
    return AddressValidationData(
        country_code=rules.country_code,
        country_name=rules.country_name,
        address_format=rules.address_format,
        address_latin_format=rules.address_latin_format,
        allowed_fields=get_allowed_fields_camel_case(rules.allowed_fields),
        required_fields=get_required_fields_camel_case(rules.required_fields),
        upper_fields=rules.upper_fields,
        country_area_type=rules.country_area_type,
        country_area_choices=[ChoiceValue(area[0], area[1]) for area in rules.country_area_choices],
        city_type=rules.city_type,
        city_choices=[ChoiceValue(area[0], area[1]) for area in rules.city_choices],
        city_area_type=rules.city_type,
        city_area_choices=[ChoiceValue(area[0], area[1]) for area in rules.city_area_choices],
        postal_code_type=rules.postal_code_type,
        postal_code_matchers=[compiled.pattern for compiled in rules.postal_code_matchers],
        postal_code_examples=rules.postal_code_examples,
        postal_code_prefix=rules.postal_code_prefix,
    )


def resolve_payment_sources(user: models.User):
    stored_customer_accounts = (
        (gtw.id, fetch_customer_id(user, gtw.id)) for gtw in gateway.list_gateways()
    )
    return list(
        chain(
            *[
                prepare_graphql_payment_sources_type(gateway.list_payment_sources(gtw, customer_id))
                for gtw, customer_id in stored_customer_accounts
                if customer_id is not None
            ]
        )
    )


def prepare_graphql_payment_sources_type(payment_sources):
    sources = []
    for src in payment_sources:
        sources.append(
            {
                "gateway": src.gateway,
                "credit_card_info": {
                    "last_digits": src.credit_card_info.last_4,
                    "exp_year": src.credit_card_info.exp_year,
                    "exp_month": src.credit_card_info.exp_month,
                    "brand": "",
                    "first_digits": "",
                },
            }
        )
    return sources


def resolve_address(info, id):
    user = info.context.user
    _model, address_pk = graphene.Node.from_global_id(id)
    if user and not user.is_anonymous:
        return user.addresses.filter(id=address_pk).first()
    return PermissionDenied(user=user, fn=resolve_address)


def resolve_brand(info, id):
    return graphene.Node.get_node_from_global_id(info, id, Brand)


def resolve_brand_by_code(_info, code):
    return models.Brand.objects.filter(code=code).first()


def resolve_brand_store_by_code(_info, code):
    return BrandStoreModel.objects.filter(code=code).first()


def resolve_brands(info, **_kwargs):
    return models.Brand.objects.all().distinct()


def resolve_number_of_brands(info, **_kwargs):
    today = timezone.now()
    target_date_after_60 = today + timedelta(days=60)

    contract_warning_subquery = models.BrandEtcFile.objects.filter(
        brand=OuterRef("pk"),  # OuterRef로 외부 쿼리의 필드 참조
        end_date__isnull=False,
        end_date__lte=target_date_after_60,
    ).values("pk")

    brands_with_flags = models.Brand.objects.annotate(
        running_flag=Case(
            When(is_running=True, then=1),
            default=0,
            output_field=IntegerField(),
        ),
        contract_warning_flag=Case(
            When(Exists(contract_warning_subquery) & Q(is_running=True), then=Value(1)),
            default=Value(0),
            output_field=IntegerField(),
        ),
    )

    total = brands_with_flags.count()
    running = brands_with_flags.filter(running_flag=1).count()
    contract_warning = brands_with_flags.filter(contract_warning_flag=1).count()

    return NumberOfBrands(total=total, running=running, contract_warning=contract_warning)


def resolve_brand_reverse_fee_deposit_events(info, **_kwargs):
    return models.BrandReverseFeeDepositEvent.objects.select_related("brand").all().distinct()


def resolve_brand_vacs_fee_events(info, **_kwargs):
    return models.BrandVacsFeeEvent.objects.all().distinct()


def resolve_brand_settlement_count(info, **kwargs):
    filter = kwargs.get("filter")
    is_fulfilled_by_vendor = filter.get("is_fulfilled_by_vendor")
    stat_date = filter.get("stat_date")
    mode = filter.get("mode")
    brand_id = filter.get("brand_id")
    if is_fulfilled_by_vendor:
        brand_settlement_qs = models.BrandFbvSettlement.objects.all()
    else:
        brand_settlement_qs = models.BrandMileageMonthlySettlement.objects.all()

    brand_settlement_qs = filter_range_field(brand_settlement_qs, "date", stat_date)
    if brand_id is not None:
        _, brand_pk = from_global_id(brand_id)
        brand_settlement_qs = brand_settlement_qs.filter(brand_id=brand_pk)

    confirmed_filter = Q(settlement_status=BrandMonthlySettlementStatus.CONFIRMED)
    reviewing_by_admin_filter = Q(
        settlement_status=BrandMonthlySettlementStatus.REVIEWING_BY_ADMIN,
        settlement_review_requested_date__isnull=False,
    )
    waiting_for_payment_filter = Q(
        settlement_status=BrandMonthlySettlementStatus.WAITING_FOR_PAYMENT
    )
    paid_filter = Q(settlement_status=BrandMonthlySettlementStatus.PAID)
    brand_settlement_count = brand_settlement_qs.aggregate(
        confirmed_count=Count("id", filter=confirmed_filter),
        reviewing_by_admin_count=Count("id", filter=reviewing_by_admin_filter),
        waiting_for_payment_count=Count("id", filter=waiting_for_payment_filter),
        paid_count=Count("id", filter=paid_filter),
    )

    brand_order_stats_qs = StatsBrandQueries.sales_qs_for_brands_order_stats(
        is_fulfilled_by_vendor=is_fulfilled_by_vendor,
        stat_date=stat_date,
        mode=mode,
        ids=[brand_id] if brand_id is not None else None,
    )
    brand_settlement_count["brands_order_stats_count"] = brand_order_stats_qs.count()

    return BrandSettlementCount(**brand_settlement_count)


def resolve_brand_mileage_monthly_settlements(info, **_kwargs):
    return models.BrandMileageMonthlySettlement.objects.all().distinct()


def resolve_brand_fbv_settlements(info, **_kwargs):
    return models.BrandFbvSettlement.objects.select_related("brand").all().distinct()


def resolve_brand_group(info, id):
    return graphene.Node.get_node_from_global_id(info, id, BrandGroup)


def resolve_brand_group_list(info, **_kwargs):
    return models.BrandGroup.objects.all().distinct()
