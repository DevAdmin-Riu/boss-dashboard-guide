class NoticeFromHqNotificationSendInput(graphene.InputObjectType):
    send_push = graphene.Boolean(required=True, description="푸시알림 발송 여부")
    send_kakao = graphene.Boolean(required=True, description="알림톡 발송 여부")
    users = graphene.List(
        graphene.ID,
        required=True,
        description="브랜드 유저들 아이디",
    )


class NoticeFromHqNotificationSend(BaseMutation):
    brand = graphene.Field(Brand, description="알림톡을 보낸 브랜드 정보")

    class Arguments:
        id = graphene.ID(required=True, description="본부 공지사항 ID")
        input = NoticeFromHqNotificationSendInput(required=True, description="알림톡 발송 입력 값")

    class Meta:
        description = "공지가 속한 브랜드의 가맹점들에게 알림톡을 전송함."
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        if context.user.is_staff:
            if context.user.has_perm(BbsPermissions.MANAGE_NOTICE):
                return True
            else:
                return False

        # 아래 퍼미션 체크는 가맹본부->매장 공지 기준으로 작성됨
        is_active = context.user.is_active
        is_hq_staff = context.user.is_hq_staff
        brand_id = context.user.brand_id
        id = data["id"]
        _, notice_id = graphene.Node.from_global_id(id)
        notice = models.Notice.objects.get(pk=notice_id)
        if not (notice.owner_brand_id == brand_id and is_active and is_hq_staff):
            raise PermissionDenied(user=context.user, cls=cls)
        return True

    @classmethod
    def perform_mutation(cls, root, info, **data):
        id = data.get("id")
        input = data.get("input")
        send_push = input.get("send_push")
        send_kakao = input.get("send_kakao")
        user_ids = input.get("users")

        # 공지사항 조회
        notice: NoticeModel = cls.get_node_or_error(info, id, only_type=Notice)
        notice_title = notice.title
        owner_brand = notice.owner_brand
        if not owner_brand:
            raise ValidationError("가맹본부가 매장에게 보내는 공지가 아닙니다.")
        brand_name = owner_brand.name

        brand_users: list[User] = cls.get_nodes_or_error(user_ids, "users", UserType)
        # brand_users의 수
        brand_users_count = len(brand_users)

        if send_kakao:
            if owner_brand.available_paid_notice_count >= brand_users_count:
                receiver_phone_bulk = [user.aligo_phone for user in brand_users]
                send_result = send_kakaotalk_to_users_on_send_notice_from_hq_notification(
                    brand_name=brand_name,
                    notice_title=notice_title,
                    receiver_phone_bulk=receiver_phone_bulk,
                )
                if send_result:
                    description = f"{brand_name}의 {notice_title} 공지에 대해 알림톡이 {brand_users_count}명의 가맹점에 발송."
                    owner_brand.decrease_available_paid_notice_count(
                        delta=brand_users_count,
                        type=PaidNoticeCountEventType.USE_FOR_NOTICE_FROM_HQ,
                        description=description,
                        from_user=info.context.user,
                    )

        if send_push:
            user_ids = [user.id for user in brand_users]
            send_push_notification_on_send_notice_from_hq_notification(
                info,
                user_ids,
                notice,
            )

        return cls(brand=owner_brand)
