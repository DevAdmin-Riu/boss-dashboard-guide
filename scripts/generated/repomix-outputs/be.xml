    def resolve_b2b_status_histories(
        root: OrderLineModel,
        info,
        after_status_list: List[OrderLineB2bStatus] = None,
        before_status_list: List[OrderLineB2bStatus] = None,
    ):
        if not after_status_list:
            return None

        def get_status_histories(
            histories: List[OrderLineB2bStatusHistoryModel],
            after_status_list: List[OrderLineB2bStatus],
            before_status_list: List[OrderLineB2bStatus],
        ):
            # 상태별 해당 history 를 찾는 로직을 개념적으로 처리하기 위해 id 순으로 소팅
            histories = sorted(histories, key=lambda history: history.id, reverse=True)
            filtered_id_list = []

            if not before_status_list:
                before_status_list = [None] * len(after_status_list)

            for after_status, before_status in zip(after_status_list, before_status_list):
                if before_status is None:
                    history_id = next(
                        (h.id for h in histories if h.after_status == after_status), None
                    )
                else:
                    history_id = next(
                        (
                            h.id
                            for h in histories
                            if h.after_status == after_status and h.before_status == before_status
                        ),
                        None,
                    )
                if history_id is not None:
                    filtered_id_list.append(history_id)

            result_histories = [
                history
                for history in histories
                if any(history.id == filtered_id for filtered_id in filtered_id_list)
            ]

            return result_histories

        return (
            OrderLineB2bStatusHistoryByOrderLineIdLoader(info.context)
            .load(root.id)
            .then(
                lambda histories: get_status_histories(
                    histories, after_status_list, before_status_list
                )
            )
        )

