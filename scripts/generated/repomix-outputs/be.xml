import graphene
from django.db.models import Count, Q

from ....stats import PurchaseStatus, PurchaseType, models
from ...core.fields import FilterInputConnectionField
from .filters import PurchaseFilterInput
from .mutations import (
    PurchaseBulkClose,
    PurchaseBulkPending,
    PurchaseBulkReqRevision,
    PurchaseCancel,
    PurchaseUpdate,
)
from .resolvers import resolve_purchases, resolve_purchases_stats_by_vendor
from .sorters import PurchaseSortingInput
from .types import (
    Purchase,
    PurchaseLineCount,
    PurchaseLineCountFilterInput,
    PurchasesStatsByVendor,
    PurchasesStatsFilterInput,
)


class StatsPurchaseQueries(graphene.ObjectType):
    purchases = FilterInputConnectionField(
        Purchase,
        filter=PurchaseFilterInput(description="Filtering options for purchases."),
        sort_by=PurchaseSortingInput(description="Sort purchases."),
        description="List of the shop's purchase.",
    )

    purchase_line_count = graphene.Field(
        PurchaseLineCount,
        description="매입 정산 상태별 line 카운트",
        filter=graphene.Argument(PurchaseLineCountFilterInput, required=True),
    )

    purchases_stats_by_vendor = graphene.List(
        PurchasesStatsByVendor,
        description="협력사 월별 매입 통계",
        filter=graphene.Argument(PurchasesStatsFilterInput, required=True),
    )

    def resolve_purchase_line_count(self, _info, **kwargs):
        purchase_line_qs = models.Purchase.objects.all()
        filter = kwargs.get("filter")
        vendor_id = filter.get("vendor_id")
        if vendor_id is not None:
            _, vendor_pk = graphene.Node.from_global_id(vendor_id)
            purchase_line_qs = purchase_line_qs.filter(purchase_order__vendor_id=vendor_pk)
        is_b2b = filter.get("is_b2b")
        if is_b2b is not None:
            purchase_line_qs = purchase_line_qs.filter(purchase_order__is_b2b=is_b2b)
        is_fbv = filter.get("is_fbv")
        if is_fbv is not None:
            if is_fbv == True:
                purchase_line_qs = purchase_line_qs.filter(type=PurchaseType.FULFILLED_BY_VENDOR)
            elif is_fbv == False:
                purchase_line_qs = purchase_line_qs.exclude(type=PurchaseType.FULFILLED_BY_VENDOR)

        purchase_line_counts = purchase_line_qs.aggregate(
            stand_by_count=Count("id", filter=Q(status=PurchaseStatus.STANDBY)),
            pending_count=Count("id", filter=Q(status=PurchaseStatus.PENDING)),
            req_revision_count=Count("id", filter=Q(status=PurchaseStatus.REQ_REVISION)),
            revision_count=Count("id", filter=Q(status=PurchaseStatus.REVISION)),
        )

        return PurchaseLineCount(**purchase_line_counts)

    def resolve_purchases(self, info, **_kwargs):
        return resolve_purchases(info, **_kwargs)

    def resolve_purchases_stats_by_vendor(self, _info, filter, **_kwargs):
        return resolve_purchases_stats_by_vendor(_info, filter, **_kwargs)


class StatsPurchaseMutations(graphene.ObjectType):
    purchase_cancel = PurchaseCancel.Field()
    purchase_update = PurchaseUpdate.Field()
    purchase_bulk_pending = PurchaseBulkPending.Field()
    purchase_bulk_req_revision = PurchaseBulkReqRevision.Field()
    purchase_bulk_close = PurchaseBulkClose.Field()
