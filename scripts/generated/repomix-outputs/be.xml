    def rop_7(self) -> Optional[Decimal]:
        return calc_rop(self, "last_7_days_avg_sales_daily_qty")

    @property
    def rop_15(self) -> Optional[Decimal]:
        return calc_rop(self, "last_15_days_avg_sales_daily_qty")

    @property
    def rop_30(self) -> Optional[Decimal]:
        return calc_rop(self, "last_30_days_avg_sales_daily_qty")

    @property
    def is_stopped(self) -> bool:
        return self.sales_status == SalesStatus.STOPPED

    def is_stopped_brand_product_variant(self, user: "User") -> bool:
        """
        * 조건에 맞는 BrandProductVariant or BrandProductVariantRegion 을 못 찾으면 is_stopped 로 처리
        """

        if self.is_direct_shipping:
            brand_product_variant_region = BrandProductVariantRegion.objects.filter(
                region=user.region,
                brand_product_variant__product_variant=self,
                brand_product_variant__brand=user.brand,
            ).first()
            if brand_product_variant_region is None:
                return True
            sales_status = brand_product_variant_region.sales_status
        else:
            brand_product_variant = BrandProductVariant.objects.filter(
                product_variant=self,
                brand=user.brand,
            ).first()
            if brand_product_variant is None:
                return True
            sales_status = brand_product_variant.sales_status
        return sales_status == SalesStatus.STOPPED

    @property
    def is_direct_shipping(self) -> bool:
        return self.product.is_direct_shipping

    def display_product(self, translated: bool = False, bp_name: str = None) -> str:
        if translated:
            product = self.product.translated
            variant_display = str(self.translated)
        else:
            variant_display = str(self)
            product = self.product

        product_name = bp_name if bp_name else str(product)
        product_display = f"{product_name} ({variant_display})" if variant_display else product_name
        return smart_text(product_display)

    def get_first_image(self) -> "ProductImage":
        images = list(self.images.all())
        return images[0] if images else self.product.get_first_image()

    def get_brand_product_variant(self, brand: "Brand") -> "BrandProductVariant":
        return self.brand_product_variants.filter(brand=brand).first()

    def get_ordering_queryset(self):
        return self.product.variants.filter(outer__isnull=True)

    @property
    def sub_pv(self) -> Optional["ProductVariant"]:
        try:
            return self.sub_pv_relation.sub_pv
        except SubProductVariantRelation.DoesNotExist:
            pass
        return None


