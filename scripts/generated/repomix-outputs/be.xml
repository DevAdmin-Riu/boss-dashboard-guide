def _get_bpv_qs_filtered_by_sales_status(
    variant: "ProductVariant",
    sales_status: SalesStatus,
):
    return variant.brand_product_variants.filter(sales_status=sales_status)


def set_bpv_sales_status_on_pv_to_stopped(
    variant: "ProductVariant",
    stopped_at: datetime.date,
    stopped_reason: "StoppedReasonType",
    stopped_reason_etc: str,
    user: "User" = None,
):
    """
    * variant를 단종상태 로 변경할 때, 판매 상태 가 판매 인 모든 BrandProductVariant, BrandProductVariantRegion 의 판매 상태 정보 변경
        * 판매 상태: 중단 예정
        * 중단일: 단종일 + 30일
        * 중단 사유: 단종 사유
    """
    stopped_at_plus_30 = stopped_at + datetime.timedelta(days=30)

    before_sale_status = SalesStatus.ON_SALE
    after_sale_status = SalesStatus.WILL_BE_STOPPED

    with transaction.atomic():
        brand_product_variants_qs = _get_bpv_qs_filtered_by_sales_status(
            variant, before_sale_status
        )
        bpv_list = list(brand_product_variants_qs.iterator())

        add_bulk_brand_product_variant_manage_event(
            bpv_list=bpv_list,
            user=user,
            type=BrandProductVariantManageEventType.TYPE_STATUS,
            title="자동 변경",
            reason="제품 단종",
            change_details="판매 상태 변경: 판매 -> 중단예정",
        )
        for brand_product_variant in bpv_list:
            visible_brand_product_packages = brand_product_variant.brand_product_packages.filter(
                visible=True
            )
            brand_product_name = brand_product_variant.brand_product.name
            brand = brand_product_variant.brand
            brand_name = brand.name
            staff_email = brand.staff.email if brand.staff else None
            for visible_brand_product_package in visible_brand_product_packages:
                brand_product_package_name = visible_brand_product_package.name
                if staff_email:
                    transaction.on_commit(
                        lambda brand_name=brand_name, package_name=brand_product_package_name, brand_product_name=brand_product_name, staff_email=staff_email: send_templated_mail_will_be_stopped_alarm_in_package.delay(
                            brand_name=brand_name,
                            package_name=package_name,
                            brand_product_name=brand_product_name,
                            staff_email=staff_email,
                        )
                    )

            visible_brand_product_packages.update(
                visible=False,
            )

        brand_product_variants_qs = _get_bpv_qs_filtered_by_sales_status(
            variant, before_sale_status
        )
        brand_product_variants_qs.update(
            sales_status=after_sale_status,
            stopped_at=stopped_at_plus_30,
            stopped_reason=stopped_reason,
            stopped_reason_etc=stopped_reason_etc,
        )

    BrandProductVariantRegion.objects.filter(brand_product_variant__product_variant=variant).filter(
        sales_status=before_sale_status
    ).update(
        sales_status=after_sale_status,
        stopped_at=stopped_at_plus_30,
        stopped_reason=stopped_reason,
        stopped_reason_etc=stopped_reason_etc,
    )


def set_bpv_sales_status_on_pv_from_stopped_to_non_stopped(
    variant: "ProductVariant",
    prev_sales_status: "SalesStatus",
    user: "User" = None,
):
    """
    * variant를 단종 -> 단종예정, 단종 -> 정상 상태 로 변경할 때, 판매 상태 가 중단예정 인 모든 BrandProductVariant, BrandProductVariantRegion 의 판매 상태 정보 변경
        * 판매 상태: 판매
        * 중단일: None
        * 중단 사유: None
    """
    if prev_sales_status != SalesStatus.STOPPED:
        return

    target_sale_status = SalesStatus.WILL_BE_STOPPED
    after_sale_status = SalesStatus.ON_SALE
    with transaction.atomic():
        brand_product_variants_qs = _get_bpv_qs_filtered_by_sales_status(
            variant, target_sale_status
        )
        bpv_list = list(brand_product_variants_qs.iterator())

        add_bulk_brand_product_variant_manage_event(
            bpv_list=bpv_list,
            user=user,
            type=BrandProductVariantManageEventType.TYPE_STATUS,
            title="자동 변경",
            reason="제품 다시 취급",
            change_details="판매 상태 변경: 중단예정->판매",
        )

        brand_product_variants_qs = _get_bpv_qs_filtered_by_sales_status(
            variant, target_sale_status
        )
        brand_product_variants_qs.update(
            sales_status=after_sale_status,
            stopped_at=None,
            stopped_reason=None,
            stopped_reason_etc=None,
        )

    BrandProductVariantRegion.objects.filter(brand_product_variant__product_variant=variant).filter(
        sales_status=target_sale_status
    ).update(
        sales_status=after_sale_status,
        stopped_at=None,
        stopped_reason=None,
        stopped_reason_etc=None,
    )


def set_bpv_sales_status_on_pv_from_pending_to_on_sale(
    variant: "ProductVariant",
    prev_sales_status: "SalesStatus",
    user: "User" = None,
):
    """
    * variant를 판매대기 -> 정상 상태 로 변경할 때, 모든 BrandProductVariant, BrandProductVariantRegion 의 판매 상태 정보 변경
        * 판매 상태: 판매
        * 중단일: None
        * 중단 사유: None
    """
    if prev_sales_status != SalesStatus.PENDING:
        return

    after_sale_status = SalesStatus.ON_SALE
    with transaction.atomic():
        brand_product_variants_qs = variant.brand_product_variants.all()
        bpv_list = list(brand_product_variants_qs.iterator())

        add_bulk_brand_product_variant_manage_event(
            bpv_list=bpv_list,
            user=user,
            type=BrandProductVariantManageEventType.TYPE_STATUS,
            title="자동 변경",
            reason="제품 상태 변경: 판매대기->정상",
            change_details="판매 상태 변경: 판매",
        )

        brand_product_variants_qs = variant.brand_product_variants.all()
        brand_product_variants_qs.update(
            sales_status=after_sale_status,
            stopped_at=None,
            stopped_reason=None,
            stopped_reason_etc=None,
        )

    BrandProductVariantRegion.objects.filter(brand_product_variant__product_variant=variant).update(
        sales_status=after_sale_status,
        stopped_at=None,
        stopped_reason=None,
        stopped_reason_etc=None,
    )


def set_bpv_sales_status_on_pv_to_pending(
    variant: "ProductVariant",
    user: "User" = None,
):
    """
    * variant를 판매대기 상태 로 변경할 때, 모든 BrandProductVariant, BrandProductVariantRegion 의 판매 상태 정보 변경
        * 판매 상태: 중단
        * 중단일: today
        * 중단 사유: 기타 + ‘판매 대기 제품’ 으로 설정
    """
    after_sale_status = SalesStatus.STOPPED
    with transaction.atomic():
        brand_product_variants_qs = variant.brand_product_variants.all()
