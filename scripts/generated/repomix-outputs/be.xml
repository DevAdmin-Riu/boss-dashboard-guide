class BrandRemoveProducts(ModelBulkDeleteMutation):
    brand = graphene.Field(
        Brand, description="Franchise brand for which products will be unavailable."
    )

    class Arguments:
        brand_id = graphene.Argument(
            graphene.ID, required=True, description="ID of a franchise brand."
        )
        ids = graphene.List(graphene.ID, required=True, description="List of brand product IDs.")

    class Meta:
        description = "Unassign Brand products"
        model = models.BrandProduct
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic
    def mutate(cls, root, info, brand_id, ids, **data):
        if not cls.check_permissions(info.context, **data):
            raise PermissionDenied(user=info.context.user, cls=cls)

        brand = cls.get_node_or_error(info, brand_id, field="brand_id", only_type=Brand)
        if brand is None:
            raise ValidationError("brand_id 오류", code=ProductErrorCode.INVALID)

        instances = cls.get_nodes_or_error(ids, "id", BrandProduct)
        count = len(instances)
        if count:
            # FK 관계때문에 brand_product_varinats table 정리 먼저 수행
            instance_ids = [instance.pk for instance in instances]
            delete_brand_product_variants(brand, instance_ids)
            qs = models.BrandProduct.objects.filter(pk__in=instance_ids)
            cls.bulk_action(queryset=qs, **data)
        else:
            count = 0

        response = cls(errors={}, count=count)
        response.brand = brand
        return response


