import logging

from celery.signals import task_failure

from ..celeryconf import app
from ..plugins.email.utils import get_it_group_email_list
from ..stats.emails import send_templated_mail_consider_test_mode
from .emails import get_email_context

logger = logging.getLogger(__name__)


def send_celery_fail_email(context, template_name):
    _send_celery_fail_email.delay(context, template_name)


@app.task
def _send_celery_fail_email(context, template_name):
    mail_title_for_log = "task 실행 실패 메일 발송"
    recipient_list = get_it_group_email_list()
    if len(recipient_list) == 0:
        logger.info(
            f"{mail_title_for_log}을 위한 it 그룹 답당자 이메일 설정을 확인하세요. {context}"
        )
        return

    send_kwargs, ctx = get_email_context()
    ctx.update(context)
    send_templated_mail_consider_test_mode(
        mail_title_for_log=mail_title_for_log,
        template_name=template_name,
        recipient_list=recipient_list,
        context=ctx,
        **send_kwargs,
    )


@task_failure.connect
def handle_task_failure(
    sender=None,
    task_id=None,
    exception=None,
    args=None,
    kwargs=None,
    traceback_=None,
    einfo=None,
    **kw
):
    sender_name = sender.name if sender else "Unknown"
    traceback = einfo.traceback if einfo else "No traceback available"
    context = {
        "sender_name": sender_name,
        "error_type": type(exception).__name__,
        "error_message": str(exception),
        "args": f"args={args}, kwargs={kwargs}",
        "traceback": traceback,
    }
    send_celery_fail_email(context, "core/celery_task_fail")
    logger.error(f"task 실행 예외 발생: {sender_name}, {task_id} {context}")


# handle_task_failure 기능 테스트를 위한 등록한 task임
# celery -A saleor worker -l info 로 워커 구동된 상태로  divide.delay(10, 0)  호출해서 메일 발송되는 것 확인
@app.task
def divide(x, y):
    return x / y
