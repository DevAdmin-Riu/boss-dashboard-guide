from dataclasses import dataclass
from decimal import Decimal
from typing import List, Optional, Union

import openpyxl
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.utils import get_column_letter


@dataclass
class ExcelCellInfo:
    title: str
    value: Union[str, int, float]
    ndigits: Optional[int] = None
    width: Optional[int] = None
    alignment: Optional[Alignment] = None


def make_excel_cell_info(
    title: str,
    value: Union[str, int, float, Decimal],
    ndigits: int = None,
    width: int = None,
    horizontal_align: str = None,
) -> ExcelCellInfo:
    """
    Args:
        title (str): 컬럼명
        value (Union[str, int, float, Decimal]): cell 값
        ndigits (int, optional): 소수점 자리수 (Default: int 형은 0, float/Decimal 형은 1)
        width (int, optional): auto_adjusted_width=False 일 때만 사용. Defaults to None.
        horizontal_align (str, optional): cell horizontal 정렬 방식 (Default: 숫자 형식은 "right", 그 외는 "center")

    Returns:
        ExcelCellInfo: export_items_to_excel 에 전달할 items에 추가할 cell 정보
    """

    if horizontal_align is None:
        if isinstance(value, (int, float, Decimal)):
            horizontal_align = "right"
        else:
            horizontal_align = "center"
    return ExcelCellInfo(
        title=title,
        value=value,
        ndigits=ndigits,
        width=width,
        alignment=Alignment(horizontal=horizontal_align, vertical="center"),
    )


def export_excel_cell_info_rows_to_workbook(
    *,
    rows: List[List[ExcelCellInfo]],
    auto_adjusted_width: bool = True,
    include_index: bool = False,
    font_size: int = 9,
    show_exclude_vat_legend: bool = False,
) -> openpyxl.Workbook:
    wb = openpyxl.Workbook()
    ws = wb.active

    if rows:
        header_font = Font(size=font_size, bold=True)
        value_font = Font(size=font_size)
        legend_font = Font(size=font_size, bold=True, color="FF0000")  # 빨간색

        header_fill = PatternFill(
            start_color="FFFF99", end_color="FFFF99", fill_type="solid"
        )  # 연한 노란색
        thin_border = Border(
            left=Side(style="thin"),
            right=Side(style="thin"),
            top=Side(style="thin"),
            bottom=Side(style="thin"),
        )

        row_letter = 1
        if show_exclude_vat_legend:
            max_col = len(rows[0])
            legend_cell = ws[f"{get_column_letter(max_col + 1)}{row_letter}"]
            legend_cell.value = "(금액단위: 원, 부가세별도)"
            legend_cell.font = legend_font
            legend_cell.alignment = Alignment(horizontal="right", vertical="center")
            row_letter += 1

        if include_index:
            for row_num, row in enumerate(rows, start=1):
                row.insert(
                    0,
                    ExcelCellInfo(
                        title="No.",
                        value=row_num,
                        width=8,
                        alignment=Alignment(horizontal="center"),
                    ),
                )

        headers = rows[0]
        for col_num, cell_info in enumerate(headers, 1):
            col_letter = get_column_letter(col_num)
            col_address = f"{col_letter}{row_letter}"
            cell = ws[col_address]
            cell.value = cell_info.title
            cell.font = header_font
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.fill = header_fill
            cell.border = thin_border

            if cell_info.width:
                ws.column_dimensions[col_letter].width = cell_info.width
        row_letter += 1

        # 데이터 작성 (2행부터)
        for row_num, row in enumerate(rows, start=row_letter):
            for col_num, cell_info in enumerate(row, 1):
                col_letter = get_column_letter(col_num)
                col_address = f"{col_letter}{row_num}"
                cell = ws[col_address]
                cell.value = cell_info.value
                cell.font = value_font
                if isinstance(cell.value, (int, float, Decimal)):
                    if cell_info.ndigits is not None and cell_info.ndigits > 0:
                        cell.number_format = "#,##0." + "0" * cell_info.ndigits
                    else:
                        if isinstance(cell.value, int) or cell_info.ndigits == 0:
                            cell.number_format = "#,##0"
                        elif isinstance(cell.value, (float, Decimal)):
                            cell.number_format = "#,##0.0"
                cell.border = thin_border
                if cell_info.alignment:
                    cell.alignment = cell_info.alignment

    if auto_adjusted_width:
        for col in ws.columns:
            max_length = 0
            column = col[0].column_letter  # 현재 열의 알파벳 (A, B, C, ...)
            for cell in col:
                try:
                    cell_value = str(cell.value)
                    # 한글 문자는 2배 너비로 처리
                    length = sum(2 if ord(char) > 255 else 1 for char in cell_value)
                    max_length = max(max_length, length)
                except:
                    pass
            adjusted_width = max_length + 2  # 여유 공간을 위해 +2
            ws.column_dimensions[column].width = adjusted_width

    return wb
