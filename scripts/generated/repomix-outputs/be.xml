class CheckoutLinesUpdate(BaseMutation):
    checkout = graphene.Field(Checkout, description="An updated checkout.")
    user = graphene.Field(User, description="An updated user instance.")

    class Arguments:
        lines = graphene.List(
            CheckoutLineInput,
            required=True,
            description=(
                "A list of checkout lines, each containing information about "
                "an item in the checkout."
            ),
        )
        checkout_id = graphene.ID(description="The ID of the checkout.")

    class Meta:
        description = "Adds multiple checkout lines to the existing checkout."
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @classmethod
    def valid_packages(
        cls, brand_product_packages_ids, brand_product_packages, variants, user_brand
    ):
        unique_packages_count = len(set(brand_product_packages_ids))
        if unique_packages_count > 1:
            raise ValidationError("패키지가 다른 상품을 동시에 장바구니에 담을 수 없습니다.")
        # package가 없다는 뜻이므로 아무것도 안함.
        elif unique_packages_count == 0 or (
            unique_packages_count == 1 and brand_product_packages_ids[0] is None
        ):
            return
        # unique한게 1개 있는 경우임.
        else:
            # package의 brand Id와 checkout의 유저의 brand가 동일한지 확인.
            brand_product_package = brand_product_packages[0]
            if brand_product_package and brand_product_package.brand_id != user_brand.id:
                raise ValidationError(
                    "패키지의 브랜드와 사용자의 브랜드가 일치하지 않습니다.",
                )

            brand_product_variants_qs_in_brand_product_package = (
                brand_product_package.brand_product_variants.all()
            )
            product_variants_ids_in_brand_product_package = [
                brand_product_variant.product_variant_id
                for brand_product_variant in brand_product_variants_qs_in_brand_product_package
            ]
            # 모든 variants 가 product_variants_ids_in_brand_product_package 안에 포함되어있는지 확인
            for variant in variants:
                if variant.id not in product_variants_ids_in_brand_product_package:
                    raise ValidationError(
                        "패키지에 포함되지 않은 상품이 장바구니에 담겼습니다.",
                    )

    @classmethod
    def validate_is_for_credits_refill(cls, variants: List["ProductVariantModel"], checkout):
        # variants와 checkout 다른 lines까지 고려하여, is_for_credits_refill는 전부다 True이거나 전부다 False여야 한다.
        # bp_bundle 라인은 line.variant 가 None이며, 그 경우 is_for_credits_refill 는 False 로 간주 (즉, 세트 상품과 충전금 충전 상품을 같이 구매할 수 없음)
        is_for_credits_refill = [
            variant.is_for_credits_refill if variant is not None else False for variant in variants
        ]
        is_for_credits_refill.extend(
            [
                line.variant.is_for_credits_refill if line.variant is not None else False
                for line in checkout
            ]
        )
        if len(set(is_for_credits_refill)) > 1:
            raise ValidationError(
                "충전금 충전 상품과 일반 상품을 동시에 장바구니에 담을 수 없습니다."
            )

    @classmethod
    def validate_deferred(cls, variants: List["ProductVariantModel"], checkout):
        # variants와 checkout의 다른 lines까지 고려하여, is_deferred는 전부 True이거나 전부 False여야 한다.
        # bp_bundle 라인은 line.variant 가 None이며, 그 경우 is_deferred 는 False 로 간주 (즉, 세트 상품과 후정산 상품을 같이 구매할 수 없음)
        is_deferred_values = [
            variant.is_deferred if variant is not None else False for variant in variants
        ]
        is_deferred_values.extend(
            [line.variant.is_deferred if line.variant is not None else False for line in checkout]
        )

        if len(set(is_deferred_values)) > 1:
            raise ValidationError("후정산 상품과 일반 상품을 동시에 장바구니에 담을 수 없습니다.")

    @classmethod
    def validate_fbv_vendor(
        cls, variants: List["ProductVariantModel"], vendor_ids: List[Optional[int]]
    ):
        errors = []

        for variant, vendor_id in zip(variants, vendor_ids):
            if vendor_id is None:
                continue  # 보스 상품 → 검증 패스

            if not variant.variant_vendors.filter(vendor_id=vendor_id).exists():
                errors.append(variant.product.name)

        if errors:
            raise ValidationError(
                "협력사에서 취급하지 않는 상품입니다. 상품 진열에 착오가 있어서 발생한 오류로 고객센터에 문의 주시면 조치해 드리겠습니다. 상품명: %s"
                % ", ".join(set(errors))  # 중복 제거
            )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, lines, checkout_id=None, vendor_id=None, replace=True):
        brand_store_owner_user = info.context.brand_store_owner_user
        switched_brand = brand_store_owner_user.switched_brand if brand_store_owner_user else None

        checkout: CheckoutModel = cls.get_node_or_error(
            info, checkout_id, only_type=Checkout, field="checkout_id"
        )

        (
            variants,
            bp_bundles,
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            bpvs_by_input_sequence,
            bp_names_by_input_sequence,
        ) = CheckoutCreateByStaff.get_pvs_and_bp_bundles_of_checkout_lines(
            cls,
            lines,
        )
        quantities = [line.get("quantity") for line in lines]
        brand_product_packages_ids = [line.get("brand_product_package_id") for line in lines]
        # brand_product_packages_ids가 전부 동일한지 확인한다.
        try:
            brand_product_packages = [
                (
                    cls.get_node_or_error(info, id, "brand_product_package_id", BrandProductPackage)
                    if id
                    else None
                )
                for id in brand_product_packages_ids
            ]
        except:
            raise ValidationError("패키지 상품이 존재하지 않습니다.")

        vendor_ids = [
            (
                int(graphene.Node.from_global_id(line.get("vendor_id"))[1])
                if line.get("vendor_id") is not None
                else None
            )
            for line in lines
        ]

        cls.valid_packages(
            brand_product_packages_ids, brand_product_packages, variants, user_brand=switched_brand
        )
        cls.validate_is_for_credits_refill(variants, checkout)
        cls.validate_deferred(variants, checkout)
        cls.validate_fbv_vendor(variants, vendor_ids)

        validate_variants_on_sale(
            variants, brand_store_owner_user, pvs_by_input_sequence, bpvs_by_input_sequence
        )
        validate_bp_bundles_on_sale(bp_bundles, brand_store_owner_user)
        check_lines_quantity(
            pvs_by_input_sequence,
            bp_bundles_by_input_sequence,
            quantities,
            checkout.get_country(),
            order_type=OrderType.BY_USER,
            bp_name_list=bp_names_by_input_sequence,
        )

        if lines:
            for (
                variant,
                bp_bundle,
                quantity,
                brand_product_package,
                brand_product_variant,
                vendor_id,
            ) in zip(
                pvs_by_input_sequence,
                bp_bundles_by_input_sequence,
                quantities,
                brand_product_packages,
                bpvs_by_input_sequence,
                vendor_ids,
            ):
                add_pv_or_bp_bundle_to_checkout(
                    checkout,
                    variant,
                    bp_bundle,
                    quantity,
                    brand_product_package=brand_product_package,
                    replace=replace,
                    brand_product_variant=brand_product_variant,
                    vendor_id=vendor_id,
                )
            info.context.plugins.checkout_quantity_changed(checkout)

        info.context.plugins.checkout_updated(checkout)
        return CheckoutLinesUpdate(checkout=checkout, user=brand_store_owner_user)


