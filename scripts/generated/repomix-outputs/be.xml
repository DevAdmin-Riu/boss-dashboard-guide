import re
from typing import Dict

from draftjs_exporter.html import HTML
from markdownify import markdownify


def _link_entity(props):
    href = props.get("url", "")
    children = props["children"]
    return f'<a href="{href}">{children}</a>'


def _image_entity(props):
    src = props.get("src", "")
    width = props.get("width", "")
    height = props.get("height", "")
    style = ""
    if width:
        style += f"width:{width};"
    if height:
        style += f"height:{height};"
    style_attr = f' style="{style}"' if style else ""
    return f'<img src="{src}"{style_attr} />'


def _fix_br_in_inline_tag(html):
    html = html.replace("\n", "<br>")
    # 인라인 태그 내부의 <br>를 태그 밖으로 이동
    html = re.sub(r"<(strong|b|em|u|span|a)><br>", r"<br><\1>", html)
    html = re.sub(r"<br></(strong|b|em|u|span|a)>", r"</\1><br>", html)
    return html


def _fix_space_in_inline_tag(html):
    # 인라인 태그 안쪽 끝의 공백을 태그 바깥으로 이동
    html = re.sub(r"<(strong|b|em|u|span|a)>(.*?)\s+</\1>", r"<\1>\2</\1> ", html)
    return html


def _fix_html(html: str) -> str:
    """Fix common HTML issues in the rendered HTML."""
    html = _fix_br_in_inline_tag(html)
    html = _fix_space_in_inline_tag(html)
    return html


def draftjs_to_markdown(draftjs_json: Dict[str, dict]) -> str:
    """Convert DraftJS JSON content to Markdown format."""
    exporter = HTML(
        {
            "block_map": {
                "unstyled": {"element": "p"},
                "paragraph": {"element": "p"},
                "header-one": {"element": "h1"},
                "header-two": {"element": "h2"},
                "header-three": {"element": "h3"},
                "header-four": {"element": "h4"},
                "header-five": {"element": "h5"},
                "header-six": {"element": "h6"},
                "blockquote": {"element": "blockquote"},
                "unordered-list-item": {"element": "li", "wrapper": "ul"},
                "ordered-list-item": {"element": "li", "wrapper": "ol"},
                "code-block": {"element": "pre"},
                "atomic": {"element": "figure"},
            },
            "entity_decorators": {
                "LINK": _link_entity,
                "IMAGE": _image_entity,
            },
            "style_map": {
                "BOLD": "strong",
                "ITALIC": "em",
                "UNDERLINE": "u",
                "STRIKETHROUGH": "del",
            },
        }
    )

    html = exporter.render(draftjs_json)
    html = _fix_html(html)

    markdown = markdownify(html, heading_style="ATX").strip()
    return markdown
