    )
    tax_free_amount = graphene.Int(description="결제 금액 중 면세 금액 - toss PG 결제창 열 때 사용")

    receipt_file = graphene.Field(PaymentReceiptFile, description="증빙 자료 (대행주문에만 해당)")
    gateway = graphene.Field(PaymentGatewayTypeEnum, description="결제 플러그인 타입")

    toss_order_id = graphene.String(description="Toss 결제 요청 OrderId")

    receipt_url = graphene.String(description="pg 결제 매출 전표")

    class Meta:
        description = "Represents a payment of a given type."
        interfaces = [relay.Node]
        model = models.Payment
        filter_fields = ["id"]
        only_fields = [
            "id",
            "is_active",
            "created",
            "modified",
            "token",
            "checkout",
            "order",
            "customer_ip_address",
            "amount",
            "cashable_credits",
            "non_cashable_credits",
            "rcoins",
            "origin_amount",
            "origin_cashable_credits",
            "origin_non_cashable_credits",
            "origin_rcoins",
            "captured_amount",
            "captured_cashable_credits",
            "captured_non_cashable_credits",
            "captured_rcoins",
            "paying_charge_exclude_vat",
            "brand_paying_charge_exclude_vat",
            "final_paying_charge_exclude_vat",
            "final_brand_paying_charge_exclude_vat",
            "receipt_refused_reason",
            "is_toss_riu_pay",
        ]

    def resolve_checkout(root: PaymentModel, info):
        if root.checkout_id:
            return CheckoutByTokenLoader(info.context).load(root.checkout_id)
        else:
            return None

    def resolve_order(root: PaymentModel, info):
        if root.order_id:
            return OrderByIdLoader(info.context).load(root.order_id)
        else:
            return None

    def resolve_tax_free_amount(root: PaymentModel, _info):
        return my_round(root.taxfree)

    def resolve_number(root: PaymentModel, _info):
        return str(root.pk)

    def resolve_actions(root: PaymentModel, _info):
        actions = []
        if root.can_refund():
            actions.append(OrderAction.REFUND)
        return actions

    def resolve_total(root: PaymentModel, _info):
        return root.get_total()

    def resolve_captured_total(root: PaymentModel, _info):
        return root.get_captured_total()

    def resolve_transactions(root: PaymentModel, info):
        return TransactionsByPaymentIdLoader(info.context).load(root.id)

    def resolve_available_refund_amount(root: PaymentModel, _info):
        # FIXME TESTME
        if not root.can_refund():
            return None
        return root.get_captured_amount()

    def resolve_available_capture_amount(root: PaymentModel, _info):
        # FIXME TESTME
        if not root.can_capture():
            return None
        return root.get_charge_amount()

    def resolve_last_vbank_pending_transaction(root: PaymentModel, info):
        if root.charge_status != ChargeStatus.PENDING:
            return None

        def get_last_transaction(transactions: List[TransactionModel]):

            # 최신 transaction을 kind 필터로 필터링 후 가장 높은 pk를 가진 transaction 반환
            filtered_transactions = [
                transaction
                for transaction in transactions
                if transaction.kind == TransactionKind.ACTION_TO_CONFIRM and transaction.is_success
            ]

            return max(filtered_transactions, key=lambda t: t.pk) if filtered_transactions else None

        return TransactionsByPaymentIdLoader(info.context).load(root.id).then(get_last_transaction)

    def resolve_receipt_file(root: PaymentModel, info):
        if root.receipt_file:
            return PaymentReceiptFile(
                file_name=root.receipt_file.name,
                url=info.context.build_absolute_uri(root.receipt_file.url),
            )
        return None

    def resolve_toss_order_id(root: PaymentModel, _info):
        return make_toss_order_id(root)

    def resolve_receipt_url(root: PaymentModel, info):

        # 결제 완료 상태가 아니면 매출 전표 없음
        if root.charge_status not in [
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
            ChargeStatus.FULLY_REFUNDED,
        ]:
            return None

        pay_method = root.token

        def get_receipt_url(transactions: List[TransactionModel]):
            if root.gateway == PaymentGatewayType.TOSS:
                target_transation_kind = (
                    TransactionKind.ACTION_TO_CONFIRM
                    if is_vbank_pay(pay_method)
                    else TransactionKind.CAPTURE
                )
                filtered_last_transaction = next(
                    (
                        transaction
                        for transaction in transactions
                        if transaction.kind == target_transation_kind and transaction.is_success
                    ),
                    None,
                )
                if filtered_last_transaction:
                    return get_toss_receipt_url(filtered_last_transaction.gateway_response)
            elif root.gateway == PaymentGatewayType.INICIS:
                filtered_last_transaction = next(
                    (
                        transaction
                        for transaction in transactions
                        if transaction.kind == TransactionKind.CAPTURE and transaction.is_success
                    ),
                    None,
                )
                if filtered_last_transaction:
                    return get_inicis_receipt_url(root, filtered_last_transaction.gateway_response)

            return None

        return TransactionsByPaymentIdLoader(info.context).load(root.id).then(get_receipt_url)


class PaymentInitialized(graphene.ObjectType):
    class Meta:
        description = (
            "Server-side data generated by a payment gateway. Optional step when the "
            "payment provider requires an additional action to initialize payment "
            "session."
        )

    gateway = graphene.String(description="ID of a payment gateway.", required=True)
    name = graphene.String(description="Payment gateway name.", required=True)
    data = graphene.JSONString(description="Initialized data by gateway.", required=False)
