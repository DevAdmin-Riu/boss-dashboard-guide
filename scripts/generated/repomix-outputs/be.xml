from django.core.exceptions import ValidationError
from django.db import models

from saleor.account.models import User
from saleor.schedule import RepeatAnchorType, RepeatType

from .utils import generate_alarm_datetimes


class Schedule(models.Model):
    created_at = models.DateTimeField(auto_now_add=True)
    start = models.DateTimeField()
    end = models.DateTimeField()

    title = models.CharField(max_length=200)
    description = models.TextField(null=True, blank=True)

    repeat_type = models.CharField(
        max_length=10, choices=RepeatType.choices, default=RepeatType.NONE
    )
    # 반복 간격: 몇 일/주/달/년마다 반복할지 (기본 1)
    repeat_interval = models.PositiveSmallIntegerField(default=1)
    # 반복 종료일 (null이면 무한 반복)
    repeat_until = models.DateField(null=True, blank=True)
    # 반복 기준: 날짜 기준(day), 요일 기준(weekday)
    # 월간 반복일 때만 의미 있음
    repeat_anchor_type = models.CharField(
        max_length=10, choices=RepeatAnchorType.choices, default=RepeatAnchorType.NONE
    )

    # 알람 설정
    has_alarm = models.BooleanField(default=False)
    # 알람 시간: 몇 분 전에 알람을 전송할지
    alarm_offset_minutes = models.PositiveSmallIntegerField(null=True, blank=True)

    writer = models.ForeignKey(
        User,
        related_name="created_schedules",
        on_delete=models.CASCADE,
    )
    participants = models.ManyToManyField(
        User,
        related_name="participating_schedules",
        through="ScheduleParticipant",
        through_fields=("schedule", "participant"),
        blank=True,
    )

    def save(self, *args, **kwargs):
        alarm_fields = [
            "start",
            "repeat_type",
            "repeat_interval",
            "repeat_until",
            "repeat_anchor_type",
            "has_alarm",
            "alarm_offset_minutes",
        ]
        should_update_alarms = False

        if self.pk:
            old = Schedule.objects.get(pk=self.pk)
            for field in alarm_fields:
                if getattr(old, field) != getattr(self, field):
                    should_update_alarms = True
                    break
        else:
            # 신규 생성 시
            should_update_alarms = True

        super().save(*args, **kwargs)

        if should_update_alarms:
            ScheduleAlarm.objects.filter(schedule=self).delete()

            alarm_dts = generate_alarm_datetimes(self)
            alarms = [
                ScheduleAlarm(schedule=self, alarm_datetime=alarm_dt) for alarm_dt in alarm_dts
            ]
            ScheduleAlarm.objects.bulk_create(alarms)

    def clean(self):
        super().clean()

        if self.start.minute % 30 != 0:
            raise ValidationError("시작 시각은 30분 단위만 허용됩니다.")

        if self.repeat_type != RepeatType.NONE:
            if self.repeat_interval is None:
                raise ValidationError("일정을 반복할 경우, 반복 간격을 입력해야 합니다.")

            if self.repeat_type == RepeatType.MONTHLY:
                if self.repeat_anchor_type is None:
                    raise ValidationError("월간 반복일 경우, 반복 기준을 입력해야 합니다.")

        if self.has_alarm:
            if self.alarm_offset_minutes is None:
                raise ValidationError("알람을 설정할 경우, 알람 시간을 입력해야 합니다.")
            if self.alarm_offset_minutes % 15 != 0:
                raise ValidationError("알림 시간은 15분 단위만 허용됩니다.")
            if not (0 < self.alarm_offset_minutes <= 60 * 24):
                raise ValidationError("알람 시간은 최소 15분에서 최대 24시간까지 입력 가능합니다.")

    class Meta:
        ordering = ("start",)


class ScheduleParticipant(models.Model):
    schedule = models.ForeignKey(Schedule, on_delete=models.CASCADE)
    participant = models.ForeignKey(User, on_delete=models.CASCADE)

    class Meta:
        ordering = ("-pk",)
        constraints = [
            models.UniqueConstraint(
                fields=["schedule", "participant"], name="unique_schedule_participant"
            ),
