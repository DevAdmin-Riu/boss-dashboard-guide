class OuterVisibleProductsByCategoryIdLoader(DataLoader):
    context_key = "outer_visible_products_by_category_id"

    def batch_load(self, keys):
        brand_store_owner_user = self.brand_store_owner_user
        brand_id = brand_store_owner_user.switched_brand_id

        # 1. 모든 카테고리 한 번에 쿼리
        categories = list(Category.objects.all())

        # 2. 각 카테고리별로 상위까지 포함된 id 집합 생성
        # get_descendants를 사용하면 카테고리마다 쿼리가 발생하므로, 상위/하위 카테고리를 직접 처리
        parent_map = {category.id: category.parent_id for category in categories}
        descendants_map = {key: set() for key in keys}

        for category in categories:
            category_id = category.id
            # 각 카테고리가 keys 중 하나의 하위에 포함되는지 확인
            while category_id:
                if category_id in keys:
                    descendants_map[category_id].add(category.id)
                category_id = parent_map.get(category_id)

        # 3. 모든 관련 제품 한 번에 쿼리
        all_category_ids = set()
        for ids in descendants_map.values():
            all_category_ids.update(ids)

        qs: ProductsQueryset = Product.objects
        products = list(
            qs.outer_visible_to_user(brand_store_owner_user)
            .filter(category_id__in=all_category_ids)
            .prefetch_related(
                # resolver에서 소팅을 위해서 brand_products를 가지고 온다.
                Prefetch(
                    "brand_products",
                    queryset=BrandProduct.objects.filter(brand_id=brand_id).only(
                        "id", "sort_order", "product_id"
                    ),
                    to_attr="brand_product",
                )
            )
            .distinct()
        )

        # 4. 카테고리별로 제품 매핑
        product_map = {key: [] for key in keys}
        for product in products:
            for key, ids in descendants_map.items():
                if product.category_id in ids:
                    product_map[key].append(product)

        # 5. 카테고리별 제품 리스트 반환
        return [product_map.get(key, []) for key in keys]


class VisibleBpBundlesByCategoryIdLoader(DataLoader):
    context_key = "visible_bp_bundles_by_category_id"

    def batch_load(self, keys):
        brand_store_owner_user = self.brand_store_owner_user

        # 1. 모든 카테고리 한 번에 쿼리
        categories = list(Category.objects.all())

        # 2. 각 카테고리별로 상위까지 포함된 id 집합 생성
        # get_descendants를 사용하면 카테고리마다 쿼리가 발생하므로, 상위/하위 카테고리를 직접 처리
        parent_map = {category.id: category.parent_id for category in categories}
        descendants_map = {key: set() for key in keys}

        for category in categories:
            category_id = category.id
            # 각 카테고리가 keys 중 하나의 하위에 포함되는지 확인
            while category_id:
                if category_id in keys:
                    descendants_map[category_id].add(category.id)
                category_id = parent_map.get(category_id)

        # 3. 모든 관련 제품 한 번에 쿼리
        all_category_ids = set()
        for ids in descendants_map.values():
            all_category_ids.update(ids)

        qs: BpBundleQueryset = BpBundle.objects
        bp_bundles = list(
            qs.visible_to_user(brand_store_owner_user)
            .filter(
                bp_bundle_infos__is_main=True,
                bp_bundle_infos__pv__product__category_id__in=all_category_ids,
            )
            .prefetch_related("bp_bundle_infos__pv__product")
            .distinct()
        )

        # 4. 카테고리별로 제품 매핑
        bp_bundle_map = {key: [] for key in keys}
        for bp_bundle in bp_bundles:
            # prefetch 된 bp_bundle_infos 사용 → 추가 쿼리 없음
            main_info = next(
                (info for info in bp_bundle.bp_bundle_infos.all() if info.is_main), None
            )

            if not main_info:
                continue  # 대표 구성품이 없으면 스킵

            category_id = main_info.pv.product.category_id
            for key, ids in descendants_map.items():
                if category_id in ids:
                    bp_bundle_map[key].append(bp_bundle)

        # 5. 카테고리별 제품 리스트 반환
        return [bp_bundle_map.get(key, []) for key in keys]


