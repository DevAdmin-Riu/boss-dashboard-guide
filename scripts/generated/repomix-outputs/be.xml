            graphene.ID,
            required=True,
            description="배송 완료 처리할 발주 품목 ID 리스트",
        )

    class Meta:
        description = "발주 품목 배송 완료 처리"
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_vender(cls, user: User, purchase_order_lines: List[PurchaseOrderLineModel]):
        if user.is_vendor_staff == False or user.is_staff:
            return
        invalid_po_lines = [
            line for line in purchase_order_lines if line.purchase_order.vendor != user.vendor
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(f"다른 협력사 제품을 배송 완료할 수 없습니다. {invalid_codes}")

    @classmethod
    def validate_po_type(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.purchase_order.is_take_back_po
            or line.purchase_order.is_consignment_take_back_po
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(f"반품 발주서는 접수 시 반품 완료 처리됩니다. {invalid_codes}")

    @classmethod
    def validate_status(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if (
                line.purchase_order.is_track_inventory_po
                and line.status not in [PurchaseOrderLineStatus.STOCKED]
            )
            or (
                line.purchase_order.is_consignment_po
                and line.status not in [PurchaseOrderLineStatus.INVOICE_PRINTED]
            )
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(
                f"배송 완료할 수 없는 상태의 발주 품목이 존재합니다. {invalid_codes}"
            )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_line_ids):
        user: "User" = info.context.user
        purchase_order_lines: List[PurchaseOrderLineModel] = cls.get_nodes_or_error(
            purchase_order_line_ids,
            "purchase_order_line_ids",
            PurchaseOrderLine,
            qs=models.PurchaseOrderLine.objects.select_related("purchase_order", "order_line"),
        )
        cls.validate_po_type(purchase_order_lines)
        cls.validate_status(purchase_order_lines)
        cls.validate_vender(user, purchase_order_lines)

        update_po_lines = []
        for po_line in purchase_order_lines:
            po_line.status = PurchaseOrderLineStatus.DELIVERED
            update_po_lines.append(po_line)

        if update_po_lines:
            models.PurchaseOrderLine.objects.bulk_update(update_po_lines, ["status"])

            add_po_manage_event_with_type(
                user, purchase_order_lines, PurchaseOrderManageEventType.DELIVERED
            )
            bulk_create_po_line_status_histories(
                purchase_order_lines,
                before_status=PurchaseOrderLineStatus.STOCKED,
                after_status=PurchaseOrderLineStatus.DELIVERED,
                user=user,
            )

            b2b_order_lines = [
                line.order_line
                for line in purchase_order_lines
                if line.purchase_order.is_b2b == True
            ]
            b2b_order_line_ids = [instance.pk for instance in b2b_order_lines]
            order_models.OrderLine.objects.filter(pk__in=b2b_order_line_ids).update(
                b2b_status=OrderLineB2bStatus.COMPLETED
            )
            order_b2b_completed_event(user=user, order_lines=b2b_order_lines)
            bulk_create_order_line_b2b_status_histories(
                b2b_order_lines,
                before_status=OrderLineB2bStatus.DISPATCH_FULFILLMENT,
                after_status=OrderLineB2bStatus.COMPLETED,
                user=user,
            )
            update_sales_b2b_order_completed_at(b2b_order_lines)

        return PurchaseOrderLinesDelivered(purchase_order_lines=purchase_order_lines)


class PurchaseOrderLinesRevertInput(graphene.InputObjectType):
    purchase_order_line_ids = graphene.List(
        graphene.ID,
        required=True,
        description="상태 되돌리기 할 발주 품목 ID 리스트",
    )
    before_status = PurchaseOrderLineStatusEnum(required=True, description="현재 상태")
    after_status = PurchaseOrderLineStatusEnum(required=True, description="되돌려질 상태")


class PurchaseOrderLinesRevert(BaseMutation):
    purchase_order_lines = graphene.List(PurchaseOrderLine)

    class Arguments:
        input = PurchaseOrderLinesRevertInput(required=True, description="발주서 상태 되돌리기")

    class Meta:
        description = "발주 품목 상태 되돌리기 처리"
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_status(
        cls,
        po_lines: List[PurchaseOrderLineModel],
        before_status: PurchaseOrderLineStatus,
        after_status: PurchaseOrderLineStatus,
    ):
        possible_list = [
            (PurchaseOrderLineStatus.RECEIVED, PurchaseOrderLineStatus.PENDING),
            (PurchaseOrderLineStatus.DISPATCH_FULFILLMENT, PurchaseOrderLineStatus.RECEIVED),
            (
                PurchaseOrderLineStatus.DELIVERY_CONFIRMED,
                PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
            ),
            (PurchaseOrderLineStatus.INVOICE_PRINTED, PurchaseOrderLineStatus.DELIVERY_CONFIRMED),
            (PurchaseOrderLineStatus.INSPECTED, PurchaseOrderLineStatus.DELIVERY_CONFIRMED),
            (PurchaseOrderLineStatus.TO_BE_INSPECTED, PurchaseOrderLineStatus.DELIVERY_CONFIRMED),
            (PurchaseOrderLineStatus.INSPECTED, PurchaseOrderLineStatus.TO_BE_INSPECTED),
        ]
        if (before_status, after_status) not in possible_list:
            raise ValidationError(
                f"발주 상태 되돌리기 불가능한 요청입니다. {before_status.label} -> {after_status.label}"
            )
        invalid_po_lines = [line for line in po_lines if line.status != before_status]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(
                f"요청한 현재 상태와 일치하지 않는 발주 품목이 존재합니다. {invalid_codes}"
            )

    # 매출 정산, 세금계산서 발행등이 진행된 후에 되돌리기 할 경우 고려할 사항이 너무 많아서 정책 부재로 납품 시 금액확정 제품의 발주서 출고 취소는 차단 시켜놓음
    @classmethod
    def validate_is_adjust_price(
        cls,
        po_lines: List[PurchaseOrderLineModel],
        after_status: PurchaseOrderLineStatus,
    ):
        first_po = po_lines[0].purchase_order
        if first_po.is_consignment_po and after_status == PurchaseOrderLineStatus.RECEIVED:
            invalid_po_lines = [line for line in po_lines if line.variant.is_adjust_price]
            if invalid_po_lines:
                invalid_codes = ", ".join([line.code for line in invalid_po_lines])
                raise ValidationError(
                    f"납품 시 금액확정 제품의 발주서에 대해서 출고 취소 할 수 없습니다. {invalid_codes}"
                )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        purchase_order_line_ids = input_data.get("purchase_order_line_ids")
        before_status = input_data.get("before_status")
        after_status = input_data.get("after_status")
        user: "User" = info.context.user
        po_lines: List[PurchaseOrderLineModel] = cls.get_nodes_or_error(
            purchase_order_line_ids,
            "purchase_order_line_ids",
            PurchaseOrderLine,
            qs=models.PurchaseOrderLine.objects.select_related("purchase_order"),
        )
        if not po_lines:
            raise ValidationError("상태 되돌리기 발주 품목 리스트를 확인하세요.")

        cls.validate_status(po_lines, before_status, after_status)
        cls.validate_is_adjust_price(po_lines, after_status)
        po_line_ids = [po_line.pk for po_line in po_lines]

        models.PurchaseOrderLine.objects.filter(pk__in=po_line_ids).update(status=after_status)
        add_po_manage_event_on_reverted(user, po_lines, before_status, after_status)
        bulk_create_po_line_status_histories(
            po_lines,
            before_status=before_status,
            after_status=after_status,
            user=user,
        )
        # 재고발주/위탁발주/B2B발주 메뉴에서 각각 요청되는 것만 고려하므로 첫번째 발주품목의 발주서를 대표로 발주타입만 사용해도 무방함
        first_po = po_lines[0].purchase_order

        if first_po.is_track_inventory_po:
            # 거래명세서 출력 -> 배송확정으로 되돌리기는 리우 담당자가 수행해서 협력사가 다음액션을 하는 변경이어서 알림을 보냄
            # 나머지 되돌리기는 협력사 액션 사이클에서의 되돌리기여서 알림 처리 안함
            if after_status == PurchaseOrderLineStatus.DELIVERY_CONFIRMED:
                # po_lines.status 는 refresh_from_db 로 새로 가져와야 변경되므로 이메일에 변경 후 상태로 표시하기 위해 첫번째 것만 수동 변경 처리
                po_lines[0].status = PurchaseOrderLineStatus.DELIVERY_CONFIRMED
                send_notice_po_reverted_to_vendor(info, po_lines, bulk_receiver_phone_mode=True)
            elif after_status == PurchaseOrderLineStatus.TO_BE_INSPECTED:
                cancel_latest_po_line_inspects(po_line_ids)

        if first_po.is_consignment_po:
            if after_status == PurchaseOrderLineStatus.RECEIVED:
                revert_consignment_po_to_received(user, po_lines)
            elif after_status == PurchaseOrderLineStatus.DISPATCH_FULFILLMENT:
                revert_consignment_po_to_dispatch_fulfillment(user, po_lines)

        if before_status == PurchaseOrderLineStatus.INVOICE_PRINTED:
            b2b_order_lines = [
                line.order_line for line in po_lines if line.purchase_order.is_b2b == True
            ]
            reset_sales_b2b_invoice_printed_at(b2b_order_lines)

        return PurchaseOrderLinesRevert(purchase_order_lines=po_lines)


class PurchaseOrderLinesCancel(BaseMutation):
    purchase_order_lines = graphene.List(PurchaseOrderLine)

    class Arguments:
        purchase_order_line_ids = graphene.List(
            graphene.ID,
            required=True,
            description="취소 처리할 발주 품목 ID 리스트",
        )

    class Meta:
        description = "발주 품목 취소 처리"
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_status(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.status
            not in [
                # 운영 Admin 에서는 대기 상태에서도 발주 취소 가능, (협력사는 취소 불가)
                PurchaseOrderLineStatus.PENDING,
                PurchaseOrderLineStatus.REJECTED,
                PurchaseOrderLineStatus.REQ_EPD_UPDATE,
                PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
            ]
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(f"취소할 수 없는 상태의 발주 품목이 존재합니다. {invalid_codes}")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_line_ids):
        user: "User" = info.context.user
        purchase_order_lines: List[PurchaseOrderLineModel] = cls.get_nodes_or_error(
            purchase_order_line_ids, "purchase_order_line_ids", PurchaseOrderLine
        )
        cls.validate_status(purchase_order_lines)
        target_instance_ids = [po_line.pk for po_line in purchase_order_lines]
        before_status_list = [po_line.status for po_line in purchase_order_lines]
        # 발주 취소는 단 건씩 취소되므로 아래와 같이 처리해도 무방함
        bulk_receiver_phone_mode = any(
            status == PurchaseOrderLineStatus.REJECTED for status in before_status_list
        )
        models.PurchaseOrderLine.objects.filter(pk__in=target_instance_ids).update(
            status=PurchaseOrderLineStatus.CANCELED
        )
        add_po_manage_event_with_type(
            user, purchase_order_lines, PurchaseOrderManageEventType.CANCELED
        )
        bulk_create_po_line_status_histories(
            purchase_order_lines,
            before_status_list=before_status_list,
            after_status=PurchaseOrderLineStatus.CANCELED,
            user=user,
        )
        send_notice_po_canceled_to_vendor(
            info, purchase_order_lines, bulk_receiver_phone_mode=bulk_receiver_phone_mode
        )
        return PurchaseOrderLinesCancel(purchase_order_lines=purchase_order_lines)


class PurchaseOrderLinesAdd(BaseMutation):
    purchase_order = graphene.Field(PurchaseOrder, description="An added purchase order.")

    class Arguments:
        purchase_order_id = graphene.ID(description="The ID of the purchase order.", required=True)
        lines = graphene.List(
            PurchaseOrderLineAddInput,
            required=True,
            description="발주서에 추가할 발주제품 리스트",
        )

    class Meta:
        description = "Adds a purchase order line to the existing purchase order."
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @staticmethod
    def add_purchase_order_lines(
        cls, info, purchase_order: Optional[PurchaseOrderModel], lines: List[Dict]
    ):
        if not purchase_order:
            raise ValidationError("발주제품 추가에 실패했습니다. 대상 발주서를 찾을 수 없습니다.")

        is_track_inventory_po = purchase_order.is_track_inventory_po
        is_take_back_po = purchase_order.is_take_back_po
        is_consignment_po = purchase_order.is_consignment_po
        is_consignment_take_back_po = purchase_order.is_consignment_take_back_po
        is_take_back = is_take_back_po or is_consignment_take_back_po

        if is_track_inventory_po == False and not len(lines):
            raise ValidationError("위탁 발주, 반품 발주서 생성 시에는 발주제품을 추가해주세요.")

        is_b2b = purchase_order.is_b2b

        user = info.context.user
        vendor = purchase_order.vendor
        purchase_order_lines = []
        qty_zero_errors = []
        variant_vendor_errors = []
        is_stopped_errors = []
        dev_cost_errors = []
        order_line_errors = []
        charge_status_errors = []
        take_back_po_line_errors = []
        take_back_qty_errors = []
        cost_price_zero_errors = []
        for line_data in lines:
            variant_id = line_data.get("variant_id")
            variant: ProductVariantModel = cls.get_node_or_error(
                info,
                variant_id,
                only_type=ProductVariant,
                field="variant_id",
            )

            quantity = line_data.get("quantity")
            if quantity <= 0:
                qty_zero_errors.append(variant.sku)
                continue

            variant_vendor = ProductVariantVendor.objects.filter(
                product_variant=variant, vendor=vendor
            ).first()

            if variant_vendor is None or variant_vendor.is_active == False:
                variant_vendor_errors.append(variant.sku)
                continue

            is_stopped = variant.is_stopped
            if is_track_inventory_po and is_stopped:
                is_stopped_errors.append(variant.sku)
                continue

            product_name = variant.product.name
            product_sku = variant.sku
            variant_name = variant.name

            cost_price_exclude_vat = line_data.get("cost_price_exclude_vat")
            if cost_price_exclude_vat <= 0:
                cost_price_zero_errors.append(variant.sku)
                continue

            etc_exclude_vat = line_data.get("etc_exclude_vat")
            b2b_delivery_fee_exclude_vat = line_data.get("b2b_delivery_fee_exclude_vat", 0)
            take_back_unit_cost_delivery_fee_exclude_vat = line_data.get(
                "take_back_unit_cost_delivery_fee_exclude_vat", 0
            )
            note = line_data.get("note")
            asking_purchase_date = line_data.get("asking_purchase_date")
            # 입고예정일을 입고요청일과 처음에 동일하게 세팅한다.
            expected_purchase_date = asking_purchase_date

            product_price_exclude_vat = 0
            delivery_fee_exclude_vat = 0
            if is_consignment_po:
                product_price_exclude_vat = variant_vendor.consignment_product_price_exclude_vat
                delivery_fee_exclude_vat = variant_vendor.consignment_delivery_fee_exclude_vat
            elif is_consignment_take_back_po:
                product_price_exclude_vat = cost_price_exclude_vat
                # 위탁 반품 발주인 경우 배송비는 회수 못하는 항목이므로 0으로 처리.
                delivery_fee_exclude_vat = 0

            is_tax_free = variant.product.is_tax_free

            vat_amount = calc_po_line_vat_amount(
                quantity,
                cost_price_exclude_vat,
                etc_exclude_vat,
                take_back_unit_cost_delivery_fee_exclude_vat,
                b2b_delivery_fee_exclude_vat,
                is_tax_free,
            )

            if is_take_back_po:
                # 재고 반품 발주서의 재고 감소는 발주제품 접수 시점으로 이동
                rack_location_id = line_data.get("rack_location")
                _, rack_location_pk = graphene.Node.from_global_id(rack_location_id)
                take_back_purchase_order_line_id = line_data.get("take_back_purchase_order_line_id")
                _, take_back_purchase_order_line_pk = graphene.Node.from_global_id(
                    take_back_purchase_order_line_id
                )
            else:
                rack_location_pk = None
                take_back_purchase_order_line_pk = None

            defaults = {
                "asking_purchase_date": asking_purchase_date,
                "expected_purchase_date": expected_purchase_date,
                "product_name": product_name,
                "product_sku": product_sku,
                "external_product_name": variant_vendor.external_product_name,
                "external_sku": variant_vendor.external_sku,
                "variant_name": variant_name,
                "attribute_data": convert_to_simple_attribute(variant),
                "quantity": quantity,
                "product_price_exclude_vat": product_price_exclude_vat,
                "delivery_fee_exclude_vat": delivery_fee_exclude_vat,
                "cost_price_exclude_vat": cost_price_exclude_vat,
                "etc_exclude_vat": etc_exclude_vat,
                "b2b_delivery_fee_exclude_vat": b2b_delivery_fee_exclude_vat,
                # 위탁반품시에 입력 할수 있는 값.
                "take_back_unit_cost_delivery_fee_exclude_vat": take_back_unit_cost_delivery_fee_exclude_vat,
                "vat_amount": vat_amount,
                "is_tax_free": is_tax_free,
                "note": note,
                "status": PurchaseOrderLineStatus.DRAFT,
            }

            order_line = None
            if is_track_inventory_po == False:
                # 위탁 발주인 경우에는 출고 시점에 입고일 세팅
                if is_consignment_po == False:
                    defaults["purchase_date"] = asking_purchase_date
                defaults["purchase_user"] = user
                defaults["purchase_quantity"] = quantity

                if is_consignment_po or is_consignment_take_back_po:
                    order_line_id = line_data.get("order_line_id")
                    order_line: OrderLineModel = cls.get_node_or_error(
                        info,
                        order_line_id,
                        only_type=OrderLine,
                        field="order_line_id",
                    )
                    if order_line is None:
                        order_line_errors.append(variant.sku)
                        continue

                    order = order_line.order
                    payment = order.get_last_payment()
                    charge_status = payment.charge_status
                    # 위탁 택배 주문은 결제 완료 단계에서만 발주서 등록이 가능
                    if (
                        is_consignment_po
                        and order.delivery_method in [OrderDeliveryMethods.BY_COURIER]
                        and charge_status
                        in [
                            ChargeStatus.PENDING,
                            ChargeStatus.BEING_APPROVED,
                        ]
                    ):
                        charge_status_errors.append(str(order))
                        continue

                    defaults["shipping_address"] = order.shipping_address
                    if (
                        is_b2b == False
                        and is_consignment_po
                        and check_charge_delivery_additional_fee(order.shipping_address)
                    ):
                        defaults["consignment_unit_delivery_additional_fee_exclude_vat"] = (
                            vendor.consignment_unit_delivery_additional_fee_exclude_vat
                        )

            purchase_order_line, _ = purchase_order.lines.update_or_create(
                purchase_order=purchase_order,
                variant=variant,
                order_line=order_line,
                take_back_rack_location_id=rack_location_pk,
                take_back_purchase_order_line_id=take_back_purchase_order_line_pk,
                defaults=defaults,
            )
            purchase_order_lines.append(purchase_order_line)

            if order_line:
                update_order_line_by_purchase_order_line(order_line, purchase_order_line)
            elif is_take_back and is_b2b == False:
                take_back_purchase_order_line: PurchaseOrderLineModel = cls.get_node_or_error(
                    info,
                    line_data.get("take_back_purchase_order_line_id"),
                    only_type=PurchaseOrderLine,
                )
                if take_back_purchase_order_line is None:
                    take_back_po_line_errors.append(variant.sku)
                    continue

                if is_consignment_take_back_po:
                    if (
                        take_back_purchase_order_line.purchase_quantity
                        - take_back_purchase_order_line.take_back_quantity
                        < quantity
                    ):
                        take_back_qty_errors.append(variant.sku)
                        continue
                    take_back_purchase_order_line.take_back_quantity += quantity
                    take_back_purchase_order_line.save(update_fields=["take_back_quantity"])
                else:
                    try:
                        remain_quantity = take_back_purchase_order_line.stock_detail.remain_quantity
                    except Exception as E:
                        remain_quantity = 0

                    if remain_quantity < quantity:
                        take_back_qty_errors.append(variant.sku)
                        continue

        if (
            qty_zero_errors
            or variant_vendor_errors
            or cost_price_zero_errors
            or is_stopped_errors
            or dev_cost_errors
            or order_line_errors
            or charge_status_errors
            or take_back_po_line_errors
            or take_back_qty_errors
        ):
            error_msg = ""
            if qty_zero_errors:
                error_msg += (
                    f"▶ 발주 수량이 0인 제품이 있습니다. 제품코드: {', '.join(qty_zero_errors)}\n"
                )
            if variant_vendor_errors:
                error_msg += f"▶ 옵션 제품-협력사 관계가 없거나 비활성화된 협력사로 발주 품목으로 추가할 수 없습니다. 제품코드: {', '.join(variant_vendor_errors)}\n"
            if cost_price_zero_errors:
                error_msg += f"▶ 매입가가 0원인 발주제품이 존재합니다. 해당 제품의 협력사 매입가를 다시 확인해주세요. 제품코드: {', '.join(cost_price_zero_errors)}\n"
            if is_stopped_errors:
                error_msg += (
                    f"▶ 단종된 제품이 존재합니다. 제품코드: {', '.join(is_stopped_errors)}\n"
                )
            if dev_cost_errors:
                error_msg += f"▶ 개발비가 0원이 아닌 발주제품이 존재합니다. 제품코드: {', '.join(dev_cost_errors)}\n"
            if order_line_errors:
                error_msg += f"▶ 위탁 발주제품의 order line id가 유효하지 않습니다. 제품코드: {', '.join(order_line_errors)}\n"
            if charge_status_errors:
                error_msg += f"▶ 결제가 완료되지 않은 위탁 택배주문은 발주서에 추가할 수 없습니다. 주문번호: {', '.join(charge_status_errors)}\n"
            if take_back_po_line_errors:
                error_msg += f"▶ 반품 발주제품의 반품 대상 발주제품 id가 유효하지 않습니다. 제품코드: {', '.join(take_back_po_line_errors)}\n"
            if take_back_qty_errors:
                error_msg += f"▶ 반품 발주제품의 반품 수량이 잔여 입고 수량보다 크게 입력되었습니다. 제품코드: {', '.join(take_back_qty_errors)}\n"
            raise ValidationError(error_msg)

        bulk_create_po_line_status_histories(
            purchase_order_lines,
            before_status=None,
            after_status=PurchaseOrderLineStatus.DRAFT,
            user=user,
        )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_id, lines):
        purchase_order: PurchaseOrderModel = cls.get_node_or_error(
            info, purchase_order_id, only_type=PurchaseOrder, field="purchase_order_id"
        )
        PurchaseOrderLinesAdd.add_purchase_order_lines(cls, info, purchase_order, lines)
        return PurchaseOrderLinesAdd(purchase_order=purchase_order)


