    if message is None:
        message = default_message
    cls_info = cls.__name__ if cls else ""
    fn_info = fn.__name__ if fn else ""
    # AnonymousUser 처리 추가
    if user != AnonymousUser():
        user_info = user.login_id
    else:
        user_info = "AnonymousUser" if user else ""
    denied_message = f"{user_info} {cls_info}.{fn_info} - {message}"
    return denied_message


class PermissionDenied(Exception):
    def __init__(self, message=None, fn=None, cls=None, user=None):
