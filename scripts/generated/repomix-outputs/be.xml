        models.BrandProduct.id.field,
        models.BrandProduct.search_vector.field,
    ]
    EXCLUDE_FIELDS_FOR_BRAND_VARIANT = [
        models.BrandProductVariant.id.field,
    ]

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        updated_bp = None
        updated_bpv = None

        brand_product_id = data.get("brand_product_id")
        brand_product_input = data.get("brand_product_input")
        brand_product_variant_id = data.get("brand_product_variant_id")
        brand_product_variant_input = data.get("brand_product_variant_input")
        manage_event = data.get("manage_event")

        before_brand_product = (
            cls.get_node_or_error(
                info, brand_product_id, field="brand_product_id", only_type=BrandProduct
            )
            if brand_product_id
            else None
        )
        before_brand_variant = (
            cls.get_node_or_error(
                info,
                brand_product_variant_id,
                field="brand_product_variant_id",
                only_type=BrandProductVariant,
            )
            if brand_product_variant_id
            else None
        )

        if brand_product_id and brand_product_input:
            brand_product_update_result = BrandUpdateProduct.perform_mutation(
                root, info, id=brand_product_id, input=brand_product_input
            )
            updated_bp = brand_product_update_result.brandProduct

        if brand_product_variant_id and brand_product_variant_input:
            brand_product_variant_update_result = BrandUpdateProductVariant.perform_mutation(
                root, info, id=brand_product_variant_id, input=brand_product_variant_input
            )
            updated_bpv = brand_product_variant_update_result.brandProductVariant
            updated_bp = updated_bpv.brand_product

        if manage_event:
            brand_product_changes = generate_change_summary(
                before_brand_product,
                updated_bp,
                None,
                None,
                cls.EXCLUDE_FIELDS_FOR_BRAND_PRODUCT,
                cls.FIELD_NAME_MAPPING_FOR_BRAND_PRODUCT,
                True,
            )
            brand_variant_changes = generate_change_summary(
                before_brand_variant,
                updated_bpv,
                None,
                None,
                cls.EXCLUDE_FIELDS_FOR_BRAND_VARIANT,
                cls.FIELD_NAME_MAPPING_FOR_BRAND_VARIANT,
                True,
            )
            change_details = "\n".join(brand_product_changes + brand_variant_changes)
            manage_event["change_details"] = change_details
            add_bpv_manage_event(bpv=updated_bpv, manage_event=manage_event, info=info)

        return ExtendedBrandProductUpdate(
            brand_product=updated_bp, brand_product_variant=updated_bpv
        )
