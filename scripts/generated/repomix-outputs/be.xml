from typing import List

import graphene
from django.db.models import F, Func, Min, Sum

from saleor.order.tasks import send_sweet_tracker_request
from saleor.plugins.manager import get_plugins_manager

from ...order import OrderStatus, models
from ...order.events import OrderEvents
from ...order.models import FulfillmentLine, OrderEvent
from ...order.utils import sum_order_totals, sum_total_captured
from ...payment import ChargeStatus
from ..account.filters import get_brand_id_from_query
from ..utils.filters import filter_by_period
from .filters import (
    FulfillmentFilter,
    FulfillmentLineFilter,
    OrderFilter,
    annotate_order_line_ordered_or_fulfill_qty,
)
from .types import (
    FulfillmentLinesGroupByVariant,
    FulfillmentTrackingInfo,
    Order,
    ProductVariantQuantity,
)

ORDER_SEARCH_FIELDS = ("id", "token", "user__email")


def resolve_orders(info, **_kwargs):
    qs = models.Order.objects.all().distinct()
    return qs


def resolve_order_lines(info, **_kwargs):
    qs = (
        models.OrderLine.objects.prefetch_related(
            "fulfillment_lines", "fulfillment_lines__fulfillment"
        )
        .all()
        .distinct()
    )
    return qs


def resolve_refunded_order_lines(info, **_kwargs):
    return models.RefundOrderLine.objects.all().distinct()


def resolve_brand_orders(info, global_brand_id, **_kwargs):
    brand_id = get_brand_id_from_query(global_brand_id)
    qs = models.Order.objects.filter(brand=brand_id).distinct()
    return qs


def resolve_orders_total(_info, period):
    qs = models.Order.objects.exclude(status=OrderStatus.CANCELED)
    qs = filter_by_period(qs, period, "created")
    return sum_order_totals(qs)


def resolve_brand_orders_total(_info, brand_id, created, period):
    brand_id = get_brand_id_from_query(brand_id)
    qs = models.Order.objects.filter(brand_id=brand_id).exclude(status=OrderStatus.CANCELED)
    if period:
        qs = filter_by_period(qs, period, "created")
    elif created:
        qs = OrderFilter.filter_created_range(qs, "", created)
    return sum_order_totals(qs)


def resolve_brand_orders_total_captured(_info, brand_id, created, period):
    brand_id = get_brand_id_from_query(brand_id)
    qs = models.Order.objects.filter(brand_id=brand_id).exclude(status=OrderStatus.CANCELED)
    if period:
        qs = filter_by_period(qs, period, "created")
    elif created:
        qs = OrderFilter.filter_created_range(qs, "", created)
    return sum_total_captured(qs)


def resolve_unfulfilled_product_variants():
    charge_statuses = {ChargeStatus.FULLY_CHARGED, ChargeStatus.PARTIALLY_REFUNDED}
    qs = (
        models.OrderLine.objects.select_related("variant")
        .filter(
            order__payments__is_active=True,
            order__payments__charge_status__in=charge_statuses,
        )
        .exclude(track_inventory=False)
        .exclude(order__status=OrderStatus.CANCELED)
    )
    qs = annotate_order_line_ordered_or_fulfill_qty(qs)
    unfulfilled_quantities = (
        qs.filter(ordered_or_fulfill_qty__gt=F("quantity_fulfilled") + F("quantity_refunded"))
        .values("variant_id")
        .annotate(
            total_quantity=Sum("ordered_or_fulfill_qty"),
            total_quantity_fulfilled=Sum("quantity_fulfilled"),
            total_quantity_refunded=Sum("quantity_refunded"),
        )
        .annotate(
            quantity_unfulfilled=Func(
                F("total_quantity") - F("total_quantity_fulfilled") - F("total_quantity_refunded"),
                function="GREATEST",
                template="%(function)s(%(expressions)s, 0)",
            )
        )
        .values("variant_id", "quantity_unfulfilled", "variant__sku")
        .order_by("variant_id")
    )
    return [
        ProductVariantQuantity(
            variant_id=graphene.Node.to_global_id("ProductVariant", item["variant_id"]),
            sku=item["variant__sku"],
            quantity_unfulfilled=item["quantity_unfulfilled"],
        )
        for item in unfulfilled_quantities
    ]


def resolve_order(info, order_id):
    return graphene.Node.get_node_from_global_id(info, order_id, Order)


def resolve_homepage_events():
    # Filter only selected events to be displayed on homepage.
    types = [
        OrderEvents.PLACED,
        OrderEvents.ORDER_FULLY_PAID,
    ]
    return OrderEvent.objects.filter(type__in=types)


def resolve_order_by_token(token):
    return models.Order.objects.all().filter(token=token).first()


def resolve_fulfillment(info, order_id):
    return graphene.Node.get_node_from_global_id(info, order_id, Order)


def resolve_fulfillments(info, created, status, **_kwargs):
    return models.Fulfillment.objects.all().distinct()


def resolve_fulfillment_lines(info, **_kwargs):
    return models.FulfillmentLine.objects.all().distinct()


def resolve_fulfillment_lines_by_variant(
    info, fulfillment_filter, fulfillment_line_filter, is_inspect_completed
):
    fulfillments_qs = models.Fulfillment.objects.all()
    if fulfillment_filter:
        fulfillments_qs = FulfillmentFilter(data=fulfillment_filter, queryset=fulfillments_qs).qs

    fulfillment_lines_qs = models.FulfillmentLine.objects.all()
    if fulfillment_line_filter:
        fulfillment_lines_qs = FulfillmentLineFilter(
            data=fulfillment_line_filter, queryset=fulfillment_lines_qs
        ).qs

    # variant별로 집계
    variant_agg = (
        fulfillment_lines_qs.filter(fulfillment__in=fulfillments_qs)
        .values("order_line__variant")
        .annotate(
            total_quantity=Sum("quantity"),
            total_inspected_qty=Sum("inspected_qty"),
        )
    )

    if is_inspect_completed:
        variant_agg = variant_agg.filter(total_quantity=F("total_inspected_qty"))
    else:
        variant_agg = variant_agg.exclude(total_quantity=F("total_inspected_qty"))

    # 필요한 variant id만 추출
    variant_ids = [item["order_line__variant"] for item in variant_agg]

    # 해당 variant의 fulfillment_lines만 다시 조회
    fulfillment_lines = (
        fulfillment_lines_qs.filter(
            fulfillment__in=fulfillments_qs, order_line__variant__in=variant_ids
        )
        .select_related("order_line__variant")
        .prefetch_related("stock_detail_lines__rack_location")
        .annotate(
            location_name=Min(
                "stock_detail_lines__rack_location__name"
            )  # 첫 번째 로케이션 이름 가져오기
        )
        .order_by("location_name")  # 로케이션 이름으로 정렬
    )

    # ProductVariant 기준으로 그룹화
    grouped_data = {}
    for line in fulfillment_lines:
        variant = line.order_line.variant
        if variant not in grouped_data:
            grouped_data[variant] = {
                "product_variant": variant,
                "fulfillment_lines": [],
            }
        grouped_data[variant]["fulfillment_lines"].append(line)

    return [
        FulfillmentLinesGroupByVariant(
            product_variant=data["product_variant"],
            fulfillment_lines=data["fulfillment_lines"],
        )
        for data in grouped_data.values()
    ]


def resolve_fulfillment_tracking_info(courier_code, tracking_number):
    sweet_tracker_config = get_plugins_manager().get_sweet_tracker_plugin_config()
    # response의 구체적인 타입 및 데이터 필드 추가하려면 https://info.sweettracker.co.kr/apidoc 참고.
    response = send_sweet_tracker_request(
        sweet_tracker_config=sweet_tracker_config, code=courier_code, number=tracking_number
    )

    # 공식 문서상, 에러 발생 시에만 'status'가 반환됨. 'status'가 없으면 정상 응답.
    status = response.get("status", True)
    if status is False:
        msg = response.get("msg", None)
        raise Exception(msg)

    result = response.get("result") == "Y"
    tracking_details = []
    for tracking_detail in response.get("trackingDetails", []):
        tracking_details.append(
            {
                "created": tracking_detail.get("timeString"),
                "level": tracking_detail.get("level"),
                "level_text": tracking_detail.get("kind"),
                "location_name": tracking_detail.get("where"),
            }
        )

    fulfillmentTrackingInfo = {
        "result": result,
        "completed": response.get("complete"),
        "estimate": response.get("estimate"),
        "tracking_details": tracking_details,
    }
    return FulfillmentTrackingInfo(**fulfillmentTrackingInfo)
