@raise_payment_error
@require_active_payment
@with_locked_payment
@payment_postprocess
def refund(
    payment: Payment,
    transaction_kind: TransactionKind = TransactionKind.REFUND,
    refund_data: RefundData = None,
) -> Transaction:
    """실제 환불 처리는 payment_postprocess decorator에 의해서 payment.utils.gateway_postprocess 에서 처리됨"""

    plugin_manager = get_plugins_manager()
    (
        amount,
        cashable_credits,
        non_cashable_credits,
        rcoins,
        return_delivery_fee,
        new_paying_charge_exclude_vat,
        new_brand_paying_charge_exclude_vat,
        refund_brand_total_cost_price,
        refund_brand_total_delivery_fee,
        refund_delivery_additional_fee,
        taxable_total_for_tax_invoice,
        tax_free_total_for_tax_invoice,
    ) = destructing_refund_data(refund_data=refund_data, adjust_flag=True, payment=payment)

    logger.info(f"conv refund of payment {payment}: {refund_data}")

    _validate_refund_amount(payment, amount, cashable_credits, non_cashable_credits, rcoins)
    if not payment.can_refund():
        logger.warn(f"refund of payment {payment}: can_rufund is false")
        raise PaymentError(
            f"이 결제는 환불될 수 없습니다.: {payment.charge_status}/{payment.is_active}/{payment.gateway}"
        )

    payment_data = create_payment_information(
        payment=payment,
        payment_token=payment.token,
        amount=amount,
        cashable_credits=cashable_credits,
        non_cashable_credits=non_cashable_credits,
        rcoins=rcoins,
    )

    # 결제 수단과 무관하게 항상 성공 처리 gateway_response 생성
    # 이니시스 환불 연동은 내부 db 처리한 후 호출 => 이니시스 환불 자동 연동 실패한 경우, retry 또는 수동 환불 처리 필요
    response, error = _make_refund_gateway_response(payment_data, transaction_kind)

    return get_already_processed_transaction_or_create_new_transaction(
        payment=payment,
        kind=transaction_kind,
        payment_information=payment_data,
        error_msg=error,
        gateway_response=response,
        refund_data=refund_data,
    )


