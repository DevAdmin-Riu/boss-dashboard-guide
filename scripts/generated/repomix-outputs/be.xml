def get_changed_simple_fields_with_json(
    before_instance, after_instance, simple_display_fields=None, field_mapping=None
):
    """
    단순 필드(Char, Integer, Boolean, Text, Date 등) 기준 변경사항 리스트 반환.
    - M2M, ForeignKey, OneToOne 등 관계 필드는 무시함
    - JSONField는 key 단위로 비교 후 출력

    Args:
        before_instance: 변경 전 인스턴스
        after_instance: 변경 후 인스턴스
        field_mapping (dict, optional): 필드 이름 또는 JSON 키 이름 -> 표시 이름 매핑

    Returns:
        list[str]: 변경된 항목 요약 문자열 리스트
    """
    changes = []
    model = type(before_instance)
    field_mapping = field_mapping or {}

    for field in model._meta.fields:
        if isinstance(field, (models.ForeignKey, models.OneToOneField, models.ManyToManyField)):
            continue  # 관계형 필드는 제외

        if isinstance(field, FileField):
            continue  # 파일은 제외

        field_name = field.name
        base_display_name = field_mapping.get(field_name, field.verbose_name or field_name)

        if field_name in simple_display_fields:
            before_value = getattr(before_instance, field_name, {}) or {}
            after_value = getattr(after_instance, field_name, {}) or {}
            before_str = str(before_value)
            after_str = str(after_value)

            if before_str != after_str:
                changes.append(
                    f"{field_mapping.get(field_name, field.verbose_name or field_name)} 변경됨"
                )
            continue

        # JSONField 처리 (key 단위 비교)
        if isinstance(field, JSONField):
            before_json = getattr(before_instance, field_name, {}) or {}
            after_json = getattr(after_instance, field_name, {}) or {}

            all_keys = set(before_json.keys()) | set(after_json.keys())
            for key in all_keys:
                before = before_json.get(key)
                after = after_json.get(key)

                if before != after:
                    field_key = f"{field_name}.{key}"
                    display_name = field_mapping.get(field_key, field_key)

                    before_str = "없음" if before in [None, ""] else str(before)
                    after_str = "없음" if after in [None, ""] else str(after)
                    changes.append(f"{display_name}: {before_str} → {after_str}")
        else:
            old_value = getattr(before_instance, field_name, None)
            new_value = getattr(after_instance, field_name, None)

            # ChoiceField 처리
            if field.choices:
                choices_dict = dict(field.choices)
                old_value_display = choices_dict.get(old_value, old_value)
                new_value_display = choices_dict.get(new_value, new_value)
            else:
                old_value_display = old_value
                new_value_display = new_value

            if old_value != new_value:
                before_str = "없음" if old_value_display in [None, ""] else str(old_value_display)
                after_str = "없음" if new_value_display in [None, ""] else str(new_value_display)
                changes.append(f"{base_display_name}: {before_str} → {after_str}")

    return changes


# 10자리 랜덤 매장 코드 생성 - 가독성이 떨어지는 문자는 제외하고 생성되도록 string_pool 에서 제거 (B, D, I, L, O, S, Z, 1, 5, 0)
# 중복 체크는 db 필드 unique 이용 또는 생성된 코드가 사용되고 있는지 db 검색 후 사용 필요
def generate_brand_store_code():
    from saleor.account.utils import generate_random_string

    _LENGTH = 10
    string_pool = "ACEFGHJKMNPQRSTUVXY" + "234679"
    return generate_random_string(string_pool, _LENGTH)
