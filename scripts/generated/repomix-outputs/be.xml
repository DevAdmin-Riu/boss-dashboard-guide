def annotate_order_line_ordered_or_fulfill_qty(qs):
    qs = qs.annotate(
        can_fulfill_more=Case(
            When(
                ~Q(order__delivery_method=OrderDeliveryMethods.BY_COURIER)
                & Q(track_inventory=False),
                then=Value(True),
            ),
            When(
                Q(order__delivery_method=OrderDeliveryMethods.BY_COURIER)
                & Q(track_inventory=False)
                & Q(variant__is_adjust_price=True),
                then=Value(True),
            ),
            default=Value(False),
            output_field=BooleanField(),
        ),
        is_consign_after_fulfill=Case(
            When(
                purchase_order_line__status__in=CONSIGNMENT_AFTER_FULFILL_STATUSES, then=Value(True)
            ),
            default=Value(False),
            output_field=BooleanField(),
        ),
    ).annotate(
        ordered_or_fulfill_qty=Case(
            When(
                can_fulfill_more=True,
                is_consign_after_fulfill=True,
                then=F("purchase_order_line__purchase_quantity"),
            ),
            default=F("quantity"),
            output_field=DecimalField(),
        )
    )
    return qs


