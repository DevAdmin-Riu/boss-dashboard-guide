import logging

from django.db.models import F, Q

from ..celeryconf import app
from ..core.utils.exception import format_traceback_with_short_filenames
from ..graphql.order.filters import annotate_order_line_ordered_or_fulfill_qty
from ..order import ORDER_TYPES_FOR_B2B, OrderDeliveryMethods
from ..order.models import OrderLine, OrderLineQueryset
from ..site.models import HolidayInfo
from .actions import bulk_create_and_send_auto_consignment_po, kst_datetime

logger = logging.getLogger()


@app.task(name="purchaseorder.tasks.process_auto_consignment_po")
def process_auto_consignment_po():
    now = kst_datetime()
    today = now.date()
    # 오늘이 휴일이면 task 수행하지 않고 바로 리턴
    if HolidayInfo.objects.filter(holiday=today).exists():
        logger.info(f"{today}: 오늘은 휴일로 설정되어 자동위탁 발송 skip 되었습니다.")
        return

    weekday = now.weekday()  # Monday=0 ~ Sunday=6
    now_time = now.replace(second=0, microsecond=0).time()

    # 요일 스킵 조건
    skip_week_days_condition = Q(
        variant__default_variant_vendor__vendor__auto_consignment_po_skip_days__contains=[weekday]
    )
    # 1. 첫 번째 자동 발주 시간 조건
    first_time_condition = Q(
        variant__default_variant_vendor__vendor__auto_consignment_po_time=now_time
    )
    # 2. 두 번째 자동 발주 시간 조건
    second_time_condition = Q(
        variant__default_variant_vendor__vendor__second_auto_consignment_po_time=now_time
    )
    # 3. 세 번째 자동 발주 시간 조건
    third_time_condition = Q(
        variant__default_variant_vendor__vendor__third_auto_consignment_po_time=now_time
    )
    time_match_condition = first_time_condition | second_time_condition | third_time_condition

    common_order_lines_qs: OrderLineQueryset = (
        OrderLine.objects.filter(track_inventory=False)
        .filter(is_fulfilled_by_vendor=False)
        .exclude(order__type__in=ORDER_TYPES_FOR_B2B)
        .filter(purchase_order_line__isnull=True)
        .filter(variant__default_variant_vendor__vendor__use_auto_consignment_po=True)
        .filter(time_match_condition)
        .exclude(skip_week_days_condition)
    )
    common_order_lines_qs = common_order_lines_qs.ready_to_fulfill_plus_being_approved()
    common_order_lines_qs = annotate_order_line_ordered_or_fulfill_qty(common_order_lines_qs)
    common_order_lines_qs = common_order_lines_qs.exclude(
        ordered_or_fulfill_qty__lte=F("quantity_fulfilled") + F("quantity_refunded")
    )

    try:
        by_courier_target_qs = common_order_lines_qs.filter(
            order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER]
        )
        by_courier_target_order_lines = list(by_courier_target_qs)
        logger.info(
            f"process_auto_consignment_po by_courier_target_order_lines count: {len(by_courier_target_order_lines)}"
        )
        if by_courier_target_order_lines:
            bulk_create_and_send_auto_consignment_po(
                by_courier_target_order_lines, OrderDeliveryMethods.BY_COURIER
            )
    except Exception as e:
        exception_str = str(e)
        traceback_for_log = (
            format_traceback_with_short_filenames(e.__traceback__, 30) + exception_str
        )
        logger.error(
            f"fail process_auto_consignment_po by_courier_target_order_lines:\n{traceback_for_log}"
        )

    try:
        non_by_courier_target_qs = common_order_lines_qs.exclude(
            order__delivery_method__in=[OrderDeliveryMethods.BY_COURIER]
        )
        non_by_courier_target_order_lines = list(non_by_courier_target_qs)
        logger.info(
            f"process_auto_consignment_po non_by_courier_target_order_lines count: {len(non_by_courier_target_order_lines)}"
        )
        if non_by_courier_target_order_lines:
            bulk_create_and_send_auto_consignment_po(
                non_by_courier_target_order_lines, OrderDeliveryMethods.BY_TRUCK_SERVICE
            )
    except Exception as e:
        exception_str = str(e)
        traceback_for_log = (
            format_traceback_with_short_filenames(e.__traceback__, 30) + exception_str
        )
        logger.error(
            f"fail process_auto_consignment_po non_by_courier_target_order_lines:\n{traceback_for_log}"
        )
