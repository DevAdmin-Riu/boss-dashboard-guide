def reset_inner_variant_cost_price(
    outer_variant: "ProductVariant", inner_variant: "ProductVariant"
):
    if inner_variant:
        inner_update_fields = []
        pack_count = calc_pack_count(inner_variant, outer_variant)
        inner_cost_price = calc_inner_cost_by_outer_variant(outer_variant, pack_count)
        if inner_cost_price:
            inner_variant.cost_price_exclude_vat = inner_cost_price
            inner_update_fields.append("cost_price_exclude_vat")

        if inner_update_fields:
            inner_variant.save(update_fields=inner_update_fields)

    return inner_variant


def reset_variant_cost_price_by_default_variant_vendor(
    outer_variant: "ProductVariant",
    inner_variant: "ProductVariant",
    variant_vendor: "ProductVariantVendor",
    save_default_variant_vendor: bool,
    from_bulk_update_mode: bool = False,
):
    """
    ## 대표님 확인 결과
    - 면세 제품의 발주서 및 매입 내역에서 배송비에 대한 부가세 누락되는 현상 유지
    - 면세 제품을 판매하는 업체도 계산서 발행 시 상품가+배송비로 최종 가격을 정리하는데, 이 때 배송비에 대해 부가세 누락해서 등록하는 경우가 대부분임
    - 배송비 관련 과세/면세 구분 없이 부가세 다뤄야 하나 위와 같은 현상으로 여기서만 변칙적으로 다루는 것이므로, 다른 곳에서 배송비 부가세 취급할때는 과세/면세 상품 관계없이 부가세 처리되도록 해야 함
    """
    if outer_variant is None:
        raise ValidationError("제품 정보 오류: 제품이 존재하지 않습니다.")

    outer_variant.cost_price_exclude_vat = (
        variant_vendor.product_price_exclude_vat + variant_vendor.delivery_fee_exclude_vat
    )
    outer_variant.consignment_cost_price_exclude_vat = (
        variant_vendor.consignment_product_price_exclude_vat
        + variant_vendor.consignment_delivery_fee_exclude_vat
    )
    outer_update_fields = ["consignment_cost_price_exclude_vat", "cost_price_exclude_vat"]
    if save_default_variant_vendor:
        outer_variant.default_variant_vendor = variant_vendor
        outer_update_fields.append("default_variant_vendor")

    if from_bulk_update_mode == False:
        outer_variant.save(update_fields=outer_update_fields)

    if inner_variant:
        inner_update_fields = []
        pack_count = calc_pack_count(inner_variant, outer_variant)
        inner_cost_price = calc_inner_cost_by_outer_variant(outer_variant, pack_count)
        if inner_cost_price:
            inner_variant.cost_price_exclude_vat = inner_cost_price
            inner_update_fields.append("cost_price_exclude_vat")

        if save_default_variant_vendor:
            inner_variant.default_variant_vendor = variant_vendor
            inner_update_fields.append("default_variant_vendor")

        if inner_update_fields and from_bulk_update_mode == False:
            inner_variant.save(update_fields=inner_update_fields)

    return outer_variant, inner_variant
