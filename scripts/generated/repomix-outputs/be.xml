def create_transaction(
    payment: Payment,
    kind: str,
    payment_information: PaymentData,
    action_required: bool = False,
    gateway_response: GatewayResponse = None,
    error_msg=None,
    refund_data: RefundData = None,
) -> Transaction:
    """Create a transaction based on transaction kind and gateway response."""
    # Default values for token, amount, currency are only used in cases where
    # response from gateway was invalid or an exception occured

    if not gateway_response:
        gateway_response = GatewayResponse(
            kind=kind,
            action_required=False,
            transaction_id=payment_information.token,
            is_success=False,
            amount=payment_information.amount,
            currency=payment_information.currency,
            error=error_msg,
            raw_response={},
        )

    raw_response = None
    refund_info = None
    if kind == TransactionKind.REFUND:
        (
            amount,
            cashable_credits,
            non_cashable_credits,
            rcoins,
            return_delivery_fee,
            new_paying_charge_exclude_vat,
            new_brand_paying_charge_exclude_vat,
            refund_brand_total_cost_price,
            refund_brand_total_delivery_fee,
            refund_delivery_additional_fee,
            taxable_total_for_tax_invoice,
            tax_free_total_for_tax_invoice,
        ) = destructing_refund_data(refund_data=refund_data, adjust_flag=True, payment=payment)
        refund_info = make_refund_json_data(refund_data)
    else:
        amount = gateway_response.amount
        cashable_credits = payment_information.cashable_credits if payment_information else 0
        non_cashable_credits = (
            payment_information.non_cashable_credits if payment_information else 0
        )
        rcoins = payment_information.rcoins if payment_information else 0
        return_delivery_fee = 0
        refund_brand_total_cost_price = 0
        refund_brand_total_delivery_fee = 0
        refund_delivery_additional_fee = 0
        raw_response = gateway_response.raw_response

    logger.info(f"payment_debug: create_transaction {payment} {kind}/{gateway_response.kind}")

    txn = Transaction.objects.create(
        payment=payment,
        action_required=action_required,
        kind=gateway_response.kind,
        token=gateway_response.transaction_id,
        is_success=gateway_response.is_success,
        amount=amount,
        currency=gateway_response.currency,
        error=gateway_response.error,
        customer_id=gateway_response.customer_id,
        gateway_response=raw_response or {},
        refund_info=refund_info or {},
        action_required_data=gateway_response.action_required_data or {},
        searchable_key=gateway_response.searchable_key or "",
        cashable_credits=cashable_credits,
        non_cashable_credits=non_cashable_credits,
        rcoins=rcoins,
        return_delivery_fee=return_delivery_fee,
        refund_brand_total_cost_price_amount=refund_brand_total_cost_price,
        refund_brand_total_delivery_fee_amount=refund_brand_total_delivery_fee,
        refund_delivery_additional_fee=refund_delivery_additional_fee,
        # 신규 생성 Transaction은 본부수익금 산출방식 새로운 것이므로 True 로 세팅
        is_converted=True,
    )
    return txn


def get_already_processed_transaction_or_create_new_transaction(
    payment: Payment,
    kind: str,
    payment_information: PaymentData,
    action_required: bool = False,
    gateway_response: GatewayResponse = None,
    error_msg=None,
    refund_data: RefundData = None,
) -> Transaction:
    if gateway_response and gateway_response.transaction_already_processed:
        txn = get_already_processed_transaction(payment, gateway_response)
        if txn:
            return txn

    logger.info(
        f"payment_debug: get_already_processed_transaction_or_create_new_transaction {payment} {kind}"
    )

    return create_transaction(
        payment,
        kind,
        payment_information,
        action_required,
        gateway_response,
        error_msg,
        refund_data,
    )


def clean_capture(payment: Payment, amount: Decimal):
    """Check if payment can be captured."""
    if amount <= 0:
        raise PaymentError("Amount should be a positive number.")
    if not payment.can_capture():
        raise PaymentError("This payment cannot be captured.")
    if amount > payment.total or amount > (payment.total - payment.captured_total):
        raise PaymentError("Unable to charge more than un-captured amount.")


def clean_authorize(payment: Payment):
    """Check if payment can be authorized."""
    if not payment.can_authorize():
        raise PaymentError("Charged transactions cannot be authorized again.")


def validate_gateway_response(response: GatewayResponse):
    """Validate response to be a correct format for Saleor to process."""
    if not isinstance(response, GatewayResponse):
        raise GatewayError("Gateway needs to return a GatewayResponse obj")

    if response.kind not in ALLOWED_GATEWAY_KINDS:
        raise GatewayError(
            "Gateway response kind must be one of {}".format(sorted(ALLOWED_GATEWAY_KINDS))
        )

    if response.currency != settings.DEFAULT_CURRENCY:
        logger.warning("Transaction currency is different than Saleor's.")

    try:
        json.dumps(response.raw_response, cls=DjangoJSONEncoder)
    except (TypeError, ValueError):
        raise GatewayError("Gateway response needs to be json serializable")


def destructing_refund_data(
    refund_data: RefundData,
    adjust_flag: bool,
    payment: Payment = None,
    order: Order = None,
):
    """refund_data destructing 후 전액 환불 케이스를 위해 값 보정을 하지 않는 경우에는 payment, order 를 전달하지 않는다."""
    if adjust_flag:
        logger.info(f"orgin refund of payment {payment}: {refund_data}")

    amount = refund_data.amount if refund_data else None
    cashable_credits = refund_data.cashable_credits if refund_data else None
    non_cashable_credits = refund_data.non_cashable_credits if refund_data else None
    rcoins = refund_data.rcoins if refund_data else None
    return_delivery_fee = refund_data.return_delivery_fee if refund_data else None

    new_paying_charge_exclude_vat = (
        refund_data.new_paying_charge_exclude_vat if refund_data else None
    )
    new_brand_paying_charge_exclude_vat = (
        refund_data.new_brand_paying_charge_exclude_vat if refund_data else None
    )
    refund_brand_total_cost_price = (
        refund_data.refund_brand_total_cost_price if refund_data else None
    )
    refund_brand_total_delivery_fee = (
        refund_data.refund_brand_total_delivery_fee if refund_data else None
    )
    refund_delivery_additional_fee = (
        refund_data.refund_delivery_additional_fee if refund_data else None
    )
    taxable_total_for_tax_invoice = (
        refund_data.taxable_total_for_tax_invoice if refund_data else None
    )
    tax_free_total_for_tax_invoice = (
        refund_data.tax_free_total_for_tax_invoice if refund_data else None
    )

    if adjust_flag:
        """자동 환불 케이스에 refund_data 없이 refund 호출되는 경우는 전액환불로 간주함"""
        """refund_data 없는 자동 환불 케이스는 주문 시 오류 때에만 발생하므로, 세금계산서 금액, 반품 수량을 위한 데이터는 무시함"""
        if payment:
            if amount is None:
                amount = payment.captured_amount
            if cashable_credits is None:
                cashable_credits = payment.captured_cashable_credits
            if non_cashable_credits is None:
                non_cashable_credits = payment.captured_non_cashable_credits
            if rcoins is None:
                rcoins = payment.captured_rcoins

        if return_delivery_fee is None:
            return_delivery_fee = 0
        if new_paying_charge_exclude_vat is None:
            new_paying_charge_exclude_vat = 0
        if new_brand_paying_charge_exclude_vat is None:
            new_brand_paying_charge_exclude_vat = 0
        if refund_brand_total_cost_price is None:
            refund_brand_total_cost_price = (
                order.final_brand_total_cost_price_amount if order else 0
            )
        if refund_brand_total_delivery_fee is None:
            refund_brand_total_delivery_fee = (
                order.final_brand_total_delivery_fee_amount if order else 0
            )
        if refund_delivery_additional_fee is None:
            refund_delivery_additional_fee = (
                order.final_refund_delivery_additional_fee if order else 0
            )

    return (
        amount,
        cashable_credits,
        non_cashable_credits,
        rcoins,
        return_delivery_fee,
        new_paying_charge_exclude_vat,
        new_brand_paying_charge_exclude_vat,
        refund_brand_total_cost_price,
        refund_brand_total_delivery_fee,
        refund_delivery_additional_fee,
        taxable_total_for_tax_invoice,
        tax_free_total_for_tax_invoice,
    )


@transaction.atomic
def gateway_postprocess(transaction, payment: Payment, refund_data: RefundData = None, **kwargs):
    logger.info(f"payment_debug: gateway_postprocess {payment} {transaction.kind}")

    logger.info(
        f"gateway_postprocess {transaction.kind} / {transaction.is_success} / {transaction.action_required} / {transaction.already_processed}"
    )

    if not transaction.is_success:
        return
    if transaction.action_required:
        payment.to_confirm = True
        payment.save(update_fields=["to_confirm"])
        return
    if transaction.already_processed:
        return
    changed_fields = []
    # to_confirm is defined by the transaction.action_required. Payment doesn't
    # require confirmation when we got action_required == False
    if payment.to_confirm:
        payment.to_confirm = False
        changed_fields.append("to_confirm")

    transaction_kind = transaction.kind

    if transaction_kind in {
        TransactionKind.CAPTURE,
        TransactionKind.REFUND_REVERSED,
    }:
        payment.captured_amount += transaction.amount
        payment.is_active = True
        # Set payment charge status to fully charged
        # only if there is no more amount needs to charge
        payment.charge_status = ChargeStatus.PARTIALLY_CHARGED
        if payment.get_charge_amount() <= 0:
            payment.charge_status = ChargeStatus.FULLY_CHARGED
        changed_fields += ["charge_status", "captured_amount", "modified"]

    elif transaction_kind == TransactionKind.VOID:
        payment.is_active = False
        changed_fields += ["is_active", "modified"]
    elif (
        transaction_kind == TransactionKind.REFUND
        or transaction_kind == TransactionKind.AUTO_REFUND
    ):
        order: "Order" = payment.order
        (
            amount,
            cashable_credits,
            non_cashable_credits,
            rcoins,
            return_delivery_fee,
            new_paying_charge_exclude_vat,
            new_brand_paying_charge_exclude_vat,
            refund_brand_total_cost_price,
            refund_brand_total_delivery_fee,
            refund_delivery_additional_fee,
            taxable_total_for_tax_invoice,
            tax_free_total_for_tax_invoice,
        ) = destructing_refund_data(
            refund_data=refund_data, adjust_flag=True, payment=payment, order=order
        )
        logger.info(f"conv refund of payment {payment} (gateway_postprocess): {refund_data}")

        if order is None:
            logger.error(f"refund_debug: {payment} order is None")
            return

        event_desc = f"주문번호:{order.composed_id_with_prefix}"
        total_credits = (cashable_credits or 0) + (non_cashable_credits or 0)
        if total_credits > 0:
            user: "User" = (
                order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
            )
            if user:
                qty_before = user.credits_incl_non_cashable
                qty_after = qty_before + total_credits
                create_credits_event(
                    total_before=qty_before,
                    total_after=qty_after,
                    qty_before=qty_before,
                    qty_after=qty_after,
                    qty=total_credits,
                    type=CreditsEventType.REFUND,
                    user=user,
                    staff=None,
                    description=event_desc,
                    view_mode=CreditsEventViewMode.ONLY_MALL,
                    # ONLY_MALL view_mode 에서 is_cashable 은 통합금액 이벤트이므로 무의미함
                    is_cashable=True,
                )

        if cashable_credits is not None and cashable_credits > 0:
            payment.captured_cashable_credits -= Decimal(cashable_credits)
            changed_fields += ["captured_cashable_credits"]
            if user:
                user.increase_cashable_credits(
                    cashable_credits,
                    CreditsEventType.REFUND,
                    event_desc,
                    staff=None,
                    event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
                )

        if non_cashable_credits is not None and non_cashable_credits > 0:
            payment.captured_non_cashable_credits -= Decimal(non_cashable_credits)
            changed_fields += ["captured_non_cashable_credits"]
            user: "User" = (
                order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
            )
            if user:
                user.increase_non_cashable_credits(
                    non_cashable_credits,
                    CreditsEventType.REFUND,
                    event_desc,
                    staff=None,
                    event_view_mode=CreditsEventViewMode.ONLY_DASHBOARD,
                )
        if rcoins is not None and rcoins > 0:
            payment.captured_rcoins -= Decimal(rcoins)
            changed_fields += ["captured_rcoins"]
            user: "User" = (
                order.creator_user if order.type == OrderType.BY_HQ_STAFF_FOR_BRAND else order.user
            )
            if user:
                user.increase_rcoins(rcoins, RcoinsEventType.REFUND, event_desc, staff=None)
        if amount is not None and amount > 0:
            payment.captured_amount -= Decimal(amount)
            changed_fields += ["captured_amount"]

        brand: "Brand" = order.brand
        if brand and brand.is_reverse_fee_contract_type:
            # 반품 배송비 포함 환불 시 환불 금액이 음수가 되는 경우는 없음
            refund_reverse_fee_deposit = (
                refund_brand_total_cost_price + refund_delivery_additional_fee - return_delivery_fee
            )
            # 매출인식 브랜드 가맹본부 대행주문은 고려안함
            user: "User" = order.user
            if refund_reverse_fee_deposit > 0 and refund_data and not refund_data.is_fbv:
                brand.increase_reverse_fee_deposit(
                    reverse_fee_deposit_amount=refund_reverse_fee_deposit,
                    event_type=BrandReverseFeeDepositEventType.REFUND,
                    description=event_desc,
                    user=user,
                )
                if rcoins is not None and rcoins > 0:
                    brand.decrease_reverse_fee_deposit(
                        reverse_fee_deposit_amount=rcoins,
                        event_type=BrandReverseFeeDepositEventType.DECREASE_BY_RCOINS,
                        description=event_desc,
                        user=user,
                    )

        # 반품 배송비는 유저에게 되돌려주지 않고, captured 항목에서만 차감함
        remain_return_delivery_fee = Decimal(return_delivery_fee)
        if remain_return_delivery_fee > 0:
            if payment.captured_amount > 0:
                min_value = min(payment.captured_amount, remain_return_delivery_fee)
                payment.captured_amount -= min_value
                remain_return_delivery_fee -= min_value
                changed_fields += ["captured_amount"]
        if remain_return_delivery_fee > 0:
            if payment.captured_cashable_credits > 0:
                min_value = min(payment.captured_cashable_credits, remain_return_delivery_fee)
                payment.captured_cashable_credits -= min_value
                remain_return_delivery_fee -= min_value
                changed_fields += ["captured_cashable_credits"]
        if remain_return_delivery_fee > 0:
            if payment.captured_non_cashable_credits > 0:
                min_value = min(payment.captured_non_cashable_credits, remain_return_delivery_fee)
                payment.captured_non_cashable_credits -= min_value
                remain_return_delivery_fee -= min_value
                changed_fields += ["captured_non_cashable_credits"]
        if remain_return_delivery_fee > 0:
            if payment.captured_rcoins > 0:
                min_value = min(payment.captured_rcoins, remain_return_delivery_fee)
                payment.captured_rcoins -= min_value
                remain_return_delivery_fee -= min_value
                changed_fields += ["captured_rcoins"]

        payment.final_paying_charge_exclude_vat = new_paying_charge_exclude_vat
        payment.final_brand_paying_charge_exclude_vat = new_brand_paying_charge_exclude_vat
        changed_fields += [
            "final_paying_charge_exclude_vat",
            "final_brand_paying_charge_exclude_vat",
        ]

        payment.charge_status = ChargeStatus.PARTIALLY_REFUNDED
        if payment.captured_total <= 0:
            payment.charge_status = ChargeStatus.FULLY_REFUNDED
            payment.is_active = False
            changed_fields += ["is_active"]
        changed_fields += ["charge_status", "modified"]
    elif transaction_kind == TransactionKind.PENDING:
        payment.charge_status = ChargeStatus.PENDING
        changed_fields += ["charge_status"]
    elif transaction_kind == TransactionKind.CANCEL:
        payment.charge_status = ChargeStatus.CANCELLED
        changed_fields += ["charge_status"]
    elif transaction_kind == TransactionKind.CAPTURE_FAILED:
        if payment.charge_status in {
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
        }:
            payment.captured_amount -= transaction.amount
            payment.charge_status = ChargeStatus.PARTIALLY_CHARGED
            if payment.captured_amount <= 0:
                payment.charge_status = ChargeStatus.NOT_CHARGED
            changed_fields += ["charge_status", "captured_amount", "modified"]
    if changed_fields:
        # 중복된 변경 필드명 distinct 처리
        changed_fields = list(set(changed_fields))
        payment.save(update_fields=changed_fields)
    transaction.already_processed = True
    transaction.save(update_fields=["already_processed"])


def fetch_customer_id(user: User, gateway: str):
    """Retrieve users customer_id stored for desired gateway."""
    meta_key = prepare_key_for_gateway_customer_id(gateway)
    return user.get_value_from_private_metadata(key=meta_key)


def store_customer_id(user: User, gateway: str, customer_id: str):
    """Store customer_id in users private meta for desired gateway."""
    meta_key = prepare_key_for_gateway_customer_id(gateway)
    user.store_value_in_private_metadata(items={meta_key: customer_id})
    user.save(update_fields=["private_metadata"])


def prepare_key_for_gateway_customer_id(gateway_name: str) -> str:
    return (gateway_name.strip().upper()) + ".customer_id"


def get_payment_token(payment: Payment):
    auth_transaction = payment.transactions.filter(
        kind=TransactionKind.AUTH, is_success=True
    ).first()
    if auth_transaction is None:
        raise PaymentError("Cannot process unauthorized transaction")
    return auth_transaction.token


def is_currency_supported(currency: str, gateway_id: str):
    """Return true if the given gateway supports given currency."""
    available_gateways = get_plugins_manager().list_payment_gateways(currency=currency)
    return any([gateway.id == gateway_id for gateway in available_gateways])


