    )

    # 위탁 발주서 협력사 주문 상태
    vendor_order_status = models.CharField(
        max_length=30,
        choices=PoLineVendorOrderStatus.choices,
        default=PoLineVendorOrderStatus.STANDBY,
    )

    @property
    def code(self):
        return f"{PURCHASE_OREDER_CODE_PREFIX}{str(self.purchase_order.pk).zfill(7)}-{str(self.sort_order).zfill(3)}"

    @property
    def is_dev_pv(self):
        return self.variant.is_dev_pv if self.variant else False

    def __str__(self):
        return f"{self.code}"

    class Meta:
        unique_together = [["purchase_order", "variant", "order_line"]]
        ordering = (
            "-purchase_order_id",
            "sort_order",
        )

    def save(self, *args, **kwargs):
        # 생성 시점 Validation.
        if not self.pk:
            # 발주서가 발송된 이후에는 발주제품 추가 불가 validation.
            if self.variant.is_dev_pv and not (
                self.purchase_order.is_initial_order or self.purchase_order.is_consignment_po
            ):
                raise ValidationError("개발비 제품은 초도발주 또는 위탁발주만 가능합니다.")
            # 생성 시점에 개발비 제품인 경우 초도발주만 가능하다.
            if self.purchase_order.is_sent:
                raise ValidationError("발주서가 발송된 상태에서는 발주제품을 추가할 수 없습니다.")

        super().save(*args, **kwargs)

