    *, order_lines: List["OrderLine"], user: UserModel, reason: str
) -> "OrderEvent":
    order_set = _get_order_set_by_order_lines(order_lines)
    for order in order_set:
        filtered_order_lines = [line for line in order_lines if line.order == order]
        models.OrderEvent.objects.create(
            order=order,
            type=OrderEvents.B2B_REJECTED,
            user=user,
            parameters={
                "reason": reason,
                "message": ", ".join(
                    [line.composed_id_with_prefix for line in filtered_order_lines]
                ),
            },
        )


