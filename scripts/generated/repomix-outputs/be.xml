class PointsEventFilter(django_filters.FilterSet):
    def filter_user_search(qs, _, value):
        search_fields = ["user__login_id", "user__first_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand_search(qs, _, value):
        search_fields = [
            "user__brand__code",
            "user__brand__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand_store_search(qs, _, value):
