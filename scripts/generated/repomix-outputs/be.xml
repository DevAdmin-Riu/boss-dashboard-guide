        description = "상품가격 변경 기본 정보."
        model = models.ReserveChangePriceBase
        interfaces = [relay.Node]
        only_fields = [
            "id",
            "created",
            "reserved",
            "confirmed",
            "description",
            "is_applied",
            "is_confirmed",
            "xls_file_name",
        ]

    def resolve_brand_product_counts(root: models.ReserveChangePriceBase, _info, **_kwargs):
        queryset = (
            root.details.all()
            .values("brand")
            .annotate(
                count=Count(Coalesce("brand", 1)),
                brand_name=Case(
                    When(brand__isnull=False, then=F("brand__name")),
                    default=V("-"),
                    output_field=CharField(),
                ),
                brand_code=Case(
                    When(brand__isnull=False, then=F("brand__code")),
                    default=V("-"),
                    output_field=CharField(),
                ),
            )
            .values("count", "brand_id", "brand_name", "brand_code")
            .order_by("brand_name")
        )
        for record in queryset:
            brand_id = record.get("brand_id")
            record["brand_id"] = graphene.Node.to_global_id("Brand", brand_id) if brand_id else None

        return queryset

    def resolve_is_cancelable(root: models.ReserveChangePriceBase, _info, **_kwargs):
        return root.is_cancelable()

    def resolve_is_confirmable(root: models.ReserveChangePriceBase, _info, **_kwargs):
        return root.is_confirmable()

    def resolve_xls_file_url(root: models.ReserveChangePriceBase, info):
        xls_file = root.xls_file
        if not xls_file:
            return None
        return info.context.build_absolute_uri(xls_file.url)


