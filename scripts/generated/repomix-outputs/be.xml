from django_countries.fields import Country
from prices import Money, TaxedMoney

from saleor.plugins.sweet_tracker.define import SWEET_TRACKER_PLUGIN_ID

from ..checkout import base_calculations
from ..checkout.define import CalcCheckoutTotalMode
from ..core.payments import PaymentInterface
from ..core.prices import quantize_price
from ..core.taxes import TaxType
from .goodsflow.define import GOODSFLOW_PLUGIN_ID
from .models import PluginConfiguration

if TYPE_CHECKING:
    # flake8: noqa
    from ..account.models import Address, User
    from ..checkout.models import Checkout, CheckoutLine
    from ..invoice.models import Invoice
    from ..order.models import Fulfillment, Order, OrderLine
    from ..payment.interface import (
        CustomerSource,
        GatewayResponse,
        InitializedPaymentResponse,
        PaymentData,
        PaymentGateway,
        TokenConfig,
    )
    from ..plugins.aligo import AligoEvents
    from ..product.models import BpBundle, Product, ProductType
    from ..taxinvoice.models import TaxInvoice
    from .base_plugin import BasePlugin


class PluginsManager(PaymentInterface):
    """Base manager for handling plugins logic."""

    plugins: List["BasePlugin"] = []

    def __init__(self, plugins: List[str]):
        self.plugins = []
        all_configs = self._get_all_plugin_configs()
        for plugin_path in plugins:
            PluginClass = import_string(plugin_path)
            if PluginClass.PLUGIN_ID in all_configs:
                existing_config = all_configs[PluginClass.PLUGIN_ID]
                plugin_config = existing_config.configuration
                active = existing_config.active
                show_in_list = existing_config.show_in_list
            else:
                plugin_config = PluginClass.DEFAULT_CONFIGURATION
                active = PluginClass.get_default_active()
                show_in_list = PluginClass.get_default_show_in_list()
            self.plugins.append(
                PluginClass(
                    configuration=plugin_config,
                    active=active,
                    show_in_list=show_in_list,
                )
            )

    def __run_method_on_plugins(self, method_name: str, default_value: Any, *args, **kwargs):
        """Try to run a method with the given name on each declared plugin."""
        with opentracing.global_tracer().start_active_span(f"ExtensionsManager.{method_name}"):
            value = default_value
            for plugin in self.plugins:
                value = self.__run_method_on_single_plugin(
                    plugin, method_name, value, *args, **kwargs
                )
            return value

    def __run_method_on_single_plugin(
        self,
        plugin: Optional["BasePlugin"],
        method_name: str,
        previous_value: Any,
        *args,
        **kwargs,
    ) -> Any:
        """Run method_name on plugin.

        Method will return value returned from plugin's
        method. If plugin doesn't have own implementation of expected method_name, it
        will return previous_value.
        """
        plugin_method = getattr(plugin, method_name, NotImplemented)
        if plugin_method == NotImplemented:
            return previous_value

        returned_value = plugin_method(*args, **kwargs, previous_value=previous_value)
        if returned_value == NotImplemented:
            return previous_value
        return returned_value

    def calculate_checkout_total(
        self,
        checkout: "Checkout",
        lines: Iterable["CheckoutLine"],
    ) -> TaxedMoney:
        subtotal = self.calculate_checkout_subtotal(checkout, lines, mode=CalcCheckoutTotalMode.ALL)
        subtotal_delivery_additional_fee = self.calculate_checkout_subtotal_delivery_additional_fee(
            checkout, lines
        )
        default_value = base_calculations.base_checkout_total(
            subtotal=subtotal,
            subtotal_delivery_additional_fee=subtotal_delivery_additional_fee,
            currency=checkout.currency,
        )
        return quantize_price(
            self.__run_method_on_plugins(
                "calculate_checkout_total", default_value, checkout, lines
            ),
            checkout.currency,
        )

    def get_filtered_checkout_lines_consider_bp_bundle(
        self,
        lines: Iterable["CheckoutLine"],
        mode: CalcCheckoutTotalMode,
    ):
        if mode == CalcCheckoutTotalMode.ALL:
            return lines
        tax_free_filtered_lines = []
        taxable_filtered_lines = []
        for line in lines:
            pv = line.bp_bundle.main_pv if line.bp_bundle else line.variant
            if pv.product.is_tax_free:
                tax_free_filtered_lines.append(line)
            else:
                taxable_filtered_lines.append(line)
        if mode == CalcCheckoutTotalMode.ONLY_TAX_FREE:
            return tax_free_filtered_lines
        return taxable_filtered_lines

    def calculate_checkout_subtotal(
        self,
        checkout: "Checkout",
        lines: Iterable["CheckoutLine"],
        mode: CalcCheckoutTotalMode,
    ) -> TaxedMoney:
        filtered_lines = self.get_filtered_checkout_lines_consider_bp_bundle(lines, mode)
        line_totals_decimal = [
            self.calculate_checkout_line_total_decimal(checkout, line) for line in filtered_lines
        ]
        default_value = base_calculations.base_checkout_subtotal(
            line_totals_decimal, checkout.currency
        )
        return quantize_price(
            self.__run_method_on_plugins(
                "calculate_checkout_subtotal",
                default_value,
                checkout,
                filtered_lines,
                mode,
            ),
            checkout.currency,
        )

    def calculate_checkout_subtotal_brand_cost(
        self,
        checkout: "Checkout",
        lines: Iterable["CheckoutLine"],
        mode: CalcCheckoutTotalMode,
    ) -> TaxedMoney:
        line_totals_decimal = [
            self.calculate_checkout_line_total_brand_cost_decimal(checkout, line) for line in lines
        ]
        default_value = base_calculations.base_checkout_subtotal(
            line_totals_decimal, checkout.currency
        )
        return quantize_price(
            self.__run_method_on_plugins(
                "calculate_checkout_subtotal_brand_cost",
                default_value,
                checkout,
                lines,
                mode,
            ),
            checkout.currency,
        )

    def calculate_checkout_subtotal_etc_delivery_fee(
        self,
        checkout: "Checkout",
        lines: Iterable["CheckoutLine"],
    ) -> TaxedMoney:
        line_totals_decimal = [line.etc_delivery_fee for line in lines]
        default_value = base_calculations.base_checkout_subtotal(
            line_totals_decimal, checkout.currency
        )
        return quantize_price(
            self.__run_method_on_plugins(
                "calculate_checkout_subtotal_etc_delivery_fee",
                default_value,
                checkout,
                lines,
            ),
            checkout.currency,
        )

    def calculate_checkout_subtotal_delivery_additional_fee(
        self,
        checkout: "Checkout",
        lines: List["CheckoutLine"],
    ) -> TaxedMoney:
        default_value = base_calculations.base_checkout_subtotal_delivery_additional_fee(
            checkout, lines
        )
        return quantize_price(
            self.__run_method_on_plugins(
                "calculate_checkout_subtotal_delivery_additional_fee",
                default_value,
                checkout,
