class BsTrainingDocFilter(django_filters.FilterSet):
    def filter_type(qs, _, value):
        if value:
            qs = qs.filter(type=value)
        return qs

    def filter_tag_search(qs, _, value):
        fields = ["tags__name"]
        qs = filter_by_query_param(qs, value, fields)
        return qs

    def filter_title_search(qs, _, value):
        fields = ["title"]
        qs = filter_by_query_param(qs, value, fields)
        return qs

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created_at__date", value)

    def filter_brand_search(qs, _, value):
        search_fields = [
            "owner_brand__code",
            "owner_brand__name",
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_published(qs, _, value):
        today = kst_date()
        if value == PublishedEnum.PUBLISHED:
            qs = qs.filter(
                Q(is_published=True)
                & (Q(publication_date__lte=today) | Q(publication_date__isnull=True))
            )
        elif value == PublishedEnum.HIDDEN:
            qs = qs.filter(Q(is_published=False) | Q(publication_date__gt=today))
        return qs

    def filter_publish_date(qs, _, value):
        qs = qs.filter(is_published=True)
        return filter_range_field(qs, "publication_date", value)

    type = EnumFilter(input_class=BsTrainingDocTypeEnum, method=filter_type)
    tag_ids = GlobalIDMultipleChoiceFilter(field_name="tags__id")
    tag_search = django_filters.CharFilter(method=filter_tag_search)
    title_search = django_filters.CharFilter(method=filter_title_search)
    created_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)
    publish_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_publish_date)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    published = EnumFilter(input_class=PublishedEnum, method=filter_published)

    class Meta:
        model = models.BsTrainingDoc
        fields = {"owner_brand": ["exact"]}


