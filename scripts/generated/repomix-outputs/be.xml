from typing import Optional

import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ....core.permissions import ProductPermissions
from ....product import CategoryKind, models
from ....product.models import Product as ProductModel
from ....product.models import ProductVariant as ProductVariantModel
from ....product.models import ProductVariantVendor as ProductVariantVendorModel
from ....product.utils.product_variant import reset_po_lead_time_by_pvv
from ....product.utils.variant_prices import reset_variant_cost_price_by_default_variant_vendor
from ....vendor.models import Vendor as VendorModel
from ...core.mutations import BaseMutation, ModelMutation
from ...core.types.common import ProductError
from ..types.products import ProductVariant
from ..types.variant_vendors import ProductVariantVendor
from ..utils import (
    add_pv_manage_event,
    make_total_change_summary_for_product_and_variant,
    prepare_m2m_and_related_values,
)
from .input_object_types import DefaultProductVariantVendorInput, ProductVariantManageEventInput


class ProductVariantVendorUpdateInput(DefaultProductVariantVendorInput):
    manage_event = ProductVariantManageEventInput(description="제품 관리 이력", required=True)


class ProductVariantVendorCreateInput(ProductVariantVendorUpdateInput):
    product_variant = graphene.ID(required=True, description="variant id")
    vendor = graphene.ID(required=True, description="협력사 id")
    manage_event = ProductVariantManageEventInput(description="제품 관리 이력", required=True)


class ProductVariantVendorCreate(ModelMutation):
    class Arguments:
        input = ProductVariantVendorCreateInput(
            required=True, description="Fields required to create a product variant vendor."
        )

    class Meta:
        description = "Create an existing product variant region."
        model = models.ProductVariantVendor
        error_type_class = ProductError
        error_type_field = "product_errors"

    @staticmethod
    def validate_for_is_fbv_case(cls, variant: ProductVariantModel, cleaned_input):
        is_fulfilled_by_vendor = variant.product.is_fulfilled_by_vendor
        if is_fulfilled_by_vendor:
            if cls == ProductVariantVendorCreate:
                if variant.variant_vendors.exists():
                    raise ValidationError("직거래 상품은 협력사를 1개만 추가할 수 있습니다.")
                vendor: VendorModel = cleaned_input.get("vendor")
                if vendor.use_fbv_product == False:
                    raise ValidationError("직거래 상품은 직거래 취급 협력사만 추가할 수 있습니다.")

    @staticmethod
    def validate_moq(cls, instance: ProductVariantVendorModel, cleaned_input):
        moq = cleaned_input.get("moq")
        if moq is not None and moq <= 0:
            raise ValidationError("제품 협력사 MOQ는 0 보다 큰 값 이어야 합니다.")

    @staticmethod
    def validate_pricing_basis_qty(cls, instance: ProductVariantVendorModel, cleaned_input):
        pricing_basis_qty = cleaned_input.get("pricing_basis_qty")
        if pricing_basis_qty is not None and pricing_basis_qty <= 0:
            raise ValidationError("협력사 기본 발주 수량은 0 보다 큰 값 이어야 합니다.")

    @staticmethod
    def validate_lead_time(cls, instance: ProductVariantVendorModel, cleaned_input):
        if cls == ProductVariantVendorCreate:
            lead_time = cleaned_input.get("lead_time")
        else:
            lead_time = cleaned_input.get("lead_time", instance.lead_time)
        if lead_time is None or lead_time <= 0:
            raise ValidationError(
                "제품 협력사 L/T 정보값은 필수 정보입니다. 0 보다 큰 값으로 설정해 주세요"
            )

    @staticmethod
    def validate_b2b_delivery_fee(
        cls, instance: ProductVariantVendorModel, variant: ProductVariantModel, cleaned_input
    ):
        category = variant.product.category
        if category.kind == CategoryKind.B2B:
            if cls == ProductVariantVendorCreate:
                include_purchase_b2b_delivery_fee = cleaned_input.get(
                    "include_purchase_b2b_delivery_fee"
                )
                if include_purchase_b2b_delivery_fee is None:
                    raise ValidationError("배송비에 매입가가 포함 여부가 입력되지 않았습니다.")
                purchase_b2b_delivery_fee_exclude_vat = cleaned_input.get(
                    "purchase_b2b_delivery_fee_exclude_vat"
                )
                if include_purchase_b2b_delivery_fee and (
                    purchase_b2b_delivery_fee_exclude_vat is not None
                    and purchase_b2b_delivery_fee_exclude_vat != 0
                ):
                    raise ValidationError(
                        "배송비에 매입가가 포함된 경우, 매입 b2b 배송비는 0 이어야 합니다."
                    )
            else:
                include_purchase_b2b_delivery_fee = cleaned_input.get(
                    "include_purchase_b2b_delivery_fee", instance.include_purchase_b2b_delivery_fee
                )
                purchase_b2b_delivery_fee_exclude_vat = cleaned_input.get(
                    "purchase_b2b_delivery_fee_exclude_vat",
                    instance.purchase_b2b_delivery_fee_exclude_vat,
                )
                if include_purchase_b2b_delivery_fee and purchase_b2b_delivery_fee_exclude_vat != 0:
                    raise ValidationError(
                        "배송비에 매입가가 포함된 경우, 매입 b2b 배송비는 0 이어야 합니다."
                    )

    @classmethod
    def clean_input(cls, info, instance: ProductVariantVendorModel, data):
        cleaned_input = super().clean_input(info, instance, data)
        cleaned_input["is_active"] = True

        variant = cleaned_input.get("product_variant")
        ProductVariantVendorCreate.validate_for_is_fbv_case(cls, variant, cleaned_input)
        ProductVariantVendorCreate.validate_moq(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_pricing_basis_qty(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_lead_time(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_b2b_delivery_fee(cls, instance, variant, cleaned_input)

        return cleaned_input

    @classmethod
    def post_save_action(
        cls,
        info,
        instance: ProductVariantVendorModel,
        cleaned_input,
        before_product_variant,
        before_product_variant_m2m_and_related_values,
    ):
        outer_variant: ProductVariantModel = instance.product_variant
        product: ProductModel = outer_variant.product
        track_inventory = outer_variant.track_inventory
        is_deferred = outer_variant.is_deferred
        if not is_deferred:
            if track_inventory:
                if (
                    instance.product_price_exclude_vat <= 0
                    and instance.consignment_product_price_exclude_vat <= 0
                ):
                    raise ValidationError(
                        "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 둘 중 하나는 0 보다 큰 값 이어야 합니다."
                    )
            else:
                if instance.consignment_product_price_exclude_vat <= 0:
                    raise ValidationError(
                        "재고 미운영 제품인 경우, 협력사 위탁 상품가는 0 보다 큰 값 이어야 합니다."
                    )

        if product.is_direct_shipping:
            vendor_count = outer_variant.variant_vendors.count()
            if vendor_count > 1 or instance.vendor.is_direct_shipping == False:
                raise ValidationError("직배송 제품에는 직배송 협력사로 1개만 추가할 수 있습니다.")

        if not outer_variant.default_variant_vendor:
            reset_variant_cost_price_by_default_variant_vendor(
                outer_variant, outer_variant.inner, instance, save_default_variant_vendor=True
            )
            reset_po_lead_time_by_pvv(outer_variant, instance)

        _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
            before_variant=before_product_variant,
            before_inner_variant=None,
            before_product=None,
            before_product_m2m_and_related_values=None,
            before_variant_m2m_and_related_values=before_product_variant_m2m_and_related_values,
            updated_variant=outer_variant,
            updated_product=None,
        )

        manage_event = cleaned_input.get("manage_event")
        if manage_event:
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=outer_variant, manage_event=manage_event, info=info)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        product_variant_id = data.get("input").get("product_variant")
        before_product_variant = cls.get_node_or_error(
            info,
            product_variant_id,
            field="product_variant",
            only_type=ProductVariant,
        )
        # 수정전 관계 필드들 스냅샷.
        _, before_product_variant_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_product_variant
        )

        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(
            info,
            instance,
            cleaned_input,
            before_product_variant,
            before_product_variant_m2m_and_related_values,
        )
        return cls.success_response(instance)


class ProductVariantVendorUpdate(ModelMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a product variant vendor to update.")
        input = ProductVariantVendorUpdateInput(
            required=True, description="Fields required to update a product variant vendor."
        )

    class Meta:
        description = "Updates an existing product variant vendor."
        model = models.ProductVariantVendor
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def clean_input(cls, info, instance: ProductVariantVendorModel, data):
        cleaned_input = super().clean_input(info, instance, data)
        if "is_active" in cleaned_input:
            if (
                instance.product_variant.default_variant_vendor == instance
                and cleaned_input["is_active"] == False
            ):
                raise ValidationError("기본값으로 설정된 협력사는 비활성화 할 수 없습니다.")

        variant = instance.product_variant
        ProductVariantVendorCreate.validate_for_is_fbv_case(cls, variant, cleaned_input)
        ProductVariantVendorCreate.validate_moq(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_pricing_basis_qty(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_lead_time(cls, instance, cleaned_input)
        ProductVariantVendorCreate.validate_b2b_delivery_fee(cls, instance, variant, cleaned_input)

        return cleaned_input

    @classmethod
    def post_save_action(cls, info, instance, cleaned_input):
        variant_vendor: ProductVariantVendorModel = instance
        outer_variant: ProductVariantModel = variant_vendor.product_variant
        is_fulfilled_by_vendor = outer_variant.product.is_fulfilled_by_vendor
        if is_fulfilled_by_vendor:
            if (
                outer_variant.is_deferred == False
                and variant_vendor.consignment_product_price_exclude_vat <= 0
            ):
                raise ValidationError(
                    "직거래 상품인 경우, 협력사 상품가는 0 보다 큰 값 이어야 합니다."
                )
        else:
            track_inventory = outer_variant.track_inventory
            if track_inventory:
                if (
                    variant_vendor.product_price_exclude_vat <= 0
                    and variant_vendor.consignment_product_price_exclude_vat <= 0
                ):
                    raise ValidationError(
                        "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 둘 중 하나는 0 보다 큰 값 이어야 합니다."
                    )
            else:
                if variant_vendor.consignment_product_price_exclude_vat <= 0:
                    raise ValidationError(
                        "재고 미운영 제품인 경우, 협력사 위탁 상품가는 0 보다 큰 값 이어야 합니다."
                    )

        if outer_variant.default_variant_vendor == variant_vendor:
            reset_variant_cost_price_by_default_variant_vendor(
                outer_variant,
                outer_variant.inner,
                variant_vendor,
                save_default_variant_vendor=False,
            )
            reset_po_lead_time_by_pvv(outer_variant, variant_vendor)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        product_variant_vendor_id = data.get("id")
        before_product_variant_vendor = cls.get_node_or_error(
            info,
            product_variant_vendor_id,
            field="product_variant_vendor",
            only_type=ProductVariantVendor,
        )
        before_product_variant = before_product_variant_vendor.product_variant
        # 수정전 관계 필드들 스냅샷.
        _, before_product_variant_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_product_variant
        )

        response = super().perform_mutation(_root, info, **data)

        updated_pv = response.productVariantVendor.product_variant

        _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
            before_variant=before_product_variant,
            before_inner_variant=None,
            before_product=None,
            before_product_m2m_and_related_values=None,
            before_variant_m2m_and_related_values=before_product_variant_m2m_and_related_values,
            updated_variant=updated_pv,
            updated_product=None,
        )

        manage_event = data.get("input").get("manage_event")
        if manage_event:
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=updated_pv, manage_event=manage_event, info=info)

        return response


class ProductVariantVendorSetDefault(BaseMutation):
    product_variant = graphene.Field(ProductVariant)

    class Arguments:
        product_variant_id = graphene.ID(
            required=True,
            description="Id of a product variant that will have the default variant vendor set.",
        )
        variant_vendor_id = graphene.ID(
            required=True,
            description="Id of a variant vendor that will be set as default.",
        )
        manage_event = ProductVariantManageEventInput(description="제품 관리 이력", required=True)

    class Meta:
        description = "옵션 제품 기본 협력사 설정"
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, product_variant_id, variant_vendor_id, manage_event):
        variant_vendor: Optional[ProductVariantVendorModel] = cls.get_node_or_error(
            info,
            variant_vendor_id,
            field="variant_vendor_id",
            only_type=ProductVariantVendor,
            qs=models.ProductVariantVendor.objects.select_related("product_variant"),
        )
        before_outer_variant: ProductVariantModel = variant_vendor.product_variant
        _, before_product_variant_m2m_and_related_values = prepare_m2m_and_related_values(
            None, before_outer_variant
        )

        is_fulfilled_by_vendor = before_outer_variant.product.is_fulfilled_by_vendor
        if is_fulfilled_by_vendor:
            if variant_vendor.consignment_product_price_exclude_vat <= 0:
                raise ValidationError(
                    "직거래 상품인 경우, 협력사 상품가가 0 이하면 기본값으로 설정할 수 없습니다."
                )
        else:
            track_inventory = variant_vendor.product_variant.track_inventory
            if track_inventory:
                if (
                    variant_vendor.product_price_exclude_vat <= 0
                    and variant_vendor.consignment_product_price_exclude_vat <= 0
                ):
                    raise ValidationError(
                        "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 모두 0 이하면 기본값으로 설정할 수 없습니다."
                    )
            else:
                if variant_vendor.consignment_product_price_exclude_vat <= 0:
                    raise ValidationError(
                        "재고 미운영 제품인 경우, 협력사 위탁 상품가가 0 이하면 기본값으로 설정할 수 없습니다."
                    )

        if variant_vendor.is_active == False:
            raise ValidationError("활성화 되지 않은 협력사는 기본값으로 설정할 수 없습니다.")

        outer_variant: Optional[ProductVariantModel] = cls.get_node_or_error(
            info,
            product_variant_id,
            field="product_variant_id",
            only_type=ProductVariant,
            qs=models.ProductVariant.objects.select_related("inner"),
        )
        if variant_vendor.product_variant != outer_variant:
            raise ValidationError("기본값으로 설정할 데이터 오류")

        reset_variant_cost_price_by_default_variant_vendor(
            outer_variant, outer_variant.inner, variant_vendor, save_default_variant_vendor=True
        )
        if reset_po_lead_time_by_pvv(outer_variant, variant_vendor) == False:
            raise ValidationError("제품 협력사 L/T 정보 오류로 기본협력사 변경에 실패했습니다.")

        # 변겯 사항 생성.
        _, variant_changes, _ = make_total_change_summary_for_product_and_variant(
            before_variant=before_outer_variant,
            before_inner_variant=None,
            before_product=None,
            before_product_m2m_and_related_values=None,
            before_variant_m2m_and_related_values=before_product_variant_m2m_and_related_values,
            updated_variant=outer_variant,
            updated_product=None,
        )

        if manage_event:
            change_details = "\n".join(variant_changes)
            manage_event["change_details"] = change_details
            add_pv_manage_event(pv=outer_variant, manage_event=manage_event, info=info)

        return ProductVariantVendorSetDefault(product_variant=outer_variant)
