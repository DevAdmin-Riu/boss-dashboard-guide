class PurchaseOrderCreate(ModelMutation):
    class Arguments:
        input = PurchaseOrderCreateInput(
            required=True, description="Fields required to create a purchase order."
        )

    class Meta:
        description = "Creates a new purchase order."
        model = models.PurchaseOrder
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_duplicate_consignment_po(cls, cleaned_input, lines: List[Dict]):
        event_type = cleaned_input["event_type"]
        if event_type != PurchaseOrderEventType.CONSIGNMENT:
            return
        order_line_pks = []
        for line_data in lines:
            order_line_id = line_data.get("order_line_id")
            _model, order_line_pk = graphene.Node.from_global_id(order_line_id)
            order_line_pks.append(order_line_pk)
        consignment_po_exist = (
            models.PurchaseOrderLine.objects.exclude(status=PurchaseOrderLineStatus.CANCELED)
            .filter(order_line_id__in=order_line_pks)
            .exists()
        )
        if consignment_po_exist:
            raise ValidationError("이미 발주서가 등록되어 있습니다.")

    @classmethod
    def validate_source_purchase_order(cls, cleaned_input):
        source_purchase_order: PurchaseOrderModel = cleaned_input.get("source_purchase_order", None)
        if source_purchase_order and source_purchase_order.is_track_inventory_po == False:
            raise ValidationError("초도 발주, 재발주 타입만 불러오기로 선택할 수 있습니다.")

    @classmethod
    def validate_delivery_address(cls, cleaned_input):
        event_type = cleaned_input["event_type"]
        # 반품발주, 위탁발주인 경우는 납품장소 정보 불필요
        if (
            event_type == PurchaseOrderEventType.TAKE_BACK
            or event_type == PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK
            or event_type == PurchaseOrderEventType.CONSIGNMENT
        ):
            return cleaned_input

        delivery_warehouse_name = cleaned_input["delivery_warehouse_name"]
        if not delivery_warehouse_name:
            raise ValidationError("납품처를 입력해주세요.")

        warehouse = cleaned_input.get("warehouse")
        is_external_warehouse_delivery = warehouse is None
        delivery_warehouse_manager = cleaned_input["delivery_warehouse_manager"]
        if is_external_warehouse_delivery and not delivery_warehouse_manager:
            raise ValidationError("외부업체 납품 시 납품처 담당자 이름 입력은 필수입니다.")

        phone = cleaned_input["phone"]
        if is_external_warehouse_delivery and not phone:
            raise ValidationError("외부업체 납품 시 납품처 담당자 연락처 입력은 필수입니다.")

        if phone:
            try:
                cleaned_input["phone"] = validate_possible_number(phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "올바른 전화번호를 입력하세요."
                raise ValidationError(
                    {"phone": ValidationError(f"'{phone}' {phoneValidErrorMsg}", code=exc.code)}
                ) from exc

        postal_code = cleaned_input["postal_code"]
        if not postal_code:
            raise ValidationError("우편번호를 입력해주세요.")

        street_address_1 = cleaned_input["street_address_1"]
        if not street_address_1:
            raise ValidationError("주소를 입력해주세요.")

        return cleaned_input

    @classmethod
    def clean_input(cls, info, instance, input_data, input_lines):
        cleaned_input = super().clean_input(info, instance, input_data)
        cls.validate_duplicate_consignment_po(cleaned_input, input_lines)
        vendor = cleaned_input.get("vendor")
        cleaned_input["vendor_data"] = make_vendor_parameters(vendor) if vendor else {}
        cleaned_input["user"] = info.context.user
        cleaned_input["lines"] = None
        cleaned_input["version"] = PurchaseOrderModel.LATEST_VESRSION
        cleaned_input = cls.validate_delivery_address(cleaned_input)
        cls.validate_source_purchase_order(cleaned_input)
        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance: PurchaseOrderModel, cleaned_data):
        constructed_instance: PurchaseOrderModel = super().construct_instance(
            info, instance, cleaned_data
        )
        if constructed_instance.is_track_inventory_po:
            constructed_instance.note = (
                get_plugins_manager()
                .get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
                .default_note_when_creating_purchase_order_with_track_inventory
            )
        return instance

    @classmethod
    def post_save_action(cls, info, instance: PurchaseOrderModel, cleaned_input, input_lines):
        PurchaseOrderLinesAdd.add_purchase_order_lines(cls, info, instance, input_lines)
        source_purchase_order: PurchaseOrderModel = cleaned_input.get("source_purchase_order", None)
        if source_purchase_order:
            manage_event_message = (
                f"({source_purchase_order.code} 발주서 불러오기로 생성) {instance.note}"
            )
        else:
            manage_event_message = instance.note
        events.add_po_manage_event(
            purchase_order=instance,
            user=info.context.user,
            type=PurchaseOrderManageEventType.CREATED,
            parameters={"message": manage_event_message},
        )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        instance = cls.get_instance(info, **data)
        input_data = data.get("input")
        input_lines = input_data.pop("lines", [])
        cleaned_input = cls.clean_input(info, instance, input_data, input_lines)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, input_lines)
        return cls.success_response(instance)


