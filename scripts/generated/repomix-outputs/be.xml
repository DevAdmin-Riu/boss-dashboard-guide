@dataclass
class BrandPaymentValues:
    is_fbv: Optional[bool]
    brand_paying_charge_exclude_vat: Decimal
    mileage_rate: Decimal = Decimal(0)
    card_paying_charge_rate: Decimal = Decimal(0)
    vbank_paying_charge_exclude_vat: Decimal = Decimal(0)
    brand_total_cost_price_amount: Decimal = Decimal(0)
    brand_total_delivery_fee_amount: Decimal = Decimal(0)
    line_price_mul_charge_rate_sum: Decimal = Decimal(0)

    def __add__(self, other):
        if other is None:
            return self
        if not isinstance(other, BrandPaymentValues):
            return NotImplemented

        # + 더하기 필요한 값들만 더하고 나머지는 그냥 0으로 처리. 필요할시 추가 구현.
        return BrandPaymentValues(
            is_fbv=None,
            brand_paying_charge_exclude_vat=self.brand_paying_charge_exclude_vat
            + other.brand_paying_charge_exclude_vat,
            mileage_rate=Decimal(0),
            card_paying_charge_rate=Decimal(0),
            brand_total_cost_price_amount=self.brand_total_cost_price_amount
            + other.brand_total_cost_price_amount,
            brand_total_delivery_fee_amount=self.brand_total_delivery_fee_amount
            + other.brand_total_delivery_fee_amount,
            line_price_mul_charge_rate_sum=Decimal(0),
        )

    def __radd__(self, other):
        # other가 None이면 자기 자신 반환
        if other is None:
            return self
        return self.__add__(other)


