def _send_out_of_stock_notification_to_po_manager(variant: "ProductVariant"):
    closest_to_be_stocked_info = get_closest_to_be_stocked_info(variant)
    est_shortage_info = calc_est_shortage_info(variant=variant, detail_info_mode=False)
    context = {
        "pv_sales_status": term_of_pv_sales_status(variant),
        "sku": variant.sku,
        "product_name": variant.product.name,
        "variant_name": variant.name_for_email,
        "is_safety": term_of_is_safety(variant),
        "need_to_reorder_7": term_of_need_to_reorder(variant.need_to_reorder_7),
        "need_to_reorder_15": term_of_need_to_reorder(variant.need_to_reorder_15),
        "need_to_reorder_30": term_of_need_to_reorder(variant.need_to_reorder_30),
        "est_shortage_date": (
            est_shortage_info.est_shortage_date.strftime("%Y-%m-%d")
            if est_shortage_info.est_shortage_date
            else "-"
        ),
        "est_shortage_date_incl_long_term_qty": (
            est_shortage_info.est_shortage_date_incl_long_term_qty.strftime("%Y-%m-%d")
            if est_shortage_info.est_shortage_date_incl_long_term_qty
            else "-"
        ),
        "closest_to_be_stocked_date": closest_to_be_stocked_info.closest_to_be_stocked_date,
        "closest_to_be_stocked_qty": closest_to_be_stocked_info.closest_to_be_stocked_qty,
    }
    transaction.on_commit(lambda: send_templated_mail_notify_out_of_stock_to_po_manager(context))


def make_bp_info_dict_list_related_pv(pv: "ProductVariant"):
    bpv_qs = (
        pv.brand_product_variants.exclude(brand__is_running=False)
        .prefetch_related("brand_product_packages")
        .all()
    )
    bpv_list: List[BrandProductVariant] = list(bpv_qs.iterator())
    if not bpv_list:
        return None, None

    recipient_set = set()
    bp_info_dict_list = []
    for bpv in bpv_list:
        bpv_info_dict = {}
        brand = bpv.brand
        md_user: "User" = brand.staff if brand else None
        if md_user and md_user.email:
            recipient_set.add(md_user.email)
        brand_product_packages: List[BrandProductPackage] = bpv.brand_product_packages.all()
        bpv_packages_info = [
            brand_product_package.name for brand_product_package in brand_product_packages
        ]
        bpv_info_dict["md_name"] = md_user.first_name if md_user else "-"
        bpv_info_dict["brand_code"] = brand.code
        bpv_info_dict["brand_name"] = brand.name
        bpv_info_dict["bp_sku"] = bpv.bp_sku
        bpv_info_dict["bp_name"] = bpv.brand_product.name
        bpv_info_dict["bpv_is_exclusive"] = terms_of_is_exclusive(bpv.brand_product.is_exclusive)
        bpv_info_dict["bpv_sales_status"] = term_of_bpv_sales_status(bpv)
        bpv_info_dict["bpv_dispaly_status"] = term_of_bpv_display_status(bpv)
        bpv_info_dict["brand_package_info"] = (
            ", ".join(bpv_packages_info) if bpv_packages_info else "-"
        )
        bp_info_dict_list.append(bpv_info_dict)
    bp_info_dict_list.sort(key=lambda x: x["md_name"])
    return bp_info_dict_list, recipient_set


def _send_out_of_stock_notification_to_md(pv: "ProductVariant"):
    bp_info_dict_list, recipient_set = make_bp_info_dict_list_related_pv(pv)
    if not bp_info_dict_list:
        logger.info(
            f"pv_id={pv.id}: 운영중인 브랜드 상품 존재 하지 않는 제품으로 md 에게 재고 소진 알림 메일 발송 안함"
        )
        return

    prefetched_to_be_stocked_po_lines_qs = pv.purchase_order_lines.all()
    prefetched_to_be_stocked_po_lines_qs = (
        filter_to_be_stocked_incl_is_not_orderable_before_stocked_by_po_lines_qs(
            prefetched_to_be_stocked_po_lines_qs
        )
    )
    prefetched_to_be_stocked_po_lines = list(prefetched_to_be_stocked_po_lines_qs)
    closest_to_be_stocked_po_line = get_closest_to_be_stocked_po_line_by_prefetched_data(
        prefetched_to_be_stocked_po_lines, rank=1
    )
    second_to_be_stocked_po_line = get_closest_to_be_stocked_po_line_by_prefetched_data(
        prefetched_to_be_stocked_po_lines, rank=2
    )
    third_to_be_stocked_po_line = get_closest_to_be_stocked_po_line_by_prefetched_data(
        prefetched_to_be_stocked_po_lines, rank=3
    )
    closest_nts_po_line_expected_purchase_date = (
        closest_to_be_stocked_po_line.expected_purchase_date
        if closest_to_be_stocked_po_line
        else None
    )
    closest_nts_po_line_purchase_qty = (
        get_to_be_stocked_qty_by_po_line(closest_to_be_stocked_po_line)
        if closest_to_be_stocked_po_line
        else None
    )
    second_nts_po_line_expected_purchase_date = (
        second_to_be_stocked_po_line.expected_purchase_date
        if second_to_be_stocked_po_line
        else None
    )
    second_nts_po_line_purchase_qty = (
        get_to_be_stocked_qty_by_po_line(second_to_be_stocked_po_line)
        if second_to_be_stocked_po_line
        else None
    )
    third_nts_po_line_expected_purchase_date = (
        third_to_be_stocked_po_line.expected_purchase_date if third_to_be_stocked_po_line else None
    )
    third_nts_po_line_purchase_qty = (
        get_to_be_stocked_qty_by_po_line(third_to_be_stocked_po_line)
        if third_to_be_stocked_po_line
        else None
    )

    context = {
        "items": bp_info_dict_list,
        "pv_sales_status": term_of_pv_sales_status(pv),
        "sku": pv.sku,
        "product_name": pv.product.name,
        "is_exclusive": terms_of_is_exclusive(pv.product.is_exclusive),
        "closest_nts_po_line_expected_purchase_date": (
            closest_nts_po_line_expected_purchase_date.strftime("%Y-%m-%d")
            if closest_nts_po_line_expected_purchase_date
            else "-"
        ),
        "closest_nts_po_line_purchase_qty": (
            closest_nts_po_line_purchase_qty if closest_nts_po_line_purchase_qty else "-"
        ),
        "second_nts_po_line_expected_purchase_date": (
            second_nts_po_line_expected_purchase_date.strftime("%Y-%m-%d")
            if second_nts_po_line_expected_purchase_date
            else "-"
        ),
        "second_nts_po_line_purchase_qty": (
            second_nts_po_line_purchase_qty if second_nts_po_line_purchase_qty else "-"
        ),
        "third_nts_po_line_expected_purchase_date": (
            third_nts_po_line_expected_purchase_date.strftime("%Y-%m-%d")
            if third_nts_po_line_expected_purchase_date
            else "-"
        ),
        "third_nts_po_line_purchase_qty": (
            third_nts_po_line_purchase_qty if third_nts_po_line_purchase_qty else "-"
        ),
    }

    recipient_list = list(recipient_set)
    transaction.on_commit(
        lambda context=context, recipient_list=recipient_list: send_templated_mail_notify_out_of_stock_to_md(
            context, recipient_list
        )
    )


def send_out_of_stock_notification(variant: "ProductVariant", stock: "Stock"):
    """
    ### 재고 소진 알림 보내는 정책
    * 위탁 제품은 알림 발송 안함
    * 이너 제품은 알림 발송 안함
    * 부자재 제품은 알림 발송 안함
    * 출고, 로스처리, 소분처리, 반품 처리 등으로 실제 재고 감소 처리 ( Stock.decrease_stock ) 처리 시 재고가 0 이하가 되면 알림 발송
    * 자동 위탁 전환되는 경우에는 md 에게는 발송 중지
    """
    if variant.track_inventory == False or variant.outer is not None or variant.is_sub_pv:
        return
    _send_out_of_stock_notification_to_po_manager(variant)
    if not variant.allow_auto_consignment:
        _send_out_of_stock_notification_to_md(variant)
