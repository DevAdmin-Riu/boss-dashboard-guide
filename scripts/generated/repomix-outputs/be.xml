from typing import TYPE_CHECKING, Union

from ...site.models import RegionInfo
from ..models import (
    BrandProduct,
    BrandProductVariant,
    BrandProductVariantRegion,
    ProductVariant,
    ProductVariantRegion,
)

if TYPE_CHECKING:
    from ...account.models import Brand, User


def get_brand_product_variant_by_brand(
    variant: ProductVariant, brand: "Brand"
) -> "BrandProductVariant":
    if variant:
        return variant.brand_product_variants.filter(brand=brand).first()
    return None


def get_brand_product_variant_by_brand_product(
    brand_product: BrandProduct, variant: ProductVariant
) -> "BrandProductVariant":
    if brand_product:
        return brand_product.brand_product_variants.filter(product_variant=variant).first()
    return None


def get_brand_product_variant_region_by_brand(
    variant: ProductVariant, brand: "Brand", region: RegionInfo
) -> BrandProductVariantRegion:
    if variant is None or brand is None or region is None:
        return None
    brand_product_variant = variant.brand_product_variants.filter(
        brand=brand, product_variant=variant
    ).first()
    return (
        brand_product_variant.regions.filter(region=region).first()
        if brand_product_variant
        else None
    )


# NOTE 로직 수정시 get_user_product_variant_for_loader 함수도 수정 고려 필요.
def get_user_product_variant(
    variant: ProductVariant,
    user: "User",
    raise_exception: bool,
    use_brand_instead_of_switched_brand: bool = False,
) -> Union[
    "ProductVariant", "ProductVariantRegion", "BrandProductVariant", "BrandProductVariantRegion"
]:
    product = variant.product
    if product is None:
        raise Exception("제품 정보 오류: product is None")

    is_direct_shipping = product.is_direct_shipping

    # 만약 use_brand_instead_of_switched_brand이 true이면, brand를 사용하고, 아니면 switched_brand를 사용한다. user가 없으면 brand는 None이다.
    brand = (
        user.switched_brand if user and user.switched_brand_id and not user.is_anonymous else None
    )
    brand = (
        user.brand
        if (user and not user.is_anonymous and use_brand_instead_of_switched_brand)
        else brand
    )
    region = user.region if user and not user.is_anonymous else None
    if brand is None:
        if is_direct_shipping:
            result = get_product_variant_region(variant=variant, region=region)
        else:
            result = variant
    else:
        if product.is_direct_shipping:
            result = get_brand_product_variant_region_by_brand(
                variant=variant, brand=brand, region=region
            )
        else:
            result = get_brand_product_variant_by_brand(variant=variant, brand=brand)

    if raise_exception and result is None:
        sku = variant.sku
        raise Exception(
            f"제품 정보 오류: 판매 제품 정보 구성을 확인해 주세요. {sku} / user={user} / {brand}"
        )

    return result


def get_brand_product_variant_region_by_brand_product(
    variant: ProductVariant, brand_product: BrandProduct, region: RegionInfo
) -> BrandProductVariantRegion:
    if variant is None or brand_product is None or region is None:
        return None

    brand_product_variant = variant.brand_product_variants.filter(
        brand_product=brand_product, product_variant=variant
    ).first()
    return (
        brand_product_variant.regions.filter(region=region).first()
        if brand_product_variant
        else None
    )


def get_product_variant_region(variant: ProductVariant, region: RegionInfo) -> ProductVariantRegion:
    if variant is None or region is None:
        return None
    return variant.regions.filter(region=region).first()


def get_product_variant_region_using_loader(variant_id, region_id, info):
    from saleor.graphql.product.dataloaders.products import (
        ProductVariantRegionsByProductVariantIdLoader,
    )

    # ProductVariantRegionsByProductVariantIdLoader를 통해 해당 variant의 모든 지역별 정보를 불러옵니다.
    def filter_variant_region(variant_regions):
        for variant_region in variant_regions:
            if variant_region.region_id == region_id:
                return variant_region
        return None

    return (
        ProductVariantRegionsByProductVariantIdLoader(info.context)
        .load(variant_id)
        .then(filter_variant_region)
    )
