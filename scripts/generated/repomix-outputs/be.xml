    def save(self, *args, **kwargs):
        # old_brand 가 None인 경우는 brand 생성 시점이므로 pk가 없는 상태
        old_brand = Brand.objects.get(pk=self.pk) if self.pk else None

        validate_not_only_linkers(self)
        validate_use_fbv_service_type(self)
        validate_contract_type_vs_mileage_rate(self)
        validate_people_in_charge_info(self)
        validate_boss_market_mileage_contract(self)

        validate_b2b_contract_type(self, old_brand)

        validate_contract_status_for_create(self)

        update_brand_code_user_info(self, old_brand)

        if not self.code:
            for i in range(20):
                self.code = generate_brand_code()
                try:
                    super().save(*args, **kwargs)
                    return
                except IntegrityError as e:
                    error_message = str(e)
                    if "unique" in error_message and "code" in error_message:
                        continue
                    else:
                        raise e
            raise ValidationError(f"브랜드 코드를 생성하는데 실패했습니다.")
        else:
            super().save(*args, **kwargs)

    def __str__(self):
        return self.name

    @transaction.atomic()
    def decrease_remain_dev_cost(
        self,
        qty: int,
        type: "BrandDevCostEventType",
        description: str,
    ):
        if self.remain_dev_cost < qty:
            raise ValidationError("남은 상품 개발비 보다 많은 개발비를 차감하려고 합니다.")

        qty_before = self.remain_dev_cost
        qty_after = self.remain_dev_cost - qty
        self.remain_dev_cost = qty_after
        Brand.objects.filter(pk=self.pk).update(remain_dev_cost=F("remain_dev_cost") - qty)

        return create_brand_dev_cost_event(
            qty_before=qty_before,
            qty_after=qty_after,
            qty=qty,
            type=type,
            brand=self,
            description=description,
        )

    @transaction.atomic()
    def increase_remain_dev_cost(
        self,
        qty: int,
        type: "BrandDevCostEventType",
        description: str,
    ):
        qty_before = self.remain_dev_cost
        qty_after = self.remain_dev_cost + qty
        self.remain_dev_cost = qty_after
        Brand.objects.filter(pk=self.pk).update(remain_dev_cost=F("remain_dev_cost") + qty)

        return create_brand_dev_cost_event(
            qty_before=qty_before,
            qty_after=qty_after,
