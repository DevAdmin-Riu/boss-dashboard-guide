        error_type_class = BrandStoreOpsCheckError
        error_type_field = "brand_store_ops_check_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        template_id = data["template"]
        moves = data["moves"]

        template = cls.get_node_or_error(
            info, template_id, only_type="BsOpsCheckTemplate", field="template"
        )

        handler = ItemMoveHandler(
            model_class=BsOpsCheckModels.BsOpsCheckTemplateCategory,
            gql_type_name="BsOpsCheckTemplateCategory",
            relation_field_name="parent_id",
            container_field_name="template",  # 상위 컨테이너 필드 명시
        )

        qs = BsOpsCheckModels.BsOpsCheckTemplateCategory.objects.filter(template=template)

        operations = []
        for move in moves:
            handler.clean_move(move)
            operation = handler.get_move_operation(cls, info, move, qs)
            handler.clean_operation(operation)
            handler.perform_change_parent(operation)
            operations.append(operation)

        # 정렬 재정렬
        sort_operations: Dict[Optional[int], Dict[int, int]] = defaultdict(dict)
        sort_querysets: Dict[Optional[int], QuerySet] = {}

        for op in operations:
            parent_pk = getattr(op.item, "parent_id")
            sort_operations[parent_pk][op.item.pk] = op.move
            sort_querysets[parent_pk] = op.item.get_ordering_queryset()

        for parent_pk, ops in sort_operations.items():
            qs = sort_querysets[parent_pk]
            perform_reordering(qs, ops)

        return BsOpsCheckTemplateCategoryMove(template=template)


