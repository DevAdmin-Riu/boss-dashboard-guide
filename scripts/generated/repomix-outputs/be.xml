class RequestBossProductCreate(ModelMutation):
    class Arguments:
        input = RequestBossProductCreateInput(required=True, description="보스 상품 등록 요청 입력")

    class Meta:
        description = "보스 상품 등록 요청"
        model = models.RequestBossProduct
        permissions = (BbsPermissions.MANAGE_REQUEST_BOSS_PRODUCT,)
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    # is_hq_staff이거나 permissions를 가진 유저이거나 check_permissions override
    @classmethod
    def check_permissions(cls, context, permissions=None, **data):
        if context.user.is_hq_staff:
            return True
        else:
            return super().check_permissions(context, permissions, **data)

    @classmethod
    def clean_input(cls, info, instance: RequestBossProductModel, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data, input_cls)
        cleaned_input["updated_at"] = timezone.now()

        if cls == RequestBossProductCreate or cls == RequestBossProductCreateByProductVariant:
            user: User = info.context.user
            brand = cleaned_input["brand"]

            # 가맹본부 직원인 경우
            if user.is_hq_staff:
                if user.brand != brand:
                    raise ValidationError("해당 브랜드의 가맹본부만 등록 가능합니다.")
                cleaned_input["hq_staff"] = user
                cleaned_input["staff"] = None

            # 최고 관리자인 경우 (is_staff 체크)
            elif user.is_staff:
                cleaned_input["hq_staff"] = None
                cleaned_input["staff"] = user

            else:
                raise ValidationError("해당 브랜드에 대한 권한이 없습니다.")

        if cls == RequestBossProductCreate:
            cleaned_input["by_product_variant"] = False
            cleaned_input["status_changed_at"] = timezone.now()
            cleaned_input["status"] = RequestBossProductStatus.REQUESTED
        elif cls == RequestBossProductCreateByProductVariant:
            cleaned_input["status_changed_at"] = timezone.now()
            cleaned_input["status"] = RequestBossProductStatus.BRAND_PRICE
        else:
            before_status = cls.get_before_status(instance)
            if before_status == RequestBossProductStatus.REQ_ADDITIONAL:
                cleaned_input["status_changed_at"] = timezone.now()
                cleaned_input["status"] = RequestBossProductStatus.ACCEPTED
        return cleaned_input

    @classmethod
    def get_before_status(cls, instance: RequestBossProductModel):
        return None if instance.pk is None else instance.status

    @classmethod
    def post_save_action(
        cls,
        info,
        instance: RequestBossProductModel,
        cleaned_input,
        before_status,
    ):
        after_status = instance.status
        if before_status != after_status:
            models.RequestBossProductStatusHistory.objects.create(
                request=instance,
                before_status=before_status,
                after_status=after_status,
                writer=info.context.user,
                reason="",
            )
        if cls == RequestBossProductCreate:
            image_list = cleaned_input.get("image_list", [])
            for image_input in image_list:
                image_data = info.context.FILES.get(image_input)
                validate_image_file(image_data, "image")
                instance.images.create(image=image_data)
        elif cls == RequestBossProductCreateByProductVariant:
            image_list = cleaned_input.get("image_list", [])
            for image_input in image_list:
                models.RequestBossProductImage.objects.create(
                    request=instance, image=image_input.image
                )

        brand = instance.brand
        staff_email = brand.staff.email if brand and brand.staff else None
        if staff_email:
            context = {
                "request_number": instance.request_number,
                "brand_code": brand.code,
                "brand_name": brand.name,
                "product_name": instance.product_name,
                "dashboard_url": build_absolute_dashboard_uri(),
            }
            if cls == RequestBossProductCreate:
                send_templated_mail_fn = send_templated_mail_req_boss_product_requested
            elif cls == RequestBossProductUpdate:
                if (
                    before_status == RequestBossProductStatus.REQ_ADDITIONAL
                    and after_status == RequestBossProductStatus.ACCEPTED
                ):
                    send_templated_mail_fn = send_templated_mail_req_boss_product_accepted
                else:
                    send_templated_mail_fn = None
            elif cls == RequestBossProductCreateByProductVariant:
                send_templated_mail_fn = send_templated_mail_req_boss_product_brand_price
            else:
                send_templated_mail_fn = None
            if send_templated_mail_fn:
                transaction.on_commit(
                    lambda: send_templated_mail_fn(staff_email=staff_email, context=context)
                )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        before_status = cls.get_before_status(instance)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input, before_status)
        return cls.success_response(instance)


