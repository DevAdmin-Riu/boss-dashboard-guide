    )
    is_rcoin_reward_for_using_point = models.BooleanField(default=False)
    is_only_payable_by_cash = models.BooleanField(default=False)

    def __str__(self):
        return f"{self.reward} - {self.order_line}"

    class Meta:
        ordering = ("-pk",)


