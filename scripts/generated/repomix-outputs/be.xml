import locale
import re
from decimal import Decimal
from typing import Union

from saleor.core.utils.math import my_round


def convert_unicode_to_kr(text: str):
    return text.encode("utf-8").decode("unicode_escape")


def convert_to_unicode(text: str):
    return text.encode("unicode_escape").decode("utf-8")


def replace_all_using_replace_dict(text: str, replace_dict: dict):
    if not replace_dict:
        return text
    replace_dict = dict((re.escape(k), v) for k, v in replace_dict.items())
    pattern = re.compile("|".join(replace_dict.keys()))
    text = pattern.sub(lambda m: replace_dict[re.escape(m.group(0))], text)
    return text


def to_locale_number(value: Union[Decimal, int]):
    if value is None:
        return "-"
    locale.setlocale(locale.LC_NUMERIC, "ko_KR")
    rounded_value = my_round(float(value))
    return "{0:n}".format(rounded_value)


def is_non_empty_str(value):
    return isinstance(value, str) and value.strip() != ""
