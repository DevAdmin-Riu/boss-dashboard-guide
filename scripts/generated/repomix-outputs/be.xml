import logging
from typing import TYPE_CHECKING, List

from django.core.exceptions import ValidationError
from django.core.validators import validate_email
from django.db import transaction

from ..account.validators import validate_possible_number
from ..core.prices import calc_total_include_vat_by_unit_exclude_vat_and_qty
from ..graphql.core.utils import from_global_id_strict_type
from . import FbvPurchaseCostEventType, models
from .models import Vendor, make_vendor_code

if TYPE_CHECKING:
    from ..account.models import User
    from ..order.models import FulfillmentLine, Order
    from .models import FbvPurchaseCostEvent

logger = logging.getLogger(__name__)


def get_vendor_id_from_query(value):
    try:
        return from_global_id_strict_type(value, only_type="Vendor", field="pk")
    except Exception:
        return None


def get_account_manager_from_vendor_managers(managers: list):
    if managers:
        return next((manager for manager in managers if manager.get("type") == "ACCOUNT"), None)

    return None


def get_account_manager_info(vendor: Vendor):
    account_manager = get_account_manager_from_vendor_managers(vendor.managers)
    if not account_manager:
        error_msg = f"Vendor({vendor.name})의 회계 담당자 정보가 없습니다."
        logger.error(error_msg)
        return None, None, error_msg

    manager_phone = ""
    try:
        manager_phone = validate_possible_number(account_manager.get("phone"))
    except:
        pass

    manager_email = account_manager.get("email")
    if manager_email:
        manager_email = manager_email.strip()

    try:
        validate_email(manager_email)
    except:
        error_msg = f"Vendor({vendor.name})의 회계 담당자 이메일 형식 오류:{manager_email}"
        logger.error(error_msg)
        return manager_phone, None, error_msg

    return manager_phone, manager_email, None


def get_main_order_manager_from_vendor_managers(managers: list):
    if managers:
        return next((manager for manager in managers if manager.get("type") == "ORDER"), None)

    return None


def get_main_order_manager_info(vendor: Vendor):
    main_order_manager = get_main_order_manager_from_vendor_managers(vendor.managers)
    if not main_order_manager:
        error_msg = f"Vendor({vendor.name})의 메인 주문 담당자 정보가 없습니다."
        logger.error(error_msg)
        return None, None, None, error_msg

    manager_phone = ""
    try:
        manager_phone = validate_possible_number(main_order_manager.get("phone"))
    except:
        pass

    manager_name = main_order_manager.get("name")

    manager_email = main_order_manager.get("email")
    if manager_email:
        manager_email = manager_email.strip()

    try:
        validate_email(manager_email)
    except:
        error_msg = f"Vendor({vendor.name})의 메인 주문 담당자 이메일 형식 오류:{manager_email}"
        logger.error(error_msg)
        return manager_phone, None, manager_name, error_msg

    return manager_phone, manager_email, manager_name, None


def get_sub_order_manager_email_list(vendor: Vendor):
    email_list = []

    if not vendor.managers:
        return email_list

    valid_types = {"ORDER_FIRST_SUB", "ORDER_SECOND_SUB"}

    for manager in vendor.managers:
        email = manager.get("email", None)
        if manager.get("type") in valid_types and email:
            email = email.strip()
            email_list.append(email)

    return email_list


def get_order_manager_receiver_phone_bulk(vendor: Vendor):
    receiver_phones = []

    if not vendor.managers:
        return receiver_phones

    valid_types = {"ORDER", "ORDER_FIRST_SUB", "ORDER_SECOND_SUB"}

    for manager in vendor.managers:
        phone = manager.get("phone", None)
        if manager.get("type") in valid_types and phone:
            try:
                validated_phone = validate_possible_number(phone)
                if validated_phone:
                    receiver_phones.append(validated_phone)
            except Exception as e:
                logger.warning(f"전화번호 검증 실패 - Vendor({vendor.name}) 매니저: {phone} - {e}")

    return receiver_phones


def make_vendor_staff_user(vendor: Vendor):
    manager_phone, manager_email, _, error_msg = get_main_order_manager_info(vendor)
    if not manager_email:
        return None, error_msg

    vendor_code = make_vendor_code(vendor)

    vendor_staff_user_dict = {
        "login_id": vendor_code,
        # vendor_code 로 초기 비밀번호 세팅으로 변경 요청
        # "password": generate_random_password(),
        "password": vendor_code,
        "first_name": vendor.name,
        "email": manager_email,
        "aligo_phone": manager_phone,
        "is_active": True,
        "is_staff": False,
        "is_hq_staff": False,
        "is_vendor_staff": True,
    }

    return vendor_staff_user_dict, None


def get_fbv_purchase_cost_remain_amount(brand, vendor):
    latest_obj: "FbvPurchaseCostEvent" = (
        models.FbvPurchaseCostEvent.objects.select_for_update()
        .filter(brand=brand, vendor=vendor)
        .first()
    )
    return latest_obj.amount_after if latest_obj else 0


@transaction.atomic
def decrease_fbv_purchase_cost_remain_amount(
    user,
    brand,
    vendor: "Vendor",
    amount: int,
    type: "FbvPurchaseCostEventType",
    description: str,
    bulk_create_mode: bool = False,
):
    if type not in [
        FbvPurchaseCostEventType.SETTLEMENT,
        FbvPurchaseCostEventType.DECREASE,
    ]:
        raise ValidationError(f"{type}: 가맹본부 협력사 채무를 감소시킬 수 있는 타입이 아닙니다.")

    if vendor.is_riu:
        raise ValidationError(f"리우의 경우 해당 기능을 통해 협력사 채무를 감소시킬 수 없습니다.")

    amount_before = get_fbv_purchase_cost_remain_amount(brand, vendor)
    if type == FbvPurchaseCostEventType.SETTLEMENT:
        if amount_before < amount:
            raise ValidationError("지급 금액이 현재 잔여 가맹본부 협력사 채무보다 많습니다.")
    amount_after = amount_before - amount

    if bulk_create_mode:
        return models.FbvPurchaseCostEvent(
            user=user,
            brand=brand,
            vendor=vendor,
            amount=amount,
            type=type,
            description=description,
            amount_before=amount_before,
            amount_after=amount_after,
        )
    return models.FbvPurchaseCostEvent.objects.create(
        user=user,
        brand=brand,
        vendor=vendor,
        amount=amount,
        type=type,
        description=description,
        amount_before=amount_before,
        amount_after=amount_after,
    )


@transaction.atomic
def increase_fbv_purchase_cost_remain_amount(
    user,
    brand,
    vendor,
    amount: int,
    type: "FbvPurchaseCostEventType",
    description: str,
    bulk_create_mode: bool = False,
):
    if type not in [
        FbvPurchaseCostEventType.PURCHASE,
        FbvPurchaseCostEventType.INCREASE,
    ]:
        raise ValidationError(f"{type}: 가맹본부 협력사 채무를 증가시킬 수 있는 타입이 아닙니다.")

    if vendor.is_riu:
        raise ValidationError(f"리우의 경우 해당 기능을 통해 협력사 채무를 증가시킬 수 없습니다.")

    amount_before = get_fbv_purchase_cost_remain_amount(brand, vendor)
    amount_after = amount_before + amount
    if bulk_create_mode:
        return models.FbvPurchaseCostEvent(
            user=user,
            brand=brand,
            vendor=vendor,
            amount=amount,
            type=type,
            description=description,
            amount_before=amount_before,
            amount_after=amount_after,
        )
    return models.FbvPurchaseCostEvent.objects.create(
        user=user,
        brand=brand,
        vendor=vendor,
        amount=amount,
        type=type,
        description=description,
        amount_before=amount_before,
        amount_after=amount_after,
    )


def add_fbv_purchase_cost_event_on_order_fulfilled(
    requester: "User", order: "Order", fulfillment_lines: List["FulfillmentLine"]
):
    create_list = []
    for fulfillment_line in fulfillment_lines:
        line_total_amount_include_vat = calc_total_include_vat_by_unit_exclude_vat_and_qty(
            fulfillment_line.unit_cost_price_exclude_vat,
            fulfillment_line.quantity,
            fulfillment_line.order_line.is_tax_free,
        )
        order_line = fulfillment_line.order_line
        create_obj = increase_fbv_purchase_cost_remain_amount(
            user=requester,
            brand=order.user.brand,
            vendor=fulfillment_line.vendor,
            amount=line_total_amount_include_vat,
            type=FbvPurchaseCostEventType.PURCHASE,
            description=f"주문번호: {order_line.composed_id_with_prefix}",
            bulk_create_mode=True,
        )
        create_list.append(create_obj)

    if create_list:
        models.FbvPurchaseCostEvent.objects.bulk_create(create_list)
