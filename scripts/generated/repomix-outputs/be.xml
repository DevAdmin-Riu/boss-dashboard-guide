    def resolve_est_shortage_info(root: ProductVariantModel, info):
        def handle_stocks(results):
            (
                outer_pv,
                inner_pv,
                outer_stocks,
                inner_stocks,
                qty_to_be_stocked_long_term,
                orderable_qty_incl_long_term,
                latest_stocked_po_line,
            ) = results
            outer_qty = sum(stock.quantity for stock in outer_stocks)
            outer_base_inner_qty = 0
            if root.is_inner:
                pack_count = calc_pack_count(root, outer_pv)
            else:
                pack_count = calc_pack_count(inner_pv, root)
            if inner_stocks is not None and pack_count > 0:
                inner_qty = sum(stock.quantity for stock in inner_stocks)
                outer_base_inner_qty = my_round(inner_qty / pack_count, 2)
            total_stock_qty = outer_qty + outer_base_inner_qty
            root._state.fields_cache["outer"] = outer_pv
            root._state.fields_cache["inner"] = inner_pv
            est_shortage_info = calc_est_shortage_info(
                variant=root,
                total_stock_qty=total_stock_qty,
                latest_stocked_po_line=latest_stocked_po_line,
                detail_info_mode=True,
                qty_to_be_stocked_long_term=qty_to_be_stocked_long_term,
                orderable_qty_incl_long_term=orderable_qty_incl_long_term,
            )
            est_shortage_info.stock_status_by_daily = root.stock_status_by_daily
            return est_shortage_info

        if root.is_inner:
            outer_id = root.outer_id
            outer_pv_loader = ProductVariantByIdLoader(info.context).load(outer_id)
            inner_pv_loader = Promise.resolve(None)
            outer_stocks_loader = StocksByProductVariantIdLoader(info.context).load(outer_id)
            inner_stocks_loader = StocksByProductVariantIdLoader(info.context).load(root.id)
            qty_to_be_stocked_long_term_loader = QtyToBeStockedLongTermByProductVariantIdLoader(
                info.context
            ).load(outer_id)
            orderable_qty_long_term_loader = LongTermOrderableQtyByProductVariantIdLoader(
                info.context
            ).load(outer_id)
            latest_stocked_po_line_loader = LastStockedPoLineByProductVariantIdLoader(
                info.context
            ).load(outer_id)
        else:
            outer_pv_loader = Promise.resolve(None)
            inner_pv_loader = (
                ProductVariantByIdLoader(info.context).load(root.inner_id)
                if root.inner_id
                else Promise.resolve(None)
            )
            outer_stocks_loader = StocksByProductVariantIdLoader(info.context).load(root.id)
            inner_stocks_loader = (
                StocksByProductVariantIdLoader(info.context).load(root.inner_id)
                if root.inner_id
                else Promise.resolve(None)
            )
            qty_to_be_stocked_long_term_loader = QtyToBeStockedLongTermByProductVariantIdLoader(
                info.context
            ).load(root.id)
            orderable_qty_long_term_loader = LongTermOrderableQtyByProductVariantIdLoader(
                info.context
            ).load(root.id)
            latest_stocked_po_line_loader = LastStockedPoLineByProductVariantIdLoader(
                info.context
            ).load(root.id)

        return Promise.all(
            [
                outer_pv_loader,
                inner_pv_loader,
                outer_stocks_loader,
                inner_stocks_loader,
                qty_to_be_stocked_long_term_loader,
                orderable_qty_long_term_loader,
                latest_stocked_po_line_loader,
            ]
        ).then(handle_stocks)

