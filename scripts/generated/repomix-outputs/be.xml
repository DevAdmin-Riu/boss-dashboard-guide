class AccountAddressDirectShippingStatusUpdate(ModelMutation):
    user = graphene.Field(User, description="A user object for which the address was edited.")

    class Arguments:
        id = graphene.ID(description="ID of the address to update.", required=True)
        input = AddressDirectShippingStatusUpdateInput(
            description="Fields required to update the address.", required=True
        )

    class Meta:
        description = "유저의 직배송지 승인 상태 update"
        model = models.Address
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        context_user = info.context.user
        is_staff = context_user.is_staff
        instance = cls.get_instance(info, **data)
        cleaned_input = cls.clean_input(info=info, instance=instance, input_data=data.get("input"))
        cleaned_input = AddressDirectShippingStatusUpdateInput.validate_direct_shipping_status(
            is_staff, cleaned_input, instance
        )
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)

        user = instance.user_addresses.first()
        user.update_requested_ds_approval()
        success_response = cls.success_response(instance)
        success_response.user = user
        success_response.address = instance
        transaction.on_commit(
            lambda: send_kakaotalk_to_user_on_ds_address_status(address=instance, user=user)
        )
        transaction.on_commit(
            lambda: _send_templated_mail_to_md_on_ds_address_requested(address=instance, user=user)
        )
        return success_response


