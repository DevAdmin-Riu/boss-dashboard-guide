    def resolve_quantity_available(root: ProductVariantModel, info):
        requestor = info.context.user
        is_from_dashboard = requestor.is_authenticated and requestor.from_dashboard

        def process_quantity_available(root: ProductVariantModel, product, info, is_from_dashboard):
            country_code = info.context.country
            # Store-front 요청
            if not is_from_dashboard:
                # 품절 여부가 켜 있으면 0을 리턴해서 품절 처리
                if root.force_sold_out_notice:
                    return Promise.resolve(0)
                # 위탁인 경우 최대 가능 구매 수량 반환
                if not root.track_inventory:
                    # 항상 Promise 반환
                    return Promise.resolve(settings.MAX_CHECKOUT_LINE_QUANTITY)

            return AvailableQuantityByProductVariantIdAndCountryCodeLoader(info.context).load(
                (root.id, country_code, is_from_dashboard)
            )

        # 로더 호출
        product_loader = ProductByIdAllLoader(info.context).load(root.product_id)
        rack_stock_loader = RackStockDetailsByProductVariantIdLoader(info.context).load(root.id)

        # Promise.all 사용
        def calculate_available_quantity(results):
            product, rack_stock_details = results
            available_quantity_promise = process_quantity_available(
                root, product, info, is_from_dashboard
            )
            cannot_sell_quantity = get_total_quantity_can_not_sell_by_prefetched_data(
                rack_stock_details
            )

            # Promise 처리 결과에서 값을 빼기
            return available_quantity_promise.then(
                lambda available_quantity: available_quantity - cannot_sell_quantity
            )

        return Promise.all([product_loader, rack_stock_loader]).then(calculate_available_quantity)

