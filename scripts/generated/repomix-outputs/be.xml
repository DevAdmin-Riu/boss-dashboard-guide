class NoticeBrandStoresAssign(BaseMutation):
    notice = graphene.Field(Notice, description="mutation 실행 후 리턴할 notice")

    class Arguments:
        notice_id = graphene.Argument(graphene.ID, required=True, description="ID of a notice.")
        brand_stores = graphene.List(
            graphene.NonNull(graphene.ID), required=True, description="List of BrandStore IDs."
        )

    class Meta:
        description = "공개 매장 리스트에 추가한다."
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, notice_id, brand_stores):
        notice: NoticeModel = cls.get_node_or_error(
            info, notice_id, field="notice_id", only_type=Notice
        )
        brand_store_nodes = cls.get_nodes_or_error(brand_stores, "brand_stores", BrandStoreType)

        for brand_store in brand_store_nodes:
            try:
                models.NoticeAvailableBrandStores.objects.create(
                    notice=notice,
                    brand_store=brand_store,
                )
            except IntegrityError:
                raise ValidationError(
                    f"이미 공지사항({notice.title})에 매장({brand_store.name})이 연결되어 있습니다.",
                )
        return NoticeBrandStoresAssign(notice=notice)


# 가맹 본부 -> 매장 공지사항. 공개 매장 리스트 assign
class NoticeBrandStoresUnassign(BaseMutation):
    notice = graphene.Field(Notice, description="mutation 실행 후 리턴할 notice")

    class Arguments:
        notice_id = graphene.Argument(graphene.ID, required=True, description="ID of a notice.")
        brand_stores = graphene.List(
            graphene.NonNull(graphene.ID),
            required=True,
            description="List of BrandStore IDs to unassign.",
        )

    class Meta:
        description = "공개 매장 리스트에서 제거한다."
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, notice_id, brand_stores):
        notice: NoticeModel = cls.get_node_or_error(
            info, notice_id, field="notice_id", only_type=Notice
        )
        brand_store_nodes = cls.get_nodes_or_error(brand_stores, "brand_stores", BrandStoreType)

        for brand_store in brand_store_nodes:
            deleted_count, _ = models.NoticeAvailableBrandStores.objects.filter(
                notice=notice, brand_store=brand_store
            ).delete()

            if deleted_count == 0:
                raise ValidationError(
                    f"공지사항({notice.title})에 매장({brand_store.name})이 연결되어 있지 않아 제거할 수 없습니다.",
                )

        return NoticeBrandStoresUnassign(notice=notice)


class NoticeAvailableBrandStoresUpsertInput(graphene.InputObjectType):
    notice = graphene.ID(description="Notice ID", required=True)
    brand_store = graphene.ID(description="매장 ID", required=True)
    is_read = graphene.Boolean(description="열람 여부. True: 읽음, False: 안읽음")
    has_confirmed = graphene.Boolean(description="확인 여부. True: 확인함, False: 확인 안함")


class NoticeAvailableBrandStoresUpsert(ModelMutation):
    notice = graphene.Field(Notice, description="공지사항")

    class Arguments:
        input = NoticeAvailableBrandStoresUpsertInput(
            required=True, description="공지사항 매장 열람 여부를 업데이트하기 위한 Input"
        )

    class Meta:
        description = "가맹본부 -> 매장 공지사항 열람 여부 업데이트를 위한 Mutation"
        model = models.NoticeAvailableBrandStores
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def get_instance(cls, info, **data):
        input_data = data.get("input", {})
        _type, notice_id = graphene.Node.from_global_id(input_data.get("notice"))
        _type, brand_store_id = graphene.Node.from_global_id(input_data.get("brand_store"))

        instance = models.NoticeAvailableBrandStores.objects.filter(
            notice_id=notice_id,
            brand_store_id=brand_store_id,
        ).first()
        if instance:
            return instance
        else:
            return cls._meta.model()

    @classmethod
    def save(cls, info, instance, cleaned_input):
        if instance.pk:
            # 기존 값 가져오기
            old = models.NoticeAvailableBrandStores.objects.get(pk=instance.pk)
            if not old.is_read and instance.is_read and not instance.read_at:
                instance.read_at = kst_timezone_now()
            if not old.has_confirmed and instance.has_confirmed and not instance.confirmed_at:
                instance.confirmed_at = kst_timezone_now()
        else:
            # 새 인스턴스일 때
            if instance.is_read and not instance.read_at:
                instance.read_at = kst_timezone_now()
            if instance.has_confirmed and not instance.confirmed_at:
                instance.confirmed_at = kst_timezone_now()
        instance.save()

    @classmethod
    def success_response(cls, instance):
        response = super().success_response(instance)
        response.notice = instance.notice
        return response


