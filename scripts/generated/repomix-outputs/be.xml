class MonthlySalesQtyByBpvIdLoader(DataLoader):

    @classmethod
    def for_month(cls, context, month_offset: int):
        context_key = f"monthly_sales_qty_by_bpv_{month_offset}"
        loader = cls(context, context_key)
        loader.target_month_ago = month_offset
        return loader

    def batch_load(self, keys):
        target_month_ago = self.target_month_ago
        pv_ids = [key[0] for key in keys]
        brand_ids = [key[1] for key in keys]
        today = kst_timezone_date()
        current_month_first = today.replace(day=1)
        if target_month_ago == 0:
            start_date = current_month_first
            end_date = today + relativedelta(days=1)
        else:
            start_date = current_month_first - relativedelta(months=target_month_ago)
            end_date = current_month_first - relativedelta(months=target_month_ago - 1)

        sales_qs = StatsBrandQueries.sales_qs_exclude_canceled()
        # sales 에 보스장터 거래는 두번 기록되어 판매량 집계시 보스장터 건은 제외해야 함
        sales_qs = StatsBrandQueries.filter_sales_exclude_boss_mrkt(sales_qs)
        sales_qs = (
            sales_qs.filter(
                variant_id__in=pv_ids,
                brand_id__in=brand_ids,
                evented_at__date__gte=start_date,
                evented_at__date__lt=end_date,
            )
            .values("variant_id", "brand_id")
            .annotate(total_quantity=Sum("quantity"))
            .order_by()
        )

        sales_map = {
            (sale["variant_id"], sale["brand_id"]): sale["total_quantity"] for sale in sales_qs
        }
        return [sales_map.get((variant_id, brand_id), 0) for variant_id, brand_id in keys]


