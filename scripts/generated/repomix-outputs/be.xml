            qs = qs.filter(code__in=value.split("\n"))
        return qs

    def filter_enabled_services(qs, _, value):
        if value is not None:
            qs = qs.filter(enabled_services__overlap=value)
        return qs

    # useBrandSearch 에서 사용 중이어서 search 필터 유지
    search = django_filters.CharFilter(method=filter_search)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    md_search = django_filters.CharFilter(method=filter_md_search)
    biz_reg_search = django_filters.CharFilter(method=filter_biz_reg_search)

    enabled_services = ListObjectTypeFilter(
        input_class=BrandServiceTypeEnum, method=filter_enabled_services
    )
    contract_type = ListObjectTypeFilter(
        input_class=BrandContractTypeEnum, method=filter_contract_type
    )
    contract_status = ListObjectTypeFilter(
        input_class=BrandContractStatusEnum, method=filter_contract_status
    )

    is_direct_shipping = django_filters.BooleanFilter(method=filter_is_direct_shipping)
    is_contract_warning = django_filters.BooleanFilter(method=filter_is_contract_warning)
    ids = GlobalIDMultipleChoiceFilter(field_name="id")
    staff_users = GlobalIDMultipleChoiceFilter(field_name="staff")
    is_boss_market_use = django_filters.BooleanFilter(method=filter_is_boss_market_use)
    is_boss_market = django_filters.BooleanFilter(method=filter_is_boss_market)
    codes = django_filters.CharFilter(method=filter_codes)

    class Meta:
        model = Brand
        fields = ["is_running"]


class PermissionGroupFilter(django_filters.FilterSet):
    def filter_search(qs, _, value):
        search_fields = ("name",)
        if value:
            qs = filter_by_query_param(qs, value, search_fields)
        return qs

    # usePermissionGroupSearch 에서 사용 중이어서 search 필터 유지
    search = django_filters.CharFilter(method=filter_search)


class StaffUserFilter(django_filters.FilterSet):
