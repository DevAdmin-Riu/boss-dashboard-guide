            _, brand_id = graphene.Node.from_global_id(value)
            qs = qs.filter(brand_id=brand_id)

        return qs

    # 가맹본부 매장 운영 체크 필터
    def filter_is_active(qs, _, value):
        # if value: 로만 하면 False일때와 None일때와 동일해지기 때문에 아래와 같이 해야함.
        if value == True:
            qs = qs.filter(is_active=True)
        elif value == False:
            qs = qs.filter(is_active=False)
