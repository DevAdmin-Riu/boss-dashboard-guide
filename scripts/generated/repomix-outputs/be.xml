                            Q(vendor_id=pk_value) | Q(lines__vendor_id=pk_value)
                        ).distinct()
                    except:
                        raise ValidationError(f"협력업체코드 형식을 확인해 주세요. {value}")

        search_fields = ["vendor__name", "lines__vendor__name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

