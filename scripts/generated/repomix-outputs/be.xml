        search_fields = ["sku", "product_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_maker_sku_search(qs, _, value):
        search_fields = ["maker_sku"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_shape_search(qs, _, value):
        search_fields = ["shape"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_s_c_w_spec_search(qs, _, value):
        search_fields = ["s_c_w_spec"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_material_spec_search(qs, _, value):
        search_fields = ["material_spec"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_color_spec_search(qs, _, value):
        search_fields = ["color_spec"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_track_inventory(qs, _, value):
        if value is not None:
            qs = qs.filter(track_inventory=value)
        return qs

    def filter_maker_search(qs, _, value):
        search_fields = ["maker_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_vendor_search(qs, _, value):
        return filter_vendor_search_factory(
            field_name="vendor_id",
            search_fields=["vendor__name"],
        )(qs, _, value)

    def ai_query_vendor_search(qs, _, value):
        import re

        from pgvector.django import CosineDistance

        transformed_query = value

        # '숫자 x 숫자 x 숫자' 형태의 패턴을 찾습니다. (구분 기호: x, X, *)
        cuboid_pattern = r"(\d+\.?\d*)\s*[xX*]\s*(\d+\.?\d*)\s*[xX*]\s*(\d+\.?\d*)"
        cuboid_match = re.search(cuboid_pattern, value)

        if cuboid_match:
            l_mm, w_mm, h_mm = cuboid_match.groups()

            # 변환된 문장을 만듭니다.
            dimension_sentence = f"장: {l_mm}mm. 폭: {w_mm}mm. 고:{h_mm}mm."

            # 원래 쿼리에서 숫자 규격 부분을 변환된 문장으로 대체합니다.
            transformed_query = value.replace(cuboid_match.group(0), dimension_sentence)

        # --- 검색어 변환 로직 끝 ---

        # 1. (변환된) 질의 임베딩 생성
        instructed_query = f"query: {transformed_query}"
        ai_model = get_estimate_embedding_model()
        query_embedding = ai_model.encode(instructed_query)

        # 2. 유사한 PvEstimate 객체 검색
        queryset = PvEstimate.objects.annotate(
            similarity=1 - CosineDistance("embedding", query_embedding)
        ).all()

        return queryset

    def filter_categories(qs, _, value):
        if value:
            categories = get_nodes(value, "Category", Category)
            qs = filter_products_by_categories(qs, categories)
        return qs

    # 기본 정보: 견적 ID, 견적구분, 채택, 요청 브랜드, 담당 MD, 견적일
    pv_estimate_search = django_filters.CharFilter(method=filter_pv_estimate_search)
    type = ListObjectTypeFilter(input_class=PvEstimateTypeEnum, method=filter_type)
    status = ListObjectTypeFilter(input_class=PvEstimateStatusEnum, method=filter_status)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    md_search = django_filters.CharFilter(method=filter_md_search)
    estimate_date = ObjectTypeFilter(input_class=DateRangeInput, method=filter_estimate_date_range)
    # 제품 정보: 기존 상품명, 구매방식, 동일/대체, 구분(전용/범용), 제품코드/제품명, 품번(제조사)
    prev_product_name_search = django_filters.CharFilter(method=filter_prev_product_name_search)
    buy_method_search = django_filters.CharFilter(method=filter_buy_method_search)
    same_or_replacement_search = django_filters.CharFilter(method=filter_same_or_replacement_search)
    is_exclusive = django_filters.BooleanFilter(method=filter_is_exclusive)
    product_search = django_filters.CharFilter(method=filter_product_search)
    maker_sku_search = django_filters.CharFilter(method=filter_maker_sku_search)
    # 견적 정보: 형태, 규격/용량, 재질/두께, 색상/인쇄도수, 운영방식(재고/위탁), 제조사, 협력사ID/협력사명
    shape_search = django_filters.CharFilter(method=filter_shape_search)
    s_c_w_spec_search = django_filters.CharFilter(method=filter_s_c_w_spec_search)
    material_spec_search = django_filters.CharFilter(method=filter_material_spec_search)
    color_spec_search = django_filters.CharFilter(method=filter_color_spec_search)
    track_inventory = django_filters.BooleanFilter(method=filter_track_inventory)
    maker_search = django_filters.CharFilter(method=filter_maker_search)
    vendor_search = django_filters.CharFilter(method=filter_vendor_search)
    ai_query_search = django_filters.CharFilter(method=ai_query_vendor_search)
    categories = GlobalIDMultipleChoiceFilter(method=filter_categories)

    class Meta:
        model = PvEstimate
        fields = []


class PvEstimateFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = PvEstimateFilter
