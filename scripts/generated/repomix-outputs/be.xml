import django_filters
from django.db.models import F, Q, Value
from django.db.models.functions import Replace
from graphene_django.filter.filterset import GlobalIDFilter, GlobalIDMultipleChoiceFilter

from saleor.brand_store.models import BrandStore as BrandStoreModel

from ...core.db.custom_regexp_replace_fn import RegexpReplace
from ...core.utils.regex import remove_all_non_numeric
from ...site.models import RegionInfo as RegionInfoModel
from ..core.filters import EnumFilter, ListObjectTypeFilter, ObjectTypeFilter
from ..core.types import FilterInputObjectType
from ..core.types.common import DateRangeInput
from ..utils import get_nodes
from ..utils.filters import filter_by_query_param, filter_range_field
from .enums import BrandStoreContractEnum, BrandStoreStatusEnum, BrandStoreTypeEnum


class BrandStoreFilter(django_filters.FilterSet):

    def filter_brand_store_search(qs, _, value):
        search_fields = ["name", "code"]
        return filter_by_query_param(qs, value, search_fields)

    def filter_brand_search(qs, _, value):
        search_fields = [
            "brand__code",
            "brand__name",
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_region_info(qs, _, value):
        if not value:
            return qs

        region_infos = get_nodes(value, "RegionInfo", RegionInfoModel)

        q_obj = Q()
        for region in region_infos:
            q_obj |= Q(
                owner_user__brand_store_address__postal_code__gte=region.pcode_start,
                owner_user__brand_store_address__postal_code__lte=region.pcode_end,
            )

        return qs.filter(q_obj)

    def filter_type(qs, _, value):
        if value:
            qs = qs.filter(type=value)
        return qs

    def filter_status(qs, _, value):
        if value:
            qs = qs.filter(status__in=value)
        return qs

    def filter_contract(qs, _, value):
        if value:
            qs = qs.filter(contract__in=value)
        return qs

    def filter_created_range(qs, _, value):
        return filter_range_field(qs, "created__date", value)

    def filter_supervisor_search(qs, _, value):
        search_fields = [
            "hq_staff_brand_stores__user__first_name",
        ]
        return filter_by_query_param(qs, value, search_fields)

    def filter_biz_reg_no(qs, _, value):
        if value:
            normalized_value = remove_all_non_numeric(value)
            qs = qs.annotate(
                clean_biz_reg_no=RegexpReplace(
                    F("biz_reg_no"),
                    Value("[^0-9]"),  # 숫자가 아닌 모든 문자 제거
                    Value(""),
                )
            )
            return qs.filter(clean_biz_reg_no=normalized_value)
        return qs

    brand_id = GlobalIDFilter(field_name="brand_id")
    brand_store_search = django_filters.CharFilter(method=filter_brand_store_search)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    supervisor_search = django_filters.CharFilter(method=filter_supervisor_search)
    region_info = GlobalIDMultipleChoiceFilter(method=filter_region_info)
    type = EnumFilter(input_class=BrandStoreTypeEnum, method=filter_type)
    status = ListObjectTypeFilter(input_class=BrandStoreStatusEnum, method=filter_status)
    contract = ListObjectTypeFilter(input_class=BrandStoreContractEnum, method=filter_contract)
    created = ObjectTypeFilter(input_class=DateRangeInput, method=filter_created_range)
    biz_reg_no = django_filters.CharFilter(method=filter_biz_reg_no)

    class Meta:
        model = BrandStoreModel
        fields = []


class BrandStoreFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = BrandStoreFilter
