        qs = qs.annotate(
            has_display_in_store=Exists(bpv_displayed_in_store),
            has_any_display=Exists(bpv_displayed_anywhere),
        )
        # 해당 매장에 진열되었거나, 진열된 매장이 없는 상품만
        qs = qs.filter(Q(has_display_in_store=True) | Q(has_any_display=False)).distinct()
        return qs

    def visible_to_user(self, user: "User"):
        if self.user_has_access_to_all(user):
            return self.all()

        qs: models.QuerySet = self
        if user.is_anonymous or not user.is_brand_user:
            return qs
        is_hq_staff_from_dashboard = self.is_hq_staff_from_dashboard(user)
        if is_hq_staff_from_dashboard:
            brand_filter = Q(brand_id=user.brand_id)
            return qs.filter(brand_filter).distinct()

        brand_filter = Q(brand_id__in=[user.switched_brand_id, user.brand_id])
        force_no_normal_display_filter = Q(force_no_normal_display=False)

        def no_direct_shipping_filter():
            direct_shipping_filter = Q(product_variant__product__is_direct_shipping=False)
            price_filter = Q(
                price_amount__isnull=False,
                cost_price_exclude_vat__isnull=False,
                delivery_fee_amount__isnull=False,
            )
            sales_status_filter = Q(
                sales_status__in=[SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED]
            )
            return direct_shipping_filter & price_filter & sales_status_filter

        def direct_shipping_filter(user):
            region = user.region
            direct_shipping_filter = Q(product_variant__product__is_direct_shipping=True)
            region_filter = Q(regions__region=region)
            price_filter = Q(
                regions__price_amount__isnull=False,
                regions__cost_price_exclude_vat__isnull=False,
                regions__delivery_fee_amount__isnull=False,
            )
            sales_status_filter = Q(
                sales_status__in=[SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED]
            )
            return direct_shipping_filter & region_filter & price_filter & sales_status_filter

        filters = (
            brand_filter
            & force_no_normal_display_filter
            & (no_direct_shipping_filter() | direct_shipping_filter(user))
        )
        return self.filter_displayed_in_stores(qs, user, filters)


