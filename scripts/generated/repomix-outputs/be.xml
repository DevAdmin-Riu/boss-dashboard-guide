    embedding = VectorField(dimensions=1024, null=True, blank=True)

    # NOTE 해당 함수가 수정되면 전체 데이터에 대해서 다시 돌려야함. 0348 migration 참조.
    def get_searchable_text(self) -> str:
        import math
        import re

        # 용량, 치수, 규격, 기타 정보를 저장할 별도의 리스트를 준비합니다.
        volume_parts = []
        category_parts = []
        dimension_parts = []
        spec_parts = []
        other_parts = []

        # --- 변수 초기화 ---
        volume_ml = None
        l_mm, w_mm, h_mm = None, None, None
        diameter_mm, height_mm = None, None

        # 1. [정보 추출] 규격/용량/중량 정보가 있으면 계산을 시도합니다.
        if self.s_c_w_spec:
            spec = self.s_c_w_spec

            # --- 텍스트 정규화 (업그레이드) ---
            normalized_spec = spec.lower().replace(" ", "").replace(",", "")
            normalized_spec = (
                normalized_spec.replace("ø", "파이")
                .replace("π", "파이")
                .replace("온스", "oz")
                .replace("×", "x")
            )

            # --- 패턴 정의 (더욱 안정적으로 수정) ---
            capacity_match = re.search(r"(\d+\.?\d*)\s*(ml|cc|l|oz)", normalized_spec)
            cuboid_match = re.search(
                r"^(\d+\.?\d*)\s*(?:mm)?\s*[x*+]\s*(\d+\.?\d*)\s*(?:mm)?\s*[x*+]\s*h?(\d+\.?\d*)\s*(?:mm)?$",
                normalized_spec,
            )
            cylinder_match = re.search(
                r"^(\d+\.?\d*)\s*(?:mm)?\s*(?:파이)?\s*[,x*+]\s*(\d+\.?\d*)\s*(?:mm)?$",
                normalized_spec,
            )
            # 👇 [핵심 수정] 지름만 있는 경우를 찾는 패턴 추가
            diameter_only_match = re.search(r"^(\d+\.?\d*)\s*(?:mm)?\s*파이$", normalized_spec)

            try:
                # 용량과 치수를 독립적으로 분석합니다.
                if capacity_match:
                    volume_str = capacity_match.group(1)
                    value = float(volume_str)
                    unit = capacity_match.group(2)

                    volume_ml = value
                    if unit == "l":
                        volume_ml = value * 1000
                    elif unit == "oz":
                        volume_ml = value * 29.5735

                if cuboid_match:
                    l_mm, w_mm, h_mm = map(float, cuboid_match.groups())
                    if volume_ml is None:
                        l_cm, w_cm, h_cm = l_mm / 10, w_mm / 10, h_mm / 10
                        volume_ml = l_cm * w_cm * h_cm
                    cylinder_match = None

                elif cylinder_match:
                    diameter_mm, height_mm = map(float, cylinder_match.groups())
                    if volume_ml is None:
                        radius_cm = (diameter_mm / 10) / 2
                        height_cm_calc = height_mm / 10
                        volume_ml = math.pi * (radius_cm**2) * height_cm_calc

                # 👇 [핵심 수정] 지름만 있는 경우를 마지막 우선순위로 처리
                elif diameter_only_match:
                    diameter_mm = float(diameter_only_match.group(1))
                    # 높이가 없으므로 부피는 계산하지 않습니다.

            except (ValueError, IndexError, AttributeError):
                pass

        # 2. [텍스트 구성] 이 블록은 s_c_w_spec 유무와 관계없이 항상 실행됩니다.
        # 용량
        volume_parts.append(
            f"! 용량: {int(round(volume_ml))}ml(cc)."
            if volume_ml is not None
            else "! 용량: 정보 없음."
        )

        # 각 치수 정보를 개별적으로 확인하고, 없으면 '정보 없음'을 추가합니다.
        dimension_parts.append(
            f"!!!! 장: {int(l_mm)}mm." if l_mm is not None else "!!!! 장: 정보 없음."
        )
        dimension_parts.append(
            f"!!!! 폭: {int(w_mm)}mm." if w_mm is not None else "!!!! 폭: 정보 없음."
        )
        dimension_parts.append(
            f"!!!! 고: {int(h_mm)}mm." if h_mm is not None else "!!!! 고: 정보 없음."
        )
        dimension_parts.append(
            f"!!!! 파이(지름): {int(diameter_mm)}mm."
            if diameter_mm is not None
            else "!!!! 파이(지름): 정보 없음."
        )

        # 정규식으로 찾은 정보를 제거하는 로직
        spec_for_text = self.s_c_w_spec or ""
        if self.s_c_w_spec:
            spec_for_text = normalized_spec
            if capacity_match:
                spec_for_text = (
                    spec_for_text.replace(capacity_match.group(0), "").strip(" /,").strip()
                )
            if cuboid_match:
                spec_for_text = (
                    spec_for_text.replace(cuboid_match.group(0), "").strip(" /,").strip()
                )
            if cylinder_match:
                spec_for_text = (
                    spec_for_text.replace(cylinder_match.group(0), "").strip(" /,").strip()
                )
            if diameter_only_match:
                spec_for_text = (
                    spec_for_text.replace(diameter_only_match.group(0), "").strip(" /,").strip()
                )

        # 카테고리 정보
        category_parts.append(f"!!! 카테고리: {self.category.name if self.category else '-'}.")

        # 규격 정보를 항상 추가하고, 내용이 없으면 '-'를 사용합니다.
        spec_parts.append(f"! 규격: {spec_for_text or '-'}.")

        # 재질/두께
        spec_parts.append(f"!! 재질: {self.material_spec or '-'}.")
        spec_parts.append(f"두께: {self.material_spec or '-'}.")

        # 색상
        spec_parts.append(f"색상: {self.color_spec or '-'}.")
        spec_parts.append(f"인쇄: {self.color_spec or '-'}.")

        # 형태
        other_parts.append(f"형태: {self.shape or '-'}.")

        # 3. [최종 조합] 용량과 치수의 가중치를 조절합니다.
        final_parts = (
            (category_parts * 4)
            + (volume_parts * 1)
            + (dimension_parts * 5)
            + (spec_parts * 1)
            + other_parts
        )

        # 데이터 확인해볼때 쓰면 됨.
        # print(self.s_c_w_spec)
        # print(spec_parts)
        # print(volume_parts)
        # print(dimension_parts)

        return "passage: 아래는 제품 정보.\n" + "\n".join(final_parts)

    @staticmethod
    def make_code(id: int) -> str:
        return f"{PvEstimate.ID_PREFIX}{str(id).zfill(7)}"

    @property
    def code(self) -> str:
        return PvEstimate.make_code(self.id)


