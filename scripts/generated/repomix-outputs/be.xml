    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, order_line_ids):
        user: "User" = info.context.user
        order_lines: List[OrderLineModel] = cls.get_nodes_or_error(
            order_line_ids, "order_line_ids", OrderLine
        )
        cls.validate_b2b_status(order_lines)
        target_instance_ids = [order_line.pk for order_line in order_lines]
        before_status_list = [order_line.b2b_status for order_line in order_lines]
        models.OrderLine.objects.filter(pk__in=target_instance_ids).update(
            b2b_status=OrderLineB2bStatus.CANCELED
        )
        order_b2b_canceled_event(user=user, order_lines=order_lines)
        bulk_create_order_line_b2b_status_histories(
            order_lines,
            before_status_list=before_status_list,
            after_status=OrderLineB2bStatus.CANCELED,
            user=user,
        )
        return OrderLinesB2bCancel(order_lines=order_lines)
