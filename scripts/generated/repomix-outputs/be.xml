import logging
import random
from typing import TYPE_CHECKING

from ..core.utils import create_thumbnails

if TYPE_CHECKING:
    from .models import PossiblePhoneNumberField, User


logger = logging.getLogger()


def store_user_address(user, address):
    """Add address to user address book and set as default one."""
    address_data = address.as_data()

    address = user.addresses.filter(**address_data).first()
    if address is None:
        address = user.addresses.create(**address_data)

    if not user.default_shipping_address:
        set_user_default_shipping_address(user, address)


def set_user_default_shipping_address(user, address):
    user.default_shipping_address = address
    user.save(update_fields=["default_shipping_address"])


def change_user_default_address(user, address):
    if user.default_shipping_address:
        user.addresses.add(user.default_shipping_address)
    set_user_default_shipping_address(user, address)


def set_user_brand_store_shipping_address(user, address):
    user.brand_store_address = address
    user.save(update_fields=["brand_store_address"])


def change_user_brand_store_address(user, address):
    if user.brand_store_address:
        user.addresses.add(user.brand_store_address)
    set_user_brand_store_shipping_address(user, address)


def create_superuser(credentials):
    user, created = User.objects.get_or_create(
        login_id=credentials["email"],
        email=credentials["email"],
        defaults={
            "is_active": True,
            "is_staff": True,
            "is_superuser": True,
            "is_hq_staff": False,
            "is_vendor_staff": False,
        },
    )
    if created:
        user.set_password(credentials["password"])
        user.save()
        create_thumbnails(pk=user.pk, model=User, size_set="user_avatars", image_attr="avatar")
        msg = "Superuser - %(email)s/%(password)s" % credentials
    else:
        msg = "Superuser already exists - %(email)s" % credentials
    return msg


def remove_staff_member(staff):
    """Remove staff member account only if it has no orders placed.

    Otherwise, switches is_staff status to False.
    """
    if staff.orders.exists():
        staff.is_staff = False
        staff.user_permissions.clear()
        staff.save()
    else:
        staff.delete()


# 01012345678 형식으로 변환
def format_as_numeric_only_phone_number(phone: "PossiblePhoneNumberField"):
    if phone:
        try:
            return f"0{phone.national_number}"
        except Exception:
            logger.error(f"phone 형식 오류:{phone}")
    return None


# 010-1234-5678 형식으로 변환
def format_as_hypenated_phone_number(phone: "PossiblePhoneNumberField"):
    if phone:
        try:
            return f"{phone.as_national}"
        except Exception:
            logger.error(f"phone 형식 오류:{phone}")
    return None


def get_name_with_phone_number(user: "User"):
    if user:
        phone_number = format_as_numeric_only_phone_number(user.aligo_phone)
        return f"{user.first_name} ({phone_number})" if phone_number else user.first_name
    return "-"


def generate_random_string(string_pool, random_string_length):
    result = ""
    for i in range(random_string_length):
        result += random.choice(string_pool)

    return result


