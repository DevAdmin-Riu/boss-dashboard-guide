class CustomerRefundCreate(ModelMutation):
    order = graphene.Field(Order, description="해당 주문")

    class Arguments:
        input = CustomerRefundCreateInput(
            required=True, description="교환/반품/취소 문의 사항 등록을 위한 입력값"
        )

    class Meta:
        description = "교환/반품/취소 요청 등록"
        model = models.RefundQA
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)

        q_type = cleaned_input.get("q_type")
        order: OrderModel = cleaned_input.get("order")
        if not order:
            raise ValidationError("주문 정보가 없습니다.")
        if order.is_for_credits_refill:
            raise ValidationError("충전금용 상품 주문건에 대해서는 교환/반품을 신청할 수 없습니다.")

        cleaned_input["q_writer"] = order.user
        cleaned_input["is_admin_create"] = info.context.user.is_staff

        q_reason_type = cleaned_input.get("q_reason_type")
        q_reason_text = cleaned_input.get("q_reason_text")
        q_order_line_info = cleaned_input.get("q_order_line_info")

        order_line_vendor_id_list = []

        if q_type in [RefundQuestionType.EXCHANGE, RefundQuestionType.REFUND]:
            if not q_order_line_info:
                raise ValidationError("환불할 상품 정보가 없습니다.")

            for line_info in q_order_line_info:
                global_order_line_id = line_info.get("order_line_id")
                # Decimal 타입으로 변환하여 정확한 비교를 준비합니다.
                refund_quantity = int(line_info.get("quantity", 0))

                if not global_order_line_id or refund_quantity <= 0:
                    raise ValidationError("교환/반품 상품 정보에 ID 또는 수량이 잘못되었습니다.")

                try:
                    # 1. Global ID를 디코딩하여 실제 데이터베이스 PK를 가져옵니다.
                    _type, order_line_pk = graphene.Node.from_global_id(global_order_line_id)

                    # 2. 해당 OrderLine 객체를 데이터베이스에서 조회합니다.
                    order_line = OrderLine.objects.get(pk=order_line_pk)
                except OrderLine.DoesNotExist:
                    raise ValidationError(
                        f"존재하지 않는 주문 상품입니다 (ID: {global_order_line_id})."
                    )
                except Exception:
                    raise ValidationError(
                        f"잘못된 주문 상품 ID 형식입니다 (ID: {global_order_line_id})."
                    )
                quantity_refundable = 0
                # 3. 환불 가능한 실제 수량을 계산합니다.
                if order_line.variant.is_adjust_price:
                    quantity_refundable = int(
                        get_ordered_or_fulfill_qty(order_line, order) - order_line.quantity_refunded
                    )
                else:
                    quantity_refundable = int(order_line.quantity - order_line.quantity_refunded)
                order_line_vendor_id_list.append(order_line.vendor_id)

                # 4. 요청된 환불 수량과 비교하여 유효성을 검사합니다.
                if refund_quantity > quantity_refundable:
                    raise ValidationError(
                        f"상품({order_line.product_name})의 교환/반품 요청 수량({refund_quantity})이 "
                        f"교환/반품 가능한 수량({quantity_refundable})보다 많습니다."
                    )

            if len(set(order_line_vendor_id_list)) > 1:
                raise ValidationError("교환 반품 시 여러 협력사 상품이 혼합될 수 없습니다.")

        # order_line_vendor_id_list는 1가지 종류의 값만 가지고 있음. 첫번재 껄 꺼내서 None이 아니면 is_fbv가 True
        is_fbv = bool(order_line_vendor_id_list and order_line_vendor_id_list[0] is not None)
        vendor_id = None
        if q_type == RefundQuestionType.CANCEL:
            lines = list(order.lines.all())
            is_fbv = all(line.is_fulfilled_by_vendor for line in lines)
            if is_fbv:
                vendor_id = lines[0].vendor_id

        cleaned_input["is_fbv"] = is_fbv

        if is_fbv:
            vendor_id = (
                graphene.Node.to_global_id("Vendor", order_line_vendor_id_list[0])
                if not vendor_id
                else graphene.Node.to_global_id("Vendor", vendor_id)
            )
            vendor = cls.get_node_or_error(info, vendor_id, "vendor")
            cleaned_input["vendor"] = vendor

        if info.context.user.is_staff == False and compare_dates_with_offset(
            kst_datetime(order.created), 30
        ):
            raise ValidationError(
                "주문일자로 부터 30일이 지난 주문건에 대해서는 교환/반품을 신청할 수 없습니다."
            )

        if q_type == RefundQuestionType.CANCEL:
            if not q_reason_type:
                raise ValidationError("취소 요청에 주문 취소 사유가 없습니다.")
            if q_reason_type == RefundQuestionCancelReasonType.ETC and not q_reason_text:
                raise ValidationError("취소 사유(기타) 값이 없습니다.")
            cleaned_input["status"] = RefundStatusType.REFUND_SUCCESS
        elif q_type == RefundQuestionType.ETC:
            if not q_reason_text:
                raise ValidationError("기타 문의 내용이 없습니다.")
        elif q_type in [RefundQuestionType.REFUND, RefundQuestionType.EXCHANGE]:
            if not q_reason_type:
                raise ValidationError("교환/환불 요청에 교환/환불 사유가 없습니다.")
            if len(q_order_line_info) == 0:
                raise ValidationError("교환/환불 상품 정보가 없습니다.")

            last_payment = order.get_last_payment()
            is_vbank_pay = last_payment.is_vbank_pay()
            q_refund_account_info = cleaned_input.get("q_refund_account_info")
            if (
                is_vbank_pay
                and not q_refund_account_info
                and q_type == RefundQuestionType.REFUND
                and is_fbv == False
            ):
                raise ValidationError("환불 요청에 계좌 정보가 없습니다.")
            if q_reason_type == RefundQuestionCancelReasonType.ETC and not q_reason_text:
                raise ValidationError("교환/환불 사유(기타) 값이 없습니다.")

            if order.order_refund_questions.exclude(status=RefundStatusType.QUESTION_CLOSE):
                raise ValidationError("이미 진행 중인 교환/환불/기타문의 건이 존재합니다.")

            RefundOrderLineInput.validate_refund_orderline(cleaned_input)

        return cleaned_input

    @classmethod
    def get_type_for_model(cls):
        return RefundQA

    @classmethod
    @transaction.atomic()
    def save(cls, info, instance: RefundQAModel, cleaned_input):
        try:
            super().save(info, instance, cleaned_input)
        except IntegrityError as e:
            if BbsConstraintNamesPyEnum.UNIQUE_REFUND_PER_ORDER_WHEN_NOT_CLOSED.value in str(e):
                raise ValidationError("이미 해당 주문에 대해 처리되지 않은 환불 요청이 존재합니다.")
            else:
                raise ValidationError("환불 요청 처리 중 오류가 발생했습니다.")
        except Exception as e:
            raise

    @classmethod
    def post_save_action(cls, info, instance: RefundQAModel, cleaned_input):
        image_files = cleaned_input.get("image_files")
        if image_files is None:
            return
        instance.image_files = image_files
        for image_file in instance.image_files:
            instance.reason_images.create(image=image_file, refund_qa=instance)

        q_type = instance.q_type
        order: OrderModel = instance.order
        if q_type in [
            RefundQuestionType.EXCHANGE,
            RefundQuestionType.REFUND,
            RefundQuestionType.ETC,
        ]:
            # 기타문의는 cs 담당자에게,  통합공급망 교환/환불은 협력사에게 알림 발송
            if instance.is_fbv and q_type in [
                RefundQuestionType.EXCHANGE,
                RefundQuestionType.REFUND,
            ]:
                vendor = instance.vendor
                receiver_phone, _, _, _ = get_main_order_manager_info(vendor)
            else:
                receiver_phone = get_cs_manager_phone()
            if receiver_phone:
                transaction.on_commit(
                    lambda: send_kakaotalk_to_customer_on_refund_exchange_qa(
                        order=order,
                        q_type=RefundQuestionType[q_type].label,
                        receiver_phone=receiver_phone,
                        q_created_at=instance.q_created_at,
                    )
                )
            else:
                if instance.is_fbv:
                    raise_msg = "직거래 상품 주문 건의 교환/반품 처리 담당자 정보 오류입니다. 고객센터로 문의해 주세요."
                else:
                    raise_msg = "교환/반품 처리 담당자 정보 오류입니다. 고객센터로 문의해 주세요."
                raise ValidationError(raise_msg)

        models.RefundQAHistory.objects.create(
            refund_qa=instance, user=info.context.user, status=instance.status
        )

    @classmethod
    def success_response(cls, instance):
        response = super().success_response(instance)
        response.order = instance.order
        return response


