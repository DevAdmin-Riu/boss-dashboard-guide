@app.task
def send_email_in_case_no_track_inventory_with_etc_delivery(
    infos,
    order_id,
    user_id,
    brand_name,
):
    mail_title_for_log = "기타배송비를 갖는 위탁 주문 알림 메일 발송"
    recipient_list = get_consignment_purchase_manager_email_list()
