import logging

from templated_email import send_templated_mail

from ...plugins.email.define import EMAIL_PLUGIN_ID
from ...plugins.email.utils import get_recipient_list_consider_test_mode
from ...plugins.manager import get_plugins_manager

logger = logging.getLogger(__name__)


def send_templated_mail_consider_test_mode(
    mail_title_for_log: str,
    template_name: str,
    recipient_list: list,
    context: dict,
    attachments=None,
    **send_kwargs
):
    try:
        email_plugin_configs = get_plugins_manager().get_plugin_config_dot_map(EMAIL_PLUGIN_ID)
        recipient_list_consider_test_mode = get_recipient_list_consider_test_mode(
            recipient_list, email_plugin_configs
        )
        is_prod_mode = email_plugin_configs.is_prod_mode
        if "cc" in send_kwargs:
            origin_cc_list = send_kwargs["cc"]
            cc_list_consider_test_mode = get_recipient_list_consider_test_mode(
                origin_cc_list, email_plugin_configs
            )
            if not is_prod_mode:
                logger.info(f"cc_list: {origin_cc_list} -> {cc_list_consider_test_mode}")
            else:
                logger.info(f"cc_list: {cc_list_consider_test_mode}")
            send_kwargs["cc"] = cc_list_consider_test_mode
        if "bcc" in send_kwargs:
            origin_bcc_list = send_kwargs["bcc"]
            bcc_list_consider_test_mode = get_recipient_list_consider_test_mode(
                origin_bcc_list, email_plugin_configs
            )
            if not is_prod_mode:
                logger.info(f"bcc_list: {origin_bcc_list} -> {bcc_list_consider_test_mode}")
            else:
                logger.info(f"bcc_list: {bcc_list_consider_test_mode}")
            send_kwargs["bcc"] = bcc_list_consider_test_mode

        if is_prod_mode:
            current_bcc = send_kwargs.get("bcc", [])
            if not isinstance(current_bcc, list):
                current_bcc = [current_bcc]
            send_kwargs["bcc"] = current_bcc + [email_plugin_configs.prod_additional_bcc_email]

        if not is_prod_mode:
            logger.info(f"recipient_list: {recipient_list} -> {recipient_list_consider_test_mode}")
        else:
            logger.info(f"recipient_list: {recipient_list_consider_test_mode}")
        logger.info(f"send_kwargs: {send_kwargs}")
        send_templated_mail(
            template_name=template_name,
            recipient_list=recipient_list_consider_test_mode,
            context=context,
            attachments=attachments,
            **send_kwargs,
        )
        return True
    except Exception as e:
        logger.error(f"{mail_title_for_log} 실패: {context} {e}")
    return False
