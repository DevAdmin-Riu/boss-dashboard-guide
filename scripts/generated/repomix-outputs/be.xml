def filter_req_boss_product_last_status_created_at(qs, status, value):
    last_status_created_at_qs = (
        models.RequestBossProductStatusHistory.objects.filter(
            request=OuterRef("pk"), after_status=status
        )
        .order_by("-pk")
        .values("created_at")[:1]
    )
    qs = qs.annotate(last_status_created_at=Subquery(last_status_created_at_qs))
    return filter_range_field(qs, "last_status_created_at__date", value)


