import graphene
from django.conf import settings
from django.core.exceptions import ObjectDoesNotExist, ValidationError
from django.db import transaction
from graphene.types.generic import GenericScalar

from ....core.permissions import OrderPermissions
from ....core.utils.regex import remove_all_non_numeric
from ....courier import models as courier_models
from ....courier.utils import check_courier_digit_allowed_values
from ....order import NON_B2B_ORDER_PREFIX, OrderDeliveryMethods, OrderEvents, models
from ....order.actions import decrease_stock_of_sub_pv, fulfillment_tracking_completed
from ....order.models import Fulfillment, FulfillmentLine
from ....order.models import Order as OrderModel
from ....order.models import OrderLine as OrderLineModel
from ....order.utils import make_formated_tracking_number_for_order_event
from ....product.models import ProductVariant
from ....site.models import BoxSpecForPickingOrder
from ....warehouse.models import Stock
from ...core.mutations import BaseBulkMutation, BaseMutation
from ...core.types.common import OrderError
from ..enums import OrderDeliveryMethodsEnum
from ..mutations.fulfillments import (
    EtcDeliveryManInfoInput,
    OrderFulfill,
    clean_fulfillment_tracking_completed,
)
from ..types import OrderLine

if TYPE_CHECKING:
    from ....account.models import Brand, User
    from ....courier.models import Courier


class FulfillmentLineBulkInspectDetail(graphene.InputObjectType):
    id = graphene.ID(required=True, description="FulfillmentLine ID")
    inspect_qty = graphene.Int(required=True, description="검수 수량")


class FulfillmentLineBulkInspectInput(graphene.InputObjectType):
    details = graphene.List(
        FulfillmentLineBulkInspectDetail,
        required=True,
        description="검수 수량 리스트",
    )


class FulfillmentLineBulkInspect(BaseMutation):
    class Arguments:
        input = FulfillmentLineBulkInspectInput(
            required=True,
            description="출고건 검수 - 일괄 검수 수량 업데이트",
        )

    class Meta:
        description = "시스템에서 출고 처리까지 완료 후 물류센터에서 출고 제품 및 수량 검수 시 사용 - 일괄 검수 수량 업데이트"
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_fulfillment_line(cls, details):
        errors = []
        for detail in details:
            try:
                _, fulfillment_line_pk = graphene.Node.from_global_id(detail.get("id"))
                fulfillment_line = models.FulfillmentLine.objects.select_related("order_line").get(
                    pk=fulfillment_line_pk
                )
                detail["fulfillment_line"] = fulfillment_line
            except ObjectDoesNotExist:
                errors.append(detail.get("id"))

        if errors:
            raise ValidationError(
                f"검수 데이터 중 존재하지 않는 출고건 ID가 있습니다: {', '.join(errors)}"
            )

    @classmethod
    def validate_inspect_qty(cls, details):
        minus_inspect_qty_errors = []
        over_inspect_qty_errors = []

        for detail in details:
            fulfillment_line: "FulfillmentLine" = detail.get("fulfillment_line")
            product_sku = fulfillment_line.order_line.product_sku

            inspect_qty = detail.get("inspect_qty")
            if inspect_qty < 0:
                minus_inspect_qty_errors.append(product_sku)

            fulfill_qty = fulfillment_line.quantity
            inspected_qty = fulfillment_line.inspected_qty
            if inspect_qty + inspected_qty > fulfill_qty:
                over_inspect_qty_errors.append(product_sku)

        if minus_inspect_qty_errors:
            raise ValidationError(
                f"검수 데이터 중 검수 수량이 음수인 데이터가 있습니다: {', '.join(minus_inspect_qty_errors)}"
            )
        if over_inspect_qty_errors:
            raise ValidationError(
                f"검수 데이터 중 누적 검수 수량이 출고 수량보다 큰 데이터가 있습니다: {', '.join(over_inspect_qty_errors)}"
            )

    @classmethod
    def clean_details(cls, input_data):
        details = input_data.get("details")
        cls.validate_fulfillment_line(details)
