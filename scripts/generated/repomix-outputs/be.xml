from typing import List

import graphene
from django.core.exceptions import ObjectDoesNotExist, ValidationError
from django.db import transaction

from saleor.account.models import Brand as BrandModel
from saleor.graphql.account.types import Brand

from ...pre_founder.models import PreFounder as PreFounderModel
from ...pre_founder.models import PreFounderEvalAnswer as PreFounderEvalAnswerModel
from ...pre_founder.models import PreFounderEvalItem as PreFounderEvalItemModel
from ..core.mutations import BaseMutation
from ..core.types.common import PreFounderError
from .types import PreFounder
from .utils import update_all_pre_founder_eval_info_for_brand, update_pre_founder_eval_info


class PreFounderEvalItemUpsertInput(graphene.InputObjectType):
    id = graphene.ID(required=False, description="평가 항목 ID (전달하지 않으면 생성)")
    name = graphene.String(required=True, description="평가 항목 이름")
    description = graphene.String(required=True, description="평가 항목 설명(평가 가이드라인)")
    weight = graphene.Int(required=True, description="평가 항목 가중치")


class PreFounderEvalItemBulkUpsertOrDelete(BaseMutation):
    brand = graphene.Field(Brand)

    class Arguments:
        brand = graphene.ID(required=True, description="브랜드 ID")
        details = graphene.List(
            PreFounderEvalItemUpsertInput,
            required=True,
            description="예비창업자 평가 항목 일괄 생성/수정 정보(항상 일괄적으로 수정함. 기존에 있는 항목 중 details로 전달되지 않은 항목은 삭제 처리)",
        )

    class Meta:
        description = "예비창업자 평가 항목을 일괄 생성/수정/삭제 한다."
        error_type_class = PreFounderError
        error_type_field = "pre_founder_errors"

    @classmethod
    def validate_brand(cls, info, brand_id: int) -> BrandModel:
        user = info.context.user
        if not (user.is_hq_staff and user.brand_id and user.brand_id == int(brand_id)):
            raise ValidationError(
                "소속 브랜드의 가맹 본부 계정만 예비창업자 평가 항목을 수정할 수 있습니다."
            )
        try:
            brand = BrandModel.objects.prefetch_related("pre_founder_eval_items").get(id=brand_id)
        except ObjectDoesNotExist:
            raise ValidationError("브랜드가 존재하지 않습니다.")
        return brand

    @classmethod
    def validate_duplicate_names(cls, details: List[dict]):
        names = [detail.get("name") for detail in details]
        if len(names) != len(set(names)):
            raise ValidationError("중복된 평가 항목 이름이 존재합니다.")

    @classmethod
    def validate_weight_sum(cls, create_details: List[dict], update_details: List[dict]):
        total_weight = 0
        for detail in create_details + update_details:
            total_weight += detail.get("weight", 0)
        if total_weight != 100:
            raise ValidationError(
                f"평가 항목 가중치 합은 100이어야 합니다.(현재 합: {total_weight})"
            )

    @classmethod
    def clean_details(cls, info, input_data):
        """
        Prepare create/update/delete lists.
        - update_details: 전달된 id가 존재하는 details (브랜드에 해당하는 항목인지 검증 필요)
        - create_details: 전달된 id가 없는 details
        - delete_details: 브랜드에 존재하는 항목 중 전달된 id가 없는 항목
        """
        brand_global_id = input_data.get("brand")
        _type, brand_id = graphene.Node.from_global_id(brand_global_id)
        brand = cls.validate_brand(info, int(brand_id))

        details = input_data.get("details") or []
        cls.validate_duplicate_names(details)

        existing_qs = brand.pre_founder_eval_items.all()
        existing_map = {item.id: item for item in existing_qs}

        update_details: List[dict] = []
        create_details: List[dict] = []
        incoming_ids = set()
        incoming_names = set()

        for detail in details:
            item_global_id = detail.get("id")
            name = detail.get("name")
            description = detail.get("description")
            weight = detail.get("weight")

            if item_global_id:
                _type, item_id = graphene.Node.from_global_id(item_global_id)
                item_id = int(item_id)
                if item_id in existing_map:
                    incoming_ids.add(item_id)
                    update_details.append(
                        {
                            "id": item_id,
                            "name": name,
                            "description": description,
                            "weight": weight,
                        }
                    )
                else:
                    raise ValidationError(
                        f"주어진 id {item_global_id}는 해당 브랜드의 항목이 아닙니다."
                    )
            else:
                create_details.append(
                    {
                        "name": name,
                        "description": description,
                        "weight": weight,
                    }
                )
                incoming_names.add(name)

        delete_ids = [
            item.id
            for item in existing_map.values()
            if (item.id not in incoming_ids) and (item.name not in incoming_names)
        ]

        cls.validate_weight_sum(create_details, update_details)

        input_data["delete_details"] = delete_ids
        input_data["update_details"] = update_details
        input_data["create_details"] = create_details

        return brand, input_data

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        brand, cleaned_input_data = cls.clean_details(info, data)
        delete_details = cleaned_input_data.get("delete_details") or []
        update_details = cleaned_input_data.get("update_details") or []
        create_details = cleaned_input_data.get("create_details") or []
        need_update_pre_founder_eval_info = False

        if delete_details:
            need_update_pre_founder_eval_info = True
            PreFounderEvalItemModel.objects.filter(id__in=delete_details).delete()

        if update_details:
            existing_items = list(brand.pre_founder_eval_items.all())
            update_ids = {detail.get("id") for detail in update_details}
            items_map = {item.id: item for item in existing_items if item.id in update_ids}

            to_update = []
            for detail in update_details:
                item = items_map.get(detail.get("id"))
                if not item:
                    continue

                if item.weight != detail.get("weight"):
                    need_update_pre_founder_eval_info = True

                item.name = detail.get("name")
                item.description = detail.get("description")
                item.weight = detail.get("weight")
                to_update.append(item)
            if to_update:
                PreFounderEvalItemModel.objects.bulk_update(
                    to_update, fields=["name", "description", "weight"]
                )

        if create_details:
            need_update_pre_founder_eval_info = True
            to_create = [
                PreFounderEvalItemModel(
                    brand=brand,
                    name=detail.get("name"),
                    description=detail.get("description"),
                    weight=detail.get("weight"),
                )
                for detail in create_details
            ]
            PreFounderEvalItemModel.objects.bulk_create(to_create)

        # 브랜드의 예비창업자 평가 정보 업데이트 필요 여부 설정
        # 1. 항목 삭제 또는 추가가 발생한 경우
        # 2. 기존 항목 중 비중 수정이 발생한 경우
        if need_update_pre_founder_eval_info:
            brand.need_update_pre_founder_eval_info = True
            BrandModel.objects.filter(pk=brand.pk).update(need_update_pre_founder_eval_info=True)

        return PreFounderEvalItemBulkUpsertOrDelete(brand=brand)


class PreFounderEvalAnswerUpsertInput(graphene.InputObjectType):
    item = graphene.ID(required=True, description="평가 항목 ID")
    score = graphene.Int(required=True, description="점수 (0~5)")
    reason = graphene.String(required=False, description="점수 산정 근거")


class PreFounderEvalAnswerBulkUpsert(BaseMutation):
    pre_founder = graphene.Field(PreFounder)

    class Arguments:
        pre_founder = graphene.ID(required=True, description="예비창업자 ID")
        details = graphene.List(
            PreFounderEvalAnswerUpsertInput,
            required=True,
            description="예비창업자 평가 답변 일괄 생성/수정 정보",
        )

    class Meta:
        description = "예비창업자 평가 답변을 일괄 생성/수정 한다."
        error_type_class = PreFounderError
        error_type_field = "pre_founder_errors"

    @classmethod
    def validate_pre_founder(cls, info, pre_founder_id: int) -> PreFounderModel:
        user = info.context.user
        try:
            pre_founder = PreFounderModel.objects.prefetch_related("eval_answers").get(
                id=pre_founder_id
            )
        except ObjectDoesNotExist:
            raise ValidationError("예비창업자가 존재하지 않습니다.")

        if not (user.is_staff or (user.is_hq_staff and user.brand_id == pre_founder.brand_id)):
            raise ValidationError("가맹 본부 계정만 예비창업자 평가 답변을 수정할 수 있습니다.")

        return pre_founder

    @classmethod
    def clean_details(cls, info, input_data):
        pre_founder_global_id = input_data.get("pre_founder")
        _type, pre_founder_id = graphene.Node.from_global_id(pre_founder_global_id)
        pre_founder = cls.validate_pre_founder(info, pre_founder_id)

        details = input_data.get("details") or []
        existing_answers_map = {a.item_id: a for a in pre_founder.eval_answers.all()}

        create_details = []
        update_details = []

        for detail in details:
            _t, item_id = graphene.Node.from_global_id(detail.get("item"))
            item_id = int(item_id)
            existing = existing_answers_map.get(item_id)
            if existing:
                update_details.append((existing, detail))
            else:
                create_details.append((item_id, detail))

        input_data["create_details"] = create_details
        input_data["update_details"] = update_details

        return pre_founder, input_data

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        pre_founder, cleaned_input_data = cls.clean_details(info, data)
        create_details = cleaned_input_data.get("create_details") or []
        update_details = cleaned_input_data.get("update_details") or []

        if update_details:
            to_update = []
            for existing_answer, detail in update_details:
                existing_answer.score = detail.get("score")
                existing_answer.reason = detail.get("reason")
                to_update.append(existing_answer)
            if to_update:
                PreFounderEvalAnswerModel.objects.bulk_update(to_update, fields=["score", "reason"])

        if create_details:
            to_create = [
                PreFounderEvalAnswerModel(
                    pre_founder=pre_founder,
                    item_id=item_id,
                    score=detail.get("score"),
                    reason=detail.get("reason"),
                )
                for item_id, detail in create_details
            ]
            PreFounderEvalAnswerModel.objects.bulk_create(to_create)

        if create_details or update_details:
            update_pre_founder_eval_info(pre_founder)

        return PreFounderEvalAnswerBulkUpsert(pre_founder=pre_founder)


class PreFounderEvalInfoSync(BaseMutation):
    brand = graphene.Field(Brand)

    class Arguments:
        brand = graphene.ID(required=True, description="브랜드 ID")

    class Meta:
        description = "브랜드의 모든 예비창업자 평가 정보를 최신 상태로 동기화한다."
        error_type_class = PreFounderError
        error_type_field = "pre_founder_errors"

    @classmethod
    def validate_brand(cls, info, brand_id: int) -> BrandModel:
        user = info.context.user
        if not (user.is_hq_staff and user.brand_id and user.brand_id == int(brand_id)):
            raise ValidationError(
                "소속 브랜드의 가맹 본부 계정만 예비창업자 평가 정보를 동기화할 수 있습니다."
            )
        try:
            brand = BrandModel.objects.get(id=brand_id)
        except ObjectDoesNotExist:
            raise ValidationError("브랜드가 존재하지 않습니다.")
        return brand

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        brand_global_id = data.get("brand")
        _type, brand_id = graphene.Node.from_global_id(brand_global_id)
        brand_id = int(brand_id)
        brand = cls.validate_brand(info, brand_id)

        update_all_pre_founder_eval_info_for_brand(brand_id)

        brand.need_update_pre_founder_eval_info = False
        BrandModel.objects.filter(pk=brand.pk).update(need_update_pre_founder_eval_info=False)

        return PreFounderEvalInfoSync(brand=brand)
