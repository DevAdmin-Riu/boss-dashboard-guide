    PARTIALLY_DELIVERY_CONFIRMED = "PARTIALLY_DELIVERY_CONFIRMED", "부분 배송확정"
    DELIVERY_CONFIRMED = "DELIVERY_CONFIRMED", "배송확정"
    # 재고발주서는 거래명세서출력시 검수대기/검수완료로 분기,  위탁/b2b발주서는 기존대로 거래명세서 출력 상태로 이동
    INVOICE_PRINTED = "INVOICE_PRINTED", "거래명세서출력"
