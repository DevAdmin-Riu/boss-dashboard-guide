)
from . import FranchiseDocumentType

if TYPE_CHECKING:
    from .models import FranchiseDocument


def upload_to_for_franchise_document(instance: "FranchiseDocument", filename):
    type = instance.type
    if type == FranchiseDocumentType.FRANCHISE_DISCLOSURE:
        return upload_to_for_franchise_disclosure_document_file(instance, filename)
    elif type == FranchiseDocumentType.NEARBY_BRAND_STORES_INFO:
        return upload_to_for_nearby_brand_stores_info_file(instance, filename)
    elif type == FranchiseDocumentType.FRANCHISE_AGREEMENT:
        return upload_to_for_franchise_agreement_file(instance, filename)
    elif type == FranchiseDocumentType.PROJECTED_SALES_STATEMENT:
        return upload_to_for_projected_sales_statement_file(instance, filename)
    elif type == FranchiseDocumentType.FRANCHISE_DEPOSIT:
        return upload_to_for_franchise_deposit_file(instance, filename)
    elif type == FranchiseDocumentType.FRANCHISE_CONSULTATION:
        return upload_to_for_franchise_consultation_file(instance, filename)
    elif type == FranchiseDocumentType.FRANCHISE_AGREEMENT_ETC:
        return upload_to_for_franchise_agreement_etc_file(instance, filename)
    elif type == FranchiseDocumentType.OPENING_CONFIRMATION:
        return upload_to_for_opening_confirmation_file(instance, filename)
    else:
        new_file_name = make_unique_filename(filename)
        return os.path.join("franchise-document", new_file_name)
