def deallocate_virtual_allocate(
    inner_stock: "Stock",
    outer_stock: "Stock",
    outer_quantity: int,
):
    if inner_stock is None:
        raise ValidationError("소분 정보 오류: 이너 제품 재고 정보가 없습니다.")

    if outer_stock is None:
        raise ValidationError("소분 정보 오류: 아우터 제품 재고 정보가 없습니다.")

    outer_variant = outer_stock.product_variant
    inner_variant = inner_stock.product_variant
    pack_count = calc_pack_count(inner_variant, outer_variant)

    if pack_count <= 0:
        raise ValidationError(
            f"{outer_variant.sku}, {inner_variant.sku} 제품의 입수량 정보 오류로 인해 소분 처리할 수 없습니다."
        )

    order_line_qs = (
        OrderLine.objects.filter(variant=inner_variant)
        .filter(allocations__quantity_virtual_allocated__gt=0)
        .prefetch_related("variant", "allocations")
    )

    order_lines: List[OrderLine] = list(order_line_qs)
    remain_outer_quantity = outer_quantity
    update_allocations: List[Allocation] = []
    for order_line in order_lines:
        outer_allocation: Allocation = order_line.allocations.filter(stock=outer_stock).first()
        if outer_allocation is None:
            raise ValidationError("outer allocation이 존재하지 않습니다.")
        inner_allocation: Allocation = order_line.allocations.filter(stock=inner_stock).first()
        if inner_allocation is None:
            raise ValidationError("inner allocation이 존재하지 않습니다.")

        outer_virtual_deallocate_qty = min(
            remain_outer_quantity, outer_allocation.quantity_virtual_allocated
        )
        outer_allocation.quantity_virtual_allocated = (
            outer_allocation.quantity_virtual_allocated - outer_virtual_deallocate_qty
        )

        inner_virtual_deallocate_qty = min(
            outer_virtual_deallocate_qty * pack_count, inner_allocation.quantity_virtual_allocated
        )
        inner_allocation.quantity_virtual_allocated = (
            inner_allocation.quantity_virtual_allocated - inner_virtual_deallocate_qty
        )
        inner_allocation.quantity_allocated = (
            inner_allocation.quantity_allocated + inner_virtual_deallocate_qty
        )

        update_allocations.append(inner_allocation)
        update_allocations.append(outer_allocation)

        remain_outer_quantity = remain_outer_quantity - outer_virtual_deallocate_qty
        if remain_outer_quantity <= 0:
            break

    Allocation.objects.bulk_update(
        update_allocations, ["quantity_allocated", "quantity_virtual_allocated"]
    )


def divide_stock_detail(
    inner_stock: "Stock",
    outer_stock: "Stock",
    outer_quantity: int,
    reason: str,
    requestor: "User",
    from_stock_detail: "StockDetail",
    from_rack_location: "RackLocation",
    to_rack_location: "RackLocation",
):
    if inner_stock is None:
        raise ValidationError("소분 정보 오류: 이너 제품 재고 정보가 없습니다.")

    if outer_stock is None:
        raise ValidationError("소분 정보 오류: 아우터 제품 재고 정보가 없습니다.")

    outer_variant = outer_stock.product_variant
    inner_variant = inner_stock.product_variant
    pack_count = calc_pack_count(inner_variant, outer_variant)

    if pack_count <= 0:
        raise ValidationError(
            f"{outer_variant.sku}, {inner_variant.sku} 제품의 입수량 정보 오류로 인해 소분 처리할 수 없습니다."
        )

    quantity_allocated = outer_stock.allocations.get_quantity_allocated()
    if outer_stock.quantity - quantity_allocated < outer_quantity:
        raise ValidationError("남아 있는 가용 재고량 보다 많이 소분 처리할 수 없습니다.")

    from_rack_stock_detail: RackStockDetail = RackStockDetail.objects.filter(
        location=from_rack_location, stock_detail=from_stock_detail
    ).first()

    if from_rack_stock_detail is None:
        raise ValidationError("소분 대상 아우터 제품의 로케이션-재고번호 관계가 존재하지 않습니다.")

    if from_rack_stock_detail.remain_quantity < outer_quantity:
        raise ValidationError(
            "소분할 아우터 제품의 로케이션 재고 수량 보다 많이 소분 처리할 수 없습니다."
        )

    outer_stock.decrease_stock(outer_quantity)
    from_stock_detail.decrease_remain_stock(outer_quantity)
    from_rack_stock_detail.decrease_remain_stock(outer_quantity)

    inner_cost_price_exclude_vat = calc_inner_cost_by_outer_cost(
        from_stock_detail.cost_price_exclude_vat, pack_count
    )

    vendor = from_stock_detail.vendor
    inner_quantity = outer_quantity * pack_count
    inner_stock.increase_stock(inner_quantity)
    inner_stock_detail = StockDetail.objects.create(
        stock=inner_stock,
        remain_quantity=inner_quantity,
        cost_price_exclude_vat=inner_cost_price_exclude_vat,
        vendor=vendor,
        vendor_name=vendor.name if vendor else "",
        purchase_order_line=None,
        stocked_at=from_stock_detail.stocked_at,
        exp_date=from_stock_detail.exp_date,
        exp_date_status=from_stock_detail.exp_date_status,
    )
    add_to_rack_stock_detail(
        location=to_rack_location,
        stock_detail=inner_stock_detail,
        quantity=inner_quantity,
        product_variant=inner_stock.product_variant,
        source_rsd=from_rack_stock_detail,
    )

    create_divide_stock_detail_event(
        inner_stock=inner_stock,
        outer_stock=outer_stock,
        inner_stock_detail=inner_stock_detail,
        user=requestor,
        outer_quantity=outer_quantity,
        reason=reason,
        from_location=from_rack_location.name,
        to_location=to_rack_location.name,
    )


def combine_stock_detail(
    inner_stock: "Stock",
    outer_stock: "Stock",
    outer_quantity: int,
    reason: str,
    requestor: "User",
    from_stock_detail: "StockDetail",
    from_rack_location: "RackLocation",
    to_rack_location: "RackLocation",
):
    outer_variant = outer_stock.product_variant
    inner_variant = inner_stock.product_variant
    pack_count = calc_pack_count(inner_variant, outer_variant)

    if pack_count <= 0:
        raise ValidationError(
            f"{outer_variant.sku}, {inner_variant.sku} 제품의 입수량 정보 오류로 인해 결합 처리할 수 없습니다."
        )

    inner_quantity = outer_quantity * pack_count
    quantity_allocated = inner_stock.allocations.get_quantity_allocated()
    if inner_stock.quantity - quantity_allocated < inner_quantity:
        raise ValidationError("남아 있는 가용 재고량 보다 많이 결합 처리할 수 없습니다.")

    from_rack_stock_detail: RackStockDetail = RackStockDetail.objects.filter(
        location=from_rack_location, stock_detail=from_stock_detail
    ).first()

    if from_rack_stock_detail is None:
        raise ValidationError("결합 대상 이너 제품의 로케이션-재고번호 관계가 존재하지 않습니다.")

    if from_rack_stock_detail.remain_quantity < inner_quantity:
        raise ValidationError(
            "결합할 이너 제품의 로케이션 재고 수량 보다 많이 결합 처리할 수 없습니다."
        )

    inner_stock.decrease_stock(inner_quantity)
    from_stock_detail.decrease_remain_stock(inner_quantity)
    from_rack_stock_detail.decrease_remain_stock(inner_quantity)

    outer_cost_price_exclude_vat = calc_outer_cost_by_inner_cost(
        from_stock_detail.cost_price_exclude_vat, pack_count
    )

    vendor = from_stock_detail.vendor
    outer_stock.increase_stock(outer_quantity)
    outer_stock_detail = StockDetail.objects.create(
        stock=outer_stock,
        remain_quantity=outer_quantity,
        cost_price_exclude_vat=outer_cost_price_exclude_vat,
        vendor=vendor,
        vendor_name=vendor.name if vendor else "",
        purchase_order_line=None,
        stocked_at=from_stock_detail.stocked_at,
        exp_date=from_stock_detail.exp_date,
        exp_date_status=from_stock_detail.exp_date_status,
    )
    add_to_rack_stock_detail(
        location=to_rack_location,
        stock_detail=outer_stock_detail,
        quantity=outer_quantity,
        product_variant=outer_stock.product_variant,
        source_rsd=from_rack_stock_detail,
    )

    create_combine_stock_detail_event(
        inner_stock=inner_stock,
        outer_stock=outer_stock,
        outer_stock_detail=outer_stock_detail,
        user=requestor,
        inner_quantity=inner_quantity,
        reason=reason,
        from_location=from_rack_location.name,
        to_location=to_rack_location.name,
    )


@transaction.atomic
def allocate_inner_variant_stock(order_line: "OrderLine", country_code: str):
    quantity = order_line.quantity
    inner_variant: ProductVariant = order_line.variant
    outer_variant: ProductVariant = inner_variant.outer

    # 창고 여러개 운영 시 합포장 시스템은 전체적으로 재점검 필요함
    inner_stock: Stock = (
        Stock.objects.select_for_update(of=("self",))
        .get_variant_stocks_for_country(country_code, inner_variant)
        .order_by("pk")
        .first()
    )
    if inner_stock is None:
        raise InsufficientStock(inner_variant)

    quantity_available_in_inner_stock = get_available_quantity(inner_variant, country_code)
    quantity_available_incl_to_be_stocked_in_outer_stock = get_available_quantity(
        outer_variant, country_code
    ) + get_qty_to_be_stocked_by_variant(outer_variant, until_short_term=True)

    if quantity <= quantity_available_in_inner_stock:
        order_line.outer_virtual_allocate = 0
        order_line.inner_allocate = quantity
        order_line.inner_virtual_allocate = 0
    else:
        order_line.outer_virtual_allocate = ceil(
            (quantity - quantity_available_in_inner_stock) / order_line.inner_pack_count
        )
        if order_line.outer_virtual_allocate > quantity_available_incl_to_be_stocked_in_outer_stock:
            raise InsufficientStock(inner_variant)
        order_line.inner_allocate = quantity_available_in_inner_stock
        order_line.inner_virtual_allocate = quantity - quantity_available_in_inner_stock
    order_line.save(
        update_fields=["inner_allocate", "inner_virtual_allocate", "outer_virtual_allocate"]
    )

    Allocation.objects.create(
        order_line=order_line,
        stock=inner_stock,
        quantity_allocated=order_line.inner_allocate,
        quantity_virtual_allocated=order_line.inner_virtual_allocate,
    )

    if order_line.outer_virtual_allocate > 0:
        outer_stock: Stock = (
            Stock.objects.select_for_update(of=("self",))
            .get_variant_stocks_for_country(country_code, outer_variant)
            .order_by("pk")
            .first()
        )
        if outer_stock is None:
            raise InsufficientStock(inner_variant)

        Allocation.objects.create(
            order_line=order_line,
            stock=outer_stock,
            quantity_allocated=0,
            quantity_virtual_allocated=order_line.outer_virtual_allocate,
        )


@transaction.atomic
def allocate_stock(
    order_line: "OrderLine",
    country_code: str,
    quantity: Decimal,
):
    """Allocate stocks for given `order_line` in given country.

    Function lock for update all stocks and allocations for variant in
    given country and order by pk. Next, generate the dictionary
    ({"stock_pk": "quantity_allocated"}) with actual allocated quantity for stocks.
    Iterate by stocks and allocate as many items as needed or available in stock
    for order line, until allocated all required quantity for the order line.
    If there is less quantity in stocks then rise InsufficientStock exception.
    """

    # 창고 여러개 운영 시 전체적으로 재점검 필요함(예전 코드 참고 필요)
    stock: Stock = (
        Stock.objects.select_for_update(of=("self",))
        .get_variant_stocks_for_country(country_code, order_line.variant)
        .order_by("pk")
        .first()
    )

    Allocation.objects.create(
        order_line=order_line,
        stock=stock,
        quantity_allocated=quantity,
    )


@transaction.atomic
def deallocate_stock(order_line: "OrderLine", quantity: int, stock: Stock):
    """Deallocate stocks for given `order_line`.

    Function lock for update stocks and allocations related to given `order_line`.
    Iterate over allocations sorted by `stock.pk` and deallocate as many items
    as needed of available in stock for order line, until deallocated all required
    quantity for the order line. If there is less quantity in stocks then
    raise an exception.
    """

    # 출고 모드에서 deallocate 할 때는 출고하려고하는 stock 에서만 deallocate 해야 함.
    if stock:
        allocations = (
            order_line.allocations.select_related("stock")
            .select_for_update(
                of=(
                    "self",
                    "stock",
                )
            )
            .filter(stock=stock)
        )
    else:
        allocations = (
            order_line.allocations.select_related("stock")
            .select_for_update(
                of=(
                    "self",
                    "stock",
                )
            )
            .order_by("stock__pk")
        )
    quantity_deallocated = 0

    for allocation in allocations:
        quantity_to_deallocate = min(
            (quantity - quantity_deallocated), allocation.quantity_allocated
        )

        if quantity_to_deallocate > 0:
            allocation.quantity_allocated = F("quantity_allocated") - quantity_to_deallocate
            quantity_deallocated += quantity_to_deallocate

            if quantity_deallocated == quantity:
                Allocation.objects.bulk_update(allocations, ["quantity_allocated"])
                break

    if not quantity_deallocated == quantity:
        raise AllocationError(order_line, quantity)


def _increase_stock_detail_on_cancel_fulfillment(
    fulfillment_line: "FulfillmentLine",
    stock: "Stock",
    rack_location: "RackLocation",
):
    stock = fulfillment_line.stock
    quantity = fulfillment_line.quantity

    # 기존 출고 코드에 있는 stock 증가 처리에서 이미 증가 처리 되었음
    # stock.increase_stock(quantity)

    stock_detail_lines = StockDetailLine.objects.filter(fulfillment_line=fulfillment_line)

    for line in stock_detail_lines:
        stock_detail: StockDetail = line.stock_detail

        if stock_detail:
            stock_detail.increase_remain_stock(quantity)
        else:
            # remain_quantity 가 0 이 되어 stock_detail 이 지워진 경우에는 StockDetail.create 로 신규 레코드 생성으로 재입고 처리
            quantity = line.quantity
            cost_price_exclude_vat = line.cost_price_exclude_vat
            vendor = line.vendor
            vendor_name = line.vendor_name
            stocked_at = line.stocked_at
            stock_detail = StockDetail.objects.create(
                stock=stock,
                remain_quantity=quantity,
                cost_price_exclude_vat=cost_price_exclude_vat,
                vendor=vendor,
                vendor_name=vendor_name,
                stocked_at=stocked_at,
                exp_date=line.exp_date,
                exp_date_status=get_exp_date_status(line.exp_date),
            )

        add_to_rack_stock_detail(
            location=rack_location,
            stock_detail=stock_detail,
            quantity=quantity,
            product_variant=stock.product_variant,
        )


@transaction.atomic
def increase_stock_using_stock_detail(
    requester: "User",
    order: "Order",
    fulfillment_line: "FulfillmentLine",
    order_line: "OrderLine",
    warehouse: Warehouse,
    quantity: int,
    allocate: bool,
    rack_location: "RackLocation",
):
    """Increse stock quantity for given `order_line` in a given warehouse.

    Function lock for update stock and allocations related to given `order_line`
    in a given warehouse. If the stock exists, increase the stock quantity
    by given value. If not exist create a stock with the given quantity. This function
    can create the allocation for increased quantity in stock by passing True
    to `allocate` argument. If the order line has the allocation in this stock
    function increase `quantity_allocated`. If allocation does not exist function
    create a new allocation for this order line in this stock.
    """
    stock: Stock = (
        Stock.objects.select_for_update(of=("self",))
        .filter(warehouse=warehouse, product_variant=order_line.variant)
        .first()
    )
    if stock:
        stock.increase_stock(quantity)
    else:
        stock = Stock.objects.create(
            warehouse=warehouse, product_variant=order_line.variant, quantity=quantity
        )

    if not stock.product_variant.product.is_fulfilled_by_vendor:
        _increase_stock_detail_on_cancel_fulfillment(
            fulfillment_line=fulfillment_line, stock=stock, rack_location=rack_location
        )

    reason = f"주문번호:{order.composed_id_with_prefix}"
    create_fulfillment_cancel_stock_detail_event(
        stock,
        user=requester,
        quantity=quantity,
        reason=reason,
        rack_location=rack_location,
    )

    if allocate:
        allocation = order_line.allocations.select_for_update().filter(stock=stock).first()
        if allocation:
            allocation.quantity_allocated = F("quantity_allocated") + quantity
            allocation.save(update_fields=["quantity_allocated"])
        else:
            Allocation.objects.create(
                order_line=order_line, stock=stock, quantity_allocated=quantity
            )


@transaction.atomic
def decrease_stock(order_line: "OrderLine", quantity: int, warehouse_pk: str):
    """Decrease stock quantity for given `order_line` in given warehouse.

    Function deallocate as many quantities as requested if order_line has less quantity
    from requested function deallocate whole quantity. Next function try to find the
    stock in a given warehouse, if stock not exists or have not enough stock,
    the function raise InsufficientStock exception. When the stock has enough quantity
    function decrease it by given value.

    stock 감소는 StockDetailSystem 이용하는 것으로 변경
       * 출고 취소 및 매입가 계산을 위해서 StockDetailLine 에 기록하면서 출고 처리
    """
    try:
        # 직거래상품 출고 처리 시 stock 감소 처리 때는 warehouse_pk 가 None 이므로
        if warehouse_pk is None:
            stock: Stock = (
                order_line.variant.stocks.select_for_update()  # type: ignore
                .prefetch_related("allocations")
                .first()
            )
        else:
            stock: Stock = (
                order_line.variant.stocks.select_for_update()  # type: ignore
                .prefetch_related("allocations")
                .get(warehouse__pk=warehouse_pk)
            )
    except Stock.DoesNotExist:
        error_context = {"order_line": order_line, "warehouse_pk": warehouse_pk}
        raise InsufficientStock(order_line.variant, error_context)

    try:
        deallocate_stock(order_line, quantity, stock)
    except AllocationError:
        order_line.allocations.update(quantity_allocated=0)

    if stock.quantity < quantity:
        error_context = {"order_line": order_line, "warehouse_pk": warehouse_pk}
        raise InsufficientStock(order_line.variant, error_context)

    stock.decrease_stock(quantity)


@transaction.atomic
def deallocate_stock_for_order(order: "Order"):
    """Remove all allocations for given order."""
    # 기타 배송 주문 재고 반영 안하는 order_line 에 대해서 allocation 된 게 없음
    # deallocate_stock_for_order 은 allocation 된 것을 모두 제거하는 로직이므로 별도의 처리는 불필요
    allocated_filter = Q(quantity_allocated__gt=0)
    virtual_allocated_filter = Q(quantity_virtual_allocated__gt=0)
    allocations = (
        Allocation.objects.filter(order_line__order=order)
        .filter(allocated_filter | virtual_allocated_filter)
        .select_for_update(of=("self",))
    )
    allocations.update(quantity_allocated=0, quantity_virtual_allocated=0)
