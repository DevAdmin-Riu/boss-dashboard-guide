import re

from django.db.models import QuerySet
from pygments import highlight
from pygments.formatters import TerminalFormatter
from pygments.lexers import PostgresLexer
from sqlparse import format


def print_sql(queryset: QuerySet):
    formatted = format(str(queryset.query), reindent=True)
    indent_size = 1
    indent_spaces = " " * indent_size
    formatted_with_custom_indent = re.sub(r" +", indent_spaces, formatted)
    print(highlight(formatted_with_custom_indent, PostgresLexer(), TerminalFormatter()))


def print_connection_queries(connection, log_tag: str = None, detail_sql_print: bool = True):
    queries = connection.queries
    query_count = len(queries) if queries else 0
    log_tag = f"{log_tag} SQL Queries Count" if log_tag else "SQL Queries Count"

    if detail_sql_print:
        for query in queries:
            formatted = format(query["sql"], reindent=True)
            indent_size = 1
            indent_spaces = " " * indent_size
            formatted_with_custom_indent = re.sub(r" +", indent_spaces, formatted)
            print(highlight(formatted_with_custom_indent, PostgresLexer(), TerminalFormatter()))
            print("Time: %s\n" % query["time"])

    print(f"===== {log_tag}: {query_count} =====")
