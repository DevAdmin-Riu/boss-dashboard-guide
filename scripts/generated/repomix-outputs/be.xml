from decimal import Decimal
from typing import List

from ...account.utils import format_as_hypenated_phone_number
from ...core.prices import calc_total_exclude_vat_by_unit_exclude_vat_and_qty
from ...core.utils.export_to_excel import (
    ExcelCellInfo,
    export_excel_cell_info_rows_to_workbook,
    make_excel_cell_info,
)
from ...core.utils.math import my_round
from ...order import OrderDeliveryMethods
from ...order.models import Order, OrderLine
from ...product.models import ProductVariant
from ...product.utils.attributes import (
    get_qty_in_box_by_attribue,
    make_product_spec_text_by_attribute,
)
from ...terminology import (
    term_of_is_tax_free,
    term_of_po_event_type,
    term_of_qty_per_box_unit_type,
    term_of_sales_unit_type,
)
from ..emails import to_locale_number
from ..models import PurchaseOrder, PurchaseOrderLine


def export_auto_consignment_po(
    po: PurchaseOrder, po_lines: List[PurchaseOrderLine], delivery_method: OrderDeliveryMethods
):
    num_index = 1
    rows: List[List[ExcelCellInfo]] = []
    for po_line in po_lines:
        variant: ProductVariant = po_line.variant
        order_line: OrderLine = po_line.order_line
        order: Order = order_line.order
        is_tax_free = po_line.is_tax_free
        quantity = po_line.quantity
        qty_in_box = get_qty_in_box_by_attribue(po_line.attribute_data)
        cost_price_exclude_vat = po_line.cost_price_exclude_vat
        unit_cost_price_exclude_vat = (
            my_round(cost_price_exclude_vat / Decimal(qty_in_box), 1)
            if cost_price_exclude_vat is not None and qty_in_box
            else None
        )
        dev_cost_exclude_vat = po_line.dev_cost_exclude_vat or 0
        etc_exclude_vat = po_line.etc_exclude_vat or 0
        total_cost_price_exclude_vat = (
            calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
                cost_price_exclude_vat, quantity, is_tax_free
            )
            if cost_price_exclude_vat is not None and quantity is not None
            else None
        )
        total_exclude_vat_by_line = (
            total_cost_price_exclude_vat + dev_cost_exclude_vat + etc_exclude_vat
            if total_cost_price_exclude_vat is not None
            else None
        )
        asking_purchase_date = po_line.asking_purchase_date
        vat_amount = po_line.vat_amount
        event_type_str = term_of_po_event_type(po.event_type, False)
        asking_purchase_date_str = (
            asking_purchase_date.strftime("%Y-%m-%d") if asking_purchase_date else "-"
        )
        external_sku = po_line.external_sku or "-"
        product_sku = po_line.product_sku or "-"
        product_name = po_line.product_name or "-"
        variant_name = po_line.variant_name or "-"
        product_spec = make_product_spec_text_by_attribute(po_line.attribute_data) or "-"
        qty_in_box_str = to_locale_number(qty_in_box) if qty_in_box else "-"
        is_tax_free_str = term_of_is_tax_free(is_tax_free) or "-"
        sales_unit_type_str = term_of_sales_unit_type(variant.sales_unit_type) or "-"
        unit_cost_price_exclude_vat_str = (
            to_locale_number(unit_cost_price_exclude_vat)
            if unit_cost_price_exclude_vat is not None
            else "-"
        )
        qty_per_box_unit_type_str = (
            term_of_qty_per_box_unit_type(variant.qty_per_box_unit_type) or "-"
        )
        cost_price_exclude_vat_str = (
            to_locale_number(cost_price_exclude_vat) if cost_price_exclude_vat is not None else "-"
        )
        total_exclude_vat_by_line_str = (
            to_locale_number(total_exclude_vat_by_line)
            if total_exclude_vat_by_line is not None
            else "-"
        )
        total_cost_price_exclude_vat_str = (
            to_locale_number(total_cost_price_exclude_vat)
            if total_cost_price_exclude_vat is not None
            else "-"
        )
        vat_amount_str = to_locale_number(vat_amount) if vat_amount is not None else "-"
        po_line_code = f"{po.code}-{str(po_line.sort_order).zfill(3)}"
        order_number = order.composed_id_with_prefix
        order_detail_number = order_line.composed_id_with_prefix
        order_address_first_name = order.shipping_address.first_name or "-"
        order_phone = (
            format_as_hypenated_phone_number(order.shipping_address.phone)
            if order.shipping_address.phone
            else "-"
        )
        order_address = (
            f"{order.shipping_address.street_address_1} {order.shipping_address.street_address_2}"
        )
        order_customer_note = order.customer_note or "-"

        line_note = po_line.note or "-"

        int_qty = int(quantity)
        for i in range(int_qty):
            extended_po_line_code = f"{po_line_code}-{str(num_index).zfill(3)}"
            row = list(
                filter(
                    None,
                    [
                        make_excel_cell_info(title="No.", value=num_index),
                        make_excel_cell_info(title="발주구분", value=event_type_str),
                        make_excel_cell_info(title="발주품목번호", value=extended_po_line_code),
                        make_excel_cell_info(title="주문번호", value=order_number),
                        make_excel_cell_info(title="주문상세번호", value=order_detail_number),
                        make_excel_cell_info(title="납품요청일", value=asking_purchase_date_str),
                        make_excel_cell_info(title="협력사 상품ID", value=external_sku),
                        make_excel_cell_info(title="리우 제품코드", value=product_sku),
                        make_excel_cell_info(title="제품명", value=product_name),
                        make_excel_cell_info(title="옵션명", value=variant_name),
                        make_excel_cell_info(title="규격", value=product_spec),
                        make_excel_cell_info(title="과세여부", value=is_tax_free_str),
                        make_excel_cell_info(title="입수량", value=qty_in_box_str),
                        make_excel_cell_info(title="발주수량", value=1),
                        make_excel_cell_info(title="발주단위", value=sales_unit_type_str),
                        make_excel_cell_info(
                            title="개당단가", value=unit_cost_price_exclude_vat_str
                        ),
                        make_excel_cell_info(title="입수량단위", value=qty_per_box_unit_type_str),
                        make_excel_cell_info(title="박스단가", value=cost_price_exclude_vat_str),
                        make_excel_cell_info(
                            title="제품총액", value=total_cost_price_exclude_vat_str
                        ),
                        make_excel_cell_info(title="공급가액", value=total_exclude_vat_by_line_str),
                        make_excel_cell_info(title="부가세", value=vat_amount_str),
                        make_excel_cell_info(title="제품 비고", value=line_note),
                        make_excel_cell_info(title="수취인명", value=order_address_first_name),
                        make_excel_cell_info(title="연락처", value=order_phone),
                        make_excel_cell_info(title="주소", value=order_address),
                        make_excel_cell_info(title="요청사항", value=order_customer_note),
                    ],
                )
            )
            rows.append(row)
            num_index += 1

    if len(rows) == 0:
        return None

    return export_excel_cell_info_rows_to_workbook(
        rows=rows, auto_adjusted_width=True, include_index=False, show_exclude_vat_legend=False
    )
