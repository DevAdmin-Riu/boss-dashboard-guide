        search_fields = (
            "login_id",
            "first_name",
            "aligo_phone",
        )
        if value:
            qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_is_mall_staff(qs, _, value):
        qs = qs.annotate(number_of_brands=Count("staff_brands"))
        if value == True:
            qs = qs.filter(number_of_brands__gt=0)
        elif value == False:
            qs = qs.filter(number_of_brands=0)
        return qs

    # 권한 연동 관리자 추가용 useStaffMemberSearch 에서 사용
    search = django_filters.CharFilter(method=filter_search)

    status = EnumFilter(input_class=StaffMemberStatus, method=filter_staff_status)
    is_mall_staff = django_filters.BooleanFilter(method=filter_is_mall_staff)
    ids = GlobalIDMultipleChoiceFilter(field_name="id")

    # TODO - Figure out after permision types
    # department = ObjectTypeFilter

    class Meta:
        model = User
        fields = []


class BrandGroupFilter(django_filters.FilterSet):
    def filter_name(qs, _, value):
        search_fields = ["name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_biz_corp_name(qs, _, value):
        search_fields = ["biz_corp_name"]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_biz_reg_no(qs, _, value):
        if value:
            normalized_value = remove_all_non_numeric(value)
            qs = qs.annotate(
                clean_biz_reg_no=RegexpReplace(
                    F("biz_reg_no"),
                    Value("[^0-9]"),  # 숫자가 아닌 모든 문자 제거
                    Value(""),
                )
            )
            return qs.filter(clean_biz_reg_no=normalized_value)
        return qs

    name = django_filters.CharFilter(method=filter_name)
    biz_corp_name = django_filters.CharFilter(method=filter_biz_corp_name)
    biz_reg_no = django_filters.CharFilter(method=filter_biz_reg_no)

    class Meta:
        model = BrandGroup
        fields = []


class BrandGroupFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = BrandGroupFilter
