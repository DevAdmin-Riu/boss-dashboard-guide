import logging
from decimal import Decimal
from typing import TYPE_CHECKING, List, Optional, Set, Union

from django.core.exceptions import ValidationError
from django.db.models import F

from ...order import OrderDeliveryMethods
from ...site.models import BoxSpecForPickingOrder
from .. import AttributeInputType, AttributeSlugEnum, BoxSizeType
from ..models import (
    AssignedProductAttribute,
    AssignedVariantAttribute,
    Attribute,
    AttributeProduct,
    AttributeValue,
    AttributeVariant,
    BaseAssignedAttribute,
    DirectlyAssignedProductAttribute,
    DirectlyAssignedVariantAttribute,
    Product,
    ProductVariant,
)

if TYPE_CHECKING:
    # flake8: noqa
    from ...account.models import Brand
    from ...payment.models import Checkout, Payment

logger = logging.getLogger(__name__)


def generate_name_for_variant(variant: ProductVariant) -> str:
    """
    # 옵션명 기본 값 정책 변경
       * 기존: 속성 값을 / 로 연결하여 생성
       * 변경: product_option slug 속성 값만 사용하여 생성
    """

    target_attribute: DirectlyAssignedVariantAttribute = variant.directly_attributes.filter(
        assignment__attribute__slug=AttributeSlugEnum.PRODUCT_OPTION.value
    ).first()
    return target_attribute.value if target_attribute else ""


def _associate_attribute_to_instance(
    instance: Union[Product, ProductVariant], attribute_pk: int
) -> Union[AssignedProductAttribute, AssignedVariantAttribute]:
    """Associate a given attribute to an instance."""
    assignment: Union[AssignedProductAttribute, AssignedVariantAttribute]
    if isinstance(instance, Product):
        attribute_rel: AttributeProduct = instance.product_type.attributeproduct.get(
            attribute_id=attribute_pk
        )
        assignment, _ = AssignedProductAttribute.objects.get_or_create(
            product=instance, assignment=attribute_rel
        )
    elif isinstance(instance, ProductVariant):
        attribute_rel: AttributeVariant = instance.product.product_type.attributevariant.get(
            attribute_id=attribute_pk
        )
        assignment, _ = AssignedVariantAttribute.objects.get_or_create(
            variant=instance, assignment=attribute_rel
        )
    else:
        raise AssertionError(f"{instance.__class__.__name__} is unsupported")

    return assignment


def _associate_directly_attribute_to_instance(
    instance: Union[Product, ProductVariant], attribute_pk: int
) -> Union[DirectlyAssignedProductAttribute, DirectlyAssignedVariantAttribute]:
    """Associate a given attribute to an instance."""
    assignment: Union[DirectlyAssignedProductAttribute, DirectlyAssignedVariantAttribute]
    if isinstance(instance, Product):
        attribute_rel: AttributeProduct = instance.product_type.attributeproduct.get(
            attribute_id=attribute_pk
        )
        assignment, _ = DirectlyAssignedProductAttribute.objects.get_or_create(
            product=instance, assignment=attribute_rel
        )
    elif isinstance(instance, ProductVariant):
        attribute_rel: AttributeVariant = instance.product.product_type.attributevariant.get(
            attribute_id=attribute_pk
        )
        assignment, _ = DirectlyAssignedVariantAttribute.objects.get_or_create(
            variant=instance, assignment=attribute_rel
        )
    else:
        raise AssertionError(f"{instance.__class__.__name__} is unsupported")

    return assignment


def validate_attribute_owns_values(attribute: Attribute, value_ids: Set[int]) -> None:
    """Check given value IDs are belonging to the given attribute.

    :raise: AssertionError
    """
    attribute_actual_value_ids = set(attribute.values.values_list("pk", flat=True))
    found_associated_ids = attribute_actual_value_ids & value_ids

    if found_associated_ids != value_ids:
        raise AssertionError("Some values are not from the provided attribute.")


def associate_attribute_values_to_instance(
    instance: Union[Product, ProductVariant],
    attribute: Attribute,
    *values: AttributeValue,
) -> Union[AssignedProductAttribute, AssignedVariantAttribute]:
    """Assign given attribute values to a product or variant.

    Note: be award this function invokes the ``set`` method on the instance's
    attribute association. Meaning any values already assigned or concurrently
    assigned will be overridden by this call.
    """
    values_ids = {value.pk for value in values}

    # Ensure the values are actually form the given attribute
    validate_attribute_owns_values(attribute, values_ids)

    # Associate the attribute and the passed values
    assignment = _associate_attribute_to_instance(instance, attribute.pk)
    assignment.values.set(values)

    return assignment


def associate_directly_attribute_values_to_instance(
    instance: Union[Product, ProductVariant],
    attribute: Attribute,
    values: List[str],
) -> Union[DirectlyAssignedProductAttribute, DirectlyAssignedVariantAttribute]:
    """Assign given attribute values to a product or variant.

    Note: 직접 입력 속성값을 저장하는 함수. values 를 인자로 받지만, 실제로는 values[0] 만 사용함
    """
    value = values[0]
    assignment = _associate_directly_attribute_to_instance(instance, attribute.pk)
    assignment.value = value
    assignment.save()

    return assignment


def _get_box_size_from_attribute(
    assigned_attribute_for_box_size: BaseAssignedAttribute, raise_if_error: bool
) -> str:
    box_size_type = BoxSizeType.BOX_SIZE_TYPE_EMPTY
    if (
        assigned_attribute_for_box_size
        and assigned_attribute_for_box_size.attribute.slug == AttributeSlugEnum.BOX_SIZE.value
    ):
        box_size_type = assigned_attribute_for_box_size.values.first().slug

    if raise_if_error and not box_size_type:
        raise Exception("재고 제품의 박스사이즈 속성 값이 설정되지 않았습니다.")

    return box_size_type


def get_box_size_from_box_spec_for_picking_order():
    box_spec_for_picking_order = BoxSpecForPickingOrder.objects.first()
    if box_spec_for_picking_order:
        return box_spec_for_picking_order.box_size_type
    raise Exception("합포장 박스 규격 정보가 설정되지 않았습니다.")


def get_box_size_from_variant(
    variant: ProductVariant,
) -> str:
    try:
        assigned_attributes_to_variant = variant.attributes.filter(
            assignment__attribute__slug=AttributeSlugEnum.BOX_SIZE.value
        ).first()
        box_size_type = _get_box_size_from_attribute(assigned_attributes_to_variant, False)
        if box_size_type:
            return box_size_type

        assigned_attributes_to_product = variant.product.attributes.filter(
            assignment__attribute__slug=AttributeSlugEnum.BOX_SIZE.value
        ).first()
        return _get_box_size_from_attribute(assigned_attributes_to_product, True)
    except Exception as e:
        return e


def get_box_size_from_variant_for_checkout_complete(
    variant: ProductVariant,
    brand: "Brand",
    checkout: "Checkout",
    payment: "Payment",
    order_line_track_inventory: bool,
) -> str:
    try:
        # 택배 배송이 아닌 경우 박스 사이즈는 의미 없음
        if checkout.delivery_method != OrderDeliveryMethods.BY_COURIER:
            return BoxSizeType.BOX_SIZE_TYPE_EMPTY
        if order_line_track_inventory == False or variant.product.is_direct_shipping:
            return BoxSizeType.BOX_SIZE_TYPE_EMPTY
        return get_box_size_from_variant(variant)
    except Exception as e:
        from ...account.utils import format_as_numeric_only_phone_number
        from ...core.utils.str_utils import to_locale_number
        from ...order.emails import send_payment_fail_email
        from ...payment.gateways.utils import make_combine_pay_method_text

        error_msg = (
            "박스사이즈 속성 값이 설정되지 않은 재고 제품이 있어서 주문을 생성하지 못했습니다."
        )

        # target_md_email을 None 으로 보내면 site 설정의 md group email로 보내짐
        target_md_email = brand.staff.email if brand and brand.staff and brand.staff.email else None

        user = checkout.user
        amount = payment.total if payment else Decimal(0)
        context = {
            "payment_id": payment.id if payment else "-",
            "payment_method": make_combine_pay_method_text(payment) if payment else "-",
            "payment_date": payment.created if payment else "-",
            "amount": to_locale_number(amount),
            "user_name": user.first_name if user else "-",
            "user_phone": format_as_numeric_only_phone_number(user.aligo_phone) if user else "-",
            "error_message": f"{error_msg} {variant.sku}",
        }
        send_payment_fail_email(context=context, md_email=target_md_email, to_md=True)

        raise AssertionError(f"{error_msg} sku={variant.sku} {e}")


def get_empty_simple_attribute_data():
    attribute_data = {
        AttributeSlugEnum.QUANTITY.value: "",
        AttributeSlugEnum.MATERIAL.value: "",
        AttributeSlugEnum.COLOR.value: "",
        AttributeSlugEnum.SIZE.value: "",
        AttributeSlugEnum.CAPACITY.value: "",
        AttributeSlugEnum.WEIGHT.value: "",
        AttributeSlugEnum.PURCHASE_UNIT.value: "",
        AttributeSlugEnum.MAKER.value: "",
    }
    return attribute_data


def convert_to_simple_attribute_with_prefetched_data(
    variant: "ProductVariant", dropdown_input_attributes
):
    attribute_data = get_empty_simple_attribute_data()
    if variant is None:
        return attribute_data

    # ✅ 입수량 정보 추가
    attribute_data[AttributeSlugEnum.QUANTITY.value] = variant.qty_per_box

    product = variant.product
    attribute_slugs_list = set(attribute_data.keys())
    attribute_slugs_in_dropdown = [
        attr for attr in attribute_slugs_list if attr in dropdown_input_attributes
    ]
    attribute_slugs_not_in_dropdown = [
        attr for attr in attribute_slugs_list if attr not in dropdown_input_attributes
    ]

    variant_attributes_dict = {}
    for attr in getattr(variant, "prefetched_attributes", []):
        if (
            attr.assignment
            and attr.assignment.attribute
            and attr.assignment.attribute.slug in attribute_slugs_in_dropdown
        ):
            variant_attributes_dict[attr.assignment.attribute.slug] = {
                "attribute": attr,
                "values": getattr(attr, "prefetched_attributes_values", []),
            }

    product_attributes_dict = {}
    for attr in getattr(product, "prefetched_product_attributes", []):
        if (
            attr.assignment
            and attr.assignment.attribute
            and attr.assignment.attribute.slug in attribute_slugs_in_dropdown
        ):
            product_attributes_dict[attr.assignment.attribute.slug] = {
                "attribute": attr,
                "values": getattr(attr, "prefetched_product_attributes_values", []),
            }

    variant_directly_attributes_dict = {}
    for attr in getattr(variant, "prefetched_directly_attributes", []):
        if (
            attr.assignment
            and attr.assignment.attribute
            and attr.assignment.attribute.slug in attribute_slugs_not_in_dropdown
        ):
            variant_directly_attributes_dict[attr.assignment.attribute.slug] = attr

    product_directly_attributes_dict = {}
    for attr in getattr(product, "prefetched_product_directly_attributes", []):
        if attr.assignment and attr.assignment.attribute.slug in attribute_slugs_not_in_dropdown:
            product_directly_attributes_dict[attr.assignment.attribute.slug] = attr

    for attribute_slug in attribute_slugs_list:
        if attribute_slug in dropdown_input_attributes:
            attribute_info = variant_attributes_dict.get(
                attribute_slug
            ) or product_attributes_dict.get(attribute_slug)

            if attribute_info:
                values_list = attribute_info.get("values", [])
                if values_list:
                    attribute_data[attribute_slug] = values_list[0].name.strip()

        else:
            attribute = variant_directly_attributes_dict.get(
                attribute_slug
            ) or product_directly_attributes_dict.get(attribute_slug)
            if attribute:
                attribute_data[attribute_slug] = attribute.value

    return attribute_data


def convert_to_simple_attribute(variant: "ProductVariant", dropdown_input_attributes=None):
    attribute_data = get_empty_simple_attribute_data()
    if variant is None:
        return attribute_data

    attribute_slugs_list = list(attribute_data.keys())
    # 입수량 정보는 variant.qty_per_box 로 세팅
    attribute_data[AttributeSlugEnum.QUANTITY.value] = variant.qty_per_box

    product = variant.product
    if dropdown_input_attributes is None:
        dropdown_input_attributes = Attribute.objects.filter(
            input_type=AttributeInputType.DROPDOWN
        ).values_list("slug", flat=True)

    # attribute_slugs_list 중에서 dropdown_input_attributes 에 속하는 속성값들 list 구함.
    attribute_slugs_in_dropdown = [
        attr for attr in attribute_slugs_list if attr in dropdown_input_attributes
    ]
    attribute_slugs_not_in_dropdown = [
        attr for attr in attribute_slugs_list if attr not in dropdown_input_attributes
    ]

    variant_attributes = list(
        variant.attributes.filter(assignment__attribute__slug__in=attribute_slugs_in_dropdown)
        .annotate(slug=F("assignment__attribute__slug"))
        .prefetch_related("values")
    )
    product_attributes = list(
        product.attributes.filter(assignment__attribute__slug__in=attribute_slugs_in_dropdown)
        .annotate(slug=F("assignment__attribute__slug"))
        .prefetch_related("values")
    )

    variant_attributes_dict = {attr.slug: attr for attr in variant_attributes}
    product_attributes_dict = {attr.slug: attr for attr in product_attributes}

    variant_directly_attributes = list(
        variant.directly_attributes.filter(
            assignment__attribute__slug__in=attribute_slugs_not_in_dropdown
        ).annotate(slug=F("assignment__attribute__slug"))
    )
    product_directly_attributes = list(
        product.directly_attributes.filter(
            assignment__attribute__slug__in=attribute_slugs_not_in_dropdown
        ).annotate(slug=F("assignment__attribute__slug"))
    )

    variant_directly_attributes_dict = {attr.slug: attr for attr in variant_directly_attributes}
    product_directly_attributes_dict = {attr.slug: attr for attr in product_directly_attributes}

    for attribute_slug in attribute_slugs_list:
        # 옵션형 상품일 경우, 옵션에만 별도로 지정된 속성값도 존재.
        # 상품의 옵션 내 속성값을 우선적으로 저장하고, 옵션 내에 속성이 없는 경우에는 상품 자체의 속성을 저장
        if attribute_slug in dropdown_input_attributes:
            attribute = variant_attributes_dict.get(attribute_slug)
            if attribute is None and product:
                attribute = product_attributes_dict.get(attribute_slug)

            if attribute:
                value_first = attribute.values.first()
                if value_first:
                    attribute_value = value_first.name.strip()
                    attribute_data[attribute_slug] = attribute_value
        else:
            attribute = variant_directly_attributes_dict.get(attribute_slug)

            if attribute is None and product:
                attribute = product_directly_attributes_dict.get(attribute_slug)

            if attribute:
                attribute_data[attribute_slug] = attribute.value

    return attribute_data


def get_box_size_attribute_value_by_attribute_values(
    sum_of_box_size: int, box_size_attribute_values: List[AttributeValue]
) -> Optional[AttributeValue]:
    """
    주어진 box_size에 맞는 AttributeValue를 반환합니다.
    - range_start와 range_end가 모두 있는 경우: start <= 값 < end
    - range_start만 있는 경우: start 이상
    """
    try:
        for attr_val in box_size_attribute_values:
            val = attr_val.value or {}

            range_start = val.get("range_start")
            range_end = val.get("range_end")

            if range_start is None and range_end is None:
                continue  # 둘 다 없으면 무시

            # 마지막 구간: range_end 없음
            if range_end is None and range_start is not None:
                if sum_of_box_size >= range_start:
                    return attr_val
            # 일반 구간
            elif range_start is not None and range_end is not None:
                if range_start <= sum_of_box_size < range_end:
                    return attr_val

        return None
    except Exception as e:
        logger.error(f"박스사이즈 속성 값 찾기 중 오류 발생: {e}")
        return None


def get_box_size_attribute_by_box_size(box_length, box_width, box_height):
    box_size_attribute = Attribute.objects.filter(slug=AttributeSlugEnum.BOX_SIZE.value).first()
    if box_size_attribute is None:
        raise ValidationError("박스사이즈 속성이 존재하지 않습니다.")
    box_size_attribute_values_qs = AttributeValue.objects.filter(attribute_id=box_size_attribute.id)
    box_size_attribute_values: List[AttributeValue] = list(box_size_attribute_values_qs)

    if box_length is None or box_width is None or box_height is None:
        return box_size_attribute, None

    sum_of_box_size = box_height + box_width + box_length
    box_size_attribute_value = get_box_size_attribute_value_by_attribute_values(
        sum_of_box_size, box_size_attribute_values
    )

    return box_size_attribute, box_size_attribute_value


def get_box_size_type_by_attribute_value(attribute_value: AttributeValue) -> BoxSizeType:
    if attribute_value is None:
        return BoxSizeType.BOX_SIZE_TYPE_EMPTY
    return BoxSizeType(attribute_value.slug)


def get_delivery_fee_by_attribute_value(attribute_value: AttributeValue) -> Decimal:
    return attribute_value.value.get("delivery_fee")


def get_delivery_fee_by_box_size_type(box_size_type: BoxSizeType) -> Decimal:
    attribute_value = AttributeValue.objects.filter(slug=box_size_type).first()
    return get_delivery_fee_by_attribute_value(attribute_value)


def set_box_size_attribute_using_product_variant(variant: "ProductVariant") -> ProductVariant:
    # innerbox인 경우. 아래 작업들 안하고 바로 return
    if variant.outer:
        return variant

    box_size_attribute, attribute_value = get_box_size_attribute_by_box_size(
        variant.box_length, variant.box_width, variant.box_height
    )

    attribute_values = (attribute_value,)

    product_type = variant.product.product_type

    # attribute가 product에 있는지, variant에 있는지 확인한다.
    is_attribute_product = AttributeProduct.objects.filter(
        product_type=product_type, attribute=box_size_attribute
    ).exists()
    is_attribute_variant = AttributeVariant.objects.filter(
        product_type=product_type, attribute=box_size_attribute
    ).exists()

    if is_attribute_product:
        associate_attribute_values_to_instance(
            variant.product, box_size_attribute, *attribute_values
        )
    elif is_attribute_variant:
        associate_attribute_values_to_instance(variant, box_size_attribute, *attribute_values)
    else:
        is_fulfilled_by_vendor = variant.product.is_fulfilled_by_vendor
        if is_fulfilled_by_vendor == False and not variant.is_for_credits_refill:
            raise ValidationError(
                "보스 제품에 박스사이즈 속성이 없는 제품 타입으로 설정되어 있습니다."
            )

    # 수동입력이 아닌 경우에는 자동으로 계산해서 넣는다.
    if not variant.is_delivery_fee_amount_manual:
        variant.delivery_fee_amount = get_delivery_fee_by_attribute_value(attribute_value)
    return variant


def get_value_by_attribue_data(attribute_data: dict, slug_enum: AttributeSlugEnum) -> str:
    value = attribute_data[slug_enum.value]
    if isinstance(value, str):
        return value.strip()
    return value


def get_qty_in_box_by_attribue(attribute_data: dict) -> str:
    return get_value_by_attribue_data(attribute_data, AttributeSlugEnum.QUANTITY)


def get_s_c_w_spec_by_attribute(attribute_data: dict) -> str:
    attribute_value_list = []
    size_spec = get_value_by_attribue_data(attribute_data, AttributeSlugEnum.SIZE)
    if size_spec:
        attribute_value_list.append(size_spec)
    capacity_spec = get_value_by_attribue_data(attribute_data, AttributeSlugEnum.CAPACITY)
    if capacity_spec:
        attribute_value_list.append(capacity_spec)
    weight_spec = get_value_by_attribue_data(attribute_data, AttributeSlugEnum.WEIGHT)
    if weight_spec:
        attribute_value_list.append(weight_spec)
    if attribute_value_list:
        product_spec_text = "; ".join(attribute_value_list)
    else:
        product_spec_text = ""
    return product_spec_text


def get_material_spec_by_attribute(attribute_data: dict) -> str:
    material_spec = get_value_by_attribue_data(attribute_data, AttributeSlugEnum.MATERIAL)
    return material_spec if material_spec else ""


def get_color_spec_by_attribute(attribute_data: dict) -> str:
    color_spec = get_value_by_attribue_data(attribute_data, AttributeSlugEnum.COLOR)
    return color_spec if color_spec else ""


def make_product_spec_text_by_attribute(attribute_data: dict) -> str:
    attribute_value_list = []
    s_c_w_spec = get_s_c_w_spec_by_attribute(attribute_data)
    if s_c_w_spec:
        attribute_value_list.append(s_c_w_spec)
    material_spec = get_material_spec_by_attribute(attribute_data)
    if material_spec:
        attribute_value_list.append(material_spec)
    color_spec = get_color_spec_by_attribute(attribute_data)
    if color_spec:
        attribute_value_list.append(color_spec)
    if attribute_value_list:
        product_spec_text = "; ".join(attribute_value_list)
    else:
        product_spec_text = ""
    return product_spec_text
