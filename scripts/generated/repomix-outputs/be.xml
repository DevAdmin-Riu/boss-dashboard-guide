class Sales(models.Model):
    """
    ### 레코드 생성 시점
        * 주문 결제 완료 시 order_line 단위로 추가
        * 환불 시 refund_order_line 단위로 추가
        * 출고 시 관계된 order_line 데이터에 대해 실 매입가 정보 반영
        * 세금계산서 발행 시 세금계산서 정보 추가
        * 세금계산서 발행 후 환불 시 세금계산서 정산 금액 반영
    ### 환불 정산 데이터
        * 본부수익금, 결제수수료 는 매출 정산 시 차액이 필요하므로 환불 시점 이전까지의 누적 금액에서 차액 계산된 값으로 기록
    ### 매출마감출력 시 필요한 부가 정보: 조회 시간 단축을 위해 json 데이터로 저장
        * orderInfo: 주문/결제 정보 (주문번호, 결제방식, 오픈몰 정보등)
        * productInfo: 상품 정보 (판매가, 매입가, 제품명, 옵션명, 상품명, 제품코드, 규격, 박스사이즈 등)
        * vendorInfo: 협력사 정보
        * userInfo: 유저 정보 (매장명, 회원ID, 유저명, 연락처, 사업자번호 등)
        * mdInfo: 담당 MD명 등
    ### 위탁 여부
        * 자동 위탁 상품이 재고 부족으로 자동 위탁 처리된 경우 통계에서도 그 주문의 품목은 위탁으로 간주
    """

    # 통계 기준일: 주문 결제일 (주문 시점 결정), 매출 전표 취소일 (환불 시점 이니시스 환불 승인 응답일로 기록 후, 승인 대사 api 연동되면 실제 매출 전표 취소일로 업데이트)
    evented_at = models.DateTimeField(default=timezone.now, db_index=True)
    # 매출마감 처리된 경우 마감 기준일 => 월 마감이므로 DD는 Trunc 하고 사용
    sales_close_date = models.DateField(blank=True, null=True)
    # b2b 주문일
    b2b_order_created_at = models.DateTimeField(blank=True, null=True)
    # b2b 거래명세서 출력일 (납품일로 표시)
    b2b_invoice_printed_at = models.DateTimeField(blank=True, null=True)
    # b2b 주문 완료일 발주 배송완료 처리 일시로 기록
    b2b_order_completed_at = models.DateTimeField(blank=True, null=True)
    b2b_status = models.CharField(
        max_length=20,
        choices=SalesB2bStatus.choices,
        default=SalesB2bStatus.STANDBY,
    )
    b2b_req_revision_reason = models.TextField(null=True, blank=True)

    # 실 결제(환불) 금액
    amount = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
    # 사용(환불) 충전금 - 현금 출금 가능
    cashable_credits = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
    # 사용(환불) 충전금 - 현금 출금 불가
    non_cashable_credits = models.DecimalField(
