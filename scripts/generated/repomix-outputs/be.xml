class PurchaseOrderStockLinesAdd(BaseMutation):
    purchase_order = graphene.Field(PurchaseOrder, description="A stocks added purchase order.")

    class Arguments:
        purchase_order_id = graphene.ID(description="The ID of the purchase order.", required=True)
        input = PurchaseOrderStockLinesAddInput(
            required=True,
            description=(
                "A list of purchase order lines, each containing information about "
                "an item in the purchase order stock line."
            ),
        )

    class Meta:
        description = (
            "Adds a purchase order stock line to the existing purchase order line. (발주서 > 입고)"
        )
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER_STOCK,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_stocked_date(cls, stocked_date, purchase_order: PurchaseOrderModel):
        if stocked_date is None:
            raise ValidationError("입고 일자를 선택해주세요.")

        if purchase_order.purchase_order_date > stocked_date:
            raise ValidationError("발주일 이전은 입고일로 선택이 불가합니다.")

    @classmethod
    def validate_lines_for_duplicates(cls, lines_ids):
        duplicates = get_duplicated_values(lines_ids)
        if duplicates:
            error_msg = "발주제품이 중복 입력되었습니다."
            raise ValidationError(error_msg)

    @classmethod
    def validate_lines_variant(
        cls, purchase_order: PurchaseOrderModel, purchase_order_lines: List[PurchaseOrderLineModel]
    ):
        is_track_inventory_po = purchase_order.is_track_inventory_po
        if is_track_inventory_po == False:
            raise ValidationError("초도발주서, 재발주서 타입의 발주서에서만 가능한 기능입니다.")

        warehouse = purchase_order.warehouse
        is_external_warehouse_delivery = warehouse is None

        stock_errors = []
        minus_stock_errors = []
        for purchase_order_line in purchase_order_lines:
            variant = purchase_order_line.variant

            stock = (
                variant.stocks.filter(warehouse=warehouse, product_variant=variant).first()
                if is_external_warehouse_delivery == False
                else None
            )
            if not is_external_warehouse_delivery:
                if not stock:
                    stock_errors.append(variant.sku)
                else:
                    if stock.quantity < 0:
                        minus_stock_errors.append(variant.sku)

        if stock_errors:
            error_msg = (
                "납품 물류센터로 연결되지 않은 제품은 입고가 불가합니다. (제품코드: {})".format(
                    ", ".join(stock_errors)
                )
            )
            raise ValidationError(error_msg)
        if minus_stock_errors:
            error_msg = "부자재 재고 부족 상태로 출고로 음수 재고 상태가 된 부자재는 입고가 불가합니다. 부자재 음수 재고 조정 등록을 하신 후 다시 시도해 주세요. (제품코드: {})".format(
                ", ".join(minus_stock_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_purchase_order_lines(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        dev_po_status_errors = []
        status_errors = []
        for purchase_order_line in purchase_order_lines:
            if purchase_order_line.is_dev_pv:
                if purchase_order_line.status != PurchaseOrderLineStatus.DELIVERY_CONFIRMED:
                    dev_po_status_errors.append(purchase_order_line.product_sku)
            else:
                if purchase_order_line.status != PurchaseOrderLineStatus.INSPECTED:
                    status_errors.append(purchase_order_line.product_sku)

        if dev_po_status_errors:
            error_msg = "개발비 제품은 배송확정 상태의 품목만 거래명세서출력 시 입고처리까지 진행됩니다. (제품코드: {})".format(
                ", ".join(status_errors)
            )
            raise ValidationError(error_msg)
        if status_errors:
            error_msg = "검수완료 상태의 품목만 입고할 수 있습니다. (제품코드: {})".format(
                ", ".join(status_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def reorder_po_lines_as_input(
        cls, line_ids, purchase_order_lines: List[PurchaseOrderLineModel]
    ):
        reorder_po_lines_as_input = []
        for line_id in line_ids:
            _, po_line_pk = graphene.Node.from_global_id(line_id)
            po_line = next(
                (line for line in purchase_order_lines if str(line.id) == po_line_pk), None
            )
            reorder_po_lines_as_input.append(po_line)

        return reorder_po_lines_as_input

    @classmethod
    def validate_stocked_quantity_list(
        cls,
        purchase_order_lines: List[PurchaseOrderLineModel],
        stocked_quantity_list: List["int"],
    ):
        for quantity in stocked_quantity_list:
            if quantity <= 0:
                raise ValidationError("입고 수량은 0 보다 큰 값만 입력 가능합니다.")

        overstock_errors = []
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
        allowed_overstocking_rate = Decimal(plugin_configs.allowed_overstocking_rate)
        for purchase_order_line, stocked_quantity in zip(
            purchase_order_lines, stocked_quantity_list
        ):
            quantity = purchase_order_line.quantity
            if stocked_quantity > quantity * (100 + allowed_overstocking_rate) / 100:
                overstock_errors.append(purchase_order_line.product_sku)
        if overstock_errors:
            error_msg = "입고 수량이 발주 수량의 {}%를 초과할 수 없습니다. (제품코드: {})".format(
                allowed_overstocking_rate, ", ".join(overstock_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_exp_date_list(
        cls,
        purchase_order_lines: List[PurchaseOrderLineModel],
        exp_date_list: List["graphene.Date"],
    ):
        if len(purchase_order_lines) != len(exp_date_list):
            raise ValidationError("입고 정보와 유통기한의 개수가 일치하지 않습니다.")

        errors = []
        for purchase_order_line, exp_date in zip(purchase_order_lines, exp_date_list):
            if purchase_order_line.variant.required_exp_date_mgmt and exp_date is None:
                errors.append(purchase_order_line.product_sku)
        if errors:
            error_msg = "유통기한 관리 필수 제품에 유통기한 누락 (제품코드: {})".format(
                ", ".join(errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def validate_purchase_order(cls, purchase_order: PurchaseOrderModel):
        if purchase_order.event_type not in STOCKABLE_PO_EVENT_TYPES:
            raise ValidationError("초도발주서, 재발주서만 입고 처리할 수 있습니다.")

    @classmethod
    def check_fully_stocked(
        cls,
        purchase_order: PurchaseOrderModel,
        purchase_order_lines: List[PurchaseOrderLineModel],
    ):
        need_to_stock_line_ids_set = set(
            purchase_order.lines.filter(status__in=STOCKABLE_STATUSES).values_list("pk", flat=True)
        )
        input_line_ids_set = set()
        for purchase_order_line in purchase_order_lines:
            input_line_ids_set.add(purchase_order_line.id)

        return need_to_stock_line_ids_set == input_line_ids_set

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_id, **data):
        purchase_order: PurchaseOrderModel = cls.get_node_or_error(
            info, purchase_order_id, only_type=PurchaseOrder, field="purchase_order_id"
        )
        cls.validate_purchase_order(purchase_order)

        user = info.context.user
        cleaned_input = data.get("input", {})

        stocked_date = cleaned_input.get("stocked_date")
        cls.validate_stocked_date(stocked_date, purchase_order)

        input_lines = cleaned_input.get("lines", [])
        if not input_lines:
            raise ValidationError("발주제품 리스트가 필요합니다.")

        purchase_order_line_ids = [input_line.get("line_id", None) for input_line in input_lines]
        cls.validate_lines_for_duplicates(purchase_order_line_ids)
        purchase_order_lines = cls.get_nodes_or_error(
            purchase_order_line_ids,
            field="lines",
            only_type=PurchaseOrderLine,
            qs=models.PurchaseOrderLine.objects.select_related("variant"),
        )
        cls.validate_lines_variant(purchase_order, purchase_order_lines)
        cls.validate_purchase_order_lines(purchase_order_lines)
        is_fully_stocked = cls.check_fully_stocked(purchase_order, purchase_order_lines)

        purchase_order_lines = cls.reorder_po_lines_as_input(
            purchase_order_line_ids, purchase_order_lines
        )
        stocked_quantity_list = [line.get("quantity", 0) for line in input_lines]
        cls.validate_stocked_quantity_list(purchase_order_lines, stocked_quantity_list)
        exp_date_list = [line.get("exp_date", None) for line in input_lines]
        cls.validate_exp_date_list(purchase_order_lines, exp_date_list)

        warehouse = purchase_order.warehouse
        rack_locations = []
        if warehouse:
            rack_location_ids = [
                input_line.get("rack_location", None) for input_line in input_lines
            ]
            # 개발비 제품의 경우 None이 들어올 수 잇음.(거래명세서 출력 단계에서 바로 이 Mutation 호출됨)
            rack_location_ids_for_get_nodes = [loc for loc in rack_location_ids if loc is not None]
            qs_for_rack_location = warehouse_models.RackLocation.objects.select_related(
                "sector", "sector__address"
            )
            rack_locations_unique = (
                cls.get_nodes_or_error(
                    rack_location_ids_for_get_nodes,
                    field="id",
                    only_type=RackLocation,
                    qs=qs_for_rack_location,
                )
                if rack_location_ids_for_get_nodes
                else []
            )

            for rack_location_id in rack_location_ids:
                if rack_location_id is None:
                    rack_locations.append(None)
                    continue
                _, rack_location_pk = graphene.Node.from_global_id(rack_location_id)
                rack_location = next(
                    (loc for loc in rack_locations_unique if str(loc.id) == rack_location_pk), None
                )
                if rack_location:
                    rack_locations.append(rack_location)

        stocked_purchase_order_lines = stock_purchase_order_stock_lines(
            user,
            purchase_order,
            purchase_order_lines,
            stocked_quantity_list,
            exp_date_list,
            rack_locations,
            stocked_date,
        )
        # 초도발주, 재발주는 입고 시점 마다 입고 처리된 purchase_order_lines 만 매입데이터 생성
        add_purchase_by_purchase_order_lines(
            purchase_order_lines=stocked_purchase_order_lines, common_purchase_order=purchase_order
        )
        use_auto_turn_off_allow_auto_consignment(purchase_order_lines=stocked_purchase_order_lines)

        add_po_manage_event_on_stocked(
            purchase_order=purchase_order,
            purchase_order_lines=stocked_purchase_order_lines,
            stocked_quantity_list=stocked_quantity_list,
        )

        if is_fully_stocked:
            events.add_po_manage_event(
                purchase_order=purchase_order,
                user=user,
                type=PurchaseOrderManageEventType.FULLY_STOCKED,
            )

        if purchase_order.is_initial_order:
            set_pv_sales_status_to_on_sale(purchase_order_lines)
            send_email_to_po_manager_in_case_initial_po(
                purchase_order_lines, stocked_quantity_list, stocked_date
            )

        return PurchaseOrderStockLinesAdd(purchase_order=purchase_order)


