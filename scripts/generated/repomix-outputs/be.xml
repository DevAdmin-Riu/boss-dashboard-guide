class ConsignmentOrderLineUpdateVendor(BaseMutation):
    class Arguments:
        id = graphene.ID(required=True, description="ID of an order line to update.")
        input = ConsignmentOrderLineUpdateVendorInput(
            description="Fields required to update a order line.", required=True
        )

    class Meta:
        description = "출고 완료된 위탁 주문 협력사 정보 변경"
        permissions = (OrderPermissions.MANAGE_ORDER_INFO,)
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def validate_relation(cls, order_line: OrderLineModel):
        if not order_line.fulfillment_lines.exists():
            raise ValidationError("위탁 주문 출고 정보가 존재하지 않습니다.")
        if not order_line.sales_stats.exists():
            raise ValidationError("위탁 주문 매출 정보가 존재하지 않습니다.")
        if not order_line.purchase_order_line:
            raise ValidationError("위탁 발주서 정보가 존재하지 않습니다.")
        if not order_line.purchase_order_line.purchases.exists():
            raise ValidationError("위탁 발주서에 연결된 매입 내역이 존재하지 않습니다.")

    @classmethod
    def validate_fulfilled_consignment(cls, order_line: OrderLineModel):
        if order_line.track_inventory:
            raise ValidationError("위탁 주문만 협력사 정보를 변경할 수 없습니다.")
        if order_line.quantity_fulfilled <= 0:
            raise ValidationError(
                "출고 처리되지 않은 위탁 주문은 협력사 정보를 변경할 수 없습니다."
            )

    @classmethod
    def validate_order_date(cls, order_line: OrderLineModel):
        today_datetime = kst_datetime()
        this_month_first_day = today_datetime.replace(
            day=1, hour=0, minute=0, second=0, microsecond=0
        )
        order_created = order_line.order.created
        if today_datetime.day <= 10:
            prev_month_first_day = this_month_first_day - relativedelta(months=1)
            if order_created < prev_month_first_day:
                raise ValidationError(
                    "매입 마감일 (매월 10일) 까지는 직전월 1일 이후의 위탁 주문만 수정할 수 있습니다."
                )
        else:
            if order_created < this_month_first_day:
                raise ValidationError(
                    "매입 마감일 (매월 10일) 이 경과되면 당월 1일 이후의 위탁 주문만 수정할 수 있습니다."
                )

    @classmethod
    def validate_vendor_info(cls, order_line: OrderLineModel, vendor, unit_cost_price_exclude_vat):
        if not vendor:
            raise ValidationError("협력사 정보가 존재하지 않습니다.")
        if unit_cost_price_exclude_vat <= 0:
            raise ValidationError("협력사 매입단가는 0보다 커야 합니다.")

        fulfillment_line = order_line.fulfillment_lines.first()
        if not fulfillment_line:
            raise ValidationError("출고 정보가 존재하지 않습니다.")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        qs = models.OrderLine.objects.select_related("purchase_order_line").prefetch_related(
            "fulfillment_lines", "sales_stats", "purchase_order_line__purchases"
        )
        order_line: OrderLineModel = cls.get_node_or_error(
            info, data.get("id"), only_type=OrderLine, qs=qs
        )
        input_data = data.get("input", {})
        vendor_id = input_data.get("vendor_id")
        vendor = cls.get_node_or_error(info, vendor_id, only_type=Vendor)
        unit_cost_price_exclude_vat = input_data.get("unit_cost_price_exclude_vat")
        purchase_date = input_data.get("purchase_date")

        cls.validate_relation(order_line)
        cls.validate_fulfilled_consignment(order_line)
        cls.validate_order_date(order_line)
        cls.validate_vendor_info(order_line, vendor, unit_cost_price_exclude_vat)

        fulfillment_line: FulfillmentLineModel = order_line.fulfillment_lines.first()
        before_vendor = fulfillment_line.vendor

        purchase_order_line: PurchaseOrderLine = order_line.purchase_order_line
        purchase: Purchase = purchase_order_line.purchases.first()

        manage_event_parameters = {
            "order_line": order_line.composed_id_with_prefix,
            "sku": order_line.product_sku,
            "before": {
                "vendor": make_simple_vendor_parameters(before_vendor),
                "unit_cost_price_exclude_vat": fulfillment_line.unit_cost_price_exclude_vat,
                "purchase_date": purchase.purchase_date,
            },
            "after": {
                "vendor": make_simple_vendor_parameters(vendor),
                "unit_cost_price_exclude_vat": unit_cost_price_exclude_vat,
                "purchase_date": purchase_date,
            },
        }

        order_line.fulfillment_lines.update(
            vendor=vendor, unit_cost_price_exclude_vat=unit_cost_price_exclude_vat
        )

        purchase.parameters["vendor"] = make_vendor_parameters(vendor)
        purchase.parameters["product"]["unit_cost_price_exclude_vat"] = unit_cost_price_exclude_vat

        purchase.cost_price_exclude_vat = calc_total_exclude_vat_by_unit_exclude_vat_and_qty(
            unit_cost_price_exclude_vat,
            purchase_order_line.purchase_quantity,
            order_line.is_tax_free,
        )
        purchase.vat_amount = calc_vat_by_price_exclude_vat(
            purchase.cost_price_exclude_vat, order_line.is_tax_free
        )
        purchase.vendor = vendor
        purchase.purchase_date = purchase_date
        purchase.save(
            update_fields=[
                "parameters",
                "cost_price_exclude_vat",
                "vat_amount",
                "vendor",
                "purchase_date",
            ]
        )

        vendor_info = make_sales_vendor_info(order_line)
        order_line.sales_stats.update(
            fulfill_vendor=vendor,
            vendor_info=vendor_info,
            unit_cost_price_exclude_vat=unit_cost_price_exclude_vat,
        )

        user = info.context.user
        add_po_manage_event(
            purchase_order=purchase_order_line.purchase_order,
            user=user,
            type=PurchaseOrderManageEventType.CONSIGNMENT_VENDOR_UPDATED,
            parameters=manage_event_parameters,
        )

        models.OrderEvent.objects.create(
            order=order_line.order,
            type=OrderEvents.CONSIGNMENT_VENDOR_UPDATED,
            user=user,
            parameters=manage_event_parameters,
        )

        return cls()


