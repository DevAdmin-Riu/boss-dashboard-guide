        if direct_shipping_detail or direct_shipping_detail == {}:
            ds_detail_instance = models.DirectShippingDetail.objects.create(
                exist_normal_key=direct_shipping_detail.get("exist_normal_key", False),
                exist_card_key=direct_shipping_detail.get("exist_card_key", False),
                exist_number_key=direct_shipping_detail.get("exist_number_key", False),
