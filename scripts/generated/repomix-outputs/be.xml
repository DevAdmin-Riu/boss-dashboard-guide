class BrandGroupMutationHelper:
    @staticmethod
    def get_brand_group(brand_group_global_id):
        """브랜드 그룹 ID를 검증하고 객체를 반환합니다."""
        _type, brand_group_id = graphene.Node.from_global_id(brand_group_global_id)
        try:
            return models.BrandGroup.objects.get(pk=brand_group_id)
        except models.BrandGroup.DoesNotExist:
            raise ValidationError("존재하지 않는 브랜드 그룹입니다.")

    @staticmethod
    def get_brands(brand_global_ids):
        """브랜드 ID 리스트를 검증하고 객체 리스트를 반환합니다."""
        brand_ids = [
            int(graphene.Node.from_global_id(brand_global_id)[1])
            for brand_global_id in brand_global_ids
        ]
        brands = models.Brand.objects.filter(pk__in=brand_ids)
        existing_brand_ids = set(brands.values_list("id", flat=True))
        missing_brand_ids = set(brand_ids) - existing_brand_ids
        if missing_brand_ids:
            raise ValidationError(
                f"존재하지 않는 브랜드 ID가 포함되어 있습니다: {', '.join(missing_brand_ids)}"
            )
        return brands

    @staticmethod
    def update_brand_group(brands, brand_group=None):
        """브랜드 그룹에 브랜드를 할당하거나 해제합니다."""
        brands.update(brand_group=brand_group)


class BulkAssignBrandsToBrandGroup(BaseMutation):
    brand_group = graphene.Field(BrandGroup, description="브랜드 그룹")

