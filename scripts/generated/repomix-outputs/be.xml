import django_filters
import graphene
from graphene_django.filter import GlobalIDFilter

from ...taxinvoice.models import TaxInvoice
from ..core.filters import ListObjectTypeFilter, ObjectTypeFilter
from ..core.types.common import DateRangeInput
from ..core.types.filter_input import FilterInputObjectType
from ..order.enums import OrderTypeEnum
from ..order.utils import filter_order_search_factory
from ..utils.filters import filter_by_query_param, filter_range_field
from .enums import TaxInvoiceStatusEnum


class TaxInvoiceFilter(django_filters.FilterSet):
    def filter_order_search(qs, _, value):
        return filter_order_search_factory(field_name="order_id")(qs, _, value)

    def filter_user_search(qs, _, value):
        search_fields = [
            "order__user__first_name",
            "order__user__login_id",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_brand_search(qs, _, value):
        search_fields = [
            "order__brand__code",
            "order__brand__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_b2b_brand_search(qs, _, value):
        search_fields = [
            "b2b_brand__code",
            "b2b_brand__name",
        ]
        qs = filter_by_query_param(qs, value, search_fields)
        return qs

    def filter_status(qs, _, value):
        if value:
            return qs.filter(status__in=value)
        return qs

    def filter_order_type(qs, _, value):
        if value:
            return qs.filter(order__type__in=value)
        return qs

    def filter_writed_at_range(qs, _, value):
        return filter_range_field(qs, "write_date", value)

    def filter_issued_at_range(qs, _, value):
        return filter_range_field(qs, "issued__date", value)

    def filter_is_tax_free(qs, _, value):
        if value is not None:
            qs = qs.filter(is_tax_free=value)
        return qs

    def filter_is_from_riu(qs, _, value):
        if value is not None:
            qs = qs.filter(is_from_riu=value)
        return qs

    def filter_is_to_hq(qs, _, value):
        if value is not None:
            qs = qs.filter(is_to_hq=value)
        return qs

    def filter_is_reverse_fee(qs, _, value):
        if value is not None:
            qs = qs.filter(is_reverse_fee=value)
        return qs

    def filter_is_b2b(qs, _, value):
        if value is not None:
            qs = qs.filter(is_b2b=value)
        return qs

    def filter_brand(qs, _, value):
        if value:
            _, brand_id = graphene.Node.from_global_id(value)
            qs = qs.filter(order__brand_id=brand_id)
        return qs

    def filter_b2b_brand(qs, _, value):
        if value:
            _, brand_id = graphene.Node.from_global_id(value)
            qs = qs.filter(b2b_brand_id=brand_id)
        return qs

    order_search = django_filters.CharFilter(method=filter_order_search)
    user_search = django_filters.CharFilter(method=filter_user_search)
    brand_search = django_filters.CharFilter(method=filter_brand_search)
    b2b_brand_search = django_filters.CharFilter(method=filter_b2b_brand_search)

    status = ListObjectTypeFilter(input_class=TaxInvoiceStatusEnum, method=filter_status)
    order_type = ListObjectTypeFilter(input_class=OrderTypeEnum, method=filter_order_type)

    writed_at = ObjectTypeFilter(input_class=DateRangeInput, method=filter_writed_at_range)
    issued_at = ObjectTypeFilter(input_class=DateRangeInput, method=filter_issued_at_range)

    is_tax_free = django_filters.BooleanFilter(method=filter_is_tax_free)
    is_from_riu = django_filters.BooleanFilter(method=filter_is_from_riu)
    is_to_hq = django_filters.BooleanFilter(method=filter_is_to_hq)
    is_reverse_fee = django_filters.BooleanFilter(method=filter_is_reverse_fee)
    is_b2b = django_filters.BooleanFilter(method=filter_is_b2b)
    brand = GlobalIDFilter(method=filter_brand)
    b2b_brand = GlobalIDFilter(method=filter_b2b_brand)

    class Meta:
        model = TaxInvoice
        fields = []


class TaxInvoiceFilterInput(FilterInputObjectType):
    class Meta:
        filterset_class = TaxInvoiceFilter
