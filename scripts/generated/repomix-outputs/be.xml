    def can_cancel(self):
        # b2b 주문 거래 Order는 취소 불가
        if self.is_b2b_order:
            return False

        payment: Payment = self.get_last_payment()
        if payment:
            exist_captured_history = payment.charge_status in [
                ChargeStatus.PARTIALLY_CHARGED,
                ChargeStatus.FULLY_CHARGED,
                ChargeStatus.PARTIALLY_REFUNDED,
                ChargeStatus.FULLY_REFUNDED,
            ]
            if exist_captured_history:
                return False

        return (
            not self.fulfillments.exclude(
                status__in=[FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
            ).exists()
        ) and self.status not in {OrderStatus.CANCELED}

    # 아래 코드 수정시 resolve_can_refund_by_user도 수정 필요.
    def can_refund_by_user(self):
        payment: Payment = self.get_last_payment()
        if not payment:
            return False

        exist_captured_history = payment.charge_status in [
            ChargeStatus.PARTIALLY_CHARGED,
            ChargeStatus.FULLY_CHARGED,
            ChargeStatus.PARTIALLY_REFUNDED,
            ChargeStatus.FULLY_REFUNDED,
        ]
        if exist_captured_history == False:
            return False

        return (
            not self.fulfillments.exclude(
                status__in=[FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
            ).exists()
        ) and self.status not in {OrderStatus.CANCELED}

    def can_capture(self, payment=None):
        if not payment:
            payment = self.get_last_payment()
        if not payment:
            return False
        order_status_ok = self.status not in {OrderStatus.CANCELED}
        return payment.can_capture() and order_status_ok

    def can_void(self, payment=None):
        if not payment:
            payment = self.get_last_payment()
        if not payment:
            return False
        return payment.can_void()

    def can_refund(self, payment=None):
        if not payment:
            payment = self.get_last_payment()
        if not payment:
            return False
        return payment.can_refund()

    def can_mark_as_paid(self):
        return len(self.payments.all()) == 0

