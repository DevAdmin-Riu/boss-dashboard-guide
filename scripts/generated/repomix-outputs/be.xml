    return f"{order.id}-{fulfillment.fulfillment_order}-{fulfillment_line.id}-R"


def make_goodsflow_uniqueCd_for_return_using_uniqueCd(uniqueCd: str):
    splits = uniqueCd.split("-")
    return f"{splits[0]}-{splits[1]}-{splits[2]}-R"


def parse_fulfillment_id_from_transUniqueCd(goodsflow_transUniqueCd: str):
    splits = goodsflow_transUniqueCd.split("-")
    return splits[2]


def _make_goodsflow_order_items(fulfillment: Fulfillment, is_return=False):
    order = fulfillment.order
    fulfillment_lines = (
        FulfillmentLine.objects.select_related("stock")
        .prefetch_related(
            "stock_detail_lines",
            "stock_detail_lines__rack_stock_detail",
            "stock_detail_lines__rack_stock_detail__location",
        )
        .filter(fulfillment_id=fulfillment.id)
    )
    kst_create_datetime = to_kst_date_format_from_utc_datetime(order.created, "%Y%m%d%H%M%S")

    order_items = []
    box_size = None
    for idx, fulfillment_line in enumerate(fulfillment_lines):
        order_line = fulfillment_line.order_line
        if order_line is None:
            raise ValidationError(f"order_line not exist? FL{fulfillment_line.id}")

        location = ""
        stock_detail_lines: List[StockDetailLine] = fulfillment_line.stock_detail_lines.all()
        for stock_detail_line in stock_detail_lines:
            rack_location: RackLocation = stock_detail_line.rack_location
            if rack_location:
                location = rack_location.name
                break

        item_code = f"[{location}]★" if order.is_first else f"[{location}]"
        item_name = f"[{order_line.product_sku}] {order_line.product_name}"
        item_option = order_line.get_only_variant_name()

        order_line_box_size = order_line.box_size
        if order_line_box_size and order_line_box_size != BoxSizeType.BOX_SIZE_TYPE_EMPTY:
            if box_size:
                box_size = box_size if box_size > order_line_box_size else order_line_box_size
            else:
                box_size = order_line_box_size

        uniqueCd = (
            make_goodsflow_uniqueCd_for_return(fulfillment, fulfillment_line)
            if is_return
            else make_goodsflow_uniqueCd(fulfillment, fulfillment_line)
        )

        order_item = {
            "uniqueCd": uniqueCd,
            "ordNo": order.id,
            "ordLineNo": idx,
            "itemCode": item_code,
            "itemName": item_name,
            "itemOption": item_option,
            # goodsflow item 수량은 정수만 취급하므로 소수점 이하는 버림 처리
            # 소수점 주문, 출고는 일단 위탁 식자재에서만 다루므로, 재고 상품에도 취급할 경우 주문한 정확한 수량을 표현할 방법 구현은 추후 고려
            "itemQty": int(fulfillment_line.quantity),
            "ordDate": kst_create_datetime,
        }
        order_items.append(order_item)

    return (order_items, box_size)


def _get_receiver_name(address: Address, user: User):
    user_first_name = user.first_name if user else ""
    first_name = (
        address.first_name
        if address and address.first_name and address.first_name.strip()
        else user_first_name
    )
    if user and user.brand:
        return f"{user.brand.name} ({first_name})"
    return first_name


def _make_goodsflow_item(config: any, is_retry: bool, fulfillment: Fulfillment):
    order = fulfillment.order
    receiver_address = order.shipping_address

    order_items, box_size = _make_goodsflow_order_items(fulfillment, is_return=False)

    recv_tel1 = format_as_numeric_only_phone_number(receiver_address.phone)
    if recv_tel1 is None:
        logger.error(
            f"_make_goodsflow_item > receiver_address.phone 형식 오류: receiver_address.phone={receiver_address.phone}"
        )
        return

    item = {
        "transUniqueCd": make_goodsflow_transUniqueCd(fulfillment),
        "sndName": config.sender_name,
        "sndZipCode": config.sender_zip_code,
        "sndAddr1": config.sender_address_1,
        "sndAddr2": config.sender_address_2,
        "sndTel1": config.sender_phone,
        "rcvName": _get_receiver_name(address=receiver_address, user=order.user),
        "rcvZipCode": receiver_address.postal_code,
        "rcvAddr1": receiver_address.street_address_1,
        "rcvAddr2": receiver_address.street_address_2,
        "rcvTel1": recv_tel1,
        "mallId": config.mall_id,
        "status": "O" if is_retry else "N",
        "paymentTypeCode": "SH",
        "orderItems": order_items,
        "msgToTrans": order.customer_note if order.customer_note else "",
        # 롯데 택배 사용 중일때는 굿스플로우 기준 초소인 02로 고정. 실제 택배단가와 상이함(구간 수 자체가 다름.)
        "boxSize": "02",
    }

    return item


def _make_goodsflow_return_item(config: any, fulfillment: Fulfillment):
    order = fulfillment.order
    receiver_address = order.shipping_address
    order_items, box_size = _make_goodsflow_order_items(fulfillment, is_return=True)

    recv_tel1 = format_as_numeric_only_phone_number(receiver_address.phone)
    if recv_tel1 is None:
        logger.error(
            f"_make_goodsflow_item > receiver_address.phone 형식 오류: receiver_address.phone={receiver_address.phone}"
        )
        return

    transUniqueCd = make_goodsflow_transUniqueCd_for_return(fulfillment)

    # 반품이므로 rcv, snd 정보 바꿔서 세팅
    item = {
        "transUniqueCd": transUniqueCd,
        "centerCode": config.center_code if config.is_prod_mode else config.dev_center_code,
        "deliverCode": "",
        "rcvName": config.sender_name,
        "rcvZipCode": config.sender_zip_code,
        "rcvAddr1": config.sender_address_1,
        "rcvAddr2": config.sender_address_2,
        "rcvTel1": config.sender_phone,
        "sndName": _get_receiver_name(address=receiver_address, user=order.user),
        "sndZipCode": receiver_address.postal_code,
        "sndAddr1": receiver_address.street_address_1,
        "sndAddr2": receiver_address.street_address_2,
        "sndTel1": recv_tel1,
        "mallId": config.mall_id,
        "status": "N",
        "paymentTypeCode": "BH",
        "orderItems": order_items,
        "msgToTrans": transUniqueCd,
        # 롯데 택배 사용 중일때는 굿스플로우 기준 초소인 02로 고정. 실제 택배단가와 상이함(구간 수 자체가 다름.)
        "boxSize": "02",
    }

    return item


def make_goods_order_data_by_target_fulfillments(
    config: any,
    target_fulfillments: List[Fulfillment],
    is_retry: bool = False,
    is_return: bool = False,
):
    target_fulfillments_count = len(target_fulfillments)
    logger.info(f"goodsflow target_fulfillments count: {target_fulfillments_count}")

    if target_fulfillments_count == 0:
        return None

    items = []
    for fulfillment in target_fulfillments:
        if is_return:
            item = _make_goodsflow_return_item(config, fulfillment)
            item["sheetNo"] = fulfillment.tracking_number
            item["deliverCode"] = fulfillment.courier.code_goodsflow
        else:
            item = _make_goodsflow_item(config, is_retry, fulfillment)
        items.append(item)

    import re

    def extract_value_from_item_code_or_name(item_name: str) -> str:
        # [] 안의 값을 추출 (없으면 빈 문자열 반환)
        match = re.search(r"\[([^\]]+)\]", item_name)
        return match.group(1) if match else ""

    # 출고 시 로케이션 정보 순서로 정렬된 리스트로 작업해야 편리하다고 해서 로케이션 정보가 들어간 itemCode 순으로 정렬
    # orderItems가 여러개인 건은 첫번째 orderItem의 itemCode로 정렬
    # 아래 정렬 방식 수정 시 qs_with_reprinting도 수정 고려 필요.
    # itemCode, itemName의
    items.sort(
        key=lambda item: (
            extract_value_from_item_code_or_name(item.get("orderItems")[0].get("itemCode")),
            extract_value_from_item_code_or_name(item.get("orderItems")[0].get("itemName")),
        )
    )

    data = {"data": {"items": items, "totalItems": len(items)}}

    json_string = json.dumps(data)
    return json_string


def make_goodsflow_order_data(
    config: any,
    is_retry: bool = False,
    fulfillment_id: str = None,
    only_selected=False,
    fulfillment_ids: Optional[List[str]] = None,
    is_return: bool = False,
):
    if only_selected:
        pk_list = [graphene.Node.from_global_id(id)[1] for id in fulfillment_ids]
        target_fulfillments_qs = Fulfillment.objects.filter(pk__in=pk_list)
    else:
        if is_retry:
            _, pk = graphene.Node.from_global_id(fulfillment_id)
            target_fulfillments_qs = Fulfillment.objects.filter(pk=pk)
        else:
            qs = Fulfillment.objects.filter(
                tracking_number__exact="",
                status=FulfillmentStatus.FULFILLED,
                is_picking_order=False,
            )
            qs = qs.annotate(
                track_inventory_count=Count(
                    "lines",
                    filter=Q(
                        lines__track_inventory=True,
                        order__delivery_method=OrderDeliveryMethods.BY_COURIER,
                    ),
                ),
            )
            target_fulfillments_qs = qs.filter(track_inventory_count__gt=0)[
                : Decimal(config.max_request)
            ]

    return make_goods_order_data_by_target_fulfillments(
        config, list(target_fulfillments_qs), is_retry, is_return
    )


def make_goodsflow_order_data_by_batch_picking_ids(
    config: any, batch_picking_ids: Optional[List[str]] = None
):
    pk_list = [graphene.Node.from_global_id(id)[1] for id in batch_picking_ids]
    target_batch_pickings = BatchPicking.objects.filter(pk__in=pk_list)

    max_request = Decimal(config.max_request)

    target_fulfillments = []
    for batch_picking in target_batch_pickings:
        batch_picking_fulfillments_qs = batch_picking.fulfillments.filter(
            tracking_number__exact="", status=FulfillmentStatus.FULFILLED
        )
        batch_picking_fulfillments = list(batch_picking_fulfillments_qs)
        if (len(target_fulfillments) + len(batch_picking_fulfillments)) > max_request:
            break
        target_fulfillments.extend(batch_picking_fulfillments)

    return make_goods_order_data_by_target_fulfillments(
        config, target_fulfillments, is_retry=False, is_return=False
    )


def make_goodsflow_return_cancel_data(trans_unique_cd):
    data = {"data": {"items": [{"transUniqueCd": trans_unique_cd}]}}
    return data
