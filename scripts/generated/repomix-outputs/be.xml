# 위탁 발주서 수정이 허용될 경우 위탁발주서 주소지는 수정 불가: 수정허용할 경우, 도서산간지역 추가요금 이슈가 발생하므로 관련된 부분 점검 필요
class PurchaseOrderLineUpdate(ModelMutation):
    class Arguments:
        purchase_order_id = graphene.ID(required=True, description="The ID of the purchase order.")
        id = graphene.ID(required=True, description="The ID of the purchase order line.")
        input = PurchaseOrderLineUpdateInput(
            required=True, description="발주서 발주제품 변경 입력 필드"
        )

    class Meta:
        description = "발주서 발주제품 변경"
        model = models.PurchaseOrderLine
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def clean_input(cls, info, instance: PurchaseOrderLineModel, data):
        cleaned_input = super().clean_input(info, instance, data)
        po_line: PurchaseOrderLineModel = instance
        if po_line.status not in [
            PurchaseOrderLineStatus.DRAFT,
            PurchaseOrderLineStatus.REJECTED,
        ]:
            raise ValidationError("작성 중 또는 거부된 발주 품목만 수정할 수 있습니다.")

        need_recalc_vat_amount = False
        quantity = cleaned_input.get("quantity")
        if quantity is None:
            quantity = po_line.quantity
        else:
            need_recalc_vat_amount = True
        etc_exclude_vat = cleaned_input.get("etc_exclude_vat")
        if etc_exclude_vat is None:
            etc_exclude_vat = po_line.etc_exclude_vat
        else:
            need_recalc_vat_amount = True

        b2b_delivery_fee_exclude_vat = cleaned_input.get("b2b_delivery_fee_exclude_vat")
        if b2b_delivery_fee_exclude_vat is None:
            b2b_delivery_fee_exclude_vat = po_line.b2b_delivery_fee_exclude_vat
        else:
            need_recalc_vat_amount = True

        if need_recalc_vat_amount:
            cost_price_exclude_vat = po_line.cost_price_exclude_vat
            is_tax_free = po_line.is_tax_free
            vat_amount = calc_po_line_vat_amount(
                quantity,
                cost_price_exclude_vat,
                etc_exclude_vat,
                po_line.take_back_unit_cost_delivery_fee_exclude_vat,
                b2b_delivery_fee_exclude_vat,
                is_tax_free,
            )
            cleaned_input["vat_amount"] = vat_amount
        return cleaned_input

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, purchase_order_id, **data):
        purchase_order: PurchaseOrderModel = cls.get_node_or_error(
            info, purchase_order_id, only_type=PurchaseOrder, field="purchase_order_id"
        )
        if purchase_order.is_b2b == False and (
            purchase_order.is_consignment_po or purchase_order.is_consignment_take_back_po
        ):
            raise ValidationError("위탁발주서, 위탁반품 발주서는 수정할 수 없습니다.")
        return super().perform_mutation(root, info, **data)


class PurchaseOrderLineBulkUpdateInput(graphene.InputObjectType):
    id = graphene.ID(required=True, description="PO Line ID")
    input = PurchaseOrderLineUpdateInput(
        required=True, description="Fields required to update a purchase order line."
    )


class PurchaseOrderLineBulkUpdate(BaseMutation):
    purchase_order = graphene.Field(
        PurchaseOrder, description="The purchase order with updated lines."
    )

    class Arguments:
        purchase_order_id = graphene.ID(required=True, description="The ID of the purchase order.")
        input = graphene.List(
            graphene.NonNull(PurchaseOrderLineBulkUpdateInput),
            required=True,
        )

    class Meta:
        description = "Updates purchase order lines."
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, purchase_order_id, input):

        validate_data_is_non_null(input)
        validate_duplicate(input, lambda x: x.get("id"))

        purchase_order_errors = []
        savepoint = transaction.savepoint()

        for input_item in input:
            id = input_item.get("id")
            input = input_item.get("input")
            response = PurchaseOrderLineUpdate.mutate(
                _root,
                info,
                purchase_order_id=purchase_order_id,
                id=id,
                input=input,
            )
            if response.purchase_order_errors:
                tmp_purchase_order_errors = [
                    PurchaseOrderError(
                        field=error.field,
                        message=f"{input_item.get('id')}(ID) : {error.message}",
                        code=error.code,
                    )
                    for error in response.purchase_order_errors
                ]
                purchase_order_errors.extend(tmp_purchase_order_errors)

        purchase_order = cls.get_node_or_error(
            info, purchase_order_id, only_type=PurchaseOrder, field="purchase_order_id"
        )

        if purchase_order_errors:
            purchase_order = None
            transaction.savepoint_rollback(savepoint)

        return PurchaseOrderLineBulkUpdate(
            purchase_order=purchase_order, purchase_order_errors=purchase_order_errors
        )


class PurchaseOrderLineDelete(ModelDeleteMutation):
    purchase_order = graphene.Field(PurchaseOrder, description="품목 삭제 대상 발주서")

    class Arguments:
        purchase_order_id = graphene.ID(required=True, description="The ID of the purchase order.")
        line_id = graphene.ID(required=True, description="ID of the purchase order line to delete.")

    class Meta:
        description = "Deletes a purchase order line from the existing purchase order."
        model = models.PurchaseOrderLine
        permissions = (PurchaseOrderPermissions.MANAGE_PURCHASE_ORDER,)
        error_type_class = PurchaseOrderError
        error_type_field = "purchase_order_errors"

    @classmethod
    def validate_purchase_order(cls, purchase_order: PurchaseOrderModel):
        if purchase_order.is_sent:
            raise ValidationError("대기 상태의 발주서에서만 발주제품을 삭제할 수 있습니다.")
        if purchase_order.is_b2b == False and (
            purchase_order.is_take_back_po or purchase_order.is_consignment_take_back_po
        ):
            raise ValidationError("반품 발주서에서 발주제품 삭제는 허용되지 않습니다.")

    @classmethod
    def perform_mutation(cls, _root, info, purchase_order_id, line_id):
        purchase_order: PurchaseOrderModel = cls.get_node_or_error(
            info, purchase_order_id, only_type=PurchaseOrder, field="purchase_order_id"
        )
        cls.validate_purchase_order(purchase_order)

        line = cls.get_node_or_error(info, line_id, only_type=PurchaseOrderLine, field="line_id")

        if line and line in purchase_order.lines.all():
            line.delete()

        return PurchaseOrderLineDelete(purchase_order=purchase_order)


