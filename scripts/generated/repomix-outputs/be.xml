    @classmethod
    def confirm_change_price(cls, instance):
        details = models.ReserveChangePriceDetails.objects.filter(base_info=instance)
        timezone_now = timezone.now()

        logger.info(f"confirm_change_price details count: {len(details)}")
        for detail in details:
            variant = detail.product_variant
            product = variant.product
            try:
                brand = detail.brand
                region = detail.region
                is_direct_shipping = product.is_direct_shipping
                if is_direct_shipping:
                    if brand is None:
                        update_object = models.ProductVariantRegion.objects.get(
                            product_variant=variant, region=region
                        )
                    else:
                        brand_product_variant = models.BrandProductVariant.objects.get(
                            brand=brand, product_variant=variant
                        )
                        update_object = models.BrandProductVariantRegion.objects.get(
                            brand_product_variant=brand_product_variant, region=region
                        )
                else:
                    if brand is None:
                        update_object = models.ProductVariant.objects.get(pk=variant.pk)
                    else:
                        update_object = models.BrandProductVariant.objects.get(
                            brand=brand, product_variant=variant
                        )

                update_object.change_price_amount = detail.price_amount
                update_object.change_cost_price_amount = detail.cost_price_amount
                update_object.change_delivery_fee_amount = detail.delivery_fee_amount
                update_object.change_price_confirmed_date = instance.reserved
                update_object.save(
                    update_fields=[
                        "change_price_amount",
                        "change_cost_price_amount",
                        "change_delivery_fee_amount",
                        "change_price_confirmed_date",
                    ]
                )

                detail.is_confirmed = True
                detail.confirmed = timezone_now
                detail.save(update_fields=["is_confirmed", "confirmed"])
            except ObjectDoesNotExist:
                pass

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        instance = cls.get_instance(info, **data)
        if instance is None:
            raise ValidationError(
                "이미 취소된 상태입니다. 새로고침으로 정보를 갱신해 주세요.",
                code=ProductErrorCode.INVALID.value,
            )
        if instance.is_confirmable() == False:
            raise ValidationError(
                "이미 반영되었거나 확정 상태입니다. 새로고침으로 정보를 갱신해 주세요.",
                code=ProductErrorCode.INVALID.value,
            )
        cls.confirm_change_price(instance)

        return super().perform_mutation(_root, info, **data)
