from decimal import Decimal
from enum import Enum as PyEnum

from django.db import models

STOCK_DETAIL_CODE_PREFIX = "ST"
EXP_DATE_WARNING_THRESHOLD = 60  # days


class StockDetailEvents:
    PURCHASE = "purchase"
    ETC_PURCHASE = "etc_purchase"
    TAKE_BACK = "take_back"
    LOSS = "loss"
    FULFILLMENT = "fulfillment"
    FULFILLMENT_CANCEL = "fulfillment_cancel"
    DIVIDE = "divide"
    COMBINE = "combine"
    MOVE = "move"
    ADJUST_TO_ZERO = "adjust_to_zero"

    # Used mostly for importing legacy data from before Enum-based events
    OTHER = "other"

    CHOICES = [
        (PURCHASE, "매입"),
        (ETC_PURCHASE, "기타 입고"),
        (TAKE_BACK, "반품 발주"),
        (LOSS, "로스 처리"),
        (FULFILLMENT, "출고"),
        (FULFILLMENT_CANCEL, "출고 취소"),
        (DIVIDE, "소분"),
        (COMBINE, "결합"),
        (MOVE, "이동"),
        (ADJUST_TO_ZERO, "부자재 음수 재고 조정"),
