    def save(self, *args, **kwargs):
        validate_is_fbv(self)
        validate_is_dev_variant(self)

        super().save(*args, **kwargs)

    @property
    def bundle_info_qty(self):
        if self.bundle_qty:
            return int(self.quantity / self.bundle_qty)
        return 1

    @property
    def is_b2b_cancelable(self):
        if self.b2b_status in [OrderLineB2bStatus.PENDING, OrderLineB2bStatus.REJECTED]:
            return True
        if self.b2b_status == OrderLineB2bStatus.RECEIVED:
            if self.purchase_order_line_id is None:
                return True
            if self.purchase_order_line.status == PurchaseOrderLineStatus.CANCELED:
                return True
        return False

    @property
    def composed_id(self):
        return "%s-S%s" % (self.order_id, str(self.sub_id).zfill(3))

    @property
    def is_b2b_order(self):
        # order.type 으로 판단할 경우 order 를 prefetch 해야 하므로, b2b_status 로 판단
        return self.b2b_status != OrderLineB2bStatus.NA

    @property
    def composed_id_with_prefix(self):
        prefix = B2B_ORDER_PREFIX if self.is_b2b_order else NON_B2B_ORDER_PREFIX
        return f"{prefix}{self.composed_id}"

    def __str__(self):
        return self.get_variant_name()

    def get_sub_ids_queryset(self):
        return self.order.lines.all()

    def get_variant_name(self):
        variant_name = self.variant_name if self.variant_name != self.product_sku else ""
        return f"{self.product_name} ({variant_name})" if variant_name else self.product_name

    def get_only_variant_name(self):
        variant_name = self.variant_name if self.variant_name != self.product_sku else ""
        return variant_name

    @property
    def acc_return_delivery_fee_amount(self):
        return get_acc_return_delivery_fee_amount_of_order_line(self)

    @property
    def quantity_refundable(self):
        return max(0, get_ordered_or_fulfill_qty(self) - self.quantity_refunded)

    @property
    def quantity_unfulfilled(self):
        return max(
            0, get_ordered_or_fulfill_qty(self) - self.quantity_fulfilled - self.quantity_refunded
        )

    @property
    def is_mixed_track_inventory(self):
        # fulfillment_lines의 track_inventory가 True, False가 섞여있는 경우 True 반환
        track_inventory_values = set(
            self.fulfillment_lines.values_list("track_inventory", flat=True)
        )
        return len(track_inventory_values) > 1

    @property
    def need_delivery_additional_fee(self) -> bool:
        bp_bundle: BpBundle = self.bp_bundle
        if bp_bundle:
            return bp_bundle.need_delivery_additional_fee
        variant: ProductVariant = self.variant
        bpv: BrandProductVariant = self.brand_product_variant
        need_delivery_additional_fee_from_bpv = bpv.need_delivery_additional_fee if bpv else True
        return variant.need_delivery_additional_fee and need_delivery_additional_fee_from_bpv


