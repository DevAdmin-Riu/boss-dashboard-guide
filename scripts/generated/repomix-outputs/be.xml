class ProductBulkCreate(BaseMutation):
    products = graphene.List(Product)

    class Arguments:
        input = ProductBulkCreateInput(required=True, description="제품 일괄 생성 입력")

    class Meta:
        description = "Creates multiple products."
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    def make_detail_code(cls, detail):
        name = detail.get("name")
        return f"({name})"

    @classmethod
    def validate_category_kind(cls, details):
        category_nums = {detail.get("category_num") for detail in details}

        has_invalid_kind = (
            models.Category.objects.filter(num__in=category_nums)
            .exclude(kind=CategoryKind.STANDARD)  # CategoryKind.STANDARD 값으로 비교
            .exists()
        )

        if has_invalid_kind:
            raise ValidationError(
                "일괄 생성으로 충전금 제품이나 개발비 제품 카테고리 지정은 불가능합니다."
            )

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, **data):
        # input에서 List를 꺼낸다.
        products_input = data.get("input")
        is_fulfilled_by_vendor = products_input.get("is_fulfilled_by_vendor")
        details = products_input.get("details")
        makers = validate_maker(cls, details, required=True)

        products = []
        product_errors = []
        savepoint = transaction.savepoint()

        for product_input in details:
            try:
                # ProductCreate의 mutate를 call 할수 있도록 데이터를 재구성한다.
                product_data = product_input

                # is_fulfilled_by_vendor데이터를 넣는다.
                product_data["is_fulfilled_by_vendor"] = is_fulfilled_by_vendor
                # cateogory_num으로 category global_id를 만든다.
                category_num = product_input.pop("category_num")
                category_global_id = graphene.Node.to_global_id("Category", category_num)

                product_data["category"] = category_global_id
                # product_type_num으로 product_type global_id를 만든다.
                product_type_num = product_input.pop("product_type_num")
                product_type_global_id = graphene.Node.to_global_id("ProductType", product_type_num)
                product_data["product_type"] = product_type_global_id

                product_type: models.ProductType = graphene.Node.get_node_from_global_id(
                    info, product_type_global_id, only_type=ProductType
                )
                attributes_slug = product_data.pop("attributes_slug")

                (
                    product_attributes_cleaned_input,
                    variant_attributes_cleaned_input,
                    slug_errors,
                    value_errors,
                ) = AttributeAssignmentMixin.clean_input_for_variant_bulk_update(
                    attributes_slug, product_type
                )
                # 옵션형은 고려안하므로 variant_attributes_cleaned_input은 무시한다.
                attributes = [
                    {"id": graphene.Node.to_global_id("Attribute", item[0].id), "values": item[1]}
                    for item in product_attributes_cleaned_input
                ]
                product_data["attributes"] = attributes

                product_info_notification_template_name = product_input.pop(
                    "product_info_notification_template_name", None
                )
                if product_info_notification_template_name:
                    # product_info_notification_template_name를 이용해서 ProductInfoNotiMetaDataTemplate table에서 node를 가지고 온다.
                    product_info_notification_template = (
                        ProductInfoNotiMetaDataTemplate.objects.get(
                            name=product_info_notification_template_name
                        ).template
                    )
                    product_data["product_info_notification"] = product_info_notification_template

                maker_name = product_input.pop("maker_name")
                maker = makers.get(maker_name)
                product_data["maker"] = (
                    graphene.Node.to_global_id("Maker", maker.pk) if maker else None
                )

                response = ProductCreate.mutate(_root, info, input=product_data)
                if response.product:
                    products.append(response.product)
                if response.product_errors:
                    # message 앞에 product_input["name"]를 붙여서 어떤 제품에서 에러가 발생했는지 알수 있도록 한다.
                    tmp_product_errors = [
                        ProductError(
                            field=error.field,
                            message=f"{product_input.get('name')}(제품명) : {error.message}",
                            code=error.code,
                        )
                        for error in response.product_errors
                    ]
                    product_errors.extend(tmp_product_errors)
            except Exception as e:
                product_errors.append(
                    ProductError(
                        field="product",
                        message=f"{product_input.get('name')}(제품명) : {e}",
                        code=ProductErrorCode.INVALID,
                    )
                )

        # product_errors가 존재하는경우 rollback하고 products는 비워줌.
        if product_errors:
            products = []
            transaction.savepoint_rollback(savepoint)

        return cls(products=products, product_errors=product_errors)
