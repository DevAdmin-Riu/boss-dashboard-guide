def calc_stock_status_by_est_shortage_days(
    est_shortage_days: Decimal,
) -> StockStatusByEstShortage:
    if est_shortage_days is None:
        return StockStatusByEstShortage.NONE

    if est_shortage_days < StockStatusThresholdPyEnum.NORMAL.value:
        return StockStatusByEstShortage.NORMAL

    if est_shortage_days < StockStatusThresholdPyEnum.SLOW_CYCLE.value:
        return StockStatusByEstShortage.SLOW_CYCLE

    if est_shortage_days < StockStatusThresholdPyEnum.WARNING.value:
        return StockStatusByEstShortage.WARNING

    return StockStatusByEstShortage.CRITICAL


def _set_est_shortage_date(
    variant: "ProductVariant", est_shortage_info: EstShortageInfoDataClass
) -> EstShortageInfoDataClass:
    if est_shortage_info.need_to_reorder_period is not None and variant.po_lead_time is not None:
        delta_days = floor(est_shortage_info.need_to_reorder_period) - variant.po_lead_time
        est_shortage_info.need_to_reorder_date = kst_timezone_date() + timedelta(days=delta_days)
    if est_shortage_info.est_shortage_period is not None:
        est_shortage_info.est_shortage_date = kst_timezone_date() + timedelta(
            days=floor(est_shortage_info.est_shortage_period)
        )
    if est_shortage_info.est_shortage_period_incl_long_term_qty is not None:
        est_shortage_info.est_shortage_date_incl_long_term_qty = kst_timezone_date() + timedelta(
            days=floor(est_shortage_info.est_shortage_period_incl_long_term_qty)
        )
    return est_shortage_info


def get_latest_stocked_po_line(variant: "ProductVariant"):
    latest_stocked_po_line = (
        PurchaseOrderLine.objects.filter(
            variant=variant,
            status__in=ALREADY_STOCKED_STATUSES,
        )
        .order_by("-purchase_date")
        .first()
    )
    return latest_stocked_po_line


def _set_stock_status_by_daily(
    est_shortage_info: EstShortageInfoDataClass, stock_status_by_realtime: StockStatusByEstShortage
):
    # 자동으로 daily 악성재고 상태 변경할 때는 현재 상태보다 나쁜 방향으로 변경 시에만 변경
    est_shortage_info.stock_status_by_realtime = stock_status_by_realtime
    if stock_status_by_realtime == StockStatusByEstShortage.CRITICAL:
        est_shortage_info.stock_status_by_daily = stock_status_by_realtime
    elif stock_status_by_realtime == StockStatusByEstShortage.WARNING:
        if est_shortage_info.stock_status_by_daily not in [StockStatusByEstShortage.CRITICAL]:
            est_shortage_info.stock_status_by_daily = stock_status_by_realtime
    elif stock_status_by_realtime == StockStatusByEstShortage.SLOW_CYCLE:
        if est_shortage_info.stock_status_by_daily not in [
            StockStatusByEstShortage.WARNING,
            StockStatusByEstShortage.CRITICAL,
        ]:
            est_shortage_info.stock_status_by_daily = stock_status_by_realtime
    elif stock_status_by_realtime == StockStatusByEstShortage.NORMAL:
        if est_shortage_info.stock_status_by_daily not in [
            StockStatusByEstShortage.SLOW_CYCLE,
            StockStatusByEstShortage.WARNING,
            StockStatusByEstShortage.CRITICAL,
        ]:
            est_shortage_info.stock_status_by_daily = stock_status_by_realtime


def calc_est_shortage_info_by_values(
    variant: "ProductVariant",
    total_stock_qty,
    latest_stocked_po_line: Optional[PurchaseOrderLine] = None,
    detail_info_mode=False,
    qty_to_be_stocked_long_term=None,
    orderable_qty_incl_long_term=None,
) -> EstShortageInfoDataClass:
    est_shortage_info = EstShortageInfoDataClass()
    est_shortage_info.stock_status_by_daily = variant.stock_status_by_daily
    if total_stock_qty is None or total_stock_qty <= 0:
        if total_stock_qty <= 0:
            _set_stock_status_by_daily(est_shortage_info, StockStatusByEstShortage.NORMAL)
        return est_shortage_info

    avg_sales_daily_qty_consider_inner = get_avg_sales_combined_qty_consider_inner(
        variant, "last_30_days_avg_sales_daily_qty"
    )
    # 최근 30일 일평균이 0인경우, 최근 3개월 일평균으로 예상소진기간, 재발주예정기간 계산
    if avg_sales_daily_qty_consider_inner is None or avg_sales_daily_qty_consider_inner <= 0:
        avg_sales_daily_qty_consider_inner = get_avg_sales_combined_qty_consider_inner(
            variant, "last_3_months_avg_sales_daily_qty"
        )

    # 최근입고일로 부터 90일 이내인 경우 stock_status는 무조건 정상인걸로 한다.
    if latest_stocked_po_line is None:
        latest_stocked_po_line = get_latest_stocked_po_line(variant)
    not_yet_check_stock_status = (
        latest_stocked_po_line is not None
        and latest_stocked_po_line.purchase_date is not None
        and latest_stocked_po_line.purchase_date > kst_timezone_date() - timedelta(days=90)
    )
    if not_yet_check_stock_status:
        _set_stock_status_by_daily(est_shortage_info, StockStatusByEstShortage.NORMAL)

    if avg_sales_daily_qty_consider_inner is None or avg_sales_daily_qty_consider_inner <= 0:
        if not not_yet_check_stock_status:
            _set_stock_status_by_daily(est_shortage_info, StockStatusByEstShortage.CRITICAL)

    # 제품 상태가 정상, 단종예정인 것 예상소진일 및 악성재고 상태 판단
    elif variant.sales_status in [SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED]:
        est_shortage_info.est_shortage_period = my_round(
            total_stock_qty / avg_sales_daily_qty_consider_inner, 1
        )
        if not not_yet_check_stock_status:
            stock_status_by_realtime = calc_stock_status_by_est_shortage_days(
                est_shortage_info.est_shortage_period
            )
            _set_stock_status_by_daily(est_shortage_info, stock_status_by_realtime)

        # qty_to_be_stocked_long_term, orderable_qty_incl_long_term 값은 detail_info_mode 가 True 인 경우 호출단에서 loader 또는 prefetched 방식으로 계산된 값을 전달해야 함
        if detail_info_mode and variant.sales_status in [SalesStatus.ON_SALE]:
            if qty_to_be_stocked_long_term is not None:
                if qty_to_be_stocked_long_term > 0:
                    est_shortage_info.est_shortage_period_incl_long_term_qty = my_round(
                        (total_stock_qty + qty_to_be_stocked_long_term)
                        / avg_sales_daily_qty_consider_inner,
                        1,
                    )
            safety_stock_qty = variant.safety_stock_qty
            if orderable_qty_incl_long_term is not None and safety_stock_qty is not None:
                need_to_reorder_qty = orderable_qty_incl_long_term - safety_stock_qty
                if need_to_reorder_qty < 0:
                    need_to_reorder_qty = 0
                est_shortage_info.need_to_reorder_period = my_round(
                    (need_to_reorder_qty) / avg_sales_daily_qty_consider_inner,
                    1,
                )
    est_shortage_info = _set_est_shortage_date(variant, est_shortage_info)
    return est_shortage_info


def get_total_stock_qty_to_outer_base_qty_consider_inner(variant: "ProductVariant"):
    if variant.is_inner:
        outer_pv = variant.outer
        inner_pv = variant
    else:
        outer_pv = variant
        inner_pv = variant.inner

    outer_result = outer_pv.stocks.aggregate(total_quantity=Coalesce(Sum("quantity"), 0))
    outer_qty = outer_result.get("total_quantity")
    converted_inner_qty_to_outer_base = 0
    if inner_pv is not None:
        pack_count = calc_pack_count(inner_pv, outer_pv)
        if pack_count > 0:
            inner_result = inner_pv.stocks.aggregate(total_quantity=Coalesce(Sum("quantity"), 0))
            inner_qty = inner_result.get("total_quantity")
            converted_inner_qty_to_outer_base = my_round(inner_qty / pack_count, 2)
    return outer_qty + converted_inner_qty_to_outer_base


def get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data(
    pv: "ProductVariant",
):
    prefetched_stocks = getattr(pv, "prefetched_stocks", [])
    if pv.is_inner:
        outer_pv = pv.outer
        inner_pv = pv
        outer_prefetched_stocks = getattr(pv, "prefetched_outer_stocks", [])
        inner_prefetched_stocks = prefetched_stocks
    else:
        outer_pv = pv
        inner_pv = pv.inner
        outer_prefetched_stocks = prefetched_stocks
        inner_prefetched_stocks = getattr(pv, "prefetched_inner_stocks", [])
    outer_qty = get_total_stocks_qty_by_prefetched_data(outer_prefetched_stocks)
    converted_inner_qty_to_outer_base = 0
    if inner_pv is not None:
        pack_count = calc_pack_count(inner_pv, outer_pv)
        if pack_count > 0:
            inner_qty = get_total_stocks_qty_by_prefetched_data(inner_prefetched_stocks)
            converted_inner_qty_to_outer_base = my_round(inner_qty / pack_count, 2)
    return outer_qty + converted_inner_qty_to_outer_base


def calc_est_shortage_info(
    *,
    variant: "ProductVariant",
    total_stock_qty=None,
    latest_stocked_po_line=None,
    detail_info_mode=False,
    qty_to_be_stocked_long_term=None,
    orderable_qty_incl_long_term=None,
) -> EstShortageInfoDataClass:
    est_shortage_info = EstShortageInfoDataClass()
    if variant is None:
        return est_shortage_info

    is_inner = variant.is_inner
    if is_inner:
        outer_pv: ProductVariant = variant.outer
        if outer_pv.track_inventory or not variant.can_sale_by_inner:
            est_shortage_info.is_na = True
            return est_shortage_info
    else:
        if not variant.track_inventory:
            est_shortage_info.is_na = True
            return est_shortage_info

    if total_stock_qty is None:
        total_stock_qty = get_total_stock_qty_to_outer_base_qty_consider_inner(variant)

    return calc_est_shortage_info_by_values(
        variant=variant,
        total_stock_qty=total_stock_qty,
        latest_stocked_po_line=latest_stocked_po_line,
        detail_info_mode=detail_info_mode,
        qty_to_be_stocked_long_term=qty_to_be_stocked_long_term,
        orderable_qty_incl_long_term=orderable_qty_incl_long_term,
    )


def reset_variant_is_safety_status(variant: "ProductVariant"):
    update_flag = False
    alarm_flag = False
    prev_status = variant.is_safety

    if variant.safety_stock_qty is None:
        return False, False, Decimal(0)
    orderable_qty_incl_short_term = (
        get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
            variant, until_short_term=True
        )
    )
    variant.is_safety = orderable_qty_incl_short_term >= variant.safety_stock_qty
    update_flag = prev_status != variant.is_safety
    alarm_flag = prev_status == True and variant.is_safety == False
    return update_flag, alarm_flag, orderable_qty_incl_short_term


def reset_variant_need_to_reorder_status(variant: "ProductVariant"):
    update_flag = False
    alarm_flag = False
    prev_status_7 = variant.need_to_reorder_7
    prev_status_15 = variant.need_to_reorder_15
    prev_status_30 = variant.need_to_reorder_30

    orderable_qty_incl_long_term = (
        get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
            variant, until_short_term=False
        )
    )
    if variant.rop_7 is not None:
        variant.need_to_reorder_7 = orderable_qty_incl_long_term < variant.rop_7
    if variant.rop_15 is not None:
        variant.need_to_reorder_15 = orderable_qty_incl_long_term < variant.rop_15
    if variant.rop_30 is not None:
        variant.need_to_reorder_30 = orderable_qty_incl_long_term < variant.rop_30

    update_flag = (
        prev_status_7 != variant.need_to_reorder_7
        or prev_status_15 != variant.need_to_reorder_15
        or prev_status_30 != variant.need_to_reorder_30
    )
    alarm_flag = (
        (prev_status_7 == False and variant.need_to_reorder_7 == True)
        or (prev_status_15 == False and variant.need_to_reorder_15 == True)
        or (prev_status_30 == False and variant.need_to_reorder_30 == True)
    )
    return update_flag, alarm_flag, orderable_qty_incl_long_term
