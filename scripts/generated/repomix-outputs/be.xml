import logging
from datetime import datetime
from typing import TYPE_CHECKING, Union

from django.core.exceptions import ValidationError

from ....order import OrderEvents
from ....order.events import pg_refund_event
from ....plugins.manager import get_plugins_manager
from ... import PgRefundEventStatus, models
from .define import TOSS_GATEWAY_PLUGIN_ID
from .interface import TossCardRefundData, TossRefundResponse, TossVbankRefundData
from .utils import call_toss_payment_cancel_api, change_toss_plugin_configs

if TYPE_CHECKING:
    from ....account.models import User
    from ....order.models import Order
    from ...models import Payment, PgRefundEvent, Transaction

logger = logging.getLogger(__name__)


# https://docs.tosspayments.com/reference#%EA%B2%B0%EC%A0%9C-%EC%B7%A8%EC%86%8C
def process_toss_refund(
    order: "Order",
    payment: "Payment",
    refund_transaction: "Transaction",
    staff_user: "User",
    pg_refund_data: Union[TossCardRefundData, TossVbankRefundData],
) -> TossRefundResponse:
    price = pg_refund_data.refund_amount
    if price <= 0:
        return None

    brand = order.brand if order.brand else None
    plugin_configs = get_plugins_manager().get_plugin_config_dot_map(TOSS_GATEWAY_PLUGIN_ID)
    plugin_configs = change_toss_plugin_configs(plugin_configs, brand)
    if not plugin_configs:
        if brand and brand.is_reverse_fee_contract_type:
            raise ValidationError("매출인식 브랜드의 토스 PG 정보를 확인 후 다시 시도해 주세요.")
        else:
            raise ValidationError("토스 플러그인 정보를 확인 후 다시 시도해 주세요.")

    order_event_params = {
        "refund_amount": price,
        "remain_refundable_amount": pg_refund_data.remain_refundable_amount,
        "refund_reason": pg_refund_data.refund_reason,
        "payment_key": pg_refund_data.payment_key,
        "refund_tax_free_amount": pg_refund_data.refund_tax_free_amount,
        "pay_method": pg_refund_data.pg_refund_pay_method.name,
    }
    if payment.is_vbank_pay():
        pg_refund_bank_info = pg_refund_data.pg_refund_bank_info
        if pg_refund_bank_info is None or pg_refund_bank_info.bank_code is None:
            logger.error(f"refund_debug: {pg_refund_bank_info}")
            raise ValidationError("환불 은행 정보 오류로 환불을 진행할 수 없습니다.")
        order_event_params.update(
            {
                "bank_code": pg_refund_bank_info.bank_code,
                "account_number": pg_refund_bank_info.account_number,
                "account_holder_name": pg_refund_bank_info.account_holder_name,
            }
        )
    pg_refund_event_status = PgRefundEventStatus.REQUESTED
    order_event_params["status"] = pg_refund_event_status.name
    pg_refund_event_obj: PgRefundEvent = models.PgRefundEvent.objects.create(
        pay_method=pg_refund_data.pg_refund_pay_method,
        status=pg_refund_event_status,
        order=order,
        payment=payment,
        transaction=refund_transaction,
        user=staff_user,
        request_parameters=order_event_params,
        refund_amount=price,
        before_captured_amount=price + pg_refund_data.remain_refundable_amount,
        after_captured_amount=pg_refund_data.remain_refundable_amount,
    )
    pg_refund_event(
        order=order, type=OrderEvents.TOSS_REFUND, staff_user=staff_user, params=order_event_params
    )

    cancel_success, gateway_response, system_failed_message = call_toss_payment_cancel_api(
        payment.is_toss_riu_pay, plugin_configs, pg_refund_data, is_refund_mode=True
    )

    if not cancel_success:
        logger.error(
            f"payment_debug: call_toss_payment_cancel_api cancel_fail {payment.id} {pg_refund_data} {system_failed_message} {gateway_response}"
        )
        error_msg = gateway_response.get("message") if gateway_response else system_failed_message
        pg_refund_event_status = PgRefundEventStatus.FAIL
        order_event_params["status"] = pg_refund_event_status.name
        order_event_params["resultMsg"] = f"PG (부분) 결제 취소 실패: {error_msg}"
        pg_refund_event(
            order=order,
            type=OrderEvents.TOSS_REFUND,
            staff_user=staff_user,
            params=order_event_params,
        )
        raise ValidationError(f"토스 결제 환불 처리에 실패했습니다. {error_msg}")

    logger.info(
        f"payment_debug: call_toss_payment_cancel_api cancel_success {payment.id} {pg_refund_data} {system_failed_message} {gateway_response}"
    )

    refund_transaction.gateway_response = gateway_response
    refund_transaction.save(update_fields=["gateway_response"])

    pg_refund_event_status = PgRefundEventStatus.SUCCESS
    order_event_params["status"] = pg_refund_event_status.name
    order_event_params["resultMsg"] = "PG (부분) 결제 취소 성공"
    pg_refund_event(
        order=order,
        type=OrderEvents.TOSS_REFUND,
        staff_user=staff_user,
        params=order_event_params,
    )

    pg_refund_event_obj.response_parameters = gateway_response
    pg_refund_event_obj.status = pg_refund_event_status
    pg_refund_event_obj.save(update_fields=["status", "response_parameters"])

    refund_transaction.gateway_response = gateway_response
    refund_transaction.save(update_fields=["gateway_response"])

    cancels = gateway_response.get("cancels")
    latest_cancel = max(cancels, key=lambda x: datetime.fromisoformat(x["canceledAt"]))

    return TossRefundResponse(
        transactionKey=latest_cancel.get("transactionKey"),
        canceledAt=datetime.fromisoformat(latest_cancel.get("canceledAt")),
    )
