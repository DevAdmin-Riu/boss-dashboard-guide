                first_sku = first_rack_stock_detail.product_variant.sku
                set_count = invalid_rack_stock_details_count - 1
                error_msg = f"{first_sku} 외 {set_count}개의 제품의 로케이션 재고 정보에 stock_detail 오류입니다."
            else:
                sku_list = ", ".join(
                    rack_stock_detail.product_variant.sku
                    for rack_stock_detail in invalid_rack_stock_details
                )
                error_msg = f"로케이션 재고 상제 재고 오류 제품: {sku_list}"
