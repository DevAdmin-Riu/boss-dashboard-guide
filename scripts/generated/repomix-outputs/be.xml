def validate_po_lines(
    details,
) -> Tuple[Dict[str, "PurchaseOrderLineModel"], List["PurchaseOrderLineModel"]]:
    po_line_global_ids = [d["po_line_id"] for d in details if d.get("po_line_id")]
    db_ids = [from_global_id_strict_type(gid, PurchaseOrderLine) for gid in po_line_global_ids]
    po_lines_qs = models.PurchaseOrderLine.objects.select_related("purchase_order").filter(
        id__in=db_ids
    )
    po_lines_by_db_id = {str(po_line.id): po_line for po_line in po_lines_qs}
    # mutation 로직에서 global_id 를 키로 사용하는 것이 편리하므로 global_id 를 키로 사용한 dict 생성
    po_line_dict: Dict[str, "PurchaseOrderLineModel"] = {}
    errors = []
    for gid, db_id in zip(po_line_global_ids, db_ids):
        po_line = po_lines_by_db_id.get(db_id)
        if po_line:
            po_line_dict[gid] = po_line
        else:
            errors.append(gid)
    if errors:
        raise ValidationError(f"발주 제품 아이디 오류: {', '.join(errors)}")
    # 입력 순서대로 po_line 객체 리스트
    po_lines = [po_line_dict[gid] for gid in po_line_global_ids]
    return po_line_dict, po_lines


