class BrandAddProductWithInfo(BaseMutation):
    brand = graphene.Field(Brand, description="브랜드.")

    class Arguments:
        brand_id = graphene.Argument(
            graphene.ID, required=True, description="ID of a franchise brand."
        )
        is_fulfilled_by_vendor = graphene.Boolean(
            required=True, description="협력사가 출고하는 제품(직거래 상품) 여부"
        )
        product_id = graphene.ID(required=True, description="ID of a product.")
        brand_product_info = BrandAddProductWithInfoBPInput(
            required=True, description="Product 이름, 전용여부"
        )
        brand_product_variants_info = graphene.List(
            graphene.NonNull(BrandAddProductWithInfoBPVInput),
            description="Fields required to create bp/bpv for a franchise brand",
            required=True,
        )

    class Meta:
        description = "assign products to brand"
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(
        cls,
        _root,
        info,
        brand_id,
        is_fulfilled_by_vendor,
        product_id,
        brand_product_info,
        brand_product_variants_info,
    ):
        brand: BrandModel = cls.get_node_or_error(info, brand_id, field="brand_id", only_type=Brand)
        if brand is None:
            raise ValidationError("brand_id 오류", code=ProductErrorCode.INVALID)

        product_instance: ProductModel = cls.get_node_or_error(
            info, product_id, "product", only_type=Product
        )

        BrandAddProducts.validate_fulfilled_by_vendor(
            brand, is_fulfilled_by_vendor, [product_instance]
        )

        # NOTE 직배송 고려안함.

        brand.products.add(product_instance)

        brand_product = brand.brand_products.select_related("product").get(
            product_id=product_instance.pk
        )
        brand_product.name = normalize_newlines_to_space(brand_product_info.get("name"))
        brand_product.is_exclusive = brand_product_info.get("is_exclusive")
        is_rcoin_reward_for_using_point = brand_product_info.get("is_rcoin_reward_for_using_point")
        if is_rcoin_reward_for_using_point is not None:
            brand_product.is_rcoin_reward_for_using_point = is_rcoin_reward_for_using_point
        brand_product.save()

        for brand_product_variant_info in brand_product_variants_info:
            product_variant: ProductVariantModel = cls.get_node_or_error(
                info,
                brand_product_variant_info.get("product_variant_id"),
                "product_variant",
                only_type=ProductVariant,
            )

            if models.BrandProductVariant.objects.filter(
                brand=brand, brand_product=brand_product, product_variant=product_variant
            ).exists():
                raise ValidationError("브랜드에 이미 연결된 제품입니다.")

            sales_status = (
                SalesStatus.ON_SALE
                if product_variant.sales_status == SalesStatus.ON_SALE
                else SalesStatus.STOPPED
            )
            if sales_status == SalesStatus.STOPPED:
