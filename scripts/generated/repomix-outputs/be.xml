from typing import Iterable, List

import graphene
from django.conf import settings
from django.core.exceptions import ValidationError

from ...account.models import User as UserModel
from ...checkout.base_calculations import checkout_line_unit_price
from ...checkout.error_codes import CheckoutErrorCode
from ...checkout.models import Checkout, CheckoutLine
from ...core.exceptions import InsufficientStock
from ...order import OrderDeliveryMethods, OrderType
from ...product.models import BpBundle, ProductVariant
from ...product.utils.brand_products_variant import get_user_product_variant
from ...warehouse.availability import check_stock_quantity_by_contury, get_orderable_qty
from ..product.types import BrandProductVariant

ERROR_DOES_NOT_SHIP = "This checkout doesn't need shipping"


def validate_deferred_pv(
    checkout: "Checkout",
    lines: List["CheckoutLine"],
):
    errors = []
    for line in lines:
        variant: "ProductVariant" = line.variant
        if variant and variant.is_deferred:
            # 후정산 제품과 세트 상품은 무관
            unit_price = checkout_line_unit_price(checkout, line)
            unit_price_vat = checkout_line_unit_price(checkout, line)
            if unit_price != 0 or unit_price_vat != 0:
                errors.append(variant.sku)
    if errors:
        error_msg = f"후정산 제품의 판매가 또는 판매 부가세가 0이 아닙니다. ({', '.join(errors)})"
        raise ValidationError(error_msg)


def check_line_quantity(
    pv: "ProductVariant",
    bp_bundle: "BpBundle",
    checkout_line_qty,
    country,
    order_type,
    bp_name,
    delivery_method,
    decrease_stock_flag,
):
    if checkout_line_qty <= 0:
        raise ValidationError("주문 수량은 0보다 큰 숫자만 가능합니다.")
    settings.MAX_CHECKOUT_LINE_QUANTITY = settings.MAX_CHECKOUT_LINE_QUANTITY
    # 가맹본부 대행 주문 인 경우에도 주문 수량 제한 안 함
    if order_type == OrderType.BY_USER and checkout_line_qty > settings.MAX_CHECKOUT_LINE_QUANTITY:
        raise ValidationError(
            "한 번에 주문 가능한 최대 수량은 %d개 입니다." % settings.MAX_CHECKOUT_LINE_QUANTITY
        )

    # 기타 배송인 경우 주문 된 상품을 모아서 배송 처리하는 건이라서 재고제품도 재고 수가 부족 에러 체크 안하는 것이 운영 상 편하다는 정책 적용
    if delivery_method != OrderDeliveryMethods.BY_COURIER:
        return
    if decrease_stock_flag == False:
        return

    pv_list = []
    pv_qty_list = []
    if bp_bundle:
        bp_bundle_infos = bp_bundle.bp_bunde_infos_by_prefetched
        pv_list = [info.pv for info in bp_bundle_infos]
        pv_qty_list = [info.quantity * checkout_line_qty for info in bp_bundle_infos]
    else:
        pv_list = [pv]
        pv_qty_list = [checkout_line_qty]

    for pv, pv_qty in zip(pv_list, pv_qty_list):
        try:
            check_stock_quantity_by_contury(pv, country, pv_qty, bp_name=bp_name)
        except InsufficientStock as e:
            orderable_quantity = get_orderable_qty(e.item, country, until_short_term=True)
            message = "" + "%(item_name)s 의 재고가 부족합니다. %(remaining)d 개의 재고가 남아있습니다.(입고 예정 수량 포함)" % {
                "remaining": orderable_quantity,
                "item_name": e.item.display_product(bp_name=e.bp_name),
            }
            raise ValidationError(message)


def check_lines_quantity(
    pvs_by_input_sequence,
    bp_bundles_by_input_sequence,
    quantities,
    country,
    order_type,
    bp_name_list=[],
    delivery_method=OrderDeliveryMethods.BY_COURIER,
    decrease_stock_flags=[],
):
    variants_length = len(pvs_by_input_sequence)
    bp_name_list = bp_name_list or [None] * variants_length
    decrease_stock_flags = decrease_stock_flags or [True] * variants_length

    for variant, bp_bundle, quantity, bp_name, decrease_stock_flag in zip(
        pvs_by_input_sequence,
        bp_bundles_by_input_sequence,
        quantities,
        bp_name_list,
        decrease_stock_flags,
    ):
        check_line_quantity(
            variant,
            bp_bundle,
            quantity,
            country,
            order_type=order_type,
            bp_name=bp_name,
            delivery_method=delivery_method,
            decrease_stock_flag=decrease_stock_flag,
        )


def validate_bp_bundles_on_sale(
    bp_bundles: Iterable["BpBundle"],
    user: "UserModel",
):
    # user 가 존재하는 보스몰 주문,  대행 주문인 경우에만 단종, 판매중단 체크를 한다.
    if user is None:
        return

    stopped_variants = []
    for bp_bundle in bp_bundles:
        all_pvs = list(bp_bundle.pvs.all())
        stopped_pvs = [pv for pv in all_pvs if pv.is_stopped]
        stopped_variants.extend(stopped_pvs)
    if stopped_variants:
        stopped_variant_ids = [
            graphene.Node.to_global_id("ProductVariant", pk) for pk in stopped_variants
        ]
        raise ValidationError(
            {
                "lines": ValidationError(
                    "구성품이 단종된 세트 상품이 존재합니다.",
                    code=CheckoutErrorCode.STOPPED_PRODUCT,
                    params={"variants": stopped_variant_ids},
                )
            }
        )


def validate_variants_on_sale(
    variants: Iterable["ProductVariant"],
    user: "UserModel",
    pvs_by_input_sequence: Iterable["ProductVariant"],
    bpvs_by_input_sequence: Iterable["BrandProductVariant"] = None,
):
    # user 가 존재하는 보스몰 주문,  대행 주문인 경우에만 단종, 판매중단 체크를 한다.
    if user is None:
        return

    stopped_variants = [variant.pk for variant in variants if variant.is_stopped]
    if stopped_variants:
        stopped_variant_ids = [
            graphene.Node.to_global_id("ProductVariant", pk) for pk in stopped_variants
        ]
        raise ValidationError(
            {
                "lines": ValidationError(
                    "단종된 상품이 구매 목록에 포함되어 있습니다.",
                    code=CheckoutErrorCode.STOPPED_PRODUCT,
                    params={"variants": stopped_variant_ids},
                )
            }
        )

    # bpvs_by_input_sequence None이면 빈 리스트로 설정
    if bpvs_by_input_sequence is None:
        bpvs_by_input_sequence = []

    invalid_variant_ids = []
    # zip 대신 itertools.zip_longest를 사용하여 두 iterable의 길이 차이를 처리
    from itertools import zip_longest

    for variant, bpv in zip_longest(pvs_by_input_sequence, bpvs_by_input_sequence):
        if not variant:
            continue
        if bpv:
            user_product_variant = bpv
        else:
            # 대행 주문에서는 아래와 같이 use_brand_instead_of_switched_brand 값을 true로 한다.(대행 주문 유저가 switched_brand가 brand와 다른 가능성 고려)
            user_product_variant = get_user_product_variant(
                variant, user, raise_exception=True, use_brand_instead_of_switched_brand=True
            )
        if user_product_variant.is_stopped:
            invalid_variant_ids.append(variant.pk)
    if invalid_variant_ids:
        raise ValidationError(
            {
                "lines": ValidationError(
                    "판매 중단된 상품이 구매 목록에 포함되어 있습니다.",
                    code=CheckoutErrorCode.STOPPED_PRODUCT,
                    params={"variants": invalid_variant_ids},
                )
            }
        )
