class BsOpsCheckReport(models.Model):
    template = models.ForeignKey(
        BsOpsCheckTemplate,
        on_delete=models.CASCADE,
        related_name="reports",
    )
    brand_store = models.ForeignKey(
        "brand_store.BrandStore",
        on_delete=models.CASCADE,
        related_name="ops_check_reports",
    )
    title = models.CharField(max_length=255, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)
    submitted_at = models.DateTimeField(null=True, blank=True)
    submit_user = models.ForeignKey(
        "account.User",
        on_delete=models.SET_NULL,
        blank=True,
        null=True,
        related_name="+",
    )

    @property
    def is_submitted(self):
        return self.submitted_at is not None

    def clean(self):
        super().clean()

        # 제출 상태로 바뀌는 경우만 체크
        if self.pk:
            old = BsOpsCheckReport.objects.get(pk=self.pk)
            was_submitted = old.submitted_at is not None
        else:
            was_submitted = False

        will_be_submitted = self.submitted_at is not None

        if not was_submitted and will_be_submitted:
            required_items = BsOpsCheckTemplateCategoryItem.objects.filter(
                category__template=self.template, category__level=1
            ).values_list("id", "title")

            existing_items = BsOpsCheckReportItem.objects.filter(report=self).values_list(
                "category_item_id", flat=True
            )

            # 누락된 항목 추출
            missing_items = [
                (item_id, title)
                for item_id, title in required_items
                if item_id not in existing_items
            ]

            if missing_items:
                title_list = ", ".join(title for _, title in missing_items)
                raise ValidationError(f"제출 전에 모든 항목에 대한 답변이 필요합니다: {title_list}")

    def save(self, *args, **kwargs):
        info = getattr(self, "_info", None)

        if not self.pk:
            today_str = kst_timezone_now().strftime("%Y-%m-%d")
            self.title = f"{self.template.title} {self.brand_store.name} {today_str}"

        if self.pk and info:
            # 수정 중인 경우
            old = BsOpsCheckReport.objects.filter(pk=self.pk).first()
            was_submitted = old and old.submitted_at is not None
            will_be_submitted = self.submitted_at is not None

            if not was_submitted and will_be_submitted:
                self.submit_user = info.context.user

            if was_submitted:
                raise ValidationError("제출된 보고서는 수정할 수 없습니다.")

        super().save(*args, **kwargs)

    objects = BsOpsCheckReportQueryset.as_manager()

    class Meta:
        ordering = ["-pk"]


