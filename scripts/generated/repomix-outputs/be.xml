from typing import List, Optional

from ..account.models import User
from . import PurchaseOrderManageEventType
from .models import PurchaseOrder, PurchaseOrderManageEvent


def purchase_order_manage_note_added_event(
    *, purchase_order: PurchaseOrder, user: Optional[User], message: str
) -> PurchaseOrderManageEvent:
    return PurchaseOrderManageEvent.objects.create(
        purchase_order=purchase_order,
        user=user,
        type=PurchaseOrderManageEventType.NOTE_ADDED,
        parameters={"message": message},
    )


def add_po_manage_event(
    *,
    purchase_order: PurchaseOrder,
    user: Optional[User],
    type: PurchaseOrderManageEventType,
    parameters: Optional[dict] = {}
) -> PurchaseOrderManageEvent:
    return PurchaseOrderManageEvent.objects.create(
        purchase_order=purchase_order,
        user=user,
        type=type,
        parameters=parameters,
    )


def bulk_add_po_manage_event(
    po_list: List["PurchaseOrder"],
    user: Optional[User],
    type: PurchaseOrderManageEventType,
    parameters: Optional[dict] = {},
):
    po_manage_event_list = []
    for po in po_list:
        po_manage_event = PurchaseOrderManageEvent(
            purchase_order=po,
            user=user,
            type=type,
            parameters=parameters,
        )
        po_manage_event_list.append(po_manage_event)
    if po_manage_event_list:
        PurchaseOrderManageEvent.objects.bulk_create(po_manage_event_list)
