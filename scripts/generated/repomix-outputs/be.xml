                    expected_purchase_date__gte=value.get("gte"),
                    expected_purchase_date__lte=value.get("lte"),
                )
            )
        )
        qs = qs.filter(need_to_stock_exists=True)
        return qs

    def filter_brand_ids(qs, _, value):
