def remove_all_non_numeric(a):
    if a:
        return re.sub(r"[^0-9]", "", a)
    return a


def normalize_newlines_to_space(a):
    if a:
        return re.sub(r"[\r\n]+", " ", a)
    return a


def check_exact_digit_length(str, length):
    if not str:
        return False
    pattern_format = "\\d{{{length}}}"
    pattern = pattern_format.format(length=length)
    expected = re.compile(pattern)
    return re.fullmatch(expected, str)
