    stock: "Stock", user: "User", reason: str, before_quantity: int, after_quantity: int
):
    parameters = {
        "before_quantity": before_quantity,
        "after_quantity": after_quantity,
        "reason": reason if reason else "",
    }

    event_type = StockDetailEvents.ADJUST_TO_ZERO
    events.create_stock_detail_event(
        type=event_type,
        stock=stock,
        user=user,
        parameters=parameters,
        stocked_date=timezone.now(),
    )

    type_desc = next(
        description for value, description in StockDetailEvents.CHOICES if value == event_type
    )

    email_context = {
        "sku": stock.product_variant.sku,
        "product_name": stock.product_variant.product.name,
        "type_desc": type_desc,
        "date_time": to_kst_timezone_format(),
        "staff": get_name_with_phone_number(user),
        "before_quantity": to_locale_number(before_quantity),
        "after_quantity": to_locale_number(after_quantity),
        "reason": reason if reason else "",
    }
    send_templated_mail_notify_stock_adjust_to_zero(email_context)


