class Last3MonthAvgSalesDailyQtyByBrandIdAndPvIdLoader(DataLoader):
    context_key = "last_3_month_avg_sales_daily_qty_by_brand_and_pv"

    def batch_load(self, keys):
        brand_id = keys[0][0]  # 동일 브랜드로만 호출된다고 가정
        pv_ids = [key[1] for key in keys]

        duration_days = 90.0
        today = kst_timezone_date()
        end_datetime = to_datetime_astimezone(today, end_of_day=False)
        start_datetime = end_datetime - timedelta(days=int(duration_days))
        qs = StatsBrandQueries.sales_qs_exclude_canceled()
        # sales 에 보스장터 거래는 두번 기록되어 판매량 집계시 보스장터 건은 제외해야 함
        qs = StatsBrandQueries.filter_sales_exclude_boss_mrkt(qs)
        sales = (
            qs.filter(
                brand_id=brand_id,
                variant_id__in=pv_ids,
                evented_at__gte=start_datetime,
                evented_at__lt=end_datetime,
            )
            .values("variant_id")
            .annotate(
                total_qty=Coalesce(Sum("quantity"), 0),
            )
            .annotate(
                avg_qty=ExpressionWrapper(
                    F("total_qty") / Value(duration_days),
                    output_field=DecimalField(),
                )
            )
            .order_by("variant_id")
        )
        sales_map = {sale["variant_id"]: sale["avg_qty"] for sale in sales}
        return [my_round(Decimal(sales_map.get(pv_id, 0)), 2) for _, pv_id in keys]


