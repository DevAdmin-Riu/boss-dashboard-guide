        # 결제 내역을 받아 last_payment를 선택하는 함수
        def get_last_payment(payments):
            if len(payments) == 0:
                return None
            return payments[0]

        # 최종 결과를 처리하는 함수
        def handle_result(results):
            last_payment, fulfillments = results

            # last_payment가 없으면 False를 반환
            if not last_payment:
                return False

            # last_payment의 상태를 검사하여 캡처된 히스토리가 있는지 확인
            exist_captured_history = last_payment.charge_status in [
                ChargeStatus.PARTIALLY_CHARGED,
                ChargeStatus.FULLY_CHARGED,
                ChargeStatus.PARTIALLY_REFUNDED,
                ChargeStatus.FULLY_REFUNDED,
            ]
            if not exist_captured_history:
                return False

            is_any_fulfillment_on_going = any(
                fulfillment.status not in [FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]
                for fulfillment in fulfillments
            )

            return not is_any_fulfillment_on_going and root.status not in {OrderStatus.CANCELED}

        # PaymentsByOrderIdLoader로 last_payment를 로드하고 선택
        payment_promise = PaymentsByOrderIdLoader(info.context).load(root.id).then(get_last_payment)

        # FulfillmentsByOrderIdLoader를 사용해 fulfillments 목록을 로드
        fulfillments_promise = FulfillmentsByOrderIdLoader(info.context).load(root.id)

        # Promise.all을 사용해 비동기적으로 데이터를 로드한 후 handle_result로 결과 처리
        return Promise.all([payment_promise, fulfillments_promise]).then(handle_result)

