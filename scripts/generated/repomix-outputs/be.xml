class CheckoutNoteUpdate(BaseMutation, I18nMixin):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        checkout_id = graphene.ID(required=True, description="ID of the checkout.")
        note = graphene.String(required=True, description="A note for the checkout.")

    class Meta:
        description = "Update note in the existing checkout."
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @classmethod
    def perform_mutation(cls, _root, info, checkout_id, note):
        pk = from_global_id_strict_type(checkout_id, Checkout, field="checkout_id")
        try:
            checkout = models.Checkout.objects.get(pk=pk)
        except ObjectDoesNotExist:
            raise ValidationError(
                {
                    "checkout_id": ValidationError(
                        f"Couldn't resolve to a node: {checkout_id}",
                        code=CheckoutErrorCode.NOT_FOUND,
                    )
                }
            )
        if checkout.note != note:
            checkout.note = note
            checkout.save(update_fields=["note", "last_change"])
            info.context.plugins.checkout_updated(checkout)
        return CheckoutNoteUpdate(checkout=checkout)


# ExtendedCheckoutComplete 내부 호출 용도로만 사용: 프론트엔드에서 단독 호출 금지
class CheckoutShippingAddressUpdate(BaseMutation, I18nMixin):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        checkout_id = graphene.ID(required=True, description="ID of the checkout.")
        shipping_address = AddressInput(
            required=True,
            description="The mailing address to where the checkout will be shipped.",
        )

    class Meta:
        description = "Update shipping address in the existing checkout."
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    # 직배송 상품이 존재하는 경우에 배송지 주소가 직배송 가능인지 체크
    @classmethod
    def validate_direct_shipping_address(cls, lines, shipping_address: Address) -> None:
        direct_shipping_variants = [
            line.variant
            for line in lines
            if line.variant and line.variant.product.is_direct_shipping == True
        ]

        if direct_shipping_variants is None or len(direct_shipping_variants) <= 0:
            return

        if shipping_address.is_direct_shipping == False:
            raise ValidationError("직배송상품 배송가능한 배송지가 아닙니다.")

        if (
            shipping_address.direct_shipping_code is None
            or not shipping_address.direct_shipping_code
        ):
            raise ValidationError("직배송상품 배송지 코드가 입력되지 않았습니다.")

        if shipping_address.direct_shipping_days is None:
            raise ValidationError("직배송상품 배송가능 요일이 입력되지 않았습니다.")

        if (
            shipping_address.direct_shipping_days.get("monday", False) == False
            and shipping_address.direct_shipping_days.get("tuesday", False) == False
            and shipping_address.direct_shipping_days.get("wednesday", False) == False
            and shipping_address.direct_shipping_days.get("thursday", False) == False
            and shipping_address.direct_shipping_days.get("friday", False) == False
            and shipping_address.direct_shipping_days.get("saturday", False) == False
            and shipping_address.direct_shipping_days.get("sunday", False) == False
        ):
            raise ValidationError("직배송 가능한 요일이 설정되지 않았습니다.")

    @classmethod
    def perform_mutation(cls, _root, info, checkout_id, shipping_address):
        pk = from_global_id_strict_type(checkout_id, Checkout, field="checkout_id")

        try:
            checkout = models.Checkout.objects.prefetch_related(
                "lines__variant__product__product_type"
            ).get(pk=pk)
        except ObjectDoesNotExist:
            raise ValidationError(
                {
                    "checkout_id": ValidationError(
                        f"Couldn't resolve to a node: {checkout_id}",
                        code=CheckoutErrorCode.NOT_FOUND,
                    )
                }
            )

        shipping_address = cls.validate_address(
            shipping_address, instance=checkout.shipping_address, info=info
        )

        lines = checkout.get_selected_lines()

        country = info.context.country.code
        # set country to one from shipping address
        if shipping_address and shipping_address.country:
            if shipping_address.country != country:
                country = shipping_address.country
        checkout.set_country(country, commit=True)

        # Resolve and process the lines, validating variants quantities
        if lines:
            cls.validate_direct_shipping_address(lines, shipping_address=shipping_address)

        with transaction.atomic():
            shipping_address.save()
            change_shipping_address_in_checkout(checkout, shipping_address)
        info.context.plugins.checkout_updated(checkout)
        return CheckoutShippingAddressUpdate(checkout=checkout)


class CheckoutDeliveryRequestDateUpdate(BaseMutation, I18nMixin):
    checkout = graphene.Field(Checkout, description="An updated checkout.")

    class Arguments:
        checkout_id = graphene.ID(required=True, description="ID of the checkout.")
        delivery_request_date = graphene.Date(
            description="직배송 날짜. ISO 8601 standard. (YYYY-MM-DD)"
        )

    class Meta:
        description = "Update direct shipping date in the existing checkout."
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    # 직배송 상품이 존재하는 경우에 날짜가 입력안되면 에러 처리
    @classmethod
    def validate_ds_delivery_request_date(cls, lines, delivery_request_date, info) -> None:
        direct_shipping_variants = [
            line.variant for line in lines if line.variant.product.is_direct_shipping == True
        ]

        # 직배송 상품이 없는 경우 아무런 체크도 안하고, checkout delivery_request_date 도 기본값으로 채워지도록 아무 처리 없이 리턴함
        if len(direct_shipping_variants) <= 0:
            return

        if delivery_request_date is None:
            raise ValidationError("직배송상품 도착일이 입력되지 않았습니다.")

        user: UserModel = info.context.user
        brand = user.brand

        if user.is_brand_user == False or brand.is_direct_shipping == False:
            raise ValidationError(
                "브랜드 회원이 아니거나 직배송 상품을 취급하지 않는 브랜드의 매장은 직배송 상품을 구매할 수 없습니다."
            )

        today = kst_timezone_date()
        if delivery_request_date <= today:
            raise ValidationError("직배송상품 도착일이 주문 당일 이전으로는 주문할 수 없습니다.")

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        checkout_id = data.get("checkout_id")
        delivery_request_date = data.get("delivery_request_date")
        pk = from_global_id_strict_type(checkout_id, Checkout, field="checkout_id")
        try:
            checkout = models.Checkout.objects.prefetch_related("lines__variant__product").get(
                pk=pk
            )
        except ObjectDoesNotExist:
            raise ValidationError(
                {
                    "checkout_id": ValidationError(
                        f"Couldn't resolve to a node: {checkout_id}",
                        code=CheckoutErrorCode.NOT_FOUND,
                    )
                }
            )

        lines = checkout.get_selected_lines()

        if lines:
            # 보스 상품 장바구니 에서 직배송 상품이 라인에 있는 경우에만 직배송 도착일 validation 체크
            if checkout.is_fulfilled_by_vendor == False:
                cls.validate_ds_delivery_request_date(lines, delivery_request_date, info=info)

            if checkout.delivery_request_date != delivery_request_date:
                checkout.delivery_request_date = delivery_request_date
                checkout.save(update_fields=["delivery_request_date", "last_change"])
                info.context.plugins.checkout_updated(checkout)

        return CheckoutDeliveryRequestDateUpdate(checkout=checkout)


# ExtendedCheckoutComplete 내부 호출 용도로만 사용: 프론트엔드에서 단독 호출 금지
class CheckoutComplete(BaseMutation):
    order = graphene.Field(Order, description="Placed order.")
    error_message = graphene.String(description="에러 발생한 경우 에러 메시지")

    class Arguments:
        checkout_id = graphene.ID(description="Checkout ID.", required=True)

    class Meta:
        description = "Completes the checkout."
        error_type_class = CheckoutError
        error_type_field = "checkout_errors"

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, _root, info, checkout_id, **data):
        logger.info(f"payment_debug: checkout.CheckoutComplete mutation {checkout_id}")
        try:
            checkout: CheckoutModel = cls.get_node_or_error(
                info,
                checkout_id,
                only_type=Checkout,
                field="checkout_id",
                qs=models.Checkout.objects.select_for_update(of=("self",)).prefetch_related(
                    "lines__variant__product",
                    Prefetch(
                        "payments",
                        queryset=payment_models.Payment.objects.prefetch_related("order__lines"),
                    ),
                ),
            )
        except ValidationError as e:
            # 요청온 checkout이 Checkout 테이블에서 제거된 상태면 결제가 처리된 것으로 판단
            # 그 checkout 에 대응되는 order 생성 유무로 결제성공 / 중복 결제 시도 로 판단
            checkout_token = from_global_id_strict_type(checkout_id, Checkout, field="checkout_id")

            order = order_models.Order.objects.get_by_checkout_token(checkout_token)
            if order:
                error_message = None
                log_message = "결제 성공"
            else:
                error_message = (
                    "중복 결제 시도인 것 같습니다. 페이지를 새로고침 후 구매내역을 확인해 보세요."
                )
                log_message = error_message

            logger.info(
                f"payment_debug: checkout.CheckoutComplete mutation {checkout_id} {log_message} order={order} ===== payment finish!!!"
            )
            return CheckoutComplete(order=order, error_message=error_message)

        # 이니시스 결제 연동이 아닌 경우 (포인트+적립금 전액 결제 or 대행 주문)인 경우에는 아래 루틴에서 처리됨
        payment = checkout.get_last_active_payment()
        order: Optional[Order] = payment.order if payment else None
        is_order_by_staff = checkout.order_type != OrderType.BY_USER
        is_payment_without_pg = is_order_by_staff or (
            payment
            and (
                payment.is_deferred_pay()
                or (
                    payment.amount <= 0
                    and (payment.credits_incl_non_cashable > 0 or payment.rcoins > 0)
                )
            )
        )

        if is_payment_without_pg:
            success_msg = "주문이 완료되었습니다."
            is_order_by_hq_staff = checkout.order_type == OrderType.BY_HQ_STAFF_FOR_BRAND
            if is_order_by_hq_staff:
                pay_method = RIU_PAY_METHOD_POINTS_ONLY
            elif is_order_by_staff or payment.is_deferred_pay():
                pay_method = RIU_PAY_METHOD_DEFERRED
            else:
                pay_method = RIU_PAY_METHOD_POINTS_ONLY
            is_success, success_msg, failed_msg, order = process_auth_completed(
                checkout=checkout,
                payment=payment,
                pay_method=pay_method,
                gateway_response={},
                success_msg=success_msg,
                is_mobile=None,
                creator_user=info.context.user,
            )
            if not is_success:
                error_message = (
                    "대행 주문 결제 처리 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다."
                    if is_order_by_staff
                    else "포인트+충전금 결제 처리 과정에서 오류가 발생해서 주문이 정상적으로 처리되지 않았습니다."
                )
                # 유저에 의한 주문인 경우에 failed transaction 생성
                if checkout.order_type == OrderType.BY_USER:
                    create_payment_failed_transaction(
                        payment=payment,
                        type=PaymentFailedType.SYSTEM_FAILED,
                        message=error_message,
                        parameters={
                            "payment_id": payment.id,
                            "pay_method": pay_method,
                        },
                    )
                logger.error(f"{failed_msg}")
                return CheckoutComplete(order=order, error_message=error_message)

        # 결제 실패 케이스에서 결제 실패 사유를 PAYMENT_FAILD transaction 이 존재하면 그 에러 메시지로 리턴 처리함
        if payment is None or order is None:
            error_message = "결제가 취소되었습니다."
            try:
                payment_failed_txn = payment_models.Transaction.objects.filter(
                    payment=payment, kind=TransactionKind.PAYMENT_FAILED
                ).last()
                if payment_failed_txn:
                    gateway_response = payment_failed_txn.gateway_response
                    error_message = gateway_response.get("message")
            except:
                pass
            log_message = error_message
        else:
            error_message = None
            log_message = "결제 성공"

        logger.info(
            f"payment_debug: checkout.CheckoutComplete mutation {checkout_id} {log_message} payment={payment} order={order} ===== payment finish!!!"
        )

        # If gateway returns information that additional steps are required we need
        # to inform the frontend and pass all required data
        return CheckoutComplete(order=order, error_message=error_message)


