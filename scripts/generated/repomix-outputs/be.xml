    def validate_status(cls, purchase_order_lines: List[PurchaseOrderLineModel]):
        invalid_po_lines = [
            line
            for line in purchase_order_lines
            if line.status not in [PurchaseOrderLineStatus.DELIVERY_CONFIRMED]
        ]
        if invalid_po_lines:
            invalid_codes = ", ".join([line.code for line in invalid_po_lines])
            raise ValidationError(
                f"거래명세서 출력 상태로 변경할 수 없는 상태의 발주 품목이 존재합니다. {invalid_codes}"
            )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, purchase_order_line_ids):
        user: "User" = info.context.user
        purchase_order_lines: List[PurchaseOrderLineModel] = cls.get_nodes_or_error(
            purchase_order_line_ids, "purchase_order_line_ids", PurchaseOrderLine
        )
        cls.validate_po_type(purchase_order_lines)
        cls.validate_status(purchase_order_lines)
        cls.validate_vender(user, purchase_order_lines)

        dev_pv_lines = []
        not_dev_track_inventory_inspect_pv_lines = []
        not_dev_track_inventory_not_inspect_pv_lines = []
        not_track_inventory_pv_lines = []
        for po_line in purchase_order_lines:
            if po_line.purchase_order.is_track_inventory_po:
                # 재고 발주이면서 개발비 제품인 경우
                if po_line.variant.is_dev_pv:
                    dev_pv_lines.append(po_line)
                elif po_line.variant.need_to_inspect:
                    not_dev_track_inventory_inspect_pv_lines.append(po_line)
                else:
                    not_dev_track_inventory_not_inspect_pv_lines.append(po_line)
            # 재고 발주가 아닌 경우
            else:
                not_track_inventory_pv_lines.append(po_line)

        dev_lines_by_po = defaultdict(list)
        for line in dev_pv_lines:
            dev_lines_by_po[line.purchase_order].append(line)

        # 2. 각 발주서 그룹에 대해 PurchaseOrderStockLinesAdd 뮤테이션을 실행합니다.
        for purchase_order, lines in dev_lines_by_po.items():
            # 2-1. 뮤테이션에 필요한 입력(input) 데이터를 구성합니다.
            input_lines = [
                {
                    "line_id": graphene.Node.to_global_id("PurchaseOrderLine", line.pk),
                    "quantity": 1,  # 개발비 제품은 입고 수량이 1. 주문할때도 무조건 1(OrderLine Save에서 강제함.)
                }
                for line in lines
            ]
            mutation_input = {
                "stocked_date": kst_timezone_date(),
                "lines": input_lines,
            }

            # 2-2. PurchaseOrderStockLinesAdd.perform_mutation을 직접 호출합니다.
            PurchaseOrderStockLinesAdd.perform_mutation(
                _root,
                info,
                purchase_order_id=graphene.Node.to_global_id("PurchaseOrder", purchase_order.pk),
                input=mutation_input,
            )

        def _process_lines(lines_to_process, after_status):
            if not lines_to_process:
                return

            ids_to_update = [line.pk for line in lines_to_process]

            # 한 번의 쿼리로 상태 업데이트
            models.PurchaseOrderLine.objects.filter(pk__in=ids_to_update).update(
                status=after_status
            )

            # 이벤트 및 히스토리 기록
            add_po_manage_event_with_type(user, lines_to_process, after_status)
            bulk_create_po_line_status_histories(
                lines_to_process,
                before_status=PurchaseOrderLineStatus.DELIVERY_CONFIRMED,
                after_status=after_status,
                user=user,
            )

        _process_lines(
            not_dev_track_inventory_inspect_pv_lines, PurchaseOrderLineStatus.TO_BE_INSPECTED
        )
        _process_lines(
            not_dev_track_inventory_not_inspect_pv_lines, PurchaseOrderLineStatus.INSPECTED
        )
        _process_lines(not_track_inventory_pv_lines, PurchaseOrderLineStatus.INVOICE_PRINTED)

        b2b_order_lines = [
            line.order_line for line in purchase_order_lines if line.purchase_order.is_b2b == True
        ]
        update_sales_b2b_invoice_printed_at(b2b_order_lines)

        return PurchaseOrderLinesInvoicePrint(purchase_order_lines=purchase_order_lines)


