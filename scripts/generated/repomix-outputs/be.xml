def get_order_country(order: "Order") -> str:
    """Return country to which order will be shipped."""
    address = order.shipping_address
    if address is None:
        return settings.DEFAULT_COUNTRY
    return address.country.code


def get_order_status_depending_on_fulfillments(order: "Order"):
    quantity_fulfilled_or_refunded = order.quantity_fulfilled + order.quantity_refunded
    total_quantity = order.get_total_ordered_or_fulfill_qty()

    if quantity_fulfilled_or_refunded <= 0:
        status = OrderStatus.UNFULFILLED
    elif quantity_fulfilled_or_refunded < total_quantity:
        status = OrderStatus.PARTIALLY_FULFILLED
    else:
        status = OrderStatus.FULFILLED
    return status


def update_order_status(order: "Order"):
    """Update order status depending on fulfillments."""
    status = get_order_status_depending_on_fulfillments(order)
    if status != order.status:
        order.status = status
        order.save(update_fields=["status"])


def restock_fulfillment_lines(
    fulfillment: "Fulfillment",
    user: "User",
    warehouse: "Warehouse",
    is_refund: bool,
    rack_location: "RackLocation",
):
    """Return fulfilled products to corresponding stocks.

    Return products to stocks and update order lines quantity fulfilled values.
    """
    from ..warehouse.management import increase_stock_using_stock_detail
    from .models import OrderLine

    order = fulfillment.order
    order_lines = []
    # 반품 출고 취소인 경우에는 재출고를 하지 않으므로 reallocate 하지 않음
    allocate = is_refund == False
    for line in fulfillment:
        fulfillment_line: FulfillmentLine = line
        order_line = fulfillment_line.order_line
        # 위탁 제품도 재고주문으로 출고된 것의 출고 취소면 재고를 증가시켜야 하므로, 재고 주문 여부로 increase_stock_using_stock_detail 처리함
        if order_line.track_inventory and order_line.decrease_stock_flag:
            increase_stock_using_stock_detail(
                user,
                order,
                fulfillment_line,
                order_line,
                warehouse,
                fulfillment_line.quantity,
                allocate=allocate,
                rack_location=rack_location,
            )
        order_line.quantity_fulfilled -= fulfillment_line.quantity
        order_lines.append(order_line)
    OrderLine.objects.bulk_update(order_lines, ["quantity_fulfilled"])


