        self.requested_ds_approval = timezone.now()
        self.save(update_fields=["requested_ds_approval"])

    # 출금 불가 충전금 우선 차감
    @transaction.atomic()
    def decrease_credits(
        self, qty: int, type: "CreditsEventType", description: str, staff, allow_minus: bool
    ):
        if qty <= 0:
            logger.error(f"decrease_credits qty is invalid: {qty}")
            return

        qty_before = self.credits_incl_non_cashable
        qty_after = qty_before - qty
        create_credits_event(
            total_before=qty_before,
            total_after=qty_after,
            qty_before=qty_before,
            qty_after=qty_after,
            qty=qty,
            type=type,
            user=self,
            staff=staff,
            description=description,
            view_mode=CreditsEventViewMode.ONLY_MALL,
            # ONLY_MALL view_mode 에서 is_cashable 은 통합금액 이벤트이므로 무의미함
            is_cashable=True,
        )

        non_cashable_decrease_qty = min(qty, self.non_cashable_credits)
        cashable_decrease_qty = qty - non_cashable_decrease_qty
        if non_cashable_decrease_qty > 0:
            self.decrease_non_cashable_credits(
                qty, type, description, staff, CreditsEventViewMode.ONLY_DASHBOARD
            )
        if cashable_decrease_qty > 0:
            self.decrease_cashable_credits(
                qty, type, description, staff, CreditsEventViewMode.ONLY_DASHBOARD, allow_minus
            )

        return (cashable_decrease_qty, non_cashable_decrease_qty)

    @transaction.atomic()
    def decrease_cashable_credits(
        self,
        qty: int,
        type: "CreditsEventType",
        description: str,
        staff,
        event_view_mode: "CreditsEventViewMode",
        allow_minus: bool,
    ):
        if qty <= 0:
            logger.error(f"decrease_cashable_credits qty is invalid: {qty}")
            return

        if self.is_brand_user and not self.is_brand_store_owner and not self.is_hq_staff:
            raise ValidationError(
                "매장 점주/점장이 아닌 경우에는 충전금을 조정할 수 없습니다.",
            )

        if not allow_minus and self.cashable_credits < qty:
            raise ValidationError("보유 충전금 보다 많은 충전금을 차감하려고 합니다.")

        qty_before = self.cashable_credits
        qty_after = self.cashable_credits - qty
        self.cashable_credits = qty_after
        User.objects.filter(pk=self.pk).update(cashable_credits=F("cashable_credits") - qty)

        create_credits_event(
            total_before=qty_before + self.non_cashable_credits,
            total_after=qty_after + self.non_cashable_credits,
            qty_before=qty_before,
            qty_after=qty_after,
            qty=qty,
            type=type,
            user=self,
            staff=staff,
            description=description,
            view_mode=event_view_mode,
            is_cashable=True,
        )

