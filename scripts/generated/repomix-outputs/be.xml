import logging
import time
from venv import logger

import requests
from requests.exceptions import RequestException, Timeout

logger = logging.getLogger(__name__)


# 호출 시 멱동성을 지원하는 서버인 경우에 headers 에 멱동키 설정한 상태에서만 사용 (예: 토스 결제 서버)
def post_with_retries(url, headers, json=None, retries=3, timeout=30):
    attempt = 0
    while attempt < retries:
        try:
            response = requests.post(
                url, json=json, headers=headers, timeout=timeout * (attempt + 1)
            )
            return response
        except Timeout:
            logger.warning(f"{url} Attempt {attempt + 1} timed out. Retrying...")
        except RequestException as e:
            logger.error(f"{url} request exception: {e}")
            raise e
        attempt += 1
        time.sleep(2)  # 재시도 전 2초 대기 (필요 시 조정 가능)
    logger.error(f"{url} failed after {retries} retries.")
    return None
