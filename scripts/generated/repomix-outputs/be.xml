class ProductVariantCreate(ModelMutation):
    class Arguments:
        input = ProductVariantCreateInput(
            required=True, description="Fields required to create a product variant."
        )

    class Meta:
        description = "Creates a new variant for a product."
        model = models.ProductVariant
        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
        error_type_class = ProductError
        error_type_field = "product_errors"
        errors_mapping = {"price_amount": "price"}

    @staticmethod
    def validate_inner_qty_per_box(
        outer_variant: ProductVariantModel, inner_variant: ProductVariantModel
    ):
        if outer_variant.can_sale_by_inner:
            # 비옵션형 제품 생성/수정 시 ProductUpdate 먼저하고 ProductVariantUpdate 를 호출하게 되는 경우,
            # ProductUpdate 로직에서 variant 를 업데이트하는 기존 로직에서 값이 없는 경우가 존재해서 일단 pass 처리함
            if outer_variant.qty_per_box is not None and inner_variant.qty_per_box is not None:
                is_multiple = is_integer_multiple(
                    outer_variant.qty_per_box, inner_variant.qty_per_box
                )
                if is_multiple is False:
                    raise ValidationError("이너박스 입수량은 아우터박스 입수량의 배수여야 합니다.")

    @classmethod
    def clean_attributes(
        cls, attributes: List[AttributeValueInput], product_type: ProductTypeModel
    ) -> List[Tuple[AttributeModel, List[str]]]:
        attributes_qs = product_type.variant_attributes
        attributes = AttributeAssignmentMixin.clean_input(attributes, attributes_qs)
        return attributes

    @classmethod
    def validate_duplicated_attribute_values(cls, attributes, used_attribute_values, instance=None):
        attribute_values = defaultdict(list)
        for attribute in attributes:
            attribute_values[attribute.id].extend(attribute.values)
        if attribute_values in used_attribute_values:
            raise ValidationError(
                "Duplicated attribute values for product variant.",
                ProductErrorCode.DUPLICATED_INPUT_ITEM,
            )
        else:
            used_attribute_values.append(attribute_values)

    @classmethod
    def clean_input_for_fbv_case(cls, instance: ProductVariantModel, cleaned_input):
        if instance.product.product_type.has_variants:
            raise ValidationError("직거래 상품은 옵션 제품을 지원하지 않습니다.")

        # 직거래 상품은 납품 시 금액확정 불가
        cleaned_input["is_adjust_price"] = False
        cleaned_input["allow_mixed_multiple_of_uoq"] = False
        cleaned_input["is_sub_pv"] = False
        cleaned_input["required_exp_date_mgmt"] = False

        return cleaned_input

    @classmethod
    def clean_input_for_normal_case(cls, instance: ProductVariantModel, cleaned_input):
        # 직거래 상품만 후불 정산 가능
        cleaned_input["is_deferred"] = False

        if instance.pk:
            can_sale_by_inner = cleaned_input.get("can_sale_by_inner", instance.can_sale_by_inner)
            ProductUpdate.validate_for_box_spec_and_qty_per_box(cleaned_input, can_sale_by_inner)
        else:
            ProductCreate.validate_for_box_spec_and_qty_per_box(cleaned_input)
        cls.validate_auto_turn_off_allow_auto_consignment(cleaned_input)
        if cls == ProductVariantCreate:
            sales_status = cleaned_input.get("sales_status")
            if sales_status is not None and sales_status not in [
                SalesStatus.PENDING,
                SalesStatus.ON_SALE,
            ]:
                raise ValidationError(
                    "제품 옵션 생성 시 제품 상태는 판매대기 또는 정상 상태만 허용됩니다."
                )
            # 제품 상태를 판매대기로 한 경우 판매 개시일을 null 처리
            cleaned_input["first_available_for_purchase"] = (
                None if sales_status == SalesStatus.PENDING else kst_timezone_date()
            )
            can_sale_by_inner = cleaned_input.get("can_sale_by_inner")
            if can_sale_by_inner:
                inner_sales_status = cleaned_input.get("inner_sales_status")
                if inner_sales_status is not None and inner_sales_status not in [
                    SalesStatus.PENDING,
                    SalesStatus.ON_SALE,
                ]:
                    raise ValidationError(
                        "제품 옵션 생성 시 이너박스 제품 상태는 판매대기 또는 정상 상태만 허용됩니다."
                    )
        else:
            ProductVariantUpdate.validate_sub_pv(instance, cleaned_input)
            sales_status = cleaned_input.get("sales_status")
            if sales_status is not None:
                # 제품 상태를 정상으로 변경할 때 판매개시일이 null 이면 현재 날짜를 판매개시일로 처리
                if (
                    instance.first_available_for_purchase is None
                    and sales_status == SalesStatus.ON_SALE
                ):
                    cleaned_input["first_available_for_purchase"] = kst_timezone_date()

        cleaned_input = ProductCreate.validate_stock_control_fields(cleaned_input)

        stocks = cleaned_input.get("stocks")
        if stocks:
            cls.check_for_duplicates_in_stocks(stocks)

        return cleaned_input

    @classmethod
    def validate_auto_turn_off_allow_auto_consignment(cls, cleaned_input):
        # '위탁 전환 종료(입고시)'(auto_turn_off_allow_auto_consignment)가 on인 상태에서 '위탁 전환 여부'(allow_auto_consignment) 또는 '재고 운영 여부'(track_inventory) off로 수정 못하도록.
        auto_turn_off_allow_auto_consignment = cleaned_input.get(
            "auto_turn_off_allow_auto_consignment"
        )
        allow_auto_consignment = cleaned_input.get("allow_auto_consignment")
        track_inventory = cleaned_input.get("track_inventory")
        if auto_turn_off_allow_auto_consignment and (
            not allow_auto_consignment or not track_inventory
        ):
            raise ValidationError(
                "위탁 전환 종료(입고시)가 설정된 상태에서 위탁 전환 여부 또는 재고 운영 여부를 변경할 수 없습니다."
            )

    @classmethod
    def common_clean_input(cls, info, instance: ProductVariantModel, data: dict, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)

        is_deferred = cleaned_input.get(
            "is_deferred", instance.is_deferred if instance.pk else False
        )

        check_show_before_price = False if is_deferred else instance.show_before_price
        check_before_price = False if is_deferred else instance.before_price_amount
        check_price = False if is_deferred else instance.price_amount

        if "show_before_price" in cleaned_input:
            check_show_before_price = (
                False if is_deferred else cleaned_input.get("show_before_price")
            )

        if "before_price" in cleaned_input:
            check_before_price = False if is_deferred else cleaned_input.pop("before_price")
            cleaned_input["before_price_amount"] = 0 if is_deferred else check_before_price

        price = 0 if is_deferred else cleaned_input.get("price")
        if price is None and instance.price is None:
            raise ValidationError(
                {
                    "price": ValidationError(
                        "Variant price is required.",
                        code=ProductErrorCode.REQUIRED.value,
                    )
                }
            )

        if "price" in cleaned_input or is_deferred:
            check_price = False if is_deferred else price
            cleaned_input["price_amount"] = price

        if check_show_before_price:
            BrandUpdateProductVariant.validate_before_price(
                price=check_price, before_price=check_before_price
            )

        if "consignment_delivery_fee" in cleaned_input or is_deferred:
            cleaned_input["consignment_delivery_fee_amount"] = (
                0 if is_deferred else cleaned_input.pop("consignment_delivery_fee")
            )

        product: ProductModel = instance.product if instance.pk else cleaned_input["product"]
        is_fulfilled_by_vendor = product.is_fulfilled_by_vendor
        product_type: ProductTypeModel = product.product_type

        used_attribute_values = get_used_variants_attribute_values(product)

        # Run the validation only if product type is configurable
        if product_type.has_variants:
            # Attributes are provided as list of `AttributeValueInput` objects.
            # We need to transform them into the format they're stored in the
            # `Product` model, which is HStore field that maps attribute's PK to
            # the value's PK.
            attributes = cleaned_input.get("attributes")
            try:
                if attributes:
                    cls.validate_duplicated_attribute_values(
                        attributes, used_attribute_values, instance
                    )
                    cleaned_input["attributes"] = cls.clean_attributes(attributes, product_type)
                elif not instance.pk:
                    # 필수 속성이 있는데도 attributes 가 없는 경우 에러 처리
                    attributes_qs = product_type.variant_attributes
                    if attributes_qs.filter(Q(value_required=True)).exists():
                        raise ValidationError(
                            "All attributes must take a value.",
                            ProductErrorCode.REQUIRED.value,
                        )
            except ValidationError as exc:
                raise ValidationError({"attributes": exc})

        if is_fulfilled_by_vendor:
            cleaned_input = cls.clean_input_for_fbv_case(instance, cleaned_input)
        else:
            cleaned_input = cls.clean_input_for_normal_case(instance, cleaned_input)

        return cleaned_input

    @classmethod
    def clean_input(cls, info, instance: ProductVariantModel, data: dict, input_cls=None):
        cleaned_input = cls.common_clean_input(info, instance, data)
        return cleaned_input

    @classmethod
    def check_for_duplicates_in_stocks(cls, stocks_data):
        warehouse_ids = [stock["warehouse"] for stock in stocks_data]
        duplicates = get_duplicated_values(warehouse_ids)
        if duplicates:
            error_msg = "Duplicated warehouse ID: {}".format(", ".join(duplicates))
            raise ValidationError(
                {"stocks": ValidationError(error_msg, code=ProductErrorCode.UNIQUE)}
            )

    @classmethod
    def get_instance(cls, info, **data):
        """Prefetch related fields that are needed to process the mutation.

        If we are updating an instance and want to update its attributes,
        # prefetch them.
        """

        object_id = data.get("id")
        if object_id and data.get("attributes"):
            # Prefetches needed by AttributeAssignmentMixin and
            # associate_attribute_values_to_instance
            qs = cls.Meta.model.objects.prefetch_related(
                "product__product_type__variant_attributes__values",
                "product__product_type__attributevariant",
            )
            return cls.get_node_or_error(info, object_id, only_type="ProductVariant", qs=qs)

        return super().get_instance(info, **data)

    @classmethod
    def save_inner_variant(cls, outer_variant: ProductVariantModel, cleaned_input):
        inner_force_sold_out_notice = cleaned_input.get("inner_force_sold_out_notice", False)
        inner_base_sell_price_exclude_vat = cleaned_input.get("inner_base_sell_price_exclude_vat")
        inner_base_sell_price_set_date = cleaned_input.get("inner_base_sell_price_set_date")
        inner_market_lowest_price_exclude_vat = cleaned_input.get(
            "inner_market_lowest_price_exclude_vat"
        )
        inner_market_lowest_price_set_date = cleaned_input.get("inner_market_lowest_price_set_date")
        inner_market_lowest_price_source = cleaned_input.get("inner_market_lowest_price_source")
        inner_qty_per_box = cleaned_input.get("inner_qty_per_box")
        inner_box_length = cleaned_input.get("inner_box_length")
        inner_box_width = cleaned_input.get("inner_box_width")
        inner_box_height = cleaned_input.get("inner_box_height")

        inner_moq = cleaned_input.get("inner_moq")
        inner_uoq = cleaned_input.get("inner_uoq")
        inner_incidental_cost = cleaned_input.get("inner_incidental_cost", Decimal(0))
        can_sale_by_inner = cleaned_input.get("can_sale_by_inner")
        inner_sales_status = cleaned_input.get("inner_sales_status", SalesStatus.ON_SALE)
        inner_stock_status_by_daily = cleaned_input.get(
            "inner_stock_status_by_daily", StockStatusByEstShortage.NONE
        )
        # 제품 상태를 판매대기로 한 경우 판매 개시일을 null 처리
        first_available_for_purchase = (
            None if inner_sales_status == SalesStatus.PENDING else kst_timezone_date()
        )

        inner_variant = models.ProductVariant.objects.create(
            product=outer_variant.product,
            can_sale_by_inner=can_sale_by_inner,
            track_inventory=True,
            is_vendor_track_inventory=False,
            allow_auto_consignment=False,
            outer=outer_variant,
            base_sell_price_exclude_vat=inner_base_sell_price_exclude_vat,
            base_sell_price_set_date=inner_base_sell_price_set_date,
            market_lowest_price_exclude_vat=inner_market_lowest_price_exclude_vat,
            market_lowest_price_set_date=inner_market_lowest_price_set_date,
            market_lowest_price_source=inner_market_lowest_price_source,
            qty_per_box=inner_qty_per_box,
            box_length=inner_box_length,
            box_width=inner_box_width,
            box_height=inner_box_height,
            inner_moq=inner_moq,
            inner_uoq=inner_uoq,
            inner_incidental_cost_amount=inner_incidental_cost,
            sales_status=inner_sales_status,
            stock_status_by_daily=inner_stock_status_by_daily,
            first_available_for_purchase=first_available_for_purchase,
            force_sold_out_notice=inner_force_sold_out_notice,
        )

        inner_stocks = cleaned_input.get("inner_stocks")
        cls.create_variant_stocks(inner_variant, inner_stocks)

        return inner_variant

    @classmethod
    def clean_input_for_inner_variant(cls, instance: ProductVariantModel, cleaned_input):
        inner_cleaned_input = deepcopy(cleaned_input)
        cleaned_input.pop("inner_stopped_reason", None)
        cleaned_input.pop("inner_stopped_reason_etc", None)
        cleaned_input.pop("inner_base_sell_price_exclude_vat", None)
        cleaned_input.pop("inner_base_sell_price_set_date", None)
        cleaned_input.pop("inner_market_lowest_price_exclude_vat", None)
        cleaned_input.pop("inner_market_lowest_price_set_date", None)
        cleaned_input.pop("inner_market_lowest_price_source", None)
        cleaned_input.pop("inner_qty_per_box", None)
        cleaned_input.pop("inner_box_length", None)
        cleaned_input.pop("inner_box_width", None)
        cleaned_input.pop("inner_box_height", None)
        cleaned_input.pop("inner_moq", None)
        cleaned_input.pop("inner_uoq", None)
        cleaned_input.pop("inner_incidental_cost", None)
        cleaned_input.pop("inner_stocks", None)
        cleaned_input.pop("inner_stock_status_by_daily", None)
        return cleaned_input, inner_cleaned_input

    @classmethod
    @transaction.atomic()
    def save(cls, info, instance: ProductVariantModel, cleaned_input):
        instance.save()
        instance = set_box_size_attribute_using_product_variant(instance)
        instance.save(update_fields=["delivery_fee_amount"])
        product = instance.product
        if not product.default_variant:
            product.default_variant = instance
            product.save(update_fields=["default_variant", "updated_at"])

        # Recalculate the "minimal variant price" for the parent product
        update_product_minimal_variant_price_task.delay(instance.product_id)
        update_product_minimal_variant_cost_price_task.delay(instance.product_id)
        update_product_minimal_variant_delivery_fee_task.delay(instance.product_id)

        stocks = cleaned_input.get("stocks")
        cls.create_variant_stocks(instance, stocks)

        attributes = cleaned_input.get("attributes")
        if attributes:
            AttributeAssignmentMixin.save(instance, attributes)
            # 생성시에는 자동 생성 사용. 수정시에는 Front에서 넘어오는 값이 저장 됨.
            if cls == ProductVariantCreate:
                instance.name = generate_name_for_variant(instance)
                instance.save(update_fields=["name"])
        info.context.plugins.product_updated(product)

    @classmethod
    def create_variant_stocks(cls, variant, stocks):
        if stocks:
            warehouse_ids = [stock["warehouse"] for stock in stocks]
            warehouses = cls.get_nodes_or_error(warehouse_ids, "warehouse", only_type=Warehouse)
            create_stocks(variant, stocks, warehouses)
        else:
            create_stock_by_first_warehouse_if_not_exist(variant)

    @classmethod
    def post_save_action(
        cls, root, info, outer_variant: ProductVariantModel, cleaned_input, inner_cleaned_input
    ):
        has_inner_variant = (
            outer_variant.product.check_has_inner_variant()
            and outer_variant.check_has_inner_variant()
        )
        if has_inner_variant:
            inner_variant = cls.save_inner_variant(outer_variant, inner_cleaned_input)
            ProductVariantCreate.validate_inner_qty_per_box(outer_variant, inner_variant)
            outer_variant.inner = inner_variant
            outer_variant.save(update_fields=["inner"])
            reset_inner_variant_cost_price(outer_variant, inner_variant)

        ProductCreate.save_default_product_variant_vendor(root, info, outer_variant, cleaned_input)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        outer_variant: ProductVariantModel = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, outer_variant, data)
        cleaned_input, inner_cleaned_input = cls.clean_input_for_inner_variant(
            outer_variant, cleaned_input
        )
        outer_variant = cls.construct_instance(info, outer_variant, cleaned_input)
        cls.clean_instance(info, outer_variant)
        cls.save(info, outer_variant, cleaned_input)
        cls._save_m2m(info, outer_variant, cleaned_input)
        cls.post_save_action(root, info, outer_variant, cleaned_input, inner_cleaned_input)
        return cls.success_response(outer_variant)


class ProductVariantUpdate(ProductVariantCreate):
    class Arguments:
        id = graphene.ID(required=True, description="ID of a product variant to update.")
        input = ProductVariantInput(
            required=True, description="Fields required to update a product variant."
        )

    class Meta:
        description = "Updates an existing variant for product."
        model = models.ProductVariant
        error_type_class = ProductError
        error_type_field = "product_errors"
        errors_mapping = {"price_amount": "price"}

    @classmethod
    def validate_duplicated_attribute_values(cls, attributes, used_attribute_values, instance=None):
        # Check if the variant is getting updated,
        # and the assigned attributes do not change
        if instance.product_id is not None:
            assigned_attributes = get_used_attribute_values_for_variant(instance)
            input_attribute_values = defaultdict(list)
            for attribute in attributes:
                input_attribute_values[attribute.id].extend(attribute.values)
            if input_attribute_values == assigned_attributes:
                return
        # if assigned attributes is getting updated run duplicated attribute validation
        super().validate_duplicated_attribute_values(attributes, used_attribute_values)

    @staticmethod
    def validate_sub_pv(variant: ProductVariantModel, cleaned_input):
        is_sub_pv = cleaned_input.get("is_sub_pv", variant.is_sub_pv)
        if is_sub_pv:
            if variant.sub_pv is not None:
                raise ValidationError(
                    "연결된 부자재가 존재하는 상태에서 부자재 여부를 켤 수 없습니다."
                )
        else:
            if variant.main_pvs_relation.exists():
                raise ValidationError(
                    "부자재 - 부자재 필요 제품 관계로 연결된 상태로 부자재 여부를 끌 수 없습니다."
                )
            if variant.box_specs_for_picking_order.exists():
                raise ValidationError(
                    "합포장 상자용 부자재로 설정된 상태로 부자재 여부를 끌 수 없습니다."
                )

    @staticmethod
    def validate_sales_status_by_track_inventory(
        variant: ProductVariantModel, new_status: SalesStatus, track_inventory_to_be: Optional[bool]
    ):
        if variant.product.is_fulfilled_by_vendor:
            if new_status == SalesStatus.WILL_BE_STOPPED:
                raise ValidationError(
                    "직거래 상품은 단종 예정 상태로 변경할 수 없습니다.",
                )
            return

        track_inventory_as_is = variant.track_inventory
        track_inventory_to_be = (
            track_inventory_to_be if track_inventory_to_be is not None else track_inventory_as_is
        )
        if not track_inventory_to_be:
            if new_status == SalesStatus.WILL_BE_STOPPED:
                raise ValidationError(
                    "위탁 제품은 단종 예정 상태로 변경할 수 없습니다.",
                )
            elif new_status == SalesStatus.STOPPED:
                orderable_quantity = get_orderable_qty(
                    variant, settings.DEFAULT_COUNTRY, until_short_term=False
                )
                if orderable_quantity > 0:
                    raise ValidationError(
                        "전체 입고예정 수량을 포함해서 재고가 남아있는 위탁 제품은 단종 상태로 변경할 수 없습니다.",
                    )

    @classmethod
    def get_sales_status_info_from_cleaned_input(cls, cleaned_input, is_inner: bool):
        sales_status = (
            cleaned_input.get("inner_sales_status")
            if is_inner
            else cleaned_input.get("sales_status")
        )
        stopped_reason = (
            cleaned_input.get("inner_stopped_reason")
            if is_inner
            else cleaned_input.get("stopped_reason")
        )
        stopped_reason_etc = (
            cleaned_input.get("inner_stopped_reason_etc")
            if is_inner
            else cleaned_input.get("stopped_reason_etc")
        )
        stopped_at = (
            cleaned_input.get("inner_stopped_at") if is_inner else cleaned_input.get("stopped_at")
        )

        return sales_status, stopped_reason, stopped_reason_etc, stopped_at

    @classmethod
    def validate_sales_status(cls, variant: ProductVariantModel, cleaned_input, is_inner):
        prev_sales_status = variant.sales_status
        prev_stopped_at = variant.stopped_at
        if is_inner:
            cleaned_input["inner_stopped_at"] = prev_stopped_at
        else:
            cleaned_input["stopped_at"] = prev_stopped_at
        (sales_status, stopped_reason, stopped_reason_etc, stopped_at) = (
            cls.get_sales_status_info_from_cleaned_input(cleaned_input, is_inner)
        )

        if stopped_reason == StoppedReasonType.ETC and stopped_reason_etc is None:
            raise ValidationError(
                "판매 중단 사유가 기타인 경우 판매 중단 상세 사유를 입력해 주세요.",
                code=ProductErrorCode.INVALID.value,
            )

        if prev_sales_status == sales_status:
            return

        if sales_status == SalesStatus.STOPPED:
            stopped_at = datetime.date.today()
        elif sales_status in [SalesStatus.ON_SALE, SalesStatus.WILL_BE_STOPPED]:
            stopped_at = None

        if is_inner:
            cleaned_input["inner_stopped_at"] = stopped_at
        else:
            cleaned_input["stopped_at"] = stopped_at

        track_inventory_to_be = cleaned_input.get("track_inventory")
        ProductVariantUpdate.validate_sales_status_by_track_inventory(
            variant, sales_status, track_inventory_to_be
        )

        if sales_status == SalesStatus.STOPPED or sales_status == SalesStatus.WILL_BE_STOPPED:
            if stopped_reason is None:
                raise ValidationError(
                    "제품 상태가 정상이 아닌 경우 단종 사유를 입력해 주세요.",
                    code=ProductErrorCode.INVALID.value,
                )

    @classmethod
    def set_brand_product_sales_status_on_change_variant_sales_status(
        cls, variant, cleaned_input, is_inner, user
    ):
        prev_sales_status = variant.sales_status
        (sales_status, stopped_reason, stopped_reason_etc, stopped_at) = (
            cls.get_sales_status_info_from_cleaned_input(cleaned_input, is_inner)
        )

        if sales_status == SalesStatus.STOPPED:
            set_bpv_sales_status_on_pv_to_stopped(
                variant, stopped_at, stopped_reason, stopped_reason_etc, user
            )
        elif prev_sales_status == SalesStatus.STOPPED and sales_status in [
            SalesStatus.ON_SALE,
            SalesStatus.WILL_BE_STOPPED,
        ]:
            set_bpv_sales_status_on_pv_from_stopped_to_non_stopped(variant, prev_sales_status, user)
        elif prev_sales_status == SalesStatus.PENDING and sales_status == SalesStatus.ON_SALE:
            set_bpv_sales_status_on_pv_from_pending_to_on_sale(variant, prev_sales_status, user)
        elif sales_status == SalesStatus.PENDING:
            set_bpv_sales_status_on_pv_to_pending(variant, user)

    @classmethod
    def clean_input(cls, info, instance: ProductVariantModel, data: dict, input_cls=None):
        cleaned_input = super().common_clean_input(info, instance, data)
        cls.validate_sales_status(instance, cleaned_input, False)
        if instance.inner:
            cls.validate_sales_status(instance.inner, cleaned_input, True)
        return cleaned_input

