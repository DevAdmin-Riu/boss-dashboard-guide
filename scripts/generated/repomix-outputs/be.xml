        models.BrandProductVariant.price_amount.field.name: "매장 판매가",
        models.BrandProductVariant.cost_price_exclude_vat.field.name: "브랜드 상품가",
        models.BrandProductVariant.before_price_amount.field.name: "할인전 판매가",
        models.BrandProductVariant.show_before_price.field.name: "할인표시",
        models.BrandProductVariant.delivery_fee_amount.field.name: "브랜드 배송비",
        models.BrandProductVariant.need_delivery_additional_fee.field.name: "도서산간 추가 배송비 청구",
        models.BrandProductVariant.include_sales_b2b_delivery_fee.field.name: "판매가에 b2b 배송비포함 여부",
    }

