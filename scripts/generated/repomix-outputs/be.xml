        ordering = ("-pk",)
        constraints = [
            models.UniqueConstraint(
                fields=["order"],
                condition=~models.Q(status=RefundStatusType.QUESTION_CLOSE),
                name=BbsConstraintNamesPyEnum.UNIQUE_REFUND_PER_ORDER_WHEN_NOT_CLOSED.value,
            )
        ]

    def save(self, *args, **kwargs):
        vendor_exists = self.vendor_id is not None
        if self.is_fbv != vendor_exists:
            raise ValidationError("is_fulfilled_by_vendor와 vendor 설정이 일치하지 않습니다.")
        super().save(*args, **kwargs)

    def __repr__(self):
        return f"{self.__class__.__name__}(user={self.q_writer!r}, order={self.order!r}, type={self.q_type}"

    @property
    def is_in_process(self):
        return self.status != RefundStatusType.QUESTION_CLOSE


