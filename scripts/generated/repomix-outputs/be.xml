from typing import List

import graphene
from django.db.models import Count
from django.db.models.functions import TruncMonth

from saleor.core.exceptions import PermissionDenied
from saleor.pre_founder import models

from ..utils.filters import filter_range_field
from .types import PreFounderMonthCount, PreFounderStatByField


# 가맹본부 계정인 경우, 가맹본부 브랜드의 예비창업자만 조회 가능
def resolve_pre_founder(info, id):
    requester = info.context.user
    _model, pre_founder_pk = graphene.Node.from_global_id(id)
    pre_founder = models.PreFounder.objects.filter(pk=pre_founder_pk).first()
    if requester.is_staff:
        return pre_founder
    elif requester.is_hq_staff and requester.brand_id == pre_founder.brand_id:
        return pre_founder
    else:
        return PermissionDenied(user=requester, fn=resolve_pre_founder)


def resolve_pre_founder_list(info, **kwargs):
    requester = info.context.user
    if requester.is_hq_staff:
        qs = models.PreFounder.objects.filter(brand_id=requester.brand_id)
    elif requester.is_staff:
        qs = models.PreFounder.objects.all()
    else:
        return PermissionDenied(user=requester, fn=resolve_pre_founder_list)
    return qs.distinct().select_related("desired_region")


def resolve_pre_founder_consultation(info, id):
    requester = info.context.user
    _model, pre_founder_consultation_pk = graphene.Node.from_global_id(id)
    pre_founder_consultation = models.PreFounderConsultation.objects.filter(
        pk=pre_founder_consultation_pk
    ).first()
    if requester.is_staff:
        return pre_founder_consultation
    elif (
        requester.is_hq_staff
        and requester.brand_id == pre_founder_consultation.pre_founder.brand_id
    ):
        return pre_founder_consultation
    else:
        return PermissionDenied(user=requester, fn=resolve_pre_founder)


def resolve_pre_founder_eval_item_list(info, brand_id):
    requester = info.context.user
    _type, brand_pk = graphene.Node.from_global_id(brand_id)
    brand_pk = int(brand_pk)

    if requester.is_staff or (requester.is_hq_staff and requester.brand_id == brand_pk):
        return models.PreFounderEvalItem.objects.filter(brand_id=brand_pk)
    else:
        return PermissionDenied(user=requester, fn=resolve_pre_founder_eval_item_list)


# 실제 예비창업자 모델(PreFounder)의 필드명에 맞게 필요 시 수정
DIMENSION_FIELD_MAP = {
    "GENDER": "gender",
    "REGION": "desired_region__code",
    "SOURCE": "lead_source",
}


def resolve_pre_founder_stats_by_field(
    info, dimension: str, stat_date
) -> List[PreFounderStatByField]:
    requester = info.context.user
    if requester.is_hq_staff:
        qs = models.PreFounder.objects.filter(brand_id=requester.brand_id)
    else:
        return PermissionDenied(user=requester, fn=resolve_pre_founder_stats_by_field)

    field_name = DIMENSION_FIELD_MAP.get(dimension)
    if not field_name:
        raise graphene.GraphQLError("잘못된 dimension 값입니다.")

    qs = filter_range_field(qs, "created__date", stat_date)

    rows = (
        qs.annotate(month=TruncMonth("created"))
        .values("month", field_name)
        .annotate(count=Count("id"))
        .order_by("month")
    )

    field_buckets: dict[str, List[PreFounderMonthCount]] = {}
    for row in rows:
        month_dt = row["month"]
        month_str = month_dt.strftime("%Y-%m")
        field_value = row.get(field_name) or "UNKNOWN"
        field_buckets.setdefault(field_value, []).append(
            {"month": month_str, "count": row["count"]}
        )

    result: List[PreFounderStatByField] = [
        {"field_value": field_value, "counts": field_buckets[field_value]}
        for field_value in field_buckets.keys()
    ]
    return result
