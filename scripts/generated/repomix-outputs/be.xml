import logging

import graphene
from django.conf import settings
from django.core.exceptions import ValidationError
from django.db import transaction

from ....account.models import User
from ....core import ServerModeEnum
from ....core.utils.server_mode import is_prod_server_mode
from ....payment import ChargeStatus, PaymentFailedType
from ....payment.gateways.handle_by_pg import validate_brand_pg_info
from ....payment.gateways.process_auth_completed import get_checkout, process_auth_completed
from ....payment.gateways.toss.define import TOSS_GATEWAY_PLUGIN_ID
from ....payment.gateways.toss.interface import TossCardRefundData, TossVbankRefundData
from ....payment.gateways.toss.utils import (
    call_toss_payment_cancel_api,
    call_toss_payment_confirm_api,
    change_toss_plugin_configs,
    get_payment_id_by_toss_order_id,
    get_toss_error_code_and_message,
    get_toss_vact_info,
)
from ....payment.gateways.utils import (
    append_vact_info_to_success_msg,
    create_payment_failed_transaction,
    is_card_pay,
    is_vbank_pay,
    make_cancel_payment_message,
)
from ....payment.models import Payment as PaymentModel
from ....plugins.manager import get_plugins_manager
from ...account.i18n import I18nMixin
from ...core.mutations import BaseMutation
from ...core.scalars import PositiveDecimal
from ...core.types import common as common_types
from ...order.types import Order
from ..types import Payment

logger = logging.getLogger(__name__)


class RequestTossPaymentConfirmInput(graphene.InputObjectType):
    toss_payment_key = graphene.String(required=True, description=("토스 결제 키"))
    toss_order_id = graphene.String(
        required=True, description=("토스 결제 요청 ID = payment.global_id")
    )
    amount = PositiveDecimal(required=True, description=("토스 결제 요청 금액"))
    is_toss_riu_pay = graphene.Boolean(required=True, description=("브랜드페이 결제 여부"))


class RequestTossPaymentConfirm(BaseMutation, I18nMixin):
    order = graphene.Field(Order, description="토스 결제 승인 후 생성된 주문.")

    class Arguments:
        checkout_id = graphene.ID(description="Checkout ID.", required=True)
        input = RequestTossPaymentConfirmInput(description="토스 결제 정보", required=True)

    class Meta:
        description = "토스 결제 승인 API 호출"
        error_type_class = common_types.PaymentError
        error_type_field = "payment_errors"

    @classmethod
    def validate_payment_amount(cls, payment: PaymentModel, amount):
        if payment.amount != amount:
            raise ValidationError("결제 금액 정보가 일치하지 않습니다.")

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, checkout_id, **data):
        logger.info(
            f"payment_debug: payment.RequestTossPaymentConfirm mutation {checkout_id} ===== toss payment confirm!!!"
        )

        input_data = data.get("input")
        toss_payment_key = input_data.get("toss_payment_key")
        toss_order_id = input_data.get("toss_order_id")
        amount = input_data.get("amount")
        is_toss_riu_pay = input_data.get("is_toss_riu_pay")
        payment_id = get_payment_id_by_toss_order_id(toss_order_id)
        payment: PaymentModel = cls.get_node_by_pk(info, Payment, payment_id)
        if not payment:
            failed_msg = f"payment_debug: Payment is not exists: pk={payment_id}"
            logger.error(f"{failed_msg}")
            raise ValidationError(
                "결제 승인 요청 처리에 실패했습니다. 장바구니 페이지를 새로고침 후 다시 시도해 주세요."
            )
        if (
            payment.charge_status in [ChargeStatus.FULLY_CHARGED, ChargeStatus.PENDING]
            or payment.order_id is not None
        ):
            failed_msg = f"payment_debug: Payment is already confirmed and process_auth_completed is finished. pk={payment_id} {payment.charge_status} {payment.order.composed_id_with_prefix}"
            logger.error(f"{failed_msg}")
            raise ValidationError(
                "주문 처리가 이미 완료되었습니다. 페이지를 새로고침 후 구매내역을 확인해 보세요."
            )
        cls.validate_payment_amount(payment, amount)

        checkout = get_checkout(payment)
        user: User = checkout.user
        brand = user.brand if user else None
        customer_key = user.toss_customer_key if user else None
        validate_brand_pg_info(payment.gateway, brand)
        plugin_configs = get_plugins_manager().get_plugin_config_dot_map(TOSS_GATEWAY_PLUGIN_ID)
        plugin_configs = change_toss_plugin_configs(plugin_configs, brand)
        if not plugin_configs:
            raise ValidationError("결제 정보 오류로 결제가 취소되었습니다.")
        confirm_success, gateway_response, system_failed_message = call_toss_payment_confirm_api(
            is_toss_riu_pay, plugin_configs, toss_payment_key, toss_order_id, amount, customer_key
        )

        order = None
        is_success = False
        if not confirm_success:
            if gateway_response:
                fail_type = PaymentFailedType.TOSS_CONFIRM_FAILED
                result_code, result_message = get_toss_error_code_and_message(gateway_response)
                failed_msg = f"({result_code}) {result_message}"
            else:
                fail_type = PaymentFailedType.SYSTEM_FAILED
                result_code = "-"
                if system_failed_message:
                    failed_msg = system_failed_message
                else:
                    failed_msg = "토스 결제 승인 로직이 정상 처리되지 않았습니다."
            logger.error(
                f"payment_debug: call_toss_payment_confirm_api {payment.id} {result_code} {failed_msg} {gateway_response}"
            )
            create_payment_failed_transaction(
                payment=payment,
                type=fail_type,
                message=failed_msg,
                parameters={"payment_id": payment_id, "result_code": result_code},
            )
            raise ValidationError(failed_msg)

        try:
            success_msg = "토스 결제 승인 완료"
            pay_method = gateway_response.get("method")
            if is_vbank_pay(pay_method):
                server_mode_str = settings.SERVER_MODE
                server_mode_enum = ServerModeEnum(server_mode_str)
                include_vact_time = is_prod_server_mode(server_mode_enum) == False
                vact_info = get_toss_vact_info(
                    gateway_response,
                    include_vact_time=include_vact_time,
                    plugin_configs=plugin_configs,
                )
                success_msg = append_vact_info_to_success_msg(success_msg, vact_info)
            checkout = get_checkout(payment)
            is_success, success_msg, failed_msg, order = process_auth_completed(
                checkout=checkout,
                payment=payment,
                pay_method=pay_method,
                gateway_response=gateway_response,
                success_msg=success_msg,
                is_mobile=None,
            )
        except Exception as e:
            logger.error(
                f"payment_debug: process_auth_completed error: {payment.id} {e}",
                exc_info=True,
            )
            is_success = False
            failed_msg = "주문 처리 중 오류가 발생했습니다."
            create_payment_failed_transaction(
                payment=payment,
                type=PaymentFailedType.SYSTEM_FAILED,
                message=failed_msg,
                parameters={
                    "payment_id": payment_id,
                    "pay_method": pay_method,
                    "gateway_response": gateway_response,
                },
            )

        if not is_success or not order:
            if is_vbank_pay(pay_method):
                toss_refund_data = TossVbankRefundData(
                    payment_key=toss_payment_key,
                    refund_reason="상점 서버 처리 오류 로 결제 취소",
                    refund_amount=int(amount),
                    remain_refundable_amount=0,
                    refund_tax_free_amount=int(payment.taxfree),
                    pg_refund_bank_info=None,
                )
            elif is_card_pay(pay_method):
                toss_refund_data = TossCardRefundData(
                    payment_key=toss_payment_key,
                    refund_reason="상점 서버 처리 오류 로 결제 취소",
                    refund_amount=int(amount),
                    remain_refundable_amount=0,
                    refund_tax_free_amount=int(payment.taxfree),
                )
            cancel_success, gateway_response, system_failed_message = call_toss_payment_cancel_api(
                is_toss_riu_pay, plugin_configs, toss_refund_data, is_refund_mode=False
            )
            cancel_payment_message = make_cancel_payment_message(cancel_success)
            create_payment_failed_transaction(
                payment=payment,
                type=PaymentFailedType.SYSTEM_FAILED,
                message=cancel_payment_message,
                parameters={
                    "payment_id": payment_id,
                    "pay_method": pay_method,
                    "gateway_response": gateway_response,
                },
            )
            if not cancel_success:
                if gateway_response:
                    fail_type = PaymentFailedType.TOSS_CANCEL_FAILED
                    result_code, result_message = get_toss_error_code_and_message(gateway_response)
                    failed_msg = f"({result_code}) {result_message}"
                else:
                    fail_type = PaymentFailedType.SYSTEM_FAILED
                    result_code = "-"
                    if system_failed_message:
                        failed_msg = system_failed_message
                    else:
                        failed_msg = "토스 결제 취소 로직이 정상 처리되지 않았습니다."
                logger.error(
                    f"payment_debug: call_toss_payment_cancel_api {payment.id} {result_code} {failed_msg} {gateway_response}"
                )
                raise ValidationError(cancel_payment_message)

        return RequestTossPaymentConfirm(order=order)
