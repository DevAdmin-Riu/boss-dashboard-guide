from decimal import Decimal
from typing import Iterable, List

from dateutil.relativedelta import relativedelta
from django.db.models import Sum

from ...core.utils.export_to_excel import (
    ExcelCellInfo,
    export_excel_cell_info_rows_to_workbook,
    make_excel_cell_info,
)
from ...core.utils.kst_time import kst_timezone_date
from ...product.models import (
    ProductVariant,
    ProductVariantVendor,
    get_avg_sales_combined_qty_consider_inner,
    get_avg_sales_seperated_qty_consider_inner,
    get_avg_sales_seperated_value_consider_inner,
    get_po_lead_time_consider_inner,
    get_priority_level_consider_inner,
    get_stock_adjust_factor_consider_inner,
)
from ...stats.models import ProductVariantMonthlySales
from ...stats.utils import (
    get_closest_to_be_stocked_info_using_prefetched_data,
    get_latest_stocked_date_info_using_prefetched_data,
    get_latest_stocked_po_line_by_prefetched_data,
    get_qty_to_be_stocked_by_prefetched_data,
)
from ...terminology import (
    term_of_is_safety,
    term_of_is_sales_surge,
    term_of_need_to_reorder,
    term_of_priority_level,
    term_of_stock_status_by_est_shortage_enum,
)
from ...vendor.models import Vendor
from ..availability import (
    calc_est_shortage_info,
    get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner,
    get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data,
)
from ..interface import EstShortageInfoDataClass


def export_stock_alarm_list(
    pv_list: Iterable[ProductVariant],
    orderable_qty_list: List[int],
    orderable_qty_incl_short_term_list: List[int],
    orderable_qty_incl_long_term_list: List[int],
):
    rows: List[List[ExcelCellInfo]] = []
    for pv, orderable_qty, orderable_qty_incl_short_term, orderable_qty_incl_long_term in zip(
        pv_list,
        orderable_qty_list,
        orderable_qty_incl_short_term_list,
        orderable_qty_incl_long_term_list,
    ):
        closest_to_be_stocked_info = get_closest_to_be_stocked_info_using_prefetched_data(
            pv, rank=1
        )
        latest_stocked_date = get_latest_stocked_date_info_using_prefetched_data(pv)
        today = kst_timezone_date()
        this_month_first_day = today.replace(day=1)
        target_date = this_month_first_day - relativedelta(years=1)

        last_year_same_month_sales_qty_consider_inner = Decimal(0)
        this_month_sales_qty_consider_inner = Decimal(0)

        last_year_same_month_sales: ProductVariantMonthlySales = pv.monthly_sales.filter(
            date=target_date
        ).first()

        if last_year_same_month_sales:
            last_year_same_month_sales_qty_consider_inner = (
                get_avg_sales_seperated_value_consider_inner(
                    pv, last_year_same_month_sales.quantity
                )
                or Decimal(0)
            )

        this_month_sales = (
            pv.daily_sales.filter(
                date__gte=this_month_first_day,
                date__lt=today,
            ).aggregate(total_quantity=Sum("quantity"))
        )["total_quantity"]

        if this_month_sales:
            this_month_sales_qty_consider_inner = get_avg_sales_seperated_value_consider_inner(
                pv, this_month_sales
            ) or Decimal(0)

        inner_last_year_same_month_sales_qty_consider_inner = Decimal(0)
        inner_this_month_sales_qty_consider_inner = Decimal(0)
        inner: ProductVariant = pv.inner
        if inner is not None:
            inner_last_year_same_month_sales: ProductVariantMonthlySales = (
                inner.monthly_sales.filter(date=target_date).first()
            )
            if inner_last_year_same_month_sales:
                inner_last_year_same_month_sales_qty_consider_inner = (
                    get_avg_sales_seperated_value_consider_inner(
                        inner, inner_last_year_same_month_sales.quantity
                    )
                    or Decimal(0)
                )

            inner_this_month_sales = (
                pv.inner.daily_sales.filter(
                    date__gte=this_month_first_day,
                    date__lt=today,
                ).aggregate(total_quantity=Sum("quantity"))
            )["total_quantity"]
            if inner_this_month_sales:
                inner_this_month_sales_qty_consider_inner = (
                    get_avg_sales_seperated_value_consider_inner(inner, inner_this_month_sales)
                    or Decimal(0)
                )

        default_variant_vendor: ProductVariantVendor = pv.default_variant_vendor
        vendor: Vendor = default_variant_vendor.vendor if default_variant_vendor else None
        total_stock_qty = get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data(pv)
        is_inner = pv.is_inner
        prefetched_to_be_stocked_po_lines = (
            getattr(pv, "prefetched_outer_to_be_stocked_po_lines", [])
            if is_inner
            else getattr(pv, "prefetched_to_be_stocked_po_lines", [])
        )
        prefetched_latest_stocked_po_lines = (
            getattr(pv, "prefetched_outer_latest_stocked_po_lines", [])
            if is_inner
            else getattr(pv, "prefetched_latest_stocked_po_lines", [])
        )
        qty_to_be_stocked_long_term = get_qty_to_be_stocked_by_prefetched_data(
            prefetched_to_be_stocked_po_lines, False
        )
        latest_stocked_po_line = get_latest_stocked_po_line_by_prefetched_data(
            prefetched_latest_stocked_po_lines
        )
        orderable_qty_incl_long_term = (
            get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
                pv, until_short_term=False
            )
        )
        est_shortage_info: EstShortageInfoDataClass = calc_est_shortage_info(
            variant=pv,
            total_stock_qty=total_stock_qty,
            latest_stocked_po_line=latest_stocked_po_line,
            detail_info_mode=True,
            qty_to_be_stocked_long_term=qty_to_be_stocked_long_term,
            orderable_qty_incl_long_term=orderable_qty_incl_long_term,
        )
        stock_status_text, _ = term_of_stock_status_by_est_shortage_enum(pv.stock_status_by_daily)
        po_lead_time = get_po_lead_time_consider_inner(pv)
        priority_level = get_priority_level_consider_inner(pv)
        stock_adjust_factor = get_stock_adjust_factor_consider_inner(pv)
        rows.append(
            [
                make_excel_cell_info(title="제품코드", value=pv.sku),
                make_excel_cell_info(title="제품명", value=pv.product.name),
                make_excel_cell_info(title="옵션명", value=(pv.name if pv.name else "-")),
                make_excel_cell_info(
                    title="안전재고 상태",
                    value=term_of_is_safety(pv),
                ),
                make_excel_cell_info(
                    title="재발주점 상태\n(최근 7일)",
                    value=term_of_need_to_reorder(pv.need_to_reorder_7),
                ),
                make_excel_cell_info(
                    title="재발주점 상태\n(최근 15일)",
                    value=term_of_need_to_reorder(pv.need_to_reorder_15),
                ),
                make_excel_cell_info(
                    title="재발주점 상태\n(최근 30일)",
                    value=term_of_need_to_reorder(pv.need_to_reorder_30),
                ),
                make_excel_cell_info(
                    title="소진임박 상태",
                    value=term_of_is_sales_surge(pv),
                ),
                make_excel_cell_info(
                    title="재발주예정일", value=est_shortage_info.need_to_reorder_date or "-"
                ),
                make_excel_cell_info(
                    title="예상소진일", value=est_shortage_info.est_shortage_date or "-"
                ),
                make_excel_cell_info(
                    title="예상소진일\n(입고예정포함)",
                    value=est_shortage_info.est_shortage_date_incl_long_term_qty or "-",
                ),
                make_excel_cell_info(
                    title="악성재고 상태",
                    value=stock_status_text,
                ),
                make_excel_cell_info(
                    title="가용 재고",
                    value=(orderable_qty if orderable_qty is not None else "-"),
                    ndigits=0,
                ),
                make_excel_cell_info(
                    title="최근 입고일",
                    value=latest_stocked_date,
                ),
                make_excel_cell_info(
                    title="가장 빠른 입고 예정일",
                    value=closest_to_be_stocked_info.closest_to_be_stocked_date,
                ),
                make_excel_cell_info(
                    title="가장 빠른 예정 수량",
                    value=closest_to_be_stocked_info.closest_to_be_stocked_qty,
                    ndigits=0,
                ),
                make_excel_cell_info(
                    title="아우터/이너 분리 월 평균 판매량\n(최근 3개월)",
                    value=(
                        get_avg_sales_seperated_qty_consider_inner(
                            pv, "last_3_months_avg_sales_monthly_qty"
                        )
                        or "-"
                    ),
                ),
                make_excel_cell_info(
                    title="아우터/이너 분리 전년도 동월 판매량",
                    value=(
                        get_avg_sales_seperated_value_consider_inner(
                            pv,
                            (
                                last_year_same_month_sales.quantity
                                if last_year_same_month_sales is not None
                                else None
                            ),
                        )
                    ),
                    ndigits=0,
                ),
                make_excel_cell_info(
                    title="아우터/이너 분리 금월 판매량",
                    value=(
                        get_avg_sales_seperated_value_consider_inner(
                            pv, this_month_sales if this_month_sales is not None else None
