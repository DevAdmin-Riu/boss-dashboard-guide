        description = "Creates a new inquire about service."
        model = models.InquireAboutService
        error_type_class = InquireAboutError
        error_type_field = "inquire_about_errors"

    @classmethod
    def get_type_for_model(cls):
        return InquireAboutService

    @classmethod
    def mutate(cls, root, info, **data):
        response = super().mutate(root, info, **data)
        return response

    @classmethod
    def post_save_action(cls, info, instance, cleaned_input):
        transaction.on_commit(lambda: send_kakaotalk_to_manager_on_inquire_about_sevice(instance))
        transaction.on_commit(lambda: send_email_to_manager_on_inquire_about_service(instance))

    @classmethod
