        description = "Deletes CourierDeliveryAdditionalFee."
        model = models.CourierDeliveryAdditionalFee
        permissions = (AccountPermissions.ONLY_SUPER_USER,)
        error_type_class = CourierError
        error_type_field = "courier_errors"


class CourierDeliveryAdditionalFeeBulkResetDetails(graphene.InputObjectType):
    pcode_start = graphene.String(required=True, description="우편번호 start")
    pcode_end = graphene.String(required=True, description="우편번호 end")
    unit_additional_fee_exclude_vat = PositiveDecimal(required=True, description="추가요금")
    street_address = graphene.String(description="참고용 주소")


class CourierDeliveryAdditionalFeeBulkResetInput(graphene.InputObjectType):
    details = graphene.List(
        CourierDeliveryAdditionalFeeBulkResetDetails,
        required=True,
        description="우편번호 대역별 추가요금 정의",
    )


class CourierDeliveryAdditionalFeeBulkReset(BaseMutation):
    class Arguments:
        input = CourierDeliveryAdditionalFeeBulkResetInput(
            required=True, description="협력사-매장 배송 조건 정보"
        )

    class Meta:
        description = "Deletes CourierDeliveryAdditionalFee."
        model = models.CourierDeliveryAdditionalFee
        permissions = (AccountPermissions.ONLY_SUPER_USER,)
        error_type_class = CourierError
        error_type_field = "courier_errors"

    @classmethod
    def make_detail_code(cls, detail):
        pcode_start = detail.get("pcode_start")
        pcode_end = detail.get("pcode_end")
        return f"({pcode_start}~{pcode_end})"

    @classmethod
    def validate_value(cls, details):
        pcode_errors = []
        pcode_s_e_errors = []
        fee_errors = []
        overlap_errors = []
        ranges = []  # (start, end, detail_code)
        for detail in details:
            detail_code = cls.make_detail_code(detail)
            try:
                start = int(detail.get("pcode_start"))
                end = int(detail.get("pcode_end"))
            except (TypeError, ValueError):
                pcode_errors.append(detail_code)
            if start > end:
                pcode_s_e_errors.append(detail_code)
            unit_additional_fee_exclude_vat = detail.get("unit_additional_fee_exclude_vat")
            if unit_additional_fee_exclude_vat is None or unit_additional_fee_exclude_vat <= 0:
                fee_errors.append(detail_code)
            ranges.append((start, end, detail_code))
        ranges.sort(key=lambda x: x[0])  # start 기준 정렬
        prev_start, prev_end, prev_code = None, None, None
        for start, end, code in ranges:
            if prev_end is not None and start <= prev_end:
                # 이전 구간과 겹침 발생
                overlap_errors.extend([prev_code, code])
            if prev_end is None or end > prev_end:
                # 가장 긴 end 유지 (구간 확장)
                prev_start, prev_end, prev_code = start, end, code

        error_msg = ""
        if pcode_errors:
            error_msg += "우편번호는 5자리 숫자로 입력되어야 합니다.: {}".format(
                ", ".join(pcode_errors)
            )
        if pcode_s_e_errors:
            if not error_msg:
                error_msg += "\n"
            error_msg += "우편번호 대역의 start 값은 end 값보다 작거나 같아야 합니다.: {}".format(
                ", ".join(pcode_s_e_errors)
            )
        if fee_errors:
            if not error_msg:
                error_msg += "\n"
            error_msg = "추가 요금은 부가세 별도가로 0보다 큰값으로 입력되어야 합니다.: {}".format(
                ", ".join(fee_errors)
            )
        if overlap_errors:
            if error_msg:
                error_msg += "\n"
            error_msg += "우편번호 구간이 서로 중첩됩니다.: {}".format(
                ", ".join(set(overlap_errors))  # 중복 제거
            )
        if error_msg:
            raise ValidationError(error_msg)

    @classmethod
    def clean_details(cls, info, input_data) -> list:
        details = input_data.get("details")
        validate_data_is_non_null(details)
        cls.validate_value(details)
        return details

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        details = cls.clean_details(info, input_data)
        models.CourierDeliveryAdditionalFee.objects.all().delete()
        create_list = []
        for detail in details:
            obj = CourierDeliveryAdditionalFeeModel(
                pcode_start=detail.get("pcode_start"),
                pcode_end=detail.get("pcode_end"),
                unit_additional_fee_exclude_vat=detail.get("unit_additional_fee_exclude_vat"),
                street_address=detail.get("street_address"),
            )
            create_list.append(obj)
        if create_list:
            models.CourierDeliveryAdditionalFee.objects.bulk_create(create_list)
        return CourierDeliveryAdditionalFeeBulkReset()
