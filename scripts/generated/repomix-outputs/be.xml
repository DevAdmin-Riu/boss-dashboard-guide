from datetime import timedelta
from typing import List

from django.db import transaction

from ..celeryconf import app
from ..plugins.manager import get_plugins_manager
from ..plugins.site_settings.define import SITE_SETTINGS_PLUGIN_ID
from . import RepeatType
from .events import push_notification_on_schedule_alarm
from .models import Schedule, ScheduleAlarm
from .utils import generate_alarm_datetimes, kst_timezone_now


@app.task(name="schedule.tasks.send_push_notification_due_schedule_alarms")
@transaction.atomic()
def send_push_notification_due_schedule_alarms():
    plugins_config = get_plugins_manager().get_plugin_config_dot_map(SITE_SETTINGS_PLUGIN_ID)
    push_notification_enable = plugins_config.get("push_notification_enable", False)
    if not push_notification_enable:
        return

    today = kst_timezone_now()
    window_start = today - timedelta(minutes=1)
    window_end = today + timedelta(minutes=1)

    target_qs = ScheduleAlarm.objects.filter(
        is_sent=False,
        alarm_datetime__gte=window_start,
        alarm_datetime__lt=window_end,
    ).select_related("schedule")
    targets: List[ScheduleAlarm] = list(target_qs)
    target_qs.update(is_sent=True)

    for target in targets:
        push_notification_on_schedule_alarm(target)


@app.task(name="schedule.tasks.ensure_7_days_schedule_alarms")
@transaction.atomic()
def ensure_7_days_schedule_alarms():
    today = kst_timezone_now()
    target_end_date = today + timedelta(days=7)

    schedules = Schedule.objects.filter(
        has_alarm=True,
        repeat_type__in=[
            RepeatType.DAILY,
            RepeatType.WEEKLY,
            RepeatType.MONTHLY,
            RepeatType.YEARLY,
        ],
    )

    for schedule in schedules:
        # 이미 생성된 알림 트리거 중 가장 미래 시각 확인
        latest_alarm = (
            ScheduleAlarm.objects.filter(schedule=schedule).order_by("-alarm_datetime").first()
        )

        # 가장 늦은 트리거가 7일 뒤를 포함하지 않으면 추가 생성
        if not latest_alarm or latest_alarm.alarm_datetime.date() < target_end_date:
            alarm_datetimes = generate_alarm_datetimes(schedule)
            existing_datetimes = set(
                ScheduleAlarm.objects.filter(
                    schedule=schedule, alarm_datetime__date__gte=today
                ).values_list("alarm_datetime", flat=True)
            )

            new_alarms = [
                ScheduleAlarm(schedule=schedule, alarm_datetime=dt)
                for dt in alarm_datetimes
                if dt not in existing_datetimes and today <= dt.date() <= target_end_date
            ]

            ScheduleAlarm.objects.bulk_create(new_alarms)
