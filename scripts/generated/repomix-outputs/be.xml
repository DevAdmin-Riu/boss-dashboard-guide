def _get_payment_data(
    amount: Optional[Decimal],
    payment: "Payment",
    cashable_credits: Optional[Decimal] = None,
    non_cashable_credits: Optional[Decimal] = None,
    rcoins: Optional[Decimal] = None,
) -> Dict:
    return {
        "parameters": {
            "amount": amount,
            "cashable_credits": cashable_credits,
            "non_cashable_credits": non_cashable_credits,
            "rcoins": rcoins,
