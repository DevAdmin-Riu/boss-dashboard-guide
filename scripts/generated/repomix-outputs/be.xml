class BrandUpdateProductVariant(ModelMutation):
    class Arguments:
        id = graphene.Argument(
            graphene.ID,
            required=True,
            description="ID of a brand-product_variant relation.",
        )
        input = BrandUpdateProductVariantInput(
            required=True,
            description="Fields required to update a brand_product_variant for a franchise brand",
        )

    class Meta:
        description = "Updates an existing product_variant for a franchise brand."
        model = models.BrandProductVariant
        permissions = (ProductPermissions.MANAGE_BPV,)
        error_type_class = ProductError
        error_type_field = "product_errors"
        errors_mapping = {"price_amount": "price"}

    @staticmethod
    def validate_before_price(price: PositiveDecimal, before_price: PositiveDecimal):
        if before_price is None:
            return
        if before_price < price:
            raise ValidationError(
                "할인 전 가격은 판매가보다 커야 합니다.",
                code=ProductErrorCode.INVALID.value,
            )

    @staticmethod
    def validate_sales_status(
        variant: ProductVariantModel,
        brand: BrandModel,
        brand_product_variant: BrandProductVariantModel,
        prev_sales_status: SalesStatus,
        cleaned_input,
    ):
        sales_status = cleaned_input.get("sales_status")
        stopped_reason = cleaned_input.get("stopped_reason")
        stopped_reason_etc = cleaned_input.get("stopped_reason_etc")
        if stopped_reason == StoppedReasonType.ETC and stopped_reason_etc is None:
            raise ValidationError(
                "판매 중단 사유가 기타인 경우 판매 중단 상세 사유를 입력해 주세요.",
                code=ProductErrorCode.INVALID.value,
            )
        if prev_sales_status == sales_status:
            return

        if sales_status == SalesStatus.ON_SALE:
            cleaned_input["stopped_at"] = None
            variant_sales_status = variant.sales_status
            if variant_sales_status == SalesStatus.STOPPED:
                raise ValidationError(
                    "제품 상태가 단종인 경우에는 판매 상태로 변경할 수 없습니다.",
                    code=ProductErrorCode.INVALID.value,
                )
            if variant.product.is_direct_shipping == True and brand.is_direct_shipping == False:
                raise ValidationError(
                    "브랜드 상품 취급 여부가 꺼져있는 브랜드에 직배송 상품은 판매상태로 변경할 수 없습니다.",
                    code=ProductErrorCode.INVALID.value,
                )
        elif sales_status == SalesStatus.STOPPED or sales_status == SalesStatus.WILL_BE_STOPPED:
            if stopped_reason is None:
                raise ValidationError(
                    "판매 상태가 판매가 아닌 경우 판매 중단 사유를 입력해 주세요.",
                    code=ProductErrorCode.INVALID.value,
                )
            if sales_status == SalesStatus.WILL_BE_STOPPED:
                stopped_at = cleaned_input.get("stopped_at")
                if stopped_at is None:
                    raise ValidationError(
                        "판매 상태가 중단 예정인 경우 판매 중단일을 입력해 주세요.",
                        code=ProductErrorCode.INVALID.value,
                    )
            elif sales_status == SalesStatus.STOPPED:
                cleaned_input["stopped_at"] = datetime.date.today()
            # 해당 브랜드 상품을 구성상품으로 가진 패키지(visible true)가 존재하는 경우 error
            if (
                brand_product_variant is not None
                and brand_product_variant.brand_product_packages.filter(visible=True).exists()
            ):
                raise ValidationError(
                    "해당 상품이 포함된 패키지가 존재하여 판매 중단 상태로 변경할 수 없습니다.",
                    code=ProductErrorCode.INVALID.value,
                )

    @classmethod
    def clean_input(cls, info, instance: BrandProductVariantModel, data: dict, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data)

        check_show_before_price = instance.show_before_price
        check_before_price = instance.before_price_amount
        check_price = instance.price_amount

        if "show_before_price" in cleaned_input:
            check_show_before_price = cleaned_input.get("show_before_price")

        if "before_price" in cleaned_input:
            check_before_price = cleaned_input.pop("before_price")
            cleaned_input["before_price_amount"] = check_before_price

        if "price" in cleaned_input:
            check_price = cleaned_input.pop("price")
            cleaned_input["price_amount"] = check_price

        if check_show_before_price:
            BrandUpdateProductVariant.validate_before_price(
                price=check_price, before_price=check_before_price
            )

        if "delivery_fee" in cleaned_input:
            delivery_fee = cleaned_input.pop("delivery_fee")
            cleaned_input["delivery_fee_amount"] = delivery_fee

        BrandUpdateProductVariant.validate_sales_status(
            variant=instance.product_variant,
            brand=instance.brand,
            brand_product_variant=instance,
            prev_sales_status=instance.sales_status,
            cleaned_input=cleaned_input,
        )

        return cleaned_input

    @classmethod
    @transaction.atomic
    def save(cls, info, instance: BrandProductVariantModel, cleaned_input):
        instance.save()
        brand_product_packages = instance.brand_product_packages.all()
        for brand_product_package in brand_product_packages:
            brand_product_package.update_and_save_etc_delivery_fee()


