from collections import defaultdict

from saleor.graphql.core.dataloaders import DataLoader
from saleor.shipping.models import ShippingMethod
from saleor.warehouse.models import Warehouse


class ShippingMethodsByShippingZoneIdLoader(DataLoader):
    context_key = "shipping_methods_by_shipping_zone_id"

    def batch_load(self, keys):
        shipping_methods = ShippingMethod.objects.filter(shipping_zone_id__in=keys)
        shipping_methods_map = defaultdict(list)
        for shipping_method in shipping_methods:
            shipping_methods_map[shipping_method.shipping_zone_id].append(shipping_method)
        return [shipping_methods_map.get(shipping_zone_id) for shipping_zone_id in keys]


class WarehousesByShippingZoneIdLoader(DataLoader):
    context_key = "warehouses_by_shipping_zone_id"

    def batch_load(self, keys):
        through_table = Warehouse.shipping_zones.through
        warehouse_shipping_zone_relations = through_table.objects.filter(
            shippingzone_id__in=keys
        ).select_related("warehouse")

        warehouse_map = defaultdict(list)

        for entry in warehouse_shipping_zone_relations:
            warehouse_map[entry.shippingzone_id].append(entry.warehouse)

        return [warehouse_map[shipping_zone_id] for shipping_zone_id in keys]
