    )
    # 기존 협력사명만 관리하던 데이터를 위해 vendor -> vendor_name 으로 이름 변경해서 관리
    vendor_name = models.CharField(max_length=255, blank=True)

    # 재고 상품 반품 발주 시 재고 감소 처리를 위해 정보 저장
    purchase_order_line = models.OneToOneField(
        "purchaseorder.PurchaseOrderLine",
        related_name="stock_detail",
        on_delete=models.CASCADE,
        blank=True,
        null=True,
    )

    objects = StockDetailQuerySet.as_manager()

    class Meta:
        ordering = ("stocked_at", "pk")

    @property
    def code(self):
        return f"{STOCK_DETAIL_CODE_PREFIX}{str(self.pk).zfill(9)}"

    def increase_remain_stock(self, quantity: int):
        self.remain_quantity = self.remain_quantity + quantity
        StockDetail.objects.filter(pk=self.pk).update(
            remain_quantity=F("remain_quantity") + quantity
        )

    def decrease_remain_stock(self, quantity: int):
        self.remain_quantity = self.remain_quantity - quantity
        if self.remain_quantity <= 0:
            self.delete()
        else:
            StockDetail.objects.filter(pk=self.pk).update(
                remain_quantity=F("remain_quantity") - quantity
            )

    # 부자재 재고 감소: 음수 허용
    def decrease_remain_stock_for_sub_pv(self, quantity: int):
        self.remain_quantity = self.remain_quantity - quantity
        StockDetail.objects.filter(pk=self.pk).update(
            remain_quantity=F("remain_quantity") - quantity
        )


