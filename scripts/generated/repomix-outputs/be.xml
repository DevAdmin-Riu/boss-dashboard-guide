        sales_qs = (
            sales_qs.filter(
                variant_id=OuterRef("product_variant_id"),
                brand_id=OuterRef("brand_id"),
                evented_at__date__gte=start_date,
                evented_at__date__lt=end_date,
            )
            .values("variant_id", "brand_id")
            .annotate(total_qty=Sum("quantity"))
            .values("total_qty")
        )

        profit_field_name = (
            "riu_this_month_profit"
            if target_month_ago == 0
            else f"riu_{target_month_ago}_month_ago_profit"
        )

        qs = BrandProductVariantSortField.qs_with_riu_unit_profit(qs)
        qs = qs.annotate(monthly_sales_qty=Coalesce(Subquery(sales_qs), Value(0)))
        qs = qs.annotate(
            **{
                profit_field_name: ExpressionWrapper(
                    F("monthly_sales_qty") * F("riu_unit_profit"),
                    output_field=FloatField(),
                )
            }
        )
        return qs

    @staticmethod
    def qs_with_riu_this_month_profit(qs: QuerySet) -> QuerySet:
        return BrandProductVariantSortField.qs_with_riu_month_profit(qs, 0)

    @staticmethod
    def qs_with_riu_1_month_ago_profit(qs: QuerySet) -> QuerySet:
        return BrandProductVariantSortField.qs_with_riu_month_profit(qs, 1)

    @staticmethod
    def qs_with_riu_2_month_ago_profit(qs: QuerySet) -> QuerySet:
        return BrandProductVariantSortField.qs_with_riu_month_profit(qs, 2)

    @staticmethod
    def qs_with_riu_3_month_ago_profit(qs: QuerySet) -> QuerySet:
        return BrandProductVariantSortField.qs_with_riu_month_profit(qs, 3)


