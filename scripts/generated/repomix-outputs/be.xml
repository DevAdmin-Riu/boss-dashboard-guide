        instance = super().construct_instance(info, instance, cleaned_data)
        inquiry_path = cleaned_data.get("inquiry_path")
        if inquiry_path == "myfcha":
            instance.inquiry_path = InquiryPathType.MY_FCHA
        elif inquiry_path == "riuhomepage":
            instance.inquiry_path = InquiryPathType.RIU_HOMEPAGE
        elif inquiry_path == "emailmarketing":
            instance.inquiry_path = InquiryPathType.EMAIL_MARKETING
        elif inquiry_path == "kfranchise":
            instance.inquiry_path = InquiryPathType.K_FRANCHISE
        else:
            instance.inquiry_path = InquiryPathType.NONE
        return instance

    @classmethod
    def clean_input(cls, info, instance, data):
        phone = data.get("phone")
        if phone:
            try:
                data["phone"] = validate_possible_number(phone)
            except ValidationError as exc:
                phoneValidErrorMsg = "번호를 다시 확인해주세요."
                raise ValidationError(
                    {"phone": ValidationError(f"'{phone}' {phoneValidErrorMsg}", code=exc.code)}
                ) from exc

        return super().clean_input(info, instance, data, input_cls=None)
