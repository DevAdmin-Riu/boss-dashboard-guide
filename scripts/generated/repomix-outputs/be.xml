from django.db.models import Case, Count, F, IntegerField, Q, Sum, Value, When
from django.db.models.functions import Coalesce, Round

from ....bbs.models import Brand as BrandModel
from ....core.prices import calc_vat_by_price_include_vat
from ....stats import SalesB2bStatus
from ....warehouse.actions import to_datetime_astimezone
from ...utils.filters import filter_by_query_param, filter_range_field
from ..brand.schema import StatsBrandQueries
from .types import B2bSalesStatsByBrand


def resolve_b2b_sales_stats_by_brand(_info, filter, **_kwargs):
    stat_date = filter.get("stat_date")
    brand_search = filter.get("brand_search")
    b2b_pay_methods = filter.get("b2b_pay_methods")

    # FBV 제외 조건
    FBV_CONDITION = Q(variant__product__is_fulfilled_by_vendor=True)

    # 금액 집계용 Case/When 헬퍼 함수
    def create_sales_sum(field_name, filter_condition):
        return Sum(field_name, filter=filter_condition)

    qs = StatsBrandQueries.sales_qs_exclude_canceled()

    if brand_search:
        brand_search_fields = [
            "brand__code",
            "brand__name",
        ]
        qs = filter_by_query_param(qs, brand_search, brand_search_fields)

    if b2b_pay_methods:
        qs = qs.filter(brand__b2b_pay_method__in=b2b_pay_methods)

    qs = (
        qs.annotate(b2b_delivery_fee_total=Round(F("b2b_delivery_fee_exclude_vat") * 1.1))
        .annotate(
            taxable_total=Case(
                When(is_tax_free=False, then=F("quantity") * F("unit_price")),
                default=Value(0),
                output_field=IntegerField(),
            )
        )
        .annotate(
            taxfree_total=Case(
                When(
                    is_tax_free=True,
                    then=F("quantity") * F("unit_price"),
                ),
                default=Value(0),
                output_field=IntegerField(),
            )
        )
    )

    # Exclude FBV purchases
    qs = qs.exclude(FBV_CONDITION)

    brand_ids = qs.values_list("brand_id", flat=True).distinct()
    brands = BrandModel.objects.filter(id__in=brand_ids)
    brand_map = {b.id: b for b in brands}

    # 납품일(b2b_invoice_printed_at) 기준
    total_sales_qs = qs
    if stat_date:
        stat_datetime_gte = to_datetime_astimezone(stat_date.get("gte"))
        stat_datetime_lte = to_datetime_astimezone(stat_date.get("lte"), True)

        if stat_datetime_gte:
            total_sales_qs = total_sales_qs.filter(b2b_invoice_printed_at__gte=stat_datetime_gte)
        if stat_datetime_lte:
            total_sales_qs = total_sales_qs.filter(b2b_invoice_printed_at__lte=stat_datetime_lte)

    # 마감일(sales_close_date) 기준
    closed_sales_qs = qs.filter(b2b_status=SalesB2bStatus.CLOSED)
    closed_sales_qs = (
        filter_range_field(closed_sales_qs, "sales_close_date", stat_date)
        if stat_date
        else closed_sales_qs
    )

    # Filter 조건 준비
    total_filter = Q(id__in=total_sales_qs.values("id"))
    closed_filter = Q(id__in=closed_sales_qs.values("id"))

    brand_stats = (
        qs.values(
            "brand_id",
        )
        .order_by()
        .annotate(
            total_b2b_delivery_fee=create_sales_sum("b2b_delivery_fee_total", total_filter),
            total_taxable_amount=create_sales_sum("taxable_total", total_filter),
            total_taxfree_amount=create_sales_sum("taxfree_total", total_filter),
            total_closed_b2b_delivery_fee=create_sales_sum("b2b_delivery_fee_total", closed_filter),
            total_closed_taxable_amount=create_sales_sum("taxable_total", closed_filter),
            total_closed_taxfree_amount=create_sales_sum("taxfree_total", closed_filter),
        )
    )

    results = []
    for stats in brand_stats:
        brand_id = stats["brand_id"]
        brand = brand_map.get(brand_id)

        if not brand:
            continue

        total_taxable = (stats["total_taxable_amount"] or 0) + (
            stats["total_b2b_delivery_fee"] or 0
        )
        total_taxfree = stats["total_taxfree_amount"] or 0
        total_sales_amount = total_taxable + total_taxfree
        total_closed_taxable = (stats["total_closed_taxable_amount"] or 0) + (
            stats["total_closed_b2b_delivery_fee"] or 0
        )
        total_closed_taxfree = stats["total_closed_taxfree_amount"] or 0
        total_closed_sales_amount = total_closed_taxable + total_closed_taxfree

        if total_sales_amount == 0 and total_closed_sales_amount == 0:
            continue

        total_sales_vat = calc_vat_by_price_include_vat(total_taxable, False)
        total_closed_sales_vat = calc_vat_by_price_include_vat(total_closed_taxable, False)
        total_amount_exclude_vat = total_sales_amount - total_sales_vat
        total_closed_amount_exclude_vat = total_closed_sales_amount - total_closed_sales_vat

        results.append(
            B2bSalesStatsByBrand(
                brand_code=brand.code,
                brand_name=brand.name,
                brand_b2b_pay_method=brand.b2b_pay_method,
                total_sales_amount_exclude_vat=total_amount_exclude_vat,
                total_sales_vat=total_sales_vat,
                total_sales_amount=total_sales_amount,
                total_closed_sales_amount_exclude_vat=total_closed_amount_exclude_vat,
                total_closed_sales_vat=total_closed_sales_vat,
                total_closed_sales_amount=total_closed_sales_amount,
            )
        )

    return results
