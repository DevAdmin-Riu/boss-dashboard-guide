"""Checkout-related ORM models."""

from decimal import Decimal
from operator import attrgetter
from typing import TYPE_CHECKING, Optional
from uuid import uuid4

from django.conf import settings
from django.core.exceptions import ValidationError
from django.core.serializers.json import DjangoJSONEncoder
from django.db import models
from django.db.models import JSONField  # type: ignore
from django.utils.encoding import smart_str
from django_countries.fields import Country, CountryField

from ..account.models import Address
from ..core.models import ModelWithMetadata
from ..core.utils.json_serializer import CustomJsonEncoder
from ..order import ORDER_TYPES_FOR_B2B, FulfillType, OrderDeliveryMethods, OrderType
from ..product import ORDER_QTY_DECIMAL_PLACES, ORDER_QTY_MAX_DIGITS
from ..product.models import BpBundle
from ..vendor.models import Vendor

if TYPE_CHECKING:
    # flake8: noqa

    from ..payment.models import Payment
    from ..product.models import BrandProductPackage, BrandProductVariant, ProductVariant


class CheckoutQueryset(models.QuerySet):
    """A specialized queryset for dealing with checkouts."""

    def for_display(self):
        """Annotate the queryset for display purposes.

        Prefetches additional data from the database to avoid the n+1 queries
        problem.
        """
        return self.prefetch_related(
            "lines__variant__translations",
            "lines__variant__product__translations",
            "lines__variant__product__images",
            "lines__variant__product__product_type__product_attributes__values",
        )  # noqa


def get_default_country():
    return settings.DEFAULT_COUNTRY


class Checkout(ModelWithMetadata):
    """A shopping checkout."""

    created = models.DateTimeField(auto_now_add=True)
    last_change = models.DateTimeField(auto_now=True)
    # 장바구니에 저장되는 유저는 점주임 - 현재 직원과 점주가 점주 장바구니 공유하는 기능이 버그난 상태임 (https://trello.com/c/6fqmyhLv 카드에서 수정 작업 필요)
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        blank=True,
        null=True,
        related_name="checkouts",
        on_delete=models.CASCADE,
    )
    token = models.UUIDField(primary_key=True, default=uuid4, editable=False)
    quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
        default=0,
    )
    shipping_address = models.ForeignKey(
        Address, related_name="+", editable=False, null=True, on_delete=models.SET_NULL
    )
    # CheckoutCreateByStaff 호출 시, 업무 참고 사항으로 checkout 에 기록 => order 생성 시 checkout.staff_note 로 값 세팅
    staff_note = models.TextField(blank=True, default="")
    note = models.TextField(blank=True, default="")

    currency = models.CharField(
        max_length=settings.DEFAULT_CURRENCY_CODE_LENGTH,
        default=settings.DEFAULT_CURRENCY,
    )
    country = CountryField(default=get_default_country)

    redirect_url = models.URLField(blank=True, null=True)
    tracking_code = models.CharField(max_length=255, blank=True, null=True)

    # 대행 주문을 다루기 위해서 checkout 에 order_type 을 기록 => order 생성 시 checkout.order_type 으로 값 세팅
    order_type = models.CharField(
        max_length=30,
        choices=OrderType.choices,
        default=OrderType.BY_USER,
    )
    # 오픈몰 대행 주문의 쇼핑몰 정보를 order 에 담기 위해 checkout 에 저장해 둠.
    etc_info = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)

    # 합포장 주문 처리를 위한 정보를 order 에 담은 후 합포장 박스별 출고 처리에 이용
    """
    {
        "boxes": [
            {
                "index": 1,
                "lines": [
                    {
                        "sku": "A",
                        "quantity": 1,
                    },
                    {
                        "sku": "B",
                        "quantity": 2,
                    }
                ],
            },
            {
                "index": 2,
                "lines": [
                    {
                        "sku": "A",
                        "quantity": 1,
                    },
                    {
                        "sku": "C",
                        "quantity": 1,
                    }
                ],
            },
        ]
    }
    """
    picking_info = JSONField(blank=True, default=dict, encoder=DjangoJSONEncoder)

    # alt_invoicee_biz_info 에 biz_reg_no (사업자등록번호), biz_corp_name (상호), biz_ceo_name (대표자명) 필드가 있고 그 값이 있는 경우
    # 매장 세금계산서 공급받는자 정보를 user 정보 대신 이 정보로 대체함
    alt_invoicee_biz_info = JSONField(blank=True, default=dict, encoder=CustomJsonEncoder)
    tax_invoice_request_flag = models.BooleanField(blank=True, default=True)

    delivery_method = models.CharField(
        max_length=30,
        choices=OrderDeliveryMethods.choices,
        default=OrderDeliveryMethods.BY_COURIER,
    )
    fulfill_type = models.CharField(
        max_length=30,
        choices=FulfillType.choices,
        default=FulfillType.AS_IS,
    )
    # 대행주문에서 도착 예정일  또는 보스몰 주문에서 패키지 상품 도착 예정일 값 입력시 기록
    estimated_arrival_date = models.DateField(null=True, blank=True)
    # 택배배송이 아닌 경우 기타 배송비 외 도서산간지역인 경우 추가요금
    additional_fee_for_etc_delivery = models.IntegerField(default=0)

    objects = CheckoutQueryset.as_manager()

    class Meta:
        ordering = ("-last_change", "pk")
        constraints = [
            # 아래 Constraint는 0072 migration에서 Deferrable, deferred로 변경됨
            models.UniqueConstraint(
                fields=["user"],
                name="unique_user_checkout",
            )
        ]

    def __repr__(self):
        return "Checkout(quantity=%s)" % (self.quantity,)

    def __iter__(self):
        return iter(self.lines.all())

    @property
    def is_b2b_order(self):
        return self.order_type in ORDER_TYPES_FOR_B2B

    def get_selected_lines(self):
        return self.lines.filter(is_selected=True).all()

    def is_direct_shipping(self) -> bool:
        """Return `True` if any of the lines is direct shipping product."""
        return any(line.is_direct_shipping() for line in self)

    def get_line(self, variant: "ProductVariant") -> Optional["CheckoutLine"]:
        """Return a line matching the given variant and data if any."""
        matching_lines = (line for line in self if line.variant.pk == variant.pk)
        return next(matching_lines, None)

    def get_last_active_payment(self) -> Optional["Payment"]:
        payments = [payment for payment in self.payments.all() if payment.is_active]
        return max(payments, default=None, key=attrgetter("pk"))

    def set_country(self, country_code: str, commit: bool = False, replace: bool = True):
        """Set country for checkout."""
        if not replace and self.country is not None:
            return
        self.country = Country(country_code)
        if commit:
            self.save(update_fields=["country"])

    def get_country(self):
        address = self.shipping_address
        saved_country = self.country
        if address is None or not address.country:
            return saved_country.code

        country_code = address.country.code
        if country_code != saved_country.code:
            self.set_country(country_code, commit=True)
        return country_code

    def is_for_credits_refill_checkout(self):
        is_for_credits_refill = [
            False if line.bp_bundle else line.variant.is_for_credits_refill for line in self
        ]
        return any(is_for_credits_refill), all(is_for_credits_refill)


class CheckoutLine(models.Model):
    """A single checkout line.

    Multiple lines in the same checkout can refer to the same product variant if
    their `data` field is different.
    """

    checkout = models.ForeignKey(Checkout, related_name="lines", on_delete=models.CASCADE)
    # 일반 상품, 패키지 상품인 경우 pv 단위로 checkout_line 에 기록
    variant = models.ForeignKey(
        "product.ProductVariant", related_name="+", null=True, blank=True, on_delete=models.CASCADE
    )
    # 브랜드 세트 상품인 경우에는 pv 대신 bp_bundle 을 checkout_line에 기록
    bp_bundle = models.ForeignKey(
        "product.BpBundle", related_name="+", null=True, blank=True, on_delete=models.CASCADE
    )
    quantity = models.DecimalField(
        max_digits=ORDER_QTY_MAX_DIGITS,
        decimal_places=ORDER_QTY_DECIMAL_PLACES,
    )
    # 대행주문인 경우 주문등록 시 입력된 판매가로 판매를 위해 가격 저장함. 일반 주문에서는 사용하지 않음
    price = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=Decimal("0.0"),
    )
    price_vat = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=Decimal("0.0"),
    )
    # 일반 주문은 항상 True, 일괄 대행 주문인 경우 양식에 True, False 로 입력된 대로 처리
    calc_mileage = models.BooleanField(default=True)
    # 재고 관리에 사용되는 판매량 집계에서 제외되는 주문 여부, 기본값은 False
    exclude_stock_avg_stats = models.BooleanField(default=False)
    # 기타 배송 주문의 재고 제품에서만 사용되는 필드: True 인 경우 재고 감소, False 인 경우 재고 감소 없음
    decrease_stock_flag = models.BooleanField(default=True)
    is_selected = models.BooleanField(default=False)

    # delivery_method가 default인 택배배송이 아닌 경우(퀵, 화물차 등) 비용
    etc_delivery_fee = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )
    # b2b 주문의 배송비 (부가세별도)
    b2b_delivery_fee_exclude_vat = models.DecimalField(
        max_digits=settings.DEFAULT_MAX_DIGITS,
        decimal_places=settings.DEFAULT_DECIMAL_PLACES,
        default=0,
    )

    brand_product_package = models.ForeignKey(
        "product.BrandProductPackage", on_delete=models.CASCADE, related_name="+", null=True
    )
    # 장바구니에 담는 시점에 brand_product_variant 저장해야함. 해당 bpv의 brand값 과는 다를 수 있음. 담는 시점의 값임.
    brand_product_variant = models.ForeignKey(
        "product.BrandProductVariant",
        related_name="+",
        on_delete=models.CASCADE,
        null=True,
        blank=True,
    )

    delivery_request_date = models.DateField(null=True, blank=True)

    # 직거래 상품 시스템을 위해 checkout 구조 확장: null 인 경우 협력사가 없는 포장보스 주문, null 이 아닌 경우 협력사가 있는 직거래 주문
    vendor = models.ForeignKey(
        Vendor,
        blank=True,
        null=True,
        related_name="+",
        on_delete=models.CASCADE,
    )

    class Meta:
        unique_together = ("checkout", "variant", "brand_product_package")
        ordering = ("id",)

    def save(self, *args, **kwargs):
        if not self.pk:
            user = self.checkout.user
            if user and (
                user.is_brand_user
                and not user.is_brand_store_owner
                and not user.is_hq_staff
                and not user.is_staff
            ):
                raise ValidationError("일반 직원은 장바구니 담기 불가합니다.")

        if self.variant:
            if (self.vendor is None) != (not self.variant.product.is_fulfilled_by_vendor):
                raise ValidationError("직배송 제품 여부와 협력사 여부가 일치하지 않습니다.")

            if self.checkout.order_type in [
                OrderType.BY_STAFF_FOR_B2B,
                OrderType.BY_STAFF_FOR_B2B_TAKE_BACK,
            ]:
                if self.variant.product.is_fulfilled_by_vendor:
                    raise ValidationError("협력사 직배송 제품은 B2B 주문에 담을 수 없습니다.")

            if not self.pk and not self.delivery_request_date:
                # 장바구니 담는 시점에 만약 checkout.lines에 동일한 vendor_id를 가진 line이 delivery_request_date를 가지고 있다면 그 값으로 업데이트를 한다.
                existing_line = self.checkout.lines.filter(
                    is_selected=True, vendor_id=self.vendor_id, delivery_request_date__isnull=False
                ).first()
                if existing_line:
                    self.delivery_request_date = existing_line.delivery_request_date

        super().save(*args, **kwargs)

    def __str__(self):
        return smart_str(self.variant)

    __hash__ = models.Model.__hash__

    def __eq__(self, other):
        if not isinstance(other, CheckoutLine):
            return NotImplemented

        return self.variant == other.variant and self.quantity == other.quantity

    def __ne__(self, other):
        return not self == other  # pragma: no cover

    def __repr__(self):
        return "CheckoutLine(variant=%r, quantity=%r, brand_product_package=%r)" % (
            self.variant,
            self.quantity,
            self.brand_product_package,
        )

    def __getstate__(self):
        return self.variant, self.quantity

    def __setstate__(self, data):
        self.variant, self.quantity = data

    def is_direct_shipping(self) -> bool:
        """Return `True` if the related product is direct shipping."""
        if self.variant and self.variant.product:
            return self.variant.product.is_direct_shipping
        return False

    @property
    def need_delivery_additional_fee(self) -> bool:
        bp_bundle: BpBundle = self.bp_bundle
        if bp_bundle:
            return bp_bundle.need_delivery_additional_fee
        variant: ProductVariant = self.variant
        bpv: BrandProductVariant = self.brand_product_variant
        need_delivery_additional_fee_from_bpv = bpv.need_delivery_additional_fee if bpv else True
        return variant.need_delivery_additional_fee and need_delivery_additional_fee_from_bpv

    @property
    def is_fulfilled_by_vendor(self):
        return self.vendor is not None
