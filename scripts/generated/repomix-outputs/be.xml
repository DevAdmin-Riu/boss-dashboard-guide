def set_productvariant_is_sales_surge(initial_sales_surge_variants):
    from ..stats.tasks import get_stock_control_filtered_pv_qs

    n = 15
    today = kst_timezone_date()
    n_days_ago = today - timedelta(days=n)

    pv_qs = get_stock_control_filtered_pv_qs()
    pv_qs = pv_qs.filter(first_available_for_purchase__lt=n_days_ago)
    pv_list = list(pv_qs)
    pv_ids = [pv.id for pv in pv_list]
    # 소진 임박 상태 예외 제품들은 모두 소진 임박 아님으로 변경
    ProductVariant.objects.exclude(id__in=pv_ids).filter(is_sales_surge=True).update(
        is_sales_surge=False
    )

    initial_ids = (
        {pv.id for pv in initial_sales_surge_variants} if initial_sales_surge_variants else set()
    )
    update_list = []
    new_sales_surge_variant_dict_list = []
    for pv in pv_list:
        combined_last_15_days_avg_sales_daily_qty = get_avg_sales_combined_qty_consider_inner(
            pv, "last_15_days_avg_sales_daily_qty"
        )
        if combined_last_15_days_avg_sales_daily_qty is None:
            continue

        orderable_qty_incl_short_term = (
            get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
                pv, until_short_term=True
            )
        )
        po_lead_time = get_po_lead_time_consider_inner(pv)
        priority_level = get_priority_level_consider_inner(pv)
        stock_adjust_factor = get_stock_adjust_factor_consider_inner(pv)
        is_sales_surge = (
            combined_last_15_days_avg_sales_daily_qty * po_lead_time > orderable_qty_incl_short_term
        )
        pv.is_sales_surge = is_sales_surge
        update_list.append(pv)
        if is_sales_surge and pv.id not in initial_ids:
            inner = pv.inner
            variant_dict = {}
            attribute_data = convert_to_simple_attribute(pv)
            total_stock_qty = (
                get_total_stock_qty_to_outer_base_consider_inner_using_prefetched_data(pv)
            )
            is_inner = pv.is_inner
            prefetched_to_be_stocked_po_lines = (
                getattr(pv, "prefetched_outer_to_be_stocked_po_lines", [])
                if is_inner
                else getattr(pv, "prefetched_to_be_stocked_po_lines", [])
            )
            prefetched_latest_stocked_po_lines = (
                getattr(pv, "prefetched_outer_latest_stocked_po_lines", [])
                if is_inner
                else getattr(pv, "prefetched_latest_stocked_po_lines", [])
            )
            qty_to_be_stocked_long_term = get_qty_to_be_stocked_by_prefetched_data(
                prefetched_to_be_stocked_po_lines, False
            )
            latest_stocked_po_line = get_latest_stocked_po_line_by_prefetched_data(
                prefetched_latest_stocked_po_lines
            )
            orderable_qty_incl_long_term = (
                get_orderable_qty_to_outer_base_by_prefetched_data_consider_inner(
                    pv, until_short_term=False
                )
            )
            est_shortage_info = calc_est_shortage_info(
                variant=pv,
                total_stock_qty=total_stock_qty,
                latest_stocked_po_line=latest_stocked_po_line,
                detail_info_mode=True,
                qty_to_be_stocked_long_term=qty_to_be_stocked_long_term,
                orderable_qty_incl_long_term=orderable_qty_incl_long_term,
            )
            stock_status_text, _ = term_of_stock_status_by_est_shortage_enum(
                pv.stock_status_by_daily
            )
            variant_dict["sku"] = pv.sku
            variant_dict["product_name"] = pv.product.name
            variant_dict["variant_name"] = pv.name_for_email
            variant_dict["spec_text"] = make_product_spec_text_by_attribute(attribute_data)
            variant_dict["is_safety"] = term_of_is_safety(pv)
            variant_dict["need_to_reorder_7"] = term_of_need_to_reorder(pv.need_to_reorder_7)
            variant_dict["need_to_reorder_15"] = term_of_need_to_reorder(pv.need_to_reorder_15)
            variant_dict["need_to_reorder_30"] = term_of_need_to_reorder(pv.need_to_reorder_30)
            variant_dict["stock_status"] = stock_status_text
            variant_dict["need_to_reorder_date"] = (
                est_shortage_info.need_to_reorder_date.strftime("%Y-%m-%d")
                if est_shortage_info.need_to_reorder_date
                else "-"
            )
            variant_dict["est_shortage_date"] = (
                est_shortage_info.est_shortage_date.strftime("%Y-%m-%d")
                if est_shortage_info.est_shortage_date
                else "-"
            )
            variant_dict["est_shortage_date_incl_long_term_qty"] = (
                est_shortage_info.est_shortage_date_incl_long_term_qty.strftime("%Y-%m-%d")
                if est_shortage_info.est_shortage_date_incl_long_term_qty
                else "-"
            )
            variant_dict["po_lead_time"] = po_lead_time if po_lead_time is not None else "-"
            variant_dict["priority_level"] = (
                term_of_priority_level(priority_level) if priority_level is not None else "-"
            )
            variant_dict["stock_adjust_factor"] = (
                stock_adjust_factor if stock_adjust_factor is not None else "-"
            )
            variant_dict["safety_stock_qty"] = (
                pv.safety_stock_qty if pv.safety_stock_qty is not None else "-"
            )
            variant_dict["rop_7"] = pv.rop_7 if pv.rop_7 is not None else "-"
            variant_dict["rop_15"] = pv.rop_15 if pv.rop_15 is not None else "-"
            variant_dict["rop_30"] = pv.rop_30 if pv.rop_30 is not None else "-"
            variant_dict["orderable_qty_incl_short_term"] = orderable_qty_incl_short_term
            variant_dict["last_7_days_avg_sales_daily_qty"] = (
                get_avg_sales_seperated_qty_consider_inner(pv, "last_7_days_avg_sales_daily_qty")
                or "-"
            )
            variant_dict["last_15_days_avg_sales_daily_qty"] = (
                get_avg_sales_seperated_qty_consider_inner(pv, "last_15_days_avg_sales_daily_qty")
                or "-"
            )
            variant_dict["last_30_days_avg_sales_daily_qty"] = (
                get_avg_sales_seperated_qty_consider_inner(pv, "last_30_days_avg_sales_daily_qty")
                or "-"
            )
            variant_dict["last_3_months_avg_sales_daily_qty"] = (
                get_avg_sales_seperated_qty_consider_inner(pv, "last_3_months_avg_sales_daily_qty")
                or "-"
            )
            variant_dict["combined_last_7_days_avg_sales_daily_qty"] = (
                (
                    get_avg_sales_combined_qty_consider_inner(pv, "last_7_days_avg_sales_daily_qty")
                    or "-"
                )
                if inner is not None
                else "-"
            )
            variant_dict["combined_last_15_days_avg_sales_daily_qty"] = (
                (combined_last_15_days_avg_sales_daily_qty) if inner is not None else "-"
            )
            variant_dict["combined_last_30_days_avg_sales_daily_qty"] = (
                (
                    get_avg_sales_combined_qty_consider_inner(
                        pv, "last_30_days_avg_sales_daily_qty"
                    )
                    or "-"
                )
                if inner is not None
                else "-"
            )
            variant_dict["combined_last_3_months_avg_sales_daily_qty"] = (
                (
                    get_avg_sales_combined_qty_consider_inner(
                        pv, "last_3_months_avg_sales_daily_qty"
                    )
                    or "-"
                )
                if inner is not None
                else "-"
            )
            new_sales_surge_variant_dict_list.append(variant_dict)

    update_fields = ["is_sales_surge"]
    ProductVariant.objects.bulk_update(update_list, update_fields)

    return new_sales_surge_variant_dict_list


@app.task(name="product.tasks.check_productvariant_is_sales_surge")
def check_productvariant_is_sales_surge():
    initial_sales_surge_variants = list(ProductVariant.objects.filter(is_sales_surge=True))
    new_sales_surge_variant_dict_list = set_productvariant_is_sales_surge(
        initial_sales_surge_variants
    )
    if new_sales_surge_variant_dict_list:
        send_templated_mail_new_sales_surge_variants.delay(new_sales_surge_variant_dict_list)

    logger.info(
        f"check_productvariant_is_sales_surge done. new_sales_surge_variants count: {len(new_sales_surge_variant_dict_list)}"
    )


@app.task(name="product.tasks.set_pv_stock_status_by_daily")
