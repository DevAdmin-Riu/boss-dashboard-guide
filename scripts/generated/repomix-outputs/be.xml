    )
    exclusive = django_filters.BooleanFilter(method=filter_brand_product_exclusive)
    product_exclusive = django_filters.BooleanFilter(method=filter_product_exclusive)
    is_inner = django_filters.BooleanFilter(method=filter_is_inner)
    is_only_payable_by_cash = django_filters.BooleanFilter(method=filter_is_only_payable_by_cash)
    pv_sales_status = ListObjectTypeFilter(
