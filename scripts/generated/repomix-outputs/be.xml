@app.task(name="account.tasks.send_reverse_fee_deposit_email")
def send_reverse_fee_deposit_email():
    # 메일 타이틀 설정
    mail_title_for_log = "매출인식몰 브랜드 외상 상환 알림 발송"
    regular_mail_title_for_log = "매출인식몰 브랜드 외상 상환 알림 발송(정기)"

    # 대상 브랜드: 계약 타입이 REVERSE_FEE이며, reverse_fee_deposit가 alarm_threshold 미만인 경우
    targets_qs = Brand.objects.filter(
        contract_type=BrandContractType.REVERSE_FEE,
        reverse_fee_deposit__lt=F("reverse_fee_deposit_alarm_threshold"),
    )
    target_brands = list(targets_qs)

    # 날짜 계산
    today = datetime.today().date()
    last_day_of_month = calendar.monthrange(today.year, today.month)[1]
    yesterday = today - timedelta(days=1)
    # 오늘 00시 즉 어제 밤 12시
    naive_yesterday_midnight = datetime.combine(today, datetime.min.time())
    yesterday_midnight = timezone.make_aware(
        naive_yesterday_midnight, timezone.get_current_timezone()
    )

    for target_brand in target_brands:
        allowed_days = target_brand.reverse_fee_deposit_alarm_days  # 예: ['21', '15', 'END']
        if allowed_days:
            # allowed_days가 있는 경우, 오늘 날짜가 조건에 맞는지 확인
            # 먼저, 오늘의 날짜를 문자열로 변환
            today_day_str = str(today.day)

            # 이전 달의 날짜 계산
            first_day_current_month = today.replace(day=1)
            last_day_prev_month_date = first_day_current_month - timedelta(days=1)
            last_day_prev_month = last_day_prev_month_date.day

            # 조건: 오늘 날짜가 allowed_days에 포함되거나,
            # allowed_days에 'END'가 포함되고 오늘이 이번 달 마지막 날인 경우
            if today_day_str in allowed_days or (
                "END" in allowed_days and today.day == last_day_of_month
            ):
                # 만약 allowed_days에 오늘 날짜보다 작은 값이 존재한다면 그 작은값들중에 제일 작은 값들을 추출한다.
                potential_start_day = [
                    day for day in allowed_days if day.isdigit() and int(day) < today.day
                ]
                if potential_start_day:
                    # 만약 존재한다면 이번달의 해당 날짜에 해당하는 값이 start_date이다.
                    start_date = date(today.year, today.month, int(potential_start_day[-1]))
                else:
                    # allowed_days 값을 기반으로 후보값을 구성 (숫자형은 int, 'END'는 이전 달 마지막일)
                    candidate_days = []
                    for day in allowed_days:
                        if day == "END":
                            candidate_days.append(last_day_prev_month)
                        elif day.isdigit():
                            candidate_days.append(int(day))
                    # 결정: allowed_days에 값이 있다면 가장 큰 값을 사용
                    if candidate_days:
                        chosen_day = max(candidate_days)
                        start_date = date(
                            last_day_prev_month_date.year,
                            last_day_prev_month_date.month,
                            chosen_day,
                        )
                    else:
                        start_date = first_day_current_month  # fallback

                # 정산 이메일 발송 로직
                # 어제 밤 12시 기준 이전에 생성된 정산 이벤트(BrandReverseFeeDepositEvent) 중 최신 항목을 조회
                event_end = (
                    BrandReverseFeeDepositEvent.objects.filter(
                        brand=target_brand, created__lt=yesterday_midnight
                    )
                    .order_by("-created")
                    .first()
                )
                start_date_dt = datetime.combine(start_date, time.min)
                start_date_with_zone = timezone.make_aware(
                    start_date_dt, timezone.get_current_timezone()
                )
                event_start = (
                    BrandReverseFeeDepositEvent.objects.filter(
                        brand=target_brand, created__lt=start_date_with_zone
                    )
                    .order_by("-created")
                    .first()
                )
                # event_start와 event_end사이의 event 중 event_type이 DEPOSIT인 것들의 qty의 핪.
                event_sum = BrandReverseFeeDepositEvent.objects.filter(
                    brand=target_brand,
                    created__gte=start_date_with_zone,
                    created__lt=yesterday_midnight,
                    event_type=BrandReverseFeeDepositEventType.INCREASE,
                )
                event_sum = event_sum.aggregate(Sum("qty"))["qty__sum"] or 0

                if event_end:
                    asking_amount_money = -event_end.qty_after
                else:
                    asking_amount_money = 0

                if event_start:
                    asking_amount_money += event_start.qty_after

                if event_sum:
                    asking_amount_money += event_sum

                # 정산계좌: RiuVact 모델에서 acct_st가 ASSIGNED인 데이터 중 해당 브랜드의 계좌번호
                vact = RiuVact.objects.filter(
                    brand=target_brand, acct_st=AccountStatus.ASSIGNED.value
                ).first()
                bank_account = vact.acct_no if vact else "-"
                start_date_str = start_date.strftime("%Y-%m-%d")
                end_date_str = yesterday.strftime("%Y-%m-%d")
                location = (
                    f"hq/info/reverse-fee?createFrom={start_date_str}&createTo={end_date_str}"
                )
                button_url = build_absolute_dashboard_uri(location)

                send_kwargs, ctx = get_email_context()
                context = {
                    "brand_name": target_brand.name,
                    "start_date": start_date_str,
                    "end_date": end_date_str,
                    "asking_amount_money": f"{asking_amount_money:,}",
                    "bank_account": f"{bank_account} 신한은행 예금주:(주)리우",
                    "button_url": button_url,
                }
                ctx.update(context)
                send_templated_mail_consider_test_mode(
                    mail_title_for_log=regular_mail_title_for_log,
                    template_name="account/reverse_fee_deposit_insufficient_alarm_regularly",
                    recipient_list=get_brand_boss_mall_person_email_list(target_brand),
                    context=ctx,
                    **get_email_context()[0],
                )
                logger.info(
                    f"{target_brand.name}: {start_date_str} ~ {end_date_str} 기간의 정산금액이 {asking_amount_money}원으로 "
                    f"알람 발송 완료."
                )
            else:
                # 오늘 날짜가 allowed_days 조건에 해당하지 않으면 이메일 발송하지 않음
                continue
        else:
            # allowed_days가 비어 있으면 기존 이메일 발송 로직 실행
            recipient_list = get_brand_boss_mall_person_email_list(target_brand)
            if not recipient_list:
                logger.error(f"{target_brand.name}: 브랜드 담당자 메일 설정이 안되어 발송 불가.")
                continue
            send_kwargs, ctx = get_email_context()
            context = {
                "brand_name": target_brand.name,
            }
            ctx.update(context)
            send_templated_mail_consider_test_mode(
                mail_title_for_log=mail_title_for_log,
                template_name="account/reverse_fee_deposit_insufficient_alarm",
                recipient_list=recipient_list,
                context=ctx,
                **send_kwargs,
            )
            logger.info(f"{target_brand.name}: 정기적인 외상 상환 알림 발송 완료.")


@app.task(name="account.tasks.send_brand_contract_end_date_alarm")
def send_brand_contract_end_date_alarm():
    mail_title_for_log = "계약 종료 마감 알림 발송"

    contract_manager_list = get_contract_manager_email_list()

    today = timezone.now().date()
    target_date_after_30 = today + timedelta(days=30)
    target_date_after_60 = today + timedelta(days=60)

    target_date_filter = Q(end_date__isnull=False) & (
        Q(end_date__exact=target_date_after_30) | Q(end_date__exact=target_date_after_60)
    )

    targets_qs = BrandEtcFile.objects.exclude(
        Q(brand__is_running=False) | Q(brand__contract_status=BrandContractStatus.EXPIRED)
    ).filter(target_date_filter)

    targets = list(targets_qs)

    logger.info(f"send_brand_contract_end_date_alarm targets count: {len(targets)}")

    for target in targets:
        brand: Brand = target.brand
        if not brand:
            continue

        contract_type = terms_of_brand_etc_file_type(target.type, only_contract_alarm=True)
        if not contract_type:
            continue

        # 60일 전인 경우에만 상태 변경
        if target.end_date == target_date_after_60:
            if brand.contract_status == BrandContractStatus.RUNNING:
                brand.contract_status = BrandContractStatus.CONTRACT_WARNING
                brand.save(update_fields=["contract_status"])
                logger.info(f"{brand.name} 브랜드의 계약 상태를 '갱신 임박'으로 변경했습니다.")

        recipient_list = copy.deepcopy(contract_manager_list)

        staff: User = brand.staff
        if staff and staff.email:
            if staff.email:
                recipient_list.append(staff.email)

        context = {
            "brand_name": brand.name,
            "contract_type": contract_type,
            "end_date": target.end_date,
        }

        if len(recipient_list) == 0:
            logger.error(
                f"{mail_title_for_log}을 위한 계약담당자 이메일 설정을 확인하세요. {context}"
            )
            continue

        send_kwargs, ctx = get_email_context()
        ctx.update(context)
        send_templated_mail_consider_test_mode(
            mail_title_for_log=mail_title_for_log,
            template_name="account/brand_contract_end_date_alarm",
            recipient_list=recipient_list,
            context=ctx,
            **send_kwargs,
        )


@app.task(name="account.tasks.send_15days_before_deactivate_alarm")
def send_15days_before_deactivate_alarm():
    logger.info("send_15days_before_deactivate_alarm just started.")
    today = timezone.now()

    # 비활성화하기 6개월 전 날짜
    deactivate_check_date_time = today - timedelta(days=180)
    deactivate_check_date = deactivate_check_date_time.date()

    # 알람을 보내는날 비활성화 기준이 되는 날보다 15일 뒤여야함.
    alarm_check_date_time = deactivate_check_date_time + timedelta(days=15)
    alarm_check_date = alarm_check_date_time.date()

    # Checkout 모델에서 최신의 Checkout만 선택
    latest_checkouts = Checkout.objects.filter(user_id=OuterRef("user_id")).order_by("-created")

    # Checkout 모델에서 알람 해당 조건에 맞는 User 객체를 선택
    alarm_target_checkouts = (
        Checkout.objects.filter(
            pk=Subquery(latest_checkouts.values("pk")[:1])  # 최신 Checkout의 pk만 선택
        )
        .annotate(
            year=ExtractYear("created"),
            month=ExtractMonth("created"),
            day=ExtractDay("created"),
        )
        .filter(
            year=alarm_check_date.year,
            month=alarm_check_date.month,
            day=alarm_check_date.day,
        )
    )

    # 알림톡을 전송한다.
    estimated_deactivate_date_time = today + timedelta(days=15)
    estimated_deactivate_date_time_str = estimated_deactivate_date_time.strftime("%Y년 %m월 %d일")
    users_to_alarm_qs = User.objects.filter(
        checkouts__in=alarm_target_checkouts, is_active=True
    ).distinct()

    users_to_alarm = list(users_to_alarm_qs)
    logger.info(f"the number of users_to_alarm : {len(users_to_alarm)}")

    event_code = AligoEvents.DEACTIVATE_WARNING_ALARM
    exception_count = 0
    for user in users_to_alarm:
        try:
            logger.info(f"send alarm to user : {user}")
            parameters = {
                RECEIVER_PHONE: user.aligo_phone,
                "user_name": user.first_name,
                "deactivate_date": estimated_deactivate_date_time_str,
            }
            get_plugins_manager().send_kakaotalk(talk_event_code=event_code, parameters=parameters)
        except Exception as e:
            exception_count = exception_count + 1
            logger.error(f"send_15days_before_deactivate_alarm error: {e}")

    if exception_count > 0:
        logger.error(f"send_15days_before_deactivate_alarm exception_count: {exception_count}")

    # 각 유저별로 최신 Checkout을 가져옴
    latest_checkouts = (
        Checkout.objects.filter(
            pk=Subquery(latest_checkouts.values("pk")[:1])  # 최신 Checkout의 pk만 선택
        )
        .annotate(created_date=TruncDate("created"))  # DateTime -> Date 변환
        .filter(created_date__lt=deactivate_check_date)  # date 비교
    )

    # 비활성화 대상 유저 가져오기
    users_to_deactivate = (
        User.objects.filter(
            checkouts__in=latest_checkouts, is_staff=False, is_hq_staff=False, is_active=True
        )
        .exclude(last_login__gte=deactivate_check_date_time)
        .distinct()
    )

    # 로그 출력 (count() 사용)
    logger.info(f"the number of users_to_deactivate : {users_to_deactivate.count()}")

    # is_active 상태 업데이트
    users_to_deactivate.update(is_active=False)

    logger.info("send_15days_before_deactivate_alarm just ended")


@app.task(name="account.tasks.send_exclusive_product_info_to_brand")
def send_exclusive_product_info_to_brand():
    mail_title_for_log = "전용상품 현황 공유의 건 이메일 전송"

    brands: Brand = (
        Brand.objects.filter(
            contract_status=BrandContractStatus.RUNNING,
            people_in_charge_info__has_key="boss_mall",
        )
        .prefetch_related(
            Prefetch(
                "brand_product_variants",
                queryset=BrandProductVariant.objects.select_related(
                    "product_variant",
                    "brand_product",
                ).filter(
                    brand_product__is_exclusive=True,
                ),
                to_attr="brand_product_variants_prefetched",
            )
        )
        .all()
    )

    for brand in brands:
        recipient_list = get_brand_boss_mall_person_email_list(brand)
        if len(recipient_list) == 0:
            logger.error(
                f"{brand.name}: 전용상품 현황 공유의 건을 위한 브랜드 담당자 메일 설정이 안되어 발송 불가."
            )
            continue

        wb = export_monthly_exclusive_product_list_to_brand(brand.brand_product_variants_prefetched)
        if wb is None:
            logger.error(f"{brand.name}: 엑셀파일 생성 실패")
            continue

        file_stream = BytesIO()
        wb.save(file_stream)
        file_stream.seek(0)

        today = kst_timezone_now().strftime("%Y%m%d_%H%M%S")
        attach_file_name = f"{brand.name}_전용상품현황_{today}.xlsx"

        context = {"brand_name": brand.name, "dashboard_url": build_absolute_dashboard_uri()}

        send_kwargs, ctx = get_email_context()
        ctx.update(context)
        send_templated_mail_consider_test_mode(
            mail_title_for_log=mail_title_for_log,
            template_name="product/monthly_exclusive_product_list_to_brand",
            recipient_list=recipient_list,
            context=ctx,
            attachments=[
                (
                    attach_file_name,
                    file_stream.getvalue(),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                )
            ],
            **send_kwargs,
        )
        file_stream.close()
