                        or "-"
                    ),
                ),
                make_excel_cell_info(
                    title="아우터/이너 분리\n일평균 판매량\n(최근 15일)",
                    value=(
                        get_avg_sales_seperated_qty_consider_inner(
                            pv, "last_15_days_avg_sales_daily_qty"
