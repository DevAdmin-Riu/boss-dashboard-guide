            "quantity",
            "amount",
            "cashable_credits",
            "non_cashable_credits",
            "rcoins",
            "return_delivery_fee",
            "unit_price",
            "unit_delivery_fee",
            "unit_inner_incidental_cost",
            "brand_unit_cost_price",
            "brand_unit_delivery_fee",
            "tax_invoice_amount",
            "track_inventory",
            "is_tax_free",
            "is_exclusive",
            "brand",
            "order",
            "variant",
            "order_line",
            "refund_order_line",
            "issued_tax_invoice",
            "mileage_rate",
            "card_paying_charge_rate",
            "vbank_paying_charge_exclude_vat",
            "calc_mileage",
            "exclude_stock_avg_stats",
            "is_order_from_boss_mrkt",
            "is_fulfilled_by_vendor",
            "fulfill_vendor",
            "bp_sku",
        ]

    def resolve_bundle_other_sales(root: "SalesModel", info):
        if root.bp_bundle_id:
            return BundleOtherSalesByBpBundleIdLoader.exclude_sales(
                info.context, root.order_id, root.id
            ).load(root.bp_bundle_id)
        return None

    def resolve_type(root: "SalesModel", _info):
        return (
            SalesTypeEnum.REFUND if root.refund_order_line_id is not None else SalesTypeEnum.SALES
        )

    def resolve_issued_tax_invoice_id(root: "SalesModel", _info):
        if root.issued_tax_invoice_id:
            return graphene.Node.to_global_id("Sales", root.issued_tax_invoice_id)
        return None

    def resolve_variant(root: "SalesModel", info):
        if root.variant_id:
            return ProductVariantByIdLoader(info.context).load(root.variant_id)
        return None

    def resolve_is_mixed_track_inventory(root: "SalesModel", _info):
        return (
            OrderLineByIdLoader(_info.context)
            .load(root.order_line_id)
            .then(
                lambda order_line: FulfillmentLinesByOrderLineIdLoader(_info.context)
                .load(order_line.id)
                .then(
                    lambda fulfillment_lines: len({fl.track_inventory for fl in fulfillment_lines})
                    > 1
                )
            )
        )

    def resolve_brand(root: "SalesModel", info):
        if root.brand_id:
            return BrandByIdLoader(info.context).load(root.brand_id)
        return None

    def resolve_order(root: "SalesModel", info):
        if root.order_id:
            return OrderByIdLoader(info.context).load(root.order_id)
        return None

    def resolve_order_line(root: "SalesModel", info):
        if root.order_line_id:
            return OrderLineByIdLoader(info.context).load(root.order_line_id)
        return None

    def resolve_refund_order_line(root: "SalesModel", info):
        if root.refund_order_line_id:
            return RefundOrderLineByIdLoader(info.context).load(root.refund_order_line_id)
        return None

    def resolve_fulfill_vendor(root: "SalesModel", info):
        if root.fulfill_vendor_id:
            return VendorByIdLoader(info.context).load(root.fulfill_vendor_id)
        return None
