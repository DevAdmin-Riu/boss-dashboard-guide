class BundleOtherOrderLinesByBpBundleIdLoader(DataLoader):

    @classmethod
    def exclude_order_line(cls, context, order_id: int, order_line_id: int):
        context_key = f"bundle_other_order_lines_by_bp_bundle_id_{order_id}_{order_line_id}"
        loader = cls(context, context_key)
        loader.order_id = order_id
        loader.order_line_id = order_line_id
        return loader

    def batch_load(self, keys):
        order_id = self.order_id
        order_line_id = self.order_line_id

        order_lines = (
            OrderLine.objects.exclude(id=order_line_id)
            .filter(order_id=order_id, bp_bundle_id__in=keys)
            .order_by("pk")
        )
        other_order_lines_dict = defaultdict(list)

        for order_line in order_lines:
            other_order_lines_dict[order_line.bp_bundle_id].append(order_line)

        return [other_order_lines_dict[bp_bundle_id] for bp_bundle_id in keys]


