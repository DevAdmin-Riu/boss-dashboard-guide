class PreFounderConsultation(ConsultationModel):
    pre_founder = models.ForeignKey(
        PreFounder,
        on_delete=models.CASCADE,
        related_name="consultations",
    )
    method = models.CharField(max_length=20, choices=PreFounderConsultationMethod.choices)
    result = models.CharField(max_length=20, choices=PreFounderConsultationResult.choices)

    def __str__(self):
        return f"{self.pre_founder.name} - {self.title}"

    def save(self, *args, **kwargs):
        super().save(*args, **kwargs)

        pre_founder = self.pre_founder
        pre_founder_fields_to_update = []

        first = pre_founder.first_consultation
        last = pre_founder.last_consultation

        if (not first) or (self.consultation_date < first.consultation_date):
            pre_founder.first_consultation_id = self.pk
            pre_founder_fields_to_update.append("first_consultation_id")

        if (not last) or (self.consultation_date > last.consultation_date):
            pre_founder.last_consultation_id = self.pk
            pre_founder_fields_to_update.append("last_consultation_id")

        if pre_founder_fields_to_update:
            pre_founder.save(update_fields=pre_founder_fields_to_update)

    class Meta:
        ordering = ("-created_at",)


