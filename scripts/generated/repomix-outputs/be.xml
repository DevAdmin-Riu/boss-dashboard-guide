        stopped_reason=None,
        stopped_reason_etc=None,
    )


def set_variant_sales_status_on_out_of_stock(pv: "ProductVariant", user: "User" = None):
    prev_sales_status = pv.sales_status
    if prev_sales_status != SalesStatus.WILL_BE_STOPPED:
        return

    with transaction.atomic():
        pv.stopped_at = datetime.date.today()
        pv.sales_status = SalesStatus.STOPPED
        pv.save(update_fields=["stopped_at", "sales_status"])

        manage_event = {
            "type": ProductVariantManageEventType.TYPE_STATUS,
            "title": "자동 변경",
            "reason": "재고 소진",
            "change_details": "제품 상태 변경: 단종예정 -> 단종",
        }
        add_pv_manage_event(pv=pv, manage_event=manage_event, info=None, user=user)

        set_bpv_sales_status_on_pv_to_stopped(
            pv, pv.stopped_at, pv.stopped_reason, pv.stopped_reason_etc, user
        )


def set_variant_sales_status_on_non_out_of_stock(pv: "ProductVariant", user: "User" = None):
    prev_sales_status = pv.sales_status
    if prev_sales_status != SalesStatus.STOPPED:
        return

    with transaction.atomic():
        pv.stopped_at = None
        pv.sales_status = SalesStatus.WILL_BE_STOPPED
        pv.save(update_fields=["stopped_at", "sales_status"])

        manage_event = {
            "type": ProductVariantManageEventType.TYPE_STATUS,
            "title": "자동 변경",
            "reason": "재고 보충",
            "change_details": "제품 상태 변경: 단종 -> 단종예정",
        }
        add_pv_manage_event(pv=pv, manage_event=manage_event, info=None, user=user)

        set_bpv_sales_status_on_pv_from_stopped_to_non_stopped(pv, prev_sales_status, user)


