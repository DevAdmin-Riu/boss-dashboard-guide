import logging

from django.core.management.base import BaseCommand
from django.db import transaction

from saleor.ai.estimate_model import get_estimate_embedding_model

from ...models import PvEstimate

logger = logging.getLogger(__name__)


class Command(BaseCommand):
    help = "PvEstimate 객체의 임베딩을 재설정합니다. 이 명령은 모든 PvEstimate 객체에 대해 AI 임베딩을 다시 생성합니다."

    def handle(self, *args, **options):
        logger.info("--- PvEstimate 임베딩 재설정 작업을 시작합니다. ---")

        try:
            # 데이터베이스에서 모든 PvEstimate 객체를 가져옵니다.
            estimates = list(PvEstimate.objects.all())
            total_count = len(estimates)

            if not estimates:
                logger.warning("처리할 PvEstimate 객체가 없습니다.")
                return

            logger.info(f"Generating embeddings for {total_count} PvEstimate objects.")

            # 1. 임베딩을 생성할 텍스트를 준비합니다.
            texts_to_encode = [est.get_searchable_text() for est in estimates]

            # 2. 준비된 텍스트 목록 전체를 한 번에 인코딩합니다.
            ai_model = get_estimate_embedding_model()
            all_embeddings = ai_model.encode(
                texts_to_encode,
                batch_size=32,  # 시스템 사양에 따라 조절 가능
                show_progress_bar=True,  # 터미널에 진행 상황을 표시
            )

            # 3. 생성된 임베딩을 각 객체에 다시 할당합니다.
            for estimate, embedding in zip(estimates, all_embeddings):
                estimate.embedding = embedding

            # 4. 변경된 모든 객체를 하나의 트랜잭션 안에서 일괄 업데이트합니다.
            with transaction.atomic():
                logger.info("Starting bulk update to the database...")
                PvEstimate.objects.bulk_update(estimates, ["embedding"], batch_size=1000)

            logger.info(f"총 {total_count}개 객체의 임베딩 업데이트가 성공적으로 완료되었습니다.")
            logger.info("--- 모든 작업이 성공적으로 완료되었습니다. ---")

        except Exception as e:
            # 에러 발생 시 로그 파일에만 기록합니다.
            logger.error(f"임베딩 재설정 중 오류 발생: {e}", exc_info=True)
