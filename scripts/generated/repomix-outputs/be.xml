    def resolve_ordered_or_fulfill_qty(root: OrderLineModel, info):
        if root.purchase_order_line_id is None:
            return root.quantity

        def get_fulfill_qty(purchase_order_line: "PurchaseOrderLineModel"):
            if (
                purchase_order_line
                and purchase_order_line.status in CONSIGNMENT_AFTER_FULFILL_STATUSES
            ):
