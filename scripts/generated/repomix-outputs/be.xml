        return filter_range_field(qs, "order__captured_at", value)

    def filter_fulfillment_status(qs, _, value):
        if value:
            qs = qs.filter(status__in=value)

        return qs

    def filter_fulfillment_delivery_status(qs, _, value):
        if value:

            def complete_delivery_filter():
                statuses = set([FulfillmentStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 배송완료 상태가 False 상태인 것이 존재하면 제외
                q2 = ~Q(fulfillment_count__gt=F("tracking_complete_count"))
                return q1 & q2

            def tracking_delivery_filter():
                statuses = set([FulfillmentStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 송장번호가 비어 있는 것은 제외
                q2 = ~Q(fulfillment_count__gt=F("tracking_number_count"))
                # 모두 배송완료된 것은 제외
                q3 = ~Q(fulfillment_count=F("tracking_complete_count"))
                return q1 & q2 & q3

            def ready_to_delivery_filter():
                statuses = set([FulfillmentStatus.FULFILLED])
                q1 = Q(status__in=statuses)
                # 모두 송장번호가 입력된 것 제외
                q2 = ~Q(fulfillment_count=F("tracking_number_count"))
                return q1 & q2

            qs = qs.annotate(
                fulfillment_count=Count("pk"),
                tracking_complete_count=Count("pk", filter=Q(is_tracking_completed=True)),
                tracking_number_count=Count("pk", filter=~Q(tracking_number__exact="")),
            )

            filter_list = []
            if OrderDeliveryStatusFilter.READY_TO_DELIVERY in value:
                filter_list.append(ready_to_delivery_filter())

            if OrderDeliveryStatusFilter.TRACKING_DELIVERY in value:
                filter_list.append(tracking_delivery_filter())

            if OrderDeliveryStatusFilter.COMPLETED_DELIVERY in value:
                filter_list.append(complete_delivery_filter())

            filter_union = None
            for q in filter_list:
                if filter_union:
                    filter_union |= q
                else:
                    filter_union = q

            qs = qs.filter(filter_union)

        return qs

    def filter_tracking_number_empty(qs, _, value):
        if (
            FulfillmentTrackingNumberEmptyFilter.EMPTY in value
            and FulfillmentTrackingNumberEmptyFilter.FILLED not in value
        ):
            qs = qs.filter(tracking_number__exact="")
        if (
            FulfillmentTrackingNumberEmptyFilter.EMPTY not in value
            and FulfillmentTrackingNumberEmptyFilter.FILLED in value
        ):
            qs = qs.exclude(tracking_number__exact="")

        return qs

