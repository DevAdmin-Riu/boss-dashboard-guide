from typing import Dict, List, Tuple

import graphene
from django.core.exceptions import ValidationError
from django.db import transaction

from ...account import BrandServiceType
from ...account.models import Brand as BrandModel
from ...account.models import User
from ...vendor import models
from ...vendor.models import FbvDeliveryCondition as FbvDeliveryConditionModel
from ...vendor.models import FbvVendorBrandRelation as FbvVendorBrandRelationModel
from ...vendor.models import Vendor as VendorModel
from ..account.types import Brand, DaysOfWeekInput
from ..account.utils import validate_login_id
from ..core.mutations import BaseMutation
from ..core.types.common import VendorError
from ..product.bulk_mutations.utils import (
    validate_data_is_non_null,
    validate_duplicate,
    validate_vendor_code,
)
from .types import Vendor


class FbvDeliveryConditionBulkDetails(graphene.InputObjectType):
    vendor_code = graphene.String(required=True, description="협력사 코드")
    login_id = graphene.String(required=True, description="매장 로그인 아이디")
    disallow_delivery_date = graphene.Boolean(description="배송일 지정 불가 여부")
    possible_delivery_days = graphene.Field(DaysOfWeekInput, description="배송가능요일")
    minimum_order_price = graphene.Int(description="최소 주문 금액")


class FbvDeliveryConditionBulkInput(graphene.InputObjectType):
    details = graphene.List(
        FbvDeliveryConditionBulkDetails,
        required=True,
        description="협력사-매장 배송 조건 상세",
    )


class FbvDeliveryConditionBulkUpdateOrCreate(BaseMutation):
    class Arguments:
        input = FbvDeliveryConditionBulkInput(
            required=True, description="협력사-매장 배송 조건 정보"
        )

    class Meta:
        description = "협력사-매장 배송 조건 정보 일괄 등록 및 수정"
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @classmethod
    def make_detail_code(cls, detail):
        vendor_code = detail.get("vendor_code")
        login_id = detail.get("login_id")
        return f"({vendor_code}:{login_id})"

    @classmethod
    def validate_value_empty(cls, details):
        minimum_order_price_errors = []
        for detail in details:
            minimum_order_price = detail.get("minimum_order_price")

            detail_code = cls.make_detail_code(detail)

            if minimum_order_price is not None and minimum_order_price < 0:
                minimum_order_price_errors.append(detail_code)

        if len(minimum_order_price_errors) > 0:
            error_msg = "최소 주문 금액은 0 이상이어야 합니다.: {}".format(
                ", ".join(minimum_order_price_errors)
            )
            raise ValidationError(error_msg)

    @classmethod
    def check_update_or_create(
        cls, details, vendors: Dict[str, VendorModel], users: Dict[str, User]
    ) -> Dict[str, FbvDeliveryConditionModel]:
        update_dict = {}
        for detail in details:
            vendor_code = detail.get("vendor_code")
            login_id = detail.get("login_id")
            vendor = vendors[vendor_code]
            user = users[login_id]
            detail_code = cls.make_detail_code(detail)
            try:
                fbv_delivery_condition: FbvDeliveryConditionModel = (
                    models.FbvDeliveryCondition.objects.get(vendor=vendor, user=user)
                )
                update_dict[detail_code] = fbv_delivery_condition
            except:
                continue

        return update_dict

    @classmethod
    def clean_details(
        cls, info, input_data
    ) -> Tuple[list, Dict[str, VendorModel], Dict[str, User]]:
        details = input_data.get("details")

        validate_data_is_non_null(details)
        validate_duplicate(details, cls.make_detail_code)
        cls.validate_value_empty(details)
        vendors = validate_vendor_code(
            details, allow_empty=False, make_detail_code_fn=cls.make_detail_code
        )
        users = validate_login_id(details)
        update_dict = cls.check_update_or_create(details, vendors, users)

        return (
            details,
            vendors,
            users,
            update_dict,
        )

    @classmethod
    def update_or_create_fbv_delivery_condition(
        cls,
        details,
        vendors: Dict[str, VendorModel],
        users: Dict[str, User],
        update_dict: Dict[str, FbvDeliveryConditionModel],
    ):
        update_list = []
        create_list = []
        for detail in details:
            vendor_code = detail.get("vendor_code")
            login_id = detail.get("login_id")
            vendor = vendors[vendor_code]
            user = users[login_id]

            detail_code = cls.make_detail_code(detail)
            is_create = detail_code not in update_dict

            if is_create:
                fbv_delivery_condition = models.FbvDeliveryCondition(
                    vendor=vendor,
                    user=user,
                )
                create_list.append(fbv_delivery_condition)
            else:
                fbv_delivery_condition = update_dict[detail_code]
                update_list.append(fbv_delivery_condition)

            disallow_delivery_date = detail.get("disallow_delivery_date")
            if disallow_delivery_date is not None:
                fbv_delivery_condition.disallow_delivery_date = disallow_delivery_date
            possible_delivery_days = detail.get("possible_delivery_days")
            if possible_delivery_days is not None:
                fbv_delivery_condition.possible_delivery_days = possible_delivery_days
            minimum_order_price = detail.get("minimum_order_price")
            if minimum_order_price is not None:
                fbv_delivery_condition.minimum_order_price = minimum_order_price

        if update_list:
            models.FbvDeliveryCondition.objects.bulk_update(
                update_list,
                [
                    "disallow_delivery_date",
                    "possible_delivery_days",
                    "minimum_order_price",
                ],
            )
        if create_list:
            models.FbvDeliveryCondition.objects.bulk_create(create_list)

    @classmethod
    @transaction.atomic
    def perform_mutation(cls, root, info, **data):
        input_data = data.get("input")
        (
            details,
            vendors,
            users,
            update_dict,
        ) = cls.clean_details(info=info, input_data=input_data)

        cls.update_or_create_fbv_delivery_condition(
            details=details,
            vendors=vendors,
            users=users,
            update_dict=update_dict,
        )

        return FbvDeliveryConditionBulkUpdateOrCreate()


class BulkAssignBrandsToVendorInput(graphene.InputObjectType):
    vendor_id = graphene.Argument(graphene.ID, required=True, description="협력사 id")
    brand_ids = graphene.List(graphene.ID, required=True, description="브랜드 ids")


class BulkAssignBrandsToVendor(BaseMutation):
    vendor = graphene.Field(Vendor, description="mutation 실행 후 리턴할 vendor")

    class Arguments:
        input = BulkAssignBrandsToVendorInput(required=True)

    class Meta:
        description = "Assign brands to vendor"
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @staticmethod
    def validate_vendor(vendor: VendorModel):
        if vendor.use_fbv_product == False:
            raise ValidationError(f"협력사가 직거래 상품을 취급하고 있지 않습니다.: {vendor.sku}")

    @staticmethod
    def validate_brands(vendor: VendorModel, brands: List[BrandModel]):
        error_brands_name = [
            brand.name for brand in brands if BrandServiceType.FBV not in brand.enabled_services
        ]
        if error_brands_name:
            error_msg = f"직거래 상품을 취급하는 브랜드 만 직거래 상품 거래 업체로 등록할 수 있습니다.: {', '.join(error_brands_name)}"
            raise ValidationError(error_msg)

        already_assigned_brands_error = []
        fbv_brands_relation: List[FbvVendorBrandRelationModel] = vendor.fbv_brands_relation.all()
        assigned_brands = [relation.brand for relation in fbv_brands_relation]
        for brand in brands:
            brand_id = brand.id
            if any(brand.id == brand_id for brand in assigned_brands):
                already_assigned_brands_error.append(brand.name)

        if already_assigned_brands_error:
            error_msg = f"이미 할당된 브랜드입니다.: {', '.join(already_assigned_brands_error)}"
            raise ValidationError(error_msg)

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        vendor_id = input_data.get("vendor_id")
        brand_ids = input_data.get("brand_ids")
        vendor = cls.get_node_or_error(info, vendor_id, field="vendor_id", only_type=Vendor)
        brands = cls.get_nodes_or_error(brand_ids, "brand_ids", only_type=Brand)

        BulkAssignBrandsToVendor.validate_vendor(vendor)
        BulkAssignBrandsToVendor.validate_brands(vendor, brands)

        relations = [FbvVendorBrandRelationModel(vendor=vendor, brand=brand) for brand in brands]
        models.FbvVendorBrandRelation.objects.bulk_create(relations)
        return BulkAssignBrandsToVendor(vendor=vendor)


class BulkUnassignBrandsFromVendorInput(graphene.InputObjectType):
    vendor_id = graphene.Argument(graphene.ID, required=True, description="ID of a vendor.")
    brand_ids = graphene.List(graphene.ID, required=True, description="List of brand IDs.")


class BulkUnassignBrandsFromVendor(BaseMutation):
    vendor = graphene.Field(Vendor, description="mutation 실행 후 리턴할 vendor")

    class Arguments:
        input = BulkUnassignBrandsFromVendorInput(required=True)

    class Meta:
        description = "Unassign brands from vendor"
        error_type_class = VendorError
        error_type_field = "vendor_errors"

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, _root, info, **data):
        input_data = data.get("input")
        vendor_id = input_data.get("vendor_id")
        brand_ids = input_data.get("brand_ids")
        vendor = cls.get_node_or_error(info, vendor_id, field="vendor_id", only_type=Vendor)
        brands = cls.get_nodes_or_error(brand_ids, "brand_ids", only_type=Brand)
        models.FbvVendorBrandRelation.objects.filter(vendor=vendor, brand__in=brands).delete()
        return BulkUnassignBrandsFromVendor(vendor=vendor)
