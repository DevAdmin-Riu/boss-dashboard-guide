    def validate_plugin(self):
        return self.active

    @require_active_plugin
    def get_plugin_config(self):
        config = {item["name"]: item["value"] for item in self.configuration}
        return config

    @require_active_plugin
    def get_plugin_config_dot_map(self):
        config = self.get_plugin_config()
        configJson = DotMap(config)
        return configJson

    def send_kakao_friend_talk_reorder_notice(
        self,
        user: "User",
        bpv_name_list: List[str],
        app_deep_link_dict: dict,
        previous_value: Any,
    ):
        try:
            logger.info(f"재구매 알림 친구톡 발송 시작: {user}")
            config = self.get_plugin_config()
            send_kakao_friend_talk_reorder_notice_to_customer(
                user, bpv_name_list, app_deep_link_dict, config
            )
        except Exception as e:
            logger.error(f"재구매 알림 친구톡 발송 예외 발생: {user}, {e}")

    def send_kakaotalk(
        self,
        talk_event_code: "AligoEvents",
        parameters: dict,
        previous_value: Any,
    ):
        try:
            logger.info(f"알림톡 발송 시작: {talk_event_code}, {parameters}")
            config = self.get_plugin_config()
            is_send_to_customer_of_normal_order = talk_event_code in [
                AligoEvents.ORDER_BY_CARD,
                AligoEvents.ORDER_BY_VBANK,
                AligoEvents.FULFILLMENT_BY_CJ,
                AligoEvents.FULFILLMENT_BY_ETC,
                AligoEvents.CANCEL_ORDER,
            ]
            is_purchase_order_event = talk_event_code in [
                AligoEvents.PO_SENT,
                AligoEvents.PO_RESENT_REJECTED,
                AligoEvents.PO_APPROVED_REQ_EPD_UPDATE,
                AligoEvents.PO_APPROVED_REQ_SPLIT_DELIVERY,
                AligoEvents.PO_CANCELED,
            ]
            is_purchase_event = talk_event_code in [
                AligoEvents.PURCHASE_PENDING,
            ]

            if is_send_to_customer_of_normal_order:
                send_kakaotalk_fn = send_kakaotalk_to_customer_of_normal_order
                make_aligo_replace_dict_fn = make_aligo_replace_dict_related_to_order_or_notice
            else:
                if RECEIVER_PHONE_BULK in parameters:
                    send_kakaotalk_fn = send_kakaotalk_to_receiver_bulk
                else:
                    send_kakaotalk_fn = send_kakaotalk_to_receiver

                if talk_event_code in [AligoEvents.BRAND_NOTICE]:
                    make_aligo_replace_dict_fn = make_aligo_replace_dict_related_to_order_or_notice
                elif is_purchase_order_event:
                    make_aligo_replace_dict_fn = make_aligo_replace_dict_related_to_purchase_order
                elif is_purchase_event:
                    make_aligo_replace_dict_fn = make_aligo_replace_dict_related_to_purchase
                else:
                    make_aligo_replace_dict_fn = make_aligo_replace_dict_related_to_order_or_notice

            send_kakaotalk_fn(talk_event_code, parameters, config, make_aligo_replace_dict_fn)
        except Exception as e:
            logger.error(f"알림톡 발송 예외 발생: {talk_event_code}, {parameters}, {e}")
            context = {
                "error_code": "-",
                "error_message": str(e),
                "talk_code": talk_event_code,
                "template_code": "-",
                RECEIVER_PHONE: "-",
            }
            send_aligo_fail_email(context, ALIGO_KAKAO_TALK_FAIL_TEMPLATE)

    def send_sms(
        self,
        receiver_phone: str,
        message: str,
        previous_value: Any,
    ):
        task_send_sms.delay(
            receiver_phone=receiver_phone,
            message=message,
