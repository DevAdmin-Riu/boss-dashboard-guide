        BrandReverseFeeDepositEvent,
        description="Brand related to brand " "reverse fee deposit event.",
    )

    class Arguments:
        brand_id = graphene.ID(required=True, description="brand ID")
        input = BrandReverseFeeDepositEventInput(
            required=True, description="Fields required when creating brand reverse fee deposit."
        )

    class Meta:
        description = "create brand reverse fee deposit event."
        permissions = (AccountPermissions.MANAGE_BRANDS,)
        error_type_class = AccountError
        error_type_field = "account_errors"

    @classmethod
    def check_permissions(cls, context, **data):
        user: UserModel = context.user
        return user.is_authenticated and user.is_staff

    @staticmethod
    def clean_input(brand: BrandModel, input: BrandReverseFeeDepositEventInput):
        event_type = input.event_type
        if event_type not in [
            BrandReverseFeeDepositEventType.INCREASE_BY_ADMIN,
            BrandReverseFeeDepositEventType.DECREASE_BY_ADMIN,
        ]:
            raise ValidationError(
                f"브랜드 보증금 내역을 수동으로 생성할 수 있는 타입 정의가 아닙니다. {event_type}"
            )

        return input

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        brand: BrandModel = cls.get_node_or_error(
            info, data["brand_id"], only_type=Brand, field="brandId"
        )
        cleaned_input = cls.clean_input(brand, data["input"])
        qty = cleaned_input.qty
        event_type = cleaned_input.event_type
        description = f"관리자 변경: {cleaned_input.description}"

        if event_type == BrandReverseFeeDepositEventType.INCREASE_BY_ADMIN:
            result = brand.increase_reverse_fee_deposit(
                reverse_fee_deposit_amount=qty,
                event_type=event_type,
                description=description,
                user=info.context.user,
            )
        elif event_type == BrandReverseFeeDepositEventType.DECREASE_BY_ADMIN:
            result = brand.decrease_reverse_fee_deposit(
                reverse_fee_deposit_amount=qty,
                event_type=event_type,
                description=description,
                user=info.context.user,
            )
        else:
            result = None

        return BrandCreateReverseFeeDepositEvent(brand_reverse_fee_deposit_event=result)


