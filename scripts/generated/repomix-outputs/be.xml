def send_templated_mail_need_to_reorder_alarm_list(
    variants: List[ProductVariant],
    orderable_qty_list: List[int],
    orderable_qty_incl_short_term_list: List[int],
    orderable_qty_incl_long_term_list: List[int],
):
    mail_title_for_log = "재발주 필요 제품 리스트 이메일 전송"
    recipient_list = get_reorder_manager_email_list()
    if len(recipient_list) == 0:
        logger.info(
            f"{mail_title_for_log}을 위한 구매 담당자, 물류 담당자 이메일 설정을 확인하세요."
        )
        return

    wb = export_stock_alarm_list(
        variants,
        orderable_qty_list,
        orderable_qty_incl_short_term_list,
        orderable_qty_incl_long_term_list,
    )
    if wb is None:
        logger.error(f"{mail_title_for_log} 엑셀 파일 생성 실패")
        return

    file_stream = BytesIO()
    wb.save(file_stream)
    file_stream.seek(0)

    today = kst_timezone_now().strftime("%Y%m%d_%H%M%S")
