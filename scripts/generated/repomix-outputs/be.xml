        if value == True:
            qs = qs.filter(outer__isnull=False)
        if value == False:
            qs = qs.filter(outer__isnull=True)
        return qs

    def filter_is_fulfilled_by_vendor(qs, _, value):
        if value is not None:
            qs = qs.filter(product__is_fulfilled_by_vendor=value)
        return qs

    def filter_is_sub_pv(qs, _, value):
