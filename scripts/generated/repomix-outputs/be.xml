    ) -> CreditsEventCreateInput:
        type = input_data.type
        is_cashable = input_data.is_cashable
        qty = input_data.qty
        if qty is None or qty <= 0:
            raise ValidationError("충전/차감할 값을 0보다 큰 값으로 입력하세요.")
        if type == CreditsEventType.DEDUCTION:
            if (is_cashable and user.cashable_credits < qty) or (
                not is_cashable and user.non_cashable_credits < qty
            ):
                raise ValidationError(
                    "보유하고 있는 현금 출금 가능한 충전금 보다 더 많이 차감할 수 없습니다."
                )
        return input_data

    @classmethod
    def perform_mutation(cls, _root, info, **data):
        user: UserModel = cls.get_node_or_error(
            info, data["user_id"], only_type=User, field="userId"
        )
        input_data = data.get("input")
        cleaned_input = cls.clean_input(user, input_data)
        is_cashable = cleaned_input.is_cashable
        qty = cleaned_input.qty
        type = cleaned_input.type
        description = f"관리자 충전/차감: {cleaned_input.description}"

        if type == CreditsEventType.RECHARGE:
            if is_cashable:
                user.increase_cashable_credits(
                    qty,
                    type,
                    description,
                    staff=info.context.user,
                    event_view_mode=CreditsEventViewMode.ALL,
                )
            else:
                user.increase_non_cashable_credits(
                    qty,
                    type,
                    description,
                    staff=info.context.user,
                    event_view_mode=CreditsEventViewMode.ALL,
                )
        elif type == CreditsEventType.DEDUCTION:
            if is_cashable:
                user.decrease_cashable_credits(
                    qty,
                    type,
                    description,
                    staff=info.context.user,
                    event_view_mode=CreditsEventViewMode.ALL,
                    allow_minus=False,
                )
            else:
                user.decrease_non_cashable_credits(
                    qty,
                    type,
                    description,
                    staff=info.context.user,
                    event_view_mode=CreditsEventViewMode.ALL,
                )
        else:
            raise ValidationError(f"충전금 변경 실패: invalid type={type}")

        return CreditsEventCreate(user=user)


