from collections import defaultdict

from ...schedule.models import Schedule
from ..core.dataloaders import DataLoader


class ParticipantsByScheduleIdLoader(DataLoader):
    context_key = "participants_by_schedule_id"

    def batch_load(self, keys):
        through_table = Schedule.participants.through
        schedule_participant_relations = through_table.objects.filter(
            schedule_id__in=keys
        ).prefetch_related("participant")

        participant_map = defaultdict(list)

        for entry in schedule_participant_relations:
            participant_map[entry.schedule_id].append(entry.participant)

        return [participant_map[schedule_id] for schedule_id in keys]
