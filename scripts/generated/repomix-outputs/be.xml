class NoticeBrandStoresQACreate(ModelMutation):
    notice = graphene.Field(Notice, description="공지사항")

    class Arguments:
        input = NoticeBrandStoresQACreateInput(
            required=True, description="공지사항 매장에서 질문을 등록하기 위한 Input"
        )

    class Meta:
        description = "공지사항 매장에서 질문을 등록하기 위한 Mutation"
        model = models.NoticeBrandStoresQA
        error_type_class = BbsError
        error_type_field = "bbs_errors"

    @classmethod
    def clean_input(cls, info, instance: models.NoticeBrandStoresQA, data, input_cls=None):
        cleaned_input = super().clean_input(info, instance, data, input_cls)
        brand_store = cleaned_input.get("brand_store")
        user = info.context.user
        # user의 brand_store와 brand_store가 다르면 에러.
        if brand_store:
            if user.brand_store != brand_store:
                raise ValidationError("매장 정보와 유저 정보가 일치하지 않습니다.")
        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance: models.NoticeBrandStoresQA, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        instance.q_writer = info.context.user
        return instance

    @classmethod
    def save(cls, info, instance: models.NoticeBrandStoresQA, cleaned_input):
        super().save(info, instance, cleaned_input)
        # ② 재사용할 upsert-mutation 입력값 준비
        notice_gid = graphene.Node.to_global_id("Notice", instance.notice_id)
        brand_store_gid = graphene.Node.to_global_id("BrandStore", instance.brand_store_id)

        # 댓글을 단 경우, 확인도 같이 처리.
        upsert_input = {
            "notice": notice_gid,
            "brand_store": brand_store_gid,
            "has_confirmed": True,  # is_read 는 건드리지 않음
        }

        NoticeAvailableBrandStoresUpsert.perform_mutation(
            None,
            info,
            input=upsert_input,
        )

    @classmethod
    def success_response(cls, instance):
        response = super().success_response(instance)
        response.notice = instance.notice
        return response

    @classmethod
    def post_save_action(cls, info, instance, _cleaned_input):
        transaction.on_commit(
            lambda: send_push_to_users_on_notice_brand_stores_qa_create(info, instance)
        )


