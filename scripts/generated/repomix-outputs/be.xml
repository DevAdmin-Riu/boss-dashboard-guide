from typing import TYPE_CHECKING

from django.core.exceptions import ValidationError
from django.core.validators import validate_email

from saleor.account import BrandContractStatus, BrandContractType, BrandServiceType
from saleor.account.validators import validate_possible_number

from ...core.utils.regex import remove_all_non_numeric

if TYPE_CHECKING:
    from saleor.account.models import Brand


def validate_not_only_linkers(brand: "Brand"):
    contract_status = brand.contract_status
    if contract_status == BrandContractStatus.IN_CONSULTING:
        return
    enabled_services = brand.enabled_services
    is_only_linkers = BrandServiceType.LINKERS in enabled_services and len(enabled_services) == 1
    is_not_only_linkers = is_only_linkers == False
    if is_not_only_linkers:
        if brand.contract_type is None:
            raise ValidationError("계약방식 지정이 필요합니다.")
        if brand.delivery_fee_type is None:
            raise ValidationError("배송비 가맹점 청구 타입 지정이 필요합니다.")
        if brand.mileage_rate is None:
            raise ValidationError("적립율 값 지정이 필요합니다.")


def validate_use_fbv_service_type(brand: "Brand"):
    enabled_services = brand.enabled_services
    vacs_create_fee_exclude_vat = brand.vacs_create_fee_exclude_vat
    vacs_charge_fee_exclude_vat = brand.vacs_charge_fee_exclude_vat

    if not enabled_services:
        raise ValidationError("브랜드 추가 시에는 이용 서비스는 적어도 1개는 지정되어야 합니다.")

    if BrandServiceType.B2B in enabled_services and len(enabled_services) > 1:
        raise ValidationError("B2B 서비스는 다른 서비스와 함께 사용할 수 없습니다.")

    if BrandServiceType.FBV in enabled_services:
        if vacs_create_fee_exclude_vat is None or vacs_create_fee_exclude_vat <= 0:
            raise ValidationError(
                "직거래 상품 취급 브랜드는 충전 계좌 발급 수수료를 부가세별도가로 0 보다 큰 값을 설정해야 합니다."
            )
        if vacs_charge_fee_exclude_vat is None or vacs_charge_fee_exclude_vat <= 0:
            raise ValidationError(
                "직거래 상품 취급 브랜드는 충전 계좌 건당 충전 수수료를 부가세별도가로 0 보다 큰 값을 설정해야 합니다."
            )
        enable_rcoin_reward_for_using_point = brand.enable_rcoin_reward_for_using_point
        if enable_rcoin_reward_for_using_point:
            raise ValidationError("직거래 상품 취급 브랜드는 충전금 혜택을 제공할 수 없습니다.")
    else:
        if brand.pk and brand.brand_products.filter(product__is_fulfilled_by_vendor=True).exists():
            raise ValidationError(
                "직거래 상품이 연결된 브랜드는 직거래 상품 취급 여부를 변경할 수 없습니다."
            )


def validate_contract_type_vs_mileage_rate(brand: "Brand"):
    contract_status = brand.contract_status
    contract_type = brand.contract_type
    contract_type_label = brand.get_contract_type_display()
    mileage_rate = brand.mileage_rate
    card_paying_charge_rate = brand.card_paying_charge_rate
    vbank_paying_charge_exclude_vat = brand.vbank_paying_charge_exclude_vat

    is_contract_status_running = contract_status in [
        BrandContractStatus.RUNNING,
        BrandContractStatus.CONTRACT_WARNING,
    ]

    if is_contract_status_running:
        if contract_type == BrandContractType.FEE:
            if (
                card_paying_charge_rate != 0
                or vbank_paying_charge_exclude_vat != 0
                or mileage_rate != 100
            ):
                raise ValidationError(
                    f"{contract_type_label} 계약 방식인 경우 적립율 100%, 카드 계약 결제 수수료율은 0%, 가상계좌 계약 결제 수수료는 0원 이어야 합니다."
                )

        elif contract_type == BrandContractType.REVERSE_FEE:
            enable_rcoin_reward_for_using_point = brand.enable_rcoin_reward_for_using_point
            if enable_rcoin_reward_for_using_point:
                raise ValidationError(
                    f"{contract_type_label} 계약 방식인 경우 충전금 혜택을 제공할 수 없습니다."
                )


def _validate_person_in_charge_info(person: dict, person_type: str):
    email = person.get("email")
    contact = person.get("contact")

    if email:
        try:
            validate_email(email)
        except ValidationError:
            raise ValidationError(f"{person_type} 담당자 이메일이 유효하지 않습니다.")

    if contact:
        try:
            validate_possible_number(contact)
        except ValidationError:
            raise ValidationError(f"{person_type} 담당자 연락처가 유효하지 않습니다.")


def validate_people_in_charge_info(brand: "Brand"):
    people_in_charge_info = brand.people_in_charge_info
    accounting_person = people_in_charge_info.get("accounting")
    _validate_person_in_charge_info(accounting_person, "회계")

    boss_mall_person = people_in_charge_info.get("boss_mall")
    _validate_person_in_charge_info(boss_mall_person, "보스몰")

    custom_persons = people_in_charge_info.get("custom_persons", [])
    for custom_person in custom_persons:
        custom_person_type_name = custom_person.get("type_name")
        _validate_person_in_charge_info(custom_person, custom_person_type_name)


def validate_boss_market_mileage_contract(brand: "Brand"):
    if brand.is_boss_market_use and brand.is_reverse_fee_contract_type:
        raise ValidationError("계약 방식이 본부 매출 인식 방식인 경우 보스장터 사용 불가합니다.")


def validate_b2b_contract_type(brand: "Brand", old_brand: "Brand"):
    # 생성시점에는 사용하지 않음.
    if old_brand is None:
        return

    if brand.contract_type == old_brand.contract_type:
        return

    if (
        brand.contract_type == BrandContractType.B2B
        or old_brand.contract_type == BrandContractType.B2B
    ):
        raise ValidationError("계약 방식이 B2B인 경우 변경할 수 없습니다.")


def validate_contract_status_for_create(brand: "Brand"):
    # 생성 시점에만 확인.
    if not brand.pk:
        if brand.contract_status not in [
            BrandContractStatus.IN_CONSULTING,
            BrandContractStatus.RUNNING,
        ]:
            raise ValidationError("브랜드 생성 시 계약 상태는 '상담' 또는 '계약 중' 이어야 합니다.")


def update_brand_code_user_info(brand: "Brand", old_brand: "Brand"):
    if brand.pk:
        from saleor.account.models import User

        new_biz_info = brand.biz_info
        old_biz_info = old_brand.biz_info
        if new_biz_info != old_biz_info:
            # brand의 코드와 동일한 login_id를 가진 User를 찾는다. 무조건 존재한다고 가정.
            user = User.objects.get(login_id=brand.code)

            tax_invoice_in_charge_person_phone = new_biz_info.get(
                "taxInvoiceInChargePersonPhone", ""
            )
            tax_invoice_in_charge_person_email = new_biz_info.get(
                "taxInvoiceInChargePersonEmail", ""
            )
            biz_reg_no = new_biz_info.get("bizRegNo", "")
            biz_reg_addr = new_biz_info.get("bizAddress", "")
            biz_reg_biz_class = new_biz_info.get("bizClass", "")
            biz_reg_biz_type = new_biz_info.get("bizType", "")
            biz_reg_ceo_name = new_biz_info.get("bizRepName", "")
            biz_reg_corp_name = new_biz_info.get("bizName", "")

            user.aligo_phone = (
                validate_possible_number(tax_invoice_in_charge_person_phone)
                if tax_invoice_in_charge_person_phone != ""
                else ""
            )
            user.email = tax_invoice_in_charge_person_email
            user.biz_reg_no = remove_all_non_numeric(biz_reg_no)
            user.biz_reg_addr = biz_reg_addr
            user.biz_reg_biz_class = biz_reg_biz_class
            user.biz_reg_biz_type = biz_reg_biz_type
            user.biz_reg_ceo_name = biz_reg_ceo_name
            user.biz_reg_corp_name = biz_reg_corp_name

            user.save()
