def create_purchase_stock_detail_event(
    stock: "Stock",
    stock_detail: "StockDetail",
    user: "User",
    purchase_order_line: PurchaseOrderLine,
    rack_location: RackLocation,
    stocked_quantity: int,
):
    code = stock_detail.vendor.code if stock_detail.vendor else ""
    rack_sector: RackSector = rack_location.sector if rack_location else None
    warehouse_address: Address = rack_sector.address if rack_sector else None
    parameters = {
        "quantity": stocked_quantity,
        "vendor": f"{stock_detail.vendor_name} ({code})" if code else stock_detail.vendor_name,
        "cost_price_exclude_vat": stock_detail.cost_price_exclude_vat,
        "sector": rack_sector.name if rack_sector else "-",
        "address": warehouse_address.company_name if warehouse_address else "-",
        "location": rack_location.name if rack_location else "-",
    }
    parameters["purchase_order_line"] = purchase_order_line.code
    stocked_date = to_datetime_astimezone(purchase_order_line.purchase_date)

    events.create_stock_detail_event(
        type=StockDetailEvents.PURCHASE,
        stock=stock,
        user=user,
        parameters=parameters,
        stocked_date=stocked_date,
    )


