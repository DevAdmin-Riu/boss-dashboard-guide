    is_fulfilled_by_vendor = models.BooleanField(default=False)
    # 직거래 상품 구매 시 담당 협력사
    vendor = models.ForeignKey(
        Vendor,
        blank=True,
        null=True,
        on_delete=models.SET_NULL,
        related_name="+",
    )

    is_b2b = models.BooleanField(default=False)
    is_picking_order = models.BooleanField(default=False)
    batch_picking = models.ForeignKey(
        "warehouse.BatchPicking",
        related_name="fulfillments",
        on_delete=models.SET_NULL,
        blank=True,
        null=True,
    )

    class Meta:
        ordering = ("pk",)
        permissions = (
            (OrderPermissions.MANAGE_DELIVERY_STATUS.codename, "배송 상태 관리"),
            (OrderPermissions.MANAGE_FULFILLMENT.codename, "출고 관리"),
        )
        constraints = [
            models.UniqueConstraint(
                fields=["order", "fulfillment_order"],
                name="unique_order_fulfillment_order",
            )
        ]

    def __str__(self):
        return f"Fulfillment: {self.composed_id_with_prefix}"

    def __iter__(self):
        return iter(self.lines.all())

    def save(self, *args, **kwargs):
        """Assign an auto incremented value as a fulfillment order."""
        if not self.pk:
            groups = self.order.fulfillments.all()
            existing_max = groups.aggregate(Max("fulfillment_order"))
            existing_max = existing_max.get("fulfillment_order__max")
            self.fulfillment_order = existing_max + 1 if existing_max is not None else 1
        return super().save(*args, **kwargs)

    @property
    def composed_id(self):
        return "%s-%s" % (self.order_id, self.fulfillment_order)

    @property
    def composed_id_with_prefix(self):
        prefix = B2B_ORDER_PREFIX if self.is_b2b else NON_B2B_ORDER_PREFIX
        return "%s%s-%s" % (prefix, self.order_id, self.fulfillment_order)

    def can_cancel(self):
        return self.status not in [
            FulfillmentStatus.CANCELED,
            FulfillmentStatus.REFUNDED,
        ]

    def can_tracking_completed(self):
        if self.status in [FulfillmentStatus.CANCELED, FulfillmentStatus.REFUNDED]:
            return False
        if not self.tracking_number and self.delivery_method == OrderDeliveryMethods.BY_COURIER:
            return False
        if self.order.status == OrderStatus.CANCELED:
            return False
        return True

    def get_total_quantity(self):
        return sum([line.quantity for line in self])

    @property
    def is_tracking_number_url(self):
        return bool(match(r"^[-\w]+://", self.tracking_number))


