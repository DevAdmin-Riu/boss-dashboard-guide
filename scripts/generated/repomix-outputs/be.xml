<file path="saleor/core/db/custom_trunc_fn.py">
from django.db.models import Func


# 1~15일은 1일로, 16일 이후는 16일로 DATE_TRUNC 하는 Custom Trunc 함수
class TruncTwicePerMonth(Func):
    function = None
    template = "%(expressions)s"

    def __init__(self, expression, timezone="Asia/Seoul", **extra):
        self.timezone = timezone
        super().__init__(expression, **extra)

    def as_sql(self, compiler, connection, **extra_context):
        expr_sql, params = compiler.compile(self.source_expressions[0])

        tz_expr = f"{expr_sql} AT TIME ZONE '{self.timezone}'"

        sql = f"""
        CASE
            WHEN EXTRACT(DAY FROM {tz_expr}) <= 15
                THEN DATE_TRUNC('month', {tz_expr})
            ELSE
                DATE_TRUNC('month', {tz_expr}) + INTERVAL '15 days'
        END
        """

        return sql, params
</file>

