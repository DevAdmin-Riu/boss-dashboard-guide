class Notice(CountableDjangoObjectType):
    available_brands = graphene.List(Brand, description="이 공지를 노출할 브랜드 리스트")
    thumbnail = graphene.Field(Image, size=graphene.Int(description="Size of the image."))
    popup_count = graphene.Int(description="팝업 노출 횟수")
    notice_available_brand_stores = graphene.List(
        graphene.NonNull(lambda: NoticeAvailableBrandStores),
        description="공지사항 공개 리스트(대시보드 전용)",
    )
    notice_available_brand_store = graphene.Field(
        lambda: NoticeAvailableBrandStores,
        description="공지사항 공개 매장 정보(보스몰 전용)",
    )
    notice_brand_stores_qas = graphene.List(
        graphene.NonNull(lambda: NoticeBrandStoresQA), description="공지사항 매장 문의 리스트"
    )

    class Meta:
        description = "Represents notice board data."
        model = models.Notice
        interfaces = [graphene.relay.Node]
        only_fields = [
            "id",
            "title",
            "content",
            "created_at",
            "updated_at",
            "is_published",
            "publication_date",
            "writer",
            "owner_brand",
            "available_to_all_brands",
            "available_to_all_brand_stores",
            "is_fixed",
        ]

    def resolve_notice_available_brand_store(root: models.Notice, info, **_kwargs):
        user = info.context.user
        notice_available_brand_stores_promise = NoticeAvailableBrandStoresByNoticeIdLoader(
            info.context
        ).load(root.id)
        brand_store_user_by_user_id_promise = BrandStoreUserByUserIdLoader(info.context).load(
            user.id
        )

        def handle_result(results):
            notice_available_brand_stores, brand_store_user = results

            if not brand_store_user:
                return None

            # 현재 유저의 brand_store_id와 일치하는 항목 찾기
            for record in notice_available_brand_stores:
                if record.brand_store_id == brand_store_user.brand_store_id:
                    return record

            return None

        return Promise.all(
            [notice_available_brand_stores_promise, brand_store_user_by_user_id_promise]
        ).then(handle_result)

    def resolve_notice_available_brand_stores(root: models.Notice, info, **_kwargs):
        return NoticeAvailableBrandStoresByNoticeIdLoader(info.context).load(root.id)

    @staticmethod
    def resolve_available_brands(root: models.Notice, info, **_kwargs):
        return (
            BrandsByNoticeIdLoader(info.context)
            .load(root.id)
            .then(
                # name으로 ordering
                lambda brands: sorted(brands, key=lambda brand: brand.name)
            )
        )

    def resolve_writer(root: models.Notice, info):
        if root.writer_id:
            return UserByIdLoader(info.context).load(root.writer_id)
        else:
            return None

    def resolve_owner_brand(root: models.Notice, info):
        if root.owner_brand_id:
            return BrandByIdLoader(info.context).load(root.owner_brand_id)
        else:
            return None

    def resolve_popup_count(root: models.Notice, _info):
        return PopupsByNoticeIdLoader(_info.context).load(root.id).then(lambda popups: len(popups))

    def resolve_thumbnail(root: models.Notice, info, size=None, **_kwargs):
        return Image.get_adjusted(
            image=root.thumbnail,
            alt=None,
            size=size,
            rendition_key_set="products",
            info=info,
        )

    def resolve_notice_brand_stores_qas(root: models.Notice, info, **_kwargs):
        user = info.context.user
        return (
            NoticeBrandStoresQAsByNoticeIdLoader(info.context)
            .load(root.id)
            .then(
                lambda results: (
                    results
                    if user.from_dashboard
                    else [r for r in results if r.q_writer_id == user.id]
                )
            )
        )


