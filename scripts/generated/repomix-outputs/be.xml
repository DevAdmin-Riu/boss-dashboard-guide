        error_type_class = AccountError
        error_type_field = "account_errors"

    @staticmethod
    def make_settlement_date(date):
        import calendar

        # date 가 1이면 YY-MM-01 ~ YY-MM-15
        # date 가 16이면 YY-MM-16 ~ YY-MM-마자막날짜
        if date.day == 1:
            start_date = date.replace(day=1)
            end_date = date.replace(day=15)
        elif date.day == 16:
            last_day = calendar.monthrange(date.year, date.month)[1]
            start_date = date.replace(day=16)
            end_date = date.replace(day=last_day)
        else:
            raise ValidationError("정산 기준일은 1일 또는 16일로 기록되어야 합니다.")

        start_date_str = start_date.strftime("%Y-%m-%d")
        end_date_str = end_date.strftime("%Y-%m-%d")
        return f"{start_date_str} ~ {end_date_str}"

    # 생성시점에 settlement_account_info snapshot
    @classmethod
    def construct_instance(cls, info, instance: BrandFbvSettlementModel, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        if cls == BrandFbvSettlementCreate or cls == BrandFbvSettlementBulkCreate:
