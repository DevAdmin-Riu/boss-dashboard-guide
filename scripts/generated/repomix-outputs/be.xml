class StockDetailAddEtc(ModelMutation):
    class Arguments:
        input = StockDetailAddEtcInput(
            description="기타 입고 처리를 위한 input 형식", required=True
        )

    class Meta:
        description = (
            "재고 발주를 통한 입고 외 기타 사유(재고 이관, 스토어 반품 등)로 인한 입고 처리"
        )
        model = models.StockDetail
        error_type_class = StockError
        error_type_field = "stock_errors"

    @classmethod
    def clean_input(cls, info, instance, data):
        cleaned_input = super().clean_input(info, instance, data)

        quantity = cleaned_input.get("quantity")
        if quantity is None or quantity <= 0:
            raise ValidationError("입고 수량은 0 보다 큰 값으로 넣어야 합니다.")
        cleaned_input["remain_quantity"] = quantity

        stock: StockModel = cleaned_input.get("stock")
        if stock is None:
            raise ValidationError("존재하지 않는 stock id 입니다.")
        if stock.quantity < 0:
            raise ValidationError(
                "음수가 된 부자재 재고에 대해서는 기타 입고 처리할 수 없습니다. 부자재 음수 재고 조정으로 0으로 조정 후 다시 시도해주세요."
            )

        variant = stock.product_variant
        is_fulfilled_by_vendor = variant.product.is_fulfilled_by_vendor

        if is_fulfilled_by_vendor:
            raise ValidationError("보스 제품 전용 입고 처리 함수 입니다.")

        cost_price_exclude_vat = cleaned_input.get("cost_price_exclude_vat")
        if cost_price_exclude_vat is None or cost_price_exclude_vat < 0:
            raise ValidationError("매입가는 0 이상의 값으로 넣어야 합니다.")
        if stock.product_variant.required_exp_date_mgmt:
            exp_date = cleaned_input.get("exp_date")
            if exp_date is None:
                raise ValidationError(
                    "유통기한 관리 필수 제품은 입고 시 유통기한을 입력해야 합니다."
                )
        rack_location = cleaned_input.get("rack_location")
        if rack_location is None:
            raise ValidationError("rack location id를 입력해야 합니다.")

        product_variant_id = variant.id
        vendor = cleaned_input.get("vendor")
        if vendor is not None:
            pvv = ProductVariantVendor.objects.filter(
                product_variant_id=product_variant_id, vendor_id=vendor
            ).first()
            if pvv is None:
                raise ValidationError("해당 제품의 협력사가 아닙니다.")
            cleaned_input["vendor_name"] = vendor.name

        return cleaned_input

    @classmethod
    def construct_instance(cls, info, instance: StockDetailModel, cleaned_data):
        instance = super().construct_instance(info, instance, cleaned_data)
        instance.exp_date_status = get_exp_date_status(instance.exp_date)
        return instance

    @classmethod
    def post_save_action(cls, info, instance: StockDetailModel, cleaned_input):
        stock: StockModel = cleaned_input.get("stock")
        quantity = cleaned_input.get("quantity")
        stock.increase_stock(quantity)

        rack_location: RackLocationModel = cleaned_input.get("rack_location")
        models.RackStockDetail.objects.create(
            location=rack_location,
            product_variant=stock.product_variant,
            stock_detail=instance,
            remain_quantity=quantity,
        )

        requestor = info.context.user
        reason = cleaned_input.get("reason")
        create_etc_purchase_stock_detail_event(
            stock,
            stock_detail=instance,
            quantity=quantity,
            user=requestor,
            reason=reason,
            rack_location=rack_location,
        )
        send_etc_purchase_stock_detail_event_email(
            stock,
            stock_detail=instance,
            quantity=quantity,
            user=requestor,
            reason=reason,
            rack_location=rack_location,
        )

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        instance = cls.get_instance(info, **data)
        data = data.get("input")
        cleaned_input = cls.clean_input(info, instance, data)
        instance = cls.construct_instance(info, instance, cleaned_input)
        cls.clean_instance(info, instance)
        cls.save(info, instance, cleaned_input)
        cls._save_m2m(info, instance, cleaned_input)
        cls.post_save_action(info, instance, cleaned_input)
        return cls.success_response(instance)


