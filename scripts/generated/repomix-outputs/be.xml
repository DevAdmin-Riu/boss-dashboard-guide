class FbvRefundQaApprove(BaseMutation):
    refund_qa = graphene.Field(RefundQA, description="RefundQA instance")

    class Arguments:
        input = FbvRefundQaApproveInput(
            required=True, description="직거래 상품 교환/반품 문의에 대한 승인 입력"
        )

    class Meta:
        description = "직거래 상품 교환/반품 문의에 대한 승인"
        error_type_class = OrderError
        error_type_field = "order_errors"

    @classmethod
    def _restore_stock_for_line(
        cls, info, order_line: OrderLine, quantity: int, refund_qa: RefundQAModel
    ):
        """하나의 OrderLine에 대한 재고 복구 로직을 처리하는 헬퍼 메소드"""
        variant = order_line.variant

        # variant가 없거나 재고 추적 대상이 아니면 아무 작업도 하지 않음
        if not variant or not variant.track_inventory:
            return

        # prefetch_related로 가져온 재고를 순회 (추가 DB 조회 없음)
        for stock in variant.stocks.all():
            stock_global_id = graphene.Node.to_global_id("Stock", stock.id)
            stock_add_input = {
                "stock": stock_global_id,
                "quantity": int(quantity),
                "reason": f"교환/반품 문의(ID:{refund_qa.id}) 승인으로 인한 재고 복구",
            }
            stock_add_response = FbvStockAddEtc.mutate(None, info, input=stock_add_input)
            if stock_add_response.errors:
                raise ValidationError(
                    f"재고 복구 실패(Stock ID: {stock.id}): {stock_add_response.errors[0].message}"
                )

    @classmethod
    def post_save_action(cls, info, instance: RefundQAModel):
        # ... (기존과 동일)
        pass

    @classmethod
    @transaction.atomic()
    def perform_mutation(cls, root, info, **data):
        input = data.get("input")
        order_id = input.get("order_id")
        order_refund_input = input.get("order_refund_input")
        refund_qa_id = input.get("refund_qa_id")

        refund_qa: RefundQAModel = cls.get_node_or_error(info, refund_qa_id, RefundQA)
        q_order_line_info_list = refund_qa.q_order_line_info

        if not isinstance(q_order_line_info_list, list):
            raise ValidationError("q_order_line_info가 예상된 리스트 형식이 아닙니다.")

        # 데이터 한번에 가져오기 (N+1 문제 해결)
        order_line_pks = []
        quantity_map = {}
        for line_info in q_order_line_info_list:
            order_line_id = line_info.get("order_line_id")
            if order_line_id:
                try:
                    _, order_line_pk = graphene.Node.from_global_id(order_line_id)
                    pk = int(order_line_pk)
                    order_line_pks.append(pk)
                    # 각 order line의 환불 수량을 맵으로 저장
                    quantity_map[pk] = line_info.get("quantity")
                except Exception:
                    raise ValidationError(f"잘못된 Global ID 형식입니다: {order_line_id}")

        if order_line_pks:
            # DB 조회를 단 한번만 실행하여 관련된 모든 데이터를 미리 불러옵니다.
            order_lines_qs = (
                OrderLine.objects.filter(id__in=order_line_pks)
                .select_related("variant")
                .prefetch_related("variant__stocks")
            )

            for order_line in order_lines_qs:
                refund_quantity = quantity_map.get(order_line.id)
                if not refund_quantity:
                    continue

                try:
                    cls._restore_stock_for_line(info, order_line, refund_quantity, refund_qa)
                except Exception as e:
                    raise ValidationError(
                        f"OrderLine ID {order_line.id}의 재고 복구 중 오류가 발생했습니다."
                    )

        FbvRefundQaRefuse.validate_refund_qa(refund_qa)

        order_refund_response = OrderRefund.mutate(
            root, info, id=order_id, input=order_refund_input
        )
        if order_refund_response.errors:
            raise ValidationError(
                f"OrderRefund mutation 실패 - {order_refund_response.errors[0].message}"
            )

        refund_qa.status = RefundStatusType.QUESTION_CLOSE
        refund_qa.save(update_fields=["status"])
        cls.post_save_action(info, refund_qa)
        return cls(refund_qa=refund_qa)


