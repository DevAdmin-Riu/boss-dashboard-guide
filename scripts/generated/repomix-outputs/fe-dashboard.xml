<file path="src/app/views/brand/brands/components/BrandMenuConnectCard.tsx">
import { useBrandUpdateMutation } from "@src/app/views/brand/brands/api/mutations";
import { MenuList } from "@src/app/views/settings/navigation/api/types/MenuList";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, makeGqlMaxLimitIssueErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { AutoComplete, Button, Card, Space, Typography } from "antd";
import React, { useState } from "react";

import { BrandDetails_brand_homepageList } from "../api/types/BrandDetails";

interface BrandMenuConnectCardProps {
  menuList: MenuList;
  loading: boolean;
  brandMenu: BrandDetails_brand_homepageList;
  brandId: string;
}

export const BrandMenuConnectCard: React.FC<BrandMenuConnectCardProps> = (props) => {
  const { menuList, loading, brandId } = props;
  const { brandMenu } = props;

  const menuTotalCount = maybe(() => menuList?.menus.totalCount, 0);
  const menuEdges = maybe(() => menuList?.menus.edges, []);

  const errorTitle =
    menuTotalCount <= 0 || menuEdges.length <= 0
      ? "조회된 메뉴가 없습니다."
      : menuTotalCount > menuEdges.length
      ? makeGqlMaxLimitIssueErrorMsg(menuEdges.length, menuTotalCount)
      : undefined;

  const menuChoice = menuEdges?.map((value) => {
    const { name } = value.node;
    return { label: name, value: name };
  });

  const [showButton, setButtonVisible] = useState(false);
  const [selName, setSelName] = useState(brandMenu?.name || "");

  const [brandUpdate] = useBrandUpdateMutation({});

  const handleUpdate = async () => {
    const targetId = menuEdges.find((e) => e?.node?.name === selName)?.node?.id;
    if (targetId) {
      const result = await brandUpdate({
        variables: { id: brandId, input: { homeList: targetId } },
      });

      const data = result.data;

      const errors = data.brandUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        setSelName(data.brandUpdate.brand.homepageList.name);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    } else {
      setSelName(brandMenu?.name);
    }
  };
  return (
    <Card
      title={
        <Space direction={"vertical"}>
          <Typography.Title level={4}>브랜드 메뉴</Typography.Title>
          {errorTitle && <Typography.Text type="danger">{errorTitle}</Typography.Text>}
        </Space>
      }
      extra={
        showButton && (
          <Button type={"text"} disabled={false} onClick={handleUpdate}>
            저장
          </Button>
        )
      }
    >
      <AutoComplete
        style={{ width: "100%" }}
        disabled={loading}
        size={"large"}
        placeholder={"브랜드 메뉴 검색"}
        options={menuChoice}
        value={selName}
        onChange={(value) => {
          setButtonVisible(brandMenu?.name !== value);
          setSelName(value);
        }}
        filterOption={(inputValue, option) => option!.value.toUpperCase().indexOf(inputValue.toUpperCase()) !== -1}
        allowClear
      />
    </Card>
  );
};
</file>

