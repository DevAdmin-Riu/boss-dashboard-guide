          </Typography.Text>
        );
        const inspectedQtyNode = (
          <Typography.Text>
            {columnNameConstant.fulfillment.INSPECTED_QTY}:{" "}
            <NumberComponent value={inspectedQtyByVariant + inspectQtyByVariantWatched} />
