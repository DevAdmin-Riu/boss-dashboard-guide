export const checkProductUpdateRequired = (
  product: ProductDetails_product,
  data: ProductUpdateData,
  isHqStaff: boolean
) => {
  const hasVariants = checkHasVariants(product);
  const defaultVariant = getDefaultVariant(product);
  if (hasVariants && utils.isEmpty(defaultVariant)) {
    showNotificationError("옵션형 제품은 옵션을 먼저 추가하신 후, 상세 정보를 수정해주세요.");
    return false;
  }

  const commonCheck = commonCheckProductRequired({
    data,
    hasVariants: checkHasVariants(product),
    isFulfilledByVendor: product.isFulfilledByVendor,
    firstAvailableForPurchase: defaultVariant.firstAvailableForPurchase,
    isHqStaff,
    isCreateMode: false,
    isB2bCategoryKind: product.category?.kind === CategoryKindEnum.B2B,
    isDevCategoryKind: product.category?.kind === CategoryKindEnum.DEV,
  });
  if (commonCheck === false) {
    return false;
  }

  const { isFulfilledByVendor } = product;
  if (isFulfilledByVendor) {
    if (data.salesStatus === SalesStatusEnum.WILL_BE_STOPPED) {
      showNotificationError(`${transformIsFBV(true)} 상품은 단종 예정으로 변경할 수 없습니다.`);
      return false;
    }
  }

  if (data.trackInventory === false) {
    if (data.salesStatus === SalesStatusEnum.WILL_BE_STOPPED) {
      showNotificationError("위탁 제품은 단종 예정으로 변경할 수 없습니다.");
      return false;
    }
    const outerVariants = product.outerVariants || [];
    const defaultVariant = outerVariants.find((v) => v.id === product.defaultVariant.id) || outerVariants[0];
    const variantVendors = defaultVariant?.productVariantVendors || [];
    const defaultVariantVendor =
      variantVendors.find((variantVendor) => variantVendor.id === defaultVariant?.defaultVariantVendor?.id) ||
      variantVendors[0];
    if (
      !!defaultVariantVendor &&
      defaultVariant.isDeferred === false &&
      defaultVariantVendor.consignmentProductPriceExcludeVat <= 0
    ) {
      showNotificationError("기본 협력사의 위탁 상품가가 0 이하면 재고 미운영으로 설정할 수 없습니다.");
      return false;
    }
  }

  if ([SalesStatusEnum.WILL_BE_STOPPED, SalesStatusEnum.STOPPED].includes(data.salesStatus)) {
    if (utils.isEmpty(data.stoppedReason)) {
      showNotificationError("제품 상태가 정상이 아닌 경우 단종 사유를 입력해 주세요.");
      return false;
    }
    if (data.stoppedReason === StoppedReasonTypeEnum.ETC && utils.isEmpty(data.stoppedReasonEtc)) {
      showNotificationError("단종 사유가 기타인 경우 단종 상세 사유를 입력해 주세요.");
      return false;
    }
  }

  if (data.uoq <= 0) {
    showNotificationError("단위주문수량은 0보다 큰 수를 입력하세요.");
    return false;
  }
  if (data.moq <= 0) {
    showNotificationError("최소주문수량은 0보다 큰 수를 입력하세요.");
    return false;
  }

  if (product.isFulfilledByVendor) {
    const { isValid } = checkVatValueToPriceExcludeVat(
      data.bpvPriceVat,
      data.bpvPriceExcludeVat,
      data.priceDecimalPlaces
    );
    const isTaxFree = data.isTaxFree;
    if (isTaxFree === false && isValid === false) {
      showNotificationError(`부가세 범위에 맞는 금액을 입력해 주세요.`);
      return false;
    }
    if (isTaxFree === true && data.bpvPriceVat !== 0) {
      showNotificationError("면세 제품의 경우 판매가는 부가세가 0원이어야 합니다.");
      return false;
    }
  }

  const requiredAttributeIds = data?.attributes
    .filter((attribute) => attribute.data.valueRequired)
    .map((attribute) => attribute.id);
  if (requiredAttributeIds.length > 0) {
    const inputAttributeIds = data.attributes
      .filter((attribute) => utils.isEmpty(attribute.value) === false)
      .map((attribute) => attribute.id);
    const missingAttributeIds = requiredAttributeIds.filter((id) => !inputAttributeIds.includes(id));
    if (missingAttributeIds.length > 0) {
      showNotificationError("필수 속성을 입력 또는 선택해 주세요.");
      return false;
    }
  }

  if (product.isFulfilledByVendor && data.bpvShowBeforePrice) {
    if (utils.isEmpty(data.bpvBeforePriceExcludeVat) || data.bpvBeforePriceExcludeVat < data.bpvPriceExcludeVat) {
      showNotificationError("할인전 판매가는 매장 판매가보다 같거나 큰 수를 입력해 주세요.");
      return false;
    }
  }

  return true;
};

export function createUpdateHandler(
  product: ProductDetails_product,
  brandProductVariant: BrandProductVariant_brandProductVariant,
  updateExtendedProduct: (variables: ExtendedProductUpdateVariables) => Promise<FetchResult<ExtendedProductUpdate>>,
  updateFbvMixedProduct: (variables: FbvMixedProductUpdateVariables) => Promise<FetchResult<FbvMixedProductUpdate>>
) {
  return async (formData: ProductUpdateData) => {
    const { isFulfilledByVendor } = product;
    const commonProductUpdateInput: ProductInput = {
      // 카테고리, 컬렉션
      category: formData.category,
      collections: formData.collections,
      // 제품 기본 정보
      name: formData.name,
      moq: formData.moq || 1,
      uoq: formData.uoq || 1,
      slug: formData.slug,
      // 제품 속성 정보
      attributes: makeFilteredAttributesForMutationInput(formData),
      maker: formData.maker,
      // 상품 정보고시
      productInfoNotification: formData.productInfoNotification,
    };
    const productUpdateInputForFulfilledByVendor: StrictOmit<
      ProductInput,
      | "allowMixedMultipleOfUoq"
      | "isDirectShipping"
      | "isExclusive"
      | "trackInventory"
      | "forceSoldOutNotice"
      | "allowAutoConsignment"
      | "isSubPv"
      | "canSaleByInner"
    > = { ...commonProductUpdateInput };
    const productUpdateInputForFulfilledByBoss: ProductInput = {
      ...commonProductUpdateInput,
      allowMixedMultipleOfUoq: formData.allowMixedMultipleOfUoq || false,
      isExclusive: formData.isExclusive,
    };
    const productUpdateInput = isFulfilledByVendor
      ? productUpdateInputForFulfilledByVendor
      : productUpdateInputForFulfilledByBoss;

    // NOTE: 제품 옵션 수정 뮤테이션 input 생성 - 직거래 상품 여부에 따라 전달하는 input 인자가 다름
    const innerVariantUpdateInput: ProductVariantInput =
      formData.canSaleByInner === false
        ? null
        : {
            innerSalesStatus: formData.innerSalesStatus,
            innerStoppedReason: formData.innerStoppedReason,
            innerStoppedReasonEtc: formData.innerStoppedReasonEtc,
            innerMoq: formData.innerMoq || 1,
            innerUoq: formData.innerUoq || 1,
            innerQtyPerBox: formData.innerQtyPerBox,
            innerBoxLength: formData.innerBoxLength,
            innerBoxWidth: formData.innerBoxWidth,
            innerBoxHeight: formData.innerBoxHeight,
            innerForceSoldOutNotice: formData.innerForceSoldOutNotice,
          };
    const commonVariantUpdateInput: ProductVariantInput = {
      // 제품 옵션(variant) 기본 정보
      trackInventory: formData.trackInventory,
      isVendorTrackInventory: formData.isVendorTrackInventory,
      forceSoldOutNotice: formData.forceSoldOutNotice,
      salesStatus: formData.salesStatus,
      stoppedReason: formData.stoppedReason,
      stoppedReasonEtc: formData.stoppedReasonEtc,
      // 제품 속성(variant) 속성 정보 - 이너제품 input과 항상 같은 뮤테이션에 함께 input으로 입력해야 함(이너 입수량와 아우터 입수량의 배수 여부 validate가 존재하기 때문)
      qtyPerBoxUnitType: formData.qtyPerBoxUnitType,
      priorityLevel: formData.priorityLevel,
      salesUnitType: formData.salesUnitType,
      qtyPerBox: formData.qtyPerBox,
      boxLength: formData.boxLength,
      boxWidth: formData.boxWidth,
      boxHeight: formData.boxHeight,
      palletQty: formData.palletQty,
      palletM: formData.palletM,
      palletN: formData.palletN,
      palletO: formData.palletO,
      maker: formData.maker,
      stockAdjustFactor: formData.stockAdjustFactor,
      note: formData.note,
      poNote: formData.poNote,
      // 충전금 상품은 원산지 정보를 null로 보냄
      countryOfOrigin: formData.isForCreditsRefill ? null : formData.countryOfOrigin,

      // 검수 정보
      needToInspect: formData.needToInspect,
      inspectMemo: formData.inspectMemo,
      inspectReason: formData.inspectReason,
      inspectReportTemplate: formData.inspectReportTemplate,
      inspectType: formData.inspectType,

      isAdjustPrice: formData.isAdjustPrice,
      qtyPerDeliveryBox: formData.qtyPerDeliveryBox,
    };

    const productVariantUpdateInputForFulfilledByVendor: StrictOmit<
      ProductVariantInput,
      "allowAutoConsignment" | "isSubPv" | "canSaleByInner"
    > = {
      ...commonVariantUpdateInput,
      palletQty: 0,
      palletM: 0,
      palletN: 0,
      palletO: 0,
      // 후정산여부
      isDeferred: formData.isDeferred,
    };
    const productVariantUpdateInputForFulfilledByBoss: ProductVariantInput = {
      ...commonVariantUpdateInput,
      // 제품 옵션(variant) 기본 정보
      allowAutoConsignment: formData.allowAutoConsignment,
      autoTurnOffAllowAutoConsignment: formData.autoTurnOffAllowAutoConsignment,
      isSubPv: formData.isSubPv,
      canSaleByInner: formData.canSaleByInner,
      requiredExpDateMgmt: formData.requiredExpDateMgmt,
      isSeasonal: formData.isSeasonal,
      peakSeasonStartDate: formData.peakSeasonStartDate,
      peakSeasonEndDate: formData.peakSeasonEndDate,
      // 이너박스 정보(직배송 제품, 직거래 상품인 경우는 무관)
      ...innerVariantUpdateInput,
    };
    const productVariantUpdateInput = isFulfilledByVendor
      ? productVariantUpdateInputForFulfilledByVendor
      : productVariantUpdateInputForFulfilledByBoss;

    const hasVariants: boolean = checkHasVariants(product);

    // 옵션형이면 product만 업데이트 아니면 전체 업데이트.
    if (product.isFulfilledByVendor === false) {
      const result = await updateExtendedProduct({
        productId: product.id,
        productInput: productUpdateInput,
        productVariantId: hasVariants ? undefined : product.defaultVariant.id,
        productVariantInput: hasVariants ? undefined : productVariantUpdateInput,
        additionalInput: { manageEvent: formData.manageEvent },
        // query의 product 필드만 있어도 VARIANT는 포함임.
        forProductOnly: true,
      });
      const errors: Array<ProductErrorFragment | StockErrorFragment> = [...result.data.extendedProductUpdate.errors];
      return errors;
    } else {
      const result = await updateFbvMixedProduct({
        productId: product.id,
        productInput: productUpdateInput,
        productVariantId: brandProductVariant.productVariant.id,
        productVariantInput: hasVariants ? undefined : productVariantUpdateInput,
        brandProductId: brandProductVariant.brandProduct.id,
        brandProductInput: {
          name: formData.name,
          isOnlyPayableByCash: formData.isOnlyPayableByCash,
        },
        brandProductVariantId: brandProductVariant.id,
        brandProductVariantInput: {
          showBeforePrice: formData.bpvShowBeforePrice,
          beforePrice: toPriceIncludeVat(formData.bpvBeforePriceExcludeVat, formData.isTaxFree),
          price: formData.bpvPriceExcludeVat + formData.bpvPriceVat,
          priceVat: formData.bpvPriceVat,
          deliveryFee: 0,
        },

        additionalInput: { manageEvent: formData.manageEvent },
        bpvManageEvent: {
          type: BrandProductVariantManageEventTypeEnum.TYPE_ETC,
          title: "",
          reason: "",
        },
      });
      const errors: Array<ProductErrorFragment | StockErrorFragment> = [...result.data.fbvMixedProductUpdate.errors];
      return errors;
    }
  };
}

export function createImageUploadHandler(
  id: string,
  createProductImage: (variables: ProductImageCreateVariables) => void
) {
  return (file: File) =>
    createProductImage({
      alt: "",
      image: file,
      product: id,
    });
}

export function createImageReorderHandler(
  product: ProductDetails_product,
  reorderProductImages: (variables: ProductImageReorderVariables) => void
) {
  return ({ newIndex, oldIndex }: ReorderEvent) => {
    if (newIndex !== oldIndex) {
      let ids = product.images.map((image) => image.id);
      ids = arrayMove(ids, oldIndex, newIndex);
      reorderProductImages({
        imagesIds: ids,
        productId: product.id,
      });
    }
  };
}

export function createVariantReorderHandler(
  product: ProductDetails_product | ProductVariantDetails_productVariant_product | ProductForCreateVariant_product,
  reorderProductVariants: (variables: ProductVariantReorderVariables) => void
) {
  return ({ newIndex, oldIndex }: ReorderEvent) => {
    if (newIndex !== oldIndex) {
      reorderProductVariants({
        move: {
          id: product.outerVariants[oldIndex].id,
          sortOrder: newIndex - oldIndex,
        },
        productId: product.id,
      });
    }
  };
}
