  // 모바일 앱 버전 형식의 버전을 input으로 받아서, 이전 버전과 최신 버전 중 최신 버전이 더 큰(최신) 버전값을 갖으면 true 반환
  compareVersions: (previousVersion: string, latestVersion: string, allowSame: boolean) => {
    const [previousMajor, previousMinor, previousBuild] = previousVersion.split(".").map((el) => parseInt(el, 10));
    const [latestMajor, latestMinor, latestBuild] = latestVersion.split(".").map((el) => parseInt(el, 10));

    if (previousMajor !== latestMajor) {
      return previousMajor < latestMajor;
    }

    if (previousMinor !== latestMinor) {
      return previousMinor < latestMinor;
    }

    if (allowSame) {
      return previousBuild <= latestBuild;
    }

    return previousBuild < latestBuild;
  },

  findValidUrls: (str) => {
    const reg =
      /(http(s)?:\/\/|www.)([a-z0-9\w]+\.*)+[a-z0-9]{2,4}([\/a-z0-9-%#?&=\w])+(\.[a-z0-9]{2,4}(\?[\/a-z0-9-%#?&=\w]+)*)*/gi;
    return str.match(reg);
  },

