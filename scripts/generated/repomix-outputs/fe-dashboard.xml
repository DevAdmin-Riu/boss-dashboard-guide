  checkInputNumberWithPrecision: (value, precision?: number) => {
    // value에서 쉼표를 제거한다.(3자리마다 있는)
    const removedCommaValue = utils.removeComma(value);
    const reg = !precision ? new RegExp(`^-?([0-9]\\d*)$`) : new RegExp(`^-?([0-9]\\d*)\.?\\d{0,${precision}}$`);
    return reg.test(removedCommaValue);
  },
  checkNDecimalPlaces: (value: number | string, n: number): boolean => {
    if (utils.isEmpty(value)) {
      return false;
    }
    const str = String(value).trim();

    // n === 0 이면 소수점이 없어야 true
    if (n === 0) {
      return !str.includes(".");
    }

    // 소수점을 기준으로 분리
    const parts = str.split(".");
    // 소수점이 두 번 이상이면 false
    if (parts.length > 2) {
      return false;
    }
    // 소수점이 없으면 정수이므로 허용
    if (parts.length === 1) {
      return true;
    }
    // 소수점이 한 번 있을 때는 소수부 길이만 체크
    return parts[1].length <= n;
  },
  removeAllNoneNumeric: (value) => {
