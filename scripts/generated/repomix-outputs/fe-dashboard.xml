    render: (_, record) => record.order.user?.brandStoreUser?.brandStore?.code ?? "-",
  };
  const brandStoreNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.brandStore.BRAND_STORE_NAME,
