<file path="src/app/views/order/shipping/components/ShippingStatisticsPage/ShippingStatisticsPage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { AttributeDetails_attribute } from "@src/app/views/settings/attributes/api/types/AttributeDetails";
import { FilterPageProps } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Card, Row, Space, Table, Typography } from "antd";
import React from "react";

import { CouriersDeliveryFeesStats_couriersDeliveryFeesStats } from "../../api/types/CouriersDeliveryFeesStats";
import { createFilterStructure, ShippingStatisticsFilterKeys, ShippingStatisticsFilterOpts } from "./filter";
import { getShippingStatisticsTableSettings, getTableSummary } from "./ShippingStatisticsTableSettings";

interface ShippingStatisticsPageProps
  extends FilterPageProps<ShippingStatisticsFilterKeys, ShippingStatisticsFilterOpts> {
  dataSource: CouriersDeliveryFeesStats_couriersDeliveryFeesStats[];
  disabled: boolean;
  boxSizeTypeData: AttributeDetails_attribute;
}

interface CourierInfoType extends CouriersDeliveryFeesStats_couriersDeliveryFeesStats {
  ratio?: number;
}

export interface ShippingStatisticsTableDataType {
  boxSizeType: null | string;
  defaultDeliveryFeeExcludeVat: number;
  normal: CourierInfoType | null;
  return: CourierInfoType | null;
  total?: {
    deliveryFeeSum?: number | null;
    count?: number | null;
    ratio?: number;
  };
}

interface TotalCountListType {
  normalTotalCount?: number;
  returnTotalCount?: number;
  allTotalCount?: number;
}

const ShippingStatisticsPage: React.FC<ShippingStatisticsPageProps> = (props) => {
  const {
    currentTab,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    filterOpts,
    dataSource,
    disabled,
    boxSizeTypeData,
  } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);

  const getPreProcessingData = (dataList): ShippingStatisticsTableDataType[] => {
    if (utils.isEmpty(dataList)) {
      return null;
    }

    const initObj = {
      deliveryFeeSum: 0,
      count: 0,
      boxSizeType: null,
      deliveryFee: null,
      isReturn: null,
    };

    const boxSizeTypeDataList = boxSizeTypeData.values.reduce((acc, cur) => {
      if (cur.slug === "위탁") {
        return acc;
      }
      acc.push({
        boxSizeType: cur.slug,
        defaultDeliveryFeeExcludeVat: toPriceExcludeVat(cur.value.delivery_fee),
        normal: { ...initObj },
        return: { ...initObj },
      });
      return acc;
    }, []);

    [...boxSizeTypeDataList].reduce((_, cur) => {
      const outerFindIndex = dataList.findIndex((item) => item.boxSizeType === cur.boxSizeType);
      if (outerFindIndex !== -1) {
        dataList.forEach((item) => {
          const innerFindIndex = boxSizeTypeDataList.findIndex((accItem) => accItem.boxSizeType === item.boxSizeType);
          if (innerFindIndex !== -1) {
            const innerCur = boxSizeTypeDataList[innerFindIndex];
            if (item.isReturn === false) {
              boxSizeTypeDataList[innerFindIndex] = {
                ...innerCur,
                normal: { ...item },
              };
            } else {
              boxSizeTypeDataList[innerFindIndex] = {
                ...innerCur,
                return: { ...item },
              };
            }
          }
        });
      }
    }, []);

    return boxSizeTypeDataList;
  };

  const getFinalData = (dataList, totalCountList): ShippingStatisticsTableDataType[] =>
    dataList?.reduce((acc, cur) => {
      acc.push({
        ...cur,
        normal: {
          ...cur.normal,
          ratio: cur.normal.count === 0 ? 0 : ((cur.normal.count / totalCountList.normalTotalCount) * 100).toFixed(2),
        },
        return: {
          ...cur.return,
          ratio: cur.return.count === 0 ? 0 : ((cur.return.count / totalCountList.returnTotalCount) * 100).toFixed(2),
        },
        total: {
          deliveryFeeSum: Number(cur.normal.deliveryFeeSum) + Number(cur.return.deliveryFeeSum),
          count: cur.normal.count + cur.return.count,
          ratio:
            cur.normal.count + cur.return.count === 0
              ? 0
              : (((cur.normal.count + cur.return.count) / totalCountList.allTotalCount) * 100).toFixed(2),
        },
      });
      return acc;
    }, []);

  const getTotalCountList = (dataList): TotalCountListType =>
    dataList?.reduce(
      (acc, cur) => {
        acc.normalTotalCount += cur.normal.count;
        acc.returnTotalCount += cur.return.count;
        acc.allTotalCount += cur.normal.count + cur.return.count;

        return acc;
      },
      { normalTotalCount: 0, returnTotalCount: 0, allTotalCount: 0 }
    );

  const columns = getShippingStatisticsTableSettings();

  const preProcessingData = getPreProcessingData(dataSource);
  const totalCountList = getTotalCountList(preProcessingData);
  const finalData = getFinalData(preProcessingData, totalCountList);

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Typography.Title level={4}>{sectionNames.shippingStatistics}</Typography.Title>
