  },
  isHtml: boolean = false
) => {
  if (utils.isEmpty(rackStockDetail, true)) {
    return isHtml ? <Tag color="gray">-</Tag> : "-";
  }
  const { location, totalRemainQtyByLocAndPv } = rackStockDetail;
  const safetyPickingStock = location.safetyPickingStock;
  const isSafety = totalRemainQtyByLocAndPv >= safetyPickingStock;
