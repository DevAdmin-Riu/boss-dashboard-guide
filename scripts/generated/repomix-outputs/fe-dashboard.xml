<file path="src/app/views/order/orders/components/FulfillmentInspectListPage/utils.ts">
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";

import { FulfillmentLinesByVariant_fulfillmentLinesByVariant } from "../../api/types/FulfillmentLinesByVariant";
import { TInspectByVariantLinesObj } from "../../views/FulfillmentInspectListView/FulfillmentInspectListView";

const calcUninspectedQtyByVariant = (record: FulfillmentLinesByVariant_fulfillmentLinesByVariant) => {
  const { fulfillmentLines } = record;
  const quantityByVariant = fulfillmentLines.reduce((acc, line) => acc + line.quantity, 0);
  const inspectedQtyByVariant = fulfillmentLines.reduce((acc, line) => acc + line.inspectedQty, 0);
  return quantityByVariant - inspectedQtyByVariant;
};

export const checkIsInspectCompletedWatched = (
  record: FulfillmentLinesByVariant_fulfillmentLinesByVariant,
  inspectQtyByVariantWatched: number
) => {
  const uninspectedQtyWatched = calcUninspectedQtyByVariant(record) - inspectQtyByVariantWatched;
  return uninspectedQtyWatched === 0;
};

export const checkIsInspectProgressWatched = (
  record: FulfillmentLinesByVariant_fulfillmentLinesByVariant,
  inspectQtyByVariantWatched: number
) => {
  const isInspectCompleted = checkIsInspectCompletedWatched(record, inspectQtyByVariantWatched);
  if (isInspectCompleted) {
    return false;
  }
  const { fulfillmentLines } = record;
  const inspectedQtyByVariant = fulfillmentLines.reduce((acc, line) => acc + line.inspectedQty, 0);
  const uninspectedQtyByVariant = calcUninspectedQtyByVariant(record);
  return (inspectedQtyByVariant > 0 || inspectQtyByVariantWatched > 0) && uninspectedQtyByVariant > 0;
};

export const checkIsAllInspectCompletedWatched = (
  dataSource: FulfillmentLinesByVariant_fulfillmentLinesByVariant[],
  linesObjWatched: TInspectByVariantLinesObj
) => {
  const linesArr = convertFormLinesObjToArr(linesObjWatched, "variantId");

  const inspectedLineExist = linesArr.some((line) => line.inspectQtyByVariant > 0);
  const isAllCompleted =
    inspectedLineExist &&
    dataSource.length > 0 &&
    dataSource.every((record) => {
      const inspectQtyByVariantWatched = linesObjWatched[record.productVariant.id]?.inspectQtyByVariant;
      const isCompletedWatched = checkIsInspectCompletedWatched(record, inspectQtyByVariantWatched);
      return isCompletedWatched;
    });
  return isAllCompleted;
};
