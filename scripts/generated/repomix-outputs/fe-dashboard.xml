import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useRootCategoriesFilterDownloadQuery, useRootCategoriesQuery } from "../../api/queries";
import { CategoryListPage } from "../../components/CategoryListPage/CategoryListPage";
import {
  categoryCreateViewUrl,
  categoryDetailsViewUrl,
  categoryListViewUrl,
  CategoryListViewUrlDialog,
  CategoryListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface CategoryListViewProps {
  params: CategoryListViewUrlQueryParams;
}

export const CategoryListView: React.FC<CategoryListViewProps> = ({ params }) => {
  const targetUrl = categoryListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.CATEGORY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useRootCategoriesFilterDownloadQuery);

  const queryVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useRootCategoriesQuery({
    variables: queryVariables,
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.categories?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<CategoryListViewUrlDialog, CategoryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, categoryListViewUrl, params);

  const filterOpts = getFilterOpts(params);

  return (
    <>
      <CategoryListPage
        categories={maybe(() => data.categories.edges.map((edge) => edge.node), [])}
        currentTab={currentTab}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        settings={settings}
        sort={getSortParams(params)}
        onAdd={() => navigate(categoryCreateViewUrl())}
        onRowClick={(id) => navigate(categoryDetailsViewUrl(id))}
        onSort={handleSort}
        disabled={loading}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        onFilterChange={changeFilters}
        filterOpts={filterOpts}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

<file path="src/app/views/product/categories/views/CategoryListView/filters.ts">
import { CategoryFilterInput, CategoryKindEnum, CategoryTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { CategoryFilterKeys, CategoryListFilterOpts } from "../../components/CategoryListPage/filters";
import {
  CategoryListViewUrlFilters,
  CategoryListViewUrlFiltersEnum,
  CategoryListViewUrlFiltersWithMultipleValuesEnum,
  CategoryListViewUrlQueryParams,
} from "../../urls";

export const CATEGORY_FILTERS_KEY = "categoryFilters";

export function getFilterOpts(params: CategoryListViewUrlFilters): CategoryListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    name_Icontains: {
      active: maybe(() => !utils.isEmpty(filterVariables.name_Icontains), true),
      value: filterVariables.name_Icontains || "",
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => dedupeFilter(filterVariables.type.map((t) => findValueInEnum(t, CategoryTypeEnum))), []),
    },
    kind: {
      active: maybe(() => !utils.isEmpty(filterVariables.kind), false),
      value: maybe(() => dedupeFilter(filterVariables.kind.map((k) => findValueInEnum(k, CategoryKindEnum))), []),
    },
  };
}

export function getFilterVariables(params: CategoryListViewUrlFilters): CategoryFilterInput {
  return {
    type: params.type !== undefined ? maybe(() => params.type.map((t) => findInEnum(t, CategoryTypeEnum))) : null,
    kind: params.kind !== undefined ? maybe(() => params.kind.map((t) => findInEnum(t, CategoryKindEnum))) : null,
    name_Icontains: params.name_Icontains,
  };
}

export function getFilterQueryParam(filter: IFilterElement<CategoryFilterKeys>): CategoryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case CategoryFilterKeys.name_Icontains:
      return getSingleValueQueryParam(filter, CategoryListViewUrlFiltersEnum.name_Icontains);
    case CategoryFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        CategoryListViewUrlFiltersWithMultipleValuesEnum.type,
        CategoryTypeEnum
      );
    case CategoryFilterKeys.kind:
      return getMultipleEnumValueQueryParam(
        filter,
        CategoryListViewUrlFiltersWithMultipleValuesEnum.kind,
        CategoryKindEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<CategoryListViewUrlFilters>(CATEGORY_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  CategoryListViewUrlQueryParams,
  CategoryListViewUrlFilters
>({ ...CategoryListViewUrlFiltersEnum, ...CategoryListViewUrlFiltersWithMultipleValuesEnum });
</file>

<file path="src/app/views/product/categories/views/CategoryListView/sort.ts">
import { CategorySortField } from "@src/api/types/globalTypes";
import { CategoryListViewUrlSortField } from "@src/app/views/product/categories/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: CategoryListViewUrlSortField): CategorySortField {
  switch (sort) {
    case CategoryListViewUrlSortField.name:
      return CategorySortField.NAME;
    case CategoryListViewUrlSortField.productCount:
      return CategorySortField.PRODUCT_COUNT;
    case CategoryListViewUrlSortField.subcategoryCount:
      return CategorySortField.SUBCATEGORY_COUNT;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
</file>

