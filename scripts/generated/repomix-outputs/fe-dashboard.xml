<file path="src/app/views/purchase/purchaseOrders/components/PoLinesInvoiceSentEmailCreateModal/PoLinesInvoiceSentEmailCreateModal.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import useUser from "@hooks/useUser";
import { PoLineShipmentInspectionSentEmailInput, PoLinesInvoiceSentEmailInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { isValidMultipleEmailValidator } from "@src/app/components/antd/Form/validators";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { useSimpleBrandWithChargeInfoQuery } from "@src/app/views/brand/brands/api/queries";
import { usePvListWithOnlyCategoryQuery } from "@src/app/views/product/products/api/queries";
import { PvListWithOnlyCategory_productVariants_edges_node_product_category } from "@src/app/views/product/products/api/types/PvListWithOnlyCategory";
import { generatePoInvoiceExcelInfoList } from "@src/app/views/vendorStaff/vsSection/utils";
import { StrictOmit } from "@src/global/core/types/types";
import {
  convertWorkBookToXlsxFile,
  convertWorkbookToXlsxFileByExceljs,
  excelDownloadByWorkBook,
  IExcelDownloadByWorkBookProps,
  IRequestExcelDownloadProps,
  requestExcelDownloadByExceljs,
} from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Col, Divider, Form, Input, Modal, Row, Select, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { usePoLinesInvoiceSentEmailCreateMutation } from "../../api/mutations";
import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import { getPoLinesInvoiceSentEmailPvListTableSettings } from "./PoLinesInvoiceSentEmailPvListTableSettings";
import { generatePoLineShipmentInspectionExcelInfo } from "./utils";

export interface ICategoryMappingByPvId {
  [pvId: string]: PvListWithOnlyCategory_productVariants_edges_node_product_category;
}

type TFormData = StrictOmit<
  PoLinesInvoiceSentEmailInput,
  "purchaseOrderLines" | "file" | "shipmentInspectionInputList"
>;

interface PoLinesInvoiceSentEmailCreateModalProps {
  open: boolean;
  poLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  onClose: (shouldReset: boolean) => void;
}

export const PoLinesInvoiceSentEmailCreateModal: React.FC<PoLinesInvoiceSentEmailCreateModalProps> = (props) => {
  const { open, poLines, onClose } = props;
  // NOTE: 현재 B2B 발주 > 배송 완료 확인 페이지에서만 이용하고 있으므로 아래와 같이 선언 - 재고, 위탁에서도 이용하게 되면 아래 코드 수정 필요(routeParams 이용하는 방안으로)
  const isB2b = true;
  const trackInventory = false;
  const { user } = useUser();
  const shop = useShop();
  const b2bOrderManagerEmail = shop?.emailPluginInfo?.b2bOrderManagerEmail?.split(",")[0] || "";

  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);
  const [poInvoiceFileInfo, setPoInvoiceFileInfo] = useState<IExcelDownloadByWorkBookProps>(null);
  const [poLineShipmentInspectionFileInfoObj, setPoLineShipmentInspectionFileInfoObj] = useState<{
    [poLineId: string]: IRequestExcelDownloadProps;
  }>({});
  const [showConfirmModal, setShowConfirmModal] = useState(false);

  const onConfirmModalOpen = () => {
    setShowConfirmModal(true);
  };
  const onConfirmModalClose = () => {
    setShowConfirmModal(false);
  };

  // 로우 선택 시점에서부터 선택된 발주 품목의 주문 고객사가 모두 동일한 경우(1개)에 해당 모달 오픈 가능하므로 첫 번째 로우의 주문 고객사 이용
  const brandId = maybe(() => poLines[0].orderLine.order.user.brand.id, null);
  const poLineIdList = maybe(() => poLines.map((poLine) => poLine.id), []);
  const pvIdList = maybe(() => poLines.map((poLine) => poLine.variant.id), []);

  const { data: brandData, loading: brandLoading } = useSimpleBrandWithChargeInfoQuery({
    skip: !open || utils.isEmpty(brandId),
    variables: { id: brandId },
  });
  const brand = maybe(() => brandData.brand, null);

  const { data: pvListData, loading: pvListLoading } = usePvListWithOnlyCategoryQuery({
    skip: !open || utils.isEmpty(pvIdList),
    variables: { first: pvIdList.length, filter: { ids: pvIdList } },
  });
  const pvListWithOnlyCategory = maybe(() => pvListData.productVariants.edges.map((edge) => edge.node), []);
  const categoryMappingByPvId = pvListWithOnlyCategory.reduce<ICategoryMappingByPvId>((res, pv) => {
    res[pv.id] = pv.product.category;
    return res;
  }, {});

  const [poLinesInvoiceSentEmailCreate, poLinesInvoiceSentEmailCreateOpts] = usePoLinesInvoiceSentEmailCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.poLinesInvoiceSentEmailCreate.errors,
        "거래명세서가 발송되었습니다.",
        () => {
          onConfirmModalClose();
          onClose(true);
        }
      ),
  });

  const onSubmit = async (formData: TFormData) => {
    const poInvoiceFile = convertWorkBookToXlsxFile(poInvoiceFileInfo);
    if (utils.isEmpty(poInvoiceFile)) {
      showNotificationError(
        "거래명세서 파일이 올바르게 전달되지 않았습니다. 새로고침 후 발주 품목을 다시 선택해서 진행해주세요."
      );
      return;
    }

    const shipmentInspectionInputPromiseList = Object.entries(poLineShipmentInspectionFileInfoObj).map<
      Promise<PoLineShipmentInspectionSentEmailInput>
    >(async ([poLineId, fileInfo]) => {
      const file = await convertWorkbookToXlsxFileByExceljs(fileInfo);
      return {
        ...formData,
        purchaseOrderLine: poLineId,
        file,
      };
    });
    const shipmentInspectionInputList = await Promise.all(shipmentInspectionInputPromiseList);

    const input: PoLinesInvoiceSentEmailInput = {
      ...formData,
      purchaseOrderLines: poLineIdList,
      file: poInvoiceFile,
      shipmentInspectionInputList,
    };
    poLinesInvoiceSentEmailCreate({ variables: { input } });
  };

  const brandName = brand?.name || "-";
  const recipientListInitialValue = [
    brand?.peopleInChargeInfo?.bossMall.email,
    brand?.peopleInChargeInfo?.warehousing.email,
  ];
  const ccListInitialValue = [b2bOrderManagerEmail];

  const initialValues: TFormData = {
    title: `[㈜리우] ${brandName} 거래명세서 송부의 건`,
    fromEmail: b2bOrderManagerEmail,
    recipientList: recipientListInitialValue.filter(Boolean),
    ccList: ccListInitialValue.filter(Boolean),
  };

  useEffect(() => {
    if (open && !brandLoading && !pvListLoading) {
      form.resetFields();

      generatePoInvoiceExcelInfoList({ poLines, trackInventory, user, isB2b }).then((invoiceFileInfoList) => {
        if (invoiceFileInfoList.length > 0) {
          setPoInvoiceFileInfo(invoiceFileInfoList[0]);
        }
      });
      poLines.forEach((poLine) => {
        generatePoLineShipmentInspectionExcelInfo({ user, purchaseOrderLine: poLine, categoryMappingByPvId }).then(
          (shipmentInspectionFileInfo) => {
            if (!utils.isEmpty(shipmentInspectionFileInfo)) {
              setPoLineShipmentInspectionFileInfoObj((prev) => ({ ...prev, [poLine.id]: shipmentInspectionFileInfo }));
            }
          }
        );
      });
    }
  }, [open, brandLoading, pvListLoading]);

  const handleInvoiceDownload = () => {
    excelDownloadByWorkBook(poInvoiceFileInfo);
  };
  const handleShipmentInspectionDownload = (poLineId: string) => {
    const fileInfo = poLineShipmentInspectionFileInfoObj[poLineId];
    requestExcelDownloadByExceljs(fileInfo);
  };
  const handleShipmentInspectionListDownload = () => {
    const poLinesWithExistingTemplate = poLines.filter(
      (poLine) => !utils.isEmpty(categoryMappingByPvId[poLine.variant.id]?.shipmentInspectionFile)
    );
    poLinesWithExistingTemplate.forEach((poLine) => handleShipmentInspectionDownload(poLine.id));
    return;
  };

  const modalLoading = brandLoading || pvListLoading || poLinesInvoiceSentEmailCreateOpts.loading;

  const columns = getPoLinesInvoiceSentEmailPvListTableSettings({
    isB2b,
    loading: modalLoading,
    categoryMappingByPvId,
    onShipmentInspectionDownload: handleShipmentInspectionDownload,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      maskClosable={false}
      title="거래명세서 발송"
      width={1100}
      onCancel={() => onClose(false)}
      footer={[
        <Button key="cancel" onClick={() => onClose(false)}>
          취소
        </Button>,
        <Button
          key="invoice"
          loading={modalLoading}
          disabled={utils.isEmpty(poInvoiceFileInfo)}
          icon={<DownloadOutlined />}
          onClick={handleInvoiceDownload}
        >
          거래명세서 미리보기
        </Button>,
        <Button
          key="shipment-inspection"
          loading={modalLoading}
          disabled={utils.isEmpty(Object.keys(poLineShipmentInspectionFileInfoObj))}
          icon={<DownloadOutlined />}
          onClick={handleShipmentInspectionListDownload}
        >
          출하검사서 미리보기(일괄)
        </Button>,
        <Button
          key="send"
          loading={modalLoading}
          type="primary"
          onClick={() =>
            form
              .validateFields()
              .then(() => onConfirmModalOpen())
              .catch((err) => console.error("거래명세서 발송 에러 : ", err))
          }
        >
          발송
        </Button>,
      ]}
    >
      <Space direction="vertical">
        <Space direction="vertical" size={0}>
          <Typography>
            거래명세서를 추가로 발송하려는 품목과 각 품목에 대한 출하검사서 양식을 설정한 뒤 발송해주세요.
          </Typography>
          <Typography.Text type="secondary">
            * 출하검사서 양식은 각 제품의 카테고리 상세 페이지에서 설정 가능합니다.
          </Typography.Text>
        </Space>

        <Form layout="vertical" form={form} disabled={modalLoading} initialValues={initialValues} onFinish={onSubmit}>
          <Form.Item name={TypeSafeForm.getValidDataIndex("title")} label="메일 제목" rules={[{ required: true }]}>
            <Input placeholder="메일 제목을 입력하세요" />
          </Form.Item>
          <Row gutter={16}>
            <Col span={12}>
              <Form.Item
                name="fromEmail"
                label="보내는 사람"
                rules={[{ required: true }, { type: "email", message: "올바른 이메일 형식이 아닙니다" }]}
              >
                <Input placeholder="이메일 주소를 입력하세요" />
              </Form.Item>
            </Col>
            <Col span={12}>
              <Form.Item
                name="recipientList"
                label="받는 사람"
                required
                rules={[{ required: true }, ...isValidMultipleEmailValidator()]}
                tooltip="이메일 입력 후 Enter 또는 쉼표(,)로 구분"
              >
                <Select
                  mode="tags"
                  placeholder="이메일 주소를 입력하세요"
                  tokenSeparators={[","]}
                  notFoundContent={null}
                />
              </Form.Item>
            </Col>
          </Row>

          <Row gutter={16}>
            <Col span={12}>
              <Form.Item name="ccList" label="참조" tooltip="선택사항">
                <Select
                  mode="tags"
                  placeholder="이메일 주소를 입력하세요"
                  tokenSeparators={[","]}
                  notFoundContent={null}
                />
              </Form.Item>
            </Col>
          </Row>
        </Form>
      </Space>

      <Divider />

      <PatchedColumnsTable<PurchaseOrderLineList_purchaseOrderLines_edges_node>
        {...commonTableProps}
        columns={columns}
        dataSource={poLines}
        scroll={{ x: tableWidthSum, y: 400 }}
      />

      {/* 발송 확인 모달 */}
      <ConfirmModal
        visible={showConfirmModal}
        helpText="모든 정보가 맞는지 확인했고, 이대로 발송하시겠습니까?"
        onOk={form.submit}
        onCancel={onConfirmModalClose}
        okText="발송"
        cancelText="취소"
      />
    </Modal>
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PoLinesInvoiceSentEmailCreateModal/PoLinesInvoiceSentEmailPvListTableSettings.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getCategoryLabel } from "@src/app/views/product/products/utils/data";
import { utils } from "@utils/utils";
import { Button, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import { makeProductSpecFromPoLine } from "../PurchaseOrderLineListPage/PurchaseOrderLineListTableSettings";
import { multiplePoEventTypeTackBackValue } from "../PurchaseOrderLineListPage/utils";
import { ICategoryMappingByPvId } from "./PoLinesInvoiceSentEmailCreateModal";

interface PoLinesInvoiceSentEmailPvListTableSettingsProps {
  isB2b: boolean;
  loading: boolean;
  categoryMappingByPvId: ICategoryMappingByPvId;
  onShipmentInspectionDownload: (poLineId: string) => void;
}

export const getPoLinesInvoiceSentEmailPvListTableSettings = (
  props: PoLinesInvoiceSentEmailPvListTableSettingsProps
): ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> => {
  const { isB2b, loading, categoryMappingByPvId, onShipmentInspectionDownload } = props;
  const fixedRightFlag = utils.fixedRightFlag();

  const columns: ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> = [
    {
      title: "No",
      key: "numIdx",
      align: "center",
      width: 40,
      render: (_, _record, idx) => idx + 1,
    },
    {
      title: columnNameConstant.order.ORDER_COMPOSED_ID,
      key: "orderComposedId",
      align: "center",
      width: 100,
      render: (_, record) => record.orderLine?.order?.composedIdWithPrefix || "-",
    },
    {
      title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
      key: "orderLineComposedId",
      align: "center",
      width: isB2b ? 150 : 120,
      render: (_, record) => (record.orderLine ? record.orderLine.composedIdWithPrefix : "-"),
    },
    {
      title: columnNameConstant.product.SKU,
      key: "productSku",
      align: "center",
      width: 120,
      render: (_, record) => record.productSku || "-",
    },
    {
      title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
      key: "brandProductName",
      align: "left",
      width: 200,
      render: (_, record) => record.orderLine?.productName || "-",
    },
    {
      title: columnNameConstant.category.TYPE,
      key: "category",
      align: "left",
      width: 200,
      render: (_, record) =>
        getCategoryLabel(categoryMappingByPvId[record.variant.id], { hideType: true, hideKind: true }),
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 200,
      render: (_, record) => makeProductSpecFromPoLine(record),
    },
    {
      title: columnNameConstant.purchaseOrder.PURCHASE_QTY,
      key: "purchaseQty",
      align: "right",
      width: 80,
      render: (_, record) => multiplePoEventTypeTackBackValue(record.purchaseOrder.eventType, record.purchaseQuantity),
    },
    {
      title: ["출하검사서", "(개별)"],
      key: "shipmentInspectionByRow",
      align: "center",
      width: 100,
      fixed: fixedRightFlag,
      render: (_, record) => {
        const category = categoryMappingByPvId[record.variant.id];
        const templateEmpty = utils.isEmpty(category?.shipmentInspectionFile);
        if (templateEmpty) {
          return <Typography.Text type="secondary">양식 없음</Typography.Text>;
        }
        return (
          <Button
            size="small"
            icon={<DownloadOutlined />}
            loading={loading}
            onClick={() => onShipmentInspectionDownload(record.id)}
          >
            미리보기
          </Button>
        );
      },
    },
  ];
  return columns;
};
</file>

