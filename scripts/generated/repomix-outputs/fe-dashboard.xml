<file path="src/app/components/antd/Table/editableCell.tsx">
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { Checkbox, Col, DatePicker, Form, Input, InputNumber, Row, Select, Switch } from "antd";
import { NamePath } from "antd/lib/form/interface";
import { Moment } from "moment";
import React from "react";

import { PriceWithVatFormItem, PriceWithVatFormItemProps } from "../../PriceWithVatFormItem";

type EditableCellInputTypes =
  | "number"
  | "priceWithVat"
  | "text"
  | "textArea"
  | "checkbox"
  | "groupCheckbox"
  | "switch"
  | "searchSelect"
  | "singleSelect"
  | "multipleSelect"
  | "date";

export interface EditableCellProps extends React.HTMLAttributes<HTMLElement> {
  editing: boolean;
  formItemName: NamePath;
  inputType: EditableCellInputTypes;
  disabled?: boolean;
  additionalNodePrefix?: React.ReactNode;
  additionalNode?: React.ReactNode;
  children?: React.ReactNode;
  includeCurrency?: boolean;
  switchCheckedChildren?: React.ReactNode;
  switchUnCheckedChildren?: React.ReactNode;
  selectOptions?: Array<{ label: string; value: any }>;
  onSearch?: (value: string) => void;
  disabledDate?: (current: Moment) => boolean;
  readOnly?: boolean;
  bordered?: boolean;
  priceWithVatProps?: PriceWithVatFormItemProps;
  precision?: number;
}

export const EditableCell: React.FC<EditableCellProps> = ({
  editing,
  formItemName,
  inputType,
  disabled,
  additionalNodePrefix,
  additionalNode,
  children,
  includeCurrency,
  switchCheckedChildren,
  switchUnCheckedChildren,
  selectOptions,
  onSearch,
  disabledDate,
  readOnly,
  bordered,
  priceWithVatProps,
  precision,
  ...restProps
}) => {
  const valuePropName = inputType === "checkbox" || inputType === "switch" ? "checked" : "value";
  const inputNode =
    inputType === "checkbox" ? (
      <Checkbox disabled={disabled} />
    ) : inputType === "groupCheckbox" ? (
      <Checkbox.Group>
        <Row>
          {selectOptions.map((option, idx) => (
            <Col key={idx} xs={24} sm={8}>
              <Checkbox value={option?.value} disabled={disabled}>
                {option?.label}
              </Checkbox>
            </Col>
          ))}
        </Row>
      </Checkbox.Group>
    ) : inputType === "switch" ? (
      <Switch disabled={disabled} checkedChildren={switchCheckedChildren} unCheckedChildren={switchUnCheckedChildren} />
    ) : inputType === "searchSelect" ? (
      <Select
        showSearch
        dropdownMatchSelectWidth={false}
        disabled={disabled}
        style={{ width: "100%" }}
        options={selectOptions}
        filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
        onSearch={onSearch}
      />
    ) : inputType === "singleSelect" ? (
      <Select style={{ width: "100%" }} disabled={disabled} options={selectOptions} dropdownMatchSelectWidth={false} />
    ) : inputType === "multipleSelect" ? (
      <Select
        mode={"multiple"}
        style={{ width: "100%" }}
        disabled={disabled}
        options={selectOptions}
        dropdownMatchSelectWidth={false}
      />
    ) : inputType === "number" ? (
      <InputNumber
        {...getInputNumberProps({ isCommaDisplay: true, bordered, precision })}
        disabled={disabled}
        addonAfter={includeCurrency ? "원" : null}
        readOnly={readOnly}
      />
    ) : inputType === "date" ? (
      <DatePicker disabledDate={disabledDate} />
    ) : inputType === "textArea" ? (
      <Input.TextArea disabled={disabled} readOnly={readOnly} />
    ) : (
      <Input disabled={disabled} readOnly={readOnly} />
    );

  const FormItem =
    inputType === "priceWithVat" ? (
      <PriceWithVatFormItem {...priceWithVatProps} />
    ) : (
      <Form.Item name={formItemName} style={{ margin: 0 }} valuePropName={valuePropName}>
        {inputNode}
      </Form.Item>
    );

  return (
    <td {...restProps}>
      {editing ? (
        <>
          {additionalNodePrefix}
          {FormItem}
          {additionalNode}
        </>
      ) : (
        children
      )}
    </td>
  );
};

export const newEditableRowId = "newEditableRowId";
</file>

<file path="src/app/components/antd/Table/PatchedColumnsTable.tsx">
import { Table, TableProps } from "antd";
import React, { forwardRef } from "react";

import { MultiLineTypography } from "../../MultiLineTypography/MultiLineTypography";

const makePatchedColumn = (column: any) => {
  const isMultiLineTitle = Array.isArray(column.title);
  const patchedTitle = isMultiLineTitle ? <MultiLineTypography lines={column.title} /> : column.title;
  if ("children" in column && Array.isArray(column.children)) {
    const patchedChildren = column.children.map((childColumn: any) => makePatchedColumn(childColumn));
    return {
      ...column,
      title: patchedTitle,
      children: patchedChildren,
    };
  }
  return {
    ...column,
    title: patchedTitle,
  };
};

// 컴포넌트 정의
function InnerPatchedColumnsTable<RecordType extends object = any>(
  props: TableProps<RecordType>,
  ref: React.Ref<HTMLDivElement>
) {
  const { columns = [], ...restProps } = props;
  const patchedColumns = columns.map((col) => makePatchedColumn(col));
  return <Table<RecordType> {...restProps} columns={patchedColumns} ref={ref} />;
}

// 타입 덧씌우기
export const PatchedColumnsTable = forwardRef(InnerPatchedColumnsTable) as <RecordType extends object = any>(
  props: TableProps<RecordType> & { ref?: React.Ref<HTMLDivElement> }
) => React.ReactElement;
</file>

