    },
    {
      ...createTextField(
        displayOrder++,
        RiuMinusProfitBpvListFilterKeys.vendorSearch,
        filterNameConstant.VENDOR_SEARCH,
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
