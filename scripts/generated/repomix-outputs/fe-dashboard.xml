import AddressFormatter from "@src/app/components/AddressFormatter";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import Skeleton from "@src/app/components/Skeleton";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe, transformPhoneNumber } from "@utils/misc";
import { Button, Card, Divider, Row, Space, Typography } from "antd";
import React from "react";

import { OrderDetails_order } from "../../api/types/OrderDetails";
import { checkOrderedByStaffForBadStock, checkOrderedByStaffForEtc } from "../../utils";

export interface OrderCustomerProps extends Partial<FetchMoreProps> {
  order: OrderDetails_order;
  canEditAddresses: boolean;
  onProfileView: () => void;
  onShippingAddressEdit?: () => void;
  isHqStaff: boolean;
}

const OrderBrandStore: React.FC<OrderCustomerProps> = (props) => {
  const { canEditAddresses, order, onProfileView, onShippingAddressEdit, isHqStaff } = props;
  const user = maybe(() => order.user);

  const isOrderUserHqStaff = user?.isHqStaff;
  const brandStore = user?.brandStoreUser?.brandStore;

  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(order?.type);
  const isOrderByStaffForEtc = checkOrderedByStaffForEtc(order?.type);

  const shippingAddress = maybe(() => order.shippingAddress);

  const cardTitle = <CardTitleAntd title={isOrderUserHqStaff ? "계정 정보(본부에 의한 주문)" : "매장 정보"} />;

  const cardGridStyle: React.CSSProperties = {
    width: "100%",
  };

  const customerCardContentForOpenMall = () => {
    const etcInfo = order?.etcInfo;
    if (etcInfo) {
      const openMallName = etcInfo.open_mall_name ? etcInfo.open_mall_name : "-";
      const openMallOrderNumber = etcInfo.open_mall_order_number ? etcInfo.open_mall_order_number : "-";

      return (
        <Space direction="vertical">
          <Typography>오픈몰명: {openMallName}</Typography>
          <Typography>오픈몰 주문번호: {openMallOrderNumber}</Typography>
        </Space>
      );
    }
    return <Typography>오픈몰 주문 정보 없음</Typography>;
  };

  const customerCardContent = () => (
    <Space direction="vertical" size="small">
      {isOrderUserHqStaff ? (
        <>
          <Space direction="horizontal" align="center">
            <Typography.Title level={5}>{user.firstName}</Typography.Title>
            <Typography.Text type={"secondary"}>브랜드명: {user.brand.name}</Typography.Text>
          </Space>

          <Typography>아이디: {user.loginId || "미입력"}</Typography>
          <Typography>이름: {user.firstName || "미입력"}</Typography>
          <Typography>전화번호: {user.aligoPhone ? transformPhoneNumber(user.aligoPhone) : "미입력"}</Typography>
          <Typography>이메일: {user.email || "미입력"}</Typography>
          <Typography.Link strong onClick={onProfileView}>
            계정 정보
          </Typography.Link>
        </>
      ) : (
        <>
          <Space direction="horizontal" align="center">
            <Typography.Title level={5}>{brandStore.name}</Typography.Title>
            <Typography.Text type={"secondary"}>
              브랜드명: {user.brand.name} <Divider type="vertical" /> 매장코드: {brandStore.code}
            </Typography.Text>
          </Space>

          <Typography>전화번호: {brandStore.phone ? transformPhoneNumber(brandStore.phone) : "미입력"}</Typography>
          <Typography>사업자등록번호: {brandStore.bizRegNo || "미입력"}</Typography>
          <Typography>상호: {brandStore.bizRegCorpName || "미입력"}</Typography>
          <Typography>대표자이름: {brandStore.bizRegCeoName || "미입력"}</Typography>
          <Typography.Link strong onClick={onProfileView}>
            매장 정보
          </Typography.Link>
        </>
      )}
    </Space>
  );

  const addressCardContent = (
    <Space direction={"vertical"} size={"small"}>
      <Row justify={"space-between"}>
        <Typography.Title level={5}>배송지 주소</Typography.Title>
        {!isHqStaff && canEditAddresses && (
          <Button type={"text"} disabled={!onShippingAddressEdit && user === undefined} onClick={onShippingAddressEdit}>
            <Typography.Link strong>{buttonText.edit}</Typography.Link>
          </Button>
        )}
      </Row>
      {shippingAddress === undefined ? (
        <Skeleton />
      ) : shippingAddress === null ? (
        <Typography>입력되지 않음</Typography>
      ) : (
        <AddressFormatter address={shippingAddress} />
      )}
    </Space>
  );

  return (
    <Card title={cardTitle}>
      {!isOrderByStaffForEtc && (
        <Card.Grid hoverable={false} style={cardGridStyle}>
          {isOrderedByStaffForBadStock ? customerCardContentForOpenMall() : customerCardContent()}
        </Card.Grid>
      )}
      <Card.Grid hoverable={false} style={cardGridStyle}>
        {addressCardContent}
      </Card.Grid>
    </Card>
  );
};

export default OrderBrandStore;
</file>

