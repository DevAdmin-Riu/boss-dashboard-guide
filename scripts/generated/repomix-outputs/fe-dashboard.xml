      true,
      undefined,
      { noScroll: true }
    );
  };
  const open = (action: TAction, newParams?: TParams) => {
    if (newParams?.ids) {
      const cloneParams = _.cloneDeep(params);
      cloneParams.ids = undefined;
      navigate(
        url({
          ...cloneParams,
          action,
        }),
        true,
        false,
        { noScroll: true, ids: newParams.ids }
      );
    } else {
      navigate(
        url({
          ...params,
          ...newParams,
          action,
        }),
        true,
        undefined,
        { noScroll: true }
      );
    }
  };

  return [open, close];
}

export default createDialogActionHandlersForBulkAction;
</file>

<file path="src/global/core/utils/handlers/filterHandlers.ts">
import { useListQuerySkip } from "@hooks/useListQuerySkip";
import { UseNavigatorResult } from "@hooks/useNavigator";
import { IFilter } from "@src/app/components/Filter";
import { DEFAULT_INITIAL_PAGINATION_DATA } from "@src/global/assets/constants/config";
import { ActiveTab, Pagination, Search, Sort } from "@src/global/core/types/types";
import _ from "lodash";

import { GetFilterQueryParam, getFilterQueryParams } from "../filters";

type RequiredParams = ActiveTab & Search & Sort & Pagination;
type CreateUrl = (params: RequiredParams) => string;
type CreateFilterHandlers<TFilterKeys extends string> = [(filter: IFilter<TFilterKeys>) => void, () => void];

function createFilterHandlers<TFilterKeys extends string, TFilters extends object>(opts: {
  getFilterQueryParam: GetFilterQueryParam<TFilterKeys, TFilters>;
  navigate: UseNavigatorResult;
  createUrl: CreateUrl;
  params: RequiredParams;
  refreshFn?: () => void;
  cleanupFn?: () => void;
}): CreateFilterHandlers<TFilterKeys> {
  const { getFilterQueryParam, navigate, createUrl, params, refreshFn, cleanupFn } = opts;
  const historyReplace = true;
  const { setSkip: setListQuerySkip } = useListQuerySkip();

  const changeFilters = (filter: IFilter<TFilterKeys>) => {
    if (!!cleanupFn) {
      cleanupFn();
    }

    const filterQueryParams = getFilterQueryParams(filter, getFilterQueryParam);
    const filterChanged = Object.keys(filterQueryParams).some((key) => !_.isEqual(filterQueryParams[key], params[key]));

    if (!filterChanged && !!refreshFn) {
      refreshFn();
      setListQuerySkip({ updated: true, value: false });
    } else {
      const url = createUrl({
        ...params,
        ...filterQueryParams,
        activeTab: undefined,
        ...DEFAULT_INITIAL_PAGINATION_DATA,
      });
      navigate(url, historyReplace);
      setListQuerySkip({ value: false });
    }
  };

  const resetFilters = () => {
    if (!!cleanupFn) {
      cleanupFn();
    }

    const url = createUrl({});
    navigate(url, historyReplace);
  };

  return [changeFilters, resetFilters];
}

export default createFilterHandlers;
</file>

