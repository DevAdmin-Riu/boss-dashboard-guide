import NumberComponent from "@src/app/components/Number";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
// import { showNotificationSuccess } from "@utils/notification/wrapper";
// import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Descriptions, Divider, Modal, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

// import { useSalesB2bCloseMutation } from "../../api/mutations";
// import { salesListForB2bQuery } from "../../api/queries";
import { SalesListForB2b_sales_edges_node } from "../../api/types/SalesListForB2b";
import { makeB2bTotalAmount, makeB2bTotalAmountExcludeVat, makeB2bVatAmount } from "../HqB2bSettlementListPage/utils";

export const makeConfirmNodeForSalesTotal = (salesCloseDate: Moment, sales: SalesListForB2b_sales_edges_node[]) => {
  const totalAmountExcludeVat = sales.reduce((acc, cur) => {
    const totalAmountExcludeVatByB2bSales = makeB2bTotalAmountExcludeVat(cur);
    return acc + totalAmountExcludeVatByB2bSales;
  }, 0);
  const totalVat = sales.reduce((acc, cur) => {
    const vatAmountByPurchase = makeB2bVatAmount(
      cur.unitPrice,
      cur.quantity,
      cur.isTaxFree,
      cur.variant.priceDecimalPlaces,
      cur.b2bDeliveryFeeExcludeVat
    );
    return acc + vatAmountByPurchase;
  }, 0);
  const totalAmount = sales.reduce((acc, cur) => {
    const totalAmountByPurchase = makeB2bTotalAmount(
      cur.unitPrice,
      cur.quantity,
      cur.isTaxFree,
      cur.variant.priceDecimalPlaces,
      cur.b2bDeliveryFeeExcludeVat
    );
    return acc + totalAmountByPurchase;
  }, 0);

  return (
    <Space direction="vertical">
      <Typography.Title level={5}>정산월: {salesCloseDate?.format(onlyMonthFormat)}</Typography.Title>
      <Descriptions bordered size="small" column={1} title="정산 대상 정보">
        <Descriptions.Item label="공급가액" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalAmountExcludeVat} />
        </Descriptions.Item>
        <Descriptions.Item label="부가세" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalVat} />
        </Descriptions.Item>
        <Descriptions.Item label="총 합계" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalAmount} />
        </Descriptions.Item>
      </Descriptions>
    </Space>
  );
};

interface HqB2bSettlementBulkCloseModalProps {
  open: boolean;
  loading: boolean;
  sales: SalesListForB2b_sales_edges_node[];
  salesCloseDate: string | null;
  onCancel: (shouldReset: boolean) => void;
}

export const HqB2bSettlementBulkCloseModal: React.FC<HqB2bSettlementBulkCloseModalProps> = (props) => {
  const { open, loading, sales, salesCloseDate, onCancel } = props;
