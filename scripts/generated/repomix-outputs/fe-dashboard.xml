<file path="src/app/views/order/orders/components/UnfulfilledOrderLineListPage/UnfulfilledOrderLineListPage.tsx">
import { ApolloQueryResult, MutationFunction } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import {
  OrderLineBulkChangeTrackInventory,
  OrderLineBulkChangeTrackInventoryVariables,
} from "@src/app/views/order/orders/api/types/OrderLineBulkChangeTrackInventory";
import { getOrderLineTrackChangeTableSettings } from "@src/app/views/order/orders/components/OrderLineListPage/OrderLineListTableSettings";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, FormInstance, Row, Space, Table, Typography } from "antd";
import { useForm } from "antd/es/form/Form";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { FulfillOrder, FulfillOrderVariables } from "../../api/types/FulfillOrder";
import { FulfillOrderBulk, FulfillOrderBulkVariables } from "../../api/types/FulfillOrderBulk";
import {
  OrderLineListForFulfill,
  OrderLineListForFulfill_orderLines_edges_node,
  OrderLineListForFulfillVariables,
} from "../../api/types/OrderLineListForFulfill";
import { checkHasVendorTrackInventory } from "../OrderLineListPage/utils";
import { createFilterStructure, UnfulfilledOrderLineFilterKeys, UnfulfilledOrderLineListFilterOpts } from "./filters";
import { getUnfulfilledOrderLineTableSettings } from "./UnfulfilledOrderLineTableSettings";
import {
  getFormInitialValues,
  getPageTitle,
  isUnfulfillmentViewPickingOrder,
  isUnfulfillmentViewStock,
  isUnfulfillmentViewStockEtc,
  submitFulfillmentForm,
  UnfulfillmentViewTypeEnum,
} from "./utils";

export interface UnfulfilledOrderLineListPageProps
  extends PaginateListProps,
    FilterPageProps<UnfulfilledOrderLineFilterKeys, UnfulfilledOrderLineListFilterOpts> {
  unfulfillmentViewType: UnfulfillmentViewTypeEnum;
  orderLines: OrderLineListForFulfill_orderLines_edges_node[];
  onSubmit: MutationFunction<FulfillOrder, FulfillOrderVariables>;
  onSubmitBulk: MutationFunction<FulfillOrderBulk, FulfillOrderBulkVariables>;
  onSubmitChangeTrackInventory: MutationFunction<
    OrderLineBulkChangeTrackInventory,
    OrderLineBulkChangeTrackInventoryVariables
  >;
  onPickingOrderFulfill: () => void;

  queryVariablesWithoutPagination: OrderLineListForFulfillVariables;
  fetchForDownload: (
    variables?: OrderLineListForFulfillVariables
  ) => Promise<ApolloQueryResult<OrderLineListForFulfill>>;
}

function getRowSelectionProps(
  form: FormInstance<any>,
  setListElements: React.Dispatch<React.SetStateAction<any[]>>
): TableRowSelection<OrderLineListForFulfill_orderLines_edges_node> {
  return {
    fixed: true,
    selectedRowKeys: form.getFieldValue(["selectedRowKeys"]),
    onChange: (selectedRowKeys: React.Key[]) => {
      form.setFields([{ name: ["selectedRowKeys"], value: selectedRowKeys }]);
      setListElements(form.getFieldValue(["selectedRowKeys"]));
    },
    // 판매 제한 재고는 제외 코드 긴급 배포로 인하여 임시 주석
    // getCheckboxProps: (record: OrderLineListForFulfill_orderLines_edges_node) => ({
    //   disabled: getCheckboxDisabledProp(record) && record.decreaseStockFlag,
    // }),
  };
}

const UnfulfilledOrderLineListPage: React.FC<UnfulfilledOrderLineListPageProps> = (props) => {
  const {
    currentTab,
    filterOpts,
    tabs,
    unfulfillmentViewType,
    orderLines,
    onNextPage,
    onPreviousPage,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onPickingOrderFulfill,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const [visibleConfirmModal, setVisibleConfirmModal] = React.useState(false);
  const [visibleConfirmModalChangeInventory, setVisibleConfirmModalChangeInventory] = React.useState(false);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts, unfulfillmentViewType);

  const [form] = useForm();

  const formStaticValues = getFormInitialValues(orderLines);
  const [listElements, setListElements] = useState([]);

  const columns = getUnfulfilledOrderLineTableSettings(form, { ...props });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  useEffect(() => {
    form.setFieldsValue(formStaticValues);
  }, [orderLines]);

  const isViewStock = isUnfulfillmentViewStock(unfulfillmentViewType);
  const isViewStockEtc = isUnfulfillmentViewStockEtc(unfulfillmentViewType);
  const isViewPickOrder = isUnfulfillmentViewPickingOrder(unfulfillmentViewType);
  const pageTitle = getPageTitle(unfulfillmentViewType);
  const fulfillmentButtonText = isViewStock ? "일괄 출고" : "출고 처리";
  // 합포장 제품 출고대기인 경우, 페이지에 보이는 모든 로우가 피킹 대상으로 자동 선택됨. 이에 따라 footer 없이 모든 로우가 한 번에 보이도록(기본값 500으로 설정) 설정
  const showRowSelection = isViewPickOrder === false;
  const showTableFooter = isViewPickOrder === false;

  const handleClickFulfillmentButton = () => {
    if (isViewStock) {
      submitFulfillmentForm(form, props.onSubmit, props.onSubmitBulk, unfulfillmentViewType);
    } else {
      submitFulfillmentForm(form, props.onSubmit, props.onSubmitBulk, unfulfillmentViewType);
    }
  };

  const makeConfirmContentNode = (showFulfillmentType: boolean) => {
    // listElements은 id의 List임. orderLines에서 해당 id들의 리스트들을 뽑아낸다.
    const selectedOrderLines = orderLines.filter((orderLine) => listElements.includes(orderLine.id));
    const columnsForChangeInventory = getOrderLineTrackChangeTableSettings(showFulfillmentType);
    return (
      <>
        <Space direction="vertical" size="small">
          <Table columns={columnsForChangeInventory} dataSource={selectedOrderLines} pagination={false} rowKey="id" />
        </Space>
      </>
    );
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "orderLines",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
        <Col>
          <Space>
            {isViewPickOrder ? (
              <Button type="primary" shape="round" disabled={orderLines.length === 0} onClick={onPickingOrderFulfill}>
                합포장 피킹 진행
              </Button>
            ) : (
              <>
                <Button
                  type="primary"
                  shape="round"
                  disabled={listElements.length === 0}
                  onClick={() => setVisibleConfirmModalChangeInventory(true)}
                >
                  출고유형 일괄변경
                </Button>
                <Button
                  type="primary"
                  shape="round"
                  disabled={listElements.length === 0}
                  onClick={handleClickFulfillmentButton}
                >
                  {fulfillmentButtonText}
                </Button>
              </>
            )}
          </Space>
        </Col>
      </Row>
      <ConfirmModal
        visible={visibleConfirmModal}
        titleText="선택된 위탁 주문접수 요청 리스트에 발주 등록이 안된 것이 있습니다. 이대로 진행하시겠습니까?"
        helpText="위탁 주문접수 처리가 되면 위탁 발주 등록을 할 수 없습니다."
        onOk={() => {
          submitFulfillmentForm(form, props.onSubmit, props.onSubmitBulk, unfulfillmentViewType);
          setVisibleConfirmModal(false);
        }}
        onCancel={() => setVisibleConfirmModal(false)}
      />

      <ConfirmModal
        visible={visibleConfirmModalChangeInventory}
        modalTitleText="출고 유형 변경"
        titleText=""
        helpText={`아래의 주문상품들의 출고유형을 ${isViewStock ? "'재고'" : "'위탁'"}에서 ${
          isViewStock ? "'위탁'" : "'재고'"
        }로 변경하시겠습니까?`}
        width={800}
        contentNode={makeConfirmContentNode(isViewStock === false)}
        onOk={() => {
          const hasVendorTrackInventory = checkHasVendorTrackInventory(orderLines, listElements);
          if (hasVendorTrackInventory) {
            showNotificationError("위탁재고 제품은 출고 유형을 변경할 수 없습니다.");
            return;
          }
          props.onSubmitChangeTrackInventory({
            variables: {
              ids: listElements,
              input: {
                trackInventory: !(isViewStock || isViewStockEtc),
              },
            },
          });
          setVisibleConfirmModalChangeInventory(false);
        }}
        onCancel={() => setVisibleConfirmModalChangeInventory(false)}
      />

      <Form form={form} initialValues={formStaticValues}>
        <Form.Item shouldUpdate>
          {() => (
            <Card>
              <SpreadFilterBar
                currentTab={currentTab}
                onAll={onAll}
                onFilterChange={onFilterChange}
                onTabChange={onTabChange}
                onTabDelete={onTabDelete}
                onTabSave={onTabSave}
                tabs={tabs}
                filterStructure={filterStructure}
                isDownloadable={true}
                excelDownloadProps={excelDownloadProps}
                tabExtra={
                  <ColumnPicker
                    columns={pickColumns}
                    loading={listProps.disabled}
                    initialColumns={initialColumns}
                    total={pickColumns?.length}
                    onSave={handleSave}
                  />
                }
              />
              <Table
                {...commonTableProps}
                ref={tableRef}
                rowSelection={showRowSelection && getRowSelectionProps(form, setListElements)}
                loading={listProps.disabled}
                scroll={{ x: tableWidthSum, y: tableScrollY }}
                columns={pickerSelectedColumns}
                dataSource={orderLines}
                footer={() =>
                  showTableFooter && (
                    <TableListFooter
                      {...listProps}
                      onNextPage={() => {
                        onNextPage();
                        form.setFields([{ name: "selectedRowKeys", value: [] }]);
                      }}
                      onPreviousPage={() => {
                        onPreviousPage();
                        form.setFields([{ name: "selectedRowKeys", value: [] }]);
                      }}
                    />
                  )
                }
              />
            </Card>
          )}
        </Form.Item>
      </Form>
    </Space>
  );
};

export default UnfulfilledOrderLineListPage;
</file>

