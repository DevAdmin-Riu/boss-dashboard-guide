import { QuestionCircleOutlined } from "@ant-design/icons";
import { MutationFunction } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { HqStaffCreate, HqStaffCreateVariables } from "@src/app/views/brand/brands/api/types/HqStaffCreate";
import { brandHqStaffRoleChoices, brandHqStaffRoleChoicesWOAdmin } from "@src/app/views/brand/brandStore/utils";
import { maybe } from "@utils/misc";
import { Col, Form, Input, Modal, Radio, Row, Select, Tooltip } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect, useState } from "react";

interface BrandHqStaffCreateModalProps {
  open: boolean;
  onClose: () => void;
  brandId?: string;
  onCreate: MutationFunction<HqStaffCreate, HqStaffCreateVariables>;
}

const BrandHqStaffCreateModal: React.FC<BrandHqStaffCreateModalProps> = ({ open, onClose, brandId, onCreate }) => {
  const [form] = useForm();
  const TypeSafeForm = getTypeSafeForm<HqStaffCreateVariables>(form);
  const [useCustomPassword, setUseCustomPassword] = useState(false);

  const [searchedBrands, setSearchedBrands] = useState([]);

  const brandSearchVariable: SearchBrandsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.brandStoresForSeach,
    ids: brandId ? [brandId] : undefined,
  };

  const { loadMore, search, result } = useBrandSearch({
    skip: !!brandId,
    variables: brandSearchVariable,
  });

  const fetchMoreData = {
    hasMore: maybe(() => result.data.search.pageInfo.hasNextPage),
    loading: result.loading,
    onFetchMore: loadMore,
  };

  useEffect(() => {
    setSearchedBrands(
      result.data?.search?.edges.map((edge) => ({
        label: edge.node.name,
        value: edge.node.id,
      }))
    );
  }, [result?.data?.search?.edges]);

  const handleSubmit = async (values: HqStaffCreateVariables) => {
    const input = {
      ...values.input,
      password: useCustomPassword ? values.input.password : undefined,
    };

    const result = await onCreate({ variables: { input } });

    const errors = result?.data?.hqStaffCreate?.errors;
    if (errors?.length === 0) {
      onClose();
      form.resetFields();
      setUseCustomPassword(false);
    }
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
      setUseCustomPassword(false);
    }
  }, [open]);

  return (
    <Modal
      maskClosable={false}
      open={open}
      onCancel={onClose}
      onOk={() => form.submit()}
      okText="추가"
      cancelText="취소"
      title="사용자(가맹본부) 생성"
      destroyOnClose
    >
      <Form layout="vertical" form={form} onFinish={handleSubmit}>
        <Row gutter={16}>
          <Col span={24}>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("input.brand")}
              label="브랜드"
              rules={[{ required: true, message: "브랜드는 필수입니다." }]}
              initialValue={brandId}
              hidden={!!brandId}
            >
              <Select
                showSearch
                filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                onSearch={search}
                loading={fetchMoreData.loading}
                options={searchedBrands}
                onPopupScroll={fetchMoreData.onFetchMore}
              />
            </Form.Item>
          </Col>
        </Row>

        <Row gutter={16}>
          <Col span={12}>
            <Form.Item
              label="사용자 아이디"
              name={TypeSafeForm.getValidDataIndex("input.loginId")}
              rules={[{ required: true, message: "아이디는 필수입니다." }]}
            >
              <Input />
            </Form.Item>
          </Col>

          <Col span={12}>
            <div style={{ marginBottom: 8, display: "flex", alignItems: "center", gap: 8 }}>
              <span>비밀번호 직접 설정</span>
              <Tooltip title="직접 설정이 아닌 경우, 브랜드 코드로 자동 설정됩니다.">
                <QuestionCircleOutlined style={{ color: "#999" }} />
              </Tooltip>
            </div>
            <Radio.Group value={useCustomPassword} onChange={(e) => setUseCustomPassword(e.target.value)}>
              <Radio value={true}>네</Radio>
              <Radio value={false}>아니오</Radio>
            </Radio.Group>
          </Col>
        </Row>

        {useCustomPassword && (
          <Form.Item
            label="비밀번호"
            name={TypeSafeForm.getValidDataIndex("input.password")}
            rules={[{ required: true, message: "비밀번호는 필수입니다." }]}
          >
            <Input.Password autoComplete="new-password" />
          </Form.Item>
        )}

        <Form.Item
          label="사용자 이름"
          name={TypeSafeForm.getValidDataIndex("input.firstName")}
          rules={[{ required: true, message: "이름은 필수입니다." }]}
        >
          <Input />
        </Form.Item>

        <Form.Item
          label="권한"
          name={TypeSafeForm.getValidDataIndex("input.hqStaffRole")}
          rules={[{ required: true, message: "권한은 필수입니다." }]}
        >
          <Select options={!!brandId ? brandHqStaffRoleChoicesWOAdmin : brandHqStaffRoleChoices} />
        </Form.Item>

        <Form.Item
          label="연락처"
          name={TypeSafeForm.getValidDataIndex("input.aligoPhone")}
          rules={[{ required: true, message: "연락처는 필수입니다." }]}
        >
          <Input />
        </Form.Item>

        <Form.Item
          label="이메일"
          name={TypeSafeForm.getValidDataIndex("input.email")}
          rules={[{ type: "email", message: "이메일 형식이 아닙니다." }]}
        >
          <Input />
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default BrandHqStaffCreateModal;
</file>

