<file path="src/app/views/product/stock/components/MonthlyStockSnapshotsPage/filter.ts">
import { PriorityLevelEnum, SalesStatusEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

import { getSalesStatusChoices, priorityLevelChoices } from "../../../products/utils/data";

export enum MonthlyStockSnapshotsFilterKeys {
  statDate = "statDate",
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  trackInventory = "trackInventory",
  isInner = "isInner",
  salesStatus = "salesStatus",
  priorityLevel = "priorityLevel",
}

export interface MonthlyStockSnapshotsFilterOpts {
  statDate: FilterOpts<MinMax>;
  productSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  trackInventory: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  priorityLevel: FilterOpts<PriorityLevelEnum[]>;
}

export function createFilterStructure(opts: MonthlyStockSnapshotsFilterOpts): IFilter<MonthlyStockSnapshotsFilterKeys> {
  let displayOrder = 0;
  const statDateFilter = {
    ...createMonthField(displayOrder++, MonthlyStockSnapshotsFilterKeys.statDate, "기준 일자", opts.statDate.value),
    active: opts.statDate.active,
    isRequired: true,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      MonthlyStockSnapshotsFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      MonthlyStockSnapshotsFilterKeys.vendorSearch,
      "협력사코드 / 협력사명",
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };

  const trackInventoryFilter = {
    ...createBooleanField(
      displayOrder++,
      MonthlyStockSnapshotsFilterKeys.trackInventory,
      columnNameConstant.product.TRACK_INVENTORY,
      opts.trackInventory.value,
      {
        negative: "미운영",
        positive: "운영",
      }
    ),
    active: opts.trackInventory.active,
  };

  const isInnerFilter = {
    ...createBooleanField(displayOrder++, MonthlyStockSnapshotsFilterKeys.isInner, "제품형태", opts.isInner.value, {
      negative: "아우터박스",
      positive: "이너박스",
    }),
    active: opts.isInner.active,
  };

  const salesStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      MonthlyStockSnapshotsFilterKeys.salesStatus,
      "제품상태",
      opts.salesStatus.value,
      true,
      getSalesStatusChoices(false, false)
    ),
    active: opts.salesStatus.active,
    isRequired: true,
  };
  const priorityLevelFilter = {
    ...createOptionsField(
      displayOrder++,
      MonthlyStockSnapshotsFilterKeys.priorityLevel,
      "중요도",
      opts.priorityLevel.value,
      true,
      priorityLevelChoices
    ),
    active: opts.priorityLevel.active,
  };

  return [
    statDateFilter,
    salesStatusFilter,
    priorityLevelFilter,
    productSearchFilter,
    trackInventoryFilter,
    isInnerFilter,
    vendorSearchFilter,
  ];
}
</file>

