import useNavigator from "@hooks/useNavigator";
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import { Badge, Button, Col, notification, Row, Space } from "antd";
import React from "react";

import { FbvOrderDeliveryListViewUrlQueryParams, FbvOrderDeliveryUrlEnum, fbvOrderDeliveryUrlList } from "../../urls";

interface MileageSettlementListNavProps {
  urlType: UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>;
  setUrlType: React.Dispatch<
    React.SetStateAction<UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>>
  >;
  params: FbvOrderDeliveryListViewUrlQueryParams;
  countOfStatus: TCountOfStatus;
}

export type TCountOfStatus = {
  [key in FbvOrderDeliveryUrlEnum]: number;
};

// 각 urlType에 맞는 버튼에 들어갈 메뉴명을 return하는 함수 메뉴명은 함수내에서 하드코딩
export const getFbvOrderDeliveryNavButtonName = (urlEnum: FbvOrderDeliveryUrlEnum): string => {
  switch (urlEnum) {
    case FbvOrderDeliveryUrlEnum.UNFULFILLED:
      return "주문 접수";
    case FbvOrderDeliveryUrlEnum.FULFILLED:
      return "상품 배송";
    case FbvOrderDeliveryUrlEnum.TRACKING_A:
      return "배송중 (택배)";
    case FbvOrderDeliveryUrlEnum.COMPLETED_A:
      return "배송완료 (택배)";
    case FbvOrderDeliveryUrlEnum.TRACKING_B:
      return "배송중 (화물차)";
    case FbvOrderDeliveryUrlEnum.COMPLETED_B:
      return "배송완료 (화물차)";
    default:
      return "주문 접수";
  }
};

const SettlementListNav: React.FC<MileageSettlementListNavProps> = (props) => {
  const { urlType, setUrlType, params, countOfStatus } = props;
  const navigate = useNavigator();

  const onClick = (e) => {
    const target = e.currentTarget;
    const newUrlTypeEnum = target.dataset.key ? target.dataset.key : null;

    if (newUrlTypeEnum === urlType.urlEnum) {
      return;
    }

    const findUrlType = fbvOrderDeliveryUrlList.find((item) => item.urlEnum === newUrlTypeEnum);

    if (findUrlType === null) {
      notification.error({ message: "잘못된 접근입니다." });
      return false;
    }

    setUrlType(findUrlType);
    navigate(findUrlType.fnUrl(params));
  };

  return (
    <>
      <Space style={{ marginBottom: 20 }}>
        <Row>
          {fbvOrderDeliveryUrlList.map((item) => (
            <React.Fragment key={item.urlEnum}>
              <Col style={{ marginRight: 15 }}>
                <Button
                  style={{ padding: "8px 12px", height: "auto" }}
                  onClick={(e) => onClick(e)}
                  data-key={item.urlEnum}
                  type={item.urlEnum === urlType.urlEnum ? "primary" : "default"}
                >
                  {getFbvOrderDeliveryNavButtonName(item.urlEnum)}
                  {countOfStatus && (
                    <Badge style={{ marginLeft: 7 }} overflowCount={999} count={countOfStatus[item.urlEnum]}></Badge>
                  )}
                </Button>
              </Col>
            </React.Fragment>
          ))}
        </Row>
      </Space>
    </>
  );
};

export default SettlementListNav;
</file>

