  let purchaseOrderColumns: DownloadableEditableColumnsType<PurchaseOrderDetails_purchaseOrder_lines> = [
    {
      title: columnNameConstant.purchaseOrder.PO_AMOUNT,
      key: "quantity",
      align: "right",
      width: 80,
      render: (_, record) => makePoLineQtyText(poEventType, record),
      onCell: (record) => ({
        inputType: "number",
        formItemName: "quantity",
        editing: isEditing(record),
        disabled: isTakeBackType,
      }),
    },
    isInventoryType && {
      title: columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_AMOUNT,
      key: "expectedPurchaseQuantity",
