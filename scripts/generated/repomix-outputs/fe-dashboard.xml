  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const pageTitle = <Typography.Title level={4}>{sectionNames.brandGroupList}</Typography.Title>;
  const pageExtra = (
    <Space direction="horizontal">
      <Button type="primary" onClick={onCreate}>
        그룹 추가
      </Button>
      <Button danger type="primary" disabled={selectedRowKeys.length === 0} onClick={onBulkDelete}>
        그룹 삭제
      </Button>
    </Space>
  );

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "brandGroupList",
  };

  const rowSelection: TableRowSelection<BrandGroupList_brandGroupList_edges_node> = {
    fixed: "left",
    selectedRowKeys,
    onChange: onSelectedRowKeysChange,
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>{pageTitle}</Col>
        <Col>{pageExtra}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table<BrandGroupList_brandGroupList_edges_node>
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={brandGroupList}
          rowSelection={rowSelection}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
