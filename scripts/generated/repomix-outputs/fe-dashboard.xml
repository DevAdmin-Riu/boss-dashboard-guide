export const getAttrSlugLabel = (slug: string): string => {
  switch (slug) {
    case AttributeSlugEnum.boxSize:
      return "굿스플로 택배 사이즈 코드";
    default:
      return "관리용 명칭";
  }
};

export const getAttrNameLabel = (slug: string): string => {
  switch (slug) {
    case AttributeSlugEnum.boxSize:
      return "보스몰 택배 사이즈 타입명";
    default:
      return "브랜드몰에서 명칭";
  }
};

export const getAttrValueLabel = (slug: string, isHtml: boolean = false): string | React.ReactNode => {
  switch (slug) {
    case AttributeSlugEnum.boxSize:
      return isHtml ? (
        <Space direction="vertical" size={0}>
          <Typography>계약 택배 업체 기준 택배 단가</Typography>
          <Typography>(부가세 별도)</Typography>
        </Space>
      ) : (
        "계약 택배 업체 기준 택배 단가(부가세 별도)"
      );
    default:
      return null;
  }
};

export const getValueKeyFromAttrValues = (slug: string) => {
  switch (slug) {
    case AttributeSlugEnum.boxSize:
      return "delivery_fee";
    default:
      return null;
  }
};

const AttributeValues: React.FC<AttributeValuesProps> = ({
  attribute,
  disabled,
  onValueAdd,
  onValueDelete,
  onValueReorder,
  onValueUpdate,
}) => {
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [dataSource, setDataSource] = useState<AttributeDetailsFragment_values[]>([]);
  const deletableValueExist = dataSource.some((value) => value.canDelete === true);

  // NOTE: 속성의 slug는 현재 수정을 하지 않는 값이지만, 페이지 자체에선 수정이 가능한 상황이므로 추후 수정이 된다면 아래 조건도 수정 필요.
  const isBoxSize = attribute?.slug === AttributeSlugEnum.boxSize;
  const slugColTitle = getAttrSlugLabel(attribute?.slug);
  const nameColTitle = getAttrNameLabel(attribute?.slug);
  const valueColTitle = getAttrValueLabel(attribute?.slug, true);
  const valueKey = getValueKeyFromAttrValues(attribute?.slug);

  useEffect(() => {
    setDataSource(attribute?.values || []);
  }, [attribute]);

  const columns: ColumnsType<AttributeDetailsFragment_values> = [];
  columns.push({ key: "sort", align: "center", width: 40, render: () => <DragHandle /> });
  columns.push({
    title: slugColTitle,
    key: "slug",
    align: "center",
    width: 120,
    render: (_, record) => record.slug || "-",
  });
  columns.push({
    title: nameColTitle,
    key: "name",
    align: "center",
    width: 120,
    render: (_, record) => record.name || "-",
  });
  if (isBoxSize) {
    columns.push({
      title: valueColTitle,
      key: "value",
      align: "right",
      width: 120,
      render: (_, record) => {
        if (isBoxSize) {
          const value: number = record?.value[valueKey];
          return <NumberComponent value={value} includeCurrency />;
        }
        return "-";
      },
    });
  }
  columns.push({
    key: "action",
    align: "center",
    width: 80,
    render: (_, record) => (
      <Space>
        <Button size="large" type="link" icon={<EditFilled />} onClick={() => onValueUpdate(record.id)} />
        {record?.canDelete === true && (
          <Button size="large" type="link" icon={<DeleteFilled />} onClick={() => onValueDelete(record.id)} />
        )}
      </Space>
    ),
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Card
      title={<CardTitleAntd title={"값"} />}
      extra={
        <Button type="primary" onClick={onValueAdd}>
          값 추가
        </Button>
      }
      bodyStyle={{ padding: 0 }}
    >
      <Table
        {...commonTableProps}
        columns={columns}
        dataSource={dataSource}
        scroll={{ x: tableWidthSum }}
        rowSelection={
          deletableValueExist && {
            fixed: true,
            type: "checkbox",
            columnWidth: 40,
            selectedRowKeys: selectedRowIds,
            onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
            getCheckboxProps: (record) => ({ disabled: record?.canDelete === false }),
          }
        }
        components={{
          body: {
            wrapper: (draggableContainerProps: DraggableContainerProps) =>
              DraggableContainer({ ...draggableContainerProps, onSortEnd: onValueReorder }),
            row: (draggableBodyRowProps: DraggableBodyRowProps) =>
              DraggableBodyRow({ ...draggableBodyRowProps, disabled, dataSource }),
          },
        }}
      />
    </Card>
  );
};
export default AttributeValues;
</file>

