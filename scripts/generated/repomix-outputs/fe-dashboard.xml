<file path="src/app/views/brand/brandStore/components/BrandStoreListPage/filters.ts">
import { BrandStoreContractEnum, BrandStoreStatusEnum, BrandStoreTypeEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import {
  brandStoreContractChoices,
  brandStoreStatusChoices,
  brandStoreTypeChoices,
} from "@src/app/views/brand/brandStore/utils";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum BrandStoreListFilterKeys {
  brandId = "brandId",
  brandStoreSearch = "brandStoreSearch",
  brandSearch = "brandSearch",
  supervisorSearch = "supervisorSearch",
  type = "type",
  created = "created",
  regionInfo = "regionInfo",
  status = "status",
  contract = "contract",
  bizRegNo = "bizRegNo",
}

export interface BrandStoreListFilterOpts {
  brandId: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  supervisorSearch: FilterOpts<string>;
  type: FilterOpts<BrandStoreTypeEnum>;
  created: FilterOpts<MinMax>;
  regionInfo: FilterOpts<string[]>;
  status: FilterOpts<BrandStoreStatusEnum[]>;
  contract: FilterOpts<BrandStoreContractEnum[]>;
  bizRegNo: FilterOpts<string>;
}

export function createFilterStructure(
  opts: BrandStoreListFilterOpts,
  isHqStaff: boolean,
  shop: ShopInfo_shop
): IFilter<BrandStoreListFilterKeys> {
  let filterStructure = [];

  const regionInfos = shop?.regionsInfo || [];
  const regionInfosOptions = regionInfos.map((region) => ({
    label: region.name,
    value: region.id,
  }));

  const brandSearchFilter = {
    ...createTextField(0, BrandStoreListFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };

  const brandStoreSearchFilter = {
    ...createTextField(0, BrandStoreListFilterKeys.brandStoreSearch, "매장코드 / 매장명", opts.brandStoreSearch.value),
    active: opts.brandStoreSearch.active,
  };

  const regionInfoFilter = {
    ...createOptionsField(
      0,
      BrandStoreListFilterKeys.regionInfo,
      "지역",
      opts.regionInfo.value,
      true,
      regionInfosOptions
    ),
    active: opts.regionInfo.active,
  };

  const typeFilter = {
    ...createOptionsField(0, BrandStoreListFilterKeys.type, "유형", [opts.type.value], false, brandStoreTypeChoices),
  };

  const statusFilter = {
    ...createOptionsField(
      0,
      BrandStoreListFilterKeys.status,
      "상태",
      opts.status.value,
      false,
      brandStoreStatusChoices
    ),
    active: opts.status.active,
  };

  const contractFilter = {
    ...createOptionsField(
      0,
      BrandStoreListFilterKeys.contract,
      "계약상태",
      opts.contract.value,
      false,
      brandStoreContractChoices
    ),
    active: opts.contract.active,
  };

  const bizRegNoFilter = {
    ...createTextField(0, BrandStoreListFilterKeys.bizRegNo, "사업자번호", opts.bizRegNo.value),
    active: opts.bizRegNo.active,
  };

  const supervisorSearchFilter = {
    ...createTextField(0, BrandStoreListFilterKeys.supervisorSearch, "담당자", opts.supervisorSearch.value),
    active: opts.supervisorSearch.active,
  };
  const createdFilter = {
    ...createDateField(0, BrandStoreListFilterKeys.created, "등록일", opts.created.value),
    active: opts.created.active,
  };

  filterStructure = [
    !isHqStaff && brandSearchFilter,
    brandStoreSearchFilter,
    typeFilter,
    statusFilter,
    contractFilter,
    bizRegNoFilter,
    regionInfoFilter,
    supervisorSearchFilter,
    createdFilter,
  ].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
</file>

