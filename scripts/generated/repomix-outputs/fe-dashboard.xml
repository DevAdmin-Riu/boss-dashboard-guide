import { brandDetailsViewPath } from "@src/app/views/brand/brands/urls";
import { ActiveTab, BulkAction, Dialog, Pagination, TabActionDialog } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const reserveChangeSectionUrl = "/reserve-change";

export const reserveChangeListViewPath = reserveChangeSectionUrl;

export type ReserveChangeListViewUrlDialog = "cancel" | TabActionDialog;

export type ReserveChangeListViewUrlQueryParams = BulkAction &
  Dialog<ReserveChangeListViewUrlDialog> &
  Pagination &
  ActiveTab;

export const reserveChangeListViewUrl = (params?: ReserveChangeListViewUrlQueryParams): string => {
  if (params === undefined) {
    return reserveChangeListViewPath;
  } else {
    return urlJoin(reserveChangeListViewPath, "?" + stringifyQs(params));
  }
};

export const reserveChangeDetailsViewPath = (id: string) => urlJoin(reserveChangeSectionUrl, id);

export const reserveChangeDetailsViewUrl = (id: string, params?: ReserveChangeListViewUrlQueryParams) =>
  brandDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);
