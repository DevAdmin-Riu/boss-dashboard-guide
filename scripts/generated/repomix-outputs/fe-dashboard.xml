import ConfirmModal from "@src/app/components/ConfirmModal";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import {
  brandGroupListQuery,
  useBrandGroupListFilterDownloadQuery,
  useBrandGroupListQuery,
} from "@src/app/views/brand/brands/api/queries";
import { ListViews } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useMemo, useState } from "react";

import { useBrandGroupBulkDeleteMutation, useBrandGroupDeleteMutation } from "../../api/mutations";
import { BrandGroupListVariables } from "../../api/types/BrandGroupList";
import { BrandGroupCreateOrUpdateModal } from "../../components/BrandGroupCreateOrUpdateModal";
import { BrandGroupListPage } from "../../components/BrandGroupListPage/BrandGroupListPage";
import { brandGroupListViewUrl, BrandGroupListViewUrlDialog, BrandGroupListViewUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

enum BrandGroupListModalModeEnum {
  Create = "Create",
  Update = "Update",
  Delete = "Delete",
  BulkDelete = "BulkDelete",
}

interface BrandGroupListViewProps {
  params: BrandGroupListViewUrlQueryParams;
}

export const BrandGroupListView: React.FC<BrandGroupListViewProps> = ({ params }) => {
  const [modalMode, setModalMode] = useState<BrandGroupListModalModeEnum>(null);
  const [idForModal, setIdForModal] = useState<string>(null);
  const [selectedRowKeys, setSelectedRowKeys] = useState<string[]>([]);

  const openModalWithoutNavigate = (mode: BrandGroupListModalModeEnum, id?: string) => {
    setModalMode(mode);
    setIdForModal(id);
  };
  const closeModalWithoutNavigate = () => {
    setModalMode(null);
    setIdForModal(null);
  };

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BRAND_GROUP_LIST,
  });
  const targetUrl = brandGroupListViewUrl;
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBrandGroupListFilterDownloadQuery);

  const queryVariables = useMemo<BrandGroupListVariables>(
    () => ({ ...paginationState, filter: getFilterVariables(params) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useBrandGroupListQuery({ variables: queryVariables });
  const brandGroupList = maybe(() => data.brandGroupList.edges.map((edge) => edge.node), []);
  const selectedBrandGroup = brandGroupList.find((bg) => bg.id === idForModal);

  const [brandGroupDelete, brandGroupDeleteOpts] = useBrandGroupDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandGroupDelete.errors, "브랜드 그룹이 삭제되었습니다.", () => {
        closeModalWithoutNavigate();
      }),
    refetchQueries: [brandGroupListQuery],
  });
  const [brandGroupBulkDelete, brandGroupBulkDeleteOpts] = useBrandGroupBulkDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.brandGroupBulkDelete.errors,
        "선택된 브랜드 그룹이 일괄 삭제되었습니다.",
        () => {
          setSelectedRowKeys([]);
          closeModalWithoutNavigate();
        }
      ),
    refetchQueries: [brandGroupListQuery],
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brandGroupList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<BrandGroupListViewUrlDialog, BrandGroupListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const pageLoading = loading;

  return (
    <>
      <BrandGroupListPage
        brandGroupList={brandGroupList}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        settings={settings}
        disabled={pageLoading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        selectedRowKeys={selectedRowKeys}
        onSelectedRowKeysChange={(newRowKeys) => setSelectedRowKeys(newRowKeys)}
        onCreate={() => openModalWithoutNavigate(BrandGroupListModalModeEnum.Create)}
        onUpdate={(id) => openModalWithoutNavigate(BrandGroupListModalModeEnum.Update, id)}
        onDelete={(id) => openModalWithoutNavigate(BrandGroupListModalModeEnum.Delete, id)}
        onBulkDelete={() => openModalWithoutNavigate(BrandGroupListModalModeEnum.BulkDelete)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
      <BrandGroupCreateOrUpdateModal
        isCreate
        open={modalMode === BrandGroupListModalModeEnum.Create}
        onClose={closeModalWithoutNavigate}
      />
      <BrandGroupCreateOrUpdateModal
        isCreate={false}
        open={modalMode === BrandGroupListModalModeEnum.Update}
        brandGroup={selectedBrandGroup}
        onClose={closeModalWithoutNavigate}
      />
      <ConfirmModal
        visible={modalMode === BrandGroupListModalModeEnum.Delete}
        modalTitleText="브랜드 그룹 삭제"
        titleText={`브랜드 그룹(${selectedBrandGroup?.name})을 삭제하시겠습니까?`}
        okText="삭제"
        okButtonProps={{ danger: true, loading: brandGroupDeleteOpts.loading }}
        onOk={() => brandGroupDelete({ variables: { id: idForModal } })}
        onCancel={closeModalWithoutNavigate}
      />
      <ConfirmModal
        visible={modalMode === BrandGroupListModalModeEnum.BulkDelete}
        modalTitleText="브랜드 그룹 일괄 삭제"
        titleText="선택한 브랜드 그룹을 일괄 삭제하시겠습니까?"
        okText="일괄 삭제"
        okButtonProps={{ danger: true, loading: brandGroupBulkDeleteOpts.loading }}
        onOk={() => brandGroupBulkDelete({ variables: { ids: selectedRowKeys } })}
        onCancel={closeModalWithoutNavigate}
      />
    </>
  );
};
</file>

