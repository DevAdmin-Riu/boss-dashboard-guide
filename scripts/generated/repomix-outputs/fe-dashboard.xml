  switch (contractType) {
    case BrandContractTypeEnum.MILEAGE:
      contractTypeAlertMsg = mileageTypeAlertMsg;
      isReverseFee = false;
      break;
    case BrandContractTypeEnum.FEE:
      contractTypeAlertMsg = feeTypeAlertMsg;
      isReverseFee = false;
