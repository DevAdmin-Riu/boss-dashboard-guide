  ];

  columns = columns.filter(Boolean);
  return columns;
}

export function getFulfilledByVendorSettlementListTableSummary(
  tableData: readonly BrandFbvSettlements_brandFbvSettlements_edges_node[],
  urlTypeEnum: AdminMonthlySettlementUrlEnum,
  createPickSummaryColumns: (keyValue: Record<string, string>, startIndex: number) => React.ReactNode[]
) {
  let brandCostPriceExcludeVatSum = 0;
  let brandCostPriceVatSum = 0;
  let brandCostPriceIncludeVatSum = 0;
  let brandPayingChargeIncludeVatSum = 0;
  let totalBrandPayingChargeSum = 0;

  tableData.forEach(({ brandCostPriceExcludeVat, brandCostPriceIncludeVat, brandPayingChargeIncludeVat }) => {
    brandCostPriceExcludeVatSum += brandCostPriceExcludeVat || 0;
    brandCostPriceVatSum += (brandCostPriceIncludeVat || 0) - (brandCostPriceExcludeVat || 0);
    brandCostPriceIncludeVatSum += brandCostPriceIncludeVat || 0;
    brandPayingChargeIncludeVatSum += brandPayingChargeIncludeVat || 0;
    totalBrandPayingChargeSum += (brandCostPriceIncludeVat || 0) - (brandPayingChargeIncludeVat || 0);
  });

  const keyValue = {
    statBrandCostPriceExcludeVatOnlyFbv: getNumberFormat(brandCostPriceExcludeVatSum),
    statBrandCostPriceVatOnlyFbv: getNumberFormat(brandCostPriceVatSum),
    statBrandCostPriceIncludeVatOnlyFbv: getNumberFormat(brandCostPriceIncludeVatSum),
    statBrandPayingChargeIncludeVatOnlyFbv: getNumberFormat(brandPayingChargeIncludeVatSum),
    totalStatBrandPayingChargeOnlyFbv: getNumberFormat(totalBrandPayingChargeSum),
  };

  const indexAdjust = [
    AdminMonthlySettlementUrlEnum.NOT_CONFIRMED,
    AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT,
  ].includes(urlTypeEnum)
    ? 1
    : 0;

  const index = 0 + indexAdjust;

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        {[AdminMonthlySettlementUrlEnum.NOT_CONFIRMED, AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT].includes(
          urlTypeEnum
        ) && (
          <Table.Summary.Cell index={0} align="center">
            <Text strong></Text>
          </Table.Summary.Cell>
        )}
        {createPickSummaryColumns(keyValue, index)}
      </Table.Summary.Row>
    </Table.Summary>
  );
}
