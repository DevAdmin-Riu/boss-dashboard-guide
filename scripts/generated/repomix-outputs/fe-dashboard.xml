import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useBrandListFilterDownloadQuery, useBrandListQuery } from "../../api/queries";
import { BrandsVariables } from "../../api/types/Brands";
import { BrandListPage } from "../../components/BrandListPage/BrandListPage";
import {
  brandCreateViewUrl,
  brandDetailsViewUrl,
  BrandListViewUrlDialog,
  BrandListViewUrlQueryParams,
  brandProductListViewUrl,
  brandsListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface BrandListViewProps {
  defaultParams: BrandListViewUrlQueryParams;
  params: BrandListViewUrlQueryParams;
}

export const BrandListView: React.FC<BrandListViewProps> = ({ defaultParams, params }) => {
  const shop = useShop();
  const targetUrl = brandsListViewUrl;

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BRAND_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBrandListFilterDownloadQuery);

  const queryVariables: BrandsVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBrandListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brands?.pageInfo,
    paginationState,
    params,
  });

  // NOTE: Filter Tab과 Modal Tab을 사용하기 위한 설정
  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<BrandListViewUrlDialog, BrandListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  return (
    <>
      <BrandListPage
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        numberOfBrands={data?.numberOfBrands}
        brands={maybe(() => data.brands.edges.map((edge) => edge.node))}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onAdd={() => navigate(brandCreateViewUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(brandDetailsViewUrl(id))}
        onBrandProductListView={(id) => navigate(brandProductListViewUrl({ brandId: id, productType: "boss" }))}
        onSort={handleSort}
        sort={getSortParams(params)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/views/BrandListView/filters.ts">
import {
  BrandContractStatusEnum,
  BrandContractTypeEnum,
  BrandFilterInput,
  BrandServiceTypeEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

import { BrandFilterKeys, BrandListFilterOpts } from "../../components/BrandListPage/filters";
import {
  BrandListViewUrlFilters,
  BrandListViewUrlFiltersEnum,
  BrandListViewUrlFiltersWithMultipleValuesEnum,
  BrandListViewUrlQueryParams,
} from "../../urls";

export const BRAND_FILTERS_KEY = "brandFilters";

export function getFilterOpts(params: BrandListViewUrlFilters): BrandListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    contractType: {
      active: maybe(() => !utils.isEmpty(filterVariables.contractType), false),
      value: maybe(() => dedupeFilter(filterVariables.contractType), []),
    },
    contractStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.contractStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.contractStatus), []),
    },
    enabledServices: {
      active: maybe(() => !utils.isEmpty(filterVariables.enabledServices), false),
      value: maybe(() => dedupeFilter(filterVariables.enabledServices), []),
    },
    isRunning: {
      active: maybe(() => !utils.isEmpty(filterVariables.isRunning), false),
      value: maybe(() => filterVariables.isRunning, false),
    },
    isContractWarning: {
      active: maybe(() => !utils.isEmpty(filterVariables.isContractWarning), false),
      value: maybe(() => filterVariables.isContractWarning, false),
    },
    isDirectShipping: {
      active: maybe(() => !utils.isEmpty(filterVariables.isDirectShipping), false),
      value: maybe(() => filterVariables.isDirectShipping, false),
    },
    isBossMarketUse: {
      active: maybe(() => !utils.isEmpty(filterVariables.isBossMarketUse), false),
      value: maybe(() => filterVariables.isBossMarketUse, false),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    bizRegSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.bizRegSearch, true), false),
      value: maybe(() => filterVariables.bizRegSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch, true), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
  };
}

export function getFilterVariables(params: BrandListViewUrlFilters): BrandFilterInput {
  return {
    contractType: maybe(() => params.contractType.map((status) => findInEnum(status, BrandContractTypeEnum))) || [],
    contractStatus:
      maybe(() => params.contractStatus.map((status) => findInEnum(status, BrandContractStatusEnum))) || [],
    enabledServices:
      maybe(() => params.enabledServices.map((service) => findInEnum(service, BrandServiceTypeEnum))) || [],
    isRunning: params.isRunning !== undefined ? parseBoolean(params.isRunning, false) : undefined,
    isContractWarning:
      params.isContractWarning !== undefined ? parseBoolean(params.isContractWarning, false) : undefined,
    isDirectShipping: params.isDirectShipping !== undefined ? parseBoolean(params.isDirectShipping, false) : undefined,
    isBossMarketUse: params.isBossMarketUse !== undefined ? parseBoolean(params.isBossMarketUse, false) : undefined,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    bizRegSearch: params.bizRegSearch !== undefined ? params.bizRegSearch : null,
    mdSearch: params.mdSearch !== undefined ? params.mdSearch : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<BrandFilterKeys>): BrandListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandFilterKeys.contractType:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandListViewUrlFiltersWithMultipleValuesEnum.contractType,
        BrandContractTypeEnum
      );
    case BrandFilterKeys.contractStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandListViewUrlFiltersWithMultipleValuesEnum.contractStatus,
        BrandContractStatusEnum
      );
    case BrandFilterKeys.enabledServices:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandListViewUrlFiltersWithMultipleValuesEnum.enabledServices,
        BrandServiceTypeEnum
      );
    case BrandFilterKeys.isRunning:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.isRunning);
    case BrandFilterKeys.isContractWarning:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.isContractWarning);
    case BrandFilterKeys.isDirectShipping:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.isDirectShipping);
    case BrandFilterKeys.isBossMarketUse:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.isBossMarketUse);
    case BrandFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.brandSearch);
    case BrandFilterKeys.bizRegSearch:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.bizRegSearch);
    case BrandFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, BrandListViewUrlFiltersEnum.mdSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandListViewUrlFilters>(BRAND_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BrandListViewUrlQueryParams,
  BrandListViewUrlFilters
>({ ...BrandListViewUrlFiltersEnum, ...BrandListViewUrlFiltersWithMultipleValuesEnum });
</file>

<file path="src/app/views/brand/brands/views/BrandListView/sort.ts">
import { BrandSortField } from "@src/api/types/globalTypes";
import { BrandListViewUrlSortField } from "@src/app/views/brand/brands/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: BrandListViewUrlSortField): BrandSortField {
  switch (sort) {
    case BrandListViewUrlSortField.email:
      return BrandSortField.EMAIL;
    case BrandListViewUrlSortField.name:
      return BrandSortField.NAME;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
</file>

<file path="src/app/views/brand/brands/views/BrandProductListView/BrandProductListView.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useProductSearch from "@src/api/searches/useProductSearch";
import {
  BrandProductVariantBulkCreateDetail,
  BrandProductVariantBulkUpdateDetail,
  BrandProductVariantManageEventInput,
} from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { ListViews } from "@src/global/core/types/types";
import {
  checkIsEnableForB2bServiceByBrand,
  getStringOrPlaceholder,
  maybe,
  parseBoolean,
  transformIsFBV,
} from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useEffect, useMemo, useState } from "react";
import { useParams } from "react-router";
import AssignBrandProductWithInfoDialog from "src/app/components/AssignBrandProductWithInfoDialog";

import {
  useAssignBrandProductWithInfoMutation,
  useBpBundleCreateMutation,
  useBpBundleDeleteMutation,
  useBrandProductPackageCreateMutation,
  useBrandProductPackageDeleteMutation,
  useBrandProductReorderMutation,
  useBrandProductVariantBulkCreateMutation,
  useBrandProductVariantBulkUpdateMutation,
} from "../../api/mutations";
import {
  brandProductListWithCategoryQuery,
  useBpBundlesQuery,
  useBrandForBpvListQuery,
  useBrandProductListQuery,
  useBrandProductListWithCategoryQuery,
  useBrandProductListWithOnlyNonStoppedVariantsQuery,
  useBrandProductPackagesQuery,
} from "../../api/queries";
import { BpBundles_bpBundles_edges_node, BpBundlesVariables } from "../../api/types/BpBundles";
import { BrandProductListVariables } from "../../api/types/BrandProductList";
import { BrandProductListWithOnlyNonStoppedVariantsVariables } from "../../api/types/BrandProductListWithOnlyNonStoppedVariants";
import { BrandProductPackagesVariables } from "../../api/types/BrandProductPackages";
import { BrandProductVariantBulkCreate_brandProductVariantBulkCreate_errors } from "../../api/types/BrandProductVariantBulkCreate";
import { BrandProductVariantBulkUpdate_brandProductVariantBulkUpdate_errors } from "../../api/types/BrandProductVariantBulkUpdate";
import BrandBundleCreateModal from "../../components/BrandBundleCreateModal";
import BrandBundleDeleteModal from "../../components/BrandBundleDeleteModal";
import BrandBundleUpdateModal from "../../components/BrandBundleUpdateModal";
import BrandPackageCreateModal from "../../components/BrandPackageCreateModal";
import BrandPackageDeleteModal from "../../components/BrandPackageDeleteModal";
import BrandPackageUpdateModal from "../../components/BrandPackageUpdateModal";
import { BrandProductListPage } from "../../components/BrandProductListPage/BrandProductListPage";
import { BrandProductReorderModal } from "../../components/BrandProductReorderModal";
import { BrandProductVariantBulkUpdateOrCreateModal } from "../../components/BrandProductVariantBulkUpdateOrCreateModal";
import {
  brandDetailsViewUrl,
  BrandProductListViewRouteParams,
  brandProductListViewUrl,
  BrandProductListViewUrlDialog,
  BrandProductListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  getPackageFilterVariables,
  saveFilterTab,
} from "./filters";
import { BrandProductAndBrandProductPackageType } from "./types";

enum BrandProductModalModeEnum {
  Assign = "Assign",
  BrandPackageCreate = "BrandPackageCreate",
  BrandPackageUpdate = "BrandPackageUpdate",
  BrandPackageDelete = "BrandPackageDelete",
  BrandBundleCreate = "BrandBundleCreate",
  BrandBundleUpdate = "BrandBundleUpdate",
  BrandBundleDelete = "BrandBundleDelete",
  Reorder = "Reorder",
  BulkCreate = "BulkCreate",
  BulkUpdate = "BulkUpdate",
}

interface BrandProductListViewProps {
  defaultParams: BrandProductListViewUrlQueryParams;
  params: BrandProductListViewUrlQueryParams;
}

export const BrandProductListView: React.FC<BrandProductListViewProps> = ({ defaultParams, params }) => {
  const includeStoppedBpv = parseBoolean(params.includeStoppedBpv, false);
  const routeParams = useParams<BrandProductListViewRouteParams>();
  const brandId = decodeURIComponent(routeParams.brandId);
  const [modalMode, setModalMode] = useState<BrandProductModalModeEnum>(null);
  const [selectedRowId, setSelectedRowId] = useState<string>("");
  const [dataSource, setDataSource] = useState<BrandProductAndBrandProductPackageType[]>([]);
  const [packageDataSource, setPackageDataSource] = useState([]);
  const [bundleDataSource, setBundleDataSource] = useState<BpBundles_bpBundles_edges_node[]>([]);
  const [assignedProductVariantIdList, setAssignedProductVariantIdList] = useState([]);

  const resetForCloseModal = () => setModalMode(null);
  const openModalWithoutNavigate = (modalMode: BrandProductModalModeEnum) => setModalMode(modalMode);

  // productTypeFilter가 FBV일 때만 true
  const productTypeFilter = routeParams.productType;
  const isFulfilledByVendor = productTypeFilter === "fbv";
  const isPackage = productTypeFilter === "package";
  const isBundle = productTypeFilter === "bundle";

  const handleBack = () => navigate(brandDetailsViewUrl(brandId));

  const { data: brandDataForBpvList } = useBrandForBpvListQuery({ variables: { id: brandId } });
  const brandForBpvList = brandDataForBpvList?.brand;
  const enableForB2bService = checkIsEnableForB2bServiceByBrand(brandForBpvList);
  const targetUrl = (params?: BrandProductListViewUrlQueryParams) => brandProductListViewUrl(routeParams, params);
  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: isPackage ? ListViews.BRAND_PRODUCT_PACKAGE_LIST : ListViews.BRAND_PRODUCT_LIST,
  });

  const bpFilterVariables = getFilterVariables(params);
  const bpQueryVariables: BrandProductListVariables | BrandProductListWithOnlyNonStoppedVariantsVariables = useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { ...bpFilterVariables, brand: brandId, isFulfilledByVendor },
    }),
    [bpFilterVariables, brandId, isFulfilledByVendor]
  );

  const bpPackageFilterVariables = getPackageFilterVariables(params);
  const bpPackageQueryVariables: BrandProductPackagesVariables = useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { ...bpPackageFilterVariables, brand: brandId },
    }),
    [bpPackageFilterVariables, brandId]
  );

  const bpBundleQueryVariables: BpBundlesVariables = useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { brand: brandId },
    }),
    [brandId]
  );

  // BOSS 또는 FBV 타입 상품 데이터 조회
  const targetQuery = includeStoppedBpv ? useBrandProductListQuery : useBrandProductListWithOnlyNonStoppedVariantsQuery;
  const {
    data: brandProductData,
    loading,
    refetch: refetchBrandProducts,
  } = targetQuery({
    skip: isPackage || isBundle,
    variables: bpQueryVariables,
  });

  // 패키지 타입 데이터 조회
  const {
    data: brandProductPackageData,
    loading: packageLoading,
    refetch: refetchBrandProductPackages,
  } = useBrandProductPackagesQuery({
    skip: !isPackage,
    variables: bpPackageQueryVariables,
  });

  // 세트 상품 데이터 조회
  const {
    data: bpBundleData,
    loading: bundleLoading,
    refetch: refetchBpBundles,
  } = useBpBundlesQuery({
    skip: !isBundle,
    variables: bpBundleQueryVariables,
  });

  const { data: brandProductListWithCategoryData, loading: brandProductListWithCategoryLoading } =
    useBrandProductListWithCategoryQuery({
      skip: modalMode !== BrandProductModalModeEnum.Reorder,
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.default,
        filter: { ...bpQueryVariables.filter, isFulfilledByVendor: undefined, isBeingDisplayed: true },
      },
      useBatching: false,
    });
  const brandProductListWithCategory = maybe(
    () => brandProductListWithCategoryData.brandProducts.edges.map((edge) => edge.node),
    []
  );

  const { search, loadMore, result } = useProductSearch({
    skip: modalMode !== BrandProductModalModeEnum.Assign,
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, isFulfilledByVendor, isB2b: enableForB2bService ? undefined : false },
  });

  const refetchDataSource = async () => {
    if (isPackage) {
      await refetchBrandProductPackages();
    } else if (isBundle) {
      await refetchBpBundles();
    } else {
      await refetchBrandProducts();
    }
  };

  const [brandProductPackageCreate, brandProductPackageCreateOpts] = useBrandProductPackageCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandProductPackageCreate.errors, "패키지 상품을 추가했습니다.", () => {
        refetchDataSource();
      }),
  });

  const [brandProductPackageDelete] = useBrandProductPackageDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandProductPackageDelete.errors, "패키지 상품을 삭제했습니다.", () => {
        refetchDataSource();
      }),
  });

  const [bpBundleCreate, bpBundleCreateOpts] = useBpBundleCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bpBundleCreate.errors, "세트 상품을 추가했습니다.", () => {
        refetchDataSource();
      }),
  });

  const [bpBundleDelete] = useBpBundleDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bpBundleDelete.errors, "세트 상품을 삭제했습니다.", () => {
        refetchDataSource();
      }),
  });

  const [assignBrandProductWithInfo, assignBrandProductWithInfoOpts] = useAssignBrandProductWithInfoMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandAddProductWithInfo.errors, "상품을 추가했습니다.", () => {
        refetchDataSource();
      }),
  });

  const [reorderBrandProducts, reorderBrandProductsOpts] = useBrandProductReorderMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandProductReorder?.errors, "상품의 진열순서가 변경되었습니다.", () => {
        // https://github.com/DevAdmin-Riu/saleor-dashboard/commit/e9d3a3cf6860403af499783a460e498ba9e45951 참고
        // refetchDataSource();
      }),
    refetchQueries: [brandProductListWithCategoryQuery],
  });

  const [brandProductVariantBulkCreate, brandProductVariantBulkCreateOpts] = useBrandProductVariantBulkCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.brandProductVariantBulkCreate?.errors,
        "상품 일괄 등록이 완료되었습니다.",
        () => {
          refetchDataSource();
        }
      ),
  });

  const [brandProductVariantBulkUpdate, brandProductVariantBulkUpdateOpts] = useBrandProductVariantBulkUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.brandProductVariantBulkUpdate?.errors,
        "상품 일괄 수정이 완료되었습니다.",
        () => {
          refetchDataSource();
        }
      ),
  });

  const onBulkUpdateOrCreate = async (
    details: Array<BrandProductVariantBulkCreateDetail | BrandProductVariantBulkUpdateDetail | null>,
    manageEvent?: BrandProductVariantManageEventInput
  ) => {
    let errors:
      | BrandProductVariantBulkCreate_brandProductVariantBulkCreate_errors[]
      | BrandProductVariantBulkUpdate_brandProductVariantBulkUpdate_errors[] = [];
    if (modalMode === BrandProductModalModeEnum.BulkCreate) {
      const { data } = await brandProductVariantBulkCreate({
        variables: {
          input: { brand: brandId, details: details as BrandProductVariantBulkCreateDetail[], isFulfilledByVendor },
        },
      });
      errors = data?.brandProductVariantBulkCreate?.errors || [];
    } else {
      const { data } = await brandProductVariantBulkUpdate({
        variables: {
          input: {
            brand: brandId,
            details: details as BrandProductVariantBulkUpdateDetail[],
            manageEvent,
            isFulfilledByVendor,
          },
        },
      });
      errors = data?.brandProductVariantBulkUpdate?.errors || [];
    }
    return errors;
  };

  // 브랜드 상품 데이터를 dataSource에 설정
  useEffect(() => {
    if (!isPackage && brandProductData) {
      const brandProductList = maybe(() => brandProductData.brandProducts.edges.map((edge) => edge.node), []);
      setAssignedProductVariantIdList(
        brandProductList.reduce(
          (acc, bp) => acc.concat(bp.brandProductVariants.map((bpv) => bpv.productVariant.id)),
          []
        )
      );
      setDataSource(brandProductList);
    }
  }, [brandProductData, isPackage]);

  // 패키지 데이터를 packageDataSource에 설정
  useEffect(() => {
    if (isPackage && brandProductPackageData) {
      const brandProductPackageList = maybe(
        () => brandProductPackageData.brandProductPackages.edges.map((edge) => edge.node),
        []
      );
      setPackageDataSource(brandProductPackageList);
    }
  }, [brandProductPackageData, isPackage]);

  // 세트 상품 데이터를 bundleDataSource에 설정
  useEffect(() => {
    if (isBundle && bpBundleData) {
      const bpBundleList = maybe(() => bpBundleData.bpBundles.edges.map((edge) => edge.node), []);
      setBundleDataSource(bpBundleList);
    }
  }, [bpBundleData, isBundle]);

  // BOSS와 FBV는 동일한 데이터 사용
  const filteredDataSource = dataSource;

  // NOTE: Filter Tab과 Modal Tab을 사용하기 위한 설정
  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<BrandProductListViewUrlDialog, BrandProductListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch: refetchDataSource,
  });

  const loadingAny =
    loading ||
    packageLoading ||
    bundleLoading ||
    reorderBrandProductsOpts.loading ||
    brandProductListWithCategoryLoading ||
    brandProductVariantBulkCreateOpts.loading ||
    brandProductVariantBulkUpdateOpts.loading ||
    reorderBrandProductsOpts.loading;

  return (
    <>
      <WindowTitle title="상품 리스트" />
      <BrandProductListPage
        brand={brandForBpvList}
        enableForB2bService={enableForB2bService}
        brandProducts={filteredDataSource}
        brandPackages={packageDataSource}
        brandBundles={bundleDataSource}
        loading={loadingAny}
        disabled={loadingAny}
        isFulfilledByVendor={isFulfilledByVendor}
        onProductAssign={() => openModalWithoutNavigate(BrandProductModalModeEnum.Assign)}
        onProductPackageCreate={() => openModalWithoutNavigate(BrandProductModalModeEnum.BrandPackageCreate)}
