import useHqStaffSearch from "@src/api/searches/useHqStaffSearch";
import { HqStaffBrandStoreRole, HqStaffBrandStoreRoleTypeEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { brandHqStaffRoleChoices, hqStaffBrandStoreRoleChoices } from "@src/app/views/brand/brandStore/utils";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Select, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { useHqStaffSupervisorAssignMutation, useHqStaffSupervisorUnassignMutation } from "../api/mutations";
import {
  BrandStoreDetails_brandStore,
  BrandStoreDetails_brandStore_hqStaffBrandStores,
} from "../api/types/BrandStoreDetails";

interface BrandStoreSalesInfoProps {
  brandStore: BrandStoreDetails_brandStore;
  onClickAccount: (brandStoreId: string) => void;
}

export const HqStaffBrandStores: React.FC<BrandStoreSalesInfoProps> = (props) => {
  const { brandStore, onClickAccount } = props;
  const [searchedHqStaffs, setSearchedHqStaffs] = useState([]);
  const [selectedUserId, setSelectedUserId] = useState<string | null>(null);

  const {
    loadMore: hqStaffsLoadMore,
    result: hqStaffs,
    search: searchHqStaffs,
  } = useHqStaffSearch({
    variables: {
      first: 5,
      brand: brandStore.brand.id,
    },
  });
  const fetchMoreDataForHqStaffs = {
    hasMore: maybe(() => hqStaffs.data.search.pageInfo.hasNextPage),
    loading: hqStaffs.loading,
    onFetchMore: hqStaffsLoadMore,
  };

  useEffect(() => {
    const assignedUserIds = brandStore?.hqStaffBrandStores?.map((s) => s.user.id) ?? [];
    setSearchedHqStaffs(
      hqStaffs.data?.search?.edges
        .filter((edge) => !assignedUserIds.includes(edge.node.id))
        .map((edge) => ({
          label: `${edge.node.firstName}(${edge.node.loginId})`,
          value: edge.node.id,
        }))
    );
  }, [hqStaffs?.data?.search?.edges, brandStore?.hqStaffBrandStores]);

  const [hqStaffSupervisorAssign, hqStaffSupervisorAssignOpts] = useHqStaffSupervisorAssignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.assignHqStaffSupervisor.errors, "담당자가 수정되었습니다.", () => {
        setSelectedUserId(null);
      }),
  });

  const [hqStaffSupervisorUnassign, hqStaffSupervisorUnassignOpts] = useHqStaffSupervisorUnassignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.unassignHqStaffSupervisor.errors, "담당자가 해제되었습니다."),
  });

  const mutationLoading = hqStaffSupervisorAssignOpts.loading || hqStaffSupervisorUnassignOpts.loading;

  const handleAssign = async (userId: string, role: HqStaffBrandStoreRoleTypeEnum) => {
    await hqStaffSupervisorAssign({ variables: { input: { brandStore: brandStore.id, user: userId, role } } });
  };

  const handleUnassign = async (id: string) => {
    await hqStaffSupervisorUnassign({ variables: { id } });
  };

  const columns: ColumnsType<BrandStoreDetails_brandStore_hqStaffBrandStores> = [
    {
      title: "구분",
      key: "role",
      align: "center",
      width: 100,
      render: (_, record) => utils.getLabelTextByValue(record.role, hqStaffBrandStoreRoleChoices),
    },
    {
      title: "이름",
      key: "name",
      align: "left",
      width: 100,
      render: (_, record) => (
        <Typography.Link onClick={() => onClickAccount(record.user.id)}>{record.user.firstName}</Typography.Link>
      ),
    },
    {
      title: "권한",
      key: "hqStaffRole",
      align: "center",
      width: 120,
      render: (_, record) => utils.getLabelTextByValue(record.user.hqStaffRole, brandHqStaffRoleChoices) || "-",
    },
    {
      key: "actions",
      width: 120,
      align: "center",
      render: (_, record) => (
        <Space direction="vertical" size="small">
          <Button danger loading={mutationLoading} onClick={() => handleUnassign(record.id)}>
            담당해제
          </Button>
          {record.role !== HqStaffBrandStoreRole.MAIN && (
            <Button
              loading={mutationLoading}
              onClick={() => handleAssign(record.user.id, HqStaffBrandStoreRoleTypeEnum.MAIN)}
            >
              주 담당자로 설정
            </Button>
          )}
        </Space>
      ),
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const cardExtra = (
    <Space>
      <Select
        style={{ width: 180 }}
        showSearch
        placeholder="담당자 검색"
        value={selectedUserId}
        onChange={(value) => setSelectedUserId(value)}
        filterOption={(input, option) => option?.label?.toLowerCase().includes(input.toLowerCase())}
        onSearch={searchHqStaffs}
        loading={fetchMoreDataForHqStaffs.loading}
        options={searchedHqStaffs}
        onPopupScroll={fetchMoreDataForHqStaffs.onFetchMore}
      />
      <Button
        type="primary"
        loading={mutationLoading}
        disabled={!selectedUserId}
        onClick={() => handleAssign(selectedUserId, HqStaffBrandStoreRoleTypeEnum.SUB)}
      >
        추가
      </Button>
    </Space>
  );

  return (
    <Card title={<CardTitleAntd title={"담당자"} />} bodyStyle={{ padding: 0 }} extra={cardExtra}>
      <Table<BrandStoreDetails_brandStore_hqStaffBrandStores>
        {...commonTableProps}
        columns={columns}
        dataSource={brandStore.hqStaffBrandStores}
        scroll={{ x: tableWidthSum }}
      />
    </Card>
  );
};
</file>

