export const getPOLineInspectListTableSettings = (): ColumnsType<PoLineInspectList_poLineInspectList_edges_node> => {
  const columns: ColumnsType<PoLineInspectList_poLineInspectList_edges_node> = [
    {
      title: columnNameConstant.purchaseOrder.INSPECT_NO,
      key: "code",
      width: 120,
      align: "center",
      render: (_, record) => record.code || "-",
    },
    {
      title: columnNameConstant.purchaseOrder.STOCKED_DATE,
      key: "createdAt",
      width: 160,
      align: "center",
      render: (_, record) => getDateByFormat(record.createdAt),
    },
    {
      title: columnNameConstant.product.SKU,
      key: "productSku",
      width: 120,
      align: "center",
      render: (_, record) => record.purchaseOrderLine?.productSku || "-",
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      width: 200,
      render: (_, record) => record.purchaseOrderLine?.productName || "-",
    },
    {
      title: columnNameConstant.vendor.CODE,
      key: "vendorCode",
      width: 100,
      align: "center",
      render: (_, record) => record.purchaseOrderLine?.purchaseOrder?.vendor?.code || "-",
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendorName",
      width: 150,
      render: (_, record) => record.purchaseOrderLine?.purchaseOrder?.vendor?.name || "-",
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECTOR,
      key: "inspector",
      width: 100,
      align: "center",
      render: (_, record) => {
        const user = record.user;
        if (!user) {
          return "-";
        }
        return user.firstName || user.id;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_RESULT_LABEL,
      key: "result",
      width: 100,
      align: "center",
      render: (_, record) => {
        const result = record.result;
        if (!result) {
          return "-";
        }

        switch (result) {
          case PurchaseOrderLineInspectResultEnum.PASS:
            return <Tag color="success">합격</Tag>;
          case PurchaseOrderLineInspectResultEnum.FAIL:
            return <Tag color="error">불합격</Tag>;
          default:
            return result;
