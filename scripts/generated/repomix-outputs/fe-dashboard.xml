import makeQuery from "@hooks/makeQuery";
import {
  collectionDetailsFragment,
  collectionFragment,
  collectionProductFragment,
} from "@src/api/fragments/collections";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import gql from "graphql-tag";

import { CollectionDetails, CollectionDetailsVariables } from "./types/CollectionDetails";
import { CollectionList, CollectionListVariables } from "./types/CollectionList";

export const collectionListQuery = gql`
  ${collectionFragment}
  ${pageInfoFragment}
  query CollectionList(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: CollectionFilterInput
    $sort: CollectionSortingInput
  ) {
    collections(first: $first, after: $after, before: $before, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...CollectionFragment
          products {
            totalCount
          }
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const useCollectionListQuery = makeQuery<CollectionList, CollectionListVariables>(collectionListQuery);

export const collectionDetailsQuery = gql`
  ${collectionDetailsFragment}
  ${collectionProductFragment}
  ${pageInfoFragment}
  query CollectionDetails($id: ID!, $first: Int, $after: String, $last: Int, $before: String) {
    collection(id: $id) {
      ...CollectionDetailsFragment
      products(first: $first, after: $after, before: $before, last: $last) {
        edges {
          node {
            ...CollectionProductFragment
          }
        }
        pageInfo {
          ...PageInfoFragment
        }
      }
    }
    shop {
      homepageCollection {
        id
      }
    }
  }
`;
export const useCollectionDetailsQuery = makeQuery<CollectionDetails, CollectionDetailsVariables>(
  collectionDetailsQuery
);
