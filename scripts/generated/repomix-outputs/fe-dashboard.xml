    <FormSaveButton
      form={form}
      isEditMode={props.editModeProps.isEditMode}
      onEdit={props.editModeProps.onEdit}
      onCancel={props.editModeProps.onCancel}
    />
  );

  const parentExist = isUpdate && !!props.category?.parent;

  return (
    <Card title={cardTitle} extra={cardExtra}>
      <Row gutter={[12, 8]}>
        <Col xs={24} sm={12}>
          <EditableField
            type="input"
            name={TypeSafeForm.getValidDataIndex("name")}
            label="카테고리명"
