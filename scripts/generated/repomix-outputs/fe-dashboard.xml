<file path="src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/HqMileageSettlementListPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import {
  BrandMileageMonthlySettlementUpdateInput,
  BrandMonthlySettlementStatusEnum,
  DateRangeInput,
  StatReportingMode,
} from "@src/api/types/globalTypes";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import {
  handleClickExcelDownloadForHq,
  overwriteStatForHq,
} from "@src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/utils";
import { Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq } from "@src/app/views/hqMileageSettlement/utils";
import { useBrandsOrderStatsForMileageLazyQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { useBrandMileageMonthlySettlementUpdateMutation } from "@src/app/views/mileageSettlement/api/mutations";
import { useBrandMileageMonthlySettlementListLazyQuery } from "@src/app/views/mileageSettlement/api/queries";
import { FilterPageProps } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Descriptions, Row, Space, Typography } from "antd";
import React, { useEffect, useRef, useState } from "react";

import { HqMileageSettlementListViewUrlQueryParams } from "../../urls";
import {
  createFilterStructure,
  HqMileageSettlementFilterKeys,
  HqMileageSettlementListFilterOpts,
  HqMonthlySettlementTypeEnum,
} from "./filters";
import {
  getMileageSettlementListTableSettings,
  getMileageSettlementListTableSummary,
} from "./HqMileageSettlementListTableSettings";

export interface HqMileageSettlementListFilterVariables {
  statDate: DateRangeInput;
  settlementStatus: BrandMonthlySettlementStatusEnum[];
}

interface HqMileageSettlementListPageProps
  extends FilterPageProps<HqMileageSettlementFilterKeys, HqMileageSettlementListFilterOpts> {
  params: HqMileageSettlementListViewUrlQueryParams;
  filterVariables: HqMileageSettlementListFilterVariables;
}

export const HqMileageSettlementListPage: React.FC<HqMileageSettlementListPageProps> = (props) => {
  const {
    params,
    filterVariables,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const [dataSource, setDataSource] = useState<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[]>([]);
  const [updateDataId, setUpdateDataId] = useState<string>(null);
  const [openConfirmModal, setOpenConfirmModal] = useState<boolean>(false);
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [selectedFileName, setSelectedFileName] = useState<string>("");
  const [selectedFileContent, setSelectedFileContent] = useState<File>(null);
  const taxInvoiceImageAnchor = useRef<HTMLInputElement>();

  const { user } = useUser();
  const settlementAccountInfo = user?.brand?.settlementAccountInfo;

  const [brandsOrderStatsListFetch, { loading: orderStatListLoading }] = useBrandsOrderStatsForMileageLazyQuery();
  const [brandMileageMonthlySettlementListFetch, { loading: settlementListLoading }] =
    useBrandMileageMonthlySettlementListLazyQuery();
  const tableLoading = orderStatListLoading || settlementListLoading;

  const [settlementUpdate, updateMutationOpts] = useBrandMileageMonthlySettlementUpdateMutation({
    onCompleted: (data) => {
      if (data.brandMileageMonthlySettlementUpdate.errors.length > 0) {
        showNotificationError(data.brandMileageMonthlySettlementUpdate.errors[0].message);
      } else {
        showNotificationSuccess("본부수익금이 신청되었습니다.");
        setOpenConfirmModal(false);
        setUpdateDataId(null);
        refetchDataSource();
      }
    },
  });

  const refetchDataSource = async () => {
    const { statDate, settlementStatus } = filterVariables;
    const { settlementStatus: settlementStatusParam } = params;

    // 가맹본부의 본부수익금 정산에서는 본인 brand의 값만 조회한다.
    const brandIdList = [user.brand.id];
    const brandsStatsListPromise = brandsOrderStatsListFetch({
      variables: {
        ids: brandIdList,
        filter: { mode: StatReportingMode.MONTHLY, statDate, isFulfilledByVendor: false },
      },
    });

    const brandsStatsConfirmedListPromise = brandMileageMonthlySettlementListFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.brands,
        filter: {
          brands: brandIdList,
          date: statDate,
          settlementStatus,
        },
      },
    });

    const [brandsStatsList, brandsStatsConfirmedList] = await Promise.all([
      brandsStatsListPromise,
      brandsStatsConfirmedListPromise,
    ]);

    let brandsOrderStats: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[] =
      brandsStatsList.data.brandsOrderStats.map((brandStats) => ({
        ...brandStats,
        settlementId: null,
        settlementStatus: null,
        rejectReason: null,
        decreaseDevCostIncludeVat: null,
      }));

    // 아래 로직은 "전체"로 선택된 경우의 로직임. 또는 값이 없는 경우.
    if (settlementStatusParam === HqMonthlySettlementTypeEnum.ALL || !settlementStatusParam) {
      brandsOrderStats = brandsOrderStats.map((brandStats) => {
        const confirmedDataEdge = brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.find(
          (edge) => edge.node.brand.id === brandStats.brandGlobalId && edge.node.date === brandStats.statDate
        );
        const confirmedDataNode = confirmedDataEdge?.node;
        brandStats = overwriteStatForHq(brandStats, confirmedDataNode);
        return brandStats;
      });
    } else if (settlementStatusParam === HqMonthlySettlementTypeEnum.NOT_CONFIRMED) {
      // NOT_CONFIRMED인 경우 confirmData가 존재하는 경우 아예 제외해야한다.
      brandsOrderStats = brandsOrderStats.filter((brandStats) => {
        const confirmedDataEdge = brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.find(
          (edge) => edge.node.brand.id === brandStats.brandGlobalId && edge.node.date === brandStats.statDate
        );
        return !confirmedDataEdge;
      });
      // settlementStatusParam 가 HqMonthlySettlementTypeEnum.CONFIRMED 또는 REVIEWING_BY_ADMIN, PAID 인 경우
    } else if (
      [
        HqMonthlySettlementTypeEnum.CONFIRMED,
        HqMonthlySettlementTypeEnum.REVIEWING_BY_ADMIN,
        HqMonthlySettlementTypeEnum.PAID,
      ].includes(settlementStatusParam as HqMonthlySettlementTypeEnum)
    ) {
      // CONFIRMED인 경우 confirmData가 존재하며 동시에 settlementStatus가 CONFIRMED 경우만 필터링하고, 값은 덮어써야한다.
      brandsOrderStats = brandsOrderStats.map((brandStats) => {
        const confirmedDataEdge = brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.find(
          (edge) => edge.node.brand.id === brandStats.brandGlobalId && edge.node.date === brandStats.statDate
        );
        const confirmedDataNode = confirmedDataEdge?.node;
        if (confirmedDataNode?.settlementStatus === settlementStatusParam) {
          brandStats = overwriteStatForHq(brandStats, confirmedDataNode);
          return brandStats;
        }
        // settlementStatusParam가 REVIEWING_BY_ADMIN인 경우 confirmedDataNode?.settlementStatus가 WAITING_FOR_PAYMENT 인 경우도 포함한다.
        else if (
          settlementStatusParam === HqMonthlySettlementTypeEnum.REVIEWING_BY_ADMIN &&
          confirmedDataNode?.settlementStatus === BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT
        ) {
          brandStats = overwriteStatForHq(brandStats, confirmedDataNode);
          return brandStats;
        } else {
          return null;
        }
      });
    }
    // null인거 제외한 리스트로 다시 구성한다.
    brandsOrderStats = brandsOrderStats.filter((brandStats) => brandStats);
    setDataSource(brandsOrderStats);
  };

  useEffect(() => {
    refetchDataSource();
  }, [params]);

  const loading = tableLoading || updateMutationOpts.loading;

  const columns = getMileageSettlementListTableSettings(
    StatReportingMode.MONTHLY,
    setUpdateDataId,
    setOpenConfirmModal,
    loading
  );
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const readUploadFile = (e) => {
    e.preventDefault();
    if (e.target.files) {
      setSelectedFileName(e.target.files[0].name);
      setSelectedFileContent(e.target.files[0]);
    }
    if (taxInvoiceImageAnchor.current) {
      taxInvoiceImageAnchor.current.value = "";
    }
    setFormChanged(true);
  };

  const onSubmit = () => {
    // onBizInfoUpdate(formData, selectedFileContent);
    const updateInput: BrandMileageMonthlySettlementUpdateInput = {
      settlementStatus: BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN,
      taxInvoiceImageByHqStaff: selectedFileContent,
    };
    settlementUpdate({
      variables: {
        id: updateDataId,
        input: updateInput,
      },
    });

    setOpenConfirmModal(false);
  };

  const handleUploadButtonClick = () => taxInvoiceImageAnchor.current.click();
  const makeConfirmContentNode = () => (
    <>
      <Space direction="vertical" size="small">
        <Descriptions
          bordered
          size="small"
          labelStyle={{
            width: "100px",
            wordBreak: "keep-all",
            verticalAlign: "middle",
            whiteSpace: "nowrap",
          }}
          column={3}
        >
          <Descriptions.Item span={3} label={"은행명"}>
            {settlementAccountInfo?.bankName}
          </Descriptions.Item>
          <Descriptions.Item span={3} label={"계좌번호"}>
            {settlementAccountInfo?.accountNo}
          </Descriptions.Item>
          <Descriptions.Item span={3} label={"예금주"}>
            {settlementAccountInfo?.accountOwnerName}
          </Descriptions.Item>
        </Descriptions>
      </Space>

      <Row gutter={[8, 16]}>
        <Col span={24}>
          <Space direction="vertical">
            <Space direction="horizontal">
              <Typography.Text>세금계산서 사본</Typography.Text>
              <Button onClick={handleUploadButtonClick} type="primary">
                업로드
              </Button>
            </Space>
          </Space>
        </Col>
        <Col span={24}>
          <Typography.Text type={"danger"} strong>
            pdf 또는 이미지 파일(jpg, png 등)을 업로드 해주세요.
          </Typography.Text>
        </Col>
        <Col span={24}>
          {selectedFileName && <Typography.Text type="success">선택된 파일명: {selectedFileName}</Typography.Text>}
        </Col>
      </Row>
    </>
  );

  const makeExtraExcelDownloadUi = () => (
    <Button
      type="primary"
      shape="round"
      icon={<DownloadOutlined />}
      loading={loading}
      onClick={() => handleClickExcelDownloadForHq(dataSource, user?.brand?.name)}
      disabled={dataSource.length === 0}
    >
      엑셀 다운로드
    </Button>
  );

  const okButtonProps = {
    disabled: loading || !formChanged,
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.requestMileage}</Typography.Title>
          </Col>
          <Col>{makeExtraExcelDownloadUi()}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq>
            {...commonTableProps}
            loading={tableLoading}
            rowKey={(record) => `${record.brandId}:${record.statDate}`}
            columns={columns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum }}
            summary={(tableData) => getMileageSettlementListTableSummary(tableData)}
          />
          <ConfirmModal
            titleText="본부수익금 지급 검토 요청"
            helpText="계좌정보를 확인해주시고, 세금계산서 사본을 업로드해주세요."
            visible={openConfirmModal}
            contentNode={makeConfirmContentNode()}
            okButtonProps={okButtonProps}
            onOk={() => {
              onSubmit();
            }}
            onCancel={() => setOpenConfirmModal(false)}
          />
          <Space size={0} direction={"vertical"}>
            <input
              hidden={true}
              id="fileUpload"
              style={{ display: "none" }}
              onChange={(event) => readUploadFile(event)}
              type="file"
              ref={taxInvoiceImageAnchor}
              accept="image/*,application/pdf"
            />
          </Space>
        </Card>
      </Space>
    </>
  );
};
</file>

<file path="src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/HqMileageSettlementListTableSettings.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import { BrandMonthlySettlementStatusEnum, StatReportingMode } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq } from "@src/app/views/hqMileageSettlement/utils";
import { renderStatDate } from "@src/app/views/mileageSettlement/components/MileageSettlementListPage/utils";
import { calcVatByPriceExcludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Button, Typography } from "antd";
import Table, { ColumnsType, ColumnType } from "antd/lib/table";
import React from "react";

const { Text } = Typography;

const calceStatMileageIncludeVat = (record: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq) =>
  record.statMileageExcludeVat + calcVatByPriceExcludeVat(record.statMileageExcludeVat);

export function getMileageSettlementListTableSettings(
  dateType: StatReportingMode,
  setUpdateDataId: React.Dispatch<React.SetStateAction<string>>,
  setOpenConfirmModal: React.Dispatch<React.SetStateAction<boolean>>,
  loading: boolean
) {
  const orderColumnsChildren: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [];
  const fixedFlag = utils.checkMobile() === false;

  // 매출 = amount + point + rcoins
  orderColumnsChildren.push({
    title: "매출",
    align: "right",
    key: "statTotalPriceExcludeVat",
    width: 120,
    render: (_, record) => <NumberComponent value={record.statTotalPriceExcludeVat} />,
  });
  // 가맹본부 판매현황에는 "사용 적립금" 은 별도로 표시 하지 않음
  orderColumnsChildren.push({
    title: columnNameConstant.order.USED_RCOINS,
    align: "right",
    key: "statRcoinsExcludeVat",
    width: 120,
    render: (_, record) => <NumberComponent value={record.statRcoinsExcludeVat} />,
  });
  orderColumnsChildren.push({
    title: "매입",
    align: "right",
    key: "statBrandCostPriceExcludeVat",
    width: 120,
    render: (_, record) => <NumberComponent value={record.statBrandCostPriceExcludeVat} />,
  });
  orderColumnsChildren.push({
    title: "반품배송비",
    align: "right",
    key: "statReturnDeliveryFeeExcludeVat",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.statReturnDeliveryFee)} />,
  });
  orderColumnsChildren.push({
    title: "배송비",
    align: "right",
    key: "statBrandDeliveryFeeExcludeVat",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.statBrandDeliveryFee)} />,
  });
  orderColumnsChildren.push({
    title: columnNameConstant.performance.PG_PAYING_CHARGE,
    align: "right",
    key: "statBrandPayingChargeExcludeVat",
    width: 120,
    // 결제 수수료는 부가세 별도로 db 에 저장됨
    render: (_, record) => <NumberComponent value={record.statBrandPayingChargeExcludeVat} />,
  });

  const statMileageColumns: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [
    {
      title: <Typography.Text style={{ fontSize: 10 }}>공급가액</Typography.Text>,
      align: "right",
      key: "statMileageExcludeVat",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent value={record.statMileageExcludeVat} />
        </Typography.Text>
      ),
    },
    {
      title: <Typography.Text style={{ fontSize: 10 }}>세액</Typography.Text>,
      align: "right",
      key: "statMileageVat",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent value={calcVatByPriceExcludeVat(record.statMileageExcludeVat)} />
        </Typography.Text>
      ),
    },
    {
      title: columnNameConstant.mileageSettlement.mileageForHq,
      align: "right",
      key: "statMileageIncludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={calceStatMileageIncludeVat(record)} />,
    },
  ];
  const decreaseDevCostColumns: ColumnType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = {
    title: [
      ...columnNameConstant.mileageSettlement.devCostForHq.slice(0, -1),
      commonMsg.includeVat,
      ...columnNameConstant.mileageSettlement.devCostForHq.slice(-1),
    ],
    key: "statDecreaseDevCostIncludeVat",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.decreaseDevCostIncludeVat} />,
  };
  const confirmedMileageColumns: ColumnType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = {
    title: [
      columnNameConstant.mileageSettlement.confirmedMileage.slice(0, -1),
      commonMsg.includeVat,
      ...columnNameConstant.mileageSettlement.confirmedMileage.slice(-1),
    ],
    key: "statConfirmedMileageIncludeVat",
    align: "right",
    width: 120,
    render: (_, record) => (
      <NumberComponent value={calceStatMileageIncludeVat(record) - record.decreaseDevCostIncludeVat} />
    ),
  };

  const statusColumn: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [];
  statusColumn.push({
    title: "상태",
    align: "center",
    key: "settlementStatus",
    width: 120,
    render: (_, record) => {
      switch (record.settlementStatus) {
        case BrandMonthlySettlementStatusEnum.CONFIRMED:
          return (
            <>
              <Text type="success">확정</Text>
              <br />
              <Button
                type="primary"
                shape="round"
                loading={loading}
                onClick={() => {
                  setUpdateDataId(record.settlementId);
                  setOpenConfirmModal(true);
                }}
              >
                신청하기
              </Button>
            </>
          );
        case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
        case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
          return <Text type="success">신청완료</Text>;
        case BrandMonthlySettlementStatusEnum.PAID:
          return <Text type="success">지급완료</Text>;
        default:
          return <Text type="warning">미확정</Text>;
      }
    },
  });
  statusColumn.push({
    title: "반려사유",
    align: "center",
    key: "rejectReason",
    width: 120,
    render: (_, record) => {
      // settlementStatus 가 confirmed인 경우에만 반려사유를 노출하고 다른 경우에는 노출하지않는다.
      if (record.settlementStatus === BrandMonthlySettlementStatusEnum.CONFIRMED) {
        return <Text type="danger">{record.rejectReason}</Text>;
      } else {
        return <Text>-</Text>;
      }
    },
  });

  const columns: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [
    {
      title: "구분",
      align: "center",
      key: "statDate",
      fixed: fixedFlag,
      width: 120,
      render: (_, record) => renderStatDate(record.statDate, dateType),
    },
    { title: <Typography.Title level={5}>전체 주문</Typography.Title>, children: orderColumnsChildren },
    { title: <Typography.Title level={5}>본부수익금</Typography.Title>, children: statMileageColumns },
    decreaseDevCostColumns,
    confirmedMileageColumns,
    { title: <Typography.Title level={5}>현황</Typography.Title>, children: statusColumn },
  ];

  return columns;
}

export function getMileageSettlementListTableSummary(
  tableData: readonly Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[]
) {
  let statTotalPriceExcludeVatSum = 0;
  let statRcoinsExcludeVatSum = 0;
  let statReturnDeliveryFeeExcludeVatSum = 0;
  let statMileageIncludeVatSum = 0;
  let statBrandCostPriceExcludeVatSum = 0;
  let statBrandDeliveryFeeExcludeVatSum = 0;
  let statBrandPayingChargeExcludeVatSum = 0;
  let statMileageExcludeVatSum = 0;
  let statMileageVatSum = 0;
  let statDecreaseDevCostIncludeVatSum = 0;

  tableData.forEach((record) => {
    const {
      statTotalPriceExcludeVat,
      statRcoinsExcludeVat,
      statReturnDeliveryFee,
      statMileageExcludeVat,
      statBrandCostPriceExcludeVat,
      statBrandDeliveryFee,
      statBrandPayingChargeExcludeVat,
      decreaseDevCostIncludeVat,
    } = record;
    statTotalPriceExcludeVatSum += statTotalPriceExcludeVat || 0;
    statRcoinsExcludeVatSum += statRcoinsExcludeVat || 0;
    statReturnDeliveryFeeExcludeVatSum += toPriceExcludeVat(statReturnDeliveryFee) || 0;
    statBrandCostPriceExcludeVatSum += statBrandCostPriceExcludeVat || 0;
    statBrandDeliveryFeeExcludeVatSum += toPriceExcludeVat(statBrandDeliveryFee) || 0;
    statBrandPayingChargeExcludeVatSum += statBrandPayingChargeExcludeVat || 0;
    statMileageExcludeVatSum += statMileageExcludeVat || 0;
    statMileageVatSum += calcVatByPriceExcludeVat(statMileageExcludeVat) || 0;
    statMileageIncludeVatSum += calceStatMileageIncludeVat(record) || 0;
    statDecreaseDevCostIncludeVatSum += decreaseDevCostIncludeVat || 0;
  });

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center">
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={statTotalPriceExcludeVatSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={2} align="right">
          <Text strong>
            <NumberComponent value={statRcoinsExcludeVatSum} />
          </Text>
