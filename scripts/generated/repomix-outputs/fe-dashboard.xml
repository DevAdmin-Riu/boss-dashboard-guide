<file path="src/app/views/question/components/RefundQuestionListNav/RefundQuestionListNav.tsx">
import useNavigator from "@hooks/useNavigator";
import { utils } from "@utils/utils";
import { Badge, Button, Col, Divider, Row, Space, Tag } from "antd";
import React from "react";
import { useParams } from "react-router";

import { CustomerQuestionGetCount } from "../../api/types/CustomerQuestionGetCount";
import {
  bossRefundQuestionUrlListForNavButton,
  fbvRefundQuestionUrlListForNavButton,
  RefundQaSatatusTypeForRouteParams,
  RefundQuestionListViewRouteParams,
  refundQuestionListViewUrl,
} from "../../urls";
import { getRefundQuestionListPageTitle } from "../../utils";

interface RefundQuestionListNavProps {
  countData: CustomerQuestionGetCount;
}

const getCountByStatus = (status: RefundQaSatatusTypeForRouteParams, data: CustomerQuestionGetCount) => {
  if (utils.isEmpty(data)) {
    return;
  }

  const customerCount = data.customerQuestionGetCount;

  switch (status) {
    case "requested":
      return customerCount.requestedCount;
    case "accepted":
      return customerCount.acceptedCount;
    case "collected-inspect":
      return customerCount.collectedInspectCount;
    case "change-pending":
      return customerCount.changePendingCount;
    case "change-success":
      return customerCount.changeSuccessCount;
    case "refund-pending":
      return customerCount.refundPendingCount;
    case "refund-success":
      return customerCount.refundSuccessCount;
    case "stock-included-requested":
      return customerCount.stockIncludedRequestedCount;
    case "reject":
      return customerCount.rejectCount;
  }
};

const RefundQuestionListNav: React.FC<RefundQuestionListNavProps> = (props) => {
  const { countData } = props;
  const { fulfilledBy, status: currentStatus } = useParams<RefundQuestionListViewRouteParams>();
  const navigate = useNavigator();

  const targetUrlListForNavButton =
    fulfilledBy === "vendor" ? fbvRefundQuestionUrlListForNavButton : bossRefundQuestionUrlListForNavButton;

  const onClick = (newStatus: RefundQaSatatusTypeForRouteParams) => {
    const url = refundQuestionListViewUrl({ fulfilledBy, status: newStatus });
    navigate(url);
  };

  return (
    <>
      <Space style={{ marginBottom: 20 }}>
        <Row>
          {targetUrlListForNavButton.map((item) => (
            <React.Fragment key={item.status}>
              <Col style={{ marginRight: 15 }}>
                <Button
                  style={{ padding: "8px 12px", height: "auto" }}
                  onClick={(e) => onClick(item.status)}
                  type={item.status === currentStatus ? "primary" : "default"}
                >
                  {getRefundQuestionListPageTitle(item)}

                  {item.status === "stock-included-requested" && (
                    <Tag style={{ marginLeft: 4 }} color="cyan">
                      물류
                    </Tag>
                  )}
                  {getCountByStatus(item.status, countData) > 0 && (
                    <Badge
                      style={{ marginLeft: 7 }}
                      overflowCount={999}
                      count={getCountByStatus(item.status, countData)}
                    />
                  )}
                </Button>
                {item?.renderDivider && (
                  <Divider type="vertical" style={{ marginLeft: 15, height: "100%", borderColor: "#000" }} />
                )}
              </Col>
            </React.Fragment>
          ))}
        </Row>
      </Space>
    </>
  );
};

export default RefundQuestionListNav;
</file>

