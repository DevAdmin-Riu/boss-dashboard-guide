    },
    isDirectShipping: {
      active: maybe(() => !utils.isEmpty(filterVariables.isDirectShipping), false),
      value: maybe(() => filterVariables.isDirectShipping, false),
    },
    isTaxFree: {
      active: maybe(() => !utils.isEmpty(filterVariables.isTaxFree), false),
      value: maybe(() => filterVariables.isTaxFree, true),
    },
    isExclusive: {
      active: maybe(() => !utils.isEmpty(filterVariables.isExclusive), false),
      value: maybe(() => filterVariables.isExclusive, true),
    },
    requiredExpDateMgmt: {
      active: maybe(() => !utils.isEmpty(filterVariables.requiredExpDateMgmt), false),
      value: maybe(() => filterVariables.requiredExpDateMgmt, false),
    },
    categoryKind: {
      active: maybe(() => !utils.isEmpty(filterVariables.categoryKind), false),
      value: maybe(() => dedupeFilter(filterVariables.categoryKind), []),
    },
  };
}

export function getFilterVariables(params: ProductListViewUrlFilters): ProductFilterInput {
  return {
    salesStatus:
      maybe(() => {
        const salesStatusArray = isArray(params.salesStatus) ? params.salesStatus : [params.salesStatus];
        return salesStatusArray.map((status) => findInEnum(status, SalesStatusEnum));
      }) || [],
    attributes: !!params.attributes
      ? Object.keys(params.attributes).map((key) => ({
          slug: key,
          // It is possible for qs to parse values not as string[] but string
          values: isArray(params.attributes[key])
            ? params.attributes[key]
            : ([params.attributes[key]] as unknown as string[]),
        }))
      : [],
    categories: params.categories !== undefined ? params.categories : [],
    collections: params.collections !== undefined ? params.collections : [],
    costPrice: getGteLteVariables({
      gte: parseInt(params.costPriceFrom, 10),
      lte: parseInt(params.costPriceTo, 10),
    }),
    deliveryFee: getGteLteVariables({
      gte: parseInt(params.deliveryFeeFrom, 10),
      lte: parseInt(params.deliveryFeeTo, 10),
    }),
    productTypes: params.productTypes !== undefined ? params.productTypes : [],
    productSearch: params.productSearch,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, false) : undefined,
    isDirectShipping: params.isDirectShipping !== undefined ? parseBoolean(params.isDirectShipping, false) : undefined,
    isTaxFree: params.isTaxFree !== undefined ? parseBoolean(params.isTaxFree, false) : undefined,
    isExclusive: params.isExclusive !== undefined ? parseBoolean(params.isExclusive, false) : undefined,
    requiredExpDateMgmt:
      params.requiredExpDateMgmt !== undefined ? parseBoolean(params.requiredExpDateMgmt, false) : undefined,
    categoryKind:
      params.categoryKind !== undefined
        ? maybe(() => {
            const categoryKindArray = isArray(params.categoryKind) ? params.categoryKind : [params.categoryKind];
            return categoryKindArray.map((kind) => findInEnum(kind, CategoryKindEnum));
          }) || []
        : [],
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ProductFilterKeys>,
  params: ProductListViewUrlFilters
): ProductListViewUrlFilters {
  const { active, group, name, value } = filter;

  if (!!group) {
    const rest = params && params[group] ? params[group] : undefined;

    return {
      [group]: active
        ? {
            ...(rest === undefined ? {} : rest),
            [name]: value,
          }
        : rest,
    };
  }

  switch (name) {
    case ProductFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.productSearch);
    case ProductFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.vendorSearch);
    case ProductFilterKeys.salesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        ProductListViewUrlFiltersWithMultipleValues.salesStatus,
        SalesStatusEnum
      );

    case ProductFilterKeys.categories:
      return getMultipleValueQueryParam(filter, ProductListViewUrlFiltersWithMultipleValues.categories);

    case ProductFilterKeys.collections:
      return getMultipleValueQueryParam(filter, ProductListViewUrlFiltersWithMultipleValues.collections);

    case ProductFilterKeys.costPrice:
      return getMinMaxQueryParam(
        filter,
        ProductListViewUrlFiltersEnum.costPriceFrom,
        ProductListViewUrlFiltersEnum.costPriceTo
      );

    case ProductFilterKeys.deliveryFee:
      return getMinMaxQueryParam(
        filter,
        ProductListViewUrlFiltersEnum.deliveryFeeFrom,
        ProductListViewUrlFiltersEnum.deliveryFeeTo
      );

    case ProductFilterKeys.productType:
      return getMultipleValueQueryParam(filter, ProductListViewUrlFiltersWithMultipleValues.productTypes);

    case ProductFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.trackInventory);

    case ProductFilterKeys.isDirectShipping:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.isDirectShipping);

    case ProductFilterKeys.isTaxFree:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.isTaxFree);

    case ProductFilterKeys.isExclusive:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.isExclusive);
    case ProductFilterKeys.requiredExpDateMgmt:
      return getSingleValueQueryParam(filter, ProductListViewUrlFiltersEnum.requiredExpDateMgmt);
    case ProductFilterKeys.categoryKind:
      return getMultipleEnumValueQueryParam(
        filter,
        ProductListViewUrlFiltersWithMultipleValues.categoryKind,
        CategoryKindEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<ProductListViewUrlFilters>(PRODUCT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ProductListViewUrlQueryParams,
  ProductListViewUrlFilters
>({
  ...ProductListViewUrlFiltersEnum,
  ...ProductListViewUrlFiltersWithMultipleValues,
  ...ProductListViewUrlFiltersAsDictWithMultipleValues,
});
