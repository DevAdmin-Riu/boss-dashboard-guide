  ${pageInfoFragment}
  ${refundQuestionDetailFragment}
  query RefundQuestionList(
    $sort: RefundQuestionSortingInput
    $filter: RefundQuestionFilterInput
    $before: String
    $after: String
    $first: Int
    $last: Int
  ) {
    refundQuestions(sortBy: $sort, filter: $filter, before: $before, after: $after, first: $first, last: $last) {
      pageInfo {
        ...PageInfoFragment
      }
      edges {
        node {
          ...RefundQuestionDetailFragment
        }
      }
      totalCount
    }
  }
`;
export const useQuestionListQuery = makeQuery<RefundQuestionList, RefundQuestionListVariables>(
