<file path="src/app/components/SorterDropdown/SorterDropdown.tsx">
import { ArrowDownOutlined, ArrowUpOutlined, DownOutlined } from "@ant-design/icons";
import { SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Dropdown, MenuProps, Space, Typography } from "antd";
import React from "react";

import { ISorter } from "./types";

interface SorterDropdownProps<TKeys extends string = string> extends SortPage<TKeys> {
  sorterStructure: ISorter<TKeys>;
  activeSortId?: string;
}

export const SorterDropdown: React.FC<SorterDropdownProps> = (props) => {
  const { sorterStructure, activeSortId, sort, onSort } = props;

  const items: MenuProps["items"] = sorterStructure.map((sorterElement) => {
    const isSelected = sort.sort === sorterElement.sortField && activeSortId === sorterElement?.sortId;
    const key =
      sorterElement.sortField + (utils.isEmpty(sorterElement?.sortId, true) ? "" : `:${sorterElement.sortId}`);
    return {
      key,
      label: (
        <Typography onClick={() => onSort(sorterElement.sortField, sorterElement?.sortId)}>
          {sorterElement.label} {isSelected ? sort.asc ? <ArrowUpOutlined /> : <ArrowDownOutlined /> : null}
        </Typography>
      ),
    };
  });
  const selectedSorter = sorterStructure.find((sorterElement) => sort.sort === sorterElement.sortField);
  const sorterBarTitle = selectedSorter
    ? `정렬(${selectedSorter ? selectedSorter.label : ""} ${sort.asc === true ? "오름차순" : "내림차순"})`
    : "정렬";

  return (
    <Dropdown
      trigger={["click"]}
      overlayStyle={{ width: 200 }}
      menu={{ items, selectable: true, defaultSelectedKeys: [sort.sort] }}
    >
      <Button type="default">
        <Space>
          {sorterBarTitle} <DownOutlined />
        </Space>
      </Button>
    </Dropdown>
  );
};
</file>

