import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import { SendComplainInput } from "@src/api/types/globalTypes";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrorInfo } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useSendComplainMutation } from "../api/mutations";
import { HqComplaintSendPage } from "../components/HqComplaintSendPage";

export const HqComplaintSendView = () => {
  const navigate = useNavigator();

  const [sendComplain, sendComplainOpts] = useSendComplainMutation({
    onCompleted: (data) => {
      const errors = data.sendComplain.errors;
      if (errors.length === 0) {
        showNotificationSuccess("고객님의 소중한 의견이 제출되었습니다.");
        navigate("/");
      } else {
        // 해당 뮤테이션의 error 리턴 타입에는 code가 없기 때문에 아래와 같이 별도 처리
        const error = errors[0];
        showGqlErrorInfo(error.message, null, error.field);
      }
    },
  });
  const onSendComplain = (input: SendComplainInput) => {
    const { writerPhone, writerEmail } = input;
    // 전화번호가 입력된 경우에만 전화번호 형식 체크
    if (utils.isEmpty(writerPhone) === false && utils.checkPhoneNumber(writerPhone) === false) {
      showNotificationError("전화번호 형식이 올바르지 않습니다.");
      return;
    }
    // 이메일이 입력된 경우에만 이메일 형식 체크
    if (utils.isEmpty(writerEmail) === false && utils.checkEmail(writerEmail) === false) {
      showNotificationError("이메일 형식이 올바르지 않습니다.");
      return;
    }

    sendComplain({ variables: { input } });
  };

  const title = sectionNames.complaints;
  const pageLoading = sendComplainOpts.loading;

  return (
    <>
      <WindowTitle title={title} />
      <HqComplaintSendPage loading={pageLoading} onSendComplain={onSendComplain} />
    </>
  );
};
</file>

