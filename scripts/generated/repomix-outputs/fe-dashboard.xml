import AddressFormatter from "@src/app/components/AddressFormatter";
import CardMenu from "@src/app/components/CardMenu";
import Skeleton from "@src/app/components/Skeleton";
import { Card, Typography } from "antd";
import React from "react";

import { CustomerAddresses_user, CustomerAddresses_user_addresses } from "../../api/types/CustomerAddresses";

interface CustomerAddressProps {
  customer?: CustomerAddresses_user;
  address: CustomerAddresses_user_addresses;
  disabled: boolean;
  isDefaultShippingAddress: boolean;
  addressNumber: number;
  onEdit: () => void;
  onRemove: () => void;
  onSetAsDefault: () => void;
}

const CustomerAddress: React.FC<CustomerAddressProps> = (props) => {
  const { address, disabled, isDefaultShippingAddress, onEdit, onRemove, onSetAsDefault } = props;
  const titleBadge = isDefaultShippingAddress ? "기본 배송지" : undefined;

  return (
    <Card
      size={"small"}
      style={{ height: "100%" }}
      title={
        address ? (
          <Typography.Title level={5}>
            {titleBadge ? `${address.firstName} - ${titleBadge}` : `${address.firstName}`}
          </Typography.Title>
        ) : (
          <Skeleton />
        )
      }
      extra={
        <CardMenu
          disabled={disabled}
          menuItems={[
            {
              label: "기본 배송지로 설정",
              onSelect: () => onSetAsDefault(),
            },
            {
              label: "수정",
              onSelect: onEdit,
            },
            {
              label: "삭제",
              onSelect: onRemove,
            },
          ]}
        />
      }
    >
      <AddressFormatter address={address} />
    </Card>
  );
};
export default CustomerAddress;
