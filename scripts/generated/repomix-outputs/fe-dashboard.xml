  disabled,
  errors,
  saveButtonBar,
  onBack,
  onSubmit,
  isHqPopup,
  fromBossNoticeList,
}: PopupCreatePageProps) => {
  const handleSubmit = (formData: PopupCreatePageFormData) => {
    onSubmit({
      name: formData.name,
      linkUrl: formData.linkUrl,
