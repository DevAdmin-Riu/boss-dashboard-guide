import moment from "moment";

const makeStatsDateRange = (value: number, type: "months") => {
  const startOf = moment().subtract(value, type).startOf("month");
  const endOf = moment().subtract(value, type).endOf("month");
  return [startOf, endOf];
};

const makeStatsDateRangeForMonthly = (value: number, type: "months") => {
  const startOf = moment().subtract(value, type).startOf("month");
  const endOf = moment().subtract(value, type).endOf("month");
  return [startOf, endOf];
};

export const durationSettingsForDaily = [
  {
    label: "당월",
    value: makeStatsDateRange(0, "months"),
  },
  {
    label: "전월",
    value: makeStatsDateRange(1, "months"),
  },
];

export const durationSettingsForMonthly = [
  {
    label: "당월",
    value: makeStatsDateRangeForMonthly(0, "months"),
  },
  {
    label: "전월",
    value: makeStatsDateRangeForMonthly(1, "months"),
  },
];
