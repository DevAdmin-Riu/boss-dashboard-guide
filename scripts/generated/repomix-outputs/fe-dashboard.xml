export const getQuantityByStockDetailEvent = (
  stockDetailEvent: StockDetailEventList_stockDetailEventList_edges_node
): number => {
  if (!stockDetailEvent) {
    return null;
  }
  const { type: eventType, quantity, stock } = stockDetailEvent;
  const negativeMultipliers = -1;
  const productVariant = stock.productVariant;
  const parameters = utils.jsonParseWrapper(stockDetailEvent.parameters);
  const innerQuantity = parameters?.inner_stock_qty;
  const outerQuantity = parameters?.outer_stock_qty;

  switch (eventType) {
    case StockDetailEventsEnum.LOSS:
    case StockDetailEventsEnum.TAKE_BACK:
    case StockDetailEventsEnum.FULFILLMENT:
      return negativeMultipliers * quantity;
    case StockDetailEventsEnum.DIVIDE:
      // 재고 소분인 경우 아우터박스 제품의 수량은 감소하므로 -1 곱하여 반환
      return productVariant.isInner ? innerQuantity : negativeMultipliers * outerQuantity;
    case StockDetailEventsEnum.COMBINE:
      // 재고 결합인 경우 이너박스 제품의 수량은 감소하므로 -1 곱하여 반환
      return productVariant.isInner ? negativeMultipliers * innerQuantity : outerQuantity;
    case StockDetailEventsEnum.MOVE:
      return parameters?.from_quantity;
    default:
      return quantity;
  }
};

export const getCostPriceExcludeVatByStockDetailEvent = (
  stockDetailEvent: Pick<
    StockDetailEventList_stockDetailEventList_edges_node,
    "type" | "costPriceExcludeVat" | "parameters"
  >
) => {
  if (!stockDetailEvent) {
    return null;
  }
  const { type: eventType, costPriceExcludeVat } = stockDetailEvent;
  const parameters = utils.jsonParseWrapper(stockDetailEvent.parameters);

  // 예전 데이터 구조를 대응하기 위해서 먼저 최신 구조 데잍터 값이 있는지 체크 후 없으면 예전 구조 데이터로 처리
  switch (eventType) {
    case StockDetailEventsEnum.COMBINE:
      if (utils.isEmpty(parameters?.outer_cost_price_exclude_vat)) {
        return parseInt(parameters?.outer_stock_cost_price.amount, 10);
      }
      return parseInt(parameters?.outer_cost_price_exclude_vat, 10);
    case StockDetailEventsEnum.DIVIDE:
      if (utils.isEmpty(parameters?.inner_cost_price_exclude_vat)) {
        return parseInt(parameters?.inner_stock_cost_price.amount, 10);
      }
      return parseInt(parameters?.inner_cost_price_exclude_vat, 10);
    case StockDetailEventsEnum.MOVE:
      if (utils.isEmpty(parameters?.cost_price_exclude_vat)) {
        return parseInt(parameters?.stock_cost_price.amount, 10);
      }
      return parseInt(parameters?.cost_price_exclude_vat, 10);
    default:
      return costPriceExcludeVat;
  }
};

export const makeStockDetailEventInfoText = (
  stockDetailEvent: StockDetailEventList_stockDetailEventList_edges_node,
  isFulfilledByVendor: boolean
) => {
  const eventType = stockDetailEvent.type;
  const costPriceExcludeVat = stockDetailEvent.costPriceExcludeVat;
  const parameters = utils.jsonParseWrapper(stockDetailEvent.parameters);
  const emptyReason = "사유 미기재";
  switch (eventType) {
    case StockDetailEventsEnum.PURCHASE:
      const vendor = stockDetailEvent.vendor || "협력사명 없음";
      return `${vendor}${isFulfilledByVendor === false ? `/ ${costPriceExcludeVat.toLocaleString()}원` : ""} `;
    case StockDetailEventsEnum.ETC_PURCHASE:
      return `${stockDetailEvent.reason || emptyReason}${
        isFulfilledByVendor === false ? `/ ${costPriceExcludeVat.toLocaleString()}원` : ""
      } `;
    case StockDetailEventsEnum.LOSS:
      return stockDetailEvent.reason || emptyReason;
    case StockDetailEventsEnum.ADJUST_TO_ZERO:
      return `${parameters?.reason || emptyReason} / 수량: ${parameters?.before_quantity} → ${
        parameters?.after_quantity
      }`;
    case StockDetailEventsEnum.COMBINE:
      return parameters?.reason || emptyReason;
    case StockDetailEventsEnum.DIVIDE:
      return parameters?.reason || emptyReason;
    case StockDetailEventsEnum.MOVE:
      const [toLocationList, qtyList] = parseToLocationQtyInfo(stockDetailEvent);
      // 도착 수량: qtyA개(toLocationA), qtyB개(toLocationB), ... 형태로 반환
      return `${parameters?.reason || emptyReason} / 도착 수량: ${qtyList
        .map((qty, idx) => `${qty}개(${toLocationList[idx]})`)
        .join(", ")}`;
    case StockDetailEventsEnum.TAKE_BACK:
      return stockDetailEvent.reason || emptyReason;
    case StockDetailEventsEnum.FULFILLMENT:
      return stockDetailEvent.reason || emptyReason;
    case StockDetailEventsEnum.FULFILLMENT_CANCEL:
      return stockDetailEvent.reason || emptyReason;
    default:
      return "-";
  }
};

