export function getVsPoLineStatusFromPoLineRouteParams(
  routeParams: PurchaseOrderLineListViewRouteParams
): PurchaseOrderLineStatusEnum[] {
  const { status } = routeParams;

  // 발주 접수
  if (status === "receive") {
    return [PurchaseOrderLineStatusEnum.PENDING];
  }

  // 출고 지시
  if (status === "dispatch-fulfillment") {
    return [PurchaseOrderLineStatusEnum.RECEIVED];
  }

  // 배송 확정
  if (status === "confirm-delivery") {
    return [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT];
  }

  // 거래명세서 출력
  if (status === "print-invoice") {
    return [PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED];
  }

  // 배송 완료
  if (status === "complete-delivery") {
    return [
      PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
      PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
      PurchaseOrderLineStatusEnum.INSPECTED,
      PurchaseOrderLineStatusEnum.STOCKED,
      PurchaseOrderLineStatusEnum.DELIVERED,
    ];
  }

  // 전체 발주 내역
  if (status === "all-status") {
    return [
      PurchaseOrderLineStatusEnum.PENDING,
      PurchaseOrderLineStatusEnum.RECEIVED,
      PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
      PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
      PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
      PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
      PurchaseOrderLineStatusEnum.INSPECTED,
      PurchaseOrderLineStatusEnum.STOCKED,
      PurchaseOrderLineStatusEnum.DELIVERED,
    ];
  }
}

