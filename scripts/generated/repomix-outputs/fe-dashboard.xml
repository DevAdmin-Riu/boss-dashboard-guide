<file path="src/app/views/b2b/components/B2bSalesStatListPage/utils.ts">
import { s3TemplateUrl } from "@assets/constants/config";
import {
  getDateByFormat,
  monthDayKoreanFormat,
  onlyDateFormat,
  yearMonthKoreanFormat,
} from "@src/app/providers/DateProvider";
import { ShopInfo_shop_riuBizRegInfo } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { B2bSalesStats_b2bSalesStats } from "@src/app/views/b2b/api/types/B2bSalesStats";
import { SalesListForB2b_sales_edges_node } from "@src/app/views/hqStaff/hqB2b/api/types/SalesListForB2b";
import { deliveryFeeVat } from "@src/app/views/hqStaff/hqB2b/components/HqB2bSettlementListPage/utils";
import {
  applyNumberCellFormat,
  convertWorkBookToXlsxFile,
  defaultExcelCellStyle,
  getCellRangeArr,
  toPriceExcludeVat,
} from "@utils/excel/excelDownload";
import {
  applyXlsxCellStyle,
  expandTemplateDataArrByLines,
  replaceTemplateDataArrByMap,
} from "@utils/excel/templateDownload";
import { utils } from "@utils/utils";
import moment from "moment";
import * as xlsx from "xlsx-js-style";

interface AreaStyle {
  range: { start: string; end: string };
  area: { startRow: number; endRow: number; startCol: string; endCol: string };
  innerStyle: { bold?: boolean; fillColor?: string; fontColor?: string };
  outerBorder: boolean;
  specificRows?: { [key: number]: { bold?: boolean; fillColor?: string } };
}

// ========================= 상수 정의 =========================
const EXCEL_CONSTANTS = {
  FONT_SIZE: {
    DEFAULT: 11,
    HEADER: 14,
  },
  COLORS: {
    HEADER_BG: "F2F2F2",
    YELLOW: "FFFF00",
    RED: "FF0000",
    SECONDARY_BG: "ECECEC",
  },
  BORDER_STYLES: {
    THIN: "thin",
    MEDIUM: "medium",
    DOUBLE: "double",
  },
} as const;

const AREA_RANGES = {
  SUPPLIER: { startRow: 2, endRow: 9 },
  RECIPIENT: { startRow: 12, endRow: 17 },
  SALES_TABLE_START: 12, // 수신자 영역과 겹치지 않도록 20행부터 시작
  NO_BORDER_ROWS: [10, 11] as readonly number[],
  COLUMNS: { START: "B", END: "K" },
} as const;

// ========================= Export 함수들 (날짜/결제 관련) =========================
// 결제 예정월 계산 함수
export const calculateDueMonth = (
  salesCloseDate: string,
  b2bPayMethod?: string,
  dateFormat: string = yearMonthKoreanFormat
): string => {
  const getMonthsToAdd = (b2bPayMethod?: string): number => {
    switch (b2bPayMethod) {
      case "TWO_MONTH":
        return 2;
      case "NEXT_MONTH":
        return 1;
      default:
        return 0;
    }
  };

  const targetDate = moment(salesCloseDate).add(getMonthsToAdd(b2bPayMethod), "month").format(dateFormat);
  return targetDate;
};

// 결제 예정일 계산 함수
export const calculatePaidDate = (
  salesCloseDate: string,
  b2bPayMethod?: string,
  format: string = yearMonthKoreanFormat
): string => {
  let paidDate: moment.Moment;

  if (b2bPayMethod === "TWO_MONTH") {
    // 2개월 후 말일
    paidDate = moment(salesCloseDate).add(2, "month").endOf("month");
  } else if (b2bPayMethod === "NEXT_MONTH") {
    // 다음달 말일
    paidDate = moment(salesCloseDate).add(1, "month").endOf("month");
  } else {
    // 당월 말일
    paidDate = moment(salesCloseDate).endOf("month");
  }

  return paidDate.format(format);
};

// 매출 라인별 데이터를 엑셀 템플릿 변수로 매핑하는 함수
export const makeSalesLineMap = (salesLine: SalesListForB2b_sales_edges_node, rowNumber: number = 1) => {
  const defaultStrValue = "-";

  // productInfo 파싱
  const productInfo =
    typeof salesLine.productInfo === "string" ? JSON.parse(salesLine.productInfo) : salesLine.productInfo || {};

  // 금액 계산
  const unitPriceExcludeVat = toPriceExcludeVat(
    salesLine.unitPrice,
    salesLine.isTaxFree,
    salesLine.variant?.priceDecimalPlaces || 0
  );
  const amountExcludeVat = unitPriceExcludeVat * salesLine.quantity;
  const vatAmount = salesLine.isTaxFree ? 0 : Math.round(amountExcludeVat * 0.1);
  const b2bDeliveryFeeExcludeVat = salesLine.b2bDeliveryFeeExcludeVat || 0;
  const b2bDeliveryFeeVat = deliveryFeeVat(b2bDeliveryFeeExcludeVat);
  const subTotalAmount = amountExcludeVat + vatAmount + b2bDeliveryFeeExcludeVat + b2bDeliveryFeeVat;

  // 기본 매핑 객체
  const lineMap = {
    numIdx: rowNumber.toString(),
    b2bInvoicePrintedAt: salesLine.b2bInvoicePrintedAt
      ? moment(salesLine.b2bInvoicePrintedAt).format(monthDayKoreanFormat)
      : defaultStrValue,
    brandProductName: productInfo.brandProductName || defaultStrValue,
    quantity: salesLine.quantity,
    unitPriceExcludeVat,
    b2bDeliveryFeeExcludeVat,
    amountExcludeVat,
    amountVat: vatAmount + b2bDeliveryFeeVat,
    subTotalAmount,
  };

  return lineMap;
};

// ========================= 스타일 관련 헬퍼 함수들 =========================
const createCellStyle = (fontSize: number, bold: boolean, fillColor: string) => ({
  fontSize,
  bold,
  fillColor,
});

const createRowStyles = (startCol: string, endCol: string, rowNumber: number, style: any) => {
  const styles: { [key: string]: any } = {};
  for (let col = startCol.charCodeAt(0); col <= endCol.charCodeAt(0); col++) {
    const colLetter = String.fromCharCode(col);
    styles[`${colLetter}${rowNumber}`] = style;
  }
  return styles;
};

const shouldApplyBorder = (
  cell: string,
  area: { startRow: number; endRow: number; startCol: string; endCol: string }
): { top: boolean; bottom: boolean; left: boolean; right: boolean } => {
  const colMatch = cell.match(/^([A-Z]+)(\d+)$/);
  if (!colMatch) {
    return { top: false, bottom: false, left: false, right: false };
  }

  const col = colMatch[1];
  const row = parseInt(colMatch[2], 10);

  return {
    top: row === area.startRow,
    bottom: row === area.endRow,
    left: col === area.startCol,
    right: col === area.endCol,
  };
};

// 영역별 스타일 정의
const getStyleAreas = (totalLineRowCnt: number): AreaStyle[] => [
  // 공급자 정보
  {
    range: { start: "B2", end: "K9" },
    area: {
      startRow: AREA_RANGES.SUPPLIER.startRow,
      endRow: AREA_RANGES.SUPPLIER.endRow,
      startCol: "B",
      endCol: "K",
    },
    innerStyle: {},
    outerBorder: true,
    specificRows: {},
  },
  {
    range: { start: "B12", end: "K12" },
    area: {
      startRow: AREA_RANGES.RECIPIENT.startRow,
      endRow: AREA_RANGES.RECIPIENT.endRow,
      startCol: "B",
      endCol: "K",
    },
    innerStyle: {},
    outerBorder: true,
    specificRows: {},
  },
  // 매출 내역 테이블 (합계 행 포함)
  {
    range: {
      start: `B${AREA_RANGES.SALES_TABLE_START}`,
      end: `K${AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1}`,
    },
    area: {
      startRow: AREA_RANGES.SALES_TABLE_START,
      endRow: AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1,
      startCol: "B",
      endCol: "K",
    },
    innerStyle: {},
    outerBorder: true,
    specificRows: {},
  },
];

// 특정 셀 스타일 정의
const getSpecificCellStyles = (totalLineRowCnt: number) => {
  const headerStyle = createCellStyle(EXCEL_CONSTANTS.FONT_SIZE.HEADER, true, EXCEL_CONSTANTS.COLORS.HEADER_BG);

  return {
    // 개별 셀 스타일 (배열로 처리)
    ...Object.fromEntries(
      ["B2", "B3", "C3", "C4", "C5", "C6", "C7", "E4", "E6", "G3", "G8", "H3", "H4", "H5", "H6", "H7", "J4", "J6"].map(
        (cell) => [cell, headerStyle]
      )
    ),

    // 특별한 스타일이 필요한 개별 셀들
    G2: { fillColor: EXCEL_CONSTANTS.COLORS.HEADER_BG },
    J9: { fillColor: EXCEL_CONSTANTS.COLORS.YELLOW, fontColor: EXCEL_CONSTANTS.COLORS.RED },

    // 전체 행 스타일
    ...createRowStyles("B", "K", 8, headerStyle),
    ...createRowStyles("B", "K", AREA_RANGES.SALES_TABLE_START, headerStyle),

    // 합계 행 스타일
    ...createRowStyles("B", "K", AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1, headerStyle),
  };
};

// ========================= 셀 스타일 적용 함수 =========================
const applyCellStyles = (newWorksheet: xlsx.WorkSheet, totalLineRowCnt: number) => {
  const styleAreas = getStyleAreas(totalLineRowCnt);
  const specificCellStyles = getSpecificCellStyles(totalLineRowCnt);

  for (const cell in newWorksheet) {
    if (typeof newWorksheet[cell] != "object") {
      continue;
    }

    const currentCell = newWorksheet[cell];
    const matchedNumberArr = cell.match(/\d+/);
    const rowNumber = !utils.isEmpty(matchedNumberArr) && parseInt(matchedNumberArr[0], 10);

    applyNumberCellFormat(currentCell);

    // A열과 1행은 스타일 적용하지 않음
    const colMatch = cell.match(/^([A-Z]+)(\d+)$/);
    if (!colMatch) {
      continue;
    }

    const col = colMatch[1];
    const row = parseInt(colMatch[2], 10);

    // A열, 1행, K열 이후는 스타일 적용하지 않음
    if (col === "A" || row === 1 || col.charCodeAt(0) > "K".charCodeAt(0)) {
      continue;
    }

    // 스타일을 적용할 범위 확인
    const isInSupplierArea = row >= AREA_RANGES.SUPPLIER.startRow && row <= AREA_RANGES.SUPPLIER.endRow;
    const isInSalesTableArea =
      row >= AREA_RANGES.SALES_TABLE_START && row <= AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1;
    const shouldApplyStyle = isInSupplierArea || isInSalesTableArea;

    // 10행, 11행은 border 없는 스타일 적용
    const shouldHaveNoBorder = AREA_RANGES.NO_BORDER_ROWS.includes(row);

    let cellStyle: { [key: string]: any } = {};

    // 기본 스타일 적용
    if (shouldApplyStyle) {
      const commonCellStyle = shouldHaveNoBorder
        ? {
            font: { ...defaultExcelCellStyle.font, sz: 11 },
            alignment: { ...defaultExcelCellStyle.alignment, wrapText: true },
          }
        : {
            ...defaultExcelCellStyle,
            alignment: { ...defaultExcelCellStyle.alignment, wrapText: true },
            font: { ...defaultExcelCellStyle.font, sz: 11 },
          };
      cellStyle = { ...commonCellStyle };
    }

    let borderStyle: any = null;

    // 특정 셀 스타일 우선 적용
    if (specificCellStyles[cell]) {
      const specificStyle = specificCellStyles[cell];
      if (specificStyle.bold) {
        cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
      }
      if (specificStyle.fontSize) {
        cellStyle = applyXlsxCellStyle({ fontSize: specificStyle.fontSize }, cellStyle);
      }
      if (specificStyle.fillColor) {
        cellStyle = applyXlsxCellStyle({ fillColor: specificStyle.fillColor }, cellStyle);
      }
      if (specificStyle.fontColor) {
        cellStyle.font = { ...cellStyle.font, color: { rgb: specificStyle.fontColor } };
      }
    }

    // 각 영역에 대해 스타일 확인
    for (const area of styleAreas) {
      const cells = getCellRangeArr(area.range.start, area.range.end);

      if (cells.includes(cell)) {
        // 특정 셀 스타일이 없는 경우에만 영역 스타일 적용
        if (!specificCellStyles[cell]) {
          // 기본 내부 스타일 적용
          if (area.innerStyle.bold) {
            cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
          }
          if (area.innerStyle.fillColor) {
            cellStyle = applyXlsxCellStyle({ fillColor: area.innerStyle.fillColor }, cellStyle);
          }
          if (area.innerStyle.fontColor) {
            cellStyle.font = { ...cellStyle.font, color: { rgb: area.innerStyle.fontColor } };
          }

          // 특정 행 스타일 적용
          if (area.specificRows && area.specificRows[rowNumber]) {
            const rowStyle = area.specificRows[rowNumber];
            if (rowStyle.bold) {
              cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
            }
            if (rowStyle.fillColor) {
              cellStyle = applyXlsxCellStyle({ fillColor: rowStyle.fillColor }, cellStyle);
            }
          }
        }

        // 테두리 스타일 결정
        if (area.outerBorder && !AREA_RANGES.NO_BORDER_ROWS.includes(row)) {
          const outerPositions = shouldApplyBorder(cell, area.area);
          borderStyle = {
            top: {
              style: outerPositions.top ? EXCEL_CONSTANTS.BORDER_STYLES.MEDIUM : EXCEL_CONSTANTS.BORDER_STYLES.THIN,
              color: "000000",
            },
            bottom: {
              style: outerPositions.bottom ? EXCEL_CONSTANTS.BORDER_STYLES.MEDIUM : EXCEL_CONSTANTS.BORDER_STYLES.THIN,
              color: "000000",
            },
            left: {
              style: outerPositions.left ? EXCEL_CONSTANTS.BORDER_STYLES.MEDIUM : EXCEL_CONSTANTS.BORDER_STYLES.THIN,
              color: "000000",
            },
            right: {
              style: outerPositions.right ? EXCEL_CONSTANTS.BORDER_STYLES.MEDIUM : EXCEL_CONSTANTS.BORDER_STYLES.THIN,
              color: "000000",
            },
          };
        }

        break;
      }
    }

    // 테두리 적용
    if (borderStyle && !shouldHaveNoBorder) {
      cellStyle.border = borderStyle;
    }

    // 금액 관련 셀에 천 단위 구분 기호 적용
    const isAmountColumn = ["G", "H", "I", "J", "K"].includes(col);
    const isDataRow =
      row >= AREA_RANGES.SALES_TABLE_START && row <= AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1;
    const isAmountCell =
      (row === 3 && col === "J") || // J3: 합계금액
      (row === 4 && ["G", "J"].includes(col)) || // G4: 공급가액, J4: 미수금
      (row === 5 && ["G", "J"].includes(col)) || // G5: 세액, J5: 입금예정금액
      (row === 6 && col === "G") || // G6: 합계금액
      (row === 9 && ["C", "E", "G", "I", "J"].includes(col)); // 9행: C9, E9, G9, I9, J9

    if ((isAmountColumn && isDataRow) || isAmountCell) {
      cellStyle.numFmt = "#,##0";
    }

    // 특별한 테두리 처리
    // 매출 내역 테이블 헤더 행의 bottom border를 이중선으로 처리
    if (row === AREA_RANGES.SALES_TABLE_START && col >= AREA_RANGES.COLUMNS.START && col <= AREA_RANGES.COLUMNS.END) {
      if (!cellStyle.border) {
        cellStyle.border = {};
      }
      cellStyle.border.bottom = { style: EXCEL_CONSTANTS.BORDER_STYLES.DOUBLE, color: "000000" };
    }

    // B17~K17 행의 bottom border 제거
    if (row === AREA_RANGES.RECIPIENT.endRow && col >= AREA_RANGES.COLUMNS.START && col <= AREA_RANGES.COLUMNS.END) {
      if (cellStyle.border && cellStyle.border.bottom) {
        delete cellStyle.border.bottom;
      }
    }

    // 합계 행의 top border를 이중선으로 처리
    const totalRow = AREA_RANGES.SALES_TABLE_START + totalLineRowCnt + 1;
    if (row === totalRow && col >= AREA_RANGES.COLUMNS.START && col <= AREA_RANGES.COLUMNS.END) {
      if (!cellStyle.border) {
        cellStyle.border = {};
      }
      cellStyle.border.top = { style: EXCEL_CONSTANTS.BORDER_STYLES.DOUBLE, color: "000000" };
    }

    currentCell.s = cellStyle;
  }
};

const generateFileName = (salesCloseDate: string, brandName: string, b2bPayMethod?: string) => {
  const dueMonthFormatted = moment(salesCloseDate).format("M월");

  return `${moment(salesCloseDate)
    .endOf("month")
    .format(onlyDateFormat)}_${brandName}_${dueMonthFormatted}_마감명세서_리우.xlsx`;
};

// ========================= 메인 Export 함수 =========================
export const generateClosingStatementExcel = async (
  salesStatsRecord: B2bSalesStats_b2bSalesStats,
  unpaidAmount: number = 0,
  selectedBrandSalesList: SalesListForB2b_sales_edges_node[],
  riuBizRegInfo: ShopInfo_shop_riuBizRegInfo,
  b2bOrderManagerEmail: string | null = null
): Promise<File | null> => {
  // 1. 템플릿 파일 다운로드
  const templateVersion = "20251106-00";
  const templateUrl = `${s3TemplateUrl}/b2b_monthly_statement_${templateVersion}.xlsx`;
  const response = await fetch(templateUrl);
  const arrayBuffer = await response.arrayBuffer();

  const data = new Uint8Array(arrayBuffer);
  const originWorkbook = xlsx.read(data, { type: "array", cellStyles: true });
  const originWorksheet = originWorkbook.Sheets[originWorkbook.SheetNames[0]];

  // 2. 워크시트를 2차원 배열로 변환
  const originalRange = xlsx.utils.decode_range(originWorksheet["!ref"] || "A1");
  const adjustedRange = {
    s: { r: 0, c: 0 }, // A1부터 시작
    e: { r: originalRange.e.r, c: originalRange.e.c },
  };

  const dataArr = xlsx.utils.sheet_to_json(originWorksheet, {
    header: 1,
    defval: "",
    raw: false,
    range: adjustedRange,
  }) as string[][];

  // 각 행이 동일한 열 수를 갖도록 보장
  const maxCols = adjustedRange.e.c + 1;
  for (let i = 0; i < dataArr.length; i++) {
    while (dataArr[i].length < maxCols) {
      dataArr[i].push("");
    }
  }

  // 3. 데이터 준비
  const lineMaps = selectedBrandSalesList.map((salesLine, index) => makeSalesLineMap(salesLine, index + 1));
  const totalLineRowCnt = lineMaps.length;

  const monthStr = getDateByFormat(salesStatsRecord.statDate, yearMonthKoreanFormat);
  const brandName = salesStatsRecord.brand?.name || "";
  const salesCloseDate = salesStatsRecord.statDate;
  const salesCloseDateFormatted = salesCloseDate ? getDateByFormat(salesCloseDate, yearMonthKoreanFormat) : "-";
  const dueMonth = calculateDueMonth(salesCloseDate, salesStatsRecord?.brand?.b2bPayMethod);
  const bizInfo = salesStatsRecord.brand?.bizInfo;

  // 금액 계산
  const taxableTotal = salesStatsRecord.statTaxableTotal || 0;
  const taxfreeTotal = salesStatsRecord.statTaxfreeTotal || 0;
  const supplyValue = toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;

  const totalB2bDeliveryFeeExcludeVat = lineMaps.reduce((sum, line) => sum + (line.b2bDeliveryFeeExcludeVat || 0), 0);
  const totalAmountExcludeVat = supplyValue;
  const vatAmount = taxableTotal + taxfreeTotal - supplyValue;
  const totalAmount = taxableTotal + taxfreeTotal;

  // 4. 데이터 매핑
  const dataMap = {
    month: monthStr,

    // 공급자 정보
    supplierBizRegNo: riuBizRegInfo?.bizRegNo || "-",
    supplierCompanyName: riuBizRegInfo?.corpName || "-",
    supplierCeo: riuBizRegInfo?.ceoName || "-",
    supplierCompanyAddress: riuBizRegInfo?.address || "-",
    supplierBizType: riuBizRegInfo?.businessType || "-",
    supplierBizClass: riuBizRegInfo?.businessClass || "-",
    supplierEmail: b2bOrderManagerEmail || "-",

    // 수신자 정보
    receiverCompanyName: bizInfo?.bizName || brandName || "-",
    receiverBizRegNo: bizInfo?.bizRegNo || "-",
    receiverCeo: bizInfo?.bizRepName || "-",
    receiverCompanyAddress: bizInfo?.bizAddress || "-",
    receiverBizType: bizInfo?.bizType || "-",
    receiverBizClass: bizInfo?.bizClass || "-",
    receiverEmail: bizInfo?.bizEmail || "-",

    // 금액 정보
    salesCloseDate: salesCloseDateFormatted,
    unpaidAmount,
    dueAmount: totalAmount + unpaidAmount,
    dueMonth,
    totalAmountExcludeVat,
    totalB2bDeliveryFeeExcludeVat,
    totalAmountVat: vatAmount,
    totalAmount,
  };

  // 5. 템플릿 확장 및 데이터 교체
  const { expandedDataArr, expandedMerges, expandedRowsInfo } = expandTemplateDataArrByLines({
    originWorksheet,
    dataArr,
    lineCount: totalLineRowCnt,
  });

  const replacedDataArr = replaceTemplateDataArrByMap({
    dataArr: expandedDataArr,
    dataMap,
    lineMaps,
  });

  // 6. 새 워크시트 생성
  const newWorkbook = xlsx.utils.book_new();
  const newWorksheet = xlsx.utils.aoa_to_sheet(replacedDataArr, {});

  newWorksheet["!cols"] = originWorksheet["!cols"];
  newWorksheet["!rows"] = expandedRowsInfo;
  newWorksheet["!merges"] = expandedMerges;

  // 7. 스타일 적용
  applyCellStyles(newWorksheet, totalLineRowCnt);

  // 8. 워크북에 워크시트 추가
  xlsx.utils.book_append_sheet(newWorkbook, newWorksheet, originWorkbook.SheetNames[0]);

  // 9. 파일 생성 및 반환
  const xlsxFileName = generateFileName(salesCloseDate, brandName, salesStatsRecord?.brand?.b2bPayMethod);
  const xlsxFile = convertWorkBookToXlsxFile({ title: xlsxFileName, workBook: newWorkbook });
  return xlsxFile;
};
</file>

