export const parseProductVariantPriceToExcludeVat = (variant: TVariantForPrice): TProductPricingTableDataSource => {
  if (utils.isEmpty(variant)) {
    return null;
  }

  return {
    ...variant,
    costPriceExcludeVat: variant.costPriceExcludeVat,
    deliveryFeeExcludeVat: toPriceExcludeVat(variant.deliveryFeeAmount),
    consignmentCostPriceExcludeVat: variant.consignmentCostPriceExcludeVat,
    consignmentDeliveryFeeExcludeVat: toPriceExcludeVat(variant.consignmentDeliveryFeeAmount),
    innerCostPriceExcludeVat: variant.inner?.costPriceExcludeVat,
    innerIncidentalCostExcludeVat: toPriceExcludeVat(variant.inner?.innerIncidentalCostAmount),
  };
};

// NOTE: 제품 옵션/권역(productVariant/productVariantRegion)의 부가세 별도 가격 폼 정보를 부가세 포함 금액으로 변경
export const convertProductPriceToIncludeVat = (
  form: IProductPrice,
  isTaxFree: boolean,
  precision: number
): {
  price?: number;
  deliveryFeeAmount?: number;
  consignmentDeliveryFee?: number;
  innerCostPrice?: number;
  innerIncidentalCost?: number;
} => {
  if (utils.isEmpty(form)) {
    return null;
  }

  const convForm: { [key: string]: number | string[] | boolean } = {};
  if (utils.isEmpty(form.priceExcludeVat) === false) {
    convForm.price = toPriceIncludeVat(form.priceExcludeVat, isTaxFree, precision);
  }
  if (utils.isEmpty(form.deliveryFeeExcludeVat) === false) {
    convForm.deliveryFeeAmount = toPriceIncludeVat(form.deliveryFeeExcludeVat);
  }
  if (utils.isEmpty(form.consignmentDeliveryFeeExcludeVat) === false) {
    convForm.consignmentDeliveryFee = toPriceIncludeVat(form.consignmentDeliveryFeeExcludeVat);
  }
  if (utils.isEmpty(form.innerCostPriceExcludeVat) === false) {
    convForm.innerCostPrice = toPriceIncludeVat(form.innerCostPriceExcludeVat, isTaxFree);
  }
  if (utils.isEmpty(form.innerIncidentalCostExcludeVat) === false) {
    convForm.innerIncidentalCost = toPriceIncludeVat(form.innerIncidentalCostExcludeVat);
  }
  return convForm;
};

// NOTE: 브랜드 상품 옵션/권역(brandProductVariant/brandProductVariantRegion)의 부가세 별도 가격 폼 정보를 부가세 포함 금액으로 변경
export const convertBrandProductPriceToIncludeVat = (
  form: Pick<
    BrandProductFormType,
    "beforePriceExcludeVat" | "priceExcludeVat" | "priceVat" | "costPriceExcludeVat" | "deliveryFeeExcludeVat"
  >,
  isTaxFree: boolean,
  precision: number,
  enableForB2bService: boolean
): {
  beforePrice?: number;
  price: number;
  costPriceExcludeVat: number;
  deliveryFee: number;
  priceVat: number;
} => {
  if (utils.isEmpty(form)) {
    return null;
  }

  const convForm: {
    beforePrice?: number;
    price: number;
    costPriceExcludeVat: number;
    deliveryFee: number;
    priceVat: number;
  } = {
    price: undefined,
    costPriceExcludeVat: undefined,
    deliveryFee: undefined,
    priceVat: undefined,
  };

  if (utils.isEmpty(form.beforePriceExcludeVat) === false) {
    convForm.beforePrice = toPriceIncludeVat(form.beforePriceExcludeVat, isTaxFree);
  }
  if (utils.isEmpty(form.priceExcludeVat) === false && utils.isEmpty(form.priceVat) === false) {
    convForm.price = toPricePrecisionFixed(form.priceExcludeVat + form.priceVat, precision);
  }
  if (utils.isEmpty(form.costPriceExcludeVat) === false) {
    convForm.costPriceExcludeVat = form.costPriceExcludeVat;
  }
  if (utils.isEmpty(form.priceVat) === false) {
    convForm.priceVat = toPricePrecisionFixed(form.priceVat, precision);
  }
  if (enableForB2bService === false && utils.isEmpty(form.deliveryFeeExcludeVat) === false) {
    convForm.deliveryFee = toPriceIncludeVat(form.deliveryFeeExcludeVat);
  }
  if (enableForB2bService) {
    // B2B 브랜드인 경우 배송비는 0원으로 설정
    convForm.deliveryFee = 0;
  }

  return convForm;
};

