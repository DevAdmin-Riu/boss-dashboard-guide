export const multiplePurchaseTypeTackBackValue = (purchaseType: PurchaseType, value: number): number => {
  if (utils.isEmpty(value)) {
    return null;
  }
  if (value === 0) {
    return 0;
  }
  const multiple = isTakeBackType(purchaseType) ? -1 : 1;
  return value * multiple;
};

