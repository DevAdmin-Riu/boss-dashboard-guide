export function createFilterStructure(
  opts: OrderListFilterOpts,
  orderType: OrderType,
  isAll: boolean
): IFilter<OrderFilterKeys> {
  const orderSearchFilter = {
    ...createTextField(
      0,
      OrderFilterKeys.orderSearch,
      "주문번호",
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const paymentSearchFilter = {
    ...createTextField(0, OrderFilterKeys.paymentSearch, "결제번호", opts.paymentSearch.value, "결제번호로 검색"),
    active: opts.paymentSearch.active,
  };
  const createdFilter = {
    ...createDateField(0, OrderFilterKeys.created, filterMsg.orderCreated, opts.created.value),
    active: opts.created.active,
  };
  const capturedAtFilter = {
    ...createDateField(0, OrderFilterKeys.capturedAt, filterMsg.orderCapturedAt, opts.capturedAt.value),
    active: opts.capturedAt.active,
  };
  const brandSearchFilter = {
    ...createTextField(0, OrderFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(0, OrderFilterKeys.brandStoreSearch, "매장코드 / 매장명", opts.brandStoreSearch.value),
    active: opts.brandStoreSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(0, OrderFilterKeys.userSearch, "ID / 사용자명", opts.userSearch.value),
    active: opts.userSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(0, OrderFilterKeys.productSearch, filterNameConstant.PRODUCT_SEARCH, opts.productSearch.value),
    active: opts.productSearch.active,
  };
  const creatorUserSearchFilter = {
    ...createTextField(
      0,
      OrderFilterKeys.creatorUserSearch,
      columnNameConstant.order.ORDER_RECEIVER,
      opts.creatorUserSearch.value
    ),
    active: opts.creatorUserSearch.active,
  };
  const chargeStatusFilterOptions = [];
  const isOrderedByUser = checkOrderedByUser(orderType);
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  if (isOrderedByUser || isOrderedByStaffForBrand) {
    chargeStatusFilterOptions.push({
      label: "결제 대기",
      value: OrderChargeStatusFilter.PENDING,
    });
  }
  if (isOrderedByStaffForBrand) {
    chargeStatusFilterOptions.push({
      label: "결제 증빙",
      value: OrderChargeStatusFilter.BEING_APPROVED,
    });
  }
  chargeStatusFilterOptions.push({
    label: "결제 완료",
    value: OrderChargeStatusFilter.CHARGED,
  });
  chargeStatusFilterOptions.push({
    label: "일부 환불",
    value: OrderChargeStatusFilter.PARTIALLY_REFUNDED,
  });
  chargeStatusFilterOptions.push({
    label: "전액 환불",
    value: OrderChargeStatusFilter.FULLY_REFUNDED,
  });
  const chargeStatusFilter = {
    ...createOptionsField(
      0,
      OrderFilterKeys.chargeStatus,
      "결제 상태",
      opts.chargeStatus.value,
      true,
      chargeStatusFilterOptions
    ),
    active: opts.chargeStatus.active,
    smColSpan: 8,
  };
  const orderTypeFilter = {
    ...createOptionsField(0, OrderFilterKeys.type, "주문 방식", opts.type.value, true, [
      {
        label: "일반",
        value: OrderTypeEnum.BY_USER,
      },
      {
        label: "대행",
        value: OrderTypeEnum.BY_STAFF_FOR_BRAND,
      },
      {
        label: "오픈몰",
        value: OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK,
      },
      {
        label: "기타배송",
        value: OrderTypeEnum.BY_STAFF_FOR_ETC,
      },
    ]),
    active: opts.type.active,
  };
  const deliveryStatusFilter = {
    ...createOptionsField(0, OrderFilterKeys.deliveryStatus, "배송상태", opts.deliveryStatus.value, true, [
      {
        label: "미배송",
        value: OrderDeliveryStatusFilter.BEFORE_DELIVERY,
      },
      {
        label: "배송중",
        value: OrderDeliveryStatusFilter.TRACKING_DELIVERY,
      },
      {
        label: "배송완료(주문 상품 전체)",
        value: OrderDeliveryStatusFilter.COMPLETED_DELIVERY,
      },
      {
        label: "반품",
        value: OrderDeliveryStatusFilter.REFUNDED_DELIVERY,
      },
    ]),
    active: opts.deliveryStatus.active,
  };
  const payMethodFilter = {
    ...createOptionsField(0, OrderFilterKeys.payMethod, "결제방식", opts.payMethod.value, true, [
      {
        label: "카드 (보스페이)",
        value: OrderPayMethodFilter.IS_TOSS_RIU_CARD_PAY,
      },
      {
        label: "카드 (일반)",
        value: OrderPayMethodFilter.IS_NORMAL_CARD_PAY,
      },
      {
        label: "가상계좌",
        value: OrderPayMethodFilter.IS_VBANK_PAY,
      },
      {
        label: "충전금",
        value: OrderPayMethodFilter.IS_CREDITS_PAY,
      },
      {
        label: "포인트",
        value: OrderPayMethodFilter.IS_RCOIN_PAY,
      },
    ]),
    active: opts.payMethod.active,
  };

  switch (orderType) {
    case OrderType.BY_USER:
      if (isAll) {
        const filters = [
          orderSearchFilter,
          paymentSearchFilter,
          createdFilter,
          capturedAtFilter,
          brandSearchFilter,
          brandStoreSearchFilter,
          userSearchFilter,
          productSearchFilter,
          orderTypeFilter,
          chargeStatusFilter,
          deliveryStatusFilter,
          payMethodFilter,
        ];
        filters.forEach((filter, index) => {
          filter.displayOrder = index;
        });
        return filters;
      } else {
        const filters = [
          orderSearchFilter,
          paymentSearchFilter,
          createdFilter,
          capturedAtFilter,
          brandSearchFilter,
          brandStoreSearchFilter,
          userSearchFilter,
          productSearchFilter,
          chargeStatusFilter,
          deliveryStatusFilter,
          payMethodFilter,
        ];
        filters.forEach((filter, index) => {
          filter.displayOrder = index;
        });
        return filters;
      }
    case OrderType.BY_STAFF_FOR_BRAND: {
      const agencyTypeFilter = {
        ...createOptionsField(0, OrderFilterKeys.type, "대행주문 타입", opts.type.value, true, [
