import { PvEstimateStatus, PvEstimateType } from "@src/api/types/globalTypes";
import { utils } from "@utils/utils";

export const convertToPvEstimateType = (type: PvEstimateType) => {
  switch (type) {
    case PvEstimateType.OLD:
      return "기등록";
    case PvEstimateType.ESTIMATE:
      return "견적";
    default:
      return "-";
  }
};

export const convertToPvEstimateStatus = (status: PvEstimateStatus) => {
  switch (status) {
    case PvEstimateStatus.STANDBY:
      return "대기";
    case PvEstimateStatus.APPROVED:
      return "채택";
    case PvEstimateStatus.REJECTED:
      return "탈락";
    default:
      return "-";
  }
};

export const formatEmptyValue = (value: any, defaultEmptyValue: string) => {
  if (utils.isEmpty(value)) {
    return defaultEmptyValue;
  }

  if (typeof value === "number") {
    return value.toLocaleString("en-US");
  }

  return value;
};

export const getSupplyPriceExcludeVat = (
  defaultEmptyValue: string,
  productPriceExcludeVat?: number,
  deliveryFeeExcludeVat?: number
) => {
  const productPriceExcludeVatFormatting = formatEmptyValue(productPriceExcludeVat, defaultEmptyValue);
  const deliveryFeeExcludeVatFormatting = formatEmptyValue(deliveryFeeExcludeVat, defaultEmptyValue);

  if (productPriceExcludeVatFormatting === defaultEmptyValue || deliveryFeeExcludeVatFormatting === defaultEmptyValue) {
    return defaultEmptyValue;
  }
  const supplyPrice = Number(productPriceExcludeVat) + Number(deliveryFeeExcludeVat);
  return supplyPrice;
};

export const getUnitProductPriceExcludeVat = (
  defaultEmptyValue: string,
  productPriceExcludeVat?: number,
  qtyPerBox?: number
) => {
  const productPriceExcludeVatFormatting = formatEmptyValue(productPriceExcludeVat, defaultEmptyValue);
  const qtyPerBoxFormatting = formatEmptyValue(qtyPerBox, defaultEmptyValue);

  if (productPriceExcludeVatFormatting === defaultEmptyValue || qtyPerBoxFormatting === defaultEmptyValue) {
    return defaultEmptyValue;
  }
  const unitPrice = Number(productPriceExcludeVat) / Number(qtyPerBox);
  return unitPrice;
};

export const getUnitDeliveryFeeExcludeVat = (
  defaultEmptyValue: string,
  deliveryFeeExcludeVat?: number,
  qtyPerBox?: number
) => {
  const deliveryFeeExcludeVatFormatting = formatEmptyValue(deliveryFeeExcludeVat, defaultEmptyValue);
  const qtyPerBoxFormatting = formatEmptyValue(qtyPerBox, defaultEmptyValue);

  if (deliveryFeeExcludeVatFormatting === defaultEmptyValue || qtyPerBoxFormatting === defaultEmptyValue) {
    return defaultEmptyValue;
  }
  const unitDeliveryFee = Number(deliveryFeeExcludeVat) / Number(qtyPerBox);
  return unitDeliveryFee;
};

export const getUnitSupplyPriceExcludeVat = (
  defaultEmptyValue: string,
  productPriceExcludeVat?: number,
  deliveryFeeExcludeVat?: number,
  qtyPerBox?: number
) => {
  const unitProductPriceExcludeVat = getUnitProductPriceExcludeVat(
    defaultEmptyValue,
    productPriceExcludeVat,
    qtyPerBox
  );
  const unitDeliveryFeeExcludeVat = getUnitDeliveryFeeExcludeVat(defaultEmptyValue, deliveryFeeExcludeVat, qtyPerBox);

  if (unitProductPriceExcludeVat === defaultEmptyValue || unitDeliveryFeeExcludeVat === defaultEmptyValue) {
    return defaultEmptyValue;
  }
  const unitSupplyPrice = Number(unitProductPriceExcludeVat) + Number(unitDeliveryFeeExcludeVat);
  return unitSupplyPrice;
};
