  const { orderLineListViewType, orderLineListActionType } = params;
  const isByNonCourier = parseBoolean(params.isByNonCourier, false);
  const isListActionForPurchase = checkIsListActionForPurchase(orderLineListActionType);
  const isListActionForFulfill = checkIsListActionForFulfill(orderLineListActionType);
  const isListActionFulfilled = checkIsListActionFulfilled(orderLineListActionType);
  const isListViewConsignment = checkIsListViewConsignment(orderLineListViewType);
  const isB2bPurchaseWriteListViewPath = location.pathname === b2bPurchaseWriteListViewPath;
  const [listElementKeys, setListElementKeys] = useState<string[]>([]);

  const targetUrl = useMemo(() => {
    let url: (params?: OrderLineListViewUrlQueryParams) => string;
    if (isB2b) {
      if (isB2bPurchaseWriteListViewPath) {
        url = b2bPurchaseWriteListViewUrl;
      } else {
        url = orderLineListB2bForFulfillViewUrl;
      }
    } else if (isListViewConsignment) {
      if (isListActionForPurchase) {
        url = orderLineListForPurchaseViewUrlB;
      } else if (isListActionForFulfill) {
        if (isByNonCourier) {
          url = orderLineListForFulfillViewUrlByNonCourier;
        } else if (location.pathname === orderLineListForFulfillViewPathByCourierPriceAdjust) {
          url = orderLineListForFulfillViewUrlByCourierPriceAdjust;
        } else {
          url = orderLineListForFulfillViewUrlByCourier;
        }
      } else if (isListActionFulfilled) {
        url = fulfilledOrderLineListViewUrlB;
      } else {
        url = null;
      }
    } else {
      url = null;
    }
    return url;
  }, [
    isB2b,
    isB2bPurchaseWriteListViewPath,
    isListViewConsignment,
    isListActionForPurchase,
    isListActionForFulfill,
    isByNonCourier,
    location.pathname,
    isListActionFulfilled,
  ]);

  const useDispatchFulfillmentModal =
    targetUrl === orderLineListB2bForFulfillViewUrl ||
    targetUrl === orderLineListForFulfillViewUrlByNonCourier ||
    targetUrl === orderLineListForFulfillViewUrlByCourierPriceAdjust;
  const isB2bPurchaseWriteListView = targetUrl === b2bPurchaseWriteListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.ORDER_LINE_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useOrderLineListFilterDownloadQuery);
  const navUrlList = purchaseOrderLineUrlList(
    false,
    { inventoryType: "consignment", status: PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT },
    isB2b ? b2bPurchaseOrderLineListViewUrl : purchaseOrderLineListViewUrl,
    isB2b ? b2bPurchaseOrderLineListViewPath : purchaseOrderLineListViewPath,
    isB2b
  );

  const [countOfStatus, setCountOfStatus] = React.useState<TCountOfStatus<PurchaseOrderLineUrlEnum>>(null);

  const { data: countData, loading: countDataLoading } = usePurchaseOrderLineCountQuery({
    skip: !isListActionForFulfill,
    variables: {
      filter: {
        vendorId: null,
        poEventType: [PurchaseOrderEventTypeEnum.CONSIGNMENT, PurchaseOrderEventTypeEnum.CONSIGNMENT_TAKE_BACK],
        isB2b,
      },
    },
  });

  const refetchQueriesList: DocumentNode[] = [orderLineListQuery, purchaseOrderLineCountQuery];

  const isStaff = user?.isStaff;
  const queryVariables: OrderLineListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params, isB2b, location.pathname),
        isB2b,
        b2bStatus: isB2b ? [OrderLineB2bStatusEnum.RECEIVED] : null,
      },
      sort: { direction: OrderDirection.DESC, field: OrderLineSortField.NUMBER },
      forPurchase: isListActionForPurchase,
      forFulfill: isListActionForFulfill,
      forFulfilled: isListActionFulfilled,
      forB2b: isB2b || useDispatchFulfillmentModal,
    }),
    [params, settings?.rowNumber, location.pathname]
  );

  const { data, loading, refetch } = useOrderLineListQuery({
    variables: queryVariables,
  });
  const orderLineList = useMemo(() => maybe(() => data.orderLines.edges.map((edge) => edge.node), []), [data]);

  const [fulfillOrder, fulfillOrderOpts] = useOrderFulfillMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.orderFulfill.errors, "출고가 완료되었습니다."),
    refetchQueries: refetchQueriesList,
  });

  const [fulfillOrderBulk, fulfillOrderBulkOpts] = useOrderFulfillBulkMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.orderFulfillBulk.errors, "출고가 완료되었습니다."),
    refetchQueries: refetchQueriesList,
  });

  const [changeTrackInventoryOrderBulk, changeTrackInventoryOrderBulkOpts] =
    useOrderBulkChangeTrackInventoryBeforeMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.orderLineBulkChangeTrackInventoryBeforeFulfilled.errors,
          "출고유형 변경이 완료되었습니다."
        ),
      refetchQueries: refetchQueriesList,
    });

  const [changeTrackInventoryOrderBulkAfterFulfilled, changeTrackInventoryOrderBulkAfterFulfilledOpts] =
    useOrderBulkChangeTrackInventoryAfterMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.orderLineBulkChangeTrackInventoryAfterFulfilled.errors,
          "출고유형 변경이 완료되었습니다."
        ),
      refetchQueries: refetchQueriesList,
    });

  const [purchaseOrderLinesRevert, purchaseOrderLinesRevertOpts] = usePurchaseOrderLinesRevertMutation({
    refetchQueries: refetchQueriesList,
  });

  const [orderLinesB2bCancel, orderLinesB2bCancelOpts] = useOrderLinesB2bCancelMutation({
    onCompleted: (data) => {
      const errors = data.orderLinesB2bCancel.errors;
      if (errors.length === 0) {
        showNotificationSuccess("주문 취소가 완료되었습니다.");
        onModalClose(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: refetchQueriesList,
  });

  const handleLinesRevert = async (variables: PurchaseOrderLinesRevertVariables, message: string) => {
    const { data } = await purchaseOrderLinesRevert({
      variables,
    });
    const errors = data?.purchaseOrderLinesRevert?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess(`선택한 발주제품이 ${message} 처리 되었습니다.`);
      onModalClose(true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const windowTitle = checkIsListViewConsignment(orderLineListViewType)
    ? firstDepthMenuTitle.consignment
    : firstDepthMenuTitle.stock;

  const pageLoading =
    loading ||
    fulfillOrderOpts.loading ||
    fulfillOrderBulkOpts.loading ||
    changeTrackInventoryOrderBulkOpts.loading ||
    changeTrackInventoryOrderBulkAfterFulfilledOpts.loading ||
    purchaseOrderLinesRevertOpts.loading ||
    orderLinesB2bCancelOpts.loading;
  const selectedOrderLine = maybe(() => orderLineList.find((orderLine) => orderLine.id === params.id), null);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderLineListViewUrlDialog, OrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  React.useEffect(() => {
    if (countData) {
      setCountOfStatus(getStatusCount(countData, false));
    }
  }, [countDataLoading]);

  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setListElementKeys([]);
    }
  };

  const selectedRowExist = maybe(() => listElementKeys.length > 0);
  const selectedOrderLines = orderLineList.filter((orderLine) => listElementKeys.includes(orderLine.id));
  const selectedPoLines = selectedOrderLines.map((orderLine) => orderLine.purchaseOrderLine);
  const selectedPoLine = maybe(() => selectedOrderLine.purchaseOrderLine, null);

  useEffect(() => {
    if (!selectedRowExist && useDispatchFulfillmentModal) {
      closeModal();
    }
  }, [listElementKeys]);

  const revertModalConfig = getRevertModalInfo({ status: "dispatch-fulfillment" });
  return (
    <>
      <WindowTitle title={windowTitle} />
      <OrderLineListPage
        params={params}
        settings={settings}
        disabled={pageLoading}
        queryVariables={queryVariables}
        orderLines={orderLineList}
        onOrderNumberClick={(id) => navigate(orderDetailsViewUrl(id))}
        onPurchaseOrderNumberClick={(id) => navigate(purchaseOrderDetailsViewUrl(id))}
        onPurchaseOrderCreate={() =>
          navigate(
            isB2b
              ? b2bPurchaseOrderCreateViewUrl({ createType: "consignment" })
              : purchaseOrderCreateViewUrl({ createType: "consignment" })
          )
        }
        onFulfill={fulfillOrder}
        onFulfillBulk={fulfillOrderBulk}
        onSubmitChangeTrackInventory={changeTrackInventoryOrderBulk}
        onSubmitChangeTrackInventoryAfter={changeTrackInventoryOrderBulkAfterFulfilled}
        onConsignmentOrderLineUpdateVendor={(orderLineId) =>
          openModal("consignment-order-line-update-vendor", { id: orderLineId })
        }
        onDispatchFulfillment={() => openModal("dispatch-fulfillment")}
        onPoLineReqSplitDelivery={(orderLineId) => openModal("po-line-req-split-delivery", { id: orderLineId })}
        onClickOrderLineCancel={() => openModal("b2b-order-lines-cancel")}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, isB2b, location.pathname)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onRevertLinesModal={() => openModal("revert-lines")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        pageInfo={pageInfo}
        isStaff={isStaff}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        isB2b={isB2b}
        isFbv={false}
        setListElementKeys={setListElementKeys}
        listElementKeys={listElementKeys}
        isB2bPurchaseWriteListView={isB2bPurchaseWriteListView}
        ListNavigator={
          isListActionForFulfill
            ? () => (
                <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, PurchaseOrderLineUrlEnum>
                  skipQueryString
                  countOfStatus={countOfStatus}
                  urlList={navUrlList}
                  NavButtonName={getPurchaseOrderLineNavButtonName(false, isB2b)}
                />
              )
            : null
        }
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <OrderLineVendorUpdateModal
        open={params.action === "consignment-order-line-update-vendor" && !!selectedOrderLine}
        loading={pageLoading}
        orderLine={selectedOrderLine}
        onClose={closeModal}
      />
      {useDispatchFulfillmentModal && (
        <VsPurchaseOrderLinesDispatchFulfillmentModal
          open={params.action === "dispatch-fulfillment" && selectedRowExist}
          loading={loading}
          trackInventory={false} // 위탁 발주 부분이라 false로 고정
          poLines={selectedPoLines}
          orderLines={selectedOrderLines}
          onCancel={onModalClose}
          isB2b={isB2b}
          isByNonCourier={isByNonCourier}
        />
      )}
      <VsPurchaseOrderLineReqSplitDeliveryModal
        open={params.action === "po-line-req-split-delivery" && !!selectedPoLine}
        loading={loading}
        isApproveMode={false}
        poLine={selectedPoLine}
        onCancel={onModalClose}
      />
      {revertModalConfig !== null && (
        <>
          <PurchaseOrderRevertLinesModal
            open={params.action === "revert-lines" && selectedRowExist}
            revertModalConfig={revertModalConfig}
            handleLinesRevert={handleLinesRevert}
            onModalClose={() => onModalClose(false)}
            purchaseOrderLineIds={maybe(() => selectedPoLines.map((poLine) => poLine.id), [])}
          />
        </>
      )}
      <ConfirmModal
        visible={params.action === "b2b-order-lines-cancel" && selectedRowExist}
        onOk={() => orderLinesB2bCancel({ variables: { orderLineIds: listElementKeys } })}
        onCancel={closeModal}
        modalTitleText="주문 취소"
        helpText="정말 주문을 취소하시겠습니까? 취소된 주문은 복구할 수 없습니다."
      />
    </>
  );
};
