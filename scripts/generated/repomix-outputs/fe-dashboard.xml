    },
    fulfillmentCreated: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    fulfillmentShippingStartDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.deliveryStartDate.gte, filterVariables.deliveryStartDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.deliveryStartDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.deliveryStartDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    fulfillmentShippingEndDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.deliveryEndDate.gte, filterVariables.deliveryEndDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.deliveryEndDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.deliveryEndDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    deliveryStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.deliveryStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.deliveryStatus), []),
    },
    isNonFBV: {
      active: maybe(() => !utils.isEmpty(filterVariables.isFulfilledByVendor), false),
      value: maybe(() => filterVariables.isFulfilledByVendor === false, false),
    },
  };
}

export function getFilterVariables(params: HqOrderDeliveryListViewUrlFilters): FulfillmentFilterInput {
  return {
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    orderCapturedAtTime: getGteLteVariables({
      gte: params.orderCapturedAtTimeFrom,
      lte: params.orderCapturedAtTimeTo,
    }),
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    deliveryStartDate: getGteLteVariables({
      gte: params.deliveryStartDateFrom,
      lte: params.deliveryStartDateTo,
    }),
    deliveryEndDate: getGteLteVariables({
      gte: params.deliveryEndDateFrom,
      lte: params.deliveryEndDateTo,
    }),
    orderSearch: params.orderSearch,
    userSearch: params.userSearch,
    brandStoreSearch: params.brandStoreSearch,
    deliveryStatus: maybe(() =>
      params.deliveryStatus.map((status) => findInEnum(status, FulfillmentDeliveryStatusFilter))
    ),
    isFulfilledByVendor: params.isNonFBV !== undefined ? parseBoolean(params.isNonFBV, false) === false : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<HqOrderDeliveryFilterKeys>
): HqOrderDeliveryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqOrderDeliveryFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, HqOrderDeliveryListViewUrlFiltersEnum.orderSearch);
    case HqOrderDeliveryFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, HqOrderDeliveryListViewUrlFiltersEnum.userSearch);
    case HqOrderDeliveryFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, HqOrderDeliveryListViewUrlFiltersEnum.brandStoreSearch);
    case HqOrderDeliveryFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersEnum.orderCreatedFrom,
        HqOrderDeliveryListViewUrlFiltersEnum.orderCreatedTo
      );
    case HqOrderDeliveryFilterKeys.orderCapturedAtTime:
      return getMinMaxQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersEnum.orderCapturedAtTimeFrom,
        HqOrderDeliveryListViewUrlFiltersEnum.orderCapturedAtTimeTo
      );
    case HqOrderDeliveryFilterKeys.fulfillmentCreated:
      return getMinMaxQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersEnum.createdFrom,
        HqOrderDeliveryListViewUrlFiltersEnum.createdTo
      );
    case HqOrderDeliveryFilterKeys.fulfillmentShippingStartDate:
      return getMinMaxQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersEnum.deliveryStartDateFrom,
        HqOrderDeliveryListViewUrlFiltersEnum.deliveryStartDateTo
      );
    case HqOrderDeliveryFilterKeys.fulfillmentShippingEndDate:
      return getMinMaxQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersEnum.deliveryEndDateFrom,
        HqOrderDeliveryListViewUrlFiltersEnum.deliveryEndDateTo
      );
    case HqOrderDeliveryFilterKeys.deliveryStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqOrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.deliveryStatus,
        FulfillmentDeliveryStatusFilter
      );
    case HqOrderDeliveryFilterKeys.isNonFBV:
      return getSingleValueQueryParam(filter, HqOrderDeliveryListViewUrlFiltersEnum.isNonFBV);
  }
}

