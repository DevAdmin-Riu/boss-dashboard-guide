  };
  const trackInventoryFilter = {
    ...createBooleanField(
      0,
      PvEstimateListFilterKeys.trackInventory,
      "운영방식(재고/위탁)",
      opts.trackInventory.value,
      {
        negative: "위탁",
        positive: "재고",
      }
    ),
    active: opts.trackInventory.active,
  };
  const estimateDateFilter = {
    ...createDateField(0, PvEstimateListFilterKeys.estimateDate, "견적일", opts.estimateDate.value),
    active: opts.estimateDate.active,
  };

  const typeFilter = {
    ...createOptionsField(0, PvEstimateListFilterKeys.type, "견적구분", opts.type.value, true, [
