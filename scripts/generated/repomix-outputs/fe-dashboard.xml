<file path="src/app/views/requestProduct/components/ReqFbvProductListPage/utils.tsx">
import { RequestFbvProductStatus } from "@src/api/types/globalTypes";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { excelDownload, makeHeaderRowsAndMerges } from "@utils/excel/excelDownload";
import { transformIsFBV, transformIsFBVForHq } from "@utils/misc";
import { destroyDownloadingMessage, showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import moment from "moment";

import { RequestFbvProductList_requestFbvProductList_edges_node } from "../../api/types/RequestFbvProductList";

// TODO: 상품 요청 리스트 다운로드가 관리자 대시보드에서만 쓰이는 기능이라면, isStaff를 제거하고 fbvTag를 transformIsFBV(true)로 변경
export const handleClickExcelDownloadForHq = (
  dataSource: RequestFbvProductList_requestFbvProductList_edges_node[],
  isStaff: boolean
) => {
  try {
    const { rows, colsInfo, header, merges } = parseReqFbvProductListForHq(dataSource);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const fbvTag = isStaff ? transformIsFBV(true) : transformIsFBVForHq(true);
    const title = `${fbvTag} 상품 요청 리스트`;
    excelDownload({ title, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const parseReqFbvProductListForHq = (dataSource: RequestFbvProductList_requestFbvProductList_edges_node[]) => {
  const rows = [];

  dataSource.forEach((data) => {
    const createdAtDate = moment(data.createdAt).format(onlyDateFormat); // 요청일
    const lastChangedAtDate = moment(data.lastChangedAt).format(onlyDateFormat); // 최종 상태 변경일
    const status = getRequestFbvProductStatus(data.status); // 상태

    const defaultRows = {
      요청일: createdAtDate,
      "최종 상태 변경일": lastChangedAtDate,
      상태: status,
      상품명: data.productName,
      카테고리: data.category,
      규격: data.spec,
      재질: data.material,
      색상: data.color,
      입수량: data.qtyPerBox,
      공급사: data.vendor.name,
      "협력사 대표명": data.vendor.ceo,
      "협력사 사업자번호": data.vendor.bizRegNo,
      공급가: data.costPriceExcludeVat,
      소비자가: data.priceExcludeVat,
    };
    rows.push(defaultRows);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

export function getRequestFbvProductStatus(status: RequestFbvProductStatus) {
  switch (status) {
    case RequestFbvProductStatus.REQUESTED:
      return "접수";
    case RequestFbvProductStatus.REJECTED:
      return "반려";
    case RequestFbvProductStatus.COMPLETED:
      return "완료";
  }
}
</file>

