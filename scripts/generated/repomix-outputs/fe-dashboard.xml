    case RiuMinusProfitBpvListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, RiuMinusProfitBpvListViewUrlFiltersEnum.productSearch);
    case RiuMinusProfitBpvListFilterKeys.brandProductSearch:
