<file path="src/app/components/AssignBrandProductWithInfoDialog/AssignBrandProductWithInfoDialog.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { SearchProducts_search_edges_node } from "@src/api/searches/types/SearchProducts";
import { BrandAddProductWithInfoBPVInput, CategoryTypeEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getAssignBrandProductWithInfoDialogListTableSettings } from "@src/app/components/AssignBrandProductWithInfoDialog/AssignBrandProductWithInfoDialogListTableSettings";
import NumberComponent from "@src/app/components/Number";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { BrandAddProductWithInfoVariables } from "@src/app/views/brand/brands/api/types/BrandAddProductWithInfo";
import {
  convertBrandProductPriceToIncludeVat,
  getCategoryTypeText,
  makeProductQtyPerBoxText,
  makeProductSpecTextFromAttr,
} from "@src/app/views/product/products/utils/data";
import { FetchMoreProps, StrictOmit } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  findValueInEnum,
  transformIsExclusive,
  transformIsInner,
  transformTrackInventoryVariantType,
} from "@utils/misc";
import { utils } from "@utils/utils";
import {
  Col,
  Descriptions,
  Divider,
  Form,
  Input,
  InputNumber,
  Modal,
  Row,
  Space,
  Switch,
  Table,
  Typography,
} from "antd";
import React, { useEffect, useMemo, useState } from "react";

import { getTypeSafeForm } from "../antd/Form/utils";
import { commonTableProps } from "../antd/Table/TableProps";
import { columnNameConstant } from "../ColumnHelper/columnConstant";
import { PriceWithVatFormItem } from "../PriceWithVatFormItem";
import TableVatLegend from "../TableVat/TableVatLegend";
import { TextWithLink } from "../TextWithLink";

type TFormData = Pick<BrandAddProductWithInfoVariables, "brandProductInfo"> & {
  brandProductVariantsInfo: Record<
    string,
    StrictOmit<BrandAddProductWithInfoBPVInput, "deliveryFee" | "price"> & {
      priceExcludeVat: number;
      priceVat: number;
      costPriceExcludeVat: number;
      deliveryFeeExcludeVat: number;
    }
  >;
};
type TSubmitVariables = StrictOmit<BrandAddProductWithInfoVariables, "brandId" | "isFulfilledByVendor">;

interface AssignBrandProductWithInfoDialogProps extends FetchMoreProps {
  open: boolean;
  title?: string;
  enableForB2bService: boolean;
  products: SearchProducts_search_edges_node[];
  loading: boolean;
  // 직거래 상품 리스트에서 상품 추가 시, 일부 컬럼 미노출 하기 위해 전달 - 옵션명, 재고 운영, 옵션형 여부 컬럼 제외
  isFulfilledByVendor: boolean;
  onClose: () => void;
  onFetch: (value: string) => void;
  onSubmit: (variables: TSubmitVariables) => void;
}

const AssignBrandProductWithInfoDialog: React.FC<AssignBrandProductWithInfoDialogProps> = (props) => {
  const {
    title,
    hasMore,
    open,
    loading,
    products,
    isFulfilledByVendor,
    onClose,
    onFetch,
    onFetchMore,
    onSubmit,
    enableForB2bService,
  } = props;
  const [inputValue, setInputValue] = useState<string>(null);
  const [selectedProduct, setSelectedProduct] = useState<SearchProducts_search_edges_node | null>(null);
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);
  const selectedProductExists = !!selectedProduct && !!selectedProduct?.variants;
  // 개발비 제품은 비옵션형으로만 생성 가능(운영 정책)
  const isDevPv = selectedProductExists && selectedProduct?.variants[0].isDevPv;

  const handleClose = () => {
    setSelectedProduct(null);
    setInputValue(null);
    onFetch(null);
    onClose();
  };

  const handleSubmit = (formData: TFormData) => {
    const brandProductVariantsInfo: BrandAddProductWithInfoBPVInput[] = Object.keys(
      formData.brandProductVariantsInfo
    ).map((key) => {
      const { priceExcludeVat, priceVat, costPriceExcludeVat, deliveryFeeExcludeVat, ...restForm } =
        formData.brandProductVariantsInfo[key];
      const precision = selectedProduct?.variants[0].priceDecimalPlaces;
      const convPriceForm = convertBrandProductPriceToIncludeVat(
        formData.brandProductVariantsInfo[key],
        selectedProduct.isTaxFree,
        precision,
        enableForB2bService
      );
      const convForm = { ...restForm, ...convPriceForm };

      return {
        productVariantId: key,
        ...convForm,
        // forceNoNormalDisplay는 강제 미진열을 의미하므로 표시된 것을 반대로 뒤집어 줘야함.
        forceNoNormalDisplay: !formData.brandProductVariantsInfo[key].forceNoNormalDisplay,
        priceVat: formData.brandProductVariantsInfo[key].priceVat,
      };
    });

    const variables: TSubmitVariables = {
      productId: selectedProduct.id,
      brandProductInfo: { ...formData.brandProductInfo, isRcoinRewardForUsingPoint: isDevPv ? false : undefined },
      brandProductVariantsInfo,
    };

    onSubmit(variables);

    setSelectedProduct(null);
    handleClose();
  };

  const columns = getAssignBrandProductWithInfoDialogListTableSettings(
    isFulfilledByVendor,
    setSelectedProduct,
    enableForB2bService
  );
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const getProductSpecText = (product: SearchProducts_search_edges_node, index: number) => {
    const hasVariants = !!product?.productType?.hasVariants;
    const targetAttributes = hasVariants ? product.variants[index]?.attributes : product?.attributes;
    return makeProductSpecTextFromAttr(targetAttributes) || "-";
  };

  const filteredVariants = useMemo(
    () =>
      // variants의 outer id가 null이거나(outer라는 뜻) canSaleByInner가 true인 것만 필터링
      selectedProduct?.variants.filter((variant) => !variant?.outer || variant?.canSaleByInner) || [],
    [selectedProduct]
  );

  const getTransformedTrackInventoryVariantType = (product: SearchProducts_search_edges_node, index: number) => {
    const variant = product.variants[index];
    return transformTrackInventoryVariantType(variant?.trackInventory);
  };

  useEffect(() => {
    form.resetFields();
  }, [selectedProduct?.id]);

  return (
    <Modal
      forceRender
      destroyOnClose
      title={title || "제품 추가"}
      open={open}
      onCancel={handleClose}
      onOk={form.submit}
      okText="추가"
      okButtonProps={{ loading, disabled: !selectedProduct }}
      maskClosable={false}
      width={1200}
    >
      <Space direction="vertical">
        <Input.Search
          value={inputValue}
          onChange={(e) => setInputValue(e.target.value)}
          onSearch={() => onFetch(inputValue)}
          placeholder="제품코드 / 제품명 검색"
          loading={loading}
        />
        {products && (
          <Table
            {...commonTableProps}
            columns={columns}
            dataSource={products}
            scroll={{ x: tableWidthSum, y: selectedProductExists ? 200 : 500 }}
            footer={
              hasMore &&
              (() => (
                <Row justify="center">
                  <Typography.Link onClick={onFetchMore}>더 보기</Typography.Link>
                </Row>
              ))
            }
          />
        )}

        {selectedProductExists && <Divider />}
        <Form preserve={false} form={form} name="assign-brand-product-form" autoComplete="off" onFinish={handleSubmit}>
          {selectedProductExists && (
            <>
              <Row gutter={[12, 12]} justify="space-between">
                <Col span={12}>
                  <Form.Item
                    name={TypeSafeForm.getValidDataIndex("brandProductInfo.name")}
                    label="상품명"
                    initialValue={isDevPv ? selectedProduct.name : undefined}
                    rules={[{ required: true, message: formRuleMsg.required }]}
                  >
                    <Input disabled={isDevPv} />
                  </Form.Item>
                </Col>
                <Col span={12}>
                  <Form.Item
                    name={TypeSafeForm.getValidDataIndex("brandProductInfo.isExclusive")}
                    label="전용여부"
                    required={true}
                    initialValue={selectedProduct.isExclusive}
                    valuePropName={"checked"}
                  >
                    <Switch disabled={selectedProduct.isExclusive} />
                  </Form.Item>
                </Col>
              </Row>

              <Space direction="vertical" size={"large"}>
                {filteredVariants.map((variant) => {
                  const { isTaxFree } = selectedProduct;
                  const {
                    isInner,
                    trackInventory,
                    baseSellPriceExcludeVat,
                    baseSellPriceSetDate,
                    marketLowestPriceExcludeVat,
                    marketLowestPriceSetDate,
                    marketLowestPriceSource,
                  } = variant;
                  let costPriceExcludeVat: number;
                  let deliveryFeeExcludeVat: number;
                  let variantPriceExcludeVat: number;

                  if (isInner) {
                    // 이너박스 상품의 경우, (재고 판매) 협력사 매입가 + 판매 소분 비용
                    costPriceExcludeVat = variant?.costPriceExcludeVat;
                    deliveryFeeExcludeVat = toPriceExcludeVat(variant?.innerIncidentalCostAmount);
                  } else if (trackInventory) {
                    // 재고 운영 상품의 경우, 재고 판매 협력사 매입가 + 재고 판매 택배비
                    costPriceExcludeVat = variant?.costPriceExcludeVat;
                    deliveryFeeExcludeVat = toPriceExcludeVat(variant?.deliveryFeeAmount);
                  } else {
                    // 재고 미운영 상품의 경우, 위탁 판매 협력사 매입가 + 위탁 판매 택배비
                    costPriceExcludeVat = variant?.consignmentCostPriceExcludeVat;
                    deliveryFeeExcludeVat = toPriceExcludeVat(variant?.consignmentDeliveryFeeAmount);
                  }

                  if (utils.isEmpty(costPriceExcludeVat) || utils.isEmpty(deliveryFeeExcludeVat)) {
                    variantPriceExcludeVat = undefined;
                  }
                  variantPriceExcludeVat = costPriceExcludeVat + deliveryFeeExcludeVat;

                  return (
