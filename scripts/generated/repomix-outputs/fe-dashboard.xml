<file path="src/app/views/product/products/components/ProductListPage/utils.ts">
import { ApolloQueryResult } from "@apollo/client";
import { CategoryTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, newLineStr } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { ShopInfo_shop, ShopInfo_shop_stoppedReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { getBrandMdName, getBrandRunningTypeText } from "@src/app/views/brand/brands/utils";
import { makeHeaderRowsAndMerges, toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  findValueInEnum,
  transformAllowAutoConsignment,
  transformHasVariantType,
  transformIsExclusive,
  transformIsInner,
  transformSalesStatusByBrandProductVariant,
  transformSalesStatusByProductVariant,
  transformStoppedReason,
  transformTaxFree,
  transformTrackInventoryVariantType,
} from "@utils/misc";
import { utils } from "@utils/utils";

import { BpvListForUpload_brandProductVariants_edges_node } from "../../api/types/BpvListForUpload";
import {
  DownloadProductList,
  DownloadProductList_attributes_edges_node,
  DownloadProductList_brandProducts_edges_node,
  DownloadProductList_brandProducts_edges_node_brandProductVariants,
  DownloadProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions,
  DownloadProductList_brands_edges_node,
  DownloadProductList_categories_edges_node,
  DownloadProductList_collections_edges_node,
  DownloadProductList_products_edges_node,
  DownloadProductList_products_edges_node_variants,
  DownloadProductList_products_edges_node_variants_productVariantRegions,
  DownloadProductList_products_edges_node_variants_productVariantVendors,
  DownloadProductList_productTypes_edges_node,
  DownloadProductList_vendors_edges_node,
} from "../../api/types/DownloadProductList";
import { ProductVariantListForUpload_productVariants_edges_node } from "../../api/types/ProductVariantListForUpload";
import {
  convertBoxSpecText,
  convertPalletText,
  convertProductPriceToIncludeVat,
  defaultWeeklyDaysObject,
  getCategoryTypeText,
  getQtyPerBoxUnitTypeText,
  getSalesUnitTypeText,
} from "../../utils/data";
import { calcPackCount } from "../../utils/utils";
import {
  getVariantConsignmentCostPriceExcludeVat,
  getVariantConsignmentDeliveryFeeExcludeVat,
  getVariantCostPriceExcludeVat,
  getVariantDeliveryFeeExcludeVat,
  getVariantInnerIncidentalCostExcludeVat,
} from "./ProductListTableSettings";

const defaultStrValue = "-";
const defaultNumValue = 0;

export const makePrefixForProductPrice = (trackInventory: boolean) => (trackInventory ? "재고 판매" : "위탁 판매");

export const convertToDaysObject = (value: string) => {
  if (!value) {
    return defaultWeeklyDaysObject;
  }

  const daysObject = { ...defaultWeeklyDaysObject };
  const selectedDayStringArr = value?.split(",").map((dayString) => dayString.trim());
  selectedDayStringArr.forEach((dayString) => {
    switch (dayString) {
      case "월":
        daysObject.monday = true;
        break;
      case "화":
        daysObject.tuesday = true;
        break;
      case "수":
        daysObject.wednesday = true;
        break;
      case "목":
        daysObject.thursday = true;
        break;
      case "금":
        daysObject.friday = true;
        break;
      case "토":
        daysObject.saturday = true;
        break;
      default:
        break;
    }
  });

  return daysObject;
};

export const convertUploadValuesToIncludeVat = (
  details: any[],
  productVariants: ProductVariantListForUpload_productVariants_edges_node[],
  // 제품 정보 위한 업로드인지 - 제품인 경우, 위탁 판매 배송비, 소분 판매 비용 포함하여 반환
  forProduct: boolean = false
) => {
  for (const detail of details) {
    const findProductVariant = productVariants?.find((variant) => variant?.sku === detail.productSku);
    const isTaxFree = findProductVariant?.product?.isTaxFree;
    const precision = findProductVariant?.priceDecimalPlaces;
    const defaultForm = {
      priceExcludeVat: detail.priceExcludeVat,
      costPriceExcludeVat: detail.costPriceExcludeVat,
      deliveryFeeExcludeVat: detail.deliveryFeeExcludeVat,
    };
    const formToConv = forProduct
      ? {
          ...defaultForm,
          consignmentDeliveryFeeExcludeVat: detail.consignmentDeliveryFeeExcludeVat,
          innerIncidentalCostExcludeVat: detail.innerIncidentalCostExcludeVat,
        }
      : defaultForm;

    const convForm = convertProductPriceToIncludeVat(formToConv, isTaxFree, precision);
    detail.price = convForm.price;
    detail.deliveryFee = convForm.deliveryFeeAmount;
    if (forProduct) {
      detail.consignmentDeliveryFee = convForm.consignmentDeliveryFee;
      detail.innerIncidentalCost = convForm.innerIncidentalCost;
    }
  }
  return details;
};

export const convertBpvUploadValuesToIncludeVat = (
  details: any[],
  bpvs: BpvListForUpload_brandProductVariants_edges_node[]
) => {
  for (const detail of details) {
    const findBpv = bpvs?.find((bpv) => bpv?.bpSku === detail.bpSku);
    const findProductVariant = findBpv?.productVariant;
    const isTaxFree = findProductVariant?.product?.isTaxFree;
    const precision = findProductVariant?.priceDecimalPlaces;
    const defaultForm = {
      priceExcludeVat: detail.priceExcludeVat,
      costPriceExcludeVat: detail.costPriceExcludeVat,
      deliveryFeeExcludeVat: detail.deliveryFeeExcludeVat,
    };

    const convForm = convertProductPriceToIncludeVat(defaultForm, isTaxFree, precision);
    detail.price = convForm.price;
    detail.deliveryFee = convForm.deliveryFeeAmount;
  }
  return details;
};

const productKeysToMerge = {
  product: "[제품]",
  classification: "[제품 분류]",
  price: "[공급원가 정보]",
  baseSellPrice: "[기준 판매가 정보]",
  vendor: "[제품 협력사 정보]",
  brand: "[판매브랜드 정보]",
};

// 제품 리스트 다운로드 모듈
// NOTE: 직거래 상품 리스트 다운로드인 경우, 제외할 컬럼: 옵션명, 재고운영, 자동위탁, 제품형태, 박스타입(재고), 옵션형 여부, 전용여부(판매브랜드 정보의 전용여부)
export const parseProductList = (
  resProductList: ApolloQueryResult<DownloadProductList>,
  shopData: ShopInfo_shop,
  includeBrandInfo: boolean,
  isFulfilledByVendor: boolean
) => {
  const { attributes, categories, collections, productTypes, vendors, brands, products, brandProducts } =
    resProductList.data;
  const { stoppedReasonChoices } = shopData;
  const attributeList = attributes.edges.map((edge) => edge.node);
  const categoryList = categories.edges.map((edge) => edge.node);
  const collectionList = collections.edges.map((edge) => edge.node);
  const productTypeList = productTypes.edges.map((edge) => edge.node);
  const vendorList = vendors.edges.map((edge) => edge.node);
  const brandList = includeBrandInfo ? brands.edges.map((edge) => edge.node) : [];
  const productList = products.edges.map((edge) => edge.node);
  const brandProductList = includeBrandInfo ? brandProducts.edges.map((edge) => edge.node) : [];

  let rowNum: number = 1;
  const columns = [];
  productList.forEach((product) => {
    product.variants.forEach((productVariant) => {
      // 1. 제품의 옵션(productVariant) 단위로 '제품', '제품 분류', '공급원가 정보' 컬럼 생성(직배송 제품인 경우, 공급원가 정보 컬럼만 productVariantRegions 단위로 별도 생성)
      const { isInner, productVariantVendors } = productVariant;
      const productColumn = makeProductColumn(
        stoppedReasonChoices,
        product,
        productVariant,
        attributeList,
        isFulfilledByVendor
      );
      const classificationColumn = makeClassificationColumn(
        product,
        productTypeList,
        categoryList,
        collectionList,
        isFulfilledByVendor
      );
      const priceColumn = makePriceColumn(null, null, productVariant, isFulfilledByVendor);
      const baseSellPriceColumn = makeBaseSellPriceColumn(productVariant);

      // 2. 제품 옵션에서 협력사 정보가 연동된 협력사마다 '제품 협력사 정보' 컬럼 생성 - 연동된 협력사가 없다면 null로 컬럼 생성
      // 이너박스 제품인 경우, 아우터박스 제품의 협력사 정보로 세팅
      const variantVendorsByIsInner =
        isInner === false
          ? productVariantVendors
          : product.variants.find((variant) => variant.id === productVariant.outer.id)?.productVariantVendors;
      const productVariantVendorsIncludeDefault =
        variantVendorsByIsInner && variantVendorsByIsInner.length > 0 ? variantVendorsByIsInner : [null];
      productVariantVendorsIncludeDefault.forEach((productVariantVendor) => {
        const variantVendorColumn = makeVariantVendorColumn(
          productVariant,
          productVariantVendor,
          vendorList,
          isFulfilledByVendor
        );

        // 브랜드 정보 포함하여 다운로드 시, 판매 브랜드 컬럼까지 함께 생성
        if (includeBrandInfo) {
          const brandProducts = brandProductList.filter((brandProduct) => brandProduct.productId === product.id) || [];
          // 3. 브랜드 상품 옵션(brandProductVariant) 정보가 연동된 브랜드 상품마다 '판매브랜드 정보' 컬럼 생성 - 연동된 브랜드 상품이 없다면 null로 컬럼 생성
          const brandProductsIncludeDefault = brandProducts.length > 0 ? brandProducts : [null];
          brandProductsIncludeDefault.forEach((brandProduct) => {
            if (utils.isEmpty(brandProduct)) {
              // 3-1. 연동된 브랜드 상품이 없다면 null로 컬럼 생성
              const brandColumn = makeBrandColumn(stoppedReasonChoices, null, null, null, isFulfilledByVendor);

              const mergedColumn = {
                No: rowNum,
                ...productColumn,
                ...classificationColumn,
                ...variantVendorColumn,
                ...priceColumn,
                ...baseSellPriceColumn,
                ...brandColumn,
              };
              columns.push(mergedColumn);
              rowNum++;
            } else {
              const { brandId, brandProductVariants } = brandProduct;
              const brand = brandList.find((brand) => brand.id === brandId);
              const brandProductVariant = brandProductVariants.find(
                (brandProductVariant) => brandProductVariant.variantId === productVariant.id
              );
              // 3-2. 연동된 브랜드 상품이 포장재 상품인 경우, 일반 가격 컬럼 및 브랜드 컬럼 적용
              const brandColumn = makeBrandColumn(
                stoppedReasonChoices,
                brand,
                brandProduct,
                brandProductVariant,
                isFulfilledByVendor
              );

              const mergedColumn = {
                No: rowNum,
                ...productColumn,
                ...classificationColumn,
                ...variantVendorColumn,
                ...priceColumn,
                ...baseSellPriceColumn,
                ...brandColumn,
              };
              columns.push(mergedColumn);
              rowNum++;
            }
          });
        } else {
          // 브랜드 정보 미포함하여 다운로드 시, 판매 브랜드 컬럼 없이 출력
          const mergedColumn = {
            No: rowNum,
            ...productColumn,
            ...classificationColumn,
            ...variantVendorColumn,
            ...priceColumn,
            ...baseSellPriceColumn,
          };
          columns.push(mergedColumn);
          rowNum++;
        }
      });
    });
  });

  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  const colsInfo = columns.length > 0 ? Object.keys(columns[0]).map(() => ({ wch: 10 })) : [];
  return { columns, colsInfo, header, merges };
};

const makeProductColumn = (
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[],
  product: DownloadProductList_products_edges_node,
  productVariant: DownloadProductList_products_edges_node_variants,
  attributeList: DownloadProductList_attributes_edges_node[],
  isFulfilledByVendor: boolean
): { [key: string]: string | number } => {
  const { name: productName, isTaxFree, isExclusive } = product;
  const {
    sku,
    name: variantName,
    trackInventory,
    salesStatus,
    stoppedAt,
    stoppedReason,
    stoppedReasonEtc,
    isInner,
    qtyPerBox,
    qtyPerBoxUnitType,
    salesUnitType,
    boxLength,
    boxWidth,
    boxHeight,
    palletM,
    palletN,
    palletO,
    poLeadTime,
    maker,
    priorityLevel,
  } = productVariant;

  const productColumn: { [key: string]: string | number } = {};
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.SKU)] = sku;
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.PRODUCT_NAME)] = productName;
  if (!isFulfilledByVendor) {
    productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.VARIANT_NAME)] =
      variantName || defaultStrValue;
  }
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.IS_EXCLUSIVE)] =
    transformIsExclusive(isExclusive);
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.stock.PRIORITY_LEVEL)] = priorityLevel;
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.SALES_STATUS)] =
    transformSalesStatusByProductVariant(salesStatus);
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.STOPPED_DATE)] = getDateByFormat(
    stoppedAt,
    onlyDateFormat
  );
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.STOPPED_REASON)] =
    transformStoppedReason(stoppedReasonChoices, stoppedReason, stoppedReasonEtc);
  if (!isFulfilledByVendor) {
    productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.TRACK_INVENTORY)] =
      transformTrackInventoryVariantType(trackInventory);
    productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.ALLOW_AUTO_CONSIGNMENT)] =
      transformAllowAutoConsignment(productVariant);
  }
  productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.IS_TAX_FREE)] =
    transformTaxFree(isTaxFree);
  if (!isFulfilledByVendor) {
    productColumn[productKeysToMerge.product + newLineStr(columnNameConstant.product.IS_INNER)] =
      transformIsInner(isInner);
  }

  const qtyPerBoxUnitTypeText = getQtyPerBoxUnitTypeText(qtyPerBoxUnitType);
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.product.PRODUCT_QTY_PER_BOX}`] =
    `${qtyPerBox}${qtyPerBoxUnitTypeText}` || defaultNumValue;

  attributeList.forEach((attribute) => {
    if (isFulfilledByVendor && attribute.name === "박스타입(재고)") {
      return;
    }

    const productAttribute = product.attributes.find(
      (productAttribute) => productAttribute.attribute.id === attribute.id
    );
    const variantForAttr =
      isInner === false ? productVariant : product.variants.find((variant) => variant.id === productVariant.outer.id);
    const variantAttribute = variantForAttr.attributes.find(
      (selectedAttribute) => selectedAttribute.attribute.id === attribute.id
    );
    const targetAttribute = productAttribute || variantAttribute;
    const attrValue = targetAttribute?.values[0]?.name || defaultStrValue;
    productColumn[`${productKeysToMerge.product}\n${attribute.name}`] = attrValue;
  });

  const salesUnitTypeText = getSalesUnitTypeText(salesUnitType);
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.product.SALES_UNIT_TYPE}`] =
    salesUnitTypeText || defaultNumValue;
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.product.BOX_SIZE_MM}`] = convertBoxSpecText([
    boxLength,
    boxWidth,
    boxHeight,
  ]);
  productColumn[`${productKeysToMerge.product}\n적재구성`] = convertPalletText([
    utils.isEmpty(palletM) ? 0 : palletM,
    utils.isEmpty(palletN) ? 0 : palletN,
    utils.isEmpty(palletO) ? 0 : palletO,
  ]);
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.common.LEAD_TIME}`] =
    poLeadTime || defaultNumValue;
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.vendor.MAKER_CODE}`] =
    maker?.code || defaultStrValue;
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.vendor.MAKER_NAME}`] =
    maker?.name || defaultStrValue;
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.product.PRICE_DECIMAL_PLACES}`] =
    productVariant?.priceDecimalPlaces || defaultNumValue;
  productColumn[`${productKeysToMerge.product}\n${columnNameConstant.product.ORDER_QTY_DECIMAL_PLACES}`] =
    productVariant?.orderQtyDecimalPlaces || defaultNumValue;
  return productColumn;
};

const makeClassificationColumn = (
  product: DownloadProductList_products_edges_node,
  productTypeList: DownloadProductList_productTypes_edges_node[],
  categoryList: DownloadProductList_categories_edges_node[],
  collectionList: DownloadProductList_collections_edges_node[],
  isFulfilledByVendor: boolean
): { [key: string]: string | number } => {
  const productType = productTypeList.find((productType) => productType.id === product.productTypeId);
  const category = categoryList.find((category) => category.id === product.categoryId);
  const parentCategory = category?.parent;
  const middleCategory = utils.isEmpty(parentCategory) ? category : parentCategory;
  const smallCategory = utils.isEmpty(parentCategory) ? null : category;
  const collection = collectionList.find((collection) => {
    const collectionProductIds = collection.allProducts.edges.map((edge) => edge.node.id);
    return collectionProductIds.includes(product.id);
  });

  const classificationColumn: { [key: string]: string | number } = {};
  classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.PRODUCT_TYPE_NAME)] =
    productType?.name || defaultStrValue;
  if (!isFulfilledByVendor) {
    classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.HAS_VARIANTS)] =
      transformHasVariantType(productType?.hasVariants) || defaultStrValue;
  }
  classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.FIRST_CATEGORY)] =
    getCategoryTypeText(findValueInEnum(category?.type, CategoryTypeEnum));
  classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.SECOND_CATEGORY)] =
    middleCategory?.name || defaultStrValue;
  classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.THIRD_CATEGORY)] =
    smallCategory?.name || defaultStrValue;
  classificationColumn[productKeysToMerge.classification + newLineStr(columnNameConstant.product.COLLECTION)] =
    collection?.name || defaultStrValue;

  return classificationColumn;
};

// 직거래 상품 리스트 다운로드 시, 협력사 매입가 값만 노출 + 컬럼명은 '보스 외 협력사 매입가'로 변경
const makePriceColumn = (
  regionName: string,
  leadTime: number,
  productVariantOrRegion:
    | DownloadProductList_products_edges_node_variants
    | DownloadProductList_products_edges_node_variants_productVariantRegions,
  isFulfilledByVendor: boolean
): { [key: string]: string | number } => {
  const prefixForTrackInventoryPrice = makePrefixForProductPrice(true);
  const prefixForConsignmentPrice = makePrefixForProductPrice(false);
  const priceColumn: { [key: string]: string | number } = {};

  const trackInventoryCostPriceColName =
    productKeysToMerge.price +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.product.VENDOR_COST_PRICE(true, "\n"));
  const trackInventoryDeliveryFeeColName =
    productKeysToMerge.price +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.product.CONSIGNMENT_DELIVERY_FEE(true, "\n"));
  const trackInventoryPriceColName =
    productKeysToMerge.price +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.product.COST_PRICE(true, "\n"));
  const consignmentCostPriceColName =
    productKeysToMerge.price +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.product.VENDOR_COST_PRICE(false)) +
    (isFulfilledByVendor ? "" : newLineStr("(ⓒ)"));
  const consignmentDeliveryFeeColName =
    productKeysToMerge.price +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.product.CONSIGNMENT_DELIVERY_FEE(false)) +
    newLineStr("(ⓓ)");
  const consignmentPriceColName =
    productKeysToMerge.price +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.product.COST_PRICE(false)) +
    newLineStr("(ⓒ+ⓓ)");
  const innerIncidentalCostColName =
    productKeysToMerge.price +
    newLineStr("(이너박스 전용)") +
    newLineStr(columnNameConstant.product.VARIANT_INNER_INCIDENTAL_COST(false)) +
    newLineStr("(ⓔ)");
  const innerPriceColName =
    productKeysToMerge.price +
    newLineStr("(이너박스 전용)") +
    newLineStr("이너박스 " + columnNameConstant.product.COST_PRICE(false)) +
    newLineStr("(ⓐ+ⓔ)");

  if (utils.isEmpty(productVariantOrRegion)) {
    if (!isFulfilledByVendor) {
      priceColumn[productKeysToMerge.price + newLineStr(columnNameConstant.user.REGION)] =
        regionName || defaultStrValue;
      priceColumn[productKeysToMerge.price + newLineStr(columnNameConstant.common.LEAD_TIME)] =
        leadTime || defaultNumValue;
      priceColumn[trackInventoryCostPriceColName] = defaultNumValue;
      priceColumn[trackInventoryDeliveryFeeColName] = defaultNumValue;
      priceColumn[trackInventoryPriceColName] = defaultNumValue;
    }
    priceColumn[consignmentCostPriceColName] = defaultNumValue;
    if (!isFulfilledByVendor) {
      priceColumn[consignmentDeliveryFeeColName] = defaultNumValue;
      priceColumn[consignmentPriceColName] = defaultNumValue;
      priceColumn[innerIncidentalCostColName] = defaultNumValue;
      priceColumn[innerPriceColName] = defaultNumValue;
    }
    return priceColumn;
  }

  const checkIsProductVariant = (
    pvr:
      | DownloadProductList_products_edges_node_variants
      | DownloadProductList_products_edges_node_variants_productVariantRegions
  ): pvr is DownloadProductList_products_edges_node_variants => true;

  if (!isFulfilledByVendor) {
    priceColumn[productKeysToMerge.price + newLineStr(columnNameConstant.user.REGION)] = regionName || defaultStrValue;
    priceColumn[productKeysToMerge.price + newLineStr(columnNameConstant.common.LEAD_TIME)] =
      leadTime || defaultNumValue;
  }

  const isProductVariant = checkIsProductVariant(productVariantOrRegion);
  if (isProductVariant) {
    const costPriceExcludeVat = getVariantCostPriceExcludeVat(productVariantOrRegion);
    const deliveryFeeExcludeVat = getVariantDeliveryFeeExcludeVat(productVariantOrRegion);
    const consignmentCostPriceExcludeVat = getVariantConsignmentCostPriceExcludeVat(productVariantOrRegion);
    const consignmentDeliveryFeeExcludeVat = getVariantConsignmentDeliveryFeeExcludeVat(productVariantOrRegion);
    const innerIncidentalCostExcludeVat = getVariantInnerIncidentalCostExcludeVat(productVariantOrRegion);
    if (!isFulfilledByVendor) {
      // 협력사 매입가(A)
      priceColumn[trackInventoryCostPriceColName] = costPriceExcludeVat;
      // 직접판매 시 택배비(B)
      priceColumn[trackInventoryDeliveryFeeColName] = deliveryFeeExcludeVat;
      // 직접판매 시 공급원가(A+B)
      priceColumn[trackInventoryPriceColName] = costPriceExcludeVat + deliveryFeeExcludeVat;
    }
    // 위탁판매 시 협력사 매입가(C)
    priceColumn[consignmentCostPriceColName] = consignmentCostPriceExcludeVat;
    if (!isFulfilledByVendor) {
      // 위탁판매 시 택배비(D)
      priceColumn[consignmentDeliveryFeeColName] = consignmentDeliveryFeeExcludeVat;
      // 위탁판매 시 공급원가(C+D)
      priceColumn[consignmentPriceColName] = consignmentCostPriceExcludeVat + consignmentDeliveryFeeExcludeVat;
      // 이너박스 제품 소분판매비용(E)
      priceColumn[innerIncidentalCostColName] = innerIncidentalCostExcludeVat;
      // 이너박스 제품 공급원가(A+E)
      priceColumn[innerPriceColName] = productVariantOrRegion.isInner
        ? costPriceExcludeVat + innerIncidentalCostExcludeVat
        : 0;
    }
  } else {
    const { costPriceExcludeVat, deliveryFeeAmount } = productVariantOrRegion;
    const deliveryFeeExcludeVat = toPriceExcludeVat(deliveryFeeAmount);
    // NOTE: 직배송 제품에 대한 관리가 필요해지면, 아래 로직 및 값을 변경해야 함(재고/위탁 판매 가격 분리 이전에 직배송 제품을 사용했기 때문에, 다시 사용할 경우 위탁 판매 관련 금액을 활성화 해야 할 것임)
    if (!isFulfilledByVendor) {
      // 직배송 협력사 매입가(A)
      priceColumn[trackInventoryCostPriceColName] = costPriceExcludeVat;
      // 직배송 택배비(B)
      priceColumn[trackInventoryDeliveryFeeColName] = deliveryFeeExcludeVat;
      // 직배송 공급원가(A+B)
      priceColumn[trackInventoryPriceColName] = costPriceExcludeVat + deliveryFeeExcludeVat;
    }
    priceColumn[consignmentCostPriceColName] = defaultNumValue;
    if (!isFulfilledByVendor) {
      priceColumn[consignmentDeliveryFeeColName] = defaultNumValue;
      priceColumn[consignmentPriceColName] = defaultNumValue;
      priceColumn[innerIncidentalCostColName] = defaultNumValue;
      priceColumn[innerPriceColName] = defaultNumValue;
    }
  }
  return priceColumn;
};

const makeBaseSellPriceColumn = (
  productVariant: DownloadProductList_products_edges_node_variants
): { [key: string]: string | number } => {
  const baseSellPriceColumn: { [key: string]: string | number } = {};
  const {
    baseSellPriceExcludeVat,
    baseSellPriceSetDate,
    marketLowestPriceExcludeVat,
    marketLowestPriceSetDate,
    marketLowestPriceSource,
  } = productVariant;
  baseSellPriceColumn[productKeysToMerge.baseSellPrice + newLineStr(columnNameConstant.product.BASE_SELL_PRICE)] =
    baseSellPriceExcludeVat;
  baseSellPriceColumn[
    productKeysToMerge.baseSellPrice +
      newLineStr(columnNameConstant.product.BASE_SELL_PRICE) +
      newLineStr(columnNameConstant.common.SET_DATE)
  ] = getDateByFormat(baseSellPriceSetDate, onlyDateFormat);
  baseSellPriceColumn[productKeysToMerge.baseSellPrice + newLineStr(columnNameConstant.product.MARKET_LOWEST_PRICE)] =
    marketLowestPriceExcludeVat;
  baseSellPriceColumn[
    productKeysToMerge.baseSellPrice +
      newLineStr(columnNameConstant.product.MARKET_LOWEST_PRICE) +
      newLineStr(columnNameConstant.common.SET_DATE)
  ] = getDateByFormat(marketLowestPriceSetDate, onlyDateFormat);
  baseSellPriceColumn[
    productKeysToMerge.baseSellPrice +
      newLineStr(columnNameConstant.product.MARKET_LOWEST_PRICE) +
      newLineStr(columnNameConstant.common.SOURCE)
  ] = marketLowestPriceSource || defaultStrValue;
  return baseSellPriceColumn;
};

// 직거래 상품 리스트 다운로드 시, 재고 판매 금액 컬럼은 제외 + 위탁 판매 금액 컬럼명은 '보스 외 ~'로 변경
const makeVariantVendorColumn = (
  productVariant: DownloadProductList_products_edges_node_variants,
  productVariantVendor: DownloadProductList_products_edges_node_variants_productVariantVendors,
  vendorList: DownloadProductList_vendors_edges_node[],
  isFulfilledByVendor: boolean
): { [key: string]: string | number } => {
  const prefixForTrackInventoryPrice = makePrefixForProductPrice(true);
  const prefixForConsignmentPrice = makePrefixForProductPrice(false);
  const vendorColumn: { [key: string]: string | number } = {};

  const isDefaultColName = productKeysToMerge.vendor + newLineStr("기본값");
  const vendorCodeColName = productKeysToMerge.vendor + newLineStr(columnNameConstant.vendor.CODE);
  const vendorNameColName = productKeysToMerge.vendor + newLineStr(columnNameConstant.vendor.VENDOR_NAME);
  const externalSkuColName = productKeysToMerge.vendor + newLineStr(columnNameConstant.vendor.EXTERNAL_SKU);
  const productPriceColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_PRICE(true, "\n"));
  const deliveryFeeColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_DELIVERY_FEE(true, "\n"));
  const costPriceColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForTrackInventoryPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_COST_PRICE(true, "\n"));
  const consignmentProductPriceColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_PRICE(isFulfilledByVendor)) +
    (isFulfilledByVendor ? "" : newLineStr("(ⓒ)"));
  const consignmentDeliveryFeeColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_DELIVERY_FEE(isFulfilledByVendor)) +
    (isFulfilledByVendor ? "" : newLineStr("(ⓓ)"));
  const consignmentCostPriceColName =
    productKeysToMerge.vendor +
    newLineStr(prefixForConsignmentPrice) +
    newLineStr(columnNameConstant.purchaseOrder.VENDOR_COST_PRICE(isFulfilledByVendor)) +
    (isFulfilledByVendor ? "" : newLineStr("(ⓒ+ⓓ)"));
  const moqColName = productKeysToMerge.vendor + newLineStr(columnNameConstant.purchaseOrder.PO_MOQ);

  if (utils.isEmpty(productVariantVendor)) {
    vendorColumn[isDefaultColName] = defaultStrValue;
    vendorColumn[vendorCodeColName] = defaultStrValue;
    vendorColumn[vendorNameColName] = defaultStrValue;
    vendorColumn[externalSkuColName] = defaultStrValue;
    if (!isFulfilledByVendor) {
      vendorColumn[productPriceColName] = defaultNumValue;
      vendorColumn[deliveryFeeColName] = defaultNumValue;
      vendorColumn[costPriceColName] = defaultNumValue;
    }
    vendorColumn[consignmentProductPriceColName] = defaultNumValue;
    vendorColumn[consignmentDeliveryFeeColName] = defaultNumValue;
    vendorColumn[consignmentCostPriceColName] = defaultNumValue;
    vendorColumn[moqColName] = defaultNumValue;
    return vendorColumn;
  }

  const { isInner, outer, defaultVariantVendor } = productVariant;
  const {
    id,
    vendorId,
    externalSku,
    productPriceExcludeVat: outerProductPriceExcludeVat,
    deliveryFeeExcludeVat: outerDeliveryFeeExcludeVat,
    consignmentProductPriceExcludeVat: outerConsignmentProductPriceExcludeVat,
    consignmentDeliveryFeeExcludeVat: outerConsignmentDeliveryFeeExcludeVat,
    moq,
  } = productVariantVendor;
  const isDefaultVariantVendor = defaultVariantVendor?.id === id;
  const vendor = vendorList.find((vendor) => vendor.id === vendorId);
  // 이너박스 제품이면 아우터박스 제품의 가격을 제품의 입수량으로 나누어 계산
  const packCount = isInner ? calcPackCount(outer, productVariant) : 1;
  const productPriceExcludeVat = Math.round(outerProductPriceExcludeVat / packCount);
  const deliveryFeeExcludeVat = Math.round(outerDeliveryFeeExcludeVat / packCount);
  const consignmentProductPriceExcludeVat = Math.round(outerConsignmentProductPriceExcludeVat / packCount);
  const consignmentDeliveryFeeExcludeVat = Math.round(outerConsignmentDeliveryFeeExcludeVat / packCount);

  vendorColumn[isDefaultColName] = isDefaultVariantVendor ? "기본" : defaultStrValue;
  vendorColumn[vendorCodeColName] = vendor?.code || defaultStrValue;
  vendorColumn[vendorNameColName] = vendor?.name || defaultStrValue;
  vendorColumn[externalSkuColName] = externalSku || defaultStrValue;
  if (!isFulfilledByVendor) {
    vendorColumn[productPriceColName] = productPriceExcludeVat;
    vendorColumn[deliveryFeeColName] = deliveryFeeExcludeVat;
    vendorColumn[costPriceColName] = productPriceExcludeVat + deliveryFeeExcludeVat;
  }
  vendorColumn[consignmentProductPriceColName] = consignmentProductPriceExcludeVat;
  vendorColumn[consignmentDeliveryFeeColName] = consignmentDeliveryFeeExcludeVat;
  vendorColumn[consignmentCostPriceColName] = consignmentProductPriceExcludeVat + consignmentDeliveryFeeExcludeVat;
  vendorColumn[moqColName] = moq || defaultNumValue;
  return vendorColumn;
};

// 직거래 상품 리스트 다운로드 시, 브랜드 배송비와 브랜드 판매가 컬럼은 제외 + 브랜드 상품가 컬럼명은 '상품 본부 판매가'로 변경
const makeBrandColumn = (
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[],
  brand: DownloadProductList_brands_edges_node,
  brandProduct: DownloadProductList_brandProducts_edges_node,
  brandProductVariantOrRegion:
    | DownloadProductList_brandProducts_edges_node_brandProductVariants
    | DownloadProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions,
  isFulfilledByVendor: boolean
): { [key: string]: string | number } => {
  const brandColumn: { [key: string]: string | number } = {};
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_CODE)] =
    brand?.code || defaultStrValue;
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_NAME)] =
    brand?.name || defaultStrValue;
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.IS_RUNNING)] = getBrandRunningTypeText(
    brand?.isRunning
  );
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.MD_IN_CHARGE)] = getBrandMdName(
    brand?.staff
  );

  // utils.isEmpty(brandProduct) -> 제품 리스트 다운로드 시, 브랜드 상품(brandProduct) 정보가 없으면 빈 브랜드 컬럼으로 반환하기 위한 조건
  const brandCostPriceColName = isFulfilledByVendor
    ? columnNameConstant.brandProduct.BRAND_PRODUCT_PRICE_FOR_FBV
    : columnNameConstant.brandProduct.BRAND_PRODUCT_PRICE.join("\n");
  if (utils.isEmpty(brandProduct) || utils.isEmpty(brandProductVariantOrRegion)) {
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.SALE_STATUS)] = defaultStrValue;
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.STOPPED_DATE)] = defaultStrValue;
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.STOPPED_REASON)] =
      defaultStrValue;
    if (!isFulfilledByVendor) {
      brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.IS_EXCLUSIVE)] = defaultStrValue;
    }
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE)] =
      defaultNumValue;
    brandColumn[productKeysToMerge.brand + newLineStr(brandCostPriceColName)] = defaultNumValue;
    if (!isFulfilledByVendor) {
      brandColumn[
        productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_DELIVERY_FEE.join("\n"))
      ] = defaultNumValue;
      brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_SALE_PRICE.join("\n"))] =
        defaultNumValue;
    }
    return brandColumn;
  }
  const { isExclusive } = brandProduct;
  const {
    priceAmount,
    priceVat,
    costPriceExcludeVat,
    deliveryFeeAmount,
    salesStatus,
    stoppedAt,
    stoppedReason,
    stoppedReasonEtc,
  } = brandProductVariantOrRegion;
  const priceExcludeVat = priceAmount - priceVat;
  const deliveryFeeExcludeVat = toPriceExcludeVat(deliveryFeeAmount);

  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.SALE_STATUS)] =
    transformSalesStatusByBrandProductVariant(salesStatus);
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.STOPPED_DATE)] = getDateByFormat(
    stoppedAt,
    onlyDateFormat
  );
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.STOPPED_REASON)] =
    transformStoppedReason(stoppedReasonChoices, stoppedReason, stoppedReasonEtc);
  if (!isFulfilledByVendor) {
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brand.IS_EXCLUSIVE)] =
      transformIsExclusive(isExclusive);
  }
  brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE)] =
    priceExcludeVat;
  brandColumn[productKeysToMerge.brand + newLineStr(brandCostPriceColName)] = costPriceExcludeVat;
  if (!isFulfilledByVendor) {
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_DELIVERY_FEE.join("\n"))] =
      deliveryFeeExcludeVat;
    brandColumn[productKeysToMerge.brand + newLineStr(columnNameConstant.brandProduct.BRAND_SALE_PRICE.join("\n"))] =
      costPriceExcludeVat + deliveryFeeExcludeVat;
  }
  return brandColumn;
};
</file>

<file path="src/app/views/product/products/components/ProductPricing/ProductPricing.tsx">
import { FetchResult } from "@apollo/client";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import {
  ExtendedProductUpdateAdditionalInput,
  ProductToBeChangedInfoCreateInput,
  ProductVariantInput,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
} from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ExtendedProductUpdate } from "@src/app/views/product/products/api/types/ExtendedProductUpdate";
import { utils } from "@utils/utils";
import { Card, Form, Table, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { ProductDetails_product, ProductDetails_product_outerVariants } from "../../api/types/ProductDetails";
import {
  ProductVariantDetails_productVariant,
  ProductVariantDetails_productVariant_productVariantRegions,
} from "../../api/types/ProductVariantDetails";
import {
  convertProductPriceToIncludeVat,
  makeProductDisabledDays,
  parseProductVariantPriceToExcludeVat,
  productVariantManageEventTypeChoices,
} from "../../utils/data";
import { ProductUpdateData } from "../ProductUpdatePage/form";
import { ProductVariantUpdateData } from "../ProductVariantUpdatePage/form";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "../PvOrBpvManageEventModal";
import { getProductPricingTableColumns, ProductPricingTableColumnsProps } from "./ProductPricingTableSettings";

interface ProductPricingProps {
  data: ProductUpdateData | ProductVariantUpdateData;
  product: Pick<ProductDetails_product, "isTaxFree">;
  productVariant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  disabled: boolean;
  loading?: boolean;
  errors: ProductErrorFragment[];
  onVariantUpdate: (
    variantId: string,
    productVariantInput: ProductVariantInput,
    additionalInput: ExtendedProductUpdateAdditionalInput,
    productToBeChangedInfoCreateInput: ProductToBeChangedInfoCreateInput
  ) => Promise<FetchResult<ExtendedProductUpdate>>;
}

// 수정하려는 로우에 따라 수정할 변수가 달라지므로 TFormMode에 따라 분기 처리
// trackInventory: costPrice
// consignment: consignmentCostPrice, consignmentDeliveryFee
// inner: innerCostPrice, innerIncidentalCost
type TFormMode = "trackInventory" | "consignment" | "inner";

export interface IProductPrice {
  // NOTE: 오픈몰 판매가는 이제 쓰이지 않지만, convertProductPriceToIncludeVat를 사용하는 상품가 변경 예약에서 price가 사용되기 때문에 남겨둠
  priceExcludeVat?: number;
  costPriceExcludeVat?: number;
  deliveryFeeExcludeVat?: number;
  // 재고 제품을 위탁 전환 판매 시 협력사 매입가, 택배비
  consignmentCostPriceExcludeVat?: number;
  consignmentDeliveryFeeExcludeVat?: number;
  // 이너박스 제품의 협력사 매입가, 소분판매비용
  innerCostPriceExcludeVat?: number;
  innerIncidentalCostExcludeVat?: number;
}

interface IForm extends IProductPrice {
  leadTime?: number;
  disabledDays?: string[];
  // 재고 택배비 수동 입력 여부
  isDeliveryFeeAmountManual?: boolean;
}

export type TVariantForPrice = Pick<
  ProductVariantDetails_productVariant,
  | "id"
  | "isInner"
  | "costPriceExcludeVat"
  | "deliveryFeeAmount"
  | "consignmentCostPriceExcludeVat"
  | "consignmentDeliveryFeeAmount"
  | "inner"
  | "isDeliveryFeeAmountManual"
> & { rowId: string; formMode: TFormMode };

export type TVariantRegionForPrice = Pick<
  ProductVariantDetails_productVariant_productVariantRegions,
  "id" | "region" | "leadTime" | "disabledDays" | "costPriceExcludeVat" | "deliveryFeeAmount"
>;

export type TVariantOrRegionForPrice = TVariantForPrice | TVariantRegionForPrice;
export type TProductPricingTableDataSource = TVariantForPrice & IForm;

// 로우의 직배송 여부에 따라 타입 가드를 통한 타입 분기 처리
export const checkIsTVariantForPrice = (record: TVariantOrRegionForPrice): record is TVariantForPrice => true;

export const checkIsTVariantRegionForPrice = (record: TVariantOrRegionForPrice): record is TVariantRegionForPrice =>
  false;

const isInnerSuffix = "_INNER";
const consignmentSuffix = "_CONSIGNMENT";

// 공급원가 테이블에서 같은 variant에서 재고/위탁 판매 여부에 따라 로우가 나뉘므로, 테이블 로우 아이디를 유니크하게 만들어줌
const makeUniqueRowId = (rowId: string, formMode: TFormMode) =>
  `${rowId}${formMode === "consignment" ? consignmentSuffix : formMode === "inner" ? isInnerSuffix : ""}`;

const convertRowIdToVariantId = (uniqueRowId: string) =>
  uniqueRowId.replace(consignmentSuffix, "").replace(isInnerSuffix, "");

const convertFormToExcludeVat = (formData: IForm, isTaxFree: boolean, precision): IForm => {
  if (utils.isEmpty(formData)) {
    return null;
  }

  const convForm: { [key: string]: number | string[] | boolean } = convertProductPriceToIncludeVat(
    formData,
    isTaxFree,
    precision
  );
  if (utils.isEmpty(formData.leadTime) === false) {
    convForm.leadTime = formData.leadTime;
  }
  if (utils.isEmpty(formData.disabledDays) === false) {
    convForm.disabledDays = formData.disabledDays;
  }
  if (utils.isEmpty(formData.isDeliveryFeeAmountManual) === false) {
    convForm.isDeliveryFeeAmountManual = formData.isDeliveryFeeAmountManual;
  }
  return convForm;
};

export const ProductPricing: React.FC<ProductPricingProps> = (props) => {
  const { data, product, productVariant, disabled, loading, onVariantUpdate } = props;
  const [form] = Form.useForm<IForm>();
  const [selectedRowId, setSelectedRowId] = useState<string>("");
  const [dataSource, setDataSource] = useState<TProductPricingTableDataSource[]>([]);
  const [innerDataSource, setInnerDataSource] = useState<TProductPricingTableDataSource[]>([]);
  const [manageEventModalOpen, setManageEventModalOpen] = useState<boolean>(false);

  const { isTaxFree } = product;
  const { trackInventory, canSaleByInner } = data;

  const deliveryFeeExcludeVatWatched = Form.useWatch("deliveryFeeExcludeVat", form);
  const consignmentCostPriceExcludeVatWatched = Form.useWatch("consignmentCostPriceExcludeVat", form);
  const consignmentDeliveryFeeExcludeVatWatched = Form.useWatch("consignmentDeliveryFeeExcludeVat", form);
  const innerCostPriceExcludeVatWatched = Form.useWatch("innerCostPriceExcludeVat", form);
  const innerIncidentalCostExcludeVatWatched = Form.useWatch("innerIncidentalCostExcludeVat", form);
  const isDeliveryFeeAmountManualWatched = Form.useWatch("isDeliveryFeeAmountManual", form);

  const watchedValues = {
    deliveryFeeExcludeVat: deliveryFeeExcludeVatWatched,
    consignmentCostPriceExcludeVat: consignmentCostPriceExcludeVatWatched,
    consignmentDeliveryFeeExcludeVat: consignmentDeliveryFeeExcludeVatWatched,
    innerCostPriceExcludeVat: innerCostPriceExcludeVatWatched,
    innerIncidentalCostExcludeVat: innerIncidentalCostExcludeVatWatched,
    isDeliveryFeeAmountManual: isDeliveryFeeAmountManualWatched,
  };

  useEffect(() => {
    const formMode: TFormMode = trackInventory ? "trackInventory" : "consignment";
    const parsedVariant = parseProductVariantPriceToExcludeVat({
      ...productVariant,
      rowId: productVariant.id,
      formMode,
    });
    const newDataSource: TProductPricingTableDataSource[] = !!parsedVariant ? [parsedVariant] : [];

    // 재고 제품인 경우, 위탁 관련 비용도 함께 수정 가능해야 함
    if (trackInventory) {
      const parsedNewConsignmentDataSource: TProductPricingTableDataSource[] = newDataSource.map((data) => ({
        ...data,
        rowId: makeUniqueRowId(data.id, "consignment"),
        formMode: "consignment",
      }));
      setDataSource([...newDataSource, ...parsedNewConsignmentDataSource]);
    } else {
      setDataSource(newDataSource);
    }

    if (canSaleByInner) {
      const parsedNewInnerDataSource: TProductPricingTableDataSource[] = newDataSource.map((data) => ({
        ...data,
        rowId: makeUniqueRowId(data.id, "inner"),
        formMode: "inner",
      }));
      setInnerDataSource(parsedNewInnerDataSource);
    }
  }, [loading, productVariant, trackInventory, canSaleByInner]);

  const isEditing = (record: TProductPricingTableDataSource) => record.rowId === selectedRowId;

  const onEdit = (record: TProductPricingTableDataSource) => {
    if (checkIsTVariantRegionForPrice(record)) {
      // NOTE: 직배송 제품인 경우, 직배송 관련 값(리드타임, 직배송 제한 요일) 세팅
      const defaultDisabledDays = makeProductDisabledDays(record?.disabledDays);
      const disabledDaysValue = Object.keys(defaultDisabledDays)?.filter(
        (disabledDay) => defaultDisabledDays[disabledDay] === true
      );
      form.setFields([
        { name: "leadTime", value: record?.leadTime },
        { name: "disabledDays", value: disabledDaysValue },
        { name: "deliveryFeeExcludeVat", value: record?.deliveryFeeExcludeVat },
      ]);
      setSelectedRowId(record.id);
    } else if (checkIsTVariantForPrice(record)) {
      if (record.formMode === "trackInventory") {
        form.setFields([
          { name: "deliveryFeeExcludeVat", value: record?.deliveryFeeExcludeVat },
          { name: "isDeliveryFeeAmountManual", value: record?.isDeliveryFeeAmountManual },
        ]);
      }
      // NOTE: 재고 제품인 경우, 위탁 전환 판매 시 택배비 세팅
      if (record.formMode === "consignment") {
        form.setFields([{ name: "consignmentDeliveryFeeExcludeVat", value: record?.consignmentDeliveryFeeExcludeVat }]);
      }
      // NOTE: 합포장 가능 제품(이너박스 제품 존재)인 경우, 이너박스 관련 비용(이너박스의 매입원가, 소분판매비용) 세팅
      if (record.formMode === "inner") {
        form.setFields([
          { name: "innerCostPriceExcludeVat", value: record?.innerCostPriceExcludeVat },
          { name: "innerIncidentalCostExcludeVat", value: record?.innerIncidentalCostExcludeVat },
        ]);
      }
      setSelectedRowId(record.rowId);
    }
  };

  const onCancel = () => {
    form.resetFields();
    setSelectedRowId("");
    setManageEventModalOpen(false);
  };

  const onSubmit = ({ manageEvent }: ProductVariantManageEventModalForm) => {
    const selectedVariantId = convertRowIdToVariantId(selectedRowId);
    const formData = form.getFieldsValue();
    const productVariantInput: ProductVariantInput = {
      ...convertFormToExcludeVat(formData, isTaxFree, productVariant.priceDecimalPlaces),
    };
    const additionalInput: ExtendedProductUpdateAdditionalInput = {
      manageEvent: manageEvent as ProductVariantManageEventInput,
    };
    onVariantUpdate(selectedVariantId, productVariantInput, additionalInput, undefined).then((res) => {
      const errors = res?.data?.extendedProductUpdate?.errors;
      if (errors?.length === 0) {
        onCancel();
      }
    });
  };

  const onRowSubmitClick = () => setManageEventModalOpen(true);

  const commonColumnsProps: ProductPricingTableColumnsProps = {
    disabled: disabled || loading,
    product,
    productVariant,
    selectedRowId,
    watchedValues,
    isEditing,
    onEdit,
    onRowSubmitClick,
    onCancel,
  };
  const outerTableColumns = getProductPricingTableColumns({ ...commonColumnsProps, isInnerVariantTable: false });
  const innerTableColumns = getProductPricingTableColumns({ ...commonColumnsProps, isInnerVariantTable: true });
  const tableWidthSum = utils.calcTableColsWidthSum(outerTableColumns);

  const makeTableTitle = (isInner: boolean) => {
    if (canSaleByInner === false) {
      return null;
    }
    return () => <Typography.Title level={5}>{isInner ? "이너박스" : "아우터박스"}</Typography.Title>;
  };

  return (
    <>
      <Card title={<CardTitleAntd title="공급원가" />} bodyStyle={{ padding: 0 }}>
        <Form form={form} component={false}>
          <TableVatLegend isIncludeVat={false} size="small" />
          <Table
            {...commonTableProps}
            title={makeTableTitle(false)}
            rowKey={(record) => ("rowId" in record ? record.rowId : record.id)}
            columns={outerTableColumns}
            dataSource={dataSource}
            components={{ body: { cell: EditableCell } }}
            scroll={{ x: tableWidthSum }}
            expandable={{ indentSize: 0 }}
          />
          {canSaleByInner && (
            <Table
              {...commonTableProps}
              title={makeTableTitle(true)}
              rowKey={(record) => ("rowId" in record ? record.rowId : record.id)}
              columns={innerTableColumns}
              dataSource={innerDataSource}
              components={{ body: { cell: EditableCell } }}
              scroll={{ x: tableWidthSum }}
              expandable={{ indentSize: 0 }}
            />
          )}
        </Form>
      </Card>
      <ProductVariantManageEventModal
        isCreateMode
        open={manageEventModalOpen}
        loading={loading}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_PRICE}
        choices={productVariantManageEventTypeChoices}
        onSubmit={onSubmit}
        onCancel={() => setManageEventModalOpen(false)}
      />
    </>
  );
};
</file>

