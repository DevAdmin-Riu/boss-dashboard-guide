    title,
    key,
    align,
    width,
    onCell: (record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.PRODUCT_STATUS,
        record,
        isFbv: false,
      });
      return showNA ? { style: { backgroundColor: "#f5f5f5" } } : {};
