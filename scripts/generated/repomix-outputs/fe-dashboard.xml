import { Alert, Button, Col, Divider, Form, Input, Row, Space, Typography } from "antd";
import React, { useMemo } from "react";
import { useLocation } from "react-router";

import { LoginAdsBanner } from "./LoginAdsBanner";

export interface FormData {
  loginId: string;
  password: string;
}

export interface LoginPageProps {
  error: boolean;
  disableLoginButton: boolean;
  onPasswordRecovery: () => void;
  onSubmit?(event: FormData);
}
export const LoginPage: React.FC<LoginPageProps> = (props) => {
  const { error, disableLoginButton, onPasswordRecovery, onSubmit } = props;
  const [form] = Form.useForm();
  const { search } = useLocation();

  const searchParams = useMemo(() => new URLSearchParams(search), [search]);

  return (
    <Form
      initialValues={{ loginId: searchParams?.get("id"), password: searchParams?.get("pw") }}
      form={form}
      name="basic"
      onFinish={onSubmit}
      autoComplete="off"
      layout="vertical"
    >
      <Form.Item name="loginId" label="아이디">
        <Input autoFocus size="large" type="text" placeholder="로그인 아이디를 입력해 주세요." />
      </Form.Item>
      <Form.Item name="password" label="비밀번호">
        <Input size="large" type="password" placeholder="비밀번호를 입력해 주세요." />
      </Form.Item>
      <Form.Item style={{ textAlign: "right" }}>
        <Button type="link" onClick={onPasswordRecovery}>
          <Typography.Text type="secondary">비밀번호 찾기</Typography.Text>
        </Button>
      </Form.Item>
      <Form.Item>
        <Row justify="center">
          <Col span={24}>
            <Button disabled={disableLoginButton} type="primary" htmlType="submit" size="large" block>
              로그인
            </Button>
          </Col>
          {error && (
            <Alert
              showIcon
              banner
              closable
              style={{ width: "100%" }}
              message="계정명 혹은 비밀번호가 맞지 않습니다."
              type="error"
            />
          )}
        </Row>
      </Form.Item>
      <Space className="mobile-banner" direction="vertical" size={36}>
        <Divider />
        <LoginAdsBanner inner />
      </Space>
    </Form>
  );
};
