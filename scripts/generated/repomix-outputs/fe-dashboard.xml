  const { user } = useUser();
  const shop = useShop();
  const { isStaff, isVendorStaff } = user;
  const useAdjustPricePv = user?.vendor?.useAdjustPricePv || false;
  const { orderDeliveryViewType } = params;

  // 물류센터 주소 목록 추출
  const warehouseAddresses = maybe(() => shop.defaultWarehouse.addresses, []);
  const [modalMode, setModalMode] = useState<OrderDeliveryListModalModeEnum>(null);
  const [selectedRowId, setSelectedRowId] = useState<string>(null);
  const [selectedFulfillmentIds, setSelectedFulfillmentIds] = useState<string[]>([]);

  const onModalOpen = (mode: OrderDeliveryListModalModeEnum, rowId?: string) => {
    setModalMode(mode);
    if (!!rowId) {
      setSelectedRowId(rowId);
    }
  };
  const onModalClose = () => {
    setModalMode(null);
    setSelectedRowId(null);
    setSelectedFulfillmentIds([]);
  };
  const onModalOpenForIds = (mode: OrderDeliveryListModalModeEnum, rowIds: string[]) => {
    setModalMode(mode);
    setSelectedFulfillmentIds(rowIds);
  };

  let targetUrl: (params?: OrderDeliveryListViewUrlQueryParams) => string;
  let filterVariables: FulfillmentFilterInput;
  switch (orderDeliveryViewType) {
    case OrderDeliveryViewTypeEnum.STOCK:
      targetUrl = orderDeliveryListViewUrlA;
      filterVariables = getDeliveryListUrlAFilterVariables(params);
      break;
    case OrderDeliveryViewTypeEnum.CONSIGNMENT:
      if (isVendorStaff) {
        if (isB2b) {
          targetUrl = vsB2bOrderDeliveryListViewUrlBByNonCourier;
        } else if (isByNonCourier) {
          targetUrl = vsOrderDeliveryListViewUrlBByNonCourier;
        } else {
          targetUrl = vsOrderDeliveryListViewUrlBByCourier;
        }
        filterVariables = { ...getVsDeliveryListUrlBFilterVariables(params, isB2b, isByNonCourier, user) };
      } else {
        if (isB2b) {
          targetUrl = orderDeliveryListViewUrlB2b;
        } else if (isByNonCourier) {
          targetUrl = orderDeliveryListViewUrlBByNonCourier;
        } else {
          targetUrl = orderDeliveryListViewUrlBByCourier;
        }
        filterVariables = { ...getDeliveryListUrlBFilterVariables(params, isB2b, isByNonCourier) };
      }
      break;
    case OrderDeliveryViewTypeEnum.STOCK_ETC:
      targetUrl = orderDeliveryListViewUrlC;
      filterVariables = getDeliveryListUrlCFilterVariables(params);
      break;
  }

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: isB2b ? ListViews.DELIVERY_B2B_LIST : ListViews.DELIVERY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useFulfillmentListFilterDownloadQuery);
  const navUrlList = purchaseOrderLineUrlList(
    false,
    { inventoryType: "consignment", status: PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY },
    isB2b ? b2bPurchaseOrderLineListViewUrl : purchaseOrderLineListViewUrl,
    isB2b ? b2bPurchaseOrderLineListViewPath : purchaseOrderLineListViewPath,
    isB2b
  );

  // VS 협력사용 네비게이터: useAdjustPricePv 조건에 따라 "납품 시 금액 확정" 탭 필터링
  const vsNavUrlList = isVendorStaff
    ? vsConsignmentPurchaseOrderLineUrlList().filter(
        (item) =>
          useAdjustPricePv || item.urlEnum !== VsPurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST
      )
    : null;

  const [countOfStatus, setCountOfStatus] = React.useState<TCountOfStatus<PurchaseOrderLineUrlEnum>>(null);
  const showNavList = isStaff && (orderDeliveryViewType === OrderDeliveryViewTypeEnum.CONSIGNMENT || isB2b);
  const { data: countData, loading: countDataLoading } = usePurchaseOrderLineCountQuery({
    skip: !showNavList,
    variables: {
      filter: {
        vendorId: null,
        poEventType: [PurchaseOrderEventTypeEnum.CONSIGNMENT, PurchaseOrderEventTypeEnum.CONSIGNMENT_TAKE_BACK],
        isB2b,
      },
    },
  });

  const queryVariables = React.useMemo<FulfillmentListVariables>(
    () => ({
      ...paginationState,
      filter: filterVariables,
      sort: getDeliveryListSortQueryVariables(params),
      forStaffOrderDelivery: isStaff,
      forVsOrderDelivery: isVendorStaff,
    }),
    [params, settings?.rowNumber]
  );

  const initialListSkip = orderDeliveryViewType !== OrderDeliveryViewTypeEnum.CONSIGNMENT;
  const { data, loading, refetch } = useFulfillmentListQuery({ initialListSkip, variables: queryVariables });

  const deliveryList = maybe(() => data.fulfillments.edges.map((edge) => edge.node), []);
  const clonedDeliveryList: DeliveryListTableDataType[] = React.useMemo(
    () => makeDeliveryListTableDataType(deliveryList),
    [data?.fulfillments?.edges]
  );
  const selectedRow = clonedDeliveryList.find((item) => item.id === selectedRowId);
  const selectedRows = clonedDeliveryList.filter((item) => selectedFulfillmentIds.includes(item.id));

  const queryVariablesTotalCountForPrinted = {
    filter: {
      status: [FulfillmentStatusFilter.FULFILLED],
      trackInventory: true,
      trackingNumberType: TrackingNumberTypeFilter.GOODSFLOW,
      trackingCompleted: false,
    },
  };
  const { data: dataForPrintedTotalCount } = useFulfillmentListTotalCountQuery({
    skip: !isOrderDeliveryViewStock(orderDeliveryViewType),
    variables: queryVariablesTotalCountForPrinted,
  });
  const trackingNumberTypeGoodFlowTotalCount = maybe(() => dataForPrintedTotalCount.fulfillments.totalCount);
  const trackingNumberEmptyTotalCount = maybe(() => data.fulfillments.totalCount);

  const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);
  const { data: courierData, loading: courierLoading } = useCourierListQuery({
    skip: needDeliveryManInfoForConsignmentFulfill,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.couriers,
      filter: { isActive: true },
    },
  });
  const courierList = maybe(() => courierData?.couriers.edges.map((edge) => edge.node), []);

  const [purchaseOrderLinesRevert, purchaseOrderLinesRevertOpts] = usePurchaseOrderLinesRevertMutation({
    refetchQueries: [fulfillmentListQuery, purchaseOrderLineCountQuery],
  });

  const [purchaseOrderLinesVendorOrdered, purchaseOrderLinesVendorOrderedOpts] =
    usePurchaseOrderLinesVendorOrderedMutation({
      refetchQueries: [fulfillmentListQuery, purchaseOrderLineCountQuery],
    });

  const handleLinesRevert = async (variables: PurchaseOrderLinesRevertVariables, message: string) => {
    const { data } = await purchaseOrderLinesRevert({
      variables,
    });
    const errors = data?.purchaseOrderLinesRevert?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess(`선택한 발주제품이 ${message} 처리 되었습니다.`);
      onModalClose();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleLinesVendorOrder = async (purchaseOrderLineIds: string[]) => {
    const { data } = await purchaseOrderLinesVendorOrdered({
      variables: { purchaseOrderLineIds },
    });
    const errors = data?.purchaseOrderLinesVendorOrdered?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품이 협력사 주문 처리되었습니다.");
      onModalClose();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [fulfillmentUpdateTracking, fulfillmentUpdateTrackingOpts] = useFulfillmentUpdateTrackingMutation({
    onCompleted: (data) => {
      const errors = data.fulfillmentUpdateTracking?.errors;
      if (errors.length === 0) {
        let successMsg = "";
        switch (modalMode) {
          case OrderDeliveryListModalModeEnum.UpdateFulfillmentTracking:
            successMsg = "배송정보가 저장되었습니다.";
            break;
          case OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForCourier:
            successMsg = "송장번호 직접 입력이 요청 처리되었습니다.";
            break;
          case OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForNonCourier:
            successMsg = "기타배송 배차정보가 저장되었습니다.";
            break;
          case OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForDs:
            successMsg = "요청된 위탁 배송 건에 대해 직배송 배송시작 여부 변경 요청 처리되었습니다.";
            break;
          default:
            break;
        }
        if (!utils.isEmpty(successMsg, true)) {
          showNotificationSuccess(successMsg);
        }
        onModalClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [fulfillmentListQuery, purchaseOrderLineCountQuery],
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.fulfillments?.pageInfo,
    paginationState,
    params,
  });

  const [fulfillmentBulkUpdateTrackingMutation, fulfillmentBulkUpdateTrackingMutationOpts] =
    useFulfillmentBulkUpdateTrackingMutation({
      onCompleted: (data) => {
        const errors = data.fulfillmentBulkUpdateTracking.errors;
        if (errors.length === 0) {
          showNotificationSuccess("요청하신 건에 대해 배송 시작 처리되었습니다.");
          onModalClose();
        } else {
          showGqlErrors(errors, undefined, false);
        }
      },
      refetchQueries: [fulfillmentListQuery, purchaseOrderLineCountQuery],
    });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderDeliveryListViewUrlDialog, OrderDeliveryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  useEffect(() => {
    if (countData) {
      setCountOfStatus(getStatusCount(countData, false));
    }
  }, [countDataLoading]);

  const pageLoading =
    loading ||
    countDataLoading ||
    courierLoading ||
    fulfillmentUpdateTrackingOpts.loading ||
    fulfillmentBulkUpdateTrackingMutationOpts.loading ||
    purchaseOrderLinesRevertOpts.loading ||
    purchaseOrderLinesVendorOrderedOpts.loading;

  const revertModalConfig = getRevertModalInfo({ status: "confirm-delivery" });

  return (
    <>
      {isStaff && <WindowTitle title={firstDepthMenuTitle.delivery} />}
      <OrderDeliveryListPage
        params={params}
        queryVariables={queryVariables}
        handleRefetch={refetch}
        settings={settings}
        currentTab={currentTab}
        disabled={pageLoading}
        filterOpts={getFilterOpts(filterVariables, isB2b)}
        warehouseAddresses={warehouseAddresses}
        courierList={courierList}
        deliveryList={clonedDeliveryList}
        pageInfo={pageInfo}
        trackingNumberEmptyTotalCount={trackingNumberEmptyTotalCount}
        trackingNumberTypeGoodFlowTotalCount={trackingNumberTypeGoodFlowTotalCount}
        sort={getSortParams(params)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={isVendorStaff ? null : (id) => navigate(orderDetailsViewUrl(id))}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        isB2b={isB2b}
        isByNonCourier={isByNonCourier}
        onFulfillmentUpdateTrackingForCourier={(rowId) =>
          onModalOpen(OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForCourier, rowId)
        }
        onFulfillmentUpdateTrackingForNonCourier={(rowId) =>
          onModalOpen(OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForNonCourier, rowId)
        }
        onFulfillmentUpdateTracking={(rowId) =>
          onModalOpen(OrderDeliveryListModalModeEnum.UpdateFulfillmentTracking, rowId)
        }
        onFulfillmentUpdateTrackingForDs={(rowId) =>
          onModalOpen(OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForDs, rowId)
        }
        onDeliveryMultipleConfirm={(rowIds: string[]) => {
          // 선택된 항목 중 vendorOrderStatus가 STANDBY인 것들 체크
          const standbyItems = selectedRows.filter(
            (item) => item.orderLine.purchaseOrderLine?.vendorOrderStatus === "STANDBY"
          );

          if (standbyItems.length > 0 && isStaff && !isB2b) {
            // STANDBY 상태인 항목들이 있으면 알림 표시
            const itemList = standbyItems
              .map((item) => `• 배송관리번호: ${item.fulfillmentComposedIdWithPrefix}`)
              .join("\n");

            Modal.error({
              title: "배송 확정 불가",
              content: (
                <div>
                  <p>협력사 주문상태가 '대기'인 건들이 있어 배송 확정을 진행할 수 없습니다.</p>
                  <div style={{ marginTop: 12, whiteSpace: "pre-line" }}>{itemList}</div>
                  <p style={{ marginTop: 12 }}>협력사 주문 처리 후 다시 시도해주세요.</p>
                </div>
              ),
              okText: "확인",
            });
          } else {
            onModalOpenForIds(OrderDeliveryListModalModeEnum.UpdateDeliveryMultipleConfirm, rowIds);
          }
        }}
        onFulfillmentRevertMultipleConfirm={(rowIds: string[]) =>
          onModalOpenForIds(OrderDeliveryListModalModeEnum.RevertLines, rowIds)
        }
        onVendorOrderConfirm={(rowIds: string[]) =>
          onModalOpenForIds(OrderDeliveryListModalModeEnum.VendorOrder, rowIds)
        }
        onOrderLineBoxSizeUpdate={(rowId) => onModalOpen(OrderDeliveryListModalModeEnum.UpdateOrderLineBoxSize, rowId)}
        fulfillmentBulkUpdateTracking={fulfillmentBulkUpdateTrackingMutation}
        setSelectedFulfillmentIds={setSelectedFulfillmentIds}
        selectedFulfillmentIds={selectedFulfillmentIds}
        ListNavigator={
          showNavList
            ? () => (
                <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, PurchaseOrderLineUrlEnum>
                  skipQueryString
                  countOfStatus={countOfStatus}
                  urlList={navUrlList}
                  NavButtonName={getPurchaseOrderLineNavButtonName(false, isB2b)}
                />
              )
            : isVendorStaff
            ? () => (
                <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, VsPurchaseOrderLineUrlEnum>
                  countOfStatus={null}
                  urlList={vsNavUrlList}
                  NavButtonName={vsConsignmentPurchaseOrderLineNavButtonName}
                />
              )
            : null
        }
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <OrderFulfillmentTrackingModal
        couriers={courierList}
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForCourier}
        initialValues={{
          courierId: selectedRow?.courier?.id,
          trackingNumber: selectedRow?.trackingNumber,
        }}
        onSubmit={(formData) => {
          const { trackingNumber, courierId } = formData;
          fulfillmentUpdateTracking({
            variables: { id: selectedRowId, input: { trackingNumber, courierId }, isPoLineDeliveryConfirmed: true },
          });
        }}
        onClose={onModalClose}
      />
      <OrderFulfillmentTrackingDeliveryManInfoModal
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForNonCourier}
        initialValues={{ etcDeliveryManInfo: selectedRow?.etcDeliveryManInfo }}
        onSubmit={(formData) => {
          const { etcDeliveryManInfo } = formData;
          fulfillmentUpdateTracking({
            variables: {
              id: selectedRowId,
              input: { etcDeliveryManInfo },
              isPoLineDeliveryConfirmed: true,
            },
          });
        }}
        onClose={onModalClose}
      />
      <OrderFulfillmentTrackingDeliveryInfoModal
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateFulfillmentTracking}
        initialValues={{
          courierId: selectedRow?.courier?.id,
          trackingNumber: selectedRow?.trackingNumber,
          etcDeliveryManInfo: selectedRow?.etcDeliveryManInfo,
          deliveryMethod: selectedRow?.deliveryMethod,
        }}
        onSubmit={(formData) => {
          const { etcDeliveryManInfo, trackingNumber, courierId, deliveryMethod } = formData;
          if (
            (utils.isEmpty(etcDeliveryManInfo?.vehicle) || utils.isEmpty(etcDeliveryManInfo?.contact)) &&
            (utils.isEmpty(trackingNumber) || utils.isEmpty(courierId))
          ) {
            showNotificationError("배차차량정보와 배송기사 연락처를 또는 택배사와 송장번호를 입력해주세요.");
            return;
          }

          fulfillmentUpdateTracking({
            variables: {
              id: selectedRowId,
              input: { etcDeliveryManInfo, trackingNumber, courierId, deliveryMethod },
              isPoLineDeliveryConfirmed: true,
            },
          });
        }}
        onClose={onModalClose}
        couriers={courierList}
      />
      <OrderFulfillmentTrackingDirectShippingModal
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateFulfillmentTrackingForDs}
        initialValues={{
          isTrackingDirectShipping: false,
        }}
        onSubmit={(formData) => {
          const { isTrackingDirectShipping } = formData;
          fulfillmentUpdateTracking({
            variables: {
              id: selectedRowId,
              input: { isTrackingDirectShipping },
              isPoLineDeliveryConfirmed: false,
            },
          });
        }}
        onClose={onModalClose}
      />
      <OrderLineBoxSizeUpdateModal
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateOrderLineBoxSize}
        orderLineId={selectedRow?.orderLine.id}
        orderLineBoxSize={selectedRow?.orderLine.boxSize}
        onClose={onModalClose}
      />
      <OrderDeliveryMultipleConfirmModal
        open={modalMode === OrderDeliveryListModalModeEnum.UpdateDeliveryMultipleConfirm}
        onClose={onModalClose}
        isByNonCourier={isByNonCourier}
        isB2b={isB2b}
        isFbv={false}
        title="배송 확정 (수동)"
        selectedFulfillmentIds={selectedFulfillmentIds}
        fulfillmentList={deliveryList}
        courierList={courierList}
        fulfillmentBulkUpdateTrackingMutation={fulfillmentBulkUpdateTrackingMutation}
      />
      {revertModalConfig !== null && (
        <>
          <PurchaseOrderRevertLinesModal
            open={modalMode === OrderDeliveryListModalModeEnum.RevertLines && selectedFulfillmentIds.length > 0}
            revertModalConfig={revertModalConfig}
            handleLinesRevert={handleLinesRevert}
            onModalClose={() => onModalClose()}
            purchaseOrderLineIds={utils.getUniqueArray(
              selectedRows
                .filter(
                  (item) => item.orderLine.purchaseOrderLine?.status === PurchaseOrderLineStatus.DISPATCH_FULFILLMENT
                )
                .map((item) => item.orderLine.purchaseOrderLine?.id) as string[]
            )}
            checkValidation={() => {
              const isPartiallyDeliveryConfirmed = selectedRows.some(
                (item) =>
                  item.orderLine.purchaseOrderLine?.status === PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED
              );
              if (isPartiallyDeliveryConfirmed) {
                showNotificationError(
                  "현재 선택한 발주 품목 중 일부는 부분 배송 확정 상태입니다. 해당 품목은 되돌릴 수 없습니다."
                );
                return true;
              }
              return false;
            }}
          />
        </>
      )}
      <ConfirmModal
        visible={modalMode === OrderDeliveryListModalModeEnum.VendorOrder}
        modalTitleText="협력사 주문 확인"
        titleText="선택한 발주 품목을 협력사 주문 처리하시겠습니까?"
        okText="협력사 주문"
        onOk={() => {
          const purchaseOrderLineIds = utils.getUniqueArray(
            selectedRows
              .filter((item) => item.orderLine.purchaseOrderLine?.id)
              .map((item) => item.orderLine.purchaseOrderLine?.id) as string[]
          );
          handleLinesVendorOrder(purchaseOrderLineIds);
        }}
        onCancel={onModalClose}
      />
    </>
  );
};
</file>

