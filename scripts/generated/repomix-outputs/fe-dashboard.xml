import { RearrangedOrderLinetype, rearrangeToOrderLine } from "./utils";

interface OrdersHistoryDialogProps {
  open: boolean;
  userId: string;
  userName: string;
  brand: User_brand;
  dateRange: DateRangeInput;
  onClose: () => void;
}

const OrdersHistoryDialog: React.FC<OrdersHistoryDialogProps> = (props) => {
  const { open, userId, userName, brand, dateRange, onClose } = props;
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);
  const orderStatusNotCanceled = Object.values(OrderStatusFilter).filter(
    (status) => status !== OrderStatusFilter.CANCELED
  );

  const columns: ColumnsType<RearrangedOrderLinetype> = [];
  columns.push(
    {
      title: "날짜",
      key: "created",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.capturedAt} onlyDate={true} />,
    },
    {
      title: "주문번호",
      key: "number",
      align: "center",
      width: 100,
      render: (_, record) => record.number,
    },
    {
      title: "상품명",
      key: "brandProductName",
      align: "center",
      width: 150,
      render: (_, record) => record.orderLineProductName,
    }
  );
  if (enableForFbvService) {
    columns.push({
      title: `${transformIsFBVForHq(true)} 상품 여부`,
      key: "isFulfilledByVendor",
      align: "center",
      width: 120,
      render: (_, record) => makeTagIsFBV(record.isFulfilledByVendor, true),
    });
