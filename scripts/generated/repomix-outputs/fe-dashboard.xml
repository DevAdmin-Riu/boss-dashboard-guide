import { WindowTitle } from "@src/app/components/WindowTitle";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import { FromBossNotices_fromBossNotices_edges_node } from "../notices/api/types/FromBossNotices";
import {
  hqPopupCreateViewPath,
  hqPopupDetailsViewPath,
  hqPopupListViewPath,
  popupCreateViewPath,
  popupDetailsViewPath,
  PopupDetailsViewUrlQueryParams,
  popupListViewPath,
  PopupListViewUrlQueryParams,
  PopupListViewUrlSortField,
} from "./urls";
import { PopupCreateView } from "./views/PopupCreateView";
import { PopupDetailsView } from "./views/PopupDetailsView";
import { PopupListView } from "./views/PopupListView/PopupListView";
import withHqPopupWrapper from "./wrapper/withHqPopupWrapper";

const PopupListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: PopupListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    PopupListViewUrlSortField,
    PopupListViewUrlSortField.start,
    false
  );
  const isHqPopup = match.path === hqPopupListViewPath;
  return <PopupListView params={params} isHqPopup={isHqPopup} />;
};

interface PopupDetailsRouteParams {
  id: string;
}
interface PopupDetailsViewProps extends RouteComponentProps<PopupDetailsRouteParams> {
  fromBossNoticeList: FromBossNotices_fromBossNotices_edges_node[];
}
const PopupDetailsViewWrapper: React.FC<PopupDetailsViewProps> = ({ location, match, fromBossNoticeList }) => {
  const qs = parseQs(location.search.substr(1));
  const params: PopupDetailsViewUrlQueryParams = qs;
  const isHqPopup = match.path === hqPopupDetailsViewPath(":id");
  return (
    <PopupDetailsView
      id={decodeURIComponent(match.params.id)}
      params={params}
      isHqPopup={isHqPopup}
      fromBossNoticeList={fromBossNoticeList}
    />
  );
};

const EnhancedPopupCreateView = withHqPopupWrapper(PopupCreateView);
const EnhancedPopupDetailsView = withHqPopupWrapper(PopupDetailsViewWrapper);

const PopupsSection = () => (
  <>
    <WindowTitle title={"팝업 관리"} />
    <Switch>
      <Route exact path={popupListViewPath} component={PopupListViewWrapper} />
      <Route exact path={popupCreateViewPath} component={PopupCreateView} />
      <Route exact path={popupDetailsViewPath(":id")} component={PopupDetailsViewWrapper} />
      {/* 가맹본부 popup */}
      <Route exact path={hqPopupListViewPath} component={PopupListViewWrapper} />
      <Route exact path={hqPopupCreateViewPath} component={EnhancedPopupCreateView} />
      <Route exact path={hqPopupDetailsViewPath(":id")} component={EnhancedPopupDetailsView} />
    </Switch>
  </>
);

export default PopupsSection;
</file>

