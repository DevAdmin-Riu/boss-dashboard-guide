    filmUnitDevCostExcludeVat: formData.filmUnitDevCostExcludeVat || 0,
    filmQtyForDevCost: formData.filmQtyForDevCost || 0,
    etcUnitDevCostExcludeVat: formData.etcUnitDevCostExcludeVat || 0,
    etcQtyForDevCost: formData.etcQtyForDevCost || 0,
  });

  const onSubmit = (formData: TEstimateForm) => {
    const checkIsCreateFormData = (_data: TEstimateForm, isCreateMode: boolean): _data is TCreateForm => isCreateMode;

    if (checkIsCreateFormData(formData, isCreateMode)) {
