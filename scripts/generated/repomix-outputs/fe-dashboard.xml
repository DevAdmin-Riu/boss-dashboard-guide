import { OrderType, TaxInvoiceFilterInput, TaxInvoiceStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { getOrderTypeEnums } from "@src/app/views/order/orders/views/OrderListView/filters";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { B2bTaxInvoiceFilterKeys, B2bTaxInvoiceListFilterOpts } from "../../components/B2bTaxInvoiceListPage/filter";
import {
  B2bTaxInvoiceListViewUrlFilters,
  B2bTaxInvoiceListViewUrlFiltersEnum,
  B2bTaxInvoiceListViewUrlFiltersWithMultipleValuesEnum,
  B2bTaxInvoiceListViewUrlQueryParams,
} from "../../urls";

const B2B_TAX_INVOICE_ISSUED_FILTERS_KEY = "B2B_TAX_INVOICE_ISSUED_FILTERS_KEY";

export function getFilterOpts(params: B2bTaxInvoiceListViewUrlFilters): B2bTaxInvoiceListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    b2bBrandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bBrandSearch, true), false),
      value: maybe(() => filterVariables.b2bBrandSearch, ""),
    },
    writedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.writedAt.gte, filterVariables.writedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.writedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.writedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    issuedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.issuedAt.gte, filterVariables.issuedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.issuedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.issuedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    isTaxFree: {
      active: maybe(() => !utils.isEmpty(filterVariables.isTaxFree), false),
      value: maybe(() => filterVariables.isTaxFree, false),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(
        () => dedupeFilter(filterVariables.status.map((status) => findValueInEnum(status, TaxInvoiceStatusEnum))),
        []
      ),
    },
  };
}

export function getFilterVariables(params: B2bTaxInvoiceListViewUrlFilters): TaxInvoiceFilterInput {
  const orderTypeEnums = getOrderTypeEnums(params.orderType as OrderType);
  return {
    writedAt: getGteLteVariables({
      gte: params.writedAtFrom,
      lte: params.writedAtTo,
    }),
    issuedAt: getGteLteVariables({
      gte: params.issuedAtFrom,
      lte: params.issuedAtTo,
    }),
    b2bBrandSearch: params.b2bBrandSearch,
    isTaxFree: params.isTaxFree !== undefined ? parseBoolean(params.isTaxFree, false) : undefined,
    status: maybe(() => params.status.map((status) => findInEnum(status, TaxInvoiceStatusEnum))),
    orderType: orderTypeEnums,
  };
}

export function getFilterQueryParam(filter: IFilterElement<B2bTaxInvoiceFilterKeys>): B2bTaxInvoiceListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case B2bTaxInvoiceFilterKeys.writedAt:
      return getMinMaxQueryParam(
        filter,
        B2bTaxInvoiceListViewUrlFiltersEnum.writedAtFrom,
        B2bTaxInvoiceListViewUrlFiltersEnum.writedAtTo
      );
    case B2bTaxInvoiceFilterKeys.issuedAt:
      return getMinMaxQueryParam(
        filter,
        B2bTaxInvoiceListViewUrlFiltersEnum.issuedAtFrom,
        B2bTaxInvoiceListViewUrlFiltersEnum.issuedAtTo
      );
    case B2bTaxInvoiceFilterKeys.b2bBrandSearch:
      return getSingleValueQueryParam(filter, B2bTaxInvoiceListViewUrlFiltersEnum.b2bBrandSearch);
    case B2bTaxInvoiceFilterKeys.isTaxFree:
      return getSingleValueQueryParam(filter, B2bTaxInvoiceListViewUrlFiltersEnum.isTaxFree);
    case B2bTaxInvoiceFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        B2bTaxInvoiceListViewUrlFiltersWithMultipleValuesEnum.status,
        TaxInvoiceStatusEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } = createFilterTabUtils<B2bTaxInvoiceListViewUrlFilters>(
  B2B_TAX_INVOICE_ISSUED_FILTERS_KEY
);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  B2bTaxInvoiceListViewUrlQueryParams,
  B2bTaxInvoiceListViewUrlFilters
>({ ...B2bTaxInvoiceListViewUrlFiltersEnum });
</file>

