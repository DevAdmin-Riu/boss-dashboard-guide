  isDeferredConfirmModal: boolean,
  setIsDeferredConfirmModal: React.Dispatch<React.SetStateAction<boolean>>,
  isB2bCategoryKind: boolean,
  isStandardCategoryKind: boolean
) => {
  const { data, variant, disabled, isFulfilledByVendor, onChange } = props;
  let disabledTrackInventorySwitch = disabled || data.isForCreditsRefill === true;
  if ("salesStatus" in data) {
    disabledTrackInventorySwitch = disabledTrackInventorySwitch || data?.salesStatus === SalesStatusEnum.STOPPED;
  }

  return (
    <>
      <Divider style={{ margin: 0 }} />
      <Col xs={24} sm={12}>
        <FormFieldAntd
          label="아우터박스 재고 운영"
          description="활성화할 경우, 직접 재고 운영하는 제품으로 처리됩니다."
        >
          <Switch
            disabled={disabledTrackInventorySwitch || isB2bCategoryKind}
            checked={data.trackInventory}
            checkedChildren="ON"
            unCheckedChildren="OFF"
            onChange={(value) => {
              if (data.allowAutoConsignment && value === false) {
                showNotificationWarn("위탁 전환 제품은 '아우터박스 재고 운영'을 비활성화할 수 없습니다.");
                return;
              }
              if (data.autoTurnOffAllowAutoConsignment && value === false) {
                showNotificationWarn(
                  "'아우터박스 입고 시 위탁 전환 종료'가 On인 상품은 '아우터박스 재고 운영'을 비활성화할 수 없습니다."
                );
                return;
              }
              if (data.isSubPv && value === false) {
                showNotificationWarn("포장보스 부자재 제품은 '아우터박스 재고 운영'을 비활성화할 수 없습니다.");
                return;
              }
              onChange({ target: { name: "trackInventory", value } });
              if (value === false) {
                onChange({ target: { name: "isVendorTrackInventory", value: false } });
              }
            }}
          />
        </FormFieldAntd>
      </Col>
      <Col xs={24} sm={12}>
        <FormFieldAntd
          label="협력사 위탁 재고"
          description="재고 운영하지만, 재고를 협력사에 보관해 주문 시 협력사에 위탁 발주 후 협력사가 출고하게 되는 제품입니다."
        >
          <Switch
            disabled={disabledTrackInventorySwitch || isB2bCategoryKind || !data.trackInventory}
