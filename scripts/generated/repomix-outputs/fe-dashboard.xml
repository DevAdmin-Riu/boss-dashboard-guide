import useNavigator from "@hooks/useNavigator";
import { useMetadataUpdate, usePrivateMetadataUpdate } from "@src/api/core/metadata/updateMetadata";
import useMakerSearch from "@src/api/searches/useMakerSearch";
import { ProductVariantCreateInput, SalesStatusEnum } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { WindowTitle } from "@src/app/components/WindowTitle";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { useWarehouseList } from "@src/app/views/settings/warehouses/api/queries";
import { warehouseCreateViewPath } from "@src/app/views/settings/warehouses/urls";
import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createMetadataCreateHandler from "@utils/handlers/metadataCreateHandler";
import { maybe, transformIsFBV } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";
import { useLocation } from "react-router";

import { useProductVariantReorderMutation, useVariantCreateMutation } from "../api/mutations";
import { useProductForCreateVariantQuery, useProductVariantDetailsQuery } from "../api/queries";
import { ProductVariantCreateData } from "../components/ProductVariantCreatePage/form";
import { ProductVariantCreatePage } from "../components/ProductVariantCreatePage/ProductVariantCreatePage";
import { ProductVariantUpdateData } from "../components/ProductVariantUpdatePage/form";
import { productVariantUpdateViewUrl } from "../urls";
import { makeFilteredAttributesForMutationInput } from "../utils/data";
import { createVariantReorderHandler } from "./ProductUpdateView/handlers";

function isProductCreateData(
  data: ProductVariantCreateData | ProductVariantUpdateData
): data is ProductVariantCreateData {
  return "defaultPvvVendorCode" in data;
}

export const commonCheckProductVariantRequired = (
  formData: ProductVariantCreateData | ProductVariantUpdateData,
  firstAvailableForPurchase: any,
  isCreateMode: boolean
) => {
  if (!formData) {
    return false;
  }

  {
    const salesStatusKey = "salesStatus";
    if (utils.isEmpty(formData[salesStatusKey])) {
      showNotificationError("제품 상태를 선택하세요.");
      return false;
    }

    if (
      formData[salesStatusKey] !== SalesStatusEnum.PENDING &&
      formData[salesStatusKey] !== SalesStatusEnum.ON_SALE &&
      isCreateMode
    ) {
      showNotificationError("제품 상태는 '판매 대기' 또는 '정상'만 선택 가능합니다.");
      return false;
    }
  }
  if (formData.canSaleByInner) {
    const salesStatusKey = "innerSalesStatus";
    if (utils.isEmpty(formData[salesStatusKey])) {
      showNotificationError("이너박스 제품 상태를 선택하세요.");
      return false;
    }

    if (
      formData[salesStatusKey] !== SalesStatusEnum.PENDING &&
      formData[salesStatusKey] !== SalesStatusEnum.ON_SALE &&
      isCreateMode
    ) {
      showNotificationError("이너박스 제품 상태는 '판매 대기' 또는 '정상'만 선택 가능합니다.");
      return false;
    }
  }

  if (utils.isEmpty(formData.boxLength, true) || formData.boxLength === 0) {
    showNotificationError(`아우터박스 규격 - 길이(장)는 0보다 큰 수를 입력해 주세요.`);
    return false;
  }
  if (utils.isEmpty(formData.boxWidth, true) || formData.boxWidth === 0) {
    showNotificationError(`아우터박스 규격 - 너비(폭)는 0보다 큰 수를 입력해 주세요.`);
    return false;
  }
  if (utils.isEmpty(formData.boxHeight, true) || formData.boxHeight === 0) {
    showNotificationError(`아우터박스 규격 - 높이(고)는 0보다 큰 수를 입력해 주세요.`);
    return false;
  }
  if (utils.isEmpty(formData.qtyPerBox, true) || formData.qtyPerBox === 0) {
    showNotificationError(`아우터박스 입수량은 0보다 큰 수를 입력해 주세요.`);
    return false;
  }

  // 이너박스 제품인 경우 validate
  if (formData.canSaleByInner) {
    if (utils.isEmpty(formData.innerBoxLength, true) || formData.innerBoxLength === 0) {
      showNotificationError("이너박스 규격 - 길이(장)는 0보다 큰 수를 입력해 주세요.");
      return false;
    }
    if (utils.isEmpty(formData.innerBoxWidth, true) || formData.innerBoxWidth === 0) {
      showNotificationError("이너박스 규격 - 너비(폭)는 0보다 큰 수를 입력해 주세요.");
      return false;
    }
    if (utils.isEmpty(formData.innerBoxHeight, true) || formData.innerBoxHeight === 0) {
      showNotificationError("이너박스 규격 - 높이(고)는 0보다 큰 수를 입력해 주세요.");
      return false;
    }
    if (utils.isEmpty(formData.innerQtyPerBox, true) || formData.innerQtyPerBox === 0) {
      showNotificationError("이너박스 입수량은 0보다 큰 수를 입력해 주세요.");
      return false;
    }
  }

  if (formData.trackInventory || formData.canSaleByInner) {
    if (
      utils.isEmpty(formData.stockAdjustFactor, true) ||
      formData.stockAdjustFactor < -1000 ||
      formData.stockAdjustFactor > 1000
    ) {
      showNotificationError("재발주점 계산식에 더하기 보정값은 -1000 이상 1000 이하의 값으로 입력해 주세요.");
      return false;
    }
  }

  if (utils.isEmpty(formData.salesUnitType)) {
    showNotificationError("운영 단위를 선택하세요.");
    return false;
  }

  if (utils.isEmpty(formData.maker)) {
    showNotificationError("제조사를 선택하세요.");
    return false;
  }

  if (formData.isForCreditsRefill === false && utils.isEmpty(formData.countryOfOrigin)) {
    showNotificationError("원산지를 선택하세요.");
    return false;
  }

  if (isProductCreateData(formData)) {
    if (formData.trackInventory) {
      if (
        (utils.isEmpty(formData.defaultPvvProductPriceExcludeVat) || formData.defaultPvvProductPriceExcludeVat <= 0) &&
        (utils.isEmpty(formData.defaultPvvConsignmentProductPriceExcludeVat) ||
          formData.defaultPvvConsignmentProductPriceExcludeVat <= 0)
      ) {
        showNotificationError(
          "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 둘 중 하나는 0 보다 큰 값 이어야 합니다."
        );
        return false;
      }
    } else {
      if (
        utils.isEmpty(formData.defaultPvvConsignmentProductPriceExcludeVat) ||
        formData.defaultPvvConsignmentProductPriceExcludeVat <= 0
      ) {
        showNotificationError(
          `재고 미운영이거나 ${transformIsFBV(true)} 상품인 경우, 협력사 위탁 상품가는 0 보다 큰 값 이어야 합니다.`
        );
        return false;
      }
    }
    if (utils.isEmpty(formData.defaultPvvDeliveryFeeExcludeVat) || formData.defaultPvvDeliveryFeeExcludeVat < 0) {
      showNotificationError("협력사 재고 배송비는 0 이상의 값 이어야 합니다.");
      return false;
    }
    if (
      utils.isEmpty(formData.defaultPvvConsignmentDeliveryFeeExcludeVat) ||
      formData.defaultPvvConsignmentDeliveryFeeExcludeVat < 0
    ) {
      showNotificationError("협력사 위탁 배송비는 0 이상의 값 이어야 합니다.");
      return false;
    }
    if (utils.isEmpty(formData.defaultPvvMoq)) {
      showNotificationError("협력사 발주 MOQ는 필수 입력 항목입니다.");
      return false;
    }
  }
};

interface ProductVariantCreateViewProps {
  productId: string;
}

export const ProductVariantCreateView: React.FC<ProductVariantCreateViewProps> = ({ productId }) => {
  const navigate = useNavigator();
  const location = useLocation();
  const queryParams = new URLSearchParams(location.search);
  const copyVariantId = queryParams.get("copyVariantId");

  const shop = useShop();

  const warehouses = useWarehouseList({
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.warehouses,
    },
  });

  const { data, loading: productLoading } = useProductForCreateVariantQuery({
    variables: { id: productId },
  });

  const { data: copyVariantData, loading: copyVariantLoading } = useProductVariantDetailsQuery({
    variables: { id: copyVariantId },
    skip: !copyVariantId,
  });

  const {
    loadMore: loadMoreMakers,
    search: searchMakers,
    result: searchMakersOpts,
  } = useMakerSearch({ variables: DEFAULT_INITIAL_SEARCH_DATA });

  const [variantCreate, variantCreateResult] = useVariantCreateMutation({
    onCompleted: (data) => {
      const errors = data.productVariantCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(productVariantUpdateViewUrl(productId, data.productVariantCreate.productVariant.id));
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  const [updateMetadata] = useMetadataUpdate({});
  const [updatePrivateMetadata] = usePrivateMetadataUpdate({});

  const product = data?.product;

  if (product === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => history.back()} />;
  }

  const [reorderProductVariants, reorderProductVariantsOpts] = useProductVariantReorderMutation({});

  const handleVariantReorder = createVariantReorderHandler(product, (variables) =>
    reorderProductVariants({ variables })
  );

  const handleBack = () => history.back();

  const checkRequired = (formData: ProductVariantCreateData) => {
    const commonCheck = commonCheckProductVariantRequired(formData, null, true);
    if (commonCheck === false) {
      return false;
    }

    const requiredAttributeIds = product?.productType?.variantAttributes
      .filter((attribute) => attribute.valueRequired)
      .map((attribute) => attribute.id);
    if (requiredAttributeIds.length > 0) {
      const inputAttributeIds = formData.attributes
        .filter((attribute) => utils.isEmpty(attribute.value) === false)
        .map((attribute) => attribute.id);
      const missingAttributeIds = requiredAttributeIds.filter((id) => !inputAttributeIds.includes(id));
      if (missingAttributeIds.length > 0) {
        showNotificationError("필수 속성을 입력 또는 선택해 주세요.");
        return false;
      }
    }

    return true;
  };

  const handleCreate = async (formData: ProductVariantCreateData) => {
    const isValid = checkRequired(formData);

    if (isValid === false) {
      return null;
    }

    const innerVariantInput: Pick<
      ProductVariantCreateInput,
      | "innerMoq"
      | "innerUoq"
      | "innerQtyPerBox"
      | "innerBoxLength"
      | "innerBoxWidth"
      | "innerBoxHeight"
      | "innerIncidentalCost"
      | "innerStocks"
      | "innerSalesStatus"
      | "innerForceSoldOutNotice"
    > =
      formData.canSaleByInner === false
        ? null
        : {
            innerMoq: formData.innerMoq,
            innerUoq: formData.innerUoq,
            innerQtyPerBox: formData.innerQtyPerBox,
            innerBoxLength: formData.innerBoxLength,
            innerBoxWidth: formData.innerBoxWidth,
            innerBoxHeight: formData.innerBoxHeight,
            innerIncidentalCost: 0,
            innerStocks: formData.innerStocks,
            innerSalesStatus: formData.innerSalesStatus,
            innerForceSoldOutNotice: formData.innerForceSoldOutNotice,
          };

    const input: ProductVariantCreateInput = {
      // 제품 옵션 기본 정보
      product: productId,
      salesStatus: formData.salesStatus,
      trackInventory: formData.trackInventory,
      isVendorTrackInventory: formData.isVendorTrackInventory,
      forceSoldOutNotice: formData.forceSoldOutNotice,
      // 제품 옵션 속성 정보
      attributes: makeFilteredAttributesForMutationInput(formData),
      qtyPerBoxUnitType: formData.qtyPerBoxUnitType,
      priorityLevel: formData.priorityLevel,
      salesUnitType: formData.salesUnitType,
      qtyPerBox: formData.qtyPerBox,
      boxLength: formData.boxLength,
      boxWidth: formData.boxWidth,
      boxHeight: formData.boxHeight,
      palletQty: formData.palletQty,
      palletM: formData.palletM,
      palletN: formData.palletN,
      palletO: formData.palletO,
      maker: formData.maker,
      // 제품 옵션 공급원가 정보(옵션 생성 시 공급원가 정보 0원으로 세팅)
      price: 0,
      consignmentDeliveryFee: 0,
      // 제품 옵션 재고 관련 정보
      stockAdjustFactor: formData.stockAdjustFactor,
      stocks: formData.stocks,
      allowAutoConsignment: formData.allowAutoConsignment,
      autoTurnOffAllowAutoConsignment: formData.autoTurnOffAllowAutoConsignment,
      isSubPv: formData.isSubPv,
      canSaleByInner: formData.canSaleByInner,
      requiredExpDateMgmt: formData.requiredExpDateMgmt,
      note: formData.note,
      poNote: formData.poNote,
      isSeasonal: formData.isSeasonal,
      peakSeasonStartDate: formData.peakSeasonStartDate,
      peakSeasonEndDate: formData.peakSeasonEndDate,

      priceDecimalPlaces: formData.priceDecimalPlaces,
      orderQtyDecimalPlaces: formData.orderQtyDecimalPlaces,

      // 기본 협력사
      defaultPvvCreateInput: {
        vendorCode: formData.defaultPvvVendorCode,
        isActive: formData.defaultPvvIsActive,
        externalSku: formData.defaultPvvExternalSku,
        externalProductName: formData.defaultPvvExternalProductName,
        productPriceExcludeVat: formData.defaultPvvProductPriceExcludeVat,
        deliveryFeeExcludeVat: formData.defaultPvvDeliveryFeeExcludeVat,
        consignmentProductPriceExcludeVat: formData.defaultPvvConsignmentProductPriceExcludeVat,
        consignmentDeliveryFeeExcludeVat: formData.defaultPvvConsignmentDeliveryFeeExcludeVat,
        leadTime: formData.defaultPvvLeadTime,
        moq: formData.defaultPvvMoq,
        note: formData.defaultPvvNote,
        noteForUnitPrice: formData.defaultPvvNoteForUnitPrice,
      },

      // 충전금 상품은 원산지 정보를 null로 보냄
      countryOfOrigin: formData.isForCreditsRefill ? null : formData.countryOfOrigin,

      // 이너박스 정보(직배송 제품인 경우는 무관)
      ...innerVariantInput,
    };
    const result = await variantCreate({ variables: { input } });

    return result.data.productVariantCreate?.productVariant?.id || null;
  };
  const handleSubmit = createMetadataCreateHandler(handleCreate, updateMetadata, updatePrivateMetadata);
  const handleVariantClick = (id: string) => navigate(productVariantUpdateViewUrl(productId, id));

  const disableForm =
    productLoading || variantCreateResult.loading || reorderProductVariantsOpts.loading || copyVariantLoading;

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const title = copyVariantId ? "옵션 복사 생성" : "옵션 추가";

  return (
    <>
      <WindowTitle title={title} />
      <ProductVariantCreatePage
        currencySymbol={currencySymbol}
        disabled={disableForm}
        errors={variantCreateResult.data?.productVariantCreate.errors || []}
        title={title}
        product={data?.product}
        copyVariant={copyVariantData?.productVariant}
        makers={maybe(() => searchMakersOpts.data.search.edges, []).map((edge) => edge.node)}
        fetchMakers={searchMakers}
        fetchMoreMakers={{
          hasMore: maybe(() => searchMakersOpts.data.search.pageInfo.hasNextPage),
          loading: searchMakersOpts.loading,
          onFetchMore: loadMoreMakers,
        }}
        onBack={handleBack}
        onSubmit={handleSubmit}
        onVariantClick={handleVariantClick}
        onWarehouseConfigure={() => navigate(warehouseCreateViewPath)}
        onVariantReorder={handleVariantReorder}
        saveButtonBarState={variantCreateResult.status}
        warehouses={warehouses?.data?.warehouses.edges.map((edge) => edge.node) || []}
      />
    </>
  );
};
