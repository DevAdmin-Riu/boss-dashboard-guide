    const etcDeliveryFeeExcludeVat = toPriceExcludeVat(getEtcDeliveryFee(record));
    // 도서산간 지역 추가 배송비
    const deliveryAdditionalFeeExcludeVat = calculateDeliveryAdditionalFeeExcludeVat(record);

    // (실 결제금액 - 협력사 매입총액(입고 시) - 실제 PG 결제 수수료 - 판매택배총액 - 본부수익금 - 기타 배송비 - 도서산간 지역 추가 배송비) / 총 결제금액
