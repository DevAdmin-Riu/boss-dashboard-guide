import { CourierList_couriers_edges_node } from "./api/types/CourierList";

export const openTrackingWindow = (trackingNumber, courierId, couriers: CourierList_couriers_edges_node[]) => {
  const courier = couriers?.find((courier) => courier.id === courierId);

  if (utils.checkCourierDigitAllowedValues(trackingNumber, courier?.digitAllowedValues)) {
    const isMobile = utils.checkMobile();
    const target = isMobile ? courier.mobilePage : courier.trackingPage;
    window.open(target.replace("(송장번호)", trackingNumber), "_blank");
  } else {
    showNotificationError("송장번호 양식오류 입니다. 고객센터에 문의해 주세요.");
  }
};
