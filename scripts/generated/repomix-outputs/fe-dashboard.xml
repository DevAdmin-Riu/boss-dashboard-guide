const makeB2bOrderPopupConfirmNode = (record, confirmTitle, confirmMsg) => {
  const orderTypeText = convertOrderTypeToWord(record.order.type);
  const hasExcludedDeliveryFee = record.brandProductVariant?.includeSalesB2bDeliveryFee === false;

  return (
    <>
      <Space direction="vertical">
        <Typography.Text strong>
          {orderTypeText} {confirmTitle}
        </Typography.Text>
        <Typography.Text>
          {record.productName}({record.productSku}): {confirmMsg}
        </Typography.Text>
        {hasExcludedDeliveryFee && (
          <Typography.Text type="warning">
            판매가 배송비 별도인 상품이니 접수 전 판매 배송비를 입력했는지 확인해주세요.
          </Typography.Text>
        )}
      </Space>
    </>
  );
};

export function getB2bOrderTableSettings(props?: GetB2bOrderTableSettingsProps) {
  const {
    form,
    formValuesWatched,
    onRowClick,
    loading,
    selectedRowId,
    setSelectedRowId,
    isEditing,
    onEdit,
    onCancel,
    onSubmit,
    onOrderLinesB2bReceive,
    onOrderLinesB2bCancel,
    onOrderLinesB2bPending,
    openModal,
    routeParams,
    isStaff,
  } = props;
  const isAllRouteStatus = routeParams.status === "all";
  const isAcceptRouteStatus = routeParams.status === "accept";
  const isPendingOrRejectedRouteStatus = routeParams.status === "pending-or-rejected";
  const isCompletedRouteStatus = routeParams.status === "completed";
  const isProcessingRouteStatus = routeParams.status === "processing";
  const isDeliveryRouteStatus = routeParams.status === "delivery";
  const fixedFlag = utils.checkMobile() === false;

  const makeOrderTypeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_TYPE,
    align: "center",
    key: "orderType",
    width: 100,
    render: (_, record) => {
      const tagColor = getOrderTypeTagColor(record.order.type);
      return <Tag color={tagColor}>{convertOrderTypeToWord(record.order.type)}</Tag>;
    },
    renderExcel: (record) => convertOrderTypeToWord(record.order.type),
  };

  const makeOrderComposedIdColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_COMPOSED_ID,
    align: "center",
    key: "orderComposedId",
    width: 100,
    fixed: fixedFlag,
    render: (_, record) => (
      <Typography.Link onClick={() => onRowClick(record.order.id)}>{record.order.composedIdWithPrefix}</Typography.Link>
    ),
    renderExcel: (record) => record.order.composedIdWithPrefix,
  };

  const makeOrderLineComposedIdColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
    align: "center",
    key: "orderLineComposedId",
    fixed: fixedFlag,
    width: 150,
    render: (_, record) => record.composedIdWithPrefix,
  };
  const makeOrderCreatedColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_DATE,
    align: "center",
    key: "orderCreated",
    width: 120,
    render: (_, record) => <DateTime date={record.order.created} />,
    renderExcel: (record) => getDateByFormat(record.order.created, onlyDateFormat),
  };
  const makeEstimatedArrivalDateColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.purchaseOrder.ASKING_PO_DATE,
    align: "center",
    key: "estimatedArrivalDate",
    width: 120,
    render: (_, record) => <DateTime date={record.order.estimatedArrivalDate} onlyDate />,
    renderExcel: (record) => getDateByFormat(record.order.estimatedArrivalDate, onlyDateFormat),
  };
  const makeExpectedPurchaseDateColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_DATE,
    align: "center",
    key: "expectedPurchaseDate",
    width: 120,
    render: (_, record) => {
      if (record.purchaseOrderLine?.expectedPurchaseDate) {
        return <DateTime date={record.purchaseOrderLine.expectedPurchaseDate} onlyDate />;
      }
      return "-";
    },
    renderExcel: (record) =>
      record.purchaseOrderLine?.expectedPurchaseDate
        ? getDateByFormat(record.purchaseOrderLine.expectedPurchaseDate, onlyDateFormat)
        : "-",
  };
  const makeB2bStatusColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.orderLine.ORDER_PROGRESS_STATUS,
    align: "center",
    key: "b2bStatus",
    width: 100,
    render: (_, record) => getStatusLabel(record.b2bStatus),
  };
  const makeB2bRejectReasonColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.orderLine.ORDER_REJECTION_REASON,
    align: "center",
    key: "b2bRejectReason",
    width: 120,
    render: (_, record) => {
      if (record.b2bStatus === OrderLineB2bStatusEnum.REJECTED) {
        return (
          <Typography.Text style={{ width: 120 }} ellipsis={{ tooltip: record.b2bRejectReason }}>
            {record.b2bRejectReason || "-"}
          </Typography.Text>
        );
      }
      return "-";
    },
    renderExcel: (record) => record.b2bRejectReason || "-",
  };
  const makeB2bCustomerNoteColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.orderLine.REQUEST_MEMO,
    align: "center",
    key: "customerNote",
    width: 120,
    render: (_, record) => {
      if (record.order.customerNote) {
        return (
          <Typography.Text style={{ width: 120 }} ellipsis={{ tooltip: record.order.customerNote }}>
            {record.order.customerNote}
          </Typography.Text>
        );
      }
      return "-";
    },
    renderExcel: (record) => record.order.customerNote || "-",
  };
  const makeProductSkuColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.product.SKU,
    align: "center",
    key: "productSku",
    width: 120,
    render: (_, record) => record.productSku,
  };
  const makeProductNameColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.product.PRODUCT_NAME,
    key: "productName",
    align: "left",
    width: 200,
    render: (_, record) => record.variant.product.name || "-",
  };
  const makeBpSkuColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    align: "center",
    key: "bpSku",
    width: 140,
    render: (_, record) => record.brandProductVariant?.bpSku || "-",
  };
  const makeBrandProductNameColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "brandProductName",
    align: "left",
    width: 200,
    // OrderLine.productName은 "상품명"이 저장됨.
    render: (_, record) => record.productName || "-",
