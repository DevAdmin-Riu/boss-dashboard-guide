<file path="src/app/components/Filter/CompactFilter.tsx">
import { buttonText } from "@assets/messages/buttonText";
import filterMsg from "@assets/messages/filters";
import { useListQuerySkip } from "@hooks/useListQuerySkip";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { maybe } from "@utils/misc";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Checkbox, Col, Collapse, Row, Space, Tag, Typography } from "antd";
import { SizeType } from "antd/lib/config-provider/SizeContext";
import { Gutter } from "antd/lib/grid/row";
import { Moment } from "moment";
import moment from "moment";
import { useEffect, useRef, useState } from "react";
import React from "react";

import { convertFilterFieldValueToString, makeFilterInputNode } from "./SpreadFilterContent";
import { IFilter, IFilterElement } from "./types";
import useFilter from "./useFilter";

const filterCollapsedKey = "filterCollapsedKey";

interface CompactFilterProps<TFilterKeys extends string> {
  filterStructure: IFilter<TFilterKeys>;
  autoCollapse?: boolean; // 조회 시, 자동으로 필터를 접을지 여부
  subFilterKeys?: TFilterKeys[];
  onFilterChange: (filter: Array<IFilterElement<TFilterKeys>>) => void;
  onFilterReset: () => void;
  validateQueryClick?: (filterData: Array<IFilterElement<TFilterKeys>>) => boolean;
}

// NOTE: 조회, 초기화 기능만 존재하는 필터 - 기존 SpreadFilter의 탭, 엑셀 출력 등의 기능은 없음
const CompactFilter = <TFilterKeys extends string>(props: CompactFilterProps<TFilterKeys>) => {
  const {
    filterStructure,
    autoCollapse = false,
    subFilterKeys = [],
    onFilterChange,
    onFilterReset,
    validateQueryClick,
  } = props;
  const isMobile = utils.checkMobile();
  const [isMultipleSearch, setIsMultipleSearch] = useState(true);
  const componentRef = useRef<HTMLDivElement>();
  const queryBtnRef = useRef<HTMLButtonElement>();
  const [updatedTime, setUpdatedTime] = useState<Moment>(null);
  const [collapsedKey, setCollapsedKey] = useState<string | string[]>(isMobile ? null : filterCollapsedKey);
  const [data, dispatch, _filterClear, filterReset] = useFilter(filterStructure);
  const [queryClickLocked, setQueryClickLocked] = useState<boolean>(false);
  const { skipState: listQuerySkipState } = useListQuerySkip();

  const shop = useShop();
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  // 최초 진입 시 비어있는 페이지는 리덕스에 저장된 업데이트 시각 표시
  const initialListQuerySkip = listQuerySkipState.initialValue === true;
  const updatedTimeToDisplay = initialListQuerySkip
    ? listQuerySkipState.updatedAtBySearchStr[location.search] || "-"
    : getDateByFormat(updatedTime);

  const padding = isMobile ? 4 : undefined;
  const rowGutter: Gutter | [Gutter, Gutter] = isMobile ? 0 : [16, 16];
  const size: SizeType = isMobile ? "small" : undefined;

  const mainFilterList = data.filter((filterField) => !subFilterKeys.includes(filterField.name));
  const subFilterList = data.filter((filterField) => subFilterKeys.includes(filterField.name));
  const activeFilterList = filterStructure.filter((filterField) => filterField.active);
  const activeFilterCount = activeFilterList.length;

  const setUpdatedNow = () => {
    if (initialListQuerySkip) {
      return;
    }
    setUpdatedTime(moment());
  };

  // url의 파라미터를 통해 필터 적용하므로 url 파라미터 변경 시 필터 초기화
  // url이 아닌 단순 필터 variables state 값으로 적용하는 경우 고려하여 JSON.stringfy 변경 시에도 필터 UI 리셋
  useEffect(() => {
    filterReset();
  }, [location.pathname, location.search, JSON.stringify(activeFilterList.map((f) => f.value))]);

  useEffect(() => {
    setIsMultipleSearch(!isMobile);
  }, [isMobile]);

  useEffect(() => {
    const handleEnterPress = (event) => {
      if (event.key === "Enter") {
        if (event.target.tagName === "TEXTAREA" && !event.ctrlKey && isMultipleSearch) {
          // `textarea`에서는 줄바꿈 허용
          return;
        }

        if (queryBtnRef.current) {
          queryBtnRef.current.click();
        }
      }
    };

    // `ref`가 정의된 경우에만 이벤트 리스너 추가
    const currentRef = componentRef.current;
    if (currentRef) {
      currentRef.addEventListener("keydown", handleEnterPress);
    }

    // Clean-up: 이벤트 리스너 제거
    return () => {
      if (currentRef) {
        currentRef.removeEventListener("keydown", handleEnterPress);
      }
    };
  }, [isMultipleSearch]);

  const onCollapseClose = () => {
    setCollapsedKey(null);
  };

  const onResetClick = () => {
    onFilterReset();
    setUpdatedNow();
    if (autoCollapse) {
      onCollapseClose();
    }
  };

  const validateActiveFilterValue = (filter: Array<IFilterElement<string>>) => {
    const activeFilter = filter.filter((filterElement) => filterElement.active);
    const emptyValueFilterAry = activeFilter.filter(
      (filterElement) => filterElement.value.length === 0 || filterElement.value.every((v) => utils.isEmpty(v, true))
    );
    if (emptyValueFilterAry.length > 0) {
      const filterLabelsText = emptyValueFilterAry.map((filterElement) => filterElement.label).join(", ");
      showNotificationWarn(`[${filterLabelsText}] 필터 값을 입력 또는 선택한 뒤 조회해 주세요.`);
      return false;
    }
    return true;
  };

  const onQueryClick = (e: React.MouseEvent<HTMLElement, MouseEvent>) => {
    // 중복 조회 클릭 방지(0.5초)
    if (queryClickLocked) {
      return;
    }
    setQueryClickLocked(true);
    setTimeout(() => setQueryClickLocked(false), 500);

    const isValid = validateQueryClick ? validateQueryClick(data) : true;
    if (!isValid) {
      return;
    }
    const validateAry = [];
    validateAry.push(validateActiveFilterValue(data));
    if (validateAry.findIndex((v) => v === false) >= 0) {
      return;
    }

    e.preventDefault();
    setUpdatedNow();
    onFilterChange(data);
    if (autoCollapse) {
      onCollapseClose();
    }
  };

  const filterActions = (
    <Space>
      {isMobile && (
        <Checkbox
          checked={isMultipleSearch}
          onChange={(e) => {
            setIsMultipleSearch(e.target.checked);
          }}
        >
          복수검색
        </Checkbox>
      )}
      <Button size="small" type="default" onClick={onResetClick}>
        {buttonText.clear}
      </Button>
      <Button ref={queryBtnRef} size="small" type="primary" onClick={onQueryClick}>
        {buttonText.query}
      </Button>
    </Space>
  );

  return (
    <div ref={componentRef}>
      <Space direction="vertical">
        <Row justify="end" style={{ marginRight: 8 }}>
          <Typography.Text type="secondary" style={{ fontSize: 12 }}>
            업데이트 : {updatedTimeToDisplay}
          </Typography.Text>
        </Row>
        <Collapse collapsible="header" activeKey={collapsedKey} onChange={setCollapsedKey}>
          <Collapse.Panel
            key={filterCollapsedKey}
            header={
              <Typography>
                {filterMsg.cardTitle}({activeFilterCount})
              </Typography>
            }
            extra={filterActions}
          >
            <Row gutter={rowGutter}>
              {mainFilterList.map((filterField) => (
                <Col key={filterField.name} xs={24} sm={8}>
                  {makeFilterInputNode({ currencySymbol, filterField, size, onFilterPropertyChange: dispatch })}
                </Col>
              ))}
              {subFilterList.map((filterField) => (
                <Col key={filterField.name} xs={12} sm={8}>
                  {makeFilterInputNode({ currencySymbol, filterField, size, onFilterPropertyChange: dispatch })}
                </Col>
              ))}
            </Row>
          </Collapse.Panel>
        </Collapse>
        {utils.isEmpty(collapsedKey) && (
          <Row gutter={4} style={{ padding }} align="middle">
            {activeFilterList.map((filterField) => {
              const { isRequired, name, label } = filterField;
              const convertedValue = convertFilterFieldValueToString(filterField);
              const tagText = `${label}: ${convertedValue}`;
              const tagContent = (
                <Typography.Text
                  style={{ maxWidth: isMobile && 200 }}
                  ellipsis={{
                    tooltip: (
                      <Space direction="vertical" size={0}>
                        {label}
                        {convertedValue}
                      </Space>
                    ),
                  }}
                >
                  {tagText}
                </Typography.Text>
              );
              const onClose = () => {
                const newData = data.map((filterField) => {
                  if (filterField.name === name) {
                    return { ...filterField, active: false };
                  }
                  return filterField;
                });
                onFilterChange(newData);
              };

              return (
                <Col key={name}>
                  <Tag closable={!isRequired} onClose={onClose}>
                    {tagContent}
                  </Tag>
                </Col>
              );
            })}
          </Row>
        )}
      </Space>
    </div>
  );
};
export default CompactFilter;
</file>

<file path="src/app/components/Filter/FilterAutocompleteField.tsx">
import { buttonText } from "@src/global/assets/messages/buttonText";
import { toggle } from "@utils/lists";
import { AutoComplete, Checkbox, Col, Input, Radio, Row, Tree, Typography } from "antd";
import React, { useState } from "react";

import { MultiAutocompleteChoiceType } from "../MultiAutocompleteSelectField";
import { FilterBaseFieldProps } from "./types";

const FilterAutocompleteField: React.FC<FilterBaseFieldProps> = ({
  disabled,
  size,
  filterField,
  onFilterPropertyChange,
}) => {
  const [open, setOpen] = useState<boolean>(false);
  const [inputValue, setInputValue] = useState<string>("");
  // 현재 선택된 value에 해당하는 option 라벨을 보여주기 위해 필요
  // 조회 이전까진 disaplayValues가 비어있기 때문에(~View.tsx 파일 내에서 initial 쿼리가 미실행된 상태) options와 displayValues를 합친 배열에서 중복을 제거한 배열을 생성.
  const optionsIncludeDisplayValues = [...filterField.options, ...filterField.displayValues];
  const uniqueOptionsIncludeDisplayValues = optionsIncludeDisplayValues.filter(
    (option, index, self) => self.findIndex((t) => t.value === option.value) === index
  );
  const displayValues = uniqueOptionsIncludeDisplayValues.filter((option) => filterField.value.includes(option.value));
  const displayNoOptions = filterField.options.length === 0;

  const handleChange = (option: MultiAutocompleteChoiceType) => {
    const newValue = toggle(option.value, filterField.value, (a, b) => a === b);

    onFilterPropertyChange({
      payload: {
        name: filterField.name,
        update: {
          active: true,
          value: newValue,
        },
      },
      type: "set-property",
    });
  };

  const handleSelect = (value: string) => {
    const newValue = filterField.multiple ? toggle(value, filterField.value, (a, b) => a === b) : [value];

    onFilterPropertyChange({
      payload: {
        name: filterField.name,
        update: {
          active: true,
          value: newValue,
        },
      },
      type: "set-property",
    });
  };

  const makeOptionLabel = (option: MultiAutocompleteChoiceType) => (
    <Col>
      {filterField.multiple ? (
        <Checkbox
          name={filterField.name}
          disabled={disabled}
          checked={filterField.active ? filterField.value.includes(option.value) : false}
          onChange={() => handleChange(option)}
        >
          <Typography.Text onClick={(e) => e.preventDefault()}>{option.label}</Typography.Text>
        </Checkbox>
      ) : (
        <Radio
          name={filterField.name}
          disabled={disabled}
          checked={filterField.active ? filterField.value[0] === option.value : false}
          onChange={() => handleSelect(option.value)}
        >
          <Typography.Text onClick={(e) => e.preventDefault()}>{option.label}</Typography.Text>
        </Radio>
      )}
    </Col>
  );

  const filterFieldOptions = filterField.options.map((option) => ({
    label: makeOptionLabel(option),
    value: option.value,
  }));

  const autoCompleteOptions = [
    ...filterFieldOptions,
    ...(filterField.hasMore
      ? [
          {
            label: (
              <Row justify="center">
                <Typography.Link underline onClick={filterField.onFetchMore}>
                  {buttonText.showMore}
                </Typography.Link>
              </Row>
            ),
          },
        ]
      : []),
    ...(displayNoOptions
      ? [
          {
            disabled: true,
            label: (
              <Col span={24}>
                <Typography.Text type="secondary">검색 결과가 없습니다.</Typography.Text>
              </Col>
            ),
          },
        ]
      : []),
  ];

  return (
    <>
      <AutoComplete
        open={open}
        style={{ width: "100%" }}
        dropdownMatchSelectWidth
        disabled={disabled}
        onFocus={() => setOpen(true)}
        onBlur={() => setOpen(false)}
        options={autoCompleteOptions}
        value={inputValue}
        placeholder={"검색"}
        onSearch={setInputValue}
        onPopupScroll={({ currentTarget }) => {
          const { scrollHeight, scrollTop, clientHeight } = currentTarget;
          const { hasMore, loading, onFetchMore } = filterField;
          // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
          if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
            onFetchMore();
          }
        }}
      >
        <Input.Search
          allowClear
          size={size}
          name={filterField.name + "_autocomplete"}
          onChange={(e) => {
            e.stopPropagation();
            filterField.onSearchChange(e.target.value);
          }}
        />
      </AutoComplete>
      {filterField.active && displayValues.length > 0 && (
        <Tree
          showLine
          treeData={[
            {
              title: `선택된 ${filterField.label}(${displayValues.length})`,
              key: "selectedCount",
              children: displayValues.map((displayValue) => ({
                title: makeOptionLabel(displayValue),
                key: displayValue.value,
              })),
            },
          ]}
        />
      )}
    </>
  );
};

export default FilterAutocompleteField;
</file>

