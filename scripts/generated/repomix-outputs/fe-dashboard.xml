import useNavigator from "@hooks/useNavigator";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useCourierCreateMutation } from "../api/mutations";
import CourierCreatePage from "../components/CourierCreatePage";
import { courierListViewUrl, courierUrl } from "../urls";

export const CourierCreateView: React.FC<{}> = () => {
  const navigate = useNavigator();

  const [courierCreate, courierCreateOpts] = useCourierCreateMutation({
    onCompleted: (data) => {
      const errors = data.courierCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(courierUrl(data.courierCreate.courier.id));
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  return (
    <CourierCreatePage
      disabled={courierCreateOpts.loading}
      onBack={() => navigate(courierListViewUrl())}
      onSubmit={(input) => courierCreate({ variables: { input } })}
      saveButtonBarState={courierCreateOpts.status}
    />
  );
};
</file>

