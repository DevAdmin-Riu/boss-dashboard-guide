enum ProductUpdateModalModeEnum {
  AssignedBrandList = "AssignedBrandList",
  CreateVariantVendor = "CreateVariantVendor",
  UpdateVariantVendor = "UpdateVariantVendor",
  AddManageEvent = "AddManageEvent",
  LoadProductInfoNotificationTemplates = "LoadProductInfoNotificationTemplates",
  DETAIL_INFO = "DETAIL_INFO",
}

export const ProductUpdatePage: React.FC<ProductUpdatePageProps> = ({
  isStaff,
  disabled,
  categories: categoryChoiceList,
  collections: collectionChoiceList,
  makers: makerChoiceList,
  errors,
  fetchCategories,
  fetchCollections,
  fetchMakers,
  fetchMoreCategories,
  fetchMoreCollections,
  fetchMoreMakers,
  images,
  header,
  placeholderImage,
  product,
  brandProductVariant,
  saveButtonBarState,
  variants,
  warehouses,
  onBack,
  onCopy,
  onDelete,
  onImageDelete,
  onImageEdit,
  onImageReorder,
  onImageUpload,
  onSubmit,
  onVariantAdd,
  onSetDefaultVariant,
  onVariantShow,
  onVariantUpdate,
  onVariantReorder,
  onVariantVendorSetDefault,
  onProductClick,
  onAssignSubPv,
  onUnassignSubPv,
  onBulkAssignMainPvs,
  onBulkUnassignMainPvs,
  onAssignDevPv,
  onUnassignDevPv,
  onAssignStandardPv,
  onUnassignStandardPv,
  onWarehouseConfigure,
  onProductVariantOnSale,
  productVariantOnSaleLoading,
}) => {
  // 재고 또는 제품의 id를 저장하는 state
  const [idForModal, setIdForModal] = useState(null);
  const [modalMode, setModalMode] = useState<ProductUpdateModalModeEnum | StockListModalModeEnum>(null);
  const [selectedRow, setSelectedRow] = React.useState<ProductVariantManageEventsTableDataSourceType>(null);
  const isFulfilledByVendor = !!product?.isFulfilledByVendor;
  const defaultVariant = getDefaultVariant(product);
  const { allCountries } = useShop();
  const { user } = useUser();

  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };

  const openModalWithoutNavigate = (modalMode: StockListModalModeEnum | ProductUpdateModalModeEnum, id: string) => {
    setModalMode(modalMode);
    setIdForModal(id);
  };

  const [selectedCategory, setSelectedCategory] = useStateFromProps(product?.category?.name || "");
  const [selectedCollections, setSelectedCollections] = useStateFromProps<string[]>(
    getChoices(maybe(() => product.collections, [])).map((collection) => collection.value)
  );

  const categories = getCategoryChoices(categoryChoiceList);
  const collections = getChoices(collectionChoiceList);
  const hasVariants = checkHasVariants(product);
  const sectionName = product?.isFulfilledByVendor ? sectionNames.productsB : sectionNames.productsA;

  const onShowDetailInfoModal = (record: ProductVariantManageEventsTableDataSourceType) => {
    setSelectedRow(record);
    setModalMode(ProductUpdateModalModeEnum.DETAIL_INFO);
  };
  return (
    <ProductUpdateForm
      onSubmit={onSubmit}
      product={product}
      brandProductVariant={brandProductVariant}
      categories={categories}
      collections={collections}
      selectedCollections={selectedCollections}
      setSelectedCategory={setSelectedCategory}
      setSelectedCollections={setSelectedCollections}
      warehouses={warehouses}
    >
      {({ change, data, handlers, hasChanged, submit }) => {
        const isNotForCreditsRefillData = data.isForCreditsRefill === false;
        return (
          <>
            <AppHeader onBack={onBack}>{sectionName}</AppHeader>
            <PageHeader title={header}>
              {isStaff && (
                <Space direction="horizontal" size="small">
                  <Button type="primary" onClick={() => setModalMode(ProductUpdateModalModeEnum.AssignedBrandList)}>
                    판매 브랜드 조회
                  </Button>
                  <Button type="primary" disabled={hasVariants || product?.isFulfilledByVendor} onClick={onCopy}>
                    제품 복사 생성
                  </Button>
                </Space>
              )}
            </PageHeader>
            <Space direction="vertical" size="large">
              <ProductOrganization
                isCreateMode={false}
                isFulfilledByVendor={product?.isFulfilledByVendor}
                categoryKind={product.category.kind}
                categories={categories}
                categoryInputDisplayValue={selectedCategory}
                collections={collections}
                collectionsInputDisplayValue={selectedCollections}
                data={data}
                disabled={disabled}
                errors={errors}
                fetchCategories={fetchCategories}
                fetchCollections={fetchCollections}
                fetchMoreCategories={fetchMoreCategories}
                fetchMoreCollections={fetchMoreCollections}
                productType={product?.productType}
                onCategoryChange={handlers.selectCategory}
                onCollectionChange={handlers.selectCollection}
              />
              <ProductDetailsForm
                product={product}
                variant={defaultVariant}
                data={data}
                disabled={disabled}
                isFulfilledByVendor={product?.isFulfilledByVendor}
                errors={errors}
                onChange={change}
                categoryKind={product.category.kind}
                onSaleOptions={
                  onProductVariantOnSale
                    ? {
                        outerVariantId: defaultVariant?.id,
                        innerVariantId: defaultVariant?.inner?.id,
                        firstAvailableForPurchase: defaultVariant?.firstAvailableForPurchase,
                        onClickOnSaleButton: onProductVariantOnSale,
                        loading: productVariantOnSaleLoading,
                        sku: defaultVariant?.sku,
                      }
                    : undefined
                }
              />
              {isNotForCreditsRefillData && (
                <Row gutter={[12, 12]}>
                  {isFulfilledByVendor === false && (
                    <Col span={8}>
                      <ProductInfoUpdateNotice product={product} onVariantUpdate={onVariantUpdate} />
                    </Col>
                  )}
                  <Col span={isFulfilledByVendor ? 12 : 8}>
                    <ProductPoNote data={data} errors={errors} onChange={change} />
                  </Col>
                  <Col span={isFulfilledByVendor ? 12 : 8}>
                    <ProductNote data={data} errors={errors} onChange={change} />
                  </Col>
                </Row>
              )}
              {isNotForCreditsRefillData && (
                <ProductImages
                  images={images}
                  placeholderImage={placeholderImage}
                  onImageDelete={onImageDelete}
                  onImageReorder={onImageReorder}
                  onImageEdit={onImageEdit}
                  onImageUpload={onImageUpload}
                />
              )}
              {data.attributes.length > 0 && isNotForCreditsRefillData && (
                <ProductAttributes
                  isProductPage
                  data={data}
                  errors={errors}
                  disabled={disabled}
                  isFulfilledByVendor={isFulfilledByVendor}
                  productVariant={defaultVariant}
                  makers={makerChoiceList}
                  fetchMakers={fetchMakers}
                  fetchMoreMakers={fetchMoreMakers}
                  onChange={change}
                  onSingleAttrChange={handlers.selectAttribute}
                  onMultiAttrChange={handlers.selectAttributeMultiple}
                  allCountries={allCountries}
                />
              )}
              {isNotForCreditsRefillData && (
                <>
                  {hasVariants === false ? (
                    <>
                      {isFulfilledByVendor === false && (
                        <ProductPricing
                          data={data}
                          product={product}
                          productVariant={defaultVariant}
                          disabled={disabled}
                          errors={errors}
                          onVariantUpdate={onVariantUpdate}
                        />
                      )}
                      <ProductVendorConnectCard
                        disabled={disabled}
                        product={product}
                        productVariant={defaultVariant}
                        onVariantVendorCreate={() => setModalMode(ProductUpdateModalModeEnum.CreateVariantVendor)}
                        onVariantVendorUpdate={(variantVendorId) =>
                          openModalWithoutNavigate(ProductUpdateModalModeEnum.UpdateVariantVendor, variantVendorId)
                        }
                        onVariantVendorSetDefault={onVariantVendorSetDefault}
                      />
                      <PvBaseSellPriceCard
                        disabled={disabled}
                        data={data}
                        productVariant={defaultVariant}
                        onVariantUpdate={onVariantUpdate}
                      />
                      {isFulfilledByVendor && (
                        <FbvBpvPrice
                          data={data}
                          onChange={change}
                          disabled={disabled}
                          brandProductVariant={brandProductVariant}
                        />
                      )}
                      {data.isDevPv === false && (
                        <ProductStocks
                          data={data}
                          productVariant={defaultVariant}
                          onVariantUpdate={onVariantUpdate}
                          disabled={disabled}
                          warehouses={warehouses}
                          onChange={change}
                          onWarehouseConfigure={onWarehouseConfigure}
                          openModalWithoutNavigate={openModalWithoutNavigate}
                          isFulfilledByVendor={isFulfilledByVendor}
                        />
                      )}

                      {isFulfilledByVendor === false &&
                        defaultVariant.trackInventory &&
                        (defaultVariant.isSubPv ? (
                          <MainPvListCard
                            disabled={disabled || data.isSubPv !== defaultVariant.isSubPv}
                            mainPvs={defaultVariant.mainPvs}
                            onProductClick={onProductClick}
                            onBulkAssign={onBulkAssignMainPvs}
                            onBulkUnassign={onBulkUnassignMainPvs}
                          />
                        ) : (
                          <SubPvCard
                            disabled={disabled || data.isSubPv !== defaultVariant.isSubPv}
                            subPv={defaultVariant.subPv}
                            onProductClick={onProductClick}
                            onLocationClick={(variantId) =>
                              openModalWithoutNavigate(StockListModalModeEnum.RackStockList, variantId)
                            }
                            onAssign={onAssignSubPv}
                            onUnassign={onUnassignSubPv}
                          />
                        ))}
                      {defaultVariant.isDevPv ? (
                        <DevPvCard
                          isDevPv
                          disabled={disabled}
                          devPvOf={defaultVariant.devPvOf}
                          onProductClick={onProductClick}
                          onAssign={onAssignStandardPv}
                          onUnassign={onUnassignStandardPv}
                        />
                      ) : (
                        isFulfilledByVendor === false &&
                        (product.category.kind === CategoryKindEnum.STANDARD ||
                          product.category.kind === CategoryKindEnum.B2B) &&
                        product.isExclusive && (
                          <DevPvCard
                            isDevPv={false}
                            disabled={disabled}
                            devPvs={defaultVariant.devPvs}
                            onProductClick={onProductClick}
                            onAssign={onAssignDevPv}
                            onUnassign={onUnassignDevPv}
                          />
                        )
                      )}
                      <Row gutter={[12, 12]}>
                        {isStaff && isFulfilledByVendor === false && (
                          <>
                            <Col span={8}>
                              <ProductVariantFile
                                variantId={defaultVariant.id}
                                files={product?.defaultVariant.designFiles}
                                fileType={"Design"}
                              />
                            </Col>
                            <Col span={8}>
                              <ProductVariantFile
                                variantId={defaultVariant.id}
                                files={product?.defaultVariant.estimateFiles}
                                fileType={"Estimate"}
                              />
                            </Col>
                          </>
                        )}
                      </Row>
                      <ProductVariantManageEvents
                        productVariant={defaultVariant}
                        loading={disabled}
                        onShowDetailInfoModal={onShowDetailInfoModal}
                      />
                    </>
                  ) : (
                    <ProductVariants
                      disabled={disabled}
                      variants={variants}
                      product={product}
                      onRowClick={onVariantShow}
                      onVariantAdd={onVariantAdd}
                      onVariantReorder={onVariantReorder}
                      onSetDefaultVariant={onSetDefaultVariant}
                    />
                  )}
                  {data.isDevPv === false && (
                    <ProductInfoNoti
                      data={data}
                      onChange={handlers.changeProductInfoNoti}
                      openTemplatesModal={() =>
                        setModalMode(ProductUpdateModalModeEnum.LoadProductInfoNotificationTemplates)
                      }
                    />
                  )}
                </>
              )}
            </Space>
            <BrandProductListModal
              open={modalMode === ProductUpdateModalModeEnum.AssignedBrandList}
              loading={!data}
              product={product}
              resetForCloseModal={resetForCloseModal}
              isFbv={isFulfilledByVendor}
            />
            <StockDetailAddEtcModal
              open={modalMode === StockListModalModeEnum.StockDetailAdd}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
              isFbv={isFulfilledByVendor}
            />
            <StockDetailLossModal
              open={modalMode === StockListModalModeEnum.StockDetailLoss}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
              isFbv={isFulfilledByVendor}
            />
            <StockDetailAdjustToZeroModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailAdjustToZero}
              loading={!data}
              stockId={idForModal}
              productVariant={{
                ...variants.find((variant) => variant.stocks.some((stock) => stock.id === idForModal)),
                product,
              }}
              onClose={resetForCloseModal}
            />
            <StockDivideOrCombineModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailDivideOrCombine}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
            />
            <RackStockListModal
              open={modalMode === StockListModalModeEnum.RackStockList}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
            />
            <StockDetailEventListModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailEventList}
              variantId={idForModal}
              onClose={resetForCloseModal}
              isFulfilledByVendor={isFulfilledByVendor}
            />
            {data.isForCreditsRefill === false && (
              <ProductVariantVendorCreateOrUpdateModal
                isCreateMode={modalMode === ProductUpdateModalModeEnum.CreateVariantVendor}
                open={
                  modalMode === ProductUpdateModalModeEnum.CreateVariantVendor ||
                  modalMode === ProductUpdateModalModeEnum.UpdateVariantVendor
                }
                loading={disabled}
                product={product}
                productVariant={defaultVariant}
                productVariantVendor={
                  modalMode === ProductUpdateModalModeEnum.CreateVariantVendor
                    ? null
                    : defaultVariant?.productVariantVendors.find((v) => v.id === idForModal)
                }
                onClose={resetForCloseModal}
                precision={data.priceDecimalPlaces}
              />
            )}
            <ProductVariantManageEventModal
              isCreateMode
              open={modalMode === ProductUpdateModalModeEnum.AddManageEvent}
              loading={disabled}
              manageEventType={null}
              choices={productVariantManageEventTypeChoices}
              onManageEventChange={(manageEvent) => change({ target: { name: "manageEvent", value: manageEvent } })}
              onSubmit={async () => {
                const isOk = await submit();
                if (isOk) {
                  resetForCloseModal();
                }
              }}
              onCancel={resetForCloseModal}
            />
            <ProductInfoNotificationTemplatesModal
              open={modalMode === ProductUpdateModalModeEnum.LoadProductInfoNotificationTemplates}
              loading={disabled}
              onClose={resetForCloseModal}
              onChange={handlers.changeProductInfoNoti}
            />
            <ProductVaraintManageEventDetailModal
              open={modalMode === ProductUpdateModalModeEnum.DETAIL_INFO}
              onCancel={() => {
                setSelectedRow(null);
                setModalMode(null);
              }}
              selectedRow={selectedRow}
            />
            <SaveButtonBar
              onCancel={onBack}
              onDelete={onDelete}
              onSave={() => {
                const isValid = checkProductUpdateRequired(product, data, user.isHqStaff);
                if (isValid) {
                  setModalMode(ProductUpdateModalModeEnum.AddManageEvent);
                }
              }}
              state={saveButtonBarState}
              disabled={disabled || !hasChanged}
            />
          </>
        );
      }}
    </ProductUpdateForm>
  );
};
</file>

