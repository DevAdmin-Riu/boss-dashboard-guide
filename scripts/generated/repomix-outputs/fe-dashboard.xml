import makeMutation from "@hooks/makeMutation";
import { productErrorFragment } from "@src/api/fragments/errors";
import gql from "graphql-tag";

import { ProductCommonImageCreate, ProductCommonImageCreateVariables } from "./types/ProductCommonImageCreate";
import { ProductCommonImageDelete, ProductCommonImageDeleteVariables } from "./types/ProductCommonImageDelete";
import { ProductCommonImageReorder, ProductCommonImageReorderVariables } from "./types/ProductCommonImageReorder";
import { ProductCommonImageUpdate, ProductCommonImageUpdateVariables } from "./types/ProductCommonImageUpdate";

export const productCommonImageCreateMutation = gql`
  ${productErrorFragment}
  mutation ProductCommonImageCreate($image: Upload!, $alt: String) {
    productCommonImageCreate(input: { alt: $alt, image: $image }) {
      errors: productErrors {
        ...ProductErrorFragment
      }
      shop {
        productCommonImages {
          id
          alt
          sortOrder
          url
        }
      }
    }
  }
`;
export const useProductCommonImageCreateMutation = makeMutation<
  ProductCommonImageCreate,
  ProductCommonImageCreateVariables
>(productCommonImageCreateMutation);

export const productCommonImagesReorder = gql`
  ${productErrorFragment}
  mutation ProductCommonImageReorder($imagesIds: [ID]!) {
    productCommonImageReorder(imagesIds: $imagesIds) {
      errors: productErrors {
        ...ProductErrorFragment
      }
      shop {
        productCommonImages {
          id
          alt
          sortOrder
          url
        }
      }
    }
  }
`;
export const useProductCommonImagesReorder = makeMutation<
  ProductCommonImageReorder,
  ProductCommonImageReorderVariables
>(productCommonImagesReorder);

