<file path="src/app/views/order/orders/components/OrderRefundModal/OrderRefundModal.tsx">
import { paymentTerm } from "@assets/messages/commonMsg";
import {
  OrderRefundInput,
  OrderRefundLineInput,
  RefundQAQType,
  RefundQAStatus,
  RequestOriginTypeEnum,
} from "@src/api/types/globalTypes";
import { getFormInputNumberMaxValueRule } from "@src/app/components/antd/Form/validators";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  useCustomerRefundProcessUpdateMutation,
  useOrderRefundAndCustomerRefundFinishCombinedMutation,
} from "@src/app/views/order/orders/api/mutations";
import {
  OrderDetails_order,
  OrderDetails_order_lines,
  OrderDetails_order_refundQA,
} from "@src/app/views/order/orders/api/types/OrderDetails";
import { getMoneyFormat } from "@src/app/views/product/products/utils/data";
import { checkIsCardPay, checkIsVbankPay, findBankNameByCode, transformIsFBV } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import {
  Button,
  Card,
  Descriptions,
  Divider,
  Form,
  Input,
  InputNumber,
  Modal,
  Row,
  Select,
  Space,
  Table,
  Typography,
} from "antd";
import DescriptionsItem from "antd/lib/descriptions/Item";
import { useForm } from "antd/lib/form/Form";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useRef, useState } from "react";

import OrderPaymentTable from "../OrderPayment/OrderPaymentTable";
import RefundInfoTable from "../RefundInfoTable/RefundInfoTable";
import { getRefundOrderLineTableSettings, makeReturnDeliveryFeeInputName } from "./OrderRefundOrderLineTableSettings";
import { calculateBundleRefundLines, checkRefundStatusApproved } from "./utils";

interface IOrderRefundForm extends OrderRefundInput {
  writtenBankCode?: string;
  writtenAccountNumber?: string;
  writtenAccountHolderName?: string;
}

interface OrderRefundModalProps {
  open: boolean;
  order: OrderDetails_order;
  onClose: () => void;
  refetchOrderDetails: () => void;
  refundId: string;
}

const OrderRefundModal: React.FC<OrderRefundModalProps> = ({
  open,
  order,
  onClose,
  refetchOrderDetails: refetchRefundedList,
}) => {
  const shopData = useShop();
  const { refundBankCodeChoices } = shopData;
  const [visibleConfirmModal, setVisibleConfirmModal] = useState<boolean>(false);
  const [refundFlag, setRefundFlag] = useState<boolean>(false);
  const lastPayment = order?.lastPayment;
  // 세트상품의 대표 구성품이 아닌 라인 제외 (isMainPv === false)
  // 환불 가능 여부: 세트상품인 경우 bundleQty - bundleRefundedQty, 아닌 경우 orderedOrFulfillQty - quantityRefunded
  const orderLines = order?.lines.filter((line) => {
    if (line.isMainPv === false) {
      return false;
    }
    const refundableQty =
      line.bundleQty !== null
        ? line.bundleQty - (line.bundleRefundedQty ?? 0)
        : line.orderedOrFulfillQty - line.quantityRefunded;
    return refundableQty > 0;
  });

  const [form] = useForm<IOrderRefundForm>();

  const refundQuestionCheck = JSON.stringify(
    order?.refundQA?.filter(
      (item) =>
        item.status === RefundQAStatus.REFUND_PENDING && item.qType === RefundQAQType.REFUND && !item.refundStatus
    )
  );

  const virtualAccountRefund: undefined | OrderDetails_order_refundQA =
    refundQuestionCheck && JSON.parse(refundQuestionCheck)[0];

  const isVbankPay: boolean = checkIsVbankPay(order?.lastPayment.token);
  const checkRefundAccountVal: boolean = virtualAccountRefund && checkRefundStatusApproved(virtualAccountRefund);
  const useWrittenVbankInfo = isVbankPay && checkRefundAccountVal === undefined;
  const useExistVbankInfo = isVbankPay && checkRefundAccountVal === true;

  const [useCustomerRefundProcessUpdate] = useCustomerRefundProcessUpdateMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.customerRefundProcessUpdate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("문의 승인 완료");
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
    onError: () => {
      showNotificationError("문의 승인중 오류가 발생했습니다. 관리자에게 문의하세요.");
    },
  });

  const [useOrderRefund, { loading: orderRefundLoading }] = useOrderRefundAndCustomerRefundFinishCombinedMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.orderRefundAndCustomerRefundFinishCombined.errors;
        if (errors.length === 0) {
          const existTaxInvoices = order?.taxInvoices.length > 0;

          if (JSON.parse(refundQuestionCheck).length > 0) {
            useCustomerRefundProcessUpdate({
              variables: {
                id: JSON.parse(refundQuestionCheck)[0].id,
                input: {
                  refundStatus: true,
                  refundTransaction: data.orderRefundAndCustomerRefundFinishCombined.refundTransaction.id,
                },
              },
            });
          }

          showNotificationSuccess(
            <Space direction="vertical">
              <Typography.Text strong>환불 처리로 인해 아래 정보가 변경되었습니다.</Typography.Text>
              <Divider />
              <Typography.Text type="warning">본부수익금 정산금액이 다시 계산되었습니다.</Typography.Text>
              {checkIsCardPay(lastPayment.token) && (
                <Typography.Text type="danger" strong>
                  카드 결제 금액이 환불된 경우, 카드 환불 처리 내역 정상 여부를 반드시 확인하세요.
                </Typography.Text>
              )}
              {existTaxInvoices && (
                <Typography.Text type="warning">
                  세금계산서가 미발행 상태의 주문인 경우에는 발행 금액이 변경된 상태로 발행요청됩니다.
                </Typography.Text>
              )}
            </Space>,
            false
          );
          form.resetFields();
          onClose();
          refetchRefundedList();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
  });
  const [refundCashableCredits, setRefundCashableCredits] = useState<number>(0);
  const [refundNonCashableCredits, setRefundNonCashableCredits] = useState<number>(0);
  const [maxCashableCredits, setMaxCashableCredits] = useState<number>(0);
  const [maxNonCashableCredits, setMaxNonCashableCredits] = useState<number>(0);
  const [refundRcoins, setRefundRcoins] = useState<number>(0);
  const [rcoinsMax, setRcoinsMax] = useState<number>(0);
  const [refundPaid, setRefundPaid] = useState<number>(0);
  const [paidMax, setPaidMax] = useState<number>(0);
  const [returnDeliveryFee, setReturnDeliveryFee] = useState<number>(0);

  const inputNumbersRef = useRef({});
  const [refundTotal, setRefundTotal] = useState<number>(0);
  const [disableCalcRefundTotalButton, setDisableCalcRefundTotalButton] = useState<boolean>(true);

  const [selectedRowIds, setSelectedRowIds] = React.useState<string[]>([]);

  const rowSelection: TableRowSelection<OrderDetails_order_lines> = {
    selectedRowKeys: selectedRowIds,
    onChange: (_selectedRowKeys, selectedRows) => {
      setSelectedRowIds(selectedRows.map((selected) => selected.id));
    },
    getCheckboxProps: (record: OrderDetails_order_lines) => ({
      disabled: record.isFulfilledByVendor,
    }),
  };

  const checkCalcRefundTotalButtonStatus = () => {
    const length = selectedRowIds?.length;
    if (length <= 0) {
      setDisableCalcRefundTotalButton(true);
      return;
    }

    for (let i = 0; i < length; i++) {
      const id = selectedRowIds[i];
      const quantity = utils.convertToNumberWrapper(form.getFieldValue([id]));
      if (quantity <= 0) {
        setDisableCalcRefundTotalButton(true);
        return;
      }
    }

    setDisableCalcRefundTotalButton(false);
  };

  const checkSelectedRow = (id: string) => {
    const selectedRowId = selectedRowIds?.find((selectedRowId) => selectedRowId === id);

    return !!selectedRowId;
  };

  const resetRefundProductQtyInputField = () => {
    const length = orderLines?.length;
    if (length <= 0) {
      return;
    }

    for (let i = 0; i < length; i++) {
      const id = orderLines[i].id;
      if (checkSelectedRow(id) === false) {
        form.setFields([{ name: id, value: undefined }]);
      }
    }
  };

  useEffect(() => {
    checkCalcRefundTotalButtonStatus();
    resetRefundProductQtyInputField();
  }, [selectedRowIds]);

  const resetInputField = (level: number) => {
    if (level >= 4) {
      setRefundPaid(undefined);
      form.setFieldsValue({ amount: undefined });
    }
    if (level >= 3) {
      setRefundCashableCredits(undefined);
      form.setFieldsValue({ cashableCredits: undefined });
    }
    if (level >= 2) {
      setRefundNonCashableCredits(undefined);
      form.setFieldsValue({ nonCashableCredits: undefined });
    }
    if (level >= 1) {
      setRefundRcoins(undefined);
      form.setFieldsValue({ rcoins: undefined });
    }
  };

  useEffect(() => {
    if (lastPayment) {
      const newPaidMax = Math.min(lastPayment.capturedAmount, refundTotal - returnDeliveryFee);
      const newCashableCreditsMax = Math.min(
        lastPayment.capturedCashableCredits,
        refundTotal - returnDeliveryFee - Math.min(utils.convertToNumberWrapper(refundPaid), newPaidMax)
      );
      const newNonCashableCreditsMax = Math.min(
        lastPayment.capturedNonCashableCredits,
        refundTotal -
          returnDeliveryFee -
          Math.min(utils.convertToNumberWrapper(refundPaid), newPaidMax) -
          Math.min(utils.convertToNumberWrapper(refundCashableCredits), newCashableCreditsMax)
      );
      const newRcoinsMax = Math.min(
        lastPayment.capturedRcoins,
        refundTotal -
          returnDeliveryFee -
          Math.min(utils.convertToNumberWrapper(refundPaid), newPaidMax) -
          Math.min(utils.convertToNumberWrapper(refundCashableCredits), newCashableCreditsMax) -
          Math.min(utils.convertToNumberWrapper(refundNonCashableCredits), newNonCashableCreditsMax)
      );

      setPaidMax(newPaidMax);
      setMaxCashableCredits(newCashableCreditsMax < 0 ? 0 : newCashableCreditsMax);
      setMaxNonCashableCredits(newNonCashableCreditsMax < 0 ? 0 : newNonCashableCreditsMax);
      setRcoinsMax(newRcoinsMax);
    }
  }, [refundTotal, refundCashableCredits, refundNonCashableCredits, refundRcoins, refundPaid, returnDeliveryFee]);

  const onCalcRefundProductPrice = () => {
    const length = selectedRowIds?.length;
    if (length <= 0) {
      showNotificationError("환불 상품이 선택되지 않았습니다.");
      return;
    }

    // selectedRowIds에서 orderLines에 있는 ID만 필터링 (세트 상품의 다른 구성품 제외)
    const validSelectedIds = selectedRowIds.filter((id) => orderLines.some((line) => line.id === id));

    if (validSelectedIds.length === 0) {
      showNotificationError("환불 가능한 상품이 선택되지 않았습니다.");
      return;
    }

    let totalRefundAmount = 0;
    let totalReturnDeliveryFee = 0;
    for (let i = 0; i < validSelectedIds.length; i++) {
      const id = validSelectedIds[i];
      // 세트상품인 경우 세트 수량, 아닌 경우 제품 수량
      const inputQuantity = utils.convertToNumberWrapper(form.getFieldValue([id]));
      const returnDeliveryFee = utils.convertToNumberWrapper(form.getFieldValue([makeReturnDeliveryFeeInputName(id)]));
      const orderLine = orderLines.find((orderLine) => orderLine.id === id);

      if (orderLine) {
        if (inputQuantity <= 0) {
          showNotificationError(`환불 상품 [${orderLine.productSku}]: 수량이 입력되지 않았습니다.`);
          return;
        }

        // 세트상품인 경우: 모든 구성품의 금액과 총 수량 계산
        if (orderLine.bundleQty !== null && orderLine.bundleOtherOrderLines?.length > 0) {
          const bundleRefundLines = calculateBundleRefundLines(orderLine, inputQuantity);

          // 모든 구성품의 총 환불 금액 계산 (대표 구성품만 단가 있음)
          const mainProductQty = bundleRefundLines[0].quantity / orderLine.bundleInfoQty;
          totalRefundAmount += mainProductQty * orderLine.unitPriceGrossAmount;

          // 총 구성품 수량으로 반품배송비 계산
          const totalRefundQty = bundleRefundLines.reduce((sum, line) => sum + line.quantity, 0);
          totalReturnDeliveryFee += returnDeliveryFee * totalRefundQty;
        } else {
          // 비세트상품인 경우: 제품 수량 × 단가
          totalRefundAmount += inputQuantity * orderLine.unitPriceGrossAmount;
          totalReturnDeliveryFee += returnDeliveryFee;
        }
      } else {
        showNotificationError("페이지 새로고침 후 다시 시도해 주세요.");
        return;
      }
    }

    if (totalRefundAmount <= 0) {
      showNotificationError("환불 상품 총액이 0 이하입니다. 페이지 새로고침 후 다시 시도해 주세요.");
      return;
    }

    if (totalRefundAmount < totalReturnDeliveryFee) {
      showNotificationError(
        "반품 배송비 총액이 환불 상품 총액보다 큽니다. 환불 상품 총액에서 반품배송비 총액을 차감한 금액만 고객에게 환불 할 수 있습니다."
      );
      return;
    }

    // 환불 금액 반올림 처리
    totalRefundAmount = Math.round(totalRefundAmount);

    setRefundTotal(totalRefundAmount);
    setReturnDeliveryFee(totalReturnDeliveryFee);

    resetInputField(4);
  };

  const getRefundLinesInfo = () => {
    const length = selectedRowIds?.length;
    if (length <= 0) {
      showNotificationError("환불 상품이 선택되지 않았습니다.");
      return undefined;
    }

    // selectedRowIds에서 orderLines에 있는 ID만 필터링 (세트 상품의 다른 구성품 제외)
    const validSelectedIds = selectedRowIds.filter((id) => orderLines.some((line) => line.id === id));

    if (validSelectedIds.length === 0) {
      showNotificationError("환불 가능한 상품이 선택되지 않았습니다.");
      return undefined;
    }

    const refundLines: OrderRefundLineInput[] = [];

    for (let i = 0; i < validSelectedIds.length; i++) {
      const id = validSelectedIds[i];
      // 세트상품인 경우 세트 수량, 아닌 경우 제품 수량
      const inputQuantity = utils.convertToNumberWrapper(form.getFieldValue([id]));
      const returnDeliveryFee = utils.convertToNumberWrapper(form.getFieldValue([makeReturnDeliveryFeeInputName(id)]));
      const orderLine = orderLines.find((orderLine) => orderLine.id === id);

      if (!orderLine) {
        continue;
      }

      // 세트상품인 경우: 유틸 함수 사용
      if (orderLine.bundleQty !== null && orderLine.bundleOtherOrderLines?.length > 0) {
        const bundleRefundLines = calculateBundleRefundLines(orderLine, inputQuantity);

        // 총 구성품 수량으로 반품배송비 계산
        const totalRefundQty = bundleRefundLines.reduce((sum, line) => sum + line.quantity, 0);
        const totalReturnDeliveryFee = returnDeliveryFee * totalRefundQty;

        bundleRefundLines.forEach((line) => {
          // isMainPv가 true인 구성품에만 반품배송비 적용
          const targetOrderLine = order.lines.find((ol) => ol.id === line.orderLineId);
          const isMainPv = targetOrderLine?.isMainPv === true;

          refundLines.push({
            orderLineId: line.orderLineId,
            qty: line.quantity,
            returnDeliveryFee: isMainPv ? totalReturnDeliveryFee : 0,
          });
        });
      } else {
        // 비세트상품인 경우: 그대로 처리
        refundLines.push({
          orderLineId: id,
          qty: inputQuantity,
          returnDeliveryFee,
        });
      }
    }
    return refundLines;
  };

  const validateRefundTotal = (
    refundAmount: number,
    refundCashableCredits: number,
    refundNonCashableCredits: number,
    refundRcoins: number,
    returnDeliveryFee: number
  ) =>
    refundTotal === refundAmount + refundCashableCredits + refundNonCashableCredits + refundRcoins + returnDeliveryFee;

  const onFinish = (formData: IOrderRefundForm) => {
    const refundLines = getRefundLinesInfo();
    if (!refundLines) {
      return;
    }

    const { bankCode, accountNumber, accountHolderName } = formData;
    const refundAmount = utils.convertToNumberWrapper(formData.amount);
    const refundCashableCredits = utils.convertToNumberWrapper(formData.cashableCredits);
    const refundNonCashableCredits = utils.convertToNumberWrapper(formData.nonCashableCredits);
    const refundRcoins = utils.convertToNumberWrapper(formData.rcoins);
    const writtenBankCode = form.getFieldValue("writtenBankCode");
    const writtenAccountNumber = form.getFieldValue("writtenAccountNumber");
    const writtenAccountHolderName = form.getFieldValue("writtenAccountHolderName");

    const isValidRefundTotal = validateRefundTotal(
      refundAmount,
      refundCashableCredits,
      refundNonCashableCredits,
      refundRcoins,
      returnDeliveryFee
    );
    if (isValidRefundTotal === false) {
      showNotificationError("환불할 상품 총액과 입력한 환불 금액이 일치하지 않습니다.");
      return;
    }

    const accountHolderNameForInput = useWrittenVbankInfo ? writtenAccountHolderName : accountHolderName;
    const accountNumberForInput = useWrittenVbankInfo ? writtenAccountNumber : accountNumber;
    const bankCodeForInput = useWrittenVbankInfo ? writtenBankCode : bankCode;
    if (isVbankPay) {
      if (utils.isEmpty(accountHolderNameForInput, true)) {
        showNotificationError("예금주명 정보가 없습니다.");
        return;
      }
      if (utils.isEmpty(accountNumberForInput, true)) {
        showNotificationError("계좌번호 정보가 없습니다.");
        return;
      }
      if (utils.isEmpty(bankCodeForInput, true)) {
        showNotificationError("은행 정보가 없습니다.");
        return;
      }
    }

    const input: OrderRefundInput = {
      amount: refundAmount,
      cashableCredits: refundCashableCredits,
      nonCashableCredits: refundNonCashableCredits,
      rcoins: refundRcoins,
      refundLines,
      requestOriginType: RequestOriginTypeEnum.DASHBOARD,
      allCancelRefund: false,
    };
    if (isVbankPay) {
      input.bankCode = bankCodeForInput;
      input.accountNumber = accountNumberForInput;
      input.accountHolderName = accountHolderNameForInput;
    }

    const orderRefundVariables = {
      id: order.id,
      input,
    };

    const refundQaId =
      refundQuestionCheck &&
      JSON.parse(refundQuestionCheck).length > 0 &&
      JSON.parse(refundQuestionCheck)[0].status === RefundQAStatus.REFUND_PENDING
        ? JSON.parse(refundQuestionCheck)[0].id
        : null;

    useOrderRefund({
      variables: {
        input: {
          orderId: orderRefundVariables.id,
          orderRefundInput: orderRefundVariables.input,
          refundQaId,
        },
      },
    });
    setVisibleConfirmModal(false);
    setSelectedRowIds([]);
  };

  const makeConfirmContentNode = () => {
    const convReturnDeliveryFee = utils.convertToNumberWrapper(returnDeliveryFee);
    const convRefundPaid = utils.convertToNumberWrapper(refundPaid);
    const convRefundCashableCredits = utils.convertToNumberWrapper(refundCashableCredits);
    const convRefundNonCashableCredits = utils.convertToNumberWrapper(refundNonCashableCredits);
    const convRefundRcoins = utils.convertToNumberWrapper(refundRcoins);
    const finalRefundTotal = refundTotal - convReturnDeliveryFee;

    return (
      <Space direction="vertical">
        <Descriptions
          title="환불 정보"
          column={1}
          bordered={true}
          size="small"
          labelStyle={{ width: "30%" }}
          contentStyle={{ fontWeight: "bold" }}
        >
          <DescriptionsItem label="환불 상품 총액" contentStyle={{ float: "right" }}>
            <NumberComponent value={refundTotal} includeCurrency={true} />
          </DescriptionsItem>
          <DescriptionsItem label="반품 배송비 청구" contentStyle={{ float: "right" }}>
            <NumberComponent value={convReturnDeliveryFee} includeCurrency={true} />
          </DescriptionsItem>
          <DescriptionsItem label="최종환불금액" contentStyle={{ float: "right" }}>
            <NumberComponent value={finalRefundTotal} includeCurrency={true} />
          </DescriptionsItem>
        </Descriptions>
        <Descriptions
          title="환불 금액"
          column={1}
          bordered={true}
          size="small"
          labelStyle={{ width: "30%" }}
          contentStyle={{ fontWeight: "bold" }}
        >
          <DescriptionsItem label={`${paymentTerm.cashOrCard} 환불액`} contentStyle={{ float: "right" }}>
            <NumberComponent value={convRefundPaid} includeCurrency={true} />
          </DescriptionsItem>
          <DescriptionsItem label={`${paymentTerm.cashableCredits} 환불액`} contentStyle={{ float: "right" }}>
            <NumberComponent value={convRefundCashableCredits} includeCurrency={true} />
          </DescriptionsItem>
          <DescriptionsItem label={`${paymentTerm.nonCashableCredits} 환불액`} contentStyle={{ float: "right" }}>
            <NumberComponent value={convRefundNonCashableCredits} includeCurrency={true} />
          </DescriptionsItem>
          <DescriptionsItem label={`${paymentTerm.rcoins} 환불액`} contentStyle={{ float: "right" }}>
            <NumberComponent value={convRefundRcoins} includeCurrency={true} />
          </DescriptionsItem>
        </Descriptions>
      </Space>
    );
  };

  const isInvalidInputValue =
    refundTotal <= 0 ||
    validateRefundTotal(
      utils.convertToNumberWrapper(refundPaid),
      utils.convertToNumberWrapper(refundCashableCredits),
      utils.convertToNumberWrapper(refundNonCashableCredits),
      utils.convertToNumberWrapper(refundRcoins),
      utils.convertToNumberWrapper(returnDeliveryFee)
    ) === false;

  const okButtonProps = {
    danger: true,
    disabled: orderRefundLoading || isInvalidInputValue,
  };
  const okText = "환불";

  // NOTE : 환불 요청사항이 있으면 flag 변경
  useEffect(() => {
    if (refundQuestionCheck?.length > 0) {
      setRefundFlag(true);
    }
  }, [refundQuestionCheck, open]);

  // NOTE : 무한 렌더링 방지로 인한 useEffect 분리
  useEffect(() => {
    if (open && refundFlag) {
      const parseRefundQuestion = JSON.parse(refundQuestionCheck);
      const parseRefundQuestionFilter = parseRefundQuestion.filter(
        (item: OrderDetails_order_refundQA) =>
          item.status === RefundQAStatus.REFUND_PENDING &&
          item.qType === RefundQAQType.REFUND &&
          item.refundStatus === false
      );
      if (parseRefundQuestionFilter?.length > 0) {
        interface RefundQuestionLine {
          order_line_id: string;
          quantity: string | number;
        }
        const parseRefundQuestionLines = JSON.parse(parseRefundQuestionFilter[0]?.qOrderLineInfo).map(
          (item: RefundQuestionLine) => ({
            ...item,
            quantity: parseFloat(String(item.quantity)),
          })
        );
        const value = parseRefundQuestionLines
          .filter((item: { quantity: number }) => item.quantity !== 0)
          .map((item: { order_line_id: string }) => item.order_line_id);
        setSelectedRowIds(value);
        parseRefundQuestionLines.forEach((item: { order_line_id: string; quantity: number }) => {
          const orderLine = order?.lines.find((line) => line.id === item.order_line_id);
          let refundQty = item.quantity;

          // 세트상품인 경우 bundleInfoQty로 나눠서 세트 수량으로 변환
          if (orderLine?.bundleQty !== null && orderLine?.bundleInfoQty) {
            refundQty = item.quantity / orderLine.bundleInfoQty;
          }

          form.setFields([
            {
              name: item.order_line_id,
              value: refundQty,
            },
          ]);
        });
      }
      setRefundFlag(false);
    }

    if (open && selectedRowIds?.length > 0 && refundFlag === false) {
      let flag = false;
      const length = selectedRowIds.length;
      for (let i = 0; i < length; i++) {
        const id = selectedRowIds[i];
        const orderLine = orderLines.find((orderLine) => orderLine.id === id);
        if (!orderLine) {
          flag = true;
        }
      }
      if (!flag) {
        onCalcRefundProductPrice();
      }
    }
  }, [refundFlag]);

  if (!order) {
    return <></>;
  }

  const qRefundAccountInfo = virtualAccountRefund?.qRefundAccountInfo;
  const checkProductReturned: boolean =
    virtualAccountRefund?.isProductReturned &&
    virtualAccountRefund?.productReturnedAt === null &&
    virtualAccountRefund?.status === RefundQAStatus.COLLECTED_INSPECT;

  const columns = getRefundOrderLineTableSettings(
    form,
    inputNumbersRef,
    checkCalcRefundTotalButtonStatus,
    checkSelectedRow
  );
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <Modal
        width={1024}
        forceRender
        destroyOnClose
        open={open}
        closable={false}
        footer={
          <>
            <Button
              key="back"
              onClick={() => {
                form.resetFields();
                onClose();
              }}
            >
              뒤로
            </Button>

            <Button
              key="submit"
              type="primary"
              danger={okButtonProps.danger}
              disabled={okButtonProps.disabled || checkProductReturned}
              onClick={() => {
                setVisibleConfirmModal(true);
                form.setFieldValue("bankCode", qRefundAccountInfo?.bankCode);
                form.setFieldValue("accountNumber", qRefundAccountInfo?.accountNumber);
                form.setFieldValue("accountHolderName", qRefundAccountInfo?.accountHolderName);
              }}
            >
              {okText}
            </Button>
          </>
        }
        title={"환불 처리"}
        maskClosable={false}
      >
        <Form colon={false} labelCol={{ span: 24 }} wrapperCol={{ span: 24 }} form={form} onFinish={onFinish}>
          <Space direction="vertical" size="small">
            <Card>
              <Space direction="vertical">
                <Typography.Title level={5}>결제정보</Typography.Title>
                <OrderPaymentTable order={order} />
              </Space>
            </Card>
            {order.refundQA && order.refundQA.length > 0 && (
              <Card>
                <Typography.Title level={5}>환불 문의 정보</Typography.Title>
                <Space direction="vertical" size="small">
                  <RefundInfoTable order={order} />
                </Space>
              </Card>
            )}
            <Card>
              <Space direction="horizontal">
                <Typography.Title level={5}>환불 상품 선택</Typography.Title>
                <Typography.Text type="danger" strong>
                  {transformIsFBV(true)} 상품은 환불할 수 없습니다.
                </Typography.Text>
              </Space>
              <Space direction="vertical" size="small">
                <TableVatLegend isIncludeVat={true} />
                <Table
                  {...commonTableProps}
                  loading={orderRefundLoading}
                  columns={columns}
                  dataSource={orderLines}
                  rowSelection={rowSelection}
                  scroll={{ x: tableWidthSum, y: 400 }}
                />
                <Descriptions column={1} bordered={true} size="small" labelStyle={{ width: "50%" }}>
                  <DescriptionsItem
                    label={
                      <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                        <Typography.Text strong>환불 상품 총액</Typography.Text>
                      </Space>
                    }
                    contentStyle={{ fontWeight: "bold" }}
                  >
                    <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                      <NumberComponent value={refundTotal} includeCurrency={true} />
                      <Button
                        type="primary"
                        shape="round"
                        onClick={onCalcRefundProductPrice}
                        disabled={disableCalcRefundTotalButton}
                      >
                        환불 상품 총액 계산
                      </Button>
                    </Space>
                  </DescriptionsItem>
                </Descriptions>
              </Space>
            </Card>
            <Card>
              <Typography.Title type="warning" level={5}>
                환불 상품 정보 변경 후에는 반드시 환불 상품 총액 계산을 다시 해야합니다.
              </Typography.Title>
            </Card>
            <Card>
              <Space direction="vertical" size="small">
                <Descriptions
                  column={1}
                  bordered={true}
                  size="small"
                  labelStyle={{ width: "50%" }}
                  extra={<TableVatLegend isIncludeVat={true} />}
                >
                  <DescriptionsItem
                    label={
                      <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                        <Typography.Text strong>반품배송비 총액</Typography.Text>
                      </Space>
                    }
                    contentStyle={{ fontWeight: "bold" }}
                  >
                    <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                      <NumberComponent value={returnDeliveryFee} includeCurrency={true} />
                    </Space>
                  </DescriptionsItem>
                  <DescriptionsItem
                    label={
                      <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                        <Typography.Text strong>최종 환불 금액</Typography.Text>
                      </Space>
                    }
                    contentStyle={{ fontWeight: "bold" }}
                  >
                    <Space direction="horizontal" style={{ width: "100%", justifyContent: "center" }}>
                      <NumberComponent value={refundTotal - returnDeliveryFee} includeCurrency={true} />
                    </Space>
                  </DescriptionsItem>
                </Descriptions>
              </Space>
            </Card>
            <Card>
              <Row justify="space-between">
                <Typography.Title level={5}>환불 금액 입력</Typography.Title>
                <TableVatLegend isIncludeVat={true} />
              </Row>
              {useWrittenVbankInfo && (
                <>
                  <Space
                    direction="horizontal"
                    size="large"
                    style={{
                      width: "100%",
                      justifyContent: "center",
                      display: "grid",
                      gridTemplateColumns: "1fr 1fr 1fr",
                    }}
                  >
                    <Form.Item label="예금주" name="writtenAccountHolderName">
                      <Input placeholder="예금주명을 입력해주세요" />
                    </Form.Item>
                    <Form.Item label="은행명" name="writtenBankCode">
                      <Select options={refundBankCodeChoices} placeholder="은행을 선택해 주세요." />
                    </Form.Item>
                    <Form.Item label="계좌번호" name="writtenAccountNumber">
                      <Input placeholder="입금받으실 계좌번호를 입력해주세요" />
                    </Form.Item>
                  </Space>
                </>
              )}
              {useExistVbankInfo && (
                <>
                  <Form.Item name="accountHolderName" hidden>
                    <Input />
                  </Form.Item>
                  <Form.Item name="accountNumber" hidden>
                    <Input />
                  </Form.Item>
                  <Form.Item name="bankCode" hidden>
                    <Input />
                  </Form.Item>
                  <Descriptions
                    bordered
                    title="계좌 정보"
                    size="small"
                    extra={
                      <Typography.Text type="danger" strong style={{ display: "block" }}>
                        해당 환불건은 가상계좌로 입금된 건이며 고객은 계좌이체로 환불 받으려 합니다.
                      </Typography.Text>
                    }
                    style={{ margin: "15px 0" }}
                  >
                    <Descriptions.Item label="예금주">{qRefundAccountInfo?.accountHolderName}</Descriptions.Item>
                    <Descriptions.Item label="은행명">
                      {findBankNameByCode(refundBankCodeChoices, qRefundAccountInfo?.bankCode)}
                    </Descriptions.Item>
                    <Descriptions.Item label="계좌번호">{qRefundAccountInfo?.accountNumber}</Descriptions.Item>
                  </Descriptions>
                </>
              )}
              <Space
                direction="horizontal"
                size="large"
                style={{
                  width: "100%",
                  justifyContent: "center",
                  display: "grid",
                  gridTemplateColumns: "1fr 1fr 1fr 1fr",
                }}
              >
                <Form.Item
                  name="amount"
                  label={`${paymentTerm.cashOrCard} 환불액`}
                  rules={[getFormInputNumberMaxValueRule({ max: paidMax })]}
                  help={
                    <Typography.Text type="warning">
                      최대 환불 가능 {paymentTerm.cashOrCard}: {getMoneyFormat(paidMax)}
                    </Typography.Text>
                  }
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true })}
                    value={refundPaid}
                    disabled={paidMax <= 0 || refundTotal <= 0}
                    onChange={(value) => {
                      setRefundPaid(utils.convertToNumberWrapper(value));
                      resetInputField(3);
                    }}
                  />
                </Form.Item>
                <Form.Item
                  label={`${paymentTerm.cashableCredits} 환불액`}
                  name="cashableCredits"
                  rules={[getFormInputNumberMaxValueRule({ max: maxCashableCredits })]}
                  help={
                    <Typography.Text type="warning">
                      최대 환불 가능 {paymentTerm.cashableCredits}: {getMoneyFormat(maxCashableCredits)}
                    </Typography.Text>
                  }
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true })}
                    value={refundCashableCredits}
                    disabled={maxCashableCredits <= 0 || refundTotal <= 0}
                    onChange={(value) => {
                      setRefundCashableCredits(utils.convertToNumberWrapper(value));
                      resetInputField(2);
                    }}
                  />
                </Form.Item>
                <Form.Item
                  label={`${paymentTerm.nonCashableCredits} 환불액`}
                  name="nonCashableCredits"
                  rules={[getFormInputNumberMaxValueRule({ max: maxNonCashableCredits })]}
                  help={
                    <Typography.Text type="warning">
                      최대 환불 가능 {paymentTerm.nonCashableCredits}: {getMoneyFormat(maxNonCashableCredits)}
                    </Typography.Text>
                  }
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true })}
                    value={refundNonCashableCredits}
                    disabled={maxNonCashableCredits <= 0 || refundTotal <= 0}
                    onChange={(value) => {
                      setRefundNonCashableCredits(utils.convertToNumberWrapper(value));
                      resetInputField(1);
                    }}
                  />
                </Form.Item>
                <Form.Item
                  label={`${paymentTerm.rcoins} 환불액`}
                  name="rcoins"
                  rules={[getFormInputNumberMaxValueRule({ max: rcoinsMax })]}
                  help={
                    <Typography.Text type="warning">
                      최대 환불 가능 {paymentTerm.rcoins}: {getMoneyFormat(rcoinsMax)}
                    </Typography.Text>
                  }
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true })}
                    value={refundRcoins}
                    disabled={rcoinsMax <= 0 || refundTotal <= 0}
                    onChange={(value) => setRefundRcoins(utils.convertToNumberWrapper(value))}
                  />
                </Form.Item>
              </Space>
            </Card>
          </Space>
        </Form>
      </Modal>
      {visibleConfirmModal && (
        <ConfirmModal
          titleText="환불 작업을 진행하시겠습니까?"
          helpText="아래 환불 정보를 다시 한번 확인하시고 맞으면 환불버튼을 눌러주세요."
          visible={visibleConfirmModal}
          contentNode={makeConfirmContentNode()}
          okButtonProps={okButtonProps}
          okText={okText}
          onOk={() => {
            form.submit();
          }}
          onCancel={() => setVisibleConfirmModal(false)}
        />
      )}
    </>
  );
};

export default OrderRefundModal;
</file>

<file path="src/app/views/order/orders/components/OrderRefundModal/OrderRefundOrderLineTableSettings.tsx">
import { InfoCircleOutlined } from "@ant-design/icons";
import { FulfillmentTypeColor } from "@assets/constants/colors";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { transformIsFBV } from "@utils/misc";
import { Form, FormInstance, InputNumber, Space, Tag, Tooltip, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { OrderDetails_order_lines } from "../../api/types/OrderDetails";

export const makeReturnDeliveryFeeInputName = (id: string) => `refundDeliveryFee-${id}`;

export function getRefundOrderLineTableSettings(
  form: FormInstance,
  inputNumbersRef: React.MutableRefObject<any>,
  checkCalcRefundTotalButtonStatus: () => void,
  checkSelectedRow: (id: string) => boolean
) {
  const columns: ColumnsType<OrderDetails_order_lines> = [
    {
      align: "center",
      title: columnNameConstant.brandProduct.BP_SKU,
      key: "bpSku",
      width: 120,
      render: (_, record) => {
        // 세트상품인 경우 bpBundle.bpSku, 일반상품인 경우 brandProductVariant.bpSku
        if (record.bpBundle?.bpSku) {
          return record.bpBundle.bpSku;
        }
        return record.brandProductVariant?.bpSku || "-";
      },
    },
    {
      align: "center",
      title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
      key: "orderLineProductName",
      width: 150,
      render: (_, record) => {
        // 세트상품인 경우 "세트 상품명 - 구성품명" 형식으로 표시
        let displayName = record.productName;
        if (record.bpBundle?.name) {
          const bundleName = record.bpBundle.name; // 세트 상품명
          // 해당 orderLine의 variant와 매칭되는 bpBundleInfo 찾기
          const matchingBundleInfo = record.bpBundle.bpBundleInfos?.find((info) => info?.pv?.id === record.variant?.id);
          const componentName = matchingBundleInfo?.name || record.productName;
          displayName = `${bundleName} - ${componentName}`;
        }

        return (
          <Space direction="vertical" size={0}>
            <Typography.Text>{displayName}</Typography.Text>
            {record.variant?.isAdjustPrice && (
              <Typography.Text type="warning" style={{ fontSize: 12 }}>
                <InfoCircleOutlined /> 납품 시 금액 확정 제품은 전체 수량 또는 0개만 입력 가능합니다.
              </Typography.Text>
            )}
          </Space>
        );
      },
    },
    {
      align: "center",
      key: "price",
      title: columnNameConstant.brandProduct.SALE_PRICE,
      width: 100,
      render: (_, record) => {
        // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
        if (record.isMainPv === false) {
          return "-";
        }
        return <NumberComponent value={record.unitPriceGrossAmount} />;
      },
    },
    {
      align: "center",
      key: "refundDeliveryFee",
      title: columnNameConstant.order.RETURN_DELIVERY_FEE,
      width: 120,
      render: (_, record) => {
        if (record.isFulfilledByVendor) {
          return "-";
        }
        return (
          <Form.Item noStyle name={makeReturnDeliveryFeeInputName(record.id)}>
            <InputNumber
              ref={(el) => (inputNumbersRef.current[makeReturnDeliveryFeeInputName(record.id)] = el)}
              {...getInputNumberProps({ isCommaDisplay: true })}
              min={0}
              size="small"
              disabled={checkSelectedRow(record.id) === false}
            />
          </Form.Item>
        );
      },
    },
    {
      align: "center",
      key: "refundAvailabeQty",
      title: "환불가능수량",
      width: 100,
      render: (_, record) => {
        if (record.isFulfilledByVendor) {
          return <Tag color={FulfillmentTypeColor.isFBV}>{`${transformIsFBV(true)} 상품`}</Tag>;
        }
        // 세트상품인 경우 세트 수량 기준, 아닌 경우 제품 수량 기준
        const refundableQty =
          record.bundleQty !== null
            ? record.bundleQty - (record.bundleRefundedQty ?? 0)
            : record.orderedOrFulfillQty - record.quantityRefunded;
        return <NumberComponent value={refundableQty} />;
      },
    },
    {
      align: "center",
      key: "refundQty",
      title: "환불 수량",
      width: 100,
      render: (_, record) => {
        if (record.isFulfilledByVendor) {
          return "-";
        }

        // 세트상품인 경우 세트 수량 기준, 아닌 경우 제품 수량 기준
        const inputMax =
          record.bundleQty !== null
            ? record.bundleQty - (record.bundleRefundedQty ?? 0)
            : record.orderedOrFulfillQty - record.quantityRefunded;
        const precision = record.variant?.orderQtyDecimalPlaces;
        // step 사용 시 0만 입력해도 0.0 이 되고 있어서 키입력으로 값을 넣기에 오히려 불편해서 사용하지 않음
        // const step = isMoqInteger ? 1 : 0.1;

        const isAdjustPrice = record.variant?.isAdjustPrice;

        const inputElement = (
          <InputNumber
            ref={(el) => (inputNumbersRef.current[record.id] = el)}
            {...getInputNumberProps({
              isCommaDisplay: true,
              precision,
            })}
            min={0}
            size="small"
            disabled={!inputMax || checkSelectedRow(record.id) === false}
            max={inputMax}
            decimalSeparator="."
            placeholder={isAdjustPrice ? `0 또는 ${inputMax}` : undefined}
            onChange={(value) => {
              // Form이 자동으로 처리하므로 추가 로직 불필요
              checkCalcRefundTotalButtonStatus();
            }}
          />
        );

        const formItem = (
          <Form.Item noStyle name={record.id}>
            {inputElement}
          </Form.Item>
        );

        return isAdjustPrice ? (
          <Tooltip title={`이 제품은 0개 또는 ${inputMax}개(전체)만 선택할 수 있습니다.`} placement="topLeft">
            {formItem}
          </Tooltip>
        ) : (
          formItem
        );
      },
    },
    {
      align: "center",
      key: "refundedQty",
      title: "기 반품 수량",
      width: 100,
      render: (_, record) => {
        if (record.isFulfilledByVendor) {
          return "-";
        }

        // 세트상품인 경우 세트 수량 기준, 아닌 경우 제품 수량 기준
        const refundedQty = record.bundleQty !== null ? record.bundleRefundedQty ?? 0 : record.quantityRefunded;
        return <NumberComponent value={refundedQty} />;
      },
    },
  ];
  return columns;
}
</file>

<file path="src/app/views/order/orders/components/OrderRefundModal/utils.ts">
import { RefundOrderLineInput, RefundQAQType, RefundQAStatus } from "@src/api/types/globalTypes";

import { OrderDetails_order_lines, OrderDetails_order_refundQA } from "../../api/types/OrderDetails";

export const checkRefundStatusApproved = (virtualAccountRefund: OrderDetails_order_refundQA) =>
  virtualAccountRefund.qType === RefundQAQType.REFUND &&
  virtualAccountRefund.status !== RefundQAStatus.QUESTION_CLOSE &&
  virtualAccountRefund.status !== RefundQAStatus.REQUESTED;

/**
 * 세트상품 환불 라인 계산
 * - 대표 구성품의 제품 수량 = 세트 수량 × bundleInfoQty
 * - 다른 구성품의 제품 수량 = 세트 수량 × (해당 구성품.quantity / bundleQty)
 */
export function calculateBundleRefundLines(
  orderLine: OrderDetails_order_lines,
  inputSetQty: number
): RefundOrderLineInput[] {
  const result: RefundOrderLineInput[] = [];

  // 대표 구성품
  const mainQty = inputSetQty * (orderLine.bundleInfoQty ?? 1);
  result.push({
    orderLineId: orderLine.id,
    quantity: mainQty,
  });

  // 다른 구성품들
  if (orderLine.bundleOtherOrderLines) {
    for (const otherLine of orderLine.bundleOtherOrderLines) {
      if (otherLine) {
        const otherQty = inputSetQty * (otherLine.quantity / orderLine.bundleQty);
        result.push({
          orderLineId: otherLine.id,
          quantity: otherQty,
        });
      }
    }
  }

  return result;
}
</file>

