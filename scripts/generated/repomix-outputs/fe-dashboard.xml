<file path="src/app/views/hqStaff/hqSection/components/HqScheduleListPage/utils.ts">
import { ScheduleRepeatAnchorType, ScheduleRepeatType } from "@src/api/types/globalTypes";
import { Moment } from "moment";
import moment from "moment";
import { Event } from "react-big-calendar";

import { HqScheduleList_schedules_edges_node } from "../../api/types/HqScheduleList";

// 월간 반복(요일 anchor) occurrence 생성
const getMonthlyWeekdayOccurrencesInRange = (
  schedule: HqScheduleList_schedules_edges_node,
  range: [Moment, Moment]
) => {
  const occurrences: Array<{ start: Moment; end: Moment }> = [];
  const [rangeStart, rangeEnd] = range;
  const scheduleStart = moment(schedule.start);
  const scheduleEnd = moment(schedule.end);
  const interval = schedule.repeatInterval || 1;
  const repeatUntil = schedule.repeatUntil ? moment(schedule.repeatUntil).endOf("day") : null;

  const nth = Math.ceil(scheduleStart.date() / 7);
  const weekday = scheduleStart.day();

  // 조회 범위 내 첫 occurrence 월로 이동
  let jump = 0;
  if (scheduleStart.isBefore(rangeStart, "month")) {
    const diff = rangeStart.diff(scheduleStart, "months");
    jump = Math.ceil(diff / interval);
  }

  const monthCursor = scheduleStart.clone().add(jump * interval, "months");
  const duration = scheduleEnd.diff(scheduleStart, "ms");

  while (
    monthCursor.isSameOrBefore(rangeEnd, "month") &&
    (!repeatUntil || monthCursor.isSameOrBefore(repeatUntil, "month"))
  ) {
    const firstDayOfMonth = monthCursor.clone().startOf("month");
    const firstTargetWeekday = firstDayOfMonth.clone().day(weekday);
    if (firstTargetWeekday.month() !== monthCursor.month()) {
      firstTargetWeekday.add(7, "days");
    }
    const occStart = firstTargetWeekday.clone().add((nth - 1) * 7, "days");
    const occEnd = occStart.clone().add(duration, "ms");

    if (
      occStart.isSameOrAfter(rangeStart) &&
      occStart.isSameOrBefore(rangeEnd) &&
      (!repeatUntil || occStart.isSameOrBefore(repeatUntil))
    ) {
      occurrences.push({ start: occStart, end: occEnd });
    }
    monthCursor.add(interval, "months");
  }
  return occurrences;
};

const getOccurrencesInRange = (
  schedule: HqScheduleList_schedules_edges_node,
  range: [Moment, Moment]
): Array<{ start: Moment; end: Moment }> => {
  const occurrences: Array<{ start: Moment; end: Moment }> = [];
  const [rangeStart, rangeEnd] = range;
  const scheduleStart = moment(schedule.start);
  const scheduleEnd = moment(schedule.end);
  const repeatType = schedule.repeatType;
  const interval = schedule.repeatInterval || 1;
  const repeatUntil = schedule.repeatUntil ? moment(schedule.repeatUntil).endOf("day") : null;

  if (repeatType === ScheduleRepeatType.NONE) {
    if (scheduleEnd.isBefore(rangeStart) || scheduleStart.isAfter(rangeEnd)) {
      return [];
    }
    occurrences.push({ start: scheduleStart, end: scheduleEnd });
    return occurrences;
  }

  if (repeatUntil && repeatUntil.isBefore(rangeStart, "day")) {
    return [];
  }
  if (scheduleStart.isAfter(rangeEnd)) {
    return [];
  }

  let unit: moment.unitOfTime.DurationConstructor;
  switch (repeatType) {
    case ScheduleRepeatType.DAILY:
      unit = "days";
      break;
    case ScheduleRepeatType.WEEKLY:
      unit = "weeks";
      break;
    case ScheduleRepeatType.MONTHLY:
      // 월간 반복에서 anchorType 분기
      if (schedule.repeatAnchorType === ScheduleRepeatAnchorType.WEEKDAY) {
        return getMonthlyWeekdayOccurrencesInRange(schedule, range);
      }
      unit = "months";
      break;
    case ScheduleRepeatType.YEARLY:
      unit = "years";
      break;
    default:
      return [];
  }

  // 조회 범위 시작이 일정 시작보다 이전이면, 반복 일정이 처음으로 시작해야 할 인덱스를 계산
  let jump = 0;
  if (scheduleStart.isBefore(rangeStart, unit)) {
    const diff = rangeStart.diff(scheduleStart, unit, true);
    jump = Math.ceil(diff / interval);
  }

  const occStart = scheduleStart.clone().add(jump * interval, unit);
  const duration = scheduleEnd.diff(scheduleStart, "ms");

  // 첫 반복 일정이 조회 범위 밖이면 리턴
  if (occStart.isAfter(rangeEnd)) {
    return [];
  }

  while (occStart.isSameOrBefore(rangeEnd) && (!repeatUntil || occStart.isSameOrBefore(repeatUntil))) {
    const occEnd = occStart.clone().add(duration, "ms");
    if (occEnd.isAfter(rangeStart) && occStart.isBefore(rangeEnd.clone().endOf("day"))) {
      occurrences.push({ start: occStart.clone(), end: occEnd.clone() });
    }
    occStart.add(interval, unit);
  }

  return occurrences;
};

export const expandRecurringSchedules = (
  scheduleList: HqScheduleList_schedules_edges_node[],
  range: [Moment, Moment]
): Event[] => {
  const events: Event[] = [];
  scheduleList.forEach((schedule) => {
    const occs = getOccurrencesInRange(schedule, range);
    occs.forEach(({ start, end }) => {
      events.push({
        title: schedule.title,
        start: start.toDate(),
        end: end.toDate(),
        allDay: checkIsAllDaySchedule(schedule),
        resource: schedule,
      });
    });
  });
  return events;
};

export const checkIsAllDaySchedule = (schedule: HqScheduleList_schedules_edges_node): boolean => {
  const start = moment(schedule.start);
  const end = moment(schedule.end);
  const isStartAllDay = start.isSame(start.clone().startOf("day"), "minute");
  const isEndAllDay = end.isSame(end.clone().endOf("day"), "minute");
  return isStartAllDay && isEndAllDay;
};
</file>

<file path="src/app/views/hqStaff/hqSection/components/HqStatsOrder/HqStatsOrder.tsx">
import { Line } from "@ant-design/charts";
import { DownloadOutlined, SwapOutlined } from "@ant-design/icons";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import { BrandContractTypeEnum, StatReportingMode } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CardSpacer from "@src/app/components/CardSpacer";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { useBrandOrderStatsLazyQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { makeOrderStatsDetailChartConfig } from "@src/app/views/hqStaff/hqSection/utils/orderDetailChartConfig";
import { useBrandMileageMonthlySettlementListLazyQuery } from "@src/app/views/mileageSettlement/api/queries";
import { StatsQueryMaxLimitEnum } from "@src/global/assets/constants/config";
import { statsDateType, statsValueType } from "@utils/chart";
import { getGteLteVariables } from "@utils/filters";
import { checkHqStaff, checkIsEnableForFbvServiceByBrand, getBrandId, transformIsFBVForHq } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, PageHeader, Space, Table, Typography } from "antd";
import { Moment } from "moment";
import React, { useEffect, useState } from "react";

import { BrandOrderStats_brandOrderStats, BrandOrderStatsVariables } from "../../api/types/BrandOrderStats";
import HqStatsSelectDuration from "../HqStatsSelectDuration/HqStatsSelectDuration";
import { getDateRange } from "../HqStatsSelectDuration/utils";
import { getHqStatsOrderTableSettings, getStatsHqOrderTableSummary } from "./HqStatsOrderTableSettings";
import { getOrderStatsForTable, handleClickExcelDownloadForHqStatsOrder, replaceStatForHq } from "./utils";

export interface HqStatsOrderProps {
  title: string;
}

const HqStatsOrder: React.FC<HqStatsOrderProps> = (props) => {
  const { title } = props;
  const [dateType, setDateType] = useState<statsDateType>(statsDateType.MONTHLY);
  const [tableLoading, setTableLoading] = useState<boolean>(true);
  const [dataSource, setDataSource] = useState<BrandOrderStats_brandOrderStats[]>([]);
  const [selectedDuration, setSelectedDuration] = useState<Moment[]>(getDateRange(0, "months", "month"));
  const [isFulfilledByVendor, setIsFulfilledByVendor] = useState<boolean>(false);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const { user } = useUser();
  const isHqStaff = checkHqStaff(user);
  if (!isHqStaff) {
    return null;
  }
  const brandId = getBrandId(user);
  const brand = user?.brand;
  const brandContractType = brand?.contractType;
  const isReverseFee = brandContractType === BrandContractTypeEnum.REVERSE_FEE;

  const graphValueTypes = [];
  if (isFulfilledByVendor) {
    graphValueTypes.push(statsValueType.BRAND_COST_PRICE_ONLY_FBV);
  } else {
    graphValueTypes.push(statsValueType.TOTAL_PRICE);
    if (!isReverseFee && dateType === statsDateType.MONTHLY) {
      graphValueTypes.push(statsValueType.MILEAGE);
    }
  }

  useEffect(() => {
    refetchDataSource();
  }, [selectedDuration, isFulfilledByVendor]);

  const [BrandOrderStatsListFetch] = useBrandOrderStatsLazyQuery();
  const [BrandMileageMonthlySettlementListRefetch] = useBrandMileageMonthlySettlementListLazyQuery();

  const refetchDataSource = async () => {
    setTableLoading(true);
    let mode: StatReportingMode;
    switch (dateType) {
      case statsDateType.DAILY:
        mode = StatReportingMode.DAILY;
        break;
      case statsDateType.WEEKLY:
        mode = StatReportingMode.WEEKLY;
        break;
      case statsDateType.MONTHLY:
        mode = StatReportingMode.MONTHLY;
        break;
      default:
        mode = StatReportingMode.MONTHLY;
        break;
    }

    const queryVariable: BrandOrderStatsVariables = {
      id: brandId,
      filter: {
        mode,
        statDate: getGteLteVariables({
          gte: selectedDuration[0].format(onlyDateFormat),
          lte: selectedDuration[1].format(onlyDateFormat),
        }),
        isFulfilledByVendor,
      },
    };

    // 일별인지 주별인지 월별인지에 따라 다른 refetch를 사용한다.
    let finalBrandOrderStats: BrandOrderStats_brandOrderStats[];
    // 월별이어도 보스 외(직거래) 상품의 총 판매 현황에는 본부 수익금 관련 정보가 필요 없으므로, isFulfilledByVendor가 true일 때도 BrandOrderStatsListRefetch만 사용한다.
    if ([statsDateType.DAILY, statsDateType.WEEKLY].includes(dateType) || isFulfilledByVendor) {
      const brandOrderStats = await BrandOrderStatsListFetch({ variables: queryVariable });
      finalBrandOrderStats = brandOrderStats.data.brandOrderStats;
    } else {
      const brandsStatsListPromise = BrandOrderStatsListFetch({ variables: queryVariable });
      const brandsStatsConfirmedListPromise = BrandMileageMonthlySettlementListRefetch({
        variables: {
          first: StatsQueryMaxLimitEnum.brandOrderStats,
          filter: { brands: [brandId], date: queryVariable.filter.statDate },
        },
      });
      const [brandsStatsList, brandsStatsConfirmedList] = await Promise.all([
        brandsStatsListPromise,
        brandsStatsConfirmedListPromise,
      ]);
      // brandsStatsConfirmedList(확정된값)을 우선적으로 넣는다.
      finalBrandOrderStats = brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.map((edge) =>
        replaceStatForHq(edge.node)
      );
      // 해당 Date에 확정된 값이 없는 경우의 statsList를 만든다.
      const unconfirmedStat = brandsStatsList.data.brandOrderStats.filter((stat) => {
        const unconfirmedStat = finalBrandOrderStats.find((confirmedStat) => confirmedStat.statDate === stat.statDate);
        if (!unconfirmedStat) {
          return true;
        } else {
          return false;
        }
      });
      // 확정된 값이 없는 경우의 statsList를 넣는다.
      finalBrandOrderStats = finalBrandOrderStats.concat(unconfirmedStat);
    }

    setDataSource(finalBrandOrderStats);
    setTableLoading(false);
  };

  const makeExtraExcelDownloadUi = () => (
    <Button
      type="primary"
      shape="round"
      icon={<DownloadOutlined />}
      loading={tableLoading}
      onClick={() =>
        handleClickExcelDownloadForHqStatsOrder({
          dataSource,
          brand,
          dateType,
          duration: selectedDuration,
          valueTypes: graphValueTypes,
        })
      }
      disabled={dataSource.length === 0}
    >
      통계 자료 다운로드
    </Button>
  );

  const columns = getHqStatsOrderTableSettings({ dateType, valueTypes: graphValueTypes, brand });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);

  const fbvTag = transformIsFBVForHq(isFulfilledByVendor);
  const fbvTagForButton = transformIsFBVForHq(isFulfilledByVendor === false);
  const sectionName = title + (enableForFbvService ? `(${fbvTag} 상품)` : "(본부 수익)");
  const sectionBtnText = enableForFbvService ? `${fbvTagForButton} 상품 총 판매 현황 보기` : "";
  const sectionBtn = enableForFbvService && (
    <Button icon={<SwapOutlined />} type="default" onClick={() => setIsFulfilledByVendor((prev) => !prev)}>
      {sectionBtnText}
    </Button>
  );

  return (
    <>
      <PageHeader
        title={
          <Space direction="vertical" size={0}>
            <Typography.Title level={4}>{sectionName}</Typography.Title>
            {sectionBtn}
          </Space>
        }
        extra={makeExtraExcelDownloadUi()}
      />
      <CardSpacer />
      <HqStatsSelectDuration
        dateType={dateType}
        setDateType={setDateType}
        selectedDuration={selectedDuration}
        setSelectedDuration={setSelectedDuration}
        getDateRange={getDateRange}
        disabledSelectDateType={false}
      />
      <CardSpacer />

      <Card>
        <Space direction="vertical" size={32}>
          <Line {...makeOrderStatsDetailChartConfig(selectedDuration, dataSource, dateType, graphValueTypes)} />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={tableLoading}
            columns={columns}
            dataSource={getOrderStatsForTable(dateType, selectedDuration, dataSource)}
            rowKey={(record) => record.statDate}
            summary={(tableData) =>
              getStatsHqOrderTableSummary({ dataSource: tableData, brand, dateType, valueTypes: graphValueTypes })
            }
            scroll={{ x: tableWidthSum, y: tableScrollY }}
          />
        </Space>
      </Card>
    </>
  );
};
export default HqStatsOrder;
</file>

<file path="src/app/views/hqStaff/hqSection/components/HqStatsOrder/HqStatsOrderTableSettings.tsx">
import { User_brand } from "@src/api/fragments/types/User";
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import NumberComponent from "@src/app/components/Number";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { statsDateType, statsValueType } from "@utils/chart";
import { calcVatByPriceExcludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformIsFBVForHq } from "@utils/misc";
import { utils } from "@utils/utils";
import { Typography } from "antd";
import Table, { ColumnsType } from "antd/lib/table";
import moment from "moment";
import React from "react";

const { Text } = Typography;

interface HqStatsOrderTableSettingsProps {
  dateType: statsDateType;
  valueTypes: statsValueType[];
  brand: User_brand;
}

export function getHqStatsOrderTableSettings(props: HqStatsOrderTableSettingsProps) {
  const { dateType, valueTypes, brand } = props;
  const brandContractType = brand?.contractType;
  const showTotalPriceColumns = valueTypes.includes(statsValueType.TOTAL_PRICE);
  const showMileageColumns = valueTypes.includes(statsValueType.MILEAGE);
  const showFbvColumns = valueTypes.includes(statsValueType.BRAND_COST_PRICE_ONLY_FBV);

  const fixedFlag = utils.fixedLeftFlag();

  const totalPriceColumnsChildren: ColumnsType<BrandOrderStats_brandOrderStats> = [];
  if (showTotalPriceColumns) {
    // 매출 = amount + point + rcoins
    totalPriceColumnsChildren.push({
      title: "매출",
      align: "center",
      key: "statTotalPriceExcludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statTotalPriceExcludeVat} />,
    });
    // 가맹본부 판매현황에는 "사용 적립금" 은 별도로 표시 하지 않음
    totalPriceColumnsChildren.push({
      title: "사용 포인트",
      align: "center",
      key: "statRcoinsExcludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statRcoinsExcludeVat} />,
    });
    totalPriceColumnsChildren.push({
      title: "매입",
      align: "center",
      key: "statBrandCostPriceExcludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statBrandCostPriceExcludeVat} />,
    });
    totalPriceColumnsChildren.push({
      title: "반품배송비",
      align: "center",
      key: "statReturnDeliveryFeeExcludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.statReturnDeliveryFee)} />,
    });
    if (brandContractType === BrandContractTypeEnum.MILEAGE) {
      totalPriceColumnsChildren.push({
        title: "배송비",
        align: "center",
        key: "statBrandDeliveryFeeExcludeVat",
        width: 120,
        render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.statBrandDeliveryFee)} />,
      });
      totalPriceColumnsChildren.push({
        title: "PG결제 수수료",
        align: "center",
        key: "statBrandPayingChargeExcludeVat",
        width: 120,
        // 결제 수수료는 부가세 별도로 db 에 저장됨
        render: (_, record) => <NumberComponent value={record.statBrandPayingChargeExcludeVat} />,
      });
    }
  }
  const statMileageColumns: ColumnsType<BrandOrderStats_brandOrderStats> = [
    {
      title: <Typography.Text style={{ fontSize: 10 }}>공급가액</Typography.Text>,
      align: "center",
      key: "statMileageExcludeVat",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent value={record.statMileageExcludeVat} />
        </Typography.Text>
      ),
    },
    {
      title: <Typography.Text style={{ fontSize: 10 }}>세액</Typography.Text>,
      align: "center",
      key: "statMileageVat",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent value={calcVatByPriceExcludeVat(record.statMileageExcludeVat)} />
        </Typography.Text>
      ),
    },
    {
      title: "합계금액",
      align: "center",
      key: "statMileageIncludeVat",
      width: 120,
      render: (_, record) => (
        <NumberComponent
          value={record.statMileageExcludeVat + calcVatByPriceExcludeVat(record.statMileageExcludeVat)}
        />
      ),
    },
  ];
  const statFulfilledByVendorColumns: ColumnsType<BrandOrderStats_brandOrderStats> = [
    {
      title: <Typography.Text style={{ fontSize: 10 }}>공급가액</Typography.Text>,
      align: "center",
      key: "statBrandCostPriceExcludeVatOnlyFbv",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent value={record.statBrandCostPriceExcludeVatOnlyFbv} />
        </Typography.Text>
      ),
    },
    {
      title: <Typography.Text style={{ fontSize: 10 }}>세액</Typography.Text>,
      align: "center",
      key: "statBrandCostPriceVatOnlyFbv",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent
            value={record.statBrandCostPriceIncludeVatOnlyFbv - record.statBrandCostPriceExcludeVatOnlyFbv}
          />
        </Typography.Text>
      ),
    },
    {
      title: "합계금액",
      align: "center",
      key: "statBrandCostPriceIncludeVatOnlyFbv",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statBrandCostPriceIncludeVatOnlyFbv} />,
    },
  ];

  const columns: ColumnsType<BrandOrderStats_brandOrderStats> = [
    {
      title: "일자",
      align: "center",
      key: "statDate",
      fixed: fixedFlag,
      width: dateType === statsDateType.WEEKLY ? 130 : 120,
      render: (_, record) => {
        switch (dateType) {
          case statsDateType.DAILY:
            return record.statDate;
          case statsDateType.WEEKLY:
            const startDate = moment(record.statDate).format(onlyDateFormat);
            const endDate = moment().isBefore(moment(record.statDate).add("6", "d"))
              ? moment().format(onlyDateFormat)
              : moment(record.statDate).add("6", "d").format(onlyDateFormat);
            return <MultiLineTypography lines={[startDate, `~${endDate}`]} />;
          case statsDateType.MONTHLY:
            return moment(record.statDate).format(onlyMonthFormat);
          default:
            return record.statDate;
        }
      },
    },
    // 전체 주문 컬럼 추가
    showTotalPriceColumns && {
      title: <Typography.Title level={5}>전체 주문</Typography.Title>,
      children: totalPriceColumnsChildren,
    },
    // 본부수익금 컬럼 추가
    showMileageColumns && {
      title: <Typography.Title level={5}>본부수익금</Typography.Title>,
      children: statMileageColumns,
    },
    // 보스 외(직거래) 상품 매입금 컬럼 추가
    showFbvColumns && {
      title: <Typography.Title level={5}>{transformIsFBVForHq(true)} 상품 매입금</Typography.Title>,
      children: statFulfilledByVendorColumns,
    },
  ];
  // columns가 true인 것만
  return columns.filter(Boolean);
}

interface HqStatsOrderTableSummaryProps extends HqStatsOrderTableSettingsProps {
  dataSource: readonly BrandOrderStats_brandOrderStats[];
}

export function getStatsHqOrderTableSummary(props: HqStatsOrderTableSummaryProps) {
  const { dataSource, valueTypes, brand } = props;
  const brandContractType = brand?.contractType;
  const showTotalPriceColumns = valueTypes.includes(statsValueType.TOTAL_PRICE);
  const showMileageColumns = valueTypes.includes(statsValueType.MILEAGE);
  const showFbvColumns = valueTypes.includes(statsValueType.BRAND_COST_PRICE_ONLY_FBV);

  let statTotalPriceExcludeVatSum = 0;
  let statRcoinsExcludeVatSum = 0;
  let statReturnDeliveryFeeExcludeVatSum = 0;
  let statBrandCostPriceExcludeVatSum = 0;
  let statBrandDeliveryFeeExcludeVatSum = 0;
  let statBrandPayingChargeExcludeVatSum = 0;
  // 본부수익금 관련 금액 합계
  let statMileageExcludeVatSum = 0;
  let statMileageVatSum = 0;
  let statMileageIncludeVatSum = 0;
  // 보스 외(직거래) 상품 관련 금액 합계
  let statBrandCostPriceExcludeVatOnlyFbvSum = 0;
  let statBrandCostPriceVatOnlyFbvSum = 0;
  let statBrandCostPriceIncludeVatOnlyFbvSum = 0;

  dataSource.forEach(
    ({
      statTotalPriceExcludeVat,
      statRcoinsExcludeVat,
      statReturnDeliveryFee,
      statMileageExcludeVat,
      statBrandCostPriceExcludeVat,
      statBrandDeliveryFee,
      statBrandPayingChargeExcludeVat,
      statBrandCostPriceExcludeVatOnlyFbv,
      statBrandCostPriceIncludeVatOnlyFbv,
    }) => {
      statTotalPriceExcludeVatSum += statTotalPriceExcludeVat;
      statRcoinsExcludeVatSum += statRcoinsExcludeVat;
      statReturnDeliveryFeeExcludeVatSum += toPriceExcludeVat(statReturnDeliveryFee);
      statBrandCostPriceExcludeVatSum += statBrandCostPriceExcludeVat;
      statBrandDeliveryFeeExcludeVatSum += toPriceExcludeVat(statBrandDeliveryFee);
      statBrandPayingChargeExcludeVatSum += statBrandPayingChargeExcludeVat;
      // 본부수익금 관련 금액 합산
      if (showMileageColumns) {
        statMileageExcludeVatSum += statMileageExcludeVat;
        statMileageVatSum += calcVatByPriceExcludeVat(statMileageExcludeVat);
        statMileageIncludeVatSum += statMileageExcludeVat + calcVatByPriceExcludeVat(statMileageExcludeVat);
      }
      // 보스 외(직거래) 상품 관련 금액 합산
      if (showFbvColumns) {
        statBrandCostPriceExcludeVatOnlyFbvSum += statBrandCostPriceExcludeVatOnlyFbv;
        statBrandCostPriceVatOnlyFbvSum += statBrandCostPriceIncludeVatOnlyFbv - statBrandCostPriceExcludeVatOnlyFbv;
        statBrandCostPriceIncludeVatOnlyFbvSum += statBrandCostPriceIncludeVatOnlyFbv;
      }
    }
  );

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center">
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        {/* 전체 주문 컬럼 추가 */}
        {showTotalPriceColumns && (
          <>
            <Table.Summary.Cell index={1} align="center">
              <Text strong>
                <NumberComponent value={statTotalPriceExcludeVatSum} />
              </Text>
              &nbsp;원
            </Table.Summary.Cell>
            <Table.Summary.Cell index={1} align="center">
              <Text strong>
                <NumberComponent value={statRcoinsExcludeVatSum} />
              </Text>
              &nbsp;원
            </Table.Summary.Cell>
            <Table.Summary.Cell index={1} align="center">
              <Text strong>
                <NumberComponent value={statBrandCostPriceExcludeVatSum} />
              </Text>
              &nbsp;원
            </Table.Summary.Cell>
            <Table.Summary.Cell index={1} align="center">
              <Text strong>
                <NumberComponent value={statReturnDeliveryFeeExcludeVatSum} />
              </Text>
              &nbsp;원
            </Table.Summary.Cell>
            {brandContractType === BrandContractTypeEnum.MILEAGE && (
              <>
                <Table.Summary.Cell index={2} align="center">
                  <Text strong>
                    <NumberComponent value={statBrandDeliveryFeeExcludeVatSum} />
                  </Text>
                  &nbsp;원
