import { CountryCode } from "@src/api/types/globalTypes";
import { WarehouseDetails_warehouse_addresses } from "@src/app/views/settings/warehouses/api/types/WarehouseDetails";
import { makeAddressInputFromDaumPostcode } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Form, Input, Modal } from "antd";
import React, { useEffect, useState } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

export interface WarehouseAddressFormData {
  companyName: string;
  firstName: string;
  phone: string;
  city: string;
  streetAddress1: string;
  streetAddress2: string;
  postalCode: string;
  countryArea: string;
  country: CountryCode;
}

interface WarehouseAddressModalProps {
  open: boolean;
  loading: boolean;
  isUpdateMode: boolean;
  address?: WarehouseDetails_warehouse_addresses;
  onSubmit: (data: WarehouseAddressFormData) => void;
  onClose: () => void;
}

export const WarehouseAddressModal: React.FC<WarehouseAddressModalProps> = ({
  open,
  loading,
  isUpdateMode,
  address,
  onSubmit,
  onClose,
}) => {
  const [form] = Form.useForm<WarehouseAddressFormData>();
  const [daumPostcodeOpen, setDaumPostcodeOpen] = useState<boolean>(false);

  const searchAddress = (address: Address) => {
    const tempAddressObj = makeAddressInputFromDaumPostcode(address);
    form.setFieldsValue({
      city: tempAddressObj.city,
      countryArea: tempAddressObj.countryArea,
      postalCode: tempAddressObj.postalCode,
      streetAddress1: tempAddressObj.streetAddress1,
    });
    setDaumPostcodeOpen(false);
  };

  useEffect(() => {
    if (open) {
      setDaumPostcodeOpen(false);
      if (isUpdateMode && address) {
        form.setFieldsValue({
          companyName: address.companyName || "",
          firstName: address.firstName || "",
          phone: utils.convertPhoneToLocal(address.phone || ""),
          city: address.city || "",
          streetAddress1: address.streetAddress1 || "",
          streetAddress2: address.streetAddress2 || "",
          postalCode: address.postalCode || "",
          countryArea: address.countryArea || "",
          country: CountryCode.KR,
        });
      } else {
        form.resetFields();
        form.setFieldsValue({
          country: CountryCode.KR,
        });
      }
    } else {
      setDaumPostcodeOpen(false);
    }
  }, [open, isUpdateMode, address, form]);

  const handleSubmit = async () => {
    try {
      const values = await form.validateFields();
      const phone = utils.convertPhoneToInternational(values.phone);

      onSubmit({ ...values, phone });
    } catch (error) {
      console.error("Validation failed:", error);
    }
  };

  const handleCancel = () => {
    if (daumPostcodeOpen) {
      setDaumPostcodeOpen(false);
    } else {
      onClose();
    }
  };

  return (
    <Modal
      open={open}
      title={isUpdateMode ? "물류센터 주소 수정" : "물류센터 주소 추가"}
      okText={daumPostcodeOpen ? null : isUpdateMode ? "수정" : "추가"}
      cancelText={daumPostcodeOpen ? "뒤로" : "취소"}
      onOk={daumPostcodeOpen ? null : handleSubmit}
      onCancel={handleCancel}
      confirmLoading={loading}
      width={600}
      footer={
        daumPostcodeOpen
          ? [
              <Button key="back" onClick={handleCancel}>
                뒤로
              </Button>,
            ]
          : undefined
      }
    >
      {daumPostcodeOpen ? (
        <DaumPostcode onComplete={searchAddress} style={{ width: "100%", height: 400 }} />
      ) : (
        <Form form={form} layout="vertical" disabled={loading}>
          <Form.Item
            label="물류센터명"
            name="companyName"
            rules={[{ required: true, message: "물류센터명을 입력해주세요" }]}
          >
            <Input placeholder="예: 리우 나주 물류센터" />
          </Form.Item>

          <Form.Item
            label="입고 담당자"
            name="firstName"
            rules={[{ required: true, message: "입고 담당자를 입력해주세요" }]}
          >
            <Input placeholder="예: 임재욱" />
          </Form.Item>

          <Form.Item label="연락처" name="phone" rules={[{ required: true, message: "연락처를 입력해주세요" }]}>
            <Input placeholder="예: 01012345678" />
          </Form.Item>

          <Form.Item
            label="우편번호"
            name="postalCode"
            rules={[{ required: true, message: "우편번호를 입력해주세요" }]}
          >
            <Input
              placeholder="우편번호를 입력하세요"
              disabled
              addonAfter={
                <Button type="link" size="small" onClick={() => setDaumPostcodeOpen(true)}>
                  주소검색
                </Button>
              }
            />
          </Form.Item>

          <Form.Item label="도/시" name="city" rules={[{ required: true, message: "도/시를 입력해주세요" }]}>
            <Input placeholder="도/시를 입력하세요 (예: 서울특별시)" disabled />
          </Form.Item>

          <Form.Item label="시/군/구" name="countryArea">
            <Input placeholder="시/군/구를 입력하세요 (예: 강남구)" disabled />
          </Form.Item>

          <Form.Item
            label="기본주소"
            name="streetAddress1"
            rules={[{ required: true, message: "기본주소를 입력해주세요" }]}
          >
            <Input placeholder="기본주소를 입력하세요" disabled />
          </Form.Item>

          <Form.Item label="상세주소" name="streetAddress2">
            <Input placeholder="상세주소를 입력하세요" />
          </Form.Item>

          <Form.Item name="country" hidden>
            <Input />
          </Form.Item>
        </Form>
      )}
    </Modal>
  );
};
</file>

