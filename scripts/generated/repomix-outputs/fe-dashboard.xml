<file path="src/app/views/notice/banners/views/BannerDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import { SearchCategoriesVariables } from "@src/api/searches/types/SearchCategories";
import { SearchFromBossNoticesVariables } from "@src/api/searches/types/SearchFromBossNotices";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import useFromBossNoticeSearch from "@src/api/searches/useFromBossNoticeSearch";
import { BannerInput } from "@src/api/types/globalTypes";
import ActionDialog from "@src/app/components/ActionDialog";
import AssignBrandDialog from "@src/app/components/AssignBrandDialog";
import MakeCategoryLinkModal from "@src/app/components/MakeCategoryLinkModal";
import MakeFromBossNoticeLinkModal from "@src/app/components/MakeFromBossNoticeLinkModal";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getMutationState, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrorInfo, showGqlErrors } from "@utils/notification/wrapperGql";
import React, { useState } from "react";

import {
  useAssignBrandsToBannerMutation,
  useUnassignBrandsFromBannerMutation,
  useUpdateBannerMutation,
} from "../api/mutations";
import { useBannerDetailsQuery } from "../api/queries";
import { UpdateBanner } from "../api/types/UpdateBanner";
import BannerDetailsPage, { BannerDetailsPageFormData } from "../components/BannerDetailsPage";
import { bannerDetailsViewUrl, BannerDetailsViewUrlQueryParams, bannerListViewUrl } from "../urls";

interface BannerDetailsViewProps {
  id: string;
  params: BannerDetailsViewUrlQueryParams;
}

enum BannerDetailModalModeEnum {
  Assign = "Assign",
  Unassign = "Unassign",
  UnassignBulk = "UnassignBulk",
  RemovePcImage = "RemovePcImage",
  RemoveMobileImage = "RemoveMobileImage",
  MakeFromBossNoticeLink = "MakeFromBossNoticeLink",
  MakeCategoryLink = "MakeCategoryLink",
}

export const BannerDetailsView: React.FC<BannerDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const [brandNameForModal, setBrandNameForModal] = useState("");
  const [idsForModal, setIdsForModal] = useState([]);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setIdsForModal([]);
    setModalMode(null);
    setBrandNameForModal("");
  };
  const openModalWithoutNavigate = (
    madalMode: BannerDetailModalModeEnum,
    idsForModal?: string[],
    brandNameForModal?: string
  ) => {
    setModalMode(madalMode);
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
    if (brandNameForModal) {
      setBrandNameForModal(brandNameForModal);
    }
  };

  const maxRowNumber = GrapheneRelayConnectionMaxLimitEnum.brands;
  const maxRowNumberDefault = GrapheneRelayConnectionMaxLimitEnum.default;
  const brandSearchVariable: SearchBrandsVariables = { first: maxRowNumber };
  const defaultSearchVariable: SearchFromBossNoticesVariables | SearchCategoriesVariables = {
    first: maxRowNumberDefault,
  };

  const {
    search: searchBrand,
    loadMore: loadMoreBrand,
    result: resultBrand,
  } = useBrandSearch({ skip: modalMode !== BannerDetailModalModeEnum.Assign, variables: brandSearchVariable });

  const {
    search: searchFromBossNotices,
    loadMore: loadMoreFromBossNotices,
    result: resultFromBossNotices,
  } = useFromBossNoticeSearch({
    skip: modalMode !== BannerDetailModalModeEnum.MakeFromBossNoticeLink,
    variables: defaultSearchVariable,
  });

  const {
    search: searchCategory,
    loadMore: loadMoreCategory,
    result: resultCategory,
  } = useCategorySearch({
    skip: modalMode !== BannerDetailModalModeEnum.MakeCategoryLink,
    variables: defaultSearchVariable,
  });

  const { data, loading } = useBannerDetailsQuery({ variables: { id } });
  const banner = maybe(() => data.banner, null);

  const handleBannerUpdateSuccess = (data: UpdateBanner) => {
    const errors = data.updateBanner.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(bannerDetailsViewUrl(id), true);
    } else {
      if (errors.find((error) => error.field === ("pcImage" as keyof BannerInput))) {
        showGqlErrorInfo("PC 배너 이미지 필드 오류로 배너 이미지 업데이트에 실패했습니다.", "ImageError");
      } else if (errors.find((error) => error.field === ("mobileImage" as keyof BannerInput))) {
        showGqlErrorInfo("모바일 배너 이미지 필드 오류로 배너 이미지 업데이트에 실패했습니다.", "ImageError");
      } else {
        showGqlErrors(errors);
      }
    }
  };

  const [updateBanner, updateBannerOpts] = useUpdateBannerMutation({
    onCompleted: handleBannerUpdateSuccess,
  });

  const [assignBrand, assignBrandOpts] = useAssignBrandsToBannerMutation({
    onCompleted: (data) => {
      const errors = data.assignBrandsToBanner.errors;
      if (errors.length === 0) {
        showNotificationSuccess("게시 브랜드 리스트에 브랜드를 추가했습니다.");
        navigate(bannerDetailsViewUrl(id), true);
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [unassignBrand, unassignBrandOpts] = useUnassignBrandsFromBannerMutation({
    onCompleted: (data) => {
      const errors = data.unassignBrandsFromBanner.errors;
      if (errors.length === 0) {
        showNotificationSuccess("게시 브랜드 리스트에서 브랜드를 제거했습니다.");
        resetForCloseModal();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleBack = () => navigate(bannerListViewUrl());

  const availableBrandIdList = banner?.availableBrands.map((e) => e.id) || [];

  const handleUpdate = async (formData: BannerDetailsPageFormData) => {
    const input: BannerInput = {
      name: formData.name,
      linkUrl: formData.linkUrl,
      description: formData.description,
      start: formData.start,
      end: formData.end,
      visibleToBrand: formData.visibleToBrand,
      availableToAllBrands: formData.availableToAllBrands,
    };

    const updateBannerResult = await updateBanner({
      variables: {
        id,
        input,
      },
    });

    return updateBannerResult.data.updateBanner.errors;
  };

  const formTransitionState = getMutationState(
    updateBannerOpts.called,
    updateBannerOpts.loading,
    updateBannerOpts.data?.updateBanner.errors
  );

  return (
    <>
      <WindowTitle title={maybe(() => banner.name)} />
      {banner && (
        <BannerDetailsPage
          banner={banner}
          disabled={loading || updateBannerOpts.loading}
          errors={updateBannerOpts.data?.updateBanner.errors || []}
          onBack={handleBack}
          onOpenMakeFromBossNoticeLinkModal={() =>
            openModalWithoutNavigate(BannerDetailModalModeEnum.MakeFromBossNoticeLink)
          }
          onOpenMakeCategoryLinkModal={() => openModalWithoutNavigate(BannerDetailModalModeEnum.MakeCategoryLink)}
          onPcImageDelete={() => openModalWithoutNavigate(BannerDetailModalModeEnum.RemovePcImage)}
          onPcImageUpload={(file) => {
            updateBanner({
              variables: {
                id,
                input: {
                  name: banner.name,
                  start: banner.start,
                  visibleToBrand: banner.visibleToBrand,
                  pcImage: file,
                },
              },
            });
          }}
          onMobileImageDelete={() => openModalWithoutNavigate(BannerDetailModalModeEnum.RemoveMobileImage)}
          onMobileImageUpload={(file) => {
            updateBanner({
              variables: {
                id,
                input: {
                  name: banner.name,
                  start: banner.start,
                  visibleToBrand: banner.visibleToBrand,
                  mobileImage: file,
                },
              },
            });
          }}
          onSubmit={handleUpdate}
          onBrandAssign={() => openModalWithoutNavigate(BannerDetailModalModeEnum.Assign)}
          onBrandUnassign={(brandId, brandNameForModal) =>
            openModalWithoutNavigate(BannerDetailModalModeEnum.Unassign, [brandId], brandNameForModal)
          }
          onBrandUnassignBulk={(unassignList) =>
            openModalWithoutNavigate(BannerDetailModalModeEnum.UnassignBulk, unassignList)
          }
          saveButtonBarState={formTransitionState}
        />
      )}
      <AssignBrandDialog
        hasMore={resultBrand.data?.search?.pageInfo.hasNextPage}
        open={modalMode === BannerDetailModalModeEnum.Assign}
        onFetch={searchBrand}
        onFetchMore={loadMoreBrand}
        loading={resultBrand.loading || assignBrandOpts.loading}
        rowSelectionType={"checkbox"}
        onClose={resetForCloseModal}
        onSubmit={(brands) => {
          assignBrand({
            variables: {
              bannerId: id,
              brands: brands.map((brand) => brand.id),
            },
          });
        }}
        brands={maybe(() =>
          resultBrand.data.search.edges
            .map((edge) => edge.node)
            .filter((suggestedBrand) => !availableBrandIdList.includes(suggestedBrand.id))
        )}
      />
      <MakeFromBossNoticeLinkModal
        hasMore={resultFromBossNotices.data?.search?.pageInfo.hasNextPage}
        open={modalMode === BannerDetailModalModeEnum.MakeFromBossNoticeLink}
        onFetch={searchFromBossNotices}
        onFetchMore={loadMoreFromBossNotices}
        loading={resultFromBossNotices.loading}
        onClose={resetForCloseModal}
        notices={maybe(() => resultFromBossNotices.data.search.edges.map((edge) => edge.node))}
      />
      <MakeCategoryLinkModal
        hasMore={resultCategory.data?.search?.pageInfo.hasNextPage}
        open={modalMode === BannerDetailModalModeEnum.MakeCategoryLink}
        onFetch={searchCategory}
        onFetchMore={loadMoreCategory}
        loading={resultCategory.loading}
        onClose={resetForCloseModal}
        categories={maybe(() => resultCategory.data.search.edges.map((edge) => edge.node))}
      />
      <ActionDialog
        confirmButtonState={unassignBrandOpts.status}
        onClose={resetForCloseModal}
        onConfirm={() => {
          unassignBrand({
            variables: {
              bannerId: id,
              brands: idsForModal,
            },
          });
        }}
        open={modalMode === BannerDetailModalModeEnum.UnassignBulk}
        title="배너 브랜드 연결 해제"
      >
        {`선택한 ${idsForModal?.length}개의 브랜드를 배너 게시 브랜드에서 연결 해제하시겠습니까?`}
      </ActionDialog>
      <ActionDialog
        confirmButtonState={unassignBrandOpts.status}
        onClose={resetForCloseModal}
        onConfirm={() => {
          unassignBrand({
            variables: {
              bannerId: id,
              brands: idsForModal,
            },
          });
        }}
        open={modalMode === BannerDetailModalModeEnum.Unassign}
        title="배너 브랜드 연결 해제"
      >
        {`선택한 브랜드 ${brandNameForModal}을(를) 배너 게시 브랜드에서 연결 해제하시겠습니까?`}
