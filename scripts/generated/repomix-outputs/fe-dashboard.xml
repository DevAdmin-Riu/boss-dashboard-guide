<file path="src/app/views/hqFulfilledByVendor/components/HqFulfilledByVendorSettlementListPage/utils.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandFbvSettlements_brandFbvSettlements_edges_node } from "@src/app/views/mileageSettlement/api/types/BrandFbvSettlements";
import { getFulfilledByVendorSettlementStatusTextForAdmin } from "@src/app/views/mileageSettlement/components/FulfilledByVendorSettlementListPage/utils";
import { excelDownload, makeHeaderRowsAndMerges } from "@utils/excel/excelDownload";
import { transformIsFBVForHq } from "@utils/misc";
import { destroyDownloadingMessage, showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import moment from "moment";

import { Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq } from "../../utils";

export const overwriteStatForHq = (
  brandStats: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq,
  confirmedDataNode: BrandFbvSettlements_brandFbvSettlements_edges_node
) => {
  brandStats = {
    ...brandStats,
    // 확정된 데이터들은 확정된 데이터 값으로 덮어써야함.(스냅샷 뜬 데이터이므로)
    statBrandCostPriceExcludeVatOnlyFbv: !!confirmedDataNode
      ? confirmedDataNode.brandCostPriceExcludeVat
      : brandStats.statBrandCostPriceExcludeVatOnlyFbv,
    statBrandCostPriceIncludeVatOnlyFbv: !!confirmedDataNode
      ? confirmedDataNode.brandCostPriceIncludeVat
      : brandStats.statBrandCostPriceIncludeVatOnlyFbv,
    settlementStatus: !!confirmedDataNode ? confirmedDataNode.settlementStatus : null,
    rejectReason: !!confirmedDataNode ? confirmedDataNode.rejectReason : null,
    settlementId: !!confirmedDataNode ? confirmedDataNode.id : null,
  };
  return brandStats;
};

export const handleClickExcelDownloadForHq = (
  dataSource: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[],
  brandName: string
) => {
  try {
    const { rows, colsInfo, header, merges } = parseFulfilledByVendorSettlementListForHq(dataSource);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const title = `${transformIsFBVForHq(true)} 상품 매입금 신청 리스트(${brandName})`;
    excelDownload({ title, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const parseFulfilledByVendorSettlementListForHq = (
  dataSource: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[]
) => {
  const rows = [];

  dataSource.forEach((data) => {
    // 구분
    const statDate = moment(data.statDate).format(onlyMonthFormat);

    // [직거래 상품 매입금]
    // 매입 (부가세 별도)
    const statBrandCostPriceExcludeVat = data.statBrandCostPriceExcludeVatOnlyFbv;
    // 세액
    const statBrandCostPriceVat = data.statBrandCostPriceIncludeVatOnlyFbv - data.statBrandCostPriceExcludeVatOnlyFbv;
    // 합계금액
    const statBrandCostPriceIncludeVat = statBrandCostPriceExcludeVat + statBrandCostPriceVat;

    // [직거래 상품 매입금 정산처리 정보]
    // 상태
    const statusText = getFulfilledByVendorSettlementStatusTextForAdmin(data.settlementStatus);
    // 반려사유
    const rejectReason = data.rejectReason ? data.rejectReason : "-";

    const stateDate = {
      구분: statDate,
    };
    const fulfilledByVendorInfo = {
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendorInfo + "\n매입\n" + commonMsg.excludeVat]:
        statBrandCostPriceExcludeVat,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendorInfo + "\n세액"]: statBrandCostPriceVat,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendorInfo + "\n합계금액"]: statBrandCostPriceIncludeVat,
    };

    const statusInfo = {
      [fulfilledByVendorSettlementKeysToMerge.status + "\n상태"]: statusText,
      [fulfilledByVendorSettlementKeysToMerge.status + "\n반려사유"]: rejectReason,
    };

    const mergedRows = {
      ...stateDate,
      ...fulfilledByVendorInfo,
      ...statusInfo,
    };
    rows.push(mergedRows);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

const fulfilledByVendorSettlementKeysToMerge = {
  fulfilledByVendorInfo: `[${transformIsFBVForHq(true)} 상품 매입금]`,
  status: "[현황]",
};

export const getFulfilledByVendorSettlementStatusStepsIndexForHqMain = (status: BrandMonthlySettlementStatusEnum) => {
  switch (status) {
    case BrandMonthlySettlementStatusEnum.CONFIRMED:
      return 1;
    case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
    case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
      return 2;
    case BrandMonthlySettlementStatusEnum.PAID:
      return 3;
    default:
      return 0;
  }
};
</file>

<file path="src/app/views/hqFulfilledByVendor/components/FbvPurchaseCostEventCreateModal.tsx">
import { MinusOutlined, PlusOutlined } from "@ant-design/icons";
import { commonMsg } from "@assets/messages/commonMsg";
import { User_brand } from "@src/api/fragments/types/User";
import {
  FbvPurchaseCostEventCreateInput,
  FbvPurchaseCostEventType,
  FbvPurchaseCostEventTypeEnum,
} from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { StrictOmit } from "@src/global/core/types/types";
import { findValueInEnum, transformIsFBVForHq } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Badge, Descriptions, Form, Input, InputNumber, Modal, Space, Tooltip, Typography } from "antd";
import React from "react";

import { SimpleVendor_vendor } from "../../purchase/vendors/api/types/SimpleVendor";
import { useFbvPurchaseCostEventCreateMutation } from "../api/mutations";
import { fbvPurchaseCostEventListQuery, fbvPurchaseCostStatsForHqQuery } from "../api/queries";
import { FulfilledByVendorPurchaseCostStatListViewUrlDialog } from "../urls";
import {
  getFbvPurchaseCostAmountExcludeVatWithOperator,
  getFbvPurchaseCostOperator,
  getFulfilledByVendorPurchaseCostEventTypeName,
} from "../utils";

const { Text } = Typography;

interface FbvPurchaseCostEventCreateModalProps {
  open: boolean;
  loading: boolean;
  action: FulfilledByVendorPurchaseCostStatListViewUrlDialog;
  brand: Pick<User_brand, "id">;
  vendor: Pick<SimpleVendor_vendor, "id" | "name" | "bizRegNo">;
  remainAmount: number;
  onClose: () => void;
  isHqStaff: boolean;
}

type TFbvPurchaseCostEventCreateForm = StrictOmit<FbvPurchaseCostEventCreateInput, "type" | "brand" | "vendor">;

export const FbvPurchaseCostEventCreateModal: React.FC<FbvPurchaseCostEventCreateModalProps> = (props) => {
  const { open, loading, action, brand, vendor, remainAmount = 0, onClose, isHqStaff } = props;
  const [form] = Form.useForm<TFbvPurchaseCostEventCreateForm>();
  const amountWatched = Form.useWatch("amount", form) || null;

  let type: FbvPurchaseCostEventTypeEnum;
  switch (action) {
    case "create-fbv-purchase-cost-settlement":
      type = FbvPurchaseCostEventTypeEnum.SETTLEMENT;
      break;
    case "create-fbv-purchase-cost-increase":
      type = FbvPurchaseCostEventTypeEnum.INCREASE;
      break;
    case "create-fbv-purchase-cost-decrease":
      type = FbvPurchaseCostEventTypeEnum.DECREASE;
      break;
    default:
      type = null;
      break;
  }
  const typeValue = utils.isEmpty(type) ? null : findValueInEnum(type, FbvPurchaseCostEventType);
  const typeText = getFulfilledByVendorPurchaseCostEventTypeName(typeValue, isHqStaff);
  const fbvPurchaseCostOperator = getFbvPurchaseCostOperator(typeValue);
  const amount = getFbvPurchaseCostAmountExcludeVatWithOperator({
    type: typeValue,
    amount: amountWatched,
  });
  // 반영 후 예상 잔액
  const amountAfter = remainAmount + amount;
  const noBrand = !brand;
  const noVendor = !vendor;

  const initialValues: TFbvPurchaseCostEventCreateForm = {
    amount: null,
    description: "",
  };

  const onModalClose = () => {
    form.resetFields();
    onClose();
  };

  const [fbvPurchaseCostEventCreate, fulfilledByVendorPurchaseCostEventCreateOpts] =
    useFbvPurchaseCostEventCreateMutation({
      onCompleted: (data) => {
        const errors = data.fbvPurchaseCostEventCreate.errors;
        if (errors.length === 0) {
          showNotificationSuccess(commonMsg.savedChanges);
          onModalClose();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [fbvPurchaseCostStatsForHqQuery, fbvPurchaseCostEventListQuery],
    });

  const modalLoading = loading || fulfilledByVendorPurchaseCostEventCreateOpts.loading;

  const onSubmit = (formData: TFbvPurchaseCostEventCreateForm) => {
    const { amount } = formData;
    if (
      [
        FbvPurchaseCostEventTypeEnum.SETTLEMENT,
        FbvPurchaseCostEventTypeEnum.INCREASE,
        FbvPurchaseCostEventTypeEnum.DECREASE,
      ].includes(type) === false
    ) {
      showNotificationError("가맹본부 협력사 채무 변동 내역으로 추가할 수 없는 구분입니다.");
      return;
    }
    if (amount <= 0) {
      showNotificationError("가맹본부 협력사 채무 반영 금액은 0보다 커야합니다.");
      return;
    }
    if (type === FbvPurchaseCostEventTypeEnum.SETTLEMENT) {
      if (remainAmount < amount) {
        showNotificationError(
          `${transformIsFBVForHq(true)} 상품 지급 금액이 현재 잔여 가맹본부 협력사 채무보다 많습니다.`
        );
        return;
      }
    }

    fbvPurchaseCostEventCreate({
      variables: { input: { ...formData, type, brand: brand?.id, vendor: vendor?.id } },
    });
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="잔액 수정"
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      onCancel={onModalClose}
      okButtonProps={{ loading: modalLoading, disabled: noBrand || noVendor }}
      cancelButtonProps={{ loading: modalLoading }}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        name="fbv-purchase-cost-event-create-form"
        layout="vertical"
        onFinish={onSubmit}
      >
        <Space direction="vertical" size="large">
          <Descriptions bordered size="small" contentStyle={{ textAlign: "right" }} extra={<TableVatLegend />}>
            <Descriptions.Item label="구분" span={3}>
              <Text strong>{typeText}</Text>
            </Descriptions.Item>
            <Descriptions.Item label="협력사" span={3}>
              {noVendor ? <Text type="secondary">협력사 정보 없음</Text> : vendor?.name || "-"}
            </Descriptions.Item>
            <Descriptions.Item label="협력사 사업자번호" span={3}>
              {noVendor ? <Text type="secondary">협력사 정보 없음</Text> : vendor?.bizRegNo || "-"}
            </Descriptions.Item>
            <Descriptions.Item label="현재 잔액" span={3}>
              <NumberComponent value={remainAmount} />
            </Descriptions.Item>
            <Descriptions.Item label="반영 금액" span={3}>
              <Form.Item name="amount" noStyle>
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  style={{ width: "100%" }}
                  addonBefore={fbvPurchaseCostOperator > 0 ? <PlusOutlined /> : <MinusOutlined />}
                />
              </Form.Item>
            </Descriptions.Item>
            <Descriptions.Item
              label={
                <Tooltip
                  title="잔액 수정 중 주문이 들어온 경우, 수정 완료 후 잔액이 해당 금액과 달라질 수 있습니다."
                  placement="topLeft"
                >
                  <Badge size="small" count="?" offset={[10, 0]}>
                    반영 후 예상 잔액
                  </Badge>
                </Tooltip>
              }
              contentStyle={{ fontWeight: "bold" }}
              span={3}
            >
              <NumberComponent value={amountAfter} />
            </Descriptions.Item>
          </Descriptions>
          <Form.Item label="비고" name="description">
            <Input.TextArea placeholder="내용을 입력해 주세요." />
          </Form.Item>
        </Space>
      </Form>
    </Modal>
  );
};
