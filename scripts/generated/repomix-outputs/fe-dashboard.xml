<file path="src/app/views/home/components/HomeAnalyticsCard/utils.tsx">
import NumberComponent from "@src/app/components/Number";
import { light } from "@src/app/providers/ThemeProvider/themes";
import { Space, Typography } from "antd";
import React from "react";

export enum HomeAnalyticsEnum {
  SALES_AMOUNT = "SALES_AMOUNT",
  ORDERS_COUNT = "ORDERS_COUNT",
  ORDERS_TO_FULFILL = "ORDERS_TO_FULFILL",
  ORDERS_TO_CAPTURE = "ORDERS_TO_CAPTURE",
  PRODUCT_OUT_OF_ROP = "PRODUCT_OUT_OF_ROP",
  QNA_TODAY_TOTAL_COUNT = "QNA_TODAY_TOTAL_COUNT",
  QNA_NOT_ANSWER_TOTAL_COUNT = "QNA_NOT_ANSWER_TOTAL_COUNT",
}

export const getHomeAnalyticsMessage = (type: HomeAnalyticsEnum, amount: number) => {
  switch (type) {
    case HomeAnalyticsEnum.SALES_AMOUNT:
      return "오늘 현재까지 총 주문 금액";
    case HomeAnalyticsEnum.ORDERS_COUNT:
      return "오늘 현재까지 총 주문 건 수";
    case HomeAnalyticsEnum.ORDERS_TO_FULFILL:
      return amount === 0 ? "주문접수 대기 중인 주문이 없습니다." : `${amount}건의 주문이 주문 접수 대기 중입니다.`;
    case HomeAnalyticsEnum.ORDERS_TO_CAPTURE:
      return amount === 0 ? "결제 대기 중인 주문이 없습니다." : `${amount}건의 주문이 결제 대기 중입니다.`;
    case HomeAnalyticsEnum.QNA_TODAY_TOTAL_COUNT:
      return "오늘 등록된 문의 건 수";
    case HomeAnalyticsEnum.QNA_NOT_ANSWER_TOTAL_COUNT:
      return "답변이 없는 문의의 수";
  }
};

export const makeOutOfStockHomeAnalyticsCardContent = (
  productVariantsOutOfRop: number,
  productVariantsOutOfSafetyStock: number,
  productVariantsOutOfStock: number
) => {
  const safeColor = light.primary;
  const dangerColor = "#f5222d";
  const outOfRopStockColor = productVariantsOutOfRop > 0 ? dangerColor : safeColor;
  const outOfsafetyStockColor = productVariantsOutOfSafetyStock > 0 ? dangerColor : safeColor;
  const outOfStockColor = productVariantsOutOfStock > 0 ? dangerColor : safeColor;
  return (
    <Space direction="vertical" align="center">
      <Space direction="horizontal" size="small">
        <Typography.Text type="secondary">재발주 필요 제품수:</Typography.Text>
        <Typography.Title style={{ color: outOfRopStockColor }}>
          <NumberComponent value={productVariantsOutOfRop} />
        </Typography.Title>
      </Space>
      <Space direction="horizontal" size="small">
        <Typography.Text type="secondary">안전 상태 위험 제품수:</Typography.Text>
        <Typography.Title style={{ color: outOfsafetyStockColor }} level={3}>
          <NumberComponent value={productVariantsOutOfSafetyStock} />
        </Typography.Title>
      </Space>
      <Space direction="horizontal" size="small">
        <Typography.Text type="secondary">재고 소진 제품수:</Typography.Text>
        <Typography.Title style={{ color: outOfStockColor }} level={3}>
          <NumberComponent value={productVariantsOutOfStock} />
        </Typography.Title>
      </Space>
    </Space>
  );
};
</file>

