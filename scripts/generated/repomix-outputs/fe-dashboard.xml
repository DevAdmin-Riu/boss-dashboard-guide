import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";
import React, { useMemo } from "react";

import {
  useBrandListForExclusiveVariantStockInfoQuery,
  useExclusiveVariantMonthlyStockInfoForBrandsQuery,
} from "../../api/queries";
import { BrandExclusiveVariantStockInfoListPage } from "../../components/BrandExclusiveVariantStockInfoListPage/BrandExclusiveVariantStockInfoListPage";
import {
  IBrandExclusiveVariantStockInfoDataSource,
  makeBrandExclusiveVariantStockInfoDataSource,
} from "../../components/BrandExclusiveVariantStockInfoListPage/BrandExclusiveVariantStockInfoListTableSettings";
import {
  brandExclusiveVariantStockInfoListViewUrl,
  BrandExclusiveVariantStockInfoListViewUrlDialog,
  BrandExclusiveVariantStockInfoListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface BrandExclusiveVariantStockInfoListViewProps {
  defaultParams: BrandExclusiveVariantStockInfoListViewUrlQueryParams;
  params: BrandExclusiveVariantStockInfoListViewUrlQueryParams;
}

export const BrandExclusiveVariantStockInfoListView: React.FC<BrandExclusiveVariantStockInfoListViewProps> = ({
  defaultParams,
  params,
}) => {
  const targetUrl = brandExclusiveVariantStockInfoListViewUrl;
  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BRAND_EXCLUSIVE_VARIANT_STOCK_INFO_LIST,
  });

  const stockInfoFilterVariables = getFilterVariables(params);
  const { statDate } = stockInfoFilterVariables;
  const includeThisMonth = moment().isBetween(moment(statDate.gte), moment(statDate.lte), "month", "[]");

  const {
    data: brandListData,
    loading: brandListLoading,
    refetch: brandListRefetch,
  } = useBrandListForExclusiveVariantStockInfoQuery({
    initialListSkip: true,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.brands,
      includeCurrentExclusiveVariantStockInfo: includeThisMonth,
      filter: { brandSearch: params.brandSearch },
    },
  });
  const brandList = maybe(() => brandListData.brands.edges.map((edge) => edge.node), []);
  const brandIdList = brandList.map((brand) => brand.id);

  const {
    data: stockInfoListData,
    loading: stockInfoListLoading,
    refetch: stockInfoListRefetch,
  } = useExclusiveVariantMonthlyStockInfoForBrandsQuery({
    skip: brandIdList.length === 0,
    variables: { ...stockInfoFilterVariables, ids: brandIdList },
    forceFetchPolicy: "cache-first",
  });
  const stockInfoList = maybe(() => stockInfoListData.exclusiveVariantMonthlyStockInfoForBrands, []);

  const dataLoading = brandListLoading || stockInfoListLoading;
  const dataSource = useMemo<IBrandExclusiveVariantStockInfoDataSource[]>(
    () => makeBrandExclusiveVariantStockInfoDataSource(brandList, stockInfoList, includeThisMonth),
    [dataLoading]
  );

  const refetch = async () => {
    await brandListRefetch();
    await stockInfoListRefetch();
  };

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    BrandExclusiveVariantStockInfoListViewUrlDialog,
    BrandExclusiveVariantStockInfoListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <BrandExclusiveVariantStockInfoListPage
        disabled={dataLoading}
        loading={dataLoading}
        dataSource={dataSource}
        filterVariables={stockInfoFilterVariables}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        settings={settings}
        onUpdateListSettings={updateListSettings}
      />

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

