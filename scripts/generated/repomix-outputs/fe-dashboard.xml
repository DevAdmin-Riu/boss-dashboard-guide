import { ApolloQueryResult } from "@apollo/client";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { Goodsflow } from "@src/app/components/Goodsflow";
import Link from "@src/app/components/Link";
import DateTime from "@src/app/providers/DateProvider/DateTime";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  FulfillmentList,
  FulfillmentList_fulfillments_edges_node,
  FulfillmentListVariables,
} from "@src/app/views/order/orders/api/types/FulfillmentList";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { openTrackingWindow } from "@src/app/views/settings/couriers/utils";
import { getBrandName } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { Button, Space, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useState } from "react";

import { getBoxSizeLabelAndFormValue } from "../OrderDeliveryListPage/utils";
import { OrderDeliveryReprintListPageProps } from "./OrderDeliveryReprintListPage";

export function getDeliveryReprintListTableSettings(
  listProps: OrderDeliveryReprintListPageProps,
  refetch: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>,
  couriers: CourierList_couriers_edges_node[]
) {
  const { queryVariables, onOrderLineBoxSizeUpdate } = listProps;
  const shop = useShop();
  const [loading, setLoading] = useState(false);
  const handleError = (errMessage) => {
    showNotificationError(errMessage);
    setLoading(false);
  };

  const handleGoodsflowReprintSuccess = () => {
    refetch(queryVariables);
    setLoading(false);
  };

  const columns: ColumnsType<FulfillmentList_fulfillments_edges_node> = [
    {
      title: columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID,
      key: "fulfillmentComposedId",
      align: "center",
      width: 120,
      render: (_, record) => (
        <Typography.Link onClick={() => listProps.onRowClick(record.order.id)}>
          {record.composedIdWithPrefix}
        </Typography.Link>
      ),
    },
    {
      title: columnNameConstant.order.ORDER_DATE,
      key: "orderCreated",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.order.created} />,
    },
    {
      title: columnNameConstant.delivery.DELIVERY_START_DATE,
      key: "deliveryStartDate",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.deliveryStartDate} />,
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "user",
      width: 120,
      render: (_, record) => getBrandName(record.order.user),
    },
    {
      title: columnNameConstant.user.USER_NAME,
      key: "firstName",
      width: 150,
      render: (_, record) => record.order.user?.firstName,
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.lines[0].orderLine.productSku, // 현재 서로 다른 상품은 합포장 하지 않도록 운영하기 때문에 lines에 1개의 상품만 존재하는 것이 보장됨
    },
    {
      title: columnNameConstant.product.BOX_SIZE_TYPE,
      key: "boxSize",
      width: 100,
      render: (_, record) => {
        const orderLineBoxSize = record.lines[0].orderLine.boxSize;
        const boxSizeLabelAndFormValue = getBoxSizeLabelAndFormValue(orderLineBoxSize);
        return (
          <Space direction="vertical" align="center">
            <Typography>{boxSizeLabelAndFormValue.label}</Typography>
            <Button onClick={() => onOrderLineBoxSizeUpdate(record.id)} size="small">
              변경
            </Button>
          </Space>
        );
      },
    },
    {
      title: columnNameConstant.delivery.GOODSFLOW_PRODUCT_NO,
      key: "goodsflowProductNumber",
      width: 150,
      render: (_, record) => {
        const fulfillmentLine = record.lines?.length > 0 ? record.lines[0] : undefined;
        const stockDetailLine =
          fulfillmentLine?.stockDetailLines?.length > 0 ? fulfillmentLine.stockDetailLines[0] : undefined;
        const rackName =
          stockDetailLine === undefined
            ? "미지정"
            : stockDetailLine?.rackLocation
            ? stockDetailLine?.rackLocation.name
            : "미지정";

        return (
          <>
            [{rackName}] [{fulfillmentLine.orderLine.productSku}]
          </>
        );
      },
    },
    {
      title: columnNameConstant.delivery.COURIER_NAME,
      key: "courierName",
      align: "center",
      width: 100,
      render: (_, record) => record.courier?.name || "-",
    },
    {
      title: columnNameConstant.delivery.TRACKING_NO,
      key: "trackingNumber",
      width: 120,
      render: (_, record) => (
        <Link onClick={() => openTrackingWindow(record.trackingNumber, record.courier.id, couriers)}>
          {record.trackingNumber}
        </Link>
      ),
    },
    {
      title: "",
      key: "action",
      width: 100,
      render: (_, record) => (
        <Goodsflow
          disabled={loading}
          mode="print-retry"
          setLoading={setLoading}
          onError={handleError}
          onSuccess={handleGoodsflowReprintSuccess}
          config={shop?.goodsflowPluginConfig}
          fulfillmentId={record.id}
        />
      ),
    },
  ];
  return columns;
}
</file>

