export const adjustCategoryQuery = (query: string) => {
  if (query && query.length > 0) {
    const regex = /\(([^)]+)\)\s*(.+)/;
    const match = query.match(regex);

    if (match && match.length === 3) {
      const result = match[2].trim();
      return result;
    }
  }
  return query;
};

export function getCategoryLabel(
  category: Pick<ProductDetails_product_category, "type" | "kind" | "name" | "parent">,
  prefixSetting?: {
    hideType?: boolean;
    hideKind?: boolean;
  }
) {
  if (!category) {
    return null;
  }
  const prefixTextArr = [];
  if (!prefixSetting?.hideType) {
    const categoryTypeText = getCategoryTypeText(category.type);
    prefixTextArr.push(categoryTypeText);
  }
  if (!prefixSetting?.hideKind) {
    const categoryKindText = utils.getLabelTextByValue(category.kind, categoryKindChoices);
    prefixTextArr.push(categoryKindText);
  }
  const categoryTypePrefix = prefixTextArr.length > 0 ? `(${prefixTextArr.join("/")}) ` : "";
  const parent = category.parent;

  // useSearchCategory 호출 시에 adjustCategoryQuery 로 처음 () 로 묶인 것을 벗겨내는 로직이 동작해야 하므로 아래 카테고리 타입 표현방식 수정 금지
  return parent != null
    ? `${categoryTypePrefix}${parent.name} > ${category.name}`
    : `${categoryTypePrefix}${category.name}`;
}

