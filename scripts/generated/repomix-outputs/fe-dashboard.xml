  <Space direction="vertical" size={0}>
    <Typography.Title level={4}>{sku ? `제품코드: ${sku}` : commonMsg.generalInformations}</Typography.Title>
    {sku && (
      <Typography.Text type="secondary" style={{ fontSize: 12 }}>
        판매 개시일: {firstAvailableForPurchaseDate || "-"} / 단종일: {stoppedAt || "-"}
      </Typography.Text>
    )}
  </Space>
);

const productTagColor = {
  isTaxFree: "green",
  dsDisabledDays: "red",
  is13siMagam: "purple",
  is15siMagam: "volcano",
  isPackage: "geekblue",
  isStopped: "#ff0000",
};

const makeProductInfoTags = (product: ProductDetails_product) => {
  const { isTaxFree } = product;
  const { isTaxFree: isTaxFreeColor } = productTagColor;
  return (
    <Space>
      <Tag color={isTaxFreeColor}>{transformTaxFree(isTaxFree)}</Tag>
    </Space>
  );
};

// NOTE: 직거래 상품인 경우(isFulfilledByVendor === true) 교차가능 여부, 직배송, 전용 여부, 아우터박스 재고 운영, 아우터박스 위탁 전환, 이너박스 운영 필드는 입력 X - UI 미노출 및 생성/수정 시 input에 전달 X
export const ProductDetailsForm: React.FC<ProductDetailsFormProps> = (props) => {
  const { data, product, disabled, isFulfilledByVendor, errors, onChange, categoryKind, onSaleOptions } = props;
  const isCreateMode = utils.isEmpty(product);
  const formErrors = getFormErrors(["name", "isTaxFree"], errors);
  const shopData = useShop();
  const salesStoppedReasonChoices = shopData?.stoppedReasonChoices;
  const [isDeferredConfirmModal, setIsDeferredConfirmModal] = React.useState<boolean>(false);

  const { canSaleByInner, hasVariants, isDevPv, isForCreditsRefill } = data;

  // 카테고리 구분(kind) 작업 후로 CategoryKindEnum.STANDARD가 아니면 isDevPv = true 또는 isForCreditsRefill = true로 설정됨
  const isStandardPv = isDevPv === false && isForCreditsRefill === false;
  const showProductQuantityField = isStandardPv;
  const showIsExclusiveField = isFulfilledByVendor === false && isForCreditsRefill === false;
  const showSalesStatusFields = isFulfilledByVendor ? isCreateMode === false : hasVariants === false;
  const showStockInfoFields = hasVariants === false && isStandardPv;
  const showDecimalPlacesFields = hasVariants === false && isForCreditsRefill === false;
  const showInnerVariantFields = hasVariants === false && canSaleByInner;
  const variantMaxOrderQtyDecimalValue: number = product?.outerVariants?.reduce(
    (acc, variant) => Math.max(acc, variant?.orderQtyDecimalPlaces),
    0
  );

  const isB2bCategoryKind = categoryKind === CategoryKindEnum.B2B;
  const isStandardCategoryKind = categoryKind === CategoryKindEnum.STANDARD;

  const onChangeWithValue = (name: string, value: any) => onChange({ target: { name, value } });

  const defaultVariant = product?.outerVariants
    ? product?.outerVariants?.find((variant) => variant?.id === product?.defaultVariant?.id)
    : undefined;
  const sku = getProductVariantSku(defaultVariant);
  const firstAvailableForPurchaseDate = getProductFirstAvailableForPurchaseDate(product);
  const stoppedAtDate = getProductStoppedAtDate(product);
  const cardTitle = makeProductCardTitle(sku, firstAvailableForPurchaseDate, stoppedAtDate);

  // 이너박스용 onSaleOptions (이너의 firstAvailableForPurchase 및 innerVariantId 사용)
  const innerOnSaleOptions: OnSaleOptionsType | undefined = onSaleOptions
    ? {
        outerVariantId: onSaleOptions.outerVariantId,
        innerVariantId: onSaleOptions.innerVariantId,
        firstAvailableForPurchase: defaultVariant?.inner?.firstAvailableForPurchase,
        onClickOnSaleButton: onSaleOptions.onClickOnSaleButton,
        loading: onSaleOptions.loading,
        sku,
      }
    : undefined;

  // 판매 가능 알림 모달 상태
  const [isOnSaleModalOpen, setIsOnSaleModalOpen] = React.useState(false);
  const [onSaleTargetVariantId, setOnSaleTargetVariantId] = React.useState<string | null>(null);

  const handleOpenOnSaleModal = (isInner: boolean) => {
    const targetId = isInner ? onSaleOptions?.innerVariantId : onSaleOptions?.outerVariantId;
    if (targetId) {
      setOnSaleTargetVariantId(targetId);
      setIsOnSaleModalOpen(true);
    }
  };

  const handleOnSaleModalOk = (recipientList: string[]) => {
    if (onSaleTargetVariantId && onSaleOptions) {
      onSaleOptions.onClickOnSaleButton(onSaleTargetVariantId, recipientList);
    }
    setIsOnSaleModalOpen(false);
    setOnSaleTargetVariantId(null);
  };

  const handleOnSaleModalCancel = () => {
    setIsOnSaleModalOpen(false);
    setOnSaleTargetVariantId(null);
  };

  const productNameField = (
    <FormFieldAntd isRequired label="제품명" error={formErrors.name} errorMsg={makeGqlErrorMsg(formErrors.name)}>
      <Input
        {...getFormInputCommonProps(disabled)}
        name="name"
        status={!!formErrors.name && "error"}
        placeholder="제품명을 입력해 주세요."
        value={data.name}
        onChange={onChange}
      />
    </FormFieldAntd>
  );
  const isTaxFreeField = (
    <FormFieldAntd
      isRequired
      label={columnNameConstant.product.IS_TAX_FREE}
      error={formErrors.isTaxFree}
      errorMsg={makeGqlErrorMsg(formErrors.isTaxFree)}
    >
      <Select
        {...getFormInputCommonProps(disabled)}
        placeholder="과세 방식 선택"
        value={data.isTaxFree}
        options={[
          {
            label: "과세 방식을 선택하세요.",
            value: undefined,
            disabled: true,
          },
          ...isTaxFreeChoices,
        ]}
        onChange={(value) => onChangeWithValue("isTaxFree", value)}
        disabled={disabled || isDevPv}
      />
    </FormFieldAntd>
  );
  const isExclusiveField = (
    <Col span={24} sm={12}>
      <FormFieldAntd
        label="전용 여부"
        description="활성화할 경우, 해당 제품으로 등록되는 브랜드 상품 모두 전용 상품으로 등록됩니다."
      >
        <Switch
          disabled={disabled || isDevPv || isB2bCategoryKind}
          checked={data.isExclusive}
          checkedChildren="ON"
          unCheckedChildren="OFF"
          onChange={(value) => {
            if (value) {
              showNotificationWarn(
                "활성화 상태로 저장 시 연결된 브랜드 상품들도 모두 전용 여부가 활성화 상태로 변경됩니다."
              );
            }
            onChangeWithValue("isExclusive", value);
          }}
        />
      </FormFieldAntd>
    </Col>
  );
  const outerCollapseHeader = (
    <Space>
      <Typography>{showInnerVariantFields ? "아우터박스 기본 정보" : "제품 기본 정보"}</Typography>
      {isCreateMode === false && makeProductInfoTags(product)}
    </Space>
  );

  return (
    <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
      <Collapse defaultActiveKey={["outer", "inner"]}>
        <Collapse.Panel header={outerCollapseHeader} key="outer">
          <Row justify="space-between" gutter={[12, 12]}>
            <Col xs={24} sm={isCreateMode ? 18 : 24}>
              {productNameField}
            </Col>
            {isCreateMode && (
              <Col xs={24} sm={6}>
                {isTaxFreeField}
              </Col>
            )}
            {showSalesStatusFields &&
              makeProductSalesStatusForm(props, salesStoppedReasonChoices, false, isCreateMode, onSaleOptions, () =>
                handleOpenOnSaleModal(false)
              )}
            <Divider style={{ margin: 0 }} />
            {showProductQuantityField && makeProductQuantityForm(props, false, variantMaxOrderQtyDecimalValue)}
            {showIsExclusiveField && isExclusiveField}
            {showStockInfoFields &&
              makeProductStockInfoForm(
                props,
                isDeferredConfirmModal,
                setIsDeferredConfirmModal,
                isB2bCategoryKind,
                isStandardCategoryKind
              )}
            {showDecimalPlacesFields && makeProductDecimalPlacesForm(props, isCreateMode)}
          </Row>
        </Collapse.Panel>
        {showInnerVariantFields && (
          <Collapse.Panel header="이너박스 기본 정보" key="inner">
            <Row justify="space-between" gutter={[12, 12]}>
              {showSalesStatusFields &&
                makeProductSalesStatusForm(
                  props,
                  salesStoppedReasonChoices,
                  true,
                  isCreateMode,
                  innerOnSaleOptions,
                  () => handleOpenOnSaleModal(true)
                )}
              {makeProductQuantityForm(props, true, variantMaxOrderQtyDecimalValue)}
            </Row>
          </Collapse.Panel>
        )}
      </Collapse>
      <OnSaleNotificationModal
        open={isOnSaleModalOpen}
        sku={sku}
        loading={onSaleOptions?.loading}
        onOk={handleOnSaleModalOk}
        onCancel={handleOnSaleModalCancel}
      />
    </Card>
