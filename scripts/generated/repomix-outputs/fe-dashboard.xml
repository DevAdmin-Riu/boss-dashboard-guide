// 제품 상태 폼
export const makeProductSalesStatusForm = (
  props: ProductDetailsFormProps | ProductVariantBasicFormProps,
  salesStoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[],
  isInnerVariant: boolean = false,
  isCreateMode: boolean,
  onSaleOptions?: OnSaleOptionsType,
  onOpenOnSaleModal?: () => void
) => {
  const { data, disabled, isFulfilledByVendor, errors, onChange } = props;
  const salesStatusKey = isInnerVariant ? "innerSalesStatus" : "salesStatus";
  const stoppedReasonKey = isInnerVariant ? "innerStoppedReason" : "stoppedReason";
  const stoppedReasonEtcKey = isInnerVariant ? "innerStoppedReasonEtc" : "stoppedReasonEtc";
  const formErrors = getFormErrors([salesStatusKey, stoppedReasonKey, stoppedReasonEtcKey], errors);
  const salesStatus = data[salesStatusKey];
  const showStopReasonInput =
    salesStatus === SalesStatusEnum.WILL_BE_STOPPED || salesStatus === SalesStatusEnum.STOPPED;
  const isStoppedReasonEtc = data[stoppedReasonKey] === StoppedReasonTypeEnum.ETC;
  const onChangeWithValue = (name: string, value: any) => onChange({ target: { name, value } });

  // 판매 가능 알림 버튼 표시 조건:
  // - 판매개시일이 null
  // - 생성 모드가 아닌 경우
  const targetVariantId = isInnerVariant ? onSaleOptions?.innerVariantId : onSaleOptions?.outerVariantId;
  const showOnSaleButton = onSaleOptions?.firstAvailableForPurchase === null && !isCreateMode && !!targetVariantId;

  const handleOnSaleButtonClick = () => {
    if (onOpenOnSaleModal) {
      onOpenOnSaleModal();
    }
  };

  return (
    <Col span={24}>
      <FormFieldAntd
        isRequired
        label="제품 상태"
        error={formErrors[salesStatusKey]}
        errorMsg={makeGqlErrorMsg(formErrors[salesStatusKey])}
      >
        <Input.Group>
          <Space direction="vertical" size="small">
            <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
              <Select
                {...getFormInputCommonProps(disabled)}
                style={{ flex: 3 }}
                placeholder="제품 상태를 선택해 주세요."
                value={salesStatus}
                options={getSalesStatusChoices(
                  false,
                  isFulfilledByVendor,
                  false,
                  isCreateMode,
                  onSaleOptions?.firstAvailableForPurchase
                )}
                onChange={(value) => {
                  if (value === SalesStatusEnum.ON_SALE && isCreateMode === false) {
                    onChangeWithValue(stoppedReasonKey, null);
                    onChangeWithValue(stoppedReasonEtcKey, null);
                  }
                  onChangeWithValue(salesStatusKey, value);
                }}
              />
              {showStopReasonInput && (
                <Select
                  {...getFormInputCommonProps(disabled)}
                  style={{ flex: 7 }}
                  disabled={disabled}
                  placeholder="단종 사유를 선택해 주세요."
                  value={data[stoppedReasonKey]}
                  options={salesStoppedReasonChoices}
                  onChange={(value) => onChangeWithValue(stoppedReasonKey, value)}
                />
              )}
              {showOnSaleButton && (
                <Button type="primary" onClick={handleOnSaleButtonClick} loading={onSaleOptions?.loading}>
                  판매 가능 알림
                </Button>
              )}
            </div>
            {isStoppedReasonEtc && (
              <Input.TextArea
                {...getFormInputCommonProps(disabled)}
                placeholder="기타 단종 사유를 입력해 주세요."
                name={stoppedReasonEtcKey}
                value={data[stoppedReasonEtcKey]}
                onChange={onChange}
              />
            )}
          </Space>
        </Input.Group>
      </FormFieldAntd>
      {!!formErrors[stoppedReasonKey] && (
        <Typography.Text type="danger">{makeGqlErrorMsg(formErrors[stoppedReasonKey])}</Typography.Text>
      )}
      {!!formErrors[stoppedReasonEtcKey] && (
        <Typography.Text type="danger">{makeGqlErrorMsg(formErrors[stoppedReasonEtcKey])}</Typography.Text>
      )}
    </Col>
  );
};

// 제품 수량(최소주문수량, 단위주문수량, 교차가능 여부) 폼
export const makeProductQuantityForm = (
  props: ProductDetailsFormProps | ProductVariantBasicFormProps,
  isInnerVariant: boolean,
  variantMaxOrderQtyDecimalValue: number // 옵션 생성 시, 최대 주문 수량 소수점 자리 수
) => {
  const { data, disabled, isFulfilledByVendor, errors, onChange } = props;
  const moqKey = isInnerVariant ? "innerMoq" : "moq";
  const uoqKey = isInnerVariant ? "innerUoq" : "uoq";
  // NOTE: 직거래 상품이거나 이너박스 제품인 경우, 교차가능 여부를 설정하지 않으므로 key를 null로 설정. 옵션 상세 페이지에서도 사용되기 때문에 아래와 같은 키값 null 처리 필요
  const excludeAllowMixedMultipleOfUoq = isFulfilledByVendor || isInnerVariant;
  const allowMixedMultipleOfUoqKey = excludeAllowMixedMultipleOfUoq ? null : "allowMixedMultipleOfUoq";
  const formErrors = getFormErrors([moqKey, uoqKey], errors);
  const onChangeWithValue = (name: string, value: any) => onChange({ target: { name, value } });
  const onChangeUoqValue = (value: number) => {
    onChange({ target: { name: uoqKey, value } });
    // 직거래 상품 또는 이너박스 제품인 경우, 교차가능 여부를 설정하지 않음.
    if (excludeAllowMixedMultipleOfUoq) {
      return;
    }

    const numberValue = utils.convertToNumberWrapper(value, 1);

    let allowMixedMultipleOfUoq = data[allowMixedMultipleOfUoqKey];
    if (numberValue <= 0) {
      allowMixedMultipleOfUoq = false;
    }

    if (data[allowMixedMultipleOfUoqKey] !== allowMixedMultipleOfUoq) {
      onChangeWithValue("allowMixedMultipleOfUoq", allowMixedMultipleOfUoq);
    }
  };

  const { hasVariants, orderQtyDecimalPlaces = 0 } = data;
  const canEditAllowMixedMultipleMoq = hasVariants;
  const precision = Math.max(orderQtyDecimalPlaces, variantMaxOrderQtyDecimalValue || 0);

  return (
    <>
      <Col xs={24} sm={12}>
        <FormFieldAntd
          isRequired
          label="최소주문수량"
          subLabel="(입력한 수량 이상이 되어야 매장이 주문 가능합니다.)"
          error={formErrors[moqKey]}
          errorMsg={makeGqlErrorMsg(formErrors[moqKey])}
        >
          <InputNumber
            {...getFormInputCommonProps(disabled)}
            name={moqKey}
            status={!!formErrors[moqKey] && "error"}
            value={data[moqKey]}
            onChange={(value) => onChange({ target: { name: moqKey, value } })}
            {...getInputNumberProps({ precision, isCommaDisplay: true })}
          />
        </FormFieldAntd>
      </Col>
      <Col xs={24} sm={12}>
        <FormFieldAntd
          isRequired
          label="단위주문수량"
          subLabel="(입력한 수량 단위로 매장이 주문 가능합니다.)"
          error={formErrors[uoqKey]}
          errorMsg={makeGqlErrorMsg(formErrors[uoqKey])}
        >
          <InputNumber
            {...getFormInputCommonProps(disabled)}
            name={uoqKey}
            status={!!formErrors[uoqKey] && "error"}
            value={data[uoqKey]}
            onChange={(value) => onChangeUoqValue(value)}
            {...getInputNumberProps({ precision, isCommaDisplay: true })}
          />
        </FormFieldAntd>
      </Col>
      {excludeAllowMixedMultipleOfUoq === false && (
        <Col span={24}>
          <Checkbox
            checked={data[allowMixedMultipleOfUoqKey]}
            disabled={disabled || canEditAllowMixedMultipleMoq === false}
            name="allowMixedMultipleOfUoq"
            onChange={(e) => onChangeWithValue("allowMixedMultipleOfUoq", e.target.checked)}
          >
            <Typography.Text>
              교차가능 여부 (교차가능으로 설정 시 옵션 구매 수량의 합으로 배수 주문 체크)
              {canEditAllowMixedMultipleMoq === false && <Typography.Text type="danger"> - 선택불가</Typography.Text>}
            </Typography.Text>
          </Checkbox>
        </Col>
      )}
    </>
  );
};

