import CategoryDetails from "../CategoryDetails";
import CategoryList from "../CategoryList";
import CategoryProducts from "../CategoryProducts";

export type CategoryBasicInfoUpdateForm = Pick<
  CategoryInput,
  "name" | "type" | "backgroundImage" | "backgroundImageAlt" | "shipmentInspectionFile"
>;

export enum CategoryPageTab {
  categories = "categories",
  products = "products",
}

interface CategoryDetailsPageProps extends PaginateListProps {
  onTabChange: (tabKey: CategoryPageTab) => void;
  currentTab: CategoryPageTab;
  disabled: boolean;
  category: CategoryDetails_category;
  products: CategoryDetails_category_products_edges_node[];
  subcategories: CategoryDetails_category_children_edges_node[];
  editMode: CategoryDetailsEditModeEnum;
  onEdit: (mode: CategoryDetailsEditModeEnum) => void;
  onEditCancel: () => void;
  onBasicInfoUpdate: (formData: CategoryBasicInfoUpdateForm) => void;
  onProductClick: (productId: string) => void;
  onCategoryClick: (categoryId: string) => void;
  onProductAdd: () => void;
  onCategoryAdd: () => void;
  onBack: () => void;
}

export const CategoryDetailsPage: React.FC<CategoryDetailsPageProps> = ({
  onTabChange,
  currentTab,
  category,
  disabled,
  products,
  subcategories,
  editMode,
  onEdit,
  onEditCancel,
  onBasicInfoUpdate,
  onProductClick,
  onCategoryClick,
  onProductAdd,
  onCategoryAdd,
  onBack,
  ...productOrSubcategoryTableProps
}) => {
  const [basicInfoForm] = Form.useForm<CategoryBasicInfoUpdateForm>();
  const isEditing = utils.isEmpty(editMode) === false;

  const basicInfoInitialValues: CategoryBasicInfoUpdateForm = {
    name: category.name || "",
    type: findValueInEnum(category?.type, CategoryTypeEnum),
    backgroundImage: toUploadFormInitialValue(category.backgroundImage, "alt"),
    backgroundImageAlt: category.backgroundImage?.alt,
    shipmentInspectionFile: toUploadFormInitialValue(category.shipmentInspectionFile, "name"),
  };

  useEffect(() => {
    basicInfoForm.resetFields();
  }, [editMode]);

  const columns = getCategoryListTableSettings(onCategoryClick);

  const makeTabBarExtraContent = (tab: CategoryPageTab) => {
    switch (tab) {
      case CategoryPageTab.categories:
        return (
          <Button type="primary" onClick={onCategoryAdd}>
            세부 카테고리 추가
          </Button>
        );
      case CategoryPageTab.products:
        return (
          <Button type="primary" onClick={onProductAdd}>
            제품 추가
          </Button>
        );
      default:
        return null;
    }
  };

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.categories}</AppHeader>
      <PageHeader title={category ? category.name : undefined} />

      <Space direction="vertical" size="large">
        <Form
          name="collection-basic-info"
          layout="vertical"
          form={basicInfoForm}
          disabled={disabled || (isEditing && editMode !== CategoryDetailsEditModeEnum.UpdateBasicInfo)}
          initialValues={basicInfoInitialValues}
          onFinish={onBasicInfoUpdate}
        >
          <CategoryDetails
            isCreate={false}
            form={basicInfoForm}
            category={category}
            editModeProps={{
              isEditMode: editMode === CategoryDetailsEditModeEnum.UpdateBasicInfo,
              onEdit: () => onEdit(CategoryDetailsEditModeEnum.UpdateBasicInfo),
              onCancel: onEditCancel,
            }}
          />
        </Form>

        <Card
          tabProps={{ tabBarGutter: 24 }}
          activeTabKey={currentTab}
          tabBarExtraContent={makeTabBarExtraContent(currentTab)}
          onTabChange={onTabChange}
          tabList={[
            { key: CategoryPageTab.categories, tab: "세부 카테고리" },
            { key: CategoryPageTab.products, tab: "제품 리스트" },
          ]}
        >
          {currentTab === CategoryPageTab.categories && (
            <CategoryList
              {...productOrSubcategoryTableProps}
              categories={subcategories}
              disabled={disabled}
              isRoot={false}
              onRowClick={onCategoryClick}
              columns={columns}
            />
          )}
          {currentTab === CategoryPageTab.products && (
            <CategoryProducts
              {...productOrSubcategoryTableProps}
              products={products}
              disabled={disabled}
              onRowClick={onProductClick}
              onAdd={onProductAdd}
            />
          )}
        </Card>
      </Space>
    </>
  );
};
export default CategoryDetailsPage;
</file>

