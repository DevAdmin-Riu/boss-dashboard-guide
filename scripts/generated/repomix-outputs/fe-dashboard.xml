<file path="src/app/views/stats/utils/categoryKindMapper.ts">
import { CategoryKindEnum } from "@src/api/types/globalTypes";
import { StrictOmit } from "@src/global/core/types/types";

// 제품 구분 필터용 확장 타입 (UI에서만 사용, 실제 enum은 아님)
export const FULFILLED_BY_VENDOR = "FULFILLED_BY_VENDOR" as const;
export type ProductCategoryKind = CategoryKindEnum | typeof FULFILLED_BY_VENDOR;

// CategoryKindEnum union에 FULFILLED_BY_VENDOR 추가
export const ExtendedCategoryKindEnum = {
  ...CategoryKindEnum,
  FULFILLED_BY_VENDOR,
} as const;

export const productCategoryKindChoicesForSalesStatFilter: Array<{
  label: string;
  value: ProductCategoryKind;
}> = [
  { label: "포장보스", value: CategoryKindEnum.STANDARD },
  { label: "B2B", value: CategoryKindEnum.B2B },
  { label: "직거래", value: FULFILLED_BY_VENDOR },
];

interface CategoryKindMapping {
  categoryKind: CategoryKindEnum[];
  isFulfilledByVendor: boolean | undefined;
  isSubPv: boolean | undefined;
}

// ============================================
// 매핑 테이블
// ============================================
// 키 형식: "포장보스-B2B-직거래" (1=선택, 0=미선택)
// 예: "101" = 포장보스(1) + B2B(0) + 직거래(1)

const CATEGORY_MAPPINGS: Record<string, StrictOmit<CategoryKindMapping, "isSubPv">> = {
  // "000": 아무것도 선택 안함
  "000": {
    categoryKind: [CategoryKindEnum.B2B, CategoryKindEnum.STANDARD],
    isFulfilledByVendor: undefined,
  },

  // "100": 포장보스만
  "100": {
    categoryKind: [CategoryKindEnum.STANDARD],
    isFulfilledByVendor: false,
  },

  // "010": B2B만
  "010": {
    categoryKind: [CategoryKindEnum.B2B],
    isFulfilledByVendor: undefined,
  },

  // "001": 직거래만
  "001": {
    categoryKind: [CategoryKindEnum.STANDARD],
    isFulfilledByVendor: true,
  },

  // "110": 포장보스 + B2B
  "110": {
    categoryKind: [CategoryKindEnum.STANDARD, CategoryKindEnum.B2B],
    isFulfilledByVendor: false,
  },

  // "101": 포장보스 + 직거래
  "101": {
    categoryKind: [CategoryKindEnum.STANDARD],
    isFulfilledByVendor: undefined,
  },

  // "011": B2B + 직거래
  "011": {
    categoryKind: [CategoryKindEnum.STANDARD, CategoryKindEnum.B2B],
    isFulfilledByVendor: true,
  },

  // "111": 포장보스 + B2B + 직거래 (전체 선택)
  "111": {
    categoryKind: [CategoryKindEnum.STANDARD, CategoryKindEnum.B2B],
    isFulfilledByVendor: undefined,
  },
};

export function mapCategoryKindToQueryVariables(selectedCategories: ProductCategoryKind[]): CategoryKindMapping {
  const hasStandard = selectedCategories.includes(CategoryKindEnum.STANDARD);
  const hasB2B = selectedCategories.includes(CategoryKindEnum.B2B);
  const hasFulfilled = selectedCategories.includes(FULFILLED_BY_VENDOR);

  // 선택 상태를 키로 변환
  // 예: 포장보스(O) + B2B(X) + 직거래(O) = "101"
  const key = `${hasStandard ? "1" : "0"}${hasB2B ? "1" : "0"}${hasFulfilled ? "1" : "0"}`;

  return { ...CATEGORY_MAPPINGS[key], isSubPv: false };
}

export function convertUrlToProductCategoryKind(urlValues: string[] | undefined): ProductCategoryKind[] {
  if (!urlValues || urlValues.length === 0) {
    return [];
  }

  return urlValues.filter(
    (value) => value === CategoryKindEnum.STANDARD || value === CategoryKindEnum.B2B || value === FULFILLED_BY_VENDOR
  ) as ProductCategoryKind[];
}
