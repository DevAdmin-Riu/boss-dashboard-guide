import { VirtualAccountStatusFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  VirtualAccountFilterKeys,
  VirtualAccountListFilterOpts,
} from "../../components/VirtualAccountListPage/filters";
import {
  VirtualAccountListViewUrlFilters,
  VirtualAccountListViewUrlFiltersEnum,
  VirtualAccountListViewUrlQueryParams,
} from "../../urls";

const VIRTUAL_ACCOUNT_FILTERS_KEY = "virtualAccountFilters";

export function getFilterOpts(params: VirtualAccountListViewUrlFilters): VirtualAccountListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    orgSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orgSearch, true), false),
      value: maybe(() => filterVariables.orgSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
  };
}

export function getFilterVariables(params: VirtualAccountListViewUrlFilters): VirtualAccountStatusFilterInput {
  return {
    orgSearch: params.orgSearch,
    brandSearch: params.brandSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<VirtualAccountFilterKeys>
): VirtualAccountListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case VirtualAccountFilterKeys.orgSearch:
      return getSingleValueQueryParam(filter, VirtualAccountListViewUrlFiltersEnum.orgSearch);
    case VirtualAccountFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, VirtualAccountListViewUrlFiltersEnum.brandSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<VirtualAccountListViewUrlFilters>(VIRTUAL_ACCOUNT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  VirtualAccountListViewUrlQueryParams,
  VirtualAccountListViewUrlFilters
>(VirtualAccountListViewUrlFiltersEnum);
