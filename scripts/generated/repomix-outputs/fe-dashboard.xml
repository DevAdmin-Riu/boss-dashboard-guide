import { EditOutlined } from "@ant-design/icons";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import { FormSaveButtonEditModeProps } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { Button, Card, Form, Input, Space, Tree, Typography } from "antd";
import { DataNode, TreeProps } from "antd/lib/tree";
import React, { Key } from "react";

import { BsOpsCheckTemplateCategoryUpdateVariables } from "../../api/types/BsOpsCheckTemplateCategoryUpdate";
import { BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories } from "../../api/types/BsOpsCheckTemplateDetails";

interface CommonProps extends Pick<TreeProps, "checkedKeys" | "onCheck" | "selectedKeys" | "onSelect" | "onDrop"> {
  onAdd: () => void;
  onRemove: () => void;
}
interface CreateProps {
  isCreate: true;
  categoryList: Array<{ key: Key; formListIdx: number }>;
}
interface UpdateProps {
  isCreate: false;
  TypeSafeForm: TypeSafeForm<BsOpsCheckTemplateCategoryUpdateVariables>;
  categoryList: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories[];
  editModeProps: FormSaveButtonEditModeProps;
}
type BsOpsCheckTemplateCategoryTreePanelProps = CommonProps & (CreateProps | UpdateProps);

export const BsOpsCheckTemplateCategoryTreePanel: React.FC<BsOpsCheckTemplateCategoryTreePanelProps> = (props) => {
  const { isCreate, onAdd, onRemove, ...treeProps } = props;
  const checkedKeys = treeProps.checkedKeys as Key[];
  const isUpdate = isCreate === false;

  const categoryIdWatched = isUpdate && props.TypeSafeForm.getUseFormWatched({ name: "id" });
  const isEditingCategory = isUpdate && props.editModeProps.isEditMode;

  const treeData: DataNode[] = [];
  if (isCreate) {
    const { categoryList } = props;
    categoryList.forEach((cat) => {
      treeData.push({
        key: cat.key,
        title: (
          <Form.Item
            style={{ margin: 0 }}
            name={[cat.formListIdx, "name"]}
            rules={[{ required: true, message: formRuleMsg.required }]}
          >
            <Input placeholder="카테고리 이름" />
          </Form.Item>
        ),
      });
    });
  }
  if (isUpdate) {
    const { categoryList, TypeSafeForm, editModeProps } = props;
    const { formInstance } = TypeSafeForm;
    const { isEditMode, onEdit, onCancel } = editModeProps;

    const makeCategoryTitle = (
      cat: Pick<BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories, "id" | "name">,
      itemCount: number
    ) =>
      isEditMode && categoryIdWatched === cat.id ? (
        <FixedSplitRow
          mainContent={
            <Form.Item
              style={{ margin: 0 }}
              name={TypeSafeForm.getValidDataIndex("input.name")}
              rules={[{ required: true, message: formRuleMsg.required }]}
            >
              <Input placeholder="카테고리 이름" />
            </Form.Item>
          }
          sideContent={
            <Form.Item noStyle shouldUpdate>
              {() => (
                <Space direction="vertical" size={0}>
                  <Button
                    size="small"
                    type="primary"
                    disabled={!formInstance.isFieldsTouched()}
                    onClick={(e) => {
                      e.stopPropagation();
                      formInstance.submit();
                    }}
                  >
                    저장
                  </Button>
                  <Button
                    size="small"
                    onClick={(e) => {
                      e.stopPropagation();
                      onCancel();
                    }}
                  >
                    취소
                  </Button>
                </Space>
              )}
            </Form.Item>
          }
        />
      ) : (
        <FixedSplitRow
          align="middle"
          mainContent={
            <Typography>
              {cat.name} {itemCount > 0 ? `(${itemCount})` : <Typography.Text type="danger">(0)</Typography.Text>}
            </Typography>
          }
          sideContent={
            <EditOutlined
              onClick={(e) => {
                e.stopPropagation();
                TypeSafeForm.setFields([
                  { name: "id", value: cat.id },
                  { name: "input", value: { name: cat.name } },
                ]);
                onEdit();
              }}
            />
          }
        />
      );

    categoryList.forEach((cat) => {
      const children = cat.children;
      const totalItemCount = children.reduce((count, child) => count + child.items.length, 0);

      treeData.push({
        key: cat.id,
        selectable: false,
        title: makeCategoryTitle(cat, totalItemCount),
        children: children.map((child) => ({
          key: child.id,
          title: makeCategoryTitle(child, child.items.length),
        })),
      });
    });
  }

  return (
    <Card
      type="inner"
      style={{ width: 350 }}
      title="카테고리"
      extra={
        <Space size="small">
          <Button type="primary" size="small" onClick={() => onAdd()}>
            추가
          </Button>
          <Button danger type="primary" size="small" disabled={checkedKeys.length === 0} onClick={() => onRemove()}>
            선택 제거
          </Button>
        </Space>
      }
    >
      {isEditingCategory && (
        <>
          <Form.Item name={props.TypeSafeForm.getValidDataIndex("id")} hidden>
            <Input />
          </Form.Item>
        </>
      )}
      <Tree
        {...treeProps}
        defaultExpandAll
        blockNode
        checkable={!isEditingCategory}
        draggable={!isEditingCategory}
        treeData={treeData}
      />
    </Card>
  );
};
</file>

