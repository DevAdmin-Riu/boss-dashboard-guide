<file path="src/app/views/brand/brands/components/BrandEtcFileListModal.tsx">
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { utils } from "@utils/utils";
import { Button, Modal, Space, Typography } from "antd";
import { ColumnsType, ColumnType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { BrandDetails_brand_etcFiles } from "../api/types/BrandDetails";
import { getBrandEtcFileDateRangeText, getBrandEtcFileTypeText, makeBrandEtcFilesDataSource } from "../utils";

export interface BrandEtcFileDataSource extends BrandDetails_brand_etcFiles {
  deposit: number | null;
  fee: number | null;
}

interface BrandEtcFileListModalProps {
  open: boolean;
  etcFiles: BrandDetails_brand_etcFiles[];
  etcInfo: any;
  openEtcFileModal: (etcFile: BrandEtcFileDataSource, isCreateMode: boolean) => void;
  onCancel: () => void;
}

export const BrandEtcFileListModal: React.FC<BrandEtcFileListModalProps> = (props) => {
  const { open, etcFiles, etcInfo, openEtcFileModal, onCancel } = props;
  const [contractDataSource, setContractDataSource] = useState<BrandEtcFileDataSource[]>([]);
  const [feeDataSource, setFeeDataSource] = useState<BrandEtcFileDataSource[]>([]);

  const fixedRightFlag = utils.fixedRightFlag();

  useEffect(() => {
    const defaultContractDataSource = makeBrandEtcFilesDataSource(etcFiles, etcInfo, true);
    setContractDataSource(defaultContractDataSource);

    const defaultFeeDataSource = makeBrandEtcFilesDataSource(etcFiles, etcInfo, false);
    setFeeDataSource(defaultFeeDataSource);
  }, [open, etcFiles, etcInfo]);

  const typeColumn: ColumnType<BrandEtcFileDataSource> = {
    key: "type",
    width: 150,
    align: "center",
    render: (_, record) => getBrandEtcFileTypeText(record?.type),
  };
  const startDateColumn: ColumnType<BrandEtcFileDataSource> = {
    title: "갱신일",
    key: "contractDate",
    width: 120,
    align: "center",
    render: (_, record) => (record?.contractDate ? record.contractDate : "-"),
  };
  const dateRangeColumn: ColumnType<BrandEtcFileDataSource> = {
    title: "계약기간",
    key: "dateRange",
    width: 200,
    align: "center",
    render: (_, record) => getBrandEtcFileDateRangeText(record),
  };
  const depositColumn: ColumnType<BrandEtcFileDataSource> = {
    title: [columnNameConstant.brand.INSURANCE_DEPOSIT, columnNameConstant.brand.DEPOSIT],
    key: "deposit",
    width: 120,
    align: "right",
    render: (_, record) => <NumberComponent value={record.deposit} includeCurrency />,
  };
  const feeColumn: ColumnType<BrandEtcFileDataSource> = {
    title: "수수료(%)",
    key: "fee",
    width: 100,
    align: "right",
    render: (_, record) => <NumberComponent value={record.fee} postFix={"%"} />,
  };
  const descriptionColumn: ColumnType<BrandEtcFileDataSource> = {
    title: "비고",
    key: "description",
    width: 150,
    align: "center",
    render: (_, record) => record?.description || "-",
  };
  const urlColumn: ColumnType<BrandEtcFileDataSource> = {
    title: "첨부자료",
    key: "url",
    width: 200,
    align: "center",
    render: (_, record) =>
      utils.isEmpty(record?.url, true) ? (
        "-"
      ) : (
        <Typography.Link href={record.url} target="_blank">
          {record?.fileName || "파일 이름 없음"}
        </Typography.Link>
      ),
  };
  const actionColumn: ColumnType<BrandEtcFileDataSource> = {
    key: "action",
    width: 100,
    align: "center",
    fixed: fixedRightFlag,
    render: (_, record) =>
      utils.isEmpty(record?.id) ? (
        <Button type="primary" onClick={() => openEtcFileModal(record, true)}>
          등록
        </Button>
      ) : (
        <Button type="primary" onClick={() => openEtcFileModal(record, false)}>
          수정
        </Button>
      ),
  };

  const contractFileColumns: ColumnsType<BrandEtcFileDataSource> = [
    typeColumn,
    startDateColumn,
    dateRangeColumn,
    depositColumn,
    descriptionColumn,
    urlColumn,
    actionColumn,
  ];
  const contractFileTableWidthSum = utils.calcTableColsWidthSum(contractFileColumns);

  const feeFileColumns: ColumnsType<BrandEtcFileDataSource> = [
    typeColumn,
    startDateColumn,
    feeColumn,
    descriptionColumn,
    urlColumn,
    actionColumn,
  ];
  const feeFileTableWidthSum = utils.calcTableColsWidthSum(feeFileColumns);

  const modalFooter = (
    <Button type="default" onClick={onCancel}>
      뒤로
    </Button>
  );

  return (
    <Modal
      forceRender
      destroyOnClose
      title={"계약서 관리"}
      width={950}
      open={open}
