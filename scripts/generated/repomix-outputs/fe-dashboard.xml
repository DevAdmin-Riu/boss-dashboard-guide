import { PaginateListProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { Button, Card, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useState } from "react";

import {
  CollectionDetails_collection,
  CollectionDetails_collection_products_edges_node,
} from "../../api/types/CollectionDetails";

interface CollectionProductsProps extends PaginateListProps {
  collection: CollectionDetails_collection;
  onProductUnassign: (id: string, productNameForModal: string) => void;
  onProductsUnassign: (ids: string[]) => void;
}

const CollectionProducts: React.FC<CollectionProductsProps> = (props) => {
  const {
    collection,
    disabled,
    onAdd,
    onNextPage,
    onPreviousPage,
    onProductUnassign,
    onProductsUnassign,
    onRowClick,
    pageInfo,
  } = props;
  const [selectedRowKeys, setSelectedRowKeys] = useState<string[]>([]);
  const dataSource = maybe(() => collection.products.edges.map((edge) => edge.node), []);

  const onProductUnassignClick = () => {
    if (selectedRowKeys.length === 1) {
      const selectedProductId = selectedRowKeys[0];
      const selectedProduct = dataSource?.find((data) => data?.id === selectedProductId)?.name || "";
      onProductUnassign(selectedProductId, selectedProduct);
    } else {
      onProductsUnassign(selectedRowKeys);
    }
  };

  const getCollectionProductsTableColumns = () => {
    const columns: ColumnsType<CollectionDetails_collection_products_edges_node> = [
      {
        title: "제품명",
        key: "name",
        align: "left",
        width: 200,
        render: (_, record) => (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.name || "-"}</Typography.Link>
        ),
      },
      {
        title: "제품 타입",
        key: "productTypeName",
        align: "left",
        width: 150,
        render: (_, record) => record.productType.name || "-",
      },
    ];
    return columns;
  };

  return (
    <Card
      loading={disabled}
      title={<Typography.Title level={4}>연동 제품 리스트</Typography.Title>}
      extra={
        <Space>
          <Button disabled={disabled || selectedRowKeys.length === 0} onClick={onProductUnassignClick}>
            연동 해제
          </Button>
          <Button disabled={disabled} type="primary" onClick={onAdd}>
            제품 연동
          </Button>
        </Space>
      }
      bodyStyle={{ padding: 0 }}
    >
      <Table
        {...commonTableProps}
        dataSource={dataSource}
        columns={getCollectionProductsTableColumns()}
        rowSelection={{
          selectedRowKeys,
          onChange: (selectedRowKeys) => setSelectedRowKeys(selectedRowKeys as string[]),
        }}
        footer={() => (
          <TableListFooter
            disabled={disabled}
            pageInfo={pageInfo}
            onPreviousPage={onPreviousPage}
            onNextPage={onNextPage}
          />
        )}
      />
    </Card>
  );
};

