import { BrandPackageListTable } from "../BrandPackageListTable/BrandPackageListTable";
import { BrandProductListTable } from "../BrandProductListTable/BrandProductListTable";
import { BrandProductFilterKeys, BrandProductListFilterOpts } from "./filters";

interface BrandProductListPageProps
  extends ListProps,
    FilterPageProps<BrandProductFilterKeys, BrandProductListFilterOpts> {
  brand: BrandForBpvList_brand;
  enableForB2bService: boolean;
  brandProducts: BrandProductAndBrandProductPackageType[];
  brandPackages: BrandProductPackages_brandProductPackages_edges_node[];
  brandBundles: BpBundles_bpBundles_edges_node[];
  loading: boolean;
  isFulfilledByVendor: boolean;
  onProductAssign: () => void;
  onProductPackageCreate: () => void;
  onProductPackageUpdate: (record: BrandProductPackages_brandProductPackages_edges_node) => void;
  onProductPackageDelete: (record: BrandProductPackages_brandProductPackages_edges_node) => void;
  onProductBundleCreate?: () => void;
  onProductBundleUpdate: (record: BpBundles_bpBundles_edges_node) => void;
  onProductBundleDelete: (record: BpBundles_bpBundles_edges_node) => void;
  onProductReorder: () => void;
  onBrandProductVariantBulkCreate: () => void;
  onBrandProductVariantBulkUpdate: () => void;
  onBack: () => void;
  selectedRowId: string;
  setSelectedRowId: React.Dispatch<React.SetStateAction<string>>;
}

export const BrandProductListPage: React.FC<BrandProductListPageProps> = (props) => {
  const {
    brand,
    enableForB2bService,
    brandProducts,
    brandPackages,
    brandBundles,
    loading,
    isFulfilledByVendor,
    onProductAssign,
    onProductPackageCreate,
    onProductPackageUpdate,
    onProductPackageDelete,
    onProductBundleCreate,
    onProductBundleUpdate,
    onProductBundleDelete,
    onProductReorder,
    onBrandProductVariantBulkCreate,
    onBrandProductVariantBulkUpdate,
    selectedRowId,
    setSelectedRowId,
    onBack,
    ...listAndFilterProps
  } = props;
  const { productType } = useParams<BrandProductListViewRouteParams>();
  const navigate = useNavigator();
  const brandId = brand?.id;
  const sectionName = `상품 리스트(${brand?.name || "-"})`;
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);

  const sectionBtn = (
    <SwapNavButtonBar
      options={[
        {
          text: `${transformIsFBV(false)} 상품`,
          url: brandProductListViewUrl({ brandId, productType: "boss" }),
        },
        {
          text: `${transformIsFBV(false)} 세트 상품`,
          url: brandProductListViewUrl({ brandId, productType: "bundle" }),
        },
        {
          text: `${transformIsFBV(false)} 패키지 상품`,
          url: brandProductListViewUrl({ brandId, productType: "package" }),
        },
        {
          text: `${transformIsFBV(true)} 상품`,
          url: brandProductListViewUrl({ brandId, productType: "fbv" }),
          exclude: enableForFbvService === false,
        },
      ]}
    />
  );

  const brandProductVariantBulkUpdateButton = (
    <Tooltip placement={"bottomRight"} title={"브랜드 상품에 대해서만 파일 업로드와 수정이 가능합니다"}>
      <Button type={"default"} disabled={loading} shape={"round"} onClick={onBrandProductVariantBulkUpdate}>
        상품 일괄 수정
      </Button>
    </Tooltip>
  );

  const brandProductVariantBulkCreateButton = (
    <Tooltip placement={"bottomRight"} title={"브랜드 상품을 신규 등록합니다"}>
      <Button type={"primary"} disabled={loading} shape={"round"} onClick={onBrandProductVariantBulkCreate}>
        상품 일괄 등록
      </Button>
    </Tooltip>
  );

  const brandProductBulkAddTemplate = (
    <Button
      type={"default"}
      disabled={loading}
      shape={"round"}
      icon={<DownloadOutlined />}
      href={`${s3TemplateUrl}/${enableForB2bService ? "b2b_brand_add_product" : "brand_add_product"}.xlsx`}
      target="_blank"
    >
      상품 추가 양식
    </Button>
  );

  const brandProductBulkUpdateTemplate = (
    <Button
      type={"default"}
      disabled={loading}
      shape={"round"}
      icon={<DownloadOutlined />}
      href={`${s3TemplateUrl}/${enableForB2bService ? "b2b_brand_update_product" : "brand_update_product"}.xlsx`}
      target="_blank"
    >
      상품 수정 양식
    </Button>
  );

  const appHeader = brand ? `${brand.name} (브랜드코드: ${brand.code})` : "";

  return (
    <>
      <AppHeader onBack={onBack}>{appHeader}</AppHeader>
      <Space direction="vertical" size={24}>
        <Row justify="space-between" gutter={[12, 12]}>
          <Col span={24}>{sectionBtn}</Col>
          <Col>
            <Typography.Title level={4}>{sectionName}</Typography.Title>
          </Col>
          <Col>
            <Space direction="horizontal">
              {brandProductVariantBulkUpdateButton}
              {brandProductVariantBulkCreateButton}
              {brandProductBulkAddTemplate}
              {brandProductBulkUpdateTemplate}
            </Space>
          </Col>
        </Row>
        {brand && (
          <>
            <Row justify="space-between" gutter={[12, 12]}>
              {<Col span={7}>{makeExclusiveBpvGradeInfoUis(brand)}</Col>}
              {<Col span={17}>{makeExclusiveBpvInfoUis(brand)}</Col>}
            </Row>
            <Row justify="space-between" gutter={[12, 12]}>
              {<Col span={24}>{makeDepositUis(brand)}</Col>}
            </Row>
          </>
        )}
        <Card>
          {productType === "package" ? (
            <BrandPackageListTable
              {...listAndFilterProps}
              brand={brand}
              packages={brandPackages}
              loading={loading}
              navigate={navigate}
              onProductPackageCreate={onProductPackageCreate}
              onProductPackageUpdate={onProductPackageUpdate}
              onProductPackageDelete={onProductPackageDelete}
            />
          ) : productType === "bundle" ? (
            <BrandBundleListTable
              {...listAndFilterProps}
              brand={brand}
              bundles={brandBundles}
              loading={loading}
              navigate={navigate}
              onProductBundleCreate={onProductBundleCreate}
              onProductBundleUpdate={onProductBundleUpdate}
              onProductBundleDelete={onProductBundleDelete}
            />
          ) : (
            <BrandProductListTable
              {...listAndFilterProps}
              brand={brand}
              enableForB2bService={enableForB2bService}
              brandProducts={brandProducts}
              loading={loading}
              isFulfilledByVendor={isFulfilledByVendor}
              navigate={navigate}
              onProductAssign={onProductAssign}
              onProductReorder={onProductReorder}
              selectedRowId={selectedRowId}
              setSelectedRowId={setSelectedRowId}
            />
          )}
        </Card>
      </Space>
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandProductListPage/filters.ts">
import { commonMsg } from "@assets/messages/commonMsg";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts } from "@src/global/core/types/types";
import { createBooleanField, createTextField } from "@utils/filters/fields";

export enum BrandProductFilterKeys {
  includeStoppedBpv = "includeStoppedBpv",
  brandProductSearch = "brandProductSearch",
  productSearch = "productSearch",
}

export interface BrandProductListFilterOpts {
  includeStoppedBpv: FilterOpts<boolean>;
  brandProductSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: BrandProductListFilterOpts,
  isPackageType?: boolean
): IFilter<BrandProductFilterKeys> {
  let displayOrder = 0;

  // 패키지 타입이 아닌 경우에만 필터 추가
  const includeStoppedBpvFilter = {
    ...createBooleanField(
      displayOrder++,
      BrandProductFilterKeys.includeStoppedBpv,
      "중단 상품 조회 여부",
      opts.includeStoppedBpv.value,
      {
        negative: commonMsg.no,
        positive: commonMsg.yes,
      }
    ),
    isRequired: true,
    active: opts.includeStoppedBpv.active,
  };

  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      BrandProductFilterKeys.brandProductSearch,
      isPackageType ? "상품코드 / 패키지명" : filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };

  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      BrandProductFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };

  return [
    !isPackageType && includeStoppedBpvFilter,
    brandProductSearchFilter,
    !isPackageType && productSearchFilter,
  ].filter(Boolean);
}
</file>

<file path="src/app/views/brand/brands/components/BrandProductListPage/utils.ts">
import { CategoryTypeEnum } from "@src/api/types/globalTypes";
import {
  getCategoryTypeText,
  makeProductQtyPerBoxText,
  makeProductSpecTextFromAttr,
} from "@src/app/views/product/products/utils/data";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  findValueInEnum,
  getDisplayInnerProductName,
  transformDisplayStatusByBrandProductVariant,
  transformIsInner,
  transformSalesStatusByBrandProductVariant,
  transformTrackInventoryVariantType,
} from "@utils/misc";
import { utils } from "@utils/utils";

import { BpBundles_bpBundles_edges_node_bpBundleInfos } from "../../api/types/BpBundles";
import {
  BrandProductList_brandProducts_edges_node,
  BrandProductList_brandProducts_edges_node_brandProductVariants,
} from "../../api/types/BrandProductList";
import { BrandProductPackages_brandProductPackages_edges_node } from "../../api/types/BrandProductPackages";
import { BrandProductAndBrandProductPackageType } from "../../views/BrandProductListView/types";
import { BrandProductDataSourceType } from "../BrandProductListTable/BrandProductListTable";

export const mergeBrandProductAndPackageList = (
  brandProductList: BrandProductList_brandProducts_edges_node[],
  brandProductPackageList: BrandProductPackages_brandProductPackages_edges_node[]
): BrandProductAndBrandProductPackageType[] => {
  const transformedBrandProductList = brandProductList?.map((bp) => ({ ...bp, packageName: null })) || [];
  // 패키지 상품에 필요한 정보만 가져와서 추가
  const transformedBrandProductPackages =
    brandProductPackageList?.map((item) => ({
      id: item.id,
      packageName: item.name,
      name: item.name,
      visible: item.visible,
    })) || [];
  return [...transformedBrandProductList, ...transformedBrandProductPackages];
};

export const checkIsPackageProduct = (
  brandProduct: BrandProductDataSourceType | BrandProductAndBrandProductPackageType
) => utils.isEmpty(brandProduct.product) && brandProduct.packageName !== null;

export const makeBPProductName = (brandProduct: BrandProductDataSourceType) => {
  const isProductName = brandProduct.product !== null;
  const isInner = brandProduct.brandProductVariant?.productVariant.isInner;
  const bppName = brandProduct.product?.name;
  const displayBppName = getDisplayInnerProductName(bppName, isInner);
  const productName = isProductName ? displayBppName : "패키지 상품";
  return productName;
};

export const makeBPCategoryType = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return "-";
  }
  const categoryTypeText = getCategoryTypeText(findValueInEnum(brandProduct.product?.category?.type, CategoryTypeEnum));
  return categoryTypeText;
};

export const makeBPIsInner = (brandProduct: BrandProductDataSourceType) =>
  transformIsInner(brandProduct.brandProductVariant?.productVariant.isInner);

export const makeBPProductSpec = (brandProduct: BrandProductDataSourceType) => {
  const hasVariants = brandProduct.product?.productType?.hasVariants;
  const targetAttributes = hasVariants
    ? brandProduct.brandProductVariant?.productVariant?.attributes
    : brandProduct.product?.attributes;
  return makeProductSpecTextFromAttr(targetAttributes) || "-";
};

export const makeBPProductQtyPerBox = (brandProduct: BrandProductDataSourceType) =>
  makeProductQtyPerBoxText(brandProduct.brandProductVariant?.productVariant) || "-";

export const makeBPTrackInventoryVariantType = (brandProduct: BrandProductDataSourceType) =>
  transformTrackInventoryVariantType(brandProduct.brandProductVariant?.productVariant?.trackInventory);

export const makeBPSalesStatus = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    // NOTE: 브랜드 패키지 상품
    return brandProduct.visible ? "판매" : "중단";
  } else {
    // NOTE: 브랜드 상품
    return transformSalesStatusByBrandProductVariant(brandProduct.brandProductVariant?.salesStatus);
  }
};

export const makeBPDisplayStatus = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    // NOTE: 브랜드 패키지 상품
    return brandProduct.visible ? "진열" : "중단";
  } else {
    // NOTE: 브랜드 상품
    return transformDisplayStatusByBrandProductVariant(
      brandProduct.brandProductVariant?.salesStatus,
      brandProduct.brandProductVariant?.forceNoNormalDisplay
    );
  }
};

// 브랜드 상품 테이블에 보이는 공급 원가
export const makeVariantPriceExcludeVat = (brandProduct: BrandProductDataSourceType, isFulfilledByVendor: boolean) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return undefined;
  }
  const productVariant = brandProduct.brandProductVariant?.productVariant;
  if (!productVariant) {
    return undefined;
  }

  const { isInner, trackInventory } = productVariant;
  let costPriceExcludeVat: number;
  let deliveryFeeExcludeVat: number;

  if (isInner) {
    // 이너박스 상품의 경우, (재고 판매) 협력사 매입가 + 판매 소분 비용
    costPriceExcludeVat = productVariant?.costPriceExcludeVat;
    deliveryFeeExcludeVat = toPriceExcludeVat(productVariant?.innerIncidentalCostAmount);
  } else if (trackInventory) {
    // 재고 운영 상품의 경우, 재고 판매 협력사 매입가 + 재고 판매 택배비
    costPriceExcludeVat = productVariant?.costPriceExcludeVat;
    // 직거래 상품인경우 재고 배송비는 0으로 처리.
    deliveryFeeExcludeVat = isFulfilledByVendor ? 0 : toPriceExcludeVat(productVariant?.deliveryFeeAmount);
  } else {
    // 재고 미운영 상품의 경우, 위탁 판매 협력사 매입가 + 위탁 판매 택배비
    costPriceExcludeVat = productVariant?.consignmentCostPriceExcludeVat;
    deliveryFeeExcludeVat = toPriceExcludeVat(productVariant?.consignmentDeliveryFeeAmount);
  }

  if (utils.isEmpty(costPriceExcludeVat) || utils.isEmpty(deliveryFeeExcludeVat)) {
    return undefined;
  }
  return costPriceExcludeVat + deliveryFeeExcludeVat;
};

export const makeBpvCostPriceExcludeVat = (
  bpv: Pick<BrandProductList_brandProducts_edges_node_brandProductVariants, "costPriceExcludeVat">
) => {
  if (utils.isEmpty(bpv)) {
    return null;
  }
  const costPriceExcludeVat = bpv.costPriceExcludeVat;
  return costPriceExcludeVat;
};

export const makeBpvDeliveryFeeExcludeVat = (
  bpv: Pick<BrandProductList_brandProducts_edges_node_brandProductVariants, "deliveryFeeAmount">
) => {
  if (utils.isEmpty(bpv)) {
    return null;
  }
  const deliveryFee = bpv.deliveryFeeAmount;
  return toPriceExcludeVat(deliveryFee);
};

export const makeBpvPriceExcludeVat = (
  bpv: Pick<BrandProductList_brandProducts_edges_node_brandProductVariants, "costPriceExcludeVat" | "deliveryFeeAmount">
) => {
  if (utils.isEmpty(bpv)) {
    return null;
  }
  const costPriceExcludeVat = makeBpvCostPriceExcludeVat(bpv);
  const deliveryFeeExcludeVat = makeBpvDeliveryFeeExcludeVat(bpv);
  return costPriceExcludeVat + deliveryFeeExcludeVat;
};

export const makeBpvMallPriceExcludeVat = (
  bpv: Pick<BrandProductList_brandProducts_edges_node_brandProductVariants, "priceAmount" | "priceVat">
) => {
  if (utils.isEmpty(bpv)) {
    return null;
  }
  return bpv.priceAmount - bpv.priceVat;
};

export const makeBrandCostPriceExcludeVat = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return null;
  }

  return makeBpvCostPriceExcludeVat(brandProduct.brandProductVariant);
};

export const makeBrandDeliveryFeeExcludeVat = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return null;
  }

  return makeBpvDeliveryFeeExcludeVat(brandProduct.brandProductVariant);
};

export const makeBrandPriceExcludeVat = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return null;
  }

  return makeBpvPriceExcludeVat(brandProduct.brandProductVariant);
};

export const makeMallPriceExcludeVat = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return null;
  }

  return makeBpvMallPriceExcludeVat(brandProduct.brandProductVariant);
};

export const makeShowBeforePrice = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return false;
  }

  const showBeforePrice = brandProduct.brandProductVariant?.showBeforePrice;

  return showBeforePrice;
};

export const makeBeforePriceExcludeVat = (brandProduct: BrandProductDataSourceType) => {
  const isPackageProduct = checkIsPackageProduct(brandProduct);
  if (isPackageProduct) {
    return null;
  }

  const { isTaxFree } = brandProduct.product;
  const beforePrice = brandProduct.brandProductVariant?.beforePriceAmount;

  return toPriceExcludeVat(beforePrice, isTaxFree);
};

// 할인율(%)
export const makeBPDiscountRate = (brandProduct: BrandProductDataSourceType) => {
  const beforePrice = makeBeforePriceExcludeVat(brandProduct);
  const mallPrice = makeMallPriceExcludeVat(brandProduct);
  if (utils.isEmpty(beforePrice) || utils.isEmpty(mallPrice)) {
    return "-";
  }
  return utils.calcProfitRate(beforePrice, mallPrice);
};

// 당사 매익률(%)
export const makeBPProfitRate = (brandProduct: BrandProductDataSourceType, isFulfilledByVendor: boolean) => {
  const brandPrice = makeBrandPriceExcludeVat(brandProduct);
  if (utils.isEmpty(brandPrice)) {
    return "-";
  }
  const variantPrieceExcludeVat = makeVariantPriceExcludeVat(brandProduct, isFulfilledByVendor);
  if (utils.isEmpty(variantPrieceExcludeVat)) {
    return "-";
  }
  return utils.calcRiuProfitRate(brandPrice, variantPrieceExcludeVat);
};

// 가맹본부 매익률(%)
export const makeBPBrandProfitRate = (brandProduct: BrandProductDataSourceType) => {
  const mallPrice = makeMallPriceExcludeVat(brandProduct);
  if (utils.isEmpty(mallPrice)) {
    return "-";
  }
  const brandPrice = makeBrandPriceExcludeVat(brandProduct);
  if (utils.isEmpty(brandPrice)) {
    return "-";
  }
  return utils.calcBrandProfitRate(mallPrice, brandPrice);
};

// Bundle 당사 매익률(%)
export const makeBundleProfitRate = (bundle: {
  costPriceExcludeVat: number | null;
  bpBundleInfos: Array<BpBundles_bpBundles_edges_node_bpBundleInfos | null> | null;
}) => {
  const brandPrice = bundle.costPriceExcludeVat ?? 0;
  if (utils.isEmpty(brandPrice)) {
    return "-";
  }
  // variantSupplyTotal = 구성품의 공급원가 합계
  const variantSupplyTotal =
    bundle.bpBundleInfos?.reduce((sum: number, info: BpBundles_bpBundles_edges_node_bpBundleInfos | null) => {
      if (!info) {
        return sum;
      }
      const costPrice = info.pv.costPriceExcludeVat ?? 0;
      return sum + costPrice * info.quantity;
    }, 0) ?? 0;

  if (utils.isEmpty(variantSupplyTotal)) {
    return "-";
  }
  return utils.calcRiuProfitRate(brandPrice, variantSupplyTotal);
};

// Bundle 가맹본부 매익률(%)
export const makeBundleBrandProfitRate = (bundle: {
  priceAmount: number | null;
  priceVat: number | null;
  costPriceExcludeVat: number | null;
}) => {
  const mallPrice = (bundle.priceAmount ?? 0) - (bundle.priceVat ?? 0);
  if (utils.isEmpty(mallPrice)) {
    return "-";
  }
  const brandPrice = bundle.costPriceExcludeVat ?? 0;
  if (utils.isEmpty(brandPrice)) {
    return "-";
  }
  return utils.calcBrandProfitRate(mallPrice, brandPrice);
};

// Bundle 할인율(%)
export const makeBundleDiscountRate = (bundle: {
  showBeforePrice: boolean;
  beforePriceAmount: number | null;
  priceAmount: number | null;
}) => {
  if (!bundle.showBeforePrice || !bundle.beforePriceAmount || bundle.beforePriceAmount === 0) {
    return "-";
  }
  const beforePrice = bundle.beforePriceAmount;
  const mallPrice = bundle.priceAmount ?? 0;
  return utils.calcProfitRate(beforePrice, mallPrice);
};
</file>

