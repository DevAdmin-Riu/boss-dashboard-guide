import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import { FbvVendorForReqFragment } from "@src/api/fragments/types/FbvVendorForReqFragment";
import {
  RequestFbvProductCreateInput,
  RequestFbvProductStatus,
  RequestFbvProductStatusEnum,
} from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import CardSpacer from "@src/app/components/CardSpacer";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { findVendorManager, makeVendorManagerInfo, VendorManagerTypeEnum } from "@src/app/views/purchase/vendors/utils";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Form, FormInstance, PageHeader } from "antd";
import React, { useEffect, useState } from "react";

import { useRequestFbvProductChangeStatusMutation, useRequestFbvProductUpdateMutation } from "../api/mutations";
import { requestFbvProductDetailsQuery } from "../api/queries";
import { RequestFbvProductDetails_requestFbvProduct } from "../api/types/RequestFbvProductDetails";
import { RequestFbvProductUpdate } from "../api/types/RequestFbvProductUpdate";
import ReqFbvProductForm, { IVendorForReq } from "./ReqFbvProductForm/ReqFbvProductForm";
import ReqFbvProductStatusRejectModal from "./ReqFbvProductStatusRejectModal";

interface ReqFbvProductDetailsPageProps {
  onBack: () => void;
  header: string;
  requestFbvProductData: RequestFbvProductDetails_requestFbvProduct;
  isUpdate?: boolean;
}

interface CustomReqFbvProductCreateInput extends RequestFbvProductCreateInput {
  vendorList?: string;
  vendorName?: string;
  vendorBizRegNo?: string;
  vendorManagerName?: string;
  vendorManagerEmail?: string;
  vendorManagerPhone?: string;
}

export const vendorInfoSetFieldValue = (form: FormInstance, vendor: FbvVendorForReqFragment) => {
  const vendorManagers = makeVendorManagerInfo(vendor?.managers);
  const vendorMainOrderManager = findVendorManager(vendorManagers, VendorManagerTypeEnum.ORDER);
  form.setFieldsValue({
    vendor: vendor.id,
    vendorName: vendor.ceo,
    vendorBizRegNo: vendor.bizRegNo,
    vendorManagerName: vendorMainOrderManager ? vendorMainOrderManager.name : "-",
    vendorManagerEmail: vendorMainOrderManager ? vendorMainOrderManager.email : "-",
    vendorManagerPhone: vendorMainOrderManager ? vendorMainOrderManager.phone : "-",
  });
};

const ReqFbvProductDetailsPage: React.FC<ReqFbvProductDetailsPageProps> = (props) => {
  const { user } = useUser();
  const { onBack, header, requestFbvProductData, isUpdate = false } = props;
  const [modalOpen, setModalOpen] = useState<boolean>(false);
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [form] = Form.useForm<CustomReqFbvProductCreateInput>();

  const { isHqStaff, isStaff } = user;

  const vendorList: IVendorForReq[] = requestFbvProductData.brand.fbvVendors.map((vendor) => ({
    label: `${vendor.code}: ${vendor.name}`,
    value: `${vendor.code}: ${vendor.name}`,
    key: vendor.id,
    ...vendor,
  }));

  const [requestFbvProductUpdate, requestFbvProductUpdateOpts] = useRequestFbvProductUpdateMutation({
    onCompleted: (data: RequestFbvProductUpdate) => {
      const errors = data.requestFbvProductUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("상품 등록 요청 정보가 수정되었습니다.");
      } else {
        showNotificationError("상품 등록 요청 정보 수정에 실패하였습니다.");
      }
    },
    // TODO: 위 뮤테이션의 response로 캐시가 갱신되는지 체크 후, 갱신이 되면 아래 코드 제거
    refetchQueries: [requestFbvProductDetailsQuery],
  });

  const [requestFbvProductStatusUpdate, requestFbvProductStatusUpdateOpts] = useRequestFbvProductChangeStatusMutation({
    onCompleted: (data) => {
      const errors = data.requestFbvProductChangeStatus.errors;
      if (errors.length === 0) {
        showNotificationSuccess("상품 요청에 따른 상태변경이 완료되었습니다.");
      } else {
        showNotificationError("상품 요청에 따른 상태변경 중 오류가 발생하였습니다.");
      }
    },
    // TODO: 위 뮤테이션의 response로 캐시가 갱신되는지 체크 후, 갱신이 되면 아래 코드 제거
    refetchQueries: [requestFbvProductDetailsQuery],
  });

  const onFinish = (values: RequestFbvProductCreateInput): void => {
    if (utils.isEmpty(values.productName)) {
      showNotificationWarn("이용하시던 상품명을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.category)) {
      showNotificationWarn("상품의 카테고리를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.spec)) {
      showNotificationWarn("규격을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.qtyPerBox)) {
      showNotificationWarn("입수량을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.costPriceExcludeVat)) {
      showNotificationWarn("협력사 매입가를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.priceExcludeVat)) {
      showNotificationWarn("매장 매입가를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.vendor)) {
      showNotificationWarn("협력사를 선택해주세요.");
      return;
    }
    if (utils.isEmpty(values.thumbnailImage) && isUpdate === false) {
      showNotificationWarn("상품 이미지를 업로드해주세요.");
      return;
    }

    requestFbvProductUpdate({
      variables: {
        id: requestFbvProductData.id,
        input: {
          vendor: values.vendor,
          productName: values.productName,
          category: values.category,
          spec: values.spec,
          material: values.material,
          color: values.color,
          qtyPerBox: values.qtyPerBox,
          costPriceExcludeVat: values.costPriceExcludeVat,
          priceExcludeVat: values.priceExcludeVat,
          thumbnailImage: values.thumbnailImage && values.thumbnailImage[0].originFileObj,
        },
      },
    });
  };

  useEffect(() => {
    if (isUpdate) {
      const getVendor = vendorList?.filter((vendor) => vendor.id === requestFbvProductData.vendor.id);
      if (!getVendor) {
        return;
      }
      vendorInfoSetFieldValue(form, getVendor[0]);
      form.setFieldsValue({
        vendorList: getVendor[0]?.name,
        productName: requestFbvProductData.productName,
        category: requestFbvProductData.category,
        spec: requestFbvProductData.spec,
        material: requestFbvProductData.material,
        color: requestFbvProductData.color,
        qtyPerBox: requestFbvProductData.qtyPerBox,
        costPriceExcludeVat: requestFbvProductData.costPriceExcludeVat,
        priceExcludeVat: requestFbvProductData.priceExcludeVat,
      });
    }
  }, [requestFbvProductData, vendorList]);

  return (
    <>
      <Form form={form} layout="vertical" onValuesChange={() => setFormChanged(true)} onFinish={onFinish}>
        <AppHeader onBack={onBack}>{isStaff ? sectionNames.reqFbvProduct : sectionNames.hqReqFbvProduct}</AppHeader>
        <PageHeader title={header} />

        <ReqFbvProductForm
          form={form}
          vendorList={vendorList}
          isUpdate={isUpdate}
          isReject={requestFbvProductData.status === RequestFbvProductStatus.REJECTED}
          vendorInfoSetFieldValue={vendorInfoSetFieldValue}
          requestFbvProductData={requestFbvProductData}
        />
      </Form>
      <CardSpacer />
      {isHqStaff && (
        <AntdSaveButtonBar
          onCancel={onBack}
          disabled={
            !formChanged ||
            requestFbvProductUpdateOpts.loading ||
            requestFbvProductData.status !== RequestFbvProductStatus.REJECTED
          }
          state={requestFbvProductUpdateOpts.status}
          onSave={form.submit}
        />
      )}
      {requestFbvProductData.status === RequestFbvProductStatus.REQUESTED && isStaff && (
        <AntdSaveButtonBar
          onCancel={onBack}
          disabled={requestFbvProductStatusUpdateOpts.loading}
          state={requestFbvProductStatusUpdateOpts.status}
          labels={{ save: "등록완료", delete: "반려" }}
          onDelete={() => {
            setModalOpen(true);
          }}
          onSave={(_event) =>
            requestFbvProductStatusUpdate({
              variables: {
                id: requestFbvProductData.id,
                input: { afterStatus: RequestFbvProductStatusEnum.COMPLETED, reason: "승인" },
              },
            })
          }
        />
      )}
      <ReqFbvProductStatusRejectModal
        open={modalOpen}
        onClose={() => setModalOpen(false)}
        onOk={(reason) => {
          requestFbvProductStatusUpdate({
            variables: {
              id: requestFbvProductData.id,
              input: { afterStatus: RequestFbvProductStatusEnum.REJECTED, reason },
            },
          });
        }}
      />
    </>
  );
};

export default ReqFbvProductDetailsPage;
</file>

