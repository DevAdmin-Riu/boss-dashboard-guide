import { SearchBrandStores_search_edges_node } from "@src/api/searches/types/SearchBrandStores";
import useBrandStoreSearch from "@src/api/searches/useBrandStoreSearch";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Input, Modal, Space } from "antd";
import { ColumnsType } from "antd/es/table";
import React, { useEffect, useState } from "react";

interface BrandStoreAddModalProps {
  open: boolean;
  loading: boolean;
  brandId: string;
  excludeStoreIds?: string[];
  onAdd: (storeIds: string[]) => void;
  onBack: () => void;
}

export const BrandStoreAddModal: React.FC<BrandStoreAddModalProps> = (props) => {
  const { open, loading, brandId, excludeStoreIds = [], onAdd, onBack } = props;
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([]);
  const [searchText, setSearchText] = useState<string>("");

  const { result, search } = useBrandStoreSearch({
    skip: !open || !brandId,
    variables: {
      first: 20,
      brandId,
      query: searchText,
    },
  });

  useEffect(() => {
    if (open) {
      setSelectedRowKeys([]);
      setSearchText("");
    }
  }, [open]);

  const brandStores = maybe(() => result.data.search.edges.map((edge) => edge.node)) || [];
  const filteredStores = brandStores.filter((store) => !excludeStoreIds.includes(store.id));

  const columns: ColumnsType<SearchBrandStores_search_edges_node> = [
    {
      title: "매장코드",
      key: "code",
      align: "center",
      width: 120,
      render: (_, record) => record.code || "-",
    },
    {
      title: "매장명",
      key: "name",
      align: "left",
      width: 200,
      render: (_, record) => record.name || "-",
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection = {
    selectedRowKeys,
    onChange: (newSelectedRowKeys: React.Key[]) => {
      setSelectedRowKeys(newSelectedRowKeys);
    },
  };

  const handleAdd = () => {
    onAdd(selectedRowKeys as string[]);
    setSelectedRowKeys([]);
  };

  return (
    <Modal
      title="매장 추가"
      open={open}
      width={800}
      closable={false}
      footer={
        <Space>
          <Button onClick={onBack} disabled={loading}>
            뒤로
          </Button>
          <Button type="primary" onClick={handleAdd} loading={loading} disabled={selectedRowKeys.length === 0}>
            추가
          </Button>
        </Space>
      }
      maskClosable={false}
    >
