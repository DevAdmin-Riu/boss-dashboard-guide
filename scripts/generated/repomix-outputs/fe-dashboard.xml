<file path="src/app/views/notice/banners/api/mutations.ts">
import makeMutation from "@hooks/makeMutation";
import { bannerErrorFragment, bannerFragment } from "@src/api/fragments/banner";
import gql from "graphql-tag";

import { AssignBrandsToBanner, AssignBrandsToBannerVariables } from "./types/AssignBrandsToBanner";
import { CreateBanner, CreateBannerVariables } from "./types/CreateBanner";
import { UnassignBrandsFromBanner, UnassignBrandsFromBannerVariables } from "./types/UnassignBrandsFromBanner";
import { UpdateBanner, UpdateBannerVariables } from "./types/UpdateBanner";

const createBanner = gql`
  ${bannerErrorFragment}
  mutation CreateBanner($input: BannerInput!) {
    createBanner(input: $input) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      banner {
        id
      }
    }
  }
`;
export const useCreateBannerMutation = makeMutation<CreateBanner, CreateBannerVariables>(createBanner);

const updateBanner = gql`
  ${bannerFragment}
  ${bannerErrorFragment}
  mutation UpdateBanner($id: ID!, $input: BannerInput!) {
    updateBanner(id: $id, input: $input) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      banner {
        ...BannerFragment
      }
    }
  }
`;
export const useUpdateBannerMutation = makeMutation<UpdateBanner, UpdateBannerVariables>(updateBanner);

const assignBrandsToBanner = gql`
  ${bannerErrorFragment}
  mutation AssignBrandsToBanner($bannerId: ID!, $brands: [ID]!) {
    assignBrandsToBanner(bannerId: $bannerId, brands: $brands) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      banner {
        id
        availableBrands {
          id
        }
      }
    }
  }
`;
export const useAssignBrandsToBannerMutation = makeMutation<AssignBrandsToBanner, AssignBrandsToBannerVariables>(
  assignBrandsToBanner
);

const unassignBrandsFromBanner = gql`
  ${bannerErrorFragment}
  mutation UnassignBrandsFromBanner($bannerId: ID!, $brands: [ID]!) {
    unassignBrandsFromBanner(bannerId: $bannerId, brands: $brands) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      banner {
        id
        availableBrands {
          id
        }
      }
    }
  }
`;
export const useUnassignBrandsFromBannerMutation = makeMutation<
  UnassignBrandsFromBanner,
  UnassignBrandsFromBannerVariables
>(unassignBrandsFromBanner);
</file>

