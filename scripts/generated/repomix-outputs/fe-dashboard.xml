import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { utils } from "@utils/utils";
import { Button, Card, Empty, Table, Typography } from "antd";
import React from "react";

import {
  ProductDetails_product_outerVariants_devPvOf,
  ProductDetails_product_outerVariants_devPvs,
} from "../../api/types/ProductDetails";
import { getDevPvTableSettings } from "./DevPvTableSettings";

interface CommonProps {
  disabled: boolean;
  onProductClick: (productId: string) => void;
  onAssign: () => void;
  onUnassign: (variantId: string) => void;
}
interface IsDevPvProps extends CommonProps {
  isDevPv: true;
  devPvOf: ProductDetails_product_outerVariants_devPvOf;
}
interface IsStandardPvProps extends CommonProps {
  isDevPv: false;
  devPvs: ProductDetails_product_outerVariants_devPvs[];
}
type DevPvCardProps = IsDevPvProps | IsStandardPvProps;

export const DevPvCard: React.FC<DevPvCardProps> = (props) => {
  const { isDevPv, disabled, onProductClick, onAssign, onUnassign } = props;
  const columns = getDevPvTableSettings({ onProductClick, onUnassign });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const titleText = isDevPv ? "연동 제품" : "연동 개발비";
  const emptyText = isDevPv ? "개발비로써 연동된 제품이 없습니다." : "연동된 개발비 제품이 없습니다.";
  const dataSource = isDevPv
    ? utils.isEmpty(props.devPvOf)
      ? []
      : [props.devPvOf]
    : isDevPv === false
    ? props.devPvs
    : [];

  return (
    <Card
      bodyStyle={{ padding: 0 }}
      title={<Typography.Title level={4}>{titleText}</Typography.Title>}
      extra={
        <Button type="primary" disabled={disabled} onClick={onAssign}>
          연동
        </Button>
      }
    >
      <Table<ProductDetails_product_outerVariants_devPvs | ProductDetails_product_outerVariants_devPvOf>
        {...commonTableProps}
        columns={columns}
        dataSource={dataSource}
        scroll={{ x: tableWidthSum, y: 500 }}
        locale={{
          emptyText: <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={emptyText} />,
        }}
      />
    </Card>
  );
};
</file>

