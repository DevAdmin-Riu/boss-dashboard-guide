  FulfilledByVendorPurchaseCostEventListViewUrlQueryParams,
  FulfilledByVendorPurchaseCostStatListViewUrlQueryParams,
  HqFulfilledByVendorSettlementListViewUrlQueryParams,
} from "./urls";

export type Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq = BrandsOrderStatsForFbv_brandsOrderStats &
  Pick<BrandFbvSettlements_brandFbvSettlements_edges_node, "settlementStatus" | "rejectReason"> & {
    settlementId: string;
  };

export const getFbvPurchaseCostEventTypeEnumChoices = (
  isEventCreate: boolean,
  isHqStaff: boolean
): Array<{
  label: string;
  value: FbvPurchaseCostEventTypeEnum;
}> => {
  const choices = [];
  // 내역 생성 모드인 경우엔 선택 옵션 중에서 보스 외(직거래) 상품 매입 내역은 실제 매입 액션 시에만 생성)
  if (isEventCreate === false) {
    choices.push({
      label: isHqStaff ? `${transformIsFBVForHq(true)} 상품 매입` : "상품 판매 금액",
      value: FbvPurchaseCostEventTypeEnum.PURCHASE,
    });
  }
  choices.push(
    {
      label: isHqStaff ? `${transformIsFBVForHq(true)} 상품 지급` : "수령 금액",
      value: FbvPurchaseCostEventTypeEnum.SETTLEMENT,
    },
    {
      label: "기타 잔액 추가",
      value: FbvPurchaseCostEventTypeEnum.INCREASE,
    },
    {
      label: "기타 잔액 차감",
      value: FbvPurchaseCostEventTypeEnum.DECREASE,
    }
  );
  return choices;
};

export const getFulfilledByVendorPurchaseCostEventTypeName = (type: FbvPurchaseCostEventType, isHqStaff: boolean) => {
  const choiceByType = getFbvPurchaseCostEventTypeEnumChoices(false, isHqStaff).find(
    (choice) => choice.value === (type as unknown as FbvPurchaseCostEventTypeEnum)
  );
  return choiceByType?.label || "-";
};

export const getFbvPurchaseCostOperator = (eventType: FbvPurchaseCostEventType) => {
  if ([FbvPurchaseCostEventType.SETTLEMENT, FbvPurchaseCostEventType.DECREASE].includes(eventType)) {
    return -1;
  }
  return 1;
};

// 보스 외(직거래) 상품 지급, 기타 잔액 차감인 경우 음수로 표시
export const getFbvPurchaseCostAmountExcludeVatWithOperator = (
  record: Pick<FbvPurchaseCostEventList_fbvPurchaseCostEvents_edges_node, "type" | "amount">
) => getFbvPurchaseCostOperator(record.type) * record.amount;

export const getFbvPurchaseCostAmountExcludeVatWithOperatorHtml = (
  record: FbvPurchaseCostEventList_fbvPurchaseCostEvents_edges_node
) => {
  const value = getFbvPurchaseCostAmountExcludeVatWithOperator(record);
  if (value > 0) {
    return (
      <Statistic
        className={getStatisticClassName(["ant-statistic-small", "ant-statistic-green"])}
        prefix={"+"}
        value={value}
      />
    );
  } else if (value < 0) {
    return (
      <Statistic
        className={getStatisticClassName(["ant-statistic-small", "ant-statistic-red"])}
        prefix={"-"}
        value={Math.abs(value)}
      />
    );
  } else {
    return value;
  }
};

export const getFulfilledByVendorPurchaseCostStatListDefaultParams =
  (): FulfilledByVendorPurchaseCostStatListViewUrlQueryParams => {
    const { gte, lte } = getDefaultGteLteVariablesForMonth();
    return { statDateFrom: gte, statDateTo: lte };
  };

export const getFulfilledByVendorPurchaseCostEventListDefaultParams =
  (): FulfilledByVendorPurchaseCostEventListViewUrlQueryParams => {
    const { gte, lte } = getDefaultGteLteVariablesForMonth();
    return { createdFrom: gte, createdTo: lte };
