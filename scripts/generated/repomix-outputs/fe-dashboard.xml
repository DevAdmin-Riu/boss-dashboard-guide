import { ApolloQueryResult } from "@apollo/client";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { applyNumberCellFormat, defaultExcelCellStyle, excelDownloadByWorkBook } from "@utils/excel/excelDownload";
import moment from "moment";
import * as xlsx from "xlsx-js-style";

import { FulfillmentList, FulfillmentList_fulfillments_edges_node } from "../../api/types/FulfillmentList";
import {
  courierNameFieldName,
  etcDeliveryManContactFieldName,
  etcDeliveryVehicleFieldName,
  fulfillmentIdFieldName,
  trackingNumberFieldName,
} from "../../components/OrderDeliveryListPage/utils";

export const parseAllFulfillments = (resFulfillment: ApolloQueryResult<FulfillmentList>) => {
  const fulfillmentData = resFulfillment.data?.fulfillments?.edges?.map((edge) => edge.node);

  const columns = [];
  fulfillmentData.forEach((data, index) => {
    const row = makeOneRow(data, index);
    columns.push(row);
  });
  if (!columns || columns.length === 0) {
    return { columns: [], header: [], merges: [] };
  }
  return { columns };
};

const makeOneRow = (data: FulfillmentList_fulfillments_edges_node, index: number) => {
  const makeDateText = (date: string) => (date ? moment(date).format(onlyDateFormat) : "-");

  const fulfillmentId = data.id;
  const fulfillmentComposedId = data.composedIdWithPrefix;
  const orderComposedId = data.order.composedIdWithPrefix;
  const orderCreated = makeDateText(data.order.created);

  const productSku = data.lines[0]?.orderLine.productSku;
  const productName = data.lines[0]?.orderLine.productName;
  const quantity = data.lines[0]?.quantity;

  const contact = data.order.shippingAddress.phone;
  const addressName = data.order.shippingAddress.firstName;

  const deliveryMethod = index === 0 ? "택배" : index === 1 ? "화물차" : "";
  const courierCompany = index === 0 ? "(입력)" : "";
  const trackingNumber = index === 0 ? "(입력)" : "";
  const etcDeliveryVehicle = index === 1 ? "(입력)" : "";
  const etcDeliveryManContact = index === 1 ? "(입력)" : "";

  return {
    [fulfillmentIdFieldName]: fulfillmentId,
    [columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID]: fulfillmentComposedId,
    [columnNameConstant.order.ORDER_LINE_COMPOSED_ID]: orderComposedId,
    [columnNameConstant.order.ORDER_DATE]: orderCreated,
    [columnNameConstant.brandProduct.BP_SKU]: productSku,
    [columnNameConstant.brandProduct.BRAND_PRODUCT_NAME]: productName,
    [columnNameConstant.delivery.DELIVERY_AMOUNT]: quantity,
    [columnNameConstant.delivery.DELIVERY_NAME]: addressName,
    [columnNameConstant.delivery.PHONE]: contact,
    [columnNameConstant.delivery.DELIVERY_METHOD]: deliveryMethod,
    [courierNameFieldName]: courierCompany,
    [trackingNumberFieldName]: trackingNumber,
    [etcDeliveryVehicleFieldName]: etcDeliveryVehicle,
    [etcDeliveryManContactFieldName]: etcDeliveryManContact,
  };
};

interface FulfillmentsXlsxDownloadProps {
  resFulfillments: ApolloQueryResult<FulfillmentList>;
  title: string;
  couriers: CourierList_couriers_edges_node[];
}

export const fulfillmentsXlsxDownload = ({ resFulfillments, title, couriers }: FulfillmentsXlsxDownloadProps) => {
  const workbook = xlsx.utils.book_new();
  const fulfillmentColumns = parseAllFulfillments(resFulfillments);

  // bold 셀 스타일
  const boldExcelCellStyle = {
    ...defaultExcelCellStyle,
    font: { name: "맑은 고딕", sz: 9, bold: true },
  };
  // left 정렬 셀 스타일
  const leftAlignExcelCellStyle = {
    ...defaultExcelCellStyle,
    alignment: { ...defaultExcelCellStyle.alignment, horizontal: "left" },
  };
  // 타이틀 셀 스타일
  const titleExcelCellStyle = {
    ...boldExcelCellStyle,
    fill: { fgColor: { rgb: "F2F2F2" } },
  };

  // 배송정보 시트 생성 및 스타일 적용
  const sheet1 = xlsx.utils.json_to_sheet(fulfillmentColumns.columns);
  Object.keys(sheet1).forEach((cell) => {
    if (cell[0] !== "!") {
      sheet1[cell].s = defaultExcelCellStyle;
    }
  });

  // 타이틀 행 스타일 적용
  for (let i = 0; i < 11; i++) {
    const col = String.fromCharCode(65 + i);
    sheet1[`${col}1`].s = titleExcelCellStyle;
  }

  // 입력 가이드 시트 데이터 준비
  const guideData = [
    {
      항목: columnNameConstant.delivery.DELIVERY_METHOD,
      설명: `\n해당 제품이 택배사를 통해 배송할 경우 "택배"\n화물기사를 통해 배송할 경우 "화물차"\n- 자차로 배송할 경우에는 '화물차' 를 입력해주세요.\n`,
    },
    {
      항목: courierNameFieldName,
      설명: `\n배송 방식이 "택배" 일 경우, 해당 제품을 배송하는 택배사를 입력.\n띄어쓰기 없이 입력해 주세요.\n`,
    },
    {
      항목: trackingNumberFieldName,
      설명: `\n배송 방식이 "택배" 일 경우, 해당 제품의 운송장번호를 입력.\n기호 ( - ) 없이 숫자만 입력합니다.\n`,
    },
    {
      항목: etcDeliveryVehicleFieldName,
      설명: `\n배송 방식이 "화물차"인 경우, 해당 화물차의 차량정보를 입력\n- 자차로 배송할 경우에는 자차의 차량정보를 입력해 주세요.\n`,
    },
    {
      항목: etcDeliveryManContactFieldName,
      설명: `\n배송 방식이 "화물차"인 경우, 해당 화물차의 배송기사의 연락처를 입력\n- 자차로 배송할 경우에는 회사의 연락처를 입력해 주세요.\n`,
    },
  ];

  const sheet2 = xlsx.utils.json_to_sheet(guideData);

  // 입력 가이드 시트 스타일 적용 및 타이틀 스타일 설정
  Object.keys(sheet2).forEach((cell) => {
    if (cell[0] !== "!") {
      applyNumberCellFormat(sheet2[cell]);

      if (cell.startsWith("A")) {
        sheet2[cell].s = boldExcelCellStyle;
      } else if (cell.startsWith("B")) {
        sheet2[cell].s = leftAlignExcelCellStyle;
      } else {
        sheet2[cell].s = defaultExcelCellStyle;
      }
    }
  });
  sheet2.A1.s = titleExcelCellStyle;
  sheet2.B1.s = titleExcelCellStyle;

  // 택배사 목록 시트 데이터 준비
  const courierData = couriers.map((courier) => ({ "택배사 명칭": courier.name }));

  const sheet3 = xlsx.utils.json_to_sheet(courierData);

  // 택배사 목록 시트 스타일 적용 및 타이틀 스타일 설정
  Object.keys(sheet3).forEach((cell) => {
    if (cell[0] !== "!") {
      sheet3[cell].s = defaultExcelCellStyle;
    }
  });
  sheet3.A1.s = titleExcelCellStyle;

  // 각 시트의 열 너비 조정
  sheet1["!cols"] = [
    { wpx: 150 },
    { wpx: 90 },
    { wpx: 90 },
    { wpx: 90 },
    { wpx: 70 },
    { wpx: 100 },
    { wpx: 60 },
    { wpx: 60 },
    { wpx: 70 },
    { wpx: 100 },
    { wpx: 100 },
  ];
  sheet2["!cols"] = [{ wpx: 150 }, { wpx: 300 }];
  sheet3["!cols"] = [{ wpx: 100 }];

  // 워크북에 시트 추가
  xlsx.utils.book_append_sheet(workbook, sheet1, "배송정보");
  xlsx.utils.book_append_sheet(workbook, sheet2, "입력 가이드");
  xlsx.utils.book_append_sheet(workbook, sheet3, "택배사 목록");

  // 파일 다운로드
  excelDownloadByWorkBook({ workBook: workbook, title: `${title}-${moment().format("YYYYMMDD-HHmmss")}.xlsx` });
};
</file>

