import { FulfillTypeEnum, OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import VatLegend from "@src/app/components/TableVat/VatLegend";
import { Card, Checkbox, DatePicker, Descriptions, Form, Input, InputNumber, Radio, Select } from "antd";
import { RangePickerProps } from "antd/lib/date-picker";
import moment from "moment";
import React from "react";

interface CreateAdminOrderInfoCardProps {
  isByStaffForBrand: boolean;
  isByStaffForBadStock: boolean;
  isByStaffForB2b: boolean;
  chargeDeliveryAdditionalFee: boolean;
  deliveryMethodWatched: OrderDeliveryMethodsEnum;
  estimatedArrivalDateDoesntMatterWatched: boolean;
}

const CreateAdminOrderInfoCard: React.FC<CreateAdminOrderInfoCardProps> = (props) => {
  const {
    isByStaffForBrand,
    isByStaffForBadStock,
    isByStaffForB2b,
    chargeDeliveryAdditionalFee,
    deliveryMethodWatched,
    estimatedArrivalDateDoesntMatterWatched,
  } = props;

  const disabledDate: RangePickerProps["disabledDate"] = isByStaffForB2b
    ? undefined
    : (current) => current && current < moment().endOf("day");

  const deliveryMethodOptions = [
    { label: "택배", value: OrderDeliveryMethodsEnum.BY_COURIER },
    { label: "화물차", value: OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE },
    { label: "퀵 서비스", value: OrderDeliveryMethodsEnum.BY_QUICK_SERVICE },
    { label: "직접배송", value: OrderDeliveryMethodsEnum.BY_RIU_DIRECT },
    { label: "고객수령", value: OrderDeliveryMethodsEnum.BY_CUSTOMER_DIRECT },
  ].filter((option) => {
    if (isByStaffForB2b === true) {
      return option.value === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE;
    } else if (isByStaffForBrand === false) {
      return option.value === OrderDeliveryMethodsEnum.BY_COURIER;
    }
    return true;
  });

  return (
    <Card title={<CardTitleAntd title="배송 정보" />} style={{ marginBottom: 16 }}>
      <Descriptions bordered size="middle">
        {isByStaffForB2b === false && (
          <Descriptions.Item label="배송 방식" span={3} labelStyle={{ width: 200 }}>
            <Form.Item name="deliveryMethod" style={{ marginBottom: 0 }}>
              <Select options={deliveryMethodOptions} />
            </Form.Item>
          </Descriptions.Item>
        )}
        {deliveryMethodWatched !== OrderDeliveryMethodsEnum.BY_COURIER && (
          <>
            {isByStaffForBrand && (
              <Descriptions.Item label="출고 유형" span={3} labelStyle={{ width: 200 }}>
                <Form.Item name="fulfillType" style={{ marginBottom: 0 }}>
                  <Radio.Group disabled={isByStaffForB2b}>
                    <Radio value={FulfillTypeEnum.ALL_TRACK_INVENTORY}>모두 재고</Radio>
                    <Radio value={FulfillTypeEnum.ALL_CONSIGNMENT}>모두 위탁</Radio>
                  </Radio.Group>
                </Form.Item>
              </Descriptions.Item>
            )}
            {isByStaffForB2b === false && (
              <Descriptions.Item
                label={<MultiLineTypography lines={["기타 배송비", <VatLegend isIncludeVat />]} />}
                span={3}
                labelStyle={{ width: 200 }}
              >
                <Form.Item name="etcDeliveryFee" style={{ marginBottom: 0 }}>
                  <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
                </Form.Item>
              </Descriptions.Item>
            )}
            {isByStaffForB2b === false && chargeDeliveryAdditionalFee && (
              <Descriptions.Item
                label={
                  <MultiLineTypography
                    lines={[columnNameConstant.order.DELIVERY_ADDITIONAL_FEE.join(" "), <VatLegend isIncludeVat />]}
                  />
                }
                span={3}
                labelStyle={{ width: 200 }}
              >
                <Form.Item name="additionalFeeForEtcDelivery" style={{ marginBottom: 0 }}>
                  <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
                </Form.Item>
              </Descriptions.Item>
            )}
            {(isByStaffForB2b || deliveryMethodWatched === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE) && (
              <Descriptions.Item label="납품요청일" span={3} labelStyle={{ width: 200 }}>
                <>
                  <Form.Item noStyle name={"estimatedArrivalDateDoesntMatter"} valuePropName="checked">
                    <Checkbox style={{ marginBottom: ".75rem" }}>상관없음</Checkbox>
                  </Form.Item>
                  {estimatedArrivalDateDoesntMatterWatched || (
                    <Form.Item name="estimatedArrivalDate" style={{ marginBottom: 0 }}>
                      <DatePicker disabledDate={disabledDate} />
                    </Form.Item>
                  )}
                </>
              </Descriptions.Item>
            )}
          </>
        )}
        {isByStaffForBrand && (
          <Descriptions.Item label="본부수익금 적용" span={3} labelStyle={{ width: 200 }}>
            <Form.Item name="calcMileage" style={{ marginBottom: 0 }}>
              <Radio.Group>
                <Radio value={true}>적용</Radio>
                <Radio value={false}>미적용</Radio>
              </Radio.Group>
            </Form.Item>
          </Descriptions.Item>
        )}
        {isByStaffForBadStock && (
          <>
            <Descriptions.Item label="오픈몰명" span={3} labelStyle={{ width: 200 }}>
              <Form.Item name="openMallName" style={{ marginBottom: 0 }}>
                <Input />
              </Form.Item>
            </Descriptions.Item>
            <Descriptions.Item label="오픈몰 주문번호" span={3} labelStyle={{ width: 200 }}>
              <Form.Item name="openMallOrderNumber" style={{ marginBottom: 0 }}>
                <Input />
              </Form.Item>
            </Descriptions.Item>
          </>
        )}
      </Descriptions>
    </Card>
  );
};

export default CreateAdminOrderInfoCard;
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderPage/CreateAdminOrderPage.tsx">
import useUser from "@hooks/useUser";
import { OrderDeliveryMethodsEnum, OrderType } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  calcTotalExcludeVatByUnitExcludeVatAndQty,
  calcVatByPriceExcludeVat,
  calcVatByPriceIncludeVat,
  toPriceExcludeVat,
} from "@utils/excel/excelDownload";
import {
  getDeliveryBoxCountConsiderAdjustPricePv,
  getUnitDeliveryAdditionalFeeExcludeVatByPostalCode,
} from "@utils/misc";
import { Button, Card, Col, Form, FormInstance, Input, PageHeader, Row, Space, Typography } from "antd";
import React, { useEffect } from "react";

import { checkOrderedByHqStaffForBrand, checkShowStaffNoteMode } from "../../utils";
import {
  CreateAdminOrderAddressForm,
  CreateAdminOrderForm,
  CreateAdminOrderViewModalType,
  ICreateAdminOrderFormLine,
} from "../../views/CreateAdminOrderView/CreateAdminOrderView";
import CreateAdminOrderAddressInfoCard from "./CreateAdminOrderAddressInfoCard";
import CreateAdminOrderInfoCard from "./CreateAdminOrderInfoCard";
import CreateAdminOrderProductCard from "./CreateAdminOrderProductCard";
import CreateAdminOrderTaxInvoiceBizInfoCard from "./CreateAdminOrderTaxInvoiceBizInfoCard";
import CreateAdminOrderTotalPriceCard from "./CreateAdminOrderTotalPriceCard";
import CreateAdminOrderUserInfoCard from "./CreateAdminOrderUserInfoCard";

interface CreateAdminOrderPageProps {
  orderType: OrderType;
  onBack: () => void;
  showModal: (type: CreateAdminOrderViewModalType) => void;
  sectionName: string;
  form: FormInstance<CreateAdminOrderForm>;
  addressInfo: CreateAdminOrderAddressForm;
  isByStaffForBrand: boolean;
  isByStaffForBadStock: boolean;
  isByStaffForEtc: boolean;
  isByStaffForB2b: boolean;
  createFormLinesWatched: ICreateAdminOrderFormLine[];
  loading: boolean;
  onSubmit: () => Promise<void>;
  useBpSkuMode: boolean;
  isShowNoteForUnitPriceMode: boolean;
  onDeliverToMe?: () => void;
  isHqStaffB2bOrderMode: boolean;
}

const CreateAdminOrderPage: React.FC<CreateAdminOrderPageProps> = (props) => {
  const {
    orderType,
    onBack,
    sectionName,
    form,
    addressInfo,
    showModal,
    isByStaffForBrand,
    isByStaffForBadStock,
    isByStaffForEtc,
    isByStaffForB2b,
    createFormLinesWatched,
    loading,
    onSubmit,
    useBpSkuMode,
    isShowNoteForUnitPriceMode,
    onDeliverToMe,
    isHqStaffB2bOrderMode,
  } = props;
  const { courierDeliveryAdditionalFeeList } = useShop();
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const isByHqStaffForBrand = checkOrderedByHqStaffForBrand(orderType);

  const showStaffNoteMode = checkShowStaffNoteMode(orderType, isStaff);

  const taxInvoiceRequestFlagWatched: boolean = Form.useWatch("taxInvoiceRequestFlag", form);
  const deliveryMethodWatched: OrderDeliveryMethodsEnum = Form.useWatch("deliveryMethod", form);
  const estimatedArrivalDateDoesntMatterWatched = Form.useWatch("estimatedArrivalDateDoesntMatter", form);
  const etcDeliveryFeeWatched = Form.useWatch("etcDeliveryFee", form);
  const taxInvoiceBizRegNoWatched = Form.useWatch("taxInvoiceBizRegNo", form);
  const taxInvoiceBizCorpNameWatched = Form.useWatch("taxInvoiceBizCorpName", form);
  const taxInvoiceBizCeoNameWatched = Form.useWatch("taxInvoiceBizCeoName", form);
  const isB2bTakeBackWatched = Form.useWatch("isB2bTakeBack", form);
  const customerUserWatched = Form.useWatch("customerUser", form);
  const additionalFeeForEtcDeliveryWatched = Form.useWatch("additionalFeeForEtcDelivery", form);
  const unitAdditionalFeeExcludeVat = getUnitDeliveryAdditionalFeeExcludeVatByPostalCode(
    addressInfo?.postalCode,
    courierDeliveryAdditionalFeeList
  );
  const chargeDeliveryAdditionalFee = unitAdditionalFeeExcludeVat > 0;

  // 상품 총액 (부가세 포함 / 부가세 별도 / 부가세)
  const totalProductAmount = createFormLinesWatched
    ? createFormLinesWatched.reduce(
        (acc, product) => acc + (product.priceExcludeVat + product.priceVat) * product.qty,
        0
      )
    : 0;
  const totalProductAmountExcludeVat = createFormLinesWatched
    ? createFormLinesWatched.reduce(
        (acc, product) =>
          acc +
          calcTotalExcludeVatByUnitExcludeVatAndQty(
            product.priceExcludeVat,
            product.qty,
            product.isTaxFree,
            product.pricePrecision
          ),
        0
      )
    : 0;
  const totalProductVat = createFormLinesWatched.reduce((acc, product) => acc + product.priceVat * product.qty, 0);

  const totalDeliveryAdditionalFeeExcludeVat =
    (chargeDeliveryAdditionalFee &&
      ((isByStaffForBrand && deliveryMethodWatched === OrderDeliveryMethodsEnum.BY_COURIER) || isByHqStaffForBrand
        ? createFormLinesWatched.reduce((acc, product) => {
            let deliveryAdditionalFee = 0;
            if (product.needDeliveryAdditionalFee) {
              // 세트 상품인 경우 구성품 qty 합계 * 세트 수량으로 계산
              const qtyForDeliveryFee = product.isBundle
                ? (product.bundleComponentQtySum || 0) * product.qty
                : product.qty;
              const deliveryBoxCount = getDeliveryBoxCountConsiderAdjustPricePv(product, qtyForDeliveryFee);
              deliveryAdditionalFee = calcTotalExcludeVatByUnitExcludeVatAndQty(
                unitAdditionalFeeExcludeVat,
                deliveryBoxCount,
                false
              );
            }
            return acc + deliveryAdditionalFee;
          }, 0)
        : additionalFeeForEtcDeliveryWatched)) ||
    0;
  const totalDeliveryAdditionalFeeVat = calcVatByPriceExcludeVat(totalDeliveryAdditionalFeeExcludeVat);
  const totalDeliveryAdditionalFee = totalDeliveryAdditionalFeeExcludeVat + totalDeliveryAdditionalFeeVat;

  // 기타 배송비 (부가세 포함 / 부가세 별도 / 부가세)
  const totalEtcDeliveryFee = etcDeliveryFeeWatched || 0;
  const totalEtcDeliveryFeeExcludeVat = toPriceExcludeVat(totalEtcDeliveryFee);
  const totalEtcDeliveryFeeVat = calcVatByPriceIncludeVat(totalEtcDeliveryFee);

  // b2b 배송비 (부가세 별도 / 부가세 / 부가세 포함)
  const totalB2bDeliveryFeeExcludeVat = createFormLinesWatched
    ? createFormLinesWatched.reduce((acc, product) => acc + (product?.b2bDeliveryFeeExcludeVat ?? 0), 0)
    : 0;
  const totalB2bDeliveryFeeVat = calcVatByPriceExcludeVat(totalB2bDeliveryFeeExcludeVat);
  const totalB2bDeliveryFee = totalB2bDeliveryFeeExcludeVat + totalB2bDeliveryFeeVat;

  // 총 합계 (부가세 포함)
  const totalPaymentAmount =
    totalProductAmount + totalB2bDeliveryFee + totalEtcDeliveryFee + totalDeliveryAdditionalFee;
  // 총 부가세
  const totalVat = totalProductVat + totalB2bDeliveryFeeVat + totalEtcDeliveryFeeVat + totalDeliveryAdditionalFeeVat;

  useEffect(() => {
    if (totalDeliveryAdditionalFee !== undefined) {
      form.setFieldValue("additionalFeeForEtcDeliveryByCourier", totalDeliveryAdditionalFee);
    }
  }, [totalDeliveryAdditionalFee]);

  useEffect(() => {
    if (estimatedArrivalDateDoesntMatterWatched) {
      form.setFields([{ name: "estimatedArrivalDate", value: null }]);
    }
  }, [estimatedArrivalDateDoesntMatterWatched]);

  return (
    <>
      <Form.Item hidden name="linesObj">
        <Input />
      </Form.Item>
      <Form.Item hidden name="customerUser">
        <Input />
      </Form.Item>
      <Form.Item hidden name="selectedProductData">
        <Input />
      </Form.Item>
      <Form.Item hidden name="additionalFeeForEtcDeliveryByCourier">
        <Input />
      </Form.Item>
      {isStaff && <AppHeader onBack={onBack}>{sectionName}</AppHeader>}
      <PageHeader
        extra={
          <Space direction="horizontal">
            <Button type="primary" shape="round" loading={loading} onClick={onSubmit}>
              주문 생성
            </Button>
          </Space>
        }
        title={
          <Space direction="horizontal">
            <Typography.Title level={4}>{sectionName}</Typography.Title>
          </Space>
        }
        style={{ marginBottom: 16 }}
      />
      <Row gutter={[16, 16]}>
        <Col span={16}>
          {!isByHqStaffForBrand && (
            <CreateAdminOrderInfoCard
              isByStaffForBrand={isByStaffForBrand}
              isByStaffForBadStock={isByStaffForBadStock}
              isByStaffForB2b={isByStaffForB2b}
              chargeDeliveryAdditionalFee={chargeDeliveryAdditionalFee}
              deliveryMethodWatched={deliveryMethodWatched}
              estimatedArrivalDateDoesntMatterWatched={estimatedArrivalDateDoesntMatterWatched}
            />
          )}
          <CreateAdminOrderProductCard
            customerUserWatched={customerUserWatched}
            createFormLinesWatched={createFormLinesWatched}
            isHqStaff={isHqStaff}
            isByStaffForBrand={isByStaffForBrand}
            isByStaffForEtc={isByStaffForEtc}
            isByStaffForB2b={isByStaffForB2b}
            isByHqStaffForBrand={isByHqStaffForBrand}
            form={form}
            showModal={() => {
              showModal(CreateAdminOrderViewModalType.PRODUCT_SETTING);
            }}
            isShowNoteForUnitPriceMode={isShowNoteForUnitPriceMode}
            isB2bTakeBackWatched={isB2bTakeBackWatched}
            chargeDeliveryAdditionalFee={chargeDeliveryAdditionalFee}
          />

          {isByStaffForEtc === false && (
            <CreateAdminOrderTotalPriceCard
              totalPaymentAmount={totalPaymentAmount}
              totalProductAmountExcludeVat={totalProductAmountExcludeVat}
              totalEtcDeliveryFeeExcludeVat={totalEtcDeliveryFeeExcludeVat}
              totalDeliveryAdditionalFeeExcludeVat={totalDeliveryAdditionalFeeExcludeVat}
              totalB2bDeliveryFeeExcludeVat={totalB2bDeliveryFeeExcludeVat}
              taxAmount={totalVat}
              deliveryMethodWatched={deliveryMethodWatched}
              chargeDeliveryAdditionalFee={chargeDeliveryAdditionalFee}
              unitAdditionalFeeExcludeVat={unitAdditionalFeeExcludeVat}
              isByStaffForB2b={isByStaffForB2b}
              isByStaffForBrand={isByStaffForBrand}
            />
          )}
        </Col>
        <Col span={8}>
          {isHqStaffB2bOrderMode === false && useBpSkuMode && (
            <CreateAdminOrderUserInfoCard
              customerUserWatched={customerUserWatched}
              showModal={() => {
                showModal(CreateAdminOrderViewModalType.USER_SETTING);
              }}
              isHqStaff={isHqStaff}
              isByHqStaffForBrand={isByHqStaffForBrand}
              onDeliverToMe={onDeliverToMe}
            />
          )}
          <CreateAdminOrderAddressInfoCard
            addressInfo={addressInfo}
            useBpSkuMode={useBpSkuMode}
            customerUserWatched={customerUserWatched}
            isByHqStaffForBrand={isByHqStaffForBrand}
            showModal={() => {
              showModal(CreateAdminOrderViewModalType.SEARCH_ADDRESS);
            }}
          />
          {isByStaffForBrand && (
            <CreateAdminOrderTaxInvoiceBizInfoCard
              showModal={() => showModal(CreateAdminOrderViewModalType.BIZ_INFO_SETTING)}
              taxInvoiceRequestFlagWatched={taxInvoiceRequestFlagWatched}
              taxInvoiceBizRegNoWatched={taxInvoiceBizRegNoWatched}
              taxInvoiceBizCorpNameWatched={taxInvoiceBizCorpNameWatched}
              taxInvoiceBizCeoNameWatched={taxInvoiceBizCeoNameWatched}
            />
          )}
          <Card title={<CardTitleAntd title="요청 사항" />} style={{ marginBottom: 16 }}>
            <Form.Item name="customerNote" rules={[{ max: 100 }]}>
              <Input.TextArea placeholder="최대 100자" />
            </Form.Item>
          </Card>
          {showStaffNoteMode && (
            <Card title={<CardTitleAntd title="업무 참고 사항" />}>
              <Form.Item name="staffNote">
                <Input.TextArea />
              </Form.Item>
            </Card>
          )}
        </Col>
      </Row>
    </>
  );
};

export default CreateAdminOrderPage;
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderPage/CreateAdminOrderProductCard.tsx">
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { showNotificationInfo, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Divider, Form, Input, Space, Typography } from "antd";
import { Checkbox } from "antd";
import { FormInstance } from "antd/es/form";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useState } from "react";

import { CreateAdminOrderForm, ICreateAdminOrderFormLine } from "../../views/CreateAdminOrderView/CreateAdminOrderView";
import { getCreateAdminOrderEditProductListTableSettings } from "../CreateAdminOrderEditProductListTable/CreateAdminOrderEditProductListTableSetting";
import NoteForUnitPriceInfoModal from "../NoteForUnitPriceInfoModal/NoteForUnitPriceInfoModal";

interface CreateAdminOrderProductCardProps {
  customerUserWatched: SearchCustomersForAdminOrder_search_edges_node;
  createFormLinesWatched: ICreateAdminOrderFormLine[];
  isHqStaff: boolean;
  isByStaffForBrand: boolean;
  isByStaffForEtc: boolean;
  isByStaffForB2b: boolean;
  isByHqStaffForBrand: boolean;
  form: FormInstance<CreateAdminOrderForm>;
  showModal: () => void;
  isShowNoteForUnitPriceMode: boolean;
  isB2bTakeBackWatched: boolean;
  chargeDeliveryAdditionalFee: boolean;
}

const CreateAdminOrderProductCard: React.FC<CreateAdminOrderProductCardProps> = (props) => {
  const {
    customerUserWatched,
    createFormLinesWatched,
    isHqStaff,
    isByStaffForBrand,
    isByStaffForEtc,
    isByStaffForB2b,
    isByHqStaffForBrand,
    form,
    showModal,
    isShowNoteForUnitPriceMode,
    isB2bTakeBackWatched,
    chargeDeliveryAdditionalFee,
  } = props;
  const [selectedIds, setSelectedIds] = React.useState<React.Key[]>([]);
  const [showNoteForUnitPrice, setShowNoteForUnitPrice] = useState<string | null>(null);

  // sku에 맞는 수량 일괄 수정을 위한 state들
  const [skuStr, setSkuStr] = useState<string>("");
  const [quantityStr, setQuantityStr] = useState<string>("");
  const [priceStr, setPriceStr] = useState<string>("");

  const useBpSkuMode = isByStaffForBrand || isByStaffForB2b || isByHqStaffForBrand;
  const title = useBpSkuMode ? "주문 상품" : "주문 제품";
  const skuLabel = useBpSkuMode ? "상품코드" : "제품코드";
  const priceLabel = isByStaffForB2b ? "공급가" : "판매가";

  const changeQuantityAll = () => {
    const skuList = skuStr.split("\n");
    const quantityList = quantityStr.split("\n");
    const priceList = priceStr.split("\n");
    const noPriceChange = utils.isEmpty(priceStr);

    if (skuList.length !== quantityList.length) {
      showNotificationWarn(skuLabel + "와 수량의 개수가 일치하지 않습니다.");
      return;
    }

    let changesMessage = "변경된 제품 목록:\n";
    let hasChanges = false;

    const updatedSelectedProductDataList = Object.keys(createFormLinesWatched).reduce<ICreateAdminOrderFormLine[]>(
      (acc, key) => {
        const productData: ICreateAdminOrderFormLine = createFormLinesWatched[key];

        if (productData.isDeferred) {
          acc.push(productData);
          return acc;
        }

        const sku = useBpSkuMode ? productData.bpSku : productData.sku || "";
        const idx = skuList.indexOf(sku);

        if (idx !== -1) {
          const isTaxFree = productData.isTaxFree;
          const oldQuantity = productData.qty;
          const oldPriceIncludeVat = productData.priceIncludeVat;
          const oldPriceExcludeVat = productData.priceExcludeVat;
          const oldPriceVat = productData.priceVat;

          const newQuantity = Number(quantityList[idx]);
          // b2b인 경우 부가세 별도, 그 외에는 부가세 포함 금액이 입력으로 전달됨.
          const priceInputValue = noPriceChange ? null : Number(utils.removeComma(priceList[idx]));
          const newPriceIncludeVat = noPriceChange
            ? oldPriceIncludeVat
            : isByStaffForB2b
            ? toPriceIncludeVat(priceInputValue, isTaxFree)
            : priceInputValue;
          const newPriceExcludeVat = noPriceChange
            ? oldPriceExcludeVat
            : isByStaffForB2b
            ? priceInputValue
            : toPriceExcludeVat(priceInputValue, isTaxFree);
          const newPriceVat = noPriceChange ? oldPriceVat : newPriceIncludeVat - newPriceExcludeVat;

          if (oldQuantity !== newQuantity || oldPriceExcludeVat !== newPriceExcludeVat) {
            const msgForPrice = isByStaffForB2b
              ? `${getNumberFormat(oldPriceExcludeVat)} → ${getNumberFormat(newPriceExcludeVat)}`
              : `${getNumberFormat(oldPriceIncludeVat)} → ${getNumberFormat(newPriceIncludeVat)}`;
            const msgForQty = `${getNumberFormat(oldQuantity)} → ${getNumberFormat(newQuantity)}`;
            changesMessage += `- ${sku}, ${priceLabel} : ${msgForPrice}, 수량 : ${msgForQty}\n`;

            form.setFields([{ name: ["linesObj", productData.id, "priceIncludeVat"], value: newPriceIncludeVat }]);
            form.setFields([{ name: ["linesObj", productData.id, "priceExcludeVat"], value: newPriceExcludeVat }]);
            form.setFields([{ name: ["linesObj", productData.id, "priceVat"], value: newPriceVat }]);
            form.setFields([{ name: ["linesObj", productData.id, "qty"], value: newQuantity }]);
            hasChanges = true;
          }

          acc.push({
            ...productData,
            priceIncludeVat: newPriceIncludeVat,
            priceExcludeVat: newPriceExcludeVat,
            priceVat: newPriceVat,
            qty: newQuantity,
          });
        } else {
          acc.push(productData);
        }

        return acc;
      },
      []
    );

    form.setFieldValue("selectedProductData", updatedSelectedProductDataList);

    // ✅ 변경된 내용이 있으면 메시지 출력
    if (hasChanges) {
      showNotificationInfo(changesMessage.trim(), undefined, undefined, { whiteSpace: "pre-line" }); // 줄바꿈 정리 후 출력
    } else {
      showNotificationInfo("변경된 제품이 없습니다.");
    }
  };
  const onShowNoteForUnitPrice = (noteForUnitPrice: string) => setShowNoteForUnitPrice(noteForUnitPrice);
  const columns = getCreateAdminOrderEditProductListTableSettings({
    form,
    isHqStaff,
    isByStaffForEtc,
    isByStaffForBrand,
    isByStaffForB2b,
    isByHqStaffForBrand,
    isB2bTakeBackWatched,
    onShowNoteForUnitPrice,
    isShowNoteForUnitPriceMode,
    chargeDeliveryAdditionalFee,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const rowSelection: TableRowSelection<ICreateAdminOrderFormLine> = {
    fixed: true,
    onChange: (selectedRowKeys) => {
      setSelectedIds(selectedRowKeys);
    },
    selectedRowKeys: selectedIds,
  };

  const deleteProductVariantOnClick = () => {
    const currentLinesObj = form.getFieldValue("linesObj");
    const updatedLinesObj = { ...currentLinesObj };
    selectedIds.forEach((id) => {
      delete updatedLinesObj[id];
    });
    form.setFieldValue("linesObj", updatedLinesObj);

    setSelectedIds(null);
  };

  const addButtonDisabled = (isByStaffForBrand || isByStaffForB2b) && utils.isEmpty(customerUserWatched);
  const deleteButtonDisabled = selectedIds === null || selectedIds.length === 0;

  return (
    <>
      <Card
        title={
          <div style={{ display: "flex", alignItems: "center" }}>
            <CardTitleAntd title={title} />
            {isByStaffForB2b && (
              <Form.Item name="isB2bTakeBack" noStyle valuePropName="checked">
                <Checkbox
                  onChange={(e) => {
                    const checked = e.target.checked;
                    if (utils.isEmpty(createFormLinesWatched) || createFormLinesWatched.length === 0) {
                      form.setFieldValue("isB2bTakeBack", false);
                      showNotificationWarn(title + "을 선택 후 체크해주세요.");
                      return;
                    }

                    if (checked) {
                      createFormLinesWatched.map((item) => {
                        form.setFieldValue(["linesObj", item.id, "b2bDeliveryFeeExcludeVat"], 0);
                      });
                    }
                  }}
                >
                  B2B 반품 주문
                </Checkbox>
              </Form.Item>
            )}
          </div>
        }
        extra={
          <Space size="small">
            {!isHqStaff && (
              <>
                <FormFieldAntd label={skuLabel}>
                  <Input.TextArea
                    style={{ width: 140 }}
                    autoSize={{ maxRows: 2 }}
                    value={skuStr}
                    onChange={(e) => setSkuStr(e.target.value)}
                  />
                </FormFieldAntd>
                <FormFieldAntd label={priceLabel}>
                  <Input.TextArea
                    style={{ width: 80 }}
                    autoSize={{ maxRows: 2 }}
                    value={priceStr}
                    onChange={(e) => setPriceStr(e.target.value)}
                  />
                </FormFieldAntd>
                <FormFieldAntd label="수량">
                  <Input.TextArea
                    style={{ width: 80 }}
                    autoSize={{ maxRows: 2 }}
                    value={quantityStr}
                    onChange={(e) => setQuantityStr(e.target.value)}
                  />
                </FormFieldAntd>
                <Button type="primary" shape="round" onClick={changeQuantityAll}>
                  일괄 변경
                </Button>
                <Divider type="vertical" />
              </>
            )}
            <Button type="primary" shape="round" onClick={showModal} disabled={addButtonDisabled}>
              {isByHqStaffForBrand ? "선택" : "추가"}
            </Button>
            <Button
              type="primary"
              danger
              shape="round"
              disabled={deleteButtonDisabled}
              onClick={deleteProductVariantOnClick}
            >
              삭제
            </Button>
          </Space>
        }
        style={{ marginBottom: 16 }}
      >
        <TableVatLegend isIncludeVat={isByStaffForB2b ? false : true} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          dataSource={createFormLinesWatched}
          columns={columns}
          components={{
            body: {
              cell: EditableCell,
            },
          }}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          rowSelection={rowSelection}
        />
        {isByStaffForB2b && !isB2bTakeBackWatched && (
          <Typography.Text strong style={{ marginTop: 5, color: "#fa8214" }}>
            * B2B 주문은 상품에 따라 주문 접수 시 추가 B2B 배송비가 발생할 수 있습니다.
          </Typography.Text>
        )}
      </Card>
      <NoteForUnitPriceInfoModal
        open={showNoteForUnitPrice !== null && isShowNoteForUnitPriceMode}
        onCancel={() => setShowNoteForUnitPrice(null)}
        showNoteForUnitPrice={showNoteForUnitPrice}
      />
    </>
  );
};

export default CreateAdminOrderProductCard;
</file>

