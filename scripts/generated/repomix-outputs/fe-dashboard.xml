import { BrandStoreRequestStatusEnum, BrandStoreRequestToHqFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  BrandStoreRequestToHqListViewUrlFilterEnum,
  BrandStoreRequestToHqListViewUrlFilters,
  BrandStoreRequestToHqListViewUrlFiltersWithMultipleValuesEnum,
  BrandStoreRequestToHqListViewUrlQueryParams,
} from "@src/app/views/notice/notices/urls";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment-timezone";

import {
  BrandStoreRequestToHqListFilterKeys,
  BrandStoreRequestToHqListFilterOpts,
} from "../../components/BrandStoreRequestToHqListPage/filters";

const BRAND_STORE_REQUEST_TO_HQ_LIST_FILTERS_KEY = "brandStoreRequestToHqListFiltersKey";

export function getFilterOpts(
  params: BrandStoreRequestToHqListViewUrlQueryParams
): BrandStoreRequestToHqListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, moment().format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, moment().format(onlyDateFormat)),
      },
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => dedupeFilter(filterVariables.status), []),
    },
    titleSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.titleSearch, true), false),
      value: maybe(() => filterVariables.titleSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
  };
}

export function getFilterVariables(params: BrandStoreRequestToHqListViewUrlFilters): BrandStoreRequestToHqFilterInput {
  return {
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    status: maybe(() => params.status.map((status) => findValueInEnum(status, BrandStoreRequestStatusEnum)), []),
    titleSearch: params.titleSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<BrandStoreRequestToHqListFilterKeys>
): BrandStoreRequestToHqListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandStoreRequestToHqListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        BrandStoreRequestToHqListViewUrlFilterEnum.createdFrom,
        BrandStoreRequestToHqListViewUrlFilterEnum.createdTo
      );
    case BrandStoreRequestToHqListFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandStoreRequestToHqListViewUrlFiltersWithMultipleValuesEnum.status,
        BrandStoreRequestStatusEnum
      );
    case BrandStoreRequestToHqListFilterKeys.titleSearch:
      return getSingleValueQueryParam(filter, BrandStoreRequestToHqListViewUrlFilterEnum.titleSearch);
    case BrandStoreRequestToHqListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandStoreRequestToHqListViewUrlFilterEnum.brandSearch);
    case BrandStoreRequestToHqListFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, BrandStoreRequestToHqListViewUrlFilterEnum.brandStoreSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandStoreRequestToHqListViewUrlFilters>(BRAND_STORE_REQUEST_TO_HQ_LIST_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BrandStoreRequestToHqListViewUrlQueryParams,
  BrandStoreRequestToHqListViewUrlFilters
>({ ...BrandStoreRequestToHqListViewUrlFilterEnum, ...BrandStoreRequestToHqListViewUrlFiltersWithMultipleValuesEnum });
</file>

