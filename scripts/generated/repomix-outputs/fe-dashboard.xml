  const stockShortageStatusColumn: DownloadableColumnType<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node> = {
    title: columnNameConstant.stock.STOCK_SHORTAGE_STATUS,
    key: "stockShortageStatus",
    align: "center",
    width: 100,
    onCell: (record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      return showNA ? { style: { backgroundColor: "#f5f5f5" } } : {};
    },
    render: (_, record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      if (showNA) {
        return <span style={naValueTextStyle}>{NA_VALUE_TEXT}</span>;
      }
      const stockStatus: StockStatusByEstShortageEnum = record.estShortageInfo?.stockStatusByDaily;
      const text = makeCriticalStockStatus(stockStatus, false);
      if (stockStatus === StockStatusByEstShortageEnum.CRITICAL) {
        return (
          <Typography.Text strong type="danger">
            {text}
          </Typography.Text>
        );
      }
      return text;
    },
    renderExcel: (record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      if (showNA) {
        return NA_VALUE_TEXT;
      }
      const stockStatus: StockStatusByEstShortageEnum = record.estShortageInfo?.stockStatusByDaily;
      return makeCriticalStockStatus(stockStatus, false);
    },
  };

