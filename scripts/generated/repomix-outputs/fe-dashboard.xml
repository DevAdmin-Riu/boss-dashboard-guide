import { ProductCommonImageCreateVariables } from "@src/app/views/notice/productCi/api/types/ProductCommonImageCreate";
import { ProductCommonImageReorderVariables } from "@src/app/views/notice/productCi/api/types/ProductCommonImageReorder";
import { ShopInfoForProductCommonImages_shop_productCommonImages } from "@src/app/views/notice/productCi/api/types/ShopInfoForProductCommonImages";
import { ReorderEvent } from "@src/global/core/types/types";
import { arrayMove } from "react-sortable-hoc";

export function createCommonImageUploadHandler(
  createProductCommonImage: (variables: ProductCommonImageCreateVariables) => void
) {
  return (file: File) =>
    createProductCommonImage({
      alt: "",
      image: file,
    });
}

export function createCommonImageReorderHandler(
  images: ShopInfoForProductCommonImages_shop_productCommonImages[],
  reorderProductCommonImages: (variables: ProductCommonImageReorderVariables) => void
) {
  return ({ newIndex, oldIndex }: ReorderEvent) => {
    if (newIndex !== oldIndex) {
      let ids = images.map((image) => image.id);
      ids = arrayMove(ids, oldIndex, newIndex);
      reorderProductCommonImages({
        imagesIds: ids,
      });
    }
  };
}
</file>

<file path="src/app/views/notice/productCi/views/ProductCiView/ProductCiView.tsx">
import useNavigator from "@hooks/useNavigator";
import {
  useProductCommonImageCreateMutation,
  useProductCommonImageDeleteMutation,
  useProductCommonImagesReorder,
} from "@src/app/views/notice/productCi/api/mutations";
import { useProductCommonImagesQuery } from "@src/app/views/notice/productCi/api/queries";
import { ProductCommonImageCreateVariables } from "@src/app/views/notice/productCi/api/types/ProductCommonImageCreate";
import ProductCiPage from "@src/app/views/notice/productCi/components/ProductCiPage";
import { productCiEditViewUrl } from "@src/app/views/notice/productCi/urls";
import { maybe } from "@utils/misc";
import { makeGqlErrorMsg, showGqlErrorInfo, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { createCommonImageReorderHandler, createCommonImageUploadHandler } from "./handlers";

export const ProductCiView: React.FC = () => {
  const navigate = useNavigator();

  const { data, loading } = useProductCommonImagesQuery({});

  const [createProductCommonImage] = useProductCommonImageCreateMutation({
    onCompleted: (data) => {
      const errors = data.productCommonImageCreate.errors;
      if (errors.length !== 0) {
        if (errors.find((error) => error.field === ("image" as keyof ProductCommonImageCreateVariables))) {
          showGqlErrorInfo("이미지 필드 오류로 제품 이미지 생성에 실패했습니다.", "ImageError");
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
  });

  const [deleteProductCommonImage] = useProductCommonImageDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productCommonImageDelete.errors;
      if (errors.length !== 0) {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [reorderProductCommonImages] = useProductCommonImagesReorder({
    onCompleted: (data) => {
      const errors = data.productCommonImageReorder.errors;
      if (errors.length !== 0) {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleImageUpload = createCommonImageUploadHandler((variables) => createProductCommonImage({ variables }));

  const handleImageDelete = (id: string) => {
    deleteProductCommonImage({ variables: { id } });
  };

  const handleImageReorder = createCommonImageReorderHandler(data?.shop?.productCommonImages, (variables) =>
    reorderProductCommonImages({ variables })
  );

  const handleImageEdit = (imageId: string) => navigate(productCiEditViewUrl(imageId));

  return (
    <>
      <ProductCiPage
        images={maybe(() => data?.shop?.productCommonImages)}
        loading={loading}
        onImageUpload={handleImageUpload}
        onImageEdit={handleImageEdit}
        onImageDelete={handleImageDelete}
        onImageReorder={handleImageReorder}
      />
    </>
  );
};
</file>

