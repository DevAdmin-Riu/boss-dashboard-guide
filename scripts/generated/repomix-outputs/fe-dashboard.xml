import { TextWithLink } from "@src/app/components/TextWithLink";
import { getDateByFormat, getDatesBetween, onlyDateFormat } from "@src/app/providers/DateProvider";
import { makeSalesStatusByProductVariant } from "@src/app/views/product/products/components/ProductListPage/ProductListTableSettings";
import { getSalesUnitTypeText } from "@src/app/views/product/products/utils/data";
import { calcSumOfStockQuantity } from "@src/app/views/product/stock/components/StockListPage/StockListTableSettings";
import {
  getStockSpec,
  getStockVendorCode,
  getStockVendorMoq,
  getStockVendorName,
} from "@src/app/views/product/stock/utils";
import { transformIsExclusive, transformIsInner } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";
import React from "react";

import { SalesStatByProductDataSourceProps, SalesStatByProductListPageProps } from "./SalesStatByProductListPage";

export const getSalesStatByProductListTableSettings = (props: SalesStatByProductListPageProps) => {
  const { stoppedReasonChoices } = props;
  const { statDate } = props?.filterVariables;

  const { gte: startDate, lte: endDate } = statDate || { gte: null, lte: null };
  const startMonth = moment(startDate);
  const endMonth = moment(endDate);
  const monthStrArr = getDatesBetween([startMonth, endMonth], "month").formattedDates;

  const fixedLeftFlag = utils.fixedLeftFlag();

  const skuFixedColumn: DownloadableColumnType<SalesStatByProductDataSourceProps> = {
    title: columnNameConstant.product.SKU,
