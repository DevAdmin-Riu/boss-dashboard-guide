import { ShopBannerSettingsUpdate, ShopBannerSettingsUpdateVariables } from "./types/ShopBannerSettingsUpdate";
import { ShopSettingsUpdate, ShopSettingsUpdateVariables } from "./types/ShopSettingsUpdate";

const shopSettingsUpdate = gql`
  ${shopErrorFragment}
  ${shopForSiteSettingsFragment}
  ${addressFragment}
  mutation ShopSettingsUpdate(
    $shopDomainInput: SiteDomainInput!
    $shopSettingsInput: ShopSettingsInput!
    $addressInput: AddressInput
  ) {
    shopSettingsUpdate(input: $shopSettingsInput) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        ...ShopForSiteSettingsFragment
      }
    }
    shopDomainUpdate(input: $shopDomainInput) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        domain {
          host
          url
        }
      }
    }
    shopAddressUpdate(input: $addressInput) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        companyAddress {
          ...AddressFragment
        }
      }
    }
  }
`;
export const useShopSettingsUpdate = makeMutation<ShopSettingsUpdate, ShopSettingsUpdateVariables>(shopSettingsUpdate);

const shopBannerSettingsUpdate = gql`
  ${shopErrorFragment}
  ${shopBannerFragment}
  mutation ShopBannerSettingsUpdate($shopSettingsInput: ShopSettingsInput!) {
    shopSettingsUpdate(input: $shopSettingsInput) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        ...ShopBannerFragment
        __typename
      }
    }
  }
`;
export const useShopBannerSettingsUpdateMutation = makeMutation<
