import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import { PvEstimateBulkCreateInput, QtyPerBoxUnitTypeEnum, SalesUnitTypeEnum } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { isDateInFormatWithMoment, onlyDateFormat } from "@src/app/providers/DateProvider";
import { loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Form, Modal, Space, Typography } from "antd";
import React, { useRef, useState } from "react";

import { usePvEstimateBulkCreateMutation } from "../../api/mutations";
import { pvEstimateAiListQuery } from "../../api/queries";

interface PvEstimateBulkCreateModalProps {
  // Define any props if needed
  open: boolean;
  loading: boolean;
  onClose: () => void;
}

const PvEstimateBulkCreateModal: React.FC<PvEstimateBulkCreateModalProps> = (props) => {
  const { open, loading, onClose } = props;
  const upload = useRef<HTMLInputElement>();
  const [selectedFile, setSelectedFile] = useState<string>();
  const [errorExist, setErrorExist] = useState<boolean>(false);
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<PvEstimateBulkCreateInput>(form);
  const handleUploadButtonClick = () => upload.current.click();

  const detailsWatched = Form.useWatch("details", form);

  const onCloseModal = () => {
    onClose();
    form.resetFields();
    setSelectedFile(null);
    setErrorExist(false);
  };

  const [pvEstimateBulkCreate, pvEstimateBulkCreateOpts] = usePvEstimateBulkCreateMutation({
    onCompleted: (data) => {
      const errors = data.pvEstimateBulkCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("견적 등록 정보가 생성 되었습니다.");
        form.resetFields();
        onCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [pvEstimateAiListQuery],
  });

  const checkEmptyShowNotificationError = (index: number, fieldName: string): void => {
    showNotificationError(
      `양식 엑셀 파일에 '순번 ${index}'의 '${fieldName}' 값이 비어 있거나 잘못된 값 입니다. 다시 확인해 주세요.`
    );
  };

  const checkSalesUnitType = (value: SalesUnitTypeEnum): boolean => Object.values(SalesUnitTypeEnum).includes(value);

  const checkQtyPerBoxUnitType = (value: QtyPerBoxUnitTypeEnum): boolean =>
    [
      QtyPerBoxUnitTypeEnum.BOX,
      QtyPerBoxUnitTypeEnum.BUNDLE,
      QtyPerBoxUnitTypeEnum.EA,
      QtyPerBoxUnitTypeEnum.KG,
      QtyPerBoxUnitTypeEnum.PAC,
      QtyPerBoxUnitTypeEnum.SET,
    ].includes(value);

  const readUploadFile = async (e) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const sheetName = worksheet.name;
        const targetVersion = excelTemplateVersion.pvEstimateCreate;
        if (utils.validateTemplateVersion(sheetName, targetVersion) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        const details = parseWorksheetToJsonArr<any>({ worksheet });
        for (const detail of details) {
          // convert 필요한 부분
          detail.estimateDate = utils.convertExcelDateToString(detail.estimateDate);

          // validation 체크
          if (utils.isEmpty(detail.index)) {
            showNotificationError("양식 엑셀 파일에 '순번' 값이 비어 있습니다. 다시 확인해 주세요.");
            return;
          }

          const index = detail.index;

          if (utils.isEmpty(detail.categoryId)) {
            checkEmptyShowNotificationError(index, "카테고리 코드");
            return;
          }

          if (utils.isEmpty(detail.brandName)) {
            checkEmptyShowNotificationError(index, "요청 브랜드");
            return;
          }

          if (utils.isEmpty(detail.mdName)) {
            checkEmptyShowNotificationError(index, "담당 MD");
            return;
          }
          if (
            utils.isEmpty(detail.estimateDate) ||
            isDateInFormatWithMoment(detail.estimateDate, onlyDateFormat) === false
          ) {
            checkEmptyShowNotificationError(index, "견적일");
            return;
          }

          if (utils.isEmpty(detail.productName)) {
            checkEmptyShowNotificationError(index, "기존 제품명");
            return;
          }

          if (utils.isEmpty(detail.buyMethod)) {
            checkEmptyShowNotificationError(index, "구매 방식");
            return;
          }

          if (utils.isEmpty(detail.minPriceExcludeVat)) {
            checkEmptyShowNotificationError(index, "최저가");
            return;
          }

          if (utils.isEmpty(detail.sourceUrl)) {
            checkEmptyShowNotificationError(index, "출처");
            return;
          }

          if (utils.isEmpty(detail.monthlySalesQty)) {
            checkEmptyShowNotificationError(index, "월 사용량");
            return;
          }

          if (
            utils.isEmpty(detail.monthlySalesQtyUnitType) &&
            checkSalesUnitType(detail.monthlySalesQtyUnitType) === false
          ) {
            checkEmptyShowNotificationError(index, "월 사용량 단위");
            return;
          }

          if (utils.isEmpty(detail.sameOrReplacement)) {
            checkEmptyShowNotificationError(index, "동일/대체");
            return;
          }

          if (utils.isEmpty(detail.sku)) {
            checkEmptyShowNotificationError(index, "제품코드");
            return;
          }

          if (utils.isEmpty(detail.isTaxFree)) {
            checkEmptyShowNotificationError(index, "과세여부");
            return;
          }

          if (utils.isEmpty(detail.qtyPerBox)) {
            checkEmptyShowNotificationError(index, "입상수");
            return;
          }

          if (utils.isEmpty(detail.qtyPerBoxUnitType) || checkQtyPerBoxUnitType(detail.qtyPerBoxUnitType) === false) {
            checkEmptyShowNotificationError(index, "입상수 단위");
            return;
          }

          if (utils.isEmpty(detail.countryOfOrigin)) {
            checkEmptyShowNotificationError(index, "원산지");
            return;
          }

          if (utils.isEmpty(detail.makerName)) {
            checkEmptyShowNotificationError(index, "제조사");
            return;
          }

          if (utils.isEmpty(detail.poManagerName)) {
            checkEmptyShowNotificationError(index, "구매담당자");
            return;
          }

          if (utils.isEmpty(detail.trackInventory)) {
            checkEmptyShowNotificationError(index, "운영방식(재고/위탁)");
            return;
          }

          if (utils.isEmpty(detail.vendorCode)) {
            checkEmptyShowNotificationError(index, "협력사코드");
            return;
          }

          if (utils.isEmpty(detail.makeQty)) {
            checkEmptyShowNotificationError(index, "제작수량(box)");
            return;
          }

          if (utils.isEmpty(detail.makeQtyUnitType) || checkSalesUnitType(detail.makeQtyUnitType) === false) {
            checkEmptyShowNotificationError(index, "제작수량 단위");
            return;
          }

          if (utils.isEmpty(detail.productPriceExcludeVat)) {
            checkEmptyShowNotificationError(index, "협력사 제품가(판매단위)");
            return;
          }

          if (utils.isEmpty(detail.deliveryFeeExcludeVat)) {
            checkEmptyShowNotificationError(index, "협력사 배송비(판매단위)");
            return;
          }
        }

        TypeSafeForm.setFields([{ name: "details", value: details }]);
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }

    if (upload.current) {
      upload.current.value = "";
    }
  };

  const onSubmit = async (formData: PvEstimateBulkCreateInput) => {
    const { details } = formData;
    pvEstimateBulkCreate({ variables: { input: { details } } });
  };

  return (
    <Modal
      open={open}
      onOk={form.submit}
      onCancel={onCloseModal}
      confirmLoading={loading || pvEstimateBulkCreateOpts.loading}
      title="견적 데이터 양식 업로드"
      maskClosable={false}
      okButtonProps={{ disabled: pvEstimateBulkCreateOpts.loading || loading || utils.isEmpty(detailsWatched) }}
      destroyOnClose={true}
    >
      <Form form={form} layout="vertical" initialValues={{ details: [] }} onFinish={onSubmit} preserve={false}>
        <Form.Item name="details" label="견적 데이터 양식 업로드">
          <Space direction="vertical" size={0}>
            <Button onClick={handleUploadButtonClick} type="primary">
              견적 데이터 양식 선택
            </Button>
            {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
            {errorExist && <Typography.Text type="warning">양식 엑셀 파일을 다시 선택해 주세요.</Typography.Text>}
            <input
              hidden={true}
              id="productVariantBulkUpdateOrCreateInputFile"
              onChange={(e) => readUploadFile(e)}
              type="file"
              ref={upload}
              accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
            />
          </Space>
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default PvEstimateBulkCreateModal;
</file>

