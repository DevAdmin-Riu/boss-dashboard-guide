import { PreFounderStatsDimensionEnum } from "@src/api/types/globalTypes";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { getDatesBetween, onlyMonthFormat } from "@src/app/providers/DateProvider";
import moment, { Moment } from "moment";

import { HqPreFounderStatList_preFounderStatsByField } from "../../api/types/HqPreFounderStatList";
import { HqPreFounderStatListPageProps } from "./HqPreFounderStatListPage";
import { convertPreFounderStatFieldValueToLabel } from "./utils";

const makeStatDateColumn = (statMonth: Moment): DownloadableColumnType<HqPreFounderStatList_preFounderStatsByField> => {
  const formattedMonth = statMonth.format(onlyMonthFormat);

  return {
    title: formattedMonth,
    key: formattedMonth,
    align: "right",
    width: 100,
    render: (_, record) => {
      const targetCountObj = record.counts.find((countObj) => {
        const countMonth = moment(countObj.month);
        if (!countMonth.isValid()) {
          return false;
        }
        return countMonth.isSame(statMonth, "month");
      });
      return targetCountObj?.count ?? "-";
    },
  };
};

export const getHqPreFounderStatListTableSettings = (
  props: HqPreFounderStatListPageProps
): DownloadableColumnsType<HqPreFounderStatList_preFounderStatsByField> => {
  const { shop, queryVariables } = props;
  const { dimension, statDate } = queryVariables;

  const columns: DownloadableColumnsType<HqPreFounderStatList_preFounderStatsByField> = [
    {
      title: "구분",
      key: "fieldValue",
      align: "center",
      width: dimension === PreFounderStatsDimensionEnum.SOURCE ? 200 : 100,
      render: (_, record) => convertPreFounderStatFieldValueToLabel(record.fieldValue, dimension, shop),
    },
  ];

  const { dates } = getDatesBetween([moment(statDate.gte), moment(statDate.lte)], "month");
  const countByDateColumns = dates.map((date) => makeStatDateColumn(date));
  columns.push({
    title: "등록된 예비창업자 수",
    children: countByDateColumns,
  });

  return columns;
};
</file>

<file path="src/app/views/hqStaff/hqPreFounder/components/HqPreFounderStatListPage/utils.ts">
import { PreFounderStatsDimensionEnum } from "@src/api/types/globalTypes";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { genderChoices, utils } from "@utils/utils";

import { preFounderLeadSourceChoices } from "../../utils";

const unknownChoice = { label: "미지정", value: "UNKNOWN" };

export const getPreFounderStatFieldValueList = (dimension: PreFounderStatsDimensionEnum, shop: ShopInfo_shop) => {
  let targetFieldValueList: string[] = [];
  switch (dimension) {
    case PreFounderStatsDimensionEnum.SOURCE:
      targetFieldValueList = preFounderLeadSourceChoices.map((choice) => choice.value);
      break;
    case PreFounderStatsDimensionEnum.REGION:
      const regionsInfo = shop?.regionsInfo || [];
      targetFieldValueList = regionsInfo.map((region) => region.code);
      break;
    case PreFounderStatsDimensionEnum.GENDER:
      targetFieldValueList = genderChoices.map((choice) => choice.value);
      break;
    default:
      return [];
  }

  targetFieldValueList.push(unknownChoice.value);
  return targetFieldValueList;
};

export const convertPreFounderStatFieldValueToLabel = (
  fieldValue: string,
  dimension: PreFounderStatsDimensionEnum,
  shop: ShopInfo_shop
) => {
  switch (dimension) {
    case PreFounderStatsDimensionEnum.SOURCE:
      return utils.getLabelTextByValue(fieldValue, [...preFounderLeadSourceChoices, unknownChoice]);
    case PreFounderStatsDimensionEnum.REGION:
      const regionsInfo = shop?.regionsInfo || [];
      const targetRegion = regionsInfo.find((region) => region.code === fieldValue);
      return targetRegion ? targetRegion.name : unknownChoice.label;
    case PreFounderStatsDimensionEnum.GENDER:
      return utils.getLabelTextByValue(fieldValue, [...genderChoices, unknownChoice]);
    default:
      return fieldValue;
  }
};
</file>

