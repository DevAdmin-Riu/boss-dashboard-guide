                    }
                    if (value === false && utils.isEmpty(variant.mainPvs) === false) {
                      showNotificationWarn(
                        "현재 소모 부자재로써 연동된 제품이 존재하므로 포장보스 부자재를 비활성화할 수 없습니다."
                      );
                      return;
                    }
                  }
                  onChange({ target: { name: "isSubPv", value } });
                }}
              />
            </FormFieldAntd>
          </Col>

          <Col span={24} sm={12}>
            <FormFieldAntd label="유통기한 관리" description="활성화할 경우, 재고의 유통기한을 필수로 입력해야 합니다.">
              <Switch
                disabled={disabled || !data.trackInventory}
                checked={data.requiredExpDateMgmt}
                checkedChildren="ON"
                unCheckedChildren="OFF"
                onChange={(value) => onChange({ target: { name: "requiredExpDateMgmt", value } })}
              />
            </FormFieldAntd>
          </Col>
        </>
      )}
      {isFulfilledByVendor && (
        <>
          <Divider style={{ margin: 0 }} />
          <Col xs={24} sm={12}>
            <FormFieldAntd
              label="현금 전용 상품"
              description="활성화할 경우, 매장이 현금(충전금, 가상계좌)을 통해서만 이 상품을 결제할 수 있습니다."
            >
              <Switch
                disabled={disabled}
                checked={hasIsFbvProperty(data) ? data.isOnlyPayableByCash : undefined}
                checkedChildren="ON"
                unCheckedChildren="OFF"
                onChange={(value) => {
                  onChange({ target: { name: "isOnlyPayableByCash", value } });
                }}
              />
            </FormFieldAntd>
          </Col>
          <Col xs={24} sm={12}>
            <FormFieldAntd
              label="후정산 여부"
              description="활성화할 경우, 해당 제품은 단가가 정해지지 않고 매장과 협력사가 포장보스 외부에서 가격 논의 후 결제하게 됩니다."
            >
              <Switch
                disabled={disabled}
                checked={hasIsFbvProperty(data) ? data.isDeferred : undefined}
                checkedChildren="ON"
                unCheckedChildren="OFF"
                onChange={(value) => {
                  if (value === true) {
                    setIsDeferredConfirmModal(value);
                  }
                  if (value === false) {
                    onChange({ target: { name: "isDeferred", value: false } });
                  }
                }}
              />
            </FormFieldAntd>
          </Col>
        </>
      )}

      <ConfirmModal
        visible={isDeferredConfirmModal}
        titleText="후정산 제품으로 변경 시 협력사 상품가, 배송비, 매입가, 판매 택배비, 브랜드 상품가, 이 상품을 취급하는 모든 브랜드의 브랜드 배송비, 매장 판매가, 할인 전 판매가 금액이 0으로 변경 됩니다. 변경하시겠습니까?"
        onOk={() => {
          onChange({ target: { name: "isDeferred", value: true } });
          onChange({ target: { name: "defaultPvvProductPriceExcludeVat", value: 0 } });
          onChange({ target: { name: "defaultPvvDeliveryFeeExcludeVat", value: 0 } });
          onChange({ target: { name: "defaultPvvConsignmentProductPriceExcludeVat", value: 0 } });
          onChange({ target: { name: "defaultPvvConsignmentDeliveryFeeExcludeVat", value: 0 } });
          onChange({ target: { name: "bpvPriceExcludeVat", value: 0 } });
          onChange({ target: { name: "bpvPriceVat", value: 0 } });
          onChange({ target: { name: "bpvBeforePriceExcludeVat", value: 0 } });
          onChange({ target: { name: "bpvShowBeforePrice", value: false } });
          setIsDeferredConfirmModal(false);
        }}
        onCancel={() => setIsDeferredConfirmModal(false)}
      />
    </>
  );
};

