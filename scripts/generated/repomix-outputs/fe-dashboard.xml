<file path="src/app/views/hqStaff/hqSection/components/HqStatsOrder/utils.ts">
import { commonMsg } from "@assets/messages/commonMsg";
import { User_brand } from "@src/api/fragments/types/User";
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node } from "@src/app/views/mileageSettlement/api/types/BrandMileageMonthlySettlements";
import { statsDateType, statsValueType } from "@utils/chart";
import {
  calcVatByPriceExcludeVat,
  excelDownload,
  makeHeaderRowsAndMerges,
  toPriceExcludeVat,
} from "@utils/excel/excelDownload";
import { transformIsFBVForHq } from "@utils/misc";
import { destroyDownloadingMessage, showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import moment, { Moment } from "moment";

export const replaceStatForHq = (
  confirmedDataNode: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node
): BrandOrderStats_brandOrderStats => ({
  __typename: "BrandOrderStats",
  statDate: confirmedDataNode.date,
  statOrderCount: null,
  statQuantity: null,
  statCashableCreditsExcludeVat: null,
  statNonCashableCreditsExcludeVat: null,
  statMileageExcludeVat: confirmedDataNode.mileageExcludeVat,
  statTotalPriceExcludeVat: confirmedDataNode.totalPriceExcludeVat,
  statRcoinsExcludeVat: confirmedDataNode.rcoinsExcludeVat,
  statBrandPayingChargeExcludeVat: confirmedDataNode.brandPayingChargeExcludeVat,
  statBrandDeliveryFee: confirmedDataNode.brandDeliveryFee,
  statReturnDeliveryFee: confirmedDataNode.returnDeliveryFee,
  statBrandCostPriceExcludeVat: confirmedDataNode.brandCostPriceExcludeVat,
  statBrandCostPriceExcludeVatOnlyFbv: null,
  statBrandCostPriceIncludeVatOnlyFbv: null,
  statB2bDeliveryFeeExcludeVat: null,
});

interface DownloadHqStatsOrderProps {
  dataSource: BrandOrderStats_brandOrderStats[];
  brand: User_brand;
  dateType: statsDateType;
  duration: Moment[];
  valueTypes: statsValueType[];
}

export const handleClickExcelDownloadForHqStatsOrder = (props: DownloadHqStatsOrderProps) => {
  const { brand, dateType, valueTypes } = props;
  try {
    const { rows, colsInfo, header, merges } = parseBrandOrderStatsForPrint(props);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const isFulfilledByVendor = valueTypes.includes(statsValueType.BRAND_COST_PRICE_ONLY_FBV);
    const dateTypeTitle =
      dateType === statsDateType.DAILY ? "일별" : dateType === statsDateType.WEEKLY ? "주별" : "월별";
    const excelTitle = `${brand?.name} ${dateTypeTitle} 브랜드 총 판매 현황(${transformIsFBVForHq(
      isFulfilledByVendor
    )} 상품)`;
    excelDownload({ title: excelTitle, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const brandOrderStatsKeysToMerge = {
  order: `[전체 주문]`,
  mileage: "[본부수익금]",
  isFulfilledByVendor: `[${transformIsFBVForHq(true)} 상품 매입금]`,
};

// parseMileageSettlementListForHq과 거의 유사하다.
const parseBrandOrderStatsForPrint = (props: DownloadHqStatsOrderProps) => {
  const { dataSource, brand, dateType, duration, valueTypes } = props;
  const brandContractType = brand?.contractType;

  const rows = [];
  const dataSourceIncludingEmpty = getOrderStatsForTable(dateType, duration, dataSource);

  dataSourceIncludingEmpty.forEach((data) => {
    const row = {};
    // 구분
    let statDate: any;
    switch (dateType) {
      case statsDateType.DAILY:
        statDate = data.statDate;
        break;
      case statsDateType.WEEKLY:
        const afterWave = moment().isBefore(moment(data.statDate).add("6", "d"))
          ? moment()
          : moment(data.statDate).add("6", "d");
        statDate = `${moment(data.statDate).format(onlyDateFormat)} ~ ${afterWave.format(onlyDateFormat)}`;
        break;
      case statsDateType.MONTHLY:
        statDate = moment(data.statDate).format(onlyMonthFormat);
        break;
      default:
        statDate = moment(data.statDate).format(onlyMonthFormat);
        break;
    }

    row["일자"] = statDate;

    if (valueTypes.includes(statsValueType.BRAND_COST_PRICE_ONLY_FBV)) {
      // 직거래 상품에 대한 총 판매 현황 다운로드
      // [직거래 상품 매입금]
      const statBrandCostPriceExcludeVatOnlyFbv = data.statBrandCostPriceExcludeVatOnlyFbv;
      const statBrandCostPriceVatOnlyFbv =
        data.statBrandCostPriceIncludeVatOnlyFbv - data.statBrandCostPriceExcludeVatOnlyFbv;
      const statBrandCostPriceIncludeVatOnlyFbv = data.statBrandCostPriceIncludeVatOnlyFbv;

      row[brandOrderStatsKeysToMerge.isFulfilledByVendor + "\n공급가액"] = statBrandCostPriceExcludeVatOnlyFbv;
      row[brandOrderStatsKeysToMerge.isFulfilledByVendor + "\n세액"] = statBrandCostPriceVatOnlyFbv;
      row[brandOrderStatsKeysToMerge.isFulfilledByVendor + "\n합계금액"] = statBrandCostPriceIncludeVatOnlyFbv;
    } else {
      // 보스 상품에 대한 총 판매 현황 다운로드
      // [전체 주문]
      const statTotalPriceExcludeVat = data.statTotalPriceExcludeVat;
      const statRcoinsExcludeVat = data.statRcoinsExcludeVat;
      const statBrandCostPriceExcludeVat = data.statBrandCostPriceExcludeVat;
      const statReturnDeliveryFeeExcludeVat = toPriceExcludeVat(data.statReturnDeliveryFee);
      const statBrandDeliveryFeeExcludeVat = toPriceExcludeVat(data.statBrandDeliveryFee);
      const statBrandPayingChargeExcludeVat = data.statBrandPayingChargeExcludeVat;

      row[brandOrderStatsKeysToMerge.order + "\n매출\n" + commonMsg.excludeVat] = statTotalPriceExcludeVat;
      row[brandOrderStatsKeysToMerge.order + "\n사용 포인트\n" + commonMsg.excludeVat] = statRcoinsExcludeVat;
      row[brandOrderStatsKeysToMerge.order + "\n매입\n" + commonMsg.excludeVat] = statBrandCostPriceExcludeVat;
      row[brandOrderStatsKeysToMerge.order + "\n반품배송비\n" + commonMsg.excludeVat] = statReturnDeliveryFeeExcludeVat;
      if (brandContractType === BrandContractTypeEnum.MILEAGE) {
        row[brandOrderStatsKeysToMerge.order + "\n배송비\n" + commonMsg.excludeVat] = statBrandDeliveryFeeExcludeVat;
        row[brandOrderStatsKeysToMerge.order + "\nPG결제수수료\n" + commonMsg.excludeVat] =
          statBrandPayingChargeExcludeVat;
      }

      // [본부수익금]
      // 현재 페이지에 조회된 그래프, 테이블의 valueTypes에 본부수익금이 포함된 경우에만 컬럼 추가
      if (valueTypes.includes(statsValueType.MILEAGE)) {
        const statMileageExcludeVat = data.statMileageExcludeVat;
        const statMileageVat = calcVatByPriceExcludeVat(data.statMileageExcludeVat);
        const statMileageIncludeVat = data.statMileageExcludeVat + calcVatByPriceExcludeVat(data.statMileageExcludeVat);

        row[brandOrderStatsKeysToMerge.mileage + "\n공급가액"] = statMileageExcludeVat;
        row[brandOrderStatsKeysToMerge.mileage + "\n세액"] = statMileageVat;
        row[brandOrderStatsKeysToMerge.mileage + "\n합계금액"] = statMileageIncludeVat;
      }
    }

    rows.push(row);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

export const makeOrderDateElement = (
  targetDate: any,
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[]
): BrandOrderStats_brandOrderStats => {
  const statsOrderElement = parsedBrandOrderStats.find((stats) => stats.statDate === targetDate);
  if (statsOrderElement) {
    return utils.deepCopy(statsOrderElement);
  }

  return {
    statDate: targetDate,
    statOrderCount: null,
    statQuantity: null,
    statTotalPriceExcludeVat: null,
    statCashableCreditsExcludeVat: null,
    statNonCashableCreditsExcludeVat: null,
    statRcoinsExcludeVat: null,
    statReturnDeliveryFee: null,
    statBrandCostPriceExcludeVat: null,
    statBrandDeliveryFee: null,
    statBrandPayingChargeExcludeVat: null,
    statMileageExcludeVat: null,
    statBrandCostPriceExcludeVatOnlyFbv: null,
    statBrandCostPriceIncludeVatOnlyFbv: null,
    statB2bDeliveryFeeExcludeVat: null,
    __typename: "BrandOrderStats",
  };
};

export const calcSumOfTotalPriceSupply = (parsedBrandOrderStats: BrandOrderStats_brandOrderStats[]) =>
  parsedBrandOrderStats.reduce((sum, stats) => sum + stats.statTotalPriceExcludeVat, 0);

export const calcSumOfStatMileageExcludeVat = (parsedBrandOrderStats: BrandOrderStats_brandOrderStats[]) =>
  parsedBrandOrderStats.reduce((sum, stats) => sum + stats.statMileageExcludeVat, 0);

export const calcSumOfOrderCount = (parsedBrandOrderStats: BrandOrderStats_brandOrderStats[]) =>
  parsedBrandOrderStats.reduce((sum, stats) => sum + stats.statOrderCount, 0);

export const calcSumOfStatBrandCostPriceExcludeVatOnlyFbv = (
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[]
) => parsedBrandOrderStats.reduce((sum, stats) => sum + stats.statBrandCostPriceExcludeVatOnlyFbv, 0);

export function getOrderStatsForTable(
  dateType: statsDateType,
  duration: Moment[],
  parsedOrderStats: BrandOrderStats_brandOrderStats[]
): BrandOrderStats_brandOrderStats[] {
  const dateMoment = moment(duration[0]);
  const durationDiff =
    (dateType === statsDateType.DAILY
      ? duration[1].diff(duration[0], "days")
      : dateType === statsDateType.WEEKLY
      ? duration[1].diff(duration[0], "weeks")
      : duration[1].diff(duration[0], "months")) + 1;
  const dataForTable = [];

  for (let i = 0; i < durationDiff; i++) {
    const targetDate = dateMoment.format(onlyDateFormat);
    const dataElement = makeOrderDateElement(targetDate, parsedOrderStats);

    dataForTable.push(dataElement);
    switch (dateType) {
      case statsDateType.DAILY:
        dateMoment.add(1, "d");
        break;
      case statsDateType.WEEKLY:
        dateMoment.add(1, "w");
        break;
      case statsDateType.MONTHLY:
        dateMoment.add(1, "M");
        break;
    }
  }

  return dataForTable;
}

export const getProfitRatio = (statMileageExcludeVat: number, statTotalPriceExcludeVat: number) => {
  const dividedByZero = statTotalPriceExcludeVat === 0;
  return dividedByZero ? 0 : parseFloat(((statMileageExcludeVat / statTotalPriceExcludeVat) * 100).toFixed(1));
};
</file>

