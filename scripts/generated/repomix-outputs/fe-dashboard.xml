import {
  BrandContractTypeEnum,
  CategoryKindEnum,
  PoEventTypeEnum,
  SalesStatusEnum,
  VendorContactTypeEnum,
} from "@src/api/types/globalTypes";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { getDefaultGteLteVariablesForMonth } from "@utils/filters";
import { utils } from "@utils/utils";
import moment from "moment";

import { SalesStatList_salesStats } from "./api/types/SalesStatList";
import {
  PurchasesStatByVendorListViewUrlQueryParams,
  RiuMinusProfitBpvListViewUrlQueryParams,
  SalesStatByProductDiffListViewUrlQueryParams,
  SalesStatByProductForBrandListViewUrlQueryParams,
  SalesStatByProductListViewUrlQueryParams,
  SalesStatDiffListViewUrlQueryParams,
  SalesStatListViewUrlQueryParams,
} from "./urls";
import { SalesStatShowColumnType } from "./views/SalesStatListView/filters";

export interface ExtendedSalesStatList_salesStats extends SalesStatList_salesStats {
  brandContractType?: BrandContractTypeEnum;
}

// 매출 총이익
export const calcStatTotalRevenueExcludeVat = (
  stat: SalesStatList_salesStats,
  brandContractType?: BrandContractTypeEnum
) => {
  if (utils.isEmpty(stat)) {
    return null;
  }
  const { statTotalPriceExcludeVat, statCostPriceExcludeVat, statTotalBrandCostPriceExcludeVat } = stat;

  // brandContractType이 없는 경우 (합계 계산 시) statTotalPriceExcludeVat를 그대로 사용
  // 이미 getSalesStatsSum에서 적절한 값으로 합산되었기 때문
  const isBrandContractTypeReverseFee = brandContractType === BrandContractTypeEnum.REVERSE_FEE;
  const statTotalPriceExcludeVatAdjusted = brandContractType
    ? isBrandContractTypeReverseFee
      ? statTotalBrandCostPriceExcludeVat || 0
      : statTotalPriceExcludeVat || 0
    : statTotalPriceExcludeVat || 0;

  const statTotalRevenueExcludeVat = statTotalPriceExcludeVatAdjusted - (statCostPriceExcludeVat || 0);
  return statTotalRevenueExcludeVat;
};

// 총이익
export const calcStatRevenueExcludeVat = (
  stat: SalesStatList_salesStats,
  brandContractType?: BrandContractTypeEnum
) => {
  if (utils.isEmpty(stat)) {
    return null;
  }
  const statRevenueExcludeVat =
    calcStatTotalRevenueExcludeVat(stat, brandContractType) -
    toPriceExcludeVat(stat?.statDeliveryFee) -
    (stat?.statPayingChargeExcludeVat || 0);
  return statRevenueExcludeVat;
};

// 당사 수익
export const calcStatCompanyRevenueExcludeVat = (stat: SalesStatList_salesStats) => {
  if (utils.isEmpty(stat)) {
    return null;
  }
  const {
    statTotalPriceExcludeVat,
    statCostPriceExcludeVat,
    statDeliveryFee,
    statPayingChargeExcludeVat,
    statMileageExcludeVat,
  } = stat;
  const statDeliveryFeeExcludeVat = toPriceExcludeVat(statDeliveryFee);
  const statCompanyRevenueExcludeVat =
    statTotalPriceExcludeVat -
    statCostPriceExcludeVat -
    statDeliveryFeeExcludeVat -
    statPayingChargeExcludeVat -
    statMileageExcludeVat;
  return statCompanyRevenueExcludeVat;
};

export type TSalesStatCategory =
  | "total"
  | "exclusive"
  | "packaging"
  | "food"
  | "equipment"
  | "totalA"
  | "totalB"
  | "diff";

// 실적 A와 실적 B의 숫자 필드 값 차이 계산
export const getSalesStatsDiff = (
  statA: SalesStatList_salesStats,
  statB: SalesStatList_salesStats
): SalesStatList_salesStats => {
  if (utils.isEmpty(statA)) {
    return null;
  }
  const copiedStatA = { ...statA };
  if (utils.isEmpty(statB)) {
    return copiedStatA;
  }

  const statDiff = Object.keys(statA).reduce((resultStat, key) => {
    const resultValue = resultStat[key];
    if (typeof resultValue === "number") {
      const statBValue = statB[key];
      if (utils.allEmpty([resultValue, statBValue], true)) {
        resultStat[key] = null;
      } else {
        resultStat[key] = resultValue - statBValue;
      }
    }
    return resultStat;
  }, copiedStatA);
  return statDiff;
};

// 실적 데이터 내 숫자 필드 값 합산
export const getSalesStatsSum = (stats: ExtendedSalesStatList_salesStats[]): ExtendedSalesStatList_salesStats => {
  const filteredStats = stats.filter((stat) => !utils.isEmpty(stat));
  if (utils.isEmpty(filteredStats) || filteredStats.length === 0) {
    return null;
  }

  // 합계를 위한 초기 객체 생성 (brandContractType 없이)
  const initialSum: ExtendedSalesStatList_salesStats = {
    ...filteredStats[0],
    brandContractType: undefined, // 합계에서는 brandContractType을 제거
  };

  // 모든 숫자 필드를 0으로 초기화
  Object.keys(initialSum).forEach((key) => {
    if (typeof initialSum[key] === "number") {
      initialSum[key] = 0;
    }
  });

  // 모든 stats를 순회하며 합산
  const statSum = filteredStats.reduce((resultStat, statToSum) => {
    Object.entries(statToSum).forEach(([key, value]) => {
      if (typeof value === "number" && key !== "brandContractType") {
        const resultValue = resultStat[key] || 0;

        if (key === "statTotalPriceExcludeVat") {
          // 각 stat의 brandContractType에 따라 적절한 값을 더함
          const valueToAdd =
            statToSum.brandContractType === BrandContractTypeEnum.REVERSE_FEE
              ? statToSum.statTotalBrandCostPriceExcludeVat || 0
              : value || 0;
          resultStat[key] = resultValue + valueToAdd;
        } else {
          resultStat[key] = resultValue + (value || 0);
        }
      }
    });
    return resultStat;
  }, initialSum);

  return statSum;
};

