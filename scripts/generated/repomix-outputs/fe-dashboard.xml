<file path="src/app/components/TextWithLink.tsx">
import { utils } from "@utils/utils";
import { Tooltip, Typography } from "antd";
import isUrl from "is-url";
import React from "react";

interface TextWithLinkProps {
  text: string;
  width?: number;
}

export const TextWithLink: React.FC<TextWithLinkProps> = ({ text, width = 200 }) => {
  if (utils.isEmpty(text, true)) {
    return <>-</>;
  }

  // 줄바꿈 기준으로 텍스트 분리
  const lines = text.split("\n");
  return (
    <div style={{ whiteSpace: "pre-line" }}>
      {lines.map((line, lineIndex) => {
        const parts = line.split(/\s+/);

        return (
          <React.Fragment key={lineIndex}>
            {parts.map((part, partIndex) => (
              <React.Fragment key={partIndex}>
                {isUrl(part) ? (
                  <Tooltip title={part}>
                    <Typography.Link key={partIndex} ellipsis style={{ width }} href={part} target="_blank">
                      {part}
                    </Typography.Link>
                  </Tooltip>
                ) : (
                  <span key={partIndex}>{part} </span>
                )}
                {partIndex < parts.length - 1 && " "}
              </React.Fragment>
            ))}
            {lineIndex < lines.length - 1 && <br />}
          </React.Fragment>
        );
      })}
    </div>
  );
};
</file>

<file path="src/app/components/TransferTable.tsx">
import { DownOutlined, UpOutlined } from "@ant-design/icons";
import { FetchMoreProps, Node } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Col, Empty, Row, Space, Typography } from "antd";
import { ColumnsType, TableProps } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { PatchedColumnsTable } from "./antd/Table/PatchedColumnsTable";
import { commonTableProps } from "./antd/Table/TableProps";
import TableVatLegend, { TableVatLegendProps } from "./TableVat/TableVatLegend";

interface UnitTableProps {
  title?: string;
  emptyText?: string;
  scrollY?: number;
}

interface TransferTableProps<T extends Node> {
  loading: boolean;
  columns: ColumnsType<T>;
  dataSource: T[];
  fetchMore?: FetchMoreProps;
  tableLegendProps?: {
    show: boolean;
  } & TableVatLegendProps;
  upperTableProps?: UnitTableProps;
  lowerTableProps?: UnitTableProps;
  preserveSubmitData?: boolean;
  onChange: (dataSourceToSubmit: T[]) => void;
}

const defaultSourceTableScrollY = 250;
const defaultSelectedTableScrollY = 200;

export const TransferTable = <T extends Node>(props: TransferTableProps<T>): React.ReactElement => {
  const {
    loading,
    columns,
    dataSource = [],
    fetchMore,
    tableLegendProps,
    upperTableProps,
    lowerTableProps,
    preserveSubmitData = false,
    onChange,
  } = props;

  const [dataSourceToAdd, setDataSourceToAdd] = useState<T[]>([]);
  const [dataSourceToRemove, setDataSourceToRemove] = useState<T[]>([]);
  const [dataSourceToSubmit, setDataSourceToSubmit] = useState<T[]>([]);

  const onDataSourceToSubmitChange = (dataSource: T[]) => {
    setDataSourceToSubmit(dataSource);
    onChange(dataSource);
  };

  useEffect(() => {
    if (preserveSubmitData === false) {
      onDataSourceToSubmitChange([]);
    }
  }, [loading]);

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelectionToAdd: TableRowSelection<T> = {
    fixed: true,
    selectedRowKeys: dataSourceToAdd.map((data) => data.id),
    onChange: (_selectedRowKeys, selectedRows) => setDataSourceToAdd(selectedRows),
  };
  const rowSelectionToRemove: TableRowSelection<T> = {
    fixed: true,
    selectedRowKeys: dataSourceToRemove.map((data) => data.id),
    onChange: (_selectedRowKeys, selectedRows) => setDataSourceToRemove(selectedRows),
  };

  const getDataEmptyText = (description: string) => (
    <Space size={0} direction={"vertical"}>
      <>데이터 없음</>
      {!utils.isEmpty(description, true) && <Typography.Text type={"warning"}>{description}</Typography.Text>}
    </Space>
  );
  const emptyToAdd = (
    <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={getDataEmptyText(upperTableProps?.emptyText)} />
  );
  const emptyToSubmit = (
    <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={getDataEmptyText(lowerTableProps?.emptyText)} />
  );

  const convertedUpperTableProps: TableProps<T> = {
    title: upperTableProps?.title ? () => <Typography.Text strong>{upperTableProps.title}</Typography.Text> : undefined,
    locale: { emptyText: emptyToAdd },
    scroll: {
      x: tableWidthSum,
      y: utils.isEmpty(upperTableProps?.scrollY) ? defaultSourceTableScrollY : upperTableProps.scrollY,
    },
  };
  const convertedLowerTableProps: TableProps<T> = {
    title: lowerTableProps?.title ? () => <Typography.Text strong>{lowerTableProps.title}</Typography.Text> : undefined,
    locale: { emptyText: emptyToSubmit },
    scroll: {
      x: tableWidthSum,
      y: utils.isEmpty(lowerTableProps?.scrollY) ? defaultSelectedTableScrollY : lowerTableProps.scrollY,
    },
  };

  const makeActionButtons = () => (
    <Row justify="center" gutter={12}>
      <Col>
        <Button
          icon={<DownOutlined />}
          type="default"
          disabled={dataSourceToAdd.length === 0}
          onClick={() =>
            setDataSourceToAdd((prev) => {
              const newDataSourceToSubmit = [...dataSourceToSubmit, ...prev];
              onDataSourceToSubmitChange(newDataSourceToSubmit);
              return [];
            })
          }
        >
          추가
        </Button>
      </Col>
      <Col>
        <Button
          icon={<UpOutlined />}
          type="default"
          disabled={dataSourceToRemove.length === 0}
          onClick={() => {
            setDataSourceToRemove((prev) => {
              const newDataSourceToSubmit = dataSourceToSubmit.filter(
                (data) => prev.some((dataToRemove) => dataToRemove.id === data.id) === false
              );
              onDataSourceToSubmitChange(newDataSourceToSubmit);
              return [];
            });
          }}
        >
          삭제
        </Button>
      </Col>
    </Row>
  );

  return (
    <Space direction="vertical">
      {tableLegendProps?.show && <TableVatLegend {...tableLegendProps} />}
      <PatchedColumnsTable
        {...commonTableProps}
        {...convertedUpperTableProps}
        tableLayout="fixed"
        loading={loading || fetchMore?.loading}
        columns={columns}
        dataSource={dataSource.filter(
          (row) => dataSourceToSubmit.some((rowToSubmit) => rowToSubmit.id === row.id) === false
        )}
        rowSelection={rowSelectionToAdd}
        footer={
          !!fetchMore &&
          fetchMore.hasMore &&
          (() => (
            <Row justify="center">
              <Typography.Link onClick={fetchMore.onFetchMore}>더 보기</Typography.Link>
            </Row>
          ))
        }
      />
      {makeActionButtons()}
      <PatchedColumnsTable
        {...commonTableProps}
        {...convertedLowerTableProps}
        tableLayout="fixed"
        columns={columns}
        dataSource={dataSourceToSubmit}
        rowSelection={rowSelectionToRemove}
      />
    </Space>
  );
};
</file>

<file path="src/app/components/UploadFiles.tsx">
import { PlusOutlined, UploadOutlined } from "@ant-design/icons";
import { Button, Space, Typography, Upload, UploadFile } from "antd";
import TextArea from "antd/lib/input/TextArea";
import { RcFile, ShowUploadListInterface } from "antd/lib/upload/interface";
import React, { ReactNode } from "react";

export interface DeleteFileType {
  id: string;
}
export interface UpdateFileDescType {
  id: string;
  description: string;
}

export interface UploadFileListType {
  addFileList: Array<UploadFile<any>>;
  addDescList: string[];
  updateDescList: UpdateFileDescType[];
  deleteFileList: DeleteFileType[];
}

export interface UploadFileControlType extends UploadFileListType {
  addFileList: Array<UploadFile<any>>;
  addDescList: string[];
  updateDescList: UpdateFileDescType[];
  deleteFileList: DeleteFileType[];
  setAddFileList: React.Dispatch<React.SetStateAction<Array<UploadFile<any>>>>;
  setAddDescList: React.Dispatch<React.SetStateAction<string[]>>;
  setUpdateDescList: React.Dispatch<React.SetStateAction<UpdateFileDescType[]>>;
  setDeleteFileList: React.Dispatch<React.SetStateAction<DeleteFileType[]>>;
}

export interface FileInfoSectionType extends UploadFileControlType {
  labelText: string;
  maxFileCount: number;
  helpText1?: string;
  helpText2?: string;
  fileList: Array<UploadFile<any>>;
  descList: string[];
  setFileList: React.Dispatch<React.SetStateAction<Array<UploadFile<any>>>>;
  setDescList: React.Dispatch<React.SetStateAction<string[]>>;
  setPreviewOpen: React.Dispatch<React.SetStateAction<boolean>>;
  setPreviewImage: React.Dispatch<React.SetStateAction<string>>;
  setPreviewTitle: React.Dispatch<React.SetStateAction<string>>;
}

export const makeInitFileList = (files) => {
  const fileList = [];
  if (!files || files.length <= 0) {
    return fileList;
  }

  const length = files.length;
  for (let i = 0; i < length; i++) {
    const file = files[i];
    const name = file.description || file.fileName;
    const uploadFile: UploadFile = {
      uid: file.id,
      name,
      status: "done",
      url: file.url,
    };
    fileList.push(uploadFile);
  }

  return fileList;
};

export const makeInitDescList = (files) => {
  const fileDescList = [];
  if (!files || files.length <= 0) {
    return fileDescList;
  }

  const length = files.length;
  for (let i = 0; i < length; i++) {
    const file = files[i];
    fileDescList.push(file.description);
  }

  return fileDescList;
};

export const getBase64 = (file: RcFile): Promise<string> =>
  new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => resolve(reader.result as string);
    reader.onerror = (error) => reject(error);
  });

const handleChangeFileDescList = (e, index: number, fileInfo: FileInfoSectionType) => {
  const {
    fileList,
    descList,
    setDescList,
    addFileList,
    addDescList,
    updateDescList,
    setAddDescList,
    setUpdateDescList,
  } = fileInfo;
  const fileDesc = e.target.value;
  if (fileList && fileList.length > index) {
    const file = fileList[index];
    const isAlreadyUploadedFile = !!file?.url;
    if (isAlreadyUploadedFile) {
      const newUpdateDescList = [...updateDescList];
      const targetUpdateDesc = newUpdateDescList.find((updateDesc) => updateDesc.id === file.uid);
      if (targetUpdateDesc) {
        targetUpdateDesc.description = fileDesc;
      } else {
        const newUpdateDesc: UpdateFileDescType = {
          id: file.uid,
          description: fileDesc,
        };
        newUpdateDescList.push(newUpdateDesc);
      }
      setUpdateDescList(newUpdateDescList);
    } else {
      const targetAddDescIndex = addFileList.findIndex((addFile) => addFile.uid === file.uid);
      const newAddDescList = [...addDescList];
      newAddDescList[targetAddDescIndex] = fileDesc;
      setAddDescList(newAddDescList);
    }
  }

  const newFileDescList = [...descList];
  newFileDescList[index] = fileDesc;
  setDescList(newFileDescList);
};

const handleFileUploadChange = ({ fileList: newFileList }, fileInfo: FileInfoSectionType) => {
  const { descList, setFileList, setAddFileList, setAddDescList } = fileInfo;
  const newAddFileList = [];
  const newAddDescList = [];
  const length = newFileList.length;
  for (let i = 0; i < length; i++) {
    const file = newFileList[i];
    const isAlreadyUploadedFile = !!file?.url;
    if (!isAlreadyUploadedFile) {
      const fileDesc = descList[i];
      newAddFileList.push(file);
      newAddDescList.push(fileDesc);
    }
  }
  setAddFileList(newAddFileList);
  setAddDescList(newAddDescList);
  setFileList(newFileList);
};

const handleFileRemove = (file, fileInfo: FileInfoSectionType) => {
  const { fileList, descList, deleteFileList, setDeleteFileList, setDescList } = fileInfo;

  if (!deleteFileList || !setDeleteFileList) {
    return;
  }

  const isAlreadyUploadedFile = !!file.url;
  if (isAlreadyUploadedFile) {
    const newDeleteFileList = [...deleteFileList];
    const deleteFile: DeleteFileType = {
      id: file.uid,
    };
    newDeleteFileList.push(deleteFile);
    setDeleteFileList(newDeleteFileList);
  }
  const index = fileList.findIndex((file) => file.uid === file.uid);
  if (index >= 0) {
    const newFileDescList = [...descList];
    newFileDescList.splice(index, 1);
    setDescList(newFileDescList);
  }
};

const handlePreview = async (file: UploadFile, fileInfo: FileInfoSectionType) => {
  const { setPreviewImage, setPreviewOpen, setPreviewTitle } = fileInfo;

  if (!setPreviewImage || !setPreviewOpen || !setPreviewTitle) {
    return;
  }

  if (!file.url && !file.preview) {
    file.preview = await getBase64(file.originFileObj as RcFile);
  }

  setPreviewImage(file.url || (file.preview as string));
  setPreviewOpen(true);
  setPreviewTitle(file.name || file.url!.substring(file.url!.lastIndexOf("/") + 1));
};

export const makeFileDescUis = (fileInfo: FileInfoSectionType) => {
  const { labelText, fileList, descList } = fileInfo;

  const uis = [];
  const length = fileList.length;
  for (let index = 0; index < length && index < 3; index++) {
    const ui = (
      <Space direction="vertical" key={index}>
        <Typography.Text>
          {labelText} 설명 {index + 1}
        </Typography.Text>
        <TextArea value={descList[index]} onChange={(e) => handleChangeFileDescList(e, index, fileInfo)} />
      </Space>
    );
    uis.push(ui);
  }
  return uis;
};

export const plusOutlinedUploadButton = (uploadButtonText: string) => (
  <div>
    <PlusOutlined />
    <div style={{ marginTop: 8 }}>{uploadButtonText}</div>
  </div>
);

export const iconOutlinedUploadButton = (uploadButtonText: string) => (
  <Button icon={<UploadOutlined />}>{uploadButtonText}</Button>
);

export const makeFileInfoSectionUis = (
  fileInfo: FileInfoSectionType,
  uploadButton: ReactNode,
  showUploadList: ShowUploadListInterface,
  listType: "picture-card" | "picture" | "text" = "picture-card"
) => {
  const { maxFileCount, fileList } = fileInfo;

  return (
    <>
      <Space direction="vertical">
        <Upload
          listType={listType}
          fileList={fileList}
          showUploadList={showUploadList}
          onChange={(info) => handleFileUploadChange(info, fileInfo)}
          onRemove={(file) => handleFileRemove(file, fileInfo)}
          onPreview={(file) => handlePreview(file, fileInfo)}
          beforeUpload={
            () => false // 파일 선택시 바로 업로드 하지 않고 후에 한꺼번에 전송하기 위함
          }
        >
          {fileList.length >= maxFileCount ? null : uploadButton}
        </Upload>
        {makeFileDescUis(fileInfo)}
      </Space>
    </>
  );
};

export const makeFileUploadSectionLabelNode = (fileInfo: FileInfoSectionType) => {
  const { labelText, maxFileCount } = fileInfo;

  return (
    <Space>
      {labelText}
      {<Typography.Text type="warning">(최대 {maxFileCount}개)</Typography.Text>}
    </Space>
  );
};
</file>

