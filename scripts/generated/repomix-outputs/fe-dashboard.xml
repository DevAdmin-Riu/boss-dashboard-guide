import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { User } from "@src/api/fragments/types/User";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React from "react";

import {
  BrandStoreConsultationList,
  BrandStoreConsultationList_brandStoreConsultationList_edges_node,
  BrandStoreConsultationListVariables,
} from "../../api/types/BrandStoreConsultationList";
import { getBrandStoreConsultationListTableSettings } from "./BrandStoreConsultationListTableSettings";
import {
  BrandStoreConsultationListFilterKeys,
  BrandStoreConsultationListFilterOpts,
  createFilterStructure,
} from "./filters";

export interface BrandStoreConsultationListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandStoreConsultationListFilterKeys, BrandStoreConsultationListFilterOpts> {
  user: User;
  brandStoreConsultationList: BrandStoreConsultationList_brandStoreConsultationList_edges_node[];

  queryVariablesWithoutPagination: BrandStoreConsultationListVariables;
  fetchForDownload: (
    variables?: BrandStoreConsultationListVariables
  ) => Promise<ApolloQueryResult<BrandStoreConsultationList>>;
  onShowDetailRecord: (record: BrandStoreConsultationList_brandStoreConsultationList_edges_node) => void;
  onCreate: () => void;
}

const BrandStoreConsultationListPage: React.FC<BrandStoreConsultationListPageProps> = (props) => {
  const {
    user,
    brandStoreConsultationList,
    currencySymbol,
    currentTab,
    filterOpts,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onCreate,
    ...listProps
  } = props;
  const isStaff = user.isStaff;
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const filterStructure = createFilterStructure(filterOpts, isStaff);
  const columns = getBrandStoreConsultationListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const pageTitle = sectionNames.brandStoreConsultationList;
  const pageExtra = (
    <Button type="primary" shape="round" onClick={onCreate}>
      상담내역 작성
    </Button>
  );

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "templateList",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
        {user.isHqStaff && (
          <Col>
            <Space direction="horizontal">{pageExtra}</Space>
          </Col>
        )}
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={brandStoreConsultationList}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};

export default BrandStoreConsultationListPage;
