import { OrderStatus, PaymentChargeStatusEnum } from "@src/api/types/globalTypes";
import { StatusType } from "@src/app/components/StatusLabel";

export interface IOrderForPaymentStatus {
  paymentStatus: PaymentChargeStatusEnum | null;
  status: OrderStatus | null;
}
export const transformPaymentStatus = (
  order?: IOrderForPaymentStatus
): {
  localized: string;
  status: StatusType;
} => {
  if (order?.status === OrderStatus.CANCELED) {
    return {
      localized: "주문 취소",
      status: "error",
    };
  }
  switch (order?.paymentStatus) {
    case PaymentChargeStatusEnum.PARTIALLY_CHARGED:
      return {
        localized: "결제 완료 - 부분결제",
        status: "neutral",
      };
    case PaymentChargeStatusEnum.FULLY_CHARGED:
      return {
        localized: "결제 완료",
        status: "success",
      };
    case PaymentChargeStatusEnum.PARTIALLY_REFUNDED:
      return {
        localized: "일부 환불",
        status: "neutral",
      };
    case PaymentChargeStatusEnum.FULLY_REFUNDED:
      return {
        localized: "전액 환불",
        status: "error",
      };
    case PaymentChargeStatusEnum.BEING_APPROVED:
      return {
        localized: "결제 증빙",
        status: "neutral",
      };
    default:
      return {
        localized: "결제 대기",
        status: "neutral",
      };
  }
};

export const transformOrderStatus = (
  status: OrderStatus,
  isFullyTracking: boolean,
  isFullyTrackingCompleted: boolean
): {
  localized: string;
  status: StatusType;
} => {
  switch (status) {
    case OrderStatus.FULFILLED:
      return {
        localized: isFullyTrackingCompleted ? "배송완료" : isFullyTracking ? "배송중" : "배송준비중",
        status: isFullyTracking ? "success" : "neutral",
      };
    case OrderStatus.PARTIALLY_FULFILLED:
      return {
        localized: "배송대기-부분출고",
        status: "neutral",
      };
    case OrderStatus.UNFULFILLED:
      return {
        localized: "배송대기",
        status: "error",
      };
    case OrderStatus.CANCELED:
      return {
        localized: "취소됨",
        status: "error",
      };
    default:
      return {
        localized: status,
        status: "error",
      };
  }
};
