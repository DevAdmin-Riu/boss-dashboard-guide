import { WatchQueryFetchPolicy } from "@apollo/client";
import { fetchPolicyForInitialListQuerySkip } from "@src/app/providers/ApolloClientProvider/ApolloClientProvider";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import { IRootState } from "@src/global/redux/config/configStore";
import { ListQuerySkipState } from "@src/global/redux/reducer/common.reducer";
import { listQuerySkipChange } from "@src/global/redux/store/common.store";
import { isBoolean } from "lodash";
import moment from "moment";
import { useEffect } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useLocation } from "react-router";

interface ISetListQuerySkipProps {
  updated?: boolean;
  key?: string;
  value: boolean;
}

export function useListQuerySkip(initial?: boolean): {
  skipState: ListQuerySkipState;
  forceFetchPolicy: WatchQueryFetchPolicy | undefined;
  setSkip: (props: ISetListQuerySkipProps) => void;
} {
  const dispatchRedux = useDispatch();
  const { pathname, search } = useLocation();
  const listQuerySkipState = useSelector<IRootState, ListQuerySkipState>(
    (state) => state.common.listQuerySkip[pathname]
  );
  const notInitializedSkip = listQuerySkipState === undefined;
  const isInitialSkip = isBoolean(initial) && initial === true;
  const forceFetchPolicy: WatchQueryFetchPolicy = isInitialSkip ? fetchPolicyForInitialListQuerySkip : undefined;
  const defaultSkipState: ListQuerySkipState = {
    initialValue: initial ?? false,
    value: initial ?? false,
    updatedAtBySearchStr: {},
  };

  const initializeSkipState = () => {
    // initial이 true이고, skipState가 아직 초기화되지 않은 경우에만 상태를 true로 초기화
    if (isInitialSkip && notInitializedSkip) {
      dispatchRedux(listQuerySkipChange({ key: pathname, skipState: defaultSkipState }));
    }
  };

  const setSkipState = (setSkipStateProps: ISetListQuerySkipProps) => {
    // skip 여부를 관리하지 않는 페이지(pathname)라면 값 자체를 변경하지 않음
    if (notInitializedSkip) {
      return;
    }
    const { updated = false, key = pathname, value } = setSkipStateProps;
    const newSkipState: ListQuerySkipState = {
      ...listQuerySkipState,
      updatedAtBySearchStr: {
        ...listQuerySkipState.updatedAtBySearchStr,
        ...(updated && { [search]: getDateByFormat(moment()) }),
      },
      value,
    };
    dispatchRedux(listQuerySkipChange({ key, skipState: newSkipState }));
  };

  useEffect(() => {
    initializeSkipState();
  }, [pathname]);

  return {
    skipState: listQuerySkipState ?? defaultSkipState,
    forceFetchPolicy,
    setSkip: setSkipState,
  };
}
</file>

