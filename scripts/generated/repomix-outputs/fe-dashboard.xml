import { WindowTitle } from "@src/app/components/WindowTitle";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import { findInEnum } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useShopSettingsUpdate } from "../api/mutations";
import { useSiteSettingsQuery } from "../api/queries";
import { ShopSettingsUpdate } from "../api/types/ShopSettingsUpdate";
import { MobileAppInfoCreateModal } from "../components/MobileAppInfoCreateModal";
import { MobileAppInfoDeleteModal } from "../components/MobileAppInfoDeleteModal";
import { MobileAppInfoUpdateModal } from "../components/MobileAppInfoUpdateModal";
import SiteSettingsPage, {
  areAddressInputFieldsModified,
  SiteSettingsPageFormData,
} from "../components/SiteSettingsPage";
import { siteSettingsViewUrl, SiteSettingsViewUrlDialog, SiteSettingsViewUrlQueryParams } from "../urls";

interface SiteSettingsViewProps {
  params: SiteSettingsViewUrlQueryParams;
}

export const SiteSettingsView: React.FC<SiteSettingsViewProps> = ({ params }) => {
  const navigate = useNavigator();

  const [openModal, closeModal] = createDialogActionHandlers<SiteSettingsViewUrlDialog, SiteSettingsViewUrlQueryParams>(
    navigate,
    siteSettingsViewUrl,
    params
  );

  const handleSiteSettingsSuccess = (data: ShopSettingsUpdate) => {
    if (
      data.shopDomainUpdate.errors.length === 0 &&
      data.shopSettingsUpdate.errors.length === 0 &&
      data.shopAddressUpdate.errors.length === 0
    ) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      {
        const errors = data.shopDomainUpdate.errors;
        if (errors.length !== 0) {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
      {
        const errors = data.shopSettingsUpdate.errors;
        if (errors.length !== 0) {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
      {
        const errors = data.shopAddressUpdate.errors;
        if (errors.length !== 0) {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    }
  };

  const [updateShopSettings, updateShopSettingsOpts] = useShopSettingsUpdate({
    onCompleted: handleSiteSettingsSuccess,
  });

  const handleBack = () => {
    navigate("/");
  };

  const { data: siteSettings, loading: siteSettingsLoading } = useSiteSettingsQuery({});

  const shop = siteSettings?.shop;
  if (shop === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  const formErrors = [
    ...(updateShopSettingsOpts.data?.shopDomainUpdate.errors || []),
    ...(updateShopSettingsOpts.data?.shopSettingsUpdate.errors || []),
    ...(updateShopSettingsOpts.data?.shopAddressUpdate.errors || []),
  ];
  const loading = siteSettingsLoading || updateShopSettingsOpts.loading;

  const handleUpdateShopSettings = async (data: SiteSettingsPageFormData) => {
    const addressInput = areAddressInputFieldsModified(data)
      ? {
          city: data.city,
          firstName: "사이트주소명",
          companyName: data.companyName,
          country: findInEnum(data.country, CountryCode),
          countryArea: data.countryArea,
          phone: data.phone,
          postalCode: data.postalCode,
          streetAddress1: data.streetAddress1,
          streetAddress2: data.streetAddress2,
        }
      : {
          firstName: "사이트주소명",
          companyName: data.companyName,
          streetAddress1: data.streetAddress1,
        };
    const result = await updateShopSettings({
      variables: {
        addressInput,
        shopDomainInput: {
          domain: data.domain,
          name: data.name,
        },
        shopSettingsInput: {
          customerSetPasswordUrl: data.customerSetPasswordUrl,
          description: data.description,
          dsMinimumOrderPrice: data.dsMinimumOrderPrice,
          directShippingAvailableEndDate: data.directShippingAvailableEndDate,
        },
      },
    });

    return [
      ...result.data.shopAddressUpdate.errors,
      ...result.data.shopDomainUpdate.errors,
      ...result.data.shopSettingsUpdate.errors,
    ];
  };

  return (
    <>
      <WindowTitle title="사이트 기본 정보" />
      <SiteSettingsPage
        disabled={loading}
        errors={formErrors}
        shop={shop}
        onModalOpen={openModal}
        onBack={() => navigate(configurationSectionUrl)}
        onSubmit={handleUpdateShopSettings}
        saveButtonBarState={updateShopSettingsOpts.status}
      />
      <MobileAppInfoCreateModal
        appInfoList={shop?.mobileAppInfo}
        open={params.action === "create-mobile-app-info"}
        onClose={closeModal}
      />
      <MobileAppInfoUpdateModal
        selectedAppInfoId={params?.id}
        appInfoList={shop?.mobileAppInfo}
        open={params.action === "update-mobile-app-info" && utils.isEmpty(params.id, true) === false}
        onClose={closeModal}
      />
      <MobileAppInfoDeleteModal
        selectedAppInfoId={params?.id}
        appInfoList={shop?.mobileAppInfo}
        open={params.action === "delete-mobile-app-info" && utils.isEmpty(params.id, true) === false}
        onClose={closeModal}
      />
    </>
  );
};
</file>

