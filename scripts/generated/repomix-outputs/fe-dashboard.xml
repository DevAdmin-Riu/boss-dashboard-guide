import { convertUploadValuesOfBaseProduct } from "../../reserveChange/components/ReserveChangeAddModal";
import {
  useProductBulkCreateMutation,
  useProductVariantBulkUpdateMutation,
  useProductVariantRegionPriceBulkUpdateOrCreateMutation,
  useProductVariantVendorBulkUpdateOrCreateMutation,
} from "../api/mutations";
import {
  fbvBrandProductVariantListQuery,
  productListQuery,
  useProductVariantListForUploadLazyQuery,
} from "../api/queries";
import { InitialProductFilterData_attributes_edges_node } from "../api/types/InitialProductFilterData";
import {
  AttributeSlugEnum,
  getCategoryLabel,
  getQtyPerBoxUnitTypeValue,
  getSalesUnitTypeValue,
  productVariantManageEventTypeChoices,
} from "../utils/data";
import { convertToDaysObject, convertUploadValuesToIncludeVat } from "./ProductListPage/utils";
import { makePvOrBpvManageEventFormItems } from "./PvOrBpvManageEventModal";

interface ProductVariantBulkUpdateOrCreateModalProps {
  open: boolean;
  loading: boolean;
  isFulfilledByVendor: boolean;
  attributes: InitialProductFilterData_attributes_edges_node[];
  onClose: () => void;
  fbvVendorsModalOpen?: () => void;
  allCountries: ShopInfo_shop_allCountries[];
  isB2bMode: boolean;
}

enum ProductVariantUpdateOrCreateModeEnum {
  CREATE_PRODUCT = "CREATE_PRODUCT",
  STOCK = "STOCK",
  BOX = "BOX",
  ATTRIBUTE = "ATTRIBUTE",
  PRICE = "PRICE",
  VENDOR = "VENDOR",
  BASE_SELL_PRICE = "BASE_SELL_PRICE",

  // 직거래 상품
  FBV_CREATE_PRODUCT = "FBV_CREATE_PRODUCT",
  FBV_STOCK = "FBV_STOCK",
  FBV_BOX = "FBV_BOX",
  FBV_ATTRIBUTE = "FBV_ATTRIBUTE",
  // 직거래 상품 협력사 정보 가맹본부의 수정 type
  HQ_FBV_VENDOR = "HQ_FBV_VENDOR",

  // B2B 상품
  B2B_CREATE_PRODUCT = "B2B_CREATE_PRODUCT",
  B2B_VENDOR = "B2B_VENDOR",
}

// FBV 상품 속성 변경 시 brandCode를 추가하기 위하여 확장,
// ProductVariantBulkUpdateDetail > bpvUpdateInput > brandCode
// 엑셀에는 단일 컬럼으로 추가하여 bpvUpdateInput에 넣어줄 수 있도록 함
export interface FbvProductVariantBulkUpdateDetail extends ProductVariantBulkUpdateDetail {
  brandCode?: string;
}

type TProductVariantDetail =
  | FbvProductVariantBulkUpdateDetail
  | ProductVariantRegionPriceBulkDetail
  | ProductVariantVendorBulkDetails
  | ProductBulkCreateDetail;

interface ProductVariantBulkUpdateOrCreateForm {
  // 양식 엑셀 파일 업로드 시점에 아래 값을 사용하여 양식이 올바른지 validate 시에 사용
  mode: ProductVariantUpdateOrCreateModeEnum;
  details: TProductVariantDetail[];
  manageEvent: ProductVariantManageEventInput;
  needReason: boolean;
}

// 모드에 따라 details의 타입이 달라지므로, 각 모드에 따른 details 타입을 체크하는 함수를 만들어 사용
const checkIsPVBulkUpdateDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is FbvProductVariantBulkUpdateDetail[] =>
  [
    ProductVariantUpdateOrCreateModeEnum.STOCK,
    ProductVariantUpdateOrCreateModeEnum.BOX,
    ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE,
    ProductVariantUpdateOrCreateModeEnum.BASE_SELL_PRICE,
    ProductVariantUpdateOrCreateModeEnum.FBV_STOCK,
    ProductVariantUpdateOrCreateModeEnum.FBV_BOX,
    ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE,
  ].includes(mode);

const checkIsAttributeModeDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is FbvProductVariantBulkUpdateDetail[] =>
  [ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE, ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE].includes(mode);

const checkIsPVRPriceBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductVariantRegionPriceBulkDetail[] => mode === ProductVariantUpdateOrCreateModeEnum.PRICE;

const checkIsPVVendorBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductVariantVendorBulkDetails[] => mode === ProductVariantUpdateOrCreateModeEnum.VENDOR;

const checkIsHqFbvPVVendorBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductVariantVendorBulkDetails[] => mode === ProductVariantUpdateOrCreateModeEnum.HQ_FBV_VENDOR;

const checkIsProductBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductBulkCreateDetail[] => mode === ProductVariantUpdateOrCreateModeEnum.CREATE_PRODUCT;

const checkIsFbvProductBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductBulkCreateDetail[] => mode === ProductVariantUpdateOrCreateModeEnum.FBV_CREATE_PRODUCT;

const checkIsB2bProductBulkDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductBulkCreateDetail[] => mode === ProductVariantUpdateOrCreateModeEnum.B2B_CREATE_PRODUCT;

const checkIsB2bVendorDetails = (
  details: TProductVariantDetail[],
  mode: ProductVariantUpdateOrCreateModeEnum
): details is ProductVariantVendorBulkDetails[] => mode === ProductVariantUpdateOrCreateModeEnum.B2B_VENDOR;

const transformPVUpdateOrCreateMode = (mode: ProductVariantUpdateOrCreateModeEnum) => {
  switch (mode) {
    case ProductVariantUpdateOrCreateModeEnum.STOCK:
    case ProductVariantUpdateOrCreateModeEnum.FBV_STOCK:
      return "재고정보";
    case ProductVariantUpdateOrCreateModeEnum.BOX:
    case ProductVariantUpdateOrCreateModeEnum.FBV_BOX:
      return "박스정보";
    case ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE:
    case ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE:
      return "제품속성";
    case ProductVariantUpdateOrCreateModeEnum.PRICE:
      return "공급원가";
    case ProductVariantUpdateOrCreateModeEnum.VENDOR:
    case ProductVariantUpdateOrCreateModeEnum.HQ_FBV_VENDOR:
      return "협력사정보";
    case ProductVariantUpdateOrCreateModeEnum.BASE_SELL_PRICE:
      return "기준판매가정보";
    case ProductVariantUpdateOrCreateModeEnum.B2B_CREATE_PRODUCT:
      return "B2B 제품일괄등록";
    case ProductVariantUpdateOrCreateModeEnum.B2B_VENDOR:
      return "B2B 협력사정보";
    default:
      return "";
  }
};

const getTargetTemplateVersionByModeWatched = (modeWatched: ProductVariantUpdateOrCreateModeEnum) => {
  switch (modeWatched) {
    case ProductVariantUpdateOrCreateModeEnum.STOCK:
      return excelTemplateVersion.setProductStock;
    case ProductVariantUpdateOrCreateModeEnum.FBV_STOCK:
      return excelTemplateVersion.setFbvProductStock;
    case ProductVariantUpdateOrCreateModeEnum.BOX:
      return excelTemplateVersion.setProductBox;
    case ProductVariantUpdateOrCreateModeEnum.FBV_BOX:
      return excelTemplateVersion.setFbvProductBox;
    case ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE:
      return excelTemplateVersion.setProductAttribute;
    case ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE:
      return excelTemplateVersion.setFbvProductAttribute;
    case ProductVariantUpdateOrCreateModeEnum.PRICE:
      return excelTemplateVersion.setProductPrice;
    case ProductVariantUpdateOrCreateModeEnum.VENDOR:
      return excelTemplateVersion.setProductVendor;
    case ProductVariantUpdateOrCreateModeEnum.HQ_FBV_VENDOR:
      return excelTemplateVersion.setHqFbvProductVendor;
    case ProductVariantUpdateOrCreateModeEnum.BASE_SELL_PRICE:
      return excelTemplateVersion.setProductBaseSellPrice;
    case ProductVariantUpdateOrCreateModeEnum.CREATE_PRODUCT:
      return excelTemplateVersion.createProduct;
    case ProductVariantUpdateOrCreateModeEnum.FBV_CREATE_PRODUCT:
      return excelTemplateVersion.createFbvProduct;
    case ProductVariantUpdateOrCreateModeEnum.B2B_CREATE_PRODUCT:
      return excelTemplateVersion.setB2bCreateProduct;
    case ProductVariantUpdateOrCreateModeEnum.B2B_VENDOR:
      return excelTemplateVersion.setB2bProductVendor;
    default:
      return null;
  }
};

export const ProductVariantBulkUpdateOrCreateModal: React.FC<ProductVariantBulkUpdateOrCreateModalProps> = (props) => {
  const { open, loading, isFulfilledByVendor, attributes, onClose, fbvVendorsModalOpen, allCountries, isB2bMode } =
    props;
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const staffTitle = isFulfilledByVendor ? "직거래 상품" : "제품정보";
  const upload = useRef<HTMLInputElement>();
  const handleUploadButtonClick = () => upload.current.click();
  const [selectedFile, setSelectedFile] = useState<string>();
  const [errorExist, setErrorExist] = useState<boolean>(false);

  const [productTypeNum, setProductTypeNum] = useState<string>();
  const [categoryNum, setCategoryNum] = useState<string>();

  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<ProductVariantBulkUpdateOrCreateForm>(form);
  const modeWatcher = TypeSafeForm.getUseWatcherParams({ name: "mode" });
  const modeWatched: ProductVariantUpdateOrCreateModeEnum = Form.useWatch(
    modeWatcher.namePath,
    modeWatcher.formInstance
  );
  const detailsWatcher = TypeSafeForm.getUseWatcherParams({ name: "details" });
  const detailsWatched = Form.useWatch(detailsWatcher.namePath, detailsWatcher.formInstance);
  const isModeSelected = !utils.isEmpty(modeWatched);

  const isCreateProductMode = modeWatched === ProductVariantUpdateOrCreateModeEnum.CREATE_PRODUCT;
  const isFbvCreateProductMode = modeWatched === ProductVariantUpdateOrCreateModeEnum.FBV_CREATE_PRODUCT;
  const isB2bCreateProductMode = modeWatched === ProductVariantUpdateOrCreateModeEnum.B2B_CREATE_PRODUCT;

  const [refetchForUpload] = useProductVariantListForUploadLazyQuery();

  const onModalClose = () => {
    form.resetFields();
    setErrorExist(false);
    setSelectedFile(undefined);
    onClose();
  };

  const handleSuccess = (errors) => {
    if (errors?.length === 0) {
      if (isCreateProductMode) {
        showNotificationSuccess("제품이 일괄 생성되었습니다.");
      } else if (isFbvCreateProductMode) {
        showNotificationSuccess(`${staffTitle}이 일괄 생성되었습니다.`);
      } else {
        showNotificationSuccess(`${transformPVUpdateOrCreateMode(modeWatched)} 정보가 일괄 수정되었습니다.`);
      }
      onModalClose();
    } else {
      showGqlErrors(errors, undefined, false);
    }
  };

  const refetchQueries = isFulfilledByVendor ? [fbvBrandProductVariantListQuery] : [productListQuery];

  const [productVariantBulkUpdate, productVariantBulkUpdateOpts] = useProductVariantBulkUpdateMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantBulkUpdate?.errors;
      handleSuccess(errors);
    },
    refetchQueries,
  });
  const [productVariantBulkUpdateOrCreate, productVariantBulkUpdateOrCreateOpts] =
    useProductVariantRegionPriceBulkUpdateOrCreateMutation({
      onCompleted: (data) => {
        const errors = data?.productVariantRegionPriceBulkUpdateOrCreate?.errors;
        handleSuccess(errors);
      },
      refetchQueries,
    });
  const [productVariantVendorBulkUpdateOrCreate, productVariantVendorBulkUpdateOrCreateOpts] =
    useProductVariantVendorBulkUpdateOrCreateMutation({
      onCompleted: (data) => {
        const errors = data?.productVariantVendorBulkUpdateOrCreate?.errors;
        handleSuccess(errors);
      },
      refetchQueries,
    });

  const [productBulkCreate, productBulkCreateOpts] = useProductBulkCreateMutation({
    onCompleted: (data) => {
      const errors = data?.productBulkCreate?.errors;
      handleSuccess(errors);
    },
    refetchQueries,
  });

  const modalLoading =
    loading ||
    productVariantBulkUpdateOpts.loading ||
    productVariantBulkUpdateOrCreateOpts.loading ||
    productVariantVendorBulkUpdateOrCreateOpts.loading ||
    productBulkCreateOpts.loading;

