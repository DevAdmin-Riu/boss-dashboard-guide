import { SettingOutlined, SwapOutlined } from "@ant-design/icons";
import { brandServiceTerm } from "@assets/messages/commonMsg";
import useDidMountEffect from "@hooks/useDidMountEffect";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { PermissionEnum } from "@src/api/types/globalTypes";
import { checkHasAnyPermissions } from "@src/app/views/auth/utils";
import { useBrandGroupForChangeBrandQuery } from "@src/app/views/brand/brands/api/queries";
import { useHqStaffBrandUpdateMutation } from "@src/app/views/hqStaff/hqHome/api/mutations";
import { IConfigurationMenuItem } from "@src/app/views/settings/configuration/ConfigurationView";
import {
  getCustomMenuItems,
  ICustomMenuItem,
} from "@src/app/views/settings/dashboardCustomMenu/components/DashboardCustomMenuPage/DashboardCustomMenuPage";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { IRootState } from "@src/global/redux/config/configStore";
import { MenuModeForHq } from "@src/global/redux/reducer/common.reducer";
import { menuModeForHqChange, menuModeForHqDelete } from "@src/global/redux/store/common.store";
import { checkHqStaff, checkIsEnableForLinkersServiceByUser, checkStaff, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Menu, MenuProps, Space, Tag } from "antd";
import { ItemType } from "antd/lib/menu/hooks/useItems";
import React, { useEffect, useMemo, useState } from "react";
import { useDispatch, useSelector } from "react-redux";
import { matchPath, useLocation } from "react-router";

import { configurationSectionUrl, createConfigurationMenu } from "../../views/settings/configuration";
import { getMenuClassName } from "../antd/Menu/MenuProps";
import { getTagClassName } from "../antd/Tag/TagProps";
import { hqToBossMallAriaLabel } from "./menuStructureHqStaff";
import { IMenuItem } from "./menuStructureStaff";

interface MenuListProps {
  menuItems: IMenuItem[];
  isMenuSmall: boolean;
  onMenuItemClick: (url: string, newTab: boolean) => void;
}

export const checkShowMenu = (
  isHqStaff: boolean,
  userPermissions: PermissionEnum[],
  menuItem: IMenuItem | IConfigurationMenuItem
) => {
  if (!!menuItem.hideCondition) {
    return false;
  }
  if (menuItem.permissions?.length > 0) {
    // super 유저에게 매장 상세 통계 메뉴 숨기기 위해 이렇게 처리
    // 추후 슈퍼 유저에게 매장별 통계 조회 기능 추가할때는 permission 만으로 노출 제어로 원복하면 됨.
    if (menuItem.permissions.includes(PermissionEnum.MANAGE_HQ_STAT)) {
      return isHqStaff;
    }

    // 메뉴 permissions 에 지정된 permission 중 하나라도 보유한 유저에게 메뉴 노출
    return checkHasAnyPermissions(menuItem.permissions, userPermissions);
  }
  return true;
};

const menuItemKeySplitStr = "__";

const convertMenuItemKey = (menuItem: Pick<IMenuItem, "ariaLabel" | "url">): string => {
  if (utils.isEmpty(menuItem?.url, true)) {
    return menuItem.ariaLabel;
  }
  return menuItem.ariaLabel + menuItemKeySplitStr + menuItem.url;
};

const parseMenuItemKey = (menuItemKey: string): { ariaLabel: string; url?: string } => {
  const [ariaLabel, url] = menuItemKey.split(menuItemKeySplitStr);
  return { ariaLabel, url: url || undefined };
};

const checkIsSelectedMenuItem = (menuItem: IMenuItem, currentPath: string): boolean => {
  if (menuItem.url && matchPath(currentPath, { exact: true, path: menuItem.url.split("?")[0] })) {
    return true;
  }
  if (
    menuItem.navUrlList &&
    menuItem.navUrlList.some((url) => matchPath(currentPath, { exact: true, path: url.split("?")[0] }))
  ) {
    return true;
  }
  return false;
};

const checkIsSelectedConfigMenuItem = (configMenuItems: IConfigurationMenuItem[], currentPath: string): boolean => {
  if (matchPath(currentPath, { exact: true, path: configurationSectionUrl })) {
    return true;
  }
  if (utils.isEmpty(configMenuItems)) {
    return false;
  }
  if (configMenuItems.some((item) => matchPath(currentPath, { exact: true, path: item.url.split("?")[0] }))) {
    return true;
  }
  return false;
};

const configurationAriaLabel = "configuration";

const findSelectedKey = (
  menuItems: IMenuItem[],
  configMenuItems: IConfigurationMenuItem[],
  currentPath: string
): string | undefined => {
  if (checkIsSelectedConfigMenuItem(configMenuItems, currentPath)) {
    return convertMenuItemKey({ ariaLabel: configurationAriaLabel, url: configurationSectionUrl });
  }

  for (const menuItem of menuItems) {
    const isSelected = checkIsSelectedMenuItem(menuItem, currentPath);
    if (isSelected) {
      return convertMenuItemKey(menuItem);
    }

    if (menuItem.children) {
      const found = findSelectedKey(menuItem.children, [], currentPath);
      if (found) {
        return found;
      }
    }
  }
  return undefined;
};

const makeMenuItemLabel = (menuItem: IMenuItem): React.ReactNode => {
  const { label, labelTagTypes } = menuItem;
  if (utils.isEmpty(labelTagTypes)) {
    return label;
  }
  const tagTextList: string[] = [];
  labelTagTypes.forEach((t) => {
    switch (t) {
      case "linkers":
        tagTextList.push(brandServiceTerm.linkers);
        break;
      case "fbv":
        tagTextList.push(brandServiceTerm.fbv);
        break;
      default:
        break;
    }
  });
  return (
    <Space size="small" align="center">
      {label}
      {tagTextList.map((tag, idx) => (
        <Tag key={idx} className={getTagClassName(["ant-menu-item-label-tag"])}>
          {tag}
        </Tag>
      ))}
    </Space>
  );
};

const MenuList: React.FC<MenuListProps> = (props) => {
  const { menuItems, isMenuSmall, onMenuItemClick } = props;
  const { user } = useUser();
  const isSuperuser = user.isSuperuser;
  const isStaff = checkStaff(user);
  const isHqStaff = checkHqStaff(user);
  const userPermissions = (user?.userPermissions || []).map((perm) => perm.code);

  const { pathname } = useLocation();
  const navigate = useNavigator();

  const customMenu = localStorage.getItem("customMenu");
  const isCustomMenu = customMenu && customMenu !== "undefined";
  const customMenuItems = getCustomMenuItems();
  if (isCustomMenu === false) {
    localStorage.removeItem("customMenu");
  }
  const isCustomMenuChangeFlag = useSelector<IRootState, boolean>((state) => state.common.isCustomMenuChangeFlag);
  const menuModeForHq = useSelector<IRootState, MenuModeForHq>((state) => state.common.menuModeForHq);
  const dispatch = useDispatch();
  const [openKeys, setOpenKeys] = useState<string[]>([]);
  const isMobile = utils.checkMobile();

  const enableForLinkersService = checkIsEnableForLinkersServiceByUser(user);
  // 이용 서비스 중 링커스와 그 외에 포장보스, 발주원 중 1개 이상 이용하는 브랜드인 경우에 메뉴 전환 가능. B2B는 단독으로만 설정 가능하므로 고려하지 않음.
  const showMenuModeChangeBtnForHq = isHqStaff && enableForLinkersService && user.brand.enabledServices.length > 1;

  const configurationMenu = isStaff ? createConfigurationMenu(isSuperuser) : undefined;
  const configMenuItems = maybe(() => configurationMenu.flatMap((menu) => menu.menuItems), []);
  const renderConfigMenu = utils.isEmpty(configMenuItems)
    ? false
    : configMenuItems.some((menuItem) => checkShowMenu(isHqStaff, userPermissions, menuItem));

  const selectedKey = useMemo(
    () => findSelectedKey(menuItems, configMenuItems, pathname),
    [menuItems, configMenuItems, pathname]
  );

  const { data } = useBrandGroupForChangeBrandQuery({
    skip: utils.isEmpty(user?.brand?.brandGroupId, true),
    variables: { id: user?.brand?.brandGroupId },
  });
  const brandListForChange = maybe(() => data.brandGroup.brands, []);

  const [hqStaffBrandUpdate, hqStaffBrandUpdateOpts] = useHqStaffBrandUpdateMutation({
    onCompleted: (res) =>
      utils.handleOnCompletedWithError(
        res?.hqStaffBrandUpdate?.errors,
        "브랜드가 변경되었습니다. 변경된 브랜드로 새로고침 됩니다.",
        () => {
          dispatch(menuModeForHqDelete());
          setTimeout(() => {
            window.location.href = "/";
          }, 1000);
        }
      ),
  });

  const filterMenuItemsByUserCustom = (items: IMenuItem[], customItems: ICustomMenuItem[]): IMenuItem[] =>
    items
      .filter((item) => {
        if (isCustomMenu) {
          const customItem = customItems.find((customItem) => customItem.ariaLabel === item.ariaLabel);
          if (customItem) {
            return customItem?.show;
          }
        }
        return true;
      })
      .map((item) => {
        if (!!item.children) {
          const childCustomItems =
            customItems.find((customItem) => customItem.ariaLabel === item.ariaLabel)?.children || [];
          return { ...item, children: filterMenuItemsByUserCustom(item.children, childCustomItems) };
        }
        return item;
      });
  const filteredMenuItems = filterMenuItemsByUserCustom(menuItems, customMenuItems);

  // Divider도 포함하여 렌더링 하기 위해 MenuProps["items"] 형태로 반환
  const makeAntdMenuItem = (menuItem: IMenuItem, withGroup: boolean): MenuProps["items"] => {
    const childrenExist = !!menuItem.children && menuItem.children.length > 0;
    const childrenItems = childrenExist
      ? menuItem.children.flatMap((child) => makeAntdMenuItem(child, withGroup))
      : undefined;

    const resultItem: ItemType = {
      key: convertMenuItemKey(menuItem),
      label: makeMenuItemLabel(menuItem),
      icon: menuItem?.icon ? <menuItem.icon /> : null,
      children:
        childrenItems && withGroup
          ? [{ type: "group", label: makeMenuItemLabel(menuItem), children: childrenItems }]
          : childrenItems,
    };

    const renderDivider = !!menuItem?.renderDivider;
    if (renderDivider) {
      const dividerItem: ItemType = { type: "divider" };
      return [resultItem, dividerItem];
    }
    return [resultItem];
  };

  const makeAntdMenuItems = (isMobile: boolean): MenuProps["items"] => {
    const antdMenuItems: MenuProps["items"] = [];

    // 메뉴 모드 전환 - 가맹본부용(브랜드 이용 서비스 조합에 따라 노출)
    if (showMenuModeChangeBtnForHq) {
      const isLinkersMenuMode = menuModeForHq === "linkers";
      const menuModeForHqChangeItem: ItemType = {
        key: "menuModeForHq",
        label: (
          <Button
            block
            icon={<SwapOutlined />}
            type="default"
            onClick={() => dispatch(menuModeForHqChange(isLinkersMenuMode ? "boss" : "linkers"))}
          >
            {isLinkersMenuMode ? brandServiceTerm.boss : brandServiceTerm.linkers}로 전환
          </Button>
        ),
      };
      antdMenuItems.push(menuModeForHqChangeItem);
    }

    // 페이지 메뉴
    filteredMenuItems.forEach((menuItem) => {
      antdMenuItems.push(...makeAntdMenuItem(menuItem, !isMobile));
    });

    // 설정 메뉴 - 관리자용
    if (renderConfigMenu) {
      const configurationItem = {
        key: convertMenuItemKey({ ariaLabel: configurationAriaLabel, url: configurationSectionUrl }),
        label: sectionNames.configuration,
        icon: <SettingOutlined />,
      };
      antdMenuItems.push(configurationItem);
    }

    // 브랜드 변경 버튼 - 브랜드 그룹이 있는 경우
    if (brandListForChange.length > 0) {
      const brandChangeItem: ItemType = {
        key: "brandChange",
        label: (
          <Button block type="default" shape="round">
            브랜드 변경
          </Button>
        ),
        children: [
          {
            type: "group",
            label: "선택 즉시 변경",
            children: brandListForChange.map((brand) => {
              const isCurrentBrand = brand.id === user?.brand?.id;
              return {
                key: brand.id,
                label: brand.name + (isCurrentBrand ? " (현재 브랜드)" : ""),
                disabled: isCurrentBrand,
                onClick: () => {
                  hqStaffBrandUpdate({ variables: { input: { brand: brand.id } } });
                },
              };
            }),
          },
        ],
      };
      antdMenuItems.push(brandChangeItem);
    }

    return antdMenuItems;
  };

  // eslint-disable-next-line @typescript-eslint/no-empty-function
  useEffect(() => {}, [isCustomMenuChangeFlag]);

  useDidMountEffect(() => {
    navigate("/");
  }, [menuModeForHq]);

  const commonMenuProps: MenuProps = {
    className: getMenuClassName(["ant-side-menu-bar"]),
    style: { overflowY: "auto", height: "100%", touchAction: "pan-y" },
    openKeys,
    selectedKeys: selectedKey ? [selectedKey] : [],
    getPopupContainer: (node) => node.parentElement || document.body,
    onOpenChange: (keys) => {
      const newKeys = keys.length > 0 ? [keys[keys.length - 1]] : [];
      setOpenKeys(newKeys);
    },
    onClick: (info) => {
      if (hqStaffBrandUpdateOpts.loading) {
        return;
      }

      const { key } = info;
      const { ariaLabel, url } = parseMenuItemKey(key);
      const newTab = ariaLabel === hqToBossMallAriaLabel;
      if (url) {
        onMenuItemClick(url, newTab);
      }
    },
  };

  return isMobile ? (
    <Menu {...commonMenuProps} mode="inline" inlineCollapsed={!isMenuSmall} items={makeAntdMenuItems(true)} />
  ) : (
    <Menu {...commonMenuProps} mode="vertical" triggerSubMenuAction="click" items={makeAntdMenuItems(false)} />
  );
};

export default MenuList;
</file>

