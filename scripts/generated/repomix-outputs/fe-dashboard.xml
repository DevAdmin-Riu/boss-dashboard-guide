import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import { BrandProductSortField, OrderDirection } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CompactFilter from "@src/app/components/Filter/CompactFilter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { useBrandListForAssignedProductLazyQuery } from "@src/app/views/brand/brands/api/queries";
import { BrandListForAssignedProduct_brands_edges_node } from "@src/app/views/brand/brands/api/types/BrandListForAssignedProduct";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Modal, Space, Table } from "antd";
import React, { useEffect, useState } from "react";

import { useBpListForAssignedBrandLazyQuery } from "../../api/queries";
import { BpListForAssignedBrand_brandProducts_edges_node_brandProductVariants } from "../../api/types/BpListForAssignedBrand";
import { ProductDetails_product } from "../../api/types/ProductDetails";
import { getBrandProductListForTableSettings } from "./BrandProductListModalSettings";
import {
  createFilterStructure,
  getFilterOpts,
  getFilterVariables,
  IBrandForAssginedProductFilterVariables,
} from "./filters";

interface BrandProductListModalProps {
  open: boolean;
  isFbv: boolean;
  loading: boolean;
  product: ProductDetails_product;
  resetForCloseModal: () => void;
}

export interface TBpvForAssignedBrand extends BpListForAssignedBrand_brandProducts_edges_node_brandProductVariants {
  // 브랜드 상품 옵션(brandProductVariant)에 상품(brandProduct)의 전용 여부 값 함께 전달
  isExclusive: boolean;
  brand: BrandListForAssignedProduct_brands_edges_node;
}

const BrandProductListModal: React.FC<BrandProductListModalProps> = (props) => {
  const { open, isFbv, product, loading, resetForCloseModal } = props;
  const navigate = useNavigator();

  const pvSelectOptions = (product?.variants || []).map((pv) => ({
    label: pv.sku,
    value: pv.id,
  }));
  const defaultOption = pvSelectOptions.length > 0 ? pvSelectOptions[0] : null;

  const initialFilterVariables: IBrandForAssginedProductFilterVariables = {
    pvId: defaultOption?.value,
    brandSearch: undefined,
    includeIsNotRunning: false,
  };
  const [filterVariables, setFilterVariables] =
    useState<IBrandForAssginedProductFilterVariables>(initialFilterVariables);
  const [dataSource, setDataSource] = useState<TBpvForAssignedBrand[]>([]);

  const filterOpts = getFilterOpts(filterVariables);
  const filterStructure = createFilterStructure(filterOpts, pvSelectOptions);

  const [bpListFetch, { loading: bpListLoading }] = useBpListForAssignedBrandLazyQuery();
  const [brandListFetch, { loading: brandListLoading }] = useBrandListForAssignedProductLazyQuery();

  const modalLoading = loading || bpListLoading || brandListLoading;

  const refetchDataSource = async () => {
    const { data: bpListData } = await bpListFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.default,
        sort: { direction: OrderDirection.ASC, field: BrandProductSortField.NAME },
        filter: { product: product?.id },
      },
    });
    const brandProductList = maybe(() => bpListData.brandProducts.edges.map((edge) => edge.node), []);
    const fileteredBpList = brandProductList.filter(
      (bp) => bp.brandProductVariants.findIndex((bpv) => bpv.productVariant.id === filterVariables.pvId) !== -1
    );
    const assignedBrandIdList = fileteredBpList.map((bp) => bp.brand.id);

    const { data: brandListData } = await brandListFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.default,
        filter: {
          ids: assignedBrandIdList,
          brandSearch: filterVariables.brandSearch,
          isRunning: filterVariables.includeIsNotRunning ? undefined : true,
        },
      },
    });
    const assignedBrandList = maybe(() => brandListData.brands.edges.map((edge) => edge.node), []);
    const bpvList = maybe<TBpvForAssignedBrand[]>(
      () =>
        fileteredBpList.flatMap(
          (bp) =>
            bp.brandProductVariants.map<TBpvForAssignedBrand>((bpv) => ({
              ...bpv,
              isExclusive: bp.isExclusive,
              brand: assignedBrandList.find((b) => b.id === bp.brand.id),
            })) || []
        ),
      []
    );
    const newDataSource = bpvList.filter(
      (bpv) => utils.isEmpty(bpv.brand) === false && bpv.productVariant.id === filterVariables.pvId
    );
    setDataSource(newDataSource);
  };

  const onFilterReset = () => {
    setFilterVariables(initialFilterVariables);
  };

  useEffect(() => {
    if (open) {
      refetchDataSource();
    }
  }, [open, filterVariables]);

  const onCloseModal = () => {
    onFilterReset();
    resetForCloseModal();
  };

  const columns = getBrandProductListForTableSettings({ isFbv, navigate });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Modal
      title="판매 브랜드 조회"
      open={open}
      width={tableWidthSum + 100}
      closable={false}
      onCancel={onCloseModal}
      footer={<Button onClick={resetForCloseModal}>댣기</Button>}
      destroyOnClose
    >
      <Space direction="vertical">
        <CompactFilter
          filterStructure={filterStructure}
          onFilterChange={(filters) => {
            if (!open) {
              return;
            }
            const filterVariables = getFilterVariables(filters);
            setFilterVariables((prev) => ({ ...prev, ...filterVariables }));
          }}
          onFilterReset={onFilterReset}
        />
        <TableVatLegend isIncludeVat={false} size="small" />
        <Table
          {...commonTableProps}
          loading={modalLoading}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum, y: 400 }}
          locale={{ emptyText: "해당 제품은 연동된 브랜드가 없습니다." }}
        />
      </Space>
    </Modal>
  );
};

export default BrandProductListModal;
</file>

