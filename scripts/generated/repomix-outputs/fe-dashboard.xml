import { getOrderDirection } from "@utils/sort";

import { PoLineInspectListViewUrlQueryParams, PoLineInspectListViewUrlSortField } from "../../urls";

export function getSortQueryField(sort: PoLineInspectListViewUrlSortField): string {
  switch (sort) {
    case PoLineInspectListViewUrlSortField.code:
      return "CODE";
    case PoLineInspectListViewUrlSortField.createdAt:
      return "CREATED_AT";
    case PoLineInspectListViewUrlSortField.productSku:
      return "PRODUCT_SKU";
    case PoLineInspectListViewUrlSortField.vendorCode:
      return "VENDOR_CODE";
    case PoLineInspectListViewUrlSortField.inspector:
      return "INSPECTOR";
    case PoLineInspectListViewUrlSortField.result:
      return "RESULT";
    default:
      return undefined;
  }
}

export function getSortQueryVariables(params: PoLineInspectListViewUrlQueryParams) {
  const field = getSortQueryField(params.sort);
  if (!!field) {
    return {
      direction: getOrderDirection(params.asc),
      field,
    };
  }

  return undefined;
}
