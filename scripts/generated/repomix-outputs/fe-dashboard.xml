<file path="src/app/views/hqStaff/hqSection/components/OrdersHistoryDialog/utils.ts">
import { OrdersForHqUserStats_orders } from "@src/app/views/hqStaff/hqSection/api/types/OrdersForHqUserStats";

export interface RearrangedOrderLinetype {
  id?: string;
  capturedAt?: any;
  number?: string;
  orderLineProductName: string;
  quantity: number;
  isFulfilledByVendor: boolean;
}

export const rearrangeToOrderLine = (orders: OrdersForHqUserStats_orders): RearrangedOrderLinetype[] => {
  if (!orders) {
    return [];
  }

  const result = orders.edges
    .map((edge) => edge.node)
    .flatMap((node) =>
      node.lines.map((orderLine) => {
        const ret: RearrangedOrderLinetype = {
          capturedAt: node.capturedAt,
          number: node.number,
          orderLineProductName: orderLine.productName,
          quantity: orderLine.quantity,
          isFulfilledByVendor: orderLine.isFulfilledByVendor,
        };
        return ret;
      })
    );

  return result;
};
