import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum POLineInspectListFilterKeys {
  vendorSearch = "vendorSearch",
  productSearch = "productSearch",
  userSearch = "userSearch",
  createdAt = "createdAt",
  excludeCanceled = "excludeCanceled",
}

export interface POLineInspectListFilterOpts {
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  createdAt: FilterOpts<MinMax>;
  excludeCanceled: FilterOpts<boolean>;
}

export function createFilterStructure(opts: POLineInspectListFilterOpts): IFilter<POLineInspectListFilterKeys> {
  const productSearchFilter = {
    ...createTextField(0, POLineInspectListFilterKeys.productSearch, "제품코드 / 제품명", opts.productSearch.value),
    active: opts.productSearch.active,
  };

  const vendorSearchFilter = {
    ...createTextField(0, POLineInspectListFilterKeys.vendorSearch, "협력사코드 / 협력사명", opts.vendorSearch.value),
    active: opts.vendorSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(0, POLineInspectListFilterKeys.userSearch, "검수자", opts.userSearch.value),
    active: opts.userSearch.active,
  };

  const createAtFilter = {
    ...createDateField(0, POLineInspectListFilterKeys.createdAt, "검수일", opts.createdAt.value),
    active: opts.createdAt.active,
  };

  const excludeCanceledFilter = {
    ...createBooleanField(
      0,
      POLineInspectListFilterKeys.excludeCanceled,
      "검수 취소 여부 제외",
      opts.excludeCanceled.value,
      {
        positive: "검수 취소 제외",
        negative: "검수 취소 포함",
      }
    ),
    active: opts.excludeCanceled.active,
  };

  const filterList: IFilter<POLineInspectListFilterKeys> = [
    productSearchFilter,
    vendorSearchFilter,
    userSearchFilter,
    createAtFilter,
    excludeCanceledFilter,
  ];

  return utils.filterDisplayOrdering(filterList.filter(Boolean));
}
