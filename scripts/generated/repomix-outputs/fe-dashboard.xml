import { ModusignTemplateListFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  ModusignTemplateListFilterKeys,
  ModusignTemplateListFilterOpts,
} from "../../components/ModusignTemplateListPage/filters";
import {
  ModusignTemplateListUrlFilters,
  ModusignTemplateListUrlFiltersEnum,
  ModusignTemplateListUrlQueryParams,
} from "../../urls";

const MODUSIGN_TEMPLATE_LIST_FILTERS_KEY = "modusignTemplateListFiltersKey";

export function getFilterOpts(params: ModusignTemplateListUrlFilters): ModusignTemplateListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
  };
}

export function getFilterVariables(params: ModusignTemplateListUrlFilters): ModusignTemplateListFilterInput {
  return {
    title: params.title !== undefined ? params.title : undefined,
    brandCode: null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ModusignTemplateListFilterKeys>
): ModusignTemplateListUrlFilters {
  const { name } = filter;

  switch (name) {
    case ModusignTemplateListFilterKeys.title:
      return getSingleValueQueryParam(filter, ModusignTemplateListUrlFiltersEnum.title);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } = createFilterTabUtils<ModusignTemplateListUrlFilters>(
  MODUSIGN_TEMPLATE_LIST_FILTERS_KEY
);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ModusignTemplateListUrlQueryParams,
  ModusignTemplateListUrlFilters
>({ ...ModusignTemplateListUrlFiltersEnum });
