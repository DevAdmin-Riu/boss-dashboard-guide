<file path="src/app/routes/PublicRoute.tsx">
import { Layout } from "antd";
import React from "react";
import { matchPath, Route, Switch } from "react-router-dom";

import { PageContentSection } from "../views/settings/pages";
import { pageContentViewPath } from "../views/settings/pages/urls";
import { DeepLinkRedirect } from "../views/tasks/DeepLinkRedirect/DeepLinkRedirect";
import { deepLinkRedirectPath } from "../views/tasks/DeepLinkRedirect/urls";

const publicPagePaths = [deepLinkRedirectPath, pageContentViewPath({ slug: "privacy" })];

export const checkIsPublicPage = (pathname: string) => publicPagePaths.some((path) => matchPath(pathname, { path }));

// NOTE: 아래 PublicRoute에 Route가 추가되거나 path가 변경되면 위쪽의 publicPagePaths에도 반영해야 함.
export const PublicRoute: React.FC = () => (
  <Layout>
    <Layout.Content>
      <Switch>
        <Route path={deepLinkRedirectPath} component={DeepLinkRedirect} />
        <Route path={pageContentViewPath({ slug: ":slug" })} component={PageContentSection} />
      </Switch>
    </Layout.Content>
  </Layout>
);
</file>

