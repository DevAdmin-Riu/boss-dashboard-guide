  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface CollectionListViewProps {
  params: CollectionListViewUrlQueryParams;
}

export const CollectionListView: React.FC<CollectionListViewProps> = ({ params }) => {
  const shop = useShop();
  const { isSelected, listElements, reset, toggle, toggleAll } = useBulkActions(params?.ids);
  const targetUrl = collectionListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.COLLECTION_LIST,
  });

  const queryVariables: CollectionListVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useCollectionListQuery({ initialListSkip: true, variables: queryVariables });

  const [collectionBulkDelete, collectionBulkDeleteOpts] = useCollectionBulkDelete({
    onCompleted: (data) => {
      const errors = data.collectionBulkDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        reset();
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [collectionListQuery],
  });

  const [collectionBulkPublish, collectionBulkPublishOpts] = useCollectionBulkPublish({
    onCompleted: (data) => {
      const errors = data.collectionBulkPublish.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        reset();
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [collectionListQuery],
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.collections?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<CollectionListViewUrlDialog, CollectionListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, collectionListViewUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  return (
    <>
      <CollectionListPage
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAdd={() => navigate(collectionCreateViewUrl)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        disabled={loading}
        collections={maybe(() => data.collections.edges.map((edge) => edge.node))}
        settings={settings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        onRowClick={(id) => navigate(collectionDetailsViewUrl(id))}
        toolbar={null}
        isChecked={isSelected}
        selected={listElements.length}
        toggle={toggle}
        toggleAll={toggleAll}
      />
      <ActionDialog
        open={params.action === "publish" && maybe(() => params?.ids?.length > 0)}
        onClose={closeModal}
        confirmButtonState={collectionBulkPublishOpts.status}
        onConfirm={() =>
          collectionBulkPublish({
            variables: {
              ids: params?.ids,
              isPublished: true,
            },
          })
        }
        variant="default"
        title={collectionMsg.publish}
      >
        <Typography>
          {params?.ids?.length === 1
            ? "이 컬렉션을 공개하시겠습니까?"
            : `${params?.ids?.length}개의 컬렉션을 공개하시겠습니까?`}
        </Typography>
      </ActionDialog>
      <ActionDialog
        open={params.action === "unpublish" && maybe(() => params?.ids?.length > 0)}
        onClose={closeModal}
        confirmButtonState={collectionBulkPublishOpts.status}
        onConfirm={() =>
          collectionBulkPublish({
            variables: {
              ids: params?.ids,
              isPublished: false,
            },
          })
        }
        variant="default"
        title={collectionMsg.unpublish}
      >
        <Typography>
          {params?.ids?.length === 1
            ? "이 컬렉션을 비공개하시겠습니까?"
            : `${params?.ids?.length}개의 컬렉션을 비공개하시겠습니까?`}
        </Typography>
      </ActionDialog>
      <ActionDialog
        open={params.action === "remove" && maybe(() => params?.ids?.length > 0)}
        onClose={closeModal}
        confirmButtonState={collectionBulkDeleteOpts.status}
        onConfirm={() =>
          collectionBulkDelete({
            variables: {
              ids: params?.ids,
            },
          })
        }
        variant="delete"
        title={collectionMsg.delete}
      >
        <Typography>
          {params?.ids?.length === 1
            ? "이 컬렉션을 삭제하시겠습니까?"
            : `${params?.ids?.length}개의 컬렉션을 삭제하시겠습니까?`}
        </Typography>
      </ActionDialog>
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

<file path="src/app/views/product/collections/views/CollectionListView/filters.ts">
import { CollectionFilterInput, PublishedEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  CollectionFilterKeys,
  CollectionListFilterOpts,
} from "@src/app/views/product/collections/components/CollectionListPage";
import {
  createFilterTabUtils,
  createFilterUtils,
  getSingleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  CollectionListViewUrlFilters,
  CollectionListViewUrlFiltersEnum,
  CollectionListViewUrlQueryParams,
} from "../../urls";

export const COLLECTION_FILTERS_KEY = "collectionFilters";

export function getFilterOpts(params: CollectionListViewUrlFilters): CollectionListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    name_Icontains: {
      active: maybe(() => !utils.isEmpty(filterVariables.name_Icontains), true),
      value: filterVariables.name_Icontains || "",
    },
    published: {
      active: maybe(() => !utils.isEmpty(filterVariables.published), false),
      value: maybe(() => findValueInEnum(filterVariables.published, PublishedEnum), PublishedEnum.HIDDEN),
    },
  };
}

export function getFilterVariables(params: CollectionListViewUrlFilters): CollectionFilterInput {
  return {
    published: params.published ? findValueInEnum(params.published, PublishedEnum) : undefined,
    name_Icontains: params.name_Icontains,
  };
}

export function getFilterQueryParam(filter: IFilterElement<CollectionFilterKeys>): CollectionListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case CollectionFilterKeys.name_Icontains:
      return getSingleValueQueryParam(filter, CollectionListViewUrlFiltersEnum.name_Icontains);
    case CollectionFilterKeys.published:
      return getSingleEnumValueQueryParam(filter, CollectionListViewUrlFiltersEnum.published, PublishedEnum);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<CollectionListViewUrlFilters>(COLLECTION_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  CollectionListViewUrlQueryParams,
  CollectionListViewUrlFilters
>(CollectionListViewUrlFiltersEnum);
</file>

