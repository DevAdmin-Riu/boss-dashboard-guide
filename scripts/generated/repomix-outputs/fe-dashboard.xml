import useUser from "@hooks/useUser";
import { PermissionEnum, StatReportingMode } from "@src/api/types/globalTypes";
import RequirePermissions from "@src/app/components/RequirePermissions";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BasicInfoForMain } from "@src/app/views/hqStaff/hqHome/components/BasicInfoForMain";
import { BrandEtcFileListForHqModal } from "@src/app/views/hqStaff/hqHome/components/BrandEtcFileListForHqModal";
import { EtcStatsForMain } from "@src/app/views/hqStaff/hqHome/components/EtcStatsForMain";
import { OrderStatsForMain } from "@src/app/views/hqStaff/hqHome/components/OrderStatsForMain";
import { TitleOrderStatsForMain } from "@src/app/views/hqStaff/hqHome/components/TitleOrderStatsForMain";
import {
  useBrandOrderStatsQuery,
  useBrandProductStatsUsingPeriod,
  useBrandUserStatsOrderByCountUsingPeriod,
} from "@src/app/views/hqStaff/hqSection/api/queries";
import { demoBrands } from "@src/app/views/hqStaffDemo/hqDemoHome";
import { statsDateType } from "@utils/chart";
import { getGteLteVariables } from "@utils/filters";
import { checkHqStaff } from "@utils/misc";
import { Divider, Space } from "antd";
import _ from "lodash";
import moment from "moment";
import React, { useState } from "react";

export let demoBrand = null;

enum HqDemoHomeModalModeEnum {
  QueryEtcFileList = "QueryEtcFileList",
}

export const HqDemoHomeView = () => {
  const { user } = useUser();

  const isHqStaff = checkHqStaff(user);
  if (!isHqStaff) {
    return null;
  }

  const [modalMode, setModalMode] = useState<HqDemoHomeModalModeEnum>(null);
  const openModal = (modalMode: HqDemoHomeModalModeEnum) => setModalMode(modalMode);
  const closeModal = () => setModalMode(null);

  const monthlyStatsDuration = 3;
  const dailyStatsDuration = 7;

  const todayMoment = moment();

  const thisMonthStartDayMoment = moment().startOf("month");
  const thisMonthEndDayMoment = moment().endOf("month");
  const before7DaysMoment = moment().subtract(dailyStatsDuration - 1, "d");
  const before3MonthStartDayMoment = moment()
    .subtract(monthlyStatsDuration - 1, "M")
    .startOf("month");

  if (demoBrand === null) {
    demoBrand = _.sample(demoBrands);
    // demoBrand = demoBrands[0];
  }

  const brandId = demoBrand?.id;

  const titleOrderStats = `${todayMoment.format(onlyMonthFormat)} 판매 현황`;

  const { data: orderStatsDuring7Days } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: {
        mode: StatReportingMode.DAILY,
        statDate: getGteLteVariables({
          gte: before7DaysMoment.format(onlyDateFormat),
          lte: todayMoment.format(onlyDateFormat),
        }),
        isFulfilledByVendor: false,
      },
    },
  });

  const { data: orderStatsDuring3Months } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: {
        mode: StatReportingMode.MONTHLY,
        statDate: getGteLteVariables({
          gte: before3MonthStartDayMoment.format(onlyDateFormat),
          lte: thisMonthEndDayMoment.format(onlyDateFormat),
        }),
        isFulfilledByVendor: false,
      },
    },
  });

  const { data: userStatsToday } = useBrandUserStatsOrderByCountUsingPeriod({
    variables: {
      id: brandId,
      first: 3,
    },
  });

  const { data: productStatsToday } = useBrandProductStatsUsingPeriod({
    variables: {
      id: brandId,
      first: 5,
    },
  });

  return (
    <RequirePermissions
      userPermissions={user?.userPermissions || []}
      requiredPermissions={[PermissionEnum.MANAGE_HQ_STAT]}
    >
      <Space direction="vertical" size="small" split={<Divider />}>
        <BasicInfoForMain
          title={"기본 정보"}
          brand={{ ...demoBrand, code: "BOSSCAFFE" }}
          openEtcFileListModal={() => openModal(HqDemoHomeModalModeEnum.QueryEtcFileList)}
        />
        {orderStatsDuring3Months && (
          <TitleOrderStatsForMain
            title={titleOrderStats}
            recentTargetDay={thisMonthStartDayMoment}
            stats={orderStatsDuring3Months}
            brand={demoBrand}
          />
        )}
        {orderStatsDuring7Days && (
          <OrderStatsForMain
            title="최근 7일간 판매 현황"
            recentTargetDay={todayMoment}
            startDay={before7DaysMoment}
            duration={dailyStatsDuration}
            stats={orderStatsDuring7Days}
            dateType={statsDateType.DAILY}
            brand={demoBrand}
          />
        )}
        {orderStatsDuring3Months && (
          <OrderStatsForMain
            title="최근 3개월 판매 현황"
            recentTargetDay={thisMonthStartDayMoment}
            startDay={before3MonthStartDayMoment}
            duration={monthlyStatsDuration}
            stats={orderStatsDuring3Months}
            dateType={statsDateType.MONTHLY}
            brand={demoBrand}
          />
        )}
        {(userStatsToday || productStatsToday) && (
          <EtcStatsForMain title="오늘의 랭킹" userStats={userStatsToday} productStats={productStatsToday} />
        )}
      </Space>
      <BrandEtcFileListForHqModal
        open={modalMode === HqDemoHomeModalModeEnum.QueryEtcFileList}
        etcFiles={[]}
        etcInfo={null}
        onCancel={closeModal}
      />
    </RequirePermissions>
  );
};
</file>

