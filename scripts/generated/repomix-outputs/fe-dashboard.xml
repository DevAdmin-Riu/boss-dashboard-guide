import { RackStockDetailFilterInput, StockDetailExpDateStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { RackStockFilterKeys, RackStockFilterOpts } from "../../components/RackStockListPage/filters";
import {
  RackStockListViewUrlFilters,
  RackStockListViewUrlFiltersEnum,
  RackStockListViewUrlFiltersWithMultipleValuesEnum,
  RackStockListViewUrlQueryParams,
} from "../../urls";

const RACK_STOCKS_FILTERS_KEY = "rackStocksFilters";

export enum LocationTypeEnum {
  PICKING = "PICKING",
  STOCK = "STOCK",
  CAN_NOT_SELL = "CAN_NOT_SELL",
}

const convertFilterVariablesToLocationTypes = (filterVariables: RackStockDetailFilterInput): LocationTypeEnum[] => {
  const locationTypes = [];
  if (filterVariables.canPicking) {
    locationTypes.push(LocationTypeEnum.PICKING);
  }
  if (filterVariables.canStock) {
    locationTypes.push(LocationTypeEnum.STOCK);
  }
  if (filterVariables.canNotSellToCustomers) {
    locationTypes.push(LocationTypeEnum.CAN_NOT_SELL);
  }

  return locationTypes;
};

export function getFilterOpts(params: RackStockListViewUrlFilters): RackStockFilterOpts {
  const filterVariables = getFilterVariables(params);
  const locationTypes = convertFilterVariablesToLocationTypes(filterVariables);
  const todayMoment = moment();

  return {
    sectorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.sectorSearch, true), false),
      value: maybe(() => filterVariables.sectorSearch, ""),
    },
    locationSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.locationSearch, true), false),
      value: maybe(() => filterVariables.locationSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    purchaseOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.purchaseOrderSearch, true), false),
      value: maybe(() => filterVariables.purchaseOrderSearch, ""),
    },
    locationTypes: {
      active: maybe(() => !utils.isEmpty(locationTypes), false),
      value: maybe(() => locationTypes, []),
    },
    safePickingStock: {
      active: maybe(() => !utils.isEmpty(filterVariables.safePickingStock), false),
      value: maybe(() => filterVariables.safePickingStock, false),
    },
    existStockDetail: {
      active: maybe(() => !utils.isEmpty(filterVariables.existStockDetail), false),
      value: maybe(() => filterVariables.existStockDetail, true),
    },
    stockedDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.stockedDate.gte, filterVariables.stockedDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.stockedDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.stockedDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    expDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.expDate.gte, filterVariables.expDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.expDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.expDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    existExpDate: {
      active: maybe(() => !utils.isEmpty(filterVariables.existExpDate), false),
      value: maybe(() => filterVariables.existExpDate, true),
    },
    requiredExpDateMgmt: {
      active: maybe(() => !utils.isEmpty(filterVariables.requiredExpDateMgmt), false),
      value: maybe(() => filterVariables.requiredExpDateMgmt, true),
    },
    expDateStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.expDateStatus), false),
      value: maybe(() => maybe(() => filterVariables.expDateStatus, [])),
    },
  };
}

export function getFilterVariables(params: RackStockListViewUrlFilters): RackStockDetailFilterInput {
  return {
    sectorSearch: params.sectorSearch,
    locationSearch: params.locationSearch,
    productSearch: params.productSearch,
    vendorSearch: params.vendorSearch,
    purchaseOrderSearch: params.purchaseOrderSearch,
    canPicking: !utils.isEmpty(params.locationTypes)
      ? params.locationTypes.includes(LocationTypeEnum.PICKING)
      : undefined,
    canStock: !utils.isEmpty(params.locationTypes) ? params.locationTypes.includes(LocationTypeEnum.STOCK) : undefined,
    canNotSellToCustomers: !utils.isEmpty(params.locationTypes)
      ? params.locationTypes.includes(LocationTypeEnum.CAN_NOT_SELL)
      : undefined,
    safePickingStock: params.safePickingStock !== undefined ? parseBoolean(params.safePickingStock, false) : undefined,
    existStockDetail: params.existStockDetail !== undefined ? parseBoolean(params.existStockDetail, false) : undefined,
    stockedDate: getGteLteVariables({ gte: params.stockedDateFrom, lte: params.stockedDateTo }),
    expDate: getGteLteVariables({ gte: params.expDateFrom, lte: params.expDateTo }),
    existExpDate: params.existExpDate !== undefined ? parseBoolean(params.existExpDate, false) : undefined,
    requiredExpDateMgmt:
      params.requiredExpDateMgmt !== undefined ? parseBoolean(params.requiredExpDateMgmt, false) : undefined,
    expDateStatus: maybe(
      () => params.expDateStatus.map((status) => findInEnum(status, StockDetailExpDateStatusEnum)),
      []
    ),
  };
}

export function getFilterQueryParam(filter: IFilterElement<RackStockFilterKeys>): RackStockListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case RackStockFilterKeys.sectorSearch:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.sectorSearch);
    case RackStockFilterKeys.locationSearch:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.locationSearch);
    case RackStockFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.productSearch);
    case RackStockFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.vendorSearch);
    case RackStockFilterKeys.purchaseOrderSearch:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.purchaseOrderSearch);
    case RackStockFilterKeys.locationTypes:
      return getMultipleValueQueryParam(filter, RackStockListViewUrlFiltersWithMultipleValuesEnum.locationTypes);
    case RackStockFilterKeys.safePickingStock:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.safePickingStock);
    case RackStockFilterKeys.existStockDetail:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.existStockDetail);
    case RackStockFilterKeys.stockedDate:
      return getMinMaxQueryParam(
        filter,
        RackStockListViewUrlFiltersEnum.stockedDateFrom,
        RackStockListViewUrlFiltersEnum.stockedDateTo
      );
    case RackStockFilterKeys.expDateStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        RackStockListViewUrlFiltersWithMultipleValuesEnum.expDateStatus,
        StockDetailExpDateStatusEnum
      );
    case RackStockFilterKeys.existExpDate:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.existExpDate);
    case RackStockFilterKeys.requiredExpDateMgmt:
      return getSingleValueQueryParam(filter, RackStockListViewUrlFiltersEnum.requiredExpDateMgmt);
    case RackStockFilterKeys.expDate:
      return getMinMaxQueryParam(
        filter,
        RackStockListViewUrlFiltersEnum.expDateFrom,
        RackStockListViewUrlFiltersEnum.expDateTo
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<RackStockListViewUrlFilters>(RACK_STOCKS_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  RackStockListViewUrlQueryParams,
  RackStockListViewUrlFilters
>({
  ...RackStockListViewUrlFiltersEnum,
  ...RackStockListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

