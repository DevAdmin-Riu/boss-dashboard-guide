export interface UnfulfilledOrderLineListFilterOpts {
  orderStatus: FilterOpts<OrderStatusFilter[]>;
  created: FilterOpts<MinMax>;
  deliveryMethods?: FilterOpts<OrderDeliveryMethodsEnum[]>;
  orderSearch: FilterOpts<string>;
  paymentSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: UnfulfilledOrderLineListFilterOpts,
  unfulfillmentViewType: UnfulfillmentViewTypeEnum
): IFilter<UnfulfilledOrderLineFilterKeys> {
  let displayOrder = 0;
  let filterStructure: IFilter<UnfulfilledOrderLineFilterKeys> = [];

  const isViewStock = isUnfulfillmentViewStock(unfulfillmentViewType);
  const isViewEtc = isUnfulfillmentViewStockEtc(unfulfillmentViewType);

  const deliveryMethodsFilter = {
    ...createOptionsField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.deliveryMethods,
      "배송방법",
      opts.deliveryMethods.value,
      true,
      [
        {
          label: "화물차",
          value: OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE,
        },
        {
          label: "퀵",
          value: OrderDeliveryMethodsEnum.BY_QUICK_SERVICE,
        },
        {
          label: "직접 배송",
          value: OrderDeliveryMethodsEnum.BY_RIU_DIRECT,
        },
        {
          label: "고객 수령",
          value: OrderDeliveryMethodsEnum.BY_CUSTOMER_DIRECT,
        },
      ]
    ),
    active: opts.deliveryMethods.active,
    isRequired: true,
  };

  const orderStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.orderStatus,
      "결제 증빙 포함 여부",
      opts.orderStatus.value,
      false,
      [
        {
          label: "포함",
          value: OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED,
        },
        {
          label: "미포함",
          value: OrderStatusFilter.READY_TO_FULFILL,
        },
      ]
    ),
    active: opts.orderStatus.active,
    isRequired: true,
  };
  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.orderSearch,
      "주문번호 / 주문상세번호",
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };

  const paymentSearchFilter = {
    ...createTextField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.paymentSearch,
      "결제번호",
      opts.paymentSearch.value,
      "결제번호로 검색"
    ),
    active: opts.paymentSearch.active,
  };

  const userSearchFilter = {
    ...createTextField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.userSearch,
      "ID / 사용자명",
      opts.userSearch.value
    ),
    active: opts.userSearch.active,
  };

  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      UnfulfilledOrderLineFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };

  const createdFilter = {
    ...createDateField(displayOrder++, UnfulfilledOrderLineFilterKeys.created, "주문일", opts.created.value),
    active: opts.created.active,
  };

  filterStructure = [
    isViewEtc && deliveryMethodsFilter,
    (isViewEtc || isViewStock) && orderStatusFilter,
    orderSearchFilter,
    paymentSearchFilter,
    userSearchFilter,
    brandSearchFilter,
    createdFilter,
  ];

  return filterStructure.filter(Boolean);
}
