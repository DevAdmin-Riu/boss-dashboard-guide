import { Dialog, SingleAction } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const siteSettingsSectionUrl = "/site-settings";

export const siteSettingsViewPath = siteSettingsSectionUrl;
export type SiteSettingsViewUrlDialog =
  | "add-key"
  | "create-mobile-app-info"
  | "update-mobile-app-info"
  | "delete-mobile-app-info";
export type SiteSettingsViewUrlQueryParams = Dialog<SiteSettingsViewUrlDialog> & SingleAction;
export const siteSettingsViewUrl = (params?: SiteSettingsViewUrlQueryParams) =>
  urlJoin(siteSettingsViewPath, "?" + stringifyQs(params));

export type BoxSpecForPickingOrderViewUrlDialog = "update" | "assign-sub-pv" | "unassign-sub-pv";
export type BoxSpecForPickingOrderViewUrlQueryParams = Dialog<BoxSpecForPickingOrderViewUrlDialog> & SingleAction;
export const boxSpecForPickingOrderViewPath = urlJoin(siteSettingsViewPath, "box-spec-for-picking-order");
export const boxSpecForPickingOrderViewUrl = (params?: BoxSpecForPickingOrderViewUrlQueryParams) =>
  urlJoin(boxSpecForPickingOrderViewPath, "?" + stringifyQs(params));
