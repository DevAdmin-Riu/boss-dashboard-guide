import useUser from "@hooks/useUser";
import { OrderDirection, OrderLineSortField } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { purchaseOrderCreateViewUrl, purchaseOrderDetailsViewUrl } from "@src/app/views/purchase/purchaseOrders/urls";
import { ListViews } from "@src/global/core/types/types";
import { IRootState } from "@src/global/redux/config/configStore";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useMemo, useState } from "react";
import { useSelector } from "react-redux";

import { useOrderFulfillBulkMutation, useOrderFulfillMutation } from "../../api/mutations";
import {
  fbvOrderLineCountQuery,
  orderLineListQuery,
  useOrderLineListFilterDownloadQuery,
  useOrderLineListQuery,
} from "../../api/queries";
import { OrderLineListVariables } from "../../api/types/OrderLineList";
import OrderLineListPage from "../../components/OrderLineListPage/OrderLineListPage";
import {
  fbvOrderDeliveryListViewUrl,
  fbvOrderDeliverySectionUrl,
  FbvOrderLineListViewUrlDialog,
  FbvOrderLineListViewUrlQueryParams,
  orderDetailsViewUrl,
} from "../../urls";
import { SelectVendorInfo } from "../FbvOrderDeliveryListView/FbvOrderDeliveryListView";
import { getFilterOpts, getFilterQueryParam, getFilterVariables } from "../OrderLineListView/filters";
import { areFiltersApplied, deleteFilterTab, getActiveFilters, getFilterTabs, saveFilterTab } from "./filters";

interface FbvOrderLineListView {
  defaultParams: FbvOrderLineListViewUrlQueryParams;
  params: FbvOrderLineListViewUrlQueryParams;
  vendorStaffVendorId: string;
  isB2b: boolean;
}
export const FbvOrderLineListView: React.FC<FbvOrderLineListView> = ({
  defaultParams,
  params,
  vendorStaffVendorId,
  isB2b,
}) => {
  const { user } = useUser();
  const [listElementKeys, setListElementKeys] = useState<string[]>([]);

  const fbvDeliverySelectVendor = useSelector<IRootState>(
    (state) => state.mileageSettlement.fbvDeliverySelectVendor
  ) as SelectVendorInfo;

  const targetUrl = fbvOrderDeliveryListViewUrl(fbvOrderDeliverySectionUrl);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.FBV_ORDER_LINE_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useOrderLineListFilterDownloadQuery);

  const isStaff = user?.isStaff;
  const isVendorStaff = user?.isVendorStaff;
  const queryVariables: OrderLineListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params, false),
        fulfillVendorId: vendorStaffVendorId,
      },
      sort: { direction: OrderDirection.DESC, field: OrderLineSortField.NUMBER },
      forFulfilled: true,
    }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useOrderLineListQuery({
    skip: utils.isEmpty(vendorStaffVendorId),
    variables: queryVariables,
  });

  const [fulfillOrder, fulfillOrderOpts] = useOrderFulfillMutation({
    onCompleted: (data) => {
      const errors = data.orderFulfill.errors;
      if (errors.length === 0) {
        showNotificationSuccess("출고가 완료되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [fbvOrderLineCountQuery, orderLineListQuery],
  });

  const [fulfillOrderBulk, fulfillOrderBulkOpts] = useOrderFulfillBulkMutation({
    onCompleted: (data) => {
      const errors = data.orderFulfillBulk.errors;
      if (errors.length === 0) {
        showNotificationSuccess("출고가 완료되었습니다.");
      } else {
        showGqlErrors(errors, undefined, false);
      }
    },
    refetchQueries: [fbvOrderLineCountQuery, orderLineListQuery],
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<FbvOrderLineListViewUrlDialog, FbvOrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const orderLineList = useMemo(() => maybe(() => data.orderLines.edges.map((edge) => edge.node)), [data]);

  return (
    <>
      <OrderLineListPage
        params={params}
        settings={settings}
        disabled={loading || fulfillOrderOpts.loading || fulfillOrderBulkOpts.loading}
        queryVariables={queryVariables}
        orderLines={orderLineList}
        onOrderNumberClick={(id) => navigate(orderDetailsViewUrl(id))}
        onPurchaseOrderNumberClick={(id) => navigate(purchaseOrderDetailsViewUrl(id))}
        onPurchaseOrderCreate={() => navigate(purchaseOrderCreateViewUrl({ createType: "consignment" }))}
        onFulfill={fulfillOrder}
        onFulfillBulk={fulfillOrderBulk}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, false)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        pageInfo={pageInfo}
        isStaff={isStaff}
        setListElementKeys={setListElementKeys}
        listElementKeys={listElementKeys}
        isVendorStaff={isVendorStaff}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        validateQueryClick={() => {
          if (isStaff && utils.isEmpty(fbvDeliverySelectVendor)) {
            showNotificationError("협력사를 선택해주세요.");
            return false;
          }
          return true;
        }}
        isB2b={isB2b}
        isFbv={true}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

