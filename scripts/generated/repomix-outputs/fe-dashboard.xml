<file path="src/app/components/Goodsflow/Goodsflow.tsx">
import Form from "@src/app/components/Form";
import { createHiddenInputElement } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { Button } from "antd";
import axios from "axios";
import React from "react";

import { IProps } from "./types";

const Goodsflow: React.FC<IProps> = (props: IProps) => {
  const {
    loading,
    disabled,
    mode,
    setLoading,
    onError,
    onSuccess,
    config,
    fulfillmentId,
    onlySelectedMode = false,
    isPickingOrder = false,
    selectedFulfillmentIds = [],
    batchPickingIds = [],
  } = props;

  const goodsFlowFormId = "goodsflow-form";

  const isPrintMode = mode === "print";
  const isPrintRetryMode = mode === "print-retry";

  let buttonText = "";
  // const onlySelected: boolean = selectedFulfillmentIds?.length > 0;

  if (onlySelectedMode) {
    buttonText = isPrintRetryMode ? "선택 운송장 재출력" : "선택 운송장 출력";
  } else {
    buttonText = isPrintMode ? "전체 운송장 출력" : isPrintRetryMode ? "운송장 재출력" : "서비스 계약 등록";
  }

  const requestOtp = async () => {
    let otpValue;
    const requestUrl = (config || []).find(({ field }) => field === "request_opt_url")?.value || "";

    await axios
      .post(`${requestUrl}`)
      .then((resolve) => {
        const { data } = resolve;
        if (data.success) {
          otpValue = data.data;
        } else {
          const error = data.error;
          onError(error.message);
        }
      })
      .catch((error) => {
        onError(error.message);
      });

    return otpValue;
  };

  const requestPrint = async (isRetry) => {
    let requestPrintId;
    const requestUrl = (config || []).find(({ field }) => field === "request_print_url")?.value || "";

    const existSelectedIds = selectedFulfillmentIds?.length > 0 || batchPickingIds?.length > 0;
    if (!onlySelectedMode && existSelectedIds) {
      showNotificationError("선택 출력 모드가 아닙니다.");
    }
    if (onlySelectedMode && !existSelectedIds) {
      showNotificationError("선택된 운송장이 없습니다.");
    }
    // if ((!onlySelectedMode && existSelectedIds) || (onlySelectedMode && !existSelectedIds)) {
    //   showNotificationError("잘못된 접근 입니다.");
    // }
    const onlySelected: boolean = onlySelectedMode && existSelectedIds;

    const params = {
      isRetry,
      fulfillmentId,
      // 아래는 chekced 된 경우에만 사용되는 변수
      onlySelected,
      selectedFulfillmentIds,
      // 합포장인 경우 사용되는 변수
      isPickingOrder,
      batchPickingIds,
    };

    await axios
      .post(`${requestUrl}`, params)
      .then((resolve) => {
        const { data } = resolve;
        if (data.success) {
          requestPrintId = data.id;
        } else {
          const error = data.error;
          onError(error.message);
          if (error.detail) {
            console.error("운송장 출력 요청 에러 상세:", error.detail);
          }
        }
      })
      .catch((error) => {
        onError(error.message);
      });

    return requestPrintId;
  };

  const makeFormSubmit = (otpValue, requestPrintId) => {
    const form = document.createElement("form");
    const formElement = document.getElementById(goodsFlowFormId);
    if (formElement) {
      formElement.remove();
    }
    form.setAttribute("id", goodsFlowFormId);
    form.setAttribute("method", "Post");
    form.setAttribute("Content-Type", "application/x-www-form-urlencoded");

    form.appendChild(createHiddenInputElement("OTP", otpValue));

    let targetWindowUrl;
    if (isPrintMode || isPrintRetryMode) {
      const responsePrintUrl = (config || []).find(({ field }) => field === "response_print_url")?.value || "";

      form.appendChild(createHiddenInputElement("responseUrl", responsePrintUrl));
      form.appendChild(createHiddenInputElement("id", requestPrintId));

      targetWindowUrl = (config || []).find(({ field }) => field === "web_print_url")?.value || "";
    } else {
      targetWindowUrl = (config || []).find(({ field }) => field === "web_contract_url")?.value || "";
    }

    const rootElement = document.getElementById("dashboard-app");
    if (rootElement) {
      rootElement.appendChild(form);
    } else {
      console.error("rootElement id 를 확인하세요.");
    }

    const targetWindow = "goodsflowWindows";
    const childWindow = window.open("", targetWindow);
    form.action = targetWindowUrl;
    form.target = targetWindow;
    form.submit();

    let timerId = setInterval(() => {
      if (!childWindow || childWindow.closed) {
        clearInterval(timerId);
        timerId = undefined;
        onSuccess();
      }
    }, 1000);
  };

  const onSubmit = async () => {
    setLoading(true);

    let requestPrintId;
    if (isPrintMode || isPrintRetryMode) {
      requestPrintId = await requestPrint(isPrintRetryMode);
      if (!requestPrintId) {
        return;
      }
    }

    const otpValue = await requestOtp();
    if (!otpValue) {
      return;
    }

    makeFormSubmit(otpValue, requestPrintId);
  };

  return (
    <Form
      initial={{}}
      onSubmit={() => {
        onSubmit();
      }}
    >
      {({ submit: handleSubmit }) => (
        <Button type="primary" shape="round" loading={loading} disabled={disabled} onClick={handleSubmit}>
          {buttonText}
        </Button>
      )}
    </Form>
  );
};

export { Goodsflow };
</file>

