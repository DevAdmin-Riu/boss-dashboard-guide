export function getMileageSettlementListTableSummary(
  tableData: readonly BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node[],
  urlTypeEnum: AdminMonthlySettlementUrlEnum,
  createPickSummaryColumns: (keyValue: Record<string, string>, startIndex: number) => React.ReactNode[]
) {
  let statTotalPriceExcludeVatSum = 0;
  let statRcoinsExcludeVatSum = 0;
  let statReturnDeliveryFeeExcludeVatSum = 0;
  let statMileageIncludeVatSum = 0;
  let statBrandCostPriceExcludeVatSum = 0;
  let statBrandDeliveryFeeExcludeVatSum = 0;
  let statBrandPayingChargeExcludeVatSum = 0;
  let statMileageExcludeVatSum = 0;
  let statMileageVatSum = 0;
  let statDecreaseDevCostIncludeVatSum = 0;
  let statProfitRatioSum = 0;

  tableData.forEach(
    ({
      totalPriceExcludeVat,
      rcoinsExcludeVat,
      returnDeliveryFee,
      mileageExcludeVat,
      mileageVat,
      mileageIncludeVat,
      decreaseDevCostIncludeVat,
      brandCostPriceExcludeVat,
      brandDeliveryFee,
      brandPayingChargeExcludeVat,
    }) => {
      statTotalPriceExcludeVatSum += totalPriceExcludeVat || 0;
      statRcoinsExcludeVatSum += rcoinsExcludeVat || 0;
      statReturnDeliveryFeeExcludeVatSum += toPriceExcludeVat(returnDeliveryFee || 0);
      statBrandCostPriceExcludeVatSum += brandCostPriceExcludeVat || 0;
      statBrandDeliveryFeeExcludeVatSum += toPriceExcludeVat(brandDeliveryFee || 0);
      statBrandPayingChargeExcludeVatSum += brandPayingChargeExcludeVat || 0;
      statMileageExcludeVatSum += mileageExcludeVat || 0;
      statMileageVatSum += mileageVat || 0;
      statMileageIncludeVatSum += mileageIncludeVat || 0;
      statDecreaseDevCostIncludeVatSum += decreaseDevCostIncludeVat || 0;
    }
  );
  statProfitRatioSum = getProfitRatio(statMileageExcludeVatSum, statTotalPriceExcludeVatSum);
  const keyValue = {
    statTotalPriceExcludeVat: getNumberFormat(statTotalPriceExcludeVatSum),
    statRcoinsExcludeVat: getNumberFormat(statRcoinsExcludeVatSum),
    statBrandCostPriceExcludeVat: getNumberFormat(statBrandCostPriceExcludeVatSum),
    statReturnDeliveryFeeExcludeVat: getNumberFormat(statReturnDeliveryFeeExcludeVatSum),
    statBrandDeliveryFeeExcludeVat: getNumberFormat(statBrandDeliveryFeeExcludeVatSum),
    statBrandPayingChargeExcludeVat: getNumberFormat(statBrandPayingChargeExcludeVatSum),
    statMileageExcludeVat: getNumberFormat(statMileageExcludeVatSum),
    statMileageVat: getNumberFormat(statMileageVatSum),
    statMileageIncludeVat: getNumberFormat(statMileageIncludeVatSum),
    statDecreaseDevCostIncludeVat: getNumberFormat(statDecreaseDevCostIncludeVatSum),
    statConfirmedMileageIncludeVat: getNumberFormat(statMileageIncludeVatSum - statDecreaseDevCostIncludeVatSum),
    statProfitRatio: getNumberFormat(statProfitRatioSum),
  };

  const indexAdjust = [
    AdminMonthlySettlementUrlEnum.NOT_CONFIRMED,
    AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT,
  ].includes(urlTypeEnum)
    ? 1
    : 0;

  const index = 0 + indexAdjust;

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        {[AdminMonthlySettlementUrlEnum.NOT_CONFIRMED, AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT].includes(
          urlTypeEnum
        ) && (
          <Table.Summary.Cell index={0} align="center">
            <Text strong></Text>
          </Table.Summary.Cell>
        )}
        {createPickSummaryColumns(keyValue, index)}
      </Table.Summary.Row>
    </Table.Summary>
  );
}

export const getMileageSettlementCreateConfirmTableSettings = (
  TypeSafeFormForCreate: TypeSafeForm<MileageSettlementCreateFormData>,
  inputListForCreate: MileageSettlementCreateInputForFormData[]
): ColumnsType<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node> => {
  const columns: ColumnsType<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "brandCode",
      align: "center",
      width: 100,
      render: (_, record) => record.brand.code || "-",
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "brandName",
      width: 150,
      render: (_, record) => record.brand.name || "-",
    },
    {
      title: columnNameConstant.common.BIZ_REG_NO,
      key: "bizRegNo",
      align: "center",
      width: 120,
      render: (_, record) =>
        record.brand.bizInfo?.bizRegNo ? transformBusinessNumber(record.brand.bizInfo.bizRegNo) : "-",
    },
    {
      title: columnNameConstant.mileageSettlement.mileage,
      key: "mileage",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.mileageIncludeVat} />,
    },
    {
      title: columnNameConstant.mileageSettlement.devCost,
      key: "devCost",
      align: "right",
      width: 120,
      render: (_, record, idx) => (
        <>
          <Form.Item
            hidden
            name={TypeSafeFormForCreate.getValidDataIndex(`inputList.${idx}.recordId`)}
            initialValue={record.id}
          >
            <Input />
          </Form.Item>
          <Form.Item
            style={{ margin: 0 }}
            name={TypeSafeFormForCreate.getValidDataIndex(`inputList.${idx}.decreaseDevCostIncludeVat`)}
            initialValue={record.brand.remainDevCost}
            rules={[
              {
                validator: (_, value) => {
                  if (!utils.isEmpty(value)) {
                    if (value > record.brand.remainDevCost) {
                      return Promise.reject(
                        new Error(
                          `브랜드의 잔여 기타 비용(${getMoneyFormat(record.brand.remainDevCost)})보다 큰 금액입니다.`
                        )
                      );
                    }
                    if (record.mileageIncludeVat - value < 0) {
                      return Promise.reject(new Error("지급 확정 금액이 마이너스입니다."));
                    }
                  }
                  return Promise.resolve();
                },
              },
            ]}
          >
            <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
          </Form.Item>
        </>
      ),
    },
    {
      title: columnNameConstant.mileageSettlement.confirmedMileage,
      key: "confirmedMileage",
      align: "right",
      width: 120,
      render: (_, record, idx) => {
        const currentInput = inputListForCreate?.[idx];
        const value =
          utils.isEmpty(currentInput) || utils.isEmpty(currentInput.decreaseDevCostIncludeVat)
            ? record.mileageIncludeVat
            : record.mileageIncludeVat - currentInput.decreaseDevCostIncludeVat;
        return (
          <Typography.Text strong type={value < 0 ? "danger" : null}>
            {getNumberFormat(value)}
          </Typography.Text>
        );
      },
    },
  ];
  return columns;
};
