import { FulfillmentTypeColor } from "@assets/constants/colors";
import { Tag } from "antd";
import React from "react";

import { transformIsFBV, transformIsFBVForHq } from "./misc";

export const makeTagIsFBVText = (isFulfilledByVendor: boolean, isHqStaff: boolean): string =>
  isHqStaff ? transformIsFBVForHq(isFulfilledByVendor) : transformIsFBV(isFulfilledByVendor);
export const makeTagIsFBV = (isFulfilledByVendor: boolean, isHqStaff: boolean): any => {
  const tagText = makeTagIsFBVText(isFulfilledByVendor, isHqStaff);
  const color = isFulfilledByVendor ? FulfillmentTypeColor.isFBV : FulfillmentTypeColor.isNotFBV;
  return <Tag color={color}>{tagText}</Tag>;
};

export const makeFulfillmentTypeText = (trackInventory: boolean, isVendorTrackInventory: boolean = false) => {
  if (trackInventory === false) {
    return "위탁";
  }
  if (isVendorTrackInventory) {
    return "위탁재고";
  }
  return "재고";
};

const getFulfillmentTypeColor = (
  trackInventory: boolean,
  isVendorTrackInventory: boolean = false,
  isMixedTrackInventory: boolean = false
) => {
  if (isMixedTrackInventory) {
    return FulfillmentTypeColor.isMixedTrackInventory;
  }
  if (trackInventory === false || isVendorTrackInventory) {
    return FulfillmentTypeColor.consignment;
  }
  return FulfillmentTypeColor.trackInventory;
};

export const makeTagFulfillmentTypeText = (
  trackInventory: boolean,
  isFulfilledByVendor: boolean,
  isHqStaff: boolean,
  isMixedTrackInventory: boolean = false,
  isVendorTrackInventory: boolean = false
) => {
  if (isFulfilledByVendor) {
    return isHqStaff ? transformIsFBVForHq(isFulfilledByVendor) : transformIsFBV(isFulfilledByVendor);
  }
  if (isMixedTrackInventory) {
    return "혼합";
  }
  return makeFulfillmentTypeText(trackInventory, isVendorTrackInventory);
};

export const makeTagFulfillmentType = (
  trackInventory: boolean,
  isFulfilledByVendor: boolean,
  isHqStaff: boolean,
  isMixedTrackInventory: boolean = false,
  isVendorTrackInventory: boolean = false
) => {
  const tagText = makeTagFulfillmentTypeText(
    trackInventory,
    isFulfilledByVendor,
    isHqStaff,
    isMixedTrackInventory,
    isVendorTrackInventory
  );
  if (isFulfilledByVendor) {
    return <Tag color={FulfillmentTypeColor.isFBV}>{tagText}</Tag>;
  }
  const color = getFulfillmentTypeColor(trackInventory, isVendorTrackInventory, isMixedTrackInventory);
  return <Tag color={color}>{tagText}</Tag>;
};

export const makeTagFulfillmentTypeForCreateAdminOrder = (
  trackInventory: boolean,
  isVendorTrackInventory: boolean = false
): any => {
  const tagText = makeFulfillmentTypeText(trackInventory, isVendorTrackInventory);
  const color = getFulfillmentTypeColor(trackInventory, isVendorTrackInventory, false);
  return <Tag color={color}>{tagText}</Tag>;
};
