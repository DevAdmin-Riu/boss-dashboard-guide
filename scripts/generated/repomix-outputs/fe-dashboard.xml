export const utils = {
  getDBIdFromGraphqlId: (graphqlId: string, schema?: string): number => {
    const rawId = Base64.decode(graphqlId);
    const regexp = /(\w+):(\d+)/;
    const arr = regexp.exec(rawId);
    if (arr === null) {
      return;
    }
    if (schema && schema !== arr![1]) {
      throw new Error("Schema is not correct");
    }
    return parseInt(arr![2], 10);
  },
  getGraphqlIdFromDBId: (id: string, schema: string): string => Base64.encode(`${schema}:${id}`),
  decimalRoundDown: -1,
  fixedLeftFlag: (): FixedType => (utils.checkMobile() ? undefined : "left"),
  fixedRightFlag: (): FixedType => (utils.checkMobile() ? undefined : "right"),
  removeHyphen: (value) => {
    if (value) {
      return String(value).replace(/-/g, "");
    }
    return value;
  },
  removeComma: (value) => {
    if (value) {
      return String(value).replace(/,/g, "");
    }
    return value;
  },
  removeKorean: (value: string) => {
    if (value) {
      return String(value).replace(/[ㄱ-ㅎㅏ-ㅣ가-힣\s]/g, "");
    }
    return value;
  },

  convertToNumber: (value, decimal = undefined, isFloor = false) => {
    try {
      let removedValue = value.toString().replace(/\,/g, ""); // 콤마제거
      removedValue = removedValue.replace(/\s/gi, ""); // 공백제거
      // 계산 가능한 숫자인지 판별
      if (isNaN(removedValue) || removedValue === "") {
        return undefined;
      } else {
        if (decimal === utils.decimalRoundDown) {
          return Math.floor(parseFloat(removedValue));
        }
        if (isFloor) {
          return decimal !== undefined
            ? Number(Math.floor(removedValue * Math.pow(10, decimal)) / Math.pow(10, decimal))
            : Math.floor(parseFloat(removedValue));
        } else {
          // toFixed: 반올림됨
          return decimal !== undefined ? Number(parseFloat(removedValue).toFixed(decimal)) : parseFloat(removedValue);
        }
      }
    } catch (e) {
      return undefined;
    }
  },
  convertToNumberWrapper: (value, decimal = undefined, isFloor = false) => {
    const number = utils.convertToNumber(value, decimal, isFloor);
    return number ? number : 0;
  },
  sleep: (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
  fillZero(nr, n) {
    return Array(n - String(nr).length + 1).join("0") + nr;
  },
  convertToDecimalFromPercent: (value) => {
    const number = utils.convertToNumberWrapper(value);
    return number / 100;
  },
  convertToPercentFromDecimal: (value, decimal = 1, isFloor = false) => {
    // 백분위 표기를 위해 100을 곱하므로, decimal + 2를 해줘야 함.
    const number = utils.convertToNumberWrapper(value, decimal + 2, isFloor) * 100;
    if (decimal === undefined) {
      decimal = 0;
    }
    return number.toFixed(decimal);
  },
  replaceAll: (str, before, after) => {
    if (str && typeof str === "string") {
      const split = str.split(before);
      if (split) {
        return split.join(after);
      }
    }
    return str;
  },
  formatMessage: (formatStr: string, keyValuePairObj: object = {}) => {
    for (const key in keyValuePairObj) {
      if (keyValuePairObj.hasOwnProperty(key)) {
        const value = keyValuePairObj[key];
        formatStr = utils.replaceAll(formatStr, `{${key}}`, value);
      }
