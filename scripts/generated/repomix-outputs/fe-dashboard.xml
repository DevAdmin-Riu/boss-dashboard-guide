<file path="src/app/views/hqStaff/hqSection/components/HqInfoPackagePage/utils.ts">
import { BrandProductPackageListFragment } from "@src/api/fragments/types/BrandProductPackageListFragment";

/**
 * 배송 방법 배열 반환
 * @param packageData 패키지 데이터
 * @returns 배송 방법 문자열 배열
 */
export const getDeliveryMethods = (packageData: BrandProductPackageListFragment): string[] => {
  const methods: string[] = [];

  if (packageData.isByCourierAllowed) {
    methods.push("택배");
  }

  if (packageData.isByTruckServiceAllowed) {
    methods.push("화물차");
  }

  return methods;
};
</file>

<file path="src/app/views/hqStaff/hqSection/components/HqInfoProductPage/filters.ts">
import { SalesStatusEnum, StockStatusByEstShortageEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { getSalesStatusChoices, stockShortageStatusChoices } from "@src/app/views/product/products/utils/data";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

import { HqInfoProductListType } from "../../urls";

export enum HqInfoProductFilterKeys {
  firstSaleAt = "firstSaleAt",
  pvStoppedAt = "pvStoppedAt",
  isInner = "isInner",
  brandProductSearch = "brandProductSearch",
  pvSalesStatus = "pvSalesStatus",
  bpvSalesStatus = "bpvSalesStatus",
  stockShortageStatus = "stockShortageStatus",
  exclusive = "exclusive",
  isOnlyPayableByCash = "isOnlyPayableByCash",
}

export interface HqInfoProductFilterOpts {
  firstSaleAt: FilterOpts<MinMax>;
  pvStoppedAt: FilterOpts<MinMax>;
  isInner: FilterOpts<boolean>;
  brandProductSearch: FilterOpts<string>;
  pvSalesStatus: FilterOpts<SalesStatusEnum[]>;
  bpvSalesStatus: FilterOpts<SalesStatusEnum[]>;
  stockShortageStatus: FilterOpts<StockStatusByEstShortageEnum[]>;
  exclusive: FilterOpts<boolean>;
  isOnlyPayableByCash: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: HqInfoProductFilterOpts,
  pageType: HqInfoProductListType | ":pageType"
): IFilter<HqInfoProductFilterKeys> {
  let displayOrder = 0;
  const isGeneralProductPage = pageType === "general";
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      HqInfoProductFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const isInnerFilter = {
    ...createBooleanField(displayOrder++, HqInfoProductFilterKeys.isInner, "제품형태", opts.isInner.value, {
      positive: "이너박스",
      negative: "아우터박스",
    }),
    active: opts.isInner.active,
  };
  const pvSalesStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      HqInfoProductFilterKeys.pvSalesStatus,
      "제품상태",
      opts.pvSalesStatus.value,
      true,
      getSalesStatusChoices(false, false, true)
    ),
    active: opts.pvSalesStatus.active,
  };
  const bpvSalesStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      HqInfoProductFilterKeys.bpvSalesStatus,
      "판매상태",
      opts.bpvSalesStatus.value,
      true,
      getSalesStatusChoices(true, false)
    ),
    active: opts.bpvSalesStatus.active,
  };
  const pvStoppedAtFilter = {
    ...createDateField(displayOrder++, HqInfoProductFilterKeys.pvStoppedAt, "단종 일자", opts.pvStoppedAt.value),
    active: opts.pvStoppedAt.active,
  };
  const firstSaleAtFilter = {
    ...createDateField(displayOrder++, HqInfoProductFilterKeys.firstSaleAt, "판매 시작 일자", opts.firstSaleAt.value),
    active: opts.firstSaleAt.active,
  };
  const exclusiveFilter = {
    ...createBooleanField(displayOrder++, HqInfoProductFilterKeys.exclusive, "전용여부", opts.exclusive.value, {
      positive: "전용",
      negative: "범용",
    }),
    active: opts.exclusive.active,
  };
  const isOnlyPayableByCashFilter = {
    ...createBooleanField(
      displayOrder++,
      HqInfoProductFilterKeys.isOnlyPayableByCash,
      "현금 전용",
      opts.isOnlyPayableByCash.value,
      {
        positive: "O",
        negative: "X",
      }
    ),
    active: opts.isOnlyPayableByCash.active,
  };
  const stockShortageStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      HqInfoProductFilterKeys.stockShortageStatus,
      "재고상태",
      opts.stockShortageStatus.value,
      true,
      stockShortageStatusChoices
    ),
    active: opts.stockShortageStatus.active,
  };
  return [
    brandProductSearchFilter,
    isInnerFilter,
    pvSalesStatusFilter,
    bpvSalesStatusFilter,
    pvStoppedAtFilter,
    firstSaleAtFilter,
    isGeneralProductPage && exclusiveFilter,
    isOnlyPayableByCashFilter,
    isGeneralProductPage === false && stockShortageStatusFilter,
  ].filter(Boolean);
}
</file>

