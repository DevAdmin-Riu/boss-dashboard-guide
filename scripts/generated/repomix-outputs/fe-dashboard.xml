import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "@src/app/views/settings/attributes/views/AttributeListView/filters";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";
import { useLocation } from "react-router";

import { useAttributeBulkDeleteMutation } from "../../api/mutations";
import { attributeListQuery, useAttributeListQuery } from "../../api/queries";
import { AttributeListVariables } from "../../api/types/AttributeList";
import AttributeBulkDeleteDialog from "../../components/AttributeBulkDeleteDialog";
import AttributeListPage from "../../components/AttributeListPage";
import {
  attributeCreateViewUrl,
  attributeDetailsViewUrl,
  attributeListViewUrl,
  AttributeListViewUrlDialog,
  AttributeListViewUrlQueryParams,
} from "../../urls";
import { getFilterQueryParam } from "./filters";
import { getSortQueryVariables } from "./sort";

interface AttributeListViewProps {
  params: AttributeListViewUrlQueryParams;
}

export const AttributeListView: React.FC<AttributeListViewProps> = ({ params }) => {
  const location = useLocation();
  const historyState = location?.state as { ids: string[] };
  const shop = useShop();
  const targetUrl = attributeListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.ATTRIBUTE_LIST,
  });

  const queryVariables: AttributeListVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useAttributeListQuery({ variables: queryVariables });

  const [attributeBulkDelete, attributeBulkDeleteOpts] = useAttributeBulkDeleteMutation({
    onCompleted: (data) => {
      const errors = data.attributeBulkDelete.errors;
      if (errors.length === 0) {
        closeModal();
        showNotificationSuccess("속성이 삭제되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [attributeListQuery],
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.attributes?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<AttributeListViewUrlDialog, AttributeListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, attributeListViewUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  return (
    <>
      <AttributeListPage
        attributes={maybe(() => data.attributes.edges.map((edge) => edge.node))}
        currencySymbol={currencySymbol}
        settings={settings}
        currentTab={currentTab}
        disabled={loading || attributeBulkDeleteOpts.loading}
        filterOpts={getFilterOpts(params)}
        onAdd={() => navigate(attributeCreateViewUrl())}
        onAll={resetFilters}
        onBack={() => navigate(configurationSectionUrl)}
        onFilterChange={changeFilters}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(attributeDetailsViewUrl(id))}
        onSort={handleSort}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        tabs={tabs.map((tab) => tab.name)}
      />
      <AttributeBulkDeleteDialog
        confirmButtonState={attributeBulkDeleteOpts.status}
        open={params.action === "remove" && maybe(() => historyState?.ids?.length > 0)}
        onConfirm={() => attributeBulkDelete({ variables: { ids: historyState?.ids } })}
        onClose={closeModal}
        quantity={maybe(() => historyState?.ids?.length)}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

