export const getFbvLastOrderDate = ({
  lastOrderDay,
  lastOrderHour,
}: {
  lastOrderDay: number;
  lastOrderHour: number;
}): Moment => {
  const nowDate = moment();
  const nowHour = nowDate.hour();

  const lastOrderDate = moment().add(lastOrderDay, "days");
  const numberHours = lastOrderHour;

  // 초기 값은 TimeStamp로 나와서 값이 굉장 큼 moment로 변환 후 hour 가져온 다음에 비교
  if (numberHours > 23) {
    const initHour = moment(numberHours).hours();

    if (initHour > nowHour) {
      lastOrderDate.add(1, "days");
    }
  } else {
    // 변경되는 값은 18:00 string으로 값을 가져올 수 있음. 앞에 2개만 가져와서 hour 비교
    if (lastOrderHour <= nowHour) {
      lastOrderDate.add(1, "days");
    }
  }

  return lastOrderDate;
};

