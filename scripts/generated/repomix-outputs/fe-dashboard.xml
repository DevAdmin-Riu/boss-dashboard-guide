import { WindowTitle } from "@src/app/components/WindowTitle";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { parse as parseQs } from "qs";
import React from "react";
import { Redirect, Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  warehouseCreateViewPath,
  warehouseCreateViewUrl,
  warehouseDetailsViewPath,
  warehouseDetailsViewUrl,
  WarehouseDetailsViewUrlQueryParams,
  warehouseSectionUrl,
} from "./urls";
import { WarehouseCreateView } from "./views/WarehouseCreateView/WarehouseCreateView";
import { WarehouseDetailsView } from "./views/WarehouseDetailsView/WarehouseDetailsView";

const WarehouseListViewWrapper: React.FC<RouteComponentProps> = ({ location }) => {
  const shop = useShop();
  const defaultWarehouseId = shop?.defaultWarehouse?.id;

  // shop.defaultWarehouse.id가 있으면 바로 상세 페이지로 리다이렉트
  if (defaultWarehouseId) {
    return <Redirect to={warehouseDetailsViewUrl(defaultWarehouseId, {})} />;
  }
  // shop.defaultWarehouse가 없다면 생성 페이지로
  return <Redirect to={warehouseCreateViewUrl} />;
};

const WarehouseDetailsViewWrapper: React.FC<RouteComponentProps<{ id: string }>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: WarehouseDetailsViewUrlQueryParams = qs;
  return <WarehouseDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

export const WarehouseSection: React.FC = () => (
  <>
    <WindowTitle title={sectionNames.warehouses} />
    <Switch>
      <Route exact path={warehouseSectionUrl} component={WarehouseListViewWrapper} />
      <Route exact path={warehouseCreateViewPath} component={WarehouseCreateView} />
      <Route path={warehouseDetailsViewPath(":id")} component={WarehouseDetailsViewWrapper} />
    </Switch>
  </>
);

export default WarehouseSection;
</file>

