import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { SearchVendorsVariables } from "@src/api/searches/types/SearchVendors";

export const getSearchVendorsVariablesForPvv = (
  isFulfilledByVendor: boolean,
  isB2bCategoryKind: boolean
): SearchVendorsVariables => {
  const useProductVariables: Pick<SearchVendorsVariables, "useBossProduct" | "useB2bProduct" | "useFbvProduct"> =
    isFulfilledByVendor === true
      ? { useFbvProduct: true }
      : isB2bCategoryKind
      ? { useB2bProduct: true }
      : { useBossProduct: true };

  return {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    ...useProductVariables,
    isRiu: false,
    isActive: true,
  };
};
