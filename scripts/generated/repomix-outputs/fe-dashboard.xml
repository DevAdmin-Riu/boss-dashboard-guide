export const handleClickExcelDownload = (
  dataSource: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node[],
  urlEnum: AdminMonthlySettlementUrlEnum
) => {
  try {
    showDownloadingMessage();
    const { rows, colsInfo, header, merges } = parseMileageSettlementList(dataSource, urlEnum);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const title = `본부수익금 정산 관리 (${getMileageSettlementNavButtonName(urlEnum)})`;
    excelDownload({ title, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
    showNotificationSuccess(commonMsg.downloadedToXls);
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const mileageSettlementKeysToMerge = {
  brand: "[브랜드 정보]",
  md: "[담당 MD]",
  order: "[전체 주문]",
  mileage: "[본부수익금]",
  processedInfo: "[본부수익금 정산처리 정보]",
  status: "[현황]",
};
const parseMileageSettlementList = (
  dataSource: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node[],
  urlEnum: AdminMonthlySettlementUrlEnum
) => {
  const rows = [];

  dataSource.forEach((data, index) => {
    // 구분
    const statDate = moment(data.date).format(onlyMonthFormat);

    // [브랜드정보]
    // 브랜드코드
    const brandCode = data.brand?.code;
    // 브랜드명
    const brandName = data.brand?.name;

    // [담당 MD]
    const brandStaffName = data.brand?.staff ? data.brand?.staff.firstName : "없음";
    // 연락처
    const brandStaffPhone = data.brand?.staff ? transformPhoneNumber(data.brand?.staff.aligoPhone) : "없음";

    // [전체 주문]
    // 매출 (부가세 별도)
    const statTotalPriceExcludeVat = data.totalPriceExcludeVat;
    // 사용 포인트 (부가세 별도)
    const statRcoinsExcludeVat = data.rcoinsExcludeVat;
    // 매입 (부가세 별도)
    const statBrandCostPriceExcludeVat = data.brandCostPriceExcludeVat;
    // 반품배송비 (부가세 별도)
    const statReturnDeliveryFeeExcludeVat = toPriceExcludeVat(data.returnDeliveryFee);
    // 배송비 (부가세 별도)
    const statBrandDeliveryFeeExcludeVat = toPriceExcludeVat(data.brandDeliveryFee);
    // PG결제수수료 (부가세 별도)
    const statBrandPayingChargeExcludeVat = data.brandPayingChargeExcludeVat;

    // [본부수익금]
    // 공급가액
    const statMileageExcludeVat = data.mileageExcludeVat;
    // 세액
    const statMileageVat = calcVatByPriceExcludeVat(data.mileageExcludeVat);
    // 합계금액
    const statMileageIncludeVat = data.mileageExcludeVat + calcVatByPriceExcludeVat(data.mileageExcludeVat);
    // 수익률
    const profitRatioWOPercent = getProfitRatio(data.mileageExcludeVat, data.totalPriceExcludeVat);
    const statProfitRatio = profitRatioWOPercent === 0 ? "-" : `${profitRatioWOPercent}%`;

    // [현황]
    // 상태
    const statusText = getMileageSettlementStatusTextForAdmin(data.settlementStatus);

    // [본부수익금 정산처리 정보]
    // 확정 처리 일시(처리자)
    const settlementConfirmedDate = data.settlementConfirmedDate
      ? `${getDateByFormat(data.settlementConfirmedDate)}(${data.settlementConfirmedUser?.firstName})`
      : "-";
    // 지급요청 일시
    const settlementReviewRequestedDate = getDateByFormat(data.settlementReviewRequestedDate);
    // 지급요청 반려 일시
    const settlementReviewRejectedDate = getDateByFormat(data.settlementReviewRejectedDate);
    // 지급요청 승인 일시(처리자)
    const settlementReviewApprovedDate = data.settlementReviewApprovedDate
      ? `${getDateByFormat(data.settlementReviewApprovedDate)}(${data.settlementReviewApprovedUser?.firstName})`
      : "-";
    // 지급처리 완료 일시(처리자)
    const settlementPaidDate = data.settlementPaidDate
      ? `${getDateByFormat(data.settlementPaidDate)}(${data.settlementPaidUser?.firstName})`
      : "-";

    const stateDate = {
      구분: statDate,
    };
    const brandInfo = {
      [mileageSettlementKeysToMerge.brand + "\n브랜드코드"]: brandCode,
      [mileageSettlementKeysToMerge.brand + "\n브랜드명"]: brandName,
    };
    const mdInfo = {
      [mileageSettlementKeysToMerge.md + "\nMD"]: brandStaffName,
      [mileageSettlementKeysToMerge.md + "\n연락처"]: brandStaffPhone,
    };
    const orderInfo = {
      [mileageSettlementKeysToMerge.order + "\n매출\n" + commonMsg.excludeVat]: statTotalPriceExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n사용 포인트\n" + commonMsg.excludeVat]: statRcoinsExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n매입\n" + commonMsg.excludeVat]: statBrandCostPriceExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n반품배송비\n" + commonMsg.excludeVat]: statReturnDeliveryFeeExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n배송비\n" + commonMsg.excludeVat]: statBrandDeliveryFeeExcludeVat,
      [mileageSettlementKeysToMerge.order + "\nPG결제수수료\n" + commonMsg.excludeVat]: statBrandPayingChargeExcludeVat,
    };
    const mileageInfo = {
      [mileageSettlementKeysToMerge.mileage + "\n공급가액"]: statMileageExcludeVat,
      [mileageSettlementKeysToMerge.mileage + "\n세액"]: statMileageVat,
      [mileageSettlementKeysToMerge.mileage + "\n합계금액"]: statMileageIncludeVat,
      [mileageSettlementKeysToMerge.mileage + "\n수익률"]: statProfitRatio,
    };

    const statusInfo = {
      [mileageSettlementKeysToMerge.status + "\n상태"]: statusText,
    };
    const processedInfo = {
      [mileageSettlementKeysToMerge.processedInfo + "\n확정 처리 일시(처리자)"]: settlementConfirmedDate,
      [mileageSettlementKeysToMerge.processedInfo + "\n지급요청 일시"]: settlementReviewRequestedDate,
      [mileageSettlementKeysToMerge.processedInfo + "\n지급요청 반려 일시"]: settlementReviewRejectedDate,
      [mileageSettlementKeysToMerge.processedInfo + "\n지급요청 승인 일시(처리자)"]: settlementReviewApprovedDate,
      [mileageSettlementKeysToMerge.processedInfo + "\n지급처리 완료 일시(처리자)"]: settlementPaidDate,
    };

    let mergedRows = {
      ...stateDate,
      ...brandInfo,
      ...mdInfo,
      ...orderInfo,
      ...mileageInfo,
    };
    if (urlEnum === AdminMonthlySettlementUrlEnum.ALL_STATUS) {
      mergedRows = { ...mergedRows, ...processedInfo };
    }
    mergedRows = { ...mergedRows, ...statusInfo };
    rows.push(mergedRows);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

export const getMileageSettlementStatusTextForAdmin = (status: BrandMonthlySettlementStatusEnum) => {
  switch (status) {
    case BrandMonthlySettlementStatusEnum.CONFIRMED:
    case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
      return "지급 검토";
    case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
      return "지급 대기";
    case BrandMonthlySettlementStatusEnum.PAID:
      return "지급 완료";
    default:
      return "미확정";
  }
};

export const renderStatDate = (statDate: any, dateType: StatReportingMode) => {
  if (dateType === StatReportingMode.DAILY) {
    return statDate;
  } else if (dateType === StatReportingMode.WEEKLY) {
    const startDate = moment(statDate).format(onlyDateFormat);
    const endDate = moment(statDate).add("6", "d").format(onlyDateFormat)
      ? moment().format(onlyDateFormat)
      : moment(statDate).add("6", "d").format(onlyDateFormat);
    return `${startDate} ~ ${endDate}`;
  } else if (dateType === StatReportingMode.MONTHLY) {
    return moment(statDate).format(onlyMonthFormat);
  } else if (dateType === StatReportingMode.TWICE_PER_MONTH) {
    const date = moment(statDate);
    const day = date.date();

    let startDate;
    let endDate;

    if (day === 1) {
      startDate = date.clone().date(1);
      endDate = date.clone().date(15);
    } else if (day === 16) {
      const lastDay = date.daysInMonth();
      startDate = date.clone().date(16);
      endDate = date.clone().date(lastDay);
    } else {
      throw new Error("정산 기준일은 1일 또는 16일로 기록되어야 합니다.");
    }

    return `${startDate.format("YYYY-MM-DD")} ~ ${endDate.format("YYYY-MM-DD")}`;
  }
  return statDate;
};
