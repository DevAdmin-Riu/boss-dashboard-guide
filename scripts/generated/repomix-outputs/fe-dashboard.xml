import { SalesStatFilterKeys, SalesStatListFilterOpts } from "../../components/SalesStatListPage/filters";
import {
  SalesStatListViewUrlFilters,
  SalesStatListViewUrlFiltersEnum,
  SalesStatListViewUrlFiltersWithMultipleValuesEnum,
  SalesStatListViewUrlQueryParams,
} from "../../urls";

// Brand 필터를 포함한 확장된 SalesStatListVariables 타입
export type SalesStatListFilterVariables = SalesStatListVariables & {
  contractType: BrandContractTypeEnum[];
};

const SALES_STAT_FILTERS_KEY = "salesStatFilters";

export enum SalesStatShowColumnType {
  TOTAL = "TOTAL",
  EXCLUSIVE = "EXCLUSIVE",
  PACKAGING = "PACKAGING",
  FOOD = "FOOD",
  EQUIPMENT = "EQUIPMENT",
}

export function getFilterOpts(params: SalesStatListViewUrlQueryParams): SalesStatListFilterOpts {
  const filterVariables = getSalesStatListFilterVariables(params);
  const todayMoment = moment().startOf("month");
  const columnTypes: SalesStatShowColumnType[] = [];
  if (filterVariables.columns.total) {
    columnTypes.push(SalesStatShowColumnType.TOTAL);
  }
  if (filterVariables.columns.exclusive) {
    columnTypes.push(SalesStatShowColumnType.EXCLUSIVE);
  }
  if (filterVariables.columns.packaging) {
    columnTypes.push(SalesStatShowColumnType.PACKAGING);
  }
  if (filterVariables.columns.food) {
    columnTypes.push(SalesStatShowColumnType.FOOD);
  }
  if (filterVariables.columns.equipment) {
    columnTypes.push(SalesStatShowColumnType.EQUIPMENT);
  }

  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    includeBossMrkt: {
      active: maybe(() => !utils.isEmpty(filterVariables.includeBossMrkt), false),
      value: maybe(() => filterVariables.includeBossMrkt, true),
    },
    isRunning: {
      active: maybe(() => !utils.isEmpty(filterVariables.isRunning), false),
      value: maybe(() => filterVariables.isRunning, true),
    },
    columns: {
      active: maybe(() => !utils.isEmpty(columnTypes), false),
      value: maybe(() => dedupeFilter(columnTypes), []),
    },
    contractType: {
      active: maybe(() => !utils.isEmpty(filterVariables.contractType), true),
      value: maybe(() => dedupeFilter(filterVariables.contractType), []),
    },
  };
}

export function getSalesStatListFilterVariables(params: SalesStatListViewUrlFilters): SalesStatListFilterVariables {
  return {
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    statDate: getGteLteVariablesForMonth({
      gte: params.statDateFrom,
      lte: params.statDateTo,
    }),
    includeBossMrkt: parseBoolean(params.includeBossMrkt, true),
    isRunning: params.isRunning !== undefined ? parseBoolean(params.isRunning, false) : undefined,
    columns: {
      total: maybe(() => params.columns.includes(SalesStatShowColumnType.TOTAL), true),
      exclusive: maybe(() => params.columns.includes(SalesStatShowColumnType.EXCLUSIVE), false),
      packaging: maybe(() => params.columns.includes(SalesStatShowColumnType.PACKAGING), false),
      food: maybe(() => params.columns.includes(SalesStatShowColumnType.FOOD), false),
      equipment: maybe(() => params.columns.includes(SalesStatShowColumnType.EQUIPMENT), false),
    },
    contractType: maybe(() => params.contractType.map((status) => findInEnum(status, BrandContractTypeEnum))),
  };
}

export function getFilterQueryParam(filter: IFilterElement<SalesStatFilterKeys>): SalesStatListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case SalesStatFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, SalesStatListViewUrlFiltersEnum.brandSearch);
    case SalesStatFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        SalesStatListViewUrlFiltersEnum.statDateFrom,
        SalesStatListViewUrlFiltersEnum.statDateTo
      );
    case SalesStatFilterKeys.includeBossMrkt:
      return getSingleValueQueryParam(filter, SalesStatListViewUrlFiltersEnum.includeBossMrkt);
    case SalesStatFilterKeys.isRunning:
      return getSingleValueQueryParam(filter, SalesStatListViewUrlFiltersEnum.isRunning);
    case SalesStatFilterKeys.columns:
      return getMultipleEnumValueQueryParam(
        filter,
        SalesStatListViewUrlFiltersWithMultipleValuesEnum.columns,
        SalesStatShowColumnType
      );
    case SalesStatFilterKeys.contractType:
      return getMultipleEnumValueQueryParam(
        filter,
        SalesStatListViewUrlFiltersWithMultipleValuesEnum.contractType,
        BrandContractTypeEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<SalesStatListViewUrlFilters>(SALES_STAT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  SalesStatListViewUrlQueryParams,
  SalesStatListViewUrlFilters
>({
  ...SalesStatListViewUrlFiltersEnum,
  ...SalesStatListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

