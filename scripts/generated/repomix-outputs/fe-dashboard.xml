                              {columnNameConstant.product.MARKET_LOWEST_PRICE}:{" "}
                              <NumberComponent value={marketLowestPriceExcludeVat} /> (
                              {columnNameConstant.common.SET_DATE}:{" "}
                              {getDateByFormat(marketLowestPriceSetDate, onlyDateFormat)})
                            </Row>
                            <Row>
                              {columnNameConstant.product.MARKET_LOWEST_PRICE} {columnNameConstant.common.SOURCE}:{" "}
                              <TextWithLink text={marketLowestPriceSource} />
                            </Row>
                          </Space>
                        </Descriptions.Item>
                      </Descriptions>
                      <Row gutter={[12, 12]} justify="space-between">
                        <Col span={3}>
                          <Form.Item
                            name={TypeSafeForm.getValidDataIndex(
                              `brandProductVariantsInfo.${variant.id}.forceNoNormalDisplay`
                            )}
                            // NOTE: 값을 mutation을 보낼때 뒤집어서 보내야함. 판매상태와 관계없이 강제로 진열 안하는 flag 이므로.
