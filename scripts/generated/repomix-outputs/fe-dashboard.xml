import { formRuleMsg } from "@assets/messages/commonMsg";
import { RequestBossProductMallPriceInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { NumberComponent } from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { Col, Divider, Form, InputNumber, Modal, Row } from "antd";
import React, { useEffect } from "react";

import { RequestBossProductDetails_requestBossProduct_estimateList } from "../api/types/RequestBossProductDetails";

interface ReqBossProductMallPriceSetModalProps {
  open: boolean;
  loading: boolean;
  // FIX: 여기 부분도 수정 필요한지 확인 해야함 List로 보낼지 단일로 보낼지
  // 하단에 임시로 estimate[0] 으로 사용하고 있음
  estimate: RequestBossProductDetails_requestBossProduct_estimateList;
  onSubmit: (input: RequestBossProductMallPriceInput) => void;
  onClose: () => void;
}

export const ReqBossProductMallPriceSetModal: React.FC<ReqBossProductMallPriceSetModalProps> = (props) => {
  const { open, loading, estimate, onSubmit, onClose } = props;
  const [form] = Form.useForm<RequestBossProductMallPriceInput>();

  const onModalClose = () => {
    form.resetFields();
    onClose();
  };

  const initialValues: RequestBossProductMallPriceInput = { mallProductPriceExcludeVat: null, estimate: null };
  const brandProductPriceExcludeVat = estimate?.brandProductPriceExcludeVat;
  const brandDeliveryFeeExcludeVat = estimate?.brandDeliveryFeeExcludeVat;

  useEffect(() => {
    form.resetFields();
  }, [open]);

  return (
    <Modal
      forceRender
      destroyOnClose
      title="견적 확정"
      open={open}
      onOk={form.submit}
      confirmLoading={loading}
      onCancel={onModalClose}
      maskClosable={false}
    >
      <Row justify="end">
        <TableVatLegend isIncludeVat={false} />
      </Row>
      <Form form={form} layout="vertical" initialValues={initialValues} onFinish={onSubmit}>
        <Row gutter={[8, 8]} align="middle" justify="space-between">
          <Col xs={24} sm={7}>
            <Form.Item style={{ margin: 0 }} label="브랜드 상품가">
              <NumberComponent value={brandProductPriceExcludeVat} />
            </Form.Item>
          </Col>
          <Col xs={24} sm={1}>
            +
          </Col>
          <Col xs={24} sm={7}>
            <Form.Item style={{ margin: 0 }} label="브랜드 배송비">
              <NumberComponent value={brandDeliveryFeeExcludeVat} />
            </Form.Item>
          </Col>
          <Col xs={24} sm={1}>
            =
          </Col>
          <Col xs={24} sm={7}>
            <Form.Item style={{ margin: 0 }} label="브랜드 판매가">
              <NumberComponent value={brandProductPriceExcludeVat + brandDeliveryFeeExcludeVat} />
            </Form.Item>
          </Col>
          <Divider style={{ margin: 0 }} />
          <Col xs={24} sm={24}>
            <Form.Item
              name="mallProductPriceExcludeVat"
              label="매장 판매가"
              rules={[{ required: true, type: "integer", min: 1, message: formRuleMsg.min(1) }]}
            >
              <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: "100%" }} />
            </Form.Item>
          </Col>
        </Row>
      </Form>
    </Modal>
  );
};
