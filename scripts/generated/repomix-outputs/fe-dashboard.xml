<file path="src/app/views/purchase/purchases/utils.ts">
import { PurchaseOrderEventType, PurchaseStatus, PurchaseType } from "@src/api/types/globalTypes";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import moment, { Moment } from "moment";

import { getPurchaseOrderEventTypeText } from "../purchaseOrders/utils";
import { PurchaseListViewRouteParams, PurchaseListViewUrlQueryParams } from "./urls";
import {
  getPurchaseTypeFilterVariablesFromPurchaseRouteParams,
  getStatusFilterVariableFromPurchaseRouteParams,
} from "./views/PurchaseListView/filters";

export const checkPurchaseCanceled = (purchaseStatus: PurchaseStatus) => purchaseStatus === PurchaseStatus.CANCELED;

// 리우 -> 협력사로 매입 검토 요청 가능 여부 체크
export const checkPurchasePendingAvailable = (purchaseStatus: PurchaseStatus) =>
  [PurchaseStatus.STANDBY, PurchaseStatus.REVISION].includes(purchaseStatus);

// 매입 확정(대행 매입 확정) 가능 여부 체크
export const checkPurchaseCloseAvailable = (purchaseStatus: PurchaseStatus) =>
  [PurchaseStatus.PENDING].includes(purchaseStatus);

// 리우에서 매입 내용 수정 가능 여부 체크
export const checkPurchaseUpdateAvailable = (purchaseStatus: PurchaseStatus) =>
  [PurchaseStatus.STANDBY, PurchaseStatus.REQ_REVISION, PurchaseStatus.REVISION].includes(purchaseStatus);

// 리우에서 매입 취소 가능 여부 체크
export const checkPurchaseCancelAvailable = (purchaseStatus: PurchaseStatus) =>
  checkPurchaseCanceled(purchaseStatus) === false && checkPurchaseUpdateAvailable(purchaseStatus);

export const getPurchaseTypeText = (type: PurchaseType, isB2b: boolean) =>
  getPurchaseOrderEventTypeText(type as unknown as PurchaseOrderEventType, isB2b);

export const purchaseStatusChoices = [
  { label: "대기", value: PurchaseStatus.STANDBY },
  { label: "검토", value: PurchaseStatus.PENDING },
  { label: "수정 요청", value: PurchaseStatus.REQ_REVISION },
  { label: "수정", value: PurchaseStatus.REVISION },
  { label: "마감", value: PurchaseStatus.CLOSED },
  { label: "취소", value: PurchaseStatus.CANCELED },
];
export const getPurchaseStatusText = (status: PurchaseStatus) => {
  const choice = purchaseStatusChoices.find((choice) => choice.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

export const disabledDateForPurchaseClose = (current: Moment) => {
  const today = moment().tz("Asia/Seoul").date();
  const targetDate =
    today <= 16
      ? moment().tz("Asia/Seoul").subtract(1, "month").startOf("month")
      : moment().tz("Asia/Seoul").startOf("month");
  return current && current < targetDate;
};

export const getPurchaseListDefaultParams = (
  routeParams: PurchaseListViewRouteParams,
  isB2b: boolean
): PurchaseListViewUrlQueryParams => {
  const { status } = routeParams;
  const commonParams: PurchaseListViewUrlQueryParams = {
    status: getStatusFilterVariableFromPurchaseRouteParams(routeParams),
    type: getPurchaseTypeFilterVariablesFromPurchaseRouteParams(routeParams, isB2b),
  };

  switch (status) {
    case "pending":
      // 오늘 날짜가 1~10일이면 이전 달, 그렇지 않으면 이번 달을 기본값으로 사용
      const todayMoment = moment();
      const thisMonth = moment().format(onlyMonthFormat);
      const lastMonth = moment().subtract(1, "month").format(onlyMonthFormat);
      const defaultPurchaseCloseMonth = todayMoment.date() <= 10 ? lastMonth : thisMonth;
      return { ...commonParams, purchaseCloseMonth: defaultPurchaseCloseMonth };
    default:
      return { ...commonParams };
  }
};
</file>

