import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { bsOpsCheckReportItemFragmentForReportDetails } from "@src/api/fragments/brandStore";
import { BsOpsRecheckReportItemStatus } from "@src/api/types/globalTypes";
import Loader from "@src/app/components/Loader";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import {
  useBsOpsRecheckReportItemCreateMutation,
  useBsOpsRecheckReportItemStatusUpdateMutation,
} from "../api/mutations";
import { useBsOpsCheckReportDetailsQuery, useBsOpsCheckReportSummaryQuery } from "../api/queries";
import { BsOpsCheckReportDetails_bsOpsCheckReport_items } from "../api/types/BsOpsCheckReportDetails";
import { BsOpsRecheckReportItemStatusUpdateVariables } from "../api/types/BsOpsRecheckReportItemStatusUpdate";
import { BsOpsCheckReportDetailsPage } from "../components/BsOpsCheckReportDetailsPage/BsOpsCheckReportDetailsPage";
import { bsOpsCheckReportListViewUrl } from "../urls";

interface BsOpsCheckReportDetailsViewProps {
  id: string;
}

export const BsOpsCheckReportDetailsView: React.FC<BsOpsCheckReportDetailsViewProps> = ({ id }) => {
  const { user } = useUser();
  const isStaff = user.isStaff;
  const navigate = useNavigator();

  const { data, loading } = useBsOpsCheckReportDetailsQuery({ variables: { id, isStaff } });
  const report = maybe(() => data.bsOpsCheckReport, null);

  const { data: summaryData, loading: summaryLoading } = useBsOpsCheckReportSummaryQuery({
    variables: { reportId: id },
  });
  const summary = maybe(() => summaryData.bsOpsCheckReportSummary, null);

  const [bsOpsRecheckReportItemCreate] = useBsOpsRecheckReportItemCreateMutation({
    onCompleted: (res) =>
      utils.handleOnCompletedWithError(
        res.bsOpsRecheckReportItemCreate.errors,
        "선택한 점검 항목에 대해 재점검 요청되었습니다."
      ),
  });
  const [bsOpsRecheckReportItemStatusUpdate] = useBsOpsRecheckReportItemStatusUpdateMutation({
    onCompleted: (res) => {
      const afterStatus = res.bsOpsRecheckReportItemStatusUpdate.bsOpsRecheckReportItem?.status;
      let successMsg: string;
      switch (afterStatus) {
        case BsOpsRecheckReportItemStatus.RE_REQUESTED:
          successMsg = "선택한 점검 항목이 점검 재요청되었습니다.";
          break;
        case BsOpsRecheckReportItemStatus.COMPLETED:
          successMsg = "선택한 점검 항목이 점검 완료되었습니다.";
          break;
        // 관리자는 재요청, 완료 상태로만 업데이트 가능
        default:
          successMsg = "선택한 점검 항목의 상태가 업데이트되었습니다.";
          break;
      }

      utils.handleOnCompletedWithError(res.bsOpsRecheckReportItemStatusUpdate.errors, successMsg);
    },
  });

  const handleRecheckRequest = (reportItem: BsOpsCheckReportDetails_bsOpsCheckReport_items) => {
    bsOpsRecheckReportItemCreate({
      variables: { input: { reportItem: reportItem.id } },
      update: (cache, { data }) => {
        const newRecheckReportItem = data?.bsOpsRecheckReportItemCreate?.bsOpsRecheckReportItem;
        if (!newRecheckReportItem) {
          return;
        }

        const reportItemCacheId = cache.identify({ __typename: reportItem.__typename, id: reportItem.id });
        const updateFragment = bsOpsCheckReportItemFragmentForReportDetails;
        updateMultipleFragments({
          cache,
          cacheId: reportItemCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "BsOpsCheckReportItemFragmentForReportDetails",
              fieldName: "recheckItem",
              updateFn: (_prev) => newRecheckReportItem,
            },
          ],
        });
      },
    });
  };

  const handleStatusUpdate = async (variables: BsOpsRecheckReportItemStatusUpdateVariables) => {
    const { data } = await bsOpsRecheckReportItemStatusUpdate({ variables });
    const errors = data?.bsOpsRecheckReportItemStatusUpdate.errors || [];
    if (errors.length > 0) {
      return false;
    }
    return true;
  };

  const handleBack = () => {
    navigate(bsOpsCheckReportListViewUrl({ viewType: "list" }));
  };

  const pageLoading = loading || summaryLoading;
  if (pageLoading) {
    return <Loader />;
  }

  return (
    <>
      <BsOpsCheckReportDetailsPage
        user={user}
        report={report}
        summary={summary}
        onRecheckRequest={handleRecheckRequest}
        onStatusUpdate={handleStatusUpdate}
        onBack={handleBack}
      />
    </>
  );
};
