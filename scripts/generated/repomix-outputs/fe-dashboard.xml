<file path="src/app/views/purchase/purchases/components/PurchaseListPage/filters.ts">
import { PurchaseStatus, PurchaseStatusEnum, PurchaseTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import {
  createDateField,
  createMonthField,
  createOneMonthField,
  createOptionsField,
  createTextField,
} from "@utils/filters/fields";
import { findValueInEnum } from "@utils/misc";

import { PurchaseListViewRouteParams } from "../../urls";
import { purchaseStatusChoices } from "../../utils";
import { getStatusFilterVariableFromPurchaseRouteParams } from "../../views/PurchaseListView/filters";

export enum PurchaseFilterKeys {
  purchaseDate = "purchaseDate",
  purchaseOrderDate = "purchaseOrderDate",
  purchaseCloseDate = "purchaseCloseDate",
  purchaseCloseMonth = "purchaseCloseMonth",
  purchaseOrderSearch = "purchaseOrderSearch",
  orderSearch = "orderSearch",
  b2bOrderSearch = "b2bOrderSearch",
  brandSearch = "brandSearch",
  userSearch = "userSearch",
  vendorSearch = "vendorSearch",
  productSearch = "productSearch",
  status = "status",
  type = "type",
}

export interface PurchaseListFilterOpts {
  purchaseDate: FilterOpts<MinMax>;
  purchaseOrderDate: FilterOpts<MinMax>;
  purchaseCloseMonth: FilterOpts<string>;
  purchaseCloseDate: FilterOpts<MinMax>;
  purchaseOrderSearch: FilterOpts<string>;
  orderSearch: FilterOpts<string>;
  b2bOrderSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  status: FilterOpts<PurchaseStatusEnum[]>;
  type: FilterOpts<PurchaseTypeEnum[]>;
}

const {
  purchaseOrder: { PO_TYPE, PO_DATE, PURCHASE_DATE },
  purchase: { SETTLEMENT_MONTH, STATUS },
} = columnNameConstant;

export function createFilterStructure(
  opts: PurchaseListFilterOpts,
  routeParams: PurchaseListViewRouteParams,
  isB2b: boolean
): IFilter<PurchaseFilterKeys> {
  const { fulfilledBy, status } = routeParams;
  let displayOrder = 0;
  const isPendingList = status === "pending";
  const isFulfilledByBossList = fulfilledBy === "boss";
  const availableFilterStatus = getStatusFilterVariableFromPurchaseRouteParams(routeParams).map((status) =>
    findValueInEnum(status, PurchaseStatus)
  );
  const filteredStatusOptions = purchaseStatusChoices.filter((status) => availableFilterStatus.includes(status.value));
  const showStatusFilter = filteredStatusOptions.length > 1;

  const purchaseOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseFilterKeys.purchaseOrderSearch,
      "발주서번호 / 발주상세번호",
      opts.purchaseOrderSearch.value
    ),
    active: opts.purchaseOrderSearch.active,
  };
  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseFilterKeys.orderSearch,
      "주문번호 / 주문상세번호",
      opts.orderSearch.value
    ),
    active: opts.orderSearch.active,
  };
  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseFilterKeys.b2bOrderSearch,
      "주문번호 / 주문상세번호",
      opts.b2bOrderSearch.value
    ),
    active: opts.b2bOrderSearch.active,
  };
  const purchaseCloseDateFilter = {
    ...createMonthField(
      displayOrder++,
      PurchaseFilterKeys.purchaseCloseDate,
      SETTLEMENT_MONTH,
      opts.purchaseCloseDate.value
    ),
    active: opts.purchaseCloseDate.active,
  };
  const purchaseCloseMonthFilter = {
    ...createOneMonthField(
      displayOrder++,
      PurchaseFilterKeys.purchaseCloseMonth,
      SETTLEMENT_MONTH,
      opts.purchaseCloseMonth.value
    ),
    active: opts.purchaseCloseMonth.active,
    isRequired: isPendingList,
  };
  const purchaseOrderDateFilter = {
    ...createDateField(displayOrder++, PurchaseFilterKeys.purchaseOrderDate, PO_DATE, opts.purchaseOrderDate.value),
    active: opts.purchaseOrderDate.active,
  };
  const purchaseDateFilter = {
    ...createDateField(displayOrder++, PurchaseFilterKeys.purchaseDate, PURCHASE_DATE, opts.purchaseDate.value),
    active: opts.purchaseDate.active,
  };
  const statusFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchaseFilterKeys.status,
      STATUS,
      opts.status.value,
      true,
      filteredStatusOptions
    ),
    active: opts.status.active,
    isRequired: true,
  };
  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseFilterKeys.vendorSearch,
      "협력사코드 / 협력사명",
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(displayOrder++, PurchaseFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.userSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(displayOrder++, PurchaseFilterKeys.userSearch, "ID / 사용자명", opts.userSearch.value),
    active: opts.userSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const typeFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchaseFilterKeys.type,
      PO_TYPE,
      opts.type.value,
      true,
      isB2b
        ? [
            {
              label: "B2B 주문",
              value: PurchaseTypeEnum.CONSIGNMENT,
            },
            {
              label: "B2B 반품",
              value: PurchaseTypeEnum.CONSIGNMENT_TAKE_BACK,
            },
          ]
        : [
            {
              label: "초도발주",
              value: PurchaseTypeEnum.INITIAL_ORDER,
            },
            {
              label: "재발주",
              value: PurchaseTypeEnum.REORDER,
            },
            {
              label: "반품",
              value: PurchaseTypeEnum.TAKE_BACK,
            },
            {
              label: "위탁발주",
              value: PurchaseTypeEnum.CONSIGNMENT,
            },
            {
              label: "위탁발주 반품",
              value: PurchaseTypeEnum.CONSIGNMENT_TAKE_BACK,
            },
          ]
    ),
    active: opts.type.active,
    isRequired: true,
  };

  let filters = [];
  const commonFilters = [
    isFulfilledByBossList && purchaseOrderSearchFilter,
    isB2b === false && orderSearchFilter,
    isB2b && b2bOrderSearchFilter,
    isPendingList ? purchaseCloseMonthFilter : purchaseCloseDateFilter,
    isFulfilledByBossList && purchaseOrderDateFilter,
    purchaseDateFilter,
    (isFulfilledByBossList || isB2b) && typeFilter,
    vendorSearchFilter,
    brandSearchFilter,
    userSearchFilter,
    productSearchFilter,
  ].filter(Boolean);

  switch (status) {
    case "standby-or-pending":
    case "revision":
      filters = [showStatusFilter && statusFilter, ...commonFilters];
      break;
    case "pending":
      filters = [...commonFilters];
      break;
    case "closed":
      filters = [...commonFilters];
      break;
    case "all-status":
      filters = [showStatusFilter && statusFilter, ...commonFilters];
      break;
  }
  return filters.filter(Boolean);
}
</file>

