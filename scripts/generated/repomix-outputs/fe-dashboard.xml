import { PermissionEnum } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import { ErrorPageEnum } from "@src/app/components/ErrorPage";
import NotFound from "@src/app/components/NotFound";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { checkHasAnyPermissions } from "@src/app/views/auth/utils";
import { useBpBundlesQuery } from "@src/app/views/brand/brands/api/queries";
import { BpBundlesVariables } from "@src/app/views/brand/brands/api/types/BpBundles";
import {
  HqInfoProductListViewRouteParams,
  hqInfoProductListViewUrl,
  HqInfoProductViewUrlDialog,
  HqInfoProductViewUrlQueryParams,
} from "@src/app/views/hqStaff/hqSection/urls";
import { ListViews } from "@src/global/core/types/types";
import { checkBrandUser, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useMemo } from "react";
import { useParams } from "react-router";

import { useBpvListForHqFilterDownloadQuery, useBpvListForHqQuery } from "../../api/queries";
import { BpvListForHqVariables } from "../../api/types/BpvListForHq";
import HqInfoProductPage from "../../components/HqInfoProductPage/HqInfoProductPage";
import { HqInfoProductListItem } from "../../components/HqInfoProductPage/types";
import { getProductName } from "../../components/HqInfoProductPage/utils";
import { getHqInfoProductPageTitle } from "../../utils";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface HqInfoProductListProps {
  params: HqInfoProductViewUrlQueryParams;
}

export const HqInfoProductView: React.FC<HqInfoProductListProps> = ({ params }) => {
  const routeParams = useParams<HqInfoProductListViewRouteParams>();
  const { pageType } = routeParams;
  const { user } = useAuth();
  const shop = useShop();
  const isBrandUser = checkBrandUser(user);
  const brandId = user?.brand?.id;

  // pageType별 페이지 구분
  const isExclusiveProductPage = pageType === "product";

  const targetUrl = (params: HqInfoProductViewUrlQueryParams) => hqInfoProductListViewUrl(routeParams, params);
  const { navigate } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.HQ_INFO_PRODUCT_LIST,
  });

  const { fetchForDownload } = utils.initListViewDownloadQuery(useBpvListForHqFilterDownloadQuery);

  const filter = getFilterVariables(params);
  const queryVariables: BpvListForHqVariables = React.useMemo(
    () => ({
      first: 500,
      filter: {
        ...filter,
        brand: brandId,
        exclusive: isExclusiveProductPage ? true : filter.exclusive,
      },
    }),
    [params, pageType, brandId]
  );
  const { data, loading, refetch } = useBpvListForHqQuery({
    skip: !brandId,
    variables: queryVariables,
  });

  const bundleQueryVariables: BpBundlesVariables = React.useMemo(
    () => ({
      first: 500,
      filter: {
        brand: brandId,
      },
    }),
    [brandId]
  );

  // 세트상품 데이터 조회
  const { data: bundleData, loading: bundleLoading } = useBpBundlesQuery({
    skip: !brandId,
    variables: bundleQueryVariables,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<HqInfoProductViewUrlDialog, HqInfoProductViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const userPermissions = (user?.userPermissions || []).map((perm) => perm.code);

  const requiredPermissions = [PermissionEnum.MANAGE_HQ_STAT];

  const hasPermissions = isBrandUser ? checkHasAnyPermissions(requiredPermissions, userPermissions) : false;
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  // 데이터 추출 및 상품명 순 정렬 (프론트엔드) - BPV + Bundle 병합
  const variants: HqInfoProductListItem[] = useMemo(() => {
    // 일반 BPV 데이터
    const rawVariants = maybe(() => data.brandProductVariants.edges.map((edge) => edge.node), []);

    // 세트상품 데이터 (전용 상품 페이지인 경우 isExclusive=true 필터링)
    const rawBundles = maybe(() => bundleData.bpBundles.edges.map((edge) => edge.node), []);
    const filteredBundles = isExclusiveProductPage ? rawBundles.filter((bundle) => bundle.isExclusive) : rawBundles;

    // 병합 (Union 타입 사용)
    const mergedData: HqInfoProductListItem[] = [...rawVariants, ...filteredBundles];

    // 상품명 순으로 정렬
    return mergedData.sort((a, b) => {
      const nameA = getProductName(a);
      const nameB = getProductName(b);
      return nameA.localeCompare(nameB, "ko");
    });
  }, [data, bundleData, isExclusiveProductPage]);

  // 로딩 상태 통합
  const isLoading = loading || bundleLoading;

  return hasPermissions ? (
    <>
      <WindowTitle title={getHqInfoProductPageTitle(pageType)} />
      <HqInfoProductPage
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        disabled={isLoading}
        exclusiveVariants={variants}
        pageType={pageType}
        fetchForDownload={fetchForDownload}
        queryVariablesWithoutPagination={queryVariables}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  ) : (
    <NotFound type={ErrorPageEnum.PermissionDenied} />
  );
};
</file>

