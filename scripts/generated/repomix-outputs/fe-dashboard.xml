import { ApolloQueryResult } from "@apollo/client";
import { JobStatusEnum } from "@src/api/types/globalTypes";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrorInfo } from "@utils/notification/wrapperGql";
import { Space, Typography } from "antd";
import React from "react";

import { QueuedTask, TaskData, TaskStatus } from "./types";
import { CheckExportFileStatus } from "./types/CheckExportFileStatus";

function getTaskStatus(jobStatus: JobStatusEnum): TaskStatus {
  switch (jobStatus) {
    case JobStatusEnum.SUCCESS:
      return TaskStatus.SUCCESS;
    case JobStatusEnum.PENDING:
      return TaskStatus.PENDING;
    default:
      return TaskStatus.FAILURE;
  }
}

export async function handleTask(task: QueuedTask): Promise<TaskStatus> {
  let status = TaskStatus.PENDING;
  let url = "";
  try {
    const completedTaskData = await task.handle();
    status = completedTaskData.status;
    url = completedTaskData.url;
    if (status !== TaskStatus.PENDING) {
      task.onCompleted({
        status,
        url,
      });
    }
  } catch (error) {
    task.onError(error);
  }

  return status;
}

export function handleError(error: Error) {
  throw error;
}

export function queueCustom(id: number, tasks: React.MutableRefObject<QueuedTask[]>, data: TaskData) {
  (["handle", "onCompleted"] as Array<keyof TaskData>)
    .filter((field) => !data[field])
    .forEach((field) => {
      throw new Error(`${field} is required when creating custom task`);
    });
  tasks.current = [
    ...tasks.current,
    {
      handle: data.handle,
      id,
      onCompleted: data.onCompleted,
      onError: data.onError || handleError,
      status: TaskStatus.PENDING,
    },
  ];
}

export function queueExport(
  id: number,
  tasks: React.MutableRefObject<QueuedTask[]>,
  fetch: () => Promise<ApolloQueryResult<CheckExportFileStatus>>
) {
  tasks.current = [
    ...tasks.current,
    {
      handle: async () => {
        const result = await fetch();
        const status = result.data.exportFile.status;
        const url = result.data.exportFile.url;

        return { status: getTaskStatus(status), url };
      },
      id,
      onCompleted: (data) => {
        if (data.status === TaskStatus.SUCCESS) {
          const successNode = (
            <Space direction="vertical">
              <Typography.Text>상품 리스트 다운로드가 완료되었습니다.</Typography.Text>
              <Typography.Text>
                이전에 출력한 상품리스트를 다시 보려면 상품리스트 다운로드 내역에서 다시보기 하실 수 있습니다.
              </Typography.Text>
              {data.url && (
                <Typography.Link href={data.url} onClick={() => notification.destroy()}>
                  상품 리스트 다운로드
                </Typography.Link>
              )}
            </Space>
          );
          const notification = showNotificationSuccess(successNode, false);
        } else {
          showGqlErrorInfo("Export task 오류", data.status);
        }
      },
      onError: handleError,
      status: TaskStatus.PENDING,
    },
  ];
}
</file>

