      if (isBpBundle(record)) {
        return record.isOnlyPayableByCash ? "O" : "X";
      }
      return record.brandProduct.isOnlyPayableByCash ? "O" : "X";
    },
  };

  const brandPriceExcludeVatColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.brandProduct.BRAND_SALE_PRICE[0],
    key: "brandPriceExcludeVat",
    align: "right",
