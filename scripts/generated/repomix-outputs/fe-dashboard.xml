import { OrderTypeEnum, SalesB2bStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { SalesB2bStatusChoices } from "@src/app/views/b2b/utils";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";
import { findValueInEnum } from "@utils/misc";

import { HqB2bSettlementListViewRouteParams } from "../../urls";
import { getDefaultSalesB2bStatusListForHqB2bSettlementList } from "../../utils";

export enum HqB2bSettlementFilterKeys {
  b2bOrderSearch = "b2bOrderSearch", // b2b 주문번호/주문상세번호
  brandProductSearch = "brandProductSearch", // 상품코드/상품명
  salesCloseDate = "salesCloseDate", // 정산월
  b2bOrderCreatedAt = "b2bOrderCreatedAt", // b2b 주문일
  b2bInvoicePrintedAt = "b2bInvoicePrintedAt", // b2b 납품일
  b2bStatus = "b2bStatus", // 검토상태
  orderType = "orderType", // 주문 구분 (B2B 주문, B2B 반품) orderType
}

export interface HqB2bSettlementListFilterOpts {
  b2bOrderSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  salesCloseDate: FilterOpts<MinMax>;
  b2bOrderCreatedAt: FilterOpts<MinMax>;
  b2bInvoicePrintedAt: FilterOpts<MinMax>;
  b2bStatus: FilterOpts<SalesB2bStatusEnum[]>;
  orderType: FilterOpts<OrderTypeEnum[]>;
}

export function createFilterStructure(
  opts: HqB2bSettlementListFilterOpts,
  routeParams: HqB2bSettlementListViewRouteParams
): IFilter<HqB2bSettlementFilterKeys> {
  let displayOrder = 0;
  const availableFilterStatus = getDefaultSalesB2bStatusListForHqB2bSettlementList(routeParams).map((status) =>
    findValueInEnum(status, SalesB2bStatusEnum)
  );
  const filteredStatusOptions = SalesB2bStatusChoices.filter((status) => availableFilterStatus.includes(status.value));
  const showStatusFilter = filteredStatusOptions.length > 1;

  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      HqB2bSettlementFilterKeys.b2bOrderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.b2bOrderSearch.value
    ),
    active: opts.b2bOrderSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      HqB2bSettlementFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const salesCloseDateFilter = {
    ...createMonthField(displayOrder++, HqB2bSettlementFilterKeys.salesCloseDate, "정산월", opts.salesCloseDate.value),
    active: opts.salesCloseDate.active,
  };
  const b2bOrderCreatedAtFilter = {
    ...createDateField(
      displayOrder++,
      HqB2bSettlementFilterKeys.b2bOrderCreatedAt,
      "주문일",
      opts.b2bOrderCreatedAt.value
    ),
    active: opts.b2bOrderCreatedAt.active,
  };
  const b2bInvoicePrintedAtFilter = {
    ...createDateField(
      displayOrder++,
      HqB2bSettlementFilterKeys.b2bInvoicePrintedAt,
      "납품일",
      opts.b2bInvoicePrintedAt.value
    ),
    active: opts.b2bInvoicePrintedAt.active,
  };

  const statusFilter = {
    ...createOptionsField(
      displayOrder++,
      HqB2bSettlementFilterKeys.b2bStatus,
      "검토상태",
      opts.b2bStatus.value,
      true,
      filteredStatusOptions
    ),
    active: opts.b2bStatus.active,
    isRequired: true,
  };

  const typeFilter = {
    ...createOptionsField(
      displayOrder++,
      HqB2bSettlementFilterKeys.orderType,
      "주문 구분",
      opts.orderType.value,
      true,
      [
        {
          label: "B2B 주문",
          value: OrderTypeEnum.BY_STAFF_FOR_B2B,
        },
        {
          label: "B2B 반품",
          value: OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK,
        },
      ]
    ),
    active: opts.orderType.active,
  };

  const filters: IFilter<HqB2bSettlementFilterKeys> = [
    showStatusFilter && statusFilter,
    b2bOrderSearchFilter,
    brandProductSearchFilter,
    salesCloseDateFilter,
    b2bOrderCreatedAtFilter,
    b2bInvoicePrintedAtFilter,
    typeFilter,
  ].filter(Boolean);
  return filters;
}
</file>

