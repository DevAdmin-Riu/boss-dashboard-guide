import { OrderChargeStatusFilter, OrderLineFilterInput, OrderPayMethodFilter } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  HqOrderLineListViewUrlFilters,
  HqOrderLineListViewUrlFiltersEnum,
  HqOrderLineListViewUrlFiltersWithMultipleValuesEnum,
  HqOrderLineListViewUrlQueryParams,
} from "../../../hqSection/urls";
import { HqOrderLineListFilterKeys, HqOrderLineListFilterOpts } from "../../components/HqOrderLineListPage/filters";

const HQ_ORDER_LINE_LIST_FILTERS_KEY = "hqOrderLineListFilters";

// 직거래 상품 주문이 아닐 경우, 검색 또는 표시할 협력사명
export const vendorNameForNonFulfilledByVendor = "포장보스";

export function getFilterOpts(params: HqOrderLineListViewUrlFilters): HqOrderLineListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    orderCreated: {
      active: maybe(() => !utils.allEmpty([filterVariables.orderCreated.gte, filterVariables.orderCreated.lte]), false),
      value: {
        max: maybe(() => filterVariables.orderCreated.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.orderCreated.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: filterVariables.orderSearch || "",
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: filterVariables.brandStoreSearch || "",
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: filterVariables.userSearch || "",
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: filterVariables.brandProductSearch || "",
    },
    fulfillVendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.fulfillVendorSearch, true), false),
      value: filterVariables.fulfillVendorSearch || "",
    },
    isFulfilledByVendor: {
      active: maybe(() => !utils.isEmpty(filterVariables.isFulfilledByVendor), false),
      value: maybe(() => filterVariables.isFulfilledByVendor, false),
    },
    chargeStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.chargeStatus), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.chargeStatus.map((chargeStatus) => findValueInEnum(chargeStatus, OrderChargeStatusFilter))
          ),
        [OrderChargeStatusFilter.PENDING]
      ),
    },
    payMethod: {
      active: maybe(() => !utils.isEmpty(filterVariables.payMethod), false),
      value: maybe(
        () =>
          dedupeFilter(filterVariables.payMethod.map((payMethod) => findValueInEnum(payMethod, OrderPayMethodFilter))),
        []
      ),
    },
  };
}

export function getFilterVariables(params: HqOrderLineListViewUrlFilters): OrderLineFilterInput {
  let variablesForFulfillVendor = {};
  // 협력사 필터로 입력된 값이 존재할 경우, 협력사명이 '포장보스'인 경우(보스 상품 주문)와 아닌 경우(직거래 상품 주문)로 나누어 변수 설정
  if (!utils.isEmpty(params.fulfillVendorSearch, true)) {
    const fulfillVendorSearchParam = params.fulfillVendorSearch?.trim();
    if (fulfillVendorSearchParam === vendorNameForNonFulfilledByVendor) {
      variablesForFulfillVendor = { isFulfilledByVendor: false };
    } else {
      variablesForFulfillVendor = {
        fulfillVendorSearch: params.fulfillVendorSearch,
        isFulfilledByVendor: true,
      };
    }
  }

  return {
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    orderSearch: params.orderSearch,
    brandStoreSearch: params.brandStoreSearch,
    userSearch: params.userSearch,
    brandProductSearch: params.brandProductSearch,
    chargeStatus: maybe(() => params.chargeStatus.map((status) => findInEnum(status, OrderChargeStatusFilter))),
    payMethod: maybe(() => params.payMethod.map((status) => findInEnum(status, OrderPayMethodFilter))),
    ...variablesForFulfillVendor,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof HqOrderLineListFilterOpts>
): HqOrderLineListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case HqOrderLineListFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        HqOrderLineListViewUrlFiltersEnum.orderCreatedFrom,
        HqOrderLineListViewUrlFiltersEnum.orderCreatedTo
      );
    case HqOrderLineListFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.orderSearch);
    case HqOrderLineListFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.brandStoreSearch);
    case HqOrderLineListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.userSearch);
    case HqOrderLineListFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.brandProductSearch);
    case HqOrderLineListFilterKeys.fulfillVendorSearch:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.fulfillVendorSearch);
    case HqOrderLineListFilterKeys.isFulfilledByVendor:
      return getSingleValueQueryParam(filter, HqOrderLineListViewUrlFiltersEnum.isFulfilledByVendor);
    case HqOrderLineListFilterKeys.chargeStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqOrderLineListViewUrlFiltersWithMultipleValuesEnum.chargeStatus,
        OrderChargeStatusFilter
      );
    case HqOrderLineListFilterKeys.payMethod:
      return getMultipleEnumValueQueryParam(
        filter,
        HqOrderLineListViewUrlFiltersWithMultipleValuesEnum.payMethod,
        OrderPayMethodFilter
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqOrderLineListViewUrlFilters>(HQ_ORDER_LINE_LIST_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  HqOrderLineListViewUrlQueryParams,
  HqOrderLineListViewUrlFilters
>({ ...HqOrderLineListViewUrlFiltersEnum, ...HqOrderLineListViewUrlFiltersWithMultipleValuesEnum });
