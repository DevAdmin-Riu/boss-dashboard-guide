  getFulfilledByVendorSettlementListTableSettings,
  getFulfilledByVendorSettlementListTableSummary,
} from "./FulfilledByVendorSettlementListTableSettings";
import { handleClickExcelDownload } from "./utils";

export interface FulfilledByVendorSettlementListFilterVariables {
  statDate: DateRangeInput;
  hasApplied: boolean;
  settlementStatus?: BrandMonthlySettlementStatusEnum[];
  brandSearch: string;
  mdSearch: string;
}

interface FulfilledByVendorSettlementListPageProps
  extends FilterPageProps<FulfilledByVendorSettlementFilterKeys, FulfilledByVendorSettlementListFilterOpts> {
  params: FulfilledByVendorSettlementListViewUrlQueryParams;
  filterVariables: FulfilledByVendorSettlementListFilterVariables;
  urlType: UrlListType<AdminMonthlySettlementUrlEnum, FulfilledByVendorSettlementListViewUrlQueryParams>;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  settings: ListSettings<string>;
  dataSource: BrandFbvSettlements_brandFbvSettlements_edges_node[];
  loading: boolean;
  refetch: () => void;
  ListNavigator: () => React.ReactNode;
}

export enum FulfilledByVendorSettlementListConfirmModalModeEnum {
  CreateData = "CreateData",
  CreateBulkData = "CreateBulkData",
  ReviewData = "ReviewData",
  CheckData = "CheckData",
  TransferDoneData = "TransferDoneData",
  TransferDoneBulkData = "TransferDoneBulkData",
}

export const FulfilledByVendorSettlementListPage: React.FC<FulfilledByVendorSettlementListPageProps> = (props) => {
  const {
    urlType,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    dataSource,
    loading: tableLoading,
    refetch,
    ListNavigator,
  } = props;
  const filterStructure = createFilterStructure(
    filterOpts,
    urlType.urlEnum === AdminMonthlySettlementUrlEnum.ALL_STATUS
  );
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [createData, setCreateData] = useState<BrandFbvSettlementCreateVariables>(null);
  const [settlementUpdateDataId, setUpdateSettlementDataId] = useState<string>(null);
  const [selectedData, setSelectedData] = useState<BrandFbvSettlements_brandFbvSettlements_edges_node[]>([]);
  const [confirmModalMode, setConfirmModalMode] = useState<FulfilledByVendorSettlementListConfirmModalModeEnum>(null);
  const [formForReview] = Form.useForm();

  const [settlementCreate, createMutationOpts] = useBrandFbvSettlementCreateMutation({
    onCompleted: (data) => {
      if (data.brandFbvSettlementCreate.errors.length > 0) {
        showNotificationError(data.brandFbvSettlementCreate.errors[0].message);
      } else {
        showNotificationSuccess(`${transformIsFBV(true)} 상품 대금이 확정되었습니다.`);
        setConfirmModalMode(null);
        setCreateData(null);
        refetch();
      }
    },
  });

  const [settlementUpdate, updateMutationOpts] = useBrandFbvSettlementUpdateMutation({
    onCompleted: (data) => {
      if (data.brandFbvSettlementUpdate.errors.length > 0) {
        showNotificationError(data.brandFbvSettlementUpdate.errors[0].message);
      } else {
        showNotificationSuccess("처리 되었습니다.");
        setConfirmModalMode(null);
        setUpdateSettlementDataId(null);
        refetch();
      }
    },
  });

  const [settlementBulkCreate, createBulkMutationOpts] = useBrandFbvSettlementBulkCreateMutation({
    onCompleted: (data) => {
      if (data.brandFbvSettlementBulkCreate.errors.length > 0) {
        showNotificationError(data.brandFbvSettlementBulkCreate.errors[0].message);
      } else {
        showNotificationSuccess(`${transformIsFBV(true)} 상품 대금이 일괄 확정되었습니다.`);
        setConfirmModalMode(null);
        setCreateData(null);
        refetch();
      }
    },
  });

  const [settlementBulkUpdate, updateBulkMutationOpts] = useBrandFbvSettlementBulkUpdateMutation({
    onCompleted: (data) => {
      if (data.brandFbvSettlementBulkUpdate.errors.length > 0) {
        showNotificationError(data.brandFbvSettlementBulkUpdate.errors[0].message);
      } else {
        showNotificationSuccess(`${transformIsFBV(true)} 상품 대금이 일괄 지급처리 되었습니다.`);
        setConfirmModalMode(null);
        setCreateData(null);
        refetch();
      }
    },
  });

  const loading =
    tableLoading ||
    createMutationOpts.loading ||
    createBulkMutationOpts.loading ||
    updateMutationOpts.loading ||
    updateBulkMutationOpts.loading;

  const columns = getFulfilledByVendorSettlementListTableSettings(
    StatReportingMode.TWICE_PER_MONTH,
    urlType.urlEnum,
    setCreateData,
    setUpdateSettlementDataId,
    setConfirmModalMode,
    loading
  );
  const { pickColumns, pickerSelectedColumns, initialColumns, createPickSummaryColumns } = utils.getPickColumns(
    columns,
    props.settings.columns
  );
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const handleConfirmModalOk = () => {
    switch (confirmModalMode) {
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateData:
        handleCreate();
        break;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateBulkData:
        handleBulkCreate();
        break;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneData:
        handleTransferDone();
        break;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        handleTransferDoneBulkData();
        break;
      default:
        break;
    }
  };

  const handleCreate = () => {
    settlementCreate({ variables: createData });
  };

  const handleBulkCreate = () => {
    const inputData: BrandFbvSettlementCreateInput[] = selectedData.map((data) => ({
      brand: data.brand?.id,
      date: data.date,
      totalPriceExcludeVat: data.totalPriceExcludeVat,
      totalPriceIncludeVat: data.totalPriceIncludeVat,
      brandCostPriceExcludeVat: data.brandCostPriceExcludeVat,
      brandCostPriceIncludeVat: data.brandCostPriceIncludeVat,
      brandPayingChargeExcludeVat: data.brandPayingChargeExcludeVat,
      brandPayingChargeIncludeVat: data.brandPayingChargeIncludeVat,
      costPriceExcludeVat: data.costPriceExcludeVat,
      costPriceIncludeVat: data.costPriceIncludeVat,
    }));

    settlementBulkCreate({ variables: { input: inputData } });
  };

  const handleTransferDone = () => {
    settlementUpdate({
      variables: {
        id: settlementUpdateDataId,
        input: {
          settlementStatus: BrandMonthlySettlementStatusEnum.PAID,
        },
      },
    });
  };

  const handleTransferDoneBulkData = () => {
    // id만 추출해서 ids를 만든다.
    const ids = selectedData.map((data) => data.id);
    settlementBulkUpdate({
      variables: {
        ids,
        settlementStatus: BrandMonthlySettlementStatusEnum.PAID,
      },
    });
  };

  const handleClickBulkTransferDoneButton = () => {
    setConfirmModalMode(FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneBulkData);
  };
  const handleClickBulkCreateButton = () => {
    setConfirmModalMode(FulfilledByVendorSettlementListConfirmModalModeEnum.CreateBulkData);
  };

  const rowSelection: TableRowSelection<any> = {
    fixed: true,
    onChange: (_selectedRowKeys, selectedRows) => setSelectedData(selectedRows),
  };

  const getRowSelection = (): TableRowSelection<any> | null => {
    if (
      urlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED ||
      urlType.urlEnum === AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT
    ) {
      return rowSelection;
    } else {
      return null;
    }
  };

  const makeExtraHandleUi = () => {
    if (urlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED) {
      return (
        <Space>
          <Button
            type="primary"
            shape="round"
            loading={loading}
            onClick={handleClickBulkCreateButton}
            disabled={selectedData.length === 0}
          >
            일괄 확정 처리
          </Button>
        </Space>
      );
    } else if (urlType.urlEnum === AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT) {
      return (
        <Space>
          <Button
            type="primary"
            shape="round"
            loading={loading}
            onClick={handleClickBulkTransferDoneButton}
            disabled={selectedData.length === 0}
          >
            일괄 지급 처리
          </Button>
        </Space>
      );
    } else {
      return null;
    }
  };

  const makeExtraExcelDownloadUi = () => (
    <Button
      type="primary"
      shape="round"
      icon={<DownloadOutlined />}
      loading={loading}
      onClick={() => handleClickExcelDownload(dataSource, urlType.urlEnum)}
      disabled={dataSource.length === 0}
    >
      엑셀 다운로드
    </Button>
  );

  const getModalTitleText = (confirmModalMode: FulfilledByVendorSettlementListConfirmModalModeEnum) => {
    switch (confirmModalMode) {
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateData:
        return `${transformIsFBV(true)} 확정`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateBulkData:
        return `${transformIsFBV(true)} 일괄 확정`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneData:
        return `${transformIsFBV(true)} 지급 처리`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        return `${transformIsFBV(true)} 일괄 지급 처리`;
      default:
        return "";
    }
  };

  const getHelpText = (confirmModalMode: FulfilledByVendorSettlementListConfirmModalModeEnum) => {
    switch (confirmModalMode) {
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateData:
        return `${transformIsFBV(true)} 상품 대금을 확정하시겠습니까?`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.CreateBulkData:
        return `선택된 ${transformIsFBV(true)} 상품 대금을 일괄 확정하시겠습니까?`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneData:
        return `${transformIsFBV(true)} 상품 대금 지급 처리 하시겠습니까?`;
      case FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        return `${transformIsFBV(true)} 상품 대금 일괄 지급 처리 하시겠습니까?`;
      default:
        return "";
    }
  };

  const handleReview = (formData) => {
    settlementUpdate({
      variables: {
        id: settlementUpdateDataId,
        input: {
          rejectReason: !formData.reviewResult ? formData.rejectReason : null,
          settlementStatus:
            formData.reviewResult === true
              ? BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT
              : BrandMonthlySettlementStatusEnum.CONFIRMED,
        },
      },
    });
  };

  const makeConfirmContentNodeForReviewing = () => {
    // settlementUpdateDataId 를 이용해 dataSource에서 값을 찾은다음 fulfilledByVendorInfo를 리턴한다.
    const data = dataSource.find((data) => data.id === settlementUpdateDataId);
    const settlementAccountInfo = data?.brand?.settlementAccountInfo;
    const taxInvoiceImageByHqStaffUrl = data?.taxInvoiceImageByHqStaffUrl;
    return (
      <>
        <Space direction="vertical" size="small">
          <Descriptions
            bordered
            size="small"
            labelStyle={{
              width: "100px",
              wordBreak: "keep-all",
              verticalAlign: "middle",
              whiteSpace: "nowrap",
            }}
            column={3}
          >
            <Descriptions.Item span={3} label={"은행명"}>
              {settlementAccountInfo?.bankName}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"계좌번호"}>
              {settlementAccountInfo?.accountNo}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"예금주"}>
              {settlementAccountInfo?.accountOwnerName}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"세금계산서"}>
              {taxInvoiceImageByHqStaffUrl && (
                <Typography.Link href={taxInvoiceImageByHqStaffUrl} target="_blank">
                  세금계산서 파일 열기
                </Typography.Link>
              )}
            </Descriptions.Item>
          </Descriptions>
        </Space>
      </>
    );
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>{ListNavigator()}</Col>
          <Col>
            <Space direction="horizontal" size={24}>
              {makeExtraHandleUi()}
              {makeExtraExcelDownloadUi()}
            </Space>
          </Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={true} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={tableLoading}
            rowKey={(record: BrandFbvSettlements_brandFbvSettlements_edges_node) =>
              `${record.brand?.id}:${record.date}`
            }
            dataSource={dataSource}
            columns={pickerSelectedColumns}
            rowSelection={getRowSelection()}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            summary={(tableData) =>
              getFulfilledByVendorSettlementListTableSummary(tableData, urlType.urlEnum, createPickSummaryColumns)
            }
          />
          <ConfirmModal
            visible={
              confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.CreateData ||
              confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.CreateBulkData ||
              confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneData ||
              confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.TransferDoneBulkData
            }
            modalTitleText={getModalTitleText(confirmModalMode)}
            helpText={getHelpText(confirmModalMode)}
            okText={"확정"}
            okButtonProps={{ loading: createMutationOpts.loading }}
            onOk={handleConfirmModalOk}
            onCancel={() => {
              setConfirmModalMode(null);
              setCreateData(null);
            }}
          />
          <Modal
            key="reviewData"
            open={confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.ReviewData}
            destroyOnClose
            closable={false}
            title={`${transformIsFBV(true)} 지급 검토`}
            cancelText={"뒤로"}
            okText={"확인"}
            onOk={formForReview.submit}
            onCancel={() => {
              setConfirmModalMode(null);
              setUpdateSettlementDataId(null);
            }}
            maskClosable={false}
          >
            <Space direction="vertical" size="small">
              <Typography.Text strong>지급요청건을 승인하거나 반려해 주세요.</Typography.Text>
              <Typography.Text type="warning">
                제출된 세금계산서 및 계좌정보를 확인한 후 지급요청건을 승인하거나 반려해 주세요. 반려시 사유를 꼭
                입력해주세요.
              </Typography.Text>
            </Space>

            {makeConfirmContentNodeForReviewing()}
            <Divider />
            <Form
              preserve={false}
              form={formForReview}
              onFinish={(formData) => handleReview(formData)}
              initialValues={{
                reviewResult: true,
                rejectReason: "",
              }}
            >
              <Form.Item name="reviewResult" label="검토 결과">
                <Radio.Group>
                  <Radio value={true}>승인</Radio>
                  <Radio value={false}>반려</Radio>
                </Radio.Group>
              </Form.Item>
              <Form.Item
                noStyle
                shouldUpdate={(prevValues, currentValues) => prevValues.reviewResult !== currentValues.reviewResult}
              >
                {({ getFieldValue }) => {
                  const radioValue = getFieldValue("reviewResult");
                  if (radioValue === false) {
                    return (
                      <Form.Item
                        name="rejectReason"
                        label="반려 사유"
                        rules={[{ required: true, message: "반려 시 반려 사유를 입력하세요." }]}
                      >
                        <Input.TextArea />
                      </Form.Item>
                    );
                  } else {
                    return null;
                  }
                }}
              </Form.Item>
            </Form>
          </Modal>
          <Modal
            key="checkData"
            open={confirmModalMode === FulfilledByVendorSettlementListConfirmModalModeEnum.CheckData}
            destroyOnClose
            closable={false}
            title={`${transformIsFBV(true)} 지급 정보 조회`}
            maskClosable={true}
            onCancel={() => {
              setConfirmModalMode(null);
            }}
            footer={null}
          >
            {makeConfirmContentNodeForReviewing()}
          </Modal>
        </Card>
      </Space>
    </>
  );
};
</file>

