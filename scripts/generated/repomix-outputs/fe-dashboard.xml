  // const boxImageExist = productImages.length > 2 && !utils.isEmpty(productImages[2].url, true);
  // return boxImageExist ? productImages[2].url : null;
};

const getUniqueLocationName = (record: FulfillmentLinesByVariant_fulfillmentLinesByVariant) => {
  const stockDetailLines = record.fulfillmentLines[0].stockDetailLines;
  if (utils.isEmpty(stockDetailLines)) {
    return "-";
  }
  const locationNameList = stockDetailLines.map((line) => line.rackLocation?.name);
  const uniqueLocationNameList = [...new Set(locationNameList)];
  return uniqueLocationNameList.join(", ");
};

interface IFulfillmentInspectListTableSettingProps {
  form: FormInstance<IFulfillmentInspectForm>;
  onViewFulfillmentInspectDetail: (variantId: string) => void;
}

export const getFulfillmentInspectListTableSetting = (
  props: IFulfillmentInspectListTableSettingProps
): ColumnsType<FulfillmentLinesByVariant_fulfillmentLinesByVariant> => {
  const { form, onViewFulfillmentInspectDetail } = props;
  const manualInspectAllowedWatched = Form.useWatch("manualInspectAllowed", form);
  const linesObjWatched = Form.useWatch("linesObj", form) || {};

  const columns: ColumnsType<FulfillmentLinesByVariant_fulfillmentLinesByVariant> = [
    {
      title: columnNameConstant.stock.LOCATION,
      key: "locationName",
      align: "center",
      width: 120,
      render: (_, record) => getUniqueLocationName(record),
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.productVariant.sku || "-",
    },
    {
      title: columnNameConstant.fulfillment.ORDER_QUANTITY,
      key: "quantityByVariant",
      align: "center",
      width: 80,
      render: (_, record) => {
        const quantityByVariant = record.fulfillmentLines.reduce((acc, line) => acc + line.quantity, 0);
        return <NumberComponent value={quantityByVariant} />;
      },
    },
    {
      title: columnNameConstant.fulfillment.INSPECTED_QTY,
      key: "inspectedQtyByVariant",
      align: "center",
      width: 80,
      render: (_, record) => {
        const { productVariant, fulfillmentLines } = record;
        const inspectedQtyByVariant = fulfillmentLines.reduce((acc, line) => acc + line.inspectedQty, 0);
        const inspectQtyByVariantWatched = linesObjWatched[productVariant.id]?.inspectQtyByVariant || 0;
        const value = inspectedQtyByVariant + inspectQtyByVariantWatched;

        return (
          <>
            <Form.Item hidden name={["linesObj", productVariant.id, "inspectQtyByVariant"]}>
              <InputNumber />
            </Form.Item>
            <NumberComponent value={value} />
          </>
        );
      },
    },
    {
      title: columnNameConstant.fulfillment.INSPECTED_DONE,
      key: "inspectCompleted",
      align: "center",
      width: 80,
      render: (_, record) => {
        const { productVariant } = record;
        const inspectQtyByVariantWatched = linesObjWatched[productVariant.id]?.inspectQtyByVariant || 0;
        const isCompletedWatched = checkIsInspectCompletedWatched(record, inspectQtyByVariantWatched);
        const onChange = (e: CheckboxChangeEvent) => {
          if (!manualInspectAllowedWatched) {
            return;
          }
          const totalQuantityByVariant = record.fulfillmentLines.reduce((acc, line) => acc + line.quantity, 0);
          const totalInspectedQtyByVariant = record.fulfillmentLines.reduce((acc, line) => acc + line.inspectedQty, 0);
          const totalUninspectedQtyByVariant = totalQuantityByVariant - totalInspectedQtyByVariant;
          const value = e.target.checked ? totalUninspectedQtyByVariant : 0;
          form.setFieldValue(["linesObj", productVariant.id, "inspectQtyByVariant"], value);
        };

        return <Checkbox checked={isCompletedWatched} onChange={onChange} />;
      },
    },
    {
      key: "action",
      align: "center",
      width: 80,
      render: (_, record) => (
        <Button onClick={() => onViewFulfillmentInspectDetail(record.productVariant.id)}>상세 정보</Button>
      ),
    },
  ];
  return columns;
};

