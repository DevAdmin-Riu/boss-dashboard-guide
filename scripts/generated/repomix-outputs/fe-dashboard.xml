<file path="src/app/views/hqStaff/HqTrainingDoc/components/HqTrainingTagModal/HqTrainingTagCreateForm.tsx">
import { User } from "@src/api/fragments/types/User";
import { addEdgeToListCache } from "@src/app/providers/ApolloClientProvider/utils";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Col, Form, FormInstance, Input, Row, Select } from "antd";
import React from "react";

import { useBsTrainingTagCreateMutation } from "../../api/mutations";
import { bsTrainingTagListQuery } from "../../api/queries";
import { BsTrainingTagList, BsTrainingTagList_bsTrainingTagList_edges } from "../../api/types/BsTrainingTagList";
import { BsTrainingTagSimpleBrandList_brands_edges_node } from "../../api/types/BsTrainingTagSimpleBrandList";
import { TrainingDocListViewRouteParams } from "../../urls";
import { convertFilterBsTrainingDocType } from "../../views/HqTrainingDocListView/utils";

interface HqTrainingTagCreateFormProps {
  menuType: TrainingDocListViewRouteParams["menuType"];
  brandList: BsTrainingTagSimpleBrandList_brands_edges_node[];
  user: User;
  form: FormInstance;
  setBrandId: React.Dispatch<React.SetStateAction<string>>;
}

const HqTrainingTagCreateForm: React.FC<HqTrainingTagCreateFormProps> = (props) => {
  const { menuType, brandList, user, form, setBrandId } = props;
  const { isStaff, isHqStaff } = user;

  const [bsTrainingTagCreate, bsTrainingTagCreateOpts] = useBsTrainingTagCreateMutation({
    onCompleted: (data) => {
      const errors = data.bsTrainingTagCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("태그가 추가되었습니다.");
        form.setFieldsValue({
          name: "",
        });
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleBsTrainingTagCreate = async () => {
    const ownerBrand = isHqStaff ? user.brand.id : form.getFieldValue("ownerBrand");
    if (utils.isEmpty(ownerBrand)) {
      showNotificationError("브랜드를 선택해주세요.");
      return;
    }
    if (utils.isEmpty(form.getFieldValue("name"))) {
      showNotificationError("태그명은 1글자 이상이어야 합니다.");
      return;
    }
    await bsTrainingTagCreate({
      variables: {
        input: {
          ownerBrand: isHqStaff ? user.brand.id : ownerBrand,
          name: form.getFieldValue("name"),
          type: convertFilterBsTrainingDocType(menuType),
        },
      },
      update: (cache, { data }) => {
        const newSchedule = data?.bsTrainingTagCreate?.bsTrainingTag;
        addEdgeToListCache<BsTrainingTagList, BsTrainingTagList_bsTrainingTagList_edges>({
          cache,
          query: bsTrainingTagListQuery,
          edgeField: "bsTrainingTagList",
          schemaName: "bsTrainingTagList",
          newNode: newSchedule,
          makeEdges: (prevEdges, newNode) => [
            ...prevEdges,
            { __typename: "BsTrainingTagCountableEdge", node: newNode },
          ],
        });
      },
    });
  };

  const loading = bsTrainingTagCreateOpts.loading;
  return (
    <Form form={form} layout="vertical">
      <Row gutter={[12, 12]} align="middle">
        {isStaff && (
          <Col span={24}>
            <Form.Item name="ownerBrand" label="브랜드">
              <Select
                showSearch
                placeholder="브랜드 검색"
                filterOption={(input, option) => (option?.label ?? "").includes(input)}
                filterSort={(optionA, optionB) =>
                  (optionA?.label ?? "").toLowerCase().localeCompare((optionB?.label ?? "").toLowerCase())
                }
                options={brandList?.map((brand) => ({
                  value: brand.id,
                  label: `${brand.code} | ${brand.name}`,
                }))}
                onChange={(value) => {
                  setBrandId(value);
                }}
              />
            </Form.Item>
          </Col>
        )}
        <Col span={18}>
          <Form.Item name="name" label="태그명">
            <Input />
          </Form.Item>
        </Col>
        <Col span={6}>
          <Button style={{ width: "100%" }} type="primary" onClick={handleBsTrainingTagCreate} disabled={loading}>
            태그 추가
          </Button>
        </Col>
      </Row>
    </Form>
  );
};

export default HqTrainingTagCreateForm;
</file>

