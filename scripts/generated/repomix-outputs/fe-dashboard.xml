import { getCustomerAddressInfo, setCustomerUserAndAddressInfo, validateInputData } from "./utils";

interface CreateAdminOrderViewProps {
  orderType: OrderType;
}

export enum CreateAdminOrderViewModalType {
  SEARCH_ADDRESS = "SEARCH_ADDRESS",
  USER_SETTING = "USER_SETTING",
  PRODUCT_SETTING = "PRODUCT_SETTING",
  BIZ_INFO_SETTING = "BIZ_INFO_SETTING",
  CHANGE_USER_CONFIRM = "CHANGE_USER_CONFIRM",
}

// ✅ 두 type은 brandProductVariant, productVariant의 query를 사용하여 가져온 데이터
// 결국 CreateAdminProductVariantEdgesNode, CreateAdminExtendedProductVariantEdgesNode의 type은 최종 가공을 통해
// TCreateAdminOrderFormLinesObj의 type으로 귀결되어 사용된다.

// ✅ 데이터를 가져오고 난 뒤 brnadProductVariant query 데이터를 가공 전 type
export type CreateAdminProductVariantEdgesNode =
  | CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node
  | CreateAdminAtProductVariantList_productVariants_edges_node;

// ✅ 데이터를 가져오고 난 뒤 brnadProductVariant query 데이터를 가공 후 type
export type CreateAdminExtendedProductVariantEdgesNode =
  | ExtendedBrandProductVariantsNode
  | CreateAdminAtProductVariantList_productVariants_edges_node;

export interface ICreateAdminOrderFormLine {
  id: string;
  sku: string;
  bpSku: string;
  isDefaultVariant?: boolean;
  productName: string;
  brandProductName: string;
  variantName: string;
  attributes: string;
  qtyPerBox: string;
  // NOTE: 부가세 별도로 입력 받는 케이스(b2b 주문)가 있기 때문에 priceExcludeVat, priceVat로 나눠서 관리
  // priceIncludeVat는 부가세 포함으로 입력 받는 페이지에 필드를 표시하기 위해서만 존재. input에는 실제로 전달하지 않음.
  priceIncludeVat: number;
  priceExcludeVat: number;
  priceVat: number;
  qty: number;
  trackInventory: boolean;
  isVendorTrackInventory: boolean;
  isTaxFree: boolean;
  decreaseStockFlag?: boolean;
  b2bDeliveryFeeExcludeVat?: number;
  pricePrecision: number;
  orderQtyPrecision: number;
  isDeferred: boolean;
  excludeStockAvgStats?: boolean;
  moq?: number;
  noteForUnitPrice?: string;
  needDeliveryAdditionalFee: boolean;
  includeSalesB2bDeliveryFee?: boolean;
  isAdjustPrice: boolean;
  qtyPerDeliveryBox: number;
  isPackage?: boolean;
  isBundle?: boolean;
  bundleComponentQtySum?: number;
}
export type TCreateAdminOrderFormLinesObj = Record<string, ICreateAdminOrderFormLine>;

export interface CreateAdminOrderAddressForm {
  firstName: string;
  phone: string;
  postalCode: string;
  streetAddress1: string;
  streetAddress2: string;
}

export interface CreateAdminOrderForm extends CreateAdminOrderAddressForm {
  customerLoginId: string;
  deliveryMethod: OrderDeliveryMethodsEnum;
  fulfillType: FulfillTypeEnum;
  estimatedArrivalDate: string;
  estimatedArrivalDateDoesntMatter: boolean;
  customerNote: string;
  customerUser: SearchCustomersForAdminOrder_search_edges_node | null;
  etcDeliveryFee: number;
  taxInvoiceRequestFlag: boolean;
  calcMileage: boolean;
  decreaseStockFlag: boolean;
  openMallName: string;
  openMallOrderNumber: string;
  staffNote: string;
  additionalFeeForEtcDelivery: number;
  additionalFeeForEtcDeliveryByCourier: number;
  taxInvoiceBizRegNo: string;
  taxInvoiceBizCorpName: string;
  taxInvoiceBizCeoName: string;
  linesObj: TCreateAdminOrderFormLinesObj;
  isB2bTakeBack?: boolean;
  selectAddressMode: boolean;
  selectedAddressId: string | null;
}

const CreateAdminOrderView: React.FC<CreateAdminOrderViewProps> = (props) => {
  const { orderType } = props;
  const navigate = useNavigator();
  const { user, updateUser } = useUser();
  const { isStaff, isHqStaff } = user;
  const [form] = Form.useForm<CreateAdminOrderForm>();
  const [modal, setModal] = React.useState(null);
  const [daumPostcodeOpen, setDaumPostcodeOpen] = React.useState<boolean>(false);
  const [tempCustomerUser, setTempCustomerUser] = React.useState<SearchCustomersForAdminOrder_search_edges_node | null>(
    null
  );
  const [isResetProductList, setIsResetProductList] = React.useState(false);
  const [userAddresses, setUserAddresses] = React.useState<UserAddresses_user_addresses[]>(null);
  const [showDeliveryFeeExcludedModal, setShowDeliveryFeeExcludedModal] = React.useState(false);
  const isByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isByHqStaffForBrand = checkOrderedByHqStaffForBrand(orderType);
  const isByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);
  const isByStaffForEtc = checkOrderedByStaffForEtc(orderType);
  const isByStaffForB2b = checkOrderedByStaffForB2b(orderType);
  const isShowNoteForUnitPriceMode = isByStaffForB2b && isStaff;
  const [addressInfo, setAddressInfo] = React.useState<CreateAdminOrderAddressForm>({} as CreateAdminOrderAddressForm);
  const selectAddressModeWatched = Form.useWatch("selectAddressMode", form);
  const useBpSkuMode = isByStaffForBrand || isByHqStaffForBrand || isByStaffForB2b;
  const isHqStaffB2bOrderMode = isByStaffForB2b && isHqStaff;

  const [userAddressesUserFetch] = useUserAddressesLazyQuery();

  const showStaffNoteMode = checkShowStaffNoteMode(orderType, isStaff);

  const customerUserWatched = Form.useWatch("customerUser", form);
  const selectedAddressIdWatched = Form.useWatch("selectedAddressId", form);
  const linesObjWatched: TCreateAdminOrderFormLinesObj = Form.useWatch("linesObj", form);
  const createFormLinesWatched: ICreateAdminOrderFormLine[] = convertFormLinesObjToArr(linesObjWatched, "id");

  const orderTypeText = convertOrderTypeToWord(orderType, isHqStaff);
  const title = `${orderTypeText} 개별 생성`;

  const [orderBulkCreateByStaffMutation, orderBulkCreateByStaffMutationOpts] = useOrderBulkCreateByStaffMutation({
    onCompleted: (data) => {
      const errors = data.orderBulkCreateByStaff?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess(`${orderTypeText}이 생성 되었습니다.`);
        let targetUrl = null;
        if (isByStaffForBrand) {
          targetUrl = orderListViewUrlB;
        } else if (isByHqStaffForBrand) {
          targetUrl = hqOrderLineListViewUrl;
        } else if (isByStaffForBadStock) {
          targetUrl = orderListViewUrlC;
        } else if (isByStaffForEtc) {
          targetUrl = orderLineDetailListViewUrlD;
        } else if (isByStaffForB2b) {
          targetUrl = () =>
            isStaff
              ? b2bOrderListViewUrl({ status: "accept" })
              : hqB2bOrderLineListViewUrl({ status: "pending-or-rejected" });
        }
        if (isByHqStaffForBrand && data.orderBulkCreateByStaff.hqStaffUser) {
          const updateCashableCredits = data.orderBulkCreateByStaff.hqStaffUser.cashableCredits;
          const updateNonCashableCredits = data.orderBulkCreateByStaff.hqStaffUser.nonCashableCredits;
          updateUser({ ...user, cashableCredits: updateCashableCredits, nonCashableCredits: updateNonCashableCredits });
        }

        navigate(targetUrl());
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [orderListQuery],
  });

  const handleSubmitWithConfirmation = async () => {
    const values = form.getFieldsValue();
    if (
      validateInputData(
        values,
        addressInfo,
        isByStaffForBrand,
        isByStaffForBadStock,
        isByStaffForB2b,
        isByHqStaffForBrand
      ) === false
    ) {
      return;
    }

    // B2B 주문인 경우 배송비 별도 상품 체크
    if (isByStaffForB2b) {
      const createFormLines = convertFormLinesObjToArr(values.linesObj, "id");
      if (hasDeliveryFeeExcludedProducts(createFormLines)) {
        setShowDeliveryFeeExcludedModal(true);
        return;
      }
    }

    onSubmit();
  };

  const onSubmit = async () => {
    const values = form.getFieldsValue();
    const customerUser = values.customerUser;

    const taxInvoiceRequestFlag = values.taxInvoiceRequestFlag;
    const openMallName = values.openMallName;
    const openMallOrderNumber = values.openMallOrderNumber;
    const deliveryMethod = values.deliveryMethod;
    const fulfillType = values.fulfillType;
    const additionalFeeForEtcDelivery = values.additionalFeeForEtcDelivery;
    const additionalFeeForEtcDeliveryByCourier = values.additionalFeeForEtcDeliveryByCourier;

    const estimatedArrivalDate = values.estimatedArrivalDate;
    const staffNote = values.staffNote;
    const customerNote = values.customerNote;

    const etcDeliveryFee = isByStaffForB2b ? 0 : values.etcDeliveryFee;
    const calcMileage = values.calcMileage;
    const isB2bTakeBack = values.isB2bTakeBack;

    const createFormLines = convertFormLinesObjToArr(values.linesObj, "id");

    const getType = (orderType: OrderType): OrderTypeEnum => {
      if (isB2bTakeBack) {
        return OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK;
      }
      return convertOrderTypeToEnum(orderType);
    };

    const orderTypeValue = getType(orderType);

    const input: OrderBulkCreateByStaffInput = {
      details: [
        {
          customerLoginId:
            isByStaffForB2b || isByStaffForBrand || isByHqStaffForBrand ? customerUser.loginId : undefined,
          taxInvoiceRequestFlag: isByStaffForBrand ? taxInvoiceRequestFlag : undefined,
          altInvoiceeBizInfo:
            isByStaffForBrand && taxInvoiceRequestFlag
              ? makeAltInvoiceeBizInfo(values as unknown as IForBrandTemplate)
              : undefined,
          openMallName: isByStaffForBadStock ? openMallName : undefined,
          openMallOrderNumber: isByStaffForBadStock ? openMallOrderNumber : undefined,
          deliveryMethod: isByStaffForB2b
            ? OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE
            : isByStaffForBrand
            ? deliveryMethod
            : isByHqStaffForBrand
            ? OrderDeliveryMethodsEnum.BY_COURIER
            : undefined,
          fulfillType: isByStaffForB2b
            ? FulfillTypeEnum.ALL_CONSIGNMENT
            : deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER
            ? fulfillType
            : null,
          additionalFeeForEtcDelivery: isByStaffForBrand
            ? deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER
              ? additionalFeeForEtcDeliveryByCourier
              : additionalFeeForEtcDelivery
            : undefined,
          estimatedArrivalDate: estimatedArrivalDate ? moment(estimatedArrivalDate).format(onlyDateFormat) : null,
          staffNote: showStaffNoteMode ? staffNote : undefined,
          customerNote,
          shippingAddress: {
            country: CountryCode.KR,
            countryArea: addressInfo.streetAddress1 ? addressInfo.streetAddress1.split(" ")[0] : null,
            firstName: addressInfo.firstName,
            phone: addressInfo.phone,
            postalCode: addressInfo.postalCode,
            streetAddress1: addressInfo.streetAddress1,
            streetAddress2: addressInfo.streetAddress2,
          },
          orderLines: createFormLines.map((product, index) => ({
            bpSku: useBpSkuMode ? product.bpSku : undefined,
            productSku: useBpSkuMode ? undefined : product.sku,
            price: toPricePrecisionFixed(product.priceExcludeVat + product.priceVat, product.pricePrecision),
            priceVat: toPricePrecisionFixed(product.priceVat, product.pricePrecision),
            qty: toPricePrecisionFixed(product.qty, product.orderQtyPrecision),
            decreaseStockFlag: isByStaffForEtc ? product.decreaseStockFlag : undefined,
            calcMileage: isByStaffForBrand ? calcMileage : isByHqStaffForBrand ? true : undefined,
            etcDeliveryFee: index === 0 ? etcDeliveryFee : 0,
            b2bDeliveryFeeExcludeVat:
              isHqStaff || isB2bTakeBack ? 0 : product?.b2bDeliveryFeeExcludeVat ? product.b2bDeliveryFeeExcludeVat : 0,
            excludeStockAvgStats: isByStaffForBrand
              ? product.excludeStockAvgStats || false
              : isByHqStaffForBrand
              ? false
              : undefined,
          })),
        },
      ],
    };

    await orderBulkCreateByStaffMutation({
      variables: {
        type: orderTypeValue,
        input,
        isHqStaff,
      },
    });
  };

  const changeAddressInfo = (
    user: SearchCustomersForAdminOrder_search_edges_node | User,
    refetchAddress: boolean = false
  ) => {
    const newAddressInfo = getCustomerAddressInfo(form, user);
    setAddressInfo(newAddressInfo);
    if (refetchAddress) {
      userAddressesUserFetch({ variables: { id: user?.id } })
        .then((res) => {
          const userAddressesData: UserAddresses_user_addresses[] = res.data?.user?.addresses || [];
          if (userAddressesData && userAddressesData.length > 0) {
            setUserAddresses(userAddressesData);
          } else {
            setUserAddresses(null);
          }
        })
        .catch((e) => {
          showNotificationError("회원 주소록 조회 과정에서 에러가 발생하였습니다");
          throw e;
        });
    }
  };

  const handleDeliverToMe = () => {
    const selectedCustomerUser = form.getFieldValue("customerUser");
    const currentUser = user as unknown as SearchCustomersForAdminOrder_search_edges_node;

    if (utils.isEmpty(selectedCustomerUser)) {
      setCustomerUserAndAddressInfo(form, currentUser);
      changeAddressInfo(currentUser, true);
    } else if (selectedCustomerUser.id === currentUser.id) {
      return;
    } else {
      setTempCustomerUser(currentUser);
      setModal(CreateAdminOrderViewModalType.CHANGE_USER_CONFIRM);
    }
  };

  useEffect(() => {
    if (isHqStaffB2bOrderMode) {
      setCustomerUserAndAddressInfo(form, user);
      changeAddressInfo(user, true);
    }
  }, [isByStaffForB2b, isHqStaff, user, form]);

  useEffect(() => {
    form.setFieldsValue({ selectAddressMode: false });
  }, [useBpSkuMode]);

  return (
    <>
      <Form
        form={form}
        initialValues={{
          taxInvoiceRequestFlag: true,
          deliveryMethod: isByStaffForB2b
            ? OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE
            : OrderDeliveryMethodsEnum.BY_COURIER,
          estimatedArrivalDate: null,
          customerNote: "",
          etcDeliveryFee: 0,
          calcMileage: isByHqStaffForBrand ? true : false,
          decreaseStockFlag: false,
          openMallName: "",
          openMallOrderNumber: "",
          additionalFeeForEtcDelivery: 0,
          additionalFeeForEtcDeliveryByCourier: 0,
          customerChangeReset: false,
          fulfillType: isByStaffForB2b
            ? FulfillTypeEnum.ALL_CONSIGNMENT
            : isByStaffForBrand
            ? FulfillTypeEnum.ALL_TRACK_INVENTORY
            : null,
        }}
        layout="vertical"
      >
        <WindowTitle title={title} />
        <CreateAdminOrderPage
          orderType={orderType}
          onBack={historyBack}
          sectionName={title}
          form={form}
          addressInfo={addressInfo}
          showModal={(type: CreateAdminOrderViewModalType) => setModal(type)}
          isByStaffForBrand={isByStaffForBrand}
          isByStaffForBadStock={isByStaffForBadStock}
          isByStaffForEtc={isByStaffForEtc}
          isByStaffForB2b={isByStaffForB2b}
          createFormLinesWatched={createFormLinesWatched}
          loading={orderBulkCreateByStaffMutationOpts.loading}
          onSubmit={handleSubmitWithConfirmation}
          useBpSkuMode={useBpSkuMode}
          isShowNoteForUnitPriceMode={isShowNoteForUnitPriceMode}
          onDeliverToMe={isByHqStaffForBrand ? handleDeliverToMe : undefined}
          isHqStaffB2bOrderMode={isHqStaffB2bOrderMode}
        />
        <CreateAdminOrderProductListModal
          open={modal === CreateAdminOrderViewModalType.PRODUCT_SETTING}
          onCancel={() => {
            setModal(null);
          }}
          customerUserWatched={customerUserWatched}
          form={form}
          isHqStaff={isHqStaff}
          isByStaffForBrand={isByStaffForBrand}
          isByStaffForB2b={isByStaffForB2b}
          isByHqStaffForBrand={isByHqStaffForBrand}
          createFormLinesWatched={createFormLinesWatched}
          isResetProductList={isResetProductList}
          setIsResetProductList={setIsResetProductList}
        />
        {useBpSkuMode && (
          <CreateAdminOrderUserSearchModal
            open={modal === CreateAdminOrderViewModalType.USER_SETTING}
            onCancel={() => setModal(null)}
            footer={<Button onClick={() => setModal(null)}>닫기</Button>}
            title="회원 검색"
            form={form}
            changeAddressInfo={changeAddressInfo}
            confirmModalOpen={() => setModal(CreateAdminOrderViewModalType.CHANGE_USER_CONFIRM)}
            setTempCustomerUser={setTempCustomerUser}
            isByStaffForB2b={isByStaffForB2b}
            isHqStaff={isByHqStaffForBrand}
            brandId={user?.brand?.id}
            onDeliverToMe={isByHqStaffForBrand ? handleDeliverToMe : undefined}
          />
        )}
        <CreateAdminOrderAddressSetModal
          open={modal === CreateAdminOrderViewModalType.SEARCH_ADDRESS}
          footer={
            daumPostcodeOpen ? (
              <Button onClick={() => setDaumPostcodeOpen(false)}>뒤로</Button>
            ) : (
              <>
                <Button
                  onClick={() => {
                    setModal(null);
                    form.setFieldsValue({ selectAddressMode: false });
                  }}
                >
                  취소
                </Button>
                <Button
                  type="primary"
                  onClick={() => {
                    if (useBpSkuMode && selectAddressModeWatched) {
                      const selectedAddress = userAddresses?.find((address) => address.id === selectedAddressIdWatched);
                      if (selectedAddress) {
                        form.setFieldsValue({
                          firstName: selectedAddress.firstName,
                          phone: utils.isEmpty(selectedAddress.phone)
                            ? ""
                            : transformPhoneNumber(selectedAddress.phone),
                          postalCode: selectedAddress.postalCode,
                          streetAddress1: selectedAddress.streetAddress1,
                          streetAddress2: selectedAddress.streetAddress2,
                        });
                      } else {
                        showNotificationError("선택된 배송지가 없습니다. 주소록에서 배송지를 선택해주세요.");
                        return;
                      }
                    }
                    changeAddressInfo(customerUserWatched);
                    setModal(null);
                    form.setFieldsValue({ selectAddressMode: false });
                  }}
                >
                  변경
                </Button>
              </>
            )
          }
          title="배송지 설정"
          form={form}
          daumPostcodeOpen={daumPostcodeOpen}
          setDaumPostcodeOpen={setDaumPostcodeOpen}
          selectedAddressIdWatched={selectedAddressIdWatched}
          selectAddressModeWatched={selectAddressModeWatched}
          useBpSkuMode={useBpSkuMode}
          customerUserWatched={customerUserWatched}
          userAddresses={userAddresses}
        />
        <CreateAdminBizInfoSetModal
          open={modal === CreateAdminOrderViewModalType.BIZ_INFO_SETTING}
          footer={<Button onClick={() => setModal(null)}>닫기</Button>}
          title="사업자 정보 설정"
          form={form}
        />
        <ConfirmModal
          visible={modal === CreateAdminOrderViewModalType.CHANGE_USER_CONFIRM}
          titleText={isByHqStaffForBrand ? "매장을 변경하시겠습니까 ?" : "회원을 변경하시겠습니까 ?"}
          helpText={
            isByHqStaffForBrand
              ? "매장을 변경하시면 설정된 배송지가 초기화 됩니다."
              : "회원을 변경하시면 설정된 배송지와 기존에 선택된 상품 && 검색된 상품 목록이 초기화 됩니다."
          }
          cancelText="취소"
          okText="변경"
          onOk={() => {
            setCustomerUserAndAddressInfo(form, tempCustomerUser);
            changeAddressInfo(tempCustomerUser, true);
            // 가맹본부가 아닌 경우에만 상품 초기화
            if (!isByHqStaffForBrand) {
              form.setFieldValue("linesObj", {});
              setIsResetProductList(true);
            }
            setTempCustomerUser(null);
            setModal(null);
          }}
          onCancel={() => setModal(null)}
        />
        <DeliveryFeeExcludedConfirmModal
          visible={showDeliveryFeeExcludedModal}
          loading={orderBulkCreateByStaffMutationOpts.loading}
          products={extractDeliveryFeeExcludedProducts(createFormLinesWatched)}
          onConfirm={() => {
            setShowDeliveryFeeExcludedModal(false);
            onSubmit();
          }}
          onCancel={() => setShowDeliveryFeeExcludedModal(false)}
          title="B2B 주문 생성 - 배송비 별도 상품 확인"
          subTitle={<>배송비 별도인 상품이 있으니 생성 전 판매배송비를 모두 입력했는지 확인해주세요.</>}
        />
      </Form>
    </>
  );
};

export default CreateAdminOrderView;
