    tabs,
    sort,
    queryVariablesWithoutPagination,
    isAll,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    fetchForDownload,
    createAdminOrderButtonClick,
    ...listProps
  } = props;
  const orderList = listProps.orders;
  const columns = getOrderTableSettingsIncludeVat(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const filterStructure = createFilterStructure(filterOpts, orderType, isAll);
  const sorterStructure = createSorterStructure(props);
  const isOrderedByUser = checkOrderedByUser(orderType);
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);
  const [modalMode, setModalMode] = useState<OrderListModalModeEnum>(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const sectionName = isAll
    ? sectionNames.allOrders
    : makeNameByOrderType(orderType, sectionNames.orders, false, false);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "orders",
  };

  const makeExtraUi = () => (
    <Space direction="horizontal" size={8}>
      {!isOrderedByUser && (
        <>
          <Button
            type="primary"
            shape="round"
            icon={<ArrowRightOutlined />}
            onClick={() => createAdminOrderButtonClick()}
          >
            개별 주문 생성
          </Button>
          <Button
            type="primary"
            shape="round"
            icon={<UploadOutlined />}
            onClick={() => setModalMode(OrderListModalModeEnum.CreateOrderByStaff)}
          >
            일괄 주문 생성
          </Button>
          <Button
            type={"default"}
            shape={"round"}
            icon={<DownloadOutlined />}
            href={
              (isOrderedByStaffForBrand && `${s3TemplateUrl}/staff_create_order_for_brand.xlsx`) ||
              (isOrderedByStaffForBadStock && `${s3TemplateUrl}/staff_create_order_for_open_mall.xlsx`)
            }
            target="_blank"
          >
            {makeNameByOrderType(orderType, "주문 양식", false, false)}
          </Button>
        </>
      )}
    </Space>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionName}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>
      <Card>
        <SpreadFilterBar<string, OrderListVariables, OrderList, OrderList_orders_edges_node>
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
              <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={true} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={orderList}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
        <OrderCreateByStaffModal
          open={modalMode === OrderListModalModeEnum.CreateOrderByStaff}
          disabled={listProps.disabled}
          orderType={orderType}
          onClose={resetForCloseModal}
        />
      </Card>
    </Space>
  );
};
export default OrderListPage;
</file>

