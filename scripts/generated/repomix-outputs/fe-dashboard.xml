      opts.purchaseOrderSearch.value
    ),
    active: opts.purchaseOrderSearch.active,
  };
  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderDeliveryFilterKeys.b2bOrderSearch,
      "주문번호 / 주문상세번호",
      opts.b2bOrderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.b2bOrderSearch.active,
  };
  const paymentSearchFilter = {
