import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useRackLocationSearch from "@src/api/searches/useRackLocationSearch";
import { maybe } from "@utils/misc";
import { Button, Card, Row, Typography } from "antd";
import React from "react";

import { inspectListData } from "../CustomerRefundQuestionInspectTable/CustomerRefundQuestionInspectTable";
import RefundInspectStockAddItem from "./RefundInspectStockAddItem";

interface RefundInspectStockAddProps {
  refundQuestionId: string;
  inspectList: inspectListData[];
  isInspectStockAdd?: boolean;
  inspectBtnClick: (e: React.MouseEvent<HTMLElement, MouseEvent>, memo: string, rackLocation: string | null) => void;
  finalInspectBtnClick: (inspectList: inspectListData[], refundQuestionId: string) => void;
}

const RefundInspectStockAdd: React.FC<RefundInspectStockAddProps> = (props) => {
  const { refundQuestionId, inspectList, inspectBtnClick, isInspectStockAdd, finalInspectBtnClick } = props;

  if (!inspectList) {
    return <></>;
  }

  const beforeInspectList = inspectList.filter((item) => item.inspect === true && item.inspectInStock === null);
  const okInspectList = inspectList.filter((item) => item.inspectInStock === true);

  const {
    loadMore: loadMoreLocations,
    search: onSearchRackLocations,
    result: searchLocationsOpts,
  } = useRackLocationSearch({ skip: beforeInspectList?.length === 0, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchLocationsOpts.data.search.edges.map((edge) => edge.node), []);
  const fetchMoreRackLocations = {
    hasMore: maybe(() => searchLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchLocationsOpts.loading,
    onFetchMore: loadMoreLocations,
  };

  return (
    <>
      <Card
        title="재고포함 리스트"
        extra={
          <Button
            type="primary"
            disabled={!isInspectStockAdd}
            data-refund-id={refundQuestionId}
            onClick={() => finalInspectBtnClick(inspectList, refundQuestionId)}
          >
            최종 재고포함 확인 후 문의 처리 완료
          </Button>
        }
      >
        {beforeInspectList.length > 0 && (
          <>
            <Typography.Title level={5} style={{ marginBottom: 5 }}>
              재고포함 전
            </Typography.Title>
            <Row gutter={[16, 16]}>
              {beforeInspectList.map((item) => (
                <RefundInspectStockAddItem
                  key={item.id}
                  item={item}
                  inspectBtnClick={inspectBtnClick}
                  searchedRackLocations={searchedRackLocations}
                  fetchMoreRackLocations={fetchMoreRackLocations}
                  onSearchRackLocations={onSearchRackLocations}
                />
              ))}
            </Row>
            <hr style={{ margin: "15px 0" }} />
          </>
        )}
        {okInspectList.length > 0 && (
          <>
            <Typography.Title level={5} style={{ marginBottom: 5 }}>
              재고포함 완료
            </Typography.Title>
            <Row gutter={[16, 16]}>
              {okInspectList.map((item) => (
                <RefundInspectStockAddItem key={item.id} item={item} inspectBtnClick={inspectBtnClick} />
              ))}
            </Row>
          </>
        )}
      </Card>
    </>
  );
};

export default RefundInspectStockAdd;
</file>

<file path="src/app/views/question/components/RefundInspect/RefundInspectStockAddItem.tsx">
import { SearchRackLocations_search_edges_node } from "@src/api/searches/types/SearchRackLocations";
import { getMobileSelectClassName } from "@src/app/components/antd/Select/SelectProps";
import { makeRackLocationLabel } from "@src/app/views/product/stock/components/ProductInfoForStockAction";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { Button, Col, Descriptions, Input, Select, Tag, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import React from "react";

import { inspectListData } from "../CustomerRefundQuestionInspectTable/CustomerRefundQuestionInspectTable";

interface RefundInspectStockAddItemProps {
  item: inspectListData;
  searchedRackLocations?: SearchRackLocations_search_edges_node[];
  fetchMoreRackLocations?: FetchMoreProps;
  onSearchRackLocations?: (value: string) => void;
  inspectBtnClick: (e: React.MouseEvent<HTMLElement, MouseEvent>, memo: string, rackLocation: string | null) => void;
}

const RefundInspectStockAddItem: React.FC<RefundInspectStockAddItemProps> = (props) => {
  const { item, searchedRackLocations, fetchMoreRackLocations, onSearchRackLocations, inspectBtnClick } = props;
  const [rackLocation, setRackLocation] = React.useState<string>(null);
  const [memo, setMemo] = React.useState<string>("");
  const inspectStockAddNullCheck = item.inspectInStock !== null;
  const inspectBoolean = item.inspect;
  const fulfillmentLine = item.fulfillment?.lines[0];

  const rackLocationsFromFulfillmentLine = maybe(
    () => fulfillmentLine?.stockDetailLines.map((stockDetail) => stockDetail.rackStockDetail.location),
    []
  );
  const rackLocations = !!searchedRackLocations
    ? [...rackLocationsFromFulfillmentLine, ...searchedRackLocations]
    : rackLocationsFromFulfillmentLine;
  const locationOptions: DefaultOptionType[] = rackLocations.map((location) => ({
    label: makeRackLocationLabel(location),
    labelText: location.name,
    value: location.id,
  }));

  const memoOnChange = (e) => {
    const target = e.target;
    const value = target.value;
    setMemo(value);
  };

  React.useEffect(() => {
    if (item.inspect !== null) {
      setMemo(item.memo);
    }
  }, [item]);

  return (
    <Col span={6} key={item.id}>
      <div
        style={{
          border: `1px solid #d9d9d9`,
          borderRadius: "5px",
          padding: "8px 12px",
          display: !inspectStockAddNullCheck && "flex",
          justifyContent: !inspectStockAddNullCheck && "center",
          cursor: inspectStockAddNullCheck ? "not-allowed" : "pointer",
          flexDirection: inspectStockAddNullCheck ? "initial" : "column",
          alignItems: "center",
          transition: "all 0.4s",
        }}
      >
        {inspectStockAddNullCheck && (
          <Tag color={inspectBoolean ? "geekblue" : "volcano"}>{inspectBoolean ? "재고 포함" : "검수 불량"}</Tag>
        )}
        <span style={{ marginLeft: 8, flex: 1, textAlign: "center" }}>
          {item.consignment && (
            <Tag color="#f50" style={{ marginRight: 5 }}>
              위탁
            </Tag>
          )}
          {item.uniqueId} - {item.productName}
        </span>
        {inspectStockAddNullCheck ? (
          <>
            <hr />
            <Descriptions>
              <Descriptions.Item label="메모">
                <Typography.Text strong>{item.memo}</Typography.Text>
              </Descriptions.Item>
            </Descriptions>
          </>
        ) : (
          <>
            {item.consignment === false && !!searchedRackLocations && (
              <Select
                showSearch
                size="small"
                style={{ width: "100%" }}
                {...getMobileSelectClassName()}
                placeholder="로케이션 선택"
                notFoundContent="선택 가능한 로케이션이 없습니다."
                loading={fetchMoreRackLocations.loading}
                options={locationOptions}
                onSelect={(value) => setRackLocation(value)}
                value={rackLocation}
                onSearch={onSearchRackLocations}
                onDropdownVisibleChange={(open) => {
                  if (open) {
                    onSearchRackLocations("");
                  }
                }}
                filterOption={(input, option) =>
                  typeof option?.labelText === "string" &&
                  (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())
                }
                onPopupScroll={({ currentTarget }) => {
                  const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                  const { hasMore, loading, onFetchMore } = fetchMoreRackLocations;
                  // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                  if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                    onFetchMore();
                  }
                }}
              />
            )}
            {/* {item.consignment === true && ( */}
            <div style={{ width: "100%", marginTop: 10 }}>
              <Input.TextArea rows={3} placeholder="추가 메모" defaultValue={item.memo} onChange={memoOnChange} />
            </div>
            {/* )} */}
            <div style={{ width: "100%", marginTop: 10 }}>
              <Descriptions>
                <Descriptions.Item label="검수 메모">
                  <Typography.Text strong>{item.memo}</Typography.Text>
                </Descriptions.Item>
              </Descriptions>
            </div>
            <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginTop: 10 }}>
              <Button
                type="primary"
                ghost
                data-id={item.id}
                data-status={true}
                onClick={(e) => {
                  inspectBtnClick(e, memo, inspectStockAddNullCheck ? null : rackLocation);
                }}
              >
                재고 포함
              </Button>
            </div>
          </>
        )}
      </div>
    </Col>
  );
};

export default RefundInspectStockAddItem;
