}

export const BsOpsCheckReportDetailsInfo: React.FC<BsOpsCheckReportDetailsInfoProps> = (props) => {
  const { report, onRecheckRequest } = props;
  const makeTabItemList = () => {
    const { template } = report;
    if (utils.isEmpty(template) || utils.isEmpty(template.categories)) {
      return [];
    }

    const parentCategoryList = template.categories.filter((category) => category.children.length > 0);
    return parentCategoryList.flatMap((parent) => {
      const validChildren = parent.children.filter((child) => child.items.length > 0);
      return validChildren.map((child) => ({
        key: child.id,
        forceRender: true,
        label: `${parent.name} > ${child.name}`,
        children: <BsOpsCheckReportItemList report={report} category={child} onRecheckRequest={onRecheckRequest} />,
      }));
    });
  };

  const tabItemList = makeTabItemList();

  return (
    <Card title={<PageHeader title="상세점검" />}>
      <Tabs destroyInactiveTabPane={false} type="card" defaultActiveKey={tabItemList[0]?.key} items={tabItemList} />
    </Card>
  );
};
