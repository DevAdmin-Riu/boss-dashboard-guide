import { DownloadOutlined, UploadOutlined } from "@ant-design/icons";
import useNavigator from "@hooks/useNavigator";
import { PurchaseOrderLineBulkUpdateInput, PurchaseOrderLineUpdateInput } from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps, DownloadableEditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { flattenColumns, makeOneRowForExcel } from "@src/app/components/Filter/SpreadFilter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { orderDetailsViewUrl } from "@src/app/views/order/orders/urls";
import {
  catchForExcelDownloadError,
  excelDownload,
  loadWorkbookByBuffer,
  makeHeaderRowsAndMerges,
  parseWorksheetToJsonArr,
} from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showNotificationError,
  showNotificationInfo,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Form, Space, Typography } from "antd";
import moment from "moment";
import React, { useRef, useState } from "react";

import {
  PurchaseOrderDetails_purchaseOrder,
  PurchaseOrderDetails_purchaseOrder_lines,
} from "../../api/types/PurchaseOrderDetails";
import { getCheckPurchaseOrderEventTypeResults } from "../../utils";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import { getPurchaseOrderDetailsLinesTableSettings } from "./PurchaseOrderDetailsLinesTableSettings";

interface PurchaseOrderDetailsLinesProps {
  disabled: boolean;
  purchaseOrder: PurchaseOrderDetails_purchaseOrder;
  modalMode: PurchaseOrderModalModeEnum;
  onLineUpdate: (lineId: string, input: PurchaseOrderLineUpdateInput) => Promise<boolean>;
  onLineBulkUpdate: (inputList: PurchaseOrderLineBulkUpdateInput[]) => Promise<boolean>;
  onLineDelete: (lineId: string) => Promise<void>;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
  isStaff?: boolean;
}

export const PurchaseOrderDetailsLines: React.FC<PurchaseOrderDetailsLinesProps> = ({
  disabled,
  purchaseOrder,
  modalMode,
  onLineUpdate,
  onLineBulkUpdate,
  onLineDelete,
  openModalWithoutNavigate,
  isStaff,
}) => {
  const navigate = useNavigator();
  const { courierDeliveryAdditionalFeeList } = useShop();
  const [form] = Form.useForm<PurchaseOrderLineUpdateInput>();
  const [selectedPurchaseOrderLineId, setSelectedPurchaseOrderLineId] = useState<string>("");
  const purchaseOrderLines = maybe(() => purchaseOrder?.lines, []);

  const upload: any = useRef();

  const onOrderNumberClick = (id: string) => navigate(orderDetailsViewUrl(id));

  const { isTrackInventoryPurchaseOrder, isTakeBackPurchaseOrder, isConsignmentTakeBackPurchaseOrder } =
    getCheckPurchaseOrderEventTypeResults(purchaseOrder?.eventType);
  const isInventoryType = isTrackInventoryPurchaseOrder || isTakeBackPurchaseOrder;
  const isTakeBackType = isTakeBackPurchaseOrder || isConsignmentTakeBackPurchaseOrder;
  const isNotSent = purchaseOrder?.isSent === false;

  const formValuesWatched: PurchaseOrderLineUpdateInput = {
    askingPurchaseDate: Form.useWatch("askingPurchaseDate", form),
    quantity: Form.useWatch("quantity", form),
    devCostExcludeVat: Form.useWatch("devCostExcludeVat", form),
    etcExcludeVat: Form.useWatch("etcExcludeVat", form),
  };

  const resetFormField = () => {
    form.resetFields();
    setSelectedPurchaseOrderLineId(undefined);
  };

  const setEditableRow = (record: PurchaseOrderDetails_purchaseOrder_lines) => {
    form.setFields([
      { name: "askingPurchaseDate", value: moment(record.askingPurchaseDate) },
      { name: "quantity", value: record.quantity },
      { name: "etcExcludeVat", value: record.etcExcludeVat },
      { name: "devCostExcludeVat", value: record.devCostExcludeVat },
      { name: "note", value: record.note },
    ]);
    setSelectedPurchaseOrderLineId(record.id);
  };

  const isEditing = (record: PurchaseOrderDetails_purchaseOrder_lines) =>
    record.id === selectedPurchaseOrderLineId && utils.isEmpty(modalMode);
  const onEdit = (record: PurchaseOrderDetails_purchaseOrder_lines) => setEditableRow(record);
  const onCancel = () => resetFormField();
  const onSubmit = async () => {
    const input = form.getFieldsValue();
    const formattedAskingPurchaseDate = moment(input.askingPurchaseDate).format(onlyDateFormat);
    const res = await onLineUpdate(selectedPurchaseOrderLineId, {
      askingPurchaseDate: formattedAskingPurchaseDate,
      devCostExcludeVat: input.devCostExcludeVat,
      etcExcludeVat: input.etcExcludeVat,
      quantity: input.quantity,
      note: input.note,
    });
    if (res === true) {
      resetFormField();
    }
  };
  const columns = getPurchaseOrderDetailsLinesTableSettings({
    disabled,
    purchaseOrder,
    formValuesWatched,
    courierDeliveryAdditionalFeeList,
    onOrderNumberClick,
    openModalWithoutNavigate,
    onLineDelete,
    isEditing,
    onEdit,
    onCancel,
    onSubmit,
    isStaff,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const onExcelDownload = () => {
    try {
      const flattenedColumns = flattenColumns(columns);

      const rows = [];
      purchaseOrderLines.forEach((line, index) => {
        const row = makeOneRowForExcel(line, flattenedColumns, index);
        row["특이사항"] = line.variant.product.defaultVariant.toBeChangedInfo?.detail || "-";
        rows.push(row);
      });

      if (!rows || rows.length === 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
      excelDownload({ title: "발주 제품 리스트", columns: rows, header, merges, skipOriginHeader: true });
      destroyDownloadingMessage();
      showNotificationInfo("파일이 다운로드 되었습니다.");
    } catch (e) {
      catchForExcelDownloadError(e);
    }
  };

  const onExcelDownloadForUpload = () => {
    // 해당 버튼 클릭시 ID(기존테이블에 없음), No, 제품코드, 제품명, 옵션명, 발주수량, 개발비, 개발비용. 이렇게 다운로드 됨.
    const keys = [
      "number",
      "askingPurchaseDate",
      "sku",
      "productName",
      "variantName",
      "quantity",
      "devCostExcludeVat",
      "etcExcludeVat",
    ];

    // columns 중에서 keys에 해당하는 column만 가져옴(children이 있는 경우 children안의 columns도 뒤져서 가져옴)
    const finalColumns = columns.reduce((acc, cur) => {
      if ("children" in cur) {
        return [...acc, ...cur.children.filter((child) => keys.includes(child.key as string))];
      }
      return keys.includes(cur.key as string) ? [...acc, cur] : acc;
    }, []);

    const idColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
      title: "ID",
      key: "lineId",
      renderExcel: (record) => record.id,
    };
    finalColumns.unshift(idColumn);

    const rows = [];

    // 첫번째 로우는 각 키값을 그대로 넣어준다.
    const firstRow = {};
    finalColumns.forEach((column) => {
      firstRow[column.title] = column.key;
    });
    rows.push(firstRow);

    purchaseOrderLines.forEach((line, index) => {
      const row = makeOneRowForExcel(line, finalColumns, index);
      rows.push(row);
    });

    if (!rows || rows.length === 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    excelDownload({ title: "발주제품정보 일괄 수정 양식", columns: rows });
    destroyDownloadingMessage();
    showNotificationInfo("파일이 다운로드 되었습니다.");
  };

  const readUploadFile = (e: React.ChangeEvent<HTMLInputElement>) => {
    e.preventDefault();
    if (e.target.files) {
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const data = e.target.result;
          const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
          const worksheet = workbook.worksheets[0];
          if (!worksheet) {
            throw new Error("엑셀 파일에 시트가 존재하지 않습니다.");
          }

          type PurchaseOrderLineBulkUpdateInputTemp = PurchaseOrderLineUpdateInput & { lineId: string };
          const uploadedDetails = parseWorksheetToJsonArr<PurchaseOrderLineBulkUpdateInputTemp>({ worksheet });
          // uploadedDetails를 PurchaseOrderLineBulkUpdateInput으로 변환하는 로직
          const convertedDetails: PurchaseOrderLineBulkUpdateInput[] = uploadedDetails.map((detail) => {
            const { lineId, ...rest } = detail;

            // date가 숫자인 경우(엑셀에서 수정이 된 경우에 숫자로 변함..)
            // YYYY-MM-DD 형태로 변환
            if (typeof rest.askingPurchaseDate === "number") {
              rest.askingPurchaseDate = moment("1900-01-01")
                .add(rest.askingPurchaseDate - 2, "days")
                .format(onlyDateFormat);
            }
            return {
              id: lineId,
              input: {
                askingPurchaseDate: rest.askingPurchaseDate,
                quantity: rest.quantity,
                devCostExcludeVat: rest.devCostExcludeVat,
                etcExcludeVat: rest.etcExcludeVat,
              },
            };
          });

          await onLineBulkUpdate(convertedDetails);
        } catch (error) {
          showNotificationError(error.message);
        }
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  // {재고 발주}에 "재고 반품이 아니며" && 발송 전인 경우
  const shouldShowUpdateButton: boolean = isTrackInventoryPurchaseOrder && isNotSent;

  const cardTitle = <Typography.Title level={4}>발주제품</Typography.Title>;
  const cardExtra = (
    <Space>
      <Button type={"primary"} disabled={disabled} shape="round" icon={<DownloadOutlined />} onClick={onExcelDownload}>
        엑셀 다운로드
      </Button>
      {isInventoryType && !isTakeBackType && isNotSent && (
        <Button
          type={"primary"}
          disabled={disabled}
          shape="round"
          onClick={() => openModalWithoutNavigate(PurchaseOrderModalModeEnum.AddProduct, null)}
        >
          추가
        </Button>
      )}
      {shouldShowUpdateButton && (
        <>
          <Button
            type="primary"
            disabled={disabled}
            shape="round"
            icon={<DownloadOutlined />}
            onClick={onExcelDownloadForUpload}
          >
            일괄 수정 양식
          </Button>
          <Button
            disabled={disabled}
            shape="round"
            type="default"
            onClick={() => {
              upload.current.click();
            }}
            icon={<UploadOutlined />}
          >
            일괄 수정
          </Button>
          <input
            style={{ display: "none" }}
            ref={upload}
            onChange={(e) => readUploadFile(e)}
            type="file"
            accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
          />
        </>
      )}
    </Space>
  );

  return (
    <>
      <Card title={cardTitle} extra={cardExtra} bodyStyle={{ padding: 0 }}>
        <Form form={form} component={false}>
          <TableVatLegend isIncludeVat={false} size="small" />
          <PatchedColumnsTable
            {...commonTableProps}
            dataSource={purchaseOrderLines}
            columns={columns}
            components={{ body: { cell: EditableCell } }}
            sticky={{ offsetHeader: 80, offsetScroll: 100 }}
            scroll={{ x: tableWidthSum }}
          />
        </Form>
      </Card>
    </>
  );
};
