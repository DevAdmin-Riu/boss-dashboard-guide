      isB2b === false && brandProductNameColumn,
      taxFreeColumn,
      isB2b === false && fulfillmentTypeColumn,
      isListActionForPurchase && isDeferredColumn,
    ].filter(Boolean);

    const vendorInfoColumns = [
      vendorCodeColumn,
      vendorNameColumn,
      ...(isListActionForPurchase ? [vendorContactTypeColumn] : []),
      ...(isListActionFulfilled ? [vendorUnitCostPriceExcludeVatColumn, vendorUpdateColumn] : []),
    ];

    columns = [
      orderComposedIdColumn,
      orderLineComposedIdColumn,
      isListActionForPurchase === false && purchaseOrderLineNumberColumn,
      isListActionForPurchase && paymentStatusColumn,
      orderCreatedColumn,
      isListActionForPurchase && orderCapturedAtColumn,
      isB2b && makeOrderTypeColumn,
      isListActionForPurchase === false && purchaseOrderDateColumn,
      isListActionForFulfill && askingPurchaseDateColumn,
      isListActionForFulfill && expectedPurchaseDateColumn,
      isListActionForPurchase === false && isListActionForFulfill === false && fulfillmentCreatedColumn,
      isB2b && isListActionForFulfill && poLineQuantityColumn,
      isListActionForPurchase === false && purchaseOrderLineStatusColumn,
      { title: isB2b ? "고객사 정보" : "브랜드 정보", children: brandInfoColumns },
      isB2b === false && { title: "매장 정보", children: storeInfoColumns },
      { title: "제품 정보", children: productInfoColumns },
      { title: "협력사 정보", children: vendorInfoColumns },
      orderLineQtyColumn,
      isB2b && b2bDeliveryFeeExcludeVatColumn,
      isListActionForFulfill && { title: "구분", children: [poEventTypeColumn] },
      isB2b && isListActionForFulfill && actionColumn,
