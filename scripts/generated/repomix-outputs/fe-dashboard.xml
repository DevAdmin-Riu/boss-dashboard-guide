<file path="src/app/views/settings/shipping/components/ShippingZoneRateDialog/ShippingZoneRateDialog.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { ShippingZoneDetailsFragment_shippingMethods } from "@src/api/fragments/types/ShippingZoneDetailsFragment";
import { ShippingMethodTypeEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { maybe } from "@utils/misc";
import { Checkbox, Col, Divider, Form, Input, InputNumber, Modal, Row, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

const { Item: FItem } = Form;

export interface IShippingZoneRateForm {
  name: string;
  noLimits: boolean;
  minValue: number;
  maxValue: number;
  isFree: boolean;
  price: number;
  type: ShippingMethodTypeEnum;
}

interface ShippingZoneRateDialogProps {
  open: boolean;
  action: "create" | "edit";
  loading: boolean;
  rate: ShippingZoneDetailsFragment_shippingMethods;
  shippingMethodType: ShippingMethodTypeEnum;
  onClose: () => void;
  onSubmit: (data: IShippingZoneRateForm) => void;
}

const ShippingZoneRateDialog: React.FC<ShippingZoneRateDialogProps> = (props) => {
  const { action, loading, open, rate, shippingMethodType, onClose, onSubmit } = props;
  const [hasChanged, setHasChanged] = useState<boolean>(false);
  const [form] = Form.useForm<IShippingZoneRateForm>();
  const noLimitsWatched = Form.useWatch("noLimits", form);
  const minValueWatched = Form.useWatch("minValue", form);
  const maxValueWatched = Form.useWatch("maxValue", form);
  const isFreeWatched = Form.useWatch("isFree", form);

  const initialValues: IShippingZoneRateForm =
    action === "create"
      ? {
          isFree: false,
          maxValue: null,
          minValue: null,
          name: "",
          noLimits: false,
          price: null,
          type: null,
        }
      : {
          isFree: maybe(() => rate.price.amount === 0, false),
          maxValue:
            shippingMethodType === ShippingMethodTypeEnum.PRICE
              ? maybe(() => rate.maximumOrderPrice.amount, null)
              : maybe(() => rate.maximumOrderWeight.value, null),
          minValue:
            shippingMethodType === ShippingMethodTypeEnum.PRICE
              ? maybe(() => rate.minimumOrderPrice.amount, null)
              : maybe(() => rate.minimumOrderWeight.value, null),
          name: maybe(() => rate.name, ""),
          noLimits: false,
          price: maybe(() => rate.price.amount, null),
          type: shippingMethodType,
        };
  if (action === "edit") {
    initialValues.noLimits = !initialValues.maxValue && !initialValues.minValue;
  }

  useEffect(() => {
    form.resetFields();
  }, [rate]);

  const modalTitle =
    shippingMethodType === ShippingMethodTypeEnum.PRICE
      ? action === "create"
        ? "배송비 추가"
        : "배송비 수정"
      : action === "create"
      ? "Add Weight Rate"
      : "Edit Weight Rate";

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={modalTitle}
      okButtonProps={{ loading, disabled: hasChanged === false }}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={form}
        name="shipping-zone-rate-create-or-update"
        layout="vertical"
        initialValues={initialValues}
        onValuesChange={(changedValues) => {
          if ("noLimits" in changedValues && changedValues.noLimits) {
            form.setFieldsValue({ minValue: null, maxValue: null });
          }
          if ("isFree" in changedValues && changedValues.isFree) {
            form.setFieldsValue({ price: 0 });
          }
          setHasChanged(true);
        }}
        onFinish={onSubmit}
      >
        <Space direction="vertical" size="small">
          <FItem
            name="name"
            label="배송 방법 이름"
            rules={[{ required: true, message: formRuleMsg.required }]}
            extra="회원에게 표시되는 명칭"
          >
            <Input />
          </FItem>
          <Divider style={{ margin: 0 }} />
          <Row justify="end">
            <TableVatLegend size="small" isIncludeVat />
          </Row>
          <FItem
            style={{ margin: 0 }}
            label={
              <Typography.Text strong>
                {shippingMethodType === ShippingMethodTypeEnum.PRICE ? "주문 금액" : "Weight range"}
              </Typography.Text>
            }
            extra={
              <FItem name="noLimits" valuePropName="checked">
                <Checkbox>
                  <Space direction="vertical" size={0}>
                    <Typography.Text>가격 제한 없음</Typography.Text>
                    <Typography.Text type="secondary">
                      {shippingMethodType === ShippingMethodTypeEnum.PRICE
                        ? "주문의 모든 제품에 적용됩니다."
                        : "This rate will apply to all orders of all weights"}
                    </Typography.Text>
                  </Space>
                </Checkbox>
              </FItem>
            }
          >
            <Row justify="space-between" align="middle">
              <Col span={11}>
                <FItem
                  name="minValue"
                  label={
                    shippingMethodType === ShippingMethodTypeEnum.PRICE ? "최소 주문 금액" : "Minimal Order Weight"
                  }
                  rules={[
                    { type: "integer", min: 0, message: formRuleMsg.min(0) },
                    { type: "integer", max: maxValueWatched, message: formRuleMsg.max(maxValueWatched) },
                  ]}
                >
                  <InputNumber disabled={noLimitsWatched} {...getInputNumberProps({ isCommaDisplay: true })} />
                </FItem>
              </Col>
              <Typography.Title level={4}>~</Typography.Title>
              <Col span={11}>
                <FItem
                  name="maxValue"
                  label={
                    shippingMethodType === ShippingMethodTypeEnum.PRICE ? "최대 주문 금액" : "Maximal Order Weight"
                  }
                  rules={[
                    { type: "integer", min: minValueWatched || 0, message: formRuleMsg.min(minValueWatched || 0) },
                  ]}
                >
                  <InputNumber disabled={noLimitsWatched} {...getInputNumberProps({ isCommaDisplay: true })} />
                </FItem>
              </Col>
            </Row>
          </FItem>
          <Divider style={{ margin: 0 }} />
          <Row justify="space-between">
            <Col span={12}>
              <FItem
                name="price"
                label="배송비"
                extra={
                  <FItem name="isFree" valuePropName="checked">
                    <Checkbox>배송비 무료</Checkbox>
                  </FItem>
                }
                rules={[{ type: "integer", min: 0, message: formRuleMsg.min(0) }]}
              >
                <InputNumber disabled={isFreeWatched} {...getInputNumberProps({ isCommaDisplay: true })} />
              </FItem>
            </Col>
          </Row>
        </Space>
      </Form>
    </Modal>
  );
};
export default ShippingZoneRateDialog;
</file>

