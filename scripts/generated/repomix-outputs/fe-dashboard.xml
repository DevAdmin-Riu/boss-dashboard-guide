const getStockProductVariantVendor = (
  productVariant: ProductVariantFragmentForStockVendor
): ProductVariantFragmentForStockVendor_productVariantVendors => {
  const { isInner, outer, defaultVariantVendor, productVariantVendors } = productVariant;
  if (isInner) {
    const outerDefaultVariantVendor = outer?.productVariantVendors?.find(
      (productVariantVendor) => productVariantVendor.id === defaultVariantVendor?.id
    );
    if (!outerDefaultVariantVendor) {
      return null;
    }
    return outerDefaultVariantVendor;
  }

  const findDefaultVariantVendor = productVariantVendors?.find(
    (productVariantVendor) => productVariantVendor.id === defaultVariantVendor?.id
  );
  if (!findDefaultVariantVendor) {
    return null;
  }
  return findDefaultVariantVendor;
};

