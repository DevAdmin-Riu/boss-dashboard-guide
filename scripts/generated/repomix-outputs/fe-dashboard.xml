import {
  FulfillmentFilterInput,
  FulfillmentTrackingNumberEmptyFilter,
  OrderDeliveryMethodsEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  FbvOrderDeliveryListFilterKeys,
  FbvOrderDeliveryListFilterOpts,
} from "../../components/FbvOrderDeliveryListPage/filters";
import {
  FbvOrderDeliveryListViewUrlFilters,
  FbvOrderDeliveryListViewUrlFiltersEnum,
  FbvOrderDeliveryListViewUrlQueryParams,
  FbvOrderDeliveryUrlEnum,
} from "../../urls";

const SALES_STAT_FILTERS_KEY = "salesStatFilters";

export function getFilterOpts(params: FbvOrderDeliveryListViewUrlFilters): FbvOrderDeliveryListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const lastMonth = moment().subtract(1, "months");

  return {
    orderCreated: {
      active: maybe(() => !utils.allEmpty([filterVariables.orderCreated.gte, filterVariables.orderCreated.lte]), false),
      value: {
        max: maybe(() => filterVariables.orderCreated.lte, lastMonth.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.orderCreated.gte, lastMonth.format(onlyMonthFormat)),
      },
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: filterVariables.orderSearch || "",
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
  };
}

export function getFilterVariables(params: FbvOrderDeliveryListViewUrlFilters): FulfillmentFilterInput {
  return {
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    orderSearch: params.orderSearch,
    brandSearch: params.brandSearch,
    productSearch: params.productSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<FbvOrderDeliveryListFilterKeys>
): FbvOrderDeliveryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case FbvOrderDeliveryListFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        FbvOrderDeliveryListViewUrlFiltersEnum.orderCreatedFrom,
        FbvOrderDeliveryListViewUrlFiltersEnum.orderCreatedTo
      );
    case FbvOrderDeliveryListFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, FbvOrderDeliveryListViewUrlFiltersEnum.orderSearch);
    case FbvOrderDeliveryListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, FbvOrderDeliveryListViewUrlFiltersEnum.brandSearch);
    case FbvOrderDeliveryListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, FbvOrderDeliveryListViewUrlFiltersEnum.productSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<FbvOrderDeliveryListViewUrlFilters>(SALES_STAT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  FbvOrderDeliveryListViewUrlQueryParams,
  FbvOrderDeliveryListViewUrlFilters
>({
  ...FbvOrderDeliveryListViewUrlFiltersEnum,
});

export const getFilterVariablesByUrlTypeState = (props: {
  urlTypeState: UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>;
  params: FbvOrderDeliveryListViewUrlQueryParams;
}): FulfillmentFilterInput => {
  const { urlTypeState, params } = props;
  let customFilter: FulfillmentFilterInput = {
    deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
    trackingCompleted: false,
    trackingNumberEmpty: [FulfillmentTrackingNumberEmptyFilter.EMPTY],
  };
  switch (urlTypeState.urlEnum) {
    // 상품 배송
    case FbvOrderDeliveryUrlEnum.FULFILLED:
      customFilter = {
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
        trackingCompleted: false,
        trackingNumberEmpty: [FulfillmentTrackingNumberEmptyFilter.EMPTY],
      };
      break;
    // 배송중 (택배)
    case FbvOrderDeliveryUrlEnum.TRACKING_A:
      customFilter = {
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
        trackingCompleted: false,
        trackingNumberEmpty: [FulfillmentTrackingNumberEmptyFilter.FILLED],
      };
      break;
    // 배송완료 (택배)
    case FbvOrderDeliveryUrlEnum.COMPLETED_A:
      customFilter = {
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
        trackingCompleted: true,
      };
      break;
    // 배송중 (화물차)
    case FbvOrderDeliveryUrlEnum.TRACKING_B:
      customFilter = {
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE],
        trackingCompleted: false,
      };
      break;
    // 배송완료 (화물차)
    case FbvOrderDeliveryUrlEnum.COMPLETED_B:
      customFilter = {
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE],
        trackingCompleted: true,
      };
      break;
  }
  return {
    ...customFilter,
    ...getFilterVariables(params),
  };
};
</file>

