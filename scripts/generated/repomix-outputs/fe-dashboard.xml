import { PurchaseOrderLineStatus, PurchaseOrderLineStatusEnum } from "@src/api/types/globalTypes";

import { PoLineInventoryType, PurchaseOrderLineUrlEnum } from "./urls";

// 구매 주문 라인 상태 정의 - 단일 진실의 원천
export const purchaseOrderLineStatusChoices = [
  {
    label: "작성중",
    value: PurchaseOrderLineStatus.DRAFT,
  },
  {
    label: "접수대기",
    value: PurchaseOrderLineStatus.PENDING,
  },
  {
    label: "거부",
    value: PurchaseOrderLineStatus.REJECTED,
  },
  {
    label: "접수",
    value: PurchaseOrderLineStatus.RECEIVED,
  },
  {
    label: "분할 납품 요청",
    value: PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
  },
  {
    label: "납품 예정일 변경 요청",
    value: PurchaseOrderLineStatus.REQ_EPD_UPDATE,
  },
  {
    label: "출고지시",
    value: PurchaseOrderLineStatus.DISPATCH_FULFILLMENT,
  },
  {
    label: "부분 배송확정",
    value: PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED,
  },
  {
    label: "배송확정",
    value: PurchaseOrderLineStatus.DELIVERY_CONFIRMED,
  },
  {
    label: "거래명세서 출력",
    value: PurchaseOrderLineStatus.INVOICE_PRINTED,
  },
  {
    label: "검수대기",
    value: PurchaseOrderLineStatus.TO_BE_INSPECTED,
  },
  {
    label: "검수완료",
    value: PurchaseOrderLineStatus.INSPECTED,
  },
  {
    label: "입고완료",
    value: PurchaseOrderLineStatus.STOCKED,
  },
  {
    label: "배송완료",
    value: PurchaseOrderLineStatus.DELIVERED,
  },
  {
    label: "취소",
    value: PurchaseOrderLineStatus.CANCELED,
  },
];

// 상태값으로 텍스트 가져오기
export const getPurchaseOrderLineStatusText = (status: PurchaseOrderLineStatus | string) => {
  const choice = purchaseOrderLineStatusChoices.find((c) => c.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

// B2B용 필터링된 상태 목록 (Enum 타입)
export const getPurchaseOrderLineStatusEnumChoices = (isB2b: boolean) => {
  // B2B에서 제외할 상태값들
  const excludedForB2b = [
    PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
    PurchaseOrderLineStatus.PARTIALLY_DELIVERY_CONFIRMED,
    PurchaseOrderLineStatus.STOCKED,
  ];

  return purchaseOrderLineStatusChoices
    .filter((status) => {
      if (isB2b && excludedForB2b.includes(status.value)) {
        return false;
      }
      return true;
    })
    .map((status) => {
      const label = status.label;
      return {
        label,
        value: status.value as unknown as PurchaseOrderLineStatusEnum,
      };
    });
};

// URL과 상태 매핑 정의
export const urlStatusMapping: Record<PurchaseOrderLineUrlEnum, PurchaseOrderLineStatusEnum[]> = {
  // 재고 발주 / 협력사 발주
  [PurchaseOrderLineUrlEnum.DRAFT]: [PurchaseOrderLineStatusEnum.DRAFT],

  // 접수대기 및 거부
  [PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED]: [
    PurchaseOrderLineStatusEnum.REJECTED,
    PurchaseOrderLineStatusEnum.PENDING,
  ],

  // 대행 접수
  [PurchaseOrderLineUrlEnum.RECEIVE]: [PurchaseOrderLineStatusEnum.PENDING],
  [PurchaseOrderLineUrlEnum.DELEGATED_RECEIVE]: [PurchaseOrderLineStatusEnum.PENDING],

  // 생산중
  [PurchaseOrderLineUrlEnum.IN_PRODUCTION]: [
    PurchaseOrderLineStatusEnum.RECEIVED,
    PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
    PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
  ],

  // 대행 출고 지시
  [PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT]: [PurchaseOrderLineStatusEnum.RECEIVED],
  [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT]: [PurchaseOrderLineStatusEnum.RECEIVED],
  [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER]: [PurchaseOrderLineStatusEnum.RECEIVED],
  [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST]: [
    PurchaseOrderLineStatusEnum.RECEIVED,
  ],
  [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_NON_COURIER]: [PurchaseOrderLineStatusEnum.RECEIVED],

  // 납품예정일 변경 요청
  [PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE]: [PurchaseOrderLineStatusEnum.REQ_EPD_UPDATE],

  // 분납 요청
  [PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY]: [PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY],

  // 대행 배송 확정
  [PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY]: [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT],
  [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY]: [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT],
  [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_COURIER]: [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT],
  [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_NON_COURIER]: [
    PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
  ],

  // 거래명세서 출력
  [PurchaseOrderLineUrlEnum.PRINT_INVOICE]: [PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED],

  // 재고 검수
  [PurchaseOrderLineUrlEnum.INSPECT]: [PurchaseOrderLineStatusEnum.TO_BE_INSPECTED],

  // 재고 입고
  [PurchaseOrderLineUrlEnum.ADD_STOCK]: [PurchaseOrderLineStatusEnum.INSPECTED],

  // 배송 완료 확인 - 재고와 위탁에 따라 다름
  [PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY]: [], // 동적으로 결정됨

  // 전체 발주 내역
  [PurchaseOrderLineUrlEnum.ALL]: [
    PurchaseOrderLineStatusEnum.DRAFT,
    PurchaseOrderLineStatusEnum.PENDING,
    PurchaseOrderLineStatusEnum.REJECTED,
    PurchaseOrderLineStatusEnum.RECEIVED,
    PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY,
    PurchaseOrderLineStatusEnum.REQ_EPD_UPDATE,
    PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
    PurchaseOrderLineStatusEnum.PARTIALLY_DELIVERY_CONFIRMED,
    PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
    PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
    PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
    PurchaseOrderLineStatusEnum.INSPECTED,
    PurchaseOrderLineStatusEnum.STOCKED,
    PurchaseOrderLineStatusEnum.DELIVERED,
    PurchaseOrderLineStatusEnum.CANCELED,
  ],
};

// URL string이 유효한 PurchaseOrderLineUrlEnum 값인지 확인하는 타입 가드
export function isValidPurchaseOrderLineUrl(status: string): status is PurchaseOrderLineUrlEnum {
  return Object.values(PurchaseOrderLineUrlEnum).includes(status as PurchaseOrderLineUrlEnum);
}

// URL 파라미터로부터 상태 리스트 가져오기
export function getStatusesFromUrlParam(
  status: PurchaseOrderLineUrlEnum | string,
  inventoryType: PoLineInventoryType
): PurchaseOrderLineStatusEnum[] {
  const isTrackInventory = inventoryType === "track-inventory";
  const isConsignment = inventoryType === "consignment";

  // 특수 케이스: 배송 완료 확인
  if (status === PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY) {
    if (isTrackInventory) {
      return [PurchaseOrderLineStatusEnum.STOCKED, PurchaseOrderLineStatusEnum.DELIVERED];
    } else if (isConsignment) {
      return [PurchaseOrderLineStatusEnum.INVOICE_PRINTED, PurchaseOrderLineStatusEnum.DELIVERED];
    }
  }

  // 특수 케이스: 재고 검수와 입고는 재고 발주에서만
  if (
    !isTrackInventory &&
    (status === PurchaseOrderLineUrlEnum.INSPECT || status === PurchaseOrderLineUrlEnum.ADD_STOCK)
  ) {
    return [];
  }

  // string인 경우 enum으로 변환 시도
  let urlEnum: PurchaseOrderLineUrlEnum;

  if (typeof status === "string") {
    if (!isValidPurchaseOrderLineUrl(status)) {
      return [];
    }
    urlEnum = status;
  } else {
    urlEnum = status;
  }

  return urlStatusMapping[urlEnum] || [];
}
</file>

