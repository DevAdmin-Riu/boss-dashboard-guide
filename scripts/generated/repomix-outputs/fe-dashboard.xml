<file path="src/app/components/antd/DatePicker/ResponsiveRangePicker.tsx">
import { ArrowDownOutlined } from "@ant-design/icons";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { utils } from "@utils/utils";
import { DatePicker, Row, Space } from "antd";
import { RangePickerProps } from "antd/lib/date-picker";
import { Moment } from "moment";
import React, { useEffect, useState } from "react";

import { MobileDatePicker, MobileDatePickerProps } from "./MobileDatePicker";

const { RangePicker } = DatePicker;

type ResponsiveRangePickerProps = RangePickerProps & {
  mobilePopupTitle?: {
    start: string | React.ReactNode;
    end: string | React.ReactNode;
  };
  includeTime?: boolean;
};

export const ResponsiveRangePicker: React.FC<ResponsiveRangePickerProps> = (props) => {
  const { mobilePopupTitle, onChange, ...rangePickerProps } = props;
  const isMobile = utils.checkMobile();
  const [range, setRange] = useState<[Moment | null, Moment | null]>(props?.value || [null, null]);

  useEffect(() => {
    if (props?.value) {
      setRange(props.value);
    }
  }, [props?.value]);

  const isRangeInvalid = range[0] && range[1] && range[0].isAfter(range[1]);

  if (isMobile) {
    // NOTE: antd-mobile에는 RangePicker가 없으므로, 두 개의 MobileDatePicker를 사용하여 구현 + 구현에 필요한 최소한의 props만 커스텀하여 전달
    const { mobilePopupTitle, includeTime, style, size, allowClear, disabled, format, picker, disabledDate } = props;
    const startPopupTitleToUser = mobilePopupTitle?.start || "시작일";
    const endPopupTitleToUser = mobilePopupTitle?.end || "종료일";
    const parsedFormat = typeof format === "string" ? format : onlyDateFormat;

    const commonProps: MobileDatePickerProps = {
      style,
      size,
      allowClear,
      format: parsedFormat,
      picker: includeTime ? "time" : picker,
      disabledDate,
    };

    const handleDateChange = (info: "start" | "end", date: Moment | null, dateString: string) => {
      const newRange: [Moment | null, Moment | null] = info === "start" ? [date, range[1]] : [range[0], date];
      setRange(newRange);
      onChange?.(newRange, [
        info === "start" ? dateString : range[0]?.isValid() ? range[0].format(onlyDateFormat) : null,
        info === "end" ? dateString : range[1]?.isValid() ? range[1].format(onlyDateFormat) : null,
      ]);
    };

    return (
      <Space direction="vertical" size="small">
        <MobileDatePicker
          {...commonProps}
          mobilePopupTitle={startPopupTitleToUser}
          disabled={Array.isArray(disabled) ? disabled[0] : disabled}
          value={range[0]}
          onChange={(date, dateString) => handleDateChange("start", date, dateString)}
          status={isRangeInvalid ? "error" : undefined}
        />
        <Row justify="center">
          <ArrowDownOutlined />
        </Row>
        <MobileDatePicker
          {...commonProps}
          mobilePopupTitle={endPopupTitleToUser}
          disabled={Array.isArray(disabled) ? disabled[1] : disabled}
          value={range[1]}
          onChange={(date, dateString) => handleDateChange("end", date, dateString)}
          status={isRangeInvalid ? "error" : undefined}
        />
      </Space>
    );
  }

  return (
    <RangePicker
      {...rangePickerProps}
      value={range}
      onChange={(dates, dateStrings) => {
        setRange(dates);
        onChange?.(dates, dateStrings);
      }}
      status={isRangeInvalid ? "error" : undefined}
    />
  );
};
</file>

