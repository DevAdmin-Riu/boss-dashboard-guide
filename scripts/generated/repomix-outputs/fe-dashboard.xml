import { Makers_makers_edges_node } from "../../api/types/Makers";
import { MakerListPageProps } from "./MakerListPage";

export function getMakerTableSettings(props: MakerListPageProps) {
  const { onUpdate, onDelete } = props;
  const columns: DownloadableColumnsType<Makers_makers_edges_node> = [
    {
      title: columnNameConstant.vendor.MAKER_CODE,
      key: "code",
      align: "center",
      width: 100,
      render: (_, record) => record.code,
      renderExcel: (record) => record.code,
      isPickerHide: true,
    },
    {
      title: columnNameConstant.vendor.MAKER_NAME,
      key: "name",
      align: "center",
