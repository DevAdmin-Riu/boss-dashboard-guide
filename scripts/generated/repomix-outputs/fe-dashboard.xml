<file path="src/app/components/TableListFooter/TableListPaginationFooter.tsx">
import { utils } from "@utils/utils";
import { Col, Pagination, Row } from "antd";
import React, { useEffect } from "react";

import RowNumberSelect from "../RowNumberSelect";

interface TableListPaginationFooterProps {
  currentPage: number;
  totalCount: number;
  limit: number;
  paginationOnChange: (page: number) => void;
  settings: any;
  onUpdateListSettings: (key: string, value: any) => void;
}

const TableListPaginationFooter: React.FC<TableListPaginationFooterProps> = (props) => {
  const { currentPage, totalCount, limit, paginationOnChange, settings, onUpdateListSettings } = props;
  const onChangeRowNumber = (key: string, value: any) => {
    onUpdateListSettings(key, value);
    paginationOnChange(1);
  };
  // pagiNation 렌더링 이슈로 인하여 totalCount를 localStorage에 저장
  useEffect(() => {
    if (utils.isEmpty(totalCount) === false) {
      onUpdateListSettings("totalCount", totalCount);
    }
  }, [totalCount]);
  return (
    <Row style={{ margin: "20px auto" }} justify="space-between" align="middle">
      <Col>
        <RowNumberSelect choices={[1, 10, 20, 40, 60, 80, 100]} settings={settings} onChange={onChangeRowNumber} />
      </Col>
      <Col>
        <Pagination
          current={currentPage}
          total={totalCount || settings.totalCount}
          pageSize={limit}
          onChange={(page: number) => {
            paginationOnChange(page);
          }}
        />
      </Col>
    </Row>
  );
};

export default TableListPaginationFooter;
</file>

