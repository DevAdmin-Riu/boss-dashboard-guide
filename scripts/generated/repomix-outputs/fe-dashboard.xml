export const BsOpsCheckReportListView: React.FC<BsOpsCheckReportListViewProps> = ({ params }) => {
  const routeParams = useParams<BsOpsCheckReportListViewRouteParams>();
  const { viewType } = routeParams;
  const { user } = useUser();
  const isStaff = user.isStaff;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BS_OPS_CHECK_REPORT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBsOpsCheckReportListFilterDownloadQuery);

  const targetUrl = (params: BsOpsCheckReportListViewUrlQueryParams) =>
    bsOpsCheckReportListViewUrl(routeParams, params);

  const filter = getFilterVariables(params);
  const queryVariables = useMemo<BsOpsCheckReportListVariables>(
    () => ({ ...paginationState, filter, isStaff }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBsOpsCheckReportListQuery({ initialListSkip: true, variables: queryVariables });
  const bsOpsCheckReportList = maybe(() => data.bsOpsCheckReportList.edges.map((edge) => edge.node), []);

  const summaryVariables = useMemo<BsOpsCheckTemplateReportsSummaryVariables>(
    () => getSummaryFilterVariables(params),
    [params]
  );
  const { data: summaryData, refetch: summaryRefetch } = useBsOpsCheckTemplateReportsSummaryQuery({
    variables: summaryVariables,
  });
  const bsOpsCheckTemplateReportsSummary = maybe(() => summaryData.bsOpsCheckTemplateReportsSummary, null);

  const {
    loadMore: templateLoadMore,
    result: templateResult,
    search: searchTemplate,
  } = useBsOpsCheckTemplateSearch({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.default },
  });
  const templateList = maybe(() => templateResult.data.search.edges.map((edge) => edge.node), []);
  const fetchMoreTemplate = {
    hasMore: maybe(() => templateResult.data.search.pageInfo.hasNextPage),
    loading: templateResult.loading,
    onFetchMore: templateLoadMore,
  };

  const filterOpts = getFilterOpts(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.bsOpsCheckReportList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
    onParamsChange,
  } = utils.initListViewFilterTabs<BsOpsCheckReportListViewUrlDialog, BsOpsCheckReportListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const viewOptions: Array<{ label: string; value: BsOpsCheckReportViewType }> = [
    { label: "대시보드", value: "dashboard" },
    { label: "보고서 리스트", value: "list" },
  ];

  const handleSummaryParamsChange = (newParams: BsOpsCheckReportListViewUrlQueryParams) => {
    onParamsChange(newParams);

    const oldSummaryParams: BsOpsCheckReportListViewUrlQueryParams = {
      template: params.template,
      dateRangeFrom: params.dateRangeFrom,
      dateRangeTo: params.dateRangeTo,
    };
    if (_.isEqual(newParams, oldSummaryParams)) {
      summaryRefetch();
    }
  };

  return (
    <>
      <Tabs
        type="card"
        activeKey={viewType}
        onChange={(key) => navigate(bsOpsCheckReportListViewUrl({ viewType: key as BsOpsCheckReportViewType }, params))}
        items={viewOptions.map((option) => ({
          key: option.value,
          label: option.label,
          children:
            option.value === "dashboard" ? (
              <BsOpsCheckTemplateReportsSummaryForListView
                params={params}
                summary={bsOpsCheckTemplateReportsSummary}
                onParamsChange={handleSummaryParamsChange}
                templateList={templateList}
                onSearchTemplate={searchTemplate}
                fetchMoreTemplate={fetchMoreTemplate}
              />
            ) : option.value === "list" ? (
              <BsOpsCheckReportListPage
                user={user}
                bsOpsCheckReportList={bsOpsCheckReportList}
                currentTab={currentTab}
                filterOpts={filterOpts}
                onFilterChange={changeFilters}
                onAll={resetFilters}
                onTabChange={handleTabChange}
                onTabDelete={() => openModal("delete-search")}
                onTabSave={() => openModal("save-search")}
                tabs={tabs.map((tab) => tab.name)}
                settings={settings}
                disabled={loading}
                pageInfo={pageInfo}
                onNextPage={loadNextPage}
                onPreviousPage={loadPreviousPage}
                onUpdateListSettings={updateListSettings}
                onRowClick={(id) => navigate(bsOpsCheckReportDetailsViewUrl(id))}
                queryVariablesWithoutPagination={queryVariablesWithoutPagination}
                fetchForDownload={fetchForDownload}
              />
            ) : null,
        }))}
      />

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
