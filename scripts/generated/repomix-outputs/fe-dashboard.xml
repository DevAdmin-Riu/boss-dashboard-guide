import { formRuleMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import { User } from "@src/api/fragments/types/User";
import {
  BrandStoreRequestStatusEnum,
  BrandStoreRequestToHqCommentCreateInput,
  BrandStoreRequestToHqStatus,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import AppHeader from "@src/app/components/AppHeader";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ToastEditor from "@src/app/components/Editor/ToastEditor";
import { parseContentJsonStrToMarkdown } from "@src/app/components/Editor/utils";
import Grid from "@src/app/components/Grid";
import { detailDateFormat, getDateByFormat } from "@src/app/providers/DateProvider";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, Input, PageHeader, Row, Space, Typography } from "antd";
import React from "react";

import { BrandStoreRequestToHqDetails_brandStoreRequestToHq } from "../../api/types/BrandStoreRequestToHqDetails";
import { makeBsRequestToHqStatusTag } from "../BrandStoreRequestToHqListPage/BrandStoreRequestToHqListTableSettings";
import { RequestToHqCommentList } from "../RequestToHqCommentList";

type CommentCreateForm = Pick<BrandStoreRequestToHqCommentCreateInput, "content">;

interface BrandStoreRequestToHqDetailsPageProps {
  user: User;
  request: BrandStoreRequestToHqDetails_brandStoreRequestToHq;
  loading: boolean;
  onBack: () => void;
  onStatusUpdate: (status: BrandStoreRequestStatusEnum) => void;
  onCommentCreate: (content: string) => void;
}

export const BrandStoreRequestToHqDetailsPage: React.FC<BrandStoreRequestToHqDetailsPageProps> = ({
  user,
  request,
  loading,
  onBack,
  onStatusUpdate,
  onCommentCreate,
}) => {
  const [form] = Form.useForm<CommentCreateForm>();
  const TypeSafeForm = getTypeSafeForm<CommentCreateForm>(form);

  const initialValues: CommentCreateForm = {
    content: "",
  };

  const isUserStaff = user.isStaff;
  const isDone = request?.status === BrandStoreRequestToHqStatus.DONE;
  const appHeaderTitle = sectionNames.brandStoreRequest;
  const makeCardTitle = () => {
    const statusTag = makeBsRequestToHqStatusTag(request);
    return (
      <PageHeader
        title="기본 정보"
        subTitle={
          <Space align="end">
            {getDateByFormat(request?.createdAt, detailDateFormat)}
            {statusTag}
          </Space>
        }
      />
    );
  };
  const makeCardExtra = () => {
    if (utils.isEmpty(request) || request.status === BrandStoreRequestToHqStatus.DONE) {
      return null;
    }

    let actionBtnText = "";
    let statusInput = null;
    const status = request.status;
    switch (status) {
      case BrandStoreRequestToHqStatus.WAITING:
        actionBtnText = "접수";
        statusInput = BrandStoreRequestStatusEnum.ACCEPTED;
        break;
      case BrandStoreRequestToHqStatus.ACCEPTED:
        actionBtnText = "완료";
        statusInput = BrandStoreRequestStatusEnum.DONE;
        break;
    }

    return (
      <Space>
        <Button type="primary" disabled={isUserStaff} onClick={() => onStatusUpdate(statusInput)}>
          {actionBtnText}
        </Button>
      </Space>
    );
  };

  return (
    <>
      <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
      <Grid>
        <Card loading={loading} title={makeCardTitle()} extra={makeCardExtra()}>
          <Row gutter={[0, 24]}>
            <Col span={24}>
              <Row gutter={8}>
                {user.isStaff && (
                  <Col span={12}>
                    <Typography.Title level={5}>
                      {columnNameConstant.brand.BRAND_NAME}({columnNameConstant.brand.BRAND_CODE})
                    </Typography.Title>
                    <Typography.Text>
                      {request?.brand.name} ({request?.brand.code})
                    </Typography.Text>
                  </Col>
                )}
                <Col span={12}>
                  <Typography.Title level={5}>
                    {columnNameConstant.brandStore.BRAND_STORE_NAME}({columnNameConstant.brandStore.BRAND_STORE_CODE})
                  </Typography.Title>
                  <Typography.Text>
                    {request?.brandStore.name} ({request?.brandStore.code})
                  </Typography.Text>
                </Col>
              </Row>
            </Col>
            <Col span={24}>
              <Typography.Title level={5}>제목</Typography.Title>
              <Typography.Text>{request?.title}</Typography.Text>
            </Col>
            <Col span={24}>
              <Typography.Title level={5}>내용</Typography.Title>
              <ToastEditor
                name="content"
                isEditable={false}
                initialValue={parseContentJsonStrToMarkdown(request?.content)}
              />
            </Col>
          </Row>
        </Card>
        <Card title={<Typography.Title level={5}>요청 댓글</Typography.Title>}>
          <Form
            disabled={isDone || isUserStaff}
            form={form}
            initialValues={initialValues}
            onFinish={(formData) => {
              const { content } = formData;
              onCommentCreate(content);
              form.resetFields();
            }}
          >
            <RequestToHqCommentList comments={request?.comments || []} />
            <Form.Item
              style={{ marginBottom: 8 }}
              name={TypeSafeForm.getValidDataIndex("content")}
              rules={[{ required: true, message: formRuleMsg.required }]}
            >
              <Input.TextArea />
            </Form.Item>
            <Row justify="end">
              <Form.Item noStyle shouldUpdate>
                {() => (
                  <Button type="primary" disabled={!form.isFieldsTouched()} onClick={form.submit}>
                    등록
                  </Button>
                )}
              </Form.Item>
            </Row>
          </Form>
        </Card>
      </Grid>
    </>
  );
};
</file>

