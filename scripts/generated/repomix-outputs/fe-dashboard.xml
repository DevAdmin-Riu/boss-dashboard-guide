import { utils } from "@utils/utils";
import { Moment } from "moment";
import moment from "moment-timezone";
import React from "react";

import { Locale, LocaleConsumer } from "../LocaleProvider/Locale";

interface DateTimeProps {
  date: string;
  onlyDate?: boolean;
  onlyMonth?: boolean;
}

export const extractYearFormat = "YYYY";
export const extractMonthFormat = "MM";
export const extractHourMinuteFormat = "HH:mm";
export const detailTimeFormat = "HH:mm:ss";
export const onlyMonthFormat = "YYYY-MM";
export const yearMonthKoreanFormat = "YYYY년 MM월";
export const monthDayKoreanFormat = "MM월 DD일";
export const onlyDateFormat = "YYYY-MM-DD";
export const detailDateFormatWithHourMinute = "YYYY-MM-DD HH:mm";
export const detailDateFormat = "YYYY-MM-DD HH:mm:ss";
export const fileNameDateFormat = "YYYYMMDD-HHmmss";
export const ISOFormatWithTimeZone = "YYYY-MM-DDTHH:mm:ssZ";

export const getDateByFormat = (value: string | Moment, format: string = detailDateFormat, locale?: string) => {
  if (!value) {
    return "-";
  }

  // value가 이미 moment 객체인지 확인
  let date = moment.isMoment(value) ? value.clone() : moment(value);

  if (locale) {
    date = date.locale(locale);
  } else {
    date = date.locale(Locale.KO);
  }

  try {
    return date.format(format);
  } catch (e) {
    console.error("date.format error", format, e);
    return date.format(detailDateFormat); // fallback
  }
};

export const getDateRangeByFormat = (
  range: [string | null, string | null],
  format: string = detailDateFormat,
  locale?: string
) => {
  const [startDate, endDate] = range;
  if (utils.isEmpty(startDate) && utils.isEmpty(endDate)) {
    return "-";
  }
  if (utils.isEmpty(startDate)) {
    return `~ ${getDateByFormat(endDate, format, locale)}`;
  }
  if (utils.isEmpty(endDate)) {
    return `${getDateByFormat(startDate, format, locale)} ~`;
  }
  if (startDate === endDate) {
    return getDateByFormat(startDate, format, locale);
  }
  const start = getDateByFormat(startDate, format, locale);
  const end = getDateByFormat(endDate, format, locale);
  return `${start} ~ ${end}`;
};

export const getDatesBetween = (duration: [moment.Moment, moment.Moment], dateType: "month" | "day") => {
  const [starDate, endDate] = duration;
  const formatStr = dateType === "month" ? onlyMonthFormat : onlyDateFormat;
  const dates: moment.Moment[] = [];
  const formattedDates: string[] = [];

  for (let currentDate = starDate; currentDate.isSameOrBefore(endDate); currentDate.add(1, dateType)) {
    dates.push(currentDate.clone());
    const currentDateStr = currentDate.format(formatStr);
    formattedDates.push(currentDateStr);
  }

  return { dates, formattedDates };
};

export const DateTime: React.FC<DateTimeProps> = ({ date, onlyDate, onlyMonth }) => (
  <LocaleConsumer>
    {({ locale }) =>
      getDateByFormat(date, onlyMonth ? onlyMonthFormat : onlyDate ? onlyDateFormat : detailDateFormat, locale)
    }
  </LocaleConsumer>
);

export default DateTime;

export const isDateInFormatWithMoment = (dateStr: string, formatStr: string): boolean =>
  moment(dateStr, formatStr, true).isValid();

export const monthRangePresets: Record<string, [moment.Moment, moment.Moment]> = {
  이번달: [moment().startOf("month"), moment().endOf("month")],
  "2개월": [moment().subtract(1, "month").startOf("month"), moment().endOf("month")],
  "3개월": [moment().subtract(2, "month").startOf("month"), moment().endOf("month")],
  "6개월": [moment().subtract(5, "month").startOf("month"), moment().endOf("month")],
};
export const dateRangePresets: Record<string, [moment.Moment, moment.Moment]> = {
  오늘: [moment().startOf("day"), moment().endOf("day")],
  "1주": [moment().subtract(1, "week").startOf("day"), moment().endOf("day")],
  "2주": [moment().subtract(2, "week").startOf("day"), moment().endOf("day")],
  "1개월": [moment().subtract(1, "month").startOf("day"), moment().endOf("day")],
  "3개월": [moment().subtract(3, "month").startOf("day"), moment().endOf("day")],
  "6개월": [moment().subtract(6, "month").startOf("day"), moment().endOf("day")],
  "이번 달": [moment().startOf("month"), moment().endOf("month")],
  "지난 달": [moment().subtract(1, "month").startOf("month"), moment().subtract(1, "month").endOf("month")],
  "두달 전": [moment().subtract(2, "month").startOf("month"), moment().subtract(2, "month").endOf("month")],
