      edges {
        node {
          id
          code
          name
          isRunning
        }
      }
    }
    vendors(first: 10, filter: { ids: $vendors }) {
      edges {
        node {
          id
          code
          name
        }
      }
    }
    productVariants(first: 10, filter: { ids: $productVariants }) {
