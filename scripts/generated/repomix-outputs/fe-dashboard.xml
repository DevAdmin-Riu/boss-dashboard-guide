} from "./filters";

interface StockDetailEventListForLabelViewProps {
  defaultParams: StockDetailEventListForLabelViewUrlQueryParams;
  params: StockDetailEventListForLabelViewUrlQueryParams;
}

export const StockDetailEventListForLabelView: React.FC<StockDetailEventListForLabelViewProps> = ({
  defaultParams,
  params,
}) => {
  const navigate = useNavigator();
  const [selectedEvents, setSelectedEvents] = useState<SearchStockDetailEventsForLabel_search_edges_node[]>([]);

  const queryVariables: SearchStockDetailEventsForLabelVariables = useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.listForLabel,
      filter: getFilterVariables(params),
      sort: { field: StockDetailEventSortField.DATE, direction: OrderDirection.DESC },
    }),
    [params]
  );
  const {
    loadMore,
    result: { data, loading, refetch },
  } = useStockDetailEventsForLabelSearch({ initialListSkip: true, variables: queryVariables });
  const stockDetailEvents = maybe(() => data.search.edges.map((edge) => edge.node), []);
  const hasMore = maybe(() => data.search.pageInfo.hasNextPage, false);

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    StockDetailEventListForLabelViewUrlDialog,
    StockDetailEventListForLabelViewUrlQueryParams
  >({
    navigate,
    targetUrl: stockDetailEventListForLabelViewUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <StockDetailEventListForLabelPage
        loading={loading}
        stockDetailEvents={stockDetailEvents}
        fetchMore={{ loading, hasMore, onFetchMore: loadMore }}
        filterOpts={getFilterOpts(params)}
        selectedEvents={selectedEvents}
        onRowClick={(id) => navigate(productUpdateViewUrl(id))}
        onSelectedEventsChange={setSelectedEvents}
        tabs={getFilterTabs().map((tab) => tab.name)}
        currentTab={currentTab}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onLabelPrint={() => openModal("print-label")}
      />

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <StockDetailEventLabelPrintModal
        open={params.action === "print-label"}
        loading={loading}
        stockDetailEvents={selectedEvents}
        onClose={closeModal}
      />
    </>
  );
};
