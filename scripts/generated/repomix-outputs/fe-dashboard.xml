import { DownloadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { commonMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import {
  BrandProductVariantManageEventTypeEnum,
  ProductVariantManageEventTypeEnum,
  SalesStatusEnum,
  StoppedReasonTypeEnum,
} from "@src/api/types/globalTypes";
import { checkVatValueToPriceExcludeVat } from "@src/app/components/antd/Form/validators";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { isStoppedSalesStatus } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, Row, Space, Typography } from "antd";
import moment from "moment";
import React, { useState } from "react";

import { useFbvMixedProductUpdateMutation } from "../../api/mutations";
import {
  FbvBrandProductVariants,
  FbvBrandProductVariants_brandProductVariants_edges_node,
  FbvBrandProductVariantsVariables,
} from "../../api/types/FbvBrandProductVariants";
import { FbvMixedProductUpdate, FbvMixedProductUpdateVariables } from "../../api/types/FbvMixedProductUpdate";
import { FbvBrandProductVariantListViewUrlSortField } from "../../urls";
import { getFbvBrandProductVariantListTableSettings } from "./FbvProductListTableSettings";
import {
  createFilterStructure,
  FbvBrandProductVariantListFilterKeys,
  FbvBrandProductVariantListFilterOpts,
} from "./filters";

export interface FormValueWatched {
  salesStatus: SalesStatusEnum;
  brandProductName: string;
  vendorProductPriceAmount: number;
  vendorDeliveryFeeExcludeVat: number;
  priceExcludeVat: number;
  showBeforePrice: boolean;
  beforePriceExcludeVat: number;
  priceVat: number;
  forceNoNormalDisplay: boolean;
  isOnlyPayableByCash: boolean;
  stoppedReason: StoppedReasonTypeEnum;
  stoppedAt: string;
  stoppedReasonEtc: string;
}

interface FbvProductListPageProps
  extends PaginateListProps,
    FilterPageProps<FbvBrandProductVariantListFilterKeys, FbvBrandProductVariantListFilterOpts>,
    SortPage<FbvBrandProductVariantListViewUrlSortField> {
  queryVariablesWithoutPagination: FbvBrandProductVariantsVariables;
  fetchForDownload: (
    variables?: FbvBrandProductVariantsVariables
  ) => Promise<ApolloQueryResult<FbvBrandProductVariants>>;
  fbvBrandProductVariants: FbvBrandProductVariants_brandProductVariants_edges_node[];
  onAdd: () => void;
  onProductVariantBulkUpdateOrCreate: () => void;
  onProductListDownload: () => void;
  disabled: boolean;
  isFulfilledByVendor: boolean;
  currencySymbol: string;
}

const FbvProductListPage: React.FC<FbvProductListPageProps> = (props) => {
  const {
    onAdd,
    tabs,
    currentTab,
    onProductVariantBulkUpdateOrCreate,
    onProductListDownload,
    currencySymbol,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    fbvBrandProductVariants,
    onRowClick,
    queryVariablesWithoutPagination,
    fetchForDownload,
    filterOpts,
    disabled,
    onUpdateListSettings,
  } = props;
  const [form] = Form.useForm();
  const { isStaff } = useUser().user;
  const { stoppedReasonChoices } = useShop();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);
  const [editingId, setEditingId] = useState<string>(undefined);

  const [fbvMixedProductUpdate, fbvMixedProductUpdateOpts] = useFbvMixedProductUpdateMutation({
    onCompleted: (data: FbvMixedProductUpdate) => {
      const errors = data.fbvMixedProductUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        form.resetFields();
        setEditingId(undefined);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const fbvMixedProductUpdateHandler = (variables: FbvMixedProductUpdateVariables) => {
    fbvMixedProductUpdate({
      variables,
    });
  };

  const resetFormField = () => {
    form.resetFields();
    setEditingId(undefined);
  };
  const formValuesWatched: FormValueWatched = {
    brandProductName: Form.useWatch("brandProductName", form),
    salesStatus: Form.useWatch("salesStatus", form),
    forceNoNormalDisplay: Form.useWatch("forceNoNormalDisplay", form),
    stoppedAt: Form.useWatch("stoppedAt", form),
    stoppedReason: Form.useWatch("stoppedReason", form),
    stoppedReasonEtc: Form.useWatch("stoppedReasonEtc", form),
    isOnlyPayableByCash: Form.useWatch("isOnlyPayableByCash", form),
    vendorProductPriceAmount: Form.useWatch("vendorProductPriceAmount", form),
    vendorDeliveryFeeExcludeVat: Form.useWatch("vendorDeliveryFeeExcludeVat", form),
    priceExcludeVat: Form.useWatch("priceExcludeVat", form),
    priceVat: Form.useWatch("priceVat", form),
    showBeforePrice: Form.useWatch("showBeforePrice", form),
    beforePriceExcludeVat: Form.useWatch("beforePriceExcludeVat", form),
  };
  const setEditableRow = (record: FbvBrandProductVariants_brandProductVariants_edges_node) => {
    form.setFields([
      { name: "brandProductName", value: record.brandProduct.name },
      { name: "salesStatus", value: record.salesStatus },
      {
        name: "forceNoNormalDisplay",
        value: record.forceNoNormalDisplay,
      },
      { name: "stoppedAt", value: record.stoppedAt ? moment(record.stoppedAt, onlyDateFormat) : null },
      {
        name: "stoppedReason",
        value: record?.stoppedReason,
      },
      { name: "stoppedReasonEtc", value: record.stoppedReasonEtc },
      {
        name: "isOnlyPayableByCash",
        value: record.brandProduct.isOnlyPayableByCash,
      },
      {
        name: "vendorProductPriceAmount",
        value: record.productVariant.trackInventory
          ? record.productVariant.defaultVariantVendor.productPriceExcludeVat
          : record.productVariant.defaultVariantVendor.consignmentProductPriceExcludeVat,
      },
      {
        name: "vendorDeliveryFeeExcludeVat",
        value: record.productVariant.trackInventory
          ? record.productVariant.defaultVariantVendor.deliveryFeeExcludeVat
          : record.productVariant.defaultVariantVendor.consignmentDeliveryFeeExcludeVat,
      },
      {
        name: "priceExcludeVat",
        value: record.priceAmount - record.priceVat,
      },
      {
        name: "priceVat",
        value: record.priceVat,
      },
      {
        name: "showBeforePrice",
        value: record.showBeforePrice,
      },
      {
        name: "beforePriceExcludeVat",
        value: toPriceExcludeVat(record.beforePriceAmount, record.brandProduct.product.isTaxFree),
      },
    ]);
    setEditingId(record.id);
  };
  const isEditing = (record: FbvBrandProductVariants_brandProductVariants_edges_node) => record.id === editingId;
  const onEdit = (record: FbvBrandProductVariants_brandProductVariants_edges_node) => setEditableRow(record);
  const onCancel = () => resetFormField();
  const onSubmit = async (record: FbvBrandProductVariants_brandProductVariants_edges_node) => {
    const validateUpdateInput = () => {
      const {
        salesStatus,
        stoppedReason,
        stoppedAt,
        stoppedReasonEtc,
        beforePriceExcludeVat,
        showBeforePrice,
        priceExcludeVat,
        priceVat,
      } = formValuesWatched;

      const isStoppedProductVariant = isStoppedSalesStatus(record?.productVariant.salesStatus);

      const { isValid } = checkVatValueToPriceExcludeVat(
        priceVat,
        priceExcludeVat,
        record.productVariant.priceDecimalPlaces
      );
      const isTaxFree = record.brandProduct.product.isTaxFree;
      if (isTaxFree === false && isValid === false) {
        showNotificationError(`부가세 범위에 맞는 금액을 입력해 주세요.`);
        return false;
      }

      if (isTaxFree === true && priceVat !== 0) {
        showNotificationError("면세 제품의 경우 판매가는 부가세가 0원이어야 합니다.");
        return false;
      }

      if (stoppedReason === StoppedReasonTypeEnum.ETC && utils.isEmpty(stoppedReasonEtc)) {
        showNotificationError("판매 중단 사유가 기타인 경우 판매 중단 상세 사유를 입력해 주세요.");
        return false;
      }
      if (salesStatus === SalesStatusEnum.ON_SALE) {
        if (isStoppedProductVariant) {
          showNotificationError("제품 상태가 단종인 경우에는 판매 상태로 변경할 수 없습니다.");
          return false;
        }
      } else {
        if (utils.isEmpty(stoppedReason)) {
          showNotificationError("판매 상태가 판매가 아닌 경우 판매 중단 사유를 입력해 주세요.");
          return false;
        }
        if (salesStatus === SalesStatusEnum.WILL_BE_STOPPED && utils.isEmpty(stoppedAt)) {
          showNotificationError("판매 상태가 중단 예정인 경우 판매 중단일을 입력해 주세요.");
          return false;
        }
      }

      if (showBeforePrice) {
        if (utils.isEmpty(beforePriceExcludeVat)) {
          showNotificationError("할인표시를 하기 위해서 할인 전 가격을 입력해 주세요.");
          return false;
        }
        if (beforePriceExcludeVat < priceExcludeVat) {
          showNotificationError("할인 전 가격은 판매가보다 커야 합니다.");
          return false;
        }
      }

      return true;
    };

    if (validateUpdateInput() === false) {
      return;
    }

    const isTaxFree = record.brandProduct.product.isTaxFree;
    const trackInventory = record.productVariant.trackInventory;

    const manageEventTitle = "";
    const manageEventReason = "";
    const {
      brandProductName,
      isOnlyPayableByCash,
      showBeforePrice,
      beforePriceExcludeVat,
      priceExcludeVat,
      priceVat,
      salesStatus,
      stoppedAt,
      stoppedReason,
      stoppedReasonEtc,
      vendorProductPriceAmount,
      vendorDeliveryFeeExcludeVat,
      forceNoNormalDisplay,
    } = formValuesWatched;
    fbvMixedProductUpdateHandler({
      additionalInput: {
        manageEvent: {
          type: ProductVariantManageEventTypeEnum.TYPE_ETC,
          title: manageEventTitle,
          reason: manageEventReason,
        },
      },
      bpvManageEvent: {
        type: BrandProductVariantManageEventTypeEnum.TYPE_ETC,
        title: manageEventTitle,
        reason: manageEventReason,
      },
      brandProductId: record.brandProduct.id,
      brandProductInput: {
        name: brandProductName,
        isOnlyPayableByCash,
      },
      brandProductVariantId: record.id,
      brandProductVariantInput: {
        salesStatus,
        stoppedAt: stoppedAt === null ? undefined : getDateByFormat(stoppedAt, onlyDateFormat),
        stoppedReason,
        stoppedReasonEtc,
        showBeforePrice,
        beforePrice: toPriceIncludeVat(beforePriceExcludeVat, isTaxFree),
        price: priceExcludeVat + priceVat,
        priceVat,
        forceNoNormalDisplay,
        deliveryFee: 0,
      },
      productId: record.brandProduct.product.id,
      productInput: {
        name: brandProductName,
      },
      productVariantId: record.productVariant.id,
      productVariantVendorId: record.productVariant.defaultVariantVendor.id,
      productVariantVendorInput: {
        productPriceExcludeVat: trackInventory ? vendorProductPriceAmount : undefined,
        deliveryFeeExcludeVat: trackInventory ? vendorDeliveryFeeExcludeVat : undefined,
        consignmentProductPriceExcludeVat: trackInventory === false ? vendorProductPriceAmount : undefined,
        consignmentDeliveryFeeExcludeVat: trackInventory === false ? vendorDeliveryFeeExcludeVat : undefined,
        manageEvent: {
          type: ProductVariantManageEventTypeEnum.TYPE_ETC,
          title: manageEventTitle,
          reason: manageEventReason,
        },
      },
    });
  };

  const loading = disabled || fbvMixedProductUpdateOpts.loading;

  const columns = getFbvBrandProductVariantListTableSettings({
    stoppedReasonChoices,
    isEditing,
    onEdit,
    onCancel,
    onSubmit,
    formValuesWatched,
    isStaff,
    onRowClick,
    editingId,
    loading,
    form,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const handleSave = (columns) => onUpdateListSettings("columns", columns);

  const productVariantBulkUpdateOrCreateButton = (
    <Button type="primary" shape="round" disabled={disabled} onClick={onProductVariantBulkUpdateOrCreate}>
      {isStaff ? "제품정보 일괄 등록/수정" : "직거래 상품 일괄 생성/수정"}
    </Button>
  );
  const downloadProductListBtn = (
    <Button
      icon={<DownloadOutlined />}
      type="primary"
      shape="round"
      disabled={disabled}
      onClick={onProductListDownload}
    >
      제품 리스트 다운로드
    </Button>
  );
  const addProductButton = (
    <Button type="primary" shape="round" disabled={disabled} onClick={onAdd}>
      {isStaff ? "신규 제품 생성" : "직거래 상품 생성"}
    </Button>
  );

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "brandProductVariants",
    makeChildrenFlat: true,
  };

  return (
    <>
      <Form form={form}>
        <Space direction="vertical" size={24}>
          <Row justify="space-between">
            <Col>
              <Typography.Title level={4}>
                {isStaff ? sectionNames.productsB : sectionNames.hqFbvProductsB}
              </Typography.Title>
            </Col>
            <Col>
              <Space direction="horizontal">
                {productVariantBulkUpdateOrCreateButton}
                {isStaff && downloadProductListBtn}
                {addProductButton}
              </Space>
            </Col>
          </Row>
          <Card>
            <SpreadFilterBar
              currencySymbol={currencySymbol}
              currentTab={currentTab}
              onAll={onAll}
              onFilterChange={onFilterChange}
              onTabChange={onTabChange}
              onTabDelete={onTabDelete}
              onTabSave={onTabSave}
              tabs={tabs}
              filterStructure={filterStructure}
              tabExtra={
                <Space direction="horizontal">
                  <ColumnPicker
                    columns={pickColumns}
                    loading={loading}
                    initialColumns={initialColumns}
                    total={pickColumns?.length}
                    onSave={handleSave}
                  />
                </Space>
              }
              isDownloadable={true}
              excelDownloadProps={excelDownloadProps}
            />
            <TableVatLegend isIncludeVat={false} />
            <PatchedColumnsTable
              {...commonTableProps}
              ref={tableRef}
              loading={loading}
              rowKey={(record) => record.id}
              columns={pickerSelectedColumns}
              dataSource={fbvBrandProductVariants}
              scroll={{ x: tableWidthSum, y: tableScrollY }}
              footer={() => <TableListFooter {...props} />}
              components={{ body: { cell: EditableCell } }}
            />
          </Card>
        </Space>
      </Form>
    </>
  );
};

export default FbvProductListPage;
