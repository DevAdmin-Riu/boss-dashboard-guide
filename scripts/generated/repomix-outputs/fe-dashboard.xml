import { FormChange } from "@hooks/useForm";
import { TProductInfoNotiData } from "@src/app/components/ProductInfoNoti";
import { useProductInfoNotificationTemplatesQuery } from "@src/app/views/product/products/api/queries";
import { Modal, Select, Space } from "antd";
import React, { useState } from "react";

export interface AssignBrandProductWithInfoDialogProps {
  open: boolean;
  loading: boolean;
  onClose: () => void;
  onChange: FormChange;
}

const ProductInfoNotificationTemplatesModal: React.FC<AssignBrandProductWithInfoDialogProps> = (props) => {
  const { open, loading, onClose, onChange } = props;

  const [selectedTemplate, setSelectedTemplate] = useState<TProductInfoNotiData[]>([]);

  const { data: productInfoNotificationTemplatesData, loading: productInfoNotificationTemplatesLoading } =
    useProductInfoNotificationTemplatesQuery({});

  const productInfoNotificationTemplates =
    productInfoNotificationTemplatesData?.productInfoNotificationTemplates as Array<{
      id: string;
      name: string;
      template: TProductInfoNotiData[];
    }>;

  const handleChange = (id: string) => {
    const value = productInfoNotificationTemplates.find((template) => template.id === id)?.template;
    setSelectedTemplate(value);
  };

  const handleOnOk = () => {
    onChange({ target: { name: "productInfoNotification", value: selectedTemplate } });
    onClose();
  };

  return (
    <Modal
      destroyOnClose
      title={"상품정보고시 템플릿 불러오기"}
      open={open}
      onCancel={onClose}
      onOk={handleOnOk}
      okText="추가"
      okButtonProps={{ loading: loading || productInfoNotificationTemplatesLoading }}
      width={600}
    >
      <Space direction="vertical">
        {productInfoNotificationTemplates && (
          <Select onChange={handleChange} style={{ width: 400 }}>
            {productInfoNotificationTemplates.map((templateItem) => (
              <Select.Option key={templateItem.name} value={templateItem.id}>
                {templateItem.name}
              </Select.Option>
            ))}
          </Select>
        )}
      </Space>
    </Modal>
  );
};
export default ProductInfoNotificationTemplatesModal;
