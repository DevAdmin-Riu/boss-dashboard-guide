  questionType: FilterOpts<RefundQuestionTypeEnum[]>;
  status: FilterOpts<RefundStatusTypeEnum[]>;
  answerCreated: FilterOpts<MinMax>;
  refundStatus: FilterOpts<boolean>;
  isRefused: FilterOpts<boolean>;
  refundStatusCreatedAt: FilterOpts<MinMax>;
  orderSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: RefundQuestionListFilterOpts,
  routeParams: RefundQuestionListViewRouteParams
): IFilter<RefundQuestionListFilterKeys> {
  const shop = useShop();
  const refundTypeChoices = shop.refundTypeChoices;
  const { fulfilledBy, status } = routeParams;
  const isFbv = fulfilledBy === "vendor";

  const refundTypeChoicesByIsFbv = isFbv
    ? refundTypeChoices.filter(
        (c) => [RefundQuestionTypeEnum.ETC].includes(c.value as RefundQuestionTypeEnum) === false
      )
    : refundTypeChoices;

  const selectableRefundStatusTypeList: RefundStatusTypeEnum[] = [];
  switch (status) {
    case "stock-included-requested":
      selectableRefundStatusTypeList.push(
        RefundStatusTypeEnum.STOCK_INCLUDED_REQUESTED,
        RefundStatusTypeEnum.STOCK_INCLUDED_APPROVED
      );
      break;
    case "all":
      if (isFbv) {
        selectableRefundStatusTypeList.push(
          RefundStatusTypeEnum.REQUESTED,
          RefundStatusTypeEnum.ACCEPTED,
          RefundStatusTypeEnum.QUESTION_CLOSE
        );
      } else {
        selectableRefundStatusTypeList.push(...Object.values(RefundStatusTypeEnum));
      }
      break;
  }
  const refundStatusTypeChoices = shop.refundStatusTypeChoices.filter((refundStatus) =>
    selectableRefundStatusTypeList.includes(refundStatus.value as RefundStatusTypeEnum)
  );

  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        RefundQuestionListFilterKeys.orderSearch,
        "주문번호",
        opts.orderSearch.value,
        "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
      ),
      active: opts.orderSearch.active,
    },
    {
      ...createTextField(displayOrder++, RefundQuestionListFilterKeys.id, "문의번호", opts.id.value),
      active: opts.id.active,
    },
    isFbv === false && {
      ...createTextField(
        displayOrder++,
        RefundQuestionListFilterKeys.userSearch,
        filterNameConstant.USER_SEARCH,
        opts.userSearch.value
      ),
      active: opts.userSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        RefundQuestionListFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createDateField(
        displayOrder++,
        RefundQuestionListFilterKeys.created,
        filterMsg.questionCreate,
        opts.created.value
      ),
      active: opts.created.active,
    },
    isFbv === false && {
      ...createBooleanField(
        displayOrder++,
        RefundQuestionListFilterKeys.refundStatus,
        "환불처리",
        opts.refundStatus.value,
        {
          negative: "미처리",
          positive: "처리완료",
        }
      ),
      active: opts.refundStatus.active,
    },
    isFbv === false && {
      ...createDateField(
        displayOrder++,
        RefundQuestionListFilterKeys.refundStatusCreatedAt,
        "환불처리일",
        opts.refundStatusCreatedAt.value
      ),
      active: opts.refundStatusCreatedAt.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        RefundQuestionListFilterKeys.questionType,
        "문의 구분",
        opts.questionType.value,
        true,
        refundTypeChoicesByIsFbv
      ),
      active: opts.questionType.active,
    },
    refundStatusTypeChoices.length > 1 && {
      ...createOptionsField(
        displayOrder++,
        RefundQuestionListFilterKeys.status,
        "문의 상태",
        opts.status.value,
        true,
        refundStatusTypeChoices
      ),
      active: opts.status.active,
    },
    status === "all" && {
      ...createBooleanField(
        displayOrder++,
        RefundQuestionListFilterKeys.isRefused,
        "승인/반려 여부",
        opts.isRefused.value,
        {
          negative: "승인",
          positive: "반려",
        }
      ),
      active: opts.isRefused.active,
    },
  ].filter(Boolean);
}
