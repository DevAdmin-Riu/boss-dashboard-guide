    $columns: SalesStatsColumnsInput!
    $includeBossMrkt: Boolean!
    $isRunning: Boolean
  ) {
    salesStats(
      brandSearch: $brandSearch
      statDate: $statDate
      columns: $columns
      includeBossMrkt: $includeBossMrkt
      isRunning: $isRunning
    ) {
      ...SalesStatsFragment
    }
