import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import SpreadFilter from "@src/app/components/Filter/SpreadFilter";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Modal, Space, Table } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { useBrandUpdateMutation } from "../../api/mutations";
import { brandListQuery, useBrandListQuery } from "../../api/queries";
import { Brands_brands_edges_node, BrandsVariables } from "../../api/types/Brands";
import { UpdateBrand } from "../../api/types/UpdateBrand";
import { getBrandContractStatusText, getBrandMdName, getBrandRunningTypeText } from "../../utils";
import { createFilterStructure, getBrandsVariantSearchFilterVariables, getFilterOpts } from "./filters";

const BossMarketBrandList = () => {
  const [modalOpen, setModalOpen] = useState<boolean>(false);
  const [isNotBossMarketUseBrandList, setIsNotBossMarketUseBrandList] = useState<Brands_brands_edges_node[]>([]);
  const [isBossMarketUseBrandList, setIsBossMarketUseBrandList] = useState<Brands_brands_edges_node[]>([]);

  const initialQueryVariables: BrandsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.brands,
    filter: {},
  };
  // SECTION: Query && Mutation START -----
  const { data, loading } = useBrandListQuery({
    variables: {
      ...initialQueryVariables,
    },
  });

  const handleBrandUpdateSuccess = (data: UpdateBrand) => {
    const errors = data.brandUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [updateBrand, updateBrandOpts] = useBrandUpdateMutation({
    onCompleted: handleBrandUpdateSuccess,
    refetchQueries: [brandListQuery],
  });

  // SECTION: Query && Mutation END -----

  // SECTION - Table column 정보 START -----
  const getIsBossMarketUseBrandListTableColumns = () => {
    const columns: ColumnsType<Brands_brands_edges_node> = [
      {
        title: columnNameConstant.brand.BRAND_CODE,
        align: "center",
        key: "brandCode",
        render: (_, record) => record.code,
      },
      {
        title: columnNameConstant.brand.BRAND_NAME,
        align: "center",
        key: "brandName",
        render: (_, record) => record.name,
      },
      {
        title: columnNameConstant.common.BIZ_REG_NO,
        align: "center",
        key: "bizRegNo",
        render: (_, record) => (record.bizInfo?.bizRegNo ? record.bizInfo?.bizRegNo : "-"),
      },
      {
        title: columnNameConstant.brand.BIZ_NAME,
        align: "center",
        key: "bizName",
        render: (_, record) => (record.bizInfo?.bizName ? record.bizInfo?.bizName : "-"),
      },
      {
        title: columnNameConstant.brand.MD_IN_CHARGE,
        align: "center",
        key: "staffFirstName",
        render: (_, record) => getBrandMdName(record.staff),
      },
      {
        title: columnNameConstant.brand.IS_RUNNING,
        align: "center",
        width: 100,
        key: "isRunning",
        render: (_, record) => getBrandRunningTypeText(record.isRunning),
      },
      {
        title: columnNameConstant.brand.CONTRACT_STATUS,
        align: "center",
        width: 100,
        key: "isContract",
        render: (_, record) => getBrandContractStatusText(record.contractStatus),
      },
      {
        title: "삭제",
        align: "center",
        render: (_, record) => (
          <Button
            danger
            size="small"
            disabled={updateBrandOpts.loading}
            onClick={() => {
              updateBrand({
                variables: {
                  id: record.id,
                  input: {
                    isBossMarketUse: false,
                  },
                  skipBrandData: true,
                },
              });
            }}
          >
            삭제
          </Button>
        ),
      },
    ];
    return columns;
  };
  const tableWidthSumForBossMarketUseBrand = utils.calcTableColsWidthSum(getIsBossMarketUseBrandListTableColumns());

  const getIsNotBossMarketUseBrandListTableColumns = () => {
    const columns: ColumnsType<Brands_brands_edges_node> = [
      {
        title: columnNameConstant.brand.BRAND_NAME,
        align: "center",
        key: "brandName",
        render: (_, record) => record.name,
      },
      {
        title: columnNameConstant.common.BIZ_REG_NO,
        align: "center",
        key: "bizRegNo",
        render: (_, record) => record.bizInfo.bizRegNo,
      },
      {
        title: columnNameConstant.brand.IS_RUNNING,
        align: "center",
        width: 100,
        key: "isRunning",
        render: (_, record) => getBrandRunningTypeText(record.isRunning),
      },
      {
        title: columnNameConstant.brand.CONTRACT_STATUS,
        align: "center",
        width: 100,
        key: "isContract",
        render: (_, record) => getBrandContractStatusText(record.contractStatus),
      },
      {
        title: "추가",
        align: "center",
        render: (_, record) => (
          <Button
            size="small"
            type="primary"
            disabled={updateBrandOpts.loading}
            onClick={() => {
              updateBrand({
                variables: {
                  id: record.id,
                  input: {
                    isBossMarketUse: true,
                  },
                  skipBrandData: true,
                },
              });
            }}
          >
            추가
          </Button>
        ),
      },
    ];
    return columns;
  };
  const tableWidthSumForNotBossMarketUseBrand = utils.calcTableColsWidthSum(
    getIsNotBossMarketUseBrandListTableColumns()
  );
  // SECTION - Table column 정보 END -----

  const modalCloseEvent = () => {
    setModalOpen(false);
  };

  const getBrandListIsBossMarket = ({ isBossMarketUse }) =>
    data?.brands.edges
      .map((edge) => ({ ...edge.node, key: edge.node.id }))
      .filter((item) => (isBossMarketUse ? item.isBossMarketUse : !item.isBossMarketUse));

  const searchBrand = (value) => {
    if (value && value.trim() !== "") {
      return getBrandListIsBossMarket({ isBossMarketUse: false }).filter((item) => item.name.indexOf(value) !== -1);
    } else {
      return getBrandListIsBossMarket({ isBossMarketUse: false });
    }
  };

  useEffect(() => {
    if (data) {
      setIsNotBossMarketUseBrandList(getBrandListIsBossMarket({ isBossMarketUse: false }));
      setIsBossMarketUseBrandList(getBrandListIsBossMarket({ isBossMarketUse: true }));
    }
  }, [data]);

  // SECTION: 추가 UI START -----
  const cardTitle = (
    <CardTitleAntd
      title={"보스장터 이용 브랜드"}
      extra={
        <Space direction="horizontal" align="center">
          <Button onClick={() => setModalOpen(true)} type="primary">
            추가
          </Button>
        </Space>
      }
    />
  );
  // SECTION: 추가 UI END -----

  return (
    <>
      <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
        <Table
          {...commonTableProps}
          loading={loading}
          columns={getIsBossMarketUseBrandListTableColumns()}
          dataSource={isBossMarketUseBrandList}
          scroll={{ x: tableWidthSumForBossMarketUseBrand, y: 450 }}
        />
      </Card>
      <Modal
        destroyOnClose
        title="보스장터 이용 브랜드 추가"
        open={modalOpen}
        width={900}
        onCancel={modalCloseEvent}
        footer={
          <Button type="default" onClick={modalCloseEvent}>
            뒤로
          </Button>
        }
        maskClosable={false}
      >
        <SpreadFilter
          currencySymbol="원"
          menu={createFilterStructure(getFilterOpts(initialQueryVariables?.filter))}
          onFilterChange={(filters) => {
            const getFilterVariables = getBrandsVariantSearchFilterVariables(filters);
            setIsNotBossMarketUseBrandList(
              searchBrand(getFilterVariables.search).filter((item) => {
                let isValid = true;

                if (getFilterVariables.isRunning !== undefined) {
                  isValid = isValid && item.isRunning === getFilterVariables.isRunning;
                }

                return isValid;
              })
            );
          }}
        />
        <Table
          {...commonTableProps}
          dataSource={isNotBossMarketUseBrandList}
          columns={getIsNotBossMarketUseBrandListTableColumns()}
          loading={loading}
          scroll={{ x: tableWidthSumForNotBossMarketUseBrand, y: 700 }}
        ></Table>
      </Modal>
    </>
  );
};

export default BossMarketBrandList;
</file>

