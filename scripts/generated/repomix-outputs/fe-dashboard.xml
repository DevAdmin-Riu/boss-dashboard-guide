  currencySymbol: string;
  disabled: boolean;
  errors: ProductErrorWithAttributesFragment[];
  title: string;
  product: ProductForCreateVariant_product;
  copyVariant?: ProductVariantDetails_productVariant;
  saveButtonBarState: ConfirmButtonTransitionState;
  warehouses: SearchWarehouses_search_edges_node[];
  makers: SearchMakers_search_edges_node[];
  fetchMoreMakers: FetchMoreProps;
  fetchMakers: (query: string) => void;
  onBack: () => void;
  onSubmit: (data: ProductVariantCreateData) => void;
  onVariantClick: (variantId: string) => void;
  onVariantReorder: ReorderAction;
  onWarehouseConfigure: () => void;
}

export const ProductVariantCreatePage: React.FC<ProductVariantCreatePageProps> = ({
  disabled,
  errors,
  title,
  product,
  copyVariant,
  saveButtonBarState,
  warehouses,
  makers: makerChoiceList,
  fetchMoreMakers,
  fetchMakers,
  onBack,
  onSubmit,
  onVariantClick,
  onVariantReorder,
  onWarehouseConfigure,
}) => {
  const { allCountries } = useShop();
  return (
    <ProductVariantCreateForm product={product} copyVariant={copyVariant} onSubmit={onSubmit} warehouses={warehouses}>
      {({ change, data, handlers, hasChanged, submit }) => (
        <>
          <AppHeader onBack={onBack}>{product?.name}</AppHeader>
          <PageHeader title={title} />
          <Grid variant="inverted">
            <div>
              <ProductVariantNavigation
                defaultVariantId={product?.defaultVariantId}
                variants={product?.outerVariants}
                onRowClick={(variantId: string) => {
                  if (product && product.outerVariants) {
                    return onVariantClick(variantId);
                  }
                }}
                onReorder={onVariantReorder}
              />
            </div>
            <div>
              <ProductVariantBasicForm
                product={product}
                data={data}
                disabled={disabled}
                isFulfilledByVendor={false}
                errors={errors}
                onChange={change}
              />
              <CardSpacer />
              <ProductAttributes
                isProductPage={false}
                data={data}
                disabled={disabled}
                isFulfilledByVendor={false}
                errors={errors}
                makers={makerChoiceList}
                fetchMoreMakers={fetchMoreMakers}
                fetchMakers={fetchMakers}
                onChange={change}
                onSingleAttrChange={handlers.selectAttribute}
                onMultiAttrChange={handlers.selectAttribute}
                allCountries={allCountries}
              />
              <CardSpacer />
              <ProductDefaultVendor
                data={data}
                isFulfilledByVendor={false}
                errors={errors}
                onChange={change}
                disabled={disabled}
              />
              <CardSpacer />
              <Row gutter={[12, 12]}>
                <Col span={12}>
                  <ProductPoNote data={data} errors={errors} onChange={change} />
                </Col>
                <Col span={12}>
                  <ProductNote data={data} errors={errors} onChange={change} />
                </Col>
              </Row>
              <CardSpacer />
              <ProductStocks
                data={data}
                disabled={disabled}
                warehouses={warehouses}
                onChange={change}
                onWarehouseConfigure={onWarehouseConfigure}
                // 직거래 상품 상품은 옵션형 상품이 없어 isFulfilledByVendor 값 false 고정
                isFulfilledByVendor={false}
              />
            </div>
          </Grid>
          <SaveButtonBar
            disabled={disabled || !onSubmit || !hasChanged}
            labels={{
              delete: "옵션 삭제",
              save: copyVariant ? "옵션 복사 생성" : "옵션 저장",
            }}
            state={saveButtonBarState}
            onCancel={onBack}
            onSave={submit}
          />
        </>
      )}
    </ProductVariantCreateForm>
  );
};
