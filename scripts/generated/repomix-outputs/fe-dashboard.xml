<file path="src/app/views/vendorStaff/vsSection/components/VsPurchaseOrderLineListPage/VsPurchaseOrderLineListPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import { PurchaseOrderLineStatus } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  PurchaseOrderLineList,
  PurchaseOrderLineList_purchaseOrderLines_edges_node,
  PurchaseOrderLineListVariables,
} from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseOrderLineList";
import { getVsPurchaseOrderLineListTableSettings } from "@src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineListPage/PurchaseOrderLineListTableSettings";
import {
  PurchaseOrderLineListViewRouteParams,
  PurchaseOrderLineListViewUrlDialog,
  PurchaseOrderLineListViewUrlQueryParams,
  PurchaseOrderLineListViewUrlSortField,
} from "@src/app/views/purchase/purchaseOrders/urls";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import _ from "lodash";
import React from "react";
import { useParams } from "react-router";

import { createFilterStructure, VsPurchaseOrderLineFilterKeys, VsPurchaseOrderLineListFilterOpts } from "./filters";
import { createSorterStructure } from "./sorters";

interface VsPurchaseOrderLineListPageProps
  extends PaginateListProps,
    FilterPageProps<VsPurchaseOrderLineFilterKeys, VsPurchaseOrderLineListFilterOpts>,
    SortPage<PurchaseOrderLineListViewUrlSortField> {
  params: PurchaseOrderLineListViewUrlQueryParams;
  purchaseOrderLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  fetchForDownload: (variables?: PurchaseOrderLineListVariables) => Promise<ApolloQueryResult<PurchaseOrderLineList>>;
  queryVariablesWithoutPagination: PurchaseOrderLineListVariables;
  openModal: (action: PurchaseOrderLineListViewUrlDialog, newParams?: PurchaseOrderLineListViewUrlQueryParams) => void;
  closeModal: () => void;
  onDeliveryConfirmed: () => void;
  onInvoicePrint: () => void;
  onDelivered: () => void;
  selectedRowIds: React.Key[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<React.Key[]>>;
  isB2b: boolean;
  isByNonCourier: boolean;
  ListNavigator: () => React.JSX.Element;
}

export const VsPurchaseOrderLineListPage: React.FC<VsPurchaseOrderLineListPageProps> = ({
  params,
  purchaseOrderLines,
  currencySymbol,
  currentTab,
  filterOpts,
  tabs,
  sort,
  onSort,
  onAll,
  onFilterChange,
  onTabChange,
  onTabDelete,
  onTabSave,
  fetchForDownload,
  queryVariablesWithoutPagination,
  openModal,
  closeModal,
  onDeliveryConfirmed,
  onInvoicePrint,
  onDelivered,
  selectedRowIds,
  setSelectedRowIds,
  isB2b,
  isByNonCourier,
  ListNavigator,
  ...listProps
}) => {
  const { user } = useUser();
  const { courierDeliveryAdditionalFeeList } = useShop();
  const routeParams = useParams<PurchaseOrderLineListViewRouteParams>();
  const filterStructure = createFilterStructure(filterOpts, routeParams, isB2b);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const isTrackInventoryList = routeParams.inventoryType === "track-inventory";
  const isConsignmentList = routeParams.inventoryType === "consignment";

  const rowSelection: TableRowSelection<PurchaseOrderLineList_purchaseOrderLines_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
    getCheckboxProps: (record) => {
      const { status } = routeParams;
      if (status === "complete-delivery") {
        if (isTrackInventoryList) {
          return { disabled: record.status !== PurchaseOrderLineStatus.STOCKED };
        } else if (isConsignmentList) {
          return { disabled: record.status !== PurchaseOrderLineStatus.INVOICE_PRINTED };
        }
      }
      return {};
    },
  };

  const onAttachDeliveryConfirmDocButtonClick = (id: string): void => {
    openModal("attach-delivery-confirm-doc", { id });
    setSelectedRowIds([id]);
  };

  const columns = getVsPurchaseOrderLineListTableSettings({
    routeParams,
    openModal,
    onAttachDeliveryConfirmDocButtonClick,
    isB2b,
    courierDeliveryAdditionalFeeList,
    user,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "purchaseOrderLines",
  };

  let pageTitle: string = "";
  let extraUi: React.ReactNode = null;
  let showRowSelection: boolean = true;

  const bulkBtnDisabled = selectedRowIds.length === 0 || listProps.disabled;
  switch (routeParams.status) {
    case "receive":
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            danger
            onClick={() => {
              openModal("reject-lines");
            }}
            disabled={bulkBtnDisabled}
          >
            접수 거부
          </Button>
          <Button
            type="primary"
            shape="round"
            onClick={() => {
              openModal("receive-lines");
            }}
            disabled={bulkBtnDisabled}
          >
            발주 접수
          </Button>
        </Space>
      );

      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.vsReceiveA;
      } else if (isConsignmentList) {
        pageTitle = sectionNames.purchaseOrderLine.vsReceiveB;
      }
      break;
    case "dispatch-fulfillment":
      extraUi = (
        <Space>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={() => openModal("req-epd-update")}>
            납품예정일 변경 요청
          </Button>
          <Button
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("dispatch-fulfillment")}
          >
            출고 지시
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            출고 거부
          </Button>
        </Space>
      );

      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.vsDispatchFulfillmentA;
      } else if (isConsignmentList) {
        pageTitle = isB2b
          ? sectionNames.purchaseOrderLine.vsB2bDispatchFulfillmentB
          : isByNonCourier
          ? sectionNames.purchaseOrderLine.vsDispatchFulfillmentByNonCourier
          : sectionNames.purchaseOrderLine.vsDispatchFulfillmentByCourier;
      }
      break;
    case "confirm-delivery":
      pageTitle = sectionNames.purchaseOrderLine.vsConfirmDeliveryA;
      extraUi = (
        <Space>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={() => onDeliveryConfirmed()}>
            배송 확정
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            출고 취소
          </Button>
        </Space>
      );
      break;
    case "print-invoice":
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            icon={<DownloadOutlined />}
            disabled={bulkBtnDisabled}
            onClick={onInvoicePrint}
          >
            거래명세서 출력
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            배송 취소
          </Button>
        </Space>
      );

      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.vsPrintInvoiceA;
      } else if (isConsignmentList) {
        pageTitle = isB2b
          ? sectionNames.purchaseOrderLine.vsB2bPrintInvoiceB
          : sectionNames.purchaseOrderLine.vsPrintInvoiceB;
      }
      break;
    case "complete-delivery":
      extraUi = (
        <Space>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={onDelivered}>
            배송 완료
          </Button>
        </Space>
      );

      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.vsCompleteDeliveryA;
      } else if (isConsignmentList) {
        pageTitle = isB2b
          ? sectionNames.purchaseOrderLine.vsB2bCompleteDeliveryB
          : sectionNames.purchaseOrderLine.vsCompleteDeliveryB;
      }
      break;
    case "all-status":
      pageTitle = sectionNames.purchaseOrderLine.allStatus;
      showRowSelection = false;
      break;
    default:
      pageTitle = "";
      extraUi = null;
      break;
  }

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          {ListNavigator ? (
            <Col span={24} style={{ marginBottom: 15 }}>
              {ListNavigator()}
            </Col>
          ) : (
            <Col>
              <Typography.Title level={4}>{pageTitle}</Typography.Title>
            </Col>
          )}
          <Col span={24}>
            <div style={{ float: "right" }}>{extraUi}</div>
          </Col>
        </Row>

        <Card>
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            tabExtra={
              <>
                <ColumnPicker
                  columns={pickColumns}
                  loading={listProps.disabled}
                  initialColumns={initialColumns}
                  total={pickColumns?.length}
                  onSave={handleSave}
                />
                <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
              </>
            }
            excelDownloadProps={excelDownloadProps}
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            rowSelection={showRowSelection && rowSelection}
            dataSource={purchaseOrderLines}
            columns={pickerSelectedColumns}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};
</file>

