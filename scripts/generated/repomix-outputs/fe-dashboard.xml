import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";
import React, { useState } from "react";

import {
  useFbvPurchaseCostStatsForHqListFilterDownloadQuery,
  useFbvPurchaseCostStatsForHqListQuery,
  useFbvPurchaseCostStatsForVendorListFilterDownloadQuery,
  useFbvPurchaseCostStatsForVendorListQuery,
} from "../../api/queries";
import {
  FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq,
  FbvPurchaseCostStatsForHqVariables,
} from "../../api/types/FbvPurchaseCostStatsForHq";
import { FbvPurchaseCostStatsForVendorVariables } from "../../api/types/FbvPurchaseCostStatsForVendor";
import { FbvPurchaseCostEventCreateModal } from "../../components/FbvPurchaseCostEventCreateModal";
import { FulfilledByVendorPurchaseCostStatListPage } from "../../components/FulfilledByVendorPurchaseCostStatListPage/FulfilledByVendorPurchaseCostStatListPage";
import {
  brandFulfilledByVendorPurchaseCostEventListViewUrl,
  fulfilledByVendorPurchaseCostEventListViewUrl,
  FulfilledByVendorPurchaseCostStatListViewUrlDialog,
  FulfilledByVendorPurchaseCostStatListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  fromStatsToEventsConvertParams,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface FulfilledByVendorPurchaseCostStatListViewProps {
  defaultParams: FulfilledByVendorPurchaseCostStatListViewUrlQueryParams;
  params: FulfilledByVendorPurchaseCostStatListViewUrlQueryParams;
  targetUrl: (params?: FulfilledByVendorPurchaseCostStatListViewUrlQueryParams) => string;
}

export const FulfilledByVendorPurchaseCostStatListView: React.FC<FulfilledByVendorPurchaseCostStatListViewProps> = ({
  defaultParams,
  params,
  targetUrl,
}) => {
  const { user } = useUser();
  const nowDate = moment();

  const filterVariables = getFilterVariables(params);

  const statDate: string[] | null = filterVariables?.statDate?.lte.split("-");
  const statDateYear: number | null = statDate ? Number(statDate[0]) : null;
  const statDateMonth: number | null = statDate ? Number(statDate[1]) : null;
  const nowDateYear: number = nowDate.get("year");
  const nowDateMonth: number = nowDate.get("month") + 1;
  const isSameMonthAndYear: boolean = statDateYear === nowDateYear && statDateMonth === nowDateMonth;

  const brand = user.brand;
  const [selectedRow, setSelectedRow] = useState<FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq>(null);
  const isHqStaff = user.isHqStaff;
  const { navigate } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.FULFILLED_BY_VENDOR_PURCHASE_COST_STAT_LIST,
  });
  let fetchForDownload;

  if (isHqStaff) {
    const { fetchForDownload: refetch } = utils.initListViewDownloadQuery(
      useFbvPurchaseCostStatsForHqListFilterDownloadQuery
    );
    fetchForDownload = refetch;
  } else {
    const { fetchForDownload: refetch } = utils.initListViewDownloadQuery(
      useFbvPurchaseCostStatsForVendorListFilterDownloadQuery
    );
    fetchForDownload = refetch;
  }

  const queryVariables: FbvPurchaseCostStatsForHqVariables = React.useMemo(
    () => ({ brandId: brand?.id, filter: filterVariables }),
    [params]
  );
  const vendorQueryVariables: FbvPurchaseCostStatsForVendorVariables = React.useMemo(
    () => ({ vendorId: user?.vendor?.id, filter: filterVariables }),
    [params]
  );

  const { data, loading, refetch } = isHqStaff
    ? useFbvPurchaseCostStatsForHqListQuery({
        skip: !brand,
        variables: queryVariables,
      })
    : useFbvPurchaseCostStatsForVendorListQuery({
        skip: !user?.vendor?.id,
        variables: vendorQueryVariables,
      });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    FulfilledByVendorPurchaseCostStatListViewUrlDialog,
    FulfilledByVendorPurchaseCostStatListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.fbv} />
      <FulfilledByVendorPurchaseCostStatListPage
        disabled={loading}
        fbvPurchaseCostStats={maybe(
          () =>
            isHqStaff
              ? "fbvPurchaseCostStatsForHq" in data && data?.fbvPurchaseCostStatsForHq
              : "fbvPurchaseCostStatsForVendor" in data && data?.fbvPurchaseCostStatsForVendor,
          []
        )}
        onRowClick={(id) =>
          navigate(
            isHqStaff
              ? fulfilledByVendorPurchaseCostEventListViewUrl(id, fromStatsToEventsConvertParams(params))
              : brandFulfilledByVendorPurchaseCostEventListViewUrl(id, fromStatsToEventsConvertParams(params))
          )
        }
        onCreateFbvPurchaseCostEvent={(selectedStat, action) => {
          setSelectedRow(selectedStat);
          openModal(action);
        }}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariables}
        fetchForDownload={fetchForDownload}
        isHqStaff={isHqStaff}
        isSameMonthAndYear={isSameMonthAndYear}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <FbvPurchaseCostEventCreateModal
        open={[
          "create-fbv-purchase-cost-settlement",
          "create-fbv-purchase-cost-increase",
          "create-fbv-purchase-cost-decrease",
        ].includes(params.action)}
        loading={loading}
        action={params.action}
        brand={brand}
        vendor={selectedRow?.vendor}
        remainAmount={selectedRow?.remainAmount}
        onClose={() => {
          closeModal();
          setSelectedRow(null);
        }}
        isHqStaff={isHqStaff}
      />
    </>
  );
};
</file>

