import {
  PoEventTypeEnum,
  PurchasesStatsFilterInput,
  VendorContactTypeEnum,
  VendorPayMethodEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariablesForMonth,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  PurchasesStatByVendorFilterKeys,
  PurchasesStatByVendorListFilterOpts,
} from "../../components/PurchasesStatByVendorListPage/filters";
import {
  PurchasesStatByVendorListViewUrlFilters,
  PurchasesStatByVendorListViewUrlFiltersEnum,
  PurchasesStatByVendorListViewUrlFiltersWithMultipleValuesEnum,
  PurchasesStatByVendorListViewUrlQueryParams,
} from "../../urls";

const PURCHASES_STAT_BY_VENDOR_FILTERS_KEY = "purchasesStatByVendorFilters";

export function getFilterOpts(params: PurchasesStatByVendorListViewUrlFilters): PurchasesStatByVendorListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    statDateMonth: {
      active: maybe(() => !utils.isEmpty([filterVariables.statDate.gte]), false),
      value: maybe(
        () => moment(filterVariables.statDate.gte).format(onlyMonthFormat),
        moment().format(onlyMonthFormat)
      ),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    payMethods: {
      active: maybe(() => !utils.isEmpty(filterVariables.payMethods), false),
      value: maybe(() => dedupeFilter(filterVariables.payMethods), []),
    },
    poEventTypes: {
      active: maybe(() => !utils.isEmpty(filterVariables.poEventTypes), false),
      value: maybe(() => dedupeFilter(filterVariables.poEventTypes), []),
    },
    vendorContactType: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorContactType), true),
      value: maybe(() => dedupeFilter(filterVariables.vendorContactType), []),
    },
  };
}

export function getFilterVariables(params: PurchasesStatByVendorListViewUrlFilters): PurchasesStatsFilterInput {
  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateMonth, lte: params.statDateMonth }),
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : undefined,
    payMethods: maybe(() => params.payMethods.map((method) => findInEnum(method, VendorPayMethodEnum))),
    poEventTypes: maybe(() => params.poEventTypes.map((type) => findInEnum(type, PoEventTypeEnum))),
    vendorContactType: maybe(() => params.vendorContactType.map((type) => findInEnum(type, VendorContactTypeEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<PurchasesStatByVendorFilterKeys>
): PurchasesStatByVendorListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case PurchasesStatByVendorFilterKeys.statDateMonth:
      return getSingleValueQueryParam(filter, PurchasesStatByVendorListViewUrlFiltersEnum.statDateMonth);
    case PurchasesStatByVendorFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, PurchasesStatByVendorListViewUrlFiltersEnum.vendorSearch);
    case PurchasesStatByVendorFilterKeys.payMethods:
      return getMultipleValueQueryParam(
        filter,
        PurchasesStatByVendorListViewUrlFiltersWithMultipleValuesEnum.payMethods
      );
    case PurchasesStatByVendorFilterKeys.poEventTypes:
      return getMultipleValueQueryParam(
        filter,
        PurchasesStatByVendorListViewUrlFiltersWithMultipleValuesEnum.poEventTypes
      );
    case PurchasesStatByVendorFilterKeys.vendorContactType:
      return getMultipleValueQueryParam(
        filter,
        PurchasesStatByVendorListViewUrlFiltersWithMultipleValuesEnum.vendorContactType
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PurchasesStatByVendorListViewUrlFilters>(PURCHASES_STAT_BY_VENDOR_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PurchasesStatByVendorListViewUrlQueryParams,
  PurchasesStatByVendorListViewUrlFilters
>({ ...PurchasesStatByVendorListViewUrlFiltersEnum, ...PurchasesStatByVendorListViewUrlFiltersWithMultipleValuesEnum });
