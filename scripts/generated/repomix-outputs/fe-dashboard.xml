<file path="src/app/views/product/stock/components/RackStockDetailMemoComponent.tsx">
import { MinusSquareOutlined, PlusSquareOutlined } from "@ant-design/icons";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { detailDateFormat, getDateByFormat } from "@src/app/providers/DateProvider";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { Button, Collapse, Form, Input, Space, Typography } from "antd";
import React, { useState } from "react";

import { useRackStockDetailMemoDeleteMutation, useRackStockDetailMemoUpdateMutation } from "../api/mutations";
import { RackStockListForStockAction_rackStocks_edges_node } from "../api/types/RackStockListForStockAction";

interface RackStockDetailMemoComponentProps {
  rackStock: Pick<
    RackStockListForStockAction_rackStocks_edges_node,
    "id" | "memo" | "memoUpdatedAt" | "memoUpdatedWriter"
  >;
}

const RackStockDetailMemoComponent: React.FC<RackStockDetailMemoComponentProps> = ({ rackStock }) => {
  const [form] = Form.useForm();
  const { id, memo, memoUpdatedAt, memoUpdatedWriter } = rackStock;

  const [isUpdateMemo, setIsUpdateMemo] = useState(false);
  const [showConfirmModal, setShowConfirmModal] = useState<boolean>(false);
  const [collapseActiveKey, setCollapseActiveKey] = useState<string[]>([]);

  const [rackStockDetailMemoUpdate, { loading: rackStockDetailMemoUpdateLoading }] =
    useRackStockDetailMemoUpdateMutation({
      onCompleted: (data) => {
        const errors = data.rackStockDetailMemoUpdate.errors;
        if (errors?.length) {
          showGqlErrors(errors);
        } else {
          showNotificationSuccess("메모가 업데이트되었습니다.");
          setIsUpdateMemo(false);
        }
      },
    });

  const [rackStockDetailMemoDelete, { loading: rackStockDetailMemoDeleteLoading }] =
    useRackStockDetailMemoDeleteMutation({
      onCompleted: (data) => {
        const errors = data.rackStockDetailMemoDelete.errors;
        if (errors?.length) {
          showGqlErrors(errors);
        } else {
          showNotificationSuccess("메모가 삭제되었습니다.");
          setIsUpdateMemo(false);
        }
      },
    });

  const onCollapseOpen = () => {
    setCollapseActiveKey(["0"]);
  };

  const handleUpdate = () => {
    onCollapseOpen();
    setIsUpdateMemo(true);
  };

  const handleSave = () => {
    rackStockDetailMemoUpdate({
      variables: {
        id,
        input: { memo: form.getFieldValue("memo") },
      },
    });
  };

  const handleDelete = () => {
    rackStockDetailMemoDelete({
      variables: {
        id,
        input: { memo: "" },
      },
    });
    form.setFieldValue("memo", "");
    setShowConfirmModal(false);
  };

  const handleCancel = () => {
    form.setFieldValue("memo", memo);
    setIsUpdateMemo(false);
  };

  let memoUpdateInfo = <></>;
  if (memoUpdatedAt && memoUpdatedWriter?.firstName) {
    const memoUpdatedAtFormatted = getDateByFormat(memoUpdatedAt, detailDateFormat, undefined);
    memoUpdateInfo = (
      <Typography.Text strong>
        {memoUpdatedWriter?.firstName} {memoUpdatedAtFormatted}
      </Typography.Text>
    );
  }

  return (
    <Form component="div" style={{ width: "100%" }} form={form} initialValues={{ memo }}>
      <Collapse
        ghost
        collapsible="icon"
        activeKey={collapseActiveKey}
        expandIcon={({ isActive }) => (isActive ? <MinusSquareOutlined /> : <PlusSquareOutlined />)}
        onChange={(key) => setCollapseActiveKey(key as string[])}
      >
        <Collapse.Panel
          key="0"
          header={memoUpdatedWriter ? memoUpdateInfo : "없음"}
          extra={
            <Space size="small">
              {isUpdateMemo ? (
                <>
                  <Button
                    size="small"
                    type="primary"
                    onClick={handleSave}
                    loading={rackStockDetailMemoUpdateLoading || rackStockDetailMemoDeleteLoading}
                  >
                    저장
                  </Button>
                  <Button size="small" onClick={handleCancel} danger>
                    취소
                  </Button>
                </>
              ) : (
                <>
                  <Button size="small" type="primary" onClick={handleUpdate}>
                    {memoUpdatedWriter ? "수정" : "추가"}
                  </Button>
                  {memoUpdatedWriter && (
                    <Button
                      danger
                      size="small"
                      onClick={() => setShowConfirmModal(true)}
                      loading={rackStockDetailMemoUpdateLoading || rackStockDetailMemoDeleteLoading}
                    >
                      삭제
                    </Button>
                  )}
                </>
              )}
            </Space>
          }
        >
          {isUpdateMemo ? (
            <Form.Item name="memo">
              <Input.TextArea />
            </Form.Item>
          ) : (
            <Typography.Text>{memo ? memo : "-"}</Typography.Text>
          )}
        </Collapse.Panel>
      </Collapse>
      <ConfirmModal
        topOfMuiDialog
        modalTitleText=""
        visible={showConfirmModal}
        titleText="메모를 삭제하시겠습니까?"
        helpText=""
        onOk={handleDelete}
        onCancel={() => {
          setShowConfirmModal(false);
        }}
      />
    </Form>
  );
};

export default RackStockDetailMemoComponent;
</file>

