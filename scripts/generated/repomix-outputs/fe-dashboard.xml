<file path="src/app/views/hqStaff/hqRequestProduct/components/HqReqBossProductCreatePage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import {
  RequestBossProductCreateByProductVariantInput,
  RequestBossProductCreateInput,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import AppHeader from "@src/app/components/AppHeader";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import AntdSaveButtonBar, { ISaveButtonBarLabels } from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { AttributeSlugEnum, getAttrAndValuesBySlug } from "@src/app/views/product/products/utils/data";
import { BossProductRequestedInfo } from "@src/app/views/requestProduct/components/BossProductRequestedInfo";
import {
  ProductVariantListForReqTable,
  ProductVariantListForReqTableProps,
} from "@src/app/views/requestProduct/components/ProductVariantListForReqTable/ProductVariantListForReqTable";
import {
  makeByProductVariantFormItem,
  makeDirectRequestFormItems,
  makeIsExclusiveFormItem,
} from "@src/app/views/requestProduct/components/ReqBossProductFormItems";
import { transformReqByProductVariant } from "@src/app/views/requestProduct/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { transformIsExclusive } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { Card, Form, PageHeader, Space, Steps } from "antd";
import React, { useEffect, useState } from "react";

import { BrandSelectionStep } from "./BrandSelectionStep";
import { HqReqBossProductCreateByVariantModal } from "./HqReqBossProductCreateByVariantModal";

export interface IReqBossProductCreateForm extends StrictOmit<RequestBossProductCreateInput, "brand"> {
  byProductVariant: boolean;
}

export type TReqBossProductCreateByProductVariantForm = StrictOmit<
  RequestBossProductCreateByProductVariantInput,
  "brand"
>;

interface HqReqBossProductCreatePageProps {
  loading: boolean;
  confirmButtonState: ConfirmButtonTransitionState;
  needsBrandSelection?: boolean;
  selectedBrand?: any;
  onBrandSelect?: (brand: any) => void;
  reqByProductVariantProps: ProductVariantListForReqTableProps;
  onQueryProductVariants: () => void;
  onCreate: (input: IReqBossProductCreateForm) => void;
  onCreateByProductVariant: (input: TReqBossProductCreateByProductVariantForm) => void;
  onCloseModal: () => void;
  onBack: () => void;
}

export const HqReqBossProductCreatePage: React.FC<HqReqBossProductCreatePageProps> = (props) => {
  const {
    loading,
    confirmButtonState,
    needsBrandSelection,
    selectedBrand,
    onBrandSelect,
    reqByProductVariantProps,
    onQueryProductVariants,
    onCreate,
    onCreateByProductVariant,
    onCloseModal,
    onBack,
  } = props;
  const { params, productVariants } = reqByProductVariantProps;
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [currentStep, setCurrentStep] = useState<number>(needsBrandSelection && !selectedBrand ? -1 : 0);
  const [createForm] = Form.useForm<IReqBossProductCreateForm>();
  const [createByProductVariantForm] = Form.useForm<TReqBossProductCreateByProductVariantForm>();
  const CreateTypeSafeForm = getTypeSafeForm<IReqBossProductCreateForm>(createForm);
  const CreateByProductVariantTypeSafeForm =
    getTypeSafeForm<TReqBossProductCreateByProductVariantForm>(createByProductVariantForm);

  const isExclusiveWatched = CreateTypeSafeForm.getUseFormWatched({ name: "isExclusive" });
  const byProductVariantWatched = CreateTypeSafeForm.getUseFormWatched({ name: "byProductVariant" });
  const variantIdWatched = CreateByProductVariantTypeSafeForm.getUseFormWatched({ name: "variant" });

  const isBrandSelectStep = needsBrandSelection && currentStep === -1;
  const isExclusiveSelectStep = currentStep === 0;
  const isRequestWriteStep = currentStep === 1;
  const isRequestCreateStep = currentStep === 2;

  const isExclusiveText = transformIsExclusive(isExclusiveWatched);
  const byProductVariantText = transformReqByProductVariant(byProductVariantWatched);
  const requestWriteStepTitle = isExclusiveWatched ? isExclusiveText : `${isExclusiveText} > ${byProductVariantText}`;

  const initialValues: IReqBossProductCreateForm = {
    isExclusive: null,
    byProductVariant: null,
    maker: null,
    makerSku: null,
    spec: null,
    material: null,
    color: null,
    qtyPerBox: null,
    estMonthlyQty: null,
    useMicrowave: false,
    designMemo: null,
    functionMemo: null,
    etcMemo: null,
    productName: null,
    imageList: [],
  };
  const fieldNames = Object.keys(initialValues);
  const isExclusiveSelectStepFieldNames = ["isExclusive", "byProductVariant"];
  const requestWriteStepFieldNames = fieldNames.filter((name) => !isExclusiveSelectStepFieldNames.includes(name));

  useEffect(() => {
    createForm.resetFields();
  }, []);

  useEffect(() => {
    if (currentStep === 1 && byProductVariantWatched === true) {
      onQueryProductVariants();
    }
  }, [currentStep]);

  const createFormValues = createForm.getFieldsValue();
  const createByProductVariantFormValues = createByProductVariantForm.getFieldsValue();
  const selectedVariant = productVariants.find((pv) => pv.id === variantIdWatched);
  const attributeList = [...(selectedVariant?.attributes || []), ...(selectedVariant?.product?.attributes || [])];
  const dataForInfo = byProductVariantWatched
    ? {
        ...createFormValues,
        ...selectedVariant,
        ...createByProductVariantFormValues,
        maker: selectedVariant?.maker?.name,
        spec: getAttrAndValuesBySlug(attributeList, AttributeSlugEnum.size).attrValues[0],
        material: getAttrAndValuesBySlug(attributeList, AttributeSlugEnum.material).attrValues[0],
        color: getAttrAndValuesBySlug(attributeList, AttributeSlugEnum.color).attrValues[0],
        useMicrowave: false,
      }
    : createFormValues;
  const dataImageListForInfo = byProductVariantWatched ? selectedVariant?.product?.images : createFormValues?.imageList;

  const onPrevStep = () => setCurrentStep((prev) => prev - 1);
  const onNextStep = () => setCurrentStep((prev) => prev + 1);
  const onInvalidFieldsNotify = () =>
    showNotificationError("필수 입력 항목 값이 없거나 잘못된 값이 있습니다. 확인 후 다시 시도해주세요.");

  let saveButtonLabels: ISaveButtonBarLabels;
  let onCancel: () => void;
  let onSave: () => void;
  switch (currentStep) {
    case -1:
      // 브랜드 선택 스텝 (staff만)
      saveButtonLabels = { cancel: "취소", save: "다음" };
      onCancel = onBack;
      onSave = () => {
        if (!selectedBrand) {
          showNotificationError("브랜드를 선택해주세요.");
        } else {
          setCurrentStep(0);
        }
      };
      break;
    case 0:
      saveButtonLabels = { cancel: needsBrandSelection ? "이전" : "취소", save: "다음" };
      onCancel = needsBrandSelection ? onPrevStep : onBack;
      onSave = () => {
        // 요청 내용 작성 중, 이전 스텝(상품 종류 선택)으로 돌아와서 변경 후 다시 다음 스텝으로 넘어가는 경우 고려하여 상품 종류에 따라 입력 불가능한 필드만 초기화
        if (isExclusiveWatched) {
          // 전용 상품 - 직접 입력 방식인 경우, 제조사, 제조사 모델번호는 입력 불가능한 정보이므로 필드 초기화
          createForm.resetFields(["maker", "makerSku"]);
        } else {
          // 범용 상품 - 직접 입력 방식인 경우, 디자인 요구사항, 기능 요구 사항은 입력 불가능한 정보이므로 필드 초기화
          createForm.resetFields(["designMemo", "functionMemo"]);
        }
        createForm.validateFields(isExclusiveSelectStepFieldNames).then(onNextStep).catch(onInvalidFieldsNotify);
      };
      break;
    case 1:
      saveButtonLabels = { cancel: "이전", save: "다음" };
      onCancel = onPrevStep;
      onSave = () => {
        if (byProductVariantWatched) {
          createByProductVariantForm
            .validateFields()
            .then(() => {
              onNextStep();
              onCloseModal();
            })
            .catch(onInvalidFieldsNotify);
        } else {
          createForm.validateFields(requestWriteStepFieldNames).then(onNextStep).catch(onInvalidFieldsNotify);
        }
      };
      break;
    case 2:
      saveButtonLabels = { cancel: byProductVariantWatched ? "다시 선택" : "이전", save: "등록" };
      onCancel = onPrevStep;
      onSave = () => {
        if (byProductVariantWatched) {
          createByProductVariantForm
            .validateFields()
            .then(() => {
              onCreateByProductVariant(createByProductVariantFormValues);
            })
            .catch(onInvalidFieldsNotify);
        } else {
          createForm
            .validateFields()
            .then(() => {
              onCreate(createFormValues);
            })
            .catch(onInvalidFieldsNotify);
        }
      };
      break;
    default:
      saveButtonLabels = {};
      onCancel = null;
      onSave = null;
      break;
  }

  return (
    <>
      <Form
        form={createForm}
        layout="vertical"
        name="hq-req-boss-product-create-form"
        initialValues={initialValues}
        onValuesChange={(changedValues) => {
          if ("isExclusive" in changedValues) {
            // 상품 종류가 전용 상품일 경우 요청 방식을 직접 입력으로 자동 설정. 그 외에는 null로 초기화
            if (changedValues.isExclusive === true) {
              createForm.setFieldValue("byProductVariant", false);
            } else {
              createForm.resetFields(["byProductVariant"]);
            }
          }
          setFormChanged(true);
        }}
      >
        <AppHeader onBack={onBack}>{sectionNames.hqReqBossProduct}</AppHeader>
        <PageHeader title="상품 요청 등록" />

        <Steps
          type="navigation"
          current={needsBrandSelection ? currentStep + 1 : currentStep}
          items={[
            ...(needsBrandSelection ? [{ title: "브랜드 선택" }] : []),
            { title: "상품 종류 선택" },
            { title: "요청 내용 작성" },
            { title: "상품 요청 등록" },
          ]}
        />
        {/* 브랜드 선택 스텝 (Staff만) */}
        {isBrandSelectStep && <BrandSelectionStep selectedBrand={selectedBrand} onBrandSelect={onBrandSelect} />}

        {/* NOTE: display가 아닌 렌더링 자체를 안 하면 antd의 Form에서 렌더링 되지 않은 Form.Item에 대한 필드 값도 제거되어버리므로 display: none 처리 */}
        <Card style={{ display: isExclusiveSelectStep && !isBrandSelectStep ? "block" : "none" }}>
          <Space direction="vertical" size="large">
            {makeIsExclusiveFormItem()}
            {makeByProductVariantFormItem(isExclusiveWatched)}
          </Space>
        </Card>
        <Card
          style={{ display: isRequestWriteStep ? "block" : "none" }}
          title={<CardTitleAntd title={requestWriteStepTitle} />}
        >
          {byProductVariantWatched ? (
            <ProductVariantListForReqTable {...reqByProductVariantProps} />
          ) : (
            makeDirectRequestFormItems(isExclusiveWatched)
          )}
        </Card>
        {isRequestCreateStep && (
          <Card title={<CardTitleAntd title="요청 내용 확인" />}>
            <BossProductRequestedInfo isCreateMode data={dataForInfo} dataImageList={dataImageListForInfo || []} />
          </Card>
        )}
      </Form>

      <HqReqBossProductCreateByVariantModal
        open={params.action === "create-by-product-variant"}
        productVariant={productVariants.find((pv) => pv.id === params.id)}
        TypeSafeForm={CreateByProductVariantTypeSafeForm}
        onSubmit={onSave}
        onClose={onCloseModal}
      />

      <AntdSaveButtonBar
        disabled={(isRequestWriteStep && byProductVariantWatched) || (isRequestCreateStep && !formChanged) || loading}
        state={confirmButtonState}
        labels={saveButtonLabels}
        onCancel={onCancel}
        onSave={onSave}
      />
    </>
  );
};
</file>

<file path="src/app/views/hqStaff/hqRequestProduct/components/HqReqFbvProductCreatePage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { RequestFbvProductCreateInput } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { vendorInfoSetFieldValue } from "@src/app/views/requestProduct/components/ReqFbvProductDetailsPage";
import ReqFbvProductForm, {
  IVendorForReq,
} from "@src/app/views/requestProduct/components/ReqFbvProductForm/ReqFbvProductForm";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Form, PageHeader } from "antd";
import React, { useState } from "react";

import { useRequestFbvProductCreateMutation } from "../api/mutations";
import { RequestFbvProductCreate } from "../api/types/RequestFbvProductCreate";
import { hqReqFbvProductListViewUrl } from "../urls";

interface HqReqFbvProductCreatePageProps {
  onBack: () => void;
  header: string;
}

interface CustomReqFbvProductCreateInput extends RequestFbvProductCreateInput {
  vendorName?: string;
  vendorBizRegNo?: string;
  vendorManagerName?: string;
  vendorManagerEmail?: string;
  vendorManagerPhone?: string;
}

const HqReqFbvProductCreatePage: React.FC<HqReqFbvProductCreatePageProps> = (props) => {
  const { user } = useUser();
  const { onBack, header } = props;
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [form] = Form.useForm<CustomReqFbvProductCreateInput>();
  const navigate = useNavigator();

  const brandId = user?.brand?.id;
  const isHqStaff = user.isHqStaff;

  const vendorList: IVendorForReq[] = user.brand.fbvVendors.map((vendor) => ({
    label: `${vendor.code}: ${vendor.name}`,
    value: `${vendor.code}: ${vendor.name}`,
    key: vendor.id,
    ...vendor,
  }));

  const [requestFbvProduct, requestFbvProductOpts] = useRequestFbvProductCreateMutation({
    onCompleted: (data: RequestFbvProductCreate) => {
      const errors = data.requestFbvProductCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("상품 등록 요청이 완료되었습니다.");
        navigate(hqReqFbvProductListViewUrl());
      } else {
        showNotificationError("상품 등록에 실패하였습니다.");
      }
    },
  });

  const onFinish = (values: RequestFbvProductCreateInput): void => {
    if (isHqStaff === false) {
      showNotificationWarn("직거래 상품 등록 요청은 가맹본부만 가능합니다.");
      return;
    }
    if (utils.isEmpty(brandId)) {
      showNotificationWarn("브랜드 정보가 없어 요청할 수 없습니다.");
      return;
    }
    if (utils.isEmpty(values.productName)) {
      showNotificationWarn("이용하시던 상품명을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.category)) {
      showNotificationWarn("상품의 카테고리를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.spec)) {
      showNotificationWarn("규격을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.qtyPerBox)) {
      showNotificationWarn("입수량을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.costPriceExcludeVat)) {
      showNotificationWarn("협력사 매입가를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.priceExcludeVat)) {
      showNotificationWarn("매장 매입가를 입력해주세요.");
      return;
    }
    if (utils.isEmpty(values.vendor)) {
      showNotificationWarn("협력사를 선택해주세요.");
      return;
    }
    if (utils.isEmpty(values.thumbnailImage)) {
      showNotificationWarn("상품 이미지를 업로드해주세요.");
      return;
    }

    requestFbvProduct({
      variables: {
        input: {
          vendor: values.vendor,
          brand: brandId,
          productName: values.productName,
          category: values.category,
          spec: values.spec,
          material: values.material,
          color: values.color,
          qtyPerBox: values.qtyPerBox,
          costPriceExcludeVat: values.costPriceExcludeVat,
          priceExcludeVat: values.priceExcludeVat,
          thumbnailImage: values.thumbnailImage[0].originFileObj,
        },
      },
    });
  };

  return (
    <>
      <Form form={form} layout="vertical" onValuesChange={() => setFormChanged(true)} onFinish={onFinish}>
        <AppHeader onBack={onBack}>{sectionNames.hqReqFbvProduct}</AppHeader>
        <PageHeader title={header} />

        <ReqFbvProductForm form={form} vendorList={vendorList} vendorInfoSetFieldValue={vendorInfoSetFieldValue} />
      </Form>
      <AntdSaveButtonBar
        onCancel={onBack}
        disabled={!formChanged || requestFbvProductOpts.loading}
        state={requestFbvProductOpts.status}
        onSave={form.submit}
      />
    </>
  );
};

export default HqReqFbvProductCreatePage;
</file>

<file path="src/app/views/hqStaff/hqRequestProduct/views/HqReqBossProductListView/filters.ts">
import { RequestBossProductFilterInput, RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
