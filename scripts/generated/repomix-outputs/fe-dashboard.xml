export function getFilterVariables(params: RiuMinusProfitBpvListViewUrlFilters): BrandProductVariantFilterInput {
  return {
    riuMinusProfit: true,
    isFulfilledByVendor: false,
    categoryKind: [CategoryKindEnum.STANDARD],
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, false) : undefined,
    productExclusive: params.productExclusive !== undefined ? parseBoolean(params.productExclusive, false) : undefined,
    brandIsRunning: params.brandIsRunning !== undefined ? parseBoolean(params.brandIsRunning, false) : undefined,
    pvSalesStatus: maybe(() => params.pvSalesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    productSearch: params.productSearch,
    brandProductSearch: params.brandProductSearch,
    brandSearch: params.brandSearch,
    vendorSearch: params.vendorSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<RiuMinusProfitBpvListFilterKeys>
): RiuMinusProfitBpvListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case RiuMinusProfitBpvListFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, RiuMinusProfitBpvListViewUrlFiltersEnum.trackInventory);
    case RiuMinusProfitBpvListFilterKeys.productExclusive:
      return getSingleValueQueryParam(filter, RiuMinusProfitBpvListViewUrlFiltersEnum.productExclusive);
    case RiuMinusProfitBpvListFilterKeys.brandIsRunning:
      return getSingleValueQueryParam(filter, RiuMinusProfitBpvListViewUrlFiltersEnum.brandIsRunning);
    case RiuMinusProfitBpvListFilterKeys.pvSalesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        RiuMinusProfitBpvListViewUrlFiltersWithMultipleValuesEnum.pvSalesStatus,
