import { commonMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { BrandStoreRoleEnum, StoreWorkerUpdateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps, EditableColumnsType, EditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import BrandStoreWorkerCreateModal from "@src/app/views/brand/brandStore/components/BrandStoreWorkerCreateModal";
import { brandStoreRoleChoicesWOOwner } from "@src/app/views/brand/brandStore/utils";
import { BrandAccountDetails_user_brandStoreUser_brandStore } from "@src/app/views/customer/customers/api/types/BrandAccountDetails";
import { checkIsEnableForLinkersServiceByUser, transformPhoneNumber } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Form, Table, Typography } from "antd";
import React, { useState } from "react";

import { useStoreWorkerUpdateMutation } from "../api/mutations";
import { BrandStoreDetails_brandStore, BrandStoreDetails_brandStore_storeUsers } from "../api/types/BrandStoreDetails";

interface BrandStoreSalesInfoProps {
  brandStore: BrandStoreDetails_brandStore | BrandAccountDetails_user_brandStoreUser_brandStore;
  readOnly?: boolean;
  onClickAccount: (brandStoreId: string) => void;
}

export const BrandStoreUsers: React.FC<BrandStoreSalesInfoProps> = (props) => {
  const { brandStore, onClickAccount, readOnly = false } = props;
  const { user } = useUser();
  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [form] = Form.useForm<StoreWorkerUpdateInput>();
  const TypeSafeForm = getTypeSafeForm<StoreWorkerUpdateInput>(form);
  const [selectedRowId, setSelectedRowId] = useState<string>("");

  const enableForLinkersService = checkIsEnableForLinkersServiceByUser(user);
  const isEditing = (record: BrandStoreDetails_brandStore_storeUsers) => record?.id === selectedRowId;
  const onEdit = (record: Partial<BrandStoreDetails_brandStore_storeUsers>) => {
    TypeSafeForm.setFields([
      {
        name: "firstName",
        value: record.user.firstName,
      },
      {
        name: "loginId",
        value: record.user.loginId,
      },
      {
        name: "brandStoreRole",
        value: record.role,
      },
      {
        name: "aligoPhone",
        value: transformPhoneNumber(record.user.aligoPhone),
      },
      {
        name: "email",
        value: record.user.email,
      },
    ]);
    setSelectedRowId(record?.id);
  };

  const [storeWorkerUpdate, storeWorkerUpdateOpts] = useStoreWorkerUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.storeWorkerUpdate.errors, commonMsg.savedChanges, () => {
        setSelectedRowId("");
      }),
  });

  const handleSubmit = async (formData: StoreWorkerUpdateInput) => {
    const userId = brandStore.storeUsers.find((user) => user.id === selectedRowId)?.user.id;
    if (utils.isEmpty(userId)) {
      showNotificationError("선택된 사용자가 없습니다. 새로고침 후 다시 선택하여 시도해주세요.");
    }

    await storeWorkerUpdate({ variables: { id: userId, input: formData } });
  };

  const onCancel = () => setSelectedRowId("");

  let columns: EditableColumnsType<BrandStoreDetails_brandStore_storeUsers> = [];

  const firstNameColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    title: "사용자명",
    key: "firstName",
    align: "center",
    width: 150,
    render: (_, record) => (
      <Typography.Link onClick={() => onClickAccount(record.user.id)}>{record.user.firstName}</Typography.Link>
    ),
    onCell: (record: BrandStoreDetails_brandStore_storeUsers) => ({
      inputType: "text",
      formItemName: TypeSafeForm.getValidDataIndex("firstName"),
      editing: isEditing(record),
    }),
  };

  const loginIdColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    title: "아이디",
    key: "loginId",
    align: "center",
    width: 150,
    render: (_, record) => record.user.loginId,
    onCell: (record: BrandStoreDetails_brandStore_storeUsers) => ({
      inputType: "text",
      formItemName: TypeSafeForm.getValidDataIndex("loginId"),
      editing: isEditing(record),
    }),
  };

  const roleColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    title: "권한",
    key: "role",
    align: "center",
    width: 100,
    render: (_, record) => utils.getLabelTextByValue(record.role, brandStoreRoleChoicesWOOwner),
    onCell: (record: BrandStoreDetails_brandStore_storeUsers) => ({
      inputType: "singleSelect",
      formItemName: TypeSafeForm.getValidDataIndex("brandStoreRole"),
      editing: isEditing(record),
      selectOptions: brandStoreRoleChoicesWOOwner,
      disabled: record.role === BrandStoreRoleEnum.OWNER || record.role === BrandStoreRoleEnum.EX_OWNER,
    }),
  };

  const phoneColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    title: "연락처",
    key: "phone",
    align: "center",
    width: 150,
    render: (_, record) => transformPhoneNumber(record.user.aligoPhone),
    onCell: (record: BrandStoreDetails_brandStore_storeUsers) => ({
      inputType: "text",
      formItemName: TypeSafeForm.getValidDataIndex("aligoPhone"),
      editing: isEditing(record),
    }),
  };

  const emailColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    title: "이메일",
    key: "email",
    align: "center",
    width: 150,
    render: (_, record) => record.user.email,
    onCell: (record: BrandStoreDetails_brandStore_storeUsers) => ({
      inputType: "text",
      formItemName: TypeSafeForm.getValidDataIndex("email"),
      editing: isEditing(record),
    }),
  };

  const actionColumn: EditableColumnType<BrandStoreDetails_brandStore_storeUsers> = {
    key: "action",
    align: "center",
    width: 80,
    render: (_, record) => {
      const editable = isEditing(record);
      return (
        <FormSaveButton
          form={form}
          loading={storeWorkerUpdateOpts.loading}
          isEditMode={editable}
          onEdit={() => onEdit(record)}
          onCancel={onCancel}
        />
      );
    },
  };
  columns = [firstNameColumn, loginIdColumn, roleColumn, phoneColumn, emailColumn, !readOnly && actionColumn].filter(
    Boolean
  );

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <Card
        title={<CardTitleAntd title={"매장 사용자"} />}
        extra={
          !readOnly && enableForLinkersService ? (
            <Button type="primary" onClick={() => setIsCreateModalOpen(true)}>
              + 추가
            </Button>
          ) : undefined
        }
        bodyStyle={{ padding: 0 }}
      >
        <Form form={form} component={false} onFinish={handleSubmit}>
          <Table<BrandStoreDetails_brandStore_storeUsers>
            {...commonTableProps}
            columns={columns}
            dataSource={brandStore.storeUsers}
            components={{ body: { cell: EditableCell } }}
            scroll={{ x: tableWidthSum }}
          />
        </Form>
      </Card>
      {!readOnly && (
        <BrandStoreWorkerCreateModal
          open={isCreateModalOpen}
          onClose={() => setIsCreateModalOpen(false)}
          brandStore={brandStore}
        />
      )}
    </>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BrandStoreWorkerCreateModal.tsx">
import { QuestionCircleOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import useBrandStoreSearch from "@src/api/searches/useBrandStoreSearch";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { StoreWorkerCreateVariables } from "@src/app/views/brand/brandStore/api/types/StoreWorkerCreate";
import { brandStoreRoleChoicesWOOwner } from "@src/app/views/brand/brandStore/utils";
import { customerListQuery } from "@src/app/views/customer/customers/api/queries";
import { BrandAccountDetails_user_brandStoreUser_brandStore } from "@src/app/views/customer/customers/api/types/BrandAccountDetails";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Col, Form, Input, Modal, Radio, Row, Select, Tooltip } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect, useState } from "react";

import { useStoreWorkerCreateMutation } from "../api/mutations";
import { BrandStoreDetails_brandStore } from "../api/types/BrandStoreDetails";

interface BrandStoreWorkerCreateModalProps {
  open: boolean;
  onClose: () => void;
  brandStore?: BrandStoreDetails_brandStore | BrandAccountDetails_user_brandStoreUser_brandStore;
  brandId?: string;
}

const BrandStoreWorkerCreateModal: React.FC<BrandStoreWorkerCreateModalProps> = ({
  open,
  onClose,
  brandStore,
  brandId,
}) => {
  const [form] = useForm();
  const TypeSafeForm = getTypeSafeForm<StoreWorkerCreateVariables>(form);
  const [useCustomPassword, setUseCustomPassword] = useState(false);

  const [searchedBrands, setSearchedBrands] = useState([]);
  const [searchedBrandStores, setSearchedBrandStores] = useState([]);
  const formBrandId = TypeSafeForm.getUseFormWatched({ name: "input.brand" });

  const brandSearchVariable: SearchBrandsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.brandStoresForSeach,
    ids: brandId ? [brandId] : undefined,
  };

  const { loadMore, search, result } = useBrandSearch({
    skip: !!brandStore,
    variables: brandSearchVariable,
  });

  const fetchMoreData = {
    hasMore: maybe(() => result.data.search.pageInfo.hasNextPage),
    loading: result.loading,
    onFetchMore: loadMore,
  };

  useEffect(() => {
    setSearchedBrands(
      result.data?.search?.edges.map((edge) => ({
        label: edge.node.name,
        value: edge.node.id,
      }))
    );
  }, [result?.data?.search?.edges]);

  const {
    loadMore: brandStoresLoadMore,
    result: brandStores,
    search: searchBrandStores,
  } = useBrandStoreSearch({
    skip: utils.isEmpty(formBrandId) && !brandId,
    variables: {
      first: 5,
      brandId: brandId ? brandId : formBrandId,
    },
  });

  const fetchMoreDataForBrandStores = {
    hasMore: maybe(() => brandStores.data.search.pageInfo.hasNextPage),
    loading: brandStores.loading,
    onFetchMore: brandStoresLoadMore,
  };

  useEffect(() => {
    setSearchedBrandStores(
      brandStores.data?.search?.edges.map((edge) => ({
        label: `${edge.node.name}(${edge.node.code})`,
        value: edge.node.id,
      }))
    );
  }, [brandStores?.data?.search?.edges]);

  const [storeWorkerCreate, storeWorkerCreateOpts] = useStoreWorkerCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.storeWorkerCreate.errors,
        "매장 사용자가 성공적으로 생성되었습니다.",
        () => {
          onClose();
          form.resetFields();
          setUseCustomPassword(false);
        }
      ),
    refetchQueries: [customerListQuery],
  });

  const handleSubmit = async (values: StoreWorkerCreateVariables) => {
    const input = {
      ...values.input,
      password: useCustomPassword ? values.input.password : undefined,
    };
    await storeWorkerCreate({ variables: { input } });
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
      setUseCustomPassword(false);
    }
  }, [open]);

  return (
    <Modal
      maskClosable={false}
      open={open}
      onCancel={onClose}
      confirmLoading={storeWorkerCreateOpts.loading}
      onOk={() => form.submit()}
      okText="추가"
      cancelText="취소"
      title="사용자(매장) 생성"
      destroyOnClose
    >
      <Form layout="vertical" form={form} onFinish={handleSubmit}>
        <Row gutter={16}>
          <Col span={24}>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("input.brand")}
              label="브랜드"
              rules={[{ required: !(!!brandStore || !!brandId), message: "브랜드는 필수입니다." }]}
              hidden={!!brandStore || !!brandId}
              initialValue={brandId}
            >
              <Select
                showSearch
                filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                onSearch={search}
                loading={fetchMoreData.loading}
                options={searchedBrands}
                onPopupScroll={fetchMoreData.onFetchMore}
              />
            </Form.Item>
          </Col>
          <Col span={24}>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("input.brandStore")}
              label="매장"
              rules={[{ required: !brandStore, message: "매장은 필수입니다." }]}
              hidden={!!brandStore}
              initialValue={brandStore?.id}
            >
              <Select
                showSearch
                filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                onSearch={searchBrandStores}
                loading={fetchMoreDataForBrandStores.loading}
                options={searchedBrandStores}
                onPopupScroll={fetchMoreDataForBrandStores.onFetchMore}
              />
            </Form.Item>
          </Col>
        </Row>

        <Row gutter={16}>
          <Col span={12}>
            <Form.Item
              label="사용자 아이디"
              name={TypeSafeForm.getValidDataIndex("input.loginId")}
              rules={[{ required: true, message: "아이디는 필수입니다." }]}
            >
              <Input />
            </Form.Item>
          </Col>

          <Col span={12}>
            <div style={{ marginBottom: 8, display: "flex", alignItems: "center", gap: 8 }}>
              <span>비밀번호 직접 설정</span>
              <Tooltip title="직접 설정이 아닌 경우, 브랜드 코드로 자동 설정됩니다.">
                <QuestionCircleOutlined style={{ color: "#999" }} />
              </Tooltip>
            </div>
            <Radio.Group value={useCustomPassword} onChange={(e) => setUseCustomPassword(e.target.value)}>
              <Radio value={true}>네</Radio>
              <Radio value={false}>아니오</Radio>
            </Radio.Group>
          </Col>
        </Row>

        {useCustomPassword && (
          <Form.Item
            label="비밀번호"
            name={TypeSafeForm.getValidDataIndex("input.password")}
            rules={[{ required: true, message: "비밀번호는 필수입니다." }]}
          >
            <Input.Password autoComplete="new-password" />
          </Form.Item>
        )}

        <Form.Item
          label="사용자 이름"
          name={TypeSafeForm.getValidDataIndex("input.firstName")}
          rules={[{ required: true, message: "이름은 필수입니다." }]}
        >
          <Input />
        </Form.Item>

        <Form.Item
          label="권한"
          name={TypeSafeForm.getValidDataIndex("input.brandStoreRole")}
          rules={[{ required: true, message: "권한은 필수입니다." }]}
        >
          <Select options={brandStoreRoleChoicesWOOwner} />
        </Form.Item>

        <Form.Item
          label="연락처"
          name={TypeSafeForm.getValidDataIndex("input.aligoPhone")}
          rules={[{ required: true, message: "연락처는 필수입니다." }]}
        >
          <Input />
        </Form.Item>

        <Form.Item
          label="이메일"
          name={TypeSafeForm.getValidDataIndex("input.email")}
          rules={[{ type: "email", message: "이메일 형식이 아닙니다." }]}
        >
          <Input />
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default BrandStoreWorkerCreateModal;
</file>

