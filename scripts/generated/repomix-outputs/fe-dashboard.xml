import { Statistic } from "antd";
import React from "react";

import { BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node } from "../../api/types/BrandReverseFeeDepositEvents";

const transformEventType = (eventType: BrandReverseFeeDepositEventEventType) => {
  switch (eventType) {
    case BrandReverseFeeDepositEventEventType.INCREASE:
      return "입금";
    case BrandReverseFeeDepositEventEventType.REFUND:
    case BrandReverseFeeDepositEventEventType.CANCEL_ORDER:
      return "반품";
    case BrandReverseFeeDepositEventEventType.ORDER:
      return "주문";
    case BrandReverseFeeDepositEventEventType.INCREASE_BY_ADMIN:
    case BrandReverseFeeDepositEventEventType.DECREASE_BY_ADMIN:
      return "외상 조정";
    case BrandReverseFeeDepositEventEventType.INCREASE_BY_RCOINS:
      return "포인트 사용";
    case BrandReverseFeeDepositEventEventType.DECREASE_BY_RCOINS:
      return "포인트 환불";
    default:
      break;
  }
};

interface BrandReverseFeeTableSettingsProps {
  user: User;
}

export function getReverseFeeTableSettings(props: BrandReverseFeeTableSettingsProps) {
  const { user } = props;
  const isStaff = checkStaff(user);
  const createdColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> = {
    title: "일시",
    align: "center",
    key: "created",
    width: 120,
    render: (_, record) => (maybe(() => record.created) ? <DateTime date={record.created} /> : <Skeleton />),
    renderExcel: (record) => getDateByFormat(record.created),
  };
  const brandCodeColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "brandCode",
      width: 80,
      align: "center",
      render: (_, record) => (record.brand?.code ? record.brand?.code : "-"),
    };

  const brandNameColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "brandName",
      width: 120,
      align: "center",
      render: (_, record) => (record.brand?.name ? record.brand?.name : "-"),
    };
  const eventTypeColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "구분",
      align: "center",
      key: "eventType",
      width: 80,
      render: (_, record) => maybe<React.ReactNode>(() => transformEventType(record.eventType), <Skeleton />),
    };
  const qtyAsOrderColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "공급가액",
      align: "right",
      key: "qtyAsOrder",
      width: 60,
      render: (_, record) =>
        record.eventType === BrandReverseFeeDepositEventEventType.ORDER ? (
          <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={record.qty} />
        ) : (
          "-"
        ),
      renderExcel: (record) => (record.eventType === BrandReverseFeeDepositEventEventType.ORDER ? record.qty : "-"),
    };

  const qtyAsRefundColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "반품 금액",
      align: "right",
      key: "qtyAsRefund",
      width: 60,
      render: (_, record) =>
        [BrandReverseFeeDepositEventEventType.REFUND, BrandReverseFeeDepositEventEventType.CANCEL_ORDER].includes(
          record.eventType
        ) ? (
          <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={record.qty} />
        ) : (
          "-"
        ),
      renderExcel: (record) =>
        [BrandReverseFeeDepositEventEventType.REFUND, BrandReverseFeeDepositEventEventType.CANCEL_ORDER].includes(
          record.eventType
        )
          ? record.qty
          : "-",
    };

  const qtyAsIncreaseColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "입금액",
      align: "right",
      key: "qtyAsIncrease",
      width: 60,
      render: (_, record) =>
        record.eventType === BrandReverseFeeDepositEventEventType.INCREASE ? (
          <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={record.qty} />
        ) : (
          "-"
        ),
      renderExcel: (record) => (record.eventType === BrandReverseFeeDepositEventEventType.INCREASE ? record.qty : "-"),
    };
  const qtyAsByAdminColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "외상조정",
      align: "right",
      key: "qtyAsByAdmin",
      width: 60,
      render: (_, record) =>
        [
          BrandReverseFeeDepositEventEventType.INCREASE_BY_ADMIN,
          BrandReverseFeeDepositEventEventType.DECREASE_BY_ADMIN,
          BrandReverseFeeDepositEventEventType.INCREASE_BY_RCOINS,
          BrandReverseFeeDepositEventEventType.DECREASE_BY_RCOINS,
        ].includes(record.eventType) ? (
          <Statistic
            className={getStatisticClassName(["ant-statistic-small"])}
            value={record.qty}
            prefix={
              [
                BrandReverseFeeDepositEventEventType.INCREASE_BY_ADMIN,
                BrandReverseFeeDepositEventEventType.INCREASE_BY_RCOINS,
              ].includes(record.eventType)
