  const requiredPermissions = isHqStaff ? [] : [PermissionEnum.VIEW_STAFF];
  const userPermissions = (user?.userPermissions || []).map((perm) => perm.code);
  const hasPermissions = checkHasAnyPermissions(requiredPermissions, userPermissions);

  if (!hasPermissions) {
    return <NotFound type={ErrorPageEnum.PermissionDenied} />;
