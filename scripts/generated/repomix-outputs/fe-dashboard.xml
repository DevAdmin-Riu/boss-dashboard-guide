        }
      />

      <Grid>
        <Space direction="vertical" size="large">
          <Form
            name="collection-basic-info"
            layout="vertical"
            form={basicInfoForm}
            disabled={disabled || (isEditing && editMode !== CollectionDetailsEditModeEnum.UpdateBasicInfo)}
            initialValues={basicInfoInitialValues}
            onFinish={onBasicInfoUpdate}
          >
            <CollectionDetails
              isCreate={false}
              form={basicInfoForm}
              collection={collection}
              editModeProps={{
                isEditMode: editMode === CollectionDetailsEditModeEnum.UpdateBasicInfo,
                onEdit: () => onEdit(CollectionDetailsEditModeEnum.UpdateBasicInfo),
                onCancel: onEditCancel,
              }}
            />
          </Form>
          <CollectionProducts disabled={disabled} collection={collection} {...collectionProductsProps} />
        </Space>
        <Space direction="vertical" size="large">
          <Form
            name="collection-visibility"
            layout="vertical"
            form={visibilityForm}
            disabled={disabled || (isEditing && editMode !== CollectionDetailsEditModeEnum.UpdateVisibility)}
            initialValues={visibilityInitialValues}
            onFinish={onVisibilityUpdate}
          >
            <VisibilityCard
              isCreate={false}
              form={visibilityForm}
              initialValues={visibilityInitialValues}
              editModeProps={{
                isEditMode: editMode === CollectionDetailsEditModeEnum.UpdateVisibility,
                onEdit: () => onEdit(CollectionDetailsEditModeEnum.UpdateVisibility),
                onCancel: onEditCancel,
              }}
            >
              <EditableField
                type="checkbox"
                name={VisibilityTypeSafeForm.getValidDataIndex("isFeatured")}
                label={collectionMsg.featured}
                value={isFeatured}
                editMode={editMode === CollectionDetailsEditModeEnum.UpdateVisibility}
                renderValue={(value) => (value ? "설정됨" : "미설정")}
              />
            </VisibilityCard>
          </Form>
        </Space>
      </Grid>
    </>
  );
};
export default CollectionDetailsPage;
