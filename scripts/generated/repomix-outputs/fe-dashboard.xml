<file path="src/app/views/product/stock/components/StockListPage/filters.ts">
import { commonMsg } from "@assets/messages/commonMsg";
import { CategoryKindEnum, PriorityLevelEnum, SalesStatusEnum, StockAvailability } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { categoryKindChoices } from "../../../categories/utils";
import { getSalesStatusChoices, priorityLevelChoices } from "../../../products/utils/data";

export enum StockFilterKeys {
  brandSearch = "brandSearch",
  salesStatus = "salesStatus",
  priorityLevel = "priorityLevel",
  stockAvailability = "stockAvailability",
  isSalesSurge = "isSalesSurge",
  trackInventory = "trackInventory",
  allowAutoConsignment = "allowAutoConsignment",
  isInner = "isInner",
  productSearch = "productSearch",
  brandProductSearch = "brandProductSearch",
  externalProductSearch = "externalProductSearch",
  vendorSearch = "vendorSearch",
  needToStockExists = "needToStockExists",
  needToStockDate = "needToStockDate",
  categoryKind = "categoryKind",
  isSubPv = "isSubPv",
}

export interface StockFilterOpts {
  brandSearch: FilterOpts<string>;
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  priorityLevel: FilterOpts<PriorityLevelEnum[]>;
  stockAvailability: FilterOpts<StockAvailability>;
  isSalesSurge: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  allowAutoConsignment: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  externalProductSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  needToStockExists: FilterOpts<boolean>;
  needToStockDate: FilterOpts<MinMax>;
  categoryKind: FilterOpts<CategoryKindEnum[]>;
  isSubPv: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: StockFilterOpts,
  isFbv: boolean,
  isHqStaffFbvMode: boolean,
  isVendorStaffFbvMode: boolean
): IFilter<StockFilterKeys> {
  let displayOrder = 0;

  const salesStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      StockFilterKeys.salesStatus,
      "제품상태",
      opts.salesStatus.value,
      true,
      getSalesStatusChoices(false, false)
    ),
    active: opts.salesStatus.active,
    isRequired: true,
  };
  const priorityLevelFilter = {
    ...createOptionsField(
      displayOrder++,
      StockFilterKeys.priorityLevel,
      "중요도",
      opts.priorityLevel.value,
      true,
      priorityLevelChoices
    ),
    active: opts.priorityLevel.active,
  };

  const stockAvailabilityFilter = {
    ...createOptionsField(
      displayOrder++,
      StockFilterKeys.stockAvailability,
      isHqStaffFbvMode ? "상품상태" : "재고상태",
      [opts.stockAvailability.value],
      false,
      [
        {
          label: "재고 안전",
          value: StockAvailability.IN_OF_SAFETY_STOCK,
        },
        {
          label: "재고 위험",
          value: StockAvailability.OUT_OF_SAFETY_STOCK,
        },
        {
          label: "발주 안전",
          value: StockAvailability.IN_OF_ROP,
        },
        {
          label: "발주 필요",
          value: StockAvailability.OUT_OF_ROP,
        },
        // NOTE: 가용 재고 0 -> (가용 재고 - 안전재고) 값이 작은 것 순 -> 단종 -> 위탁 순으로 기본 정렬되고 있기 때문에 소진된 정도 순서 확인 가능하므로 필터 UI에서 제외
        {
          label: "재고 소진",
          value: StockAvailability.OUT_OF_STOCK,
        },
      ]
    ),
    active: opts.stockAvailability.active,
  };
  const isSalesSurgeFilter = {
    ...createBooleanField(displayOrder++, StockFilterKeys.isSalesSurge, "소진 임박 여부", opts.isSalesSurge.value, {
      negative: commonMsg.no,
      positive: commonMsg.yes,
    }),
    active: opts.isSalesSurge.active,
  };
  const brandSearchFilter = {
    ...createTextField(displayOrder++, StockFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };
  const externalProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      StockFilterKeys.externalProductSearch,
      "협력사 상품 ID / 협력사 상품명",
      opts.externalProductSearch.value
    ),
    active: opts.externalProductSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      StockFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      StockFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const trackInventoryFilter = {
    ...createBooleanField(
      displayOrder++,
      StockFilterKeys.trackInventory,
      columnNameConstant.product.TRACK_INVENTORY,
      opts.trackInventory.value,
      {
        negative: "미운영",
        positive: "운영",
      }
    ),
    active: opts.trackInventory.active,
  };
  const allowAutoConsignmentFilter = {
    ...createBooleanField(
      displayOrder++,
      StockFilterKeys.allowAutoConsignment,
      "자동위탁허용",
      opts.allowAutoConsignment.value,
      {
        negative: "비허용",
        positive: "허용",
      }
    ),
    active: opts.allowAutoConsignment.active,
  };
  const isInnerFilter = {
    ...createBooleanField(displayOrder++, StockFilterKeys.isInner, "제품형태", opts.isInner.value, {
      negative: "아우터박스",
      positive: "이너박스",
    }),
    active: opts.isInner.active,
  };
  const vendorSearchFilter = {
    ...createTextField(displayOrder++, StockFilterKeys.vendorSearch, "협력사코드 / 협력사명", opts.vendorSearch.value),
    active: opts.vendorSearch.active,
  };
  const needToStockExistsFilter = {
    ...createBooleanField(
      displayOrder++,
      StockFilterKeys.needToStockExists,
      "입고대기상태",
      opts.needToStockExists.value,
      {
        negative: "없음",
        positive: "입고대기중",
      }
    ),
    active: opts.needToStockExists.active,
  };

  const needToStockDateFilter = {
    ...createDateField(displayOrder++, StockFilterKeys.needToStockDate, "입고예정일", opts.needToStockDate.value),
    active: opts.needToStockDate.active,
  };

  const categoryKindFilter = {
    ...createOptionsField(
      displayOrder++,
      StockFilterKeys.categoryKind,
      "제품구분",
      opts.categoryKind.value,
      true,
      categoryKindChoices.filter((c) => c.value === CategoryKindEnum.STANDARD || c.value === CategoryKindEnum.B2B)
    ),
    active: opts.categoryKind.active,
  };

  const isSubPvFilter = {
    ...createBooleanField(displayOrder++, StockFilterKeys.isSubPv, "포장 부자재 여부", opts.isSubPv.value, {
      negative: "X",
      positive: "O",
    }),
    active: opts.isSubPv.active,
  };

  if (isFbv) {
    return utils.filterDisplayOrdering(
      [
        salesStatusFilter,
        categoryKindFilter,
        isSubPvFilter,
        isSalesSurgeFilter,
        isHqStaffFbvMode === false && brandSearchFilter,
        isHqStaffFbvMode === false && isVendorStaffFbvMode === false && productSearchFilter,
        brandProductSearchFilter,
        isVendorStaffFbvMode && externalProductSearchFilter,
        trackInventoryFilter,
        isVendorStaffFbvMode === false && vendorSearchFilter,
      ].filter(Boolean)
    );
  } else {
    return utils.filterDisplayOrdering([
      salesStatusFilter,
      categoryKindFilter,
      isSubPvFilter,
      priorityLevelFilter,
      stockAvailabilityFilter,
      isSalesSurgeFilter,
      brandSearchFilter,
      productSearchFilter,
      trackInventoryFilter,
      allowAutoConsignmentFilter,
      isInnerFilter,
      vendorSearchFilter,
      needToStockExistsFilter,
      needToStockDateFilter,
    ]);
  }
}
</file>

