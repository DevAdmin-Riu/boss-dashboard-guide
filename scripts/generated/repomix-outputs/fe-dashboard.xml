<file path="src/global/core/utils/bundle/bundleUtils.ts">
/**
 * 세트상품(Bundle) 관련 유틸리티 함수
 *
 * 세트상품 계산 로직이 order, brand 등 여러 도메인에서 사용되므로 global utils에 배치
 */

import { toPriceExcludeVat } from "@utils/excel/excelDownload";

/**
 * 세트상품 여부 확인
 * bundleOtherSales 배열이 존재하고 1개 이상의 항목이 있으면 세트상품
 */
export const checkIsBundleProduct = <T>(bundleOtherSales: T[] | null | undefined): boolean =>
  bundleOtherSales != null && bundleOtherSales.length > 0;

/**
 * 단일 구성품의 공급원가 계산
 * 공급원가 = 협력사 매입가 (VAT 제외) + 판매 택배비 (VAT 제외)
 */
export const calcSupplyCost = (costPriceExcludeVat: number | null, deliveryFeeAmount: number | null): number => {
  const costPrice = costPriceExcludeVat ?? 0;
  const deliveryFee = toPriceExcludeVat(deliveryFeeAmount ?? 0) ?? 0;
  return costPrice + deliveryFee;
};

/**
 * 구성품 목록의 공급원가 합계 (수량 곱함)
 *
 * @param components 구성품 배열 - quantity, pv.costPriceExcludeVat, pv.deliveryFeeAmount 필요
 */
export const calcBundleComponentsSupplyCostTotal = <
  T extends {
    quantity: number;
    pv: {
      costPriceExcludeVat: number | null;
      deliveryFeeAmount: number | null;
    };
  }
>(
  components: T[]
): number =>
  components.reduce((acc, component) => {
    const costPriceExcludeVat = component.pv.costPriceExcludeVat ?? 0;
    const deliveryFeeExcludeVat = toPriceExcludeVat(component.pv.deliveryFeeAmount ?? 0) ?? 0;
    const supplyCost = costPriceExcludeVat + deliveryFeeExcludeVat;
    return acc + component.quantity * supplyCost;
  }, 0);

// ============================================================
// bundleOtherSales 관련 합계 함수들
// ============================================================

/**
 * bundleOtherSales 타입 정의 (최소 필요 필드)
 */
interface BundleOtherSaleForCostPrice {
  unitCostPriceExcludeVat: number | null;
  quantity: number;
  isTaxFree?: boolean;
  variant?: {
    trackInventory: boolean;
    costPriceExcludeVat: number | null;
    consignmentCostPriceExcludeVat: number | null;
  } | null;
}

interface BundleOtherSaleForDeliveryFee {
  unitDeliveryFee: number;
  quantity: number;
}

interface BundleOtherSaleForPrice {
  unitPrice: number | null;
}

/**
 * bundleOtherSales의 협력사 매입가 (입고 시) 합계
 */
export const calcBundleOtherUnitCostPriceTotal = (
  bundleOtherSales: Array<BundleOtherSaleForCostPrice | null> | null | undefined
): number => {
  if (!checkIsBundleProduct(bundleOtherSales)) {
    return 0;
  }
  return bundleOtherSales!
    .filter((sale): sale is BundleOtherSaleForCostPrice => sale != null && sale.unitCostPriceExcludeVat != null)
    .reduce((sum, sale) => sum + (sale.unitCostPriceExcludeVat || 0), 0);
};

/**
 * bundleOtherSales의 협력사 매입가 (현재) 합계
 * variant의 현재 costPriceExcludeVat 사용, 수량 곱함
 */
export const calcBundleOtherCurrentCostPriceTotal = (
  bundleOtherSales: Array<BundleOtherSaleForCostPrice | null> | null | undefined
): number => {
  if (!checkIsBundleProduct(bundleOtherSales)) {
    return 0;
  }
  return bundleOtherSales!
    .filter((sale): sale is BundleOtherSaleForCostPrice => sale != null && sale.variant != null)
    .reduce((sum, sale) => {
      const variantCostPrice = (sale.variant?.costPriceExcludeVat ?? 0) * (sale.quantity || 0);
      return sum + variantCostPrice;
    }, 0);
};

/**
 * bundleOtherSales의 판매 택배비 합계
 * unitDeliveryFee * quantity, VAT 제외
 */
export const calcBundleOtherDeliveryFeeTotal = (
  bundleOtherSales: Array<BundleOtherSaleForDeliveryFee | null> | null | undefined
): number => {
  if (!checkIsBundleProduct(bundleOtherSales)) {
    return 0;
  }
  return bundleOtherSales!
    .filter((sale): sale is BundleOtherSaleForDeliveryFee => sale != null)
    .reduce((sum, sale) => sum + toPriceExcludeVat((sale.unitDeliveryFee || 0) * sale.quantity), 0);
};

/**
 * bundleOtherSales의 판매가 합계 (구성품 제품 가격 총 합)
 */
export const calcBundleOtherUnitPriceTotal = (
  bundleOtherSales: Array<BundleOtherSaleForPrice | null> | null | undefined,
  isTaxFree: boolean = false
): number => {
  if (!checkIsBundleProduct(bundleOtherSales)) {
    return 0;
  }
  return bundleOtherSales!
    .filter((sale): sale is BundleOtherSaleForPrice => sale != null && sale.unitPrice != null)
    .reduce((sum, sale) => sum + toPriceExcludeVat(sale.unitPrice || 0, isTaxFree), 0);
};
</file>

