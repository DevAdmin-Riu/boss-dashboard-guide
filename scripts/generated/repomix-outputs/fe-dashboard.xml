import React, { useEffect, useState } from "react";

import logoImg from "../../../global/assets/images/512x512.png";
import { getRowClassName } from "../antd/Row/RowProps";

const appInstallBannerExposeKey = "APP_INSTALL_BANNER_EXPOSE";

const MobileAppInstallHeader: React.FC = () => {
  const navigate = useNavigator();
  const [bannerExpose, setBannerExpose] = useState<boolean>(false);
  const isMobile = utils.checkMobile();
  const isMobileApp = utils.checkWebView();
  const appInstallBannerAvailable = isMobile && !isMobileApp;

  useEffect(() => {
    const bannerExposeDisabled = sessionStorage.getItem(appInstallBannerExposeKey) === "OFF";
    if (!bannerExposeDisabled) {
      setBannerExpose(true);
    }
  }, []);

  const handleBannerClose = () => {
    sessionStorage.setItem(appInstallBannerExposeKey, "OFF");
