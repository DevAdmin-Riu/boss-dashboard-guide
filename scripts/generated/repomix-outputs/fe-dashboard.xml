}

const StaffListPage: React.FC<StaffListPageProps> = (props) => {
  const {
    staffMembers,
    currencySymbol,
    currentTab,
    filterOpts,
    tabs,
    sort,
    onAdd,
    onAll,
    onBack,
    onRowClick,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns: ColumnsType<StaffList_staffUsers_edges_node> = [
    {
      title: "이름",
      key: "firstName",
      align: "center",
      width: 150,
      render: (_, record) =>
        !!onRowClick ? (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.firstName || "-"}</Typography.Link>
