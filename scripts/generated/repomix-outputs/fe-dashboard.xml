import useSearchQuery from "@hooks/useSearchQuery";
import { SearchStaffMembers_search_edges_node } from "@src/api/searches/types/SearchStaffMembers";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { commonMsg, permissionMsg } from "@src/global/assets/messages/commonMsg";
import { DialogProps, FetchMoreProps, SearchPageProps } from "@src/global/core/types/types";
import { getDisplayUserName } from "@utils/misc";
import { Avatar, Input, Modal, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

export interface AssignMembersDialogProps extends DialogProps, FetchMoreProps, SearchPageProps {
  staffMembers: SearchStaffMembers_search_edges_node[];
  hasMore: boolean;
  onFetchMore: () => void;
  onSubmit: (data: SearchStaffMembers_search_edges_node[]) => void;
}

const AssignMembersDialog: React.FC<AssignMembersDialogProps> = ({
  open,
  loading,
  staffMembers,
  hasMore,
  onFetchMore,
  onSearchChange,
  onSubmit,
  onClose,
}) => {
  const [query, onQueryChange] = useSearchQuery(onSearchChange);
  const [selectedMembers, setSelectedMembers] = React.useState<SearchStaffMembers_search_edges_node[]>([]);

  const columns: ColumnsType<SearchStaffMembers_search_edges_node> = [
    {
      title: "이름",
      key: "name",
      align: "left",
      width: 150,
      render: (_, record) => (
        <Space>
          <Avatar size={40} src={record.avatar?.url}>
            {record.firstName}
          </Avatar>
          <Space direction="vertical" size={0}>
            {getDisplayUserName(record)}
            <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
              {!record ? "-" : record.isActive ? commonMsg.active : commonMsg.inactive}
            </Typography.Text>
          </Space>
        </Space>
      ),
    },
    {
      title: "이메일",
      key: "email",
      align: "center",
      width: 200,
      render: (_, record) => record.email || "-",
    },
  ];

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title="관리자 연동"
      okText={buttonText.assign}
      onOk={() => onSubmit(selectedMembers)}
      okButtonProps={{ loading }}
      onCancel={onClose}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Input.Search
          loading={loading}
          value={query}
          onChange={onQueryChange}
          placeholder={permissionMsg.searchStaffPlaceholder}
        />
        <Table
          {...commonTableProps}
          loading={loading}
          columns={columns}
          dataSource={staffMembers}
          rowSelection={{
            fixed: true,
            type: "checkbox",
            selectedRowKeys: selectedMembers.map((member) => member.id),
            onChange: (_selectedRowKeys, selectedRows) => setSelectedMembers(selectedRows),
          }}
          scroll={{ y: 400 }}
          footer={
            hasMore &&
            (() => (
              <Row justify="center">
                <Typography.Link onClick={onFetchMore}>더 보기</Typography.Link>
              </Row>
            ))
          }
        />
      </Space>
    </Modal>
  );
};
export default AssignMembersDialog;
