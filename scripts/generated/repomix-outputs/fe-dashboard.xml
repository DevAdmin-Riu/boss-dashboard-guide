import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { parseBoolean } from "@utils/misc";
import { asSortParams } from "@utils/sort";
import { getArrayQueryParam } from "@utils/urls";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  FbvBrandProductVariantListViewUrlQueryParams,
  FbvBrandProductVariantListViewUrlSortField,
  fbvProductUpdateViewPath,
  productCreateViewPath,
  ProductCreateViewUrlQueryParams,
  productImageViewPath,
  ProductImageViewUrlQueryParams,
  productListViewPathA,
  productListViewPathB,
  ProductListViewUrlQueryParams,
  ProductListViewUrlSortField,
  productUpdateViewPath,
  ProductUpdateViewUrlQueryParams,
  productVariantCreateViewPath,
  productVariantManageEventListViewPath,
  ProductVariantManageEventListViewUrlQueryParams,
  productVariantUpdateViewPath,
  ProductVariantUpdateViewUrlQueryParams,
} from "./urls";
import { getProductVariantManageEventListDefaultParams } from "./utils";
import { FbvProductListView } from "./views/FbvProductListView/FbvProductListView";
import { ProductCreateView } from "./views/ProductCreateView";
import { ProductImageView } from "./views/ProductImageView";
import { ProductListView } from "./views/ProductListView/ProductListView";
import { ProductUpdateView } from "./views/ProductUpdateView/ProductUpdateView";
import { ProductVariantCreateView } from "./views/ProductVariantCreateView";
import { ProductVariantManageEventListView } from "./views/ProductVariantManageEventListView/ProductVariantManageEventListView";
import { ProductVariantUpdateView } from "./views/ProductVariantUpdateView";

const ProductListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: ProductListViewUrlQueryParams = asSortParams(
    {
      ...qs,
      // @ts-ignore
      salesStatus: getArrayQueryParam(qs.salesStatus),
      // @ts-ignore
      categories: getArrayQueryParam(qs.categories),
      // @ts-ignore
      collections: getArrayQueryParam(qs.collections),
      // @ts-ignore
      ids: getArrayQueryParam(qs.ids),
      // @ts-ignore
      productTypes: getArrayQueryParam(qs.productTypes),
    },
    ProductListViewUrlSortField,
    ProductListViewUrlSortField.sku,
    false
  );

  return <ProductListView params={params} />;
};

const FbvBrandProductVariantViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: FbvBrandProductVariantListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    FbvBrandProductVariantListViewUrlSortField,
    FbvBrandProductVariantListViewUrlSortField.sku,
    false
  );

  return <FbvProductListView params={params} />;
};

const ProductCreateViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ProductCreateViewUrlQueryParams = {
    ...qs,
    isFulfilledByVendor: parseBoolean(qs.isFulfilledByVendor as string, false),
  };

  return <ProductCreateView params={params} />;
};

const ProductUpdateViewWrapper: React.FC<RouteComponentProps<any>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ProductUpdateViewUrlQueryParams = qs;
  return (
    <ProductUpdateView
      id={decodeURIComponent(match.params.id)}
      params={{
        ...params,
        // @ts-ignore
        ids: getArrayQueryParam(qs.ids),
      }}
      isFbv={false}
    />
  );
};

const fbvProductUpdateViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ProductUpdateViewUrlQueryParams = qs;

  return <ProductUpdateView id={decodeURIComponent(match.params.id)} params={params} isFbv={true} />;
};

const ProductVariantUpdateViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ProductVariantUpdateViewUrlQueryParams = qs;

  return (
    <ProductVariantUpdateView
      variantId={decodeURIComponent(match.params.variantId)}
      productId={decodeURIComponent(match.params.productId)}
      params={params}
    />
  );
};

const ProductImageViewWrapper: React.FC<RouteComponentProps<any>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ProductImageViewUrlQueryParams = qs;

  return (
    <ProductImageView
      imageId={decodeURIComponent(match.params.imageId)}
      productId={decodeURIComponent(match.params.productId)}
      params={params}
    />
  );
};

const ProductVariantCreateViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => (
  <ProductVariantCreateView productId={decodeURIComponent(match.params.id)} />
);

const ProductVariantManageEventListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getProductVariantManageEventListDefaultParams();
  const params: ProductVariantManageEventListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <ProductVariantManageEventListView defaultParams={defaultParams} params={params} />;
};

const ProductSection = () => (
  <>
    <WindowTitle title={sectionNames.productsA} />
    <Switch>
      <Route exact path={productListViewPathA} component={ProductListViewWrapper} />
      <Route exact path={productListViewPathB} component={FbvBrandProductVariantViewWrapper} />

      <Route exact path={productCreateViewPath} component={ProductCreateViewWrapper} />
      <Route exact path={productVariantManageEventListViewPath} component={ProductVariantManageEventListViewWrapper} />
      <Route exact path={productVariantCreateViewPath(":id")} component={ProductVariantCreateViewWrapper} />
      <Route
        path={productVariantUpdateViewPath(":productId", ":variantId")}
        component={ProductVariantUpdateViewWrapper}
      />
      <Route path={productImageViewPath(":productId", ":imageId")} component={ProductImageViewWrapper} />
      <Route path={fbvProductUpdateViewPath(":id")} component={fbvProductUpdateViewWrapper} />
      <Route path={productUpdateViewPath(":id")} component={ProductUpdateViewWrapper} />
    </Switch>
  </>
);

export default ProductSection;
</file>

