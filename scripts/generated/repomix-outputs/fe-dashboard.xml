    },
    {
      title: "상태",
      key: "status",
      align: "center",
      width: 100,
      render: (_, record) => {
        const status = record.isActive ? StaffMemberStatus.ACTIVE : StaffMemberStatus.DEACTIVATED;
        return getStaffStatusText(status);
