    return hqPopupListViewPath;
  } else {
    return urlJoin(hqPopupListViewPath, "?" + stringifyQs(params));
  }
};

export const hqPopupDetailsViewPath = (id: string) => urlJoin(hqPopupSectionUrl, id);
export type HqPopupDetailsViewUrlQueryParams = BulkAction & Pagination;
export const hqPopupDetailsViewUrl = (id: string, params?: HqPopupDetailsViewUrlQueryParams) =>
  hqPopupDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);

export const hqPopupCreateViewPath = urlJoin(hqPopupSectionUrl, "add");
export const hqPopupCreateViewUrl = hqPopupCreateViewPath;
