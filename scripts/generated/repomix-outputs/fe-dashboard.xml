import { PlusOutlined } from "@ant-design/icons";
import { UseNavigatorResult } from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { FilterPageProps, ListProps } from "@src/global/core/types/types";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Row, Space } from "antd";
import React from "react";

import { BpBundles_bpBundles_edges_node } from "../../api/types/BpBundles";
import { BrandForBpvList_brand } from "../../api/types/BrandForBpvList";
import {
  BrandProductFilterKeys,
  BrandProductListFilterOpts,
  createFilterStructure,
} from "../BrandProductListPage/filters";
import { getBrandBundleListTableColumns } from "./BrandBundleListTableSettings";

// 세트 상품 모달 모드
export enum BrandBundleModalMode {
  VIEW = "VIEW",
  EDIT = "EDIT",
  DELETE = "DELETE",
}

interface BrandBundleListTableProps
  extends ListProps,
    FilterPageProps<BrandProductFilterKeys, BrandProductListFilterOpts> {
  brand: BrandForBpvList_brand;
  bundles: BpBundles_bpBundles_edges_node[];
  loading: boolean;
  navigate: UseNavigatorResult;
  onProductBundleCreate?: () => void;
  onProductBundleUpdate: (record: BpBundles_bpBundles_edges_node) => void;
  onProductBundleDelete: (record: BpBundles_bpBundles_edges_node) => void;
}

export const BrandBundleListTable: React.FC<BrandBundleListTableProps> = (props) => {
  const {
    //  brand,
    bundles,
    loading,
    navigate,
    onProductBundleCreate,
    onProductBundleUpdate,
    onProductBundleDelete,
    filterOpts,
    currencySymbol,
    currentTab,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const shopData = useShop();
  const filterStructure = createFilterStructure(filterOpts, true);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  // 세트 상품 상세보기 핸들러
  const handleViewBundleInfo = (record: BpBundles_bpBundles_edges_node) => {
    onProductBundleUpdate(record);
  };

  // 세트 상품 삭제 핸들러
  const handleDeleteBundle = (record: BpBundles_bpBundles_edges_node) => {
    if (record.forceNoNormalDisplay) {
      showNotificationWarn("판매중인 세트 상품은 삭제할 수 없습니다.");
      return;
    }
    onProductBundleDelete(record);
  };

  // 테이블 헤더 - 세트 상품 추가 버튼만 표시
  const tableTitle = onProductBundleCreate
    ? () => (
        <Row justify="end" align="bottom">
          <Space>
            <Button type="primary" icon={<PlusOutlined />} onClick={onProductBundleCreate} disabled={loading}>
              세트 상품 추가
            </Button>
          </Space>
        </Row>
      )
    : undefined;

  // 테이블 데이터 변환
  const tableDataSource: Array<BpBundles_bpBundles_edges_node & { no: number }> = bundles.map((bundle, index) => ({
    ...bundle,
    no: index + 1,
  }));

  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);

  // 테이블 컬럼 설정
  const columns = getBrandBundleListTableColumns({
    navigate,
    disabled: loading,
    onProductBundleUpdate: handleViewBundleInfo,
    onProductBundleDelete: handleDeleteBundle,
    stoppedReasonChoices: shopData?.stoppedReasonChoices || [],
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload: () =>
      Promise.resolve({ data: { dataSource: tableDataSource }, loading: undefined, networkStatus: undefined }),
    queryVariablesWithoutPagination: null,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "dataSource",
  };

  return (
    <>
      <SpreadFilterBar
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterStructure={filterStructure}
        tabs={tabs}
        onAll={onAll}
        onFilterChange={onFilterChange}
        onTabChange={onTabChange}
        onTabDelete={onTabDelete}
        onTabSave={onTabSave}
        tabExtra={
          <>
            <ColumnPicker
              columns={pickColumns}
              loading={loading}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          </>
        }
        isDownloadable={true}
        excelDownloadProps={excelDownloadProps}
      />
      <TableVatLegend isIncludeVat={false} />
      <PatchedColumnsTable
        {...commonTableProps}
        ref={tableRef}
        loading={loading}
        title={tableTitle}
        dataSource={tableDataSource}
        columns={pickerSelectedColumns}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
      />
    </>
  );
};
</file>

