import useUser from "@hooks/useUser";
import { RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import ListNavigator from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import {
  useNumberOfReqBossProductQuery,
  useRequestBossProductListFilterDownloadQuery,
  useRequestBossProductListQuery,
} from "@src/app/views/requestProduct/api/queries";
import { RequestBossProductListVariables } from "@src/app/views/requestProduct/api/types/RequestBossProductList";
import { getListByUrlType } from "@src/app/views/requestProduct/components/ReqBossProductListPage/filters";
import { ReqBossProductUrlEnum } from "@src/app/views/requestProduct/urls";
import { getStatusCount } from "@src/app/views/requestProduct/views/ReqBossProductListView/ReqBossProductListView";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import _ from "lodash";
import React, { useEffect, useRef } from "react";

import HqReqBossProductListPage from "../../components/HqReqBossProductListPage/HqReqBossProductListPage";
import {
  getHqReqBossProductNavButtonName,
  hqReqBossProductCreateViewUrl,
  hqReqBossProductDetailsViewUrl,
  hqReqBossProductListForConfirmedViewPath,
  hqReqBossProductListForEstimateViewPath,
  hqReqBossProductListForRequestedViewPath,
  hqReqBossProductListViewUrl,
  HqReqBossProductListViewUrlQueryParams,
  hqReqBossProductUrlList,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface HqReqBossProductListViewProps {
  params: HqReqBossProductListViewUrlQueryParams;
  isItFirstLoad: boolean;
  setIsItFirstLoad: React.Dispatch<React.SetStateAction<boolean>>;
}

export const HqReqBossProductListView: React.FC<HqReqBossProductListViewProps> = ({
  params,
  isItFirstLoad,
  setIsItFirstLoad,
}) => {
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const didMountRef = useRef(false);

  const getCurrentUrlType = () => {
    const currentPath = window.location.pathname;
    return hqReqBossProductUrlList.find((item) => currentPath.includes(item.path)) || hqReqBossProductUrlList[0];
  };

  const currentUrlType = getCurrentUrlType();
  const targetUrl = hqReqBossProductListViewUrl(currentUrlType.path);

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.REQ_BOSS_PRODUCT_LIST,
  });

  const { data: numberOfReqBossProductData } = useNumberOfReqBossProductQuery({
    skip: !isItFirstLoad,
    variables: { brandId: isHqStaff ? user.brand.id : null },
  });

  useEffect(() => {
    if (didMountRef.current) {
      if (isItFirstLoad) {
        const countData = numberOfReqBossProductData?.numberOfReqBossProduct;
        setIsItFirstLoad(false);
        if (countData?.request > 0) {
          navigate(hqReqBossProductListViewUrl(hqReqBossProductListForRequestedViewPath)());
        } else if (countData?.estimate > 0) {
          navigate(hqReqBossProductListViewUrl(hqReqBossProductListForEstimateViewPath)());
        } else if (countData?.confirm > 0) {
          navigate(hqReqBossProductListViewUrl(hqReqBossProductListForConfirmedViewPath)());
        }
      }
    } else {
      didMountRef.current = true;
    }
  }, [numberOfReqBossProductData]);

  const { fetchForDownload } = utils.initListViewDownloadQuery(useRequestBossProductListFilterDownloadQuery);

  const queryVariables: RequestBossProductListVariables = React.useMemo(() => {
    const statusList = utils.isEmpty(params.status)
      ? getListByUrlType(currentUrlType.urlEnum).map((filter) => filter.value)
      : (params.status as RequestBossProductStatusEnum[]);

    return {
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        brand: user.brand.id,
        status: statusList,
      },
      statusList: _.uniq([...statusList, RequestBossProductStatusEnum.REQUESTED]),
    };
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = useRequestBossProductListQuery({ variables: queryVariables });

  const { data: countData } = useNumberOfReqBossProductQuery({
    variables: { brandId: isHqStaff ? user.brand.id : null },
  });
  const counts = maybe(() => countData.numberOfReqBossProduct, null);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.requestBossProductList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const onCreate = () => {
    navigate(hqReqBossProductCreateViewUrl());
  };

  return (
    <>
      <HqReqBossProductListPage
        settings={settings}
        onUpdateListSettings={updateListSettings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        disabled={loading}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        currentTab={currentTab}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        data={data?.requestBossProductList.edges.map((edge) => edge.node)}
        fetchForDownload={fetchForDownload}
        pageInfo={pageInfo}
        urlType={currentUrlType.urlEnum}
        isStaff={isStaff}
        onCreate={onCreate}
        onRowClick={(id) => navigate(hqReqBossProductDetailsViewUrl(id))}
        ListNavigator={() => (
          <ListNavigator<HqReqBossProductListViewUrlQueryParams, ReqBossProductUrlEnum>
            countOfStatus={counts && getStatusCount(counts)}
            urlList={hqReqBossProductUrlList}
            NavButtonName={getHqReqBossProductNavButtonName}
          />
        )}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

