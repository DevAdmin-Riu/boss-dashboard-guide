import { sectionNames } from "@assets/messages/sectionNames";
import { SearchBsOpsCheckTemplates_search_edges_node } from "@src/api/searches/types/SearchBsOpsCheckTemplates";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { dateRangePresets, onlyDateFormat } from "@src/app/providers/DateProvider";
import { FetchMoreProps } from "@src/global/core/types/types";
import { Button, Col, DatePicker, Form, Row, Select, Space, Typography } from "antd";
import _ from "lodash";
import moment from "moment";
import React from "react";

import { BsOpsCheckTemplateReportsSummary_bsOpsCheckTemplateReportsSummary } from "../../api/types/BsOpsCheckTemplateReportsSummary";
import { BsOpsCheckReportListViewUrlQueryParams } from "../../urls";
import { getSummaryFilterVariables } from "../../views/BsOpsCheckReportListView/filters";
import { BsOpsCheckTemplateReportsSummary } from "../BsOpsCheckTemplateReportsSummary";

interface SummaryForm {
  templateId?: string;
  dateRange: [any, any];
}

interface BsOpsCheckTemplateReportsSummaryForListViewProps {
  params: BsOpsCheckReportListViewUrlQueryParams;
  summary: BsOpsCheckTemplateReportsSummary_bsOpsCheckTemplateReportsSummary;
  onParamsChange: (params: BsOpsCheckReportListViewUrlQueryParams) => void;

  templateList: SearchBsOpsCheckTemplates_search_edges_node[];
  fetchMoreTemplate: FetchMoreProps;
  onSearchTemplate: (searchText: string) => void;
}

export const BsOpsCheckTemplateReportsSummaryForListView: React.FC<BsOpsCheckTemplateReportsSummaryForListViewProps> = (
  props
) => {
  const { params, summary, onParamsChange, templateList, fetchMoreTemplate, onSearchTemplate } = props;
  const [form] = Form.useForm<SummaryForm>();
  const TypeSafeForm = getTypeSafeForm<SummaryForm>(form);

  const { templateId, dateRange } = getSummaryFilterVariables(params);
  const initialValues: SummaryForm = {
    templateId,
    dateRange: [moment(dateRange.gte), moment(dateRange.lte)],
  };

  const onSubmit = (formData: SummaryForm) => {
    const { templateId, dateRange } = formData;
    // template가 undefined인 경우는 onParamsChange에서 merge 되면서 기존 templateId가 유지되므로 null 전달
    const newSummaryParams: BsOpsCheckReportListViewUrlQueryParams = {
      template: templateId || null,
      dateRangeFrom: moment(dateRange[0]).format(onlyDateFormat),
      dateRangeTo: moment(dateRange[1]).format(onlyDateFormat),
    };
    onParamsChange(newSummaryParams);
  };

  const templateOptions = templateList.map((template) => ({
    label: template.title,
    value: template.id,
  }));

  return (
    <Space direction="vertical" size="large">
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.bsOpsCheckReportList} 대시보드</Typography.Title>
        </Col>
        <Col>
          <Form layout="vertical" form={form} initialValues={initialValues} onFinish={onSubmit}>
            <Row gutter={[12, 8]} align="bottom" justify="space-between">
              <Col>
                <Form.Item style={{ margin: 0 }} name={TypeSafeForm.getValidDataIndex("templateId")} label="양식">
                  <Select
                    showSearch
                    allowClear
                    style={{ width: 240 }}
                    placeholder="미선택 시 전체 양식"
                    options={templateOptions}
                    filterOption={(input, option) => option?.label?.toLowerCase().includes(input.toLowerCase())}
                    onSearch={onSearchTemplate}
                    loading={fetchMoreTemplate.loading}
                    onPopupScroll={({ currentTarget }) => {
                      const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                      const { hasMore, loading, onFetchMore } = fetchMoreTemplate;
                      // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                      if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                        onFetchMore();
                      }
                    }}
                  />
                </Form.Item>
              </Col>
              <Col>
                <Form.Item
                  style={{ margin: 0 }}
                  name={TypeSafeForm.getValidDataIndex("dateRange")}
                  label="조회 기간(제출일)"
                >
                  <DatePicker.RangePicker style={{ width: 240 }} allowClear={false} ranges={dateRangePresets} />
                </Form.Item>
              </Col>
              <Col>
                <Button type="primary" onClick={form.submit}>
                  조회
                </Button>
              </Col>
            </Row>
          </Form>
        </Col>
      </Row>
      <BsOpsCheckTemplateReportsSummary summary={summary} />
    </Space>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BsOpsCheckReportListPage/filters.ts">
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createTextField } from "@utils/filters/fields";
import { transformIsSubmitted } from "@utils/misc";
import { utils } from "@utils/utils";

export enum BsOpsCheckReportListFilterKeys {
  isSubmitted = "isSubmitted",
  titleSearch = "titleSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  templateSearch = "templateSearch",
  created = "created",
  submittedAt = "submittedAt",
}

export interface BsOpsCheckReportListFilterOpts {
  isSubmitted: FilterOpts<boolean>;
  titleSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  templateSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  submittedAt: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: BsOpsCheckReportListFilterOpts,
  isStaff: boolean
): IFilter<BsOpsCheckReportListFilterKeys> {
  let filterStructure = [];

  const isSubmittedFilter = {
    ...createBooleanField(0, BsOpsCheckReportListFilterKeys.isSubmitted, "상태", opts.isSubmitted.value, {
      positive: transformIsSubmitted(true),
      negative: transformIsSubmitted(false),
    }),
    active: opts.isSubmitted.active,
  };
  const titleSearchFilter = {
    ...createTextField(0, BsOpsCheckReportListFilterKeys.titleSearch, "제목", opts.titleSearch.value),
    active: opts.titleSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(0, BsOpsCheckReportListFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      0,
      BsOpsCheckReportListFilterKeys.brandStoreSearch,
      "매장코드 / 매장명",
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const templateSearchFilter = {
    ...createTextField(0, BsOpsCheckReportListFilterKeys.templateSearch, "작성 양식", opts.templateSearch.value),
    active: opts.templateSearch.active,
  };
  const createdFilter = {
    ...createDateField(0, BsOpsCheckReportListFilterKeys.created, "생성일", opts.created.value),
    active: opts.created.active,
  };
  const submittedAtFilter = {
    ...createDateField(0, BsOpsCheckReportListFilterKeys.submittedAt, "제출일", opts.submittedAt.value),
    active: opts.submittedAt.active,
  };

  filterStructure = [
    isSubmittedFilter,
    titleSearchFilter,
    isStaff && brandSearchFilter,
    brandStoreSearchFilter,
    templateSearchFilter,
    createdFilter,
    submittedAtFilter,
  ].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
</file>

<file path="src/app/views/brand/brandStore/components/BsOpsCheckTemplateCategoryList/BsOpsCheckTemplateCategoryCreateModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { bsOpsCheckTemplateFragment } from "@src/api/fragments/brandStore";
import { BsOpsCheckTemplateCategoryCreateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Select, SelectProps } from "antd";
import React, { useEffect } from "react";

import { useBsOpsCheckTemplateCategoryCreateMutation } from "../../api/mutations";
import { BsOpsCheckTemplateDetails_bsOpsCheckTemplate } from "../../api/types/BsOpsCheckTemplateDetails";

const noParentKey = "no-parent-key";

type TFormData = StrictOmit<BsOpsCheckTemplateCategoryCreateInput, "template">;

interface BsOpsCheckTemplateCategoryCreateModalProps {
  open: boolean;
  template: BsOpsCheckTemplateDetails_bsOpsCheckTemplate;
  onCancel: () => void;
}

export const BsOpsCheckTemplateCategoryCreateModal: React.FC<BsOpsCheckTemplateCategoryCreateModalProps> = (props) => {
  const { open, template, onCancel } = props;
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const initialValues: TFormData = {
    parent: noParentKey,
    name: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const parentOptions: SelectProps["options"] = [
    {
      label: "상위 카테고리 없음",
      value: noParentKey,
    },
    ...template.categories
      .filter((cat) => cat.level === 0)
      .map((cat) => ({
        label: cat.name,
        value: cat.id,
      })),
  ];

  const [bsOpsCheckTemplateCategoryCreate, bsOpsCheckTemplateCategoryCreateOpts] =
    useBsOpsCheckTemplateCategoryCreateMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.bsOpsCheckTemplateCategoryCreate.errors,
          "카테고리가 추가되었습니다.",
          () => {
            onCancel();
          }
        ),
    });

  const handleSubmit = (formData: TFormData) => {
    const input: BsOpsCheckTemplateCategoryCreateInput = {
      ...formData,
      template: template.id,
      parent: formData.parent === noParentKey ? null : formData.parent,
    };
    bsOpsCheckTemplateCategoryCreate({
      variables: { input },
      update: (cache, { data }) => {
        const newCategory = data.bsOpsCheckTemplateCategoryCreate.bsOpsCheckTemplateCategory;
        if (!newCategory) {
          return;
        }

        const template = props.template;
        const templateCacheId = cache.identify({ __typename: template.__typename, id: template.id });
        const updateFragment = bsOpsCheckTemplateFragment;
        updateMultipleFragments({
          cache,
          cacheId: templateCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "BsOpsCheckTemplateFragment",
              fieldName: "categories",
              updateFn: (prev) => {
                if (newCategory.level === 0) {
                  return [...prev, newCategory];
                } else {
                  return prev.map((cat) => {
                    if (cat.id === input.parent) {
                      return { ...cat, children: [...(cat.children || []), { ...newCategory, items: [] }] };
                    }
                    return cat;
                  });
                }
              },
            },
          ],
        });
      },
    });
  };

  const modalLoading = bsOpsCheckTemplateCategoryCreateOpts.loading;

  return (
    <Modal
      title="양식 카테고리 추가"
      open={open}
      confirmLoading={modalLoading}
      onOk={form.submit}
      onCancel={onCancel}
      maskClosable={false}
    >
      <Form
        name="bs-ops-check-template-category-create"
        layout="vertical"
        form={form}
        initialValues={initialValues}
        onFinish={handleSubmit}
      >
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("parent")}
          label="상위 카테고리"
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select options={parentOptions} />
        </Form.Item>
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("name")}
          label="카테고리 이름"
          rules={[{ required: true, message: formRuleMsg.required }]}
        >
          <Input placeholder="카테고리 이름" />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BsOpsCheckTemplateCategoryList/BsOpsCheckTemplateCategoryItemUpsertModal.tsx">
import { InfoCircleOutlined, PlusOutlined } from "@ant-design/icons";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { bsOpsCheckTemplateCategoryFragment } from "@src/api/fragments/brandStore";
import {
  BsOpsCheckTemplateCategoryItemCreateInput,
  BsOpsCheckTemplateCategoryItemFormTypeEnum,
  BsOpsCheckTemplateCategoryItemUpdateInput,
} from "@src/api/types/globalTypes";
import { formItemPropsForFileListUpload } from "@src/app/components/antd/Form/FormProps";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { utils } from "@utils/utils";
import {
  Breadcrumb,
  Button,
  Card,
  Col,
  Form,
  Input,
  InputNumber,
  Modal,
  Radio,
  Row,
  Space,
  Tooltip,
  Tree,
  Typography,
  Upload,
} from "antd";
import { DataNode } from "antd/lib/tree";
import React from "react";
import { useEffect } from "react";

import {
  useBsOpsCheckTemplateCategoryItemCreateMutation,
  useBsOpsCheckTemplateCategoryItemUpdateMutation,
} from "../../api/mutations";
import { BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children } from "../../api/types/BsOpsCheckTemplateDetails";
import { bsOpsCheckTemplateCategoryItemFormTypeChoices } from "../../utils";

type BsOpsCheckTemplateCategoryItemForm =
  | BsOpsCheckTemplateCategoryItemCreateInput
  | BsOpsCheckTemplateCategoryItemUpdateInput;

interface CommonProps {
  open: boolean;
  childCategory: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children;
  onCancel: () => void;
}
interface CreateProps {
  isCreate: true;
}
interface UpdateProps {
  isCreate: false;
  itemId: string;
}
type BsOpsCheckTemplateCategoryItemUpsertModalProps = CommonProps & (CreateProps | UpdateProps);

export const BsOpsCheckTemplateCategoryItemUpsertModal: React.FC<BsOpsCheckTemplateCategoryItemUpsertModalProps> = (
  props
) => {
  const { isCreate, open, childCategory, onCancel } = props;
  const [form] = Form.useForm<BsOpsCheckTemplateCategoryItemForm>();
  const TypeSafeForm = getTypeSafeForm<BsOpsCheckTemplateCategoryItemForm>(form);
  const isUpdate = isCreate === false;

  const formJsonTypeWatched = TypeSafeForm.getUseFormWatched({ name: "formJson.type" });

  const selectedItem = isUpdate && !!props.itemId && childCategory.items.find((item) => item.id === props.itemId);

  const createInitialValues: BsOpsCheckTemplateCategoryItemCreateInput = isCreate && {
    category: null,
    title: null,
    checkCriteria: null,
    criteriaImages: [],
    formJson: {
      type: BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO,
      options: null,
    },
    expectedFine: null,
    expectedSuspension: null,
  };
  const updateInitialValues: BsOpsCheckTemplateCategoryItemUpdateInput = selectedItem && {
    title: selectedItem.title,
    checkCriteria: selectedItem.checkCriteria,
    criteriaImages: selectedItem.criteriaImages.map((image) => ({ ...image, uid: image.id })),
    formJson: selectedItem.formJson,
    expectedFine: selectedItem.expectedFine,
    expectedSuspension: selectedItem.expectedSuspension,
  };
  const initialValues: BsOpsCheckTemplateCategoryItemForm = isCreate ? createInitialValues : updateInitialValues;

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [bsOpsCheckTemplateCategoryItemCreate, bsOpsCheckTemplateCategoryItemCreateOpts] =
    useBsOpsCheckTemplateCategoryItemCreateMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.bsOpsCheckTemplateCategoryItemCreate.errors,
          "점검 항목이 추가되었습니다.",
          onCancel
        ),
    });
  const [bsOpsCheckTemplateCategoryItemUpdate, bsOpsCheckTemplateCategoryItemUpdateOpts] =
    useBsOpsCheckTemplateCategoryItemUpdateMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.bsOpsCheckTemplateCategoryItemUpdate.errors,
          "점검 항목이 수정되었습니다.",
          onCancel
        ),
    });

  const modalLoading =
    bsOpsCheckTemplateCategoryItemCreateOpts.loading || bsOpsCheckTemplateCategoryItemUpdateOpts.loading;

  const onSubmit = (formData: BsOpsCheckTemplateCategoryItemForm) => {
    const { title, checkCriteria, criteriaImages, expectedFine, expectedSuspension, formJson } = formData;
    const parsedCriteriaImages = criteriaImages.map((image) => image.originFileObj ?? image);

    if (isCreate) {
      const input: BsOpsCheckTemplateCategoryItemCreateInput = {
        category: childCategory.id,
        title,
        checkCriteria,
        criteriaImages: parsedCriteriaImages,
        expectedFine,
        expectedSuspension,
        formJson,
      };
      bsOpsCheckTemplateCategoryItemCreate({
        variables: { input },
        update: (cache, { data }) => {
          const newItem = data.bsOpsCheckTemplateCategoryItemCreate.bsOpsCheckTemplateCategoryItem;
          if (!newItem) {
            return;
          }

          const categoryCacheId = cache.identify({
            __typename: childCategory.parent.__typename,
            id: childCategory.parent.id,
          });
          const updateFragment = bsOpsCheckTemplateCategoryFragment;
          updateMultipleFragments({
            cache,
            cacheId: categoryCacheId,
            updates: [
              {
                fragment: updateFragment,
                fragmentName: "BsOpsCheckTemplateCategoryFragment",
                fieldName: "children",
                updateFn: (prev: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children[]) =>
                  prev.map((cat) => {
                    if (cat.id === childCategory.id) {
                      return { ...cat, items: [...cat.items, newItem] };
                    }
                    return cat;
                  }),
              },
            ],
          });
        },
      });
    } else if (isUpdate) {
      const { itemId } = props;
      const newImages = parsedCriteriaImages.filter((image) => image instanceof File);
      const remainImageIds = parsedCriteriaImages.filter((image) => !(image instanceof File)).map((image) => image.id);
      const originImageIds = selectedItem.criteriaImages.map((image) => image.id);
      const deleteImageIds = originImageIds.filter((id) => !remainImageIds.includes(id));

      const input: BsOpsCheckTemplateCategoryItemUpdateInput = {
        title,
        checkCriteria,
        criteriaImages: newImages,
        deleteImages: deleteImageIds,
        expectedFine,
        expectedSuspension,
        formJson,
      };
      bsOpsCheckTemplateCategoryItemUpdate({ variables: { id: itemId, input } });
    }
    return;
  };

  const okText = isCreate ? "추가" : "수정";
  const criteriaMaxLength = 200;
  const criteriaImageMaxCount = 3;

  const makeFormJsonTypeHelpText = (): string => {
    switch (formJsonTypeWatched) {
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO:
        return "점검 내용에 대해 예/아니오로 답변하는 항목입니다.";
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.SCORE:
        return "점검 내용에 대해 1~5점의 점수로 답변하는 항목입니다.";
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.SELECT:
        return "점검 내용에 대해 본부가 직접 입력한 답변 중 하나를 선택해 답변하는 항목입니다.";
      default:
        return "";
    }
  };
  const makeFormJsonTypeExtra = () => {
    if (formJsonTypeWatched === BsOpsCheckTemplateCategoryItemFormTypeEnum.SELECT) {
      return (
        <Form.List
          name={TypeSafeForm.getValidDataIndex("formJson.options")}
          rules={[
            {
              validator: (_, value: string[]) => {
                if (!value || value.length === 0) {
                  return Promise.reject(new Error("답변 선택지는 최소 1개 이상이어야 합니다."));
                }
                return Promise.resolve();
              },
            },
          ]}
        >
          {(fields, { add, remove, move }, { errors }) => (
            <Card
              type="inner"
              size="small"
              title="답변 선택지"
              extra={
                <Button size="small" type="primary" onClick={() => add()}>
                  추가
                </Button>
              }
            >
              <Tree
                blockNode
                checkable={false}
                selectable={false}
                draggable
                onDrop={({ dragNode, dropPosition }) => {
                  const from = fields.find((f) => f.key === dragNode.key)?.name;
                  move(from, dropPosition);
                }}
                treeData={fields.map<DataNode>((field) => ({
                  key: field.key,
                  title: (
                    <FixedSplitRow
                      align="middle"
                      mainContent={
                        <Form.Item
                          style={{ margin: 0 }}
                          name={field.name}
                          rules={[{ required: true, message: formRuleMsg.required }]}
                        >
                          <Input size="small" />
                        </Form.Item>
                      }
                      sideContent={
                        <Button danger type="primary" size="small" onClick={() => remove(field.name)}>
                          삭제
                        </Button>
                      }
                    />
                  ),
                }))}
              />
              <Form.ErrorList errors={errors} />
            </Card>
          )}
        </Form.List>
      );
    }
    return null;
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={`점검 항목 ${okText}`}
      width={750}
      confirmLoading={modalLoading}
      okText={okText}
      onOk={form.submit}
      onCancel={onCancel}
      maskClosable={false}
    >
      <Form
        name="bs-ops-check-template-category-item-upsert"
        labelAlign="left"
        form={form}
        initialValues={initialValues}
        labelCol={{ span: 4 }}
        wrapperCol={{ span: 20 }}
        onFinish={onSubmit}
      >
        <Form.Item label="카테고리">
          <Breadcrumb separator=">">
            <Breadcrumb.Item>{childCategory?.parent.name}</Breadcrumb.Item>
            <Breadcrumb.Item>{childCategory?.name}</Breadcrumb.Item>
          </Breadcrumb>
        </Form.Item>
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("title")}
          label="제목"
          rules={[{ required: true, message: formRuleMsg.required }]}
        >
          <Input placeholder="점검 항목 이름을 입력하세요." />
        </Form.Item>
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("checkCriteria")}
          label="점검 기준"
          rules={[
            { required: true, message: formRuleMsg.required },
            { type: "string", max: criteriaMaxLength, message: formRuleMsg.max(criteriaMaxLength, "자") },
          ]}
        >
          <Input.TextArea
            showCount
            placeholder="점검 시 확인해야 하는 기준을 작성하세요."
            maxLength={criteriaMaxLength}
            rows={4}
          />
        </Form.Item>
        <Form.Item
          {...formItemPropsForFileListUpload}
          name={TypeSafeForm.getValidDataIndex("criteriaImages")}
          label="기준 이미지"
          rules={[{ type: "array", max: criteriaImageMaxCount, message: formRuleMsg.max(criteriaImageMaxCount, "개") }]}
          extra={`최대 ${criteriaImageMaxCount}개까지 업로드 가능합니다.`}
        >
          <Upload
            multiple
            listType="picture-card"
            accept="image/*"
            showUploadList={{ showPreviewIcon: false }}
            customRequest={({ onSuccess }) => {
              setTimeout(() => {
                onSuccess("ok");
              }, 0);
            }}
          >
            <div>
              <PlusOutlined />
              <div style={{ marginTop: 4 }}>업로드</div>
            </div>
          </Upload>
        </Form.Item>
        <Form.Item
          label={
            <span>
              예상 처분&nbsp;
              <Tooltip title="매장에서 '아니오'로 답변한 경우 발생할 수 있는 처분입니다.">
                <InfoCircleOutlined style={{ color: "#999" }} />
              </Tooltip>
            </span>
          }
        >
          <Row justify="space-between" gutter={12}>
            <Col xs={24} sm={12}>
              <Form.Item
                style={{ margin: 0 }}
                name={TypeSafeForm.getValidDataIndex("expectedFine")}
                rules={[{ type: "number", min: 0, message: formRuleMsg.min(0) }]}
              >
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  style={{ width: "100%" }}
                  prefix={<Typography.Text type="secondary">과태료</Typography.Text>}
                  addonAfter="만원"
                />
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item
                style={{ margin: 0 }}
                name={TypeSafeForm.getValidDataIndex("expectedSuspension")}
                rules={[{ type: "number", min: 0, message: formRuleMsg.min(0) }]}
              >
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  style={{ width: "100%" }}
                  prefix={<Typography.Text type="secondary">영업정지</Typography.Text>}
                  addonAfter="일"
                />
              </Form.Item>
            </Col>
          </Row>
        </Form.Item>
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("formJson.type")}
          label="답변 유형"
          dependencies={[
            TypeSafeForm.getValidDataIndex("expectedFine"),
            TypeSafeForm.getValidDataIndex("expectedSuspension"),
          ]}
          rules={[
            { required: true, message: formRuleMsg.requiredSelect },
            ({ getFieldValue }) => ({
              validator(_, value) {
                const fine = getFieldValue(TypeSafeForm.getValidDataIndex("expectedFine"));
                const suspension = getFieldValue(TypeSafeForm.getValidDataIndex("expectedSuspension"));
                if ((fine || suspension) && value !== BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO) {
                  const label = utils.getLabelTextByValue(
                    BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO,
                    bsOpsCheckTemplateCategoryItemFormTypeChoices
                  );
                  return Promise.reject(`예상 처분 값이 있으면 답변 유형은 "${label}"만 선택할 수 있습니다.`);
                }
                return Promise.resolve();
              },
            }),
          ]}
          extra={
            <Space direction="vertical" size={0}>
              {makeFormJsonTypeHelpText()}
              {makeFormJsonTypeExtra()}
            </Space>
          }
        >
          <Radio.Group options={bsOpsCheckTemplateCategoryItemFormTypeChoices} />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BsOpsCheckTemplateCategoryList/BsOpsCheckTemplateCategoryList.tsx">
import { bsOpsCheckTemplateCategoryFragment, bsOpsCheckTemplateFragment } from "@src/api/fragments/brandStore";
import { BsOpsCheckTemplateCreateInput } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import { FormSaveButtonEditModeProps } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Breadcrumb, Button, Card, Form, PageHeader, Space, Tag, Tree, TreeProps, Typography } from "antd";
import { DataNode } from "antd/lib/tree";
import React, { Key, useState } from "react";

import {
  useBsOpsCheckTemplateCategoryBulkDeleteMutation,
  useBsOpsCheckTemplateCategoryItemDeleteMutation,
  useBsOpsCheckTemplateCategoryItemMoveMutation,
  useBsOpsCheckTemplateCategoryMoveMutation,
} from "../../api/mutations";
import { BsOpsCheckTemplateCategoryUpdateVariables } from "../../api/types/BsOpsCheckTemplateCategoryUpdate";
import {
  BsOpsCheckTemplateDetails_bsOpsCheckTemplate,
  BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories,
  BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children,
} from "../../api/types/BsOpsCheckTemplateDetails";
import { bsOpsCheckTemplateCategoryItemFormTypeChoices, calcRelativeMove } from "../../utils";
import { BsOpsCheckTemplateCategoryCreateModal } from "./BsOpsCheckTemplateCategoryCreateModal";
import { BsOpsCheckTemplateCategoryItemUpsertModal } from "./BsOpsCheckTemplateCategoryItemUpsertModal";
import { BsOpsCheckTemplateCategoryTreePanel } from "./BsOpsCheckTemplateCategoryTree";

enum BsOpsCheckTemplateCategoryListModalModeEnum {
  CreateCategory = "CreateCategory",
  CreateCategoryItem = "CreateCategoryItem",
  UpdateCategoryItem = "UpdateCategoryItem",
  DeleteCategoryItem = "DeleteCategoryItem",
}

interface CreateProps {
  isCreate: true;
  TypeSafeForm: TypeSafeForm<BsOpsCheckTemplateCreateInput>;
}
interface UpdateProps {
  isCreate: false;
  TypeSafeForm: TypeSafeForm<BsOpsCheckTemplateCategoryUpdateVariables>;
  template: BsOpsCheckTemplateDetails_bsOpsCheckTemplate;
  editModeProps: FormSaveButtonEditModeProps;
}
type BsOpsCheckTemplateCategoryListProps = CreateProps | UpdateProps;

export const BsOpsCheckTemplateCategoryList: React.FC<BsOpsCheckTemplateCategoryListProps> = (props) => {
  const { isCreate } = props;
  const [modalMode, setModalMode] = useState<BsOpsCheckTemplateCategoryListModalModeEnum>(null);
  // 체크된 키는 양식 등록 페이지에서 Form.List의 key(숫자 타입)로도 이용되므로 Key 타입으로 선언
  const [checkedCategoryKeys, setCheckedCategoryKeys] = useState<Key[]>([]);
  const [selectedChildCategoryId, setSelectedChildCategoryId] = useState<string>(null);
  const [selectedItemId, setSelectedItemId] = useState<string>(null);
  const isUpdate = isCreate === false;

  const parentCategoryList: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories[] = [];
  const childCategoryList: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children[] = [];
  if (isUpdate) {
    const { template } = props;
    parentCategoryList.push(...template.categories);
    childCategoryList.push(...template.categories.flatMap((cat) => cat.children));
  }
  const allCategoryList = [...parentCategoryList, ...childCategoryList];

  const notSelectedCategory = utils.isEmpty(selectedChildCategoryId);
  const selectedChildCategory = childCategoryList.find((cat) => cat.id === selectedChildCategoryId);

  const handleModalOpen = (mode: BsOpsCheckTemplateCategoryListModalModeEnum, itemId?: string) => {
    setModalMode(mode);
    if (!!itemId) {
      setSelectedItemId(itemId);
    }
  };
  const handleModalClose = () => {
    setModalMode(null);
    setSelectedItemId(null);
  };

  const [bsOpsCheckTemplateCategoryBulkDelete] = useBsOpsCheckTemplateCategoryBulkDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bsOpsCheckTemplateCategoryBulkDelete.errors,
        "선택된 카테고리가 삭제되었습니다."
      ),
  });
  const [bsOpsCheckTemplateCategoryMove] = useBsOpsCheckTemplateCategoryMoveMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bsOpsCheckTemplateCategoryMove.errors, "카테고리가 순서가 변경되었습니다."),
  });
  const [bsOpsCheckTemplateCategoryItemDelete] = useBsOpsCheckTemplateCategoryItemDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bsOpsCheckTemplateCategoryItemDelete.errors,
        "선택된 점검 항목이 삭제되었습니다.",
        handleModalClose
      ),
  });
  const [bsOpsCheckTemplateCategoryItemMove] = useBsOpsCheckTemplateCategoryItemMoveMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bsOpsCheckTemplateCategoryItemMove.errors,
        "점검 항목 순서가 변경되었습니다."
      ),
  });

  const handleCategoryBulkDelete = () => {
    if (!isUpdate || checkedCategoryKeys.length === 0) {
      return;
    }

    const selectedIds = [...checkedCategoryKeys] as string[];
    setCheckedCategoryKeys([]);
    setSelectedChildCategoryId(null);

    bsOpsCheckTemplateCategoryBulkDelete({
      variables: { ids: selectedIds },
      update: (cache, { data }) => {
        const errors = data.bsOpsCheckTemplateCategoryBulkDelete.errors;
        if (errors.length > 0) {
          return;
        }

        const template = props.template;
        const templateCacheId = cache.identify({ __typename: template.__typename, id: template.id });
        const updateFragment = bsOpsCheckTemplateFragment;
        updateMultipleFragments({
          cache,
          cacheId: templateCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "BsOpsCheckTemplateFragment",
              fieldName: "categories",
              updateFn: (prev: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories[]) =>
                prev
                  .filter((cat) => !selectedIds.includes(cat.id))
                  .map((cat) => ({
                    ...cat,
                    children: cat.children.filter((child) => !selectedIds.includes(child.id)),
                  })),
            },
          ],
        });
      },
    });
  };

  const handleCategoryMove: TreeProps["onDrop"] = (info) => {
    if (!isUpdate) {
      return;
    }

    const { dragNode, node, dropPosition, dropToGap } = info;
    const { template } = props;
    const dragCategory = allCategoryList.find((cat) => cat.id === dragNode.key);
    const toCategory = allCategoryList.find((cat) => cat.id === node.key);

    if (dragCategory.level === 0 && toCategory.level === 1) {
      const hasChildren = parentCategoryList.some((cat) => cat.id === dragCategory.id && cat.children.length > 0);
      if (hasChildren) {
        showNotificationError("세부 카테고리가 있는 상위 카테고리는 세부 카테고리로 이동할 수 없습니다.");
        return;
      }
    }

    const itemId = dragCategory.id;

    let parentId: string = null;
    if (dropToGap) {
      parentId = toCategory.parent?.id;
    } else {
      parentId = toCategory.id;
    }

    let move: number = null;
    const parentChanged = dragCategory.parent?.id !== parentId;
    if (!parentChanged) {
      const siblings: Array<
        | BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories
        | BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children
      > =
        dragCategory.level === 0
          ? parentCategoryList
          : parentCategoryList.find((cat) => cat.id === dragCategory.parent.id)?.children || [];
      move = calcRelativeMove(siblings, dragCategory, "id", dropPosition);
    }

    if (move === 0) {
      return;
    }
    bsOpsCheckTemplateCategoryMove({ variables: { template: template.id, moves: [{ parentId, itemId, move }] } });
  };

  const handleCategoryItemDelete = () => {
    if (!isUpdate || notSelectedCategory || !selectedItemId) {
      return;
    }

    bsOpsCheckTemplateCategoryItemDelete({
      variables: { id: selectedItemId },
      update: (cache, { data }) => {
        const errors = data.bsOpsCheckTemplateCategoryItemDelete.errors;
        if (errors.length > 0) {
          return;
        }

        const categoryCacheId = cache.identify({
          __typename: selectedChildCategory.parent.__typename,
          id: selectedChildCategory.parent.id,
        });
        const updateFragment = bsOpsCheckTemplateCategoryFragment;
        updateMultipleFragments({
          cache,
          cacheId: categoryCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "BsOpsCheckTemplateCategoryFragment",
              fieldName: "children",
              updateFn: (prev: BsOpsCheckTemplateDetails_bsOpsCheckTemplate_categories_children[]) =>
                prev.map((cat) => {
                  if (cat.id === selectedChildCategory.id) {
                    return { ...cat, items: cat.items.filter((item) => item.id !== selectedItemId) };
                  }
                  return cat;
                }),
            },
          ],
        });
      },
    });
  };

  const handleCategoryItemMove: TreeProps["onDrop"] = (info) => {
    if (!isUpdate || notSelectedCategory) {
      return;
    }

    const { dragNode, dropPosition } = info;
    const itemId = dragNode.key as string;
    const selectedCategoryItemList = selectedChildCategory?.items || [];
    const dragCategoryItem = selectedCategoryItemList.find((item) => item.id === itemId);
    const move = calcRelativeMove(selectedCategoryItemList, dragCategoryItem, "id", dropPosition);
    if (move === 0) {
      return;
    }
    bsOpsCheckTemplateCategoryItemMove({
      variables: { category: selectedChildCategory.id, moves: [{ itemId, move }] },
    });
  };

  const cardTitle = <PageHeader title="점검 항목" />;
  const makeSelectedCategoryInfo = () => {
    if (!isUpdate) {
      return null;
    }

    if (notSelectedCategory) {
      return <Typography.Text type="secondary">카테고리 미선택</Typography.Text>;
    }

    const parentCategory = parentCategoryList.find((cat) => cat.id === selectedChildCategory?.parent?.id);
    return (
      <Breadcrumb separator=">">
        <Breadcrumb.Item>{parentCategory.name}</Breadcrumb.Item>
        <Breadcrumb.Item>{selectedChildCategory?.name}</Breadcrumb.Item>
      </Breadcrumb>
    );
  };
  const makeSelectedCategoryItemList = () => {
    if (!isUpdate || notSelectedCategory) {
      return null;
    }

    const itemList = selectedChildCategory?.items || [];
    if (itemList.length === 0) {
      return <Typography.Text type="secondary">항목 없음</Typography.Text>;
    }

    const treeData = itemList.map<DataNode>((item) => ({
      key: item.id,
      title: (
        <Card
          type="inner"
          size="small"
          title={
            <Space align="end">
              <Typography>
                #{item.sortOrder} {item.title}
              </Typography>
              <Tag>{utils.getLabelTextByValue(item.formJson.type, bsOpsCheckTemplateCategoryItemFormTypeChoices)}</Tag>
            </Space>
          }
          extra={
            <Space>
              <Button
                size="small"
                type="primary"
                onClick={() => handleModalOpen(BsOpsCheckTemplateCategoryListModalModeEnum.UpdateCategoryItem, item.id)}
              >
                수정
              </Button>
              <Button
                danger
                size="small"
                type="primary"
                onClick={() => handleModalOpen(BsOpsCheckTemplateCategoryListModalModeEnum.DeleteCategoryItem, item.id)}
              >
                삭제
              </Button>
            </Space>
          }
        >
          <Typography style={{ whiteSpace: "pre-line" }}>{item.checkCriteria}</Typography>
        </Card>
      ),
    }));

    return (
      <Tree
        blockNode
        checkable={false}
        selectable={false}
        draggable
        onDrop={handleCategoryItemMove}
        treeData={treeData}
      />
    );
  };

  return (
    <>
      <Card title={cardTitle}>
        <FixedSplitRow
          mainContentPosition="right"
          sideContent={
            isCreate ? (
              <Form.List name={props.TypeSafeForm.getValidDataIndex("categories")}>
                {/* NOTE: Form.List의 fields에서 key와 name은 다름. key는 생성 순서, name은 현재 기준 단순 index */}
                {(fields, { add, remove, move }) => (
                  <BsOpsCheckTemplateCategoryTreePanel
                    isCreate
                    categoryList={fields.map((f) => ({ key: f.key, formListIdx: f.name }))}
                    checkedKeys={checkedCategoryKeys}
                    onCheck={(keys) => setCheckedCategoryKeys(keys as number[])}
                    onAdd={add}
                    onRemove={() => remove(checkedCategoryKeys as number[])}
                    onDrop={({ dragNode, dropPosition }) => {
                      const from = fields.find((f) => f.key === dragNode.key)?.name;
                      const to = Math.max(Math.min(dropPosition - 1, fields.length - 1), 0);
                      move(from, to);
                    }}
                  />
                )}
              </Form.List>
            ) : isUpdate ? (
              <BsOpsCheckTemplateCategoryTreePanel
                isCreate={false}
                TypeSafeForm={props.TypeSafeForm}
                categoryList={parentCategoryList}
                checkedKeys={checkedCategoryKeys}
                selectedKeys={[selectedChildCategoryId]}
                onCheck={(keys) => setCheckedCategoryKeys(keys as string[])}
                onSelect={(keys, { selected }) => {
                  if (keys.length > 0 && selected) {
                    setSelectedChildCategoryId(keys[0] as string);
                  } else {
                    setSelectedChildCategoryId(null);
                  }
                }}
                onAdd={() => handleModalOpen(BsOpsCheckTemplateCategoryListModalModeEnum.CreateCategory)}
                onRemove={handleCategoryBulkDelete}
                onDrop={handleCategoryMove}
                editModeProps={props.editModeProps}
              />
            ) : null
          }
          mainContent={
            <Card
              type="inner"
              title="항목 리스트"
              extra={
                <Button
                  size="small"
                  type="primary"
                  disabled={notSelectedCategory}
                  onClick={() => handleModalOpen(BsOpsCheckTemplateCategoryListModalModeEnum.CreateCategoryItem)}
                >
                  항목 추가
                </Button>
              }
            >
              {isCreate ? (
                <Typography.Text strong type="warning">
                  세부 카테고리와 점검 항목은 양식 등록 후, 점검 양식 상세 페이지에서 설정할 수 있습니다.
                </Typography.Text>
              ) : isUpdate ? (
                <Space direction="vertical">
                  {makeSelectedCategoryInfo()}
                  {makeSelectedCategoryItemList()}
                </Space>
              ) : null}
            </Card>
          }
        />
      </Card>

      {isUpdate && (
        <>
          <BsOpsCheckTemplateCategoryCreateModal
            open={modalMode === BsOpsCheckTemplateCategoryListModalModeEnum.CreateCategory}
            template={props.template}
            onCancel={handleModalClose}
          />
          <BsOpsCheckTemplateCategoryItemUpsertModal
            isCreate={modalMode === BsOpsCheckTemplateCategoryListModalModeEnum.CreateCategoryItem}
            open={[
              BsOpsCheckTemplateCategoryListModalModeEnum.CreateCategoryItem,
              BsOpsCheckTemplateCategoryListModalModeEnum.UpdateCategoryItem,
            ].includes(modalMode)}
            childCategory={selectedChildCategory}
            itemId={selectedItemId}
            onCancel={handleModalClose}
          />
          <ConfirmModal
            visible={modalMode === BsOpsCheckTemplateCategoryListModalModeEnum.DeleteCategoryItem}
            modalTitleText="점검 항목 삭제"
            titleText="점검 항목을 삭제하시겠습니까?"
            helpText="삭제된 점검 항목은 복구할 수 없습니다."
            okButtonProps={{ danger: true, type: "primary" }}
            okText="삭제"
            onOk={handleCategoryItemDelete}
            onCancel={handleModalClose}
          />
        </>
      )}
    </>
  );
};
