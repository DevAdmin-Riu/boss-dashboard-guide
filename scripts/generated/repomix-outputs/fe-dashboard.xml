    });
  }

  const salesStatsSumColumns: DownloadableColumnsType<SalesStatDataSourceProps> = [];
  if (columnsTypes && columnsTypes?.total === true) {
    salesStatsSumColumns.push({
      title: "총 매출(전체 상품)",
      children: makeSalesStatsColumns<SalesStatDataSourceProps>(createGetStatFromRecordFuncForSum("total")),
      isPickerHide: true,
    });
  }
  if (columnsTypes && columnsTypes?.exclusive === true) {
    salesStatsSumColumns.push({
      title: "전용 상품",
      children: makeSalesStatsColumns<SalesStatDataSourceProps>(createGetStatFromRecordFuncForSum("exclusive")),
      isPickerHide: true,
    });
  }
  if (columnsTypes && columnsTypes?.packaging === true) {
    salesStatsSumColumns.push({
      title: "외식포장재",
      children: makeSalesStatsColumns<SalesStatDataSourceProps>(createGetStatFromRecordFuncForSum("packaging")),
      isPickerHide: true,
    });
  }
  if (columnsTypes && columnsTypes?.food === true) {
    salesStatsSumColumns.push({
      title: "식자재",
      children: makeSalesStatsColumns<SalesStatDataSourceProps>(createGetStatFromRecordFuncForSum("food")),
      isPickerHide: true,
    });
  }
  if (columnsTypes && columnsTypes?.equipment === true) {
    salesStatsSumColumns.push({
      title: "설비",
