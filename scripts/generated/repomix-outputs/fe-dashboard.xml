import { UseSearchResult } from "@hooks/makeSearch";
import { SearchCategories, SearchCategoriesVariables } from "@src/api/searches/types/SearchCategories";
import { PvEstimateFilterInput, PvEstimateStatusEnum, PvEstimateTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { InitialProductFilterData_categories_edges_node } from "@src/app/views/product/products/api/types/InitialProductFilterData";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { PvEstimateListFilterKeys, PvEstimateListFilterOpts } from "../../components/PvEstimatePage/filters";
import {
  PvEstimateListViewUrlFilters,
  PvEstimateListViewUrlFiltersEnum,
  PvEstimateListViewUrlFiltersWithMultipleValuesEnum,
  PvEstimateListViewUrlQueryParams,
} from "../../urls";

const PV_ESTIMATE_FILTERS_KEY = "pvEstimateFilters";

export function getFilterOpts(
  params: PvEstimateListViewUrlFilters,
  categories: {
    initial: InitialProductFilterData_categories_edges_node[];
    search: UseSearchResult<SearchCategories, SearchCategoriesVariables>;
  }
): PvEstimateListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  return {
    aiQuerySearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.aiQuerySearch), false),
      value: maybe(() => filterVariables.aiQuerySearch, ""),
    },
    categories: {
      active: maybe(() => !utils.isEmpty(filterVariables.categories), false),
      choices: maybe(
        () =>
          categories.search.result.data.search.edges.map((edge) => ({
            label: edge.node.name,
            value: edge.node.id,
          })),
        []
      ),
      displayValues: maybe(() => !utils.isEmpty(filterVariables.categories), false)
        ? maybe(
            () =>
              categories.initial.map((category) => ({
                label: category.name,
                value: category.id,
              })),
            []
          )
        : [],
      hasMore: maybe(() => categories.search.result.data.search.pageInfo.hasNextPage, false),
      initialSearch: "",
      loading: categories.search.result.loading,
      onFetchMore: categories.search.loadMore,
      onSearchChange: categories.search.search,
      value: maybe(() => dedupeFilter(filterVariables.categories), []),
    },
    pvEstimateSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.pvEstimateSearch), false),
      value: maybe(() => filterVariables.pvEstimateSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
    prevProductNameSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.prevProductNameSearch), false),
      value: maybe(() => filterVariables.prevProductNameSearch, ""),
    },
    buyMethodSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.buyMethodSearch), false),
      value: maybe(() => filterVariables.buyMethodSearch, ""),
    },
    sameOrReplacementSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.sameOrReplacementSearch), false),
      value: maybe(() => filterVariables.sameOrReplacementSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    makerSkuSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.makerSkuSearch), false),
      value: maybe(() => filterVariables.makerSkuSearch, ""),
    },
    shapeSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.shapeSearch), false),
      value: maybe(() => filterVariables.shapeSearch, ""),
    },
    sCWSpecSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.sCWSpecSearch), false),
      value: maybe(() => filterVariables.sCWSpecSearch, ""),
    },
    materialSpecSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.materialSpecSearch), false),
      value: maybe(() => filterVariables.materialSpecSearch, ""),
    },
    colorSpecSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.colorSpecSearch), false),
      value: maybe(() => filterVariables.colorSpecSearch, ""),
    },
    makerSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.makerSearch), false),
      value: maybe(() => filterVariables.makerSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    isExclusive: {
      active: maybe(() => !utils.isEmpty(filterVariables.isExclusive), false),
      value: maybe(() => filterVariables.isExclusive, true),
    },
    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, true),
    },
    estimateDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.estimateDate.gte, filterVariables.estimateDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.estimateDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.estimateDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(
        () => dedupeFilter(filterVariables.type.map((status) => findValueInEnum(status, PvEstimateTypeEnum))),
        []
      ),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(
        () => dedupeFilter(filterVariables.status.map((status) => findValueInEnum(status, PvEstimateStatusEnum))),
        []
      ),
    },
  };
}

export function getFilterVariables(params: PvEstimateListViewUrlFilters): PvEstimateFilterInput {
  return {
    aiQuerySearch: params.aiQuerySearch,
    categories: params.categories !== undefined ? params.categories : [],
    pvEstimateSearch: params.pvEstimateSearch,
    brandSearch: params.brandSearch,
    mdSearch: params.mdSearch,
    prevProductNameSearch: params.prevProductNameSearch,
    buyMethodSearch: params.buyMethodSearch,
    sameOrReplacementSearch: params.sameOrReplacementSearch,
    productSearch: params.productSearch,
    makerSkuSearch: params.makerSkuSearch,
    shapeSearch: params.shapeSearch,
    sCWSpecSearch: params.sCWSpecSearch,
    materialSpecSearch: params.materialSpecSearch,
    colorSpecSearch: params.colorSpecSearch,
    makerSearch: params.makerSearch,
    vendorSearch: params.vendorSearch,
    isExclusive: params.isExclusive !== undefined ? parseBoolean(params.isExclusive, true) : undefined,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, true) : undefined,
    estimateDate: getGteLteVariables({
      gte: params.estimateDateFrom,
      lte: params.estimateDateTo,
    }),
    type: maybe(() => params.type.map((status) => findInEnum(status, PvEstimateTypeEnum)), []),
    status: maybe(() => params.status.map((status) => findInEnum(status, PvEstimateStatusEnum)), []),
  };
}

export function getFilterQueryParam(filter: IFilterElement<PvEstimateListFilterKeys>): PvEstimateListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case PvEstimateListFilterKeys.aiQuerySearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.aiQuerySearch);
    case PvEstimateListFilterKeys.categories:
      return getMultipleValueQueryParam(filter, PvEstimateListViewUrlFiltersWithMultipleValuesEnum.categories);
    case PvEstimateListFilterKeys.pvEstimateSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.pvEstimateSearch);
    case PvEstimateListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.brandSearch);
    case PvEstimateListFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.mdSearch);
    case PvEstimateListFilterKeys.prevProductNameSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.prevProductNameSearch);
    case PvEstimateListFilterKeys.buyMethodSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.buyMethodSearch);
    case PvEstimateListFilterKeys.sameOrReplacementSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.sameOrReplacementSearch);
    case PvEstimateListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.productSearch);
    case PvEstimateListFilterKeys.makerSkuSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.makerSkuSearch);
    case PvEstimateListFilterKeys.shapeSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.shapeSearch);
    case PvEstimateListFilterKeys.sCWSpecSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.sCWSpecSearch);
    case PvEstimateListFilterKeys.materialSpecSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.materialSpecSearch);
    case PvEstimateListFilterKeys.colorSpecSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.colorSpecSearch);
    case PvEstimateListFilterKeys.makerSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.makerSearch);
    case PvEstimateListFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.vendorSearch);
    case PvEstimateListFilterKeys.isExclusive:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.isExclusive);
    case PvEstimateListFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, PvEstimateListViewUrlFiltersEnum.trackInventory);
    case PvEstimateListFilterKeys.estimateDate:
      return getMinMaxQueryParam(
        filter,
        PvEstimateListViewUrlFiltersEnum.estimateDateFrom,
        PvEstimateListViewUrlFiltersEnum.estimateDateTo
      );
    case PvEstimateListFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        PvEstimateListViewUrlFiltersWithMultipleValuesEnum.type,
        PvEstimateTypeEnum
      );
    case PvEstimateListFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        PvEstimateListViewUrlFiltersWithMultipleValuesEnum.status,
        PvEstimateStatusEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PvEstimateListViewUrlFilters>(PV_ESTIMATE_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PvEstimateListViewUrlQueryParams,
  PvEstimateListViewUrlFilters
>({
  ...PvEstimateListViewUrlFiltersEnum,
  ...PvEstimateListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

