<file path="src/app/components/Navigator/ListNavigator.tsx">
import useNavigator from "@hooks/useNavigator";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Badge, Col, Segmented } from "antd";
import React from "react";
import { useLocation } from "react-router";

export type TCountOfStatus<UrlTypeEnum extends number | string> = {
  [key in UrlTypeEnum]: number;
};

export interface UrlListType<UrlTypeEnum, QueryParams> {
  urlEnum: UrlTypeEnum;
  fnUrl: (params?: QueryParams) => string;
  path: string;
}

interface ListNavigatorProps<QueryParams, UrlTypeEnum extends number | string> {
  urlList: Array<UrlListType<UrlTypeEnum, QueryParams>>;
  countOfStatus: TCountOfStatus<UrlTypeEnum>;
  NavButtonName: (urlEnum: UrlTypeEnum) => string;
  skipQueryString?: boolean;
}

const ListNavigator = <QueryParams, UrlTypeEnum extends number | string>(
  props: ListNavigatorProps<QueryParams, UrlTypeEnum>
): React.ReactElement => {
  const { urlList, countOfStatus, NavButtonName, skipQueryString = false } = props;
  const getUrlListType = (newUrlTypeEnum) => urlList.find((item) => item.urlEnum === newUrlTypeEnum);

  const navigate = useNavigator();
  const location = useLocation();

  // 현재 pathname과 일치하는 urlList 항목 찾기
  const currentUrlType = urlList.find((item) => location.pathname === item.path);

  if (utils.isEmpty(currentUrlType)) {
    return null;
  }

  const onClick = (e: React.MouseEvent<HTMLElement>) => {
    const target = e.currentTarget;
    const newUrlTypeEnum = target.dataset.key ? target.dataset.key : null;

    if (newUrlTypeEnum === currentUrlType.urlEnum) {
      return;
    }
    const findUrlType: UrlListType<UrlTypeEnum, QueryParams> | null = getUrlListType(newUrlTypeEnum);

    if (findUrlType === null) {
      showNotificationError("잘못된 접근입니다.");
      return false;
    }

    // skipQueryString = false인 경우, 현재의 query string을 그대로 append 하여 새로운 URL로 이동합니다.
    const navigateUrl = skipQueryString ? findUrlType.fnUrl() : `${findUrlType.fnUrl()}${location.search}`;
    navigate(navigateUrl);
  };

  const segmentOptions = urlList.map((item, index: number) => ({
    label: (
      <React.Fragment key={`${item.urlEnum}-${index}`}>
        <Col
          onClick={onClick}
          data-key={item.urlEnum}
          style={{ padding: "6px 8px", margin: 2, color: location.pathname === item.path ? "#f1f1f1" : "inherit" }}
        >
          {NavButtonName(item.urlEnum)}
          {countOfStatus && <Badge style={{ marginLeft: 7 }} overflowCount={999} count={countOfStatus[item.urlEnum]} />}
        </Col>
      </React.Fragment>
    ),
    value: item.urlEnum,
  }));

  return (
    <div style={{ width: "100%", overflowX: "auto" }}>
      <Segmented options={[...segmentOptions]} value={currentUrlType.urlEnum} />
    </div>
  );
};

export default ListNavigator;
</file>

