const getActiveRackLocationTagConfigKeys = (
  rackLocation: TRackLocationForTag | null
): Array<keyof typeof rackLocationTagConfig> => {
  const activeKeys: TRackLocationTagConfigKey[] = [];
  if (!rackLocation) {
    return activeKeys;
  }
  Object.keys(rackLocationTagConfig).forEach((key) => {
    const rackLocationKey = key as TRackLocationTagConfigKey;
    if (rackLocation[rackLocationKey]) {
      activeKeys.push(rackLocationKey);
    }
  });

  return activeKeys;
};

