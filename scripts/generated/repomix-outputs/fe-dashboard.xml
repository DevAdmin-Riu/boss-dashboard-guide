  qtyPerDeliveryBox: undefined,
  autoTurnOffAllowAutoConsignment: false,
  isSubPv: false,
  canSaleByInner: false,
  requiredExpDateMgmt: false,
  stockAdjustFactor: 0,
  basicStockQty: undefined,
  safetyStockQty: undefined,
  rop: undefined,
  stocks: [],
  note: "",
  poNote: "",
