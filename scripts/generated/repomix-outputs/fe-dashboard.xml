import useNavigator from "@hooks/useNavigator";
import { VendorUpdateInput } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import Loader from "@src/app/components/Loader";
import { DeleteFileType, UpdateFileDescType } from "@src/app/components/UploadFiles";
import {
  useCreateVendorEtcFileMutation,
  useDeleteVendorEtcFileMutation,
  useUpdateVendorEtcFileMutation,
  useVendorManageAddNoteMutation,
  useVendorUpdateMutation,
} from "@src/app/views/purchase/vendors/api/mutations";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { UploadFile } from "antd";
import React, { useState } from "react";

import { useVendorQuery } from "../api/queries";
import { VendorDetailsPage, VendorUpdateFormData } from "../components/VendorDetailsPage";
import { vendorListViewUrl } from "../urls";
import { checkValidVendorFormData, parseVendorCreateOrUpdateFormData } from "../utils";

interface VendorDetailsViewProps {
  id: string;
}

export const VendorDetailsView: React.FC<VendorDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const [addFileList, setAddFileList] = useState<UploadFile[]>([]);
  const [addDescList, setAddDescList] = useState<string[]>([]);
  const [updateDescList, setUpdateDescList] = useState<UpdateFileDescType[]>([]);
  const [deleteFileList, setDeleteFileList] = useState<DeleteFileType[]>([]);
  const [hasChanged, setHasChanged] = useState<boolean>(false);

  const { data, loading } = useVendorQuery({ variables: { id } });
  const vendor = maybe(() => data.vendor, null);

  const [createVendorEtcFile] = useCreateVendorEtcFileMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.vendorEtcFileCreate.errors, null),
  });

  const [updateVendorEtcFile] = useUpdateVendorEtcFileMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.vendorEtcFileUpdate.errors, null),
  });

  const [deleteVendorEtcFile] = useDeleteVendorEtcFileMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.vendorEtcFileDelete.errors, null),
  });

  const createVendorEtcFiles = async (addFileList: UploadFile[], addDescList: string[]) => {
    const length = addFileList?.length;
    for (let i = 0; i < length; i++) {
      await createVendorEtcFile({
        variables: {
          input: {
            vendor: data?.vendor?.id,
            file: addFileList[i].originFileObj,
            fileName: addFileList[i].name,
            description: addDescList[i],
          },
        },
      });
    }
  };

  const updateVendorEtcFiles = async (updateDescList: UpdateFileDescType[]) => {
    const length = updateDescList?.length;
    for (let i = 0; i < length; i++) {
      const updateDesc = updateDescList[i];
      const { id, description } = updateDesc;
      await updateVendorEtcFile({
        variables: {
          id,
          input: {
            description,
          },
        },
      });
    }
  };

  const deleteVendorEtcFiles = async (deleteFileList: DeleteFileType[]) => {
    const length = deleteFileList?.length;
    for (let i = 0; i < length; i++) {
      const deleteFile = deleteFileList[i];
      const { id } = deleteFile;
      await deleteVendorEtcFile({
        variables: {
          id,
        },
      });
    }
  };

  const [updateVendor, updateVendorOpts] = useVendorUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.vendorUpdate.errors, commonMsg.savedChanges, () => {
        setHasChanged(false);
      }),
  });

  const handleSubmit = async (formData: VendorUpdateFormData) => {
    const filteredFormData = parseVendorCreateOrUpdateFormData(formData);
    if (checkValidVendorFormData(filteredFormData) === false) {
      return;
    }

    await createVendorEtcFiles(addFileList, addDescList);
    await updateVendorEtcFiles(updateDescList);
    await deleteVendorEtcFiles(deleteFileList);
    setAddFileList([]);
    setAddDescList([]);
    setUpdateDescList([]);
    setDeleteFileList([]);

    const input: VendorUpdateInput = { ...filteredFormData };
    const result = await updateVendor({ variables: { id, input } });
    return result.data.vendorUpdate.errors;
  };

  const updateBizRegImage = async (file) => {
    const result = await updateVendor({
      variables: {
        id,
        input: {
          bizRegImage: file,
        },
      },
    });
    return result.data.vendorUpdate.errors;
  };

  const updateAccountImage = async (file) => {
    const result = await updateVendor({
      variables: {
        id,
        input: {
          accountImage: file,
        },
      },
    });
    return result.data.vendorUpdate.errors;
  };

  const [vendorManageAddNote] = useVendorManageAddNoteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.vendorManageAddNote.errors, "협력사 관리 이력에 메모를 추가했습니다."),
  });

  if (loading) {
    return <Loader />;
  }
  if (utils.isEmpty(vendor)) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(vendorListViewUrl())} />;
  }

  return (
    <VendorDetailsPage
      disabled={loading}
      hasChanged={hasChanged}
      setHasChanged={setHasChanged}
      onBack={() => navigate(vendorListViewUrl())}
      onSubmit={handleSubmit}
      onBizRegImageUpload={(file) => updateBizRegImage(file)}
      onAccountImageUpload={(file) => updateAccountImage(file)}
      saveButtonBarState={updateVendorOpts.status}
      vendor={vendor}
      uploadFileController={{
        addFileList,
        addDescList,
        updateDescList,
        deleteFileList,
        // 기타 자료 수정 시, hasChanged를 true로 변경
        setAddFileList: (files) => {
          setAddFileList(files);
          setHasChanged(true);
        },
        setAddDescList: (descList) => {
          setAddDescList(descList);
          setHasChanged(true);
        },
        setUpdateDescList: (updateDescList) => {
          setUpdateDescList(updateDescList);
          setHasChanged(true);
        },
        setDeleteFileList: (deleteFileList) => {
          setDeleteFileList(deleteFileList);
          setHasChanged(true);
        },
      }}
      onNoteAdd={(variables) =>
        vendorManageAddNote({
          variables: {
            vendor: id,
            input: variables,
          },
        })
      }
    />
  );
};
</file>

