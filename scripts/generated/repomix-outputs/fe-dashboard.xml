<file path="src/app/views/question/components/FbvAcceptModal/FbvAcceptModal.tsx">
import { RefundQAQType } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { Button, Card, Col, Form, Image, Input, Modal, Radio, Row, Space, Tag, Typography } from "antd";
import React from "react";

import { RefundQuestionList_refundQuestions_edges_node } from "../../api/types/RefundQuestionList";
import { transformRefundReason } from "../CustomerRefundQuestionInspectTable/utils";
import { getRefundStatusTypeLabel, refundStatusTypeLabelColor } from "../RefundQuestionListTable/utils";

interface FbvAcceptModalProps {
  record: RefundQuestionList_refundQuestions_edges_node;
  open: boolean;
  loading: boolean;
  onClose?: () => void;
  onRefuse?: (record: RefundQuestionList_refundQuestions_edges_node, reason: string) => void;
  onSubmit?: (record: RefundQuestionList_refundQuestions_edges_node) => void;
}

const FbvAcceptModal: React.FC<FbvAcceptModalProps> = (props) => {
  const [form] = Form.useForm();
  const { record, open, onClose, onRefuse, onSubmit, loading } = props;

  const isApproveWatched = Form.useWatch("isApprove", form);

  const shop = useShop();
  const { refundTypeChoices, refundReasonChoices, refundStatusTypeChoices } = shop;
  const refundTypeChoice = refundTypeChoices.find((choice) => choice.value === record?.qType);
  const orderLineInfos = record?.qOrderLineInfo ? JSON.parse(record?.qOrderLineInfo) : [];
  const reasonText = transformRefundReason(refundReasonChoices, record?.qReasonType);
  orderLineInfos.forEach((orderLineInfo) => {
    const line = record?.order.lines.find((line) => line.id === orderLineInfo.order_line_id);
    orderLineInfo.productName = line?.productName;
    orderLineInfo.price = line?.unitPriceGrossAmount;
  });
  const getTotalPrice = () =>
    orderLineInfos.reduce((acc, cur) => {
      acc = acc + cur.price * cur.quantity;
      return acc;
    }, 0);

  if (record === null) {
    return <></>;
  }
  return (
    <Modal
      open={open}
      onCancel={onClose}
      title={<Typography.Title level={4}>문의내역 확인</Typography.Title>}
      okText="승인"
      cancelText="거부"
      footer={
        <Space>
          <Button
            type="primary"
            danger={!isApproveWatched}
            disabled={loading}
            onClick={() => {
              if (isApproveWatched) {
                // 승인
                onSubmit(record);
              } else {
                // 반려
                const reason = form.getFieldValue("aRefuseReason");
                onRefuse(record, reason);
              }
            }}
          >
            확정
          </Button>
          <Button onClick={onClose}>닫기</Button>
        </Space>
      }
      maskClosable={false}
    >
      <Form preserve={false} form={form} initialValues={{ isApprove: true }} layout="vertical">
        <Space direction="vertical">
          <Row justify="space-between">
            <Typography.Title level={5}>{refundTypeChoice?.label}</Typography.Title>
            <Tag color={refundStatusTypeLabelColor(record.status)}>
              {getRefundStatusTypeLabel(refundStatusTypeChoices, record.status)}
            </Tag>
          </Row>

          {refundTypeChoice?.value !== RefundQAQType.CANCEL && (
            <Card type="inner" title={<Typography.Title level={5}>신청 상품</Typography.Title>}>
              <TableVatLegend isIncludeVat={true} />
              {orderLineInfos
                ?.filter((item) => parseInt(item.quantity.toString(), 10) > 0)
                .map((orderLineInfo, idx) => (
                  <Row key={idx}>
                    <Col span={12}>
                      <Row>{orderLineInfo.productName}</Row>
                    </Col>
                    <Col span={4}>
                      <Row justify="end">
                        <NumberComponent value={orderLineInfo.quantity} postFix="개" />
                      </Row>
                    </Col>
                    <Col span={8}>
                      <Row justify="end">
                        <NumberComponent value={orderLineInfo.price * orderLineInfo.quantity} includeCurrency />
                      </Row>
                    </Col>
                  </Row>
                ))}
              <hr />
              <Row>
                <Col span={12}>
                  <Row justify="start">
                    <Typography.Text type="danger" strong>
                      최종 환불 금액
                    </Typography.Text>
                  </Row>
                </Col>
                <Col span={12}>
                  <Row justify="end">
                    <Typography.Text type="danger" strong>
                      <NumberComponent value={getTotalPrice()} includeCurrency />
                    </Typography.Text>
                  </Row>
                </Col>
              </Row>
            </Card>
          )}
          <Card type="inner" title={<Typography.Title level={5}>신청 사유</Typography.Title>}>
            <Typography.Text strong style={{ display: "block" }}>
              {reasonText}
            </Typography.Text>
            <Typography.Text strong style={{ display: "block" }}>
              {record.qReasonText}
            </Typography.Text>
          </Card>

          <Card type="inner" title={<Typography.Title level={5}>첨부 사진</Typography.Title>}>
            {record.images.length > 0 ? (
              <Row gutter={[5, 5]}>
                {record.images.map((item) => (
                  <Col span={8} key={item.id}>
                    <Image width={"100%"} src={item.url} />
                  </Col>
                ))}
              </Row>
            ) : (
              <Typography.Text>첨부 사진이 없습니다.</Typography.Text>
            )}
          </Card>

          <Card type="inner" title={<Typography.Title level={5}>승인/반려 여부</Typography.Title>}>
            <Form.Item name="isApprove" style={{ margin: 0 }}>
              <Radio.Group>
                <Radio value={true}>승인</Radio>
                <Radio value={false}>반려</Radio>
              </Radio.Group>
            </Form.Item>
          </Card>
          {isApproveWatched === false && (
            <Card type="inner" title={<Typography.Title level={5}>반려 사유</Typography.Title>}>
              <Form.Item name="aRefuseReason">
                <Input.TextArea rows={4} placeholder="거부사유를 작성해주세요." />
              </Form.Item>
            </Card>
          )}
        </Space>
      </Form>
    </Modal>
  );
};

export default FbvAcceptModal;
</file>

<file path="src/app/views/question/components/QuestionInspectStockAddTable/QuestionInspectStockAddTable.tsx">
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { FulfillmentRefundCancelStockUpInput, RefundQAStatus } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import TableListFooter from "@src/app/components/TableListFooter";
import { useInspectStockUpAndInspectCheckMutation } from "@src/app/views/order/orders/api/mutations";
import { PaginateListProps } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { notification, Table } from "antd";
import React from "react";

import {
  RefundQuestionList_refundQuestions_edges_node,
  RefundQuestionList_refundQuestions_edges_node_inspectList,
} from "../../api/types/RefundQuestionList";
import CustomerRefundQuestionStockAddCheckModal from "../CustomerRefundQuestionStockAddCheckModal/CustomerRefundQuestionStockAddCheckModal";
import RefundInspectStockAdd from "../RefundInspect/RefundInspectStockAdd";
import { getQuestionInspectStockAddTableColumns } from "./QuestionInspectStockAddTableSetting";
import { isInspect, isInspectStockAdd } from "./utils";

interface CustomerRefundQuestionInspectListProps extends PaginateListProps {
  onRowRefundBtnClick: ({ id, refundId }) => void;
  customerQuestions: RefundQuestionList_refundQuestions_edges_node[];
  questionStatusUpdate: (id: any, changeStatus: any) => void;
  questionQuestionCloseUpdate: (e) => void;
}

export interface inspectListData extends RefundQuestionList_refundQuestions_edges_node_inspectList {
  uniqueId: string;
  productName: string;
}

const QuestionInspectStockAddTable: React.FC<CustomerRefundQuestionInspectListProps> = (props) => {
  const {
    customerQuestions,
    onRowClick,
    onRowRefundBtnClick,
    questionStatusUpdate,
    questionQuestionCloseUpdate,
    ...listProps
  } = props;
  const initOpenList = customerQuestions?.reduce((acc, cur) => {
    const { status, productReturnedAt } = cur;
    if (isInspect(status, productReturnedAt)) {
      acc.push(cur.id);
    }
    return acc;
  }, []);

  const columns = getQuestionInspectStockAddTableColumns({
    onRowRefundBtnClick,
    onRowClick,
    listProps,
    questionQuestionCloseUpdate,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const [refundInspectId, setRefundInspectId] = React.useState<string>("");
  const [refundId, setRefundId] = React.useState<string>("");
  const [refundInspectStatus, setRefundInspectStatus] = React.useState<null | boolean>(null);
  const [modalInspectList, setModalInspectList] = React.useState<inspectListData[]>([]);
  const [inspectMemo, setInspectMemo] = React.useState<string>("");
  const [rackLocation, setRackLocation] = React.useState<string>("");
  const [isModalOpen, setIsModalOpen] = React.useState(false);

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  // NOTE: 검수 확인 Modal
  const showModal = (e) => {
    const target = e.currentTarget;
    const refundInspectId = target.dataset.id;
    const refundInspectStatus = target.dataset.status === "true" ? true : false;
    setRefundInspectId(refundInspectId);
    setRefundInspectStatus(refundInspectStatus);
    setIsModalOpen(true);
  };

  const modalCancel = () => {
    setIsModalOpen(false);
    setRefundInspectStatus(null);
    setInspectMemo("");
    setRefundId("");
  };

  // NOTE: 상품 개별적 검수 mutation
  const [onInspectStockUpAndLoss] = useInspectStockUpAndInspectCheckMutation({
    onCompleted: (data) => {
      if (data.inspectStockUpAndInspectCheckCombine.errors.length > 0) {
        showNotificationError("재고포함 중 오류가 발생하였습니다.");
        return;
      } else {
        showNotificationSuccess("재고포함 완료");
        setIsModalOpen(false);
        setRefundInspectStatus(null);
        return;
      }
    },
    onError: (_e) => {
      showNotificationError("재고포함 중 오류가 발생하였습니다.");
    },
  });

  // NOTE: 상품 개별적 검수 event
  const inspectBtnClick = () => {
    const findInspectIdx = modalInspectList.findIndex((item) => item.id === refundInspectId);
    const findInspectItem = modalInspectList[findInspectIdx];

    const fulfillment = findInspectItem.fulfillment;
    // NOTE: warehouseId가 null이면 위탁
    const cancelStockUpVariableObj: FulfillmentRefundCancelStockUpInput = {
      id: fulfillment.id,
      // input > inspectInput = false 인 경우는 로케이션 무관. 해당 컴포넌트는 고객 문의 관리 > 재고 재포함 요청(inspectInput = true) 페이지이기 때문에 로케이션 필수
      input: {
        warehouseId: fulfillment.lines[0].warehouse?.id,
        isRefund: true,
        rackLocation,
      },
    };

    onInspectStockUpAndLoss({
      variables: {
        id: refundId,
        input: {
          fulfillmentCancellation: cancelStockUpVariableObj,
          refundInspectId,
          inspectInput: {
            inspect: refundInspectStatus,
            memo: inspectMemo,
          },
        },
      },
    });
  };

  // NOTE: 해당 문의건 최종 검수 확인 event
  const finalInspectBtnClick = (inspectList: inspectListData[], refundQuestionId: string) => {
    const noInspectList = inspectList.filter((item) => item.inspect === null);

    if (noInspectList.length > 0) {
      notification.error({
        message:
          "검수하지 않는 상품이 존재합니다. 모든 상품에 대해서 검수를 마친 후 '최종 재고 포함 확인 후 문의처리 완료' 버튼을 클릭해주시기 바랍니다.",
      });
      return;
    }

    questionStatusUpdate(refundQuestionId, RefundQAStatus.QUESTION_CLOSE);
  };

  return (
    <>
      <Table
        {...commonTableProps}
        ref={tableRef}
        loading={listProps.disabled}
        dataSource={customerQuestions}
        columns={columns}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        expandable={{
          expandedRowRender: (record: RefundQuestionList_refundQuestions_edges_node) => {
            const refundQuestionId = record.id;
            let productName = "";
            const isInspectStockAdds = isInspectStockAdd(record);
            const customInspectList: inspectListData[] = record.inspectList.map((item) => {
              const fulfillmentPk = atob(item.fulfillment.id).split(":")[1];

              const findOrderLineId = record.order.fulfillments.filter(
                (fulfillmentsItem) => fulfillmentsItem.id === item.fulfillment.id
              );

              if (findOrderLineId.length === 0) {
                productName = "";
              } else {
                const orderLineId = findOrderLineId[0].lines[0].orderLineId;
                const findOrderLine = record.order.lines.filter((orderLinesItem) => orderLinesItem.id === orderLineId);

                if (findOrderLine.length > 0) {
                  productName = findOrderLine[0].productName;
                }
              }

              return {
                ...item,
                uniqueId: `${item.fulfillment.composedIdWithPrefix}:${fulfillmentPk}`,
                productName,
              };
            });

            return (
              <RefundInspectStockAdd
                refundQuestionId={refundQuestionId}
                inspectList={customInspectList}
                isInspectStockAdd={isInspectStockAdds}
                inspectBtnClick={(e, memo, rackLocation) => {
                  setRefundId(refundQuestionId);
                  showModal(e);
                  setModalInspectList(customInspectList);
                  setInspectMemo(memo);
                  setRackLocation(rackLocation);
                }}
                finalInspectBtnClick={finalInspectBtnClick}
              />
            );
          },
          defaultExpandedRowKeys: initOpenList,
        }}
        footer={() => <TableListFooter {...listProps} />}
      />
      {refundInspectStatus !== null && (
        <CustomerRefundQuestionStockAddCheckModal
          isModalOpen={isModalOpen}
          inspectBtnClick={inspectBtnClick}
          modalCancel={modalCancel}
        />
      )}
    </>
  );
};

export default QuestionInspectStockAddTable;
</file>

