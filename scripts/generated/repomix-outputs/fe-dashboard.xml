import { OrderLineB2bStatusEnum, OrderTypeEnum, SalesB2bStatusEnum } from "@src/api/types/globalTypes";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import moment from "moment";

import { HqB2bOrderListViewStatusType, HqB2bSettlementListViewRouteParams } from "../hqStaff/hqB2b/urls";
import { OrderLineListViewUrlQueryParams } from "../order/orders/urls";
import {
  B2bOrderLineListViewRouteParams,
  B2bOrderLineListViewStatusType,
  B2bSalesStatByBrandListViewUrlQueryParams,
  B2bSalesStatListViewUrlQueryParams,
  B2bSettlementForSalesViewUrlQueryParams,
  B2bSettlementListViewRouteParams,
} from "./urls";

export const SalesB2bStatusChoices = [
  { label: "대기", value: SalesB2bStatusEnum.STANDBY },
  { label: "발송대기", value: SalesB2bStatusEnum.BEFORE_SEND },
  { label: "검토", value: SalesB2bStatusEnum.PENDING },
  { label: "수정 요청", value: SalesB2bStatusEnum.REQ_REVISION },
  { label: "수정", value: SalesB2bStatusEnum.REVISION },
  { label: "마감", value: SalesB2bStatusEnum.CLOSED },
];

export const getSalesB2bStatusText = (status: SalesB2bStatusEnum) => {
  const choice = SalesB2bStatusChoices.find((choice) => choice.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

const getDefaultOrderLineB2bStatusListForB2bOrderLineList = (
  status: B2bOrderLineListViewStatusType | HqB2bOrderListViewStatusType
): OrderLineB2bStatusEnum[] => {
  let b2bStatus: OrderLineB2bStatusEnum[];
  switch (status) {
    case "all":
      b2bStatus = [
        OrderLineB2bStatusEnum.PENDING,
        OrderLineB2bStatusEnum.REJECTED,
        OrderLineB2bStatusEnum.RECEIVED,
        OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT,
        OrderLineB2bStatusEnum.COMPLETED,
        OrderLineB2bStatusEnum.CANCELED,
      ];
      break;
    case "accept":
    case "pending-or-rejected":
      b2bStatus = [OrderLineB2bStatusEnum.PENDING, OrderLineB2bStatusEnum.REJECTED];
      break;
    case "accepted":
      b2bStatus = [OrderLineB2bStatusEnum.RECEIVED];
      break;
    case "processing":
    case "delivery":
      b2bStatus = [OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT];
      break;
    case "completed":
      b2bStatus = [OrderLineB2bStatusEnum.COMPLETED];
      break;
  }
  return b2bStatus;
};

export const getB2bOrderLineListDefaultParams = (
  routeParams: B2bOrderLineListViewRouteParams
): OrderLineListViewUrlQueryParams => ({
  orderType: [OrderTypeEnum.BY_STAFF_FOR_B2B, OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK],
  b2bStatus: getDefaultOrderLineB2bStatusListForB2bOrderLineList(routeParams.status),
});

// closing-statement, pending 에서 공통으로 사용
export const getB2bSalesStatListDefaultParams = (
  routeParams: B2bSettlementListViewRouteParams | HqB2bSettlementListViewRouteParams
): B2bSalesStatListViewUrlQueryParams => {
  const { status } = routeParams;
  const todayMoment = moment();
  const thisMonth = moment().format(onlyMonthFormat);
  const lastMonth = moment().subtract(1, "month").format(onlyMonthFormat);
  const defaultSalesCloseMonth = status === "closing-statement" && todayMoment.date() <= 10 ? lastMonth : thisMonth;

  return {
    salesCloseMonth: defaultSalesCloseMonth,
  };
};

export const getDefaultSalesB2bStatusListForB2bSettlementList = (
  routeParams: B2bSettlementListViewRouteParams
): SalesB2bStatusEnum[] => {
  const { status } = routeParams;

  let b2bStatus: SalesB2bStatusEnum[];
  switch (status) {
    case "in-progress":
      // 매출 정산 - 대기상태만
      b2bStatus = [SalesB2bStatusEnum.STANDBY];
      break;
    case "edit-request":
      // 수정 요청 - 수정 요청, 수정만
      b2bStatus = [SalesB2bStatusEnum.REQ_REVISION, SalesB2bStatusEnum.REVISION];
      break;
    case "pending":
      // 대행 매출 확정
      b2bStatus = [SalesB2bStatusEnum.PENDING];
      break;
    case "closed":
      // 매출 마감
      b2bStatus = [SalesB2bStatusEnum.CLOSED];
      break;
    case "all":
      // 전체 정산 내역
      b2bStatus = Object.values(SalesB2bStatusEnum);
      break;
  }

  return b2bStatus;
};

export const getB2bSettlementListDefaultParams = (
  routeParams: B2bSettlementListViewRouteParams
): B2bSettlementForSalesViewUrlQueryParams => ({
  b2bStatus: getDefaultSalesB2bStatusListForB2bSettlementList(routeParams),
});

export const getB2bSalesStatByBrandListDefaultParams = (): B2bSalesStatByBrandListViewUrlQueryParams => {
  const thisMonth = moment().format(onlyMonthFormat);

  return {
    statDateMonth: thisMonth,
  };
};
</file>

