import { UseSearchResult } from "@hooks/makeSearch";
import { SearchCategories, SearchCategoriesVariables } from "@src/api/searches/types/SearchCategories";
import { DirectlyAssignedAttributeInput, ProductVariantFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { AttributeSlugEnum } from "@src/app/views/product/products/utils/data";
import { dedupeFilter, getMultipleValueQueryParam, getSingleValueQueryParam } from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { InitialProductVariantForReqFilterData_categories_edges_node } from "../../api/types/InitialProductVariantForReqFilterData";
import {
  ProductVariantListForReqFilterKeys,
  ProductVariantListForReqFilterOpts,
} from "../../components/ProductVariantListForReqPage/filters";
import {
  ProductVariantListForReqViewUrlFilters,
  ProductVariantListForReqViewUrlFiltersEnum,
  ProductVariantListForReqViewUrlFiltersWithMultipleValues,
} from "../../urls";

export function getFilterOpts(
  params: ProductVariantListForReqViewUrlFilters,
  categories: {
    initial: InitialProductVariantForReqFilterData_categories_edges_node[];
    search: UseSearchResult<SearchCategories, SearchCategoriesVariables>;
  }
): ProductVariantListForReqFilterOpts {
  const filterVariables = getFilterVariables(params);
  const attrSizeSearchVariable = filterVariables.daAttributes?.find((attr) => attr.slug === AttributeSlugEnum.size);
  const attrMaterialSearchVariable = filterVariables.daAttributes?.find(
    (attr) => attr.slug === AttributeSlugEnum.material
  );
  const attrColorSearchVariable = filterVariables.daAttributes?.find((attr) => attr.slug === AttributeSlugEnum.color);

  return {
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
    makerSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.makerSearch, true), false),
      value: filterVariables.makerSearch || "",
    },
    categories: {
      active: maybe(() => !utils.isEmpty(filterVariables.categories), false),
      choices: maybe(
        () =>
          categories.search.result.data.search.edges.map((edge) => ({
            label: edge.node.name,
            value: edge.node.id,
          })),
        []
      ),
      displayValues: maybe(() => !utils.isEmpty(filterVariables.categories), false)
        ? maybe(
            () =>
              categories.initial.map((category) => ({
                label: category.name,
                value: category.id,
              })),
            []
          )
        : [],
      hasMore: maybe(() => categories.search.result.data.search.pageInfo.hasNextPage, false),
      initialSearch: "",
      loading: categories.search.result.loading,
      onFetchMore: categories.search.loadMore,
      onSearchChange: categories.search.search,
      value: maybe(() => dedupeFilter(filterVariables.categories), []),
    },
    attrSizeSearch: {
      active: maybe(() => !utils.isEmpty(attrSizeSearchVariable?.value, true), false),
      value: attrSizeSearchVariable?.value || "",
    },
    attrMaterialSearch: {
      active: maybe(() => !utils.isEmpty(attrMaterialSearchVariable?.value, true), false),
      value: attrMaterialSearchVariable?.value || "",
    },
    attrColorSearch: {
      active: maybe(() => !utils.isEmpty(attrColorSearchVariable?.value, true), false),
      value: attrColorSearchVariable?.value || "",
    },
  };
}

export function getFilterVariables(params: ProductVariantListForReqViewUrlFilters): ProductVariantFilterInput {
  const daAttributes: DirectlyAssignedAttributeInput[] = [];
  if (utils.isEmpty(params.attrSizeSearch, true) === false) {
    daAttributes.push({ slug: AttributeSlugEnum.size, value: params.attrSizeSearch });
  }
  if (utils.isEmpty(params.attrMaterialSearch, true) === false) {
    daAttributes.push({ slug: AttributeSlugEnum.material, value: params.attrMaterialSearch });
  }
  if (utils.isEmpty(params.attrColorSearch, true) === false) {
    daAttributes.push({ slug: AttributeSlugEnum.color, value: params.attrColorSearch });
  }

  return {
    productSearch: params.productSearch,
    makerSearch: params.makerSearch,
    categories: params.categories || [],
    daAttributes,
    excludeForReqBossProduct: true,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof ProductVariantListForReqFilterOpts>
): ProductVariantListForReqViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case ProductVariantListForReqFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersEnum.productSearch);
    case ProductVariantListForReqFilterKeys.makerSearch:
      return getSingleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersEnum.makerSearch);
    case ProductVariantListForReqFilterKeys.categories:
      return getMultipleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersWithMultipleValues.categories);
    case ProductVariantListForReqFilterKeys.attrSizeSearch:
      return getSingleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersEnum.attrSizeSearch);
    case ProductVariantListForReqFilterKeys.attrMaterialSearch:
      return getSingleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersEnum.attrMaterialSearch);
    case ProductVariantListForReqFilterKeys.attrColorSearch:
      return getSingleValueQueryParam(filter, ProductVariantListForReqViewUrlFiltersEnum.attrColorSearch);
  }
}
</file>

<file path="src/app/views/requestProduct/views/ProductVariantListForReqView/ProductVariantListForReqView.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import { ListViews } from "@src/global/core/types/types";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useRequestBossProductEstimateCreateByProductVariantMutation } from "../../api/mutations";
import {
  useInitialProductVariantForReqFilterDataQuery,
  useProductVariantDetailsForReqQuery,
  useProductVariantListForReqQuery,
  useRequestBossProductDetailsQuery,
} from "../../api/queries";
import { ProductVariantListForReqVariables } from "../../api/types/ProductVariantListForReq";
import { ProductVariantListForReqPage } from "../../components/ProductVariantListForReqPage/ProductVariantListForReqPage";
import { ReqBossProductEstimateCreateByVariantModal } from "../../components/ReqBossProductEstimateCreateByVariantModal";
import {
  productVariantListForReqViewUrl,
  ProductVariantListForReqViewUrlDialog,
  ProductVariantListForReqViewUrlQueryParams,
  reqBossProductDetailsViewUrl,
} from "../../urls";
import { getFilterQueryParam, getFilterVariables } from "./filters";

interface ProductVariantListForReqViewProps {
  requestId: string;
  params: ProductVariantListForReqViewUrlQueryParams;
}

export const ProductVariantListForReqView: React.FC<ProductVariantListForReqViewProps> = ({ requestId, params }) => {
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PRODUCT_VARIANT_LIST_FOR_REQ,
  });
  const handleBack = () => navigate(reqBossProductDetailsViewUrl(requestId));

  const queryVariables: ProductVariantListForReqVariables = React.useMemo(
    () => ({ ...paginationState, filter: { ...getFilterVariables(params) } }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useProductVariantListForReqQuery({ variables: queryVariables });
  const productVariantsForReq = maybe(() => data.productVariants.edges.map((edge) => edge.node), []);
  const productVariantsForReqPageInfo = maybe(() => data.productVariants.pageInfo, null);

  const { data: requestBossProductData, loading: requestBossProductLoading } = useRequestBossProductDetailsQuery({
    variables: { id: requestId, skipEstimate: true },
  });
  const requestBossProduct = maybe(() => requestBossProductData.requestBossProduct, null);

  const { data: productVariantDetailsData, loading: productVariantDetailsLoading } =
    useProductVariantDetailsForReqQuery({
      skip: !(params.action === "create-estimate-by-product-variant" && params.id),
      variables: { id: params.id },
    });
  const productVariantDetails = maybe(() => productVariantDetailsData.productVariant, null);

  const { data: initialFilterData } = useInitialProductVariantForReqFilterDataQuery({
    variables: { categories: params.categories },
  });
  const initialFilterCategories = maybe(() => initialFilterData.categories.edges.map((edge) => edge.node), []);
  const searchCategories = useCategorySearch({ variables: { ...DEFAULT_INITIAL_SEARCH_DATA } });

  const [requestBossProductEstimateCreateByProductVariant, requestBossProductEstimateCreateByProductVariantOpts] =
    useRequestBossProductEstimateCreateByProductVariantMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductEstimateCreateByProductVariant.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 상품 정보로 기등록이 완료되었습니다.");
          navigate(reqBossProductDetailsViewUrl(requestId));
        } else {
          showGqlErrors(errors);
        }
      },
    });

  const handleCreateEstimateByProductVariant = () => {
    if (utils.isEmpty(requestBossProduct)) {
      showNotificationError("요청 정보를 찾을 수 없습니다. 새로고침 후 다시 시도해주세요.");
      return;
    }
    if (utils.isEmpty(productVariantDetails)) {
      showNotificationError("선택한 상품 정보를 찾을 수 없습니다. 새로고침 후 다시 시도해주세요.");
      return;
    }
    requestBossProductEstimateCreateByProductVariant({
      variables: { input: { request: requestBossProduct.id, variant: productVariantDetails.id } },
    });
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: productVariantsForReqPageInfo,
    paginationState,
    params,
  });

  const targetUrl = (params: ProductVariantListForReqViewUrlQueryParams) =>
    productVariantListForReqViewUrl(requestId, params);

  const [openModal, closeModal] = createDialogActionHandlers<
    ProductVariantListForReqViewUrlDialog,
    ProductVariantListForReqViewUrlQueryParams
  >(navigate, targetUrl, params);

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: targetUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: refetch,
  });

  const pageLoading =
    loading ||
    requestBossProductLoading ||
    productVariantDetailsLoading ||
    requestBossProductEstimateCreateByProductVariantOpts.loading;

  return (
    <>
      <ProductVariantListForReqPage
        params={params}
        settings={settings}
        disabled={pageLoading}
        loading={pageLoading}
        productVariants={productVariantsForReq}
        onUpdateListSettings={updateListSettings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        categoriesForFilter={{ initial: initialFilterCategories, search: searchCategories }}
        onFilterChange={changeFilters}
        onFilterReset={resetFilters}
        onRowClick={(variantId) => openModal("create-estimate-by-product-variant", { id: variantId })}
        onBack={handleBack}
        pageInfo={pageInfo}
      />

      <ReqBossProductEstimateCreateByVariantModal
        open={params.action === "create-estimate-by-product-variant"}
        request={requestBossProduct}
        productVariant={productVariantDetails}
        onSubmit={handleCreateEstimateByProductVariant}
        onClose={closeModal}
      />
    </>
  );
};
</file>

