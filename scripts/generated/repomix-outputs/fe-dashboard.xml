import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import CardSpacer from "@src/app/components/CardSpacer";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import {
  useFulfillmentBulkTrackingCompletedMutation,
  useFulfillmentUpdateTrackingMutation,
} from "@src/app/views/order/orders/api/mutations";
import { useCourierListQuery } from "@src/app/views/settings/couriers/api/queries";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Col, Row, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useState } from "react";

import { useFulfillmentBulkUpdateForFbvMutation } from "../../api/mutations";
import {
  fbvOrderLineCountQuery,
  fulfillmentListQuery,
  useFulfillmentListFilterDownloadQuery,
  useFulfillmentListQuery,
} from "../../api/queries";
import { FulfillmentList_fulfillments_edges_node, FulfillmentListVariables } from "../../api/types/FulfillmentList";
import FbvOrderDeliveryListPage from "../../components/FbvOrderDeliveryListPage/FbvOrderDeliveryListPage";
import { FbvOrderFulfillmentChangeDeliveryMethodModal } from "../../components/FbvOrderFulfillmentChangeDeliveryMethodModal/FbvOrderFulfillmentChangeDeliveryMethodModal";
import { FbvOrderFulfillmentCompleteTrackingModal } from "../../components/FbvOrderFulfillmentCompleteTrackingModal/FbvOrderFulfillmentCompleteTrackingModal";
import OrderDeliveryMultipleConfirmModal from "../../components/OrderDeliveryMultipleConfirmModal/OrderDeliveryMultipleConfirmModal";
import {
  fbvOrderDeliveryListViewUrl,
  FbvOrderDeliveryListViewUrlDialog,
  FbvOrderDeliveryListViewUrlQueryParams,
  FbvOrderDeliveryUrlEnum,
  orderDetailsViewUrl,
} from "../../urls";
import { FbvOrderDeliveryBulkUpdateExtra } from "./FbvOrderDeliveryBulkUpdateExtra";
import { FbvOrderDeliveryListViewExcel } from "./FbvOrderDeliveryListViewExcel";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariablesByUrlTypeState,
  saveFilterTab,
} from "./filters";

interface FbvOrderDeliveryListViewProps {
  params: FbvOrderDeliveryListViewUrlQueryParams;
  urlTypeState: UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>;
  vendorStaffVendorId: string;
}

export interface SelectVendorInfo {
  label?: string;
  id?: string;
  code?: string;
  name?: string;
}

export enum FbvOrderDeliveryModalModeEnum {
  ChangeDeliveryMethod = "ChangeDeliveryMethod",
  CompleteTracking = "CompleteTracking",
  UpdateDeliveryMultipleConfirm = "UpdateDeliveryMultipleConfirm",
}

const FbvOrderDeliveryListView: React.FC<FbvOrderDeliveryListViewProps> = ({
  params,
  urlTypeState,
  vendorStaffVendorId,
}) => {
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[] | string[]>([]);
  const targetUrl = fbvOrderDeliveryListViewUrl(urlTypeState.path);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.FBV_ORDER_DELIVERY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useFulfillmentListFilterDownloadQuery);

  const { user } = useUser();
  const { isStaff, isVendorStaff } = user;

  const [modalMode, setModalMode] = useState(null);
  const [idForModal, setIdForModal] = useState(null);

  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: FbvOrderDeliveryModalModeEnum, idForModal?: string) => {
    setModalMode(modalMode);
    if (idForModal) {
      setIdForModal(idForModal);
    }
  };
  const onModalOpenForIds = (mode: FbvOrderDeliveryModalModeEnum, rowIds: string[]) => {
    setModalMode(mode);
    setSelectedRowKeys(rowIds);
  };
  const onModalClose = () => {
    setSelectedRowKeys([]);
    resetForCloseModal();
  };

  const queryVariables = React.useMemo<FulfillmentListVariables>(() => {
    const filterVariables = getFilterVariablesByUrlTypeState({
      urlTypeState,
      params,
    });

    return {
      ...paginationState,
      filter: { ...filterVariables, isFulfilledByVendor: true, fulfillVendorId: vendorStaffVendorId },
      forStaffOrderDelivery: isStaff,
      forFbvOrderDelivery: !isStaff,
    };
  }, [params, settings?.rowNumber]);
  const {
    data: fulfillmentsData,
    loading,
    refetch: fulfillmentListRefetch,
  } = useFulfillmentListQuery({ skip: utils.isEmpty(vendorStaffVendorId), variables: queryVariables });

  const { data: courierData } = useCourierListQuery({
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.couriers,
      filter: { isActive: true },
    },
  });
  const couriers = maybe(() => courierData.couriers.edges.map((edge) => edge.node), []);

  const [fulfillmentBulkUpdateForFbvMutation, fulfillmentBulkUpdateForFbvOpts] = useFulfillmentBulkUpdateForFbvMutation(
    {
      onCompleted: async (res) => {
        if (res.fulfillmentBulkUpdateForFbv.errors.length > 0) {
          showNotificationError("배송정보 일괄 등록중 에러가 발생하였습니다. 고객센터로 문의해 주세요.");
        } else {
          showNotificationSuccess("배송정보 일괄 등록이 완료되었습니다.");
          resetForCloseModal();
        }
      },
      onError: () => showNotificationError("배송정보 일괄 등록중 에러가 발생하였습니다. 고객센터로 문의해 주세요."),
      refetchQueries: [fulfillmentListQuery, fbvOrderLineCountQuery],
    }
  );

  const [fulfillmentUpdateTrackingMutation, fulfillmentUpdateTrackingOpts] = useFulfillmentUpdateTrackingMutation({
    onCompleted: async (res) => {
      if (res.fulfillmentUpdateTracking.errors.length > 0) {
        showNotificationError("배송완료중 에러가 발생하였습니다. 고객센터로 문의해 주세요.");
      } else {
        showNotificationSuccess("배송완료가 완료되었습니다.");
        resetForCloseModal();
      }
    },
    refetchQueries: [fulfillmentListQuery, fbvOrderLineCountQuery],
  });

  const [fulfillmentBulkTrackingCompleted, fulfillmentBulkTrackingCompletedOpts] =
    useFulfillmentBulkTrackingCompletedMutation({
      onCompleted: (data) => {
        const errors = data?.fulfillmentBulkTrackingCompleted?.errors;
        if (errors?.length !== 0) {
          showGqlErrors(errors);
        } else {
          const successCount = data?.fulfillmentBulkTrackingCompleted?.count;
          showNotificationSuccess(`배송완료 처리가 완료되었습니다. (${successCount}건)`);
          setSelectedRowKeys([]);
        }
      },
      refetchQueries: [fulfillmentListQuery, fbvOrderLineCountQuery],
    });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: fulfillmentsData?.fulfillments?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<FbvOrderDeliveryListViewUrlDialog, FbvOrderDeliveryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch: () => {
      fulfillmentListRefetch();
    },
  });

  const pageTitle =
    urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.FULFILLED
      ? sectionNames.fbvOrderDeliveryFulfilled
      : urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_A
      ? sectionNames.fbvOrderDeliveryTrackingA
      : urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.COMPLETED_A
      ? sectionNames.fbvOrderDeliveryCompletedA
      : urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_B
      ? sectionNames.fbvOrderDeliveryTrackingB
      : urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.COMPLETED_B
      ? sectionNames.fbvOrderDeliveryCompletedB
      : sectionNames.fbvOrderDeliveryUnfulfilled;
  const pageLoading =
    loading ||
    fulfillmentBulkUpdateForFbvOpts.loading ||
    fulfillmentUpdateTrackingOpts.loading ||
    fulfillmentBulkTrackingCompletedOpts.loading;

  const fulfillment = fulfillmentsData?.fulfillments.edges?.find((fulfillment) => fulfillment?.node.id === idForModal);

  const rowSelection: TableRowSelection<FulfillmentList_fulfillments_edges_node> = {
    selectedRowKeys,
    onChange: (selectedRowKeys) => {
      setSelectedRowKeys(selectedRowKeys);
    },
    fixed: true,
  };

  const fulfillmentList = maybe(() => fulfillmentsData?.fulfillments?.edges.map((item) => item.node), []);

  return (
    <>
      <Row justify="space-between" gutter={[12, 12]}>
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
        {urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.FULFILLED && (
          <>
            <FbvOrderDeliveryListViewExcel
              isStaff={isStaff}
              vendorStaffVendorId={vendorStaffVendorId}
              queryVariables={queryVariables}
              refetchForPrintFulfillmentAllList={fetchForDownload}
              fulfillmentBulkUpdateForFbvMutation={fulfillmentBulkUpdateForFbvMutation}
              couriers={couriers}
              fulfillmentsData={fulfillmentsData}
              fulfillmentListRefetch={fulfillmentListRefetch}
              selectedRowKeys={selectedRowKeys as string[]}
              onDeliveryMultipleConfirm={() =>
                onModalOpenForIds(
                  FbvOrderDeliveryModalModeEnum.UpdateDeliveryMultipleConfirm,
                  selectedRowKeys as string[]
                )
              }
            />
          </>
        )}
        {(urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_A ||
          urlTypeState.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_B) && (
          <>
            <FbvOrderDeliveryBulkUpdateExtra
              selectedRowKeys={selectedRowKeys as string[]}
              fulfillmentBulkTrackingCompleted={fulfillmentBulkTrackingCompleted}
              loading={pageLoading}
            />
          </>
        )}
      </Row>
      <CardSpacer />
      <FbvOrderDeliveryListPage
        settings={settings}
        params={params}
        urlType={urlTypeState}
        isStaff={isStaff}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        disabled={pageLoading}
        fulfillmentsData={fulfillmentList}
        onChangeDeliveryMethod={(id: string) =>
          openModalWithoutNavigate(FbvOrderDeliveryModalModeEnum.ChangeDeliveryMethod, id)
        }
        onCompleteTracking={(id: string) =>
          openModalWithoutNavigate(FbvOrderDeliveryModalModeEnum.CompleteTracking, id)
        }
        validateQueryClick={() => {
          if (isStaff && utils.isEmpty(vendorStaffVendorId)) {
            showNotificationError("협력사를 선택해주세요.");
            return false;
          }
          return true;
        }}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        isVendorStaff={isVendorStaff}
        rowSelection={rowSelection}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <FbvOrderFulfillmentChangeDeliveryMethodModal
        couriers={couriers}
        open={!!idForModal && modalMode === FbvOrderDeliveryModalModeEnum.ChangeDeliveryMethod}
        fulfillment={fulfillment?.node}
        loading={pageLoading}
        onClose={resetForCloseModal}
        onSubmit={(formData) => fulfillmentBulkUpdateForFbvMutation({ variables: { input: { details: [formData] } } })}
        urlType={urlTypeState.urlEnum}
      />
      <FbvOrderFulfillmentCompleteTrackingModal
        open={!!idForModal && modalMode === FbvOrderDeliveryModalModeEnum.CompleteTracking}
        loading={pageLoading}
        onSubmit={() =>
          fulfillmentUpdateTrackingMutation({
            variables: { id: idForModal, input: { isTrackingCompleted: true }, isPoLineDeliveryConfirmed: false },
          })
        }
        onClose={resetForCloseModal}
      />
      <OrderDeliveryMultipleConfirmModal
        open={modalMode === FbvOrderDeliveryModalModeEnum.UpdateDeliveryMultipleConfirm}
        onClose={onModalClose}
        isByNonCourier={false}
        isB2b={false}
        isFbv={true}
        title="배송정보 일괄등록(수동)"
        selectedFulfillmentIds={selectedRowKeys as string[]}
        fulfillmentList={fulfillmentList}
        courierList={couriers}
        fulfillmentBulkUpdateForFbvMutation={fulfillmentBulkUpdateForFbvMutation}
      />
    </>
  );
};

export default FbvOrderDeliveryListView;
</file>

