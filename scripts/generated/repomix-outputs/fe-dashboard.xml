import useSearchQuery from "@hooks/useSearchQuery";
import { SearchBrands_search_edges_node } from "@src/api/searches/types/SearchBrands";
import { getBrandContractTypeText, getBrandDeliveryFeeTypeText } from "@src/app/views/brand/brands/utils";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Input, Modal, Row, Space, Table, Typography } from "antd";
import { RowSelectionType } from "antd/es/table/interface";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { commonTableProps } from "../antd/Table/TableProps";
import { columnNameConstant } from "../ColumnHelper/columnConstant";

export interface AssignProductDialogProps extends FetchMoreProps {
  open: boolean;
  brands: SearchBrands_search_edges_node[];
  loading: boolean;
  rowSelectionType: RowSelectionType;
  onClose: () => void;
  onFetch: (value: string) => void;
  onSubmit: (data: SearchBrands_search_edges_node[]) => void;
}

const AssignBrandDialog: React.FC<AssignProductDialogProps> = (props) => {
  const {
    open,
    loading,
    brands = [],
    rowSelectionType = "checkbox",
    hasMore,
    onClose,
    onFetch,
    onFetchMore,
    onSubmit,
  } = props;
  const [query, onQueryChange] = useSearchQuery(onFetch);
  const [selectedBrands, setSelectedBrands] = useState<SearchBrands_search_edges_node[]>([]);
  const [dataSource, setDataSource] = useState<SearchBrands_search_edges_node[]>([]);

  const handleSubmit = () => {
    onSubmit(selectedBrands);
    handleClose();
  };

  const handleClose = () => {
    onQueryChange({ target: { name: "query", value: "" } });
    setSelectedBrands([]);
    onClose();
  };

  useEffect(() => {
    // 선택된 브랜드가 있을 경우 선택된 브랜드를 dataSource에 추가하고, brands에서 제거하여 dataSource로 보여준다.
    const brandsExceptSelected = brands.filter((brand) => !selectedBrands.some((selected) => selected.id === brand.id));
    setDataSource([...selectedBrands, ...brandsExceptSelected]);
  }, [loading, selectedBrands]);

  const columns: ColumnsType<SearchBrands_search_edges_node> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "code",
      align: "center",
      width: 120,
      render: (_, record) => maybe(() => record?.code, ""),
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "name",
      align: "center",
      width: 200,
      render: (_, record) => maybe(() => record?.name, ""),
    },
    {
      title: columnNameConstant.brand.CONTRACT_TYPE,
      key: "contractType",
      align: "center",
      width: 120,
      render: (_, record) => maybe(() => getBrandContractTypeText(record?.contractType), ""),
    },
    {
      title: "배송비 방식",
      key: "deliveryFeeType",
      align: "center",
      width: 130,
      render: (_, record) => maybe(() => getBrandDeliveryFeeTypeText(record?.deliveryFeeType), ""),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<SearchBrands_search_edges_node> = {
    fixed: true,
    type: rowSelectionType,
    selectedRowKeys: selectedBrands.map((selected) => selected.id),
    onChange: (_selectedRowKeys, selectedRows) => setSelectedBrands(selectedRows),
  };

  const submitBtnDisabled = loading || selectedBrands.length === 0;
  const modalFooter = (
    <Space>
      <Button type="default" onClick={handleClose}>
        뒤로
      </Button>
      <Button type="primary" disabled={submitBtnDisabled} onClick={handleSubmit}>
        추가
      </Button>
    </Space>
  );

  return (
    <Modal
      destroyOnClose
      title="브랜드 추가"
      open={open}
      onCancel={handleClose}
      footer={modalFooter}
      width={750}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Input.Search
          size="large"
          name="query"
          value={query}
          onChange={onQueryChange}
          placeholder="브랜드 검색"
          loading={loading}
        />
        <Table
          {...commonTableProps}
          loading={loading}
          columns={columns}
          dataSource={dataSource}
          rowSelection={rowSelection}
          scroll={{ x: tableWidthSum, y: 500 }}
          footer={
            hasMore &&
            (() => (
              <Row justify="center">
                <Typography.Link onClick={onFetchMore}>더 보기</Typography.Link>
              </Row>
            ))
          }
        />
      </Space>
    </Modal>
  );
};
export default AssignBrandDialog;
</file>

