<file path="src/app/views/stats/components/SalesStatByProductListPage/filters.ts">
import { SalesStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import {
  ProductCategoryKind,
  productCategoryKindChoicesForSalesStatFilter,
} from "@src/app/views/stats/utils/categoryKindMapper";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum SalesStatByProductFilterKeys {
  statDate = "statDate",
  brandSearch = "brandSearch",
  vendorSearch = "vendorSearch",
  productSearch = "productSearch",
  categoryKind = "categoryKind",
  salesStatus = "salesStatus",
  isExclusive = "isExclusive",
  trackInventory = "trackInventory",
  isInner = "isInner",
}

export interface SalesStatByProductListFilterOpts {
  statDate: FilterOpts<MinMax>;
  brandSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  categoryKind: FilterOpts<ProductCategoryKind[]>;
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  isExclusive: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
}

export function createFilterStructure(opts: SalesStatByProductListFilterOpts): IFilter<SalesStatByProductFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createMonthField(
        displayOrder++,
        SalesStatByProductFilterKeys.statDate,
        filterNameConstant.STAT_DATE,
        opts.statDate.value
      ),
      active: opts.statDate.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductFilterKeys.vendorSearch,
        filterNameConstant.VENDOR_SEARCH,
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductFilterKeys.categoryKind,
        "제품 구분",
        opts.categoryKind.value,
        true,
        productCategoryKindChoicesForSalesStatFilter
      ),
      active: opts.categoryKind.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductFilterKeys.salesStatus,
        "제품 상태",
        opts.salesStatus.value,
        true,
        [
          { label: "판매대기", value: SalesStatusEnum.PENDING },
          { label: "정상", value: SalesStatusEnum.ON_SALE },
          { label: "단종예정", value: SalesStatusEnum.WILL_BE_STOPPED },
          { label: "단종", value: SalesStatusEnum.STOPPED },
        ]
      ),
      active: opts.salesStatus.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductFilterKeys.isExclusive,
        "전용여부",
        opts.isExclusive.value,
        {
          negative: "범용",
          positive: "전용",
        }
      ),
      active: opts.isExclusive.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductFilterKeys.trackInventory,
        "재고운영여부",
        opts.trackInventory.value,
        {
          negative: "미운영",
          positive: "운영",
        }
      ),
      active: opts.trackInventory.active,
    },
    {
      ...createBooleanField(displayOrder++, SalesStatByProductFilterKeys.isInner, "제품형태", opts.isInner.value, {
        negative: "아우터박스",
        positive: "이너박스",
      }),
      active: opts.isInner.active,
    },
  ];
}
</file>

<file path="src/app/views/stats/components/SalesStatByProductListPage/SalesStatByProductListPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { sectionNames } from "@assets/messages/sectionNames";
import useListSettings from "@hooks/useListSettings";
import usePaginator, { createPaginationState } from "@hooks/usePaginator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { ProductVariantFilterInput } from "@src/api/types/globalTypes";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import { flattenColumns, makeOneRowForExcel } from "@src/app/components/Filter/SpreadFilter";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopInfo_shop_stoppedReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { useProductVariantListForSalesStatByProductLazyQuery } from "@src/app/views/product/products/api/queries";
import { ProductVariantList_productVariants_pageInfo } from "@src/app/views/product/products/api/types/ProductVariantList";
import { ProductVariantListForSalesStatByProduct_productVariants_edges_node } from "@src/app/views/product/products/api/types/ProductVariantListForSalesStatByProduct";
import { FilterPageProps, ListSettings, ListViews } from "@src/global/core/types/types";
import { excelDownload, makeHeaderRowsAndMerges } from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import { destroyDownloadingMessage, showDownloadingMessage, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { useSalesStatByProductListLazyQuery } from "../../api/queries";
import {
  SalesStatByProductList_salesStatsByProduct,
  SalesStatByProductListVariables,
} from "../../api/types/SalesStatByProductList";
import { SalesStatByProductListViewUrlQueryParams } from "../../urls";
import { createFilterStructure, SalesStatByProductFilterKeys, SalesStatByProductListFilterOpts } from "./filters";
import { getSalesStatByProductListTableSettings } from "./SalesStatByProductListTableSettings";

export type TExtendedSalesStatByProductListVariables = SalesStatByProductListVariables & ProductVariantFilterInput;
export interface SalesStatByProductListPageProps
  extends FilterPageProps<SalesStatByProductFilterKeys, SalesStatByProductListFilterOpts> {
  params: SalesStatByProductListViewUrlQueryParams;
  filterVariables: TExtendedSalesStatByProductListVariables;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  settings: ListSettings<string>;
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[];
}

export interface SalesStatByProductDataSourceProps {
  productSku: string;
  productVariant: ProductVariantListForSalesStatByProduct_productVariants_edges_node;
  stats: SalesStatByProductList_salesStatsByProduct[];
}

export const SalesStatByProductListPage: React.FC<SalesStatByProductListPageProps> = (props) => {
  const {
    params,
    filterVariables,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const [productVariantPageInfo, setProductVariantPageInfo] =
    useState<ProductVariantList_productVariants_pageInfo>(null);
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);
  const [dataSource, setDataSource] = useState<SalesStatByProductDataSourceProps[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const paginate = usePaginator();
  const { updateListSettings, settings } = useListSettings(ListViews.SALES_STATS_BY_PRODUCT_LIST);
  const paginationState = createPaginationState(settings?.rowNumber, params);

  const [productVariantListFetch, { loading: productVariantListLoading }] =
    useProductVariantListForSalesStatByProductLazyQuery();
  const [salesStatByProductListFetch, { loading: salesStatListLoading }] = useSalesStatByProductListLazyQuery();
  const tableLoading = productVariantListLoading || salesStatListLoading;

  const { loadNextPage, loadPreviousPage, pageInfo } = paginate(
    maybe(() => productVariantPageInfo),
    paginationState,
    params
  );

  const makeDataSourceUsingFilterVariables = async (
    isDownloadMode: boolean
  ): Promise<SalesStatByProductDataSourceProps[]> => {
    const {
      statDate,
      productSearch,
      brandSearch,
      vendorSearch,
      isExclusive,
      trackInventory,
      isInner,
      categoryKind,
      isFulfilledByVendor,
      isSubPv,
      salesStatus,
    } = filterVariables;
    const finalPaginationState = isDownloadMode
      ? { first: GrapheneRelayConnectionMaxLimitEnum.filterExcelDownload }
      : paginationState;

    const productVariantListPromise = productVariantListFetch({
      variables: {
        ...finalPaginationState,
        filter: {
          productSearch,
          brandSearch,
          vendorSearch,
          isExclusive,
          trackInventory,
          isInner,
          categoryKind,
          isFulfilledByVendor,
          isSubPv,
          salesStatus,
        },
      },
    });

    const { data: productVariantListData } = await productVariantListPromise;

    const salesStatByProductListPromise = salesStatByProductListFetch({
      variables: {
        productSearch,
        brandSearch,
        vendorSearch,
        statDate,
        productVariantIds: productVariantListData.productVariants.edges.map((edge) => edge.node.id),
        isMonthlyMode: true,
      },
    });

    const { data: salesStatByProductListData } = await salesStatByProductListPromise;

    if (!isDownloadMode) {
      setProductVariantPageInfo(productVariantListData.productVariants.pageInfo);
    }
    const productVariantList = productVariantListData.productVariants.edges.map((edge) => edge.node);
    const salesStatByProductList = salesStatByProductListData.salesStatsByProduct;

    const newDataSource = productVariantList.map((productVariant) => {
      const stats = salesStatByProductList.filter((stat) => stat.productSku === productVariant.sku);
      const dataToAdd: SalesStatByProductDataSourceProps = { productSku: productVariant.sku, productVariant, stats };
      return dataToAdd;
    });
    return newDataSource;
  };

  useEffect(() => {
    const refetchDataSource = async () => {
      const newDataSource = await makeDataSourceUsingFilterVariables(false);
      setDataSource(newDataSource);
    };

    refetchDataSource();
  }, [params, settings?.rowNumber]);

  const columns = getSalesStatByProductListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const onPrintClick = async () => {
    setPrintBtnLoading(true);
    showDownloadingMessage();

    const flattenedColumns = flattenColumns(columns);
    const dataSourceToPrint = await makeDataSourceUsingFilterVariables(true);

    const rows = [];
    dataSourceToPrint.forEach((line, index) => {
      const row = makeOneRowForExcel(line, flattenedColumns, index);
      rows.push(row);
    });
    if (!rows || rows.length === 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
    excelDownload({ title: "제품 판매 실적(월별)", columns: rows, header, merges, skipOriginHeader: true });

    setPrintBtnLoading(false);
    destroyDownloadingMessage();
  };

  const makeExtraUi = () => (
    <Space>
      <Button type="primary" shape="round" icon={<DownloadOutlined />} loading={printBtnLoading} onClick={onPrintClick}>
        다운로드
      </Button>
    </Space>
  );

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.salesStatByProductByMonth}</Typography.Title>
          </Col>
          <Col>{makeExtraUi()}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={tableLoading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable
            {...commonTableProps}
            ref={tableRef}
            loading={tableLoading}
            rowKey={(record) => record.productSku}
            columns={pickerSelectedColumns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => (
              <TableListFooter
                disabled={tableLoading}
                settings={settings}
                pageInfo={pageInfo}
                onPreviousPage={loadPreviousPage}
                onNextPage={loadNextPage}
                onUpdateListSettings={updateListSettings}
              />
            )}
          />
        </Card>
      </Space>
    </>
  );
};
</file>

