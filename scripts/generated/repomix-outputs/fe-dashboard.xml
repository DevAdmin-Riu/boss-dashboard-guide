<file path="src/app/views/settings/plugin/components/InicisApiKey/InicisApiKeyList.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { EditableCell, newEditableRowId } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { BrandDetails_brand } from "@src/app/views/brand/brands/api/types/BrandDetails";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Form, Table, Typography } from "antd";
import { DocumentNode } from "graphql";
import React, { useEffect, useState } from "react";

import { useInicisApiKeyCreate, useInicisApiKeyUpdate } from "../../api/mutations";
import { Plugin_plugin_inicisApiKeys } from "../../api/types/Plugin";
import { getInicisApiKeyTableColumns } from "./InicisApiKeyTableSettings";

interface InicisApiKeyProps {
  brand?: BrandDetails_brand;
  iniApiKeys: Plugin_plugin_inicisApiKeys[];
  disabled?: boolean;
  refetchQuery?: DocumentNode;
}

interface InicisApiKeyFormType {
  mid: string;
  iniApiKey: string;
  iniApiIv: string;
}

export const InicisApiKeyList: React.FC<InicisApiKeyProps> = (props) => {
  const { brand, iniApiKeys, disabled, refetchQuery } = props;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<InicisApiKeyFormType>(form);
  const [selectedRowId, setSelectedRowId] = useState<string>(undefined);
  const [dataSource, setDataSource] = useState<Plugin_plugin_inicisApiKeys[]>([]);

  useEffect(() => {
    setDataSource(iniApiKeys);
  }, [iniApiKeys]);

  const excludeNewEditibaleRow = () => dataSource.filter((data) => data.id !== newEditableRowId);

  const resetFormField = () => {
    form.resetFields();
    setSelectedRowId(undefined);
  };

  const [createInicisApiKey, createInicisApiKeyOpts] = useInicisApiKeyCreate({
    onCompleted: (data) => {
      const errors = data.inicisApiKeyCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        resetFormField();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: refetchQuery ? [refetchQuery] : null,
  });

  const [updateInicisApiKey, updateInicisApiKeyOpts] = useInicisApiKeyUpdate({
    onCompleted: (data) => {
      const errors = data.inicisApiKeyUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        resetFormField();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: refetchQuery ? [refetchQuery] : null,
  });

  const resetDataSourceToRemoveNewEditbaleRow = () => {
    const excludeNewEditableRow = excludeNewEditibaleRow();
    setDataSource(excludeNewEditableRow);
  };

  const setEditableRow = (record: Plugin_plugin_inicisApiKeys) => {
    TypeSafeForm.setFields([
      { name: "mid", value: record?.mid },
      { name: "iniApiKey", value: record?.iniApiKey },
      { name: "iniApiIv", value: record?.iniApiIv },
    ]);
    setSelectedRowId(record?.id);
  };

  const onAdd = () => {
    const newData: Plugin_plugin_inicisApiKeys = {
      __typename: "InicisApiKey",
      id: newEditableRowId,
      mid: "",
      iniApiKey: "",
      iniApiIv: "",
    };
    setDataSource([...dataSource, newData]);
    setEditableRow(newData);
  };

  const isEditing = (record: Plugin_plugin_inicisApiKeys, key?: React.Key) => {
    if (key === "mid") {
      return record?.id === newEditableRowId;
    }
    return record?.id === selectedRowId;
  };
  const onEdit = (record: Plugin_plugin_inicisApiKeys) => {
    resetDataSourceToRemoveNewEditbaleRow();
    setEditableRow(record);
  };
  const onCancel = () => {
    if (selectedRowId === newEditableRowId) {
      resetDataSourceToRemoveNewEditbaleRow();
    }
    resetFormField();
  };

  const onSubmit = () => {
    const formFields = TypeSafeForm.getFieldsValue();
    if (selectedRowId === newEditableRowId) {
      createInicisApiKey({
        variables: {
          input: {
            ...formFields,
            brand: brand?.id,
          },
        },
      });
    } else {
      updateInicisApiKey({
        variables: {
          id: selectedRowId,
          input: formFields,
        },
      });
    }
  };

  const cardTitle = (
    <>
      <CardTitleAntd
        title="이니시스 API Keys - 이니시스 환불 연동 시 필요 정보"
        extra={
          <Button onClick={onAdd} type="primary" style={{ marginBottom: 16 }}>
            Inicis Api Key 추가
          </Button>
        }
      />
      <Typography.Text type="warning" strong>
        본부 매출 인식 유형의 가맹본부는 개별 이니시스 상점 id를 사용합니다. 개별 가맹본부 상세 페이지에서 환불 연동을
        위한 Inicis Api Key 도 설정해 주세요.
      </Typography.Text>
    </>
  );

  useEffect(() => {
    if (iniApiKeys.length === 0 && brand) {
      showNotificationWarn("환불시 필요한 이니시스 API Key는 필수입니다. API Key를 추가해 주세요.");
    }
  }, []);

  const columns = getInicisApiKeyTableColumns({
    disabled: disabled || updateInicisApiKeyOpts.loading || createInicisApiKeyOpts.loading,
    isEditing,
    onEdit,
    onSubmit,
    onCancel,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
      <Form form={form} component={false}>
        <Table
          {...commonTableProps}
          columns={columns}
          dataSource={dataSource}
          components={{ body: { cell: EditableCell } }}
          scroll={{ x: tableWidthSum }}
        />
      </Form>
    </Card>
  );
};
</file>

<file path="src/app/views/settings/plugin/components/InicisApiKey/InicisApiKeyTableSettings.tsx">
import { newEditableRowId } from "@src/app/components/antd/Table/editableCell";
import { EditableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { Button, Space } from "antd";
import React from "react";

import { Plugin_plugin_inicisApiKeys } from "../../api/types/Plugin";

interface InicisApiKeyTableColumnsProps {
  disabled: boolean;
  isEditing: (record: Plugin_plugin_inicisApiKeys, key?: React.Key) => boolean;
  onEdit: (record: Plugin_plugin_inicisApiKeys) => void;
  onSubmit: () => void;
  onCancel: () => void;
}

export const getInicisApiKeyTableColumns = (props: InicisApiKeyTableColumnsProps) => {
  const { disabled, isEditing, onEdit, onSubmit, onCancel } = props;

  const columns: EditableColumnsType<Plugin_plugin_inicisApiKeys> = [
    {
      title: "mid",
      key: "mid",
      width: 100,
      render: (_, record) => record.mid,
      onCell: (record: Plugin_plugin_inicisApiKeys) => ({
        inputType: "text",
        formItemName: "mid",
        editing: isEditing(record, "mid"),
      }),
    },
    {
      title: "Inicis Api Key",
      key: "iniApiKey",
      width: 150,
      render: (_, record) => record.iniApiKey,
      onCell: (record: Plugin_plugin_inicisApiKeys) => ({
        inputType: "text",
        formItemName: "iniApiKey",
        editing: isEditing(record, "iniApiKey"),
      }),
    },
    {
      title: "Inicis Api IV",
      key: "iniApiIv",
      width: 150,
      render: (_, record) => record.iniApiIv,
      onCell: (record: Plugin_plugin_inicisApiKeys) => ({
        inputType: "text",
        formItemName: "iniApiIv",
        editing: isEditing(record, "iniApiIv"),
      }),
    },
    {
      key: "action",
      align: "center",
      width: 80,
      render: (_, record) => {
        const editable = isEditing(record);
        return editable ? (
          <Space size={"small"}>
            <Button size="small" disabled={disabled} type={"primary"} onClick={onSubmit} style={{ marginRight: 8 }}>
              {record.id === newEditableRowId ? "추가" : "저장"}
            </Button>
            <Button size="small" type={"default"} onClick={onCancel}>
              취소
            </Button>
          </Space>
        ) : (
          <Button size="small" disabled={disabled} type={"primary"} onClick={() => onEdit(record)}>
            수정
          </Button>
        );
      },
    },
  ];

  return columns;
};
</file>

