<file path="src/app/views/mileageSettlement/urls.ts">
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import {
  ActiveTab,
  BulkAction,
  Dialog,
  Filters,
  FiltersWithMultipleValues,
  TabActionDialog,
} from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export enum SettlementType {
  mileage = "mileage",
  fulfilledByVendor = "fulfilledByVendor",
}

export const mileageSettlementSectionUrl = "/mileage-settlement";

export const MileageSettlementBeforeConfirmedListViewPath = urlJoin(mileageSettlementSectionUrl, "before-confirmed");

export const MileageSettlementReviewingListViewPath = urlJoin(mileageSettlementSectionUrl, "reviewing-by-admin");
export const MileageSettlementWaitingPaymentListViewPath = urlJoin(mileageSettlementSectionUrl, "waiting-for-payment");
export const MileageSettlementPaidListViewPath = urlJoin(mileageSettlementSectionUrl, "paid");
export const MileageSettlementAllListViewPath = urlJoin(mileageSettlementSectionUrl, "all-status");

export enum MileageSettlementListViewUrlFiltersEnum {
  statDateFrom = "statDateFrom",
  statDateTo = "statDateTo",
  hasApplied = "hasApplied",
  brandSearch = "brandSearch",
  mdSearch = "mdSearch",
}
export enum MileageSettlementListViewUrlFiltersWithMultipleValuesEnum {
  settlementStatus = "settlementStatus",
}
export type MileageSettlementListViewUrlFilters = Filters<MileageSettlementListViewUrlFiltersEnum> &
  FiltersWithMultipleValues<MileageSettlementListViewUrlFiltersWithMultipleValuesEnum>;
export type MileageSettlementListViewUrlDialog = "cancel" | TabActionDialog;
export type MileageSettlementListViewUrlQueryParams = BulkAction &
  Dialog<MileageSettlementListViewUrlDialog> &
  MileageSettlementListViewUrlFilters &
  ActiveTab;

export const settlementListViewUrl = (viewPath: string) => (params?: MileageSettlementListViewUrlQueryParams) =>
  params === undefined ? viewPath : urlJoin(viewPath, "?" + stringifyQs(params));

export enum AdminMonthlySettlementUrlEnum {
  NOT_CONFIRMED = "NOT_CONFIRMED",
  // URL 상으로 CONFIRMED 없음. 지급검토에 포함됨.
  // CONFIRMED = "CONFIRMED",
  REVIEWING_BY_ADMIN = "REVIEWING_BY_ADMIN",
  WAITING_FOR_PAYMENT = "WAITING_FOR_PAYMENT",
  PAID = "PAID",
  ALL_STATUS = "ALL_STATUS",
}

