<file path="src/app/views/settings/virtualAccount/views/VirtualAccountDetailsView.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { BrandContractTypeEnum, VirtualAccountInput } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useVirtualAccountUpdateMutation } from "../api/mutations";
import { useVirtualAccountStatusQuery } from "../api/queries";
import { VirtualAccountDetailsPage, VirtualAccountUpdateForm } from "../components/VirtualAccountDetailsPage";
import { VirtualAccountDetailsViewUrlQueryParams, virtualAccountListViewUrl } from "../urls";

export interface VirtualAccountDetailsViewProps {
  id: string;
  params: VirtualAccountDetailsViewUrlQueryParams;
}
export const VirtualAccountDetailsView: React.FC<VirtualAccountDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const { data, loading } = useVirtualAccountStatusQuery({
    skip: id === undefined,
    variables: { id },
  });
  const virtualAccount = data?.virtualAccountStatus;

  const { search, result } = useBrandSearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, contractType: [BrandContractTypeEnum.REVERSE_FEE] },
  });

  const [virtualAccountUpdate, virtualAccountUpdateOpts] = useVirtualAccountUpdateMutation({});

  const handleVirtualAccountUpdate = async (formData: VirtualAccountUpdateForm) => {
    if (utils.isEmpty(formData.orgName)) {
      showNotificationError("가상계좌 발급 고객사명은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.brand)) {
      showNotificationError("가상계좌 발급 기관 정보 연동할 브랜드 선택은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerName)) {
      showNotificationError("가상계좌 발급 담당자 이름은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerEmail)) {
      showNotificationError("가상계좌 발급 담당자 이메일은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerPhone)) {
      showNotificationError("가상계좌 발급 담당자 연락처는 필수 항목입니다.");
      return;
    }

    const virtualAccountUpdateInput: VirtualAccountInput = {
      orgName: formData.orgName,
      managerName: formData.managerName,
      managerEmail: formData.managerEmail,
      managerPhone: formData.managerPhone,
      minQty: formData.minQty,
      brand: formData.brand,
    };
    const result = await virtualAccountUpdate({
      variables: {
        id,
        input: virtualAccountUpdateInput,
      },
    });
    const errors = result.data?.virtualAccountUpdate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("가상계좌 발급 기관 정보가 수정되었습니다.");
    } else {
      showGqlErrors(errors);
    }

    return errors || null;
  };

  if (virtualAccount === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(virtualAccountListViewUrl())} />;
  }

  return (
    <VirtualAccountDetailsPage
      disabled={loading || virtualAccountUpdateOpts.loading}
      virtualAccount={virtualAccount}
      saveButtonBar={virtualAccountUpdateOpts.status}
      brandsLoading={result?.loading}
      brands={maybe(
        () =>
          result?.data?.search?.edges
            ?.map((edge) => edge?.node)
            .filter((brand) => virtualAccount?.brand?.id === brand?.id || !brand?.orgCode),
        []
      )}
      brandsSearch={search}
      onBack={() => navigate(virtualAccountListViewUrl())}
      onSubmit={handleVirtualAccountUpdate}
    />
  );
};
</file>

