import {
  PriorityLevelEnum,
  ProductVariantMonthlyStockSnapshotFilterInput,
  SalesStatusEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  MonthlyStockSnapshotsFilterKeys,
  MonthlyStockSnapshotsFilterOpts,
} from "../../components/MonthlyStockSnapshotsPage/filter";
import {
  MonthlyStockSnapshotsViewUrlFilters,
  MonthlyStockSnapshotsViewUrlFiltersEnum,
  MonthlyStockSnapshotsViewUrlFiltersWithMultipleValuesEnum,
  MonthlyStockSnapshotsViewUrlQueryParams,
} from "../../urls";

const MONTHLY_STOCK_SNAPSHOTS_FILTERS_KEY = "monthlyStockSnapshotsFilters";

export function getFilterOpts(params: MonthlyStockSnapshotsViewUrlFilters): MonthlyStockSnapshotsFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    salesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.salesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.salesStatus), []),
    },
    priorityLevel: {
      active: maybe(() => !utils.isEmpty(filterVariables.priorityLevel), false),
      value: maybe(() => dedupeFilter(filterVariables.priorityLevel), []),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, true),
    },
    isInner: {
      active: maybe(() => params.isInner !== undefined, false),
      value: maybe(() => parseBoolean(params.isInner, true)),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: MonthlyStockSnapshotsViewUrlFilters
): ProductVariantMonthlyStockSnapshotFilterInput {
  return {
    statDate: getGteLteVariablesForMonth({
      gte: params.statDateFrom,
      lte: params.statDateTo,
    }),
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, true) : undefined,
    isInner: params.isInner !== undefined ? parseBoolean(params.isInner, false) : undefined,
    salesStatus: maybe(() => params.salesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    priorityLevel: maybe(() => params.priorityLevel.map((status) => findInEnum(status, PriorityLevelEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<MonthlyStockSnapshotsFilterKeys>
): MonthlyStockSnapshotsViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case MonthlyStockSnapshotsFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        MonthlyStockSnapshotsViewUrlFiltersEnum.statDateFrom,
        MonthlyStockSnapshotsViewUrlFiltersEnum.statDateTo
      );
    case MonthlyStockSnapshotsFilterKeys.salesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        MonthlyStockSnapshotsViewUrlFiltersWithMultipleValuesEnum.salesStatus,
        SalesStatusEnum
      );
    case MonthlyStockSnapshotsFilterKeys.priorityLevel:
      return getMultipleEnumValueQueryParam(
        filter,
        MonthlyStockSnapshotsViewUrlFiltersWithMultipleValuesEnum.priorityLevel,
        PriorityLevelEnum
      );
    case MonthlyStockSnapshotsFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, MonthlyStockSnapshotsViewUrlFiltersEnum.trackInventory);
    case MonthlyStockSnapshotsFilterKeys.isInner:
      return getSingleValueQueryParam(filter, MonthlyStockSnapshotsViewUrlFiltersEnum.isInner);

    case MonthlyStockSnapshotsFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, MonthlyStockSnapshotsViewUrlFiltersEnum.productSearch);
    case MonthlyStockSnapshotsFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, MonthlyStockSnapshotsViewUrlFiltersEnum.vendorSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<MonthlyStockSnapshotsViewUrlFilters>(MONTHLY_STOCK_SNAPSHOTS_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  MonthlyStockSnapshotsViewUrlQueryParams,
  MonthlyStockSnapshotsViewUrlFilters
>({
  ...MonthlyStockSnapshotsViewUrlFiltersEnum,
  ...MonthlyStockSnapshotsViewUrlFiltersWithMultipleValuesEnum,
});
</file>

