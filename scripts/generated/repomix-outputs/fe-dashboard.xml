    loading || requestBossProductEstimateCreateOpts.loading || requestBossProductEstimateUpdateOpts.loading;

  const submitFormDataConvert = (formData: TEstimateForm) => ({
    ...formData,
    copperUnitDevCostExcludeVat: formData.copperUnitDevCostExcludeVat || 0,
