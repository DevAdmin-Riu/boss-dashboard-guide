import { FulfillmentSortField, OrderDirection } from "@src/api/types/globalTypes";
import { FulfillmentListVariables } from "@src/app/views/order/orders/api/types/FulfillmentList";

import { HqOrderDeliveryListViewUrlQueryParams } from "../../urls";

export function getDeliveryListSortQueryVariables(
  params: HqOrderDeliveryListViewUrlQueryParams
): FulfillmentListVariables["sort"] {
  if (!params.sort) {
    return {
      field: FulfillmentSortField.CREATION_DATE,
      direction: OrderDirection.DESC,
    };
  }

  const [field, direction] = params.sort.split(":");

  return {
    field: field as FulfillmentSortField,
    direction: direction === "asc" ? OrderDirection.ASC : OrderDirection.DESC,
  };
}
