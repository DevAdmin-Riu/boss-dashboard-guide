import { BrandProductPackageListFragment } from "@src/api/fragments/types/BrandProductPackageListFragment";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Button, Space, Tag } from "antd";
import React from "react";

import { getDeliveryMethods } from "./utils";

export type HqPackageTableDataType = BrandProductPackageListFragment & {
  no?: number;
};

interface GetHqPackageTableColumnsOptions {
  onViewComposition?: (packageId: string) => void;
}

export const getHqPackageTableColumns = (
  options?: GetHqPackageTableColumnsOptions
): DownloadableColumnsType<HqPackageTableDataType> => {
  const fixedFlag = utils.fixedLeftFlag();

  // No 컬럼
  const noColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: "No",
    key: "no",
    align: "center",
    fixed: fixedFlag,
    width: 60,
    render: (_text, _record, index) => index + 1,
    renderExcel: (_record, index) => index + 1,
  };

  // 상품코드 컬럼
  const productCodeColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "productCode",
    align: "center",
    fixed: fixedFlag,
    width: 140,
    render: (_, record) => record.bpSku,
    renderExcel: (record) => record.bpSku,
  };

  // 상품명 컬럼
  const productNameColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "productName",
    align: "left",
    width: 200,
    render: (_, record) => record.name || "-",
    renderExcel: (record) => record.name || "-",
  };

  // 판매상태 컬럼
  const salesStatusColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "salesStatus",
    align: "center",
    width: 100,
    render: (_, record) => {
      const isVisible = record.visible;
      const tagColor = isVisible ? "green" : "default";
      const tagText = isVisible ? "판매" : "중단";
      return <Tag color={tagColor}>{tagText}</Tag>;
    },
    renderExcel: (record) => (record.visible ? "판매" : "중단"),
  };

  // 배송방법 컬럼
  const deliveryMethodColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.delivery.DELIVERY_METHOD,
    key: "deliveryMethod",
    align: "center",
    width: 120,
    render: (_, record) => {
      const methods = getDeliveryMethods(record);

      if (methods.length === 0) {
        return "-";
      }

      return (
        <Space direction="horizontal" size={4}>
          {methods.map((method) => (
            <Tag key={method}>{method}</Tag>
          ))}
        </Space>
      );
    },
    renderExcel: (record) => {
      const methods = getDeliveryMethods(record);
      return methods.join(", ") || "-";
    },
  };

  // 화물차 배송비 컬럼
  const truckDeliveryFeeColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.delivery.TRUCK_DELIVERY_FEE,
    key: "truckDeliveryFee",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.etcDeliveryFee) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.etcDeliveryFee) || 0,
  };

  const additionalFeeForEtcDeliveryColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.order.DELIVERY_ADDITIONAL_FEE.join(" "),
    key: "additionalFeeForEtcDelivery",
    align: "right",
    width: 180,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.additionalFeeForEtcDelivery) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.additionalFeeForEtcDelivery) || 0,
  };

  // 총 상품금액 컬럼
  const totalAmountColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: columnNameConstant.brandProduct.TOTAL_BRAND_PRODUCT_PRICE,
    key: "totalAmount",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.totalPriceWoEtcDeliveryFee) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.totalPriceWoEtcDeliveryFee) || 0,
  };

  // 패키지 구성품 버튼 컬럼
  const compositionColumn: DownloadableColumnType<HqPackageTableDataType> = {
    title: "패키지 구성",
    key: "composition",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Button type="primary" size="small" onClick={() => options?.onViewComposition?.(record.id)}>
        구성품 보기
      </Button>
    ),
    renderExcel: () => "-",
  };

  // 컬럼 구성 (1차 헤더: 상품 정보)
  const columns: DownloadableColumnsType<HqPackageTableDataType> = [
    noColumn,
    productCodeColumn,
    {
      title: "상품 정보",
      key: "productInfo",
      children: [
        productNameColumn,
        salesStatusColumn,
        deliveryMethodColumn,
        truckDeliveryFeeColumn,
        additionalFeeForEtcDeliveryColumn,
        totalAmountColumn,
        compositionColumn,
      ],
    },
  ];

  return columns;
};
</file>

