import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { brandStoreRequestToHqFragment } from "@src/api/fragments/notice";
import { BrandStoreRequestStatusEnum } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import {
  useBrandStoreRequestToHqCommentCreateMutation,
  useBrandStoreRequestToHqStatusUpdateMutation,
} from "../api/mutations";
import { useBrandStoreRequestToHqDetailsQuery } from "../api/queries";
import { BrandStoreRequestToHqDetailsPage } from "../components/BrandStoreRequestToHqDetailsPage/BrandStoreRequestToHqDetailsPage";
import { brandStoreRequestToHqListViewUrl } from "../urls";
import { brandStoreRequestToHqStatusChoices } from "../utils";

enum BrandStoreRequestToHqDetailsModalModeEnum {
  UpdateStatusDone = "UpdateStatusDone",
}

interface BrandStoreRequestToHqDetailsViewProps {
  requestId: string;
}

export const BrandStoreRequestToHqDetailsView: React.FC<BrandStoreRequestToHqDetailsViewProps> = ({ requestId }) => {
  const { user } = useUser();
  const navigate = useNavigator();
  const [modalMode, setModalMode] = useState<BrandStoreRequestToHqDetailsModalModeEnum>(null);

  const onModalOpen = (mode: BrandStoreRequestToHqDetailsModalModeEnum) => {
    setModalMode(mode);
  };
  const onModalClose = () => {
    setModalMode(null);
  };

  const isStaff = user.isStaff;

  const { data, loading } = useBrandStoreRequestToHqDetailsQuery({
    skip: utils.isEmpty(requestId, true),
    variables: { id: requestId, isStaff },
  });
  const request = maybe(() => data.brandStoreRequestToHq, null);

  const [brandStoreRequestToHqStatusUpdate] = useBrandStoreRequestToHqStatusUpdateMutation({
    onCompleted: (res) => {
      const afterStatus = res.brandStoreRequestToHqStatusUpdate?.brandStoreRequestToHq?.status;
      const afterStatusText = utils.getLabelTextByValue(afterStatus, brandStoreRequestToHqStatusChoices);
      const successMsg = `매장 요청이 ${afterStatusText}되었습니다.`;
      utils.handleOnCompletedWithError(res.brandStoreRequestToHqStatusUpdate.errors, successMsg, onModalClose);
    },
  });

  const [brandStoreRequestToHqCommentCreate] = useBrandStoreRequestToHqCommentCreateMutation({
    onCompleted: (res) =>
      utils.handleOnCompletedWithError(
        res.brandStoreRequestToHqCommentCreate.errors,
        "매장 요청에 댓글을 등록하였습니다."
      ),
  });

  const handleStatusUpdate = (status: BrandStoreRequestStatusEnum) => {
    if (status === BrandStoreRequestStatusEnum.DONE) {
      onModalOpen(BrandStoreRequestToHqDetailsModalModeEnum.UpdateStatusDone);
    } else {
      brandStoreRequestToHqStatusUpdate({ variables: { id: requestId, input: { status } } });
    }
  };

  const handleCommentCreate = (content: string) => {
    brandStoreRequestToHqCommentCreate({
      variables: { input: { request: requestId, content } },
      update: (cache, { data }) => {
        const newComment = data?.brandStoreRequestToHqCommentCreate?.brandStoreRequestToHqComment;
        if (!newComment) {
          return;
        }

        const request = data.brandStoreRequestToHqCommentCreate.request;
        const requestCacheId = cache.identify({ __typename: request.__typename, id: request.id });
        const updateFragment = brandStoreRequestToHqFragment;
        updateMultipleFragments({
          cache,
          cacheId: requestCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "BrandStoreRequestToHqFragment",
              fieldName: "comments",
              updateFn: (prev) => [...prev, newComment],
            },
          ],
        });
      },
    });
  };

  const handleBack = () => {
    navigate(brandStoreRequestToHqListViewUrl());
  };

  return (
    <>
      <WindowTitle title="매장 요청 상세" />
      <BrandStoreRequestToHqDetailsPage
        user={user}
        request={request}
        loading={loading}
        onBack={handleBack}
        onStatusUpdate={handleStatusUpdate}
        onCommentCreate={handleCommentCreate}
      />
      <ConfirmModal
        visible={modalMode === BrandStoreRequestToHqDetailsModalModeEnum.UpdateStatusDone}
        modalTitleText="매장 요청 완료"
        titleText="해당 매장 요청을 완료 처리하시겠습니까?"
        helpText="매장 요청을 완료 처리하면, 더 이상 댓글을 등록할 수 없습니다."
        onOk={() =>
          brandStoreRequestToHqStatusUpdate({
            variables: { id: requestId, input: { status: BrandStoreRequestStatusEnum.DONE } },
          })
        }
        onCancel={onModalClose}
      />
    </>
  );
};
</file>

