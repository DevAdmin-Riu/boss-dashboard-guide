import { useMutation } from "@apollo/client";
import { shopInfo } from "@src/app/providers/ShopProvider/query";
import { ShopInfo } from "@src/app/providers/ShopProvider/types/ShopInfo";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { message, Modal } from "antd";
import React, { useState } from "react";

import {
  courierDeliveryAdditionalFeeBulkDelete,
  courierDeliveryAdditionalFeeBulkReset,
  courierDeliveryAdditionalFeeCreate,
  courierDeliveryAdditionalFeeDelete,
  courierDeliveryAdditionalFeeUpdate,
} from "../../api/mutations";
import { DeliveryAdditionalFeeBulkResetModal } from "../../components/DeliveryAdditionalFeeBulkResetModal/DeliveryAdditionalFeeBulkResetModal";
import { DeliveryAdditionalFeeFormModal } from "../../components/DeliveryAdditionalFeeFormModal/DeliveryAdditionalFeeFormModal";
import { DeliveryAdditionalFeeListPage } from "../../components/DeliveryAdditionalFeeListPage/DeliveryAdditionalFeeListPage";
import { DeliveryAdditionalFeeListViewUrlQueryParams } from "../../urls";

interface DeliveryAdditionalFeeListViewProps {
  params: DeliveryAdditionalFeeListViewUrlQueryParams;
}

interface CourierDeliveryAdditionalFee {
  id: string;
  pcodeStart: string;
  pcodeEnd: string;
  unitAdditionalFeeExcludeVat: number;
  streetAddress: string;
}

export const DeliveryAdditionalFeeListView: React.FC<DeliveryAdditionalFeeListViewProps> = () => {
  const shop = useShop();
  const [selectedRowIds, setSelectedRowIds] = useState<React.Key[]>([]);
  const [isFormModalVisible, setIsFormModalVisible] = useState(false);
  const [isBulkResetModalVisible, setIsBulkResetModalVisible] = useState(false);
  const [editingData, setEditingData] = useState<CourierDeliveryAdditionalFee | null>(null);

  const courierDeliveryAdditionalFeeList = shop?.courierDeliveryAdditionalFeeList || [];

  const [createMutation, { loading: createLoading }] = useMutation(courierDeliveryAdditionalFeeCreate, {
    update: (cache, { data }) => {
      if (data?.courierDeliveryAdditionalFeeCreate?.courierDeliveryAdditionalFee) {
        const existingData = cache.readQuery<ShopInfo>({ query: shopInfo });
        if (existingData?.shop) {
          const newItem = data.courierDeliveryAdditionalFeeCreate.courierDeliveryAdditionalFee;
          const updatedList = [...(existingData.shop.courierDeliveryAdditionalFeeList || []), newItem].sort((a, b) => {
            const startCompare = parseInt(a.pcodeStart, 10) - parseInt(b.pcodeStart, 10);
            if (startCompare !== 0) {
              return startCompare;
            }
            return parseInt(a.pcodeEnd, 10) - parseInt(b.pcodeEnd, 10);
          });

          cache.writeQuery<ShopInfo>({
            query: shopInfo,
            data: {
              shop: {
                ...existingData.shop,
                courierDeliveryAdditionalFeeList: updatedList,
              },
            },
          });
        }
      }
    },
    onCompleted: (data) => {
      if (data.courierDeliveryAdditionalFeeCreate?.errors?.length === 0) {
        message.success("추가요금이 생성되었습니다");
        setIsFormModalVisible(false);
      } else if (data.courierDeliveryAdditionalFeeCreate?.errors?.length > 0) {
        message.error(data.courierDeliveryAdditionalFeeCreate.errors[0].message);
      }
    },
    onError: (error) => {
      message.error(`생성 실패: ${error.message}`);
    },
  });

  const [updateMutation, { loading: updateLoading }] = useMutation(courierDeliveryAdditionalFeeUpdate, {
    update: (cache, { data }) => {
      if (data?.courierDeliveryAdditionalFeeUpdate?.courierDeliveryAdditionalFee) {
        const existingData = cache.readQuery<ShopInfo>({ query: shopInfo });
        if (existingData?.shop) {
          const updatedItem = data.courierDeliveryAdditionalFeeUpdate.courierDeliveryAdditionalFee;
          const updatedList = existingData.shop.courierDeliveryAdditionalFeeList
            ?.map((item) => (item.id === updatedItem.id ? updatedItem : item))
            .sort((a, b) => {
              const startCompare = parseInt(a.pcodeStart, 10) - parseInt(b.pcodeStart, 10);
              if (startCompare !== 0) {
                return startCompare;
              }
              return parseInt(a.pcodeEnd, 10) - parseInt(b.pcodeEnd, 10);
            });

          cache.writeQuery<ShopInfo>({
            query: shopInfo,
            data: {
              shop: {
                ...existingData.shop,
                courierDeliveryAdditionalFeeList: updatedList,
              },
            },
          });
        }
      }
    },
    onCompleted: (data) => {
      if (data.courierDeliveryAdditionalFeeUpdate?.errors?.length === 0) {
        message.success("추가요금이 수정되었습니다");
        setIsFormModalVisible(false);
        setEditingData(null);
      } else if (data.courierDeliveryAdditionalFeeUpdate?.errors?.length > 0) {
        message.error(data.courierDeliveryAdditionalFeeUpdate.errors[0].message);
      }
    },
    onError: (error) => {
      message.error(`수정 실패: ${error.message}`);
    },
  });

  const [deleteMutation] = useMutation(courierDeliveryAdditionalFeeDelete, {
    update: (cache, { data }, { variables }) => {
      if (data?.courierDeliveryAdditionalFeeDelete?.errors?.length === 0 && variables?.id) {
        const existingData = cache.readQuery<ShopInfo>({ query: shopInfo });
        if (existingData?.shop) {
          cache.writeQuery<ShopInfo>({
            query: shopInfo,
            data: {
              shop: {
                ...existingData.shop,
                courierDeliveryAdditionalFeeList: existingData.shop.courierDeliveryAdditionalFeeList?.filter(
                  (item) => item.id !== variables.id
                ),
              },
            },
          });
        }
      }
    },
    onCompleted: (data) => {
      if (data.courierDeliveryAdditionalFeeDelete?.errors?.length === 0) {
        message.success("추가요금이 삭제되었습니다");
      } else if (data.courierDeliveryAdditionalFeeDelete?.errors?.length > 0) {
        message.error(data.courierDeliveryAdditionalFeeDelete.errors[0].message);
      }
    },
    onError: (error) => {
      message.error(`삭제 실패: ${error.message}`);
    },
  });

  const [bulkResetMutation, { loading: bulkResetLoading }] = useMutation(courierDeliveryAdditionalFeeBulkReset, {
    refetchQueries: [{ query: shopInfo }],
    onCompleted: (data) => {
      if (data.courierDeliveryAdditionalFeeBulkReset?.errors?.length === 0) {
        message.success("도서/산간 추가요금이 리셋되었습니다");
        setIsBulkResetModalVisible(false);
      } else if (data.courierDeliveryAdditionalFeeBulkReset?.errors?.length > 0) {
        message.error(data.courierDeliveryAdditionalFeeBulkReset.errors[0].message);
      }
    },
    onError: (error) => {
      message.error(`리셋 실패: ${error.message}`);
    },
  });

  const [bulkDeleteMutation] = useMutation(courierDeliveryAdditionalFeeBulkDelete, {
    update: (cache, { data }, { variables }) => {
      if (data?.courierDeliveryAdditionalFeeBulkDelete?.errors?.length === 0 && variables?.ids) {
        const existingData = cache.readQuery<ShopInfo>({ query: shopInfo });
        if (existingData?.shop) {
          const idsToDelete = variables.ids as string[];
          cache.writeQuery<ShopInfo>({
            query: shopInfo,
            data: {
              shop: {
                ...existingData.shop,
                courierDeliveryAdditionalFeeList: existingData.shop.courierDeliveryAdditionalFeeList?.filter(
                  (item) => !idsToDelete.includes(item.id)
                ),
              },
            },
          });
        }
      }
    },
    onCompleted: (data) => {
      if (data.courierDeliveryAdditionalFeeBulkDelete?.errors?.length === 0) {
        message.success(`${data.courierDeliveryAdditionalFeeBulkDelete.count}개의 추가요금이 삭제되었습니다`);
        setSelectedRowIds([]);
      } else if (data.courierDeliveryAdditionalFeeBulkDelete?.errors?.length > 0) {
        message.error(data.courierDeliveryAdditionalFeeBulkDelete.errors[0].message);
      }
    },
    onError: (error) => {
      message.error(`일괄 삭제 실패: ${error.message}`);
    },
  });

  const handleCreate = () => {
    setEditingData(null);
    setIsFormModalVisible(true);
  };

  const handleUpdate = (id: string) => {
    const data = courierDeliveryAdditionalFeeList.find((item) => item.id === id);
    if (data) {
      setEditingData(data);
      setIsFormModalVisible(true);
    }
  };

  const handleDelete = (id: string) => {
    Modal.confirm({
      title: "추가요금을 삭제하시겠습니까?",
      content: "삭제된 데이터는 복구할 수 없습니다.",
      okText: "삭제",
      okType: "danger",
      cancelText: "취소",
      onOk: () => {
        deleteMutation({ variables: { id } });
      },
    });
  };

  const handleBulkDelete = () => {
    Modal.confirm({
      title: `선택한 ${selectedRowIds.length}개의 추가요금을 삭제하시겠습니까?`,
      content: "삭제된 데이터는 복구할 수 없습니다.",
      okText: "삭제",
      okType: "danger",
      cancelText: "취소",
      onOk: () => {
        bulkDeleteMutation({ variables: { ids: selectedRowIds } });
      },
    });
  };

  const handleBulkReset = () => {
    setIsBulkResetModalVisible(true);
  };

  const handleBulkResetSubmit = (
    details: Array<{
      pcodeStart: string;
      pcodeEnd: string;
      unitAdditionalFeeExcludeVat: number;
      streetAddress?: string;
    }>
  ) => {
    bulkResetMutation({ variables: { input: { details } } });
  };

  const handleBulkResetCancel = () => {
    setIsBulkResetModalVisible(false);
  };

  const handleFormSubmit = (values: {
    pcodeStart: string;
    pcodeEnd: string;
    unitAdditionalFeeExcludeVat: number;
    streetAddress?: string;
  }) => {
    if (editingData) {
      updateMutation({
        variables: {
          id: editingData.id,
          input: values,
        },
      });
    } else {
      createMutation({
        variables: {
          input: values,
        },
      });
    }
  };

  const handleFormCancel = () => {
    setIsFormModalVisible(false);
    setEditingData(null);
  };

  return (
    <>
      <DeliveryAdditionalFeeListPage
        data={courierDeliveryAdditionalFeeList}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        onAdd={handleCreate}
        onBulkDelete={handleBulkDelete}
        onBulkReset={handleBulkReset}
        onUpdate={handleUpdate}
        onDelete={handleDelete}
      />
      {isFormModalVisible && (
        <DeliveryAdditionalFeeFormModal
          visible={isFormModalVisible}
          loading={createLoading || updateLoading}
          editingData={editingData}
          existingFees={courierDeliveryAdditionalFeeList}
          onSubmit={handleFormSubmit}
          onCancel={handleFormCancel}
        />
      )}
      {isBulkResetModalVisible && (
        <DeliveryAdditionalFeeBulkResetModal
          visible={isBulkResetModalVisible}
          loading={bulkResetLoading}
          onSubmit={handleBulkResetSubmit}
          onCancel={handleBulkResetCancel}
        />
      )}
    </>
  );
};
</file>

