import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import ListNavigator from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { usePurchaseLineCountQuery } from "@src/app/views/purchase/purchaseOrders/api/queries";
import { PurchaseLineCount } from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseLineCount";
import {
  usePurchaseListFilterDownloadQuery,
  usePurchaseListQuery,
} from "@src/app/views/purchase/purchases/api/queries";
import { PurchasesVariables } from "@src/app/views/purchase/purchases/api/types/Purchases";
import { PurchaseListViewUrlDialog, PurchaseListViewUrlQueryParams } from "@src/app/views/purchase/purchases/urls";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useEffect, useMemo, useState } from "react";
import { useParams } from "react-router";

import { vsB2bPurchaseListViewUrl, vsB2bPurchaseUrlList } from "../../../vsB2bPurchaseOrder/urls";
import { VsPurchaseListPage } from "../../components/VsPurchaseListPage/VsPurchaseListPage";
import { VsPurchaseBulkCloseModal } from "../../components/VsPurchaseModals/VsPurchaseBulkCloseModal";
import { VsPurchaseBulkReqRevisionModal } from "../../components/VsPurchaseModals/VsPurchaseBulkReqRevisionModal";
import {
  VsPurchaseListViewRouteParams,
  vsPurchaseListViewUrl,
  vsPurchaseNavButtonName,
  VsPurchaseUrlEnum,
  vsPurchaseUrlList,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface VsPurchaseListViewProps {
  defaultParams: PurchaseListViewUrlQueryParams;
  params: PurchaseListViewUrlQueryParams;
  isB2b: boolean;
}

export const getStatusCount = (data: PurchaseLineCount) => {
  const { purchaseLineCount } = data;

  const { standByCount, pendingCount, reqRevisionCount, revisionCount } = purchaseLineCount;
  return {
    [VsPurchaseUrlEnum.ALL_STATUS]: 0,
    [VsPurchaseUrlEnum.STANDBY_OR_REVISION]: standByCount + reqRevisionCount + revisionCount,
    [VsPurchaseUrlEnum.PENDING]: pendingCount,
    [VsPurchaseUrlEnum.CLOSED]: 0,
  };
};

export const VsPurchaseListView: React.FC<VsPurchaseListViewProps> = ({ defaultParams, params, isB2b }) => {
  const routeParams = useParams<VsPurchaseListViewRouteParams>();
  const { user } = useUser();
  const { isVendorStaff } = user;
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);

  const isFbv = routeParams.fulfilledBy === "vendor";
  const { data: countData } = usePurchaseLineCountQuery({
    skip: isFbv,
    variables: {
      filter: {
        isB2b,
        vendorId: isVendorStaff ? user.vendor?.id : undefined,
        isFbv,
      },
    },
  });

  const targetUrl = (params: PurchaseListViewUrlQueryParams) =>
    isB2b ? vsB2bPurchaseListViewUrl(routeParams, params) : vsPurchaseListViewUrl(routeParams, params);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: isB2b ? ListViews.B2B_PURCHASE_LIST : ListViews.PURCHASE_LIST,
  });

  const { fetchForDownload } = utils.initListViewDownloadQuery(usePurchaseListFilterDownloadQuery);

  const filterVariables = getFilterVariables(params, routeParams);
  const queryVariables = useMemo<PurchasesVariables>(
    () => ({
      ...paginationState,
      filter: { ...filterVariables, vendorSearch: user.vendor.code, isB2b: isFbv ? undefined : isB2b },
      sort: getSortQueryVariables(),
    }),
    [params, settings?.rowNumber]
  );

  // TODO: 리우 관리자 페이지에 노출되는 컬럼과 차이가 많은 경우는 fragment 또는 새로운 OperationName 쿼리로 분리하여 사용하는 것이 좋을 듯.
  const { data, loading, refetch } = usePurchaseListQuery({ variables: queryVariables });
  const purchaseList = useMemo(() => maybe(() => data.purchases.edges.map((edge) => edge.node), []), [data]);
  const selectedPurchases = purchaseList.filter((line) => selectedRowIds?.includes(line.id));

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.purchases?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PurchaseListViewUrlDialog, PurchaseListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setSelectedRowIds([]);
    }
  };

  const selectedRowExist = maybe(() => selectedRowIds.length > 0);

  const pageLoading = loading;

  useEffect(() => {
    setSelectedRowIds([]);
  }, [loading, routeParams.fulfilledBy, routeParams.status]);

  return (
    <>
      <VsPurchaseListPage
        params={params}
        settings={settings}
        disabled={pageLoading}
        purchaseList={purchaseList}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, routeParams)}
        onFilterChange={changeFilters}
        fetchForDownload={fetchForDownload}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        isB2b={isB2b}
        isFbv={isFbv}
        ListNavigator={
          isFbv
            ? null
            : () => (
                <ListNavigator<PurchaseListViewUrlQueryParams, VsPurchaseUrlEnum>
                  countOfStatus={countData ? getStatusCount(countData) : null}
                  urlList={isB2b ? vsB2bPurchaseUrlList() : vsPurchaseUrlList(routeParams.fulfilledBy)}
                  NavButtonName={vsPurchaseNavButtonName}
                  skipQueryString={true}
                />
              )
        }
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <VsPurchaseBulkReqRevisionModal
        open={params.action === "bulk-req-revision-purchase" && selectedRowExist}
        loading={pageLoading}
        purchaseIds={selectedRowIds}
        purchaseCloseDate={filterVariables.purchaseCloseDate?.gte}
        onCancel={onModalClose}
      />
      <VsPurchaseBulkCloseModal
        open={params.action === "bulk-close-purchase" && selectedRowExist}
        loading={pageLoading}
        purchases={selectedPurchases}
        purchaseCloseDate={filterVariables.purchaseCloseDate?.gte}
        onCancel={closeModal}
      />
    </>
  );
};
</file>

