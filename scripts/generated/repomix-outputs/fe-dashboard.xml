import { LoadingOutlined } from "@ant-design/icons";
import { isValidPasswordValidator } from "@src/app/components/antd/Form/validators";
import { SetPassword_setPassword_errors } from "@src/app/views/auth/api/types/SetPassword";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { Alert, Button, Form, Input, Space, Spin, Typography } from "antd";
import React from "react";

export interface NewPasswordByEmailPageFormData {
  password: string;
  confirmPassword: string;
}
export interface NewPasswordByEmailPageProps {
  disabled: boolean;
  errors: SetPassword_setPassword_errors[];
  onSubmit: (data: NewPasswordByEmailPageFormData) => void;
}

export const NewPasswordByEmailPage: React.FC<NewPasswordByEmailPageProps> = (props) => {
  const { disabled, errors, onSubmit } = props;

  const error = makeGqlErrorMsg(errors.find((err) => err.field === "password"));

  return (
    <Form onFinish={onSubmit} name="basic" autoComplete="off" colon={false} layout="vertical">
      <Space direction="vertical">
        <Typography.Text>새 비밀번호를 설정해주세요.</Typography.Text>
        <Form.Item
          label={"새 비밀번호"}
          name="password"
          rules={[
            {
              required: true,
              message: "비밀번호를 입력해주세요.",
            },
            ...isValidPasswordValidator(),
          ]}
          hasFeedback
        >
          <Input.Password size="large" placeholder="새 비밀번호" />
        </Form.Item>
        <Form.Item
          label={"비밀번호 확인"}
          name="confirmPassword"
          dependencies={["password"]}
          hasFeedback
          rules={[
            {
              required: true,
              message: "비밀번호를 다시 입력해주세요.",
            },
            ({ getFieldValue }) => ({
              validator(_, value) {
                if (!value || getFieldValue("password") === value) {
                  return Promise.resolve();
                }
