import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  collectionCreateViewPath,
  collectionDetailsViewPath,
  CollectionDetailsViewUrlQueryParams,
  collectionListViewPath,
  CollectionListViewUrlQueryParams,
  CollectionListViewUrlSortField,
} from "./urls";
import { CollectionCreateView } from "./views/CollectionCreateView";
import { CollectionDetailsView } from "./views/CollectionDetailsView";
import { CollectionListView } from "./views/CollectionListView/CollectionListView";

const CollectionListViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: CollectionListViewUrlQueryParams = asSortParams(qs, CollectionListViewUrlSortField);
  return <CollectionListView params={params} />;
};

interface CollectionDetailsViewRouteProps {
  id: string;
}
const CollectionDetailsViewWrapper: React.FC<RouteComponentProps<CollectionDetailsViewRouteProps>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const params: CollectionDetailsViewUrlQueryParams = qs;
  return <CollectionDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

const CollectionSection = () => (
  <>
    <WindowTitle title={sectionNames.collections} />
    <Switch>
      <Route exact path={collectionListViewPath} component={CollectionListViewWrapper} />
      <Route exact path={collectionCreateViewPath} component={CollectionCreateView} />
      <Route path={collectionDetailsViewPath(":id")} component={CollectionDetailsViewWrapper} />
    </Switch>
  </>
);
export default CollectionSection;
</file>

