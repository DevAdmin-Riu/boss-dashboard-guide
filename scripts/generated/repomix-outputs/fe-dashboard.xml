<file path="src/app/views/settings/plugin/components/PluginsDetailsPage/PluginsDetailsPage.tsx">
import { ChangeEvent } from "@hooks/useForm";
import { PluginErrorFragment } from "@src/api/fragments/types/PluginErrorFragment";
import { ConfigurationItemInput } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import { Goodsflow } from "@src/app/components/Goodsflow";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { isSecretField } from "@src/app/views/settings/plugin/utils";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { getStringOrPlaceholder } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Card, Col, Divider, Row, Space, Typography } from "antd";
import React, { useState } from "react";

import { pluginDetailsQuery } from "../../api/queries";
import { Plugin_plugin } from "../../api/types/Plugin";
import { InicisApiKeyList } from "../InicisApiKey/InicisApiKeyList";
import PluginAuthorization from "../PluginAuthorization";
import PluginInfo from "../PluginInfo";
import PluginSettings from "../PluginSettings";

export interface PluginDetailsPageFormData {
  active: boolean;
  showInList: boolean;
  configuration: ConfigurationItemInput[];
}

export interface PluginsDetailsPageProps {
  disabled: boolean;
  errors: PluginErrorFragment[];
  plugin: Plugin_plugin;
  saveButtonBarState: ConfirmButtonTransitionState;
  onBack: () => void;
  onClear: (field: string) => void;
  onEdit: (field: string) => void;
  onSubmit: (data: PluginDetailsPageFormData) => void;
}

const PluginsDetailsPage: React.FC<PluginsDetailsPageProps> = (props) => {
  const { disabled, errors, plugin, saveButtonBarState, onBack, onClear, onEdit, onSubmit } = props;

  const initialForm: PluginDetailsPageFormData = {
    active: plugin?.active || false,
    showInList: plugin?.showInList || false,
    configuration: plugin?.configuration
      ?.filter((field) => !isSecretField(plugin?.configuration || [], field.name))
      .map((field) => ({
        ...field,
        value: field.value || "",
      })),
  };

  const GOODSFLOW_PLUGIN_ID = "plugin.goodsflow";
  const INICIS_PLUGIN_ID = "plugin.inicis";
  const shop = useShop();
  const [onActionForModeA, setOnActionForModeA] = useState(false);
  const handleError = (errMessage) => {
    showNotificationError(errMessage);
    setOnActionForModeA(false);
  };
  const handleGoodsflowContractSuccess = () => {
    setOnActionForModeA(false);
  };

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.plugins}</AppHeader>
      <PageHeader
        title={
          <Row justify="space-between">
            <Col>
              <Typography.Title level={4}>
                {utils.formatMessage("{pluginName} 상세 정보", {
                  pluginName: getStringOrPlaceholder(plugin?.name),
                })}
              </Typography.Title>
            </Col>
            {plugin?.id === GOODSFLOW_PLUGIN_ID && (
              <Col>
                <Space direction="horizontal" size={8}>
                  <Goodsflow
                    loading={onActionForModeA}
                    mode="contract"
                    setLoading={setOnActionForModeA}
                    onError={handleError}
                    onSuccess={handleGoodsflowContractSuccess}
                    config={shop?.goodsflowPluginConfig}
                  />
                </Space>
              </Col>
            )}
          </Row>
        }
      />

      <Space direction="vertical" size="large">
        <Form initial={initialForm} onSubmit={onSubmit}>
          {({ data, hasChanged, submit, set, triggerChange }) => {
            const onChange = (event: ChangeEvent) => {
              const { name, value } = event.target;
              const newData = {
                active: name === "active" ? value : data.active,
                showInList: name === "showInList" ? value : data.showInList,
                configuration: utils.deepCopy(data.configuration),
              };

              if (newData.configuration) {
                newData.configuration.map((item) => {
                  if (item.name === name) {
                    item.value = value;
                  }
                });
              }
              triggerChange();
              set(newData);
            };
            return (
              <Space direction="vertical" size="large">
                <Card>
                  <PluginInfo
                    data={data}
                    description={plugin?.description || ""}
                    errors={errors}
                    name={plugin?.name || ""}
                    onChange={onChange}
                  />
                </Card>
                <Card>
                  {data.configuration && (
                    <Space direction="vertical" split={<Divider />}>
                      <PluginSettings
                        data={data}
                        fields={plugin?.configuration || []}
                        errors={errors}
                        disabled={disabled}
                        onChange={onChange}
                      />
                      {plugin?.configuration.some((field) => isSecretField(plugin.configuration, field.name)) && (
                        <PluginAuthorization fields={plugin.configuration} onClear={onClear} onEdit={onEdit} />
                      )}
                    </Space>
                  )}
                </Card>
                <SaveButtonBar
                  disabled={disabled || !hasChanged}
                  state={saveButtonBarState}
                  onCancel={onBack}
                  onSave={submit}
                />
              </Space>
            );
          }}
        </Form>
        {plugin?.id === INICIS_PLUGIN_ID && (
          <Card>
            <InicisApiKeyList
              iniApiKeys={plugin?.inicisApiKeys}
              disabled={disabled}
              refetchQuery={pluginDetailsQuery}
            />
          </Card>
        )}
      </Space>
    </>
  );
};
export default PluginsDetailsPage;
</file>

