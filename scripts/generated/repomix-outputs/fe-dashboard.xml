import useNavigator from "@hooks/useNavigator";
import useWarehouseSearch from "@src/api/searches/useWarehouseSearch";
import { ShippingMethodTypeEnum } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  useShippingRateCreateMutation,
  useShippingRateDeleteMutation,
  useShippingRateUpdateMutation,
  useShippingZoneDeleteMutation,
  useShippingZoneUpdateMutation,
} from "@src/app/views/settings/shipping/api/mutations";
import ShippingZoneAddWarehouseDialog from "@src/app/views/settings/shipping/components/ShippingZoneAddWarehouseDialog";
import ShippingZoneCountriesAssignDialog from "@src/app/views/settings/shipping/components/ShippingZoneCountriesAssignDialog";
import ShippingZoneRateDialog from "@src/app/views/settings/shipping/components/ShippingZoneRateDialog";
import { useWarehouseCreateMutation } from "@src/app/views/settings/warehouses/api/mutations";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Modal } from "antd";
import { diff } from "fast-array-diff";
import React from "react";

import { useShippingZoneDetailsQuery } from "../../api/queries";
import ShippingZoneDetailsPage, { IShippingZoneUpdateForm } from "../../components/ShippingZoneDetailsPage";
import {
  shippingZoneDetailsViewUrl,
  ShippingZoneDetailsViewUrlQueryParams,
  shippingZoneListViewUrl,
  ShippingZoneUrlDialog,
} from "../../urls";
import { getShippingRateCreateVariables, getShippingRateUpdateVariables } from "./data";

interface ShippingZoneDetailsViewProps {
  id: string;
  params: ShippingZoneDetailsViewUrlQueryParams;
}

export const ShippingZoneDetailsView: React.FC<ShippingZoneDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();
  const shop = useShop();

  const {
    result: searchWarehousesOpts,
    loadMore,
    search,
  } = useWarehouseSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });

  const { data, loading } = useShippingZoneDetailsQuery({ variables: { id } });

  const [openModal, closeModal] = createDialogActionHandlers<
    ShippingZoneUrlDialog,
    ShippingZoneDetailsViewUrlQueryParams
  >(navigate, (params) => shippingZoneDetailsViewUrl(id, params), params);
  const rate = data?.shippingZone?.shippingMethods.find((rate) => rate.id === params.id);

  const [shippingRateCreate, shippingRateCreateOpts] = useShippingRateCreateMutation({
    onCompleted: (data) => {
      const errors = data.shippingPriceCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [shippingRateUpdate, shippingRateUpdateOpts] = useShippingRateUpdateMutation({
    onCompleted: (data) => {
      const errors = data.shippingPriceUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [shippingRateDelete, shippingRateDeleteOpts] = useShippingRateDeleteMutation({
    onCompleted: (data) => {
      const errors = data.shippingPriceDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [shippingZoneDelete, shippingZoneDeleteOpts] = useShippingZoneDeleteMutation({
    onCompleted: (data) => {
      const errors = data.shippingZoneDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(shippingZoneListViewUrl(), true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [shippingZoneUpdate, shippingZoneUpdateOpts] = useShippingZoneUpdateMutation({
    onCompleted: (data) => {
      const errors = data.shippingZoneUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [warehouseCreate, warehouseCreateOpts] = useWarehouseCreateMutation({
    onCompleted: (data) => {
      const errors = data.createWarehouse.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleSubmit = async (submitData: IShippingZoneUpdateForm) => {
    const warehouseDiff = diff(
      data.shippingZone.warehouses.map((warehouse) => warehouse.id),
      submitData.warehouses
    );

    const result = await shippingZoneUpdate({
      variables: {
        id,
        input: {
          addWarehouses: warehouseDiff.added,
          name: submitData.name,
          removeWarehouses: warehouseDiff.removed,
        },
      },
    });

    return result.data.shippingZoneUpdate.errors;
  };

  if (data?.shippingZone === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(shippingZoneListViewUrl())} />;
  }

  return (
    <>
      <ShippingZoneDetailsPage
        disabled={loading}
        onBack={() => navigate(shippingZoneListViewUrl())}
        onCountryAdd={() => openModal("assign-country")}
        onCountryRemove={(code) => openModal("unassign-country", { id: code })}
        onDelete={() => openModal("remove")}
        onPriceRateAdd={() => openModal("add-rate", { type: ShippingMethodTypeEnum.PRICE })}
        onPriceRateEdit={(rateId) => openModal("edit-rate", { id: rateId })}
        onRateRemove={(rateId) => openModal("remove-rate", { id: rateId })}
        onSubmit={handleSubmit}
        onWarehouseAdd={() => openModal("add-warehouse")}
        onWeightRateAdd={() => openModal("add-rate", { type: ShippingMethodTypeEnum.WEIGHT })}
        onWeightRateEdit={(rateId) => openModal("edit-rate", { id: rateId })}
        saveButtonBarState={shippingZoneUpdateOpts.status}
        shippingZone={data?.shippingZone}
        warehouses={searchWarehousesOpts.data?.search.edges.map((edge) => edge.node) || []}
        hasMore={searchWarehousesOpts.data?.search.pageInfo.hasNextPage}
        loading={searchWarehousesOpts.loading}
        onFetchMore={loadMore}
        onSearchChange={search}
      />
      <ShippingZoneRateDialog
        action="create"
        open={params.action === "add-rate"}
        loading={shippingRateCreateOpts.loading}
        rate={undefined}
        shippingMethodType={params.type}
        onClose={closeModal}
        onSubmit={(formData) => shippingRateCreate({ variables: getShippingRateCreateVariables(formData, params, id) })}
      />
      <ShippingZoneRateDialog
        action="edit"
        open={params.action === "edit-rate"}
        loading={shippingRateUpdateOpts.loading}
        rate={rate}
        shippingMethodType={rate?.type}
        onClose={closeModal}
        onSubmit={(formData) =>
          shippingRateUpdate({
            variables: getShippingRateUpdateVariables(
              formData,
              data?.shippingZone?.shippingMethods.find((shippingMethod) => shippingMethod.id === params.id),
              id
            ),
          })
        }
      />
      <Modal
        open={params.action === "remove-rate"}
        title="배송비 삭제"
        okText="삭제"
        okButtonProps={{ danger: true, loading: shippingRateDeleteOpts.loading }}
        onOk={() => shippingRateDelete({ variables: { id: params.id } })}
        onCancel={closeModal}
      >
        선택한 배송비({maybe(() => rate?.name, "-")})를 삭제하시겠습니까?
      </Modal>
      <Modal
        open={params.action === "remove"}
        title="배송 지역 삭제"
        okText="삭제"
        okButtonProps={{ danger: true, loading: shippingZoneDeleteOpts.loading }}
        onOk={() => shippingZoneDelete({ variables: { id } })}
        onCancel={closeModal}
      >
        현재 배송 지역({maybe(() => data?.shippingZone.name, "-")})을 삭제하시겠습니까?
      </Modal>
      <ShippingZoneCountriesAssignDialog
        open={params.action === "assign-country"}
        countries={shop?.shippingCountries || []}
        initial={data?.shippingZone?.countries.map((country) => country.code) || []}
        isDefault={data?.shippingZone?.default}
        onClose={closeModal}
        onConfirm={(formData) =>
          shippingZoneUpdate({
            variables: {
              id,
              input: {
                countries: formData.countries,
                default: formData.restOfTheWorld,
              },
            },
          })
        }
      />
      <Modal
        open={params.action === "unassign-country"}
        title="지역 연동 해제"
        okText="연동 해제"
        okButtonProps={{ danger: true, loading: shippingZoneUpdateOpts.loading }}
        onOk={() =>
          shippingZoneUpdate({
            variables: {
              id,
              input: {
                countries: data.shippingZone.countries
                  .filter((country) => country.code !== params.id)
                  .map((country) => country.code),
              },
            },
          })
        }
        onCancel={closeModal}
      >
        이 배송 지역에서 선택한 지역(
        {maybe(() => data?.shippingZone?.countries.find((country) => country.code === params.id)?.country, "-")})을
        삭제하시겠습니까?
      </Modal>
      <ShippingZoneAddWarehouseDialog
        countries={shop?.shippingCountries || []}
        disabled={warehouseCreateOpts.loading}
        open={params.action === "add-warehouse"}
        confirmButtonState={warehouseCreateOpts.status}
        errors={warehouseCreateOpts.data?.createWarehouse.errors || []}
        onClose={closeModal}
        onSubmit={(data) =>
          warehouseCreate({
            variables: {
              input: {
                companyName: data.companyName,
                name: data.name,
              },
            },
          })
        }
      />
    </>
  );
};
</file>

