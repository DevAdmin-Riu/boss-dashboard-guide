import { commonMsg } from "@assets/messages/commonMsg";
import { PurchaseOrderEventType } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getMobileSelectClassName } from "@src/app/components/antd/Select/SelectProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { NumberComponent } from "@src/app/components/Number";
import { getSalesUnitTypeText } from "@src/app/views/product/products/utils/data";
import { makeRackLocationLabel } from "@src/app/views/product/stock/components/ProductInfoForStockAction";
import { calcTotalExcludeVatByUnitExcludeVatAndQty } from "@utils/excel/excelDownload";
import { findValueInEnum, makePOLeadTimeFormat, transformAddress, transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import { Badge, Button, DatePicker, Form, InputNumber, Select, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import moment, { Moment } from "moment";
import React from "react";

import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import { checkConsignmentTakeBackPurchaseOrder, checkTakeBackPurchaseOrder } from "../../utils";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePageFormData,
} from "../PurchaseOrderCreatePage/PurchaseOrderCreatePage";
import {
  makeProductQtyPerBoxFromPoLine,
  makeProductSpecFromPoLine,
} from "../PurchaseOrderLineListPage/PurchaseOrderLineListTableSettings";
import { multiplePoEventTypeTackBackValue } from "../PurchaseOrderLineListPage/utils";

interface PurchaseOrderTakeBackLinesTableSettingsProps {
  watchedValues: Pick<PurchaseOrderCreatePageFormData, "purchaseOrderDate" | "eventType" | "vendor">;
  disabled: boolean;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
}

// trackInventory: 생성 화면 진입 이전에 재고(초도, 재발주)로부터 생성하려는 경우에도 체크하기 위해 전달. 초도발주, 재발주, 재고반품인 경우는 true로 전달해야 함.
export const checkTakeBackDisabled = (
  takeBackPurchaseOrderLine: Pick<
    IPurchaseOrderCreateLine["takeBackPurchaseOrderLine"] | PurchaseOrderLineList_purchaseOrderLines_edges_node,
    "remainQuantity" | "stockDetail"
  >,
  trackInventory: boolean
) => {
  const zeroRemainQuantity = takeBackPurchaseOrderLine.remainQuantity === 0;
  if (trackInventory) {
    const stockDetail = takeBackPurchaseOrderLine.stockDetail;
    const rackStockEmpty = utils.isEmpty(stockDetail) || utils.isEmpty(stockDetail.rackStocks);
    return zeroRemainQuantity && rackStockEmpty;
  }
  return zeroRemainQuantity;
};

export const getPurchaseOrderTakeBackLinesTableSettings = (props: PurchaseOrderTakeBackLinesTableSettingsProps) => {
  const { watchedValues, disabled, openModalWithoutNavigate } = props;
  // 재고 반품 여부
  const isTackBackPurchaseOrder = checkTakeBackPurchaseOrder(watchedValues.eventType);
  // 위탁 반품 여부
  const isConsignmentTakeBackPurchaseOrder = checkConsignmentTakeBackPurchaseOrder(watchedValues.eventType);

  const columns: ColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: "No",
      key: "number",
      fixed: utils.fixedLeftFlag(),
      align: "center",
      width: 50,
      render: (_, _record, idx) => idx + 1,
    },
  ];
  if (isConsignmentTakeBackPurchaseOrder) {
    columns.push({
      title: columnNameConstant.order.ORDER_COMPOSED_ID,
      key: "orderNumber",
      align: "center",
      width: 80,
      render: (_, record) => record.takeBackPurchaseOrderLine.orderLine?.order?.composedIdWithPrefix,
    });
    columns.push({
      title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
      key: "orderLineComposedId",
      align: "center",
      width: 120,
      render: (_, record) => record.takeBackPurchaseOrderLine.orderLine?.composedIdWithPrefix,
    });
  }
  columns.push({
    title: columnNameConstant.purchaseOrder.REFUNDED_ASKING_DATE,
    key: "date",
    align: "center",
    width: 170,
    render: (_, record) => {
      const disabledDate = (current: Moment) =>
        current && current < moment(watchedValues.purchaseOrderDate).startOf("day");
      return (
        <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "askingPurchaseDate"]}>
          <DatePicker
            style={{ width: "100%" }}
            disabled={checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder)}
            disabledDate={disabledDate}
            allowClear={false}
          />
        </Form.Item>
      );
    },
  });
  if (isTackBackPurchaseOrder) {
    columns.push({
      title: "반품 로케이션",
      key: "rackLocation",
      align: "center",
      width: 300,
      render: (_, record) => {
        const rackStocks = record.takeBackPurchaseOrderLine.stockDetail?.rackStocks;
        if (!rackStocks) {
          return (
            <MultiLineTypography
              lines={[
                <Typography.Text type="secondary">반품 가능한</Typography.Text>,
                <Typography.Text type="secondary">로케이션 없음</Typography.Text>,
              ]}
            />
          );
        }
        const locationOptions = rackStocks.map((rackStock) => ({
          label: makeRackLocationLabel(rackStock.location, rackStock.remainQuantity, {
            direction: "vertical",
            size: 0,
          }),
          value: rackStock.location.id,
        }));

        return (
          <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "rackLocation"]}>
            <Select
              style={{ width: 300 }}
              {...getMobileSelectClassName()}
              disabled={checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder)}
              placeholder="로케이션 선택"
              options={locationOptions}
              notFoundContent="제품에 연동된 로케이션이 없습니다. 로케이션을 먼저 연동 후 반품을 진행해주세요."
              dropdownMatchSelectWidth={false}
            />
          </Form.Item>
        );
      },
    });
  }

  const productColumns: ColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 150,
      render: (_, record) => {
        const isProductVariantNoteExist = !utils.isEmpty(record.takeBackPurchaseOrderLine.variant?.note, true);
        const onSkuClick = () =>
          openModalWithoutNavigate(PurchaseOrderModalModeEnum.QueryVariantNote, record.takeBackPurchaseOrderLine.id);
        return isProductVariantNoteExist ? (
          <Button type={"text"} onClick={onSkuClick}>
            <Badge dot={isProductVariantNoteExist} offset={[5, 0]}>
              {record.takeBackPurchaseOrderLine.productSku}
            </Badge>
          </Button>
        ) : (
          <Typography.Text>{record.takeBackPurchaseOrderLine.productSku}</Typography.Text>
        );
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 200,
      render: (_, record) => record.takeBackPurchaseOrderLine.productName || "-",
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) => record.takeBackPurchaseOrderLine.variantName || "-",
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 200,
      render: (_, record) => {
        const specText = makeProductSpecFromPoLine(record.takeBackPurchaseOrderLine);
        if (utils.isEmpty(record.takeBackPurchaseOrderLine.variantName)) {
          return specText;
        }
        return `${record.takeBackPurchaseOrderLine.variantName}; ${specText}`;
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "right",
      width: 90,
      render: (_, record) =>
        makeProductQtyPerBoxFromPoLine(
          record.takeBackPurchaseOrderLine,
          record.takeBackPurchaseOrderLine.variant.qtyPerBoxUnitType
        ),
    },
    {
      title: columnNameConstant.common.LEAD_TIME,
      key: "poLeadTime",
      align: "center",
      width: 90,
      render: (_, record) => makePOLeadTimeFormat(record.takeBackPurchaseOrderLine.variant.poLeadTime),
    },
  ];

  const vendorColumns: ColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.vendor.EXTERNAL_SKU,
      key: "externalSku",
      align: "center",
      width: 150,
      render: (_, record) => {
        const value = record.takeBackPurchaseOrderLine.externalSku;
        return value;
      },
    },
    {
      title: columnNameConstant.vendor.EXTERNAL_PRODUCT_NAME,
      key: "externalProductName",
      align: "center",
      width: 200,
      render: (_, record) => {
        const value = record.takeBackPurchaseOrderLine.externalProductName;
        return value;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.PO_MOQ,
      key: "moq",
      align: "center",
      width: 110,
      render: (_, record) => {
        const selectedProductVariantVendor = record.takeBackPurchaseOrderLine.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === watchedValues.vendor
        );
        const value = selectedProductVariantVendor?.moq || "-";
        return value;
      },
    },
  ];

  let purchaseOrderColumns: ColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.stock.PURCHASE_DONE_QTY,
      key: "purchaseQuantity",
      align: "right",
      width: 110,
      render: (_, record) => <NumberComponent value={record.takeBackPurchaseOrderLine.purchaseQuantity} />,
    },
    {
      title: columnNameConstant.purchaseOrder.REFUNDABLE_QTY,
      key: "takeBackAvailableQuantity",
      align: "right",
      width: 110,
      render: (_, record) => <NumberComponent value={record.takeBackPurchaseOrderLine.remainQuantity} />,
    },
    {
      title: columnNameConstant.purchaseOrder.PO_AMOUNT,
      key: "quantity",
      align: "right",
      width: 120,
      render: (_, record) => {
        const takeBackAvailableQuantity = record.takeBackPurchaseOrderLine.remainQuantity;
        return (
          <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "quantity"]}>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              addonBefore="-"
              disabled={disabled || checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder)}
              max={takeBackAvailableQuantity}
              min={0}
            />
          </Form.Item>
        );
      },
    },
    {
      title: "발주단위",
      key: "salesUnitType",
      align: "center",
      width: 90,
      render: (_, record) => getSalesUnitTypeText(record.takeBackPurchaseOrderLine.variant.salesUnitType),
    },
    isConsignmentTakeBackPurchaseOrder && {
      title: "상품가",
      key: "productPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.takeBackPurchaseOrderLine.productPriceExcludeVat} />,
    },
    isConsignmentTakeBackPurchaseOrder && {
      title: "배송비",
      key: "deliveryFeeExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.takeBackPurchaseOrderLine.deliveryFeeExcludeVat} />,
    },
    isConsignmentTakeBackPurchaseOrder && {
      title: <MultiLineTypography lines={columnNameConstant.order.DELIVERY_ADDITIONAL_FEE} />,
      key: "consignmentUnitDeliveryAdditionalFeeExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => (
        <NumberComponent value={record.takeBackPurchaseOrderLine.consignmentUnitDeliveryAdditionalFeeExcludeVat} />
      ),
    },
    {
      title: "매입가",
      key: "costPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.costPriceExcludeVat} />,
    },
    {
      title: isConsignmentTakeBackPurchaseOrder ? (
        <MultiLineTypography
          lines={[columnNameConstant.purchaseOrder.REFUNDED_PRODUCT_TOTAL_AMOUNT, commonMsg.excludeDelivery]}
        />
      ) : (
        columnNameConstant.purchaseOrder.REFUNDED_PRODUCT_TOTAL_AMOUNT
      ),
      key: "takeBackTotalCostPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        const eventTypeValue = findValueInEnum(watchedValues.eventType, PurchaseOrderEventType);
        const totalCostPriceExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.takeBackPurchaseOrderLine.isTaxFree
        );
        const value = multiplePoEventTypeTackBackValue(eventTypeValue, totalCostPriceExcludeVat);
        return <NumberComponent value={value} />;
      },
    },
    {
      title: "기타비용",
      key: "etcExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => (
        <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "etcExcludeVat"]}>
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            disabled={disabled || checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder)}
          />
        </Form.Item>
      ),
    },
    isConsignmentTakeBackPurchaseOrder && {
      title: "반품 배송비(개당)",
      key: "takeBackUnitCostDeliveryFeeExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => (
        <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "takeBackUnitCostDeliveryFeeExcludeVat"]}>
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            disabled={disabled || checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder)}
          />
        </Form.Item>
      ),
    },
    {
      title: "합계",
      key: "totalExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        const eventTypeValue = findValueInEnum(watchedValues.eventType, PurchaseOrderEventType);
        const takeBackTotalCostPriceExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.takeBackPurchaseOrderLine.isTaxFree
        );
        const takeBackTotalCostDeliveryFeeExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.takeBackUnitCostDeliveryFeeExcludeVat,
          record.quantity,
          false
        );

        // 반품 발주 시, 개발비(devCostExcludeVat)는 0원으로 고정이므로 계산식에서 제외
        const value =
          multiplePoEventTypeTackBackValue(eventTypeValue, takeBackTotalCostPriceExcludeVat) +
          record.etcExcludeVat +
          takeBackTotalCostDeliveryFeeExcludeVat;
        return <NumberComponent value={value} />;
      },
    },
  ];
  purchaseOrderColumns = purchaseOrderColumns.filter(Boolean);

  columns.push({
    title: "제품 정보",
    children: productColumns,
  });
  columns.push({
    title: "반품 정보",
    children: purchaseOrderColumns,
  });
  columns.push({
    title: "협력사 정보",
    children: vendorColumns,
  });

  if (isConsignmentTakeBackPurchaseOrder) {
    const addressColumns: ColumnsType<IPurchaseOrderCreateLine> = [
      {
        title: "수령인",
        key: "firstName",
        align: "center",
        width: 150,
        render: (_, record) => record.takeBackPurchaseOrderLine.shippingAddress?.firstName || "-",
      },
      {
        title: "연락처",
        key: "phone",
        align: "center",
        width: 150,
        render: (_, record) => transformPhoneNumber(record.takeBackPurchaseOrderLine.shippingAddress?.phone) || "-",
      },
      {
        title: "주소",
        key: "address",
        align: "center",
        width: 300,
        render: (_, record) => transformAddress(record.takeBackPurchaseOrderLine.shippingAddress),
      },
    ];
    columns.push({
      title: "회수장소",
      children: addressColumns,
    });
  }

  return columns;
};
</file>

