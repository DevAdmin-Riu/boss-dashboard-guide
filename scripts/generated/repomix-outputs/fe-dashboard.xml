export type TProductVariantForStockSalesKey = Pick<
  ProductVariantList_productVariants_edges_node,
  | "last2MonthsAvgSalesMonthlyQty"
  | "last3MonthsAvgSalesMonthlyQty"
  | "last3MonthsAvgSalesDailyQty"
  | "last30DaysAvgSalesDailyQty"
  | "thisWeekSalesQuantity"
  | "lastWeekSalesQuantity"
  | "twoWeeksAgoSalesQuantity"
  | "threeWeeksAgoSalesQuantity"
  | "fourWeeksAgoSalesQuantity"
  | "thisMonthSalesQuantity"
  | "lastMonthSales"
  | "twoMonthsAgoSales"
  | "threeMonthsAgoSales"
>;
type TProductVariantForStockSales = Pick<ProductVariantList_productVariants_edges_node, "firstAvailableForPurchase"> &
  Partial<TProductVariantForStockSalesKey>;

export const getStockSalesValue = (
  productVariant: TProductVariantForStockSales,
  salesKey: keyof TProductVariantForStockSalesKey,
  forExcel: boolean = false
) => {
  const value = productVariant[salesKey];
  const targetDateStr = productVariant.firstAvailableForPurchase;
  let digits = 0;
  let duration = 0;
  let durationType = statsDateType.MONTHLY;
  switch (salesKey) {
    // 2개월 평균 판매량
    case "last2MonthsAvgSalesMonthlyQty":
      digits = 1;
      duration = 2;
      break;
    // 3개월 월 평균 판매량
    case "last3MonthsAvgSalesMonthlyQty":
      digits = 1;
      duration = 3;
      break;
    // 3개월 일 평균 판매량
    case "last3MonthsAvgSalesDailyQty":
      digits = 2;
      duration = 3;
      break;
    // 주간 판매량 - 금주(이번주)
    case "thisWeekSalesQuantity":
      duration = 0;
      durationType = statsDateType.WEEKLY;
      break;
    // 주간 판매량 - 전주(지난주)
    case "lastWeekSalesQuantity":
      duration = 1;
      durationType = statsDateType.WEEKLY;
      break;
    // 주간 판매량 - 2주 전
    case "twoWeeksAgoSalesQuantity":
      duration = 2;
      durationType = statsDateType.WEEKLY;
      break;
    // 주간 판매량 - 3주 전
    case "threeWeeksAgoSalesQuantity":
      duration = 3;
      durationType = statsDateType.WEEKLY;
      break;
    // 주간 판매량 - 4주 전
    case "fourWeeksAgoSalesQuantity":
      duration = 4;
      durationType = statsDateType.WEEKLY;
      break;
    // 월 판매량 - 전월
    case "lastMonthSales":
      duration = 1;
      break;
    // 월 판매량 - 2개월 전
    case "twoMonthsAgoSales":
      duration = 2;
      break;
    // 월 판매량 - 3개월 전
    case "threeMonthsAgoSales":
      duration = 3;
      break;
    default:
      return 0;
  }
  return makeValidSalesValueByDuration({ value, digits, targetDateStr, duration, durationType, forExcel });
};

// 금월 판매량 - 일 평균
export const getStockThisMonthSalesAvgQty = (
  productVariant: Pick<
    ProductVariantList_productVariants_edges_node,
    "firstAvailableForPurchase" | "thisMonthSalesQuantity"
  >
) => {
  const { firstAvailableForPurchase, thisMonthSalesQuantity } = productVariant;
  const today = moment();
  if (today.date() === 1 || thisMonthSalesQuantity === 0) {
    return thisMonthSalesQuantity;
  }

  const momentFirstAvailableForPurchase = moment(firstAvailableForPurchase, onlyDateFormat);
  const isFirstAvailableThisMonth =
    momentFirstAvailableForPurchase.year() === today.year() &&
    momentFirstAvailableForPurchase.month() === today.month();

  const calculateAverage = (startDate: moment.Moment, endDate: moment.Moment) => {
    const daysFromStartToYesterday = endDate.diff(startDate, "days");
    return daysFromStartToYesterday === 0 ? thisMonthSalesQuantity : thisMonthSalesQuantity / daysFromStartToYesterday;
  };
  // 이번 달부터 판매하기 시작한 경우, 이번 달 판매량을 판매 게시한 날부터 어제까지의 일 평균 판매량으로 계산
  if (isFirstAvailableThisMonth) {
    return calculateAverage(momentFirstAvailableForPurchase, today);
  }
  // 판매 게시일이 이번 달이 아닌 경우, 이번 달 판매량을 이번 달의 첫날부터 어제까지의 일 평균 판매량으로 계산
  const startOfMonth = today.clone().startOf("month");
  return calculateAverage(startOfMonth, today);
};

