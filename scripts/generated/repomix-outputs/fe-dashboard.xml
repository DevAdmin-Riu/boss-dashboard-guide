export interface BrandGroupListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandGroupListFilterKeys, BrandGroupListFilterOpts> {
  brandGroupList: BrandGroupList_brandGroupList_edges_node[];
  selectedRowKeys: string[];
  onSelectedRowKeysChange: (selectedRowKeys: string[]) => void;
  onCreate: () => void;
  onUpdate: (id: string) => void;
  onDelete: (id: string) => void;
  onBulkDelete: () => void;

  queryVariablesWithoutPagination: BrandGroupListVariables;
  fetchForDownload: (variables?: BrandGroupListVariables) => Promise<ApolloQueryResult<BrandGroupList>>;
}

export const BrandGroupListPage: React.FC<BrandGroupListPageProps> = (props) => {
  const {
    brandGroupList,
    currencySymbol,
    currentTab,
    filterOpts,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    selectedRowKeys,
    onSelectedRowKeysChange,
    onCreate,
    onUpdate,
    onDelete,
    onBulkDelete,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);
  const columns = getBrandGroupListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
