interface IPurchaseTableSettingsPropsForEditing {
  loading: boolean;
  selectedPurchaseId: string;
  isEditing: (record: Purchases_purchases_edges_node) => boolean;
  vendorOptions: Array<{ label: string; value: any }>;
  vendorsSearch: (query: string) => void;
  onEdit: (record: Purchases_purchases_edges_node) => void;
  onCancel: () => void;
  onSubmit: () => void;
  openModal: (action: PurchaseListViewUrlDialog, newParams?: PurchaseListViewUrlQueryParams) => void;
}

interface IPurchaseTableSettingsProps {
  routeParams: PurchaseListViewRouteParams;
  formValuesWatched: ExtendedPurchaseUpdateInput;
  editingProps?: IPurchaseTableSettingsPropsForEditing;
  navigate: UseNavigatorResult;
  isB2b: boolean;
}

export const makePurchaseClosedDateCol = (): DownloadableEditableColumnType<Purchases_purchases_edges_node> => ({
  title: columnNameConstant.purchase.SETTLEMENT_MONTH,
  key: "purchaseClosedDate",
