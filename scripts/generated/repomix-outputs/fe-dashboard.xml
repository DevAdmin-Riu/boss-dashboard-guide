import { FormChange } from "@hooks/useForm";
import { onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { Checkbox, DatePicker, Space } from "antd";
import moment, { Moment } from "moment";
import React, { useState } from "react";

import { PopupCreatePageFormData } from "../PopupCreatePage";
import { PopupDetailsPageFormData } from "../PopupDetailsPage";

export interface PopupRangePickerProps {
  data: PopupCreatePageFormData | PopupDetailsPageFormData;
  formErrors: any;
  onChange: FormChange;
}

const { RangePicker } = DatePicker;

const PopupRangePicker = (props: PopupRangePickerProps) => {
  const { data, formErrors, onChange } = props;
  const defaultStartDate = moment(data.start, onlyDateFormat);
  const defaultEndDate = moment(data.end, onlyDateFormat);
  const popupEndExist = defaultEndDate.diff(defaultStartDate, "years") <= 100; // 현재 게시일과 마감일의 연도 차이가 100년을 넘으면 마감일 미설정으로 취급

  const [popupEndChecked, setPopupEndChecked] = useState(popupEndExist);
  const [startDate, setStartDate] = useState(defaultStartDate);
  const [endDate, setEndDate] = useState(defaultEndDate);

  const onRangeChange = (values: Array<Moment | null>, valuesString: String[]) => {
    setStartDate(values ? values[0] : null);
    setEndDate(values ? values[1] : null);
    onChange({
      target: { name: "start", value: valuesString[0] },
    });
    onChange({
      target: { name: "end", value: valuesString[1] },
    });
  };

  const onDateChange = (value: Moment | null, valueString: String) => {
    setStartDate(value);
    onChange({
      target: { name: "start", value: valueString },
    });
  };

  const popupEndByCheck = (popupEndChecked: boolean) => {
    setEndDate(null);

    return popupEndChecked
      ? onChange({ target: { name: "end", value: "2500-12-31" } }) // 마감일 미설정 체크하면 마감일을 자동으로 2500-12-31로 설정
      : onChange({ target: { name: "end", value: "" } });
  };

  return (
    <Space direction="vertical" size={0}>
      <Checkbox
        name="selectPopupEnd"
        checked={popupEndChecked}
        onChange={() => {
          setPopupEndChecked(!popupEndChecked);
          popupEndByCheck(popupEndChecked);
        }}
      >
        팝업 게시 마감일 설정
      </Checkbox>
      {popupEndChecked ? (
        <RangePicker
          size="large"
          style={{ width: "100%" }}
          status={!formErrors.start && !formErrors.end ? null : "error"}
          format={onlyDateFormat}
          allowEmpty={[false, false]}
          value={[startDate, endDate]}
          onChange={onRangeChange}
        />
      ) : (
        <DatePicker
          size="large"
          style={{ width: "100%" }}
          placeholder={"시작일"}
          status={!formErrors.start ? null : "error"}
          format={onlyDateFormat}
          value={startDate}
          onChange={onDateChange}
        />
      )}
    </Space>
  );
};
export default PopupRangePicker;
</file>

<file path="src/app/views/notice/popups/views/PopupListView/PopupListView.tsx">
import { usePopupListQuery } from "@src/app/views/notice/popups/api/queries";
import PopupListPage from "@src/app/views/notice/popups/components/PopupListPage";
import {
  hqPopupCreateViewUrl,
  hqPopupListViewUrl,
  popupCreateViewUrl,
  popupListViewUrl,
  PopupListViewUrlQueryParams,
} from "@src/app/views/notice/popups/urls";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { getSortQueryVariables } from "./sort";

interface PopupListViewProps {
  params: PopupListViewUrlQueryParams;
  isHqPopup: boolean;
}

export const PopupListView: React.FC<PopupListViewProps> = ({ params, isHqPopup }) => {
  const targetUrl = isHqPopup ? hqPopupListViewUrl : popupListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.POPUP_LIST,
  });
  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
      sort: getSortQueryVariables(params),
      filter: {
        isHqPopup,
      },
    }),
    [params, isHqPopup, settings?.rowNumber]
  );

  const { data: popupListData, loading: popupListLoading } = usePopupListQuery({
    variables: queryVariables,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: popupListData?.popups?.pageInfo,
    paginationState,
    params,
  });

  return (
    <>
      <PopupListPage
        params={params}
        popups={maybe(() => popupListData?.popups?.edges.map((edge) => edge.node))}
        disabled={popupListLoading}
        settings={settings}
        onAdd={() => navigate(isHqPopup ? hqPopupCreateViewUrl : popupCreateViewUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        isHqPopup={isHqPopup}
      />
    </>
  );
};
</file>

<file path="src/app/views/notice/popups/views/PopupListView/sort.ts">
import { PopupSortField } from "@src/api/types/globalTypes";
import { PopupListViewUrlSortField } from "@src/app/views/notice/popups/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: PopupListViewUrlSortField): PopupSortField {
  switch (sort) {
    case PopupListViewUrlSortField.end:
      return PopupSortField.END_DATE;
    case PopupListViewUrlSortField.start:
      return PopupSortField.START_DATE;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
</file>

