import { Col, DatePicker, Radio, RadioChangeEvent, Row, Space } from "antd";
import type { PanelMode } from "rc-picker/lib/interface";
import React, { useState } from "react";

import { durationSettingsForDaily, durationSettingsForMonthly } from "./settings";

const { RangePicker } = DatePicker;

interface CustomRangePickerPropsProps {
  initDuration: any;
  onChange: (values: any) => void;
  isMonthlyRange?: boolean;
}

export const CustomRangePickerProps: React.FC<CustomRangePickerPropsProps> = (props) => {
  const { initDuration, onChange, isMonthlyRange } = props;

  const [selectedDuration, setSelectedDuration] = useState(initDuration);
  const [mode, setMode] = useState<[PanelMode, PanelMode]>(isMonthlyRange ? ["month", "month"] : ["date", "date"]);

  const onChangeValue = (date) => {
    setSelectedDuration(date);
    onChange(date);
  };

  const onRadioChange = ({ target: { value } }: RadioChangeEvent) => {
    onChangeValue(value);
  };

  const onSelectedChange = (date) => onChangeValue(date);

  const handlePanelChange = (value, mode) => {
    if (isMonthlyRange) {
      setMode([mode[0] === "date" ? "month" : mode[0], mode[1] === "date" ? "month" : mode[1]]);
      onChangeValue([value[0]?.startOf("month"), value[1]?.endOf("month")]);
    }
  };

  const placeholder: [string, string] = isMonthlyRange ? ["시작월", "종료월"] : ["시작일", "종료일"];
  const durationSettings = isMonthlyRange ? durationSettingsForMonthly : durationSettingsForDaily;
  const format = isMonthlyRange ? "YYYY-MM" : "YYYY-MM-DD";

  React.useEffect(() => {
    if (initDuration === null) {
      onChangeValue(initDuration);
    }
  }, [initDuration]);

  return (
    <>
      <Space direction="vertical" size={16}>
        <Radio.Group value={selectedDuration} onChange={onRadioChange} buttonStyle="solid">
          <Row justify="space-between" gutter={[0, 12]}>
            {durationSettings.map((item, index) => (
              <Col key={`duration-setting-${index}`}>
                <Radio.Button key={index} value={item.value}>
                  {item.label}
                </Radio.Button>
              </Col>
            ))}
          </Row>
        </Radio.Group>
        <RangePicker
          allowEmpty={[true, true]}
          value={selectedDuration}
          onChange={onSelectedChange}
          onPanelChange={handlePanelChange}
          mode={mode}
          placeholder={placeholder}
          format={format}
        />
      </Space>
    </>
  );
};
</file>

