  const { fetchForDownload } = utils.initListViewDownloadQuery(usePaidNoticeCountEventListFilterDownloadQuery);

  const queryVariables: PaidNoticeCountEventsVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params, user) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = usePaidNoticeCountEventListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.paidNoticeCountEvents?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PaidNoticeCountEventListViewUrlDialog, PaidNoticeCountEventListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
