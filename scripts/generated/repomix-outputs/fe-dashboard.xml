export const columnStrSplitJoinOrFirstTextFn = (str: string, isChain, chainSymbol?: string) => {
  const strSplit = str.split("|");
  const isChainCheck = isChain || false;
  if (isChainCheck) {
    return chainSymbol ? strSplit.join(chainSymbol) : strSplit.join("");
  } else {
    return strSplit[0];
  }
};

