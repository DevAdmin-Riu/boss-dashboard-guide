import { sectionNames } from "@assets/messages/sectionNames";
import { BoxSpecForPickingOrderInput } from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { StrictOmit } from "@src/global/core/types/types";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Card, Col, Form, Row, Space, Table, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { BoxSpecForPickingOrder_shop_boxSpecForPickingOrder } from "../../api/types/BoxSpecForPickingOrder";
import { BoxSpecForPickingOrderUpdateVariables } from "../../api/types/BoxSpecForPickingOrderUpdate";
import { BoxSpecForPickingOrderViewUrlDialog, BoxSpecForPickingOrderViewUrlQueryParams } from "../../urls";
import { getBoxSpecForPickingOrderTableSettings } from "./BoxSpecForPickingOrderTableSettings";

interface BoxSpecForPickingOrderPageProps {
  params: BoxSpecForPickingOrderViewUrlQueryParams;
  loading: boolean;
  boxSpecForPickingOrder: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder;
  onProductClick: (productId: string) => void;
  onUpdate: (variables: BoxSpecForPickingOrderUpdateVariables) => void;
  onAssignSubPv: (boxSpecId: string) => void;
  onUnassignSubPv: (boxSpecId: string) => void;
  onBack: () => void;
  onOpenModal: (
    action: BoxSpecForPickingOrderViewUrlDialog,
    newParams?: BoxSpecForPickingOrderViewUrlQueryParams
  ) => void;
  onCloseModal: () => void;
}

interface IBoxSpecForPickingOrderForm
  extends StrictOmit<BoxSpecForPickingOrderInput, "boxPrice" | "deliveryFee" | "subPv"> {
  boxPriceExcludeVat: number;
  deliveryFeeExcludeVat: number;
}

export const BoxSpecForPickingOrderPage: React.FC<BoxSpecForPickingOrderPageProps> = (props) => {
  const {
    params,
    boxSpecForPickingOrder,
    loading,
    onOpenModal,
    onCloseModal,
    onProductClick,
    onUpdate,
    onAssignSubPv,
    onUnassignSubPv,
    onBack,
  } = props;
  const [dataSource, setDataSource] = useState<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder[]>([]);
  const [form] = Form.useForm<IBoxSpecForPickingOrderForm>();

  const boxPriceWatched = Form.useWatch("boxPriceExcludeVat", form);
  const deliveryFeeWatched = Form.useWatch("deliveryFeeExcludeVat", form);
  const watchedValues = { boxPriceExcludeVat: boxPriceWatched, deliveryFeeExcludeVat: deliveryFeeWatched };

  useEffect(() => {
    if (boxSpecForPickingOrder) {
      setDataSource([boxSpecForPickingOrder]);
    }
  }, [boxSpecForPickingOrder]);

  const isEditing = (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) =>
    params.action === "update" && record.id === params.id;
  const onEdit = (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => {
    form.setFields([
      { name: "name", value: record.name },
      { name: "boxSizeType", value: record.boxSizeType },
      { name: "boxPriceExcludeVat", value: toPriceExcludeVat(record.boxPrice) },
      { name: "deliveryFeeExcludeVat", value: toPriceExcludeVat(record.deliveryFee) },
      { name: "length", value: record.length },
      { name: "width", value: record.width },
      { name: "height", value: record.height },
      { name: "threshold", value: record.threshold },
    ]);
    onOpenModal("update", { id: record.id });
  };
  const onSubmit = (formData: IBoxSpecForPickingOrderForm) => {
    const { boxPriceExcludeVat, deliveryFeeExcludeVat, ...restInput } = formData;
    const input: BoxSpecForPickingOrderInput = {
      ...restInput,
      boxPrice: toPriceIncludeVat(boxPriceExcludeVat),
      deliveryFee: toPriceIncludeVat(deliveryFeeExcludeVat),
    };
    onUpdate({ id: params.id, input });
  };

  const columns = getBoxSpecForPickingOrderTableSettings({
    loading,
    selectedRowId: params.id,
    watchedValues,
    isEditing,
    onEdit,
    onSubmit: form.submit,
    onCancel: onCloseModal,
    onProductClick,
    onAssignSubPv,
    onUnassignSubPv,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.configuration}</AppHeader>

      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.boxSpecForPickingOrder}</Typography.Title>
          </Col>
        </Row>
        <Card>
          <Form form={form} onFinish={onSubmit}>
            <TableVatLegend isIncludeVat={false} />
            <Table
              {...commonTableProps}
              loading={loading}
              dataSource={dataSource}
              columns={columns}
              scroll={{ x: tableWidthSum }}
              components={{ body: { cell: EditableCell } }}
            />
          </Form>
        </Card>
      </Space>
    </>
  );
};
</file>

<file path="src/app/views/settings/siteSettings/components/BoxSpecForPickingOrderPage/BoxSpecForPickingOrderTableSettings.tsx">
import { EditableColumnsType, EditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import NumberComponent from "@src/app/components/Number";
import { productBoxSpecUnitType } from "@src/app/views/product/products/utils/data";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Button, Space, Typography } from "antd";
import React from "react";

import { boxSizeTypeChoices, getBoxSizeTypeText } from "../../../attributes/utils";
import { BoxSpecForPickingOrder_shop_boxSpecForPickingOrder } from "../../api/types/BoxSpecForPickingOrder";

interface BoxSpecForPickingOrderTableSettingsProps {
  loading: boolean;
  selectedRowId: string;
  watchedValues: {
    boxPriceExcludeVat: number;
    deliveryFeeExcludeVat: number;
  };
  isEditing: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => boolean;
  onEdit: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => void;
  onSubmit: () => void;
  onCancel: () => void;
  onProductClick: (productId: string) => void;
  onAssignSubPv: (boxSpecId: string) => void;
  onUnassignSubPv: (boxSpecId: string) => void;
}

export const getBoxSpecForPickingOrderTableSettings = (props: BoxSpecForPickingOrderTableSettingsProps) => {
  const {
    loading,
    selectedRowId,
    watchedValues,
    isEditing,
    onEdit,
    onSubmit,
    onCancel,
    onProductClick,
    onAssignSubPv,
    onUnassignSubPv,
  } = props;
  const {
    product: { SKU, PRODUCT_NAME },
  } = columnNameConstant;

  const consumableMaterialsSkuColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = {
    title: SKU,
    key: "sku",
    width: 120,
    render: (_, record) => record.subPv?.sku || "-",
  };

  const consumableMaterialsProductNameColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = {
    title: PRODUCT_NAME,
    key: "productName",
    width: 150,
    render: (_, record) => (
      <Typography.Link onClick={() => onProductClick(record.subPv?.product.id)}>
        {record.subPv?.product.name || "-"}
      </Typography.Link>
    ),
  };

  const consumableMaterialsSubPvActionsColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> =
    {
      key: "subPvActions",
      align: "center",
      width: 150,
      render: (_, record) => (
        <Space size={"small"}>
          <Button
            type={"primary"}
            loading={loading}
            disabled={utils.isEmpty(selectedRowId, true) === false}
            onClick={() => onAssignSubPv(record.id)}
          >
            {utils.isEmpty(record.subPv) ? "추가" : "변경"}
          </Button>
          <Button
            danger
            type={"primary"}
            loading={loading}
            disabled={utils.isEmpty(selectedRowId, true) === false || utils.isEmpty(record.subPv)}
            onClick={() => onUnassignSubPv(record.id)}
          >
            제거
          </Button>
        </Space>
      ),
    };

  const boxSpecLengthColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = {
    title: "길이(장)",
    key: "length",
    align: "center",
    width: 100,
    render: (_, record) => <NumberComponent value={record.length} />,
    onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
      inputType: "number",
      formItemName: "length",
      editing: isEditing(record),
    }),
  };

  const boxSpecWidthColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = {
    title: "너비(폭)",
    key: "width",
    align: "center",
    width: 100,
    render: (_, record) => <NumberComponent value={record.width} />,
    onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
      inputType: "number",
      formItemName: "width",
      editing: isEditing(record),
    }),
  };

  const boxSpecHeightColumn: EditableColumnType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = {
    title: "높이(고)",
    key: "height",
    align: "center",
    width: 100,
    render: (_, record) => <NumberComponent value={record.height} />,
    onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
      inputType: "number",
      formItemName: "height",
      editing: isEditing(record),
    }),
  };

  const boxSpecColumns: EditableColumnsType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = [
    boxSpecLengthColumn,
    boxSpecWidthColumn,
    boxSpecHeightColumn,
  ];
  const mergedBoxSpenColumns: EditableColumnsType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> =
    boxSpecColumns.map((col) => ({
      ...col,
      onCell: (record) => ({
        inputType: "number",
        formItemName: col?.key,
        editing: isEditing(record),
      }),
    }));

  const columns: EditableColumnsType<BoxSpecForPickingOrder_shop_boxSpecForPickingOrder> = [
    {
      title: "이름",
      key: "name",
      align: "left",
      width: 120,
      render: (_, record) => record.name || "-",
      onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
        inputType: "text",
        formItemName: "name",
        editing: isEditing(record),
      }),
    },
    {
      title: "박스타입",
      key: "boxSizeType",
      align: "center",
      width: 80,
      render: (_, record) => getBoxSizeTypeText(record.boxSizeType),
      onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
        inputType: "singleSelect",
        formItemName: "boxSizeType",
        editing: isEditing(record),
        selectOptions: boxSizeTypeChoices,
      }),
    },
    {
      title: "박스가격",
      key: "boxPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.boxPrice)} />,
      onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
        inputType: "number",
        formItemName: "boxPriceExcludeVat",
        editing: isEditing(record),
      }),
    },
    {
      title: "합포장 택배비",
      key: "deliveryFeeExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.deliveryFee)} />,
      onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
        inputType: "number",
        formItemName: "deliveryFeeExcludeVat",
        editing: isEditing(record),
      }),
    },
    {
      title: "통합 배송비용",
      key: "totalDeliveryFeeExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        const valueExcludeVat = isEditing(record)
          ? watchedValues.boxPriceExcludeVat + watchedValues.deliveryFeeExcludeVat
          : toPriceExcludeVat(record.boxPrice) + toPriceExcludeVat(record.deliveryFee);
        return <NumberComponent value={valueExcludeVat} />;
      },
    },
    {
      title: `합포장 박스규격(${productBoxSpecUnitType})`,
      children: mergedBoxSpenColumns,
    },
    {
      title: <MultiLineTypography lines={["합포장 부피", "임계치(%)"]} />,
      key: "threshold",
      align: "right",
      width: 80,
      render: (_, record) => record.threshold,
      onCell: (record: BoxSpecForPickingOrder_shop_boxSpecForPickingOrder) => ({
        inputType: "number",
        formItemName: "threshold",
        editing: isEditing(record),
      }),
    },
    {
      key: "action",
      align: "center",
      width: 150,
      render: (_, record) =>
        isEditing(record) ? (
          <Space size={"small"}>
            <Button type={"primary"} loading={loading} disabled={utils.isEmpty(selectedRowId, true)} onClick={onSubmit}>
              저장
            </Button>
            <Button type={"default"} onClick={onCancel}>
              취소
            </Button>
          </Space>
        ) : (
          <Button
            type={"primary"}
            loading={loading}
            disabled={utils.isEmpty(selectedRowId, true) === false}
            onClick={() => onEdit(record)}
          >
            수정
          </Button>
        ),
    },
    {
      title: "소모 부자재",
      children: [
        consumableMaterialsSkuColumn,
        consumableMaterialsProductNameColumn,
        consumableMaterialsSubPvActionsColumn,
      ],
    },
  ];
  return columns;
};
</file>

