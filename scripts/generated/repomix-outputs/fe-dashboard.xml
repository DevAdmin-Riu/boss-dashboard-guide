import { statsDateType } from "@utils/chart";
import { Button, Col, DatePicker, Radio, RadioChangeEvent, Row, Select } from "antd";
import moment, { Moment } from "moment";
import React, { useState } from "react";

import { durationSettingsForDaily, durationSettingsForMonthly, durationSettingsForWeekly } from "./settings";

const { RangePicker } = DatePicker;
const { Option } = Select;

const HqStatsSelectDuration = (props) => {
  const { dateType, setDateType, selectedDuration, setSelectedDuration, disabledSelectDateType } = props;
  const [duration, setDuration] = useState(null); // RangePicker의 달력에서 선택시 정보를 저장하는 변수
  const [hackDuration, setHackDuration] = useState(null); // RangePicker 칸에 보여지는 가짜 변수
  const [durationValue, setDurationValue] = useState(null); // 최종 값으로써 실제 값에 전달되는 변수
  const convertTypeForMomentStartOf = (dateType: statsDateType) => {
    switch (dateType) {
      case statsDateType.DAILY:
        return "date";
      case statsDateType.WEEKLY:
        // 월요일을 한주의 시작으로 사용하기 위해 week 대신 isoWeek 사용
        return "isoWeek";
      case statsDateType.MONTHLY:
        return "month";
    }
  };
  const convertTypeForPicker = (dateType: statsDateType) => {
    switch (dateType) {
      case statsDateType.DAILY:
      case statsDateType.WEEKLY:
        return "date";
      case statsDateType.MONTHLY:
        return "month";
    }
  };
  const fnDiableDate = (dateType: statsDateType) => {
    switch (dateType) {
      case statsDateType.WEEKLY:
      case statsDateType.MONTHLY:
        return disabledOver1YearDate;
    }
    return disabledOver6MonthsDate;
  };

  const onSelectChange = (selectedType: statsDateType) => {
    setDateType(selectedType);
    const startDay =
      selectedType === statsDateType.DAILY
        ? moment().subtract(6, "days")
        : selectedType === statsDateType.WEEKLY
        ? moment().subtract(4, "weeks")
        : moment().subtract(2, "months");
    const durationType = convertTypeForMomentStartOf(selectedType);
    const defaultDuration = [
      startDay.startOf(durationType),
      moment().isBefore(moment().endOf(durationType)) ? moment() : moment().endOf(durationType),
    ];

    setDurationValue(defaultDuration);
    setSelectedDuration(defaultDuration);
  };

  const onRangeChange = (values: Array<Moment | null>) => {
    const durationType = convertTypeForMomentStartOf(dateType);
    setDurationValue([
      values[0].startOf(durationType),
      moment().isBefore(values[1].endOf(durationType)) ? moment() : values[1].endOf(durationType),
    ]);
  };

  const onCalendarChange = (values: Array<Moment | null>) => {
    const durationType = convertTypeForMomentStartOf(dateType);
    setDuration([values[0]?.startOf(durationType), values[1]?.endOf(durationType)]);
  };

  const onOpenChange = (open: boolean) => {
    if (open) {
      setHackDuration([null, null]);
      setDuration([null, null]);
    } else {
      setHackDuration(null);
    }
  };

  const disabledOver6MonthsDate = (current: Moment | null) => {
    if (!duration) {
      return false;
    }
    const tooLate = duration[0] && current.diff(duration[0], "months") > 5;
    const tooEarly = duration[1] && duration[1].diff(current, "months") > 5;
    const notAfterToday = current > moment().endOf("day");
    const notBeforeAYear = current < moment().subtract(1, "year").startOf("day");

    return !!tooEarly || !!tooLate || !!notAfterToday || !!notBeforeAYear;
  };

  const disabledOver1YearDate = (current: Moment | null) => {
    if (!duration) {
      return false;
    }
    const notAfterToday = current > moment().endOf("day");
    const notBeforeAYear = current < moment().subtract(1, "year").startOf("day");

    return !!notAfterToday || !!notBeforeAYear;
  };

  return (
    <Row gutter={[12, 12]} justify="space-between">
      {!disabledSelectDateType && (
        <Col xs={24} sm={8} md={8} lg={8} xl={4}>
          <Select value={dateType} onChange={onSelectChange} style={{ width: "100%" }}>
            <Option value={statsDateType.MONTHLY}>월별 판매 현황</Option>
            <Option value={statsDateType.WEEKLY}>주별 판매 현황</Option>
            <Option value={statsDateType.DAILY}>일별 판매 현황</Option>
          </Select>
        </Col>
      )}
      {dateType === statsDateType.DAILY && (
        <Col
          xs={24}
          sm={!disabledSelectDateType ? 16 : 24}
          md={!disabledSelectDateType ? 16 : 24}
          lg={!disabledSelectDateType ? 16 : 24}
          xl={12}
        >
          <Radio.Group
            value={selectedDuration}
            onChange={({ target: { value } }: RadioChangeEvent) => {
              setDurationValue(value);
              setSelectedDuration(value);
            }}
            buttonStyle="solid"
          >
            <Row
              gutter={[
                { xs: 4, sm: 4, md: 4, lg: 4 },
                { xs: 4, sm: 4, md: 4, lg: 4 },
              ]}
            >
              {durationSettingsForDaily.map((item, index) => (
                <Col key={`duration-setting-${index}`}>
                  <Radio.Button type="primary" key={index} value={item.value}>
                    {item.label}
                  </Radio.Button>
                </Col>
              ))}
            </Row>
          </Radio.Group>
        </Col>
      )}
      {dateType === statsDateType.WEEKLY && (
        <Col
          xs={24}
          sm={!disabledSelectDateType ? 16 : 24}
          md={!disabledSelectDateType ? 16 : 24}
          lg={!disabledSelectDateType ? 16 : 24}
          xl={12}
        >
          <Radio.Group
            value={selectedDuration}
            onChange={({ target: { value } }: RadioChangeEvent) => {
              setDurationValue(value);
              setSelectedDuration(value);
            }}
            buttonStyle="solid"
          >
            <Row
              gutter={[
                { xs: 4, sm: 4, md: 4, lg: 4 },
                { xs: 4, sm: 4, md: 4, lg: 4 },
              ]}
            >
              {durationSettingsForWeekly.map((item, index) => (
                <Col key={`duration-setting-${index}`}>
                  <Radio.Button type="primary" key={index} value={item.value}>
                    {item.label}
                  </Radio.Button>
                </Col>
              ))}
            </Row>
          </Radio.Group>
        </Col>
      )}
      {dateType === statsDateType.MONTHLY && (
        <Col
          xs={24}
          sm={!disabledSelectDateType ? 16 : 24}
          md={!disabledSelectDateType ? 16 : 24}
          lg={!disabledSelectDateType ? 16 : 24}
          xl={12}
        >
          <Radio.Group
            value={selectedDuration}
            onChange={({ target: { value } }: RadioChangeEvent) => {
              setDurationValue(value);
              setSelectedDuration(value);
            }}
            buttonStyle="solid"
          >
            <Row
              gutter={[
                { xs: 4, sm: 4, md: 4, lg: 4 },
                { xs: 4, sm: 4, md: 4, lg: 4 },
              ]}
            >
              {durationSettingsForMonthly.map((item, index) => (
                <Col key={`duration-setting-${index}`}>
                  <Radio.Button type="primary" key={index} value={item.value}>
                    {item.label}
                  </Radio.Button>
                </Col>
              ))}
            </Row>
          </Radio.Group>
        </Col>
      )}
      <Col xs={24} sm={24} md={24} lg={24} xl={8} flex="auto">
        <RangePicker
          picker={convertTypeForPicker(dateType)}
          allowEmpty={[false, false]}
          value={hackDuration || durationValue || selectedDuration}
          disabledDate={fnDiableDate(dateType)}
          onCalendarChange={(val) => onCalendarChange(val)}
          onChange={onRangeChange}
          onOpenChange={onOpenChange}
          style={{
            width: "calc(100% - 70px)",
            marginRight: "8px",
            borderRadius: "100rem",
            padding: ".25rem 1rem",
          }}
        />
        <Button
          type="primary"
          shape="round"
          onClick={() => {
            if (durationValue) {
              setSelectedDuration(durationValue);
            }
          }}
        >
          조회
        </Button>
      </Col>
    </Row>
  );
};
export default HqStatsSelectDuration;
</file>

