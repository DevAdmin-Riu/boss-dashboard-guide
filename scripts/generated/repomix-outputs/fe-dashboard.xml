<file path="src/app/views/hqStaff/hqSection/components/HqStatsSelectDuration/utils.ts">
import moment from "moment";

export function getDateRange(
  value: number,
  valueUnit: "days" | "weeks" | "months",
  // 월요일을 한주의 시작으로 사용하기 위해 week 대신 isoWeek 사용
  durationType: "day" | "isoWeek" | "month" = "day"
) {
  if (durationType === "day") {
    if (valueUnit === "days") {
      return [moment().subtract(value, valueUnit), moment()];
    } else if (valueUnit === "weeks") {
      return [moment().subtract(value * 7, "days"), moment()];
    } else if (valueUnit === "months") {
      return [moment().subtract(value, valueUnit), moment()];
    }
    return [moment(), moment()];
  }
  // 주별 통계는 주 만 허용 (이번주 / 3주 / 5주 / 12주 / 21주)
  if (durationType === "isoWeek") {
    if (valueUnit === "weeks") {
      return [moment().subtract(value, valueUnit).startOf(durationType), moment()];
    }
    return [moment().startOf(durationType), moment()];
  }

  // 월별 통계는 월 만 허용 (당월, 2개월, 3개월, 6개월, 12개월)
  if (durationType === "month") {
    if (valueUnit === "months") {
      return [moment().subtract(value, valueUnit).startOf(durationType), moment()];
    }
    return [moment().startOf(durationType), moment()];
  }
}
</file>

