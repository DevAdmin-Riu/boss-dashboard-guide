import { formRuleMsg } from "@assets/messages/commonMsg";
import { bsOpsCheckReportFragment } from "@src/api/fragments/brandStore";
import { BrandStoreConsultationInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField from "@src/app/components/EditableField/EditableField";
import { convertMarkdownToContentJsonStr, parseContentJsonStrToMarkdown } from "@src/app/components/Editor/utils";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import {
  detailDateFormatWithHourMinute,
  extractHourMinuteFormat,
  ISOFormatWithTimeZone,
} from "@src/app/providers/DateProvider";
import { StrictOmit } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Form, PageHeader } from "antd";
import moment from "moment";
import React, { useState } from "react";

import { useBrandStoreConsultationCreateMutation, useBrandStoreConsultationUpdateMutation } from "../../api/mutations";
import { BsOpsCheckReportDetails_bsOpsCheckReport } from "../../api/types/BsOpsCheckReportDetails";

type TFormData = StrictOmit<BrandStoreConsultationInput, "report" | "brandStore">;

interface BsOpsCheckReportConsultationInfoProps {
  report: BsOpsCheckReportDetails_bsOpsCheckReport;
}

export const BsOpsCheckReportConsultationInfo: React.FC<BsOpsCheckReportConsultationInfoProps> = (props) => {
  const { report } = props;
  const { id, brandStore, consultation } = report;
  const isCreate = utils.isEmpty(consultation);

  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);
  const [isEditMode, setIsEditMode] = useState<boolean>(isCreate);

  const onEdit = () => {
    setIsEditMode(true);
  };
  const onCancel = () => {
    setIsEditMode(false);
    form.resetFields();
  };

  const initialValues: TFormData = {
    title: isCreate ? null : consultation.title,
    content: isCreate ? null : parseContentJsonStrToMarkdown(consultation.content),
    consultationDate: isCreate ? moment().format(ISOFormatWithTimeZone) : consultation.consultationDate,
  };

  const [brandStoreConsultationCreate] = useBrandStoreConsultationCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data?.brandStoreConsultationCreate?.errors,
        "상담 내역이 등록되었습니다.",
        onCancel
      ),
  });

  const [brandStoreConsultationUpdate] = useBrandStoreConsultationUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data?.brandStoreConsultationUpdate?.errors,
        "상담 내역이 수정되었습니다.",
        onCancel
      ),
  });

  const handleSubmit = (formData: TFormData) => {
    const { consultationDate, title, content } = formData;
    const convertedContent = convertMarkdownToContentJsonStr(content);

    const input: BrandStoreConsultationInput = {
      report: id,
      brandStore: brandStore.id,
      consultationDate,
      title,
      content: convertedContent,
    };

    if (isCreate) {
      brandStoreConsultationCreate({
        variables: { input },
        update: (cache, { data }) => {
          const newConsultation = data.brandStoreConsultationCreate.brandStoreConsultation;
          if (!newConsultation) {
            return;
          }

          const reportCacheId = cache.identify({ __typename: report.__typename, id: report.id });
          const updateFragment = bsOpsCheckReportFragment;
          updateMultipleFragments({
            cache,
            cacheId: reportCacheId,
            updates: [
              {
                fragment: updateFragment,
                fragmentName: "BsOpsCheckReportFragment",
                fieldName: "consultation",
                updateFn: (_prev) => newConsultation,
              },
            ],
          });
        },
      });
    } else {
      brandStoreConsultationUpdate({ variables: { id: consultation.id, input } });
    }
  };

  return (
    <Form
      name="brand-store-consultation-upsert"
      layout="vertical"
      form={form}
      initialValues={initialValues}
      onFinish={handleSubmit}
    >
      <Card
        title={
          <PageHeader
            title="매장 상담"
            extra={
              isCreate ? (
                <Form.Item noStyle shouldUpdate>
                  {() => (
                    <Button type="primary" disabled={!form.isFieldsTouched()} onClick={form.submit}>
                      등록
                    </Button>
                  )}
                </Form.Item>
              ) : (
                <FormSaveButton form={form} isEditMode={isEditMode} onEdit={onEdit} onCancel={onCancel} />
              )
            }
          />
        }
      >
        <EditableField<string>
          type="datepicker"
          editMode={isEditMode}
          name={TypeSafeForm.getValidDataIndex("consultationDate")}
          label="상담일"
          value={initialValues.consultationDate}
          renderValue={(value) => moment(value).format(detailDateFormatWithHourMinute)}
          showTime={{ format: extractHourMinuteFormat }}
          format={detailDateFormatWithHourMinute}
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          formDateFormat={ISOFormatWithTimeZone}
        />
        <EditableField
          type="input"
          editMode={isEditMode}
          name={TypeSafeForm.getValidDataIndex("title")}
          label="제목"
          value={initialValues.title}
          rules={[{ required: true, message: formRuleMsg.required }]}
        />
        <EditableField
          type="editor"
          editMode={isEditMode}
          name={TypeSafeForm.getValidDataIndex("content")}
          label="내용"
          editorInitialValue={initialValues.content}
          rules={[{ required: true, message: formRuleMsg.required }]}
        />
      </Card>
    </Form>
  );
};
</file>

