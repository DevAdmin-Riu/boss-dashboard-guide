<file path="src/app/views/question/view/CustomerQaListView/CustomerQaListView.tsx">
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React, { useState } from "react";
import { useParams } from "react-router";

import { useCustomerQAListQuery } from "../../api/queries";
import { CustomerQAListVariables } from "../../api/types/CustomerQAList";
import CustomerQaFormModal from "../../components/CustomerQaFormModal/CustomerQaFormModal";
import CustomerQaListPage from "../../components/CustomerQaListPage/CustomerQaListPage";
import {
  CustomerQaListViewRouteParams,
  customerQaListViewUrl,
  CustomerQaListViewUrlDialog,
  CustomerQaListViewUrlQueryParams,
  customerQaSectionUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

export enum CustomerQaListModalModeEnum {
  CreateOrUpdateReply = "CreateOrUpdateReply",
}

interface CustomerQaListViewProps {
  params: CustomerQaListViewUrlQueryParams;
}
const CustomerQaListView: React.FC<CustomerQaListViewProps> = (props) => {
  const routeParams = useParams<CustomerQaListViewRouteParams>();
  const [modalMode, setModalMode] = useState<CustomerQaListModalModeEnum>(null);
  const [selectedRowId, setSelectedRowId] = useState<string>(null);
  const { params } = props;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(ListViews.CUSTOMER_QA_LIST, [routeParams.qType]),
  });
  const targetUrl = (params: CustomerQaListViewUrlQueryParams) => customerQaListViewUrl(routeParams, params);

  const onModalOpen = (mode: CustomerQaListModalModeEnum, rowId: string) => {
    setModalMode(mode);
    setSelectedRowId(rowId);
  };
  const onModalClose = () => {
    setModalMode(null);
    setSelectedRowId(null);
  };

  const queryVariables: CustomerQAListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: getFilterVariables(params, routeParams),
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useCustomerQAListQuery({ variables: queryVariables });
  const customerQaList = maybe(() => data.customerQAList.edges.map((edge) => edge.node), []);
  const selectedQuestion = customerQaList.find((qa) => qa.id === selectedRowId);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.customerQAList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<CustomerQaListViewUrlDialog, CustomerQaListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  return (
    <>
      <CustomerQaListPage
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        currentTab={currentTab}
        onFilterChange={changeFilters}
        filterOpts={getFilterOpts(params, routeParams)}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onAdd={() => navigate(customerQaSectionUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onSort={handleSort}
        sort={getSortParams(params)}
        customerQaList={customerQaList}
        onModalOpen={onModalOpen}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
      <CustomerQaFormModal
        open={modalMode === CustomerQaListModalModeEnum.CreateOrUpdateReply}
        onClose={onModalClose}
        selectedQuestion={selectedQuestion}
      />
    </>
  );
};

export default CustomerQaListView;
</file>

<file path="src/app/views/question/view/CustomerQaListView/filters.ts">
import { CustomerQAFilterInput, CustomerQATypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { CustomerQaListFilterKeys, CustomerQaListFilterOpts } from "../../components/CustomerQaListPage/filters";
import {
  CustomerQaListViewRouteParams,
  CustomerQaListViewUrlFilters,
  CustomerQaListViewUrlFiltersEnum,
  CustomerQaListViewUrlQueryParams,
} from "../../urls";

const CUSTOMER_QA_FILTERS_KEY = "customerQaFilters";

export function getFilterOpts(
  params: CustomerQaListViewUrlFilters,
  routeParams: CustomerQaListViewRouteParams
): CustomerQaListFilterOpts {
  const filterVariables = getFilterVariables(params, routeParams);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    isAnswered: {
      active: maybe(() => !utils.isEmpty(filterVariables.isAnswered), false),
      value: maybe(() => filterVariables.isAnswered, false),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch, true), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: CustomerQaListViewUrlFilters,
  routeParams: CustomerQaListViewRouteParams
): CustomerQAFilterInput {
  const { qType } = routeParams;
  const questionType = [];
  switch (qType) {
    case "suggest-system":
      questionType.push(CustomerQATypeEnum.SUGGEST_SYSTEM);
      break;
    case "boss-qa":
      questionType.push(CustomerQATypeEnum.BOSS_QA);
      break;
    default:
      break;
  }

  return {
    questionType,
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    isAnswered: params.isAnswered !== undefined ? parseBoolean(params.isAnswered, true) : undefined,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    mdSearch: params.mdSearch !== undefined ? params.mdSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<CustomerQaListFilterKeys>): CustomerQaListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case CustomerQaListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        CustomerQaListViewUrlFiltersEnum.createdFrom,
        CustomerQaListViewUrlFiltersEnum.createdTo
      );
    case CustomerQaListFilterKeys.isAnswered:
      return getSingleValueQueryParam(filter, CustomerQaListViewUrlFiltersEnum.isAnswered);
    case CustomerQaListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, CustomerQaListViewUrlFiltersEnum.brandSearch);
    case CustomerQaListFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, CustomerQaListViewUrlFiltersEnum.mdSearch);
    case CustomerQaListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, CustomerQaListViewUrlFiltersEnum.userSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<CustomerQaListViewUrlFilters>(CUSTOMER_QA_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  CustomerQaListViewUrlQueryParams,
  CustomerQaListViewUrlFilters
>(CustomerQaListViewUrlFiltersEnum);
</file>

