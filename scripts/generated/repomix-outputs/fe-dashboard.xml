import { RequestFbvProductStatusEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum ReqFbvProductProductFilterKeys {
  brandSearch = "brandSearch",
  mdSearch = "mdSearch",
  vendorSearch = "vendorSearch",
  productSearch = "productSearch",
  status = "status",
  createdAt = "createdAt",
  lastChangedAt = "lastChangedAt",
}

export interface ReqFbvProductProductListFilterOpts {
  brandSearch: FilterOpts<string>;
  mdSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  status: FilterOpts<RequestFbvProductStatusEnum>;
  createdAt: FilterOpts<MinMax>;
  lastChangedAt: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: ReqFbvProductProductListFilterOpts,
  isStaff: boolean
): IFilter<ReqFbvProductProductFilterKeys> {
  let displayOrder = 0;

  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      ReqFbvProductProductFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };

  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      ReqFbvProductProductFilterKeys.productSearch,
      "상품명",
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };

  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      ReqFbvProductProductFilterKeys.vendorSearch,
      "협력사명",
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };

  const mdSearchFilter = {
    ...createTextField(displayOrder++, ReqFbvProductProductFilterKeys.mdSearch, "담당 MD", opts.mdSearch.value),
    active: opts.mdSearch.active,
  };

  const statusFilter = {
    ...createOptionsField(displayOrder++, ReqFbvProductProductFilterKeys.status, "상태", [opts.status.value], false, [
      {
        label: "접수",
        value: RequestFbvProductStatusEnum.REQUESTED,
      },
      {
        label: "반려",
        value: RequestFbvProductStatusEnum.REJECTED,
      },
      {
        label: "완료",
        value: RequestFbvProductStatusEnum.COMPLETED,
      },
    ]),
    active: opts.status.active,
  };

  const createdAtFilter = {
    ...createDateField(displayOrder++, ReqFbvProductProductFilterKeys.createdAt, "요청일", opts.createdAt.value),
    active: opts.createdAt.active,
  };

  const lastChangedAtFilter = {
    ...createDateField(
      displayOrder++,
      ReqFbvProductProductFilterKeys.lastChangedAt,
      "최종상태 변경일",
      opts.lastChangedAt.value
    ),
    active: opts.lastChangedAt.active,
  };

  if (isStaff) {
    return [
      brandSearchFilter,
      productSearchFilter,
      vendorSearchFilter,
      mdSearchFilter,
      statusFilter,
      createdAtFilter,
      lastChangedAtFilter,
    ];
  } else {
    return [productSearchFilter, statusFilter, createdAtFilter, lastChangedAtFilter];
  }
}
