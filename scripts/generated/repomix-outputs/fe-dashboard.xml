      opts.invoicePrintedStatusAt.value
    ),
    active: opts.invoicePrintedStatusAt.active,
  };
  const toBeInspectedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.toBeInspectedStatusAt,
      "검수 대기일",
      opts.toBeInspectedStatusAt.value
    ),
