} from "../../urls";

const BRAND_PRODUCT_FILTERS_KEY = "brandProductFilters";

export function getFilterOpts(params: BrandProductListViewUrlFilters): BrandProductListFilterOpts {
  const filterVariables = getFilterVariables(params);
  // 중단 상품 조회 여부 값은 실제 BrandProductFilterInput에 포함되는 값이 아니라, URL 파라미터에만 존재하는 값이므로 따로 처리.
  const includeStoppedBpv = parseBoolean(params.includeStoppedBpv, false);

  return {
    includeStoppedBpv: {
      active: maybe(() => !utils.isEmpty(includeStoppedBpv), false),
      value: maybe(() => includeStoppedBpv, false),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: maybe(() => filterVariables.brandProductSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
  };
}

export function getFilterVariables(params: BrandProductListViewUrlFilters): BrandProductFilterInput {
  return {
    brandProductSearch: params.brandProductSearch,
    productSearch: params.productSearch,
  };
}

export function getPackageFilterVariables(params: BrandProductListViewUrlFilters): BrandProductPackagesFilterInput {
  return {
    brandProductSearch: params.brandProductSearch,
  };
}

export function getFilterQueryParam(filter: IFilterElement<BrandProductFilterKeys>): BrandProductListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandProductFilterKeys.includeStoppedBpv:
      return getSingleValueQueryParam(filter, BrandProductListViewUrlFiltersEnum.includeStoppedBpv);
    case BrandProductFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, BrandProductListViewUrlFiltersEnum.brandProductSearch);
    case BrandProductFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, BrandProductListViewUrlFiltersEnum.productSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandProductListViewUrlFilters>(BRAND_PRODUCT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
