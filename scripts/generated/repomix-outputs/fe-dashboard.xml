    [B2bSettlementUrlEnum.EDIT_REQUEST]: totalEditRequestCount,
    [B2bSettlementUrlEnum.CLOSING_STATEMENT]: 0,
    [B2bSettlementUrlEnum.AGENCY_PENDING]: 0,
    [B2bSettlementUrlEnum.CLOSED]: 0, // closedCount가 API에 없음
    [B2bSettlementUrlEnum.TAXINVOICE]: 0, // taxInvoiceCount가 API에 없음
  };
};

export const B2bSettlementListView: React.FC<B2bSettlementListViewProps> = ({ defaultParams, params }) => {
  const routeParams = useParams<B2bSettlementListViewRouteParams>();
  const { user } = useUser();
  const { isStaff } = user;
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);

  const { data: countData } = useB2bSalesCountQuery({
    variables: {
      filter: {
        brandId: isStaff ? undefined : user.brand.id,
      },
    },
  });

  const targetUrl = (params: B2bSettlementForSalesViewUrlQueryParams) => b2bSettlementListViewUrl(routeParams, params);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.B2B_SETTLEMENT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useSalesListForB2bFilterDownloadQuery);
  const filterVariables = getFilterVariables(params);
  const queryVariables = useMemo<SalesListForB2bVariables>(
    () => ({
      ...paginationState,
      filter: { ...getFilterVariables(params), isB2b: true },
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useSalesListForB2bQuery({ variables: queryVariables });
  const salesList = useMemo(() => maybe(() => data.sales.edges.map((edge) => edge.node), []), [data]);
  const selectedSales = salesList.filter((line) => selectedRowIds?.includes(line.id));

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.sales?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderSalesListViewUrlDialog, B2bSettlementForSalesViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setSelectedRowIds([]);
    }
  };

  const selectedRowExist = maybe(() => selectedRowIds.length > 0);

  const pageLoading = loading;

  useEffect(() => {
    setSelectedRowIds([]);
  }, [loading, routeParams.status]);

  return (
    <>
      <B2bSettlementListPage
        params={params}
        settings={settings}
        disabled={pageLoading}
        salesList={salesList}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        ListNavigator={() => (
          <ListNavigator<B2bSettlementForSalesViewUrlQueryParams, B2bSettlementUrlEnum>
            countOfStatus={countData ? getStatusCount(countData.b2bSalesCount) : null}
            urlList={b2bSettlementUrlList()}
            NavButtonName={b2bSettlementNavButtonName}
            skipQueryString={true}
          />
        )}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <HqB2bSettlementBulkReqRevisionModal
        open={params.action === "bulk-req-revision-sales" && selectedRowExist}
        loading={pageLoading}
        saleIds={selectedRowIds}
        salesCloseDate={filterVariables.salesCloseDate?.lte}
        onCancel={onModalClose}
      />
      <HqB2bSettlementBulkCloseModal
        open={params.action === "bulk-close-sales" && selectedRowExist}
        loading={pageLoading}
        sales={selectedSales}
        salesCloseDate={filterVariables.salesCloseDate?.lte}
        onCancel={closeModal}
      />
    </>
  );
};
