import { FulfilledByVendorPurchaseCostStatListPageProps } from "./FulfilledByVendorPurchaseCostStatListPage";

const { Text } = Typography;

export const getFulfilledByVendorPurchaseCostStatListTableSettings = (
  props: FulfilledByVendorPurchaseCostStatListPageProps
) => {
  const { onRowClick, onCreateFbvPurchaseCostEvent, isHqStaff, isSameMonthAndYear } = props;
  const fbvTextForHq = transformIsFBVForHq(true);
  const isMobile = utils.checkMobile();
  const fixedLeftFlag = isMobile ? null : "left";
  const fixedRightFlag = isMobile ? null : "right";

  const vendorCodeColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.vendor.CODE,
    key: "vendorCode",
    align: "center",
    width: 100,
    fixed: fixedLeftFlag,
    render: (_, record) => ("vendor" in record && record?.vendor?.code) || "-",
  };

  const vendorNameColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.vendor.VENDOR_NAME,
    key: "vendorName",
    align: "center",
    width: 150,
    fixed: fixedLeftFlag,
    render: (_, record) => ("vendor" in record && record?.vendor?.name) || "-",
  };

  const vendorBizRegNoColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.common.BIZ_REG_NO,
    key: "vendorBizRegNo",
    align: "center",
    width: 120,
    fixed: fixedLeftFlag,
    render: (_, record) => ("vendor" in record && record?.vendor?.bizRegNo) || "-",
  };

  const brandNameColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.brand.BRAND_NAME,
    key: "brandName",
    align: "center",
    width: 100,
    fixed: fixedLeftFlag,
    render: (_, record) => ("brand" in record && record?.brand?.name) || "-",
  };

  const bizNameColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.brand.BIZ_NAME,
    key: "bizName",
    align: "center",
    width: 100,
    fixed: fixedLeftFlag,
    render: (_, record) => ("brand" in record && record?.brand?.bizInfo?.bizName) || "-",
  };

  const bizRegNoColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: columnNameConstant.common.BIZ_REG_NO,
    key: "bizRegNo",
    align: "center",
    width: 120,
    fixed: fixedLeftFlag,
    render: (_, record) => ("brand" in record && record?.brand?.bizInfo?.bizRegNo) || "-",
  };

  const startAmountColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: isHqStaff ? "기존 채무" : "기존 채권",
    key: "startAmount",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.startAmount} />,
    renderExcel: (record) => record.startAmount,
  };

  const totalNonCancelPurchaseColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: isHqStaff ? `${fbvTextForHq} 상품 매입` : "상품 판매 금액",
    key: "totalNonCancelPurchase",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.totalPurchase} />,
    renderExcel: (record) => record.totalPurchase,
  };

  const totalSettlementColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: isHqStaff ? `${fbvTextForHq} 상품 지급` : "수령 금액",
    key: "totalSettlement",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.totalSettlement} />,
    renderExcel: (record) => record.totalSettlement,
  };

  const totalIncreaseColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: "기타 잔액 추가",
    key: "totalIncrease",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.totalIncrease} />,
    renderExcel: (record) => record.totalIncrease,
  };

  const totalDecreaseColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: "기타 잔액 차감",
    key: "totalDecrease",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.totalDecrease} />,
    renderExcel: (record) => record.totalDecrease,
  };

  const remainAmountColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: "잔액",
    key: "remainAmount",
    align: "right",
    width: 130,
    render: (_, record) => <NumberComponent value={record.remainAmount} />,
    renderExcel: (record) => record.remainAmount,
  };

  const createEventActionColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    title: "잔액 수정",
    key: "createEventAction",
    align: "center",
    width: 150,
    fixed: fixedRightFlag,
    render: (_, record) => {
      if ("vendor" in record && record?.vendor?.isRiu) {
        return <></>;
      }
      return (
        <Space>
          <Button
            size="small"
            type="primary"
            onClick={() =>
              onCreateFbvPurchaseCostEvent("vendor" in record && record, "create-fbv-purchase-cost-settlement")
            }
          >
            지급
          </Button>
          <Button
            size="small"
            type="primary"
            onClick={() =>
              onCreateFbvPurchaseCostEvent("vendor" in record && record, "create-fbv-purchase-cost-increase")
            }
          >
            기타 추가
          </Button>
          <Button
            size="small"
            type="primary"
            onClick={() =>
              onCreateFbvPurchaseCostEvent("vendor" in record && record, "create-fbv-purchase-cost-decrease")
            }
          >
            기타 차감
          </Button>
        </Space>
      );
    },
    doNotRenderExcel: true,
  };

  const toDetailsActionColumn: DownloadableColumnType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = {
    key: "toDetailsAction",
    align: "center",
    width: 80,
    fixed: fixedRightFlag,
    render: (_, record) => (
      <Button
        size="small"
        type="primary"
        onClick={() =>
          isHqStaff
            ? "vendor" in record && onRowClick(record.vendor.id)
            : "brand" in record && onRowClick(record?.brand?.id)
        }
      >
        상세 정보
      </Button>
    ),
    doNotRenderExcel: true,
  };

  const columns: DownloadableColumnsType<
    FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq | FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor
  > = [
    isHqStaff && vendorCodeColumn,
    isHqStaff && vendorNameColumn,
    isHqStaff && vendorBizRegNoColumn,
    !isHqStaff && brandNameColumn,
    !isHqStaff && bizNameColumn,
    !isHqStaff && bizRegNoColumn,
    startAmountColumn,
    totalNonCancelPurchaseColumn,
    totalSettlementColumn,
    totalIncreaseColumn,
    totalDecreaseColumn,
    remainAmountColumn,
    isSameMonthAndYear && isHqStaff && createEventActionColumn,
    toDetailsActionColumn,
  ].filter(Boolean);

  return columns;
};

export const getFulfilledByVendorPurchaseCostStatListTableSummary = (
  dataSource:
    | readonly FbvPurchaseCostStatsForHq_fbvPurchaseCostStatsForHq[]
    | readonly FbvPurchaseCostStatsForVendor_fbvPurchaseCostStatsForVendor[]
) => {
  let totalStartAmount = 0;
  let totalNonCancelPurchaseSum = 0;
  let totalSettlementSum = 0;
  let totalIncreaseSum = 0;
  let totalDecreaseSum = 0;
  let remainAmountSum = 0;

  dataSource.forEach(({ startAmount, totalPurchase, totalSettlement, totalIncrease, totalDecrease, remainAmount }) => {
    totalStartAmount += startAmount;
    totalNonCancelPurchaseSum += totalPurchase;
    totalSettlementSum += totalSettlement;
    totalIncreaseSum += totalIncrease;
    totalDecreaseSum += totalDecrease;
    remainAmountSum += remainAmount;
  });

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center" colSpan={3}>
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalStartAmount} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalNonCancelPurchaseSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalSettlementSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalIncreaseSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalDecreaseSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={remainAmountSum} />
          </Text>
        </Table.Summary.Cell>
      </Table.Summary.Row>
    </Table.Summary>
  );
};
