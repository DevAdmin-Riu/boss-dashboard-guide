import NumberComponent from "@src/app/components/Number";
import { DateTime } from "@src/app/providers/DateProvider";
import { transformTaxFree } from "@utils/misc";
import { Descriptions, Space, Typography } from "antd";
import React from "react";

import { OrderDetails_order } from "../../api/types/OrderDetails";

interface OrderTaxTableProps {
  order: OrderDetails_order;
}

const OrderTaxTable: React.FC<OrderTaxTableProps> = (props) => {
  const { order } = props;

  const taxInvoices = order?.taxInvoices;
  const noneTaxInvoices = order?.taxInvoices.length <= 0 && order?.taxInvoices.length <= 0;

  let taxableTaxInvoices = taxInvoices?.find((taxInvoice) => taxInvoice.isTaxFree === false);
  if (!taxableTaxInvoices) {
    taxableTaxInvoices = taxInvoices?.find((taxInvoice) => taxInvoice.isTaxFree === false);
  }
  let taxFreeTaxInvoices = taxInvoices?.find((taxInvoice) => taxInvoice.isTaxFree);
  if (!taxFreeTaxInvoices) {
    taxFreeTaxInvoices = taxInvoices?.find((taxInvoice) => taxInvoice.isTaxFree);
  }

  return (
    <>
      <Space direction="vertical" size="small">
        {noneTaxInvoices && <Typography.Text type="warning">세금계산서 발행 정보 없음</Typography.Text>}
        {!noneTaxInvoices && (
          <Descriptions
            title="세금계산서"
            bordered
            size="small"
            labelStyle={{
              width: "100px",
              wordBreak: "keep-all",
              verticalAlign: "middle",
              whiteSpace: "nowrap",
            }}
            column={3}
            contentStyle={{ width: "15%" }}
          >
            <Descriptions.Item label={transformTaxFree(false)}>
              <NumberComponent value={taxableTaxInvoices?.totalAmount} includeCurrency={true} />
            </Descriptions.Item>
            <Descriptions.Item label={"작성일"}>
              {taxableTaxInvoices ? <DateTime date={taxableTaxInvoices.writeDate} onlyDate={true} /> : "-"}
            </Descriptions.Item>
            <Descriptions.Item label={"자동발행일"}>
              {taxableTaxInvoices ? <DateTime date={taxableTaxInvoices.autoIssueDate} onlyDate={true} /> : "-"}
            </Descriptions.Item>
            <Descriptions.Item label={transformTaxFree(true)}>
              <NumberComponent value={taxFreeTaxInvoices?.totalAmount} includeCurrency={true} />
            </Descriptions.Item>
            <Descriptions.Item label={"작성일"}>
              {taxFreeTaxInvoices ? <DateTime date={taxFreeTaxInvoices.writeDate} onlyDate={true} /> : "-"}
            </Descriptions.Item>
            <Descriptions.Item label={"자동발행일"}>
              {taxFreeTaxInvoices ? <DateTime date={taxFreeTaxInvoices.autoIssueDate} onlyDate={true} /> : "-"}
