  StockListViewUrlFilters,
  StockListViewUrlFiltersEnum,
  StockListViewUrlFiltersWithMultipleValues,
  StockListViewUrlQueryParams,
} from "../../urls";

const STOCK_FILTERS_KEY = "stockFilters";

export function getFilterOpts(params: StockListViewUrlFilters): StockFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: maybe(() => filterVariables.brandProductSearch, ""),
    },
    externalProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.externalProductSearch, true), false),
      value: maybe(() => filterVariables.externalProductSearch, ""),
    },
    salesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.salesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.salesStatus), []),
    },
    priorityLevel: {
      active: maybe(() => !utils.isEmpty(filterVariables.priorityLevel), false),
      value: maybe(() => dedupeFilter(filterVariables.priorityLevel), []),
    },
    stockAvailability: {
      active: maybe(() => !utils.isEmpty(filterVariables.stockAvailability), false),
      value: maybe(() => filterVariables.stockAvailability) || StockAvailability.OUT_OF_ROP,
    },
    isSalesSurge: {
      active: maybe(() => !utils.isEmpty(filterVariables.isSalesSurge), false),
      value: maybe(() => filterVariables.isSalesSurge, true),
    },
    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, true),
    },
    allowAutoConsignment: {
      active: maybe(() => !utils.isEmpty(filterVariables.allowAutoConsignment), false),
      value: maybe(() => filterVariables.allowAutoConsignment, true),
    },
    isInner: {
      active: maybe(() => !utils.isEmpty(filterVariables.isInner), false),
      value: maybe(() => filterVariables.isInner, true),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    needToStockExists: {
      active: maybe(() => !utils.isEmpty(filterVariables.needToStockExists), false),
      value: maybe(() => filterVariables.needToStockExists, true),
    },
    needToStockDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.needToStockDate.gte, filterVariables.needToStockDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.needToStockDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.needToStockDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    categoryKind: {
      active: maybe(() => !utils.isEmpty(filterVariables.categoryKind), false),
      value: maybe(() => dedupeFilter(filterVariables.categoryKind), []),
    },
    isSubPv: {
      active: maybe(() => !utils.isEmpty(filterVariables.isSubPv), false),
      value: maybe(() => filterVariables.isSubPv, true),
    },
  };
}

export function getFilterVariables(params: StockListViewUrlFilters): ProductVariantFilterInput {
  const needToStockExists =
    params.needToStockExists !== undefined ? parseBoolean(params.needToStockExists, true) : undefined;
  return {
    salesStatus: maybe(() => params.salesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    priorityLevel: maybe(() => params.priorityLevel.map((status) => findInEnum(status, PriorityLevelEnum)), []),
    stockControl: true,
    stockAvailability:
      params.stockAvailability !== undefined ? findInEnum(params.stockAvailability, StockAvailability) : null,
    isSalesSurge: params.isSalesSurge !== undefined ? parseBoolean(params.isSalesSurge, true) : undefined,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, true) : undefined,
    allowAutoConsignment:
      params.allowAutoConsignment !== undefined ? parseBoolean(params.allowAutoConsignment, false) : undefined,
    isInner: params.isInner !== undefined ? parseBoolean(params.isInner, false) : undefined,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    brandProductSearch: params.brandProductSearch !== undefined ? params.brandProductSearch : null,
    externalProductSearch: params.externalProductSearch !== undefined ? params.externalProductSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    needToStockExists,
    needToStockDate: getGteLteVariables({
      gte: params.needToStockDateFrom,
      lte: params.needToStockDateTo,
    }),
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    categoryKind: maybe(() => params.categoryKind.map((kind) => findInEnum(kind, CategoryKindEnum)), []),
    isSubPv: params.isSubPv !== undefined ? parseBoolean(params.isSubPv, true) : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<StockFilterKeys>): StockListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case StockFilterKeys.salesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        StockListViewUrlFiltersWithMultipleValues.salesStatus,
        SalesStatusEnum
      );
    case StockFilterKeys.priorityLevel:
      return getMultipleEnumValueQueryParam(
        filter,
        StockListViewUrlFiltersWithMultipleValues.priorityLevel,
        PriorityLevelEnum
      );
    case StockFilterKeys.stockAvailability:
      return getSingleEnumValueQueryParam(filter, StockListViewUrlFiltersEnum.stockAvailability, StockAvailability);
    case StockFilterKeys.isSalesSurge:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.isSalesSurge);
    case StockFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.trackInventory);
    case StockFilterKeys.allowAutoConsignment:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.allowAutoConsignment);
    case StockFilterKeys.isInner:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.isInner);
    case StockFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.productSearch);
    case StockFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.brandProductSearch);
    case StockFilterKeys.externalProductSearch:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.externalProductSearch);
    case StockFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.vendorSearch);
    case StockFilterKeys.needToStockExists:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.needToStockExists);
    case StockFilterKeys.needToStockDate:
      return getMinMaxQueryParam(
        filter,
        StockListViewUrlFiltersEnum.needToStockDateFrom,
        StockListViewUrlFiltersEnum.needToStockDateTo
      );
    case StockFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.brandSearch);
    case StockFilterKeys.categoryKind:
      return getMultipleEnumValueQueryParam(
        filter,
        StockListViewUrlFiltersWithMultipleValues.categoryKind,
        CategoryKindEnum
      );
    case StockFilterKeys.isSubPv:
      return getSingleValueQueryParam(filter, StockListViewUrlFiltersEnum.isSubPv);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<StockListViewUrlFilters>(STOCK_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  StockListViewUrlQueryParams,
  StockListViewUrlFilters
>({
  ...StockListViewUrlFiltersEnum,
  ...StockListViewUrlFiltersWithMultipleValues,
});
</file>

