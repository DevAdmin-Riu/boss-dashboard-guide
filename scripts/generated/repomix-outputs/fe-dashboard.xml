import { BulkAction, Dialog, Pagination, SingleAction } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const courierSectionUrl = "/couriers";

export const courierListViewPath = courierSectionUrl;
export type CourierListViewUrlDialog = "remove" | "remove-many";
export type CourierListViewUrlQueryParams = BulkAction & Dialog<CourierListViewUrlDialog> & Pagination & SingleAction;
export const courierListViewUrl = (params?: CourierListViewUrlQueryParams) =>
  urlJoin(courierListViewPath, "?" + stringifyQs(params));

export const courierDetailsViewPath = (id: string) => urlJoin(courierListViewPath, id);
export type CourierDetailsViewUrlDialog = "remove";
export type CourierDetailsViewUrlQueryParams = Dialog<CourierDetailsViewUrlDialog> & SingleAction & Partial<{}>;
export const courierUrl = (id: string, params?: CourierDetailsViewUrlQueryParams) =>
  courierDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);

export const courierCreateViewPath = urlJoin(courierListViewPath, "add");
export const courierCreateViewUrl = courierCreateViewPath;
