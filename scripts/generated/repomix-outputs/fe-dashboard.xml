import { DownloadableColumnsGroupType, DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { getDatesBetween, onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { makeSalesStatBrandColumns } from "@src/app/views/stats/components/SalesStatListPage/SalesStatListTableSettings";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Table, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

import { BrandListForExclusiveVariantStockInfo_brands_edges_node } from "../../api/types/BrandListForExclusiveVariantStockInfo";
import { ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands } from "../../api/types/ExclusiveVariantMonthlyStockInfoForBrands";
import { BrandExclusiveVariantStockInfoListPageProps } from "./BrandExclusiveVariantStockInfoListPage";

export interface IBrandExclusiveVariantStockInfoDataSource {
  brand: BrandListForExclusiveVariantStockInfo_brands_edges_node;
  stockInfoList: ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands[];
}

export const makeBrandExclusiveVariantStockInfoDataSource = (
  brands: BrandListForExclusiveVariantStockInfo_brands_edges_node[],
  stockInfoData: ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands[],
  includeThisMonth: boolean
): IBrandExclusiveVariantStockInfoDataSource[] => {
  const dataSource: IBrandExclusiveVariantStockInfoDataSource[] = [];
  brands.forEach((brand) => {
    const filteredStockInfoList = stockInfoData.filter((stockInfo) => stockInfo.brandGlobalId === brand.id);
    if (includeThisMonth) {
      filteredStockInfoList.push({
        statDate: moment().startOf("month").format(onlyDateFormat),
        brandGlobalId: brand.id,
        inStockExclusiveVariantsCount: brand.inStockExclusiveVariantsCount,
        totalExclusiveBpvCost: brand.totalExclusiveBpvCost,
        totalExclusivePvCost: brand.totalExclusivePvCost,
        criticalExclusiveVariantsCount: brand.criticalExclusiveVariantsCount,
        criticalTotalExclusiveBpvCost: brand.criticalTotalExclusiveBpvCost,
        criticalTotalExclusivePvCost: brand.criticalTotalExclusivePvCost,
        __typename: "ExclusiveVariantMonthlyStockInfoForBrands",
      });
    }

    dataSource.push({
      brand,
      stockInfoList: filteredStockInfoList,
    });
  });
  return dataSource;
};

const getStockInfoByMonth = (record: IBrandExclusiveVariantStockInfoDataSource, monthMoment: Moment) =>
  record.stockInfoList.find((stockInfo) => moment(stockInfo.statDate).isSame(monthMoment, "month"));

const makeStockInfoColumnByMonth = (
  monthMoment: Moment
): DownloadableColumnsGroupType<IBrandExclusiveVariantStockInfoDataSource> => {
  const monthStr = monthMoment.format(onlyMonthFormat);

  const stockInfoColumns: DownloadableColumnsType<IBrandExclusiveVariantStockInfoDataSource> = [
    {
      title: columnNameConstant.brand.IN_STOCK_EXCLUSIVE_PV_COUNT,
      key: "inStockExclusiveVariantsCount",
      align: "right",
      width: 100,
      render: (_, record) => (
        <NumberComponent value={getStockInfoByMonth(record, monthMoment)?.inStockExclusiveVariantsCount} />
      ),
      renderExcel: (record) => getStockInfoByMonth(record, monthMoment)?.inStockExclusiveVariantsCount ?? 0,
      isPickerHide: true,
    },
    {
      title: columnNameConstant.brand.TOTAL_EXCLUSIVE_PV_COST,
      key: "totalExclusiveBpvCost",
      align: "right",
      width: 120,
      render: (_, record) => (
        <NumberComponent value={toPriceExcludeVat(getStockInfoByMonth(record, monthMoment)?.totalExclusiveBpvCost)} />
      ),
      renderExcel: (record) => toPriceExcludeVat(getStockInfoByMonth(record, monthMoment)?.totalExclusiveBpvCost) ?? 0,
      isPickerHide: true,
    },
    {
      title: columnNameConstant.brand.CRITICAL_IN_STOCK_EXCLUSIVE_PV_COUNT,
      key: "criticalExclusiveVariantsCount",
      align: "right",
      width: 100,
      render: (_, record) => (
        <NumberComponent value={getStockInfoByMonth(record, monthMoment)?.criticalExclusiveVariantsCount} />
      ),
      renderExcel: (record) => getStockInfoByMonth(record, monthMoment)?.criticalExclusiveVariantsCount ?? 0,
      isPickerHide: true,
    },
    {
      title: columnNameConstant.brand.CRITICAL_TOTAL_EXCLUSIVE_PV_COST,
      key: "criticalTotalExclusiveBpvCost",
      align: "right",
      width: 120,
      render: (_, record) => (
        <NumberComponent
          value={toPriceExcludeVat(getStockInfoByMonth(record, monthMoment)?.criticalTotalExclusiveBpvCost)}
        />
      ),
      renderExcel: (record) =>
        toPriceExcludeVat(getStockInfoByMonth(record, monthMoment)?.criticalTotalExclusiveBpvCost) ?? 0,
      isPickerHide: true,
    },
  ];

  return {
    title: monthStr,
    key: monthStr,
    children: stockInfoColumns,
  };
};

export const getBrandExclusiveVariantStockInfoListTableSettings = (
  props: BrandExclusiveVariantStockInfoListPageProps
): DownloadableColumnsType<IBrandExclusiveVariantStockInfoDataSource> => {
  const { statDate } = props.filterVariables;
  const { gte: startDate, lte: endDate } = statDate || { gte: null, lte: null };
  const startMonth = moment(startDate);
  const endMonth = moment(endDate);
  const monthMomentArr = getDatesBetween([startMonth, endMonth], "month").dates;

  const columns: DownloadableColumnsType<IBrandExclusiveVariantStockInfoDataSource> = makeSalesStatBrandColumns();
  for (const monthMoment of monthMomentArr) {
    const monthColumn = makeStockInfoColumnByMonth(monthMoment);
    columns.push(monthColumn);
  }

  return columns;
};

const getStockInfoSumByMonth = (
  dataSource: readonly IBrandExclusiveVariantStockInfoDataSource[],
  monthMoment: Moment
): ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands | null => {
  const stockInfoListForMonth = dataSource.map((record) => getStockInfoByMonth(record, monthMoment)).filter(Boolean);
  if (stockInfoListForMonth.length === 0) {
    return null;
  }

  const sumStockInfo: ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands = {
    statDate: monthMoment.format(onlyMonthFormat),
    brandGlobalId: null,
    inStockExclusiveVariantsCount: null,
    totalExclusiveBpvCost: null,
    totalExclusivePvCost: null,
    criticalExclusiveVariantsCount: null,
    criticalTotalExclusiveBpvCost: null,
    criticalTotalExclusivePvCost: null,
    __typename: "ExclusiveVariantMonthlyStockInfoForBrands",
  };
  stockInfoListForMonth.forEach((stockInfo) => {
    sumStockInfo.inStockExclusiveVariantsCount += stockInfo?.inStockExclusiveVariantsCount || 0;
    sumStockInfo.totalExclusiveBpvCost += stockInfo?.totalExclusiveBpvCost || 0;
    sumStockInfo.totalExclusivePvCost += stockInfo?.totalExclusivePvCost || 0;
    sumStockInfo.criticalExclusiveVariantsCount += stockInfo?.criticalExclusiveVariantsCount || 0;
    sumStockInfo.criticalTotalExclusiveBpvCost += stockInfo?.criticalTotalExclusiveBpvCost || 0;
    sumStockInfo.criticalTotalExclusivePvCost += stockInfo?.criticalTotalExclusivePvCost || 0;
  });
  return sumStockInfo;
};

const getSummaryTotalElement = (
  stockInfoSumByMonth: ExclusiveVariantMonthlyStockInfoForBrands_exclusiveVariantMonthlyStockInfoForBrands,
  key: React.Key,
  startIndex: number
) => (
  <React.Fragment key={key}>
    <Table.Summary.Cell index={startIndex} align="right">
      <Typography.Text strong>
        <NumberComponent value={stockInfoSumByMonth.inStockExclusiveVariantsCount} />
      </Typography.Text>
    </Table.Summary.Cell>
    <Table.Summary.Cell index={startIndex + 1} align="right">
      <Typography.Text strong>
        <NumberComponent value={stockInfoSumByMonth.totalExclusiveBpvCost} />
      </Typography.Text>
    </Table.Summary.Cell>
    <Table.Summary.Cell index={startIndex + 2} align="right">
      <Typography.Text strong>
        <NumberComponent value={stockInfoSumByMonth.criticalExclusiveVariantsCount} />
      </Typography.Text>
    </Table.Summary.Cell>
    <Table.Summary.Cell index={startIndex + 3} align="right">
      <Typography.Text strong>
        <NumberComponent value={stockInfoSumByMonth.criticalTotalExclusiveBpvCost} />
      </Typography.Text>
    </Table.Summary.Cell>
  </React.Fragment>
);

const stockInfoColCnt = 4;

const getSummaryEmptyTotalElement = (key: React.Key, startIndex: number) => (
  <React.Fragment key={key}>
    {Array.from({ length: stockInfoColCnt }, (_, index) => (
      <Table.Summary.Cell key={index} index={startIndex + index} align="right">
        <Typography.Text strong>0</Typography.Text>
      </Table.Summary.Cell>
    ))}
  </React.Fragment>
);

export const getBrandExclusiveVariantStockInfoListTableSummary = (
  dataSource: readonly IBrandExclusiveVariantStockInfoDataSource[],
  props: BrandExclusiveVariantStockInfoListPageProps,
  columnKeyList: any[]
) => {
  const { statDate } = props.filterVariables;
  const { gte: startDate, lte: endDate } = statDate || { gte: null, lte: null };
  const startMonth = moment(startDate);
  const endMonth = moment(endDate);
  const monthMomentArr = getDatesBetween([startMonth, endMonth], "month").dates;

  let fixedBrandColCnt = 0;
  let restBrandColCnt = 0;
  makeSalesStatBrandColumns().forEach((col) => {
    if (utils.isEmpty(col?.fixed)) {
      if (columnKeyList.includes(col.key)) {
        restBrandColCnt += 1;
      }
    } else {
      if (columnKeyList.includes(col.key)) {
        fixedBrandColCnt += 1;
      }
    }
  });

  let startIndex: number = fixedBrandColCnt + restBrandColCnt;

  const retNumberElement = [];
  for (const monthMoment of monthMomentArr) {
    const monthStr = monthMoment.format(onlyMonthFormat);
    const stockInfoSumByMonth = getStockInfoSumByMonth(dataSource, monthMoment);
    if (stockInfoSumByMonth) {
      retNumberElement.push(getSummaryTotalElement(stockInfoSumByMonth, monthStr, startIndex));
    } else {
      retNumberElement.push(getSummaryEmptyTotalElement(monthStr, startIndex));
    }
    startIndex += stockInfoColCnt;
  }

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} colSpan={fixedBrandColCnt} align="center">
          <Typography.Text strong>합계</Typography.Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={fixedBrandColCnt} colSpan={restBrandColCnt} />
        {retNumberElement.map((element) => element)}
      </Table.Summary.Row>
    </Table.Summary>
  );
};
</file>

