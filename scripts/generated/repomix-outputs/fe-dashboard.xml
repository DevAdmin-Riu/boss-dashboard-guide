<file path="src/app/views/settings/pages/views/PageDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import { PageInput } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { convertMarkdownToContentJsonStr } from "@src/app/components/Editor/utils";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import { usePageDeleteMutation, usePageUpdateMutation } from "../api/mutations";
import { usePageDetailsQuery } from "../api/queries";
import { PageBasicInfoUpdateForm, PageDetailsPage, PageVisibilityUpdateForm } from "../components/PageDetailsPage";
import { pageListViewUrl } from "../urls";

interface PageDetailsViewProps {
  id: string;
}

export enum PageDetailsEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateVisibility = "UpdateVisibility",
}

enum PageDetailsModalModeEnum {
  Remove = "Remove",
}

export const PageDetailsView: React.FC<PageDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();
  const [editMode, setEditMode] = useState<PageDetailsEditModeEnum>(null);
  const [modalMode, setModalMode] = useState<PageDetailsModalModeEnum>(null);

  const onEdit = (mode: PageDetailsEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };

  const openModalWithoutNavigate = (modalMode: PageDetailsModalModeEnum) => {
    setModalMode(modalMode);
  };
  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const { data, loading } = usePageDetailsQuery({ skip: utils.isEmpty(id, true), variables: { id } });
  const page = maybe(() => data?.page, null);

  const [pageUpdate, pageUpdateOpts] = usePageUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.pageUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  const [pageDelete, pageDeleteOpts] = usePageDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.pageDelete.errors, "페이지를 삭제했습니다.", () =>
        navigate(pageListViewUrl())
      ),
  });

  const handleBack = () => navigate(pageListViewUrl());

  const handleBasicInfoUpdate = async (formData: PageBasicInfoUpdateForm) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: PageInput = {
      ...formData,
      content: convertedContent,
    };

    await pageUpdate({ variables: { id, input } });
  };

  const handleVisibilityUpdate = async (formData: PageVisibilityUpdateForm) => {
    const input: PageInput = {
      ...formData,
    };
    await pageUpdate({ variables: { id, input } });
  };

  if (loading) {
    return <Loader />;
  }
  return (
    <>
      <WindowTitle title={maybe(() => page.title)} />
      <PageDetailsPage
        disabled={loading || pageUpdateOpts.loading || pageDeleteOpts.loading}
        page={page}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBack={handleBack}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onVisibilityUpdate={handleVisibilityUpdate}
        onDelete={() => openModalWithoutNavigate(PageDetailsModalModeEnum.Remove)}
      />
      <ConfirmModal
        visible={modalMode === PageDetailsModalModeEnum.Remove}
        modalTitleText="페이지 삭제"
        titleText={utils.formatMessage(commonMsg.confirmDelete, { name: maybe(() => page.title, "...") })}
        onOk={() => pageDelete({ variables: { id } })}
        okButtonProps={{ danger: true, loading: pageDeleteOpts.loading }}
        okText="삭제"
        onCancel={resetForCloseModal}
      />
    </>
  );
};
</file>

