} from "./components/PurchaseOrderLineListPage/utils";
import { PurchaseOrderLineListViewRouteParams, PurchaseOrderLineListViewUrlQueryParams } from "./urls";
import {
  getPoEventTypeFromPoLineRouteParams,
  getPoLineStatusFromPoLineRouteParams,
} from "./view/PurchaseOrderLineListView/filters";

export const trackInventoryPurchaseOrderKey = "trackInventoryPurchaseOrderKey";
export const consignmentPurchaseOrderKey = "consignmentPurchaseOrderKey";
export const trackInventoryPurchaseOrderLineKeys = "trackInventoryPurchaseOrderLineKeys";
export const consignmentPurchaseOrderLineKeys = "consignmentPurchaseOrderLineKeys";

export const purchaseOrderStatusChoices = [
  {
    label: "대기",
    value: "STANDBY",
  },
  {
    label: "확정",
    value: "CONFIRMED",
  },
  {
    label: "부분입고 중",
    value: "PARTIALLY_BEING_STOCKED",
  },
  {
    label: "부분입고완료",
    value: "PARTIALLY_STOCKED",
  },
  {
    label: "입고완료",
    value: "FULLY_STOCKED",
  },
  {
    label: "출고내역존재",
    value: "FULFILLED",
  },
  {
    label: "취소",
    value: "CANCELED",
  },
];

export const getOldPurchaseOrderStatusText = (status: string) => {
  const choice = purchaseOrderStatusChoices.find((c) => c.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

export const getPurchaseOrderStatusText = (isSent: boolean) => (isSent ? "발송" : "대기");

export const getPurchaseOrderStatusTagColor = (eventType: PurchaseOrderEventType) => {
  switch (eventType) {
    case PurchaseOrderEventType.INITIAL_ORDER:
      return "green";
    case PurchaseOrderEventType.REORDER:
      return "blue";
    case PurchaseOrderEventType.CONSIGNMENT:
      return "geekblue";
    case PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK:
    case PurchaseOrderEventType.TAKE_BACK:
      return "red";
    default:
      return "gray";
  }
};

export const inventoryPurchaseOrderEventTypeChoices = [
  {
    label: "초도발주",
    value: PurchaseOrderEventType.INITIAL_ORDER,
  },
  {
    label: "재발주",
    value: PurchaseOrderEventType.REORDER,
  },
];

export const purchaseOrderEventTypeChoices = [
  {
    label: "초도발주",
    value: PurchaseOrderEventType.INITIAL_ORDER,
  },
  {
    label: "재발주",
    value: PurchaseOrderEventType.REORDER,
  },
  {
    label: "위탁발주",
    value: PurchaseOrderEventType.CONSIGNMENT,
  },
  {
    label: "재고 반품",
    value: PurchaseOrderEventType.TAKE_BACK,
  },
  {
    label: "위탁제품 반품",
    value: PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK,
  },
];

export const b2bPurchaseOrderEventTypeChoices = [
  {
    label: "B2B 발주",
