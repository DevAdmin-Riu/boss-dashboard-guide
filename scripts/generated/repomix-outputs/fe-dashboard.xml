const parseToLocationQtyInfo = (
  stockDetailEvent: Pick<StockDetailEventList_stockDetailEventList_edges_node, "parameters">
): [string[], Array<number | null>] => {
  const parameters = utils.jsonParseWrapper(stockDetailEvent.parameters);
  if (utils.isEmpty(parameters?.to_location_qty_info, true)) {
    return [[], []];
  }
  const toLocationQtyInfoList = parameters.to_location_qty_info.split(",");
  const toLocationList: string[] = [];
  const qtyList: Array<number | null> = [];
  toLocationQtyInfoList.forEach((toLocationQtyInfo) => {
    const [toLocation, toQtyString] = toLocationQtyInfo.split(": ");
    toLocationList.push(toLocation);
    qtyList.push(parseInt(toQtyString, 10));
  });
  return [toLocationList, qtyList];
};

export const getStockDetailEventTypeName = (type: StockDetailEventsEnum) => {
  switch (type) {
    case StockDetailEventsEnum.PURCHASE:
      return "입고";
    case StockDetailEventsEnum.ETC_PURCHASE:
      return "기타 입고";
    case StockDetailEventsEnum.TAKE_BACK:
      return "반품 발주";
    case StockDetailEventsEnum.LOSS:
      return "로스";
    case StockDetailEventsEnum.ADJUST_TO_ZERO:
      return "부자재 음수 재고 조정";
    case StockDetailEventsEnum.COMBINE:
      return "결합";
    case StockDetailEventsEnum.DIVIDE:
      return "소분";
