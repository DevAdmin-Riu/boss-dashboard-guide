import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useBrandHistoryListFilterDownloadQuery, useBrandHistoryListQuery } from "../../api/queries";
import {
  brandHistoryCreateViewUrl,
  brandHistoryDetailsViewUrl,
  BrandHistoryListViewUrlDialog,
  BrandHistoryListViewUrlQueryParams,
  brandsHistoryListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface BrandListViewProps {
  params: BrandHistoryListViewUrlQueryParams;
  // brand가 전달되는 경우는 상세페이지에서 넘어오는 경우임.
  brand?: {
    id: string;
    code: string;
  };
}
export const BrandHistoryListView: React.FC<BrandListViewProps> = ({ params, brand }) => {
  const shop = useShop();
  const brandId = !!brand ? brand?.id || "" : "";
  const brandCode = !!brand ? brand?.code || "" : "";
  // brand가 전달되는 경우는 상세페이지에서 넘어오는 경우임.
  const isBrandDetailsPage = utils.isEmpty(brand) === false;

  const targetUrl = brandsHistoryListViewUrl;

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BRAND_HISTORY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBrandHistoryListFilterDownloadQuery);

  const queryVariables = React.useMemo(() => {
    const variables = { ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) };
    if (isBrandDetailsPage) {
      variables.filter = { ...variables.filter, brandSearch: brandCode };
    }
    return variables;
  }, [params, settings?.rowNumber, brand, paginationState]);

  const { data, loading, refetch } = useBrandHistoryListQuery({
    initialListSkip: isBrandDetailsPage ? false : true,
    variables: queryVariables,
  });

  const filterOpts = getFilterOpts(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brandHistories?.pageInfo,
    paginationState,
    params,
  });

  // NOTE: Filter Tab과 Modal Tab을 사용하기 위한 설정
  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<BrandHistoryListViewUrlDialog, BrandHistoryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  return (
    <>
      <BrandHistoryListPage
        brandId={brandId}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        brandHistories={maybe(() => data.brandHistories.edges.map((edge) => edge.node))}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onAdd={() => {
          if (isBrandDetailsPage) {
            navigate(brandHistoryCreateViewUrl + "?brand=" + encodeURIComponent(brand.id));
          } else {
            navigate(brandHistoryCreateViewUrl);
          }
        }}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(brandHistoryDetailsViewUrl(id))}
        onSort={handleSort}
        sort={getSortParams(params)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      {isBrandDetailsPage || (
        <>
          <SaveFilterTabDialog
            open={params.action === "save-search"}
            onClose={closeModal}
            onSubmit={handleFilterTabSave}
          />
          <DeleteFilterTabDialog
            open={params.action === "delete-search"}
            onClose={closeModal}
            onSubmit={handleFilterTabDelete}
            tabName={maybe(() => tabs[currentTab - 1].name, "...")}
          />
        </>
      )}
    </>
  );
};
