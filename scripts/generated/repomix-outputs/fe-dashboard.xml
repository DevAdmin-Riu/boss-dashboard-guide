import NumberComponent from "@src/app/components/Number";
import {
  makeBpvCostPriceExcludeVat,
  makeBpvDeliveryFeeExcludeVat,
  makeBpvMallPriceExcludeVat,
  makeBpvPriceExcludeVat,
} from "@src/app/views/brand/brands/components/BrandProductListPage/utils";
import { makeSalesStatusByBrandProductVariant } from "@src/app/views/brand/brands/components/BrandProductListTable/BrandProductListTableSettings";
import { getBrandContractTypeText, getBrandMdName, getBrandRunningTypeText } from "@src/app/views/brand/brands/utils";
import {
  getVariantConsignmentCostPriceExcludeVat,
  getVariantConsignmentDeliveryFeeExcludeVat,
  getVariantConsignmentPriceExcludeVat,
  getVariantCostPriceExcludeVat,
  getVariantDeliveryFeeExcludeVat,
  getVariantInnerIncidentalCostExcludeVat,
  getVariantPriceExcludeVat,
  makeSalesStatusByProductVariant,
} from "@src/app/views/product/products/components/ProductListPage/ProductListTableSettings";
import { makePrefixForProductPrice } from "@src/app/views/product/products/components/ProductListPage/utils";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { transformIsExclusive, transformTrackInventoryVariantType } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import {
  RiuMinusProfitBpvList_brandProductVariants_edges_node,
  RiuMinusProfitBpvList_brandProductVariants_edges_node_productVariant,
} from "../../api/types/RiuMinusProfitBpvList";
import { RiuMinusProfitBpvListPageProps } from "./RiuMinusProfitBpvListPage";

const calcPvPriceExcludeVat = (pv: RiuMinusProfitBpvList_brandProductVariants_edges_node_productVariant) => {
  if (utils.isEmpty(pv)) {
    return null;
  }

  const { trackInventory } = pv;
  if (trackInventory) {
    return getVariantPriceExcludeVat(pv);
  } else {
    return getVariantConsignmentPriceExcludeVat(pv);
  }
};

const calcBpvProfitExcludeVat = (bpv: RiuMinusProfitBpvList_brandProductVariants_edges_node) => {
  const bpvPriceExcludeVat = makeBpvPriceExcludeVat(bpv);
  if (utils.isEmpty(bpvPriceExcludeVat)) {
    return null;
  }
  const pvPriceExcludeVat = calcPvPriceExcludeVat(bpv.productVariant);
  if (utils.isEmpty(pvPriceExcludeVat)) {
    return null;
  }

  if (bpv.brand.contractType !== BrandContractTypeEnum.MILEAGE) {
    return bpvPriceExcludeVat - pvPriceExcludeVat;
  }

  const bpvMallPriceExcludeVat = makeBpvMallPriceExcludeVat(bpv);
  if (utils.isEmpty(bpvMallPriceExcludeVat)) {
    return null;
  }

  if (utils.isEmpty(bpv.brand.mileageRate)) {
    return null;
  }

  return (
    bpvMallPriceExcludeVat -
    (pvPriceExcludeVat + Math.round(((bpvMallPriceExcludeVat - bpvPriceExcludeVat) * bpv.brand.mileageRate) / 100.0))
  );
};

const calcBpvProfitRate = (bpv: RiuMinusProfitBpvList_brandProductVariants_edges_node) => {
  const bpvPriceExcludeVat = makeBpvPriceExcludeVat(bpv);
  const pvPriceExcludeVat = calcPvPriceExcludeVat(bpv.productVariant);
  if (utils.isEmpty(pvPriceExcludeVat)) {
    return null;
  }

  if (bpv.brand.contractType !== BrandContractTypeEnum.MILEAGE) {
    return utils.calcProfitRate(bpvPriceExcludeVat, pvPriceExcludeVat);
  }

  const bpvMallPriceExcludeVat = makeBpvMallPriceExcludeVat(bpv);
  if (utils.isEmpty(bpvMallPriceExcludeVat)) {
    return null;
  }

  if (utils.isEmpty(bpv.brand.mileageRate)) {
    return null;
  }

  return utils.calcProfitRate(
    bpvMallPriceExcludeVat,
    pvPriceExcludeVat + Math.round(((bpvMallPriceExcludeVat - bpvPriceExcludeVat) * bpv.brand.mileageRate) / 100.0)
  );
};

