import makeMutation from "@hooks/makeMutation";
import { productErrorFragment } from "@src/api/fragments/errors";
import { reserveChangePriceBaseFragment } from "@src/api/fragments/products";
import gql from "graphql-tag";

import {
  CancelReserveChangePriceBase,
  CancelReserveChangePriceBaseVariables,
} from "./types/CancelReserveChangePriceBase";
import {
  ConfirmReserveChangePriceBase,
  ConfirmReserveChangePriceBaseVariables,
} from "./types/ConfirmReserveChangePriceBase";
import {
  CreateReserveChangePriceBase,
  CreateReserveChangePriceBaseVariables,
} from "./types/CreateReserveChangePriceBase";

const createReserveChangePriceBase = gql`
  ${reserveChangePriceBaseFragment}
  ${productErrorFragment}
  mutation CreateReserveChangePriceBase($input: CreateReserveChangePriceBaseInput!) {
    createReserveChangePriceBase(input: $input) {
      errors: productErrors {
        ...ProductErrorFragment
      }
      reserveChangePriceBase {
        ...ReserveChangePriceBaseFragment
      }
    }
  }
`;
export const useCreateReserveChangePriceBaseMutation = makeMutation<
  CreateReserveChangePriceBase,
  CreateReserveChangePriceBaseVariables
>(createReserveChangePriceBase);

const cancelReserveChangePriceBase = gql`
  ${productErrorFragment}
  mutation CancelReserveChangePriceBase($id: ID!) {
    cancelReserveChangePriceBase(id: $id) {
      errors: productErrors {
        ...ProductErrorFragment
      }
    }
  }
`;
export const useCancelReserveChangePriceBaseMutation = makeMutation<
  CancelReserveChangePriceBase,
  CancelReserveChangePriceBaseVariables
>(cancelReserveChangePriceBase);

const confirmReserveChangePriceBase = gql`
  ${reserveChangePriceBaseFragment}
  ${productErrorFragment}
  mutation ConfirmReserveChangePriceBase($id: ID!) {
    confirmReserveChangePriceBase(id: $id) {
      reserveChangePriceBase {
        ...ReserveChangePriceBaseFragment
      }
      errors: productErrors {
        ...ProductErrorFragment
      }
    }
  }
`;
export const useConfirmReserveChangePriceBaseMutation = makeMutation<
  ConfirmReserveChangePriceBase,
  ConfirmReserveChangePriceBaseVariables
>(confirmReserveChangePriceBase);
