import { usePvsForDevAssignSearch } from "@src/api/searches/useProductVariantSearch";
import { ProductVariantManageEventInput, ProductVariantManageEventTypeEnum } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import CompactFilter from "@src/app/components/Filter/CompactFilter";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Form, Input, Modal, Row, Space, Typography } from "antd";
import Table from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { productVariantManageEventTypeChoices } from "../../utils/data";
import { getDevPvTableSettings } from "../DevPvCard/DevPvTableSettings";
import { makePvOrBpvManageEventFormItems } from "../PvOrBpvManageEventModal";
import { createFilterStructure, getFilterOpts, getFilterVariables } from "./filters";

interface PvDevAssignModalForm {
  variantIds: string[];
  manageEvent: ProductVariantManageEventInput;
  needReason: boolean;
}

interface DevPvAssignModalProps {
  loading: boolean;
  open: boolean;
  // '개발비 제품'을 일반 제품에 연동하는 모드인지 여부
  // true: 모달에서 선택된 개발비 제품을 일반 제품에 연동하는 모드
  // false: 모달에서 선택된 일반 제품을 개발비 제품에 연동하는 모드
  isDevPvAssignMode: boolean;
  onSubmit: (formData: PvDevAssignModalForm) => void;
  onClose: () => void;
}

export const DevPvAssignModal: React.FC<DevPvAssignModalProps> = (props) => {
  const { loading, open, isDevPvAssignMode, onSubmit, onClose } = props;
  const initialQueryVariables: SearchPvsForDevAssignVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: getFilterVariables([], isDevPvAssignMode),
  };
  const [queryVariables, setQueryVariables] = useState<SearchPvsForDevAssignVariables>(initialQueryVariables);
  const [confirmModalOpen, setConfirmModalOpen] = useState<boolean>(false);

  const [form] = Form.useForm<PvDevAssignModalForm>();
  const TypeSafeForm = getTypeSafeForm<PvDevAssignModalForm>(form);
  const variantIdWatched = TypeSafeForm.getUseFormWatched({ name: "variantIds" });

  const initialValues: PvDevAssignModalForm = {
    variantIds: [],
    manageEvent: {
      type: ProductVariantManageEventTypeEnum.TYPE_ETC,
      title: null,
      reason: null,
    },
    needReason: true,
  };

  const filterOpts = getFilterOpts(queryVariables.filter);
  const filterStructure = createFilterStructure(filterOpts);

  const columns = getDevPvTableSettings({});
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const { loadMore, result } = usePvsForDevAssignSearch({ skip: !open, variables: initialQueryVariables });
  const { data, loading: searchLoading, refetch } = result;
  const dataSource = maybe(() => data.search.edges.map((edge) => edge.node), []);
  const hasMore = maybe(() => data.search.pageInfo.hasNextPage, false);

  useEffect(() => {
    if (open) {
      refetch();
    }
  }, [open]);

  const rowSelection: TableRowSelection<SearchPvsForDevAssign_search_edges_node> = {
    type: isDevPvAssignMode ? "checkbox" : "radio",
    selectedRowKeys: variantIdWatched,
    onChange: (selectedRowKeys) => {
      if (selectedRowKeys.length > 0) {
        TypeSafeForm.setFields([{ name: "variantIds", value: selectedRowKeys as string[] }]);
      }
    },
  };

  const modalLoading = loading || searchLoading;

  return (
    <Modal
      forceRender
      destroyOnClose
      width={1000}
      open={open}
      title="연동 제품 선택"
      okText="선택"
      okButtonProps={{ disabled: utils.isEmpty(variantIdWatched), loading: modalLoading }}
      onOk={form.submit}
      onCancel={onClose}
      afterClose={() => {
        form.resetFields();
        setConfirmModalOpen(false);
      }}
    >
      <Form
        layout="vertical"
        form={form}
        initialValues={initialValues}
        onFinish={(formData) => {
          const { variantIds } = formData;

          const shouldOpenConfirmModal = variantIds.some((id) => {
            const variant = dataSource.find((v) => v.id === id);
            if (!variant) {
              return false;
            }

            if (isDevPvAssignMode && !!variant.devPvOf) {
              return true;
            }

            if (!isDevPvAssignMode && variant.devPvs.length > 0) {
              return true;
            }

            return false;
          });

          if (shouldOpenConfirmModal) {
            setConfirmModalOpen(true);
          } else {
            onSubmit(formData);
          }
        }}
      >
        <Form.Item hidden name={TypeSafeForm.getValidDataIndex("variantIds")}>
          <Input />
        </Form.Item>
        <Space direction="vertical" size="large">
          <CompactFilter
            filterStructure={filterStructure}
            onFilterChange={(filters) => {
              if (!open) {
                return;
              }
              const filterVariables = getFilterVariables(filters, isDevPvAssignMode);
              const newQueryVariables = { ...queryVariables, filter: filterVariables };
              setQueryVariables(newQueryVariables);
              refetch(newQueryVariables);
            }}
            onFilterReset={() => {
              setQueryVariables(initialQueryVariables);
              refetch(initialQueryVariables);
            }}
          />
          <Table
            {...commonTableProps}
            tableLayout="fixed"
            loading={searchLoading}
            title={() => <Typography.Text strong>제품 검색 결과</Typography.Text>}
            columns={columns}
            dataSource={dataSource}
            rowSelection={rowSelection}
            scroll={{ x: tableWidthSum, y: 300 }}
            footer={
              hasMore &&
              (() => (
                <Row justify="center">
                  <Typography.Link onClick={loadMore}>더 보기</Typography.Link>
                </Row>
              ))
            }
          />
          <Card type="inner" title="제품 관리 이력">
            {makePvOrBpvManageEventFormItems({
              loading: modalLoading,
              manageEventType: null,
              choices: productVariantManageEventTypeChoices,
            })}
          </Card>
        </Space>
      </Form>

      <ConfirmModal
        visible={confirmModalOpen}
        titleText={
          isDevPvAssignMode
            ? "이미 다른 제품에 연동된 개발비 제품입니다. 이대로 진행하면 다른 제품과의 연동이 해제됩니다."
            : "이미 다른 개발비 제품에 연동된 일반 제품입니다. 이대로 진행하면 다른 개발비 제품과의 연동이 해제됩니다."
        }
        onOk={() => {
          const formData = form.getFieldsValue();
          onSubmit(formData);
          setConfirmModalOpen(false);
        }}
        onCancel={() => setConfirmModalOpen(false)}
      />
    </Modal>
  );
};
</file>

<file path="src/app/views/product/products/components/DevPvAssignModal/filters.ts">
import { ProductVariantFilterInput } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createTextField } from "@utils/filters/fields";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

enum PvForDevAssignSearchFilterKeys {
  productSearch = "productSearch",
  makerSearch = "makerSearch",
  vendorSearch = "vendorSearch",
}
type PvForDevAssignSearchFilters = Filters<PvForDevAssignSearchFilterKeys>;

interface PvForDevAssignSearchListFilterOpts {
  productSearch: FilterOpts<string>;
  makerSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
}

export const getFilterOpts = (filterVariables: ProductVariantFilterInput): PvForDevAssignSearchListFilterOpts => ({
  productSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
    value: filterVariables?.productSearch || "",
  },
  makerSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.makerSearch, true), false),
    value: filterVariables?.makerSearch || "",
  },
  vendorSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
    value: filterVariables?.vendorSearch || "",
  },
});

export const createFilterStructure = (
  opts: PvForDevAssignSearchListFilterOpts
): IFilter<PvForDevAssignSearchFilterKeys> => {
  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        PvForDevAssignSearchFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        PvForDevAssignSearchFilterKeys.makerSearch,
        filterNameConstant.MAKER_SEARCH,
        opts.makerSearch.value
      ),
      active: opts.makerSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        PvForDevAssignSearchFilterKeys.vendorSearch,
        filterNameConstant.VENDOR_SEARCH,
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): PvForDevAssignSearchFilters {
  const { name } = filter;

  switch (name) {
    case PvForDevAssignSearchFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, PvForDevAssignSearchFilterKeys.productSearch);
    case PvForDevAssignSearchFilterKeys.makerSearch:
      return getSingleValueQueryParam(filter, PvForDevAssignSearchFilterKeys.makerSearch);
    case PvForDevAssignSearchFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, PvForDevAssignSearchFilterKeys.vendorSearch);
  }
}

export function getFilterVariables(
  filters: Array<IFilterElement<string>>,
  isDevPvAssignMode: boolean
): ProductVariantFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  if (isDevPvAssignMode) {
    return { ...queryParams, isDevPv: true };
  } else {
    return { ...queryParams, isDevPv: false, isExclusive: true };
  }
}
</file>

