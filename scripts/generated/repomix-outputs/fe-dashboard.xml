import { PurchaseFilterInput, PurchaseStatusEnum, PurchaseTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  PurchaseListViewRouteParams,
  PurchaseListViewUrlFilters,
  PurchaseListViewUrlFiltersEnum,
  PurchaseListViewUrlFiltersWithMultipleValues,
  PurchaseListViewUrlQueryParams,
} from "@src/app/views/purchase/purchases/urls";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { VsPurchaseFilterKeys, VsPurchaseListFilterOpts } from "../../components/VsPurchaseListPage/filters";
import { VsPurchaseListViewRouteParams } from "../../urls";

const VS_PURCHASE_FILTERS_KEY = "vsPurchaseFilters";

export function getFilterOpts(
  params: PurchaseListViewUrlFilters,
  routeParams: VsPurchaseListViewRouteParams
): VsPurchaseListFilterOpts {
  const filterVariables = getFilterVariables(params, routeParams);
  const todayMoment = moment();
  const lastMonth = todayMoment.clone().subtract(1, "month");

  const firstDayOfLastMonth = lastMonth.clone().startOf("month").format(onlyDateFormat);
  const lastDayOfLastMonth = lastMonth.clone().endOf("month").format(onlyDateFormat);

  return {
    purchaseCloseMonth: {
      active: maybe(() => !utils.isEmpty([filterVariables.purchaseCloseDate.gte]), false),
      value: maybe(
        () => moment(filterVariables.purchaseCloseDate.gte).format(onlyMonthFormat),
        lastMonth.format(onlyMonthFormat)
      ),
    },
    purchaseCloseDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseCloseDate.gte, filterVariables.purchaseCloseDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseCloseDate.lte, lastDayOfLastMonth),
        min: maybe(() => filterVariables.purchaseCloseDate.gte, firstDayOfLastMonth),
      },
    },
    purchaseOrderDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseOrderDate.gte, filterVariables.purchaseOrderDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseOrderDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.purchaseOrderDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    purchaseDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.purchaseDate.gte, filterVariables.purchaseDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.purchaseDate.lte, lastDayOfLastMonth),
        min: maybe(() => filterVariables.purchaseDate.gte, firstDayOfLastMonth),
      },
    },
    purchaseOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.purchaseOrderSearch, true), false),
      value: maybe(() => filterVariables.purchaseOrderSearch, ""),
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    b2bOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bOrderSearch, true), false),
      value: maybe(() => filterVariables.b2bOrderSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => dedupeFilter(filterVariables.status), []),
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => dedupeFilter(filterVariables.type), []),
    },
  };
}

export function getFilterVariables(
  params: PurchaseListViewUrlFilters,
  routeParams: VsPurchaseListViewRouteParams
): PurchaseFilterInput {
  return {
    status: maybe(() => params.status.map((status) => findValueInEnum(status, PurchaseStatusEnum))),
    purchaseCloseDate: getPurchaseCloseDateFilterVariableFromParams(params, routeParams),
    purchaseOrderDate: getGteLteVariables({
      gte: params.purchaseOrderDateFrom,
      lte: params.purchaseOrderDateTo,
    }),
    purchaseDate: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    purchaseOrderSearch: params.purchaseOrderSearch !== undefined ? params.purchaseOrderSearch : null,
    orderSearch: params.orderSearch !== undefined ? params.orderSearch : null,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    type: maybe(() => params.type.map((type) => findValueInEnum(type, PurchaseTypeEnum))),
  };
}

export function getStatusFilterVariableFromVsPurchaseRouteParams(
  routeParams: VsPurchaseListViewRouteParams
): PurchaseStatusEnum[] {
  const { status: routeStatus } = routeParams;

  // 미정산
  if (routeStatus === "standby-or-revision") {
    return [PurchaseStatusEnum.STANDBY, PurchaseStatusEnum.REQ_REVISION, PurchaseStatusEnum.REVISION];
  }

  // 정산 대상
  if (routeStatus === "pending") {
    return [PurchaseStatusEnum.PENDING];
  }

  // 정산 내역
  if (routeStatus === "closed") {
    return [PurchaseStatusEnum.CLOSED];
  }

  // 전체 정산 내역
  if (routeStatus === "all-status") {
    return Object.values(PurchaseStatusEnum);
  }
}

export const getPurchaseCloseDateFilterVariableFromParams = (
  params: PurchaseListViewUrlFilters,
  routeParams: PurchaseListViewRouteParams | VsPurchaseListViewRouteParams
) => {
  const { status } = routeParams;

  switch (status) {
    case "pending":
      return getGteLteVariablesForMonth({
        gte: params.purchaseCloseMonth,
        lte: params.purchaseCloseMonth,
      });
    default:
      return getGteLteVariablesForMonth({
        gte: params.purchaseCloseDateFrom,
        lte: params.purchaseCloseDateTo,
      });
  }
};

export function getFilterQueryParam(filter: IFilterElement<VsPurchaseFilterKeys>): PurchaseListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case VsPurchaseFilterKeys.purchaseCloseMonth:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.purchaseCloseMonth);
    case VsPurchaseFilterKeys.purchaseCloseDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.purchaseCloseDateFrom,
        PurchaseListViewUrlFiltersEnum.purchaseCloseDateTo
      );
    case VsPurchaseFilterKeys.purchaseOrderDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.purchaseOrderDateFrom,
        PurchaseListViewUrlFiltersEnum.purchaseOrderDateTo
      );
    case VsPurchaseFilterKeys.purchaseDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.createdFrom,
        PurchaseListViewUrlFiltersEnum.createdTo
      );
    case VsPurchaseFilterKeys.purchaseOrderSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.purchaseOrderSearch);
    case VsPurchaseFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.orderSearch);
    case VsPurchaseFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.productSearch);
    case VsPurchaseFilterKeys.status:
      return getMultipleValueQueryParam(filter, PurchaseListViewUrlFiltersWithMultipleValues.status);
    case VsPurchaseFilterKeys.type:
      return getMultipleValueQueryParam(filter, PurchaseListViewUrlFiltersWithMultipleValues.type);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PurchaseListViewUrlFilters>(VS_PURCHASE_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PurchaseListViewUrlQueryParams,
  PurchaseListViewUrlFilters
>({ ...PurchaseListViewUrlFiltersEnum, ...PurchaseListViewUrlFiltersWithMultipleValues });
</file>

