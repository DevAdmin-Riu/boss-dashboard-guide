import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import { Goodsflow } from "@src/app/components/Goodsflow";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  FulfillmentList,
  FulfillmentList_fulfillments_edges_node,
  FulfillmentListVariables,
} from "@src/app/views/order/orders/api/types/FulfillmentList";
import {
  OrderDeliveryReprintListViewUrlQueryParams,
  OrderDeliveryReprintListViewUrlSortField,
} from "@src/app/views/order/orders/urls";
import { useCourierListQuery } from "@src/app/views/settings/couriers/api/queries";
import { GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Table, Typography } from "antd";
import { TableRowSelection } from "antd/es/table/interface";
import React, { useState } from "react";

import { createFilterStructure, OrderDeliveryReprintFilterKeys, OrderDeliveryReprintListFilterOpts } from "./filters";
import { getDeliveryReprintListTableSettings } from "./OrderDeliveryReprintListTableSettings";
import { createSorterStructure } from "./sorters";
import { OrderDeliveryReprintListViewTypeEnum } from "./utils";

export interface OrderDeliveryReprintListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderDeliveryReprintFilterKeys, OrderDeliveryReprintListFilterOpts>,
    SortPage<OrderDeliveryReprintListViewUrlSortField> {
  params: OrderDeliveryReprintListViewUrlQueryParams;
  deliveryReprintList: FulfillmentList_fulfillments_edges_node[];
  queryVariables: FulfillmentListVariables;
  refetch: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>;
  onOrderLineBoxSizeUpdate: (rowId: string) => void;
}

const OrderDeliveryReprintPage: React.FC<OrderDeliveryReprintListPageProps> = (props) => {
  const {
    params,
    deliveryReprintList,
    currentTab,
    filterOpts,
    tabs,
    sort,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    refetch,
    queryVariables,
    ...listProps
  } = props;
  const { orderDeliveryReprintListViewType } = params;
  const shop = useShop();
  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [selectedFulfillmentIds, setSelectedFulfillmentIds] = useState<React.Key[]>(null);
  const [onActionForModeA, setOnActionForModeA] = useState(false);

  const handleError = (errMessage) => {
    showNotificationError(errMessage);
    setOnActionForModeA(false);
  };

  const handleGoodsflowPrintSuccess = () => {
    refetch(queryVariables);
    setOnActionForModeA(false);
  };
  const { data } = useCourierListQuery({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.couriers },
  });
  const couriers = maybe(() => data.couriers.edges.map((edge) => edge.node), []);

  let pageTitle: string;
  switch (orderDeliveryReprintListViewType) {
    case OrderDeliveryReprintListViewTypeEnum.STOCK:
      pageTitle = "일반 배송 운송장 재출력";
      break;
    case OrderDeliveryReprintListViewTypeEnum.PICKING_ORDER:
      pageTitle = "합포장 배송 운송장 재출력";
      break;
    default:
      pageTitle = "운송장 재출력";
  }
  const rowSelection: TableRowSelection<FulfillmentList_fulfillments_edges_node> = {
    fixed: true,
    onChange: (selectedRowKeys) => setSelectedFulfillmentIds(selectedRowKeys),
  };
  const columns = getDeliveryReprintListTableSettings(props, refetch, couriers);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
          <Typography.Title level={5} type="danger">
            운송장 재출력 시 기존 발행한 운송장은 무효화되어 택배사에서 인식할 수 없습니다.
          </Typography.Title>
        </Col>
        <Col>
          <Goodsflow
            loading={onActionForModeA}
            disabled={selectedFulfillmentIds === null || selectedFulfillmentIds?.length <= 0}
            mode="print-retry"
            setLoading={setOnActionForModeA}
            onError={handleError}
            onSuccess={handleGoodsflowPrintSuccess}
            config={shop?.goodsflowPluginConfig}
            onlySelectedMode={true}
            selectedFulfillmentIds={selectedFulfillmentIds}
          />
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={<SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />}
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          rowSelection={rowSelection}
          loading={listProps.disabled}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          columns={columns}
          dataSource={deliveryReprintList}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
export default OrderDeliveryReprintPage;
</file>

