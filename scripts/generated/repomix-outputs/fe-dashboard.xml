<file path="src/global/core/hooks/useWizard.ts">
import { useState } from "react";

export interface UseWizardActions<T> {
  next: () => void;
  prev: () => void;
  set: (step: T) => void;
}
export interface UseWizardOpts<T> {
  onTransition: (prevStep: T, nextStep: T) => void;
}
export type UseWizard<T> = [T, UseWizardActions<T>];
function useWizard<T>(initial: T, steps: T[], opts?: UseWizardOpts<T>): UseWizard<T> {
  const [stepIndex, setStepIndex] = useState(steps.indexOf(initial));

  function goToStep(nextStepIndex) {
    if (typeof opts?.onTransition === "function") {
      opts.onTransition(steps[stepIndex], steps[nextStepIndex]);
    }
    setStepIndex(nextStepIndex);
  }

  function next() {
    if (stepIndex === steps.length - 1) {
      console.error("This is the last step");
    } else {
      goToStep(stepIndex + 1);
    }
  }

  function prev() {
    if (stepIndex === 0) {
      console.error("This is the first step");
    } else {
      goToStep(stepIndex - 1);
    }
  }

  function set(step: T) {
    const newStepIndex = steps.findIndex((s) => s === step);
    if (newStepIndex === -1) {
      console.error("Step does not exist");
    } else {
      goToStep(newStepIndex);
    }
  }

  return [
    steps[stepIndex],
    {
      next,
      prev,
      set,
    },
  ];
}

export default useWizard;
</file>

<file path="src/global/core/utils/barcode/convertBarcode.ts">
import bwipjs from "@bwip-js/browser";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";

export enum BarcodePrefixEnum {
  SECTOR = "SCT_",
  LOCATION = "LOC_",
  PRODUCT = "PRD_",
}

interface IConvertValueToBarcodeBuffer {
  type?: "barcode" | "qrcode";
  value: string;
  prefix?: BarcodePrefixEnum;
}
export const convertValueToBarcodeImgUrl = async ({
  type = "barcode",
  value,
  prefix = null,
}: IConvertValueToBarcodeBuffer): Promise<string> => {
  try {
    const text = utils.isEmpty(prefix, true) ? value : prefix + value;

    // Canvas 생성
    const canvas = document.createElement("canvas");

    // bwip-js를 사용하여 바코드 또는 QR 코드 생성
    bwipjs.toCanvas(canvas, {
      bcid: type === "qrcode" ? "qrcode" : "code128", // QR 코드 또는 바코드 형식
      text,
      includetext: false,
    });

    // Canvas 데이터를 Base64 문자열로 반환
    return canvas.toDataURL("image/png");
  } catch (error) {
    console.error(`Failed to generate ${type}:`, error);
    showNotificationError("바코드 생성 중 오류가 발생했습니다.");
    return null;
  }
};
