import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { calcPackCount } from "@src/app/views/product/products/utils/utils";
import { getDisplayInnerProductName } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Space, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { OrderLineListForFulfill_orderLines_edges_node } from "../../api/types/OrderLineListForFulfill";

interface PickingOrderFulfillTableSettingsProps {
  onDivideOrCombine: (variantId: string) => void;
}

export const getPickingOrderFulfillTableSettings = (props: PickingOrderFulfillTableSettingsProps) => {
  const { onDivideOrCombine } = props;
  const fixedRightFlag = utils.fixedRightFlag();
  const columns: ColumnsType<OrderLineListForFulfill_orderLines_edges_node> = [
    {
      title: columnNameConstant.product.SKU,
      key: "productSku",
      align: "center",
      width: 120,
      render: (_, record) => record.productSku || "-",
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 200,
      render: (_, record) => getDisplayInnerProductName(record.variant.product.name || "-", true) || "-",
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 150,
      render: (_, record) => record.variantName || "-",
    },
    {
      title: columnNameConstant.orderLine.ORDER_QTY,
      key: "quantity",
      align: "right",
      width: 80,
      render: (_, record) => record.orderedOrFulfillQty,
    },
    {
      title: (
        <Space direction="vertical" size={0}>
          <Typography>이너박스</Typography>
          <Typography>{columnNameConstant.stock.SUM_OF_STOCK_QUANTITY}</Typography>
        </Space>
      ),
      key: "innerStockQuantity",
      align: "right",
      width: 80,
      render: (_, record) => record.variant.stocks.reduce((acc, stock) => acc + stock.quantity, 0),
    },
    {
      title: (
        <Space direction="vertical" size={0}>
          <Typography>아우터박스</Typography>
          <Typography>{columnNameConstant.stock.SUM_OF_STOCK_QUANTITY}</Typography>
        </Space>
      ),
      key: "outerStockQuantity",
      align: "right",
      width: 80,
      render: (_, record) => record.variant.outer.stocks.reduce((acc, stock) => acc + stock.quantity, 0),
    },
    {
      title: "pack 수량",
      key: "packCount",
      align: "right",
      width: 100,
      render: (_, record) => {
        const packCount = calcPackCount(record.variant.outer, record.variant);
        return `${packCount} pack`;
      },
    },
    {
      title: "소분대상 수량",
      key: "remainOuterVirtualAllocate",
      align: "right",
      width: 100,
      fixed: fixedRightFlag,
      render: (_, record) => (
        <Typography.Text strong type="danger">
          {record.remainOuterVirtualAllocate}
        </Typography.Text>
      ),
    },
    {
      key: "action",
      align: "center",
      width: 80,
      fixed: fixedRightFlag,
      render: (_, record) => (
        <Button type="primary" size="small" onClick={() => onDivideOrCombine(record.variant?.id)}>
          소분
        </Button>
      ),
    },
  ];
  return columns;
};
