  checkPassword: (str) => {
    const min = InputCheckDef.loginPasswordMin;
    const max = InputCheckDef.loginPasswordMax;
    const reg = new RegExp("^[a-zA-Z0-9`~!@@#$%^&*|\\'\";:/?]" + `{${min},${max}}$`);
    const numCheckReg = /[0-9]/;
    const alphabetCheckReg = /[a-zA-Z]/;

    return reg.test(str) && numCheckReg.test(str) && alphabetCheckReg.test(str);
  },
  checkDigitRangeLength: (str, min, max) => {
