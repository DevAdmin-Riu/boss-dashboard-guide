import { BrandProductVariantFilterInput, SalesStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

import { HqB2bBpvListFilterKeys, HqB2bBpvListFilterOpts } from "../../components/HqB2bBpvListPage/filters";
import {
  HqB2bBpvListViewUrlFilters,
  HqB2bBpvListViewUrlFiltersEnum,
  HqB2bBpvListViewUrlFiltersWithMultipleValuesEnum,
  HqB2bBpvListViewUrlQueryParams,
} from "../../urls";

const HQ_B2B_BPV_FILTERS_KEY = "hqB2bBpvFilters";

export function getFilterOpts(params: HqB2bBpvListViewUrlFilters): HqB2bBpvListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: filterVariables.brandProductSearch,
    },
    pvSalesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.pvSalesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.pvSalesStatus), []),
    },
    includeSalesB2bDeliveryFee: {
      active: maybe(() => !utils.isEmpty(filterVariables.includeSalesB2bDeliveryFee), false),
      value: maybe(() => filterVariables.includeSalesB2bDeliveryFee, false),
    },
  };
}

export function getFilterVariables(params: HqB2bBpvListViewUrlFilters): BrandProductVariantFilterInput {
  return {
    excludePvSalesStatusStopped: true,
    brandProductSearch: params.brandProductSearch,
    pvSalesStatus: maybe(() => params.pvSalesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    includeSalesB2bDeliveryFee:
      params.includeSalesB2bDeliveryFee !== undefined
        ? parseBoolean(params.includeSalesB2bDeliveryFee, false)
        : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<HqB2bBpvListFilterKeys>): HqB2bBpvListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqB2bBpvListFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, HqB2bBpvListViewUrlFiltersEnum.brandProductSearch);
    case HqB2bBpvListFilterKeys.pvSalesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqB2bBpvListViewUrlFiltersWithMultipleValuesEnum.pvSalesStatus,
        SalesStatusEnum
      );
    case HqB2bBpvListFilterKeys.includeSalesB2bDeliveryFee:
      return getSingleValueQueryParam(filter, HqB2bBpvListViewUrlFiltersEnum.includeSalesB2bDeliveryFee);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqB2bBpvListViewUrlFilters>(HQ_B2B_BPV_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  HqB2bBpvListViewUrlQueryParams,
  HqB2bBpvListViewUrlFilters
>({ ...HqB2bBpvListViewUrlFiltersEnum, ...HqB2bBpvListViewUrlFiltersWithMultipleValuesEnum });
</file>

