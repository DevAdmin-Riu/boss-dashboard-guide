            : sale.variant?.consignmentCostPriceExcludeVat;
          const otherVariantCostPriceAmount = toPriceIncludeVat(otherVariantCostPriceExcludeVat, sale.isTaxFree);
          return sum + toPriceExcludeVat(otherVariantCostPriceAmount * sale.quantity, sale.isTaxFree);
        }, 0);
      return mainTotal + bundleOtherTotal;
    }

    return mainTotal;
  };
