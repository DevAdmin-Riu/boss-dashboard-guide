<file path="src/app/views/order/taxInvoice/components/TaxInvoiceListPage/filter.ts">
import { OrderType, TaxInvoiceStatusEnum } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum TaxInvoiceFilterKeys {
  orderSearch = "orderSearch",
  brandSearch = "brandSearch",
  userSearch = "userSearch",
  writedAt = "writedAt",
  issuedAt = "issuedAt",
  isTaxFree = "isTaxFree",
  isFromRiu = "isFromRiu",
  isToHq = "isToHq",
  status = "status",
}

export interface TaxInvoiceListFilterOpts {
  orderSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  writedAt: FilterOpts<MinMax>;
  issuedAt: FilterOpts<MinMax>;
  isTaxFree: FilterOpts<boolean>;
  isFromRiu: FilterOpts<boolean>;
  isToHq: FilterOpts<boolean>;
  status: FilterOpts<TaxInvoiceStatusEnum[]>;
}

export function createFilterStructure(
  opts: TaxInvoiceListFilterOpts,
  orderType: OrderType,
  isStaff: boolean
): IFilter<TaxInvoiceFilterKeys> {
  let displayOrder = 0;

  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      TaxInvoiceFilterKeys.orderSearch,
      columnNameConstant.order.ORDER_COMPOSED_ID,
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };

  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      TaxInvoiceFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };

  const userSearchFilter = {
    ...createTextField(displayOrder++, TaxInvoiceFilterKeys.userSearch, "사용자 ID / 이름", opts.userSearch.value),
    active: opts.userSearch.active,
  };

  const writedAtFilter = {
    ...createDateField(displayOrder++, TaxInvoiceFilterKeys.writedAt, "작성일", opts.writedAt.value),
    active: opts.writedAt.active,
  };
  const issuedAtFilter = {
    ...createDateField(displayOrder++, TaxInvoiceFilterKeys.issuedAt, "발행일", opts.issuedAt.value),
    active: opts.issuedAt.active,
  };
  const isFromRiuFilter = {
    ...createBooleanField(displayOrder++, TaxInvoiceFilterKeys.isFromRiu, "공급자", opts.isFromRiu.value, {
      negative: "가맹본부",
      positive: "포장보스",
    }),
    active: opts.isFromRiu.active,
  };
  const isToHqFilter = {
    ...createBooleanField(displayOrder++, TaxInvoiceFilterKeys.isToHq, "공급받는자", opts.isToHq.value, {
      negative: "가맹점",
      positive: "가맹본부",
    }),
    active: opts.isToHq.active,
  };
  const isTaxFreeFilter = {
    ...createBooleanField(displayOrder++, TaxInvoiceFilterKeys.isTaxFree, "면세", opts.isTaxFree.value, {
      negative: "과세",
      positive: "면세",
    }),
    active: opts.isTaxFree.active,
  };
  const statusFilter = {
    ...createOptionsField(displayOrder++, TaxInvoiceFilterKeys.status, "발행상태", opts.status.value, false, [
      { label: "발행대기", value: TaxInvoiceStatusEnum.REQUESTED },
      { label: "발행", value: TaxInvoiceStatusEnum.ISSUED },
      { label: "취소", value: TaxInvoiceStatusEnum.CANCELED },
    ]),
    active: opts.status.active,
  };

  const isByStaffForBrand = orderType === OrderType.BY_STAFF_FOR_BRAND;

  if (isStaff === true) {
    return [
      orderSearchFilter,
      writedAtFilter,
      issuedAtFilter,
      !isByStaffForBrand && isFromRiuFilter,
      !isByStaffForBrand && isToHqFilter,
      brandSearchFilter,
      userSearchFilter,
      isTaxFreeFilter,
      statusFilter,
    ].filter(Boolean);
  } else if (isStaff === false) {
    return [orderSearchFilter, writedAtFilter, issuedAtFilter, userSearchFilter, statusFilter];
  }
}
</file>

