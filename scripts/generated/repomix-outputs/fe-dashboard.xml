import { StaffMemberStatus, StaffUserFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { StaffFilterKeys, StaffListFilterOpts } from "@src/app/views/settings/staff/components/StaffListPage";
import {
  createFilterTabUtils,
  createFilterUtils,
  getSingleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { StaffListViewUrlFilters, StaffListViewUrlFiltersEnum, StaffListViewUrlQueryParams } from "../../urls";

export const STAFF_FILTERS_KEY = "staffFilters";

export function getFilterOpts(params: StaffListViewUrlFilters): StaffListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    search: {
      active: maybe(() => !utils.isEmpty(filterVariables.search, true), false),
      value: maybe(() => filterVariables.search, ""),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => findValueInEnum(filterVariables.status, StaffMemberStatus), StaffMemberStatus.DEACTIVATED),
    },
  };
}

export function getFilterVariables(params: StaffListViewUrlFilters): StaffUserFilterInput {
  return {
    search: params.search,
    status: params.status ? findValueInEnum(params.status, StaffMemberStatus) : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<StaffFilterKeys>): StaffListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case StaffFilterKeys.search:
      return getSingleValueQueryParam(filter, StaffListViewUrlFiltersEnum.search);
    case StaffFilterKeys.status:
      return getSingleEnumValueQueryParam(filter, StaffListViewUrlFiltersEnum.status, StaffMemberStatus);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<StaffListViewUrlFilters>(STAFF_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  StaffListViewUrlQueryParams,
  StaffListViewUrlFilters
>(StaffListViewUrlFiltersEnum);
