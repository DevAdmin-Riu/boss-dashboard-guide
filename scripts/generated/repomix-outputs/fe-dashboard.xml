import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  B2bOrderLineListViewRouteParams,
  B2bSalesStatListViewUrlQueryParams,
  B2bSettlementForSalesViewUrlQueryParams,
  B2bTaxInvoiceListViewUrlQueryParams,
} from "../../b2b/urls";
import { getB2bOrderLineListDefaultParams, getB2bSalesStatListDefaultParams } from "../../b2b/utils";
import B2bOrderLineListView from "../../b2b/views/B2bOrderLineListView/B2bOrderLineListView";
import { B2bSalesStatListView } from "../../b2b/views/B2bSalesStatListView/B2bSalesStatListView";
import B2bTaxInvoiceListView from "../../b2b/views/B2bTaxInvoiceListVew/B2bTaxInvoiceListView";
import { OrderLineListViewUrlQueryParams } from "../../order/orders/urls";
import {
  hqB2bBpvListViewPath,
  HqB2bBpvListViewUrlQueryParams,
  hqB2bOrderLineListViewPath,
  hqB2bSettlementListViewPath,
  HqB2bSettlementListViewRouteParams,
} from "./urls";
import { getHqB2bSettlementListDefaultParams } from "./utils";
import { HqB2bBpvListView } from "./views/HqB2bBpvListView/HqB2bBpvListView";
import HqB2bSettlementListView from "./views/HqB2bSettlementListView/HqB2bSettlementListView";

const HqB2bOrderLineListViewWrapper: React.FC<RouteComponentProps<B2bOrderLineListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getB2bOrderLineListDefaultParams(match.params);
  const params: OrderLineListViewUrlQueryParams = { ...defaultParams, ...qs };

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.hqStaffOrders} />
      <B2bOrderLineListView defaultParams={defaultParams} params={params} />
    </>
  );
};

const HqB2bSettlementListViewWrapper: React.FC<RouteComponentProps<HqB2bSettlementListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const { status } = match.params;

  if (status === "pending") {
    const defaultParams = getB2bSalesStatListDefaultParams(match.params);
    const params: B2bSalesStatListViewUrlQueryParams = { ...defaultParams, ...qs };
    return <B2bSalesStatListView defaultParams={defaultParams} params={params} />;
  } else if (status === "taxinvoice") {
    const params: B2bTaxInvoiceListViewUrlQueryParams = qs;
    return <B2bTaxInvoiceListView params={params} isB2b={true} />;
  } else {
    const defaultParams = getHqB2bSettlementListDefaultParams(match.params);
    const params: B2bSettlementForSalesViewUrlQueryParams = { ...defaultParams, ...qs };
    return <HqB2bSettlementListView defaultParams={defaultParams} params={params} />;
  }
};

const HqB2bBpvListViewWrapper: React.FC<RouteComponentProps> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: HqB2bBpvListViewUrlQueryParams = { ...qs };

  return <HqB2bBpvListView params={params} />;
};

const HqB2bSection = () => (
  <>
    <Switch>
      <Route exact path={hqB2bOrderLineListViewPath({ status: ":status" })} component={HqB2bOrderLineListViewWrapper} />
      <Route exact path={hqB2bBpvListViewPath} component={HqB2bBpvListViewWrapper} />
      <>
        <WindowTitle title={firstDepthMenuTitle.settlementInfo} />
        <Route
          exact
          path={hqB2bSettlementListViewPath({ status: ":status" })}
          component={HqB2bSettlementListViewWrapper}
        />
      </>
    </Switch>
  </>
);

export default HqB2bSection;
</file>

