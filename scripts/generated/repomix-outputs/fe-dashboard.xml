<file path="src/app/views/brand/brandStore/components/BrandStoreCreateModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { formRuleMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import useHqStaffSearch from "@src/api/searches/useHqStaffSearch";
import { BrandStoreCreateInput, HqStaffRoleEnum } from "@src/api/types/globalTypes";
import { getCollapseClassName } from "@src/app/components/antd/Collapse/CollapseProps";
import { getFormItemClassName } from "@src/app/components/antd/Form/FormProps";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { useBrandStoreCreateMutation } from "@src/app/views/brand/brandStore/api/mutations";
import {
  brandStoreContractChoices,
  brandStoreStatusChoices,
  brandStoreTypeChoices,
} from "@src/app/views/brand/brandStore/utils";
import { HqPreFounderDetails_preFounder } from "@src/app/views/hqStaff/hqPreFounder/api/types/HqPreFounderDetails";
import { makeAddressInputFromDaumPostcode, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Col, Collapse, Form, Input, Modal, Row, Select } from "antd";
import { useForm } from "antd/lib/form/Form";
import { DocumentNode } from "graphql";
import React, { useEffect } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

interface BrandStoreCreateModalProps {
  brandId?: string;
  // 가맹본부가 예비창업자 상세 페이지에서 매장 전환하려고 하는 경우에만 전달
  preFounder?: HqPreFounderDetails_preFounder;
  open: boolean;
  onClose: () => void;
  refetchQueries?: DocumentNode[];
}
const BrandStoreCreateModal: React.FC<BrandStoreCreateModalProps> = (props) => {
  const { open, onClose, brandId, preFounder, refetchQueries = [] } = props;

  const { user, updateUser } = useUser();

  const [searchedBrands, setSearchedBrands] = React.useState([]);
  const [searchedHqStaffs, setSearchedHqStaffs] = React.useState([]);

  const [openConfirmModal, setOpenConfirmModal] = React.useState(false);
  const [form] = useForm<BrandStoreCreateInput>();
  const TypeSafeForm = getTypeSafeForm<BrandStoreCreateInput>(form);

  const [visibleSearchAddressForm, setVisibleSearchAddressForm] = React.useState(false);

  const formBrandId = TypeSafeForm.getUseFormWatched({ name: "brand" });
  const needToSelectBrand = !brandId;

  useEffect(() => {
    if (brandId) {
      TypeSafeForm.setFields([
        {
          name: "brand",
          value: brandId,
        },
      ]);
    }
  }, [brandId]);

  const isCreateFromPreFounder = !!preFounder;

  useEffect(() => {
    if (open && isCreateFromPreFounder) {
      TypeSafeForm.setFields([
        { name: "preFounder", value: preFounder.id },
        { name: "aligoPhone", value: preFounder.phone },
        { name: "email", value: preFounder.email },
        { name: "bizRegNo", value: preFounder.bizRegNo },
        { name: "bizRegCeoName", value: preFounder.name },
      ]);
    } else {
      TypeSafeForm.setFields([
        {
          name: "preFounder",
          value: undefined,
        },
      ]);
    }
  }, [open, preFounder]);

  const onModalClose = () => {
    form.resetFields();
    setVisibleSearchAddressForm(false);
    setSearchedBrands(undefined);
    onClose();
  };

  // 주소 검색으로 입력된 값으로 폼 값 세팅
  const searchAddress = (address: Address) => {
    const input = makeAddressInputFromDaumPostcode(address);
    TypeSafeForm.setFields([
      { name: "defaultShippingAddress.postalCode", value: input.postalCode },
      { name: "defaultShippingAddress.city", value: input.city },
      { name: "defaultShippingAddress.countryArea", value: input.countryArea },
      { name: "defaultShippingAddress.streetAddress1", value: input.streetAddress1 },
      { name: "defaultShippingAddress.country", value: input.country },
    ]);
    setVisibleSearchAddressForm(false);
  };

  const [createBrandStore, {}] = useBrandStoreCreateMutation({
    onCompleted: (data) => {
      const errors = data.brandStoreCreate.errors;
      if (errors.length === 0) {
        const userloginId = data.brandStoreCreate.user.loginId;
        const userBrandCode = data.brandStoreCreate.user.brand.code;
        showNotificationSuccess(
          `매장과 점주/점장 계정(아이디:${userloginId}, 비밀번호:${userBrandCode}) 이 생성되었습니다.`
        );
        updateUser({
          brand: {
            ...user.brand,
            numberOfActiveStores: data.brandStoreCreate.user.brand?.numberOfActiveStores,
          },
        });

        onModalClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries,
  });

  const brandSearchVariable: SearchBrandsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.brandStoresForSeach,
  };

  const { loadMore, search, result } = useBrandSearch({
    skip: !open || !needToSelectBrand,
    variables: brandSearchVariable,
  });
  const fetchMoreData = {
    hasMore: maybe(() => result.data.search.pageInfo.hasNextPage),
    loading: result.loading,
    onFetchMore: loadMore,
  };

  useEffect(() => {
    setSearchedBrands(
      result.data?.search?.edges.map((edge) => ({
        label: edge.node.name,
        value: edge.node.id,
      }))
    );
  }, [result?.data?.search?.edges]);

  const brandFilterOption = (input: string, option: { label: string; value: string }) =>
    (option?.label ?? "").toLowerCase().includes(input.toLowerCase());

  const {
    loadMore: hqStaffsLoadMore,
    result: hqStaffs,
    search: searchHqStaffs,
  } = useHqStaffSearch({
    skip: !open || utils.isEmpty(formBrandId),
    variables: {
      first: 5,
      brand: formBrandId,
      hqStaffRole: [HqStaffRoleEnum.SUPERVISOR, HqStaffRoleEnum.SUPERVISOR_ALL],
    },
  });
  const fetchMoreDataForHqStaffs = {
    hasMore: maybe(() => hqStaffs.data.search.pageInfo.hasNextPage),
    loading: hqStaffs.loading,
    onFetchMore: hqStaffsLoadMore,
  };

  useEffect(() => {
    setSearchedHqStaffs(
      hqStaffs.data?.search?.edges.map((edge) => ({
        label: `${edge.node.firstName}(${edge.node.loginId})`,
        value: edge.node.id,
      }))
    );
  }, [hqStaffs?.data?.search?.edges]);

  const onSubmit = async (formData: BrandStoreCreateInput) => {
    const brand = brandId ?? formData.brand;
    const input: BrandStoreCreateInput = {
      ...formData,
      brand,
      defaultShippingAddress: {
        ...formData.defaultShippingAddress,
        firstName: formData.firstName,
        phone: formData.aligoPhone,
      },
    };

    await createBrandStore({
      variables: {
        input,
      },
    });

    setOpenConfirmModal(false);
  };

  return (
    <Modal
      maskClosable={false}
      forceRender
      closable={false}
      onOk={() => setOpenConfirmModal(true)}
      onCancel={() => {
        if (visibleSearchAddressForm) {
          setVisibleSearchAddressForm(false);
        }

        onModalClose();
      }}
      open={open}
      title={isCreateFromPreFounder ? "매장 전환" : "매장 생성"}
      okText="확인"
      cancelText="닫기"
      width={1000}
    >
      <Collapse
        defaultActiveKey="false"
        activeKey={String(visibleSearchAddressForm)}
        className={getCollapseClassName(["ant-collapse-no-style"])}
      >
        <Collapse.Panel forceRender header={null} key="false">
          <Form
            name="brand-store-create"
            form={TypeSafeForm.formInstance}
            colon={false}
            labelCol={{ span: 24 }}
            wrapperCol={{ span: 24 }}
            validateMessages={{ required: formRuleMsg.requiredSelect }}
            onFinish={onSubmit}
          >
            <Form.Item name={TypeSafeForm.getValidDataIndex("defaultShippingAddress")} hidden>
              <Input />
            </Form.Item>

            <Row gutter={[8, 0]}>
              <Col span={!!brandId ? 0 : 8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("brand")}
                  label="브랜드"
                  hidden={!needToSelectBrand}
                  rules={[{ required: needToSelectBrand }]}
                >
                  <Select
                    showSearch
                    filterOption={brandFilterOption}
                    onSearch={search}
                    loading={fetchMoreData.loading}
                    options={searchedBrands}
                    onPopupScroll={fetchMoreData.onFetchMore}
                  />
                </Form.Item>
              </Col>
              <Col span={isCreateFromPreFounder ? 8 : 0}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("preFounder")} label="예비창업자">
                  <Select disabled options={utils.getOptionsWithInitialValue([], preFounder?.id, preFounder?.name)} />
                </Form.Item>
              </Col>
            </Row>
            <Row gutter={[8, 0]}>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("firstName")}
                  label="매장명"
                  rules={[{ required: true, message: formRuleMsg.required }]}
                >
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("brandStoreType")}
                  label="유형"
                  rules={[{ required: true }]}
                >
                  <Select options={brandStoreTypeChoices} />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("brandStoreStatus")}
                  label="상태"
                  rules={[{ required: true }]}
                >
                  <Select options={brandStoreStatusChoices} />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("aligoPhone")}
                  label="연락처"
                  rules={[{ required: true, message: formRuleMsg.required }]}
                >
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("email")}
                  label="이메일"
                  rules={[{ type: "email", message: "올바른 이메일 형식이 아닙니다" }]}
                >
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("brandStoreContract")}
                  label="계약"
                  rules={[{ required: true }]}
                >
                  <Select options={brandStoreContractChoices} />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("bizRegNo")} label="사업자번호">
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("bizRegCorpName")} label="상호">
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("bizRegCeoName")} label="대표자명">
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("bizRegBizType")} label="업태">
                  <Input />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("bizRegBizClass")} label="종목">
                  <Input />
                </Form.Item>
              </Col>
            </Row>
            <Row gutter={[8, 0]}>
              <Col span={4}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("defaultShippingAddress.postalCode")}
                  label="주소"
                  rules={[{ required: true, message: formRuleMsg.required }]}
                >
                  <Input disabled placeholder={"우편번호"} />
                </Form.Item>
              </Col>
              <Col span={4}>
                <Form.Item className={getFormItemClassName(["ant-form-item-empty-label"])}>
                  <Button
                    onClick={() => {
                      setVisibleSearchAddressForm(true);
                    }}
                    style={{ width: "100%" }}
                  >
                    주소검색
                  </Button>
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  className={getFormItemClassName(["ant-form-item-empty-label"])}
                  name={TypeSafeForm.getValidDataIndex("defaultShippingAddress.streetAddress1")}
                  rules={[{ required: true, message: formRuleMsg.required }]}
                >
                  <Input disabled />
                </Form.Item>
              </Col>
              <Col span={8}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("defaultShippingAddress.streetAddress2")}
                  className={getFormItemClassName(["ant-form-item-empty-label"])}
                >
                  <Input placeholder={"상세주소"} />
                </Form.Item>
              </Col>
            </Row>
            <Row gutter={[8, 0]}>
              <Col span={12}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("hqStaffBrandStoreMain")}
                  label="주 담당자"
                  dependencies={[TypeSafeForm.getValidDataIndex("hqStaffBrandStoreSub")]}
                  rules={[
                    {
                      validator: (_, value) => {
                        const subValue = form.getFieldValue(TypeSafeForm.getValidDataIndex("hqStaffBrandStoreSub"));
                        if (value && subValue && value === subValue) {
                          return Promise.reject(new Error("주 담당자와 부 담당자는 서로 다르게 선택해야 합니다."));
                        }
                        return Promise.resolve();
                      },
                    },
                  ]}
                >
                  <Select
                    allowClear
                    showSearch
                    filterOption={(input, option) => option.label.toLowerCase().includes(input.toLowerCase())}
                    onSearch={searchHqStaffs}
                    loading={fetchMoreDataForHqStaffs.loading}
                    options={searchedHqStaffs}
                    onPopupScroll={fetchMoreDataForHqStaffs.onFetchMore}
                  />
                </Form.Item>
              </Col>

              <Col span={12}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("hqStaffBrandStoreSub")}
                  label="부 담당자"
                  dependencies={[TypeSafeForm.getValidDataIndex("hqStaffBrandStoreMain")]}
                  rules={[
                    {
                      validator: (_, value) => {
                        const mainValue = form.getFieldValue(TypeSafeForm.getValidDataIndex("hqStaffBrandStoreMain"));
                        if (value && mainValue && value === mainValue) {
                          return Promise.reject(new Error("주 담당자와 부 담당자는 서로 다르게 선택해야 합니다."));
                        }
                        return Promise.resolve();
                      },
                    },
                  ]}
                >
                  <Select
                    allowClear
                    showSearch
                    filterOption={(input, option) => option.label.toLowerCase().includes(input.toLowerCase())}
                    onSearch={searchHqStaffs}
                    loading={fetchMoreDataForHqStaffs.loading}
                    options={searchedHqStaffs}
                    onPopupScroll={fetchMoreDataForHqStaffs.onFetchMore}
                  />
                </Form.Item>
              </Col>
            </Row>
            {openConfirmModal && (
              <ConfirmModal visible={openConfirmModal} onOk={form.submit} onCancel={() => setOpenConfirmModal(false)} />
            )}
          </Form>
        </Collapse.Panel>
        <Collapse.Panel header="" key="true">
          <DaumPostcode onComplete={searchAddress} autoClose={false} submitMode={false} />
        </Collapse.Panel>
      </Collapse>
    </Modal>
  );
};

export default BrandStoreCreateModal;
</file>

<file path="src/app/views/brand/brandStore/components/BrandStoreCreditsTable.tsx">
import { MinusCircleOutlined, PlusCircleOutlined } from "@ant-design/icons";
import { paymentTerm } from "@assets/messages/commonMsg";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { PointsEventTypeEnum } from "@src/api/types/globalTypes";
import { getIconProps } from "@src/app/components/antd/Icon/IconProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { CreditsEventCreateModal } from "@src/app/views/customer/customers/components/CreditsEventCreateModal";
import { getCustomerPointsTableColumns } from "@src/app/views/customer/customers/components/CreditsEventTableSettings";
import { creditsEventListViewUrl } from "@src/app/views/customer/points/urls";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { getDisplayBrandStoreName } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Space, Table, Typography } from "antd";
import React, { useState } from "react";

import { BrandStoreDetails_brandStore } from "../api/types/BrandStoreDetails";

interface BrandStoreCreditsTableProps {
  brandStore: BrandStoreDetails_brandStore;
}

export const BrandStoreCreditsTable: React.FC<BrandStoreCreditsTableProps> = (props) => {
  const { brandStore } = props;
  const { user } = useUser();
  const isUserStaff = user?.isStaff;

  const ownerUser = brandStore?.ownerUser;
  const navigate = useNavigator();
  const [eventType, setEventType] = useState<PointsEventTypeEnum>(null);
  const cashableCredits = ownerUser?.cashableCredits || 0;
  const nonCashableCredits = ownerUser?.nonCashableCredits || 0;

  const columns = getCustomerPointsTableColumns(undefined, true);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const creditsEventList = ownerUser?.creditsEvents?.edges?.map((creditsEvent) => creditsEvent.node);

  return (
    <>
      <Card
        title={
          <Space>
            <Typography.Title level={4} type="success">
              {paymentTerm.credits} 이용 내역
            </Typography.Title>
            <Typography.Text strong style={{ fontSize: 13 }}>
              현금 출금 가능: {getNumberFormat(ownerUser.cashableCredits)} | 현금 출금 불가:{" "}
              {getNumberFormat(ownerUser.nonCashableCredits)}
            </Typography.Text>
          </Space>
        }
        extra={
          <Space size="small" align="center">
            {isUserStaff && (
              <>
                <Button
                  shape="circle"
                  type="text"
                  disabled={cashableCredits === 0 && nonCashableCredits === 0}
                  onClick={() => setEventType(PointsEventTypeEnum.DEDUCTION)}
                >
                  <MinusCircleOutlined {...getIconProps({ size: 22 })} />
                </Button>
                <Button shape="circle" type="text" onClick={() => setEventType(PointsEventTypeEnum.RECHARGE)}>
                  <PlusCircleOutlined {...getIconProps({ size: 22 })} />
                </Button>

                <Typography.Link
                  strong
                  onClick={() => navigate(creditsEventListViewUrl({ userSearch: ownerUser?.loginId }))}
                >
                  모든 이용 내역 보기
                </Typography.Link>
              </>
            )}
          </Space>
        }
        bodyStyle={{ padding: 0 }}
      >
        <TableVatLegend size="small" />
        <Table
          {...commonTableProps}
          loading={false}
          columns={columns}
          dataSource={creditsEventList}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
      <CreditsEventCreateModal
        open={eventType !== null}
        loading={false}
        eventType={eventType}
        customerName={getDisplayBrandStoreName(brandStore)}
        customer={ownerUser}
        onClose={() => setEventType(null)}
      />
    </>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BrandStoreManageEvent.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import { BrandStoreManageEventType, BrandStoreManageEventTypeEnum } from "@src/api/types/globalTypes";
import Hr from "@src/app/components/Hr";
import Timeline from "@src/app/components/Timeline/Timeline";
import TimelineAddNoteAntd from "@src/app/components/Timeline/TimelineAddAntD";
import TimelineNote from "@src/app/components/Timeline/TimelineNote";
import { utils } from "@utils/utils";
import { Button, Form, Typography } from "antd";
import React, { useState } from "react";

import { useBrandStoreManageEventCreateMutation } from "../api/mutations";
import { BrandStoreDetails_brandStore_manageEvents } from "../api/types/BrandStoreDetails";

interface ManageEventFormData {
  contents: string;
}

const getEventMessage = (event: BrandStoreDetails_brandStore_manageEvents) => {
  switch (event.type) {
    case BrandStoreManageEventType.CREATE:
      return event.contents;
    case BrandStoreManageEventType.BASIC_INFO_UPDATED:
      return "[기본 정보 변경]\n" + event.contents;
    case BrandStoreManageEventType.OPER_INFO_UPDATED:
      return "[운영 정보 변경]\n" + event.contents;
    case BrandStoreManageEventType.CONT_INFO_UPDATED:
      return "[계약 정보 변경]\n" + event.contents;
    default:
      return "[기타]\n" + event.contents;
  }
};

interface OrderHistoryProps {
  brandStoreId: string;
  events: BrandStoreDetails_brandStore_manageEvents[];
}

const BrandStoreManageEvent: React.FC<OrderHistoryProps> = (props) => {
  const [form] = Form.useForm();
  const [showAll, setShowAll] = useState(false);

  const { brandStoreId, events } = props;

  const sortedEvents = [...(events || [])].slice().reverse();
  const visibleEvents = showAll ? sortedEvents : sortedEvents.slice(0, 3);

  const [brandStoreManageEventCreate, brandStoreManageEventCreateOpts] = useBrandStoreManageEventCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandStoreManageEventCreate.errors, commonMsg.savedManagementEvent, () => {
        form.resetFields();
      }),
  });

  const handleFinish = (values: ManageEventFormData) => {
    brandStoreManageEventCreate({
      variables: {
        input: {
          brandStore: brandStoreId,
          contents: values.contents,
          type: BrandStoreManageEventTypeEnum.ETC,
        },
      },
    });
  };
  return (
    <>
      <Typography.Text style={{ fontSize: 20 }} type={"secondary"} strong>
        매장 관리 이력
      </Typography.Text>
      <Hr />
      <Timeline>
        <Form form={form} onFinish={handleFinish}>
          <Form.Item
            name="contents"
            rules={[{ required: true, message: "내용을 입력해주세요." }]}
            style={{ marginBottom: 0 }}
          >
            <TimelineAddNoteAntd
              value={form.getFieldValue("contents")}
              submitting={brandStoreManageEventCreateOpts.loading}
              onChange={(e) => form.setFieldsValue({ contents: e.target.value })}
              onSubmit={() => form.submit()}
            />
          </Form.Item>
        </Form>
        {visibleEvents.map((event) => (
          <TimelineNote key={event.id} date={event.date} user={event.writer} message={getEventMessage(event)} />
        ))}

        {events?.length > 3 && (
          <div style={{ textAlign: "center", marginTop: 16 }}>
            <Button type="link" onClick={() => setShowAll((prev) => !prev)}>
              {showAll ? "간략히 보기" : "이력 전체 보기"}
            </Button>
          </div>
        )}
      </Timeline>
    </>
  );
};
export default BrandStoreManageEvent;
</file>

