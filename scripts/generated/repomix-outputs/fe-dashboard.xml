  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    pageInfoPath: data?.holidays?.pageInfo,
    paginationState,
    params,
  });

  const [deleteHolidayInfo, deleteHolidayInfoOpts] = useHolidayInfoDelete({
    onCompleted: () => {
      showNotificationSuccess("선택한 휴일이 삭제되었습니다.");
    },
    refetchQueries: [holidayInfoListQuery],
  });

  return (
    <>
      <HolidayInfoListPage
        settings={settings}
        disabled={loading || deleteHolidayInfoOpts.loading}
        holidays={maybe(() => data.holidays.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onAdd={() => navigate(holidayInfoCreateViewUrl)}
        onBack={() => navigate(configurationSectionUrl)}
        onUpdateListSettings={updateListSettings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        userPermissions={user?.userPermissions || []}
        onDelete={(id) => {
          deleteHolidayInfo({ variables: { id } });
        }}
      />
    </>
  );
};
