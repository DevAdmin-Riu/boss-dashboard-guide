import {
  useCustomerQuestionStatusUpdateMutation,
  useFbvRefundQaApproveMutation,
  useFbvRefundQaRefuseMutation,
} from "../../api/mutations";
import { CustomerQuestionGetCountQuery, RefundQuestionListQuery } from "../../api/queries";
import {
  RefundQuestionList,
  RefundQuestionList_refundQuestions_edges_node,
  RefundQuestionListVariables,
} from "../../api/types/RefundQuestionList";
import { RefundQuestionListViewRouteParams } from "../../urls";
import CustomerRefundQuestionInspectTable from "../CustomerRefundQuestionInspectTable/CustomerRefundQuestionInspectTable";
import FbvAcceptModal from "../FbvAcceptModal/FbvAcceptModal";
import QuestionInspectStockAddTable from "../QuestionInspectStockAddTable/QuestionInspectStockAddTable";
import { createFilterStructure } from "../RefundQuestionListPage/filters";
import { RefundQuestionListPageProps } from "../RefundQuestionListPage/RefundQuestionListPage";
import { getQuestionAcceptedListTableColumns } from "./QuestionAcceptedTableSetting";
import { getQuestionAllListTableColumns } from "./QuestionAllTableSetting";
import { getQuestionChangePendingListTableColumns } from "./QuestionChangePendingTableSetting";
import { getQuestionChangeSuccessListTableColumns } from "./QuestionChangeSuccessTableSetting";
import { getQuestionRefundPendingListTableColumns } from "./QuestionRefundPendingTableSetting";
import { getQuestionRefundSuccessListTableColumns } from "./QuestionRefundSuccessTableSetting";
import { getQuestionRequestedListTableColumns } from "./QuestionRequestedTableSetting";
import { getQuestionStockIncludedApprovedTableColumns } from "./QuestionStockIncludedApprovedTableSetting";
import { createSorterStructure } from "./sorters";

interface RefundQuestionListTableProps extends RefundQuestionListPageProps, PaginateListProps {
  onRowRefundBtnClick: ({ id, refundId }) => void;
  customerQuestions: RefundQuestionList_refundQuestions_edges_node[];
  queryVariablesWithoutPagination: RefundQuestionListVariables;
  fetchForDownload: (variables?: RefundQuestionListVariables) => Promise<ApolloQueryResult<RefundQuestionList>>;
}

const RefundQuestionListTable: React.FC<RefundQuestionListTableProps> = (props) => {
  const {
    currencySymbol,
    currentTab,
    filterOpts,
    tabs,
    customerQuestions,
    onRowClick,
    onRowRefundBtnClick,
    fetchForDownload,
    queryVariablesWithoutPagination,
    sort,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    ...listProps
  } = props;
  const routeParams = useParams<RefundQuestionListViewRouteParams>();
  const { status, fulfilledBy } = routeParams;
  const isFbv = fulfilledBy === "vendor";
  const filterStructure = createFilterStructure(props.filterOpts, routeParams);
  const sorterStructure = createSorterStructure();
  const [questionCloseModal, setQuestionCloseModal] = useState<boolean>(false);
  const [fbvQuestionAcceptRecord, setFbvQuestionAcceptRecord] =
    useState<RefundQuestionList_refundQuestions_edges_node | null>(null);
  const [refundId, setRefundId] = useState<null | string>(null);
  const [helpTxt, setHelpTxt] = useState<null | string>(null);
  const [pendingStatusChange, setPendingStatusChange] = useState<RefundStatusTypeEnum | null>(null);
  // const xScrollWrapRef = useRef(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const { user } = useUser();
  const { isStaff } = user;

  const [onFbvRefundQaRefuse, onFbvRefundQaRefuseOpts] = useFbvRefundQaRefuseMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.fbvRefundQaRefuse.errors, "해당 환불 문의를 거부처리 하였습니다.", () => {
        setFbvQuestionAcceptRecord(null);
      }),
    refetchQueries: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
  });

  const [onFbvRefundQaApprove, onFbvRefundQaApproveOpts] = useFbvRefundQaApproveMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.fbvRefundQaApprove.errors, "해당 환불 문의를 승인처리 하였습니다.", () => {
        setFbvQuestionAcceptRecord(null);
      }),
    refetchQueries: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
  });

  // NOTE: 신청단계에서 접수 단계로 변경 START
  const [onCustomerQuestionStatusUpdate] = useCustomerQuestionStatusUpdateMutation({
    onCompleted: (data) => {
      const errors = data.customerQuestionStatusUpdate.bbsErrors;
      if (errors.length > 0) {
        setPendingStatusChange(null);
      }

      // 상태 변경에 따른 적절한 메시지 표시
      let successMessage = "해당 문의 건을 접수처리 하였습니다.";
      if (pendingStatusChange === RefundStatusTypeEnum.QUESTION_CLOSE) {
        successMessage = "해당 문의 건을 처리 완료 하였습니다.";
      } else if (pendingStatusChange === RefundStatusTypeEnum.CHANGE_SUCCESS) {
        successMessage = "해당 문의 건을 교환 완료 처리 하였습니다.";
      } else if (pendingStatusChange === RefundStatusTypeEnum.STOCK_INCLUDED_REQUESTED) {
        successMessage = "해당 문의 건을 재고 포함 요청 처리 하였습니다.";
      }
      utils.handleOnCompletedWithError(errors, successMessage, () => {
        setQuestionCloseModal(false);
        setPendingStatusChange(null);
      });
    },
    refetchQueries: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
  });

  const questionStatusUpdate = (id, changeStatus) => {
    setPendingStatusChange(changeStatus);
    onCustomerQuestionStatusUpdate({
      variables: {
        id,
        input: {
          status: changeStatus,
        },
      },
    });
  };
  // NOTE: 신청단계에서 접수 단계로 변경 END
  /**
   * @param e - mouseEvent
   * @param changeStatus - 현재 상태에서 변경해야 할 상태 값 RefundStatusTypeEnum 값이어야 한다.
   */
  const questionStatusUpdateOnClick = (e, changeStatus) => {
    const target = e.currentTarget;
    const id = target.dataset.id;

    questionStatusUpdate(id, changeStatus);
  };

  // NOTE: 환불 완료 단계에서 처리 완료 단계 Modal Close
  const questionStatusQuestionCloseModalOpenOnClick = (e) => {
    const target = e.currentTarget;
    const id = target.dataset.id;

    setRefundId(id);
    setQuestionCloseModal(true);
  };
  const questionStatusQuestionCloseModalCloseOnClick = () => {
    setRefundId(null);
    setQuestionCloseModal(false);
  };
  const questionStatusQuestionCloseChangeOnClick = () => {
    if (refundId == null) {
      showNotificationError("잘못된 접근입니다. 새로고침 후 다시 진행해주시기 바랍니다.");
      return;
    }
    questionStatusUpdate(refundId, RefundStatusTypeEnum.QUESTION_CLOSE);
  };

  let columns: ColumnsType<RefundQuestionList_refundQuestions_edges_node> = null;
  switch (status) {
    // NOTE: 신청 단계 컬럼
    case "requested":
      columns = getQuestionRequestedListTableColumns({
        questionAcceptedUpdate: (e) => {
          questionStatusUpdateOnClick(e, RefundStatusTypeEnum.ACCEPTED);
        },
        onRowClick,
        isFbv,
      });
      break;

    // NOTE: 접수 단계 컬럼
    case "accepted":
      columns = getQuestionAcceptedListTableColumns({
        onRowClick,
        questionQuestionCloseUpdate: (e) => {
          questionStatusQuestionCloseModalOpenOnClick(e);
          setHelpTxt(`해당 건은 "접수" 상태의 건 입니다. "처리 완료"로 상태를 변경하시는게 확실하십니까 ?`);
        },
        fbvQuestionAcceptedModal: (record: RefundQuestionList_refundQuestions_edges_node) => {
          setFbvQuestionAcceptRecord(record);
        },
        isFbv,
        isStaff,
      });
      break;

    // NOTE: 환불 대기 단계 컬럼
    case "refund-pending":
      columns = getQuestionRefundPendingListTableColumns({
        onRowRefundBtnClick,
        onRowClick,
        questionQuestionCloseUpdate: (e) => {
          questionStatusQuestionCloseModalOpenOnClick(e);
          setHelpTxt(`해당 건은 "환불 대기" 상태의 건 입니다. "처리 완료"로 상태를 변경하시는게 확실하십니까 ?`);
        },
      });
      break;

    // NOTE: 환불 완료 단계 컬럼
    case "refund-success":
      columns = getQuestionRefundSuccessListTableColumns({
        questionStockIncludedRequestedUpdate: (e) => {
          questionStatusUpdateOnClick(e, RefundStatusTypeEnum.STOCK_INCLUDED_REQUESTED);
        },
        questionQuestionCloseUpdate: (e) => {
          questionStatusQuestionCloseModalOpenOnClick(e);
          setHelpTxt(
            `해당 건은 상품을 회수하지 아니하고, 환불이 완료됐을 때 재고를 포함하지 않아도 되는 상태이어야 합니다. 이 부분에 대해서 확인 되셨으면 진행해 주십시오.`
          );
        },
        onRowClick,
        isFbv,
      });

      break;

    // NOTE: 반려 단계 컬럼
    case "reject":
      columns = getQuestionStockIncludedApprovedTableColumns({
        questionStockIncludedRequestedUpdate: (e) => {
          questionStatusUpdateOnClick(e, RefundStatusTypeEnum.QUESTION_CLOSE);
        },
        questionQuestionCloseUpdate: (e) => {
          questionStatusQuestionCloseModalOpenOnClick(e);
          setHelpTxt(`해당 문의건은 반려건으로 처리 완료 상태로 변경해주셔야 합니다.`);
        },
        onRowClick,
        isFbv,
      });
      break;

    // NOTE: 교환 대기 단계 컬럼
    case "change-pending":
      columns = getQuestionChangePendingListTableColumns({
        questionChangeSuccessUpdate: (e) => {
          questionStatusUpdateOnClick(e, RefundStatusTypeEnum.CHANGE_SUCCESS);
        },
        onRowClick,
      });
      break;

    // NOTE: 교환 대기 단계 컬럼
    case "change-success":
      columns = getQuestionChangeSuccessListTableColumns({
        questionQuestionCloseUpdate: (e) => {
          questionStatusQuestionCloseModalOpenOnClick(e);
          setHelpTxt(`교환이 다 이루어 졌다면, 처리 완료 상태로 변경해주시기 바랍니다.`);
        },
        onRowClick,
      });
      break;
    // NOTE: 전체보기 컬럼
    default:
      columns = getQuestionAllListTableColumns({
        onRowClick,
        isFbv,
      });
      break;
  }
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);

  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "refundQuestions",
  };

  return (
    <>
      <SpreadFilterBar
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterStructure={filterStructure}
        tabs={tabs}
        onAll={onAll}
        onFilterChange={onFilterChange}
        onTabChange={onTabChange}
        onTabDelete={onTabDelete}
        onTabSave={onTabSave}
        tabExtra={
          <>
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
            <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
          </>
        }
        isDownloadable={true}
        excelDownloadProps={excelDownloadProps}
      />
      {status === "stock-included-requested" ? (
        <QuestionInspectStockAddTable
          {...props}
          questionStatusUpdate={questionStatusUpdate}
          questionQuestionCloseUpdate={(e) => {
            questionStatusQuestionCloseModalOpenOnClick(e);
            setHelpTxt(
              `해당 건은 "재고 재포함 요청" 상태의 건 입니다. "처리 완료"로 상태를 변경하시는게 확실하십니까 ?`
            );
          }}
        />
      ) : status === "collected-inspect" ? (
        <CustomerRefundQuestionInspectTable {...props} />
      ) : (
        <>
          {columns === null ? (
            <></>
          ) : (
            <>
              <Table
                {...commonTableProps}
                ref={tableRef}
                className="fixedTable"
                loading={listProps.disabled}
                dataSource={customerQuestions}
                columns={pickerSelectedColumns}
                scroll={{ x: tableWidthSum, y: tableScrollY }}
                sticky={{}}
                footer={() => <TableListFooter {...listProps} />}
              />
            </>
          )}
        </>
      )}
      <ConfirmModal
        visible={questionCloseModal}
        modalTitleText={`문의 처리 완료 확인`}
        titleText={`정말로 문의 처리를 완료 하시겠습니까 ?`}
        helpText={helpTxt}
        onOk={() => questionStatusQuestionCloseChangeOnClick()}
        onCancel={questionStatusQuestionCloseModalCloseOnClick}
      />
      <FbvAcceptModal
        record={fbvQuestionAcceptRecord}
        open={fbvQuestionAcceptRecord !== null}
        onClose={() => setFbvQuestionAcceptRecord(null)}
        loading={onFbvRefundQaRefuseOpts.loading || onFbvRefundQaApproveOpts.loading}
        onRefuse={(record: RefundQuestionList_refundQuestions_edges_node, reason: string) => {
          onFbvRefundQaRefuse({
            variables: {
              id: record.id,
              input: {
                aRefuseReason: reason,
              },
            },
          });
        }}
        onSubmit={(record?: RefundQuestionList_refundQuestions_edges_node) => {
          onFbvRefundQaApprove({
            variables: {
              input: {
                orderId: record.order.id,
                refundQaId: record.id,
                orderRefundInput: {
                  requestOriginType: RequestOriginTypeEnum.DASHBOARD,
                  refundLines: JSON.parse(record.qOrderLineInfo)
                    .filter((line) => Number(line.quantity) !== 0)
                    .map((line) => ({
                      orderLineId: line.order_line_id,
                      qty: line.quantity,
                      returnDeliveryFee: 0,
                    })),
                  amount: 0,
                  cashableCredits: 0,
                  nonCashableCredits: 0,
                  rcoins: 0,
                },
              },
            },
          });
        }}
      />
    </>
  );
};

export default RefundQuestionListTable;
</file>

