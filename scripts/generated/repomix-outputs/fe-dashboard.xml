import { ChangeEvent } from "@hooks/useForm";
import { StrictOmit } from "@src/global/core/types/types";
import { updateAtIndex } from "@utils/lists";
import React from "react";

import ProductInfoNotiCard, { ProductInfoNotiCardProps } from "./ProductInfoNotiCard";
import { EventDataField, TProductInfoNotiData } from "./types";
import { parseEventData } from "./utils";

export interface ProductInfoNotiProps extends StrictOmit<ProductInfoNotiCardProps, "data"> {
  data: Record<"productInfoNotification", TProductInfoNotiData[]>;
}
const ProductInfoNoti: React.FC<ProductInfoNotiProps> = ({ data, onChange, openTemplatesModal }) => {
  const change = (event: ChangeEvent) => {
    const { field, fieldIndex, value } = parseEventData(event);
    const key = "productInfoNotification";
    const dataToUpdateBefore = data[key];

    const dataToUpdateAfter = updateAtIndex(
      {
        ...dataToUpdateBefore[fieldIndex],
        value: field === EventDataField.value ? value : dataToUpdateBefore[fieldIndex].value,
      },
      dataToUpdateBefore,
      fieldIndex
    );

    onChange({
      target: {
        name: key,
        value: dataToUpdateAfter,
      },
    });
  };

  return (
    <>
      <ProductInfoNotiCard
        data={data?.productInfoNotification}
        onChange={(event) => change(event)}
        openTemplatesModal={openTemplatesModal}
      />
    </>
  );
};

export default ProductInfoNoti;
</file>

