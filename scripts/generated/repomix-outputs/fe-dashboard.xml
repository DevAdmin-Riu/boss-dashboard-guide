import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { HqStaffRoleEnum } from "@src/api/types/globalTypes";
import Loader from "@src/app/components/Loader";
import { getDateRangeByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { useBsOpsCheckTemplateReportsSummaryQuery } from "@src/app/views/brand/brandStore/api/queries";
import { BsOpsCheckTemplateReportsSummaryVariables } from "@src/app/views/brand/brandStore/api/types/BsOpsCheckTemplateReportsSummary";
import { BsOpsCheckTemplateReportsSummary } from "@src/app/views/brand/brandStore/components/BsOpsCheckTemplateReportsSummary";
import { brandStoreRequestToHqListViewUrl, hqToUserNoticeListViewUrl } from "@src/app/views/notice/notices/urls";
import { getDefaultGteLteVariablesForMonth } from "@utils/filters";
import { maybe } from "@utils/misc";
import { Card, Col, List, PageHeader, Row, Typography } from "antd";
import React, { useMemo } from "react";

import { useBsRequestToHqForHqDashboardListQuery, useFromHqNoticeForHqDashboardListQuery } from "../api/queries";
import { BsRequestToHqForHqDashboardListVariables } from "../api/types/BsRequestToHqForHqDashboardList";
import { FromHqNoticeForHqDashboardListVariables } from "../api/types/FromHqNoticeForHqDashboardList";
import { BsRequestToHqCard } from "../components/BsRequestToHqCard";
import { FromHqNoticeCard } from "../components/FromHqNoticeCard";

export const HqLinkersHomeView = () => {
  const navigate = useNavigator();
  const { user } = useUser();
  const { brand, hqStaffRole, hqStaffBrandStores } = user;

  const queryVariablesForNotice = useMemo<FromHqNoticeForHqDashboardListVariables>(
    () => ({ first: 3, id: brand.id }),
    [brand]
  );
  const { data: noticeListData, loading: noticeListLoading } = useFromHqNoticeForHqDashboardListQuery({
    variables: queryVariablesForNotice,
  });
  const noticeList = maybe(() => noticeListData.fromHqNotices.edges.map((edge) => edge.node), []);

  const queryVariablesForRequest = useMemo<BsRequestToHqForHqDashboardListVariables>(
    () => ({
      first: 3,
      filter: {
        brandStoreIds:
          hqStaffRole === HqStaffRoleEnum.SUPERVISOR ? hqStaffBrandStores.map((item) => item.brandStore.id) : undefined,
      },
    }),
    [hqStaffRole]
  );
  const { data: requestListData, loading: requestListLoading } = useBsRequestToHqForHqDashboardListQuery({
    variables: queryVariablesForRequest,
  });
  const requestList = maybe(() => requestListData.brandStoreRequestToHqList.edges.map((edge) => edge.node), []);

  const queryVariablesForSummary = useMemo<BsOpsCheckTemplateReportsSummaryVariables>(
    () => ({ dateRange: getDefaultGteLteVariablesForMonth() }),
    []
  );
  const { data: summaryData, loading: summaryLoading } = useBsOpsCheckTemplateReportsSummaryQuery({
    variables: queryVariablesForSummary,
  });
  const summary = maybe(() => summaryData.bsOpsCheckTemplateReportsSummary, null);
  const summaryDateRangeText = `(${getDateRangeByFormat(
    [queryVariablesForSummary.dateRange.gte, queryVariablesForSummary.dateRange.lte],
    onlyDateFormat
  )})`;

  const queryLoading = noticeListLoading || requestListLoading || summaryLoading;
  const getListItemStyle = (idx: number): React.CSSProperties => ({ marginTop: idx === 0 ? undefined : 12 });

  const sectionWithTitleWrapper = (props: { title: string; subTitle?: string; node: React.ReactNode }) => {
    const { title, subTitle, node } = props;
    return (
      <>
        <PageHeader title={<Typography.Title level={4}>{title}</Typography.Title>} subTitle={subTitle} />
        <br />
        {node}
      </>
    );
  };

  const makeViewListHeader = (url: string) => (
    <Row justify="end">
      <Typography.Link strong onClick={() => navigate(url)}>
        전체 보기
      </Typography.Link>
    </Row>
  );

  if (queryLoading) {
    return <Loader />;
  }
  return (
    <Row gutter={[24, 24]}>
      <Col xs={24} sm={12}>
        {sectionWithTitleWrapper({
          title: "본부 공지사항",
          node: (
            <Card size="small" bodyStyle={{ paddingTop: 0 }}>
              <List
                itemLayout="vertical"
                rowKey="id"
                split={false}
                dataSource={noticeList}
                header={makeViewListHeader(hqToUserNoticeListViewUrl(brand.id))}
                renderItem={(notice, idx) => <FromHqNoticeCard style={getListItemStyle(idx)} notice={notice} />}
                locale={{ emptyText: "등록된 공지사항이 없습니다." }}
              />
            </Card>
          ),
        })}
      </Col>
      <Col xs={24} sm={12}>
        {sectionWithTitleWrapper({
          title: "매장 요청",
          node: (
            <Card size="small" bodyStyle={{ paddingTop: 0 }}>
              <List
                itemLayout="vertical"
                rowKey="id"
                split={false}
                dataSource={requestList}
                header={makeViewListHeader(brandStoreRequestToHqListViewUrl())}
                renderItem={(request, idx) => <BsRequestToHqCard style={getListItemStyle(idx)} request={request} />}
                locale={{ emptyText: "담당 매장으로부터 등록된 요청이 없습니다." }}
              />
            </Card>
          ),
        })}
      </Col>
      <Col span={24}>
        {sectionWithTitleWrapper({
          title: "점검 현황",
          subTitle: summaryDateRangeText,
          node: <BsOpsCheckTemplateReportsSummary summary={summary} />,
        })}
      </Col>
    </Row>
  );
};
</file>

