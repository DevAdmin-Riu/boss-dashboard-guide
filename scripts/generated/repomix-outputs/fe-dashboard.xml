<file path="src/app/components/PopupNoticeModal/PopupNoticeModal.tsx">
import useNavigator from "@hooks/useNavigator";
import { User_switchedBrand_hqPopups } from "@src/api/fragments/types/User";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { IRootState } from "@src/global/redux/config/configStore";
import { IPopupNoticeCheck } from "@src/global/redux/reducer/popup.reducer";
import { popupNoticeCheckUpdate } from "@src/global/redux/store/popup.store";
import { utils } from "@utils/utils";
import { Button, Image, Modal } from "antd";
import moment from "moment";
import React, { useEffect, useState } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useLocation } from "react-router";

interface PopupNoticeProps {
  popupList: User_switchedBrand_hqPopups[];
  switchedBrandId: string;
}

export const PopupNoticeModal: React.FC<PopupNoticeProps> = (props) => {
  const { popupList, switchedBrandId } = props;
  const navigate = useNavigator();
  const dispatch = useDispatch();
  const location = useLocation();
  const [modalOpen, setModalOpen] = useState<boolean>(false);
  const [filteredPopupNotices, setFilteredPopupNotices] = useState<User_switchedBrand_hqPopups[]>([]);
  const [currentPopupNotice, setCurrentPopupNotice] = useState<User_switchedBrand_hqPopups>(null);
  const alreadyCheckedPopupNotices = useSelector<IRootState>(
    (state) => state.popup.popupNoticeCheck
  ) as IPopupNoticeCheck[];

  const handleOnPopupClick = (url: string) =>
    !url || url === "" ? null : url.startsWith("http") ? window.open(url, "_blank") : navigate(url);

  const isMobile = utils.checkMobile();

  useEffect(() => {
    if (popupList) {
      const temp: User_switchedBrand_hqPopups[] = [];

      popupList.forEach((popup) => {
        const checkedPopup = alreadyCheckedPopupNotices.find((checkedPopup) => checkedPopup.id === popup.id);
        if (!checkedPopup) {
          temp.push(popup);
          return;
        } else {
          const now = moment();
          //  날짜차이가 threshold보다 같거나 큰경우 보여준다.
          if (now.diff(moment(checkedPopup.lastCheckedDay), "days") >= 1) {
            temp.push(popup);
          } else {
            return;
          }
        }
      });

      if (temp.length > 0) {
        setFilteredPopupNotices(temp);
        setCurrentPopupNotice(temp[0]);
      } else {
        setCurrentPopupNotice(null);
        setFilteredPopupNotices([]);
      }
      setModalOpen(true);
    } else {
      setModalOpen(false);
    }
  }, [switchedBrandId, location.pathname]);

  //   팝업 정보가 없을 경우 Return null
  if (!popupList || popupList.length === 0) {
    return null;
  }

  const handleCloseCurrentNotice = () => {
    const currIdx = filteredPopupNotices.findIndex((popup) => popup.id === currentPopupNotice.id);
    if (currIdx === filteredPopupNotices.length - 1) {
      setModalOpen(false);
      setCurrentPopupNotice(null);
    } else {
      setCurrentPopupNotice(filteredPopupNotices[currIdx + 1]);
    }
  };

  const handleCurrentOneWeek = () => {
    const currentPopupId = currentPopupNotice.id;
    const today = moment().format(onlyDateFormat);
    const popupNoticeCheck: IPopupNoticeCheck = {
      id: currentPopupId,
      lastCheckedDay: today,
    };
    dispatch(popupNoticeCheckUpdate(popupNoticeCheck));
    handleCloseCurrentNotice();
  };

  return (
    <>
      {currentPopupNotice && (
        <Modal
          centered
          destroyOnClose
          closable={false}
          title={"중요 알림"}
          open={modalOpen}
          footer={[
            <Button key="submit" onClick={handleCurrentOneWeek}>
              하루동안 보지 않기
            </Button>,
            <Button key="back" onClick={handleCloseCurrentNotice}>
              닫기
            </Button>,
            <Button
              key="link"
              type="primary"
              onClick={() => {
                handleOnPopupClick(currentPopupNotice.linkUrl);
              }}
            >
              공지사항 이동
            </Button>,
          ]}
        >
          <Image
            preview={false}
            style={{ width: "100%" }}
            width={"100%"}
            src={isMobile ? currentPopupNotice.mobileImage?.url : currentPopupNotice.pcImage?.url}
            alt={isMobile ? currentPopupNotice.mobileImage?.alt : currentPopupNotice.pcImage?.alt}
          />
        </Modal>
      )}
    </>
  );
};
</file>

