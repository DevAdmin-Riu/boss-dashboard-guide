export enum AttributeSlugEnum {
  capacity = "capacity",
  pricePerUnit = "pricePerUnit",
  quantity = "quantity",
  size = "size",
  weight = "weight",
  material = "material",
  color = "color",
  boxSize = "boxSize",
  print = "print",
}

// NOTE: DB 저장 시점의 속성 정보를 JSON 타입으로 변환하여 저장된 데이터를 위한 타입 정의
export interface SimpleAttribute {
  size?: string;
  weight?: string;
  capacity?: string;
  material?: string;
  color?: string;
  quantity?: string;
  unitType?: string;
  purchaseUnit?: string;
  maker?: string;
}

export const getAttrAndValuesBySlug = (
  attributes:
    | ProductList_products_edges_node_attributes[]
    | OrderDetails_order_fulfillments_lines_orderLine_variant_product_attributes[]
    | ProductVariantListToAdd_productVariants_edges_node_attributes[]
    | BpBundle_bpBundle_bpBundleInfos_pv_attributes[],
  slug: AttributeSlugEnum
) => {
  const attr = attributes?.find((attr) => attr?.attribute?.slug === slug);
  if (!attributes || utils.isEmpty(attr)) {
    return { attr: null, attrValues: [] };
  }
  const attrValues = [];
  attr.values.forEach((val) => {
    if (utils.isEmpty(val?.name, true) === false) {
      attrValues.push(val.name);
    }
  });
  return { attr, attrValues };
};

// NOTE: 매입 관련 상품 규격 정보 텍스트 생성 함수
export const makeProductSpecText = (
  sizeValues: string | string[],
  weightValues: string | string[],
  capacityValues: string | string[],
  materialValues: string | string[],
  colorValues: string | string[],
  variantName?: string
) => {
  const specValuesArr = [];

  if (utils.isEmpty(sizeValues, true) === false) {
    specValuesArr.push(sizeValues);
  } else if (utils.isEmpty(weightValues, true) === false) {
    specValuesArr.push(weightValues);
  } else if (utils.isEmpty(capacityValues, true) === false) {
    specValuesArr.push(capacityValues);
  }

  if (utils.isEmpty(materialValues, true) === false) {
    specValuesArr.push(materialValues);
  }
  if (utils.isEmpty(colorValues, true) === false) {
    specValuesArr.push(colorValues);
  }

  const specStr = specValuesArr.join("; ");
  if (utils.isEmpty(variantName, true) === false) {
    return `${variantName}; ${specStr}`;
  }
  return specStr;
};

// DB에 저장된 attributeData 정보로부터 '규격' 정보 텍스트 생성
export const makeProductSpecTextFromSimpleAttribute = (simpleAttribute: SimpleAttribute): string => {
  if (!simpleAttribute) {
    return "-";
  }
  const specText = makeProductSpecText(
    simpleAttribute?.size,
    simpleAttribute?.weight,
    simpleAttribute?.capacity,
    simpleAttribute?.material,
    simpleAttribute?.color
  );
  if (utils.isEmpty(specText, true)) {
    return "-";
  }
  return specText;
};

// SimpleAttribute의 타입 정의
export type SimpleAttributeKey = keyof Pick<SimpleAttribute, "size" | "weight" | "capacity" | "material" | "color">;

// SimpleAttribute에서 특정 속성 하나만 가져오는 함수
export const getSpecificAttributeFromSimpleAttribute = (
  simpleAttribute: SimpleAttribute,
  attributeKey: SimpleAttributeKey
): string => {
  if (!simpleAttribute) {
    return "-";
  }

  const value = simpleAttribute[attributeKey];

  if (utils.isEmpty(value, true)) {
    return "-";
  }

  return value;
};

// DB에 저장된 attributeData 정보로부터 '입수량' 정보 텍스트 생성
export const makeProductQtyPerBoxTextFromSimpleAttribute = (
  simpleAttribute: SimpleAttribute,
  qtyPerBoxUnitType: QtyPerBoxUnitTypeEnum
): string => {
  if (!simpleAttribute) {
    return "-";
  }
  if (utils.isEmpty(simpleAttribute?.quantity)) {
    return "-";
  }
  const attrQty = utils.convertToNumberWrapper(simpleAttribute?.quantity);
  return attrQty?.toLocaleString() + getQtyPerBoxUnitTypeText(qtyPerBoxUnitType);
};

// DB에 저장된 attributeData 정보로부터 '입수량' 값 구하기
export const getProductAttrQtyFromSimpleAttribute = (simpleAttribute: SimpleAttribute): number => {
  if (!simpleAttribute) {
    return 1;
  }
  if (utils.isEmpty(simpleAttribute?.quantity)) {
    return 1;
  }
  return Math.max(1, utils.convertToNumberWrapper(simpleAttribute?.quantity));
};

// 현재 제품의 속성 정보를 이용하여 '규격' 정보 텍스트 생성
export const makeProductSpecTextFromAttr = (
  attributes: ProductList_products_edges_node_attributes[] | BpBundle_bpBundle_bpBundleInfos_pv_attributes[],
  variantName?: string
): string => {
  if (!attributes) {
    return null;
  }

  const { attrValues: sizeAttrValues } = getAttrAndValuesBySlug(attributes, AttributeSlugEnum.size);
  const { attrValues: weightAttrValues } = getAttrAndValuesBySlug(attributes, AttributeSlugEnum.weight);
  const { attrValues: capacityAttrValues } = getAttrAndValuesBySlug(attributes, AttributeSlugEnum.capacity);
  const { attrValues: materialAttrValues } = getAttrAndValuesBySlug(attributes, AttributeSlugEnum.material);
  const { attrValues: colorAttrValues } = getAttrAndValuesBySlug(attributes, AttributeSlugEnum.color);

  const specText = makeProductSpecText(
    sizeAttrValues,
    weightAttrValues,
    capacityAttrValues,
    materialAttrValues,
    colorAttrValues,
    variantName
  );

  return specText;
};

// 현재 제품의 '입수량' 정보 텍스트 생성 - 입수량이 attributes가 아닌 variant의 정보로 변경되며, attributes가 입력되면 단위까지 함께 표시하는 것으로 변경
export const makeProductQtyPerBoxText = (
  productVariant: Pick<SearchProducts_search_edges_node_variants, "qtyPerBox" | "qtyPerBoxUnitType">
): string => {
  if (!productVariant) {
    return null;
  }

  let qtyPerBoxText = "";
  if (utils.isEmpty(productVariant?.qtyPerBox) === false) {
    qtyPerBoxText += productVariant.qtyPerBox.toLocaleString();

    if (utils.isEmpty(productVariant?.qtyPerBoxUnitType) === false) {
      const qtyPerBoxUnitTypeText = getQtyPerBoxUnitTypeText(productVariant.qtyPerBoxUnitType);
      qtyPerBoxText += " " + qtyPerBoxUnitTypeText;
    }
  }

  return qtyPerBoxText;
};

export const productBoxSpecUnitType = "mm";
export const convertBoxSpecText = (boxSpecValues: number[], includeUnit: boolean = false): string => {
  if (utils.isEmpty(boxSpecValues)) {
    return "-";
  }
  if (boxSpecValues.every((value) => value === 0)) {
    return "-";
  }
  if (includeUnit) {
    return boxSpecValues.join("x") + `(${productBoxSpecUnitType})`;
  }
  return boxSpecValues.join("x");
};

export const convertPalletText = (palletValues: number[]): string => {
  if (utils.isEmpty(palletValues)) {
    return "-";
  }
  if (palletValues.every((value) => value === 0)) {
    return "-";
  }
  return palletValues[0] + "열 x " + palletValues[1] + "단 + " + palletValues[2];
};

export const parseBoxSpecText = (boxSpecText: string): number[] => {
  if (utils.isEmpty(boxSpecText)) {
    return [0, 0, 0];
  }
  const boxSpecValues = boxSpecText.split("x").map((value) => utils.convertToNumberWrapper(value));
  return boxSpecValues;
};

// 현재 제품의 '박스 규격' 정보 텍스트 생성
export const makeProductBoxSpecText = (
  productVariant: Pick<SearchProducts_search_edges_node_variants, "boxLength" | "boxWidth" | "boxHeight">,
  includeUnitType: boolean = false
): string => {
  if (!productVariant) {
    return null;
  }
  const boxSpecValues = [productVariant.boxLength, productVariant.boxWidth, productVariant.boxHeight];
  const boxSpecText = convertBoxSpecText(boxSpecValues, includeUnitType);

  return boxSpecText;
};

