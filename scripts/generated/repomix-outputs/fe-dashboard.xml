<file path="src/app/views/hqStaff/hqSection/utils/orderDetailChartConfig.ts">
import { Datum } from "@ant-design/charts";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { getChartTickConfig, makeChartTickFormat, statsDateType, statsValueType } from "@utils/chart";
import { transformIsFBVForHq } from "@utils/misc";
import moment, { Moment } from "moment";

const makeOrderStatsDetailData = (
  selectedDuration: Moment[],
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[],
  dateType: statsDateType,
  valueTypes: statsValueType[]
) => {
  const dateMoment = moment(selectedDuration[0]);
  const durationDiff =
    (dateType === statsDateType.DAILY
      ? selectedDuration[1].diff(selectedDuration[0], "days")
      : dateType === statsDateType.WEEKLY
      ? selectedDuration[1].diff(selectedDuration[0], "weeks")
      : selectedDuration[1].diff(selectedDuration[0], "months")) + 1;
  const data = [];

  for (let i = 0; i < durationDiff; i++) {
    for (const valueType of valueTypes) {
      const date = dateMoment.format(onlyDateFormat);
      const dataElement = {
        date:
          dateType === statsDateType.MONTHLY
            ? dateMoment.format(onlyMonthFormat)
            : dateType === statsDateType.WEEKLY
            ? [
                date,
                moment().isBefore(moment(date).add("6", "d"))
                  ? moment().format(onlyDateFormat)
                  : moment(date).add("6", "d").format(onlyDateFormat),
              ].join("\n~ ")
            : date,
        value: 0,
        category:
          valueType === statsValueType.TOTAL_PRICE
            ? "총 주문 금액"
            : valueType === statsValueType.MILEAGE
            ? "예상 본부수익금"
            : valueType === statsValueType.BRAND_COST_PRICE_ONLY_FBV
            ? `${transformIsFBVForHq(true)} 상품 매입금`
            : null,
      };
      const statsElement = parsedBrandOrderStats.find((stats) => stats.statDate === date);
      if (statsElement) {
        switch (valueType) {
          case statsValueType.TOTAL_PRICE:
            dataElement.value = statsElement.statTotalPriceExcludeVat;
            break;
          case statsValueType.MILEAGE:
            dataElement.value = statsElement.statMileageExcludeVat;
            break;
          case statsValueType.BRAND_COST_PRICE_ONLY_FBV:
            dataElement.value = statsElement.statBrandCostPriceExcludeVatOnlyFbv;
            break;
        }
      }
      data.push(dataElement);
    }
    switch (dateType) {
      case statsDateType.DAILY:
        dateMoment.add(1, "d");
        break;
      case statsDateType.WEEKLY:
        dateMoment.add(1, "w");
        break;
      case statsDateType.MONTHLY:
        dateMoment.add(1, "M");
        break;
    }
  }

  return data;
};

export const makeOrderStatsDetailChartConfig = (
  selectedDuration: any[],
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[],
  dateType: statsDateType,
  valueTypes: statsValueType[]
) => {
  // https://charts.ant.design/en/docs/api/common-graph/common-graph
  // https://g2plot.antv.vision/en/docs/api/components/axis#maxlimit

  const chartTickConfig = getChartTickConfig(parsedBrandOrderStats, statsValueType.TOTAL_PRICE);
  const minLimit = chartTickConfig[0];
  const maxLimit = chartTickConfig[1];
  const tickCount = chartTickConfig[2];

  const COLOR_PLATE_10 = [
    "#0E9CFF",
    "#5AD8A6",
    "#5D7092",
    "#F6BD16",
    "#E8684A",
    "#6DC8EC",
    "#9270CA",
    "#FF9D4D",
    "#269A99",
    "#FF99C3",
  ];

  const config = {
    height: 300,
    yAxis: {
      minLimit,
      maxLimit,
      tickCount,
      label: {
        formatter: (v: string) => makeChartTickFormat(v),
      },
    },
    xAxis: {
      range: [0, 1],
    },
    data: makeOrderStatsDetailData(selectedDuration, parsedBrandOrderStats, dateType, valueTypes),
    xField: "date",
    yField: "value",
    seriesField: "category",
    label: {
      formatter: (datum: Datum) => datum.value.toLocaleString(),
    },
    color: COLOR_PLATE_10,
    point: {
      size: 4,
      shape: "circle",
      style: {
        fill: "white",
        fillOpacity: 0.5,
        stroke: "#0E9CFF",
        lineWidth: 2,
      },
    },
    tooltip: {
      showMarkers: false,
      formatter: (datum: Datum) => ({
        name: datum.category,
        value: datum.value.toLocaleString(),
      }),
    },
    state: {
      active: {
        style: {
          shadowBlur: 4,
          stroke: "#000",
          fill: "red",
        },
      },
    },
    interactions: [
      {
        type: "marker-active",
      },
    ],
  };
  return config;
};
