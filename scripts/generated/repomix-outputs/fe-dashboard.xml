}

const CreateAdminOrderProductListModal: React.FC<CreateAdminOrderProductListModalProps> = (props) => {
  const {
    open,
    onCancel,
    customerUserWatched,
    form,
    isHqStaff,
    isByStaffForBrand,
    isByStaffForB2b,
    isByHqStaffForBrand,
    createFormLinesWatched,
    isResetProductList,
    setIsResetProductList,
  } = props;
  // 상품 검색후 저장을 위한 용도
  const [productVariantList, setProductVariantList] = React.useState<CreateAdminProductVariantEdgesNode[]>([]);
  // 패키지 상품 검색후 저장을 위한 용도
  const [packageList, setPackageList] = React.useState<BrandProductPackages_brandProductPackages_edges_node[]>([]);

  const useBpvMode = isByStaffForB2b || isByStaffForBrand || isByHqStaffForBrand;

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const brandProductVariantListQueryVariables: CreateAdminAtBrandProductListWithOnlyNonStoppedVariantsVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    first: 500,
    filter: {},
  };

  // TODO@도현: brandProductVariantList 쿼리로 변경 - 옵션형 제품코드로 검색 시 같은 bp 가 2개 리스트 되는 이슈가 있음
  const [brandProductListFetch, { loading: brandProductListLoading }] =
    useCreateAdminAtBrandProductListWithOnlyNonStoppedVariantsLazyQuery();

  const brandProductPackageListQueryVariables: BrandProductPackagesVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    first: 500,
    filter: {},
  };
  const [packageListFetch, { loading: packageListLoading }] = useBrandProductPackagesLazyQuery();

  const bpBundleListQueryVariables: BpBundlesVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    first: 500,
    filter: {},
  };
  const [bundleListFetch, { loading: bundleListLoading }] = useBpBundlesLazyQuery();

  const productVariantListQueryVariables: CreateAdminAtProductVariantListVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    first: 500,
    filter: {},
  };
  const [productListFetch, { loading: productListLoading }] = useCreateAdminAtProductVariantListLazyQuery();

  const isIncludeVat = isByStaffForB2b === false;
  const useBpSkuMode = isByStaffForBrand || isByStaffForB2b || isByHqStaffForBrand;
  const productListTableColumn = getCreateAdminOrderProductListTableSettings();
  const brandProductListTableColumn = getCreateAdminOrderBrandProductListTableSetting(
    isIncludeVat,
    useBpSkuMode,
    isByStaffForB2b,
    isHqStaff,
    isByHqStaffForBrand
  );
  const brandPackageListTableColumn = getCreateAdminOrderBrandPackageListTableSetting();

  const productListTableWidthSum = utils.calcTableColsWidthSum(productListTableColumn);
  const brandProductListTableWidthSum = utils.calcTableColsWidthSum(brandProductListTableColumn);
  const brandPackageListTableWidthSum = utils.calcTableColsWidthSum(brandPackageListTableColumn);

  const selectedRowKeysWatched = Form.useWatch("selectedRowKeys", form) || [];

  const productRowSelection: TableRowSelection<CreateAdminAtProductVariantList_productVariants_edges_node> = {
    fixed: true,
    onChange: (selectedRowKeys) => {
      // 패키지에서 선택된 항목들을 유지하면서 일반 상품 선택 업데이트
      const currentSelectedKeys = form.getFieldValue("selectedRowKeys") || [];
      const packageIds = packageList.map((pkg) => pkg.id);
      const packageSelectedKeys = currentSelectedKeys.filter((key) => packageIds.includes(key));
      const newSelectedKeys = [...new Set([...packageSelectedKeys, ...selectedRowKeys])];
      form.setFieldValue("selectedRowKeys", newSelectedKeys);
    },
    selectedRowKeys: selectedRowKeysWatched.filter((key) => productVariantList.some((product) => product.id === key)),
  };

  const packageRowSelection: TableRowSelection<BrandProductPackages_brandProductPackages_edges_node> = {
    fixed: true,
    onChange: (selectedRowKeys) => {
      // 일반 상품에서 선택된 항목들을 유지하면서 패키지 선택 업데이트
      const currentSelectedKeys = form.getFieldValue("selectedRowKeys") || [];
      const productIds = productVariantList.map((product) => product.id);
      const productSelectedKeys = currentSelectedKeys.filter((key) => productIds.includes(key));
      const newSelectedKeys = [...new Set([...productSelectedKeys, ...selectedRowKeys])];
      form.setFieldValue("selectedRowKeys", newSelectedKeys);
    },
    selectedRowKeys: selectedRowKeysWatched.filter((key) => packageList.some((pkg) => pkg.id === key)),
  };

  const useFilterSetup = (
    useBpvMode: boolean,
    customerUserWatched,
    productVariantListQueryVariables,
    brandProductVariantListQueryVariables,
    productListFetch,
    brandProductListFetch
  ) =>
    React.useMemo(() => {
      const queryVariables = useBpvMode ? brandProductVariantListQueryVariables : productVariantListQueryVariables;
      const refetch = useBpvMode ? brandProductListFetch : productListFetch;

      const onFilterChange = (filters) => {
        if (useBpvMode && customerUserWatched === undefined) {
          showNotificationWarn("회원을 선택해주세요.");
          return;
        }

        const filterVariables = useBpvMode
          ? getBrandProductVariantListVariantSearchFilterVariables(filters, customerUserWatched)
          : getProductVariantListVariantSearchFilterVariables(filters, customerUserWatched);
        const newQueryVariables: CreateAdminAtBrandProductListWithOnlyNonStoppedVariantsVariables = {
          ...queryVariables,
          filter: {
            ...filterVariables,
            salesStatus: useBpvMode ? undefined : [SalesStatusEnum.ON_SALE, SalesStatusEnum.WILL_BE_STOPPED],
            isInner: useBpvMode ? undefined : false,
            brand: useBpvMode ? customerUserWatched.brand.id : undefined,
            isFulfilledByVendor: useBpvMode ? false : undefined,
          },
        };
        // 일반 상품 fetch
        refetch({ variables: newQueryVariables }).then((res) => {
          const regularProducts = productVariantListProcessingData(
            res.data[useBpvMode ? "brandProducts" : "productVariants"].edges.map((edge) => edge.node),
            useBpvMode
          );

          // 대행주문인 경우 bundle 상품도 fetch하여 병합
          if ((isByHqStaffForBrand || isByStaffForBrand) && customerUserWatched && useBpvMode) {
            const bundleFilterVariables = getBpBundlesListVariantSearchFilterVariables(filters);
            const bundleQueryVariables: BpBundlesVariables = {
              ...bpBundleListQueryVariables,
              filter: {
                brand: isByHqStaffForBrand ? null : customerUserWatched.brand.id,
                brandProductSearch: bundleFilterVariables.brandProductSearch,
              },
            };

            bundleListFetch({ variables: bundleQueryVariables }).then((bundleRes) => {
              let transformedBundles = [];
              if (bundleRes.data?.bpBundles?.edges) {
                const bundles = bundleRes.data.bpBundles.edges.map((edge) => edge.node);
                transformedBundles = bundleListProcessingData(bundles);
              }

              // 일반 상품 + bundle 상품 병합 후 bpSku로 정렬
              const mergedProducts = [...regularProducts, ...transformedBundles].sort((a, b) => {
                const aCode = a.brandProductVariant?.bpSku || "";
                const bCode = b.brandProductVariant?.bpSku || "";
                return aCode.localeCompare(bCode);
              });

              setProductVariantList(mergedProducts);
            });
          } else {
            setProductVariantList(regularProducts);
          }
        });

        // MD 대행 또는 가맹본부 주문인 경우 패키지 상품도 검색
        if ((isByHqStaffForBrand || isByStaffForBrand) && customerUserWatched) {
          const packageQueryVariables: BrandProductPackagesVariables = {
            ...brandProductPackageListQueryVariables,
            filter: {
              brand: isByHqStaffForBrand ? null : customerUserWatched.brand.id,
            },
          };
          packageListFetch({ variables: packageQueryVariables }).then((res) => {
            if (res.data?.brandProductPackages?.edges) {
              setPackageList(res.data.brandProductPackages.edges.map((edge) => edge.node));
            }
          });
        }
      };
      let menu = null;
      if (useBpvMode) {
        menu = brandProductVariantCreateFilterStructure(
          brandProductVariantGetFilterOpts(brandProductVariantListQueryVariables?.filter),
          isHqStaff,
          isByStaffForB2b
        );
      } else {
        menu = productVariantCreateFilterStructure(
          productVariantGetFilterOpts(productVariantListQueryVariables?.filter)
        );
      }

      return {
        menu,
        onFilterChange,
        currencySymbol: "원",
      };
    }, [useBpvMode, customerUserWatched, productVariantListQueryVariables, brandProductVariantListQueryVariables]);

  // Modal Component 내부
  const filterProps = useFilterSetup(
    useBpvMode,
    customerUserWatched,
    productVariantListQueryVariables,
    brandProductVariantListQueryVariables,
    productListFetch,
    brandProductListFetch
  );

  const linesObjIds: string[] = createFormLinesWatched.map((line) => line.id);

  useEffect(() => {
    if (isResetProductList === true) {
      setProductVariantList([]);
      setPackageList([]);
      setIsResetProductList(false);
    }
  }, [isResetProductList]);

  return (
    <Modal
      open={open}
      closable={false}
      onCancel={() => {
        onCancel();
        form.setFieldValue("selectedRowKeys", []);
      }}
      width={900}
      okButtonProps={{ disabled: selectedRowKeysWatched.length === 0 }}
      okText="선택 완료"
      onOk={() => {
        const getAfterSelectedProductVariantList = getAfterSelectedProductVariantListFn({
          form,
          useBpvMode,
          productList: productVariantList,
          packageList,
          isByStaffForB2b,
          isByHqStaffForBrand,
        });

        if (getAfterSelectedProductVariantList) {
          getAfterSelectedProductVariantList.map((product) => {
            const { id } = product;
            form.setFieldValue(["linesObj", id], product);
            if (isByStaffForB2b) {
              form.setFieldValue(["linesObj", id, "b2bDeliveryFeeExcludeVat"], 0);
            }
          });
        }
        form.setFieldValue("selectedRowKeys", []);
        onCancel();
      }}
      maskClosable={false}
    >
      {useBpvMode && customerUserWatched && (
        <Typography.Title level={3} style={{ marginBottom: 8 }}>
          {customerUserWatched.brand.name} 브랜드
        </Typography.Title>
      )}
      <SpreadFilter {...filterProps} />
      <Form.Item name="selectedRowKeys" hidden>
        <Input />
      </Form.Item>
      <Row justify="space-between" align="bottom">
        {isByHqStaffForBrand && (
          <Col>
            <Typography.Title level={5} style={{ marginTop: 24, marginBottom: 8 }}>
              일반 상품
            </Typography.Title>
          </Col>
        )}
        <Col>
          <TableVatLegend isIncludeVat={isIncludeVat} />
        </Col>
      </Row>
      <Table
        {...commonTableProps}
        ref={tableRef}
        style={{ marginTop: 16 }}
        loading={productListLoading || brandProductListLoading || bundleListLoading}
        columns={useBpvMode ? brandProductListTableColumn : productListTableColumn}
        dataSource={productVariantList.filter((productVariant) => !linesObjIds.includes(productVariant.id))}
        rowSelection={productRowSelection}
        scroll={{
          x: useBpvMode ? brandProductListTableWidthSum : productListTableWidthSum,
          y: tableScrollY,
        }}
      />
      {(isByHqStaffForBrand || isByStaffForBrand) && packageList.length > 0 && (
        <>
          <Row justify="space-between" align="bottom">
            <Col>
              <Typography.Title level={5} style={{ marginTop: 24, marginBottom: 8 }}>
                패키지 상품
              </Typography.Title>
            </Col>
            <Col>
              <TableVatLegend isIncludeVat={isIncludeVat} />
            </Col>
          </Row>
          <Table
            {...commonTableProps}
            style={{ marginTop: 8 }}
            loading={packageListLoading}
            columns={brandPackageListTableColumn}
            dataSource={packageList.filter((pkg) => !linesObjIds.includes(pkg.id))}
            rowSelection={packageRowSelection}
            scroll={{
              x: brandPackageListTableWidthSum,
              y: 300,
            }}
          />
        </>
      )}
    </Modal>
  );
};

export default CreateAdminOrderProductListModal;
