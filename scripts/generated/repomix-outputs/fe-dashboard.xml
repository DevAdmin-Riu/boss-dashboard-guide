import { SalesStatusEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { NumberComponent } from "@src/app/components/Number";
import { makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import {
  getAvailableQtyConsiderVirtualAllocForInner,
  getAvailableQtyConsiderVirtualAllocForOuter,
} from "@src/app/views/product/stock/utils";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  transformSalesStatusByBrandProductVariant,
  transformSalesStatusByProductVariant,
  transformTrackInventoryVariantType,
} from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { InputNumber, Tag } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo } from "../../api/types/BrandProductPackage";
import { IProductPackageInfoUpdate } from "../BrandPackageUpdateModal";

interface getBrandProductAddedListTableColumnsProps {
  productPackageInfoUpdate: ({ id, quantity }: IProductPackageInfoUpdate) => void;
  loading: boolean;
}

export const getBrandProductAddedListTableColumns = ({
  productPackageInfoUpdate,
  loading,
}: getBrandProductAddedListTableColumnsProps): ColumnsType<BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo> => [
  {
    title: columnNameConstant.product.PRODUCT_NAME,
    key: "productName",
    align: "left",
    width: 200,
    render: (_, record) => record.brandProductVariant.brandProduct.product.name,
  },
  {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "brandProductName",
    align: "left",
    width: 200,
    render: (_, record) => record.brandProductVariant.brandProduct.name,
  },
  {
    title: columnNameConstant.product.SALES_STATUS,
    key: "pvSalesStatus",
    align: "center",
    width: 80,
    render: (_, record) => {
      const pvSalesStatus = record.brandProductVariant.productVariant.salesStatus;
      const tagText = transformSalesStatusByProductVariant(pvSalesStatus);
      const tagColor = pvSalesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
      return <Tag color={tagColor}>{tagText}</Tag>;
    },
  },
  {
    title: columnNameConstant.product.SKU,
    key: "sku",
    align: "center",
    width: 120,
    render: (_, record) => record.brandProductVariant.productVariant.sku || "-",
  },
  {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    align: "left",
    width: 150,
    render: (_, record) => record.brandProductVariant.productVariant.name || "-",
  },
  {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 150,
    render: (_, record) => {
      const hasVariants = record.brandProductVariant.brandProduct.product.productType.hasVariants;
      const targetAttributes = hasVariants
        ? record.brandProductVariant.productVariant.attributes
        : record.brandProductVariant.brandProduct?.product.attributes;
      return makeProductSpecTextFromAttr(targetAttributes) || "-";
    },
  },
  {
    title: columnNameConstant.product.TRACK_INVENTORY,
    key: "trackInventoryVariantType",
    align: "center",
    width: 80,
    render: (_, record) => transformTrackInventoryVariantType(record.brandProductVariant.productVariant.trackInventory),
  },
  {
    title: columnNameConstant.product.ALLOW_AUTO_CONSIGNMENT,
    key: "allowAutoConsignmentVariantType",
    align: "center",
    width: 80,
    render: (_, record) => (record.brandProductVariant.productVariant.allowAutoConsignment ? "자동 위탁" : "-"),
  },
  {
    title: "재고 부족",
    key: "lackOfStock",
    align: "center",
    width: 80,
    render: (_, record) => {
      const trackInventory = record.brandProductVariant.productVariant.trackInventory;
      const allowAutoConsignment = record.brandProductVariant.productVariant.allowAutoConsignment;

      const productVariant = record.brandProductVariant.productVariant;
      const isInner = productVariant.isInner;
      const availableQtyConsiderVirtualAlloc = isInner
        ? getAvailableQtyConsiderVirtualAllocForInner(productVariant.outer, productVariant)
        : getAvailableQtyConsiderVirtualAllocForOuter(productVariant);

      if (record.quantity > availableQtyConsiderVirtualAlloc && trackInventory && !allowAutoConsignment) {
        return <Tag color="red">부족</Tag>;
      } else {
        return <Tag color="green">-</Tag>;
      }
    },
  },
  {
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "bpvSalesStatus",
    align: "center",
    width: 80,
    render: (_, record) => {
      const tagColor = record.brandProductVariant.salesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
      const tagText = transformSalesStatusByBrandProductVariant(record.brandProductVariant.salesStatus);
      return <Tag color={tagColor}>{tagText}</Tag>;
    },
  },
  {
    title: columnNameConstant.brandProduct.BRAND_DELIVERY_FEE[0],
    key: "deliveryFeeExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.brandProductVariant.deliveryFeeAmount)} />,
  },
  {
    title: columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE,
    key: "priceExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => (
      <NumberComponent value={record.brandProductVariant.priceAmount - record.brandProductVariant.priceVat} />
    ),
  },
  {
    title: "구성수량",
    key: "salesCount",
    align: "center",
    fixed: "right",
    width: 80,
    render: (_, record) => (
      <InputNumber
        {...getInputNumberProps({ isCommaDisplay: true })}
        disabled={loading}
        defaultValue={record.quantity}
        onChange={(value) => {
          const numberValue = Number(value);
          const isNotNumber = isNaN(numberValue);
          if (isNotNumber) {
            return showNotificationError("패키지 수량은 숫자만 입력할 수 있습니다.");
          }
          const isLowNumber = numberValue < 1;
          if (isLowNumber) {
            return showNotificationError("패키지 수량은 1개 이상이어야 합니다.");
          }
          productPackageInfoUpdate({ id: record.id, quantity: numberValue });
        }}
      />
    ),
  },
];
