import { utils } from "@utils/utils";
import { Modal } from "antd";
import React from "react";

import { useShippingZoneDeleteMutation } from "../api/mutations";
import { shippingZoneListQuery, useShippingZoneListQuery } from "../api/queries";
import ShippingZoneListPage from "../components/ShippingZoneListPage";
import {
  shippingZoneCreateViewUrl,
  shippingZoneDetailsViewUrl,
  shippingZoneListViewUrl,
  ShippingZoneListViewUrlDialog,
  ShippingZoneListViewUrlQueryParams,
} from "../urls";

interface ShippingZoneListViewProps {
  params: ShippingZoneListViewUrlQueryParams;
}

export const ShippingZoneListView: React.FC<ShippingZoneListViewProps> = ({ params }) => {
  const { user } = useUser();
  const targetUrl = shippingZoneListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.SHIPPING_ZONE_LIST,
  });

  const { data, loading } = useShippingZoneListQuery({ variables: paginationState });

  const [shippingZoneDelete, shippingZoneDeleteOpts] = useShippingZoneDeleteMutation({
    onCompleted: (data) => {
      const errors = data.shippingZoneDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [shippingZoneListQuery],
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    pageInfoPath: data?.shippingZones?.pageInfo,
    paginationState,
    params,
