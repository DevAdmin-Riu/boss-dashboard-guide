<file path="src/app/views/hqStaff/hqHome/components/OrderStatsForMain.tsx">
import { Area } from "@ant-design/charts";
import { User_brand } from "@src/api/fragments/types/User";
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import CardSpacer from "@src/app/components/CardSpacer";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import HomeHqStaffCard from "@src/app/views/home/components/HomeHqStaffCard";
import { BrandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { statsDateType, statsValueType } from "@utils/chart";
import { checkIsEnableForFbvServiceByBrand, transformIsFBVForHq } from "@utils/misc";
import { utils } from "@utils/utils";
import { Col, PageHeader, Row, Space, Typography } from "antd";
import moment from "moment";
import React from "react";

import {
  calcSumOfOrderCount,
  calcSumOfStatBrandCostPriceExcludeVatOnlyFbv,
  calcSumOfStatMileageExcludeVat,
  calcSumOfTotalPriceSupply,
  makeOrderDateElement,
} from "../../hqSection/components/HqStatsOrder/utils";
import { makeOrderStatsChartConfig } from "../utils/orderChartConfig";

export interface OrderStatsForMainProps {
  startDay: moment.Moment;
  duration: number;
  title: string;
  dateType: statsDateType.DAILY | statsDateType.MONTHLY;
  stats: BrandOrderStats;
  recentTargetDay: moment.Moment;
  brand: User_brand;
}

export const OrderStatsForMain: React.FC<OrderStatsForMainProps> = (props) => {
  const { recentTargetDay, startDay, duration, stats, title, dateType, brand } = props;
  const brandContractType = brand?.contractType;
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);
  const isReverseFee = brandContractType === BrandContractTypeEnum.REVERSE_FEE;
  const isMonthly = dateType === statsDateType.MONTHLY;
  const fbvTextForHq = transformIsFBVForHq(true);

  const brandOrderStats = stats?.brandOrderStats;
  const sumOfCapturedTotalExcludeVat = calcSumOfTotalPriceSupply(brandOrderStats);
  const sumOfCount = calcSumOfOrderCount(brandOrderStats);
  const sumOfMileageExcludeVat = calcSumOfStatMileageExcludeVat(brandOrderStats);
  const sumOfBrandCostPriceExcludeVatOnlyFbv = calcSumOfStatBrandCostPriceExcludeVatOnlyFbv(brandOrderStats);

  const contentsOfCapturedAmount = [
    {
      secondaryTitle: utils.formatVatInfo("판매총액 합계"),
      value: sumOfCapturedTotalExcludeVat,
    },
  ];
  const contentsOfCount = [
    {
      secondaryTitle: "주문 건수 합계",
      value: sumOfCount,
    },
  ];
  const contentsOfMileage = [
    {
      secondaryTitle: utils.formatVatInfo("본부수익금 합계"),
      value: sumOfMileageExcludeVat,
    },
  ];
  const contentsOfBrandCostPriceOnlyFbv = [
    {
      secondaryTitle: utils.formatVatInfo(`${fbvTextForHq} 상품 매입금 합계`),
      value: sumOfBrandCostPriceExcludeVatOnlyFbv,
    },
  ];

  if (isMonthly) {
    const targetDateMoment = moment(recentTargetDay);
    const targetDate = targetDateMoment.format(onlyDateFormat);
    const orderDateElement = makeOrderDateElement(targetDate, brandOrderStats);

    contentsOfCapturedAmount.push({
      secondaryTitle: utils.formatVatInfo("당월 주문 금액"),
      value: orderDateElement.statTotalPriceExcludeVat,
    });
    contentsOfCount.push({
      secondaryTitle: "당월 주문 건수",
      value: orderDateElement.statOrderCount,
    });
    contentsOfMileage.push({
      secondaryTitle: utils.formatVatInfo("당월 본부수익금"),
      value: orderDateElement.statMileageExcludeVat,
    });
    contentsOfBrandCostPriceOnlyFbv.push({
      secondaryTitle: utils.formatVatInfo(`당월 ${fbvTextForHq} 상품 매입금`),
      value: orderDateElement.statBrandCostPriceExcludeVatOnlyFbv,
    });
  }

  const isFourCharts = !isReverseFee && enableForFbvService;
  const colSpan = isFourCharts ? 12 : 8;

  return (
    <>
      <PageHeader
        title={<Typography.Title level={4}>{title}</Typography.Title>}
        className="ant-page-header-no-margin"
      />

      <Row gutter={[32, 32]}>
        <Col xs={24} sm={24} md={colSpan}>
          <Space direction="vertical" size={24}>
            <HomeHqStaffCard title={"판매총액"} contents={contentsOfCapturedAmount}>
              <Area
                {...makeOrderStatsChartConfig(
                  startDay,
                  duration,
                  brandOrderStats,
                  dateType,
                  statsValueType.TOTAL_PRICE
                )}
              />
            </HomeHqStaffCard>
          </Space>
        </Col>
        <Col xs={24} sm={24} md={colSpan}>
          <Space direction="vertical" size={24}>
            <HomeHqStaffCard title={"주문 건수"} contents={contentsOfCount}>
              <Area
                {...makeOrderStatsChartConfig(startDay, duration, brandOrderStats, dateType, statsValueType.COUNT)}
              />
            </HomeHqStaffCard>
          </Space>
        </Col>
        {!isReverseFee && (
          <Col xs={24} sm={24} md={colSpan}>
            <Space direction="vertical" size={24}>
              <HomeHqStaffCard title={"본부수익금"} contents={contentsOfMileage}>
                <Area
                  {...makeOrderStatsChartConfig(startDay, duration, brandOrderStats, dateType, statsValueType.MILEAGE)}
                />
              </HomeHqStaffCard>
            </Space>
          </Col>
        )}
        {enableForFbvService && (
          <Col xs={24} sm={24} md={colSpan}>
            <Space direction="vertical" size={24}>
              <HomeHqStaffCard title={`${fbvTextForHq} 상품 매입금`} contents={contentsOfBrandCostPriceOnlyFbv}>
                <Area
                  {...makeOrderStatsChartConfig(
                    startDay,
                    duration,
                    brandOrderStats,
                    dateType,
                    statsValueType.BRAND_COST_PRICE_ONLY_FBV
                  )}
                />
              </HomeHqStaffCard>
            </Space>
          </Col>
        )}
      </Row>
      <CardSpacer />
    </>
  );
};
</file>

