import { FetchResult } from "@apollo/client";
import {
  CategoryKindEnum,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
  ProductVariantVendorCreateInput,
} from "@src/api/types/globalTypes";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { StrictOmit } from "@src/global/core/types/types";
import { transformIsFBV } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Space, Tooltip, Typography } from "antd";
import React, { useEffect, useState } from "react";

import {
  ProductDetails_product,
  ProductDetails_product_outerVariants,
  ProductDetails_product_outerVariants_productVariantVendors,
} from "../../api/types/ProductDetails";
import {
  ProductVariantDetails_productVariant,
  ProductVariantDetails_productVariant_productVariantVendors,
} from "../../api/types/ProductVariantDetails";
import { ProductVariantVendorSetDefault } from "../../api/types/ProductVariantVendorSetDefault";
import { productVariantManageEventTypeChoices } from "../../utils/data";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "../PvOrBpvManageEventModal";
import { getProductVendorTableColumns } from "./ProductVendorTableSettings";

interface ProductVendorConnectCardProps {
  disabled: boolean;
  product: Pick<ProductDetails_product, "isFulfilledByVendor" | "category">;
  productVariant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  onVariantVendorCreate: () => void;
  onVariantVendorUpdate: (variantVendorId: string) => void;
  onVariantVendorSetDefault: (
    productVariantId: string,
    variantVendorId: string,
    manageEvent: ProductVariantManageEventInput
  ) => Promise<FetchResult<ProductVariantVendorSetDefault>>;
}

export interface ProductVariantVendorDataSourceType
  extends ProductDetails_product_outerVariants_productVariantVendors,
    ProductVariantDetails_productVariant_productVariantVendors {
  isDefault: boolean;
  // 한 협력사에 대해 협력사 상품가, 협력사 배송비를 재고/위탁 여부에 따라 로우를 구분하기 위해 추가하는 필드
  trackInventory: boolean;
  isB2bCategoryKind: boolean;
  isDevCategoryKind: boolean;
}

export interface ProductVariantVendorFormType extends StrictOmit<ProductVariantVendorCreateInput, "manageEvent"> {
  isDefault: boolean;
}

// NOTE: 수정 모드인 경우, 재고 여부에 따라 rowKey 생성 - antd Table의 rowKey 중복 콘솔 에러 로그 방지하기 위한 처리
const makeRowKeyForUpdateVendor = (record: ProductVariantVendorDataSourceType) => {
  const trackInventory = record?.trackInventory ? "TRACK_INVENTORY" : "CONSIGNMENT";
  return `${record?.id}_${trackInventory}`;
};

export const ProductVendorConnectCard: React.FC<ProductVendorConnectCardProps> = (props) => {
  const { disabled, product, productVariant, onVariantVendorCreate, onVariantVendorUpdate, onVariantVendorSetDefault } =
    props;
  const { isFulfilledByVendor } = product;
  const [dataSource, setDataSource] = useState<ProductVariantVendorDataSourceType[]>([]);
  const [selectedRowId, setSelectedRowId] = useState<string>(undefined);
  const [manageEventModalOpen, setManageEventModalOpen] = useState<boolean>(false);
  const isB2bCategoryKind = product.category.kind === CategoryKindEnum.B2B;
  const isDevCategoryKind = product.category.kind === CategoryKindEnum.DEV;

  useEffect(() => {
    const productVariantVendorData: ProductVariantVendorDataSourceType[] =
      productVariant?.productVariantVendors?.flatMap((productVariantVendor) => {
        const isDefault = productVariant?.defaultVariantVendor?.id === productVariantVendor?.id;

        // 위탁 행만 생성
        if (isB2bCategoryKind || isDevCategoryKind) {
          return [
            {
              ...productVariantVendor,
              isDefault,
              trackInventory: false,
              isB2bCategoryKind,
              isDevCategoryKind,
            },
          ];
        }

        // 재고와 위탁 행 모두 생성
        return [
          {
            ...productVariantVendor,
            isDefault,
            trackInventory: true,
            isB2bCategoryKind,
            isDevCategoryKind,
          },
          {
            ...productVariantVendor,
            isDefault,
            trackInventory: false,
            isB2bCategoryKind,
            isDevCategoryKind,
          },
        ];
      });
    setDataSource(productVariantVendorData);
  }, [productVariant, isB2bCategoryKind, isDevCategoryKind]);

  const onCancel = () => {
    setSelectedRowId(undefined);
    setManageEventModalOpen(false);
  };

  const onSetDefaultClick = (record: ProductVariantVendorDataSourceType) => {
    const validateSetDefaultInput = () => {
      const { productPriceExcludeVat, consignmentProductPriceExcludeVat } = record;
      const trackInventory = productVariant?.trackInventory;
      if (trackInventory) {
        if (
          (utils.isEmpty(productPriceExcludeVat) || productPriceExcludeVat <= 0) &&
          (utils.isEmpty(consignmentProductPriceExcludeVat) || consignmentProductPriceExcludeVat <= 0)
        ) {
          showNotificationError(
            "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 모두 0 이하면 기본값으로 설정할 수 없습니다."
          );
          return false;
        }
      } else {
        if (utils.isEmpty(consignmentProductPriceExcludeVat) || consignmentProductPriceExcludeVat <= 0) {
          showNotificationError(
            `재고 미운영이거나 ${transformIsFBV(
              true
            )} 상품인 경우, 협력사 위탁 상품가가 0 이하면 기본값으로 설정할 수 없습니다.`
          );
          return false;
        }
      }
      const isActive = record?.isActive;
      if (isActive === false) {
        showNotificationError("활성화 되지 않은 협력사는 기본 협력사로 설정할 수 없습니다.");
        return false;
      }
      return true;
    };

    const isValid = validateSetDefaultInput();
    if (isValid) {
      setSelectedRowId(record.id);
      setManageEventModalOpen(true);
    } else {
      onCancel();
    }
  };

  const onSetDefaultSubmit = async ({ manageEvent }: ProductVariantManageEventModalForm) => {
    const selectedVariantVendor = dataSource.find((data) => data.id === selectedRowId);
    const variantVendorId = selectedVariantVendor?.id;
    const { data } = await onVariantVendorSetDefault(
      productVariant?.id,
      variantVendorId,
      manageEvent as ProductVariantManageEventInput
    );
    const errors = data?.productVariantVendorSetDefault?.errors;
    if (errors.length === 0) {
      onCancel();
    }
  };

  const columns = getProductVendorTableColumns({
    disabled,
    salesUnitType: productVariant?.salesUnitType,
    selectedRowId,
    isB2bCategoryKind,
    isDevCategoryKind,
    onVariantVendorUpdate,
    onSetDefaultClick,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const variantVendorsCount = productVariant?.productVariantVendors?.length;

  const cardTitle = (
    <CardTitleAntd
      title={
        <Space direction="vertical" size={0}>
          <Space align={"end"}>
            <Typography>협력사</Typography>
          </Space>
        </Space>
      }
    />
  );
  const cardExtra = (
    <Button
      type={"primary"}
      disabled={disabled || !utils.isEmpty(selectedRowId) || (isFulfilledByVendor && variantVendorsCount > 0)}
      onClick={onVariantVendorCreate}
    >
      추가
    </Button>
  );

  const fbvTooltipCardExtra = (
    <Tooltip placement="topLeft" title={"직거래 상품은 협력사 하나만 운영 가능합니다."}>
      {cardExtra}
    </Tooltip>
  );

  return (
    <>
      <Card title={cardTitle} extra={isFulfilledByVendor ? fbvTooltipCardExtra : cardExtra} bodyStyle={{ padding: 0 }}>
        <TableVatLegend isIncludeVat={false} size="small" />
        <PatchedColumnsTable
          {...commonTableProps}
          rowKey={(record) => makeRowKeyForUpdateVendor(record)}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
      <ProductVariantManageEventModal
        isCreateMode
        open={manageEventModalOpen}
        loading={disabled}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_VENDOR}
        choices={productVariantManageEventTypeChoices}
        onSubmit={onSetDefaultSubmit}
        onCancel={onCancel}
      />
    </>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductVendorConnectCard/ProductVendorTableSettings.tsx">
import { SalesUnitTypeEnum } from "@src/api/types/globalTypes";
import { newEditableRowId } from "@src/app/components/antd/Table/editableCell";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import DeliveryFeeInclusionStatus from "@src/app/components/DeliveryFeeInclusionStatus";
import { NumberComponent } from "@src/app/components/Number";
import { makePOLeadTimeFormat, makeVendorDisplayName } from "@utils/misc";
import { FixedType, utils } from "@utils/utils";
import { Badge, Button, Space, Tag, Tooltip, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { getSalesUnitTypeText } from "../../utils/data";
import { ProductVariantSetDefault } from "../ProductVariantSetDefault";
import { ProductVariantVendorDataSourceType } from "./ProductVendorConnectCard";

const colKeyForProductVendor = {
  isActive: "isActive",
  vendor: "vendor",
  externalSku: "externalSku",
  externalProductName: "externalProductName",
  trackInventory: "trackInventory",
  productPriceExcludeVat: "productPriceExcludeVat",
  deliveryFeeExcludeVat: "deliveryFeeExcludeVat",
  costPriceExcludeVat: "costPriceExcludeVat",
  // 협력사 위탁 상품가, 협력사 위탁 배송비는 trackInventory가 false일 때만 makeFormItemName에서 처리되어 사용 - 실제 Table 컬럼은 없음
  consignmentProductPriceExcludeVat: "consignmentProductPriceExcludeVat",
  consignmentDeliveryFeeExcludeVat: "consignmentDeliveryFeeExcludeVat",
  includePurchaseB2bDeliveryFee: "includePurchaseB2bDeliveryFee",
  leadTime: "leadTime",
  pricingBasisQty: "pricingBasisQty",
  moq: "moq",
  uoq: "uoq",
  note: "note",
  noteForUnitPrice: "noteForUnitPrice",
  operation: "action",
};

interface ProductVariantVendorTableColumnProps {
  disabled: boolean;
  salesUnitType: SalesUnitTypeEnum;
  selectedRowId: string;
  isB2bCategoryKind: boolean;
  isDevCategoryKind: boolean;
  onVariantVendorUpdate: (variantVendorId: string) => void;
  onSetDefaultClick: (record: ProductVariantVendorDataSourceType) => void;
}

const productPriceTooltipTitle = (
  <Space direction="vertical" size={0}>
    <Typography.Text style={{ color: "white" }}>
      - 협력사 상품가는 1상자 기준이며 재고는 화물차 비용을 포함해서, 위탁은 화물차 비용을 제외해서 입력해야 합니다.
    </Typography.Text>
  </Space>
);

const deliveryFeeTooltipTitle = (
  <Space direction="vertical" size={0}>
    <Typography.Text style={{ color: "white" }}>- 택배로 매입할 경우 발생하는 1상자 당 배송비입니다.</Typography.Text>
    <Typography.Text style={{ color: "white" }}>
      - 화물차로 매입할 수 없는 재고는 이 값을 입력하고 상품가에서 화물차 배송비를 제외해야 합니다.
    </Typography.Text>
  </Space>
);

const getProductPriceExcludeVat = (record: ProductVariantVendorDataSourceType) =>
  record.trackInventory ? record.productPriceExcludeVat : record.consignmentProductPriceExcludeVat;

const getDeliveryFeeExcludeVat = (record: ProductVariantVendorDataSourceType) =>
  record.trackInventory ? record.deliveryFeeExcludeVat : record.consignmentDeliveryFeeExcludeVat;

// 컬럼 생성 함수들
const createIsActiveColumn = () => ({
  title: "활성화",
  key: colKeyForProductVendor.isActive,
  align: "center" as const,
  width: 100,
  render: (_, record: ProductVariantVendorDataSourceType) =>
    record?.isActive ? <Tag color={"processing"}>활성화</Tag> : <Tag color={"default"}>비활성화</Tag>,
});

const createVendorColumn = () => ({
  title: "협력사명",
  key: colKeyForProductVendor.vendor,
  align: "center" as const,
  width: 250,
  render: (_, record: ProductVariantVendorDataSourceType) => (
    <Space direction={"vertical"} size={0}>
      {record.isDefault && (
        <Space direction={"horizontal"} size="small">
          {record.isDefault && <Tag color={"warning"}>기본</Tag>}
        </Space>
      )}
      {makeVendorDisplayName(record?.vendor)}
    </Space>
  ),
});

const createExternalSkuColumn = () => ({
  title: "협력사 상품ID",
  key: colKeyForProductVendor.externalSku,
  align: "center" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => record?.externalSku || "-",
});

const createExternalProductNameColumn = () => ({
  title: "협력사 상품명",
  key: colKeyForProductVendor.externalProductName,
  align: "center" as const,
  width: 200,
  render: (_, record: ProductVariantVendorDataSourceType) => record?.externalProductName || "-",
});

const createTrackInventoryColumn = () => ({
  title: "구분",
  key: colKeyForProductVendor.trackInventory,
  align: "center" as const,
  width: 80,
  render: (_, record: ProductVariantVendorDataSourceType) => (record.trackInventory ? "재고" : "위탁"),
});

const createProductPriceColumn = (isB2bCategoryKind: boolean, isDevCategoryKind: boolean) => ({
  title: isB2bCategoryKind ? (
    ["B2B 제품", "협력사 매입가"]
  ) : isDevCategoryKind ? (
    ["개발비 제품", "협력사 매입가"]
  ) : (
    <Tooltip title={productPriceTooltipTitle}>
      <Badge size="small" count="?" offset={[10, 0]}>
        {columnNameConstant.purchaseOrder.VENDOR_PRICE(false)}
      </Badge>
    </Tooltip>
  ),
  key: colKeyForProductVendor.productPriceExcludeVat,
  align: "right" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => {
    const value = getProductPriceExcludeVat(record);
    return <NumberComponent value={value} />;
  },
});

const createIncludePurchaseB2bDeliveryFee = (isB2bCategoryKind: boolean, isDevCategoryKind: boolean) => ({
  title: isB2bCategoryKind
    ? ["B2B 제품", columnNameConstant.orderLine.INCLUDE_B2B_DELIVERY_FEE]
    : isDevCategoryKind
    ? ["개발비 제품", columnNameConstant.orderLine.INCLUDE_B2B_DELIVERY_FEE]
    : columnNameConstant.orderLine.INCLUDE_B2B_DELIVERY_FEE,
  key: colKeyForProductVendor.includePurchaseB2bDeliveryFee,
  align: "center" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => (
    <DeliveryFeeInclusionStatus isIncluded={record.includePurchaseB2bDeliveryFee} showStyles={false} />
  ),
});

const createPurchaseB2bDeliveryFeeColumn = (isB2bCategoryKind: boolean, isDevCategoryKind: boolean) => ({
  title: isB2bCategoryKind
    ? ["B2B 제품", "매입 배송비"]
    : isDevCategoryKind
    ? ["개발비 제품", "매입 배송비"]
    : "매입 배송비",
  key: "purchaseB2bDeliveryFeeExcludeVat",
  align: "right" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => {
    const value = record.purchaseB2bDeliveryFeeExcludeVat || 0;
    return <NumberComponent value={value} />;
  },
});

const createDeliveryFeeColumn = () => ({
  title: (
    <Tooltip title={deliveryFeeTooltipTitle}>
      <Badge size="small" count="?" offset={[10, 0]}>
        {columnNameConstant.purchaseOrder.VENDOR_DELIVERY_FEE(false)}
      </Badge>
    </Tooltip>
  ),
  key: colKeyForProductVendor.deliveryFeeExcludeVat,
  align: "right" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => {
    const value = getDeliveryFeeExcludeVat(record);
    return <NumberComponent value={value} />;
  },
});

const createCostPriceColumn = () => ({
  title: columnNameConstant.purchaseOrder.VENDOR_COST_PRICE(false),
  key: colKeyForProductVendor.costPriceExcludeVat,
  align: "right" as const,
  width: 150,
  render: (_, record: ProductVariantVendorDataSourceType) => {
    const value = getProductPriceExcludeVat(record) + getDeliveryFeeExcludeVat(record);
    return <NumberComponent value={value} />;
  },
});

const createLeadTimeColumn = () => ({
  title: columnNameConstant.common.LEAD_TIME,
  key: colKeyForProductVendor.leadTime,
  align: "center" as const,
  width: 80,
  render: (_, record: ProductVariantVendorDataSourceType) => makePOLeadTimeFormat(record.leadTime),
});

const createSalesUnitTypeColumn = (salesUnitType: SalesUnitTypeEnum) => ({
  title: columnNameConstant.product.SALES_UNIT_TYPE,
  key: "salesUnitType",
  align: "center" as const,
  width: 80,
  render: () => getSalesUnitTypeText(salesUnitType),
});

const createPricingBasisQtyColumn = () => ({
  title: columnNameConstant.purchaseOrder.PRICING_BASIS_QTY,
  key: colKeyForProductVendor.pricingBasisQty,
  align: "center" as const,
  width: 100,
  render: (_, record: ProductVariantVendorDataSourceType) => <NumberComponent value={record?.pricingBasisQty} />,
});
const createMoqColumn = () => ({
  title: "MOQ",
  key: colKeyForProductVendor.moq,
  align: "center" as const,
  width: 100,
  render: (_, record: ProductVariantVendorDataSourceType) => <NumberComponent value={record?.moq} />,
});

const createNoteColumn = () => ({
  title: "메모",
  key: colKeyForProductVendor.note,
  align: "center" as const,
  width: 300,
  render: (_, record: ProductVariantVendorDataSourceType) => record?.note || "-",
});

const createNoteForUnitPriceColumn = () => ({
  title: "수량 별 단가",
  key: colKeyForProductVendor.noteForUnitPrice,
  align: "center" as const,
  width: 300,
  render: (_, record: ProductVariantVendorDataSourceType) => record?.noteForUnitPrice || "-",
});

const createOperationColumn = (props: {
  disabled: boolean;
  selectedRowId: string;
  onVariantVendorUpdate: (variantVendorId: string) => void;
  onSetDefaultClick: (record: ProductVariantVendorDataSourceType) => void;
  fixedRightFlag: FixedType;
}) => ({
  key: colKeyForProductVendor.operation,
  align: "center" as const,
  width: 100,
  fixed: props.fixedRightFlag,
  render: (_, record: ProductVariantVendorDataSourceType) => {
    const isRowAdd = record.id === newEditableRowId;
    const setDefaultButton = !record.isDefault && !isRowAdd && (
      <ProductVariantSetDefault
        disabled={!utils.isEmpty(props.selectedRowId) || props.disabled}
        onSetDefaultVariant={() => props.onSetDefaultClick(record)}
      />
    );
    return (
      <Space>
        {setDefaultButton}
        <Button
          type="primary"
          disabled={!utils.isEmpty(props.selectedRowId) || props.disabled}
          onClick={() => props.onVariantVendorUpdate(record.id)}
        >
          수정
        </Button>
      </Space>
    );
  },
});

export const getProductVendorTableColumns = ({
  disabled,
  selectedRowId,
  salesUnitType,
  isB2bCategoryKind,
  isDevCategoryKind,
  onVariantVendorUpdate,
  onSetDefaultClick,
}: ProductVariantVendorTableColumnProps) => {
  const columns: ColumnsType<ProductVariantVendorDataSourceType> = [];
  const fixedRightFlag = utils.fixedRightFlag();

  // 기본 정보 컬럼들
  const isActiveColumn = createIsActiveColumn();
  const vendorColumn = createVendorColumn();
  const externalSkuColumn = createExternalSkuColumn();
  const externalProductNameColumn = createExternalProductNameColumn();

  const trackInventoryColumn = createTrackInventoryColumn();
  const includePurchaseB2bDeliveryFeeColumn = createIncludePurchaseB2bDeliveryFee(isB2bCategoryKind, isDevCategoryKind);
  const purchaseB2bDeliveryFeeColumn = createPurchaseB2bDeliveryFeeColumn(isB2bCategoryKind, isDevCategoryKind);

  // 가격 관련 컬럼들
  const productPriceColumn = createProductPriceColumn(isB2bCategoryKind, isDevCategoryKind);
  const deliveryFeeColumn = createDeliveryFeeColumn();
  const costPriceColumn = createCostPriceColumn();

  // 기타 정보 컬럼들
  const leadTimeColumn = createLeadTimeColumn();
  const salesUnitTypeColumn = createSalesUnitTypeColumn(salesUnitType);
  const pricingBasisQtyColumn = createPricingBasisQtyColumn();
  const moqColumn = createMoqColumn();
  const noteColumn = createNoteColumn();
  const noteForUnitPriceColumn = createNoteForUnitPriceColumn();

  // 액션 컬럼
  const operationColumn = createOperationColumn({
    disabled,
    selectedRowId,
    onVariantVendorUpdate,
    onSetDefaultClick,
    fixedRightFlag,
  });

  columns.push(
    isActiveColumn,
    vendorColumn,
    externalSkuColumn,
    externalProductNameColumn,
    isB2bCategoryKind === false && isDevCategoryKind === false && trackInventoryColumn,
    productPriceColumn,
    (isB2bCategoryKind || isDevCategoryKind) && includePurchaseB2bDeliveryFeeColumn,
    (isB2bCategoryKind || isDevCategoryKind) && purchaseB2bDeliveryFeeColumn,
    isB2bCategoryKind === false && isDevCategoryKind === false && deliveryFeeColumn,
    isB2bCategoryKind === false && isDevCategoryKind === false && costPriceColumn,
    leadTimeColumn,
    salesUnitTypeColumn,
    pricingBasisQtyColumn,
    moqColumn,
    noteColumn,
    noteForUnitPriceColumn,
    operationColumn
  );

  const mergedColumns: ColumnsType<ProductVariantVendorDataSourceType> = columns.filter(Boolean).map((col) => {
    // rowSpan을 통해서 머지하지 않을 컬럼을 지정(이 외의 컬럼들은 trackInventory가 false일 때 0으로 설정되며 협력사의 재고 로우로 머지 됨)
    const colKeysToNoMerge = [
      colKeyForProductVendor.trackInventory,
      colKeyForProductVendor.productPriceExcludeVat,
      colKeyForProductVendor.deliveryFeeExcludeVat,
      colKeyForProductVendor.costPriceExcludeVat,
    ];
    // 위에서 제외된 컬럼 외에 나머지 컬럼들은 협력사 위탁 로우일 경우, 협력사 재고 로우에 머지 됨
    const defaultOnCell = (record: ProductVariantVendorDataSourceType) => {
      // 병합하지 않을 컬럼들은 항상 rowSpan = 1
      if (colKeysToNoMerge.includes(col?.key as string)) {
        return { rowSpan: 1 };
      }

      // 위탁만 노출하는 경우 rowSpan = 1
      if (record.isB2bCategoryKind || record.isDevCategoryKind) {
        return { rowSpan: 1 };
      }

      // B2B가 아닌 경우 재고/위탁 병합 처리
      if (record.trackInventory) {
        return { rowSpan: 2 }; // 재고 행은 2줄로 확장
      }

      return { rowSpan: 0 }; // 위탁 행은 재고 행에 병합
    };

    return {
      ...col,
      onCell: (record: ProductVariantVendorDataSourceType) => ({
        ...defaultOnCell(record),
      }),
    };
  });

  return mergedColumns;
};
