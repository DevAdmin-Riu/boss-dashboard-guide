        )}
        {(userStatsTodayData || productStatsTodayData) && (
          <EtcStatsForMain title="오늘의 랭킹" userStats={userStatsTodayData} productStats={productStatsTodayData} />
        )}
      </Space>
      <BrandEtcFileListForHqModal
        open={modalMode === HqHomeModalModeEnum.QueryEtcFileList}
        etcFiles={maybe(() => brand?.etcFiles, [])}
        etcInfo={brand?.etcInfo}
        onCancel={closeModal}
      />
    </RequirePermissions>
