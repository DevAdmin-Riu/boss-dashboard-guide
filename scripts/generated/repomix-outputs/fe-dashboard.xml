import makeQuery from "@hooks/makeQuery";
import { bannerFragment, bannerFragmentForList } from "@src/api/fragments/banner";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import gql from "graphql-tag";

import { BannerDetails, BannerDetailsVariables } from "./types/BannerDetails";
import { BannerList, BannerListVariables } from "./types/BannerList";

export const bannerListQuery = gql`
  ${bannerFragmentForList}
  ${pageInfoFragment}
  query BannerList($first: Int, $after: String, $last: Int, $before: String, $sort: BannerSortingInput) {
    banners(before: $before, after: $after, first: $first, last: $last, sortBy: $sort) {
      edges {
        node {
          ...BannerFragmentForList
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const useBannerListQuery = makeQuery<BannerList, BannerListVariables>(bannerListQuery);

const bannerDetailsQuery = gql`
  ${bannerFragment}
  query BannerDetails($id: ID!) {
    banner(id: $id) {
      ...BannerFragment
    }
  }
`;
export const useBannerDetailsQuery = makeQuery<BannerDetails, BannerDetailsVariables>(bannerDetailsQuery);
