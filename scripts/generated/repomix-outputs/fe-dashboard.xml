export const getDevCostEventTableColumns = (
  props: Pick<DevCostEventListPageListPageProps, "onRowClick">,
  isHqStaff: boolean
) => {
  const { onRowClick } = props;
  const showBrandColumn = !!onRowClick && isHqStaff === false;
  const columns: DownloadableColumnsType<DevCostEventList_brandDevCostEvents_edges_node> = [];

  columns.push({
    title: "추가/차감일",
    align: "center",
    key: "created",
    width: 180,
    render: (_, record) => <DateTime date={record.created} />,
    renderExcel: (record) => getDateByFormat(record.created),
  });
  if (showBrandColumn) {
    columns.push({
      title: columnNameConstant.brand.BRAND_NAME,
      align: "center",
      key: "brand",
      width: 150,
      render: (_, record) => {
        if (record.brand) {
          return <Typography.Link onClick={() => onRowClick(record.brand.id)}>{record.brand.name}</Typography.Link>;
        } else {
          return "-";
        }
      },
      renderExcel: (record) => record.brand?.name || "-",
    });
  }
  columns.push({
    title: "상세내용",
    align: "center",
    key: "description",
    width: 400,
    render: (_, record) => record.description,
  });
  columns.push({
    title: "추가",
    titleExcel: `추가 ${commonMsg.includeVat}`,
    align: "right",
    key: "recharge",
    width: 120,
    render: (_, record) =>
      checkIsDecreaseDevCostEvent(record.type) === false ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-green"])}
          prefix={"+"}
          value={record.qty}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (checkIsDecreaseDevCostEvent(record.type) === false ? record.qty : "-"),
  });
  columns.push({
    title: "차감",
    titleExcel: `차감 ${commonMsg.includeVat}`,
    align: "right",
    key: "deduction",
    width: 120,
    render: (_, record) =>
      checkIsDecreaseDevCostEvent(record.type) ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-red"])}
          prefix={"-"}
          value={record.qty}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (checkIsDecreaseDevCostEvent(record.type) ? record.qty : "-"),
  });
  columns.push({
    title: "잔여 기타 비용",
    titleExcel: `잔여 기타 비용 ${commonMsg.includeVat}`,
    align: "right",
    key: "qtyAfter",
