  brandSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  type: FilterOpts<DigitalContractCountEventTypeEnum[]>;
}

export function createFilterStructure(
  opts: DigitalContractCountEventListFilterOpts,
  isHqStaff: boolean
): IFilter<DigitalContractCountEventFilterKeys> {
  let displayOrder = 0;
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      DigitalContractCountEventFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const createdFilter = {
    ...createDateField(displayOrder++, DigitalContractCountEventFilterKeys.created, "추가/차감일", opts.created.value),
    active: opts.created.active,
  };
  const typeFilter = {
    ...createOptionsField(
      displayOrder++,
      DigitalContractCountEventFilterKeys.type,
      "구분",
      opts.type.value,
      true,
      typeChoices
    ),
    active: opts.type.active,
  };
  return [isHqStaff === false && brandSearchFilter, createdFilter, typeFilter].filter(Boolean);
}
