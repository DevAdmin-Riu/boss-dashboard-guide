  Dialog<PopupListViewUrlDialog> &
  PopupListViewUrlSort &
  Pagination &
  ActiveTab;

export const popupListViewUrl = (params?: PopupListViewUrlQueryParams): string => {
  if (params === undefined) {
    return popupListViewPath;
  } else {
    return urlJoin(popupListViewPath, "?" + stringifyQs(params));
  }
};

