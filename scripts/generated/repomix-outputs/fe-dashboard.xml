  getFormInputNumberMinValueRule,
} from "@src/app/components/antd/Form/validators";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { addEdgeToListCache } from "@src/app/providers/ApolloClientProvider/utils";
import { brandStoreDetailsQuery } from "@src/app/views/brand/brandStore/api/queries";
import {
  BrandStoreDetails,
  BrandStoreDetails_brandStore_ownerUser,
  BrandStoreDetails_brandStore_ownerUser_rcoinsEvents_edges,
} from "@src/app/views/brand/brandStore/api/types/BrandStoreDetails";
import { StrictOmit } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Form, Input, InputNumber, Modal, Typography } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect, useState } from "react";

import { useRcoinsEventCreateMutation } from "../api/mutations";
import { BrandAccountDetails_user } from "../api/types/BrandAccountDetails";

const { Text } = Typography;

type TFormData = StrictOmit<RcoinsEventCreateInput, "type">;

interface RcoinsEventCreateModalProps {
  open: boolean;
  loading: boolean;
  eventType: PointsEventTypeEnum;
  customerName: string;
  customer: BrandAccountDetails_user | BrandStoreDetails_brandStore_ownerUser;
  onClose: () => void;
}

export const RcoinsEventCreateModal: React.FC<RcoinsEventCreateModalProps> = (props) => {
  const { open, loading, eventType, customerName, customer, onClose } = props;
  const [confirmModalOpen, setConfirmModalOpen] = useState<boolean>(false);
  const rcoins = customer?.rcoins;
  const eventTypeText = utils.isEmpty(eventType) ? "" : eventType === PointsEventTypeEnum.DEDUCTION ? "차감" : "충전";
  const max = eventType === PointsEventTypeEnum.DEDUCTION ? rcoins : Infinity;

  const [form] = useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const qtyWatched = TypeSafeForm.getUseFormWatched({ name: "qty" });

  const initialValues: TFormData = { qty: undefined, description: undefined };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [rcoinsEventCreate, rcoinsEventCreateOpts] = useRcoinsEventCreateMutation({
    onCompleted: (data) => {
      const errors = data.rcoinsEventCreate.errors;
      const successMsg = (
        <MultiLineTypography
          lines={[
            <Text strong>{customerName}</Text>,
            `${paymentTerm.rcoins}이 ${eventTypeText}되었습니다.`,
            <>
              <Text>
                (잔액: <Text strong>{rcoins}</Text>)
              </Text>
            </>,
          ]}
        />
      );
      utils.handleOnCompletedWithError(errors, successMsg, () => {
        setConfirmModalOpen(false);
        onClose();
      });
    },
  });

  return (
    <Modal
      forceRender
      closable={false}
      onCancel={onClose}
      open={open}
      title={
        <Typography.Text type="danger">
          {customerName}: {paymentTerm.rcoins} {eventTypeText}
        </Typography.Text>
      }
      okText="확인"
      cancelText="뒤로"
      onOk={() => setConfirmModalOpen(true)}
      okButtonProps={{
        loading: loading || rcoinsEventCreateOpts.loading,
        disabled: qtyWatched === undefined || qtyWatched <= 0,
      }}
      maskClosable={false}
    >
      <Form
        form={form}
        name="rcoins-event-create-form"
        colon={false}
        labelCol={{ span: 24 }}
        wrapperCol={{ span: 24 }}
        initialValues={initialValues}
        onFinish={(formData) => {
          rcoinsEventCreate({
            variables: { userId: customer?.id, input: { ...formData, type: eventType } },
            update: (cache, { data }) => {
              addEdgeToListCache<BrandStoreDetails, BrandStoreDetails_brandStore_ownerUser_rcoinsEvents_edges>({
                cache,
                query: brandStoreDetailsQuery,
                schemaName: "brandStore",
                edgeField: "brandStore.ownerUser.rcoinsEvents",
                newNode: data.rcoinsEventCreate.user.rcoinsEvents.edges[0],
                makeEdges: (edges, newEdge) => [newEdge, ...edges.slice(0, 4)],
              });
            },
          });
        }}
      >
        <Form.Item
          labelCol={{ span: 24 }}
          wrapperCol={{ span: 24 }}
          rules={[
            { required: true },
            { type: "integer" },
            getFormInputNumberMinValueRule({ min: 1 }),
            getFormInputNumberMaxValueRule({ max }),
          ]}
          name={TypeSafeForm.getValidDataIndex("qty")}
          label={`${paymentTerm.rcoins} ${eventTypeText} 금액`}
        >
          <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
        </Form.Item>
        <Form.Item name={TypeSafeForm.getValidDataIndex("description")} label="상세내역">
          <Input />
        </Form.Item>
      </Form>
      {confirmModalOpen && (
        <ConfirmModal visible={confirmModalOpen} onOk={form.submit} onCancel={() => setConfirmModalOpen(false)} />
      )}
    </Modal>
  );
};
