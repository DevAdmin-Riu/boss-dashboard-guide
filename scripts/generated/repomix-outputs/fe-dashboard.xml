  ${brandHistoryFragment}
  query BrandHistory($id: ID!) {
    brandHistory(id: $id) {
      ...BrandHistoryFragment
    }
  }
`;
export const useBrandHistoryQuery = makeQuery<BrandHistory, BrandHistoryVariables>(brandHistoryQuery);
