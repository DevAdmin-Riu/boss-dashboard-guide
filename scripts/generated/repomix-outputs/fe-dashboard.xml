}

export function getDeliveryListUrlAFilterVariables(params: OrderDeliveryListViewUrlFilters): FulfillmentFilterInput {
  return {
    ...getCommonDeliveryListUrlFilterVariables(params),
    // A는 재고
    trackingNumberEmpty: [FulfillmentTrackingNumberEmptyFilter.EMPTY],
    isTrackInventoryFulfillment: true,
    deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
  };
}

export function getDeliveryListUrlBFilterVariables(
  params: OrderDeliveryListViewUrlFilters,
  isB2b: boolean,
  isByNonCourier: boolean
): FulfillmentFilterInput {
  return {
    ...getCommonDeliveryListUrlFilterVariables(params),
    // B는 위탁임.
    useDelegatedManagementForPo: isB2b ? undefined : true,
    deliveryStatus: maybe(() =>
      params.deliveryStatus.map((status) => findInEnum(status, FulfillmentDeliveryStatusFilter))
    ),
    isTrackInventoryFulfillment: false,
    deliveryMethods: isB2b
      ? [OrderDeliveryMethodsEnum.BY_COURIER, OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE]
      : isByNonCourier === false
      ? [OrderDeliveryMethodsEnum.BY_COURIER]
      : null,
    excludeDeliveryMethods: isByNonCourier ? [OrderDeliveryMethodsEnum.BY_COURIER] : null,
    purchaseOrderDate: getGteLteVariables({
      gte: params.purchaseOrderDateFrom,
      lte: params.purchaseOrderDateTo,
    }),
    askingPurchaseDate: getGteLteVariables({
      gte: params.askingPurchaseDateFrom,
      lte: params.askingPurchaseDateTo,
    }),
    expectedPurchaseDate: getGteLteVariables({
      gte: params.expectedPurchaseDateFrom,
      lte: params.expectedPurchaseDateTo,
    }),
    purchaseOrderEventType: maybe(() =>
      params.purchaseOrderEventType.map((eventType) => findInEnum(eventType, PurchaseOrderEventTypeFilter))
    ),
    purchaseOrderSearch: params.purchaseOrderSearch,
    poLineVendorOrderStatus: maybe(() =>
      params.poLineVendorOrderStatus.map((status) => findInEnum(status, PoLineVendorOrderStatusEnum))
    ),
    isB2b,
  };
}

// 협력사 관리자 > 택배 배송 확정(위탁), 화물차 배송 확정(위탁), 배송 확정(B2B)에서 사용
export function getVsDeliveryListUrlBFilterVariables(
  params: OrderDeliveryListViewUrlFilters,
  isB2b: boolean,
  isByNonCourier: boolean,
  user: User
): FulfillmentFilterInput {
  return {
    ...getDeliveryListUrlBFilterVariables(params, isB2b, isByNonCourier),
    useDelegatedManagementForPo: undefined,
    poVendorId: user.vendor.id,
  };
}

export function getDeliveryListUrlCFilterVariables(params: OrderDeliveryListViewUrlFilters): FulfillmentFilterInput {
  return {
    ...getCommonDeliveryListUrlFilterVariables(params),
    // C는 재고(기타)임.
    deliveryStatus:
      maybe(() => params.deliveryStatus.map((status) => findInEnum(status, FulfillmentDeliveryStatusFilter))) || [],
    isTrackInventoryFulfillment: true,
    deliveryMethods: maybe(() => params.deliveryMethods.map((status) => findInEnum(status, OrderDeliveryMethodsEnum))),
  };
}

export function getFilterQueryParam(filter: IFilterElement<OrderDeliveryFilterKeys>): OrderDeliveryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case OrderDeliveryFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.orderSearch);
    case OrderDeliveryFilterKeys.b2bOrderSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.b2bOrderSearch);
    case OrderDeliveryFilterKeys.paymentSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.paymentSearch);
    case OrderDeliveryFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.userSearch);
    case OrderDeliveryFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.brandSearch);
    case OrderDeliveryFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.brandStoreSearch);
    case OrderDeliveryFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.orderCreatedFrom,
        OrderDeliveryListViewUrlFiltersEnum.orderCreatedTo
      );
    case OrderDeliveryFilterKeys.orderCapturedAt:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.orderCapturedAtFrom,
        OrderDeliveryListViewUrlFiltersEnum.orderCapturedAtTo
      );
    case OrderDeliveryFilterKeys.orderCapturedAtTime:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.orderCapturedAtTimeFrom,
        OrderDeliveryListViewUrlFiltersEnum.orderCapturedAtTimeTo
      );
    case OrderDeliveryFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.createdFrom,
        OrderDeliveryListViewUrlFiltersEnum.createdTo
      );
    case OrderDeliveryFilterKeys.deliveryStartDate:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.deliveryStartDateFrom,
        OrderDeliveryListViewUrlFiltersEnum.deliveryStartDateTo
      );
    case OrderDeliveryFilterKeys.deliveryEndDate:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.deliveryEndDateFrom,
        OrderDeliveryListViewUrlFiltersEnum.deliveryEndDateTo
      );
    case OrderDeliveryFilterKeys.purchaseOrderDate:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.purchaseOrderDateFrom,
        OrderDeliveryListViewUrlFiltersEnum.purchaseOrderDateTo
      );
    case OrderDeliveryFilterKeys.askingPurchaseDate:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.askingPurchaseDateFrom,
        OrderDeliveryListViewUrlFiltersEnum.askingPurchaseDateTo
      );
    case OrderDeliveryFilterKeys.expectedPurchaseDate:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersEnum.expectedPurchaseDateFrom,
        OrderDeliveryListViewUrlFiltersEnum.expectedPurchaseDateTo
      );
    case OrderDeliveryFilterKeys.deliveryStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.deliveryStatus,
        FulfillmentDeliveryStatusFilter
      );
    case OrderDeliveryFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.productSearch);
    case OrderDeliveryFilterKeys.isNonFBV:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.isNonFBV);
    case OrderDeliveryFilterKeys.fulfillVendorSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.fulfillVendorSearch);
    case OrderDeliveryFilterKeys.purchaseOrderSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.purchaseOrderSearch);
    case OrderDeliveryFilterKeys.shippingAddress:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.shippingAddress);
    case OrderDeliveryFilterKeys.isPickingOrder:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.isPickingOrder);
    case OrderDeliveryFilterKeys.trackingNumber:
      return getSingleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersEnum.trackingNumber);
    case OrderDeliveryFilterKeys.deliveryMethods:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.deliveryMethods,
        OrderDeliveryMethodsEnum
      );
    case OrderDeliveryFilterKeys.orderType:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.orderType,
        OrderTypeEnum
      );
    case OrderDeliveryFilterKeys.purchaseOrderEventType:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.purchaseOrderEventType,
        PurchaseOrderEventTypeFilter
      );
    case OrderDeliveryFilterKeys.poLineVendorOrderStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.poLineVendorOrderStatus,
        PoLineVendorOrderStatusEnum
      );
    case OrderDeliveryFilterKeys.warehouseAddress:
      return getMultipleValueQueryParam(filter, OrderDeliveryListViewUrlFiltersWithMultipleValuesEnum.warehouseAddress);
  }
}

