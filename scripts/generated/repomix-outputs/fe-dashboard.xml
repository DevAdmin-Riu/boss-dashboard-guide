<file path="src/app/components/DeliveryFeeExcludedConfirmModal/utils.ts">
import { DeliveryFeeExcludedProduct } from "./DeliveryFeeExcludedConfirmModal";

export const hasDeliveryFeeExcludedProducts = (products: Array<{ includeSalesB2bDeliveryFee?: boolean }>): boolean =>
  products.some((product) => product.includeSalesB2bDeliveryFee === false);

export const extractDeliveryFeeExcludedProducts = <
  T extends {
    id: string;
    sku: string;
    productName: string;
    b2bDeliveryFeeExcludeVat?: number;
    includeSalesB2bDeliveryFee?: boolean;
  }
>(
  products: T[]
): DeliveryFeeExcludedProduct[] =>
  products
    .filter((product) => product.includeSalesB2bDeliveryFee === false)
    .map((product) => ({
      id: product.id,
      sku: product.sku,
      productName: product.productName,
      deliveryFee: product.b2bDeliveryFeeExcludeVat,
    }));

export const extractDeliveryFeeExcludedFromOrderLine = (orderLine: {
  id: string;
  variant: {
    sku: string;
  };
  productName: string;
  b2bDeliveryFeeExcludeVat?: number;
  brandProductVariant?: {
    includeSalesB2bDeliveryFee?: boolean;
  };
}): DeliveryFeeExcludedProduct | null => {
  if (orderLine.brandProductVariant?.includeSalesB2bDeliveryFee === false) {
    return {
      id: orderLine.id,
      sku: orderLine.variant.sku,
      productName: orderLine.productName,
      deliveryFee: orderLine.b2bDeliveryFeeExcludeVat,
    };
  }
  return null;
};
</file>

