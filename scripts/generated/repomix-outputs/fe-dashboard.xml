import { User } from "@src/api/fragments/types/User";
import { IFilter } from "@src/app/components/Filter";
import { AutocompleteFilterOpts, FilterOpts } from "@src/global/core/types/types";
import { createAutocompleteField, createTextField } from "@utils/filters/fields";

export enum ProductVariantListForReqFilterKeys {
  productSearch = "productSearch",
  makerSearch = "makerSearch",
  categories = "categories",
  attrSizeSearch = "attrSizeSearch",
  attrMaterialSearch = "attrMaterialSearch",
  attrColorSearch = "attrColorSearch",
}

export interface ProductVariantListForReqFilterOpts {
  productSearch: FilterOpts<string>;
  makerSearch: FilterOpts<string>;
  categories: FilterOpts<string[]> & AutocompleteFilterOpts;
  attrSizeSearch: FilterOpts<string>;
  attrMaterialSearch: FilterOpts<string>;
  attrColorSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: ProductVariantListForReqFilterOpts,
  user: User
): IFilter<ProductVariantListForReqFilterKeys> {
  const { isHqStaff } = user;
  const productText = isHqStaff ? "상품" : "제품";

  const productSearchFilter = {
    ...createTextField(
      0,
      ProductVariantListForReqFilterKeys.productSearch,
      `${productText}코드 / ${productText}명`,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const cetegoryFilter = {
    ...createAutocompleteField(
      0,
      ProductVariantListForReqFilterKeys.categories,
      "분류",
      opts.categories.value,
      opts.categories.displayValues,
      true,
      opts.categories.choices,
      {
        hasMore: opts.categories.hasMore,
        initialSearch: "",
        loading: opts.categories.loading,
        onFetchMore: opts.categories.onFetchMore,
        onSearchChange: opts.categories.onSearchChange,
      }
    ),
    active: opts.categories.active,
  };
  const attrSizeSearchFilter = {
    ...createTextField(0, ProductVariantListForReqFilterKeys.attrSizeSearch, "규격", opts.attrSizeSearch.value),
    active: opts.attrSizeSearch.active,
  };
  const attrMaterialSearchFilter = {
    ...createTextField(0, ProductVariantListForReqFilterKeys.attrMaterialSearch, "재질", opts.attrMaterialSearch.value),
    active: opts.attrMaterialSearch.active,
  };
  const attrColorSearchFilter = {
    ...createTextField(0, ProductVariantListForReqFilterKeys.attrColorSearch, "색상", opts.attrColorSearch.value),
    active: opts.attrColorSearch.active,
  };
  const makerSearchFilter = {
    ...createTextField(0, ProductVariantListForReqFilterKeys.makerSearch, "제조사", opts.makerSearch.value),
    active: opts.makerSearch.active,
  };

  function displayOrdering(list: any[]) {
    return list.map((item, idx) => ({ ...item, displayOrder: idx }));
  }
  return displayOrdering([
    productSearchFilter,
    cetegoryFilter,
    attrSizeSearchFilter,
    attrMaterialSearchFilter,
    attrColorSearchFilter,
    makerSearchFilter,
  ]);
}
</file>

