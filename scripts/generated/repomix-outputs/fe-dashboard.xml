<file path="src/app/components/DownloadStatsListModal/DownloadStatsListModal.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { CustomRangePickerProps } from "@src/app/components/CustomRangePicker/CustomRangePicker";
import { Button, Modal, ModalProps, PageHeader, Space } from "antd";
import React, { useState } from "react";

import { convertToDurationVariables } from "./utils";

interface DownloadStatsListModalProps {
  title: string;
  loading: boolean;
  onClose: () => void;
  onDownload: (durationVariable: string[]) => void;
  isMonthlyRange?: boolean;
}

export const DownloadStatsListModal: React.FC<ModalProps & DownloadStatsListModalProps> = (props) => {
  const { title, loading, onClose, onDownload, isMonthlyRange } = props;
  const [selectedDuration, setSelectedDuration] = useState(null);
  const reset = () => {
    setSelectedDuration(null);
  };

  const extraUi = () => (
    <Space direction="horizontal">
      <Button onClick={reset}>초기화</Button>
      <Button
        disabled={selectedDuration === null}
        loading={loading}
        type="primary"
        icon={<DownloadOutlined />}
        onClick={() => {
          const durationVariable = convertToDurationVariables(selectedDuration);
          onDownload(durationVariable);
        }}
      >
        엑셀 출력
      </Button>
    </Space>
  );

  return (
    <Modal
      width={700}
      footer={null}
      {...props}
      destroyOnClose
      closable={false}
      onCancel={() => {
        onClose();
        reset();
      }}
      title={<PageHeader title={title} extra={extraUi()} />}
    >
      <CustomRangePickerProps
        initDuration={selectedDuration}
        onChange={setSelectedDuration}
        isMonthlyRange={isMonthlyRange}
      />
    </Modal>
  );
};
</file>

<file path="src/app/components/DownloadStatsListModal/utils.ts">
import { onlyDateFormat } from "@src/app/providers/DateProvider";

export const convertToDurationVariables = (selectedDuration) => {
  if (!selectedDuration) {
    return null;
  }

  const durationVariable = [
    selectedDuration.length > 0 && selectedDuration[0] ? selectedDuration[0].format(onlyDateFormat) : null,
    selectedDuration.length > 1 && selectedDuration[1] ? selectedDuration[1].format(onlyDateFormat) : null,
  ];

  return durationVariable;
};
