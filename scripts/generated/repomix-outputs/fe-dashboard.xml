import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  categoryCreateViewPath,
  categoryDetailsViewPath,
  CategoryDetailsViewUrlQueryParams,
  categoryListViewPath,
  CategoryListViewUrlQueryParams,
  CategoryListViewUrlSortField,
} from "./urls";
import { CategoryCreateView } from "./views/CategoryCreateView";
import { CategoryDetailsView, getActiveTab } from "./views/CategoryDetailsView";
import { CategoryListView } from "./views/CategoryListView/CategoryListView";

interface CategoryDetailsViewRouteParams {
  id: string;
}
const CategoryDetailsViewWrapper: React.FC<RouteComponentProps<CategoryDetailsViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const params: CategoryDetailsViewUrlQueryParams = {
    ...qs,
    // @ts-ignore
    activeTab: getActiveTab(qs.activeTab),
  };

  return <CategoryDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

interface CategoryCreateViewRouteParams {
  id: string;
}
const CategoryCreateViewWrapper: React.FC<RouteComponentProps<CategoryCreateViewRouteParams>> = ({ match }) => (
  <CategoryCreateView parentId={match.params.id ? decodeURIComponent(match.params.id) : undefined} />
);

const CategoryListViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: CategoryListViewUrlQueryParams = {
    // @ts-ignore
    ...asSortParams(qs, CategoryListViewUrlSortField),
  };

  return <CategoryListView params={params} />;
};

const CategorySection = () => (
  <>
    <WindowTitle title={sectionNames.categories} />
    <Switch>
      <Route exact path={categoryListViewPath} component={CategoryListViewWrapper} />
      <Route exact path={categoryCreateViewPath()} component={CategoryCreateViewWrapper} />
      <Route exact path={categoryCreateViewPath(":id")} component={CategoryCreateViewWrapper} />
      <Route path={categoryDetailsViewPath(":id")} component={CategoryDetailsViewWrapper} />
    </Switch>
  </>
);

export default CategorySection;
</file>

