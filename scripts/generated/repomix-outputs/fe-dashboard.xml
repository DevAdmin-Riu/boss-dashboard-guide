  id: string;
  name: string;
}

export type TPreFounderConsultationCreateFormData = StrictOmit<PreFounderConsultationCreateInput, "preFounder">;

export const HqPreFounderConsultationCreateView: React.FC = () => {
  const navigate = useNavigator();
  // state로 전달받은 예비창업자 정보
  const { state } = useLocation<IPreFounderInfoFromDetailsPage>();
  const preFounderId = state.id;

  const [form] = Form.useForm<TPreFounderConsultationCreateFormData>();
  const TypeSafeForm = getTypeSafeForm<TPreFounderConsultationCreateFormData>(form);

  const [preFounderConsultationCreate, preFounderConsultationCreateOpts] = usePreFounderConsultationCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.preFounderConsultationCreate.errors,
        "예비창업자 상담 내역이 생성되었습니다.",
        () =>
          navigate(hqPreFounderConsultationDetailsViewUrl(data.preFounderConsultationCreate.preFounderConsultation.id))
      ),
  });

  const handleCreate = (formData: TPreFounderConsultationCreateFormData) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: PreFounderConsultationCreateInput = {
      ...formData,
      content: convertedContent,
      preFounder: preFounderId,
    };
    preFounderConsultationCreate({ variables: { input } });
  };

  const handleBack = () => navigate(hqPreFounderDetailsViewUrl(preFounderId));

  const pageLoading = preFounderConsultationCreateOpts.loading;

  if (utils.isEmpty(state)) {
    return <Redirect to={hqPreFounderListViewUrl()} />;
  }
  return (
    <>
