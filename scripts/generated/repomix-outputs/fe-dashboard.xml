      const variant = record?.variant;
      return makeProductQtyPerBoxText(variant) || "-";
    },
  };

  const makeIsTaxFreeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.product.IS_TAX_FREE,
    align: "center",
    key: "isTaxFree",
    width: 80,
    render: (_, record) => transformTaxFree(record.isTaxFree),
  };
  const makeIncludeSalesB2bDeliveryFeeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.orderLine.INCLUDE_SALES_B2B_DELIVERY_FEE,
    align: "center",
    key: "includeSalesB2bDeliveryFee",
    width: 120,
    render: (_, record) => (
      <DeliveryFeeInclusionStatus
        isIncluded={record.brandProductVariant.includeSalesB2bDeliveryFee}
        showStyles={false}
      />
    ),
    renderExcel: (record) => transformIsIncluded(record.brandProductVariant.includeSalesB2bDeliveryFee),
  };

  const makeUnitPriceExcludeVatColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: [columnNameConstant.brandProduct.SALE_PRICE, "ⓐ"],
    align: "right",
    key: "unitPriceGrossAmountExcludeVat",
    width: 100,
    render: (_, record) => (
      <NumberComponent
        value={toPricePrecisionFixed(
          record.unitPriceGrossAmount - record.unitPriceVat,
          record.variant.priceDecimalPlaces
        )}
      />
    ),
    renderExcel: (record) =>
      toPricePrecisionFixed(record.unitPriceGrossAmount - record.unitPriceVat, record.variant.priceDecimalPlaces),
    onCell: (record) => {
      if (!isEditing || isStaff === false) {
        return undefined;
      }

      const formItemName = "unitPriceExcludeVat";
      const vatFormItemName = "unitPriceVat";
      const editing = isEditing ? isEditing(record) : false;
      const precision = record.variant.priceDecimalPlaces;
      return {
        inputType: "priceWithVat",
        formItemName,
        editing,
        priceWithVatProps: {
          form,
          isTaxFree: record?.isTaxFree,
          priceExcludeVatField: {
            name: formItemName,
            inputNumberProps: { precision },
          },
          vatField: {
            name: vatFormItemName,
            inputNumberProps: { precision },
          },
        },
      };
    },
  };

  const makeOrderQtyColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: isAllRouteStatus ? columnNameConstant.orderLine.ORDER_QTY : [columnNameConstant.orderLine.ORDER_QTY, "ⓑ"],
    align: "right",
    key: "orderQty",
    width: 80,
    render: (_, record) => <NumberComponent value={record.orderedOrFulfillQty} />,
    renderExcel: (record) => record.orderedOrFulfillQty,
    onCell: (record) => {
      if (!isEditing) {
        return undefined;
      }

      const inputType = "number";
      const formItemName = "quantity";
      const editing = isEditing ? isEditing(record) : false;
      const precision = record.variant.orderQtyDecimalPlaces;

      return {
        inputType,
        formItemName,
        editing,
        precision,
      };
    },
  };

  const makeTotalProductPriceExcludeVatColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: [columnNameConstant.orderLine.BRAND_PRODUCT_TOTAL_PRICE, "ⓐxⓑ=ⓒ"],
    align: "right",
    key: "totalProductPriceExcludeVat",
    width: 100,
    render: (_, record) => {
      if (isEditing && isEditing(record)) {
        const formTotalPrice = toPriceExcludeVat(
          (formValuesWatched.unitPriceExcludeVat + formValuesWatched.unitPriceVat) * formValuesWatched.quantity,
          record.isTaxFree,
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={formTotalPrice} />;
      }
      return (
        <NumberComponent
          value={toPriceExcludeVat(
            record.unitPriceGrossAmount * record.orderedOrFulfillQty,
            record.isTaxFree,
            record.variant.priceDecimalPlaces
          )}
        />
      );
    },
    renderExcel: (record) =>
      toPriceExcludeVat(
        record.unitPriceGrossAmount * record.orderedOrFulfillQty,
        record.isTaxFree,
        record.variant.priceDecimalPlaces
      ),
  };

  const makeB2bDeliveryFeeExcludeVatExcludeVatColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> =
    {
      title: [columnNameConstant.orderLine.B2B_DELIVERY_FEE_SALE, "ⓓ"],
      align: "right",
      key: "b2bDeliveryFeeExcludeVat",
      width: 120,
      render: (_, record) => <NumberComponent value={record.b2bDeliveryFeeExcludeVat} />,
      renderExcel: (record) => record.b2bDeliveryFeeExcludeVat,
      onCell: (record) => {
        if (!isEditing || isStaff === false) {
          return undefined;
        }

        const inputType = "number";
        const formItemName = "b2bDeliveryFeeExcludeVat";
        const isB2bTackBack = record.order?.type === OrderType.BY_STAFF_FOR_B2B_TAKE_BACK;
        const editing = isEditing ? isEditing(record) : false;
        const disabled = isB2bTackBack || record.brandProductVariant.includeSalesB2bDeliveryFee;

        return {
          inputType,
          formItemName,
          editing,
          disabled,
        };
      },
    };

  const makeTotalOrderLinePriceExcludeVatColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: ["주문총액", "ⓒ+ⓓ=ⓔ"],
    align: "right",
    key: "totalOrderLinePriceExcludeVat",
    width: 100,
    render: (_, record) => {
      if (isEditing && isEditing(record)) {
        const formTotalPrice = calcOrderLineTotalPriceExcludeVat(
          formValuesWatched.unitPriceExcludeVat + formValuesWatched.unitPriceVat,
          formValuesWatched.quantity,
          formValuesWatched.b2bDeliveryFeeExcludeVat,
          record.isTaxFree,
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={formTotalPrice} />;
      }
      return (
        <NumberComponent
          value={calcOrderLineTotalPriceExcludeVat(
            record.unitPriceGrossAmount,
            record.orderedOrFulfillQty,
            record.b2bDeliveryFeeExcludeVat,
            record.isTaxFree,
            record.variant.priceDecimalPlaces
          )}
        />
      );
    },
    renderExcel: (record) =>
      calcOrderLineTotalPriceExcludeVat(
        record.unitPriceGrossAmount,
        record.orderedOrFulfillQty,
        record.b2bDeliveryFeeExcludeVat,
        record.isTaxFree,
        record.variant.priceDecimalPlaces
      ),
  };

  const makeVatAmountColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: [columnNameConstant.purchaseOrder.VAT, "ⓕ"],
    key: "vatAmount",
    align: "right",
    width: 100,
    render: (_, record) => {
      if (isEditing && isEditing(record)) {
        return (
          <NumberComponent
            value={calcOrderLineTotalVatAmount(
              formValuesWatched.unitPriceExcludeVat + formValuesWatched.unitPriceVat,
              formValuesWatched.quantity,
              record.isTaxFree,
              formValuesWatched.b2bDeliveryFeeExcludeVat,
              record.variant.priceDecimalPlaces
            )}
          />
        );
      }
      return (
        <NumberComponent
          value={calcOrderLineTotalVatAmount(
            record.unitPriceGrossAmount,
            record.orderedOrFulfillQty,
            record.isTaxFree,
            record.b2bDeliveryFeeExcludeVat,
            record.variant.priceDecimalPlaces
          )}
        />
      );
    },
    renderExcel: (record) =>
      calcOrderLineTotalVatAmount(
        record.unitPriceGrossAmount,
        record.orderedOrFulfillQty,
        record.isTaxFree,
        record.b2bDeliveryFeeExcludeVat,
        record.variant.priceDecimalPlaces
      ),
  };

  const makeTotalPriceColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: [columnNameConstant.tax.TOTAL_AMOUNT, "ⓔ+ⓕ"],
    key: "totalPrice",
    align: "right",
    width: 100,
    render: (_, record) => {
      if (isEditing && isEditing(record)) {
        const formTotalPrice = calcOrderLineTotalPrice(
          formValuesWatched.unitPriceExcludeVat + formValuesWatched.unitPriceVat,
          formValuesWatched.quantity,
          record.isTaxFree,
          formValuesWatched.b2bDeliveryFeeExcludeVat,
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={formTotalPrice} />;
      }
      return (
        <NumberComponent
          value={calcOrderLineTotalPrice(
            record.unitPriceGrossAmount,
            record.orderedOrFulfillQty,
            record.isTaxFree,
            record.b2bDeliveryFeeExcludeVat,
            record.variant.priceDecimalPlaces
          )}
        />
      );
    },
    renderExcel: (record) =>
      calcOrderLineTotalPrice(
        record.unitPriceGrossAmount,
        record.orderedOrFulfillQty,
        record.isTaxFree,
        record.b2bDeliveryFeeExcludeVat,
        record.variant.priceDecimalPlaces
      ),
  };

  const makeButtonWrapColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: "",
    key: "",
    align: "center",
    width: 120,
    fixed: utils.fixedRightFlag(),
    render: (_, record) => {
      const editable = isEditing(record);
      const b2bStatus = record.b2bStatus;
      const isShowUpdateBtn =
        (isExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.PENDING, OrderLineB2bStatusEnum.REJECTED]) &&
          isStaff) ||
        (isExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.REJECTED]) && !isStaff);
      const isShowRejectBtn = isNotExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.REJECTED]) && isStaff;
      const isShowReceiveBtn = isNotExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.REJECTED]);
      const isShowPendingBtn = isExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.REJECTED]);
      const isHideButtonStatus = isNotExistOrderLineB2bStatusIn(b2bStatus, [
        OrderLineB2bStatusEnum.RECEIVED,
        OrderLineB2bStatusEnum.CANCELED,
      ]);
      const isShowCancelBtn =
        (isExistOrderLineB2bStatusIn(b2bStatus, [OrderLineB2bStatusEnum.REJECTED]) && isHideButtonStatus) || isStaff;

      const btnDisabled = loading || !utils.isEmpty(selectedRowId);

      const UpdateButton = () =>
        editable ? (
          <Space size={"small"}>
            <Button
              size="small"
              type={"primary"}
              loading={loading}
              disabled={utils.isEmpty(selectedRowId)}
              onClick={() => onSubmit(record.order.type, record)}
            >
              저장
            </Button>
            <Button size="small" type={"default"} onClick={onCancel}>
              취소
            </Button>
          </Space>
        ) : (
          <Button size="small" disabled={btnDisabled} onClick={() => onEdit(record)}>
            수정
          </Button>
        );

      const ReceiveButton = () => (
        <Popconfirm
          title={makeB2bOrderPopupConfirmNode(record, "접수", "해당 제품을 접수하시겠습니까?")}
          onConfirm={() => {
            const pricePrecision = record.variant.priceDecimalPlaces;
            const orderQtyPrecision = record.variant.orderQtyDecimalPlaces;
            onOrderLinesB2bReceive({
              details: [
                {
                  orderLineId: record.id,
                  qty: toPricePrecisionFixed(record.orderedOrFulfillQty, orderQtyPrecision),
                  unitPrice: toPricePrecisionFixed(record.unitPriceGrossAmount, pricePrecision),
                  unitPriceVat: toPricePrecisionFixed(record.unitPriceVat, pricePrecision),
                  b2bDeliveryFeeExcludeVat: record.b2bDeliveryFeeExcludeVat,
                },
              ],
            });
          }}
          placement={"topRight"}
          disabled={btnDisabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} disabled={btnDisabled}>
            접수
          </Button>
        </Popconfirm>
      );

      const CancelButton = () => (
        <Popconfirm
          title={makeB2bOrderPopupConfirmNode(record, "취소", "해당 제품을 취소하시겠습니까?")}
          onConfirm={() => onOrderLinesB2bCancel([record.id])}
          placement={"topRight"}
          disabled={btnDisabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} danger disabled={btnDisabled}>
            취소
          </Button>
        </Popconfirm>
      );
      const RejectButton = () => (
        <Button
          size="small"
          type={"primary"}
          danger
          disabled={btnDisabled}
          onClick={() => {
            openModal("b2b-order-lines-reject");
            setSelectedRowId(record.id);
          }}
          style={{
            background: btnDisabled ? "#f5f5f5" : "#ffe58f",
            color: btnDisabled ? "rgba(0, 0, 0, 0.25)" : "#333",
          }}
        >
          거부
        </Button>
      );

      const PendingButton = () => (
        <Popconfirm
          title={makeB2bOrderPopupConfirmNode(record, "재접수 요청", "해당 제품을 재접수 요청하시겠습니까?")}
          onConfirm={() => onOrderLinesB2bPending([record.id])}
          placement={"topRight"}
          disabled={btnDisabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} disabled={btnDisabled}>
            재요청
          </Button>
        </Popconfirm>
      );

      return (
        <Space direction="horizontal">
          {!editable && isStaff && isShowReceiveBtn && <ReceiveButton />}
          {isShowUpdateBtn && <UpdateButton />}
          {!editable && isShowPendingBtn && <PendingButton />}
          {!editable && isShowRejectBtn && <RejectButton />}
          {!editable && isShowCancelBtn && (
            <>
              <span style={{ width: 1, height: 20, borderRight: "1px solid #d9d9d9" }}></span>
              <CancelButton />
            </>
          )}
        </Space>
      );
    },
    isPickerHide: true,
    doNotRenderExcel: true,
  };

  const makeBrandCodeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.brand.CLIENT_COMPANY_CODE,
    align: "center",
    key: "brandCode",
    width: 100,
    render: (_, record) => record?.order?.user?.brand?.code || "-",
  };

  const makeBrandNameColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.brand.CLIENT_COMPANY_NAME,
    key: "brandName",
    width: 150,
    render: (_, record) => record?.order?.user?.brand?.name || "-",
  };
  const makePoLeadTimeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.common.LEAD_TIME,
    key: "poLeadTime",
    align: "center",
    width: 90,
    render: (_, record) => makePOLeadTimeFormat(record.variant.poLeadTime),
  };

  const vendorCodeColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.vendor.CODE,
    align: "center",
    key: "vendorCode",
    width: 100,
    render: (_, record) => makeVendorDataFromOrderLine(record)?.code || "-",
  };
  const vendorNameColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.vendor.VENDOR_NAME,
    align: "left",
    key: "vendorName",
    width: 150,
    render: (_, record) => makeVendorDataFromOrderLine(record)?.name || "-",
  };

  const makeDeliveryWarehouseManagerCol = (): DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> => ({
    title: "담당자",
    align: "center",
    key: "deliveryWarehouseName",
    width: 120,
    render: (_, record) => record.order?.shippingAddress?.firstName || "-",
  });

  const makeDeliveryWarehouseManagerPhoneCol =
    (): DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> => ({
      title: "연락처",
      align: "center",
      key: "managerPhone",
      width: 180,
      render: (_, record) => transformPhoneNumber(record.order?.shippingAddress?.phone),
    });

  const makeDeliveryWarehouseAddressCol = (): DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> => ({
    title: "주소",
    align: "center",
    key: "deliveryWarehouseAddress",
    width: 220,
    render: (_, record) => transformAddress(record.order?.shippingAddress),
  });

  const makeB2bStatusHistoriesCol = (
    title: string,
    afterStatus: OrderLineB2bStatusEnum,
    width: number = 120
  ): DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> => ({
    title,
    key: `b2bStatusHistories-${afterStatus}`,
    align: "center",
    width,
    render: (_, record) => {
      const findStatus = record?.b2bStatusHistories?.findIndex((item) => item.afterStatus === afterStatus);
      if (utils.isEmpty(findStatus) || findStatus === -1) {
        return "-";
      }

      return getDateByFormat(record?.b2bStatusHistories[findStatus].createdAt);
    },
  });

  const brandInfoColumns: DownloadableEditableColumnsType<OrderLineList_orderLines_edges_node> = [
    makeBrandCodeColumn,
    makeBrandNameColumn,
  ];
  const vendorInfoColumns: DownloadableEditableColumnsType<OrderLineList_orderLines_edges_node> = [
    vendorCodeColumn,
    vendorNameColumn,
  ];
  const orderPriceInfoColumns: DownloadableEditableColumnsType<OrderLineList_orderLines_edges_node> = [
    makeUnitPriceExcludeVatColumn, // 판매가
    makeOrderQtyColumn, // 주문수량
    makeTotalProductPriceExcludeVatColumn, // 상품금액
    makeB2bDeliveryFeeExcludeVatExcludeVatColumn, // B2B 배송비
    makeTotalOrderLinePriceExcludeVatColumn, // 주문총액
    makeVatAmountColumn, // 부가세
    makeTotalPriceColumn, // 총 합계
  ];
  const addressInfoColumns: DownloadableEditableColumnsType<OrderLineList_orderLines_edges_node> = [
    makeDeliveryWarehouseManagerCol(), // 담당자
    makeDeliveryWarehouseManagerPhoneCol(), // 연락처
    makeDeliveryWarehouseAddressCol(), // 주소
  ];

  const b2bStatusHistoriesColumns: DownloadableEditableColumnsType<OrderLineList_orderLines_edges_node> = [
    makeOrderCreatedColumn, // 주문일
    makeB2bStatusHistoriesCol("주문 거부일", OrderLineB2bStatusEnum.REJECTED),
    makeB2bStatusHistoriesCol("주문 접수일", OrderLineB2bStatusEnum.RECEIVED),
    makeB2bStatusHistoriesCol("출고 지시일", OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT),
    makeB2bStatusHistoriesCol("주문 완료일", OrderLineB2bStatusEnum.COMPLETED),
    makeB2bStatusHistoriesCol("주문 취소일", OrderLineB2bStatusEnum.CANCELED),
  ];

  let columns = [
    makeOrderComposedIdColumn, // 주문정보
    makeOrderLineComposedIdColumn, // 주문상세정보
    {
      title: "주문 정보",
      children: [
        isAllRouteStatus === false && makeOrderCreatedColumn, // 주문일
        makeEstimatedArrivalDateColumn, // 납품요청일
        (isAllRouteStatus || isCompletedRouteStatus || isProcessingRouteStatus || isDeliveryRouteStatus) &&
          makeExpectedPurchaseDateColumn, // 납품예정일
        isAcceptRouteStatus && makeB2bStatusColumn, // 주문 진행 상태
        isCompletedRouteStatus && makeB2bStatusHistoriesCol("배송 완료일시", OrderLineB2bStatusEnum.COMPLETED), // 주문완료일시랑 동일하게 사용 이름만 다름
        (isStaff || isPendingOrRejectedRouteStatus) && makeB2bRejectReasonColumn, // 거부사유
        makeB2bCustomerNoteColumn, // 요청사유
      ].filter(Boolean),
    },
    isStaff && {
      title: "고객사 정보",
      children: brandInfoColumns,
    },
    {
      title: isStaff ? "제품 정보" : "상품 정보",
      children: [
        isStaff && makeProductSkuColumn, // 제품코드
        isStaff && makeProductNameColumn, // 제품명
        makeBpSkuColumn, // 상품코드
        makeBrandProductNameColumn, // 상품명
        makeVariantNameColumn, // 옵션명
        makeAttributesColumn, // 상세정보
        makeAttrQuantityColumn, // 입수량
        makePoLeadTimeColumn, // L/T
        makeIsTaxFreeColumn, // 과세여부
        makeIncludeSalesB2bDeliveryFeeColumn, // 판매가 배송비 포함
      ].filter(Boolean),
    },
    isStaff && {
      title: "협력사 정보",
      children: vendorInfoColumns,
    },
    {
      title: "주문 금액 정보",
      children: orderPriceInfoColumns,
    },
    {
      title: "납품 정보",
      children: addressInfoColumns,
    },
    makeOrderTypeColumn, // 주문 타입
    (isAcceptRouteStatus || isPendingOrRejectedRouteStatus) && makeButtonWrapColumn,
  ].filter(Boolean);

  if (isAllRouteStatus) {
    columns = columns.concat(b2bStatusHistoriesColumns);
  }

  return columns;
}
</file>

<file path="src/app/views/b2b/components/B2bOrderLineListPage/filter.ts">
import filterMsg from "@assets/messages/filters";
import { OrderLineB2bStatusEnum, OrderTypeEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import {
  OrderLineListFilterKeys,
  OrderLineListFilterOpts,
} from "@src/app/views/order/orders/components/OrderLineListPage/filters";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { B2bOrderLineListViewRouteParams } from "../../urls";

export function createFilterStructure(
  opts: OrderLineListFilterOpts,
  routeParams: B2bOrderLineListViewRouteParams,
  isStaff: boolean
): IFilter<OrderLineListFilterKeys> {
  const isAllRouteStatus = routeParams.status === "all";
  const isAcceptRouteStatus = routeParams.status === "accept";
  const isPendingOrRejectedRouteStatus = routeParams.status === "pending-or-rejected";
  const isProcessingRouteStatus = routeParams.status === "processing";
  const isDeliveryRouteStatus = routeParams.status === "delivery";
  const isCompletedRouteStatus = routeParams.status === "completed";

  const orderTypeFilter = {
    ...createOptionsField(0, OrderLineListFilterKeys.orderType, "주문 구분", opts.orderType.value, true, [
      {
        label: "B2B 주문",
        value: OrderTypeEnum.BY_STAFF_FOR_B2B,
      },
      {
        label: "B2B 반품",
        value: OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK,
      },
    ]),
    active: opts.orderType.active,
    isRequired: true,
  };
  const b2bStatusFilter = {
    ...createOptionsField(
      0,
      OrderLineListFilterKeys.b2bStatus,
      "주문 진행 상태",
      opts.b2bStatus.value,
      true,
      [
        {
          label: "접수대기",
          value: OrderLineB2bStatusEnum.PENDING,
        },
        {
          label: "거부",
          value: OrderLineB2bStatusEnum.REJECTED,
        },
        isAllRouteStatus && {
          label: "접수",
          value: OrderLineB2bStatusEnum.RECEIVED,
        },
        isAllRouteStatus && {
          label: "처리중",
          value: OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT,
        },
        isAllRouteStatus && {
          label: "완료",
          value: OrderLineB2bStatusEnum.COMPLETED,
        },
        isAllRouteStatus && {
          label: "취소",
          value: OrderLineB2bStatusEnum.CANCELED,
        },
      ].filter(Boolean)
    ),
    active: opts.b2bStatus.active,
    isRequired: true,
  };

  const b2bOrderSearchFilter = {
    ...createTextField(
      0,
      OrderLineListFilterKeys.b2bOrderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.b2bOrderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.b2bOrderSearch.active,
  };

  const brandSearchFilter = {
    ...createTextField(
      0,
      OrderLineListFilterKeys.brandSearch,
      filterNameConstant.BRAND_SEARCH_FOR_B2B,
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const purchaseVendorSearchFilter = {
    ...createTextField(
      0,
      OrderLineListFilterKeys.purchaseVendorSearch,
      filterNameConstant.VENDOR_SEARCH,
      opts.purchaseVendorSearch.value
    ),
    active: opts.purchaseVendorSearch.active,
  };

  const orderCreatedFilter = {
    ...createDateField(0, OrderLineListFilterKeys.orderCreated, filterMsg.orderCreated, opts.orderCreated.value),
    active: opts.orderCreated.active,
  };
  const expectedPurchaseDateFilter = {
    ...createDateField(
      0,
      OrderLineListFilterKeys.expectedPurchaseDate,
      filterMsg.poLineExpectedPurchaseDate,
      opts.expectedPurchaseDate.value
    ),
    active: opts.expectedPurchaseDate.active,
  };
  const orderEstimatedArrivalFilter = {
    ...createDateField(
      0,
      OrderLineListFilterKeys.orderEstimatedArrivalDate,
      filterMsg.poLineAskingPurchaseDate,
      opts.orderEstimatedArrivalDate.value
    ),
    active: opts.orderEstimatedArrivalDate.active,
  };

  const productSearchFilter = {
    ...createTextField(
      0,
      OrderLineListFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      0,
      OrderLineListFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };

  const b2bReceivedStatusAtFilter = {
    ...createDateField(0, OrderLineListFilterKeys.b2bReceivedStatusAt, "주문 접수일", opts.b2bReceivedStatusAt.value),
    active: opts.b2bReceivedStatusAt.active,
  };
  const b2bRejectedStatusAtFilter = {
    ...createDateField(0, OrderLineListFilterKeys.b2bRejectedStatusAt, "주문 거부일", opts.b2bRejectedStatusAt.value),
    active: opts.b2bRejectedStatusAt.active,
  };
  const b2bCanceledStatusAtFilter = {
    ...createDateField(0, OrderLineListFilterKeys.b2bCanceledStatusAt, "주문 취소일", opts.b2bCanceledStatusAt.value),
    active: opts.b2bCanceledStatusAt.active,
  };
  const b2bCompletedStatusAtFilter = {
    ...createDateField(0, OrderLineListFilterKeys.b2bCompletedStatusAt, "주문 완료일", opts.b2bCompletedStatusAt.value),
    active: opts.b2bCompletedStatusAt.active,
  };

  if (isAllRouteStatus) {
    return utils.filterDisplayOrdering(
      [
        orderTypeFilter,
        b2bStatusFilter,
        b2bOrderSearchFilter,
        isStaff && brandSearchFilter,
        isStaff && productSearchFilter,
        brandProductSearchFilter,
        isStaff && purchaseVendorSearchFilter,
        orderCreatedFilter,
        b2bReceivedStatusAtFilter,
        b2bRejectedStatusAtFilter,
        b2bCanceledStatusAtFilter,
        b2bCompletedStatusAtFilter,
      ].filter(Boolean)
    );
  }
  return utils.filterDisplayOrdering(
    [
      orderTypeFilter,
      (isAcceptRouteStatus || isPendingOrRejectedRouteStatus) && b2bStatusFilter,
      b2bOrderSearchFilter,
      orderCreatedFilter,
      orderEstimatedArrivalFilter,
      (isProcessingRouteStatus || isDeliveryRouteStatus || isCompletedRouteStatus) && expectedPurchaseDateFilter,
      isStaff && productSearchFilter,
      brandProductSearchFilter,
      isStaff && purchaseVendorSearchFilter,
      isStaff && brandSearchFilter,
    ].filter(Boolean)
  );
}
</file>

<file path="src/app/views/b2b/components/B2bOrderLineListPage/utils.ts">
import { OrderLineB2bStatusEnum } from "@src/api/types/globalTypes";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";

export const getStatusLabel = (value: OrderLineB2bStatusEnum): string => {
  switch (value) {
    case "PENDING":
      return "접수대기";
    case "REJECTED":
      return "거부";
    case "RECEIVED":
      return "접수";
    case "DISPATCH_FULFILLMENT":
      return "처리중";
    case "COMPLETED":
      return "완료";
    case "CANCELED":
      return "취소";
    default:
      return "-";
  }
};

export const isExistOrderLineB2bStatusIn = (
  nowB2bStatus: OrderLineB2bStatusEnum,
  b2bStatus: OrderLineB2bStatusEnum[]
): boolean => b2bStatus.includes(nowB2bStatus);

export const isNotExistOrderLineB2bStatusIn = (
  nowB2bStatus: OrderLineB2bStatusEnum,
  b2bStatus: OrderLineB2bStatusEnum[]
): boolean => !b2bStatus.includes(nowB2bStatus);

export const calcOrderLineTotalPriceExcludeVat = (
  unitPrice: number,
  qty: number,
  b2bDeliveryFeeExcludeVat: number,
  isTaxFree: boolean,
  precision: number
) => toPriceExcludeVat(unitPrice * qty, isTaxFree, precision) + b2bDeliveryFeeExcludeVat;

export const calcOrderLineTotalPrice = (
  unitPrice: number,
  qty: number,
  isTaxFree: boolean,
  b2bDeliveryFeeExcludeVat: number,
  precision: number
) => {
  if (isTaxFree) {
    return (
      calcOrderLineTotalPriceExcludeVat(unitPrice, qty, b2bDeliveryFeeExcludeVat, isTaxFree, precision) +
      calcOrderLineTotalVatAmount(unitPrice, qty, isTaxFree, b2bDeliveryFeeExcludeVat, precision)
    );
  } else {
    return toPriceIncludeVat(
      calcOrderLineTotalPriceExcludeVat(unitPrice, qty, b2bDeliveryFeeExcludeVat, isTaxFree, precision)
    );
  }
};

export const calcOrderLineDeliveryFeeVatAmount = (b2bDeliveryFeeExcludeVat: number) =>
  toPriceIncludeVat(b2bDeliveryFeeExcludeVat) - b2bDeliveryFeeExcludeVat;

export const calcOrderLineTotalVatAmount = (
  unitPrice: number,
  qty: number,
  isTaxFree: boolean,
  b2bDeliveryFeeExcludeVat: number,
  precision: number
) => {
  if (isTaxFree) {
    return calcOrderLineDeliveryFeeVatAmount(b2bDeliveryFeeExcludeVat);
  }
  return (
    calcOrderLineTotalPrice(unitPrice, qty, isTaxFree, b2bDeliveryFeeExcludeVat, precision) -
    calcOrderLineTotalPriceExcludeVat(unitPrice, qty, b2bDeliveryFeeExcludeVat, isTaxFree, precision)
  );
};

export const isB2bStatusReceiveAfterStatus = (nowB2bStatus: OrderLineB2bStatusEnum) =>
  isExistOrderLineB2bStatusIn(nowB2bStatus, [
    OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT,
    OrderLineB2bStatusEnum.COMPLETED,
  ]);
</file>

