} from "@src/api/types/globalTypes";
import { TProductInfoNotiData } from "@src/app/components/ProductInfoNoti";
import {
  ProductDetails_product,
  ProductDetails_product_outerVariants_inspectReportTemplate,
} from "@src/app/views/product/products/api/types/ProductDetails";
import {
  getAttributeInputFromProductAttributes,
  getProductUpdatePageFormData,
} from "@src/app/views/product/products/utils/data";
