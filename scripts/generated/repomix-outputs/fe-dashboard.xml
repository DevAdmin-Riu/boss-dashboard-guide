type getOrderDeliveryTrackingStatusTextType = Pick<
  FulfillmentAllList_fulfillments_edges_node,
  "status" | "isTrackingCompleted" | "trackingNumber"
>;
export const getOrderDeliveryTrackingStatusText = (fulfillment: getOrderDeliveryTrackingStatusTextType) => {
  const status = fulfillment.status;
  if (status === FulfillmentStatus.FULFILLED) {
    const isTrackingCompleted = !!fulfillment?.isTrackingCompleted;
    if (isTrackingCompleted === true) {
      return "배송 완료";
    } else {
      const trackingNumberExist = !utils.isEmpty(fulfillment?.trackingNumber, true);
      if (trackingNumberExist === true) {
        return "배송 중";
      } else {
        return "배송 준비 중";
      }
    }
  }
  if (status === FulfillmentStatus.REFUNDED) {
    return "반품";
  }
  if (status === FulfillmentStatus.CANCELED) {
    return "교환";
  }
  return "";
};

const deliveryKeysToMerge = {
  date: "[일자]",
  product: "[상품정보]",
  customer: "[주문자]",
  delivery: "[배송정보]",
};

export const parseAllFulfillments = (resFulfillment: ApolloQueryResult<FulfillmentAllList>) => {
  const fulfillmentData = resFulfillment.data?.fulfillments?.edges?.map((edge) => edge.node);
  const organizedData = makeDeliveryAllListTableDataType(fulfillmentData);

  const columns = [];
  organizedData.forEach((data) => {
    const row = makeOneRow(data);
    columns.push(row);
    // 2개 이상인 경우 lines가 존재함.(makeDeliveryAllListTableDataType에서 처리)
    if (data.children) {
      data.children.forEach((line) => {
        const lineRow = makeOneRow(line);
        columns.push(lineRow);
      });
    }
  });
  if (!columns || columns.length === 0) {
    return { columns: [], header: [], merges: [] };
  }
  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
};

// 출고된 상품이 배송 중인지 체크
export const checkFulfillmentDeliveryTracking = (fulfillment: getOrderDeliveryTrackingStatusTextType) => {
  const status = fulfillment.status;
  const isTrackingCompleted = !!fulfillment?.isTrackingCompleted;
  if (status === FulfillmentStatus.FULFILLED && !isTrackingCompleted) {
    const trackingNumberExist = !utils.isEmpty(fulfillment?.trackingNumber, true);
    return trackingNumberExist;
  }
  return false;
};

export function getPrintDeliveryAllListQueryVariables(
  params: OrderDeliveryListViewUrlQueryParams
): FulfillmentAllListVariables {
  return {
    after: "",
    first: GrapheneRelayConnectionMaxLimitEnum.reportDeliveryAllList,
    filter: getDeliveryAllListUrlFilterVariables(params),
    sort: getDeliveryListSortQueryVariables(params),
  };
}

const makeOneRow = (data: DeliveryAllListTableDataType) => {
  const makeDateText = (date: string) => (date ? moment(date).format(onlyDateFormat) : "-");

  const fulfillmentComposedId = data.fulfillmentComposedIdWithPrefix;
  const orderLineComposedId = data.orderLineComposedIdWithPrefix;

  const orderCreated = makeDateText(data.orderCreated);
  const orderCapturedAt = makeDateText(data.orderCapturedAt);
  const fulfillmentCreated = makeDateText(data.created);
  const deliveryStartDate = makeDateText(data.deliveryStartDate);
  const deliveryEndDate = makeDateText(data.deliveryEndDate);

  const sku = data?.orderLine?.productSku || "-";
  const productName = data?.orderLine?.variant.product.name || "-";
  const variant = data?.orderLine?.variant;
  const product = variant?.product;
  const hasVariants = product?.productType.hasVariants;
  const targetAttributes = hasVariants ? variant?.attributes : product?.attributes;
  const productVariantAttributes = makeProductSpecTextFromAttr(targetAttributes) || "-";
  const productVariantAttributeQuantity =
    Math.max(1, utils.convertToNumberWrapper(makeProductQtyPerBoxText(variant))) || "-";

  const brandCode = data.userBrandCode ? data.userBrandCode : "-";
  const brandName = data.userBrandName ? data.userBrandName : "-";
  const loginId = data.userLoginid ? data.userLoginid : "-";
  const firstName = data.userFirstName ? data.userFirstName : "-";
  const openMallName = data?.etcInfo.open_mall_name ? data.etcInfo.open_mall_name : "-";
  const openMallOrderNumber = data?.etcInfo.open_mall_order_number ? data.etcInfo.open_mall_order_number : "-";

  const deliveryMethod = convertDeliveryTypeEnumToWord(data.deliveryMethod);
  const isPickingOrder = transformIsPickingOrder(data.isPickingOrder);
  const fulfillmentType = makeTagFulfillmentTypeText(
    data.orderLine?.trackInventory,
    data.orderLine?.isFulfilledByVendor,
    false,
    data.orderLine.isMixedTrackInventory,
    data.orderLine.variant.isVendorTrackInventory
  );
  const pickingLineStatus = transformPickingLineStatus(data.pickingLineStatus);
  const trackingStatus = data.trackingStatus || "-";
  const pickingLocationsText = getFulfilledLocationsText(data);
  const pickingLocation = pickingLocationsText;

  const quantity = data.quantity || "-";
  const courierName = data?.courier ? data?.courier?.name : "-";
  const trackingNumber = data?.trackingNumber || "-";
  const etcDeliveryVehicle = data.etcDeliveryManInfo?.vehicle || "-";
  const etcDeliveryManContact = data.etcDeliveryManInfo?.contact || "-";

  const contact = data.addressContact;
  const addressName = data?.addressFirstName;
  const orderAddress = data.orderAddress;
  const staffNote = data.staffNote || "-";

  return {
    [columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID]: fulfillmentComposedId,
    [columnNameConstant.order.ORDER_LINE_COMPOSED_ID]: orderLineComposedId,
    // 일자
    [deliveryKeysToMerge.date + newLineStr(columnNameConstant.order.ORDER_DATE)]: orderCreated,
    [deliveryKeysToMerge.date + newLineStr(columnNameConstant.order.CAPTURED_DATE)]: orderCapturedAt,
    [deliveryKeysToMerge.date + newLineStr(columnNameConstant.delivery.FULFILLMENT_DATE)]: fulfillmentCreated,
    [deliveryKeysToMerge.date + newLineStr(columnNameConstant.delivery.DELIVERY_START_DATE)]: deliveryStartDate,
    [deliveryKeysToMerge.date + newLineStr(columnNameConstant.delivery.DELIVERY_DONE_DATE)]: deliveryEndDate,
    // 상품정보
    [deliveryKeysToMerge.product + newLineStr(columnNameConstant.product.SKU)]: sku,
    [deliveryKeysToMerge.product + newLineStr(columnNameConstant.product.PRODUCT_NAME)]: productName,
    [deliveryKeysToMerge.product + newLineStr(columnNameConstant.product.DETAIL_INFO)]: productVariantAttributes,
    [deliveryKeysToMerge.product + newLineStr(columnNameConstant.product.PRODUCT_QTY_PER_BOX)]:
      productVariantAttributeQuantity,
    // 주문자
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.user.ID)]: loginId,
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.user.USER_NAME)]: firstName,
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.brand.BRAND_CODE)]: brandCode,
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.brand.BRAND_NAME)]: brandName,
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.order.OPEN_MALL_NAME)]: openMallName,
    [deliveryKeysToMerge.customer + newLineStr(columnNameConstant.order.OPEN_MALL_ORDER_NO)]: openMallOrderNumber,
    // 배송정보
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_METHOD)]: deliveryMethod,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.IS_PICKING_ORDER)]: isPickingOrder,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.order.FULFILLMENT_TYPE)]: fulfillmentType,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.fulfillment.PICKING_STATUS)]: pickingLineStatus,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_STATUS)]: trackingStatus,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.FULFILLMENT_LOCATION)]: pickingLocation,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_AMOUNT)]: quantity,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_NAME)]: addressName,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.PHONE)]: contact,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_ADDRESS)]: orderAddress,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.COURIER_NAME)]: courierName,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.TRACKING_NO)]: trackingNumber,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_VEHICLE_INFO)]: etcDeliveryVehicle,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.delivery.DELIVERY_MAN_CONTACT)]:
      etcDeliveryManContact,
    [deliveryKeysToMerge.delivery + newLineStr(columnNameConstant.order.STAFF_NOTE)]: staffNote,
  };
};
