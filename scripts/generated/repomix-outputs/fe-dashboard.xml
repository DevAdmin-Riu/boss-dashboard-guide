export const ProductListView: React.FC<ProductListViewProps> = ({ params }) => {
  const isFulfilledByVendor = false;
  const shop = useShop();
  const { localizedDefaultCurrency, allCountries } = shop;
  const targetUrl = productListViewUrlA;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PRODUCT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useProductListFilterDownloadQuery);
  const [modalMode, setModalMode] = React.useState<ProductListModalModeEnum>(null);
  const resetForCloseModal = () => {
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: ProductListModalModeEnum) => {
    setModalMode(modalMode);
  };

  const currencySymbol = maybe(() => localizedDefaultCurrency, "원");
  const filter = { ...getFilterVariables(params), isFulfilledByVendor };
  const sort = getSortQueryVariables(params);
  const queryVariables: ProductListVariables = React.useMemo<ProductListVariables>(
    () => ({ ...paginationState, filter, sort }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useProductListQuery({ initialListSkip: true, variables: queryVariables });

  const { data: availableInGridAttributeData, loading: availableInGridAttributesLoading } =
    useAvailableInGridAttributesQuery({ variables: { first: GrapheneRelayConnectionMaxLimitEnum.attributes } });
  // 박스타입(재고) 속성은 직거래 상품 리스트인 경우에 제외
  const attrSlugsToExclude = [];
  const availableInGridAttributes = maybe(
    () => availableInGridAttributeData.availableInGrid.edges.map((edge) => edge.node),
    []
  );
  const filteredAvailableInGridAttributes = availableInGridAttributes.filter(
    (attr) => !attrSlugsToExclude.includes(attr.slug as AttributeSlugEnum)
  );
  const filteredTotalGridAttributes = maybe(() => filteredAvailableInGridAttributes.length, 0);

  const clonedData: ProductList = utils.deepCopy(data);
  const { data: initialFilterData } = useInitialProductFilterDataQuery({
    variables: {
      categories: params.categories,
      collections: params.collections,
      productTypes: params.productTypes,
    },
  });
  const searchCategories = useCategorySearch({ variables: { ...DEFAULT_INITIAL_SEARCH_DATA } });
  const searchCollections = useCollectionSearch({ variables: { ...DEFAULT_INITIAL_SEARCH_DATA } });
  const searchProductTypes = useProductTypeSearch({ variables: { ...DEFAULT_INITIAL_SEARCH_DATA } });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.products?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<ProductListViewUrlDialog, ProductListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = (field: ProductListViewUrlSortField, attributeId?: string) =>
    navigate(
      targetUrl({
        ...params,
        ...getSortUrlVariables(field, params),
        attributeId,
        ...DEFAULT_INITIAL_PAGINATION_DATA,
      })
    );

  const initialFilterAttributes = maybe(() => initialFilterData.attributes.edges.map((edge) => edge.node), []);
  const initialFilterCategories = maybe(() => initialFilterData.categories.edges.map((edge) => edge.node), []);
  const initialFilterCollections = maybe(() => initialFilterData.collections.edges.map((edge) => edge.node), []);
  const initialFilterProductTypes = maybe(() => initialFilterData.productTypes.edges.map((edge) => edge.node), []);
  const filterOpts = getFilterOpts(
    params,
    initialFilterAttributes,
    { initial: initialFilterCategories, search: searchCategories },
    { initial: initialFilterCollections, search: searchCollections },
    { initial: initialFilterProductTypes, search: searchProductTypes }
  );

  return (
    <>
      <WindowTitle title={sectionNames.productsA} />
      <ProductListPage
        isFulfilledByVendor={isFulfilledByVendor}
        activeAttributeSortId={params.attributeId}
        sort={{ asc: params.asc, sort: params.sort }}
        onSort={handleSort}
        availableInGridAttributes={filteredAvailableInGridAttributes}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        defaultSettings={defaultListSettings[ListViews.PRODUCT_LIST]}
        filterOpts={filterOpts}
        totalGridAttributes={filteredTotalGridAttributes}
        settings={settings}
        loading={loading || availableInGridAttributesLoading}
        onAdd={() => navigate(productCreateViewUrl({ isFulfilledByVendor }))}
        disabled={loading}
        products={maybe(() => clonedData.products.edges.map((edge) => edge.node))}
        shop={shop}
        onProductVariantBulkUpdateOrCreate={(isB2b) =>
          openModalWithoutNavigate(
            isB2b
              ? ProductListModalModeEnum.B2bBulkUpdateOrCreateProductVariant
              : ProductListModalModeEnum.BulkUpdateOrCreateProductVariant
          )
        }
        onProductListDownload={() => openModalWithoutNavigate(ProductListModalModeEnum.DownloadProductList)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(productUpdateViewUrl(id))}
        onAll={resetFilters}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <ProductVariantBulkUpdateOrCreateModal
        open={
          modalMode === ProductListModalModeEnum.BulkUpdateOrCreateProductVariant ||
          modalMode === ProductListModalModeEnum.B2bBulkUpdateOrCreateProductVariant
        }
        loading={loading}
        isFulfilledByVendor={isFulfilledByVendor}
        attributes={initialFilterAttributes}
        onClose={resetForCloseModal}
        allCountries={allCountries}
        isB2bMode={modalMode === ProductListModalModeEnum.B2bBulkUpdateOrCreateProductVariant}
      />
      <DownloadProductListModal
        open={modalMode === ProductListModalModeEnum.DownloadProductList}
        loading={loading}
        isFulfilledByVendor={isFulfilledByVendor}
        shop={shop}
        onClose={resetForCloseModal}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
