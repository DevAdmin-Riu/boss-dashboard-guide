<file path="src/app/views/order/orders/components/OrderDeliveryListPage/OrderDeliveryListPage.tsx">
import { DownloadOutlined, DownOutlined, UpOutlined } from "@ant-design/icons";
import { ApolloQueryResult, MutationFunction } from "@apollo/client";
import useNavigator from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import { OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { commonTableProps, DownloadableColumnType, getTableClassName } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ColumnPicker from "@src/app/components/ColumnPicker";
import { flattenColumns, makeOneRowForExcel } from "@src/app/components/Filter/SpreadFilter";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { Goodsflow } from "@src/app/components/Goodsflow";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  OrderDeliveryListViewUrlQueryParams,
  OrderDeliveryListViewUrlSortField,
  orderDeliveryReprintListViewPathA,
} from "@src/app/views/order/orders/urls";
import { makeDeliveryListTableDataType } from "@src/app/views/order/orders/utils";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import {
  calcTotalExcludeVatByUnitExcludeVatAndQty,
  excelDownload,
  loadWorkbookByBuffer,
  parseWorksheetToJsonArr,
} from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationInfo,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import { ExpandableConfig, TableRowSelection } from "antd/es/table/interface";
import React, { useEffect, useRef, useState } from "react";

import {
  FulfillmentBulkUpdateTracking,
  FulfillmentBulkUpdateTrackingVariables,
} from "../../api/types/FulfillmentBulkUpdateTracking";
import { FulfillmentList, FulfillmentListVariables } from "../../api/types/FulfillmentList";
import { createFilterStructure, OrderDeliveryFilterKeys, OrderDeliveryListFilterOpts } from "./filters";
import {
  DeliveryListTableDataType,
  getDeliveryListTableSettings,
  getVsDeliveryListTableSettings,
} from "./OrderDeliveryListTableSettings";
import { createSorterStructure } from "./sorters";
import {
  checkNeedDeliveryManInfoForConsignmentFulfill,
  courierNameFieldName,
  etcDeliveryManContactFieldName,
  etcDeliveryVehicleFieldName,
  fulfillmentBulkUpdateTrackingHandler,
  fulfillmentIdFieldName,
  isOrderDeliveryViewStock,
  OrderDeliveryViewTypeEnum,
  trackingNumberFieldName,
} from "./utils";

export interface OrderDeliveryListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderDeliveryFilterKeys, OrderDeliveryListFilterOpts>,
    SortPage<OrderDeliveryListViewUrlSortField> {
  params: OrderDeliveryListViewUrlQueryParams;
  courierList: CourierList_couriers_edges_node[];
  deliveryList: DeliveryListTableDataType[];
  trackingNumberEmptyTotalCount: number | null;
  trackingNumberTypeGoodFlowTotalCount: number | null;
  queryVariables: FulfillmentListVariables;
  handleRefetch: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>;
  queryVariablesWithoutPagination: FulfillmentListVariables;
  fetchForDownload: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>;
  ListNavigator: () => React.JSX.Element;
  isB2b: boolean;
  isByNonCourier: boolean;
  onFulfillmentUpdateTrackingForCourier: (rowId: string) => void;
  onFulfillmentUpdateTrackingForNonCourier: (rowId: string) => void;
  onFulfillmentUpdateTracking: (rowId: any) => void;
  onFulfillmentUpdateTrackingForDs: (rowId: string) => void;
  onOrderLineBoxSizeUpdate: (rowId: string) => void;
  onDeliveryMultipleConfirm: (rowIds: string[]) => void;
  onFulfillmentRevertMultipleConfirm: (rowIds: string[]) => void;
  onVendorOrderConfirm: (rowIds: string[]) => void;
  fulfillmentBulkUpdateTracking: MutationFunction<
    FulfillmentBulkUpdateTracking,
    FulfillmentBulkUpdateTrackingVariables
  >;
  setSelectedFulfillmentIds: React.Dispatch<React.SetStateAction<string[]>>;
  selectedFulfillmentIds: string[];
  warehouseAddresses?: Array<{ id: string; companyName: string }>;
}

const OrderDeliveryListPage: React.FC<OrderDeliveryListPageProps> = (props) => {
  const {
    params,
    courierList,
    deliveryList,
    trackingNumberEmptyTotalCount,
    trackingNumberTypeGoodFlowTotalCount,
    currentTab,
    filterOpts,
    tabs,
    sort,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    queryVariables,
    handleRefetch,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ListNavigator,
    isB2b,
    isByNonCourier,
    onDeliveryMultipleConfirm,
    fulfillmentBulkUpdateTracking,
    setSelectedFulfillmentIds,
    selectedFulfillmentIds,
    onFulfillmentRevertMultipleConfirm,
    onVendorOrderConfirm,
    warehouseAddresses: warehouseAddressesProp,
    ...listProps
  } = props;
  const shop = useShop();
  const { user } = useUser();
  const { isStaff, isVendorStaff } = user;
  const { orderDeliveryViewType } = params;
  const [onActionForModeA, setOnActionForModeA] = useState(false);
  const [onActionForModeB, setOnActionForModeB] = useState(false);
  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);

  useEffect(() => {
    if (utils.isEmpty(deliveryList) === false) {
      setExpandedRowKeys(deliveryList.filter((item) => !!item?.children).map((item) => item.id));
    }
  }, [deliveryList]);

  let title: string;
  let extraUi: React.JSX.Element;

  const upload: any = useRef();
  const navigate = useNavigator();

  const handleError = (errMessage) => {
    showNotificationError(errMessage);
    setOnActionForModeA(false);
  };

  const handleGoodsflowPrintSuccess = () => {
    handleRefetch(queryVariables);
    setOnActionForModeA(false);
  };

  const navigateReprint = () => {
    navigate(orderDeliveryReprintListViewPathA);
  };

  const makeExtraUiA = () => (
    <Space direction="horizontal" size={8}>
      {!utils.checkWebView() && (
        <>
          <Goodsflow
            loading={onActionForModeA}
            disabled={deliveryList?.length <= 0}
            mode="print"
            setLoading={setOnActionForModeA}
            onError={handleError}
            onSuccess={handleGoodsflowPrintSuccess}
            config={shop?.goodsflowPluginConfig}
          />
          <Goodsflow
            loading={onActionForModeA}
            disabled={selectedFulfillmentIds === null || selectedFulfillmentIds?.length <= 0}
            mode="print"
            setLoading={setOnActionForModeA}
            onError={handleError}
            onSuccess={handleGoodsflowPrintSuccess}
            config={shop?.goodsflowPluginConfig}
            onlySelectedMode={true}
            selectedFulfillmentIds={selectedFulfillmentIds}
          />
          <Button type="primary" shape="round" onClick={navigateReprint}>
            운송장 재출력
          </Button>
        </>
      )}
    </Space>
  );

  const onPrintClickForB = async () => {
    setOnActionForModeB(true);
    showDownloadingMessage();

    const onPrintFinished = () => {
      setOnActionForModeB(false);
      destroyDownloadingMessage();
    };

    const flattenedColumns = flattenColumns(columns, true);

    const fulfillmentIdColumn: DownloadableColumnType<DeliveryListTableDataType> = {
      title: fulfillmentIdFieldName,
      renderExcel: (record) => record.id,
    };
    const noteColumn: DownloadableColumnType<DeliveryListTableDataType> = {
      title: columnNameConstant.product.NOTE,
      renderExcel: (record) => record.note,
    };
    const totalProductCostExcludeVatColumn: DownloadableColumnType<DeliveryListTableDataType> = {
      title: columnNameConstant.delivery.COST_PRICE_TOTAL_AMOUNT,
      renderExcel: (record) =>
        calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.unitCostPriceExcludeVat,
          record.quantity,
          record.orderLine.isTaxFree
        ),
    };
    const totalProductPriceColumn: DownloadableColumnType<DeliveryListTableDataType> = {
      title: columnNameConstant.delivery.BRAND_STORE_SALE_TOTAL_AMOUNT,
      renderExcel: (record) => record.quantity * record.orderLine.unitPriceGrossAmount,
    };
    flattenedColumns.unshift(fulfillmentIdColumn);
    // noteColumn을 flattenedColumns 중에 title을 columnNameConstant.product.PD_38로 가진 값의 바로 뒤에 넣는다.
    const noteColumnIndex = flattenedColumns.findIndex(
      (column) => column.title === columnNameConstant.product.VARIANT_NAME
    );
    if (noteColumnIndex >= 0) {
      flattenedColumns.splice(noteColumnIndex + 1, 0, noteColumn);
    }
    // totalProductCostColumn와 totalProductPriceColumn를 title이 columnNameConstant.purchaseOrder.PO_11(false)인 값의 바로 뒤에 넣는다.
    const totalProductCostColumnIndex = flattenedColumns.findIndex(
      (column) => column.title === columnNameConstant.purchaseOrder.VENDOR_COST_PRICE(false)
    );
    if (totalProductCostColumnIndex >= 0) {
      flattenedColumns.splice(totalProductCostColumnIndex + 1, 0, totalProductCostExcludeVatColumn);
    }
    const totalProductPriceColumnIndex = flattenedColumns.findIndex(
      (column) => column.title === columnNameConstant.delivery.COST_PRICE_TOTAL_AMOUNT
    );
    if (totalProductPriceColumnIndex >= 0) {
      flattenedColumns.splice(totalProductPriceColumnIndex + 1, 0, totalProductPriceColumn);
    }

    if (isB2b || needDeliveryManInfoForConsignmentFulfill) {
      const etcDeliveryManColumn: DownloadableColumnType<DeliveryListTableDataType> = {
        title: etcDeliveryVehicleFieldName,
        renderExcel: () => "(입력)",
      };
      const etcDeliveryManContactColumn: DownloadableColumnType<DeliveryListTableDataType> = {
        title: etcDeliveryManContactFieldName,
        renderExcel: () => "(입력)",
      };
      flattenedColumns.push(etcDeliveryManColumn);
      flattenedColumns.push(etcDeliveryManContactColumn);
    }

    if (isB2b || needDeliveryManInfoForConsignmentFulfill === false) {
      const courierNameColumn: DownloadableColumnType<DeliveryListTableDataType> = {
        title: courierNameFieldName,
        renderExcel: () => "(입력)",
      };
      const trackingNumberColumn: DownloadableColumnType<DeliveryListTableDataType> = {
        title: trackingNumberFieldName,
        renderExcel: () => "(입력)",
      };
      flattenedColumns.push(courierNameColumn);
      flattenedColumns.push(trackingNumberColumn);
    }

    if (isB2b) {
      const deliveryMethodColumn: DownloadableColumnType<DeliveryListTableDataType> = {
        title: columnNameConstant.delivery.DELIVERY_METHOD,
        renderExcel: (record) => (record.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER ? "택배" : "화물차"),
      };
      flattenedColumns.push(deliveryMethodColumn);
    }

    const dataSourceBefore = await fetchForDownload(queryVariablesWithoutPagination);
    const deliveryList = maybe(() => dataSourceBefore.data.fulfillments.edges.map((edge) => edge.node));
    const dateSource = makeDeliveryListTableDataType(deliveryList);

    const rows = [];
    dateSource.forEach((line, index) => {
      const row = makeOneRowForExcel(line, flattenedColumns, index);
      rows.push(row);
    });
    if (!rows || rows.length === 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      onPrintFinished();
      return;
    }
    const excelTitle = "위탁배송준비정보" + (isVendorStaff ? "(협력사용)" : "");
    excelDownload({ title: excelTitle, columns: rows });

    let mostRecentDate = "";
    if (dataSourceBefore?.data?.fulfillments?.edges?.length > 0) {
      mostRecentDate = dataSourceBefore.data.fulfillments.edges[0].node.created;
      dataSourceBefore.data.fulfillments.edges.forEach((edge) => {
        if (new Date(edge.node.created) > new Date(mostRecentDate)) {
          mostRecentDate = edge.node.created;
        }
      });
    }

    if (isStaff) {
      showNotificationInfo(
        <>
          마지막 출고처리시각은 <br /> {getDateByFormat(mostRecentDate)}입니다.
        </>
      );
    }

    onPrintFinished();
  };

  let prefixText = "";
  if (isStaff) {
    prefixText = "대행";
  } else if (isVendorStaff && isB2b === false) {
    if (isByNonCourier) {
      prefixText = "화물차";
    } else {
      prefixText = "택배";
    }
  }

  let pageTitleForConsignmentDeliveryConfirm: string;
  if (isB2b) {
    pageTitleForConsignmentDeliveryConfirm = isVendorStaff
      ? sectionNames.purchaseOrderLine.vsB2bConfirmDeliveryB
      : `${prefixText} 배송 확정(B2B)`;
  } else if (isByNonCourier) {
    pageTitleForConsignmentDeliveryConfirm = isVendorStaff
      ? sectionNames.purchaseOrderLine.vsConfirmDeliveryBByNonCourier
      : `${prefixText} 배송 확정(화물차 위탁)`;
  } else {
    pageTitleForConsignmentDeliveryConfirm = isVendorStaff
      ? sectionNames.purchaseOrderLine.vsConfirmDeliveryBByCourier
      : `${prefixText} 배송 확정(택배 위탁)`;
  }

  const makeExtraUiB = () => (
    <Space direction="vertical" size="small" align="end">
      <Space direction="horizontal" size={8}>
        <Button
          loading={onActionForModeB}
          disabled={deliveryList?.length <= 0}
          type="primary"
          shape="round"
          icon={<DownloadOutlined />}
          onClick={onPrintClickForB}
        >
          {prefixText} 배송 확정 양식 다운로드
        </Button>
        <Button
          loading={onActionForModeB}
          disabled={deliveryList?.length <= 0}
          shape="round"
          type="primary"
          onClick={() => {
            upload.current.click();
          }}
        >
          {prefixText} 배송 확정(일괄)
        </Button>
        <input
          style={{ display: "none" }}
          ref={upload}
          onChange={(e) => readUploadFile(e)}
          type="file"
          accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
        />
        <Button
          loading={onActionForModeB}
          disabled={deliveryList?.length <= 0 || selectedFulfillmentIds?.length <= 0}
          shape="round"
          type="primary"
          onClick={() => {
            onDeliveryMultipleConfirm(selectedFulfillmentIds);
          }}
        >
          {prefixText} 배송 확정(개별)
        </Button>
        {isStaff && !isB2b && (
          <Button
            shape="round"
            disabled={deliveryList?.length <= 0 || selectedFulfillmentIds?.length <= 0}
            onClick={() => {
              onVendorOrderConfirm(selectedFulfillmentIds);
            }}
          >
            협력사 주문
          </Button>
        )}
        <Button
          danger
          type="primary"
          shape="round"
          disabled={deliveryList?.length <= 0 || selectedFulfillmentIds?.length <= 0}
          onClick={() => {
            onFulfillmentRevertMultipleConfirm(selectedFulfillmentIds);
          }}
        >
          출고 취소
        </Button>
      </Space>
      {isVendorStaff && (
        <Typography.Text strong type="warning">
          {pageTitleForConsignmentDeliveryConfirm}은 [{pageTitleForConsignmentDeliveryConfirm} 양식 다운로드]한 자료에
          배송 정보(
          {isB2b ? (
            <>
              <b>[{[etcDeliveryVehicleFieldName, etcDeliveryManContactFieldName].join(", ")}]</b> 한 쌍 또는{" "}
              <b>[{[courierNameFieldName, trackingNumberFieldName].join(", ")}]</b> 한 쌍 중 하나를 반드시 입력해
              주세요.
            </>
          ) : (
            <>
              {(needDeliveryManInfoForConsignmentFulfill
                ? [etcDeliveryVehicleFieldName, etcDeliveryManContactFieldName]
                : [courierNameFieldName, trackingNumberFieldName]
              ).join(", ")}
              를 작성한 뒤 배송 확정 버튼을 통해 업로드해주세요.
            </>
          )}
          )
        </Typography.Text>
      )}
    </Space>
  );

  switch (orderDeliveryViewType) {
    case OrderDeliveryViewTypeEnum.STOCK:
      title = sectionNames.deliveryA;
      extraUi = makeExtraUiA();
      break;
    case OrderDeliveryViewTypeEnum.CONSIGNMENT:
      title = pageTitleForConsignmentDeliveryConfirm;
      extraUi = makeExtraUiB();
      break;
    case OrderDeliveryViewTypeEnum.STOCK_ETC:
      title = sectionNames.deliveryC;
      extraUi = null;
      break;
  }
  const warehouseAddresses =
    warehouseAddressesProp ||
    shop?.defaultWarehouse?.addresses?.map((addr) => ({ id: addr.id, companyName: addr.companyName })) ||
    [];
  const filterStructure = createFilterStructure(
    filterOpts,
    orderDeliveryViewType,
    isVendorStaff,
    isStaff,
    isB2b,
    warehouseAddresses
  );
  const sorterStructure = createSorterStructure();

  const rowSelection: TableRowSelection<DeliveryListTableDataType> = {
    selectedRowKeys: selectedFulfillmentIds,
    onChange: (selectedRowKeys) => {
      setSelectedFulfillmentIds(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record: DeliveryListTableDataType) => ({
      disabled: record.isChild,
    }),
  };

  const readUploadFile = (e) => {
    e.preventDefault();
    if (e.target.files) {
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const jsonAry = parseWorksheetToJsonArr({ worksheet, headerRowNum: 1 });
        fulfillmentBulkUpdateTrackingHandler(
          jsonAry,
          courierList,
          fulfillmentBulkUpdateTracking,
          isB2b,
          isByNonCourier,
          true
        );
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const columns = isVendorStaff
    ? getVsDeliveryListTableSettings(props, shop?.courierDeliveryAdditionalFeeList)
    : getDeliveryListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const rowExpandable: ExpandableConfig<DeliveryListTableDataType> = {
    fixed: "left",
    indentSize: 0,
    expandedRowKeys,
    rowExpandable: (record) => record.children?.length > 0,
    onExpandedRowsChange: (expandedKeys) => setExpandedRowKeys(expandedKeys as string[]),
  };

  const showTableTitle = deliveryList.some((fulfillmentLine) => fulfillmentLine?.children?.length > 0);
  const tableTitle = showTableTitle
    ? () => {
        const noExpanded = !expandedRowKeys || expandedRowKeys.length === 0;
        const arrowIcon = noExpanded ? <DownOutlined /> : <UpOutlined />;
        const buttonText = `배송내역 정보 ${noExpanded ? "펼치기" : "숨기기"}`;
        return (
          <Typography.Link
            style={{ color: "black" }}
            onClick={() => {
              if (noExpanded) {
                const allRowKeys = deliveryList
                  .filter((fulfillmentLine) => fulfillmentLine?.children?.length > 0)
                  .map((fulfillmentLine) => fulfillmentLine?.id);
                setExpandedRowKeys(allRowKeys);
              } else {
                setExpandedRowKeys([]);
              }
            }}
          >
            <Space direction={"horizontal"}>
              {arrowIcon}
              {buttonText}
            </Space>
          </Typography.Link>
        );
      }
    : null;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "fulfillments",
    processNodesToDataType: makeDeliveryListTableDataType,
    makeChildrenFlat: true,
  };

  return (
    <Space direction="vertical" size={24}>
      {ListNavigator && (
        <Row justify="space-between" align="middle">
          <Col>{ListNavigator()}</Col>
        </Row>
      )}
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{title}</Typography.Title>
        </Col>
        <Col>{extraUi}</Col>
      </Row>
      {isOrderDeliveryViewStock(orderDeliveryViewType) && !listProps?.disabled && (
        <Row>
          <Typography.Text>대기 :</Typography.Text>&nbsp;
