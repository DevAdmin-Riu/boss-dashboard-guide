export function getFilterOpts(
  params: BrandStoreConsultationListViewUrlQueryParams
): BrandStoreConsultationListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    titleSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.titleSearch, true), false),
      value: maybe(() => filterVariables.titleSearch, ""),
    },
    reportSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.reportSearch, true), false),
      value: maybe(() => filterVariables.reportSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
