      ];
      break;
    case OrderDeliveryViewTypeEnum.STOCK_ETC:
      columns = [
        makeFulfillmentComposedIdWithPrefixCol(listProps),
        orderLineComposedIdCol,
        {
          title: "일자",
          children: [orderCreatedCol, orderCapturedAtCol, fulfillmentCreatedCol],
        },
        makeTrackingStatusCol(),
        {
          title: "고객사 정보",
          children: [
            isB2b && brandCodeCol,
            brandNameCol,
            isB2b === false && brandStoreCodeCol,
            isB2b === false && brandStoreNameCol,
            isB2b === false && firstNameCol,
          ].filter(Boolean),
        },
        {
          title: "상품 정보",
          children: [
            makeProductSkuCol(),
            makeProductNameCol(),
            makeVariantNameCol(),
            makeAttributesCol(),
            makeQtyPerBoxCol(),
            noteCol,
          ],
        },
        {
          title: "협력사 정보",
          children: [
            vendorNameCol,
            vendorPurchaseByCol,
            vendorNoteCol,
            vendorExternalSkuCol,
            vendorProductNameCol,
            vendorEmailCol,
            vendorContactTypeCol,
          ],
        },
        {
          title: "배송 정보",
          children: [
            makeDeliveryMethodCol(),
            quantityCol,
            warehouseCol,
            makeCustomerNameCol(false),
            makeCustomerPhoneCol(false),
            makeShippingAddressCol(false),
            makeEtcDeliveryVehicleCol(),
            makeEtcDeliveryManContactCol(),
            makeCourierNameCol(),
            makeTrackingNumberCol(courierList),
            etcDeliveryManInfoActionCol,
          ],
