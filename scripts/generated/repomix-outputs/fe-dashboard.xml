<file path="src/app/components/Filter/SpreadFilterContent.tsx">
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import {
  dateRangePresets,
  detailDateFormat,
  detailTimeFormat,
  ISOFormatWithTimeZone,
  monthRangePresets,
  onlyDateFormat,
  onlyMonthFormat,
} from "@src/app/providers/DateProvider";
import filterMsg from "@src/global/assets/messages/filters";
import { utils } from "@utils/utils";
import { Button, Card, Checkbox, Col, Input, InputNumber, Radio, Row, Select, Space, Typography } from "antd";
import { SizeType } from "antd/lib/config-provider/SizeContext";
import { RangePickerProps } from "antd/lib/date-picker";
import moment from "moment";
import React from "react";

import { ResponsiveDatePicker } from "../antd/DatePicker/ResponsiveDatePicker";
import { ResponsiveRangePicker } from "../antd/DatePicker/ResponsiveRangePicker";
import { getPickerClassName } from "../antd/PickerProps/PickerProps";
import FilterAutocompleteField from "./FilterAutocompleteField";
import FilterOptionField from "./FilterOptionField";
import { FilterReducerAction } from "./reducer";
import { FieldType, IFilter, IFilterElement } from "./types";

interface SpreadFilterContentProps<T extends string = string> {
  currencySymbol: string;
  filters: IFilter<T>;
  onFilterPropertyChange: React.Dispatch<FilterReducerAction<T>>;
}

const isMobile = utils.checkMobile();

export const convertFilterFieldValueToString = <T extends string>(filterField: IFilterElement<T>): string => {
  const { type, value, options } = filterField;

  if (!value || value.length === 0) {
    return ""; // 값이 없으면 빈 문자열 반환
  }

  switch (type) {
    case FieldType.text:
      // 텍스트 필터: 첫 번째 값 반환
      return value[0] || "";

    case FieldType.month:
    case FieldType.date:
    case FieldType.dateTime:
      const valueFormat =
        type === FieldType.month ? onlyMonthFormat : type === FieldType.date ? onlyDateFormat : detailDateFormat;
      const startDate = moment(value[0]);
      const endDate = moment(value[1]);
      return value.length === 2
        ? `${startDate.isValid() ? startDate.format(valueFormat) : "-"} ~ ${
            endDate.isValid() ? endDate.format(valueFormat) : "-"
          }`
        : "";

    case FieldType.oneMonth:
      // 한 달 선택 필터: 첫 번째 값을 "YYYY-MM" 형식으로 반환
      return value[0] ? moment(value[0]).format(onlyMonthFormat) : "";

    case FieldType.price:
    case FieldType.number:
      // 숫자 필터: 최소값과 최대값을 "min ~ max" 형식으로 반환
      return value.length === 2 ? `${value[0] || "-"} ~ ${value[1] || "-"}` : "";

    case FieldType.options:
    case FieldType.select:
      // 옵션 필터: 선택된 값들을 쉼표로 구분하여 반환
      const selectedOptions = options.filter((option) => value.includes(option.value));
      return selectedOptions.map((option) => option.label).join(", ");

    case FieldType.boolean:
      const selectedOption = options.find((option) => option.value === value[0]);
      return selectedOption ? selectedOption.label : "";

    case FieldType.autocomplete:
      // 자동완성 필터: 첫 번째 값 반환
      return value[0] || "";

    default:
      // 기본값 처리
      return "";
  }
};

interface IFilterInputNodeProps<T extends string> {
  currencySymbol: string;
  filterField: IFilterElement<T>;
  size?: SizeType;
  onFilterPropertyChange: React.Dispatch<FilterReducerAction<T>>;
}

export const makeFilterInputNode = <T extends string>(props: IFilterInputNodeProps<T>) => {
  const { currencySymbol, filterField, size, onFilterPropertyChange } = props;
  const { type: fieldType, name, label, value, active, multiple } = filterField;
  const filterChangeDisabled = !active;
  // 일자 관련 필터 변수
  // 시간까지 선택하는 필터인 경우, 사용자에게 보여주는 포맷과 필터 input 포맷이 다름
  const dateFormat =
    fieldType === FieldType.month
      ? onlyMonthFormat
      : fieldType === FieldType.dateTime
      ? detailDateFormat
      : onlyDateFormat;
  const onChangeFormatStr =
    fieldType === FieldType.month
      ? onlyMonthFormat
      : fieldType === FieldType.dateTime
      ? ISOFormatWithTimeZone
      : onlyDateFormat;
  const ranges: RangePickerProps["ranges"] = fieldType === FieldType.month ? monthRangePresets : dateRangePresets;

  const isRequired = filterField?.isRequired;

  return (
    <Space direction="vertical" size={0}>
      <Row align="middle" justify="space-between">
        <Col>
          {!isRequired ? (
            <Checkbox
              checked={active}
              onChange={(e) =>
                onFilterPropertyChange({
                  payload: { name, update: { active: e.target.checked } },
                  type: "set-property",
                })
              }
            >
              {label}
            </Checkbox>
          ) : (
            <div style={{ minHeight: "22.5px" }}>{label}</div>
          )}
        </Col>
        <Col>
          {/* 옵션 타입 / 다중 선택인 경우 */}
          {fieldType === FieldType.options && multiple && (
            <Space style={{ marginBottom: 2 }} size={4} wrap>
              <Button
                size="small"
                onClick={() => {
                  onFilterPropertyChange({
                    payload: {
                      name,
                      update: { value: filterField.options.map((option) => option.value), active: true },
                    },
                    type: "set-property",
                  });
                }}
              >
                전체 선택
              </Button>
              <Button
                size="small"
                onClick={() => {
                  onFilterPropertyChange({
                    payload: {
                      name,
                      update: { value: [], active: true },
                    },
                    type: "set-property",
                  });
                }}
              >
                전체 해제
              </Button>
            </Space>
          )}
        </Col>
      </Row>
      <Card
        size="small"
        style={{ width: "100%", borderRadius: 0, borderTop: "1px solid black" }}
        bodyStyle={{ padding: 8, minHeight: 40 }}
      >
        {fieldType === FieldType.text && (
          <Input.TextArea
            size={size}
            autoSize={{ minRows: 1, maxRows: 6 }}
            name={name}
            disabled={filterChangeDisabled}
            value={active ? value[0] : null}
            placeholder={filterField.placeholder || ""}
            onChange={(event) =>
              onFilterPropertyChange({
                payload: { name, update: { value: [event.target.value, value[1]], active: true } },
                type: "set-property",
              })
            }
          />
        )}
        {[FieldType.date, FieldType.month, FieldType.dateTime].includes(fieldType) && (
          <ResponsiveRangePicker
            includeTime={fieldType === FieldType.dateTime}
            className={fieldType === FieldType.dateTime && getPickerClassName(["ant-picker-range-datetime-responsive"])}
            showTime={fieldType === FieldType.dateTime && { format: detailTimeFormat }}
            style={{ width: "100%" }}
            size={size}
            name={name}
            allowClear={false}
            disabled={filterChangeDisabled}
            format={dateFormat}
            picker={fieldType === FieldType.month ? "month" : "date"}
            disabledDate={filterField.disabledDate}
            value={utils.isEmpty(value) || !active ? null : [moment(value[0]), moment(value[1])]}
            onChange={(changedValue) => {
              onFilterPropertyChange({
                payload: {
                  name,
                  update: {
                    value: [changedValue[0].format(onChangeFormatStr), changedValue[1].format(onChangeFormatStr)],
                    active: true,
                  },
                },
                type: "set-property",
              });
            }}
            ranges={ranges}
          />
        )}
        {[FieldType.oneMonth].includes(fieldType) && (
          <ResponsiveDatePicker
            picker="month"
            size={size}
            name={name}
            allowClear={false}
            disabled={filterChangeDisabled}
            format={onlyMonthFormat}
            value={utils.isEmpty(value) || !active ? null : moment(value[0])}
            style={{ width: "100%" }}
            onChange={(changedValue) => {
              onFilterPropertyChange({
                payload: {
                  name,
                  update: {
                    value: [changedValue.format(onlyMonthFormat)],
                    active: true,
                  },
                },
                type: "set-property",
              });
            }}
          />
        )}
        {[FieldType.price, FieldType.number].includes(fieldType) && (
          <Row justify={isMobile ? "center" : "space-between"}>
            <Col span={isMobile ? 24 : 10}>
              <InputNumber
                {...getInputNumberProps({ isCommaDisplay: true })}
                size={size}
                style={{ width: "100%" }}
                name={name + "_min"}
                disabled={filterChangeDisabled}
                addonAfter={fieldType === FieldType.price && currencySymbol}
                value={active ? value[0] : null}
                onChange={(changedValue: string) =>
                  onFilterPropertyChange({
                    payload: { name, update: { value: [changedValue, value[1]], active: true } },
                    type: "set-property",
                  })
                }
              />
            </Col>
            <Typography.Title level={4}>{filterMsg.rangeSeparator}</Typography.Title>
            <Col span={isMobile ? 24 : 10}>
              <InputNumber
                {...getInputNumberProps({ isCommaDisplay: true })}
                size={size}
                style={{ width: "100%" }}
                name={name + "_max"}
                disabled={filterChangeDisabled}
                addonAfter={fieldType === FieldType.price && currencySymbol}
                value={active ? value[1] : null}
                onChange={(changedValue: string) =>
                  onFilterPropertyChange({
                    payload: { name, update: { value: [value[0], changedValue], active: true } },
                    type: "set-property",
                  })
                }
              />
            </Col>
          </Row>
        )}
        {fieldType === FieldType.options && (
          <FilterOptionField
            disabled={filterChangeDisabled}
            filterField={filterField}
            onFilterPropertyChange={onFilterPropertyChange}
          />
        )}
        {fieldType === FieldType.boolean &&
          filterField.options.map((option, idx) => (
            <Radio
              key={idx}
              name={name}
              disabled={filterChangeDisabled}
              checked={active ? value[0] === option.value : false}
              onChange={() =>
                onFilterPropertyChange({
                  payload: { name, update: { value: [option.value], active: true } },
                  type: "set-property",
                })
              }
            >
              {option.label}
            </Radio>
          ))}
        {fieldType === FieldType.autocomplete && (
          <FilterAutocompleteField
            size={size}
            disabled={filterChangeDisabled}
            filterField={filterField}
            onFilterPropertyChange={onFilterPropertyChange}
          />
        )}
        {fieldType === FieldType.select && (
          <Select
            size={size}
            style={{ width: "100%" }}
            mode={multiple ? "multiple" : null}
            disabled={filterChangeDisabled}
            placeholder="선택"
            options={filterField.options}
            value={active ? (multiple ? value : value[0]) : null}
            onChange={(value) =>
              onFilterPropertyChange({
                payload: { name, update: { value: Array.isArray(value) ? value : [value], active: true } },
                type: "set-property",
              })
            }
          />
        )}
      </Card>
    </Space>
  );
};

const SpreadFilterContent: React.FC<SpreadFilterContentProps> = ({
  currencySymbol,
  filters,
  onFilterPropertyChange,
}) => (
  <Row gutter={[12, 12]}>
    {filters
      .sort((a, b) => (a.displayOrder > b.displayOrder ? 1 : -1))
      .map((filterField, idx) => {
        const xsColSpan = 24;
        const smColSpan = filterField?.smColSpan || 8;
        const xxlColSpan = 6;

        return (
          <Col key={idx} xs={xsColSpan} sm={smColSpan} xxl={xxlColSpan}>
            {makeFilterInputNode({ currencySymbol, filterField, onFilterPropertyChange })}
          </Col>
        );
      })}
  </Row>
);
export default SpreadFilterContent;
</file>

