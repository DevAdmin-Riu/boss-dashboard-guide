        setLoading(true);
        showDownloadingMessage();
        refetchForBrandUserStats(queryVariables)
          .then((res) => {
            const columns = parseUserStats(res);
            if (!columns || columns.length <= 0) {
              showNotificationWarn("출력할 데이터가 없습니다.");
              return;
            }
            excelDownload({ title: "매장별 현황 정보", columns });
            if (res?.data?.brandUserStats?.length === StatsQueryMaxLimitEnum.brandUserStats) {
              showNotificationWarn(commonErrorMsg.maxLimitIssue);
            } else {
              showNotificationSuccess(commonMsg.downloadedToXls);
            }
          })
          .catch((e) => {
            showNotificationError("에러가 발생하였습니다");
            throw e;
          })
          .finally(() => {
            setLoading(false);
            destroyDownloadingMessage();
          });
      }}
    >
      통계 자료 다운로드
    </Button>
  );

  if (!modalMode && brandUserStatsOrder?.brandUserStats?.length === StatsQueryMaxLimitEnum.brandUserStats) {
    showNotificationWarn(commonErrorMsg.maxLimitIssue);
  }

  const columns = getHqStatsUserTableSettings(brandUserStatsOrderLoading, openOrderDetailModal);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <PageHeader
        title={<Typography.Title level={4}>{title}</Typography.Title>}
        extra={makeExtraUi(loading, setLoading)}
      />
      <CardSpacer />
      <HqStatsSelectDuration
        dateType={dateType}
        setDateType={setDateType}
        selectedDuration={selectedDuration}
        setSelectedDuration={setSelectedDuration}
        getDateRange={getDateRange}
        disabledSelectDateType={true}
      />
      <CardSpacer />
      {!brandUserStatsOrderLoading && (
        <Card>
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            rowKey={(record) => record.userId}
            columns={columns}
            dataSource={brandUserStatsOrder?.brandUserStats}
            scroll={{ x: tableWidthSum, y: 500 }}
            summary={getStatsHqUserTableSummary}
          />
          <OrdersHistoryDialog
            open={modalMode === StatsHqUserModalModeEnum.OrdersHistory}
            onClose={resetForCloseModal}
            userId={idForModal}
            userName={nameForModal}
            brand={user?.brand}
            dateRange={getGteLteVariables({
              gte: selectedDuration[0].format(onlyDateFormat),
              lte: selectedDuration[1].format(onlyDateFormat),
            })}
          />
        </Card>
      )}
    </>
  );
};
export default HqStatsUser;
</file>

