import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  FulfilledByVendorSettlementFilterKeys,
  FulfilledByVendorSettlementListFilterOpts,
} from "../../components/FulfilledByVendorSettlementListPage/filters";
import { FulfilledByVendorSettlementListFilterVariables } from "../../components/FulfilledByVendorSettlementListPage/FulfilledByVendorSettlementListPage";
import {
  AdminMonthlySettlementUrlEnum,
  FulfilledByVendorSettlementListViewUrlFilters,
  FulfilledByVendorSettlementListViewUrlFiltersEnum,
  FulfilledByVendorSettlementListViewUrlFiltersWithMultipleValuesEnum,
  MileageSettlementListViewUrlQueryParams,
} from "../../urls";

const FULFILLED_BY_VENDOR_SETTLEMENT_FILTERS_KEY = "fulfilledByVendorSettlementFilters";

export function getFilterOpts(
  params: FulfilledByVendorSettlementListViewUrlFilters,
  urlType: AdminMonthlySettlementUrlEnum
): FulfilledByVendorSettlementListFilterOpts {
  const filterVariables = getFilterVariables(params, urlType);
  const lastMonth = moment().subtract(1, "months");

  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, lastMonth.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.statDate.gte, lastMonth.format(onlyMonthFormat)),
      },
    },
    hasApplied: {
      active: maybe(() => filterVariables.hasApplied !== undefined, true),
      value: maybe(() => filterVariables.hasApplied, true),
    },
    settlementStatus: {
      active: maybe(() => filterVariables.settlementStatus && filterVariables.settlementStatus.length > 0, false),
      value: maybe(() => filterVariables.settlementStatus, []),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch, true), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: FulfilledByVendorSettlementListViewUrlFilters,
  urlType: AdminMonthlySettlementUrlEnum
): FulfilledByVendorSettlementListFilterVariables {
  // urlType에 따른 settlementStatus 결정
  let settlementStatus: BrandMonthlySettlementStatusEnum[] | undefined;

  switch (urlType) {
    case AdminMonthlySettlementUrlEnum.NOT_CONFIRMED:
      // 미확정은 settlementStatus가 없는 것들
      settlementStatus = undefined;
      break;
    case AdminMonthlySettlementUrlEnum.REVIEWING_BY_ADMIN:
      // hasApplied 필터에 따라 settlementStatus 결정
      const hasApplied = params.hasApplied !== undefined ? params.hasApplied === "true" : true;
      if (hasApplied) {
        // 신청한 것만 보기: REVIEWING_BY_ADMIN만
        settlementStatus = [BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN];
      } else {
        // 미신청한 것만 보기: CONFIRMED만
        settlementStatus = [BrandMonthlySettlementStatusEnum.CONFIRMED];
      }
      break;
    case AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT:
      settlementStatus = [BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT];
      break;
    case AdminMonthlySettlementUrlEnum.PAID:
      settlementStatus = [BrandMonthlySettlementStatusEnum.PAID];
      break;
    case AdminMonthlySettlementUrlEnum.ALL_STATUS:
      // 전체보기는 필터에서 선택한 값 사용
      settlementStatus = maybe(() =>
        params.settlementStatus.map((item) => findInEnum(item, BrandMonthlySettlementStatusEnum))
      );
      break;
    default:
      settlementStatus = undefined;
  }

  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
    hasApplied: params.hasApplied !== undefined ? params.hasApplied === "true" : true,
    settlementStatus,
    brandSearch: params.brandSearch,
    mdSearch: params.mdSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<FulfilledByVendorSettlementFilterKeys>
): FulfilledByVendorSettlementListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case FulfilledByVendorSettlementFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        FulfilledByVendorSettlementListViewUrlFiltersEnum.statDateFrom,
        FulfilledByVendorSettlementListViewUrlFiltersEnum.statDateTo
      );
    case FulfilledByVendorSettlementFilterKeys.hasApplied:
      return getSingleValueQueryParam(filter, FulfilledByVendorSettlementListViewUrlFiltersEnum.hasApplied);
    case FulfilledByVendorSettlementFilterKeys.settlementStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        FulfilledByVendorSettlementListViewUrlFiltersWithMultipleValuesEnum.settlementStatus,
        BrandMonthlySettlementStatusEnum
      );
    case FulfilledByVendorSettlementFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, FulfilledByVendorSettlementListViewUrlFiltersEnum.brandSearch);
    case FulfilledByVendorSettlementFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, FulfilledByVendorSettlementListViewUrlFiltersEnum.mdSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<FulfilledByVendorSettlementListViewUrlFilters>(FULFILLED_BY_VENDOR_SETTLEMENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  MileageSettlementListViewUrlQueryParams,
  FulfilledByVendorSettlementListViewUrlFilters
>({ ...FulfilledByVendorSettlementListViewUrlFiltersEnum });
