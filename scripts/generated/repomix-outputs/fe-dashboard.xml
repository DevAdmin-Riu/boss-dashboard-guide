import useUser from "@hooks/useUser";
import CardSpacer from "@src/app/components/CardSpacer";
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import { getFilterVariables } from "@src/app/views/order/orders/views/FbvOrderDeliveryListView/filters";
import { useVendorListQuery } from "@src/app/views/purchase/vendors/api/queries";
import { IRootState } from "@src/global/redux/config/configStore";
import { fbvDeliverySelectVendorChange } from "@src/global/redux/store/mileageSettlement.store";
import { utils } from "@utils/utils";
import { Col, Select } from "antd";
import QueryString from "qs";
import React, { useState } from "react";
import { useDispatch, useSelector } from "react-redux";

import { useFbvOrderLineCountQuery } from "../../api/queries";
import { FbvOrderLineCount } from "../../api/types/FbvOrderLineCount";
import FbvOrderDeliveryListNav, {
  TCountOfStatus,
} from "../../components/FbvOrderDeliveryListNav/FbvOrderDeliveryListNav";
import { OrderLineListActionTypeEnum, OrderLineListViewTypeEnum } from "../../components/OrderLineListPage/utils";
import {
  FbvOrderDeliveryListViewUrlQueryParams,
  FbvOrderDeliveryUrlEnum,
  FbvOrderLineListViewUrlQueryParams,
} from "../../urls";
import { FbvOrderLineListView } from "../FbvOrderLineListView/FbvOrderLineListView";
import FbvOrderDeliveryListView, { SelectVendorInfo } from "./FbvOrderDeliveryListView";

interface FbvOrderDeliveryListViewWrapperProps {
  urlType: UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>;
  defaultParams: FbvOrderDeliveryListViewUrlQueryParams | FbvOrderLineListViewUrlQueryParams;
  // qs: FbvOrderDeliveryListViewUrlQueryParams;
  qs: QueryString.ParsedQs;
}

export const FbvOrderDeliveryListViewCombineWrapper: React.FC<FbvOrderDeliveryListViewWrapperProps> = ({
  urlType,
  defaultParams,
  qs,
}) => {
  const { user } = useUser();
  const dispatch = useDispatch();

  const { isVendorStaff, isStaff, vendor } = user;
  const params: FbvOrderDeliveryListViewUrlQueryParams | FbvOrderLineListViewUrlQueryParams = {
    ...defaultParams,
    ...qs,
  };
  const [urlTypeState, setUrlTypeState] =
    useState<UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>>(urlType);
  const [countOfStatus, setCountOfStatus] = useState<TCountOfStatus>(null);
  const fbvDeliverySelectVendor = useSelector<IRootState, SelectVendorInfo>(
    (state) => state.mileageSettlement.fbvDeliverySelectVendor
  );
  const fulfillVendorId = isStaff ? fbvDeliverySelectVendor?.id : isVendorStaff ? vendor?.id : null;

  const { data: vendorList } = useVendorListQuery({
    skip: isVendorStaff,
    variables: {
      first: 1000,
      filter: {
        useFbvProduct: true,
      },
    },
  });

  useFbvOrderLineCountQuery({
    skip: utils.isEmpty(fulfillVendorId, true),
    variables: {
      vendorId: fulfillVendorId,
      filter: {
        ...getFilterVariables(params),
      },
    },
    onCompleted: (data: FbvOrderLineCount) => {
      const statusCounts: TCountOfStatus = {
        [FbvOrderDeliveryUrlEnum.UNFULFILLED]: data?.fbvOrderLineCount.beforeFulfilled,
        [FbvOrderDeliveryUrlEnum.FULFILLED]: data?.fbvOrderLineCount.beforeDeliveryInfo,
        [FbvOrderDeliveryUrlEnum.TRACKING_A]: data?.fbvOrderLineCount.beforeCompletedByCourier,
        [FbvOrderDeliveryUrlEnum.COMPLETED_A]: data?.fbvOrderLineCount.completedByCourier,
        [FbvOrderDeliveryUrlEnum.TRACKING_B]: data?.fbvOrderLineCount.beforeCompletedByTruckService,
        [FbvOrderDeliveryUrlEnum.COMPLETED_B]: data?.fbvOrderLineCount.completedByTruckService,
      };
      setCountOfStatus(statusCounts);
    },
  });

  return (
    <>
      {isStaff && (
        <>
          <Col span={24}>
            <Select
              style={{ width: 300 }}
              size="large"
              dropdownMatchSelectWidth={false}
              showSearch
              onChange={(_value, option: SelectVendorInfo) => {
                dispatch(
                  fbvDeliverySelectVendorChange({
                    label: `${option.code}: ${option.name}`,
                    id: option.id,
                    code: option.code,
                    name: option.name,
                  })
                );
              }}
              value={
                fbvDeliverySelectVendor?.code
                  ? `${fbvDeliverySelectVendor?.code}: ${fbvDeliverySelectVendor?.name}`
                  : undefined
              }
              onSearch={(value: string) => value}
              options={vendorList?.vendors.edges.map((item) => ({
                label: `${item.node.code}: ${item.node.name}`,
                value: `${item.node.code}: ${item.node.name}`,
                id: item.node.id,
                name: item.node.name,
                ...item.node,
              }))}
              placeholder="협력사를 선택해주세요."
            />
          </Col>
          <CardSpacer />
        </>
      )}
      <FbvOrderDeliveryListNav
        urlType={urlTypeState}
        setUrlType={setUrlTypeState}
        params={params}
        countOfStatus={countOfStatus}
      />
      {urlTypeState.urlEnum === "UNFULFILLED" ? (
        <FbvOrderLineListView
          defaultParams={defaultParams}
          params={
            {
              ...params,
              orderLineListActionType: OrderLineListActionTypeEnum.FOR_FULFILL,
              orderLineListViewType: OrderLineListViewTypeEnum.FULFILLED_BY_VENDOR,
            } as FbvOrderLineListViewUrlQueryParams
          }
          vendorStaffVendorId={fulfillVendorId}
          isB2b={false}
        />
      ) : (
        <FbvOrderDeliveryListView params={params} urlTypeState={urlTypeState} vendorStaffVendorId={fulfillVendorId} />
      )}
    </>
  );
};
</file>

