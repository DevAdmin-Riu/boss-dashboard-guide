    () => ({
      ...paginationState,
      filter: { ...getRefundedListFilterVariables(params), brand: brandId },
      sort: getRefundedListSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useRefundedListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.refundedOrderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<RefundedListViewUrlDialog, RefundedListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  return (
    <>
      <RefundedListPage
        params={params}
        queryVariables={queryVariables}
        handleRefetch={refetch}
        settings={settings}
        currentTab={currentTab}
        disabled={loading}
        filterOpts={getFilterOpts(params)}
        refundedList={maybe(() => data.refundedOrderLines.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        isHqStaff={isHqStaff}
        brandId={brandId}
        orderType={orderType}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
