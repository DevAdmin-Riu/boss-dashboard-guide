import { TableRowSelection } from "antd/lib/table/interface";
import React from "react";

import { B2bOrderLineListViewRouteParams } from "../../urls";
import { OrderLineB2bUpdateForm } from "../../views/B2bOrderLineListView/B2bOrderLineListView";
import { getB2bOrderTableSettings } from "./B2bOrderLineListTableSettings";
import { createFilterStructure } from "./filter";
import { isNotExistOrderLineB2bStatusIn } from "./utils";

interface B2bOrderListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderLineListFilterKeys, OrderLineListFilterOpts> {
  orderLines: OrderLineList_orderLines_edges_node[];
  params: OrderLineListViewUrlQueryParams;
  isAll: boolean;
  queryVariablesWithoutPagination: OrderLineListVariables;
  fetchForDownload: (variables?: OrderLineListVariables) => Promise<ApolloQueryResult<OrderLineList>>;
  createAdminOrderButtonClick: () => void;
  routeParams: B2bOrderLineListViewRouteParams;
  selectedRowIds: React.Key[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<React.Key[]>>;
  ListNavigator: () => React.ReactNode;
  closeModal: () => void;
  form: FormInstance<OrderLineB2bUpdateForm>;
  selectedRowId: string;
  setSelectedRowId: React.Dispatch<React.SetStateAction<string>>;
  onOrderLineB2bUpdate: (id: any, input: OrderLineB2bUpdateInput) => void;
  onOrderLinesB2bReceive: (input: OrderLinesB2bReceiveInput) => void;
  onOrderLinesB2bCancel: (orderLineIds: string[]) => void;
  onOrderLinesB2bPending: (orderLineIds: string[]) => void;
  onDelivered: () => void;
  openModal: (action: OrderLineListViewUrlDialog, newParams?: OrderLineListViewUrlQueryParams) => void;
  resetFormField: () => void;
}

const B2bOrderLineListPage: React.FC<B2bOrderListPageProps> = (props) => {
  const {
    params,
    currencySymbol,
    currentTab,
    filterOpts,
    tabs,
    queryVariablesWithoutPagination,
    isAll,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    fetchForDownload,
    createAdminOrderButtonClick,
    onRowClick,
    routeParams,
    selectedRowIds,
    setSelectedRowIds,
    ListNavigator,
    orderLines,
    closeModal,
    form,
    selectedRowId,
    setSelectedRowId,
    onOrderLineB2bUpdate,
    onOrderLinesB2bReceive,
    onOrderLinesB2bCancel,
    onOrderLinesB2bPending,
    openModal,
    resetFormField,
    onDelivered,
    ...listProps
  } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const { user } = useUser();
  const isStaff = user.isStaff;

  const formValuesWatched: OrderLineB2bUpdateForm = {
    quantity: Form.useWatch("quantity", form),
    b2bDeliveryFeeExcludeVat: Form.useWatch("b2bDeliveryFeeExcludeVat", form),
    unitPriceExcludeVat: Form.useWatch("unitPriceExcludeVat", form),
    unitPriceVat: Form.useWatch("unitPriceVat", form),
  };

  const setEditableRow = (record: OrderLineList_orderLines_edges_node) => {
    form.setFields([
      { name: "quantity", value: record.orderedOrFulfillQty },
      { name: "b2bDeliveryFeeExcludeVat", value: record.b2bDeliveryFeeExcludeVat },
      { name: "unitPriceExcludeVat", value: record.unitPriceGrossAmount - record.unitPriceVat },
      { name: "unitPriceVat", value: record.unitPriceVat },
    ]);
    setSelectedRowId(record.id);
  };

  const isEditing = (record: OrderLineList_orderLines_edges_node) =>
    record.id === selectedRowId && utils.isEmpty(params.action);
  const onEdit = (record: OrderLineList_orderLines_edges_node) => setEditableRow(record);

  const onCancel = () => resetFormField();

  const onSubmit = async (orderType: OrderType, record: OrderLineList_orderLines_edges_node) => {
    const isB2bTakeBack = orderType === OrderType.BY_STAFF_FOR_B2B_TAKE_BACK;
    const { priceDecimalPlaces } = record.variant;
    const inputForm = form.getFieldsValue();
    const { quantity, b2bDeliveryFeeExcludeVat, unitPriceExcludeVat, unitPriceVat } = inputForm;
    const input: OrderLineB2bUpdateInput = {
      quantity,
      unitPrice: toPricePrecisionFixed(unitPriceExcludeVat + unitPriceVat, priceDecimalPlaces),
      unitPriceVat,
      b2bDeliveryFeeExcludeVat: isB2bTakeBack ? undefined : b2bDeliveryFeeExcludeVat,
    };

    onOrderLineB2bUpdate(selectedRowId, input);
  };

  const columns = getB2bOrderTableSettings({
    form,
    formValuesWatched,
    onRowClick,
    loading: listProps.disabled,
    selectedRowId,
    setSelectedRowId,
    isEditing,
    onEdit,
    onCancel,
    onSubmit,
    onOrderLinesB2bReceive,
    onOrderLinesB2bCancel,
    onOrderLinesB2bPending,
    routeParams,
    openModal,
    isStaff,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const filterStructure = createFilterStructure(filterOpts, routeParams, isStaff);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "orderLines",
  };
  let rowSelection: TableRowSelection<OrderLineList_orderLines_edges_node> = null;

  const { status } = routeParams;
  let extraUi: React.ReactNode = null;
  let showRowSelection: boolean = true;
  switch (status) {
    case "accept":
    case "pending-or-rejected":
      extraUi = (
        <Space direction="horizontal" size={8}>
          <Button
            type="primary"
            shape="round"
            icon={<ArrowRightOutlined />}
            onClick={() => createAdminOrderButtonClick()}
          >
            주문 생성
          </Button>
          {isStaff && (
            <Button
              type="primary"
              shape="round"
              disabled={selectedRowIds.length === 0}
              onClick={() => openModal("b2b-order-lines-receive")}
            >
              일괄 접수
            </Button>
          )}
        </Space>
      );
      rowSelection = isStaff
        ? {
            fixed: true,
            selectedRowKeys: selectedRowIds,
            onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
            getCheckboxProps: (record) => ({
              disabled: !isNotExistOrderLineB2bStatusIn(record.b2bStatus, [
                OrderLineB2bStatusEnum.RECEIVED,
                OrderLineB2bStatusEnum.CANCELED,
                OrderLineB2bStatusEnum.REJECTED,
              ]),
            }),
          }
        : null;
      break;
    case "delivery":
      rowSelection = {
        fixed: true,
        selectedRowKeys: selectedRowIds,
        onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
        getCheckboxProps: (record) => ({
          disabled: record?.purchaseOrderLine.status !== PurchaseOrderLineStatus.INVOICE_PRINTED,
        }),
      };
      extraUi = (
        <Space direction="horizontal" size={8}>
          <Button
            type="primary"
            shape="round"
            disabled={selectedRowIds.length === 0}
            icon={<ArrowRightOutlined />}
            onClick={() => onDelivered()}
          >
            배송 완료
          </Button>
        </Space>
      );
      break;
    case "all":
      rowSelection = null;
      showRowSelection = false;
    default:
      break;
  }

  return (
    <Form form={form} component={false}>
      <Space direction="vertical" size={24}>
        <Row justify="space-between" align="middle">
          <Col>{ListNavigator()}</Col>
          <Col>{extraUi}</Col>
        </Row>
        <Card>
          <SpreadFilterBar<string, OrderListVariables, OrderList, OrderList_orders_edges_node>
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <>
                <ColumnPicker
                  columns={pickColumns}
                  loading={listProps.disabled}
                  initialColumns={initialColumns}
                  total={pickColumns?.length}
                  onSave={handleSave}
                />
              </>
            }
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={orderLines}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
            rowSelection={showRowSelection && rowSelection}
            components={{ body: { cell: EditableCell } }}
          />
        </Card>
      </Space>
    </Form>
  );
};
export default B2bOrderLineListPage;
</file>

