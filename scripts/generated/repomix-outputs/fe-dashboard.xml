import { ProductTypeConfigurable, ProductTypeFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  ProductTypeFilterKeys,
  ProductTypeListFilterOpts,
} from "@src/app/views/settings/productTypes/components/ProductTypeListPage";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  ProductTypeListViewUrlFilters,
  ProductTypeListViewUrlFiltersEnum,
  ProductTypeListViewUrlQueryParams,
} from "../../urls";

export const PRODUCT_TYPE_FILTERS_KEY = "productTypeFilters";

export function getFilterOpts(params: ProductTypeListViewUrlFilters): ProductTypeListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    configurable: {
      active: maybe(() => !utils.isEmpty(filterVariables.configurable), false),
      value: maybe(
        () => findValueInEnum(filterVariables.configurable, ProductTypeConfigurable),
        ProductTypeConfigurable.CONFIGURABLE
      ),
    },
    isFulfilledByVendor: {
      active: maybe(() => filterVariables.isFulfilledByVendor !== undefined, false),
      value: maybe(() => filterVariables.isFulfilledByVendor, false),
    },
  };
}

export function getFilterVariables(params: ProductTypeListViewUrlFilters): ProductTypeFilterInput {
  return {
    configurable: params.configurable ? findValueInEnum(params.configurable, ProductTypeConfigurable) : undefined,
    isFulfilledByVendor:
      params.isFulfilledByVendor !== undefined ? parseBoolean(params.isFulfilledByVendor, false) : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<ProductTypeFilterKeys>): ProductTypeListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case ProductTypeFilterKeys.configurable:
      return getSingleValueQueryParam(filter, ProductTypeListViewUrlFiltersEnum.configurable);
    case ProductTypeFilterKeys.isFulfilledByVendor:
      return getSingleValueQueryParam(filter, ProductTypeListViewUrlFiltersEnum.isFulfilledByVendor);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<ProductTypeListViewUrlFilters>(PRODUCT_TYPE_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ProductTypeListViewUrlQueryParams,
  ProductTypeListViewUrlFilters
>(ProductTypeListViewUrlFiltersEnum);
