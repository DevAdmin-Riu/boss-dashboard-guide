<file path="src/app/components/antd/Form/utils.ts">
import { utils } from "@utils/utils";
import { Form, FormInstance } from "antd";
import _ from "lodash";

import { FieldPath, FieldPathValue } from "../types/GenericFieldPath";
import { TypeSafeFormInstance } from "./types";

export function getRecordsObject(records: any[]) {
  return records?.reduce((obj, record) => {
    obj[record.id] = record;
    return obj;
  }, {});
}

export class TypeSafeForm<TFormModel> {
  typeSafeFormInstance: TypeSafeFormInstance<TFormModel>;
  formInstance: FormInstance<TFormModel>;
  setFields: <N extends FieldPath<TFormModel>>(
    fields: Array<{
      name: N;
      value?: FieldPathValue<TFormModel, N>;
      touched?: boolean;
      validating?: boolean;
      errors?: string[];
      warnings?: string[];
    }>
  ) => void;
  getFieldValue: <N extends FieldPath<TFormModel>>(name: N) => FieldPathValue<TFormModel, N>;
  getFieldsValue: () => TFormModel;
  getValidDataIndex: <N extends FieldPath<TFormModel>>(name: N) => Array<string | number>;

  getSetFieldsParams: <N extends FieldPath<TFormModel>>(fields: {
    name: N;
    value?: FieldPathValue<TFormModel, N>;
    touched?: boolean;
    validating?: boolean;
    errors?: string[];
    warnings?: string[];
  }) => {
    name: Array<string | number>;
    value?: FieldPathValue<TFormModel, N>;
    touched?: boolean;
    validating?: boolean;
    errors?: string[];
    warnings?: string[];
  };
  getUseWatcherParams: <N extends FieldPath<TFormModel>>(fields: {
    name: N;
  }) => {
    namePath: Array<string | number>;
    formInstance: FormInstance<TFormModel>;
  };
  getUseFormWatched: <N extends FieldPath<TFormModel>>(fields: { name: N }) => FieldPathValue<TFormModel, N>;
  constructor(form: TypeSafeFormInstance<TFormModel>) {
    this.typeSafeFormInstance = form;
    this.formInstance = form as FormInstance<TFormModel>;
    this.getFieldValue = <N extends FieldPath<TFormModel>>(name: N): FieldPathValue<TFormModel, N> =>
      this.formInstance.getFieldValue(this.getValidDataIndex(name));
    this.getFieldsValue = () => this.formInstance.getFieldsValue(true);
    this.getValidDataIndex = <N extends FieldPath<TFormModel>>(name: N): Array<string | number> =>
      name.split(".").map((part) => {
        const num = parseInt(part, 10);
        if (!isNaN(num) && String(num) === part) {
          return num;
        }
        return part;
      });
    this.setFields = <N extends FieldPath<TFormModel>>(
      fields: Array<{
        name: N;
        value?: FieldPathValue<TFormModel, N>;
        touched?: boolean;
        validating?: boolean;
        errors?: string[];
        warnings?: string[];
      }>
    ) => {
      (this.typeSafeFormInstance as FormInstance<any>).setFields(fields.map((field) => this.getSetFieldsParams(field)));
    };
    this.getSetFieldsParams = <N extends FieldPath<TFormModel>>(fields: {
      name: N;
      value?: FieldPathValue<TFormModel, N>;
      touched?: boolean;
      validating?: boolean;
      errors?: string[];
      warnings?: string[];
    }): {
      name: Array<string | number>;
      value?: FieldPathValue<TFormModel, N>;
      touched?: boolean;
      validating?: boolean;
      errors?: string[];
      warnings?: string[];
    } => {
      const { name, ...fieldValues } = fields;
      return {
        ...fieldValues,
        name: this.getValidDataIndex(name),
      };
    };
    this.getUseWatcherParams = <N extends FieldPath<TFormModel>>(fields: {
      name: N;
    }): {
      namePath: Array<string | number>;
      formInstance: FormInstance<TFormModel>;
    } => ({
      namePath: this.getValidDataIndex(fields.name),
      formInstance: this.formInstance,
    });
    this.getUseFormWatched = <N extends FieldPath<TFormModel>>(fields: { name: N }): FieldPathValue<TFormModel, N> => {
      const { namePath, formInstance } = this.getUseWatcherParams(fields);
      return Form.useWatch(namePath, formInstance);
    };
  }
}

export const getTypeSafeForm = <TFormModel>(form: TypeSafeFormInstance<TFormModel>) => new TypeSafeForm(form);

export const convertFormLinesObjToArr = <T>(linesObj: Record<string, T>, lineKeyName: keyof T): T[] => {
  if (utils.isEmpty(linesObj)) {
    return [];
  }
  const linesArr = Object.values(linesObj).filter((line) => utils.isEmpty(line[lineKeyName], true) === false);
  return linesArr;
};

// antd Form에서 업로드 필드 초기값 세팅 시 이용
// urlKey는 대부분 "url"이므로 기본값으로 설정
export const toUploadFormInitialValue = <T>(uploadData: T, nameKey: FieldPath<T>, urlKey?: FieldPath<T>) => {
  if (!uploadData) {
    return undefined;
  }
  return {
    uid: "-1",
    status: "done",
    name: _.get(uploadData, nameKey),
    url: _.get(uploadData, urlKey || "url"),
  };
};

// antd Form에서 Upload 컴포넌트 통해 업로드 된 값만 뮤테이션 Input에 전달되도록 처리
// File 인스턴스가 아니면 파일이 변경 또는 추가된 것이 아니므로.
export const cleanFormDataUploadInputs = <T>(formData: T, uploadFieldNames: Array<FieldPath<T>>): T => {
  const clonedFormData = _.cloneDeep(formData);
  uploadFieldNames.forEach((field) => {
    const fieldValue = _.get(clonedFormData, field);
    if (fieldValue && !(fieldValue instanceof File)) {
      _.unset(clonedFormData, field);
    }
  });
  return clonedFormData;
};
</file>

