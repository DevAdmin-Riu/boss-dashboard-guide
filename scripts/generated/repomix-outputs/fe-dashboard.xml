};

interface PreFounderEvalInfoProps {
  TypeSafeForm: TypeSafeForm<TPreFounderEvalAnswerBulkUpsertFormData>;
  preFounder: HqPreFounderDetails_preFounder;
  evalItemList: PreFounderEvalItemList_preFounderEvalItemList[];
  editModeProps: FormSaveButtonEditModeProps;
}

const evalInfoCollapseKey = "eval";

export const PreFounderEvalInfo: React.FC<PreFounderEvalInfoProps> = (props) => {
  const { TypeSafeForm, preFounder, evalItemList, editModeProps } = props;
  const { isEditMode } = editModeProps;
  const { formInstance } = TypeSafeForm;
  const [collapseActiveKey, setCollapseActiveKey] = useState<string>(null);

  const isEvaluated = preFounder.evalStatus === PreFounderEvalStatusEnum.EVALUATED;
  const showEvalSnapshotTable = !isEditMode && isEvaluated;

  const detailsWatched = TypeSafeForm.getUseFormWatched({ name: "details" }) || [];

  const calcEvalTotalScore = () => {
    const weightSum = evalItemList.reduce((sum, item) => sum + item.weight, 0);
    if (weightSum === 0) {
      return null;
    }
    const notEvaluatedItemExist = detailsWatched.some((detail) => detail.score === undefined || detail.score === null);
    if (notEvaluatedItemExist) {
      return null;
    }
    const weightedSum = detailsWatched.reduce((sum, detail, idx) => {
      const item = evalItemList[idx];
      return sum + detail.score * item.weight;
    }, 0);
    return utils.convertToNumber(weightedSum / weightSum, 2, true);
  };
  const evalTotalScoreWatched = editModeProps.isEditMode ? calcEvalTotalScore() : preFounder.evalTotalScore;

  const cardTitle = (
    <PageHeader
      title="평가 정보"
      subTitle={`상태: ${utils.getLabelTextByValue(preFounder.evalStatus, preFounderEvalStatusChoices)}`}
    />
  );
  const cardExtra = (
    <FormSaveButton
      {...props.editModeProps}
      onEdit={() => {
        setCollapseActiveKey(evalInfoCollapseKey);
        props.editModeProps.onEdit();
      }}
      form={formInstance}
      buttonText={{ edit: isEvaluated ? "재평가" : "평가" }}
    />
  );

  const columns: ColumnsType<FormListFieldData> = [
    {
      title: columnNameConstant.common.NAME,
      key: "name",
      width: 100,
      render: (_, record) => (
        <>
          <Form.Item hidden name={[record.name, "item"]}>
            <Input />
          </Form.Item>
          {evalItemList[record.name].name}
        </>
      ),
    },
    {
      title: columnNameConstant.preFounder.EVAL_DESCRIPTION,
      key: "description",
      width: 150,
      render: (_, record) => (
        <div style={{ whiteSpace: "pre-line" }}>{evalItemList[record.name].description || "-"}</div>
      ),
    },
    {
      title: columnNameConstant.preFounder.EVAL_WEIGHT,
      key: "weight",
      align: "right",
      width: 80,
      render: (_, record) => evalItemList[record.name].weight,
    },
    {
      title: columnNameConstant.preFounder.EVAL_SCORE,
      key: "score",
      align: isEditMode ? "center" : "right",
      width: isEditMode ? 120 : 80,
      render: (_, record) => (
        <EditableField
          formItemStyle={{ margin: 0 }}
          type="rate"
          name={[record.name, "score"]}
          value={TypeSafeForm.getFieldValue(`details.${record.name}.score`)}
          editMode={isEditMode}
        />
      ),
    },
    {
      title: "이유",
      key: "reason",
      width: 150,
      render: (_, record) => (
        <EditableField
          formItemStyle={{ margin: 0 }}
          type="textarea"
          name={[record.name, "reason"]}
          value={TypeSafeForm.getFieldValue(`details.${record.name}.reason`)}
          editMode={isEditMode}
        />
      ),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Collapse
      collapsible="header"
      activeKey={collapseActiveKey}
      onChange={(key) => setCollapseActiveKey(key as string)}
    >
      <Collapse.Panel key={evalInfoCollapseKey} header={cardTitle} extra={cardExtra}>
        <Form.Item hidden={showEvalSnapshotTable}>
          <Form.List name={TypeSafeForm.getValidDataIndex("details")}>
            {(fields) => (
              <Table<FormListFieldData>
                // sticky 제외한 commonTableProps. Collapse 내부에서 닫혀있을 때 top: 80px가 적용되며 레이아웃 깨짐
                {..._.omit(commonTableProps, ["sticky"])}
                rowKey={(record) => record.key}
                columns={columns}
                dataSource={fields}
                scroll={{ x: tableWidthSum }}
                summary={() => (
                  <Table.Summary>
                    <Table.Summary.Row>
                      <Table.Summary.Cell index={0} colSpan={3} align="center">
                        <Typography.Text strong>평가 점수 합계</Typography.Text>
                      </Table.Summary.Cell>
                      <Table.Summary.Cell index={3} align="right">
                        <Typography.Text strong>{evalTotalScoreWatched ?? "-"}</Typography.Text>
                      </Table.Summary.Cell>
                      <Table.Summary.Cell index={4} />
                    </Table.Summary.Row>
                  </Table.Summary>
                )}
              />
            )}
          </Form.List>
        </Form.Item>
        {showEvalSnapshotTable && makeLastEvalSnapshotTable(preFounder)}
      </Collapse.Panel>
    </Collapse>
  );
};
