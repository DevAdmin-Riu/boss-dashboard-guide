  let title = "";
  switch (menuType) {
    case "operation-manual":
      title = sectionNames.operationManuals;
      break;
    case "menu-recipe":
      title = sectionNames.menuRecipes;
      break;
  }

  const tagListQueryVariables: BsTrainingDocFilterInput = useMemo(
    () => ({
      ownerBrand: isHqStaff ? user?.brand.id : ownerBrandWatched,
      type: convertFilterBsTrainingDocType(menuType),
    }),
    [routeParams.menuType, ownerBrandWatched]
  );
  const { data: tagListData, loading: tagListLoading } = useBsTrainingTagListQuery({
    skip: !isHqStaff && utils.isEmpty(ownerBrandWatched),
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: tagListQueryVariables,
    },
  });
  const tagList = maybe(() => tagListData.bsTrainingTagList.edges.map((edge) => edge.node), []);

  const { data: brandListData, loading: brandListLoading } = useBsTrainingTagSimpleBrandListQuery({
    forceFetchPolicy: "cache-first",
    skip: isHqStaff,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { enabledServices: [BrandServiceTypeEnum.LINKERS] },
    },
  });
  const brandList = maybe(() => brandListData.brands.edges.map((edge) => edge.node), []);

  const [bsTrainingDocCreate, bsTrainingDocCreateOpts] = useBsTrainingDocCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bsTrainingDocCreate.errors, `${title} 작성 완료`, () =>
        navigate(hqTrainingDocDetailsViewUrl(data.bsTrainingDocCreate.bsTrainingDoc.id))
      ),
  });

  const handleCreate = async (formData: BsTrainingDocCreateForm) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: BsTrainingDocInput = {
      ...formData,
      type: convertFilterBsTrainingDocType(menuType),
      content: convertedContent,
    };

    await bsTrainingDocCreate({ variables: { input } });
  };

  const handleBack = () => navigate(hqTrainingDocListViewUrl(routeParams));

  const pageLoading = bsTrainingDocCreateOpts.loading || tagListLoading || brandListLoading;

  return (
    <>
      <WindowTitle title={title} />

      <Form
        form={form}
        disabled={pageLoading}
        name="bs-training-doc-create"
        layout="vertical"
        initialValues={initialValues}
        onFinish={handleCreate}
        onValuesChange={(changedValues) => {
          if (TypeSafeForm.getValidDataIndex("ownerBrand")[0] in changedValues) {
            TypeSafeForm.setFields([{ name: "tags", value: undefined }]);
          }
        }}
      >
        <HqTrainingDocCreatePage
          form={form}
          title={title}
          disabled={pageLoading}
          tagList={tagList}
          brandList={brandList}
          onBack={() => handleBack()}
        />
      </Form>
    </>
  );
};

export default HqTrainingDocCreateView;
</file>

<file path="src/app/views/hqStaff/HqTrainingDoc/views/HqTrainingDocDetailsView.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import {
  BrandServiceTypeEnum,
  BsTrainingDocFilterInput,
  BsTrainingDocInput,
  BsTrainingDocTypeEnum,
} from "@src/api/types/globalTypes";
import { convertMarkdownToContentJsonStr } from "@src/app/components/Editor/utils";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useMemo, useState } from "react";

import { useBsTrainingDocUpdateMutation } from "../api/mutations";
import { useBsTrainingDocQuery, useBsTrainingTagListQuery, useBsTrainingTagSimpleBrandListQuery } from "../api/queries";
import HqTrainingDocDetailsPage, {
  BsTrainingDocBasicInfoUpdateForm,
  BsTrainingDocVisibilityUpdateForm,
} from "../components/HqTrainingDocDetailsPage";
import { hqTrainingDocListViewUrl, TrainingDocMenuType } from "../urls";

export interface HqTrainingDocDetailsViewProps {
  id: string;
}

export enum BsTrainingDocDetailsEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateVisibility = "UpdateVisibility",
}

const HqTrainingDocDetailsView: React.FC<HqTrainingDocDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();
  const { user } = useUser();
  const { isHqStaff } = user;
  const [editMode, setEditMode] = useState<BsTrainingDocDetailsEditModeEnum>(null);

  const onEdit = (mode: BsTrainingDocDetailsEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };

  const { data, loading } = useBsTrainingDocQuery({ skip: utils.isEmpty(id), variables: { id } });
  const bsTrainingDoc = maybe(() => data.bsTrainingDoc, null);

  let menuTypeRouteParams: TrainingDocMenuType;
  let title: string;
  switch (bsTrainingDoc?.type) {
    case BsTrainingDocTypeEnum.OP_MANUAL:
      menuTypeRouteParams = "operation-manual";
      title = sectionNames.operationManuals;
      break;
    case BsTrainingDocTypeEnum.RECIPE:
      menuTypeRouteParams = "menu-recipe";
      title = sectionNames.menuRecipes;
      break;
    default:
      break;
  }

  const tagListQueryVariables: BsTrainingDocFilterInput = useMemo(
    () => ({
      ownerBrand: isHqStaff ? user.brand.id : bsTrainingDoc?.ownerBrand.id,
      type: bsTrainingDoc?.type,
    }),
    [bsTrainingDoc?.ownerBrand.id, bsTrainingDoc?.type]
  );
  const { data: tagListData, loading: tagListLoading } = useBsTrainingTagListQuery({
    skip: !isHqStaff && utils.isEmpty(bsTrainingDoc),
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: tagListQueryVariables,
    },
  });

  const { data: brandListData, loading: brandListLoading } = useBsTrainingTagSimpleBrandListQuery({
    forceFetchPolicy: "cache-first",
    skip: isHqStaff,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { enabledServices: [BrandServiceTypeEnum.LINKERS] },
    },
  });

  const [bsTrainingDocUpdate, bsTrainingDocUpdateOpts] = useBsTrainingDocUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bsTrainingDocUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  const handleBasicInfoUpdate = async (formData: BsTrainingDocBasicInfoUpdateForm) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: BsTrainingDocInput = {
      type: bsTrainingDoc.type,
      ownerBrand: bsTrainingDoc.ownerBrand.id,
      title: formData.title,
      content: convertedContent,
    };

    await bsTrainingDocUpdate({ variables: { id, input } });
  };

  const handleVisibilityUpdate = async (formData: BsTrainingDocVisibilityUpdateForm) => {
    const input: BsTrainingDocInput = {
      ...formData,
      type: bsTrainingDoc.type,
    };

    await bsTrainingDocUpdate({ variables: { id, input } });
  };

  const handleBack = () => navigate(hqTrainingDocListViewUrl({ menuType: menuTypeRouteParams }));

  const pageLoading = loading || bsTrainingDocUpdateOpts.loading || tagListLoading || brandListLoading;

  if (loading) {
    return <Loader />;
  }
  return (
    <>
      <WindowTitle title={title} />
      <HqTrainingDocDetailsPage
        disabled={pageLoading}
        title={title}
        bsTrainingDoc={bsTrainingDoc}
        tagList={maybe(() => tagListData.bsTrainingTagList.edges.map((edge) => edge.node), [])}
        brandList={maybe(() => brandListData.brands.edges.map((edge) => edge.node), [])}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onVisibilityUpdate={handleVisibilityUpdate}
        onBack={() => handleBack()}
      />
    </>
  );
};

export default HqTrainingDocDetailsView;
</file>

<file path="src/app/views/hqStaff/HqTrainingDoc/urls.ts">
import { ActiveTab, Dialog, Filters, Pagination, SingleAction, TabActionDialog } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

import { hqSectionUrl } from "../hqSection/urls";

export const trainingDocUrl = "/training-docs";

export const hqTrainingDocPath = urlJoin(hqSectionUrl, trainingDocUrl);

export type TrainingDocMenuType = "operation-manual" | "menu-recipe";
export interface TrainingDocListViewRouteParams {
  menuType?: TrainingDocMenuType | ":menuType";
}

export enum TrainingDocListViewUrlFiltersEnum {
  tagSearch = "tagSearch",
  titleSearch = "titleSearch",
  createdDateFrom = "createdDateFrom",
  createdDateTo = "createdDateTo",
  publishDateFrom = "publishDateFrom",
  publishDateTo = "publishDateTo",
  brandSearch = "brandSearch",
  published = "published",
}

export type TrainingDocListViewFilters = Filters<TrainingDocListViewUrlFiltersEnum>;
export type TrainingDocListViewUrlDialog = TabActionDialog | "cancel";

export type TrainingDocListViewUrlQueryParams = SingleAction &
  Dialog<TrainingDocListViewUrlDialog> &
  TrainingDocListViewFilters &
  Pagination &
  ActiveTab;

// 가맹본부 admin url

export const hqTrainingDocListViewPath = (routeParams: TrainingDocListViewRouteParams): string =>
  urlJoin(hqTrainingDocPath, routeParams.menuType);

export const hqTrainingDocListViewUrl = (
  routeParams: TrainingDocListViewRouteParams,
  params?: TrainingDocListViewUrlQueryParams
): string => {
  if (params === undefined) {
    return hqTrainingDocListViewPath(routeParams);
  } else {
    return urlJoin(hqTrainingDocListViewPath(routeParams), "?" + stringifyQs(params));
  }
};

const trainingDocAddPath = "add";

export const hqTrainingDocCreateViewPath = (routeParams: TrainingDocListViewRouteParams): string =>
  urlJoin(hqTrainingDocListViewPath(routeParams), trainingDocAddPath);
export const hqTrainingDocCreateViewUrl = (routeParams: TrainingDocListViewRouteParams): string =>
  hqTrainingDocCreateViewPath(routeParams);

const trainingDocDetailsPath = urlJoin(hqTrainingDocPath, "detail");

export const hqTrainingDocDetailsViewPath = (id: string): string => urlJoin(trainingDocDetailsPath, id);
export const hqTrainingDocDetailsViewUrl = (id: string): string => hqTrainingDocDetailsViewPath(encodeURIComponent(id));

// 운영 admin url
export const trainingDocPath = urlJoin(trainingDocUrl);

export const trainingDocListViewPath = (routeParams: TrainingDocListViewRouteParams): string =>
  urlJoin(trainingDocPath, routeParams.menuType);

export const trainingDocListViewUrl = (
  routeParams: TrainingDocListViewRouteParams,
  params?: TrainingDocListViewUrlQueryParams
): string => {
  if (params === undefined) {
    return trainingDocListViewPath(routeParams);
  } else {
    return urlJoin(trainingDocListViewPath(routeParams), "?" + stringifyQs(params));
  }
};

export const trainingDocCreateViewPath = (routeParams: TrainingDocListViewRouteParams): string =>
  urlJoin(trainingDocListViewPath(routeParams), trainingDocAddPath);
export const trainingDocCreateViewUrl = (routeParams: TrainingDocListViewRouteParams): string =>
  trainingDocCreateViewPath(routeParams);

export const trainingDocDetailsViewPath = (id: string): string => urlJoin(trainingDocDetailsPath, id);
export const trainingDocDetailsViewUrl = (id: string): string => trainingDocDetailsViewPath(encodeURIComponent(id));
</file>

