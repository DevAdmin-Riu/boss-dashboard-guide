import { ShopSettingsInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { useShopBannerSettingsUpdateMutation } from "@src/app/views/settings/siteSettings/api/mutations";
import { ShopBannerSettings_shop } from "@src/app/views/settings/siteSettings/api/types/ShopBannerSettings";
import { commonMsg, formRuleMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Col, Form, InputNumber, Modal, Row, Space, Typography } from "antd";
import React, { useEffect } from "react";

const { Text } = Typography;

type TShopBannerSettingsUpdateForm = Pick<ShopSettingsInput, "displayBannersPc" | "displayBannersMobile">;

interface ShopBannerSettingsDialogProps {
  shopBannerSettings: ShopBannerSettings_shop;
  open: boolean;
  loading: boolean;
  onClose(): any;
}

const ShopBannerSettingsModal: React.FC<ShopBannerSettingsDialogProps> = ({
  shopBannerSettings,
  open,
  loading,
  onClose,
}) => {
  const [form] = Form.useForm<TShopBannerSettingsUpdateForm>();

  const initialValues: TShopBannerSettingsUpdateForm = {
    displayBannersPc: shopBannerSettings.displayBannersPc,
    displayBannersMobile: shopBannerSettings.displayBannersMobile,
  };

  const [shopBannerSettingsUpdate, shopBannerSettingsUpdateOpts] = useShopBannerSettingsUpdateMutation({
    onCompleted: (data) => {
      const errors = data.shopSettingsUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const modalLoading = loading || shopBannerSettingsUpdateOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      closable={false}
      title="배너 수 설정"
      confirmLoading={modalLoading}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={form}
        size="large"
        layout="vertical"
        name="shop-banner-settings-update-form"
        initialValues={initialValues}
        onFinish={(formData) => shopBannerSettingsUpdate({ variables: { shopSettingsInput: formData } })}
      >
        <Space direction="vertical" size="small">
          <Row justify="space-between" gutter={[12, 12]}>
            <Col xs={24} sm={12}>
              <Form.Item
                label="PC"
                name="displayBannersPc"
                rules={[
                  { required: true, message: formRuleMsg.required },
                  { type: "integer", min: 1, max: 4, message: formRuleMsg.between(1, 4) },
                ]}
              >
                <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item
                label="모바일"
                name="displayBannersMobile"
                rules={[
                  { required: true, message: formRuleMsg.required },
                  { type: "integer", min: 1, max: 2, message: formRuleMsg.between(1, 2) },
                ]}
              >
                <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
              </Form.Item>
            </Col>
          </Row>
          <Text>보스몰에서 한 번에 표시할 배너의 수 설정</Text>
          <Text type="danger">PC/태블릿 최대 4개, 모바일 최대 2개</Text>
        </Space>
      </Form>
    </Modal>
  );
};

export default ShopBannerSettingsModal;
