  const isB2b = purchaseOrder.isB2b;

  const isB2bTackBack = isB2b && isConsignmentTakeBackPurchaseOrder;

  let columns: DownloadableEditableColumnsType<PurchaseOrderDetails_purchaseOrder_lines> = [];

  const numberColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
