import usePermissionGroupSearch from "@src/api/searches/usePermissionGroupSearch";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { makeRedirectUrlToResetPassword } from "@src/app/views/auth/urls";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useStaffMemberAdd } from "../../api/mutations";
import { useStaffListQuery } from "../../api/queries";
import { StaffListVariables } from "../../api/types/StaffList";
import { StaffMemberAdd } from "../../api/types/StaffMemberAdd";
import StaffAddMemberDialog, { AddMemberFormData } from "../../components/StaffAddMemberDialog";
import StaffListPage from "../../components/StaffListPage";
import { staffDetailsViewUrl, staffListViewUrl, StaffListViewUrlDialog, StaffListViewUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface StaffListViewProps {
  params: StaffListViewUrlQueryParams;
}

export const StaffListView: React.FC<StaffListViewProps> = ({ params }) => {
  const shop = useShop();
  const targetUrl = staffListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.STAFF_LIST,
  });

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const queryVariables: StaffListVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useStaffListQuery({
    variables: queryVariables,
  });

  const handleSort = createSortHandler(navigate, staffListViewUrl, params);

  const handleStaffMemberAddSuccess = (data: StaffMemberAdd) => {
    const errors = data.staffCreate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(staffDetailsViewUrl(data.staffCreate.user.id));
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.staffUsers?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<StaffListViewUrlDialog, StaffListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const {
    loadMore: loadMorePermissionGroups,
    search: searchPermissionGroups,
    result: searchPermissionGroupsOpts,
  } = usePermissionGroupSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });

  const [addStaffMember, addStaffMemberData] = useStaffMemberAdd({
    onCompleted: handleStaffMemberAddSuccess,
  });

  const handleStaffMemberAdd = (variables: AddMemberFormData) =>
    addStaffMember({
      variables: {
        input: {
          addGroups: variables.permissionGroups,
          loginId: variables.loginId,
          email: variables.email,
          firstName: variables.firstName,
          lastName: variables.lastName,
          redirectUrl: makeRedirectUrlToResetPassword(),
        },
      },
    });

  return (
    <>
      <StaffListPage
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        disabled={loading || addStaffMemberData.loading}
        settings={settings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        staffMembers={data?.staffUsers.edges.map((edge) => edge.node)}
        onAdd={() => openModal("add")}
        onBack={() => navigate(configurationSectionUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(staffDetailsViewUrl(id))}
        onSort={handleSort}
      />
      <StaffAddMemberDialog
        availablePermissionGroups={searchPermissionGroupsOpts.data?.search.edges.map((edge) => edge.node)}
        confirmButtonState={addStaffMemberData.status}
        initialSearch=""
        disabled={loading}
        errors={addStaffMemberData.data?.staffCreate.errors || []}
        open={params.action === "add"}
        onClose={closeModal}
        onConfirm={handleStaffMemberAdd}
        fetchMorePermissionGroups={{
          hasMore: searchPermissionGroupsOpts.data?.search.pageInfo.hasNextPage,
          loading: searchPermissionGroupsOpts.loading,
          onFetchMore: loadMorePermissionGroups,
        }}
        onSearchChange={searchPermissionGroups}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

