interface ProductVariantNavigationProps {
  current?: string;
  defaultVariantId: string;
  variants: Array<ProductVariantDetails_productVariant | ProductForCreateVariant_product_outerVariants>;
  onAdd?: () => void;
  onCopyAdd?: () => void;
  onRowClick: (variantId: string) => void;
  onReorder: ReorderAction;
}

export const ProductVariantNavigation: React.FC<ProductVariantNavigationProps> = (props) => {
  const { current, defaultVariantId, variants, onAdd, onCopyAdd, onRowClick, onReorder } = props;
  const columns: ColumnsType<ProductVariantDetails_productVariant | ProductForCreateVariant_product_outerVariants> = [
    {
      key: "sort",
      align: "center",
      width: "40px",
      render: () => <DragHandle />,
    },
    {
      title: "옵션명",
      key: "name",
      align: "left",
      render: (_, record) => {
        const isDefault = record && record.id === defaultVariantId;
        return (
          <Space direction={"vertical"} size={0}>
            {isDefault && <Tag color={"warning"}>기본</Tag>}
            <Space direction={"horizontal"}>
              <Typography.Text>[{record.sku}]</Typography.Text>
              {utils.isEmpty(record?.name) ? (
                <Typography.Text type="secondary">옵션명 미입력</Typography.Text>
              ) : (
                <Typography.Text>{record.name}</Typography.Text>
              )}
            </Space>
          </Space>
        );
      },
    },
  ];
  const numOfColumns = columns.length;

  const rowSelection: TableRowSelection<
    ProductVariantDetails_productVariant | ProductForCreateVariant_product_outerVariants
  > = {
    type: "radio",
    selectedRowKeys: [current],
    onSelect: (record) => onRowClick(record.id),
  };

  const DraggableContainer = (props: SortableContainerProps) => (
    <SortableBody useDragHandle onSortEnd={onReorder} {...props} />
  );

  const DraggableBodyRow: React.FC<any> = ({ className, style, ...restProps }) => {
    const index = variants?.findIndex((data) => data.id === restProps["data-row-key"]) || 0;
    return <SortableItem index={index} {...restProps} />;
  };

  const tableSummary = () => (
    <Table.Summary>
      <Table.Summary.Row>
        {onAdd ? (
          <Table.Summary.Cell index={0} colSpan={numOfColumns}>
            <Space direction="vertical" size={4}>
              <Space>
                <Button type={"primary"} onClick={onAdd} shape="round">
                  <Typography.Link strong>옵션 생성</Typography.Link>
                </Button>
                {current && onCopyAdd && (
                  <Button type={"primary"} onClick={onCopyAdd} shape="round">
                    <Typography.Link strong>옵션 복사 생성</Typography.Link>
                  </Button>
                )}
              </Space>
            </Space>
          </Table.Summary.Cell>
        ) : (
          <>
            <Table.Summary.Cell index={0} />
            <Table.Summary.Cell index={1} />
            <Table.Summary.Cell index={2}>
              <Space direction="vertical" size={4}>
                <Typography.Text>새 옵션</Typography.Text>
                <Typography.Text type="success" style={{ fontSize: 12 }} strong>
                  옵션 복사 생성을 하려면 복사할 원본 옵션을 선택한 후 "옵션 복사 생성" 버튼을 눌러주세요
                </Typography.Text>
              </Space>
            </Table.Summary.Cell>
          </>
        )}
      </Table.Summary.Row>
    </Table.Summary>
  );

  const cardContent = (
    <Table
      {...commonTableProps}
      bordered={false}
      showHeader={false}
      columns={columns}
      dataSource={variants}
      rowSelection={rowSelection}
      components={{
        body: {
          wrapper: DraggableContainer,
          row: DraggableBodyRow,
        },
      }}
      summary={tableSummary}
    />
  );

  return (
    <Card title={<CardTitleAntd title={"옵션 리스트"} />} bodyStyle={{ padding: "1px 0px 0px 0px" }}>
      {cardContent}
    </Card>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductVariants.tsx">
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { NumberComponent } from "@src/app/components/Number";
import {
  DraggableBodyRow,
  DraggableBodyRowProps,
  DraggableContainer,
  DraggableContainerProps,
  DragHandle,
} from "@src/app/components/SortableTable/SortableTableAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ReorderAction } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { isStoppedSalesStatus, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Empty, Row, Select, Space, Table, Tag, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { getAvailableQtyConsiderVirtualAlloc } from "../../stock/utils";
import {
  ProductDetails_product,
  ProductDetails_product_outerVariants,
  ProductDetails_product_outerVariants_stocks_warehouse,
} from "../api/types/ProductDetails";
import { getNumberFormat } from "../utils/data";
import {
  makeProductCostPriceColTitle,
  makeProductDeliveryFeeColTitle,
  makeProductSupplyTotalColTitle,
} from "./ProductPricing/ProductPricingTableSettings";
import { ProductVariantSetDefault } from "./ProductVariantSetDefault";

function getWarehouseChoices(variants: ProductDetails_product_outerVariants[]): DefaultOptionType[] {
  return [
    {
      label: "모든 물류센터",
      value: "",
    },
    ...variants
      .reduce<ProductDetails_product_outerVariants_stocks_warehouse[]>(
        (warehouses, variant) => [
          ...warehouses,
          ...variant.stocks.reduce<ProductDetails_product_outerVariants_stocks_warehouse[]>((variantStocks, stock) => {
            if (!!warehouses.find((w) => w.id === stock.warehouse.id)) {
              return variantStocks;
            }

            return [...variantStocks, stock.warehouse];
          }, []),
        ],
        []
      )
      .map((w) => ({
        label: w.name,
        value: w.id,
      })),
  ];
}

const stockStatusRender = (variant: ProductDetails_product_outerVariants) => {
  if (!variant) {
    return null;
  }

  const isTrackInventoryVariant = variant.trackInventory;
  const isConsignment = isTrackInventoryVariant === false;
  if (isConsignment) {
    return <Tag color="gray">위탁</Tag>;
  }

  const isSafety = variant.isSafety;
  const allowAutoConsignment = variant.allowAutoConsignment;
  const salesStatus = variant.salesStatus;
  const isStopped = isStoppedSalesStatus(salesStatus);
  const color = isStopped ? "gray" : isSafety ? "green" : "red";
  const status = isStopped ? "단종" : isSafety ? "안전" : "위험";

  const stockTotalQuantity = variant.stocks ? variant.stocks.reduce((acc, s) => acc + s.quantity, 0) : 0;
  // 제품 옵션 섹션 테이블에는 아우터박스 제품 단위로만 표시되므로 아우터박스의 가용 재고를 표시
  const availableQtyConsiderVirtualAlloc = getAvailableQtyConsiderVirtualAlloc(variant);

  const qtyTextArr = [
    `전체: ${getNumberFormat(stockTotalQuantity)}`,
    `가용: ${getNumberFormat(availableQtyConsiderVirtualAlloc)}`,
  ];
  if (isTrackInventoryVariant) {
    qtyTextArr.push(`안전: ${getNumberFormat(variant.safetyStockQty)}`);
  }
  const qtyText = qtyTextArr.join(" / ");

  return (
    <Space direction="vertical" size={0}>
      <Space size={0}>
        <Tag color={color}>{status}</Tag>
        {isTrackInventoryVariant && allowAutoConsignment && <Tag color={"orange"}>자동위탁</Tag>}
      </Space>
      <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
        {qtyText}
      </Typography.Text>
    </Space>
  );
};

interface ProductVariantsProps {
  disabled: boolean;
  product: ProductDetails_product;
  variants: ProductDetails_product_outerVariants[];
  onVariantReorder: ReorderAction;
  onRowClick: (id: string) => void;
  onSetDefaultVariant: (variantId: string) => void;
  onVariantAdd?: () => void;
}

export const ProductVariants: React.FC<ProductVariantsProps> = (props) => {
  const { disabled, variants, product, onRowClick, onVariantAdd, onVariantReorder, onSetDefaultVariant } = props;
  const [selectedWarehouse, setSelectedWarehouse] = useState<string>("");
  const [dataSource, setDataSource] = useState<ProductDetails_product_outerVariants[]>([]);

  useEffect(() => {
    const newDataSource = variants?.filter((variant) => {
      if (utils.isEmpty(selectedWarehouse, true)) {
        return true;
      }
      const warehouseIds = variant?.stocks?.map((stock) => stock?.warehouse?.id);
      return warehouseIds?.includes(selectedWarehouse);
    });
    setDataSource(newDataSource);
  }, [variants, selectedWarehouse]);

  const variantsExist = maybe(() => variants.length > 0, false);
  const tableTitle = () => (
    <Row>
      <Col xs={24} sm={12}>
        {variantsExist ? (
          <Space align="center">
            <Typography>다음 물류센터의 재고: </Typography>
            <Select
              style={{ width: 150 }}
              options={getWarehouseChoices(variants)}
              value={selectedWarehouse}
              onChange={(value) => setSelectedWarehouse(value)}
            />
          </Space>
        ) : (
          <Typography.Text type="secondary">
            한 제품의 규격이나 색상이 다른 버전이 있는 경우 옵션을 활용할 수 있습니다.
          </Typography.Text>
        )}
      </Col>
      <Col xs={24} sm={12}>
        <TableVatLegend size="small" isIncludeVat={false} />
      </Col>
    </Row>
  );
  const cardExtra = (
    <Button type={"text"} onClick={onVariantAdd}>
      <Typography.Link strong>옵션 추가</Typography.Link>
    </Button>
  );

  const columns: ColumnsType<ProductDetails_product_outerVariants> = [
    {
      key: "sort",
      width: 40,
      align: "center",
      fixed: "left",
      render: () => <DragHandle />,
    },
    {
      title: "제품코드",
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => (
        <Button type={"link"} onClick={() => onRowClick(record.id)}>
          {record?.sku || "-"}
        </Button>
      ),
    },
    {
      title: "옵션명",
      key: "name",
      align: "center",
      width: 150,
      render: (_, record) => {
        const isDefault = product?.defaultVariant?.id === record.id;
        return (
          <Space direction={"vertical"} size={0}>
            {isDefault && <Tag color={"warning"}>기본</Tag>}
            {record.name || "-"}
          </Space>
        );
      },
    },
    {
      title: "재고 판매",
      children: [
        {
          title: makeProductCostPriceColTitle(),
          key: "costPriceExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => {
            if (record.trackInventory) {
              return <NumberComponent value={record.costPriceExcludeVat} />;
            } else {
              return "-";
            }
          },
        },
        {
          title: makeProductDeliveryFeeColTitle(),
          key: "deliveryFeeExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => {
            if (record.trackInventory) {
              return <NumberComponent value={toPriceExcludeVat(record.deliveryFeeAmount)} />;
            } else {
              return "-";
            }
          },
        },
        {
          title: makeProductSupplyTotalColTitle(),
          key: "priceExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => {
            if (record.trackInventory) {
              const priceExcludeVat = record.costPriceExcludeVat + toPriceExcludeVat(record.deliveryFeeAmount);
              return <NumberComponent value={priceExcludeVat} />;
            } else {
              return "-";
            }
          },
        },
      ],
    },
    {
      title: "위탁 판매",
      children: [
        {
          title: makeProductCostPriceColTitle(),
          key: "consignmentCostPriceExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => <NumberComponent value={record.consignmentCostPriceExcludeVat} />,
        },
        {
          title: makeProductDeliveryFeeColTitle(),
          key: "consignmentDeliveryFeeExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.consignmentDeliveryFeeAmount)} />,
        },
        {
          title: makeProductSupplyTotalColTitle(),
          key: "consignmentPriceExcludeVat",
          align: "right",
          width: 120,
          render: (_: any, record) => {
            const consignmentPriceExcludeVat =
              record.consignmentCostPriceExcludeVat + toPriceExcludeVat(record.consignmentDeliveryFeeAmount);
            return <NumberComponent value={consignmentPriceExcludeVat} />;
          },
        },
      ],
    },
    {
      title: "재고 상태",
      key: "stockStatus",
      align: "center",
      width: 150,
      render: (_, record) => stockStatusRender(record),
    },
    {
      key: "action",
      align: "center",
      width: 50,
      fixed: "right",
      render: (_, record) =>
        record.id !== product?.defaultVariant?.id && (
          <ProductVariantSetDefault onSetDefaultVariant={() => onSetDefaultVariant(record.id)} />
        ),
    },
  ];

  return (
    <Card title={<CardTitleAntd title={"옵션"} extra={cardExtra} />} bodyStyle={{ padding: 0 }}>
      <Table
        {...commonTableProps}
        title={tableTitle}
        columns={columns}
        dataSource={dataSource}
        scroll={{ x: "max-content" }}
        components={{
          body: {
            wrapper: (draggableContainerProps: DraggableContainerProps) =>
              DraggableContainer({ ...draggableContainerProps, onSortEnd: onVariantReorder }),
            row: (draggableBodyRowProps: DraggableBodyRowProps) =>
              DraggableBodyRow({ ...draggableBodyRowProps, disabled, dataSource }),
          },
        }}
        locale={{
          emptyText: <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description="옵션이 존재하지 않습니다." />,
        }}
      />
    </Card>
  );
};
</file>

