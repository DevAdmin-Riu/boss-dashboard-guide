} from "./utils";
export const calcSumOfStockQuantity = (record: {
  stocks: Array<Pick<ProductVariantList_productVariants_edges_node_stocks, "quantity">>;
}) => {
  const stocks = record?.stocks ?? [];
  const sumOfStockQuantity = stocks.reduce((sum, stock) => sum + stock.quantity, 0);
  return sumOfStockQuantity;
};

// onCell 스타일 적용 헬퍼 함수
const getOnCellStyle =
  (type: SalesInfoType, isFbv: boolean) => (record: ProductVariantList_productVariants_edges_node) => {
    const showNA = shouldShowNAValue({ type, record, isFbv });
    return showNA ? { style: naValueCellStyle } : {};
  };

// NOTE: Stock 모델의 unique_together = ("product_variant", "warehouse") 이므로, 특정 상품의 stocks에서 특정 물류센터에 대한 stock은 1개만 존재함이 보장됨.
export const getStockByWarehouse = (
  stocks: Array<Pick<ProductVariantList_productVariants_edges_node_stocks, "id" | "quantity" | "warehouse">>,
  warehouseId: string
) => stocks?.find((stock) => stock?.warehouse?.id === warehouseId);

const getRackCellColSpan = (
  record: ProductVariantList_productVariants_edges_node,
  warehouseId: string,
  isRackColumn: boolean
): number => {
  const stock = getStockByWarehouse(record.stocks, warehouseId);
  const stockExist = !utils.isEmpty(stock);
  if (!stockExist) {
    return isRackColumn ? 3 : 0;
  }
  return 1;
};

export const makeStockQtyAdjustButtons = (
  variant: Pick<ProductVariantList_productVariants_edges_node, "id" | "isSubPv"> & {
    stocks: Array<Pick<ProductVariantList_productVariants_edges_node_stocks, "id" | "quantity" | "warehouse">>;
  },
  warehouseId: string,
  openModalWithoutNavigate: (modalMode: StockListModalModeEnum, idForModal?: string) => void,
  isFbv: boolean
) => {
  const stock = getStockByWarehouse(variant.stocks, warehouseId);
  if (utils.isEmpty(stock)) {
    return <Typography.Text type="secondary">재고 정보 없음</Typography.Text>;
  }
  const sumOfWarehouseStock = <NumberComponent value={stock.quantity} />;
  const isNegativeQuantity = stock.quantity < 0;

  return (
    <Space direction="vertical">
      <Row justify="space-between">
        <Button
          type="primary"
          size="small"
          disabled={isNegativeQuantity || stock.quantity === 0}
          icon={<MinusOutlined />}
          onClick={() => openModalWithoutNavigate(StockListModalModeEnum.StockDetailLoss, variant.id)}
        />
        {sumOfWarehouseStock}
        <Button
          type="primary"
          size="small"
          disabled={variant.isSubPv && isNegativeQuantity}
          icon={<PlusOutlined />}
          onClick={() => openModalWithoutNavigate(StockListModalModeEnum.StockDetailAdd, variant.id)}
        />
      </Row>
      {variant.isSubPv && (
        <Button
          style={{ width: "100%" }}
          type="primary"
          size="small"
          disabled={isNegativeQuantity === false}
          onClick={() => openModalWithoutNavigate(StockListModalModeEnum.StockDetailAdjustToZero, stock?.id)}
        >
          음수 재고 조정
        </Button>
      )}
      {variant.isSubPv === false && isFbv === false && (
        <Button
          style={{ width: "100%" }}
          type="primary"
          size="small"
          onClick={() => openModalWithoutNavigate(StockListModalModeEnum.StockDetailDivideOrCombine, variant.id)}
        >
          재고 전환
        </Button>
      )}
    </Space>
  );
};

const makeWarehouseColumns = (
  props: StockListPageProps,
  routeParams: StockListViewRouteParams
): Array<ColumnGroupType<ProductVariantList_productVariants_edges_node>> => {
  const { warehouses, openModalWithoutNavigate, openStockDetailEventModal, onUpdateStockProduct, isFbv } = props;

  const stockAdjustmentDisabled = routeParams.type === "type-a";

  const warehouseColumns = warehouses?.map((warehouse) => {
    // 직거래 상품 재고는 실제 나주물류센터에서 관리되는 것이 아니고, 현재 보스상품은 나주물류센터 하나만 운영하므로 그냥 물류센터로만 표시
    const warehouseName = "물류센터"; // warehouse.name;
    const sumOfWarehouseStockColumn: DownloadableColumnType<ProductVariantList_productVariants_edges_node> = {
      title: columnNameConstant.stock.SUM_OF_STOCK_QUANTITY,
      key: "sumOfWarehouseStock",
      align: "right",
      width: stockAdjustmentDisabled ? 80 : 140,
      onCell: (record) => ({ colSpan: getRackCellColSpan(record, warehouse.id, false) }),
      render: (_, record) => {
        const stock = getStockByWarehouse(record.stocks, warehouse.id);
        if (utils.isEmpty(stock)) {
          return <Typography.Text type="secondary">재고 정보 없음</Typography.Text>;
        }
        return stockAdjustmentDisabled ? (
          <NumberComponent value={stock.quantity} />
        ) : (
          makeStockQtyAdjustButtons(record, warehouse.id, openModalWithoutNavigate, isFbv)
        );
      },
      renderExcel: (record) => {
        const stock = getStockByWarehouse(record.stocks, warehouse.id);
        return stock?.quantity;
      },
    };
    const stockDetailEventColumn: DownloadableColumnType<ProductVariantList_productVariants_edges_node> = {
      title: columnNameConstant.stock.VIEW_DETAILS,
      key: "stockDetailEvent",
      align: "center",
      width: 100,
      onCell: (record) => ({ colSpan: getRackCellColSpan(record, warehouse.id, false) }),
      render: (_, record) => {
        const stock = getStockByWarehouse(record.stocks, warehouse.id);
        return (
          <Button type="primary" onClick={() => openStockDetailEventModal(record.id, stock?.id)}>
            재고 내역
          </Button>
        );
      },
      renderExcel: (record) => "-",
      doNotRenderExcel: true,
    };
    const locationColumn: DownloadableColumnType<ProductVariantList_productVariants_edges_node> = {
      title: columnNameConstant.stock.LOCATION,
      key: "location",
      align: "center",
      width: 120,
      onCell: (record) => ({ colSpan: getRackCellColSpan(record, warehouse.id, true) }),
      render: (_, record) => {
        const hasVariants = record.product.productType.hasVariants;
        const onUpdateStockProductByHasVariant = () =>
          hasVariants ? onUpdateStockProduct(record.product.id, record.id) : onUpdateStockProduct(record.product.id);
        const stock = getStockByWarehouse(record.stocks, warehouse.id);
        const stockExist = utils.isEmpty(stock) === false;
        return stockExist ? (
          <Button
            type="primary"
            onClick={() => openModalWithoutNavigate(StockListModalModeEnum.RackStockList, record.id)}
          >
            로케이션 확인
          </Button>
        ) : (
          <Space direction="vertical">
            <Tag color="error">물류센터 미연결</Tag>
            <Button size="small" type="primary" onClick={onUpdateStockProductByHasVariant}>
              제품 상세
            </Button>
          </Space>
        );
      },
      renderExcel: (record) => "-",
    };

    const children = [sumOfWarehouseStockColumn, stockDetailEventColumn];
    // 재고 현황 페이지에서는 로케이션 컬럼을 제외(로케이션은 발주가 아닌 입고 및 출고 등의 물류 관리에 필요한 컬럼)
    if (stockAdjustmentDisabled === false && isFbv === false) {
      children.push(locationColumn);
    }
    return { title: warehouseName, children };
  });

  return warehouseColumns;
};

export function getStockListTableSettings(
  props: StockListPageProps,
  routeParams: StockListViewRouteParams,
  onShowNoteForUnitPrice: (noteForUnitPrice: string) => void
) {
  const { shop, onUpdateStockProduct, openModalWithoutNavigate, isHqStaffFbvMode, isVendorStaffFbvMode, isFbv } = props;
  const { stoppedReasonChoices } = shop;

  const fixedLeftFlag = utils.fixedLeftFlag();

  // ========== 공통 헬퍼 함수들 ==========
  // 공통 렌더링 로직
  const renderColumnValue = (value: any, showNumber: boolean = true) => {
    if (value === NA_VALUE_TEXT) {
      return <span style={naValueTextStyle}>{value}</span>;
    }
    return showNumber && typeof value === "number" ? <NumberComponent value={value} /> : value;
  };

  // 기본 컬럼 설정 생성
  const createBaseColumn = (
    key: string,
    type: SalesInfoType,
    title: string | string[],
    width: number,
    align: "left" | "center" | "right" = "right"
  ): Partial<DownloadableColumnType<ProductVariantList_productVariants_edges_node>> => ({
    title,
    key: `${key}_${type}`,
    align,
    width,
    onCell: getOnCellStyle(type, isFbv),
  });

  // 판매 데이터 컬럼을 위한 특수 헬퍼
  const createSalesDataColumn = ({
    title,
    key,
    salesField,
    salesGetter,
    width = 120,
    type,
  }: {
    title: string | string[];
    key: string;
    salesField?: keyof TProductVariantForStockSalesKey;
    salesGetter?: (record: ProductVariantList_productVariants_edges_node, isExcel: boolean) => any;
    width?: number;
    type: SalesInfoType;
  }): DownloadableColumnType<ProductVariantList_productVariants_edges_node> => ({
    ...createBaseColumn(key, type, title, width),
    render: (_, record) => {
      const salesValue = salesGetter
        ? salesGetter(record, false)
        : salesField
        ? getStockSalesValue(record, salesField, false)
        : 0;
      const numberTypeCheck = typeof Number(salesValue) === "number" && !isNaN(Number(salesValue));
      const value = getSalesValueByType({
        type,
        record,
        value: numberTypeCheck ? Number(salesValue) : salesValue,
        fieldKey: salesField,
        isFbv,
      });

      return renderColumnValue(value);
    },
    renderExcel: (record) => {
      const salesValue = salesGetter
        ? salesGetter(record, true)
        : salesField
        ? getStockSalesValue(record, salesField, true)
        : 0;
      const numberTypeCheck = typeof Number(salesValue) === "number" && !isNaN(Number(salesValue));
      const value = getSalesValueByType({
        type,
        record,
        value: numberTypeCheck ? Number(salesValue) : salesValue,
        fieldKey: salesField,
        isFbv,
      });
      return value === NA_VALUE_TEXT ? NA_VALUE_TEXT : value;
    },
  });

  // 공통 숫자/값 컬럼 생성 헬퍼 함수
  const createGenericValueColumn = ({
    title,
    key,
    valueGetter,
    align = "right",
    width = 80,
    showNumber = true,
    type,
    fieldKey,
  }: {
    title: string | string[];
    key: string;
    valueGetter: (record: ProductVariantList_productVariants_edges_node) => any;
    align?: "left" | "center" | "right";
    width?: number;
    showNumber?: boolean;
    type: SalesInfoType;
    fieldKey?: keyof TProductVariantForStockSalesKey;
  }): DownloadableColumnType<ProductVariantList_productVariants_edges_node> => ({
    ...createBaseColumn(key, type, title, width, align),
    render: (_, record) => {
      const rawValue = valueGetter(record);
      const numberTypeCheck = typeof Number(rawValue) === "number" && !isNaN(Number(rawValue));
      const value = getSalesValueByType({
        type,
        record,
        value: numberTypeCheck ? Number(rawValue) : rawValue,
        fieldKey,
        isFbv,
      });
      return renderColumnValue(value, showNumber);
    },
    renderExcel: (record) => {
      const rawValue = valueGetter(record);
      const numberTypeCheck = typeof Number(rawValue) === "number" && !isNaN(Number(rawValue));
      const value = getSalesValueByType({
        type,
        record,
        value: numberTypeCheck ? Number(rawValue) : rawValue,
        fieldKey,
        isFbv,
      });
      return value === NA_VALUE_TEXT ? NA_VALUE_TEXT : value;
    },
  });

  // 공통 태그 컬럼 생성 헬퍼 함수
  const createGenericTagColumn = ({
    title,
    key,
    tagMaker,
    width = 100,
    type,
  }: {
    title: string | string[];
    key: string;
    tagMaker: (record: ProductVariantList_productVariants_edges_node, isTag?: boolean) => any;
    width?: number;
    type: SalesInfoType;
  }): DownloadableColumnType<ProductVariantList_productVariants_edges_node> => ({
    ...createBaseColumn(key, type, title, width, "center"),
    render: (_, record) => {
      if (shouldShowNAValue({ type, record, isFbv })) {
        return renderColumnValue(NA_VALUE_TEXT);
      }
      return tagMaker(record);
    },
    renderExcel: (record) => {
      if (shouldShowNAValue({ type, record, isFbv })) {
        return NA_VALUE_TEXT;
      }
      return tagMaker(record, false) as string;
    },
  });

  // 공통 날짜/텍스트 컬럼 생성 헬퍼 함수
  const createGenericDateColumn = ({
    title,
    key,
    valueGetter,
    width = 100,
    type,
