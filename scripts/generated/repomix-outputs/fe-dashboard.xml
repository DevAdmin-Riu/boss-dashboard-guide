import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface OrderListViewProps {
  params: OrderListViewUrlQueryParams;
  isAll?: boolean;
}

export const OrderListView: React.FC<OrderListViewProps> = ({ params, isAll }) => {
  const { orderType } = params;
  const shop = useShop();
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  let targetUrl: (params?: OrderListViewUrlQueryParams) => string;
  switch (orderType) {
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
      targetUrl = orderListViewUrlC;
      break;
    case OrderType.BY_STAFF_FOR_BRAND:
      targetUrl = orderListViewUrlB;
      break;
    default:
      targetUrl = isAll ? allOrderListViewUrl : orderListViewUrlA;
      break;
  }

  const createAdminOrderUrl = (orderType: OrderType) => {
    switch (orderType) {
      case OrderType.BY_STAFF_FOR_BAD_STOCK:
        return createAdminOrderViewPathC;
      case OrderType.BY_STAFF_FOR_BRAND:
        return createAdminOrderViewPathB;
      default:
        return null;
    }
  };

  // NOTE: 기본적으로 List View페이지에서 사용되는 것들
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.ORDER_LIST,
  });
  // NOTE: 다운로드 할 때 사용할 query
  const { fetchForDownload } = utils.initListViewDownloadQuery(useOrderListFilterDownloadQuery);
  const getTypeFilterValue = (type?: OrderTypeEnum[]) => {
    if (type) {
      return type;
    }
    return [
      OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK,
      OrderTypeEnum.BY_STAFF_FOR_BRAND,
      OrderTypeEnum.BY_STAFF_FOR_ETC,
      OrderTypeEnum.BY_USER,
    ];
  };
  const queryVariables: OrderListVariables = React.useMemo(() => {
    const filterVariables = getFilterVariables(params, isAll);
    return {
      ...paginationState,
      filter: {
        ...filterVariables,
        type: getTypeFilterValue(filterVariables.type),
      },
      sort: getSortQueryVariables(params),
    };
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = useOrderListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orders?.pageInfo,
    paginationState,
    params,
  });

  // NOTE: Filter Tab과 Modal Tab을 사용하기 위한 설정
  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderListViewUrlDialog, OrderListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  return (
    <>
      <OrderListPage
        orderType={orderType}
        currencySymbol={currencySymbol}
        settings={settings}
        currentTab={currentTab}
        disabled={loading}
        filterOpts={getFilterOpts(params, isAll)}
        orders={maybe(() => data.orders.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        sort={getSortParams(params)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        isAll={isAll}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        createAdminOrderButtonClick={() => navigate(createAdminOrderUrl(orderType))}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

