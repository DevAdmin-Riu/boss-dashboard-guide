<file path="src/app/components/Grid/Grid.tsx">
import { Col, Row } from "antd";
import React from "react";

export type GridVariant = "default" | "inverted" | "uniform";
export interface GridProps {
  children: React.ReactNodeArray | React.ReactNode;
  className?: string;
  variant?: GridVariant;
  split?: React.ReactNode;
}

const Grid: React.FC<GridProps> = (props) => {
  const { className, children, variant, split } = props;

  const childArray = React.Children.toArray(children);
  const oddColSpan = variant === "default" ? 16 : variant === "inverted" ? 8 : 12;
  const evenColSpan = variant === "default" ? 8 : variant === "inverted" ? 16 : 12;

  return (
    <Row className={className} gutter={[24, !!split ? 0 : 24]}>
      {childArray.map((child, index) => {
        // index는 0부터 시작
        const isOdd = index % 2 === 0;
        const span = isOdd ? oddColSpan : evenColSpan;
        const gridItem = (
          <Col key={index} xs={24} sm={span}>
            {child}
          </Col>
        );

        return (
          <React.Fragment key={index}>
            {!!split && isOdd && split}
            {gridItem}
          </React.Fragment>
        );
      })}
    </Row>
  );
};

Grid.defaultProps = {
  variant: "default",
};

export default Grid;
</file>

