import {
  OrderChargeStatusFilter,
  OrderLineFilterInput,
  OrderPayMethodFilter,
  OrderTypeEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { OrderLineDetailFilterKeys, OrderLineDetailListFilterOpts } from "../../components/OrderLineDetailListPage";
import {
  OrderLineDetailListViewUrlFilters,
  OrderLineDetailListViewUrlFiltersEnum,
  OrderLineDetailListViewUrlFiltersWithMultipleValuesEnum,
  OrderLineDetailListViewUrlQueryParams,
} from "../../urls";
import { getOrderTypeEnums } from "../OrderListView/filters";

const ORDER_LINE_DETAIL_FILTERS_KEY = "orderLineDetailFilters";

export function getFilterOpts(
  params: OrderLineDetailListViewUrlQueryParams,
  isAll: boolean
): OrderLineDetailListFilterOpts {
  const filterVariables = getFilterVariables(params, isAll);
  const todayMoment = moment();

  return {
    orderCreated: {
      active: maybe(() => !utils.allEmpty([filterVariables.orderCreated.gte, filterVariables.orderCreated.lte]), false),
      value: {
        max: maybe(() => filterVariables.orderCreated.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.orderCreated.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    chargeStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.chargeStatus), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.chargeStatus.map((chargeStatus) => findValueInEnum(chargeStatus, OrderChargeStatusFilter))
          ),
        [OrderChargeStatusFilter.PENDING]
      ),
    },
    payMethod: {
      active: maybe(() => !utils.isEmpty(filterVariables.payMethod), false),
      value: maybe(
        () =>
          dedupeFilter(filterVariables.payMethod.map((payMethod) => findValueInEnum(payMethod, OrderPayMethodFilter))),
        []
      ),
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderType), false),
      value: maybe(
        () => dedupeFilter(filterVariables.orderType.map((typeStatus) => findValueInEnum(typeStatus, OrderTypeEnum))),
        [OrderTypeEnum.BY_USER]
      ),
    },
    isTrackInventoryFulfillment: {
      active: maybe(() => !utils.isEmpty(filterVariables.isTrackInventoryFulfillment), false),
      value: maybe(() => filterVariables.isTrackInventoryFulfillment, true),
    },
    excludeStockAvgStats: {
      active: maybe(() => !utils.isEmpty(filterVariables.excludeStockAvgStats), false),
      value: maybe(() => filterVariables.excludeStockAvgStats, true),
    },
  };
}

export function getFilterVariables(
  params: OrderLineDetailListViewUrlQueryParams,
  isAll: boolean
): OrderLineFilterInput {
  const orderTypeEnums = getOrderTypeEnums(params.orderType);
  return {
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    orderSearch: params.orderSearch,
    userSearch: params.userSearch,
    productSearch: params.productSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
    chargeStatus: maybe(() => params.chargeStatus.map((status) => findInEnum(status, OrderChargeStatusFilter))),
    payMethod: maybe(() => params.payMethod.map((status) => findInEnum(status, OrderPayMethodFilter))),
    orderType: isAll ? maybe(() => params.type.map((status) => findInEnum(status, OrderTypeEnum))) : orderTypeEnums,
    isTrackInventoryFulfillment:
      params.isTrackInventoryFulfillment !== undefined
        ? parseBoolean(params.isTrackInventoryFulfillment, true)
        : undefined,
    excludeStockAvgStats:
      params.excludeStockAvgStats !== undefined ? parseBoolean(params.excludeStockAvgStats, true) : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<OrderLineDetailFilterKeys>
): OrderLineDetailListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case OrderLineDetailFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        OrderLineDetailListViewUrlFiltersEnum.orderCreatedFrom,
        OrderLineDetailListViewUrlFiltersEnum.orderCreatedTo
      );
    case OrderLineDetailFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.orderSearch);
    case OrderLineDetailFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.userSearch);
    case OrderLineDetailFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.productSearch);
    case OrderLineDetailFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.brandSearch);
    case OrderLineDetailFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.brandStoreSearch);
    case OrderLineDetailFilterKeys.chargeStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderLineDetailListViewUrlFiltersWithMultipleValuesEnum.chargeStatus,
        OrderChargeStatusFilter
      );
    case OrderLineDetailFilterKeys.payMethod:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderLineDetailListViewUrlFiltersWithMultipleValuesEnum.payMethod,
        OrderPayMethodFilter
      );
    case OrderLineDetailFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderLineDetailListViewUrlFiltersWithMultipleValuesEnum.type,
        OrderTypeEnum
      );
    case OrderLineDetailFilterKeys.isTrackInventoryFulfillment:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.isTrackInventoryFulfillment);
    case OrderLineDetailFilterKeys.excludeStockAvgStats:
      return getSingleValueQueryParam(filter, OrderLineDetailListViewUrlFiltersEnum.excludeStockAvgStats);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<OrderLineDetailListViewUrlFilters>(ORDER_LINE_DETAIL_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  OrderLineDetailListViewUrlQueryParams,
  OrderLineDetailListViewUrlFilters
>({
  ...OrderLineDetailListViewUrlFiltersEnum,
  ...OrderLineDetailListViewUrlFiltersWithMultipleValuesEnum,
});
