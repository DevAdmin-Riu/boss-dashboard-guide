import { ProductVariantVendorSetDefault } from "../../api/types/ProductVariantVendorSetDefault";
import { productVariantManageEventTypeChoices } from "../../utils/data";
import ProductVaraintManageEventDetailModal from "../../views/ProductVariantManageEventListView/ProductVaraintManageEventDetailModal";
import { checkProductVariantUpdateRequired } from "../../views/ProductVariantUpdateView";
import { DevPvCard } from "../DevPvCard/DevPvCard";
import { MainPvListCard } from "../MainPvListCard/MainPvListCard";
import { ProductAttributes } from "../ProductAttributes";
import ProductInfoUpdateNotice from "../ProductInfoUpdateNotice";
import { ProductNote } from "../ProductNote";
import { ProductPoNote } from "../ProductPoNote";
import { ProductPricing } from "../ProductPricing/ProductPricing";
import { PvBaseSellPriceCard } from "../ProductPricing/PvBaseSellPriceCard";
import { ProductStocks } from "../ProductStocks";
import { ProductVariantBasicForm } from "../ProductVariantBasicForm";
import ProductVariantFile from "../ProductVariantFile";
import { ProductVariantImages } from "../ProductVariantImages";
import { ProductVariantImageSelectDialog } from "../ProductVariantImageSelectDialog";
import {
  ProductVariantManageEvents,
  ProductVariantManageEventsTableDataSourceType,
} from "../ProductVariantManageEvents/ProductVariantManageEvents";
import { ProductVariantNavigation } from "../ProductVariantNavigation";
import { ProductVariantSetDefault } from "../ProductVariantSetDefault";
import { ProductVariantVendorCreateOrUpdateModal } from "../ProductVariantVendorCreateOrUpdateModal";
import { ProductVendorConnectCard } from "../ProductVendorConnectCard/ProductVendorConnectCard";
import { ProductVariantManageEventModal } from "../PvOrBpvManageEventModal";
import { SubPvCard } from "../SubPvCard/SubPvCard";
import ProductVariantUpdateForm, { ProductVariantUpdateData } from "./form";

interface ProductVariantUpdatePageProps {
  defaultVariantId?: string;
  errors: ProductErrorWithAttributesFragment[];
  pageHeaderTitle: string;
  loading?: boolean;
  placeholderImage?: string;
  saveButtonBarState: ConfirmButtonTransitionState;
  variant: ProductVariantDetails_productVariant;
  warehouses: WarehouseFragment[];
  makers: SearchMakers_search_edges_node[];
  fetchMoreMakers: FetchMoreProps;
  fetchMakers: (query: string) => void;
  onVariantReorder: ReorderAction;
  onVariantUpdate: (
    variantId: string,
    productVariantInput: ProductVariantInput,
    additionalInput: ExtendedProductUpdateAdditionalInput,
    productToBeChangedInfoCreateInput: ProductToBeChangedInfoCreateInput
  ) => Promise<FetchResult<ExtendedProductUpdate>>;
  onVariantVendorSetDefault: (
    productVariantId: string,
    variantVendorId: string,
    manageEvent: ProductVariantManageEventInput
  ) => Promise<FetchResult<ProductVariantVendorSetDefault>>;
  onAdd: () => void;
  onCopyAdd: () => void;
  onBack: () => void;
  onDelete: () => void;
  onSubmit: (
    data: ProductVariantUpdateData
  ) => Promise<Array<ExtendedProductUpdate_extendedProductUpdate_errors | MetadataErrorFragment>>;
  onImageSelect: (id: string) => void;
  onVariantClick: (variantId: string) => void;
  onSetDefaultVariant: () => void;
  onProductClick: (productId: string) => void;
  onAssignSubPv: () => void;
  onUnassignSubPv: (subPvId: string) => void;
  onBulkAssignMainPvs: () => void;
  onBulkUnassignMainPvs: (mainPvIds: string[]) => void;
  onAssignDevPv: () => void;
  onUnassignDevPv: (devPvId: string) => void;
  onWarehouseConfigure: () => void;
  // 판매 가능 알림 관련
  onProductVariantOnSale?: (variantId: string, recipientList: string[]) => void;
  productVariantOnSaleLoading?: boolean;
}

enum ProductVariantUpdateModalModeEnum {
  CreateVariantVendor = "CreateVariantVendor",
  UpdateVariantVendor = "UpdateVariantVendor",
  AddManageEventModal = "AddManageEventModal",
  SelectImage = "SelectImage",
  DETAIL_INFO = "DETAIL_INFO",
}

export const ProductVariantUpdatePage: React.FC<ProductVariantUpdatePageProps> = ({
  defaultVariantId,
  errors,
  pageHeaderTitle,
  loading,
  placeholderImage,
  saveButtonBarState,
  variant,
  warehouses,
  makers: makerChoiceList,
  fetchMoreMakers,
  fetchMakers,
  onAdd,
  onCopyAdd,
  onBack,
  onDelete,
  onImageSelect,
  onSubmit,
  onVariantClick,
  onVariantUpdate,
  onVariantReorder,
  onSetDefaultVariant,
  onVariantVendorSetDefault,
  onProductClick,
  onAssignSubPv,
  onUnassignSubPv,
  onBulkAssignMainPvs,
  onBulkUnassignMainPvs,
  onAssignDevPv,
  onUnassignDevPv,
  onWarehouseConfigure,
  onProductVariantOnSale,
  productVariantOnSaleLoading,
}) => {
  const [modalMode, setModalMode] = useState<ProductVariantUpdateModalModeEnum | StockListModalModeEnum>(null);
  const [selectedRow, setSelectedRow] = React.useState<ProductVariantManageEventsTableDataSourceType>(null);
  const [idForModal, setIdForModal] = useState<string>(null);
  const { allCountries } = useShop();

  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (
    modalMode: ProductVariantUpdateModalModeEnum | StockListModalModeEnum,
    stockOrVariantId: string
  ) => {
    setModalMode(modalMode);
    setIdForModal(stockOrVariantId);
  };

  const variantImages = variant?.images?.map((image) => image.id);
  const productImages = variant?.product?.images
    ?.slice()
    .sort((prev, next) => (prev.sortOrder > next.sortOrder ? 1 : -1));
  const images = productImages
    ?.filter((image) => variantImages.indexOf(image.id) !== -1)
    .sort((prev, next) => (prev.sortOrder > next.sortOrder ? 1 : -1));

  const onShowDetailInfoModal = (record: ProductVariantManageEventsTableDataSourceType) => {
    setSelectedRow(record);
    setModalMode(ProductVariantUpdateModalModeEnum.DETAIL_INFO);
  };

  return (
    <>
      <AppHeader onBack={onBack}>{maybe(() => variant.product.name)}</AppHeader>
      <PageHeader title={pageHeaderTitle}>
        {variant?.product?.defaultVariant?.id !== variant?.id && (
          <ProductVariantSetDefault onSetDefaultVariant={onSetDefaultVariant} />
        )}
      </PageHeader>
      <ProductVariantUpdateForm variant={variant} onSubmit={onSubmit} warehouses={warehouses}>
        {({ change, data, handlers, hasChanged, submit }) => (
          <>
            <Grid variant="inverted">
              <div>
                <ProductVariantNavigation
                  current={variant ? variant.id : undefined}
                  defaultVariantId={defaultVariantId}
                  variants={maybe(() => variant.product.outerVariants)}
                  onAdd={onAdd}
                  onCopyAdd={onCopyAdd}
                  onRowClick={(variantId: string) => {
                    if (variant) {
                      return onVariantClick(variantId);
                    }
                  }}
                  onReorder={onVariantReorder}
                />
              </div>
              <Space direction="vertical" size="large">
                <ProductVariantBasicForm
                  product={variant?.product}
                  variant={variant}
                  data={data}
                  errors={errors}
                  onChange={change}
                  disabled={loading}
                  isFulfilledByVendor={false}
                  onSaleOptions={
                    onProductVariantOnSale
                      ? {
                          outerVariantId: variant?.id,
                          innerVariantId: variant?.inner?.id,
                          firstAvailableForPurchase: variant?.firstAvailableForPurchase,
                          onClickOnSaleButton: onProductVariantOnSale,
                          loading: productVariantOnSaleLoading,
                          sku: variant?.sku,
                        }
                      : undefined
                  }
                />
                <ProductAttributes
                  isProductPage={false}
                  data={data}
                  errors={errors}
                  disabled={loading}
                  isFulfilledByVendor={false}
                  productVariant={variant}
                  makers={makerChoiceList}
                  fetchMoreMakers={fetchMoreMakers}
                  fetchMakers={fetchMakers}
                  onChange={change}
                  onSingleAttrChange={handlers.selectAttribute}
                  onMultiAttrChange={handlers.selectAttribute}
                  allCountries={allCountries}
                />
                <ProductVariantImages
                  disabled={loading}
                  images={images}
                  placeholderImage={placeholderImage}
                  onImageAdd={() => setModalMode(ProductVariantUpdateModalModeEnum.SelectImage)}
                />
                <ProductPricing
                  data={data}
                  product={variant?.product}
                  productVariant={variant}
                  disabled={loading}
                  loading={loading}
                  errors={errors}
                  onVariantUpdate={onVariantUpdate}
                />
                <ProductVendorConnectCard
                  disabled={loading}
                  product={variant?.product}
                  productVariant={variant}
                  onVariantVendorCreate={() => setModalMode(ProductVariantUpdateModalModeEnum.CreateVariantVendor)}
                  onVariantVendorUpdate={(variantVendorId) =>
                    openModalWithoutNavigate(ProductVariantUpdateModalModeEnum.UpdateVariantVendor, variantVendorId)
                  }
                  onVariantVendorSetDefault={onVariantVendorSetDefault}
                />
                <PvBaseSellPriceCard
                  disabled={loading}
                  data={data}
                  productVariant={variant}
                  onVariantUpdate={onVariantUpdate}
                />
                <ProductStocks
                  data={data}
                  productVariant={variant}
                  disabled={loading}
                  warehouses={warehouses}
                  onVariantUpdate={onVariantUpdate}
                  onChange={change}
                  onWarehouseConfigure={onWarehouseConfigure}
                  openModalWithoutNavigate={openModalWithoutNavigate}
                  // 직거래 상품은 옵션형 상품이 없어 isFulfilledByVendor 값 false 고정
                  isFulfilledByVendor={false}
                />
                {variant.trackInventory &&
                  (variant.isSubPv ? (
                    <MainPvListCard
                      disabled={loading || data.isSubPv !== variant.isSubPv}
                      mainPvs={variant.mainPvs}
                      onProductClick={onProductClick}
                      onBulkAssign={onBulkAssignMainPvs}
                      onBulkUnassign={onBulkUnassignMainPvs}
                    />
                  ) : (
                    <SubPvCard
                      disabled={loading || data.isSubPv !== variant.isSubPv}
                      subPv={variant.subPv}
                      onProductClick={onProductClick}
                      onLocationClick={(variantId) =>
                        openModalWithoutNavigate(StockListModalModeEnum.RackStockList, variantId)
                      }
                      onAssign={onAssignSubPv}
                      onUnassign={onUnassignSubPv}
                    />
                  ))}
                {variant.product.isFulfilledByVendor === false &&
                  variant.product.category.kind === CategoryKindEnum.STANDARD &&
                  variant.product.isExclusive && (
                    <DevPvCard
                      isDevPv={false}
                      disabled={loading}
                      devPvs={variant.devPvs}
                      onProductClick={onProductClick}
                      onAssign={onAssignDevPv}
                      onUnassign={onUnassignDevPv}
                    />
                  )}
                <Row gutter={[12, 12]}>
                  <Col span={12}>
                    <ProductVariantFile variantId={variant?.id} files={variant?.designFiles} fileType={"Design"} />
                  </Col>
                  <Col span={12}>
                    <ProductVariantFile variantId={variant?.id} files={variant?.estimateFiles} fileType={"Estimate"} />
                  </Col>
                </Row>
                <Row gutter={[12, 12]}>
                  <Col span={8}>
                    <ProductInfoUpdateNotice product={variant?.product} onVariantUpdate={onVariantUpdate} />
                  </Col>
                  <Col span={8}>
                    <ProductPoNote data={data} errors={errors} onChange={change} />
                  </Col>
                  <Col span={8}>
                    <ProductNote data={data} errors={errors} onChange={change} />
                  </Col>
                </Row>
                <ProductVariantManageEvents
                  productVariant={variant}
                  loading={loading}
                  onShowDetailInfoModal={onShowDetailInfoModal}
                />
              </Space>
            </Grid>
            <StockDetailAddEtcModal
              open={modalMode === StockListModalModeEnum.StockDetailAdd}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
              isFbv={false} // 직거래 상품은 옵션형이 아니기 떄문에 false 고정 추후에 옵션형이 생기면 변경 필요
            />
            <StockDetailLossModal
              open={modalMode === StockListModalModeEnum.StockDetailLoss}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
              isFbv={false} // 직거래 상품은 옵션형이 아니기 떄문에 false 고정 추후에 옵션형이 생기면 변경 필요
            />
            <StockDetailAdjustToZeroModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailAdjustToZero}
              loading={!data}
              stockId={idForModal}
              productVariant={variant}
              onClose={resetForCloseModal}
            />
            <StockDivideOrCombineModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailDivideOrCombine}
              loading={!data}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
            />
            <RackStockListModal
              open={modalMode === StockListModalModeEnum.RackStockList}
              loading={loading}
              productVariantId={idForModal}
              onClose={resetForCloseModal}
            />
            <StockDetailEventListModal
              open={!!idForModal && modalMode === StockListModalModeEnum.StockDetailEventList}
              variantId={idForModal}
              onClose={resetForCloseModal}
              isFulfilledByVendor={false} // 직거래 상품은 옵션형 상품이 없어 isFulfilledByVendor 값 false 고정
            />
            <ProductVariantVendorCreateOrUpdateModal
              isCreateMode={modalMode === ProductVariantUpdateModalModeEnum.CreateVariantVendor}
              open={
                modalMode === ProductVariantUpdateModalModeEnum.CreateVariantVendor ||
                modalMode === ProductVariantUpdateModalModeEnum.UpdateVariantVendor
              }
              loading={loading}
              product={variant.product}
              productVariant={variant}
              productVariantVendor={
                modalMode === ProductVariantUpdateModalModeEnum.CreateVariantVendor
                  ? null
                  : variant?.productVariantVendors.find((v) => v.id === idForModal)
              }
              onClose={resetForCloseModal}
              precision={data.priceDecimalPlaces}
            />
            <ProductVariantManageEventModal
              isCreateMode
              open={modalMode === ProductVariantUpdateModalModeEnum.AddManageEventModal}
              loading={loading}
              manageEventType={null}
              choices={productVariantManageEventTypeChoices}
              onManageEventChange={(manageEvent) => change({ target: { name: "manageEvent", value: manageEvent } })}
              onSubmit={async () => {
                const isOk = await submit();
                if (isOk) {
                  resetForCloseModal();
                }
              }}
              onCancel={resetForCloseModal}
            />
            <ProductVaraintManageEventDetailModal
              open={modalMode === ProductVariantUpdateModalModeEnum.DETAIL_INFO}
              onCancel={() => {
                setSelectedRow(null);
                setModalMode(null);
              }}
              selectedRow={selectedRow}
            />
            <SaveButtonBar
              disabled={loading || !hasChanged}
              state={saveButtonBarState}
              onCancel={onBack}
              onDelete={onDelete}
              onSave={() => {
                const isValid = checkProductVariantUpdateRequired(variant, data);
                if (isValid) {
                  setModalMode(ProductVariantUpdateModalModeEnum.AddManageEventModal);
                }
              }}
            />
          </>
        )}
      </ProductVariantUpdateForm>

      {variant && (
        <ProductVariantImageSelectDialog
          onClose={resetForCloseModal}
          onImageSelect={onImageSelect}
          open={modalMode === ProductVariantUpdateModalModeEnum.SelectImage}
          images={productImages}
          selectedImages={maybe(() => variant.images.map((image) => image.id))}
        />
      )}
    </>
  );
};
</file>

