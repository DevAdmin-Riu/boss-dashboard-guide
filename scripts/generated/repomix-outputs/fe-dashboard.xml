    backgroundImage: undefined,
  };

  const [categoryCreate, categoryCreateOpts] = useCategoryCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.categoryCreate.errors, "카테고리가 추가되었습니다.", () =>
        navigate(categoryDetailsViewUrl(data.categoryCreate.category.id))
      ),
  });

  const handleCreate = async (formData: CategoryCreateForm) => {
    const input: CategoryCreateInput = {
      ...formData,
    };

    await categoryCreate({ variables: { input, parent: parentId || null } });
  };

  return (
    <>
      <WindowTitle title={categoryMsg.create} />

      <Form form={form} name="category-create" layout="vertical" initialValues={initialValues} onFinish={handleCreate}>
        <CategoryCreatePage
          form={form}
          loading={categoryCreateOpts.loading}
          onBack={() => navigate(parentId ? categoryDetailsViewUrl(parentId) : categoryListViewUrl())}
        />
      </Form>
    </>
  );
};
</file>

