import { BrandProductVariant_brandProductVariant } from "../../api/types/BrandProductVariant";
import { checkHasVariants } from "../../utils/utils";
import { ProductAttributeInput } from "../ProductAttributes";
import { ProductOrganizationOptionProps } from "../ProductOrganization";

export interface ProductUpdateFormData {
  category: string | null;
  categoryLabel: string;
  isTaxFree: boolean;
  collections: string[];
  name: string;
  moq: number;
  uoq: number;
  allowMixedMultipleOfUoq: boolean;
  isExclusive: boolean;
  qtyPerBox: number;
  qtyPerBoxUnitType: QtyPerBoxUnitTypeEnum;
  priorityLevel: PriorityLevelEnum;
  salesUnitType: SalesUnitTypeEnum;
  boxLength: number;
  boxWidth: number;
  boxHeight: number;
  palletQty: number | null;
  palletM: number | null;
  palletN: number | null;
  palletO: number | null;
  maker: string;
  makerLabel: string;
  slug: string;
  isDeliveryFeeAmountManual: boolean;
  deliveryFeeAmount: number;
  salesStatus: SalesStatusEnum;
  stoppedReason: StoppedReasonTypeEnum;
  stoppedReasonEtc: string;
  trackInventory: boolean;
  isVendorTrackInventory: boolean;
  isDevPv: boolean;
  isForCreditsRefill: boolean;
  allowAutoConsignment: boolean;
  isAdjustPrice: boolean;
  qtyPerDeliveryBox: number;
  autoTurnOffAllowAutoConsignment: boolean;
  isSubPv: boolean;
  canSaleByInner: boolean;
  requiredExpDateMgmt: boolean;
  stockAdjustFactor: number;
  basicStockQty: number;
  safetyStockQty: number;
  rop: number;
  stocks: StockInput[];
  note: string;
  poNote: string;
  isSeasonal: boolean;
  peakSeasonStartDate: string | null;
  peakSeasonEndDate: string | null;
  manageEvent: ProductVariantManageEventInput;
  // 상품정보고시, 기존의 metadata 구조 제거.
  productInfoNotification: TProductInfoNotiData[];
  // 이너박스 정보(직배송 제품인 경우는 무관)
  innerSalesStatus: SalesStatusEnum;
  innerStoppedReason: StoppedReasonTypeEnum;
  innerStoppedReasonEtc: string;
  innerMoq: number;
  innerUoq: number;
  packCount: number;
  innerQtyPerBox: number;
  innerBoxLength: number;
  innerBoxWidth: number;
  innerBoxHeight: number;
  innerStocks: StockInput[];

  forceSoldOutNotice: boolean;
  innerForceSoldOutNotice: boolean;

  // 직거래 상품 bpv 정보
  isOnlyPayableByCash: boolean;
  bpvShowBeforePrice?: boolean;
  bpvBeforePriceExcludeVat?: number;
  bpvPrice?: number;
  bpvPriceExcludeVat?: number;
  bpvPriceVat?: number;

  priceDecimalPlaces: number;
  orderQtyDecimalPlaces: number;

  // 후정산 여부
  isDeferred: boolean;

  // 검수 정보
  needToInspect: boolean;
  inspectReason: string;
  inspectType: string;
  inspectMemo: string;
  inspectReportTemplate: ProductDetails_product_outerVariants_inspectReportTemplate;

  countryOfOrigin: string | null;
}
export interface ProductUpdateData extends ProductUpdateFormData {
  attributes: ProductAttributeInput[];
  hasVariants: boolean;
  collections: string[];
  bpvCreateInput?: BrandProductVariantCreateInput | null;
}

type ProductUpdateHandlers = Record<"changeProductInfoNoti" | "selectCategory" | "selectCollection", FormChange> &
  Record<"selectAttribute" | "selectAttributeMultiple", FormsetChange<string>>;

interface UseProductUpdateFormResult {
  change: FormChange;
  data: ProductUpdateData;
  handlers: ProductUpdateHandlers;
  hasChanged: boolean;
  submit: () => Promise<boolean>;
}

interface UseProductUpdateFormOpts extends Record<"categories" | "collections", ProductOrganizationOptionProps[]> {
  setSelectedCategory: React.Dispatch<React.SetStateAction<string>>;
  setSelectedCollections: React.Dispatch<React.SetStateAction<string[]>>;
  selectedCollections: string[];
  warehouses: SearchWarehouses_search_edges_node[];
}

interface ProductUpdateFormProps extends UseProductUpdateFormOpts {
  children: (props: UseProductUpdateFormResult) => React.ReactNode;
  product: ProductDetails_product;
  brandProductVariant: BrandProductVariant_brandProductVariant;
  onSubmit: (data: ProductUpdateData) => SubmitPromise;
}

function useProductUpdateForm(
  product: ProductDetails_product,
  onSubmit: (data: ProductUpdateData) => SubmitPromise,
  opts: UseProductUpdateFormOpts,
  brandProductVariant?: BrandProductVariant_brandProductVariant
): UseProductUpdateFormResult {
  const [changed, setChanged] = React.useState<boolean>(false);
  const triggerChange = () => setChanged(true);

  const formData = getProductUpdatePageFormData(product, brandProductVariant);
  const form = useForm({ ...formData });
  const attributes = useFormset(getAttributeInputFromProductAttributes(product?.attributes || []));

  const handleChange: FormChange = (event, cb) => {
    form.change(event, cb);
    triggerChange();
  };
  const handleCollectionSelect = handleChange;
  const handleCategorySelect = createSingleAutocompleteSelectHandler(
    handleChange,
    opts.setSelectedCategory,
    opts.categories
  );
  const handleAttributeChange = createAttributeChangeHandler(attributes.change, triggerChange);
  const handleAttributeMultiChange = createAttributeMultiChangeHandler(
    attributes.change,
    attributes.data,
    triggerChange
  );
  const changeProductInfoNoti = handleChange;

  const data: ProductUpdateData = {
    ...form.data,
    attributes: attributes.data,
    hasVariants: checkHasVariants(product),
  };

  if (commonUtils.isEmpty(brandProductVariant) === false) {
    data.bpvCreateInput = {
      brandCode: brandProductVariant.brand.code,
      isOnlyPayableByCash: form.data.isOnlyPayableByCash,
      showBeforePrice: form.data.bpvShowBeforePrice,
      beforePrice: toPriceIncludeVat(form.data.bpvBeforePriceExcludeVat, form.data.isTaxFree),
      price: form.data.bpvPriceExcludeVat + form.data.bpvPriceVat,
      priceVat: form.data.bpvPriceVat,
    };
  }
  const submit = () => handleFormSubmit(data, onSubmit, setChanged);
  return {
    change: handleChange,
    data,
    handlers: {
      changeProductInfoNoti,
      selectAttribute: handleAttributeChange,
      selectAttributeMultiple: handleAttributeMultiChange,
      selectCategory: handleCategorySelect,
      selectCollection: handleCollectionSelect,
    },
    hasChanged: changed,
    submit,
  };
}

const ProductUpdateForm: React.FC<ProductUpdateFormProps> = ({
  children,
  product,
  onSubmit,
  brandProductVariant,
  ...rest
}) => {
  const props = useProductUpdateForm(product, onSubmit, rest, brandProductVariant);
  return <form onSubmit={props.submit}>{children(props)}</form>;
};

export default ProductUpdateForm;
</file>

