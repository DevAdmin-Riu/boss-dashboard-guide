import { EditableColumnsType, EditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { NumberComponent } from "@src/app/components/Number";
import { utils } from "@utils/utils";
import { Button, Checkbox, Form, Space, Typography } from "antd";
import React from "react";

import { ProductDetails_product, ProductDetails_product_outerVariants } from "../../api/types/ProductDetails";
import { ProductVariantDetails_productVariant } from "../../api/types/ProductVariantDetails";
import { checkIsTVariantForPrice, TProductPricingTableDataSource } from "./ProductPricing";

interface ProductPricingWahtchedValues {
  deliveryFeeExcludeVat: number;
  consignmentCostPriceExcludeVat: number;
  consignmentDeliveryFeeExcludeVat: number;
  innerCostPriceExcludeVat: number;
  innerIncidentalCostExcludeVat: number;
  isDeliveryFeeAmountManual: boolean;
}

export interface ProductPricingTableColumnsProps {
  disabled: boolean;
  product: Pick<ProductDetails_product, "isTaxFree">;
  productVariant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  selectedRowId: string;
  isInnerVariantTable?: boolean;
  watchedValues: ProductPricingWahtchedValues;
  isEditing: (record: TProductPricingTableDataSource) => boolean;
  onEdit: (
    record: Partial<TProductPricingTableDataSource> & {
      id: React.Key;
    }
  ) => void;
  onRowSubmitClick: () => void;
  onCancel: () => void;
}

const editableCellKeys = {
  leadTime: "leadTime",
  disabledDays: "disabledDays",
  costPriceExcludeVat: "costPriceExcludeVat",
  deliveryFeeExcludeVat: "deliveryFeeExcludeVat",
};

// 폼 모드(재고 판매 or 직배송, 위탁 판매, 이너박스)에 따른 협력사 매입가 컬럼 값
// parseProductVariantPriceToExcludeVat 호출해서 부가세 별도 금액으로 변환된 금액 사용
const getCostPriceExcludeVat = (record: TProductPricingTableDataSource, isDirectShipping: boolean) => {
  if (checkIsTVariantForPrice(record)) {
    if (record.formMode === "consignment") {
      return record.consignmentCostPriceExcludeVat;
    }
    if (record.formMode === "inner") {
      return record.innerCostPriceExcludeVat;
    }
  }
  return record.costPriceExcludeVat;
};

// 폼 모드(재고 판매 or 직배송, 위탁 판매, 이너박스)에 따른 판매 택배비(또는 판매소분비용) 컬럼 값
// parseProductVariantPriceToExcludeVat 호출해서 부가세 별도 금액으로 변환된 금액 사용
const getDeliveryFeeExcludeVat = (record: TProductPricingTableDataSource, isDirectShipping: boolean) => {
  if (checkIsTVariantForPrice(record)) {
    if (record.formMode === "consignment") {
      return record.consignmentDeliveryFeeExcludeVat;
    }
    if (record.formMode === "inner") {
      return record.innerIncidentalCostExcludeVat;
    }
  }
  return record.deliveryFeeExcludeVat;
};

const getDeliveryFeeExcludeVatWathched = (
  record: TProductPricingTableDataSource,
  watchedValues: ProductPricingWahtchedValues
) => {
  if (checkIsTVariantForPrice(record)) {
    if (record.formMode === "consignment") {
      return watchedValues.consignmentDeliveryFeeExcludeVat;
    }
    if (record.formMode === "inner") {
      return watchedValues.innerIncidentalCostExcludeVat;
    }
  }
  return watchedValues.deliveryFeeExcludeVat;
};

export const makeProductCostPriceColTitle = () => (
  <Typography>{columnNameConstant.product.VENDOR_COST_PRICE(false)}</Typography>
);
export const makeProductDeliveryFeeColTitle = () => (
  <Typography>판매 {columnNameConstant.product.CONSIGNMENT_DELIVERY_FEE(false)}</Typography>
);
export const makeProductSupplyTotalColTitle = () => (
  <Typography>{columnNameConstant.product.COST_PRICE(false)}</Typography>
);

export const getProductPricingTableColumns = (props: ProductPricingTableColumnsProps) => {
  const {
    disabled,
    productVariant,
    selectedRowId,
    isInnerVariantTable,
    watchedValues,
    isEditing,
    onEdit,
    onRowSubmitClick,
    onCancel,
  } = props;
  const { trackInventory } = productVariant;

  const fixedRightFlag = utils.fixedRightFlag();

  const formModeKeyMap = {
    trackInventory: { costPriceExcludeVat: "costPriceExcludeVat", deliveryFeeExcludeVat: "deliveryFeeExcludeVat" },
    consignment: {
      costPriceExcludeVat: "consignmentCostPriceExcludeVat",
      deliveryFeeExcludeVat: "consignmentDeliveryFeeExcludeVat",
    },
    inner: {
      costPriceExcludeVat: "innerCostPriceExcludeVat",
      deliveryFeeExcludeVat: "innerIncidentalCostExcludeVat",
    },
  };

  const getFormItemName = (record: TProductPricingTableDataSource, colKey: string) => {
    if (checkIsTVariantForPrice(record)) {
      const keyMap = formModeKeyMap[record.formMode];
      return keyMap[colKey];
    }
    return colKey;
  };

  let columns: EditableColumnsType<TProductPricingTableDataSource> = [];

  const trackInventoryColumn: EditableColumnType<TProductPricingTableDataSource> = {
    key: "trackInventory",
    align: "center",
    width: 120,
    render: (_: any, record: TProductPricingTableDataSource) =>
      checkIsTVariantForPrice(record)
        ? record.formMode === "trackInventory"
          ? "재고 판매"
          : record.formMode === "consignment"
          ? "위탁 판매"
          : "-"
        : "-",
  };

  const costPriceExcludeVatColumn: EditableColumnType<TProductPricingTableDataSource> = {
    title: makeProductCostPriceColTitle(),
    key: editableCellKeys.costPriceExcludeVat,
    align: "right",
    width: 120,
    render: (_: any, record: TProductPricingTableDataSource) => {
      const value = getCostPriceExcludeVat(record, false);
      return <NumberComponent value={value} />;
    },
  };

  const deliveryFeeExcludeVatColumn: EditableColumnType<TProductPricingTableDataSource> = {
    title: isInnerVariantTable
      ? columnNameConstant.product.VARIANT_INNER_INCIDENTAL_COST(false)
      : makeProductDeliveryFeeColTitle(),
    key: editableCellKeys.deliveryFeeExcludeVat,
    align: "right",
    width: isInnerVariantTable && trackInventory ? 240 : 120,
    render: (_: any, record: TProductPricingTableDataSource) => {
      const value = getDeliveryFeeExcludeVat(record, false);
      return <NumberComponent value={value} />;
    },
    onCell: (record: TProductPricingTableDataSource) => {
      let additionalNodePrefix;
      let disabled = false;
      if (checkIsTVariantForPrice(record) && record.formMode === "trackInventory") {
        const isDeliveryFeeAmountManual = checkIsTVariantForPrice(record) && record?.isDeliveryFeeAmountManual;
        additionalNodePrefix = (
          <>
            직접 입력:{" "}
            <Form.Item name={"isDeliveryFeeAmountManual"} valuePropName="checked" noStyle>
              <Checkbox defaultChecked={isDeliveryFeeAmountManual} />
            </Form.Item>
          </>
        );
        if (!watchedValues.isDeliveryFeeAmountManual) {
          disabled = true;
        } else {
          disabled = false;
        }
      }

      return {
        inputType: "number",
        formItemName: getFormItemName(record, editableCellKeys.deliveryFeeExcludeVat),
        editing: isEditing(record),
        disabled,
        additionalNodePrefix,
      };
    },
  };

  const priceExcludeVatColumn: EditableColumnType<TProductPricingTableDataSource> = {
    title: makeProductSupplyTotalColTitle(),
    key: "priceExcludeVat",
    align: "right",
    width: 120,
    render: (_: any, record: TProductPricingTableDataSource) => {
      const deliveryFeeExcludeVatWatched = getDeliveryFeeExcludeVatWathched(record, watchedValues);
      const costPriceExcludeVat = getCostPriceExcludeVat(record, false);
      const deliveryFeeExcludeVat = getDeliveryFeeExcludeVat(record, false);
      if (checkIsTVariantForPrice(record) && record.formMode === "trackInventory") {
        const priceExcludeVat = costPriceExcludeVat + deliveryFeeExcludeVat;
        return <NumberComponent value={priceExcludeVat} />;
      }
      const priceExcludeVat =
        costPriceExcludeVat + (isEditing(record) ? deliveryFeeExcludeVatWatched : deliveryFeeExcludeVat);
      return <NumberComponent value={priceExcludeVat} />;
    },
  };

  const actionColumn: EditableColumnType<TProductPricingTableDataSource> = {
    key: "action",
    align: "center",
    width: 120,
    fixed: fixedRightFlag,
    render: (_: any, record: TProductPricingTableDataSource) => {
      if (isEditing(record)) {
        return (
          <Space size="small">
            <Button
              disabled={selectedRowId === "" || disabled}
              type="primary"
              onClick={onRowSubmitClick}
              style={{ marginRight: 8 }}
            >
              저장
            </Button>
            <Button type="default" onClick={onCancel}>
              취소
            </Button>
          </Space>
        );
      } else {
        return (
          <Button disabled={selectedRowId !== "" || disabled} type="primary" onClick={() => onEdit(record)}>
            수정
          </Button>
        );
      }
    },
  };

  columns = [
    !isInnerVariantTable && trackInventoryColumn,
    costPriceExcludeVatColumn,
    deliveryFeeExcludeVatColumn,
    priceExcludeVatColumn,
    actionColumn,
  ];

  return columns.filter(Boolean);
};
</file>

