      value: filterVariables.purchaseOrderSearch || "",
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: filterVariables.vendorSearch || "",
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: filterVariables.orderSearch || "",
    },
    b2bOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bOrderSearch, true), false),
      value: filterVariables.b2bOrderSearch || "",
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: filterVariables.userSearch || "",
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: filterVariables.brandStoreSearch || "",
    },
    purchaseDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.purchaseDate.gte, filterVariables.purchaseDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.purchaseDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.purchaseDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    purchaseOrderDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseOrderDate.gte, filterVariables.purchaseOrderDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseOrderDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.purchaseOrderDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    expectedPurchaseDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.expectedPurchaseDate.gte, filterVariables.expectedPurchaseDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.expectedPurchaseDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.expectedPurchaseDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    askingPurchaseDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.askingPurchaseDate.gte, filterVariables.askingPurchaseDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.askingPurchaseDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.askingPurchaseDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    eventType: {
      active: maybe(() => !utils.isEmpty(filterVariables.eventType), false),
      value: maybe(() => dedupeFilter(filterVariables.eventType), []),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => dedupeFilter(filterVariables.status), []),
    },
    isNotOrderableBeforeStocked: {
      active: maybe(() => !utils.isEmpty(filterVariables.isNotOrderableBeforeStocked), false),
      value: maybe(() => filterVariables.isNotOrderableBeforeStocked, false),
    },
    isForPackageOrder: {
      active: maybe(() => !utils.isEmpty(filterVariables.isForPackageOrder), false),
      value: maybe(() => filterVariables.isForPackageOrder, false),
    },
    draftStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.draftStatusAt.gte, filterVariables.draftStatusAt.lte]),
        false
