  ProductTypeDetails_productType_productAttributes,
  ProductTypeDetails_productType_variantAttributes,
} from "../../api/types/ProductTypeDetails";
import { ProductTypeAttributesProps } from "./ProductTypeAttributes";

export const getProductTypeAttributesTableColumns = (props: ProductTypeAttributesProps) => {
  const { productType, onAttributeClick, onAttributeUnassign } = props;
  const columns: ColumnsType<
    ProductTypeDetails_productType_productAttributes | ProductTypeDetails_productType_variantAttributes
  > = [
    {
      key: "sort",
      width: 40,
      align: "center",
      render: () => <DragHandle />,
    },
    {
      title: "제품 속성 이름",
      key: "name",
      align: "left",
      width: 120,
      render: (_, record) => (
        <Typography.Link onClick={() => onAttributeClick(record.id)}>{record.name || "-"}</Typography.Link>
      ),
    },
    {
      title: "속성 코드",
      key: "slug",
      align: "center",
      width: 120,
      render: (_, record) => record.slug || "-",
