import { Area } from "@ant-design/charts";
import { LeftOutlined, RightOutlined } from "@ant-design/icons";
import { commonMsg } from "@assets/messages/commonMsg";
import { SalesDataInput } from "@src/api/types/globalTypes";
import { FieldPath } from "@src/app/components/antd/types/GenericFieldPath";
import EditableField from "@src/app/components/EditableField/EditableField";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { storeSaleListQuery, useStoreSalesQuery } from "@src/app/views/brand/brandStore/api/queries";
import {
  getAverageMonthlySales,
  getAverageMonthlySalesByPeong,
  getTotalSales,
  makeSalesChartConfig,
} from "@src/app/views/brand/brandStore/utils";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, Row, Skeleton, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { useBrandStoreSalesUpsertMutation } from "../api/mutations";
import { BrandStoreDetails_brandStore } from "../api/types/BrandStoreDetails";

interface BrandStoreSalesInfoProps {
  brandStore: BrandStoreDetails_brandStore;
}

const months: Array<FieldPath<SalesDataInput>> = [
  "jan",
  "feb",
  "mar",
  "apr",
  "may",
  "jun",
  "jul",
  "aug",
  "sep",
  "oct",
  "nov",
  "dec",
];
const monthsKorean = ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"];

export const BrandStoreSalesInfo: React.FC<BrandStoreSalesInfoProps> = (props) => {
  const { brandStore } = props;
  const [year, setYear] = useState(new Date().getFullYear());

  const [editMode, setEditMode] = useState(false);
  const [form] = Form.useForm<SalesDataInput>();
  const [originalData, setOriginalData] = useState<SalesDataInput | null>(null);
  const currentYear = new Date().getFullYear();

  const { data, loading } = useStoreSalesQuery({
    variables: { id: brandStore.id, year },
  });
  const salesData = maybe(() => data.storeSales.salesData, null);

  useEffect(() => {
    if (salesData) {
      form.setFieldsValue(salesData);
      setOriginalData(salesData);
    } else {
      form.resetFields();
    }
  }, [salesData, form]);

  const [brandStoreSalesUpsert, brandStoreSalesUpsertOpts] = useBrandStoreSalesUpsertMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandStoreSalesUpsert.errors, commonMsg.savedChanges, () => {
        setEditMode(false);
      }),
  });

  const handleSubmit = async (values: SalesDataInput) => {
    await brandStoreSalesUpsert({
      variables: {
        input: {
          brandStore: brandStore.id,
          year,
          salesData: values,
        },
      },
      update: (cache, { data }) => {
        const newSalesData = data?.brandStoreSalesUpsert?.storeSales?.salesData;
        if (!newSalesData) {
          return;
        }

        cache.writeQuery({
          query: storeSaleListQuery,
          variables: { id: brandStore.id, year },
          data: {
            storeSales: data?.brandStoreSalesUpsert?.storeSales,
          },
        });
      },
    });
  };

  const handleCancel = () => {
    if (originalData) {
      form.setFieldsValue(originalData);
    }
    setEditMode(false);
  };

  return (
    <Form form={form} layout="vertical" onFinish={handleSubmit}>
      <Card
        title={<Typography.Title level={4}>매출정보</Typography.Title>}
        extra={
          <FormSaveButton
            form={form}
            loading={brandStoreSalesUpsertOpts.loading}
            isEditMode={editMode}
            onEdit={() => setEditMode(true)}
            onCancel={handleCancel}
          />
        }
      >
        {/* 연도 선택 영역 */}
        <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 12 }}>
          <Button icon={<LeftOutlined />} onClick={() => setYear((prev) => prev - 1)} />
          <Typography.Title level={3} style={{ margin: 0 }}>
            {year}년
          </Typography.Title>
          <Button
            icon={<RightOutlined />}
            onClick={() => setYear((prev) => (prev < currentYear ? prev + 1 : prev))}
            disabled={year >= currentYear}
          />
        </div>

        {loading ? (
          <Skeleton active />
        ) : (
          <>
            {editMode && (
              <Row gutter={[8, 8]}>
                {months.map((month, index) => (
                  <Col span={6} key={month}>
                    <EditableField
                      label={monthsKorean[index]}
                      type="number"
                      name={month}
                      placeholder="매출액을 입력하세요."
                      addonAfter="원"
                      editMode={editMode}
                    />
                  </Col>
                ))}
              </Row>
            )}

            <Area {...makeSalesChartConfig(salesData)} />

            <div style={{ display: "flex", marginTop: 16, gap: 8 }}>
              <Card style={{ flex: 1 }}>
                <div>총 매출액</div>
                <Typography.Title level={5}>{getTotalSales(salesData)?.toLocaleString() ?? "-"} 원</Typography.Title>
              </Card>
              <Card style={{ flex: 1 }}>
                <div>월 평균 매출액</div>
                <Typography.Title level={5}>
                  {getAverageMonthlySales(salesData)?.toLocaleString() ?? "-"} 원
                </Typography.Title>
              </Card>
              <Card style={{ flex: 1 }}>
                <div>평당 매출액</div>
                <Typography.Title level={5}>
                  {getAverageMonthlySalesByPeong(brandStore, salesData)?.toLocaleString() ?? "-"} 원
                </Typography.Title>{" "}
              </Card>
            </div>
          </>
        )}
      </Card>
    </Form>
  );
};
</file>

