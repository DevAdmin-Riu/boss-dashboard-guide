import { sectionNames } from "@assets/messages/sectionNames";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  boxSpecForPickingOrderViewPath,
  BoxSpecForPickingOrderViewUrlQueryParams,
  siteSettingsViewPath,
  SiteSettingsViewUrlQueryParams,
} from "./urls";
import { BoxSpecForPickingOrderView } from "./views/BoxSpecForPickingOrderView";
import { SiteSettingsView } from "./views/SiteSettingsView";

const SiteSettingsViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: SiteSettingsViewUrlQueryParams = qs;

  return <SiteSettingsView params={params} />;
};

const BoxSpecForPickingOrderViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: BoxSpecForPickingOrderViewUrlQueryParams = qs;

  return <BoxSpecForPickingOrderView params={params} />;
};

export const SiteSettingsSection: React.FC = () => (
  <>
    <WindowTitle title={sectionNames.siteSettings} />
    <Switch>
      <Route exact path={siteSettingsViewPath} component={SiteSettingsViewWrapper} />
      <Route exact path={boxSpecForPickingOrderViewPath} component={BoxSpecForPickingOrderViewWrapper} />
    </Switch>
  </>
);
export default SiteSettingsSection;
</file>

