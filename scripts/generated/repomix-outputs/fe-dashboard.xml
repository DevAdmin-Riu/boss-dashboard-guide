    render: (_, record) => getProductName(record),
  };
  const bpSkuColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    width: 140,
    render: (_, record) => {
      const isDefaultVariant = getIsDefaultVariant(record);

      return (
        <Space direction={"vertical"} size={0}>
          {useBpSkuMode && isDefaultVariant && <Tag color={"warning"}>기본</Tag>}
          {getBpSku(record)}
        </Space>
      );
    },
  };
  const brandProductNameColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "brandProductName",
    align: "left",
    width: 200,
    render: (_, record) => getBrandProductName(record),
  };
  const variantNameColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    align: "left",
    width: 120,
    render: (_, record) => getProductVariantName(record),
  };
  const attributesColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 200,
    render: (_, record) => getAttributes(record),
  };
  const qtyPerBoxColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
    key: "attrQuantity",
    align: "right",
    width: 80,
    render: (_, record) => getQtyPerBox(record),
  };
  const fulfillmentTypeColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    align: "center",
    title: columnNameConstant.order.FULFILLMENT_TYPE,
    key: "fulfillmentType",
    width: 100,
    render: (_, record) =>
      makeTagFulfillmentTypeForCreateAdminOrder(
        record.brandProductVariant.productVariant.trackInventory,
        record.brandProductVariant.productVariant.isVendorTrackInventory
      ),
  };
  const mallPriceColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: isIncludeVat ? columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE : "공급가",
    key: "mallPrice",
    align: "right",
    width: 110,
    render: (_, record) => {
      const mallPrice = getMallPrice(record);
      if (isIncludeVat) {
        return <NumberComponent value={mallPrice} />;
      }
      const isTaxFree = record.product?.isTaxFree;
      const mallPriceExcludeVat = toPriceExcludeVat(mallPrice, isTaxFree);
      return <NumberComponent value={mallPriceExcludeVat} />;
    },
  };
  const isTaxFreeColumn: ColumnType<ExtendedBrandProductVariantsNode> = {
    title: columnNameConstant.product.IS_TAX_FREE,
    key: "isTaxFree",
    align: "center",
    width: 90,
    render: (_, record) => transformTaxFree(record?.product?.isTaxFree),
  };

  const columns: ColumnsType<ExtendedBrandProductVariantsNode> = [
    (useBpSkuMode === false || (isHqStaff === false && isByStaffForB2b)) && skuColumn,
    (useBpSkuMode === false || (isHqStaff === false && isByStaffForB2b)) && productNameColumn,
    useBpSkuMode && bpSkuColumn,
    useBpSkuMode && brandProductNameColumn,
    variantNameColumn,
    attributesColumn,
    isTaxFreeColumn,
    qtyPerBoxColumn,
    !isByHqStaffForBrand && fulfillmentTypeColumn,
    mallPriceColumn,
  ].filter(Boolean);

  return columns;
};
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderBrandProductListTable/utils.ts">
import { CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node } from "@src/app/views/brand/brands/api/types/CreateAdminAtBrandProductListWithOnlyNonStoppedVariants";
import { CreateAdminAtProductVariantList_productVariants_edges_node } from "@src/app/views/product/products/api/types/CreateAdminAtProductVariantList";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { utils } from "@utils/utils";

import {
  CreateAdminExtendedProductVariantEdgesNode,
  CreateAdminProductVariantEdgesNode,
  ICreateAdminOrderFormLine,
} from "../../views/CreateAdminOrderView/CreateAdminOrderView";
import { ExtendedBrandProductVariantsNode } from "../CreateAdminOrderProductListModal/CreateAdminOrderProductListModal";
import { brandProductListProcessingData } from "../CreateAdminOrderProductListModal/utils";

export const productVariantListProcessingData = (
  searchProductVariantList: CreateAdminProductVariantEdgesNode[],
  isForBrandOrForB2b: boolean
): CreateAdminExtendedProductVariantEdgesNode[] => {
  if (searchProductVariantList === undefined) {
    return [];
  }
  if (isForBrandOrForB2b && searchProductVariantList) {
    const brandProductListTableData = brandProductListProcessingData(
      searchProductVariantList as CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node[]
    );

    return brandProductListTableData;
  } else {
    return searchProductVariantList as CreateAdminAtProductVariantList_productVariants_edges_node[];
  }
};

export const getSku = (record: ExtendedBrandProductVariantsNode) => record?.brandProductVariant?.productVariant?.sku;

export const getBpSku = (record: ExtendedBrandProductVariantsNode) => record?.brandProductVariant?.bpSku;

export const getIsDefaultVariant = (record: ExtendedBrandProductVariantsNode) => {
  const hasVariants = record?.product?.productType?.hasVariants;
  const productVariantId = record?.brandProductVariant?.variantId;
  const defaultProductVariantId = record?.product?.defaultVariantId;
  const isDefaultVariant =
    utils.isEmpty(productVariantId) || utils.isEmpty(defaultProductVariantId) || !hasVariants
      ? false
      : productVariantId === defaultProductVariantId;

  return isDefaultVariant;
};

export const getBrandProductName = (record: ExtendedBrandProductVariantsNode) => record?.name || "-";

export const getProductName = (record: ExtendedBrandProductVariantsNode) => record?.product?.name || "-";

export const getProductVariantName = (record: ExtendedBrandProductVariantsNode) =>
  record?.brandProductVariant?.productVariant?.name || "-";

export const getAttributes = (record: ExtendedBrandProductVariantsNode) => {
  const hasVariants = record?.product?.productType?.hasVariants;
  const targetAttributes = hasVariants
    ? record?.brandProductVariant?.productVariant?.attributes
    : record?.product?.attributes;
  return makeProductSpecTextFromAttr(targetAttributes) || "-";
};

export const getQtyPerBox = (record: ExtendedBrandProductVariantsNode) =>
  makeProductQtyPerBoxText(record?.brandProductVariant?.productVariant) || "-";

export const getTrackInventory = (record: ExtendedBrandProductVariantsNode) =>
  record.brandProductVariant.productVariant.trackInventory;

export const getMallPrice = (record: ExtendedBrandProductVariantsNode) => {
  const mallPrice = record?.brandProductVariant?.priceAmount;
  return mallPrice;
};

export const getBrandProductVariantObj = (
  record: ExtendedBrandProductVariantsNode,
  isByStaffForB2b: boolean,
  isByHqStaffForBrand: boolean = false
): ICreateAdminOrderFormLine => {
  const mallPrice = getMallPrice(record);
  const mallPriceExcludeVat = record.brandProductVariant.priceAmount - record.brandProductVariant.priceVat;

  return {
    id: record.id,
    sku: getSku(record),
    bpSku: getBpSku(record),
    isDefaultVariant: getIsDefaultVariant(record),
    productName: getProductName(record),
    brandProductName: getBrandProductName(record),
    variantName: getProductVariantName(record),
    attributes: getAttributes(record),
    qtyPerBox: getQtyPerBox(record),
    trackInventory: getTrackInventory(record),
    isVendorTrackInventory: record.brandProductVariant.productVariant.isVendorTrackInventory,
    priceIncludeVat: record.brandProductVariant.productVariant.isDeferred ? 0 : mallPrice,
    priceExcludeVat: record.brandProductVariant.productVariant.isDeferred ? 0 : mallPriceExcludeVat,
    priceVat: record.brandProductVariant.productVariant.isDeferred ? 0 : record.brandProductVariant.priceVat,
    qty: isByStaffForB2b || isByHqStaffForBrand ? record.product.moq : 0,
    isTaxFree: record.product.isTaxFree,
    pricePrecision: record.brandProductVariant.productVariant.priceDecimalPlaces,
    orderQtyPrecision: record.brandProductVariant.productVariant.orderQtyDecimalPlaces,
    isDeferred: record.brandProductVariant.productVariant.isDeferred,
    excludeStockAvgStats: false,
    moq: record.product.moq,
    noteForUnitPrice: record.brandProductVariant.productVariant.defaultVariantVendor?.noteForUnitPrice || "",
    needDeliveryAdditionalFee:
      record.brandProductVariant.needDeliveryAdditionalFee &&
      record.brandProductVariant.productVariant.needDeliveryAdditionalFee,
    includeSalesB2bDeliveryFee: record.brandProductVariant.includeSalesB2bDeliveryFee,
    isAdjustPrice: record.brandProductVariant.productVariant.isAdjustPrice,
    qtyPerDeliveryBox: record.brandProductVariant.productVariant.qtyPerDeliveryBox,
    isBundle: record.isBundle || false,
    bundleComponentQtySum: record.bundleComponentQtySum || 0,
  };
};
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderEditProductListTable/CreateAdminOrderEditProductListTableSetting.tsx">
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import DeliveryFeeInclusionStatus from "@src/app/components/DeliveryFeeInclusionStatus";
import { PriceWithVatFormItem } from "@src/app/components/PriceWithVatFormItem";
import { calcVatByPriceExcludeVat, calcVatByPriceIncludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformIsDeferred, transformTaxFree } from "@utils/misc";
import { makeTagFulfillmentTypeForCreateAdminOrder } from "@utils/tags";
import { utils } from "@utils/utils";
import { Button, Checkbox, Form, FormInstance, InputNumber, InputNumberProps, Switch, Tag, Typography } from "antd";
import { ColumnType } from "antd/lib/table";
import React from "react";

import { ICreateAdminOrderFormLine } from "../../views/CreateAdminOrderView/CreateAdminOrderView";

interface CreateAdminOrderEditProductListTableSettings {
  form: FormInstance;
  isHqStaff: boolean;
  isByStaffForEtc: boolean;
  isByStaffForBrand: boolean;
  isByStaffForB2b: boolean;
  isByHqStaffForBrand: boolean;
  isShowNoteForUnitPriceMode: boolean;
  isB2bTakeBackWatched: boolean;
  chargeDeliveryAdditionalFee: boolean;
  onShowNoteForUnitPrice: (noteForUnitPrice: string) => void;
}

export const getCreateAdminOrderEditProductListTableSettings = (
  props: CreateAdminOrderEditProductListTableSettings
) => {
  const {
    form,
    isHqStaff,
    isByStaffForEtc,
    isByStaffForBrand,
    isByStaffForB2b,
    isByHqStaffForBrand,
    isB2bTakeBackWatched,
    onShowNoteForUnitPrice,
    isShowNoteForUnitPriceMode,
    chargeDeliveryAdditionalFee,
  } = props;
  const useBpSkuMode = isByStaffForBrand || isByStaffForB2b || isByHqStaffForBrand;
  const skuColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.SKU,
    key: "sku",
    align: "center",
    width: 120,
    render: (_, record) => record.sku,
  };
  const productNameColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.PRODUCT_NAME,
    key: "productName",
    align: "left",
    width: 200,
    render: (_, record) => record.productName,
  };
  const bpSkuColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    width: 140,
    render: (_, record) => record.bpSku,
  };
  const brandProductNameColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "brandProductName",
    align: "left",
    width: 200,
    render: (_, record) => record.brandProductName,
  };
  const variantNameColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    align: "center",
    width: 150,
    render: (_, record) => record.variantName,
  };
  const attributesColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 200,
    render: (_, record) => record.attributes,
  };
  const qtyPerBoxColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
    key: "qtyPerBox",
    align: "right",
    width: 80,
    render: (_, record) => record.qtyPerBox,
  };
  const priceColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: "판매가",
    key: "price",
    align: "right",
    width: 150,
    render: (_, record) => {
      // 패키지 상품이고 isStaff(일반 스태프)가 주문하는 경우 readonly + disabled 처리
      // isHqStaff는 현재 조건만 유지 (readOnly, bordered)
      const isPackageForStaff = record.isPackage && isByStaffForBrand && !isByHqStaffForBrand;
      const commonInputNumberProps: InputNumberProps = {
        readOnly: isByHqStaffForBrand || isPackageForStaff,
        bordered: !isByHqStaffForBrand && !isPackageForStaff,
      };
      if (isByStaffForB2b) {
        const priceFieldDisabled = record?.isDeferred || isPackageForStaff || isHqStaff;
        return (
          <PriceWithVatFormItem
            form={form}
            isTaxFree={record.isTaxFree}
            priceExcludeVatField={{
              name: ["linesObj", record.id, "priceExcludeVat"],
              inputNumberProps: {
                ...commonInputNumberProps,
                onChange: (value) => {
                  const priceExcludeVat = utils.convertToNumberWrapper(value);
                  const priceVat = calcVatByPriceExcludeVat(priceExcludeVat, record.isTaxFree);
                  form.setFieldValue(["linesObj", record.id, "priceExcludeVat"], priceExcludeVat);
                  form.setFieldValue(["linesObj", record.id, "priceVat"], priceVat);
                },
                precision: record.pricePrecision,
              },
              isNotShowAddonBefore: commonInputNumberProps.readOnly,
            }}
            vatField={{
              name: ["linesObj", record.id, "priceVat"],
              formItemProps: { hidden: commonInputNumberProps.readOnly },
              inputNumberProps: {
                onChange: (value) => form.setFieldValue(["linesObj", record.id, "priceVat"], value),
                precision: record.pricePrecision,
              },
            }}
            disabled={priceFieldDisabled}
          />
        );
      }

      return (
        <Form.Item name={["linesObj", record.id, "priceIncludeVat"]} style={{ marginBottom: 0 }}>
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true, precision: record.pricePrecision })}
            {...commonInputNumberProps}
            onChange={(value) => {
              const priceIncludeVat = utils.convertToNumberWrapper(value);
              const priceExcludeVat = toPriceExcludeVat(priceIncludeVat, record.isTaxFree);
              const priceVat = calcVatByPriceIncludeVat(priceIncludeVat, record.isTaxFree);
              form.setFieldValue(["linesObj", record.id, "priceIncludeVat"], priceIncludeVat);
              form.setFieldValue(["linesObj", record.id, "priceExcludeVat"], priceExcludeVat);
              form.setFieldValue(["linesObj", record.id, "priceVat"], priceVat);
            }}
            disabled={record?.isDeferred || isPackageForStaff}
          />
        </Form.Item>
      );
    },
  };
  const qtyColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: isB2bTakeBackWatched ? columnNameConstant.orderLine.REFUNDED_QTY : columnNameConstant.orderLine.ORDER_QTY,
    key: "qty",
    align: "right",
    width: 110,
    render: (_, record) => (
      <Form.Item name={["linesObj", record.id, "qty"]} style={{ marginBottom: 0 }}>
        <InputNumber
          {...getInputNumberProps({ isCommaDisplay: true, precision: record.orderQtyPrecision })}
          onChange={(value) => {
            form.setFieldValue(["linesObj", record.id, "qty"], value);
          }}
        />
      </Form.Item>
    ),
  };

  const isHqStaffBrandOrder = isByHqStaffForBrand;

  const excludeStockAvgStatsColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: "수요예측제외",
    key: "excludeStockAvgStats",
    align: "center",
    width: 100,
    render: (_, record) => {
      // trackInventory가 false(위탁)인 경우 "-" 표시
      if (!record.trackInventory) {
        return <Typography.Text type="secondary">-</Typography.Text>;
      }

      return (
        <Form.Item
          name={["linesObj", record.id, "excludeStockAvgStats"]}
          style={{ marginBottom: 0 }}
          valuePropName="checked"
        >
          <Checkbox
            disabled={isHqStaffBrandOrder}
            onChange={(e) => {
              form.setFieldValue(["linesObj", record.id, "excludeStockAvgStats"], e.target.checked);
            }}
          />
        </Form.Item>
      );
    },
  };
  const includeSalesB2bDeliveryFeeColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.orderLine.INCLUDE_SALES_B2B_DELIVERY_FEE,
    key: "includeSalesB2bDeliveryFee",
    align: "center",
    width: 130,
    render: (_, record) => <DeliveryFeeInclusionStatus isIncluded={record.includeSalesB2bDeliveryFee} />,
  };
  const b2bDeliveryFeeExcludeVatColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.orderLine.B2B_DELIVERY_FEE_SALE,
    key: "b2bDeliveryFeeExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => {
      const readOnly = isByHqStaffForBrand || isB2bTakeBackWatched;
      return (
        <Form.Item name={["linesObj", record.id, "b2bDeliveryFeeExcludeVat"]} style={{ marginBottom: 0 }}>
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            readOnly={readOnly}
            bordered={!readOnly}
            onChange={(value) => {
              form.setFieldValue(["linesObj", record.id, "b2bDeliveryFeeExcludeVat"], value);
            }}
            disabled={record?.isDeferred || (isByHqStaffForBrand === false && record.includeSalesB2bDeliveryFee)}
          />
        </Form.Item>
      );
    },
  };
  const needDeliveryAdditionalFeeColumn: ColumnType<ICreateAdminOrderFormLine> = {
    align: "center",
    title: columnNameConstant.brand.DELIVERY_ADDITIONAL_DELIVERY_FEE_CHARGED,
    key: "needDeliveryAdditionalFee",
    width: 110,
    render: (_, record) => <Checkbox disabled checked={record.needDeliveryAdditionalFee} />,
  };
  const fulfillmentTypeColumn: ColumnType<ICreateAdminOrderFormLine> = {
    align: "center",
    title: columnNameConstant.order.FULFILLMENT_TYPE,
    key: "fulfillmentType",
    width: 100,
    render: (_, record) =>
      makeTagFulfillmentTypeForCreateAdminOrder(record.trackInventory, record.isVendorTrackInventory),
  };
  const decreaseStockFlagColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: "재고 반영 여부",
    key: "decreaseStockFlag",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Form.Item name={["linesObj", record.id, "decreaseStockFlag"]} style={{ marginBottom: 0 }}>
        <Switch
          checkedChildren="반영"
          unCheckedChildren="미반영"
          onChange={(value) => {
            form.setFieldValue(["linesObj", record.id, "decreaseStockFlag"], value);
          }}
        />
      </Form.Item>
    ),
  };

  const isTaxFreeColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.IS_TAX_FREE,
    key: "isTaxFree",
    align: "center",
    width: 90,
    render: (_, record) => {
      // 패키지 상품인 경우 "-" 표시
      if (record.isPackage) {
        return "-";
      }
      return transformTaxFree(record?.isTaxFree);
    },
  };
  const isDeferredColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: columnNameConstant.product.IS_DEFERRED,
    key: "isDeferred",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Tag color={record.isDeferred ? "volcano" : "blue"}>{transformIsDeferred(record.isDeferred)}</Tag>
    ),
  };
  const noteForUnitPriceColumn: ColumnType<ICreateAdminOrderFormLine> = {
    title: "수량 별 단가",
    key: "noteForUnitPrice",
    align: "center",
    width: 90,
    render: (_, record) =>
      utils.isEmpty(record.noteForUnitPrice) ? (
        <Typography.Text type="secondary">정보 없음</Typography.Text>
      ) : (
        <Button onClick={() => onShowNoteForUnitPrice(record.noteForUnitPrice)}>상세보기</Button>
      ),
  };

  if (isByStaffForB2b) {
    return [
      isHqStaff === false && skuColumn,
      isHqStaff === false && productNameColumn,
      bpSkuColumn,
      brandProductNameColumn,
      qtyColumn,
      priceColumn,
      includeSalesB2bDeliveryFeeColumn,
      b2bDeliveryFeeExcludeVatColumn,
      variantNameColumn,
      attributesColumn,
      isTaxFreeColumn,
      qtyPerBoxColumn,
      fulfillmentTypeColumn,
      isDeferredColumn,
      isShowNoteForUnitPriceMode && noteForUnitPriceColumn,
    ].filter(Boolean);
  } else {
    return [
      useBpSkuMode === false && skuColumn,
      useBpSkuMode && bpSkuColumn,
      priceColumn,
      qtyColumn,
      isByStaffForBrand &&
        chargeDeliveryAdditionalFee &&
        isByHqStaffForBrand === false &&
        needDeliveryAdditionalFeeColumn,
      isByStaffForBrand && isByHqStaffForBrand === false && excludeStockAvgStatsColumn,
      isByStaffForEtc && decreaseStockFlagColumn,
      useBpSkuMode === false && productNameColumn,
      useBpSkuMode && brandProductNameColumn,
      variantNameColumn,
      attributesColumn,
      isTaxFreeColumn,
      qtyPerBoxColumn,
      isByHqStaffForBrand === false && fulfillmentTypeColumn,
      isByHqStaffForBrand === false && isDeferredColumn,
      isShowNoteForUnitPriceMode && noteForUnitPriceColumn,
    ].filter(Boolean);
  }
};
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderPage/CreateAdminOrderAddressInfoCard.tsx">
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { utils } from "@utils/utils";
