import { BrandStoreFilterInput, BrandStoreStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  BrandStoreListViewUrlFilters,
  BrandStoreListViewUrlFiltersEnum,
  BrandStoreListViewUrlFiltersMultipleValuesEnum,
  BrandStoreListViewUrlQueryParams,
} from "@src/app/views/brand/brandStore/urls";
import {
  dedupeFilter,
  getMultipleEnumValueQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  HqBrandStoreMapListFilterKeys,
  HqBrandStoreMapListFilterOpts,
} from "../../components/HqBrandStoreMapListPage/filters";

export const HQ_BRAND_STORE_MAP_FILTERS_KEY = "hqBrandStoreMapFilters";

export function getFilterOpts(params: BrandStoreListViewUrlQueryParams): HqBrandStoreMapListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    regionInfo: {
      active: maybe(() => !utils.isEmpty(filterVariables.regionInfo, true), false),
      value: maybe(() => filterVariables.regionInfo, []),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status, true), false),
      value: maybe(
        () => dedupeFilter(filterVariables.status.map((item) => findValueInEnum(item, BrandStoreStatusEnum))),
        []
      ),
    },
  };
}

export function getFilterVariables(params: BrandStoreListViewUrlFilters): BrandStoreFilterInput {
  return {
    brandStoreSearch: params.brandStoreSearch,
    regionInfo: maybe(() => params.regionInfo),
    status: maybe(() => params.status.map((item) => findInEnum(item, BrandStoreStatusEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<HqBrandStoreMapListFilterKeys>
): BrandStoreListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqBrandStoreMapListFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.brandStoreSearch);
    case HqBrandStoreMapListFilterKeys.regionInfo:
      return getMultipleValueQueryParam(filter, BrandStoreListViewUrlFiltersMultipleValuesEnum.regionInfo);
    case HqBrandStoreMapListFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandStoreListViewUrlFiltersMultipleValuesEnum.status,
        BrandStoreStatusEnum
      );
  }
}
</file>

<file path="src/app/views/hqStaff/hqBrandStore/views/HqBrandStoreMapListView/HqBrandStoreMapListView.tsx">
import { LatLngInput } from "@src/api/types/globalTypes";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { useBrandStoreServiceAreaUpdateMutation } from "@src/app/views/brand/brandStore/api/mutations";
import { useBrandStoreListForHqMapQuery } from "@src/app/views/brand/brandStore/api/queries";
import {
  BrandStoreListForHqMap_brandStores_edges_node,
  BrandStoreListForHqMapVariables,
} from "@src/app/views/brand/brandStore/api/types/BrandStoreListForHqMap";
import { BrandStoreListViewUrlQueryParams } from "@src/app/views/brand/brandStore/urls";
import { hqBrandStoreDetailsViewUrl, hqBrandStoreMapListViewUrl } from "@src/app/views/hqStaff/hqBrandStore/urls";
import { ListViews } from "@src/global/core/types/types";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { checkIsLatLngInPolygon, getLatLngFromAddress, MapLatLng, MapMarker } from "@utils/kakao/kakaoMap";
import { getBrandId, maybe, transformAddress } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import React, { useEffect, useMemo, useRef, useState } from "react";

import { HqBrandStoreMapListPage } from "../../components/HqBrandStoreMapListPage/HqBrandStoreMapListPage";
import { getFilterOpts, getFilterQueryParam, getFilterVariables } from "./filters";

interface HqBrandStoreMapListViewProps {
  params: BrandStoreListViewUrlQueryParams;
}

export const HqBrandStoreMapListView: React.FC<HqBrandStoreMapListViewProps> = ({ params }) => {
  const shop = useShop();
  const { user } = useAuth();
  const brandId = getBrandId(user);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.HQ_BRAND_STORE_MAP_LIST,
  });
  const [selectedRowId, setSelectedRowId] = useState<string>(null);
  const [mapCenter, setMapCenter] = useState<MapLatLng>(null);
  const [mapMarkers, setMapMarkers] = useState<MapMarker[]>([]);

  // NOTE: KakaoMap 컴포넌트의 onSave props로 전달되는 handleBrandStoreServiceAreaUpdate에 실시간 id 값 전달을 위해 필요
  const selectedBrandStoreRef = useRef<BrandStoreListForHqMap_brandStores_edges_node>(null);

  const queryVariables = useMemo<BrandStoreListForHqMapVariables>(
    () => ({ ...paginationState, filter: { ...getFilterVariables(params), brandId } }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBrandStoreListForHqMapQuery({
    initialListSkip: true,
    variables: queryVariables,
  });
  const brandStores = maybe(() => data?.brandStores?.edges.map((edge) => edge.node), []);
  selectedBrandStoreRef.current = maybe(() => brandStores.find((store) => store.id === selectedRowId), null);

  const [brandStoreServiceAreaUpdate, brandStoreServiceAreaUpdateOpts] = useBrandStoreServiceAreaUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandStoreBasicInfoUpdate.errors, "지정한 영업 구역이 저장되었습니다."),
  });

  const handleBrandStoreServiceAreaUpdate = async (serviceArea: LatLngInput[]) => {
    if (utils.isEmpty(selectedBrandStoreRef.current, true)) {
      showNotificationError("영업 구역을 업데이트할 매장을 선택해주세요.");
      return;
    }
    if (utils.isEmpty(serviceArea)) {
      showNotificationError("영업 구역을 새로 지정해주세요.");
      return;
    }
    if (serviceArea.length < 3) {
      showNotificationError("영업 구역은 최소 3개 이상의 지점이 필요합니다.");
      return;
    }
    const { id, address } = selectedBrandStoreRef.current;
    if (address) {
      const addressText = transformAddress(address);
      const coords = await getLatLngFromAddress(addressText);
      const isInside = checkIsLatLngInPolygon(coords, serviceArea);
      if (!isInside) {
        showNotificationError("선택된 매장의 주소가 영업 구역 안에 있어야 합니다.");
        return;
      }
    }
    brandStoreServiceAreaUpdate({ variables: { id, serviceArea } });
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brandStores?.pageInfo,
    paginationState,
    params,
  });

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: hqBrandStoreMapListViewUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: refetch,
  });

  // 매장 클릭 시 지도 중심 이동
  const handleRowClick = async (id: string) => {
    setSelectedRowId(id);
    const store = brandStores.find((b) => b.id === id);
    if (store.address) {
      const addressText = transformAddress(store.address);
      const coords = await getLatLngFromAddress(addressText);
      if (coords) {
        setMapCenter(coords);
      }
    }
  };

  // 브랜드 스토어 리스트가 바뀔 때마다 markers 동기화
  useEffect(() => {
    setSelectedRowId(null);
    const fetchMarkers = async () => {
      const markerResults: MapMarker[] = [];
      for (const store of brandStores) {
        if (store.address) {
          const addressText = transformAddress(store.address);
          const coords = await getLatLngFromAddress(addressText);
          if (coords) {
            markerResults.push({ lat: coords.lat, lng: coords.lng, name: store.name });
          }
        }
      }
      setMapMarkers(markerResults);
    };

    if (!loading) {
      fetchMarkers();
    }
  }, [loading]);

  const pageLoading = loading || brandStoreServiceAreaUpdateOpts.loading;

  return (
    <>
      <HqBrandStoreMapListPage
        shop={shop}
        brandStores={brandStores}
        disabled={pageLoading}
        selectedRowId={selectedRowId}
        mapCenter={mapCenter}
        mapMarkers={mapMarkers}
        onRowClick={(id) => handleRowClick(id)}
        onDetails={(id) => navigate(hqBrandStoreDetailsViewUrl(id))}
        onServiceAreaUpdate={handleBrandStoreServiceAreaUpdate}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onFilterReset={resetFilters}
        settings={settings}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
      />
    </>
  );
};
</file>

