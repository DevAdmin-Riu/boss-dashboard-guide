import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  HqMileageSettlementFilterKeys,
  HqMileageSettlementListFilterOpts,
  HqMonthlySettlementTypeEnum,
} from "@src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/filters";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getSingleEnumValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { HqMileageSettlementListFilterVariables } from "../../components/HqMileageSettlementListPage/HqMileageSettlementListPage";
import {
  HqMileageSettlementListViewUrlFilters,
  HqMileageSettlementListViewUrlFiltersEnum,
  HqMileageSettlementListViewUrlQueryParams,
} from "../../urls";

const SALES_STAT_FILTERS_KEY = "hqMileageSettlementFilters";

const funcSettlementStatusValue = (value: string): BrandMonthlySettlementStatusEnum[] => {
  switch (value) {
    case HqMonthlySettlementTypeEnum.ALL:
      return null;
    // NOT CONFIRMED인 경우. 해당 쿼리 자체를 안날려야함. 여기에서는 일단 null로 넣고. params값으로 처리해아함
    case HqMonthlySettlementTypeEnum.NOT_CONFIRMED:
      return null;
    case HqMonthlySettlementTypeEnum.CONFIRMED:
      return [BrandMonthlySettlementStatusEnum.CONFIRMED];
    case HqMonthlySettlementTypeEnum.REVIEWING_BY_ADMIN:
      return [
        BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN,
        BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT,
      ];
    case HqMonthlySettlementTypeEnum.PAID:
      return [BrandMonthlySettlementStatusEnum.PAID];
  }
};

export function getFilterOpts(params: HqMileageSettlementListViewUrlFilters): HqMileageSettlementListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const lastMonth = moment().subtract(1, "months");

  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, lastMonth.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDate.gte, lastMonth.format(onlyDateFormat)),
      },
    },
    settlementStatus: {
      active: maybe(() => !utils.isEmpty(params.settlementStatus), false),
      value: maybe(() => findValueInEnum(params.settlementStatus, HqMonthlySettlementTypeEnum)),
    },
  };
}

export function getFilterVariables(
  params: HqMileageSettlementListViewUrlFilters
): HqMileageSettlementListFilterVariables {
  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
    settlementStatus: params.settlementStatus !== undefined ? funcSettlementStatusValue(params.settlementStatus) : null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<HqMileageSettlementFilterKeys>
): HqMileageSettlementListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqMileageSettlementFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        HqMileageSettlementListViewUrlFiltersEnum.statDateFrom,
        HqMileageSettlementListViewUrlFiltersEnum.statDateTo
      );
    case HqMileageSettlementFilterKeys.settlementStatus:
      return getSingleEnumValueQueryParam(
        filter,
        HqMileageSettlementListViewUrlFiltersEnum.settlementStatus,
        HqMonthlySettlementTypeEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqMileageSettlementListViewUrlFilters>(SALES_STAT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  HqMileageSettlementListViewUrlQueryParams,
  HqMileageSettlementListViewUrlFilters
>({
  ...HqMileageSettlementListViewUrlFiltersEnum,
});
