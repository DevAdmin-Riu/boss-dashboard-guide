export interface ExtendedOrderDetailsOrderLine extends OrderDetails_order_lines {
  // 배송 대기 = fasle / 배송 준비중 = true
  // 배송 대기 - 출고가 안된 상태
  // 배송 준비중 - 출고가 됐지만 송장 정보가 입력이 안된 상태
  isFulfilled?: boolean;
}

interface OrderDetailsPageProps extends UserPermissionProps {
  order: OrderDetails_order;
  isStaff: boolean;
  isHqStaff: boolean;
  refundedList: RefundedList_refundedOrderLines_edges_node[];
  couriers: CourierList_couriers_edges_node[];
  countries?: Array<{
    code: string;
    label: string;
  }>;
  onBack: () => void;
  onFulfillmentCancel: (id: string) => void;
  onFulfillmentUpdateTrackingForCourier: (id: string) => void;
  onFulfillmentUpdateTrackingForNonCourier: (id: string) => void;
  onFulfillmentUpdateTrackingForDs: (id: string) => void;
  onFulfillmentUpdateTrackingForCompleted: (id: string) => void;
  onPaymentRefund: () => void;
  onPaymentStatusChange: () => void;
  onShippingAddressEdit: () => void;
  onOrderCancel: () => void;
  onNoteAdd: (data: NoteFormData) => void;
  onProfileView: () => void;
  onShowingAllRefundQs: () => void;
  onRefundAndExchangeCreate: () => void;
  onEstimatedArrivalDateUpdate: () => void;
  isB2bOrder: boolean;
}

export const OrderDetailsPage: React.FC<OrderDetailsPageProps> = (props) => {
  const {
    order,
    refundedList,
    couriers,
    onBack,
    onEstimatedArrivalDateUpdate,
    onFulfillmentCancel,
    onFulfillmentUpdateTrackingForCourier,
    onFulfillmentUpdateTrackingForNonCourier,
    onFulfillmentUpdateTrackingForDs,
    onFulfillmentUpdateTrackingForCompleted,
    onNoteAdd,
    onOrderCancel,
    onPaymentRefund,
    onPaymentStatusChange,
    onShippingAddressEdit,
    onProfileView,
    onShowingAllRefundQs,
    onRefundAndExchangeCreate,
    isStaff,
    isHqStaff,
    isB2bOrder,
  } = props;
  const [loading, setLoading] = useState<boolean>(false);
  const orderType = order?.type;
  const showStaffNoteMode = checkShowStaffNoteMode(orderType, isStaff);

  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByHqStaffForBrand = checkOrderedByHqStaffForBrand(orderType);
  const isOrderedByStaffForEtc = checkOrderedByStaffForEtc(orderType);
  const canCancel = maybe(() => order.status !== OrderStatus.CANCELED, false);
  const isUnfulfilled = order?.status === OrderStatus.UNFULFILLED;

  const { copiedOrderLines, fulfilledOrderLineQuantities } = processFulfillmentData(order);
  /**
   * @param isDeliveryPending 배송준비중 여부 (기본값: false - 배송 대기 상태)
   * @returns ExtendedOrderDetailsOrderLine[]
   * @description 집계된 데이터를 기반과 isDeliveryPending 값을 사용하여 "배송준비중", "배송대기" orderLines 생성
   */
  const getUnfulfilledOrderLinesCurring: (isDeliveryPending?: boolean) => ExtendedOrderDetailsOrderLine[] =
    getUnfulfilledOrderLines(copiedOrderLines, fulfilledOrderLineQuantities);

  const existFulfilledByVendorOrder = checkFbvOrderLineExist(order?.lines);
  const [orderFulfillmentsRefetch] = useDownloadOrderFulfillmentsLazyQuery();

  const isCancelImpossible = order?.lines.some((line) => line.quantityFulfilled !== 0 || line.quantityRefunded !== 0);

  const isPaidStatus =
    order?.paymentStatus === PaymentChargeStatusEnum.PARTIALLY_CHARGED ||
    order?.paymentStatus === PaymentChargeStatusEnum.FULLY_CHARGED ||
    order?.paymentStatus === PaymentChargeStatusEnum.PARTIALLY_REFUNDED ||
    order?.paymentStatus === PaymentChargeStatusEnum.FULLY_REFUNDED;

  const refundFulfillmentData = order?.fulfillments.map((item) => {
    const trackingNumber = item.trackingNumber;
    const fulfillmentComposedId = item.composedIdWithPrefix;
    const orderLine = item.lines[0].orderLine;
    const productName = orderLine.productName;
    const variant = orderLine.variant;
    const { trackInventory: isTrackInventoryOrder, isFulfilledByVendor, isMixedTrackInventory } = orderLine;
    const fulfillmentType = makeTagFulfillmentTypeText(
      isTrackInventoryOrder,
      isFulfilledByVendor,
      false,
      isMixedTrackInventory,
      variant.isVendorTrackInventory
    );

    // 세트 상품 표시 형식 처리
    let displayProductName = productName;
    let mainPvTag = "";
    if (orderLine?.bpBundle?.name) {
      const bundleName = orderLine.bpBundle.name;
      const matchingBundleInfo = orderLine.bpBundle.bpBundleInfos?.find(
        (info) => info?.pv?.id === orderLine.variant?.id
      );
      const componentName = matchingBundleInfo?.name || productName;
      displayProductName = `${bundleName} - ${componentName}`;
      if (orderLine.isMainPv === true) {
        mainPvTag = "[대표] ";
      }
    }

    return {
      label: `${fulfillmentType}${fulfillmentComposedId}(${mainPvTag}${displayProductName}) - ${trackingNumber}`,
      value: `${item.id}|||${trackingNumber}`,
      trackInventory: isTrackInventoryOrder,
    };
  });

  const sectionName = makeNameByOrderType(order?.type, sectionNames.orders, isHqStaff, false);

  const onRefundAndExchangeCreateFn = () => {
    // refundQA가 없는 경우 (가맹본부 주문 등) 바로 진행
    if (!order.refundQA || order.refundQA.length === 0) {
      onRefundAndExchangeCreate();
      return;
    }

    const refundCheck = order.refundQA.filter(
      (item) =>
        item.status !== RefundQAStatus.REFUND_SUCCESS &&
        item.status !== RefundQAStatus.REJECT &&
        item.status !== RefundQAStatus.STOCK_INCLUDED_APPROVED &&
        item.status !== RefundQAStatus.QUESTION_CLOSE
    );

    if (refundCheck.length > 0) {
      notification.error({
        message: "현재 진행중인 문의가 있어 교환/반품 신청을 진행할 수 없습니다.",
      });
      return;
    }

    onRefundAndExchangeCreate();
  };

  const isShowRefundQAForm =
    utils.isEmpty(order?.refundQA) === false && order?.refundQA[0]?.status === RefundQAStatus.ACCEPTED;

  const onDownloadOrderFulfillment = () => {
    setLoading(true);
    showDownloadingMessage();
    orderFulfillmentsRefetch({ variables: { id: order.id } })
      .then(downloadOrderFulfillment)
      .catch((e) => {
        showNotificationError("납품명세서 다운로드 과정에서 에러가 발생하였습니다");
        throw e;
      })
      .finally(() => {
        setLoading(false);
        destroyDownloadingMessage();
      });
  };

  const pageHeaderExtra = (
    <>
      {canCancel && (
        <Space direction="horizontal">
          {isB2bOrder === false && (
            <Button
              icon={<DownloadOutlined />}
              type="primary"
              shape="round"
              loading={loading}
              onClick={onDownloadOrderFulfillment}
            >
              납품명세서 다운로드
            </Button>
          )}
          {!order.isForCreditsRefill &&
            !isUnfulfilled &&
            !isOrderedByStaffForEtc &&
            (!isHqStaff || (isHqStaff && isOrderedByHqStaffForBrand)) && (
              <Button shape="round" onClick={onRefundAndExchangeCreateFn}>
                {isHqStaff ? "교환/반품 신청" : "관리자 교환/반품 신청"}
              </Button>
            )}
          {isUnfulfilled && !isCancelImpossible && (!isHqStaff || (isHqStaff && isOrderedByHqStaffForBrand)) && (
            <CardMenu menuItems={[{ label: "주문 취소", onSelect: onOrderCancel }]} />
          )}
        </Space>
      )}
    </>
  );

  return (
    <>
      <AppHeader onBack={onBack}>{sectionName}</AppHeader>
      <PageHeader
        extra={pageHeaderExtra}
        title={
          <Space direction="horizontal">
            <Typography.Title level={4}>{order?.composedIdWithPrefix}</Typography.Title>
            {order?.created && (
              <>
                <Typography.Text type="success">
                  (주문일: <DateTime date={order.created} />)
                </Typography.Text>
                <Tag color={getOrderTypeTagColor(order.type)}>
                  {convertOrderTypeToWord(order.type)}{" "}
                  {(isOrderedByStaffForBrand || isOrderedByHqStaffForBrand) &&
                    order.creatorUser &&
                    ` 접수 담당자:${order.creatorUser.firstName}(${order.creatorUser.loginId})`}
                </Tag>
              </>
            )}
            {existFulfilledByVendorOrder && (
              <Tag color={FulfillmentTypeColor.isFBV}>{transformIsFBV(true)} 상품 포함</Tag>
            )}
          </Space>
        }
      />

      <Grid>
        <Space direction="vertical" size="large">
          {!isOrderedByStaffForEtc && !isB2bOrder && (
            <OrderPayment
              order={order}
              refundedList={refundedList}
              onRefund={onPaymentRefund}
              onPaymentStatusChange={onPaymentStatusChange}
              isHqStaff={isHqStaff}
            />
          )}
          {isB2bOrder === false && isOrderedByStaffForEtc === false && isPaidStatus && (
            <OrderTax taxInvoices={order.taxInvoices} isHqStaff={isHqStaff} />
          )}

          {order && (
            <OrderDetailFulfillmentListWrap
              order={order}
              unfulfilledOrderLines={getUnfulfilledOrderLinesCurring(false)}
              deliveryPendingOrderLines={getUnfulfilledOrderLinesCurring(true)}
              onEstimatedArrivalDateUpdate={onEstimatedArrivalDateUpdate}
              onFulfillmentCancel={onFulfillmentCancel}
              onFulfillmentUpdateTrackingForCourier={onFulfillmentUpdateTrackingForCourier}
              onFulfillmentUpdateTrackingForNonCourier={onFulfillmentUpdateTrackingForNonCourier}
              onFulfillmentUpdateTrackingForDs={onFulfillmentUpdateTrackingForDs}
              onFulfillmentUpdateTrackingForCompleted={onFulfillmentUpdateTrackingForCompleted}
              isHqStaff={isHqStaff}
              couriers={couriers}
              isB2bOrder={isB2bOrder}
            />
          )}
        </Space>
        <Space direction="vertical" size="large">
          <OrderBrandStore
            canEditAddresses={canCancel}
            order={order}
            onShippingAddressEdit={onShippingAddressEdit}
            onProfileView={onProfileView}
            isHqStaff={isHqStaff}
          />
          {order?.refundQA?.length > 0 && (
            <OrderRefundQuestion
              orderId={order.id}
              refundQuestions={maybe(() => order.refundQA)}
              lines={maybe(() => order?.lines)}
              onShowingAllRefundQs={onShowingAllRefundQs}
              refundFulfillmentData={refundFulfillmentData}
              isShowRefundQuestionForm={isShowRefundQAForm}
            />
          )}
          {showStaffNoteMode && <OrderStaffNote note={maybe(() => order.staffNote)} />}
          <OrderCustomerNote note={maybe(() => order.customerNote)} />
          {isOrderedByStaffForBrand && isHqStaff === false && (
            <OrderAltInvoiceeBizInfo
              altInvoiceeBizInfo={order?.altInvoiceeBizInfo}
              taxInvoiceRequestFlag={order?.taxInvoiceRequestFlag}
            />
          )}
          {isOrderedByStaffForEtc && <EtcOrderDecreaseStockList order={order} />}
          {!isHqStaff && (
            <OrderHistory history={maybe(() => order.events)} orderType={orderType} onNoteAdd={onNoteAdd} />
          )}
        </Space>
      </Grid>
    </>
  );
};
</file>

