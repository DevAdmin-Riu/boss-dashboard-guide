  const [selectedEventType, setSelectedEventType] = React.useState<BrandVacsFeeEventTypeEnum>(null);

  const { id: brandId, remainVacsFeeExcludeVat } = brand;
  const { data, loading } = useBrandVacsFeeEventListQuery({ variables: { first: 5, filter: { brand: brandId } } });
  const brandVacsFeeEventList = maybe(() => data.brandVacsFeeEvents.edges.map((edge) => edge.node), []);
  const columns = getBrandVacsFeeEventTableColumns({ onRowClick: null }, false);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const cardTitle = (
    <CardTitleAntd
      title={sectionNames.brandVacsFeeEvents + "(최근 5건)"}
      extra={
        <Space size="small" align="center">
          <Button
            shape="circle"
            type="text"
            disabled={remainVacsFeeExcludeVat <= 0 || brandVacsFeeEventList.length === 0}
            onClick={() => setSelectedEventType(BrandVacsFeeEventTypeEnum.DECREASE)}
          >
            <MinusCircleOutlined {...getIconProps({ size: 22 })} />
          </Button>
          <Tooltip title="충전금 수수료는 관리자가 수동으로 직접 추가할 수 없습니다.">
            <Button disabled shape="circle" type="text">
              <PlusCircleOutlined {...getIconProps({ size: 22 })} />
            </Button>
          </Tooltip>
          <Typography.Link strong onClick={() => navigate(brandVacsFeeEventListViewUrl({ brandSearch: brand?.code }))}>
            모든 내역 보기
          </Typography.Link>
        </Space>
      }
    />
  );

  return (
    <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
      <Table
        {...commonTableProps}
        loading={loading}
        columns={columns}
        dataSource={brandVacsFeeEventList}
        scroll={{ x: tableWidthSum }}
      />
      <BrandVacsFeeEventCreateModal
        open={utils.isEmpty(selectedEventType) === false}
        loading={loading}
        brand={brand}
        eventType={selectedEventType}
        onClose={() => setSelectedEventType(null)}
      />
    </Card>
  );
};
</file>

<file path="src/app/views/brand/brands/components/ImageUpload.tsx">
import { buttonText } from "@assets/messages/buttonText";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import ImageTile from "@src/app/components/ImageTile";
import ImageUpload from "@src/app/components/ImageUpload";
import RequiredTypography from "@src/app/components/RequiredTypography";
import Skeleton from "@src/app/components/Skeleton";
import { Button, Card } from "antd";
import React from "react";

export interface UploadImageProps<T> {
  title: string;
  required?: boolean;
  image: T;
  onImageDelete: () => void;
  onImageUpload: (file: File) => void;
}

export const UploadImage = <T extends { alt?: string; url: string }>(props: UploadImageProps<T>) => {
  const { title, required, image, onImageDelete, onImageUpload } = props;
  const anchor = React.useRef<HTMLInputElement>();

  const handleImageUploadButtonClick = () => anchor.current.click();

  return (
    <Card
      title={
        <CardTitleAntd
          title={<RequiredTypography text={title} isRequired={required} />}
          extra={
            <>
              <Button type="primary" onClick={handleImageUploadButtonClick}>
                {buttonText.uploadImage}
              </Button>
              <input
                id="fileUpload"
                style={{ display: "none" }}
                onChange={(event) => onImageUpload(event.target.files[0])}
                type="file"
                ref={anchor}
                accept="image/*"
              />
            </>
          }
        />
      }
    >
      {image === undefined ? (
        <Skeleton />
      ) : image === null ? (
        <ImageUpload onImageUpload={(files) => onImageUpload(files[0])} />
      ) : (
        <ImageTile image={image} onImageDelete={onImageDelete} />
      )}
    </Card>
  );
};
export default UploadImage;
