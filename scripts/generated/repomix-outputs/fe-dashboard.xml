<file path="src/app/views/order/shipping/views/VendorHqShippingDaySettingView/VendorHqShippingDaySettingView.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useUser from "@hooks/useUser";
import { BrandServiceTypeEnum, BrandStoreRoleEnum, OrderDirection, UserSortField } from "@src/api/types/globalTypes";
import { useVendorListQuery } from "@src/app/views/purchase/vendors/api/queries";
import { ListViews } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { useForm } from "antd/lib/form/Form";
import _ from "lodash";
import React, { useEffect } from "react";

import {
  useFbvDeliveryConditionBulkUpdateOrCreateMutation,
  useFbvDeliveryConditionSetBaseUserMutation,
} from "../../api/mutations";
import { fbvCustomerListQuery, useFbvCustomerListLazy } from "../../api/queries";
import { FbvCustomerList_fbvCustomers_edges_node } from "../../api/types/FbvCustomerList";
import VendorHqShippingDaySettingPage from "../../components/VendorHqShippingDaySettingPage/VendorHqShippingDaySettingPage";
import {
  vendorHqShippingDaySettingViewUrl,
  VendorHqShippingDaySettingViewUrlDialog,
  VendorHqShippingDaySettingViewUrlQueryParams,
} from "../../urls";
import { areFiltersApplied, getFilterOpts, getFilterQueryParam, getFilterTabs, getFilterVariables } from "./filter";

interface VendorHqShippingDaySettingViewProps {
  params: VendorHqShippingDaySettingViewUrlQueryParams;
}

const VendorHqShippingDaySettingView: React.FC<VendorHqShippingDaySettingViewProps> = (props) => {
  const { user } = useUser();
  const { isStaff } = user;
  const [vendorHqShippingDaySettingBarForm] = useForm();
  const [vendorHqListShippingDaySettingTableForm] = useForm();
  const { params } = props;
  const [vendorId, setVendorId] = React.useState<string | null>(null);
  const [vendorCode, setVendorCode] = React.useState<string | null>(null);
  const [hqList, setHqList] = React.useState<FbvCustomerList_fbvCustomers_edges_node[]>([]);
  const [isVendorChanging, setIsVendorChanging] = React.useState(false);

  const { navigate, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.VENDOR_HQ_SHIPPING_DAY_SETTING_VIEW,
  });

  const targetUrl = vendorHqShippingDaySettingViewUrl;

  const overWriteFilter = {
    brand: user?.brand?.id,
  };
  const queryVariables = React.useMemo(() => {
    const variable = {
      first: GrapheneRelayConnectionMaxLimitEnum.vendorHqShippingDaySettingVendor,
      filter: {
        ...getFilterVariables(params),
      },
    };

    if (isStaff === true) {
      return variable;
    } else if (isStaff === false) {
      return {
        ...variable,
        filter: {
          ...variable.filter,
          ...overWriteFilter,
        },
      };
    }
  }, [params, settings?.rowNumber]);

  const [fetchCustomerList, { loading: customerListLoading, data: customerListData }] = useFbvCustomerListLazy({});

  useEffect(() => {
    if (customerListData) {
      const filteredData = filterCustomerData(customerListData);
      setHqList(filteredData);
    }
  }, [customerListData]);

  useEffect(() => {
    // 협력사 변경 중일 때는 자동 조회하지 않음
    if (vendorId && !isVendorChanging) {
      newRefetch();
    }
  }, [params.userSearch, params.brandSearch]);

  // 협력사 변경 플래그 리셋
  useEffect(() => {
    if (isVendorChanging) {
      setIsVendorChanging(false);
    }
  }, [vendorId]);

  const { loading: vendorListLoading, data: vendorListData } = useVendorListQuery({
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.vendorHqShippingDaySettingVendor,
      filter: {
        fbvBrand: isStaff === false ? user?.brand?.id : null,
        isActive: true,
        useFbvProduct: true,
      },
    },
  });

  const [fbvDeliveryConditionBulkUpdateOrCreate, fbvDeliveryConditionBulkUpdateOrCreateOpts] =
    useFbvDeliveryConditionBulkUpdateOrCreateMutation({
      onCompleted: (data) => {
        if (data.fbvDeliveryConditionBulkUpdateOrCreate.errors.length > 0) {
          showNotificationError("일괄 설정 중 오류가 발생했습니다.");
          return;
        }
        showNotificationSuccess("일괄 설정이 완료되었습니다.");
      },
    });

  const [setBaseUser, setBaseUserOpts] = useFbvDeliveryConditionSetBaseUserMutation({
    onCompleted: (data) => {
      if (data?.fbvDeliveryConditionSetBaseUser?.errors?.length === 0) {
        showNotificationSuccess("기준 매장이 변경되었습니다.");
        newRefetch();
      } else {
        showGqlErrors(data?.fbvDeliveryConditionSetBaseUser?.errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [fbvCustomerListQuery],
  });

  const handleSetDefaultVariant = async (record: FbvCustomerList_fbvCustomers_edges_node) => {
    const userId = record?.id;

    if (!userId || !vendorId) {
      showNotificationError("필수 정보가 누락되었습니다.");
      return;
    }

    try {
      await setBaseUser({
        variables: { vendorId, userId },
      });
    } catch (error) {
      console.error("Set base user error:", error);
      showNotificationError("기준 매장 변경 중 오류가 발생했습니다.");
    }
  };

  const filterOpts = getFilterOpts(params);

  const initialFormHqList = (hqList: FbvCustomerList_fbvCustomers_edges_node[]) => {
    if (!hqList || hqList.length === 0) {
      return;
    }

    const formSetValue = (id, value) => {
      vendorHqListShippingDaySettingTableForm.setFieldValue(id, value);
    };

    for (let hqListIndex = 0; hqList.length > hqListIndex; hqListIndex++) {
      const nowHqList = hqList[hqListIndex];
      const deliveryCondition = nowHqList.fbvDeliveryConditions?.[0];

      const formKey = {
        mon: `${nowHqList.id}-mon`,
        tue: `${nowHqList.id}-tue`,
        wed: `${nowHqList.id}-wed`,
        thu: `${nowHqList.id}-thu`,
        fri: `${nowHqList.id}-fri`,
        sat: `${nowHqList.id}-sat`,
        sun: `${nowHqList.id}-sun`,
        disallowDeliveryDate: `${nowHqList.id}-disallowDeliveryDate`,
        minimumOrderPrice: `${nowHqList.id}-minimumOrderPrice`,
      };

      if (deliveryCondition) {
        const possibleDeliveryDays = deliveryCondition.possibleDeliveryDays;

        formSetValue(`${formKey.mon}`, possibleDeliveryDays.monday);
        formSetValue(`${formKey.tue}`, possibleDeliveryDays.tuesday);
        formSetValue(`${formKey.wed}`, possibleDeliveryDays.wednesday);
        formSetValue(`${formKey.thu}`, possibleDeliveryDays.thursday);
        formSetValue(`${formKey.fri}`, possibleDeliveryDays.friday);
        formSetValue(`${formKey.sat}`, possibleDeliveryDays.saturday);
        formSetValue(`${formKey.sun}`, possibleDeliveryDays.sunday);
        formSetValue(`${formKey.disallowDeliveryDate}`, deliveryCondition.disallowDeliveryDate);
        formSetValue(`${formKey.minimumOrderPrice}`, deliveryCondition.minimumOrderPrice);
      } else {
        formSetValue(`${formKey.mon}`, false);
        formSetValue(`${formKey.tue}`, false);
        formSetValue(`${formKey.wed}`, false);
        formSetValue(`${formKey.thu}`, false);
        formSetValue(`${formKey.fri}`, false);
        formSetValue(`${formKey.sat}`, false);
        formSetValue(`${formKey.sun}`, false);
        formSetValue(`${formKey.disallowDeliveryDate}`, false);
        formSetValue(`${formKey.minimumOrderPrice}`, null);
      }
    }
  };

  const filterCustomerData = (data) => {
    if (!data?.fbvCustomers?.edges) {
      return [];
    }

    const filteredData = data.fbvCustomers.edges
      .map((item) => item.node)
      .filter((item) => {
        const userSearch = queryVariables.filter.userSearch;
        const brandSearch = queryVariables.filter.brandSearch;

        if (utils.isEmpty(userSearch) && utils.isEmpty(brandSearch)) {
          return true;
        }

        const isUserMatch = utils.isEmpty(userSearch)
          ? true
          : item.loginId.includes(userSearch) || item.firstName.includes(userSearch);

        const isBrandMatch = utils.isEmpty(brandSearch)
          ? true
          : item.brand.code.includes(brandSearch) || item.brand.name.includes(brandSearch);

        return isUserMatch && isBrandMatch;
      });

    // firstName으로 추가 정렬
    return _.sortBy(filteredData, ["firstName"]);
  };

  const validateQueryClick = () => {
    if (vendorId === null) {
      showNotificationWarn("좌측에 협력사를 선택해주세요.");
      return false;
    }
    return true;
  };

  const newRefetch = () => {
    if (!vendorId) {
      showNotificationError("협력사를 선택 후 조회 버튼을 눌러주세요.");
      return;
    }

    // Lazy query 실행
    fetchCustomerList({
      variables: {
        vendorId,
        first: GrapheneRelayConnectionMaxLimitEnum.vendorHqShippingDaySettingVendor,
        filter: {
          ...getFilterVariables(params),
          brand: isStaff === false ? user?.brand?.id : null,
          excludeStaff: true,
          isActive: true,
          enabledServices: [BrandServiceTypeEnum.FBV],
          brandStoreRole: [BrandStoreRoleEnum.OWNER],
        },
        sortBy: {
          direction: OrderDirection.ASC,
          field: UserSortField.BRAND,
        },
      },
    });
  };

  useEffect(() => {
    vendorHqListShippingDaySettingTableForm.resetFields();
    initialFormHqList(hqList);
  }, [hqList]);

  const { currentTab, handleTabChange, changeFilters, resetFilters } = utils.initListViewFilterTabs<
    VendorHqShippingDaySettingViewUrlDialog,
    VendorHqShippingDaySettingViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    getFilterQueryParam,
    refetch: newRefetch,
  });

  return (
    <>
      <VendorHqShippingDaySettingPage
        vendorId={vendorId}
        setVendorId={setVendorId}
        vendorCode={vendorCode}
        setVendorCode={setVendorCode}
        filterOpts={filterOpts}
        disabled={vendorListLoading || customerListLoading || setBaseUserOpts.loading}
        onFilterChange={changeFilters}
        currentTab={currentTab}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        // eslint-disable-next-line @typescript-eslint/no-empty-function
        onTabSave={() => {}}
        // eslint-disable-next-line @typescript-eslint/no-empty-function
        onTabDelete={() => {}}
        isStaff={isStaff}
        validateQueryClick={validateQueryClick}
        vendorList={vendorListData?.vendors.edges.map((item) => item.node)}
        fbvDeliveryConditionBulkUpdateOrCreate={fbvDeliveryConditionBulkUpdateOrCreate}
        fbvDeliveryConditionBulkUpdateOrCreateOpts={fbvDeliveryConditionBulkUpdateOrCreateOpts}
        hqList={hqList}
        vendorHqShippingDaySettingBarForm={vendorHqShippingDaySettingBarForm}
        vendorHqListShippingDaySettingTableForm={vendorHqListShippingDaySettingTableForm}
        initialFormHqList={initialFormHqList}
        setHqList={setHqList}
        setIsVendorChanging={setIsVendorChanging}
        onSetDefaultVariant={handleSetDefaultVariant}
      />
    </>
  );
};

export default VendorHqShippingDaySettingView;
</file>

