<file path="src/global/core/utils/chart.ts">
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";

export enum statsDateType {
  DAILY = "DAILY",
  WEEKLY = "WEEKLY",
  MONTHLY = "MONTHLY",
}

export enum statsValueType {
  TOTAL_PRICE = "TOTAL_PRICE",
  COUNT = "COUNT",
  MILEAGE = "MILEAGE",
  QUANTITY = "QUANTITY",
  BRAND_COST_PRICE_ONLY_FBV = "BRAND_COST_PRICE_ONLY_FBV",
}

const getChartMaxLimit = (maxValue: number, valueType: statsValueType) => {
  const adjustMaxValue = Math.max(
    maxValue,
    valueType === statsValueType.TOTAL_PRICE ? 1000000 : valueType === statsValueType.MILEAGE ? 100000 : 50
  );

  const rangeCheckAry = [
    50, // 오십
    500, // 오백
    1000, // 천
    10000, // 만
    100000, // 십만
    1000000, // 백만
    5000000, // 5백만
    10000000, // 천만
    50000000, // 5천만
    100000000, // 일억
    1000000000, // 십억
  ];

  let maxLimit = rangeCheckAry[0];
  const length = rangeCheckAry.length;

  for (let i = length - 2; i >= 0; i--) {
    if (adjustMaxValue > rangeCheckAry[i]) {
      maxLimit = rangeCheckAry[i + 1];
      break;
    }
  }
  return maxLimit;
};

const getChartMinLimit = (minValue: number, valueType: statsValueType) => {
  if (minValue >= 0) {
    return 0;
  }

  if (valueType === statsValueType.COUNT) {
    return 0;
  }

  const adjustMinValue = Math.min(minValue, valueType === statsValueType.TOTAL_PRICE ? -10000 : -1000);

  const rangeCheckAry = [
    -50, // 오십
    -500, // 오백
    -1000, // 천
    -10000, // 만
    -100000, // 십만
    -1000000, // 백만
    -5000000, // 5백만
    -10000000, // 천만
    -50000000, // 5천만
    -100000000, // 일억
    -1000000000, // 십억
  ];

  let minLimit = rangeCheckAry[0];
  const length = rangeCheckAry.length;

  for (let i = length - 2; i >= 0; i--) {
    if (adjustMinValue < rangeCheckAry[i]) {
      minLimit = rangeCheckAry[i + 1];
      break;
    }
  }
  return minLimit;
};

export const getChartTickConfig = (parsedOrderStats: BrandOrderStats_brandOrderStats[], valueType: statsValueType) => {
  const maxValue =
    parsedOrderStats.length <= 0
      ? 0
      : valueType === statsValueType.TOTAL_PRICE
      ? parsedOrderStats
          .map((stats) => stats.statTotalPriceExcludeVat)
          .reduce((acc, curr) => (acc < curr ? curr : acc), 0)
      : valueType === statsValueType.MILEAGE
      ? parsedOrderStats.map((stats) => stats.statMileageExcludeVat).reduce((acc, curr) => (acc < curr ? curr : acc), 0)
      : valueType === statsValueType.BRAND_COST_PRICE_ONLY_FBV
      ? parsedOrderStats
          .map((stats) => stats.statBrandCostPriceExcludeVatOnlyFbv)
          .reduce((acc, curr) => (acc < curr ? curr : acc), 0)
      : parsedOrderStats.map((stats) => stats.statOrderCount).reduce((acc, curr) => (acc < curr ? curr : acc), 0);
  let maxLimit = getChartMaxLimit(maxValue, valueType);

  const minValue =
    parsedOrderStats.length <= 0
      ? 0
      : valueType === statsValueType.TOTAL_PRICE
      ? parsedOrderStats
          .map((stats) => stats.statTotalPriceExcludeVat)
          .reduce((acc, curr) => (acc > curr ? curr : acc), 0)
      : valueType === statsValueType.MILEAGE
      ? parsedOrderStats.map((stats) => stats.statMileageExcludeVat).reduce((acc, curr) => (acc > curr ? curr : acc), 0)
      : valueType === statsValueType.BRAND_COST_PRICE_ONLY_FBV
      ? parsedOrderStats
          .map((stats) => stats.statBrandCostPriceExcludeVatOnlyFbv)
          .reduce((acc, curr) => (acc > curr ? curr : acc), 0)
      : parsedOrderStats.map((stats) => stats.statOrderCount).reduce((acc, curr) => (acc > curr ? curr : acc), 0);
  const minLimit = getChartMinLimit(minValue, valueType);

  // tickCount 는 y = 0 인 것을 포함해서 카운트
  let tickCount = 6;

  const interval = (maxLimit - minLimit) / (tickCount - 1);
  while (maxValue > maxLimit) {
    maxLimit += interval;
    tickCount++;
  }

  return [minLimit, maxLimit, tickCount];
};

// 이 모듈은 차트의 tick 숫자와 같이 일정 범위로만 사용되는 제한이 있는 곳에서만 사용 가능함
export const makeChartTickFormat = (v) => {
  if (v === undefined) {
    return "-";
  }

  try {
    const nValue = Number(v);
    // 다루는 수치가 조단위로는 넘어가지 않으므로 억,만 혼합만 고려함
    {
      const checkValue = 100000000;
      if (nValue >= checkValue) {
        return `${(nValue / checkValue).toLocaleString()}억`;
      }
    }
    {
      const checkValue = 10000;
      if (nValue >= checkValue) {
        return `${(nValue / checkValue).toLocaleString()}만`;
      }
    }
    return `${nValue.toLocaleString()}`;
  } catch (e) {
    return "-";
  }
};
</file>

