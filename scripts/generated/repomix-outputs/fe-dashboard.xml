import { getCurrentDeviceMobileAppVersion } from "@src/app/components/MobileAppUpdateModal/utils";
import { notification } from "antd";

import { utils } from "./utils";

// NOTE: mobile-dashboard의 types.ts에서 관리되는 WebViewToWebMsgType과 동기화 되어야 함.
// 웹뷰에서 웹으로 보내는 메시지 타입
export type WebViewToWebMsgType =
  | "NAVIGATE"
  | "SET_DRAWER_OPEN"
  | "MOBILE_DEVICE_INFO"
  | "APP_STATUS"
  | "PUSH_NOTIFICATION_ENABLED"
  | "PUSH_NOTIFICATION_DATA"
  | "BARCODE_SCANNED";

// 웹에서 웹뷰로 보내는 메시지 타입
type WebToWebViewMsgType =
  | "WEB_RENDERED"
  | "NAVIGATE"
  | "SET_DRAWER_OPEN"
  | "REQ_MOBILE_DEVICE_INFO"
  | "REQ_PUSH_NOTIFICATION_ENABLED"
  | "APP_SETTINGS_OPEN"
  | "EXCEL_DOWNLOAD"
  | "FILE_DOWNLOAD_BY_LINK"
  | "BARCODE_ERROR";

export const sendMessageToWebView = (type: WebToWebViewMsgType, value: any) => {
  if (utils.checkWebView()) {
    window.ReactNativeWebView.postMessage(JSON.stringify({ type, value }));
  }
};

export const validateIsSufficientAppVersion = (requiredVersion: string): boolean => {
  const currentVersion = getCurrentDeviceMobileAppVersion();
  const updateRequired = utils.compareVersions(currentVersion, requiredVersion, false);
  if (updateRequired) {
    notification.open({
      type: "info",
      message: "업데이트 필요",
      description: `이 기능은 ${requiredVersion} 버전부터 지원됩니다. 기능을 사용하려면 앱을 최신 버전으로 업데이트 해주세요.`,
    });
    return false;
  }

  return true;
};
