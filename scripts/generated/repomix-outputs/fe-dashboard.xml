  const warehouseAddressFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderDeliveryFilterKeys.warehouseAddress,
      "물류센터",
      opts.warehouseAddress.value,
      true,
      warehouseAddresses?.map((addr) => ({ label: addr.companyName, value: addr.id })) || []
