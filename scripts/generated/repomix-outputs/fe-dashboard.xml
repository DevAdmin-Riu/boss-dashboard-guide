import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { OrderChargeStatusFilter, OrderDeliveryStatusFilter } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { getDisplayUserName, maybe } from "@utils/misc";
import React from "react";

import { orderListViewUrlA } from "../../order/orders/urls";
import { productVariantUpdateViewUrl } from "../../product/products/urls";
import { stockListViewUrl } from "../../product/stock/urls";
import { useHomePageQuery } from "../api/queries";
import HomePage from "../components/HomePage";

export const HomeView = () => {
  const navigate = useNavigator();
  const { user } = useUser();

  const { data } = useHomePageQuery({});

  if (data === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} />;
  }

  return (
    <HomePage
      orders={maybe(() => data.ordersToday.totalCount)}
      sales={maybe(() => data.salesToday.gross)}
      topProducts={maybe(() => data.productTopToday.edges.map((edge) => edge.node))}
      onProductClick={(productId, variantId) => navigate(productVariantUpdateViewUrl(productId, variantId))}
      onOrdersToCaptureClick={() =>
        navigate(
          orderListViewUrlA({
            chargeStatus: [OrderChargeStatusFilter.PENDING],
          })
        )
      }
      onOrdersToFulfillClick={() =>
        navigate(
          orderListViewUrlA({
            deliveryStatus: [OrderDeliveryStatusFilter.STANDBY_DELIVERY],
          })
        )
      }
      navigateStockList={(params) => navigate(stockListViewUrl({ type: "type-a" }))}
      ordersToCapture={maybe(() => data.ordersToCapture.totalCount)}
      ordersToFulfill={maybe(() => data.ordersToFulfill.totalCount)}
      productVariantsOutOfRop={maybe(() => data.productVariantsOutOfRop.totalCount)}
      productVariantsOutOfSafetyStock={maybe(() => data.productVariantsOutOfSafetyStock.totalCount)}
      productVariantsOutOfStock={maybe(() => data.productVariantsOutOfStock.totalCount)}
      userName={getDisplayUserName(user)}
      userPermissions={user?.userPermissions || []}
    />
  );
};
</file>

