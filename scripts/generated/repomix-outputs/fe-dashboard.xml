    ),
    active: opts.vendorSearch.active,
    placeholder: "검색(사업자등록번호는 '-' 포함해서 xxx-xx-xxxxxx 형식으로 입력해 주세요)",
    smColSpan: 16,
  };

  const brandSearchFilter = {
