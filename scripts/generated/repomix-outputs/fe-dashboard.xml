import { formRuleMsg } from "@assets/messages/commonMsg";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { b2bSalesCountQuery } from "@src/app/views/b2b/api/queries";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Typography } from "antd";
import moment from "moment";
import React, { useEffect } from "react";

import { useSalesB2bBulkReqRevisionMutation } from "../../api/mutations";
import { salesListForB2bQuery } from "../../api/queries";
import { SalesB2bBulkReqRevisionVariables } from "../../api/types/SalesB2bBulkReqRevision";

interface HqB2bSettlementBulkReqRevisionModalProps {
  open: boolean;
  loading: boolean;
  saleIds: string[];
  salesCloseDate: string | null;
  onCancel: (shouldReset: boolean) => void;
}

export const HqB2bSettlementBulkReqRevisionModal: React.FC<HqB2bSettlementBulkReqRevisionModalProps> = (props) => {
  const { open, loading, saleIds, salesCloseDate, onCancel } = props;
  const [form] = Form.useForm<SalesB2bBulkReqRevisionVariables>();

  const initialValues: SalesB2bBulkReqRevisionVariables = {
    ids: saleIds,
    salesCloseDate,
    b2bReqRevisionReason: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [salesB2bBulkReqRevision, salesB2bBulkReqRevisionOpts] = useSalesB2bBulkReqRevisionMutation({
    onCompleted: (data) => {
      const errors = data.salesB2bBulkReqRevision.errors;
      if (errors.length === 0) {
        showNotificationSuccess(`매출 내역 수정이 요청되었습니다.`);

        onCancel(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [salesListForB2bQuery, b2bSalesCountQuery],
  });

  // FIX: 문구 변경 필요
  const onSubmit = (formData: SalesB2bBulkReqRevisionVariables) => {
    if (saleIds.length === 0) {
      showNotificationWarn("발주 품목을 선택해주세요.");
      return;
    }
    if (utils.isEmpty(salesCloseDate)) {
      showNotificationError("정산월 필터 선택하여 조회 후 요청해주세요.");
      return;
    }

    const formattedSalesCloseDate = moment(salesCloseDate).endOf("month").format(onlyDateFormat);
    const { b2bReqRevisionReason } = formData;
    salesB2bBulkReqRevision({
      variables: { ids: saleIds, salesCloseDate: formattedSalesCloseDate, b2bReqRevisionReason },
    });
  };

  const modalLoading = loading || salesB2bBulkReqRevisionOpts.loading;

  return (
    <Modal
      closable={false}
      open={open}
      onCancel={() => onCancel(false)}
      onOk={form.submit}
      okText="요청"
      okButtonProps={{ danger: true, type: "primary", loading: modalLoading }}
      title="수정 요청"
      maskClosable={false}
    >
      <Form form={form} initialValues={initialValues} onFinish={onSubmit}>
        <Typography.Title level={4} style={{ marginBottom: 4 }}>
          수정 요청 사유를 입력해주세요.
        </Typography.Title>
        <Form.Item
          name="b2bReqRevisionReason"
          rules={[{ required: true, type: "string", min: 5, message: formRuleMsg.min(5, "자") }]}
        >
          <Input.TextArea rows={4} placeholder="수정 요청 사유를 입력해주세요." />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

