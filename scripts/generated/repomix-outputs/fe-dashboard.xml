  fromBossNoticeList: FromBossNotices_fromBossNotices_edges_node[];
}

export const PopupCreateView: React.FC<PopupCreateViewProps> = ({ match, fromBossNoticeList }) => {
  const isHqPopup = match.path === hqPopupCreateViewPath;
  const navigate = useNavigator();

  const [createPopup, createPopupOpts] = useCreatePopupMutation({
    onCompleted: (data) => {
      const errors = data.createPopup.errors;
      if (errors.length === 0) {
        showNotificationSuccess("팝업 생성 성공");
        navigate(
          isHqPopup ? hqPopupDetailsViewUrl(data.createPopup.popup.id) : popupDetailsViewUrl(data.createPopup.popup.id)
        );
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleCreate = async (formData: PopupCreatePageFormData) => {
    const input = {
      name: formData.name,
      linkUrl: formData.linkUrl,
      start: formData.start,
      end: formData.end,
      visibleToBrand: formData.visibleToBrand,
      visibleToHqBrand: formData.visibleToHqBrand,
      isHqPopup,
      notice: formData.notice,
    };

    if (isHqPopup && formData.notice === null) {
      notification.error({ message: "가맹본부 팝업은 공지사항 선택이 필수입니다." });
      return;
    }

    const result = await createPopup({
      variables: {
        input,
      },
    });

    return result.data.createPopup?.popup?.id || null;
  };

  return (
    <>
      <WindowTitle title={"팝업 추가"} />
      <PopupCreatePage
        disabled={createPopupOpts.loading}
        errors={createPopupOpts.data?.createPopup.errors || []}
        saveButtonBar={createPopupOpts.status}
        onBack={() => navigate(isHqPopup ? hqPopupListViewUrl() : popupListViewUrl())}
        onSubmit={handleCreate}
        isHqPopup={isHqPopup}
        fromBossNoticeList={fromBossNoticeList}
      />
    </>
  );
};
</file>

<file path="src/app/views/notice/popups/views/PopupDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import { SearchCategoriesVariables } from "@src/api/searches/types/SearchCategories";
import { SearchFromBossNoticesVariables } from "@src/api/searches/types/SearchFromBossNotices";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import useFromBossNoticeSearch from "@src/api/searches/useFromBossNoticeSearch";
import { PopupInput } from "@src/api/types/globalTypes";
import ActionDialog from "@src/app/components/ActionDialog";
import AssignBrandDialog from "@src/app/components/AssignBrandDialog";
import MakeCategoryLinkModal from "@src/app/components/MakeCategoryLinkModal";
import MakeFromBossNoticeLinkModal from "@src/app/components/MakeFromBossNoticeLinkModal";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getMutationState, maybe } from "@utils/misc";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrorInfo, showGqlErrors } from "@utils/notification/wrapperGql";
import { notification } from "antd";
import React, { useState } from "react";

import { FromBossNotices_fromBossNotices_edges_node } from "../../notices/api/types/FromBossNotices";
import {
  useAssignBrandsToPopupMutation,
  useUnassignBrandsFromPopupMutation,
  useUpdatePopupMutation,
} from "../api/mutations";
import { usePopupDetailsQuery } from "../api/queries";
import { UpdatePopup } from "../api/types/UpdatePopup";
import PopupDetailsPage, { PopupDetailsPageFormData } from "../components/PopupDetailsPage";
import {
  hqPopupDetailsViewUrl,
  hqPopupListViewUrl,
  popupDetailsViewUrl,
  PopupDetailsViewUrlQueryParams,
  popupListViewUrl,
} from "../urls";

interface PopupDetailsViewProps {
  id: string;
  params: PopupDetailsViewUrlQueryParams;
  isHqPopup: boolean;
  fromBossNoticeList: FromBossNotices_fromBossNotices_edges_node[];
}

enum PopupDetailModalModeEnum {
  Assign = "Assign",
  Unassign = "Unassign",
  UnassignBulk = "UnassignBulk",
  RemovePcImage = "RemovePcImage",
  RemoveMobileImage = "RemoveMobileImage",
  MakeFromBossNoticeLink = "MakeFromBossNoticeLink",
  MakeCategoryLink = "MakeCategoryLink",
}

export const PopupDetailsView: React.FC<PopupDetailsViewProps> = ({ id, params, isHqPopup, fromBossNoticeList }) => {
  const navigate = useNavigator();

  const [brandNameForModal, setBrandNameForModal] = useState("");
  const [idsForModal, setIdsForModal] = useState([]);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setIdsForModal([]);
    setModalMode(null);
    setBrandNameForModal("");
  };
  const openModalWithoutNavigate = (
    madalMode: PopupDetailModalModeEnum,
    idsForModal?: string[],
    brandNameForModal?: string
  ) => {
    setModalMode(madalMode);
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
    if (brandNameForModal) {
      setBrandNameForModal(brandNameForModal);
    }
  };

  const maxRowNumber = GrapheneRelayConnectionMaxLimitEnum.brands;
  const maxRowNumberDefault = GrapheneRelayConnectionMaxLimitEnum.default;
  const brandSearchVariable: SearchBrandsVariables = { first: maxRowNumber };
  const defaultSearchVariable: SearchFromBossNoticesVariables | SearchCategoriesVariables = {
    first: maxRowNumberDefault,
  };

  const {
    search: searchBrand,
    loadMore: loadMoreBrand,
    result: resultBrand,
  } = useBrandSearch({ skip: modalMode !== PopupDetailModalModeEnum.Assign, variables: brandSearchVariable });

  const {
    search: searchFromBossNotices,
    loadMore: loadMoreFromBossNotices,
    result: resultFromBossNotices,
  } = useFromBossNoticeSearch({
    skip: modalMode !== PopupDetailModalModeEnum.MakeFromBossNoticeLink,
    variables: defaultSearchVariable,
  });

  const {
    search: searchCategory,
    loadMore: loadMoreCategory,
    result: resultCategory,
  } = useCategorySearch({
    skip: modalMode !== PopupDetailModalModeEnum.MakeCategoryLink,
    variables: defaultSearchVariable,
  });

  const { data, loading } = usePopupDetailsQuery({ variables: { id } });
  const popup = maybe(() => data.popup, null);

  const handlePopupUpdateSuccess = (data: UpdatePopup) => {
    const errors = data.updatePopup.errors;
    // data에 pcImage나 mobileImage 중 둘중 하나라도 비어있는 경우 showNOtificationError로 워닝 메시지 출력
    if (!data.updatePopup.popup?.pcImage || !data.updatePopup.popup?.mobileImage) {
      showNotificationWarn("팝업 이미지는 PC/모바일 둘다 입력되어 있어야 합니다.");
    }

    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(isHqPopup ? hqPopupDetailsViewUrl(id) : popupDetailsViewUrl(id), true);
    } else {
      if (errors.find((error) => error.field === ("pcImage" as keyof PopupInput))) {
        showGqlErrorInfo("PC 팝업 이미지 필드 오류로 팝업 이미지 업데이트에 실패했습니다.", "ImageError");
      } else if (errors.find((error) => error.field === ("mobileImage" as keyof PopupInput))) {
        showGqlErrorInfo("모바일 팝업 이미지 필드 오류로 팝업 이미지 업데이트에 실패했습니다.", "ImageError");
      } else {
        showGqlErrors(errors);
      }
    }
  };

  const [updatePopup, updatePopupOpts] = useUpdatePopupMutation({
    onCompleted: handlePopupUpdateSuccess,
  });

  const [assignBrand, assignBrandOpts] = useAssignBrandsToPopupMutation({
    onCompleted: (data) => {
      const errors = data.assignBrandsToPopup.errors;
      if (errors.length === 0) {
        showNotificationSuccess("게시 브랜드 리스트에 브랜드를 추가했습니다.");
        navigate(isHqPopup ? hqPopupDetailsViewUrl(id) : popupDetailsViewUrl(id), true);
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [unassignBrand, unassignBrandOpts] = useUnassignBrandsFromPopupMutation({
    onCompleted: (data) => {
      const errors = data.unassignBrandsFromPopup.errors;
      if (errors.length === 0) {
        showNotificationSuccess("게시 브랜드 리스트에서 브랜드를 제거했습니다.");
        resetForCloseModal();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleBack = () => navigate(isHqPopup ? hqPopupListViewUrl() : popupListViewUrl());

  const availableBrandIdList = popup?.availableBrands.map((e) => e.id) || [];

  const handleUpdate = async (formData: PopupDetailsPageFormData) => {
    const input: PopupInput = {
      name: formData.name,
      linkUrl: formData.linkUrl,
      description: formData.description,
      start: formData.start,
      end: formData.end,
      visibleToBrand: formData.visibleToBrand,
      visibleToHqBrand: formData.visibleToHqBrand,
      availableToAllBrands: formData.availableToAllBrands,
      notice: formData.notice,
    };

    if (isHqPopup && formData.notice === null) {
      notification.error({ message: "가맹본부 팝업은 공지사항 선택이 필수입니다." });
      return;
    }

    const updatePopupResult = await updatePopup({
      variables: {
        id,
        input,
      },
    });

    return updatePopupResult.data.updatePopup.errors;
  };

  const formTransitionState = getMutationState(
    updatePopupOpts.called,
    updatePopupOpts.loading,
    updatePopupOpts.data?.updatePopup.errors
  );

  return (
    <>
      <WindowTitle title={maybe(() => popup.name)} />
      {popup && (
        <PopupDetailsPage
          popup={popup}
          disabled={loading || updatePopupOpts.loading}
          errors={updatePopupOpts.data?.updatePopup.errors || []}
          onBack={handleBack}
          onOpenMakeFromBossNoticeLinkModal={() =>
            openModalWithoutNavigate(PopupDetailModalModeEnum.MakeFromBossNoticeLink)
          }
          onOpenMakeCategoryLinkModal={() => openModalWithoutNavigate(PopupDetailModalModeEnum.MakeCategoryLink)}
          onPcImageDelete={() => openModalWithoutNavigate(PopupDetailModalModeEnum.RemovePcImage)}
          onPcImageUpload={(file) => {
            updatePopup({
              variables: {
                id,
                input: {
                  name: popup.name,
                  start: popup.start,
                  visibleToBrand: popup.visibleToBrand,
                  visibleToHqBrand: popup.visibleToHqBrand,
                  pcImage: file,
                },
              },
            });
          }}
          onMobileImageDelete={() => openModalWithoutNavigate(PopupDetailModalModeEnum.RemoveMobileImage)}
          onMobileImageUpload={(file) => {
            updatePopup({
              variables: {
                id,
                input: {
                  name: popup.name,
                  start: popup.start,
                  visibleToBrand: popup.visibleToBrand,
                  visibleToHqBrand: popup.visibleToHqBrand,
                  mobileImage: file,
                },
              },
            });
          }}
          onSubmit={handleUpdate}
          onBrandAssign={() => openModalWithoutNavigate(PopupDetailModalModeEnum.Assign)}
          onBrandUnassign={(brandId, brandNameForModal) =>
            openModalWithoutNavigate(PopupDetailModalModeEnum.Unassign, [brandId], brandNameForModal)
          }
          onBrandUnassignBulk={(unassignList) =>
            openModalWithoutNavigate(PopupDetailModalModeEnum.UnassignBulk, unassignList)
          }
          saveButtonBarState={formTransitionState}
          isHqPopup={isHqPopup}
          fromBossNoticeList={fromBossNoticeList}
        />
      )}
      <AssignBrandDialog
        hasMore={resultBrand.data?.search?.pageInfo.hasNextPage}
        open={modalMode === PopupDetailModalModeEnum.Assign}
        onFetch={searchBrand}
        onFetchMore={loadMoreBrand}
        loading={resultBrand.loading || assignBrandOpts.loading}
        rowSelectionType={"checkbox"}
        onClose={resetForCloseModal}
        onSubmit={(brands) => {
          assignBrand({
            variables: {
              popupId: id,
              brands: brands.map((brand) => brand.id),
            },
          });
        }}
        brands={maybe(() =>
          resultBrand.data.search.edges
            .map((edge) => edge.node)
            .filter((suggestedBrand) => !availableBrandIdList.includes(suggestedBrand.id))
        )}
      />
      <MakeFromBossNoticeLinkModal
        hasMore={resultFromBossNotices.data?.search?.pageInfo.hasNextPage}
        open={modalMode === PopupDetailModalModeEnum.MakeFromBossNoticeLink}
        onFetch={searchFromBossNotices}
        onFetchMore={loadMoreFromBossNotices}
        loading={resultFromBossNotices.loading}
        onClose={resetForCloseModal}
        notices={maybe(() => resultFromBossNotices.data.search.edges.map((edge) => edge.node))}
      />
      <MakeCategoryLinkModal
        hasMore={resultCategory.data?.search?.pageInfo.hasNextPage}
        open={modalMode === PopupDetailModalModeEnum.MakeCategoryLink}
        onFetch={searchCategory}
        onFetchMore={loadMoreCategory}
        loading={resultCategory.loading}
        onClose={resetForCloseModal}
        categories={maybe(() => resultCategory.data.search.edges.map((edge) => edge.node))}
      />
      <ActionDialog
        confirmButtonState={unassignBrandOpts.status}
        onClose={resetForCloseModal}
        onConfirm={() => {
          unassignBrand({
            variables: {
              popupId: id,
              brands: idsForModal,
            },
          });
        }}
        open={modalMode === PopupDetailModalModeEnum.UnassignBulk}
        title="팝업 브랜드 연결 해제"
      >
        {`선택한 ${idsForModal?.length}개의 브랜드를 팝업 게시 브랜드에서 연결 해제하시겠습니까?`}
      </ActionDialog>
      <ActionDialog
        confirmButtonState={unassignBrandOpts.status}
        onClose={resetForCloseModal}
        onConfirm={() => {
          unassignBrand({
            variables: {
              popupId: id,
              brands: idsForModal,
            },
          });
        }}
        open={modalMode === PopupDetailModalModeEnum.Unassign}
        title="팝업 브랜드 연결 해제"
      >
        {`선택한 브랜드 ${brandNameForModal}을(를) 팝업 게시 브랜드에서 연결 해제하시겠습니까?`}
      </ActionDialog>
      <ActionDialog
        confirmButtonState={updatePopupOpts.status}
        onClose={resetForCloseModal}
        onConfirm={async () => {
          await updatePopup({
            variables: {
              id,
              input: {
                name: popup.name,
                start: popup.start,
                visibleToBrand: popup.visibleToBrand,
                visibleToHqBrand: popup.visibleToHqBrand,
                pcImage: null,
              },
            },
          });
          resetForCloseModal();
        }}
        open={modalMode === PopupDetailModalModeEnum.RemovePcImage}
        title={"PC 이미지 삭제"}
        variant="delete"
      >
        이 팝업의 PC 이미지를 삭제하시겠습니까?
      </ActionDialog>
      <ActionDialog
        confirmButtonState={updatePopupOpts.status}
        onClose={resetForCloseModal}
        onConfirm={async () => {
          await updatePopup({
            variables: {
              id,
              input: {
                name: popup.name,
                start: popup.start,
                visibleToBrand: popup.visibleToBrand,
                visibleToHqBrand: popup.visibleToHqBrand,
                mobileImage: null,
              },
            },
          });
          resetForCloseModal();
        }}
        open={modalMode === PopupDetailModalModeEnum.RemoveMobileImage}
        title={"모바일 이미지 삭제"}
        variant="delete"
      >
        이 팝업의 모바일 이미지를 삭제하시겠습니까?
      </ActionDialog>
    </>
  );
};
</file>

<file path="src/app/views/notice/popups/wrapper/withHqPopupWrapper.tsx">
import { NoticeFilterInput, NoticeSortField, NoticeSortingInput, OrderDirection } from "@src/api/types/globalTypes";
import React, { ComponentType } from "react";

import { useFromBossNoticeListQuery } from "../../notices/api/queries";
import { FromBossNoticesVariables } from "../../notices/api/types/FromBossNotices";

// 고차 컴포넌트를 정의합니다. 이 함수는 컴포넌트를 인자로 받고 새로운 컴포넌트를 반환합니다.
function withHqPopupWrapper<T>(WrappedComponent: ComponentType<T>): ComponentType<T> {
  return (props: T) => {
    const sortVariables: NoticeSortingInput = { direction: OrderDirection.DESC, field: NoticeSortField.CREATION_DATE };
    const filterVariables: NoticeFilterInput = { isHqNotice: true };
    const queryVariables: FromBossNoticesVariables = { first: 500, sort: sortVariables, filter: filterVariables };

    const { data, loading } = useFromBossNoticeListQuery({
      variables: queryVariables,
    });

    return (
      <WrappedComponent
        {...props}
        fromBossNoticeList={loading ? [] : data.fromBossNotices.edges.map((item) => item.node)}
        loading={loading}
      />
    );
  };
}

export default withHqPopupWrapper;
</file>

