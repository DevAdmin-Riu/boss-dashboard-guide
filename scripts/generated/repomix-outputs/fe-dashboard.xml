export function getPoEventTypeFromPoLineRouteParams(
  routeParams: PurchaseOrderLineListViewRouteParams
): PurchaseOrderEventTypeFilter[] {
  const { inventoryType } = routeParams;
  const isTrackInventory = inventoryType === "track-inventory";
  const isConsignment = inventoryType === "consignment";
  const isAllInventory = inventoryType === "all-inventory";

  return [
    (isAllInventory || isTrackInventory) && PurchaseOrderEventTypeFilter.INITIAL_ORDER,
    (isAllInventory || isTrackInventory) && PurchaseOrderEventTypeFilter.REORDER,
    (isAllInventory || isTrackInventory) && PurchaseOrderEventTypeFilter.TAKE_BACK,
    (isAllInventory || isConsignment) && PurchaseOrderEventTypeFilter.CONSIGNMENT,
    (isAllInventory || isConsignment) && PurchaseOrderEventTypeFilter.CONSIGNMENT_TAKE_BACK,
  ].filter(Boolean);
}

