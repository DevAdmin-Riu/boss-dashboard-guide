    },
  };
}

export function getSalesStatByProductListFilterVariables(
  params: SalesStatByProductListViewUrlFilters
): TExtendedSalesStatByProductListVariables {
  const selectedCategories: ProductCategoryKind[] = (params.categoryKind as ProductCategoryKind[]) || [];
  const { categoryKind, isFulfilledByVendor, isSubPv } = mapCategoryKindToQueryVariables(selectedCategories);

  return {
    statDate: getGteLteVariablesForMonth({
      gte: params.statDateFrom,
      lte: params.statDateTo,
    }),
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
