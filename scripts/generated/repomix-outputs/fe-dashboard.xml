  header: string;
  saveButtonBarState: ConfirmButtonTransitionState;
  warehouses: SearchWarehouses_search_edges_node[];
  onCategoryKindChange: (kind: CategoryKindEnum) => void;
  fetchCategories: (data: string) => void;
  fetchCollections: (data: string) => void;
  fetchProductTypes: (data: string) => void;
  fetchMakers: (query: string) => void;
  isStaff?: boolean;
  onBack?();
  onSubmit?(data: ProductCreateData);
}

enum ProductCreateModalModeEnum {
  LoadProductInfoNotificationTemplates = "LoadProductInfoNotificationTemplates",
}

export const ProductCreatePage: React.FC<ProductCreatePageProps> = ({
  params,
  disabled,
  categories: categoryChoiceList,
  collections: collectionChoiceList,
  productTypes: productTypeChoiceList,
  makers: makerChoiceList,
  errors,
  onCategoryKindChange,
  fetchCategories,
  fetchCollections,
  fetchProductTypes,
  fetchMakers,
  fetchMoreCategories,
  fetchMoreCollections,
  fetchMoreProductTypes,
  fetchMoreMakers,
  header,
  initial,
  saveButtonBarState,
  warehouses,
  onBack,
  onSubmit,
  isStaff,
}) => {
  // Display values
  const [selectedCategory, setSelectedCategory] = useStateFromProps(initial?.category || "");
  const [selectedCollections, setSelectedCollections] = useStateFromProps<string[]>(initial?.collections || []);
  const { isFulfilledByVendor, categoryKind } = params;
  const sectionName = isFulfilledByVendor ? sectionNames.productsB : sectionNames.productsA;
  const [modalMode, setModalMode] = useState<ProductCreateModalModeEnum>(null);
  const { allCountries } = useShop();
  const categories = getCategoryChoices(categoryChoiceList);
  const collections = getChoices(collectionChoiceList);
  const productTypes = useMemo(() => getChoices(productTypeChoiceList), [productTypeChoiceList]);
  const resetForCloseModal = () => {
    setModalMode(null);
  };

  return (
    <ProductCreateForm
      onSubmit={onSubmit}
      initial={initial}
      categories={categories}
      collections={collections}
      productTypes={productTypeChoiceList}
      selectedCollections={selectedCollections}
      setSelectedCategory={setSelectedCategory}
      setSelectedCollections={setSelectedCollections}
      warehouses={warehouses}
    >
      {({ change, data, handlers, hasChanged, submit, reset }) => (
        <>
          <AppHeader onBack={onBack}>{sectionName}</AppHeader>
          <PageHeader title={header} />
          <Space direction="vertical" size="large">
            {isFulfilledByVendor && isStaff && <FbvProductBrandList isCreateMode onChange={change} />}
            <ProductOrganization
              isCreateMode
              isFulfilledByVendor={isFulfilledByVendor}
              categoryKind={categoryKind}
              categories={categories}
              categoryInputDisplayValue={selectedCategory}
              collections={collections}
              data={data}
              disabled={disabled}
              errors={errors}
              onCategoryKindChange={onCategoryKindChange}
              fetchCategories={fetchCategories}
              fetchCollections={fetchCollections}
              fetchMoreCategories={fetchMoreCategories}
              fetchMoreCollections={fetchMoreCollections}
              fetchMoreProductTypes={fetchMoreProductTypes}
              fetchProductTypes={fetchProductTypes}
              productType={data.productType}
              productTypeInputDisplayValue={data.productType?.name || ""}
              productTypes={productTypes}
              onCategoryChange={handlers.selectCategory}
              onCollectionChange={handlers.selectCollection}
              onProductTypeChange={handlers.selectProductType}
              collectionsInputDisplayValue={selectedCollections}
              onChange={change}
              resetForm={reset}
            />
            <ProductDetailsForm
              data={data}
              disabled={disabled}
              isFulfilledByVendor={isFulfilledByVendor}
              errors={errors}
              onChange={change}
              categoryKind={categoryKind}
            />

            {data.attributes?.length > 0 && data.isForCreditsRefill === false && (
              <ProductAttributes
                isProductPage
                data={data}
                disabled={disabled}
                isFulfilledByVendor={isFulfilledByVendor}
                errors={errors}
                makers={makerChoiceList}
                fetchMakers={fetchMakers}
                fetchMoreMakers={fetchMoreMakers}
                onChange={change}
                onSingleAttrChange={handlers.selectAttribute}
                onMultiAttrChange={handlers.selectAttributeMultiple}
                allCountries={allCountries}
              />
            )}
            {data.isForCreditsRefill === false && data?.productType?.hasVariants === false && (
              <ProductDefaultVendor
                data={data}
                isFulfilledByVendor={isFulfilledByVendor}
                errors={errors}
                onChange={change}
                disabled={disabled}
                categoryKind={categoryKind}
              />
            )}
            {isFulfilledByVendor && <FbvBpvPrice data={data} onChange={change} disabled={disabled} />}
            <Row gutter={[12, 12]}>
              <Col span={12}>
                <ProductPoNote data={data} errors={errors} onChange={change} />
              </Col>
              <Col span={12}>
                <ProductNote data={data} errors={errors} onChange={change} />
              </Col>
            </Row>
            {data.isForCreditsRefill === false && data.isDevPv === false && categoryKind !== CategoryKindEnum.B2B && (
              <ProductInfoNoti
                data={data}
                onChange={handlers.changeProductInfoNoti}
                openTemplatesModal={() => setModalMode(ProductCreateModalModeEnum.LoadProductInfoNotificationTemplates)}
              />
            )}
          </Space>
          <ProductInfoNotificationTemplatesModal
            open={modalMode === ProductCreateModalModeEnum.LoadProductInfoNotificationTemplates}
            loading={disabled}
            onClose={resetForCloseModal}
            onChange={handlers.changeProductInfoNoti}
          />
          <SaveButtonBar
            onCancel={onBack}
            onSave={submit}
            state={saveButtonBarState}
            disabled={disabled || !onSubmit || !hasChanged}
          />
        </>
      )}
    </ProductCreateForm>
  );
};
