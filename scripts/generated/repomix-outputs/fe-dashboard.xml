import { DialogContentText } from "@material-ui/core";
import ActionDialog from "@src/app/components/ActionDialog";
import {
  reserveChangeDetailsViewUrl,
  ReserveChangeListViewUrlQueryParams,
} from "@src/app/views/product/reserveChange/urls";
import { ListViews } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Divider, Typography } from "antd";
import React, { useState } from "react";

import { useCancelReserveChangePriceBaseMutation } from "../api/mutations";
import { reserveChangePriceBaseListQuery, useReserveChangePriceBaseListQuery } from "../api/queries";
import { CancelReserveChangePriceBase } from "../api/types/CancelReserveChangePriceBase";
import { ReserveChangeAddModal } from "../components/ReserveChangeAddModal";
import { ReserveChangePriceBaseListPage } from "../components/ReserveChangePriceBaseListPage/ReserveChangePriceBaseListPage";

interface ReserveChangePriceBaseListViewProps {
  params: ReserveChangeListViewUrlQueryParams;
}

enum ReserveChangePriceBaseListModalModeEnum {
  AddChangeReservation = "AddChangeReservation",
  CancelChangePrice = "CancelChangePrice",
}

export const ReserveChangePriceBaseListView: React.FC<ReserveChangePriceBaseListViewProps> = ({ params }) => {
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.RESERVE_CHANGE_LIST,
  });

  const [idForModal, setIdForModal] = useState(null);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
    setIdForModal(null);
  };
  const openModalWithoutNavigate = (madalMode: ReserveChangePriceBaseListModalModeEnum, idForModal?: string) => {
    setModalMode(madalMode);
    if (idForModal) {
      setIdForModal(idForModal);
    }
  };
  const navigateReserveChangeDetails = (reserveChangeId: string) => {
    navigate(reserveChangeDetailsViewUrl(reserveChangeId));
  };

  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
    }),
    [params, settings?.rowNumber]
  );
  const { data, loading } = useReserveChangePriceBaseListQuery({
    variables: queryVariables,
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.reserveChangePriceBases?.pageInfo,
    paginationState,
    params,
  });

  const [cancelReserveChangePriceBase, cancelReserveChangePriceBaseOpts] = useCancelReserveChangePriceBaseMutation({
    onCompleted: (data: CancelReserveChangePriceBase) => {
      resetForCloseModal();
      const errors = data.cancelReserveChangePriceBase.errors;
      if (errors.length === 0) {
        showNotificationSuccess("가격 정보 변경 예약이 취소되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [reserveChangePriceBaseListQuery],
  });

  const onAddReservation = () => {
    openModalWithoutNavigate(ReserveChangePriceBaseListModalModeEnum.AddChangeReservation);
  };

  return (
    <>
      <ReserveChangePriceBaseListPage
        params={params}
        settings={settings}
        disabled={loading || cancelReserveChangePriceBaseOpts.loading}
        reserveChangePriceBases={maybe(() => data.reserveChangePriceBases.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onAdd={onAddReservation}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        navigateReserveChangeDetails={navigateReserveChangeDetails}
        cancelReserveChange={(reserveChangeId) =>
          openModalWithoutNavigate(ReserveChangePriceBaseListModalModeEnum.CancelChangePrice, reserveChangeId)
        }
      />
      <ReserveChangeAddModal
        open={modalMode === ReserveChangePriceBaseListModalModeEnum.AddChangeReservation}
        onClose={resetForCloseModal}
        loading={!data}
      />
      <ActionDialog
        open={modalMode === ReserveChangePriceBaseListModalModeEnum.CancelChangePrice}
        onClose={resetForCloseModal}
        confirmButtonState={cancelReserveChangePriceBaseOpts.status}
        onConfirm={() =>
          cancelReserveChangePriceBase({
            variables: {
              id: idForModal,
            },
          })
        }
        confirmButtonLabel="예약 취소"
        variant="delete"
        title="가격 정보 변경 예약 취소"
      >
        <DialogContentText>
          <Typography.Text strong={true}>가격 정보 변경 예약을 취소하시겠습니까?</Typography.Text>
          <Divider />
          <Typography.Text type="danger">취소 시 예약내용은 모두 삭제됩니다.</Typography.Text>
        </DialogContentText>
      </ActionDialog>
    </>
  );
};
</file>

