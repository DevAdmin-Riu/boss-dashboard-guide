<file path="src/app/providers/ApolloClientProvider/utils.ts">
import { ApolloCache, DocumentNode } from "@apollo/client";
import _ from "lodash";

function getNestedField(obj: any, path: string) {
  return path.split(".").reduce((acc, key) => (acc && acc[key] !== undefined ? acc[key] : undefined), obj);
}

function setNestedField(obj: any, path: string, value: any) {
  const keys = path.split(".");
  const lastKey = keys.pop()!;
  let curr = obj;
  for (const key of keys) {
    if (!curr[key]) {
      curr[key] = {};
    }
    curr = curr[key];
  }
  curr[lastKey] = value;
}

// 캐시에서 해당 쿼리 root 필드명으로 variables 조합 추출
export const getCacheVariablesListForRootField = (cache: ApolloCache<any>, schemaName: string) => {
  const rootQuery = cache.extract().ROOT_QUERY || {};
  const variablesList: object[] = [];
  Object.keys(rootQuery).forEach((key) => {
    if (key.startsWith(schemaName)) {
      const match = key.match(/\((.*)\)$/);
      if (match && match[1]) {
        try {
          variablesList.push(JSON.parse(match[1]));
        } catch {
          variablesList.push({});
        }
      } else {
        variablesList.push({});
      }
    }
  });
  return variablesList;
};

interface EdgeList {
  edges: Array<{ node: { id: string } }>;
  totalCount?: number;
}

interface CommonEdgeUpdateProps<TQuery> {
  cache: ApolloCache<any>;
  query: DocumentNode;
  edgeField: string;
  schemaName: string;
}

// 추가용 props
interface AddEdgeProps<TQuery, TEdge, TNode = any> extends CommonEdgeUpdateProps<TQuery> {
  newNode: TNode;
  makeEdges: (prevEdges: TEdge[], newNode: TNode) => TEdge[];
  addCondition?: (variables: object) => boolean;
}

// 삭제용 props
interface RemoveEdgeProps<TQuery> extends CommonEdgeUpdateProps<TQuery> {
  nodeId: string;
}

const updateEdgeList = <TQuery, TEdge extends { node: { id: string } }>(
  cache: ApolloCache<any>,
  query: DocumentNode,
  variables: object,
  edgeField: string, // string으로!
  updater: (edges: TEdge[], totalCount: number) => EdgeList
) => {
  const existing = cache.readQuery<TQuery>({ query, variables });
  if (!existing) {
    return;
  }

  // 중첩 필드 접근!
  const edgeObj = getNestedField(existing, edgeField);
  if (!edgeObj) {
    return;
  }

  const edges = edgeObj.edges || [];
  const totalCount = edgeObj.totalCount ?? edges.length;
  const result = updater(edges as TEdge[], totalCount);

  // 전체 데이터 복제 (불변성)
  const newData = _.cloneDeep(existing);
  setNestedField(newData, edgeField + ".edges", result.edges);
  if (result.totalCount !== undefined) {
    setNestedField(newData, edgeField + ".totalCount", result.totalCount);
  }

  cache.writeQuery({
    query,
    variables,
    data: newData,
  });
};
// Create 시 캐시에 새 edge 추가
export const addEdgeToListCache = <TQuery, TEdge extends { node: { id: string } }, TNode = any>(
  props: AddEdgeProps<TQuery, TEdge, TNode>
) => {
  const { cache, query, edgeField, newNode, makeEdges, addCondition, schemaName } = props;
  if (!newNode) {
    return;
  }

  const variablesList = getCacheVariablesListForRootField(cache, schemaName).filter((variables) =>
    addCondition ? addCondition(variables) : true
  );
  variablesList.forEach((variables) => {
    updateEdgeList<TQuery, TEdge>(cache, query, variables, edgeField, (edges, totalCount) => {
      const added = makeEdges(edges, newNode);
      return {
        edges: added,
        totalCount: totalCount + 1,
      };
    });
  });
};

// Delete 시 캐시에서 edge 제거
export const removeEdgeFromListCache = <TQuery, TEdge extends { node: { id: string } }>(
  props: RemoveEdgeProps<TQuery>
) => {
  const { cache, query, edgeField, nodeId, schemaName } = props;
  if (!nodeId) {
    return;
  }

  const variablesList = getCacheVariablesListForRootField(cache, schemaName);
  variablesList.forEach((variables) => {
    updateEdgeList<TQuery, TEdge>(cache, query, variables, edgeField, (edges, totalCount) => {
      const removed = edges.filter((edge) => edge.node.id !== nodeId);
      return {
        edges: removed,
        totalCount: Math.max(0, totalCount - (edges.length - removed.length)),
      };
    });
  });
};

interface FragmentFieldUpdate {
  fragment: DocumentNode;
  // 전달하는 fragment에 2개 이상의 fragment가 있을 경우, 업데이트 할 fragment 이름
  fragmentName?: string;
  fieldName: string;
  updateFn: (prev: any) => any;
}

interface UpdateMultipleFragmentsProps {
  cache: ApolloCache<any>;
  cacheId: string;
  updates: FragmentFieldUpdate[];
}

export const updateMultipleFragments = (props: UpdateMultipleFragmentsProps) => {
  const { cache, cacheId, updates } = props;
  updates.forEach(({ fragment, fragmentName, fieldName, updateFn }) => {
    const prev: any = cache.readFragment({ id: cacheId, fragment, fragmentName });
    if (!prev) {
      return;
    }

    const prevFieldValue = prev[fieldName];
    const nextFieldValue = updateFn(prevFieldValue);
    cache.writeFragment({
      id: cacheId,
      fragment,
      fragmentName,
      data: {
        ...prev,
        [fieldName]: nextFieldValue,
      },
    });
  });
};
</file>

