  const activeKeys = getActiveRackLocationTagConfigKeys(rackLocation);
  if (activeKeys.length === 0) {
    return null;
  }
  return (
    <Row wrap justify={{ sm: "start", md: "center" }} gutter={[8, 8]} style={{ flexWrap: "nowrap" }}>
