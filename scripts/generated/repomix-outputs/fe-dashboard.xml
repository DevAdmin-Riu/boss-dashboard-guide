<file path="src/app/views/settings/attributes/views/AttributeDetailsView/AttributeDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { ReorderEvent } from "@src/global/core/types/types";
import { move } from "@utils/lists";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React, { useState } from "react";

import {
  useAttributeDeleteMutation,
  useAttributeUpdateMutation,
  useAttributeValueCreateMutation,
  useAttributeValueDeleteMutation,
  useAttributeValueReorderMutation,
  useAttributeValueUpdateMutation,
} from "../../api/mutations";
import { useAttributeDetailsQuery } from "../../api/queries";
import AttributeDeleteDialog from "../../components/AttributeDeleteDialog";
import AttributePage, { AttributePageFormData } from "../../components/AttributePage";
import AttributeValueDeleteDialog from "../../components/AttributeValueDeleteDialog";
import AttributeValueEditDialog from "../../components/AttributeValueEditDialog";
import { attributeListViewUrl } from "../../urls";
import { parseAttributeValueToExcludeVat } from "../../utils";

interface AttributeDetailsViewProps {
  id: string;
}

enum AttributeModalModeEnum {
  RemoveAttribute = "RemoveAttribute",
  RemoveValue = "RemoveValue",
  AddValue = "AddValue",
  EditValue = "EditValue",
}

export const AttributeDetailsView: React.FC<AttributeDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();
  const [modalMode, setModalMode] = useState(null);
  const [idForModal, setIdForModal] = useState("");

  const resetForCloseModal = () => {
    setIdForModal("");
    setModalMode(null);
  };

  const openModalWithoutNavigate = (modalMode: AttributeModalModeEnum, id?: string) => {
    setModalMode(modalMode);
    if (id) {
      setIdForModal(id);
    }
  };

  const { data, loading } = useAttributeDetailsQuery({ variables: { id } });
  const attributeData = maybe(() => data.attribute, null);
  const parsedAttribute = parseAttributeValueToExcludeVat(attributeData);

  const [attributeDelete, attributeDeleteOpts] = useAttributeDeleteMutation({
    onCompleted: (data) => {
      const errors = data.attributeDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("속성이 삭제되었습니다.");
        navigate(attributeListViewUrl());
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [attributeValueDelete, attributeValueDeleteOpts] = useAttributeValueDeleteMutation({
    onCompleted: (data) => {
      const errors = data.attributeValueDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("값이 삭제되었습니다.");
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [attributeValueUpdate, attributeValueUpdateOpts] = useAttributeValueUpdateMutation({
    onCompleted: (data) => {
      const errors = data.attributeValueUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [attributeUpdate, attributeUpdateOpts] = useAttributeUpdateMutation({
    onCompleted: (data) => {
      const errors = data.attributeUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [attributeValueCreate, attributeValueCreateOpts] = useAttributeValueCreateMutation({
    onCompleted: (data) => {
      const errors = data.attributeValueCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("값이 추가되었습니다.");
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [attributeValueReorder, attributeValueReorderOpts] = useAttributeValueReorderMutation({
    onCompleted: (data) => {
      const errors = data.attributeReorderValues.errors;
      if (errors.length === 0) {
        showNotificationSuccess("속성 값의 순서가 변경되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleValueReorder = ({ newIndex, oldIndex }: ReorderEvent) => {
    if (newIndex !== oldIndex) {
      attributeValueReorder({
        optimisticResponse: {
          attributeReorderValues: {
            __typename: "AttributeReorderValues",
            attribute: {
              ...parsedAttribute,
              values: move(parsedAttribute.values[oldIndex], parsedAttribute.values, (a, b) => a.id === b.id, newIndex),
            },
            errors: [],
          },
        },
        variables: {
          id,
          move: {
            id: parsedAttribute.values[oldIndex].id,
            sortOrder: newIndex - oldIndex,
          },
        },
      });
    }
  };

  const handleUpdate = async (data: AttributePageFormData) => {
    const input = {
      ...data,
      inputType: undefined,
      metadata: undefined,
      privateMetadata: undefined,
    };

    const result = await attributeUpdate({ variables: { id, input } });
    return result.data.attributeUpdate.errors;
  };

  const pageDisabled =
    loading ||
    attributeDeleteOpts.loading ||
    attributeValueDeleteOpts.loading ||
    attributeValueUpdateOpts.loading ||
    attributeUpdateOpts.loading ||
    attributeValueCreateOpts.loading ||
    attributeValueReorderOpts.loading;

  return (
    <>
      <AttributePage
        attribute={parsedAttribute}
        disabled={pageDisabled}
        errors={attributeUpdateOpts.data?.attributeUpdate.errors || []}
        onBack={() => navigate(attributeListViewUrl())}
        onDelete={() => openModalWithoutNavigate(AttributeModalModeEnum.RemoveAttribute)}
        onSubmit={handleUpdate}
        onValueAdd={() => openModalWithoutNavigate(AttributeModalModeEnum.AddValue)}
        onValueDelete={(id) => openModalWithoutNavigate(AttributeModalModeEnum.RemoveValue, id)}
        onValueReorder={handleValueReorder}
        onValueUpdate={(id) => openModalWithoutNavigate(AttributeModalModeEnum.EditValue, id)}
        saveButtonBarState={attributeUpdateOpts.status}
      />
      <AttributeDeleteDialog
        open={modalMode === AttributeModalModeEnum.RemoveAttribute}
        name={maybe(() => parsedAttribute.name, "...")}
        onClose={resetForCloseModal}
        onConfirm={() => attributeDelete({ variables: { id } })}
      />
      <AttributeValueDeleteDialog
        open={modalMode === AttributeModalModeEnum.RemoveValue}
        useName
        attributeName={maybe(() => parsedAttribute.name, "...")}
        name={maybe(() => parsedAttribute.values.find((value) => idForModal === value.id).name, "...")}
        onClose={resetForCloseModal}
        onConfirm={() => attributeValueDelete({ variables: { id: idForModal } })}
      />
      <AttributeValueEditDialog
        open={modalMode === AttributeModalModeEnum.AddValue}
        disabled={pageDisabled}
        attribute={parsedAttribute}
        attributeValue={null}
        errors={attributeValueCreateOpts.data?.attributeValueCreate.errors || []}
        onClose={resetForCloseModal}
        onSubmit={(input) => attributeValueCreate({ variables: { id, input } })}
      />
      <AttributeValueEditDialog
        open={modalMode === AttributeModalModeEnum.EditValue}
        disabled={pageDisabled}
        attribute={parsedAttribute}
        attributeValue={maybe(() => parsedAttribute.values.find((value) => idForModal === value.id))}
        errors={attributeValueUpdateOpts.data?.attributeValueUpdate.errors || []}
        onClose={resetForCloseModal}
        onSubmit={(input) => attributeValueUpdate({ variables: { id: idForModal, input } })}
      />
    </>
  );
};
</file>

