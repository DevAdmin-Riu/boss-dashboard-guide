import { DownloadOutlined } from "@ant-design/icons";
import { DEFAULT_INITIAL_SEARCH_DATA, s3TemplateUrl } from "@assets/constants/config";
import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import useUser from "@hooks/useUser";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import useProductTypeSearch from "@src/api/searches/useProductTypeSearch";
import {
  AttributeValueInputBySlug,
  PriorityLevelEnum,
  ProductBulkCreateDetail,
  ProductVariantBulkUpdateDetail,
  ProductVariantManageEventInput,
  ProductVariantRegionPriceBulkDetail,
  ProductVariantVendorBulkDetails,
  SalesStatusEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { checkVatValueToPriceIncludeVat } from "@src/app/components/antd/Form/validators";
