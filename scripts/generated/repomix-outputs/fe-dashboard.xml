import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { Button, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import {
  ProductDetails_product_outerVariants_devPvOf,
  ProductDetails_product_outerVariants_devPvs,
} from "../../api/types/ProductDetails";

interface DevPvTableSettingsProps {
  onProductClick?: (productId: string) => void;
  onUnassign?: (devPvId: string) => void;
}

export const getDevPvTableSettings = (
  props: DevPvTableSettingsProps
): ColumnsType<ProductDetails_product_outerVariants_devPvs | ProductDetails_product_outerVariants_devPvOf> => {
  const { onProductClick, onUnassign } = props;

  const columns: ColumnsType<
    ProductDetails_product_outerVariants_devPvs | ProductDetails_product_outerVariants_devPvOf
  > = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      width: 120,
      align: "center",
      render: (_, record) => record.sku || "-",
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      width: 150,
      render: (_, record) => {
        const productName = record.product.name || "-";
        if (!!onProductClick) {
          return <Typography.Link onClick={() => onProductClick(record.product.id)}>{productName}</Typography.Link>;
        }
        return productName;
      },
    },
    {
      title: columnNameConstant.vendor.MAKER_CODE,
      key: "makerCode",
      align: "center",
      width: 100,
      render: (_, record) => record.maker?.code || "-",
    },
    {
      title: columnNameConstant.vendor.MAKER_NAME,
      key: "makerName",
      width: 120,
      render: (_, record) => record.maker?.name || "-",
    },
    {
      title: columnNameConstant.vendor.CODE,
      key: "vendorCode",
      align: "center",
      width: 100,
      render: (_, record) => record.defaultVariantVendor?.vendor?.code || "-",
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendorName",
      width: 150,
      render: (_, record) => record.defaultVariantVendor?.vendor?.name || "-",
    },
    !!onUnassign && {
      key: "actions",
      align: "center",
      width: 100,
      render: (_, record) => (
        <Button danger type="primary" onClick={() => onUnassign(record.id)}>
          연동 해제
        </Button>
      ),
    },
  ];
  return columns.filter(Boolean);
};
</file>

