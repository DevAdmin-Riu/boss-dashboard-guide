  bizRegNo = "bizRegNo",
}

export interface BrandGroupListFilterOpts {
  name: FilterOpts<string>;
  bizCorpName: FilterOpts<string>;
  bizRegNo: FilterOpts<string>;
}

export function createFilterStructure(opts: BrandGroupListFilterOpts): IFilter<BrandGroupListFilterKeys> {
  const nameFilter = {
    ...createTextField(0, BrandGroupListFilterKeys.name, "그룹명", opts.name.value),
