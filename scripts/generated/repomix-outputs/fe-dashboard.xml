import { getStatisticClassName } from "@src/app/components/antd/Statistic/StatisticProps";
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import DateTime, { getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { Statistic, Typography } from "antd";
import React from "react";

import { BrandVacsFeeEventList_brandVacsFeeEvents_edges_node } from "../../api/types/BrandVacsFeeEventList";
import { BrandVacsFeeEventListPageListPageProps } from "./BrandVacsFeeEventListPage";

export const getBrandVacsFeeEventTableColumns = (
  props: Pick<BrandVacsFeeEventListPageListPageProps, "onRowClick">,
  isHqStaff: boolean
) => {
  const { onRowClick } = props;
  const showBrandColumn = !!onRowClick && isHqStaff === false;

  const checkIsIncreased = (record: BrandVacsFeeEventList_brandVacsFeeEvents_edges_node) =>
    record.amountExcludeVatAfter > record.amountExcludeVatBefore;
  const checkIsDecreased = (record: BrandVacsFeeEventList_brandVacsFeeEvents_edges_node) =>
    record.amountExcludeVatAfter < record.amountExcludeVatBefore;

  const columns: DownloadableColumnsType<BrandVacsFeeEventList_brandVacsFeeEvents_edges_node> = [];
  columns.push({
    title: "추가/차감일",
    align: "center",
    key: "created",
    width: 180,
    render: (_, record) => <DateTime date={record.created} />,
    renderExcel: (record) => getDateByFormat(record.created),
  });
  if (showBrandColumn) {
    columns.push({
      title: columnNameConstant.brand.BRAND_CODE,
      align: "center",
      key: "brandCode",
      width: 100,
      render: (_, record) => record.brand?.code || "-",
    });
    columns.push({
      title: columnNameConstant.brand.BRAND_NAME,
      align: "center",
      key: "brandName",
      width: 150,
      render: (_, record) => {
        if (record.brand) {
          return <Typography.Link onClick={() => onRowClick(record.brand.id)}>{record.brand.name}</Typography.Link>;
        } else {
          return "-";
        }
      },
      renderExcel: (record) => record.brand?.name || "-",
    });
  }
  columns.push({
    title: columnNameConstant.user.ID,
    align: "center",
    key: "loginId",
    width: 150,
    render: (_, record) => record.user?.loginId || "-",
  });
  columns.push({
    title: columnNameConstant.user.USER_NAME,
    align: "center",
    key: "firstName",
    width: 150,
    render: (_, record) => record.user?.firstName || "-",
  });
  columns.push({
    title: "상세내용",
    align: "center",
    key: "description",
    width: 400,
    render: (_, record) => record.description,
  });
  columns.push({
    title: "추가",
    align: "right",
    key: "increased",
    width: 120,
    render: (_, record) =>
      checkIsIncreased(record) ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-green"])}
          prefix={"+"}
          value={record.amountExcludeVat}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (checkIsIncreased(record) ? record.amountExcludeVat : "-"),
  });
  columns.push({
    title: "차감",
    align: "right",
    key: "decreased",
    width: 120,
    render: (_, record) =>
      checkIsDecreased(record) ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-red"])}
          prefix={"-"}
          value={record.amountExcludeVat}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (checkIsDecreased(record) ? record.amountExcludeVat : "-"),
  });
  columns.push({
    title: "잔여 수수료",
    align: "right",
    key: "amountExcludeVatAfter",
    width: 120,
    render: (_, record) => (
      <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={record.amountExcludeVatAfter} />
    ),
    renderExcel: (record) => record.amountExcludeVatAfter,
  });
  return columns;
};
</file>

<file path="src/app/views/brand/brands/components/BrandVacsFeeEventListPage/filters.ts">
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createTextField } from "@utils/filters/fields";

export enum BrandVacsFeeEventFilterKeys {
  created = "created",
  brandSearch = "brandSearch",
  userSearch = "userSearch",
}

export interface BrandVacsFeeEventListFilterOpts {
  created: FilterOpts<MinMax>;
  brandSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: BrandVacsFeeEventListFilterOpts,
  isHqStaff: boolean
): IFilter<BrandVacsFeeEventFilterKeys> {
  let displayOrder = 0;
  const filterStructure = [];
  filterStructure.push({
    ...createDateField(displayOrder++, BrandVacsFeeEventFilterKeys.created, "추가/차감일", opts.created.value),
    active: opts.created.active,
  });
  if (!isHqStaff) {
    filterStructure.push({
      ...createTextField(
        displayOrder++,
        BrandVacsFeeEventFilterKeys.brandSearch,
        "브랜드코드 / 브랜드명",
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    });
  }
  filterStructure.push({
    ...createTextField(displayOrder++, BrandVacsFeeEventFilterKeys.userSearch, "ID / 사용자명", opts.userSearch.value),
    active: opts.userSearch.active,
  });
  return filterStructure;
}
</file>

