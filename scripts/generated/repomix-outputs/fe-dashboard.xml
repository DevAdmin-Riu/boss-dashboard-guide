import { BrandContractStatusEnum, BrandEtcFileTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, newLineStr } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, getDatesBetween, onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { makeHeaderRowsAndMerges, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { checkIsEnableForB2bServiceByBrand, transformIsFBV, transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { BrandForBpvList_brand } from "../../api/types/BrandForBpvList";
import { BrandListForStats_brands_edges_node } from "../../api/types/BrandListForStats";
import {
  BrandManagerInfoListDownloadQuery_brands_edges_node,
  BrandManagerInfoListDownloadQuery_brands_edges_node_peopleInChargeInfo_bossMall,
} from "../../api/types/BrandManagerInfoListDownloadQuery";
import { Brands_brands_edges_node } from "../../api/types/Brands";
import {
  brandB2bPayMethodChoices,
  brandPeopleInChargeInfoChoices,
  getBrandContractStatusText,
  getBrandContractTypeText,
  getBrandEtcFileDateRangeText,
  getBrandEtcFileTypeText,
  getBrandMdName,
  getBrandMdPhone,
  getBrandRunningTypeText,
} from "../../utils";

export interface TBrandOrderStatsWithBrand {
  brand: BrandListForStats_brands_edges_node;
  brandOrderStatsNonFbv: BrandOrderStats_brandOrderStats[];
  brandOrderStatsOnlyFbv: BrandOrderStats_brandOrderStats[];
}

const defaultValue = "-";
// NOTE: 다운로드 한 엑셀 파일에서 숫자 형식의 컬럼은 피벗을 돌리는 경우가 존재하여, 값이 없으면 기본값을 0으로 설정
const defaultNumberValue = 0;

export const getInsuranceDepositIncludeVatByBrand = (
  brand: Pick<BrandListForStats_brands_edges_node | BrandForBpvList_brand, "etcInfo">
): number | null => {
  if (utils.isEmpty(brand) || utils.isEmpty(brand?.etcInfo)) {
    return null;
  }
  return brand.etcInfo.insuranceDeposit;
};

export const getInsuranceDepositExcludeVatByBrand = (
  brand: Pick<BrandListForStats_brands_edges_node | BrandForBpvList_brand, "etcInfo">
): number | null => {
  const value = getInsuranceDepositIncludeVatByBrand(brand);
  return toPriceExcludeVat(value, false);
};

export const getDepositIncludeVatByBrand = (
  brand: Pick<BrandListForStats_brands_edges_node | BrandForBpvList_brand, "etcInfo">
): number | null => {
  if (utils.isEmpty(brand) || utils.isEmpty(brand?.etcInfo)) {
    return null;
  }
  return brand.etcInfo.deposit;
};

export const getDepositExcludeVatByBrand = (
  brand: Pick<BrandListForStats_brands_edges_node | BrandForBpvList_brand, "etcInfo">
): number | null => {
  const value = getDepositIncludeVatByBrand(brand);
  return toPriceExcludeVat(value, false);
};

const getFormattedMonthArr = (duration: string[]) => {
  const [startDateString, endDateString] = duration;
  const startDate = !utils.isEmpty(startDateString) ? moment(startDateString) : moment();
  const endDate = !utils.isEmpty(endDateString) ? moment(endDateString) : moment();

  return getDatesBetween([startDate, endDate], "month")?.formattedDates;
};

export const makeWarningContractPeriodTextAry = (
  brand: Pick<Brands_brands_edges_node, "contractStatus" | "warningEtcFiles">
): string[] => {
  if (utils.isEmpty(brand) || brand.contractStatus === BrandContractStatusEnum.EXPIRED) {
    return [];
  }
  const warningContractPeriodTextAry = [];
  const { warningEtcFiles } = brand;
  for (const warningEtcFile of warningEtcFiles) {
    const etcFileTypeText = getBrandEtcFileTypeText(warningEtcFile.type);
    const endDateText = getDateByFormat(warningEtcFile?.endDate, onlyDateFormat);
    const warningContractPeriodText = `${etcFileTypeText}: ${endDateText}`;
    warningContractPeriodTextAry.push(warningContractPeriodText);
  }
  return warningContractPeriodTextAry;
};

const brandKeysToMerge = {
  brand: "[브랜드 정보]",
  md: "[담당 MD]",
  contract: "[계약 정보]",
  totalProductCnt: "[브랜드 상품 수]",
  isFulfilledByBoss: "[보스 상품]",
  settlementAccount: "[정산계좌 정보]",
};

export const parseBrandManagerInfoList = (brands: BrandManagerInfoListDownloadQuery_brands_edges_node[]) => {
  const brandKeysToMerge = {
    brand: "[브랜드 정보]",
    contract: "[계약정보]",
    md: "[담당 MD]",
  };

  const assignPersonInChargeInfoRowData = (
    rowData: { [x: string]: any },
    keyToMerge: string,
    personInChargeInfo: Pick<
      BrandManagerInfoListDownloadQuery_brands_edges_node_peopleInChargeInfo_bossMall,
      "name" | "contact" | "email"
    >
  ) => {
    if (utils.isEmpty(personInChargeInfo)) {
      rowData[keyToMerge + newLineStr(columnNameConstant.common.NAME)] = defaultValue;
      rowData[keyToMerge + newLineStr(columnNameConstant.common.PHONE)] = defaultValue;
      rowData[keyToMerge + newLineStr(columnNameConstant.common.EMAIL)] = defaultValue;
    } else {
      rowData[keyToMerge + newLineStr(columnNameConstant.common.NAME)] = personInChargeInfo.name || defaultValue;
      rowData[keyToMerge + newLineStr(columnNameConstant.common.PHONE)] =
        transformPhoneNumber(personInChargeInfo.contact) || defaultValue;
      rowData[keyToMerge + newLineStr(columnNameConstant.common.EMAIL)] = personInChargeInfo.email || defaultValue;
    }
  };

  // 모든 브랜드 중에서 최대 기타 담당자 수 계산
  const maxCustomPersons = brands.reduce((max, brand) => {
    const customPersonsLength = brand?.peopleInChargeInfo?.customPersons?.length || 0;
    return Math.max(max, customPersonsLength);
  }, 0);

  const columns = brands.map((brand) => {
    const row = {
      // 브랜드 정보
      [brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_CODE)]: brand?.code || defaultValue,
      [brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_NAME)]: brand?.name || defaultValue,
      [brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BIZ_NAME)]: brand?.bizInfo?.bizName || defaultValue,
      [brandKeysToMerge.brand + newLineStr(columnNameConstant.common.BIZ_REG_NO)]:
        brand?.bizInfo?.bizRegNo || defaultValue,
      [brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.FIRST_ORDER_DATE)]: brand?.firstDay
        ? getDateByFormat(brand.firstDay, onlyDateFormat)
        : defaultValue,

      // 계약정보
      [brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.CONTRACT_TYPE)]: getBrandContractTypeText(
        brand?.contractType
      ),

      // 담당 MD
      [brandKeysToMerge.md + newLineStr(columnNameConstant.brand.MD_IN_CHARGE)]: getBrandMdName(brand?.staff),
      [brandKeysToMerge.md + newLineStr(columnNameConstant.brand.MD_IN_CHARGE_PHONE)]: getBrandMdPhone(brand?.staff),
    };

    // 주요 담당자
    brandPeopleInChargeInfoChoices.forEach((choice) => {
      const { label, value } = choice;
      const keyToMerge = `[${label} 담당자]`;
      const personInChargeInfo = brand?.peopleInChargeInfo?.[value];

      assignPersonInChargeInfoRowData(row, keyToMerge, personInChargeInfo);
    });

    // 기타 담당자들 추가 (동적으로 필요한 만큼만)
    for (let i = 0; i < maxCustomPersons; i++) {
      const keyToMerge = `[기타 담당자 ${i + 1}]`;
      const personInChargeInfo = brand?.peopleInChargeInfo?.customPersons?.[i];

      row[keyToMerge + newLineStr("담당자 유형")] = personInChargeInfo?.typeName || defaultValue;
      assignPersonInChargeInfoRowData(row, keyToMerge, personInChargeInfo);
    }

    return row;
  });

  if (!columns || columns.length === 0) {
    return { columns, header: [], merges: [] };
  }

  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
};

export const parseBrandListForStats = (
  brandOrderStatsList: TBrandOrderStatsWithBrand[],
  durationVariable: string[]
) => {
  const formattedMonthArr = getFormattedMonthArr(durationVariable);
  const brandInfoColNames = {
    // 이하 브랜드 정보
    code: brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_CODE),
    name: brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BRAND_NAME),
    bizName: brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.BIZ_NAME),
    bizRegNo: brandKeysToMerge.brand + newLineStr(columnNameConstant.common.BIZ_REG_NO),
    firstDay: brandKeysToMerge.brand + newLineStr(columnNameConstant.brand.FIRST_ORDER_DATE),
    mdName: brandKeysToMerge.md + newLineStr(columnNameConstant.brand.MD_IN_CHARGE),
    mdPhone: brandKeysToMerge.md + newLineStr(columnNameConstant.brand.MD_IN_CHARGE_PHONE),

    // 이하 계약 정보
    contractType: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.CONTRACT_TYPE),
    payMethod: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.PAY_METHOD),
    mileageRate: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.MILEAGE_RATE.join("")),
    isRunning: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.IS_RUNNING),
    contractStatus: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.CONTRACT_STATUS),
    warningContractPeriod:
      brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.RENEWAL_NEEDED_WITHIN_2_MONTHS),

    // 각 계약서의 계약 기간 컬럼
    productSupplyContractPeriod:
      brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.PRODUCT_SUPPLY_CONTRACT),
    stockPolicyPeriod: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.STOCK_POLICY),
    insuranceContractPeriod: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.INSURANCE_CONTRACT),
    depositContractPeriod: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.DEPOSIT_CONTRACT),

    insuranceDeposit: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.INSURANCE_DEPOSIT),
    deposit: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.DEPOSIT),
    currentBrandUserCount: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.ACTUAL_BRAND_STORE_COUNT),
    currentBrandUserCountUpdateDate:
      brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.ACTUAL_BRAND_STORE_COUNT_DATE),
    numberOfActiveMembers: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.BRAND_STORE_COUNT),
    isDirectShipping: brandKeysToMerge.contract + newLineStr(columnNameConstant.brand.IS_DIRECT_SHIPPING),

    // 이하 상품 수
    numberOfTotalBrandProductVariants: brandKeysToMerge.totalProductCnt + newLineStr(columnNameConstant.brand.TOTAL),
    numberOfExclusiveNormalBrandProductVariants:
      brandKeysToMerge.isFulfilledByBoss + newLineStr(columnNameConstant.brand.EXCLUSIVE_GENERAL),
    numberOfExclusiveDsBrandProductVariants:
      brandKeysToMerge.isFulfilledByBoss + newLineStr(columnNameConstant.brand.EXCLUSIVE_DS),
    numberOfCommonNormalBrandProductVariants:
      brandKeysToMerge.isFulfilledByBoss + newLineStr(columnNameConstant.brand.NON_EXCLUSIVE_GENERAL),
    numberOfCommonDsBrandProductVariants:
      brandKeysToMerge.isFulfilledByBoss + newLineStr(columnNameConstant.brand.NON_EXCLUSIVE_DS),
    numberOfBrandProductVariantsFulfilledByVendor: `${transformIsFBV(true)} 상품`,

    // 정산계좌 정보
    settlementAccountBankName:
      brandKeysToMerge.settlementAccount + newLineStr(columnNameConstant.brand.SETTLEMENT_ACCOUNT_BANK_NAME),
    settlementAccountOwnerName: brandKeysToMerge.settlementAccount + newLineStr(columnNameConstant.brand.ACCOUNT_OWNER),
    settlementAccountNo: brandKeysToMerge.settlementAccount + newLineStr(columnNameConstant.brand.ACCOUNT_NO),
  };
  const brandOrderStatsColNames = {
    statTotalPriceExcludeVatNonFbv: "보스 상품 매출\n(부가세 별도)",
    statBrandCostPriceExcludeVatNonFbv: "보스 상품 매입\n(부가세 별도)",
    statBrandDeliveryFeeExcludeVat: "보스 상품 배송비\n(부가세 별도)",
    statBrandPayingChargeExcludeVat: "PG수수료\n(부가세 별도)",
    statMileageExcludeVat: "본부수익금\n(부가세 별도)",
    statTotalPriceExcludeVatOnlyFbv: `${transformIsFBV(true)} 상품 매출\n(부가세 별도)`,
    statBrandCostPriceExcludeVatOnlyFbv: `${transformIsFBV(true)} 상품 매입\n(부가세 별도)`,
  };

  const columns = brandOrderStatsList.map((brandOrderStatsItem) => {
    const { brand, brandOrderStatsNonFbv, brandOrderStatsOnlyFbv } = brandOrderStatsItem;
    const insuranceDepositExcludeVat = getInsuranceDepositExcludeVatByBrand(brand) || defaultNumberValue;
    const depositExcludeVat = getDepositExcludeVatByBrand(brand) || defaultNumberValue;
    const { total, exclusive, common, exclusiveDirectShippingOnly, commonDirectShippingOnly, fulfilledByVendor } =
      brand?.numberOfNonStoppedBrandProductVariants
        ? brand?.numberOfNonStoppedBrandProductVariants
        : {
            total: defaultNumberValue,
            exclusive: defaultNumberValue,
            common: defaultNumberValue,
            exclusiveDirectShippingOnly: defaultNumberValue,
            commonDirectShippingOnly: defaultNumberValue,
            fulfilledByVendor: defaultNumberValue,
          };
    const row = {
      [brandInfoColNames.code]: brand?.code || defaultValue,
      [brandInfoColNames.name]: brand?.name || defaultValue,
      [brandInfoColNames.bizName]: brand?.bizInfo?.bizName || defaultValue,
      [brandInfoColNames.bizRegNo]: brand?.bizInfo?.bizRegNo || defaultValue,
      [brandInfoColNames.firstDay]: brand?.firstDay || defaultValue,
      [brandInfoColNames.mdName]: brand?.staff?.firstName || defaultValue,
      [brandInfoColNames.mdPhone]: transformPhoneNumber(brand?.staff?.aligoPhone),
      [brandInfoColNames.contractType]: getBrandContractTypeText(brand?.contractType),
      [brandInfoColNames.payMethod]: checkIsEnableForB2bServiceByBrand(brand)
        ? brandB2bPayMethodChoices.find((payMethod) => payMethod.value === brand?.b2bPayMethod).label
        : defaultValue,
      [brandInfoColNames.mileageRate]: `${brand?.mileageRate}%` || defaultValue,
      [brandInfoColNames.isRunning]: getBrandRunningTypeText(brand?.isRunning),
      [brandInfoColNames.contractStatus]: getBrandContractStatusText(brand?.contractStatus),
      [brandInfoColNames.warningContractPeriod]: makeWarningContractPeriodTextAry(brand).join("\n") || defaultValue,
      [brandInfoColNames.productSupplyContractPeriod]: getBrandEtcFileDateRangeText(
        brand?.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.PRODUCT_SUPPLY_CONTRACT)
      ),
      [brandInfoColNames.stockPolicyPeriod]: getBrandEtcFileDateRangeText(
        brand?.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.STOCK_POLICY)
      ),
      [brandInfoColNames.insuranceContractPeriod]: getBrandEtcFileDateRangeText(
        brand?.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.INSURANCE_CONTRACT)
      ),
      [brandInfoColNames.depositContractPeriod]: getBrandEtcFileDateRangeText(
        brand?.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.DEPOSIT_CONTRACT)
      ),
      [brandInfoColNames.insuranceDeposit + newLineStr("(부가세 별도)")]: insuranceDepositExcludeVat,
      [brandInfoColNames.deposit + newLineStr("(부가세 별도)")]: depositExcludeVat,
      [brandInfoColNames.currentBrandUserCount]: brand.isBossMarket
        ? defaultValue
        : brand?.currentBrandUserCount
        ? brand.currentBrandUserCount
        : defaultValue,
      [brandInfoColNames.currentBrandUserCountUpdateDate]: brand?.currentBrandUserCountUpdateDate
        ? getDateByFormat(brand.currentBrandUserCountUpdateDate, onlyDateFormat)
        : defaultValue,
      [brandInfoColNames.numberOfActiveMembers]: brand.isBossMarket
        ? defaultValue
        : brand?.numberOfActiveMembers || defaultNumberValue,
      [brandInfoColNames.numberOfTotalBrandProductVariants]: total,
      [brandInfoColNames.numberOfExclusiveNormalBrandProductVariants]: exclusive - exclusiveDirectShippingOnly,
      [brandInfoColNames.numberOfExclusiveDsBrandProductVariants]: exclusiveDirectShippingOnly,
      [brandInfoColNames.numberOfCommonNormalBrandProductVariants]: common - commonDirectShippingOnly,
      [brandInfoColNames.numberOfCommonDsBrandProductVariants]: commonDirectShippingOnly,
      [brandInfoColNames.numberOfBrandProductVariantsFulfilledByVendor]: fulfilledByVendor,
      [brandInfoColNames.settlementAccountBankName]: brand?.settlementAccountInfo?.bankName || defaultValue,
      [brandInfoColNames.settlementAccountOwnerName]: brand?.settlementAccountInfo?.accountOwnerName || defaultValue,
      [brandInfoColNames.settlementAccountNo]: brand?.settlementAccountInfo?.accountNo || defaultValue,
    };

    for (const formattedMonth of formattedMonthArr) {
      const brandOrderStatNonFbvIdx = brandOrderStatsNonFbv.findIndex((stat) => {
        const statMonthFormat = moment(stat.statDate).format(onlyMonthFormat);
        return formattedMonth === statMonthFormat;
      });
      const brandOrderStatOnlyFbvIdx = brandOrderStatsOnlyFbv.findIndex((stat) => {
        const statMonthFormat = moment(stat.statDate).format(onlyMonthFormat);
        return formattedMonth === statMonthFormat;
      });

      const monthKeyToMerge = "[" + formattedMonth + "]";
      if (brandOrderStatNonFbvIdx === -1) {
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statTotalPriceExcludeVatNonFbv}`] = defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandCostPriceExcludeVatNonFbv}`] = defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandDeliveryFeeExcludeVat}`] = defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandPayingChargeExcludeVat}`] = defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statMileageExcludeVat}`] = defaultNumberValue;
      } else {
        const brandOrderStatNonFbv = brandOrderStatsNonFbv[brandOrderStatNonFbvIdx];
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statTotalPriceExcludeVatNonFbv}`] =
          brandOrderStatNonFbv.statTotalPriceExcludeVat || defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandCostPriceExcludeVatNonFbv}`] =
          brandOrderStatNonFbv.statBrandCostPriceExcludeVat || defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandDeliveryFeeExcludeVat}`] =
          toPriceExcludeVat(brandOrderStatNonFbv.statBrandDeliveryFee) || defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandPayingChargeExcludeVat}`] =
          brandOrderStatNonFbv.statBrandPayingChargeExcludeVat || defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statMileageExcludeVat}`] =
          brandOrderStatNonFbv.statMileageExcludeVat || defaultNumberValue;
      }

      if (brandOrderStatOnlyFbvIdx === -1) {
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statTotalPriceExcludeVatOnlyFbv}`] = defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandCostPriceExcludeVatOnlyFbv}`] = defaultNumberValue;
      } else {
        const brandOrderStatOnlyFbv = brandOrderStatsOnlyFbv[brandOrderStatNonFbvIdx];
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statTotalPriceExcludeVatOnlyFbv}`] =
          brandOrderStatOnlyFbv.statTotalPriceExcludeVat || defaultNumberValue;
        row[`${monthKeyToMerge}\n${brandOrderStatsColNames.statBrandCostPriceExcludeVatOnlyFbv}`] =
          brandOrderStatOnlyFbv.statBrandCostPriceExcludeVat || defaultNumberValue;
      }
    }

    return row;
  });

  if (!columns || columns.length === 0) {
    return { columns, header: [], merges: [] };
  }

  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
};
</file>

<file path="src/app/views/brand/brands/components/BrandListTable/BrandListTable.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AssignStaffDialog from "@src/app/components/AssignStaffDialog";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import {
  BrandFilterKeys,
  BrandListFilterOpts,
  createFilterStructure,
} from "@src/app/views/brand/brands/components/BrandListPage/filters";
import { createSorterStructure } from "@src/app/views/brand/brands/components/BrandListPage/sorters";
import { BrandListViewUrlSortField } from "@src/app/views/brand/brands/urls";
import { useBrandStaffAssign, useStaffMemberUpdate } from "@src/app/views/settings/staff/api/mutations";
import { BrandStaffAssign } from "@src/app/views/settings/staff/api/types/BrandStaffAssign";
import { StaffMemberUpdate } from "@src/app/views/settings/staff/api/types/StaffMemberUpdate";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import { Brands, Brands_brands_edges_node, BrandsVariables } from "../../api/types/Brands";
import { getBrandListTableColumns } from "./BrandListTableSettings";

interface BrandListProps
  extends PaginateListProps,
    FilterPageProps<BrandFilterKeys, BrandListFilterOpts>,
    SortPage<BrandListViewUrlSortField> {
  brands: Brands_brands_edges_node[];
  onBrandProductListView: (id: string, code: string, name: string) => void;
  queryVariablesWithoutPagination: BrandsVariables;
  fetchForDownload: (variables?: BrandsVariables) => Promise<ApolloQueryResult<Brands>>;
}

export enum BrandListModalModeEnum {
  AssignStaff = "AssignStaff",
}

export const BrandListTable: React.FC<BrandListProps> = (props) => {
  const { brands, onRowClick, onBrandProductListView, ...listProps } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const filterStructure = createFilterStructure(listProps.filterOpts);
  const sorterStructure = createSorterStructure();

  const [idForModal, setIdForModal] = useState(null);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
    setIdForModal(null);
  };

  const openModalWithoutNavigate = (modalMode: BrandListModalModeEnum, idForModal?: string) => {
    setModalMode(modalMode);
    if (idForModal) {
      setIdForModal(idForModal);
    }
  };

  const handleStaffMemberUpdate = (data: StaffMemberUpdate) => {
    const errors = data.staffUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess("브랜드몰 확인용 관리자가 변경되었습니다.");
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [_, updateStaffResult] = useStaffMemberUpdate({
    onCompleted: handleStaffMemberUpdate,
  });

  const handleBrandStaffAssign = (data: BrandStaffAssign) => {
    const errors = data.brandStaffAssign.accountErrors;
    if (errors.length === 0) {
      showNotificationSuccess(`브랜드몰 확인용 관리자 설정이 적용 되었습니다.`);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [brandStaffAssign] = useBrandStaffAssign({
    onCompleted: (data) => {
      handleBrandStaffAssign(data);
    },
  });

  const assignStaffToBrandMall = (staffId: string, brandId: string) => {
    brandStaffAssign({
      variables: {
        brandId,
        staffId,
      },
    });
  };

  const columns = getBrandListTableColumns({
    disabled: listProps.disabled,
    updateStaffResult,
    openModalWithoutNavigate,
    onBrandProductListView,
    onRowClick,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload: listProps.fetchForDownload,
    queryVariablesWithoutPagination: listProps.queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "brands",
  };

  return (
    <>
      <SpreadFilterBar
        currencySymbol={listProps.currencySymbol}
        currentTab={listProps.currentTab}
        filterStructure={filterStructure}
        tabs={listProps.tabs}
        onAll={listProps.onAll}
        onFilterChange={listProps.onFilterChange}
        onTabChange={listProps.onTabChange}
        onTabDelete={listProps.onTabDelete}
        onTabSave={listProps.onTabSave}
        tabExtra={
          <>
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
            <SorterDropdown sorterStructure={sorterStructure} sort={listProps.sort} onSort={listProps.onSort} />
          </>
        }
        isDownloadable={true}
        excelDownloadProps={excelDownloadProps}
      />
      <TableVatLegend isIncludeVat={false} />
      <PatchedColumnsTable
        {...commonTableProps}
        ref={tableRef}
        dataSource={brands}
        columns={pickerSelectedColumns}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        footer={() => <TableListFooter {...listProps} />}
      />
      <AssignStaffDialog
        open={modalMode === BrandListModalModeEnum.AssignStaff}
        loading={listProps.disabled}
        onClose={resetForCloseModal}
        onSubmit={(staff) => assignStaffToBrandMall(staff.id, idForModal)}
      />
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandListTable/BrandListTableSettings.tsx">
import { MutationResult } from "@apollo/client";
import { commonMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { StaffMemberUpdate } from "@src/app/views/settings/staff/api/types/StaffMemberUpdate";
import { MutationResultAdditionalProps } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformOnOff } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Space, Tag, Typography } from "antd";
import React from "react";

import { Brands_brands_edges_node } from "../../api/types/Brands";
import {
  brandContractFileTypeChoices,
  brandServiceChoices,
  getBrandContractStatusText,
  getBrandContractTypeText,
  getBrandEtcFileDateRangeText,
  getBrandEtcFileTypeText,
  getBrandMdName,
  getBrandMdPhone,
  getBrandRunningTypeText,
} from "../../utils";
import {
  getDepositIncludeVatByBrand,
  getInsuranceDepositIncludeVatByBrand,
  makeWarningContractPeriodTextAry,
} from "../BrandListPage/utils";
import { BrandListModalModeEnum } from "./BrandListTable";

interface BrandListTableColumnsProps {
  disabled: boolean;
  updateStaffResult: MutationResult<StaffMemberUpdate> & MutationResultAdditionalProps;
  openModalWithoutNavigate: (modalMode: BrandListModalModeEnum, idForModal?: string) => void;
  onBrandProductListView: (id: string, code: string, name: string) => void;
  onRowClick?: (id: string) => void;
}

const makeWarningContractsNode = (brand: Brands_brands_edges_node, isHtml: boolean = true) => {
  const warningContractPeriodTextAry = makeWarningContractPeriodTextAry(brand);
  if (utils.isEmpty(warningContractPeriodTextAry)) {
    return "-";
  }

  if (isHtml) {
    return (
      <Space direction="vertical">
        {warningContractPeriodTextAry.map((text, idx) => (
          <Tag key={idx} color="red">
            {text}
          </Tag>
        ))}
      </Space>
    );
  } else {
    return warningContractPeriodTextAry.join(", ");
  }
};

export const getBrandListTableColumns = (props: BrandListTableColumnsProps) => {
  const { logout } = useUser();
  const { disabled, updateStaffResult, openModalWithoutNavigate, onBrandProductListView, onRowClick } = props;
  const fixedFlag = utils.checkMobile() === false;

  const handlingRedirectDashboard = (code: string, event) => {
    event.stopPropagation();
    const url = `https://admin.pojangboss.com/?id=${code}&pw=1234qwer`;
    logout();
    // 새탭에서 url을 연다.
    window.open(url, "_blank");
  };

  const handlingRedirectBossmall = (code: string, event) => {
    event.stopPropagation();
    const url = `https://pojangboss.com/log-in?id=${code}&pw=1234qwer`;
    // 새탭에서 url을 연다.
    window.open(url, "_blank");
  };
  // 브랜드 정보
  const brandInfoFixedColumns: DownloadableColumnsType<Brands_brands_edges_node> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "code",
      align: "center",
      width: 100,
      fixed: fixedFlag,
      render: (_, record) => record.code || "-",
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "name",
      align: "left",
      width: 150,
      fixed: fixedFlag,
      render: (_, record) =>
        !!onRowClick ? (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.name || "-"}</Typography.Link>
        ) : (
          record.name || "-"
        ),
      renderExcel: (record) => record.name || "-",
    },
    {
      title: columnNameConstant.brand.BIZ_NAME,
      key: "bizName",
      align: "center",
      width: 100,
      fixed: fixedFlag,
      render: (_, record) => record.bizInfo?.bizName || "-",
    },
    {
      title: columnNameConstant.common.BIZ_REG_NO,
      key: "bizRegNo",
      align: "center",
      width: 120,
      fixed: fixedFlag,
      render: (_, record) => record.bizInfo?.bizRegNo || "-",
    },
    {
      title: columnNameConstant.brand.BRAND_MALL_CREATED,
      key: "created",
      align: "center",
      width: 120,
      fixed: fixedFlag,
      render: (_, record) => <DateTime date={record.created} onlyDate />,
      renderExcel: (record) => getDateByFormat(record.created, onlyDateFormat),
    },
    {
      title: columnNameConstant.brand.FIRST_ORDER_DATE,
      key: "firstDay",
      align: "center",
      width: 120,
      fixed: fixedFlag,
      render: (_, record) => <DateTime date={record.firstDay} onlyDate />,
      renderExcel: (record) => getDateByFormat(record.firstDay, onlyDateFormat),
    },
  ];
  // 부가 서비스
  const additionalServiceColumns: DownloadableColumnsType<Brands_brands_edges_node> = [
    {
      title: columnNameConstant.brand.IS_BOSS_MARKET_USE,
      key: "isBossMarketUse",
      align: "center",
      width: 100,
      render: (_, record) => transformOnOff(record.isBossMarketUse),
    },
  ];
  // 계약정보
  const contractPeriodColumns: DownloadableColumnsType<Brands_brands_edges_node> = brandContractFileTypeChoices
    .map((choice) => choice.value)
    .map((brandEtcFileType) => ({
      title: getBrandEtcFileTypeText(brandEtcFileType),
      key: `${brandEtcFileType}-contractPeriod`,
      align: "center",
      width: 200,
      render: (_, record) =>
        getBrandEtcFileDateRangeText(record.etcFiles?.find((etcFile) => etcFile.type === brandEtcFileType)),
    }));
  const contractInfoColumns: DownloadableColumnsType<Brands_brands_edges_node> = [
    {
      title: columnNameConstant.brand.CONTRACT_STATUS,
      key: "isContract",
      align: "center",
      width: 100,
      render: (_, record) => getBrandContractStatusText(record.contractStatus),
    },
    {
      title: columnNameConstant.brand.IS_RUNNING,
      key: "isRunning",
      align: "center",
      width: 80,
      render: (_, record) => getBrandRunningTypeText(record.isRunning),
    },
    {
      title: columnNameConstant.brand.ENABLED_SERVICES,
      key: "enabledServices",
      align: "center",
      width: 120,
      render: (_, record) =>
        record.enabledServices.map((service) => utils.getLabelTextByValue(service, brandServiceChoices)).join(", "),
    },
    {
      title: columnNameConstant.brand.CONTRACT_TYPE,
      key: "contractType",
      align: "center",
      width: 120,
      render: (_, record) => getBrandContractTypeText(record.contractType),
    },
    {
      title: columnNameConstant.brand.MILEAGE_RATE,
      key: "mileageRate",
      align: "right",
      width: 80,
      render: (_, record) => record.mileageRate || 0,
    },
    {
      title: columnNameConstant.brand.RENEWAL_NEEDED_WITHIN_2_MONTHS,
      key: "contractWarning",
