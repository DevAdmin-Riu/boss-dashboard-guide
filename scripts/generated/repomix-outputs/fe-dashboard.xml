import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { ISorter } from "@src/app/components/SorterDropdown/types";

import { GridAttributes_availableInGrid_edges_node } from "../../api/types/GridAttributes";
import { ProductListViewUrlSortField } from "../../urls";

export function createSorterStructure(
  availableInGridAttributes: GridAttributes_availableInGrid_edges_node[],
  isFulfilledByVendor: boolean
): ISorter<ProductListViewUrlSortField> {
  let displayOrder = 0;
  const sorterSturcture: ISorter<ProductListViewUrlSortField> = [];
  sorterSturcture.push(
    {
      displayOrder: displayOrder++,
      label: "제품코드",
      sortField: ProductListViewUrlSortField.sku,
    },
    {
      displayOrder: displayOrder++,
      label: "제품명",
      sortField: ProductListViewUrlSortField.name,
    },
    {
      displayOrder: displayOrder++,
      label: columnNameConstant.product.IS_TAX_FREE,
      sortField: ProductListViewUrlSortField.isTaxFree,
    }
  );
  if (isFulfilledByVendor === false) {
    sorterSturcture.push(
      {
        displayOrder: displayOrder++,
        label: "협력사 매입가",
        sortField: ProductListViewUrlSortField.costPrice,
      },
      {
        displayOrder: displayOrder++,
        label: "배송비",
        sortField: ProductListViewUrlSortField.deliveryFee,
      },
      {
        displayOrder: displayOrder++,
        label: "제품 타입",
        sortField: ProductListViewUrlSortField.productType,
      }
    );
  }
  availableInGridAttributes.forEach((gridAttr) => {
    sorterSturcture.push({
      displayOrder: displayOrder++,
      label: gridAttr.name || "-",
      sortField: ProductListViewUrlSortField.attribute,
      sortId: gridAttr.id,
    });
  });
  return sorterSturcture;
}
