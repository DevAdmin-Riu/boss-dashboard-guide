export enum HqOrderLineListFilterKeys {
  orderCreated = "orderCreated",
  orderSearch = "orderSearch",
  userSearch = "userSearch",
  brandStoreSearch = "brandStoreSearch",
  brandProductSearch = "brandProductSearch",
  fulfillVendorSearch = "fulfillVendorSearch",
  isFulfilledByVendor = "isFulfilledByVendor",
  chargeStatus = "chargeStatus",
  payMethod = "payMethod",
}

export interface HqOrderLineListFilterOpts {
  orderCreated: FilterOpts<MinMax>;
  orderSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  fulfillVendorSearch: FilterOpts<string>;
  isFulfilledByVendor: FilterOpts<boolean>;
  chargeStatus: FilterOpts<OrderChargeStatusFilter[]>;
  payMethod: FilterOpts<OrderPayMethodFilter[]>;
}

export function createFilterStructure(
  opts: HqOrderLineListFilterOpts,
  brand: User_brand
): IFilter<HqOrderLineListFilterKeys> {
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);

  const orderCreatedFilter = {
    ...createDateField(0, HqOrderLineListFilterKeys.orderCreated, "주문일", opts.orderCreated.value),
    active: opts.orderCreated.active,
  };
  const orderSearchFilter = {
    ...createTextField(
      0,
      HqOrderLineListFilterKeys.orderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const fulfillVendorSearchFilter = {
    ...createTextField(0, HqOrderLineListFilterKeys.fulfillVendorSearch, "협력사명", opts.fulfillVendorSearch.value),
    active: opts.fulfillVendorSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      0,
      HqOrderLineListFilterKeys.brandStoreSearch,
      filterNameConstant.BRAND_STORE_SEARCH,
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(0, HqOrderLineListFilterKeys.userSearch, filterNameConstant.USER_SEARCH, opts.userSearch.value),
    active: opts.userSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      0,
      HqOrderLineListFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const chargeStatusFilter = {
    ...createOptionsField(0, HqOrderLineListFilterKeys.chargeStatus, "결제 상태", opts.chargeStatus.value, true, [
      {
        label: "결제 대기",
        value: OrderChargeStatusFilter.PENDING,
      },
      {
        label: "결제 완료",
        value: OrderChargeStatusFilter.CHARGED,
      },
      {
        label: "일부 환불",
        value: OrderChargeStatusFilter.PARTIALLY_REFUNDED,
      },
      {
        label: "전액 환불",
        value: OrderChargeStatusFilter.FULLY_REFUNDED,
      },
    ]),
    active: opts.chargeStatus.active,
  };
  const payMethodFilter = {
    ...createOptionsField(0, HqOrderLineListFilterKeys.payMethod, "결제방식", opts.payMethod.value, true, [
      {
        label: "카드 (보스페이)",
        value: OrderPayMethodFilter.IS_TOSS_RIU_CARD_PAY,
      },
      {
        label: "카드 (일반)",
        value: OrderPayMethodFilter.IS_NORMAL_CARD_PAY,
      },
      {
        label: "가상계좌",
        value: OrderPayMethodFilter.IS_VBANK_PAY,
      },
      {
        label: "충전금",
        value: OrderPayMethodFilter.IS_CREDITS_PAY,
      },
      {
        label: "포인트",
        value: OrderPayMethodFilter.IS_RCOIN_PAY,
      },
    ]),
    active: opts.payMethod.active,
  };

  const filterStructure = [
    orderCreatedFilter,
    orderSearchFilter,
    enableForFbvService && fulfillVendorSearchFilter,
    brandStoreSearchFilter,
    userSearchFilter,
    brandProductSearchFilter,
    chargeStatusFilter,
    payMethodFilter,
  ];
  return utils.filterDisplayOrdering(filterStructure.filter(Boolean));
}
