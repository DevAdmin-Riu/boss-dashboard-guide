const HQ_PRE_FOUNDER_FILTERS_KEY = "hqPreFounderFilters";

export function getFilterOpts(params: HqPreFounderListViewUrlFilters): HqPreFounderListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    birthDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.birthDate.gte, filterVariables.birthDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.birthDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.birthDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    firstConsultationDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.firstConsultationDate.gte, filterVariables.firstConsultationDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.firstConsultationDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.firstConsultationDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    lastConsultationDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.lastConsultationDate.gte, filterVariables.lastConsultationDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.lastConsultationDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.lastConsultationDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    evalTotalScore: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.evalTotalScore.gte, filterVariables.evalTotalScore.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.evalTotalScore.lte.toString(), (5).toString()),
        min: maybe(() => filterVariables.evalTotalScore.gte.toString(), (0).toString()),
      },
    },
    preFounderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.preFounderSearch, true), false),
      value: filterVariables.preFounderSearch || "",
    },
    firstConsultationUserSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.firstConsultationUserSearch, true), false),
      value: filterVariables.firstConsultationUserSearch || "",
    },
    lastConsultationUserSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.lastConsultationUserSearch, true), false),
      value: filterVariables.lastConsultationUserSearch || "",
    },
    gender: {
      active: maybe(() => !utils.isEmpty(filterVariables.gender, true), false),
      value: maybe(() => filterVariables.gender),
    },
    desiredRegion: {
      active: maybe(() => !utils.isEmpty(filterVariables.desiredRegion, true), false),
      value: maybe(() => filterVariables.desiredRegion, []),
    },
    leadSource: {
      active: maybe(() => !utils.isEmpty(filterVariables.leadSource, true), false),
      value: maybe(() => dedupeFilter(filterVariables.leadSource), []),
    },
    evalStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.evalStatus, true), false),
      value: maybe(() => dedupeFilter(filterVariables.evalStatus), []),
    },
    lastConsultationResult: {
      active: maybe(() => !utils.isEmpty(filterVariables.lastConsultationResult, true), false),
      value: maybe(() => dedupeFilter(filterVariables.lastConsultationResult), []),
    },
  };
}

export function getFilterVariables(params: HqPreFounderListViewUrlFilters): PreFounderFilterInput {
  return {
    created: getGteLteVariables({
      lte: params.createdTo,
      gte: params.createdFrom,
    }),
    birthDate: getGteLteVariables({
      lte: params.birthDateTo,
      gte: params.birthDateFrom,
    }),
    firstConsultationDate: getGteLteVariables({
      lte: params.firstConsultationDateTo,
      gte: params.firstConsultationDateFrom,
    }),
    lastConsultationDate: getGteLteVariables({
      lte: params.lastConsultationDateTo,
      gte: params.lastConsultationDateFrom,
    }),
    evalTotalScore: getGteLteVariables({
      lte: utils.convertToNumber(params.evalTotalScoreTo),
      gte: utils.convertToNumber(params.evalTotalScoreFrom),
    }),
    preFounderSearch: params.preFounderSearch,
    firstConsultationUserSearch: params.firstConsultationUserSearch,
    lastConsultationUserSearch: params.lastConsultationUserSearch,
    gender: maybe(() => findInEnum(params.gender, GenderTypeEnum), undefined),
    desiredRegion: maybe(() => params.desiredRegion, undefined),
    leadSource: maybe(() => params.leadSource.map((item) => findInEnum(item, PreFounderLeadSourceEnum)), undefined),
    evalStatus: maybe(() => params.evalStatus.map((item) => findInEnum(item, PreFounderEvalStatusEnum)), undefined),
    lastConsultationResult: maybe(
      () => params.lastConsultationResult.map((item) => findInEnum(item, PreFounderConsultationResultEnum)),
      undefined
    ),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof HqPreFounderListFilterOpts>
): HqPreFounderListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case HqPreFounderListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersEnum.createdFrom,
        HqPreFounderListViewUrlFiltersEnum.createdTo
      );
    case HqPreFounderListFilterKeys.birthDate:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersEnum.birthDateFrom,
        HqPreFounderListViewUrlFiltersEnum.birthDateTo
      );
    case HqPreFounderListFilterKeys.firstConsultationDate:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersEnum.firstConsultationDateFrom,
        HqPreFounderListViewUrlFiltersEnum.firstConsultationDateTo
      );
    case HqPreFounderListFilterKeys.lastConsultationDate:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersEnum.lastConsultationDateFrom,
        HqPreFounderListViewUrlFiltersEnum.lastConsultationDateTo
      );
    case HqPreFounderListFilterKeys.evalTotalScore:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersEnum.evalTotalScoreFrom,
        HqPreFounderListViewUrlFiltersEnum.evalTotalScoreTo
      );
    case HqPreFounderListFilterKeys.preFounderSearch:
      return getSingleValueQueryParam(filter, HqPreFounderListViewUrlFiltersEnum.preFounderSearch);
    case HqPreFounderListFilterKeys.firstConsultationUserSearch:
      return getSingleValueQueryParam(filter, HqPreFounderListViewUrlFiltersEnum.firstConsultationUserSearch);
    case HqPreFounderListFilterKeys.lastConsultationUserSearch:
      return getSingleValueQueryParam(filter, HqPreFounderListViewUrlFiltersEnum.lastConsultationUserSearch);
    case HqPreFounderListFilterKeys.gender:
      return getSingleValueQueryParam(filter, HqPreFounderListViewUrlFiltersEnum.gender);
    case HqPreFounderListFilterKeys.desiredRegion:
      return getMultipleValueQueryParam(filter, HqPreFounderListViewUrlFiltersWithMultipleValuesEnum.desiredRegion);
    case HqPreFounderListFilterKeys.leadSource:
      return getMultipleEnumValueQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersWithMultipleValuesEnum.leadSource,
        PreFounderLeadSourceEnum
      );
    case HqPreFounderListFilterKeys.evalStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersWithMultipleValuesEnum.evalStatus,
        PreFounderEvalStatusEnum
      );
    case HqPreFounderListFilterKeys.lastConsultationResult:
      return getMultipleEnumValueQueryParam(
        filter,
        HqPreFounderListViewUrlFiltersWithMultipleValuesEnum.lastConsultationResult,
        PreFounderConsultationResultEnum
      );
  }
}

