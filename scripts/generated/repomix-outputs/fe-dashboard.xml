import { BoxSizeTypeEnum, CouriersDeliveryFeeFilterInput, OrderTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { ShippingHistoryFilterKeys } from "../../components/ShippingHistoryListPage/filter";
import {
  ShippingHistoryListViewUrlFilters,
  ShippingHistoryListViewUrlFiltersEnum,
  ShippingHistoryListViewUrlFiltersWithMultipleValuesEnum,
  ShippingHistoryListViewUrlQueryParams,
} from "../../urls";

const SHIPPING_INFO_HISTORY_FILTERS_KEY = "shippingInfoHistory";

export function getFilterOpts(params: ShippingHistoryListViewUrlFilters) {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: filterVariables.orderSearch || "",
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    collectedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.collectedAt.gte, filterVariables.collectedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.collectedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.collectedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    boxSizeType: {
      active: maybe(() => !utils.isEmpty(filterVariables.boxSizeType), false),
      value: maybe(
        () => dedupeFilter(filterVariables.boxSizeType.map((status) => findValueInEnum(status, BoxSizeTypeEnum))),
        []
      ),
    },
    trackingNumber: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackingNumber, true), false),
      value: maybe(() => filterVariables.trackingNumber, ""),
    },
    isReturn: {
      active: maybe(() => params.isReturn !== undefined, false),
      value: maybe(() => parseBoolean(params.isReturn, true)),
    },
    orderType: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderType), false),
      value: maybe(
        () => dedupeFilter(filterVariables.orderType.map((typeStatus) => findValueInEnum(typeStatus, OrderTypeEnum))),
        [OrderTypeEnum.BY_USER]
      ),
    },
  };
}

export function getFilterVariables(params: ShippingHistoryListViewUrlFilters): CouriersDeliveryFeeFilterInput {
  return {
    orderSearch: params.orderSearch,
    productSearch: params.productSearch,
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    collectedAt: getGteLteVariables({
      gte: params.collectedAtFrom,
      lte: params.collectedAtTo,
    }),
    boxSizeType: maybe(() => params.boxSizeType.map((status) => findInEnum(status, BoxSizeTypeEnum))),
    trackingNumber: params.trackingNumber,
    isReturn: params.isReturn !== undefined ? parseBoolean(params.isReturn, false) : undefined,
    orderType: maybe(() => params.orderType.map((status) => findInEnum(status, OrderTypeEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ShippingHistoryFilterKeys>
): ShippingHistoryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case ShippingHistoryFilterKeys.boxSizeType:
      return getMultipleEnumValueQueryParam(
        filter,
        ShippingHistoryListViewUrlFiltersWithMultipleValuesEnum.boxSizeType,
        BoxSizeTypeEnum
      );
    case ShippingHistoryFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, ShippingHistoryListViewUrlFiltersEnum.orderSearch);
    case ShippingHistoryFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        ShippingHistoryListViewUrlFiltersEnum.createdFrom,
        ShippingHistoryListViewUrlFiltersEnum.createdTo
      );
    case ShippingHistoryFilterKeys.collectedAt:
      return getMinMaxQueryParam(
        filter,
        ShippingHistoryListViewUrlFiltersEnum.collectedAtFrom,
        ShippingHistoryListViewUrlFiltersEnum.collectedAtTo
      );
    case ShippingHistoryFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ShippingHistoryListViewUrlFiltersEnum.productSearch);
    case ShippingHistoryFilterKeys.trackingNumber:
      return getSingleValueQueryParam(filter, ShippingHistoryListViewUrlFiltersEnum.trackingNumber);
    case ShippingHistoryFilterKeys.isReturn:
      return getSingleValueQueryParam(filter, ShippingHistoryListViewUrlFiltersEnum.isReturn);
    case ShippingHistoryFilterKeys.orderType:
      return getMultipleEnumValueQueryParam(
        filter,
        ShippingHistoryListViewUrlFiltersWithMultipleValuesEnum.orderType,
        OrderTypeEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<ShippingHistoryListViewUrlFilters>(SHIPPING_INFO_HISTORY_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ShippingHistoryListViewUrlQueryParams,
  ShippingHistoryListViewUrlFilters
>({
  ...ShippingHistoryListViewUrlFiltersEnum,
  ...ShippingHistoryListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

<file path="src/app/views/order/shipping/views/ShippingHistoryListView/ShippingHistoryListView.tsx">
import ConfirmModal from "@src/app/components/ConfirmModal";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import axios from "axios";
import React from "react";

import { orderDetailsViewUrl } from "../../../orders/urls";
import { useCouriersDeliveryFeesDownloadQuery, useCouriersDeliveryFeesQuery } from "../../api/queries";
import ShippingHistoryListPage from "../../components/ShippingHistoryListPage/ShippingHistoryListPage";
import {
  shippingHistoryListViewUrl,
  ShippingHistoryListViewUrlDialog,
  ShippingHistoryListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filter";

interface ShippingHistoryViewProps {
  params: ShippingHistoryListViewUrlQueryParams;
}

enum ShippingHistoryListModalModeEnum {
  ReturnCancel = "ReturnCancel",
}

const ShippingHistoryListView: React.FC<ShippingHistoryViewProps> = (props) => {
  const { params } = props;
  const shop = useShop();
  const targetUrl = shippingHistoryListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.SHIPPING_INFO_HISTORY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useCouriersDeliveryFeesDownloadQuery);

  const [courierId, setCourierId] = React.useState<string | null>(null);
  const [transUniqueId, setTransUniqueId] = React.useState<string | null>(null);
  const [modalMode, setModalMode] = React.useState<ShippingHistoryListModalModeEnum>(null);
  const resetForCloseModal = () => {
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: ShippingHistoryListModalModeEnum) => {
    setModalMode(modalMode);
  };

  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: getFilterVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useCouriersDeliveryFeesQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.couriersDeliveryFees?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<ShippingHistoryListViewUrlDialog, ShippingHistoryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const filterOpts = getFilterOpts(params);

  const requestCancelReturn = async ({ id, transUniqueCd }) => {
    const requestUrl =
      (shop?.goodsflowPluginConfig || []).find(({ field }) => field === "request_return_cancel_url")?.value || "";

    const params = {
      id,
      transUniqueCd,
    };

    await axios
      .post(`${requestUrl}`, params)
      .then((resolve) => {
        const { data } = resolve;
        if (data.success === false) {
          const error = data.error;
          showNotificationError(error.message);
        } else {
          showNotificationSuccess("반품 신청이 정상적으로 취소되었습니다.");
          refetch();
          resetForCloseModal();
        }
      })
      .catch((error) => {
        showNotificationError(error.message);
      });
  };

  return (
    <>
      <ShippingHistoryListPage
        settings={settings}
        dataSource={data?.couriersDeliveryFees.edges.map((edge) => edge.node)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        pageInfo={pageInfo}
        disabled={loading}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        currentTab={currentTab}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        fetchForDownload={fetchForDownload}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        requestCancelReturn={requestCancelReturn}
        onReturnCancel={(id, transUniqueCd) => {
          openModalWithoutNavigate(ShippingHistoryListModalModeEnum.ReturnCancel);
          setCourierId(id);
          setTransUniqueId(transUniqueCd);
        }}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <ConfirmModal
        visible={modalMode === ShippingHistoryListModalModeEnum.ReturnCancel}
        modalTitleText={"반품 취소 여부 확인"}
        contentNode={"반품 신청을 취소하시겠습니까?"}
        onOk={async () => {
          await requestCancelReturn({
            id: courierId,
            transUniqueCd: transUniqueId,
          });
        }}
        onCancel={() => {
          resetForCloseModal();
          setCourierId(null);
          setTransUniqueId(null);
        }}
      />
    </>
  );
};

export default ShippingHistoryListView;
</file>

<file path="src/app/views/order/shipping/views/ShippingStatisticsView/filter.ts">
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  ShippingStatisticsFilterKeys,
  ShippingStatisticsFilterOpts,
  ShippingStatisticsListFilterVariables,
} from "../../components/ShippingStatisticsPage/filter";
import {
  ShippingStatisticsViewUrlFilters,
  ShippingStatisticsViewUrlFiltersEnum,
  ShippingStatisticsViewUrlQueryParams,
} from "../../urls";

const SHIPPING_INFO_STATISTICS_FILTERS_KEY = "shippingInfoStatistics";

export const getFilterOpts = (params: ShippingStatisticsViewUrlFilters): ShippingStatisticsFilterOpts => {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  return {
    collectedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.collectedAt.gte, filterVariables.collectedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.collectedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.collectedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
  };
};

export const getFilterVariables = (
  params: ShippingStatisticsViewUrlFilters
): ShippingStatisticsListFilterVariables => ({
  collectedAt: getGteLteVariablesForMonth({ gte: params.collectedAtFrom, lte: params.collectedAtTo }),
});

export const getFilterQueryParam = (
  filter: IFilterElement<keyof ShippingStatisticsFilterOpts>
): ShippingStatisticsViewUrlFilters => {
  const { name } = filter;
  switch (name) {
    case ShippingStatisticsFilterKeys.collectedAt:
      return getMinMaxQueryParam(
        filter,
        ShippingStatisticsViewUrlFiltersEnum.collectedAtFrom,
        ShippingStatisticsViewUrlFiltersEnum.collectedAtTo
      );
  }
};

export const { deleteFilterTab, getFilterTabs, saveFilterTab } = createFilterTabUtils<ShippingStatisticsViewUrlFilters>(
  SHIPPING_INFO_STATISTICS_FILTERS_KEY
);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ShippingStatisticsViewUrlQueryParams,
  ShippingStatisticsViewUrlFilters
>({
  ...ShippingStatisticsViewUrlFiltersEnum,
});
</file>

