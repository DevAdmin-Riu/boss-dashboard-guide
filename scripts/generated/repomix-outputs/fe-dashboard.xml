<file path="src/app/views/settings/dashboardCustomMenu/components/DashboardCustomMenuPage/DashboardCustomMenuPage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import AppHeader from "@src/app/components/AppHeader";
import { createStaffMenuStructure, IMenuItem } from "@src/app/components/AppLayout/menuStructureStaff";
import CardSpacer from "@src/app/components/CardSpacer";
import { IRootState } from "@src/global/redux/config/configStore";
import { isCustomMenuChangeFlagChange } from "@src/global/redux/store/common.store";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, PageHeader, Row, Space, Switch, Typography } from "antd";
import React from "react";
import { useDispatch, useSelector } from "react-redux";

export interface ICustomMenuItem extends IMenuItem {
  show: boolean;
  children?: ICustomMenuItem[];
}

export const getCustomMenuItems = (): ICustomMenuItem[] => {
  const customMenu = localStorage.getItem("customMenu");
  if (utils.isEmpty(customMenu) || customMenu === "undefined") {
    return [];
  }
  return JSON.parse(customMenu);
};

interface DashboardCustomMenuPageProps {
  onBack: () => void;
}

enum MenuDepth {
  ONE = "one",
  TWO = "two",
}

const DashboardCustomMenuPage: React.FC<DashboardCustomMenuPageProps> = (props) => {
  const { onBack } = props;
  const { user } = useUser();
  const [isMenuChange, setIsMenuChange] = React.useState(false);
  const [form] = Form.useForm();
  const staffMenu = createStaffMenuStructure(user);
  const customMenu = localStorage.getItem("customMenu");
  const isLocalStorageData = utils.isEmpty(customMenu) === false && customMenu !== "undefined";
  const customMenuItems = getCustomMenuItems();
  const dispatchRedux = useDispatch();
  const isCustomMenuChangeFlag = useSelector<IRootState, boolean>((state) => state.common.isCustomMenuChangeFlag);

  const fixedMenuAriaLabelList: string[] = ["home"];

  const initFilterCustomMenu = (status: null | boolean): ICustomMenuItem[] =>
    staffMenu.reduce((acc, cur, parentIdx) => {
      const parentAriaLabel = cur.ariaLabel;
      const parseCustomMenuParentAriaLabel = customMenuItems ? customMenuItems[parentIdx]?.ariaLabel : undefined;
      if (parentAriaLabel !== parseCustomMenuParentAriaLabel) {
        setIsMenuChange(true);
      }
      acc.push({
        ...cur,
        ariaLabel: cur.ariaLabel,
        show:
          status === null
            ? isLocalStorageData === false
              ? true
              : customMenuItems[parentIdx]?.show !== undefined
              ? customMenuItems[parentIdx].show
              : true
            : status,
        children: cur?.children?.map((child, childIdx) => {
          const childAriaLabel = child.ariaLabel;
          const parseCustomMenuChildAriaLabel = customMenuItems
            ? customMenuItems[parentIdx]?.children[childIdx]?.ariaLabel
            : undefined;
          if (childAriaLabel !== parseCustomMenuChildAriaLabel) {
            setIsMenuChange(true);
          }
          return {
            ...cur.children[childIdx],
            ariaLabel: child.ariaLabel,
            show:
              status === null
                ? isLocalStorageData === false
                  ? true
                  : customMenuItems[parentIdx]?.children.find((localChild) => localChild.ariaLabel === child.ariaLabel)
                      ?.show !== undefined
                  ? customMenuItems[parentIdx].children.find((localChild) => localChild.ariaLabel === child.ariaLabel)
                      .show
                  : true
                : status,
          };
        }),
      });

      if (status !== null) {
        form.setFieldValue(cur.ariaLabel, status);
        cur?.children?.forEach((child) => {
          form.setFieldValue(child.ariaLabel, status);
        });
      }
      return acc;
    }, []);

  // 초기 값
  if (isLocalStorageData === false || isMenuChange) {
    setIsMenuChange(false);
    localStorage.setItem("customMenu", JSON.stringify(initFilterCustomMenu(null)));
  }

  const onAllChange = ({ checked, oneFindIdx }) => {
    const parent = customMenuItems[oneFindIdx];
    parent.show = checked;
    form.setFieldValue(parent.ariaLabel, checked);

    parent.children.forEach((child) => {
      child.show = checked;
      form.setFieldValue(child.ariaLabel, checked);
    });

    changeData(customMenuItems);
  };

  const onChange = (checked: boolean, event) => {
    const target = event.currentTarget;
    const dataset = target.dataset;
    const datasetDepth = dataset.depth;
    const datasetOneFindIdx = Number(dataset.oneFindIdx);
    const datasetTwoFindIdx = Number(dataset.twoFindIdx);

    if (
      (datasetDepth === MenuDepth.ONE && customMenuItems[datasetOneFindIdx]?.show === undefined) ||
      (datasetDepth === MenuDepth.TWO &&
        datasetTwoFindIdx !== undefined &&
        customMenuItems[datasetOneFindIdx].children[datasetTwoFindIdx]?.show === undefined)
    ) {
      const newData = initFilterCustomMenu(null);
      changeData(newData);

      return;
    }

    if (datasetDepth === MenuDepth.ONE) {
      customMenuItems[datasetOneFindIdx].show = checked;
    } else if (datasetDepth === MenuDepth.TWO) {
      customMenuItems[datasetOneFindIdx].children[datasetTwoFindIdx].show = checked;
      childrenIsAllHide(customMenuItems, datasetOneFindIdx);
    }

    changeData(customMenuItems);
  };

  const changeData = (changeCustomMenu) => {
    localStorage.setItem("customMenu", JSON.stringify(changeCustomMenu));
    dispatchRedux(isCustomMenuChangeFlagChange(!isCustomMenuChangeFlag));
  };

  /**
   * 하위 메뉴가 모두 숨겨진 경우 상위 메뉴도 숨김 처리
   * @param datasetOneFindIdx number
   */
  const childrenIsAllHide = (nowData, datasetOneFindIdx) => {
    const isAllHide = nowData[datasetOneFindIdx]?.children?.every((child) => child.show === false);
    if (isAllHide) {
      nowData[datasetOneFindIdx].show = false;
      form.setFieldValue(nowData[datasetOneFindIdx].ariaLabel, false);
    }
  };

  const allHideMenu = () => {
    const changeCustomMenu = initFilterCustomMenu(false);
    changeData(changeCustomMenu);
  };

  const allShowMenu = () => {
    const changeCustomMenu = initFilterCustomMenu(true);
    changeData(changeCustomMenu);
  };

  // eslint-disable-next-line @typescript-eslint/no-empty-function
  React.useEffect(() => {}, [isCustomMenuChangeFlag]);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.configuration}</AppHeader>
      <PageHeader
        title={sectionNames.dashboardCustomMenu}
        extra={
          <>
            <Button type="primary" onClick={allShowMenu}>
              전체 보기
            </Button>
            <Button type="primary" onClick={allHideMenu} danger>
              전체 숨기기
            </Button>
          </>
        }
      />

      <CardSpacer />
      <Form form={form}>
        <Row gutter={[16, 16]}>
          {initFilterCustomMenu(null).map((menu, parentIdx) => (
            <React.Fragment key={menu.ariaLabel}>
              {fixedMenuAriaLabelList.includes(menu.ariaLabel) === false && (
                <Col span={12} xs={24} key={menu.ariaLabel}>
                  <Card
                    title={
                      <>
                        <Space align="center">
                          <Typography.Text strong style={{ fontSize: 15, display: "block" }}>
                            <menu.icon style={{ marginRight: 5 }} />
                            {menu.label}
                          </Typography.Text>
                          <Form.Item name={menu.ariaLabel} valuePropName="checked" style={{ margin: 0 }}>
                            <Switch
                              checkedChildren="보기"
                              unCheckedChildren="숨기기"
                              defaultChecked={menu.show}
                              onChange={onChange}
                              data-label={menu.ariaLabel}
                              data-depth={MenuDepth.ONE}
                              data-one-find-idx={parentIdx}
                            />
                          </Form.Item>
                        </Space>
                      </>
                    }
                    extra={
                      <Space>
                        <Button type="primary" onClick={(e) => onAllChange({ checked: true, oneFindIdx: parentIdx })}>
                          {menu.label} 전체 보기
                        </Button>
                        <Button
                          type="primary"
                          danger
                          onClick={() => onAllChange({ checked: false, oneFindIdx: parentIdx })}
                        >
                          {menu.label} 전체 숨기기
                        </Button>
                      </Space>
                    }
                  >
                    {menu?.children?.length > 0 && (
                      <Row gutter={[8, 8]}>
                        {menu?.children.map((child, childIdx) => (
                          <Col span={6} key={child.ariaLabel}>
                            <Row
                              justify={"space-between"}
                              style={{
                                padding: 8,
                                boxSizing: "border-box",
                                border: "1px solid #ddd",
                                borderRadius: 10,
                                alignItems: "center",
                              }}
                            >
                              <Col>
                                <Typography.Text strong style={{ fontSize: 15, display: "block" }}>
                                  {child.label}
                                </Typography.Text>
                              </Col>
                              <Col>
                                <Form.Item name={child.ariaLabel} valuePropName="checked" style={{ margin: 0 }}>
                                  <Switch
                                    checkedChildren="보기"
                                    unCheckedChildren="숨기기"
                                    defaultChecked={child.show}
                                    onChange={onChange}
                                    data-label={child.ariaLabel}
                                    data-depth={MenuDepth.TWO}
                                    data-one-find-idx={parentIdx}
                                    data-two-find-idx={childIdx}
                                  />
                                </Form.Item>
                              </Col>
                            </Row>
                          </Col>
                        ))}
                      </Row>
                    )}
                  </Card>
                </Col>
              )}
            </React.Fragment>
          ))}
        </Row>
      </Form>
    </>
  );
};

