import { Pie } from "@ant-design/charts";
import { DownloadOutlined } from "@ant-design/icons";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CardSpacer from "@src/app/components/CardSpacer";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { useBrandProductStats } from "@src/app/views/hqStaff/hqSection/api/queries";
import {
  makeProductStatsChartConfig,
  makeProductStatsForExclusiveRateChartConfig,
} from "@src/app/views/hqStaff/hqSection/utils/productChartConfig";
import { StatsQueryMaxLimitEnum } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { commonErrorMsg } from "@src/global/assets/messages/errors/commonError";
import { statsDateType, statsValueType } from "@utils/chart";
import { excelDownload } from "@utils/excel/excelDownload";
import { getGteLteVariables } from "@utils/filters";
import { checkHqStaff, getBrandId } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, PageHeader, Row, Space, Table, Typography } from "antd";
import React, { useState } from "react";

import { BrandProductStatsVariables } from "../../api/types/BrandProductStats";
import HqStatsSelectDuration from "../HqStatsSelectDuration/HqStatsSelectDuration";
import { getDateRange } from "../HqStatsSelectDuration/utils";
import { getHqStatsProductTableSettings } from "./HqStatsProductTableSettings";
import { getProductStatsForTable, parseProductStats } from "./utils";

export interface HqStatsProductProps {
  title: string;
}

const HqStatsProduct: React.FC<HqStatsProductProps> = (props) => {
  const { title } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const [loading, setLoading] = useState(false);
  const [dateType, setDateType] = useState<statsDateType>(statsDateType.DAILY);
  const [selectedDuration, setSelectedDuration] = useState(getDateRange(0, "days"));
  const { user } = useUser();
  const isHqStaff = checkHqStaff(user);
  if (!isHqStaff) {
    return null;
  }
  const brandId = getBrandId(user);

  const queryVariables: BrandProductStatsVariables = React.useMemo(
    () => ({
      id: brandId,
      statDate: getGteLteVariables({
        gte: selectedDuration[0].format(onlyDateFormat),
        lte: selectedDuration[1].format(onlyDateFormat),
      }),
      first: StatsQueryMaxLimitEnum.brandProductStats,
    }),
    [selectedDuration]
  );

  const {
    data: productsStats,
    loading: productsStatsLoading,
    refetch: refetchForBrandProductStats,
  } = useBrandProductStats({ variables: queryVariables });
  const brandProductStats = productsStats?.brandProductStats || [];
  const brandProductStatsToDisplayTop10 = brandProductStats.slice(0, 10);

  const makeExtraUi = () => (
    <Button
      loading={loading}
      type="primary"
      shape="round"
      icon={<DownloadOutlined />}
      onClick={() => {
        setLoading(true);
        showDownloadingMessage();
        refetchForBrandProductStats(queryVariables)
          .then((res) => {
            const { columns, header, merges } = parseProductStats(res);
            if (!columns || columns.length <= 0) {
              showNotificationWarn("출력할 데이터가 없습니다.");
              return;
            }
            excelDownload({ title: "상품별 현황 정보", columns, header, merges });
            if (res?.data?.brandProductStats?.length === StatsQueryMaxLimitEnum.brandProductStats) {
              showNotificationWarn(commonErrorMsg.maxLimitIssue);
            } else {
              showNotificationSuccess(commonMsg.downloadedToXls);
            }
          })
          .catch((e) => {
            showNotificationError("에러가 발생하였습니다");
            throw e;
          })
          .finally(() => {
            setLoading(false);
            destroyDownloadingMessage();
          });
      }}
    >
      통계 자료 다운로드
    </Button>
  );

  const columns = getHqStatsProductTableSettings(user?.brand);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <PageHeader title={<Typography.Title level={4}>{title}</Typography.Title>} extra={makeExtraUi()} />
      <CardSpacer />
      <HqStatsSelectDuration
        dateType={dateType}
        setDateType={setDateType}
        selectedDuration={selectedDuration}
        setSelectedDuration={setSelectedDuration}
        getDateRange={getDateRange}
        disabledSelectDateType={true}
      />
      <CardSpacer />
      {!productsStatsLoading && (
        <>
          <Space direction="vertical" size={32}>
            <Row justify="space-evenly" gutter={32}>
              <Col xs={0} sm={0} md={12}>
                <Card title="판매총액 TOP 10">
                  <Pie
                    {...makeProductStatsChartConfig(
                      getProductStatsForTable(brandProductStatsToDisplayTop10),
                      statsValueType.TOTAL_PRICE
                    )}
                  />
                </Card>
              </Col>
              <Col xs={0} sm={0} md={12}>
                <Card title="상품 유형">
                  <Pie {...makeProductStatsForExclusiveRateChartConfig(brandProductStats)} />
                </Card>
              </Col>
            </Row>
            <Card>
              <TableVatLegend isIncludeVat={false} />
              <Table
                {...commonTableProps}
                ref={tableRef}
                rowKey={(record) => record.bpSku}
                columns={columns}
                dataSource={productsStats?.brandProductStats}
                scroll={{ x: tableWidthSum, y: tableScrollY }}
              />
            </Card>
          </Space>
        </>
      )}
    </>
  );
};
export default HqStatsProduct;
</file>

