  saveFilterTab,
} from "./filters";

interface DigitalContractCountEventListViewProps {
  params: DigitalContractCountEventListViewUrlQueryParams;
}

export const DigitalContractCountEventListView: React.FC<DigitalContractCountEventListViewProps> = ({ params }) => {
  const { user } = useAuth();

  const targetUrl = (params: DigitalContractCountEventListViewUrlQueryParams) =>
    digitalContractCountEventListViewUrl(params);

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PAID_NOTICE_COUNT_EVENT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useDigitalContractCountEventListFilterDownloadQuery);

  const queryVariables: DigitalContractCountEventsVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params, user) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useDigitalContractCountEventListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.digitalContractCountEvents?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    DigitalContractCountEventListViewUrlDialog,
    DigitalContractCountEventListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <DigitalContractCountEventListPage
        settings={settings}
        disabled={loading}
        paidNoticeCountEvents={maybe(() => data.digitalContractCountEvents.edges.map((edge) => edge.node))}
        onRowClick={(brandId) => navigate(brandDetailsViewUrl(brandId))}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, user)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
