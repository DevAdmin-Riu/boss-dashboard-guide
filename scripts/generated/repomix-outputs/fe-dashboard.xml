import { ApolloQueryResult } from "@apollo/client";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import SpreadFilter from "@src/app/components/Filter/SpreadFilter";
import NumberComponent from "@src/app/components/Number";
import { TransferTable } from "@src/app/components/TransferTable";
import {
  ProductVariantListForSearch,
  ProductVariantListForSearch_productVariants_edges_node,
  ProductVariantListForSearchVariables,
} from "@src/app/views/product/products/api/types/ProductVariantListForSearch";
import {
  getSalesUnitTypeText,
  makeProductQtyPerBoxText,
  makeProductSpecTextFromAttr,
} from "@src/app/views/product/products/utils/data";
import { makeIsSafetyTag, makeIsSalesSurgeTag, makeNeedToReorderTag } from "@src/app/views/product/stock/utils";
import { transformTrackInventoryVariantType } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Modal, Space, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useState } from "react";

import { createFilterStructure, getFilterOpts, getProductVariantSearchFilterVariables } from "./filters";

interface AssignProductDialogProps {
  open: boolean;
  productVariants: ProductVariantListForSearch_productVariants_edges_node[];
  loading: boolean;
  initialQueryVariables?: ProductVariantListForSearchVariables;
  refetchProductVariants: (
    variables?: Partial<ProductVariantListForSearchVariables>
  ) => Promise<ApolloQueryResult<ProductVariantListForSearch>>;
  onClose: () => void;
  onSubmit: (data: ProductVariantListForSearch_productVariants_edges_node[]) => void;
}

const PurchaseOrderLineAddModal: React.FC<AssignProductDialogProps> = (props) => {
  const { open, loading, productVariants, initialQueryVariables, refetchProductVariants, onClose, onSubmit } = props;

  const [productVariantsToSubmit, setProductVariantsToSubmit] = useState<
    ProductVariantListForSearch_productVariants_edges_node[]
  >([]);
  const [queryVariables, setQueryVariables] = useState<ProductVariantListForSearchVariables>(initialQueryVariables);

  const handleClose = () => {
    setProductVariantsToSubmit([]);
    setQueryVariables(initialQueryVariables);
    onClose();
  };

  const handleSubmit = () => {
    onSubmit(productVariantsToSubmit);
    handleClose();
  };

  const columns: ColumnsType<ProductVariantListForSearch_productVariants_edges_node> = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.sku,
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 160,
      render: (_, record) => (
        <Typography.Text ellipsis={{ tooltip: record.product?.name }}>{record.product?.name}</Typography.Text>
      ),
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) =>
        utils.isEmpty(record.name, true) ? (
          "-"
        ) : (
          <Typography.Text ellipsis={{ tooltip: record.name }}>{record.name}</Typography.Text>
        ),
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 180,
      render: (_, record) => {
        const spedText = makeProductSpecTextFromAttr(record.product?.attributes);
        return utils.isEmpty(spedText, true) ? (
          "-"
        ) : (
          <Typography.Text ellipsis={{ tooltip: spedText }}>{spedText}</Typography.Text>
        );
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "right",
      width: 90,
      render: (_, record) => makeProductQtyPerBoxText(record),
    },
    {
      title: columnNameConstant.product.TRACK_INVENTORY,
      key: "trackInventoryVariantType",
      align: "center",
      width: 90,
      render: (_, record) => transformTrackInventoryVariantType(record.trackInventory),
    },
    {
      title: columnNameConstant.stock.SAFETY_STOCK_QTY,
      key: "safetyStockQty",
      align: "right",
      width: 90,
      render: (_, record) => <NumberComponent value={record.safetyStockQty} />,
    },
    {
      title: columnNameConstant.stock.SAFETY_STOCK_STATUS,
      key: "isSafety",
      align: "center",
      width: 100,
      render: (_, record) => makeIsSafetyTag(record),
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_7_DAYS],
      key: "needToReorder7",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record, 7),
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_15_DAYS],
      key: "needToReorder15",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record, 15),
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_30_DAYS],
      key: "needToReorder30",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record, 30),
    },
    {
      title: columnNameConstant.stock.NEAR_OUT_OF_STOCK_STATUS,
      key: "isSalesSurge",
      align: "center",
      width: 100,
      render: (_, record) => makeIsSalesSurgeTag(record),
    },
    {
      title: "발주단위",
      key: "salesUnitType",
      align: "center",
      width: 90,
      render: (_, record) => getSalesUnitTypeText(record.salesUnitType),
    },
    {
      title: columnNameConstant.vendor.CODE,
      key: "vendorCode",
      align: "center",
      width: 100,
      render: (_, record) => record.defaultVariantVendor?.vendor?.code || "-",
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendorName",
      align: "left",
      width: 180,
      render: (_, record) => record.defaultVariantVendor?.vendor?.name || "-",
    },
  ];

  const modalFooter = (
    <Space>
      <Button type="default" onClick={handleClose}>
        뒤로
      </Button>
      <Button type="primary" disabled={productVariantsToSubmit.length === 0 || loading} onClick={handleSubmit}>
        제품 추가
      </Button>
    </Space>
  );

  return (
    <Modal
      destroyOnClose
      title="발주 제품 선택"
      open={open}
      onCancel={handleClose}
      footer={modalFooter}
      width={1000}
      maskClosable={false}
    >
      <Space direction="vertical">
        <SpreadFilter
          currencySymbol="원"
          menu={createFilterStructure(getFilterOpts(queryVariables?.filter))}
          onFilterChange={(filters) => {
            const filterVariables = getProductVariantSearchFilterVariables(filters);
            const newQueryVariables = { ...queryVariables, filter: filterVariables };
            setQueryVariables(newQueryVariables);
            refetchProductVariants(newQueryVariables);
          }}
        />
        <TransferTable<ProductVariantListForSearch_productVariants_edges_node>
          loading={loading}
          columns={columns}
          dataSource={productVariants}
          upperTableProps={{
            title: "제품 검색 결과",
            emptyText: "단종되었거나, 협력사 정보가 설정되지 않은 제품은 발주제품으로 추가할 수 없습니다.",
          }}
          lowerTableProps={{ emptyText: "발주제품으로 추가할 제품을 선택하여 추가해주시기 바랍니다." }}
          onChange={(dataSource) => setProductVariantsToSubmit(dataSource)}
        />
      </Space>
    </Modal>
  );
};
export default PurchaseOrderLineAddModal;
</file>

