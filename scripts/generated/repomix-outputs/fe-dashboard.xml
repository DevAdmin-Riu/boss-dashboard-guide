<file path="src/app/views/order/orders/components/OrderListPage/sorters.ts">
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { ISorter } from "@src/app/components/SorterDropdown/types";

import { OrderListViewUrlSortField } from "../../urls";
import { checkOrderedByStaffForBadStock, checkOrderedByStaffForBrand, checkOrderedByUser } from "../../utils";
import { OrderListPageProps } from "./OrderListPage";

export function createSorterStructure(props: OrderListPageProps): ISorter<OrderListViewUrlSortField> {
  let displayOrder = 0;
  const { orderType, isAll } = props;
  const isOrderedByUser = checkOrderedByUser(orderType);
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);

  const orderNumberSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.order.ORDER_COMPOSED_ID,
    sortField: OrderListViewUrlSortField.number,
  };
  const orderCreatedSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.order.ORDER_DATE,
    sortField: OrderListViewUrlSortField.date,
  };
  const brandSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.brand.BRAND_NAME,
    sortField: OrderListViewUrlSortField.brand,
  };
  const customerSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.user.USER_NAME,
    sortField: OrderListViewUrlSortField.customer,
  };
  const paymentSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.order.PAYMENT_STATUS,
    sortField: OrderListViewUrlSortField.payment,
  };
  const totalSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.order.ORDER_TOTAL_AMOUNT,
    sortField: OrderListViewUrlSortField.total,
  };

  if (isOrderedByUser) {
    if (isAll) {
      return [orderNumberSorter, orderCreatedSorter, brandSorter, customerSorter, paymentSorter, totalSorter];
    }
    return [orderNumberSorter, orderCreatedSorter, brandSorter, customerSorter, paymentSorter, totalSorter];
  } else if (isOrderedByStaffForBrand) {
    return [orderNumberSorter, orderCreatedSorter, paymentSorter, totalSorter];
  } else if (isOrderedByStaffForBadStock) {
    return [orderNumberSorter, orderCreatedSorter, paymentSorter, totalSorter];
  }
  return [];
}
</file>

<file path="src/app/views/order/orders/components/OrderPayment/OrderPayment.tsx">
import useNavigator from "@hooks/useNavigator";
import {
  OrderAction,
  OrderStatus,
  PaymentChargeStatusEnum,
  PaymentGatewayTypeEnum,
  RefundQAStatus,
} from "@src/api/types/globalTypes";
import StatusLabel from "@src/app/components/StatusLabel";
import { checkOrderedByStaffForBrand } from "@src/app/views/order/orders/utils";
import { refundQuestionListViewUrl } from "@src/app/views/question/urls";
import { transformPaymentStatus } from "@src/global/assets/messages/status";
import { maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { Button, Card, Col, Row, Skeleton, Space, Typography } from "antd";
import React, { useEffect } from "react";

import { OrderDetails_order, OrderDetails_order_lastPayment } from "../../api/types/OrderDetails";
import { RefundedList_refundedOrderLines_edges_node } from "../../api/types/RefundedList";
import OrderPaymentTable from "./OrderPaymentTable";

interface OrderPaymentProps {
  order: OrderDetails_order;
  refundedList?: RefundedList_refundedOrderLines_edges_node[];
  onRefund: () => void;
  onPaymentStatusChange: () => void;
  isHqStaff: boolean;
}

const openReceiptUrlWindow = (payment: OrderDetails_order_lastPayment, receiptUrl: string) => {
  if (payment.gateway === PaymentGatewayTypeEnum.INICIS) {
    // @ts-ignore: 전역 함수라고 명시
    if (typeof window.showReceipt === "function") {
      // @ts-ignore: 전역 함수라고 명시
      window.showReceipt(
        receiptUrl,
        "4", // inicis 주문번호 (=포장보스 결제번호) 인증 방식
        payment.number
      );
    } else {
      console.error("showReceipt is not available.");
    }
  } else if (payment.gateway === PaymentGatewayTypeEnum.TOSS) {
    window.open(receiptUrl, "_blank", "toolbar=no, menubar=no");
  } else {
    showNotificationError("pg사 설정이 잘못되어있습니다.");
  }
};

const OrderPayment: React.FC<OrderPaymentProps> = (props) => {
  const navigate = useNavigator();
  const { order, refundedList, onRefund, onPaymentStatusChange, isHqStaff } = props;
  const lastPayment = order?.lastPayment;

  // NOTE: 환불 대기 단계 체크
  const refundQuestionCheck =
    order?.refundQA?.filter((item) => item.status === RefundQAStatus.REFUND_PENDING).length > 0;

  // NOTE: 문의 건이 모두 끝난 건인지 확인 (해당 상태면 관리자가 일방적으로 환불해줄 수 있는상태로 변경)
  const refundQuestionAllCloseCheck =
    order?.refundQA?.filter((item) => item.status !== RefundQAStatus.QUESTION_CLOSE).length === 0;

  // NOTE: 검수 단계 체크
  const refundInspectCheck =
    order?.refundQA?.filter((item) => item.status === RefundQAStatus.COLLECTED_INSPECT).length > 0;

  const canRefund =
    maybe(() => order.actions, []).includes(OrderAction.REFUND) && (refundQuestionCheck || refundQuestionAllCloseCheck);
  const paymentStatus = transformPaymentStatus(order);
  const paymentStatusLabel = <Typography.Title level={4}>결제정보: {paymentStatus.localized}</Typography.Title>;

  const orderType = order?.type;
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderPaymentStatusPendingOrBeingApproved =
    order?.paymentStatus === PaymentChargeStatusEnum.PENDING ||
    order?.paymentStatus === PaymentChargeStatusEnum.BEING_APPROVED;
  const isPaymentChangeButtonVisible = isOrderedByStaffForBrand && isOrderPaymentStatusPendingOrBeingApproved;

  const cardActions = [
    <Row justify="end" gutter={16}>
      {maybe(() => order.status) !== OrderStatus.CANCELED && canRefund && order.isForCreditsRefill === false && (
        <Col>
          <>
            {canRefund && refundQuestionCheck && (
              <Button type="primary" onClick={onRefund}>
                상품 환불 처리
              </Button>
            )}
          </>
        </Col>
      )}
      {refundInspectCheck && (
        <Col>
          <Button
            onClick={() => navigate(refundQuestionListViewUrl({ fulfilledBy: "boss", status: "collected-inspect" }))}
            type="primary"
            ghost
          >
            검수 단계 중
          </Button>
        </Col>
      )}
      {isPaymentChangeButtonVisible && (
        <Col>
          <Button onClick={onPaymentStatusChange} type={"primary"}>
            결제 상태 변경
          </Button>
        </Col>
      )}
    </Row>,
  ];

  useEffect(() => {
    const loadScript = (src: string): Promise<void> =>
      new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = src;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(`Script load error: ${src}`);
        document.body.appendChild(script);
      });

    // 순서 중요: jQuery → auth.js
    const loadScripts = async () => {
      try {
        await loadScript("https://iniweb.inicis.com/js/jquery-1.5.1.min.js");
        await loadScript("https://iniweb.inicis.com/js/auth.js");
      } catch (err) {
        console.error(err);
      }
    };

    if (lastPayment?.gateway === PaymentGatewayTypeEnum.INICIS) {
      loadScripts();
    }
  }, [lastPayment]);

  const makeTitleNode = () => {
    if (order?.paymentStatus === undefined) {
      return <Skeleton title paragraph={false} />;
    }
    const receiptUrl = lastPayment?.receiptUrl;
    const statusLabel = <StatusLabel label={paymentStatusLabel} status={paymentStatus.status} />;
    if (receiptUrl) {
      return (
        <Space direction="horizontal" size={"small"}>
          {statusLabel}
          <Button size={"small"} block onClick={() => openReceiptUrlWindow(lastPayment, receiptUrl)}>
            <Typography.Text>전표 출력</Typography.Text>
          </Button>
        </Space>
      );
    }
    return statusLabel;
  };

  return (
    <Card title={makeTitleNode()} actions={!isHqStaff ? cardActions : null}>
      {OrderPaymentTable({ order, refundedList })}
    </Card>
  );
};

export default OrderPayment;
</file>

<file path="src/app/views/order/orders/components/OrderPayment/OrderPaymentTable.tsx">
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { DateTime } from "@src/app/providers/DateProvider";
import { makeCombinePayMethod, transformPaymentGatewayType } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space } from "antd";
import React from "react";

import { OrderDetails_order } from "../../api/types/OrderDetails";
import { RefundedList_refundedOrderLines_edges_node } from "../../api/types/RefundedList";
import { getRefundedListTableSettingsIncludeVat } from "../RefundedListPage/RefundedListTableSettings";
import {
  getOrderPaymentBreakdownTableSettings,
  getOrderPaymentMethodTableSettings,
  getOrderPaymentSummaryTableSettings,
  OrderPaymentBreakdownData,
  OrderPaymentMethodData,
  OrderPaymentSummaryData,
} from "./OrderPaymentTableSettings";

interface OrderPaymentTableProps {
  order: OrderDetails_order;
  refundedList?: RefundedList_refundedOrderLines_edges_node[];
}

const OrderPaymentTable: React.FC<OrderPaymentTableProps> = (props) => {
  const { order, refundedList } = props;
  const { type, lastPayment } = order;

  const paymentMethod = makeCombinePayMethod(lastPayment, type);
  const paymentGatewayName = transformPaymentGatewayType(lastPayment?.gateway);

  const { subtotalDeliveryAdditionalFee, totalReturnDeliveryFee } = order;
  // orderLine별 직접 계산 - 납품 시 확정 금액 제품과 일반 제품 구분
  const prePaymentData = {
    productAmount: 0,
    totalEtcDeliveryFee: 0,
    subtotalDeliveryAdditionalFee: 0,
    totalPaidAmount: 0,
    totalRcoinsAmount: 0,
    totalCashableCreditsAmount: 0,
    totalNonCashableCreditsAmount: 0,
  };

  const confirmPaymentData = {
    productAmount: 0,
    totalEtcDeliveryFee: 0,
    subtotalDeliveryAdditionalFee: 0,
    totalPaidAmount: 0,
    totalRcoinsAmount: 0,
    totalCashableCreditsAmount: 0,
    totalNonCashableCreditsAmount: 0,
  };

  const isAdjustPriceOrder = order.lines.some((line) => line.variant?.isAdjustPrice);

  // 각 orderLine을 순회하여 직접 계산
  order.lines.forEach((line) => {
    // 세트상품의 대표 구성품이 아닌 경우 상품금액 계산에서 제외 (대표 구성품에 세트 전체 가격이 포함됨)
    if (line.isMainPv === false) {
      return;
    }

    // 세트상품인 경우 bundleQty 사용, 아닌 경우 기존 수량 사용
    // 사전 결제 금액 (주문수량 기반)
    const prePaymentQty = line.bundleQty !== null ? line.bundleQty : line.quantity;
    const prePaymentProductAmount = prePaymentQty * line.unitPriceGrossAmount;
    // 확정 결제 금액 (출고수량 기반)
    const confirmPaymentQty = line.bundleQty !== null ? line.bundleQty : line.orderedOrFulfillQty;
    const confirmPaymentProductAmount = confirmPaymentQty * line.unitPriceGrossAmount;

    // 각 line의 기타 배송비
    const lineEtcDeliveryFee = line.etcDeliveryFee || 0;

    prePaymentData.productAmount += prePaymentProductAmount;
    prePaymentData.totalEtcDeliveryFee += lineEtcDeliveryFee;

    confirmPaymentData.productAmount += confirmPaymentProductAmount;
    confirmPaymentData.totalEtcDeliveryFee += lineEtcDeliveryFee;
  });

  // 추가배송비는 prePaymentData와 confirmPaymentData가 동일
  prePaymentData.subtotalDeliveryAdditionalFee = subtotalDeliveryAdditionalFee;
  confirmPaymentData.subtotalDeliveryAdditionalFee = subtotalDeliveryAdditionalFee;

  // 사전 결제 금액의 결제 수단별 금액
  prePaymentData.totalPaidAmount = lastPayment.originAmount;
  prePaymentData.totalRcoinsAmount = lastPayment.originRcoins;
  prePaymentData.totalCashableCreditsAmount = lastPayment.originCashableCredits;
  prePaymentData.totalNonCashableCreditsAmount = lastPayment.originNonCashableCredits;

  // 확정 결제 금액의 결제 수단별 금액
  confirmPaymentData.totalPaidAmount = lastPayment.amount;
  confirmPaymentData.totalRcoinsAmount = lastPayment.rcoins;
  confirmPaymentData.totalCashableCreditsAmount = lastPayment.cashableCredits;
  confirmPaymentData.totalNonCashableCreditsAmount = lastPayment.nonCashableCredits;

  // 결제 항목별 테이블 데이터 구성 - 기존 네이밍 컴벤션 따름
  const paymentBreakdownData: OrderPaymentBreakdownData[] = [];

  // 사전 결제 금액 (주문수량 기반)
  if (isAdjustPriceOrder) {
    paymentBreakdownData.push({
      key: "advance",
      isAdjustPrice: true,
      paymentType: "사전 결제 금액",
      productAmount: prePaymentData.productAmount,
      totalEtcDeliveryFee: prePaymentData.totalEtcDeliveryFee,
      subtotalDeliveryAdditionalFee: prePaymentData.subtotalDeliveryAdditionalFee,
      total:
        prePaymentData.productAmount +
        prePaymentData.totalEtcDeliveryFee +
        prePaymentData.subtotalDeliveryAdditionalFee,
    });
  }

  // 확정 결제 금액 (출고수량 기반)
  paymentBreakdownData.push({
    key: "confirmed",
    isAdjustPrice: false,
    paymentType: "확정 결제 금액",
    productAmount: confirmPaymentData.productAmount,
    totalEtcDeliveryFee: confirmPaymentData.totalEtcDeliveryFee,
    subtotalDeliveryAdditionalFee: confirmPaymentData.subtotalDeliveryAdditionalFee,
    total:
      confirmPaymentData.productAmount +
      confirmPaymentData.totalEtcDeliveryFee +
      confirmPaymentData.subtotalDeliveryAdditionalFee,
  });

  // 테이블 컬럼 설정 가져오기
  const paymentBreakdownColumns = getOrderPaymentBreakdownTableSettings();
  const paymentBreakdownTableWidthSum = utils.calcTableColsWidthSum(paymentBreakdownColumns);

  // 결제 수단별 테이블 데이터 구성 - 기존 네이밍 컴벤션 따름
  const paymentMethodData: OrderPaymentMethodData[] = [];

  // 사전 결제 금액
  if (isAdjustPriceOrder) {
    paymentMethodData.push({
      key: "advance-payment",
      isAdjustPrice: true,
      paymentMethod: "사전 결제 금액",
      totalPaidAmount: prePaymentData.totalPaidAmount,
      totalRcoinsAmount: prePaymentData.totalRcoinsAmount,
      totalCashableCreditsAmount: prePaymentData.totalCashableCreditsAmount,
      totalNonCashableCreditsAmount: prePaymentData.totalNonCashableCreditsAmount,
      total:
        prePaymentData.totalPaidAmount +
        prePaymentData.totalRcoinsAmount +
        prePaymentData.totalCashableCreditsAmount +
        prePaymentData.totalNonCashableCreditsAmount,
    });
  }

  // 확정 결제 금액
  paymentMethodData.push({
    key: "confirmed-payment",
    isAdjustPrice: false,
    paymentMethod: "확정 결제 금액",
    totalPaidAmount: confirmPaymentData.totalPaidAmount,
    totalRcoinsAmount: confirmPaymentData.totalRcoinsAmount,
    totalCashableCreditsAmount: confirmPaymentData.totalCashableCreditsAmount,
    totalNonCashableCreditsAmount: confirmPaymentData.totalNonCashableCreditsAmount,
    total:
      confirmPaymentData.totalPaidAmount +
      confirmPaymentData.totalRcoinsAmount +
      confirmPaymentData.totalCashableCreditsAmount +
      confirmPaymentData.totalNonCashableCreditsAmount,
  });

  const paymentMethodColumns = getOrderPaymentMethodTableSettings();
  const paymentMethodTableWidthSum = utils.calcTableColsWidthSum(paymentMethodColumns);

  // 결제 요약 테이블 데이터 구성
  // 확정 결제 금액 = 결제 수단 테이블의 확정 결제 금액 합계
  const confirmedPaymentAmount = paymentMethodData.find((data) => !data.isAdjustPrice)?.total || 0; // 확정 결제 금액 row의 total

  // 환불 상품 금액 계산 (refundedList의 실제 환불 금액 합계)
  // 세트상품의 대표 구성품이 아닌 경우 제외 (대표 구성품에 세트 전체 환불 금액이 포함됨)
  const refundProductAmount =
    refundedList?.reduce((sum, line) => {
      if (line.orderLine?.isMainPv === false) {
        return sum;
      }
      return sum + Math.abs(line.amount + line.cashableCredits + line.rcoins || 0);
    }, 0) || 0;
  // 최종 결제 금액 = 확정 결제 금액 - 환불 상품 금액
  const finalPaymentAmount = confirmedPaymentAmount - refundProductAmount;

  const paymentSummaryData: OrderPaymentSummaryData[] = [
    {
      key: "payment-summary",
      confirmedPaymentAmount,
      refundProductAmount,
      returnDeliveryFee: totalReturnDeliveryFee,
      finalPaymentAmount,
    },
  ];

  const paymentSummaryColumns = getOrderPaymentSummaryTableSettings();
  const paymentSummaryTableWidthSum = utils.calcTableColsWidthSum(paymentSummaryColumns);

  const columns = getRefundedListTableSettingsIncludeVat({ orderType: type, isFullColumnMode: false });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Space direction="vertical" size="small">
      <Card size="small" bordered extra={<TableVatLegend isIncludeVat={true} />} style={{ marginBottom: 16 }}>
        <Row gutter={[16, 8]}>
          <Col span={8} style={{ textAlign: "center" }}>
            <div style={{ fontSize: "12px", color: "#666", marginBottom: 4 }}>결제방식</div>
            <div style={{ fontWeight: 500 }}>{paymentMethod}</div>
          </Col>
          <Col span={8} style={{ textAlign: "center" }}>
            <div style={{ fontSize: "12px", color: "#666", marginBottom: 4 }}>결제 PG사</div>
            <div style={{ fontWeight: 500 }}>{paymentGatewayName}</div>
          </Col>
          <Col span={8} style={{ textAlign: "center" }}>
            <div style={{ fontSize: "12px", color: "#666", marginBottom: 4 }}>결제일</div>
            <div style={{ fontWeight: 500 }}>
              <DateTime date={order.capturedAt} />
            </div>
          </Col>
        </Row>
      </Card>

      {/* 결제 항목별 상세 테이블 */}
      <PatchedColumnsTable
        {...commonTableProps}
        columns={paymentBreakdownColumns}
        dataSource={paymentBreakdownData}
        pagination={false}
        scroll={{ x: paymentBreakdownTableWidthSum }}
        size="small"
        style={{ marginBottom: 20 }}
      />

      {/* 결제 수단별 상세 테이블 */}
      <PatchedColumnsTable
        {...commonTableProps}
        columns={paymentMethodColumns}
        dataSource={paymentMethodData}
        pagination={false}
        scroll={{ x: paymentMethodTableWidthSum }}
        size="small"
        style={{ marginBottom: 20 }}
      />

      {/* 결제 요약 테이블 */}
      <PatchedColumnsTable
        {...commonTableProps}
        columns={paymentSummaryColumns}
        dataSource={paymentSummaryData}
        pagination={false}
        scroll={{ x: paymentSummaryTableWidthSum }}
        size="small"
        style={{ marginBottom: 20 }}
      />
      {refundedList && refundedList.length > 0 && (
        <PatchedColumnsTable
          {...commonTableProps}
          dataSource={refundedList}
          columns={columns}
          scroll={{ x: tableWidthSum, y: 500 }}
        />
      )}
    </Space>
  );
};

export default OrderPaymentTable;
</file>

<file path="src/app/views/order/orders/components/OrderPayment/OrderPaymentTableSettings.tsx">
import { paymentTerm } from "@assets/messages/commonMsg";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import NumberComponent from "@src/app/components/Number";
import { Typography } from "antd";
import React from "react";

// 결제 항목별 상세 테이블 타입
export interface OrderPaymentBreakdownData {
  key: string;
  isAdjustPrice: boolean;
  paymentType: string;
  productAmount: number;
  totalEtcDeliveryFee: number;
  subtotalDeliveryAdditionalFee: number;
  total: number;
}

// 결제 수단별 상세 테이블 타입
export interface OrderPaymentMethodData {
  key: string;
  isAdjustPrice: boolean;
  paymentMethod: string;
  totalPaidAmount: number;
  totalRcoinsAmount: number;
  totalCashableCreditsAmount: number;
  totalNonCashableCreditsAmount: number;
  total: number;
}

// 결제 요약 테이블 타입
export interface OrderPaymentSummaryData {
  key: string;
  confirmedPaymentAmount: number;
  refundProductAmount: number;
  returnDeliveryFee: number;
  finalPaymentAmount: number;
}

/**
 * 결제 항목별 상세 테이블 설정
 */
export function getOrderPaymentBreakdownTableSettings(): DownloadableColumnsType<OrderPaymentBreakdownData> {
  const paymentTypeColumn: DownloadableColumnType<OrderPaymentBreakdownData> = {
    title: "결제 항목",
    key: "paymentType",
    align: "center",
    width: 120,
    render: (_, record) => (record.isAdjustPrice ? "사전 결제 금액" : "확정 결제 금액"),
  };

  const productAmountColumn: DownloadableColumnType<OrderPaymentBreakdownData> = {
    title: "상품 금액",
    key: "productAmount",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.productAmount} includeCurrency={true} />,
  };

  const deliveryFeeColumn: DownloadableColumnType<OrderPaymentBreakdownData> = {
    title: "기타 배송비",
    key: "totalEtcDeliveryFee",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.totalEtcDeliveryFee} includeCurrency={true} />,
  };

  const deliveryAdditionalFeeColumn: DownloadableColumnType<OrderPaymentBreakdownData> = {
    title: "도서산간 지역 추가 배송비",
    key: "subtotalDeliveryAdditionalFee",
    align: "right",
    width: 140,
    render: (_, record) => <NumberComponent value={record.subtotalDeliveryAdditionalFee} includeCurrency={true} />,
  };

  const totalColumn: DownloadableColumnType<OrderPaymentBreakdownData> = {
    title: "합계",
    key: "total",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.total} includeCurrency={true} />,
  };

  const columns: DownloadableColumnsType<OrderPaymentBreakdownData> = [
    paymentTypeColumn,
    productAmountColumn,
    deliveryFeeColumn,
    deliveryAdditionalFeeColumn,
    totalColumn,
  ];

  return columns.filter(Boolean);
}

/**
 * 결제 수단별 상세 테이블 설정
 */
export function getOrderPaymentMethodTableSettings(): DownloadableColumnsType<OrderPaymentMethodData> {
  const paymentMethodColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: "결제 수단",
    key: "paymentMethod",
    align: "center",
    width: 120,
    render: (_, record) => (record.isAdjustPrice ? "사전 결제 금액" : "확정 결제 금액"),
  };

  const cashCardColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: ["결제", `${paymentTerm.cashOrCard}`],
    key: "totalPaidAmount",
    align: "right",
    width: 140,
    render: (_, record) => <NumberComponent value={record.totalPaidAmount} includeCurrency={true} />,
  };

  const cashableCreditColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: ["결제", `${paymentTerm.cashableCredits}`],
    key: "totalCashableCreditsAmount",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.totalCashableCreditsAmount} includeCurrency={true} />,
  };

  const nonCashableCreditColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: ["결제", `${paymentTerm.nonCashableCredits}`],
    key: "totalNonCashableCreditsAmount",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.totalNonCashableCreditsAmount} includeCurrency={true} />,
  };

  const rcoinsColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: ["결제", `${paymentTerm.rcoins}`],
    key: "totalRcoinsAmount",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.totalRcoinsAmount} includeCurrency={true} />,
  };

  const totalColumn: DownloadableColumnType<OrderPaymentMethodData> = {
    title: "합계",
    key: "total",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.total} includeCurrency={true} />,
  };

  const columns: DownloadableColumnsType<OrderPaymentMethodData> = [
    paymentMethodColumn,
    cashCardColumn,
    cashableCreditColumn,
    nonCashableCreditColumn,
    rcoinsColumn,
    totalColumn,
  ];

  return columns.filter(Boolean);
}

/**
 * 결제 요약 테이블 설정
 */
export function getOrderPaymentSummaryTableSettings(): DownloadableColumnsType<OrderPaymentSummaryData> {
  const confirmedPaymentColumn: DownloadableColumnType<OrderPaymentSummaryData> = {
    title: "확정 결제 금액",
    key: "confirmedPaymentAmount",
    align: "center",
    width: 140,
    render: (_, record) => <NumberComponent value={record.confirmedPaymentAmount} includeCurrency={true} />,
  };

  const refundProductColumn: DownloadableColumnType<OrderPaymentSummaryData> = {
    title: "환불 상품금액",
    key: "refundProductAmount",
    align: "center",
    width: 120,
    render: (_, record) => <NumberComponent value={record.refundProductAmount} includeCurrency={true} />,
  };

  const returnDeliveryColumn: DownloadableColumnType<OrderPaymentSummaryData> = {
    title: "반품 배송비",
    key: "returnDeliveryFee",
    align: "center",
    width: 100,
    render: (_, record) => <NumberComponent value={record.returnDeliveryFee} includeCurrency={true} />,
  };

  const finalPaymentColumn: DownloadableColumnType<OrderPaymentSummaryData> = {
    title: "최종 결제 금액",
    key: "finalPaymentAmount",
    align: "center",
    width: 140,
    render: (_, record) => (
      <Typography.Text strong style={{ color: "#1890ff" }}>
        <NumberComponent value={record.finalPaymentAmount} includeCurrency={true} />
      </Typography.Text>
    ),
  };

  const columns: DownloadableColumnsType<OrderPaymentSummaryData> = [
    confirmedPaymentColumn,
    refundProductColumn,
    returnDeliveryColumn,
    finalPaymentColumn,
  ];

  return columns.filter(Boolean);
}
