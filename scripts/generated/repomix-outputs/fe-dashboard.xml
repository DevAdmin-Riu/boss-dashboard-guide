      return (
        <Space>
          <Button
            type="primary"
            shape="round"
            loading={isLoading}
            onClick={() => onConfirmModalOpen(MileageSettlementListConfirmModalModeEnum.TransferDoneBulkData)}
            disabled={selectedRows.length === 0}
          >
            일괄 지급 처리
          </Button>
        </Space>
      );
    } else {
      return null;
    }
  };

  const makeExtraExcelDownloadUi = () => (
    <Button
      type="primary"
      shape="round"
      icon={<DownloadOutlined />}
      loading={isLoading}
      onClick={() => handleClickExcelDownload(dataSource, urlType.urlEnum)}
      disabled={dataSource.length === 0}
    >
      엑셀 다운로드
    </Button>
  );

  const getModalTitleText = (confirmModalMode: MileageSettlementListConfirmModalModeEnum) => {
    switch (confirmModalMode) {
      case MileageSettlementListConfirmModalModeEnum.CreateData:
        return "본부수익금 확정";
      case MileageSettlementListConfirmModalModeEnum.CreateBulkData:
        return "본부수익금 일괄 확정";
      case MileageSettlementListConfirmModalModeEnum.TransferDoneData:
        return "본부수익금 지급 처리";
      case MileageSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        return "본부수익금 일괄 지급 처리";
      default:
        return "";
    }
  };

  const getHelpText = (confirmModalMode: MileageSettlementListConfirmModalModeEnum) => {
    switch (confirmModalMode) {
      case MileageSettlementListConfirmModalModeEnum.CreateData:
        return "본부수익금을 확정하시겠습니까?";
      case MileageSettlementListConfirmModalModeEnum.CreateBulkData:
        return "선택된 본부수익금을 일괄 확정하시겠습니까?";
      case MileageSettlementListConfirmModalModeEnum.TransferDoneData:
        return "본부수익금 지급 처리 하시겠습니까?";
      case MileageSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        return "본부수익금 일괄 지급 처리 하시겠습니까?";
      default:
        return "";
    }
  };

  const handleReview = (formData) => {
    settlementUpdate({
      variables: {
        id: selectedRowId,
        input: {
          rejectReason: !formData.reviewResult ? formData.rejectReason : null,
          settlementStatus:
            formData.reviewResult === true
              ? BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT
              : BrandMonthlySettlementStatusEnum.CONFIRMED,
        },
      },
    });
  };

  const makeConfirmContentNodeForCreate = () => {
    const tableTitle = () => (
      <Row justify="space-between">
        <Typography.Text strong type="danger">
          지급 확정 금액이 마이너스인 브랜드가 있을 경우, 확정할 수 없습니다.
        </Typography.Text>
        <TableVatLegend isIncludeVat size="small" />
      </Row>
    );

    switch (confirmModalMode) {
      case MileageSettlementListConfirmModalModeEnum.CreateData:
        const selectedRow = dataSource.find((record) => record.id === selectedRowId);
        return (
          <Form name="mileage-settlement-single-create-form" form={formForCreate} onFinish={handleCreate}>
            <PatchedColumnsTable<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node>
