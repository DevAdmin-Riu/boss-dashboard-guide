<file path="src/app/routes/SectionRoute.tsx">
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { PermissionEnum } from "@src/api/types/globalTypes";
import { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { demoViewPath } from "@src/app/views/auth/urls";
import { demoIds } from "@src/app/views/hqStaffDemo/hqDemoHome";
import { showNotificationWarn } from "@utils/notification/wrapper";
import React from "react";
import { useLocation } from "react-router";
import { Route, RouteProps } from "react-router-dom";

import { checkIsAllowedMenuUrlForHqStaff } from "../components/AppLayout/menuStructureHqStaff";
import NotFound from "../components/NotFound";
import useShop from "../providers/ShopProvider/useShop";
import { checkHasAnyPermissions } from "../views/auth/utils";

interface SectionRouteProps extends RouteProps {
  permissions?: PermissionEnum[];
}

export const SectionRoute: React.FC<SectionRouteProps> = ({ permissions, ...props }) => {
  const { user } = useUser();
  const shopData = useShop();
  const location = useLocation();
  const navigate = useNavigator();
  const userPermissions = (user?.userPermissions || []).map((perm) => perm.code);
  const hasPermissions = checkHasAnyPermissions(permissions, userPermissions);
  if (demoIds.includes(user.loginId)) {
    if (!(location.pathname === "/")) {
      showNotificationWarn("체험 유저는 접근 권한이 없습니다.");
    }
    navigate(demoViewPath);
  }

  if (user?.isHqStaff) {
    const isAllowedMenuUrlForHqStaff = checkIsAllowedMenuUrlForHqStaff(user, shopData, location.pathname);
    if (isAllowedMenuUrlForHqStaff === false) {
      return <NotFound type={ErrorPageEnum.PermissionDenied} staff={user.brand.staff} />;
    }
  }
  return hasPermissions ? <Route {...props} /> : <NotFound type={ErrorPageEnum.PermissionDenied} />;
};
</file>

<file path="src/app/views/auth/api/mutations.ts">
import makeMutation from "@hooks/makeMutation";
import { fragmentUser } from "@src/api/fragments/auth";
import { accountErrorFragment, appErrorFragment } from "@src/api/fragments/errors";
import gql from "graphql-tag";

import { RequestPasswordReset, RequestPasswordResetVariables } from "./types/RequestPasswordReset";
import { SetPassword, SetPasswordVariables } from "./types/SetPassword";

export const tokenAuthMutation = gql`
  ${fragmentUser}
  mutation TokenAuth(
    $loginId: String!
    $password: String!
    $requestOrigin: RequestOriginTypeEnum!
    $dashboardBuildNumber: String
    $extraData: JSONString
  ) {
    tokenCreate(
      loginId: $loginId
      password: $password
      requestOrigin: $requestOrigin
      dashboardBuildNumber: $dashboardBuildNumber
      extraData: $extraData
    ) {
      errors: accountErrors {
        field
        message
      }
      csrfToken
      token
      user {
        ...User
      }
    }
  }
`;

export const tokenVerifyMutation = gql`
  ${fragmentUser}
  mutation VerifyToken($token: String!) {
    tokenVerify(token: $token) {
      payload
      user {
        ...User
      }
    }
  }
`;

export const tokenRefreshMutation = gql`
  mutation RefreshToken($token: String!) {
    tokenRefresh(csrfToken: $token) {
      token
    }
  }
`;

export const requestPasswordReset = gql`
  ${accountErrorFragment}
  mutation RequestPasswordReset($loginId: String!, $redirectUrl: String!) {
    requestPasswordReset(loginId: $loginId, redirectUrl: $redirectUrl) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
    }
  }
`;
export const useRequestPasswordResetMutation = makeMutation<RequestPasswordReset, RequestPasswordResetVariables>(
  requestPasswordReset
);

export const setPassword = gql`
  ${accountErrorFragment}
  ${fragmentUser}
  mutation SetPassword($loginId: String!, $password: String!, $requestOrigin: RequestOriginTypeEnum!, $token: String!) {
    setPassword(loginId: $loginId, password: $password, requestOrigin: $requestOrigin, token: $token) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      csrfToken
      refreshToken
      token
      user {
        ...User
      }
    }
  }
`;
export const useSetPasswordMutation = makeMutation<SetPassword, SetPasswordVariables>(setPassword);

export const mobileDeviceUpdateOrCreateMutation = gql`
  ${appErrorFragment}
  mutation MobileDeviceUpdateOrCreate($input: MobileDeviceInput!) {
    mobileDeviceUpdateOrCreate(input: $input) {
      mobileDevice {
        id
        fcmToken
      }
      errors: appErrors {
        ...AppErrorFragment
      }
    }
  }
`;
</file>

