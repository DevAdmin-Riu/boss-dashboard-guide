import { useEffect, useState } from "react";

function useModalDialogOpen(
  open: boolean,
  cbs: {
    onClose?: () => void;
    onOpen?: () => void;
  }
): void {
  const [prevOpen, setPrevOpen] = useState(open);

  useEffect(() => {
    if (open !== prevOpen) {
      setPrevOpen(open);
      if (cbs.onOpen && open) {
        cbs.onOpen();
      }

      if (cbs.onClose && !open) {
        cbs.onClose();
      }
    }
  }, [open]);
}

export default useModalDialogOpen;
</file>

<file path="src/global/core/hooks/makeMutation.ts">
import {
  ApolloError,
  FetchResult,
  InternalRefetchQueriesInclude,
  MutationFunction,
  MutationResult,
  useMutation as useBaseMutation,
} from "@apollo/client";
import useAppState from "@hooks/useAppState";
import { isJwtError } from "@src/app/views/auth/utils";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { MutationResultAdditionalProps } from "@src/global/core/types/types";
import { getMutationStatus, maybe } from "@utils/misc";
import { showGqlErrorInfo } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { DocumentNode } from "graphql";
import { useEffect } from "react";

import useUser from "./useUser";

export type UseMutation<TData, TVariables> = [
  MutationFunction<TData, TVariables>,
  MutationResult<TData> & MutationResultAdditionalProps
];
export type UseMutationCbs<TData> = Partial<{
  displayLoader: boolean;
  onCompleted: (data: TData) => void;
  onError: (error: ApolloError) => void;
  refetchQueries: InternalRefetchQueriesInclude | ((result: FetchResult<any>) => InternalRefetchQueriesInclude);
  awaitRefetchQueries: boolean;
}>;
export type UseMutationHook<TData, TVariables> = (cbs: UseMutationCbs<TData>) => UseMutation<TData, TVariables>;

function makeMutation<TData, TVariables>(mutation: DocumentNode): UseMutationHook<TData, TVariables> {
  function useMutation<TData, TVariables>({
    displayLoader = true,
    onCompleted,
    onError,
    refetchQueries,
    awaitRefetchQueries,
  }: UseMutationCbs<TData>): UseMutation<TData, TVariables> {
    const user = useUser();
    const [, dispatchAppState] = useAppState();

    const [mutateFn, result] = useBaseMutation(mutation, {
      onCompleted,
      onError: (err: ApolloError) => {
        if (onError) {
          onError(err);
        } else {
          if (maybe(() => err.graphQLErrors[0].extensions.exception.code === "ReadOnlyException")) {
            showGqlErrorInfo(commonMsg.readOnly, err.graphQLErrors[0].extensions.exception.code);
          } else if (err.graphQLErrors.some(isJwtError)) {
            user.logout();
            showGqlErrorInfo(commonMsg.sessionExpired, "JwtError");
          } else {
            showGqlErrorInfo(err.message, "Mutation: ApolloError");
          }
        }
      },

      refetchQueries,
      awaitRefetchQueries,
    });

    useEffect(() => {
      if (displayLoader) {
        dispatchAppState({
          payload: {
            value: result.loading,
          },
          type: "displayLoader",
        });
      }
    }, [result.loading]);

    const wrappedMutateFn: MutationFunction<TData, TVariables> = (options) => {
      const variables = options?.variables;
      const trimmedVariables = utils.trimObject(variables);
      return mutateFn({ ...options, variables: trimmedVariables });
    };

    return [
      // mutateFn,
      wrappedMutateFn,
      {
        ...result,
        status: getMutationStatus(result),
      },
    ];
  }

  return useMutation;
}

export default makeMutation;
</file>

<file path="src/global/core/hooks/makeQuery.ts">
import {
  ApolloQueryResult,
  QueryResult,
  useLazyQuery as useBaseLazyQuery,
  useQuery as useBaseQuery,
  WatchQueryFetchPolicy,
} from "@apollo/client";
import { DEVELOPMENT_MODE } from "@assets/constants/config";
import { defaultFetchPolicy } from "@src/app/providers/ApolloClientProvider/ApolloClientProvider";
import { handleQueryAuthError } from "@src/app/views/auth/utils";
import { RequireAtLeastOne } from "@utils/misc";
import { DocumentNode } from "graphql";
import { useEffect, useRef, useState } from "react";

import useAppState from "./useAppState";
import { useListQuerySkip } from "./useListQuerySkip";
import useUser from "./useUser";

function useAbortController() {
  const [abortController, setAbortController] = useState<AbortController>(null);
  const abortControllerRef = useRef<AbortController>(null);

  useEffect(() => {
    abortControllerRef.current = abortController;
  }, [abortController]);

  useEffect(() => {
    setAbortController(new AbortController());
    return () => {
      abortControllerRef.current?.abort();
    };
  }, []);

  return {
    abortController,
  };
}

export interface LoadMore<TData, TVariables> {
  loadMore: (
    mergeFunc: (prev: TData, next: TData) => TData,
    extraVariables: Partial<TVariables>
  ) => Promise<ApolloQueryResult<TData>>;
}

export type UseQueryResult<TData, TVariables> = QueryResult<TData, TVariables> & LoadMore<TData, TVariables>;

export type UseLazyQueryResult<TData, TVariables> = [
  (options?: { variables?: TVariables }) => Promise<ApolloQueryResult<TData>>,
  QueryResult<TData, TVariables>
];

type UseQueryOpts<TData, TVariables> = Partial<{
  displayLoader: boolean;
  forceFetchPolicy: WatchQueryFetchPolicy;
  // 리스트 페이지 최초 진입 시에 쿼리 스킵 여부 초기값 설정 - true일 경우 최초 진입 시에만 쿼리 스킵하고, cache-first 정책 적용
  initialListSkip: boolean;
  skip: boolean;
  variables: TVariables;
  onCompleted: (data: TData) => void;
  useBatching: boolean;
}>;

type ExtendedUseQueryOpts<TData, TVariables> = UseQueryOpts<TData, TVariables> & {
  condition: boolean;
};

export type UseQueryHook<TData, TVariables> = (
  opts: UseQueryOpts<TData, TVariables>
) => UseQueryResult<TData, TVariables>;

export function makeLazyQuery<TData, TVariables>(
  query: DocumentNode,
  fetchPolicy: WatchQueryFetchPolicy = defaultFetchPolicy
): (options?: {
  variables?: Partial<TVariables>;
  forceFetchPolicy?: WatchQueryFetchPolicy;
}) => UseLazyQueryResult<TData, TVariables> {
  return function useLazyCustomQuery(options?: {
    variables?: Partial<TVariables>;
    forceFetchPolicy?: WatchQueryFetchPolicy;
  }): UseLazyQueryResult<TData, TVariables> {
    const { variables: baseVariables, forceFetchPolicy } = options || {};

    const [, dispatchAppState] = useAppState();
    const user = useUser();
    const { abortController } = useAbortController();

    const [originalTrigger, queryResult] = useBaseLazyQuery<TData, TVariables>(query, {
      context: {
        useBatching: true,
        fetchOptions: {
          signal: abortController?.signal,
        },
      },
      errorPolicy: "all",
      fetchPolicy: forceFetchPolicy ?? fetchPolicy,
      onError: (error) => handleQueryAuthError(error, user.tokenRefresh, user.logout),
    });

    useEffect(() => {
      dispatchAppState({
        payload: { value: queryResult.loading },
        type: "displayLoader",
      });
      return () => {
        dispatchAppState({
          payload: { value: false },
          type: "displayLoader",
        });
      };
    }, [queryResult.loading]);

    const mergedTrigger = (triggerOptions?: { variables?: TVariables }) => {
      const overrideVariables = triggerOptions?.variables;
      const finalVariables = {
        ...(baseVariables || {}),
        ...(overrideVariables || {}),
      };
      return originalTrigger({ variables: finalVariables as TVariables });
    };

    return [mergedTrigger, queryResult];
  };
}

function makeQuery<TData, TVariables>(
  query: DocumentNode,
  fetchPolicy: WatchQueryFetchPolicy = defaultFetchPolicy
): UseQueryHook<TData, TVariables> {
  function useQuery({
    displayLoader = true,
    forceFetchPolicy,
    initialListSkip = false,
    skip,
    variables,
    onCompleted,
    useBatching = true,
  }: UseQueryOpts<TData, TVariables>): UseQueryResult<TData, TVariables> {
    const [, dispatchAppState] = useAppState();
    const user = useUser();
    const { abortController } = useAbortController();
    const {
      skipState: listQuerySkipState,
      forceFetchPolicy: listForceFetchPolicy,
      setSkip: setListQuerySkip,
    } = useListQuerySkip(initialListSkip);

    const finalSkip = initialListSkip ? listQuerySkipState.value : skip;
    const finalFetchPolicy = initialListSkip ? listForceFetchPolicy : forceFetchPolicy || fetchPolicy;

    const queryData = useBaseQuery<TData, TVariables>(query, {
      context: {
        useBatching,
        fetchOptions: {
          signal: abortController?.signal,
        },
      },
      errorPolicy: "all",
      fetchPolicy: finalFetchPolicy,
      onError: (error) => handleQueryAuthError(error, user.tokenRefresh, user.logout),
      skip: finalSkip,
      variables,
      onCompleted: (res) => {
        if (onCompleted) {
          onCompleted(res);
        }
      },
    });

    // NOTE: query를 날렸을 때 error를 뜨지 않는 경우가 있어서 추가한 코드
    if (process.env.NODE_ENV === DEVELOPMENT_MODE && queryData.error) {
      console.error(`${queryData.observable.queryName} query 요청 중 오류가 발생했습니다.
      오류 내용: ${queryData.error.message}`);
    }

    useEffect(() => {
      if (queryData.loading && initialListSkip) {
        setListQuerySkip({ updated: true, value: false });
      }

      if (displayLoader) {
        dispatchAppState({
          payload: {
            value: queryData.loading,
          },
          type: "displayLoader",
        });
      }
      return () => {
        dispatchAppState({
          payload: {
            value: false,
          },
          type: "displayLoader",
        });
      };
    }, [queryData.loading]);

    const loadMore = (
      mergeFunc: (previousResults: TData, fetchMoreResult: TData) => TData,
      extraVariables: RequireAtLeastOne<TVariables>
    ) =>
      queryData.fetchMore({
        query,
        updateQuery: (previousResults, { fetchMoreResult }) => {
          if (!fetchMoreResult) {
            return previousResults;
          }
          return mergeFunc(previousResults, fetchMoreResult);
        },
        variables: { ...variables, ...extraVariables },
      });

    return {
      ...queryData,
      loadMore,
    };
  }

  return useQuery;
}

export function choiceMakeQuery<TData, TVariables>(
  trueQuery: DocumentNode,
  falseQuery: DocumentNode,
  fetchPolicy: WatchQueryFetchPolicy = defaultFetchPolicy
) {
  function useQuery({
    condition,
    displayLoader = true,
    forceFetchPolicy,
    skip,
    variables,
    onCompleted,
    useBatching = true,
  }: ExtendedUseQueryOpts<TData, TVariables>): UseQueryResult<TData, TVariables> {
    const [, dispatchAppState] = useAppState();
    const user = useUser();
    const { abortController } = useAbortController();

    const queryData = useBaseQuery<TData, TVariables>(condition ? trueQuery : falseQuery, {
      context: {
        useBatching,
        fetchOptions: {
          signal: abortController?.signal,
        },
      },
      errorPolicy: "all",
      fetchPolicy: forceFetchPolicy ? forceFetchPolicy : fetchPolicy,
      onError: (error) => handleQueryAuthError(error, user.tokenRefresh, user.logout),
      skip,
      variables,
      onCompleted: (res) => {
        if (onCompleted) {
          onCompleted(res);
        }
      },
    });

    useEffect(() => {
      if (displayLoader) {
        dispatchAppState({
          payload: {
            value: queryData.loading,
          },
          type: "displayLoader",
        });
      }
      return () => {
        dispatchAppState({
          payload: {
            value: false,
          },
          type: "displayLoader",
        });
      };
    }, [queryData.loading]);

    const loadMore = (
      mergeFunc: (previousResults: TData, fetchMoreResult: TData) => TData,
      extraVariables: RequireAtLeastOne<TVariables>
    ) =>
      queryData.fetchMore({
        query: condition ? trueQuery : falseQuery,
        updateQuery: (previousResults, { fetchMoreResult }) => {
          if (!fetchMoreResult) {
            return previousResults;
          }
          return mergeFunc(previousResults, fetchMoreResult);
        },
        variables: { ...variables, ...extraVariables },
      });

    return {
      ...queryData,
      loadMore,
    };
  }

  return useQuery;
}

export default makeQuery;
</file>

<file path="src/global/core/hooks/makeSearch.ts">
import { QueryResult, WatchQueryFetchPolicy } from "@apollo/client";
import { defaultFetchPolicy } from "@src/app/providers/ApolloClientProvider/ApolloClientProvider";
import { DocumentNode } from "graphql";
import { useState } from "react";

import makeQuery, { UseQueryResult } from "./makeQuery";
import useDebounce from "./useDebounce";

export interface SearchVariables {
  after?: string;
  first: number;
  query?: string;
}

export interface UseSearchResult<TData, TVariables extends SearchVariables> {
  loadMore: () => void;
  result: QueryResult<TData, TVariables>;
  search: (query: string) => void;
}
export type UseSearchOpts<TVariables extends SearchVariables> = Partial<{
  skip: boolean;
  // 페이지 최초 진입 시에만 쿼리 스킵 여부 초기값 설정 - true일 경우 최초 진입 시에만 쿼리 스킵하고, cache-first 페치 정책 적용
  initialListSkip: boolean;
  variables: TVariables;
}>;
export type UseSearchHook<TData, TVariables extends SearchVariables> = (
  opts: UseSearchOpts<TVariables>
) => UseSearchResult<TData, TVariables>;

function makeSearch<TData, TVariables extends SearchVariables>(
  query: DocumentNode,
  fetchPolicy: WatchQueryFetchPolicy = defaultFetchPolicy,
  loadMoreFn: (result: UseQueryResult<TData, TVariables>) => void
): UseSearchHook<TData, TVariables> {
  const useSearchQuery = makeQuery<TData, TVariables>(query, fetchPolicy);

  function useSearch(opts: UseSearchOpts<TVariables>): UseSearchResult<TData, TVariables> {
    const [searchQuery, setSearchQuery] = useState("");

    const debouncedSearch = useDebounce(setSearchQuery);
    const result = useSearchQuery({
      ...opts,
      variables: {
        ...opts.variables,
        query: searchQuery,
      },
    });

    return {
      loadMore: () => loadMoreFn(result),
      result,
      search: debouncedSearch,
    };
  }

  return useSearch;
}

export default makeSearch;
</file>

<file path="src/global/core/hooks/makeTopLevelSearch.ts">
import { WatchQueryFetchPolicy } from "@apollo/client";
import { PageInfoFragment } from "@src/api/fragments/types/PageInfoFragment";
import { defaultFetchPolicy } from "@src/app/providers/ApolloClientProvider/ApolloClientProvider";
import { DocumentNode } from "graphql";

import makeSearch, { SearchVariables, UseSearchHook } from "./makeSearch";

export interface SearchData {
  search: {
    edges: Array<{
      node: any;
    }>;
    pageInfo: PageInfoFragment;
  };
}

function makeTopLevelSearch<TData extends SearchData, TVariables extends SearchVariables>(
  query: DocumentNode,
  fetchPolicy: WatchQueryFetchPolicy = defaultFetchPolicy
): UseSearchHook<TData, TVariables> {
  return makeSearch<TData, TVariables>(query, fetchPolicy, (result) => {
    if (result.data?.search?.pageInfo.hasNextPage) {
      result.loadMore(
        (prev, next) => {
          if (prev.search.pageInfo.endCursor === next.search.pageInfo.endCursor) {
            return prev;
          }

          return {
            ...prev,
            search: {
              ...prev.search,
              edges: [...prev.search.edges, ...next.search.edges],
              pageInfo: next.search.pageInfo,
            },
          };
        },
        {
          ...result.variables,
          after: result.data.search.pageInfo.endCursor,
        }
      );
    }
  });
}

export default makeTopLevelSearch;
</file>

