        ...MobileAppInfoFragment
      }
      __typename
    }
  }
`;
export const useMobileAppInfoSettingsQuery = makeQuery<MobileAppInfoSettings, {}>(mobileAppInfoSettingsQuery);

export const regionsQuery = gql`
  ${regionFragment}
  query Regions {
