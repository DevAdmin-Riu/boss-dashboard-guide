import { UseNavigatorResult } from "@hooks/useNavigator";
import { orderDetailsViewUrl } from "@src/app/views/order/orders/urls";
import navigatorModeMsg from "@src/global/assets/messages/navigatorMode";
import { transformOrderStatus } from "@src/global/assets/messages/status";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { CheckIfOrderExists_order } from "../api/types/CheckIfOrderExists";
import { QuickSearchAction } from "../types";

export function isQueryValidOrderNumber(query: string): boolean {
  return query === parseInt(query, 0).toString();
}

export function getGqlOrderId(orderNumber: string): string {
  return btoa(unescape(encodeURIComponent(`Order:${orderNumber}`)));
}

function getOrdersModeActions(
  query: string,
  navigate: UseNavigatorResult,
  order: CheckIfOrderExists_order
): QuickSearchAction[] {
  const gqlId = getGqlOrderId(query);

  if (isQueryValidOrderNumber(query) && maybe(() => order.id === gqlId)) {
    return [
      {
        extraInfo: transformOrderStatus(order.status, order.isFullyTracking, order.isFullyTrackingCompleted).localized,
        label: utils.formatMessage(navigatorModeMsg.goToOrder, {
          orderNumber: query,
        }),
        onClick: () => {
          navigate(orderDetailsViewUrl(gqlId));
          return false;
        },
        type: "action",
      },
    ];
  }

  return [];
}

export default getOrdersModeActions;
