  permissionGroupCreateViewUrl,
  permissionGroupDetailsUrl,
  permissionGroupListViewUrl,
  PermissionGroupListViewUrlDialog,
  PermissionGroupListViewUrlQueryParams,
} from "../../urls";
import { getSortQueryVariables } from "./sort";

interface PermissionGroupListViewProps {
  params: PermissionGroupListViewUrlQueryParams;
}

export const PermissionGroupListView: React.FC<PermissionGroupListViewProps> = ({ params }) => {
  const targetUrl = permissionGroupListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PERMISSION_GROUP_LIST,
  });

  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );
  const { data, loading } = usePermissionGroupListQuery({
    variables: queryVariables,
  });

  const handleSort = createSortHandler(navigate, permissionGroupListViewUrl, params);

  const permissionGroups = data?.permissionGroups?.edges.map((edge) => edge.node);
  const [deleteError, setDeleteError] = React.useState<PermissionGroupErrorFragment>();

  const handleDeleteSuccess = (data: PermissionGroupDelete) => {
    const errors = data.permissionGroupDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess("권한 그룹이 삭제되었습니다.");
      setDeleteError(undefined);
      closeModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
      setDeleteError(errors[0]);
    }
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.permissionGroups?.pageInfo,
    paginationState,
    params,
  });

  const [openModal, closeModal] = createDialogActionHandlers<
    PermissionGroupListViewUrlDialog,
    PermissionGroupListViewUrlQueryParams
  >(navigate, targetUrl, params);

  const [permissionGroupDelete, permissionGroupDeleteOpts] = usePermissionGroupDelete({
    onCompleted: handleDeleteSuccess,
    refetchQueries: [permissionGroupListQuery],
  });
  return (
    <>
      <PermissionGroupListPage
        disabled={loading || permissionGroupDeleteOpts.loading}
        settings={settings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        permissionGroups={permissionGroups}
        onAdd={() => navigate(permissionGroupCreateViewUrl)}
        onBack={() => navigate(configurationSectionUrl)}
        onDelete={(id) => openModal("remove", { id })}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(permissionGroupDetailsUrl(id))}
        onSort={handleSort}
      />
      <PermissionGroupDeleteDialog
        onConfirm={() =>
          permissionGroupDelete({
            variables: {
              id: params.id,
            },
          })
        }
        error={deleteError}
        name={getStringOrPlaceholder(permissionGroups?.find((group) => group.id === params.id)?.name)}
        confirmButtonState={"default"}
        open={params.action === "remove"}
        onClose={closeModal}
      />
    </>
  );
};
