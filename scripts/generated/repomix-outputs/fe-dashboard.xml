  const { inventoryType, status, deliveryMethod } = routeParams;

  let isAdjustPrice: boolean | undefined;

  if (inventoryType === "consignment" && status === PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT) {
    // 출고 지시 페이지인 경우
    if (deliveryMethod === "by-courier-price-adjust") {
      // 납품 시 금액 확정
      isAdjustPrice = true;
    } else if (deliveryMethod === "by-courier" || deliveryMethod === "by-non-courier") {
      // 일반 택배 또는 화물차
      isAdjustPrice = false;
