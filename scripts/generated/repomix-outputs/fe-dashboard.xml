import {
  ActiveTab,
  BulkAction,
  Dialog,
  Filters,
  Pagination,
  Sort,
  TabActionDialog,
} from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const collectionSectionUrl = "/collections";
export const collectionListViewPath = collectionSectionUrl;
export enum CollectionListViewUrlFiltersEnum {
  name_Icontains = "name_Icontains",
  published = "published",
}
export type CollectionListViewUrlFilters = Filters<CollectionListViewUrlFiltersEnum>;
export type CollectionListViewUrlDialog = "publish" | "unpublish" | "remove" | TabActionDialog;
export enum CollectionListViewUrlSortField {
  name = "name",
  available = "available",
  productCount = "products",
}
export type CollectionListViewUrlSort = Sort<CollectionListViewUrlSortField>;
export type CollectionListViewUrlQueryParams = ActiveTab &
  BulkAction &
  CollectionListViewUrlFilters &
  CollectionListViewUrlSort &
  Dialog<CollectionListViewUrlDialog> &
  Pagination;
export const collectionListViewUrl = (params?: CollectionListViewUrlQueryParams) =>
  urlJoin(collectionSectionUrl, "?" + stringifyQs(params));

export const collectionDetailsViewPath = (id: string) => urlJoin(collectionSectionUrl, id);
export type CollectionDetailsViewUrlQueryParams = BulkAction & Pagination;
export const collectionDetailsViewUrl = (id: string, params?: CollectionDetailsViewUrlQueryParams) =>
  collectionDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);

export const collectionCreateViewPath = urlJoin(collectionSectionUrl, "add");
export const collectionCreateViewUrl = collectionCreateViewPath;
</file>

