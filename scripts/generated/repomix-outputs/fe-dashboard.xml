<file path="src/global/core/utils/excel/excelDownload.ts">
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { fileNameDateFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { checkIsInteger } from "@utils/misc";
import { showDownloadingMessageWritingToExcel, showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { sendMessageToWebView } from "@utils/webView";
import * as ExcelJS from "exceljs";
import { saveAs } from "file-saver";
import moment from "moment";
import * as xlsx from "xlsx-js-style";

import { MissingRenderExcelError } from "../../errors/MissingRenderExcelError";
import { MissingTitleExcelError } from "../../errors/MissingTitleExcelError";
import { HeaderIndexLabelType } from "../../types/types";

export const cellToMergeKey = "cellToMergeKey";
export const defaultDownloadTextValue = "-";
export const defaultDownloadNumValue = 0;
export const excelMimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

// TODO: 추후 기존 xlsx-js-style 라이브러리를 exceljs로 대체하면서 기존 xlsx 유틸 제거 + exceljs 유틸 네이밍에서 ~ByExceljs 제거하는 리팩토링 작업 할 것.
// ============================= 이하 exceljs 이용한 유틸 =============================
export const loadWorkbookByBuffer = async (arrayBuffer: ArrayBuffer): Promise<ExcelJS.Workbook> => {
  const workbook = new ExcelJS.Workbook();
  await workbook.xlsx.load(arrayBuffer);
  return workbook;
