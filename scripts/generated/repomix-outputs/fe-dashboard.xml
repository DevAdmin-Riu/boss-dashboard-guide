import useUser from "@hooks/useUser";
import { OrderType } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { useTaxInvoiceListDownloadQuery, useTaxInvoiceListQuery } from "../../api/queries";
import { TaxInvoiceListVariables } from "../../api/types/TaxInvoiceList";
import TaxInvoiceListPage from "../../components/TaxInvoiceListPage/TaxInvoiceListPage";
import {
  hqTaxInvoicePurchaseListViewUrl,
  hqTaxInvoiceSalesListViewUrl,
  HqTaxInvoiceUrlTypeEnum,
  taxInvoiceAgencyListViewUrl,
  TaxInvoiceListViewDialog,
  TaxInvoiceListViewUrlQueryParams,
  taxInvoiceRegularListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filter";

interface TaxInvoiceListViewProps {
  defaultParams: TaxInvoiceListViewUrlQueryParams;
  params: TaxInvoiceListViewUrlQueryParams;
}

const TaxInvoiceListView: React.FC<TaxInvoiceListViewProps> = ({ defaultParams, params }) => {
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const { orderType, hqUrlType } = params;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.TAX_INVOICE_ISSUED_LIST,
  });
  const targetUrl = isStaff
    ? orderType === OrderType.BY_STAFF_FOR_BRAND
      ? taxInvoiceAgencyListViewUrl
      : taxInvoiceRegularListViewUrl
    : hqUrlType === HqTaxInvoiceUrlTypeEnum.PURCHASE
    ? hqTaxInvoicePurchaseListViewUrl
    : hqTaxInvoiceSalesListViewUrl;

  const { fetchForDownload } = utils.initListViewDownloadQuery(useTaxInvoiceListDownloadQuery);

  const queryVariables: TaxInvoiceListVariables = React.useMemo(() => {
    const variable = {
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
      },
    };

    if (isStaff === true) {
      return variable;
    } else if (isHqStaff) {
      const overWriteFilterForHq = {
        isToHq: hqUrlType === HqTaxInvoiceUrlTypeEnum.PURCHASE ? true : false,
        isFromRiu: hqUrlType === HqTaxInvoiceUrlTypeEnum.PURCHASE ? true : false,
        brand: user?.brand?.id,
      };
      return {
        ...variable,
        filter: {
          ...variable.filter,
          ...overWriteFilterForHq,
        },
      };
    }
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = useTaxInvoiceListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.taxInvoiceList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<TaxInvoiceListViewDialog, TaxInvoiceListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <TaxInvoiceListPage
        orderType={orderType as OrderType}
        hqUrlType={hqUrlType as HqTaxInvoiceUrlTypeEnum}
        disabled={loading}
        settings={settings}
        taxInvoices={maybe(() => data.taxInvoiceList.edges.map((edge) => edge.node), [])}
        pageInfo={pageInfo}
        onAdd={undefined}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        currentTab={currentTab}
        fetchForDownload={fetchForDownload}
        filterOpts={getFilterOpts(params)}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        onAll={resetFilters}
        isStaff={isStaff}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};

export default TaxInvoiceListView;
</file>

