} from "@utils/notification/wrapper";
import { showXlsInvalidFileError, showXlsInvalidRowError } from "@utils/notification/wrapperXls";
import { utils } from "@utils/utils";
import { Button, Col, Space } from "antd";
import React, { useRef, useState } from "react";

import {
  FulfillmentBulkUpdateForFbv,
  FulfillmentBulkUpdateForFbvVariables,
} from "../../api/types/FulfillmentBulkUpdateForFbv";
import { FulfillmentList, FulfillmentListVariables } from "../../api/types/FulfillmentList";
import {
  courierNameFieldName,
  etcDeliveryManContactFieldName,
  etcDeliveryVehicleFieldName,
  trackingNumberFieldName,
} from "../../components/OrderDeliveryListPage/utils";
import { fulfillmentsXlsxDownload } from "./utils";

interface FbvOrderDeliveryListViewExcelProps {
  isStaff: boolean;
  vendorStaffVendorId: string;
  queryVariables: FulfillmentListVariables;
  refetchForPrintFulfillmentAllList: (
    variables?: Partial<FulfillmentListVariables>
  ) => Promise<ApolloQueryResult<FulfillmentList>>;
  fulfillmentBulkUpdateForFbvMutation: MutationFunction<
    FulfillmentBulkUpdateForFbv,
    FulfillmentBulkUpdateForFbvVariables
  >;
  couriers: CourierList_couriers_edges_node[];
  fulfillmentsData: FulfillmentList;
  fulfillmentListRefetch: (
    variables?: Partial<FulfillmentListVariables>
  ) => Promise<ApolloQueryResult<FulfillmentList>>;
  selectedRowKeys?: string[];
  onDeliveryMultipleConfirm: () => void;
}

export const FbvOrderDeliveryListViewExcel: React.FC<FbvOrderDeliveryListViewExcelProps> = (props) => {
  const {
    isStaff,
    vendorStaffVendorId,
    queryVariables,
    refetchForPrintFulfillmentAllList,
    fulfillmentBulkUpdateForFbvMutation,
    couriers,
    fulfillmentsData,
    fulfillmentListRefetch,
    selectedRowKeys,
    onDeliveryMultipleConfirm,
  } = props;

  const upload: any = useRef();
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);

  const onPrintClick = () => {
    if (isStaff && utils.isEmpty(vendorStaffVendorId)) {
      showNotificationError("협력사를 선택해주세요.");
      return false;
    }
    setPrintBtnLoading(true);
    showDownloadingMessage();
    const variables = queryVariables;
    refetchForPrintFulfillmentAllList(variables)
      .then((resFulfillments) => {
        const resFulfillmentList = maybe(() => resFulfillments.data.fulfillments.edges.map((edge) => edge.node), []);
        if (utils.isEmpty(resFulfillmentList)) {
          showNotificationWarn("출력할 데이터가 없습니다.");
          return;
        }
        fulfillmentsXlsxDownload({ resFulfillments, title: "배송 정보 일괄 등록", couriers });
        if (resFulfillments?.data?.fulfillments?.edges?.length < resFulfillments?.data?.fulfillments?.totalCount) {
          showNotificationWarn(commonErrorMsg.maxLimitIssue);
        } else {
          showNotificationSuccess(commonMsg.downloadedToXls);
        }
      })
      .catch((e) => {
        showNotificationError("배송현황 리스트 다운로드 과정에서 에러가 발생하였습니다");
        throw e;
      })
      .finally(() => {
        setPrintBtnLoading(false);
        destroyDownloadingMessage();
      });
  };

  const readUploadFile = (e) => {
    e.preventDefault();
    if (e.target.files) {
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const jsonAry = parseWorksheetToJsonArr({ worksheet, headerRowNum: 1 });
        const existRegister = handleRegister(jsonAry);
        if (existRegister) {
          fulfillmentListRefetch(queryVariables);
        }
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const handleRegister = async (jsonAry) => {
    let errorCheck = false;
    const length = jsonAry?.length;
    if (length <= 0) {
      showXlsInvalidFileError(length);
      return false;
    }

    if (couriers.length <= 0) {
      showNotificationError(`택배사 정보 조회에 실패했습니다.`);
      return false;
    }
    const fulfillmentBulkUpdateForFbvInputList: FulfillmentBulkUpdateForFbvDetail[] = [];
    for (let i = 0; i < length; i++) {
      const json = jsonAry[i];

      if (!json) {
        showXlsInvalidRowError(json, i);
        break;
      }

      const fulfillmentComposedIdWithPrefix = json[`${columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID}`];
      const deliveryMethod = json[`${columnNameConstant.delivery.DELIVERY_METHOD}`];
      const trackingNumber = json[`${trackingNumberFieldName}`];
      const courierCompany = json[`${courierNameFieldName}`];
      const etcDeliveryVehicle = json[`${etcDeliveryVehicleFieldName}`];
      const etcDeliveryManContact = json[`${etcDeliveryManContactFieldName}`];
      const courierId = getCourierId(couriers, courierCompany);
      let deliveryMethodConverted = null;

      const { orderNumber, fulfillmentOrder } = parseOrderNumberAndFulfillmentOrderFormat(
        fulfillmentComposedIdWithPrefix
      );
      if (deliveryMethod !== "택배" && deliveryMethod !== "화물차") {
        showXlsInvalidRowError(json, i, columnNameConstant.delivery.DELIVERY_METHOD);
        errorCheck = true;
        break;
      }

      if (utils.isEmpty(orderNumber) || utils.isEmpty(fulfillmentOrder)) {
        showXlsInvalidRowError(json, i, columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID);
        errorCheck = true;
        continue;
      }

      if (deliveryMethod === "택배") {
        deliveryMethodConverted = OrderDeliveryMethodsEnum.BY_COURIER;
        if (!courierId) {
          showXlsInvalidRowError(json, i, courierNameFieldName);
          errorCheck = true;
          continue;
        }

        if (!trackingNumber) {
          showXlsInvalidRowError(json, i, trackingNumberFieldName);
          errorCheck = true;
          continue;
        }
      } else if (deliveryMethod === "화물차") {
        deliveryMethodConverted = OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE;
        if (!etcDeliveryVehicle) {
          showXlsInvalidRowError(json, i, etcDeliveryVehicleFieldName);
          errorCheck = true;
          continue;
        }
        if (!etcDeliveryManContact) {
          showXlsInvalidRowError(json, i, etcDeliveryManContactFieldName);
          errorCheck = true;
          continue;
        }
      }

      const fulfillmentBulkUpdateForFbvInputObj: FulfillmentBulkUpdateForFbvDetail = {
        orderNumber: Number(orderNumber),
        fulfillmentOrder: Number(fulfillmentOrder),
        deliveryMethod: deliveryMethodConverted,
        courierId,
        trackingNumber,
        etcDeliveryManInfo: { vehicle: etcDeliveryVehicle, contact: etcDeliveryManContact },
      };

      fulfillmentBulkUpdateForFbvInputList.push(fulfillmentBulkUpdateForFbvInputObj);
    }

    if (errorCheck) {
      return false;
    }

    await fulfillmentBulkUpdateForFbvMutation({
      variables: {
        input: {
          details: fulfillmentBulkUpdateForFbvInputList,
        },
      },
    });

    return false;
  };
  return (
    <Col>
      <Space>
        <Button
          loading={printBtnLoading}
          icon={<DownloadOutlined />}
          type="primary"
          shape="round"
          onClick={() => onPrintClick()}
        >
          배송정보 일괄 등록 양식
        </Button>
        <Button
          disabled={fulfillmentsData?.fulfillments.edges.length === 0}
          shape="round"
          type="primary"
          onClick={() => {
            upload.current.click();
          }}
        >
          배송정보 일괄 등록(엑셀)
        </Button>
        <input
          className="displayNone"
          ref={upload}
          onChange={(e) => readUploadFile(e)}
          type="file"
          accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
        />
        <Button
          disabled={selectedRowKeys.length === 0}
          onClick={onDeliveryMultipleConfirm}
          shape="round"
          type="primary"
        >
          배송정보 일괄등록(수동)
        </Button>
      </Space>
    </Col>
  );
};
</file>

