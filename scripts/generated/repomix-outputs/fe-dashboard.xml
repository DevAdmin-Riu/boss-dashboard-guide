import { commonMsg } from "@assets/messages/commonMsg";
import { CategoryKindEnum, SalesStatusEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { MultiAutocompleteChoiceType } from "@src/app/components/MultiAutocompleteSelectField";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { AutocompleteFilterOpts, FilterOpts, MinMax } from "@src/global/core/types/types";
import {
  createAutocompleteField,
  createBooleanField,
  createOptionsField,
  createPriceField,
  createTextField,
} from "@utils/filters/fields";

import { categoryKindChoices } from "../../../categories/utils";
import { getSalesStatusChoices } from "../../utils/data";

export enum ProductFilterKeys {
  salesStatus = "salesStatus",
  attributes = "attributes",
  categories = "categories",
  collections = "collections",
  status = "status",
  costPrice = "costPrice",
  deliveryFee = "deliveryFee",
  productType = "productType",
  trackInventory = "trackInventory",
  isDirectShipping = "isDirectShipping",
  isTaxFree = "isTaxFree",
  isExclusive = "isExclusive",
  requiredExpDateMgmt = "requiredExpDateMgmt",
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  categoryKind = "categoryKind",
}

export interface ProductListFilterOpts {
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  attributes: Array<
    FilterOpts<string[]> & {
      choices: MultiAutocompleteChoiceType[];
      name: string;
      slug: string;
    }
  >;
  productSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  categories: FilterOpts<string[]> & AutocompleteFilterOpts;
  collections: FilterOpts<string[]> & AutocompleteFilterOpts;
  costPrice: FilterOpts<MinMax>;
  deliveryFee: FilterOpts<MinMax>;
  productType: FilterOpts<string[]> & AutocompleteFilterOpts;
  trackInventory: FilterOpts<boolean>;
  isDirectShipping: FilterOpts<boolean>;
  isTaxFree: FilterOpts<boolean>;
  isExclusive: FilterOpts<boolean>;
  requiredExpDateMgmt: FilterOpts<boolean>;
  categoryKind: FilterOpts<CategoryKindEnum[]>;
}

export function createFilterStructure(
  opts: ProductListFilterOpts,
  isFulfilledByVendor: boolean
): IFilter<ProductFilterKeys> {
  let displayOrder = 0;
  const filterStructure: IFilter<ProductFilterKeys> = [];
  filterStructure.push(
    {
      ...createTextField(
        displayOrder++,
        ProductFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        ProductFilterKeys.vendorSearch,
        "협력사코드 / 협력사명",
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        ProductFilterKeys.salesStatus,
        "제품상태",
        opts.salesStatus.value,
        true,
        getSalesStatusChoices(false, isFulfilledByVendor)
      ),
      active: opts.salesStatus.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        ProductFilterKeys.categoryKind,
        "제품구분",
        opts.categoryKind.value,
        true,
        categoryKindChoices
      ),
      active: opts.categoryKind.active,
    }
  );
  if (isFulfilledByVendor === false) {
    filterStructure.push(
      {
        ...createBooleanField(
          displayOrder++,
          ProductFilterKeys.trackInventory,
          columnNameConstant.product.TRACK_INVENTORY,
          opts.trackInventory.value,
          {
            negative: "미운영",
            positive: "운영",
          }
        ),
        active: opts.trackInventory.active,
      },
      {
        ...createBooleanField(
          displayOrder++,
          ProductFilterKeys.isDirectShipping,
          "직배송 여부",
          opts.isDirectShipping.value,
          {
            negative: commonMsg.no,
            positive: commonMsg.yes,
          }
        ),
        active: opts.isDirectShipping.active,
      }
    );
  }
  filterStructure.push({
    ...createBooleanField(
      displayOrder++,
      ProductFilterKeys.isTaxFree,
      columnNameConstant.product.IS_TAX_FREE,
      opts.isTaxFree.value,
      {
        negative: "과세",
        positive: "면세",
      }
    ),
    active: opts.isTaxFree.active,
  });
  filterStructure.push({
    ...createBooleanField(
      displayOrder++,
      ProductFilterKeys.requiredExpDateMgmt,
      "유통기한 관리 유무",
      opts.requiredExpDateMgmt.value,
      {
        negative: "무",
        positive: "유",
      }
    ),
    active: opts.requiredExpDateMgmt.active,
  });
  if (isFulfilledByVendor === false) {
    filterStructure.push(
      {
        ...createBooleanField(displayOrder++, ProductFilterKeys.isExclusive, "전용여부", opts.isExclusive.value, {
          negative: "범용",
          positive: "전용",
        }),
        active: opts.isExclusive.active,
      },
      {
        ...createPriceField(displayOrder++, ProductFilterKeys.costPrice, "협력사 매입가", opts.costPrice.value),
        active: opts.costPrice.active,
      },
      {
        ...createPriceField(displayOrder++, ProductFilterKeys.deliveryFee, "택배비", opts.deliveryFee.value),
        active: opts.deliveryFee.active,
      }
    );
  }
  filterStructure.push(
    {
      ...createAutocompleteField(
        displayOrder++,
        ProductFilterKeys.categories,
        sectionNames.categories,
        opts.categories.value,
        opts.categories.displayValues,
        true,
        opts.categories.choices,
        {
          hasMore: opts.categories.hasMore,
          initialSearch: "",
          loading: opts.categories.loading,
          onFetchMore: opts.categories.onFetchMore,
          onSearchChange: opts.categories.onSearchChange,
        }
      ),
      active: opts.categories.active,
    },
    {
      ...createAutocompleteField(
        displayOrder++,
        ProductFilterKeys.collections,
        sectionNames.collections,
        opts.collections.value,
        opts.collections.displayValues,
        true,
        opts.collections.choices,
        {
          hasMore: opts.collections.hasMore,
          initialSearch: "",
          loading: opts.collections.loading,
          onFetchMore: opts.collections.onFetchMore,
          onSearchChange: opts.collections.onSearchChange,
        }
      ),
      active: opts.collections.active,
    }
  );
  if (isFulfilledByVendor === false) {
    filterStructure.push({
      ...createAutocompleteField(
        displayOrder++,
        ProductFilterKeys.productType,
        sectionNames.productTypes,
        opts.productType.value,
        opts.productType.displayValues,
        true,
        opts.productType.choices,
        {
          hasMore: opts.productType.hasMore,
          initialSearch: "",
          loading: opts.productType.loading,
          onFetchMore: opts.productType.onFetchMore,
          onSearchChange: opts.productType.onSearchChange,
        }
      ),
      active: opts.productType.active,
    });
  }
  filterStructure.push(
    ...opts.attributes.map((attr) => ({
      ...createOptionsField(displayOrder++, attr.slug as any, attr.name, attr.value, true, attr.choices),
      active: attr.active,
      group: ProductFilterKeys.attributes,
    }))
  );
  return filterStructure;
}
</file>

