// 재고/입고 라벨 출력 시 로케이션 이름 리턴
// 재고 라벨 출력 시엔 productVariant, 입고 라벨 출력 시엔 stockDetailEvent 전달
export const getLocationNameForLabel = (props: {
  productVariant?: Pick<SearchProductVariantsForLabel_search_edges_node, "rackStocks">;
  stockDetailEvent?: Pick<SearchStockDetailEventsForLabel_search_edges_node, "type" | "parameters" | "stock">;
}) => {
  if (utils.isEmpty(props)) {
    return "-";
  }

  const { productVariant } = props;
  if (utils.isEmpty(productVariant) === false) {
    const { rackStocks } = productVariant;
    if (utils.isEmpty(rackStocks)) {
      return "-";
    }
    const locationList = rackStocks.map((rackStock) => rackStock.location);
    const pickingLocationList = locationList.filter((location) => location.canPicking);
    if (utils.isEmpty(pickingLocationList)) {
      return "-";
    }
    return pickingLocationList[0].name || "-";
  }

  const { stockDetailEvent } = props;
  if (utils.isEmpty(stockDetailEvent) === false) {
    const toLocationName = getToLocationByStockDetailEvent(stockDetailEvent) || "-";
    const { rackStocks } = stockDetailEvent.stock?.productVariant;
    if (utils.isEmpty(rackStocks)) {
      return toLocationName;
    }
    const locationList = rackStocks.map((rackStock) => rackStock.location);
    const pickingLocationList = locationList.filter((location) => location.canPicking);
    if (utils.isEmpty(pickingLocationList)) {
      return toLocationName;
    }
    return pickingLocationList[0].name || "-";
  }

  return "-";
};

export const getFulfilledLocationsText = (
  fulfillmentLine: Pick<
    | FulfillmentAllList_fulfillments_edges_node_lines
    | FulfillmentList_fulfillments_edges_node_lines
    | BatchPickingList_batchPickingList_edges_node_fulfillments_lines,
    "stockDetailLines"
  >
) => {
  if (utils.isEmpty(fulfillmentLine) || utils.isEmpty(fulfillmentLine.stockDetailLines)) {
    return "-";
  }

  const fulfilledLocations =
    fulfillmentLine.stockDetailLines.map((stockDetail) => stockDetail.rackLocation).filter(Boolean) || [];
  if (utils.isEmpty(fulfilledLocations)) {
    return "-";
  }
  const uniqueLocations = Array.from(new Set(fulfilledLocations.map((location) => location.id))).map((id) =>
    fulfilledLocations.find((location) => location.id === id)
  );
  return uniqueLocations
    .map((location) => {
      const warehouse = location?.sector?.address?.companyName || "";
      const sector = location?.sector?.name || "";
      const locationName = location?.name || "";

      // 물류주소명 + 구역명 + 로케이션명
      const parts = [warehouse, sector, locationName].filter((part) => part);
      return parts.join(" / ");
    })
    .join(", ");
};

