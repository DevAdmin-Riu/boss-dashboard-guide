import { User } from "@src/api/fragments/types/User";
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { transformPhoneNumber } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { FormInstance } from "antd";

import { CreateAdminOrderAddressForm, CreateAdminOrderForm, ICreateAdminOrderFormLine } from "./CreateAdminOrderView";

export const validateOrderLineQty = (selectedProductData: ICreateAdminOrderFormLine[]) => {
  const checkProductData = selectedProductData.filter((product) => product.qty === 0);
  return checkProductData.length === 0;
};

export const validateInputData = (
  formValue: CreateAdminOrderForm,
  validAddressInfo: CreateAdminOrderAddressForm | null,
  isByStaffForBrand: boolean,
  isByStaffForBadStock: boolean,
  isByStaffForB2b: boolean,
  isByHqStaffForBrand: boolean
) => {
  const {
    customerNote,
    customerUser,
    linesObj,
    openMallName,
    openMallOrderNumber,
    estimatedArrivalDate,
    estimatedArrivalDateDoesntMatter,
  } = formValue;

  if (utils.isEmpty(validAddressInfo?.firstName, true)) {
    showNotificationError("배송지 받는사람(주문자) 정보를 확인해주세요.");
    return false;
  }
  if (utils.isEmpty(validAddressInfo?.phone, true)) {
    showNotificationError("배송지 받는사람 연락처를 확인해주세요.");
    return false;
  }
  if (utils.isEmpty(validAddressInfo?.streetAddress1, true)) {
    showNotificationError("배송지 주소를 확인해주세요.");
    return false;
  }
  if (utils.isEmpty(validAddressInfo?.postalCode, true) || validAddressInfo?.postalCode.length < 5) {
    showNotificationError("우편번호를 확인해주세요.");
    return false;
  }

  // 대행주문 체크
  if (isByStaffForBrand || isByStaffForB2b || isByHqStaffForBrand) {
    if (utils.isEmpty(customerUser)) {
      showNotificationError("회원 정보를 선택해주세요.");
      return false;
    }

    if (estimatedArrivalDate === null && !estimatedArrivalDateDoesntMatter) {
      showNotificationError("납품요청일를 지정해주세요.");
      return false;
    }
  }

  // 오픈몰주문 체크
  if (isByStaffForBadStock) {
    if (utils.isEmpty(openMallName, true)) {
      showNotificationError("오픈몰명을 작성해주세요.");
      return false;
    }
    if (utils.isEmpty(openMallOrderNumber, true)) {
      showNotificationError("오픈몰 주문번호를 작성해주세요.");
      return false;
    }
  }
  const createFormLines = convertFormLinesObjToArr(linesObj, "id");
  if (createFormLines.length === 0) {
    showNotificationError("상품을 선택해주세요.");
  }

  // 공통 체크
  if (validateOrderLineQty(createFormLines) === false) {
    showNotificationError("주문 수량이 0인 상품이 존재하여 주문을 진행할 수 없습니다.");
    return false;
  }

  if (customerNote.length > 100) {
    showNotificationError("배송시 요청사항은 100자 이하로 작성해주세요.");
    return false;
  }

  return true;
};

export const setCustomerUserAndAddressInfo = (
  form: FormInstance<CreateAdminOrderForm>,
  user: SearchCustomersForAdminOrder_search_edges_node | User | null
) => {
  form.setFieldsValue({
    customerUser: user,
    firstName: user?.defaultShippingAddress?.firstName,
    phone: utils.isEmpty(user?.defaultShippingAddress?.phone)
      ? ""
      : transformPhoneNumber(user?.defaultShippingAddress?.phone),
    postalCode: user?.defaultShippingAddress?.postalCode,
    streetAddress1: user?.defaultShippingAddress?.streetAddress1,
    streetAddress2: user?.defaultShippingAddress?.streetAddress2,
  });
};

export const isValidAddressInfo = (addressInfo: CreateAdminOrderAddressForm): boolean =>
  utils.isEmpty(addressInfo.firstName, true) === false &&
  utils.isEmpty(addressInfo.phone, true) === false &&
  utils.isEmpty(addressInfo.postalCode, true) === false &&
  utils.isEmpty(addressInfo.streetAddress1, true) === false;

export const getCustomerAddressInfo = (
  form: FormInstance<CreateAdminOrderForm>,
  user: SearchCustomersForAdminOrder_search_edges_node | User | null
): CreateAdminOrderAddressForm => {
  const defaultAddress = user?.defaultShippingAddress;
  const firstNameFormValue = form.getFieldValue("firstName");
  const phoneFormValue = form.getFieldValue("phone");
  const postalCodeFormValue = form.getFieldValue("postalCode");
  const streetAddress1FormValue = form.getFieldValue("streetAddress1");
  const streetAddress2FormValue = form.getFieldValue("streetAddress2");
  return {
    firstName:
      firstNameFormValue !== undefined && firstNameFormValue != null
        ? firstNameFormValue
        : defaultAddress?.firstName || "",
    phone:
      phoneFormValue !== undefined && phoneFormValue != null
        ? phoneFormValue
        : utils.isEmpty(defaultAddress.phone)
        ? ""
        : transformPhoneNumber(defaultAddress.phone) || "",
    postalCode:
      postalCodeFormValue !== undefined && postalCodeFormValue != null
        ? postalCodeFormValue
        : defaultAddress?.postalCode || "",
    streetAddress1:
      streetAddress1FormValue !== undefined && streetAddress1FormValue != null
        ? streetAddress1FormValue
        : defaultAddress?.streetAddress1 || "",
    streetAddress2:
      streetAddress2FormValue !== undefined && streetAddress2FormValue != null
        ? streetAddress2FormValue
        : defaultAddress?.streetAddress2 || "",
  };
};
