import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import { creditsEventFragmentForUserDetails, rcoinsEventFragmentForUserDetails } from "@src/api/fragments/points";
import gql from "graphql-tag";

import { CreditsEventList, CreditsEventListVariables } from "./types/CreditsEventList";
import { RcoinsEventList, RcoinsEventListVariables } from "./types/RcoinsEventList";

export const creditsEventListQuery = gql`
  ${creditsEventFragmentForUserDetails}
  ${pageInfoFragment}
  query CreditsEventList($after: String, $before: String, $first: Int, $last: Int, $filter: CreditsEventFilterInput) {
    creditsEvents(after: $after, before: $before, first: $first, last: $last, filter: $filter) {
      edges {
        node {
          ...CreditsEventFragmentForUserDetails
          user {
            id
            isHqStaff
            loginId
            firstName
            bizRegNo
            brand {
              id
              code
              name
            }
            brandStoreUser {
              id
              brandStore {
                id
                name
                code
              }
            }
          }
          staff {
            id
            firstName
          }
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
      totalCount
    }
  }
`;
