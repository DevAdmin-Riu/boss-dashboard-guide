import { OrderDeliveryMethodsEnum, OrderLineFilterInput, OrderStatusFilter } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { isUnfulfillmentViewPickingOrder } from "@src/app/views/order/orders/components/UnfulfilledOrderLineListPage/utils";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  UnfulfilledOrderLineFilterKeys,
  UnfulfilledOrderLineListFilterOpts,
} from "../../components/UnfulfilledOrderLineListPage/filters";
import {
  UnfulfilledOrderLineListViewUrlFilters,
  UnfulfilledOrderLineListViewUrlFiltersEnum,
  UnfulfilledOrderLineListViewUrlFiltersWithMultipleValuesEnum,
  UnfulfilledOrderLineListViewUrlQueryParams,
} from "../../urls";

const UNFULFILLED_ORDER_FILTERS_KEY = "unfulfilledOrdertFilters";

export function getFilterOpts(params: UnfulfilledOrderLineListViewUrlFilters): UnfulfilledOrderLineListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    orderStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderStatus, true), false),
      value: maybe(() => dedupeFilter(filterVariables.orderStatus)),
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: filterVariables.orderSearch || "",
    },
    paymentSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.paymentSearch, true), false),
      value: filterVariables.paymentSearch || "",
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: filterVariables.userSearch || "",
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.orderCreated.gte, filterVariables.orderCreated.lte]), false),
      value: {
        max: maybe(() => filterVariables.orderCreated.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.orderCreated.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    deliveryMethods: {
      active: maybe(() => !utils.isEmpty(filterVariables.deliveryMethods), false),
      value: maybe(() => dedupeFilter(filterVariables.deliveryMethods), []),
    },
  };
}

export function getFilterVariables(params: UnfulfilledOrderLineListViewUrlFilters): OrderLineFilterInput {
  const { unfulfillmentViewType } = params;
  const isViewPickingOrder = isUnfulfillmentViewPickingOrder(unfulfillmentViewType);

  return {
    orderStatus: maybe(() => params.orderStatus.map((status) => findValueInEnum(status, OrderStatusFilter))),
    deliveryMethods: maybe(() => params.deliveryMethods.map((status) => findInEnum(status, OrderDeliveryMethodsEnum))),
    orderSearch: params.orderSearch,
    paymentSearch: params.paymentSearch,
    userSearch: params.userSearch,
    brandSearch: params.brandSearch,
    orderCreated: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    fulfilled: false,
    // 위탁 출고 관련 페이지는 OrderLineListView에서 처리하고 있으므로 true 전달
    isTrackInventoryFulfillment: true,
    isPickingOrder: isViewPickingOrder,
    isFulfilledByVendor: false, // 직거래 상품 안보이게 하기
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<UnfulfilledOrderLineFilterKeys>
): UnfulfilledOrderLineListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case UnfulfilledOrderLineFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, UnfulfilledOrderLineListViewUrlFiltersEnum.orderSearch);
    case UnfulfilledOrderLineFilterKeys.paymentSearch:
      return getSingleValueQueryParam(filter, UnfulfilledOrderLineListViewUrlFiltersEnum.paymentSearch);
    case UnfulfilledOrderLineFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, UnfulfilledOrderLineListViewUrlFiltersEnum.userSearch);
    case UnfulfilledOrderLineFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, UnfulfilledOrderLineListViewUrlFiltersEnum.brandSearch);
    case UnfulfilledOrderLineFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        UnfulfilledOrderLineListViewUrlFiltersEnum.createdFrom,
        UnfulfilledOrderLineListViewUrlFiltersEnum.createdTo
      );
    case UnfulfilledOrderLineFilterKeys.orderStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        UnfulfilledOrderLineListViewUrlFiltersWithMultipleValuesEnum.orderStatus,
        OrderStatusFilter
      );
    case UnfulfilledOrderLineFilterKeys.deliveryMethods:
      return getMultipleEnumValueQueryParam(
        filter,
        UnfulfilledOrderLineListViewUrlFiltersWithMultipleValuesEnum.deliveryMethods,
        OrderDeliveryMethodsEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<UnfulfilledOrderLineListViewUrlFilters>(UNFULFILLED_ORDER_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  UnfulfilledOrderLineListViewUrlQueryParams,
  UnfulfilledOrderLineListViewUrlFilters
>({
  ...UnfulfilledOrderLineListViewUrlFiltersEnum,
  ...UnfulfilledOrderLineListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

<file path="src/app/views/order/orders/views/UnfulfilledOrderLineListView/UnfulfilledOrderLineListView.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import { OrderDirection, OrderLineSortField, PickingOrderFulfillInput } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import {
  useOrderBulkChangeTrackInventoryBeforeMutation,
  useOrderFulfillBulkMutation,
  useOrderFulfillMutation,
  usePickingOrderFulfillMutation,
} from "../../api/mutations";
import {
  orderLineListForFulfillQuery,
  useOrderLineListForFulfillFilterDownloadQuery,
  useOrderLineListForFulfillQuery,
} from "../../api/queries";
import { OrderLineListForFulfillVariables } from "../../api/types/OrderLineListForFulfill";
import { PickingOrderFulfillModal } from "../../components/PickingOrderFulfillModal/PickingOrderFulfillModal";
import UnfulfilledOrderLineListPage from "../../components/UnfulfilledOrderLineListPage/UnfulfilledOrderLineListPage";
import {
  isUnfulfillmentViewPickingOrder,
  UnfulfillmentViewTypeEnum,
} from "../../components/UnfulfilledOrderLineListPage/utils";
import {
  orderDetailsViewUrl,
  unfulfilledOrderLineListViewUrlA,
  unfulfilledOrderLineListViewUrlC,
  unfulfilledOrderLineListViewUrlD,
  UnfulfilledOrderLineListViewUrlDialog,
  UnfulfilledOrderLineListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface UnfulfilledOrderLineListViewProps {
  defaultParams: UnfulfilledOrderLineListViewUrlQueryParams;
  params: UnfulfilledOrderLineListViewUrlQueryParams;
}

enum UnfulfillmentOrderLineListModalModeEnum {
  FulfillPickingOrder = "FulfillPickingOrder",
}

export const UnfulfilledOrderLineListView: React.FC<UnfulfilledOrderLineListViewProps> = ({
  defaultParams,
  params,
}) => {
  const { unfulfillmentViewType } = params;
  const { user } = useUser();

  const [modalMode, setModalMode] = useState<UnfulfillmentOrderLineListModalModeEnum>(null);
  const resetForCloseModal = () => setModalMode(null);
  const openModalWithoutNavigate = (modalMode: UnfulfillmentOrderLineListModalModeEnum) => setModalMode(modalMode);

  let targetUrl: (params?: UnfulfilledOrderLineListViewUrlQueryParams) => string;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.UNFULFILLED_ORDER_LIST,
    setPaginationState:
      unfulfillmentViewType === UnfulfillmentViewTypeEnum.PICKING_ORDER
        ? { first: GrapheneRelayConnectionMaxLimitEnum.orderLinesForPicking }
        : null,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useOrderLineListForFulfillFilterDownloadQuery);

  let windowTitle: string;
  switch (unfulfillmentViewType) {
    case UnfulfillmentViewTypeEnum.STOCK:
      targetUrl = unfulfilledOrderLineListViewUrlA;
      windowTitle = firstDepthMenuTitle.stock;
      break;
    case UnfulfillmentViewTypeEnum.STOCK_ETC:
      targetUrl = unfulfilledOrderLineListViewUrlC;
      windowTitle = firstDepthMenuTitle.stock;
      break;
    case UnfulfillmentViewTypeEnum.PICKING_ORDER:
      targetUrl = unfulfilledOrderLineListViewUrlD;
      windowTitle = firstDepthMenuTitle.stock;
      break;
    default:
      targetUrl = unfulfilledOrderLineListViewUrlA;
      break;
  }

  const isViewPickOrder = isUnfulfillmentViewPickingOrder(unfulfillmentViewType);
  const queryVariables: OrderLineListForFulfillVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: getFilterVariables(params),
      sort: { direction: OrderDirection.DESC, field: OrderLineSortField.NUMBER },
      forPickingOrder: isViewPickOrder,
      isStaff: user.isStaff,
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useOrderLineListForFulfillQuery({
    variables: queryVariables,
  });

  const orderLines = maybe(() => data.orderLines.edges.map((edge) => edge.node), []);

  const [fulfillOrder, fulfillOrderOpts] = useOrderFulfillMutation({
    onCompleted: (data) => {
      const errors = data.orderFulfill.errors;
      if (errors.length === 0) {
        showNotificationSuccess("출고가 완료되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [orderLineListForFulfillQuery],
  });

  const [fulfillOrderBulk, fulfillOrderBulkOpts] = useOrderFulfillBulkMutation({
    onCompleted: (data) => {
      const errors = data.orderFulfillBulk.errors;
      if (errors.length === 0) {
        showNotificationSuccess("출고가 완료되었습니다.");
      } else {
        showGqlErrors(errors, undefined, false);
      }
    },
    refetchQueries: [orderLineListForFulfillQuery],
  });

  const [changeTrackInventoryOrderBulk, changeTrackInventoryOrderBulkOpts] =
    useOrderBulkChangeTrackInventoryBeforeMutation({
      onCompleted: (data) => {
        const errors = data.orderLineBulkChangeTrackInventoryBeforeFulfilled.errors;
        if (errors.length === 0) {
          showNotificationSuccess("출고유형 변경이 완료되었습니다.");
        } else {
          showGqlErrors(errors, undefined, false);
        }
      },
      refetchQueries: [orderLineListForFulfillQuery],
    });

  const [pickingOrderFulfill, pickingOrderFulfillOpts] = usePickingOrderFulfillMutation({
    onCompleted: (data) => {
      const errors = data.pickingOrderFulfill.errors;
      if (errors.length === 0) {
        showNotificationSuccess(
          `피킹이 완료되었습니다. 피킹이 완료된 배송건은 [${firstDepthMenuTitle.delivery} > ${sectionNames.batchPicking}] 페이지에서 확인 가능합니다.`
        );
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [orderLineListForFulfillQuery],
  });

  const handlePickingOrderFulfill = (input: PickingOrderFulfillInput) => {
    const { orderLineIds } = input;
    if (utils.isEmpty(orderLineIds)) {
      showNotificationError("제외된 주문 외에 합포장 피킹을 진행할 수 있는 주문이 존재하지 않습니다.");
      return;
    }
    pickingOrderFulfill({ variables: { input } });
  };

  const shouldConfirmForPickingOrder =
    isViewPickOrder && orderLines.some((orderLine) => orderLine.remainOuterVirtualAllocate > 0);
  const onPickingOrderFulfillClick = () => {
    if (shouldConfirmForPickingOrder) {
      openModalWithoutNavigate(UnfulfillmentOrderLineListModalModeEnum.FulfillPickingOrder);
    } else {
      const orderLineIds = orderLines.map((orderLine) => orderLine.id);
      handlePickingOrderFulfill({ orderLineIds });
    }
  };

  const pageDisabled =
    loading ||
    fulfillOrderBulkOpts.loading ||
    fulfillOrderOpts.loading ||
    pickingOrderFulfillOpts.loading ||
    changeTrackInventoryOrderBulkOpts.loading;

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<UnfulfilledOrderLineListViewUrlDialog, UnfulfilledOrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <WindowTitle title={windowTitle} />
      <UnfulfilledOrderLineListPage
        settings={settings}
        disabled={pageDisabled}
        unfulfillmentViewType={unfulfillmentViewType}
        orderLines={orderLines}
        pageInfo={pageInfo}
        onSubmit={fulfillOrder}
        onSubmitBulk={fulfillOrderBulk}
        onSubmitChangeTrackInventory={changeTrackInventoryOrderBulk}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onPickingOrderFulfill={onPickingOrderFulfillClick}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      {isViewPickOrder && (
        <PickingOrderFulfillModal
          open={modalMode === UnfulfillmentOrderLineListModalModeEnum.FulfillPickingOrder}
          loading={pageDisabled}
          orderLines={orderLines}
          onSubmit={handlePickingOrderFulfill}
          onClose={resetForCloseModal}
        />
      )}
    </>
  );
};
</file>

