interface CommonProps {
  TypeSafeForm: TypeSafeForm<TPreFounderConsultationCreateFormData | PreFounderConsultationUpdateInput>;
}
type CreateProps = CommonProps & {
  isCreate: true;
};
type UpdateProps = CommonProps & {
  isCreate: false;
  consultation: HqPreFounderConsultationDetails_preFounderConsultation;
  editModeProps: FormSaveButtonEditModeProps;
};
type PreFounderConsultationInfoProps = CreateProps | UpdateProps;

export const PreFounderConsultationInfo: React.FC<PreFounderConsultationInfoProps> = (props) => {
  const { isCreate, TypeSafeForm } = props;
  const { user } = useUser();
  const isUpdate = isCreate === false;
  const isEditMode = isUpdate ? props.editModeProps.isEditMode : true;
  const { formInstance } = TypeSafeForm;

  const makeCardSubTitleTextArr = (): string[] => {
    const makeDisplayUser = (user: Pick<User, "firstName" | "loginId">) =>
      `${user.firstName || "-"}(${user.loginId || "-"})`;

    if (isCreate) {
      return [`상담자: ${makeDisplayUser(user)}`];
    }
    if (isUpdate) {
      const { consultation } = props;
      const consultationList = consultation.preFounder.consultations;
      const consultationCount = consultationList.length;
      const consultationIdx = consultationList.findIndex((c) => c.id === consultation.id);
      const sequence = consultationCount - consultationIdx;
      const createdAtText = getDateByFormat(consultation.createdAt, onlyDateFormat);
      return [`#${sequence}`, `등록일: ${createdAtText}`, `상담자: ${makeDisplayUser(consultation.createUser)}`];
    }
    return [];
  };

  const cardTitle = (
    <PageHeader
      title="상담 정보"
      subTitle={
        <Space size="small" split="|">
          {makeCardSubTitleTextArr().map((text, idx) => (
            <Typography.Text key={idx} type="secondary">
              {text}
            </Typography.Text>
          ))}
        </Space>
      }
    />
  );
  const cardExtra = isUpdate && <FormSaveButton {...props.editModeProps} form={formInstance} />;

  return (
    <Card title={cardTitle} extra={cardExtra}>
      <Row justify="space-between" gutter={[12, 8]}>
        <Col xs={24} sm={8}>
          <EditableField
            type="datepicker"
            name={TypeSafeForm.getValidDataIndex("consultationDate")}
            value={TypeSafeForm.getFieldValue("consultationDate")}
            label="상담일"
            rules={[{ required: true }]}
            editMode={isEditMode}
            format={detailDateFormatWithHourMinute}
            formDateFormat={ISOFormatWithTimeZone}
            showTime={{ format: extractHourMinuteFormat }}
            renderValue={(value) => moment(value).format(detailDateFormatWithHourMinute)}
          />
        </Col>
        <Col xs={24} sm={8}>
          <EditableField
            type="select"
            name={TypeSafeForm.getValidDataIndex("method")}
            value={TypeSafeForm.getFieldValue("method")}
            label="상담방식"
            rules={[{ required: true }]}
            editMode={isEditMode}
            options={preFounderConsultationMethodChoices}
          />
        </Col>
        <Col xs={24} sm={8}>
          <EditableField
            type="select"
            name={TypeSafeForm.getValidDataIndex("result")}
            value={TypeSafeForm.getFieldValue("result")}
            label="상담결과"
            rules={[{ required: true }]}
            editMode={isEditMode}
            options={preFounderConsultationResultChoices}
          />
        </Col>
        <Col span={24}>
          <EditableField
            type="input"
            name={TypeSafeForm.getValidDataIndex("title")}
            value={TypeSafeForm.getFieldValue("title")}
            label="제목"
            rules={[{ required: true, message: formRuleMsg.required }]}
            editMode={isEditMode}
          />
        </Col>
        <Col span={24}>
          <EditableField
            type="editor"
            name={TypeSafeForm.getValidDataIndex("content")}
            editorInitialValue={TypeSafeForm.getFieldValue("content")}
            label="내용"
            rules={[{ required: true, message: formRuleMsg.required }]}
            editMode={isEditMode}
          />
        </Col>
      </Row>
    </Card>
  );
};
