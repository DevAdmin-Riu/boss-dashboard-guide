      const chargeStatusText = transformPaymentStatus({
        paymentStatus: parameters?.charge_status,
        status: null,
      }).localized;
      let returnMessage = utils.formatMessage(
        "대행주문 결제 상태 변경\n------------------" + "\n변경된 상태: {chargeStatusText}",
        {
          chargeStatusText,
        }
      );
      if (parameters?.charge_status === PaymentChargeStatusEnum.PENDING) {
        returnMessage += `\n반려 사유: ${receiptRefusedReason}`;
      }
      return returnMessage;

    case OrderEventsEnum.REVERT_FULFILLMENT_CANCELED: {
      const message = parameters?.message;
      let historyMsg = `발주서 출고 거부로 출고 취소 처리`;
      if (message) {
        historyMsg += `\n주문상세번호: ${message}`;
      }
      return historyMsg;
    }
    case OrderEventsEnum.REVERT_TRACKING_UPDATED: {
      const message = parameters?.message;
      let historyMsg = `발주서 출고 취소로 배송확정 정보 초기화`;
      if (message) {
        historyMsg += `\n주문상세번호: ${message}`;
      }
      return historyMsg;
    }
    default:
      return "주문 관리 이력: " + event.type;
  }
};

interface OrderHistoryProps {
  history: OrderDetails_order_events[];
  orderType: OrderType;
  onNoteAdd: (data: NoteFormData) => void;
}

export const OrderHistory: React.FC<OrderHistoryProps> = (props) => {
  const { history, orderType, onNoteAdd } = props;
  return (
    <>
      <Typography.Text style={{ fontSize: 20 }} type={"secondary"} strong>
        주문 관리 이력
      </Typography.Text>
      <Hr />
      {history ? (
        <Timeline>
          <Form initial={{ message: "" }} onSubmit={onNoteAdd} resetOnSubmit>
            {({ change, data, reset, submit }) => (
              <TimelineAddNote message={data.message} reset={reset} onChange={change} onSubmit={submit} />
            )}
          </Form>
          {history
            .slice()
            .reverse()
            .map((event) => (
              <TimelineNote
                date={event.date}
                user={event.user}
                message={getEventMessage(event, orderType)}
                key={event.id}
              />
            ))}
        </Timeline>
      ) : (
        <Skeleton />
      )}
    </>
  );
};
</file>

<file path="src/app/views/order/orders/components/OrderLineVendorUpdateModal.tsx">
import { ArrowDownOutlined } from "@ant-design/icons";
import { commonMsg } from "@assets/messages/commonMsg";
import { ConsignmentOrderLineUpdateVendorInput } from "@src/api/types/globalTypes";
import { getInputNumberClassName } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { getMoneyFormat } from "@src/app/views/product/products/utils/data";
import { makePurchaseOrderLineNumber } from "@src/app/views/purchase/purchaseOrders/utils";
import { getBrandName, makeVendorDisplayName } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import {
  DatePicker,
  Descriptions,
  DescriptionsProps,
  Form,
  InputNumber,
  Modal,
  Row,
  Select,
  Space,
  Typography,
} from "antd";
import { DefaultOptionType } from "antd/lib/select";
import moment, { Moment } from "moment";
import React, { useEffect } from "react";

import { useConsignmentOrderLineUpdateVendorMutation } from "../api/mutations";
import { orderLineListQuery } from "../api/queries";
import {
  OrderLineList_orderLines_edges_node,
  OrderLineList_orderLines_edges_node_variant_productVariantVendors,
} from "../api/types/OrderLineList";

interface OrderLineVendorUpdateModalProps {
  open: boolean;
  loading: boolean;
  orderLine: OrderLineList_orderLines_edges_node;
  onClose: () => void;
}

const { Item: DItem } = Descriptions;
const { Item: FItem } = Form;
const {
  product: productCol,
  brand: brandCol,
  user: userCol,
  order: orderCol,
  delivery: deliveryCol,
  vendor: vendorCol,
  purchaseOrder: purchaseOrderCol,
} = columnNameConstant;

const commonDescriptionsProps: DescriptionsProps = {
  bordered: true,
  size: "small",
  layout: "horizontal",
  column: 2,
  labelStyle: { width: "20%" },
  contentStyle: { width: "30%" },
};

export const OrderLineVendorUpdateModal: React.FC<OrderLineVendorUpdateModalProps> = (props) => {
  const { open, loading, orderLine, onClose } = props;
  const [form] = Form.useForm<ConsignmentOrderLineUpdateVendorInput>();

  const initialValues: ConsignmentOrderLineUpdateVendorInput = {
    purchaseDate: null,
    vendorId: null,
    unitCostPriceExcludeVat: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [consignmentOrderLineUpdateVendor, consignmentOrderLineUpdateVendorOpts] =
    useConsignmentOrderLineUpdateVendorMutation({
      onCompleted: (data) => {
        const errors = data.consignmentOrderLineUpdateVendor.errors;
        if (errors.length === 0) {
          showNotificationSuccess(`주문상세번호 ${orderLineComposedId}의 위탁 발주 정보가 변경되었습니다.`);
          onClose();
        } else {
          showGqlErrors(errors);
        }
      },
      refetchQueries: [orderLineListQuery],
    });

  const modalLoading = loading || consignmentOrderLineUpdateVendorOpts.loading;

  // 출고일(매입일)은 오늘 일자가
  // 1~10일이면 저번달 1일~오늘까지만 선택 가능
  // 11일 이후면 이번달 1일~오늘까지만 선택 가능
  const disabledDate = (current: Moment) => {
    const today = moment();
    const todayDateNumber = today.date();
    const isSameOrBeforeToday = current.isSameOrBefore(today);

    if (todayDateNumber <= 10) {
      const firstDayOfLastMonth = today.clone().subtract(1, "month").startOf("month");
      const isSameOrAfter1stDayOfLastMonth = current.isSameOrAfter(firstDayOfLastMonth);
      const isAvailable = isSameOrAfter1stDayOfLastMonth && isSameOrBeforeToday;
      return !isAvailable;
    } else {
      const firstDayOfThisMonth = today.clone().startOf("month");
      const isSameOrAfter1stDayOfThisMonth = current.isSameOrAfter(firstDayOfThisMonth);
      const isAvailable = isSameOrAfter1stDayOfThisMonth && isSameOrBeforeToday;
      return !isAvailable;
    }
  };

  // Descriptions, Form의 각 Item에 표시될 정보.
  // orderLine이 없을 때 return null을 하면, 모달을 close할 때 닫히는 애니메이션이 아니라 모달이 바로 사라지는 것처럼 보여서 아래와 같이 처리
  let user;
  let orderLineComposedId = "";
  let orderCreated = "";
  let purchaseOrderLineNumber = "";
  let purchaseDate = "";
  let brandCode = "";
  let brandName = "";
  let loginId = "";
  let firstName = "";
  let productSku = "";
  let productName = "";
  let fulfilledVendorDisplayName = "";
  let fulfilledUnitCostPriceExcludeVatText = "";
  let productVariantVendors: OrderLineList_orderLines_edges_node_variant_productVariantVendors[] = [];
  let vendorOptions: DefaultOptionType[] = [];

  const orderLineExist = utils.isEmpty(orderLine) === false;
  if (orderLineExist) {
    const { composedIdWithPrefix, order, variant, purchaseOrderLine, fulfillmentLines } = orderLine;
    orderCreated = getDateByFormat(order.created, onlyDateFormat);
    orderLineComposedId = composedIdWithPrefix;
    purchaseOrderLineNumber = !!purchaseOrderLine ? makePurchaseOrderLineNumber(purchaseOrderLine) : "-";
    purchaseDate = getDateByFormat(purchaseOrderLine.purchase?.purchaseDate, onlyDateFormat);
    user = order.user;
    brandCode = user?.brand?.code || "-";
    brandName = getBrandName(user);
    loginId = user?.loginId || "-";
    firstName = user?.firstName || "-";
    productSku = orderLine.productSku || "-";
    productName = orderLine.variant.product.name || "-";
    const fulfilled = fulfillmentLines?.length > 0;
    const fulfillmentLine = fulfilled ? fulfillmentLines[0] : null;
    const fulfilledVendor = fulfillmentLine?.vendor;
    fulfilledVendorDisplayName = makeVendorDisplayName(fulfilledVendor);
    fulfilledUnitCostPriceExcludeVatText = getMoneyFormat(fulfillmentLine?.unitCostPriceExcludeVat);

    productVariantVendors = variant?.productVariantVendors || [];
    const activeProductVariantVendors = productVariantVendors.filter(
      (productVariantVendor) => productVariantVendor.isActive
    );
    vendorOptions = activeProductVariantVendors.map((productVariantVendor) => {
      const vendor = productVariantVendor.vendor;
      return { label: makeVendorDisplayName(vendor), value: vendor.id };
    });
  }

  return (
    <Modal
      forceRender
      destroyOnClose
      width={800}
      title="위탁 발주 정보 업데이트"
      open={open}
      onOk={form.submit}
      onCancel={onClose}
      okButtonProps={{ loading: modalLoading }}
      maskClosable={false}
    >
      <Form
        form={form}
        layout="vertical"
        initialValues={initialValues}
        name="consignment-order-line-update-vendor"
        onValuesChange={(changedValues) => {
          if ("vendorId" in changedValues) {
            const vendorId = changedValues.vendorId;
            const selectedVariantVendor = productVariantVendors.find(
              (productVariantVendor) => productVariantVendor.vendor.id === vendorId
            );
            const unitCostPriceExcludeVat =
              selectedVariantVendor.consignmentProductPriceExcludeVat +
              selectedVariantVendor.consignmentDeliveryFeeExcludeVat;
            form.setFieldsValue({ unitCostPriceExcludeVat });
          }
        }}
        onFinish={(input) => {
          const inputPurchaseDate: Moment = input.purchaseDate;
          const formattedPurchaseDate = inputPurchaseDate.format(onlyDateFormat);
          consignmentOrderLineUpdateVendor({
            variables: { id: orderLine?.id, input: { ...input, purchaseDate: formattedPurchaseDate } },
          });
        }}
      >
        <Space direction="vertical">
          <Descriptions {...commonDescriptionsProps} title="기존 발주 정보">
            <DItem label={orderCol.ORDER_LINE_COMPOSED_ID}>{orderLineComposedId}</DItem>
            <DItem label={orderCol.ORDER_DATE}>{orderCreated}</DItem>
            <DItem label={purchaseOrderCol.PO_LINE_NO}>{purchaseOrderLineNumber}</DItem>
            <DItem label={deliveryCol.FULFILLMENT_DATE + "(매입일)"}>{purchaseDate}</DItem>
            {user && <DItem label={brandCol.BRAND_CODE}>{brandCode}</DItem>}
            {user && <DItem label={brandCol.BRAND_NAME}>{brandName}</DItem>}
            {user && <DItem label={userCol.ID}>{loginId}</DItem>}
            {user && <DItem label={userCol.USER_NAME}>{firstName}</DItem>}
            <DItem label={productCol.SKU}>{productSku}</DItem>
            <DItem label={productCol.PRODUCT_NAME}>{productName}</DItem>
            <DItem label={vendorCol.VENDOR_NAME}>{fulfilledVendorDisplayName}</DItem>
            <DItem label={<MultiLineTypography lines={[productCol.VENDOR_COST_PRICE(false), commonMsg.excludeVat]} />}>
              <Row justify="end">
                <Typography.Text strong>{fulfilledUnitCostPriceExcludeVatText}</Typography.Text>
              </Row>
            </DItem>
          </Descriptions>
          <Row justify="center">
            <ArrowDownOutlined style={{ fontSize: "20px" }} />
          </Row>
          <Descriptions
            {...commonDescriptionsProps}
            title={
              <MultiLineTypography
                lines={[
                  "업데이트 확인",
                  <Typography.Text italic type="danger" style={{ fontSize: "12px" }}>
                    아래와 같이 출고 완료된 제품의 발주 정보가 업데이트 됩니다.
                  </Typography.Text>,
                ]}
              />
            }
          >
            <DItem label={orderCol.ORDER_LINE_COMPOSED_ID}>{orderLineComposedId}</DItem>
            <DItem label={deliveryCol.FULFILLMENT_DATE + "(매입일)"}>
              <FItem
                name="purchaseDate"
                style={{ margin: 0 }}
                rules={[{ required: true, message: "출고일(매입일)을 선택해 주세요." }]}
              >
                <DatePicker style={{ width: "100%" }} disabledDate={disabledDate} />
              </FItem>
            </DItem>
            <DItem label={vendorCol.VENDOR_NAME}>
              <FItem
                name="vendorId"
                style={{ margin: 0 }}
                rules={[{ required: true, message: "협력사를 선택해 주세요." }]}
              >
                <Select style={{ width: "200px" }} options={vendorOptions} placeholder="협력사 선택" />
              </FItem>
            </DItem>
            <DItem
              label={
                <MultiLineTypography
                  lines={[columnNameConstant.product.VENDOR_COST_PRICE(false), commonMsg.excludeVat]}
                />
              }
            >
              <FItem
                name="unitCostPriceExcludeVat"
                style={{ margin: 0 }}
                rules={[{ required: true, type: "integer", min: 1, message: "협력사 매입가는 0보다 커야 합니다." }]}
              >
                <InputNumber
                  readOnly
                  bordered={false}
                  controls={false}
                  style={{ color: "blue" }}
                  className={getInputNumberClassName(["ant-input-number-right-align", "ant-input-number-bold"])}
                  formatter={(value) => `${value}원`.replace(/\B(?=(\d{3})+(?!\d))/g, ",")}
                  parser={(value) => parseInt(value!.replace(/\$\s?|(,*)/g, ""), 10)}
                />
              </FItem>
            </DItem>
          </Descriptions>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

