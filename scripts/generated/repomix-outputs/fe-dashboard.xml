import { ActiveTab, BulkAction, Dialog, Pagination, Sort } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const bannerSectionUrl = "/banners";
export const bannerListViewPath = bannerSectionUrl;

export enum BannerListViewUrlSortField {
  start = "start",
  end = "end",
}

export type BannerListViewUrlSort = Sort<BannerListViewUrlSortField>;

export type BannerListViewUrlDialog = "update-shop-banner-settings" | "create-banner" | "cancel";

export type BannerListViewUrlQueryParams = BulkAction &
  Dialog<BannerListViewUrlDialog> &
  BannerListViewUrlSort &
  Pagination &
  ActiveTab;

export const bannerListViewUrl = (params?: BannerListViewUrlQueryParams): string => {
  if (params === undefined) {
    return bannerListViewPath;
  } else {
    return urlJoin(bannerListViewPath, "?" + stringifyQs(params));
  }
};

export const bannerDetailsViewPath = (id: string) => urlJoin(bannerSectionUrl, id);
export type BannerDetailsViewUrlQueryParams = BulkAction & Pagination;
export const bannerDetailsViewUrl = (id: string, params?: BannerDetailsViewUrlQueryParams) =>
  bannerDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);

export const bannerCreateViewPath = urlJoin(bannerSectionUrl, "add");
export const bannerCreateViewUrl = bannerCreateViewPath;
</file>

