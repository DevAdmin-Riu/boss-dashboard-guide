    categories: params.categories !== undefined ? params.categories : [],
    productSearch: params.productSearch,
    brandProductSearch: params.brandProductSearch,
    brandSearch: params.brandSearch,
    vendorSearch: params.vendorSearch,
    isTaxFree: params.isTaxFree !== undefined ? parseBoolean(params.isTaxFree, false) : undefined,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, false) : undefined,
    pvSalesStatus: maybe(() => params.pvSalesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    externalProductSearch: params.externalProductSearch,
    // excludePvSalesStatusStopped: true,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<FbvBrandProductVariantListFilterKeys>
): FbvBrandProductVariantListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case FbvBrandProductVariantListFilterKeys.categories:
      return getMultipleValueQueryParam(
