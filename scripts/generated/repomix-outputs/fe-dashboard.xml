import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps, getTableRowClassName } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React from "react";

import {
  VendorHistories,
  VendorHistories_vendorHistories_edges_node,
  VendorHistoriesVariables,
} from "../../api/types/VendorHistories";
import { VendorHistoryListViewUrlSortField } from "../../urls";
import { createFilterStructure, VendorHistoryFilterKeys, VendorHistoryListFilterOpts } from "./filters";
import { createSorterStructure } from "./sorters";
import { getVendorHistoryListTableColumns } from "./VendorHistoryListTableSettings";

interface VendorHistoryListPageProps
  extends PaginateListProps,
    FilterPageProps<VendorHistoryFilterKeys, VendorHistoryListFilterOpts>,
    SortPage<VendorHistoryListViewUrlSortField> {
  vendorHistories: VendorHistories_vendorHistories_edges_node[];
  vendorId?: string;

  queryVariablesWithoutPagination: VendorHistoriesVariables;
  fetchForDownload: (variables?: VendorHistoriesVariables) => Promise<ApolloQueryResult<VendorHistories>>;
}

export const VendorHistoryListPage: React.FC<VendorHistoryListPageProps> = ({
  vendorId,
  vendorHistories,
  currencySymbol,
  currentTab,
  filterOpts,
  tabs,
  sort,
  onAdd,
  onAll,
  onFilterChange,
  onTabChange,
  onTabDelete,
  onTabSave,
  onRowClick,
  onSort,
  queryVariablesWithoutPagination,
  fetchForDownload,
  ...listProps
}) => {
  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getVendorHistoryListTableColumns();
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  // vendor가 전달되는 경우는 상세페이지에서 넘어오는 경우임.
  const isVendorDetailsPage = !!vendorId;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "vendorHistories",
  };

  const pageTitle = (
    <Row justify="space-between">
      <Col>
        <Typography.Title level={4}>{sectionNames.vendorHistories}</Typography.Title>
      </Col>
      <Col>
        <Button type="primary" shape="round" onClick={onAdd}>
          이력 추가
        </Button>
      </Col>
    </Row>
  );

  return (
    <Space direction="vertical" size={24}>
      {isVendorDetailsPage === false && pageTitle}

      {/* 브랜드 상세 페이지에서 운영 이력 조회하는 경우, Card 내에 여백 없이 Table 노출하기 위해 padding = 0 적용 */}
      <Card title={isVendorDetailsPage && pageTitle} bodyStyle={isVendorDetailsPage ? { padding: 0 } : {}}>
        {isVendorDetailsPage === false && (
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            filterStructure={filterStructure}
            tabs={tabs}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabExtra={
              <>
                <ColumnPicker
                  columns={pickColumns}
                  loading={listProps.disabled}
                  initialColumns={initialColumns}
                  total={pickColumns?.length}
                  onSave={handleSave}
                />
                <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
              </>
            }
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
          />
        )}
        <Table
          {...commonTableProps}
          ref={tableRef}
          columns={pickerSelectedColumns}
          dataSource={vendorHistories}
          rowClassName={getTableRowClassName(["ant-table-row-link"])}
          onRow={(record) => ({ onClick: () => onRowClick(record?.id) })}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
</file>

