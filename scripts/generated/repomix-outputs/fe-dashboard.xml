import { transformOrderStatus, transformPaymentStatus } from "@assets/messages/status";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import StatusLabel from "@src/app/components/StatusLabel";
import DateTime from "@src/app/providers/DateProvider/DateTime";
import { utils } from "@utils/utils";
import { Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { BrandAccountDetails_user_orders_edges_node } from "../../api/types/BrandAccountDetails";
import { CustomerOrdersTableProps } from "./CustomerOrdersTable";

export function getCustomerOrdersTableColumns(props: CustomerOrdersTableProps) {
  const { onRowClick } = props;
  const columns: ColumnsType<BrandAccountDetails_user_orders_edges_node> = [
    {
      title: columnNameConstant.order.ORDER_COMPOSED_ID,
      key: "orderComposedId",
      align: "center",
      width: 100,
      render: (_, record) => (
        <Typography.Link onClick={() => onRowClick(record.id)}>{record.composedIdWithPrefix}</Typography.Link>
      ),
    },
    {
      title: columnNameConstant.order.ORDER_DATE,
      key: "created",
      align: "center",
      width: 180,
      render: (_, record) => <DateTime date={record.created} />,
    },
    {
      title: columnNameConstant.order.PAYMENT_STATUS,
      key: "paymentStatus",
      align: "left",
      width: 120,
      render: (_, record) => {
        const paymentStatus = transformPaymentStatus(record);
        return utils.isEmpty(paymentStatus.status) ? (
          "-"
        ) : (
          <StatusLabel useSmallDot status={paymentStatus.status} label={paymentStatus.localized} />
        );
      },
    },
    {
      title: columnNameConstant.delivery.DELIVERY_STATUS,
      key: "status",
      align: "left",
      width: 120,
      render: (_, record) => {
        const status = transformOrderStatus(record.status, record.isFullyTracking, record.isFullyTrackingCompleted);
        return utils.isEmpty(status.status) ? (
          "-"
        ) : (
          <StatusLabel useSmallDot status={status.status} label={status.localized} />
        );
      },
    },
    {
      title: "주문 금액",
      key: "totalGrossAmount",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record?.totalGrossAmount} />,
    },
  ];
  return columns;
}
