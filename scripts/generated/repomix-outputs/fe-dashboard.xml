export const makeProductQtyPerBoxFromPoLine = (
  record: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node, "attributeData">,
  qtyPerBoxUnitType: QtyPerBoxUnitTypeEnum
) => {
  const simpleAttribute = utils.jsonParseWrapper(record.attributeData);
  if (utils.isEmpty(simpleAttribute?.quantity)) {
    return "-";
  }
  return makeProductQtyPerBoxTextFromSimpleAttribute(simpleAttribute, qtyPerBoxUnitType);
};

const calcPoLineTotalPriceExcludeVatWatched = (
  props: StrictOmit<PurchaseOrderLineColProps, "sign" | "isVendorStaff">,
  record: PurchaseOrderLineList_purchaseOrderLines_edges_node
) => {
  const { courierDeliveryAdditionalFeeList, isConsignment, isB2b, formValuesWatched, isEditing } = props;
  if (isEditing && isEditing(record)) {
    const formTotalPriceExcludeVat = calcPoLineTotalPriceExcludeVat(
      {
        record: { ...record, ...formValuesWatched },
        courierDeliveryAdditionalFeeList,
        isConsignment,
        poEventType: record.purchaseOrder.eventType,
        isB2b,
      },
      record.variant.priceDecimalPlaces,
      record.status
    );
    return formTotalPriceExcludeVat;
  }
  const totalPriceExcludeVat = calcPoLineTotalPriceExcludeVat(
    {
      record,
      courierDeliveryAdditionalFeeList,
      isConsignment,
      poEventType: record.purchaseOrder.eventType,
      isB2b,
    },
    record.variant.priceDecimalPlaces,
    record.status
  );
  return totalPriceExcludeVat;
};

