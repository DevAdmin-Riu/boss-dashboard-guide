      delegatedReceivedCountByCourierAdjustPrice
      delegatedReceivedCountByNonCourier
      reqSplitDeliveryCount
      reqEpdUpdateCount
      dispatchFulfillmentCount
      consignmentDelegatedDispatchFulfillmentCountByCourier
      consignmentDelegatedDispatchFulfillmentCountByNonCourier
      deliveryConfirmedCount
      invoicePrintedCount
      toBeInspectedCount
      inspectedCount
      stockedCount
      deliveredCount
