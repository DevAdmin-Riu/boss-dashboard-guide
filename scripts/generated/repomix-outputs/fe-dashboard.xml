<file path="src/app/views/brand/brands/components/BrandBundleInfoUpdate.tsx">
import { MutationFunction } from "@apollo/client";
import { BpBundleUpdateInput, SalesStatusEnum, StoppedReasonTypeEnum } from "@src/api/types/globalTypes";
import CardSpacer from "@src/app/components/CardSpacer";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { Card, Col, DatePicker, Form, Input, Row, Select, Switch } from "antd";
import React, { useEffect } from "react";

import { BpBundle_bpBundle } from "../api/types/BpBundle";
import { BpBundleUpdate, BpBundleUpdateVariables } from "../api/types/BpBundleUpdate";
import UploadImage from "./ImageUpload";

interface BrandBundleInfoUpdateProps {
  bpBundle: BpBundle_bpBundle;
  selectedRowId: string;
  bpBundleUpdate: MutationFunction<BpBundleUpdate, BpBundleUpdateVariables>;
}

const salesStatusChoices = [
  { label: "정상 판매", value: SalesStatusEnum.ON_SALE },
  { label: "판매 대기", value: SalesStatusEnum.PENDING },
  { label: "중단", value: SalesStatusEnum.STOPPED },
  { label: "중단 예정", value: SalesStatusEnum.WILL_BE_STOPPED },
];

const BrandBundleInfoUpdate: React.FC<BrandBundleInfoUpdateProps> = (props) => {
  const { bpBundle, selectedRowId, bpBundleUpdate } = props;

  const form = Form.useFormInstance<BpBundleUpdateInput>();
  const shopData = useShop();
  const stoppedReasonChoices = shopData?.stoppedReasonChoices || [];

  const stoppedAtWatched = Form.useWatch("stoppedAt", form);
  const stoppedReasonWatched = Form.useWatch("stoppedReason", form);
  const showBeforePriceWatched = Form.useWatch("showBeforePrice", form);

  const showStoppedReasonEtc = stoppedReasonWatched === StoppedReasonTypeEnum.ETC;

  useEffect(() => {
    if (!stoppedAtWatched) {
      form.setFieldsValue({
        stoppedReason: null,
        stoppedReasonEtc: null,
      });
    }
  }, [stoppedAtWatched, form]);

  useEffect(() => {
    if (!showBeforePriceWatched) {
      form.setFieldsValue({
        beforePrice: 0,
      });
    }
  }, [showBeforePriceWatched, form]);

  return (
    <>
      <Card title="기본 정보" size="small">
        <Row gutter={[16, 8]}>
          <Col span={6}>
            <Form.Item label="상품명" name="name" rules={[{ required: true, message: "상품명을 입력하세요." }]}>
              <Input placeholder="상품명을 입력하세요" />
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="현금 전용" name="isOnlyPayableByCash" valuePropName="checked">
              <Switch checkedChildren="예" unCheckedChildren="아니오" />
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="충전금 혜택" name="isRcoinRewardForUsingPoint" valuePropName="checked">
              <Switch checkedChildren="예" unCheckedChildren="아니오" />
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="도서산간 추가 배송비" name="needDeliveryAdditionalFee" valuePropName="checked">
              <Switch checkedChildren="예" unCheckedChildren="아니오" />
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item
              label="판매상태"
              name="salesStatus"
              rules={[{ required: true, message: "판매상태를 선택하세요." }]}
            >
              <Select placeholder="판매상태 선택">
                {salesStatusChoices.map((choice) => (
                  <Select.Option key={choice.value} value={choice.value}>
                    {choice.label}
                  </Select.Option>
                ))}
              </Select>
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="중단일" name="stoppedAt">
              <DatePicker style={{ width: "100%" }} placeholder="중단일 선택" />
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="중단사유" name="stoppedReason">
              <Select placeholder="중단사유 선택" disabled={!stoppedAtWatched}>
                {stoppedReasonChoices.map((choice) => (
                  <Select.Option key={choice.value} value={choice.value}>
                    {choice.label}
                  </Select.Option>
                ))}
              </Select>
            </Form.Item>
          </Col>

          <Col span={6}>
            <Form.Item label="진열 상태" name="forceNoNormalDisplay">
              <Select placeholder="진열 상태 선택">
                <Select.Option value={false}>진열</Select.Option>
                <Select.Option value={true}>중단</Select.Option>
              </Select>
            </Form.Item>
          </Col>

          {showStoppedReasonEtc && (
            <Col span={24}>
              <Form.Item
                label="중단사유 상세"
                name="stoppedReasonEtc"
                rules={[{ required: true, message: "중단사유 상세를 입력하세요." }]}
              >
                <Input placeholder="중단사유 상세를 입력하세요" />
              </Form.Item>
            </Col>
          )}
        </Row>
      </Card>

      <CardSpacer />

      <Row gutter={[16, 16]}>
        <Col span={12}>
          <UploadImage
            title="썸네일 이미지"
            image={bpBundle.thumbnailImage}
            onImageDelete={() => {
              bpBundleUpdate({
                variables: {
                  id: selectedRowId,
                  input: {
                    thumbnailImage: null,
                  },
                },
              });
            }}
            onImageUpload={(file: File) => {
              bpBundleUpdate({
                variables: {
                  id: selectedRowId,
                  input: {
                    thumbnailImage: file,
                  },
                },
              });
            }}
          />
        </Col>
        <Col span={12}>
          <UploadImage
            title="디테일 이미지"
            image={bpBundle.detailImage}
            onImageDelete={() => {
              bpBundleUpdate({
                variables: {
                  id: selectedRowId,
                  input: {
                    detailImage: null,
                  },
                },
              });
            }}
            onImageUpload={(file: File) => {
              bpBundleUpdate({
                variables: {
                  id: selectedRowId,
                  input: {
                    detailImage: file,
                  },
                },
              });
            }}
          />
        </Col>
      </Row>
    </>
  );
};

export default BrandBundleInfoUpdate;
</file>

