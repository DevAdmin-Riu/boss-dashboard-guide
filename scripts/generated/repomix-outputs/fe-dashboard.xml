import { RefundBankCodeEnum } from "@src/api/types/globalTypes";
import { ShopInfo_shop_refundBankCodeChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, Input, Row, Select, Tag } from "antd";
import { FormInstance } from "antd/es/form";
import React, { useState } from "react";

import { useCheckAccountBankInfoMutation } from "../../api/mutations";
import { ExchangeAndRefundForm } from "../OrderRefundCreateModal/OrderRefundCreateModal";

interface RefundBankFormProps {
  setAccountBankCheckValue: React.Dispatch<React.SetStateAction<boolean>>;
  accountBankCheckValue: boolean;
  refundBankCodeChoices: ShopInfo_shop_refundBankCodeChoices[];
  isCancel?: boolean;
  form: FormInstance<ExchangeAndRefundForm>;
}

const RefundBankForm: React.FC<RefundBankFormProps> = (props) => {
  const { setAccountBankCheckValue, accountBankCheckValue, refundBankCodeChoices, isCancel = false, form } = props;

  const [debounce, setDebounce] = useState(false);
  const bankCodeWatched: RefundBankCodeEnum = Form.useWatch("bankCode", form);
  const accountNumberWatched: string = Form.useWatch("accountNumber", form);

  const btnDisabled =
    debounce ||
    accountBankCheckValue ||
    utils.isEmpty(bankCodeWatched, true) ||
    utils.isEmpty(accountNumberWatched, true);
  const [onCheckAccountBankInfoMutation, {}] = useCheckAccountBankInfoMutation({
    onCompleted: async (res) => {
      const errors = res.checkAccountBankInfo.errors;
      if (errors.length > 0) {
        showNotificationError(errors[0].message);
      } else {
        const accountName = res.checkAccountBankInfo.accountName;
        if (accountName.length > 0) {
          showNotificationSuccess("계좌 성명 확인이 완료되었습니다.");
          form.setFieldValue("accountHolderName", accountName);
          setAccountBankCheckValue(true);
        }
      }
    },
    onError: () => showNotificationError("계좌 확인 중 오류가 발생하였습니다. 고객센터에 문의해주세요."),
  });

  const checkAccountInfoOnClick = async () => {
    if (bankCodeWatched.trim().length < 2 && bankCodeWatched.trim().length < 10) {
      showNotificationError("가상계좌 결제 주문건 시 은행명, 계좌번호를 제대로 입력해주셔야 환불이 가능합니다.");
      return;
    }

    await onCheckAccountBankInfoMutation({
      variables: {
        input: {
          bankCode: bankCodeWatched,
          accountNumber: accountNumberWatched,
        },
      },
    });

    setDebounce(true);

    setTimeout(() => {
      setDebounce(false);
    }, 1000);
  };

  return (
    <>
      <br />
      <Card size="small">
        <Tag color="processing">환불정보 입력</Tag>
        <Row justify="space-between" style={{ marginTop: 5 }}>
          <Col span={24}>
            <div style={{ display: "flex", gap: 5, justifyContent: "space-between" }}>
              <label style={{ flex: 1 }}>
                예금주
                <Form.Item name="accountHolderName" style={{ marginBottom: 0 }}>
                  <Input placeholder={isCancel ? "최소 1자 이상" : "계좌번호 확인 시 자동 입력"} disabled={!isCancel} />
                </Form.Item>
              </label>
              <label style={{ flex: 1 }}>
                은행
                <Form.Item name="bankCode" style={{ marginBottom: 0 }}>
                  <Select
                    placeholder="은행을 선택하세요."
                    style={{ display: "block" }}
                    disabled={accountBankCheckValue}
                    options={refundBankCodeChoices}
                  />
                </Form.Item>
              </label>
            </div>
            <div style={{ display: "flex", gap: 5, justifyContent: "space-between", alignItems: "flex-end" }}>
              <label style={{ flex: 1 }}>
                계좌번호
                <Form.Item name="accountNumber" style={{ marginBottom: 0 }}>
                  <Input disabled={accountBankCheckValue} placeholder="최소 10자 이상" />
                </Form.Item>
              </label>
              <label>
                {accountBankCheckValue ? (
                  <Button
                    type="primary"
                    onClick={() => {
                      setAccountBankCheckValue(false);
                    }}
                  >
                    계좌 변경
                  </Button>
                ) : (
                  <Button type="primary" onClick={checkAccountInfoOnClick} disabled={btnDisabled}>
                    계좌번호 확인
                  </Button>
                )}
                {/* <AccountBankInfoCheckBtn
                  bankCode={bankCode}
                  accountNumber={accountNumber}
                  accountHolderName={accountHolderNameValue}
                  setAccountHolderNameValue={setAccountHolderNameValue}
                  setAccountBankCheckValue={setAccountBankCheckValue}
                  accountBankCheckValue={accountBankCheckValue}
                /> */}
              </label>
            </div>
          </Col>
        </Row>
      </Card>
    </>
  );
};

export default RefundBankForm;
