  SalesStatByProductDiffListPageProps,
} from "./SalesStatByProductDiffListPage";

export const getSalesStatByProductDiffListTableSettings = (props: SalesStatByProductDiffListPageProps) => {
  const { stoppedReasonChoices } = props;
  const { statDateA, statDateB } = props?.filterVariables;
  // const dateAStartOfMonth = moment(statDateA.gte).startOf("month").format(onlyDateFormat);
  // const dateBStartOfMonth = moment(statDateB.gte).startOf("month").format(onlyDateFormat);
  const dateAFromStr = moment(statDateA.gte).format(onlyDateFormat);
  const dateAToStr = moment(statDateA.lte).format(onlyDateFormat);
  const dateBFromStr = moment(statDateB.gte).format(onlyDateFormat);
  const dateBToStr = moment(statDateB.lte).format(onlyDateFormat);

  const fixedLeftFlag = utils.fixedLeftFlag();

  const skuFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.SKU,
    key: "sku",
    fixed: fixedLeftFlag,
    align: "center",
    width: 120,
    render: (_, record) => record.productSku,
  };

  const productNameFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.PRODUCT_NAME,
    key: "productName",
    fixed: fixedLeftFlag,
    align: "left",
    width: 200,
    render: (_, record) => record.productVariant.product.name || "-",
  };

  const variantNameFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    fixed: fixedLeftFlag,
    align: "left",
    width: 100,
    render: (_, record) => record.productVariant.name || "-",
  };

  const isExclusiveFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.IS_EXCLUSIVE,
    key: "isExclusive",
    fixed: fixedLeftFlag,
    align: "center",
    width: 100,
    render: (_, record) => transformIsExclusive(record.productVariant.product.isExclusive),
  };

  const trackInventoryFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.TRACK_INVENTORY,
    key: "trackInventory",
    fixed: fixedLeftFlag,
    align: "center",
    width: 100,
    render: (_, record) => (record.productVariant.trackInventory ? "운영" : "위탁"),
  };

  const isInnerFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.IS_INNER,
    key: "isInner",
    fixed: fixedLeftFlag,
    align: "center",
    width: 90,
    render: (_, record) => transformIsInner(record.productVariant.isInner) || "-",
  };

  const categoryKindColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.CATEGORY_KIND,
    key: "categoryKind",
    fixed: fixedLeftFlag,
    align: "center",
    width: 100,
    render: (_, record) => {
      const product = record.productVariant.product;
      if (product.category.kind === CategoryKindEnum.STANDARD) {
        if (product.isFulfilledByVendor) {
          return "직거래";
        }
        return "포장보스";
      } else if (product.category.kind === CategoryKindEnum.B2B) {
        return "B2B";
      }
    },
  };

  const salesStatusColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.SALES_STATUS,
    key: "salesStatus",
    fixed: fixedLeftFlag,
    align: "center",
    width: 80,
    render: (_, record) => makeSalesStatusByProductVariant(record.productVariant, stoppedReasonChoices),
    renderExcel: (record) =>
      makeSalesStatusByProductVariant(record.productVariant, stoppedReasonChoices, false) as string,
  };

  const attributesFixedColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    fixed: fixedLeftFlag,
    align: "left",
    width: 200,
    render: (_, record) => getStockSpec(record.productVariant),
  };

  const baseSellPriceExcludeVatColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.BASE_SELL_PRICE,
    key: "baseSellPriceExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.productVariant.baseSellPriceExcludeVat} />,
    renderExcel: (record) => record.productVariant.baseSellPriceExcludeVat,
  };
  const baseSellPriceSetDateColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: [columnNameConstant.product.BASE_SELL_PRICE, columnNameConstant.common.SET_DATE],
    key: "baseSellPriceSetDate",
    align: "center",
    width: 120,
    render: (_, record) => getDateByFormat(record.productVariant.baseSellPriceSetDate, onlyDateFormat),
  };
  const marketLowestPriceExcludeVatColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.product.MARKET_LOWEST_PRICE,
    key: "marketLowestPriceExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.productVariant.marketLowestPriceExcludeVat} />,
    renderExcel: (record) => record.productVariant.marketLowestPriceExcludeVat,
  };
  const marketLowestPriceSetDateColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: [columnNameConstant.product.MARKET_LOWEST_PRICE, columnNameConstant.common.SET_DATE],
    key: "marketLowestPriceSetDate",
    align: "center",
    width: 120,
    render: (_, record) => getDateByFormat(record.productVariant.marketLowestPriceSetDate, onlyDateFormat),
  };
  const marketLowestPriceSourceColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: [columnNameConstant.product.MARKET_LOWEST_PRICE, columnNameConstant.common.SOURCE],
    key: "marketLowestPriceSource",
    width: 200,
    render: (_, record) => <TextWithLink text={record.productVariant.marketLowestPriceSource} />,
    renderExcel: (record) => record.productVariant.marketLowestPriceSource,
  };

  const vendorCodeColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.vendor.CODE,
    key: "vendorCode",
    align: "center",
    width: 100,
    render: (_, record) => getStockVendorCode(record.productVariant),
    renderExcel: (record) => getStockVendorCode(record.productVariant, false) as string,
  };
  const vendorNameColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.vendor.VENDOR_NAME,
    key: "vendorName",
    align: "left",
    width: 150,
    render: (_, record) => getStockVendorName(record.productVariant),
    renderExcel: (record) => getStockVendorName(record.productVariant, false) as string,
  };
  const vendorMoqColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.purchaseOrder.PO_MOQ,
    key: "vendorMoq",
    align: "right",
    width: 100,
    render: (_, record) => {
      const value = getStockVendorMoq(record.productVariant);
      const salesUnitType = getSalesUnitTypeText(record.productVariant.salesUnitType);
      return <NumberComponent value={value} postFix={salesUnitType} />;
    },
    renderExcel: (record) =>
      `${getStockVendorMoq(record.productVariant)} ${getSalesUnitTypeText(record.productVariant.salesUnitType)}`,
  };
  const sumOfStockQuantityColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: columnNameConstant.stock.SUM_OF_STOCK_QUANTITY,
    key: "sumOfStockQuantity",
    align: "right",
    width: 80,
    render: (_, record) => <NumberComponent value={calcSumOfStockQuantity(record.productVariant)} />,
    renderExcel: (record) => calcSumOfStockQuantity(record.productVariant),
  };

  const columns: DownloadableColumnsType<SalesStatByProductDiffDataSourceProps> = [
    {
      title: "제품 정보",
      children: [
        skuFixedColumn,
        productNameFixedColumn,
        variantNameFixedColumn,
        isExclusiveFixedColumn,
        trackInventoryFixedColumn,
        isInnerFixedColumn,
        attributesFixedColumn,
        categoryKindColumn,
        salesStatusColumn,
      ],
    },
    {
      title: "기준 판매가 정보",
      children: [
        baseSellPriceExcludeVatColumn,
        baseSellPriceSetDateColumn,
        marketLowestPriceExcludeVatColumn,
        marketLowestPriceSetDateColumn,
        marketLowestPriceSourceColumn,
      ],
    },
    {
      title: "협력사 정보",
      children: [vendorCodeColumn, vendorNameColumn, vendorMoqColumn],
    },
    sumOfStockQuantityColumn,
  ];

  const numOfUsersPeriodAColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "주문 매장 수",
    key: `numOfUsers_${dateAFromStr}`,
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.statA?.numberOfUsers} />,
    renderExcel: (record) => record.statA?.numberOfUsers || 0,
  };
  const quantityPeriodAColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "판매 수량",
    key: `quantity_${dateAFromStr}`,
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statA?.quantity} />,
    renderExcel: (record) => record.statA?.quantity || 0,
  };

  columns.push({
    title: `${dateAFromStr}~${dateAToStr}(A)`,
    children: [numOfUsersPeriodAColumn, quantityPeriodAColumn],
  });

  const numOfUsersPeriodBColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "주문 매장 수",
    key: `numOfUsers_${dateBFromStr}`,
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statB?.numberOfUsers} />,
    renderExcel: (record) => record.statB?.numberOfUsers || 0,
  };
  const quantityPeriodBColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "판매 수량",
    key: `quantity_${dateBFromStr}`,
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statB?.quantity} />,
    renderExcel: (record) => record.statB?.quantity || 0,
  };

  columns.push({
    title: `${dateBFromStr}~${dateBToStr}(B)`,
    children: [numOfUsersPeriodBColumn, quantityPeriodBColumn],
  });

  const numberOfUsersPeriodDiffColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "주문 매장 수",
    key: `numOfUsers_diff`,
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statA?.numberOfUsers - record.statB?.numberOfUsers} />,
    renderExcel: (record) => record.statA?.numberOfUsers - record.statB?.numberOfUsers,
  };
  const quantityPeriodDiffColumn: DownloadableColumnType<SalesStatByProductDiffDataSourceProps> = {
    title: "판매 수량",
    key: `quantity_diff`,
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statA?.quantity - record.statB?.quantity} />,
    renderExcel: (record) => record.statA?.quantity - record.statB?.quantity,
  };
  columns.push({
    title: "비교(A-B)",
    children: [numberOfUsersPeriodDiffColumn, quantityPeriodDiffColumn],
  });

  return columns;
};
</file>

<file path="src/app/views/stats/components/SalesStatByProductForBrandListPage/filters.ts">
import { SalesStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import {
  ProductCategoryKind,
  productCategoryKindChoicesForSalesStatFilter,
} from "@src/app/views/stats/utils/categoryKindMapper";
import { AutocompleteFilterOpts, FilterOpts, MinMax } from "@src/global/core/types/types";
import {
  createAutocompleteField,
  createBooleanField,
  createDateField,
  createOptionsField,
  createTextField,
} from "@utils/filters/fields";

export enum SalesStatByProductForBrandFilterKeys {
  statDate = "statDate",
  brandId = "brandId",
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  categoryKind = "categoryKind",
  salesStatus = "salesStatus",
  includeBossMrkt = "includeBossMrkt",
  isExclusive = "isExclusive",
  trackInventory = "trackInventory",
  isInner = "isInner",
}

export interface SalesStatByProductForBrandFilterOpts {
  statDate: FilterOpts<MinMax>;
  brandId: FilterOpts<string[]> & AutocompleteFilterOpts;
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  categoryKind: FilterOpts<ProductCategoryKind[]>;
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  includeBossMrkt: FilterOpts<boolean>;
  isExclusive: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: SalesStatByProductForBrandFilterOpts
): IFilter<SalesStatByProductForBrandFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createDateField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.statDate,
        filterNameConstant.STAT_DATE,
        opts.statDate.value
      ),
      active: opts.statDate.active,
      isRequired: true,
    },
    {
      ...createAutocompleteField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.brandId,
        filterNameConstant.BRAND_SEARCH,
        opts.brandId.value,
        opts.brandId.displayValues,
        false,
        opts.brandId.choices,
        {
          hasMore: opts.brandId.hasMore,
          initialSearch: "",
          loading: opts.brandId.loading,
          onFetchMore: opts.brandId.onFetchMore,
          onSearchChange: opts.brandId.onSearchChange,
        }
      ),
      active: opts.brandId.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.includeBossMrkt,
        filterNameConstant.INCLUDE_BOSS_MRKT,
        opts.includeBossMrkt.value,
        {
          negative: "미포함",
          positive: "포함",
        }
      ),
      active: opts.includeBossMrkt.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.vendorSearch,
        filterNameConstant.VENDOR_SEARCH + "(출고기준)",
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.categoryKind,
        "제품 구분",
        opts.categoryKind.value,
        true,
        productCategoryKindChoicesForSalesStatFilter
      ),
      active: opts.categoryKind.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.salesStatus,
        "제품 상태",
        opts.salesStatus.value,
        true,
        [
          { label: "판매대기", value: SalesStatusEnum.PENDING },
          { label: "정상", value: SalesStatusEnum.ON_SALE },
          { label: "단종예정", value: SalesStatusEnum.WILL_BE_STOPPED },
          { label: "단종", value: SalesStatusEnum.STOPPED },
        ]
      ),
      active: opts.salesStatus.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.isExclusive,
        "전용여부",
        opts.isExclusive.value,
        {
          negative: "범용",
          positive: "전용",
        }
      ),
      active: opts.isExclusive.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.trackInventory,
        "재고운영여부",
        opts.trackInventory.value,
        {
          negative: "미운영",
          positive: "운영",
        }
      ),
      active: opts.trackInventory.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatByProductForBrandFilterKeys.isInner,
        "제품형태",
        opts.isInner.value,
        {
          negative: "아우터박스",
          positive: "이너박스",
        }
      ),
      active: opts.isInner.active,
    },
  ];
}
</file>

