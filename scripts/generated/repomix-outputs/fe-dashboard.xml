<file path="src/app/views/order/orders/components/CreateAdminOrderUserSearchModal/CreateAdminOrderUserSearchModal.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import {
  SearchCustomersForAdminOrder_search_edges_node,
  SearchCustomersForAdminOrderVariables,
} from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { useCustomersForAdminOrderSearch } from "@src/api/searches/useCustomerSearch";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CompactFilter from "@src/app/components/Filter/CompactFilter";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { FormInstance, Modal, Row, Table, Typography } from "antd";
import React, { useState } from "react";

import { CreateAdminOrderForm } from "../../views/CreateAdminOrderView/CreateAdminOrderView";
import { setCustomerUserAndAddressInfo } from "../../views/CreateAdminOrderView/utils";
import { getCreateAdminOrderCustomerListTableSettings } from "./CreateAdminOrderCustomerListTableSettings";
import {
  customerCreateFilterStructure,
  customerGetFilterOpts,
  getCustomerListVariantSearchFilterVariables,
} from "./CustomerListFilter";

interface CreateAdminOrderUserSearchModalProps {
  open: boolean;
  onCancel: () => void;
  footer?: React.ReactNode;
  title: string;
  form: FormInstance<CreateAdminOrderForm>;
  changeAddressInfo: (user: SearchCustomersForAdminOrder_search_edges_node, refetchAddress: boolean) => void;
  confirmModalOpen: () => void;
  setTempCustomerUser: React.Dispatch<React.SetStateAction<SearchCustomersForAdminOrder_search_edges_node>>;
  isByStaffForB2b: boolean;
  isHqStaff?: boolean;
  brandId?: string;
  onDeliverToMe?: () => void;
}

const CreateAdminOrderUserSearchModal: React.FC<CreateAdminOrderUserSearchModalProps> = (props) => {
  const {
    open,
    onCancel,
    footer,
    title,
    form,
    changeAddressInfo,
    confirmModalOpen,
    setTempCustomerUser,
    isByStaffForB2b,
    isHqStaff = false,
    brandId,
  } = props;
  const TypeSafeForm = getTypeSafeForm<CreateAdminOrderForm>(form);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const initialQueryVariables: SearchCustomersForAdminOrderVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: getCustomerListVariantSearchFilterVariables([], isByStaffForB2b, isHqStaff ? brandId : undefined),
  };
  const [queryVariables, setQueryVariables] = useState<SearchCustomersForAdminOrderVariables>(initialQueryVariables);

  const filterOpts = customerGetFilterOpts(queryVariables.filter);
  const filterStructure = customerCreateFilterStructure(filterOpts, isHqStaff);

  const { loadMore, result } = useCustomersForAdminOrderSearch({ skip: !open, variables: queryVariables });
  const { data, loading: searchLoading, refetch } = result;
  const dataSource = maybe(() => data.search.edges.map((edge) => edge.node), []);
  const hasMore = maybe(() => data.search.pageInfo.hasNextPage, false);

  const columns = getCreateAdminOrderCustomerListTableSettings({
    onRowClick: (record) => {
      const selectedCustomerUser = TypeSafeForm.getFieldValue("customerUser");
      if (utils.isEmpty(selectedCustomerUser)) {
        setCustomerUserAndAddressInfo(form, record);
        changeAddressInfo(record, true);
        onCancel();
      } else if (selectedCustomerUser.id === record.id) {
        onCancel();
      } else {
        setTempCustomerUser(record);
        confirmModalOpen();
      }
    },
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Modal
      open={open}
      closable={false}
      onCancel={onCancel}
      title={title}
      footer={footer}
      width={1000}
      maskClosable={false}
    >
      <CompactFilter
        filterStructure={filterStructure}
        onFilterChange={(filters) => {
          if (!open) {
            return;
          }
          const filterVariables = getCustomerListVariantSearchFilterVariables(
            filters,
            isByStaffForB2b,
            isHqStaff ? brandId : undefined
          );
          const newQueryVariables = { ...queryVariables, filter: filterVariables };
          setQueryVariables(newQueryVariables);
          refetch(newQueryVariables);
        }}
        onFilterReset={() => {
          setQueryVariables(initialQueryVariables);
          refetch(initialQueryVariables);
        }}
      />
      <Table
        ref={tableRef}
        {...commonTableProps}
        style={{ marginTop: 16 }}
        loading={searchLoading}
        columns={columns}
        dataSource={dataSource}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        footer={
          hasMore &&
          (() => (
            <Row justify="center">
              <Typography.Link onClick={loadMore}>더 보기</Typography.Link>
            </Row>
          ))
        }
      />
    </Modal>
  );
};

export default CreateAdminOrderUserSearchModal;
</file>

<file path="src/app/views/order/orders/components/CreateAdminOrderUserSearchModal/CustomerListFilter.ts">
import { CustomerFilterInput } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createBooleanField, createTextField } from "@utils/filters/fields";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

enum CustomerListSearchFiltersEnum {
  userSearch = "userSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  isHqStaff = "isHqStaff",
}
type CustomerListSearchFilters = Filters<CustomerListSearchFiltersEnum>;

enum CustomerListSearchFilterKeys {
  userSearch = "userSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  isHqStaff = "isHqStaff",
}

interface CustomerListSearchListFilterOpts {
  userSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  isHqStaff: FilterOpts<boolean>;
}

export const customerGetFilterOpts = (filterVariables: CustomerFilterInput): CustomerListSearchListFilterOpts => ({
  userSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
    value: filterVariables.userSearch || "",
  },
  brandSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
    value: filterVariables.brandSearch || "",
  },
  brandStoreSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
    value: filterVariables.brandStoreSearch || "",
  },
  isHqStaff: {
    active: maybe(() => !utils.isEmpty(filterVariables.isHqStaff), false),
    value: maybe(() => filterVariables.isHqStaff, true),
  },
});

export const customerCreateFilterStructure = (
  opts: CustomerListSearchListFilterOpts,
  isHqStaff: boolean = false
): IFilter<CustomerListSearchFilterKeys> => {
  let displayOrder = 0;
  const filters: IFilter<CustomerListSearchFilterKeys> = [];

  // 가맹본부가 아닌 경우에만 브랜드 검색 필터 표시
  if (!isHqStaff) {
    filters.push({
      ...createTextField(
        displayOrder++,
        CustomerListSearchFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    });
  }

  filters.push(
    {
      ...createTextField(
        displayOrder++,
        CustomerListSearchFilterKeys.brandStoreSearch,
        filterNameConstant.BRAND_STORE_SEARCH,
        opts.brandStoreSearch.value
      ),
      active: opts.brandStoreSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        CustomerListSearchFilterKeys.userSearch,
        filterNameConstant.USER_SEARCH,
        opts.userSearch.value
      ),
      active: opts.userSearch.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        CustomerListSearchFilterKeys.isHqStaff,
        "가맹본부 여부",
        opts.isHqStaff.value,
        {
          negative: "X",
          positive: "O",
        }
      ),
      active: opts.isHqStaff.active,
    }
  );

  return filters;
};

function getFilterQueryParams(filter: IFilterElement<string>): CustomerListSearchFilters {
  const { name } = filter;
  switch (name) {
    case CustomerListSearchFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, CustomerListSearchFiltersEnum.userSearch);
    case CustomerListSearchFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, CustomerListSearchFiltersEnum.brandSearch);
    case CustomerListSearchFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, CustomerListSearchFiltersEnum.brandStoreSearch);
    case CustomerListSearchFilterKeys.isHqStaff:
      return getSingleValueQueryParam(filter, CustomerListSearchFiltersEnum.isHqStaff);
  }
}

export function getCustomerListVariantSearchFilterVariables(
  filters: Array<IFilterElement<string>>,
  isByStaffForB2b: boolean,
  brandId?: string
): CustomerFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParams(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return {
    ...queryParams,
    isHqStaff: utils.isEmpty(queryParams.isHqStaff, true) ? undefined : parseBoolean(queryParams.isHqStaff, false),
    isActive: true,
    isB2b: isByStaffForB2b,
    brand: brandId,
    orderable: true,
  };
}
</file>

