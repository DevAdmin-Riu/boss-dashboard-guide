        {
          negative: "허용하지 않음",
          positive: "허용",
        }
      ),
      active: opts.useDelegatedManagementForPo.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        VendorListFilterKeys.useAutoConsignmentPo,
