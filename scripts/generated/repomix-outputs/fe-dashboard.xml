      value: {
        max: maybe(() => filterVariables.statDate.lte, todayMoment.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.statDate.gte, todayMoment.format(onlyMonthFormat)),
      },
    },
    brandSearch: {
