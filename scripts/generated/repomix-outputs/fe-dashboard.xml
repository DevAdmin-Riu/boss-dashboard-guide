import { SubmitPromise } from "@hooks/useForm";
import { PermissionGroupErrorFragment } from "@src/api/fragments/types/PermissionGroupErrorFragment";
import { PermissionEnum } from "@src/api/types/globalTypes";
import AccountPermissions from "@src/app/components/AccountPermissions";
import AppHeader from "@src/app/components/AppHeader";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import FormSpacer from "@src/app/components/FormSpacer";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { ShopInfo_shop_permissions } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { MembersListUrlSortField } from "@src/app/views/settings/permissionGroups/urls";
import { extractPermissionCodes, isGroupFullAccess } from "@src/app/views/settings/permissionGroups/utils";
import { permissionMsg } from "@src/global/assets/messages/commonMsg";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { ListActions, SortPage } from "@src/global/core/types/types";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import React from "react";

import {
  PermissionGroupDetails_permissionGroup,
  PermissionGroupDetails_permissionGroup_users,
} from "../../api/types/PermissionGroupDetails";
import PermissionGroupInfo from "../PermissionGroupInfo";
import PermissionGroupMemberList from "../PermissionGroupMemberList";

export interface PermissionGroupDetailsPageFormData {
  name: string;
  hasFullAccess: boolean;
  isActive: boolean;
  permissions: PermissionEnum[];
  users: PermissionGroupDetails_permissionGroup_users[];
}

export interface PermissionData extends ShopInfo_shop_permissions {
  lastSource?: boolean;
  disabled?: boolean;
}

export interface PermissionGroupDetailsPageProps extends ListActions, SortPage<MembersListUrlSortField> {
  disabled: boolean;
  errors: PermissionGroupErrorFragment[];
  selectedRowKeys: string[];
  members: PermissionGroupDetails_permissionGroup_users[];
  membersModified: boolean;
  permissionGroup: PermissionGroupDetails_permissionGroup;
  permissions: PermissionData[];
  permissionsExceeded: boolean;
  saveButtonBarState: ConfirmButtonTransitionState;
  onAssign: () => void;
  onBack: () => void;
  onUnassign: (ids: string[]) => void;
  onSubmit: (data: PermissionGroupDetailsPageFormData) => SubmitPromise;
}

const PermissionGroupDetailsPage: React.FC<PermissionGroupDetailsPageProps> = ({
  disabled,
  errors,
  members,
  membersModified,
  onBack,
  onSubmit,
  permissionGroup,
  permissions,
  permissionsExceeded,
  saveButtonBarState,
  ...listProps
}) => {
  const initialForm: PermissionGroupDetailsPageFormData = {
    hasFullAccess: isGroupFullAccess(permissionGroup, permissions),
    isActive: false,
    name: permissionGroup?.name || "",
    permissions: extractPermissionCodes(permissionGroup),
    users: members,
  };

  const formErrors = getFormErrors(["addPermissions"], errors);
  const permissionsError = makeGqlErrorMsg(formErrors.addPermissions);

  return (
    <Form initial={initialForm} onSubmit={onSubmit} confirmLeave>
      {({ data, change, submit, hasChanged }) => (
        <>
          <AppHeader onBack={onBack}>{sectionNames.permissionGroups}</AppHeader>
          <PageHeader title={permissionGroup?.name} />

          <Grid>
            <div>
              <PermissionGroupInfo data={data} disabled={disabled} errors={errors} onChange={change} />
              <FormSpacer />
              <PermissionGroupMemberList disabled={disabled} {...listProps} users={data?.users || []} />
            </div>
            <div>
              <AccountPermissions
                permissionsExceeded={permissionsExceeded}
                data={data}
                disabled={disabled}
                permissions={permissions}
                onChange={change}
                errorMessage={permissionsError}
                fullAccessLabel={permissionMsg.fullAccessLabel}
                description={permissionMsg.cardDescription}
              />
            </div>
          </Grid>
          <div>
            <SaveButtonBar
              onCancel={onBack}
              onSave={submit}
              state={saveButtonBarState}
              disabled={disabled || !(hasChanged || membersModified)}
            />
          </div>
        </>
      )}
    </Form>
  );
};
export default PermissionGroupDetailsPage;
</file>

