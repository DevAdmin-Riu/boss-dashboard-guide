type TOuterVariantForAvailableQtyConsiderVirtualAlloc = Pick<
  ProductVariantList_productVariants_edges_node_outer,
  "qtyPerBox" | "quantityAvailable"
>;
type TVariantForAvailableQtyConsiderVirtualAlloc = Pick<
  | ProductVariantList_productVariants_edges_node
  | BrandProductList_brandProducts_edges_node_brandProductVariants_productVariant,
  "isInner" | "quantityAvailable" | "quantityVirtualAllocated" | "qtyPerBox"
> & { outer?: TOuterVariantForAvailableQtyConsiderVirtualAlloc };

export const getAvailableQtyConsiderVirtualAllocForOuter = (
  outerVariant: TVariantForAvailableQtyConsiderVirtualAlloc
) => {
  const { quantityAvailable, quantityVirtualAllocated } = outerVariant;
  return Math.max(0, quantityAvailable - quantityVirtualAllocated);
};

export const getAvailableQtyConsiderVirtualAllocForInner = (
  outerVariant: TOuterVariantForAvailableQtyConsiderVirtualAlloc,
  innerVariant: TVariantForAvailableQtyConsiderVirtualAlloc
) => {
  const { quantityAvailable: outerQuantityAvailable } = outerVariant;
  const { quantityAvailable: innerQuantityAvailable, quantityVirtualAllocated: innerQuantityVirtualAllocated } =
    innerVariant;
  const packCount = calcPackCount(outerVariant, innerVariant);
  return Math.max(0, innerQuantityAvailable + outerQuantityAvailable * packCount - innerQuantityVirtualAllocated);
};

// [가용 재고] - 재고 관리 용어 (5)번
// 설명: 합포장 주문으로 인한 소분 대기를 고려한 가용 재고
export const getAvailableQtyConsiderVirtualAlloc = (productVariant: TVariantForAvailableQtyConsiderVirtualAlloc) => {
  if (!productVariant) {
    return 0;
  }

  const { isInner } = productVariant;
  // 아우터박스인 경우, [순수 가용 재고(전체 재고 - 예약 재고)] - [소분이 필요한 합포장 주문 처리 시 가상 예약 재고]
  if (isInner === false) {
    return getAvailableQtyConsiderVirtualAllocForOuter(productVariant);
  }

  // 이너박스인 경우, [이너박스 순수 가용 재고 + (아우터박스 순수 가용 재고 * 입수량 pack)] - [이너박스 가상 예약 재고]
  const { outer } = productVariant;
  return getAvailableQtyConsiderVirtualAllocForInner(outer, productVariant);
};

type TOuterVariantForOrderableQty = Pick<
  ProductVariantListToAdd_productVariants_edges_node_outer,
  "qtyPerBox" | "quantityAvailable" | "qtyToBeStockedLongTerm"
>;
type TVariantForOrderableQty = Pick<
  ProductVariantListToAdd_productVariants_edges_node,
  "isInner" | "qtyPerBox" | "quantityAvailable" | "quantityVirtualAllocated" | "qtyToBeStockedLongTerm"
> & { outer?: TOuterVariantForOrderableQty };

// [재발주 판단용 주문 가능 수량] - 재고 관리 용어 (9)번
// 설명: 재발주점 판단 시 주문 가능 수량 - 대시보드에서만 사용
// NOTE: 로직 수정 또는 shortTerm에 대해서도 유틸이 필요해지는 경우, 백엔드의 로직 확인하고 동일한 로직이 되도록 체크하며 수정할 것.
export const getOrderableQtyInclLongTerm = (productVariant: TVariantForOrderableQty) => {
  // 아우터, 이너에 따라 각각 다르게 리턴 됨.
  const availableQtyConsiderVirtualAlloc = getAvailableQtyConsiderVirtualAlloc(productVariant);
  const qtyToBeStocked = productVariant.qtyToBeStockedLongTerm;
  return Math.max(0, availableQtyConsiderVirtualAlloc + qtyToBeStocked);
};

export const stockStatusRender = (
  record: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant,
  isInner: boolean,
  includeQuantityAvailable?: boolean,
  spaceProps?: SpaceProps
) => {
  if (!record) {
    return null;
  }
  const allowAutoConsignment = record.allowAutoConsignment;
  const salesStatus = isInner ? record.inner?.salesStatus : record.salesStatus;
  const isStopped = isStoppedSalesStatus(salesStatus);
  const isSafety = isInner ? record.inner?.isSafety : record.isSafety;
  const trackInventory = record.trackInventory;
  const availableQtyConsiderVirtualAlloc = isInner
    ? getAvailableQtyConsiderVirtualAllocForInner(record, record.inner)
    : getAvailableQtyConsiderVirtualAllocForOuter(record);
  const color = isStopped
    ? StockStatusColor.isStopped
    : isSafety
    ? StockStatusColor.isSafety
    : StockStatusColor.isNotSafety;
  if (!trackInventory) {
    return "-";
  }
  const status = isStopped ? "단종" : isSafety ? "안전" : "부족";

  return (
    <Space {...spaceProps} size="small">
      {includeQuantityAvailable && <Tag color={color}>가용 재고: {availableQtyConsiderVirtualAlloc} </Tag>}
      <Tag color={color}>{status}</Tag>
      {allowAutoConsignment && <Tag color={StockStatusColor.allowAutoConsignment}>자동위탁</Tag>}
    </Space>
  );
};

