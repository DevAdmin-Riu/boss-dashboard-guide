import useNavigator from "@hooks/useNavigator";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { useCourierUpdateMutation } from "@src/app/views/settings/couriers/api/mutations";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useCourierDetailsQuery } from "../api/queries";
import CourierDetailsPage from "../components/CourierDetailsPage";
import { CourierDetailsViewUrlQueryParams, courierListViewUrl } from "../urls";

interface CourierDetailsViewProps {
  id: string;
  params: CourierDetailsViewUrlQueryParams;
}

export const CourierDetailsView: React.FC<CourierDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const { data, loading } = useCourierDetailsQuery({ variables: { id } });
  const [courierUpdate, courierUpdateOpts] = useCourierUpdateMutation({
    onCompleted: (data) => {
      const errors = data.courierUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  if (data?.courier === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(courierListViewUrl())} />;
  }
  return (
    <CourierDetailsPage
      disabled={loading || courierUpdateOpts.loading}
      onBack={() => navigate(courierListViewUrl())}
      onSubmit={(input) => courierUpdate({ variables: { id, input } })}
      saveButtonBarState={courierUpdateOpts.status}
      courier={data?.courier}
    />
  );
};
</file>

