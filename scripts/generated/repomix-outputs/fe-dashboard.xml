import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { brandHistoryFragment } from "@src/api/fragments/brands";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import gql from "graphql-tag";

import { BrandHistories, BrandHistoriesVariables } from "./types/BrandHistories";
import { BrandHistory, BrandHistoryVariables } from "./types/BrandHistory";

export const brandHistoryListQuery = gql`
  ${brandHistoryFragment}
  ${pageInfoFragment}
  query BrandHistories(
    $filter: BrandHistoryFilterInput
    $sort: BrandHistorySortingInput
    $after: String
    $before: String
    $first: Int
    $last: Int
  ) {
    brandHistories(filter: $filter, sortBy: $sort, after: $after, before: $before, first: $first, last: $last) {
      edges {
        node {
          ...BrandHistoryFragment
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;

export const useBrandHistoryListQuery = makeQuery<BrandHistories, BrandHistoriesVariables>(brandHistoryListQuery);
