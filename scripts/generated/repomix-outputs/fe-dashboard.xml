  status: "standby-or-pending" | "revision" | "pending" | "closed" | "all-status" | ":status";
}
export const purchaseListViewPath = (routeParams: PurchaseListViewRouteParams) =>
  urlJoin(purchaseSectionUrl, routeParams.fulfilledBy, routeParams.status);

export enum PurchaseListViewUrlFiltersEnum {
  createdFrom = "createdFrom",
  createdTo = "createdTo",

  purchaseCloseDateFrom = "purchaseCloseDateFrom",
  purchaseCloseDateTo = "purchaseCloseDateTo",
  purchaseOrderDateFrom = "purchaseOrderDateFrom",
  purchaseOrderDateTo = "purchaseOrderDateTo",
  purchaseCloseMonth = "purchaseCloseMonth",
  isNotOrderableBeforeStocked = "isNotOrderableBeforeStocked",
  isForPackageOrder = "isForPackageOrder",
  vendorContactType = "vendorContactType",
  purchaseOrderSearch = "purchaseOrderSearch",
  purchaseOrderLineSearch = "purchaseOrderLineSearch",
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  brandSearch = "brandSearch",
  userSearch = "userSearch",
  orderSearch = "orderSearch",
  b2bOrderSearch = "b2bOrderSearch",
}
export enum PurchaseListViewUrlFiltersWithMultipleValues {
  status = "status",
  type = "type",
}
export type PurchaseListViewUrlFilters = Filters<PurchaseListViewUrlFiltersEnum> &
  FiltersWithMultipleValues<PurchaseListViewUrlFiltersWithMultipleValues>;

export type PurchaseListViewUrlDialog =
  | "cancel"
  | "download-list"
  | "bulk-pending-purchase"
  | "bulk-req-revision-purchase"
  | "bulk-close-purchase"
  | "cancel-purchase"
  | TabActionDialog;
