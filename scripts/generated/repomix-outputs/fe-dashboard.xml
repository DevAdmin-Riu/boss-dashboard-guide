import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { utils } from "@utils/utils";
import { Input, Table } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { BrandProductDataSourceType } from "../BrandProductListTable/BrandProductListTable";
import { getBrandProductAddListTableColumns } from "./BrandProductPackageAddListSetting";

interface BrandProductPackageAddListProps {
  brandProducts: BrandProductDataSourceType[];
  packageSelectedRowIds: React.Key[];
  setPackageSelectedRowIds: React.Dispatch<React.SetStateAction<React.Key[]>>;
}

const BrandProductPackageAddList: React.FC<BrandProductPackageAddListProps> = (props) => {
  const { brandProducts, packageSelectedRowIds, setPackageSelectedRowIds } = props;
  const [dataSource, setDataSource] = useState<BrandProductDataSourceType[]>([]);

  const onSearch: React.ChangeEventHandler<HTMLInputElement> = (e) => {
    const value = e.target.value;

    if (utils.isEmpty(value, true)) {
      setDataSource(brandProducts);
    } else {
      // name, product.name, brandProductVariant.productVariant.sku 검색
      const filteredBrandProducts = brandProducts.filter(
        (item) =>
          item.name.includes(value) ||
          item.product?.name.includes(value) ||
          item.brandProductVariant?.productVariant?.sku.includes(value)
      );
      setDataSource(filteredBrandProducts);
    }
  };

  const rowSelection: TableRowSelection<BrandProductDataSourceType> = {
    fixed: true,
    selectedRowKeys: packageSelectedRowIds,
    onChange: (newSelectedRowKeys: React.Key[]) => {
      setPackageSelectedRowIds(newSelectedRowKeys);
    },
  };

  useEffect(() => {
    setDataSource(brandProducts);
  }, [brandProducts]);

  return (
    <>
      <TableVatLegend isIncludeVat={false} size="small" />
      <Input placeholder="상품 검색" onChange={onSearch} />
      <Table
        {...commonTableProps}
        rowKey={(record) => record.brandProductVariant.id}
        rowSelection={rowSelection}
