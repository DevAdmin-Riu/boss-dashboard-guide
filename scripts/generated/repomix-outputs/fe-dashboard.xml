<file path="src/app/views/stats/components/PurchasesStatByVendorListPage/filters.ts">
import { PoEventTypeEnum, VendorContactTypeEnum, VendorPayMethodEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { vendorPayMethodChoices } from "@src/app/views/purchase/vendors/utils";
import { FilterOpts } from "@src/global/core/types/types";
import { createOneMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

import { poEventTypeEnumChoices, vendorContactTypeChoices } from "../../utils";

export enum PurchasesStatByVendorFilterKeys {
  statDateMonth = "statDateMonth",
  vendorSearch = "vendorSearch",
  payMethods = "payMethods",
  poEventTypes = "poEventTypes",
  vendorContactType = "vendorContactType",
}

export interface PurchasesStatByVendorListFilterOpts {
  statDateMonth: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  payMethods: FilterOpts<VendorPayMethodEnum[]>;
  poEventTypes: FilterOpts<PoEventTypeEnum[]>;
  vendorContactType: FilterOpts<VendorContactTypeEnum[]>;
}

export function createFilterStructure(
  opts: PurchasesStatByVendorListFilterOpts,
  isB2b: boolean
): IFilter<PurchasesStatByVendorFilterKeys> {
  let displayOrder = 0;

  const statDateMonthFilter = {
    ...createOneMonthField(
      displayOrder++,
      PurchasesStatByVendorFilterKeys.statDateMonth,
      filterNameConstant.STAT_DATE,
      opts.statDateMonth.value
    ),
    active: opts.statDateMonth.active,
    isRequired: true,
  };
  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchasesStatByVendorFilterKeys.vendorSearch,
      filterNameConstant.VENDOR_SEARCH,
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };
  const payMethodsFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchasesStatByVendorFilterKeys.payMethods,
      "결제방식",
      opts.payMethods.value,
      true,
      vendorPayMethodChoices
    ),
    active: opts.payMethods.active,
  };
  const poEventTypesFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchasesStatByVendorFilterKeys.poEventTypes,
      "발주 구분",
      opts.poEventTypes.value,
      true,
      poEventTypeEnumChoices
    ),
    active: opts.poEventTypes.active,
  };
  const vendorContactTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchasesStatByVendorFilterKeys.vendorContactType,
      "협력사 구분",
      opts.vendorContactType.value,
      true,
      vendorContactTypeChoices
    ),
    active: opts.vendorContactType.active,
    isRequired: true,
  };

  return [
    statDateMonthFilter,
    vendorSearchFilter,
    payMethodsFilter,
    !isB2b && poEventTypesFilter,
    vendorContactTypeFilter,
  ].filter(Boolean);
}
</file>

