  checkHasVendorTrackInventory,
  checkIsListActionForFulfill,
  checkIsListActionForPurchase,
  checkIsListActionFulfilled,
  checkIsListViewConsignment,
  checkIsListViewFulfilledByVendor,
  getFormInitialValues,
  getPageTitle,
  OrderLineListViewTypeEnum,
} from "./utils";

enum OrderLineListModalModeEnum {
  FULFILL_WITHOUT_PO_LINE = "FULFILL_WITHOUT_PO_LINE",
  CHANGE_TRACK_INVENTORY = "CHANGE_TRACK_INVENTORY",
  DISPATCH_REQ_EPD_UPDATE = "DISPATCH_REQ_EPD_UPDATE",
}

export interface OrderLineListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderLineListFilterKeys, OrderLineListFilterOpts> {
  params: OrderLineListViewUrlQueryParams | FbvOrderLineListViewUrlQueryParams;
  queryVariables: OrderLineListVariables;
  orderLines: OrderLineList_orderLines_edges_node[];
  onOrderNumberClick: (orderId: string) => void;
  onPurchaseOrderNumberClick: (purchaseOrderId: string) => void;
  onPurchaseOrderCreate: () => void;
  onFulfill: MutationFunction<FulfillOrder, FulfillOrderVariables>;
  onFulfillBulk: MutationFunction<FulfillOrderBulk, FulfillOrderBulkVariables>;
  onSubmitChangeTrackInventory?: MutationFunction<
    OrderLineBulkChangeTrackInventory,
    OrderLineBulkChangeTrackInventoryVariables
  >;
  onSubmitChangeTrackInventoryAfter?: MutationFunction<
    OrderLineBulkChangeTrackInventoryAfter,
    OrderLineBulkChangeTrackInventoryAfterVariables
  >;
  onConsignmentOrderLineUpdateVendor?: (orderLineId: string) => void;
  onDispatchFulfillment?: () => void;
  onPoLineReqSplitDelivery?: (orderLineId: string) => void;
  onClickOrderLineCancel?: () => void;
  isStaff: boolean;
  isVendorStaff?: boolean;
  queryVariablesWithoutPagination: OrderLineListVariables;
  fetchForDownload: (variables?: OrderLineListVariables) => Promise<ApolloQueryResult<OrderLineList>>;
  validateQueryClick?: () => boolean;
  ListNavigator?: () => React.ReactNode;
  setListElementKeys: React.Dispatch<React.SetStateAction<string[]>>;
  listElementKeys: string[];
  isB2bPurchaseWriteListView?: boolean;
  isB2b: boolean;
  isFbv: boolean;
  onRevertLinesModal?: () => void;
}

interface B2bOrderTypeCheckReduceType {
  b2bOrderTypeCheck: boolean;
  firstType: OrderType;
}

// TODO: 위탁 출고 지시는 VsPurchaseOrderLinesDispatchFulfillmentModal에서 처리하지 않고
// B2B는 modal을 띄워서 수량과 B2B 배송비가 변경될 수 있음
// 재고는 VsPurchaseOrderLinesDispatchFulfillmentModal에서 처리
const OrderLineListPage: React.FC<OrderLineListPageProps> = (props) => {
  const {
    params,
    currentTab,
    filterOpts,
    tabs,
    queryVariables,
    orderLines,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onPurchaseOrderCreate,
    onFulfill,
    onFulfillBulk,
    onDispatchFulfillment,
    onClickOrderLineCancel,
    onSubmitChangeTrackInventory,
    queryVariablesWithoutPagination,
    fetchForDownload,
    validateQueryClick,
    isVendorStaff,
    ListNavigator,
    setListElementKeys,
    listElementKeys,
    isB2bPurchaseWriteListView,
    isB2b = false,
    isFbv,
    onRevertLinesModal,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, params, isB2b, isB2bPurchaseWriteListView);
  const { orderLineListViewType, orderLineListActionType } = params;
  const isViewConsignment = checkIsListViewConsignment(orderLineListViewType);
  const isListViewFulfilledByVendor = checkIsListViewFulfilledByVendor(orderLineListViewType);
  const isListActionForPurchase = checkIsListActionForPurchase(orderLineListActionType);
  const isListActionForFulfill = checkIsListActionForFulfill(orderLineListActionType);
  const isListActionForFulfilled = checkIsListActionFulfilled(orderLineListActionType);

  let unfulfillmentViewType: UnfulfillmentViewTypeEnum;
  switch (orderLineListViewType) {
    case OrderLineListViewTypeEnum.STOCK:
      unfulfillmentViewType = UnfulfillmentViewTypeEnum.STOCK;
      break;
    case OrderLineListViewTypeEnum.CONSIGNMENT:
      unfulfillmentViewType = UnfulfillmentViewTypeEnum.CONSIGNMENT;
      break;
    case OrderLineListViewTypeEnum.STOCK_ETC:
      unfulfillmentViewType = UnfulfillmentViewTypeEnum.STOCK_ETC;
      break;
    case OrderLineListViewTypeEnum.FULFILLED_BY_VENDOR:
      unfulfillmentViewType = UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR;
      break;
  }

  const [form] = useForm();
  const formStaticValues = getFormInitialValues(orderLines);

  const [modalMode, setModalMode] = useState<OrderLineListModalModeEnum | null>(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const selectedRowExist = listElementKeys.length > 0;

  const onModalOpen = (mode: OrderLineListModalModeEnum) => {
    setModalMode(mode);
  };
  const onModalClose = () => {
    setModalMode(null);
  };

  useEffect(() => {
    form.setFieldsValue(formStaticValues);
  }, [orderLines]);

  const pageTitle = getPageTitle(params, isVendorStaff, isB2b);

  const makePageExtraUi = () => {
    const buttonText = isListActionForPurchase ? "발주서 등록" : isListActionForFulfill ? "출고 처리" : "";
    const onButtonClick = () => {
      if (isListActionForPurchase) {
        if (isB2b) {
          const selectedOrderLines = orderLines?.filter((orderLine) => listElementKeys.includes(orderLine?.id));
          const { b2bOrderTypeCheck } = selectedOrderLines.reduce<B2bOrderTypeCheckReduceType>(
            (acc, cur) => {
              if (acc.b2bOrderTypeCheck === true) {
                return acc;
              }
              if (acc.firstType === null) {
                acc.firstType = cur.order.type;
              }
              if (acc.firstType !== cur.order.type) {
                acc.b2bOrderTypeCheck = true;
              }

              return acc;
            },
            {
              b2bOrderTypeCheck: false,
              firstType: null,
            }
          );
          if (b2bOrderTypeCheck) {
            showNotificationError(
              "B2B 주문과 B2B 반품 주문에 대한 발주서를 동시에 작성할 수 없습니다. 검색필터를 통해 한 종류 씩 작성해주세요."
            );
            return;
          }
        }

        const existPurchaseOrderLine =
          orderLines?.findIndex(
            (orderLine) => listElementKeys.includes(orderLine?.id) && orderLine?.existPurchaseOrderLine === true
          ) !== -1;
        if (existPurchaseOrderLine) {
          showNotificationError("선택한 제품 중 이미 발주된 제품이 존재합니다.");
        } else {
          localStorage.setItem(consignmentPurchaseOrderLineKeys, JSON.stringify(listElementKeys));
          onPurchaseOrderCreate();
        }
        return;
      }
      if (isListActionForFulfill) {
        const isByNonCourier = parseBoolean(params.isByNonCourier, false);
        const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);

        // 선택된 orderLine 중 납품 시 금액 확정 제품이 있는지 확인
        const selectedOrderLines = orderLines?.filter((orderLine) => listElementKeys.includes(orderLine.id));
        const hasAdjustPriceProduct = selectedOrderLines?.some(
          (orderLine) => orderLine.purchaseOrderLine?.variant?.isAdjustPrice === true
        );

        if (needDeliveryManInfoForConsignmentFulfill || isB2b || hasAdjustPriceProduct) {
          return onDispatchFulfillment();
        }
        if (isViewConsignment) {
          if (checkWithoutPurchaseOrderLine(form)) {
            onModalOpen(OrderLineListModalModeEnum.FULFILL_WITHOUT_PO_LINE);
          } else {
            submitFulfillmentForm(form, onFulfill, onFulfillBulk, unfulfillmentViewType);
          }
        } else {
          submitFulfillmentForm(form, onFulfill, onFulfillBulk, unfulfillmentViewType);
        }
        return;
      }
    };

    const hasActions = isListActionForPurchase || isListActionForFulfill || isListActionForFulfilled;
    if (!hasActions) {
      return null;
    }

    const isNotFBV = unfulfillmentViewType !== UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR;
    const isButtonDisabled = listElementKeys.length === 0;

    return (
      <Space>
        {/* 납품예정일 변경 요청 버튼 */}
        {isListActionForFulfill && isNotFBV && (
          <Button
            type="primary"
            shape="round"
            disabled={isButtonDisabled}
            onClick={() => onModalOpen(OrderLineListModalModeEnum.DISPATCH_REQ_EPD_UPDATE)}
          >
            납품예정일 변경 요청
          </Button>
        )}

        {/* 출고유형 일괄변경 버튼 */}
        {isNotFBV && !isB2b && (
          <Button
            type="primary"
            shape="round"
            disabled={isButtonDisabled}
            onClick={() => onModalOpen(OrderLineListModalModeEnum.CHANGE_TRACK_INVENTORY)}
          >
            출고유형 일괄변경
          </Button>
        )}

        {/* 발주서 등록 / 출고 처리 버튼 */}
        {(isListActionForPurchase || isListActionForFulfill) && (
          <Button type="primary" shape="round" disabled={isButtonDisabled} onClick={onButtonClick}>
            {buttonText}
          </Button>
        )}

        {/* 출고 거부 버튼 */}
        {!isFbv && isViewConsignment && isListActionForFulfill && (
          <Button danger type="primary" shape="round" disabled={isButtonDisabled} onClick={() => onRevertLinesModal()}>
            출고 거부
          </Button>
        )}

        {/* 주문 취소 버튼 */}
        {isListActionForPurchase && isB2b && (
          <Button danger type="primary" shape="round" disabled={isButtonDisabled} onClick={onClickOrderLineCancel}>
            주문 취소
          </Button>
        )}
      </Space>
    );
  };

  const makeConfirmContentNode = (showFulfillmentType: boolean) => {
    // listElements은 id의 List임. orderLines에서 해당 id들의 리스트들을 뽑아낸다.
    const selectedOrderLines = orderLines?.filter((orderLine) => listElementKeys?.includes(orderLine.id));
    const columnsForChangeInventory = getOrderLineTrackChangeTableSettings(showFulfillmentType);
    return (
      <>
        <Space direction="vertical" size="small">
          <Table columns={columnsForChangeInventory} dataSource={selectedOrderLines} pagination={false} rowKey="id" />
        </Space>
      </>
    );
  };

  const rowSelection: TableRowSelection<OrderLineList_orderLines_edges_node> =
    isListActionForPurchase || isListActionForFulfill || isListActionForFulfilled
      ? {
          selectedRowKeys: form.getFieldValue(["selectedRowKeys"]),
          onChange: (selectedRowKeys: React.Key[]) => {
            form.setFields([{ name: ["selectedRowKeys"], value: selectedRowKeys }]);
            setListElementKeys(form.getFieldValue(["selectedRowKeys"]));
          },
          getCheckboxProps: (record: OrderLineList_orderLines_edges_node) => ({
            disabled:
              unfulfillmentViewType === UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR &&
              record.fulfillmentCreated !== null,
          }),
          fixed: true,
        }
      : null;
  const columns = getOrderLineTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "orderLines",
  };

  return (
    <Space direction="vertical" size={24}>
      {ListNavigator && (
        <Row justify="space-between" align="middle">
          <Col>{ListNavigator()}</Col>
        </Row>
      )}
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
          {isListActionForPurchase && (
            <Typography.Text type="warning" strong>
              매입 관리를 위해서 위탁 제품은 주문접수 전에 발주 등록(위탁제품 대행)을 해야 합니다.
            </Typography.Text>
          )}
        </Col>
        <Col>{makePageExtraUi()}</Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          validateQueryClick={validateQueryClick}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        {isListViewFulfilledByVendor === false && <TableVatLegend isIncludeVat={false} />}
        <Form form={form} initialValues={formStaticValues}>
          <Form.Item shouldUpdate>
            <Table
              {...commonTableProps}
              ref={tableRef}
              loading={listProps.disabled}
              columns={pickerSelectedColumns}
              dataSource={orderLines}
              rowSelection={rowSelection}
              scroll={{ x: tableWidthSum, y: tableScrollY }}
              footer={() => <TableListFooter {...listProps} />}
            />
          </Form.Item>
        </Form>
      </Card>
      <ConfirmModal
        visible={modalMode === OrderLineListModalModeEnum.FULFILL_WITHOUT_PO_LINE}
        titleText="선택된 위탁 주문접수 요청 리스트에 발주 등록이 안된 것이 있습니다. 이대로 진행하시겠습니까?"
        helpText="위탁 주문접수 처리가 되면 위탁 발주 등록을 할 수 없습니다."
        onOk={() => {
          submitFulfillmentForm(form, onFulfill, onFulfillBulk, unfulfillmentViewType);
          onModalClose();
        }}
        onCancel={onModalClose}
      />
      <ConfirmModal
        visible={modalMode === OrderLineListModalModeEnum.CHANGE_TRACK_INVENTORY}
        modalTitleText="출고 유형 변경"
        titleText=""
        helpText={`아래의 주문상품들의 출고유형을 '위탁'에서 '재고'로 변경하시겠습니까?`}
        width={800}
        contentNode={makeConfirmContentNode(true)}
        onOk={() => {
          const hasVendorTrackInventory = checkHasVendorTrackInventory(orderLines, listElementKeys);
          if (hasVendorTrackInventory) {
            showNotificationError("위탁재고 제품은 출고 유형을 변경할 수 없습니다.");
            return;
          }
          // 출고 완료페이지인경우와 아닌경우 mutation이 다름.
          const changeTrackInventoryMutation = isListActionForFulfilled
            ? props.onSubmitChangeTrackInventoryAfter
            : props.onSubmitChangeTrackInventory;
          changeTrackInventoryMutation({
            variables: {
              ids: listElementKeys,
              input: {
                trackInventory: true,
              },
            },
          });
          onModalClose();
        }}
        onCancel={onModalClose}
      />
      {unfulfillmentViewType !== UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR && (
        <VsPurchaseOrderLinesReqEpdUpdateModal
          open={selectedRowExist && modalMode === OrderLineListModalModeEnum.DISPATCH_REQ_EPD_UPDATE}
          loading={listProps.disabled}
          isApproveMode={false}
          poLines={maybe(
            () =>
              orderLines
                ?.filter((orderLine) => listElementKeys?.includes(orderLine.id) && orderLine.purchaseOrderLine)
                .map((orderLine) => orderLine.purchaseOrderLine),
            []
          )}
          onCancel={() => {
            setListElementKeys([]);
            onModalClose();
          }}
        />
      )}
    </Space>
  );
};

export default OrderLineListPage;
</file>

