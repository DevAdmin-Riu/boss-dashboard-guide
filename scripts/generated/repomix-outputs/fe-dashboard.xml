import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import CountryList from "@src/app/components/CountryList";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { ShopInfo_shop_shippingCountries } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { Checkbox, Form, Input, Space } from "antd";
import React, { useEffect, useState } from "react";

import ShippingZoneCountriesAssignDialog from "../ShippingZoneCountriesAssignDialog";
import ShippingZoneInfo from "../ShippingZoneInfo";

interface ShippingZoneCreatePageProps {
  countries: ShopInfo_shop_shippingCountries[];
  disabled: boolean;
  errors: ShippingErrorFragment[];
  saveButtonBarState: ConfirmButtonTransitionState;
  onBack: () => void;
  onSubmit: (formData: ShippingZoneCreateInput) => void;
}

const ShippingZoneCreatePage: React.FC<ShippingZoneCreatePageProps> = ({
  countries,
  disabled,
  saveButtonBarState,
  onBack,
  onSubmit,
}) => {
  const [modalOpen, setModalOpen] = useState<boolean>(false);
  const [hasChanged, setHasChanged] = useState<boolean>(false);
  const [form] = Form.useForm<ShippingZoneCreateInput>();
  const defaultWatched = Form.useWatch("default", form);
  const countriesWatched = Form.useWatch("countries", form) || [];

  const initialValues: ShippingZoneCreateInput = {
    name: "",
    default: false,
    countries: [],
  };

  useEffect(() => {
    form.resetFields();
  }, []);

  const onModalClose = () => setModalOpen(false);

  return (
    <Form
      name="shipping-zone-update-form"
      layout="vertical"
      size="large"
      form={form}
      disabled={disabled}
      initialValues={initialValues}
      onValuesChange={() => setHasChanged(true)}
      onFinish={onSubmit}
    >
      <AppHeader onBack={onBack}>{sectionNames.shipping}</AppHeader>
      <PageHeader title="배송 지역 추가" />
      <Grid>
        <Space direction="vertical" size="large">
          <ShippingZoneInfo />
          <CountryList
            countries={countriesWatched.map((selectedCountry) =>
              countries.find((country) => country.code === selectedCountry)
            )}
            disabled={disabled}
            emptyText={defaultWatched ? "기본 배송지역입니다." : "연동된 지역이 없습니다."}
            onCountryAssign={() => setModalOpen(true)}
            onCountryUnassign={(countryCode) =>
              form.setFieldsValue({ countries: countriesWatched.filter((country) => country !== countryCode) })
            }
            title="지역"
          />
          <Form.Item name="default" valuePropName="checked" hidden>
            <Checkbox />
          </Form.Item>
          <Form.Item name="countries" hidden>
            <Input />
          </Form.Item>
        </Space>
      </Grid>
      <SaveButtonBar
        disabled={disabled || !hasChanged}
        onCancel={onBack}
        onSave={form.submit}
        state={saveButtonBarState}
      />

      <ShippingZoneCountriesAssignDialog
        open={modalOpen}
        onConfirm={(formData) => {
          form.setFieldsValue({ countries: formData.restOfTheWorld ? [] : formData.countries });
          onModalClose();
        }}
        countries={countries}
        initial={countriesWatched}
        isDefault={defaultWatched}
        onClose={onModalClose}
      />
    </Form>
