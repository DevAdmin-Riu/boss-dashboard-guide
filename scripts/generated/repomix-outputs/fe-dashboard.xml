import React from "react";

import { HqScheduleList_schedules_edges_node } from "../../api/types/HqScheduleList";
import { checkIsScheduleWriter } from "../../utils";
import { HqScheduleListPageProps } from "./HqScheduleListPage";

export const getHqScheduleListTableSettings = (props: HqScheduleListPageProps, user: User) => {
  const { onDelete } = props;

  const columns: ColumnsType<HqScheduleList_schedules_edges_node> = [
    {
      title: "일정 정보",
      key: "oneColumn",
      width: 300,
      render: (_, record) => {
        const { id, start, end, title, description, writer, participants } = record;
        const isScheduleWriter = checkIsScheduleWriter(record, user);

        return (
          <Space direction="vertical" size={0}>
            <Row justify="space-between">
              <Typography.Title level={5}>{title}</Typography.Title>
              <Button
                danger
                size="small"
                icon={<CloseOutlined />}
                disabled={!isScheduleWriter}
                onClick={(e) => {
                  e.stopPropagation();
                  onDelete(id);
                }}
              />
            </Row>
            <Typography.Text italic>
              {getDateRangeByFormat([start, end], detailDateFormatWithHourMinute)}
            </Typography.Text>
            <Descriptions
              className={getDescriptionsClassName(["ant-descriptions-item-label-no-width"])}
              size="small"
              column={1}
            >
              <Descriptions.Item label="내용">{description || "-"}</Descriptions.Item>
              <Descriptions.Item label="작성자">
                <Tag>{writer.firstName}</Tag>
              </Descriptions.Item>
              <Descriptions.Item label="참여자">
                {participants.length === 0 ? (
                  "-"
                ) : (
                  <Space size={2} wrap>
                    {participants.map((p) => (
                      <Tag key={p.id}>{p.firstName}</Tag>
                    ))}
                  </Space>
                )}
              </Descriptions.Item>
            </Descriptions>
          </Space>
        );
      },
    },
  ];
  return columns.filter(Boolean);
};
