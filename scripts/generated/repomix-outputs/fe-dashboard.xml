import { GraphQLError } from "graphql";

import { commonErrorMsg } from "../../../assets/messages/errors/commonError";
import { showNotificationError } from "./wrapper";

export const makeGqlMaxLimitIssueErrorMsg = (maxLimit, totalCount) =>
  `${commonErrorMsg.maxLimitIssue}. (${maxLimit} -> ${totalCount})`;

export interface GqlErrorType {
  code?: any;
  message: string | null;
  field: string | null;
}

const makeGqlErrorMsgInternal = (message: string, code?: any, field?: string) => {
  if (code) {
    if (field) {
      return `${message} (${code}:${field})`;
    }
    return `${message} (${code})`;
  }
  return message;
};

export const makeGqlErrorMsg = (errorObj) => {
  if (!errorObj) {
    return "";
  }
  const { message } = errorObj;
  return makeGqlErrorMsgInternal(message);
};

const makeGraphqlErrorMsgInternal = (message: string, path?: any) => {
  if (path) {
    return `${message} (${path})`;
  }
  return message;
};

export const makeGraphqlErrorMsg = (errorObj) => {
  const { message, path } = errorObj;
  return makeGraphqlErrorMsgInternal(message, path);
};

export const showGqlErrors = (
  gqlErrors: GqlErrorType[],
  makeGqlErrorMsgFn: (error: GqlErrorType | any) => string = undefined,
  displayOnlyOne: boolean = true
) => {
  if (!gqlErrors || gqlErrors.length <= 0) {
    return;
  }

  if (displayOnlyOne) {
    const firstErrorObj = gqlErrors[0];
    showNotificationError(makeGqlErrorMsgFn ? makeGqlErrorMsgFn(firstErrorObj) : makeGqlErrorMsg(firstErrorObj));
    return;
  }

  gqlErrors.map((errorObj) =>
    showNotificationError(makeGqlErrorMsgFn ? makeGqlErrorMsgFn(errorObj) : makeGqlErrorMsg(errorObj))
  );
};

export const showGqlErrorInfo = (message: string, code?: any, field?: string) => {
  showNotificationError(makeGqlErrorMsgInternal(message, code, field));
};

export const showGraphQLErrors = (graphqlErrors: readonly GraphQLError[], displayOnlyOne: boolean = true) => {
  if (!graphqlErrors || graphqlErrors.length <= 0) {
    return;
  }

  if (displayOnlyOne) {
    const firstErrorObj = graphqlErrors[0];
    showNotificationError(makeGraphqlErrorMsg(firstErrorObj));
    return;
  }

  graphqlErrors.map((errorObj) => showNotificationError(makeGraphqlErrorMsg(errorObj)));
};
</file>

