<file path="src/app/views/customer/customers/components/RcoinsBulkIncreaseModal.tsx">
import { paymentTerm } from "@assets/messages/commonMsg";
import { RcoinsBulkIncreaseDetail, RcoinsBulkIncreaseInput } from "@src/api/types/globalTypes";
import { loadWorkbookByBuffer, parseWorksheetToCsvArr } from "@utils/excel/excelDownload";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Form, Input, Modal, Space, Typography } from "antd";
import React, { useEffect, useRef, useState } from "react";

import { rcoinsEventListQuery } from "../../points/api/queries";
import { useRcoinsBulkIncreaseMutation } from "../api/mutations";

interface RcoinsBulkIncreaseModalProps {
  open: boolean;
  onClose: () => void;
}

export const RcoinsBulkIncreaseModal: React.FC<RcoinsBulkIncreaseModalProps> = (props) => {
  const { open, onClose } = props;
  const upload = useRef<HTMLInputElement>();
  const handleUploadButtonClick = () => upload.current.click();
  const [selectedFile, setSelectedFile] = useState<string>();
  const [errorExist, setErrorExist] = useState<boolean>(false);

  const [form] = Form.useForm<RcoinsBulkIncreaseInput>();
  const detailsWatched = Form.useWatch("details", form);
  const initialValues: RcoinsBulkIncreaseInput = { details: [], reason: "" };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const onModalClose = () => {
    setErrorExist(false);
    setSelectedFile(undefined);
    onClose();
  };

  const [rcoinsBulkIncrease, rcoinsBulkIncreaseOpts] = useRcoinsBulkIncreaseMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data?.rcoinsBulkIncrease?.errors, "포인트가 일괄 충전되었습니다.", () => {
        onModalClose();
      }),
    refetchQueries: [rcoinsEventListQuery],
  });

  const modalLoading = rcoinsBulkIncreaseOpts.loading;

  const showErrorMessageWithLabel = (label: string, errors: string[]) => {
    const errorMsg = (
      <>
        {label}:<br />
        {errors.join(", ")}
      </>
    );
    showNotificationError(errorMsg);
  };

  const validateDuplicate = (details: RcoinsBulkIncreaseDetail[]) => {
    const loginIds = [];
    const errors = [];

    for (const detail of details) {
      const loginId = detail.loginId;

      if (loginIds.find((c) => c === loginId)) {
        errors.push(loginId);
      } else {
        loginIds.push(loginId);
      }
    }

    const isOk = errors.length <= 0;
    if (!isOk) {
      showErrorMessageWithLabel("매장 ID 중복", errors);
    }
    return isOk;
  };

  const validateAmountValue = (details: RcoinsBulkIncreaseDetail[]) => {
    // NOTE: 최대값은 100만원. 추후 포인트 일괄 충전 최대값을 플러그인의 정보로 분리 시, 수정 필요
    const maxValue = 1000000;
    const amountErrors = [];

    for (const detail of details) {
      const loginId = detail.loginId;
      const amount = detail.amount;

      if (amount <= 0 || amount > maxValue) {
        amountErrors.push(loginId);
      }
    }

    const isOk = amountErrors.length <= 0;
    if (!isOk) {
      showErrorMessageWithLabel(
        `충전 포인트 금액 오류 - 입력 시 1 이상, ${maxValue.toLocaleString()} 이하인 금액으로 입력해야 합니다. (ID)`,
        amountErrors
      );
    }
    return isOk;
  };

  const readUploadFile = async (e) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        // 헤더 로우가 없으므로, header: 1로 설정 - [['loginId1', 1000], ['loginId2', 2000], ...] 형태로 변환하여 리턴 됨.
        const valuesArray = parseWorksheetToCsvArr({ worksheet });
        const details: RcoinsBulkIncreaseDetail[] = valuesArray.map(([loginId, amount]) => ({ loginId, amount }));

        // 확인 버튼 클릭 시점이 아닌, 엑셀 파일 선택 및 업로드 시점에 validation 체크
        const validateAry = [];
        validateAry.push(validateDuplicate(details));
        validateAry.push(validateAmountValue(details));

        if (validateAry.findIndex((v) => v === false) >= 0) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        form.setFields([{ name: "details", value: details }]);
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }

    if (upload.current) {
      upload.current.value = "";
    }
  };

  const onSubmit = async (formData: RcoinsBulkIncreaseInput) => {
    rcoinsBulkIncrease({ variables: { input: formData } });
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title={`${paymentTerm.rcoins} 일괄 충전`}
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      onCancel={onModalClose}
      okButtonProps={{ loading: modalLoading, disabled: utils.isEmpty(detailsWatched) }}
      cancelButtonProps={{ loading: modalLoading }}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="vertical"
        name="rcoins-bulk-increase-form"
        onFinish={onSubmit}
      >
        <Form.Item
          name="details"
          label="파일 업로드"
          rules={[{ required: true, message: `${paymentTerm.rcoins} 일괄 충전할 엑셀 파일을 선택해 주세요.` }]}
        >
          <Space direction="vertical" size={0}>
            <Typography.Text style={{ fontSize: "12px" }} strong type="warning">
              A열에는 회원 아이디, B열에는 충전할 포인트를 입력한 엑셀 파일을 업로드해 주세요.
            </Typography.Text>
            <Button onClick={handleUploadButtonClick} type="primary">
              엑셀 파일 선택
            </Button>
            {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
            {errorExist && <Typography.Text type="warning">엑셀 파일을 다시 선택해 주세요.</Typography.Text>}
            <input
              hidden={true}
              id="rcoinsBulkIncreaseInputFile"
              onChange={(e) => readUploadFile(e)}
              type="file"
              ref={upload}
              accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
            />
          </Space>
        </Form.Item>
        <Form.Item name="reason" label="충전 사유" rules={[{ required: true, message: "충전 사유를 입력해 주세요." }]}>
          <Input.TextArea />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

