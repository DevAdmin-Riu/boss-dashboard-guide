const { Item: FItem } = Form;

interface OrderAddressEditDialogProps {
  open: boolean;
  loading: boolean;
  order: OrderDetails_order;
  onClose: () => void;
  onConfirm: (data: AddressInput) => void;
}

const OrderAddressEditDialog: React.FC<OrderAddressEditDialogProps> = (props) => {
  const { open, loading, order, onClose, onConfirm } = props;
  const [daumPostcodeOpen, setDaumPostcodeOpen] = useState<boolean>(false);
  const [form] = Form.useForm<AddressInput>();
  const initialValues: AddressInput = transformAddressToForm(order?.shippingAddress);

  const onReset = () => {
    form.resetFields();
    setDaumPostcodeOpen(false);
  };

  const onModalClose = () => {
    onReset();
    onClose();
  };

  useEffect(() => {
    if (open) {
      onReset();
    }
  }, [open]);

  const onDaumPostcodeComplete = (address: Address) => {
    const convertedAddress = makeAddressInputFromDaumPostcode(address);
    form.setFieldsValue(convertedAddress);
    setDaumPostcodeOpen(false);
