  const arrayBuffer = await response.arrayBuffer();
  const workbook = await loadWorkbookByBuffer(arrayBuffer);
  return workbook;
};

export interface IRequestExcelDownloadProps {
  title: string;
  workbook: ExcelJS.Workbook;
}

const transformXlsxFileName = (title: string) => (title.endsWith(".xlsx") ? title : `${title}.xlsx`);

export const requestExcelDownloadByExceljs = async (props: IRequestExcelDownloadProps) => {
  const { title, workbook } = props;
  const xlsxFileName = transformXlsxFileName(title);

  if (utils.checkWebView()) {
    // TODO: 추후 기존 xlsx-js-style 라이브러리를 exceljs로 대체하면서 모바일에도 동일하게 라이브러리 대체 작업 및 sendMessageToWebView 이용하도록 수정 필요
    // sendMessageToWebView("EXCEL_DOWNLOAD", props);
    showNotificationError("해당 파일 다운로드는 모바일 앱에선 지원하지 않습니다.");
  } else {
    const buffer = await workbook.xlsx.writeBuffer();
    const blob = new Blob([buffer], { type: excelMimeType });
    saveAs(blob, xlsxFileName);
  }
};

export const convertWorkbookToXlsxFileByExceljs = async (props: IRequestExcelDownloadProps): Promise<File> => {
  const { title, workbook } = props;
  const xlsxFileName = transformXlsxFileName(title);
  const buffer = await workbook.xlsx.writeBuffer();
  const xlsxFileBlob = new Blob([buffer], { type: excelMimeType });
  const xlsxFile = new File([xlsxFileBlob], xlsxFileName, { type: excelMimeType, lastModified: Date.now() });
  return xlsxFile;
};

/**
 * 엑셀 시리얼 날짜 값(Serial Date Value)을 JavaScript Date 객체로 변환합니다.
 * ExcelJS의 내부 로직과 유사하게, 1900년 1월 1일을 기준으로 계산합니다.
 * @param serial - 엑셀에서 읽어온 숫자 값 (예: 46003)
 * @returns Date 객체 또는 null
 */
const excelSerialDateToJSDate = (serial: number): Date | null => {
  if (typeof serial !== "number" || serial <= 0) {
    return null;
  }

  // 엑셀 날짜는 1900년 1월 1일이 '1'입니다. JavaScript는 0을 기준으로 합니다.
  // Excel 시리얼 날짜는 1900년 1월 1일부터의 '일' 수이므로,
  // 밀리초(milliseconds)로 변환하여 Date 객체를 생성합니다.

  // 1. 1900년 1월 1일 UTC를 기준으로 하는 Date 객체
  const date = new Date(Date.UTC(1899, 11, 31));

  // 2. 시리얼 값(일 수)을 밀리초로 변환하여 더합니다. (24시간 * 60분 * 60초 * 1000ms)
  // 엑셀은 1900년 2월 29일 버그를 포함하므로, 엑셀 시리얼 넘버가 60 이상일 때 하루를 빼줘야 합니다.
  const daysSince1900 = serial >= 60 ? serial - 1 : serial;
  const msInDay = 24 * 60 * 60 * 1000;

  date.setTime(date.getTime() + daysSince1900 * msInDay);
  return date;
};

const convertCellValueForMutate = (props: {
  cell: ExcelJS.Cell;
  headerKey?: string;
  dateFormat?: string;
  maxDecimalPoint?: number;
}): any => {
  const { cell, headerKey = "", dateFormat = onlyDateFormat, maxDecimalPoint = 10 } = props;
  const rawCellValue = cell.type === ExcelJS.ValueType.Formula ? cell.result : cell.value;
  const processors = [cleanExcelString, coerceExcelBoolean];
  const cellValue = processors.reduce((acc, fn) => fn(acc), rawCellValue);

  if (typeof cellValue === "object") {
    if (cell.type === ExcelJS.ValueType.Date) {
      return moment(cellValue as Date).format(dateFormat);
    }
    if (cell.type === ExcelJS.ValueType.RichText) {
      return cell.text;
    }
  } else if (typeof cellValue === "number") {
    if (headerKey.endsWith("Date")) {
      const extractedDateValue = excelSerialDateToJSDate(cellValue);
      return moment(extractedDateValue).format(dateFormat);
    } else {
      return parseFloat(cellValue.toFixed(maxDecimalPoint));
    }
  } else {
    return cellValue;
  }
};

export const parseWorksheetToJsonArr = <T extends any>(props: {
  worksheet: ExcelJS.Worksheet;
  headerRowNum?: number;
  dateFormat?: string;
  maxDecimalPoint?: number;
}): T[] => {
  const { worksheet, headerRowNum = 2, dateFormat, maxDecimalPoint } = props;

  const headers: string[] = [];
  worksheet.getRow(headerRowNum)?.eachCell({ includeEmpty: true }, (cell) => {
    headers.push(utils.trim(cell.value) || "");
  });

  const uploadedDetails: T[] = [];
  for (let i = headerRowNum + 1; i <= worksheet.rowCount; i++) {
    const row = worksheet.getRow(i);
    if (row.hasValues) {
      const detail: Partial<T> = {};

      row.eachCell({ includeEmpty: true }, (cell, colNumber) => {
        const headerKey = headers[colNumber - 1];
        if (headerKey) {
          const convertedCellValue = convertCellValueForMutate({ cell, headerKey, dateFormat, maxDecimalPoint });
          detail[headerKey] = convertedCellValue;
        }
      });
      uploadedDetails.push(detail as T);
    }
  }
  return uploadedDetails;
};

export const parseWorksheetToCsvArr = (props: {
  worksheet: ExcelJS.Worksheet;
  dateFormat?: string;
  maxDecimalPoint?: number;
}): any[][] => {
  const { worksheet, dateFormat, maxDecimalPoint } = props;

  const uploadedDetails: any[][] = [];
  for (let i = 1; i <= worksheet.rowCount; i++) {
    const row = worksheet.getRow(i);
    if (row.hasValues) {
      const detail: any[] = [];

      row.eachCell({ includeEmpty: true }, (cell, _colNumber) => {
        const convertedCellValue = convertCellValueForMutate({ cell, dateFormat, maxDecimalPoint });
        detail.push(convertedCellValue);
      });
      uploadedDetails.push(detail);
    }
  }
  return uploadedDetails;
};
