export const makeBrandEtcFilesDataSource = (
  etcFiles: BrandDetails_brand_etcFiles[],
  etcInfo: any,
  isContractFile: boolean
) => {
  const defaultEtcFile: BrandEtcFileDataSource = {
    id: "",
    type: null,
    fileName: "",
    description: "",
    contractDate: null,
    startDate: null,
    endDate: null,
    url: "",
    deposit: null,
    fee: null,
    __typename: "BrandEtcFile",
  };

  const targetFileTypes = isContractFile ? brandContractFileTypeChoices : brandFeeFileTypeChoices;
  const targetFileTypesArr = targetFileTypes.map((c) => c.value);
  const defaultDataSource = targetFileTypesArr.map((type) => {
    const etcFileIdx = etcFiles?.findIndex((etcFile) => etcFile.type === type);
    if (etcFileIdx === -1) {
      return { ...defaultEtcFile, type };
    }
    const etcFile = etcFiles[etcFileIdx];
    const deposit = isContractFile ? etcInfo[getBrandEtcInfoKey(type)] : null;
    const fee = isContractFile ? null : getBrandEtcFileFeeRate(type, etcInfo);
    return { ...etcFile, deposit, fee };
  });

  return defaultDataSource;
};

