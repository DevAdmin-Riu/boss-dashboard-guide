  Upload,
} from "antd";
import React from "react";

import { RequestFbvProductDetails_requestFbvProduct } from "../../api/types/RequestFbvProductDetails";
import { getRequestFbvProductStatusColor, getRequestFbvProductStatusText } from "../../utils";

export interface IVendorForReq extends FbvVendorForReqFragment {
  label: string;
  value: string;
  key: string;
}

interface ReqFbvProductFormProps<T> {
  form: FormInstance<T>;
  vendorList: IVendorForReq[];
  isUpdate?: boolean;
  isReject?: boolean;
  vendorInfoSetFieldValue: (form: FormInstance<T>, vendor: IVendorForReq) => void;
  requestFbvProductData?: RequestFbvProductDetails_requestFbvProduct;
}

const ReqFbvProductForm: React.FC<ReqFbvProductFormProps<any>> = (props) => {
  const { form, vendorList, isUpdate, isReject, vendorInfoSetFieldValue, requestFbvProductData } = props;
  const vendorSelectOnChange = (_value: string, option: IVendorForReq): void => {
    vendorInfoSetFieldValue(form, option);
  };

  const isDisableMode = isUpdate && !isReject;

  const thumbnailTitleUi = (
    <Space direction="horizontal">
      {<Typography.Text>썸네일 이미지</Typography.Text>}
      {<Tag color="red">필수</Tag>}
    </Space>
  );

  const vendorGuidUi = (
    <Space direction="vertical">
      <Typography.Text type="danger">
        상품 공급 협력사가 포장보스 시스템에 등록되어 있어야 직거래 상품 요청등록하실 수 있습니다.
      </Typography.Text>
      <Typography.Text type="danger">
        협력사가 선택리스트에 없는 경우 담당MD 에게 문의하시면 추가 가능합니다.
      </Typography.Text>
    </Space>
  );

  return (
    <Card>
      <Typography.Title level={4}>상품 정보</Typography.Title>
      <CardSpacer />
      <Row gutter={[12, 12]}>
        <Col span={12}>
          <Form.Item name="productName" label="상품명" required>
            <Input
              disabled={isDisableMode}
              size="large"
              name="productName"
              placeholder="이용하시던 상품명을 입력해주세요."
              onChange={(e) => form.setFieldsValue({ productName: e.target.value })}
            />
          </Form.Item>
        </Col>
        <Col span={12}>
          <Form.Item name="category" label="카테고리" required>
            <Input
              disabled={isDisableMode}
              size="large"
              name="category"
              placeholder="상품의 카테고리를 입력해주세요. (예: 피자박스, 얼음컵 등)"
              onChange={(e) => form.setFieldsValue({ category: e.target.value })}
            />
          </Form.Item>
        </Col>
      </Row>

      <Row gutter={[12, 12]}>
        <Col span={8}>
          <Form.Item name="spec" label="규격" required>
            <Input
              disabled={isDisableMode}
              size="large"
              name="spec"
              placeholder="규격(용량, 중량 등)을 입력해주세요."
              onChange={(e) => form.setFieldsValue({ spec: e.target.value })}
            />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="material" label="재질">
            <Input
              disabled={isDisableMode}
              size="large"
              name="material"
              placeholder="재질(식자재의 경우 재료)를 입력해주세요."
              onChange={(e) => form.setFieldsValue({ material: e.target.value })}
            />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="color" label="색상">
            <Input
              disabled={isDisableMode}
              size="large"
              name="color"
              placeholder="색상을 입력해주세요."
              onChange={(e) => form.setFieldsValue({ color: e.target.value })}
            />
          </Form.Item>
        </Col>
      </Row>

      <Row gutter={[12, 12]}>
        <Col span={8}>
          <Form.Item name="qtyPerBox" label="입수량" required>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              disabled={isDisableMode}
              size="large"
              placeholder="1회 주문 시 총 입수량(낱개)을 입력해주세요."
            />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="costPriceExcludeVat" label="협력사 매입가 (부가세 별도)" required>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              disabled={isDisableMode}
              size="large"
              placeholder="1회(1상자) 주문 시 매입가를 부가세 별도가로 입력해주세요."
            />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="priceExcludeVat" label="매장 판매가 (부가세 별도)" required>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              disabled={isDisableMode}
              size="large"
              placeholder="1회(1상자) 주문 시 판매가를 부가세 별도가로 입력해주세요."
            />
          </Form.Item>
        </Col>
      </Row>
      <CardSpacer />

      <Typography.Title level={4}>협력사 정보</Typography.Title>
      {vendorGuidUi}
      <CardSpacer />
      <Row gutter={[12, 12]}>
        <Col span={8}>
          <Form.Item name="vendorList" label="협력사명" required>
            <Select
              disabled={isDisableMode}
              size="large"
              showSearch
              onChange={vendorSelectOnChange}
              onSearch={(value: string) => value}
              options={vendorList}
            />
          </Form.Item>
          <Form.Item hidden name="vendor">
            <Input></Input>
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="vendorName" label="협력사 대표명">
            <Input disabled size="large" />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="vendorBizRegNo" label="협력사 사업자등록번호">
            <Input disabled size="large" />
          </Form.Item>
        </Col>
      </Row>

      <Row gutter={[12, 12]}>
        <Col span={8}>
          <Form.Item name="vendorManagerName" label="업무 담당자">
            <Input disabled size="large" />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="vendorManagerEmail" label="담당자 이메일">
            <Input disabled size="large" />
          </Form.Item>
        </Col>
        <Col span={8}>
          <Form.Item name="vendorManagerPhone" label="담당자 연락처">
            <Input disabled size="large" />
          </Form.Item>
        </Col>
      </Row>
      <Row gutter={[12, 12]}>
        <Col span={8}>
          <Card title={thumbnailTitleUi}>
            {!isDisableMode && (
              <Form.Item {...formItemPropsForFileListUpload} name="thumbnailImage" required>
                <Upload
                  listType="picture"
                  customRequest={({ onSuccess }) => {
                    setTimeout(() => {
                      onSuccess("ok");
                    }, 0);
                  }}
                  maxCount={1}
                  accept="image/*"
                >
                  <Button icon={<UploadOutlined />}>상품 이미지</Button>
                </Upload>
              </Form.Item>
            )}
            {isUpdate && <Image width={200} src={requestFbvProductData?.thumbnailImage?.url} />}
          </Card>
        </Col>
        {isUpdate && (
          <Col span={16}>
            <Card title={<Typography.Text>요청 처리 내역</Typography.Text>}>
              {requestFbvProductData && (
                <Timeline>
                  {requestFbvProductData.statusHistories.map((statusHistory, index) => {
                    const beforeStatus = statusHistory.beforeStatus;
                    const afterStatus = statusHistory.afterStatus;
                    const beforeStatusText = getRequestFbvProductStatusText(beforeStatus);
                    const beforeStatusColor = getRequestFbvProductStatusColor(beforeStatus);
                    const afterStatusText = getRequestFbvProductStatusText(afterStatus);
                    const afterStatusColor = getRequestFbvProductStatusColor(afterStatus);
                    const statusChangeUi = beforeStatus ? (
                      <Space>
                        <Tag color={beforeStatusColor}>{beforeStatusText}</Tag>→
                        <Tag color={afterStatusColor}>{afterStatusText}</Tag>
                      </Space>
                    ) : (
                      <Tag color={afterStatusColor}>{afterStatusText}</Tag>
                    );
                    return (
                      <Timeline.Item key={index} color={afterStatusColor}>
                        <TimelineNote
                          date={statusHistory.createdAt}
                          user={statusHistory.writer}
                          tag={statusChangeUi}
                          message={
                            afterStatus === RequestFbvProductStatusEnum.REJECTED ? statusHistory.reason : undefined
                          }
                        />
                      </Timeline.Item>
                    );
                  })}
                </Timeline>
              )}
            </Card>
          </Col>
        )}
      </Row>
    </Card>
  );
};

export default ReqFbvProductForm;
</file>

