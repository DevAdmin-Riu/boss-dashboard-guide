import { ModusignDocStatusEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { getModusignDocumentStatusChoices } from "../../views/ModusignDocumentListView/utils";

export enum ModusignDocumentListFilterKeys {
  title = "title",
  startedAt = "startedAt",
  updatedAt = "updatedAt",
  status = "status",
}

export interface ModusignDocumentListFilterOpts {
  title: FilterOpts<string>;
  startedAt: FilterOpts<MinMax>;
  updatedAt: FilterOpts<MinMax>;
  status: FilterOpts<ModusignDocStatusEnum>;
}

export function createFilterStructure(opts: ModusignDocumentListFilterOpts): IFilter<ModusignDocumentListFilterKeys> {
  const titleFilter = {
    ...createTextField(0, ModusignDocumentListFilterKeys.title, "문서명", opts.title.value),
    active: opts.title.active,
  };
  const statusFilter = {
    ...createOptionsField(
      0,
      ModusignDocumentListFilterKeys.status,
      "문서 상태",
      [opts.status.value],
      false,
      getModusignDocumentStatusChoices()
    ),
    active: opts.status.active,
  };
  const startedAtFilter = {
    ...createDateField(0, ModusignDocumentListFilterKeys.startedAt, "문서 요청일", opts.startedAt.value),
    active: opts.startedAt.active,
  };
  const updatedAtFilter = {
    ...createDateField(0, ModusignDocumentListFilterKeys.updatedAt, "마지막 활동일", opts.updatedAt.value),
    active: opts.updatedAt.active,
  };

  return utils.filterDisplayOrdering([titleFilter, statusFilter, startedAtFilter, updatedAtFilter]).filter(Boolean);
}
</file>

