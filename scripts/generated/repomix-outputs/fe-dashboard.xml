<file path="src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeCommentModal.tsx">
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { NoticeFromHqDetails_notice_noticeBrandStoresQas } from "@src/app/views/notice/notices/api/types/NoticeFromHqDetails";
import { utils } from "@utils/utils";
import { Button, Card, Divider, Input, List, Modal, Typography } from "antd";
import React, { useState } from "react";

import { useNoticeBrandStoresQAReplyMutation } from "../../api/mutations";

interface CommentModalProps {
  open: boolean;
  onClose: () => void;
  brandStoreName: string;
  comments: NoticeFromHqDetails_notice_noticeBrandStoresQas[];
}

export const NoticeCommentModal: React.FC<CommentModalProps> = ({ open, onClose, brandStoreName, comments }) => {
  const [replyMap, setReplyMap] = useState<Record<string, string>>({});
  const [loadingMap, setLoadingMap] = useState<Record<string, boolean>>({});

  const [noticeBrandStoresQAReply] = useNoticeBrandStoresQAReplyMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeBrandStoresQAReply.errors, "답변이 등록되었습니다."),
  });

  const handleReplyChange = (id: string, value: string) => {
    setReplyMap((prev) => ({ ...prev, [id]: value }));
  };

  const handleSubmitReply = async (id: string) => {
    const reply = replyMap[id];
    if (!reply?.trim()) {
      return;
    }

    setLoadingMap((prev) => ({ ...prev, [id]: true }));

    await noticeBrandStoresQAReply({
      variables: {
        id,
        input: { aContent: reply.trim() },
      },
    });

    setLoadingMap((prev) => ({ ...prev, [id]: false }));
    setReplyMap((prev) => ({ ...prev, [id]: "" }));
  };

  return (
    <Modal
      open={open}
      onCancel={onClose}
      onOk={onClose}
      title={`매장: ${brandStoreName}`}
      width={700}
      footer={null}
      maskClosable={false}
    >
      <List
        dataSource={comments}
        itemLayout="vertical"
        style={{ maxHeight: 500, overflowY: "auto", paddingRight: 8 }}
        renderItem={(qa) => (
          <List.Item key={qa.id}>
            <Card size="small" style={{ marginBottom: 12 }}>
              <Typography.Text strong>Q. {qa.qContent}</Typography.Text>
              <br />
              <Typography.Text type="secondary" style={{ fontSize: 12 }}>
                {getDateByFormat(qa.qCreatedAt, onlyDateFormat)}
              </Typography.Text>
              <Divider />
              {qa.aContent ? (
                <div style={{ textAlign: "right" }}>
                  <Typography.Text strong>A. {qa.aContent}</Typography.Text>
                  <br />
                  <Typography.Text type="secondary" style={{ fontSize: 12 }}>
                    {getDateByFormat(qa.aCreatedAt, onlyDateFormat)}
                  </Typography.Text>
                </div>
              ) : (
                <>
                  <Typography.Text type="danger">아직 답변이 등록되지 않았습니다.</Typography.Text>
                  <Input.TextArea
                    rows={2}
                    placeholder="답변을 입력하세요..."
                    style={{ marginTop: 8 }}
                    value={replyMap[qa.id] || ""}
                    onChange={(e) => handleReplyChange(qa.id, e.target.value)}
                  />
                  <div style={{ textAlign: "right", marginTop: 8 }}>
                    <Button
                      type="primary"
                      size="small"
                      loading={loadingMap[qa.id]}
                      onClick={() => handleSubmitReply(qa.id)}
                    >
                      답변 등록
                    </Button>
                  </div>
                </>
              )}
            </Card>
          </List.Item>
        )}
      />
    </Modal>
  );
};
</file>

<file path="src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqCommentByStore.tsx">
import { commonTableProps, getTableRowClassName } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { NoticeFromHqDetails_notice } from "@src/app/views/notice/notices/api/types/NoticeFromHqDetails";
import { utils } from "@utils/utils";
import { Card, Table, Typography } from "antd";
import type { ColumnsType } from "antd/es/table";
import React, { useMemo, useState } from "react";

import { NoticeCommentModal } from "./NoticeCommentModal";

interface Props {
  notice: NoticeFromHqDetails_notice;
}

interface RowData {
  brandStoreId: string;
  brandStoreCode: string;
  brandStoreName: string;
  latestCommentDate: string;
  totalComments: number;
  unansweredCount: number;
}

const NoticeFromHqCommentByStore: React.FC<Props> = ({ notice }) => {
  const [selectedBrandStoredId, setSelectedBrandStoredId] = useState<string | null>(null);
  const [selectedStoreName, setSelectedStoreName] = useState<string>("");
  const [isModalOpen, setIsModalOpen] = useState(false);

  const tableData: RowData[] = useMemo(() => {
    const qas = notice.noticeBrandStoresQas ?? [];

    const grouped: Record<string, RowData> = {};

    qas.forEach((qa) => {
      const store = qa.brandStore;
      if (!grouped[store.id]) {
        grouped[store.id] = {
          brandStoreId: store.id,
          brandStoreCode: store.code,
          brandStoreName: store.name,
          latestCommentDate: qa.qCreatedAt,
          totalComments: 1,
          unansweredCount: qa.isAnswered ? 0 : 1,
        };
      } else {
        grouped[store.id].totalComments += 1;
        if (!qa.isAnswered) {
          grouped[store.id].unansweredCount += 1;
        }
        if (new Date(qa.qCreatedAt) > new Date(grouped[store.id].latestCommentDate)) {
          grouped[store.id].latestCommentDate = qa.qCreatedAt;
        }
      }
    });

    return Object.values(grouped).sort((a, b) => {
      if (b.unansweredCount !== a.unansweredCount) {
        return b.unansweredCount - a.unansweredCount; // 1순위: 미답변 많은 순
      }
      return new Date(b.latestCommentDate).getTime() - new Date(a.latestCommentDate).getTime(); // 2순위: 최신순
    });
  }, [notice.noticeBrandStoresQas]);

  const columns: ColumnsType<RowData> = [
    {
      title: columnNameConstant.brandStore.BRAND_STORE_CODE,
      width: 80,
      key: "brandStoreCode",
      align: "center",
      render: (_, record) => record.brandStoreCode,
    },
    {
      title: columnNameConstant.brandStore.BRAND_STORE_NAME,
      width: 100,
      key: "brandStoreName",
      align: "center",
      render: (_, record) => record.brandStoreName,
    },
    {
      title: columnNameConstant.notice.LAST_COMMENT_CREATE_DATE,
      width: 120,
      key: "latestCommentDate",
      align: "center",
      render: (_, record) => getDateByFormat(record.latestCommentDate, onlyDateFormat),
    },
    {
      title: columnNameConstant.notice.COMMENT_COUNT_NOT_ANSWERED,
      width: 120,
      key: "totalComments",
      align: "center",
      render: (_, record) => `${record.totalComments} (${record.unansweredCount})`,
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const handleRowClick = (record: RowData) => {
    setSelectedBrandStoredId(record.brandStoreId);
    setSelectedStoreName(record.brandStoreName);
    setIsModalOpen(true);
  };
  const handleCloseModal = () => {
    setIsModalOpen(false);
    setSelectedBrandStoredId(null);
    setSelectedStoreName("");
  };

  const selectedBrandStoreQAs = useMemo(
    () => notice.noticeBrandStoresQas?.filter((qa) => qa.brandStore.id === selectedBrandStoredId) ?? [],
    [notice.noticeBrandStoresQas, selectedBrandStoredId]
  );

  return (
    <>
      <Card
        title={<Typography.Title level={5}>매장별 댓글</Typography.Title>}
        bodyStyle={{ padding: 0 }}
        style={{ marginTop: 24 }}
      >
        <Table
          {...commonTableProps}
          dataSource={tableData}
          columns={columns}
          rowKey="brandStoreId"
          pagination={false}
          scroll={{ x: tableWidthSum, y: 400 }}
          onRow={(record) => ({
            onClick: () => handleRowClick(record),
          })}
          rowClassName={(record: RowData) => {
            if (record.brandStoreId === selectedBrandStoredId) {
              return getTableRowClassName(["ant-table-row-selected"]);
            }
            return getTableRowClassName(["ant-table-row-link"]);
          }}
        />
      </Card>
      <NoticeCommentModal
        open={isModalOpen}
        onClose={handleCloseModal}
        brandStoreName={selectedStoreName}
        comments={selectedBrandStoreQAs}
      />
    </>
  );
};

export default NoticeFromHqCommentByStore;
</file>

<file path="src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqDetailsPage.tsx">
import useUser from "@hooks/useUser";
import { NoticeFromHqInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import AppHeader from "@src/app/components/AppHeader";
import Grid from "@src/app/components/Grid";
import { NoticeFromHqDetails_notice } from "@src/app/views/notice/notices/api/types/NoticeFromHqDetails";
import NoticeFromHqCommentByStore from "@src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqCommentByStore";
import NoticeFromHqNotificationSend from "@src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqNotificationSend";
import NoticeFromHqStoresAssignUnassign from "@src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqStoresAssignUnassign";
import { utils } from "@utils/utils";
import { Form, PageHeader, Segmented, Space } from "antd";
import React, { useEffect, useState } from "react";

import { NoticeFromHqDetailsEditModeEnum } from "../../views/NoticeFromHqDetailsView";
import { NoticeFromHqBasicInfo } from "../NoticeFromHqBasicInfo";

interface NoticeFromHqDetailsPageProps {
  notice: NoticeFromHqDetails_notice;
  editMode: NoticeFromHqDetailsEditModeEnum;
  onEdit: (mode: NoticeFromHqDetailsEditModeEnum) => void;
  onEditCancel: () => void;
  onBack: () => void;
  onUpdate: (formData: NoticeFromHqInput) => void;
}

type NoticeFromHqDetailsTab = "기본 정보" | "알림 발송";
const tabOptions: NoticeFromHqDetailsTab[] = ["기본 정보", "알림 발송"];

const NoticeFromHqDetailsPage: React.FC<NoticeFromHqDetailsPageProps> = (props) => {
  const { notice, editMode, onEdit, onEditCancel, onBack, onUpdate } = props;
  if (!notice) {
    return <></>;
  }

  const brand = notice.ownerBrand;
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;

  const pageTitle = isHqStaff || utils.isEmpty(brand) ? "공지사항" : `${brand.name} 공지사항`;
  const appHeaderTitle = `${pageTitle} 관리`;
  const [activeTab, setActiveTab] = useState<NoticeFromHqDetailsTab>("기본 정보");

  const [form] = Form.useForm<NoticeFromHqInput>();
  const TypeSafeForm = getTypeSafeForm<NoticeFromHqInput>(form);

  const availableToAllBrandStoresWatched = TypeSafeForm.getUseFormWatched({ name: "availableToAllBrandStores" });
  const showAssignUnassignUi = editMode ? !availableToAllBrandStoresWatched : !notice.availableToAllBrandStores;

  const initialValues: NoticeFromHqInput = {
    title: notice.title,
    content: notice.content,
    isFixed: notice.isFixed,
    availableToAllBrandStores: notice.availableToAllBrandStores,
    ownerBrand: brand.id,
  };

  useEffect(() => {
    form.resetFields();
  }, [editMode, activeTab]);

  return (
    <>
      <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
      <PageHeader title={pageTitle} />

      <Grid>
        <Space direction="vertical" size="large">
          <Space direction="vertical" size={0}>
            <Segmented
              block
              options={tabOptions}
              value={activeTab}
              onChange={(val) => {
                setActiveTab(val as NoticeFromHqDetailsTab);
                onEditCancel();
              }}
              style={{ marginBottom: 16 }}
            />

            {activeTab === "기본 정보" && (
              <Form disabled={isStaff} form={form} initialValues={initialValues} layout="vertical" onFinish={onUpdate}>
                <NoticeFromHqBasicInfo
                  isCreate={false}
                  form={form}
                  notice={notice}
                  editModeProps={{
                    isEditMode: editMode === NoticeFromHqDetailsEditModeEnum.UpdateBasicInfo,
                    onEdit: () => onEdit(NoticeFromHqDetailsEditModeEnum.UpdateBasicInfo),
                    onCancel: onEditCancel,
                  }}
                />
              </Form>
            )}
            {activeTab === "알림 발송" && <NoticeFromHqNotificationSend notice={notice} />}
          </Space>
        </Space>

        <Space direction="vertical" size="large">
          {showAssignUnassignUi && <NoticeFromHqStoresAssignUnassign notice={notice} disabled={isStaff} />}
          <NoticeFromHqCommentByStore notice={notice} />
        </Space>
      </Grid>
    </>
  );
};

export default NoticeFromHqDetailsPage;
</file>

<file path="src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqNotificationSend.tsx">
import { BrandStoreStatusEnum, NoticeFromHqNotificationSendInput } from "@src/api/types/globalTypes";
import { useNoticeFromHqNotificationSendMutation } from "@src/app/views/notice/notices/api/mutations";
import {
  NoticeFromHqDetails_notice,
  NoticeFromHqDetails_notice_ownerBrand_brandStores,
} from "@src/app/views/notice/notices/api/types/NoticeFromHqDetails";
import { utils } from "@utils/utils";
import { Button, Card, Form, Radio, Space, Typography } from "antd";
import { uniq } from "lodash";
import React, { useCallback, useEffect, useMemo, useState } from "react";

interface NoticeFromHqNotificationSendProps {
  notice: NoticeFromHqDetails_notice;
}
type TargetType = "all" | "unread" | "unconfirmed";

const NoticeFromHqNotificationSend: React.FC<NoticeFromHqNotificationSendProps> = ({ notice }) => {
  const availablePaidNoticeCount = notice.ownerBrand?.availablePaidNoticeCount ?? 0;
  const [form] = Form.useForm<NoticeFromHqNotificationSendInput>();

  const runningBrandStores = useMemo(() => {
    const all = notice.ownerBrand?.brandStores?.filter(
      (bs) => bs.status !== BrandStoreStatusEnum.STOPPED
    ) as NoticeFromHqDetails_notice_ownerBrand_brandStores[];

    if (notice.availableToAllBrandStores) {
      return all;
    }
    // 선택 공개인 경우: noticeAvailableBrandStores 에 포함된 매장만 대상
    const allowedIds = new Set((notice.noticeAvailableBrandStores ?? []).map((nab) => nab.brandStore.id));
    return all.filter((bs) => allowedIds.has(bs.id));
  }, [notice]);

  const storeStatusList = useMemo(() => {
    const map = new Map((notice.noticeAvailableBrandStores ?? []).map((nab) => [nab.brandStore.id, nab]));
    return runningBrandStores.map((bs) => {
      const published = map.get(bs.id);
      return {
        brandStore: bs,
        isRead: published?.isRead ?? false,
        hasConfirmed: published?.hasConfirmed ?? false,
      };
    });
  }, [runningBrandStores, notice.noticeAvailableBrandStores]);

  const [target, setTarget] = useState<TargetType>("all");
  const [userIds, setUserIds] = useState<string[]>([]);

  /** target ➜ userIds 계산 */
  const computeUserIds = useCallback(
    (tgt: TargetType): string[] => {
      if (tgt === "all") {
        return uniq(storeStatusList.map((s) => s.brandStore.ownerUser?.id).filter(Boolean) as string[]);
      }
      if (tgt === "unread") {
        return uniq(
          storeStatusList
            .filter((s) => !s.isRead)
            .map((s) => s.brandStore.ownerUser?.id)
            .filter(Boolean) as string[]
        );
      }
      // "unconfirmed"
      return uniq(
        storeStatusList
          .filter((s) => !s.hasConfirmed)
          .map((s) => s.brandStore.ownerUser?.id)
          .filter(Boolean) as string[]
      );
    },
    [storeStatusList]
  );

  /** target 또는 storeStatusList 가 변하면 userIds 재계산 */
  useEffect(() => {
    setUserIds(computeUserIds(target));
  }, [target, computeUserIds]);

  const receiverCount = userIds.length;
  const isKakaoDisabled = receiverCount > availablePaidNoticeCount;

  // disabled 시 sendKakao 값을 false 로 강제
  useEffect(() => {
    if (isKakaoDisabled) {
      form.setFieldsValue({ sendKakao: false });
    }
  }, [isKakaoDisabled, form]);

  const [sendNotification] = useNoticeFromHqNotificationSendMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeFromHqNotificationSend.errors, "성공적으로 발송되었습니다."),
  });

  const handleFinish = async (values: NoticeFromHqNotificationSendInput) => {
    await sendNotification({
      variables: {
        id: notice.id,
        input: { ...values, users: userIds },
      },
    });
  };

  return (
    <Card
      title={
        <>
          <Typography.Title level={5} style={{ marginBottom: 0, display: "inline-block", marginRight: 8 }}>
            알림&nbsp;발송
          </Typography.Title>
          <Typography.Text type="secondary" style={{ fontSize: 12 }}>
            알림톡 잔여&nbsp;
            <Typography.Text strong>{availablePaidNoticeCount}</Typography.Text>건 (부족 시 담당&nbsp;MD에게 문의)
          </Typography.Text>
        </>
      }
    >
      <Space direction="vertical" size="middle" style={{ width: "100%" }}>
        {/* 발송 대상 */}
        <div>
          <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
            <Typography.Text>발송 대상</Typography.Text>
            <Typography.Text strong style={{ color: "#fa541c" }}>
              총&nbsp;{receiverCount}명
            </Typography.Text>
          </div>
          <Radio.Group
            value={target}
            onChange={(e) => setTarget(e.target.value as TargetType)}
            style={{ marginLeft: 4 }}
          >
            <Radio value="all">전체</Radio>
            <Radio value="unread">미열람</Radio>
            <Radio value="unconfirmed">미확인</Radio>
          </Radio.Group>
        </div>

        {/* 발송 방식 폼 */}
        <Form layout="vertical" form={form} onFinish={handleFinish} initialValues={{ sendPush: true, sendKakao: true }}>
          <Form.Item name="sendPush" label="푸시알림" rules={[{ required: true, message: "필수 항목입니다" }]}>
            <Radio.Group>
              <Radio value={true}>발송</Radio>
              <Radio value={false}>발송안함</Radio>
            </Radio.Group>
          </Form.Item>

          <Form.Item
            name="sendKakao"
            label="알림톡"
            rules={[{ required: true, message: "필수 항목입니다" }]}
            extra={
              isKakaoDisabled && (
                <Typography.Text type="danger" style={{ fontSize: 12 }}>
                  잔여 건수를 초과하여 알림톡은 발송할 수 없습니다.
                </Typography.Text>
              )
            }
          >
            <Radio.Group disabled={isKakaoDisabled}>
              <Radio value={true}>발송</Radio>
              <Radio value={false}>발송안함</Radio>
            </Radio.Group>
          </Form.Item>

          <Form.Item>
            <Button type="primary" htmlType="submit">
              발송하기
            </Button>
          </Form.Item>
        </Form>
      </Space>
    </Card>
  );
};

export default NoticeFromHqNotificationSend;
</file>

<file path="src/app/views/notice/notices/components/NoticeFromHqDetailsPage/NoticeFromHqStoresAssignUnassign.tsx">
import { commonTableProps, getTableClassName } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { brandStoreStatusChoices } from "@src/app/views/brand/brandStore/utils";
import {
  NoticeFromHqDetails_notice,
  NoticeFromHqDetails_notice_noticeAvailableBrandStores,
} from "@src/app/views/notice/notices/api/types/NoticeFromHqDetails";
import { StrictOmit } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Input, Space, Table } from "antd";
import { ColumnsType, TableProps } from "antd/lib/table";
import React, { useMemo, useState } from "react";

import { useNoticeBrandStoresAssignMutation, useNoticeBrandStoresUnassignMutation } from "../../api/mutations";

type NoticeAvailableBrandStoreForTable = StrictOmit<
  NoticeFromHqDetails_notice_noticeAvailableBrandStores,
  "__typename" | "id"
> & {
  id?: string; // 값이 있는 경우 공개라는 뜻임.
};
interface NoticeFromHqStoresAssignUnassignProps {
  notice: NoticeFromHqDetails_notice;
  disabled: boolean;
}
const NoticeFromHqStoresAssignUnassign: React.FC<NoticeFromHqStoresAssignUnassignProps> = (props) => {
  const { notice, disabled } = props;
  const brand = notice.ownerBrand;
  const [searchText, setSearchText] = useState("");
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([]);

  const [noticeBrandStoresAssign] = useNoticeBrandStoresAssignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeBrandStoresAssign.errors, "해당 매장들이 공개로 수정되었습니다."),
  });

  const [noticeBrandStoresUnassign] = useNoticeBrandStoresUnassignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeBrandStoresUnassign.errors, "해당 매장들이 비공개로 수정되었습니다."),
  });

  const publishedStoreIds = useMemo(
    () => new Set(notice.noticeAvailableBrandStores.map((s) => s.brandStore.id)),
    [notice.noticeAvailableBrandStores]
  );

  const BrandStoreListAll: NoticeAvailableBrandStoreForTable[] = useMemo(() => {
    const publishedStoreMap = new Map(notice.noticeAvailableBrandStores.map((s) => [s.brandStore.id, s]));

    const allStores = (brand?.brandStores || []).map((store) => {
      const publishedData = publishedStoreMap.get(store.id);

      return {
        id: publishedData?.id,
        isRead: publishedData?.isRead ?? false,
        readAt: publishedData?.readAt ?? null,
        hasConfirmed: publishedData?.hasConfirmed ?? false,
        confirmedAt: publishedData?.confirmedAt ?? null,
        brandStore: store,
      };
    });

    return allStores.sort((a, b) => {
      const aPublished = !!a.id;
      const bPublished = !!b.id;
      return aPublished === bPublished ? 0 : aPublished ? -1 : 1;
    });
  }, [brand?.brandStores, notice.noticeAvailableBrandStores]);

  const filteredStores = useMemo(() => {
    if (!searchText) {
      return BrandStoreListAll;
    }
    return BrandStoreListAll.filter((store) => {
      const name = store.brandStore.name.toLowerCase();
      const code = store.brandStore.code.toLowerCase();
      return name.includes(searchText.toLowerCase()) || code.includes(searchText.toLowerCase());
    });
  }, [searchText, BrandStoreListAll]);

  const rowSelection: TableProps<NoticeAvailableBrandStoreForTable>["rowSelection"] = {
    selectedRowKeys,
    onChange: (newSelectedKeys) => {
      const newSelectedKeySet = new Set(newSelectedKeys);

      const preservedKeys = selectedRowKeys.filter(
        (key) => !filteredStores.some((store) => store.brandStore.id === key) || newSelectedKeySet.has(key)
      );

      setSelectedRowKeys([...new Set([...preservedKeys, ...newSelectedKeys])]);
    },
    getCheckboxProps: (record) => {
      const firstType = BrandStoreListAll.find((r) => selectedRowKeys.includes(r.brandStore.id))?.id
        ? "published"
        : "unpublished";
      const thisType = record.id ? "published" : "unpublished";
      const lockType = selectedRowKeys.length > 0 && thisType !== firstType;
      return {
        disabled: lockType || disabled,
      };
    },
  };

  const columns: ColumnsType<NoticeAvailableBrandStoreForTable> = [
    {
      title: columnNameConstant.brandStore.BRAND_STORE_CODE,
      key: "role",
      align: "center",
      width: 100,
      render: (_, record) => record.brandStore.code,
    },
    {
      title: columnNameConstant.brandStore.BRAND_STORE_NAME,
      key: "name",
      align: "center",
      width: 100,
      render: (_, record) => record.brandStore.name,
    },
    {
      title: "상태",
      key: "status",
      align: "center",
      width: 60,
      render: (_, record) => utils.getLabelTextByValue(record.brandStore.status, brandStoreStatusChoices),
    },
    {
      title: "열람",
      key: "isRead",
      align: "center",
      width: 60,
      render: (_, record) => (record.isRead ? "O" : "X"),
    },
    {
      title: "확인",
      key: "hasConfirmed",
      align: "center",
      width: 60,
      render: (_, record) => (record.hasConfirmed ? "O" : "X"),
    },
  ];

  const handleAssign = () => {
    noticeBrandStoresAssign({
      variables: {
        noticeId: notice.id,
        brandStores: selectedRowKeys as string[],
      },
    });
    setSelectedRowKeys([]);
  };

  const handleUnassign = () => {
    noticeBrandStoresUnassign({
      variables: {
        noticeId: notice.id,
        brandStores: selectedRowKeys as string[],
      },
    });
    setSelectedRowKeys([]);
  };

  const isUnpublishedSelected =
    selectedRowKeys.length > 0 && !BrandStoreListAll.find((r) => r.brandStore.id === selectedRowKeys[0])?.id;
  const isPublishedSelected =
    selectedRowKeys.length > 0 && !!BrandStoreListAll.find((r) => r.brandStore.id === selectedRowKeys[0])?.id;

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <Card
        title={<CardTitleAntd title={"공개 매장 리스트"} />}
        bodyStyle={{ padding: 0 }}
        extra={
          <Space>
            <Button type="primary" onClick={handleAssign} disabled={!isUnpublishedSelected || disabled}>
              공개
            </Button>
            <Button danger onClick={handleUnassign} disabled={!isPublishedSelected || disabled}>
              비공개
            </Button>
          </Space>
        }
      >
        <Space direction="vertical" style={{ width: "100%" }}>
          <Input.Search
            placeholder="매장명 또는 코드 검색"
            allowClear
            enterButton
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
            style={{ marginBottom: 12 }}
          />

          <Table<NoticeAvailableBrandStoreForTable>
            {...commonTableProps}
            rowKey={(record) => record.brandStore.id}
            dataSource={filteredStores}
            columns={columns}
            rowSelection={rowSelection}
            scroll={{ x: tableWidthSum, y: 400 }}
            rowClassName={(record) =>
              publishedStoreIds.has(record.brandStore.id) ? "" : getTableClassName(["ant-table-unpublished-store-row"])
            }
          />
        </Space>
      </Card>
    </>
  );
};

export default NoticeFromHqStoresAssignUnassign;
</file>

