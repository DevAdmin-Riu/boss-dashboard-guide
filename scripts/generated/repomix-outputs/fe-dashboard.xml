<file path="src/app/views/purchase/purchaseOrders/view/PurchaseOrderLineListView/utils.ts">
import { PurchaseOrderLineStatusEnum } from "@src/api/types/globalTypes";

import { PoLineInventoryType, PoLineUrlStatusType, PurchaseOrderLineUrlEnum } from "../../urls";

// 발주 페이지 타입 (재고발주, 위탁발주, B2B발주)
export type PurchaseOrderPageType = PoLineInventoryType | "b2b";

const statusTransitionRules = {
  [PurchaseOrderLineStatusEnum.DRAFT]: null,
  [PurchaseOrderLineStatusEnum.PENDING]: [PurchaseOrderLineStatusEnum.DRAFT, PurchaseOrderLineStatusEnum.RECEIVED],
  [PurchaseOrderLineStatusEnum.REJECTED]: null,
  [PurchaseOrderLineStatusEnum.RECEIVED]: [
    PurchaseOrderLineStatusEnum.PENDING,
    PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
  ],
  [PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY]: null,
  [PurchaseOrderLineStatusEnum.REQ_EPD_UPDATE]: null,
  [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT]: [
    PurchaseOrderLineStatusEnum.RECEIVED,
    PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
  ],
  [PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED]: [
    PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
    PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
  ],
  [PurchaseOrderLineStatusEnum.INVOICE_PRINTED]: [
    PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
    PurchaseOrderLineStatusEnum.STOCKED,
  ],
  [PurchaseOrderLineStatusEnum.TO_BE_INSPECTED]: [PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED],
  [PurchaseOrderLineStatusEnum.INSPECTED]: [
    PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
    PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
  ],
  [PurchaseOrderLineStatusEnum.STOCKED]: null,
  [PurchaseOrderLineStatusEnum.DELIVERED]: null,
  [PurchaseOrderLineStatusEnum.CANCELED]: null,
};

export function createBeforeStatusList(afterStatusList: PurchaseOrderLineStatusEnum[]) {
  return afterStatusList.map((afterStatus) => {
    const beforeStatuses = statusTransitionRules[afterStatus];
    return beforeStatuses ? [beforeStatuses] : undefined;
  });
}

// 발주 타입별로 필요한 상태를 동적으로 필터링
const getStatusToAfterListMap = (pageType: PurchaseOrderPageType) => {
  const isTrackInventory = pageType === "track-inventory";

  return {
    [PurchaseOrderLineUrlEnum.PRINT_INVOICE]: [
      PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
      PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
    ].filter(Boolean),
    inspect: isTrackInventory
      ? [
          PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
          PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
          PurchaseOrderLineStatusEnum.INSPECTED,
        ]
      : [],
    [PurchaseOrderLineUrlEnum.ADD_STOCK]: isTrackInventory
      ? [
          PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
          PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
          PurchaseOrderLineStatusEnum.INSPECTED,
        ]
      : [],
    [PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY]: [
      PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
      PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
      PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
      isTrackInventory && PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
      isTrackInventory && PurchaseOrderLineStatusEnum.INSPECTED,
      PurchaseOrderLineStatusEnum.DELIVERED,
      isTrackInventory && PurchaseOrderLineStatusEnum.STOCKED,
    ].filter(Boolean),
    [PurchaseOrderLineUrlEnum.ALL]: [
      PurchaseOrderLineStatusEnum.CANCELED,
      PurchaseOrderLineStatusEnum.DELIVERED,
      PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
      PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
      PurchaseOrderLineStatusEnum.DRAFT,
      PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
      isTrackInventory && PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
      isTrackInventory && PurchaseOrderLineStatusEnum.INSPECTED,
      PurchaseOrderLineStatusEnum.PENDING,
      PurchaseOrderLineStatusEnum.RECEIVED,
      PurchaseOrderLineStatusEnum.REJECTED,
      PurchaseOrderLineStatusEnum.REQ_EPD_UPDATE,
      isTrackInventory && PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY,
      isTrackInventory && PurchaseOrderLineStatusEnum.STOCKED,
    ].filter(Boolean),
  };
};

export function getAfterStatusList({
  status,
  pageType,
}: {
  status: string;
  pageType: PurchaseOrderPageType;
}): PurchaseOrderLineStatusEnum[] {
  const statusToAfterListMap = getStatusToAfterListMap(pageType);
  return statusToAfterListMap[status] || [];
}

export const getRevertModalInfo = ({ status }: { status: PoLineUrlStatusType | ":status" }) => {
  switch (status) {
    case PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT:
      return {
        modalTitleText: "출고 거부 확인",
        titleText: "선택한 발주제품을 출고 거부 하시겠습니까?",
        helpText: "출고 거부 시 상태가 접수대기로 변경되며, 이후 수정/취소가 불가합니다.",
        beforeStatus: PurchaseOrderLineStatusEnum.RECEIVED,
        afterStatus: PurchaseOrderLineStatusEnum.PENDING,
        message: "출고 거부",
      };
    case PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY:
      return {
        modalTitleText: "출고 취소 확인",
        titleText: "선택한 발주제품의 출고를 취소 하시겠습니까?",
        helpText: "출고 취소 시 상태가 접수로 변경됩니다.",
        beforeStatus: PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
        afterStatus: PurchaseOrderLineStatusEnum.RECEIVED,
        message: "출고 취소",
      };
    case PurchaseOrderLineUrlEnum.PRINT_INVOICE:
      return {
        modalTitleText: "배송 취소 확인",
        titleText: "선택한 발주제품의 배송을 취소 하시겠습니까?",
        helpText: "배송 취소 시 상태가 출고지시로 변경됩니다.",
        beforeStatus: PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
        afterStatus: PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
        message: "배송 취소",
      };
    case PurchaseOrderLineUrlEnum.ADD_STOCK:
      return {
        modalTitleText: "검수 취소 확인",
        titleText: "선택한 발주제품의 검수를 취소 하시겠습니까?",
        helpText: "검수 취소 시 검수 대상 여부에 따라 상태가 변경됩니다.",
        beforeStatus: PurchaseOrderLineStatusEnum.INSPECTED,
        // afterStatus는 needToInspect에 따라 동적으로 결정됨
        afterStatus: null,
        message: "검수 취소",
        requiresSplit: true, // 분리 처리 필요
      };
    case PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY:
    case PurchaseOrderLineUrlEnum.INSPECT:
      return {
        modalTitleText: "거래명세서 취소 확인",
        titleText: "선택한 발주제품의 거래명세서를 취소 하시겠습니까?",
        helpText: "거래명세서 취소 시 상태가 배송확정으로 변경됩니다.",
        beforeStatus:
          PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY === status
            ? PurchaseOrderLineStatusEnum.INVOICE_PRINTED
            : PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
        afterStatus: PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
        message: "거래명세서 취소",
      };
    default:
      return null;
  }
};
</file>

<file path="src/app/views/purchase/purchaseOrders/view/PurchaseOrderDetailsView.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { SearchProductVariants_search_edges_node } from "@src/api/searches/types/SearchProductVariants";
import {
  PurchaseOrderLineBulkUpdateInput,
  PurchaseOrderLineUpdateInput,
  PurchaseOrderManageAddNoteInput,
  PurchaseOrderUpdateInput,
  SalesStatusEnum,
} from "@src/api/types/globalTypes";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { historyBack } from "@src/app/routes/Routes";
import {
  useProductVariantListForSearchQuery,
  useProductVariantListToAddLazyQuery,
} from "@src/app/views/product/products/api/queries";
import { ProductVariantListForSearchVariables } from "@src/app/views/product/products/api/types/ProductVariantListForSearch";
import { ProductToBeChangedInfoModal } from "@src/app/views/product/products/components/ProductToBeChangedInfoModal";
import { maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrorInfo, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import moment from "moment";
import React, { useState } from "react";

import {
  usePurchaseOrderLineBulkUpdateMutation,
  usePurchaseOrderLineDeleteMutation,
  usePurchaseOrderLinesAddMutation,
  usePurchaseOrderLineUpdateMutation,
  usePurchaseOrderManageAddNoteMutation,
  usePurchaseOrderUpdateMutation,
} from "../api/mutations";
import { purchaseOrderDetailsQuery, usePurchaseOrderDetailsQuery } from "../api/queries";
import {
  makePoLineRowToAdd,
  showProductVariantVendorsErrorMsg,
} from "../components/PurchaseOrderCreateLines/PurchaseOrderCreateLinesTableSettings";
import { EXTERNAL_WAREHOUSE_ID } from "../components/PurchaseOrderCreatePage/utils";
import { PurchaseOrderDetailsPage } from "../components/PurchaseOrderDetailsPage/PurchaseOrderDetailsPage";
import PurchaseOrderLineAddModal from "../components/PurchaseOrderLineAddModal/PurchaseOrderLineAddModal";
import { PurchaseOrderProductNoteQueryModal } from "../components/PurchaseOrderProductNoteQueryModal";
import PurchaseOrderSendEmailModal from "../components/PurchaseOrderSendEmailModal/PurchaseOrderSendEmailModal";

interface PurchaseOrderDetailsCreatedViewProps {
  id: string;
}

export enum PurchaseOrderModalModeEnum {
  AddProduct = "AddProduct",
  ConfirmForCreate = "ConfirmForCreate",
  QueryVariantNote = "QueryVariantNote",
  CheckToBeChangedInfo = "CheckToBeChangedInfo",
  EmailSend = "EmailSend",
}

export const PurchaseOrderDetailsView: React.FC<PurchaseOrderDetailsCreatedViewProps> = ({ id }) => {
  const [idForModal, setIdForModal] = useState<string>(null);
  const [modalMode, setModalMode] = useState<PurchaseOrderModalModeEnum>(null);
  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => {
    setIdForModal(idForModal);
    setModalMode(modalMode);
  };

  const { data, loading } = usePurchaseOrderDetailsQuery({
    variables: { id },
  });
  const purchaseOrder = maybe(() => data?.purchaseOrder, null);
  const purchaseOrderLines = maybe(() => purchaseOrder?.lines, []);
  const selectedPoLine = purchaseOrderLines.find((line) => line.id === idForModal);

  const initialQueryVariablesForSearch: ProductVariantListForSearchVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: {
      salesStatus: [SalesStatusEnum.ON_SALE, SalesStatusEnum.PENDING],
      trackInventory: true,
      isInner: false,
      isFulfilledByVendor: false,
    },
  };
  const {
    data: productVariantListForSearchData,
    loading: productVariantListForSearchLoading,
    refetch: productVariantListForSearchRefetch,
  } = useProductVariantListForSearchQuery({
    skip: modalMode !== PurchaseOrderModalModeEnum.AddProduct,
    variables: initialQueryVariablesForSearch,
  });
  const [productVariantListFetch] = useProductVariantListToAddLazyQuery();

  const [purchaseOrderUpdate, purchaseOrderUpdateOpts] = usePurchaseOrderUpdateMutation({});
  const [purchaseOrderLinesAdd, purchaseOrderLinesAddOpts] = usePurchaseOrderLinesAddMutation({
    refetchQueries: [purchaseOrderDetailsQuery],
  });
  const [purchaseOrderLineUpdate, purchaseOrderLineUpdateOpts] = usePurchaseOrderLineUpdateMutation({});

  const [purchaseOrderLineBulkUpdate, purchaseOrderLineBulkUpdateOpts] = usePurchaseOrderLineBulkUpdateMutation({});
  const [purchaseOrderLineDelete, purchaseOrderLineDeleteOpts] = usePurchaseOrderLineDeleteMutation({});
  const [purchaseOrderManageAddNote, purchaseOrderManageAddNoteOpts] = usePurchaseOrderManageAddNoteMutation({});

  const handleAdd = (productVariants: SearchProductVariants_search_edges_node[]) => {
    const selectedProductVariantIds = productVariants?.map((variant) => variant?.id);
    if (selectedProductVariantIds.length === 0) {
      showGqlErrorInfo("제품을 선택해주세요.");
      return;
    }

    productVariantListFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.default,
        filter: { ids: selectedProductVariantIds },
        includeStock: true,
      },
    }).then(async (res) => {
      const successProductVariantList = [];
      const failedProductVariantList = [];
      res.data.productVariants.edges.forEach((edge) => {
        const productVariant = edge?.node;
        const productVariantVendors = productVariant?.productVariantVendors;
        const hasVariantVendorInfo =
          productVariantVendors?.findIndex(
            (variantVendor) => variantVendor?.vendor?.id === purchaseOrder?.vendor?.id
          ) !== -1;
        if (!hasVariantVendorInfo) {
          const productVariantNameWithSku = `${productVariant?.product?.name}(${productVariant?.sku})`;
          failedProductVariantList.push(productVariantNameWithSku);
        } else {
          const defaultDeliveryDate = purchaseOrder?.purchaseOrderDate;
          const { variantId, askingPurchaseDate, quantity, costPriceExcludeVat, etcExcludeVat, note } =
            makePoLineRowToAdd(productVariant, purchaseOrder, defaultDeliveryDate);
          successProductVariantList.push({
            variantId,
            askingPurchaseDate,
            quantity,
            costPriceExcludeVat,
            etcExcludeVat,
            note,
          });
        }
      });

      if (failedProductVariantList.length > 0) {
        showProductVariantVendorsErrorMsg(failedProductVariantList);
      }
      if (successProductVariantList.length > 0) {
        const { data } = await purchaseOrderLinesAdd({ variables: { id, lines: successProductVariantList } });
        const errors = data?.purchaseOrderLinesAdd?.errors;
        if (errors?.length === 0) {
          showNotificationSuccess("발주제품이 추가되었습니다.");
        } else {
          showGqlErrors(errors);
        }
      }
    });
  };

  const handleUpdate = async (formData: PurchaseOrderUpdateInput) => {
    const isExternalWarehouse = formData.warehouseAddress === EXTERNAL_WAREHOUSE_ID;
    const input: PurchaseOrderUpdateInput = {
      ...formData,
      warehouse: isExternalWarehouse ? undefined : formData.warehouse,
      warehouseAddress: isExternalWarehouse ? undefined : formData.warehouseAddress,
    };

    const { data } = await purchaseOrderUpdate({ variables: { id, input } });
    const errors = data.purchaseOrderUpdate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("발주서 정보가 변경되었습니다.");
    } else {
      showGqlErrors(errors);
    }

    return errors;
  };

  const handleLineUpdate = async (lineId: string, input: PurchaseOrderLineUpdateInput) => {
    const { askingPurchaseDate, quantity } = input;
    if (purchaseOrder?.isB2b === false) {
      const isBeforePurchaseOrderDate = moment(askingPurchaseDate).isBefore(moment(purchaseOrder?.purchaseOrderDate));
      if (isBeforePurchaseOrderDate) {
        showNotificationError(
          "납품 요청일이 발주일보다 이전 일자로 선택된 발주제품이 존재합니다. 납품 요청일은 발주일 이후의 일자로 선택해주세요."
        );
        return;
      }
    }
    if (utils.isEmpty(quantity) || quantity < 0) {
      showNotificationError("모든 발주 제품의 발주 수량은 0 이상의 값을 입력해주어야 합니다.");
      return;
    }

    const { data } = await purchaseOrderLineUpdate({
      variables: { purchaseOrderId: id, lineId, input },
    });
    const errors = data.purchaseOrderLineUpdate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품 정보가 수정되었습니다.");
    } else {
      showGqlErrors(errors);
    }

    return errors?.length === 0;
  };

  const handleLineBulkUpdate = async (inputList: PurchaseOrderLineBulkUpdateInput[]) => {
    for (const input of inputList) {
      const { askingPurchaseDate, quantity } = input.input;
      if (purchaseOrder?.isB2b === false) {
        const isBeforePurchaseOrderDate = moment(askingPurchaseDate).isBefore(moment(purchaseOrder?.purchaseOrderDate));
        if (isBeforePurchaseOrderDate) {
          showNotificationError(
            `${input.id}(ID): 납품 요청일이 발주일보다 이전 일자입니다. 납품 요청일은 발주일 이후의 일자로 선택해주세요.`
          );
          return;
        }
      }
      if (utils.isEmpty(quantity) || quantity < 0) {
        showNotificationError(`${input.id}(ID): 발주 수량은 0 이상의 값을 입력해주어야 합니다.`);
        return;
      }
    }

    const { data } = await purchaseOrderLineBulkUpdate({
      variables: { purchaseOrderId: id, input: inputList },
    });
    const errors = data.purchaseOrderLineBulkUpdate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("발주제품 정보가 일괄 변경 되었습니다.");
    } else {
      showGqlErrors(errors, undefined, false);
    }
    return errors?.length === 0;
  };

  const handleLineDelete = async (lineId: string) => {
    const { data } = await purchaseOrderLineDelete({ variables: { id, lineId } });
    const errors = data.purchaseOrderLineDelete?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품이 삭제되었습니다.");
    } else {
      showGqlErrors(errors);
    }
  };

  const handleNoteAdd = async (input: PurchaseOrderManageAddNoteInput) => {
    const { data } = await purchaseOrderManageAddNote({ variables: { purchaseOrder: id, input } });
    const errors = data.purchaseOrderManageAddNote?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("발주서 관리 내역에 메모를 추가했습니다.");
    } else {
      showGqlErrors(errors);
    }
  };

  if (!purchaseOrder) {
    return <></>;
  }

  const productVariantIdList = purchaseOrder?.lines?.map((line) => line?.variant?.id);
  const pageLoading =
    loading ||
    purchaseOrderUpdateOpts.loading ||
    purchaseOrderManageAddNoteOpts.loading ||
    purchaseOrderLinesAddOpts.loading ||
    purchaseOrderLineUpdateOpts.loading ||
    purchaseOrderLineBulkUpdateOpts.loading ||
    purchaseOrderLineDeleteOpts.loading;

  return (
    <>
      <WindowTitle title={purchaseOrder?.code} />
      <PurchaseOrderDetailsPage
        purchaseOrderId={id}
        purchaseOrder={purchaseOrder}
        modalMode={modalMode}
        disabled={pageLoading}
        saveButtonBar={purchaseOrderUpdateOpts.status}
        openModalWithoutNavigate={openModalWithoutNavigate}
        onBack={historyBack}
        onUpdate={handleUpdate}
        onLineUpdate={handleLineUpdate}
        onLineBulkUpdate={handleLineBulkUpdate}
        onLineDelete={handleLineDelete}
        onNoteAdd={handleNoteAdd}
      />
      <PurchaseOrderLineAddModal
        open={modalMode === PurchaseOrderModalModeEnum.AddProduct}
        loading={productVariantListForSearchLoading || purchaseOrderLinesAddOpts.loading}
        initialQueryVariables={initialQueryVariablesForSearch}
        refetchProductVariants={productVariantListForSearchRefetch}
        onClose={resetForCloseModal}
        onSubmit={handleAdd}
        productVariants={maybe(() =>
          productVariantListForSearchData?.productVariants?.edges
            .map((edge) => edge.node)
            .filter(
              (suggestedProductVariant) =>
                !productVariantIdList.includes(suggestedProductVariant.id) &&
                !utils.isEmpty(suggestedProductVariant?.defaultVariantVendor)
            )
        )}
      />
      <PurchaseOrderProductNoteQueryModal
        open={modalMode === PurchaseOrderModalModeEnum.QueryVariantNote}
        purchaseOrderLine={selectedPoLine}
        onCancel={resetForCloseModal}
      />
      <ProductToBeChangedInfoModal
        open={modalMode === PurchaseOrderModalModeEnum.CheckToBeChangedInfo}
        productVariant={selectedPoLine?.variant}
        onClose={resetForCloseModal}
      />
      <PurchaseOrderSendEmailModal
        disabled={pageLoading}
        purchaseOrder={purchaseOrder}
        open={modalMode === PurchaseOrderModalModeEnum.EmailSend}
        onClose={resetForCloseModal}
      />
    </>
  );
};
</file>

