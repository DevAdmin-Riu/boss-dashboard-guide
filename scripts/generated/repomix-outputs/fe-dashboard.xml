import { NoticeFromHqCreateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import Grid from "@src/app/components/Grid";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import {
  BrandOnlySimpleStores_brand,
  BrandOnlySimpleStores_brand_brandStores,
} from "@src/app/views/brand/brands/api/types/BrandOnlySimpleStores";
import { brandStoreStatusChoices } from "@src/app/views/brand/brandStore/utils";
import { utils } from "@utils/utils";
import { Card, Form, FormInstance, Input, PageHeader, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useMemo, useState } from "react";

import { NoticeFromHqBasicInfo } from "../NoticeFromHqBasicInfo";

interface NoticeAvailableBrandStore {
  isRead: boolean;
  readAt: string | null;
  hasConfirmed: boolean;
  confirmedAt: string | null;
  brandStore: BrandOnlySimpleStores_brand_brandStores;
}

interface NoticeFromHqCreatePageProps {
  disabled: boolean;
  form: FormInstance<NoticeFromHqCreateInput>;
  brand: BrandOnlySimpleStores_brand;
  onBack: () => void;
}

const NoticeFromHqCreatePage: React.FC<NoticeFromHqCreatePageProps> = (props) => {
  const { disabled, form, brand, onBack } = props;
  const pageTitle = `${brand?.name} 공지사항`;
  const appHeaderTitle = `${pageTitle} 관리`;
  const [searchText, setSearchText] = useState<string>("");

  const brandStoreList: NoticeAvailableBrandStore[] = (brand?.brandStores || []).map((store) => ({
    isRead: false,
    readAt: null,
    hasConfirmed: false,
    confirmedAt: null,
    brandStore: store,
  }));

  const TypeSafeForm = getTypeSafeForm<NoticeFromHqCreateInput>(form);

  const availableToAllBrandStoresWatched = TypeSafeForm.getUseFormWatched({ name: "availableToAllBrandStores" });
  const brandStoreIdsWatched = TypeSafeForm.getUseFormWatched({ name: "brandStoreIds" }) || [];

  const filteredStores = useMemo(() => {
    if (!searchText) {
      return brandStoreList;
    }
    return brandStoreList.filter((store) => {
      const name = store.brandStore.name.toLowerCase();
      const code = store.brandStore.code.toLowerCase();
      return name.includes(searchText.toLowerCase()) || code.includes(searchText.toLowerCase());
    });
  }, [searchText, brandStoreList]);

  const columns: ColumnsType<NoticeAvailableBrandStore> = [
    {
      title: columnNameConstant.brandStore.BRAND_STORE_CODE,
      key: "role",
      align: "center",
      width: 100,
      render: (_, record) => record.brandStore.code,
    },
    {
      title: columnNameConstant.brandStore.BRAND_STORE_NAME,
      key: "name",
      align: "center",
      width: 100,
      render: (_, record) => record.brandStore.name,
    },
    {
      title: "상태",
      key: "status",
      align: "center",
      width: 60,
      render: (_, record) => utils.getLabelTextByValue(record.brandStore.status, brandStoreStatusChoices),
    },
    {
      title: "열람",
      key: "isRead",
      align: "center",
      width: 100,
      render: (_, _record) => "-",
    },
    {
      title: "확인",
      key: "hasConfirmed",
      align: "center",
      width: 100,
      render: (_, _record) => "-",
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<NoticeAvailableBrandStore> = {
    selectedRowKeys: brandStoreIdsWatched,
    onChange: (newSelectedKeys) => {
      const newSelectedKeySet = new Set(newSelectedKeys);
      // 기존 선택 값 중에서 현재 필터링 결과에 없거나 여전히 선택되어 있는 것만 유지
      const preservedKeys = brandStoreIdsWatched.filter(
        (key) => !filteredStores.some((store) => store.brandStore.id === key) || newSelectedKeySet.has(key)
      );
      const newBrandStoreIds = [...new Set([...preservedKeys, ...(newSelectedKeys as string[])])];
      TypeSafeForm.setFields([{ name: "brandStoreIds", value: newBrandStoreIds }]);
    },
  };

  return (
    <>
      <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
      <PageHeader title={pageTitle} />

      <Grid>
        <Space direction="vertical" size="large">
          <NoticeFromHqBasicInfo isCreate form={form} />
        </Space>

        <Space direction="vertical" size="large">
          {!availableToAllBrandStoresWatched && (
            <Card title={<Typography.Title level={4}>공개 매장 리스트</Typography.Title>} bodyStyle={{ padding: 0 }}>
              <Form.Item hidden name={TypeSafeForm.getValidDataIndex("brandStoreIds")}>
                <Input />
              </Form.Item>
              <Space direction="vertical" style={{ width: "100%" }}>
                <Input.Search
                  placeholder="매장명 또는 코드 검색"
                  allowClear
                  enterButton
                  value={searchText}
                  onChange={(e) => setSearchText(e.target.value)}
                  style={{ marginBottom: 12 }}
                />

                <Table<NoticeAvailableBrandStore>
                  {...commonTableProps}
                  rowKey={(record) => record.brandStore.id}
                  columns={columns}
                  dataSource={filteredStores}
                  scroll={{ x: tableWidthSum, y: 400 }}
                  rowSelection={rowSelection}
                />
              </Space>
            </Card>
          )}
        </Space>
      </Grid>

      <Form.Item noStyle shouldUpdate>
        {() => (
          <AntdSaveButtonBar
            disabled={!form.isFieldsTouched()}
            state={disabled ? "loading" : "default"}
            onCancel={onBack}
            onSave={form.submit}
          />
        )}
      </Form.Item>
    </>
  );
};

export default NoticeFromHqCreatePage;
</file>

