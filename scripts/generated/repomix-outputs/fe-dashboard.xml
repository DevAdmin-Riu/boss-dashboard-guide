      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        mobileAppInfo {
          ...MobileAppInfoFragment
        }
      }
    }
  }
`;
export const useMobileAppInfoCreate = makeMutation<MobileAppInfoCreate, MobileAppInfoCreateVariables>(
  mobileAppInfoCreate
);

const mobileAppInfoUpdate = gql`
  ${shopErrorFragment}
  ${mobileAppInfoFragment}
  mutation MobileAppInfoUpdate($input: MobileAppInfoInput!, $id: ID!) {
    mobileAppInfoUpdate(input: $input, id: $id) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      mobileAppInfo {
        ...MobileAppInfoFragment
      }
    }
  }
`;
export const useMobileAppInfoUpdate = makeMutation<MobileAppInfoUpdate, MobileAppInfoUpdateVariables>(
  mobileAppInfoUpdate
);

const mobileAppInfoDelete = gql`
  ${shopErrorFragment}
  mutation MobileAppInfoDelete($id: ID!) {
    mobileAppInfoDelete(id: $id) {
      errors: shopErrors {
        ...ShopErrorFragment
      }
      shop {
        mobileAppInfo {
          id
        }
      }
    }
  }
`;
export const useMobileAppInfoDelete = makeMutation<MobileAppInfoDelete, MobileAppInfoDeleteVariables>(
  mobileAppInfoDelete
);

const boxSpecForPickingOrderUpdate = gql`
  ${shopErrorFragment}
  ${boxSpecForPickingOrderFragment}
  mutation BoxSpecForPickingOrderUpdate($id: ID!, $input: BoxSpecForPickingOrderInput!) {
    boxSpecForPickingOrderUpdate(id: $id, input: $input) {
