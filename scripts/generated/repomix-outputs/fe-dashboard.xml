        }
        return name;
      },
    },
    {
      title: "goodsFLOW 코드",
      key: "codeGoodsflow",
      align: "center",
      width: 150,
      render: (_, record) => record.codeGoodsflow || "-",
    },
    {
      title: "sweet tracker 코드",
      key: "code",
      align: "center",
      width: 150,
      render: (_, record) => record.code || "-",
    },
    {
      title: "송장번호 자리수",
      key: "digitAllowedValues",
      align: "center",
      width: 130,
      render: (_, record) => (utils.isEmpty(record.digitAllowedValues) ? "-" : record.digitAllowedValues.join(",")),
