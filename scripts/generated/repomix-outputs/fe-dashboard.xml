import { ApolloQueryResult } from "@apollo/client";
import { commonMsg } from "@assets/messages/commonMsg";
import { FulfillmentStatus, OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { fileNameDateFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import {
  applyNumberCellFormat,
  cellToMergeKey,
  excelDownloadByWorkBook,
  toPriceExcludeVat,
} from "@utils/excel/excelDownload";
import { convertDeliveryTypeEnumToWord, transformAddress, transformPhoneNumber } from "@utils/misc";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import _ from "lodash";
import moment from "moment";
import * as xlsx from "xlsx-js-style";

import {
  DownloadOrderFulfillments,
  DownloadOrderFulfillments_order,
  DownloadOrderFulfillments_order_fulfillments,
  DownloadOrderFulfillments_order_fulfillments_lines,
} from "../../api/types/DownloadOrderFulfillments";
import {
  OrderDetails_order,
  OrderDetails_order_fulfillments,
  OrderDetails_order_lines,
} from "../../api/types/OrderDetails";
import { ExtendedOrderDetailsOrderLine } from "./OrderDetailsPage";

// 납품명세서 - 상품 외 납품 정보 칸에서 generateExpandedRowsAndMerges 적용될 컬럼 이름
const colNames = {
  orderNumber: "주문번호",
  orderFulfillmentNumber: "배송관리번호",
  orderCreated: "주문일",
  companyName: "상호",
  bizRegNo: "사업자등록번호",
  personInCharge: "담당자",
  deliveryVehicle: columnNameConstant.delivery.DELIVERY_VEHICLE_INFO,
  phone: "연락처",
  email: "이메일",
  recipient: "수령인",
  recipientPhone: "수령인 연락처",
  address: "주소",
};

// 입력된 rowArray에 mergeStart를 시작으로 하는, cellWidth만큼 넓어진 row와 mergeLocations를 생성
const generateExpandedRowsAndMerges = (
  mergeStart: [col: number, row: number],
  cellWidths: [titleCellWidth: number, valueCellWidth: number],
  rowArray: any[],
  isTitle: boolean = false,
  titleHeight: number = 4
) => {
  const titleValues = Object.values(colNames);
  const [titleCellWidth, valueCellWidth] = cellWidths;
  const cellWidth = titleCellWidth + valueCellWidth;
  const totalCellWidth = (cellWidth * rowArray.length) / 2;

  let colMergeStart: number;
  const mergeLocations = [];
  const [colStart, rowStart] = mergeStart;

  const defaultRow = Array(totalCellWidth).fill("");
  const row = defaultRow.map((_, idx) => {
    if (utils.isEmpty(rowArray)) {
      return "";
    }
    const q = Math.floor(idx / cellWidth);
    const r = idx % cellWidth;
    if (r === 0) {
      const title = rowArray[q * 2];
      return title;
    }
    if (r === titleCellWidth) {
      const value = rowArray[q * 2 + 1];
      return value;
    }
    return "";
  });

  if (!isTitle) {
    row.forEach((value, idx) => {
      if (idx === 0 || value !== "") {
        colMergeStart = idx;
        if (titleValues.includes(value)) {
          mergeLocations.push([
            colMergeStart + colStart,
            rowStart,
            colMergeStart + colStart + titleCellWidth - 1,
            rowStart,
          ]);
          colMergeStart = idx + titleCellWidth;
        }
      }

      if (colMergeStart < idx && (idx === totalCellWidth - 1 || row[idx + 1] !== "")) {
        mergeLocations.push([colMergeStart + colStart, rowStart, idx + colStart, rowStart]);
      }
    });
  } else {
    mergeLocations.push([colStart, rowStart, colStart + totalCellWidth - 1, rowStart + titleHeight - 1]);
  }

  return { row, mergeLocations };
};

// 납품명세서 - 상품 외 납품 정보 로우 및 머지 파싱
const parseOrderFulfillment = (
  order: DownloadOrderFulfillments_order,
  fulfillment: DownloadOrderFulfillments_order_fulfillments
) => {
  const { created, user, shippingAddress, totalGrossAmount, totalEtcDeliveryFee } = order;
  const { etcDeliveryManInfo } = fulfillment;
  const orderCreated = moment(created).format(onlyDateFormat);
  const orderComposedId = order.composedIdWithPrefix;
  const fulfillmentComposedId = fulfillment.composedIdWithPrefix;
  const totalProductAmount = totalGrossAmount - totalEtcDeliveryFee;

  const rows = [];
  const mergeLocations = [];

  const cellWidths: [col: number, row: number] = [2, 3];

  const titleData = [["납 품 명 세 서", ...Array(7).fill("")], Array(8).fill(""), Array(8).fill(""), Array(8).fill("")];
  for (let i = 0; i < titleData.length; i++) {
    const titleRowArray = titleData[i];
    const { row: titleRow, mergeLocations: titleMergeLocations } = generateExpandedRowsAndMerges(
      [0, i],
      cellWidths,
      titleRowArray,
      true
    );
    rows.push(titleRow);
    if (i === 0) {
      mergeLocations.push(...titleMergeLocations);
    }
  }

  const infoRowData = [
    [
      colNames.orderNumber,
      orderCreated,
      colNames.orderNumber,
      orderComposedId,
      colNames.orderFulfillmentNumber,
      fulfillmentComposedId,
      "",
      "",
    ],
    ["발송인", "", "", "", " 수령인 ", "", "", ""],
    [
      colNames.companyName,
      "주식회사 리우",
      colNames.bizRegNo,
      "257-81-01545",
      colNames.companyName,
      user?.bizRegCorpName || "-",
      colNames.bizRegNo,
      user?.bizRegNo || "-",
    ],
    [
      colNames.personInCharge,
      "임재욱",
      colNames.phone,
      null,
      colNames.personInCharge,
      user?.firstName || "-",
      colNames.phone,
      transformPhoneNumber(user?.aligoPhone) || "-",
    ],
    [colNames.email, "", "", "", colNames.email, user?.email || "-", "", ""],
    ["배송지", "", "", "", "기타배송 배차정보", "", "", ""],
    [
      colNames.recipient,
      shippingAddress?.firstName || "-",
      colNames.recipientPhone,
      transformPhoneNumber(shippingAddress?.phone) || "-",
      colNames.deliveryVehicle,
      etcDeliveryManInfo?.vehicle || "-",
      colNames.phone,
      etcDeliveryManInfo?.contact || "-",
    ],
    [colNames.address, transformAddress(shippingAddress), "", "", null, "", "", ""],
    ["추가 배송비", "", "", "", totalEtcDeliveryFee?.toLocaleString() || "-", "", "", ""],
    ["합계 상품금액(부가세 포함)", "", "", "", totalProductAmount?.toLocaleString() || "-", "", "", ""],
    ["상품 정보", "", "", "", "", "", "", ""],
  ];

  for (let i = 0; i < infoRowData.length; i++) {
    const infoRowArray = infoRowData[i];
    const { row, mergeLocations: rowMergeLocations } = generateExpandedRowsAndMerges(
      [0, i + titleData.length],
      cellWidths,
      infoRowArray
    );
    rows.push(row);
    mergeLocations.push(...rowMergeLocations);
  }

  return { rows, mergeLocations };
};

// 납품명세서 - 상품 로우 파싱(머지는 상품 정보 상단의 납품 정보 파싱 후에 진행)
const parseFullfillmentLine = (
  order: DownloadOrderFulfillments_order,
  fulfillment: DownloadOrderFulfillments_order_fulfillments,
  fulfillmentLine: DownloadOrderFulfillments_order_fulfillments_lines
) => {
  const { deliveryMethod } = fulfillment;
  const { orderLine } = fulfillmentLine;
  const { productSku, productName, variant, orderedOrFulfillQty, unitPriceGrossAmount, isTaxFree } = orderLine;
  const product = variant?.product;
  const hasVariants = product?.productType?.hasVariants;
  const targetAttributes = hasVariants ? variant?.attributes : product?.attributes;
  const productSpecText = makeProductSpecTextFromAttr(targetAttributes);
  const totalPrice = orderedOrFulfillQty * unitPriceGrossAmount;
  const totalPriceExcludeVat = toPriceExcludeVat(totalPrice, isTaxFree);
  const totalTax = totalPrice - totalPriceExcludeVat;
  const cellToMergeKeyArr = Array(10)
    .fill(cellToMergeKey)
    .map((key, idx) => `${key}-${idx}`);

  const row = {
    상세주문번호: orderLine.composedIdWithPrefix,
    [cellToMergeKeyArr[0]]: "",
    제품코드: productSku || "-",
    [cellToMergeKeyArr[1]]: "",
    상품명: productName || "-",
    [cellToMergeKeyArr[2]]: "",
    규격: productSpecText || "-",
    [cellToMergeKeyArr[3]]: "",
    [cellToMergeKeyArr[4]]: "",
    배송방식: convertDeliveryTypeEnumToWord(deliveryMethod),
    [cellToMergeKeyArr[5]]: "",
    수량: orderedOrFulfillQty?.toLocaleString() || "-",
    [cellToMergeKeyArr[6]]: "",
    단가: unitPriceGrossAmount?.toLocaleString() || "-",
    [cellToMergeKeyArr[7]]: "",
    공급가액: totalPriceExcludeVat?.toLocaleString() || "-",
    [cellToMergeKeyArr[8]]: "",
    세액: totalTax?.toLocaleString() || "-",
    [cellToMergeKeyArr[9]]: "",
  };
  return row;
};

export const downloadOrderFulfillment = (resOrderFulfillments: ApolloQueryResult<DownloadOrderFulfillments>) => {
  const order = resOrderFulfillments.data?.order;
  const { fulfillments } = order;
  if (!fulfillments || fulfillments.length <= 0) {
    showNotificationWarn("출고된 상품이 존재하지 않아 납품명세서를 생성할 수 없습니다.");
    return;
  }

  const orderComposedId = order.composedIdWithPrefix;
  const xlsxFileName = `납품명세서(${orderComposedId})-${moment().format(fileNameDateFormat)}.xlsx`;
  const wb = xlsx.utils.book_new();

  fulfillments.forEach((fulfillment) => {
    const mergeLocations = [];
    const fulfillmentLines = [...fulfillment?.lines];
    const fulfillmentLineRows = fulfillmentLines
      ?.sort((a, b) => a?.orderLine?.subId - b?.orderLine?.subId)
      ?.map((fulfillmentLine, idx) => {
        const fulfillmentLineRow = parseFullfillmentLine(order, fulfillment, fulfillmentLine);
        return { No: idx + 1, ...fulfillmentLineRow };
      });

    const fulfillmentComposedId = fulfillment.composedIdWithPrefix;
    if (!fulfillmentLineRows || fulfillmentLineRows.length <= 0) {
      showNotificationWarn(`${fulfillmentComposedId} 배송건에 출력할 출고 상품 데이터가 없습니다.`);
      return;
    }

    const { rows: infoRows, mergeLocations: infoMergeLocations } = parseOrderFulfillment(order, fulfillment);
    mergeLocations.push(...infoMergeLocations);

    for (let i = 0; i < fulfillmentLineRows.length + 1; i++) {
      let colMergeStart: number = 0;
      let colMergeEnd: number = 0;
      const rowNumber = infoRows.length + i;
      const fulfillmentLineKeys = Object.keys(fulfillmentLineRows[0]);
      fulfillmentLineKeys.forEach((key, idx) => {
        const isCellToMergeKey = key.startsWith(cellToMergeKey);
        if (isCellToMergeKey === false) {
          colMergeStart = idx;
        } else {
          colMergeEnd = idx;
          if (
            idx + 1 === fulfillmentLineKeys.length ||
            fulfillmentLineKeys[idx + 1].startsWith(cellToMergeKey) === false
          ) {
            const lineAttrMergeLocation = [colMergeStart, rowNumber, colMergeEnd, rowNumber];
            mergeLocations.push(lineAttrMergeLocation);
          }
        }
      });
    }

    const ws = xlsx.utils.aoa_to_sheet(infoRows, {});
    xlsx.utils.sheet_add_json(ws, fulfillmentLineRows, { origin: -1 });

    const merges = mergeLocations.map((location) => {
      const [startCol, startRow, endCol, endRow] = location;
      return {
        s: { r: startRow, c: startCol },
        e: { r: endRow, c: endCol },
      };
    });
    if (merges && merges.length > 0) {
      ws["!merges"] = merges;
    }

    // ws에 추가된 셀에 대해 각각 스타일 적용. 최상단 발주구분 영역은 다른 font 스타일 적용
    const valuesToFill = [
      colNames.orderNumber,
      colNames.orderFulfillmentNumber,
      colNames.orderCreated,
      "발송인",
      " 수령인 ",
      "배송지",
      "추가 배송비",
      "합계 상품금액(부가세 포함)",
      "상품 정보",
    ];
    const valuesToBold = [...valuesToFill, ...Object.values(colNames)];
    const rowNumbersToFill = [6, 10, infoRows.length, infoRows.length + 1];
    const rowNumbersToBold = [5, ...rowNumbersToFill];
    for (const i in ws) {
      if (typeof ws[i] != "object") {
        continue;
      }
      const cellValue = ws[i].v;
      const matchedNumberArr = i.match(/\d+/);
      const rowNumber = !utils.isEmpty(matchedNumberArr) && parseInt(matchedNumberArr[0], 10);

      applyNumberCellFormat(ws[i]);

      const alignLeft =
        !valuesToBold.includes(cellValue) &&
        !rowNumbersToBold.includes(rowNumber) &&
        rowNumber > 4 &&
        rowNumber < infoRows.length;

      ws[i].s = {
        font: {
          name: "맑은 고딕",
          sz: i === "A1" ? 16 : 8,
          bold: i === "A1" || rowNumbersToBold.includes(rowNumber) || valuesToBold.includes(cellValue),
        },
        fill: {
          fgColor: {
            rgb: rowNumbersToFill.includes(rowNumber) || valuesToFill.includes(cellValue) ? "C0C0C0" : "FFFFFF",
          },
        },
        alignment: {
          vertical: "center",
          horizontal: alignLeft ? "left" : "center",
          wrapText: true,
        },
        border: {
          right: {
            style: "thin",
            color: "000000",
          },
          left: {
            style: "thin",
            color: "000000",
          },
          bottom: {
            style: "thin",
            color: "000000",
          },
          top: {
            style: "thin",
            color: "000000",
          },
        },
      };
    }

    xlsx.utils.book_append_sheet(wb, ws, fulfillmentComposedId);
  });

  excelDownloadByWorkBook({ workBook: wb, title: xlsxFileName });
  showNotificationSuccess(commonMsg.downloadedToXls);
};

/**
 * @description 택배 배송 "배송 대기" 상태 체크
 * @param fulfillment OrderDetails_order_fulfillments
 * @returns boolean
 */
const checkBeforeDeliveryByCourier = (fulfillment: OrderDetails_order_fulfillments) =>
  fulfillment.status === FulfillmentStatus.FULFILLED &&
  fulfillment.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER &&
  utils.isEmpty(fulfillment.trackingNumber, true);

/**
 * @description 화물차 배송 "배송 대기" 상태 체크
 * @param fulfillment OrderDetails_order_fulfillments
 * @returns boolean
 */
const checkBeforeDeliveryByTruckService = (fulfillment: OrderDetails_order_fulfillments) =>
  fulfillment.status === FulfillmentStatus.FULFILLED &&
  fulfillment.deliveryMethod === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE &&
  utils.isEmpty(fulfillment.etcDeliveryManInfo);

/**
 * @description 택배로 배송되는 주문의 출고 후 송장번호가 지정되기 전 여부를 확인하여 해당 출고건을 반환
 * @param fulfillments OrderDetails_order_fulfillments[]
 * @returns OrderDetails_order_fulfillments[]
 */
export const getBeforeDeliveryFulfillments: (
  fulfillments: OrderDetails_order_fulfillments[]
) => OrderDetails_order_fulfillments[] = (fulfillments) =>
  fulfillments?.filter(
    (fulfillment: OrderDetails_order_fulfillments) =>
      checkBeforeDeliveryByCourier(fulfillment) || checkBeforeDeliveryByTruckService(fulfillment)
  ) || [];

/**
 * @description 배송 준비중의 fulfillment 리스트를 가져와 각 orderLineId: quantity 처럼 key: value를 만듬
 * @param beforeDeliveryFulfillments OrderDetails_order_fulfillments[]
 * @returns Record<string, number>
 */
export const getPreparingFulfillmentQuantities: (
  beforeDeliveryFulfillments: OrderDetails_order_fulfillments[]
) => Record<string, number> = (beforeDeliveryFulfillments) =>
  beforeDeliveryFulfillments.reduce((acc: Record<string, number>, fulfillment: OrderDetails_order_fulfillments) => {
    fulfillment.lines.forEach((line) => {
      const orderLineId = line.orderLine.id;
      if (orderLineId) {
        acc[orderLineId] = (acc[orderLineId] || 0) + line.quantity;
      }
    });
    return acc;
  }, {});

/**
 * 조건에 따라 배송 대기 상태의 주문을 return
 *
 * @param cur - 현재 주문 라인 데이터.
 * @param orderLineId - 주문 라인의 ID.
 * @returns 처리된 주문 라인 데이터 또는 null.
 */
const calculateDeliveryWaitingLine = (
  cur: ExtendedOrderDetailsOrderLine,
  orderLineId: string
): ExtendedOrderDetailsOrderLine => {
  const unFulfilledQuantity: number = cur.orderedOrFulfillQty - cur.quantityFulfilled - cur.quantityRefunded;
  // 미출고 수량이 0 이하이거나 이미 배송준비중(fulfillment에 포함)인 경우 배송대기에서 제외
  if (unFulfilledQuantity <= 0 || orderLineId !== null) {
    return null;
  }
  return cur;
};

/**
 * 조건에 따라 배송 준비중 상태의 주문 라인을 계산
 *
 * @param cur - 현재 주문 라인 데이터.
 * @param orderLineId - 주문 라인의 ID.
 * @returns 처리된 주문 라인 데이터 또는 null.
 */
const calculatePendingDeliveryLine = (
  cur: ExtendedOrderDetailsOrderLine,
  orderLineId: string
): ExtendedOrderDetailsOrderLine => {
  if (orderLineId !== null) {
    return cur;
  }
  return null;
};

/**
 * @param copiedOrderLines - deep copy orderLines 데이터
 * @param fulfilledOrderLineQuantities - orderLineId 별 주문 라인 수량
 * @returns unfulfilledOrderLines - 미출고 주문 라인 데이터 커링 함수 isDeliveryPending "배송준비중" , "배송대기"에 맞는 조건으로 함수 실행 필요
 */
export const getUnfulfilledOrderLines =
  (copiedOrderLines: ExtendedOrderDetailsOrderLine[], fulfilledOrderLineQuantities: Record<string, number>) =>
  (isDeliveryPending = false) =>
    copiedOrderLines.reduce<ExtendedOrderDetailsOrderLine[]>((acc, cur) => {
      const findLine = Object.entries(fulfilledOrderLineQuantities).find(([orderLineId]) => orderLineId === cur.id);
      const [orderLineId] = findLine || [null, 0];
      let newLine: ExtendedOrderDetailsOrderLine = null;
      // orderLine에서 수량 계산하는 로직이 있는 부분
      if (isDeliveryPending) {
        // "배송 준비중" case
        newLine = { ...calculatePendingDeliveryLine(cur, orderLineId), isFulfilled: true };
      } else {
        // "배송 대기" case
        newLine = { ...calculateDeliveryWaitingLine(cur, orderLineId), isFulfilled: false };
      }
      if (newLine) {
        acc.push(newLine);
      }
      return acc;
    }, []);

/**
 * Fulfillment 데이터를 기반으로 필요한 정보를 처리하여 반환
 *
 * @param order - 주문 데이터 객체.
 * @returns Fulfillment 및 Order Line 데이터 처리 결과.
 */
export const processFulfillmentData = (order: OrderDetails_order) => {
  const copiedOrderLines: OrderDetails_order_lines[] = order?.lines ? _.cloneDeep(order.lines) : [];
  const beforeDeliveryFulfillments: OrderDetails_order_fulfillments[] = getBeforeDeliveryFulfillments(
    order?.fulfillments
  );
  const fulfilledOrderLineQuantities: Record<string, number> =
    getPreparingFulfillmentQuantities(beforeDeliveryFulfillments);
  return {
    copiedOrderLines,
    fulfilledOrderLineQuantities,
  };
};
</file>

