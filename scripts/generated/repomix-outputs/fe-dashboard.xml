<file path="src/app/views/order/orders/components/CreateAdminOrderProductListModal/utils.ts">
import { BpBundles_bpBundles_edges_node } from "@src/app/views/brand/brands/api/types/BpBundles";
import { BrandProductPackages_brandProductPackages_edges_node } from "@src/app/views/brand/brands/api/types/BrandProductPackages";
import { CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node } from "@src/app/views/brand/brands/api/types/CreateAdminAtBrandProductListWithOnlyNonStoppedVariants";
import { CreateAdminAtProductVariantList_productVariants_edges_node } from "@src/app/views/product/products/api/types/CreateAdminAtProductVariantList";
import { FormInstance } from "antd";
import _ from "lodash";

import {
  CreateAdminOrderForm,
  CreateAdminProductVariantEdgesNode,
  ICreateAdminOrderFormLine,
} from "../../views/CreateAdminOrderView/CreateAdminOrderView";
import { getBrandProductVariantObj } from "../CreateAdminOrderBrandProductListTable/utils";
import { getProductVariantObj } from "../CreateAdminOrderProductListTable/utils";
import { ExtendedBrandProductVariantsNode } from "./CreateAdminOrderProductListModal";

export const brandProductListProcessingData = (
  searchProductVariantList: CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node[]
): ExtendedBrandProductVariantsNode[] => {
  const brandProductFilterList: CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node[] =
    searchProductVariantList.filter(
      (node: CreateAdminAtBrandProductListWithOnlyNonStoppedVariants_brandProducts_edges_node) => {
        if (node.brandProductVariants.length === 0) {
          return false;
        }
        return node;
      }
    ) as ExtendedBrandProductVariantsNode[];

  const brandProductVariantList: ExtendedBrandProductVariantsNode[] = _.cloneDeep(brandProductFilterList).reduce(
    (acc, cur) => {
      cur.brandProductVariants.map((variant, index) => {
        if (variant.productVariant.isInner === false) {
          const newObj = {
            ...cur,
            name: cur.name,
            brandProductVariant: cur.brandProductVariants[index],
            brandProductVariantRegion: cur.brandProductVariants[index].brandProductVariantRegions[0],
            id: cur.brandProductVariants[index].id,
          };
          acc.push(newObj);
        }
      });

      return acc;
    },
    []
  );
  return brandProductVariantList;
};

// Bundle을 BrandProduct 형태로 변환 (main 구성품 데이터 사용)
export const transformBundleToBrandProduct = (
  bundle: BpBundles_bpBundles_edges_node
): ExtendedBrandProductVariantsNode | null => {
  // 대표 구성품 찾기
  const mainComponent = bundle.bpBundleInfos?.find((info) => info?.isMain);

  if (!mainComponent || !mainComponent.pv) {
    return null;
  }

  const mainPv = mainComponent.pv;

  // 구성품 qty 합계 계산
  const bundleComponentQtySum = bundle.bpBundleInfos?.reduce((sum, info) => sum + (info?.quantity || 0), 0) || 0;

  // BrandProduct 형태로 변환 (main 구성품의 데이터를 기반으로)
  const transformedBundle: any = {
    id: bundle.id, // bundle의 id 사용
    name: bundle.name, // bundle 이름 사용
    product: mainPv.product, // main 구성품의 product 정보
    brandProductVariants: [], // 빈 배열로 초기화 (아래에서 채움)
    brandProductVariant: {
      id: bundle.id, // bundle id를 brandProductVariant id로 사용
      bpSku: bundle.bpSku, // bundle의 bpSku
      variantId: mainPv.id,
      salesStatus: bundle.salesStatus,
      priceAmount: bundle.priceAmount || 0,
      priceVat: bundle.priceVat || 0,
      needDeliveryAdditionalFee: bundle.needDeliveryAdditionalFee,
      includeSalesB2bDeliveryFee: false,
      forceNoNormalDisplay: bundle.forceNoNormalDisplay,
      productVariant: {
        ...mainPv,
        isInner: false, // bundle은 inner가 아님
        needDeliveryAdditionalFee: bundle.needDeliveryAdditionalFee, // bundle의 도서산간 설정 사용
      },
      brandProductVariantRegions: [],
    },
    brandProductVariantRegion: null,
    isBundle: true, // bundle 상품임을 표시
    bundleComponentQtySum, // 구성품 qty 합계
  };

  return transformedBundle as ExtendedBrandProductVariantsNode;
};

// Bundle 리스트를 BrandProduct 형태로 변환
export const bundleListProcessingData = (
  bundleList: BpBundles_bpBundles_edges_node[]
): ExtendedBrandProductVariantsNode[] => {
  if (!bundleList || bundleList.length === 0) {
    return [];
  }

  const transformedBundles = bundleList
    .map((bundle) => transformBundleToBrandProduct(bundle))
    .filter((item) => item !== null) as ExtendedBrandProductVariantsNode[];

  return transformedBundles;
};

interface IGetSelectProductList {
  form: FormInstance<CreateAdminOrderForm>;
  useBpvMode: boolean;
  productList: CreateAdminProductVariantEdgesNode[];
  packageList: BrandProductPackages_brandProductPackages_edges_node[];
  isByStaffForB2b: boolean;
  isByHqStaffForBrand: boolean;
}

export const getBrandPackageObj = (
  record: BrandProductPackages_brandProductPackages_edges_node
): ICreateAdminOrderFormLine => {
  const totalPrice = record.totalPriceWoEtcDeliveryFee || 0;

  return {
    id: record.id,
    sku: "-",
    bpSku: record.bpSku,
    isDefaultVariant: false,
    productName: "-",
    brandProductName: record.name,
    variantName: "패키지",
    attributes: "-",
    qtyPerBox: "-",
    trackInventory: false,
    isVendorTrackInventory: false,
    priceIncludeVat: totalPrice,
    priceExcludeVat: totalPrice,
    priceVat: 0,
    qty: 1,
    isTaxFree: false,
    pricePrecision: 0,
    orderQtyPrecision: 0,
    isDeferred: false,
    excludeStockAvgStats: false,
    moq: 1,
    noteForUnitPrice: "",
    needDeliveryAdditionalFee: false,
    includeSalesB2bDeliveryFee: false,
    isAdjustPrice: false,
    qtyPerDeliveryBox: 1,
    isPackage: true,
  };
};

export const makeProductVariantObj = (
  product: CreateAdminProductVariantEdgesNode | BrandProductPackages_brandProductPackages_edges_node,
  useBpvMode: boolean,
  isByStaffForB2b: boolean,
  isByHqStaffForBrand: boolean,
  isPackage: boolean = false
): ICreateAdminOrderFormLine =>
  isPackage
    ? getBrandPackageObj(product as BrandProductPackages_brandProductPackages_edges_node)
    : useBpvMode
    ? getBrandProductVariantObj(product as ExtendedBrandProductVariantsNode, isByStaffForB2b, isByHqStaffForBrand)
    : getProductVariantObj(product as CreateAdminAtProductVariantList_productVariants_edges_node);

export const getAfterSelectedProductVariantListFn = (props: IGetSelectProductList): ICreateAdminOrderFormLine[] => {
  const { form, useBpvMode, productList, packageList, isByStaffForB2b, isByHqStaffForBrand } = props;
  // 새로 선택된 상품들의 ids
  const selectedRowKeys = form.getFieldValue("selectedRowKeys") || [];

  // 일반 상품 처리
  const afterSelectedProductList: CreateAdminProductVariantEdgesNode[] = productList.filter((product) =>
    selectedRowKeys.includes(product.id)
  );
  const afterSelectedProductVariantList: ICreateAdminOrderFormLine[] = afterSelectedProductList.map((product) =>
    makeProductVariantObj(product, useBpvMode, isByStaffForB2b, isByHqStaffForBrand, false)
  );

  // 패키지 상품 처리
  const afterSelectedPackageList: BrandProductPackages_brandProductPackages_edges_node[] = packageList.filter((pkg) =>
    selectedRowKeys.includes(pkg.id)
  );
  const afterSelectedPackageVariantList: ICreateAdminOrderFormLine[] = afterSelectedPackageList.map((pkg) =>
    makeProductVariantObj(pkg, useBpvMode, isByStaffForB2b, isByHqStaffForBrand, true)
  );

  return [...afterSelectedProductVariantList, ...afterSelectedPackageVariantList];
};
