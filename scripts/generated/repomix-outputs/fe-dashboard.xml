} from "./filters";

interface OrderSalesListViewProps {
  params: OrderSalesListViewUrlQueryParams;
}

export const OrderSalesListView: React.FC<OrderSalesListViewProps> = ({ params }) => {
  const routeParams = useParams<OrderSalesListViewRouteParams>();
  const { user } = useAuth();
  const { isHqStaff, brand } = user;

  const targetUrl = (params?: OrderSalesListViewUrlQueryParams) => orderSalesListViewUrl(routeParams, params);

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.SALES_ORDER_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useSalesListFilterDownloadQuery);

  const filterVariables = getFilterVariables(params, routeParams);
  const queryVariables: SalesListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: { ...filterVariables, brandId: isHqStaff ? brand.id : undefined },
      sort: { direction: OrderDirection.DESC, field: SalesSortField.EVENTED_AT },
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useSalesListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.sales?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderSalesListViewUrlDialog, OrderSalesListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <WindowTitle title={isHqStaff ? sectionNames.hqSales : firstDepthMenuTitle.sales} />
      <OrderSalesListPage
        user={user}
        routeParams={routeParams}
        settings={settings}
        disabled={loading}
        sales={maybe(() => data.sales.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, routeParams)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        ordersForSalesRefetch={refetch}
        queryVariables={queryVariables}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
