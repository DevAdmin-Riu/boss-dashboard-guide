  },
  {
    label: "B2B 반품",
    value: PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK,
  },
];

export const takeBackPurchaseOrderEventTypeChoices = [
  {
    label: "재고 반품",
    value: PurchaseOrderEventType.TAKE_BACK,
  },
  {
    label: "위탁제품 반품",
    value: PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK,
  },
];

export const consignmentPurchaseOrderEventTypeChoices = [
  {
    label: "위탁발주",
    value: PurchaseOrderEventType.CONSIGNMENT,
  },
  {
    label: `${transformIsFBV(true)} 상품`,
    value: PurchaseType.FULFILLED_BY_VENDOR,
  },
];

export const getPurchaseOrderEventTypeText = (
  eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum,
  isB2b: boolean = false
) => {
  if (isB2b) {
    const choice = b2bPurchaseOrderEventTypeChoices.find((c) => c.value === eventType);
    if (choice) {
      return choice.label;
    }
  }
  {
    const choice = inventoryPurchaseOrderEventTypeChoices.find((c) => c.value === eventType);
    if (choice) {
      return choice.label;
    }
  }
  {
    const choice = takeBackPurchaseOrderEventTypeChoices.find((c) => c.value === eventType);
    if (choice) {
      return choice.label;
    }
  }
  {
    const choice = consignmentPurchaseOrderEventTypeChoices.find((c) => c.value === eventType);
    if (choice) {
      return choice.label;
    }
  }
  return "-";
};

export const makePurchaseOrderLineNumber = (
  purchaseOrderLine: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node, "sortOrder"> & {
    purchaseOrder: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node_purchaseOrder, "code">;
  }
) => `${purchaseOrderLine.purchaseOrder?.code}-${utils.fillZero(purchaseOrderLine?.sortOrder || 1, 3)}`;

export const makePurchaseOrderLineNumberWithPoAndLine = (
  purchaseOrder: Pick<PurchaseOrderDetails_purchaseOrder, "code">,
  purchaseOrderLine: Pick<PurchaseOrderDetails_purchaseOrder_lines, "sortOrder">
) => `${purchaseOrder?.code}-${utils.fillZero(purchaseOrderLine?.sortOrder || 1, 3)}`;

export const checkInitialOrderPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  eventType === PurchaseOrderEventType.INITIAL_ORDER;

export const checkReorderPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  eventType === PurchaseOrderEventType.REORDER;

export const checkTrackInventoryPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  checkInitialOrderPurchaseOrder(eventType) || checkReorderPurchaseOrder(eventType);

export const checkTakeBackPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  eventType === PurchaseOrderEventType.TAKE_BACK;

export const checkConsignmentPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  eventType === PurchaseOrderEventType.CONSIGNMENT;

export const checkConsignmentTakeBackPurchaseOrder = (eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum) =>
  eventType === PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK;

export const getCheckPurchaseOrderEventTypeResults = (
  eventType: PurchaseOrderEventType | PurchaseOrderEventTypeEnum
) => {
  const isInitialOrderPurchaseOrder = checkInitialOrderPurchaseOrder(eventType);
  const isTrackInventoryPurchaseOrder = checkTrackInventoryPurchaseOrder(eventType);
  const isTakeBackPurchaseOrder = checkTakeBackPurchaseOrder(eventType);
  const isConsignmentPurchaseOrder = checkConsignmentPurchaseOrder(eventType);
  const isConsignmentTakeBackPurchaseOrder = checkConsignmentTakeBackPurchaseOrder(eventType);
  return {
    isInitialOrderPurchaseOrder,
    isTrackInventoryPurchaseOrder,
    isTakeBackPurchaseOrder,
    isConsignmentPurchaseOrder,
    isConsignmentTakeBackPurchaseOrder,
  };
};

export const makePoLineQtyText = (
  poEventType: PurchaseOrderEventType,
  purchaseOrderLine: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node, "quantity"> & {
    variant: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node_variant, "salesUnitType">;
  }
) => {
  if (utils.isEmpty(purchaseOrderLine)) {
    return "-";
  }
  const { quantity, variant } = purchaseOrderLine;
  const value = multiplePoEventTypeTackBackValue(poEventType, quantity);
  const salesUnitTypeText = getSalesUnitTypeText(variant.salesUnitType);
  return `${getNumberFormat(value)}${salesUnitTypeText}`;
};

export const makePoLineExpectedPurchaseQtyText = (
  poEventType: PurchaseOrderEventType,
  purchaseOrderLine: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node, "quantity" | "purchaseQuantity"> & {
    variant: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node_variant, "salesUnitType">;
  }
) => {
  if (utils.isEmpty(purchaseOrderLine)) {
    return "-";
  }
  const { variant } = purchaseOrderLine;
  const expectedPurchaseQty = getPoLineExpectedPurchaseQty(poEventType, purchaseOrderLine);
  const salesUnitTypeText = getSalesUnitTypeText(variant.salesUnitType);
  return `${getNumberFormat(expectedPurchaseQty)}${salesUnitTypeText}`;
};

export const makePoLineTakeBackAvailableQtyText = (
  purchaseOrderLine: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node, "remainQuantity"> & {
    variant: Pick<PurchaseOrderLineList_purchaseOrderLines_edges_node_variant, "salesUnitType">;
  }
) => {
  if (utils.isEmpty(purchaseOrderLine)) {
    return "-";
  }
  const { remainQuantity, variant } = purchaseOrderLine;
  const salesUnitTypeText = getSalesUnitTypeText(variant.salesUnitType);
  return `${getNumberFormat(remainQuantity)}${salesUnitTypeText}`;
};

export const getPoLineStatusHistory = (
  poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node,
  targetAfterStatus: PurchaseOrderLineStatusEnum
) => {
  if (utils.isEmpty(poLine)) {
    return null;
  }
  const findStatus = poLine?.statusHistories?.findIndex((item) => item.afterStatus === targetAfterStatus);
  if (utils.isEmpty(findStatus) || findStatus === -1) {
    return null;
  }
  return poLine.statusHistories[findStatus];
};

export const calcConsignmentTakeBackCostPriceExcludeVat = (poLine: PurchaseOrderDetails_purchaseOrder_lines) => {
  const costPriceExcludeVat = poLine.productPriceExcludeVat;
  return costPriceExcludeVat;
};

export const getPurchaseOrderDeliveryWarehouseAddress = (
  purchaseOrder:
    | PurchaseOrderDetails_purchaseOrder
    | PurchaseOrderCreatePageFormData
    | PurchaseOrderLineList_purchaseOrderLines_edges_node_purchaseOrder
) => {
  const deliveryWarehouseAddress = {
    postalCode: purchaseOrder?.postalCode || "-",
    streetAddress1: purchaseOrder?.streetAddress1 || "-",
    streetAddress2: purchaseOrder?.streetAddress2 || "-",
  };
  return transformAddress(deliveryWarehouseAddress);
};

export const isNeedDeliveryMethodFilterStatus = (status: PurchaseOrderLineListViewRouteParams["status"]) => {
  const needDeliveryMethodStatuses: Array<PurchaseOrderLineListViewRouteParams["status"]> = [
    "dispatch-fulfillment",
    "confirm-delivery",
  ];
  return needDeliveryMethodStatuses.includes(status);
};

export const getPurchaseOrderLineListDefaultParams = (
  routeParams: PurchaseOrderLineListViewRouteParams
): PurchaseOrderLineListViewUrlQueryParams => ({
  eventType: getPoEventTypeFromPoLineRouteParams(routeParams),
  status: getPoLineStatusFromPoLineRouteParams(routeParams),
});
