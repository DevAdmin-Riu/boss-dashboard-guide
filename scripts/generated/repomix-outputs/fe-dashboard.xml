import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PurchaseOrderLineInspectResultEnum } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import PageHeader from "@src/app/components/PageHeader";
import { PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Form, FormInstance, Space, Table, Typography } from "antd";
import React, { useState } from "react";

import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import { PurchaseOrderLineInspectFormData } from "../../view/PurchaseOrderLineInspectView/inspection";
import PurchaseOrderLineInspectInfoModal from "../PurchaseOrderLineInspectInfoModal/PurchaseOrderLineInspectInfoModal";
import { getPurchaseOrderLineInspectTableSettings } from "./PurchaseOrderLineInspectTableSettings";

interface PurchaseOrderLineInspectPageProps extends PaginateListProps {
  disabled: boolean;
  loading: boolean;
  currencySymbol: string;
  purchaseOrderLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  selectedRowIds: React.Key[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<React.Key[]>>;
  onBack: () => void;
  onInspectComplete: () => void;
  poLineIds?: string[];
  form: FormInstance<PurchaseOrderLineInspectFormData>;
  TypeSafeForm: TypeSafeForm<PurchaseOrderLineInspectFormData>;
}

const PurchaseOrderLineInspectPage: React.FC<PurchaseOrderLineInspectPageProps> = ({
  disabled,
  loading,
  currencySymbol,
  purchaseOrderLines,
  selectedRowIds,
  setSelectedRowIds,
  onBack,
  onInspectComplete,
  poLineIds,
  form,
  TypeSafeForm,
}) => {
  const [inspectInfoModalVisible, setInspectInfoModalVisible] = useState(false);
  const [selectedRecord, setSelectedRecord] = useState<PurchaseOrderLineList_purchaseOrderLines_edges_node | null>(
    null
  );

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const formValues = TypeSafeForm.getUseFormWatched({ name: "lines" });

  // 검수가 완료된 항목이 있는지 확인
  const hasCompletedInspection = React.useMemo(() => {
    if (!formValues || formValues.length === 0) {
      return false;
    }

    return formValues.some((line) => {
      const result = line?.result;
      return result === PurchaseOrderLineInspectResultEnum.PASS || result === PurchaseOrderLineInspectResultEnum.FAIL;
    });
  }, [formValues]);

  const handleInspectInfoClick = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => {
    setSelectedRecord(record);
    setInspectInfoModalVisible(true);
  };

  const columns = getPurchaseOrderLineInspectTableSettings({
    form,
    TypeSafeForm,
    purchaseOrderLines,
    onInspectInfoClick: handleInspectInfoClick,
    formValues,
  });

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <AppHeader onBack={onBack}>입고 검수</AppHeader>
      <PageHeader title={<span style={{ fontWeight: "bold" }}>입고 검수</span>} />

      <Typography.Text type="danger" style={{ display: "block", marginBottom: 20 }}>
        발주 제품의 합부 판정을 선택, 검수 완료 가능하며, 선택하지 않료인 제품은 검수 완료하더라도 입고 검수 페이지에
        남습니다.
      </Typography.Text>

      <Card
        title={
          <Typography.Title level={5} style={{ margin: 0, fontWeight: "bold" }}>
            검수 대상
          </Typography.Title>
        }
      >
        <Form form={form}>
          <Form.List name="lines">
            {() => (
              <Table<PurchaseOrderLineList_purchaseOrderLines_edges_node>
                {...commonTableProps}
                ref={tableRef}
                loading={loading}
                dataSource={purchaseOrderLines}
                columns={columns}
                scroll={{ x: tableWidthSum, y: tableScrollY }}
                pagination={false}
              />
            )}
          </Form.List>
        </Form>
      </Card>

      <Space style={{ marginTop: 20, display: "flex", justifyContent: "flex-end" }}>
        <Button
          type="primary"
          onClick={onInspectComplete}
          disabled={disabled || purchaseOrderLines.length === 0 || !hasCompletedInspection}
        >
          검수 완료
        </Button>
      </Space>

      {/* 검수 정보 모달 */}
      <PurchaseOrderLineInspectInfoModal
        visible={inspectInfoModalVisible}
        onClose={() => {
          setInspectInfoModalVisible(false);
          setSelectedRecord(null);
        }}
        record={selectedRecord}
      />
    </>
  );
};

export default PurchaseOrderLineInspectPage;
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineInspectPage/PurchaseOrderLineInspectTableSettings.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { PurchaseOrderLineInspectResultEnum } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { Button, Form, FormInstance, Select, Space, Tag, Typography } from "antd";
import { ColumnsType } from "antd/lib/table/interface";
import React from "react";

import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import {
  PurchaseOrderLineInspectFormData,
  PurchaseOrderLineInspectFormItem,
  PurchaseOrderLineInspectResultFormEnum,
} from "../../view/PurchaseOrderLineInspectView/inspection";

export interface PurchaseOrderLineInspectTableSettingsProps {
  form: FormInstance<PurchaseOrderLineInspectFormData>;
  TypeSafeForm: TypeSafeForm<PurchaseOrderLineInspectFormData>;
  purchaseOrderLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  formValues?: PurchaseOrderLineInspectFormItem[];
}

// 검수 상태 컴포넌트
const InspectStatusCell: React.FC<{
  result: PurchaseOrderLineInspectResultFormEnum | undefined;
}> = ({ result }) => {
  const isComplete =
    result === PurchaseOrderLineInspectResultEnum.PASS || result === PurchaseOrderLineInspectResultEnum.FAIL;
  return isComplete ? <Tag color="success">완료</Tag> : <Tag color="error">미완료</Tag>;
};

// 파일 업로드 컴포넌트
const FileUploadCell: React.FC<{
  TypeSafeForm: TypeSafeForm<PurchaseOrderLineInspectFormData>;
  lineIndex: number;
  recordId: string;
  file?: File;
}> = ({ TypeSafeForm, lineIndex, recordId, file: fileProp }) => {
  const [localFile, setLocalFile] = React.useState<File | undefined>(fileProp);

  // fileProp이 변경되면 localFile 업데이트
  React.useEffect(() => {
    setLocalFile(fileProp);
  }, [fileProp]);

  return (
    <Space direction="vertical" size={4} style={{ width: "100%" }}>
      {localFile && (
        <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
          {localFile.name}
        </Typography.Text>
      )}
      <Button
        size="small"
        onClick={() => {
          const input = document.getElementById(`file-upload-${recordId}`) as HTMLInputElement;
          if (input) {
            // input 값을 초기화하여 같은 파일도 다시 선택 가능하게 함
            input.value = "";
            input.click();
          }
        }}
      >
        {localFile ? "재첨부" : "파일 첨부"}
      </Button>
      <input
        type="file"
        id={`file-upload-${recordId}`}
        style={{ display: "none" }}
        onChange={(e) => {
          const newFile = e.target.files?.[0];
          if (newFile) {
            // 로컬 상태 즉시 업데이트
            setLocalFile(newFile);
            // TypeSafeForm.setFields를 사용하여 폼 값 업데이트
            TypeSafeForm.setFields([{ name: `lines.${lineIndex}.report`, value: newFile }]);
          }
          // input 값 초기화 (같은 파일 재선택 가능)
          e.target.value = "";
        }}
      />
    </Space>
  );
};

export const getPurchaseOrderLineInspectTableSettings = (
  props: PurchaseOrderLineInspectTableSettingsProps & {
    onInspectInfoClick?: (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => void;
  }
): ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> => {
  const { TypeSafeForm, purchaseOrderLines, onInspectInfoClick, formValues } = props;

  // purchaseOrderLine의 인덱스 찾기
  const findLineIndex = (lineId: string): number => purchaseOrderLines.findIndex((line) => line.id === lineId);

  // 검수 정보 클릭 핸들러
  const handleInspectInfoClick = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => {
    if (onInspectInfoClick) {
      onInspectInfoClick(record);
    }
  };

  const columns: ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> = [
    {
      title: columnNameConstant.purchaseOrder.INSPECT_STATUS,
      key: "inspectStatus",
      width: 80,
      align: "center",
      render: (_, record) => {
        const lineIndex = findLineIndex(record.id);
        const result = formValues?.[lineIndex]?.result;
        return <InspectStatusCell result={result} />;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_RESULT,
      key: "inspectResult",
      width: 100,
      align: "center",
      render: (_, record) => {
        const lineIndex = findLineIndex(record.id);
        return (
          <Form.Item name={TypeSafeForm.getValidDataIndex(`lines.${lineIndex}.result` as any)} style={{ margin: 0 }}>
            <Select
              style={{ width: "100%" }}
              placeholder="선택 안함"
              options={[
                { value: PurchaseOrderLineInspectResultEnum.PASS, label: "합격" },
                { value: PurchaseOrderLineInspectResultEnum.FAIL, label: "불합격" },
                { value: PurchaseOrderLineInspectResultFormEnum.NONE, label: "선택 안함" },
              ]}
              onChange={(value) => {
                TypeSafeForm.setFields([{ name: `lines.${lineIndex}.result`, value }]);
              }}
            />
          </Form.Item>
        );
      },
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record?.productSku || "-",
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendorInfo",
      width: 140,
      render: (_, record) => {
        const vendor = record.purchaseOrder.vendor;
        if (!vendor) {
          return "-";
        }

        const vendorCode = vendor.code || "-";
        const vendorName = vendor.name || "-";
        return `${vendorCode}: ${vendorName}`;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_INFO,
      key: "inspectInfo",
      width: 120,
      align: "center",
      render: (_, record) => {
        const variant = record.variant;
        const hasInspectInfo = variant.inspectMemo || variant.inspectReason || variant.inspectType;

        if (!hasInspectInfo) {
          return "-";
        }

        return (
          <Button type="primary" onClick={() => handleInspectInfoClick(record)}>
            자세히
          </Button>
        );
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_REPORT_ATTACH,
      key: "inspectReportAttach",
      width: 110,
      align: "center",
      render: (_, record) => {
        const lineIndex = findLineIndex(record.id);
        const file = formValues?.[lineIndex]?.report;
        return <FileUploadCell TypeSafeForm={TypeSafeForm} lineIndex={lineIndex} recordId={record.id} file={file} />;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_REPORT,
      key: "inspectReportTemplate",
      width: 120,
      align: "center",
      render: (_, record) => {
        const template = record.variant.inspectReportTemplate;

        if (!template || !template.url) {
          return "-";
        }

        return (
          <Button
            type="primary"
            icon={<DownloadOutlined />}
            href={template.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            다운로드
          </Button>
        );
      },
    },
  ];

  return columns;
};
</file>

