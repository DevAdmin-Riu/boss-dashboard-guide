import { FormChange } from "@hooks/useForm";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { AttributeInputTypeEnum } from "@src/api/types/globalTypes";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { attributeMsg, commonMsg } from "@src/global/assets/messages/commonMsg";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { Card, Checkbox, Col, Input, Row, Select, Typography } from "antd";
import React from "react";
import slugify from "slugify";

import { attributeInputTypeChoices } from "../../utils";
import { AttributePageFormData } from "../AttributePage";

export interface AttributeDetailsProps {
  canChangeType: boolean;
  data: AttributePageFormData;
  disabled: boolean;
  errors: ProductErrorFragment[];
  onChange: FormChange;
}

const AttributeDetails: React.FC<AttributeDetailsProps> = ({ canChangeType, data, disabled, errors, onChange }) => {
  const formErrors = getFormErrors(["name", "slug", "inputType"], errors);

  return (
    <Card title={<CardTitleAntd title={commonMsg.generalInformations} />}>
      <Row gutter={[12, 12]}>
        <Col xs={24} sm={12}>
          <Typography>{attributeMsg.name}</Typography>
          <Input
            name="name"
            disabled={disabled}
            value={data.name}
            onChange={onChange}
            status={!!formErrors?.name ? "error" : undefined}
            placeholder="속성 이름을 입력해주세요."
          />
          {!!formErrors?.name && <Typography.Text type="danger">{makeGqlErrorMsg(formErrors.name)}</Typography.Text>}
        </Col>
        <Col xs={24} sm={12}>
          <Typography>{attributeMsg.slug}</Typography>
          <Input
            name="slug"
            disabled={disabled}
            value={data.slug}
            onChange={onChange}
            status={!!formErrors?.slug ? "error" : undefined}
            placeholder={slugify(data.name).toLowerCase()}
          />
          {!!formErrors?.slug && (
            <Typography.Text type="danger">{makeGqlErrorMsg(formErrors.slug) || attributeMsg.slugHelp}</Typography.Text>
          )}
        </Col>
        <Col xs={24} sm={12}>
          <Typography>{attributeMsg.inputType}</Typography>
          <Select
            style={{ width: "100%" }}
            disabled={disabled || !canChangeType}
            options={attributeInputTypeChoices}
            value={data.inputType}
            onChange={(value) => {
              // 속성 입력 방식이 '직접 입력'인 경우 '제품관리 검색필터 노출'은 무조건 false로 설정 및 AttributeProperties 컴포넌트에서 disabled 처리
              if (value === AttributeInputTypeEnum.DIRECTLY) {
                onChange({ target: { name: "filterableInDashboard", value: false } });
              }
              onChange({ target: { name: "inputType", value } });
            }}
            status={!!formErrors?.inputType ? "error" : undefined}
          />
          {!!formErrors?.inputType && (
            <Typography.Text type="danger">{makeGqlErrorMsg(formErrors.inputType)}</Typography.Text>
          )}
        </Col>
        <Col span={24}>
          <Checkbox
            name={"valueRequired"}
            checked={data.valueRequired}
            onChange={(e) => onChange({ target: { name: "valueRequired", value: e.target.checked } })}
            disabled={disabled}
          >
            {attributeMsg.valueRequired}
          </Checkbox>
        </Col>
      </Row>
    </Card>
  );
};
export default AttributeDetails;
</file>

