import { formRuleMsg } from "@assets/messages/commonMsg";
import { MobileAppInfoCreateInput, MobileAppTypeEnum } from "@src/api/types/globalTypes";
import { isValidMobileAppVersionValidator } from "@src/app/components/antd/Form/validators";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Select } from "antd";
import React, { useEffect } from "react";

import { useMobileAppInfoCreate } from "../api/mutations";
import { SiteSettings_shop_mobileAppInfo } from "../api/types/SiteSettings";
import { getCleanedMobileAppVersion, getMobileAppName } from "./SiteSettingsMobileAppInfo/utils";

interface MobileAppInfoCreateModalProps {
  open: boolean;
  appInfoList: SiteSettings_shop_mobileAppInfo[];
  onClose: () => void;
}

export const MobileAppInfoCreateModal: React.FC<MobileAppInfoCreateModalProps> = (props) => {
  const { open, appInfoList, onClose } = props;
  const [form] = Form.useForm<MobileAppInfoCreateInput>();

  const createdAppTypeList: MobileAppTypeEnum[] = appInfoList?.map((appInfo) => appInfo.type) || [];
  const appTypeEnums = Object.values(MobileAppTypeEnum);
  const appOptions = appTypeEnums
    .filter((value) => !createdAppTypeList.includes(value))
    .map((value) => ({ value, label: getMobileAppName(value) }));

  const initialValues: MobileAppInfoCreateInput = {
    type: appOptions[0]?.value || null,
    minVersion: "1.0.0",
    latestVersion: "1.0.0",
    deepLink: null,
    storeLink: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [mobileAppInfoCreate, mobileAppInfoCreateOpts] = useMobileAppInfoCreate({
    onCompleted: (data) => {
      const errors = data.mobileAppInfoCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("앱 정보 생성 성공");
        onClose();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleCreateSubmit = (formData: MobileAppInfoCreateInput) => {
    const input: MobileAppInfoCreateInput = {
      ...formData,
      minVersion: getCleanedMobileAppVersion(formData.minVersion),
      latestVersion: getCleanedMobileAppVersion(formData.latestVersion),
    };

    mobileAppInfoCreate({ variables: { input } });
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={"앱 정보 생성"}
      okText="생성"
      onOk={form.submit}
      confirmLoading={mobileAppInfoCreateOpts.loading}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={form}
        layout="vertical"
        name={"mobile-app-info-create"}
        initialValues={initialValues}
        onFinish={handleCreateSubmit}
        validateTrigger={"onChange"}
      >
        <Form.Item label="앱 이름" name="type" rules={[{ required: true, message: formRuleMsg.required }]}>
          <Select
            placeholder={appOptions?.length === 0 && "더 이상 정보를 생성할 앱이 없습니다."}
            options={appOptions}
          />
        </Form.Item>
        <Form.Item
          label="최소 지원 버전(강제 업데이트 기준 버전)"
          name="minVersion"
          rules={[{ required: true, message: formRuleMsg.required }, ...isValidMobileAppVersionValidator()]}
        >
          <Input placeholder={"버전 예시: 1.0.0"} />
        </Form.Item>
        <Form.Item
          label="최신 버전(선택 업데이트 기준 버전)"
          name="latestVersion"
          rules={[
            { required: true, message: formRuleMsg.required },
            {
              validator: (_, value) => {
                const minVersionInput = getCleanedMobileAppVersion(form.getFieldValue("minVersion"));
                const latestVersionInput = getCleanedMobileAppVersion(value);

                return utils.compareVersions(minVersionInput, latestVersionInput, true)
                  ? Promise.resolve()
                  : Promise.reject(new Error("최신 버전은 최소 지원 버전보다 낮을 수 없습니다."));
              },
            },
            ...isValidMobileAppVersionValidator(),
          ]}
        >
          <Input placeholder={"버전 예시: 1.0.0"} />
        </Form.Item>
        <Form.Item name="deepLink" label="딥링크" extra="- 모바일 기기에서 클릭 시 앱으로 이동하는 링크">
          <Input />
        </Form.Item>
        <Form.Item
          name="storeLink"
          label="스토어 링크"
          extra="- 모바일 기기에서 앱을 설치할 수 있도록 스토어로 이동하는 링크"
        >
          <Input />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

