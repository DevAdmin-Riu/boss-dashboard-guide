  return <ReqBossProductListView params={params} isItFirstLoad={isItFirstLoad} setIsItFirstLoad={setIsItFirstLoad} />;
};
const ProductVariantListForReqViewWrapper: React.FC<RouteComponentProps<any>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
