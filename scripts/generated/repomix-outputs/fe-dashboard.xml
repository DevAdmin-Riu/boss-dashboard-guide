export const makeSalesStatusByBrandProductVariant = (
  brandProductVariant: Pick<
    BrandProductList_brandProducts_edges_node_brandProductVariants,
    "salesStatus" | "stoppedAt" | "stoppedReason" | "stoppedReasonEtc"
  >,
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[],
  isHtml: boolean = true
) => {
  if (!brandProductVariant) {
    return "-";
  }

  const { salesStatus, stoppedAt, stoppedReason, stoppedReasonEtc } = brandProductVariant;
  const stoppedAtText = `단종일: ${getDateByFormat(stoppedAt, onlyDateFormat)}`;
  const stoppedReasonText = transformStoppedReason(stoppedReasonChoices, stoppedReason, stoppedReasonEtc);
  const stoppedText =
    salesStatus === SalesStatusEnum.WILL_BE_STOPPED ? (
      stoppedReasonText
    ) : salesStatus === SalesStatusEnum.STOPPED ? (
      <>
        {stoppedReasonText}
        <br />({stoppedAtText})
      </>
    ) : null;
  const salesStatusTagColor: TagProps["color"] = salesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
  const salesStatusText = transformSalesStatusByBrandProductVariant(salesStatus);

  return isHtml ? (
    <Tooltip title={stoppedText} placement="top">
      <Tag color={salesStatusTagColor}>{salesStatusText}</Tag>
    </Tooltip>
  ) : (
    salesStatusText
  );
};

