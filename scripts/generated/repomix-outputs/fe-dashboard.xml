export function transformFulfillmentStatusText(status: string, tc?: Boolean) {
  if (status === FulfillmentStatus.CANCELED) {
    return "회수";
  } else if (status === FulfillmentStatus.FULFILLED && tc === false) {
    return "배송중";
  } else if (status === FulfillmentStatus.FULFILLED && tc === true) {
    return "배송완료";
  }
  return "출고대기";
}

