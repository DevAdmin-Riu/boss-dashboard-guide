      render: (_, record) => record.name,
      renderExcel: (record) => record.name,
    },
    {
      key: "action",
      align: "center",
      width: 100,
      render: (_, record) => {
        // 해당 제조사가 연결된 제품이 1개 이상 존재하면 수정/삭제 버튼 비활성화
