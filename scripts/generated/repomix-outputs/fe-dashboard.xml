export const setBrandValueByChangedCreateValues = (
  changedValues: DeepPartial<BrandCreateInput>,
  TypeSafeForm: TypeSafeForm<DeepPartial<BrandCreateInput>>
) => {
  const changedContractType: BrandContractTypeEnum | undefined = _.get(
    changedValues,
    TypeSafeForm.getValidDataIndex("contractType"),
    undefined
  );
  if (changedContractType !== undefined) {
    if (changedContractType === BrandContractTypeEnum.FEE) {
      TypeSafeForm.setFields([
        { name: "mileageRate", value: 100 },
        { name: "cardPayingChargeRate", value: 0 },
        { name: "vbankPayingChargeExcludeVat", value: 0 },
      ]);
    }
    if (changedContractType === BrandContractTypeEnum.REVERSE_FEE) {
      TypeSafeForm.setFields([{ name: "enableRcoinRewardForUsingPoint", value: false }]);
    } else {
      TypeSafeForm.setFields([{ name: "pgType", value: PgTypeEnum.TOSS }]);
    }
  }

  const changedContractStatus: BrandContractStatusEnum | undefined = _.get(
    changedValues,
    TypeSafeForm.getValidDataIndex("contractStatus"),
    undefined
  );
  if (changedContractStatus !== undefined) {
    const isNotRunningContractStatus = checkIsNotRunningContractStatusEnum(changedContractStatus);
    if (isNotRunningContractStatus) {
      TypeSafeForm.setFields([{ name: "isRunning", value: false }]);
    }
  }

  const changedEnabledServices: BrandServiceTypeEnum[] | undefined = _.get(
    changedValues,
    TypeSafeForm.getValidDataIndex("enabledServices"),
    undefined
  );
  if (changedEnabledServices !== undefined) {
    if (changedEnabledServices.includes(BrandServiceTypeEnum.FBV)) {
      TypeSafeForm.setFields([{ name: "enableRcoinRewardForUsingPoint", value: false }]);
    }
    if (changedEnabledServices.includes(BrandServiceTypeEnum.B2B)) {
      TypeSafeForm.setFields([{ name: "contractType", value: BrandContractTypeEnum.B2B }]);
    } else if (checkIsEnableForOnlyLinkersServiceByBrand({ enabledServices: changedEnabledServices })) {
      TypeSafeForm.setFields([{ name: "contractType", value: null }]);
      TypeSafeForm.setFields([{ name: "mileageRate", value: null }]);
      TypeSafeForm.setFields([{ name: "deliveryFeeType", value: null }]);
      TypeSafeForm.setFields([{ name: "exclusiveBpvType", value: null }]);
      TypeSafeForm.setFields([{ name: "enableRcoinRewardForUsingPoint", value: false }]);
      TypeSafeForm.setFields([{ name: "isBossMarketUse", value: false }]);
    }
  }
};

enum CollapseKeys {
  BasicInfo = "BasicInfo",
  BizInfo = "BizInfo",
  ContractInfo = "ContractInfo",
  PaymentInfo = "PaymentInfo",
  PersonInChargeInfo = "PersonInChargeInfo",
  ReverseFeeInfo = "ReverseFeeInfo",
  FbvInfo = "FbvInfo",
}

interface BrandCreatePageProps {
  disabled: boolean;
  onBack: () => void;
  onSubmit: MutationFunction<CreateBrand, CreateBrandVariables>;
}

export const NewBrandCreatePage: React.FC<BrandCreatePageProps> = ({ disabled, onBack, onSubmit }) => {
  const shopData = useShop();
  const initialValues = makeInitialForm(shopData);

  const [form] = Form.useForm<BrandCreateInput>();
  const TypeSafeForm = getTypeSafeForm<BrandCreateInput>(form);

  const handleCreate = async (formData: BrandCreateInput) => {
    await onSubmit({
      variables: {
        input: formData,
      },
    });
  };

  const contractStatus = TypeSafeForm.getUseFormWatched({
    name: "contractStatus",
  });
  const contractType = TypeSafeForm.getUseFormWatched({
    name: "contractType",
  });
  const enabledServices =
    TypeSafeForm.getUseFormWatched({
      name: "enabledServices",
    }) || [];
  const isNotRunningContractStatus = checkIsNotRunningContractStatusEnum(contractStatus);

  const isReverseFeeBrand = contractType === BrandContractTypeEnum.REVERSE_FEE;
  const enableForFbvService = enabledServices.includes(BrandServiceTypeEnum.FBV);

  return (
    <>
      <Form
        form={form}
        initialValues={initialValues}
        labelCol={{ span: 24 }}
        wrapperCol={{ span: 24 }}
        onFinish={handleCreate}
        onValuesChange={(changedValues) => {
          setBrandValueByChangedCreateValues(changedValues, TypeSafeForm);
        }}
        validateMessages={{ required: formRuleMsg.required }}
      >
        <AppHeader onBack={onBack}>{sectionNames.brands}</AppHeader>
        <PageHeader style={{ marginBottom: 24 }} title={"브랜드 추가"} />

        <Collapse
          className={getCollapseClassName(["ant-collapse-header-title"])}
          collapsible="header"
          defaultActiveKey={Object.values(CollapseKeys)}
        >
          <Collapse.Panel header="기본 정보" key={CollapseKeys.BasicInfo}>
            <BrandBasicInfo isCreate TypeSafeForm={TypeSafeForm} />
          </Collapse.Panel>
          <Collapse.Panel header="사업자 정보" key={CollapseKeys.BizInfo}>
            <BrandBizRegInfo isCreate TypeSafeForm={TypeSafeForm} />
          </Collapse.Panel>
          <Collapse.Panel header="계약 정보" key={CollapseKeys.ContractInfo}>
            <BrandContractInfo isCreate TypeSafeForm={TypeSafeForm} />
          </Collapse.Panel>
          {!isNotRunningContractStatus && (
            <>
              <Collapse.Panel header="결제 정보" key={CollapseKeys.PaymentInfo}>
                <BrandPaymentInfo isCreate TypeSafeForm={TypeSafeForm} contractType={contractType} />
              </Collapse.Panel>
            </>
          )}
          <Collapse.Panel header="업무담당자 정보" key={CollapseKeys.PersonInChargeInfo}>
            <BrandPersonInChargeInfo isCreate TypeSafeForm={TypeSafeForm} />
          </Collapse.Panel>
          {!isNotRunningContractStatus && (
            <>
              {isReverseFeeBrand && (
                <Collapse.Panel header="본부 매출 인식 정보" key={CollapseKeys.ReverseFeeInfo}>
                  <BrandReverseFeeInfo isCreate TypeSafeForm={TypeSafeForm} />
                </Collapse.Panel>
              )}
              {enableForFbvService && (
                <Collapse.Panel header={`${brandServiceTerm.fbv} 이용 정보`} key={CollapseKeys.FbvInfo}>
                  <BrandFbvInfo isCreate TypeSafeForm={TypeSafeForm} />
                </Collapse.Panel>
              )}
            </>
          )}
        </Collapse>

        <Form.Item noStyle shouldUpdate>
          {() => (
            <AntdSaveButtonBar
              disabled={!form.isFieldsTouched()}
              state={disabled ? "loading" : "default"}
              labels={{ save: "등록" }}
              onCancel={onBack}
              onSave={form.submit}
            />
          )}
        </Form.Item>
      </Form>
    </>
  );
};
