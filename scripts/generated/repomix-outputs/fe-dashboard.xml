import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { configurationSectionUrl } from "../../../configuration";
import { useVirtualAccountStatusListQuery } from "../../api/queries";
import { VirtualAccountStatusesVariables } from "../../api/types/VirtualAccountStatuses";
import VirtualAccountListPage from "../../components/VirtualAccountListPage";
import {
  virtualAccountCreateViewUrl,
  virtualAccountDetailsViewPath,
  virtualAccountListViewUrl,
  VirtualAccountListViewUrlDialog,
  VirtualAccountListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface VirtualAccountListViewProps {
  params: VirtualAccountListViewUrlQueryParams;
}

export const VirtualAccountListView: React.FC<VirtualAccountListViewProps> = ({ params }) => {
  const shop = useShop();
  const targetUrl = virtualAccountListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.VIRTUAL_ACCOUNT_LIST,
  });

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const filter = getFilterVariables(params);
  const queryVariables: VirtualAccountStatusesVariables = React.useMemo(
    () => ({ ...paginationState, filter }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = useVirtualAccountStatusListQuery({
    variables: queryVariables,
  });
  const virtualAccountList = maybe(() => data.virtualAccountStatuses.edges.map((edge) => edge.node), []);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.virtualAccountStatuses?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<VirtualAccountListViewUrlDialog, VirtualAccountListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <VirtualAccountListPage
        disabled={loading}
        virtualAccountList={virtualAccountList}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        settings={settings}
        pageInfo={pageInfo}
        onAdd={() => navigate(virtualAccountCreateViewUrl)}
        onBack={() => navigate(configurationSectionUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(virtualAccountDetailsViewPath(id))}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

<file path="src/app/views/settings/virtualAccount/views/VirtualAccountCreateView.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { BrandContractTypeEnum, VirtualAccountCreateInput } from "@src/api/types/globalTypes";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useVirtualAccountCreateMutation } from "../api/mutations";
import { VirtualAccountCreateForm, VirtualAccountCreatePage } from "../components/VirtualAccountCreatePage";
import { virtualAccountDetailsViewUrl, virtualAccountListViewUrl } from "../urls";

export const VirtualAccountCreateView: React.FC<{}> = () => {
  const navigate = useNavigator();

  const { search, result } = useBrandSearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, contractType: [BrandContractTypeEnum.REVERSE_FEE] },
  });

  const [virtualAccountCreate, virtualAccountCreateOpts] = useVirtualAccountCreateMutation({});

  const handleVirtualAccountCreate = async (formData: VirtualAccountCreateForm) => {
    if (utils.isEmpty(formData.orgCd)) {
      showNotificationError("가상계좌 발급 기관 코드는 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.orgName)) {
      showNotificationError("가상계좌 발급 고객사명은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.brand)) {
      showNotificationError("가상계좌 발급 기관 정보 연동할 브랜드 선택은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerName)) {
      showNotificationError("가상계좌 발급 담당자 이름은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerEmail)) {
      showNotificationError("가상계좌 발급 담당자 이메일은 필수 항목입니다.");
      return;
    }
    if (utils.isEmpty(formData.managerPhone)) {
      showNotificationError("가상계좌 발급 담당자 연락처는 필수 항목입니다.");
      return;
    }

    const virtualAccountCreateInput: VirtualAccountCreateInput = {
      orgCd: formData.orgCd,
      orgName: formData.orgName,
      managerName: formData.managerName,
      managerEmail: formData.managerEmail,
      managerPhone: formData.managerPhone,
      minQty: formData.minQty,
      brand: formData.brand,
    };
    const result = await virtualAccountCreate({
      variables: {
        input: virtualAccountCreateInput,
      },
    });
    const errors = result.data?.virtualAccountCreate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("가상계좌 발급 기관 정보가 추가되었습니다.");
      navigate(virtualAccountDetailsViewUrl(result?.data?.virtualAccountCreate?.orgCode?.id));
    } else {
      showGqlErrors(errors);
    }

    return errors || null;
  };

  return (
    <>
      <WindowTitle title="가상계좌 발급 기관 정보 등록" />
      <VirtualAccountCreatePage
        disabled={virtualAccountCreateOpts.loading}
        saveButtonBar={virtualAccountCreateOpts.status}
        brandsLoading={result?.loading}
        brands={maybe(
          () => result?.data?.search?.edges?.map((edge) => edge?.node).filter((brand) => !brand?.orgCode),
          []
        )}
        brandsSearch={search}
        onBack={() => navigate(virtualAccountListViewUrl())}
        onSubmit={handleVirtualAccountCreate}
      />
    </>
  );
};
