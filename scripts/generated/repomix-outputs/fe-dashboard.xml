<file path="src/app/components/ManualDownloadButton.tsx">
import { DownloadOutlined, FileTextOutlined } from "@ant-design/icons";
import { s3TemplateUrl } from "@assets/constants/config";
import { brandServiceTerm } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { fileDownloadByLink } from "@utils/fileDownload";
import {
  checkIsEnableForB2bServiceByUser,
  checkIsEnableForBossServiceByUser,
  checkIsEnableForFbvServiceByUser,
  checkIsEnableForLinkersServiceByUser,
} from "@utils/misc";
import { showNotificationInfo } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Dropdown } from "antd";
import React, { useMemo } from "react";

import { commonButtonPropsForLayoutIcon } from "./antd/Button/ButtonProps";

const manualChoicesForBoss = [
  {
    label: `${brandServiceTerm.boss} 이용 매뉴얼`,
    value: `${s3TemplateUrl}/manual_using_boss_for_hq_251124-00.pdf`,
  },
  {
    label: "본부수익금 신청 매뉴얼",
    value: `${s3TemplateUrl}/%E1%84%87%E1%85%A9%E1%86%AB%E1%84%87%E1%85%AE%E1%84%89%E1%85%AE%E1%84%8B%E1%85%B5%E1%86%A8%E1%84%80%E1%85%B3%E1%86%B7%E1%84%89%E1%85%B5%E1%86%AB%E1%84%8E%E1%85%A5%E1%86%BC%E1%84%87%E1%85%A1%E1%86%BC%E1%84%87%E1%85%A5%E1%86%B8_20240401.pdf`,
  },
];
const manualChoicesForLinkers = [
  {
    label: `${brandServiceTerm.linkers} 이용 매뉴얼`,
    value: `${s3TemplateUrl}/manual_using_linkers_for_hq_251020-00.pdf`,
  },
];
const manualChoicesForFbv = [
  {
    label: `${brandServiceTerm.fbv} 이용 매뉴얼`,
    value: null,
  },
];
const manualChoicesForB2b = [
  {
    label: `${brandServiceTerm.boss} 이용 매뉴얼`,
    value: `${s3TemplateUrl}/manual_using_boss_for_b2b_hq_251120-00.pdf`,
  },
];

interface ManualDownloadButtonProps {
  iconMode?: boolean;
}

export const ManualDownloadButton: React.FC<ManualDownloadButtonProps> = (props) => {
  const { iconMode = false } = props;
  const { user } = useUser();
  if (utils.isEmpty(user) || user.isHqStaff === false || utils.isEmpty(user.brand)) {
    return null;
  }

  const buttonText = "이용 매뉴얼";

  const onManualClick = (link: string, label: string) => {
    if (utils.isEmpty(link)) {
      showNotificationInfo("해당 매뉴얼은 준비 중입니다.");
      return;
    }

    const fileExtension = link.split(".").pop() || "pdf";
    const fileName = "(가맹본부용) " + [label, fileExtension].join(".");
    fileDownloadByLink({ link, fileName });
  };

  const targetChoices = useMemo(() => {
    const defaultChoices = [];
    if (checkIsEnableForBossServiceByUser(user)) {
      defaultChoices.push(...manualChoicesForBoss);
    }
    if (checkIsEnableForLinkersServiceByUser(user)) {
      defaultChoices.push(...manualChoicesForLinkers);
    }
    if (checkIsEnableForFbvServiceByUser(user)) {
      defaultChoices.push(...manualChoicesForFbv);
    }
    if (checkIsEnableForB2bServiceByUser(user)) {
      defaultChoices.push(...manualChoicesForB2b);
    }
    return defaultChoices;
  }, [user.brand.enabledServices]);

  return (
    <Dropdown
      trigger={["click"]}
      placement="bottomLeft"
      menu={{
        items: targetChoices.map((c, idx) => ({
          icon: <DownloadOutlined />,
          key: idx,
          label: c.label,
        })),
        onClick: (info) => {
          const choiceIdx = Number(info.key);
          const link = targetChoices[choiceIdx].value;
          const label = targetChoices[choiceIdx].label;
          onManualClick(link, label);
        },
      }}
    >
      {iconMode ? (
        <Button {...commonButtonPropsForLayoutIcon} icon={<FileTextOutlined />} />
      ) : (
        <Button size="small" type="primary">
          {buttonText}
        </Button>
      )}
    </Dropdown>
  );
};
</file>

<file path="src/app/components/MenuToggle.tsx">
import React from "react";

interface MenuToggleProps {
  ariaOwns?: string;
  children: (props: {
    actions: {
      open: () => void;
      close: () => void;
    };
    open: boolean;
  }) => React.ReactElement<any>;
}

interface MenuToggleState {
  open: boolean;
}

class MenuToggle extends React.Component<MenuToggleProps, MenuToggleState> {
  state = {
    open: false,
  };

  handleClick = () => {
    this.setState({ open: true });
  };

  handleClose = () => {
    this.setState({ open: false });
  };

  render() {
    const { children } = this.props;
    const { open } = this.state;

    return children({
      actions: { close: this.handleClose, open: this.handleClick },
      open,
    });
  }
}

export default MenuToggle;
</file>

