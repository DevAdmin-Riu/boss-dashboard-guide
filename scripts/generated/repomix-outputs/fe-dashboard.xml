import { Button, Card, Checkbox, Col, Row, Space, Typography } from "antd";
import React from "react";

export interface FilterPickerChoice {
  label: string;
  value: string;
}

export interface FilterPickerContentProps {
  filters: FilterPickerChoice[];
  loading?: boolean;
  selectedFilters: string[];
  total: number;
  onCancel: () => void;
  onFilterToggle: (filter: string) => void;
  onAllSelectOn: () => void;
  onAllSelectOff: () => void;
  onSave: () => void;
  onReset?: () => void;
}

const FilterPickerContent: React.FC<FilterPickerContentProps> = ({
  filters,
  loading,
  selectedFilters,
  total,
  onCancel,
  onFilterToggle,
  onAllSelectOn,
  onAllSelectOff,
  onSave,
  onReset,
}) => {
  const selectedCount = selectedFilters.length;
  const allSelected = selectedCount === total;
  const someSelected = selectedCount > 0 && selectedCount < total;

  return (
    <Card
      title={
        <Row align="middle" justify="space-between">
          <Col>
            <Typography.Text strong>필터 설정</Typography.Text>
          </Col>
          <Col>
            <Typography.Text type="secondary">
              {selectedCount} / {total} 선택됨
            </Typography.Text>
          </Col>
        </Row>
      }
      size="small"
      style={{ width: 400, maxHeight: 500 }}
      bodyStyle={{ maxHeight: 350, overflowY: "auto", padding: "12px" }}
      actions={[
        <Row key="actions" gutter={8} style={{ padding: "0 16px" }}>
          <Col span={6}>
            <Button block onClick={onCancel}>
              취소
            </Button>
          </Col>
          <Col span={6}>
            <Button block onClick={onReset} disabled={!onReset}>
              초기화
            </Button>
          </Col>
          <Col span={12}>
            <Button block onClick={onSave} type="primary" loading={loading}>
              적용
            </Button>
          </Col>
        </Row>,
      ]}
    >
      <Space direction="vertical" style={{ width: "100%" }} size="middle">
        <Checkbox
          indeterminate={someSelected}
          checked={allSelected}
          onChange={(e) => {
            if (e.target.checked) {
              onAllSelectOn();
            } else {
              onAllSelectOff();
            }
          }}
        >
          <Typography.Text strong>전체 선택</Typography.Text>
