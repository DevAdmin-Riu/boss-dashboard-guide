  orderLines: HqOrderLineList_orderLines_edges_node[];
  queryVariablesWithoutPagination: HqOrderLineListVariables;
  fetchForDownload: (variables?: HqOrderLineListVariables) => Promise<ApolloQueryResult<HqOrderLineList>>;
  onCreateIndividualOrder?: () => void;
  onCreateBulkOrder?: () => void;
  isBulkOrderModalOpen?: boolean;
  onCloseBulkOrderModal?: () => void;
}

const HqOrderLineListPage: React.FC<HqOrderLineListPageProps> = (props) => {
  const {
    brand,
    currentTab,
    filterOpts,
    tabs,
    orderLines,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onCreateIndividualOrder,
    onCreateBulkOrder,
    isBulkOrderModalOpen,
    onCloseBulkOrderModal,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, brand);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getHqOrderLineTableSettings(props);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: columns,
    dataKey: "orderLines",
  };

  const makeExtraUi = () => {
    // B2B와 REVERSE_FEE는 대행주문 생성 불가
    if (canCreateAgencyOrder(brand) === false) {
      return null;
    }

    return (
      <Space direction="horizontal" size={8}>
        <Button type="primary" shape="round" icon={<ArrowRightOutlined />} onClick={onCreateIndividualOrder}>
          개별 주문 생성
        </Button>
        <Button type="primary" shape="round" icon={<UploadOutlined />} onClick={onCreateBulkOrder}>
          일괄 주문 생성
        </Button>
        <Button
          type="default"
          shape="round"
          icon={<DownloadOutlined />}
          href={`${s3TemplateUrl}/hq_staff_create_order_for_brand.xlsx`}
          target="_blank"
        >
          대행주문 양식
        </Button>
      </Space>
    );
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.hqOrderLines}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={columns}
          dataSource={orderLines}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
      <OrderCreateByStaffModal
        open={isBulkOrderModalOpen}
        disabled={listProps.disabled}
        orderType={OrderType.BY_HQ_STAFF_FOR_BRAND}
        onClose={onCloseBulkOrderModal}
      />
    </Space>
  );
};

export default HqOrderLineListPage;
</file>

