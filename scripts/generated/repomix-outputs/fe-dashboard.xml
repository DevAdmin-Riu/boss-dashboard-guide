    disabled,
    isFromBossToHq,
    editMode,
    onEdit,
    onEditCancel,
    onBack,
    onBasicInfoUpdate,
    onVisibilityUpdate,
    onAvailableToAllBrandsChange,
    onDelete,
    onBrandAssign,
    onBrandUnassign,
    onBrandUnassignBulk,
  } = props;
  const { user } = useUser();
  const isEditable = user.isStaff;

  const [basicInfoForm] = Form.useForm<NoticeBasicInfoUpdateForm>();
  const [visibilityForm] = Form.useForm<NoticeVisibilityUpdateForm>();
  const VisibilityTypeSafeForm = getTypeSafeForm<NoticeVisibilityUpdateForm>(visibilityForm);

  const isEditing = utils.isEmpty(editMode) === false;

  const basicInfoInitialValues: NoticeBasicInfoUpdateForm = {
    title: notice.title,
    content: parseContentJsonStrToMarkdown(notice.content),
  };
  const visibilityInitialValues: NoticeVisibilityUpdateForm = {
    isPublished: notice.isPublished,
    publicationDate: notice.publicationDate,
    thumbnail: toUploadFormInitialValue(notice.thumbnail, "alt"),
  };

  useEffect(() => {
    basicInfoForm.resetFields();
    visibilityForm.resetFields();
  }, [editMode]);

  const pageTitle = "공지사항";
  const appHeaderTitle = isFromBossToHq ? sectionNames.bossToHqNotice : sectionNames.bossToUserNotice;

  return (
    <>
      <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
      <PageHeader
        title={pageTitle}
        extra={
          <Button danger type="primary" shape="round" onClick={onDelete}>
            공지사항 삭제
          </Button>
        }
      />

      <Grid>
        <Space direction="vertical" size="large">
          <Form
            name="notice-basic-info"
            layout="vertical"
            form={basicInfoForm}
            disabled={disabled || (isEditing && editMode !== NoticeDetailsEditModeEnum.UpdateBasicInfo)}
            initialValues={basicInfoInitialValues}
            onFinish={onBasicInfoUpdate}
          >
            <NoticeFromBossBasicInfo
              isCreate={false}
              form={basicInfoForm}
              notice={notice}
              editModeProps={{
                isEditMode: editMode === NoticeDetailsEditModeEnum.UpdateBasicInfo,
                onEdit: () => onEdit(NoticeDetailsEditModeEnum.UpdateBasicInfo),
                onCancel: onEditCancel,
              }}
            />
          </Form>
          {/* 관리자 대시보드에서 포장보스 → 가맹본부/매장 공지인 경우에 표시 */}
          {/* TODO: AssignedBrandTable를 공유하는 배너, 팝업 상세까지 모두 antd Form으로 변경 후 UI, props 수정 필요 */}
          {/* 현재 props는 이전 mui Form 기준으로 작성됨 */}
          {user.isStaff && (
            <AssignedBrandTable
              disabled={disabled}
              title={notice.title}
              brands={notice.availableBrands}
              originData={notice}
              formData={notice}
              onChange={(event) => onAvailableToAllBrandsChange(event.target.value)}
              onBrandAssign={onBrandAssign}
              onBrandUnassign={onBrandUnassign}
              onBrandUnassignBulk={onBrandUnassignBulk}
            />
          )}
        </Space>
        {isEditable && (
          <Space direction="vertical" size="large">
            <Form
              form={visibilityForm}
              name="notice-visibility"
              layout="vertical"
              disabled={disabled || (isEditing && editMode !== NoticeDetailsEditModeEnum.UpdateVisibility)}
              initialValues={visibilityInitialValues}
              onFinish={onVisibilityUpdate}
            >
              <VisibilityCard
                isCreate={false}
                form={visibilityForm}
                initialValues={visibilityInitialValues}
                editModeProps={{
                  isEditMode: editMode === NoticeDetailsEditModeEnum.UpdateVisibility,
                  onEdit: () => onEdit(NoticeDetailsEditModeEnum.UpdateVisibility),
                  onCancel: onEditCancel,
                }}
              >
                {isFromBossToHq && (
                  <EditableField
                    type="upload"
                    listType="picture-card"
                    singleFileMode
                    name={VisibilityTypeSafeForm.getValidDataIndex("thumbnail")}
                    value={visibilityInitialValues.thumbnail}
                    editMode={isEditing && editMode === NoticeDetailsEditModeEnum.UpdateVisibility}
                    showUploadList={{ showPreviewIcon: false }}
                    label="썸네일 이미지 | 권장 규격: 400X300px"
                    accept="image/*"
                  />
                )}
              </VisibilityCard>
            </Form>
          </Space>
        )}
      </Grid>
    </>
  );
};

export default NoticeDetailsPage;
