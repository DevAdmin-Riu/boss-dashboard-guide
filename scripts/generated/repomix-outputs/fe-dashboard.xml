import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { commonMsg, formRuleMsg } from "@src/global/assets/messages/commonMsg";
import { transformIsPublished } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Divider, FormInstance, Space, Typography } from "antd";
import moment from "moment";
import React from "react";

import { getTypeSafeForm } from "../antd/Form/utils";
import EditableField from "../EditableField/EditableField";
import { FormSaveButton, FormSaveButtonEditModeProps } from "../SaveButtonBar/FormSaveButton";
import StatusLabel from "../StatusLabel";

export const makePublishedForBsNode = (record: { isPublished: boolean; publicationDate: any }): React.ReactNode => {
  const { isPublished, publicationDate } = record;
  const isPublishedText = transformIsPublished(isPublished);
  const isPublishedNode = (
    <StatusLabel useSmallDot label={isPublishedText} status={record.isPublished ? "success" : "error"} />
  );
  if (isPublished || utils.isEmpty(publicationDate) || moment(publicationDate).isValid() === false) {
    return isPublishedNode;
  }

  const publicationDateText = moment(publicationDate).format(onlyDateFormat);
  return (
    <Space direction="vertical" size={0}>
      {isPublishedNode}
      <Typography.Text style={{ fontSize: 12 }} type="secondary">
        {publicationDateText} 공개
      </Typography.Text>
    </Space>
  );
};

// PublishableModel을 상속 받은 모델에 적용되는 폼 필드
interface PublishableModelForm {
  isPublished?: boolean;
  publicationDate?: any;
}

interface CommonProps {
  form: FormInstance<PublishableModelForm>;
  children?: React.ReactNode;
}
type CreateProps = CommonProps & {
  isCreate: true;
};
type UpdateProps = CommonProps & {
  isCreate: false;
  initialValues: PublishableModelForm;
  editModeProps: FormSaveButtonEditModeProps;
};
type VisibilityCardProps = CreateProps | UpdateProps;

export const VisibilityCard: React.FC<VisibilityCardProps> = (props) => {
  const { isCreate, form, children } = props;
  const isUpdate = isCreate === false;
  const isEditMode = isUpdate ? props.editModeProps.isEditMode : true;
  const TypeSafeForm = getTypeSafeForm<PublishableModelForm>(form);

  const isPublishedWatched = TypeSafeForm.getUseFormWatched({ name: "isPublished" });

  const isPublishedOptions = [
    { label: commonMsg.visible, value: true },
    { label: commonMsg.hidden, value: false },
  ];

  const cardTitle = <Typography.Title level={4}>공개 설정</Typography.Title>;
  const cardExtra = isUpdate && (
    <FormSaveButton
      form={form}
      isEditMode={props.editModeProps.isEditMode}
      onEdit={props.editModeProps.onEdit}
      onCancel={props.editModeProps.onCancel}
    />
  );

  return (
    <Card title={cardTitle} extra={cardExtra}>
      <Space direction="vertical" size={0} split={<Divider style={{ margin: "12px 0" }} />}>
        <Space direction="vertical" size={0}>
          <EditableField
            type="radio"
            label="공개 여부"
            name={TypeSafeForm.getValidDataIndex("isPublished")}
            value={isUpdate && props.initialValues.isPublished}
            editMode={isEditMode}
            options={isPublishedOptions}
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
            onChange={(e) => {
              const isPublished = e.target.value;
              const newPublicationDate = isPublished ? moment().format(onlyDateFormat) : undefined;
              TypeSafeForm.setFields([{ name: "publicationDate", value: newPublicationDate }]);
            }}
          />
          <EditableField
            type="datepicker"
            label="공개(예정)일"
            name={TypeSafeForm.getValidDataIndex("publicationDate")}
            value={isUpdate && props.initialValues.publicationDate}
            editMode={isEditMode}
            disabled={isPublishedWatched}
            disabledDate={(current) => current && current < moment().add(1, "day").startOf("day")}
            formDateFormat={onlyDateFormat}
          />
        </Space>
        {children && (
          <Space direction="vertical" size={0}>
            {children}
          </Space>
        )}
      </Space>
    </Card>
  );
};

export default VisibilityCard;
</file>

