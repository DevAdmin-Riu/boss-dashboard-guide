    record: ProductVariantList_productVariants_edges_node,
    prevRecord: ProductVariantList_productVariants_edges_node
  ) => !shallowEqual(record, prevRecord);
  const shouldCellUpdateExceptionKeys = ["sumOfWarehouseStock"];
  // 모든 컬럼들에 대해 shouldCellUpdate 값을 shouldCellUpdateFunc로 설정한다.
  columns.forEach((column, idx) => {
    if ("children" in column) {
      // 첫번째 큰 컬럼은 제외한다. stockAdjustmentDisabled 에 따라 checkbox가 생기고 안생기고 하는데 cellupdate를 통해서 위치가 변경되어야 함.
      if (idx !== 0) {
        column.children.forEach((child) => {
          // 값이 이미 들어 있는 경웨 해당 작업 하지 않는다.
          if (!shouldCellUpdateExceptionKeys.includes(String(child.key))) {
            child.shouldCellUpdate = shouldCellUpdateFunc;
          }
        });
      }
    } else {
      // 첫번째 칼럼이 children가지고 있지 안더라도 제외.
      if (idx !== 0) {
        if (!shouldCellUpdateExceptionKeys.includes(String(column.key))) {
          column.shouldCellUpdate = shouldCellUpdateFunc;
        }
      }
    }
  });

  return columns;
}
