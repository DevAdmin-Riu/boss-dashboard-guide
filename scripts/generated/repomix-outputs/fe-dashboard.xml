export function createFilterStructure(
  opts: OrderLineListFilterOpts,
  params: OrderLineListViewUrlQueryParams,
  isB2b: boolean,
  isB2bPurchaseWriteListView: boolean
): IFilter<OrderLineListFilterKeys> {
  let displayOrder = 0;
  const { orderLineListViewType, orderLineListActionType } = params;
  const isListViewFulfilledByVendor = checkIsListViewFulfilledByVendor(orderLineListViewType);
  const isListActionForPurchase = checkIsListActionForPurchase(orderLineListActionType);
  const isListActionForFulfill = checkIsListActionForFulfill(orderLineListActionType);
  const orderTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderLineListFilterKeys.orderType,
      "주문 방식",
      opts.orderType.value,
      isB2bPurchaseWriteListView ? false : true, // B2B 주문 작성 페이지에서는 radio filter 나머지는 checkbox filter
      [
        {
          label: "B2B 주문",
          value: OrderTypeEnum.BY_STAFF_FOR_B2B,
        },
        {
          label: "B2B 반품",
          value: OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK,
        },
      ]
    ),
    active: opts.orderType.active,
    isRequired: true,
  };
  const orderStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderLineListFilterKeys.orderStatus,
      "결제 증빙 포함 여부",
      opts.orderStatus.value,
      false,
      [
        {
          label: "포함",
          value: OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED,
        },
        {
          label: "미포함",
          value: OrderStatusFilter.READY_TO_FULFILL,
        },
      ]
    ),
    active: opts.orderStatus.active,
    isRequired: true,
  };
  const poEventTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderLineListFilterKeys.purchaseOrderEventType,
      filterMsg.purchaseOrderEventType,
      opts.purchaseOrderEventType.value,
      true,
      purchaseOrderLineEventTypeEnumChoices(isB2b).filter((status) =>
        defaultPoEventTypeListForFulfillOrderLineList.includes(status.value)
      )
    ),
    active: opts.purchaseOrderEventType.active,
    isRequired: true,
  };
  const isByNonCourierFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderLineListFilterKeys.isByNonCourier,
      "위탁 구분",
      opts.isByNonCourier.value,
      {
        positive: "협력사 직납",
        negative: "일반",
      }
    ),
    active: opts.isByNonCourier.active,
    isRequired: true,
  };
  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.orderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.b2bOrderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.b2bOrderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.b2bOrderSearch.active,
  };
  const purchaseOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.purchaseOrderSearch,
      filterNameConstant.PURCHASE_ORDER_SEARCH,
      opts.purchaseOrderSearch.value
    ),
    active: opts.purchaseOrderSearch.active,
  };
  const orderCreatedFilter = {
    ...createDateField(displayOrder++, OrderLineListFilterKeys.orderCreated, "주문일", opts.orderCreated.value),
    active: opts.orderCreated.active,
  };
  const orderCapturedAtFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.orderCapturedAt,
      columnNameConstant.order.CAPTURED_DATE,
      opts.orderCapturedAt.value
    ),
    active: opts.orderCapturedAt.active,
  };
  const orderDeliveryRequestDateFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.orderDeliveryRequestDate,
      "희망배송일",
      opts.orderDeliveryRequestDate.value
    ),
    active: opts.orderDeliveryRequestDate.active,
  };
  const purchaseOrderDateFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.purchaseOrderDate,
      "발주일",
      opts.purchaseOrderDate.value
    ),
    active: opts.purchaseOrderDate.active,
  };
  const askingPurchaseDateFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.askingPurchaseDate,
      filterMsg.poLineAskingPurchaseDate,
      opts.askingPurchaseDate.value
    ),
    active: opts.askingPurchaseDate.active,
  };
  const expectedPurchaseDateFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.expectedPurchaseDate,
      filterMsg.poLineExpectedPurchaseDate,
      opts.expectedPurchaseDate.value
    ),
    active: opts.expectedPurchaseDate.active,
  };
  const fulfillmentCreatedFilter = {
    ...createDateField(
      displayOrder++,
      OrderLineListFilterKeys.fulfillmentCreated,
      "출고일",
      opts.fulfillmentCreated.value
    ),
    active: opts.fulfillmentCreated.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.brandSearch,
      isB2b ? filterNameConstant.BRAND_SEARCH_FOR_B2B : filterNameConstant.BRAND_SEARCH,
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.brandStoreSearch,
      filterNameConstant.BRAND_STORE_SEARCH,
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.userSearch,
      filterNameConstant.USER_SEARCH,
      opts.userSearch.value
    ),
    active: opts.userSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const isTaxFreeFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderLineListFilterKeys.isTaxFree,
      columnNameConstant.product.IS_TAX_FREE,
      opts.isTaxFree.value,
      {
        negative: "과세",
        positive: "면세",
      }
    ),
    active: opts.isTaxFree.active,
  };
  const useAutoConsignmentPoFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderLineListFilterKeys.useAutoConsignmentPo,
      columnNameConstant.product.USE_AUTO_CONSIGNMENT_PO,
      opts.useAutoConsignmentPo.value,
      {
        negative: "제외",
        positive: "대상",
      }
    ),
    active: opts.useAutoConsignmentPo.active,
    isRequired: true,
  };
  const isTrackInventoryFulfillmentFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderLineListFilterKeys.isTrackInventoryFulfillment,
      columnNameConstant.order.FULFILLMENT_TYPE,
      opts.isTrackInventoryFulfillment.value,
      {
        positive: "보관",
        negative: "위탁",
      }
    ),
    active: opts.isTrackInventoryFulfillment.active,
  };
  const purchaseVendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderLineListFilterKeys.purchaseVendorSearch,
      filterNameConstant.VENDOR_SEARCH,
      opts.purchaseVendorSearch.value
    ),
    active: opts.purchaseVendorSearch.active,
  };
  const vendorContactTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderLineListFilterKeys.vendorContactType,
      "협력사구분",
      opts.vendorContactType.value,
      true,
      vendorContactTypeChoices
    ),
    active: opts.vendorContactType.active,
  };

  let filterStructure: IFilter<OrderLineListFilterKeys> = [];
  if (isListViewFulfilledByVendor) {
    filterStructure = [
      isB2b === false && orderSearchFilter,
      isB2b && b2bOrderSearchFilter,
      isTrackInventoryFulfillmentFilter,
      orderDeliveryRequestDateFilter,
      orderCreatedFilter,
      fulfillmentCreatedFilter,
      brandSearchFilter,
      isB2b === false && brandStoreSearchFilter,
      userSearchFilter,
      productSearchFilter,
    ];
  } else if (isListActionForFulfill) {
    filterStructure = [
      poEventTypeFilter,
      isB2b && b2bOrderSearchFilter,
      isB2b === false && orderSearchFilter,
      purchaseOrderSearchFilter,
      purchaseOrderDateFilter,
      askingPurchaseDateFilter,
      isB2b && expectedPurchaseDateFilter,
      productSearchFilter,
      purchaseVendorSearchFilter,
      brandSearchFilter,
      isB2b === false && brandStoreSearchFilter,
      userSearchFilter,
      orderCreatedFilter,
      isTaxFreeFilter,
    ];
  } else {
    filterStructure = [
      isB2b && isB2bPurchaseWriteListView && orderTypeFilter,
      isB2b === false && isListActionForPurchase && orderStatusFilter,
      isB2b === false && isListActionForPurchase && isByNonCourierFilter,
      isB2b === false && isListActionForPurchase && useAutoConsignmentPoFilter,
      !isListActionForPurchase && purchaseOrderSearchFilter,
      brandSearchFilter,
      isB2b === false && brandStoreSearchFilter,
      isB2b === false && userSearchFilter,
      productSearchFilter,
      isTaxFreeFilter,
      purchaseVendorSearchFilter,
      isListActionForPurchase && vendorContactTypeFilter,
      orderCreatedFilter,
      isListActionForPurchase && orderCapturedAtFilter,
      !isListActionForPurchase && purchaseOrderDateFilter,
      !isListActionForPurchase && fulfillmentCreatedFilter,
    ];
  }
  return utils.filterDisplayOrdering(filterStructure.filter(Boolean));
}
