import { getStatusFilterVariableFromVsPurchaseRouteParams } from "./views/VsPurchaseListView/filters";
import { getVsPoLineStatusFromPoLineRouteParams } from "./views/VsPurchaseOrderLineListView/filters";

const defaultStrValue = "-";

// // 주의: S3 에 발주서 양식에 대체 키값 정의하고 추가해야 함
const keyNamesToReplace = {
  // 공급자 정보
  supplierBizRegNo: "[supplierBizRegNo]",
  supplierPhone: "[supplierPhone]",
  supplierCompanyName: "[supplierCompanyName]",
  supplierCeo: "[supplierCeo]",
  supplierAddress: "[supplierAddress]",
  // 공급받는자 정보
  purchaserBizRegNo: "[purchaserBizRegNo]",
  purchaserPhone: "[purchaserPhone]",
  purchaserCompanyName: "[purchaserCompanyName]",
  purchaserCeo: "[purchaserCeo]",
  purchaserAddress: "[purchaserAddress]",
  // 발주 품목 리스트 컬럼명
  numIdx: "[numIdx]", // No.
  deliveryConfirmedDate: "[deliveryConfirmedDate]", // 납품일
  productSku: "[productSku]", // 리우 제품코드
  productName: "[productName]", // 제품명
  brandProductName: "[brandProductName]", // 상품명
  productSpec: "[productSpec]", // 규격
  purchaseQuantity: "[purchaseQuantity]", // 수량
  purchasedPlace: "[purchasedPlace]", // 입고처 - 재고: 주식회사 리우, 위탁: 회원 상호
  // 입고 검수 확인란
  inspectorName: "[inspectorName]", // 검수자
  inspectorPhone: "[inspectorPhone]", // 연락처
  inspectorAddress: "[inspectorAddress]", // 납품처 주소
  stockAvailableTime: "[stockAvailableTime]", // 입고 가능시간 - 재고 거래명세서 only
};

type TVendorForPrint = Pick<User_vendor, "id" | "name" | "bizRegNo" | "phone" | "ceo" | "address">;

const makePoLineMap = (
  trackInventory: boolean,
  idx: number,
  poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node,
  isB2b: boolean
) => {
  const salesUnitTypeText = getSalesUnitTypeText(poLine.variant.salesUnitType);
  const statusHistory = getPoLineStatusHistory(poLine, PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED);
  return {
    [keyNamesToReplace.numIdx]: idx + 1,
    [keyNamesToReplace.deliveryConfirmedDate]: getDateByFormat(statusHistory?.createdAt, onlyDateFormat),
    [keyNamesToReplace.productSku]: poLine.productSku,
    [keyNamesToReplace.productName]: poLine.productName,
    [keyNamesToReplace.brandProductName]: poLine.orderLine?.productName,
    [keyNamesToReplace.productSpec]: isB2b
      ? makeProductSpecFromPoLineByAttribute(poLine, "size")
      : makeProductSpecFromPoLine(poLine),

    [keyNamesToReplace.purchaseQuantity]: `${getNumberFormat(poLine.purchaseQuantity)}${salesUnitTypeText}`,
    [keyNamesToReplace.purchasedPlace]: trackInventory
      ? riuCompanyName
      : transformAddress(poLine.orderLine?.order.shippingAddress),
    [keyNamesToReplace.inspectorAddress]: isB2b
      ? transformAddress(poLine.shippingAddress) || defaultStrValue
      : defaultStrValue,
  };
};

// 재고 거래명세서 - 공급자: 협력사 / 공급받는자: 리우
// 위탁 거래명세서 - 공급자: 리우 / 공급받는자: 매장
const makePoInvoiceMap = (
  trackInventory: boolean,
  poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node,
  vendor: TVendorForPrint
) => {
  if (trackInventory) {
    const purchaseOrder = poLine.purchaseOrder;
    return {
      [keyNamesToReplace.supplierBizRegNo]: vendor.bizRegNo || defaultStrValue,
      [keyNamesToReplace.supplierPhone]: transformPhoneNumber(vendor.phone) || defaultStrValue,
      [keyNamesToReplace.supplierCompanyName]: vendor.name || defaultStrValue,
      [keyNamesToReplace.supplierCeo]: vendor.ceo || defaultStrValue,
      [keyNamesToReplace.supplierAddress]: vendor.address || defaultStrValue,
      [keyNamesToReplace.purchaserBizRegNo]: riuBizRegNo,
      [keyNamesToReplace.purchaserPhone]: riuPhone,
      [keyNamesToReplace.purchaserCompanyName]: riuCompanyName,
      [keyNamesToReplace.purchaserCeo]: riuCeoName,
      [keyNamesToReplace.purchaserAddress]: riuBizRegAddress,
      [keyNamesToReplace.inspectorName]: purchaseOrder.deliveryWarehouseManager || defaultStrValue,
      [keyNamesToReplace.inspectorPhone]: transformPhoneNumber(purchaseOrder.phone) || defaultStrValue,
      [keyNamesToReplace.inspectorAddress]: transformAddress(purchaseOrder) || defaultStrValue,
      [keyNamesToReplace.stockAvailableTime]: "09:00 ~ 11:00, 16:00 ~ 17:00\n(11:30 ~ 12:30 점심시간)",
    };
  } else {
    const orderUser = poLine.orderLine.order.user;
    const poLineAddress = poLine.shippingAddress;
    return {
      [keyNamesToReplace.supplierBizRegNo]: riuBizRegNo,
      [keyNamesToReplace.supplierPhone]: riuPhone,
      [keyNamesToReplace.supplierCompanyName]: riuCompanyName,
      [keyNamesToReplace.supplierCeo]: riuCeoName,
      [keyNamesToReplace.supplierAddress]: riuBizRegAddress,
      [keyNamesToReplace.purchaserBizRegNo]: orderUser.bizRegNo || defaultStrValue,
      [keyNamesToReplace.purchaserPhone]: transformPhoneNumber(orderUser.aligoPhone) || defaultStrValue,
      [keyNamesToReplace.purchaserCompanyName]: orderUser.bizRegCorpName || defaultStrValue,
      [keyNamesToReplace.purchaserCeo]: orderUser.bizRegCeoName || defaultStrValue,
      [keyNamesToReplace.purchaserAddress]: orderUser.bizRegAddr || defaultStrValue,
      [keyNamesToReplace.inspectorName]: poLineAddress.firstName || defaultStrValue,
      [keyNamesToReplace.inspectorPhone]: transformPhoneNumber(poLineAddress.phone) || defaultStrValue,
      [keyNamesToReplace.inspectorAddress]: transformAddress(poLineAddress) || defaultStrValue,
    };
  }
};

interface GenerateExcelInfoByGroupProps {
  originWorksheet: xlsx.WorkSheet;
  trackInventory: boolean;
  poLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  vendor: TVendorForPrint;
  isB2b: boolean;
}
// 재고 발주인 경우에만 vendor 정보가 필요함
const generateExcelInfoByGroup = async ({
  originWorksheet,
  trackInventory,
  poLines,
  vendor,
  isB2b,
}: GenerateExcelInfoByGroupProps): Promise<IExcelDownloadByWorkBookProps> => {
  const poLineCount = poLines.length;
  const csvStr = xlsx.utils.sheet_to_csv(originWorksheet);
  // row의 첫 번째 셀에 빈 문자열은 s3에 업로드 되어 있는 발주서 양식이 좌측에 한 칸 비어있기 때문에 추가
  const poLineInvoiceDataArr = csvStr.split("\n").map((row) => [...row.split(",")]);

  const { expandedDataArr, expandedMerges, expandedRowsInfo } = expandTemplateDataArrByLines({
    originWorksheet,
    dataArr: poLineInvoiceDataArr,
    lineCount: poLineCount,
    lineKey: keyNamesToReplace.numIdx,
  });

  const poInvoiceMap = makePoInvoiceMap(trackInventory, poLines[0], vendor);
  const poLineMaps = poLines.map((poLine, idx) => makePoLineMap(trackInventory, idx, poLine, isB2b));
  const replacedDataArr = replaceTemplateDataArrByMap({
    dataArr: expandedDataArr,
    dataMap: poInvoiceMap,
    lineMaps: poLineMaps,
    lineKey: keyNamesToReplace.numIdx,
  });

  // 생성할 워크북 및 워크시트 생성
  const newWorkbook = xlsx.utils.book_new();
  const newWorksheet = xlsx.utils.aoa_to_sheet(replacedDataArr, {});

  const addedPoLineRowCount = poLineCount - 1;
  const endRowNumber = trackInventory ? 24 : 23; // 입고 검수 확인란에 재고인 경우 한 줄 더 추가됨.

  newWorksheet["!cols"] = originWorksheet["!cols"];
  newWorksheet["!rows"] = expandedRowsInfo;
  newWorksheet["!merges"] = expandedMerges;

  // NOTE: 스타일 적용
  const rowsToBold = [5, 6, 7, 8, 13];
  const cellsToBold = [
    `B${15 + addedPoLineRowCount}`,
    ...getCellRangeArr(`M${20 + addedPoLineRowCount}`, `M${endRowNumber + addedPoLineRowCount}`),
  ];
  const cellsToFillGrey = [
    ...getCellRangeArr("B5", "C8"),
    ...getCellRangeArr("J5", "K8"),
    ...getCellRangeArr("B13", "Q13"),
  ];
  const cellsToBorder = [...getCellRangeArr("B5", "Q8"), ...getCellRangeArr("B13", `Q${17 + addedPoLineRowCount}`)];
  const cellsToStrongBorderTop = [
    ...getCellRangeArr("B5", "Q5"),
    ...getCellRangeArr("B13", "Q13"),
    ...getCellRangeArr(`M${20 + addedPoLineRowCount}`, `Q${endRowNumber + addedPoLineRowCount}`),
  ];
  const cellsToStrongBorderBottom = [
    ...getCellRangeArr("B8", "Q8"),
    ...getCellRangeArr(`B${17 + addedPoLineRowCount}`, `Q${17 + addedPoLineRowCount}`),
    ...getCellRangeArr(`M${endRowNumber + addedPoLineRowCount}`, `Q${endRowNumber + addedPoLineRowCount}`),
  ];
  const cellsToStrongBorderLeft = [
    ...getCellRangeArr("B5", "B8"),
    ...getCellRangeArr("J5", "J8"),
    ...getCellRangeArr("B13", `B${17 + addedPoLineRowCount}`),
    ...getCellRangeArr(`M${20 + addedPoLineRowCount}`, `N${endRowNumber + addedPoLineRowCount}`),
  ];
  const cellsToStrongBorderRight = [
    ...getCellRangeArr("Q5", "Q8"),
    ...getCellRangeArr("Q13", `Q${17 + addedPoLineRowCount}`),
    ...getCellRangeArr(`Q${20 + addedPoLineRowCount}`, `Q${endRowNumber + addedPoLineRowCount}`),
  ];

  for (const cell in newWorksheet) {
    if (typeof newWorksheet[cell] != "object") {
      continue;
    }

    const currentCell = newWorksheet[cell];
    const matchedNumberArr = cell.match(/\d+/);
    const rowNumber = !utils.isEmpty(matchedNumberArr) && parseInt(matchedNumberArr[0], 10);
    applyNumberCellFormat(currentCell);

    const isTitleCell = rowNumber === 2;

    const commonCellStyle = {
      ...defaultExcelCellStyle,
      font: { ...defaultExcelCellStyle.font, sz: 20 },
      border: {},
    };
    let cellStyle: { [key: string]: any } = { ...commonCellStyle };
    if (rowsToBold.includes(rowNumber) || cellsToBold.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
    }
    if (isTitleCell) {
      cellStyle = applyXlsxCellStyle({ bold: true, fontSize: 50 }, cellStyle);
    }
    if (cellsToFillGrey.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ fillColor: "ECECEC" }, cellStyle);
    }
    if (cellsToBorder.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ border: { directions: ["top", "bottom", "left", "right"] } }, cellStyle);
    }
    if (cellsToStrongBorderTop.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: ["top"] } }, cellStyle);
    }
    if (cellsToStrongBorderBottom.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: ["bottom"] } }, cellStyle);
    }
    if (cellsToStrongBorderLeft.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: ["left"] } }, cellStyle);
    }
    if (cellsToStrongBorderRight.includes(cell)) {
      cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: ["right"] } }, cellStyle);
    }
    currentCell.s = cellStyle;
  }

  xlsx.utils.book_append_sheet(newWorkbook, newWorksheet, "거래명세서");

  // 데이터 추가 및 스타일 적용
  const poLine = poLines[0];
  const orderUser = poLine.orderLine?.order.user;
  // 위탁인 경우에 존재. orderLine의 배송지 주소.
  const poLineAddress = poLine.shippingAddress;
  const getPostFix = () => {
    if (isB2b) {
      return `${orderUser.bizRegCorpName}(${poLineAddress.postalCode})`;
    }
    return trackInventory ? vendor.name : `${vendor.name}_${orderUser.bizRegCorpName}(${poLineAddress.postalCode})`;
  };
  const postFix = getPostFix();
  const xlsxFileName = postFix
    ? `거래명세서_${postFix}_${moment().format(fileNameDateFormat)}.xlsx`
    : `거래명세서_${moment().format(fileNameDateFormat)}.xlsx`;
  return { workBook: newWorkbook, title: xlsxFileName };
};

interface IPoLinesGroupedByUser {
  [userIdWithAddressId: string]: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
}
interface IPoLinesGroupedByVendor {
  [vendorId: string]: PurchaseOrderLineList_purchaseOrderLines_edges_node[] | IPoLinesGroupedByUser;
}
// === 발주 품목을 협력사별(위탁인 경우엔 협력사별 + 유저 & 납품장소별)로 그룹화 유틸
export const makeGroupedPoLinesForPoInvoiceDownload = ({
  poLines,
  trackInventory,
  user,
}: {
  poLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  trackInventory: boolean;
  user: User;
}): IPoLinesGroupedByVendor => {
  const poLinesSortedByPurchaseDate = [...poLines].sort((a, b) => moment(a.purchaseDate).diff(moment(b.purchaseDate)));

  // 리우 관리자 페이지에서 대행 출력할 경우, 각 발주 품목의 협력사가 다를 수 있으므로 협력사 별로 묶어서 별도 파일로 출력
  const isVendorStaff = user.isVendorStaff;
  const groupedPoLinesByVendor = isVendorStaff
    ? {
        [user.vendor.id]: poLinesSortedByPurchaseDate,
      }
    : poLinesSortedByPurchaseDate.reduce<{
        [vendorId: string]: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
      }>((acc, poLine) => {
        const vendorId = poLine.purchaseOrder.vendor.id;
        if (acc[vendorId]) {
          acc[vendorId].push(poLine);
        } else {
          acc[vendorId] = [poLine];
        }
        return acc;
      }, {});

  if (trackInventory) {
    return groupedPoLinesByVendor;
  } else {
    const groupedPoLinesByVendorAndUser: IPoLinesGroupedByVendor = {};
    Object.entries(groupedPoLinesByVendor).forEach(async ([vendorId, poLinesByVendor]) => {
      // 위탁 거래명세서인 경우, 주문한 매장 & 같은 배송지 별로 묶어서 별도 파일로 출력
      const groupedPoLinesByUser = poLinesByVendor.reduce<IPoLinesGroupedByUser>((acc, poLine) => {
        const userId = poLine.orderLine?.order.user.id;
        const postalCode = poLine.shippingAddress?.postalCode;
        if (utils.isEmpty(userId) || utils.isEmpty(postalCode)) {
          return acc;
        }
        const groupKey = `${userId}_${postalCode}`;
        if (acc[groupKey]) {
          acc[groupKey].push(poLine);
        } else {
          acc[groupKey] = [poLine];
        }
        return acc;
      }, {});

      groupedPoLinesByVendorAndUser[vendorId] = groupedPoLinesByUser;
    });

    return groupedPoLinesByVendorAndUser;
  }
};

// === 발주 품목 그룹별로 거래명세서 파일 정보 생성
export const generatePoInvoiceExcelInfoList = async ({
  poLines,
  trackInventory,
  user,
  isB2b,
}: {
  poLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  trackInventory: boolean;
  user: User;
  isB2b: boolean;
}): Promise<IExcelDownloadByWorkBookProps[]> => {
  const result: IExcelDownloadByWorkBookProps[] = [];
  const templateVersion = "20260113-00";
  const templateFileUrl = `${s3TemplateUrl}/purchase_order_invoice_${templateVersion}.xlsx`;

  // s3에 업로드 되어 있는 발주서 양식 파일 가져오기
  const response = await fetch(templateFileUrl);
  const arrayBuffer = await response.arrayBuffer();
  const data = new Uint8Array(arrayBuffer);

  // 가져온 파일 양식을 그대로 출력하는 것이 아니라, 값 대체 + 스타일 별도 적용(스타일 정보까지 못 가져오기 때문)하여 다운로드 처리
  const originWorkbook = xlsx.read(data, { type: "array", cellStyles: true });
  const originWorksheet = originWorkbook.Sheets[trackInventory ? "stock" : isB2b ? "b2b" : "consignment"];

  const groupedPoLines = makeGroupedPoLinesForPoInvoiceDownload({ poLines, trackInventory, user });
  Object.entries(groupedPoLines).forEach(async ([_vendorId, poLinesByVendor]) => {
    if (Array.isArray(poLinesByVendor)) {
      const vendorForPrint = user.isVendorStaff ? user.vendor : poLinesByVendor[0].purchaseOrder.vendor;
      const res = await generateExcelInfoByGroup({
        originWorksheet,
        trackInventory: true,
        poLines: poLinesByVendor,
        vendor: vendorForPrint,
        isB2b,
      });
      result.push(res);
    } else {
      Object.entries(poLinesByVendor).forEach(async ([_userIdWithAddressId, poLinesByUser]) => {
        const vendorForPrint = user.isVendorStaff ? user.vendor : poLinesByUser[0].purchaseOrder.vendor;
        const res = await generateExcelInfoByGroup({
          originWorksheet,
          trackInventory: false,
          poLines: poLinesByUser,
          vendor: vendorForPrint,
          isB2b,
        });
        result.push(res);
      });
    }
  });

  return result;
};

// === 그룹별로 생성된 발주 품목의 거래명세서 파일을 실제로 출력
export const onPurchaseOrderInvoiceExcelDownload = async (
  poLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[],
  routeParams: Pick<PurchaseOrderLineListViewRouteParams, "inventoryType">,
  user: User,
  isB2b: boolean
): Promise<boolean> => {
  try {
    const trackInventory = routeParams.inventoryType === "track-inventory";
    const excelDownloadPropsList = await generatePoInvoiceExcelInfoList({ poLines, trackInventory, user, isB2b });
    excelDownloadPropsList.forEach((props) => excelDownloadByWorkBook(props));
    return true;
  } catch {
    return false;
  }
};

export const getPurchaseOrderLineListDefaultParams = (
  routeParams: PurchaseOrderLineListViewRouteParams
): PurchaseOrderLineListViewUrlQueryParams => ({
  eventType: getPoEventTypeFromPoLineRouteParams(routeParams),
  status: getVsPoLineStatusFromPoLineRouteParams(routeParams),
});

export const getVsPurchaseListDefaultParams = (
  routeParams: VsPurchaseListViewRouteParams,
  isB2b: boolean
): PurchaseListViewUrlQueryParams => {
  const { status } = routeParams;
  const commonParams: PurchaseListViewUrlQueryParams = {
    status: getStatusFilterVariableFromVsPurchaseRouteParams(routeParams),
    type: getPurchaseTypeFilterVariablesFromPurchaseRouteParams(routeParams, isB2b),
  };

  switch (status) {
    case "pending":
      // 오늘 날짜가 1~10일이면 이전 달, 그렇지 않으면 이번 달을 기본값으로 사용
      const todayMoment = moment();
      const thisMonth = moment().format(onlyMonthFormat);
      const lastMonth = moment().subtract(1, "month").format(onlyMonthFormat);
      const defaultPurchaseCloseMonth = todayMoment.date() <= 10 ? lastMonth : thisMonth;
      return { ...commonParams, purchaseCloseMonth: defaultPurchaseCloseMonth };
    default:
      return { ...commonParams };
  }
};
