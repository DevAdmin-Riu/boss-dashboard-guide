  const isReqSplitDeliveryStatus = status === PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY;
  const isCompleteDeliveryStatus = status === PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY;
  const isInspectStatus = status === PurchaseOrderLineUrlEnum.INSPECT;
