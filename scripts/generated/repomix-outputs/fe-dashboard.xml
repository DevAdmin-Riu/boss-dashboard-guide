<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderManageHistory.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import { makeStyles } from "@material-ui/core/styles";
import Typography from "@material-ui/core/Typography";
import { PurchaseOrderManageEventType } from "@src/api/types/globalTypes";
import Form from "@src/app/components/Form";
import Hr from "@src/app/components/Hr";
import Skeleton from "@src/app/components/Skeleton";
import Timeline, { TimelineAddNote } from "@src/app/components/Timeline/Timeline";
import TimelineNote from "@src/app/components/Timeline/TimelineNote";
import { makeVendorDisplayName } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import {
  PurchaseOrderDetails_purchaseOrder_events,
  PurchaseOrderDetails_purchaseOrder_lines,
} from "../api/types/PurchaseOrderDetails";
import { getOldPurchaseOrderStatusText, getPurchaseOrderLineStatusText } from "../utils";

interface FormData {
  message: string;
}

interface TConsignmentVendorUpdatedInfo {
  vendor: {
    code: string;
    name: string;
  };
  purchase_date: string;
  unit_cost_price_exclude_vat: number;
}
export interface TConsignmentVendorUpdatedParams {
  order_line: string;
  sku: string;
  before: TConsignmentVendorUpdatedInfo;
  after: TConsignmentVendorUpdatedInfo;
}

const getEventMessage = (
  event: PurchaseOrderDetails_purchaseOrder_events,
  lines: PurchaseOrderDetails_purchaseOrder_lines[]
) => {
  const parameters = utils.jsonParseWrapper(event?.parameters) || {};
  const message = parameters?.message ? parameters?.message : "-";

  // 백엔드에서 제거된 상태: FULLY_STOCKED, STATUS_UPDATED, STOCK_STATUS_UPDATED - 이전 데이터엔 존재하므로 내역에 표시는 함
  switch (event.type) {
    case PurchaseOrderManageEventType.CREATED:
      return "발주서 등록";
    case PurchaseOrderManageEventType.SENT:
      return "발주서 발송";
    case PurchaseOrderManageEventType.UPDATED:
      return `발주서 수정: ${message}`;
    case PurchaseOrderManageEventType.COPIED:
      return `발주서 복사: ${message}`;
    case PurchaseOrderManageEventType.LINE_SENT:
      return `발주 제품 발송: ${message}`;
    case PurchaseOrderManageEventType.RECEIVED:
      return `발주 제품 접수: ${message}`;
    case PurchaseOrderManageEventType.APPROVE_REQ_EPD_UPDATE:
      return `납품예정일 변경 요청 승인: ${message}`;
    case PurchaseOrderManageEventType.DELIVERY_CONFIRMED:
      return `발주 제품 배송 확정: ${message}`;
    case PurchaseOrderManageEventType.INVOICE_PRINTED:
      return `거래명세서 출력: ${message}`;
    case PurchaseOrderManageEventType.TO_BE_INSPECTED:
      return `검수 대기: ${message}`;
    case PurchaseOrderManageEventType.INSPECTED:
      return `검수 완료: ${message}`;
    case PurchaseOrderManageEventType.DELIVERED:
      return `발주 제품 배송 완료: ${message}`;
    case PurchaseOrderManageEventType.CANCELED:
      return `발주 제품 취소: ${message}`;
    case PurchaseOrderManageEventType.REJECTED:
      return utils.formatMessage(
        "발주 제품 거부" + "\n------------------------------------" + "\n발주상세번호: {message}" + "\n사유: {reason}",
        {
          message,
          reason: parameters?.reason || "-",
        }
      );
    case PurchaseOrderManageEventType.REQ_EPD_UPDATE:
      return utils.formatMessage(
        "납품예정일 변경 요청" +
          "\n------------------------------------" +
          "\n[발주상세번호:납품예정일]: {message}" +
          "\n사유: {reason}",
        {
          message,
          reason: parameters?.reason || "-",
        }
      );
    case PurchaseOrderManageEventType.REQ_SPLIT_DELIVERY:
      return utils.formatMessage(
        "분납 요청" +
          "\n------------------------------------" +
          "\n[납품예정일:납품수량:메모]: {message}" +
          "\n사유: {reason}",
        {
          message,
          reason: parameters?.reason || "-",
        }
      );
    case PurchaseOrderManageEventType.APPROVE_REQ_SPLIT_DELIVERY:
      return utils.formatMessage(
        "분납 요청 승인" +
          "\n------------------------------------" +
          "\n[납품예정일:납품수량:메모]: {message}" +
          "\n사유: {reason}",
        {
          message,
          reason: parameters?.reason || "-",
        }
      );
    case PurchaseOrderManageEventType.STATUS_UPDATED:
      const status = parameters?.status ? parameters?.status : "-";
      const statusText = getOldPurchaseOrderStatusText(status);
      return `발주서 상태 변경: ${statusText}`;
    case PurchaseOrderManageEventType.STOCKED:
      return `발주 제품 입고: ${message}`;
    case PurchaseOrderManageEventType.FULLY_STOCKED:
      return "발주 제품 전체 입고 완료";
    case PurchaseOrderManageEventType.VENDOR_ORDERED:
      return "위탁 발주서 협력사 주문 완료";
    case PurchaseOrderManageEventType.FULFILLED:
      return "발주 제품 출고 처리";
    case PurchaseOrderManageEventType.STOCK_STATUS_UPDATED:
      const getPoLineStockStatusText = (status: "BEFORE_STOCKED" | "BEING_STOCKED" | "COMPLETE_STOCKED" | "NA") => {
        switch (status) {
          case "BEFORE_STOCKED":
            return "대기";
          case "BEING_STOCKED":
            return "부분 입고";
          case "COMPLETE_STOCKED":
            return "완료";
          case "NA":
            return "-";
        }
      };
      const beforeText = getPoLineStockStatusText(parameters.before);
      const afterText = getPoLineStockStatusText(parameters.after);
      return `발주 제품 입고 상태 변경: ${beforeText} → ${afterText} (${parameters.sku})`;
    case PurchaseOrderManageEventType.CONSIGNMENT_VENDOR_UPDATED:
      const { order_line, sku, before, after }: TConsignmentVendorUpdatedParams = parameters;
      const updatedLine = lines.find((line) => line.orderLine.composedIdWithPrefix.includes(order_line));
      const filledSortOrder = utils.fillZero(updatedLine.sortOrder, 3);
      return utils.formatMessage(
        "출고 완료된 {sortOrder}번 제품의 발주 정보 변경" +
          "\n------------------------------------" +
          "\n주문상세번호: {orderLineComposedIdWithPrefix}" +
          "\n제품코드: {sku}" +
          "\n" +
          "\n매입일: {beforePurchaseDate} -> {afterPurchaseDate}" +
          "\n협력사: {beforeVendor} -> {afterVendor}" +
          `\n매입단가${commonMsg.excludeVat}: {beforeUnitCostPriceExcludeVat} -> {afterUnitCostPriceExcludeVat}`,
        {
          sortOrder: filledSortOrder,
          orderLineComposedIdWithPrefix: order_line,
          sku,
          beforeVendor: makeVendorDisplayName(before.vendor),
          afterVendor: makeVendorDisplayName(after.vendor),
          beforeUnitCostPriceExcludeVat: utils.toMoneyText(before.unit_cost_price_exclude_vat),
          afterUnitCostPriceExcludeVat: utils.toMoneyText(after.unit_cost_price_exclude_vat),
          beforePurchaseDate: before.purchase_date,
          afterPurchaseDate: after.purchase_date,
        }
      );
    case PurchaseOrderManageEventType.REVERTED: {
      const { after_status, before_status, message } = parameters;
      const beforeText = getPurchaseOrderLineStatusText(before_status);
      const afterText = getPurchaseOrderLineStatusText(after_status);

      return utils.formatMessage(
        "{beforeText} 상태 -> {afterText} 상태 이전으로 변경" +
          "\n------------------------------------" +
          "\n발주상세번호: {message}",
        {
          message,
          beforeText,
          afterText,
        }
      );
    }
    default:
      return message;
  }
};

const useStyles = makeStyles(
  (theme) => ({
    header: {
      fontWeight: 500,
      marginBottom: theme.spacing(1),
    },
    root: { marginTop: theme.spacing(4) },
    user: {
      marginBottom: theme.spacing(1),
    },
  }),
  { name: "PurchaseOrderManageHistory" }
);

interface PurchaseOrderManageHistoryProps {
  history: PurchaseOrderDetails_purchaseOrder_events[];
  lines: PurchaseOrderDetails_purchaseOrder_lines[];
  onNoteAdd: (data: FormData) => void;
}

export const PurchaseOrderManageHistory: React.FC<PurchaseOrderManageHistoryProps> = (props) => {
  const { history, lines, onNoteAdd } = props;
  const classes = useStyles(props);

  return (
    <div className={classes.root}>
      <Typography className={classes.header} color="textSecondary">
        발주서 관리 내역
      </Typography>
      <Hr />
      {history ? (
        <Timeline>
          <Form initial={{ message: "" }} onSubmit={onNoteAdd} resetOnSubmit>
            {({ change, data, reset, submit }) => (
              <TimelineAddNote message={data.message} reset={reset} onChange={change} onSubmit={submit} />
            )}
          </Form>
          {history
            .slice()
            .reverse()
            .map((event) => (
              <TimelineNote
                date={event.date}
                user={event.user}
                message={getEventMessage(event, lines)}
                key={event.id}
              />
            ))}
        </Timeline>
      ) : (
        <Skeleton />
      )}
    </div>
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderProductNoteQueryModal.tsx">
import { utils } from "@utils/utils";
import { Button, Modal, Space, Typography } from "antd";
import React from "react";

import { PurchaseOrderDetails_purchaseOrder_lines } from "../api/types/PurchaseOrderDetails";
import { IPurchaseOrderCreateLine } from "./PurchaseOrderCreatePage/PurchaseOrderCreatePage";

type TPoLineForNote = PurchaseOrderDetails_purchaseOrder_lines | IPurchaseOrderCreateLine;

interface PurchaseOrderProductNoteQueryModalProps {
  open: boolean;
  purchaseOrderLine: TPoLineForNote;
  onCancel: () => void;
}

const getPurchaseOrderProductNameWithSku = (poLine: TPoLineForNote) =>
  utils.isEmpty(poLine) ? "-" : `${poLine.variant.product.name || "제품명 없음"}(${poLine.variant.sku || "-"})`;

const renderVariantNoteWithLink = (variantNote: string) => {
  if (utils.isEmpty(variantNote, true)) {
    return <Typography.Text type={"warning"}>저장된 제품 메모가 없습니다.</Typography.Text>;
  }

  const urls = utils.findValidUrls(variantNote);
  if (utils.isEmpty(urls)) {
    return <Typography.Text>{variantNote}</Typography.Text>;
  }

  const url = urls[0];
  const [textBeforeUrl, textAfterUrl] = variantNote.split(url);
  return (
    <>
      <Typography.Text>{textBeforeUrl}</Typography.Text>
      <Typography.Link href={url} target={"_blank"} rel={"noopener noreferrer"}>
        {url}
      </Typography.Link>
      <Typography.Text>{textAfterUrl}</Typography.Text>
    </>
  );
};

export const PurchaseOrderProductNoteQueryModal: React.FC<PurchaseOrderProductNoteQueryModalProps> = ({
  open,
  purchaseOrderLine,
  onCancel,
}) => {
  const productVariantNameWithSku = getPurchaseOrderProductNameWithSku(purchaseOrderLine);
  const selectedProductVariant = purchaseOrderLine?.variant;

  const modalFooter = (
    <Button type={"default"} onClick={onCancel}>
      뒤로
    </Button>
  );

  return (
    <Modal destroyOnClose title={"제품 메모 (내부용)"} open={open} footer={modalFooter} onCancel={onCancel}>
      <Space direction={"vertical"}>
        <Typography.Text strong>{productVariantNameWithSku}:</Typography.Text>
        {renderVariantNoteWithLink(selectedProductVariant?.note)}
      </Space>
    </Modal>
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderStockCheckModal.tsx">
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ConfirmModal from "@src/app/components/ConfirmModal";
import NumberComponent from "@src/app/components/Number";
import { DateTime } from "@src/app/providers/DateProvider";
import { ProductVariantListToAdd_productVariants_edges_node } from "@src/app/views/product/products/api/types/ProductVariantListToAdd";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { getExpDateStatusTag } from "@src/app/views/product/stock/utils";
import { transformIsInner } from "@utils/misc";
import { Descriptions, Table, Typography } from "antd";
import React from "react";

import { IPurchaseOrderCreateLine } from "./PurchaseOrderCreatePage/PurchaseOrderCreatePage";

interface PurchaseOrderStockCheckModalProps {
  open: boolean;
  selectedLine: IPurchaseOrderCreateLine | null;
  deliveryWarehouseName: string;
  onOk: () => void;
  onCancel: () => void;
}

export const PurchaseOrderStockCheckModal: React.FC<PurchaseOrderStockCheckModalProps> = ({
  open,
  selectedLine,
  deliveryWarehouseName,
  onOk,
  onCancel,
}) => {
  const variant = selectedLine?.variant as ProductVariantListToAdd_productVariants_edges_node;

  return (
    <ConfirmModal
      modalTitleText="재고 위치 확인"
      visible={open}
      titleText={null}
      helpText={null}
      isContentNodeDivider={false}
      okText="네"
      cancelText="아니오"
      onOk={onOk}
      onCancel={onCancel}
      width={1200}
      maskClosable={false}
      contentNode={
        <>
          <Typography.Title level={5}>제품정보({selectedLine?.variant?.sku})</Typography.Title>
          <Descriptions bordered size="small" column={2}>
            <Descriptions.Item label={columnNameConstant.product.PRODUCT_NAME} span={2}>
              {selectedLine?.variant?.product?.name || "-"}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.product.VARIANT_NAME} span={1}>
              {selectedLine?.variant?.name || "-"}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.product.IS_INNER} span={1}>
              {transformIsInner(variant?.isInner)}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.product.DETAIL_INFO} span={1}>
              {(() => {
                const variant = selectedLine?.variant;
                if (!variant) {
                  return "-";
                }
                const product = variant.product;
                const hasVariants = product?.productType?.hasVariants;
                const targetAttributes = hasVariants ? variant.attributes : product?.attributes;
                return makeProductSpecTextFromAttr(targetAttributes);
              })()}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.product.PRODUCT_QTY_PER_BOX} span={1}>
              {selectedLine?.variant ? makeProductQtyPerBoxText(selectedLine.variant) : "-"}
            </Descriptions.Item>
          </Descriptions>
          <Typography.Title level={5} style={{ marginTop: 16 }}>
            선택된 납품처
          </Typography.Title>
          <Descriptions bordered size="small" column={1}>
            <Descriptions.Item label="납품처">{deliveryWarehouseName || "-"}</Descriptions.Item>
          </Descriptions>
          <Typography.Title level={5} style={{ marginTop: 16 }}>
            재고가 있는 위치
          </Typography.Title>
          <Table
            size="small"
            bordered
            pagination={false}
            dataSource={
              variant?.rackStocks?.filter(
                (stock) => stock && stock.remainQuantity > 0 && stock.location?.sector?.address?.id
              ) || []
            }
            rowKey={(record) => record.id}
            columns={[
              {
                title: columnNameConstant.warehouse.WAREHOUSE_NAME,
                key: "warehouse",
                align: "center",
                width: 120,
                render: (_, record) => record.location?.sector?.address?.companyName || "-",
              },
              {
                title: columnNameConstant.stock.SECTOR,
                key: "sector",
                align: "center",
                width: 100,
                render: (_, record) => record.location?.sector?.name || "-",
              },
              {
                title: columnNameConstant.stock.LOCATION,
                key: "location",
                align: "center",
                width: 100,
                render: (_, record) => record.location?.name || "-",
              },
              {
                title: columnNameConstant.stock.STOCK_QUANTITY,
                key: "remainQuantity",
                align: "right",
                width: 80,
                render: (_, record) => <NumberComponent value={record.remainQuantity} />,
              },
              {
                title: columnNameConstant.purchaseOrder.STOCKED_DATE,
                key: "stockedAt",
                align: "center",
                width: 120,
                render: (_, record) => <DateTime date={record?.stockDetail?.stockedAt} onlyDate />,
              },
              {
                title: columnNameConstant.stock.EXP_DATE,
                key: "expDate",
                align: "center",
                width: 120,
                render: (_, record) =>
                  record.stockDetail?.expDate ? <DateTime date={record.stockDetail.expDate} /> : "-",
              },
              {
                title: columnNameConstant.stock.EXP_DATE_STATUS,
                key: "expDateStatus",
                align: "center",
                width: 100,
                render: (_, record) => getExpDateStatusTag(record.stockDetail?.expDateStatus),
              },
              {
                title: "매입가",
                key: "costPriceExcludeVat",
                align: "right",
                width: 100,
                render: (_, record) => <NumberComponent value={record.stockDetail?.costPriceExcludeVat} />,
              },
            ]}
          />
          <Typography.Text type="danger" style={{ marginTop: 4 }} strong>
            해당 제품은 납품처 이외의 물류센터에서 보관하는 제품입니다. 현재 물류센터로 발주를 진행하시겠습니까 ?
          </Typography.Text>
        </>
      }
    />
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderStockLinesAddModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { PurchaseOrderStockLineInput, PurchaseOrderStockLinesAddInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getMobileSelectClassName } from "@src/app/components/antd/Select/SelectProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import RequiredDotWrapper from "@src/app/components/Dot/RequiredDotWrapper";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { NumberComponent } from "@src/app/components/Number";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { ShopContext } from "@src/app/providers/ShopProvider";
import { getNumberFormat, getSalesUnitTypeText } from "@src/app/views/product/products/utils/data";
import {
  getUniqueRackLocationsByRackStocks,
  makeRackLocationLabel,
} from "@src/app/views/product/stock/components/ProductInfoForStockAction";
import { makeVendorDisplayName } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { DatePicker, Form, FormInstance, Input, InputNumber, Modal, Select, Space, Table, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import { ColumnsType } from "antd/lib/table";
import moment from "moment";
import React, { useContext } from "react";

import { usePurchaseOrderStockLinesAddMutation } from "../api/mutations";
import { purchaseOrderLineCountQuery, purchaseOrderLineListQuery } from "../api/queries";
import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../api/types/PurchaseOrderLineList";
import { makePurchaseOrderLineNumber } from "../utils";
import { PurchaseOrderLineListTableSettingsProps } from "./PurchaseOrderLineListPage/PurchaseOrderLineListTableSettings";

const { Text } = Typography;

// 재고 입고 모달 - 최종 확인 시 로케이션 이름을 표시하기 위해 폼으로 id와 함께 저장. 뮤테이션 호출 시 input 처리에서는 제외하고 호출해야 함.
interface PurchaseOrderStockLineForm extends PurchaseOrderStockLineInput {
  rackLocationName?: string;
}

export interface PurchaseOrderStockLinesAddForm extends PurchaseOrderStockLinesAddInput {
  lines: PurchaseOrderStockLineForm[];
}

interface PurchaseOrderStockAddModalProps {
  form: FormInstance<PurchaseOrderStockLinesAddForm>;
  open: boolean;
  purchaseOrderStockLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  poLineListTableSettingProps: PurchaseOrderLineListTableSettingsProps;
  onClose: () => void;
}

export const PurchaseOrderStockLinesAddModal: React.FC<PurchaseOrderStockAddModalProps> = ({
  form,
  open,
  purchaseOrderStockLines,
  poLineListTableSettingProps,
  onClose,
}) => {
  const shop = useContext(ShopContext);
  const formValues = form.getFieldsValue();
  const { stockedDate, lines } = formValues;
  const momentStockedDate = moment(stockedDate);
  const allowedOverstockingRate = parseInt(shop.siteSettingsPluginInfo.allowedOverstockingRate, 10) || 0;

  const columns: ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> = [
    {
      title: columnNameConstant.purchaseOrder.PO_NO,
      key: "purchaseOrderNumber",
      align: "center",
      width: 150,
      render: (_, record) => record.purchaseOrder.code,
    },
    {
      title: columnNameConstant.purchaseOrder.PO_LINE_NO,
      key: "code",
      align: "center",
      width: 150,
      render: (_, record) => makePurchaseOrderLineNumber(record),
    },
    {
      title: columnNameConstant.purchaseOrder.PO_DATE,
      key: "purchaseOrderDate",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.purchaseOrder?.purchaseOrderDate} onlyDate />,
    },
    {
      title: columnNameConstant.purchaseOrder.PO_AMOUNT,
      key: "quantity",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.quantity} />,
    },
    {
      title: columnNameConstant.purchaseOrder.PURCHASE_QTY,
      key: "purchaseQuantity",
      align: "right",
      width: 130,
      render: (_, record) => {
        const idx = lines?.findIndex((line) => line?.lineId === record.id);
        const salesUnitTypeText = getSalesUnitTypeText(record.variant.salesUnitType);

        return (
          <Form.Item
            style={{ margin: 0 }}
            name={[idx, "quantity"]}
            rules={[{ required: true, type: "integer", min: 1, message: formRuleMsg.min(1) }]}
          >
            <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} addonAfter={salesUnitTypeText} />
          </Form.Item>
        );
      },
    },
    {
      title: "입고 로케이션",
      key: "rackLocationName",
      align: "center",
      width: 300,
      render: (_, record) => {
        const idx = lines?.findIndex((line) => line?.lineId === record.id);
        const { selectedRowIds, stockLinesAddProps } = poLineListTableSettingProps;
        const { searchedRackLocations, fetchMoreRackLocations, searchRackLocations } = stockLinesAddProps;
        const isSelected = selectedRowIds.includes(record.id);
        const rackStocks = record.variant.rackStocks;
        const rackLocations = getUniqueRackLocationsByRackStocks(rackStocks);
        const uniqueRackLocations = [...rackLocations, ...searchedRackLocations].filter(
          (location, index, self) => index === self.findIndex((t) => t.id === location.id)
        );
        const locationOptions: DefaultOptionType[] = uniqueRackLocations.map((location) => {
          const rackStocksByLocation = rackStocks.filter((stock) => stock.location.id === location.id);
          const totalRemainQuantity = rackStocksByLocation.reduce((acc, stock) => acc + stock.remainQuantity, 0);
          return {
            label: makeRackLocationLabel(location, totalRemainQuantity, { direction: "vertical", size: 0 }),
            labelText: location.name,
            value: location.id,
          };
        });

        return (
          <>
            <Form.Item noStyle name={[idx, "rackLocation"]}>
              <Select
                showSearch
                size="small"
                style={{ width: "100%" }}
                {...getMobileSelectClassName()}
                disabled={!isSelected}
                loading={fetchMoreRackLocations.loading}
                dropdownMatchSelectWidth={false}
                placeholder="로케이션 선택"
                options={locationOptions}
                onSearch={searchRackLocations}
                onSelect={(_, option) => form.setFieldValue(["lines", idx, "rackLocationName"], option?.labelText)}
                onDropdownVisibleChange={(open) => {
                  if (open) {
                    searchRackLocations("");
                  }
                }}
                filterOption={(input, option) =>
                  typeof option?.labelText === "string" &&
                  (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())
                }
                onPopupScroll={({ currentTarget }) => {
                  const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                  const { hasMore, loading, onFetchMore } = fetchMoreRackLocations;
                  // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                  if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                    onFetchMore();
                  }
                }}
              />
            </Form.Item>
            <Form.Item noStyle name={[idx, "rackLocationName"]} hidden>
              <Input />
            </Form.Item>
            <Form.Item noStyle name={[idx, "lineId"]} hidden>
              <Input />
            </Form.Item>
          </>
        );
      },
    },
    {
      title: columnNameConstant.stock.EXP_DATE,
      key: "expDate",
      align: "center",
      width: 160,
      render: (_, record) => {
        const idx = lines?.findIndex((line) => line?.lineId === record.id);

        return (
          <RequiredDotWrapper required={record.variant.requiredExpDateMgmt} dotPosition="right">
            <Form.Item
              style={{ margin: 0 }}
              name={[idx, "expDate"]}
              rules={[
                { required: record.variant.requiredExpDateMgmt, type: "date", message: formRuleMsg.requiredSelect },
              ]}
            >
              <DatePicker style={{ width: "100%" }} prevIcon />
            </Form.Item>
          </RequiredDotWrapper>
        );
      },
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.productSku,
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 150,
      render: (_, record) => (
        <Text style={{ width: 150 }} ellipsis={{ tooltip: record.productName }}>
          {record.productName}
        </Text>
      ),
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendor",
      align: "left",
      width: 150,
      render: (_, record) => makeVendorDisplayName(JSON.parse(record.purchaseOrder?.vendorData)),
    },
    {
      title: "매입가",
      key: "costPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.costPriceExcludeVat} includeCurrency />,
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const okText = "입고 완료";

  const [purchaseOrderStockLinesAdd, purchaseOrderStockLinesAddOpts] = usePurchaseOrderStockLinesAddMutation({
    onCompleted: (data) => {
      const errors = data?.purchaseOrderStockLinesAdd?.errors;
      if (errors?.length > 0) {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
  });

  const validateFormData = (formData: PurchaseOrderStockLinesAddForm) => {
    const { stockedDate, lines } = formData;
    if (utils.isEmpty(stockedDate)) {
      showNotificationError("입고일을 선택해주시기 바랍니다.");
      return false;
    }

    const purchaseOrderDateErrorElements = [];
    const warehouseErrorElements = [];
    const negativeSubPvStockQtyErrorElements = [];
    const rackLocationErrorElements = [];
    const qtyErrorElements = [];
    const overstockQtyErrorElements = [];

    // 선택된 테이블 로우(입고 대기 리스트)에 대한 validate 체크
    for (const selectedRow of purchaseOrderStockLines) {
      const purchaseOrderDate = selectedRow.purchaseOrder?.purchaseOrderDate;
      const purchaseOrderCode = selectedRow.purchaseOrder?.code;
      const variant = selectedRow.variant;
      const productNameWithSku = `${selectedRow.productName}(${selectedRow.productSku})`;
      const isExternalWarehouseDelivery = utils.isEmpty(selectedRow.purchaseOrder?.warehouse);
      // 제품의 재고가 연동된 물류센터 존재 여부
      const hasWarehouse =
        !utils.isEmpty(selectedRow.purchaseOrder?.warehouse) &&
        variant?.stocks.filter((stock) => stock?.warehouse?.id === selectedRow.purchaseOrder.warehouse?.id)?.length > 0;
      const warehouseName = selectedRow.purchaseOrder?.deliveryWarehouseName;
      if (stockedDate?.isBefore(moment(purchaseOrderDate))) {
        const codeWithDate = `${purchaseOrderCode}:${purchaseOrderDate}`;
        if (purchaseOrderDateErrorElements.indexOf(codeWithDate) === -1) {
          purchaseOrderDateErrorElements.push(codeWithDate);
        }
      }
      if (!isExternalWarehouseDelivery && !hasWarehouse) {
        warehouseErrorElements.push(`${warehouseName}:${productNameWithSku}`);
      }
      // 해당 제품이 물류센터가 연동되어 있는 경우, 부자재 제품의 재고가 음수인 경우 입고 처리 불가(재고 조정 페이지에서 음수 재고 조정 이후 입고 처리 가능)
      if (variant.isSubPv) {
        const subPvStock = variant.stocks.find(
          (stock) => stock.warehouse.id === selectedRow.purchaseOrder.warehouse.id
        );
        if (subPvStock?.quantity < 0) {
          negativeSubPvStockQtyErrorElements.push(productNameWithSku);
        }
      }
      // 해당 제품이 물류센터가 연동되어 있는 경우, 로케이션 선택 필수
      const selectedLineForm = lines?.find((line) => line.lineId === selectedRow.id);
      if (hasWarehouse && utils.isEmpty(selectedLineForm?.rackLocation)) {
        rackLocationErrorElements.push(productNameWithSku);
      }
      // 입고 수량은 0 이하로 입력 불가
      const formQuantity = selectedLineForm?.quantity;
      if (utils.isEmpty(formQuantity) || formQuantity <= 0) {
        qtyErrorElements.push(productNameWithSku);
      } else {
        // 입고하려는 수량(납품 수량) > 발주 수량 * (100 + allowedOverstockingRate) / 100 이면 에러(소수점은 버림)
        const availableStockQty = Math.floor((selectedRow.quantity * (100 + allowedOverstockingRate)) / 100);
        const overstockedQty = formQuantity - availableStockQty;
        if (overstockedQty > 0) {
          const poLineNumber = makePurchaseOrderLineNumber(selectedRow);
          overstockQtyErrorElements.push(
            `${poLineNumber}/${selectedRow.productSku}/${getNumberFormat(availableStockQty)}`
          );
        }
      }
    }

    if (purchaseOrderDateErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "입고일은 발주일 이전으로 선택할 수 없습니다.(발주서 번호:발주일)",
            `[ ${purchaseOrderDateErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }
    if (warehouseErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "납품 장소에 미연동 된 제품은 입고 처리가 불가합니다.(납품 장소:제품명(제품코드))",
            `[ ${warehouseErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }
    if (negativeSubPvStockQtyErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "부자재가 음수 재고인 상태에서는 재고 조정 처리 후 입고 처리하세요.(제품명(제품코드))",
            `[ ${negativeSubPvStockQtyErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }
    if (rackLocationErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "입고 처리를 위해 제품의 로케이션을 선택해주시기 바랍니다.(제품명(제품코드))",
            `[ ${rackLocationErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }
    if (qtyErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "납품 수량(입고 수량)은 0 이하로 입력할 수 없습니다.(제품명(제품코드))",
            `[ ${qtyErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }
    if (overstockQtyErrorElements.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            `납품 수량(입고 수량)이 발주 수량의 ${allowedOverstockingRate}%를 초과할 수 없습니다.(발주상세번호/제품코드/최대 가능 수량)`,
            `[ ${overstockQtyErrorElements.join(", ")} ]`,
          ]}
        />
      );
      return false;
    }

    return true;
  };

  const onSubmit = async () => {
    const formData = form.getFieldsValue();
    const isValid = validateFormData(formData);
    if (!isValid) {
      return;
    }

    const { stockedDate, lines } = formData;
    // 실제 테이블에 표시된 입고 대기 리스트 정보
    const purchaseOrderIdArr = purchaseOrderStockLines.map((line) => line.purchaseOrder.id);
    const uniquePurchaseOrderIds = purchaseOrderIdArr.filter((value, idx) => purchaseOrderIdArr.indexOf(value) === idx);
    const failedElements = [];
    const successElements = [];

    // 입고일 포맷 변경
    const stockedDateInput = moment(stockedDate).format(onlyDateFormat);

    // 같은 발주서에 대한 제품들을 묶어서 입고 처리
    for (const purchaseOrderId of uniquePurchaseOrderIds) {
      // 폼 데이터에는 뮤테이션 호출을 위한 input 정보 외에 입고 대기 리스트(purchaseOrderLine)의 정보가 없으므로, 실제 테이블에 표시된 입고 대기 리스트 정보를 참조하여 필터링
      const linesByPurchaseOrder = purchaseOrderStockLines?.filter((line) => line.purchaseOrder.id === purchaseOrderId);
      const lineIdsByPurchaseOrder = linesByPurchaseOrder.map((line) => line.id);
      const linesInput: PurchaseOrderStockLineInput[] = lines
        .filter((line) => lineIdsByPurchaseOrder?.includes(line.lineId))
        .map(({ lineId, quantity, rackLocation, expDate }) => ({
          lineId,
          quantity,
          rackLocation,
          expDate: expDate ? getDateByFormat(expDate, onlyDateFormat) : null,
        }));
      const stockAddInput: PurchaseOrderStockLinesAddInput = {
        stockedDate: stockedDateInput,
        lines: linesInput,
      };
      const { data } = await purchaseOrderStockLinesAdd({
        variables: { id: purchaseOrderId, input: stockAddInput },
      });
      const errors = data?.purchaseOrderStockLinesAdd?.errors || [];
      const skuList = linesByPurchaseOrder?.map((line) => line.productSku);
      if (errors.length > 0) {
        // 뮤테이션이 실패한 경우엔 data.purchaseOrderStockLinesAdd.purchaseOrder가 null로 리턴되기 때문에 실패한 제품들의 발주서 코드를 찾기 위해 실제 테이블에 표시된 정보를 참조
        const purchaseOrderCode = linesByPurchaseOrder[0].purchaseOrder.code;
        const codeWithSkuList = `${purchaseOrderCode}(${skuList?.join(", ")})`;
        failedElements.push(codeWithSkuList);
      } else {
        const purchaseOrderCode = data.purchaseOrderStockLinesAdd?.purchaseOrder?.code;
        const codeWithSkuList = `${purchaseOrderCode}(${skuList?.join(", ")})`;
        successElements.push(codeWithSkuList);
      }
    }

    if (successElements.length > 0) {
      showNotificationSuccess(
        <MultiLineTypography lines={["입고 처리 성공(발주서 코드(제품코드))", `[ ${successElements.join(", ")} ]`]} />
      );
    }
    if (failedElements.length > 0) {
      showNotificationError(
        <MultiLineTypography lines={["입고 처리 실패(발주서 코드(제품코드))", `[ ${failedElements.join(", ")} ]`]} />
      );
    } else {
      onClose();
    }
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="입고 완료"
      open={open}
      width={1000}
      okText={okText}
      confirmLoading={purchaseOrderStockLinesAddOpts.loading}
      onOk={onSubmit}
      onCancel={onClose}
    >
      <Space direction="vertical" size="large">
        <MultiLineTypography
          lines={[
            <Text type="danger">아래 입고 정보를 확인한 뒤 [{okText}]를 진행해 주세요.</Text>,
            <Text type="danger">입고 로케이션 및 입고 수량을 잘못 지정했다면 수정할 수 있습니다.</Text>,
            <Text strong type="danger">
              * [{okText}] 시에는 해당 발주제품의 입고를 완료해 재고 입고 리스트에서 제거됩니다.
            </Text>,
          ]}
        />

        <Space direction={"vertical"} size={0}>
          <Text strong>입고일</Text>
          <Typography>{momentStockedDate.isValid() ? momentStockedDate.format(onlyDateFormat) : "-"}</Typography>
        </Space>

        <Space direction="vertical" size={0}>
          <Text strong>입고정보</Text>
          <Form.List name="lines">
            {() => (
              <Table
                {...commonTableProps}
                columns={columns}
                dataSource={purchaseOrderStockLines}
                scroll={{ x: tableWidthSum, y: 400 }}
              />
            )}
          </Form.List>
        </Space>
      </Space>
    </Modal>
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/SeasonalCheckModal.tsx">
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ConfirmModal from "@src/app/components/ConfirmModal";
import NumberComponent from "@src/app/components/Number";
import { DateTime } from "@src/app/providers/DateProvider";
import { getAvailableQtyConsiderVirtualAlloc } from "@src/app/views/product/stock/utils";
import { Descriptions, Typography } from "antd";
import moment from "moment";
import React from "react";

import { IPurchaseOrderCreateLine } from "./PurchaseOrderCreatePage/PurchaseOrderCreatePage";

interface SeasonalCheckModalProps {
  open: boolean;
  selectedLine: IPurchaseOrderCreateLine | null;
  askingPurchaseDate: string | null;
  onOk: () => void;
  onCancel: () => void;
}

export const SeasonalCheckModal: React.FC<SeasonalCheckModalProps> = ({
  open,
  selectedLine,
  askingPurchaseDate,
  onOk,
  onCancel,
}) => {
  const formatPeakSeason = () => {
    if (!selectedLine?.variant?.peakSeasonStartDate || !selectedLine?.variant?.peakSeasonEndDate) {
      return "-";
    }
    const start = moment(selectedLine.variant.peakSeasonStartDate).format("M월 D일");
    const end = moment(selectedLine.variant.peakSeasonEndDate).format("M월 D일");
    return `${start} ~ ${end}`;
  };

  const formatLast30DaysAvg = () => {
    const value = selectedLine?.variant?.last30DaysAvgSalesDailyQty;
    return value != null ? value.toFixed(2) : "-";
  };

  return (
    <ConfirmModal
      modalTitleText="계절 제품"
      visible={open}
      titleText={null}
      helpText={null}
      maskClosable={false}
      contentNode={
        <>
          <Descriptions bordered size="small" column={2}>
            <Descriptions.Item label={columnNameConstant.product.SKU} span={1}>
              {selectedLine?.variant?.sku || "-"}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.purchaseOrder.ASKING_PO_DATE} span={1}>
              {askingPurchaseDate ? <DateTime date={askingPurchaseDate} onlyDate /> : "-"}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.purchaseOrder.PO_AMOUNT} span={1}>
              <NumberComponent value={selectedLine?.quantity} />
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.product.PEAK_SEASON} span={1}>
              {formatPeakSeason()}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.stock.LAST_PURCHASE_DATE} span={1}>
              {selectedLine?.variant?.lastStockedPoLine?.purchaseDate ? (
                <DateTime date={selectedLine.variant.lastStockedPoLine.purchaseDate} onlyDate />
              ) : (
                "-"
              )}
            </Descriptions.Item>
            <Descriptions.Item label={columnNameConstant.stock.LAST_PURCHASE_QTY} span={1}>
              <NumberComponent value={selectedLine?.variant?.lastStockedPoLine?.purchaseQuantity} />
            </Descriptions.Item>
            <Descriptions.Item label="현재고" span={1}>
              <NumberComponent value={getAvailableQtyConsiderVirtualAlloc(selectedLine?.variant)} />
            </Descriptions.Item>
            <Descriptions.Item label="최근 30일 일 평균 판매량" span={1}>
              {formatLast30DaysAvg()}
            </Descriptions.Item>
          </Descriptions>
          <Typography.Text type="danger" strong style={{ marginTop: 16, display: "block" }}>
            현재 해당 제품의 성수기 입니다. 현재 발주 수량대로 발주하시겠습니까?
          </Typography.Text>
        </>
      }
      okText="네"
      cancelText="아니오"
      onOk={onOk}
      onCancel={onCancel}
      width={650}
    />
  );
};
</file>

<file path="src/app/views/purchase/purchaseOrders/view/PurchaseOrderCreateView/filters.ts">
import { PurchaseOrderEventTypeFilter, PurchaseOrderFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  PurchaseOrderListForCreateFilterKeys,
  PurchaseOrderListForCreateFilterOpts,
} from "../../components/PurchaseOrderListForCreateTable/filters";
import {
  PurchaseOrderCreateViewUrlFilters,
  PurchaseOrderCreateViewUrlFiltersEnum,
  PurchaseOrderCreateViewUrlQueryParams,
} from "../../urls";

const PURCHASE_ORDER_LIST_FOR_CREATE_FILTER_KEYS = "purchaseOrderListForCreateFilters";

export function getFilterOpts(params: PurchaseOrderCreateViewUrlFilters): PurchaseOrderListForCreateFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    purchaseOrderDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseOrderDate.gte, filterVariables.purchaseOrderDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseOrderDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.purchaseOrderDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    purchaseOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.purchaseOrderSearch, true), false),
      value: filterVariables.purchaseOrderSearch || "",
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: filterVariables.vendorSearch || "",
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
  };
}

export function getFilterVariables(params: PurchaseOrderCreateViewUrlFilters): PurchaseOrderFilterInput {
  return {
    eventType: [PurchaseOrderEventTypeFilter.INITIAL_ORDER, PurchaseOrderEventTypeFilter.REORDER],
    isSent: true,
    purchaseOrderDate: getGteLteVariables({
      gte: params.purchaseOrderDateFrom,
      lte: params.purchaseOrderDateTo,
    }),
    purchaseOrderSearch: params.purchaseOrderSearch,
    vendorSearch: params.vendorSearch,
    productSearch: params.productSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<PurchaseOrderListForCreateFilterKeys>
): PurchaseOrderCreateViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case PurchaseOrderListForCreateFilterKeys.purchaseOrderDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseOrderCreateViewUrlFiltersEnum.purchaseOrderDateFrom,
        PurchaseOrderCreateViewUrlFiltersEnum.purchaseOrderDateTo
      );
    case PurchaseOrderListForCreateFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, PurchaseOrderCreateViewUrlFiltersEnum.productSearch);
    case PurchaseOrderListForCreateFilterKeys.purchaseOrderSearch:
      return getSingleValueQueryParam(filter, PurchaseOrderCreateViewUrlFiltersEnum.purchaseOrderSearch);
    case PurchaseOrderListForCreateFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, PurchaseOrderCreateViewUrlFiltersEnum.vendorSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PurchaseOrderCreateViewUrlFilters>(PURCHASE_ORDER_LIST_FOR_CREATE_FILTER_KEYS);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PurchaseOrderCreateViewUrlQueryParams,
  PurchaseOrderCreateViewUrlFilters
>({ ...PurchaseOrderCreateViewUrlFiltersEnum });
</file>

<file path="src/app/views/purchase/purchaseOrders/view/PurchaseOrderCreateView/PurchaseOrderCreateView.tsx">
import { PAGINATE_BY } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import usePaginator, { createPaginationState } from "@hooks/usePaginator";
import {
  OrderType,
  PurchaseOrderBulkCreateInput,
  PurchaseOrderCreateInput,
  PurchaseOrderEventType,
  PurchaseOrderEventTypeEnum,
  PurchaseOrderLineAddInput,
} from "@src/api/types/globalTypes";
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { b2bPurchaseOrderLineListViewUrl, b2bPurchaseWriteListViewUrl } from "@src/app/views/b2b/urls";
import { orderLineListForPurchaseViewUrlB } from "@src/app/views/order/orders/urls";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { isStoppedSalesStatus, makeVendorDisplayName, maybe, transformPhoneNumber } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form } from "antd";
import moment from "moment";
import React, { useEffect, useMemo, useState } from "react";
import { useParams } from "react-router";

import { usePurchaseOrderBulkCreateMutation, usePurchaseOrderCreateMutation } from "../../api/mutations";
import { usePurchaseOrderListForCreateQuery } from "../../api/queries";
import { PurchaseOrderListForCreateVariables } from "../../api/types/PurchaseOrderListForCreate";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePage,
  PurchaseOrderCreatePageFormData,
} from "../../components/PurchaseOrderCreatePage/PurchaseOrderCreatePage";
import { EXTERNAL_WAREHOUSE_ID } from "../../components/PurchaseOrderCreatePage/utils";
import {
  PurchaseOrderCreateViewRouteParams,
  purchaseOrderCreateViewUrl,
  PurchaseOrderCreateViewUrlQueryParams,
  purchaseOrderLineListViewUrl,
} from "../../urls";
import {
  checkConsignmentTakeBackPurchaseOrder,
  checkTakeBackPurchaseOrder,
  checkTrackInventoryPurchaseOrder,
  consignmentPurchaseOrderKey,
  trackInventoryPurchaseOrderKey,
} from "../../utils";
import { PurchaseOrderModalModeEnum } from "../PurchaseOrderDetailsView";
import { getFilterQueryParam, getFilterVariables } from "./filters";

interface PurchaseOrderCreateViewProps {
  params: PurchaseOrderCreateViewUrlQueryParams;
  isB2b: boolean;
}

export const PurchaseOrderCreateView: React.FC<PurchaseOrderCreateViewProps> = ({ params, isB2b = false }) => {
  const routeParams = useParams<PurchaseOrderCreateViewRouteParams>();
  const navigate = useNavigator();
  const paginate = usePaginator();
  const [skipQuery, setSkipQuery] = useState<boolean>(true);
  const [modalMode, setModalMode] = useState<PurchaseOrderModalModeEnum>(null);
  const [idForModal, setIdForModal] = useState<string>(null);
  const paginationState = createPaginationState(PAGINATE_BY, params);
  const [form] = Form.useForm<PurchaseOrderCreatePageFormData>();

  const eventTypeWatched = Form.useWatch("eventType", form);
  const linesObjWatched = Form.useWatch("linesObj", form);
  const linesWatched = convertFormLinesObjToArr(linesObjWatched, "lineKey");

  // B2B 반품인 경우 조건 추가 =>
  // 현재 등록하려는 lines를 useEffect로 확인하여 eventType을 변경하고
  // 해당 값을 여기서 B2B 여부와 같이 확인하여 B2B 반품인지 확인
  const isB2bTakeBack = isB2b && eventTypeWatched === PurchaseOrderEventTypeEnum.CONSIGNMENT_TAKE_BACK;
  const isTrackInventoryIncludeTakeBack =
    routeParams.createType === "track-inventory" || routeParams.createType === "track-inventory-take-back";

  // B2B 반품인 경우 조건 추가 (B2B 반품인 경우, 위탁제품 발주서 작성 페이지로 이동되어 createType으로 판단하지 않음)
  const isTakeBack =
    routeParams.createType === "track-inventory-take-back" ||
    routeParams.createType === "consignment-take-back" ||
    isB2bTakeBack;
  const targetTakeBackKey = isTrackInventoryIncludeTakeBack
    ? trackInventoryPurchaseOrderKey
    : consignmentPurchaseOrderKey;

  const toUrl = isB2b
    ? b2bPurchaseOrderLineListViewUrl({
        inventoryType: "consignment",
        status: "draft",
      })
    : purchaseOrderLineListViewUrl({
        inventoryType: isTrackInventoryIncludeTakeBack ? "track-inventory" : "consignment",
        status: "draft",
      });
  const fromUrl = isB2b
    ? b2bPurchaseWriteListViewUrl()
    : isTrackInventoryIncludeTakeBack
    ? purchaseOrderLineListViewUrl({
        inventoryType: "track-inventory",
        status: isTakeBack ? "complete-delivery" : "draft",
      })
    : isTakeBack
    ? purchaseOrderLineListViewUrl({ inventoryType: "consignment", status: "complete-delivery" })
    : orderLineListForPurchaseViewUrlB();

  const queryVariables = useMemo<PurchaseOrderListForCreateVariables>(
    () => ({ ...paginationState, filter: getFilterVariables(params) }),
    [params]
  );

  const {
    data: purchaseOrderListForCreateData,
    loading: purchaseOrderListForCreateLoading,
    refetch: purchaseOrderListForCreateRefetch,
  } = usePurchaseOrderListForCreateQuery({ skip: skipQuery, variables: queryVariables });
  const purchaseOrderListForCreate = maybe(
    () => purchaseOrderListForCreateData.purchaseOrders.edges.map((edge) => edge.node),
    []
  );
  const purchaseOrderListForCreatePageInfo = maybe(() => purchaseOrderListForCreateData.purchaseOrders.pageInfo, null);
  const [purchaseOrderCreate, purchaseOrderCreateOpts] = usePurchaseOrderCreateMutation({
    onCompleted: (data) => {
      const errors = data?.purchaseOrderCreate?.errors;
      if (errors?.length !== 0) {
        showGqlErrors(errors);
      }
    },
  });

  const [purchaseOrderBulkCreate, purchaseOrderBulkCreateOpts] = usePurchaseOrderBulkCreateMutation({
    onCompleted: (data) => {
      const errorMsgs = data?.purchaseOrderBulkCreate?.errorMsgs;
      if (errorMsgs?.length !== 0) {
        for (const errorMsg of errorMsgs) {
          showNotificationError(errorMsg);
        }
      }
    },
    onError: (error) => {
      console.error("Error creating bulk purchase orders:", error);
      showNotificationError("발주서 등록 중 에러가 발생했습니다.");
    },
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: purchaseOrderListForCreatePageInfo,
    paginationState,
    params,
  });

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: (params) => purchaseOrderCreateViewUrl(routeParams, params),
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: purchaseOrderListForCreateRefetch,
  });

  const handleCreate = async (formData: PurchaseOrderCreatePageFormData) => {
    if (utils.isEmpty(formData.eventType)) {
      showNotificationError("발주 구분 선택은 필수 항목입니다.");
      return;
    }
    const isTrackInventoryPurchaseOrder = checkTrackInventoryPurchaseOrder(formData.eventType);
    const isTackBackPurchaseOrder = checkTakeBackPurchaseOrder(formData.eventType);
    const isConsignmentTakeBackPurchaseOrder = checkConsignmentTakeBackPurchaseOrder(formData.eventType);

    const isTakeBackEventType = isTackBackPurchaseOrder || isConsignmentTakeBackPurchaseOrder;

    const purchaseOrderDate = formData.purchaseOrderDate;
    if (utils.isEmpty(purchaseOrderDate)) {
      showNotificationError("발주일 선택은 필수 항목입니다.");
      return;
    }

    // 발주 내역에 대한 validate
    const lines = convertFormLinesObjToArr(formData.linesObj, "lineKey");
    const selectedLines = lines.filter((line) => line.isSelected);
    if (selectedLines?.length === 0) {
      showNotificationError("최소 1개 이상의 발주제품을 선택해주세요.");
      return;
    }
    for (const line of selectedLines) {
      if (utils.isEmpty(line.variantId)) {
        showNotificationError("선택된 발주 제품 정보가 올바르지 않습니다.");
        return;
      }
      if (utils.isEmpty(line.askingPurchaseDate)) {
        if (isTakeBackEventType) {
          showNotificationError("모든 발주 제품의 반품 요청일은 필수 항목입니다.");
        } else {
          showNotificationError("모든 발주 제품의 납품 요청일은 필수 항목입니다.");
        }
        return;
      }
      if (isB2b === false) {
        const isBeforePurchaseOrderDate = moment(line.askingPurchaseDate).isBefore(moment(purchaseOrderDate));
        if (isBeforePurchaseOrderDate) {
          if (isTakeBackEventType) {
            showNotificationError(
              "반품요청일이 발주일보다 이전 일자로 선택된 발주제품이 존재합니다. 반품요청일은 발주일 이후의 일자로 선택해주세요."
            );
          } else {
            showNotificationError(
              "납품 요청일이 발주일보다 이전 일자로 선택된 발주제품이 존재합니다. 납품 요청일은 발주일 이후의 일자로 선택해주세요."
            );
          }
          return;
        }
      }
      if (!isTakeBackEventType && utils.isEmpty(line.vendorId)) {
        showNotificationError("모든 발주 제품의 협력사 선택은 필수 항목입니다.");
        return;
      }
      if (isTackBackPurchaseOrder && utils.isEmpty(line?.rackLocation)) {
        showNotificationError("재고 반품 발주서에서는 모든 발주제품 로케이션 위치 선택이 필수 항목입니다.");
        return;
      }
      if (utils.isEmpty(line.quantity) || line.quantity < 0) {
        showNotificationError("모든 발주 제품의 발주 수량은 0 이상의 값을 입력해주어야 합니다.");
        return;
      }
      const productVariantNameWithSku = `${line?.variant?.product?.name || "-"}(${line?.variant?.sku || "-"})`;
      const salesStatus = line.variant?.salesStatus;
      const isStopped = isStoppedSalesStatus(salesStatus);
      if (isTrackInventoryPurchaseOrder && isStopped) {
        showNotificationError(`${productVariantNameWithSku}: 단종된 제품은 발주 품목으로 추가할 수 없습니다.`);
        return;
      }
    }

    const isExternalWarehouseDelivery = formData.warehouseAddress === EXTERNAL_WAREHOUSE_ID;
    // 재고 발주(초도발주, 재발주, 반품발주)인 경우 validate
    if (isTrackInventoryIncludeTakeBack) {
      if (utils.isEmpty(formData.deliveryWarehouseName)) {
        showNotificationError("발주 납품처 종류와 이름은 필수 항목입니다.");
        return;
      }
      if (isExternalWarehouseDelivery && utils.isEmpty(formData.deliveryWarehouseManager)) {
        showNotificationError("납품처를 외부업체로 선택할 경우, 발주 납품 담당자 이름은 필수 항목입니다.");
        return;
      }
      if (isExternalWarehouseDelivery && utils.isEmpty(formData.phone)) {
        showNotificationError("납품처를 외부업체로 선택할 경우, 발주 납품 담당자 연락처는 필수 항목입니다.");
        return;
      }
      if (utils.isEmpty(formData.postalCode)) {
        showNotificationError("발주 납품 우편 번호는 필수 항목입니다.");
        return;
      }
      if (utils.isEmpty(formData.streetAddress1)) {
        showNotificationError("발주 납품 주소는 필수 항목입니다.");
        return;
      }
    }

    const makeLineAddInputFromFormData = (line: IPurchaseOrderCreateLine): PurchaseOrderLineAddInput => ({
      variantId: line.variantId,
      quantity: line.quantity,
      costPriceExcludeVat: line.costPriceExcludeVat,
      etcExcludeVat: line.etcExcludeVat,
      orderLineId: line.orderLineId,
      askingPurchaseDate: moment(line.askingPurchaseDate).format(onlyDateFormat),
      note: line.note,
      takeBackPurchaseOrderLineId: line.takeBackPurchaseOrderLineId,
      rackLocation: line.rackLocation,
      takeBackUnitCostDeliveryFeeExcludeVat: line.takeBackUnitCostDeliveryFeeExcludeVat,
      b2bDeliveryFeeExcludeVat: line.b2bDeliveryFeeExcludeVat,
    });

    const purchaseOrderCreateInput: PurchaseOrderCreateInput = {
      warehouse: formData.warehouseAddress === EXTERNAL_WAREHOUSE_ID ? undefined : formData.warehouse,
      warehouseAddress: formData.warehouseAddress === EXTERNAL_WAREHOUSE_ID ? undefined : formData.warehouseAddress,
      deliveryWarehouseName: formData.deliveryWarehouseName,
      deliveryWarehouseManager: formData.deliveryWarehouseManager,
      phone: utils.isEmpty(formData.phone) ? undefined : transformPhoneNumber(formData.phone),
      streetAddress1: formData.streetAddress1,
      streetAddress2: formData.streetAddress2,
      postalCode: formData.postalCode,
      note: formData.note,
      purchaseOrderDate: moment(formData.purchaseOrderDate).format(onlyDateFormat),
      eventType: formData.eventType,
      vendor: formData.vendor,
      isNotOrderableBeforeStocked: formData.isNotOrderableBeforeStocked,
      isForPackageOrder: formData.isForPackageOrder,
      sourcePurchaseOrder: formData.sourcePurchaseOrder,
      lines: selectedLines.map((line) => makeLineAddInputFromFormData(line)),
      isB2b,
    };

    if (isTakeBackEventType && isB2b === false) {
      const input: PurchaseOrderCreateInput = { ...purchaseOrderCreateInput };
      const { data: purchaseOrderCreateData } = await purchaseOrderCreate({ variables: { input } });
      const purchaseOrderCreateErrors = purchaseOrderCreateData?.purchaseOrderCreate?.errors;
      if (purchaseOrderCreateErrors.length === 0) {
        showNotificationSuccess("반품 발주서 등록에 성공했습니다.");
        localStorage.removeItem(targetTakeBackKey);
        navigate(fromUrl);
      }
      return purchaseOrderCreateErrors;
    } else {
      // 협력사별로 그룹핑된 데이터를 생성
      const vendorInfoArr = selectedLines.map((line) => {
        const selectedVariantVendor = line?.variant?.productVariantVendors.find(
          (variantVendor) => variantVendor?.vendor?.id === line.vendorId
        );
        return {
          id: line?.vendorId,
          code: selectedVariantVendor?.vendor.code,
          name: selectedVariantVendor?.vendor.name,
        };
      });

      const uniqueVendorInfoArr = vendorInfoArr.filter(
        (filterVendor, idx) => vendorInfoArr.findIndex((vendor) => vendor.id === filterVendor.id) === idx
      );

      // BulkInput 데이터를 생성
      const ordersToCreate: PurchaseOrderBulkCreateInput[] = uniqueVendorInfoArr.map((vendorInfo) => {
        const linesByVendor = selectedLines.filter((line) => line.vendorId === vendorInfo.id);

        return {
          input: {
            ...purchaseOrderCreateInput,
            vendor: vendorInfo.id,
            lines: linesByVendor.map((line) => makeLineAddInputFromFormData(line)),
          },
        };
      });

      // Bulk Mutation 호출
      const { data } = await purchaseOrderBulkCreate({
        variables: { ordersToCreate },
      });

      const createdVendorIds = data?.purchaseOrderBulkCreate.createdPurchaseOrderVendorIds || [];
      const failedVendorIds = data?.purchaseOrderBulkCreate.failedPurchaseOrderVendorIds || [];

      const createdPurchaseOrderVendorNameList = uniqueVendorInfoArr
        .filter((vendor) => createdVendorIds.includes(vendor.id))
        .map((vendor) => makeVendorDisplayName(vendor));

      const failedPurchaseOrderVendorNameList = uniqueVendorInfoArr
        .filter((vendor) => failedVendorIds.includes(vendor.id))
        .map((vendor) => makeVendorDisplayName(vendor));

      // 성공한 발주서 알림
      if (createdPurchaseOrderVendorNameList.length > 0) {
        showNotificationSuccess(
          <>
            <>발주서가 아래 협력사별로 그룹핑 되어 등록되었습니다.</>
            <br />
            <>[{createdPurchaseOrderVendorNameList.join(", ")}]</>
          </>
        );
      }

      // 실패한 발주서 알림
      if (failedPurchaseOrderVendorNameList.length > 0) {
        showNotificationError(
          <>
            <>아래 협력사에 대한 발주서 등록이 실패했습니다.</>
            {!isTrackInventoryIncludeTakeBack && (
              <>(위탁제품 발주인 경우, 위탁제품 발주서 등록 페이지에서부터 다시 진행해주시기 바랍니다.)</>
            )}
            <br />
            <>[{failedPurchaseOrderVendorNameList.join(", ")}]</>
          </>
        );
      }

      // 성공적으로 등록된 경우 페이지 이동
      if (createdPurchaseOrderVendorNameList.length > 0) {
        navigate(toUrl);
      }

      return failedPurchaseOrderVendorNameList;
    }
  };

  const pageLoading =
    purchaseOrderListForCreateLoading || purchaseOrderCreateOpts.loading || purchaseOrderBulkCreateOpts.loading;

  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => {
    setIdForModal(idForModal);
    setModalMode(modalMode);
  };

  const onSubmit = (formData: PurchaseOrderCreatePageFormData) => {
    // B2B 위탁 발주서인지 확인
    const isB2bConsignment = isB2b && routeParams.createType === "consignment";

    // 특이사항 체크가 필요한 경우:
    // 1. B2B 위탁 발주서
    // 2. 재고 발주서 (반품 제외)
    if (isB2bConsignment || (isTrackInventoryIncludeTakeBack && !isTakeBack)) {
      openModalWithoutNavigate(PurchaseOrderModalModeEnum.ConfirmForCreate, null);
    } else {
      handleCreate(formData);
    }
  };

  // 발주 구분에 useEffect로 체킹하는 부분 추가
  // B2B 발주서 등록할 때 B2B 발주와 B2b 반품을 동시에 할 수 없으므로 체킹 후 발주구분 form set 하는 부분 필요
  useEffect(() => {
    if (isB2b && linesWatched.length > 0) {
      const typeCheck = linesWatched[0].orderLine.order.type;
      for (let i = 0; i < linesWatched.length; i++) {
        if (linesWatched[i].orderLine.order.type !== typeCheck) {
          showNotificationError("B2B 발주서 등록 시 B2B 발주와 B2B 반품을 동시에 할 수 없습니다.");
          form.setFieldsValue({ eventType: null });
          navigate(fromUrl);
          break;
        }
      }
      const eventType =
        typeCheck === OrderType.BY_STAFF_FOR_B2B
          ? PurchaseOrderEventType.CONSIGNMENT
          : PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK;
      form.setFieldValue("eventType", eventType);
    }
  }, [linesWatched]);

  return (
    <>
      <WindowTitle title="발주서 등록" />
      <Form form={form} layout="vertical" name="purchase-order-create-form" onFinish={onSubmit}>
        <PurchaseOrderCreatePage
          disabled={pageLoading}
          targetTakeBackKey={targetTakeBackKey}
          saveButtonBar={purchaseOrderCreateOpts.status || purchaseOrderBulkCreateOpts.status}
          createByPurchaseOrderProps={{
            params,
            loading: pageLoading,
            disabled: pageLoading,
            purchaseOrders: purchaseOrderListForCreate,
            onFilterChange: changeFilters,
            onFilterReset: resetFilters,
            onNextPage: loadNextPage,
            onPreviousPage: loadPreviousPage,
            pageInfo,
          }}
          onQueryPurchaseOrders={() => setSkipQuery(false)}
          onCreate={handleCreate}
          onBack={() => navigate(fromUrl)}
          isB2b={isB2b}
          isTrackInventoryIncludeTakeBackType={isTrackInventoryIncludeTakeBack}
          isTakeBackType={isTakeBack}
          form={form}
          modalMode={modalMode}
          idForModal={idForModal}
          resetForCloseModal={resetForCloseModal}
          openModalWithoutNavigate={openModalWithoutNavigate}
          isB2bTakeBack={isB2bTakeBack}
        />
      </Form>
    </>
  );
};
