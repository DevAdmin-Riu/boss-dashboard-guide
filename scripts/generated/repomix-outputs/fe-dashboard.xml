const SALES_STAT_BY_PRODUCT_DIFF_FILTERS_KEY = "salesStatByProductDiffFilters";

export function getFilterOpts(params: SalesStatByProductListViewUrlQueryParams): SalesStatByProductDiffListFilterOpts {
  const filterVariables = getSalesStatByProductDiffListFilterVariables(params);
  const todayMoment = moment().startOf("month");
  return {
    statDateA: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDateA.gte, filterVariables.statDateA.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDateA.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDateA.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    statDateB: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDateB.gte, filterVariables.statDateB.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDateB.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDateB.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    categoryKind: {
      active: maybe(() => !utils.isEmpty(params.categoryKind, true), false),
      value: dedupeFilter((params.categoryKind as ProductCategoryKind[]) || []),
    },
    salesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.salesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.salesStatus), []),
    },
    isExclusive: {
      active: maybe(() => !utils.isEmpty(filterVariables.isExclusive), false),
      value: maybe(() => filterVariables.isExclusive, true),
    },

    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, true),
    },

    isInner: {
      active: maybe(() => !utils.isEmpty(filterVariables.isInner), false),
      value: maybe(() => filterVariables.isInner, true),
    },
  };
}

export function getSalesStatByProductDiffListFilterVariables(
  params: SalesStatByProductDiffListViewUrlFilters
): SalesStatByProductDiffListVariables {
  const selectedCategories: ProductCategoryKind[] = (params.categoryKind as ProductCategoryKind[]) || [];
  const { categoryKind, isFulfilledByVendor, isSubPv } = mapCategoryKindToQueryVariables(selectedCategories);

  return {
    statDateA: getGteLteVariables({
      gte: params.statDateAFrom,
      lte: params.statDateATo,
    }),
    statDateB: getGteLteVariables({
      gte: params.statDateBFrom,
      lte: params.statDateBTo,
    }),
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    categoryKind,
    isFulfilledByVendor,
    isSubPv,
    salesStatus: maybe(() => params.salesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    isExclusive: params.isExclusive !== undefined ? parseBoolean(params.isExclusive, false) : undefined,
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, false) : undefined,
    isInner: params.isInner !== undefined ? parseBoolean(params.isInner, false) : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<SalesStatByProductDiffFilterKeys>
): SalesStatByProductDiffListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case SalesStatByProductDiffFilterKeys.statDateA:
      return getMinMaxQueryParam(
        filter,
        SalesStatByProductDiffListViewUrlFiltersEnum.statDateAFrom,
        SalesStatByProductDiffListViewUrlFiltersEnum.statDateATo
      );
    case SalesStatByProductDiffFilterKeys.statDateB:
      return getMinMaxQueryParam(
        filter,
        SalesStatByProductDiffListViewUrlFiltersEnum.statDateBFrom,
        SalesStatByProductDiffListViewUrlFiltersEnum.statDateBTo
      );
    case SalesStatByProductDiffFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, SalesStatByProductDiffListViewUrlFiltersEnum.brandSearch);
    case SalesStatByProductDiffFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, SalesStatByProductDiffListViewUrlFiltersEnum.productSearch);
    case SalesStatByProductDiffFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, SalesStatByProductDiffListViewUrlFiltersEnum.vendorSearch);
    case SalesStatByProductDiffFilterKeys.categoryKind:
      // FULFILLED_BY_VENDOR 포함하여 URL에 저장
      return {
        [SalesStatByProductDiffListViewUrlFiltersWithMultipleValuesEnum.categoryKind]:
          filter.value as ProductCategoryKind[],
      };
    case SalesStatByProductDiffFilterKeys.salesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        SalesStatByProductDiffListViewUrlFiltersWithMultipleValuesEnum.salesStatus,
        SalesStatusEnum
      );
    case SalesStatByProductDiffFilterKeys.isExclusive:
      return getSingleValueQueryParam(filter, SalesStatByProductListViewUrlFiltersEnum.isExclusive);
    case SalesStatByProductDiffFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, SalesStatByProductListViewUrlFiltersEnum.trackInventory);
    case SalesStatByProductDiffFilterKeys.isInner:
      return getSingleValueQueryParam(filter, SalesStatByProductListViewUrlFiltersEnum.isInner);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<SalesStatByProductDiffListViewUrlFilters>(SALES_STAT_BY_PRODUCT_DIFF_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
