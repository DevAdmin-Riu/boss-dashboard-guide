import { utils } from "@utils/utils";
import { Card, Form, FormInstance, Input, Radio, Space, Steps, Typography } from "antd";
import React, { useEffect, useState } from "react";
import { useParams } from "react-router";

import { usePurchaseOrderDetailsLazyQuery } from "../../api/queries";
import {
  PurchaseOrderDetails_purchaseOrder,
  PurchaseOrderDetails_purchaseOrder_lines,
} from "../../api/types/PurchaseOrderDetails";
import { PurchaseOrderCreateViewRouteParams } from "../../urls";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import { PurchaseOrderAddress } from "../PurchaseOrderAddress";
import { PurchaseOrderBasicInfo } from "../PurchaseOrderBasicInfo";
import { PurchaseOrderCreateLines } from "../PurchaseOrderCreateLines/PurchaseOrderCreateLines";
import PurchaseOrderCreateProductConfirmModal from "../PurchaseOrderCreateProductConfirmModal";
import {
  PurchaseOrderListForCreateTable,
  PurchaseOrderListForCreateTableProps,
} from "../PurchaseOrderListForCreateTable/PurchaseOrderListForCreateTable";
import { PurchaseOrderProductNoteQueryModal } from "../PurchaseOrderProductNoteQueryModal";
import { PurchaseOrderTakeBackLines } from "../PurchaseOrderTakeBackLines/PurchaseOrderTakeBackLines";
import { getPoCreateFormInitialValues, makePoDeliveryWarehouseList } from "./utils";

export interface IPurchaseOrderCreateLine extends PurchaseOrderLineAddInput {
  lineKey: string;
  isSelected: boolean;
  variant:
    | ProductVariantListToAdd_productVariants_edges_node
    | OrderLineListForPurchaseOrder_orderLines_edges_node_variant;
  vendorId: string;
  // 이하 필드는 위탁 관련 발주인 경우에만 사용
  orderLine?: OrderLineListForPurchaseOrder_orderLines_edges_node;
  consignmentProductPriceExcludeVat?: number | null;
  consignmentDeliveryFeeExcludeVat?: number | null;
  consignmentUnitDeliveryAdditionalFeeExcludeVat?: number | null;
  // 이하 필드는 반품 발주인 경우에만 사용
  takeBackPurchaseOrderLine?: PurchaseOrderDetails_purchaseOrder_lines;
  b2bDeliveryFeeExcludeVat?: number | null;
}

export type TPurchaseOrderCreateLinesObj = Record<string, IPurchaseOrderCreateLine>;

// 초도발주, 재발주 등록 시 각 로우에 Form.Item을 적용하면서 Form.List로 관리하기에 어려움이 있어서 각 lineKey를 key로 하는 object로 관리 - 테이블 dataSource, 뮤테이션 input 전달 시엔 배열로 변환해서 사용
export interface PurchaseOrderCreatePageFormData extends StrictOmit<PurchaseOrderCreateInput, "lines"> {
  bySourcePo: boolean; // 등록 시 불러오기(이미 발주된 발주서 이용) 여부
  defaultAskingPurchaseDate: any;
  linesObj: TPurchaseOrderCreateLinesObj;
  // 이하 필드는 반품 발주인 경우에만 사용.
  // sourcePurchaseOrder는 불러오기 통해 등록 시에 이용하는 필드이므로 takeBackPurchaseOrder와 다름.
  takeBackPurchaseOrder?: PurchaseOrderDetails_purchaseOrder;
}

interface PurchaseOrderCreatePageProps {
  disabled: boolean;
  targetTakeBackKey: string;
  saveButtonBar: ConfirmButtonTransitionState;
  createByPurchaseOrderProps: StrictOmit<PurchaseOrderListForCreateTableProps, "form">;
  onQueryPurchaseOrders: () => void;
  onCreate: (data: PurchaseOrderCreatePageFormData) => void;
  onBack: () => void;
  isB2b: boolean;
  isTrackInventoryIncludeTakeBackType: boolean;
  isTakeBackType: boolean;
  form: FormInstance<PurchaseOrderCreatePageFormData>;
  modalMode: PurchaseOrderModalModeEnum;
  idForModal: string;
  resetForCloseModal: () => void;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
  isB2bTakeBack: boolean;
}

export const PurchaseOrderCreatePage: React.FC<PurchaseOrderCreatePageProps> = ({
  disabled,
  targetTakeBackKey,
  saveButtonBar,
  createByPurchaseOrderProps,
  onQueryPurchaseOrders,
  onCreate,
  onBack,
  isB2b = false,
  isTrackInventoryIncludeTakeBackType,
  isTakeBackType,
  form,
  modalMode,
  idForModal,
  resetForCloseModal,
  openModalWithoutNavigate,
  isB2bTakeBack,
}) => {
  const routeParams = useParams<PurchaseOrderCreateViewRouteParams>();
  const purchaseOrderIdForTakeBack = JSON.parse(localStorage.getItem(targetTakeBackKey));
  // 스텝 거쳐 등록 진행 여부 - '재고 발주서 작성'인 경우에만 신규 or 불러오기 선택하여 진행. 그 외 발주서는 모두 신규로 등록
  const showSteps = routeParams.createType === "track-inventory";

  const [currentStep, setCurrentStep] = useState<number>(showSteps ? 0 : null);

  const bySourcePoWatched = Form.useWatch("bySourcePo", form);
  const sourcePurchaseOrderWatched = Form.useWatch("sourcePurchaseOrder", form);
  const takeBackPurchaseOrderWatched = Form.useWatch("takeBackPurchaseOrder", form);
  const linesObjWatched = Form.useWatch("linesObj", form);
  const linesWatched = convertFormLinesObjToArr(linesObjWatched, "lineKey");

  const isByPurchaseOrderSelectStep = currentStep === 0;
  const isWriteStep = currentStep === 1 || currentStep === null;

  const sourcePurchaseOrderSelected = !utils.isEmpty(sourcePurchaseOrderWatched, true);
  const showPurchaseOrderListTable = bySourcePoWatched && isWriteStep && !sourcePurchaseOrderSelected;

  const targetPurchaseOrderId = showSteps
    ? sourcePurchaseOrderWatched
    : isTakeBackType && isB2b === false
    ? purchaseOrderIdForTakeBack
    : null;

  const [fetch] = usePurchaseOrderDetailsLazyQuery();
  const shop = useShop();
  const { isStaff } = useUser().user;

  const warehouseList = shop?.defaultWarehouse ? makePoDeliveryWarehouseList(shop.defaultWarehouse) : [];
  const warehouseLoading = false;

  useEffect(() => {
    // NOTE: setFields가 아닌 setFieldsValue로 초기화 시, linesObj가 초기화되지 않고 기존 값에 새로운 값이 추가 or 덮어씌워지는 에러가 있어서 setFields로 적용
    if (utils.isEmpty(targetPurchaseOrderId)) {
      const initialValues = getPoCreateFormInitialValues({
        routeParams,
        purchaseOrder: null,
        warehouseList,
      });
      const fieldsData: Array<{ name: keyof PurchaseOrderCreatePageFormData; value: any }> = Object.keys(
        initialValues
      ).map((key: keyof PurchaseOrderCreatePageFormData) => {
        if (key === "bySourcePo") {
          return { name: key, value: bySourcePoWatched };
        }
        return { name: key, value: initialValues[key] };
      });
      form.setFields(fieldsData);
    } else {
      fetch({ variables: { id: targetPurchaseOrderId } }).then((res) => {
        const purchaseOrder = maybe(() => res.data.purchaseOrder, null);
        const initialValues = getPoCreateFormInitialValues({
          routeParams,
          purchaseOrder,
          warehouseList,
        });
        const fieldsData: Array<{ name: keyof PurchaseOrderCreatePageFormData; value: any }> = Object.keys(
          initialValues
        ).map((key: keyof PurchaseOrderCreatePageFormData) => {
          if (key === "bySourcePo") {
            return { name: key, value: bySourcePoWatched };
          }
          return { name: key, value: initialValues[key] };
        });
        form.setFields(fieldsData);
      });
    }
  }, [targetPurchaseOrderId, warehouseLoading]);

  useEffect(() => {
    if (showPurchaseOrderListTable) {
      onQueryPurchaseOrders();
    }
  }, [showPurchaseOrderListTable]);

  const onPrevStep = () => setCurrentStep((prev) => prev - 1);
  const onNextStep = () => setCurrentStep((prev) => prev + 1);
  const onInvalidFieldsNotify = () =>
    showNotificationError("필수 입력 항목 값이 없거나 잘못된 값이 있습니다. 확인 후 다시 시도해주세요.");

  let saveButtonDisabled: boolean = disabled;
  let saveButtonLabels: ISaveButtonBarLabels;
  let onCancel: () => void;
  let onReset: () => void;
  let onSave: () => void;
  switch (currentStep) {
    case 0:
      saveButtonLabels = { cancel: "취소", save: "다음" };
      onCancel = onBack;
      onSave = () => {
        form.validateFields(["bySourcePo"]).then(onNextStep).catch(onInvalidFieldsNotify);
      };
      break;
    case 1:
      if (showPurchaseOrderListTable) {
        saveButtonLabels = { cancel: "이전" };
      } else {
        saveButtonDisabled = disabled || linesWatched.length === 0;
        saveButtonLabels = { cancel: "이전", reset: "발주서 재선택", save: "등록" };
        onSave = form.submit;
        if (bySourcePoWatched) {
          onReset = () => {
            form.setFieldValue("sourcePurchaseOrder", null);
          };
        }
      }
      onCancel = onPrevStep;
      break;
    default:
      saveButtonDisabled = disabled || linesWatched.length === 0;
      saveButtonLabels = { cancel: "취소", save: "등록" };
      onCancel = onBack;
      onSave = form.submit;
      break;
  }

  const purchaseOrderTypeText =
    (isTrackInventoryIncludeTakeBackType ? "재고" : isB2b ? "B2B" : "협력사") + (isTakeBackType ? " 반품" : "");

  return (
    <>
      <AppHeader onBack={onBack}>
        {purchaseOrderTypeText} {sectionNames.purchaseOrders}
      </AppHeader>
      <PageHeader title={`${purchaseOrderTypeText} 발주서 등록`} />
      <Form.Item hidden name="sourcePurchaseOrder">
        <Input />
      </Form.Item>
      <Form.Item hidden name="takeBackPurchaseOrder">
        <Input />
      </Form.Item>
      {showSteps && (
        <Steps
          type="navigation"
          current={currentStep}
          items={[{ title: "작성 방식 선택" }, { title: "발주서 작성" }]}
        />
      )}
      <Card style={{ display: isByPurchaseOrderSelectStep ? "block" : "none" }}>
        <Form.Item
          style={{ margin: 0 }}
          name="bySourcePo"
          rules={[{ required: showSteps, message: formRuleMsg.requiredSelect }]}
          label={<Typography.Title level={5}>작성 방식 선택</Typography.Title>}
        >
          <Radio.Group>
            <Space style={{ marginTop: 12 }} direction="vertical">
              <Radio value={false}>
                <MultiLineTypography
                  lines={[
                    "신규 작성",
                    <Typography.Text strong type="warning" style={{ fontSize: "12px" }}>
                      발주서를 처음부터 작성합니다.
                    </Typography.Text>,
                  ]}
                />
              </Radio>
              <Radio value={true}>
                <MultiLineTypography
                  lines={[
                    "불러오기",
                    <Typography.Text strong type="warning" style={{ fontSize: "12px" }}>
                      재발주를 위해 과거에 발주한 내역을 불러와 작성합니다.
                    </Typography.Text>,
                  ]}
                />
              </Radio>
            </Space>
          </Radio.Group>
        </Form.Item>
      </Card>
      <Card style={{ display: isWriteStep ? "block" : "none" }}>
        {showPurchaseOrderListTable ? (
          <PurchaseOrderListForCreateTable form={form} {...createByPurchaseOrderProps} />
        ) : (
          <Space direction={"vertical"} size={"large"}>
            <PurchaseOrderBasicInfo
              form={form}
              disabled={disabled}
              takeBackPurchaseOrder={takeBackPurchaseOrderWatched}
              isB2b={isB2b}
            />
            {isTrackInventoryIncludeTakeBackType && (
              <PurchaseOrderAddress
                form={form}
                disabled={disabled}
                warehouseLoading={warehouseLoading}
                warehouses={warehouseList}
              />
            )}
            {isTakeBackType && isB2b === false ? (
              <PurchaseOrderTakeBackLines
                form={form}
                disabled={disabled}
                openModalWithoutNavigate={openModalWithoutNavigate}
              />
            ) : (
              <PurchaseOrderCreateLines
                form={form}
                disabled={disabled}
                trackInventory={isTrackInventoryIncludeTakeBackType}
                modalMode={modalMode}
                openModalWithoutNavigate={openModalWithoutNavigate}
                resetForCloseModal={resetForCloseModal}
                isB2b={isB2b}
                isStaff={isStaff}
              />
            )}
          </Space>
        )}
      </Card>
      <AntdSaveButtonBar
        disabled={saveButtonDisabled}
        state={saveButtonBar}
        labels={saveButtonLabels}
        onSave={onSave}
        onReset={onReset}
        onCancel={onCancel}
      />
      <PurchaseOrderProductNoteQueryModal
        open={modalMode === PurchaseOrderModalModeEnum.QueryVariantNote}
        purchaseOrderLine={linesWatched.find((line) => {
          if (isTakeBackType && isB2b === false) {
            return line.takeBackPurchaseOrderLine.id === idForModal;
          }
          return line.variantId === idForModal;
        })}
        onCancel={resetForCloseModal}
      />
      {!isTakeBackType && (
        <ProductToBeChangedInfoModal
          open={modalMode === PurchaseOrderModalModeEnum.CheckToBeChangedInfo}
          productVariant={linesWatched.find((line) => line.variantId === idForModal)?.variant}
          onClose={resetForCloseModal}
        />
      )}
      <PurchaseOrderCreateProductConfirmModal
        form={form}
        open={modalMode === PurchaseOrderModalModeEnum.ConfirmForCreate}
        modalTitleText={"발주서 등록"}
        okText={"등록"}
        onCreate={onCreate}
        disabled={disabled}
        onCancel={resetForCloseModal}
        isB2b={isB2b}
        isStaff={isStaff}
      />
    </>
  );
};
