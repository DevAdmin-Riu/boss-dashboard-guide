<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineListPage/utils.ts">
import { PurchaseOrderEventType, PurchaseOrderLineStatus } from "@src/api/types/globalTypes";
import { calcTotalExcludeVatByUnitExcludeVatAndQty, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { checkChargeDeliveryAdditionalFee } from "@utils/misc";
import { utils } from "@utils/utils";

import { PurchaseOrderDetails_purchaseOrder_lines } from "../../api/types/PurchaseOrderDetails";
import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import { PoLineUrlStatusType } from "../../urls";
import { checkConsignmentTakeBackPurchaseOrder, getCheckPurchaseOrderEventTypeResults } from "../../utils";
import { PurchaseOrderLineColProps } from "./PurchaseOrderLineListTableSettings";

export const isExistPurchaseOrderLineStatusIn = (
  nowStatus: PurchaseOrderLineStatus,
  status: PurchaseOrderLineStatus[]
) => status.includes(nowStatus);

export const isExistPoLineViewStatusIn = (
  nowStatus: PoLineUrlStatusType | ":status",
  status: Array<PoLineUrlStatusType | ":status">
) => status.includes(nowStatus);

export const isNotExistPoLineViewStatusIn = (
  nowStatus: PoLineUrlStatusType | ":status",
  status: Array<PoLineUrlStatusType | ":status">
) => !status.includes(nowStatus);

export const multiplePoEventTypeTackBackValue = (poEventType: PurchaseOrderEventType, value: number): number => {
  if (utils.isEmpty(value)) {
    return null;
  }
  if (value === 0) {
    return 0;
  }
  const { isTakeBackPurchaseOrder, isConsignmentTakeBackPurchaseOrder } =
    getCheckPurchaseOrderEventTypeResults(poEventType);
  const multiple = isTakeBackPurchaseOrder || isConsignmentTakeBackPurchaseOrder ? -1 : 1;
  return value * multiple;
};

type PoLineType = Pick<
  PurchaseOrderLineList_purchaseOrderLines_edges_node | PurchaseOrderDetails_purchaseOrder_lines,
  | "isTaxFree"
  | "quantity"
  | "purchaseQuantity"
  | "deliveryFeeExcludeVat"
  | "takeBackUnitCostDeliveryFeeExcludeVat"
  | "consignmentUnitDeliveryAdditionalFeeExcludeVat"
  | "costPriceExcludeVat"
  | "devCostExcludeVat"
  | "etcExcludeVat"
  | "b2bDeliveryFeeExcludeVat"
> & {
  shippingAddress: Pick<PurchaseOrderDetails_purchaseOrder_lines["shippingAddress"], "postalCode">;
};

interface CalcFnProps extends PurchaseOrderLineColProps {
  record: PoLineType;
  poEventType: PurchaseOrderEventType;
  isB2b: boolean;
  status: PurchaseOrderLineStatus;
}

// 발주 제품의 납품 예정 수량 - 재고 발주에서 출고 지시가 되기 전까진 purchaseQuantity = 0이므로, 납품 예정 수량이라는 의미에서 quantity를 반환
export const getPoLineExpectedPurchaseQty = (
  poEventType: PurchaseOrderEventType,
  poLine: Pick<PoLineType, "quantity" | "purchaseQuantity">
) => {
  if (utils.isEmpty(poLine)) {
    return null;
  }
  const purchaseQuantity = poLine.purchaseQuantity;
  const value = purchaseQuantity === 0 ? poLine.quantity : purchaseQuantity;
  return multiplePoEventTypeTackBackValue(poEventType, value);
};

export const calcPoLineDeliveryFeeExcludeVat = (props: Pick<CalcFnProps, "record" | "poEventType">) => {
  const { record, poEventType } = props;
  const isConsignmentTakeBack = checkConsignmentTakeBackPurchaseOrder(poEventType);
  if (isConsignmentTakeBack) {
    return 0;
  }
  return record.deliveryFeeExcludeVat;
};

export const calcPoLineDeliveryAdditionalFeeExcludeVat = (
  props: Pick<CalcFnProps, "record" | "poEventType" | "courierDeliveryAdditionalFeeList">
) => {
  const { record, poEventType, courierDeliveryAdditionalFeeList } = props;
  const isConsignmentTakeBack = checkConsignmentTakeBackPurchaseOrder(poEventType);
  if (isConsignmentTakeBack) {
    return 0;
  }
  const chargeDeliveryAdditionalFee = checkChargeDeliveryAdditionalFee(
    record.shippingAddress?.postalCode,
    courierDeliveryAdditionalFeeList
  );
  return chargeDeliveryAdditionalFee ? record.consignmentUnitDeliveryAdditionalFeeExcludeVat : 0;
};

export const calcPoLineCostPriceExcludeVat = (
  props: Pick<CalcFnProps, "record" | "poEventType" | "courierDeliveryAdditionalFeeList">
) => {
  const { record, poEventType } = props;
  const isConsignmentTakeBack = checkConsignmentTakeBackPurchaseOrder(poEventType);
  // 위탁 반품인 경우에는 원래 위탁 발주서의 매입가에서 배송비, 도서산간 추가배송비를 제외한 금액을 리턴 (배송비, 도서산간추가매송비는 반환 안함)
  if (isConsignmentTakeBack) {
    const deliveryFeeExcludeVat = calcPoLineDeliveryFeeExcludeVat({ ...props });
    const deliveryAdditionalFeeExcludeVat = calcPoLineDeliveryAdditionalFeeExcludeVat({ ...props });
    return record.costPriceExcludeVat - deliveryFeeExcludeVat - deliveryAdditionalFeeExcludeVat;
  }
  return record.costPriceExcludeVat;
};

export const calcPoLineTotalCostPriceExcludeVat = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType" | "courierDeliveryAdditionalFeeList">,
  precision: number,
  status?: PurchaseOrderLineStatus
) => {
  const { record, isConsignment, poEventType } = props;
  let costPriceExcludeVat = calcPoLineCostPriceExcludeVat({ ...props });
  // 위탁 발주인 경우에는 도서산간 추가 비용 포함 필요
  if (isConsignment) {
    const deliveryAdditionalFeeExcludeVat = calcPoLineDeliveryAdditionalFeeExcludeVat({ ...props });
    costPriceExcludeVat += deliveryAdditionalFeeExcludeVat;
  }

  const quantity = getPoLineExpectedPurchaseQty(poEventType, record);
  const totalCostPriceExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
    costPriceExcludeVat,
    quantity,
    record.isTaxFree,
    precision
  );

  return totalCostPriceExcludeVat;
};

export const calcPoLineTakeBackTotalCostDeliveryFeeExcludeVat = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType">
) => {
  const { record, poEventType } = props;
  const takeBackUnitCostDeliveryFeeExcludeVat = record?.takeBackUnitCostDeliveryFeeExcludeVat || 0;
  const quantityForPoLinePrice = getPoLineExpectedPurchaseQty(poEventType, record);
  const takeBackTotalCostDeliveryFeeExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
    takeBackUnitCostDeliveryFeeExcludeVat,
    quantityForPoLinePrice,
    false
  );

  return takeBackTotalCostDeliveryFeeExcludeVat;
};

export const calcPoLineTotalPriceExcludeVat = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType" | "courierDeliveryAdditionalFeeList" | "isB2b">,
  precision: number,
  status?: PurchaseOrderLineStatus
) => {
  const totalCostPriceExcludeVat = calcPoLineTotalCostPriceExcludeVat(
    {
      ...props,
    },
    precision,
    status
  );
  const calcVatTargetAmountValue = calcVatTargetAmountExcludeVat(props);
  const poLineTotalPriceExcludeVat = totalCostPriceExcludeVat + calcVatTargetAmountValue;

  return poLineTotalPriceExcludeVat;
};

// 과세 대상 금액 값 계산 (default 과세 대상금액이 있다면 여기에 추가)
export const calcVatTargetAmountExcludeVat = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType" | "courierDeliveryAdditionalFeeList" | "isB2b">
) => {
  const { record, poEventType, isB2b } = props;
  const isConsignmentTakeBack = checkConsignmentTakeBackPurchaseOrder(poEventType);
  let vatTargetAmount = record.devCostExcludeVat + record.etcExcludeVat;
  if (isConsignmentTakeBack && isB2b === false) {
    vatTargetAmount += calcPoLineTakeBackTotalCostDeliveryFeeExcludeVat(props);
  }
  if (isB2b) {
    vatTargetAmount += record.b2bDeliveryFeeExcludeVat;
  }

  return vatTargetAmount;
};

export const calcPoLineVatAmount = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType" | "courierDeliveryAdditionalFeeList" | "isB2b">,
  precision: number,
  status?: PurchaseOrderLineStatus
) => {
  const { record } = props;
  const { isTaxFree } = record;
  const poLineTotalCostPriceExcludeVat = calcPoLineTotalCostPriceExcludeVat(
    {
      ...props,
    },
    precision,
    status
  );
  const poLineTotalDeliveryFee = calcVatTargetAmountExcludeVat(props);
  const vatAmount =
    toPriceIncludeVat(poLineTotalCostPriceExcludeVat, isTaxFree, precision) -
    poLineTotalCostPriceExcludeVat +
    calcDeliveryFeeVat(poLineTotalDeliveryFee);
  return vatAmount;
};

export const calcPoLineTotalPrice = (
  props: Pick<CalcFnProps, "record" | "isConsignment" | "poEventType" | "courierDeliveryAdditionalFeeList" | "isB2b">,
  precision: number,
  status?: PurchaseOrderLineStatus
) => {
  const { record, isB2b } = props;
  let poLineTotalPriceExcludeVat = calcPoLineTotalPriceExcludeVat(props, precision, status);
  if (isB2b && record.isTaxFree) {
    const poLineTotalVat = calcPoLineVatAmount(props, precision, status);
    poLineTotalPriceExcludeVat += poLineTotalVat;
    return poLineTotalPriceExcludeVat;
  }

  return toPriceIncludeVat(poLineTotalPriceExcludeVat, record.isTaxFree, precision);
};

export const calcDeliveryFeeVat = (deliveryFeeExcludeVat: number) =>
  toPriceIncludeVat(deliveryFeeExcludeVat) - deliveryFeeExcludeVat;
</file>

