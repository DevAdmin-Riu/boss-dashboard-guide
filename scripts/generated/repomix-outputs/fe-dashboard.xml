import { User_brand_etcFiles } from "@src/api/fragments/types/User";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { NumberComponent } from "@src/app/components/Number";
import {
  getBrandEtcFileDateRangeText,
  getBrandEtcFileTypeText,
  getBrandEtcInfoKey,
  makeBrandEtcFilesDataSource,
} from "@src/app/views/brand/brands/utils";
import { utils } from "@utils/utils";
import { Button, Modal, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

interface BrandEtcFileListForHqModalProps {
  open: boolean;
  etcFiles: User_brand_etcFiles[];
  etcInfo: any;
  onCancel: () => void;
}

export const BrandEtcFileListForHqModal: React.FC<BrandEtcFileListForHqModalProps> = (props) => {
  const { open, etcFiles, etcInfo, onCancel } = props;
  const [dataSource, setDataSource] = useState<User_brand_etcFiles[]>();

  useEffect(() => {
    const defaultContractDataSource = makeBrandEtcFilesDataSource(etcFiles, etcInfo, true);
    setDataSource(defaultContractDataSource);
  }, [open, etcFiles]);

  const columns: ColumnsType<User_brand_etcFiles> = [
    {
      key: "type",
      width: 120,
      align: "center",
      render: (_, record) => getBrandEtcFileTypeText(record?.type),
    },
    {
      title: "계약서",
      key: "file",
      width: 300,
      align: "left",
      render: (_, record) =>
        utils.isEmpty(record?.id, true) ? (
          "미계약"
        ) : utils.isEmpty(record?.url, true) ? (
          "-"
        ) : (
          <Typography.Link href={record.url} target="_blank">
            {record?.fileName || "파일 이름 없음"}
          </Typography.Link>
        ),
    },
    {
      title: "계약기간",
      key: "dateRange",
      width: 130,
      align: "center",
      render: (_, record) => getBrandEtcFileDateRangeText(record),
    },
    {
      title: "보증금 잔액",
      key: "deposit",
      width: 150,
      align: "right",
      render: (_, record) => {
        const targetKey = getBrandEtcInfoKey(record?.type);
        const value = etcInfo && Object.keys(etcInfo).includes(targetKey) ? etcInfo[targetKey] : null;
        return <NumberComponent value={value} includeCurrency />;
      },
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const modalFooter = <Button onClick={onCancel}>닫기</Button>;

  return (
    <Modal open={open} title="계약서 조회" onCancel={onCancel} width={750} footer={modalFooter} destroyOnClose>
      <Table {...commonTableProps} columns={columns} dataSource={dataSource} scroll={{ x: tableWidthSum }} />
    </Modal>
  );
};
</file>

