export const viewEtcDefaultDeliveryMethods = [
  OrderDeliveryMethodsEnum.BY_CUSTOMER_DIRECT,
  OrderDeliveryMethodsEnum.BY_QUICK_SERVICE,
  OrderDeliveryMethodsEnum.BY_RIU_DIRECT,
  OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE,
];

// 숫자를 OrderDeliveryMethodsEnum으로 변환하는 함수

export const convertToOrderDeliveryMethodEnum = (value: number | string): OrderDeliveryMethodsEnum => {
  const numericValue = typeof value === "string" ? parseInt(value, 10) : value;
  switch (numericValue) {
    case 1:
      return OrderDeliveryMethodsEnum.BY_COURIER;
    case 2:
      return OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE;
    case 3:
      return OrderDeliveryMethodsEnum.BY_QUICK_SERVICE;
    case 4:
      return OrderDeliveryMethodsEnum.BY_RIU_DIRECT;
    case 5:
      return OrderDeliveryMethodsEnum.BY_CUSTOMER_DIRECT;
    default:
      throw new Error(`배송방식 입력이 잘못되었습니다. 1 ~ 5중에 입력해주세요. 잘못된 값 : ${value}`);
  }
};

export const convertToFulfillTypeEnum = (value: number | string): FulfillTypeEnum => {
  switch (value) {
    case "재고":
      return FulfillTypeEnum.ALL_TRACK_INVENTORY;
    case "위탁":
      return FulfillTypeEnum.ALL_CONSIGNMENT;
    default:
      throw new Error(`출고유형 입력이 잘못되었습니다. "재고", "위탁"중에 입력해주세요. 잘못된 값 : ${value}`);
  }
};

const orderTypesForNonB2b = [
  OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK,
  OrderTypeEnum.BY_STAFF_FOR_BRAND,
  OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND,
  OrderTypeEnum.BY_STAFF_FOR_ETC,
  OrderTypeEnum.BY_USER,
];

const orderStatusForNonB2b = [OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED];

// 출고 지시 리스트 페이지에 이용되는 발주 구분
export const defaultPoEventTypeListForFulfillOrderLineList = getPoEventTypeFromPoLineRouteParams({
  inventoryType: "consignment",
  status: "dispatch-fulfillment",
});

export const getOrderLineListDefaultParams = (pathname: string): OrderLineListViewUrlQueryParams => {
  const commonParams: OrderLineListViewUrlQueryParams = {
    // 페이지 네이밍은 OrderLineList이지만 위탁 주문 내역에 대해서만 사용되고 있음. 페이지와 각 컴포넌트, 타입 자체 네이밍도 변경 필요
    orderLineListViewType: OrderLineListViewTypeEnum.CONSIGNMENT,
    orderType: orderTypesForNonB2b,
    orderStatus: orderStatusForNonB2b,
  };

  switch (pathname) {
    case orderLineListForPurchaseViewPathB:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FOR_PURCHASE,
        isByNonCourier: String(false),
        useAutoConsignmentPo: String(false),
      };
    case orderLineListForFulfillViewPathByCourier:
    case orderLineListForFulfillViewPathByCourierPriceAdjust:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FOR_FULFILL,
        isByNonCourier: String(false),
        purchaseOrderEventType: defaultPoEventTypeListForFulfillOrderLineList,
      };
    case orderLineListForFulfillViewPathByNonCourier:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FOR_FULFILL,
        isByNonCourier: String(true),
        purchaseOrderEventType: defaultPoEventTypeListForFulfillOrderLineList,
      };
    case fulfilledOrderLineListViewPathB:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FULFILLED,
      };
    case b2bPurchaseWriteListViewPath:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FOR_PURCHASE,
        isByNonCourier: String(true),
        orderType: [OrderTypeEnum.BY_STAFF_FOR_B2B],
        orderStatus: [],
      };
    case orderLineListB2bForFulfillViewPath:
      return {
        ...commonParams,
        orderLineListActionType: OrderLineListActionTypeEnum.FOR_FULFILL,
        isByNonCourier: String(true),
        orderType: [OrderTypeEnum.BY_STAFF_FOR_B2B, OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK],
        orderStatus: [],
        purchaseOrderEventType: defaultPoEventTypeListForFulfillOrderLineList,
      };
  }
};

export const getUnfulfilledOrderLineListDefaultParams = (
  pathname: string
): UnfulfilledOrderLineListViewUrlQueryParams => {
  // A는 재고, B는 위탁, C는 재고(기타), D는 합포장
  // 위탁은 별도 페이지(OrderLineListView)가 있어서 해당 함수에선 미선언
  switch (pathname) {
    case unfulfilledOrderLineListViewPathA:
      return {
        unfulfillmentViewType: UnfulfillmentViewTypeEnum.STOCK,
        orderStatus: [OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED],
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
      };
    case unfulfilledOrderLineListViewPathC:
      return {
        unfulfillmentViewType: UnfulfillmentViewTypeEnum.STOCK_ETC,
        orderStatus: [OrderStatusFilter.READY_TO_FULFILL_PLUS_BEING_APPROVED],
        deliveryMethods: viewEtcDefaultDeliveryMethods,
      };
    case unfulfilledOrderLineListViewPathD:
      return {
        unfulfillmentViewType: UnfulfillmentViewTypeEnum.PICKING_ORDER,
        orderStatus: [OrderStatusFilter.READY_TO_FULFILL],
        deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
      };
  }
};

export const getOrderDeliveryListDefaultParams = (pathname: string): OrderDeliveryListViewUrlQueryParams => {
  switch (pathname) {
    case orderDeliveryListViewPathA:
      return { orderDeliveryViewType: OrderDeliveryViewTypeEnum.STOCK };
    case orderDeliveryListViewPathBByCourier:
    case orderDeliveryListViewPathBByNonCourier:
    // B2B 는 위탁 상품이므로 위탁으로 고정. 추후에 변경된다면 해당 부분 수정
    case orderDeliveryListViewPathB2b:
    case vsB2bOrderDeliveryListViewPathBByNonCourier:
    case vsOrderDeliveryListViewPathBByNonCourier:
    case vsOrderDeliveryListViewPathBByCourier:
      return {
        orderDeliveryViewType: OrderDeliveryViewTypeEnum.CONSIGNMENT,
        purchaseOrderEventType: getPoEventTypeFromPoLineRouteParams({
          inventoryType: "consignment",
          status: "confirm-delivery",
        }),
        deliveryStatus: [FulfillmentDeliveryStatusFilter.READY_TO_DELIVERY],
      };
    case orderDeliveryListViewPathC:
      return {
        orderDeliveryViewType: OrderDeliveryViewTypeEnum.STOCK_ETC,
        deliveryStatus: [FulfillmentDeliveryStatusFilter.READY_TO_DELIVERY],
        deliveryMethods: viewEtcDefaultDeliveryMethods,
      };
  }
};

export const getFulfillmentInspectListDefaultParams = (): FulfillmentInspectListViewUrlQueryParams => {
  const defaultDeliveryStartDateTimeFrom = moment().startOf("day").format(ISOFormatWithTimeZone);
  const defaultDeliveryStartDateTimeTo = moment().endOf("day").format(ISOFormatWithTimeZone);
  return {
    isInspectCompleted: String(false),
    deliveryStartDateTimeFrom: defaultDeliveryStartDateTimeFrom,
    deliveryStartDateTimeTo: defaultDeliveryStartDateTimeTo,
  };
};

export const fbvOrderDeliveryListViewWrapperDefaultParams = (
  pathname: string
): FbvOrderDeliveryListViewUrlQueryParams | FbvOrderLineListViewUrlQueryParams => {
  switch (pathname) {
    case fbvOrderDeliverySectionUrl:
      return { orderType: orderTypesForNonB2b, orderStatus: orderStatusForNonB2b };
    case fbvOrderDeliveryListForFulfilledViewPath:
    case fbvOrderDeliveryListForTrackingViewPathA:
    case fbvOrderDeliveryListForCompletedViewPathA:
