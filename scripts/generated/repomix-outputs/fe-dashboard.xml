import { InfoOutlined } from "@ant-design/icons";
import { ChangeEvent } from "@hooks/useForm";
import { ConfigurationTypeFieldEnum } from "@src/api/types/globalTypes";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { Plugin_plugin_configuration } from "@src/app/views/settings/plugin/api/types/Plugin";
import { UserError } from "@src/global/core/types/types";
import { Button, Card, Col, Input, Row, Switch, Tooltip } from "antd";
import React from "react";

import { PluginDetailsPageFormData } from "../PluginsDetailsPage";

interface PluginSettingsProps {
  data: PluginDetailsPageFormData;
  errors: UserError[];
  disabled: boolean;
  onChange: (event: ChangeEvent) => void;
  fields: Plugin_plugin_configuration[];
}

const PluginSettings: React.FC<PluginSettingsProps> = ({ data, disabled, onChange, fields }) => (
  <Card title={<CardTitleAntd title="플러그인 설정" />}>
    <Row gutter={[12, 18]}>
      {data.configuration.map((field) => {
        const fieldData = fields.find((configField) => configField.name === field.name);
        return (
          <Col key={field.name} span={24}>
            {fieldData.type === ConfigurationTypeFieldEnum.BOOLEAN ? (
              <>
                <FormFieldAntd
                  label={fieldData.label}
                  subLabel={
                    fieldData.helpText && (
                      <Tooltip title={fieldData.helpText}>
                        <Button size="small" shape="circle" type="primary" icon={<InfoOutlined />} />
                      </Tooltip>
                    )
                  }
                >
                  <Switch
                    disabled={disabled}
                    checked={typeof field.value !== "boolean" ? field.value === "true" : field.value}
                    checkedChildren="True"
                    unCheckedChildren="False"
                    onChange={(value) => onChange({ target: { name: field.name, value } })}
                  />
                </FormFieldAntd>
              </>
            ) : (
              <FormFieldAntd label={fieldData.label} subLabel={fieldData.helpText}>
                <Input size="large" disabled={disabled} name={field.name} value={field.value} onChange={onChange} />
              </FormFieldAntd>
            )}
          </Col>
        );
      })}
    </Row>
  </Card>
);
export default PluginSettings;
</file>

