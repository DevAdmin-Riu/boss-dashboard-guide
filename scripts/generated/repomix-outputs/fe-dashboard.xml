<file path="src/app/views/product/products/components/SubPvAssignModal/SubPvAssignModal.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { SubPvFragment } from "@src/api/fragments/types/SubPvFragment";
import { SearchSubPvsVariables } from "@src/api/searches/types/SearchSubPvs";
import { useSubPvsSearch } from "@src/api/searches/useProductVariantSearch";
import { AssignSubPvToMainPvInput, ProductVariantManageEventTypeEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import SpreadFilter from "@src/app/components/Filter/SpreadFilter";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Form, Input, Modal, Row, Space, Table, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { productVariantManageEventTypeChoices } from "../../utils/data";
import { makePvOrBpvManageEventFormItems } from "../PvOrBpvManageEventModal";
import { getSubPvTableSettings } from "../SubPvCard/SubPvTableSettings";
import { createFilterStructure, getFilterOpts, getFilterVariables } from "./filters";

interface SubPvAssignModalProps {
  includeManageEvent?: boolean;
  loading: boolean;
  open: boolean;
  mainPvId: string;
  onSubmit: (formData: SubPvAssignModalForm) => void;
  onClose: () => void;
}

interface SubPvAssignModalForm extends AssignSubPvToMainPvInput {
  needReason: boolean;
}

export const SubPvAssignModal: React.FC<SubPvAssignModalProps> = (props) => {
  const { includeManageEvent = false, loading, open, mainPvId, onSubmit, onClose } = props;
  const initialQueryVariables: SearchSubPvsVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: getFilterVariables([]),
  };
  const [queryVariables, setQueryVariables] = useState<SearchSubPvsVariables>(initialQueryVariables);
  const [form] = Form.useForm<AssignSubPvToMainPvInput>();
  const subPvIdWatched = Form.useWatch("subPvId", form);

  const initialValues: SubPvAssignModalForm = {
    mainPvId,
    subPvId: null,
    manageEvent: {
      type: ProductVariantManageEventTypeEnum.TYPE_SUB_PV,
      title: null,
      reason: null,
    },
    needReason: true,
  };

  const filterOpts = getFilterOpts(queryVariables.filter);
  const filterStructure = createFilterStructure(filterOpts);

  const columns = getSubPvTableSettings({});
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const { loadMore, result } = useSubPvsSearch({ skip: !open, variables: initialQueryVariables });
  const { data, loading: subPvsLoading, refetch } = result;
  const dataSource = maybe(() => data.search.edges.map((edge) => edge.node), []).filter(
    (node) => node.mainPvs.map((mainPv) => mainPv?.id).indexOf(mainPvId) === -1
  );
  const hasMore = maybe(() => data.search.pageInfo.hasNextPage, false);

  useEffect(() => {
    if (open) {
      refetch();
    }
  }, [open]);

  const modalLoading = loading || subPvsLoading;

  const rowSelection: TableRowSelection<SubPvFragment> = {
    type: "radio",
    selectedRowKeys: [subPvIdWatched],
    onChange: (selectedRowKeys) => {
      if (selectedRowKeys.length > 0) {
        form.setFieldValue("subPvId", selectedRowKeys[0] as string);
      }
    },
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      width={1000}
      open={open}
      title="소모 부자재 선택"
      okText="선택"
      okButtonProps={{ disabled: utils.isEmpty(subPvIdWatched), loading: modalLoading }}
      onOk={form.submit}
      onCancel={onClose}
      afterClose={form.resetFields}
      maskClosable={false}
    >
      <Form layout="vertical" form={form} initialValues={initialValues} onFinish={onSubmit}>
        <Form.Item hidden name="mainPvId">
          <Input />
        </Form.Item>
        <Form.Item hidden name="subPvId">
          <Input />
        </Form.Item>
        <Space direction="vertical" size="large">
          <SpreadFilter
            currencySymbol="원"
            menu={filterStructure}
            onFilterChange={(filters) => {
              if (!open) {
                return;
              }
              const filterVariables = getFilterVariables(filters);
              const newQueryVariables = { ...queryVariables, filter: filterVariables };
              setQueryVariables(newQueryVariables);
              refetch(newQueryVariables);
            }}
            onFilterReset={() => {
              setQueryVariables(initialQueryVariables);
              refetch(initialQueryVariables);
            }}
          />
          <Table
            {...commonTableProps}
            tableLayout="fixed"
            loading={subPvsLoading}
            title={() => <Typography.Text strong>제품 검색 결과</Typography.Text>}
            columns={columns}
            dataSource={dataSource}
            rowSelection={rowSelection}
            scroll={{ x: tableWidthSum, y: 300 }}
            footer={
              hasMore &&
              (() => (
                <Row justify="center">
                  <Typography.Link onClick={loadMore}>더 보기</Typography.Link>
                </Row>
              ))
            }
          />
          {includeManageEvent && (
            <Card type="inner" title="제품 관리 이력">
              {makePvOrBpvManageEventFormItems({
                loading: modalLoading,
                manageEventType: ProductVariantManageEventTypeEnum.TYPE_SUB_PV,
                choices: productVariantManageEventTypeChoices,
              })}
            </Card>
          )}
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/products/components/SubPvCard/SubPvCard.tsx">
import { SubPvFragment } from "@src/api/fragments/types/SubPvFragment";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { utils } from "@utils/utils";
import { Button, Card, Empty, Space, Typography } from "antd";
import React from "react";

import { getSubPvTableSettings } from "./SubPvTableSettings";

interface SubPvCardProps {
  disabled: boolean;
  subPv: SubPvFragment;
  onProductClick: (productId: string) => void;
  onLocationClick: (variantId: string) => void;
  onAssign: () => void;
  onUnassign: (subPvId: string) => void;
}

export const SubPvCard: React.FC<SubPvCardProps> = (props) => {
  const { disabled, subPv, onProductClick, onLocationClick, onAssign, onUnassign } = props;
  const subPvExist = utils.isEmpty(subPv) ? false : true;
  const dataSource = subPvExist ? [subPv] : [];

  const columns = getSubPvTableSettings({ onProductClick, onLocationClick });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Card
      bodyStyle={{ padding: 0 }}
      title={<Typography.Title level={4}>소모 부자재</Typography.Title>}
      extra={
        <Space>
          <Button type="primary" disabled={disabled} onClick={onAssign}>
            {subPvExist ? "변경" : "연동"}
          </Button>
          <Button
            danger
            type="primary"
            disabled={disabled || subPvExist === false}
            onClick={() => onUnassign(subPvExist && subPv.id)}
          >
            연동 해제
          </Button>
        </Space>
      }
    >
      <PatchedColumnsTable
        {...commonTableProps}
        columns={columns}
        dataSource={dataSource}
        scroll={{ x: tableWidthSum, y: 500 }}
        locale={{
