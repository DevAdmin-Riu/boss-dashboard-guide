//     PROCESSING_FAILED = "PROCESSING_FAILED", "관련 리소스 생성 실패"
//     ON_GOING = "ON_GOING", "서명/열람 진행중"
//     ABORTED = "ABORTED", "서명/열람이 취소되거나 거절됨"
//     COMPLETED = "COMPLETED", "완료됨"
//     DRAFT = "DRAFT", "작성 중"

// magentaredvolcanoorangegoldlimegreencyanbluegeekbluepurple

import { ModusignDocStatusEnum } from "@src/api/types/globalTypes";

export const modusignDocStatusConvert = (status: ModusignDocStatusEnum) => {
  switch (status) {
    case ModusignDocStatusEnum.ON_PROCESSING:
      return "관련 리소스 생성 중";
    case ModusignDocStatusEnum.PROCESSING_FAILED:
      return "관련 리소스 생성 실패";
    case ModusignDocStatusEnum.ON_GOING:
      return "서명/열람 진행중";
    case ModusignDocStatusEnum.ABORTED:
      return "서명/열람이 취소 또는 거절";
    case ModusignDocStatusEnum.COMPLETED:
      return "완료됨";
    case ModusignDocStatusEnum.DRAFT:
      return "작성 중";
    default:
      return "";
  }
};

export const modusignDocStatusToTagColor = (status: ModusignDocStatusEnum) => {
  switch (status) {
    case ModusignDocStatusEnum.ON_PROCESSING:
      return "orange";
    case ModusignDocStatusEnum.PROCESSING_FAILED:
      return "red";
    case ModusignDocStatusEnum.ON_GOING:
      return "lime";
    case ModusignDocStatusEnum.ABORTED:
      return "magenta";
    case ModusignDocStatusEnum.COMPLETED:
      return "green";
    case ModusignDocStatusEnum.DRAFT:
      return "geekblue";
    default:
      return "grey";
  }
};

export const getModusignDocumentStatusChoices = () =>
  Object.values(ModusignDocStatusEnum).map((status) => ({
    label: modusignDocStatusConvert(status),
    value: String(status),
  }));
