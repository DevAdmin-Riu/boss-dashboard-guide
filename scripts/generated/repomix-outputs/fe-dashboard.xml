<file path="src/app/components/PriceWithVatFormItem.tsx">
import { calcVatByPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Col, Form, FormInstance, FormItemProps, InputNumber, InputNumberProps, Row, Typography } from "antd";
import { NamePath } from "antd/lib/form/interface";
import _ from "lodash";
import React, { useEffect, useState } from "react";

import { ProductCreateData } from "../views/product/products/components/ProductCreatePage/form";
import { ProductUpdateData } from "../views/product/products/components/ProductUpdatePage/form";
import { getNumberFormat } from "../views/product/products/utils/data";
import { getFormInputNumberVatValueRule } from "./antd/Form/validators";
import { getInputNumberProps } from "./antd/InputNumber/InputNumberProps";
import { FormFieldAntd } from "./FormFieldAntd";

interface FieldProps {
  name: NamePath;
  formItemProps?: FormItemProps;
  inputNumberProps?: InputNumberProps;
  isNotShowAddonBefore?: boolean;
}

export interface PriceWithVatFormItemProps {
  form: FormInstance;
  isTaxFree: boolean;
  label?: string;
  isRequired?: boolean;
  priceExcludeVatField: FieldProps;
  vatField: FieldProps;
  disabled?: boolean;
  minWidth?: string | number;
}

export const PriceWithVatFormItem: React.FC<PriceWithVatFormItemProps> = (props) => {
  const { form, isTaxFree, label, isRequired, priceExcludeVatField, vatField, disabled, minWidth } = props;
  const priceExcludeVatNamePath = priceExcludeVatField.name;
  const vatNamePath = vatField.name;
  const hideVatField = !!vatField.formItemProps?.hidden;
  const isNotShowAddonBefore = utils.isEmpty(priceExcludeVatField.isNotShowAddonBefore);
  return (
    <Form.Item
      label={label}
      required={isRequired}
      style={{ margin: 0, minWidth: minWidth ?? (isNotShowAddonBefore ? 150 : "100%") }}
    >
      <Form.Item style={{ margin: 0 }} {...priceExcludeVatField.formItemProps} name={priceExcludeVatNamePath}>
        <InputNumber
          {...getInputNumberProps({ isCommaDisplay: true, ...priceExcludeVatField.inputNumberProps })}
          style={{ width: "100%" }}
          addonBefore={isNotShowAddonBefore ? "공급가" : null}
          disabled={disabled || priceExcludeVatField.inputNumberProps?.disabled}
        />
      </Form.Item>
      <Form.Item
        hidden={hideVatField}
        style={{ margin: 0 }}
        shouldUpdate={(prev, curr) => {
          const prevPriceExcludeVat = _.get(prev, priceExcludeVatNamePath, null);
          const currPriceExcludeVat = _.get(curr, priceExcludeVatNamePath, null);
          const priceExcludeVatChanged = prevPriceExcludeVat !== currPriceExcludeVat;
          if (priceExcludeVatChanged) {
            const priceVat = calcVatByPriceExcludeVat(
              currPriceExcludeVat,
              isTaxFree,
              priceExcludeVatField?.inputNumberProps?.precision || 0
            );
            form.setFieldValue(vatNamePath, priceVat);
          }

          const prevPriceVat = _.get(prev, vatNamePath, null);
          const currPriceVat = _.get(curr, vatNamePath, null);
          const priceVatChanged = prevPriceVat !== currPriceVat;

          return priceExcludeVatChanged || priceVatChanged;
        }}
      >
        {({ getFieldValue }) => {
          const priceExcludeVatWatched = getFieldValue(priceExcludeVatNamePath);
          const priceVatWatched = getFieldValue(vatNamePath);
          const priceIncludeVatWatched = priceExcludeVatWatched + priceVatWatched;

          // 입력된 부가세 제외 금액이 10으로 나누어 떨어지는 경우 부가세 필드 disabled
          const isPriceExcludeVatDivisibleByTen = utils.isDivisible(priceExcludeVatWatched, 10);

          return (
            <Form.Item
              style={{ margin: 0 }}
              dependencies={[priceExcludeVatNamePath]} // 부가세 제외 금액 변경 시에도 부가세 필드 validate 동작 위해 전달
              extra={
                <Row justify="space-between">
                  <Col style={{ marginLeft: 8 }}>
                    <Typography.Text strong>합계:</Typography.Text>
                  </Col>
                  <Col style={{ marginRight: 8 }}>
                    <Typography.Text strong>{getNumberFormat(priceIncludeVatWatched)}</Typography.Text>
                  </Col>
                </Row>
              }
              {...vatField.formItemProps}
              name={vatNamePath}
              rules={[
                ...(vatField.formItemProps?.rules || []),
                getFormInputNumberVatValueRule({
                  priceExcludeVat: priceExcludeVatWatched,
                  isTaxFree,
                  pricision: vatField.inputNumberProps?.precision ? vatField.inputNumberProps.precision : 0,
                }),
              ]}
            >
              <InputNumber
                {...getInputNumberProps({ isCommaDisplay: true, ...vatField.inputNumberProps })}
                style={{ width: "100%" }}
                size="small"
                addonBefore={"부가세"}
                disabled={
                  disabled || isTaxFree || isPriceExcludeVatDivisibleByTen || vatField.inputNumberProps?.disabled
                }
              />
            </Form.Item>
          );
        }}
      </Form.Item>
    </Form.Item>
  );
};

// 제품 생성/수정 시에는 antd form을 사용하지 않아서 임시로 만든 컴포넌트
// 추후에 antd form으로 변경 시 해당 컴포넌트는 제거
interface PriceWithVatFieldProps {
  data: ProductCreateData | ProductUpdateData;
  /** 폼 필드 라벨 */
  label: string;
  /** 필수 여부 */
  isRequired?: boolean;
  namePath: string;
  vatNamePath: string;
  /** 공급가(부가세 제외) */
  priceExcludeVat: number;
  /** 폼이 disabled */
  disabled: boolean;
  /** 면세 상품 여부 */
  isTaxFree: boolean;
  /** 공급가 변경 시 호출 */
  onPriceChange: (value: number) => void;
  /** 부가세 변경 시 호출 (수동 입력 허용할 경우) */
  onVatChange?: (value: number) => void;
}

export const PriceWithVatField: React.FC<PriceWithVatFieldProps> = ({
  data,
  label,
  isRequired,
  namePath,
  vatNamePath,
  priceExcludeVat,
  disabled,
  isTaxFree,
  onPriceChange,
  onVatChange,
}) => {
  const isDivisibleByTen = utils.isDivisible(priceExcludeVat, 10);
  const computedVat = isDivisibleByTen
    ? calcVatByPriceExcludeVat(data.bpvPriceExcludeVat, isTaxFree)
    : data.bpvPriceVat;

  const includeVat = (data.bpvPriceExcludeVat ?? 0) + computedVat;
  const handlePriceChange = (value: number | null) => {
    const val = value ?? 0;
    onPriceChange(val);
    if (onVatChange) {
      onVatChange(calcVatByPriceExcludeVat(val, isTaxFree) ?? 0);
    }
  };

  // 에러 메시지 로컬 상태
  const [vatError, setVatError] = useState<string | null>(null);
  // 룰 객체
  useEffect(() => {
    getFormInputNumberVatValueRule({ priceExcludeVat: data.bpvPriceExcludeVat, isTaxFree })
      .validator(null, computedVat)
      .then(() => setVatError(null))
      .catch((err: Error) => setVatError(err.message));
  }, [data.bpvPriceExcludeVat, data.bpvPriceVat, isDivisibleByTen]);

  const handleVatChange = (value: number | null) => onVatChange?.(value ?? 0);
  return (
    <FormFieldAntd label={label} isRequired={isRequired}>
      <Row gutter={8} align="middle">
        <Col flex="1 1 0">
          <InputNumber
            value={priceExcludeVat}
            disabled={disabled}
            onChange={handlePriceChange}
            name={namePath}
            addonBefore="공급가"
            {...getInputNumberProps({ isCommaDisplay: true })}
            style={{ width: "100%" }}
          />
        </Col>

        {!isTaxFree && (
          <Col flex="1 1 0">
            <InputNumber
              value={computedVat}
              disabled={isTaxFree || disabled || isDivisibleByTen}
              onChange={handleVatChange}
              name={vatNamePath}
              addonBefore="부가세"
              {...getInputNumberProps({ isCommaDisplay: true })}
              style={{ width: "100%" }}
              status={vatError !== null ? "error" : ""}
            />
          </Col>
        )}
      </Row>
      {vatError && (
        <Row justify="end" style={{ marginTop: 2 }}>
          <Typography.Text strong type="danger">
            {vatError}
          </Typography.Text>
        </Row>
      )}

      {/* 합계 표시 */}
      <Row justify="end" style={{ marginTop: 2 }}>
        <Typography.Text strong>합계: {getNumberFormat(includeVat)}</Typography.Text>
      </Row>
    </FormFieldAntd>
  );
};
</file>

<file path="src/app/components/RequiredTypography.tsx">
import { utils } from "@utils/utils";
import { Typography } from "antd";
import React from "react";

interface RequiredTypographyProps {
  text: string | React.ReactNode;
  subText?: string | React.ReactNode;
  isRequired?: boolean;
  requiredMarkAlign?: "left" | "right";
}

const RequiredTypography: React.FC<RequiredTypographyProps> = ({
  text,
  subText,
  isRequired = true,
  requiredMarkAlign = "right",
}) => {
  const requiredText = (
    <Typography.Text type={"danger"} style={{ fontWeight: "bold", fontSize: 14 }}>
      *
    </Typography.Text>
  );
  const subTextContent =
    typeof subText === "string" ? (
      <Typography.Text type={"secondary"} style={{ fontSize: 12 }}>
        {"   "}
        {subText}
      </Typography.Text>
    ) : (
      <>
        {"   "}
        {subText}
      </>
    );
  return (
    <Typography>
      {isRequired && requiredMarkAlign === "left" && requiredText}
      {text}
      {isRequired && requiredMarkAlign === "right" && requiredText}
      {utils.isEmpty(subText, true) === false && subTextContent}
    </Typography>
  );
};
export default RequiredTypography;
</file>

