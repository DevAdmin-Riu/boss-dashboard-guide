import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  purchaseOrderCreateViewPath,
  PurchaseOrderCreateViewUrlQueryParams,
  purchaseOrderDetailsViewPath,
  purchaseOrderLineInspectViewPath,
  PurchaseOrderLineInspectViewUrlQueryParams,
  purchaseOrderLineListViewPath,
  PurchaseOrderLineListViewRouteParams,
  PurchaseOrderLineListViewUrlQueryParams,
  PurchaseOrderLineListViewUrlSortField,
} from "./urls";
import { getPurchaseOrderLineListDefaultParams } from "./utils";
import { PurchaseOrderCreateView } from "./view/PurchaseOrderCreateView/PurchaseOrderCreateView";
import { PurchaseOrderDetailsView } from "./view/PurchaseOrderDetailsView";
import { PurchaseOrderLineInspectView } from "./view/PurchaseOrderLineInspectView/PurchaseOrderLineInspectView";
import { PurchaseOrderLineListView } from "./view/PurchaseOrderLineListView/PurchaseOrderLineListView";

const PurchaseOrderLineListViewWrapper: React.FC<RouteComponentProps<PurchaseOrderLineListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const { inventoryType } = match.params;
  const defaultParams = getPurchaseOrderLineListDefaultParams(match.params);
  // @ts-ignore
  const sortedParams: PurchaseOrderLineListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    { ...qs },
    PurchaseOrderLineListViewUrlSortField,
    PurchaseOrderLineListViewUrlSortField.poLineNo,
    false
  );
  const params: PurchaseOrderLineListViewUrlQueryParams = { ...defaultParams, ...sortedParams };
  const isTrackInventory = inventoryType === "track-inventory";
  const { stockPurchaseOrder, consignment } = firstDepthMenuTitle;

  return (
    <>
      <WindowTitle title={isTrackInventory ? stockPurchaseOrder : consignment} />
      <PurchaseOrderLineListView defaultParams={defaultParams} params={params} isB2b={false} />
    </>
  );
};

const PurchaseOrderCreateViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: PurchaseOrderCreateViewUrlQueryParams = qs;
  return <PurchaseOrderCreateView params={params} isB2b={false} />;
};

const PurchaseOrderDetailsViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => (
