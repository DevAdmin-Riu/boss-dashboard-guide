interface SnapshotColumnConfig {
  title: string | string[];
  key: string;
  fieldKey: keyof MonthlyStockSnapshots_monthlyStockSnapshots_edges_node;
  width?: number;
}

interface MonthlyStockSnapshotsTableSettingsProps {
  params: MonthlyStockSnapshotsViewUrlQueryParams;
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[];
  setShowToBeChangedInfoData: React.Dispatch<
    React.SetStateAction<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node>
  >;
}

interface SalesRecord
  extends Pick<
    ProductVariantList_productVariants_edges_node,
    "canSaleByInner" | "isInner" | "trackInventory" | "qtyPerBox"
  > {
  outer?: { trackInventory: boolean; qtyPerBox: number };
  inner?: Record<string, any>;
}

const MonthlyStockSnapshotsTableSettings = (props: MonthlyStockSnapshotsTableSettingsProps) => {
  const { setShowToBeChangedInfoData, stoppedReasonChoices } = props;
  const fixedLeftFlag = utils.fixedLeftFlag();

  const getMonthlySnapshotValue = (
    record: MonthlyStockSnapshots_monthlyStockSnapshots_edges_node,
    fieldKey: keyof MonthlyStockSnapshots_monthlyStockSnapshots_edges_node,
    type: SalesInfoType
  ): number | string => {
    const value = record[fieldKey] as number;

    // MonthlyStockSnapshots record를 getSalesValueByType가 기대하는 형태로 변환
    const adaptedRecord: SalesRecord = {
      canSaleByInner: record.canSaleByInner,
      isInner: record.isInner,
      trackInventory: record.outerTrackInventory,
      outer: record.isInner
        ? { trackInventory: record.outerTrackInventory, qtyPerBox: record.outerQtyPerBox }
        : undefined,
      inner: record.innerSnapshot
        ? {
            [fieldKey]: record.innerSnapshot[fieldKey as keyof typeof record.innerSnapshot] as number,
          }
        : undefined,
      qtyPerBox: record.isInner ? record.qtyPerBox : record.outerQtyPerBox,
    };

    return getSalesValueByType({
      type,
      record: adaptedRecord as ProductVariantList_productVariants_edges_node,
      value,
      fieldKey: fieldKey as keyof TProductVariantForStockSalesKey,
      isFbv: false,
    });
  };

  // 렌더링 헬퍼 함수
  const renderColumnValue = (value: number | string) => {
    if (value === NA_VALUE_TEXT) {
      return <span style={naValueTextStyle}>{value}</span>;
    }
    return typeof value === "number" ? <NumberComponent value={value} /> : value;
  };

  const createSalesColumn = ({
    title,
    key,
    fieldKey,
    width = 120,
    type = SALES_INFO_TYPE.SEPARATED,
  }: {
    title: string | string[];
    key: string;
    fieldKey: keyof MonthlyStockSnapshots_monthlyStockSnapshots_edges_node;
    width?: number;
    type?: SalesInfoType;
  }): DownloadableColumnType<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node> => ({
    title,
    key,
    align: "right",
    width,
    onCell: (record) => {
      const showNA = shouldShowNAValue({
        type,
        record,
      });
      return showNA ? { style: { backgroundColor: "#f5f5f5" } } : {};
    },
    render: (_, record) => {
      const value = getMonthlySnapshotValue(record, fieldKey, type);
      return renderColumnValue(value);
    },
    renderExcel: (record) => getMonthlySnapshotValue(record, fieldKey, type),
  });
  const snapShowYearMonthColumn: DownloadableColumnType<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node> = {
    title: "기준일자",
    key: "sanpShowYearMonth",
    fixed: fixedLeftFlag,
    align: "center",
    width: 90,
    isPickerHide: true,
    render: (_, record) => getDateByFormat(record.statDate, onlyMonthFormat) || "-",
  };

  // 재고 상태 날짜 컬럼 생성 헬퍼
  const createStockStateDateColumn = ({
    title,
    key,
    fieldKey,
    width = 100,
  }: {
    title: string | string[];
    key: string;
    fieldKey: string;
    width?: number;
  }): DownloadableColumnType<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node> => ({
    title,
    key,
    align: "center",
    width,
    onCell: (record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      return showNA ? { style: { backgroundColor: "#f5f5f5" } } : {};
    },
    render: (_, record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      if (showNA) {
        return <span style={naValueTextStyle}>{NA_VALUE_TEXT}</span>;
      }
      return record.estShortageInfo?.[fieldKey] || "-";
    },
    renderExcel: (record) => {
      const showNA = shouldShowNAValue({
        type: SALES_INFO_TYPE.STOCK_STATUS,
        record,
        isFbv: false,
      });
      if (showNA) {
        return NA_VALUE_TEXT;
      }
      return record.estShortageInfo?.[fieldKey] || "-";
    },
  });

  // 제품 현황 관련 컬럼 생성 헬퍼
