import { useCustomerRefundCreateOrderRefundMutation } from "../../api/mutations";
import { OrderDetails_order } from "../../api/types/OrderDetails";

interface IOrderCancelForm extends Pick<OrderRefundInput, "bankCode" | "accountNumber" | "accountHolderName"> {
  refundReasonType: RefundReasonTypeEnum;
  refundReasonText: string;
}

interface OrderCancelDialogProps {
  confirmButtonState: ConfirmButtonTransitionState;
  open: boolean;
  onClose: () => void;
  onSubmit: () => void;
  shop: ShopInfo_shop;
  order: OrderDetails_order;
}

const OrderCancelDialog: React.FC<OrderCancelDialogProps> = (props) => {
  const { confirmButtonState, open, onClose, shop, order } = props;
  const { refundCancelReasonChoices, refundBankCodeChoices } = shop;

  const [form] = Form.useForm<IOrderCancelForm>();
  const refundReasonTypeWatched = Form.useWatch("refundReasonType", form);
  const refundReasonTextWatched = Form.useWatch("refundReasonText", form);
  const bankCodeWatched = Form.useWatch("bankCode", form);
  const accountNumberWatched = Form.useWatch("accountNumber", form);
  const accountHolderNameWatched = Form.useWatch("accountHolderName", form);

  const initialValues: IOrderCancelForm = {
    refundReasonType: RefundReasonTypeEnum.SIMPLE_REMORSE,
    refundReasonText: "",
  };

  const isVbankPay = checkIsVbankPay(order?.lastPayment.token);

  const isPaymentStatusPending = order?.paymentStatus === PaymentChargeStatusEnum.PENDING;
  const isVirtualBankPendingStatus = isVbankPay && isPaymentStatusPending;

  const [customerRefundCreateOrderRefundMutation] = useCustomerRefundCreateOrderRefundMutation({
    onCompleted: async (res) => {
      const errors = res.customerRefundCreateOrderRefund.errors;
      if (errors.length > 0) {
        showNotificationError(errors[0].message);
      } else {
        showNotificationSuccess("주문 취소가 완료되었습니다.");
        onClose();
      }
    },
    onError: () =>
      showNotificationError(
        '주문 취소중 에러가 발생하였습니다. 환불 신청중 에러가 발생하였습니다. "가상계좌 입금 건"이라면 입금계좌, 은행, 예금주명을 확인해주시고, 아니시라면 고객센터로 문의해 주세요.'
      ),
  });

  const onFinish = (formData: IOrderCancelForm) => {
    if (utils.isEmpty(formData.refundReasonType)) {
      showNotificationError("사유를 선택해주세요.");
      return;
    }

    // 기타(직접 입력)인 경우에만 추가 사유 필수
    if (formData.refundReasonType === RefundReasonTypeEnum.ETC && utils.isEmpty(formData.refundReasonText)) {
      showNotificationError("기타(직접 입력)는 추가 사유가 필수입니다. 추가 사유를 작성해주세요.");
      return;
    }

    const orderRefundInput: OrderRefundInput = {
      amount: order.lastPayment.amount,
      cashableCredits: order.lastPayment.cashableCredits,
      nonCashableCredits: order.lastPayment.nonCashableCredits,
      rcoins: order.lastPayment.rcoins,
      refundLines: order.lines.map((item) => {
        const order_refund_line_input: OrderRefundLineInput = {
          orderLineId: item.id,
          qty: item.orderedOrFulfillQty,
          returnDeliveryFee: 0,
        };
        return order_refund_line_input;
      }),
      requestOriginType: RequestOriginTypeEnum.DASHBOARD,
      allCancelRefund: true,
      bankCode: formData.bankCode,
      accountNumber: formData.accountNumber,
      accountHolderName: formData.accountHolderName,
    };

    const customerRefundCreateInput: CustomerRefundCreateInput = {
      qType: RefundQuestionTypeEnum.CANCEL,
      order: order.id,
      qReasonType: refundReasonTypeWatched,
      qReasonText: refundReasonTextWatched,
    };
    if (isVbankPay) {
      customerRefundCreateInput.qRefundAccountInfo = {
        bankCode: bankCodeWatched ? bankCodeWatched : undefined,
        accountNumber: accountNumberWatched ? accountNumberWatched : "",
        accountHolderName: accountHolderNameWatched ? accountHolderNameWatched : "",
      };
    }

    customerRefundCreateOrderRefundMutation({
      variables: {
        input: {
          orderId: order.id,
          orderRefundInput,
          customerRefundCreateInput,
        },
      },
    });
  };

  const modalFooter = (
    <Space>
      <Button onClick={onClose}>{buttonText.back}</Button>
      {!isVirtualBankPendingStatus && (
        <ConfirmButton
          onClick={() => {
            form.submit();
          }}
          transitionState={confirmButtonState}
          variant="contained"
          type="submit"
        >
          {buttonText.accept}
        </ConfirmButton>
      )}
    </Space>
  );

  return (
    <Modal
      open={open}
      title={`주문번호: ${order.composedIdWithPrefix} 주문 취소`}
      onCancel={onClose}
      footer={modalFooter}
      destroyOnClose={true}
      maskClosable={false}
    >
      <Form size="large" form={form} layout="vertical" onFinish={onFinish} initialValues={initialValues}>
        {isVirtualBankPendingStatus ? (
          <Typography.Text type="warning" strong>
            가상계좌 입금 대기중 입니다.
          </Typography.Text>
        ) : (
          <>
            <Card size="small" title={<Typography.Title level={4}>사유 정보</Typography.Title>}>
              <Form.Item name="refundReasonType" label={<Typography.Title level={5}>사유 선택</Typography.Title>}>
                <Radio.Group>
                  {refundCancelReasonChoices
                    .filter((item) => item.value !== RefundReasonTypeEnum.MANAGE_CANCEL)
                    .map((item) => (
                      <Radio style={{ display: "block" }} key={item.value} value={item.value}>
                        {item.label}
                      </Radio>
                    ))}
                </Radio.Group>
              </Form.Item>
              {refundReasonTypeWatched === RefundReasonTypeEnum.ETC && (
                <Form.Item
                  label={<Typography.Title level={5}>추가 사유 작성</Typography.Title>}
                  name="refundReasonText"
                >
                  <Input placeholder="추가 사유를 작성해주세요." />
                </Form.Item>
              )}
            </Card>

            {isVbankPay && (
              <>
                <CardSpacer />
                <Card size="small" title={<Typography.Title level={4}>환불 계좌 정보</Typography.Title>}>
                  <Form.Item label={<Typography.Title level={5}>예금주</Typography.Title>} name="accountHolderName">
                    <Input placeholder="예금주를 작성해주세요." />
                  </Form.Item>
                  <Form.Item label={<Typography.Title level={5}>은행</Typography.Title>} name="bankCode">
                    <Select
                      showSearch
                      placeholder="은행을 선택하세요."
                      filterOption={(input, option) =>
                        (option?.label ?? "").toLowerCase().includes(input.toLowerCase())
                      }
                      options={refundBankCodeChoices}
                    />
                  </Form.Item>
                  <Form.Item label={<Typography.Title level={5}>계좌번호</Typography.Title>} name="accountNumber">
                    <Input placeholder="계좌번호를 입력해주세요." />
                  </Form.Item>
                </Card>
              </>
            )}
          </>
        )}
      </Form>
    </Modal>
  );
};
export default OrderCancelDialog;
</file>

