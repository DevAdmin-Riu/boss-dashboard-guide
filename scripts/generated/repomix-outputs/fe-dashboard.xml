<file path="src/app/views/purchase/vendors/components/VendorListPage/VendorListPage.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import NumberComponent from "@src/app/components/Number";
import TableListFooter from "@src/app/components/TableListFooter";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, Descriptions, Divider, Row, Space, Typography } from "antd";
import DescriptionsItem from "antd/lib/descriptions/Item";
import React from "react";

import { useVendorStaffBulkCreateMutation, useVendorStaffCreateMutation } from "../../api/mutations";
import { Vendors, Vendors_vendors_edges_node, VendorsVariables } from "../../api/types/Vendors";
import { VendorStaffBulkCreate } from "../../api/types/VendorStaffBulkCreate";
import { VendorStaffCreate } from "../../api/types/VendorStaffCreate";
import { createFilterStructure, VendorListFilterKeys, VendorListFilterOpts } from "./filters";
import { getVendorTableSettings } from "./VendorListTableSettings";

export interface VendorListPageProps
  extends PaginateListProps,
    FilterPageProps<VendorListFilterKeys, VendorListFilterOpts> {
  vendors: Vendors_vendors_edges_node[];
  onAdd: () => void;

  queryVariablesWithoutPagination: VendorsVariables;
  fetchForDownload: (variables?: VendorsVariables) => Promise<ApolloQueryResult<Vendors>>;
}

const VendorListPage: React.FC<VendorListPageProps> = (props) => {
  const {
    currentTab,
    filterOpts,
    tabs,
    vendors,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;

  const makeBulkCreateVendorStaffResultUi = (data: VendorStaffBulkCreate) => (
    <Space direction="vertical">
      <Typography.Text strong>협력사 관리자 계정 생성 결과</Typography.Text>
      <Divider />
      <Descriptions
        column={1}
        bordered={true}
        size="small"
        labelStyle={{ width: "70%" }}
        contentStyle={{ fontWeight: "bold" }}
      >
        <DescriptionsItem label="전체 협력사 수" contentStyle={{ float: "right" }}>
          <NumberComponent value={data.vendorStaffBulkCreate.totalVendorCount} />
        </DescriptionsItem>
        <DescriptionsItem label="관리자 계정 생성 완료" contentStyle={{ float: "right" }}>
          <NumberComponent
            value={
              data.vendorStaffBulkCreate.alreadyCreateVendorStaffCount +
              data.vendorStaffBulkCreate.createVendorStaffCount
            }
          />
        </DescriptionsItem>
        <DescriptionsItem label="관리자 계정 생성 실패" contentStyle={{ float: "right" }}>
          <NumberComponent value={data.vendorStaffBulkCreate.createVendorStaffFailCount} />
        </DescriptionsItem>
      </Descriptions>
      <Divider />
      {data.vendorStaffBulkCreate.createVendorStaffFailCount > 0 && (
        <Typography.Text type="danger" style={{ fontSize: "14px" }}>
          관리자 계정 생성에 실패한 협력사의 주문 담당자 이메일과 전화번호 정보를 확인해 주세요.
        </Typography.Text>
      )}
    </Space>
  );

  const handleBulkCreateVendorStaff = (data: VendorStaffBulkCreate) => {
    const errors = data.vendorStaffBulkCreate.errors;
    if (errors.length === 0) {
      showNotificationWarn(makeBulkCreateVendorStaffResultUi(data));
    } else {
      showGqlErrors(errors);
    }
  };

  const [bulkCreateVendorStaff, bulkCreateVendorStaffOpts] = useVendorStaffBulkCreateMutation({
    onCompleted: handleBulkCreateVendorStaff,
  });

  const handleCreateVendorStaff = (data: VendorStaffCreate) => {
    const errors = data.vendorStaffCreate.errors;
    if (errors.length === 0) {
      showNotificationWarn(
        "협력사 관리자 계정이 생성되었습니다. 비밀번호 찾기 시 협력사 정보의 메인 주문담당자 이메일로 비밀번호 재설정 메일이 발송됩니다."
      );
    } else {
      showGqlErrors(errors);
    }
  };

  const [createVendorStaff, createVendorStaffOpts] = useVendorStaffCreateMutation({
    onCompleted: handleCreateVendorStaff,
  });
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const filterStructure = createFilterStructure(filterOpts);
  const columns = getVendorTableSettings(props, createVendorStaff, createVendorStaffOpts);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "vendors",
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.vendorList}</Typography.Title>
          </Col>
          <Col>
            <Space direction="horizontal" size="small">
              <Button
                type="primary"
                shape="round"
                danger={true}
                onClick={() => bulkCreateVendorStaff()}
                disabled={bulkCreateVendorStaffOpts?.loading}
              >
                협력사 관리자 계정 생성
              </Button>
              <Button type="primary" shape="round" onClick={onAdd}>
                협력사 추가
              </Button>
            </Space>
          </Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <PatchedColumnsTable
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={vendors}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};

export default VendorListPage;
</file>

