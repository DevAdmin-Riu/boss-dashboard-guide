import gql from "graphql-tag";

import { CreateInicisApiKey, CreateInicisApiKeyVariables } from "./types/CreateInicisApiKey";
import { DeleteInicisApiKey, DeleteInicisApiKeyVariables } from "./types/DeleteInicisApiKey";
import { PluginUpdate, PluginUpdateVariables } from "./types/PluginUpdate";
import { UpdateInicisApiKey, UpdateInicisApiKeyVariables } from "./types/UpdateInicisApiKey";

const pluginUpdate = gql`
  ${pluginsDetailsFragment}
  ${pluginErrorFragment}
  mutation PluginUpdate($id: ID!, $input: PluginUpdateInput!) {
    pluginUpdate(id: $id, input: $input) {
      errors: pluginsErrors {
        ...PluginErrorFragment
      }
      plugin {
        ...PluginDetailsFragment
      }
    }
  }
`;
export const usePluginUpdate = makeMutation<PluginUpdate, PluginUpdateVariables>(pluginUpdate);

const createInicisApiKey = gql`
  ${pluginErrorFragment}
  ${inicisApiKeyFragment}
  mutation CreateInicisApiKey($input: InicisApiKeyInput!) {
    inicisApiKeyCreate(input: $input) {
      errors: pluginsErrors {
        ...PluginErrorFragment
      }
      brand {
        id
        inicisApiKeys {
          ...InicisApiKeyFragment
        }
      }
    }
  }
`;
export const useInicisApiKeyCreate = makeMutation<CreateInicisApiKey, CreateInicisApiKeyVariables>(createInicisApiKey);

const updateInicisApiKey = gql`
  ${pluginErrorFragment}
  ${inicisApiKeyFragment}
  mutation UpdateInicisApiKey($id: ID!, $input: InicisApiKeyInput!) {
    inicisApiKeyUpdate(id: $id, input: $input) {
      errors: pluginsErrors {
        ...PluginErrorFragment
      }
      brand {
        id
        inicisApiKeys {
          ...InicisApiKeyFragment
        }
      }
    }
  }
`;
export const useInicisApiKeyUpdate = makeMutation<UpdateInicisApiKey, UpdateInicisApiKeyVariables>(updateInicisApiKey);

const deleteInicisApiKey = gql`
  ${pluginErrorFragment}
  mutation DeleteInicisApiKey($id: ID!) {
    inicisApiKeyDelete(id: $id) {
      errors: pluginsErrors {
        ...PluginErrorFragment
      }
    }
