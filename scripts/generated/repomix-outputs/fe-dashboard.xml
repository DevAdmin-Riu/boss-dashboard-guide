import { DownloadOutlined, DownOutlined, UpOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps, getTableClassName } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { GridAttributes_availableInGrid_edges_node } from "@src/app/views/product/products/api/types/GridAttributes";
import {
  ProductList,
  ProductList_products_edges_node,
  ProductList_products_edges_node_variants,
  ProductListVariables,
} from "@src/app/views/product/products/api/types/ProductList";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { ProductListViewUrlSortField } from "../../urls";
import { createFilterStructure, ProductFilterKeys, ProductListFilterOpts } from "./filters";
import { getProductListTableSettings } from "./ProductListTableSettings";
import { createSorterStructure } from "./sorters";

interface ProductListPageProps
  extends PaginateListProps,
    FilterPageProps<ProductFilterKeys, ProductListFilterOpts>,
    SortPage<ProductListViewUrlSortField> {
  isFulfilledByVendor: boolean;
  activeAttributeSortId: string;
  availableInGridAttributes: GridAttributes_availableInGrid_edges_node[];
  currencySymbol: string;
  totalGridAttributes: number;
  products: ProductList_products_edges_node[];
  loading: boolean;
  shop: ShopInfo_shop;
  onProductVariantBulkUpdateOrCreate: (isB2b: boolean) => void;
  onProductListDownload: () => void;

  queryVariablesWithoutPagination: ProductListVariables;
  fetchForDownload: (variables?: ProductListVariables) => Promise<ApolloQueryResult<ProductList>>;
}

export interface ProductDataSourceType extends ProductList_products_edges_node {
  variant: ProductList_products_edges_node_variants;
  children?: ProductDataSourceType[];
}

export const makeNewDataSource = (nodes: ProductList_products_edges_node[]): ProductDataSourceType[] =>
  nodes.map((product) => {
    const { defaultVariantId, variants } = product;
    const defaultVariant = variants?.find((variant) => variant.id === defaultVariantId);
    const variantsExcludeDefault = variants?.filter((variant) => variant.id !== defaultVariantId);
    return {
      ...product,
      variant: defaultVariant,
      children:
        variantsExcludeDefault?.length > 0 && variantsExcludeDefault?.map((variant) => ({ ...product, variant })),
    };
  });

export const ProductListPage: React.FC<ProductListPageProps> = (props) => {
  const {
    isFulfilledByVendor,
    currencySymbol,
    currentTab,
    defaultSettings,
    availableInGridAttributes,
    filterOpts,
    loading,
    tabs,
    totalGridAttributes,
    products,
    shop,
    activeAttributeSortId,
    sort,
    onAdd,
    onAll,
    onProductVariantBulkUpdateOrCreate,
    onProductListDownload,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onRowClick,
    onSort,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const { stoppedReasonChoices } = shop;
  const [dataSource, setDataSource] = useState<ProductDataSourceType[]>();
  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const sectionName = isFulfilledByVendor ? sectionNames.productsB : sectionNames.productsA;
  const filterStructure = createFilterStructure(filterOpts, isFulfilledByVendor);
  const sorterStructure = createSorterStructure(availableInGridAttributes, isFulfilledByVendor);

  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);

  const columns = getProductListTableSettings({
    ...listProps,
    isFulfilledByVendor,
    availableInGridAttributes,
    stoppedReasonChoices,
    onRowClick,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const buttonDisabled = listProps.disabled || loading;

  const productVariantBulkUpdateOrCreateButton = (
    <Button
      type="primary"
      shape="round"
      disabled={buttonDisabled}
      onClick={() => onProductVariantBulkUpdateOrCreate(false)}
    >
      포장보스 제품정보 일괄 등록/수정
    </Button>
  );
  const b2bProductVariantBulkUpdateOrCreateButton = (
    <Button
      type="primary"
      shape="round"
      disabled={buttonDisabled}
      onClick={() => onProductVariantBulkUpdateOrCreate(true)}
    >
      B2B 제품정보 일괄 등록/수정
    </Button>
  );
  const downloadProductListBtn = (
    <Button
      icon={<DownloadOutlined />}
      type="primary"
      shape="round"
      disabled={buttonDisabled}
      onClick={onProductListDownload}
    >
      제품 리스트 다운로드
    </Button>
  );
  const addProductButton = (
    <Button type="primary" shape="round" disabled={buttonDisabled} onClick={onAdd}>
      신규 제품 생성
    </Button>
  );

  const tableTitle = () => {
    const noExpanded = !expandedRowKeys || expandedRowKeys.length === 0;
    const arrowIcon = noExpanded ? <DownOutlined /> : <UpOutlined />;
    const buttonText = `옵션 정보 ${noExpanded ? "펼치기" : "숨기기"}`;
    return (
      <Typography.Link
        style={{ color: "black" }}
        onClick={() => {
          if (noExpanded) {
            const allRowKeys = dataSource
              ?.filter((product) => product.children?.length > 0)
              ?.map((product) => product?.variant?.id);
            setExpandedRowKeys(allRowKeys);
          } else {
            setExpandedRowKeys([]);
          }
        }}
      >
        <Space direction={"horizontal"}>
          {arrowIcon}
          {buttonText}
        </Space>
      </Typography.Link>
    );
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "products",
    processNodesToDataType: makeNewDataSource,
    makeChildrenFlat: true,
  };

  useEffect(() => {
    if (products) {
      const newDataSource: ProductDataSourceType[] = makeNewDataSource(products);
      setDataSource(newDataSource);
    } else {
      setDataSource([]);
    }
  }, [products]);

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionName}</Typography.Title>
        </Col>
        <Col>
          <Space direction="horizontal">
            {b2bProductVariantBulkUpdateOrCreateButton}
            {productVariantBulkUpdateOrCreateButton}
            {downloadProductListBtn}
            {addProductButton}
          </Space>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
              <SorterDropdown
                sorterStructure={sorterStructure}
                activeSortId={activeAttributeSortId}
                sort={sort}
                onSort={onSort}
              />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          className={getTableClassName(["ant-table-tree-data"])}
          loading={listProps.disabled}
          title={isFulfilledByVendor === false && tableTitle}
          rowKey={(record) => record.variant?.id || record?.id}
          columns={pickerSelectedColumns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
          expandable={{
            fixed: true,
            indentSize: 0,
            expandedRowKeys,
            rowExpandable: (record) => record?.children?.length > 0,
            onExpandedRowsChange: (expandedKeys) => setExpandedRowKeys(expandedKeys as string[]),
          }}
        />
      </Card>
    </Space>
  );
};

export default ProductListPage;
