import { MakerFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { MakerFilterKeys, MakerListFilterOpts } from "../../components/MakerListPage/filters";
import { MakerListViewUrlFilters, MakerListViewUrlFiltersEnum, MakerListViewUrlQueryParams } from "../../urls";

const MAKER_FILTERS_KEY = "makerFilters";

export function getFilterOpts(params: MakerListViewUrlFilters): MakerListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    makerSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.makerSearch, true), false),
      value: filterVariables.makerSearch,
    },
  };
}

export function getFilterVariables(params: MakerListViewUrlFilters): MakerFilterInput {
  return {
    makerSearch: params.makerSearch,
  };
}

export function getFilterQueryParam(filter: IFilterElement<MakerFilterKeys>): MakerListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case MakerFilterKeys.makerSearch:
      return getSingleValueQueryParam(filter, MakerListViewUrlFiltersEnum.makerSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<MakerListViewUrlFilters>(MAKER_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  MakerListViewUrlQueryParams,
  MakerListViewUrlFilters
>(MakerListViewUrlFiltersEnum);
</file>

