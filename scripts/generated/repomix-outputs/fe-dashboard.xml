export const checkIsAllowedMenuUrlForHqStaff = (user: User, shop: ShopInfo_shop, url: string): boolean => {
  const productSupplyContractFile = user.brand.etcFiles?.find(
    (file) => file.type === BrandEtcFileTypeEnum.PRODUCT_SUPPLY_CONTRACT
  );
  if (utils.isEmpty(productSupplyContractFile) === false) {
    const isAfterToday = moment().isAfter(moment(productSupplyContractFile.endDate));
    const allowedUrlForContractEnded = [
      "/",
      pushSendEventListViewUrl(),
      staffDetailsViewUrl(user.id),
      hqComplaintSendViewUrl,
    ];
    // allowedUrlForContractEnded 에 없는 페이지인 경우 return false
    if (
      isAfterToday &&
      user.brand.isRunning &&
      allowedUrlForContractEnded.every((allowedUrl) => allowedUrl.includes(url) === false)
    ) {
      showNotificationWarn("포장보스 이용을 위해 계약 갱신이 필요합니다. 담당 MD에게 연락 부탁드립니다.");
      return false;
    }
  }

  const menuStructureForB2b = createHqStaffMenuStructureForB2b();
  const menuStructureForLinkers = createHqStaffMenuStructureForLinkers(user);
  const menuStructureForBoss = createHqStaffMenuStructureForBoss(user, shop);
  const allMenuStructure = [...menuStructureForB2b, ...menuStructureForLinkers, ...menuStructureForBoss];
  // 메뉴 구조에 있는 url에 대해서만 체크하고 그 외에는 허용 (메뉴 구조에 없는 계정 설정, 알림 등의 페이지 고려)
  if (checkIsUrlIncludedByMenuStructure(allMenuStructure, url) === false) {
    return true;
  }

  const enabledForB2bService = checkIsEnableForB2bServiceByBrand(user.brand);
  const enabledForLinkersService = checkIsEnableForLinkersServiceByBrand(user.brand);
  const enabledForBossService = checkIsEnableForBossServiceByBrand(user.brand);
  const enabledForFbvService = checkIsEnableForFbvServiceByBrand(user.brand);

  const isAllowed =
    (enabledForB2bService && checkIsUrlIncludedByMenuStructure(menuStructureForB2b, url)) ||
    (enabledForLinkersService && checkIsUrlIncludedByMenuStructure(menuStructureForLinkers, url)) ||
    ((enabledForBossService || enabledForFbvService) && checkIsUrlIncludedByMenuStructure(menuStructureForBoss, url));
  return isAllowed;
};
</file>

