<file path="src/app/views/hqStaff/hqSection/components/HqScheduleListPage/HqScheduleListPage.tsx">
import { LeftOutlined, ReloadOutlined, RightOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { scheduleColors } from "@assets/constants/colors";
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import { SearchHqStaffs_search_edges_node } from "@src/api/searches/types/SearchHqStaffs";
import { commonTableProps, getTableRowClassName } from "@src/app/components/antd/Table/TableProps";
import { BigCalendar } from "@src/app/components/Calendar/BigCalendar";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import { FetchMoreProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Badge, Button, Card, Checkbox, Col, Collapse, Row, Space, Table, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

import {
  HqScheduleList,
  HqScheduleList_schedules_edges_node,
  HqScheduleListVariables,
} from "../../api/types/HqScheduleList";
import { HqScheduleListViewUrlQueryParams } from "../../urls";
import { getHqScheduleListTableSettings } from "./HqScheduleListTableSettings";
import { expandRecurringSchedules } from "./utils";

export interface HqScheduleListPageProps {
  params: HqScheduleListViewUrlQueryParams;
  calendarRange: [Moment, Moment];
  selectedDate: Moment;
  scheduleList: HqScheduleList_schedules_edges_node[];
  loading: boolean;
  refetch: (variables?: Partial<HqScheduleListVariables>) => Promise<ApolloQueryResult<HqScheduleList>>;
  onRangeChange: (startDate: Moment, endDate: Moment) => void;
  onDateChange: (date: Moment) => void;
  onCreate: () => void;
  onUpdate: (scheduleId: string) => void;
  onDelete: (scheduleId: string) => void;
  onParamsChange: (newParams: HqScheduleListViewUrlQueryParams) => void;

  allHqStaffList: SearchHqStaffs_search_edges_node[];
  fetchMoreHqStaffs: FetchMoreProps;
}

export const HqScheduleListPage: React.FC<HqScheduleListPageProps> = (props) => {
  const {
    params,
    calendarRange,
    selectedDate,
    scheduleList,
    loading,
    refetch,
    onRangeChange,
    onDateChange,
    onCreate,
    onUpdate,
    onParamsChange,
    allHqStaffList,
    fetchMoreHqStaffs,
  } = props;
  const { user } = useUser();
  const columns = getHqScheduleListTableSettings(props, user);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const sideWidth = tableWidthSum + 50;

  const bigCalendarEvents = expandRecurringSchedules(scheduleList, calendarRange);
  const selectedDateEvents = bigCalendarEvents.filter(({ start, end }) =>
    selectedDate.isBetween(moment(start), moment(end), "day", "[]")
  );
  const selectedDateSchedules = selectedDateEvents
    .map<HqScheduleList_schedules_edges_node>((event) => ({
      ...event.resource,
      start: moment(event.start),
      end: moment(event.end),
    }))
    .sort((a, b) => a.start.diff(b.start));

  const getEventColorIdx = (writerId: string) => {
    if (writerId === user.id) {
      return 0;
    }
    const hqStaffIdListWithoutMe = allHqStaffList.filter((staff) => staff.id !== user.id).map((staff) => staff.id);
    return hqStaffIdListWithoutMe.indexOf(writerId || "") + 1;
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.schedule}</Typography.Title>
        </Col>
      </Row>

      <Card>
        <Space direction="vertical" size="large">
          <FixedSplitRow
            mainContent={
              <BigCalendar
                popup
                selectable
                defaultView="month"
                events={bigCalendarEvents}
                getEventColorIdx={(event) => getEventColorIdx(event.resource?.writer.id)}
                onSelectSlot={({ start, action }) => {
                  onDateChange(moment(start));
                  if (action === "doubleClick") {
                    onCreate();
                  }
                }}
                onSelectEvent={(event) => {
                  onDateChange(moment(event.start));
                  const scheduleId = event.resource?.id;
                  if (scheduleId) {
                    onUpdate(scheduleId);
                  }
                }}
                onRangeChange={(range, _view) => {
                  if ("start" in range && "end" in range) {
                    onRangeChange(moment(range.start), moment(range.end));
                  }
                }}
                dayPropGetter={(date) => {
                  const isSelected = moment(date).isSame(selectedDate, "day");
                  if (isSelected) {
                    return { className: "normal-selected" };
                  }
                  return {};
                }}
                components={{
                  toolbar: ({ label, view, date, onView, onNavigate }) => {
                    const today = moment();
                    const leftContent = (
                      <Space.Compact>
                        <Button icon={<LeftOutlined />} onClick={() => onNavigate("PREV")} />
                        <Button icon={<RightOutlined />} onClick={() => onNavigate("NEXT")} />
                        <Button
                          onClick={() => {
                            onDateChange(today);
                            onNavigate("DATE", today.toDate());
                          }}
                        >
                          오늘
                        </Button>
                        <Button icon={<ReloadOutlined />} onClick={() => refetch()} />
                      </Space.Compact>
                    );
                    const rightContent = (
                      <Space.Compact>
                        <Button onClick={() => onView("month")}>월</Button>
                        <Button onClick={() => onView("week")}>주</Button>
                        <Button onClick={() => onView("day")}>일</Button>
                        <Button onClick={() => onView("agenda")}>일정</Button>
                      </Space.Compact>
                    );
                    const getTitleText = () => {
                      switch (view) {
                        case "month":
                          return moment(date).format("YYYY / MM");
                        case "week":
                          return `${moment(date).startOf("week").format("YYYY / MM / DD")} ~ ${moment(date)
                            .endOf("week")
                            .format("DD")}`;
                        case "day":
                          return moment(date).format("YYYY / MM / DD (dd)");
                        default:
                          return label;
                      }
                    };
                    const title = <Typography.Title level={4}>{getTitleText()}</Typography.Title>;

                    return (
                      <Row style={{ marginBottom: 12 }} justify="space-between" align="middle">
                        <Col>{leftContent}</Col>
                        <Col>{title}</Col>
                        <Col>{rightContent}</Col>
                      </Row>
                    );
                  },
                  header: ({ date, label }) => {
                    const day = moment(date).day();
                    const color = day === 0 ? "red" : day === 6 ? "blue" : null;
                    return <Typography style={{ color }}>{label}</Typography>;
                  },
                }}
              />
            }
            sideContent={
              <Space direction="vertical">
                <Collapse style={{ width: sideWidth }} defaultActiveKey={["1"]}>
                  <Collapse.Panel header="작성자" key="1">
                    <Checkbox.Group
                      value={params?.writers || []}
                      onChange={(values) => onParamsChange({ writers: values as string[] })}
                    >
                      <Row justify="space-between" gutter={[16, 8]}>
                        {allHqStaffList.map((hqStaff) => {
                          const badgeColorIdx = getEventColorIdx(hqStaff.id) % scheduleColors.length;
                          const badgeColor = scheduleColors[badgeColorIdx];

                          return (
                            <Col xs={24} sm={12} key={hqStaff.id}>
                              <FixedSplitRow
                                mainContent={<Checkbox value={hqStaff.id}>{hqStaff.firstName}</Checkbox>}
                                sideContent={<Badge color={badgeColor} />}
                              />
                            </Col>
                          );
                        })}
                      </Row>
                      {fetchMoreHqStaffs.hasMore && (
                        <Row justify="center">
                          <Col>
                            <Button
                              type="link"
                              size="small"
                              onClick={() => fetchMoreHqStaffs.onFetchMore()}
                              loading={fetchMoreHqStaffs.loading}
                            >
                              더 보기
                            </Button>
                          </Col>
                        </Row>
                      )}
                    </Checkbox.Group>
                  </Collapse.Panel>
                </Collapse>
                <Table
                  {...commonTableProps}
                  rowClassName={getTableRowClassName(["ant-table-row-link"])}
                  style={{ width: sideWidth }}
                  title={() => <Typography.Text strong>{selectedDate.format("YYYY/MM/DD (dd)")}</Typography.Text>}
                  loading={loading}
                  columns={columns}
                  dataSource={selectedDateSchedules}
                  onRow={(record) => ({ onClick: () => onUpdate(record.id) })}
                  scroll={{ y: "40vh" }}
                  locale={{ emptyText: "선택된 날짜에 일정이 없습니다." }}
                />
              </Space>
            }
          />
        </Space>
      </Card>
    </Space>
  );
};
</file>

