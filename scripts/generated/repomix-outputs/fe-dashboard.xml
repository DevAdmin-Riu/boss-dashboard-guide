import { PopupList, PopupListVariables } from "./types/PopupList";

export const popupListQuery = gql`
  ${popupFragmentForList}
  ${pageInfoFragment}
  query PopupList(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $sort: PopupSortingInput
    $filter: PopupFilterInput
  ) {
    popups(before: $before, after: $after, first: $first, last: $last, sortBy: $sort, filter: $filter) {
      edges {
        node {
          ...PopupFragmentForList
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
