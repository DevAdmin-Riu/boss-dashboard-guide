  } else {
    const brandInfoColumns = [brandCodeColumn, brandNameColumn];
    const storeInfoColumns = [
      isB2b === false && brandStoreCodeColumn,
      isB2b === false && brandStoreNameColumn,
      userLoginIdColumn,
      userFirstNameColumn,
