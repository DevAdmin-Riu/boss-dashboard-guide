import { OrderTypeEnum, SalesB2bStatusEnum, SalesFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  B2bSettlementForSalesViewUrlFilters,
  B2bSettlementForSalesViewUrlFiltersEnum,
  B2bSettlementForSalesViewUrlFiltersWithMultipleValuesEnum,
  B2bSettlementForSalesViewUrlQueryParams,
} from "@src/app/views/b2b/urls";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  HqB2bSettlementFilterKeys,
  HqB2bSettlementListFilterOpts,
} from "../../components/HqB2bSettlementListPage/filter";

const HQ_SETTLEMENT_FILTERS_KEY = "hqSettlementFilters";

export function getFilterOpts(params: B2bSettlementForSalesViewUrlQueryParams): HqB2bSettlementListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  const firstDayOfLastMonth = todayMoment.clone().subtract(1, "month").startOf("month").format(onlyDateFormat);
  const lastDayOfLastMonth = todayMoment.clone().subtract(1, "month").endOf("month").format(onlyDateFormat);

  return {
    b2bOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bOrderSearch, true), false),
      value: maybe(() => filterVariables.b2bOrderSearch, ""),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: maybe(() => filterVariables.brandProductSearch, ""),
    },
    salesCloseDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.salesCloseDate.gte, filterVariables.salesCloseDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.salesCloseDate.lte, lastDayOfLastMonth),
        min: maybe(() => filterVariables.salesCloseDate.gte, firstDayOfLastMonth),
      },
    },
    b2bOrderCreatedAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.b2bOrderCreatedAt.gte, filterVariables.b2bOrderCreatedAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.b2bOrderCreatedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.b2bOrderCreatedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    b2bInvoicePrintedAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.b2bInvoicePrintedAt.gte, filterVariables.b2bInvoicePrintedAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.b2bInvoicePrintedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.b2bInvoicePrintedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    b2bStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.b2bStatus), []),
    },
    orderType: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderType), false),
      value: maybe(
        () => dedupeFilter(filterVariables.orderType.map((orderType) => findValueInEnum(orderType, OrderTypeEnum))),
        [OrderTypeEnum.BY_STAFF_FOR_B2B, OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK]
      ),
    },
  };
}

export function getFilterVariables(params: B2bSettlementForSalesViewUrlQueryParams): SalesFilterInput {
  return {
    b2bOrderSearch: params.b2bOrderSearch,
    brandProductSearch: params.brandProductSearch,
    salesCloseDate: getGteLteVariablesForMonth({
      gte: params.salesCloseDateFrom,
      lte: params.salesCloseDateTo,
    }),
    b2bOrderCreatedAt: getGteLteVariables({
      gte: params.b2bOrderCreatedAtFrom,
      lte: params.b2bOrderCreatedAtTo,
    }),
    b2bInvoicePrintedAt: getGteLteVariables({
      gte: params.b2bInvoicePrintedAtFrom,
      lte: params.b2bInvoicePrintedAtTo,
    }),
    b2bStatus: maybe(() => params.b2bStatus.map((b2bStatus) => findInEnum(b2bStatus, SalesB2bStatusEnum)), []),
    orderType: maybe(() => params.orderType.map((orderType) => findInEnum(orderType, OrderTypeEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<HqB2bSettlementFilterKeys>
): B2bSettlementForSalesViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqB2bSettlementFilterKeys.b2bOrderSearch:
      return getSingleValueQueryParam(filter, B2bSettlementForSalesViewUrlFiltersEnum.b2bOrderSearch);
    case HqB2bSettlementFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, B2bSettlementForSalesViewUrlFiltersEnum.brandProductSearch);
    case HqB2bSettlementFilterKeys.salesCloseDate:
      return getMinMaxQueryParam(
        filter,
        B2bSettlementForSalesViewUrlFiltersEnum.salesCloseDateFrom,
        B2bSettlementForSalesViewUrlFiltersEnum.salesCloseDateTo
      );
    case HqB2bSettlementFilterKeys.b2bOrderCreatedAt:
      return getMinMaxQueryParam(
        filter,
        B2bSettlementForSalesViewUrlFiltersEnum.b2bOrderCreatedAtFrom,
        B2bSettlementForSalesViewUrlFiltersEnum.b2bOrderCreatedAtTo
      );
    case HqB2bSettlementFilterKeys.b2bInvoicePrintedAt:
      return getMinMaxQueryParam(
        filter,
        B2bSettlementForSalesViewUrlFiltersEnum.b2bInvoicePrintedAtFrom,
        B2bSettlementForSalesViewUrlFiltersEnum.b2bInvoicePrintedAtTo
      );
    case HqB2bSettlementFilterKeys.b2bStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        B2bSettlementForSalesViewUrlFiltersWithMultipleValuesEnum.b2bStatus,
        SalesB2bStatusEnum
      );
    case HqB2bSettlementFilterKeys.orderType:
      return getMultipleEnumValueQueryParam(
        filter,
        B2bSettlementForSalesViewUrlFiltersWithMultipleValuesEnum.orderType,
        OrderTypeEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<B2bSettlementForSalesViewUrlFilters>(HQ_SETTLEMENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  B2bSettlementForSalesViewUrlQueryParams,
  B2bSettlementForSalesViewUrlFilters
>({ ...B2bSettlementForSalesViewUrlFiltersEnum, ...B2bSettlementForSalesViewUrlFiltersWithMultipleValuesEnum });
