): ColumnsType<SearchStockDetailEventsForLabel_search_edges_node> => {
  const { onRowClick } = props;
  const {
    product: { SKU, PRODUCT_NAME },
    vendor: { VENDOR_NAME },
    stock: { PURCHASE_TOTAL_QTY },
    purchaseOrder: { STOCKED_DATE },
  } = columnNameConstant;

  return [
    {
      title: STOCKED_DATE,
      key: "stockedDate",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.stockedDate} onlyDate />,
    },
    {
      title: "구분",
      key: "type",
      align: "center",
      width: 100,
      render: (_, record) => getStockDetailEventTypeName(record.type),
    },
    {
      title: SKU,
      key: "sku",
      align: "left",
      width: 120,
      render: (_, record) => record.stock?.productVariant.sku || "-",
    },
    {
      title: PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 150,
      render: (_, record) => {
        const productVariantEmpty = utils.isEmpty(record.stock?.productVariant);
        if (productVariantEmpty) {
          return "-";
        }
        return (
          <Typography.Link onClick={() => onRowClick(record.stock?.productVariant.product.id)}>
            {record.stock?.productVariant.product.name || "-"}
          </Typography.Link>
        );
      },
    },
    {
      title: PURCHASE_TOTAL_QTY,
      key: "quantity",
      align: "right",
      width: 80,
      render: (_, record) => {
        const quantity = record.quantity;
        const isInteger = checkIsInteger(quantity);
        return (
          <Typography.Text strong type="success">
            +
            <NumberComponent value={quantity} digits={isInteger ? 0 : 1} />
          </Typography.Text>
        );
      },
    },
    {
      title: "로케이션",
      key: "location",
      align: "center",
      width: 120,
      render: (_, record) => getLocationNameForLabel({ stockDetailEvent: record }),
    },
    {
      title: VENDOR_NAME,
      key: "vendor",
      align: "left",
      width: 150,
      render: (_, record) => getVendorByStockDetailEvent(record),
    },
    {
