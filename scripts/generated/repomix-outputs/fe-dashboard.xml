import { isStoppedSalesStatus } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Form, Row, Space, Typography } from "antd";
import moment from "moment";
import React, { useEffect, useMemo, useState } from "react";

import {
  useBrandProductVariantManageEventAddMutation,
  useExtendedBrandProductUpdateMutation,
} from "../../api/mutations";
import { BrandForBpvList_brand } from "../../api/types/BrandForBpvList";
import {
  BrandProductList_brandProducts_edges_node_brandProductVariants,
  BrandProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions,
} from "../../api/types/BrandProductList";
import { BrandProductAndBrandProductPackageType } from "../../views/BrandProductListView/types";
import {
  BrandProductFilterKeys,
  BrandProductListFilterOpts,
  createFilterStructure,
} from "../BrandProductListPage/filters";
import { BrandProductStoreDisplayModal } from "../BrandProductStoreDisplayModal/BrandProductStoreDisplayModal";
import {
  BrandProductVariantManageEventModal,
  BrandProductVariantManageEventModalForm,
} from "../BrandProductVariantManageEventModal";
import { getBrandProductListTableColumns } from "./BrandProductListTableSettings";
import { getBrandProductNameText, getBrandProductRows, getSelectedBrandProductVariantOrRegion } from "./utils";

// TODO: 패키지 상품 테이블이 이제 분리되었기 때문에 아래 타입은 필요 없을 것으로 보임. 추후 확인 후 정리 필요
export type BrandProductDataSourceType = BrandProductAndBrandProductPackageType & {
  leadTime?: number;
  brandProductVariant: BrandProductList_brandProducts_edges_node_brandProductVariants | null;
  children?: BrandProductDataSourceType[];
};

interface BrandProductListTableProps
  extends ListProps,
    FilterPageProps<BrandProductFilterKeys, BrandProductListFilterOpts> {
  brand: BrandForBpvList_brand;
  enableForB2bService: boolean;
  brandProducts: BrandProductAndBrandProductPackageType[];
  loading: boolean;
  isFulfilledByVendor: boolean;
  navigate: UseNavigatorResult;
  onProductAssign: () => void;
  onProductReorder: () => void;
  selectedRowId: string;
  setSelectedRowId: React.Dispatch<React.SetStateAction<string>>;
}

export type BrandProductFormType = BrandUpdateProductInput &
  StrictOmit<BrandUpdateProductVariantInput, "beforePrice" | "price" | "deliveryFee"> & {
    beforePriceExcludeVat?: number;
    // NOTE: 뮤테이션 input 처리 위해 매장 판매가의 폼 필드명은 price로 하되, 테이블(BrandProductListTableSettings.tsx)에서는 브랜드 판매가(brandPrice)와 구별하기 위해 mallPrice로 표시.
    priceExcludeVat: number;
    priceVat: number;
    costPriceExcludeVat: number;
    deliveryFeeExcludeVat: number;
    manageEvent: BrandProductVariantManageEventInput;
  };

enum BrandProductForTableModalModeEnum {
  UpdateVariantOrRegion = "UpdateVariantOrRegion",
  AddManageEvent = "AddManageEvent",
}

export const BrandProductListTable: React.FC<BrandProductListTableProps> = (props) => {
  const {
    brand,
    enableForB2bService,
    brandProducts,
    loading,
    isFulfilledByVendor,
    navigate,
    onProductReorder,
    onProductAssign,
    selectedRowId,
    setSelectedRowId,
    filterOpts,
    currencySymbol,
    currentTab,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const isBossMarket = brand?.isBossMarket || false;
  const { stoppedReasonChoices } = useShop();
  const [form] = Form.useForm<BrandProductFormType>();
  const filterStructure = createFilterStructure(filterOpts);

  // NOTE: 테이블 로우 직접 수정 시(onSubmit), selectedRowId만으로 수정할 로우 식별이 어려워서 추가
  const [selectedRowForSubmit, setSelectedRowForSubmit] = useState<BrandProductDataSourceType>(null);
  const [tableDataSource, setTableDataSource] = useState<BrandProductDataSourceType[]>([]);
  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const [modalModeForTable, setModalModeForTable] = useState<BrandProductForTableModalModeEnum>(null);
  const [storeDisplayModalOpen, setStoreDisplayModalOpen] = useState<boolean>(false);
  const [selectedBrandProductVariantId, setSelectedBrandProductVariantId] = useState<string>("");

  const onCancel = () => {
    form.resetFields();
    setSelectedRowId("");
    setSelectedRowForSubmit(null);
    setModalModeForTable(null);
  };

  // NOTE: 테이블에서 로우 직접 수정할 때, 폼에 선택된 중단 사유에 따라 실시간으로 기타 사유 입력칸 UI 노출 여부를 적용하기 위해 Form.useWatch 사용 및 props로 전달
  const stoppedReasonWatched = Form.useWatch("stoppedReason", form) as StoppedReasonTypeEnum | StoppedReasonTypeEnum;
  const priceExcludeVatWatched = Form.useWatch("priceExcludeVat", form);
  const priceVatWatched = Form.useWatch("priceVat", form);
  const costPriceExcludeVatWatched = Form.useWatch("costPriceExcludeVat", form);
  const deliveryFeeExcludeVatWatched = Form.useWatch("deliveryFeeExcludeVat", form);
  const showBeforePriceWatched = Form.useWatch("showBeforePrice", form);
  const beforePriceExcludeVatWatched = Form.useWatch("beforePriceExcludeVat", form);
  const salesStatusWatched = Form.useWatch("salesStatus", form);

  const watchedValues = {
    stoppedReason: stoppedReasonWatched,
    priceExcludeVat: priceExcludeVatWatched,
    priceVat: priceVatWatched,
    costPriceExcludeVat: costPriceExcludeVatWatched,
    deliveryFeeExcludeVat: deliveryFeeExcludeVatWatched,
    showBeforePrice: showBeforePriceWatched,
    beforePriceExcludeVat: beforePriceExcludeVatWatched,
    salesStatus: salesStatusWatched,
  };

  useEffect(() => {
    const brandProductRows = getBrandProductRows(brandProducts, true);
    // 패키지 테이블이 따로 있으므로 보스상품 테이블에서는 패키지 제외
    setTableDataSource(brandProductRows);
  }, [brandProducts, loading]);

  const [extendedBrandProductVariantUpdate, extendedBrandProductVariantUpdateOpts] =
    useExtendedBrandProductUpdateMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(data.extendedBrandProductUpdate?.errors, null, () => {
          onCancel();
        }),
    });

  const [brandProductVariantManageEventAdd, brandProductVariantManageEventAddOpts] =
    useBrandProductVariantManageEventAddMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.brandProductVariantManageEventAdd?.errors,
          "상품 관리 이력이 추가되었습니다.",
          () => {
            onCancel();
          }
        ),
    });

  const isEditing = (record: BrandProductDataSourceType) =>
    getSelectedBrandProductVariantOrRegion(record)?.id === selectedRowId;

  const onEdit = (record: BrandProductDataSourceType) => {
    const isTaxFree = !!record.product.isTaxFree;
    const selectedRecord = getSelectedBrandProductVariantOrRegion(record);
    const {
      id,
      salesStatus,
      stoppedAt,
      stoppedReason,
      stoppedReasonEtc,
      showBeforePrice,
      beforePriceAmount,
      priceAmount,
      priceVat,
      costPriceExcludeVat,
      deliveryFeeAmount,
    } = selectedRecord;
    const { forceNoNormalDisplay, needDeliveryAdditionalFee } = record.brandProductVariant;

    form.setFields([
      { name: "name", value: record?.name },
      { name: "isExclusive", value: record.isExclusive },
      { name: "isOnlyPayableByCash", value: record.isOnlyPayableByCash },
      { name: "isRcoinRewardForUsingPoint", value: record.isRcoinRewardForUsingPoint },
      { name: "salesStatus", value: salesStatus },
      { name: "stoppedAt", value: stoppedAt ? moment(stoppedAt, onlyDateFormat) : null },
      { name: "stoppedReason", value: stoppedReason },
      { name: "stoppedReasonEtc", value: stoppedReasonEtc },
      { name: "forceNoNormalDisplay", value: forceNoNormalDisplay },
      { name: "needDeliveryAdditionalFee", value: needDeliveryAdditionalFee },
      { name: "showBeforePrice", value: showBeforePrice },
      {
        name: "beforePriceExcludeVat",
        value: toPriceExcludeVat(beforePriceAmount, isTaxFree),
      },
      { name: "priceExcludeVat", value: priceAmount - priceVat },
      { name: "priceVat", value: priceVat },
      { name: "costPriceExcludeVat", value: costPriceExcludeVat },
      { name: "deliveryFeeExcludeVat", value: toPriceExcludeVat(deliveryFeeAmount) },
    ]);
    if (enableForB2bService) {
      form.setFields([
        {
          name: "includeSalesB2bDeliveryFee",
          value: record.brandProductVariant.includeSalesB2bDeliveryFee,
        },
      ]);
    }

    const isMileageRate = (
      target:
        | BrandProductList_brandProducts_edges_node_brandProductVariants
        | BrandProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions
    ): target is BrandProductList_brandProducts_edges_node_brandProductVariants =>
      (target as BrandProductList_brandProducts_edges_node_brandProductVariants).mileageRate !== undefined;

    if (isMileageRate(selectedRecord)) {
      form.setFields([{ name: "mileageRate", value: selectedRecord.mileageRate }]);
    }
    setSelectedRowId(id);
  };

  const makeRowIdForAddManageEvent = (recordId: string) => `${recordId}-addManageEvent`;
  const checkIsAddManageEventRow = () => selectedRowId.includes("-addManageEvent");
  const convertRowIdForAddManageEvent = (recordId: string) => recordId.replace("-addManageEvent", "");
  const onManageEventAdd = (record: BrandProductDataSourceType) => {
    const rowIdForAddManageEvent = makeRowIdForAddManageEvent(record.brandProductVariant?.id);
    setSelectedRowId(rowIdForAddManageEvent);
    setModalModeForTable(BrandProductForTableModalModeEnum.AddManageEvent);
  };

  const onStoreDisplay = (record: BrandProductDataSourceType) => {
    setSelectedBrandProductVariantId(record.brandProductVariant?.id || "");
    setStoreDisplayModalOpen(true);
  };

  const selectedBrandProductVariant = useMemo(() => {
    for (const bp of brandProducts) {
      const bpv = bp.brandProductVariants?.find((v) => v.id === selectedBrandProductVariantId);
      if (bpv) {
        return bpv;
      }
    }
    return null;
  }, [brandProducts, selectedBrandProductVariantId]);

  const onSubmitClick = (record: BrandProductDataSourceType) => {
    const validateUpdateInput = () => {
      const product = record.product;
      if (!product) {
        showNotificationError("브랜드 상품에 연결된 제품 정보가 없습니다.");
        return false;
      }
      const formData = form.getFieldsValue();
      // 부가세 별도 금액은 폼 데이터에서 제외 - convPriceForm에서 부가세 포함된 가격으로 변환하여 폼에 적용
      const { priceExcludeVat, costPriceExcludeVat, deliveryFeeExcludeVat, beforePriceExcludeVat, ...restForm } =
        formData;
      const precision = record.brandProductVariant?.productVariant?.priceDecimalPlaces;
      const convPriceForm = convertBrandProductPriceToIncludeVat(
        formData,
        product.isTaxFree,
        precision,
        enableForB2bService
      );
      const convForm = { ...restForm, ...convPriceForm };

      const { name: brandProductName, isExclusive, ...restInput } = convForm;
      const {
        salesStatus,
        stoppedAt: stoppedAtValue,
        stoppedReason,
        stoppedReasonEtc,
        showBeforePrice,
        beforePrice: beforePriceValue,
        price,
      } = restInput;
      const stoppedAt = stoppedAtValue?.format(onlyDateFormat);
      const isStoppedProductVariant = isStoppedSalesStatus(record?.brandProductVariant?.productVariant?.salesStatus);
      if (stoppedReason === StoppedReasonTypeEnum.ETC && utils.isEmpty(stoppedReasonEtc)) {
        showNotificationError("판매 중단 사유가 기타인 경우 판매 중단 상세 사유를 입력해 주세요.");
        return false;
      }
      if (salesStatus === SalesStatusEnum.ON_SALE) {
        if (isStoppedProductVariant) {
          showNotificationError("제품 상태가 단종인 경우에는 판매 상태로 변경할 수 없습니다.");
          return false;
        }
      } else {
        if (utils.isEmpty(stoppedReason)) {
          showNotificationError("판매 상태가 판매가 아닌 경우 판매 중단 사유를 입력해 주세요.");
          return false;
        }
        if (salesStatus === SalesStatusEnum.WILL_BE_STOPPED && utils.isEmpty(stoppedAt)) {
          showNotificationError("판매 상태가 중단 예정인 경우 판매 중단일을 입력해 주세요.");
          return false;
        }
      }
      const beforePrice = utils.isEmpty(beforePriceValue) || beforePriceValue === 0 ? null : beforePriceValue;
      if (showBeforePrice) {
        if (utils.isEmpty(beforePrice)) {
          showNotificationError("할인표시를 하기 위해서 할인 전 가격을 입력해 주세요.");
          return false;
        }
        if (beforePrice < price) {
          showNotificationError("할인 전 가격은 판매가보다 커야 합니다.");
          return false;
        }
      }

      return true;
    };

    const isValid = validateUpdateInput();
    if (isValid) {
      setSelectedRowForSubmit(record);
      setModalModeForTable(BrandProductForTableModalModeEnum.UpdateVariantOrRegion);
    }
  };

  const onSubmit = async ({ manageEvent }: BrandProductVariantManageEventModalForm) => {
    const isAddManageEventRow = checkIsAddManageEventRow();
    if (isAddManageEventRow) {
      const convertedRowId = convertRowIdForAddManageEvent(selectedRowId);
      brandProductVariantManageEventAdd({ variables: { brandProductVariantId: convertedRowId, manageEvent } });
      return;
    }

    const productName = getBrandProductNameText(selectedRowForSubmit);
    const product = selectedRowForSubmit.product;
    if (!product) {
      showNotificationError("브랜드 상품에 연결된 제품 정보가 없습니다.");
      return;
    }
    const formData = form.getFieldsValue();
    // 부가세 별도 금액은 폼 데이터에서 제외 - convPriceForm에서 부가세 포함된 가격으로 변환하여 폼에 적용
    const {
      priceExcludeVat,
      priceVat,
      costPriceExcludeVat,
      deliveryFeeExcludeVat,
      beforePriceExcludeVat,
      ...restForm
    } = formData;
    const precision = selectedRowForSubmit.brandProductVariant?.productVariant?.priceDecimalPlaces;
    const convPriceForm = convertBrandProductPriceToIncludeVat(
      formData,
      product.isTaxFree,
      precision,
      enableForB2bService
    );
    const convForm = { ...restForm, ...convPriceForm };

    const {
      name: brandProductName,
      isExclusive,
      isOnlyPayableByCash,
      isRcoinRewardForUsingPoint,
      ...restInput
    } = convForm;

    const { stoppedAt: stoppedAtValue } = restInput;
    const stoppedAt = stoppedAtValue?.format(onlyDateFormat);

    const errors = [];
    let extendedBrandProductVariantData: ExtendedBrandProductUpdate_extendedBrandProductUpdate = null;
    const brandProductId = selectedRowForSubmit?.id;
    const brandProductInput: BrandUpdateProductInput = {
      name: brandProductName,
      isExclusive,
      isOnlyPayableByCash,
      isRcoinRewardForUsingPoint,
    };
    const brandProductVariantInput: BrandUpdateProductVariantInput = { ...restInput, stoppedAt };
    const { data: extendedBrandProductVariantUpdateData } = await extendedBrandProductVariantUpdate({
      variables: {
        brandProductId,
        brandProductInput,
        brandProductVariantId: selectedRowId,
        brandProductVariantInput,
        manageEvent,
      },
    });
    extendedBrandProductVariantData = extendedBrandProductVariantUpdateData.extendedBrandProductUpdate;
    errors.push(...extendedBrandProductVariantData?.errors);

    if (errors.length > 0) {
      return false;
    }
    const brandProductFindIdx = brandProducts.findIndex(
      (item) => item.id === extendedBrandProductVariantData.brandProduct.id
    );
    const brandProductVariant = extendedBrandProductVariantData?.brandProductVariant;
    const brandProduct = extendedBrandProductVariantData.brandProduct;
    const brandProductVariantFIndIdx = brandProducts[brandProductFindIdx]?.brandProductVariants.findIndex(
      (item) => item.id === brandProductVariant.id
    );

    const newBrandProductVariants = [...brandProducts[brandProductFindIdx].brandProductVariants];

    newBrandProductVariants[brandProductVariantFIndIdx] = {
      ...newBrandProductVariants[brandProductVariantFIndIdx],
      forceNoNormalDisplay: brandProductVariant.forceNoNormalDisplay,
      needDeliveryAdditionalFee: brandProductVariant.needDeliveryAdditionalFee,
      salesStatus: brandProductVariant.salesStatus,
      stoppedAt: brandProductVariant.stoppedAt,
      stoppedReason: brandProductVariant.stoppedReason,
      stoppedReasonEtc: brandProductVariant.stoppedReasonEtc,
      beforePriceAmount: brandProductVariant.beforePriceAmount,
      costPriceExcludeVat: brandProductVariant.costPriceExcludeVat,
      deliveryFeeAmount: brandProductVariant.deliveryFeeAmount,
      priceAmount: brandProductVariant.priceAmount,
      priceVat: brandProductVariant.priceVat,
      showBeforePrice: brandProductVariant.showBeforePrice,
      mileageRate: brandProductVariant.mileageRate,
      includeSalesB2bDeliveryFee: brandProductVariant.includeSalesB2bDeliveryFee,
    };
    const newBrandProducts = [...brandProducts];
    newBrandProducts[brandProductFindIdx] = {
      ...brandProducts[brandProductFindIdx],
      name: brandProduct.name,
      isExclusive: brandProduct.isExclusive,
      isOnlyPayableByCash: brandProduct.isOnlyPayableByCash,
      isRcoinRewardForUsingPoint: brandProduct.isRcoinRewardForUsingPoint,
      brandProductVariants: [...newBrandProductVariants],
    };

    showNotificationSuccess(`[${productName}]:  상품 정보가 수정되었습니다.`);
    onCancel();
    return true;
  };

  const disabled =
    loading || extendedBrandProductVariantUpdateOpts.loading || brandProductVariantManageEventAddOpts.loading;

  const allExpandButton = () => {
    const noExpanded = !expandedRowKeys || expandedRowKeys.length === 0;
    const arrowIcon = noExpanded ? <DownOutlined /> : <UpOutlined />;
    const buttonText = `옵션/권역 정보 ${noExpanded ? "펼치기" : "숨기기"}`;
    return (
      <Typography.Link
        style={{ color: "black" }}
        onClick={() => {
          if (noExpanded) {
            const allRowKeys = tableDataSource
              ?.filter((brandProduct) => brandProduct?.children?.length > 0)
              ?.map((brandProduct) => getSelectedBrandProductVariantOrRegion(brandProduct)?.id);
            setExpandedRowKeys(allRowKeys);
          } else {
            setExpandedRowKeys([]);
          }
        }}
      >
        <Space direction={"horizontal"}>
          {arrowIcon}
          {buttonText}
        </Space>
      </Typography.Link>
    );
  };

  const tableExtra = (
    <Space>
      <Button type={"default"} icon={<RetweetOutlined />} disabled={loading} onClick={onProductReorder}>
        진열순서 변경
      </Button>
      <Button type={"primary"} icon={<PlusOutlined />} disabled={loading} onClick={onProductAssign}>
        브랜드 상품 추가
      </Button>
    </Space>
  );

  const tableTitle = () => (
    <Row justify={isFulfilledByVendor ? "end" : "space-between"} align={"bottom"}>
      {isFulfilledByVendor === false && allExpandButton()}
      {tableExtra}
    </Row>
  );

  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);

  const columns = getBrandProductListTableColumns({
    navigate,
    disabled,
    enableForB2bService,
    isBossMarket,
    isFulfilledByVendor,
    selectedRowId,
    form,
    watchedValues,
    stoppedReasonChoices,
    isEditing,
    onEdit,
    onSubmitClick,
    onCancel,
    onManageEventAdd,
    onStoreDisplay,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload: () =>
      Promise.resolve({ data: { dataSource: tableDataSource }, loading: undefined, networkStatus: undefined }),
    queryVariablesWithoutPagination: null,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "dataSource",
  };

  return (
    <>
      <Form
        form={form}
        component={false}
        onValuesChange={(changedValues) => {
          if (changedValues?.showBeforePrice === false) {
            form.setFields([{ name: "beforePriceExcludeVat", value: null }]);
          }
          if (!!changedValues?.isOnlyPayableByCash) {
            form.setFields([{ name: "isRcoinRewardForUsingPoint", value: false }]);
          }
        }}
      >
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          className={getTableClassName(["ant-table-tree-data"])}
          loading={disabled}
          title={tableTitle}
          rowKey={(record) =>
            getSelectedBrandProductVariantOrRegion(record)?.id
              ? getSelectedBrandProductVariantOrRegion(record)?.id
              : record.id
          }
          dataSource={tableDataSource}
          columns={pickerSelectedColumns}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          components={{ body: { cell: EditableCell } }}
          footer={isFulfilledByVendor === false && allExpandButton}
          expandable={{
            fixed: "left",
            indentSize: 0,
            expandedRowKeys,
            rowExpandable: (record) => record.children?.length > 0,
            onExpandedRowsChange: (expandedKeys) => setExpandedRowKeys(expandedKeys as string[]),
          }}
        />
      </Form>
      <BrandProductVariantManageEventModal
        isCreateMode
        open={[
          BrandProductForTableModalModeEnum.AddManageEvent,
          BrandProductForTableModalModeEnum.UpdateVariantOrRegion,
        ].includes(modalModeForTable)}
        showNeedReasonRadio={modalModeForTable !== BrandProductForTableModalModeEnum.AddManageEvent}
        loading={disabled}
        manageEventType={null}
        onSubmit={onSubmit}
        onCancel={() => {
          const isAddManageEventRow = checkIsAddManageEventRow();
          if (isAddManageEventRow === false) {
            setModalModeForTable(null);
            return;
          }
          onCancel();
        }}
      />
      <BrandProductStoreDisplayModal
        open={storeDisplayModalOpen}
        loading={disabled}
        brandProductVariantId={selectedBrandProductVariantId}
        brandProductSku={selectedBrandProductVariant?.bpSku || ""}
        brandId={brand?.id}
        brandStores={selectedBrandProductVariant?.displayedInStores || []}
        onClose={() => {
          setStoreDisplayModalOpen(false);
          setSelectedBrandProductVariantId("");
        }}
      />
    </>
  );
};
</file>

