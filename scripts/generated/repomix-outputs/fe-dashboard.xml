import moment from "moment-timezone";

export const BRAND_STORE_FILTERS_KEY = "brandStoreFilters";

export function getFilterOpts(params: BrandStoreListViewUrlQueryParams): BrandStoreListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    brandId: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandId, true), false),
      value: maybe(() => filterVariables.brandId, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    supervisorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.supervisorSearch, true), false),
      value: maybe(() => filterVariables.supervisorSearch, ""),
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type, true), false),
      value: maybe(() => findValueInEnum(filterVariables.type, BrandStoreTypeEnum)),
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, moment().format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, moment().format(onlyDateFormat)),
      },
    },
    regionInfo: {
      active: maybe(() => !utils.isEmpty(filterVariables.regionInfo, true), false),
      value: maybe(() => filterVariables.regionInfo, []),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status, true), false),
      value: maybe(
        () => dedupeFilter(filterVariables.status.map((item) => findValueInEnum(item, BrandStoreStatusEnum))),
        []
      ),
    },
    contract: {
      active: maybe(() => !utils.isEmpty(filterVariables.contract, true), false),
      value: maybe(
        () => dedupeFilter(filterVariables.contract.map((item) => findValueInEnum(item, BrandStoreContractEnum))),
        []
      ),
    },
    bizRegNo: {
      active: maybe(() => !utils.isEmpty(filterVariables.bizRegNo, true), false),
      value: maybe(() => filterVariables.bizRegNo, ""),
    },
  };
}

export function getFilterVariables(params: BrandStoreListViewUrlFilters): BrandStoreFilterInput {
  return {
    brandId: params.brandId,
    brandStoreSearch: params.brandStoreSearch,
    brandSearch: params.brandSearch,
    supervisorSearch: params.supervisorSearch,
    type: maybe(() => findInEnum(params.type, BrandStoreTypeEnum)),
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    regionInfo: maybe(() => params.regionInfo),
    status: maybe(() => params.status.map((item) => findInEnum(item, BrandStoreStatusEnum))),
    contract: maybe(() => params.contract.map((item) => findInEnum(item, BrandStoreContractEnum))),
    bizRegNo: params.bizRegNo,
  };
}

export function getFilterQueryParam(filter: IFilterElement<BrandStoreListFilterKeys>): BrandStoreListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandStoreListFilterKeys.brandId:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.brandId);
    case BrandStoreListFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.brandStoreSearch);
    case BrandStoreListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.brandSearch);
    case BrandStoreListFilterKeys.supervisorSearch:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.supervisorSearch);
    case BrandStoreListFilterKeys.type:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.type);
    case BrandStoreListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        BrandStoreListViewUrlFiltersEnum.createdFrom,
        BrandStoreListViewUrlFiltersEnum.createdTo
      );
    case BrandStoreListFilterKeys.regionInfo:
      return getMultipleValueQueryParam(filter, BrandStoreListViewUrlFiltersMultipleValuesEnum.regionInfo);
    case BrandStoreListFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandStoreListViewUrlFiltersMultipleValuesEnum.status,
        BrandStoreStatusEnum
      );
    case BrandStoreListFilterKeys.contract:
      return getMultipleEnumValueQueryParam(
        filter,
        BrandStoreListViewUrlFiltersMultipleValuesEnum.contract,
        BrandStoreContractEnum
      );
    case BrandStoreListFilterKeys.bizRegNo:
      return getSingleValueQueryParam(filter, BrandStoreListViewUrlFiltersEnum.bizRegNo);
  }
}

