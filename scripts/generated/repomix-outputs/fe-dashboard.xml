import { ReserveChangePriceDetailInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, DatePicker, Form, Input, Modal, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

import { useProductVariantListForUploadLazyQuery } from "../../products/api/queries";
import { convertUploadValuesToIncludeVat } from "../../products/components/ProductListPage/utils";
import { useCreateReserveChangePriceBaseMutation } from "../api/mutations";
import { reserveChangePriceBaseListQuery } from "../api/queries";

export const baseProductNotationForBrandCode = "기본가";
export const baseProductNotationForRegionCode = "-";

export const convertUploadValuesOfBaseProduct = (details) => {
  for (const detail of details) {
    const brandCode = detail.brandCode;
    if (brandCode === baseProductNotationForBrandCode) {
      detail.brandCode = undefined;
    }
    const regionCode = detail.regionCode;
    if (regionCode === baseProductNotationForRegionCode || utils.isEmpty(regionCode)) {
      detail.regionCode = "00";
    }
  }
  return details;
};

interface ReserveChangeAddModalProps {
  open: boolean;
  loading: boolean;
  onClose(): any;
}

export const ReserveChangeAddModal: React.FC<ReserveChangeAddModalProps> = ({ open, loading, onClose }) => {
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm(form);
  const reservedWatcher = TypeSafeForm.getUseWatcherParams({ name: "reserved" });
  const reserved = Form.useWatch(reservedWatcher.namePath, reservedWatcher.formInstance);
  const [selectedFile, setSelectedFile] = React.useState();
  const [selectedFileContent, setSelectedFileContent] = React.useState();
  const [errorExist, setErrorExist] = React.useState(false);
  const [refetchForUpload] = useProductVariantListForUploadLazyQuery();

  const upload = React.useRef<HTMLInputElement>();
  const handleUploadButtonClick = () => upload.current.click();

  const readUploadFile = (e) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      setSelectedFileContent(e.target.files[0]);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const details = parseWorksheetToJsonArr<any>({ worksheet });

        const uploadData = {
          details,
        };

        form.setFieldsValue({ uploadData });
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const [createReserveChangePriceBase, createReserveChangePriceBaseOpts] = useCreateReserveChangePriceBaseMutation({
    onCompleted: (data) => {
      const errors = data.createReserveChangePriceBase.errors;
      if (errors.length === 0) {
        showNotificationSuccess("가격 정보 변경이 예약되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
      form.resetFields();
      setSelectedFile(undefined);
      setSelectedFileContent(undefined);
      onClose();
    },
    refetchQueries: [reserveChangePriceBaseListQuery],
  });
  const modalLoading = loading || createReserveChangePriceBaseOpts.loading;

  const validateWrongForm = (details: ReserveChangePriceDetailInput[]) => {
    const oldKeys = ["price", "costPrice", "deliveryFee"];
    const newKeys = ["priceExcludeVat", "costPriceExcludeVat", "deliveryFeeExcludeVat"];
    for (const detail of details) {
      const detailKeys = Object.keys(detail);
      const someOldKeyExist = oldKeys.some((key) => detailKeys.includes(key));
      const everyNewKeyExist = newKeys.every((key) => detailKeys.includes(key));
      if (someOldKeyExist === true || everyNewKeyExist === false) {
        showNotificationError(
          "부가세 별도로 가격 입력을 위해 양식이 변경되었으니 새로운 양식을 출력하여 가격 수치를 반드시 부가세 별도로 입력한 후 등록 하세요."
        );
        return false;
      }
    }
    return true;
  };

  const validateBrandCodeEmpty = (details: ReserveChangePriceDetailInput[]) => {
    for (const detail of details) {
      const brandCode = detail.brandCode;
      if (utils.isEmpty(brandCode, true)) {
        showNotificationError("브랜드 코드가 지정되지 않은 셀이 존재합니다.");
        return false;
      }
    }
    return true;
  };

  const validateProductSkuEmpty = (details: ReserveChangePriceDetailInput[]) => {
    for (const detail of details) {
      const sku = detail.productSku;
      if (utils.isEmpty(sku, true)) {
        showNotificationError("제품코드가 지정되지 않은 셀이 존재합니다.");
        return false;
      }
    }
    return true;
  };

  const makeCombineCode = (detail: ReserveChangePriceDetailInput) => {
    const regionCode = detail.regionCode;
    const brandCode = detail.brandCode;
    const sku = detail.productSku;
    if (brandCode !== baseProductNotationForBrandCode) {
      return `${sku}:${regionCode}:${brandCode}`;
    }
    return `${sku}:${regionCode}:기준제품`;
  };

  const validateDuplicate = (details: ReserveChangePriceDetailInput[]) => {
    const combineCodes = [];
    const errors = [];
    for (const detail of details) {
      const combineCode = makeCombineCode(detail);

      if (combineCodes.find((c) => c === combineCode)) {
        errors.push(combineCode);
      } else {
        combineCodes.push(combineCode);
      }
    }
    const isOk = errors.length <= 0;
    if (!isOk) {
      const errorMsg = (
        <>
          (제품코드:권역 정보:브랜드 코드) 중복:
          <br />
          {errors.join(", ")}
        </>
      );
      showNotificationError(errorMsg);
    }
    return isOk;
  };

  const validateBasePrice = (details: ReserveChangePriceDetailInput[]) => {
    const errors = [];
    const basePriceDict = {};
    for (const detail of details) {
      const sku = detail.productSku;
      const regionCode = detail.regionCode;
      const combineCode = makeCombineCode(detail);
      const basePrice = detail.basePrice;
      if (basePrice === undefined || basePrice <= 0) {
        errors.push(combineCode);
      } else {
        if (basePriceDict.hasOwnProperty(`${sku}:${regionCode}`)) {
          if (basePriceDict[`${sku}:${regionCode}`] !== basePrice) {
            errors.push(combineCode);
          } else {
            basePriceDict[`${sku}:${regionCode}`] = basePrice;
          }
        }
      }
    }
    const isOk = errors.length <= 0;
    if (!isOk) {
      const errorMsg = (
        <>
          기준가 오류 (제품코드:권역 정보:브랜드 코드):
          <br />
          {errors.join(", ")}
        </>
      );
      showNotificationError(errorMsg);
    }
    return isOk;
  };

  const validateValueEmpty = (details: ReserveChangePriceDetailInput[]) => {
    const deliveryFeeErrors = [];
    const costPriceErrors = [];
    const priceErrors = [];
    for (const detail of details) {
      const combineCode = makeCombineCode(detail);
      const deliveryFee = detail.deliveryFee;
      const costPrice = detail.costPrice;
      const price = detail.price;
      if (deliveryFee === undefined || deliveryFee < 0) {
        deliveryFeeErrors.push(combineCode);
      }
      if (costPrice === undefined || costPrice < 0) {
        costPriceErrors.push(combineCode);
      }
      if (price === undefined || price < 0) {
        priceErrors.push(combineCode);
      }
    }
    const isOk = deliveryFeeErrors.length <= 0 && costPriceErrors.length <= 0 && priceErrors.length <= 0;
    if (!isOk) {
      if (deliveryFeeErrors.length > 0) {
        const errorMsg = (
          <>
            배송비 오류 (제품코드:권역 정보:브랜드 코드):
            <br />
            {deliveryFeeErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
      if (costPriceErrors.length > 0) {
        const errorMsg = (
          <>
            매입가 오류 (제품코드:권역 정보:브랜드 코드):
            <br />
            {costPriceErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
      if (priceErrors.length > 0) {
        const errorMsg = (
          <>
            판매가 오류 (제품코드:권역 정보:브랜드 코드):
            <br />
            {priceErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
    }
    return isOk;
  };

  const validateSelectedFileContent = () => selectedFileContent !== undefined;

  const validatePriceWarning = (details: ReserveChangePriceDetailInput[]) => {
    const errors = [];
    for (const detail of details) {
      const combineCode = makeCombineCode(detail);
      const basePrice = detail.basePrice;
      const costPrice = detail.costPrice;
      const price = detail.price;
      if (costPrice < basePrice || price < costPrice) {
        errors.push(combineCode);
      }
    }
    const isOk = errors.length <= 0;
    if (!isOk) {
      const errorMsg = (
        <>
          {"견적단가 <= 매입가 <= 판매가 관계 오류:"}:
          <br />
          {errors.join(", ")}
        </>
      );
      showNotificationWarn(errorMsg);
    }
    return isOk;
  };

  const validateReserved = (reserved: any) => {
    if (reserved === undefined) {
      showNotificationError("반영일이 입력되지 않았습니다.");
      return false;
    }
    return true;
  };

  const validateDataIsNonNull = (details: ReserveChangePriceDetailInput[]) => {
    if (details === undefined || details.length <= 0) {
      showNotificationError("가격 정보 변경 예약을 위한 엑셀데이터에 데이터가 없거나 양식 오류로 처리할 수 없습니다.");
      return false;
    }
    return true;
  };

  const disabledDate = (current: Moment) => current && current < moment().endOf("day");

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title="가격 정보 변경"
      open={open}
      cancelText={"뒤로"}
      okText={"확인"}
      onOk={form.submit}
      onCancel={() => {
        form.resetFields();
        setSelectedFile(undefined);
        setSelectedFileContent(undefined);
        onClose();
      }}
      okButtonProps={{
        disabled: reserved === undefined || form.getFieldValue("uploadData") === undefined || modalLoading,
      }}
      cancelButtonProps={{ disabled: modalLoading }}
    >
      <Form
        validateTrigger={"onSubmit"}
        form={form}
        layout="vertical"
        name="control-hooks"
        onFinish={async (formData) => {
          const reserved = formData.reserved;
          const description = formData.description;
          const details = formData.uploadData.details;

          for (const detail of details) {
            delete detail.productName;
            delete detail.regionName;
            delete detail.__rowNum__;
          }

          if (validateReserved(reserved) === false) {
            return;
          }
          if (validateDataIsNonNull(details) === false || validateWrongForm(details) === false) {
            setSelectedFile(undefined);
            setErrorExist(true);
            return;
          }

          // NOTE: 상품가 변경 예약 시 입력된 sku에 따라 해당 상품의 면세 여부 정보를 가져오고, 입력된 가격 정보를 부가세 별도 가격으로 변환하여 저장.
          const { data: varianstForUpload } = await refetchForUpload({
            variables: {
              first: details.length,
              filter: { sku: details.map((detail) => detail.productSku) },
            },
          });
          const varianstsForUpload = varianstForUpload?.productVariants?.edges?.map((edge) => edge.node);
          const detailsIncludeVat = convertUploadValuesToIncludeVat(details, varianstsForUpload);

          for (const detail of detailsIncludeVat) {
            delete detail.priceExcludeVat;
            delete detail.deliveryFeeExcludeVat;
          }

          const validateAry = [];
          validateAry.push(validateBrandCodeEmpty(details));
          validateAry.push(validateProductSkuEmpty(details));
          validateAry.push(validateDuplicate(details));
          validateAry.push(validateBasePrice(details));
          validateAry.push(validateValueEmpty(details));
          validateAry.push(validateSelectedFileContent());

          if (validateAry.findIndex((v) => v === false) >= 0) {
            setSelectedFile(undefined);
            setSelectedFileContent(undefined);
            setErrorExist(true);
            return;
          }
          validatePriceWarning(details);

          const convertedDetails = convertUploadValuesOfBaseProduct(details);
          await createReserveChangePriceBase({
            variables: {
              input: {
                reserved: moment(reserved).format(onlyDateFormat),
                description,
                xlsFileName: selectedFile,
                xlsFile: selectedFileContent,
                details: convertedDetails,
              },
            },
          });
          setSelectedFile(undefined);
          setSelectedFileContent(undefined);
        }}
      >
        <Space size={0} direction={"vertical"}>
          <Form.Item
            name="reserved"
            label="반영일"
            rules={[
              {
                required: true,
                message: "예약 변경 반영일을 입력해주세요",
              },
            ]}
          >
            <DatePicker
              size="large"
              style={{ width: "100%" }}
              placeholder={"반영일"}
              format={onlyDateFormat}
              disabledDate={disabledDate}
              showToday={false}
            />
          </Form.Item>
          <Form.Item
            name="uploadData"
            label="가격 변경 정보"
            rules={[
              {
                required: true,
                message: "가격 변경용 엑셀 파일을 선택해 주세요",
              },
            ]}
          >
            <Space size={"middle"} direction={"vertical"}>
              <Button onClick={handleUploadButtonClick} type="primary">
                가격 변경 엑셀파일 선택
              </Button>
              {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
              {selectedFile && errorExist && (
                <Typography.Text type="warning">
                  오류로 엑셀 파일을 수정한 경우 데이터 리로딩을 위해서 다시 엑셀 파일을 선택해 주세요.
                </Typography.Text>
              )}
              <input
                hidden={true}
                id="reserveChangeInputFile"
                onChange={(e) => readUploadFile(e)}
                type="file"
                ref={upload}
                accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
              />
            </Space>
          </Form.Item>
          <Form.Item name="description" label="변경 예약 메모">
            <Input />
          </Form.Item>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

