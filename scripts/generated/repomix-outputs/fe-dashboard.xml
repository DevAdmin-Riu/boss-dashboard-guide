<file path="src/app/views/order/orders/components/OrderRefundCreateModal/OrderRefundCreateModal.tsx">
import { InfoCircleOutlined } from "@ant-design/icons";
import {
  CustomerRefundCreateInput,
  RefundBankCodeEnum,
  RefundOrderLineInput,
  RefundQuestionTypeEnum,
  RefundReasonTypeEnum,
} from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CardSpacer from "@src/app/components/CardSpacer";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopContext } from "@src/app/providers/ShopProvider";
import { findVendorManager, makeVendorManagerInfo, VendorManagerTypeEnum } from "@src/app/views/purchase/vendors/utils";
import { getDisplayInnerProductName } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import {
  Card,
  Col,
  Form,
  FormInstance,
  Input,
  Modal,
  Radio,
  Row,
  Space,
  Table,
  Tooltip,
  Typography,
  UploadFile,
} from "antd";
import { ColumnsType } from "antd/lib/table";
import { TextProps } from "antd/lib/typography/Text";
import React, { useContext, useEffect, useState } from "react";

import { useCustomerRefundImageCreateMutation, useOrderCancelAndExchangeAndRefundMutation } from "../../api/mutations";
import { OrderDetails_order, OrderDetails_order_lines } from "../../api/types/OrderDetails";
import CancelAndRefundCauseForm from "../CancelAndRefundCauseForm/CancelAndRefundCauseForm";
import ExchangeAndRefundImage from "../ExchangeAndRefundImage/ExchangeAndRefundImage";
import { calculateBundleRefundLines } from "../OrderRefundModal/utils";
import RefundBankForm from "../RefundBankForm/RefundBankForm";

/**
 * 왕복 배송비 (개당)
 * - 배송비 6,000원 + 반품배송비 6,000원 = 12,000원
 */
export const ROUND_TRIP_DELIVERY_FEE_PER_ITEM = 12000;

interface OrderRefundCreateModalProps {
  open: boolean;
  order: OrderDetails_order;
  onClose: () => void;
}

// TODO: refundCountListObj refundedMaxQuantity, refundableQuantity 코드 정리 (@도현)

interface refundCountListObj {
  id: string;
  refundedMaxQuantity: number;
  refundQuantityValue: string | number;
  isFulfilledByVendor: boolean;
}

interface TOrderDataProcessing extends OrderDetails_order_lines {
  refundedMaxQuantity: number;
}

interface StateInputProps {
  id: string;
  disabled: boolean;
  refundedMaxQuantity: number;
  form: FormInstance<ExchangeAndRefundForm>;
  isAdjustPrice?: boolean;
}

export interface ExchangeAndRefundForm {
  cause: RefundReasonTypeEnum;
  causeText?: string;
  refundType: RefundQuestionTypeEnum;
  refundCountList: refundCountListObj[];
  accountHolder: string;
  bankCode: RefundBankCodeEnum;
  accountNumber: string;
}

const StateInput: React.FC<StateInputProps> = (props) => {
  const { id, disabled, refundedMaxQuantity, form, isAdjustPrice } = props;
  const refundCountList = form.getFieldValue("refundCountList");

  const getInitialValue = () => {
    const existingValue = refundCountList?.filter((item: refundCountListObj) => item.id === id)[0]?.refundQuantityValue;
    return existingValue || "";
  };

  const [value, setValue] = React.useState<number | string>(getInitialValue());
  const [hasError, setHasError] = React.useState(false);

  const validateValue = (val: number) => {
    if (isAdjustPrice && val > 0 && val < refundedMaxQuantity) {
      return false; // Invalid for isAdjustPrice products
    }
    return val >= 0 && val <= refundedMaxQuantity;
  };

  const onChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const inputValue = e.target.value;

    // 빈 값이거나 숫자가 아닌 경우 처리
    if (inputValue === "") {
      setValue("");
      setHasError(false);
      updateFormValue("");
      return;
    }

    const numValue = Number(inputValue);
    if (isNaN(numValue)) {
      return;
    }

    setValue(numValue);

    const isValid = validateValue(numValue);
    setHasError(!isValid);

    const finalValue = numValue > refundedMaxQuantity ? refundedMaxQuantity : numValue;
    updateFormValue(finalValue);
  };

  const onBlur = () => {
    if (value === "") {
      updateFormValue(0);
      setValue(0);
      return;
    }

    const numValue = Number(value);

    // isAdjustPrice 제품의 경우 blur 시점에 유효하지 않은 값 조정
    if (isAdjustPrice && numValue > 0 && numValue < refundedMaxQuantity) {
      showNotificationError(`납품 시 금액 확정 제품은 0개 또는 ${refundedMaxQuantity}개(전체)만 선택 가능합니다.`);
      const adjustedValue = numValue > refundedMaxQuantity / 2 ? refundedMaxQuantity : 0;
      setValue(adjustedValue);
      updateFormValue(adjustedValue);
      setHasError(false);
    }
  };

  const updateFormValue = (val: number | string) => {
    form.setFieldValue(
      "refundCountList",
      refundCountList.length === 0
        ? []
        : refundCountList.reduce((acc: refundCountListObj[], cur: refundCountListObj) => {
            if (cur.id === id) {
              acc.push({ ...cur, refundQuantityValue: val });
            } else {
              acc.push({ ...cur });
            }
            return acc;
          }, [])
    );
  };

  React.useEffect(() => {
    const newValue = getInitialValue();
    setValue(newValue);
  }, [refundCountList]);

  const input = (
    <Input
      style={{ textAlign: "right" }}
      disabled={disabled}
      value={value}
      onChange={onChange}
      onBlur={onBlur}
      status={hasError ? "error" : undefined}
    />
  );

  // isAdjustPrice 제품이거나 에러가 있을 때 Tooltip 표시
  if (isAdjustPrice || hasError) {
    const tooltipTitle = hasError
      ? `납품 시 금액 확정 제품은 0개 또는 ${refundedMaxQuantity}개(전체)만 선택 가능합니다.`
      : isAdjustPrice
      ? `이 제품은 0개 또는 ${refundedMaxQuantity}개(전체)만 선택할 수 있습니다.`
      : "";

    return (
      <Tooltip title={tooltipTitle} color={hasError ? "red" : undefined} placement="topRight">
        {input}
      </Tooltip>
    );
  }

  return input;
};

const columnsSetting = ({ form }: { form: FormInstance<ExchangeAndRefundForm> }): ColumnsType<TOrderDataProcessing> => [
  {
    key: "productName",
    title: "상품",
    render: (_, record) => {
      // 세트상품인 경우 "세트 상품명 - 구성품명" 형식으로 표시
      let displayName = record.productName;
      if (record.bpBundle?.name) {
        const bundleName = record.bpBundle.name; // 세트 상품명
        // 해당 orderLine의 variant와 매칭되는 bpBundleInfo 찾기
        const matchingBundleInfo = record.bpBundle.bpBundleInfos?.find((info) => info?.pv?.id === record.variant?.id);
        const componentName = matchingBundleInfo?.name || record.productName;
        displayName = `${bundleName} - ${componentName}`;
      }

      return (
        <Space direction="vertical" size={0}>
          <Typography.Text>{displayName}</Typography.Text>
          {record.variant?.isAdjustPrice && (
            <Typography.Text type="warning" style={{ fontSize: 12 }}>
              <InfoCircleOutlined /> 납품 시 금액 확정 제품은 전체 수량 또는 0개만 입력 가능합니다.
            </Typography.Text>
          )}
        </Space>
      );
    },
  },
  {
    key: "quantity",
    title: "수량",
    width: 50,
    render: (_, record) => (
      <Row style={{ float: "right" }}>
        {record?.bundleOtherOrderLines?.length > 0
          ? record.orderedOrFulfillQty / record.bundleInfoQty
          : record.orderedOrFulfillQty}
      </Row>
    ),
  },
  {
    key: "id",
    title: "신청 수량",
    width: 70,
    render: (_, record) => (
      <StateInput
        id={record.id}
        disabled={record.isFulfilledByVendor}
        refundedMaxQuantity={record.refundedMaxQuantity}
        form={form}
        isAdjustPrice={record.variant?.isAdjustPrice}
      />
    ),
  },
  {
    key: "refundedMaxQuantity",
    title: "가능 수량",
    width: 70,
    align: "right",
    render: (_, record) => (record.isFulfilledByVendor ? 0 : record.refundedMaxQuantity),
  },
];

const OrderRefundAndExchangeCreateModal: React.FC<OrderRefundCreateModalProps> = (props) => {
  const { open, order, onClose } = props;
  const [form] = Form.useForm<ExchangeAndRefundForm>();
  const shop = useContext(ShopContext);
  const { refundReasonChoices, refundTypeChoices, refundBankCodeChoices } = shop;
  const orderId = order?.id;
  const isVbankPay = order?.payInfo.isVbankPay;

  const [accountBankCheckValue, setAccountBankCheckValue] = useState(false);
  const [fileList, setFileList] = useState<UploadFile[]>([]);
  const [debounce, setDebounce] = useState(false);

  const refundReasonTypeWatched = Form.useWatch("cause", form);
  const refundTypeWatched = Form.useWatch("refundType", form);
  const refundCountList = Form.useWatch("refundCountList", form);

  const isNotExchange =
    refundReasonTypeWatched === RefundReasonTypeEnum.SIMPLE_REMORSE ||
    refundReasonTypeWatched === RefundReasonTypeEnum.PRODUCT_DIFFERENT_ORDER;

  React.useEffect(() => {
    if (order !== undefined) {
      const newRefundCountList = order.lines.reduce((acc, cur) => {
        // 세트상품의 대표 구성품이 아닌 라인 제외 (isMainPv === false)
        if (cur.isMainPv === false) {
          return acc;
        }
        // 세트상품인 경우 bundleQty - bundleRefundedQty, 아닌 경우 orderedOrFulfillQty - quantityRefunded
        const refundableQuantity =
          cur.bundleQty !== null
            ? cur.bundleQty - (cur.bundleRefundedQty ?? 0)
            : cur.orderedOrFulfillQty - cur.quantityRefunded;
        if (refundableQuantity > 0) {
          const obj = {
            id: cur.id,
            refundedMaxQuantity: refundableQuantity,
            refundQuantityValue: "",
            refundableQuantity,
          };
          acc.push(obj);
        }
        return acc;
      }, []);
      form.setFieldValue("refundCountList", newRefundCountList);
    }
  }, [order]);

  const [onCustomerRefundImageCreateMutation] = useCustomerRefundImageCreateMutation({
    onCompleted: (res) => {
      const errors = res.customerRefundImageCreate.errors;
      if (errors.length > 0) {
        showNotificationError(errors[0].message);
      }
    },
    onError: () => showNotificationError("이미지 업로드중 에러가 발생하였습니다. 고객센터로 문의해 주세요."),
  });

  const [onExchangeAndRefundMutation] = useOrderCancelAndExchangeAndRefundMutation({
    onCompleted: async (res) => {
      if (res.customerRefundCreate.errors.length > 0) {
        showNotificationError("교환/반품 신청중 에러가 발생하였습니다. 고객센터로 문의해 주세요.");
      } else {
        showNotificationSuccess("교환/반품 신청이 완료되었습니다.");
        const responseId = res.customerRefundCreate.refundQA.id;
        if (fileList.length > 0) {
          for (let i = 0; i < fileList.length; i++) {
            const item = fileList[i];
            await onCustomerRefundImageCreateMutation({
              variables: {
                input: {
                  refundQa: responseId,
                  image: item.originFileObj,
                },
              },
            });
          }
        }

        onClose();
      }
    },
    onError: () => showNotificationError("교환/반품 신청중 에러가 발생하였습니다. 고객센터로 문의해 주세요."),
  });

  const countCheck = (refundCountList: refundCountListObj[]) =>
    refundCountList.reduce(
      (acc, cur) => {
        const value = Number(cur.refundQuantityValue);
        const newObj = { ...cur, refundQuantityValue: value };
        if (value !== 0) {
          acc.check = true;
          acc.totalCount += value;
        }
        acc.newRefundCountList.push(newObj);

        return acc;
      },
      { check: false, newRefundCountList: [], totalCount: 0 }
    );

  const orderExchangeAndRefundClickBtn = () => {
    const refundReasonText = form.getFieldValue("causeText");
    const bankCode = form.getFieldValue("bankCode");
    const accountNumber = form.getFieldValue("accountNumber");
    const accountHolderName = form.getFieldValue("accountHolderName");
    const refundCountList = form.getFieldValue("refundCountList");

    const stepOneCheckValue = countCheck(refundCountList);
    if (!stepOneCheckValue.check) {
      showNotificationError("환불 수량이 1개 이상이어야 합니다.");
      return;
    }

    // isAdjustPrice 제품 검증
    const invalidAdjustPriceItems = order.lines.filter((line) => {
      if (line.variant?.isAdjustPrice) {
        const refundItem = refundCountList.find((item: refundCountListObj) => item.id === line.id);
        const quantity = Number(refundItem?.refundQuantityValue || 0);
        const maxQuantity = line.orderedOrFulfillQty - line.quantityRefunded;

        // 0이 아니고 전체 수량도 아닌 경우
        return quantity > 0 && quantity < maxQuantity;
      }
      return false;
    });

    if (invalidAdjustPriceItems.length > 0) {
      const itemNames = invalidAdjustPriceItems.map((item) => item.productName).join(", ");
      showNotificationError(`납품 시 금액 확정 제품(${itemNames})은 0개 또는 전체 수량만 선택 가능합니다.`);
      return;
    }

    if (debounce) {
      showNotificationError("반복된 접수가 감지되었습니다. 더블클릭에 주의해주세요.");
      return;
    }
    if (!accountBankCheckValue && isVbankPay && refundTypeWatched === RefundQuestionTypeEnum.REFUND) {
      showNotificationError("계좌번호를 확인해주세요.");
      return;
    }
    if (
      isVbankPay &&
      refundTypeWatched === RefundQuestionTypeEnum.REFUND &&
      bankCode.trim().length < 2 &&
      accountNumber.trim().length < 10 &&
      accountHolderName.trim().length < 1
    ) {
      showNotificationError(
        "가상계좌 결제 주문건 시 은행명, 예금주, 계좌번호를 제대로 입력해주셔야 환불이 가능합니다."
      );
      return;
    }

    setDebounce(true);

    // 세트상품인 경우 bundleOtherOrderLines도 포함
    const qOrderLineInfo: RefundOrderLineInput[] = [];
    refundCountList
      .filter((item: refundCountListObj) => Number(item.refundQuantityValue) > 0)
      .forEach((item: refundCountListObj) => {
        const inputQuantity = Number(item.refundQuantityValue);
        const orderLine = order.lines.find((line) => line.id === item.id);

        if (orderLine?.bundleQty !== null && orderLine.bundleOtherOrderLines?.length > 0) {
          // 세트상품인 경우: 유틸 함수 사용
          const bundleRefundLines = calculateBundleRefundLines(orderLine, inputQuantity);
          qOrderLineInfo.push(...bundleRefundLines);
        } else {
          // 비세트상품인 경우: 그대로 처리
          qOrderLineInfo.push({
            orderLineId: item.id,
            quantity: inputQuantity,
          });
        }
      });

    const input: CustomerRefundCreateInput = {
      qType: refundTypeWatched,
      order: orderId,
      qReasonType: refundReasonTypeWatched,
      qReasonText: refundReasonText,
      qOrderLineInfo,
    };
    if (isVbankPay && refundTypeWatched === RefundQuestionTypeEnum.REFUND) {
      input.qRefundAccountInfo = {
        bankCode,
        accountNumber,
        accountHolderName,
      };
    }
    onExchangeAndRefundMutation({ variables: { input } });

    setTimeout(() => {
      setDebounce(false);
    }, 1000);
  };

  useEffect(() => {
    if (isNotExchange) {
      form.setFieldValue("refundType", RefundQuestionTypeEnum.REFUND);
    }
  }, [refundReasonTypeWatched]);

  if (order === undefined) {
    return <></>;
  }

  const orderDataProcessing = order.lines.reduce<TOrderDataProcessing[]>((acc, cur) => {
    // 세트상품의 대표 구성품이 아닌 라인 제외 (isMainPv === false)
    if (cur.isMainPv === false) {
      return acc;
    }
    // 세트상품인 경우 bundleQty - bundleRefundedQty, 아닌 경우 orderedOrFulfillQty - quantityRefunded
    const refundedMaxQuantity =
      cur.bundleQty !== null
        ? cur.bundleQty - (cur.bundleRefundedQty ?? 0)
        : cur.orderedOrFulfillQty - cur.quantityRefunded;
    const displayProductName = getDisplayInnerProductName(cur.productName, cur.variant.isInner);
    if (refundedMaxQuantity > 0) {
      acc.push({
        ...cur,
        productName: displayProductName,
        refundedMaxQuantity,
      });
    }
    return acc;
  }, []);

  let refundTotalPrice = 0;
  const orderCombineRefundCountList = orderDataProcessing.reduce((acc, cur) => {
    const refundCount = Number(refundCountList?.filter((item) => item.id === cur.id)[0]?.refundQuantityValue);
    if (refundCount > 0) {
      acc.push({
        productName: cur.productName.trim(),
        refundCount,
        totalPrice: cur.unitPriceGrossAmount * refundCount,
      });

      // 세트상품인 경우: 모든 구성품의 금액과 총 수량 계산
      if (cur.bundleQty !== null && cur.bundleOtherOrderLines?.length > 0) {
        const bundleRefundLines = calculateBundleRefundLines(cur, refundCount);

        // 모든 구성품의 총 환불 금액 계산 (대표 구성품만 단가 있음)
        const productAmount = refundCount * cur.unitPriceGrossAmount;

        // 총 구성품 수량으로 배송비 계산
        const totalRefundQty = bundleRefundLines.reduce((sum, line) => sum + line.quantity, 0);
        const deliveryFee = totalRefundQty * ROUND_TRIP_DELIVERY_FEE_PER_ITEM;

        refundTotalPrice += productAmount - deliveryFee;
      } else {
        // 비세트상품인 경우: 제품 수량 × 단가 - 배송비
        refundTotalPrice += cur.unitPriceGrossAmount * refundCount - refundCount * ROUND_TRIP_DELIVERY_FEE_PER_ITEM;
      }
    }

    return acc;
  }, []);

  return (
    <Modal
      width={800}
      forceRender
      destroyOnClose
      closable={false}
      title="관리자용 교환/반품 생성"
      open={open}
      onCancel={onClose}
      onOk={orderExchangeAndRefundClickBtn}
      okButtonProps={{
        disabled:
          debounce || (!accountBankCheckValue && isVbankPay && refundTypeWatched === RefundQuestionTypeEnum.REFUND),
      }}
      maskClosable={false}
    >
      <Form
        name="refundForm"
        form={form}
        initialValues={{
          refundType: RefundQuestionTypeEnum.REFUND,
          cause: RefundReasonTypeEnum.SIMPLE_REMORSE,
          causeText: "",
          refundCountList: order.lines.map((orderLine) => {
            const refundableQuantity = orderLine.orderedOrFulfillQty - orderLine.quantityRefunded;
            if (refundableQuantity > 0) {
              return { ...orderLine, refundableQuantity };
            }
            return { ...orderLine, refundableQuantity: 0 };
          }),
        }}
      >
        <Form.Item hidden name="refundCountList">
          <Input />
        </Form.Item>
        <Card size="small" title="상품 리스트">
          <Typography.Text type="danger" strong style={{ marginBottom: 4, display: "block" }}>
            입력하지 않으면 0개로 간주합니다.
          </Typography.Text>
          <Table
            {...commonTableProps}
            columns={columnsSetting({ form })}
            dataSource={orderDataProcessing}
            expandable={{
              showExpandColumn: false,
              defaultExpandAllRows: true,
              rowExpandable: (record: TOrderDataProcessing) => record.isFulfilledByVendor,
              expandedRowRender: (record: TOrderDataProcessing) => {
                const vendor = record.vendor;
                const vendorManagers = makeVendorManagerInfo(vendor?.managers);
                const vendorMainOrderManager = findVendorManager(vendorManagers, VendorManagerTypeEnum.ORDER);
                const commonTextProps: TextProps = { type: "danger", style: { fontSize: "12px" } };
                const warningText = (
                  <Typography.Text {...commonTextProps}>
                    '{record.productName}'의 교환/반품은 해당 업체에 직접 문의해야 합니다.
                  </Typography.Text>
                );
                const vendorInfoText = (
                  <Typography.Text {...commonTextProps}>
                    {vendor?.name || "-"}(담당자: {vendorMainOrderManager?.name || "-"},{" "}
                    {vendorMainOrderManager?.phone || "-"})
                  </Typography.Text>
                );
                return (
                  <Row justify="space-between">
                    {warningText}
                    {vendorInfoText}
                  </Row>
                );
              },
            }}
          />
        </Card>
        <CardSpacer />
        <CancelAndRefundCauseForm reasonChoices={refundReasonChoices} />

        <CardSpacer />
        <Card size="small" title="교환/반품 참고 이미지 업로드">
          <ExchangeAndRefundImage maxFileLength={5} fileListValue={fileList} setFileListValue={setFileList} />
        </Card>

        <CardSpacer />
        <Card size="small" title={`선택한 상품 ${orderCombineRefundCountList.length}건`}>
          <TableVatLegend isIncludeVat={true} />
          <Row justify={"space-between"} gutter={[10, 10]}>
            {orderCombineRefundCountList.map((item, idx) => (
              <React.Fragment key={idx}>
                <Col span={12}>{item.productName}</Col>
                <Col span={4} style={{ textAlign: "right" }}>
                  <NumberComponent value={item.refundCount} postFix="개" />
                </Col>
                <Col span={8} style={{ textAlign: "right" }}>
                  <NumberComponent value={item.totalPrice} includeCurrency />
                </Col>
              </React.Fragment>
            ))}
          </Row>
          {isNotExchange && (
            <>
              <Typography.Text type="danger" strong style={{ marginTop: 5, display: "block" }}>
                단순 변심인 경우 1BOX 기준 12,000원(배송/환불 각각 6,000원) 배송비를 제외한 금액만 환불됩니다.
              </Typography.Text>
              <Row justify={"space-between"} gutter={[10, 10]}>
                <Col span={24} style={{ textAlign: "right" }}>
                  <Typography.Text strong underline style={{ fontSize: "16px", color: "#1956a3" }}>
                    최종 환불 예상 금액: {<NumberComponent value={refundTotalPrice} includeCurrency />}
                  </Typography.Text>
                </Col>
              </Row>
            </>
          )}
        </Card>
        <CardSpacer />
        <Card size="small">
          <Typography.Text style={{ display: "block", marginBottom: 5 }}>해결방법 선택</Typography.Text>
          <Form.Item name="refundType" initialValue={refundTypeWatched}>
            <Radio.Group style={{ display: "block", marginBottom: 5 }}>
              {refundTypeChoices
                .filter(
                  (item) =>
                    [RefundQuestionTypeEnum.CANCEL, RefundQuestionTypeEnum.ETC].includes(
                      item.value as RefundQuestionTypeEnum
                    ) === false
                )
                .map((item) => (
                  <Radio
                    key={item.value}
                    value={item.value}
                    disabled={isNotExchange && item.value === RefundQuestionTypeEnum.EXCHANGE}
                  >
                    {item.label}
                  </Radio>
                ))}
            </Radio.Group>
          </Form.Item>
          {/* NOTE : 교환 해결방법을 빼달라는 요청으로 임시 주석 */}
          {isNotExchange && (
            <Typography.Text type="danger" strong>
              단순 변심 or 고객 귀책사유인 경우 교환 할 수 없습니다.
            </Typography.Text>
          )}
        </Card>
        {isVbankPay && refundTypeWatched === RefundQuestionTypeEnum.REFUND && (
          <>
            <RefundBankForm
              setAccountBankCheckValue={setAccountBankCheckValue}
              accountBankCheckValue={accountBankCheckValue}
              refundBankCodeChoices={refundBankCodeChoices}
              form={form}
            />
          </>
        )}
      </Form>
    </Modal>
  );
};

export default OrderRefundAndExchangeCreateModal;
