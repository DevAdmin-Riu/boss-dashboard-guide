import makeQuery from "@hooks/makeQuery";
import gql from "graphql-tag";

import { Home } from "./types/Home";

export const homeQuery = gql`
  query Home {
    salesToday: ordersTotal(period: TODAY) {
      gross {
        amount
        currency
      }
    }
    ordersToday: orders {
      totalCount
    }
    ordersToFulfill: orders(filter: { deliveryStatus: STANDBY_DELIVERY }) {
      totalCount
    }
    ordersToCapture: orders(filter: { chargeStatus: PENDING }) {
      totalCount
    }
    productVariantsOutOfRop: productVariants(
      filter: { stockAvailability: OUT_OF_ROP, salesStatus: [ON_SALE, WILL_BE_STOPPED] }
    ) {
      totalCount
    }
    productVariantsOutOfSafetyStock: productVariants(
      filter: { stockAvailability: OUT_OF_SAFETY_STOCK, salesStatus: [ON_SALE, WILL_BE_STOPPED] }
    ) {
      totalCount
    }
    productVariantsOutOfStock: productVariants(
      filter: { stockAvailability: OUT_OF_STOCK, salesStatus: [ON_SALE, WILL_BE_STOPPED] }
    ) {
      totalCount
    }
    productTopToday: reportProductSales(period: TODAY, first: 5) {
      edges {
        node {
          id
          attributes {
            values {
              id
              name
            }
          }
          product {
            id
            name
          }
          quantityOrdered
        }
      }
    }
  }
`;
export const useHomePageQuery = makeQuery<Home, {}>(homeQuery);
</file>

