import { FulfillmentFilterInput, FulfillmentLineFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { ISOFormatWithTimeZone, onlyDateFormat } from "@src/app/providers/DateProvider";
import { getGteLteVariables, getMinMaxQueryParam, getSingleValueQueryParam } from "@utils/filters";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  FulfillmentInspectFilterKeys,
  FulfillmentInspectListFilterOpts,
} from "../../components/FulfillmentInspectListPage/filters";
import { FulfillmentInspectListViewUrlFilters, FulfillmentInspectListViewUrlFiltersEnum } from "../../urls";
import { getFilterVariablesAvailableForDeliveryReprint } from "../OrderDeliveryReprintListView/filters";

export function getFilterOpts(
  params: FulfillmentInspectListViewUrlFilters,
  warehouseAddressId?: string
): FulfillmentInspectListFilterOpts {
  const fulfillmentFilterVariables = getFulfillmentFilterVariables(params);
  const fulfillmentLineFilterVariables = getFulfillmentLineFilterVariables(params, warehouseAddressId);

  return {
    deliveryStartDateTime: {
      active: maybe(
        () =>
          !utils.allEmpty([
            fulfillmentFilterVariables.deliveryStartDateTime.gte,
            fulfillmentFilterVariables.deliveryStartDateTime.lte,
          ]),
        false
      ),
      value: {
        max: maybe(() => fulfillmentFilterVariables.deliveryStartDateTime.lte, null),
        min: maybe(() => fulfillmentFilterVariables.deliveryStartDateTime.gte, null),
      },
    },
    isInspectCompleted: {
      active: maybe(() => !utils.isEmpty(params.isInspectCompleted, true), false),
      value: maybe(() => parseBoolean(params.isInspectCompleted, false), false),
    },
    sectorSearch: {
      active: maybe(() => !utils.isEmpty(fulfillmentLineFilterVariables.sectorSearch, true), false),
      value: fulfillmentLineFilterVariables.sectorSearch,
    },
    locationSearch: {
      active: maybe(() => !utils.isEmpty(fulfillmentLineFilterVariables.locationSearch, true), false),
      value: fulfillmentLineFilterVariables.locationSearch,
    },
  };
}

export function getFulfillmentFilterVariables(params: FulfillmentInspectListViewUrlFilters): FulfillmentFilterInput {
  const filterVariablesAvailableForDeliveryReprint = getFilterVariablesAvailableForDeliveryReprint(false);
  const defaultDeliveryStartDateTimeFrom = moment().startOf("day").format(ISOFormatWithTimeZone);
  const defaultDeliveryStartDateTimeTo = moment().endOf("day").format(ISOFormatWithTimeZone);
  const deliveryStartDateTime = getGteLteVariables({
    gte: maybe(() => params.deliveryStartDateTimeFrom, defaultDeliveryStartDateTimeFrom),
    lte: maybe(() => params.deliveryStartDateTimeTo, defaultDeliveryStartDateTimeTo),
  });

  return {
    ...filterVariablesAvailableForDeliveryReprint,
    decreaseStockFlag: true,
    deliveryStartDateTime,
  };
}

export function getFulfillmentLineFilterVariables(
  params: FulfillmentInspectListViewUrlFilters,
  warehouseAddressId?: string
): FulfillmentLineFilterInput {
  return {
    decreaseStockFlag: true,
    warehouseAddressIds: warehouseAddressId ? [warehouseAddressId] : undefined,
    sectorSearch: params.sectorSearch,
    locationSearch: params.locationSearch,
  };
}

export function getDailyUninspectedQtyFilterVariables(): FulfillmentFilterInput {
  const todayMoment = moment();
  const targetDate = todayMoment.format(onlyDateFormat);
  const filterVariablesAvailableForDeliveryReprint = getFilterVariablesAvailableForDeliveryReprint(false);

  return {
    ...filterVariablesAvailableForDeliveryReprint,
    decreaseStockFlag: true,
    deliveryStartDate: getGteLteVariables({
      gte: targetDate,
      lte: targetDate,
    }),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<FulfillmentInspectFilterKeys>
): FulfillmentInspectListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case FulfillmentInspectFilterKeys.deliveryStartDateTime:
      return getMinMaxQueryParam(
        filter,
        FulfillmentInspectListViewUrlFiltersEnum.deliveryStartDateTimeFrom,
        FulfillmentInspectListViewUrlFiltersEnum.deliveryStartDateTimeTo
      );
    case FulfillmentInspectFilterKeys.sectorSearch:
      return getSingleValueQueryParam(filter, FulfillmentInspectListViewUrlFiltersEnum.sectorSearch);
    case FulfillmentInspectFilterKeys.locationSearch:
      return getSingleValueQueryParam(filter, FulfillmentInspectListViewUrlFiltersEnum.locationSearch);
    case FulfillmentInspectFilterKeys.isInspectCompleted:
      return getSingleValueQueryParam(filter, FulfillmentInspectListViewUrlFiltersEnum.isInspectCompleted);
  }
}
