import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import useCollectionSearch from "@src/api/searches/useCollectionSearch";
import useMakerSearch from "@src/api/searches/useMakerSearch";
import useProductTypeSearch from "@src/api/searches/useProductTypeSearch";
import { CategoryKindEnum, ProductCreateInput, SalesStatusEnum } from "@src/api/types/globalTypes";
import { WindowTitle } from "@src/app/components/WindowTitle";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { hqFbvProductListViewUrl } from "@src/app/views/hqFulfilledByVendor/urls";
import { useWarehouseList } from "@src/app/views/settings/warehouses/api/queries";
import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { StrictOmit } from "@src/global/core/types/types";
import { toPriceIncludeVat } from "@utils/excel/excelDownload";
import { maybe, transformIsFBV } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";
import { useLocation } from "react-router";

import { useProductCreateMutation } from "../api/mutations";
import { ProductDetails_product } from "../api/types/ProductDetails";
import { ProductCreateData, ProductCreateFormData } from "../components/ProductCreatePage/form";
import { ProductCreatePage } from "../components/ProductCreatePage/ProductCreatePage";
import { ProductUpdateData } from "../components/ProductUpdatePage/form";
import {
  fbvProductUpdateViewUrl,
  productCreateViewUrl,
  ProductCreateViewUrlQueryParams,
  productListViewUrlA,
  productListViewUrlB,
  productUpdateViewUrl,
} from "../urls";
import { getCategoryLabel, getStockInputFromVariant, makeFilteredAttributesForMutationInput } from "../utils/data";
import { calcPackCount } from "../utils/utils";
function isProductCreateData(data: ProductCreateData | ProductUpdateData): data is ProductCreateData {
  return "defaultPvvVendorCode" in data;
}
export const commonCheckProductRequired = ({
  data,
  hasVariants,
  isFulfilledByVendor,
  firstAvailableForPurchase,
  isHqStaff,
  isCreateMode,
  isB2bCategoryKind,
  isDevCategoryKind,
}: {
  data: ProductCreateData | ProductUpdateData;
  hasVariants: boolean;
  isFulfilledByVendor: boolean;
  firstAvailableForPurchase: any;
  isHqStaff: boolean;
  isCreateMode: boolean;
  isB2bCategoryKind: boolean;
  isDevCategoryKind: boolean;
}) => {
  if (!data) {
    return false;
  }

  if (data.isTaxFree === null) {
    showNotificationError("과세 방식을 선택하세요.");
    return false;
  }

  if (utils.isEmpty(data.name, true)) {
    showNotificationError("제품명을 입력하세요.");
    return false;
  }

  if (isNaN(Number(data.moq))) {
    showNotificationError("최소주문수량은 숫자만 입력할 수 있습니다.");
    return false;
  }

  if (data.moq <= 0) {
    showNotificationError("최소주문수량은 0보다 큰 수를 입력하세요.");
    return false;
  }

  if (
    data.isForCreditsRefill === true &&
    isProductCreateData(data) &&
    data.productType.name.includes("충전금") === false
  ) {
    showNotificationError("충전금 제품 타입을 선택해 주세요.");
    return false;
  }

  if (hasVariants) {
    if (data.isDevPv) {
      showNotificationError("개발비 제품은 옵션형 제품 타입을 선택할 수 없습니다.");
      return false;
    }
    if (data.isForCreditsRefill) {
      showNotificationError("충전금 제품은 옵션형 제품 타입을 선택할 수 없습니다.");
      return false;
    }
  } else {
    {
      const salesStatusKey = "salesStatus";
      if (isFulfilledByVendor === false && utils.isEmpty(data[salesStatusKey])) {
        showNotificationError("제품 상태를 선택하세요.");
        return false;
      }

      if (
        isFulfilledByVendor === false &&
        data[salesStatusKey] !== SalesStatusEnum.PENDING &&
        data[salesStatusKey] !== SalesStatusEnum.ON_SALE &&
        isCreateMode
      ) {
        showNotificationError("제품 상태는 '판매 대기' 또는 '정상'만 선택 가능합니다.");
        return false;
      }
    }
    if (data.canSaleByInner) {
      const salesStatusKey = "innerSalesStatus";
      if (isFulfilledByVendor === false && utils.isEmpty(data[salesStatusKey])) {
        showNotificationError("이너박스 제품 상태를 선택하세요.");
        return false;
      }

      if (
        isFulfilledByVendor === false &&
        data[salesStatusKey] !== SalesStatusEnum.PENDING &&
        data[salesStatusKey] !== SalesStatusEnum.ON_SALE &&
        isCreateMode
      ) {
        showNotificationError("이너박스 제품 상태는 '판매 대기' 또는 '정상'만 선택 가능합니다.");
        return false;
      }
    }

    if (isFulfilledByVendor === false && data.trackInventory) {
      if (
        utils.isEmpty(data.stockAdjustFactor, true) ||
        data.stockAdjustFactor < -1000 ||
        data.stockAdjustFactor > 1000
      ) {
        showNotificationError("재발주점 계산식에 더하기 보정값은 -1000 이상 1000 이하의 값으로 입력해 주세요.");
        return false;
      }
    }

    if (utils.isEmpty(data.boxLength, true) || data.boxLength === 0) {
      showNotificationError("아우터박스 규격 - 길이(장)는 0보다 큰 수를 입력해 주세요.");
      return false;
    }
    if (utils.isEmpty(data.boxWidth, true) || data.boxWidth === 0) {
      showNotificationError(`아우터박스 규격 - 너비(폭)는 0보다 큰 수를 입력해 주세요.`);
      return false;
    }
    if (utils.isEmpty(data.boxHeight, true) || data.boxHeight === 0) {
      showNotificationError(`아우터박스 규격 - 높이(고)는 0보다 큰 수를 입력해 주세요.`);
      return false;
    }
    if (utils.isEmpty(data.qtyPerBox, true) || data.qtyPerBox === 0) {
      showNotificationError(`아우터박스 입수량은 0보다 큰 수를 입력해 주세요.`);
      return false;
    }
    if (utils.isEmpty(data.qtyPerBoxUnitType, true)) {
      showNotificationError(`아우터박스 입수량 단위를 선택해 주세요.`);
      return false;
    }

    // 납품 시 금액 확정 제품인 경우
    if (data.isAdjustPrice) {
      if (utils.isEmpty(data.qtyPerDeliveryBox, true) || data.qtyPerDeliveryBox < 1) {
        showNotificationError(`박스 당 중량은 0보다 큰 수를 입력해 주세요.`);
        return false;
      }
    }

    // 이너박스 제품인 경우 validate
    if (data.canSaleByInner) {
      if (utils.isEmpty(data.innerBoxLength, true) || data.innerBoxLength === 0) {
        showNotificationError("이너박스 규격 - 길이(장)는 0보다 큰 수를 입력해 주세요.");
        return false;
      }
      if (utils.isEmpty(data.innerBoxWidth, true) || data.innerBoxWidth === 0) {
        showNotificationError("이너박스 규격 - 너비(폭)는 0보다 큰 수를 입력해 주세요.");
        return false;
      }
      if (utils.isEmpty(data.innerBoxHeight, true) || data.innerBoxHeight === 0) {
        showNotificationError("이너박스 규격 - 높이(고)는 0보다 큰 수를 입력해 주세요.");
        return false;
      }
      if (utils.isEmpty(data.innerQtyPerBox, true) || data.innerQtyPerBox === 0) {
        showNotificationError("이너박스 입수량은 0보다 큰 수를 입력해 주세요.");
        return false;
      }
    }

    if (utils.isEmpty(data.salesUnitType)) {
      showNotificationError("운영 단위를 선택하세요.");
      return false;
    }

    if (utils.isEmpty(data.maker) && data.isForCreditsRefill === false) {
      showNotificationError("제조사를 선택하세요.");
      return false;
    }

    if (data.isForCreditsRefill === false && utils.isEmpty(data.countryOfOrigin)) {
      showNotificationError("원산지를 선택하세요.");
      return false;
    }

    // 상품정보고시 비어있지 않게 validate
    if (
      utils.isEmpty(data.productInfoNotification) &&
      data.isForCreditsRefill === false &&
      isB2bCategoryKind === false &&
      isDevCategoryKind === false
    ) {
      showNotificationError("상품정보고시를 선택하세요.");
      return false;
    }

    if (isFulfilledByVendor) {
      if (data.bpvShowBeforePrice) {
        if (utils.isEmpty(data.bpvBeforePriceExcludeVat) || data.bpvBeforePriceExcludeVat < data.bpvPriceExcludeVat) {
          showNotificationError("할인전 판매가는 매장 판매가보다 같거나 큰 수를 입력해 주세요.");
          return false;
        }
      }

      if (isProductCreateData(data) && isHqStaff === false && utils.isEmpty(data.bpvBrandCode, true)) {
        showNotificationError("브랜드를 선택해 주세요.");
        return false;
      }
    }

    if (isProductCreateData(data) && data.isForCreditsRefill === false) {
      if (data.isDeferred === false) {
        if (data.trackInventory) {
          if (
            (utils.isEmpty(data.defaultPvvProductPriceExcludeVat) || data.defaultPvvProductPriceExcludeVat <= 0) &&
            (utils.isEmpty(data.defaultPvvConsignmentProductPriceExcludeVat) ||
              data.defaultPvvConsignmentProductPriceExcludeVat <= 0)
          ) {
            showNotificationError(
              "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 둘 중 하나는 0 보다 큰 값 이어야 합니다."
            );
            return false;
          }
        } else {
          if (
            utils.isEmpty(data.defaultPvvConsignmentProductPriceExcludeVat) ||
            data.defaultPvvConsignmentProductPriceExcludeVat <= 0
          ) {
            showNotificationError(
              `재고 미운영이거나 ${transformIsFBV(true)} 상품인 경우, 협력사 위탁 상품가는 0 보다 큰 값 이어야 합니다.`
            );
            return false;
          }
        }
      }

      if (utils.isEmpty(data.defaultPvvVendorCode, true)) {
        showNotificationError("협력사를 선택해 주세요.");
        return false;
      }

      if (utils.isEmpty(data.defaultPvvMoq, true) || data.defaultPvvMoq <= 0) {
        showNotificationError("MOQ를 0 이상의 값 이어야 합니다.");
        return false;
      }

      if (isB2bCategoryKind) {
        if (
          utils.isEmpty(data.defaultPvvPurchaseB2bDeliveryFeeExcludeVat) ||
          data.defaultPvvPurchaseB2bDeliveryFeeExcludeVat < 0
        ) {
          showNotificationError("B2B 제품 매입 배송비는 0 이상의 값 이어야 합니다.");
        }
      } else if (isDevCategoryKind) {
        if (
          utils.isEmpty(data.defaultPvvPurchaseB2bDeliveryFeeExcludeVat) ||
          data.defaultPvvPurchaseB2bDeliveryFeeExcludeVat < 0
        ) {
          showNotificationError("개발비 제품 매입 배송비는 0 이상의 값 이어야 합니다.");
        }
      } else {
        if (
          !isFulfilledByVendor &&
          (utils.isEmpty(data.defaultPvvDeliveryFeeExcludeVat) || data.defaultPvvDeliveryFeeExcludeVat < 0)
        ) {
          showNotificationError("협력사 재고 배송비는 0 이상의 값 이어야 합니다.");
          return false;
        }
        if (
          utils.isEmpty(data.defaultPvvConsignmentDeliveryFeeExcludeVat) ||
          data.defaultPvvConsignmentDeliveryFeeExcludeVat < 0
        ) {
          showNotificationError("협력사 위탁 배송비는 0 이상의 값 이어야 합니다.");
          return false;
        }
      }

      if (utils.isEmpty(data.defaultPvvMoq)) {
        showNotificationError("협력사 발주 MOQ는 필수 입력 항목입니다.");
        return false;
      }
    }
  }
};

interface ProductCreateViewProps {
  params: ProductCreateViewUrlQueryParams;
}

export const ProductCreateView: React.FC<ProductCreateViewProps> = ({ params }) => {
  const location = useLocation();
  const historyState = location?.state as { productForCopy: ProductDetails_product };
  const { productForCopy } = maybe(() => historyState, { productForCopy: null });

  const { isFulfilledByVendor, categoryKind } = params;
  const navigate = useNavigator();
  const shop = useShop();
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;

  const {
    loadMore: loadMoreCategories,
    search: searchCategory,
    result: searchCategoryOpts,
  } = useCategorySearch({
    variables: {
      ...DEFAULT_INITIAL_SEARCH_DATA,
      level: 1,
      kind: [categoryKind],
    },
  });

  const {
    loadMore: loadMoreCollections,
    search: searchCollection,
    result: searchCollectionOpts,
  } = useCollectionSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });
  const {
    loadMore: loadMoreProductTypes,
    search: searchProductTypes,
    result: searchProductTypesOpts,
  } = useProductTypeSearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, isFulfilledByVendor },
  });
  const {
    loadMore: loadMoreMakers,
    search: searchMakers,
    result: searchMakersOpts,
  } = useMakerSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });
  const { data: warehouseData, loading: warehouseLoading } = useWarehouseList({
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.warehouses,
    },
  });
  const isB2bCategoryKind = categoryKind === CategoryKindEnum.B2B;
  const isDevCategoryKind = categoryKind === CategoryKindEnum.DEV;

  const windowTitle = `${isFulfilledByVendor ? sectionNames.productsB : sectionNames.productsA} 추가`;
  const targetUrl = isFulfilledByVendor
    ? isHqStaff
      ? hqFbvProductListViewUrl
      : productListViewUrlB
    : productListViewUrlA;
  const handleBack = () => navigate(targetUrl());

  const [productCreate, productCreateOpts] = useProductCreateMutation({
    onCompleted: (data) => {
      const errors = data.productCreate.errors;
      if (errors.length === 0) {
        const productId = data.productCreate?.product?.id;
        if (isFulfilledByVendor) {
          const brandProductVariantId = data.productCreate.product.variants[0].fbvBrandProductVariant.id;
          navigate(fbvProductUpdateViewUrl(brandProductVariantId));
        } else {
          navigate(isHqStaff ? hqFbvProductListViewUrl() : productUpdateViewUrl(productId));
        }
        showNotificationSuccess("제품이 추가되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    onError: (error) => {
      const errorMsg = "제품 추가에 실패했습니다.: " + error.message;
      showNotificationError(errorMsg);
    },
  });

  const checkRequired = (data: ProductCreateData) => {
    if (utils.isEmpty(data.productType)) {
      showNotificationError("제품 타입을 선택하세요.");
      return false;
    }

    if (utils.isEmpty(data.category)) {
      showNotificationError("카테고리를 선택하세요.");
      return false;
    }

    const commonCheck = commonCheckProductRequired({
      data,
      hasVariants: data.productType.hasVariants,
      isFulfilledByVendor,
      firstAvailableForPurchase: null,
      isHqStaff,
      isCreateMode: true,
      isB2bCategoryKind,
      isDevCategoryKind,
    });
    if (commonCheck === false) {
      return false;
    }

    const requiredAttributeIds = data?.productType?.productAttributes
      .filter((attribute) => attribute.valueRequired)
      .map((attribute) => attribute.id);
    if (requiredAttributeIds.length > 0) {
      const inputAttributeIds = data.attributes
        .filter((attribute) => utils.isEmpty(attribute.value) === false)
        .map((attribute) => attribute.id);
      const missingAttributeIds = requiredAttributeIds.filter((id) => !inputAttributeIds.includes(id));
      if (missingAttributeIds.length > 0) {
        showNotificationError("필수 속성을 입력 또는 선택해 주세요.");
        return false;
      }
    }

    return true;
  };

  const checkDecimalPlaces = (data: ProductCreateData) => {
    if (data.uoq <= 0) {
      showNotificationError("단위주문수량은 0보다 큰 수를 입력하세요.");
      return false;
    }
    if (data.moq <= 0) {
      showNotificationError("최소주문수량은 0보다 큰 수를 입력하세요.");
      return false;
    }
    if (data.priceDecimalPlaces < 0) {
      showNotificationError("가격 소수점 허용 자리수는 0 이상이어야 합니다.");
      return false;
    }
    if (data.orderQtyDecimalPlaces < 0) {
      showNotificationError("주문수량 소수점 허용 자리수는 0 이상이어야 합니다.");
      return false;
    }

    if (data.priceDecimalPlaces > 0) {
      if (
        utils.checkNDecimalPlaces(data.defaultPvvProductPriceExcludeVat, data.priceDecimalPlaces) === false &&
        isB2bCategoryKind === false &&
        isDevCategoryKind === false
      ) {
        showNotificationError(`협력사 상품가(재고) 가격은 소수점 ${data.priceDecimalPlaces}자리 까지만 입력해주세요.`);
        return false;
      }
      if (
        utils.checkNDecimalPlaces(data.defaultPvvConsignmentProductPriceExcludeVat, data.priceDecimalPlaces) === false
      ) {
        showNotificationError(`협력사 상품가(위탁) 가격은 소수점 ${data.priceDecimalPlaces}자리 까지만 입력해주세요.`);
        return false;
      }
    }

    if (data.orderQtyDecimalPlaces > 0) {
      if (utils.checkNDecimalPlaces(data.moq, data.orderQtyDecimalPlaces) === false) {
        showNotificationError(`최소주문수량은 소수점 ${data.orderQtyDecimalPlaces}자리 까지만 입력해주세요.`);
        return false;
      }
      if (utils.checkNDecimalPlaces(data.uoq, data.orderQtyDecimalPlaces) === false) {
        showNotificationError(`단위주문수량은 소수점 ${data.orderQtyDecimalPlaces}자리 까지만 입력해주세요.`);
        return false;
      }
      if (utils.checkNDecimalPlaces(data.defaultPvvMoq, data.orderQtyDecimalPlaces) === false) {
        showNotificationError(`협력사 MOQ는 소수점 ${data.orderQtyDecimalPlaces}자리 까지만 입력해주세요.`);
        return false;
      }
    }
  };

  const handleCreate = async (formData: ProductCreateData) => {
    const isValid = checkRequired(formData) && checkDecimalPlaces(formData);

    if (isValid === false) {
      return null;
    }

    const inputForInnerVariant: Pick<
      ProductCreateInput,
      | "innerMoq"
      | "innerUoq"
      | "innerQtyPerBox"
      | "innerBoxLength"
      | "innerBoxWidth"
      | "innerBoxHeight"
      | "innerIncidentalCost"
      | "innerStocks"
      | "innerSalesStatus"
      | "innerForceSoldOutNotice"
    > =
      formData.canSaleByInner === false
        ? null
        : {
            innerMoq: formData.innerMoq,
            innerUoq: formData.innerUoq,
            innerQtyPerBox: formData.innerQtyPerBox,
            innerBoxLength: formData.innerBoxLength,
            innerBoxWidth: formData.innerBoxWidth,
            innerBoxHeight: formData.innerBoxHeight,
            innerIncidentalCost: 0,
            innerStocks: formData.innerStocks,
            innerSalesStatus: formData.innerSalesStatus,
            innerForceSoldOutNotice: formData.innerForceSoldOutNotice,
          };

    const commonInput: ProductCreateInput = {
      // 직거래 상품 여부
      isFulfilledByVendor,
      // 카테고리, 컬렉션
      category: formData.category,
      collections: formData.collections,
      // 제품 기본 정보
      name: formData.name,
      salesStatus: isFulfilledByVendor ? undefined : formData.salesStatus,
      isTaxFree: formData.isTaxFree,
      moq: formData.moq || 1,
      uoq: formData.uoq || 1,
      trackInventory: formData.trackInventory,
      forceSoldOutNotice: formData.forceSoldOutNotice,
      productType: formData.productType?.id,
      slug: formData.slug,
      // 제품 속성 정보
      attributes: makeFilteredAttributesForMutationInput(formData),
      qtyPerBox: formData.qtyPerBox,
      qtyPerBoxUnitType: formData.qtyPerBoxUnitType,
      priorityLevel: formData.priorityLevel,
      salesUnitType: formData.salesUnitType,
      boxLength: formData.boxLength,
      boxWidth: formData.boxWidth,
      boxHeight: formData.boxHeight,
      palletQty: formData.palletQty,
      palletM: formData.palletM,
      palletN: formData.palletN,
      palletO: formData.palletO,
      maker: formData.maker,
      // 제품 공급원가 정보(비옵션형 제품 생성 시 defaultVariant의 공급원가 정보 세팅)
      basePrice: 0,
      consignmentDeliveryFee: 0,
      // 검수 정보
      needToInspect: formData.needToInspect,
      inspectReason: formData.inspectReason,
      inspectType: formData.inspectType,
      inspectMemo: formData.inspectMemo,
      inspectReportTemplate: formData.inspectReportTemplate,

      stockAdjustFactor: formData.stockAdjustFactor,
      stocks: formData.stocks,
      note: formData.note,
      poNote: formData.poNote,
      // 계절 제품 정보
      isSeasonal: formData.isSeasonal,
      peakSeasonStartDate: formData.peakSeasonStartDate,
      peakSeasonEndDate: formData.peakSeasonEndDate,
      // 상품 정보고시
      productInfoNotification: formData.productInfoNotification,
      // 기본 협력사
      defaultPvvCreateInput:
        formData?.productType?.hasVariants || formData?.isForCreditsRefill
          ? undefined
          : {
              vendorCode: formData.defaultPvvVendorCode,
              isActive: formData.defaultPvvIsActive,
              externalSku: formData.defaultPvvExternalSku,
              externalProductName: formData.defaultPvvExternalProductName,
              productPriceExcludeVat: formData.defaultPvvProductPriceExcludeVat,
              deliveryFeeExcludeVat: formData.defaultPvvDeliveryFeeExcludeVat,
              consignmentProductPriceExcludeVat: formData.defaultPvvConsignmentProductPriceExcludeVat,
              consignmentDeliveryFeeExcludeVat: formData.defaultPvvConsignmentDeliveryFeeExcludeVat,
              leadTime: formData.defaultPvvLeadTime,
              moq: formData.defaultPvvMoq,
              note: formData.defaultPvvNote,
              noteForUnitPrice: formData.defaultPvvNoteForUnitPrice,
              pricingBasisQty: formData.defaultPvvPricingBasisQty,
              includePurchaseB2bDeliveryFee: formData.defaultPvvIncludePurchaseB2bDeliveryFee,
              purchaseB2bDeliveryFeeExcludeVat: formData.defaultPvvPurchaseB2bDeliveryFeeExcludeVat,
            },
      bpvCreateInput: isFulfilledByVendor
        ? {
            brandCode: isHqStaff ? user.brand.code : formData.bpvBrandCode,
            isOnlyPayableByCash: formData.isOnlyPayableByCash,
            showBeforePrice: formData.bpvShowBeforePrice,
            beforePrice: toPriceIncludeVat(formData.bpvBeforePriceExcludeVat, formData.isTaxFree),
            price: formData.bpvPriceExcludeVat + formData.bpvPriceVat,
            priceVat: formData.bpvPriceVat,
          }
        : undefined,
      priceDecimalPlaces: formData.priceDecimalPlaces,
      orderQtyDecimalPlaces: formData.orderQtyDecimalPlaces,
      // 충전금 상품은 원산지 정보를 null로 보냄
      countryOfOrigin: formData.isForCreditsRefill ? null : formData.countryOfOrigin,
      isAdjustPrice: formData.isAdjustPrice,
      qtyPerDeliveryBox: formData.qtyPerDeliveryBox,
    };

    const inputForFulfilledByVendor: StrictOmit<
      ProductCreateInput,
      | "allowMixedMultipleOfUoq"
      | "isDirectShipping"
      | "isExclusive"
      | "allowAutoConsignment"
      | "isSubPv"
      | "canSaleByInner"
    > = {
      ...commonInput,
      palletQty: 0,
      palletM: 0,
      palletN: 0,
      palletO: 0,
      isDeferred: formData.isDeferred,
    };

    const inputForFulfilledByBoss: ProductCreateInput = {
      ...commonInput,
      // 제품 기본 정보
      allowMixedMultipleOfUoq: formData.allowMixedMultipleOfUoq || false,
      isExclusive: formData.isExclusive,
      requiredExpDateMgmt: formData.requiredExpDateMgmt,
      allowAutoConsignment: formData.allowAutoConsignment,
      isSubPv: formData.isSubPv,
      canSaleByInner: formData.canSaleByInner,
      // 이너박스 정보(직배송 제품, 직거래 상품인 경우는 무관)
      ...inputForInnerVariant,
    };

    const input: ProductCreateInput = isFulfilledByVendor ? inputForFulfilledByVendor : inputForFulfilledByBoss;
    const result = await productCreate({ variables: { input } });
    return result?.data?.productCreate?.product?.id || null;
  };
  const handleSubmit = handleCreate;

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const loading = warehouseLoading || productCreateOpts.loading;

  let initial: ProductCreateFormData;
  if (productForCopy) {
    const variant = productForCopy?.outerVariants[0];
    initial = {
      category: productForCopy.category.id,
      categoryLabel: getCategoryLabel(productForCopy.category, { hideKind: true }),
      isTaxFree: productForCopy.isTaxFree,
      collections: productForCopy.collections.map((collection) => collection.id),
      name: productForCopy.name,
      moq: productForCopy.moq,
      uoq: productForCopy.uoq,
      allowMixedMultipleOfUoq: productForCopy.allowMixedMultipleOfUoq,
      isExclusive: productForCopy.isExclusive,
      productType: productForCopy.productType,
      productAttributes: productForCopy.attributes,
      qtyPerBox: variant.qtyPerBox,
      qtyPerBoxUnitType: variant.qtyPerBoxUnitType,
      priorityLevel: variant.priorityLevel,
      salesUnitType: variant.salesUnitType,
      boxLength: variant.boxLength,
      boxWidth: variant.boxWidth,
      boxHeight: variant.boxHeight,
      palletQty: variant.palletQty,
      palletM: variant.palletM,
      palletN: variant.palletN,
      palletO: variant.palletO,
      maker: null,
      makerLabel: "",
      trackInventory: variant.trackInventory,
      isVendorTrackInventory: variant.isVendorTrackInventory,
      forceSoldOutNotice: variant.forceSoldOutNotice,
      isDevPv: variant.isDevPv,
      isForCreditsRefill: variant.isForCreditsRefill,
      allowAutoConsignment: variant.allowAutoConsignment,
      isAdjustPrice: variant?.isAdjustPrice,
      qtyPerDeliveryBox: maybe(() => variant.qtyPerDeliveryBox, null),
      autoTurnOffAllowAutoConsignment: variant.autoTurnOffAllowAutoConsignment,
      isSubPv: variant.isSubPv,
      stockAdjustFactor: variant.stockAdjustFactor,
      basicStockQty: variant.basicStockQty,
      safetyStockQty: variant.safetyStockQty,
      rop: variant.rop30,
      stocks: getStockInputFromVariant(variant),
      canSaleByInner: variant.canSaleByInner,
      requiredExpDateMgmt: variant.requiredExpDateMgmt,
      isDeferred: variant.isDeferred,
      note: variant.note,
      poNote: variant.poNote,
      isSeasonal: false,
      peakSeasonStartDate: null,
      peakSeasonEndDate: null,
      innerForceSoldOutNotice: maybe(() => variant.inner.forceSoldOutNotice, false),
      innerMoq: maybe(() => variant.inner.innerMoq, 1),
      innerUoq: maybe(() => variant.inner.innerUoq, 1),
      packCount: maybe(() => calcPackCount(variant, variant.inner), 0),
      innerQtyPerBox: maybe(() => variant.inner.qtyPerBox, 0),
      innerBoxLength: maybe(() => variant.inner.boxLength, 0),
      innerBoxWidth: maybe(() => variant.inner.boxWidth, 0),
      innerBoxHeight: maybe(() => variant.inner.boxHeight, 0),
      innerStocks: getStockInputFromVariant(variant?.inner),
      slug: "",
      productInfoNotification: productForCopy.productInfoNotification,
      defaultPvvVendorCode: null,
      defaultPvvIsActive: true,
      defaultPvvExternalSku: "",
      defaultPvvExternalProductName: "",
      defaultPvvProductPriceExcludeVat: null,
      defaultPvvDeliveryFeeExcludeVat: null,
      defaultPvvConsignmentProductPriceExcludeVat: null,
      defaultPvvConsignmentDeliveryFeeExcludeVat: null,
      defaultPvvLeadTime: null,
      defaultPvvMoq: null,
      defaultPvvUoq: null,
      defaultPvvNote: "",
      defaultPvvNoteForUnitPrice: "",
      defaultPvvPricingBasisQty: null,
      defaultPvvIncludePurchaseB2bDeliveryFee: false,
      defaultPvvPurchaseB2bDeliveryFeeExcludeVat: 0,
      bpvBrandCode: isHqStaff ? user?.brand?.code : null,
      isOnlyPayableByCash: false,
      bpvShowBeforePrice: false,
      bpvBeforePriceExcludeVat: null,
      bpvPriceExcludeVat: null,
      priceDecimalPlaces: variant.priceDecimalPlaces || 0,
      orderQtyDecimalPlaces: variant.orderQtyDecimalPlaces || 0,
      needToInspect: false,
      inspectReason: null,
      inspectType: null,
      inspectMemo: null,
      inspectReportTemplate: null,
      countryOfOrigin: null,
    };
  }

  return (
    <>
      <WindowTitle title={windowTitle} />
      <ProductCreatePage
        isStaff={isStaff}
        params={params}
        currencySymbol={currencySymbol}
        categories={(searchCategoryOpts.data?.search.edges || []).map((edge) => edge.node)}
        collections={(searchCollectionOpts.data?.search.edges || []).map((edge) => edge.node)}
        productTypes={searchProductTypesOpts.data?.search.edges.map((edge) => edge.node)}
        makers={maybe(() => searchMakersOpts.data.search.edges, []).map((edge) => edge.node)}
        disabled={loading}
        errors={productCreateOpts.data?.productCreate.errors || []}
        onCategoryKindChange={(categoryKind) => navigate(productCreateViewUrl({ ...params, categoryKind }), true)}
        fetchCategories={searchCategory}
        fetchCollections={searchCollection}
        fetchProductTypes={searchProductTypes}
        fetchMakers={searchMakers}
        header="새 제품"
        initial={initial}
        onBack={handleBack}
        onSubmit={handleSubmit}
        saveButtonBarState={productCreateOpts.status}
        fetchMoreCategories={{
          hasMore: maybe(() => searchCategoryOpts.data.search.pageInfo.hasNextPage),
          loading: searchCategoryOpts.loading,
          onFetchMore: loadMoreCategories,
        }}
        fetchMoreCollections={{
          hasMore: searchCollectionOpts.data?.search.pageInfo.hasNextPage,
          loading: searchCollectionOpts.loading,
          onFetchMore: loadMoreCollections,
        }}
        fetchMoreProductTypes={{
          hasMore: searchProductTypesOpts.data?.search.pageInfo.hasNextPage,
          loading: searchProductTypesOpts.loading,
          onFetchMore: loadMoreProductTypes,
        }}
        fetchMoreMakers={{
          hasMore: maybe(() => searchMakersOpts.data.search.pageInfo.hasNextPage),
          loading: searchMakersOpts.loading,
          onFetchMore: loadMoreMakers,
        }}
        warehouses={warehouseData?.warehouses.edges.map((edge) => edge.node) || []}
      />
    </>
  );
};
</file>

<file path="src/app/views/product/products/views/ProductImageView.tsx">
import useNavigator from "@hooks/useNavigator";
import DialogContentText from "@material-ui/core/DialogContentText";
import ActionDialog from "@src/app/components/ActionDialog";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useProductImageDeleteMutation, useProductImageUpdateMutation } from "../api/mutations";
import { useProductImageQuery } from "../api/queries";
import { ProductImagePage } from "../components/ProductImagePage";
import {
  productImageViewUrl,
  ProductImageViewUrlQueryParams,
  productListViewUrlA,
  productUpdateViewUrl,
} from "../urls";

interface ProductImageViewProps {
  imageId: string;
  productId: string;
  params: ProductImageViewUrlQueryParams;
}

export const ProductImageView: React.FC<ProductImageViewProps> = ({ imageId, productId, params }) => {
  const navigate = useNavigator();

  const handleBack = () => navigate(productUpdateViewUrl(productId));

  const { data, loading } = useProductImageQuery({
    variables: {
      imageId,
      productId,
    },
  });

  const [updateImage, updateResult] = useProductImageUpdateMutation({
    onCompleted: (data) => {
      const errors = data.productImageUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [deleteImage, deleteResult] = useProductImageDeleteMutation({
    onCompleted: handleBack,
  });

  const product = data?.product;

  if (product === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(productListViewUrlA())} />;
  }

  const handleDelete = () => deleteImage({ variables: { id: imageId } });
  const handleImageClick = (id: string) => navigate(productImageViewUrl(productId, id));
  const handleUpdate = (formData: { description: string }) => {
    updateImage({
      variables: {
        alt: formData.description,
        id: imageId,
      },
    });
  };
  const image = data?.product?.mainImage;

  return (
    <>
      <ProductImagePage
        disabled={loading}
        backButtonTitle={`${data?.product?.name} 제품 상세`}
        image={image || null}
        images={data?.product?.images}
        onBack={handleBack}
        onDelete={() =>
          navigate(
            productImageViewUrl(productId, imageId, {
              action: "remove",
            })
          )
        }
        onRowClick={handleImageClick}
        onSubmit={handleUpdate}
        saveButtonBarState={updateResult.status}
      />
      <ActionDialog
        onClose={() => navigate(productImageViewUrl(productId, imageId), true)}
        onConfirm={handleDelete}
        open={params.action === "remove"}
        title={"이미지 삭제"}
        variant="delete"
        confirmButtonState={deleteResult.status}
      >
        <DialogContentText>이 이미지를 삭제하시겠습니까?</DialogContentText>
      </ActionDialog>
    </>
  );
};
</file>

