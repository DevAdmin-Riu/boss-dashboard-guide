  expDateStatus: FilterOpts<StockDetailExpDateStatusEnum[]>;
}

export function createFilterStructure(opts: RackStockFilterOpts): IFilter<RackStockFilterKeys> {
  let displayOrder = 0;

  const sectorSearchFilter = {
    ...createTextField(displayOrder++, RackStockFilterKeys.sectorSearch, "구역명", opts.sectorSearch.value),
    active: opts.sectorSearch.active,
  };
  const locationSearchFilter = {
    ...createTextField(displayOrder++, RackStockFilterKeys.locationSearch, "로케이션명", opts.locationSearch.value),
    active: opts.locationSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      RackStockFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      RackStockFilterKeys.vendorSearch,
      filterNameConstant.VENDOR_SEARCH,
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };
  const purchaseOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      RackStockFilterKeys.purchaseOrderSearch,
      filterNameConstant.PURCHASE_ORDER_SEARCH,
      opts.purchaseOrderSearch.value
    ),
    active: opts.purchaseOrderSearch.active,
  };
  const locationTypesFilter = {
    ...createOptionsField(
      displayOrder++,
      RackStockFilterKeys.locationTypes,
      columnNameConstant.stock.LOCATION_TYPE,
      opts.locationTypes.value,
      true,
      [
        { label: "피킹", value: LocationTypeEnum.PICKING },
        { label: "재고", value: LocationTypeEnum.STOCK },
        { label: "판매 제한", value: LocationTypeEnum.CAN_NOT_SELL },
      ]
    ),
    active: opts.locationTypes.active,
  };
  const safePickingStockFilter = {
    ...createBooleanField(
      displayOrder++,
      RackStockFilterKeys.safePickingStock,
      columnNameConstant.stock.LOCATION_STATUS,
      opts.safePickingStock.value,
      {
        negative: "부족",
        positive: "정상",
      }
    ),
    active: opts.safePickingStock.active,
  };
  const stockedDateFilter = {
    ...createDateField(
      displayOrder++,
      RackStockFilterKeys.stockedDate,
      columnNameConstant.purchaseOrder.STOCKED_DATE,
      opts.stockedDate.value
    ),
    active: opts.stockedDate.active,
  };
  const existStockDetailFilter = {
    ...createBooleanField(
      displayOrder++,
      RackStockFilterKeys.existStockDetail,
      "재고 존재 여부",
      opts.existStockDetail.value,
      {
        negative: "무",
        positive: "유",
      }
    ),
    active: opts.existStockDetail.active,
  };
  const requiredExpDateMgmtFilter = {
    ...createBooleanField(
      displayOrder++,
      RackStockFilterKeys.requiredExpDateMgmt,
      "유통기한 관리 유무",
      opts.requiredExpDateMgmt.value,
      {
        negative: "무",
        positive: "유",
      }
    ),
    active: opts.requiredExpDateMgmt.active,
  };
  const existExpDateFilter = {
    ...createBooleanField(
      displayOrder++,
      RackStockFilterKeys.existExpDate,
      "유통기한 입력 여부",
      opts.existExpDate.value,
      {
        negative: "무",
        positive: "유",
      }
    ),
    active: opts.existExpDate.active,
  };
  const expDateFilter = {
    ...createDateField(
      displayOrder++,
      RackStockFilterKeys.expDate,
      columnNameConstant.stock.EXP_DATE,
      opts.expDate.value
    ),
    active: opts.expDate.active,
  };
  const expDateStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      RackStockFilterKeys.expDateStatus,
      columnNameConstant.stock.EXP_DATE_STATUS,
      opts.expDateStatus.value,
      true,
      stockDetailExpDateStatusChoices
    ),
    active: opts.expDateStatus.active,
  };

  return utils.filterDisplayOrdering([
    existStockDetailFilter,
    sectorSearchFilter,
    locationSearchFilter,
    productSearchFilter,
    purchaseOrderSearchFilter,
    vendorSearchFilter,
    locationTypesFilter,
    safePickingStockFilter,
    stockedDateFilter,
    requiredExpDateMgmtFilter,
    existExpDateFilter,
    expDateFilter,
    expDateStatusFilter,
  ]);
}
</file>

<file path="src/app/views/product/stock/components/RackStockListPage/RackStockListPage.tsx">
import { CheckOutlined, DownloadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { commonErrorMsg } from "@assets/messages/errors/commonError";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { RackLocationFilterInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { excelDownload } from "@utils/excel/excelDownload";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, Input, Row, Space, Table, Typography } from "antd";
import _ from "lodash";
import moment from "moment";
import React, { useEffect, useState } from "react";

import { useUnfulfilledProductVariantsLazyQuery } from "../../../products/api/queries";
import { useStockDetailExpDateUpdateMutation } from "../../api/mutations";
import { useDownloadRackLocationListLazyQuery } from "../../api/queries";
import { DownloadRackLocationListVariables } from "../../api/types/DownloadRackLocationList";
import {
  RackStockList,
  RackStockList_rackStocks_edges_node,
  RackStockListVariables,
} from "../../api/types/RackStockList";
import { StockDetailExpDateUpdateVariables } from "../../api/types/StockDetailExpDateUpdate";
import { RackStockListViewUrlQueryParams, RackStockListViewUrlSortField } from "../../urls";
import { createFilterStructure, RackStockFilterKeys, RackStockFilterOpts } from "./filters";
import {
  getRackLocationListTableSettingsForMobile,
  getRackStockListTableSettings,
  RackStockListTableSettingsProps,
} from "./RackStockListTableSettings";
import { createSorterStructure } from "./sorters";
import { parseRackLocationListAndUnfulfilledPv } from "./utils";

interface RackStockListPageProps
  extends PaginateListProps,
    FilterPageProps<RackStockFilterKeys, RackStockFilterOpts>,
    SortPage<RackStockListViewUrlSortField> {
  params: RackStockListViewUrlQueryParams;
  rackStocks: RackStockList_rackStocks_edges_node[];
  onRackLocationStockVerify: () => void;
  onRackLocationSync: () => void;
  onEmptyRackStockDetailDelete: (rackStock: RackStockList_rackStocks_edges_node) => void;
  onRackStockDetailMove: (rackStock: RackStockList_rackStocks_edges_node) => void;
  onLabelPrint: () => void;
  queryVariablesWithoutPagination: RackStockListVariables;
  fetchForDownload: (variables?: RackStockListVariables) => Promise<ApolloQueryResult<RackStockList>>;
}

const RackStockListPage: React.FC<RackStockListPageProps> = (props) => {
  const {
    params,
    rackStocks,
    onRackLocationStockVerify,
    onRackLocationSync,
    onEmptyRackStockDetailDelete,
    onRackStockDetailMove,
    onLabelPrint,
    currentTab,
    onAll,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    onFilterChange,
    filterOpts,
    fetchForDownload,
    queryVariablesWithoutPagination,
    ...listProps
  } = props;
  const [form] = Form.useForm<StockDetailExpDateUpdateVariables>();
  const TypeSafeForm = getTypeSafeForm<StockDetailExpDateUpdateVariables>(form);
  const [selectedRowId, setSelectedRowId] = useState<string>(null);
  const [loadingForReport, setLoadingForReport] = useState<boolean>(false);

  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const pageDisabled = listProps.disabled || loadingForReport;
  const isMobile = utils.checkMobile();

  const [fetchForRackLocationDownload] = useDownloadRackLocationListLazyQuery();
  const [fetchForUnfulfilledPv] = useUnfulfilledProductVariantsLazyQuery();

  const onDownloadRackLocationList = async () => {
    setLoadingForReport(true);
    showDownloadingMessage();

    try {
      const handleErrorCatch = (e: any) => {
        showNotificationError("로케이션 별 재고 다운로드 중 에러가 발생하였습니다");
        throw e;
      };

      const rackLocationFilterKeys: Array<keyof RackLocationFilterInput> = [
        "sectorSearch",
        "locationSearch",
        "productSearch",
        "vendorSearch",
        "purchaseOrderSearch",
        "canPicking",
        "canStock",
        "canNotSellToCustomers",
        "stockedDate",
        "safePickingStock",
      ];
      const rackLocationFilterInput: RackLocationFilterInput = _.pick(
        queryVariablesWithoutPagination.filter,
        rackLocationFilterKeys
      );
      const queryVariablesForDownload: DownloadRackLocationListVariables = {
        first: GrapheneRelayConnectionMaxLimitEnum.reportRackLocationList,
        filter: rackLocationFilterInput,
      };
      const resRackLocationList = await fetchForRackLocationDownload({ variables: queryVariablesForDownload }).catch(
        handleErrorCatch
      );
      const resUnfulfilledPVList = await fetchForUnfulfilledPv().catch(handleErrorCatch);
      const { columns, header, merges } = parseRackLocationListAndUnfulfilledPv(
        resRackLocationList,
        resUnfulfilledPVList
      );
      if (!columns || columns.length <= 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      const title = "로케이션 별 재고 리스트";
      excelDownload({ title, columns, header, merges, skipOriginHeader: true });

      const rackLocations = resRackLocationList?.data?.rackLocations;
      if (rackLocations?.edges?.length < rackLocations?.totalCount) {
        showNotificationWarn(commonErrorMsg.maxLimitIssue);
      } else {
        showNotificationSuccess(commonMsg.downloadedToXls);
      }
    } finally {
      setLoadingForReport(false);
      destroyDownloadingMessage();
    }
  };

  const [stockDetailExpDateUpdate, stockDetailExpDateUpdateOpts] = useStockDetailExpDateUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data?.stockDetailExpDateUpdate?.errors, "유통기한이 변경 되었습니다.", () => {
        resetFormField();
      }),
  });

  const onStockDetailExpDateUpdate = (formData: StockDetailExpDateUpdateVariables) => {
    stockDetailExpDateUpdate({ variables: formData });
  };

  const setEditableRow = (record: RackStockList_rackStocks_edges_node) => {
    TypeSafeForm.setFields([
      { name: "id", value: record.stockDetail.id },
      { name: "input.expDate", value: record.stockDetail.expDate ?? moment().format(onlyDateFormat) },
    ]);
    setSelectedRowId(record.id);
  };
  const resetFormField = () => {
    form.resetFields();
    setSelectedRowId(null);
  };

  const isEditing = (record: RackStockList_rackStocks_edges_node) => record.id === selectedRowId;
  const onEdit = (record: RackStockList_rackStocks_edges_node) => setEditableRow(record);
  const onCancel = () => resetFormField();

  useEffect(() => {
    resetFormField();
  }, [params]);

  const tableSettingsProps: RackStockListTableSettingsProps = {
    onEmptyRackStockDetailDelete,
    onRackStockDetailMove,
    TypeSafeForm,
    editingProps: {
      isEditing,
      onEdit,
      onCancel,
      disabled: selectedRowId !== null,
      loading: stockDetailExpDateUpdateOpts.loading,
    },
  };
  const columns = getRackStockListTableSettings(tableSettingsProps);
  const columnsForMobile = getRackLocationListTableSettingsForMobile(tableSettingsProps);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const makeResponsiveTable = () => {
    if (isMobile) {
      return (
        <Table
          {...commonTableProps}
          bordered={false}
          showHeader={false}
          loading={pageDisabled}
          columns={columnsForMobile}
          dataSource={rackStocks}
          footer={() => <TableListFooter {...listProps} />}
          components={{
            body: { cell: ({ children }) => <td style={{ padding: "0 0 12px 0" }}>{children}</td> },
          }}
        />
      );
    }
    return (
      <Table
        {...commonTableProps}
        ref={tableRef}
        loading={pageDisabled}
        columns={pickerSelectedColumns}
        dataSource={rackStocks}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        footer={() => <TableListFooter {...listProps} />}
      />
    );
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "rackStocks",
  };

  const makeExtraUi = () => (
    <Space wrap>
      <Button
        type="primary"
        shape="round"
        disabled={pageDisabled}
        onClick={onRackLocationStockVerify}
        icon={<CheckOutlined />}
      >
        재고 현황 불일치 체크
      </Button>
      <Button type="primary" shape="round" disabled={pageDisabled} onClick={onRackLocationSync}>
        재고 현황 갱신
      </Button>
      <Button type="primary" shape="round" disabled={pageDisabled} onClick={onLabelPrint} icon={<DownloadOutlined />}>
        라벨 출력
      </Button>
      <Button
        type="primary"
        shape="round"
        disabled={pageDisabled}
        onClick={onDownloadRackLocationList}
        icon={<DownloadOutlined />}
      >
        로케이션 별 재고 출력
      </Button>
    </Space>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.rackStocks}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          onFilterChange={onFilterChange}
          filterStructure={filterStructure}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
              <SorterDropdown sorterStructure={sorterStructure} sort={props.sort} onSort={props.onSort} />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />

        <Form form={form} name="stock-detail-exp-date-form" onFinish={onStockDetailExpDateUpdate}>
          <Form.Item hidden name={TypeSafeForm.getValidDataIndex("id")}>
            <Input />
          </Form.Item>

          <TableVatLegend isIncludeVat={false} />
          {makeResponsiveTable()}
        </Form>
      </Card>
    </Space>
  );
};

export default RackStockListPage;
</file>

