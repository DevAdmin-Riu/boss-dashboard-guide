<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderRevertLinesModal/PurchaseOrderRevertLinesModal.tsx">
import { PurchaseOrderLineStatusEnum } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import React from "react";

import { PurchaseOrderLinesRevertVariables } from "../../api/types/PurchaseOrderLinesRevert";

interface PurchaseOrderRevertLinesModalProps {
  open: boolean;
  revertModalConfig: {
    modalTitleText: string;
    titleText: string;
    helpText: string;
    beforeStatus: PurchaseOrderLineStatusEnum;
    afterStatus: PurchaseOrderLineStatusEnum | null;
    message: string;
    requiresSplit?: boolean;
  };
  handleLinesRevert: (variables: PurchaseOrderLinesRevertVariables, message: string) => Promise<void>;
  onModalClose: () => void;
  purchaseOrderLineIds: string[];
  checkValidation?: () => boolean;
}

const PurchaseOrderRevertLinesModal: React.FC<PurchaseOrderRevertLinesModalProps> = (props) => {
  const {
    open,
    revertModalConfig,
    handleLinesRevert,
    onModalClose,
    purchaseOrderLineIds,
    checkValidation = () => false,
  } = props;
  return (
    <ConfirmModal
      visible={open}
      onOk={() => {
        const isValidation = checkValidation();
        if (isValidation) {
          return;
        }
        if (purchaseOrderLineIds.length === 0) {
          showNotificationError(
            `현재 선택한 발주 품목 중 ${revertModalConfig.message}로 되돌릴 수 있는 품목이 존재하지 않습니다.`
          );
          return;
        }
        if (
          utils.isEmpty(revertModalConfig.beforeStatus) ||
          (!revertModalConfig.requiresSplit && utils.isEmpty(revertModalConfig.afterStatus))
        ) {
          showNotificationError(`발주 품목 ${revertModalConfig.message} 실패: 상태가 올바르지 않습니다.`);
          return;
        }
        // requiresSplit이 true면 handleLinesRevert에서 내부적으로 처리
        const variables: PurchaseOrderLinesRevertVariables = revertModalConfig.requiresSplit
          ? ({} as PurchaseOrderLinesRevertVariables)
          : {
              input: {
                purchaseOrderLineIds,
                beforeStatus: revertModalConfig.beforeStatus,
                afterStatus: revertModalConfig.afterStatus!,
              },
            };
        handleLinesRevert(variables, revertModalConfig.message);
      }}
      onCancel={onModalClose}
      modalTitleText={revertModalConfig.modalTitleText}
      titleText={revertModalConfig.titleText}
      helpText={revertModalConfig.helpText}
    />
  );
};

export default PurchaseOrderRevertLinesModal;
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderSendEmailModal/PurchaseOrderSendEmailModal.tsx">
import { UploadOutlined } from "@ant-design/icons";
import useUser from "@hooks/useUser";
import { User } from "@src/api/fragments/types/User";
import { PurchaseOrderSentEmailInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { PurchaseOrderDetails_purchaseOrder } from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseOrderDetails";
import {
  getPurchaseOrderEventTypeText,
  makePurchaseOrderLineNumberWithPoAndLine,
} from "@src/app/views/purchase/purchaseOrders/utils";
import {
  findVendorManager,
  findVendorManagers,
  makeVendorManagerInfo,
  VendorManagerTypeEnum,
} from "@src/app/views/purchase/vendors/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Checkbox, Descriptions, Form, Input, Modal, Upload, UploadFile, UploadProps } from "antd";
import React, { useEffect, useState } from "react";

import { usePurchaseOrderSendMutation, usePurchaseOrderSentEmailCreateMutation } from "../../api/mutations";
import { usePrintPurchaseOrderLazyQuery } from "../../api/queries";
import { onPurchaseOrderDownloadOrSend } from "../PurchaseOrderDetailsPage/utils";

type TPurchaseOrderSentEmailModalSubmitInput = StrictOmit<PurchaseOrderSentEmailInput, "file">;

interface PurchaseOrderSendEmailModalProps {
  open: boolean;
  disabled: boolean;
  purchaseOrder: PurchaseOrderDetails_purchaseOrder;
  onClose: () => void;
}

interface IPurchaseOrderSendEmailForm {
  sendEmail: boolean; // 이메일 전송 여부
  title: string;
  fromEmail: string;
  recipientList: string;
  ccList: string;
  additionalContent: string;
}

const getFormInitialValues = (
  purchaseOrder: PurchaseOrderDetails_purchaseOrder,
  eventTypeLabel: string,
  firstOrderLineProductName: string,
  lineCount: number,
  user: User
): IPurchaseOrderSendEmailForm => {
  const isSent = purchaseOrder.isSent;
  const poVendor = purchaseOrder.vendor;
  const usePoEmail = poVendor?.usePoEmail;
  const vendorManagers = makeVendorManagerInfo(poVendor?.managers);
  const vendorMainOrderManager = findVendorManager(vendorManagers, VendorManagerTypeEnum.ORDER);
  const vendorSubOrderManagers = findVendorManagers(vendorManagers, [
    VendorManagerTypeEnum.ORDER_FIRST_SUB,
    VendorManagerTypeEnum.ORDER_SECOND_SUB,
  ]);
  const mainOrderManagerEmail = vendorMainOrderManager?.email;
  const currentUserEmail = user.email;

  const eventTypeLabelString = eventTypeLabel ? ` [${eventTypeLabel}] ` : ``;

  const ccEmailList = vendorSubOrderManagers.map((manager) => manager.email);
  ccEmailList.push(currentUserEmail);

  let title: string;
  if (lineCount === 1) {
    title = `[㈜리우]${eventTypeLabelString} ${firstOrderLineProductName} 발주 요청의 건`;
  } else {
    title = `[㈜리우]${eventTypeLabelString} ${firstOrderLineProductName} 외 ${lineCount - 1}건 발주 요청의 건`;
  }

  return {
    sendEmail: isSent || usePoEmail,
    title,
    fromEmail: currentUserEmail,
    recipientList: mainOrderManagerEmail,
    ccList: utils.reverseSplitEmailList(ccEmailList),
    additionalContent: "",
  };
};

const PurchaseOrderSendEmailModal: React.FC<PurchaseOrderSendEmailModalProps> = (props) => {
  const { open, disabled, purchaseOrder, onClose } = props;
  const { user } = useUser();
  const [form] = Form.useForm<IPurchaseOrderSendEmailForm>();
  const TypeSafeForm = getTypeSafeForm<IPurchaseOrderSendEmailForm>(form);

  const [loading, setLoading] = useState(false);
  const [additionalFileList, setAdditionalFileList] = useState<UploadFile[]>([]);
  const isAdditionalFileListEmpty = additionalFileList.length === 0;
  const purchaseOrderId = purchaseOrder.id;
  const isSent = purchaseOrder.isSent;

  const sendEmailWatched = TypeSafeForm.getUseFormWatched({ name: "sendEmail" });

  const [fetch] = usePrintPurchaseOrderLazyQuery();

  const successMsg = "발주서를 발송했습니다.";
  const [purchaseOrderSend, purchaseOrderSendOpts] = usePurchaseOrderSendMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.purchaseOrderSend.errors, successMsg, () => {
        onClose();
      }),
  });
  const [purchaseOrderSentEmailCreate, purchaseOrderSentEmailCreateOpts] = usePurchaseOrderSentEmailCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.purchaseOrderSentEmailCreate.errors, successMsg, () => {
        onClose();
      }),
  });

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  // purchaseOrder.lines가 0인 경우 return
  if (purchaseOrder.lines.length === 0) {
    return null;
  }

  const modalTitle = "발주서 발송";
  const okText = "발송";

  const eventTypeLabel = getPurchaseOrderEventTypeText(purchaseOrder.eventType, purchaseOrder.isB2b);
  const firstOrderLinePoCode = makePurchaseOrderLineNumberWithPoAndLine(purchaseOrder, purchaseOrder.lines[0]);
  const firstOrderLineProductName = purchaseOrder.lines[0].productName;
  const lineCount = purchaseOrder.lines.length;
  const formInitialValues = getFormInitialValues(
    purchaseOrder,
    eventTypeLabel,
    firstOrderLineProductName,
    lineCount,
    user
  );
  let textAreaPrefix = `안녕하세요.\n주식회사 리우 ${user.firstName}입니다.\n\n첨부된 발주서와 함께 아래 발주 내용을 확인하시어 납품 준비 및 발주 접수를 진행해주시기 바랍니다.\n\n`;
  if (eventTypeLabel) {
    textAreaPrefix = `${textAreaPrefix}▶ 발주구분: ${eventTypeLabel}\n`;
  }
  if (lineCount === 1) {
    textAreaPrefix = `${textAreaPrefix}▶ 발주상세번호: ${firstOrderLinePoCode}\n`;
    textAreaPrefix = `${textAreaPrefix}▶ 발주제품명: ${firstOrderLineProductName}\n`;
  } else {
    textAreaPrefix = `${textAreaPrefix}▶ 발주상세번호: ${firstOrderLinePoCode} 외 ${lineCount - 1}건\n`;
    textAreaPrefix = `${textAreaPrefix}▶ 발주제품명: ${firstOrderLineProductName} 외 ${lineCount - 1}건\n`;
  }
  textAreaPrefix = `${textAreaPrefix}\n[발주서 다운로드]`;
  if (!isAdditionalFileListEmpty) {
    const buttonName =
      additionalFileList[0].name.length > 20
        ? `${additionalFileList[0].name.substring(0, 20)}...`
        : additionalFileList[0].name;
    textAreaPrefix = `${textAreaPrefix}\n['${buttonName}' 다운로드 버튼]`;
  }

  const textAreaPostfix = `\n감사합니다.`;

  const uploadProps: UploadProps = {
    onRemove: (file) => {
      setAdditionalFileList([]);
    },
    beforeUpload: (file) => {
      setAdditionalFileList([file]);
      return false;
    },
    fileList: additionalFileList,
  };

  const onSubmit = async (input: TPurchaseOrderSentEmailModalSubmitInput) => {
    if (utils.isEmpty(input)) {
      purchaseOrderSend({ variables: { id: purchaseOrderId } });
    } else {
      if (!input.title) {
        showNotificationError("메일 제목을 입력해주세요.");
        return;
      }
      if (!input.fromEmail) {
        showNotificationError("발신자 이메일을 입력해주세요.");
        return;
      }
      if (input.recipientList.length === 0) {
        showNotificationError("수신자 이메일을 입력해주세요.");
        return;
      }

      setLoading(true);
      fetch({ variables: { id: purchaseOrderId } })
        .then((resPurchaseOrder) => {
          if (isSent) {
            const onSentEmailCreate = (file: File) =>
              purchaseOrderSentEmailCreate({ variables: { input: { ...input, file } } });
            onPurchaseOrderDownloadOrSend({
              resPurchaseOrder,
              isSendingMode: true,
              onSend: onSentEmailCreate,
              user,
            });
          } else {
            const onSend = (file: File) =>
              purchaseOrderSend({ variables: { id: purchaseOrderId, sentEmailInput: { ...input, file } } });
            onPurchaseOrderDownloadOrSend({
              resPurchaseOrder,
              isSendingMode: true,
              onSend,
              user,
            });
          }
        })
        .catch((e) => {
          showNotificationError("발주서 전송 과정에서 에러가 발생하였습니다");
          throw e;
        })
        .finally(() => {
          setLoading(false);
        });
    }
  };

  const modalLoading = loading || purchaseOrderSendOpts.loading || purchaseOrderSentEmailCreateOpts.loading;

  return (
    <Modal
      destroyOnClose
      title={modalTitle}
      open={open}
      onOk={form.submit}
      onCancel={onClose}
      width={1000}
      okButtonProps={{ disabled, loading: modalLoading }}
      cancelButtonProps={{ disabled }}
      okText={okText}
      maskClosable={false}
    >
      <Form
        form={form}
        onFinish={(formData) => {
          const sendEmail = formData.sendEmail;
          if (sendEmail === false) {
            onSubmit(null);
            return;
          }
          const splitRecipientList = utils.splitEmailList(formData.recipientList.toString());
          const splitCcList = utils.splitEmailList(formData.ccList.toString());
          const input: TPurchaseOrderSentEmailModalSubmitInput = {
            purchaseOrder: purchaseOrderId,
            title: formData.title,
            fromEmail: formData.fromEmail,
            recipientList: splitRecipientList,
            ccList: splitCcList,
            additionalContent: formData.additionalContent,
          };
          if (additionalFileList.length > 0) {
            input.additionalFile = additionalFileList[0];
          }
          onSubmit(input);
        }}
        initialValues={formInitialValues}
        preserve={false}
      >
        <Form.Item name={TypeSafeForm.getValidDataIndex("sendEmail")} label="이메일 발송 여부" valuePropName="checked">
          <Checkbox disabled={isSent} />
        </Form.Item>
        {sendEmailWatched ? (
          <>
            <Descriptions bordered size={"small"} column={4} labelStyle={{ width: 150 }}>
              <Descriptions.Item span={4} label={"메일제목"}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("title")} noStyle>
                  <Input type="text" />
                </Form.Item>
              </Descriptions.Item>
              <Descriptions.Item span={4} label={"보내는 사람"}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("fromEmail")} noStyle>
                  <Input type="text" />
                </Form.Item>
              </Descriptions.Item>
              <Descriptions.Item span={4} label={"받는 사람"}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("recipientList")} noStyle>
                  <Input type="text" />
                </Form.Item>
              </Descriptions.Item>
              <Descriptions.Item span={4} label={"참조"}>
                <Form.Item name={TypeSafeForm.getValidDataIndex("ccList")} noStyle>
                  <Input type="text" />
                </Form.Item>
              </Descriptions.Item>
              <Descriptions.Item span={4} label={"추가 첨부파일"}>
                <Upload {...uploadProps}>
                  <Button icon={<UploadOutlined />}>첨부 파일(1개)</Button>
                </Upload>
              </Descriptions.Item>
              <Descriptions.Item span={4} label={"메일 내용"}>
                <Input.TextArea
                  rows={isAdditionalFileListEmpty ? 10 : 12}
                  disabled={true}
                  value={textAreaPrefix}
                ></Input.TextArea>
                <Form.Item name={TypeSafeForm.getValidDataIndex("additionalContent")} noStyle>
                  <Input.TextArea rows={4} />
                </Form.Item>
                <Input.TextArea rows={4} disabled={true} defaultValue={textAreaPostfix}></Input.TextArea>
              </Descriptions.Item>
            </Descriptions>
          </>
        ) : (
          "이메일 발송 여부가 체크 해제되어 있는 경우, 발송 클릭하여도 실제로 이메일 발송을 하지 않습니다."
        )}
      </Form>
    </Modal>
  );
};
export default PurchaseOrderSendEmailModal;
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderTakeBackLines/PurchaseOrderTakeBackLines.tsx">
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { utils } from "@utils/utils";
import { Card, DatePicker, Form, FormInstance, Input, Table, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import moment, { Moment } from "moment";
import React, { useState } from "react";

import { checkTakeBackPurchaseOrder } from "../../utils";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePageFormData,
  TPurchaseOrderCreateLinesObj,
} from "../PurchaseOrderCreatePage/PurchaseOrderCreatePage";
import {
  checkTakeBackDisabled,
  getPurchaseOrderTakeBackLinesTableSettings,
} from "./PurchaseOrderTakeBackLinesTableSettings";

interface PurchaseOrderTakeBackLinesProps {
  form: FormInstance<PurchaseOrderCreatePageFormData>;
  disabled: boolean;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
}

export const PurchaseOrderTakeBackLines: React.FC<PurchaseOrderTakeBackLinesProps> = ({
  form,
  disabled,
  openModalWithoutNavigate,
}) => {
  const [selectedRowKeys, setSelectedRowKeys] = useState<string[]>([]);

  const eventTypeWatched = Form.useWatch("eventType", form);
  const purchaseOrderDateWatched = Form.useWatch("purchaseOrderDate", form);
  const vendorWatched = Form.useWatch("vendor", form);
  const linesObjWatched = Form.useWatch("linesObj", form);
  const linesWatched = convertFormLinesObjToArr(linesObjWatched, "lineKey");

  const watchedValues = {
    eventType: eventTypeWatched,
    purchaseOrderDate: purchaseOrderDateWatched,
    vendor: vendorWatched,
  };

  const isTackBackPurchaseOrder = checkTakeBackPurchaseOrder(watchedValues.eventType);

  const rowSelection: TableRowSelection<IPurchaseOrderCreateLine> = {
    fixed: true,
    type: "checkbox",
    selectedRowKeys,
    onChange: (selectedRowKeys) => {
      const selectedUpdatedLinesObj = Object.keys(linesObjWatched).reduce<TPurchaseOrderCreateLinesObj>((acc, key) => {
        const line = linesObjWatched[key];
        const updatedLine: IPurchaseOrderCreateLine = { ...line, isSelected: selectedRowKeys.includes(line.lineKey) };
        acc[key] = updatedLine;
        return acc;
      }, {});
      form.setFieldValue("linesObj", selectedUpdatedLinesObj);
      setSelectedRowKeys(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record) => ({
      disabled: checkTakeBackDisabled(record.takeBackPurchaseOrderLine, isTackBackPurchaseOrder),
    }),
  };

  const onDefaultDeliveryDateChange = (defaultAskingPurchaseDate: Moment | null) => {
    const apdUpdatedLinesObj = Object.keys(linesObjWatched).reduce<TPurchaseOrderCreateLinesObj>((acc, key) => {
      const line = linesObjWatched[key];
      const updatedLine: IPurchaseOrderCreateLine = { ...line, askingPurchaseDate: defaultAskingPurchaseDate };
      acc[key] = updatedLine;
      return acc;
    }, {});
    form.setFieldValue("linesObj", apdUpdatedLinesObj);
  };

  const cardTitle = <Typography.Title level={4}>발주제품</Typography.Title>;

  const disabledDefaultDeliveryDate = (current: Moment) =>
    current && current < moment(purchaseOrderDateWatched).startOf("day");
  const cardExtra = (
    <Form.Item name="defaultAskingPurchaseDate" noStyle>
      <DatePicker
        style={{ width: 200 }}
        allowClear={false}
        disabledDate={disabledDefaultDeliveryDate}
        placeholder={"반품요청일 기본값"}
        onChange={onDefaultDeliveryDateChange}
      />
    </Form.Item>
  );

  const columns = getPurchaseOrderTakeBackLinesTableSettings({
    watchedValues,
    disabled,
    openModalWithoutNavigate,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <Card title={cardTitle} extra={cardExtra} bodyStyle={{ padding: 0 }}>
        <TableVatLegend isIncludeVat={false} size="small" />
        <Form.Item name="linesObj" hidden>
          <Input />
        </Form.Item>
        <Table<IPurchaseOrderCreateLine>
          {...commonTableProps}
          rowSelection={rowSelection}
          rowKey={(record) => record.lineKey}
          dataSource={linesWatched}
          columns={columns}
          sticky={{ offsetHeader: 80, offsetScroll: 100 }}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
    </>
  );
};
</file>

