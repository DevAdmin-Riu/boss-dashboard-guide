<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderCreateProductConfirmModal.tsx">
import { PurchaseOrderEventType } from "@src/api/types/globalTypes";
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { NumberComponent } from "@src/app/components/Number";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { ProductVariantListToAdd_productVariants_edges_node } from "@src/app/views/product/products/api/types/ProductVariantListToAdd";
import { ProductToBeChangedInfoModal } from "@src/app/views/product/products/components/ProductToBeChangedInfoModal";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { calculateDaysUntilDepletion, getAvailableQtyConsiderVirtualAlloc } from "@src/app/views/product/stock/utils";
import { findValueInEnum, makeVendorDisplayName } from "@utils/misc";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Descriptions, FormInstance, Space } from "antd";
import Table, { ColumnsType } from "antd/lib/table";
import { ColumnType } from "antd/lib/table";
import moment from "moment";
import React, { useEffect, useState } from "react";

import { getPurchaseOrderDeliveryWarehouseAddress, getPurchaseOrderEventTypeText, makePoLineQtyText } from "../utils";
import { DepletionCheckModal } from "./DepletionCheckModal";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePageFormData,
} from "./PurchaseOrderCreatePage/PurchaseOrderCreatePage";
import { EXTERNAL_WAREHOUSE_ID } from "./PurchaseOrderCreatePage/utils";
import { getSafetyStockProductVariantList, getSelectedVariantVendor } from "./PurchaseOrderCreatePage/utils";
import { PurchaseOrderStockCheckModal } from "./PurchaseOrderStockCheckModal";
import { SeasonalCheckModal } from "./SeasonalCheckModal";

// 재고 확인 상태 계산 함수
const calculateStockCheckStatus = (line: IPurchaseOrderCreateLine, selectedAddressId: string): "none" | "warning" => {
  // 외부업체인 경우 재고 확인 불필요
  if (selectedAddressId === EXTERNAL_WAREHOUSE_ID) {
    return "none";
  }

  const variant = line.variant as ProductVariantListToAdd_productVariants_edges_node;
  const rackStocks = variant?.rackStocks || [];

  // 재고가 전혀 없는 경우
  if (rackStocks.length === 0) {
    return "none";
  }

  // 선택된 주소와 연동된 구역에 재고가 있는지 확인
  const hasStockInSelectedAddress = rackStocks.some(
    (stock) => stock.remainQuantity > 0 && stock.location?.sector?.address?.id === selectedAddressId
  );

  // 선택된 주소와 연동된 구역에 재고가 있으면 확인 불필요
  if (hasStockInSelectedAddress) {
    return "none";
  }

  // 다른 주소와 연동된 구역에 재고가 있는지 확인
  const hasStockInOtherAddress = rackStocks.some(
    (stock) =>
      stock.remainQuantity > 0 &&
      stock.location?.sector?.address?.id &&
      stock.location?.sector?.address?.id !== selectedAddressId
  );

  // 다른 주소에 재고가 있으면 경고
  return hasStockInOtherAddress ? "warning" : "none";
};

interface IToBeChangedInfoForConfirm {
  variantId: string;
  checked: boolean;
}

interface IStockCheckForConfirm {
  variantId: string;
  checked: boolean;
  status: "none" | "warning" | "confirmed"; // none: 회색, warning: 빨강, confirmed: 파랑
}

interface ISeasonalCheckForConfirm {
  variantId: string;
  checked: boolean;
  isInPeakSeason: boolean;
}

interface IDepletionCheckForConfirm {
  variantId: string;
  checked: boolean;
  daysUntilDepletion: number;
  needsCheck: boolean; // 120일 이상인 경우 true
}

interface PurchaseOrderCreateProductConfirmModalProps {
  form: FormInstance<PurchaseOrderCreatePageFormData>;
  modalTitleText: string;
  open: boolean;
  okText: string;
  disabled: boolean;
  onCreate: (data: PurchaseOrderCreatePageFormData) => void;
  onCancel: () => void;
  isB2b?: boolean;
  isStaff?: boolean;
}

const PurchaseOrderCreateProductConfirmModal: React.FC<PurchaseOrderCreateProductConfirmModalProps> = (props) => {
  const { form, modalTitleText, open, okText, disabled, onCreate, onCancel, isB2b = false, isStaff = false } = props;
  const [selectedLineForToBeChangedInfoConfirm, setSelectedLineForToBeChangedInfoConfirm] =
    useState<IPurchaseOrderCreateLine>(null);
  const [toBeChangedInfoListForConfirm, setToBeChangedInfoListForConfirm] = useState<IToBeChangedInfoForConfirm[]>([]);
  const [stockCheckListForConfirm, setStockCheckListForConfirm] = useState<IStockCheckForConfirm[]>([]);
  const [selectedLineForStockCheck, setSelectedLineForStockCheck] = useState<IPurchaseOrderCreateLine>(null);
  const [seasonalCheckListForConfirm, setSeasonalCheckListForConfirm] = useState<ISeasonalCheckForConfirm[]>([]);
  const [selectedLineForSeasonalCheck, setSelectedLineForSeasonalCheck] = useState<IPurchaseOrderCreateLine>(null);
  const [depletionCheckListForConfirm, setDepletionCheckListForConfirm] = useState<IDepletionCheckForConfirm[]>([]);
  const [selectedLineForDepletionCheck, setSelectedLineForDepletionCheck] = useState<IPurchaseOrderCreateLine>(null);

  const noneButton = <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>없음</Button>;

  const formData = form.getFieldsValue();
  const eventTypeEnum = formData?.eventType;
  const eventType = eventTypeEnum && findValueInEnum(eventTypeEnum, PurchaseOrderEventType);
  const lines = convertFormLinesObjToArr(formData?.linesObj, "lineKey");
  const safetyStockProductVariants = getSafetyStockProductVariantList(lines);
  const safetyStockProductVariantsText = safetyStockProductVariants.join(", ");
  const titleText = isB2b
    ? "아래 제품 리스트에 대해 같은 협력사끼리 그룹핑 되어 발주서 등록 예정입니다."
    : utils.isEmpty(safetyStockProductVariants)
    ? "아래 제품 리스트에 대해 같은 협력사끼리 그룹핑 되어 발주서 등록 예정입니다."
    : `[ ${safetyStockProductVariantsText} ]: 해당 제품 목록은 재고 부족 제품이 아닙니다. 발주서 등록을 진행하시겠습니까?(발주서는 같은 협력사끼리 그룹핑 되어 등록 예정)`;

  useEffect(() => {
    if (!open) {
      return;
    }

    const newConfirmedToBeChangedInfoList: IToBeChangedInfoForConfirm[] = lines
      ?.filter((item) => item.variant?.product.defaultVariant.toBeChangedInfo !== null)
      .map((item) => ({
        variantId: item.variantId,
        checked: false,
      }));

    setToBeChangedInfoListForConfirm(newConfirmedToBeChangedInfoList);

    // 재고 확인 리스트 초기화 (외부업체가 아닌 경우만)
    const selectedAddressId = formData?.warehouseAddress;
    if (!isB2b && selectedAddressId !== EXTERNAL_WAREHOUSE_ID) {
      const newStockCheckList: IStockCheckForConfirm[] = lines?.map((item) => {
        const status = calculateStockCheckStatus(item, selectedAddressId);
        return {
          variantId: item.variantId,
          checked: false,
          status,
        };
      });
      setStockCheckListForConfirm(newStockCheckList);
    } else {
      setStockCheckListForConfirm([]);
    }

    if (isStaff && !isB2b) {
      const newSeasonalCheckList: ISeasonalCheckForConfirm[] = lines?.map((item) => {
        const variantAny = item.variant;
        const isSeasonal = variantAny.isSeasonal;
        const peakSeasonStartDate = variantAny.peakSeasonStartDate;
        const peakSeasonEndDate = variantAny.peakSeasonEndDate;
        const today = moment();
        const isInPeakSeason =
          isSeasonal &&
          peakSeasonStartDate &&
          peakSeasonEndDate &&
          today.isBetween(moment(peakSeasonStartDate), moment(peakSeasonEndDate), "day", "[]");
        return {
          variantId: item.variantId,
          checked: false,
          isInPeakSeason: isInPeakSeason || false,
        };
      });
      setSeasonalCheckListForConfirm(newSeasonalCheckList);

      const newDepletionCheckList: IDepletionCheckForConfirm[] = lines?.map((item) => {
        const daysUntilDepletion = calculateDaysUntilDepletion(item.variant, item.quantity || 0);
        const needsCheck = daysUntilDepletion >= 120;
        return {
          variantId: item.variantId,
          checked: false,
          daysUntilDepletion,
          needsCheck,
        };
      });
      setDepletionCheckListForConfirm(newDepletionCheckList);
    } else {
      setSeasonalCheckListForConfirm([]);
      setDepletionCheckListForConfirm([]);
    }
  }, [open]);

  const purchaseOrderSummaryToCreate = isB2b ? (
    <Descriptions bordered size={"small"} column={2}>
      <Descriptions.Item label={"발주구분"}>{getPurchaseOrderEventTypeText(eventTypeEnum, isB2b)}</Descriptions.Item>
      <Descriptions.Item label={"발주일"}>
        {moment(formData.purchaseOrderDate).format(onlyDateFormat)}
      </Descriptions.Item>
    </Descriptions>
  ) : (
    <Descriptions bordered size={"small"} column={2}>
      <Descriptions.Item label={"발주구분"}>{getPurchaseOrderEventTypeText(eventTypeEnum)}</Descriptions.Item>
      <Descriptions.Item label={"발주일"}>
        {moment(formData.purchaseOrderDate).format(onlyDateFormat)}
      </Descriptions.Item>
      <Descriptions.Item label={"납품처"} span={2}>
        {formData?.deliveryWarehouseName || "-"}
      </Descriptions.Item>
      <Descriptions.Item label={"납품처 주소"} span={2}>
        {getPurchaseOrderDeliveryWarehouseAddress(formData)}
      </Descriptions.Item>
    </Descriptions>
  );

  const dataSource = lines.sort((a, b) =>
    makeVendorDisplayName(getSelectedVariantVendor(a)).toUpperCase() <
    makeVendorDisplayName(getSelectedVariantVendor(b)).toUpperCase()
      ? -1
      : 1
  );

  const columns: ColumnsType<IPurchaseOrderCreateLine> = (
    [
      {
        title: columnNameConstant.vendor.VENDOR_NAME,
        key: "vendorName",
        align: "center",
        width: 150,
        render: (_, record) => makeVendorDisplayName(getSelectedVariantVendor(record)),
      },
      {
        title: columnNameConstant.product.SKU,
        key: "sku",
        align: "center",
        width: 120,
        render: (_, record) => record.variant?.sku || "-",
      },
      {
        title: columnNameConstant.product.PRODUCT_NAME,
        key: "productName",
        align: "left",
        width: 200,
        render: (_, record) => record.variant?.product?.name || "-",
      },
      {
        title: columnNameConstant.product.VARIANT_NAME,
        key: "variantName",
        align: "left",
        width: 100,
        render: (_, record) => record.variant?.name || "-",
      },
      {
        title: columnNameConstant.product.DETAIL_INFO,
        key: "attributes",
        align: "left",
        width: 200,
        render: (_, record) => {
          const product = record.variant?.product;
          const hasVariants = product.productType.hasVariants;
          const targetAttributes = hasVariants ? record.variant.attributes : product.attributes;
          return makeProductSpecTextFromAttr(targetAttributes);
        },
      },
      {
        title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
        key: "qtyPerBox",
        align: "center",
        width: 80,
        render: (_, record) => makeProductQtyPerBoxText(record.variant),
      },
      {
        title: columnNameConstant.purchaseOrder.PO_AMOUNT,
        key: "quantity",
        align: "center",
        width: 80,
        render: (_, record) => makePoLineQtyText(eventType, record),
      },
      isStaff &&
        !isB2b &&
        ({
          title: "최근 입고일",
          key: "lastStockedDate",
          align: "center",
          width: 100,
          render: (_, record) => {
            const lastStockedPoLine = record.variant.lastStockedPoLine;
            if (!lastStockedPoLine || !lastStockedPoLine.purchaseDate) {
              return "-";
            }
            return moment(lastStockedPoLine.purchaseDate).format(onlyDateFormat);
          },
        } as ColumnType<IPurchaseOrderCreateLine>),
      isStaff &&
        !isB2b &&
        ({
          title: "최근 입고수량",
          key: "lastStockedQty",
          align: "right",
          width: 100,
          render: (_, record) => {
            const lastStockedPoLine = record.variant.lastStockedPoLine;
            if (!lastStockedPoLine || lastStockedPoLine.purchaseQuantity == null) {
              return "-";
            }
            return <NumberComponent value={lastStockedPoLine.purchaseQuantity} />;
          },
        } as ColumnType<IPurchaseOrderCreateLine>),
      isStaff &&
        !isB2b && {
          title: "현재고",
          key: "availableQtyConsiderVirtualAlloc",
          align: "right",
          width: 80,
          render: (_, record) => <NumberComponent value={getAvailableQtyConsiderVirtualAlloc(record.variant)} />,
        },
      isStaff &&
        !isB2b && {
          title: "최근 30일 일평균",
          key: "last30DaysAvgSalesDailyQty",
          align: "right",
          width: 150,
          render: (_, record) => {
            const value = record.variant.last30DaysAvgSalesDailyQty;
            return value != null ? value.toFixed(2) : "-";
          },
        },
      {
        title: columnNameConstant.product.TO_BE_CHANGED_INFO,
        key: "toBeChanged",
        fixed: utils.fixedRightFlag(),
        align: "center",
        width: 80,
        render: (_, record) => {
          if (record.variant.product.defaultVariant.toBeChangedInfo === null) {
            return noneButton;
          } else {
            const findIdx = toBeChangedInfoListForConfirm.findIndex((item) => item.variantId === record.variantId);
            if (findIdx === -1) {
              return <>-</>;
            }
            if (!toBeChangedInfoListForConfirm[findIdx].checked) {
              return (
                <Button
                  onClick={() => setSelectedLineForToBeChangedInfoConfirm(record)}
                  style={{ cursor: "default", backgroundColor: "red", color: "#fff" }}
                >
                  확인
                </Button>
              );
            } else {
              return <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>확인</Button>;
            }
          }
        },
      },
      {
        title: columnNameConstant.product.STOCK_CHECK,
        key: "stockCheck",
        fixed: utils.fixedRightFlag(),
        align: "center",
        width: 80,
        render: (_, record) => {
          // B2B이거나 외부업체인 경우 재고 확인 컬럼 표시 안함
          if (isB2b || formData?.warehouseAddress === EXTERNAL_WAREHOUSE_ID) {
            return noneButton;
          }

          const findIdx = stockCheckListForConfirm.findIndex((item) => item.variantId === record.variantId);
          if (findIdx === -1) {
            return <>-</>;
          }

          const stockCheck = stockCheckListForConfirm[findIdx];

          // none: 회색 - 없음
          if (stockCheck.status === "none") {
            return noneButton;
          }

          // warning: 빨강 - 확인 (확인 전)
          if (stockCheck.status === "warning" && !stockCheck.checked) {
            return (
              <Button
                onClick={() => setSelectedLineForStockCheck(record)}
                style={{ cursor: "pointer", backgroundColor: "red", color: "#fff" }}
              >
                확인
              </Button>
            );
          }

          // confirmed: 초록 - 확인 (확인 후)
          if (stockCheck.status === "warning" && stockCheck.checked) {
            return <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>확인</Button>;
          }

          return <>-</>;
        },
      },
      isStaff &&
        !isB2b && {
          title: "계절 제품",
          key: "seasonalCheck",
          fixed: utils.fixedRightFlag(),
          align: "center",
          width: 80,
          render: (_, record) => {
            const findIdx = seasonalCheckListForConfirm.findIndex((item) => item.variantId === record.variantId);
            if (findIdx === -1) {
              return <>-</>;
            }

            const seasonalCheck = seasonalCheckListForConfirm[findIdx];

            // 성수기가 아닌 경우 회색 버튼
            if (!seasonalCheck.isInPeakSeason) {
              return noneButton;
            }

            // 성수기이고 확인 전
            if (!seasonalCheck.checked) {
              return (
                <Button
                  onClick={() => setSelectedLineForSeasonalCheck(record)}
                  style={{ cursor: "pointer", backgroundColor: "red", color: "#fff" }}
                >
                  확인
                </Button>
              );
            }

            // 성수기이고 확인 후
            return <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>확인</Button>;
          },
        },
      isStaff &&
        !isB2b && {
          title: "악성재고 예상",
          key: "depletionCheck",
          fixed: utils.fixedRightFlag(),
          align: "center",
          width: 100,
          render: (_, record) => {
            const findIdx = depletionCheckListForConfirm.findIndex((item) => item.variantId === record.variantId);
            if (findIdx === -1) {
              return <>-</>;
            }

            const depletionCheck = depletionCheckListForConfirm[findIdx];

            // 120일 미만인 경우 회색 버튼
            if (!depletionCheck.needsCheck) {
              return noneButton;
            }

            // 120일 이상이고 확인 전
            if (!depletionCheck.checked) {
              return (
                <Button
                  onClick={() => setSelectedLineForDepletionCheck(record)}
                  style={{ cursor: "pointer", backgroundColor: "red", color: "#fff" }}
                >
                  확인
                </Button>
              );
            }

            // 120일 이상이고 확인 후
            return <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>확인</Button>;
          },
        },
    ] as ColumnsType<IPurchaseOrderCreateLine>
  ).filter(Boolean);

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <ConfirmModal
        modalTitleText={modalTitleText}
        visible={open}
        titleText={titleText}
        maskClosable={false}
        contentNode={
          <Space direction={"vertical"}>
            {purchaseOrderSummaryToCreate}
            <Table
              bordered
              size="small"
              rowKey={(record) => record.variant.id}
              columns={columns}
              dataSource={dataSource}
              scroll={{ x: tableWidthSum, y: 300 }}
              pagination={false}
            />
          </Space>
        }
        okText={okText}
        onOk={() => {
          if (toBeChangedInfoListForConfirm.filter((item) => item.checked === false).length > 0) {
            showNotificationWarn("제품 특이 사항을 모두 확인 후 등록 가능 합니다.");
            return;
          }

          if (!isB2b && formData?.warehouseAddress !== EXTERNAL_WAREHOUSE_ID) {
            const uncheckedStockWarnings = stockCheckListForConfirm.filter(
              (item) => item.status === "warning" && !item.checked
            );
            if (uncheckedStockWarnings.length > 0) {
              showNotificationWarn("재고 확인을 모두 완료 후 등록 가능 합니다.");
              return;
            }
          }

          if (isStaff && !isB2b) {
            const uncheckedSeasonalWarnings = seasonalCheckListForConfirm.filter(
              (item) => item.isInPeakSeason && !item.checked
            );
            if (uncheckedSeasonalWarnings.length > 0) {
              showNotificationWarn("계절 제품 확인을 모두 완료 후 등록 가능 합니다.");
              return;
            }

            const uncheckedDepletionWarnings = depletionCheckListForConfirm.filter(
              (item) => item.needsCheck && !item.checked
            );
            if (uncheckedDepletionWarnings.length > 0) {
              showNotificationWarn("악성재고 예상 확인을 모두 완료 후 등록 가능 합니다.");
              return;
            }
          }

          onCreate(formData);
        }}
        okButtonProps={{ disabled }}
        onCancel={onCancel}
        width={1100}
      />
      <ProductToBeChangedInfoModal
        confirmMode
        open={utils.isEmpty(selectedLineForToBeChangedInfoConfirm) === false}
        productVariant={selectedLineForToBeChangedInfoConfirm?.variant}
        onConfirm={() => {
          const newToBeChangedInfoListForConfirm = toBeChangedInfoListForConfirm.reduce<IToBeChangedInfoForConfirm[]>(
            (acc, cur) => {
              if (cur.variantId === selectedLineForToBeChangedInfoConfirm.variantId) {
                acc.push({ ...cur, checked: true });
                return acc;
              }
              acc.push(cur);
              return acc;
            },
            []
          );
          setToBeChangedInfoListForConfirm(newToBeChangedInfoListForConfirm);
          setSelectedLineForToBeChangedInfoConfirm(null);
        }}
        onClose={() => setSelectedLineForToBeChangedInfoConfirm(null)}
      />
      <PurchaseOrderStockCheckModal
        open={utils.isEmpty(selectedLineForStockCheck) === false}
        selectedLine={selectedLineForStockCheck}
        deliveryWarehouseName={formData?.deliveryWarehouseName}
        onOk={() => {
          const newStockCheckList = stockCheckListForConfirm.map((item) => {
            if (item.variantId === selectedLineForStockCheck.variantId) {
              return { ...item, checked: true };
            }
            return item;
          });
          setStockCheckListForConfirm(newStockCheckList);
          setSelectedLineForStockCheck(null);
        }}
        onCancel={() => setSelectedLineForStockCheck(null)}
      />
      {/* 계절 제품 확인 모달 */}
      <SeasonalCheckModal
        open={utils.isEmpty(selectedLineForSeasonalCheck) === false}
        selectedLine={selectedLineForSeasonalCheck}
        askingPurchaseDate={selectedLineForSeasonalCheck?.askingPurchaseDate || formData?.purchaseOrderDate || null}
        onOk={() => {
          const newSeasonalCheckList = seasonalCheckListForConfirm.map((item) => {
            if (item.variantId === selectedLineForSeasonalCheck.variantId) {
              return { ...item, checked: true };
            }
            return item;
          });
          setSeasonalCheckListForConfirm(newSeasonalCheckList);
          setSelectedLineForSeasonalCheck(null);
        }}
        onCancel={() => setSelectedLineForSeasonalCheck(null)}
      />
      {/* 악성재고 예상 확인 모달 */}
      <DepletionCheckModal
        open={utils.isEmpty(selectedLineForDepletionCheck) === false}
        selectedLine={selectedLineForDepletionCheck}
        askingPurchaseDate={selectedLineForDepletionCheck?.askingPurchaseDate || null}
        purchaseOrderDate={formData?.purchaseOrderDate || null}
        onOk={() => {
          const newDepletionCheckList = depletionCheckListForConfirm.map((item) => {
            if (item.variantId === selectedLineForDepletionCheck.variantId) {
              return { ...item, checked: true };
            }
            return item;
          });
          setDepletionCheckListForConfirm(newDepletionCheckList);
          setSelectedLineForDepletionCheck(null);
        }}
        onCancel={() => setSelectedLineForDepletionCheck(null)}
      />
    </>
  );
};

export default PurchaseOrderCreateProductConfirmModal;
