export function getFilterOpts(params: HqReqBossProductListViewUrlFilters): HqReqBossProductListListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
    requestNumber: {
      active: maybe(() => !utils.isEmpty(filterVariables.requestNumber, true), false),
      value: filterVariables.requestNumber || "",
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.status.map((contactType) => findValueInEnum(contactType, RequestBossProductStatusEnum))
          ),
        []
      ),
    },
    requestedStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.requestedStatusAt.gte, filterVariables.requestedStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.requestedStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.requestedStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    acceptedStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.acceptedStatusAt.gte, filterVariables.acceptedStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.acceptedStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.acceptedStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    reqAdditionalStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.reqAdditionalStatusAt.gte, filterVariables.reqAdditionalStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.reqAdditionalStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.reqAdditionalStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    vendorPriceStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.vendorPriceStatusAt.gte, filterVariables.vendorPriceStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.vendorPriceStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.vendorPriceStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    brandPriceStatusAt: {
      active: maybe(
