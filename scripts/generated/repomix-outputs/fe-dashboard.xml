export const makeVendorManagerInfo = (managersJsonStr: string): IVendorManagerInfo[] => {
  const managers = utils.jsonParseWrapper(managersJsonStr);
  return managers ? managers : [];
};

export const findVendorManager = (managers: IVendorManagerInfo[], type: VendorManagerTypeEnum): IVendorManagerInfo =>
  managers.find((m) => m.type === type);

export const findVendorManagers = (
  managers: IVendorManagerInfo[],
  types: VendorManagerTypeEnum[]
): IVendorManagerInfo[] => managers.filter((m) => types.includes(m.type));

interface IVendorManagerFormValue {
  [type: string]: StrictOmit<IVendorManagerInfo, "type">;
}
// DB에 json 문자열 형태로 저장된 협력사 담당자 정보를 Form에서 사용하는 형태로 변환
export const convertManagersToVendorFormValue = (managersJsonStr: string): IVendorManagerFormValue => {
  const managers = makeVendorManagerInfo(managersJsonStr);
  const managersFormValue = {};
  managers.forEach((manager) => {
    const { type, ...rest } = manager;
    managersFormValue[type] = rest;
  });
  return managersFormValue;
};
// Form에서 사용하는 형태로 변환된 협력사 담당자 정보를 뮤테이션에 전달할 수 있는 형태로 변환
const parseManagersFromVendorForm = (managersFormValue: IVendorManagerFormValue): IVendorManagerInfo[] => {
  const managers = [];
  // 협력사 담당자 정보를 type을 key로 가지는 객체에서 배열로 변환
  // 단, type 외의 필드 값이 모두 없는 경우는 배열에 추가하지 않음
  for (const type in managersFormValue) {
    if (managersFormValue.hasOwnProperty(type)) {
      const { name, phone, email, katalkId } = managersFormValue[type];
      if (
        utils.isEmpty(name, true) &&
        utils.isEmpty(phone, true) &&
        utils.isEmpty(email, true) &&
        utils.isEmpty(katalkId, true)
      ) {
        continue;
      }
      managers.push({ type, name, phone, email, katalkId });
    }
  }
  return managers;
};

interface INewFoodRequestLinkFormValue {
  [code: string]: { link: string };
}
// DB에 json 문자열 형태로 저장된 신규 식자재 요청 링크 정보를 Form에서 사용하는 형태로 변환
export const convertNewFoodRequestLinksToVendorFormValue = (
  newFoodRequestJsonStr: string
): { [code: string]: { link: string } } => {
  const newFoodRequestJson: Array<{ code: string; link: string }> = utils.jsonParseWrapper(newFoodRequestJsonStr) || [];
  const newFoodRequestLinksFormValue = {};
  newFoodRequestJson.forEach((item) => {
    newFoodRequestLinksFormValue[item.code] = { link: item.link };
  });
  return newFoodRequestLinksFormValue;
};
// Form에서 사용하는 형태로 변환된 신규 식자재 요청 링크 정보를 뮤테이션에 전달할 수 있는 형태로 변환
const parseNewFoodRequestLinksFromVendorForm = (
  newFoodRequestLinksFormValue: INewFoodRequestLinkFormValue
): Array<{ code: string; link: string }> => {
  const newFoodRequestLinks = [];
  // 신규 식자재 요청 링크 정보를 code를 key로 가지는 객체에서 배열로 변환
  // 단, code 외의 필드 값이 모두 없는 경우는 배열에 추가하지 않음
  for (const code in newFoodRequestLinksFormValue) {
    if (newFoodRequestLinksFormValue.hasOwnProperty(code)) {
      const { link } = newFoodRequestLinksFormValue[code];
      if (utils.isEmpty(link, true)) {
        continue;
      }
      newFoodRequestLinks.push({ code, link });
    }
  }
  return newFoodRequestLinks;
};

interface IVendorPurchaseByInfo {
  email: boolean;
  katalk: boolean;
  mms: boolean;
  mall: boolean;
  memo: string;
}
export const convertPurchaseByToVendorFormValue = (purchaseByJsonStr: string): IVendorPurchaseByInfo => {
  const purchaseByJson = utils.jsonParseWrapper(purchaseByJsonStr);

  return purchaseByJson
    ? purchaseByJson
    : {
        email: false,
        katalk: false,
        mms: false,
        mall: false,
        memo: "",
      };
};

const checkOrderManagerRequiredField = (managers: IVendorManagerInfo[]) => {
  if (!managers) {
    showNotificationError("협력사 주문 담당자 정보는 필수 입력 정보입니다.");
    return false;
  }
  const mainOrderManager = findVendorManager(managers, VendorManagerTypeEnum.ORDER);
  if (!mainOrderManager) {
    showNotificationError("협력사 주문 담당자 정보는 필수 입력 정보입니다.");
    return false;
  }
  if (utils.isEmpty(mainOrderManager.email) || utils.isEmpty(mainOrderManager.phone)) {
    showNotificationError(
      "협력사 주문 담당자 이메일과 연력처는 필수 입력 정보입니다. (협력사 관리자 계정 생성 시 사용됩니다.)"
    );
    return false;
  }
  if (utils.checkEmail(mainOrderManager.email) === false) {
    showNotificationError(
      "협력사 주문 담당자 이메일 형식을 확인해 주세요. (협력사 관리자 계정 생성 시 비밀번호 찾기에 사용됩니다.)"
    );
    return false;
  }
  if (utils.checkCantactNumber(mainOrderManager.phone) === false) {
    showNotificationError(
      "협력사 주문 담당자 연락처는 9~11 자리 사이의 번호로 입력해 주세요. (협력사 관리자 계정 생성 시 계정의 연락처로 사용됩니다.)"
    );
    return false;
  }
  return true;
};

// antd Form에서 값이 없더라도 Form.Item이 렌더링 되며 입력 또는 수정한 값이 없는 경우에도 전달되므로 필터링.
export const parseVendorCreateOrUpdateFormData = (
  formData: VendorCreateFormData | VendorUpdateFormData
): VendorCreateFormData | VendorUpdateFormData => {
  const parsedManagers = parseManagersFromVendorForm(formData.managers);
  const parsedNewFoodRequestLinks = parseNewFoodRequestLinksFromVendorForm(formData.newFoodRequestLinks);

  const parsedFormData = {
    ...formData,
    managers: parsedManagers,
    newFoodRequestLinks: parsedNewFoodRequestLinks,
  };
  return parsedFormData;
};

export const checkValidVendorFormData = (formData: VendorCreateFormData | VendorUpdateFormData) => {
  const { isDirectShipping, isUsingNewFoodRequest, useBossProduct, useB2bProduct, useFbvProduct } = formData;
  if (!isDirectShipping && isUsingNewFoodRequest) {
    showNotificationError("직배송 협력사가 아닌 경우에는 신규 식자재 요청 사용 여부를 체크할 수 없습니다.");
    return false;
  }
  if (checkOrderManagerRequiredField(formData.managers) === false) {
    return false;
  }
  if (formData.contactType === VendorContactTypeEnum.INTERNET && !formData.useDelegatedManagementForPo) {
    showNotificationError("쇼핑몰 타입의 협력사는 발주 업무 대행 여부를 ON으로 설정해야 합니다.");
    return false;
  }

  if (useBossProduct === false && useB2bProduct === false && useFbvProduct === false) {
    showNotificationError("3가지 상품 취급 여부중 적어도 1개 이상 취급해야 합니다.");
    return false;
  }

  return true;
};

export const getVendorAutoConsignmentPoTimeText = (
  vendor: Pick<Vendor_vendor, "autoConsignmentPoTime" | "secondAutoConsignmentPoTime" | "thirdAutoConsignmentPoTime">,
  type: "first" | "second" | "third" = "first"
) => {
  if (utils.isEmpty(vendor)) {
    return "-";
  }
  const poTime =
    type === "first"
      ? vendor.autoConsignmentPoTime
      : type === "second"
      ? vendor.secondAutoConsignmentPoTime
      : vendor.thirdAutoConsignmentPoTime;
  const momentValue = moment(poTime, detailTimeFormat);
  return momentValue.isValid() ? momentValue.format(extractHourMinuteFormat) : "-";
};

export const getMakerLabel = (maker: Pick<Makers_makers_edges_node, "code" | "name">) => {
  if (utils.isEmpty(maker)) {
    return "";
  }
  return `${maker.code}: ${maker.name}`;
};

export const purchaseByOptions = [
  { label: "이메일", value: "email" },
  { label: "카카오톡", value: "katalk" },
  { label: "문자", value: "mms" },
  { label: "쇼핑몰", value: "mall" },
];

export const getPurchaseByText = (purchaseByJsonStr: string | null | undefined): string => {
  if (!purchaseByJsonStr) {
    return "-";
  }

  try {
    const parsed = JSON.parse(purchaseByJsonStr);
    const selectedLabels = purchaseByOptions
      .filter((option) => parsed[option.value] === true)
      .map((option) => option.label);

    return selectedLabels.length > 0 ? selectedLabels.join(", ") : "-";
  } catch {
    return "-";
  }
};

