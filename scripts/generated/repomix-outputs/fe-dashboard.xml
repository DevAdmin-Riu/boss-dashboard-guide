  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  HqInfoProductViewUrlFilters,
  HqInfoProductViewUrlFiltersEnum,
  HqInfoProductViewUrlFiltersWithMultipleValuesEnum,
  HqInfoProductViewUrlQueryParams,
} from "../../urls";

export const HQ_INFO_PRODUCT_FILTERS_KEY = "hqInfoProductFilters";

export function getFilterOpts(params: HqInfoProductViewUrlFilters): HqInfoProductFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    firstSaleAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.firstSaleAt.gte, filterVariables.firstSaleAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.firstSaleAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.firstSaleAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    pvStoppedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.pvStoppedAt.gte, filterVariables.pvStoppedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.pvStoppedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.pvStoppedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    isInner: {
      active: maybe(() => !utils.isEmpty(filterVariables.isInner), false),
      value: maybe(() => filterVariables.isInner, false),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: filterVariables.brandProductSearch,
    },
    pvSalesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.pvSalesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.pvSalesStatus), []),
    },
    bpvSalesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.bpvSalesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.bpvSalesStatus), []),
    },
    stockShortageStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.stockShortageStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.stockShortageStatus), []),
    },
    exclusive: {
      active: maybe(() => !utils.isEmpty(filterVariables.exclusive), false),
      value: maybe(() => filterVariables.exclusive, false),
    },
    isOnlyPayableByCash: {
      active: maybe(() => !utils.isEmpty(filterVariables.isOnlyPayableByCash), false),
      value: maybe(() => filterVariables.isOnlyPayableByCash, false),
    },
  };
}

export function getFilterVariables(params: HqInfoProductViewUrlFilters): BrandProductVariantFilterInput {
  return {
    excludePvSalesStatusStopped: true,
    firstSaleAt: getGteLteVariables({
      gte: params.firstSaleAtFrom,
      lte: params.firstSaleAtTo,
    }),
    pvStoppedAt: getGteLteVariables({
      gte: params.pvStoppedAtFrom,
      lte: params.pvStoppedAtTo,
    }),
    isInner: params.isInner !== undefined ? parseBoolean(params.isInner, false) : undefined,
    brandProductSearch: params.brandProductSearch,
    pvSalesStatus: maybe(() => params.pvSalesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    bpvSalesStatus: maybe(() => params.bpvSalesStatus.map((status) => findInEnum(status, SalesStatusEnum))),
    stockShortageStatus: maybe(() =>
      params.stockShortageStatus.map((status) => findInEnum(status, StockStatusByEstShortageEnum))
    ),
    exclusive: params.exclusive !== undefined ? parseBoolean(params.exclusive, false) : undefined,
    isOnlyPayableByCash:
      params.isOnlyPayableByCash !== undefined ? parseBoolean(params.isOnlyPayableByCash, false) : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<HqInfoProductFilterKeys>): HqInfoProductViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqInfoProductFilterKeys.firstSaleAt:
      return getMinMaxQueryParam(
        filter,
        HqInfoProductViewUrlFiltersEnum.firstSaleAtFrom,
        HqInfoProductViewUrlFiltersEnum.firstSaleAtTo
      );
    case HqInfoProductFilterKeys.isInner:
      return getSingleValueQueryParam(filter, HqInfoProductViewUrlFiltersEnum.isInner);
    case HqInfoProductFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, HqInfoProductViewUrlFiltersEnum.brandProductSearch);
    case HqInfoProductFilterKeys.pvSalesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqInfoProductViewUrlFiltersWithMultipleValuesEnum.pvSalesStatus,
        SalesStatusEnum
      );
    case HqInfoProductFilterKeys.bpvSalesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqInfoProductViewUrlFiltersWithMultipleValuesEnum.bpvSalesStatus,
        SalesStatusEnum
      );
    case HqInfoProductFilterKeys.stockShortageStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        HqInfoProductViewUrlFiltersWithMultipleValuesEnum.stockShortageStatus,
        StockStatusByEstShortageEnum
      );
    case HqInfoProductFilterKeys.exclusive:
      return getSingleValueQueryParam(filter, HqInfoProductViewUrlFiltersEnum.exclusive);
    case HqInfoProductFilterKeys.isOnlyPayableByCash:
      return getSingleValueQueryParam(filter, HqInfoProductViewUrlFiltersEnum.isOnlyPayableByCash);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqInfoProductViewUrlFilters>(HQ_INFO_PRODUCT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  HqInfoProductViewUrlQueryParams,
  HqInfoProductViewUrlFilters
>({ ...HqInfoProductViewUrlFiltersEnum, ...HqInfoProductViewUrlFiltersWithMultipleValuesEnum });
</file>

