<file path="src/app/views/settings/pages/components/PageDetailsPage.tsx">
import { PageInput } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { parseContentJsonStrToMarkdown } from "@src/app/components/Editor/utils";
import Grid from "@src/app/components/Grid";
import VisibilityCard from "@src/app/components/VisibilityCard";
import { PageDetails_page } from "@src/app/views/settings/pages/api/types/PageDetails";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Form, PageHeader, Space } from "antd";
import React, { useEffect } from "react";

import { PageDetailsEditModeEnum } from "../views/PageDetailsView";
import PageInfo from "./PageInfo";

export type PageBasicInfoUpdateForm = Pick<PageInput, "title" | "slug" | "content">;

export type PageVisibilityUpdateForm = Pick<PageInput, "isPublished" | "publicationDate">;

interface PageDetailsPageProps {
  disabled: boolean;
  page: PageDetails_page;
  editMode: PageDetailsEditModeEnum;
  onEdit: (mode: PageDetailsEditModeEnum) => void;
  onEditCancel: () => void;
  onBack: () => void;
  onBasicInfoUpdate: (formData: PageBasicInfoUpdateForm) => void;
  onVisibilityUpdate: (formData: PageVisibilityUpdateForm) => void;
  onDelete: () => void;
}

export const PageDetailsPage: React.FC<PageDetailsPageProps> = (props) => {
  const { disabled, page, editMode, onEdit, onEditCancel, onBack, onBasicInfoUpdate, onVisibilityUpdate, onDelete } =
    props;
  const [basicInfoForm] = Form.useForm<PageBasicInfoUpdateForm>();
  const [visibilityForm] = Form.useForm<PageVisibilityUpdateForm>();

  const isEditing = utils.isEmpty(editMode) === false;

  const basicInfoInitialValues: PageBasicInfoUpdateForm = {
    title: page.title,
    slug: page.slug,
    content: parseContentJsonStrToMarkdown(page.content),
  };
  const visibilityInitialValues: PageVisibilityUpdateForm = {
    isPublished: page.isPublished,
    publicationDate: page.publicationDate,
  };

  useEffect(() => {
    switch (editMode) {
      case PageDetailsEditModeEnum.UpdateBasicInfo:
        basicInfoForm.resetFields();
        break;
      case PageDetailsEditModeEnum.UpdateVisibility:
        visibilityForm.resetFields();
        break;
      default:
        break;
    }
  }, [editMode]);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.pages}</AppHeader>
      <PageHeader
        title={maybe(() => page.title)}
        extra={
          <Button danger type="primary" shape="round" onClick={onDelete}>
            페이지 삭제
          </Button>
        }
      />

      <Grid>
        <Space direction="vertical" size="large">
          <Form
            name="page-basic-info"
            layout="vertical"
            form={basicInfoForm}
            disabled={disabled || (isEditing && editMode !== PageDetailsEditModeEnum.UpdateBasicInfo)}
            initialValues={basicInfoInitialValues}
            onFinish={onBasicInfoUpdate}
          >
            <PageInfo
              isCreate={false}
              form={basicInfoForm}
              page={page}
              editModeProps={{
                isEditMode: editMode === PageDetailsEditModeEnum.UpdateBasicInfo,
                onEdit: () => onEdit(PageDetailsEditModeEnum.UpdateBasicInfo),
                onCancel: onEditCancel,
              }}
            />
          </Form>
        </Space>
        <Space direction="vertical" size="large">
          <Form
            form={visibilityForm}
            name="page-visibility"
            layout="vertical"
            disabled={disabled || (isEditing && editMode !== PageDetailsEditModeEnum.UpdateVisibility)}
            initialValues={visibilityInitialValues}
            onFinish={onVisibilityUpdate}
          >
            <VisibilityCard
              isCreate={false}
              form={visibilityForm}
              initialValues={visibilityInitialValues}
              editModeProps={{
                isEditMode: editMode === PageDetailsEditModeEnum.UpdateVisibility,
                onEdit: () => onEdit(PageDetailsEditModeEnum.UpdateVisibility),
                onCancel: onEditCancel,
              }}
            />
          </Form>
        </Space>
      </Grid>
    </>
  );
};
</file>

<file path="src/app/views/settings/pages/views/PageListView/PageListView.tsx">
import useBulkActions from "@hooks/useBulkActions";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { ListViews } from "@src/global/core/types/types";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import { Button, Modal } from "antd";
import React from "react";

import { usePageBulkDeleteMutation, usePageBulkPublish } from "../../api/mutations";
import { pageListQuery, usePageListQuery } from "../../api/queries";
import PageListPage from "../../components/PageListPage/PageListPage";
import {
  pageCreateViewUrl,
  pageDetailsViewUrl,
  pageListViewUrl,
  PageListViewUrlDialog,
  PageListViewUrlQueryParams,
} from "../../urls";
import { getSortQueryVariables } from "./sort";

interface PageListViewProps {
  params: PageListViewUrlQueryParams;
}

export const PageListView: React.FC<PageListViewProps> = ({ params }) => {
  const { isSelected, listElements, reset, toggle, toggleAll } = useBulkActions(params?.ids);

  const targetUrl = pageListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PAGE_LIST,
  });

  const queryVariables = React.useMemo(
    () => ({ ...paginationState, sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );
  const { data, loading } = usePageListQuery({
    variables: queryVariables,
  });

  const closeModalWithReset = () => {
    closeModal();
    reset();
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.pages?.pageInfo,
    paginationState,
    params,
  });

  const [openModal, closeModal] = createDialogActionHandlers<PageListViewUrlDialog, PageListViewUrlQueryParams>(
    navigate,
    targetUrl,
    params
  );

  const [bulkPagePublish, bulkPagePublishOpts] = usePageBulkPublish({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.pageBulkPublish.errors,
        "페이지 공개 여부가 일괄 수정되었습니다.",
        closeModalWithReset
      ),
    refetchQueries: [pageListQuery],
  });
  const [bulkPageRemove, bulkPageRemoveOpts] = usePageBulkDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.pageBulkDelete.errors,
        "페이지가 일괄 삭제되었습니다.",
        closeModalWithReset
      ),
    refetchQueries: [pageListQuery],
  });

  const handleSort = createSortHandler(navigate, pageListViewUrl, params);

  return (
    <>
      <PageListPage
        disabled={loading || bulkPagePublishOpts.loading || bulkPageRemoveOpts.loading}
        settings={settings}
        pages={maybe(() => data.pages.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onAdd={() => navigate(pageCreateViewUrl)}
        onBack={() => navigate(configurationSectionUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(pageDetailsViewUrl(id))}
        onSort={handleSort}
        toolbar={
          <>
            <Button
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("publish", { ids: listElements })}
            >
              일괄 {buttonText.publish}
            </Button>
            <Button
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("unpublish", { ids: listElements })}
            >
              일괄 {buttonText.unpublish}
            </Button>
            <Button
              danger
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("remove", { ids: listElements })}
            >
              일괄 {buttonText.remove}
            </Button>
          </>
        }
        selectedRowKeys={listElements}
        isChecked={isSelected}
        selected={listElements.length}
        sort={getSortParams(params)}
        toggle={toggle}
        toggleAll={toggleAll}
      />
      <Modal
        title="페이지 공개"
        open={params.action === "publish" && maybe(() => params?.ids?.length > 0)}
        onOk={() => bulkPagePublish({ variables: { ids: params?.ids, isPublished: true } })}
        okButtonProps={{ loading: bulkPagePublishOpts.loading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 페이지를 공개하시겠습니까?
      </Modal>
      <Modal
        title="페이지 비공개"
        open={params.action === "unpublish" && maybe(() => params?.ids?.length > 0)}
        onOk={() => bulkPagePublish({ variables: { ids: params?.ids, isPublished: false } })}
        okButtonProps={{ loading: bulkPagePublishOpts.loading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 페이지를 비공개하시겠습니까?
      </Modal>
      <Modal
        title="페이지 삭제"
        open={params.action === "remove" && maybe(() => params?.ids?.length > 0)}
        onOk={() => bulkPageRemove({ variables: { ids: params?.ids } })}
        okButtonProps={{ danger: true, loading: bulkPageRemoveOpts.loading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 페이지를 삭제하시겠습니까?
      </Modal>
    </>
  );
};
</file>

