import { SyncOutlined } from "@ant-design/icons";
import { formRuleMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { PreFounderEvalItemUpsertInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import ConfirmModal from "@src/app/components/ConfirmModal";
import EditableField from "@src/app/components/EditableField/EditableField";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { useSimpleBrandForPreFounderQuery } from "@src/app/views/brand/brands/api/queries";
import { maybe } from "@utils/misc";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import {
  Button,
  Col,
  Form,
  FormListFieldData,
  FormListOperation,
  Input,
  Modal,
  Row,
  Space,
  Table,
  Typography,
} from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { usePreFounderEvalInfoSyncMutation, usePreFounderEvalItemBulkUpsertOrDeleteMutation } from "../api/mutations";
import { hqPreFounderListQuery, usePreFounderEvalItemListQuery } from "../api/queries";
import { PreFounderEvalItemBulkUpsertOrDeleteVariables } from "../api/types/PreFounderEvalItemBulkUpsertOrDelete";

const hqPreFounderEvalInfoSyncText = "평가 정보 동기화";

enum ConfirmModalModeEnum {
  Submit = "Submit",
  Sync = "Sync",
}

interface PreFounderEvalItemListModalProps {
  open: boolean;
  onClose: () => void;
}

export const PreFounderEvalItemListModal: React.FC<PreFounderEvalItemListModalProps> = (props) => {
  const { open, onClose } = props;
  const { user } = useUser();
  const [isEditMode, setIsEditMode] = useState<boolean>(false);
  const [confirmModalMode, setConfirmModalMode] = useState<ConfirmModalModeEnum>(null);
  const [form] = Form.useForm<PreFounderEvalItemBulkUpsertOrDeleteVariables>();
  const TypeSafeForm = getTypeSafeForm<PreFounderEvalItemBulkUpsertOrDeleteVariables>(form);

  const detailsWatched = TypeSafeForm.getUseFormWatched({ name: "details" }) || [];
  const weightSum = detailsWatched.reduce((sum: number, item) => sum + (item?.weight || 0), 0);

  const onEdit = () => setIsEditMode(true);
  const onEditCancel = () => setIsEditMode(false);

  const onOpenConfirmModal = (mode: ConfirmModalModeEnum) => {
    setConfirmModalMode(mode);
  };
  const onCloseConfirmModal = () => {
    setConfirmModalMode(null);
  };

  const skipQuery = !open || utils.isEmpty(user?.brand);

  const { data, loading, refetch } = usePreFounderEvalItemListQuery({
    skip: skipQuery,
    variables: { brandId: user.brand.id },
  });
  const evalItemList = maybe(() => data.preFounderEvalItemList, []);

  const { data: simpleBrandData, loading: simpleBrandLoading } = useSimpleBrandForPreFounderQuery({
    skip: skipQuery,
    variables: { id: user.brand.id },
  });
  const simpleBrand = maybe(() => simpleBrandData.brand, null);

  const initialValues: PreFounderEvalItemBulkUpsertOrDeleteVariables = {
    brand: user?.brand?.id,
    details: evalItemList.map((item) => ({
      id: item.id,
      name: item.name,
      description: item.description,
      weight: item.weight,
    })),
  };

  const [preFounderEvalItemBulkUpsertOrDelete, preFounderEvalItemBulkUpsertOrDeleteOpts] =
    usePreFounderEvalItemBulkUpsertOrDeleteMutation({
      onCompleted: (data) => {
        const errors = data.preFounderEvalItemBulkUpsertOrDelete.errors;
        if (errors.length === 0) {
          const brand = data.preFounderEvalItemBulkUpsertOrDelete.brand;
          if (brand.needUpdatePreFounderEvalInfo) {
            showNotificationWarn(`평가 항목 정보가 저장되었습니다. [${hqPreFounderEvalInfoSyncText}]도 진행해 주세요.`);
          } else {
            showNotificationSuccess("평가 항목 정보가 저장되었습니다.");
          }
          onEditCancel();
          onCloseConfirmModal();
          refetch();
        } else {
          showGqlErrors(errors);
          onCloseConfirmModal();
        }
      },
    });

  const [preFounderEvalInfoSync, preFounderEvalInfoSyncOpts] = usePreFounderEvalInfoSyncMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.preFounderEvalInfoSync.errors,
        "예비창업자 평가 정보가 동기화되었습니다.",
        () => {
          onCloseConfirmModal();
        }
      ),
    refetchQueries: [hqPreFounderListQuery],
  });

  const modalLoading =
    loading ||
    simpleBrandLoading ||
    preFounderEvalInfoSyncOpts.loading ||
    preFounderEvalItemBulkUpsertOrDeleteOpts.loading;

  useEffect(() => {
    form.resetFields();
  }, [open, loading, isEditMode]);

  useEffect(() => {
    if (isEditMode && evalItemList.length === 0) {
      TypeSafeForm.setFields([
        { name: "details", value: [{ name: undefined, description: undefined, weight: undefined }] },
      ]);
    }
  }, [isEditMode]);

  useEffect(() => {
    form.validateFields(["details"]);
  }, [weightSum]);

  const renderEvalItemListTable = (fields: FormListFieldData[], operation: FormListOperation) => {
    const { add, remove } = operation;
    const renderTableTitle = () => {
      if (isEditMode) {
        return (
          <Row justify="space-between">
            <Col>
              <Button onClick={() => add()}>항목 추가</Button>
            </Col>
            <Col>
              <FormSaveButton form={form} isEditMode={isEditMode} onEdit={onEdit} onCancel={onEditCancel} />
            </Col>
          </Row>
        );
      } else {
        return (
          <Row justify="space-between">
            <Button
              icon={<SyncOutlined />}
              danger
              type="primary"
              disabled={!simpleBrand?.needUpdatePreFounderEvalInfo}
              onClick={() => onOpenConfirmModal(ConfirmModalModeEnum.Sync)}
            >
              {hqPreFounderEvalInfoSyncText}
            </Button>
            <Button type="primary" onClick={onEdit}>
              수정
            </Button>
          </Row>
        );
      }
    };

    const columns: ColumnsType<FormListFieldData> = [
      {
        title: columnNameConstant.common.NAME,
        key: "name",
        width: 150,
        render: (_, record) => (
          <>
            <Form.Item hidden name={[record.name, "id"]}>
              <Input />
            </Form.Item>
            <EditableField
              formItemStyle={{ margin: 0 }}
              type="input"
              name={[record.name, "name"]}
              value={TypeSafeForm.getFieldValue(`details.${record.name}.name`)}
              editMode={isEditMode}
              rules={[{ required: true }]}
            />
          </>
        ),
      },
      {
        title: columnNameConstant.preFounder.EVAL_DESCRIPTION,
        key: "description",
        width: 250,
        render: (_, record) => (
          <EditableField
            formItemStyle={{ margin: 0 }}
            type="textarea"
            name={[record.name, "description"]}
            value={TypeSafeForm.getFieldValue(`details.${record.name}.description`)}
            editMode={isEditMode}
            rules={[{ required: true }]}
          />
        ),
      },
      {
        title: columnNameConstant.preFounder.EVAL_WEIGHT,
        key: "weight",
        align: "right",
        width: 80,
        render: (_, record) => (
          <EditableField
            formItemStyle={{ margin: 0 }}
            type="number"
            name={[record.name, "weight"]}
            value={TypeSafeForm.getFieldValue(`details.${record.name}.weight`)}
            editMode={isEditMode}
            rules={[{ required: true }, { type: "number", min: 1, max: 100, message: formRuleMsg.between(1, 100) }]}
          />
        ),
      },
      isEditMode && {
        key: "actions",
        width: 80,
        align: "center",
        render: (_, record) => (
          <Button danger type="primary" size="small" onClick={() => remove(record.name)}>
            삭제
          </Button>
        ),
      },
    ];
    const filteredColumns = columns.filter(Boolean);

    const renderTableSummary = () => (
      <Table.Summary fixed>
        <Table.Summary.Row>
          <Table.Summary.Cell index={0} colSpan={2} align="center">
            <Typography.Text strong>비중 합계</Typography.Text>
          </Table.Summary.Cell>
          <Table.Summary.Cell index={2} align="right">
            <Typography.Text strong type={weightSum !== 100 ? "danger" : undefined}>
              {weightSum}
            </Typography.Text>
          </Table.Summary.Cell>
          {isEditMode && <Table.Summary.Cell index={3} />}
        </Table.Summary.Row>
      </Table.Summary>
    );

    return (
      <Table<FormListFieldData>
        {...commonTableProps}
        rowKey={(record) => record.name}
        title={() => renderTableTitle()}
        columns={filteredColumns}
        dataSource={fields}
        summary={renderTableSummary}
      />
    );
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="예비창업자 평가 항목 관리"
      width={800}
      open={open}
      closable={false}
      maskClosable={false}
      footer={
        <Button loading={modalLoading} disabled={isEditMode} onClick={onClose}>
          닫기
        </Button>
      }
    >
      <Form
        name="pre-founder-eval-item-bulk-upsert-or-delete-form"
        form={form}
        initialValues={initialValues}
        validateMessages={{ required: formRuleMsg.required }}
        onFinish={() => onOpenConfirmModal(ConfirmModalModeEnum.Submit)}
      >
        <Form.Item hidden name={TypeSafeForm.getValidDataIndex("brand")}>
          <Input />
        </Form.Item>
        <Form.List
          name={TypeSafeForm.getValidDataIndex("details")}
          rules={[
            {
              validator: (_, value: PreFounderEvalItemUpsertInput[]) => {
                if (!value || value.length === 0) {
                  return Promise.reject(new Error("평가 항목은 최소 1개 이상이어야 합니다."));
                }
                const weightSum = value.reduce((sum, item) => sum + (item?.weight || 0), 0);
                if (weightSum !== 100) {
                  return Promise.reject(new Error("비중 합계가 100이 아닙니다."));
                }
                return Promise.resolve();
              },
            },
          ]}
        >
          {(fields, operation, { errors }) => (
            <Space direction="vertical" size={0}>
              {renderEvalItemListTable(fields, operation)}
              <Form.ErrorList errors={errors} />
            </Space>
          )}
        </Form.List>
      </Form>

      <ConfirmModal
        visible={confirmModalMode === ConfirmModalModeEnum.Submit}
        titleText={
          "평가 항목이 추가 또는 삭제되었거나 기존 항목의 비중이 수정되었다면 예비창업자들의 평가 정보(평가 상태, 평가 총점) 동기화 작업을 진행해야 합니다."
        }
        onOk={() => {
          const variables = TypeSafeForm.getFieldsValue();
          preFounderEvalItemBulkUpsertOrDelete({ variables });
        }}
        onCancel={onCloseConfirmModal}
      />
      <ConfirmModal
        visible={confirmModalMode === ConfirmModalModeEnum.Sync}
        modalTitleText="예비창업자 평가 정보 동기화"
        titleText="예비창업자 평가 정보를 동기화하시겠습니까? 동기화 작업은 다소 시간이 소요될 수 있습니다."
        okText="동기화"
        okButtonProps={{ danger: true, loading: preFounderEvalInfoSyncOpts.loading }}
        onOk={() => preFounderEvalInfoSync({ variables: { brand: user?.brand?.id } })}
        onCancel={onCloseConfirmModal}
      />
    </Modal>
  );
};
</file>

