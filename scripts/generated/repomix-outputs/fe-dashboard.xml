import { DownOutlined, UpOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps, getTableClassName } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import { Goodsflow } from "@src/app/components/Goodsflow";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { FilterPageProps, ListSettings } from "@src/global/core/types/types";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import { ExpandableConfig, TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import {
  BatchPickingList,
  BatchPickingList_batchPickingList_edges_node,
  BatchPickingList_batchPickingList_edges_node_fulfillments,
  BatchPickingList_batchPickingList_edges_node_fulfillments_lines,
  BatchPickingListVariables,
} from "../../api/types/BatchPickingList";
import { orderDeliveryReprintListViewPathB } from "../../urls";
import OrderLineBoxSizeUpdateModal from "../OrderLineBoxSizeUpdateModal";
import { getBatchPickingListTableSettings } from "./BatchPickingListTableSettings";
import { BatchPickingFilterKeys, BatchPickingListFilterOpts, createFilterStructure } from "./filters";

export interface BatchPickingListPageProps extends FilterPageProps<BatchPickingFilterKeys, BatchPickingListFilterOpts> {
  settings: ListSettings<string>;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  batchPickingList: BatchPickingList_batchPickingList_edges_node[];
  loading: boolean;
  onRowClick: (id: string) => void;
  handleRefetch: (variables?: BatchPickingListVariables) => Promise<ApolloQueryResult<BatchPickingList>>;
  warehouseAddresses?: Array<{ id: string; companyName: string }>;
}

export interface BatchPickingDataSourceType extends BatchPickingList_batchPickingList_edges_node {
  fulfillment: BatchPickingList_batchPickingList_edges_node_fulfillments;
  fulfillmentLine: BatchPickingList_batchPickingList_edges_node_fulfillments_lines;
  isChild: boolean;
  children?: BatchPickingDataSourceType[];
}

enum BatchPickingListModalMode {
  updateOrderLineBoxSize = "updateOrderLineBoxSize",
}

export const BatchPickingListPage: React.FC<BatchPickingListPageProps> = (props) => {
  const {
    batchPickingList,
    loading,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    handleRefetch,
    warehouseAddresses,
  } = props;
  const shop = useShop();
  const navigate = useNavigator();
  const filterStructure = createFilterStructure(filterOpts, warehouseAddresses);
  const [onAction, setOnAction] = useState(false);
  const [modalMode, setModalMode] = useState<BatchPickingListModalMode>(null);
  const [idForModal, setIdForModal] = useState<string>(null);
  const [dataSource, setDataSource] = useState<BatchPickingDataSourceType[]>([]);
  const [selectedBatchPickingIds, setSelectedBatchPickingIds] = useState<string[]>([]);
  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const openModalWithoutNavigate = (modalMode: BatchPickingListModalMode, id: string) => {
    setModalMode(modalMode);
    setIdForModal(id);
  };
  const resetForCloseModal = () => openModalWithoutNavigate(null, null);

  useEffect(() => {
    if (batchPickingList) {
      const newDataSource: BatchPickingDataSourceType[] = [];
      // 배치 1개에 여러개의 fulfillment가 있을 수 있고, 각 fulfillment마다 fulfillmentLine이 여러개 있을 수 있음.
      // 합포장 배송 페이지는 fulfillmentLine 단위로 노출되어야 하므로, 배치 1개에 대해 fulfillmentLine 단위로 데이터를 재구성함.
      batchPickingList.forEach((batchPicking) => {
        const flatFulfillmentsByLine: BatchPickingDataSourceType[] = batchPicking.fulfillments.flatMap(
          (fulfillment) => {
            const fulfillmentLines = fulfillment.lines;
            // isChilde: 배치 중 첫 번째 출고(fulfillment)에 대해서 dataSource 푸시할 때, isChild=false로 설정하므로 기본값은 true로 설정.
            const fulfillmentsByLine: BatchPickingDataSourceType[] = fulfillmentLines.map((fulfillmentLine) => ({
              ...batchPicking,
              isChild: true,
              fulfillment,
              fulfillmentLine,
            }));
            return fulfillmentsByLine;
          }
        );
        const defaultFulfillment = flatFulfillmentsByLine[0];
        const fulfillmentExcludeDefault = flatFulfillmentsByLine.slice(1);
        newDataSource.push({ ...defaultFulfillment, isChild: false, children: fulfillmentExcludeDefault });
      });
      setDataSource(newDataSource);
    }
  }, [batchPickingList]);

  const handleError = (errMessage) => {
    showNotificationError(errMessage);
    setOnAction(false);
  };

  const handleGoodsflowPrintSuccess = () => {
    handleRefetch();
    setOnAction(false);
  };

  const navigateReprint = () => {
    navigate(orderDeliveryReprintListViewPathB);
  };

  const makeExtraUi = () =>
    utils.checkWebView() === false && (
      <Space direction="horizontal" size={8}>
        <Goodsflow
          loading={onAction}
          disabled={selectedBatchPickingIds === null || selectedBatchPickingIds?.length <= 0}
          mode="print"
          setLoading={setOnAction}
          onError={handleError}
          onSuccess={handleGoodsflowPrintSuccess}
          config={shop?.goodsflowPluginConfig}
          onlySelectedMode={true}
          isPickingOrder={true}
          batchPickingIds={selectedBatchPickingIds}
        />
        <Button type="primary" shape="round" onClick={navigateReprint}>
          운송장 재출력
        </Button>
      </Space>
    );

  const tableTitle = () => {
    const noExpanded = !expandedRowKeys || expandedRowKeys.length === 0;
    const arrowIcon = noExpanded ? <DownOutlined /> : <UpOutlined />;
    const buttonText = `옵션 정보 ${noExpanded ? "펼치기" : "숨기기"}`;
    return (
      <Typography.Link
        style={{ color: "black" }}
        onClick={() => {
          if (noExpanded) {
            const allRowKeys = dataSource.map((record) => record.fulfillmentLine.id);
            setExpandedRowKeys(allRowKeys);
          } else {
            setExpandedRowKeys([]);
          }
        }}
      >
        <Space direction="horizontal">
          {arrowIcon}
          {buttonText}
        </Space>
      </Typography.Link>
    );
  };

  const onUpdateOrderLineBoxSize = (orderLineId: string) =>
    openModalWithoutNavigate(BatchPickingListModalMode.updateOrderLineBoxSize, orderLineId);
  const columns = getBatchPickingListTableSettings(props, onUpdateOrderLineBoxSize);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const rowSelection: TableRowSelection<BatchPickingDataSourceType> = {
    fixed: true,
    onChange: (_, selectedRows) => setSelectedBatchPickingIds([...new Set(selectedRows.map((row) => row.id))]),
    getCheckboxProps: (record) => ({ disabled: loading || record.isChild }),
  };
  const rowExpandable: ExpandableConfig<BatchPickingDataSourceType> = {
    fixed: true,
    indentSize: 0,
    expandedRowKeys,
    rowExpandable: (record) => record?.children?.length > 0,
    onExpandedRowsChange: (expandedKeys) => setExpandedRowKeys(expandedKeys as string[]),
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.batchPicking}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={loading}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          className={getTableClassName(["ant-table-tree-data"])}
          title={tableTitle}
          loading={loading}
          rowKey={(record) => record?.fulfillmentLine?.id}
          dataSource={dataSource}
          columns={pickerSelectedColumns}
          rowSelection={rowSelection}
          expandable={rowExpandable}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
        />
      </Card>
      <OrderLineBoxSizeUpdateModal
        open={
          utils.isEmpty(idForModal, true) === false && modalMode === BatchPickingListModalMode.updateOrderLineBoxSize
        }
        orderLineId={idForModal}
        orderLineBoxSize={
          dataSource.find((record) => record.fulfillmentLine.orderLine.id === idForModal)?.fulfillmentLine.orderLine
            .boxSize
        }
        onClose={resetForCloseModal}
      />
    </Space>
  );
};
</file>

