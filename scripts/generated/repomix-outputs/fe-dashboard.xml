<file path="src/global/core/hooks/useStateFromProps.ts">
import isEqual from "lodash-es/isEqual";
import { Dispatch, SetStateAction, useState } from "react";

export interface UseStateFromPropsOpts<T> {
  mergeFunc?: (prevData: T, state: T, newData: T) => T;
  onRefresh?: (data: T) => void;
}

function useStateFromProps<T>(data: T, opts?: UseStateFromPropsOpts<T>): [T, Dispatch<SetStateAction<T>>] {
  const [state, setState] = useState(data);
  const [prevData, setPrevData] = useState(data);
  if (!opts) {
    opts = {};
  }

  const { mergeFunc, onRefresh } = opts;
  const shouldUpdate = !isEqual(prevData, data);

  if (shouldUpdate) {
    const mergedData = typeof mergeFunc === "function" ? mergeFunc(prevData, state, data) : data;
    setState(mergedData);
    setPrevData(data);
    if (typeof onRefresh === "function") {
      onRefresh(mergedData);
    }
  }

  return [state, setState];
}

export default useStateFromProps;
</file>

<file path="src/global/core/hooks/useTableScrollInitialize.ts">
import { useEffect, useRef, useState } from "react";
import { useLocation } from "react-router";

export const useTableScrollInitialize = () => {
  const { pathname } = useLocation();
  const defaultTableScrollY = 500;
  const tableRef = useRef(null);
  const [tableScrollY, setTableScrollY] = useState<number>(defaultTableScrollY);

  useEffect(() => {
    if (!tableRef.current) {
      return;
    }

    const handleWindowResize = () => {
      const defaultOffset = 250;
      const { top } = tableRef.current.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const tableHeight = windowHeight - top - defaultOffset;
      const newScrollY = Math.max(tableHeight, defaultTableScrollY);
      setTableScrollY(newScrollY);
    };

    window.addEventListener("resize", handleWindowResize);
    handleWindowResize();

    return () => window.removeEventListener("resize", handleWindowResize);
  }, [tableRef]);

  useEffect(() => {
    // 좌우(x) 스크롤 초기화
    if (tableRef.current) {
      const tableBody = tableRef.current.querySelector(".ant-table-body");
      if (tableBody) {
        tableBody.scrollLeft = 0;
      }
    }
  }, [pathname]);

  return { tableRef, tableScrollY };
};
</file>

