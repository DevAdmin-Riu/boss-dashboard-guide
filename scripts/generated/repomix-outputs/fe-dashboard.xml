import { BrandHistoryFilterKeys, BrandHistoryListFilterOpts, createFilterStructure } from "./filters";
import { createSorterStructure } from "./sorters";

interface BrandHistoryListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandHistoryFilterKeys, BrandHistoryListFilterOpts>,
    SortPage<BrandHistoryListViewUrlSortField> {
  brandHistories: BrandHistories_brandHistories_edges_node[];
  brandId?: string;

  queryVariablesWithoutPagination: BrandHistoriesVariables;
  fetchForDownload: (variables?: BrandHistoriesVariables) => Promise<ApolloQueryResult<BrandHistories>>;
}

export const BrandHistoryListPage: React.FC<BrandHistoryListPageProps> = ({
  brandId,
  brandHistories,
  currencySymbol,
  currentTab,
  filterOpts,
  tabs,
  sort,
  onAdd,
  onAll,
  onFilterChange,
  onTabChange,
  onTabDelete,
  onTabSave,
  onRowClick,
  onSort,
  queryVariablesWithoutPagination,
  fetchForDownload,
  ...listProps
}) => {
  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getBrandHistoryListTableColumns();
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  // brand가 전달되는 경우는 상세페이지에서 넘어오는 경우임.
  const isBrandDetailsPage = !!brandId;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "brandHistories",
  };

  const pageTitle = (
    <Row justify="space-between">
      <Col>
        <Typography.Title level={4}>{sectionNames.brandHistory}</Typography.Title>
      </Col>
      <Col>
        <Button type="primary" shape="round" onClick={onAdd}>
          이력 추가
        </Button>
      </Col>
    </Row>
  );

  return (
    <Space direction="vertical" size={24}>
      {isBrandDetailsPage === false && pageTitle}

      {/* 브랜드 상세 페이지에서 운영 이력 조회하는 경우, Card 내에 여백 없이 Table 노출하기 위해 padding = 0 적용 */}
      <Card title={isBrandDetailsPage && pageTitle} bodyStyle={isBrandDetailsPage ? { padding: 0 } : {}}>
        {isBrandDetailsPage === false && (
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            filterStructure={filterStructure}
            tabs={tabs}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabExtra={
              <>
                <ColumnPicker
                  columns={pickColumns}
                  loading={listProps.disabled}
                  initialColumns={initialColumns}
                  total={pickColumns?.length}
                  onSave={handleSave}
                />
                <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
              </>
            }
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
          />
        )}
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={brandHistories}
          rowClassName={getTableRowClassName(["ant-table-row-link"])}
          onRow={(record) => ({ onClick: () => onRowClick(record?.id) })}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
