  makeVendorManagerInfo,
} from "../../utils";
import { VendorListPageProps } from "./VendorListPage";

function getVendorManagersTableSettings() {
  const columns: ColumnsType<IVendorManagerInfo> = [
    {
      title: "구분",
      key: "type",
      align: "center",
      width: 80,
      render: (_, record) => getVendorManagerTypeText(record.type),
    },
    {
      title: "성명",
      key: "name",
      align: "center",
      width: 120,
      render: (_, record) => record.name,
    },
    {
      title: "연락처",
      key: "phone",
      align: "center",
      width: 150,
      render: (_, record) => record.phone,
    },
    {
      title: "이메일",
      key: "email",
      align: "center",
      width: 200,
      render: (_, record) => record.email,
    },
    {
      title: "카카오톡",
      key: "katalkId",
      align: "center",
      width: 120,
      render: (_, record) => record.katalkId,
    },
  ];
  return columns;
}

const showManagersInfo = (vendor: Vendors_vendors_edges_node) => {
  const managers = makeVendorManagerInfo(vendor.managers);
  const managersWithDisplayOrder: IVendorManagerInfoIncludeDisplayOrder[] = managers.map((manager) => ({
    ...manager,
    displayOrder: getVendorManagerDisplayOrder(manager.type),
  }));

  const columns = getVendorManagersTableSettings();
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const contentNode = (
    <>
      <Typography.Title level={5}>{makeVendorDisplayName(vendor)}</Typography.Title>
      <Divider />
      <Table
        {...commonTableProps}
        rowKey={(record) => record.type}
        columns={columns}
        dataSource={managersWithDisplayOrder.sort((a, b) => a.displayOrder - b.displayOrder)}
        scroll={{ x: tableWidthSum }}
      />
    </>
  );

  showNotificationInfo(contentNode, false, undefined, { width: 800 });
};

