export const checkOrderedByUser = (orderType: OrderType | OrderTypeEnum) => orderType === OrderType.BY_USER;
export const checkOrderedByStaffForBrand = (orderType: OrderType | OrderTypeEnum) =>
  orderType === OrderType.BY_STAFF_FOR_BRAND;
export const checkOrderedByHqStaffForBrand = (orderType: OrderType | OrderTypeEnum) =>
  orderType === OrderType.BY_HQ_STAFF_FOR_BRAND;
export const checkOrderedByStaffForBadStock = (orderType: OrderType | OrderTypeEnum) =>
  orderType === OrderType.BY_STAFF_FOR_BAD_STOCK;
export const checkOrderedByStaffForEtc = (orderType: OrderType | OrderTypeEnum) =>
  orderType === OrderType.BY_STAFF_FOR_ETC;
export const checkOrderedByStaffForB2b = (orderType: OrderType | OrderTypeEnum) =>
  orderType === OrderType.BY_STAFF_FOR_B2B || orderType === OrderType.BY_STAFF_FOR_B2B_TAKE_BACK;
export const checkShowStaffNoteMode = (orderType: OrderType | OrderTypeEnum, isStaff: boolean) => {
  if (isStaff) {
    return checkOrderedByStaffForEtc(orderType) || checkOrderedByStaffForB2b(orderType);
  }
  return false;
};

export const checkFbvOrderLineExist = (orderLines: OrderDetails_order_lines[]) => {
  const exist = maybe(() => orderLines, []).some((line) => line.isFulfilledByVendor);

  return exist;
};

export const convertOrderTypeToEnum = (orderType: OrderType) => {
  switch (orderType) {
    case OrderType.BY_USER:
      return OrderTypeEnum.BY_USER;
    case OrderType.BY_STAFF_FOR_BRAND:
      return OrderTypeEnum.BY_STAFF_FOR_BRAND;
    case OrderType.BY_HQ_STAFF_FOR_BRAND:
      return OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND;
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
      return OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK;
    case OrderType.BY_STAFF_FOR_ETC:
      return OrderTypeEnum.BY_STAFF_FOR_ETC;
    case OrderType.BY_STAFF_FOR_B2B:
