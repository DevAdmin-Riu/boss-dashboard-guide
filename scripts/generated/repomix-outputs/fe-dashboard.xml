<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineAddModal/filters.ts">
import { ProductVariantFilterInput, SalesStatusEnum, StockAvailability } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleEnumValueQueryParam, getSingleValueQueryParam } from "@utils/filters";
import { createBooleanField, createOptionsField, createTextField } from "@utils/filters/fields";
import { findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

enum ProductVariantSearchFiltersEnum {
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  trackInventory = "trackInventory",
  stockAvailability = "stockAvailability",
}
type ProductVariantSearchFilters = Filters<ProductVariantSearchFiltersEnum>;

enum ProductVariantSearchFilterKeys {
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
  trackInventory = "trackInventory",
  stockAvailability = "stockAvailability",
}

interface ProductVariantSearchListFilterOpts {
  productSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  trackInventory: FilterOpts<boolean>;
  stockAvailability: FilterOpts<StockAvailability>;
}

export const getFilterOpts = (filterVariables: ProductVariantFilterInput): ProductVariantSearchListFilterOpts => ({
  productSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
    value: filterVariables.productSearch || "",
  },
  vendorSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
    value: filterVariables.vendorSearch || "",
  },
  trackInventory: {
    active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
    value: maybe(() => filterVariables.trackInventory, true),
  },
  stockAvailability: {
    active: maybe(() => !utils.isEmpty(filterVariables.stockAvailability), false),
    value: maybe(
      () => findValueInEnum(filterVariables.stockAvailability, StockAvailability),
      StockAvailability.OUT_OF_ROP
    ),
  },
});

export const createFilterStructure = (
  opts: ProductVariantSearchListFilterOpts
): IFilter<ProductVariantSearchFilterKeys> => {
  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        ProductVariantSearchFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        ProductVariantSearchFilterKeys.vendorSearch,
        "협력사코드 / 협력사명",
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        ProductVariantSearchFilterKeys.trackInventory,
        columnNameConstant.product.TRACK_INVENTORY,
        opts.trackInventory.value,
        {
          negative: "미운영",
          positive: "운영",
        }
      ),
      active: opts.trackInventory.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        ProductVariantSearchFilterKeys.stockAvailability,
        columnNameConstant.stock.SAFETY_STOCK_STATUS,
        [opts.stockAvailability.value],
        false,
        [
          {
            label: "재고 안전",
            value: StockAvailability.IN_OF_SAFETY_STOCK,
          },
          {
            label: "재고 위험",
            value: StockAvailability.OUT_OF_SAFETY_STOCK,
          },
          {
            label: "발주 안전",
            value: StockAvailability.IN_OF_ROP,
          },
          {
            label: "발주 필요",
            value: StockAvailability.OUT_OF_ROP,
          },
          //   {
          //     label: "재고 소진",
          //     value: StockAvailability.OUT_OF_STOCK,
          //   },
        ]
      ),
      active: opts.stockAvailability.active,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): ProductVariantSearchFilters {
  const { name } = filter;

  switch (name) {
    case ProductVariantSearchFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ProductVariantSearchFiltersEnum.productSearch);
    case ProductVariantSearchFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, ProductVariantSearchFiltersEnum.vendorSearch);
    case ProductVariantSearchFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, ProductVariantSearchFiltersEnum.trackInventory);
    case ProductVariantSearchFilterKeys.stockAvailability:
      return getSingleEnumValueQueryParam(filter, ProductVariantSearchFiltersEnum.stockAvailability, StockAvailability);
  }
}

export function getProductVariantSearchFilterVariables(
  filters: Array<IFilterElement<string>>
): ProductVariantFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});
  return {
    productSearch: queryParams.productSearch,
    vendorSearch: queryParams.vendorSearch,
    trackInventory:
      queryParams.trackInventory !== undefined ? parseBoolean(queryParams.trackInventory, true) : undefined,
    stockAvailability:
      queryParams.stockAvailability !== undefined
        ? findValueInEnum(queryParams.stockAvailability, StockAvailability)
        : undefined,
    salesStatus: [SalesStatusEnum.ON_SALE, SalesStatusEnum.PENDING],
  };
}
</file>

