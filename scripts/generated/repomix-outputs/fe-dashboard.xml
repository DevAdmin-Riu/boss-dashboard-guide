export const makeUpdateCol = ({
  isEditing,
  loading,
  selectedPurchaseId,
  onEdit,
  onCancel,
  onSubmit,
}: IPurchaseTableSettingsPropsForEditing): DownloadableEditableColumnType<Purchases_purchases_edges_node> => ({
  title: "수정",
  key: "update",
  align: "center",
  width: 120,
  fixed: utils.fixedRightFlag(),
  render: (_, record) => {
    const editable = isEditing(record);
    const disabled = checkPurchaseUpdateAvailable(record.status) === false;

    return editable ? (
      <Space size={"small"}>
        <Button
          size="small"
          type={"primary"}
          disabled={utils.isEmpty(selectedPurchaseId) || disabled}
          onClick={onSubmit}
        >
          저장
        </Button>
        <Button size="small" type={"default"} onClick={onCancel}>
          취소
        </Button>
      </Space>
    ) : (
      <Button
        size="small"
        type={"primary"}
        disabled={!utils.isEmpty(selectedPurchaseId) || disabled}
        onClick={() => onEdit(record)}
      >
        수정
      </Button>
    );
  },
  isPickerHide: true,
  doNotRenderExcel: true,
});
