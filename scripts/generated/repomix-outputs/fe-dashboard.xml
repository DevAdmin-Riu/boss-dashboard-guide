import { sectionNames } from "@assets/messages/sectionNames";
import { VendorContactType } from "@src/api/types/globalTypes";
import { getRecordsObject } from "@src/app/components/antd/Form/utils";
import { parseBoolean } from "@utils/misc";
import moment from "moment";

import { OrderLineList_orderLines_edges_node } from "../../api/types/OrderLineList";
import { OrderLineListViewUrlQueryParams } from "../../urls";

export enum OrderLineListViewTypeEnum {
  STOCK = "STOCK",
  CONSIGNMENT = "CONSIGNMENT",
  STOCK_ETC = "STOCK_ETC",
  FULFILLED_BY_VENDOR = "FULFILLED_BY_VENDOR",
}

export enum OrderLineListActionTypeEnum {
  FOR_PURCHASE = "FOR_PURCHASE",
  FOR_FULFILL = "FOR_FULFILL",
  FULFILLED = "FULFILLED",
}

export const checkIsListViewStock = (orderLineListViewType: OrderLineListViewTypeEnum) =>
  orderLineListViewType === OrderLineListViewTypeEnum.STOCK;
export const checkIsListViewConsignment = (orderLineListViewType: OrderLineListViewTypeEnum) =>
  orderLineListViewType === OrderLineListViewTypeEnum.CONSIGNMENT;
export const checkIsListViewStockEtc = (orderLineListViewType: OrderLineListViewTypeEnum) =>
  orderLineListViewType === OrderLineListViewTypeEnum.STOCK_ETC;
export const checkIsListViewFulfilledByVendor = (orderLineListViewType: OrderLineListViewTypeEnum) =>
  orderLineListViewType === OrderLineListViewTypeEnum.FULFILLED_BY_VENDOR;

export const checkIsListActionForPurchase = (orderLineListActionType: OrderLineListActionTypeEnum) =>
  orderLineListActionType === OrderLineListActionTypeEnum.FOR_PURCHASE;
export const checkIsListActionForFulfill = (orderLineListActionType: OrderLineListActionTypeEnum) =>
  orderLineListActionType === OrderLineListActionTypeEnum.FOR_FULFILL;
export const checkIsListActionFulfilled = (orderLineListActionType: OrderLineListActionTypeEnum) =>
  orderLineListActionType === OrderLineListActionTypeEnum.FULFILLED;

export const getPageTitle = (params: OrderLineListViewUrlQueryParams, isVendorStaff: boolean, isB2b: boolean) => {
  const { orderLineListViewType, orderLineListActionType } = params;
  const defaultPageTitle = "-";

  // NOTE: 위탁 주문 관련 페이지만 존재하므로 위탁 주문 관련 섹션 네임만 사용.
  switch (orderLineListViewType) {
    case OrderLineListViewTypeEnum.STOCK:
      return sectionNames.fulfillmentsA;

    case OrderLineListViewTypeEnum.CONSIGNMENT:
      switch (orderLineListActionType) {
        case OrderLineListActionTypeEnum.FOR_PURCHASE:
          return sectionNames.orderLinesForPurchaseB;
        case OrderLineListActionTypeEnum.FOR_FULFILL:
          const isByNonCourier = parseBoolean(params.isByNonCourier, false);
          return `${
            isByNonCourier
              ? sectionNames.purchaseOrderLine.delegatedDispatchFulfillmentByNonCourier
              : sectionNames.purchaseOrderLine.delegatedDispatchFulfillmentByCourier
          }(${isB2b ? sectionNames.orderLinesForFulfillB2b : sectionNames.orderLinesForFulfillB})`;
        case OrderLineListActionTypeEnum.FULFILLED:
          return sectionNames.fulfilledOrderLinesB;
        default:
          return defaultPageTitle;
      }

    case OrderLineListViewTypeEnum.STOCK_ETC:
      return sectionNames.fulfillmentsC;

    case OrderLineListViewTypeEnum.FULFILLED_BY_VENDOR:
      switch (orderLineListActionType) {
        case OrderLineListActionTypeEnum.FOR_FULFILL:
          return isVendorStaff ? sectionNames.vendorOrderLinesD : sectionNames.orderLinesD;
        default:
          return defaultPageTitle;
      }
    default:
      return defaultPageTitle;
  }
};

// 출고 완료된 위탁 주문 내역의 협력사 정보 수정 가능 여부 체크
export const checkOrderLineUpdateVendorAvailable = (orderLine: OrderLineList_orderLines_edges_node) => {
  const { trackInventory, fulfillmentLines } = orderLine;
  const fulfilled = fulfillmentLines?.length > 0;
  if (trackInventory || fulfilled === false) {
    return false;
  }

  const today = moment();
  const todayDateNumber = today.date();
  const onlyThisMonthOrder = todayDateNumber > 10;
  const orderCreated = moment(orderLine.order.created);

  if (onlyThisMonthOrder) {
    // 11일 이후 주문인 경우 해당 월 주문만 수정 가능
    return orderCreated.isSame(today, "month");
  }
  // 1~10일 주문인 경우 지난 달 주문도 수정 가능
  return orderCreated.isSameOrAfter(today.subtract(1, "month"), "month");
};

export const makeVendorDataFromOrderLine = (
  orderLine: OrderLineList_orderLines_edges_node
): { code: string; name: string; contactType?: VendorContactType; unitCostPriceExcludeVat?: number } => {
  const fulfillmentLines = orderLine?.fulfillmentLines || [];
  const fulfilled = fulfillmentLines.length > 0;
  if (fulfilled) {
    const { vendor, unitCostPriceExcludeVat } = fulfillmentLines[0];
    return { ...vendor, unitCostPriceExcludeVat };
  }

  const { existPurchaseOrderLine, purchaseOrderLine, variant } = orderLine;
  if (existPurchaseOrderLine) {
    const vendorData = JSON.parse(purchaseOrderLine?.purchaseOrder?.vendorData);
    return vendorData;
  }
  return variant?.defaultVariantVendor?.vendor;
};

export function getFormInitialValues(orderLines: OrderLineList_orderLines_edges_node[]) {
  return {
    ...orderLines?.reduce((obj, item) => {
      obj[item.id] = {
        orderId: item.order.id,
        input: {
          lines: [
            {
              orderLineId: item.id,
            },
          ],
        },
      };
      return obj;
    }, {}),
    records: getRecordsObject(orderLines),
    selectedRowKeys: [],
  };
}

export const checkHasVendorTrackInventory = (orderLines, listElements) => {
  const selectedOrderLines = orderLines.filter((orderLine) => listElements.includes(orderLine.id));
  const hasVendorTrackInventory = selectedOrderLines.some(
    (orderLine) => orderLine?.variant?.isVendorTrackInventory === true
  );
  return hasVendorTrackInventory;
};
