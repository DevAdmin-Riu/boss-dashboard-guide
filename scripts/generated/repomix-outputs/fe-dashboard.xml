import useForm, { FormChange, SubmitPromise } from "@hooks/useForm";
import useFormset, { FormsetChange } from "@hooks/useFormset";
import useMetadataChangeTrigger from "@src/api/core/metadata/useMetadataChangeTrigger";
import { ProductVariantFragment_inspectReportTemplate } from "@src/api/fragments/types/ProductVariantFragment";
import { SearchWarehouses_search_edges_node } from "@src/api/searches/types/SearchWarehouses";
import {
  PriorityLevelEnum,
  ProductVariantManageEventInput,
  QtyPerBoxUnitTypeEnum,
  SalesStatusEnum,
  SalesUnitTypeEnum,
  StockInput,
  StoppedReasonTypeEnum,
} from "@src/api/types/globalTypes";
import { MetadataFormData } from "@src/app/components/Metadata";
import { getAttributeInputFromVariant, getStockInputFromVariant } from "@src/app/views/product/products/utils/data";
import { getMakerLabel } from "@src/app/views/purchase/vendors/utils";
import handleFormSubmit from "@utils/handlers/handleFormSubmit";
import { mapMetadataItemToInput } from "@utils/maps";
import { maybe } from "@utils/misc";
import React from "react";

import { ProductVariantDetails_productVariant } from "../../api/types/ProductVariantDetails";
import { calcPackCount } from "../../utils/utils";
import { ProductAttributeInput } from "../ProductAttributes";

interface ProductVariantUpdateFormData extends MetadataFormData {
  qtyPerBox: number;
  qtyPerBoxUnitType: QtyPerBoxUnitTypeEnum;
  priorityLevel: PriorityLevelEnum;
  salesUnitType: SalesUnitTypeEnum;
  boxLength: number;
  boxWidth: number;
  boxHeight: number;
  palletQty: number | null;
  palletM: number | null;
  palletN: number | null;
  palletO: number | null;
  maker: string;
  makerLabel: string;
  trackInventory: boolean;
  isVendorTrackInventory: boolean;
  allowAutoConsignment: boolean;
  isAdjustPrice: boolean;
  qtyPerDeliveryBox: number;
  autoTurnOffAllowAutoConsignment: boolean;
  isSubPv: boolean;
  canSaleByInner: boolean;
  requiredExpDateMgmt: boolean;
  note: string;
  poNote: string;
  name: string;
  isSeasonal: boolean;
  peakSeasonStartDate: string | null;
  peakSeasonEndDate: string | null;
  salesStatus: SalesStatusEnum;
  stoppedReason: StoppedReasonTypeEnum;
  stoppedReasonEtc: string;
  stockAdjustFactor: number;
  basicStockQty: number;
  safetyStockQty: number;
  rop: number;
  stocks: StockInput[];
  // 이너박스 정보(직배송 제품인 경우는 무관)
  innerSalesStatus: SalesStatusEnum;
  innerStoppedReason: StoppedReasonTypeEnum;
  innerStoppedReasonEtc: string;
  innerMoq: number;
  innerUoq: number;
  packCount: number;
  innerQtyPerBox: number;
  innerBoxLength: number;
  innerBoxWidth: number;
  innerBoxHeight: number;
  innerStocks: StockInput[];
  manageEvent: ProductVariantManageEventInput;

  forceSoldOutNotice: boolean;
  innerForceSoldOutNotice: boolean;

  priceDecimalPlaces: number;
  orderQtyDecimalPlaces: number;

  // 검수 정보
  needToInspect: boolean;
  inspectReason: string;
  inspectType: string;
  inspectMemo: string;
  inspectReportTemplate: ProductVariantFragment_inspectReportTemplate;

  countryOfOrigin: string | null;
}
export interface ProductVariantUpdateData extends ProductVariantUpdateFormData {
  attributes: ProductAttributeInput[];
  hasVariants: boolean;
  isDevPv: boolean;
  isForCreditsRefill: boolean;
}

interface UseProductVariantUpdateFormOpts {
  warehouses: SearchWarehouses_search_edges_node[];
}

interface UseProductVariantUpdateFormResult {
  change: FormChange;
  data: ProductVariantUpdateData;
  handlers: Record<"selectAttribute", FormsetChange> & { changeMetadata: FormChange };
  hasChanged: boolean;
  submit: () => Promise<boolean>;
}

interface ProductVariantUpdateFormProps extends UseProductVariantUpdateFormOpts {
  children: (props: UseProductVariantUpdateFormResult) => React.ReactNode;
  variant: ProductVariantDetails_productVariant;
  onSubmit: (data: ProductVariantUpdateData) => SubmitPromise;
}

function useProductVariantUpdateForm(
  variant: ProductVariantDetails_productVariant,
  onSubmit: (data: ProductVariantUpdateData) => SubmitPromise,
  _opts: UseProductVariantUpdateFormOpts
): UseProductVariantUpdateFormResult {
  const [changed, setChanged] = React.useState(false);
  const triggerChange = () => setChanged(true);

  const initial: ProductVariantUpdateFormData = {
    qtyPerBox: maybe(() => variant.qtyPerBox, null),
    qtyPerBoxUnitType: maybe(() => variant.qtyPerBoxUnitType, null),
    priorityLevel: maybe(() => variant.priorityLevel, null),
    salesUnitType: maybe(() => variant.salesUnitType, null),
    boxLength: maybe(() => variant.boxLength, null),
    boxWidth: maybe(() => variant.boxWidth, null),
    boxHeight: maybe(() => variant.boxHeight, null),
    palletQty: maybe(() => variant.palletQty, null),
    palletM: maybe(() => variant.palletM, null),
    palletN: maybe(() => variant.palletN, null),
    palletO: maybe(() => variant.palletO, null),
    maker: maybe(() => variant.maker.id, null),
    makerLabel: getMakerLabel(variant.maker),
    metadata: variant?.metadata?.map(mapMetadataItemToInput),
    privateMetadata: variant?.privateMetadata?.map(mapMetadataItemToInput),
    trackInventory: variant?.trackInventory,
    isVendorTrackInventory: variant?.isVendorTrackInventory,
    allowAutoConsignment: variant?.allowAutoConsignment,
    isAdjustPrice: variant?.isAdjustPrice,
    qtyPerDeliveryBox: maybe(() => variant.qtyPerDeliveryBox, null),
    autoTurnOffAllowAutoConsignment: variant?.autoTurnOffAllowAutoConsignment,
    isSubPv: variant?.isSubPv,
    canSaleByInner: variant?.canSaleByInner,
    requiredExpDateMgmt: variant?.requiredExpDateMgmt,
    note: variant?.note || "",
    poNote: variant?.poNote || "",
    name: variant?.name || "",
    isSeasonal: variant?.isSeasonal || false,
    peakSeasonStartDate: variant?.peakSeasonStartDate || null,
    peakSeasonEndDate: variant?.peakSeasonEndDate || null,
    salesStatus: variant?.salesStatus,
    stoppedReason: variant?.stoppedReason,
    stoppedReasonEtc: variant?.stoppedReasonEtc,
    stockAdjustFactor: maybe(() => variant.stockAdjustFactor, null),
    basicStockQty: maybe(() => variant.basicStockQty, null),
    safetyStockQty: maybe(() => variant.safetyStockQty, null),
    rop: maybe(() => variant.rop30, null),
    stocks: getStockInputFromVariant(variant),
    // 수정 될 때마다 manageEvent는 새로 입력 받아 추가되는 구조이므로 null로 초기화
    manageEvent: null,
    // 이너박스 정보
    innerSalesStatus: variant?.inner?.salesStatus,
    innerStoppedReason: variant?.inner?.stoppedReason,
    innerStoppedReasonEtc: variant?.inner?.stoppedReasonEtc,
    innerMoq: maybe(() => variant.inner.innerMoq, 1),
    innerUoq: maybe(() => variant.inner.innerUoq, 1),
    packCount: maybe(() => calcPackCount(variant, variant.inner), null),
    innerQtyPerBox: maybe(() => variant.inner.qtyPerBox, null),
    innerBoxLength: maybe(() => variant.inner.boxLength, null),
    innerBoxWidth: maybe(() => variant.inner.boxWidth, null),
    innerBoxHeight: maybe(() => variant.inner.boxHeight, null),
    innerStocks: getStockInputFromVariant(variant?.inner),

    forceSoldOutNotice: variant?.forceSoldOutNotice,
    innerForceSoldOutNotice: variant?.inner?.forceSoldOutNotice,

    priceDecimalPlaces: maybe(() => variant.priceDecimalPlaces, 0),
    orderQtyDecimalPlaces: maybe(() => variant.orderQtyDecimalPlaces, 0),

    needToInspect: maybe(() => variant.needToInspect, false),
    inspectReason: maybe(() => variant.inspectReason, null),
    inspectType: maybe(() => variant.inspectType, null),
    inspectMemo: maybe(() => variant.inspectMemo, null),
    inspectReportTemplate: maybe(() => variant.inspectReportTemplate, null),

    countryOfOrigin: maybe(() => variant.countryOfOrigin.code, null),
  };

  const form = useForm(initial);
  const attributes = useFormset(getAttributeInputFromVariant(variant));
  const {
    isMetadataModified,
    isPrivateMetadataModified,
    makeChangeHandler: makeMetadataChangeHandler,
  } = useMetadataChangeTrigger();

  const handleChange: FormChange = (event, cb) => {
    form.change(event, cb);
    triggerChange();
  };
  const changeMetadata = makeMetadataChangeHandler(handleChange);
  const handleAttributeChange: FormsetChange = (id, value) => {
    attributes.change(id, value === "" ? [] : [value]);
    triggerChange();
  };

  const metadata = isMetadataModified ? form.data.metadata : undefined;
  const privateMetadata = isPrivateMetadataModified ? form.data.privateMetadata : undefined;

  const data: ProductVariantUpdateData = {
    ...form.data,
    attributes: attributes.data,
    hasVariants: true,
    isForCreditsRefill: variant.isForCreditsRefill,
    isDevPv: variant.isDevPv,
    metadata,
    privateMetadata,
  };

  const submit = () => handleFormSubmit(data, onSubmit, setChanged);

  return {
    change: handleChange,
    data,
    handlers: {
      changeMetadata,
      selectAttribute: handleAttributeChange,
    },
    hasChanged: changed,
    submit,
  };
}

const ProductVariantUpdateForm: React.FC<ProductVariantUpdateFormProps> = ({
  children,
  variant,
  onSubmit,
  ...rest
}) => {
  const props = useProductVariantUpdateForm(variant, onSubmit, rest);

  return <form onSubmit={props.submit}>{children(props)}</form>;
};

export default ProductVariantUpdateForm;
</file>

