export const makePurchaseProductPriceExcludeVat = (
  purchase: Purchases_purchases_edges_node,
  isHtml: boolean = true
) => {
  const params = utils.jsonParseWrapper(purchase.parameters);
  const product = params?.product;
  const isB2b = purchase.purchaseOrder?.isB2b;
  let value = 0;

  if (isB2b) {
    value = product?.unit_cost_price_exclude_vat;
  } else {
    value =
      product?.unit_cost_price_exclude_vat -
      product?.delivery_fee_exclude_vat -
      purchase.consignmentUnitDeliveryAdditionalFeeExcludeVat;
  }
  const productPriceExcludeVat = utils.convertToNumber(value, purchase.purchaseOrderLine?.variant?.priceDecimalPlaces);

  return productPriceExcludeVat !== undefined ? (
    isHtml ? (
      <NumberComponent value={productPriceExcludeVat} />
    ) : (
      productPriceExcludeVat
    )
  ) : (
    "-"
  );
};

export const getPurchaseTypeTagColor = (purchaseType: PurchaseType) => {
