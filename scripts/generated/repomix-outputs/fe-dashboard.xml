  BossToUserNoticeListViewUrlQueryParams,
} from "@src/app/views/notice/notices/urls";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import { Button, Modal } from "antd";
import React from "react";

import { useNoticeBulkDeleteMutation, useNoticeBulkPublishMutation } from "../../api/mutations";
import { fromBossNoticeListQuery, useFromBossNoticeListQuery } from "../../api/queries";
import { FromBossNoticesVariables } from "../../api/types/FromBossNotices";
import BossToUserNoticeListPage from "../../components/BossToUserNoticeListPage";
import { getSortQueryVariables } from "./sort";

interface BossToUserNoticeListViewProps {
  params: BossToUserNoticeListViewUrlQueryParams;
}

// 포장보스 → 매장 공지
export const BossToUserNoticeListView: React.FC<BossToUserNoticeListViewProps> = ({ params }) => {
  const { isSelected, listElements, reset, toggle, toggleAll } = useBulkActions(params?.ids);
  const { user } = useUser();

  const targetUrl = bossToUserNoticeListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.NOTICE_LIST,
  });

  // 관리자 외에는 본인 브랜드의 공지만 볼 수 있음
  const isStaff = user.isStaff;
  const filterVariables: NoticeFilterInput = {
    isHqNotice: false,
    availableBrand: isStaff ? null : user.brand.id,
  };
  const queryVariables: FromBossNoticesVariables = React.useMemo(
    () => ({ ...paginationState, sort: getSortQueryVariables(params), filter: filterVariables }),
    [params]
  );

  const { data, loading } = useFromBossNoticeListQuery({ variables: queryVariables });

  const [noticeBulkDelete, noticeBulkDeleteOpts] = useNoticeBulkDeleteMutation({
    onCompleted: (data) => {
      const errors = data.noticeBulkDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        reset();
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [fromBossNoticeListQuery],
  });

  const [noticeBulkPublish, noticeBulkPublishOpts] = useNoticeBulkPublishMutation({
    onCompleted: (data) => {
      const errors = data.noticeBulkPublish.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        reset();
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [fromBossNoticeListQuery],
  });

  const handleSort = createSortHandler(navigate, bossToUserNoticeListViewUrl, params);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.fromBossNotices?.pageInfo,
    paginationState,
    params,
  });

  const { openModal, closeModal } = utils.initListViewFilterTabs<
    BossToUserNoticeListViewUrlDialog,
    BossToUserNoticeListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
  });

  const pageLoading = loading || noticeBulkDeleteOpts.loading || noticeBulkPublishOpts.loading;

  return (
    <>
      <BossToUserNoticeListPage
        onAdd={() => navigate(bossToUserNoticeCreateViewUrl)}
        disabled={pageLoading}
        notices={maybe(() => data.fromBossNotices.edges.map((edge) => edge.node))}
        user={user}
        settings={settings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        onRowClick={(id) => navigate(bossToUserNoticeDetailsViewUrl(id))}
        toolbar={
          <>
            <Button
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("publish", { ids: listElements })}
            >
              일괄 {buttonText.publish}
            </Button>
            <Button
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("unpublish", { ids: listElements })}
            >
              일괄 {buttonText.unpublish}
            </Button>
            <Button
              danger
              type="primary"
              shape="round"
              disabled={listElements.length === 0}
              onClick={() => openModal("remove", { ids: listElements })}
            >
              일괄 {buttonText.remove}
            </Button>
          </>
        }
        selectedRowKeys={listElements}
        isChecked={isSelected}
        selected={listElements.length}
        toggle={toggle}
        toggleAll={toggleAll}
      />
      <Modal
        title="공지사항 공개"
        open={params.action === "publish" && maybe(() => params?.ids?.length > 0)}
        onOk={() => noticeBulkPublish({ variables: { ids: params?.ids, isPublished: true } })}
        okButtonProps={{ loading: pageLoading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 공지사항을 공개하시겠습니까?
      </Modal>
      <Modal
        title="공지사항 비공개"
        open={params.action === "unpublish" && maybe(() => params?.ids?.length > 0)}
        onOk={() => noticeBulkPublish({ variables: { ids: params?.ids, isPublished: false } })}
        okButtonProps={{ loading: pageLoading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 공지사항을 비공개하시겠습니까?
      </Modal>
      <Modal
        title="공지사항 삭제"
        open={params.action === "remove" && maybe(() => params?.ids?.length > 0)}
        onOk={() => noticeBulkDelete({ variables: { ids: params?.ids } })}
        okButtonProps={{ danger: true, loading: pageLoading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 공지사항을 삭제하시겠습니까?
      </Modal>
    </>
  );
};
</file>

