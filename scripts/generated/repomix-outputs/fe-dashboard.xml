import { useApolloClient } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { FulfillmentRefundCancelStockUpInput, RefundQAStatus } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import TableListFooter from "@src/app/components/TableListFooter";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { useInspectStockUpAndInspectCheckMutation } from "@src/app/views/order/orders/api/mutations";
import { PaginateListProps } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Card, Descriptions, Input, notification, Table } from "antd";
import DescriptionsItem from "antd/lib/descriptions/Item";
import axios from "axios";
import React from "react";

import {
  useCustomerQuestionProductReturnedOkMutation,
  useCustomerQuestionStatusUpdateMutation,
} from "../../api/mutations";
import { CustomerQuestionGetCountQuery, RefundQuestionListQuery } from "../../api/queries";
import {
  RefundQuestionList_refundQuestions_edges_node,
  RefundQuestionList_refundQuestions_edges_node_inspectList,
} from "../../api/types/RefundQuestionList";
import CustomerRefundQuestionInspectCheckModal from "../CustomerRefundQuestionInspectCheckModal/CustomerRefundQuestionInspectCheckModal";
import RefundInspect from "../RefundInspect/RefundInspect";
import { getCustomerRefundQuestionInspectListTableColumns } from "./CustomerRefundQuestionInspectTableSetting";
import { isInspect } from "./utils";

interface CustomerRefundQuestionInspectListProps extends PaginateListProps {
  onRowRefundBtnClick: ({ id, refundId }) => void;
  customerQuestions: RefundQuestionList_refundQuestions_edges_node[];
}

export interface inspectListData extends RefundQuestionList_refundQuestions_edges_node_inspectList {
  uniqueId: string;
  productName: string;
}

const CustomerRefundQuestionInspectTable: React.FC<CustomerRefundQuestionInspectListProps> = (props) => {
  const { customerQuestions, onRowClick, onRowRefundBtnClick, ...listProps } = props;
  const shop = useShop();
  const client = useApolloClient();
  const initOpenList = customerQuestions?.reduce((acc, cur) => {
    const { status, productReturnedAt } = cur;
    if (isInspect(status, productReturnedAt)) {
      acc.push(cur.id);
    }
    return acc;
  }, []);

  const columns = getCustomerRefundQuestionInspectListTableColumns({ onRowRefundBtnClick, onRowClick, listProps });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const [refundInspectId, setRefundInspectId] = React.useState<string>("");
  const [refundId, setRefundId] = React.useState<string>("");
  const [refundInspectStatus, setRefundInspectStatus] = React.useState<null | boolean>(null);
  const [modalInspectList, setModalInspectList] = React.useState<inspectListData[]>([]);
  const [inspectMemo, setInspectMemo] = React.useState<string>("");
  const [isModalOpen, setIsModalOpen] = React.useState(false);

  const [visibleRejectConfirmModal, setVisibleRejectConfirmModal] = React.useState<boolean>(false);
  const [rejectMemo, setRejectMemo] = React.useState<string>("");

  // NOTE: 반품 취소 관련 상태
  const [visibleReturnCancelModal, setVisibleReturnCancelModal] = React.useState<boolean>(false);
  const [returnCancelItem, setReturnCancelItem] = React.useState<inspectListData | null>(null);

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  // NOTE: 반품 취소 API 호출 (백엔드에서 Goodsflow API 호출 + 검수 불량 처리까지 한번에 수행)
  const requestCancelReturn = async (id: string, transUniqueCd: string) => {
    const requestUrl =
      (shop?.goodsflowPluginConfig || []).find(({ field }) => field === "request_return_cancel_url")?.value || "";

    if (!requestUrl) {
      showNotificationError("반품 취소 API URL이 설정되어 있지 않습니다.");
      return false;
    }

    const params = {
      id,
      transUniqueCd,
    };

    try {
      const response = await axios.post(requestUrl, params);
      const { data } = response;
      if (data.success === false) {
        const error = data.error;
        showNotificationError(error.message);
        return false;
      }
      showNotificationSuccess("반품 신청이 정상적으로 취소되었습니다.");
      return true;
    } catch (error) {
      showNotificationError(error.message);
      return false;
    }
  };

  // NOTE: 반품 취소 버튼 클릭 시 모달 오픈
  const handleReturnCancelClick = (item: inspectListData) => {
    setReturnCancelItem(item);
    setVisibleReturnCancelModal(true);
  };

  const handleReturnCancelConfirm = async () => {
    if (
      !returnCancelItem ||
      !returnCancelItem.fulfillment?.returnTransUniqueCd ||
      !returnCancelItem.fulfillment?.returnCourierDeliveryFeeId
    ) {
      showNotificationError("반품 취소에 필요한 정보가 없습니다.");
      return;
    }

    const id = returnCancelItem.fulfillment.returnCourierDeliveryFeeId;
    const transUniqueCd = returnCancelItem.fulfillment.returnTransUniqueCd;

    const success = await requestCancelReturn(id, transUniqueCd);

    if (success) {
      await client.refetchQueries({
        include: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
      });
    }

    setVisibleReturnCancelModal(false);
    setReturnCancelItem(null);
  };

  // NOTE: 검수 확인 Modal
  const showModal = (e) => {
    const target = e.currentTarget;
    const refundInspectId = target.dataset.id;
    const refundInspectStatus = target.dataset.status === "true" ? true : false;
    setRefundInspectId(refundInspectId);
    setRefundInspectStatus(refundInspectStatus);
    setIsModalOpen(true);
  };

  const modalCancel = () => {
    setIsModalOpen(false);
    setRefundInspectStatus(null);
    setInspectMemo("");
    setRefundId("");
  };

  // NOTE: 반려 모달 UI
  const makeRejectContentNode = () => (
    <Card>
      <Descriptions bordered>
        <DescriptionsItem label="반려 사유">
          <Input.TextArea
            value={rejectMemo}
            onChange={(e) => {
              setRejectMemo(e.target.value);
            }}
          ></Input.TextArea>
        </DescriptionsItem>
      </Descriptions>
    </Card>
  );
  const rejectButtonProps = {
    danger: true,
  };
  const rejectText = "반려";

  // NOTE: 환불 대기 상태 에서 반려 상태로 변경 START
  const [onCustomerQuestionStatusUpdate] = useCustomerQuestionStatusUpdateMutation({
    onCompleted: (data) => {
      const errors = data.customerQuestionStatusUpdate.bbsErrors;
      if (errors.length > 0) {
        notification.error({ message: "반려 상태로 변경하는 도중 에러가 발생했습니다. 관리자에게 문의하세요." });
        return;
      }
      notification.success({ message: "해당 문의 건을 반려처리 하였습니다." });
      setVisibleRejectConfirmModal(false);
    },
    onError: () => {
      notification.error({ message: "반려 상태로 변경하는 도중 에러가 발생했습니다. 관리자에게 문의하세요." });
    },
    refetchQueries: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
  });

  const questionStatusUpdate = (changeStatus) => {
    if (refundId === null) {
      notification.error({ message: "반려할 문의건이 존재하지 않습니다." });
      return;
    }

    if (rejectMemo.trim().length < 10) {
      notification.info({ message: "반려 사유를 10자 이상 적어주시기 바랍니다." });
      return;
    }

    onCustomerQuestionStatusUpdate({
      variables: {
        id: refundId,
        input: {
          status: changeStatus,
          memo: rejectMemo,
        },
      },
    });
  };

  // NOTE: 상품 개별적 검수 mutation
  const [onInspectStockUpAndLoss] = useInspectStockUpAndInspectCheckMutation({
    onCompleted: (data) => {
      if (data.inspectStockUpAndInspectCheckCombine.errors.length > 0) {
        notification.success({ message: "검수 중 오류가 발생하였습니다." });
        return;
      }
      notification.success({ message: "검수 확인 완료" });
    },
    onError: (_e) => {
      notification.success({ message: "검수 중 오류가 발생하였습니다." });
    },
  });

  // NOTE: 상품 개별적 검수 event
  const inspectBtnClick = (refundInspectId, refundInspectStatus, inspectList) => {
    const findInspectIdx = inspectList.findIndex((item) => item.id === refundInspectId);
    const findInspectItem = inspectList[findInspectIdx];

    const fulfillment = findInspectItem.fulfillment;
    const cancelStockUplVariableObj: FulfillmentRefundCancelStockUpInput = {
      id: fulfillment.id,
      // input > inspectInput = false 인 경우는 로케이션 무관. 해당 컴포넌트는 고객 문의 관리 > 회수 및 검수(inspectInput = false) 페이지이기 때문에 로케이션 무관
      input: {
        warehouseId: fulfillment.lines[0].warehouse?.id,
        isRefund: true,
        rackLocation: null,
      },
    };

    onInspectStockUpAndLoss({
      variables: {
        id: refundId,
        input: {
          fulfillmentCancellation: cancelStockUplVariableObj,
          refundInspectId,
          inspectInput: {
            inspect: refundInspectStatus,
            memo: inspectMemo,
          },
        },
      },
    });
    setIsModalOpen(false);
    setRefundInspectStatus(null);
  };

  // NOTE: 문의에 대한 상품 최종 검수 확인 mutation
  const [useCustomerQuestionProductReturnedOk] = useCustomerQuestionProductReturnedOkMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.customerRefundProductReturned.errors;
        if (errors.length > 0) {
          notification.error({
            message: "해당 문의에 해당하는 검수를 마감하는 도중 오류가 발생하였습니다. 관리자에게 문의하세요.",
          });
          return;
        }
        notification.success({ message: "해당 문의에 해당하는 상품에 대한 검수를 마감합니다." });
      }
    },
    onError: () => {
      notification.error({
        message: "해당 문의에 해당하는 검수를 마감하는 도중 오류가 발생하였습니다. 관리자에게 문의하세요.",
      });
    },
    refetchQueries: [RefundQuestionListQuery, CustomerQuestionGetCountQuery],
  });

  // NOTE: 해당 문의건 최종 검수 확인 event
  const finalInspectBtnClick = (inspectList, refundQuestionId) => {
    const noInspectList = inspectList.filter((item) => item.inspect === null);

    if (noInspectList.length > 0) {
      notification.error({
        message:
          "검수하지 않는 상품이 존재합니다. 모든 상품에 대해서 검수를 마친 후 '최종 검수 확인' 버튼을 클릭해주시기 바랍니다.",
      });
      return;
    }

    useCustomerQuestionProductReturnedOk({
      variables: {
        id: refundQuestionId,
      },
    });
  };

  return (
    <>
      <Table
        ref={tableRef}
        bordered
        size="small"
        loading={listProps.disabled}
        dataSource={customerQuestions}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        columns={columns}
        expandable={{
          expandedRowRender: (record) => {
            const refundQuestionId = record.id;
            let productName = "";
            const isInspects = isInspect(record.status, record.productReturnedAt);
            const customInspectList: inspectListData[] = record.inspectList.map((item) => {
              const fulfillmentPk = atob(item.fulfillment.id).split(":")[1];

              const findOrderLineId = record.order.fulfillments.filter(
                (fulfillmentsItem) => fulfillmentsItem.id === item.fulfillment.id
              );

              if (findOrderLineId.length === 0) {
                productName = "";
              } else {
                const orderLineId = findOrderLineId[0].lines[0].orderLineId;
                const findOrderLine = record.order.lines.filter((orderLinesItem) => orderLinesItem.id === orderLineId);

                if (findOrderLine.length > 0) {
                  productName = findOrderLine[0].productName;
                }
              }

              return {
                ...item,
                uniqueId: `${item.fulfillment.composedIdWithPrefix}:${fulfillmentPk}`,
                productName,
              };
            });

            return (
              <RefundInspect
                refundQuestionId={refundQuestionId}
                inspectList={customInspectList}
                isInspect={isInspects}
                inspectBtnClick={(e, memo: string) => {
                  setRefundId(refundQuestionId);
                  showModal(e);
                  setModalInspectList(customInspectList);
                  setInspectMemo(memo);
                }}
                rejectModalOpenBtnClick={() => {
                  const findIdx = customerQuestions.findIndex((item) => item.id === refundQuestionId);
                  const inspectList = customerQuestions[findIdx].inspectList;
                  const noInspectList = inspectList.filter((item) => item.inspect === null);

                  if (noInspectList.length > 0) {
                    notification.error({
                      message:
                        "검수하지 않는 상품이 존재합니다. 모든 상품에 대해서 검수를 마친 후 '최종 검수 확인' 버튼을 클릭해주시기 바랍니다.",
                    });
                    return;
                  }
                  setRefundId(refundQuestionId);
                  setVisibleRejectConfirmModal(true);
                }}
                finalInspectBtnClick={finalInspectBtnClick}
                onReturnCancel={(item) => handleReturnCancelClick(item)}
              />
            );
          },
          defaultExpandedRowKeys: initOpenList,
        }}
        rowKey={(record) => record?.id}
        pagination={false}
        footer={() => <TableListFooter {...listProps} />}
      />
      <CustomerRefundQuestionInspectCheckModal
        isModalOpen={isModalOpen}
        inspectBtnClick={inspectBtnClick}
        modalCancel={modalCancel}
        modalInspectList={modalInspectList}
        refundInspectId={refundInspectId}
        refundInspectStatus={refundInspectStatus}
      />

      <ConfirmModal
        titleText="환불 작업을 반려하시겠습니까?"
        helpText=""
        visible={visibleRejectConfirmModal}
        contentNode={makeRejectContentNode()}
        okButtonProps={rejectButtonProps}
        okText={rejectText}
        onOk={() => {
          questionStatusUpdate(RefundQAStatus.REJECT);
        }}
        onCancel={() => {
          setVisibleRejectConfirmModal(false);
          setRefundId(null);
          setRejectMemo("");
        }}
      />

      <ConfirmModal
        visible={visibleReturnCancelModal}
        modalTitleText="반품 취소 여부 확인"
        contentNode="반품 신청을 취소하시겠습니까?"
        onOk={handleReturnCancelConfirm}
        onCancel={() => {
          setVisibleReturnCancelModal(false);
          setReturnCancelItem(null);
        }}
      />
    </>
  );
};

export default CustomerRefundQuestionInspectTable;
</file>

