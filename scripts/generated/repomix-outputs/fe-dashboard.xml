import { SalesB2bStatusEnum } from "@src/api/types/globalTypes";
import {
  calcVatByPriceIncludeVat,
  toPriceExcludeVat,
  toPriceIncludeVat,
  toPricePrecisionFixed,
} from "@utils/excel/excelDownload";

import { SalesListForB2b_sales_edges_node } from "../../api/types/SalesListForB2b";

export const makeB2bTotalAmountExcludeVat = (record: SalesListForB2b_sales_edges_node) =>
  toPriceExcludeVat(record.unitPrice, record.isTaxFree) * record.quantity + record.b2bDeliveryFeeExcludeVat;

export const deliveryFeeVat = (b2bDeliveryFeeExcludeVat: number) =>
  toPriceIncludeVat(b2bDeliveryFeeExcludeVat, false) - b2bDeliveryFeeExcludeVat;

export const makeB2bVatAmount = (
  price: number,
  quantity: number,
  isTaxFree: boolean,
  precision: number,
  b2bDeliveryFeeExcludeVat: number
) => calcVatByPriceIncludeVat(price, isTaxFree, precision) * quantity + deliveryFeeVat(b2bDeliveryFeeExcludeVat);

export const makeB2bTotalAmount = (
  price: number,
  quantity: number,
  isTaxFree: boolean,
  precision: number,
  b2bDeliveryFeeExcludeVat: number
) =>
  toPricePrecisionFixed(
    price * quantity + deliveryFeeVat(b2bDeliveryFeeExcludeVat) + b2bDeliveryFeeExcludeVat,
    precision
  );

export const checkB2bSalesUpdateAvailable = (purchaseStatus: SalesB2bStatusEnum) =>
  [
    SalesB2bStatusEnum.STANDBY,
    SalesB2bStatusEnum.REQ_REVISION,
    SalesB2bStatusEnum.REVISION,
    SalesB2bStatusEnum.BEFORE_SEND,
  ].includes(purchaseStatus);
