    renderExcel: (record) => -record.qtyAfter,
  };

  const descriptionColumn: DownloadableColumnType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> =
    {
      title: "메모",
      key: "description",
      width: 200,
      render: (_, record) => maybe<React.ReactNode>(() => record.description, <Skeleton />),
      renderExcel: (record) => record.description,
    };

  const columns: DownloadableColumnsType<BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node> = [
    createdColumn,
    isStaff && brandCodeColumn,
    isStaff && brandNameColumn,
    eventTypeColumn,
    qtyAsOrderColumn,
    qtyAsRefundColumn,
    qtyAsIncreaseColumn,
    qtyAsByAdminColumn,
    qtyAfterColumn,
    descriptionColumn,
  ].filter(Boolean);
  return columns;
}
</file>

