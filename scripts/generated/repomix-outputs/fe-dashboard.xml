import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { VendorHistoryListPage } from "@src/app/views/purchase/vendors/views/vendorHistory/components/VendorHistoryListPage/VendorHistoryListPage";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useVendorHistoryListFilterDownloadQuery, useVendorHistoryListQuery } from "../../api/queries";
import { VendorHistoriesVariables } from "../../api/types/VendorHistories";
import {
  vendorHistoryCreateViewUrl,
  vendorHistoryDetailsViewUrl,
  VendorHistoryListViewUrlDialog,
  VendorHistoryListViewUrlQueryParams,
  vendorsHistoryListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface VendorListViewProps {
  params: VendorHistoryListViewUrlQueryParams;
  // 상세페이지에서 넘어오는 경우임.
  vendor?: {
    id: string;
    code: string;
  };
}

export const VendorHistoryListView: React.FC<VendorListViewProps> = ({ params, vendor }) => {
  const shop = useShop();
  const vendorId = !!vendor ? vendor?.id || "" : "";
  const vendorCode = !!vendor ? vendor?.code || "" : "";
  // vendor가 전달되는 경우는 상세페이지에서 넘어오는 경우임.
  const isVendorDetailsPage = utils.isEmpty(vendor) === false;

  const targetUrl = vendorsHistoryListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.VENDOR_HISTORY_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useVendorHistoryListFilterDownloadQuery);

  const queryVariables: VendorHistoriesVariables = React.useMemo(() => {
    const variables = { ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) };
    if (isVendorDetailsPage) {
      variables.filter = { ...variables.filter, vendorSearch: vendorCode };
    }
    return variables;
  }, [params, settings?.rowNumber, vendor, paginationState]);

  const { data, loading, refetch } = useVendorHistoryListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.vendorHistories?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<VendorHistoryListViewUrlDialog, VendorHistoryListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const filterOpts = getFilterOpts(params);

  const handleSort = createSortHandler(navigate, vendorsHistoryListViewUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  return (
    <>
      <VendorHistoryListPage
        vendorId={vendorId}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        vendorHistories={maybe(() => data.vendorHistories.edges.map((edge) => edge.node))}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onAdd={() => {
          if (!!vendorId) {
            navigate(vendorHistoryCreateViewUrl + "?vendor=" + encodeURIComponent(vendorId));
          } else {
            navigate(vendorHistoryCreateViewUrl);
          }
        }}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(vendorHistoryDetailsViewUrl(id))}
        onSort={handleSort}
        sort={getSortParams(params)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      {!!vendorId || (
        <>
          <SaveFilterTabDialog
            open={params.action === "save-search"}
            onClose={closeModal}
            onSubmit={handleFilterTabSave}
          />
          <DeleteFilterTabDialog
            open={params.action === "delete-search"}
            onClose={closeModal}
            onSubmit={handleFilterTabDelete}
            tabName={maybe(() => tabs[currentTab - 1].name, "...")}
          />
        </>
      )}
    </>
  );
};
</file>

<file path="src/app/views/purchase/vendors/views/vendorHistory/views/VendorHistoryCreateView.tsx">
import useNavigator from "@hooks/useNavigator";
import { DeleteFileType, UpdateFileDescType } from "@src/app/components/UploadFiles";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { UploadFile } from "antd";
import queryString from "query-string";
import React, { useState } from "react";

import {
  useCreateVendorHistoryFileMutation,
  useDeleteVendorHistoryFileMutation,
  useUpdateVendorHistoryFileMutation,
  useVendorHistoryCreateMutation,
} from "../api/mutations";
import { CreateVendorHistory } from "../api/types/CreateVendorHistory";
import { VendorHistoryFileCreate } from "../api/types/VendorHistoryFileCreate";
import { VendorHistoryFileDelete } from "../api/types/VendorHistoryFileDelete";
import { VendorHistoryFileUpdate } from "../api/types/VendorHistoryFileUpdate";
import VendorHistoryCreatePage, {
  VendorHistoryCreatePageFormData,
} from "../components/VendorHistoryPage/VendorHistoryCreatePage";
import { vendorHistoryDetailsViewUrl, vendorHistoryListUrl } from "../urls";

export interface VendorHistoryCreateViewProps {
  id: string;
}

export const VendorHistoryCreateView: React.FC<VendorHistoryCreateViewProps> = () => {
  const [addFileList, setAddFileList] = useState<UploadFile[]>([]);
  const [addDescList, setAddDescList] = useState<string[]>([]);
  const [updateDescList, setUpdateDescList] = useState<UpdateFileDescType[]>([]);
  const [deleteFileList, setDeleteFileList] = useState<DeleteFileType[]>([]);

  const navigate = useNavigator();

  // 브랜드 상세페이지에서 넘어오는 경우에만 존재함.
  const vendorId = queryString.parse(location.search).vendor as string;

  const [createVendorHistory, createVendorHistoryOpts] = useVendorHistoryCreateMutation({
    onCompleted: (data: CreateVendorHistory) => {
      const errors = data.vendorHistoryCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(vendorHistoryDetailsViewUrl(data.vendorHistoryCreate.vendorHistory.id));
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleBack = () => {
    navigate(vendorHistoryListUrl);
  };

  const handleVendorHistoryFileCreate = (data: VendorHistoryFileCreate) => {
    const errors = data.vendorHistoryFileCreate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [createVendorHistoryFile] = useCreateVendorHistoryFileMutation({
    onCompleted: handleVendorHistoryFileCreate,
  });

  const handVendorHistoryFileUpdate = (data: VendorHistoryFileUpdate) => {
    const errors = data.vendorHistoryFileUpdate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [updateVendorHistoryFile] = useUpdateVendorHistoryFileMutation({
    onCompleted: handVendorHistoryFileUpdate,
  });

  const handleVendorHistoryFileDelete = (data: VendorHistoryFileDelete) => {
    const errors = data.vendorHistoryFileDelete.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [deleteVendorHistoryFile] = useDeleteVendorHistoryFileMutation({
    onCompleted: handleVendorHistoryFileDelete,
  });

  const createVendorHistoryFiles = async (addFileList: UploadFile[], addDescList: string[], id) => {
    const length = addFileList?.length;
    for (let i = 0; i < length; i++) {
      await createVendorHistoryFile({
        variables: {
          input: {
            vendorHistory: id,
            file: addFileList[i].originFileObj,
            fileName: addFileList[i].name,
            description: addDescList[i],
          },
        },
      });
    }
  };

  const updateVendorHistoryFiles = async (updateDescList: UpdateFileDescType[]) => {
    const length = updateDescList?.length;
    for (let i = 0; i < length; i++) {
      const updateDesc = updateDescList[i];
      const { id, description } = updateDesc;
      await updateVendorHistoryFile({
        variables: {
          id,
          input: {
            description,
          },
        },
      });
    }
  };

  const deleteVendorHistoryFiles = async (deleteFileList: DeleteFileType[]) => {
    const length = deleteFileList?.length;
    for (let i = 0; i < length; i++) {
      const deleteFile = deleteFileList[i];
      const { id } = deleteFile;
      await deleteVendorHistoryFile({
        variables: {
          id,
        },
      });
    }
  };

  const handleSubmit = async (formData: VendorHistoryCreatePageFormData) => {
    const result = await createVendorHistory({
      variables: {
        input: {
          title: formData.title,
          content: JSON.stringify({
            content: formData.contentRaw,
          }),
          vendor: vendorId ? vendorId : formData.vendor,
        },
      },
    });
    await createVendorHistoryFiles(addFileList, addDescList, result.data.vendorHistoryCreate.vendorHistory.id);
    await updateVendorHistoryFiles(updateDescList);
    await deleteVendorHistoryFiles(deleteFileList);
    setAddFileList([]);
    setAddDescList([]);
    setUpdateDescList([]);
    setDeleteFileList([]);
    return result.data.vendorHistoryCreate.errors;
  };

  return (
    <>
      <WindowTitle title="협력사 운영 이력 생성" />
      <VendorHistoryCreatePage
        disabled={createVendorHistoryOpts.loading}
        vendorId={vendorId}
        errors={createVendorHistoryOpts.data?.vendorHistoryCreate.errors || []}
        saveButtonBar={createVendorHistoryOpts.status}
        onBack={handleBack}
        onSubmit={handleSubmit}
        uploadFileController={{
          addFileList,
          addDescList,
          updateDescList,
          deleteFileList,
          setAddFileList,
          setAddDescList,
          setUpdateDescList,
          setDeleteFileList,
        }}
      />
    </>
  );
};
</file>

<file path="src/app/views/purchase/vendors/views/vendorHistory/views/VendorHistoryDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import DialogContentText from "@material-ui/core/DialogContentText";
import ActionDialog from "@src/app/components/ActionDialog";
import { convertMarkdownToContentJsonStr } from "@src/app/components/Editor/utils";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { DeleteFileType, UpdateFileDescType } from "@src/app/components/UploadFiles";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { UploadFile } from "antd";
import React, { useState } from "react";

import {
  useCreateVendorHistoryFileMutation,
  useDeleteVendorHistoryFileMutation,
  useUpdateVendorHistoryFileMutation,
  useVendorHistoryDeleteMutation,
  useVendorHistoryUpdateMutation,
} from "../api/mutations";
import { useVendorHistoryQuery } from "../api/queries";
import { DeleteVendorHistory } from "../api/types/DeleteVendorHistory";
import { UpdateVendorHistory } from "../api/types/UpdateVendorHistory";
import { VendorHistoryFileCreate } from "../api/types/VendorHistoryFileCreate";
import { VendorHistoryFileDelete } from "../api/types/VendorHistoryFileDelete";
import { VendorHistoryFileUpdate } from "../api/types/VendorHistoryFileUpdate";
import VendorHistoryDetailsPage, { VendorHistoryDetailsPageFormData } from "../components/VendorHistoryPage";
import { vendorHistoryDetailsViewUrl, vendorHistoryListUrl } from "../urls";

export interface VendorHistoryDetailsViewProps {
  id: string;
}

enum VendorHistoryModalModeEnum {
  Remove = "Remove",
}

export const VendorHistoryDetailsView: React.FC<VendorHistoryDetailsViewProps> = ({ id }) => {
  const [addFileList, setAddFileList] = useState<UploadFile[]>([]);
  const [addDescList, setAddDescList] = useState<string[]>([]);
  const [updateDescList, setUpdateDescList] = useState<UpdateFileDescType[]>([]);
  const [deleteFileList, setDeleteFileList] = useState<DeleteFileType[]>([]);

  const navigate = useNavigator();

  const [updateVendorHistory, updateVendorHistoryOpts] = useVendorHistoryUpdateMutation({
    onCompleted: (data: UpdateVendorHistory) => {
      const errors = data.vendorHistoryUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(vendorHistoryDetailsViewUrl(id));
      } else {
        showGqlErrors(errors);
      }
    },
  });
  const handleDeleteSuccess = (data: DeleteVendorHistory) => {
    const errors = data.vendorHistoryDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(vendorHistoryListUrl);
    } else {
      showGqlErrors(errors);
    }
  };

  const [deleteVendorHistory, deleteVendorHistoryOpts] = useVendorHistoryDeleteMutation({
    onCompleted: handleDeleteSuccess,
  });

  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const openModalWithoutNavigate = (madalMode: VendorHistoryModalModeEnum) => {
    setModalMode(madalMode);
  };

  const handleBack = () => {
    navigate(vendorHistoryListUrl);
  };

  const { data: vendorHistoryDetails, loading } = useVendorHistoryQuery({
    skip: id === undefined,
    variables: {
      id,
    },
  });

  const vendorHistory = vendorHistoryDetails?.vendorHistory;
  if (vendorHistory === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  const handleVendorHistoryFileCreate = (data: VendorHistoryFileCreate) => {
    const errors = data.vendorHistoryFileCreate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [createVendorHistoryFile] = useCreateVendorHistoryFileMutation({
    onCompleted: handleVendorHistoryFileCreate,
  });

  const handVendorHistoryFileUpdate = (data: VendorHistoryFileUpdate) => {
    const errors = data.vendorHistoryFileUpdate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [updateVendorHistoryFile] = useUpdateVendorHistoryFileMutation({
    onCompleted: handVendorHistoryFileUpdate,
  });

  const handleVendorHistoryFileDelete = (data: VendorHistoryFileDelete) => {
    const errors = data.vendorHistoryFileDelete.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [deleteVendorHistoryFile] = useDeleteVendorHistoryFileMutation({
    onCompleted: handleVendorHistoryFileDelete,
  });

  const createVendorHistoryFiles = async (addFileList: UploadFile[], addDescList: string[]) => {
    const length = addFileList?.length;
    for (let i = 0; i < length; i++) {
      await createVendorHistoryFile({
        variables: {
          input: {
            vendorHistory: id,
            file: addFileList[i].originFileObj,
            fileName: addFileList[i].name,
            description: addDescList[i],
          },
        },
      });
    }
  };

  const updateVendorHistoryFiles = async (updateDescList: UpdateFileDescType[]) => {
    const length = updateDescList?.length;
    for (let i = 0; i < length; i++) {
      const updateDesc = updateDescList[i];
      const { id, description } = updateDesc;
      await updateVendorHistoryFile({
        variables: {
          id,
          input: {
            description,
          },
        },
      });
    }
  };

  const deleteVendorHistoryFiles = async (deleteFileList: DeleteFileType[]) => {
    const length = deleteFileList?.length;
    for (let i = 0; i < length; i++) {
      const deleteFile = deleteFileList[i];
      const { id } = deleteFile;
      await deleteVendorHistoryFile({
        variables: {
          id,
        },
      });
    }
  };

  const handleSubmit = async (formData: VendorHistoryDetailsPageFormData) => {
    await createVendorHistoryFiles(addFileList, addDescList);
    await updateVendorHistoryFiles(updateDescList);
    await deleteVendorHistoryFiles(deleteFileList);
    setAddFileList([]);
    setAddDescList([]);
    setUpdateDescList([]);
    setDeleteFileList([]);

    const result = await updateVendorHistory({
      variables: {
        id,
        input: {
          title: formData.title,
          content: convertMarkdownToContentJsonStr(formData.contentRaw),
        },
      },
    });
    return result.data.vendorHistoryUpdate.errors;
  };

  return (
    <>
      <WindowTitle title="협력사 이력 조회" />
      {vendorHistory && (
        <>
          <VendorHistoryDetailsPage
            vendorHistory={maybe(() => vendorHistory)}
            disabled={loading || updateVendorHistoryOpts.loading || deleteVendorHistoryOpts.loading}
            errors={updateVendorHistoryOpts.data?.vendorHistoryUpdate.errors || []}
            saveButtonBar={updateVendorHistoryOpts.status}
            onBack={handleBack}
            onSubmit={handleSubmit}
            onDelete={() => openModalWithoutNavigate(VendorHistoryModalModeEnum.Remove)}
            uploadFileController={{
              addFileList,
              addDescList,
              updateDescList,
              deleteFileList,
              setAddFileList,
              setAddDescList,
              setUpdateDescList,
              setDeleteFileList,
            }}
          />
          <ActionDialog
            confirmButtonState={deleteVendorHistoryOpts.status}
            onClose={resetForCloseModal}
