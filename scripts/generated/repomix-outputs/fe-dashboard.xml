<file path="src/app/views/brand/brandStore/components/BsOpsRecheckReportItemListPage/filters.ts">
import { BsOpsRecheckReportItemStatusEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { bsOpsRecheckReportItemStatusChoices } from "../../utils";

export enum BsOpsRecheckReportItemListFilterKeys {
  status = "status",
  reportSearch = "reportSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  created = "created",
  submittedAt = "submittedAt",
  completedAt = "completedAt",
}

export interface BsOpsRecheckReportItemListFilterOpts {
  status: FilterOpts<BsOpsRecheckReportItemStatusEnum[]>;
  reportSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  submittedAt: FilterOpts<MinMax>;
  completedAt: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: BsOpsRecheckReportItemListFilterOpts,
  isStaff: boolean
): IFilter<BsOpsRecheckReportItemListFilterKeys> {
  let filterStructure = [];

  const statusFilter = {
    ...createOptionsField(
      0,
      BsOpsRecheckReportItemListFilterKeys.status,
      "상태",
      opts.status.value,
      true,
      bsOpsRecheckReportItemStatusChoices
    ),
    active: opts.status.active,
  };
  const reportSearchFilter = {
    ...createTextField(0, BsOpsRecheckReportItemListFilterKeys.reportSearch, "제목", opts.reportSearch.value),
    active: opts.reportSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      0,
      BsOpsRecheckReportItemListFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      0,
      BsOpsRecheckReportItemListFilterKeys.brandStoreSearch,
      "매장코드 / 매장명",
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const createdFilter = {
    ...createDateField(0, BsOpsRecheckReportItemListFilterKeys.created, "생성일", opts.created.value),
    active: opts.created.active,
  };
  const submittedAtFilter = {
    ...createDateField(0, BsOpsRecheckReportItemListFilterKeys.submittedAt, "제출일", opts.submittedAt.value),
    active: opts.submittedAt.active,
  };
  const completedAtFilter = {
    ...createDateField(0, BsOpsRecheckReportItemListFilterKeys.completedAt, "완료일", opts.completedAt.value),
    active: opts.completedAt.active,
  };

  filterStructure = [
    statusFilter,
    reportSearchFilter,
    isStaff && brandSearchFilter,
    brandStoreSearchFilter,
    createdFilter,
    submittedAtFilter,
    completedAtFilter,
  ].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
</file>

