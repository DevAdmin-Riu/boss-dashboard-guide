      gte: params.orderCapturedAtTimeFrom,
      lte: params.orderCapturedAtTimeTo,
    }),
    orderSearch: params.orderSearch,
    b2bOrderSearch: params.b2bOrderSearch,
    paymentSearch: params.paymentSearch,
    userSearch: params.userSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
    productSearch: params.productSearch,
    fulfillVendorSearch: params.fulfillVendorSearch,
    shippingAddress: params.shippingAddress,
    isPickingOrder: false,
    isFulfilledByVendor: false,
    status: [FulfillmentStatusFilter.FULFILLED],
    trackingCompleted: false,
    trackingNumber: params.trackingNumber,
    orderType: maybe(() => params.orderType.map((status) => findInEnum(status, OrderTypeEnum))),
