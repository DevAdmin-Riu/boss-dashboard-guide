export interface OrderLineListFilterOpts {
  orderStatus: FilterOpts<OrderStatusFilter[]>;
  isByNonCourier: FilterOpts<boolean>;
  orderCreated: FilterOpts<MinMax>;
  orderCapturedAt: FilterOpts<MinMax>;
  purchaseOrderDate: FilterOpts<MinMax>;
  askingPurchaseDate: FilterOpts<MinMax>;
  expectedPurchaseDate: FilterOpts<MinMax>;
  fulfillmentCreated: FilterOpts<MinMax>;
  orderDeliveryRequestDate: FilterOpts<MinMax>;
  orderEstimatedArrivalDate: FilterOpts<MinMax>;
  isTaxFree: FilterOpts<boolean>;
  useAutoConsignmentPo: FilterOpts<boolean>;
  isTrackInventoryFulfillment: FilterOpts<boolean>;
  vendorContactType: FilterOpts<VendorContactTypeEnum[]>;
  purchaseOrderEventType: FilterOpts<PurchaseOrderEventTypeFilter[]>;
  orderType: FilterOpts<OrderTypeEnum[]>;
  b2bStatus: FilterOpts<OrderLineB2bStatusEnum[]>;
  orderSearch: FilterOpts<string>;
  b2bOrderSearch: FilterOpts<string>;
  purchaseOrderSearch: FilterOpts<string>;
