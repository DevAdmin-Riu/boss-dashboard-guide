  return {
    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, false),
    },
    productExclusive: {
      active: maybe(() => !utils.isEmpty(filterVariables.productExclusive), false),
      value: maybe(() => filterVariables.productExclusive, true),
    },
    brandIsRunning: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandIsRunning), false),
      value: maybe(() => filterVariables.brandIsRunning, false),
    },
    pvSalesStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.pvSalesStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.pvSalesStatus), []),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: filterVariables.brandProductSearch || "",
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
  };
