import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  StockDetailEventListForLabelFilterKeys,
  StockDetailEventListForLabelFilterOpts,
} from "../../components/StockDetailEventListForLabelPage/filters";
import {
  StockDetailEventListForLabelViewUrlFilters,
  StockDetailEventListForLabelViewUrlFiltersEnum,
  StockDetailEventListForLabelViewUrlFiltersWithMultipleValuesEnum,
  StockDetailEventListForLabelViewUrlQueryParams,
} from "../../urls";

const STOCK_DETAIL_EVENT_FOR_LABEL_FILTERS_KEY = "stockDetailEventForLabelFilters";

export function getFilterOpts(
  params: StockDetailEventListForLabelViewUrlFilters
): StockDetailEventListForLabelFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => dedupeFilter(filterVariables.type), []),
    },
    stockedDate: {
      active: maybe(
        () => [filterVariables.stockedDate.gte, filterVariables.stockedDate.lte].some((field) => !utils.isEmpty(field)),
        false
      ),
      value: {
        max: maybe(() => filterVariables.stockedDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.stockedDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, null),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, null),
    },
  };
}

export function getFilterVariables(params: StockDetailEventListForLabelViewUrlFilters): StockDetailEventFilterInput {
  return {
    type: maybe(() => params.type.map((type) => findInEnum(type, StockDetailEventsEnum))),
    stockedDate: getGteLteVariables({ gte: params.stockedDateFrom, lte: params.stockedDateTo }),
    productSearch: params.productSearch,
    vendorSearch: params.vendorSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<StockDetailEventListForLabelFilterKeys>
): StockDetailEventListForLabelViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case StockDetailEventListForLabelFilterKeys.stockedDate:
      return getMinMaxQueryParam(
        filter,
        StockDetailEventListForLabelViewUrlFiltersEnum.stockedDateFrom,
        StockDetailEventListForLabelViewUrlFiltersEnum.stockedDateTo
      );
    case StockDetailEventListForLabelFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, StockDetailEventListForLabelViewUrlFiltersEnum.productSearch);
    case StockDetailEventListForLabelFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, StockDetailEventListForLabelViewUrlFiltersEnum.vendorSearch);
    case StockDetailEventListForLabelFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        StockDetailEventListForLabelViewUrlFiltersWithMultipleValuesEnum.type,
        StockDetailEventsEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<StockDetailEventListForLabelViewUrlFilters>(STOCK_DETAIL_EVENT_FOR_LABEL_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  StockDetailEventListForLabelViewUrlQueryParams,
  StockDetailEventListForLabelViewUrlFilters
>({
  ...StockDetailEventListForLabelViewUrlFiltersEnum,
  ...StockDetailEventListForLabelViewUrlFiltersWithMultipleValuesEnum,
});
</file>

