import { showNotificationError } from "@utils/notification/wrapper";
import { Card, Form, Input, Modal, Typography } from "antd";
import React from "react";

interface ReqFbvProductStatusRejectModalProps {
  open: boolean;
  onClose: () => void;
  onOk: (reason: string) => void;
}

const ReqFbvProductStatusRejectModal: React.FC<ReqFbvProductStatusRejectModalProps> = (props) => {
  const { open, onClose, onOk } = props;
  const [form] = Form.useForm();

  const closeEvent = () => {
    form.resetFields();
    onClose();
  };
  return (
    <Modal
      closable={false}
      destroyOnClose={true}
      open={open}
      onCancel={closeEvent}
      onOk={() => {
        const reason = form.getFieldValue("reason").trim();
        if (reason.length < 10) {
          showNotificationError("반려 사유는 최소 10자 이상이어야 합니다.");
          return;
        }
        onOk(reason);
        closeEvent();
      }}
      maskClosable={false}
    >
      <Form form={form}>
        <Card title={<Typography.Text>최종확인</Typography.Text>}>
          <Typography.Text>반려 사유를 입력해주세요.</Typography.Text>
          <Form.Item name="reason">
            <Input.TextArea />
          </Form.Item>
        </Card>
      </Form>
    </Modal>
  );
};

export default ReqFbvProductStatusRejectModal;
</file>

