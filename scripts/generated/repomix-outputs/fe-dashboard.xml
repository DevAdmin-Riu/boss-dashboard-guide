              title={tableTitle}
              dataSource={[selectedRow]}
              columns={columnsForCreateConfirm}
            />
          </Form>
        );
      case MileageSettlementListConfirmModalModeEnum.CreateBulkData:
        return (
          <Form name="mileage-settlement-bulk-create-form" form={formForCreate} onFinish={handleBulkCreate}>
            <PatchedColumnsTable<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node>
              {...commonTableProps}
              title={tableTitle}
              dataSource={selectedRows}
              columns={columnsForCreateConfirm}
              footer={() => (
                <Form.List
                  name={TypeSafeFormForCreate.getValidDataIndex("inputList")}
                  rules={[
                    {
                      validator: () => {
                        const uniqueBrandList = [];
                        const duplicatedBrandList = [];
                        const makeCombinedText = (
                          brand: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node["brand"]
                        ) => `${brand.name}(${brand.code})`;

                        selectedRows.forEach((row, idx) => {
                          const { brand } = row;
                          if (utils.isEmpty(brand)) {
                            return;
                          }
                          const combinedText = makeCombinedText(brand);
                          if (uniqueBrandList.includes(combinedText)) {
                            if (duplicatedBrandList.includes(combinedText) === false) {
                              duplicatedBrandList.push(combinedText);
                            }
                          } else {
                            uniqueBrandList.push(combinedText);
                          }
                        });
                        if (duplicatedBrandList.length > 0) {
                          return Promise.reject(
                            new Error(
                              `브랜드별로 한 번에 1건씩만 확정 가능합니다. (중복된 브랜드: ${duplicatedBrandList.join(
                                ", "
                              )})`
                            )
                          );
                        }
                        return Promise.resolve();
                      },
                    },
                  ]}
                >
                  {(_, __, { errors }) => <Form.ErrorList errors={errors} />}
                </Form.List>
              )}
            />
          </Form>
        );
      default:
        return null;
    }
  };

  const makeConfirmContentNodeForReviewing = () => {
    // selectedRowId 를 이용해 dataSource에서 값을 찾은다음 mileageInfo를 리턴한다.
    const data = dataSource.find((data) => data.id === selectedRowId);
    const settlementAccountInfo = data?.brand?.settlementAccountInfo;
    const taxInvoiceImageByHqStaffUrl = data?.taxInvoiceImageByHqStaffUrl;
    return (
      <>
        <Space direction="vertical" size="small">
          <Descriptions
