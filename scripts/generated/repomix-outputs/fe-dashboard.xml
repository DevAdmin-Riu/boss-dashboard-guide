import { MinusCircleOutlined, PlusCircleOutlined } from "@ant-design/icons";
import { commonMsg } from "@assets/messages/commonMsg";
import useNavigator from "@hooks/useNavigator";
import {
  BrandCreateDevCostEventInput,
  BrandDevCostEventType,
  BrandDevCostEventTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import {
  getFormInputNumberMaxValueRule,
  getFormInputNumberMinValueRule,
} from "@src/app/components/antd/Form/validators";
import { getIconProps } from "@src/app/components/antd/Icon/IconProps";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { useBrandCreateDevCostEventMutation } from "@src/app/views/brand/brands/api/mutations";
import { devCostEventListQuery, useDevCostEventListQuery } from "@src/app/views/brand/devCost/api/queries";
import { getDevCostEventTableColumns } from "@src/app/views/brand/devCost/components/DevCostEventListPage/DevCostEventTableSettings";
import { devCostEventListViewUrl } from "@src/app/views/brand/devCost/urls";
import { findValueInEnum } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Form, Input, InputNumber, Modal, Space, Table, Typography } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect, useRef, useState } from "react";

import { checkIsDecreaseDevCostEvent } from "../../devCost/utils";
import { BrandDetails_brand } from "../api/types/BrandDetails";

interface BrandDevCostTableProps {
  brand: Pick<BrandDetails_brand, "id" | "code">;
}

const BrandDevCostTable: React.FC<BrandDevCostTableProps> = (props) => {
  const { brand } = props;
  const [open, setOpen] = useState(false);
  const [openConfirmModal, setOpenConfirmModal] = useState(false);

  const [form] = useForm<BrandCreateDevCostEventInput>();
  const TypeSafeForm = getTypeSafeForm<BrandCreateDevCostEventInput>(form);
  const type = TypeSafeForm.getUseFormWatched({ name: "type" });
  const qty = TypeSafeForm.getUseFormWatched({ name: "qty" });
  const [remainDevCost, setRemainDevCost] = useState<number>(0);
  const InputNumRef = useRef();
  const { data } = useDevCostEventListQuery({ variables: { first: 5, filter: { brand: brand?.id } } });
  const isDecreaseMode = utils.isEmpty(type)
    ? null
    : checkIsDecreaseDevCostEvent(findValueInEnum(type, BrandDevCostEventType));
  const typeText = isDecreaseMode ? "차감" : "추가";

  useEffect(() => {
    if (data?.brandDevCostEvents?.edges?.length > 0) {
      setRemainDevCost(data?.brandDevCostEvents?.edges[0].node.qtyAfter);
    }
  }, [data]);

  const navigate = useNavigator();
  const [brandCreateDevCostEvent, {}] = useBrandCreateDevCostEventMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandCreateDevCostEvent.errors, `기타 비용 ${typeText} 완료`, () => {
        setOpen(false);
      }),
    refetchQueries: [devCostEventListQuery],
  });
  const devCostEventList = data?.brandDevCostEvents?.edges?.map((devCostEvent) => devCostEvent.node);
  const cardTitle = (
    <>
      <Space size="small" align="center">
        <Button
          shape="circle"
          type="text"
          disabled={remainDevCost === 0}
          onClick={() => {
            form.resetFields();
            TypeSafeForm.setFields([{ name: "type", value: BrandDevCostEventTypeEnum.DECREASE }]);
            setOpen(true);
          }}
        >
          <MinusCircleOutlined {...getIconProps({ size: 22 })} />
        </Button>
        <Button
          shape="circle"
          type="text"
          onClick={() => {
            form.resetFields();
            TypeSafeForm.setFields([{ name: "type", value: BrandDevCostEventTypeEnum.INCREASE }]);
            setOpen(true);
          }}
        >
          <PlusCircleOutlined {...getIconProps({ size: 22 })} />
        </Button>
        <Typography.Link
          strong
          onClick={() => {
            navigate(devCostEventListViewUrl({ brandSearch: brand?.code }));
          }}
        >
          모든 내역 보기
        </Typography.Link>
      </Space>
    </>
  );

  const columns = getDevCostEventTableColumns({ onRowClick: null }, false);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const qtyFormLabel = (
    <Typography>
      {`${typeText} 금액`}
      <Typography.Text strong type="danger">
        {commonMsg.includeVat}
      </Typography.Text>
    </Typography>
  );

  return (
    <>
      <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
        <TableVatLegend size="small" />
        <Table {...commonTableProps} columns={columns} dataSource={devCostEventList} scroll={{ x: tableWidthSum }} />
      </Card>
      <Modal
        forceRender
        closable={false}
        onOk={() => setOpenConfirmModal(true)}
        onCancel={() => setOpen(false)}
        open={open}
        title={`기타 비용 ${typeText}`}
        okText="확인"
        cancelText="뒤로"
        okButtonProps={{
          disabled: qty === undefined || qty <= 0,
        }}
        maskClosable={false}
      >
        <Form form={form} colon={false} labelCol={{ span: 24 }} wrapperCol={{ span: 24 }}>
          <Form.Item hidden name={TypeSafeForm.getValidDataIndex("type")}>
            <Input />
          </Form.Item>
          <Form.Item shouldUpdate>
            {() => {
              const max = isDecreaseMode ? remainDevCost : Infinity;
              return (
                <Form.Item
                  labelCol={{ span: 24 }}
                  wrapperCol={{ span: 24 }}
                  rules={[
                    { required: true },
                    { type: "integer" },
                    getFormInputNumberMinValueRule({ min: 1 }),
                    getFormInputNumberMaxValueRule({ max }),
                  ]}
                  name={TypeSafeForm.getValidDataIndex("qty")}
                  label={qtyFormLabel}
                >
                  <InputNumber
                    ref={InputNumRef}
                    placeholder="부가세 포함 금액으로 입력해 주세요."
                    {...getInputNumberProps({
                      isCommaDisplay: true,
                      dynamicValidate: {
                        ref: InputNumRef.current,
                        setValue: (value) => {
                          if (value > max) {
                            value = max;
                          }
                          TypeSafeForm.setFields([{ name: "qty", value }]);
                        },
                      },
                    })}
                  />
                </Form.Item>
              );
            }}
          </Form.Item>
          <Form.Item name={TypeSafeForm.getValidDataIndex("description")} label="상세내용">
            <Input.TextArea placeholder="상세내용을 입력해 주세요." />
          </Form.Item>
          {openConfirmModal && (
            <ConfirmModal
              visible={openConfirmModal}
              onOk={() => {
                brandCreateDevCostEvent({ variables: { brandId: brand?.id, input: form.getFieldsValue(true) } });
                setOpenConfirmModal(false);
              }}
              onCancel={() => setOpenConfirmModal(false)}
            />
          )}
        </Form>
      </Modal>
    </>
  );
};

export default BrandDevCostTable;
</file>

