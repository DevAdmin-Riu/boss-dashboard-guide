  columns.push({
    title: "판매수량",
    key: "quantity",
    align: "center",
    width: 100,
    render: (_, record) => <NumberComponent value={record.quantity} />,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const handleClose = () => {
    onClose();
  };

  const { data } = useOrdersForHqUserStatsQuery({
