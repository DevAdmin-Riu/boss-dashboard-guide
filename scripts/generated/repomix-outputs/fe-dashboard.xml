import { Vendors, VendorsVariables } from "./types/Vendors";

export const vendorListQuery = gql`
  ${pageInfoFragment}
  ${vendorFragmentForList}
  query Vendors(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: VendorFilterInput
    $sort: VendorSortingInput
  ) {
    vendors(first: $first, after: $after, last: $last, before: $before, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...VendorFragmentForList
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const useVendorListQuery = makeQuery<Vendors, VendorsVariables>(vendorListQuery);
export const useVendorListFilterDownloadQuery = makeLazyQuery<Vendors, VendorsVariables>(vendorListQuery, "no-cache");

export const vendorQuery = gql`
  ${vendorFragment}
  query Vendor($id: ID!) {
    vendor(id: $id) {
      ...VendorFragment
    }
  }
`;
export const useVendorQuery = makeQuery<Vendor, VendorVariables>(vendorQuery);

// 가맹본부 어드민에서 협력사 별 매입/지급 내역 리스트에서 필요한 협력사 정보를 조회하기 위한 쿼리
