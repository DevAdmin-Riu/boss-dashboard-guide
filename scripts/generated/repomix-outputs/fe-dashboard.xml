      opts.sameOrReplacementSearch.value
    ),
    active: opts.sameOrReplacementSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(0, PvEstimateListFilterKeys.productSearch, "제품코드/제품명", opts.productSearch.value),
