import { PlusOutlined } from "@ant-design/icons";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { formItemPropsForFileListUpload } from "@src/app/components/antd/Form/FormProps";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { transformIsExclusive } from "@utils/misc";
import { utils } from "@utils/utils";
import { Col, Form, Input, InputNumber, Radio, Row, Space, Switch, Typography, Upload, UploadProps } from "antd";
import { TextProps } from "antd/lib/typography/Text";
import React from "react";

import {
  reqBossProductEstMonthlyQtyUnitType,
  reqBossProductQtyPerBoxUnitType,
  transformReqByProductVariant,
} from "../utils";

const { Title, Text } = Typography;
const { Item: FItem } = Form;

const commonTextProps: TextProps = { type: "warning", strong: true, style: { fontSize: "12px" } };

export const makeIsExclusiveFormItem = () => (
  <FItem
    style={{ margin: 0 }}
    name="isExclusive"
    rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
    label={<Title level={5}>상품 종류 선택</Title>}
  >
    <Radio.Group>
      <Space style={{ marginTop: 12 }} direction="vertical">
        <Radio value={true}>
          <MultiLineTypography
            lines={[
              transformIsExclusive(true),
              <Text {...commonTextProps}>
                브랜드 로고, 이미지 컬러 등 브랜드 고유 디자인이나 규격이 필요한 경우 전용 상품으로 요청해 주세요.
              </Text>,
            ]}
          />
        </Radio>
        <Radio value={false}>
          <MultiLineTypography
            lines={[
              transformIsExclusive(false),
              <Text {...commonTextProps}>고유 디자인이나 규격이 필요 없는 경우 범용 상품으로 요청해 주세요.</Text>,
            ]}
          />
        </Radio>
      </Space>
    </Radio.Group>
  </FItem>
);

export const makeByProductVariantFormItem = (isExclusive: boolean) => (
  <FItem
    style={{ margin: 0 }}
    name="byProductVariant"
    hidden={isExclusive ?? true}
    rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
    label={<Title level={5}>요청 방식 선택</Title>}
  >
    <Radio.Group>
      <Space style={{ marginTop: 12 }} direction="vertical">
        <Radio value={true}>
          <MultiLineTypography
            lines={[
              transformReqByProductVariant(true),
              <Text {...commonTextProps}>
                포장보스가 취급하고 있는 상품 리스트에서 원하시는 상품과 유사한 상품을 찾아 등록 요청하실 수 있습니다.
              </Text>,
            ]}
          />
        </Radio>
        <Radio value={false}>
          <MultiLineTypography
            lines={[
              transformReqByProductVariant(false),
              <Text {...commonTextProps}>규격, 재질 등 상품 정보를 직접 입력해 요청하실 수 있습니다.</Text>,
            ]}
          />
        </Radio>
      </Space>
    </Radio.Group>
  </FItem>
);

export const makeDirectRequestFormItems = (isExclusive: boolean, imageUpdateProps?: UploadProps) => {
  // imageUpdateProps가 비어있으면 antd Form을 통해 수정, 아니면 RequestBossProductImageCreate, RequestBossProductImageDelete 뮤테이션 통한 업데이트
  const updateByMutation = utils.isEmpty(imageUpdateProps) === false;

  const commonUploadProps: UploadProps = {
    multiple: true,
    listType: "picture-card",
    customRequest: ({ onSuccess }) => {
      setTimeout(() => {
        onSuccess("ok");
      }, 0);
    },
    showUploadList: { showPreviewIcon: false },
    accept: "image/*",
  };

  const uploadButton = (
    <div>
      <PlusOutlined />
      <div style={{ marginTop: 4 }}>업로드</div>
    </div>
  );

  return (
    <Row gutter={[12, 0]}>
      <Col xs={24} sm={8}>
        <FItem label="상품명" name="productName" rules={[{ required: true, message: formRuleMsg.required }]}>
          <Input placeholder="매장에게 보여주고자 하는 상품명을 입력해주세요." />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="제조사" name="maker">
          <Input disabled={isExclusive} />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="제조사 모델번호" name="makerSku">
          <Input disabled={isExclusive} />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="규격" name="spec" rules={[{ required: true, message: formRuleMsg.required }]}>
          <Input />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="재질" name="material" rules={[{ required: true, message: formRuleMsg.required }]}>
          <Input />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="색상" name="color">
          <Input />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem
          label="입수량"
          name="qtyPerBox"
          rules={[
            ({ getFieldValue }) => ({
              validator(_, value) {
                if (utils.isEmpty(getFieldValue("estMonthlyQty")) === false && (utils.isEmpty(value) || value <= 0)) {
                  return Promise.reject("예상 월 사용량 입력 시, 1박스 당 입수량도 함께 입력해주세요.(최소 1 이상)");
                }
                return Promise.resolve();
              },
            }),
          ]}
        >
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            style={{ width: "100%" }}
            addonAfter={reqBossProductQtyPerBoxUnitType}
          />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="예상 월 사용량" name="estMonthlyQty">
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            style={{ width: "100%" }}
            addonAfter={reqBossProductEstMonthlyQtyUnitType}
          />
        </FItem>
      </Col>
      <Col xs={24} sm={8}>
        <FItem label="전자레인지 사용 여부" name="useMicrowave" valuePropName="checked">
          <Switch checkedChildren="ON" unCheckedChildren="OFF" />
        </FItem>
      </Col>
      <Col span={24}>
        <FItem label="디자인 요구 사항" name="designMemo">
          <Input.TextArea disabled={isExclusive === false} />
        </FItem>
      </Col>
      <Col span={24}>
        <FItem
          label="기능 요구 사항"
          name="functionMemo"
          rules={[{ required: isExclusive, message: formRuleMsg.required }]}
        >
          <Input.TextArea disabled={isExclusive === false} />
        </FItem>
      </Col>
      <Col span={24}>
        <FItem label="기타 참고 사항 (메모)" name="etcMemo">
          <Input.TextArea placeholder="요청하신 상품과 관련된 설명이나 참고할 수 있는 링크를 기재해 주세요." />
        </FItem>
      </Col>
      <Col span={24}>
        {/* 뮤테이션으로 직접 수정 시, 뮤테이션 호출 전에 이미지 개수 validate 하고 있으므로 Form.Item에 rules와 같은 props 전달할 필요 없음 */}
        {updateByMutation ? (
          <FItem
            required
            label="상품 이미지"
            extra={
              <Text {...commonTextProps}>
                * 상품 섬네일 및 상세 정보 제작에 사용될 이미지를 첨부해주세요.(최대 3개)
              </Text>
            }
          >
            <Upload {...commonUploadProps} {...imageUpdateProps}>
              {uploadButton}
            </Upload>
          </FItem>
        ) : (
          <FItem
            {...formItemPropsForFileListUpload}
            label="상품 이미지"
            name="imageList"
            extra={
              <Text {...commonTextProps}>
                * 상품 섬네일 및 상세 정보 제작에 사용될 이미지를 첨부해주세요.(최대 3개)
              </Text>
            }
            rules={[{ type: "array", max: 3, message: formRuleMsg.max(3, "개") }]}
          >
            <Upload {...commonUploadProps}>{uploadButton}</Upload>
          </FItem>
        )}
      </Col>
    </Row>
  );
};
