import { CreditsEventFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment/moment";

import { CreditsEventFilterKeys, CreditsEventListFilterOpts } from "../../components/CreditsEventListPage/filters";
import {
  CreditsEventListViewUrlFilters,
  CreditsEventListViewUrlFiltersEnum,
  CreditsEventListViewUrlQueryParams,
} from "../../urls";

const POINTS_EVENT_FILTERS_KEY = "pointsEventFilters";

export function getFilterOpts(params: CreditsEventListViewUrlFilters): CreditsEventListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  const veryOldMoment = moment("2020-01-01");

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, veryOldMoment.format(onlyDateFormat)),
      },
    },
    onlyRecentOnes: {
      active: maybe(() => !utils.isEmpty(filterVariables.onlyRecentOnes), false),
      value: maybe(() => filterVariables.onlyRecentOnes, true),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    bizRegNo: {
      active: maybe(() => !utils.isEmpty(filterVariables.bizRegNo, true), false),
      value: maybe(() => filterVariables.bizRegNo, ""),
    },
  };
}

export function getFilterVariables(params: CreditsEventListViewUrlFilters): CreditsEventFilterInput {
  return {
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    onlyRecentOnes: params.onlyRecentOnes !== undefined ? parseBoolean(params.onlyRecentOnes, false) : undefined,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    brandStoreSearch: params.brandStoreSearch !== undefined ? params.brandStoreSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    bizRegNo: params.bizRegNo !== undefined ? params.bizRegNo : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<CreditsEventFilterKeys>): CreditsEventListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case CreditsEventFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        CreditsEventListViewUrlFiltersEnum.createdFrom,
        CreditsEventListViewUrlFiltersEnum.createdTo
      );
    case CreditsEventFilterKeys.onlyRecentOnes:
      return getSingleValueQueryParam(filter, CreditsEventListViewUrlFiltersEnum.onlyRecentOnes);
    case CreditsEventFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, CreditsEventListViewUrlFiltersEnum.brandSearch);
    case CreditsEventFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, CreditsEventListViewUrlFiltersEnum.brandStoreSearch);
    case CreditsEventFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, CreditsEventListViewUrlFiltersEnum.userSearch);
    case CreditsEventFilterKeys.bizRegNo:
      return getSingleValueQueryParam(filter, CreditsEventListViewUrlFiltersEnum.bizRegNo);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<CreditsEventListViewUrlFilters>(POINTS_EVENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  CreditsEventListViewUrlQueryParams,
  CreditsEventListViewUrlFilters
>({ ...CreditsEventListViewUrlFiltersEnum });
