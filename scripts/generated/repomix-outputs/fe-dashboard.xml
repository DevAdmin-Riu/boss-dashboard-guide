    {
      title: columnNameConstant.vendor.CODE,
      align: "center",
      key: "vendorCode",
      width: 100,
      render: (_, record) => {
        const vendorData = JSON.parse(record.vendorData);
        return vendorData?.code || "-";
      },
    },
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      align: "left",
      key: "vendorName",
      width: 150,
      render: (_, record) => {
