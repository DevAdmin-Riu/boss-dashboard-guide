    case FbvBrandProductVariantListFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, FbvBrandProductVariantListViewUrlFiltersEnum.brandProductSearch);
    case FbvBrandProductVariantListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, FbvBrandProductVariantListViewUrlFiltersEnum.brandSearch);
    case FbvBrandProductVariantListFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, FbvBrandProductVariantListViewUrlFiltersEnum.vendorSearch);
    case FbvBrandProductVariantListFilterKeys.isTaxFree:
      return getSingleValueQueryParam(filter, FbvBrandProductVariantListViewUrlFiltersEnum.isTaxFree);
    case FbvBrandProductVariantListFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, FbvBrandProductVariantListViewUrlFiltersEnum.trackInventory);
    case FbvBrandProductVariantListFilterKeys.pvSalesStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        FbvBrandProductVariantListViewUrlFiltersWithMultipleValuesEnum.pvSalesStatus,
