export const getPurchaseOrderLineListTableSettings = (props: PurchaseOrderLineListTableSettingsProps) => {
  const {
    formValuesWatched,
    onRowClick,
    onOrderNumberClick,
    disabled,
    selectedPurchaseOrderLineId,
    onLineDelete,
    isEditing,
    onEdit,
    onSubmit,
    onCancel,
    onLinesCancel,
    onLinesSend,
    routeParams,
    courierDeliveryAdditionalFeeList,
    onLineReqSplitDelivery,
    onApproveReqSplitDeliveryButtonClick,
    onAttachDeliveryConfirmDocButtonClick,
    isB2b,
