export function getFilterVariables(
  params: OrderLineListViewUrlFilters,
  isB2b: boolean,
  pathname?: string
): OrderLineFilterInput {
  const { orderLineListViewType, orderLineListActionType, isByNonCourier } = params;
  // B2B도 위탁 주문이지만, 아래 isListViewConsignment는 B2B가 아닌 위탁인 경우를 뜻함
  const isListViewConsignment = checkIsListViewConsignment(orderLineListViewType);
  const isListViewFulfilledByVendor = checkIsListViewFulfilledByVendor(orderLineListViewType);

  const isListActionForPurchase = checkIsListActionForPurchase(orderLineListActionType);
  const isListActionForFulfill = checkIsListActionForFulfill(orderLineListActionType);
  const isListActionFulfilled = checkIsListActionFulfilled(orderLineListActionType);

  const courierDeliveryMethods = [OrderDeliveryMethodsEnum.BY_COURIER];
  const deliveryMethodFilterInputByParams: OrderLineFilterInput = utils.isEmpty(isByNonCourier)
    ? undefined
    : parseBoolean(isByNonCourier, false)
    ? { excludeDeliveryMethods: courierDeliveryMethods }
    : { deliveryMethods: courierDeliveryMethods };

  let isAdjustPriceFilter: boolean | undefined;

  if (isListActionForFulfill && isListViewConsignment && isB2b === false) {
    // 위탁 출고 지시 페이지인 경우
    if (pathname === orderLineListForFulfillViewPathByCourierPriceAdjust) {
      // 납품 시 금액 확정
      isAdjustPriceFilter = true;
    } else if (
      pathname === orderLineListForFulfillViewPathByCourier ||
      pathname === orderLineListForFulfillViewPathByNonCourier
    ) {
      // 일반 택배 또는 화물차
      isAdjustPriceFilter = false;
    }
  } else {
    // 출고 지시가 아닌 다른 페이지
    isAdjustPriceFilter = undefined;
  }

  const filterInputByAction: OrderLineFilterInput = isListViewFulfilledByVendor
    ? { fulfilled: false }
    : isListActionForPurchase
    ? { existPurchaseOrderLine: false, fulfilled: false }
    : isListActionForFulfill
    ? {
        existPurchaseOrderLine: true,
        fulfilled: false,
        purchaseOrderLineStatus: [PurchaseOrderLineStatusEnum.RECEIVED],
        isAdjustPrice: isAdjustPriceFilter,
      }
    : isListActionFulfilled
    ? {
        existPurchaseOrderLine: true,
        fulfilled: true,
      }
    : {};

  return {
    orderStatus: maybe(() => params.orderStatus.map((status) => findValueInEnum(status, OrderStatusFilter))),
    orderType: maybe(() => params.orderType.map((orderType) => findInEnum(orderType, OrderTypeEnum))),
    isTrackInventoryFulfillment:
      isListViewConsignment || isB2b
        ? false
        : params.isTrackInventoryFulfillment !== undefined
        ? parseBoolean(params.isTrackInventoryFulfillment, false)
        : undefined,
    useDelegatedManagementForPo: isListViewConsignment && isListActionForFulfill && isB2b === false ? true : undefined,
    purchaseOrderEventType: maybe(() =>
      params.purchaseOrderEventType.map((eventType) => findInEnum(eventType, PurchaseOrderEventTypeFilter))
    ),
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    orderCapturedAt: getGteLteVariables({
      gte: params.orderCapturedAtFrom,
      lte: params.orderCapturedAtTo,
    }),
    purchaseOrderDate: getGteLteVariables({
      gte: params.purchaseOrderDateFrom,
      lte: params.purchaseOrderDateTo,
    }),
    askingPurchaseDate: getGteLteVariables({
      gte: params.askingPurchaseDateFrom,
      lte: params.askingPurchaseDateTo,
    }),
    expectedPurchaseDate: getGteLteVariables({
      gte: params.expectedPurchaseDateFrom,
      lte: params.expectedPurchaseDateTo,
    }),
    fulfillmentCreated: getGteLteVariables({
      gte: params.fulfillmentCreatedFrom,
      lte: params.fulfillmentCreatedTo,
    }),
    orderDeliveryRequestDate: getGteLteVariables({
      gte: params.orderDeliveryRequestDateFrom,
      lte: params.orderDeliveryRequestDateTo,
    }),
    orderEstimatedArrivalDate: getGteLteVariables({
      gte: params.orderEstimatedArrivalDateFrom,
      lte: params.orderEstimatedArrivalDateTo,
    }),
    isTaxFree: params.isTaxFree !== undefined ? parseBoolean(params.isTaxFree, false) : undefined,
    useAutoConsignmentPo:
      params.useAutoConsignmentPo !== undefined ? parseBoolean(params.useAutoConsignmentPo, false) : undefined,
    vendorContactType: maybe(() =>
      params.vendorContactType.map((contactType) => findInEnum(contactType, VendorContactTypeEnum))
    ),
    b2bStatus: maybe(() => params.b2bStatus.map((b2bStatus) => findInEnum(b2bStatus, OrderLineB2bStatusEnum)), []),
    orderSearch: params.orderSearch,
    b2bOrderSearch: params.b2bOrderSearch,
    purchaseOrderSearch: params.purchaseOrderSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
    userSearch: params.userSearch,
    productSearch: params.productSearch,
    brandProductSearch: params.brandProductSearch,
    purchaseVendorSearch: params.purchaseVendorSearch,
    fulfillVendorSearch: params.fulfillVendorSearch,
    isFulfilledByVendor: isListViewFulfilledByVendor,

    b2bPendingStatusAt: getGteLteVariables({
      gte: params.b2bPendingStatusAtFrom,
      lte: params.b2bPendingStatusAtTo,
    }),
    b2bRejectedStatusAt: getGteLteVariables({
      gte: params.b2bRejectedStatusAtFrom,
      lte: params.b2bRejectedStatusAtTo,
    }),
    b2bReceivedStatusAt: getGteLteVariables({
      gte: params.b2bReceivedStatusAtFrom,
      lte: params.b2bReceivedStatusAtTo,
    }),
    b2bCanceledStatusAt: getGteLteVariables({
      gte: params.b2bCanceledStatusAtFrom,
      lte: params.b2bCanceledStatusAtTo,
    }),
    b2bCompletedStatusAt: getGteLteVariables({
      gte: params.b2bCompletedStatusAtFrom,
      lte: params.b2bCompletedStatusAtTo,
    }),
    ...deliveryMethodFilterInputByParams,
    ...filterInputByAction,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof OrderLineListFilterOpts>
): OrderLineListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case OrderLineListFilterKeys.orderStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderLineListViewUrlFiltersWithMultipleValuesEnum.orderStatus,
        OrderStatusFilter
      );
    case OrderLineListFilterKeys.isByNonCourier:
      return getSingleValueQueryParam(filter, OrderLineListViewUrlFiltersEnum.isByNonCourier);
