import makeMutation from "@hooks/makeMutation";
import { bannerErrorFragment } from "@src/api/fragments/banner";
import { popupFragment } from "@src/api/fragments/popup";
import gql from "graphql-tag";

import { AssignBrandsToPopup, AssignBrandsToPopupVariables } from "./types/AssignBrandsToPopup";
import { CreatePopup, CreatePopupVariables } from "./types/CreatePopup";
import { UnassignBrandsFromPopup, UnassignBrandsFromPopupVariables } from "./types/UnassignBrandsFromPopup";
import { UpdatePopup, UpdatePopupVariables } from "./types/UpdatePopup";

const createPopup = gql`
  ${bannerErrorFragment}
  mutation CreatePopup($input: PopupInput!) {
    createPopup(input: $input) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      popup {
        id
      }
    }
  }
`;
export const useCreatePopupMutation = makeMutation<CreatePopup, CreatePopupVariables>(createPopup);

const updatePopup = gql`
  ${popupFragment}
  ${bannerErrorFragment}
  mutation UpdatePopup($id: ID!, $input: PopupInput!) {
    updatePopup(id: $id, input: $input) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      popup {
        ...PopupFragment
      }
    }
  }
`;
export const useUpdatePopupMutation = makeMutation<UpdatePopup, UpdatePopupVariables>(updatePopup);

const assignBrandsToPopup = gql`
  ${bannerErrorFragment}
  mutation AssignBrandsToPopup($popupId: ID!, $brands: [ID]!) {
    assignBrandsToPopup(popupId: $popupId, brands: $brands) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      popup {
        id
        availableBrands {
          id
        }
      }
    }
  }
`;
export const useAssignBrandsToPopupMutation = makeMutation<AssignBrandsToPopup, AssignBrandsToPopupVariables>(
  assignBrandsToPopup
);

const unassignBrandsFromPopup = gql`
  ${bannerErrorFragment}
  mutation UnassignBrandsFromPopup($popupId: ID!, $brands: [ID]!) {
    unassignBrandsFromPopup(popupId: $popupId, brands: $brands) {
      errors: bannerErrors {
        ...BannerErrorFragment
      }
      popup {
        id
        availableBrands {
          id
        }
      }
    }
  }
`;
export const useUnassignBrandsFromPopupMutation = makeMutation<
  UnassignBrandsFromPopup,
  UnassignBrandsFromPopupVariables
>(unassignBrandsFromPopup);
