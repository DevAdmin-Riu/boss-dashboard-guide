<file path="src/app/views/brand/brandStore/components/BrandStoreBulkCreateModal.tsx">
import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import {
  AddressInput,
  BrandStoreContractEnum,
  BrandStoreCreateInput,
  BrandStoreStatusEnum,
  BrandStoreTypeEnum,
  CountryCode,
} from "@src/api/types/globalTypes";
import { isValidEmail } from "@src/app/components/antd/Form/validators";
import { loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Form, Modal, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { useBrandStoreBulkCreateMutation } from "../../brands/api/mutations";
import { useBrandsCodeMapQuery } from "../../brands/api/queries";
import { brandStoreListQuery } from "../api/queries";
import { brandStoreContractChoices, brandStoreStatusChoices, brandStoreTypeChoices } from "../utils";

interface IBrandStoreTemplate {
  brandCode: string;
  firstName: string;
  brandStoreType: string;
  brandStoreStatus: string;
  aligoPhone: string;
  email: string;
  brandStoreContract: string;
  bizRegNo: string;
  bizRegCorpName: string;
  bizRegCeoName: string;
  bizRegBizType: string;
  bizRegBizClass: string;
  postalCode: string;
  streetAddress1: string;
  streetAddress2: string;
}

interface BrandStoreBulkCreateFormData {
  details: IBrandStoreTemplate[];
}

interface BrandStoreBulkCreateModalProps {
  open: boolean;
  disabled: boolean;
  onClose: () => void;
}

const convertBrandStoreType = (label: string): BrandStoreTypeEnum | null => {
  const choice = brandStoreTypeChoices.find((c) => c.label === label);
  return choice?.value || null;
};

const convertBrandStoreStatus = (label: string): BrandStoreStatusEnum | null => {
  const choice = brandStoreStatusChoices.find((c) => c.label === label);
  return choice?.value || null;
};

const convertBrandStoreContract = (label: string): BrandStoreContractEnum | null => {
  const choice = brandStoreContractChoices.find((c) => c.label === label);
  return choice?.value || null;
};

export const BrandStoreBulkCreateModal: React.FC<BrandStoreBulkCreateModalProps> = ({ open, disabled, onClose }) => {
  const [form] = Form.useForm<BrandStoreBulkCreateFormData>();
  const [selectedFile, setSelectedFile] = useState<string>(null);
  const [errorExist, setErrorExist] = useState<boolean>(false);
  const [formChanged, setFormChanged] = useState<boolean>(false);

  const detailsWatched = Form.useWatch("details", form);

  const [brandStoreBulkCreate, brandStoreBulkCreateOpts] = useBrandStoreBulkCreateMutation({
    refetchQueries: [brandStoreListQuery],
  });
  const [fetchBrandsCodeMap] = useBrandsCodeMapQuery();

  const resetFormAndFile = () => {
    form.resetFields();
    setSelectedFile(null);
    setErrorExist(false);
    setFormChanged(false);
  };

  const handleClose = () => {
    resetFormAndFile();
    onClose();
  };

  useEffect(() => {
    if (open) {
      resetFormAndFile();
    }
  }, [open]);

  const upload = React.useRef<HTMLInputElement>();
  const handleUploadButtonClick = () => upload.current.click();

  const showValidationError = (message: string) => {
    showNotificationError(message);
    setSelectedFile(undefined);
    setErrorExist(true);
  };

  const readUploadFile = (e: React.ChangeEvent<HTMLInputElement>) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const data = e.target.result;
          const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
          const worksheet = workbook.worksheets[0];
          if (!worksheet) {
            throw new Error("엑셀 파일에 시트가 존재하지 않습니다.");
          }
          const sheetName = worksheet.name;

          const targetVersion = excelTemplateVersion.brandStoreBulkCreate;
          if (utils.isEmpty(targetVersion) === false) {
            if (utils.validateTemplateVersion(sheetName, targetVersion) === false) {
              showValidationError("엑셀 템플릿 버전이 일치하지 않습니다.");
              return;
            }
          }

          const uploadedDetails = parseWorksheetToJsonArr<IBrandStoreTemplate>({ worksheet });
          if (uploadedDetails === undefined || uploadedDetails.length <= 0) {
            showValidationError("매장 생성을 위한 엑셀데이터에 데이터가 없거나 양식 오류로 처리할 수 없습니다.");
            return;
          }

          for (let i = 0; i < uploadedDetails.length; i++) {
            const detail = uploadedDetails[i];
            const rowNum = i + 1;

            if (utils.isEmpty(detail.brandCode, true)) {
              showValidationError(`${rowNum}번째 행: 브랜드코드를 입력해주세요.`);
              return;
            }

            if (utils.isEmpty(detail.firstName, true)) {
              showValidationError(`${rowNum}번째 행: 매장명을 입력해주세요.`);
              return;
            }

            if (utils.isEmpty(detail.aligoPhone, true)) {
              showValidationError(`${rowNum}번째 행: 연락처를 입력해주세요.`);
              return;
            }

            if (detail.email && !utils.isEmpty(detail.email, true)) {
              if (!isValidEmail(detail.email)) {
                showValidationError(`${rowNum}번째 행: 올바른 이메일 형식이 아닙니다. (입력값: ${detail.email})`);
                return;
              }
            }

            if (utils.isEmpty(detail.streetAddress1, true)) {
              showValidationError(`${rowNum}번째 행: 주소를 입력해주세요.`);
              return;
            }

            const postalCode = detail.postalCode;
            if (postalCode && (utils.isEmpty(postalCode, true) || String(postalCode).length !== 5)) {
              showValidationError(`${rowNum}번째 행: 우편번호를 확인해주세요. (입력값: ${postalCode})`);
              return;
            }

            if (!convertBrandStoreType(detail.brandStoreType)) {
              showValidationError(
                `${rowNum}번째 행: 유형이 올바르지 않습니다. (입력값: ${
                  detail.brandStoreType
                })\n가능한 값: ${brandStoreTypeChoices.map((c) => c.label).join(", ")}`
              );
              return;
            }

            if (!convertBrandStoreStatus(detail.brandStoreStatus)) {
              showValidationError(
                `${rowNum}번째 행: 상태가 올바르지 않습니다. (입력값: ${
                  detail.brandStoreStatus
                })\n가능한 값: ${brandStoreStatusChoices.map((c) => c.label).join(", ")}`
              );
              return;
            }

            if (!convertBrandStoreContract(detail.brandStoreContract)) {
              showValidationError(
                `${rowNum}번째 행: 계약이 올바르지 않습니다. (입력값: ${
                  detail.brandStoreContract
                })\n가능한 값: ${brandStoreContractChoices.map((c) => c.label).join(", ")}`
              );
              return;
            }
          }

          form.setFieldsValue({ details: uploadedDetails });
        } catch (error) {
          showNotificationError(`엑셀 파일 읽기 실패: ${error.message}`);
          setSelectedFile(undefined);
          setErrorExist(true);
        }
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
  };

  const handleSubmit = async (values: BrandStoreBulkCreateFormData) => {
    try {
      const uniqueBrandCodes = [...new Set(values.details.map((row) => row.brandCode))];
      const codesFilter = uniqueBrandCodes.join("\n");

      const { data: brandsData } = await fetchBrandsCodeMap({
        variables: {
          filter: {
            codes: codesFilter,
          },
        },
      });
      const brandCodeToIdMap = new Map<string, string>(brandsData.brands.edges.map(({ node }) => [node.code, node.id]));

      const transformedDetails: BrandStoreCreateInput[] = values.details.map((row) => {
        const brandId: string = brandCodeToIdMap.get(row.brandCode);

        if (!brandId) {
          showNotificationError(`잘못된 브랜드코드가 존재합니다.`);
          return;
        }

        const defaultShippingAddress: AddressInput | null = row.streetAddress1
          ? {
              country: CountryCode.KR,
              countryArea: row.streetAddress1?.split(" ")[0] || null,
              city: row.streetAddress1?.split(" ").slice(0, 2).join(" ") || null,
              postalCode: row.postalCode,
              streetAddress1: row.streetAddress1,
              streetAddress2: row.streetAddress2,
              firstName: row.firstName,
              phone: row.aligoPhone,
            }
          : null;

        const input: BrandStoreCreateInput = {
          brand: brandId,
          firstName: row.firstName,
          email: row.email,
          aligoPhone: row.aligoPhone,
          brandStoreName: row.firstName,
          brandStoreType: convertBrandStoreType(row.brandStoreType)!,
          brandStoreStatus: convertBrandStoreStatus(row.brandStoreStatus)!,
          brandStoreContract: convertBrandStoreContract(row.brandStoreContract)!,
          bizRegNo: row.bizRegNo,
          bizRegCorpName: row.bizRegCorpName,
          bizRegCeoName: row.bizRegCeoName,
          bizRegBizType: row.bizRegBizType,
          bizRegBizClass: row.bizRegBizClass,
          defaultShippingAddress,
        };

        return input;
      });

      const result = await brandStoreBulkCreate({
        variables: {
          input: {
            details: transformedDetails,
          },
        },
      });

      const errors = result.data?.brandStoreBulkCreate?.errors || [];
      if (errors.length > 0) {
        const errorMessages = errors.map((error) => error.message).join("\n");
        showNotificationError(errorMessages);
        return;
      }

      showNotificationSuccess("매장 일괄 생성이 완료되었습니다.");
      handleClose();
    } catch (error) {
      showNotificationError(`매장 일괄 생성 실패: ${error.message}`);
    }
  };

  return (
    <Modal
      destroyOnClose
      forceRender
      open={open}
      title="매장 일괄 생성"
      cancelText="취소"
      okText="생성"
      onOk={form.submit}
      okButtonProps={{
        disabled: disabled || utils.isEmpty(detailsWatched) || !formChanged,
        loading: brandStoreBulkCreateOpts.loading,
      }}
      onCancel={handleClose}
      maskClosable={false}
    >
      <Form
        form={form}
        name="brand-store-bulk-create-form"
        labelAlign="left"
        validateTrigger="onSubmit"
        onFinish={handleSubmit}
        labelCol={{ span: 4 }}
        wrapperCol={{ span: 20 }}
        onValuesChange={() => setFormChanged(true)}
      >
        <Form.Item
          name="details"
          label="매장 정보"
          rules={[
            {
              required: true,
              message: "생성할 매장 정보 엑셀 파일을 선택해 주세요",
            },
          ]}
        >
          <Space size="middle" direction="vertical">
            <Button onClick={handleUploadButtonClick} type="primary">
              생성할 매장 엑셀파일 선택
            </Button>
            {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
            {selectedFile && errorExist && (
              <Typography.Text type="warning">
                오류로 엑셀 파일을 수정한 경우 데이터 리로딩을 위해서 다시 엑셀 파일을 선택해 주세요.
              </Typography.Text>
            )}
            <input
              hidden={true}
              id="brandStoreBulkCreateInputFile"
              onChange={(e) => readUploadFile(e)}
              type="file"
              ref={upload}
              accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
            />
          </Space>
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BrandStoreConsultationCreateAndUpdateModal.tsx">
import { User } from "@src/api/fragments/types/User";
import useBrandStoreSearch from "@src/api/searches/useBrandStoreSearch";
import useBsOpsCheckReportSearch from "@src/api/searches/useBsOpsCheckReportSearch";
import { BrandStoreConsultationInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import ToastEditor from "@src/app/components/Editor/ToastEditor";
import { convertMarkdownToContentJsonStr, parseContentJsonStrToMarkdown } from "@src/app/components/Editor/utils";
import { getDateByFormat, ISOFormatWithTimeZone } from "@src/app/providers/DateProvider";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Col, DatePicker, Form, Input, Modal, Radio, Row, Select } from "antd";
import moment from "moment";
import React, { useEffect } from "react";

import { useBrandStoreConsultationCreateMutation, useBrandStoreConsultationUpdateMutation } from "../api/mutations";
import { brandStoreConsultationListQuery } from "../api/queries";
import { BrandStoreConsultationList_brandStoreConsultationList_edges_node } from "../api/types/BrandStoreConsultationList";
import { BrandStoreConsultationListModalModeEnum } from "../views/BrandStoreConsultationListView/BrandStoreConsultationListView";

enum ConsultationTypeEnum {
  GENERAL_CONSULTATION = "GENERAL_CONSULTATION",
  STORE_INSPECTION_CONSULTATION = "STORE_INSPECTION_CONSULTATION",
}

interface BrandStoreConsultationForm extends BrandStoreConsultationInput {
  consultationType: ConsultationTypeEnum;
}

interface BrandStoreConsultationCreateAndUpdateModalProps {
  open: boolean;
  onCancel: () => void;
  modalMode: BrandStoreConsultationListModalModeEnum;
  user: User;
  selectedRowRecord: BrandStoreConsultationList_brandStoreConsultationList_edges_node;
}

const BrandStoreConsultationCreateAndUpdateModal: React.FC<BrandStoreConsultationCreateAndUpdateModalProps> = (
  props
) => {
  const [form] = Form.useForm<BrandStoreConsultationForm>();
  const TypeSafeForm = getTypeSafeForm<BrandStoreConsultationForm>(form);
  const { open, onCancel, modalMode, user, selectedRowRecord } = props;

  const createMode = modalMode === BrandStoreConsultationListModalModeEnum.CREATE_MODE;
  const updateMode = modalMode === BrandStoreConsultationListModalModeEnum.UPDATE_MODE;

  const onEditorChange = (e: { target: { name: string; value: string } }) => {
    const { value } = e.target;
    TypeSafeForm.setFields([{ name: "content", value }]);
  };

  const formItemStyle: React.CSSProperties = {
    marginBottom: 0,
  };

  const consultationTypeWatched = TypeSafeForm.getUseFormWatched({
    name: "consultationType",
  });

  const brandStoreWatched = TypeSafeForm.getUseFormWatched({
    name: "brandStore",
  });

  useEffect(() => {
    if (createMode) {
      TypeSafeForm.setFields([{ name: "report", value: undefined }]);
    }
  }, [brandStoreWatched]);

  let title = "";
  if (createMode) {
    title = "상담 내역 생성";
  } else if (updateMode) {
    title = "상담 내역 조회/수정";
  }

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const {
    loadMore: brandStoresLoadMore,
    result: brandStores,
    search: searchBrandStores,
  } = useBrandStoreSearch({
    skip: !user?.brand?.id,
    variables: {
      first: 5,
      brandId: user?.brand?.id,
    },
  });
  const fetchMoreDataForBrandStores: FetchMoreProps = {
    hasMore: maybe(() => brandStores.data.search.pageInfo.hasNextPage),
    loading: brandStores.loading,
    onFetchMore: brandStoresLoadMore,
  };
  const brandStore = maybe(
    () => brandStores.data.search.edges.find((edge) => edge.node.id === brandStoreWatched)?.node
  );

  const {
    loadMore: reportLoadMore,
    result: reportResult,
    search: searchReport,
  } = useBsOpsCheckReportSearch({
    skip: !user?.brand?.code || !brandStore?.code,
    variables: {
      first: 5,
      brandSearch: user?.brand?.code,
      brandStoreSearch: brandStore?.code,
    },
  });
  const reportList = reportResult.data?.search?.edges?.map((edge) => edge.node);
  const reportOptionsBefore = reportList?.map((report) => ({
    label: `${report.title}${report.consultation?.id ? " (상담 내역 존재)" : ""}`,
    value: report.id,
    disabled: !!report.consultation?.id,
  }));
  const reportOptions = utils.getOptionsWithInitialValue(
    reportOptionsBefore || [],
    selectedRowRecord?.report?.id,
    selectedRowRecord?.report?.title
  );

  const fetchMoreReport: FetchMoreProps = {
    hasMore: maybe(() => reportResult.data.search.pageInfo.hasNextPage),
    loading: reportResult.loading,
    onFetchMore: reportLoadMore,
  };

  const [brandStoreConsultationCreate, brandStoreConsultationCreateOpts] = useBrandStoreConsultationCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data?.brandStoreConsultationCreate?.errors,
        "상담 내역이 생성되었습니다.",
        onCancel
      ),
    refetchQueries: [brandStoreConsultationListQuery],
  });

  const [brandStoreConsultationUpdate, brandStoreConsultationUpdateOpts] = useBrandStoreConsultationUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data?.brandStoreConsultationUpdate?.errors,
        "상담 내역이 수정되었습니다.",
        onCancel
      ),
  });

  const onFinish = (formData: BrandStoreConsultationForm) => {
    if (utils.isEmpty(formData.consultationDate)) {
      showNotificationError("상담일을 선택해주세요.");
      return;
    }
    if (utils.isEmpty(formData.brandStore)) {
      showNotificationError("매장을 선택해주세요.");
      return;
    }
    if (
      formData.consultationType === ConsultationTypeEnum.STORE_INSPECTION_CONSULTATION &&
      utils.isEmpty(formData.report)
    ) {
      showNotificationError("매장 점검 상담 유형을 선택하셨다면, 보고서를 선택해주세요.");
      return;
    }
    if (utils.isEmpty(formData.title)) {
      showNotificationError("제목을 입력해주세요.");
      return;
    }
    if (utils.isEmpty(formData.content)) {
      showNotificationError("상담 내용을 입력해주세요.");
      return;
    }

    if (createMode) {
      brandStoreConsultationCreate({
        variables: {
          input: {
            consultationDate: getDateByFormat(formData.consultationDate, ISOFormatWithTimeZone),
            brandStore: formData.brandStore,
            content: convertMarkdownToContentJsonStr(formData.content),
            title: formData.title,
            report: formData.report ? formData.report : undefined,
          },
        },
      });
    } else if (updateMode) {
      brandStoreConsultationUpdate({
        variables: {
          id: selectedRowRecord.id,
          input: {
            consultationDate: getDateByFormat(formData.consultationDate, ISOFormatWithTimeZone),
            brandStore: formData.brandStore,
            content: convertMarkdownToContentJsonStr(formData.content),
            title: formData.title,
          },
        },
      });
    }
  };

  const brandStoreOptionsBefore = brandStores.data?.search?.edges.map((edge) => ({
    label: `${edge.node.name}(${edge.node.code})`,
    value: edge.node.id,
  }));
  const brandStoreOptions = utils.getOptionsWithInitialValue(
    brandStoreOptionsBefore || [],
    selectedRowRecord?.brandStore?.id,
    selectedRowRecord?.brandStore?.name
  );

  const loading = brandStoreConsultationCreateOpts.loading || brandStoreConsultationUpdateOpts.loading;

  const isShowReportSelect = createMode || (updateMode && utils.isEmpty(selectedRowRecord?.report) === false);

  return (
    <Modal
      forceRender
      open={open}
      onCancel={onCancel}
      width={600}
      destroyOnClose
      title={title}
      okButtonProps={{ loading, disabled: loading }}
      cancelButtonProps={{ loading, disabled: loading }}
      onOk={() => TypeSafeForm.formInstance.submit()}
      maskClosable={false}
    >
      <Form
        form={form}
        layout="vertical"
        onFinish={onFinish}
        initialValues={{
          consultationType: ConsultationTypeEnum.GENERAL_CONSULTATION,
          consultationDate: moment(),
          brandStore: selectedRowRecord?.brandStore?.id || null,
          report: selectedRowRecord?.report?.id || null,
          title: selectedRowRecord?.title || "",
        }}
      >
        <Row gutter={[12, 12]}>
          <Col span={createMode ? 12 : 24}>
            <Form.Item
              style={formItemStyle}
              name={TypeSafeForm.getValidDataIndex("consultationDate")}
              label="상담일"
              rules={[{ required: true }]}
            >
              <DatePicker style={{ width: "100%" }} />
            </Form.Item>
          </Col>
          {createMode && (
            <Col span={12}>
              <Form.Item
                style={formItemStyle}
                name={TypeSafeForm.getValidDataIndex("consultationType")}
                label="상담 유형"
                rules={[{ required: true }]}
              >
                <Radio.Group
                  onChange={(e) => {
                    const value = e.target.value;
                    if (value === ConsultationTypeEnum.GENERAL_CONSULTATION) {
                      TypeSafeForm.setFields([{ name: "report", value: undefined }]);
                    }
                  }}
                >
                  <Radio value={ConsultationTypeEnum.GENERAL_CONSULTATION}>일반상담</Radio>
                  <Radio value={ConsultationTypeEnum.STORE_INSPECTION_CONSULTATION}>매장 점검 상담</Radio>
                </Radio.Group>
              </Form.Item>
            </Col>
          )}
          <Col span={24}>
            <Form.Item
              style={formItemStyle}
              name={TypeSafeForm.getValidDataIndex("brandStore")}
              label="매장"
              rules={[{ required: true }]}
            >
              <Select
                showSearch
                disabled={updateMode}
                filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                onSearch={searchBrandStores}
                loading={fetchMoreDataForBrandStores.loading}
                options={brandStoreOptions}
                onPopupScroll={fetchMoreDataForBrandStores.onFetchMore}
              />
            </Form.Item>
          </Col>
          {isShowReportSelect && (
            <Col span={24}>
              <Form.Item style={formItemStyle} name={TypeSafeForm.getValidDataIndex("report")} label="보고서">
                <Select
                  showSearch
                  disabled={consultationTypeWatched === ConsultationTypeEnum.GENERAL_CONSULTATION}
                  options={reportOptions}
                  filterOption={(input, option) => option?.label?.toLowerCase().includes(input.toLowerCase())}
                  onSearch={searchReport}
                  loading={fetchMoreReport.loading}
                  onPopupScroll={({ currentTarget }) => {
                    const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                    const { hasMore, loading, onFetchMore } = fetchMoreReport;
                    // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                    if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                      onFetchMore();
                    }
                  }}
                />
              </Form.Item>
            </Col>
          )}
          <Col span={24}>
            <Form.Item
              style={formItemStyle}
              name={TypeSafeForm.getValidDataIndex("title")}
              label="제목"
              rules={[{ required: true }]}
            >
              <Input />
            </Form.Item>
          </Col>
          <Col span={24}>
            <Form.Item
              style={formItemStyle}
              name={TypeSafeForm.getValidDataIndex("content")}
              label="내용"
              rules={[{ required: true }]}
            >
              <ToastEditor
                name="content"
                placeholder={"상담 내용을 입력해주세요(최대 1,000자)"}
                onChange={onEditorChange}
                isEditable={true}
                initialValue={parseContentJsonStrToMarkdown(selectedRowRecord?.content)}
              />
            </Form.Item>
          </Col>
        </Row>
      </Form>
    </Modal>
  );
};

export default BrandStoreConsultationCreateAndUpdateModal;
