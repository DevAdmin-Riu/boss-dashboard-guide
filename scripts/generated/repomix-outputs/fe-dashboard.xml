import { commonMsg, paymentTerm } from "@assets/messages/commonMsg";
import { transformPaymentStatus } from "@assets/messages/status";
import {
  OrderEventsEmailsEnum,
  OrderEventsEnum,
  OrderType,
  PaymentChargeStatusEnum,
  PgRefundEventStatusEnum,
} from "@src/api/types/globalTypes";
import Form from "@src/app/components/Form";
import Hr from "@src/app/components/Hr";
import Skeleton from "@src/app/components/Skeleton";
import Timeline, { TimelineAddNote } from "@src/app/components/Timeline/Timeline";
import TimelineNote from "@src/app/components/Timeline/TimelineNote";
import { getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { TConsignmentVendorUpdatedParams } from "@src/app/views/purchase/purchaseOrders/components/PurchaseOrderManageHistory";
import {
  convertDeliveryTypeEnumToWord,
  makeCombinePayMethod,
  makePayMethodForPgRefund,
  makeStatusForPgRefund,
  makeVendorDisplayName,
  transformTaxFree,
} from "@utils/misc";
import { utils } from "@utils/utils";
import { Typography } from "antd";
import React from "react";

import { OrderDetails_order_events } from "../api/types/OrderDetails";
import { convertOrderTypeToWord } from "../utils";
import { makeEtcDeliveryManInfoText } from "./OrderDeliveryListPage/utils";

export interface NoteFormData {
  message: string;
}

const getEventMessage = (event: OrderDetails_order_events, orderType: OrderType) => {
  const parameters = utils.jsonParseWrapper(event?.parameters) || {};
  const b2bOrderTypeText = convertOrderTypeToWord(orderType);
  switch (event.type) {
    case OrderEventsEnum.CANCELED:
      return "운영자에 의해 주문이 취소되었습니다.";
    case OrderEventsEnum.CANCELED_BY_VBANK_DATE_EXPIRED:
      return "가상 계좌 입금 기한 만료로 주문이 자동 취소되었습니다.";
    case OrderEventsEnum.EMAIL_SENT:
      switch (event.emailType) {
        case OrderEventsEmailsEnum.DIGITAL_LINKS:
          return "Links to the order's digital goods were sent";
        case OrderEventsEmailsEnum.FULFILLMENT_CONFIRMATION:
          return "출고 확인 메일을 고객에게 전송하였습니다.";
        case OrderEventsEmailsEnum.ORDER_CONFIRMATION:
          return "주문 확인 메일을 고객에게 전송했습니다.";
        case OrderEventsEmailsEnum.PAYMENT_CONFIRMATION:
          return "결제 확인 메일을 고객에게 전송했습니다.";
        case OrderEventsEmailsEnum.SHIPPING_CONFIRMATION:
          return "Shipping details was sent to customer";
        case OrderEventsEmailsEnum.TRACKING_UPDATED:
          return "Shipping tracking number was sent to customer";
        case OrderEventsEmailsEnum.TRACKING_COMPLETED:
          return "배송 완료 상태가 변경되었습니다.";
        case OrderEventsEmailsEnum.ORDER_CANCEL:
          return "주문 취소 메일을 고객에게 전송했습니다.";
        case OrderEventsEmailsEnum.ORDER_REFUND:
          return "환불 처리 메일을 고객에게 전송했습니다.";
      }
    case OrderEventsEnum.FULFILLMENT_CANCELED: {
      let fulfillmentComposedId = parameters?.fulfillment_composed_id_with_prefix;
      if (!fulfillmentComposedId) {
        // 예전데이터용 하드코딩
        fulfillmentComposedId = "#" + parameters?.composed_id;
      }
      return "제품을 교환 출고 취소했습니다." + (fulfillmentComposedId ? ` (${fulfillmentComposedId})` : "");
    }
    case OrderEventsEnum.FULFILLMENT_REFUNDED: {
      let fulfillmentComposedId = parameters?.fulfillment_composed_id_with_prefix;
      if (!fulfillmentComposedId) {
        // 예전데이터용 하드코딩
        fulfillmentComposedId = "#" + parameters?.composed_id;
      }
      return "제품을 반품 출고 취소했습니다." + (fulfillmentComposedId ? ` (${fulfillmentComposedId})` : "");
    }
    case OrderEventsEnum.FULFILLMENT_FULFILLED_ITEMS:
      return "제품을 출고처리했습니다.";
    case OrderEventsEnum.FULFILLMENT_RESTOCKED_ITEMS: {
      const quantity = parameters?.quantity;
      const warehouse = parameters?.warehouse;
      let historyMsg = "출고 취소한 제품을 재입고 처리했습니다.";
      if (utils.isEmpty(warehouse)) {
        historyMsg += " (위탁) ";
      }
      if (quantity !== undefined) {
        historyMsg += "\n------------------";
        historyMsg += `\n(재입고 수량: ${quantity})`;
      }
      return historyMsg;
    }
    case OrderEventsEnum.CONSIGNMENT_VENDOR_UPDATED:
      const { order_line, sku, before, after }: TConsignmentVendorUpdatedParams = parameters;
      return utils.formatMessage(
        "출고 완료된 제품의 발주 정보 변경" +
          "\n------------------" +
          "\n주문상세번호: {orderLineComposedIdWithPrefix}" +
          "\n제품코드: {sku}" +
          "\n" +
          "\n매입일: {beforePurchaseDate} -> {afterPurchaseDate}" +
          "\n협력사: {beforeVendor} -> {afterVendor}" +
          `\n매입단가${commonMsg.excludeVat}: {beforeUnitCostPriceExcludeVat} -> {afterUnitCostPriceExcludeVat}`,
        {
          orderLineComposedIdWithPrefix: order_line,
          sku,
          beforeVendor: makeVendorDisplayName(before.vendor),
          afterVendor: makeVendorDisplayName(after.vendor),
          beforeUnitCostPriceExcludeVat: utils.toMoneyText(before.unit_cost_price_exclude_vat),
          afterUnitCostPriceExcludeVat: utils.toMoneyText(after.unit_cost_price_exclude_vat),
          beforePurchaseDate: before.purchase_date,
          afterPurchaseDate: after.purchase_date,
        }
      );
    case OrderEventsEnum.CHANGE_ORDER_LINE_TRACK_INVENTORY:
      return utils.formatMessage(
        "출고유형 변경" +
          "\n------------------" +
          "\n주문상세번호: {orderLineComposedIdWithPrefix}" +
          "\n제품코드: {sku}" +
          "\n" +
