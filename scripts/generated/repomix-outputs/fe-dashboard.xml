<file path="src/app/views/tasks/DeepLinkRedirect/DeepLinkRedirect.tsx">
import { appPackageId } from "@assets/constants/config";
import Loader from "@src/app/components/Loader";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { historyBack } from "@src/app/routes/Routes";
import { getMobileAppInfo } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Result, Row, Space, Typography } from "antd";
import React, { useEffect, useState } from "react";

export const DeepLinkRedirect: React.FC = () => {
  const shop = useShop();
  const [deepLinkFaild, setDeepLinkFailed] = useState<boolean>(false);

  const dashboardAppInfo = getMobileAppInfo(shop?.mobileAppInfo, "dashboard");
  const { deepLink, storeLink } = dashboardAppInfo;

  const openAndroidAppWithFallback = () => {
    // 안드로이드 기기에서 앱을 열기 위한 intent URL 생성. 앱이 설치되어 있지 않으면 Play 스토어로 리다이렉트됨.
    const makeIntentUrl = () => {
      const scheme = deepLink.split("://")[0];
      const path = deepLink.split("://")[1];
      return `intent://${path}#Intent;scheme=${scheme};package=${appPackageId};S.browser_fallback_url=${storeLink};end;`;
    };

    const intentUrl = makeIntentUrl();
    window.location.href = intentUrl;
  };

  const openIOSAppWithFallback = () => {
    window.location.href = deepLink;
  };

  const openAppOrStore = () => {
    if (utils.isEmpty(dashboardAppInfo)) {
      return;
    }

    const isAndroid = utils.checkMobileAndroid();
    const isIOS = utils.checkMobileIOS();
    if (isAndroid) {
      openAndroidAppWithFallback();
    } else if (isIOS) {
      openIOSAppWithFallback();
    }
  };

  const onStore = () => {
    window.location.href = storeLink;
  };

  useEffect(() => {
    // 1. 앱 실행 시도
    openAppOrStore();

    // 2. 일정 시간 후에
    // 앱이 열린 경우엔 이전 페이지로 돌아가고,
    // 사용자가 브라우저에 머물러 있으면 앱 실행 실패 UI 노출
    setTimeout(() => {
      if (document.visibilityState === "hidden") {
        setDeepLinkFailed(false);
        historyBack();
      } else {
        setDeepLinkFailed(true);
      }
    }, 2000);
  }, []);

  if (deepLinkFaild) {
    return (
      <Row style={{ height: "100vh" }} justify="center" align="middle">
        <Result
          status="info"
          subTitle="앱이 열리지 않았나요?"
          extra={
            <Space direction="vertical">
              <Button type="primary" onClick={onStore}>
                앱 설치하기
              </Button>
              <Button type="default" onClick={openAppOrStore}>
                앱 다시 열기
              </Button>
              <Button type="default" onClick={historyBack}>
                웹에서 계속하기
              </Button>
            </Space>
          }
        />
      </Row>
    );
  }

  return (
    <Row style={{ height: "100vh" }} justify="center" align="middle">
      <Space direction="vertical" align="center">
        <Loader />
        <Typography>앱을 실행 중입니다</Typography>
      </Space>
    </Row>
  );
};
</file>

