import useLocalStorage from "@hooks/useLocalStorage";
import { useLocation } from "react-router";

export interface FilterSettings {
  visibleFilters: string[];
  filterOrder?: string[];
  hasCustomSettings?: boolean;
}

export interface AppFilterViewSettings {
  [key: string]: FilterSettings;
}

export interface UseFilterSettings {
  settings: FilterSettings;
  updateFilterSettings: (visibleFilters: string[]) => void;
  resetFilterSettings: () => void;
  hasCustomSettings: boolean;
}

export default function useFilterSettings(): UseFilterSettings {
  const location = useLocation();
  const pathname = location.pathname;
  const [storedSettings, setStoredSettings] = useLocalStorage<AppFilterViewSettings>("filterConfig", {});

  const updateFilterSettings = (visibleFilters: string[]) => {
    setStoredSettings((settings) => ({
      ...settings,
      [pathname]: {
        visibleFilters,
        hasCustomSettings: true,
      },
    }));
  };

  const resetFilterSettings = () => {
    setStoredSettings((settings) => {
      const newSettings = { ...settings };
      delete newSettings[pathname];
      return newSettings;
    });
  };

  const savedSettings = storedSettings[pathname];

  // 빈 배열은 모든 필터 표시를 의미
  const returnSettings: FilterSettings = savedSettings || {
    visibleFilters: [],
    hasCustomSettings: false,
  };

  return {
    settings: returnSettings,
    updateFilterSettings,
    resetFilterSettings,
    hasCustomSettings: !!savedSettings?.hasCustomSettings,
  };
}
