import StatusLabel from "@src/app/components/StatusLabel";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { BrandDetails_brand_brandStores } from "@src/app/views/brand/brands/api/types/BrandDetails";
import { brandStoreDetailsViewUrl } from "@src/app/views/brand/brandStore/urls";
import { brandStoreStatusChoices, brandStoreTypeChoices } from "@src/app/views/brand/brandStore/utils";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
