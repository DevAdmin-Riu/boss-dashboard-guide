import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import { User } from "@src/api/fragments/types/User";
import { RepeatTypeEnum } from "@src/api/types/globalTypes";
import { utils } from "@utils/utils";

import { HqScheduleList_schedules_edges_node } from "./api/types/HqScheduleList";
import { HqInfoProductListType } from "./urls";

export const scheduleRepeatTypeChoices = [
  { label: "반복 없음", value: RepeatTypeEnum.NONE },
  { label: "매일", value: RepeatTypeEnum.DAILY },
  { label: "매주", value: RepeatTypeEnum.WEEKLY },
  { label: "매월", value: RepeatTypeEnum.MONTHLY },
  { label: "매년", value: RepeatTypeEnum.YEARLY },
];

export const checkIsScheduleWriter = (schedule: HqScheduleList_schedules_edges_node, user: User): boolean => {
  if (utils.isEmpty(schedule) || utils.isEmpty(user)) {
    return false;
  }
  return schedule.writer.id === user.id;
};

export const transformHqInfoProductPageType = (pageType: HqInfoProductListType) => {
  switch (pageType) {
    case "general":
      return "일반";
    case "package":
      return "패키지";
    case "product":
      return "전용";
    default:
      return null;
  }
};

export const getHqInfoProductPageTitle = (pageType: HqInfoProductListType | ":pageType") => {
  if (pageType === ":pageType") {
    return firstDepthMenuTitle.hqProduct;
  }
  const pageTypeText = transformHqInfoProductPageType(pageType);
  if (utils.isEmpty(pageTypeText, true)) {
    return firstDepthMenuTitle.hqProduct;
  }
  return `${pageTypeText} 상품`;
};
