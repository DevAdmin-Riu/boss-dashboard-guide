interface B2bSalesStatListViewProps {
  defaultParams: B2bSalesStatListViewUrlQueryParams;
  params: B2bSalesStatListViewUrlQueryParams;
}

export enum B2bSalesStatListModalMode {
  SEND_MODAL = "SEND_MODAL",
}

export const getStatusCount = (data: B2bSalesCount_b2bSalesCount): TCountOfStatus<B2bSettlementUrlEnum> => {
  const { standByCount, reqRevisionCount, revisionCount } = data;
  const totalEditRequestCount = reqRevisionCount + revisionCount;

  return {
    [B2bSettlementUrlEnum.ALL]: 0,
    [B2bSettlementUrlEnum.IN_PROGRESS]: standByCount,
    [B2bSettlementUrlEnum.EDIT_REQUEST]: totalEditRequestCount,
    [B2bSettlementUrlEnum.CLOSING_STATEMENT]: 0,
    [B2bSettlementUrlEnum.AGENCY_PENDING]: 0,
    [B2bSettlementUrlEnum.CLOSED]: 0, // closedCount가 API에 없음
    [B2bSettlementUrlEnum.TAXINVOICE]: 0, // taxInvoiceCount가 API에 없음
  };
};

export const getHqStatusCount = (data: B2bSalesCount_b2bSalesCount): TCountOfStatus<HqB2bSettlementUrlEnum> => {
  const { standByCount, reqRevisionCount, revisionCount } = data;

  return {
    [HqB2bSettlementUrlEnum.STAND_BY]: standByCount,
    [HqB2bSettlementUrlEnum.PENDING]: reqRevisionCount + revisionCount,
    [HqB2bSettlementUrlEnum.COMPLETED]: 0, // completedCount가 API에 없음
    [HqB2bSettlementUrlEnum.ALL]: 0,
    [HqB2bSettlementUrlEnum.TAXINVOICE]: 0, // taxInvoiceCount가 API에 없음
  };
};

export const B2bSalesStatListView: React.FC<B2bSalesStatListViewProps> = ({ defaultParams, params }) => {
  const routeParams = useParams<B2bSettlementListViewRouteParams | HqB2bSettlementListViewRouteParams>();
  const { user } = useUser();
  const { isStaff } = user;
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [modalMode, setModalMode] = useState<B2bSalesStatListModalMode>(null);
  const [selectedBrandSalesList, setSelectedBrandSalesList] = useState<SalesListForB2b_sales_edges_node[]>([]);
  const [selectedSalesStatsRecordKey, setSelectedSalesStatsRecordKey] = useState<string | null>(null);

  const { data: countData } = useB2bSalesCountQuery({
    variables: {
      filter: {
        brandId: isStaff ? undefined : user.brand.id,
      },
    },
  });

  const isPending = routeParams.status === "pending";
  const isClosingStatement = routeParams.status === "closing-statement";

  const targetUrl = (params: B2bSalesStatListViewUrlQueryParams) =>
    isStaff
      ? b2bSettlementListViewUrl(routeParams as B2bSettlementListViewRouteParams, params)
      : hqB2bSettlementListViewUrl(routeParams as HqB2bSettlementListViewRouteParams, params);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: isStaff
      ? ListViews.B2B_SETTLEMENT_LIST_CLOSING_STATEMENT
      : ListViews.HQ_B2B_SETTLEMENT_LIST_CLOSING_STATEMENT,
  });

  const { fetchForDownload } = utils.initListViewDownloadQuery(useB2bSalesStatsFilterDownloadQuery);

  const filterVariables = getFilterVariables(params);
  const queryVariables: B2bSalesStatsVariables = React.useMemo(() => {
    let includeOnlySent: boolean;

    if (isStaff) {
      includeOnlySent = isPending ? true : false;
    } else {
      includeOnlySent = true;
    }

    const onlyBeforeSend = isClosingStatement ? true : false;

    return {
      salesCloseDate: filterVariables.salesCloseDate,
      brandSearch: isStaff ? filterVariables.brandSearch : undefined,
      includeOnlySent,
      onlyBeforeSend,
    };
  }, [params]);

  const { data, loading, refetch } = useB2bSalesStatsQuery({ variables: queryVariables });

  const onCloseModal = () => {
    setModalMode(null);
    setSelectedSalesStatsRecordKey(null);
    setSelectedBrandSalesList([]);
  };

  const [salesListForB2bRefetch, { loading: salesListForB2bRefetchLoading }] = useSalesListForB2bFilterDownloadQuery({
    forceFetchPolicy: "no-cache",
  });

  const fetchBrandSalesList = (record: B2bSalesStats_b2bSalesStats) =>
    salesListForB2bRefetch({
      variables: {
        first: 500,
        filter: {
          brandId: record.brand.id,
          salesCloseDate: getGteLteVariablesForMonth({ gte: record.statDate, lte: record.statDate }),
          b2bStatus: isClosingStatement
            ? [SalesB2bStatusEnum.BEFORE_SEND]
            : [SalesB2bStatusEnum.PENDING, SalesB2bStatusEnum.REQ_REVISION, SalesB2bStatusEnum.REVISION],
        },
      },
    }).then((res) => {
      const refetchSalesList = maybe(() => res.data?.sales.edges.map((edge) => edge.node), []);
      setSelectedBrandSalesList(refetchSalesList);
      return refetchSalesList;
    });

  const onShowSendModal = (record: B2bSalesStats_b2bSalesStats) => {
    // statDate와 brand.id를 조합하여 고유 키 생성
    const recordKey = `${record.statDate}_${record.brand?.id || "unknown"}`;
    setSelectedSalesStatsRecordKey(recordKey);
    fetchBrandSalesList(record);
    setModalMode(B2bSalesStatListModalMode.SEND_MODAL);
  };

  const b2bSalesStatList = useMemo(() => maybe(() => data?.b2bSalesStats || [], []), [data]);

  // 키로 선택된 salesStatsRecord 찾기
  const selectedSalesStatsRecord = useMemo(() => {
    if (!selectedSalesStatsRecordKey) {
      return null;
    }
    return (
      b2bSalesStatList.find((record) => {
        const recordKey = `${record.statDate}_${record.brand?.id || "unknown"}`;
        return recordKey === selectedSalesStatsRecordKey;
      }) || null
    );
  }, [b2bSalesStatList, selectedSalesStatsRecordKey]);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: undefined,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<B2bSalesStatListViewUrlDialog, B2bSalesStatListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const pageLoading = loading;

  return (
    <>
      <B2bSalesStatListPage
        params={params}
        settings={settings}
        disabled={pageLoading}
        b2bSalesStatList={b2bSalesStatList}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        ListNavigator={() =>
          isStaff ? (
            <ListNavigator<B2bSettlementForSalesViewUrlQueryParams, B2bSettlementUrlEnum>
              countOfStatus={countData ? getStatusCount(countData.b2bSalesCount) : null}
              urlList={b2bSettlementUrlList()}
              NavButtonName={b2bSettlementNavButtonName}
              skipQueryString={true}
            />
          ) : (
            <ListNavigator<B2bSettlementForSalesViewUrlQueryParams, HqB2bSettlementUrlEnum>
              countOfStatus={countData ? getHqStatusCount(countData.b2bSalesCount) : null}
              urlList={hqB2bSettlementUrlList()}
              NavButtonName={hqB2bSettlementNavButtonName}
              skipQueryString={true}
            />
          )
        }
        onShowSendModal={onShowSendModal}
        isClosingStatement={isClosingStatement}
        isStaff={isStaff}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <B2bSalesStatClosingStatementModal
        open={modalMode === B2bSalesStatListModalMode.SEND_MODAL}
        onClose={onCloseModal}
        selectedBrandSalesList={selectedBrandSalesList}
        salesStatsRecord={selectedSalesStatsRecord}
        onUpdateSalesList={(updatedList) => setSelectedBrandSalesList(updatedList)}
        onRefetchSalesList={() => selectedSalesStatsRecord && fetchBrandSalesList(selectedSalesStatsRecord)}
        isPending={isPending}
        isClosingStatement={isClosingStatement}
        salesListForB2bRefetchLoading={salesListForB2bRefetchLoading}
      />
    </>
  );
};
</file>

