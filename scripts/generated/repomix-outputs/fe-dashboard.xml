export const handleClickExcelDownload = (
  dataSource: BrandFbvSettlements_brandFbvSettlements_edges_node[],
  urlEnum: AdminMonthlySettlementUrlEnum
) => {
  try {
    const { rows, colsInfo, header, merges } = parseFulfilledByVendorSettlementList(dataSource, urlEnum);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const title = `${transformIsFBV(true)} 정산 관리 (${getMileageSettlementNavButtonName(urlEnum)})`;
    excelDownload({ title, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const fulfilledByVendorSettlementKeysToMerge = {
  brand: "[브랜드 정보]",
  md: "[담당 MD]",
  order: "[전체 주문]",
  fulfilledByVendor: `[${transformIsFBV(true)} 상품 대금]`,
  processedInfo: `[${transformIsFBV(true)} 상품 대금 정산처리 정보]`,
  status: "[현황]",
};

const parseFulfilledByVendorSettlementList = (
  dataSource: BrandFbvSettlements_brandFbvSettlements_edges_node[],
  urlEnum: AdminMonthlySettlementUrlEnum
) => {
  const rows = [];

  dataSource.forEach((data, index) => {
    // 구분
    const statDate = moment(data.date).format(onlyMonthFormat);

    // [브랜드정보]
    // 브랜드코드
    const brandCode = data.brand?.code;
    // 브랜드명
    const brandName = data.brand?.name;

    // [담당 MD]
    const brandStaffName = data.brand?.staff ? data.brand?.staff.firstName : "없음";
    // 연락처
    const brandStaffPhone = data.brand?.staff ? transformPhoneNumber(data.brand?.staff.aligoPhone) : "없음";

    // [직거래 상품 대금]
    // 공급가액
    const statBrandCostPriceExcludeVatOnlyFbv = data.brandCostPriceExcludeVat;
    // 세액
    const statBrandCostPriceVatOnlyFbv = data.brandCostPriceIncludeVat - data.brandCostPriceExcludeVat;
    // 합계금액
    const statBrandCostPriceIncludeVatOnlyFbv = statBrandCostPriceExcludeVatOnlyFbv + statBrandCostPriceVatOnlyFbv;
    // 수수료
    const statBrandPayingChargeIncludeVatOnlyFbv = data.brandPayingChargeIncludeVat;
    // 최종대금 (합계금액 - 수수료)
    const totalStatBrandPayingChargeOnlyFbv =
      statBrandCostPriceIncludeVatOnlyFbv - statBrandPayingChargeIncludeVatOnlyFbv;

    // [현황]
    // 상태
    const statusText = getFulfilledByVendorSettlementStatusTextForAdmin(data.settlementStatus);

    // [직거래 상품 대금 정산처리 정보]
    // 확정 처리 일시(처리자)
    const settlementConfirmedDate = data.settlementConfirmedDate
      ? `${getDateByFormat(data.settlementConfirmedDate)}(${data.settlementConfirmedUser?.firstName || "-"})`
      : "-";
    // 지급요청 일시
    const settlementReviewRequestedDate = getDateByFormat(data.settlementReviewRequestedDate);
    // 지급요청 반려 일시
    const settlementReviewRejectedDate = getDateByFormat(data.settlementReviewRejectedDate);
    // 지급요청 승인 일시(처리자)
    const settlementReviewApprovedDate = data.settlementReviewApprovedDate
      ? `${getDateByFormat(data.settlementReviewApprovedDate)}(${data.settlementReviewApprovedUser?.firstName || "-"})`
      : "-";
    // 지급처리 완료 일시(처리자)
    const settlementPaidDate = data.settlementPaidDate
      ? `${getDateByFormat(data.settlementPaidDate)}(${data.settlementPaidUser?.firstName || "-"})`
      : "-";

    const stateDate = {
      구분: statDate,
    };
    const brandInfo = {
      [fulfilledByVendorSettlementKeysToMerge.brand + "\n브랜드코드"]: brandCode,
      [fulfilledByVendorSettlementKeysToMerge.brand + "\n브랜드명"]: brandName,
    };
    const mdInfo = {
      [fulfilledByVendorSettlementKeysToMerge.md + "\nMD"]: brandStaffName,
      [fulfilledByVendorSettlementKeysToMerge.md + "\n연락처"]: brandStaffPhone,
    };
    const fbvBrandCostPriceInfo = {
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendor + "\n공급가액"]: statBrandCostPriceExcludeVatOnlyFbv,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendor + "\n세액"]: statBrandCostPriceVatOnlyFbv,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendor + "\n합계금액"]: statBrandCostPriceIncludeVatOnlyFbv,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendor + "\n수수료"]: statBrandPayingChargeIncludeVatOnlyFbv,
      [fulfilledByVendorSettlementKeysToMerge.fulfilledByVendor + "\n최종대금"]: totalStatBrandPayingChargeOnlyFbv,
    };

    const statusInfo = {
      [fulfilledByVendorSettlementKeysToMerge.status + "\n상태"]: statusText,
    };
    const processedInfo = {
      [fulfilledByVendorSettlementKeysToMerge.processedInfo + "\n확정 처리 일시(처리자)"]: settlementConfirmedDate,
      [fulfilledByVendorSettlementKeysToMerge.processedInfo + "\n지급요청 일시"]: settlementReviewRequestedDate,
      [fulfilledByVendorSettlementKeysToMerge.processedInfo + "\n지급요청 반려 일시"]: settlementReviewRejectedDate,
      [fulfilledByVendorSettlementKeysToMerge.processedInfo + "\n지급요청 승인 일시(처리자)"]:
        settlementReviewApprovedDate,
      [fulfilledByVendorSettlementKeysToMerge.processedInfo + "\n지급처리 완료 일시(처리자)"]: settlementPaidDate,
    };

    let mergedRows = {
      ...stateDate,
      ...brandInfo,
      ...mdInfo,
      ...fbvBrandCostPriceInfo,
    };
    if (urlEnum === AdminMonthlySettlementUrlEnum.ALL_STATUS) {
      mergedRows = { ...mergedRows, ...processedInfo };
    }
    mergedRows = { ...mergedRows, ...statusInfo };
    rows.push(mergedRows);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

export const getFulfilledByVendorSettlementStatusTextForAdmin = (status: BrandMonthlySettlementStatusEnum) => {
  switch (status) {
    case BrandMonthlySettlementStatusEnum.CONFIRMED:
    case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
      return "지급 검토";
    case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
      return "지급 대기";
    case BrandMonthlySettlementStatusEnum.PAID:
      return "지급 완료";
    default:
      return "미확정";
  }
};
