export function getDisplayUserName(
  user?: { loginId?: string; firstName?: string; brand?: any },
  appendLoginId?: boolean,
  appendBrandName?: boolean
) {
  if (!user) {
    return "";
  }

  let displayUserName;
  if (user.firstName) {
    displayUserName = appendLoginId
      ? user.loginId
        ? `${user.firstName} (${user.loginId})`
        : `${user.firstName} (-)`
      : user.firstName;
  } else {
    displayUserName = appendLoginId ? (user.loginId ? `- (${user.loginId})` : ``) : "";
  }

  if (appendBrandName && user.brand) {
    return `[${user.brand.name}] ${displayUserName}`;
  }
  return displayUserName;
}

