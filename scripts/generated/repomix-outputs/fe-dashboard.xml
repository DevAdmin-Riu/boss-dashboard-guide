    ),
    active: opts.deliveredStatusAt.active,
  };

  const defaultFilters = [
    eventTypeFilter, // 발주 구분
    isConsignment && isB2b === false && orderSearchFilter, // 주문번호 / 주문상세번호
    isB2b && b2bOrderSearchFilter, // b2b 주문번호 / 주문상세번호
    purchaseOrderSearchFilter, // 발주서번호 / 발주상세번호
    purchaseOrderDateFilter, // 발주일
    askingPurchaseDateFilter, // 납품요청일
    expectedPurchaseDateFilter, // 납품예정일
    productSearchFilter, // 제품코드 / 제품명
    vendorSearchFilter, // 협력사코드 / 협력사명
    isConsignment && brandSearchFilter, // 브랜드코드 / 브랜드명
    isConsignment && isB2b === false && brandStoreSearchFilter, // 매장코드 / 매장명
    isConsignment && userSearchFilter, // ID / 사용자명
    isTrackInventory && isNotOrderableBeforeStockedFilter, // 선주문 불가 여부
    isTrackInventory && isForPackageOrderFilter, // 패키지 구성품 여부
    showStatusFilter && statusFilter, // 세부진행상태 - 전체 발주 내역에서만 표시
  ];

  // NOTE: 전체 발주 내역에선 발주일, 납품요청일 필터를 사용하지 않음
  const allStatus = [
    ...defaultFilters.filter(
      (item) =>
        item &&
        ![PurchaseOrderLineFilterKeys.purchaseOrderDate, PurchaseOrderLineFilterKeys.askingPurchaseDate].includes(
          item.name
        )
    ),
    draftStatusAtFilter, // 발주 작성일
    pendingStatusAtFilter, // 접수 대기일
    rejectedStatusAtFilter, // 거부일
    sendRejectedStatusAtFilter, // 거부 건 발송일
    receivedStatusAtFilter, // 접수일
    // 분납 관련 날짜 필터는 재고발주에서만 표시 (B2B 제외)
    isTrackInventory && isB2b === false && reqSplitDeliveryStatusAtFilter, // 분할납품 요청일
    isB2b === false && approveReqSplitDeliveryStatusAtFilter, // 분할납품 요청 승인일
    reqEpdUpdateStatusAtFilter, // 납품예정일 변경 요청일
    approveReqEpdUpdateStatusAtFilter, // 납품예정일 변경 요청 승인일
    dispatchFulfillmentStatusAtFilter, // 출고지시일
    deliveryConfirmedStatusAtFilter, // 배송확정일
    isTrackInventory === false && invoicePrintedStatusAtFilter, // 거래명세서 출력일
    isTrackInventory && toBeInspectedStatusAtFilter, // 검수 대기일
    isTrackInventory && inspectedStatusAtFilter, // 검수 완료일
    // 입고일은 재고발주에서만 표시
    isTrackInventory && stockedStatusAtFilter, // 입고일
    deliveredStatusAtFilter, // 배송 완료일
  ];

  let filterList: IFilter<PurchaseOrderLineFilterKeys> = [];
  switch (status) {
    case PurchaseOrderLineUrlEnum.DRAFT:
    case PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED:
    case PurchaseOrderLineUrlEnum.RECEIVE:
    case PurchaseOrderLineUrlEnum.IN_PRODUCTION:
    case PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT:
    case PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE:
    case PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY:
      filterList = defaultFilters;
      break;
    case PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY:
      filterList = [
        ...defaultFilters,
        dispatchFulfillmentStatusAtFilter, // 출고지시일
      ];
      break;
    case PurchaseOrderLineUrlEnum.PRINT_INVOICE:
      filterList = [
        ...defaultFilters,
        deliveryConfirmedStatusAtFilter, // 배송확정일
      ];
      break;
    case PurchaseOrderLineUrlEnum.INSPECT:
    case PurchaseOrderLineUrlEnum.ADD_STOCK:
      // 검수/입고는 재고발주에서만 사용 가능
      if (isTrackInventory) {
        filterList = [
          ...defaultFilters,
          dispatchFulfillmentStatusAtFilter, // 출고지시일
          toBeInspectedStatusAtFilter, // 검수 대기일
          deliveryConfirmedStatusAtFilter, // 배송확정일
        ];
      } else {
        filterList = [];
      }
      break;
    case PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY:
      filterList = [
        ...defaultFilters,
        dispatchFulfillmentStatusAtFilter, // 출고 지시일
        deliveryConfirmedStatusAtFilter, // 배송 확정일
        isTrackInventory === false && invoicePrintedStatusAtFilter, // 거래명세서 출력일
        isTrackInventory && toBeInspectedStatusAtFilter, // 검수 대기일
        isTrackInventory && inspectedStatusAtFilter, // 검수 완료일
        deliveredStatusAtFilter, // 배송 완료일
      ];
      break;
    case PurchaseOrderLineUrlEnum.ALL:
      filterList = allStatus;
      break;
    default:
      return [];
  }

  return utils.filterDisplayOrdering(
    filterList
      .filter(Boolean)
      .filter((filter) => ([FieldType.options].includes(filter.type) ? filter.options.length > 1 : true))
  );
}
</file>

