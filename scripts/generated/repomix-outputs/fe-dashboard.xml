<file path="src/app/views/order/orders/components/UnfulfilledOrderLineListPage/utils.ts">
import { MutationFunction } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { getRecordsObject } from "@src/app/components/antd/Form/utils";
import { FulfillOrder, FulfillOrderVariables } from "@src/app/views/order/orders/api/types/FulfillOrder";
import { FulfillOrderBulk, FulfillOrderBulkVariables } from "@src/app/views/order/orders/api/types/FulfillOrderBulk";
import { checkIsInteger, getDeliveryBoxCountConsiderAdjustPricePv } from "@utils/misc";
import { destroyProcessingMessage, showNotificationError, showProcessingMessage } from "@utils/notification/wrapper";
import { FormInstance } from "antd";
import React from "react";

import { OrderLineList_orderLines_edges_node } from "../../api/types/OrderLineList";
import {
  OrderLineListForFulfill_orderLines_edges_node,
  OrderLineListForFulfill_orderLines_edges_node_variant_stocks,
} from "../../api/types/OrderLineListForFulfill";

function makeStocksDataForOrderLine(
  record: OrderLineListForFulfill_orderLines_edges_node
): OrderLineListForFulfill_orderLines_edges_node_variant_stocks[] {
  // 상품 데이터 오류로 variant 가 없는 경우에 대한 예외처리
  if (!record.variant) {
    return [];
  }
  const consignedStock: OrderLineListForFulfill_orderLines_edges_node_variant_stocks = {
    __typename: undefined,
    id: undefined,
    quantity: Infinity,
    quantityAllocated: 0,
    warehouse: {
      __typename: undefined,
      id: undefined,
      name: "위탁",
    },
  };
  // 주문 내역이 위탁 주문인 경우 예외처리
  if (!record?.trackInventory) {
    return [consignedStock];
  }
  // 상품 데이터 오류로 variant 가 없는 경우에 대한 예외처리
  if (!!record.variant) {
    return [...record.variant.stocks];
  }
  return [];
}

function getQuantityPath(name: { recordId: React.Key; stockIndex: number }) {
  return getStockPath({ recordId: name.recordId }).concat([name.stockIndex, "quantity"]);
}

function getStockPath(name: { recordId: React.Key }) {
  return [name.recordId, "input", "lines", 0, "stocks"];
}

function getStockAvailable(record: OrderLineListForFulfill_orderLines_edges_node) {
  return (
    makeStocksDataForOrderLine(record)?.reduce(
      (acc: number, stock: OrderLineListForFulfill_orderLines_edges_node_variant_stocks) => stock.quantity + acc,
      0
    ) - record.variant.quantityCanNotSell // 판매 제한 재고는 제외함.
  );
}

export function getCheckboxDisabledProp(record: OrderLineListForFulfill_orderLines_edges_node) {
  return getStockAvailable(record) <= 0;
}

function formRowReset(form: FormInstance, id: React.Key) {
  form.getFieldValue(getStockPath({ recordId: id })).forEach((_: any, i: number) => {
    form.setFields([
      {
        name: getQuantityPath({ recordId: id, stockIndex: i }),
        value: 0,
      },
    ]);
  });
}

export function getFormInitialValues(orderLines: OrderLineListForFulfill_orderLines_edges_node[]) {
  return {
    ...orderLines?.reduce((obj, item) => {
      obj[item.id] = {
        orderId: item.order.id,
        input: {
          lines: [
            {
              orderLineId: item.id,
              stocks: makeStocksDataForOrderLine(item).map((stock) => ({
                quantity: 0,
                warehouse: stock.warehouse.id,
              })),
            },
          ],
        },
      };
      return obj;
    }, {}),
    records: getRecordsObject(orderLines),
    selectedRowKeys: [],
  };
}

export const checkWithoutPurchaseOrderLine = (form: FormInstance<any>) => {
  const selectedIds = form.getFieldValue(["selectedRowKeys"]);
  const length = selectedIds?.length;
  for (let i = 0; i < length; i++) {
    const id = selectedIds[i];
    const record: OrderLineList_orderLines_edges_node = form.getFieldValue(["records", id]);
    if (record.trackInventory) {
      continue;
    }
    if (record.existPurchaseOrderLine === false) {
      return true;
    }
  }
  return false;
};

export async function submitFragmentedFulfillmentRow(
  form: FormInstance<any>,
  id: React.Key,
  submit: MutationFunction<FulfillOrder, FulfillOrderVariables>,
  isFulfilledByVendor: boolean
) {
  await submitByFragments(form, id, submit, isFulfilledByVendor);
  formRowReset(form, id);
}

export async function submitFulfillmentForm(
  form: FormInstance<any>,
  submit: MutationFunction<FulfillOrder, FulfillOrderVariables>,
  submitBulk: MutationFunction<FulfillOrderBulk, FulfillOrderBulkVariables>,
  unfulfillmentViewType: UnfulfillmentViewTypeEnum
) {
  // 기타 배송의 경우 로직
  if (isUnfulfillmentViewStockEtc(unfulfillmentViewType)) {
    await submitFulfillmentAll(form, submit);
  } else {
    // 기존 배송(재고, 위탁) 경우 로직
    const selectedIds = form.getFieldValue(["selectedRowKeys"]);
    const length = selectedIds?.length;
    const isFulfilledByVendor = unfulfillmentViewType === UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR;
    const formIndexList = [];
    for (let i = 0; i < length; i++) {
      const id = selectedIds[i];
      const formIndex = makeFormInputByFragments(form, id, isFulfilledByVendor);
      formIndexList.push(...formIndex);
      formRowReset(form, id);
    }
    showProcessingMessage("출고");
    await submitBulk({
      variables: {
        ordersToFulfill: formIndexList,
      },
    });
    destroyProcessingMessage();
  }
}

// TODO: VsPurchaseOrderLinesDispatchFulfillmentModal, makeFormInputByFragments, submitByFragments 에 출고 로직 처리가 3군데를 해야함 -> 개선 필요
const submitByFragments = async (
  form: FormInstance<any>,
  id: React.Key,
  submit: MutationFunction<FulfillOrder, FulfillOrderVariables>,
  isFulfilledByVendor: boolean
) => {
  const record: OrderLineListForFulfill_orderLines_edges_node = form.getFieldValue(["records", id]);
  const quantityUnfulfilled = record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded;
  const isMoqInteger = checkIsInteger(record.variant?.product?.moq);
  const isUoqInteger = checkIsInteger(record.variant?.product?.uoq);

  // 직거래 상품 화물차 배송은 1개씩 출고 보내지 않고 미출고 수량 전체를 한꺼번에 출고 처리
  if (isFulfilledByVendor) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: quantityUnfulfilled, warehouse: undefined }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    await submit({ variables: formIndex });
    return;
  }

  const stocks = makeStocksDataForOrderLine(record);
  if (stocks.length <= 0) {
    showNotificationError("물류 창고 정보를 확인해 주세요.");
    return;
  }

  // TODO: 창고 여러개인 경우 일괄 출고 로직 수정 필요
  // TODO: 소수점 moq 상품 출고 정책 결정되면 로직 수정 필요
  const stock = stocks[0];
  const isAdjustPriceMode = record.variant.isAdjustPrice;
  // 납품 시 납품금액 확정 모드에서만 박스 당 수량으로 배송 박스 정해서 출고 로직 처리함. -> 추후 박스 당 중량 사용 제품은 모두 이 로직 적용으로 개선 고려
  if (isAdjustPriceMode) {
    const qtyPerDeliveryBox = record.variant.qtyPerDeliveryBox;
    const deliveryBoxCount = getDeliveryBoxCountConsiderAdjustPricePv(record.variant, quantityUnfulfilled);
    let totalFulfilledQty = 0;
    for (let j = 0; j < deliveryBoxCount; j++) {
      const fulfillQty = j !== deliveryBoxCount - 1 ? qtyPerDeliveryBox : quantityUnfulfilled - totalFulfilledQty;
      totalFulfilledQty += fulfillQty;
      const formIndex = form.getFieldValue([id]);
      formIndex.input.lines[0].stocks = [{ quantity: fulfillQty, warehouse: stock.warehouse.id }];
      formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
      await submit({ variables: formIndex });
    }
    return;
  }
  // isB2b 케이스만 소수점 주문 사용으로 남아 있어서 VsPurchaseOrderLinesDispatchFulfillmentModal 에서는 isB2b 케이스로 처리되고 있음
  if (isMoqInteger === false || isUoqInteger === false) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: quantityUnfulfilled, warehouse: stock.warehouse.id }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    await submit({ variables: formIndex });
    return;
  }
  for (let j = 0; j < quantityUnfulfilled; j++) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: 1, warehouse: stock.warehouse.id }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    await submit({ variables: formIndex });
  }
};

// TODO: VsPurchaseOrderLinesDispatchFulfillmentModal, makeFormInputByFragments, submitByFragments 에 출고 로직 처리가 3군데를 해야함 -> 개선 필요
const makeFormInputByFragments = (form: FormInstance<any>, id: React.Key, isFulfilledByVendor: boolean) => {
  const record: OrderLineListForFulfill_orderLines_edges_node = form.getFieldValue(["records", id]);
  const quantityUnfulfilled = record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded;
  const isMoqInteger = checkIsInteger(record.variant?.product?.moq);
  const isUoqInteger = checkIsInteger(record.variant?.product?.uoq);

  // 직거래 상품 화물차 배송은 1개씩 출고 보내지 않고 미출고 수량 전체를 한꺼번에 출고 처리
  const formIndexList = [];
  if (isFulfilledByVendor) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: quantityUnfulfilled, warehouse: undefined }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    formIndexList.push(formIndex);
    return formIndexList;
  }

  const stocks = makeStocksDataForOrderLine(record);
  if (stocks.length <= 0) {
    showNotificationError("물류 창고 정보를 확인해 주세요.");
    return;
  }
  // TODO: 창고 여러개인 경우 일괄 출고 로직 수정 필요
  // TODO: 소수점 moq 상품 출고 정책 결정되면 로직 수정 필요
  const stock = stocks[0];
  const isAdjustPriceMode = record.variant.isAdjustPrice;
  // 납품 시 납품금액 확정 모드에서만 박스 당 수량으로 배송 박스 정해서 출고 로직 처리함. -> 추후 박스 당 중량 사용 제품은 모두 이 로직 적용으로 개선 고려
  if (isAdjustPriceMode) {
    const qtyPerDeliveryBox = record.variant.qtyPerDeliveryBox;
    const deliveryBoxCount = getDeliveryBoxCountConsiderAdjustPricePv(record.variant, quantityUnfulfilled);
    let totalFulfilledQty = 0;
    for (let j = 0; j < deliveryBoxCount; j++) {
      const fulfillQty = j !== deliveryBoxCount - 1 ? qtyPerDeliveryBox : quantityUnfulfilled - totalFulfilledQty;
      totalFulfilledQty += fulfillQty;
      const formIndex = form.getFieldValue([id]);
      formIndex.input.lines[0].stocks = [{ quantity: fulfillQty, warehouse: stock.warehouse.id }];
      formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
      formIndexList.push(formIndex);
    }
    return formIndexList;
  }
  // isB2b 케이스만 소수점 주문 사용으로 남아 있어서 VsPurchaseOrderLinesDispatchFulfillmentModal 에서는 isB2b 케이스로 처리되고 있음
  if (isMoqInteger === false || isUoqInteger === false) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: quantityUnfulfilled, warehouse: stock.warehouse.id }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    formIndexList.push(formIndex);
    return formIndexList;
  }

  for (let j = 0; j < quantityUnfulfilled; j++) {
    const formIndex = form.getFieldValue([id]);
    formIndex.input.lines[0].stocks = [{ quantity: 1, warehouse: stock.warehouse.id }];
    formIndex.input.isFulfilledByVendor = isFulfilledByVendor;
    formIndexList.push(formIndex);
  }
  return formIndexList;
};

const submitFulfillmentAll = async (
  form: FormInstance<any>,
  submit: MutationFunction<FulfillOrder, FulfillOrderVariables>
) => {
  const selectedIds = form.getFieldValue(["selectedRowKeys"]);
  const length = selectedIds?.length;
  const uniqueDeliveryMethods = new Set();
  const uniqueOrderIds = new Set();

  // finalFormValues를 초기화함.
  const finalFormValues: FulfillOrderVariables = { orderId: null, input: { lines: [], deliveryMethod: null } };

  for (let i = 0; i < length; i++) {
    const id = selectedIds[i];
    const record: OrderLineListForFulfill_orderLines_edges_node = form.getFieldValue(["records", id]);
    const quantity = form.getFieldValue(["etcFullfillmentValue", id]);

    // quantity가 값이 존재하지 않는 경우 에러
    if (!quantity) {
      showNotificationError(`'${record.composedIdWithPrefix}'의 출고 수량을 입력해주세요.`);
      return;
    }
    // quantityUnfulfilled 보다 작아야한다.
    const quantityUnfulfilled = record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded;
    if (quantity > quantityUnfulfilled) {
      showNotificationError(`'${record.composedIdWithPrefix}'의 출고 수량이 출고 대기 수량보다 많습니다.`);
      return;
    }
    // 기타배송인데, BY_COURIER이 있으면 안됨.
    if (record.order.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER) {
      showNotificationError(
        `'${record.composedIdWithPrefix}'의 배송 타입이 '택배 배송'입니다. 기타배송으로 출고할 수 없습니다.`
      );
      return;
    }
    uniqueDeliveryMethods.add(record.order.deliveryMethod);
    uniqueOrderIds.add(record.order.id);

    const stocks = makeStocksDataForOrderLine(record);
    // finalFormValue의 lines에 값을 추가한다.
    finalFormValues.input.lines.push({
      orderLineId: record.id,
      stocks: [
        {
          quantity,
          // TODO : 창고 여러개인 경우 로직 수정 필요
          warehouse: stocks[0].warehouse.id,
        },
      ],
    });
  }
  // 모든 배송의 배송타입이 동일해야 한다.
  if (uniqueDeliveryMethods.size !== 1) {
    showNotificationError(`기타 배송 출고는 동일한 배송 타입만 가능합니다.`);
    return;
  }
  // 모든 배송의 order id 가 동일해야 한다.
  if (uniqueOrderIds.size !== 1) {
    showNotificationError(`기타 배송 출고는 동일한 주문에서만 가능합니다.`);
    return;
  }
  // 배송 타입, Order Id를 가져온다.
  const deliveryMethod = uniqueDeliveryMethods.values().next().value;
  const orderId = uniqueOrderIds.values().next().value;
  // 기타 배송에 맞게 form안의 deliveryMethod 수정한다.
  finalFormValues.input.deliveryMethod = deliveryMethod;
  finalFormValues.orderId = orderId;

  await submit({ variables: finalFormValues });
};

// 재고, 위탁, 기타, 합포장
export enum UnfulfillmentViewTypeEnum {
  STOCK = "STOCK",
  CONSIGNMENT = "CONSIGNMENT",
  STOCK_ETC = "STOCK_ETC",
  PICKING_ORDER = "PICKING_ORDER",
  FULFILLED_BY_VENDOR = "FULFILLED_BY_VENDOR",
}

// 재고상품 주문접수인지
export const isUnfulfillmentViewStock = (viewEnum: UnfulfillmentViewTypeEnum) =>
  viewEnum === UnfulfillmentViewTypeEnum.STOCK;

// // 위탁상품 주문접수인지
// export const isUnfulfillmentViewConsign = (viewEnum: UnfulfillmentViewTypeEnum) =>
//   viewEnum === UnfulfillmentViewTypeEnum.CONSIGNMENT;

// 기타 배송 주문접수인지
export const isUnfulfillmentViewStockEtc = (viewEnum: UnfulfillmentViewTypeEnum) =>
  viewEnum === UnfulfillmentViewTypeEnum.STOCK_ETC;

// 합포장 배송 주문접수인지
export const isUnfulfillmentViewPickingOrder = (viewEnum: UnfulfillmentViewTypeEnum) =>
  viewEnum === UnfulfillmentViewTypeEnum.PICKING_ORDER;

export const getPageTitle = (viewEnum: UnfulfillmentViewTypeEnum) => {
  switch (viewEnum) {
    case UnfulfillmentViewTypeEnum.STOCK:
      return sectionNames.fulfillmentsA;
    case UnfulfillmentViewTypeEnum.CONSIGNMENT:
      return sectionNames.fulfillmentsB;
    case UnfulfillmentViewTypeEnum.STOCK_ETC:
      return sectionNames.fulfillmentsC;
    case UnfulfillmentViewTypeEnum.PICKING_ORDER:
      return sectionNames.fulfillmentsD;
    default:
      return "주문접수";
  }
};
</file>

