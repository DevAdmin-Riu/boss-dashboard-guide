  let displayOrder = 0;
  return [
    {
      ...createTextField(displayOrder++, CategoryFilterKeys.name_Icontains, "카테고리명", opts.name_Icontains.value),
      active: opts.name_Icontains.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        CategoryFilterKeys.type,
        "분류",
        opts.type.value,
        true,
        shopData.categoryTypes
      ),
      active: opts.type.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        CategoryFilterKeys.kind,
        "구분",
        opts.kind.value,
        true,
        categoryKindChoices
      ),
      active: opts.kind.active,
    },
  ];
}
