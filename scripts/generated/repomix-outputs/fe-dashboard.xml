import useUser from "@hooks/useUser";
import { OrderDirection, OrderLineSortField, OrderType } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import {
  useHqOrderLineListFilterDownloadQuery,
  useHqOrderLineListQuery,
} from "@src/app/views/hqStaff/hqSection/api/queries";
import { HqOrderLineListVariables } from "@src/app/views/hqStaff/hqSection/api/types/HqOrderLineList";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import OrderLineDetailListPage from "../../components/OrderLineDetailListPage";
import {
  createAdminOrderViewPathB,
  createAdminOrderViewPathC,
  createAdminOrderViewPathD,
  orderDetailsViewUrl,
  orderLineDetailListViewUrlA,
  orderLineDetailListViewUrlAll,
  orderLineDetailListViewUrlB,
  orderLineDetailListViewUrlC,
  orderLineDetailListViewUrlD,
  OrderLineDetailListViewUrlDialog,
  OrderLineDetailListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filter";

interface OrderLineDetailListViewProps {
  params: OrderLineDetailListViewUrlQueryParams;
  isAll: boolean;
}

const OrderLineDetailListView: React.FC<OrderLineDetailListViewProps> = (props) => {
  const { params, isAll } = props;
  const { user } = useUser();

  let targetUrl;

  if (params.orderType === OrderType.BY_STAFF_FOR_ETC) {
    targetUrl = orderLineDetailListViewUrlD;
  } else if (params.orderType === OrderType.BY_STAFF_FOR_BAD_STOCK) {
    targetUrl = orderLineDetailListViewUrlC;
  } else if (params.orderType === OrderType.BY_STAFF_FOR_BRAND) {
    targetUrl = orderLineDetailListViewUrlB;
  } else if (isAll) {
    targetUrl = orderLineDetailListViewUrlAll;
  } else {
    targetUrl = orderLineDetailListViewUrlA;
  }

  const createAdminOrderUrl = (orderType: OrderType) => {
    switch (orderType) {
      case OrderType.BY_STAFF_FOR_BAD_STOCK:
        return createAdminOrderViewPathC;
      case OrderType.BY_STAFF_FOR_BRAND:
        return createAdminOrderViewPathB;
      case OrderType.BY_STAFF_FOR_ETC:
        return createAdminOrderViewPathD;
      default:
        return null;
    }
  };

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.ORDER_LINE_DETAIL_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useHqOrderLineListFilterDownloadQuery);

  const queryVariables: HqOrderLineListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: { ...getFilterVariables(params, isAll), isB2b: false },
      forStaff: user.isStaff,
      sort: { direction: OrderDirection.DESC, field: OrderLineSortField.ORDER_ID },
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useHqOrderLineListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderLineDetailListViewUrlDialog, OrderLineDetailListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <OrderLineDetailListPage
        settings={settings}
        orderType={params.orderType}
        orderLines={maybe(() => data?.orderLines.edges.map((edge) => edge.node), [])}
        disabled={loading}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params, isAll)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        pageInfo={pageInfo}
        isAll={isAll}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        createAdminOrderButtonClick={() => navigate(createAdminOrderUrl(params.orderType))}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};

export default OrderLineDetailListView;
</file>

