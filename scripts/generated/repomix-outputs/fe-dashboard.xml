<file path="src/app/views/order/orders/components/RefundedListPage/RefundedListPage.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { OrderType } from "@src/api/types/globalTypes";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { RefundedListViewUrlQueryParams, RefundedListViewUrlSortField } from "@src/app/views/order/orders/urls";
import { makeNameByOrderType, sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Typography } from "antd";
import React from "react";

import {
  RefundedList,
  RefundedList_refundedOrderLines_edges_node,
  RefundedListVariables,
} from "../../api/types/RefundedList";
import { createFilterStructure, RefundedFilterKeys, RefundedListFilterOpts } from "./filters";
import { getRefundedListTableSettingsIncludeVat } from "./RefundedListTableSettings";
import { createSorterStructure } from "./sorters";

export interface RefundedListPageProps
  extends PaginateListProps,
    FilterPageProps<RefundedFilterKeys, RefundedListFilterOpts>,
    SortPage<RefundedListViewUrlSortField> {
  params: RefundedListViewUrlQueryParams;
  brandId?: string | null;
  orderType: OrderType;
  refundedList: RefundedList_refundedOrderLines_edges_node[];
  queryVariables: RefundedListVariables;
  isHqStaff: boolean;
  handleRefetch: (variables?: RefundedListVariables) => Promise<ApolloQueryResult<RefundedList>>;
  queryVariablesWithoutPagination: RefundedListVariables;
  fetchForDownload: (variables?: RefundedListVariables) => Promise<ApolloQueryResult<RefundedList>>;
}

export const RefundedListPage: React.FC<RefundedListPageProps> = (props) => {
  const {
    params,
    brandId,
    orderType,
    isHqStaff,
    refundedList,
    currentTab,
    filterOpts,
    tabs,
    sort,
    queryVariables,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onSort,
    handleRefetch,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, isHqStaff);
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const sectionName = makeNameByOrderType(orderType, sectionNames.refunded, isHqStaff, false);

  const columns = getRefundedListTableSettingsIncludeVat({ pageProps: props, orderType, isFullColumnMode: true });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "refundedOrderLines",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionName}</Typography.Title>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
              <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={true} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={refundedList}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
</file>

<file path="src/app/views/order/orders/components/RefundedListPage/RefundedListTableSettings.tsx">
import { transformPaymentStatus } from "@assets/messages/status";
import { OrderType, PgRefundEventStatusEnum } from "@src/api/types/globalTypes";
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { getBrandName, makeCombinePayMethod, makePaymentNumberFormat, makeStatusForPgRefund } from "@utils/misc";
import { utils } from "@utils/utils";
import { Tooltip, Typography } from "antd";
import React from "react";

import { RefundedList_refundedOrderLines_edges_node } from "../../api/types/RefundedList";
import { checkOrderedByStaffForBadStock, checkOrderedByStaffForBrand, checkOrderedByUser } from "../../utils";
import { RefundedListPageProps } from "./RefundedListPage";

interface RefundedListTableSettingsProps {
  pageProps?: RefundedListPageProps;
  orderType: OrderType;
  isFullColumnMode?: boolean;
}

export function getRefundedListTableSettingsIncludeVat(props: RefundedListTableSettingsProps) {
  const { pageProps, orderType, isFullColumnMode } = props;
  const { isHqStaff, onRowClick } = pageProps ? pageProps : { isHqStaff: false, onRowClick: undefined };
  const isOrderedByUser = checkOrderedByUser(orderType);
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);

  const fixedLeftFlag = utils.fixedLeftFlag();

  const columns: DownloadableColumnsType<RefundedList_refundedOrderLines_edges_node> = [];
  columns.push({
    title: columnNameConstant.order.REFUND_DATE,
    key: "created",
    width: 120,
    fixed: fixedLeftFlag,
    align: "center",
    render: (_, record) => (
      <Typography className="ant-typography-break">
        <DateTime date={record.refundedAt} />
      </Typography>
    ),
    renderExcel: (record) => getDateByFormat(record.refundedAt),
  });
  if (isOrderedByUser) {
    columns.push({
      title: columnNameConstant.common.PAYMENT_METHOD,
      key: "payMethod",
      align: "center",
      width: 100,
      render: (_, record) => makeCombinePayMethod(record.payment, record.order?.type),
    });
    columns.push({
      title: columnNameConstant.order.PG_REFUND_STATUS,
      key: "pgRefundStatus",
      align: "center",
      width: 100,
      render: (_, record) => {
        const statusText = makeStatusForPgRefund(record.transaction?.pgRefundEvent?.status);
        if (record.transaction?.pgRefundEvent?.status === PgRefundEventStatusEnum.FAIL) {
          return (
            <Tooltip title={record.transaction.pgRefundEvent?.resultMsg}>
              <Typography.Text type="danger" strong>
                {statusText}
              </Typography.Text>
            </Tooltip>
          );
        }
        return statusText;
      },
      renderExcel: (record) => makeStatusForPgRefund(record.transaction?.pgRefundEvent?.status),
    });
  }
  columns.push({
    title: columnNameConstant.order.RETURN_DELIVERY_FEE,
    key: "returnDeliveryFee",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.returnDeliveryFee} />,
    renderExcel: (record) => record.returnDeliveryFee,
  });
  columns.push({
    title: columnNameConstant.order.REFUNDED_CARD_CASH,
    key: "refundedAmount",
    align: "right",
    width: 100,
    render: (_, record) => <NumberComponent value={record.amount ? -record.amount : 0} />,
    renderExcel: (record) => (record.amount ? -record.amount : 0),
  });
  if (isOrderedByUser) {
    columns.push({
      title: columnNameConstant.order.REFUNDED_CASHABLE_CREDITS,
      key: "refundedCashableCredits",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.cashableCredits ? -record.cashableCredits : 0} />,
      renderExcel: (record) => (record.cashableCredits ? -record.cashableCredits : 0),
    });
    columns.push({
      title: columnNameConstant.order.REFUNDED_NON_CASHABLE_CREDITS,
      key: "refundedNonCashableCredits",
      align: "right",
      width: 120,
      render: (_, record) => <NumberComponent value={record.nonCashableCredits ? -record.nonCashableCredits : 0} />,
      renderExcel: (record) => (record.nonCashableCredits ? -record.nonCashableCredits : 0),
    });
    columns.push({
      title: columnNameConstant.order.REFUNDED_RCOINS,
      key: "refundedRcoins",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record.rcoins ? -record.rcoins : 0} />,
      renderExcel: (record) => (record.rcoins ? -record.rcoins : 0),
    });
  }
  if (isFullColumnMode) {
    columns.push({
      title: columnNameConstant.order.ORDER_COMPOSED_ID,
      key: "orderComposedId",
      align: "center",
      width: 100,
      render: (_, record) =>
        !isHqStaff && onRowClick ? (
          <Typography.Link onClick={() => onRowClick(record.order?.id)}>
            {record.order?.composedIdWithPrefix}
          </Typography.Link>
        ) : (
          record.order?.composedIdWithPrefix
        ),
      renderExcel: (record) => record.order?.composedIdWithPrefix,
    });
    if (isOrderedByUser) {
      if (isHqStaff === false) {
        columns.push({
          title: columnNameConstant.order.PAYMENT_NO,
          key: "paymentNumber",
          align: "right",
          width: 100,
          render: (_, record) => makePaymentNumberFormat(record.payment?.number),
        });
      }
    }
    columns.push({
      title: columnNameConstant.order.CAPTURED_DATE,
      key: "paymentDay",
      align: "center",
      width: 120,
      render: (_, record) => (
        <Typography className="ant-typography-break">
          <DateTime date={record.order?.capturedAt} />
        </Typography>
      ),
      renderExcel: (record) => getDateByFormat(record.order?.capturedAt),
    });
    if (isOrderedByStaffForBadStock) {
      columns.push({
        align: "center",
        title: columnNameConstant.order.OPEN_MALL_NAME,
        key: "openMallName",
        width: 100,
        render: (_, record) => (record?.order?.etcInfo.open_mall_name ? record?.order.etcInfo.open_mall_name : "-"),
      });
      columns.push({
        align: "center",
        title: columnNameConstant.order.OPEN_MALL_ORDER_NO,
        key: "openMallOrderNumber",
        width: 120,
        render: (_, record) =>
          record?.order?.etcInfo.open_mall_order_number ? record?.order.etcInfo.open_mall_order_number : "-",
      });
    }
  }
  columns.push({
    title: columnNameConstant.product.SKU,
    key: "productSku",
    align: "center",
    width: 120,
    render: (_, record) => record.orderLine?.productSku || "-",
  });
  columns.push({
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    width: 140,
    render: (_, record) => {
      const orderLine = record.orderLine;
      // 세트상품인 경우 bpBundle.bpSku 사용
      if (orderLine?.bpBundle?.bpSku) {
        return orderLine.bpBundle.bpSku;
      }
      return orderLine?.brandProductVariant?.bpSku || "-";
    },
  });
  columns.push({
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "orderLineProductName",
    align: "left",
    width: 150,
    render: (_, record) => {
      const orderLine = record.orderLine;
      // 세트상품인 경우 "세트 상품명 - 구성품명" 형식으로 표시
      if (orderLine?.bpBundle?.name) {
        const bundleName = orderLine.bpBundle.name;
        const matchingBundleInfo = orderLine.bpBundle.bpBundleInfos?.find(
          (info) => info?.pv?.id === orderLine.variant?.id
        );
        const componentName = matchingBundleInfo?.name || orderLine.productName;
        return `${bundleName} - ${componentName}`;
      }
      return orderLine?.productName || "-";
    },
  });
  columns.push({
    title: columnNameConstant.order.REFUNDED_QTY,
    key: "refundOrderLineQty",
    align: "right",
    width: 80,
    render: (_, record) => {
      const orderLine = record.orderLine;
      // 세트상품인 경우 quantity / bundleInfoQty로 세트 수량 계산, 아닌 경우 quantity 사용
      const qty = orderLine?.bundleInfoQty !== null ? record.quantity / orderLine.bundleInfoQty : record.quantity;
      return -1 * qty;
    },
  });
  columns.push({
    title: columnNameConstant.order.PAYMENT_STATUS,
    key: "paymentChargeStatus",
    align: "center",
    width: 100,
    render: (_, record) => (record.payment ? transformPaymentStatus(record.order).localized : "-"),
  });
  if (isFullColumnMode) {
    if (isOrderedByUser) {
      if (isHqStaff === false) {
        columns.push({
          title: columnNameConstant.brand.BRAND_NAME,
          key: "brand",
          width: 100,
          render: (_, record) => getBrandName(record.order?.user),
        });
      }
      columns.push({
        title: columnNameConstant.user.USER_NAME,
        key: "firstName",
        width: 100,
        render: (_, record) => (record.order?.user?.firstName ? record.order?.user?.firstName : "-"),
      });
    } else if (isOrderedByStaffForBrand || isOrderedByStaffForBadStock) {
      columns.push({
        title: columnNameConstant.user.USER_NAME,
        key: "firstName",
        width: 100,
        render: (_, record) =>
          record.order?.shippingAddress?.firstName ? record.order?.shippingAddress?.firstName : "-",
      });
    }
    columns.push({
      title: columnNameConstant.common.BIZ_REG_NO,
      key: "bizRegNo",
      width: 120,
      render: (_, record) => (record.order?.user?.bizRegNo ? record.order.user?.bizRegNo : "-"),
    });
  }
  return columns;
}
</file>

