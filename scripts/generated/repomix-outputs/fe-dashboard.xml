<file path="src/app/components/SortableTable/SortableTableAntd.tsx">
import Draggable from "@assets/icons/Draggable";
import { utils } from "@utils/utils";
import React from "react";
import {
  SortableContainer,
  SortableContainerProps,
  SortableElement,
  SortableHandle,
  SortEndHandler,
} from "react-sortable-hoc";

export interface DraggableContainerProps extends SortableContainerProps {
  onSortEnd: SortEndHandler;
}
export const DraggableContainer = (props: DraggableContainerProps) => {
  const SortableBody = SortableContainer((props: React.HTMLAttributes<HTMLTableSectionElement>) => (
    <tbody {...props} />
  ));
  return <SortableBody useDragHandle {...props} />;
};

export interface DraggableBodyRowProps extends React.HTMLAttributes<HTMLTableRowElement> {
  dataSource: any[];
  disabled?: boolean;
}
export const DraggableBodyRow = (props: DraggableBodyRowProps) => {
  const { dataSource, ...restProps } = props;
  const SortableItem = SortableElement((props: React.HTMLAttributes<HTMLTableRowElement>) => <tr {...props} />);
  const index = dataSource?.findIndex((data) => data.id === restProps["data-row-key"]);
  if (utils.isEmpty(index)) {
    return <></>;
  }
  return <SortableItem index={index} {...restProps} />;
};

export const DragHandle = SortableHandle(() => <Draggable style={{ cursor: "grab" }} />);
