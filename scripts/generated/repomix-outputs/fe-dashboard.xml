import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import { makerFragmentForList, vendorFragment, vendorFragmentForList } from "@src/api/fragments/vendor";
import gql from "graphql-tag";

import { Makers, MakersVariables } from "./types/Makers";
