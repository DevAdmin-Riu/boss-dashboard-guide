<file path="src/app/views/order/orders/components/CreateAdminOrderBrandProductListTable/brandProductListFilter.ts">
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { BpBundlesFilterInput, BrandProductFilterInput } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createTextField } from "@utils/filters/fields";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

enum BrandProductVariantListSearchFiltersEnum {
  brandProductSearch = "brandProductSearch",
  productSearch = "productSearch",
}
type BrandProductVariantListSearchFilters = Filters<BrandProductVariantListSearchFiltersEnum>;

enum BrandProductVariantListSearchFilterKeys {
  brandProductSearch = "brandProductSearch",
  productSearch = "productSearch",
}

interface BrandProductVariantListSearchListFilterOpts {
  brandProductSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
}

export const brandProductVariantGetFilterOpts = (
  filterVariables: BrandProductFilterInput
): BrandProductVariantListSearchListFilterOpts => ({
  brandProductSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
    value: filterVariables.brandProductSearch || "",
  },
  productSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
    value: filterVariables.productSearch || "",
  },
});

export const brandProductVariantCreateFilterStructure = (
  opts: BrandProductVariantListSearchListFilterOpts,
  isHqStaff: boolean,
  isByStaffForB2b: boolean
): IFilter<BrandProductVariantListSearchFilterKeys> => {
  let displayOrder = 0;
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      BrandProductVariantListSearchFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      BrandProductVariantListSearchFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  return [isHqStaff === false && isByStaffForB2b && productSearchFilter, brandProductSearchFilter].filter(Boolean);
};

function getFilterQueryParams(filter: IFilterElement<string>): BrandProductVariantListSearchFilters {
  const { name } = filter;
  switch (name) {
    case BrandProductVariantListSearchFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantListSearchFiltersEnum.brandProductSearch);
    case BrandProductVariantListSearchFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantListSearchFiltersEnum.productSearch);
  }
}

export function getBrandProductVariantListVariantSearchFilterVariables(
  filters: Array<IFilterElement<string>>,
  customerUserWatched: SearchCustomersForAdminOrder_search_edges_node
): BrandProductFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParams(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return {
    brandProductSearch: queryParams.brandProductSearch,
    productSearch: queryParams.productSearch,
    isDevPv: utils.isEmpty(customerUserWatched) || customerUserWatched.isHqStaff ? undefined : false,
  };
}

export function getBpBundlesListVariantSearchFilterVariables(
  filters: Array<IFilterElement<string>>
): BpBundlesFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParams(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return {
    brandProductSearch: queryParams.brandProductSearch,
  };
}
</file>

