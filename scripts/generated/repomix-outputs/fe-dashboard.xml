      {useBpSkuMode === false || customerUserWatched ? (
        <Descriptions bordered size="middle">
          <Descriptions.Item label="받는 사람(주문자)" span={3} labelStyle={{ width: 200 }}>
            {addressInfo.firstName || "-"}
          </Descriptions.Item>
          <Descriptions.Item label="받는 사람 연락처" span={3} labelStyle={{ width: 200 }}>
            {addressInfo.phone || "-"}
          </Descriptions.Item>
          <Descriptions.Item label="우편번호" span={3} labelStyle={{ width: 200 }}>
            {addressInfo.postalCode || "-"}
          </Descriptions.Item>
          <Descriptions.Item label="주소" span={3} labelStyle={{ width: 200 }}>
            {addressInfo.streetAddress1 || "-"}
          </Descriptions.Item>
          <Descriptions.Item label="상세주소" span={3} labelStyle={{ width: 200 }}>
            {addressInfo.streetAddress2 || "-"}
          </Descriptions.Item>
        </Descriptions>
      ) : useBpSkuMode ? (
        <Empty description="회원 정보를 먼저 선택해주세요." style={{ padding: 16 }} />
      ) : (
        <Empty description="배송지 주소를 설정해 주세요." style={{ padding: 16 }} />
      )}
    </Card>
  );
};

