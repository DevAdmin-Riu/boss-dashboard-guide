import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { StaffMemberStatus } from "@src/api/types/globalTypes";
import { useStaffListForAssignQuery } from "@src/app/views/settings/staff/api/queries";
import { StaffListForAssign_staffUsers_edges_node } from "@src/app/views/settings/staff/api/types/StaffListForAssign";
import { maybe } from "@utils/misc";
import { Modal, Table } from "antd";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React from "react";

export interface AssignStaffDialogProps {
  open: boolean;
  loading: boolean;
  onClose: () => void;
  onSubmit: (data: StaffListForAssign_staffUsers_edges_node) => void;
}

const AssignStaffDialog: React.FC<AssignStaffDialogProps> = (props) => {
  const { open, loading, onClose, onSubmit } = props;
  const [selectedStaffs, setSelectedStaffs] = React.useState<StaffListForAssign_staffUsers_edges_node[]>([]);

  const { data, loading: staffListLoading } = useStaffListForAssignQuery({
    skip: !open,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.mallStaffs, filter: { status: StaffMemberStatus.ACTIVE } },
  });
  const staffs = maybe(() => data?.staffUsers.edges.map((edge) => edge.node));

  const columns: ColumnsType<StaffListForAssign_staffUsers_edges_node> = [
    {
      title: "관리자",
      key: "name",
      align: "center",
      render: (_, record) => record.firstName,
    },
    {
      title: "이메일",
      key: "email",
      align: "center",
      render: (_, record) => record.email,
    },
  ];

  const rowSelection: TableRowSelection<StaffListForAssign_staffUsers_edges_node> = {
    type: "radio",
    selectedRowKeys: selectedStaffs.map((staff) => staff.id),
    onChange: (_selectedRowKeys, selectedRows) => setSelectedStaffs(selectedRows),
  };

  const handleClose = () => {
    setSelectedStaffs([]);
    onClose();
  };

  const handleSubmit = () => {
    onSubmit(selectedStaffs[0]);
    handleClose();
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="관리자 선택"
      open={open}
      onCancel={handleClose}
      onOk={handleSubmit}
      okButtonProps={{ loading, disabled: staffListLoading }}
    >
      <Table
        columns={columns}
        dataSource={staffs}
        pagination={false}
        rowKey={(record) => record.id}
        rowSelection={rowSelection}
        scroll={{ y: 450 }}
      />
    </Modal>
