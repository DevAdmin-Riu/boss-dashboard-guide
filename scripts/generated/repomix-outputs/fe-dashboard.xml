<file path="src/app/views/purchase/vendors/components/MakerCreateOrUpdateModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import useMakerSearch from "@src/api/searches/useMakerSearch";
import { MakerInput } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Table } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect } from "react";

import { useMakerCreateMutation, useMakerUpdateMutation } from "../api/mutations";
import { makerListQuery } from "../api/queries";
import { Makers_makers_edges_node } from "../api/types/Makers";

interface MakerCreateOrUpdateModalProps {
  open: boolean;
  loading: boolean;
  maker?: Makers_makers_edges_node;
  onClose: () => void;
}

export const MakerCreateOrUpdateModal: React.FC<MakerCreateOrUpdateModalProps> = (props) => {
  const { open, loading, maker, onClose } = props;
  const isCreateMode = utils.isEmpty(maker);
  const modalTitle = isCreateMode ? "제조사 추가" : `제조사 수정(${maker.code})`;
  const [form] = Form.useForm<MakerInput>();
  const initialValues: MakerInput = isCreateMode ? { name: "" } : { name: maker.name };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const { search: searchMakers, result: searchMakersOpts } = useMakerSearch({
    skip: open === false,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.makers, query: initialValues.name },
  });
  const searchedMakers = maybe(() => {
    const nodes = searchMakersOpts.data.search.edges.map((edge) => edge.node);
    if (isCreateMode) {
      return nodes;
    }
    const nodesExcludeSelectedMaker = nodes.filter((node) => node.id !== maker.id);
    return nodesExcludeSelectedMaker;
  }, []);

  const [createMaker, createMakerOpts] = useMakerCreateMutation({
    onCompleted: (data) => {
      const errors = data.makerCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("제조사가 추가되었습니다.");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [makerListQuery],
  });

  const [updateMaker, updateMakerOpts] = useMakerUpdateMutation({
    onCompleted: (data) => {
      const errors = data.makerUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const modalLoading = loading || createMakerOpts.loading || updateMakerOpts.loading;
  const onSubmit = (input: MakerInput) => {
    if (isCreateMode) {
      createMaker({ variables: { input } });
    } else {
      updateMaker({ variables: { id: maker.id, input } });
    }
  };

  const columns: ColumnsType<Makers_makers_edges_node> = [
    {
      title: columnNameConstant.vendor.MAKER_CODE,
      key: "code",
      align: "center",
      width: 100,
      render: (_, record) => record.code,
    },
    {
      title: columnNameConstant.vendor.MAKER_NAME,
      key: "name",
      align: "center",
      width: 150,
      render: (_, record) => record.name,
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={modalTitle}
      okButtonProps={{ loading: modalLoading }}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={form}
        layout="vertical"
        name="maker-create-or-update"
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Form.Item
          label="제조사명"
          name="name"
          rules={[{ required: true, message: "제조사명은 필수 입력 항목입니다." }]}
        >
          <Input placeholder="제조사명을 입력해 주세요." onChange={(e) => searchMakers(e.target.value)} />
        </Form.Item>
      </Form>
      <Table
        {...commonTableProps}
        title={() => "입력한 제조사명이 포함된 제조사 리스트"}
        loading={searchMakersOpts.loading}
        columns={columns}
        dataSource={searchedMakers}
        scroll={{ x: tableWidthSum, y: 200 }}
        locale={{ emptyText: "조회 결과 없음" }}
      />
    </Modal>
  );
};
</file>

