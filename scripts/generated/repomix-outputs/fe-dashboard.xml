<file path="src/app/views/order/orders/components/OrderDetailFulfillmentListWrap/OrderDetailFulfillmentListWrap.tsx">
import {
  FulfillmentStatus,
  OrderDeliveryMethodsEnum,
  OrderLineB2bStatusEnum,
  OrderStatus,
  PaymentChargeStatusEnum,
} from "@src/api/types/globalTypes";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { convertDeliveryTypeEnumToWord, transformIsFBV } from "@utils/misc";
import { utils } from "@utils/utils";
import { Badge, Button, Card, Descriptions, Divider, Empty, Space, Typography } from "antd";
import moment from "moment";
import React, { useMemo } from "react";

import {
  OrderDetails_order,
  OrderDetails_order_fulfillments,
  OrderDetails_order_lines,
} from "../../api/types/OrderDetails";
import {
  checkFbvOrderLineExist,
  getBossQuantityBeforeDelivery,
  getBossQuantityRefunded,
  getBossQuantityTotal,
  getBossQuantityTracking,
  getBossQuantityTrackingCompleted,
} from "../../utils";
import { OrderDetailsFulfilledItems } from "../OrderDetailsFulfilledItems";
import { ExtendedOrderDetailsOrderLine } from "../OrderDetailsPage/OrderDetailsPage";
import { OrderDetailsUnfulfilledItems } from "../OrderDetailsUnfulfilledItems";

interface OrderDetailFulfillmentListWrapProps {
  order: OrderDetails_order;
  unfulfilledOrderLines: ExtendedOrderDetailsOrderLine[];
  deliveryPendingOrderLines: ExtendedOrderDetailsOrderLine[];
  isHqStaff: boolean;
  couriers: CourierList_couriers_edges_node[];
  isB2bOrder: boolean;

  onEstimatedArrivalDateUpdate: () => void;
  onFulfillmentCancel: (id: string) => void;
  onFulfillmentUpdateTrackingForCourier: (id: string) => void;
  onFulfillmentUpdateTrackingForNonCourier: (id: string) => void;
  onFulfillmentUpdateTrackingForDs: (id: string) => void;
  onFulfillmentUpdateTrackingForCompleted: (id: string) => void;
}

export enum OrderDeliveryCountKeys {
  BossTotal = "bossTotal",
  BossBeforeDelivery = "bossBeforeDelivery",
  BossTracking = "bossTracking",
  BossTrackingCompleted = "bossTrackingCompleted",
  BossRefunded = "bossRefunded",
  BossCanceled = "bossCanceled",
  // 직거래 상품 배송 상태
  FbvTotal = "fbvTotal",
  FbvBeforeDelivery = "fbvBeforeDelivery",
  FbvTracking = "fbvTracking",
  FbvTrackingCompleted = "fbvTrackingCompleted",
  FbvRefunded = "fbvRefunded",
  FbvCanceled = "fbvCanceled",
  // B2B 주문 상태
  B2bTotal = "b2bTotal",
  B2bReceived = "b2bReceived",
  B2bTrackingProcessing = "b2bTrackingProcessing",
  B2bCanceled = "b2bCanceled",
}

const OrderDetailFulfillmentListWrap: React.FC<OrderDetailFulfillmentListWrapProps> = (props) => {
  const {
    order,
    unfulfilledOrderLines,
    deliveryPendingOrderLines,
    onEstimatedArrivalDateUpdate,
    onFulfillmentCancel,
    onFulfillmentUpdateTrackingForCourier,
    onFulfillmentUpdateTrackingForNonCourier,
    onFulfillmentUpdateTrackingForDs,
    onFulfillmentUpdateTrackingForCompleted,
    isHqStaff,
    couriers,
    isB2bOrder,
  } = props;

  const [currentKey, setCurrentKey] = React.useState<OrderDeliveryCountKeys>(
    isB2bOrder ? OrderDeliveryCountKeys.B2bTotal : OrderDeliveryCountKeys.BossTotal
  );
  const { lines, fulfillments, deliveryMethod, deliveryCount } = order;
  const existFulfilledByVendorOrder = checkFbvOrderLineExist(lines);
  const deliveryMethodText = convertDeliveryTypeEnumToWord(deliveryMethod);
  const isByCourier = deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER;

  const makeEstimatedArrivalDateUi = () => {
    const estimatedArrivalDateMoment = moment(order?.estimatedArrivalDate);
    const estimatedArrivalDateText = estimatedArrivalDateMoment.isValid()
      ? estimatedArrivalDateMoment.format(onlyDateFormat)
      : "미지정";
    const isEmpty = utils.isEmpty(order?.estimatedArrivalDate);

    const OnEstimatedArrivalDateUpdate = () => {
      if (isHqStaff) {
        return <></>;
      }
      return (
        <Button size="small" onClick={onEstimatedArrivalDateUpdate}>
          수정
        </Button>
      );
    };

    return (
      <Typography>
        {isEmpty ? (
          <Space>
            <Typography.Text type="secondary">상관없음</Typography.Text>
            <OnEstimatedArrivalDateUpdate />
          </Space>
        ) : (
          <Space>
            <Typography>
              <Typography.Text mark={estimatedArrivalDateMoment.isValid()}>{estimatedArrivalDateText}</Typography.Text>
            </Typography>
            <OnEstimatedArrivalDateUpdate />
          </Space>
        )}
      </Typography>
    );
  };

  // QuantityBeforeDelivery 배송 전에는 fulfillment, unfillment 석여있으므로 두군데 다 노출되어야한다.
  const useOrderLineList = useMemo(
    () =>
      [
        OrderDeliveryCountKeys.BossTotal,
        OrderDeliveryCountKeys.BossBeforeDelivery,
        OrderDeliveryCountKeys.BossCanceled,
        OrderDeliveryCountKeys.FbvTotal,
        OrderDeliveryCountKeys.FbvBeforeDelivery,
        OrderDeliveryCountKeys.FbvCanceled,
      ].includes(currentKey),
    [currentKey]
  );

  const useFulfillmentList = useMemo(
    () =>
      [
        OrderDeliveryCountKeys.BossTracking,
        OrderDeliveryCountKeys.BossTrackingCompleted,
        OrderDeliveryCountKeys.BossRefunded,
        OrderDeliveryCountKeys.FbvTracking,
        OrderDeliveryCountKeys.FbvTrackingCompleted,
        OrderDeliveryCountKeys.FbvRefunded,
      ].includes(currentKey),
    [currentKey]
  );

  // B2B 주문 상태는 별도로 관리
  const useB2bOrderLineList = useMemo(
    () =>
      [
        OrderDeliveryCountKeys.B2bTotal,
        OrderDeliveryCountKeys.B2bReceived,
        OrderDeliveryCountKeys.B2bTrackingProcessing,
        OrderDeliveryCountKeys.B2bCanceled,
      ].includes(currentKey),
    [currentKey]
  );

  const isOrderCanceled =
    order.status === OrderStatus.CANCELED ||
    (order.paymentStatus === PaymentChargeStatusEnum.FULLY_REFUNDED && order.status === OrderStatus.UNFULFILLED);

  const getDeliveryCountItems = (isFulfilledByVendor: boolean) => {
    const totalKey = isFulfilledByVendor ? OrderDeliveryCountKeys.FbvTotal : OrderDeliveryCountKeys.BossTotal;
    const beforeDeliveryKey = isFulfilledByVendor
      ? OrderDeliveryCountKeys.FbvBeforeDelivery
      : OrderDeliveryCountKeys.BossBeforeDelivery;
    const trackingKey = isFulfilledByVendor ? OrderDeliveryCountKeys.FbvTracking : OrderDeliveryCountKeys.BossTracking;
    const trackingCompletedKey = isFulfilledByVendor
      ? OrderDeliveryCountKeys.FbvTrackingCompleted
      : OrderDeliveryCountKeys.BossTrackingCompleted;
    const refundedKey = isFulfilledByVendor ? OrderDeliveryCountKeys.FbvRefunded : OrderDeliveryCountKeys.BossRefunded;
    const canceledKey = isFulfilledByVendor ? OrderDeliveryCountKeys.FbvCanceled : OrderDeliveryCountKeys.BossCanceled;

    const {
      fbvQuantityTotal,
      fbvQuantityBeforeDelivery,
      fbvQuantityTracking,
      fbvQuantityTrackingCompleted,
      fbvQuantityRefunded,
    } = deliveryCount;
    const quantityTotal = isFulfilledByVendor ? fbvQuantityTotal : getBossQuantityTotal(deliveryCount);
    const quantityBeforeDelivery = isFulfilledByVendor
      ? fbvQuantityBeforeDelivery
      : getBossQuantityBeforeDelivery(deliveryCount);
    const quantityTracking = isFulfilledByVendor ? fbvQuantityTracking : getBossQuantityTracking(deliveryCount);
    const quantityTrackingCompleted = isFulfilledByVendor
      ? fbvQuantityTrackingCompleted
      : getBossQuantityTrackingCompleted(deliveryCount);
    const quantityRefunded = isFulfilledByVendor ? fbvQuantityRefunded : getBossQuantityRefunded(deliveryCount);

    return [
      { label: "전체 상품", key: totalKey, count: quantityTotal },
      { label: "미배송", key: beforeDeliveryKey, count: quantityBeforeDelivery },
      { label: "배송 중", key: trackingKey, count: quantityTracking },
      { label: "배송 완료", key: trackingCompletedKey, count: quantityTrackingCompleted },
      { label: "반품", key: refundedKey, count: isOrderCanceled ? 0 : quantityRefunded },
      { label: "취소", key: canceledKey, count: isOrderCanceled ? quantityTotal : 0 },
    ];
  };

  const getB2bDeliveryCountItems = (lines: OrderDetails_order_lines[]) => {
    const b2bTotalCount = lines.length;
    const b2bReceivedCount = lines.filter((line) => line.b2bStatus === OrderLineB2bStatusEnum.RECEIVED).length;
    const b2bTrackingProcessingCount = lines.filter((line) =>
      [OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT, OrderLineB2bStatusEnum.COMPLETED].includes(line.b2bStatus)
    ).length;
    const b2bTrackingCanceledCount = lines.filter((line) => line.b2bStatus === OrderLineB2bStatusEnum.CANCELED).length;
    return [
      { label: "전체 상품", key: OrderDeliveryCountKeys.B2bTotal, count: b2bTotalCount },
      { label: "접수", key: OrderDeliveryCountKeys.B2bReceived, count: b2bReceivedCount },
      { label: "처리중", key: OrderDeliveryCountKeys.B2bTrackingProcessing, count: b2bTrackingProcessingCount },
      { label: "취소", key: OrderDeliveryCountKeys.B2bCanceled, count: b2bTrackingCanceledCount },
    ];
  };

  const onDeliveryStatusBtnClick = (e) => {
    const target = e.currentTarget;
    const key = target.dataset.key;

    setCurrentKey(key);
  };

  const makeDeliveryStatusButtons = (isFulfilledByVendor: boolean) => {
    const deliveryCountItems = isB2bOrder
      ? getB2bDeliveryCountItems(lines)
      : getDeliveryCountItems(isFulfilledByVendor) || [];
    return (
      <div className="fulfillment-wrap">
        {deliveryCountItems.map((item) => {
          const isActive = item.key === currentKey;
          return (
            <Badge key={item.key} count={item.count} className="fulfillment-wrap__item">
              <Button onClick={onDeliveryStatusBtnClick} data-key={item.key} type={isActive ? "primary" : "default"}>
                {item.label}
              </Button>
            </Badge>
          );
        })}
      </div>
    );
  };

  const tabFilterForFulfillment = (fulfillment: OrderDetails_order_fulfillments) => {
    const isFulfilledByVendor = fulfillment.isFulfilledByVendor;
    const isFulfilledByBoss = isFulfilledByVendor === false;
    const isTracking =
      fulfillment.status === FulfillmentStatus.FULFILLED &&
      fulfillment.trackingNumber !== "" &&
      !fulfillment.isTrackingCompleted;
    const isTrackingCompleted = fulfillment.isTrackingCompleted;
    const isRefunded = isOrderCanceled === false && fulfillment.status === FulfillmentStatus.REFUNDED;

    switch (currentKey) {
      case OrderDeliveryCountKeys.BossTracking:
        return isFulfilledByBoss && isTracking;
      case OrderDeliveryCountKeys.BossTrackingCompleted:
        return isFulfilledByBoss && isTrackingCompleted;
      case OrderDeliveryCountKeys.BossRefunded:
        return isFulfilledByBoss && isRefunded;
      case OrderDeliveryCountKeys.FbvTracking:
        return isFulfilledByVendor && isTracking;
      case OrderDeliveryCountKeys.FbvTrackingCompleted:
        return isFulfilledByVendor && isTrackingCompleted;
      case OrderDeliveryCountKeys.FbvRefunded:
        return isFulfilledByVendor && isRefunded;
      default:
        return false;
    }
  };

  const tabFilterForOrderLine = (orderLine: ExtendedOrderDetailsOrderLine) => {
    const isFulfilledByVendor = orderLine.isFulfilledByVendor;
    const isFulfilledByBoss = isFulfilledByVendor === false;

    switch (currentKey) {
      case OrderDeliveryCountKeys.B2bTotal:
      case OrderDeliveryCountKeys.B2bTrackingProcessing:
      case OrderDeliveryCountKeys.B2bCanceled:
      case OrderDeliveryCountKeys.BossTotal:
      case OrderDeliveryCountKeys.BossBeforeDelivery:
        return isFulfilledByBoss;
      case OrderDeliveryCountKeys.BossCanceled:
        return isOrderCanceled && isFulfilledByBoss;
      case OrderDeliveryCountKeys.FbvTotal:
      case OrderDeliveryCountKeys.FbvBeforeDelivery:
        return isFulfilledByVendor;
      case OrderDeliveryCountKeys.FbvCanceled:
        return isOrderCanceled && isFulfilledByVendor;
      default:
        return false;
    }
  };

  const filterFulfillments = useFulfillmentList ? fulfillments.filter(tabFilterForFulfillment) : [];
  let filterOrderLines: ExtendedOrderDetailsOrderLine[] = [];
  let filterB2bOrderLines: ExtendedOrderDetailsOrderLine[] = [];
  let filterDeliveryPendingOrderLines: ExtendedOrderDetailsOrderLine[] = [];
  if (useOrderLineList) {
    const targetOrderLines: ExtendedOrderDetailsOrderLine[] = [
      OrderDeliveryCountKeys.BossBeforeDelivery,
      OrderDeliveryCountKeys.FbvBeforeDelivery,
    ].includes(currentKey)
      ? unfulfilledOrderLines || []
      : lines;
    filterOrderLines = targetOrderLines.filter(tabFilterForOrderLine);
    filterDeliveryPendingOrderLines = deliveryPendingOrderLines.filter(tabFilterForOrderLine);
  }

  if (useB2bOrderLineList) {
    const targetB2bOrderLines =
      [
        OrderDeliveryCountKeys.B2bTotal,
        OrderDeliveryCountKeys.B2bReceived,
        OrderDeliveryCountKeys.B2bTrackingProcessing,
        OrderDeliveryCountKeys.B2bCanceled,
      ].includes(currentKey) && lines;

    if (currentKey === OrderDeliveryCountKeys.B2bCanceled) {
      filterB2bOrderLines = targetB2bOrderLines.filter((item) => item.b2bStatus === OrderLineB2bStatusEnum.CANCELED);
    } else if (currentKey === OrderDeliveryCountKeys.B2bTrackingProcessing) {
      filterB2bOrderLines = targetB2bOrderLines.filter((item) =>
        [OrderLineB2bStatusEnum.COMPLETED, OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT].includes(item.b2bStatus)
      );
    } else if (currentKey === OrderDeliveryCountKeys.B2bReceived) {
      filterB2bOrderLines = targetB2bOrderLines.filter((item) => item.b2bStatus === OrderLineB2bStatusEnum.RECEIVED);
    } else {
      filterB2bOrderLines = targetB2bOrderLines.filter(tabFilterForOrderLine);
    }
  }

  const showOrderDetailsUnfulfilledItems =
    isB2bOrder === false &&
    ((useOrderLineList && filterOrderLines.length > 0) ||
      (filterDeliveryPendingOrderLines && filterDeliveryPendingOrderLines.length > 0));
  const showOrderDetailsFulfilledItems = isB2bOrder === false && useFulfillmentList && filterFulfillments.length > 0;
  const showB2bOrderDetailItems = isB2bOrder && useB2bOrderLineList && filterB2bOrderLines.length > 0;
  return (
    <Space direction="vertical" size="large">
      <Card title={<CardTitleAntd title="상품 배송 정보" />}>
        <Space direction="vertical" size="large">
          <Descriptions bordered column={1} size="small" labelStyle={{ width: 120, whiteSpace: "nowrap" }}>
            <Descriptions.Item label="배송 방식">{deliveryMethodText}</Descriptions.Item>
            {isByCourier === false && (
              <Descriptions.Item label="납품요청일">{makeEstimatedArrivalDateUi()}</Descriptions.Item>
            )}
          </Descriptions>
          {existFulfilledByVendorOrder ? (
            <Space direction="vertical">
              <Typography.Title level={5}>{transformIsFBV(false)} 상품</Typography.Title>
              {makeDeliveryStatusButtons(false)}
              <Divider />
              <Typography.Title level={5}>{transformIsFBV(true)} 상품</Typography.Title>
              {makeDeliveryStatusButtons(true)}
            </Space>
          ) : (
            makeDeliveryStatusButtons(false)
          )}
        </Space>

        <Divider dashed style={{ margin: "12px 0px" }} />

        <Space direction="vertical" size="large">
          {showOrderDetailsUnfulfilledItems && (
            <>
              {filterOrderLines.length > 0 && (
                <OrderDetailsUnfulfilledItems
                  order={order}
                  orderLines={filterOrderLines}
                  isHqStaff={isHqStaff}
                  currentKey={currentKey}
                  couriers={couriers}
                />
              )}

              {[OrderDeliveryCountKeys.BossBeforeDelivery, OrderDeliveryCountKeys.FbvBeforeDelivery].includes(
                currentKey
              ) &&
                filterDeliveryPendingOrderLines.length > 0 && (
                  <OrderDetailsUnfulfilledItems
                    order={order}
                    orderLines={filterDeliveryPendingOrderLines}
                    isHqStaff={isHqStaff}
                    currentKey={currentKey}
                    isDeliveryPending={true}
                    couriers={couriers}
                  />
                )}
            </>
          )}

          {showB2bOrderDetailItems && (
            <OrderDetailsUnfulfilledItems
              order={order}
              orderLines={filterB2bOrderLines}
              isHqStaff={isHqStaff}
              currentKey={currentKey}
              isB2bOrder={isB2bOrder}
              couriers={couriers}
              fulfillments={fulfillments}
            />
          )}

          {showOrderDetailsFulfilledItems &&
            filterFulfillments.map((item) => {
              const fulfillmentId = item.id;

              return (
                <React.Fragment key={fulfillmentId}>
                  <OrderDetailsFulfilledItems
                    order={order}
                    fulfillment={item}
                    onFulfillmentCancel={() => onFulfillmentCancel(fulfillmentId)}
                    onFulfillmentUpdateTrackingForCourier={() => onFulfillmentUpdateTrackingForCourier(fulfillmentId)}
                    onFulfillmentUpdateTrackingForNonCourier={() =>
                      onFulfillmentUpdateTrackingForNonCourier(fulfillmentId)
                    }
                    onFulfillmentUpdateTrackingForDs={() => onFulfillmentUpdateTrackingForDs(fulfillmentId)}
                    onFulfillmentUpdateTrackingForCompleted={() =>
                      onFulfillmentUpdateTrackingForCompleted(fulfillmentId)
                    }
                    couriers={couriers}
                    isHqStaff={isHqStaff}
                  />
                </React.Fragment>
              );
            })}
          {!showOrderDetailsUnfulfilledItems && !showOrderDetailsFulfilledItems && !showB2bOrderDetailItems && (
            <Card type="inner">
              <Empty description="해당 상태인 상품이 없습니다." />
            </Card>
          )}
        </Space>
      </Card>
    </Space>
  );
};

export default OrderDetailFulfillmentListWrap;
</file>

<file path="src/app/views/order/orders/components/OrderDetailsPage/OrderDetailsPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { FulfillmentTypeColor } from "@assets/constants/colors";
import { makeNameByOrderType, sectionNames } from "@assets/messages/sectionNames";
import { OrderStatus, PaymentChargeStatusEnum, RefundQAStatus } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import CardMenu from "@src/app/components/CardMenu";
import Grid from "@src/app/components/Grid";
import { DateTime } from "@src/app/providers/DateProvider/DateTime";
import { OrderRefundQuestion } from "@src/app/views/order/orders/components/OrderRefundQuestion";
