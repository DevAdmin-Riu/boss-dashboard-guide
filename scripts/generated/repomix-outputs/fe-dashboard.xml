  DownloadableEditableColumnsType,
  DownloadableEditableColumnType,
} from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { NumberComponent } from "@src/app/components/Number";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { ShopInfo_shop_stoppedReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformOnOff, transformSalesStatusByBrandProductVariant, transformStoppedReason } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Tag } from "antd";
import React from "react";

import { BpBundles_bpBundles_edges_node } from "../../api/types/BpBundles";
import { makeBundleBrandProfitRate, makeBundleDiscountRate, makeBundleProfitRate } from "../BrandProductListPage/utils";

type BrandBundleTableDataType = BpBundles_bpBundles_edges_node & { no?: number };

interface BrandBundleListTableColumnProps {
  navigate?: UseNavigatorResult;
  disabled: boolean;
  onProductBundleUpdate: (record: BpBundles_bpBundles_edges_node) => void;
  onProductBundleDelete: (record: BpBundles_bpBundles_edges_node) => void;
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[];
}

export const getBrandBundleListTableColumns = (
  props: BrandBundleListTableColumnProps
): DownloadableEditableColumnsType<BrandBundleTableDataType> => {
  const { disabled, onProductBundleUpdate, onProductBundleDelete, stoppedReasonChoices } = props;

  const fixedLeftFlag = utils.fixedLeftFlag();
  const fixedRightFlag = utils.fixedRightFlag();

  // No 컬럼
  const noColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: "No",
    key: "no",
    align: "center",
    fixed: fixedLeftFlag,
    width: 60,
    render: (_text, _record, index) => index + 1,
    isPickerHide: true,
  };

  // 상품코드 컬럼
  const productCodeColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    fixed: fixedLeftFlag,
    width: 140,
    render: (_, record) => record.bpSku || "-",
    isPickerHide: true,
  };

  // 상품명 컬럼
  const productNameColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "name",
    align: "left",
    width: 200,
    render: (_, record) => record.name || "-",
  };

  // 현금 전용 컬럼
  const cashOnlyColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.CASH_ONLY,
    key: "isOnlyPayableByCash",
    align: "center",
    width: 100,
    render: (_, record) => transformOnOff(record.isOnlyPayableByCash),
  };

  // 충전금 혜택 컬럼
  const depositBenefitColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.POINT_BENEFIT,
    key: "isRcoinRewardForUsingPoint",
    align: "center",
    width: 120,
    render: (_, record) => transformOnOff(record.isRcoinRewardForUsingPoint),
  };

  // 판매 상태 컬럼
  const salesStatusColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "salesStatus",
    align: "center",
    width: 100,
    render: (_, record) => {
      const salesStatus = record.salesStatus;
      const tagColor = salesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
      const tagText = transformSalesStatusByBrandProductVariant(salesStatus);
      return <Tag color={tagColor}>{tagText}</Tag>;
    },
    renderExcel: (record) => transformSalesStatusByBrandProductVariant(record.salesStatus),
  };

  // 중단일 컬럼
  const stoppedDateColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.STOPPED_DATE,
    key: "stoppedAt",
    align: "center",
    width: 120,
    render: (_, record) => <DateTime date={record.stoppedAt} onlyDate />,
    renderExcel: (record) => getDateByFormat(record.stoppedAt, onlyDateFormat),
  };

  // 중단사유 컬럼
  const stoppedReasonColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.STOPPED_REASON,
    key: "stoppedReason",
    align: "left",
    width: 150,
    render: (_, record) => transformStoppedReason(stoppedReasonChoices, record.stoppedReason, record.stoppedReasonEtc),
  };

  // 진열 상태 컬럼
  const displayStatusColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brand.DISPLAY_STATUS,
    key: "forceNoNormalDisplay",
    align: "center",
    width: 100,
    render: (_, record) => (record.forceNoNormalDisplay ? "숨김" : "진열"),
  };

  // 브랜드 상품가 컬럼 (ⓐ) - 구성품의 공급원가 합계
  const brandProductPriceColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_PRICE,
    key: "brandProductPrice",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.costPriceExcludeVat ?? 0} />,
    renderExcel: (record) => record.costPriceExcludeVat ?? 0,
  };

  // 브랜드 배송비 컬럼 (VAT 제외)
  const deliveryFeeExcludeVatColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_DELIVERY_FEE,
    key: "deliveryFeeExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.deliveryFeeAmount ?? 0) ?? 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.deliveryFeeAmount ?? 0) ?? 0,
  };

  // 브랜드 판매가 컬럼 (공급원가 + 브랜드 배송비, VAT 제외)
  const brandPriceExcludeVatColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_SALE_PRICE,
    key: "brandPriceExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => {
      const deliveryFeeExcludeVat = toPriceExcludeVat(record.deliveryFeeAmount ?? 0) ?? 0;
      const brandPriceExcludeVat = (record.costPriceExcludeVat ?? 0) + deliveryFeeExcludeVat;
      return <NumberComponent value={brandPriceExcludeVat} />;
    },
    renderExcel: (record) => {
      const deliveryFeeExcludeVat = toPriceExcludeVat(record.deliveryFeeAmount ?? 0) ?? 0;
      return (record.costPriceExcludeVat ?? 0) + deliveryFeeExcludeVat;
    },
  };

  // 매장 판매가 컬럼 (VAT 제외)
  const priceExcludeVatColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE,
    key: "priceExcludeVat",
    align: "right",
    width: 120,
    render: (_, record) => {
      const priceExcludeVat = (record.priceAmount ?? 0) - (record.priceVat ?? 0);
      return <NumberComponent value={priceExcludeVat} />;
    },
    renderExcel: (record) => (record.priceAmount ?? 0) - (record.priceVat ?? 0),
  };

  // 도서산간 추가 배송비 청구 컬럼
  const additionalDeliveryFeeColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brand.DELIVERY_ADDITIONAL_DELIVERY_FEE_CHARGED.join(" "),
    key: "needDeliveryAdditionalFee",
    align: "center",
    width: 180,
    render: (_, record) => transformOnOff(record.needDeliveryAdditionalFee),
  };

  // 할인 표시 컬럼
  const discountDisplayColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.DISCOUNT_DISPLAY,
    key: "discountDisplay",
    align: "center",
    width: 100,
    render: (_, record) => transformOnOff(record.showBeforePrice),
  };

  // 할인 전 판매가 컬럼 (VAT 제외)
  const beforePriceExcludeVatColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.SALE_PRICE_BEFORE_DISCOUNT,
    key: "beforePriceExcludeVat",
    align: "right",
    width: 140,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.beforePriceAmount ?? 0) ?? 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.beforePriceAmount ?? 0) ?? 0,
  };

  // 할인율 컬럼
  const discountRateColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.brandProduct.DISCOUNT_RATE,
    key: "discountRate",
    align: "right",
    width: 100,
    render: (_, record) => makeBundleDiscountRate(record),
  };

  // 당사 매익률 컬럼
  const profitRateColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.performance.COMPANY_PROFIT_RATE,
    key: "profitRate",
    align: "right",
    width: 120,
    render: (_, record) => makeBundleProfitRate(record),
  };

  // 가맹본부 매익률 컬럼
  const brandProfitRateColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: columnNameConstant.performance.FRANCHISE_PROFIT_RATE,
    key: "brandProfitRate",
    align: "right",
    width: 140,
    render: (_, record) => makeBundleBrandProfitRate(record),
  };

  // 세트 구성 버튼 컬럼
  const bundleInfoColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: "세트 구성",
    key: "bundleInfo",
    align: "center",
    fixed: fixedRightFlag,
    width: 120,
    render: (_, record) => (
      <Button size="small" type="primary" disabled={disabled} onClick={() => onProductBundleUpdate(record)}>
        상세보기
      </Button>
    ),
    doNotRenderExcel: true,
  };

  // 세트 상품 삭제 컬럼
  const deleteColumn: DownloadableEditableColumnType<BrandBundleTableDataType> = {
    title: "삭제",
    key: "delete",
    align: "center",
    fixed: fixedRightFlag,
    width: 120,
    render: (_, record) => (
      <Button size="small" danger disabled={disabled} onClick={() => onProductBundleDelete(record)}>
        삭제
      </Button>
    ),
    doNotRenderExcel: true,
  };

  return [
    noColumn,
    productCodeColumn,
    productNameColumn,
    cashOnlyColumn,
    depositBenefitColumn,
    salesStatusColumn,
    stoppedDateColumn,
    stoppedReasonColumn,
    displayStatusColumn,
    brandProductPriceColumn,
    deliveryFeeExcludeVatColumn,
    brandPriceExcludeVatColumn,
    priceExcludeVatColumn,
    additionalDeliveryFeeColumn,
    discountDisplayColumn,
    beforePriceExcludeVatColumn,
    discountRateColumn,
    profitRateColumn,
    brandProfitRateColumn,
    bundleInfoColumn,
    deleteColumn,
  ];
};
</file>

<file path="src/app/views/brand/brands/components/BrandCollapseComponents/BrandBasicInfo.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useMenuSearch from "@src/api/searches/useMenuSearch";
import { BrandCreateInput, BrandUpdateInput } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField, { NonEditableField } from "@src/app/components/EditableField/EditableField";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Col, Row } from "antd";
import React from "react";

import { BrandDetails_brand } from "../../api/types/BrandDetails";

interface CommonProps {
  TypeSafeForm: TypeSafeForm<BrandCreateInput | BrandUpdateInput>;
}
interface CreateProps {
  isCreate: true;
}
interface UpdateProps {
  isCreate: false;
  editMode: boolean;
  brand: BrandDetails_brand;
}
type BrandBasicInfoProps = CommonProps & (CreateProps | UpdateProps);

export const BrandBasicInfo: React.FC<BrandBasicInfoProps> = (props) => {
  const { isCreate, TypeSafeForm } = props;
  const isUpdate = isCreate === false;
  const shopData = useShop();

  const {
    loadMore: loadMoreMenus,
    search: searchMenus,
    result: searchMenusOpts,
  } = useMenuSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });
  const menuList = maybe(() => searchMenusOpts.data.search.edges.map((edge) => edge.node), []);
  const searchedMenuOptions = menuList.map((menu) => ({ label: menu.name, value: menu.id }));
  const menuOptions = isUpdate
    ? utils.getOptionsWithInitialValue(
        searchedMenuOptions,
        props.brand.homepageList?.id,
        props.brand.homepageList?.name
      )
    : searchedMenuOptions;

  const realEditMode = isCreate || (isUpdate && props.editMode);
  return (
    <>
      <Row gutter={[8, 0]} align="stretch">
        <Col
          xs={24}
          sm={4}
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          <Row justify={"center"}>
            <EditableField
              type="upload"
              listType="picture-card"
              uploadText={"BI 업로드"}
              name={TypeSafeForm.getValidDataIndex("image")}
              value={TypeSafeForm.getFieldValue("image")}
              editMode={realEditMode}
              singleFileMode={true}
            />
          </Row>
        </Col>

        <Col xs={24} sm={20}>
          <Row gutter={[8, 0]}>
            <Col xs={24} sm={4}>
              <EditableField
                label="브랜드명"
                type="input"
                name={TypeSafeForm.getValidDataIndex("name")}
                value={TypeSafeForm.getFieldValue("name")}
                editMode={realEditMode}
                rules={[{ required: true }]}
              />
            </Col>
            <Col xs={24} sm={4}>
              <EditableField
                label="업종"
                type="select"
                options={shopData.bizTypeChoices}
                name={TypeSafeForm.getValidDataIndex("bizType")}
                value={TypeSafeForm.getFieldValue("bizType")}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={4}>
              <EditableField
                label="실 매장 수"
                type="number"
                name={TypeSafeForm.getValidDataIndex("currentBrandUserCount")}
                value={TypeSafeForm.getFieldValue("currentBrandUserCount")?.toLocaleString()}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={4}>
              <EditableField
                label="실 매장 수 기준 일자"
                type="datepicker"
                name={TypeSafeForm.getValidDataIndex("currentBrandUserCountUpdateDate")}
                value={TypeSafeForm.getFieldValue("currentBrandUserCountUpdateDate")}
                editMode={realEditMode}
                formDateFormat={onlyDateFormat}
              />
            </Col>
            {isUpdate && (
              <Col xs={24} sm={4}>
                <NonEditableField
                  label="브랜드몰 생성일"
                  value={getDateByFormat(props.brand.created, onlyDateFormat)}
                />
              </Col>
            )}
            {isUpdate && (
              <Col xs={24} sm={4}>
                <NonEditableField label="최초 거래일" value={getDateByFormat(props.brand.firstDay, onlyDateFormat)} />
              </Col>
            )}
            <Col xs={24} sm={4}>
              <EditableField
                label="보스몰 메뉴"
                type="select"
                name={TypeSafeForm.getValidDataIndex("homeList")}
                value={TypeSafeForm.getFieldValue("homeList")}
                editMode={realEditMode}
                options={menuOptions}
                searchProps={{
                  onSearch: searchMenus,
                  fetchMoreProps: {
                    loading: searchMenusOpts.loading,
                    hasMore: !!searchMenusOpts.data?.search.pageInfo.hasNextPage,
                    onFetchMore: loadMoreMenus,
                  },
                }}
              />
            </Col>
          </Row>
        </Col>
      </Row>
    </>
  );
};
</file>

