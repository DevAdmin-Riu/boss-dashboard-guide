    align: "right",
    width: 120,
    render: (_, record) => (record.palletQty != null ? <NumberComponent value={record.palletQty} /> : "-"),
    renderExcel: (record) => record.palletQty ?? "-",
  };

  const isInnerColumn: DownloadableColumnType<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node> = {
    title: columnNameConstant.product.IS_INNER,
    key: "isInner",
    align: "center",
    width: 90,
