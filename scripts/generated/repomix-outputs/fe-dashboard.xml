import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import { Modal } from "antd";
import React, { useMemo, useState } from "react";

import { useDeleteEmptyRackStockDetailMutation, useVerifyRackLocationStockMutation } from "../../api/mutations";
import { rackStockListQuery, useDownloadRackStockListQuery, useRackStockListQuery } from "../../api/queries";
import { RackStockList_rackStocks_edges_node, RackStockListVariables } from "../../api/types/RackStockList";
import { RackLocationSyncModal } from "../../components/RackLocationSyncModal";
import { RackStockDetailMoveModal } from "../../components/RackStockDetailMoveModal";
import RackStockListPage from "../../components/RackStockListPage/RackStockListPage";
import { SectorOrLocationLabelPrintModal } from "../../components/SectorOrLocationLabelPrintModal";
import { rackStockListViewUrl, RackStockListViewUrlDialog, RackStockListViewUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

enum RackStockListModalModeEnum {
  SyncRackLocation = "SyncRackLocation",
  DeleteEmptyRackStockDetail = "DeleteEmptyRackStockDetail",
  MoveRackStockDetail = "MoveRackStockDetail",
  PrintLabel = "PrintLabel",
}

interface RackStockListViewProps {
  params: RackStockListViewUrlQueryParams;
}

const RackStockListView: React.FC<RackStockListViewProps> = ({ params }) => {
  const [selectedRackStock, setSelectedRackStock] = useState<RackStockList_rackStocks_edges_node>(null);
  const [modalMode, setModalMode] = useState<RackStockListModalModeEnum>(null);
  const resetForCloseModal = () => {
    setModalMode(null);
    setSelectedRackStock(null);
  };
  const openModalWithoutNavigate = (
    modalMode: RackStockListModalModeEnum,
    rackStock?: RackStockList_rackStocks_edges_node
  ) => {
    setModalMode(modalMode);
    if (!utils.isEmpty(rackStock)) {
      setSelectedRackStock(rackStock);
    }
  };

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.RACK_STOCK_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useDownloadRackStockListQuery);

  const queryVariables = useMemo<RackStockListVariables>(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useRackStockListQuery({ variables: queryVariables });
  const rackStocks = maybe(() => data.rackStocks.edges.map((edge) => edge.node), []);

  const [verifyRackLocationStock, verifyRackLocationStockOpts] = useVerifyRackLocationStockMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.verifyRackLocationStock.errors,
        "모든 재고 수량이 로케이션 재고 수량과 싱크가 맞습니다."
      ),
  });

  const [deleteEmptyRackStockDetail, deleteEmptyRackStockDetailOpts] = useDeleteEmptyRackStockDetailMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.deleteEmptyRackStockDetail.errors,
        "로케이션에서 제품이 재고 연동 해제 되었습니다.",
        () => {
          resetForCloseModal();
        }
      ),
    refetchQueries: [rackStockListQuery],
  });

  const targetUrl = (params: RackStockListViewUrlQueryParams) => rackStockListViewUrl(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.rackStocks?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<RackStockListViewUrlDialog, RackStockListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  const pageLoading = loading || verifyRackLocationStockOpts.loading;

  return (
    <>
      <RackStockListPage
        params={params}
        rackStocks={rackStocks}
        onRackLocationStockVerify={() => verifyRackLocationStock()}
        onRackLocationSync={() => openModalWithoutNavigate(RackStockListModalModeEnum.SyncRackLocation)}
        onEmptyRackStockDetailDelete={(rackStock) =>
          openModalWithoutNavigate(RackStockListModalModeEnum.DeleteEmptyRackStockDetail, rackStock)
        }
        onRackStockDetailMove={(rackStock) =>
          openModalWithoutNavigate(RackStockListModalModeEnum.MoveRackStockDetail, rackStock)
        }
        onLabelPrint={() => openModalWithoutNavigate(RackStockListModalModeEnum.PrintLabel)}
        settings={settings}
        disabled={pageLoading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        sort={getSortParams(params)}
        onSort={handleSort}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <RackLocationSyncModal
        open={modalMode === RackStockListModalModeEnum.SyncRackLocation}
        loading={pageLoading}
        onClose={resetForCloseModal}
      />
      <Modal
        title="재고 연동 해제"
        open={modalMode === RackStockListModalModeEnum.DeleteEmptyRackStockDetail}
        okText="연동 해제"
        confirmLoading={deleteEmptyRackStockDetailOpts.loading}
        okButtonProps={{ danger: true, type: "primary" }}
        onOk={() => deleteEmptyRackStockDetail({ variables: { id: selectedRackStock.id } })}
        onCancel={resetForCloseModal}
      >
        로케이션({selectedRackStock?.location.name || "-"})에서 제품({selectedRackStock?.productVariant.sku || "-"})을
        재고 연동 해제 하시겠습니까?
      </Modal>
      <RackStockDetailMoveModal
        open={!!selectedRackStock && modalMode === RackStockListModalModeEnum.MoveRackStockDetail}
        loading={pageLoading}
        productVariantId={selectedRackStock?.productVariant.id}
        rackLocation={selectedRackStock?.location}
        rackStock={selectedRackStock}
        onClose={resetForCloseModal}
      />
      <SectorOrLocationLabelPrintModal
        open={modalMode === RackStockListModalModeEnum.PrintLabel}
        loading={pageLoading}
        onClose={resetForCloseModal}
      />
    </>
  );
};

export default RackStockListView;
</file>

