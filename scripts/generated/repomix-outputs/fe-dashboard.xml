import { Button, Col, Divider, Form, Input, Modal, Row, Select, Space, Table, Typography } from "antd";
import moment from "moment";
import React, { useEffect, useMemo, useRef, useState } from "react";
import { useParams } from "react-router";

import { HqB2bSettlementBulkReqRevisionModal } from "../../../hqStaff/hqB2b/components/HqB2bSettlementModals/HqB2bSettlementBulkReqRevisionModal";
import { b2bSalesCountQuery, b2bSalesStatsQuery } from "../../api/queries";
import B2bSalesStatSummaryTable from "./B2bSalesStatSummaryTable";
import { calculatePaidDate, generateClosingStatementExcel } from "./utils";

interface B2bSalesStatClosingStatementModalProps {
  open: boolean;
  onClose: () => void;
  selectedBrandSalesList: SalesListForB2b_sales_edges_node[];
  salesStatsRecord: B2bSalesStats_b2bSalesStats | null;
  onUpdateSalesList?: (updatedList: SalesListForB2b_sales_edges_node[]) => void;
  onRefetchSalesList?: () => Promise<any>;
  isPending: boolean;
  isClosingStatement: boolean;
  salesListForB2bRefetchLoading: boolean;
}

export function createSorterStructure(): ISorter<B2bSettlementListSortField> {
  let displayOrder = 0;

  const orderCreatedSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.order.ORDER_DATE,
    sortField: B2bSettlementListSortField.orderCreated,
  };
  const b2bInvoicePrintedAtSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.purchaseOrder.PURCHASE_DATE,
    sortField: B2bSettlementListSortField.b2bInvoicePrintedAt,
  };
  const skuSorter = {
    displayOrder: displayOrder++,
    label: columnNameConstant.product.SKU,
    sortField: B2bSettlementListSortField.sku,
  };

  return [orderCreatedSorter, b2bInvoicePrintedAtSorter, skuSorter];
}

const B2bSalesStatClosingStatementModal = (props: B2bSalesStatClosingStatementModalProps) => {
  const {
    open,
    onClose,
    selectedBrandSalesList,
    salesStatsRecord,
    onUpdateSalesList,
    onRefetchSalesList,
    isPending,
    isClosingStatement,
    salesListForB2bRefetchLoading,
  } = props;

  const routeParams = useParams<B2bSettlementListViewRouteParams>();
  const shop = useShop();
  const riuBizRegInfo = shop?.riuBizRegInfo;
  const b2bOrderManagerEmail = shop?.emailPluginInfo?.b2bOrderManagerEmail?.split(",")[0] || "";
  const [tableForm] = Form.useForm<SalesB2bUpdateForm>();
  const [closingSendForm] = Form.useForm<Partial<SalesB2bSettlementSendInput>>();
  const [selectedSalesId, setSelectedSalesId] = useState<string>("");
  const [loading, setLoading] = useState(false);
  const [sendingEmail, setSendingEmail] = useState(false);
  const [showSendConfirmModal, setShowSendConfirmModal] = useState(false);
  const [showRevisionModal, setShowRevisionModal] = useState(false);
  const [revisionModalSalesIds, setRevisionModalSalesIds] = useState<string[]>([]);
  const isMountedRef = useRef(true);
  const sorterStructure = createSorterStructure();
  const [selectedSortOption, setB2bSettlementSort] = useState<Sort<B2bSettlementListSortField>>({
    asc: true,
    sort: B2bSettlementListSortField.b2bInvoicePrintedAt,
  });
  const handleSort = (field) => {
    const newSort = getSortUrlVariables(field, selectedSortOption);
    setB2bSettlementSort(newSort);
  };

  const sortedBrandSalesList = useMemo(() => {
    if (!selectedSortOption) {
      return selectedBrandSalesList;
    }

    const { sort, asc } = selectedSortOption;

    return [...selectedBrandSalesList].sort((a, b) => {
      if (sort === B2bSettlementListSortField.sku) {
        const aSku = a.productInfo?.productSku ?? "";
        const bSku = b.productInfo?.productSku ?? "";
        return asc ? aSku.localeCompare(bSku) : bSku.localeCompare(aSku);
      } else if (sort === B2bSettlementListSortField.orderCreated) {
        const aCreated = a.order?.created ? moment(a.order?.created).valueOf() : 0;
        const bCreated = b.order?.created ? moment(b.order?.created).valueOf() : 0;
        return asc ? aCreated - bCreated : bCreated - aCreated;
      } else if (sort === B2bSettlementListSortField.b2bInvoicePrintedAt) {
        const aB2bInvoicePrintedAt = a.b2bInvoicePrintedAt ? moment(a.b2bInvoicePrintedAt).valueOf() : 0;
        const bB2bInvoicePrintedAt = b.b2bInvoicePrintedAt ? moment(b.b2bInvoicePrintedAt).valueOf() : 0;
        return asc ? aB2bInvoicePrintedAt - bB2bInvoicePrintedAt : bB2bInvoicePrintedAt - aB2bInvoicePrintedAt;
      }

      return 0;
    });
  }, [selectedBrandSalesList, selectedSortOption]);

  const [sendSettlement] = useSalesB2bSettlementSendMutation({
    onCompleted: (data) => {
      if (!isMountedRef.current) {
        return;
      }
      setSendingEmail(false);
      if (data.salesB2bSettlementSend?.errors?.length > 0) {
        showGqlErrors(data.salesB2bSettlementSend.errors);
      } else {
        showNotificationSuccess("마감명세서가 발송되었습니다.");
        onClose();
      }
    },
    onError: (error) => {
      if (!isMountedRef.current) {
        return;
      }
      setSendingEmail(false);
      showNotificationError(error.message || "발송에 실패했습니다.");
    },
    refetchQueries: [b2bSalesStatsQuery, b2bSalesCountQuery],
  });

  const [closeSalesB2b, closeSalesB2bOptions] = useSalesB2bCloseMutation({
    onCompleted: (data) => {
      if (!isMountedRef.current) {
        return;
      }
      if (data.salesB2bClose?.errors?.length > 0) {
        showGqlErrors(data.salesB2bClose.errors);
      } else {
        showNotificationSuccess("마감이 확정되었습니다.");
        onClose();
      }
    },
    onError: (error) => {
      if (!isMountedRef.current) {
        return;
      }
      showNotificationError(error.message || "마감 확정에 실패했습니다.");
    },
    refetchQueries: [b2bSalesStatsQuery, b2bSalesCountQuery],
  });

  const [updateSalesB2b, updateSalesB2bOptions] = useSalesB2bUpdateMutation({
    onCompleted: (data) => {
      if (!isMountedRef.current) {
        return;
      }
      setLoading(false);
      if (data.salesB2bUpdate?.errors?.length > 0) {
        showGqlErrors(data.salesB2bUpdate.errors);
      } else {
        showNotificationSuccess("수정되었습니다.");
        setSelectedSalesId("");
        tableForm.resetFields();

        if (data.salesB2bUpdate?.sales && onUpdateSalesList) {
          const updatedSales = data.salesB2bUpdate.sales;
          const updatedList = sortedBrandSalesList.map((item) =>
            item.id === updatedSales.id
              ? {
                  ...item,
                  quantity: updatedSales.quantity,
                  unitPrice: updatedSales.unitPrice,
                  amount: updatedSales.amount,
                  b2bDeliveryFeeExcludeVat: updatedSales.b2bDeliveryFeeExcludeVat,
                  b2bInvoicePrintedAt: updatedSales.b2bInvoicePrintedAt,
                }
              : item
          );
          onUpdateSalesList(updatedList);
        }
      }
    },
    onError: (error) => {
      if (!isMountedRef.current) {
        return;
      }
      setLoading(false);
      showNotificationError(error.message || "수정에 실패했습니다.");
    },
    refetchQueries: [b2bSalesStatsQuery, b2bSalesCountQuery],
  });

  const isBrandSalesList = sortedBrandSalesList.length > 0;
  const brandName =
    salesStatsRecord?.brand?.name || (isBrandSalesList ? sortedBrandSalesList[0].brandInfo.brandName : "-");
  const salesCloseDate =
    salesStatsRecord?.statDate || (isBrandSalesList ? sortedBrandSalesList[0].salesCloseDate : null);
  const salesCloseDateFormatted = salesCloseDate ? getDateByFormat(salesCloseDate, yearMonthKoreanFormat) : "-";

  const summaryData = useMemo(() => {
    if (!salesStatsRecord) {
      return null;
    }
    const taxableTotal = salesStatsRecord.statTaxableTotal || 0;
    const taxfreeTotal = salesStatsRecord.statTaxfreeTotal || 0;
    const supplyValue = toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;
    const vatAmount = taxableTotal + taxfreeTotal - supplyValue;
    const totalAmount = taxableTotal + taxfreeTotal;
    const unpaidAmount = Number(salesStatsRecord.unpaidAmount) || 0;

    return {
      supplyValue,
      vatAmount,
      totalAmount,
      paymentDueDate: moment(salesCloseDate).add(1, "month").endOf("month"),
      unpaidAmount,
    };
  }, [salesStatsRecord, salesCloseDate]);
  const unitPriceExcludeVatWatched = Form.useWatch("unitPriceExcludeVat", tableForm);
  const quantityWatched = Form.useWatch("quantity", tableForm);
  const b2bDeliveryFeeExcludeVatWatched = Form.useWatch("b2bDeliveryFeeExcludeVat", tableForm);
  const formValuesWatched = {
    quantity: quantityWatched,
    unitPriceExcludeVat: unitPriceExcludeVatWatched,
    b2bDeliveryFeeExcludeVat: b2bDeliveryFeeExcludeVatWatched,
  };

  // 컴포넌트 언마운트 시 cleanup
  useEffect(
    () => () => {
      isMountedRef.current = false;
    },
    []
  );

  React.useEffect(() => {
    if (open && isBrandSalesList) {
      const { peopleInChargeInfo } = salesStatsRecord.brand;
      const recipientListInitialValue = [peopleInChargeInfo?.bossMall.email, peopleInChargeInfo?.accounting.email];
      const ccListInitialValue = [b2bOrderManagerEmail];

      closingSendForm.setFieldsValue({
        title: `[㈜리우] ${brandName} ${salesCloseDateFormatted} 마감명세서 송부의 건`,
        fromEmail: b2bOrderManagerEmail,
        recipientList: recipientListInitialValue.filter(Boolean),
        ccList: ccListInitialValue.filter(Boolean),
        unpaidAmount: salesStatsRecord?.unpaidAmount || 0,
      });
    }
  }, [open, brandName, salesCloseDateFormatted, isBrandSalesList]);

  const isEditing = (record: SalesListForB2b_sales_edges_node) => record.id === selectedSalesId;

  const onEdit = (record: SalesListForB2b_sales_edges_node) => {
    tableForm.setFieldsValue({
      quantity: record.quantity,
      unitPriceExcludeVat: toPriceExcludeVat(
        record.unitPrice,
        record.isTaxFree,
        record.variant?.priceDecimalPlaces || 0
      ),
      b2bDeliveryFeeExcludeVat: record.b2bDeliveryFeeExcludeVat || 0,
      b2bInvoicePrintedAt: moment(record.b2bInvoicePrintedAt) || null,
    });
    setSelectedSalesId(record.id);
  };

  const onCancel = () => {
    setSelectedSalesId("");
    tableForm.resetFields();
  };

  const onSubmit = async (record: SalesListForB2b_sales_edges_node) => {
    const values = await tableForm.validateFields().catch(() => null);
    if (!values) {
      return;
    }

    setLoading(true);

    const input: SalesB2bUpdateInput = {
      unitPrice: String(
        toPriceIncludeVat(values.unitPriceExcludeVat, record.isTaxFree, record.variant?.priceDecimalPlaces || 0)
      ),
      quantity: String(values.quantity),
      b2bDeliveryFeeExcludeVat: values.b2bDeliveryFeeExcludeVat,
      b2bInvoicePrintedAt: moment(values.b2bInvoicePrintedAt).format(onlyDateFormat),
    };

    await updateSalesB2b({
      variables: {
        id: record.id,
        input,
      },
    });
  };

  const generateExcelFile = async (): Promise<File | null> => {
    if (!salesStatsRecord || utils.isEmpty(sortedBrandSalesList)) {
      showNotificationError("출력할 마감 정보를 찾을 수 없습니다.");
      return null;
    }

    const unpaidAmount = closingSendForm.getFieldValue("unpaidAmount") || 0;
    return generateClosingStatementExcel(
      salesStatsRecord,
      unpaidAmount,
      sortedBrandSalesList,
      riuBizRegInfo,
      b2bOrderManagerEmail
    );
  };

  const handleSendEmail = async () => {
    const emailValues = await closingSendForm.validateFields().catch(() => null);
    if (!emailValues) {
      return;
    }

    if (!salesStatsRecord) {
      showNotificationError("마감 정보를 찾을 수 없습니다.");
      return;
    }

    const hasInvalidStatus = sortedBrandSalesList.some(
      (salesItem) => salesItem.b2bStatus !== SalesB2bStatusEnum.BEFORE_SEND
    );

    if (hasInvalidStatus) {
      showNotificationError("수정 요청 건에 대해 확인 후 발송 대기로 상태 변경해야 발송할 수 있습니다.");
      return;
    }

    // 확인 모달 표시
    setShowSendConfirmModal(true);
  };

  const handleSalesStatClose = async () => {
    await closeSalesB2b({
      variables: {
        input: {
          brand: salesStatsRecord?.brand?.id,
          salesCloseDate: moment(salesStatsRecord?.statDate).endOf("month").format(onlyDateFormat),
          salesIds: sortedBrandSalesList.map((item) => item.id),
        },
      },
    });
  };

  const onShowReqRevisionModal = (salesId: string, salesCloseDate: string) => {
    setRevisionModalSalesIds([salesId]);
    setShowRevisionModal(true);
  };

  const onCancelRevisionModal = (shouldReset: boolean) => {
    setShowRevisionModal(false);
    setRevisionModalSalesIds([]);
    if (shouldReset && onRefetchSalesList) {
      onRefetchSalesList();
    }
  };

  const handleTestExcelDownload = async () => {
    if (!salesStatsRecord) {
      showNotificationError("마감 정보를 찾을 수 없습니다.");
      return;
    }

    const excelFile = await generateExcelFile();
    if (!excelFile) {
      return;
    }

    // Create a download link
    const url = URL.createObjectURL(excelFile);
    const link = document.createElement("a");
    link.href = url;
    link.download = excelFile.name;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    showNotificationSuccess("엑셀 파일이 다운로드되었습니다.");
  };

  const handleSendEmailConfirm = async () => {
    const emailValues = closingSendForm.getFieldsValue();

    if (utils.isEmpty(emailValues.title)) {
      showNotificationError("메일 제목을 입력해주세요.");
      return;
    }

    if (utils.isEmpty(emailValues.fromEmail)) {
      showNotificationError("보내는 사람 이메일을 입력해주세요.");
      return;
    }

    if (utils.isEmpty(emailValues.recipientList)) {
      showNotificationError("받는 사람 이메일을 입력해주세요.");
      return;
    }

    if (utils.isEmpty(emailValues.unpaidAmount)) {
      showNotificationError("미수금 금액을 입력해주세요.");
      return;
    }

    // 확인 모달 닫기
    setShowSendConfirmModal(false);
    setSendingEmail(true);

    // Excel 파일 생성
    const excelFile = await generateExcelFile();
    if (!excelFile) {
      setSendingEmail(false);
      return;
    }

    const paidDate = calculatePaidDate(
      salesStatsRecord!.statDate,
      salesStatsRecord?.brand?.b2bPayMethod,
      onlyDateFormat
    );

    const input: SalesB2bSettlementSendInput = {
      brand: salesStatsRecord!.brand.id,
      salesCloseDate: moment(salesStatsRecord!.statDate).endOf("month").format(onlyDateFormat),
      paidDate,
      file: excelFile,
      unpaidAmount: emailValues.unpaidAmount || 0,
      taxableTotal: salesStatsRecord!.statTaxableTotal || 0,
      taxfreeTotal: salesStatsRecord!.statTaxfreeTotal || 0,
      title: emailValues.title,
      fromEmail: emailValues.fromEmail,
      recipientList: emailValues.recipientList,
      ccList: emailValues.ccList || [],
    };

    await sendSettlement({
      variables: {
        input,
      },
    });
  };

  const editingProps = {
    loading,
    selectedSalesId,
    isEditing,
    onEdit,
    onCancel,
    onSubmit,
    openModal: () => undefined,
  };

  const tableColumns = getB2bSettlementListTableSettings({
    routeParams,
    editingProps,
    formValuesWatched,
    navigate: null,
    onShowReqRevisionModal: isPending ? onShowReqRevisionModal : undefined,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(tableColumns);

  const buttonLoading = updateSalesB2bOptions.loading || closeSalesB2bOptions.loading || sendingEmail || loading;

  return (
    <Modal
      open={open}
      onCancel={onClose}
      footer={[
        <Button loading={buttonLoading} disabled={buttonLoading} key="cancel" onClick={onClose}>
          취소
        </Button>,
        <Button
          loading={buttonLoading}
          disabled={buttonLoading}
          key="excel"
          icon={<DownloadOutlined />}
          onClick={handleTestExcelDownload}
        >
          마감명세서 미리보기
        </Button>,
        isClosingStatement && (
          <Button loading={buttonLoading} disabled={buttonLoading} key="send" type="primary" onClick={handleSendEmail}>
            발송
          </Button>
        ),
        isPending && (
          <Button
            loading={buttonLoading}
            disabled={
              buttonLoading ||
              sortedBrandSalesList.length === 0 ||
              sortedBrandSalesList.some((item) => item.b2bStatus !== SalesB2bStatusEnum.PENDING)
            }
            key="closing"
            type="primary"
            onClick={handleSalesStatClose}
          >
            마감확정
          </Button>
        ),
      ].filter(Boolean)}
      key={"send-modal"}
      title={isClosingStatement ? "마감명세서 발송" : "세부 내역 확인"}
      width={1100}
      style={{ top: 20 }}
      maskClosable={false}
    >
      <Space direction="vertical" style={{ width: "100%" }} size={16}>
        {isPending && (
          <>
            <Typography.Text>
              <strong>{salesCloseDateFormatted}</strong>의 마감을 확정하시겠습니까? <br />
              만약 수정이 필요한 내역이 있다면 해당 내역에 대해 [수정 요청]을 할 수 있습니다. <br />
              수정 요청한 내역이 있는 경우에는 확정할 수 없습니다.
            </Typography.Text>
            <B2bSalesStatSummaryTable
              summaryData={summaryData}
              salesCloseDateFormatted={salesCloseDateFormatted}
              salesCloseDate={salesCloseDate}
              salesStatsRecord={salesStatsRecord}
              isInsideForm={false}
            />
          </>
        )}

        {isClosingStatement && (
          <>
            <Typography.Text>
              <strong>{brandName}</strong>의 <strong>{salesCloseDateFormatted}</strong> 마감명세서를 확인하고, 미수금 및
              각 내역에 추가 사항이 있다면 작성한 뒤 [발송] 버튼을 눌러주세요.
            </Typography.Text>

            <Form form={closingSendForm} layout="vertical" validateMessages={{ required: formRuleMsg.required }}>
              <Form.Item name="title" label="메일 제목" rules={[{ required: true }]}>
                <Input placeholder="메일 제목을 입력하세요" />
              </Form.Item>

              <Row gutter={16}>
                <Col span={12}>
                  <Form.Item
                    name="fromEmail"
                    label="보내는 사람"
                    rules={[{ required: true }, { type: "email", message: "올바른 이메일 형식이 아닙니다" }]}
                  >
                    <Input placeholder="이메일 주소를 입력하세요" />
                  </Form.Item>
                </Col>
                <Col span={12}>
                  <Form.Item
                    name="recipientList"
                    label="받는 사람"
                    required
                    rules={[{ required: true }, ...isValidMultipleEmailValidator()]}
                    tooltip="이메일 입력 후 Enter 또는 쉼표(,)로 구분"
                  >
                    <Select
                      mode="tags"
                      placeholder="이메일 주소를 입력하세요"
                      tokenSeparators={[","]}
                      notFoundContent={null}
                    />
                  </Form.Item>
                </Col>
              </Row>

              <Row gutter={16}>
                <Col span={12}>
                  <Form.Item name="ccList" label="참조" tooltip="선택사항">
                    <Select
                      mode="tags"
                      placeholder="이메일 주소를 입력하세요"
                      tokenSeparators={[","]}
                      notFoundContent={null}
                    />
                  </Form.Item>
                </Col>
              </Row>

              <Divider style={{ margin: "20px 0" }} />

              {/* Summary Table inside Form */}
              <B2bSalesStatSummaryTable
                summaryData={summaryData}
                salesCloseDateFormatted={salesCloseDateFormatted}
                salesCloseDate={salesCloseDate}
                salesStatsRecord={salesStatsRecord}
                isInsideForm={true}
                form={closingSendForm}
              />
            </Form>
          </>
        )}

        <Divider />

        <Row align="middle" justify="end" style={{ marginBottom: 8 }}>
          <Col>
            {isClosingStatement && (
              <SorterDropdown sorterStructure={sorterStructure} sort={selectedSortOption} onSort={handleSort} />
            )}
          </Col>
        </Row>

        <Form form={tableForm} component={false}>
          <Table
            {...commonTableProps}
            components={{
              body: {
                cell: EditableCell,
              },
            }}
            columns={tableColumns}
            dataSource={sortedBrandSalesList}
            scroll={{ x: tableWidthSum, y: 400 }}
            loading={salesListForB2bRefetchLoading}
          />
        </Form>
      </Space>
      {/* 발송 확인 모달 */}
      <ConfirmModal
        visible={showSendConfirmModal}
        helpText="모든 정보가 맞는지 확인했고, 이대로 발송하시겠습니까?"
        onOk={handleSendEmailConfirm}
        onCancel={() => setShowSendConfirmModal(false)}
        okText="발송"
        cancelText="취소"
      />
      {/* 수정 요청 모달 */}
      <HqB2bSettlementBulkReqRevisionModal
        open={showRevisionModal}
        loading={loading}
        saleIds={revisionModalSalesIds}
        salesCloseDate={salesCloseDate}
        onCancel={onCancelRevisionModal}
      />
    </Modal>
  );
};

export default B2bSalesStatClosingStatementModal;
</file>

<file path="src/app/views/b2b/components/B2bSalesStatListPage/B2bSalesStatListPage.tsx">
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { B2bSalesStats_b2bSalesStats } from "@src/app/views/b2b/api/types/B2bSalesStats";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Table } from "antd";
import React, { useEffect } from "react";

import { B2bSalesStatListViewUrlDialog, B2bSalesStatListViewUrlQueryParams } from "../../urls";
import { getB2bSalesStatListTableSettings } from "./B2bSalesStatListTableSettings";
import { B2bSalesStatFilterKeys, B2bSalesStatListFilterOpts, createFilterStructure } from "./filters";

interface B2bSalesStatListPageProps
  extends PaginateListProps,
    FilterPageProps<B2bSalesStatFilterKeys, B2bSalesStatListFilterOpts> {
  params: B2bSalesStatListViewUrlQueryParams;
  b2bSalesStatList: Array<B2bSalesStats_b2bSalesStats | null>;
  openModal: (action: B2bSalesStatListViewUrlDialog, newParams?: B2bSalesStatListViewUrlQueryParams) => void;
  closeModal: () => void;
  selectedRowIds: string[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<string[]>>;
  ListNavigator: () => React.ReactNode;
  queryVariablesWithoutPagination: any;
  fetchForDownload?: (variables?: any) => Promise<any>;
  onShowSendModal: (record: B2bSalesStats_b2bSalesStats) => void;
  isClosingStatement: boolean;
  isStaff: boolean;
}

export const B2bSalesStatListPage: React.FC<B2bSalesStatListPageProps> = (props) => {
  const {
    params,
    currentTab,
    filterOpts,
    tabs,
    b2bSalesStatList,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    openModal,
    closeModal,
    selectedRowIds,
    setSelectedRowIds,
    ListNavigator,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onShowSendModal,
    isClosingStatement,
    isStaff,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, isStaff);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  useEffect(() => {
    setSelectedRowIds([]);
  }, [listProps.disabled]);

  const salesTableColumns = getB2bSalesStatListTableSettings({
    onShowSendModal,
    isClosingStatement,
    isStaff,
  });

  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    salesTableColumns,
    listProps.settings.columns
  );
  const handleSave = (columns: string[]) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const downloadRelatedProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "b2bSalesStats",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>{ListNavigator()}</Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          excelDownloadProps={downloadRelatedProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              initialColumns={initialColumns}
              onSave={handleSave}
              loading={listProps.disabled}
              total={pickColumns?.length}
            />
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={b2bSalesStatList}
          rowKey={(record) => `${record?.statDate}-${record?.brand?.id}`}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
