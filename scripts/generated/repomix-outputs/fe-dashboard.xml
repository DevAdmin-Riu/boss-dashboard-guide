import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

import { checkOrderedByStaffForBrand, checkOrderedByUser } from "../../utils";

export enum OrderFilterKeys {
  orderSearch = "orderSearch",
  paymentSearch = "paymentSearch",
  created = "created",
  capturedAt = "capturedAt",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  userSearch = "userSearch",
  productSearch = "productSearch",
  creatorUserSearch = "creatorUserSearch",
  status = "status",
  chargeStatus = "chargeStatus",
  deliveryStatus = "deliveryStatus",
  payMethod = "payMethod",
  type = "type",
}

export interface OrderListFilterOpts {
  orderSearch: FilterOpts<string>;
  paymentSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  capturedAt: FilterOpts<MinMax>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  creatorUserSearch: FilterOpts<string>;
  chargeStatus: FilterOpts<OrderChargeStatusFilter[]>;
