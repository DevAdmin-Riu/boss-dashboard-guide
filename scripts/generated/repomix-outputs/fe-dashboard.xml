export interface ExcelDownloadInputProps {
  title: string;
  columns: any[];
  header?: string[][];
  merges?: xlsx.Range[];
  skipOriginHeader?: boolean;
  colsInfo?: xlsx.ColInfo[];
  rowsInfo?: xlsx.RowInfo[];
}

export const defaultExcelCellStyle = {
  font: {
    name: "맑은 고딕",
    sz: 8,
  },
  alignment: {
    vertical: "center",
    horizontal: "center",
    wrapText: true,
  },
  border: {
    right: {
      style: "thin",
      color: "000000",
    },
    left: {
      style: "thin",
      color: "000000",
    },
    bottom: {
      style: "thin",
      color: "000000",
    },
    top: {
      style: "thin",
      color: "000000",
    },
  },
};

export const getExcelNumberFormat = (value: any): string => {
  if (utils.isEmpty(value) || typeof value !== "number") {
    return undefined;
  }
  return checkIsInteger(value) ? "#,##0" : "#,##0.###";
};

export const applyNumberCellFormat = (currentCell: xlsx.CellObject) => {
  const isNumberCell = typeof currentCell.v === "number";
  if (isNumberCell) {
    currentCell.t = "n";
    currentCell.z = getExcelNumberFormat(currentCell.v);
  }
};

const getWorkSheetWithHeader = (columns: any[], header: string[][], skipOriginHeader: boolean = true) => {
  const headerExist = !!header && header.length > 0;
  if (headerExist) {
    const ws = xlsx.utils.aoa_to_sheet(header);
    xlsx.utils.sheet_add_json(ws, columns, { skipHeader: skipOriginHeader, origin: -1 });
    return ws;
  } else {
    return xlsx.utils.json_to_sheet(columns);
  }
};

export interface IExcelDownloadByWorkBookProps {
  title: string;
  workBook: xlsx.WorkBook;
}

export const excelDownloadByWorkBook = (props: IExcelDownloadByWorkBookProps) => {
  const { title, workBook } = props;

  if (utils.checkWebView()) {
    sendMessageToWebView("EXCEL_DOWNLOAD", props);
  } else {
    xlsx.writeFile(workBook, title);
  }
};

export const convertWorkBookToXlsxFile = (props: IExcelDownloadByWorkBookProps): File => {
  const { title, workBook } = props;
  const xlsxBlob = xlsx.write(workBook, { bookType: "xlsx", type: "buffer" });
  const xlsxFileBlob = new Blob([xlsxBlob], { type: excelMimeType });
  const xlsxFile = new File([xlsxFileBlob], title, { type: xlsxFileBlob.type, lastModified: Date.now() });
  return xlsxFile;
};

export const excelDownload = (props: ExcelDownloadInputProps) => {
  const { title, columns, header, merges, skipOriginHeader, colsInfo, rowsInfo } = props;
  const xlsxFileName = `${title}-${moment().format(fileNameDateFormat)}.xlsx`;

  showDownloadingMessageWritingToExcel();

  const ws = getWorkSheetWithHeader(columns, header, skipOriginHeader);
  const wb = xlsx.utils.book_new();
  if (colsInfo && colsInfo.length > 0) {
    ws["!cols"] = colsInfo;
  }
  if (rowsInfo && rowsInfo.length > 0) {
    ws["!rows"] = rowsInfo;
  }
  if (merges && merges.length > 0) {
    ws["!merges"] = merges;
  }
  for (const i in ws) {
    if (typeof ws[i] != "object") {
      continue;
    }

    ws[i].s = defaultExcelCellStyle;
    applyNumberCellFormat(ws[i]);
  }

  xlsx.utils.book_append_sheet(wb, ws, "Sheet1");
  excelDownloadByWorkBook({ title: xlsxFileName, workBook: wb });
};

export const checkExistHeader = (col, headers: HeaderIndexLabelType[]) => {
  const headerItem = headers.find((x) => x.label === col);
  return !!headerItem;
};

export const getRowWithSelectedHeader = (selectedHeaderLabels: HeaderIndexLabelType[], row?: any) => {
  const selectedRow = {};
  const defaultValue = "-";
  for (const col of selectedHeaderLabels) {
    selectedRow[col.label] = row ? row[col.key] : defaultValue;
  }
  return selectedRow;
};

export const getTargetColsIdx = (rowKeys: string[], colToMerge: string[], headerLabels: HeaderIndexLabelType[]) => {
  const colsIdx = [];
  for (let i = 0; i < rowKeys.length; i++) {
    const col = rowKeys[i];
    if (colToMerge.includes(col)) {
      if (checkExistHeader(col, headerLabels)) {
        colsIdx.push(i);
      }
    }
  }
  return colsIdx;
};

// NOTE: 엑셀의 첫 번째 로우로부터 키값에 대괄호 유무에 따라 병합할 헤더 및 머지를 생성하여 리턴하는 함수.
export const makeHeaderRowsAndMerges = (row: any, startRow: number = 0) => {
  if (utils.isEmpty(row)) {
    return { header: [], merges: [] };
  }

  // 1. 대괄호([])로 묶은 문자열은 헤더 중 병합되는 첫 번째 분류 로우로 사용.
  // 2. 대괄호를 제외한 문자열은 두 번째 분류 로우로 사용.
  // 3. 대괄호가 없는 경우, 첫 번째 분류 로우와 두 번째 분류 로우가 동일하게 사용.
  const firstHeaderRow = [];
  const secondHeaderRow = [];
  const rowKeys = Object.keys(row);
  rowKeys.forEach((key) => {
    const matches = key.match(/^\[([^\]]+)\]\n([\s\S]+)$/);
    if (matches) {
      firstHeaderRow.push(matches[1]);
      secondHeaderRow.push(matches[2]);
    } else {
      firstHeaderRow.push(key);
      secondHeaderRow.push(key);
    }
  });

  // 1. 헤더의 첫 번째 로우에서 중복되는 키는 첫 번째 인덱스부터 마지막 인덱스까지 병합 처리
  // (deprecated). 2. 헤더의 첫 번째 로우에서 중복되지 않는 키에 대해 첫 번째 로우의 텍스트와 두 번째 로우의 텍스트가 같으면 위아래로만 병합 처리
  const merges = [];
  const firstHeaderRowKeySet = new Set(firstHeaderRow);
  firstHeaderRowKeySet.forEach((key) => {
    const startIdx = firstHeaderRow.indexOf(key);
    const endIdx = firstHeaderRow.lastIndexOf(key);
    if (startIdx !== endIdx) {
      merges.push({ s: { r: startRow, c: startIdx }, e: { r: startRow, c: endIdx } });
    }
  });

  return { header: [firstHeaderRow, secondHeaderRow], merges };
};

const getColumnIndex = (cell: string): number => {
  const column = cell.match(/[A-Z]+/i)[0];
  let index = 0;
  for (let i = 0; i < column.length; i++) {
    index = index * 26 + (column.charCodeAt(i) - 64);
  }
  return index;
};

const getRowIndex = (cell: string): number => parseInt(cell.match(/\d+/)[0], 10);

const getCellCoordinates = (colIdx: number, rowIdx: number) => {
  let column = "";
  while (colIdx > 0) {
    const remainder = colIdx % 26 || 26;
    column = String.fromCharCode(remainder + 64) + column;
    colIdx = (colIdx - remainder) / 26;
  }
  return column + rowIdx;
};

// 시작 셀, 마지막 셀을 입력 받으면 해당 밤위의 셀들을 배열로 리턴하는 함수
export const getCellRangeArr = (startCell: string, endCell: string) => {
  const range = [];
  const startCol = getColumnIndex(startCell);
  const startRow = getRowIndex(startCell);
  const endCol = getColumnIndex(endCell);
  const endRow = getRowIndex(endCell);

  for (let col = startCol; col <= endCol; col++) {
    for (let row = startRow; row <= endRow; row++) {
      range.push(getCellCoordinates(col, row));
    }
  }

  return range;
};

export function toPriceExcludeVat(
  priceIncludeVat: number,
  isTaxFree: boolean = false,
  precision: number = 0
): number | null {
  if (utils.isEmpty(priceIncludeVat)) {
    return null;
  }
  if (isTaxFree) {
    return priceIncludeVat;
  }

  // 음수면 의도한 표현이 아닐 수 있어서 보정처리함
  // Math.round(1200.5) != Math.round(-1200.5)
  // Math.floor(1200.5) != Math.floor(-1200.5)
  let correctionFactor = 1;
  if (priceIncludeVat < 0) {
    correctionFactor = -1;
    priceIncludeVat = priceIncludeVat * correctionFactor;
  }

  // 부가세 제외 금액 계산 후 반올림하는 정책
  const priceExcludeVat = toPricePrecisionFixed(priceIncludeVat / 1.1, precision);
  return priceExcludeVat * correctionFactor;
}

export function toPriceIncludeVat(
  priceExcludeVat: number,
  isTaxFree: boolean = false,
  precision: number = 0
): number | null {
  if (utils.isEmpty(priceExcludeVat)) {
    return null;
  }
  if (isTaxFree) {
    return priceExcludeVat;
  }

  // 음수면 의도한 표현이 아닐 수 있어서 보정처리함
  // Math.round(1200.5) != Math.round(-1200.5)
  // Math.floor(1200.5) != Math.floor(-1200.5)
  let correctionFactor = 1;
  if (priceExcludeVat < 0) {
    correctionFactor = -1;
    priceExcludeVat = priceExcludeVat * correctionFactor;
  }

  // 부가세 포함 금액 계산 후 반올림하는 정책
  const priceIncludeVat = toPricePrecisionFixed(priceExcludeVat * 1.1, precision);
  return priceIncludeVat * correctionFactor;
}

export function toPricePrecisionFixed(price: number, precision: number = 0): number {
  if (utils.isEmpty(price)) {
    return null;
  }
  return precision > 0 ? Number(price.toFixed(precision)) : Math.round(price);
}

export function calcVatByPriceIncludeVat(
  priceIncludeVat: number,
  isTaxFree: boolean = false,
  precision: number = 0
): number | null {
  if (utils.isEmpty(priceIncludeVat)) {
    return null;
  }
  const priceExcludeVat = toPriceExcludeVat(priceIncludeVat, isTaxFree, precision);
  return priceIncludeVat - priceExcludeVat;
}

export function calcVatByPriceExcludeVat(
  priceExcludeVat: number,
  isTaxFree: boolean = false,
  precision: number = 0
): number | null {
  const priceIncludeVat = toPriceIncludeVat(priceExcludeVat, isTaxFree, precision);
  return calcVatByPriceIncludeVat(priceIncludeVat, isTaxFree, precision);
}

// 부가세 포함가로 부분 합을 모두 더한 후 부가세 별도로 한꺼번에 변환할 때 사용
export function calcTotalIncludeVatByUnitExcludeVatAndQty(
  unitPriceExcludeVat: number,
  qty: number,
  isTaxFree: boolean,
  precision: number
) {
  if (utils.isEmpty(unitPriceExcludeVat) || utils.isEmpty(qty)) {
    return null;
  }
  const unitPriceIncludeVat = toPriceIncludeVat(unitPriceExcludeVat, isTaxFree, 2);
  const totalPriceIncludeVat = unitPriceIncludeVat * qty;
  return utils.convertToNumber(totalPriceIncludeVat, precision);
}

//  부가세 별도가를 입력으로 사용 시 수량을 곱할 경우에는 부가세 포함가로 변환한 후 수량을 곱한 다음에 부가세 별도로 변환해서 리턴
export function calcTotalExcludeVatByUnitExcludeVatAndQty(
  unitPriceExcludeVat: number,
  qty: number,
  isTaxFree: boolean,
  precision: number = 0
) {
  if (utils.isEmpty(unitPriceExcludeVat) || utils.isEmpty(qty)) {
    return null;
  }
  const totalPriceIncludeVat = calcTotalIncludeVatByUnitExcludeVatAndQty(
    unitPriceExcludeVat,
    qty,
    isTaxFree,
    precision
  );
  return toPriceExcludeVat(totalPriceIncludeVat, isTaxFree, precision);
}

export const isIndeterminate = (active, total) => !!active && active < total;

export const isAllChecked = (active, total) => active === total;

/**
 * @description 주어진 테이블 컬럼에서 최대 행 깊이를 계산합니다.
 *              컬럼의 `children` 속성을 재귀적으로 탐색하여 최대 깊이를 구합니다.
 * @param {Array} columns - 테이블 컬럼 배열
 * @returns {number} - 컬럼 계층 구조의 최대 깊이 (행의 개수)
 */
export const calculateTableHeaderMaxRowDepth = (columns) => {
  let maxRow = 0;

  const calculateDepth = (columns, currentDepth) => {
    for (const column of columns) {
      if (column.doNotRenderExcel) {
        continue;
      }
      const newDepth = currentDepth + 1;
      maxRow = Math.max(maxRow, newDepth);
      if ("children" in column && Array.isArray(column.children)) {
        calculateDepth(column.children, newDepth);
      }
    }
  };

  calculateDepth(columns, 0);
  return maxRow;
};

/**
 * @description 모든 계층(children -> children)의 컬럼 개수를 계산합니다.
 *              `children` 속성을 가진 컬럼을 재귀적으로 탐색하여 전체 컬럼 개수를 구합니다.
 * @param {Array} columns - 테이블 컬럼 배열
 * @returns {number} - 모든 계층의 컬럼 개수 합산
 */
export const calculateTotalColumnCount = (columns) => {
  let length = 0;

  const calculateLength = (columns) => {
    for (const column of columns) {
      if (column.doNotRenderExcel) {
        continue;
      }
      if ("children" in column && Array.isArray(column.children)) {
        calculateLength(column.children);
      } else {
        length += 1;
      }
    }
  };

  calculateLength(columns);
  return length;
};

/**
 * @description 테이블 컬럼 정의를 기반으로 엑셀 헤더와 병합 정보를 생성합니다.
 * @param columns {any[]} 테이블 컬럼 정의
 * @param maxRow {number} 헤더의 최대 행 깊이
 * @returns {{header: string[][], merges: xlsx.Range[]}} 엑셀 헤더와 병합 정보
 */
export const generateExcelHeaderAndMerges = (columns, maxRow) => {
  const result = {
    header: Array.from({ length: maxRow }, () => []),
    merges: [],
  };

  const processColumn = (column, colIndex, currentRow, endColIndex: number = null) => {
    if (column.doNotRenderExcel) {
      return;
    }
    // children이 있는 경우, doNotRenderExcel이 아닌 자식들만 카운트
    const countVisibleChildren = (col) => {
      if (!col.children || col.children.length === 0) {
        return 1;
      }
      return col.children.reduce((count, child) => {
        if (child.doNotRenderExcel) {
          return count;
        }
        return count + (child.children ? calculateTotalColumnCount([child]) : 1);
      }, 0);
    };

    const colSpan = column.children ? (endColIndex ? endColIndex - colIndex : countVisibleChildren(column)) : 1;

    // title이 배열인 경우 공백으로 연결
    let title = column.titleExcel || column.title || "";
    if (Array.isArray(title)) {
      title = title.join(" ");
    }
    result.header[currentRow].push(title);

    // colspan 처리 (가로 병합)
    if (colSpan > 1) {
      const merges = {
        s: { r: currentRow, c: colIndex }, // 시작 셀 좌표
        e: { r: currentRow, c: colIndex + colSpan - 1 }, // 종료 셀 좌표
      };

      result.merges.push(merges);

      // 병합할 셀에 빈 문자열을 삽입
      for (let i = 1; i < colSpan; i++) {
        result.header[currentRow].push("");
      }
    }

    if (column.children) {
      let childColIndex = colIndex;
      column.children.forEach((child) => {
        if (!child.doNotRenderExcel) {
          processColumn(child, childColIndex, currentRow + 1);
          // 자식의 전체 leaf 개수를 계산해야 함
          childColIndex += child.children ? calculateTotalColumnCount([child]) : 1;
        }
      });
    } else {
      // 리프 노드인 경우 - rowspan 처리 필요
      const rowSpan = maxRow - currentRow;

      // rowspan이 2 이상인 경우 병합 추가
      if (rowSpan > 1) {
        const merges = {
          s: { r: currentRow, c: colIndex }, // 시작 셀 좌표
          e: { r: maxRow - 1, c: colIndex }, // 종료 셀 좌표
        };
        result.merges.push(merges);
      }

      // 나머지 행에 빈 문자열 추가
      for (let i = currentRow + 1; i < maxRow; i++) {
        result.header[i].push("");
      }
    }
  };

  let colIndex = 0;
  columns.forEach((column) => {
    if (column.doNotRenderExcel) {
      return;
    }
    if (column.children) {
      const childrenLength = calculateTotalColumnCount(column.children);
      processColumn(column, colIndex, 0, colIndex + childrenLength);
      colIndex += childrenLength;
    } else {
      processColumn(column, colIndex, 0);
      colIndex += 1;
    }
  });

  return result;
};

export const getExcelColumnTitle = (column: any) => {
  if (typeof column.titleExcel === "string") {
    return column.titleExcel;
  }
  if (typeof column.title === "string") {
    return column.title;
  }
  if (Array.isArray(column.title)) {
    return column.title.join("\r\n");
  }
  throw new MissingTitleExcelError(column.key);
};

/**
 * @description Excel 업로드 시 문자열에서 탭 문자 및 불필요한 공백을 제거합니다.
 * @param str {string|any} 정리할 문자열
 * @returns {string|any} 정리된 문자열
 */
function cleanExcelString(str: string): string;
function cleanExcelString<T>(str: T): T;
function cleanExcelString(str: any): any {
  if (typeof str === "string") {
    return (
      str
        // 모든 탭 문자를 공백으로 변경
        .replace(/\t/g, " ")
        // 여러 개의 연속된 공백을 하나로 축소
        .replace(/\s+/g, " ")
        // 앞뒤 공백 제거
        .trim()
    );
  }
  return str;
}

/**
 * @description 데이터와 컬럼 정의를 사용하여 엑셀 행 데이터를 생성합니다.
 * @param data {any} 한 행에 대한 원본 데이터
 * @param columnsForDownload {any[]} 다운로드할 컬럼 정의
 * @param index {number} 현재 행의 인덱스
 * @returns {Record<string, any>} 엑셀 행 데이터
 */
const generateExcelRowData = <DataType>(data: DataType, columnsForDownload: any[], index: number) => {
  const returnData: { [key: string]: any } = {};

  const processColumn = (column: any, parentTitle = "") => {
    if (column.doNotRenderExcel) {
      return;
    }

    if ("children" in column && Array.isArray(column.children)) {
      // `children`이 있는 경우 재귀적으로 처리
      column.children.forEach((childColumn) => {
        processColumn(childColumn, parentTitle + column.title + " > ");
      });
    } else {
      const title = getExcelColumnTitle(column);
      const key = parentTitle + title; // 부모 title과 현재 title을 연결
      if (key) {
        let renderValue;
        if (column.render && column.renderExcel) {
          // renderExcel, render 둘다 정의되어 있으면 renderExcel을 우선한다.
          renderValue = column.renderExcel(data, index);
          returnData[key] = renderValue;
          return;
        } else if (column.render) {
          renderValue = column.render(undefined, data);
        }

        if (typeof renderValue !== "string" && typeof renderValue !== "number") {
          // renderValue가 string도 number도 아닌 경우 아래 실행
          try {
            renderValue = column.renderExcel(data, index);
          } catch (e) {
            throw new MissingRenderExcelError(column.key);
          }
        }

        returnData[key] = renderValue;
      }
    }
  };

  columnsForDownload.forEach((column) => {
    processColumn(column);
  });

  return returnData;
};

/**
 * @description 엑셀 다운로드를 위한 데이터 구조를 생성합니다.
 *              테이블 컬럼을 기반으로 헤더, 병합 정보, 데이터 행을 준비합니다.
 * @param columns {DownloadableColumnsType} 엑셀로 변환할 테이블 컬럼 정의
 * @param dataSource {any[]} 엑셀에 포함할 데이터 행 목록
 * @returns {{
 *   header: string[][],
 *   excelColumns: object[],
 *   merges: xlsx.Range[]
 * }} 엑셀 테이블에 필요한 헤더, 데이터, 병합 정보
 */
export const generateExcelDownloadData = <DataSourceType>(
  columns: DownloadableColumnsType,
  dataSource: DataSourceType[]
) => {
  const maxRow: number = calculateTableHeaderMaxRowDepth(columns);
  const { header, merges } = generateExcelHeaderAndMerges(columns, maxRow);

  const excelColumns = [];
  dataSource.forEach((data, index) => {
    const row = generateExcelRowData<DataSourceType>(data, columns, index);
    excelColumns.push(row);
  });

  return { header, excelColumns, merges };
};

/**
 * 엑셀 셀 값이 'true'/'false' 문자열이거나 boolean 이면 boolean 으로,
 * 그 외의 값은 원본 그대로 반환합니다.
 */
export function coerceExcelBoolean(value: boolean): boolean;
export function coerceExcelBoolean<T>(value: T): T;
export function coerceExcelBoolean(value: any): any {
  const maybeBool = parseExcelBooleanStrict(value);
  return maybeBool === undefined ? value : maybeBool;
}

/**
 * 'true'/'false' 문자열 혹은 boolean 만 boolean 으로 바꿔 줍니다.
 * 그 외에는 undefined 반환.
 */
export const parseExcelBooleanStrict = (value: string | boolean): boolean | undefined => {
  if (utils.isEmpty(value)) {
    return undefined;
  }
  if (typeof value === "boolean") {
    return value;
  }
  const v = String(value).trim().toLowerCase();
  if (v === "true") {
    return true;
  }
  if (v === "false") {
    return false;
  }
  return undefined;
};

export const catchForExcelDownloadError = (e: any) => {
  if (e instanceof MissingTitleExcelError || e instanceof MissingRenderExcelError) {
    showNotificationError(e.message);
  } else {
    console.error(e);
    showNotificationError("검색결과 다운로드 과정에서 에러가 발생하였습니다.");
  }
};
