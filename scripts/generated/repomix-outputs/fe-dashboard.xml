} from "../utils";

// NOTE: interface 수정 시, templateColsByOrderType도 함께 수정되어야 함
interface ICommonOrderTemplate {
  firstName: string;
  phone: string;
  streetAddress1: string;
  streetAddress2: string;
  postalCode: string | null;
  productSku: string;
  qty: number | string;
  price: number | string;
  priceVat: number | string;
  customerNote: string;
}
export interface IForBrandTemplate extends ICommonOrderTemplate {
  customerLoginId: string;
  taxInvoiceBizRegNo: string;
  taxInvoiceBizCorpName: string;
  taxInvoiceBizCeoName: string;
  deliveryMethod: OrderDeliveryMethodsEnum;
  fulfillType: FulfillTypeEnum;
  calcMileage: boolean;
  etcDeliveryFee: number | string;
  additionalFeeForEtcDelivery: number | string;
  estimatedArrivalDate: string;
  taxInvoiceRequestFlag: boolean;
  excludeStockAvgStats: boolean;
  bpSku: string;
  productName?: string;
}
export interface IForHqBrandTemplate {
  customerLoginId: string;
  firstName: string;
  phone: string;
  postalCode: string;
  streetAddress1: string;
  streetAddress2?: string;
  bpSku: string;
  qty: number | string;
  price?: number | string;
  priceVat?: number | string;
  customerNote?: string;
  productName?: string;
}
interface IForBadStockTemplate extends ICommonOrderTemplate {
  openMallName: string;
  openMallOrderNumber: string;
}
interface IForEtcTemplate extends ICommonOrderTemplate {
  decreaseStockFlag: boolean;
  staffNote: string;
}

type TDelegateOrderTemplate = IForBrandTemplate | IForHqBrandTemplate;
type TDetail = TDelegateOrderTemplate | IForBadStockTemplate | IForEtcTemplate;

interface OrderCreateByStaffFormData {
  details: TDetail[];
}

interface OrderCreateByStaffModalProps {
  open: boolean;
  disabled: boolean;
  orderType: OrderType;
  onClose: () => void;
}

const getTargetTemplateVersionByOrderType = (orderType: OrderType) => {
  switch (orderType) {
    case OrderType.BY_STAFF_FOR_BRAND:
      return excelTemplateVersion.staffCreateOrderForBrand;
    case OrderType.BY_HQ_STAFF_FOR_BRAND:
      return excelTemplateVersion.staffCreateOrderForHqBrand;
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
      return excelTemplateVersion.staffCreateOrderForBadStock;
    case OrderType.BY_STAFF_FOR_ETC:
      return excelTemplateVersion.staffCreateOrderForEtc;
    default:
      return null;
  }
};

export const makeAltInvoiceeBizInfo = (detail: IForBrandTemplate): AltInvoiceeBizInfoInput => {
  const useAltBizInfo =
    utils.isEmpty(detail.taxInvoiceBizRegNo, true) === false &&
    utils.isEmpty(detail.taxInvoiceBizCorpName, true) === false &&
    utils.isEmpty(detail.taxInvoiceBizCeoName, true) === false;

  if (useAltBizInfo) {
    const altInvoiceeBizInfoInput = {} as AltInvoiceeBizInfoInput;
    altInvoiceeBizInfoInput.bizRegNo = utils.trim(String(detail.taxInvoiceBizRegNo));
    altInvoiceeBizInfoInput.bizCorpName = utils.trim(detail.taxInvoiceBizCorpName);
    altInvoiceeBizInfoInput.bizCeoName = utils.trim(detail.taxInvoiceBizCeoName);
    return altInvoiceeBizInfoInput;
  }
  return undefined;
};

export const OrderCreateByStaffModal: React.FC<OrderCreateByStaffModalProps> = (props) => {
  const { open, disabled, orderType, onClose } = props;
  const { user, updateUser } = useUser();
  const [form] = Form.useForm<OrderCreateByStaffFormData>();
  const [selectedFile, setSelectedFile] = useState<File | null>(null);
  const [errorExist, setErrorExist] = useState<boolean>(false);
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [showAddressPreview, setShowAddressPreview] = useState<boolean>(false);
  const [previewData, setPreviewData] = useState<TDelegateOrderTemplate[]>([]);
  const [currentPage, setCurrentPage] = useState<number>(1);

  const detailsWatched = Form.useWatch("details", form);

  const resetFormAndFile = () => {
    form.resetFields();
    setSelectedFile(null);
    setErrorExist(false);
    setShowAddressPreview(false);
    setPreviewData([]);
    setCurrentPage(1);
  };

  const resetForCloseModal = () => {
    resetFormAndFile();
    onClose();
  };

  // 상세 주소만 필수 요소임 (우편번호 빈 것은 벡엔드 GetPostalCodesFromAddressesBulk 로직에서 우편번호 찾기해서 채워지는 정책)
  const hasRowsWithoutAddress = (details: TDelegateOrderTemplate[]): boolean =>
    details.some((detail) => utils.isEmpty(detail.streetAddress1, true));

  const validateBrandUserAddress = (
    postalCode: string | null | undefined,
    streetAddress1: string | null | undefined,
    combineCode: string
  ): boolean => {
    const hasPostalCode = !utils.isEmpty(postalCode, true);
    const hasStreetAddress = !utils.isEmpty(streetAddress1, true);

    // 둘 다 빈 경우에는 유저의 기본 주소로 주문 처리되며, 기본 주소를 가져와서 기본주소가 없는 경우에 에러 처리함
    if (!hasPostalCode && !hasStreetAddress) {
      return true;
    }

    if (!hasStreetAddress) {
      showNotificationError(`(${combineCode}) 주소를 입력해주세요. 주소 정보는 필수 입력입니다.`);
      return false;
    }

    if (hasPostalCode && postalCode && postalCode.length < 5) {
      showNotificationError(`(${combineCode}) 우편번호 형식이 올바르지 않습니다. 5자리 이상이어야 합니다.`);
      return false;
    }

    return true;
  };

  const validateNonBrandUserAddress = (
    postalCode: string | null | undefined,
    streetAddress1: string | null | undefined,
    combineCode: string
  ): boolean => {
    const hasPostalCode = !utils.isEmpty(postalCode, true);
    const hasStreetAddress = !utils.isEmpty(streetAddress1, true);

    if (!hasStreetAddress) {
      showNotificationError(`(${combineCode}) 주소를 입력해주세요. 주소 정보는 필수 입력입니다.`);
      return false;
    }

    if (hasPostalCode && postalCode && postalCode.length < 5) {
      showNotificationError(`(${combineCode}) 우편번호 형식이 올바르지 않습니다. 5자리 이상이어야 합니다.`);
      return false;
    }

    // 우편번호가 비어 있는 경우에는 벡엔드에서 우편번호 찾기 로직으로 처리함 GetPostalCodesFromAddressesBulk
    return true;
  };

  useEffect(() => {
    if (open) {
      resetFormAndFile();
    }
  }, [open, orderType]);

  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByHqStaffForBrand = checkOrderedByHqStaffForBrand(orderType);
  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);
  const isOrderedByStaffForEtc = checkOrderedByStaffForEtc(orderType);
  const orderTypeName = makeNameByOrderType(orderType, "주문", false, false);

  const isDetailForBrand = (detail: TDetail): detail is IForBrandTemplate => isOrderedByStaffForBrand;
  const isDetailForHqBrand = (detail: TDetail): detail is IForHqBrandTemplate => isOrderedByHqStaffForBrand;
  const isDetailForBadStock = (detail: TDetail): detail is IForBadStockTemplate => isOrderedByStaffForBadStock;
  const isDetailForEtc = (detail: TDetail): detail is IForEtcTemplate => isOrderedByStaffForEtc;
  const isDetailsForBrand = (details: TDetail[]): details is IForBrandTemplate[] => isOrderedByStaffForBrand;
  const isDetailsForHqBrand = (details: TDetail[]): details is IForHqBrandTemplate[] => isOrderedByHqStaffForBrand;
  const isDetailsForBadStock = (details: TDetail[]): details is IForBadStockTemplate[] => isOrderedByStaffForBadStock;
  const isDetailsForEtc = (details: TDetail[]): details is IForEtcTemplate[] => isOrderedByStaffForEtc;

  // NOTE: 아래 key에 대한 value가 모두 같으면 같은 주문으로 정렬, 묶어서 처리
  const groupConditionKeysForBrand: Array<keyof IForBrandTemplate> = ["customerLoginId", "firstName", "fulfillType"];
  const groupConditionKeysForHqBrand: Array<keyof IForHqBrandTemplate> = ["customerLoginId", "firstName"];
  const groupConditionKeysForBadStock: Array<keyof IForBadStockTemplate> = ["openMallName", "openMallOrderNumber"];
  const groupConditionKeysForEtc: Array<keyof IForEtcTemplate> = ["firstName", "phone", "streetAddress1"];

  let groupConditionKeys: Array<
    keyof IForBrandTemplate | keyof IForHqBrandTemplate | keyof IForBadStockTemplate | keyof IForEtcTemplate
  >;
  switch (orderType) {
    case OrderType.BY_STAFF_FOR_BRAND:
      groupConditionKeys = groupConditionKeysForBrand;
      break;
    case OrderType.BY_HQ_STAFF_FOR_BRAND:
      groupConditionKeys = groupConditionKeysForHqBrand;
      break;
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
      groupConditionKeys = groupConditionKeysForBadStock;
      break;
    case OrderType.BY_STAFF_FOR_ETC:
      groupConditionKeys = groupConditionKeysForEtc;
      break;
    default:
      groupConditionKeys = [];
      break;
  }

  const validateDataIsNonNull = (details: TDetail[]) => {
    if (details === undefined || details.length <= 0) {
      showNotificationError(
        `${orderTypeName} 생성을 위한 엑셀데이터에 데이터가 없거나 양식 오류로 처리할 수 없습니다.`
      );
      return false;
    }
    return true;
  };

  const upload = React.useRef<HTMLInputElement>();
  const handleUploadButtonClick = () => upload.current.click();

  const readUploadFile = (e: React.ChangeEvent<HTMLInputElement>) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0]);
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const data = e.target.result;
          const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
          const worksheet = workbook.worksheets[0];
          if (!worksheet) {
            throw new Error("엑셀 파일에 시트가 존재하지 않습니다.");
          }
          const sheetName = worksheet.name;
          const targetVersion = getTargetTemplateVersionByOrderType(orderType);
          // 엑셀 양식 버전이 지정되지 않은 경우도 존재하므로, 지정된 버전이 있는 경우에만 버전 validation
          if (utils.isEmpty(targetVersion) === false) {
            if (utils.validateTemplateVersion(sheetName, targetVersion) === false) {
              setSelectedFile(null);
              setErrorExist(true);
              return;
            }
          }

          const uploadedDetails = parseWorksheetToJsonArr<TDetail>({ worksheet });
          if (validateDataIsNonNull(uploadedDetails) === false) {
            setSelectedFile(undefined);
            setErrorExist(true);
            return;
          }

          let convertedDetails: TDetail[];
          if (isDetailsForBrand(uploadedDetails)) {
            type TDetailForBrandUploaded = StrictOmit<IForBrandTemplate, "deliveryMethod"> & {
              deliveryMethod: number | string;
            };
            convertedDetails = uploadedDetails.map((detail) => {
              const typedDetail = detail as TDetailForBrandUploaded;
              return {
                ...typedDetail,
                taxInvoiceRequestFlag: parseExcelBooleanStrict(typedDetail.taxInvoiceRequestFlag),
                postalCode: utils.formatPostalCode(typedDetail.postalCode),
                // deliveryMethod를 1~5로 입력받아서 OrderDeliveryMethodsEnum로 다시 바꿔 넣는다. BY_COURIER, BY_TRUCK_SERVICE, BY_QUICK_SERVICE, BY_RIU_DIRECT, BY_CUSTOMER_DIRECT 순서대로 1~5임
                deliveryMethod: convertToOrderDeliveryMethodEnum(typedDetail.deliveryMethod),
                fulfillType: convertToFulfillTypeEnum(typedDetail.fulfillType),
                estimatedArrivalDate: typedDetail?.estimatedArrivalDate
                  ? moment(typedDetail.estimatedArrivalDate).format(onlyDateFormat)
                  : null,
              };
            });
          } else if (isDetailsForHqBrand(uploadedDetails)) {
            convertedDetails = uploadedDetails.map((detail) => ({
              ...detail,
              postalCode: utils.formatPostalCode(detail.postalCode),
            }));
          } else if (isDetailsForBadStock(uploadedDetails)) {
            convertedDetails = uploadedDetails.map((detail) => ({
              ...detail,
              postalCode: utils.formatPostalCode(detail?.postalCode),
            }));
          } else if (isDetailsForEtc(uploadedDetails)) {
            convertedDetails = uploadedDetails.map((detail) => ({
              ...detail,
              postalCode: utils.formatPostalCode(detail?.postalCode),
              price: 0,
            }));
          }
          form.setFieldsValue({ details: convertedDetails });
        } catch (error) {
          showNotificationError(error.message);
        }
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const [fetchCustomersDefaultAddress, { loading: loadingCustomersAddress }] =
    useCustomersDefaultShippingAddressLazyQuery();

  const [fetchBrandProducts] = useBrandProductsForOrderProductNameLazyQuery();

  const [orderBulkCreateByStaffMutation, orderBulkCreateByStaffMutationOpts] = useOrderBulkCreateByStaffMutation({
    onCompleted: (data) => {
      const errors = data.orderBulkCreateByStaff?.errors;
      if (errors?.length === 0) {
        const orderCount = data.orderBulkCreateByStaff?.orderCount;
        showNotificationSuccess(`${orderCount}건의 ${orderTypeName}이 생성 되었습니다.`);
        resetForCloseModal();
        if (user.isHqStaff) {
          const updateCashableCredits = data.orderBulkCreateByStaff.hqStaffUser.cashableCredits;
          const updateNonCashableCredits = data.orderBulkCreateByStaff.hqStaffUser.nonCashableCredits;
          updateUser({ ...user, cashableCredits: updateCashableCredits, nonCashableCredits: updateNonCashableCredits });
        }
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [orderListQuery, hqOrderLineListQuery],
  });

  const makeCombineCode = (detail: TDetail) => {
    if (isDetailForBrand(detail)) {
      return `${detail.customerLoginId}:${detail.firstName}`;
    }
    if (isDetailForHqBrand(detail)) {
      return `${detail.customerLoginId}:${detail.firstName}`;
    }
    if (isDetailForBadStock(detail)) {
      return `${detail.openMallName}:${detail.openMallOrderNumber}`;
    }
    return "-";
  };

  const validateOrderType = () => {
    if (
      !isOrderedByStaffForBrand &&
      !isOrderedByHqStaffForBrand &&
      !isOrderedByStaffForBadStock &&
      !isOrderedByStaffForEtc
    ) {
      showNotificationError("주문을 생성할 수 없습니다. 페이지를 새로고침 한 후에 다시 시도해 주세요.");
      return false;
    }
    return true;
  };

  const validateUploadedValueEmpty = (details: TDetail[]) => {
    for (const detail of details) {
      const combineCode = makeCombineCode(detail);
      if (isDetailForBrand(detail)) {
        if (utils.isEmpty(detail.customerLoginId, true)) {
          showNotificationError("회원 ID가 지정되지 않은 셀이 존재합니다.");
          return false;
        }
        if (utils.isEmpty(detail.calcMileage)) {
          showNotificationError("본부수익금 적용 여부가 지정되지 않은 셀이 존재합니다.");
          return false;
        }
        if (utils.isEmpty(detail.taxInvoiceRequestFlag)) {
          showNotificationError("세금계산서 발행 여부가 지정되지 않은 셀이 존재합니다.");
          return false;
        }
        if (!Object.values(OrderDeliveryMethodsEnum).includes(detail.deliveryMethod)) {
          showNotificationError(
            `${detail.customerLoginId}의 (${detail.deliveryMethod})이 올바르지 않습니다. ${Object.values(
              OrderDeliveryMethodsEnum
            )} 중 하나로 입력해야합니다.`
          );
          return false;
        }
        if (
          utils.isEmpty(detail.estimatedArrivalDate) === false &&
          isDateInFormatWithMoment(detail.estimatedArrivalDate, onlyDateFormat) === false
        ) {
          showNotificationError(
            `(${makeCombineCode(detail)}) 예상 배송일이 올바르지 않습니다. YYYY-MM-DD 형식으로 입력해 주세요.`
          );
          return false;
        }
        if (!validateBrandUserAddress(detail.postalCode, detail.streetAddress1, combineCode)) {
          return false;
        }
        continue;
      } else if (isDetailForHqBrand(detail)) {
        if (utils.isEmpty(detail.customerLoginId, true)) {
          showNotificationError("회원 ID가 지정되지 않은 셀이 존재합니다.");
          return false;
        }
        if (!validateBrandUserAddress(detail.postalCode, detail.streetAddress1, combineCode)) {
          return false;
        }
        if (utils.isEmpty(detail.bpSku, true)) {
          showNotificationError(`(${combineCode}) 상품코드가 지정되지 않은 셀이 존재합니다.`);
          return false;
        }
        if (utils.isEmpty(detail.qty, true)) {
          showNotificationError(`(${combineCode}) 주문 수량이 지정되지 않은 셀이 존재합니다.`);
          return false;
        }
        continue;
      } else {
        if (!validateNonBrandUserAddress(detail.postalCode, detail.streetAddress1, "")) {
          return false;
        }
        if (isDetailForBadStock(detail)) {
          if (utils.isEmpty(detail.openMallName, true)) {
            showNotificationError("오픈몰명이 지정되지 않은 셀이 존재합니다.");
            return false;
          }
          if (utils.isEmpty(detail.openMallOrderNumber, true)) {
            showNotificationError("오픈몰 주문번호가 지정되지 않은 셀이 존재합니다.");
            return false;
          }
        }

        if (isDetailForEtc(detail)) {
          if (utils.isEmpty(detail.decreaseStockFlag)) {
            showNotificationError("재고 반영 여부가 지정되지 않은 셀이 존재합니다.");
            return false;
          }
        }
      }

      const firstName = detail.firstName;
      const phone = detail.phone;
      const streetAddress1 = detail.streetAddress1;
      const postalCode = detail.postalCode;
      if (utils.isEmpty(firstName, true)) {
        showNotificationError(`(${combineCode}) 배송지: 받는 사람이 지정되지 않은 셀이 존재합니다.`);
        return false;
      }
      if (utils.isEmpty(phone, true)) {
        showNotificationError(`(${combineCode}) 배송지: 연락처가 지정되지 않은 셀이 존재합니다.`);
        return false;
      }
      if (utils.isEmpty(streetAddress1, true)) {
        showNotificationError(`(${combineCode}) 배송지: 주소가 지정되지 않은 셀이 존재합니다.`);
        return false;
      }
      if (postalCode !== null && postalCode.length < 5) {
        showNotificationError(`(${combineCode}) 우편번호: 우편번호 형식에 맞지 않는 셀이 존재합니다.`);
        return false;
      }

      const productSku = isDetailForBrand(detail) ? detail.bpSku : detail.productSku;
      const qty = Number(detail.qty);
      const price = Number(detail.price);
      if (utils.isEmpty(productSku, true)) {
        showNotificationError(
          `(${combineCode}) 주문 상품 정보: ${
            isOrderedByStaffForBrand ? "상품코드" : "제품코드"
          }가 지정되지 않은 셀이 존재합니다.`
        );
        return false;
      }
      if (utils.isEmpty(qty, true)) {
        showNotificationError(`(${combineCode}) 주문 상품 정보: 주문 수량이 지정되지 않은 셀이 존재합니다.`);
        return false;
      }
      if (qty <= 0) {
        showNotificationError(`(${combineCode}) 주문 상품 정보: 주문 수량은 0보다 큰 수량으로 입력해야 합니다.`);
        return false;
      }
      if (!Number.isInteger(qty * 10)) {
        showNotificationError(
          `(${combineCode}) 주문 상품 정보: 주문 수량 형식이 올바르지 않습니다. 정수 또는 소수점 한 자리 숫자로 입력해 주세요.`
        );
        return false;
      }
      // 대행 주문(BY_STAFF_FOR_BRAND, BY_HQ_STAFF_FOR_BRAND)이 아닌 경우에만 가격 validation
      if (!isOrderedByStaffForBrand && !isOrderedByHqStaffForBrand) {
        if (utils.isEmpty(price, true)) {
          showNotificationError(`(${combineCode}) 주문 상품 정보: 상품 판매가가 지정되지 않은 셀이 존재합니다.`);
          return false;
        }
        if (price < 0) {
          showNotificationError(`(${combineCode}) 주문 상품 정보: 상품 판매가는 0 이상의 정수로 입력해야 합니다.`);
          return false;
        }
      }
    }

    return true;
  };

  const validateDuplicate = (details: TDetail[]) => {
    const combineCodesWithSku = [];
    const errors = [];
    for (const detail of details) {
      const sku = isDetailForBrand(detail) || isDetailForHqBrand(detail) ? detail.bpSku : detail.productSku;
      const combineCodeWithSku = `${makeCombineCode(detail)}:${sku}`;
      if (combineCodesWithSku.find((c) => c === combineCodeWithSku)) {
        errors.push(combineCodeWithSku);
      } else {
        combineCodesWithSku.push(combineCodeWithSku);
      }
    }
    const isOk = errors.length <= 0;
    if (!isOk) {
      const errorHeader = `${
        isOrderedByStaffForBrand || isOrderedByHqStaffForBrand
          ? "회원 ID:수령자 이름"
          : isOrderedByStaffForBadStock
          ? "오픈몰명:오픈몰 주문번호"
          : "-"
      }:${isOrderedByStaffForBrand || isOrderedByHqStaffForBrand ? "상품코드" : "제품코드"}`;
      const errorMsg = (
        <>
          ({errorHeader}) 중복:
          <br />
          {errors.join(", ")}
        </>
      );
      showNotificationError(errorMsg);
    }
    return isOk;
  };

  const validatePriceVatInRange = (details: TDetail[]) => {
    const errors = [];
    for (const detail of details) {
      const price = Number(detail.price);
      const priceVat = Number(detail.priceVat);
      const sku = isDetailForBrand(detail) || isDetailForHqBrand(detail) ? detail.bpSku : detail.productSku;
      if (priceVat > 0) {
        const priceVatPrecision = String(priceVat).split(".")[1]?.length || 0;
        const pricePrecision = String(price).split(".")[1]?.length || 0;
        const precision = Math.max(priceVatPrecision, pricePrecision);
        const { isValid, ceil } = checkVatValueToPriceIncludeVat(priceVat, price, precision);
        if (isValid === false) {
          const errorInfo = `${makeCombineCode(detail)}:${sku} 부가세 입력 가능한 값 ${ceil}`;
          errors.push(errorInfo);
        }
      } else if (priceVat < 0) {
        const errorInfo = `${makeCombineCode(detail)}:${sku} 부가세는 0 이상의 정수로 입력해야 합니다.`;
        errors.push(errorInfo);
      }
    }
    const isOk = errors.length <= 0;
    if (!isOk) {
      const errorHeader = `${
        isOrderedByStaffForBrand || isOrderedByHqStaffForBrand
          ? "회원 ID:수령자 이름"
          : isOrderedByStaffForBadStock
          ? "오픈몰명:오픈몰 주문번호"
          : "-"
      }:${isOrderedByStaffForBrand || isOrderedByHqStaffForBrand ? "상품코드" : "제품코드"}`;
      const errorMsg = (
        <>
          ({errorHeader}) 부가세 금액 범위 오류:
          <br />
          {errors.join(", ")}
        </>
      );
      showNotificationError(errorMsg);
    }
    return isOk;
  };

  const groupBy = <T,>(array: T[], keys: Array<keyof T>) =>
    array.reduce((acc, obj) => {
      // keys 조합으로 그룹 식별자 생성
      const key = keys.map((k) => obj[k]).join("|");
      if (!acc[key]) {
        acc[key] = [];
      }
      acc[key].push(obj);
      return acc;
    }, {} as Record<string, T[]>);

  const validateBizRegNo = async (details: IForBrandTemplate[]) => {
    const grouped = groupBy(details, groupConditionKeysForBrand);

    const errorUsers = [];
    for (const groupKey in grouped) {
      if (grouped.hasOwnProperty(groupKey) === false) {
        continue;
      }
      const group = grouped[groupKey];

      const [firstItem] = group;
      const { taxInvoiceBizRegNo, taxInvoiceBizCorpName, taxInvoiceBizCeoName } = firstItem;

      for (const item of group) {
        if (item.taxInvoiceBizRegNo !== taxInvoiceBizRegNo) {
          errorUsers.push(
            `${item.customerLoginId}:${item.firstName} 사업자번호 (${item.taxInvoiceBizRegNo} != ${taxInvoiceBizRegNo})`
          );
        }
        if (item.taxInvoiceBizCorpName !== taxInvoiceBizCorpName) {
          errorUsers.push(
            `${item.customerLoginId}:${item.firstName} 상호 (${item.taxInvoiceBizCorpName} != ${taxInvoiceBizCorpName})`
          );
        }
        if (item.taxInvoiceBizCeoName !== taxInvoiceBizCeoName) {
          errorUsers.push(
            `${item.customerLoginId}:${item.firstName} 대표자명 (${item.taxInvoiceBizCeoName} != ${taxInvoiceBizCeoName})`
          );
        }
      }
    }

    if (errorUsers.length > 0) {
      const errorMsg = "대행주문의 대체 사업자 정보는 주문자 정보별로 동일해야합니다. " + errorUsers.join(", ");
      showNotificationError(errorMsg);
      return false;
    }

    const uniqueBizRegNos = new Set(Object.values(grouped).map((group) => group[0].taxInvoiceBizRegNo));
    const temporaryClosedErrorBizRegNoList = [];
    const permanentClosedErrorBizRegNoList = [];
    const notExistErrorBizRegNoList = [];
    const etcErrorBizRegNoList = [];
    for (const bizRegNo of uniqueBizRegNos) {
      if (bizRegNo) {
        const returnType = await utils.callOpenApiValidateBizRegNo(
          bizRegNo,
          OpenApiBizRegNoBatchErrorMode.BATCH_ERROR_MODE
        );
        if (returnType === OpenApiBizRegNoReturnType.FAIL) {
          return false;
        } else if (returnType !== OpenApiBizRegNoReturnType.OK) {
          switch (returnType) {
            case OpenApiBizRegNoReturnType.TEMPORARY_CLOSED:
              temporaryClosedErrorBizRegNoList.push(bizRegNo);
              break;
            case OpenApiBizRegNoReturnType.PERMANENT_CLOSED:
              permanentClosedErrorBizRegNoList.push(bizRegNo);
              break;
            case OpenApiBizRegNoReturnType.NOT_EXIST:
              notExistErrorBizRegNoList.push(bizRegNo);
              break;
            default:
              etcErrorBizRegNoList.push(bizRegNo);
              break;
          }
        }
      }
    }

    if (temporaryClosedErrorBizRegNoList.length > 0) {
      const errorMsg = `${OpenApiBizRegNoReturnType.NOT_EXIST}: ` + temporaryClosedErrorBizRegNoList.join(", ");
      showNotificationError(errorMsg);
      return false;
    }
    if (permanentClosedErrorBizRegNoList.length > 0) {
      const errorMsg = `${OpenApiBizRegNoReturnType.PERMANENT_CLOSED}: ` + permanentClosedErrorBizRegNoList.join(", ");
      showNotificationError(errorMsg);
      return false;
    }
    if (notExistErrorBizRegNoList.length > 0) {
      const errorMsg = `${OpenApiBizRegNoReturnType.TEMPORARY_CLOSED}: ` + notExistErrorBizRegNoList.join(", ");
      showNotificationError(errorMsg);
      return false;
    }

    return true;
  };

  // 대행 주문인 경우, grouped 된 주문들에 대해
  // 1. deliveryMethod, estimatedArrivalDate 같은지 체크
  // 2. additionalFeeForEtcDelivery 가 한 번 이하로 입력되었는지 체크(같은 주문에 대하여 없거나 한 번만 입력되어야 함)
  const validateDeliveryDiff = (details: IForBrandTemplate[]) => {
    const grouped = groupBy(details, groupConditionKeysForBrand);
    const errorUsers = [];
    const errorFulfillType = [];
    const errorUsersForDeliveryAdditionalFee = [];
    const errorUsersForAdditionalFeeEtcDelivery = [];
    for (const groupKey in grouped) {
      if (grouped.hasOwnProperty(groupKey) === false) {
        continue;
      }
      const group = grouped[groupKey];

      const [firstItem] = group;
      const { deliveryMethod, estimatedArrivalDate, fulfillType } = firstItem;

      for (const item of group) {
        if (item.deliveryMethod !== deliveryMethod) {
          const firstDeliveryMethod = convertDeliveryTypeEnumToWord(deliveryMethod);
          const currentDeliveryMethod = convertDeliveryTypeEnumToWord(item.deliveryMethod);
          errorUsers.push(
            `${item.customerLoginId}:${item.firstName} - 배송방식 (${currentDeliveryMethod} != ${firstDeliveryMethod})`
          );
        }
        if (item.fulfillType !== fulfillType) {
          const firstFulfillType = convertToFulfillTypeEnum(fulfillType);
          const currentFulfillType = convertToFulfillTypeEnum(item.fulfillType);
          errorFulfillType.push(
            `${item.customerLoginId}:${item.firstName} - 출고유형 (${currentFulfillType} != ${firstFulfillType})`
          );
        }
        if (item.estimatedArrivalDate !== estimatedArrivalDate) {
          errorUsers.push(
            `${item.customerLoginId}:${item.firstName} - 납품요청일 (${item.estimatedArrivalDate} != ${estimatedArrivalDate})`
          );
        }
      }

      const additionalFeeForEtcDeliveryCount = group.filter(
        (item) => utils.isEmpty(item.additionalFeeForEtcDelivery) === false
      ).length;
      if (additionalFeeForEtcDeliveryCount > 1) {
        errorUsersForDeliveryAdditionalFee.push(`${firstItem.customerLoginId}:${firstItem.firstName}`);
      }

      const isByCourier = deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER;
      if (isByCourier && additionalFeeForEtcDeliveryCount > 0) {
        errorUsersForAdditionalFeeEtcDelivery.push(`${firstItem.customerLoginId}:${firstItem.firstName}`);
      }
    }

    if (errorUsers.length > 0) {
      const errorMsg = "대행주문의 배송방식, 납품요청일는 주문자 정보별로 동일해야합니다. " + errorUsers.join(", ");
      showNotificationError(errorMsg);
      return false;
    }
    if (errorFulfillType.length > 0) {
      const errorMsg = "대행주문의 출고유형은 주문자 정보별로 동일해야합니다. " + errorFulfillType.join(", ");
      showNotificationError(errorMsg);
      return false;
    }
    if (errorUsersForDeliveryAdditionalFee.length > 0) {
      showNotificationError(
        "대행주문의 도서산간 지역 추가 배송비는 주문자 정보별로 한 번 이하로만 입력 가능합니다. " +
          errorUsersForDeliveryAdditionalFee.join(", ")
      );
      return false;
    }
    if (errorUsersForAdditionalFeeEtcDelivery.length > 0) {
      showNotificationError(
        "도서산간 지역 추가 배송비는 택배 배송 외의 배송 방식에서만 입력할 수 있습니다. " +
          errorUsersForAdditionalFeeEtcDelivery.join(", ")
      );
      return false;
    }
    return true;
  };

  const convertUploadValuesToInput = (uploadedDetails: TDetail[]) => {
    uploadedDetails.sort((a, b) => {
      for (const targetKey of groupConditionKeys) {
        if (a[targetKey] < b[targetKey]) {
          return -1;
        }
        if (a[targetKey] > b[targetKey]) {
          return 1;
        }
      }
      return 0;
    });

    const groupedDetails: Array<TDetail & { orderLines: OrderLinesByStaff[] }> = uploadedDetails.reduce(
      (result, currentItem) => {
        const lastItem = result[result.length - 1];
        const currentOrderLine: OrderLinesByStaff = {
          bpSku: isDetailForBrand(currentItem) || isDetailForHqBrand(currentItem) ? currentItem.bpSku : undefined,
          productSku:
            isDetailForBrand(currentItem) || isDetailForHqBrand(currentItem) ? undefined : currentItem.productSku,
          qty: currentItem.qty,
          price: currentItem.price,
          priceVat: currentItem.priceVat,
          // 대행 주문 외의 주문인 경우(오픈몰, 기타 배송) 본부수익금과 무관하므로 양식에는 없지만, calcMileage 필드를 false로 설정한다.
          // 가맹본부 대행은 본부수익금 적용 대상이 아니므로 false로 설정
          calcMileage: isDetailForBrand(currentItem) ? parseExcelBooleanStrict(currentItem.calcMileage) : false,
          etcDeliveryFee: isDetailForBrand(currentItem) ? Number(currentItem.etcDeliveryFee) : undefined,
          decreaseStockFlag: isDetailForEtc(currentItem)
            ? parseExcelBooleanStrict(currentItem.decreaseStockFlag)
            : undefined,
          excludeStockAvgStats: isDetailForBrand(currentItem)
            ? parseExcelBooleanStrict(currentItem.excludeStockAvgStats)
            : undefined,
        };
        if (isOrderedByStaffForEtc) {
          const equalIdx = result.findIndex(
            (item) =>
              item.firstName === currentItem.firstName &&
              item.phone === currentItem.phone &&
              item.streetAddress1 === currentItem.streetAddress1
          );
          if (result.length === 0 || equalIdx === -1) {
            result.push({
              ...currentItem,
              orderLines: [currentOrderLine],
            });
          } else {
            result[equalIdx].orderLines.push(currentOrderLine);
          }
        } else {
          // NOTE: 이전 아이템과 현재 아이템의 각 그룹 조건 key의 value가 모두 같으면 해당 주문의 orderLine만 추가, 아니면 새로운 주문으로 추가
          if (lastItem && groupConditionKeys.every((targetKey) => lastItem[targetKey] === currentItem[targetKey])) {
            lastItem.orderLines.push(currentOrderLine);
          } else {
            result.push({
              ...currentItem,
              orderLines: [currentOrderLine],
            });
          }
        }
        return result;
      },
      []
    );
    const details: OrderBulkCreateByStaffDetailInput[] = groupedDetails.map((detail) => ({
      customerLoginId: isDetailForBrand(detail) || isDetailForHqBrand(detail) ? detail.customerLoginId : undefined,
      taxInvoiceRequestFlag: isDetailForBrand(detail)
        ? parseExcelBooleanStrict(detail.taxInvoiceRequestFlag)
        : undefined,
      altInvoiceeBizInfo:
        isDetailForBrand(detail) && parseExcelBooleanStrict(detail.taxInvoiceRequestFlag)
          ? makeAltInvoiceeBizInfo(detail)
          : undefined,
      openMallName: isDetailForBadStock(detail) ? detail.openMallName : undefined,
      openMallOrderNumber: isDetailForBadStock(detail) ? detail.openMallOrderNumber : undefined,
      shippingAddress: {
        country: CountryCode.KR,
        countryArea: detail.streetAddress1 ? detail.streetAddress1.split(" ")[0] : null,
        firstName: detail.firstName,
        phone: detail.phone,
        streetAddress1: detail.streetAddress1,
        streetAddress2: detail.streetAddress2 || "",
        postalCode: detail.postalCode,
      },
      deliveryMethod: isDetailForBrand(detail) ? detail.deliveryMethod : undefined,
      fulfillType:
        isDetailForBrand(detail) && detail.deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER
          ? detail.fulfillType
          : undefined,
      additionalFeeForEtcDelivery: isDetailForBrand(detail) ? Number(detail.additionalFeeForEtcDelivery) : undefined,
      estimatedArrivalDate: isDetailForBrand(detail) ? detail.estimatedArrivalDate : undefined,
      orderLines: detail.orderLines,
      staffNote: isDetailForEtc(detail) ? detail.staffNote : undefined,
      customerNote: detail.customerNote || "",
    }));
    const input: OrderBulkCreateByStaffInput = { details };
    return input;
  };

  const handleDownloadExcel = () => {
    if (!previewData || previewData.length === 0) {
      showNotificationError("다운로드할 데이터가 없습니다.");
      return;
    }

    const excelData = previewData.map((detail) => ({
      "주문 매장": detail.customerLoginId,
      "배송지 우편번호": detail.postalCode || "",
      "배송지 주소": transformAddress(detail, false),
      상품코드: detail.bpSku || "",
      상품명: detail.productName || "",
      "주문 수량": detail.qty,
      요청사항: detail.customerNote || "",
    }));

    const worksheet = xlsx.utils.json_to_sheet(excelData);
    const workbook = xlsx.utils.book_new();
    xlsx.utils.book_append_sheet(workbook, worksheet, "주문 미리보기");
    excelDownloadByWorkBook({
      workBook: workbook,
      title: `가맹본부_대행주문_미리보기_${moment().format("YYYYMMDDHHmmss")}.xlsx`,
    });
  };

  const handleVerifyAddress = async () => {
    const formValues = form.getFieldValue("details") as TDelegateOrderTemplate[];

    if (!formValues || formValues.length === 0) {
      showNotificationError("업로드된 데이터가 없습니다.");
      return;
    }

    const uniqueLoginIds = Array.from(new Set(formValues.map((d) => d.customerLoginId).filter(Boolean)));

    try {
      const { data } = await fetchCustomersDefaultAddress({
        variables: {
          filter: { loginIds: uniqueLoginIds },
        },
      });

      const customers = data?.customers?.edges || [];
      const customerAddressMap = new Map();

      customers.forEach((edge: CustomersDefaultShippingAddress_customers_edges) => {
        const customer = edge.node;
        if (customer.defaultShippingAddress) {
          customerAddressMap.set(customer.loginId, customer.defaultShippingAddress);
        }
      });

      const customersWithoutAddress: string[] = [];
      const updatedDetails = formValues.map((detail) => {
        // 우편번호만 없는 주소인 경우에는 벡엔드 GetPostalCodesFromAddressesBulk 로직으로 우편번호 찾기로 처리되는 valid한 주소로 간주
        const hasAddress = !utils.isEmpty(detail.streetAddress1, true);

        if (!hasAddress) {
          const defaultAddress = customerAddressMap.get(detail.customerLoginId);
          if (defaultAddress) {
            return {
              ...detail,
              firstName: defaultAddress.firstName || detail.firstName,
              phone: defaultAddress.phone || detail.phone,
              postalCode: defaultAddress.postalCode || detail.postalCode,
              streetAddress1: defaultAddress.streetAddress1 || detail.streetAddress1,
              streetAddress2: defaultAddress.streetAddress2 || detail.streetAddress2 || "",
            };
          } else {
            if (!customersWithoutAddress.includes(detail.customerLoginId)) {
              customersWithoutAddress.push(detail.customerLoginId);
            }
          }
        }
        return detail;
      });

      if (customersWithoutAddress.length > 0) {
        showNotificationError(
          `다음 고객의 기본 배송지가 등록되어 있지 않습니다: ${customersWithoutAddress.join(", ")}`
        );
        return;
      }

      const uniqueSkus = Array.from(new Set(updatedDetails.map((d) => d.bpSku).filter(Boolean)));
      const productNameMap = new Map<string, string>();

      for (const sku of uniqueSkus) {
        try {
          const { data: productData } = await fetchBrandProducts({
            variables: {
              filter: { brandProductSearch: sku },
              first: 1,
            },
          });

          const product = productData?.brandProducts?.edges?.[0]?.node;
          if (product) {
            const matchingVariant = product.brandProductVariants?.find(
              (variant: BrandProductsForOrderProductName_brandProducts_edges_node_brandProductVariants | null) =>
                variant?.bpSku === sku
            );
            if (matchingVariant) {
              productNameMap.set(sku, product.name || "");
            }
          }
        } catch (productError) {
          console.error(`상품 조회 실패 (SKU: ${sku}):`, productError);
        }
      }

      const updatedDetailsWithProductNames = updatedDetails.map((detail) => ({
        ...detail,
        productName: productNameMap.get(detail.bpSku) || "",
      }));

      form.setFieldsValue({ details: updatedDetailsWithProductNames });
      setPreviewData(updatedDetailsWithProductNames);
      setShowAddressPreview(true);
      setCurrentPage(1);
    } catch (error) {
      showNotificationError("기본 배송지 조회 중 오류가 발생했습니다.");
      return;
    }
  };

  useEffect(() => {
    const autoVerifyAddress = async () => {
      const isDelegateOrder = isOrderedByStaffForBrand || isOrderedByHqStaffForBrand;
      const isValidData =
        (isOrderedByStaffForBrand && isDetailsForBrand(detailsWatched)) ||
        (isOrderedByHqStaffForBrand && isDetailsForHqBrand(detailsWatched));

      if (
        (user?.isStaff || user?.isHqStaff) &&
        isDelegateOrder &&
        detailsWatched &&
        isValidData &&
        !showAddressPreview
      ) {
        const delegateDetails = detailsWatched as TDelegateOrderTemplate[];
        if (hasRowsWithoutAddress(delegateDetails)) {
          await handleVerifyAddress();
        }
      }
    };

    autoVerifyAddress();
  }, [
    detailsWatched,
    user?.isStaff,
    user?.isHqStaff,
    isOrderedByStaffForBrand,
    isOrderedByHqStaffForBrand,
    showAddressPreview,
  ]);

  const onSubmit = async (formData: OrderCreateByStaffFormData) => {
    const { details: formValues } = formData;

    const validateAry = [];
    validateAry.push(validateOrderType());
    validateAry.push(validateUploadedValueEmpty(formValues));
    if (!isDetailsForEtc(formValues) && !isDetailsForHqBrand(formValues)) {
      validateAry.push(validateDuplicate(formValues));
      validateAry.push(validatePriceVatInRange(formValues));
    }
    // 가맹본부 대행 주문은 중복 체크만 필요
    if (isDetailsForHqBrand(formValues)) {
      validateAry.push(validateDuplicate(formValues));
    }
    // MD 대행 주문인 경우에만 date time을 체크, 사업자번호 체크 한다.
    if (isDetailsForBrand(formValues)) {
      validateAry.push(await validateBizRegNo(formValues));
      validateAry.push(validateDeliveryDiff(formValues));
    }

    if (validateAry.findIndex((v) => v === false) >= 0) {
      setSelectedFile(null);
      setErrorExist(true);
      setFormChanged(false);
      return;
    }

    const dataToSubmit = showAddressPreview ? previewData : formValues;
    const input = convertUploadValuesToInput(dataToSubmit);
    await orderBulkCreateByStaffMutation({
      variables: {
        type: convertOrderTypeToEnum(orderType),
        input,
        isHqStaff: user?.isHqStaff,
      },
    });
  };

  const modalWidth = showAddressPreview ? 1200 : 520;

  const previewColumns: ColumnsType<TDelegateOrderTemplate> = [
    {
      title: "주문 매장",
      key: "customerLoginId",
      align: "center",
      width: 120,
      render: (_, record) => record.customerLoginId || "",
    },
    {
      title: "배송지 우편번호",
      key: "postalCode",
      align: "center",
      width: 120,
      render: (_, record) => record.postalCode || "",
    },
    {
      title: "배송지 주소",
      key: "address",
      width: 250,
      render: (_, record) => transformAddress(record, false),
    },
    {
      title: "상품코드",
      key: "bpSku",
      align: "center",
      width: 120,
      render: (_, record) => record.bpSku || "",
    },
    {
      title: "상품명",
      key: "productName",
      width: 200,
      render: (_, record) => record.productName || "",
    },
    {
      title: "주문 수량",
      key: "qty",
      align: "right",
      width: 80,
      render: (_, record) => record.qty || "",
    },
    {
      title: "요청사항",
      key: "customerNote",
      width: 150,
      render: (_, record) => record.customerNote || "",
    },
  ];

  return (
    <Modal
      destroyOnClose
      forceRender
      open={open}
      width={modalWidth}
      title={`${orderTypeName} 생성`}
      footer={
        <Space>
          <Button onClick={resetForCloseModal}>뒤로</Button>
          {showAddressPreview && <Button onClick={handleDownloadExcel}>다운로드</Button>}
          <Button
            type="primary"
            onClick={form.submit}
            loading={orderBulkCreateByStaffMutationOpts.loading || loadingCustomersAddress}
            disabled={disabled || utils.isEmpty(detailsWatched) || !formChanged}
          >
            {showAddressPreview ? "주문 확정" : "생성"}
          </Button>
        </Space>
      }
      onCancel={resetForCloseModal}
      maskClosable={false}
    >
      <Form
        form={form}
        name="order-create-file-form"
        labelAlign="left"
        validateTrigger="onSubmit"
        onFinish={onSubmit}
        labelCol={{ span: 4 }}
        wrapperCol={{ span: 20 }}
        onValuesChange={() => setFormChanged(true)}
      >
        <Form.Item
          name={"details"}
          label="주문 정보"
          rules={[
            {
              required: true,
              message: "생성할 주문 정보 엑셀 파일을 선택해 주세요",
            },
          ]}
        >
          <Space size={"middle"} direction={"vertical"} style={{ width: "100%" }}>
            <Button onClick={handleUploadButtonClick} type="primary">
              생성할 주문 엑셀파일 선택
            </Button>
            {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile.name}</Typography.Text>}
            {selectedFile && errorExist && (
              <Typography.Text type="warning">
                오류로 엑셀 파일을 수정한 경우 데이터 리로딩을 위해서 다시 엑셀 파일을 선택해 주세요.
              </Typography.Text>
            )}
            <input
              hidden={true}
              id="reserveChangeInputFile"
              onChange={(e) => readUploadFile(e)}
              type="file"
              ref={upload}
              accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
            />
          </Space>
        </Form.Item>
        {showAddressPreview && previewData.length > 0 && (
          <div style={{ marginTop: 16 }}>
            <Table
              {...commonTableProps}
              columns={previewColumns}
              dataSource={previewData}
              rowKey={(record) => `${record.customerLoginId}-${record.bpSku}`}
              pagination={{
                current: currentPage,
                pageSize: 50,
                onChange: (page) => setCurrentPage(page),
                showSizeChanger: false,
              }}
              scroll={{ y: 250 }}
              size="small"
            />
          </div>
        )}
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/order/orders/components/OrderDetailsFulfilledItems.tsx">
import { FulfillmentTypeColor } from "@assets/constants/colors";
import { FulfillmentStatus, OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import CardMenu from "@src/app/components/CardMenu";
import Skeleton from "@src/app/components/Skeleton";
import StatusLabel from "@src/app/components/StatusLabel";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { openTrackingWindow } from "@src/app/views/settings/couriers/utils";
import { convertDeliveryTypeEnumToWord, maybe, transformIsFBV } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Space, Table, Tag, Typography } from "antd";
import React from "react";

import { OrderDetails_order, OrderDetails_order_fulfillments } from "../api/types/OrderDetails";
import { checkOrderedByHqStaffForBrand, checkOrderedByStaffForEtc } from "../utils";
import { getOrderDetailsHeaderInfoColumns } from "./OrderDetailsUnfulfilledItems";

interface OrderDetailsFulfilledItemsProps {
  order: OrderDetails_order;
  fulfillment: OrderDetails_order_fulfillments;
  onFulfillmentCancel: () => void;
  onFulfillmentUpdateTrackingForCourier: () => void;
  onFulfillmentUpdateTrackingForNonCourier: () => void;
  onFulfillmentUpdateTrackingForDs: () => void;
  onFulfillmentUpdateTrackingForCompleted: () => void;
  couriers: CourierList_couriers_edges_node[];
  isHqStaff: boolean;
}

export const OrderDetailsFulfilledItems: React.FC<OrderDetailsFulfilledItemsProps> = (props) => {
  const {
    order,
    fulfillment,
    onFulfillmentCancel,
    onFulfillmentUpdateTrackingForCourier,
    onFulfillmentUpdateTrackingForNonCourier,
    onFulfillmentUpdateTrackingForCompleted,
    couriers,
    isHqStaff,
  } = props;
  const orderType = order.type;
  const orderDeliveryMethod = maybe(() => order.deliveryMethod);
  const isOrderedByStaffForEtc = checkOrderedByStaffForEtc(orderType);
  const isOrderedByHqStaffForBrand = checkOrderedByHqStaffForBrand(orderType);
  const fulfilledDeliveryMethod = maybe(() => fulfillment.deliveryMethod);
  const etcDeliveryManInfo = maybe(() => fulfillment.etcDeliveryManInfo);
  const lines = maybe(() => fulfillment.lines);
  const status = maybe(() => fulfillment.status);
  const hasTrackingNumber = maybe(() => (utils.isEmpty(fulfillment.trackingNumber) === false ? true : false), false);
  const isTrackingCompleted = maybe(() => fulfillment.isTrackingCompleted, false);
  const isFulfilledByVendor = maybe(() => fulfillment.isFulfilledByVendor, false);
  const quantity = lines
    ? lines.map((line) => line.quantity).reduce((prev, curr) => utils.convertToNumberWrapper(prev + curr, 1), 0)
    : "...";
  const columns = getOrderDetailsHeaderInfoColumns({
    isHqStaff,
    useFulfillmentLines: true,
    deliveryMethod: orderDeliveryMethod,
    couriers,
  });
  const numberOfColumns = columns.length;
  const isEtcDelivery = fulfilledDeliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER;
  const isEtcDeliveryInfoEmpty = utils.isEmpty(etcDeliveryManInfo);

  // 주문 시 배송 방법과 출고 시 배송 방법이 다를 경우, 출고 시 배송 방법을 주문 시 배송 방법으로 변경
  const isDeliveryMethodChanged = orderDeliveryMethod !== fulfilledDeliveryMethod;
  const fulfilledDeliveryMethodText = convertDeliveryTypeEnumToWord(fulfilledDeliveryMethod);
  const titleLabel =
    status === FulfillmentStatus.FULFILLED
      ? isTrackingCompleted
        ? "배송완료"
        : hasTrackingNumber
        ? `배송중 수량: ${quantity}`
        : `배송준비중 수량: ${quantity}`
      : status === FulfillmentStatus.CANCELED
      ? `교환 출고취소 수량: ${quantity}`
      : `반품 출고취소 수량: ${quantity}`;

  const title = !!lines ? (
    <StatusLabel
      useSmallDot
      label={
        <Space direction="horizontal" size={"small"}>
          <Typography.Title level={5}>{titleLabel}</Typography.Title>
          <Typography.Text style={{ fontSize: "14px" }}>
            {maybe(() => `${fulfillment.composedIdWithPrefix}`)}
          </Typography.Text>
          {isFulfilledByVendor && <Tag color={FulfillmentTypeColor.isFBV}>{transformIsFBV(true)} 상품</Tag>}
          {isDeliveryMethodChanged && <Tag color="#f50">출고된 배송 방식: {fulfilledDeliveryMethodText}</Tag>}
        </Space>
      }
      status={status === FulfillmentStatus.FULFILLED ? "success" : "error"}
    />
  ) : (
    <Skeleton />
  );

  const cancelFulfillmentMenuText = fulfillment?.isFulfilledByVendor ? "출고 취소 불가 주문" : "출고 취소";

  const extra = maybe(() => fulfillment.status) === FulfillmentStatus.FULFILLED && (
    <CardMenu
      menuItems={[
        {
          label: cancelFulfillmentMenuText,
          onSelect: onFulfillmentCancel,
          disabled: fulfillment.isFulfilledByVendor,
        },
      ]}
    />
  );

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const tableSummary = () => (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} colSpan={numberOfColumns}>
          <Space direction="vertical">
            <>
              {!isEtcDelivery &&
                (hasTrackingNumber ? (
                  <Space>
                    <Typography.Text>
                      택배사: {fulfillment?.courier?.name || "-"} / 송장번호: {fulfillment?.trackingNumber || "-"}
                    </Typography.Text>
                    <Button
                      type="primary"
                      size="small"
                      onClick={() => openTrackingWindow(fulfillment.trackingNumber, fulfillment.courier.id, couriers)}
                    >
                      조회
                    </Button>
                  </Space>
                ) : (
                  <Typography.Text>송장번호 입력 안됨</Typography.Text>
                ))}
            </>
          </Space>
        </Table.Summary.Cell>
      </Table.Summary.Row>
      {isFulfilledByVendor && (
        <Table.Summary.Row>
          <Table.Summary.Cell index={0} colSpan={numberOfColumns}>
            <Typography.Text type="danger">
              {transformIsFBV(true)} 상품의 송장번호 수정, 배송완료 상태 변경, 출고 취소는 직거래 상품 메뉴에서만 할 수
              있습니다.
            </Typography.Text>
          </Table.Summary.Cell>
        </Table.Summary.Row>
      )}
      {isHqStaff === false && isFulfilledByVendor === false && (
        <Table.Summary.Row>
          <Table.Summary.Cell index={0} colSpan={numberOfColumns} align={"left"}>
            {!isEtcDelivery && status === FulfillmentStatus.FULFILLED && !fulfillment.trackingNumber && (
              <Button type="primary" onClick={onFulfillmentUpdateTrackingForCourier}>
                {"송장번호 입력"}
              </Button>
            )}
            {!isEtcDelivery && status === FulfillmentStatus.FULFILLED && fulfillment.trackingNumber && (
              <Space>
                <Button type="primary" onClick={onFulfillmentUpdateTrackingForCourier}>
                  {"송장번호 수정"}
                </Button>
                <Button type="primary" onClick={onFulfillmentUpdateTrackingForCompleted}>
                  배송완료상태 변경
                </Button>
              </Space>
            )}
            {isEtcDelivery && (
              <Space>
                <Button color="primary" onClick={onFulfillmentUpdateTrackingForNonCourier}>
                  {isEtcDeliveryInfoEmpty ? "배송시작" : "배차정보 수정"}
                </Button>
                {status === FulfillmentStatus.FULFILLED && fulfillment.trackingNumber && (
                  <Button type="primary" onClick={onFulfillmentUpdateTrackingForCompleted}>
                    배송완료상태 변경
                  </Button>
                )}
              </Space>
            )}
          </Table.Summary.Cell>
        </Table.Summary.Row>
      )}
    </Table.Summary>
  );

  return (
    <Card
      type="inner"
      title={title}
      extra={!isHqStaff && isOrderedByStaffForEtc ? extra : null}
      bodyStyle={{ padding: 0 }}
    >
      <TableVatLegend isIncludeVat={isHqStaff ? false : true} size="small" />
      <Table
        {...commonTableProps}
        columns={columns}
        dataSource={lines}
        scroll={{ x: tableWidthSum, y: 500 }}
        summary={!isHqStaff || isOrderedByHqStaffForBrand ? tableSummary : null}
        sticky={false}
      />
    </Card>
  );
};
</file>

<file path="src/app/views/order/orders/components/OrderDetailsUnfulfilledItems.tsx">
import { FulfillmentTypeColor } from "@assets/constants/colors";
import { OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import NumberComponent from "@src/app/components/Number";
import Skeleton from "@src/app/components/Skeleton";
import StatusLabel from "@src/app/components/StatusLabel";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { DateTime } from "@src/app/providers/DateProvider";
import { getStatusLabel } from "@src/app/views/b2b/components/B2bOrderLineListPage/utils";
import {
  getNumberFormat,
  makeProductQtyPerBoxText,
  makeProductSpecTextFromAttr,
} from "@src/app/views/product/products/utils/data";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { openTrackingWindow } from "@src/app/views/settings/couriers/utils";
import { transformIsFBV, transformTaxFree } from "@utils/misc";
import { makeTagFulfillmentType, makeTagIsFBV } from "@utils/tags";
import { utils } from "@utils/utils";
import { Card, Space, Table, Tag, Typography } from "antd";
import { ColumnsType, ColumnType } from "antd/lib/table";
import React from "react";

import {
  OrderDetails_order,
  OrderDetails_order_fulfillments,
  OrderDetails_order_fulfillments_lines,
} from "../api/types/OrderDetails";
import { checkFbvOrderLineExist } from "../utils";
import { OrderDeliveryCountKeys } from "./OrderDetailFulfillmentListWrap/OrderDetailFulfillmentListWrap";
import { ExtendedOrderDetailsOrderLine } from "./OrderDetailsPage/OrderDetailsPage";

interface OrderDetailsHeaderInfoProps {
  isTotalMode?: boolean;
  isHqStaff: boolean;
  useFulfillmentLines: boolean;
  isBeforeDeliveryMode?: boolean;
  isBeforeDeliveryFulfilledMode?: boolean;
  isB2bOrder?: boolean;
  isB2bProcessingMode?: boolean;
  deliveryMethod: OrderDeliveryMethodsEnum;
  couriers: CourierList_couriers_edges_node[];
  fulfillments?: OrderDetails_order_fulfillments[];
}

export const getFulfillmentQuantityByFulfillmentLine = (record: OrderDetails_order_fulfillments_lines) =>
  record.quantity;

export const getOrderedQuantityByOrderLine = (record: ExtendedOrderDetailsOrderLine) => record.orderedOrFulfillQty;
export const getFulfilledQuantityByOrderLine = (record: ExtendedOrderDetailsOrderLine) => record.quantityFulfilled;
export const getUnFulfilledQuantityByOrderLine = (record: ExtendedOrderDetailsOrderLine) =>
  record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded;

export const getOrderDetailsHeaderInfoColumns = (
  props: OrderDetailsHeaderInfoProps
): ColumnsType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> => {
  const {
    isTotalMode,
    isHqStaff,
    isB2bOrder = false,
    isB2bProcessingMode,
    isBeforeDeliveryMode,
    isBeforeDeliveryFulfilledMode,
    useFulfillmentLines,
    deliveryMethod,
    couriers,
    fulfillments,
  } = props;
  const isFulfillmentsLine = (
    record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines
  ): record is OrderDetails_order_fulfillments_lines => "orderLine" in record;

  const skuColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.product.SKU,
    key: "sku",
    align: "center",
    width: 120,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) =>
      isFulfillmentsLine(record) ? record.orderLine.productSku : record.productSku,
  };

  const bpSkuColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    width: 140,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      // 세트상품 대표 구성품인 경우 세트 상품코드(bpBundle.bpSku) 표시
      if (orderLine.isMainPv === true && orderLine.bpBundle) {
        return orderLine.bpBundle.bpSku;
      }
      return orderLine.brandProductVariant?.bpSku || "-";
    },
  };

  const productNameColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "productName",
    align: "left",
    width: 200,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      const productName = orderLine.productName;

      // 세트상품인 경우 "세트 상품명 - 구성품명" 형식으로 표시
      if (orderLine.bpBundle?.name) {
        const bundleName = orderLine.bpBundle.name; // 세트 상품명
        // 해당 orderLine의 variant와 매칭되는 bpBundleInfo 찾기
        const matchingBundleInfo = orderLine.bpBundle.bpBundleInfos?.find(
          (info) => info?.pv?.id === orderLine.variant?.id
        );
        const componentName = matchingBundleInfo?.name || productName;
        return `${bundleName} - ${componentName}`;
      }

      // 일반 상품인 경우 상품명 그대로 표시
      return productName || "-";
    },
  };

  const variantNameColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    align: "left",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const variantName = isFulfillmentsLine(record) ? record.orderLine.variantName : record.variantName;
      return variantName || "-";
    },
  };

  const attributesColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 150,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const variant = isFulfillmentsLine(record) ? record.orderLine.variant : record.variant;
      const product = variant?.product;
      const hasVariants = product?.productType?.hasVariants;
      const targetAttributes = hasVariants ? variant?.attributes : product?.attributes;
      return makeProductSpecTextFromAttr(targetAttributes) || "-";
    },
  };

  const attrQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
    key: "attrQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const variant = isFulfillmentsLine(record) ? record.orderLine.variant : record.variant;
      return makeProductQtyPerBoxText(variant);
    },
  };

  const fulfillmentTypeColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.order.FULFILLMENT_TYPE,
    key: "fulfillmentType",
    align: "center",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      return makeTagFulfillmentType(
        orderLine.trackInventory,
        orderLine.isFulfilledByVendor,
        isHqStaff,
        orderLine.isMixedTrackInventory,
        orderLine.variant.isVendorTrackInventory
      );
    },
  };

  const vendorColumn: ColumnType<OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.vendor.VENDOR_NAME,
    key: "vendorName",
    align: "center",
    width: 80,
    render: (_: any, record: OrderDetails_order_fulfillments_lines) =>
      record.vendor ? `${record.vendor.code}: ${record.vendor.name}` : "협력사 알 수 없음",
  };

  const deliveryRequestDateColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.delivery.DELIVERY_REQUEST_DATE,
    key: "deliveryRequestDate",
    align: "center",
    width: 120,
    render: (_, record) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      return <DateTime date={orderLine.deliveryRequestDate} onlyDate />;
    },
  };

  const isTaxFreeColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.product.IS_TAX_FREE,
    key: "isTaxFree",
    align: "center",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      return transformTaxFree(orderLine.isTaxFree);
    },
  };

  const isFulfilledByVendorColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: "직거래 여부",
    key: "isFulfilledByVendor",
    align: "center",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      return makeTagIsFBV(orderLine.isFulfilledByVendor, isHqStaff);
    },
  };

  const unitPriceAmountExcludeVatColumn: ColumnType<
    ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines
  > = {
    title: isHqStaff ? <MultiLineTypography lines={["판매가", "(ⓐ)"]} /> : "판매가",
    key: "unitPriceAmountExcludeVat",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (orderLine.isMainPv === false) {
        return "-";
      }
      return <NumberComponent value={orderLine.unitPriceGrossAmount - orderLine.unitPriceVat} />;
    },
  };

  const unitPriceAmountVatColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: isHqStaff ? <MultiLineTypography lines={["부가세", "(ⓑ)"]} /> : "부가세",
    key: "unitPriceAmountVat",
    align: "right",
    width: 70,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (orderLine.isMainPv === false) {
        return "-";
      }
      return <NumberComponent value={orderLine.unitPriceVat} />;
    },
  };

  const unitPriceAmountIncludeVatColumn: ColumnType<
    ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines
  > = {
    title: isB2bOrder === false && isHqStaff ? <MultiLineTypography lines={["총 판매가", "(ⓐ+ⓑ=ⓒ)"]} /> : "판매가",
    key: "unitPriceAmountIncludeVat",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (orderLine.isMainPv === false) {
        return "-";
      }
      return <NumberComponent value={orderLine.unitPriceGrossAmount} />;
    },
  };

  const orderLineQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: "원 주문수량",
    key: "orderLineQuantity",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines) => {
      const orderLine = isFulfillmentsLine(record) ? record.orderLine : record;
      return orderLine.quantity;
    },
  };

  // Fulfillment line columns
  const fulfillmentOrderQuantityColumn: ColumnType<OrderDetails_order_fulfillments_lines> = {
    title: isHqStaff ? <MultiLineTypography lines={["주문 수량", "(ⓓ)"]} /> : "주문 수량",
    key: "orderQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: OrderDetails_order_fulfillments_lines) => (
      <NumberComponent value={record.orderLine.quantity} />
    ),
  };

  const fulfillmentFulfillQuantityColumn: ColumnType<OrderDetails_order_fulfillments_lines> = {
    title: isHqStaff ? <MultiLineTypography lines={["출고 수량", "(ⓔ)"]} /> : "출고 수량",
    key: "fulfillQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: OrderDetails_order_fulfillments_lines) => getFulfillmentQuantityByFulfillmentLine(record),
  };

  const fulfillmentTotalAmountByFulfillmentLineColumn: ColumnType<OrderDetails_order_fulfillments_lines> = {
    title: isHqStaff ? <MultiLineTypography lines={["상품 금액", "(ⓒ×ⓓ)"]} /> : "상품 금액",
    key: "fulfillmentTotalAmount",
    align: "right",
    width: 100,
    render: (_: any, record: OrderDetails_order_fulfillments_lines) => {
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (record.orderLine.isMainPv === false) {
        return "-";
      }
      // 세트상품인 경우 bundleQty 사용, 아닌 경우 fulfillment quantity 사용
      const quantity =
        record.orderLine.bundleQty !== null
          ? record.orderLine.bundleQty
          : getFulfillmentQuantityByFulfillmentLine(record);
      const unitPrice = record.orderLine.unitPriceGrossAmount;
      return <NumberComponent value={quantity * unitPrice} />;
    },
  };

  const b2bDeliveryFeeExcludeVatByOrderLineColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: columnNameConstant.orderLine.B2B_DELIVERY_FEE_SALE,
    key: "b2bDeliveryFeeExcludeVat",
    align: "right",
    width: 120,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => getNumberFormat(record.b2bDeliveryFeeExcludeVat),
  };
  // Order line columns - Ordered
  const orderedOrderQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["주문 수량", "(ⓓ)"]} /> : "주문 수량",
    key: "orderQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => <NumberComponent value={record.quantity} />,
  };

  const orderedFulfillQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["출고 수량", "(ⓔ)"]} /> : "출고 수량",
    key: "fulfillQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => <NumberComponent value={record.orderedOrFulfillQty} />,
  };

  const orderedTotalAmountByOrderLineColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["상품 금액", "(ⓒ×ⓓ)"]} /> : "상품 금액",
    key: "orderedTotalAmount",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => {
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (record.isMainPv === false) {
        return "-";
      }
      // 세트상품인 경우 bundleQty 사용, 아닌 경우 orderedOrFulfillQty 사용
      const quantity = record.bundleQty !== null ? record.bundleQty : getOrderedQuantityByOrderLine(record);
      const unitPrice = record.unitPriceGrossAmount;
      return <NumberComponent value={quantity * unitPrice} />;
    },
  };

  // Order line columns - Fulfilled
  const fulfilledOrderQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["주문 수량", "(ⓓ)"]} /> : "주문 수량",
    key: "orderQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => <NumberComponent value={record.quantity} />,
  };

  const fulfilledTotalAmountByOrderLineColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["상품 금액", "(ⓒ×ⓓ)"]} /> : "상품 금액",
    key: "fulfilledTotalAmount",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => {
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (record.isMainPv === false) {
        return "-";
      }
      // 세트상품인 경우 bundleQty 사용, 아닌 경우 quantityFulfilled 사용
      const quantity = record.bundleQty !== null ? record.bundleQty : getFulfilledQuantityByOrderLine(record);
      const unitPrice = record.unitPriceGrossAmount;
      return <NumberComponent value={quantity * unitPrice} />;
    },
  };

  const unfulfillmentOrderQuantityColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["주문 수량", "(ⓓ)"]} /> : "주문 수량",
    key: "orderQuantity",
    align: "right",
    width: 80,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => <NumberComponent value={record.quantity} />,
  };

  const unfulfillmentTotalAmountByOrderLineColumn: ColumnType<ExtendedOrderDetailsOrderLine> = {
    title: isHqStaff ? <MultiLineTypography lines={["상품 금액", "(ⓒ×ⓓ)"]} /> : "상품 금액",
    key: "unfulfillmentTotalAmount",
    align: "right",
    width: 100,
    render: (_: any, record: ExtendedOrderDetailsOrderLine) => {
      // 세트상품의 대표 구성품이 아닌 경우 하이픈 표시
      if (record.isMainPv === false) {
        return "-";
      }
      // 세트상품인 경우 bundleQty 사용, 아닌 경우 unfulfilled quantity 사용
      const quantity = record.bundleQty !== null ? record.bundleQty : getUnFulfilledQuantityByOrderLine(record);
      const unitPrice = record.unitPriceGrossAmount;
      return <NumberComponent value={quantity * unitPrice} />;
    },
  };

  const makeB2bStatusColumn: ColumnType<ExtendedOrderDetailsOrderLine | OrderDetails_order_fulfillments_lines> = {
    title: columnNameConstant.orderLine.ORDER_PROGRESS_STATUS,
    align: "center",
    key: "b2bStatus",
    width: 100,
    render: (_, record) => {
      if ("b2bStatus" in record && isB2bOrder) {
        const getFulfillment = fulfillments.find((fulfillment) => fulfillment.lines[0].orderLine.id === record.id);
        return (
          <Space direction="vertical" size="small">
            {getStatusLabel(record.b2bStatus)}
            {getFulfillment?.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER && (
              <Tag
                color="blue"
                onClick={() => openTrackingWindow(getFulfillment.trackingNumber, getFulfillment.courier.id, couriers)}
                style={{ cursor: "pointer" }}
              >
                조회하기
              </Tag>
            )}
          </Space>
        );
      }
      return "-";
    },
  };

  let columns: ColumnsType = [];
  if (isB2bOrder) {
    columns = [
      isHqStaff === false && skuColumn,
      bpSkuColumn,
      productNameColumn,
      variantNameColumn,
      attributesColumn,
      attrQuantityColumn,
      makeB2bStatusColumn,
      isTaxFreeColumn,
      unitPriceAmountIncludeVatColumn,
      isTotalMode && deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER && orderLineQuantityColumn,
      // B2B 전체, 접수, 취소 상태 탭에서는 주문한 quantity를 사용
      // B2B 처리중 탭에서는 quantityFulfilled를 사용
      isB2bProcessingMode ? fulfilledOrderQuantityColumn : orderedOrderQuantityColumn,
      orderedFulfillQuantityColumn,
      isB2bProcessingMode ? fulfilledTotalAmountByOrderLineColumn : orderedTotalAmountByOrderLineColumn,
      b2bDeliveryFeeExcludeVatByOrderLineColumn,
    ];
  } else {
    columns = [
      isHqStaff === false && skuColumn,
      bpSkuColumn,
      productNameColumn,
      variantNameColumn,
      attributesColumn,
      attrQuantityColumn,
      isHqStaff === false && fulfillmentTypeColumn,
      // 배송 중, 배송 완료, 반품 상태 탭에서 사용 (fulfillmentLines)
      useFulfillmentLines && isHqStaff === false && vendorColumn,
      isHqStaff === false && deliveryRequestDateColumn,
      isTaxFreeColumn,
      isHqStaff && isFulfilledByVendorColumn,
      isHqStaff && unitPriceAmountExcludeVatColumn,
      isHqStaff && unitPriceAmountVatColumn,
      unitPriceAmountIncludeVatColumn,
      isTotalMode && deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER && orderLineQuantityColumn,
      // 배송 중, 배송 완료, 반품 상태 탭에서 사용 (fulfillmentLines)
      useFulfillmentLines && fulfillmentOrderQuantityColumn,
      useFulfillmentLines && fulfillmentFulfillQuantityColumn,
      useFulfillmentLines && fulfillmentTotalAmountByFulfillmentLineColumn,
      // 전체, 취소 상태 탭에서 사용되는 컬럼 (orderLines)
      isBeforeDeliveryMode === false && useFulfillmentLines === false && orderedOrderQuantityColumn,
      isBeforeDeliveryMode === false && useFulfillmentLines === false && orderedFulfillQuantityColumn,
      isBeforeDeliveryMode === false && useFulfillmentLines === false && orderedTotalAmountByOrderLineColumn,
      // 미배송탭 -> 배송 준비중 상태에서 사용되는 컬럼 (orderLines)
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === true && fulfilledOrderQuantityColumn,
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === true && orderedFulfillQuantityColumn,
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === true && fulfilledTotalAmountByOrderLineColumn,
      // 미배송탭 -> 배송 대기 상태에서 사용되는 컬럼 (orderLines)
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === false && unfulfillmentOrderQuantityColumn,
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === false && orderedFulfillQuantityColumn,
      isBeforeDeliveryMode && isBeforeDeliveryFulfilledMode === false && unfulfillmentTotalAmountByOrderLineColumn,
    ];
  }

  return columns.filter(Boolean);
};

interface OrderDetailsUnfulfilledItemsProps {
  order: OrderDetails_order;
  orderLines: ExtendedOrderDetailsOrderLine[];
  isHqStaff: boolean;
  currentKey: OrderDeliveryCountKeys;
  isDeliveryPending?: boolean;
  isB2bOrder?: boolean;
  couriers?: CourierList_couriers_edges_node[];
  fulfillments?: OrderDetails_order_fulfillments[];
}

export const OrderDetailsUnfulfilledItems: React.FC<OrderDetailsUnfulfilledItemsProps> = (props) => {
  const {
    order,
    orderLines,
    isHqStaff,
    currentKey,
    isDeliveryPending = false,
    isB2bOrder = false,
    couriers = [],
    fulfillments,
  } = props;
  const isTotalMode = [
    OrderDeliveryCountKeys.BossTotal,
    OrderDeliveryCountKeys.FbvTotal,
    OrderDeliveryCountKeys.B2bTotal,
  ].includes(currentKey);

  const isCanceledMode = [
    OrderDeliveryCountKeys.BossCanceled,
    OrderDeliveryCountKeys.FbvCanceled,
    OrderDeliveryCountKeys.B2bCanceled,
  ].includes(currentKey);

  const isB2bProcessingMode = [OrderDeliveryCountKeys.B2bTrackingProcessing].includes(currentKey);
  const isB2bReceivedMode = [OrderDeliveryCountKeys.B2bReceived].includes(currentKey);
  const isBeforeDeliveryMode = [OrderDeliveryCountKeys.BossBeforeDelivery].includes(currentKey);
  const deliveryMethod = order?.deliveryMethod;

  const unfulfilledQuantityByOrderLine = orderLines
    .map((line) => line.orderedOrFulfillQty - line.quantityFulfilled - line.quantityRefunded)
    .reduce((prev, curr) => utils.convertToNumberWrapper(prev + curr, 1), 0);
  const fulfilledQuantityByOrderLine = orderLines
    .map((line) => line.quantityFulfilled)
    .reduce((prev, curr) => utils.convertToNumberWrapper(prev + curr, 1), 0);
  const totalQuantity = isB2bOrder
    ? orderLines.length
    : orderLines.reduce((prev, curr) => utils.convertToNumberWrapper(prev + curr.orderedOrFulfillQty, 1), 0);
  const titleStatus = isTotalMode ? "success" : isCanceledMode ? "error" : "neutral";
  const titleLabel = isTotalMode
    ? `전체상품 수량: ${totalQuantity}`
    : isCanceledMode
    ? `취소 수량: ${totalQuantity}`
    : isDeliveryPending
    ? `배송준비중 수량: ${fulfilledQuantityByOrderLine}`
    : isB2bProcessingMode
    ? `처리 수량: ${totalQuantity}`
    : isB2bReceivedMode
    ? `접수 수량: ${totalQuantity}`
    : `배송대기 수량: ${unfulfilledQuantityByOrderLine}`;
  const isBeforeDeliveryFulfilledMode = orderLines && orderLines.length > 0 && orderLines[0].isFulfilled;
  const columns = getOrderDetailsHeaderInfoColumns({
    isTotalMode,
    isHqStaff,
    isB2bOrder,
    isB2bProcessingMode,
    isBeforeDeliveryMode,
    isBeforeDeliveryFulfilledMode,
    useFulfillmentLines: false,
    deliveryMethod,
    couriers,
    fulfillments,
  });

  const existFulfilledByVendorOrder = checkFbvOrderLineExist(orderLines);
  const title = !!orderLines ? (
    <StatusLabel
      useSmallDot
      label={
        <Space direction="horizontal" size={"small"}>
          <Typography.Title level={5}>{titleLabel}</Typography.Title>
          {existFulfilledByVendorOrder && (
            <Tag color={FulfillmentTypeColor.isFBV}>{transformIsFBV(true)} 상품 포함</Tag>
          )}
        </Space>
      }
      status={titleStatus}
    />
  ) : (
    <Skeleton />
  );

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Card type="inner" title={title} bodyStyle={{ padding: 0 }}>
      <TableVatLegend isIncludeVat={isHqStaff ? false : true} size="small" />
      <Table
        {...commonTableProps}
        columns={columns}
        dataSource={orderLines}
        scroll={{ x: tableWidthSum, y: 500 }}
        sticky={false}
      />
    </Card>
  );
};
</file>

