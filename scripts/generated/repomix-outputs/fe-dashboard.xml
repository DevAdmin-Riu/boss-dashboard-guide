<file path="src/app/views/notice/banners/components/BannerRangePicker/BannerRangePicker.tsx">
import { FormChange } from "@hooks/useForm";
import { onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { Checkbox, DatePicker, Space } from "antd";
import moment, { Moment } from "moment";
import React, { useState } from "react";

import { BannerCreatePageFormData } from "../BannerCreatePage";
import { BannerDetailsPageFormData } from "../BannerDetailsPage";

export interface BannerRangePickerProps {
  data: BannerCreatePageFormData | BannerDetailsPageFormData;
  formErrors: any;
  onChange: FormChange;
}

const { RangePicker } = DatePicker;

const BannerRangePicker = (props: BannerRangePickerProps) => {
  const { data, formErrors, onChange } = props;
  const defaultStartDate = moment(data.start, onlyDateFormat);
  const defaultEndDate = moment(data.end, onlyDateFormat);
  const bannerEndExist = defaultEndDate.diff(defaultStartDate, "years") <= 100; // 현재 게시일과 마감일의 연도 차이가 100년을 넘으면 마감일 미설정으로 취급

  const [bannerEndChecked, setBannerEndChecked] = useState(bannerEndExist);
  const [startDate, setStartDate] = useState(defaultStartDate);
  const [endDate, setEndDate] = useState(defaultEndDate);

  const onRangeChange = (values: Array<Moment | null>, valuesString: String[]) => {
    setStartDate(values ? values[0] : null);
    setEndDate(values ? values[1] : null);
    onChange({
      target: { name: "start", value: valuesString[0] },
    });
    onChange({
      target: { name: "end", value: valuesString[1] },
    });
  };

  const onDateChange = (value: Moment | null, valueString: String) => {
    setStartDate(value);
    onChange({
      target: { name: "start", value: valueString },
    });
  };

  const bannerEndByCheck = (bannerEndChecked: boolean) => {
    setEndDate(null);

    return bannerEndChecked
      ? onChange({ target: { name: "end", value: "2500-12-31" } }) // 마감일 미설정 체크하면 마감일을 자동으로 2500-12-31로 설정
      : onChange({ target: { name: "end", value: "" } });
  };

  return (
    <Space direction="vertical" size={0}>
      <Checkbox
        name="selectBannerEnd"
        checked={bannerEndChecked}
        onChange={() => {
          setBannerEndChecked(!bannerEndChecked);
          bannerEndByCheck(bannerEndChecked);
        }}
      >
        배너 게시 마감일 설정
      </Checkbox>
      {bannerEndChecked ? (
        <RangePicker
          size="large"
          style={{ width: "100%" }}
          status={!formErrors.start && !formErrors.end ? null : "error"}
          format={onlyDateFormat}
          allowEmpty={[false, false]}
          value={[startDate, endDate]}
          onChange={onRangeChange}
        />
      ) : (
        <DatePicker
          size="large"
          style={{ width: "100%" }}
          placeholder={"시작일"}
          status={!formErrors.start ? null : "error"}
          format={onlyDateFormat}
          value={startDate}
          onChange={onDateChange}
        />
      )}
    </Space>
  );
};
export default BannerRangePicker;
</file>

