interface PurchaseOrderLineListPageProps
  extends PaginateListProps,
    FilterPageProps<PurchaseOrderLineFilterKeys, PurchaseOrderLineListFilterOpts>,
    SortPage<PurchaseOrderLineListViewUrlSortField> {
  params: PurchaseOrderLineListViewUrlQueryParams;
  purchaseOrderLines: PurchaseOrderLineList_purchaseOrderLines_edges_node[];
  openModal: (action: PurchaseOrderLineListViewUrlDialog, newParams?: PurchaseOrderLineListViewUrlQueryParams) => void;
  closeModal: () => void;
  onProductStockUpdateWithNavigate: (productId: string, variantId?: string) => void;
  queryVariablesWithoutPagination: PurchaseOrderLineListVariables;
  fetchForDownload: (variables?: PurchaseOrderLineListVariables) => Promise<ApolloQueryResult<PurchaseOrderLineList>>;
  navigate: UseNavigatorResult;
  onLineUpdate: (props: PurchaseOrderLineUpdateProps) => Promise<boolean>;
  onLineDelete: (variables: PurchaseOrderLineDeleteVariables) => Promise<void>;
  onLinesCancel: (variables: PurchaseOrderLinesCancelVariables) => void;
  onLinesSend: (variables: PurchaseOrderLinesSendVariables) => void;
  onInvoicePrint: () => void;
  onDeliveryConfirmed: () => void;
  onOrderNumberClick: (id: string) => void;
  onDelivered: () => Promise<void>;
  selectedRowIds: React.Key[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<React.Key[]>>;
  onAddTakeBack: (id: any) => void;
  ListNavigator: () => React.ReactNode;
  isB2b: boolean;
}

const PurchaseOrderLineListPage: React.FC<PurchaseOrderLineListPageProps> = ({
  params,
  purchaseOrderLines,
  currencySymbol,
  currentTab,
  filterOpts,
  tabs,
  sort,
  onSort,
  onAll,
  onRowClick,
  onFilterChange,
  onTabChange,
  onTabDelete,
  onTabSave,
  openModal,
  closeModal,
  queryVariablesWithoutPagination,
  fetchForDownload,
  navigate,
  onLineDelete,
  onLineUpdate,
  onLinesCancel,
  onLinesSend,
  onInvoicePrint,
  onDeliveryConfirmed,
  onDelivered,
  onOrderNumberClick,
  selectedRowIds,
  setSelectedRowIds,
  onAddTakeBack,
  ListNavigator,
  isB2b,
  ...listProps
}) => {
  const { user } = useUser();
  const { courierDeliveryAdditionalFeeList } = useShop();
  const routeParams = useParams<PurchaseOrderLineListViewRouteParams>();
  const filterStructure = createFilterStructure(filterOpts, routeParams, isB2b);
  const sorterStructure = createSorterStructure();
  const [selectedPurchaseOrderLineId, setSelectedPurchaseOrderLineId] = useState<string>("");
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const [form] = Form.useForm();

  const notSelected = selectedRowIds.length === 0;
  const selectedPoLines = purchaseOrderLines.filter((poLine) => selectedRowIds.includes(poLine.id));

  const formValuesWatched: PurchaseOrderLineUpdateInput = {
    askingPurchaseDate: Form.useWatch("askingPurchaseDate", form),
    quantity: Form.useWatch("quantity", form),
    devCostExcludeVat: Form.useWatch("devCostExcludeVat", form),
    etcExcludeVat: Form.useWatch("etcExcludeVat", form),
    b2bDeliveryFeeExcludeVat: Form.useWatch("b2bDeliveryFeeExcludeVat", form),
  };

  const resetFormField = () => {
    form.resetFields();
    setSelectedPurchaseOrderLineId(undefined);
    setSelectedRowIds([]);
  };

  const setEditableRow = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => {
    form.setFields([
      { name: "askingPurchaseDate", value: moment(record.askingPurchaseDate) },
      { name: "quantity", value: record.quantity },
      { name: "devCostExcludeVat", value: record.devCostExcludeVat },
      { name: "etcExcludeVat", value: record.etcExcludeVat },
      { name: "b2bDeliveryFeeExcludeVat", value: record.b2bDeliveryFeeExcludeVat },
    ]);
    setSelectedPurchaseOrderLineId(record.id);
  };
  const isEditing = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) =>
    record.id === selectedPurchaseOrderLineId;
  const onEdit = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => setEditableRow(record);
  const onCancel = () => resetFormField();
  const onSubmit = async (purchaseOrder: PurchaseOrderLineList_purchaseOrderLines_edges_node_purchaseOrder) => {
    const input = form.getFieldsValue();
    const formattedAskingPurchaseDate = moment(input.askingPurchaseDate).format(onlyDateFormat);
    const isB2bTakeBack = isB2b && purchaseOrder.eventType === PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK;
    const res = await onLineUpdate({
      purchaseOrderId: purchaseOrder.id,
      lineId: selectedPurchaseOrderLineId,
      input: {
        askingPurchaseDate: formattedAskingPurchaseDate,
        devCostExcludeVat: input.devCostExcludeVat,
        etcExcludeVat: input.etcExcludeVat,
        quantity: input.quantity,
        b2bDeliveryFeeExcludeVat: isB2bTakeBack ? undefined : input.b2bDeliveryFeeExcludeVat,
      },
      purchaseOrderDate: purchaseOrder.purchaseOrderDate,
    });
    if (res === true) {
      resetFormField();
    }
  };

  const onLineReqSplitDelivery = (id: string): void => {
    openModal("req-split-delivery", { id });
  };

  const onApproveReqSplitDeliveryButtonClick = (id: string): void => {
    openModal("approve-req-split-delivery", { id });
  };

  const onAttachDeliveryConfirmDocButtonClick = (id: string): void => {
    openModal("attach-delivery-confirm-doc", { id });
    setSelectedRowIds([id]);
  };

  const initialQueryVariablesForAddStock = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    defaultOnly: true,
    first: 30,
  };
  const queryVariablesForNormalCase = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
  };

  const queryVariables =
    routeParams.status === PurchaseOrderLineUrlEnum.ADD_STOCK
      ? initialQueryVariablesForAddStock
      : queryVariablesForNormalCase;

  const [variables, setVariables] = useState(queryVariables);

  const {
    loadMore: loadMoreRackLocations,
    search: searchRackLocations,
    result: searchRackLocationsOpts,
  } = useRackLocationSearch({
    skip: routeParams.status !== PurchaseOrderLineUrlEnum.ADD_STOCK,
    variables,
  });

  const onSearchRackLocations = (query: string) => {
    setVariables(queryVariablesForNormalCase);
    searchRackLocations(query);
  };

  const onOpenAddStockLinesModal = () => {
    setVariables(queryVariablesForNormalCase);
    openModal("add-stock-lines");
  };

  const onCloseStockLinesAddModel = () => {
    resetFormField();
    closeModal();
  };

  const [accRackLocations, setAccRackLocations] = useState<any[]>(
    searchRackLocationsOpts?.data?.search?.edges?.map((e) => e.node) ?? []
  );

  useEffect(() => {
    const newItems = searchRackLocationsOpts?.data?.search?.edges?.map((e) => e.node) ?? [];
    if (newItems.length === 0) {
      return;
    }
    setAccRackLocations((prev) => {
      const merged = [...prev, ...newItems];
      const unique = Array.from(new Map(merged.map((item) => [item.id, item])).values());
      unique.sort((a, b) => {
        const sectorAddressCompanyNameCompare = a.sector.address.companyName.localeCompare(
          b.sector.address.companyName
        );
        if (sectorAddressCompanyNameCompare !== 0) {
          return sectorAddressCompanyNameCompare;
        }
        const sectorNameCompare = a.sector.name.localeCompare(b.sector.name);
        if (sectorNameCompare !== 0) {
          return sectorNameCompare;
        }
        return a.name.localeCompare(b.name);
      });
      return unique;
    });
  }, [searchRackLocationsOpts?.data]);

  const fetchMoreRackLocations: FetchMoreProps = {
    hasMore: maybe(() => searchRackLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchRackLocationsOpts?.loading,
    onFetchMore: loadMoreRackLocations,
  };

  useEffect(() => {
    setSelectedRowIds([]);
    form.resetFields();
  }, [purchaseOrderLines]);

  let rowSelection: TableRowSelection<PurchaseOrderLineList_purchaseOrderLines_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
  };

  const poLineListTableSettingProps: PurchaseOrderLineListTableSettingsProps = {
    formValuesWatched,
    selectedRowIds,
    onRowClick,
    stockLinesAddProps: {
      searchedRackLocations: accRackLocations,
      fetchMoreRackLocations,
      searchRackLocations: onSearchRackLocations,
    },
    isEditing,
    onEdit,
    onSubmit,
    onLineDelete,
    onCancel,
    onLinesCancel,
    onLinesSend,
    disabled: listProps.disabled,
    selectedPurchaseOrderLineId,
    routeParams,
    courierDeliveryAdditionalFeeList,
    onOrderNumberClick,
    onLineReqSplitDelivery,
    onApproveReqSplitDeliveryButtonClick,
    onAttachDeliveryConfirmDocButtonClick,
    onAddTakeBack,
    isB2b,
  };
  const columns = getPurchaseOrderLineListTableSettings(poLineListTableSettingProps);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "purchaseOrderLines",
  };

  let pageTitle: string = "";
  let pageSubTitle: React.ReactNode = null;
  let extraUi: React.ReactNode = null;
  let initialValues: any = null;
  let showRowSelection: boolean = true;
  const allSendText = "일괄 발송";
  const allApproveText = "일괄 승인";
  const allCancelText = "일괄 취소";

  const bulkBtnDisabled = selectedRowIds.length === 0 || listProps.disabled;

  const isTrackInventoryList = routeParams.inventoryType === "track-inventory";
  const isConsignmentList = routeParams.inventoryType === "consignment";
  switch (routeParams.status) {
    case PurchaseOrderLineUrlEnum.DRAFT:
      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.draftA;
        extraUi = (
          <Space>
            <Button
              type="primary"
              shape="round"
              onClick={() => {
                navigate(purchaseOrderCreateViewUrl({ createType: "track-inventory" }));
              }}
            >
              발주서 등록
            </Button>
          </Space>
        );
      } else if (isConsignmentList) {
        pageTitle = sectionNames.purchaseOrderLine.draftB;
      }
      showRowSelection = false;
      break;
    case PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED:
      pageTitle = sectionNames.purchaseOrderLine.pendingOrRejected;
      extraUi = (
        <Space>
          <Button type="primary" shape="round" onClick={() => openModal("send-lines")} disabled={bulkBtnDisabled}>
            {allSendText}
          </Button>
          <Button
            type="primary"
            shape="round"
            danger
            onClick={() => openModal("cancel-lines")}
            disabled={bulkBtnDisabled}
          >
            {allCancelText}
          </Button>
        </Space>
      );
      rowSelection = {
        ...rowSelection,
        getCheckboxProps: (record) => ({
          disabled: !isExistPurchaseOrderLineStatusIn(record.status, [PurchaseOrderLineStatus.REJECTED]),
        }),
      };
      break;
    case PurchaseOrderLineUrlEnum.RECEIVE:
      pageTitle = sectionNames.purchaseOrderLine.receive;
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            danger
            onClick={() => openModal("reject-lines")}
            disabled={bulkBtnDisabled}
          >
            접수 거부
          </Button>
          <Button type="primary" shape="round" onClick={() => openModal("receive-lines")} disabled={bulkBtnDisabled}>
            발주 접수
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.IN_PRODUCTION:
      pageTitle = sectionNames.purchaseOrderLine.inProduction;
      showRowSelection = false;
      break;
    case PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT:
      pageTitle = sectionNames.purchaseOrderLine.delegatedDispatchFulfillment;
      extraUi = (
        <Space>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={() => openModal("req-epd-update")}>
            납품예정일 변경 요청
          </Button>
          <Button
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("dispatch-fulfillment")}
          >
            출고 지시
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            출고 거부
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE:
      pageTitle = sectionNames.purchaseOrderLine.reqEpdUpdate;
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            onClick={() => openModal("approve-req-epd-update")}
            disabled={bulkBtnDisabled}
          >
            {allApproveText}
          </Button>
          <Button
            type="primary"
            shape="round"
            danger
            onClick={() => openModal("cancel-lines")}
            disabled={bulkBtnDisabled}
          >
            {allCancelText}
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY:
      pageTitle = sectionNames.purchaseOrderLine.reqSplitDelivery;
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            danger
            onClick={() => openModal("cancel-lines")}
            disabled={bulkBtnDisabled}
          >
            {allCancelText}
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.PRINT_INVOICE:
      pageTitle = sectionNames.purchaseOrderLine.printInvoice;
      extraUi = (
        <Space>
          <Button
            type="primary"
            shape="round"
            icon={<DownloadOutlined />}
            disabled={bulkBtnDisabled}
            onClick={onInvoicePrint}
          >
            거래명세서 출력
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            배송 취소
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.INSPECT:
      if (isTrackInventoryList) {
        pageTitle = sectionNames.purchaseOrderLine.inspect;
        extraUi = (
          <Space>
            <Button
              type="primary"
              shape="round"
              disabled={bulkBtnDisabled}
              onClick={() => {
                // 선택된 항목이 있으면 해당 ID들을 전달
                // 선택된 항목이 없으면 전체 TO_BE_INSPECTED 항목 보기
                navigate(
                  purchaseOrderLineInspectViewUrl({
                    poLineIds: selectedRowIds.length > 0 ? (selectedRowIds as string[]) : undefined,
                  })
                );
              }}
            >
              입고 검수
            </Button>
            <Button
              danger
              type="primary"
              shape="round"
              disabled={bulkBtnDisabled}
              onClick={() => openModal("revert-lines")}
            >
              거래명세서 취소
            </Button>
          </Space>
        );
      }
      break;
    case PurchaseOrderLineUrlEnum.ADD_STOCK:
      if (isTrackInventoryList) {
        initialValues = {
          stockedDate: moment(),
          lines:
            purchaseOrderLines?.map((line) => {
              let initialRackLocation: string | null = null;
              let initialRackLocationName: string | null = null;
              if (searchRackLocationsOpts?.loading === false && accRackLocations.length > 0) {
                const purchaseOrderEventType = line.purchaseOrder.eventType;
                if (checkInitialOrderPurchaseOrder(purchaseOrderEventType)) {
                  const rackLocationForInitialOrder = accRackLocations.find(
                    (location) =>
                      location.isInitialOrderDefault &&
                      line.purchaseOrder.warehouseAddress.id === location.sector.address.id
                  );
                  initialRackLocation = rackLocationForInitialOrder?.id;
                  initialRackLocationName = rackLocationForInitialOrder?.name;
                } else if (checkReorderPurchaseOrder(purchaseOrderEventType)) {
                  const rackLocationForReorder = accRackLocations.find(
                    (location) =>
                      location.isReorderDefault && line.purchaseOrder.warehouseAddress.id === location.sector.address.id
                  );
                  initialRackLocation = rackLocationForReorder?.id;
                  initialRackLocationName = rackLocationForReorder?.name;
                }
              }

              return {
                lineId: line.id,
                quantity: line.purchaseQuantity,
                rackLocation: initialRackLocation,
                rackLocationName: initialRackLocationName,
              };
            }) || [],
        } as PurchaseOrderStockLinesAddForm;

        const disabledStockedDate = (current: Moment) => {
          if (!current) {
            return true;
          }
          const selectedLines = purchaseOrderLines?.filter((data) => selectedRowIds?.includes(data?.id));
          const purchaseOrderDateArr = selectedLines?.map((line) => moment(line?.purchaseOrder?.purchaseOrderDate));
          const latestPurchaseOrderDate = moment.max(purchaseOrderDateArr);
          if (current.isBefore(latestPurchaseOrderDate)) {
            return true;
          }
          return false;
        };

        pageTitle = sectionNames.purchaseOrderLine.addStock;
        pageSubTitle = (
          <Typography.Text type="warning" strong>
            입고는 같은 입고일 단위로 선택해서 처리 해야 합니다.
          </Typography.Text>
        );
        extraUi = (
          <Row justify="end" align="middle" gutter={[12, 12]}>
            <Col>
              <Typography.Text type="warning" strong>
                선택한 제품 중 발주일이 가장 늦은 제품 기준으로 입고일을 선택 가능합니다.
              </Typography.Text>
            </Col>
            <Col>
              <Form.Item noStyle name="stockedDate">
                <DatePicker
                  allowClear={false}
                  style={{ width: 200 }}
                  disabled={notSelected}
                  format={onlyDateFormat}
                  disabledDate={disabledStockedDate}
                  placeholder="입고 처리 날짜 선택"
                />
              </Form.Item>
            </Col>
            <Col>
              <Space>
                <Button type="primary" shape="round" disabled={notSelected} onClick={onOpenAddStockLinesModal}>
                  입고 완료
                </Button>
                <Button
                  danger
                  type="primary"
                  shape="round"
                  disabled={bulkBtnDisabled}
                  onClick={() => openModal("revert-lines")}
                >
                  검수 취소
                </Button>
              </Space>
            </Col>
          </Row>
        );
      }
      break;
    case PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY:
      pageTitle = sectionNames.purchaseOrderLine.delegatedConfirmDeliveryByCourier;
      extraUi = (
        <Space>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={() => onDeliveryConfirmed()}>
            배송 확정
          </Button>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("revert-lines")}
          >
            출고 취소
          </Button>
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY:
      pageTitle = sectionNames.purchaseOrderLine.completeDelivery;
      const groupedPoLinesForInvoiceDownload = makeGroupedPoLinesForPoInvoiceDownload({
        poLines: selectedPoLines,
        user,
        trackInventory: isTrackInventoryList,
      });
      // B2B 거래명세서는 거래명세서 1개씩만 발송 가능(선택된 발주 품목의 협력사, 고객사 및 납품장소가 다르면 2개 이상의 거래명세서가 생성됨)
      const invoiceSentEmailAvailable =
        Object.keys(groupedPoLinesForInvoiceDownload).length === 1 &&
        Object.values(groupedPoLinesForInvoiceDownload).every((v) => !Array.isArray(v) && Object.keys(v).length === 1);
      const deliveredRowSelected = selectedPoLines.some((poLine) =>
        isExistPurchaseOrderLineStatusIn(poLine.status, [PurchaseOrderLineStatus.DELIVERED])
      );

      const invoiceSentEmailTooltipTitle =
        !bulkBtnDisabled &&
        !invoiceSentEmailAvailable &&
        "거래명세서 추가 발송은 한 번에 하나의 고객사에게만 발송할 수 있습니다. 선택한 품목의 주문번호 및 고객사를 다시 확인해주세요.";
      const deliveredTooltipTitle =
        !bulkBtnDisabled &&
        deliveredRowSelected &&
        `${getPurchaseOrderLineStatusText(PurchaseOrderLineStatus.DELIVERED)} 상태인 품목이 선택되어 있습니다.`;

      extraUi = (
        <Space>
          {isB2b && (
            <Tooltip placement="topRight" title={invoiceSentEmailTooltipTitle}>
              <Button
                icon={<MailOutlined />}
                shape="round"
                disabled={bulkBtnDisabled || !invoiceSentEmailAvailable}
                onClick={() => openModal("create-invoice-sent-email")}
              >
                거래명세서 발송
              </Button>
            </Tooltip>
          )}
          <Tooltip placement="topRight" title={deliveredTooltipTitle}>
            <Button
              type="primary"
              shape="round"
              disabled={bulkBtnDisabled || deliveredRowSelected}
              onClick={() => onDelivered()}
            >
              대행 배송 완료
            </Button>
          </Tooltip>
          {isConsignmentList && (
            <Tooltip placement="topRight" title={deliveredTooltipTitle}>
              <Button
                danger
                type="primary"
                shape="round"
                disabled={bulkBtnDisabled || deliveredRowSelected}
                onClick={() => openModal("revert-lines")}
              >
                거래명세서 취소
              </Button>
            </Tooltip>
          )}
        </Space>
      );
      break;
    case PurchaseOrderLineUrlEnum.ALL:
      pageTitle = sectionNames.purchaseOrderLine.allStatus;
      showRowSelection = false;
      break;
  }

  return (
    <Form form={form} name="purchase-order-lines-form" initialValues={initialValues}>
      <Space direction="vertical" size={24}>
        <Row justify="space-between" align="middle">
          <Col>{ListNavigator()}</Col>
        </Row>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{pageTitle}</Typography.Title>
            {pageSubTitle}
          </Col>
          <Col>{extraUi}</Col>
        </Row>

        <Card>
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <>
                <ColumnPicker
                  columns={pickColumns}
                  loading={listProps.disabled}
                  initialColumns={initialColumns}
                  total={pickColumns?.length}
                  onSave={handleSave}
                />
                <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
              </>
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            rowSelection={showRowSelection && rowSelection}
            dataSource={purchaseOrderLines}
            columns={pickerSelectedColumns}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
            components={{ body: { cell: EditableCell } }}
          />
        </Card>
      </Space>

      <PurchaseOrderStockLinesAddModal
        form={form}
        open={params.action === "add-stock-lines"}
        purchaseOrderStockLines={purchaseOrderLines?.filter((data) => selectedRowIds?.includes(data?.id))}
        poLineListTableSettingProps={poLineListTableSettingProps}
        onClose={onCloseStockLinesAddModel}
      />
    </Form>
  );
};
export default PurchaseOrderLineListPage;
</file>

