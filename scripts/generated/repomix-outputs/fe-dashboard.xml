          openModalWithoutNavigate(ProductListModalModeEnum.BulkUpdateOrCreateProductVariant)
        }
        onProductListDownload={() => openModalWithoutNavigate(ProductListModalModeEnum.DownloadProductList)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(isStaff ? fbvProductUpdateViewUrl(id) : hqFbvProductUpdateViewUrl(id))}
        onAll={resetFilters}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        sort={{ asc: params.asc, sort: params.sort }}
        onSort={handleSort}
      />
      <ProductVariantBulkUpdateOrCreateModal
        open={modalMode === ProductListModalModeEnum.BulkUpdateOrCreateProductVariant}
        loading={loading}
