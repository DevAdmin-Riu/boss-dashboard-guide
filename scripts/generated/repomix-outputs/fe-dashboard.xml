      onCell: (record) => ({
        inputType: "number",
        formItemName: "etcExcludeVat",
        editing: isEditing(record),
      }),
    },
    isConsignmentTakeBackType &&
      isB2bTackBack === false && {
        title: columnNameConstant.purchaseOrder.REFUNDED_DELIVERY_FEE,
        key: "takeBackTotalCostDeliveryFeeExcludeVat",
        align: "right",
        width: 100,
        render: (_, record) => {
          const totalTakeBackUnitCostDeliveryFeeExcludeVat = calcPoLineTakeBackTotalCostDeliveryFeeExcludeVat({
            record,
            isConsignment: true,
            poEventType,
          });
          return <NumberComponent value={totalTakeBackUnitCostDeliveryFeeExcludeVat} />;
        },
        renderExcel: (record) =>
          calcPoLineTakeBackTotalCostDeliveryFeeExcludeVat({ record, isConsignment: true, poEventType }),
      },
    {
      title: isB2bTackBack
        ? columnNameConstant.purchaseOrder.REFUNDED_PRODUCT_TOTAL_AMOUNT
        : columnNameConstant.purchaseOrder.PO_TOTAL_AMOUNT,
      key: "poLineTotalPriceExcludeVat",
      align: "right",
      width: 140,
      render: (_, record) => {
        if (isEditing && isEditing(record)) {
          const formTotalPriceExcludeVat = calcPoLineTotalPriceExcludeVat(
            {
              record: { ...record, ...formValuesWatched },
              courierDeliveryAdditionalFeeList,
              isConsignment: isConsignmentType,
              poEventType,
              isB2b,
            },
            record.variant.priceDecimalPlaces
          );
          return <NumberComponent value={formTotalPriceExcludeVat} />;
        }
        const totalPriceExcludeVat = calcPoLineTotalPriceExcludeVat(
          {
            record,
            courierDeliveryAdditionalFeeList,
            isConsignment: isConsignmentType,
            poEventType,
            isB2b,
          },
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={totalPriceExcludeVat} />;
      },
      renderExcel: (record) =>
        calcPoLineTotalPriceExcludeVat(
          {
            record,
            courierDeliveryAdditionalFeeList,
            isConsignment: isConsignmentType,
            poEventType,
            isB2b,
          },
          record.variant.priceDecimalPlaces
        ),
    },
  ];
  purchaseOrderColumns = purchaseOrderColumns.filter(Boolean);

  const addressColumns: DownloadableEditableColumnsType<PurchaseOrderDetails_purchaseOrder_lines> = [
    {
      title: "수령인",
      key: "firstName",
      align: "center",
      width: 150,
      render: (_, record) => record.shippingAddress?.firstName || "-",
      renderExcel: (record) => record.shippingAddress?.firstName || "-",
    },
    {
      title: "연락처",
      key: "phone",
      align: "center",
      width: 150,
      render: (_, record) => transformPhoneNumber(record.shippingAddress?.phone) || "-",
      renderExcel: (record) => transformPhoneNumber(record.shippingAddress?.phone) || "-",
    },
    {
      title: "주소",
      key: "address",
      align: "center",
      width: 300,
      render: (_, record) => transformAddress(record.shippingAddress),
      renderExcel: (record) => transformAddress(record.shippingAddress),
    },
  ];

  const noteColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
    title: "비고",
    key: "note",
    align: "left",
    width: 250,
    render: (_, record) => record.note,
    renderExcel: (record) => record.note,
    onCell: (record) => ({
      inputType: "textArea",
      formItemName: "note",
      editing: isEditing(record),
    }),
  };

  const buttonWrapColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
    doNotRenderExcel: true,
    key: "button",
    align: "center",
    width: 150,
    fixed: utils.fixedRightFlag(),
    render: (_, record) => {
      const UpdateButton = () => {
        const editable = isEditing(record);

        return editable ? (
          <Space size={"small"}>
            <Button size="small" disabled={disabled} type={"primary"} onClick={onSubmit}>
              저장
            </Button>
            <Button size="small" type={"default"} onClick={onCancel}>
              취소
            </Button>
          </Space>
        ) : (
          <Button size="small" disabled={disabled} type={"primary"} onClick={() => onEdit(record)}>
            수정
          </Button>
        );
      };

      const DeleteButton = () => {
        const popConfirmText = `${record.productName}(${record.productSku}): 발주제품에서 해당 제품을 삭제 하시겠습니까?`;

        return (
          <Popconfirm
            title={`${popConfirmText}`}
            onConfirm={() => onLineDelete(record.id)}
            placement={"topRight"}
            disabled={disabled}
          >
            <Button size="small" type={"primary"} danger disabled={disabled}>
              삭제
            </Button>
          </Popconfirm>
        );
      };
      return (
        <Space direction="horizontal">
          <UpdateButton />
          <DeleteButton />
        </Space>
      );
    },
  };
  const lastPurchaseDateColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
    title: columnNameConstant.stock.LAST_PURCHASE_DATE,
    key: "lastStockedPoLinePurchaseDate",
    align: "center",
    width: 120,
    render: (_, record) => {
      if (utils.isEmpty(record.variant?.lastStockedPoLine?.purchaseDate)) {
        return "-";
      }
      return moment(record.variant.lastStockedPoLine.purchaseDate).format(onlyDateFormat);
    },
    renderExcel: (record) => {
      if (utils.isEmpty(record.variant?.lastStockedPoLine?.purchaseDate)) {
        return "-";
      }
      return moment(record.variant.lastStockedPoLine.purchaseDate).format(onlyDateFormat);
    },
  };
  const lastPurchaseQtyColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
    title: columnNameConstant.stock.LAST_PURCHASE_QTY,
    key: "lastStockedPoLinePurchaseQuantity",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.variant?.lastStockedPoLine?.purchaseQuantity} />,
    renderExcel: (record) => record.variant?.lastStockedPoLine?.purchaseQuantity || 0,
  };

  const availableQtyColumn: DownloadableEditableColumnType<PurchaseOrderDetails_purchaseOrder_lines> = {
    title: "현 재고(가용재고)",
    key: "availableQtyConsiderVirtualAlloc",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={getAvailableQtyConsiderVirtualAlloc(record.variant)} />,
    renderExcel: (record) => getAvailableQtyConsiderVirtualAlloc(record.variant) || 0,
  };

  if (isInventoryType) {
    columns = [
      numberColumn,
      askingPurchaseDateColumn,
      !isTakeBackType && expectedPurchaseDate,
      !isTakeBackType && purchaseDateColumn,
      !isNotSent && purchaseOrderLineStatusColumn,
      {
        title: "제품 정보",
        children: productColumns,
      },
      {
        title: "발주 금액 정보",
        children: purchaseOrderColumns,
      },
      {
        title: "협력사 정보",
        children: vendorColumns,
      },
      {
        title: "제품 현황",
        children: productStockStatusColumns,
      },
      isStaff && lastPurchaseDateColumn,
      isStaff && lastPurchaseQtyColumn,
      !isTakeBackType && {
        title: "입고 예정",
        children: needToStockColumns,
      },
      isStaff && availableQtyColumn,
      noteColumn,
      isNotSent && buttonWrapColumn,
    ];
  } else {
    columns = [
      numberColumn,
      orderComposedIdColumn,
      orderLineComposedIdColumn,
      askingPurchaseDateColumn,
      !isNotSent && purchaseOrderLineStatusColumn,
      {
        title: "제품 정보",
        children: productColumns,
      },
      {
        title: isTakeBackType ? "반품 금액 정보" : "발주 금액 정보",
        children: purchaseOrderColumns,
      },
      {
        title: "협력사 정보",
        children: vendorColumns,
      },
      {
        title: isTakeBackType ? "회수장소" : "납품장소",
        children: addressColumns,
      },
      noteColumn,
    ];
  }

  return columns.filter(Boolean);
};
</file>

<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderDetailsPage/PurchaseOrderDetailsPage.tsx">
import { DownloadOutlined, MailOutlined } from "@ant-design/icons";
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import {
  PurchaseOrderLineBulkUpdateInput,
  PurchaseOrderLineUpdateInput,
  PurchaseOrderManageAddNoteInput,
  PurchaseOrderUpdateInput,
} from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import { NumberComponent } from "@src/app/components/Number";
import PageHeader from "@src/app/components/PageHeader";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { DateTime } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { TDeliveryTruckInfo } from "@src/app/views/purchase/vendors/utils";
import { makeVendorDisplayName, transformPhoneNumber } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessageWritingToExcel,
  showNotificationError,
} from "@utils/notification/wrapper";
import { Button, Card, Descriptions, Form, Input, Space, Typography } from "antd";
import React, { useState } from "react";

import { usePrintPurchaseOrderLazyQuery } from "../../api/queries";
import { PurchaseOrderDetails_purchaseOrder } from "../../api/types/PurchaseOrderDetails";
import {
  getCheckPurchaseOrderEventTypeResults,
  getPurchaseOrderDeliveryWarehouseAddress,
  getPurchaseOrderEventTypeText,
  getPurchaseOrderStatusText,
} from "../../utils";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import { PurchaseOrderAddress } from "../PurchaseOrderAddress";
import { makePoDeliveryWarehouseList } from "../PurchaseOrderCreatePage/utils";
import { PurchaseOrderDetailsLines } from "../PurchaseOrderDetailsLines/PurchaseOrderDetailsLines";
import { PurchaseOrderManageHistory } from "../PurchaseOrderManageHistory";
import { onPurchaseOrderDownloadOrSend } from "./utils";

interface PurchaseOrderDetailsPageProps {
  purchaseOrderId: string;
  purchaseOrder: PurchaseOrderDetails_purchaseOrder;
  modalMode: PurchaseOrderModalModeEnum;
  disabled: boolean;
  saveButtonBar: ConfirmButtonTransitionState;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
  onBack: () => void;
  onUpdate: (formData: PurchaseOrderUpdateInput) => void;
  onLineUpdate: (lineId: string, input: PurchaseOrderLineUpdateInput) => Promise<boolean>;
  onLineBulkUpdate: (inputList: PurchaseOrderLineBulkUpdateInput[]) => Promise<boolean>;
  onLineDelete: (lineId: string) => Promise<void>;
  onNoteAdd: (input: PurchaseOrderManageAddNoteInput) => Promise<void>;
}

export const PurchaseOrderDetailsPage: React.FC<PurchaseOrderDetailsPageProps> = ({
  purchaseOrderId,
  purchaseOrder,
  modalMode,
  disabled,
  saveButtonBar,
  openModalWithoutNavigate,
  onBack,
  onUpdate,
  onLineUpdate,
  onLineBulkUpdate,
  onLineDelete,
  onNoteAdd,
}) => {
  const [formChanged, setFormChanged] = useState<boolean>(false);
  const [noteChanged, setNoteChanged] = useState<boolean>(false);
  const [form] = Form.useForm<PurchaseOrderUpdateInput>();
  const { user } = useUser();
  const shop = useShop();

  const [fetch] = usePrintPurchaseOrderLazyQuery();

  const { isTrackInventoryPurchaseOrder, isTakeBackPurchaseOrder } = getCheckPurchaseOrderEventTypeResults(
    purchaseOrder?.eventType
  );
  const isTrackInventoryIncludeTakeBackType = isTrackInventoryPurchaseOrder || isTakeBackPurchaseOrder;
  const isSent = purchaseOrder.isSent;
  const isNotB2b = purchaseOrder.isB2b === false;

  const warehouseList = shop?.defaultWarehouse ? makePoDeliveryWarehouseList(shop.defaultWarehouse) : [];
  const onPurchaseOrderExcelDownload = () => {
    showDownloadingMessageWritingToExcel();
    fetch({ variables: { id: purchaseOrderId } })
      .then((resPurchaseOrder) => {
        onPurchaseOrderDownloadOrSend({ resPurchaseOrder, isSendingMode: false, user });
      })
      .catch((e) => {
        showNotificationError("발주서 다운로드 과정에서 에러가 발생하였습니다");
        throw e;
      })
      .finally(() => {
        destroyDownloadingMessage();
      });
  };

  const downloadButton = (
    <Button
      type={"primary"}
      shape={"round"}
      disabled={disabled}
      icon={<DownloadOutlined />}
      onClick={onPurchaseOrderExcelDownload}
    >
      발주서 다운로드
    </Button>
  );
  const emailSendButton = (
    <Button
      type={"default"}
      shape={"round"}
      disabled={disabled}
      icon={<MailOutlined />}
      onClick={() => openModalWithoutNavigate(PurchaseOrderModalModeEnum.EmailSend, null)}
    >
      발주서 발송
    </Button>
  );

  const headerExtraUi = (
    <Space>
      {downloadButton}
      {emailSendButton}
    </Space>
  );

  const vendorData = JSON.parse(purchaseOrder?.vendorData);
  const purchaseOrderBasicInfo = (
    <Descriptions bordered size={"small"} column={{ xs: 1, sm: 3 }}>
      <Descriptions.Item label={<Typography.Title level={5}>발주구분</Typography.Title>}>
        {getPurchaseOrderEventTypeText(purchaseOrder?.eventType, purchaseOrder.isB2b)}
      </Descriptions.Item>
      <Descriptions.Item label={<Typography.Title level={5}>발주일</Typography.Title>}>
        {<DateTime date={purchaseOrder?.purchaseOrderDate} onlyDate />}
      </Descriptions.Item>
      <Descriptions.Item label={<Typography.Title level={5}>협력사</Typography.Title>}>
        {makeVendorDisplayName(vendorData)}
      </Descriptions.Item>
      {isTrackInventoryIncludeTakeBackType && (
        <>
          <Descriptions.Item
            label={
              <Typography.Title level={5}>{columnNameConstant.vendor.DELIVERY_TRUCK_INFO_WEIGHT}</Typography.Title>
            }
          >
            <NumberComponent value={(purchaseOrder?.vendor.deliveryTruckInfo as TDeliveryTruckInfo).weight} />
          </Descriptions.Item>
          <Descriptions.Item
            label={
              <Typography.Title level={5}>{columnNameConstant.vendor.DELIVERY_TRUCK_INFO_PALLET}</Typography.Title>
            }
          >
            <NumberComponent value={(purchaseOrder?.vendor.deliveryTruckInfo as TDeliveryTruckInfo).pallet} />
          </Descriptions.Item>
          <Descriptions.Item
            label={<Typography.Title level={5}>{columnNameConstant.vendor.DELIVERY_TRUCK_INFO_BOX}</Typography.Title>}
          >
            <NumberComponent value={(purchaseOrder?.vendor.deliveryTruckInfo as TDeliveryTruckInfo).box} />
          </Descriptions.Item>
          <Descriptions.Item label={<Typography.Title level={5}>선주문 불가</Typography.Title>}>
            {purchaseOrder?.isNotOrderableBeforeStocked ? "불가" : "-"}
          </Descriptions.Item>
          <Descriptions.Item label={<Typography.Title level={5}>패키지 구성품</Typography.Title>}>
            {purchaseOrder?.isForPackageOrder ? "O" : "-"}
          </Descriptions.Item>
        </>
      )}
    </Descriptions>
  );

  const purchaseOrderAddress = isSent ? (
    <Card title={<Typography.Title level={4}>납품 장소</Typography.Title>} bodyStyle={{ padding: 0 }}>
      <Descriptions bordered size={"small"}>
        <Descriptions.Item label={<Typography.Title level={5}>납품지</Typography.Title>}>
          {purchaseOrder?.deliveryWarehouseName || "-"}
        </Descriptions.Item>
        <Descriptions.Item label={<Typography.Title level={5}>담당자</Typography.Title>}>
          {purchaseOrder?.deliveryWarehouseManager || "-"}
        </Descriptions.Item>
        <Descriptions.Item label={<Typography.Title level={5}>연락처</Typography.Title>}>
          {transformPhoneNumber(purchaseOrder?.phone) || "-"}
        </Descriptions.Item>
        <Descriptions.Item label={<Typography.Title level={5}>주소</Typography.Title>}>
          {getPurchaseOrderDeliveryWarehouseAddress(purchaseOrder)}
        </Descriptions.Item>
      </Descriptions>
    </Card>
  ) : (
    <PurchaseOrderAddress form={form} disabled={disabled} warehouseLoading={false} warehouses={warehouseList} />
  );

  const purchaseOrderNoteTitle = <Typography.Title level={4}>메모</Typography.Title>;
  const purchaseOrderNote = isSent ? (
    <Card title={purchaseOrderNoteTitle}>
      {purchaseOrder?.note || <Typography.Text type="secondary">작성된 내용이 없습니다.</Typography.Text>}
    </Card>
  ) : (
    <Card title={purchaseOrderNoteTitle} bodyStyle={{ padding: 0 }}>
      <Form.Item name="note">
        <Input.TextArea rows={4} />
      </Form.Item>
    </Card>
  );
  const initialValues: PurchaseOrderUpdateInput = {
    warehouse: purchaseOrder?.warehouse?.id,
    warehouseAddress: purchaseOrder?.warehouseAddress?.id,
    deliveryWarehouseName: purchaseOrder?.deliveryWarehouseName,
    deliveryWarehouseManager: purchaseOrder?.deliveryWarehouseManager,
    phone: transformPhoneNumber(purchaseOrder?.phone),
    streetAddress1: purchaseOrder?.streetAddress1,
    streetAddress2: purchaseOrder?.streetAddress2,
    postalCode: purchaseOrder?.postalCode,
    note: purchaseOrder?.note,
  };

  const onSubmit = (data: PurchaseOrderUpdateInput) => {
    if (noteChanged === false) {
      showNotificationError("발주서 메모까지 수정한 후에 저장이 가능합니다. 수정한 사항을 메모에 기록해주세요.");
      return null;
    } else {
      const errors = onUpdate(data);
      setNoteChanged(false);
      return errors;
    }
  };

  const purchaseOrderTypeText = isTrackInventoryIncludeTakeBackType ? "재고" : "협력사";
  const statusText = <Typography.Text>{getPurchaseOrderStatusText(purchaseOrder?.isSent)}</Typography.Text>;
  const pageHeaderText = (
    <Typography.Text>
      {purchaseOrderTypeText} 발주서 조회 ({purchaseOrder?.code || "-"}: {statusText})
    </Typography.Text>
  );

  return (
    <>
      <AppHeader onBack={onBack}>
        {purchaseOrderTypeText} {sectionNames.purchaseOrders}
      </AppHeader>
      <PageHeader title={pageHeaderText}>{headerExtraUi}</PageHeader>

      <Space direction="vertical" size="large">
        <Form
          form={form}
          layout="vertical"
          name="purchase-order-update-form"
          initialValues={initialValues}
          onFinish={onSubmit}
          onValuesChange={(changedValues) => {
            setFormChanged(true);
            if (changedValues.note) {
              setNoteChanged(true);
            }
          }}
        >
          <Card>
            <Space direction={"vertical"} size={"large"}>
              {purchaseOrderBasicInfo}
              {isNotB2b && isTrackInventoryIncludeTakeBackType && purchaseOrderAddress}
              {isNotB2b && purchaseOrderNote}
            </Space>
          </Card>
        </Form>
        <PurchaseOrderDetailsLines
          disabled={disabled}
          purchaseOrder={purchaseOrder}
          modalMode={modalMode}
          openModalWithoutNavigate={openModalWithoutNavigate}
          onLineUpdate={onLineUpdate}
          onLineBulkUpdate={onLineBulkUpdate}
          onLineDelete={onLineDelete}
          isStaff={user?.isStaff}
        />
        <PurchaseOrderManageHistory history={purchaseOrder?.events} lines={purchaseOrder.lines} onNoteAdd={onNoteAdd} />
      </Space>
      <AntdSaveButtonBar
        disabled={disabled || !formChanged}
        state={saveButtonBar}
        onSave={form.submit}
        onCancel={onBack}
      />
    </>
  );
};
</file>

