    renderExcel: (record) => record.unitPriceGrossAmount - record.unitPriceVat,
  };
  const productUnitPriceGrossAmountVatColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: [columnNameConstant.purchaseOrder.VAT, "(ⓑ)"],
    key: "unitPriceGrossAmountVat",
    width: 70,
    render: (_, record) => <NumberComponent value={record.unitPriceVat} />,
    renderExcel: (record) => record.unitPriceVat,
  };
  const productUnitPriceGrossAmountVatTotalSumColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: ["총 판매가", "(ⓐ+ⓑ=ⓒ)"],
