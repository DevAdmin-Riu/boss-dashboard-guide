  return {
    [PurchaseOrderLineUrlEnum.DRAFT]: purchaseOrderLineCount.draftCount,
    [PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED]:
      purchaseOrderLineCount.pendingCount + purchaseOrderLineCount.rejectedCount,
    [PurchaseOrderLineUrlEnum.RECEIVE]: 0,
    [PurchaseOrderLineUrlEnum.DELEGATED_RECEIVE]: trackInventory
      ? purchaseOrderLineCount.pendingCount
      : purchaseOrderLineCount.delegatedPendingCount,
    [PurchaseOrderLineUrlEnum.IN_PRODUCTION]: 0,
    [PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT]: 0,
    [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT]: purchaseOrderLineCount.receivedCount,
    [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER]:
      purchaseOrderLineCount.delegatedReceivedCountByCourierNonAdjustPrice,
    [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST]:
      purchaseOrderLineCount.delegatedReceivedCountByCourierAdjustPrice,
    [PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_NON_COURIER]:
      purchaseOrderLineCount.delegatedReceivedCountByNonCourier,
    [PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE]: purchaseOrderLineCount.reqEpdUpdateCount,
    [PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY]: purchaseOrderLineCount.reqSplitDeliveryCount,
    [PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY]: 0,
    [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY]: purchaseOrderLineCount.dispatchFulfillmentCount,
    [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_COURIER]:
      purchaseOrderLineCount.consignmentDelegatedDispatchFulfillmentCountByCourier,
    [PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_NON_COURIER]:
      purchaseOrderLineCount.consignmentDelegatedDispatchFulfillmentCountByNonCourier,
    [PurchaseOrderLineUrlEnum.PRINT_INVOICE]: purchaseOrderLineCount.deliveryConfirmedCount,
    [PurchaseOrderLineUrlEnum.INSPECT]: purchaseOrderLineCount.toBeInspectedCount,
    [PurchaseOrderLineUrlEnum.ADD_STOCK]: purchaseOrderLineCount.inspectedCount,
    [PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY]: completeDeliveryCount,
    [PurchaseOrderLineUrlEnum.ALL]: 0,
  };
};

export const PurchaseOrderLineListView: React.FC<PurchaseOrderLineListViewProps> = ({
  defaultParams,
  params,
  isB2b = false,
}) => {
  const routeParams = useParams<PurchaseOrderLineListViewRouteParams>();
  const { inventoryType, status, deliveryMethod } = routeParams;
  const { user } = useUser();
  const shop = useShop();
  const [selectedRowIds, setSelectedRowIds] = useState<React.Key[]>([]);
  const targetUrl = (params: PurchaseOrderLineListViewUrlQueryParams) =>
    isB2b ? b2bPurchaseOrderLineListViewUrl(routeParams, params) : purchaseOrderLineListViewUrl(routeParams, params);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(ListViews.PURCHASE_ORDER_LINE_LIST, [inventoryType, status]),
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(usePurchaseOrderLineListFilterDownloadQuery);
  const isTrackInventory = inventoryType === "track-inventory";
  const isConsignment = inventoryType === "consignment";
  const targetAddTakeBackUrl = isTrackInventory
    ? purchaseOrderCreateViewUrl({ createType: "track-inventory-take-back" })
    : purchaseOrderCreateViewUrl({ createType: "consignment-take-back" });
  const targetAddTakeBackKey = isTrackInventory ? trackInventoryPurchaseOrderKey : consignmentPurchaseOrderKey;
  const isByNonCourier = deliveryMethod === "by-non-courier";

  const countQueryVariables: PurchaseOrderLineCountVariables = {
    filter: {
      vendorId: null,
      poEventType: [
        isTrackInventory && PurchaseOrderEventTypeEnum.INITIAL_ORDER,
        isTrackInventory && PurchaseOrderEventTypeEnum.REORDER,
        isTrackInventory && PurchaseOrderEventTypeEnum.TAKE_BACK,
        !isTrackInventory && PurchaseOrderEventTypeEnum.CONSIGNMENT,
        !isTrackInventory && PurchaseOrderEventTypeEnum.CONSIGNMENT_TAKE_BACK,
      ].filter(Boolean),
      isB2b,
    },
  };

  const { data: countData } = usePurchaseOrderLineCountQuery({ variables: countQueryVariables });
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const queryVariables: PurchaseOrderLineListVariables = React.useMemo(() => {
    const filterVariables = getFilterVariables(params, routeParams);
    const delegatedStatus: Array<PurchaseOrderLineListViewRouteParams["status"]> = [
      PurchaseOrderLineUrlEnum.RECEIVE,
      PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
      PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY,
    ];
    const useDelegatedManagementForPo =
      isConsignment && isB2b === false && delegatedStatus.includes(status) ? true : undefined;

    const afterStatusList = getAfterStatusList({
      status,
      pageType: isB2b ? "b2b" : inventoryType,
    });
    const beforeStatusList = createBeforeStatusList(afterStatusList);

    return {
      ...paginationState,
      filter: {
        ...filterVariables,
        useDelegatedManagementForPo,
        isB2b,
        deliveryMethods:
          isTrackInventory === false && isNeedDeliveryMethodFilterStatus(status) && isByNonCourier === false
            ? [OrderDeliveryMethodsEnum.BY_COURIER]
            : null,
        excludeDeliveryMethods:
          isTrackInventory === false && isNeedDeliveryMethodFilterStatus(status) && isByNonCourier
            ? [OrderDeliveryMethodsEnum.BY_COURIER]
            : null,
      },
      sort: getSortQueryVariables(params),
      afterStatusList,
      beforeStatusList,
    };
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = usePurchaseOrderLineListQuery({ variables: queryVariables });
  const purchaseOrderLines = useMemo(() => data?.purchaseOrderLines?.edges.map((edge) => edge.node) || [], [data]);

  const selectedPoLine = purchaseOrderLines.find((poLine) => poLine.id === params.id);
  const selectedPoLines = purchaseOrderLines.filter((line) => selectedRowIds?.includes(line.id));

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.purchaseOrderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PurchaseOrderLineListViewUrlDialog, PurchaseOrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  const handleProductStockUpdateWithNavigate = (productId: string, variantId?: string) =>
    variantId ? navigate(productVariantUpdateViewUrl(productId, variantId)) : navigate(productUpdateViewUrl(productId));

  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setSelectedRowIds([]);
    }
  };

  const [purchaseOrderLineAttachDeliveryConfirmDoc, purchaseOrderLineAttachDeliveryConfirmDocOpts] =
    usePurchaseOrderLineAttachDeliveryConfirmDocMutation({});
  const [purchaseOrderLineUpdate, purchaseOrderLineUpdateOpts] = usePurchaseOrderLineUpdateMutation({});
  const [purchaseOrderLineDelete, purchaseOrderLineDeleteOpts] = usePurchaseOrderLineDeleteMutation({
    refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
  });
  const [purchaseOrderLinesCancel, purchaseOrderLinesCancelOpts] = usePurchaseOrderLinesCancelMutation({
    refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
  });
  const [purchaseOrderLinesSend, purchaseOrderLinesSendOpts] = usePurchaseOrderLinesSendMutation({
    refetchQueries: [purchaseOrderLineCountQuery],
  });
  const [purchaseOrderLinesInvoicePrint, purchaseOrderLinesInvoicePrintOpts] =
    usePurchaseOrderLinesInvoicePrintMutation({
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
    });
  const [purchaseOrderLinesDeliveryConfirmed, purchaseOrderLinesDeliveryConfirmedOpts] =
    usePurchaseOrderLinesDeliveryConfirmedMutation({
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
    });

  const [purchaseOrderLinesDelivered, purchaseOrderLinesDeliveredOpts] = usePurchaseOrderLinesDeliveredMutation({});
  const [purchaseOrderLinesRevert, purchaseOrderLinesRevertOpts] = usePurchaseOrderLinesRevertMutation({
    refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
  });

  const handleLineUpdate = async ({
    purchaseOrderId,
    lineId,
    input,
    purchaseOrderDate,
  }: PurchaseOrderLineUpdateProps) => {
    const { askingPurchaseDate, quantity } = input;
    if (isB2b === false) {
      const isBeforePurchaseOrderDate = moment(askingPurchaseDate).isBefore(moment(purchaseOrderDate));
      if (isBeforePurchaseOrderDate) {
        showNotificationError(
          "납품 요청일이 발주일보다 이전 일자로 선택된 발주제품이 존재합니다. 납품 요청일은 발주일 이후의 일자로 선택해주세요."
        );
        return;
      }
    }
    if (utils.isEmpty(quantity) || quantity < 0) {
      showNotificationError("모든 발주 제품의 발주 수량은 0 이상의 값을 입력해주어야 합니다.");
      return;
    }

    const { data } = await purchaseOrderLineUpdate({ variables: { purchaseOrderId, lineId, input } });
    const errors = data.purchaseOrderLineUpdate?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품 정보가 수정되었습니다.");
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }

    return errors?.length === 0;
  };
  const handleLineDelete = async (variables: PurchaseOrderLineDeleteVariables) => {
    const { data } = await purchaseOrderLineDelete({ variables });
    const errors = data.purchaseOrderLineDelete?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품이 삭제되었습니다.");
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleLinesCancel = async (variables: PurchaseOrderLinesCancelVariables) => {
    const { data } = await purchaseOrderLinesCancel({ variables });
    const errors = data.purchaseOrderLinesCancel?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("선택한 발주제품이 발주취소 되었습니다.");
      onModalClose(true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleLinesSend = async (variables: PurchaseOrderLinesSendVariables) => {
    const { data } = await purchaseOrderLinesSend({ variables });
    const errors = data.purchaseOrderLinesSend?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("수정 후 다시 발주하였습니다.");
      onModalClose(true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleLinesRevert = async (variables: PurchaseOrderLinesRevertVariables, message: string) => {
    // ADD_STOCK(재고 입고)에서 검수 취소 시 needToInspect에 따라 분리 처리
    if (status === PurchaseOrderLineUrlEnum.ADD_STOCK && revertModalConfig?.requiresSplit) {
      const needToInspectLines = selectedPoLines
        .filter((line) => line.variant.needToInspect === true)
        .map((line) => line.id);

      const noNeedToInspectLines = selectedPoLines
        .filter((line) => line.variant.needToInspect === false)
        .map((line) => line.id);

      const mutations = [];

      // 검수 대상 항목 -> TO_BE_INSPECTED
      if (needToInspectLines.length > 0) {
        mutations.push(
          purchaseOrderLinesRevert({
            variables: {
              input: {
                purchaseOrderLineIds: needToInspectLines,
                beforeStatus: PurchaseOrderLineStatusEnum.INSPECTED,
                afterStatus: PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
              },
            },
          })
        );
      }

      // 검수 비대상 항목 -> DELIVERY_CONFIRMED
      if (noNeedToInspectLines.length > 0) {
        mutations.push(
          purchaseOrderLinesRevert({
            variables: {
              input: {
                purchaseOrderLineIds: noNeedToInspectLines,
                beforeStatus: PurchaseOrderLineStatusEnum.INSPECTED,
                afterStatus: PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
              },
            },
          })
        );
      }

      const results = await Promise.all(mutations);
      const allErrors = results.flatMap((r) => r.data?.purchaseOrderLinesRevert?.errors || []);

      if (allErrors.length === 0) {
        const totalCount = needToInspectLines.length + noNeedToInspectLines.length;
        showNotificationSuccess(
          `선택한 발주제품 ${totalCount}개의 검수가 취소되었습니다.\n` +
            `(검수대기: ${needToInspectLines.length}개, 배송확정: ${noNeedToInspectLines.length}개)`
        );
        onModalClose(true);
      } else {
        showGqlErrors(allErrors, makeGqlErrorMsg);
      }
    } else {
      // 기존 로직
      const { data } = await purchaseOrderLinesRevert({
        variables,
      });
      const errors = data?.purchaseOrderLinesRevert?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess(`선택한 발주제품이 ${message} 처리 되었습니다.`);
        onModalClose(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    }
  };

  const handelPurchaseOrderLineAttachDeliveryConfirmDoc = async ({ id, file }: { id: string; file: File }) => {
    const { data } = await purchaseOrderLineAttachDeliveryConfirmDoc({
      variables: { id, input: { deliveryConfirmDoc: file } },
    });
    const errors = data?.purchaseOrderLineAttachDeliveryConfirmDoc?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("납품확인서가 첨부되었습니다.");
      onModalClose(true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleInvoicePrint = async () => {
    // NOTE: 협력사 발주인 경우, 한 번에 수백건의 발주 품목을 처리하고 대부분 운송장으로 처리하거나 인터넷 업체는 거래명세서가 불필요함
    // 협력사 발주 중 직납(택배 배송 외의 배송 방법)인 경우는 거래명세서 출력 필요함
    const consignmentPoLinesByNonCourier = isTrackInventory
      ? []
      : selectedPoLines.filter(
          (poLine) => poLine.orderLine.order.deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER
        );
    if (!isTrackInventory && consignmentPoLinesByNonCourier.length === 0) {
      const { data } = await purchaseOrderLinesInvoicePrint({
        variables: { purchaseOrderLineIds: selectedRowIds as string[] },
      });
      const errors = data.purchaseOrderLinesInvoicePrint.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 발주 품목이 거래명세서출력 상태로 변경되었습니다.");
        setSelectedRowIds([]);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
      return;
    }

    showDownloadingMessage();

    try {
      // 엑셀 다운로드가 성공하면 아래 뮤테이션 호출 O / 실패하면 호출 X
      const targetPoLines = isTrackInventory ? selectedPoLines : consignmentPoLinesByNonCourier;
      const res = await onPurchaseOrderInvoiceExcelDownload(targetPoLines, routeParams, user, isB2b);
      if (res) {
        const { data } = await purchaseOrderLinesInvoicePrint({
          variables: { purchaseOrderLineIds: selectedRowIds as string[] },
        });
        const errors = data.purchaseOrderLinesInvoicePrint.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 거래명세서 출력이 완료되었습니다.");
          setSelectedRowIds([]);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    } catch (error) {
      showNotificationError("거래명세서 출력 중 오류가 발생했습니다.");
    } finally {
      destroyDownloadingMessage();
    }
  };

  const handleDeliveryConfirmed = async () => {
    const { data } = await purchaseOrderLinesDeliveryConfirmed({
      variables: { purchaseOrderLineIds: selectedRowIds as string[] },
    });
    const errors = data.purchaseOrderLinesDeliveryConfirmed.errors;
    if (errors.length === 0) {
      showNotificationSuccess("선택한 발주 품목이 배송 확정되었습니다.");
      setSelectedRowIds([]);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handlePurchaseOrderLinesDelivered = async () => {
    const { data } = await purchaseOrderLinesDelivered({
      variables: { purchaseOrderLineIds: selectedRowIds as string[] },
    });
    const errors = data.purchaseOrderLinesDelivered.errors;
    if (errors.length === 0) {
      showNotificationSuccess("선택한 발주 품목이 배송 완료 처리되었습니다.");
      setSelectedRowIds([]);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const disabled =
    loading ||
    purchaseOrderLineUpdateOpts.loading ||
    purchaseOrderLineDeleteOpts.loading ||
    purchaseOrderLinesCancelOpts.loading ||
    purchaseOrderLinesSendOpts.loading ||
    purchaseOrderLineAttachDeliveryConfirmDocOpts.loading ||
    purchaseOrderLinesInvoicePrintOpts.loading ||
    purchaseOrderLinesDeliveryConfirmedOpts.loading ||
    purchaseOrderLinesDeliveredOpts.loading ||
    purchaseOrderLinesRevertOpts.loading;

  const selectedRowExist = maybe(() => selectedRowIds.length > 0);

  useEffect(() => {
    if (!selectedRowExist) {
      closeModal();
    }
  }, [selectedRowIds]);

  useEffect(() => {
    setSelectedRowIds([]);
  }, [loading, inventoryType, status]);

  const revertModalConfig = getRevertModalInfo({ status });
  return (
    <>
      <PurchaseOrderLineListPage
        params={params}
        currencySymbol={currencySymbol}
        settings={settings}
        currentTab={currentTab}
        disabled={disabled}
        filterOpts={getFilterOpts(params, routeParams)}
        purchaseOrderLines={purchaseOrderLines}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(purchaseOrderDetailsViewUrl(id))}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        sort={getSortParams(params)}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        onProductStockUpdateWithNavigate={handleProductStockUpdateWithNavigate}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        navigate={navigate}
        onLineDelete={handleLineDelete}
        onLineUpdate={handleLineUpdate}
        onLinesCancel={handleLinesCancel}
        onLinesSend={handleLinesSend}
        onInvoicePrint={handleInvoicePrint}
        onDeliveryConfirmed={handleDeliveryConfirmed}
        onDelivered={handlePurchaseOrderLinesDelivered}
        onOrderNumberClick={(id) => navigate(orderDetailsViewUrl(id))}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        onAddTakeBack={(id) => {
          localStorage.setItem(targetAddTakeBackKey, JSON.stringify(id));
          navigate(targetAddTakeBackUrl);
        }}
        ListNavigator={() => (
          <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, PurchaseOrderLineUrlEnum>
            skipQueryString
            countOfStatus={countData ? getStatusCount(countData, isTrackInventory) : null}
            urlList={purchaseOrderLineUrlList(
              isTrackInventory,
              routeParams,
              isB2b ? b2bPurchaseOrderLineListViewUrl : purchaseOrderLineListViewUrl,
              isB2b ? b2bPurchaseOrderLineListViewPath : purchaseOrderLineListViewPath,
              isB2b
            )}
            NavButtonName={getPurchaseOrderLineNavButtonName(isTrackInventory, isB2b)}
          />
        )}
        isB2b={isB2b}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <VsPurchaseOrderLinesRejectModal
        open={params.action === "reject-lines" && selectedRowExist}
        loading={loading}
        poLineIds={selectedRowIds as string[]}
        onCancel={onModalClose}
      />
      <VsPurchaseOrderLinesReceiveModal
        open={params.action === "receive-lines" && selectedRowExist}
        loading={loading}
        poLineIds={selectedRowIds as string[]}
        onCancel={onModalClose}
      />
      <ConfirmModal
        visible={params.action === "cancel-lines" && selectedRowExist}
        okButtonProps={{ type: "primary", danger: true }}
        okText="취소"
        onOk={() => {
          handleLinesCancel({ purchaseOrderLineIds: selectedRowIds as string[] });
        }}
        onCancel={() => onModalClose(false)}
        modalTitleText="발주취소 확인"
        titleText="선택한 발주제품을 발주취소 하시겠습니까?"
        helpText="발주취소된 제품은 발주취소 상태로 변경되며, 발주취소된 제품은 발주취소된 제품 목록에서 확인하실 수 있습니다."
      />
      <VsPurchaseOrderLinesDispatchFulfillmentModal
        open={params.action === "dispatch-fulfillment" && selectedRowExist}
        loading={loading}
        trackInventory={isTrackInventory}
        poLines={selectedPoLines}
        orderLines={selectedPoLines.map((poLine) => poLine.orderLine)}
        onCancel={onModalClose}
        isB2b={isB2b}
        isByNonCourier={isByNonCourier}
      />
      <VsPurchaseOrderLinesReqEpdUpdateModal
        open={(params.action === "req-epd-update" || params.action === "approve-req-epd-update") && selectedRowExist}
        loading={disabled}
        isApproveMode={params.action === "approve-req-epd-update"}
        poLines={selectedPoLines}
        onCancel={onModalClose}
      />
      <VsPurchaseOrderLineReqSplitDeliveryModal
        open={
          (params.action === "req-split-delivery" || params.action === "approve-req-split-delivery") && !!selectedPoLine
        }
        loading={disabled}
        isApproveMode={params.action === "approve-req-split-delivery"}
        poLine={selectedPoLine}
        onCancel={onModalClose}
      />
      <ConfirmModal
        visible={params.action === "send-lines" && selectedRowExist}
        onOk={() => {
          handleLinesSend({ purchaseOrderLineIds: selectedRowIds as string[] });
        }}
        onCancel={() => onModalClose(false)}
        modalTitleText="일괄 발송 확인"
        titleText="선택한 발주제품을 일괄 발송 하시겠습니까?"
        helpText="일괄 발송된 제품은 접수대기 상태로 변경되며, 수정이나 취소가 불가합니다."
      />
      <PurchaseOrderLineAttachDeliveryConfirmDocModal
        open={params.action === "attach-delivery-confirm-doc"}
        onAttachDeliveryConfirmDocUpdate={(file) => {
          handelPurchaseOrderLineAttachDeliveryConfirmDoc({ id: selectedRowIds[0] as string, file });
        }}
        loading={disabled}
        onCancel={() => onModalClose(false)}
      />
      {revertModalConfig !== null && (
        <>
          <PurchaseOrderRevertLinesModal
            open={params.action === "revert-lines" && selectedRowExist}
            revertModalConfig={revertModalConfig}
            handleLinesRevert={handleLinesRevert}
            onModalClose={() => onModalClose(false)}
            purchaseOrderLineIds={selectedRowIds as string[]}
          />
        </>
      )}
      <PoLinesInvoiceSentEmailCreateModal
        open={params.action === "create-invoice-sent-email" && selectedRowExist}
        poLines={selectedPoLines}
        onClose={onModalClose}
      />
    </>
  );
};
