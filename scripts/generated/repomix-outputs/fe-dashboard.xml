import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import { makeNameByOrderType } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import {
  AltInvoiceeBizInfoInput,
  CountryCode,
  FulfillTypeEnum,
  OrderBulkCreateByStaffDetailInput,
  OrderBulkCreateByStaffInput,
  OrderDeliveryMethodsEnum,
  OrderLinesByStaff,
  OrderType,
} from "@src/api/types/globalTypes";
import { checkVatValueToPriceIncludeVat } from "@src/app/components/antd/Form/validators";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { isDateInFormatWithMoment, onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { useBrandProductsForOrderProductNameLazyQuery } from "@src/app/views/brand/brands/api/queries";
import type { BrandProductsForOrderProductName_brandProducts_edges_node_brandProductVariants } from "@src/app/views/brand/brands/api/types/BrandProductsForOrderProductName";
import { useCustomersDefaultShippingAddressLazyQuery } from "@src/app/views/customer/customers/api/queries";
import type { CustomersDefaultShippingAddress_customers_edges } from "@src/app/views/customer/customers/api/types/CustomersDefaultShippingAddress";
import { hqOrderLineListQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { StrictOmit } from "@src/global/core/types/types";
