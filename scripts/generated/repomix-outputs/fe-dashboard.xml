<file path="src/app/views/order/taxInvoice/views/TaxInvoiceListView/filter.ts">
import { OrderType, TaxInvoiceFilterInput, TaxInvoiceStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { getOrderTypeEnums } from "../../../orders/views/OrderListView/filters";
import { TaxInvoiceFilterKeys, TaxInvoiceListFilterOpts } from "../../components/TaxInvoiceListPage/filter";
import {
  TaxInvoiceListViewUrlFilters,
  TaxInvoiceListViewUrlFiltersEnum,
  TaxInvoiceListViewUrlFiltersWithMultipleValuesEnum,
  TaxInvoiceListViewUrlQueryParams,
} from "../../urls";

const TAX_INVOICE_ISSUED_FILTERS_KEY = "taxInvoiceIssuedFilters";

export function getFilterOpts(params: TaxInvoiceListViewUrlFilters): TaxInvoiceListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    writedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.writedAt.gte, filterVariables.writedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.writedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.writedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    issuedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.issuedAt.gte, filterVariables.issuedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.issuedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.issuedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    isTaxFree: {
      active: maybe(() => !utils.isEmpty(filterVariables.isTaxFree), false),
      value: maybe(() => filterVariables.isTaxFree, false),
    },
    isFromRiu: {
      active: maybe(() => !utils.isEmpty(filterVariables.isFromRiu), false),
      value: maybe(() => filterVariables.isFromRiu, false),
    },
    isToHq: {
      active: maybe(() => !utils.isEmpty(filterVariables.isToHq), false),
      value: maybe(() => filterVariables.isToHq, false),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => dedupeFilter(filterVariables.status), []),
    },
  };
}

export function getFilterVariables(params: TaxInvoiceListViewUrlFilters): TaxInvoiceFilterInput {
  const orderTypeEnums = getOrderTypeEnums(params.orderType as OrderType);
  return {
    orderType: orderTypeEnums,
    orderSearch: params.orderSearch,
    brandSearch: params.brandSearch,
    userSearch: params.userSearch,
    writedAt: getGteLteVariables({
      gte: params.writedAtFrom,
      lte: params.writedAtTo,
    }),
    issuedAt: getGteLteVariables({
      gte: params.issuedAtFrom,
      lte: params.issuedAtTo,
    }),
    isTaxFree: params.isTaxFree !== undefined ? parseBoolean(params.isTaxFree, false) : undefined,
    isFromRiu: params.isFromRiu !== undefined ? parseBoolean(params.isFromRiu, false) : undefined,
    isToHq: params.isToHq !== undefined ? parseBoolean(params.isToHq, false) : undefined,
    isReverseFee: params.isReverseFee !== undefined ? parseBoolean(params.isReverseFee, false) : undefined,
    status: maybe(() => params.status.map((status) => findInEnum(status, TaxInvoiceStatusEnum))),
  };
}

export function getFilterQueryParam(filter: IFilterElement<TaxInvoiceFilterKeys>): TaxInvoiceListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case TaxInvoiceFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.orderSearch);
    case TaxInvoiceFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.brandSearch);
    case TaxInvoiceFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.userSearch);
    case TaxInvoiceFilterKeys.writedAt:
      return getMinMaxQueryParam(
        filter,
        TaxInvoiceListViewUrlFiltersEnum.writedAtFrom,
        TaxInvoiceListViewUrlFiltersEnum.writedAtTo
      );
    case TaxInvoiceFilterKeys.issuedAt:
      return getMinMaxQueryParam(
        filter,
        TaxInvoiceListViewUrlFiltersEnum.issuedAtFrom,
        TaxInvoiceListViewUrlFiltersEnum.issuedAtTo
      );
    case TaxInvoiceFilterKeys.isTaxFree:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.isTaxFree);
    case TaxInvoiceFilterKeys.isFromRiu:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.isFromRiu);
    case TaxInvoiceFilterKeys.isToHq:
      return getSingleValueQueryParam(filter, TaxInvoiceListViewUrlFiltersEnum.isToHq);
    case TaxInvoiceFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        TaxInvoiceListViewUrlFiltersWithMultipleValuesEnum.status,
        TaxInvoiceStatusEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<TaxInvoiceListViewUrlFilters>(TAX_INVOICE_ISSUED_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  TaxInvoiceListViewUrlQueryParams,
  TaxInvoiceListViewUrlFilters
>({ ...TaxInvoiceListViewUrlFiltersEnum, ...TaxInvoiceListViewUrlFiltersWithMultipleValuesEnum });
</file>

