import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useUser from "@hooks/useUser";
import { LatLngInput } from "@src/api/types/globalTypes";
import { commonTableProps, getTableRowClassName } from "@src/app/components/antd/Table/TableProps";
import CompactFilter from "@src/app/components/Filter/CompactFilter";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import { KakaoMap } from "@src/app/components/KakaoMap";
import TableListFooter from "@src/app/components/TableListFooter";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { BrandStoreListForHqMap_brandStores_edges_node } from "@src/app/views/brand/brandStore/api/types/BrandStoreListForHqMap";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { CompactFilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { MapLatLng, MapMarker } from "@utils/kakao/kakaoMap";
import { numberOfBrandStores, transformAddress, transformPhoneNumber } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Descriptions, Row, Space, Table, Typography } from "antd";
import { ExpandableConfig } from "antd/lib/table/interface";
import React from "react";

import { createFilterStructure, HqBrandStoreMapListFilterKeys, HqBrandStoreMapListFilterOpts } from "./filters";
import { getHqBrandStoreMapListTableSettings } from "./HqBrandStoreMapListTableSettings";

interface HqBrandStoreMapListPageProps
  extends PaginateListProps,
    CompactFilterPageProps<HqBrandStoreMapListFilterKeys, HqBrandStoreMapListFilterOpts> {
  shop: ShopInfo_shop;
  brandStores: BrandStoreListForHqMap_brandStores_edges_node[];
  selectedRowId: string;
  mapCenter: MapLatLng;
  mapMarkers: MapMarker[];
  onDetails: (id: string) => void;
  onServiceAreaUpdate: (serviceArea: LatLngInput[]) => void;
}

export const HqBrandStoreMapListPage: React.FC<HqBrandStoreMapListPageProps> = (props) => {
  const {
    shop,
    brandStores,
    selectedRowId,
    mapCenter,
    mapMarkers,
    filterOpts,
    onFilterChange,
    onFilterReset,
    onRowClick,
    onDetails,
    onServiceAreaUpdate,
    ...listProps
  } = props;
  const { user } = useUser();
  const totalBrandStores = numberOfBrandStores(user);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const selectedBrandStore = brandStores.find((store) => store.id === selectedRowId);
  const selectedBrandStoreServiceArea = selectedBrandStore?.serviceArea || [];

  const filterStructure = createFilterStructure(filterOpts, shop);
  const columns = getHqBrandStoreMapListTableSettings();
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const titleText = `전체 매장 수(운영 중): ${totalBrandStores}`;

  const tableExpandable: ExpandableConfig<BrandStoreListForHqMap_brandStores_edges_node> = {
    rowExpandable: () => true,
    expandedRowRender: (record) => (
      <Descriptions size="small" labelStyle={{ minWidth: "50px" }} column={3}>
        <Descriptions.Item label="대표">{record.bizRegCeoName}</Descriptions.Item>
        <Descriptions.Item label="사업자번호">{record.bizRegNo}</Descriptions.Item>
        <Descriptions.Item label="연락처">{transformPhoneNumber(record.ownerUser.aligoPhone)}</Descriptions.Item>
        <Descriptions.Item label="이메일">{record.ownerUser.email}</Descriptions.Item>
        <Descriptions.Item label="등록일">{getDateByFormat(record.created, onlyDateFormat)}</Descriptions.Item>
        <Descriptions.Item>
          <Button size="small" onClick={() => onDetails(record.id)}>
            매장 상세 보기
          </Button>
        </Descriptions.Item>
        <Descriptions.Item span={3}>
          {utils.isEmpty(record.address) ? (
            <Typography.Text type="danger" strong>
              주소 미입력
            </Typography.Text>
          ) : (
            transformAddress(record.address)
          )}
        </Descriptions.Item>
      </Descriptions>
    ),
    expandedRowKeys: selectedRowId ? [selectedRowId] : [],
    showExpandColumn: false,
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{titleText}</Typography.Title>
        </Col>
      </Row>
      <Card>
        <Space direction="vertical" size="large">
          <CompactFilter<HqBrandStoreMapListFilterKeys>
            filterStructure={filterStructure}
            onFilterChange={onFilterChange}
            onFilterReset={onFilterReset}
          />

          <FixedSplitRow
            mainContentPosition="right"
            mainContent={
              <KakaoMap
                style={{ minWidth: "50vh", minHeight: "50vh" }}
                center={mapCenter}
                cluster={{
                  markers: mapMarkers,
                  getClusterTexts: (count) => `${getNumberFormat(count)}개 매장`,
                }}
                drawing={{
                  mode: ["polygon"],
                  customByMode: { polygon: { label: "영엽 구역 그리기", buttonWidth: "150px" } },
                  polygonPathsList: [selectedBrandStoreServiceArea],
                  onSave: (data) => {
                    const polygonArray = data.polygon;
                    if (utils.isEmpty(polygonArray)) {
                      showNotificationError("영업 구역을 새로 지정해주세요.");
                      return;
                    }
                    if (polygonArray.length > 1) {
                      showNotificationError("영업 구역은 매장마다 하나의 다각형만 지정할 수 있습니다.");
                      return;
                    }
                    const pointArray: Array<{ x: number; y: number }> = polygonArray[0].points;
                    const serviceArea = pointArray.map((point) => ({ lat: point.y, lng: point.x }));
                    onServiceAreaUpdate(serviceArea);
                  },
                }}
              />
            }
            sideContent={
              <Table<BrandStoreListForHqMap_brandStores_edges_node>
                {...commonTableProps}
                rowClassName={(record) => {
                  if (record.id === selectedRowId) {
                    return getTableRowClassName(["ant-table-row-selected"]);
                  }
                  return getTableRowClassName(["ant-table-row-link"]);
                }}
                style={{ width: tableWidthSum + 50 }}
                ref={tableRef}
                loading={listProps.disabled}
                columns={columns}
                dataSource={brandStores}
                onRow={(record) => ({ onClick: () => onRowClick(record.id) })}
                expandable={tableExpandable}
                scroll={{ y: tableScrollY }}
                footer={() => <TableListFooter {...listProps} />}
              />
            }
          />
        </Space>
      </Card>
    </Space>
  );
};
</file>

