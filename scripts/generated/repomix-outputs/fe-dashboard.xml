  };
  const bizCorpNameFilter = {
    ...createTextField(0, BrandGroupListFilterKeys.bizCorpName, "대표 상호", opts.bizCorpName.value),
    active: opts.bizCorpName.active,
  };
  const bizRegNoFilter = {
