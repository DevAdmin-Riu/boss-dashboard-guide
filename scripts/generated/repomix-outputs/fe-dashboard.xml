export type TVariantTypeForDeliveryBoxCount = Pick<
  ProductDetails_product_outerVariants,
  "isAdjustPrice" | "qtyPerDeliveryBox"
>;

// orderQty: 납품 시 금액 조정 상품인 경우에는 납품 수량이 변경되어도 원래 주문 수량을 입력:  2.5 -> 2.51 이 납품되어도 2박스로 증가되면 곤란
export const getDeliveryBoxCountConsiderAdjustPricePv = (pv: TVariantTypeForDeliveryBoxCount, orderQty: number) => {
  if (pv.isAdjustPrice) {
    return Math.ceil(orderQty / pv.qtyPerDeliveryBox);
  }
  return orderQty;
};

export const getUnitDeliveryAdditionalFeeExcludeVatByPostalCode = (
  postalCode: string,
  courierDeliveryAdditionalFeeList: ShopInfo_shop_courierDeliveryAdditionalFeeList[]
) => {
  if (utils.isEmpty(courierDeliveryAdditionalFeeList)) {
    return 0;
  }

  // 리스트는 이미 pcodeStart, pcodeEnd 기준으로 ordering 되어 있다고 가정
  const postalCodeNumber = Number(postalCode);
  const deliveryAdditionalFee = courierDeliveryAdditionalFeeList.find(
    (obj) => Number(obj.pcodeStart) <= postalCodeNumber && Number(obj.pcodeEnd) >= postalCodeNumber
  );

  if (deliveryAdditionalFee) {
    return deliveryAdditionalFee.unitAdditionalFeeExcludeVat;
  }
  return 0;
};

export const checkChargeDeliveryAdditionalFee = (
  postalCode: string,
  courierDeliveryAdditionalFeeList: ShopInfo_shop_courierDeliveryAdditionalFeeList[]
) => {
  const unitAdditionalFeeExcludeVat = getUnitDeliveryAdditionalFeeExcludeVatByPostalCode(
    postalCode,
    courierDeliveryAdditionalFeeList
  );
  return unitAdditionalFeeExcludeVat > 0;
};
