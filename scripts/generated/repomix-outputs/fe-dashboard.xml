  // NOTE: 협력사정보 변경 양식일 때 validate
  const makeCombineCodeForVendor = (detail: ProductVariantVendorBulkDetails) => {
    const vendorCode = detail.vendorCode;
    const sku = detail.productSku;
    return `${sku}:${vendorCode}`;
  };

  const validateDuplicateForVendor = (details: ProductVariantVendorBulkDetails[]) => {
    const combineCodes = [];
    const skusForIsDefault = [];
    const codeErrors = [];
    const isDefaultErrors = [];
    for (const detail of details) {
      const combineCode = makeCombineCodeForVendor(detail);
      const sku = detail.productSku;

      if (combineCodes.find((c) => c === combineCode)) {
        codeErrors.push(combineCode);
      } else {
        combineCodes.push(combineCode);
      }

      if (detail.isDefault) {
        if (skusForIsDefault.find((c) => c === sku)) {
          isDefaultErrors.push(sku);
        } else {
          skusForIsDefault.push(sku);
        }
      }
    }
    const isOk = codeErrors.length <= 0 && isDefaultErrors.length <= 0;
    if (!isOk) {
      if (codeErrors.length > 0) {
        showErrorMessageWithLabel("제품코드:협력사코드 중복", codeErrors);
      }
      if (isDefaultErrors.length > 0) {
        showErrorMessageWithLabel("기본 협력사 중복 (제품코드)", isDefaultErrors);
      }
    }
    return isOk;
  };

  const validateValueForVendor = (details: ProductVariantVendorBulkDetails[], isB2b: boolean) => {
    const defaultButNotActiveErrors = [];
    const productPriceErrors = [];
    const deliveryFeeErrors = [];
    const consignmentProductPriceErrors = [];
    const consignmentDeliveryFeeErrors = [];
    const leadTimeErrors = [];
    const moqErrors = [];
    const pricingBasisQtyErrors = [];
    const b2bDeliveryFeeIncludeErrors = [];
    const b2bDeliveryFeeErrors = [];

    for (const detail of details) {
      const combineCode = makeCombineCodeForVendor(detail);
      const isActive = detail.isActive;
      const isDefault = detail.isDefault;
      const productPrice = detail.productPriceExcludeVat;
      const deliveryFee = detail.deliveryFeeExcludeVat;
      const consignmentProductPrice = detail.consignmentProductPriceExcludeVat;
      const consignmentDeliveryFee = detail.consignmentDeliveryFeeExcludeVat;
      const leadTime = detail.leadTime;
      const moq = detail.moq;
      const pricingBasisQty = detail.pricingBasisQty;
      const includePurchaseB2bDeliveryFee = detail.includePurchaseB2bDeliveryFee;
      const purchaseB2bDeliveryFeeExcludeVat = detail.purchaseB2bDeliveryFeeExcludeVat;

      // 기본 협력사 활성화 체크
      if (isDefault && !isActive) {
        defaultButNotActiveErrors.push(combineCode);
      }

      // 직거래 상품이 아니고 B2B가 아닌 경우 재고 판매 금액 체크
      if (!isFulfilledByVendor && !isB2b) {
        if (!utils.isEmpty(productPrice) && productPrice < 0) {
          productPriceErrors.push(combineCode);
        }
        if (!utils.isEmpty(deliveryFee) && deliveryFee < 0) {
          deliveryFeeErrors.push(combineCode);
        }
      }

      // B2B 체크
      if (isB2b) {
        const includePurchaseB2bDeliveryFeeValue = parseExcelBooleanStrict(includePurchaseB2bDeliveryFee);
        if (includePurchaseB2bDeliveryFeeValue === undefined) {
          b2bDeliveryFeeIncludeErrors.push(combineCode);
        }
        if (
          (includePurchaseB2bDeliveryFeeValue === true && utils.isEmpty(purchaseB2bDeliveryFeeExcludeVat, true)) ||
          Number(purchaseB2bDeliveryFeeExcludeVat) < 0
        ) {
          b2bDeliveryFeeErrors.push(combineCode);
        }
      }

      // B2B가 아닌 경우 위탁 배송비 체크
      if (!isB2b) {
        if (!utils.isEmpty(consignmentDeliveryFee) && consignmentDeliveryFee < 0) {
          consignmentDeliveryFeeErrors.push(combineCode);
        }
      }

      // 공통 체크 항목들
      if (!utils.isEmpty(consignmentProductPrice) && consignmentProductPrice < 0) {
        consignmentProductPriceErrors.push(combineCode);
      }
      if (utils.isEmpty(leadTime) || leadTime <= 0) {
        leadTimeErrors.push(combineCode);
      }
      if (!utils.isEmpty(moq) && moq <= 0) {
        moqErrors.push(combineCode);
      }
      if (!utils.isEmpty(pricingBasisQty) && pricingBasisQty <= 0) {
        pricingBasisQtyErrors.push(combineCode);
      }
    }

    const isOk =
      defaultButNotActiveErrors.length <= 0 &&
      productPriceErrors.length <= 0 &&
      deliveryFeeErrors.length <= 0 &&
      consignmentProductPriceErrors.length <= 0 &&
      consignmentDeliveryFeeErrors.length <= 0 &&
      leadTimeErrors.length <= 0 &&
      moqErrors.length <= 0 &&
      pricingBasisQtyErrors.length <= 0 &&
      b2bDeliveryFeeIncludeErrors.length <= 0 &&
      b2bDeliveryFeeErrors.length <= 0;

    if (!isOk) {
      if (defaultButNotActiveErrors.length > 0) {
        showErrorMessageWithLabel("기본 협력사 비활성화 오류 (제품코드:협력사코드)", defaultButNotActiveErrors);
      }
      if (productPriceErrors.length > 0) {
        showErrorMessageWithLabel("재고 판매 협력사 상품가 오류 (제품코드:협력사코드)", productPriceErrors);
      }
      if (deliveryFeeErrors.length > 0) {
        showErrorMessageWithLabel("재고 판매 협력사 배송비 오류 (제품코드:협력사코드)", deliveryFeeErrors);
      }
      if (consignmentProductPriceErrors.length > 0) {
        showErrorMessageWithLabel("위탁 판매 협력사 상품가 오류 (제품코드:협력사코드)", consignmentProductPriceErrors);
      }
      if (consignmentDeliveryFeeErrors.length > 0) {
        showErrorMessageWithLabel("위탁 판매 협력사 배송비 오류 (제품코드:협력사코드)", consignmentDeliveryFeeErrors);
      }
      if (leadTimeErrors.length > 0) {
        showErrorMessageWithLabel("협력사 L/T 오류 (제품코드:협력사코드)", leadTimeErrors);
      }
      if (moqErrors.length > 0) {
        showErrorMessageWithLabel("협력사 MOQ 오류 (제품코드:협력사코드)", moqErrors);
      }
      if (pricingBasisQtyErrors.length > 0) {
        showErrorMessageWithLabel("기본 발주 수량 오류 (제품코드:협력사코드)", pricingBasisQtyErrors);
      }
      if (b2bDeliveryFeeIncludeErrors.length > 0) {
        showErrorMessageWithLabel("배송비 포함 여부 오류 (제품코드:협력사코드)", b2bDeliveryFeeIncludeErrors);
      }
      if (b2bDeliveryFeeErrors.length > 0) {
        showErrorMessageWithLabel("B2B 매입 배송비 오류 (제품코드:협력사코드)", b2bDeliveryFeeErrors);
      }
    }
    return isOk;
  };

  const readUploadFile = async (e) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const sheetName = worksheet.name;
        const targetVersion = getTargetTemplateVersionByModeWatched(modeWatched);
        if (utils.validateTemplateVersion(sheetName, targetVersion) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        const details = parseWorksheetToJsonArr<any>({ worksheet });
        if (validateDataIsNonNull(details) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        // NOTE: 공급원가 일괄 수정 양식일 경우
        if (checkIsPVRPriceBulkDetails(details, modeWatched)) {
          // 입력된 sku에 따라 해당 상품의 면세 여부 정보를 가져오고, 입력된 가격 정보를 부가세 포함 가격으로 변환하여 저장.
          const { data: variantsForUpload } = await refetchForUpload({
            variables: {
              first: details.length,
              filter: { sku: details.map((detail) => detail.productSku) },
            },
          });
          const variantNodesForUpload = variantsForUpload?.productVariants?.edges?.map((edge) => edge.node);
          const detailsIncludeVat = convertUploadValuesToIncludeVat(details, variantNodesForUpload, true);

          // 뮤테이션 input에 불필요한 컬럼 제거, price 기본값과 object로 변환된 disabledDays 값 설정
          for (const detail of detailsIncludeVat) {
            delete detail.regionName;
            delete detail.consignmentDeliveryFeeExcludeVat;
            delete detail.innerIncidentalCostExcludeVat;

            detail.price = 0;
            detail.disabledDays = convertToDaysObject(detail.disabledDays);
          }
        }

        // NOTE: 재고정보, 박스정보, 제품속성 변경 양식일 경우
        if (checkIsPVBulkUpdateDetails(details, modeWatched)) {
          if (modeWatched === ProductVariantUpdateOrCreateModeEnum.FBV_STOCK && isFulfilledByVendor) {
            for (const detail of details) {
              detail.bpvUpdateInput = {
                brandCode: detail.brandCode,
              };
              delete detail.brandCode;
            }
          }

          // 박스정보 변경 양식일 경우, boxSize는 attributes input 형태로 변경 후 기존 컬럼 삭제
          // 박스사이즈 속성은 slug와 name의 값이 동일하지 않기 때문에, 아래 과정에서 name이 일치하는 실제 속성의 slug 값을 values로 전달
          if (
            modeWatched === ProductVariantUpdateOrCreateModeEnum.BOX ||
            modeWatched === ProductVariantUpdateOrCreateModeEnum.FBV_BOX
          ) {
            for (const detail of details) {
              const attributeInputs: AttributeValueInputBySlug[] = Object.entries(detail)
                .filter(([key]) => key === AttributeSlugEnum.boxSize)
                .map(([key, value]) => {
                  const initialAttribute = attributes.find((attribute) => attribute.slug === key);
                  const values = [];
                  initialAttribute.values.forEach((initialAttrValue) => {
                    if (initialAttrValue.name === value) {
                      values.push(initialAttrValue.slug);
                    }
                  });
                  return { slug: key, values };
                });
              detail.attributes = [...attributeInputs];

              if (isFulfilledByVendor) {
                detail.bpvUpdateInput = {
                  brandCode: detail.brandCode,
                };
                delete detail.brandCode;
              }

              const detailKeysToDelete = [AttributeSlugEnum.boxSize];
              detailKeysToDelete.forEach((key) => {
                delete detail[key];
              });
            }
          }

          // 제품속성 변경 양식일 경우, productSku 이외의 모든 컬럼은 attributes input 형태로 변경 후 기존 컬럼 삭제
          if (
            modeWatched === ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE ||
            modeWatched === ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE
          ) {
            const notAttributeKeys = [
              "productSku",
              "productName",
              "variantName",
              "makerName",
              "qtyPerBoxUnitType",
              "salesUnitType",
              "brandCode",
              "countryOfOrigin",
              "isSeasonal",
              "peakSeasonStartDate",
              "peakSeasonEndDate",
            ];

            for (const detail of details) {
              const attributes: AttributeValueInputBySlug[] = Object.entries(detail)
                .filter(([key]) => notAttributeKeys.includes(key) === false)
                .map(([key, value]) => ({ slug: key, values: [value] }));
              detail.attributes = [...attributes];

              // 입수량 단위, 운영 단위는 사용자에게 보이는 라벨로 입력을 받고, 실제 값은 enum 값으로 변환하여 뮤테이션 호출
              detail.qtyPerBoxUnitType = getQtyPerBoxUnitTypeValue(detail.qtyPerBoxUnitType);
              detail.salesUnitType = getSalesUnitTypeValue(detail.salesUnitType);

              const detailKeys = Object.keys(detail);
              if (isFulfilledByVendor) {
                detail.bpvUpdateInput = {
                  brandCode: detail.brandCode,
                };
                delete detail.brandCode;
              }

              const detailKeysToDelete = detailKeys.filter((key) => ![...notAttributeKeys, "attributes"].includes(key));
              detailKeysToDelete.forEach((key) => {
                delete detail[key];
              });

              if (checkIsAttributeModeDetails(details, modeWatched)) {
                detail.countryOfOrigin = utils.getCountryOfOriginCode(detail.countryOfOrigin, allCountries);
              }
            }
          }
        }

        // NOTE: 제품일괄등록 / 직거래 상품등록 양식일 경우
        if (isCreateProductMode || isFbvCreateProductMode || isB2bCreateProductMode) {
          const attributeKeys = ["size", "color", "식품", "product_option", "capacity", "material", "종류", "weight"];
          for (const detail of details) {
            const attributes: AttributeValueInputBySlug[] = Object.entries(detail)
              .filter(([key]) => attributeKeys.includes(key) === true)
              .map(([key, value]) => ({ slug: key, values: [value as any] }));
            detail.attributesSlug = [...attributes];
            attributeKeys.forEach((key) => {
              delete detail[key];
            });

            if (isCreateProductMode || isB2bCreateProductMode) {
              if (utils.removeAllSpaces(detail.salesStatus) === "판매대기") {
                detail.salesStatus = SalesStatusEnum.PENDING;
              } else if (utils.removeAllSpaces(detail.salesStatus) === "정상") {
                detail.salesStatus = SalesStatusEnum.ON_SALE;
              }
            }

            // 후정산 상품인 경우
            if (parseExcelBooleanStrict(detail.isDeferred) === true && isFbvCreateProductMode) {
              detail.defaultPvvProductPriceExcludeVat = 0;
              detail.defaultPvvDeliveryFeeExcludeVat = 0;
              detail.defaultPvvConsignmentProductPriceExcludeVat = 0;
              detail.defaultPvvConsignmentDeliveryFeeExcludeVat = 0;
              detail.defaultPvvNoteForUnitPrice = 0;
              detail.bpvPrice = 0;
              detail.bpvPriceVat = 0;
              detail.bpvBeforePrice = 0;
              detail.bpvShowBeforePrice = false;
            }

            const defaultPvvKeys = Object.keys(detail).filter((key) => key.startsWith("defaultPvv"));
            const bpvKeys = Object.keys(detail).filter((key) => key.startsWith("bpv"));
            const defaultPvvCreateInput: Record<string, any> = {};
            for (const key of defaultPvvKeys) {
              const rawKey = key.replace(/^defaultPvv/, "");
              const normalizedKey = rawKey.charAt(0).toLowerCase() + rawKey.slice(1);
              defaultPvvCreateInput[normalizedKey] = detail[key];
            }
            for (const key of defaultPvvKeys) {
              delete detail[key];
            }

            detail.defaultPvvCreateInput = defaultPvvCreateInput;

            if (isFbvCreateProductMode) {
              const bpvCreateInput: Record<string, any> = {};
              for (const key of bpvKeys) {
                const rawKey = key.replace(/^bpv/, "");
                const normalizedKey = rawKey.charAt(0).toLowerCase() + rawKey.slice(1);
                bpvCreateInput[normalizedKey] = detail[key];
              }
              for (const key of bpvKeys) {
                delete detail[key];
              }
              detail.bpvCreateInput = bpvCreateInput;
            }

            // 입수량 단위, 운영 단위는 사용자에게 보이는 라벨로 입력을 받고, 실제 값은 enum 값으로 변환하여 뮤테이션 호출
            detail.qtyPerBoxUnitType = getQtyPerBoxUnitTypeValue(detail.qtyPerBoxUnitType);
            detail.salesUnitType = getSalesUnitTypeValue(detail.salesUnitType);

            // 기본값 ProductCreateInput을 공유하는데 꼭 넣어줘야하는 값들. 업로드 양식에는 안넣었음.
            detail.basePrice = 0;
            detail.isDirectShipping = false;
            if (isFbvCreateProductMode) {
              detail.canSaleByInner = false;
            }

            detail.countryOfOrigin = utils.getCountryOfOriginCode(detail.countryOfOrigin, allCountries);
            detail.needToInspect = false;
          }
        }

        // 확인 버튼 클릭 시점이 아닌, 엑셀 파일 선택 및 업로드 시점에 validation 체크
        const validateAry = [];
        validateAry.push(validateProductSkuEmpty(details));
        if (checkIsPVBulkUpdateDetails(details, modeWatched)) {
          // 재고정보, 박스정보, 제품속성 변경 양식일 경우
          validateAry.push(validateDuplicate(details));
          validateAry.push(validateValue(details));
          if (checkIsAttributeModeDetails(details, modeWatched)) {
            validateAry.push(validateCountryOfOrigin(details, true)); // 일괄 수정 모드: 빈 값은 수정 안함
            validateAry.push(validateSeasonalFields(details, true)); // 일괄 수정 모드: 빈 값은 수정 안함
          }
          validateAry.push(validateIsVendorTrackInventoryOnUpdate(details));
        } else if (checkIsPVRPriceBulkDetails(details, modeWatched)) {
          // 공급원가 변경 양식일 경우
          validateAry.push(validateDirectShippingEmpty(details));
          validateAry.push(validateRegionCodeEmpty(details));
          validateAry.push(validateValueForPrice(details));
          validateAry.push(validateDuplicateForPrice(details));
        } else if (
          checkIsPVVendorBulkDetails(details, modeWatched) ||
          checkIsHqFbvPVVendorBulkDetails(details, modeWatched)
        ) {
          // 협력사정보 변경 양식일 경우
          validateAry.push(validateDuplicateForVendor(details));
          validateAry.push(validateValueForVendor(details, false));
        } else if (
          checkIsProductBulkDetails(details, modeWatched) ||
          checkIsFbvProductBulkDetails(details, modeWatched)
        ) {
          // 제품일괄등록 양식일 경우
          validateAry.push(validateProductInfoNotiEmpty(details));
          validateAry.push(validateMakerNameEmpty(details));
          validateAry.push(validateDefaultPvvEmpty(details, false));
          validateAry.push(validateCountryOfOrigin(details));
          if (checkIsProductBulkDetails(details, modeWatched)) {
            validateAry.push(validateDecimalValue(details, false));
            validateAry.push(validateSalesStatusValue(details));
            validateAry.push(validateIsSubPvAndCanSaleByInner(details));
            validateAry.push(validateIsAdjustValue(details));
            validateAry.push(validateSeasonalFields(details));
            validateAry.push(validateIsVendorTrackInventoryOnCreate(details));
          }

          if (checkIsFbvProductBulkDetails(details, modeWatched)) {
            validateAry.push(validateFbvBpvProductInfoNotiEmpty(details));
          } else {
            validateAry.push(validatePriorityLevelEmpty(details));
          }
        } else if (checkIsB2bProductBulkDetails(details, modeWatched)) {
          // B2B 제품일괄등록 양식일 경우
          validateAry.push(validateMakerNameEmpty(details));
          validateAry.push(validateDefaultPvvEmpty(details, true));
          validateAry.push(validateCountryOfOrigin(details));
          validateAry.push(validateDecimalValue(details, true));
          validateAry.push(validateSalesStatusValue(details));
        } else if (checkIsB2bVendorDetails(details, modeWatched)) {
          // B2B 협력사정보 변경 양식일 경우
          validateAry.push(validateDuplicateForVendor(details));
          validateAry.push(validateValueForVendor(details, true));
        }

        if (validateAry.findIndex((v) => v === false) >= 0) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        TypeSafeForm.setFields([{ name: "details", value: details }]);
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }

    if (upload.current) {
      upload.current.value = "";
    }
  };

  const onSubmit = async (formData: ProductVariantBulkUpdateOrCreateForm) => {
    const { mode, details, manageEvent } = formData;

    if (checkIsPVBulkUpdateDetails(details, mode)) {
      // 재고정보, 박스정보, 제품속성, 기준판매가 변경 양식일 경우
      productVariantBulkUpdate({ variables: { input: { isFulfilledByVendor, details, manageEvent } } });
    } else if (checkIsPVRPriceBulkDetails(details, mode)) {
      // 공급원가 변경 양식일 경우
      const convertedDetails = convertUploadValuesOfBaseProduct(details);
      productVariantBulkUpdateOrCreate({ variables: { input: { details: convertedDetails, manageEvent } } });
    } else if (checkIsPVVendorBulkDetails(details, mode) || checkIsHqFbvPVVendorBulkDetails(details, mode)) {
      // 협력사정보 변경 양식일 경우
      productVariantVendorBulkUpdateOrCreate({ variables: { input: { isFulfilledByVendor, details, manageEvent } } });
    } else if (checkIsProductBulkDetails(details, mode) || checkIsFbvProductBulkDetails(details, mode)) {
      // 제품일괄등록 양식일 경우
      productBulkCreate({ variables: { input: { isFulfilledByVendor, details } } });
    } else if (checkIsB2bProductBulkDetails(details, mode)) {
      // B2B 제품일괄등록 양식일 경우
      const b2bDetails = details.map((detail) => ({
        ...detail,
        // B2B 일괄 생성 시 기본값 설정할 항목
        isExclusive: true,
        trackInventory: false,
        isVendorTrackInventory: false,
        canSaleByInner: false,
        allowAutoConsignment: false,
        isSubPv: false,
        requiredExpDateMgmt: false,
      }));
      productBulkCreate({ variables: { input: { isFulfilledByVendor, details: b2bDetails } } });
    } else if (checkIsB2bVendorDetails(details, mode)) {
      // B2B 협력사정보 변경 양식일 경우
      productVariantVendorBulkUpdateOrCreate({ variables: { input: { isFulfilledByVendor, details, manageEvent } } });
    }
  };

  const {
    loadMore: loadMoreCategories,
    search: searchCategory,
    result: searchCategoryOpts,
  } = useCategorySearch({
    variables: {
      ...DEFAULT_INITIAL_SEARCH_DATA,
    },
  });

  const fetchMoreCategories = {
    hasMore: searchCategoryOpts.data?.search.pageInfo.hasNextPage,
    loading: searchCategoryOpts.loading,
    onFetchMore: loadMoreCategories,
  };

  const {
    loadMore: loadMoreProductTypes,
    search: searchProductTypes,
    result: searchProductTypesOpts,
  } = useProductTypeSearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, isFulfilledByVendor },
  });

  const fetchMoreProductTypes = {
    hasMore: searchProductTypesOpts.data?.search.pageInfo.hasNextPage,
    loading: searchProductTypesOpts.loading,
    onFetchMore: loadMoreProductTypes,
  };

  const getCommonSelectProps = (onSearch: (data: string) => void, fetchMoreData: FetchMoreProps): SelectProps => ({
    showSearch: true,
    style: { width: "100%" },
    size: "large",
    disabled: searchCategoryOpts.loading || searchProductTypesOpts.loading,
    loading: fetchMoreData.loading,
    filterOption: (input, option) =>
      typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase()),
    onSearch,
    onDropdownVisibleChange: (open) => {
      if (open) {
        onSearch("");
      }
    },
    onPopupScroll: ({ currentTarget }) => {
      const { scrollHeight, scrollTop, clientHeight } = currentTarget;
      const { hasMore, loading, onFetchMore } = fetchMoreData;
      // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
      if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
        onFetchMore();
      }
    },
  });

  const productTypeOptions = searchProductTypesOpts.data?.search.edges.map(({ node }) => ({
    label: node.name,
    value: utils.getDBIdFromGraphqlId(node.id, "ProductType"),
  }));

  const categoryOptions = searchCategoryOpts.data?.search.edges.map(({ node }) => ({
    label: getCategoryLabel(node),
    value: utils.getDBIdFromGraphqlId(node.id, "Category"),
  }));

  const printLabelAndLinkArr: Array<{ label: string; link: string }> = [];

  // B2B 모드인 경우 제품일괄등록 양식과 협력사 정보 양식만 사용
  if (isB2bMode) {
    printLabelAndLinkArr.push(
      { label: "B2B 제품일괄등록 양식", link: `${s3TemplateUrl}/b2b_create_product.xlsx` },
      { label: "B2B 협력사정보 양식", link: `${s3TemplateUrl}/set_b2b_product_vendor.xlsx` }
    );
  } else {
    const fbv = isFulfilledByVendor ? "fbv_" : "";
    printLabelAndLinkArr.push({
      label: `${staffTitle} 일괄등록 양식`,
      link: `${s3TemplateUrl}/create_${fbv}product.xlsx`,
    });
    if (isHqStaff === false) {
      printLabelAndLinkArr.push(
        { label: "재고정보 양식", link: `${s3TemplateUrl}/set_${fbv}product_stock.xlsx` },
        { label: "박스정보 양식", link: `${s3TemplateUrl}/set_${fbv}product_box.xlsx` }
      );
    }
    printLabelAndLinkArr.push({ label: "제품속성 양식", link: `${s3TemplateUrl}/set_${fbv}product_attribute.xlsx` });
    if (!isFulfilledByVendor) {
      printLabelAndLinkArr.push({ label: "공급원가 양식", link: `${s3TemplateUrl}/set_product_price.xlsx` });
    }
    const productVendorXlsxLink = isHqStaff
      ? `${s3TemplateUrl}/set_hq_fbv_product_vendor.xlsx`
      : `${s3TemplateUrl}/set_product_vendor.xlsx`;
    printLabelAndLinkArr.push({ label: "협력사정보 양식", link: productVendorXlsxLink });
  }
  if (isStaff) {
    printLabelAndLinkArr.push({
      label: "기준판매가정보 양식",
      link: `${s3TemplateUrl}/set_product_base_sell_price.xlsx`,
    });
  }

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      width={600}
      title={
        <>
          <Row justify={"space-between"} align={"middle"}>
            <Col>{staffTitle} 일괄 등록/수정</Col>
            {isHqStaff && (
              <Col>
                <Button type="primary" onClick={fbvVendorsModalOpen}>
                  직거래 협력사 조회
                </Button>
              </Col>
            )}
          </Row>
        </>
      }
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      onCancel={onModalClose}
      okButtonProps={{ disabled: !isModeSelected || utils.isEmpty(detailsWatched) || modalLoading }}
      cancelButtonProps={{ disabled: modalLoading }}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="vertical"
        name="product-variant-bulk-update-or-create-form"
        onFinish={onSubmit}
        onValuesChange={(changedValues) => {
          if ("mode" in changedValues) {
            TypeSafeForm.setFields([{ name: "details", value: [] }]);
            setSelectedFile(undefined);
            setErrorExist(false);
          }
        }}
      >
        <Space direction="vertical" size={0}>
          <Row justify="start" gutter={[12, 12]}>
            {printLabelAndLinkArr.map((item) => (
              <Col key={item.label}>
                <Button type="default" shape="round" disabled={loading} icon={<DownloadOutlined />} href={item.link}>
                  <Typography.Text>{item.label}</Typography.Text>
                </Button>
              </Col>
            ))}
          </Row>
          <Form.Item
            name="mode"
            label="변경할 정보"
            rules={[{ required: true, message: "제품정보 일괄 수정 적용할 정보를 선택해 주세요." }]}
            style={{ marginTop: 15 }}
          >
            <Radio.Group>
              {isB2bMode ? (
                // B2B 모드에서는 제품등록과 협력사 정보만 표시
                <>
                  <Radio value={ProductVariantUpdateOrCreateModeEnum.B2B_CREATE_PRODUCT}>B2B 제품등록</Radio>
                  <Radio value={ProductVariantUpdateOrCreateModeEnum.B2B_VENDOR}>B2B 협력사정보</Radio>
                </>
              ) : (
                // 기존 모드
                <>
                  {isFulfilledByVendor === false && (
                    <Radio value={ProductVariantUpdateOrCreateModeEnum.CREATE_PRODUCT}>제품등록</Radio>
                  )}
                  {isFulfilledByVendor && (
                    <Radio value={ProductVariantUpdateOrCreateModeEnum.FBV_CREATE_PRODUCT}>{staffTitle} 등록</Radio>
                  )}
                  {isHqStaff === false && (
                    <Radio
                      value={
                        isFulfilledByVendor
                          ? ProductVariantUpdateOrCreateModeEnum.FBV_STOCK
                          : ProductVariantUpdateOrCreateModeEnum.STOCK
                      }
                    >
                      재고정보
                    </Radio>
                  )}
                  {isHqStaff === false && (
                    <Radio
                      value={
                        isFulfilledByVendor
                          ? ProductVariantUpdateOrCreateModeEnum.FBV_BOX
                          : ProductVariantUpdateOrCreateModeEnum.BOX
                      }
                    >
                      박스정보
                    </Radio>
                  )}
                  <Radio
                    value={
                      isFulfilledByVendor
                        ? ProductVariantUpdateOrCreateModeEnum.FBV_ATTRIBUTE
                        : ProductVariantUpdateOrCreateModeEnum.ATTRIBUTE
                    }
                  >
                    제품속성
                  </Radio>
                  {isFulfilledByVendor === false && (
                    <Radio value={ProductVariantUpdateOrCreateModeEnum.PRICE}>공급원가</Radio>
                  )}
                  <Radio
                    value={
                      isHqStaff
                        ? ProductVariantUpdateOrCreateModeEnum.HQ_FBV_VENDOR
                        : ProductVariantUpdateOrCreateModeEnum.VENDOR
                    }
                  >
                    협력사정보
                  </Radio>
                </>
              )}
              {/* 기준판매가 정보는 리우 관리자라면 제품 종류 상관 없이 저장 가능 */}
              {isStaff && (
                <>
                  <Radio value={ProductVariantUpdateOrCreateModeEnum.BASE_SELL_PRICE}>기준판매가정보</Radio>
                </>
              )}
            </Radio.Group>
          </Form.Item>
          <Form.Item
            name="details"
            label="변경 양식 업로드"
            rules={[{ required: true, message: "제품정보 일괄 수정 적용할 양식 엑셀 파일을 선택해 주세요." }]}
          >
            <Space direction="vertical" size={0}>
              <Button onClick={handleUploadButtonClick} type="primary" disabled={!isModeSelected}>
                {staffTitle} 등록/수정 양식 선택
              </Button>
              {!isModeSelected && (
                <Typography.Text type="warning">등록/수정할 정보를 먼저 선택해 주세요.</Typography.Text>
              )}
              {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
              {errorExist && <Typography.Text type="warning">양식 엑셀 파일을 다시 선택해 주세요.</Typography.Text>}
              <input
                hidden={true}
                id="productVariantBulkUpdateOrCreateInputFile"
                onChange={(e) => readUploadFile(e)}
                type="file"
                ref={upload}
                accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
              />
            </Space>
          </Form.Item>
          {modeWatched !== ProductVariantUpdateOrCreateModeEnum.CREATE_PRODUCT ? (
            <Card type="inner" title="제품 관리 이력">
              {makePvOrBpvManageEventFormItems({
                loading: modalLoading,
                manageEventType: initialValues.manageEvent.type,
                choices: productVariantManageEventTypeChoices,
              })}
            </Card>
          ) : (
            <>
              <Typography.Text type="danger" italic>
                제품 일괄 등록 시 카테고리 및 제품타입에 입력해야 하는 값을 아래에서 찾을 수 있습니다.
              </Typography.Text>
              <br />
              <FormFieldAntd label="카테고리">
                <Select
                  {...getCommonSelectProps(searchCategory, fetchMoreCategories)}
                  autoFocus={true}
                  placeholder="카테고리를 선택해 주세요."
                  onChange={(value) => setCategoryNum(value)}
                  options={categoryOptions}
                />
              </FormFieldAntd>
              <Typography.Text strong>categoryNum : {categoryNum}</Typography.Text>
              <br />
              <FormFieldAntd label="제품 타입">
                <Select
                  {...getCommonSelectProps(searchProductTypes, fetchMoreProductTypes)}
                  autoFocus={true}
                  placeholder="제품 타입을 선택해 주세요."
                  onChange={(value) => setProductTypeNum(value)}
                  options={productTypeOptions}
                />
              </FormFieldAntd>
              <Typography.Text strong>productTypeNum : {productTypeNum}</Typography.Text>
            </>
          )}
        </Space>
      </Form>
    </Modal>
  );
};
</file>

