): BrandProductVariantManageEventListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => filterVariables.type, null),
    },
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
    onlyReasonExist: {
      active: maybe(() => !utils.isEmpty(filterVariables.onlyReasonExist, true), false),
      value: maybe(() => filterVariables.onlyReasonExist, true),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: maybe(() => filterVariables.brandProductSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: BrandProductVariantManageEventListViewUrlFilters
): BrandProductVariantManageEventFilterInput {
  return {
    created: getGteLteVariables({ gte: params.createdFrom, lte: params.createdTo }),
    type: params.type !== undefined ? findValueInEnum(params.type, BrandProductVariantManageEventTypeEnum) : null,
    title: params.title !== undefined ? params.title : null,
    onlyReasonExist: params.onlyReasonExist !== undefined ? parseBoolean(params.onlyReasonExist, true) : true,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    brandProductSearch: params.brandProductSearch !== undefined ? params.brandProductSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<BrandProductVariantManageEventListFilterKeys>
): BrandProductVariantManageEventListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case BrandProductVariantManageEventListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        BrandProductVariantManageEventListViewUrlFiltersEnum.createdFrom,
        BrandProductVariantManageEventListViewUrlFiltersEnum.createdTo
      );
    case BrandProductVariantManageEventListFilterKeys.type:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.type);
    case BrandProductVariantManageEventListFilterKeys.title:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.title);
    case BrandProductVariantManageEventListFilterKeys.onlyReasonExist:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.onlyReasonExist);
    case BrandProductVariantManageEventListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.brandSearch);
    case BrandProductVariantManageEventListFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.brandProductSearch);
    case BrandProductVariantManageEventListFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.vendorSearch);
    case BrandProductVariantManageEventListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, BrandProductVariantManageEventListViewUrlFiltersEnum.userSearch);
  }
