import makeQuery from "@hooks/makeQuery";
import { staffMemberDetailsFragment, staffMemberFragment } from "@src/api/fragments/staff";
import gql from "graphql-tag";

import { StaffList, StaffListVariables } from "./types/StaffList";
import { StaffListForAssign, StaffListForAssignVariables } from "./types/StaffListForAssign";
import { StaffMemberDetails, StaffMemberDetailsVariables } from "./types/StaffMemberDetails";
import { StaffMemberDetailsForHq } from "./types/StaffMemberDetailsForHq";

export const staffListQuery = gql`
  ${staffMemberFragment}
  query StaffList(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: StaffUserFilterInput
    $sort: UserSortingInput
  ) {
    staffUsers(before: $before, after: $after, first: $first, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        cursor
        node {
          ...StaffMemberFragment
          avatar(size: 48) {
            url
          }
        }
      }
      pageInfo {
        hasPreviousPage
        hasNextPage
        startCursor
        endCursor
      }
    }
  }
`;
export const useStaffListQuery = makeQuery<StaffList, StaffListVariables>(staffListQuery);

export const staffListForAssignQuery = gql`
  query StaffListForAssign(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: StaffUserFilterInput
    $sort: UserSortingInput
  ) {
    staffUsers(before: $before, after: $after, first: $first, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        cursor
        node {
          id
          firstName
          email
        }
      }
      pageInfo {
        hasPreviousPage
        hasNextPage
        startCursor
        endCursor
      }
    }
  }
`;
export const useStaffListForAssignQuery = makeQuery<StaffListForAssign, StaffListForAssignVariables>(
  staffListForAssignQuery
);

export const staffMemberDetailsQuery = gql`
  ${staffMemberDetailsFragment}
  query StaffMemberDetails($id: ID!) {
    user(id: $id) {
      ...StaffMemberDetailsFragment
    }
  }
`;

export const useStaffMemberDetailsQuery = makeQuery<StaffMemberDetails, StaffMemberDetailsVariables>(
  staffMemberDetailsQuery
);

export const staffMemberDetailsForHqQuery = gql`
  ${staffMemberDetailsFragment}
  query StaffMemberDetailsForHq {
    me {
      ...StaffMemberDetailsFragment
    }
  }
`;
export const useStaffMemberDetailsForHqQuery = makeQuery<StaffMemberDetailsForHq, {}>(staffMemberDetailsForHqQuery);
