import { FormChange } from "@hooks/useForm";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import { Form, Input, Radio, Table } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { FromBossNotices_fromBossNotices_edges_node } from "../../../notices/api/types/FromBossNotices";
import { bossToHqNoticeDetailsViewUrl } from "../../../notices/urls";

interface FromBossNoticeSelectForPopupProps {
  fromBossNoticeList: FromBossNotices_fromBossNotices_edges_node[];
  onChange: FormChange;
  notice?: string;
}

const FromBossNoticeSelectForPopup: React.FC<FromBossNoticeSelectForPopupProps> = (props) => {
  const { fromBossNoticeList, onChange, notice = "" } = props;
  const [search, setSearch] = React.useState<string>("");
  const [searchList, setSearchList] = React.useState<FromBossNotices_fromBossNotices_edges_node[]>([]);

  const columns: ColumnsType<FromBossNotices_fromBossNotices_edges_node> = [
    {
      title: "",
      key: "id",
      width: 50,
      render: (_, record) => (
        <Radio
          value={record.id}
          onChange={(e) => {
            onChange({
              target: { name: "notice", value: e.target.value },
            });
            const linkUrl = bossToHqNoticeDetailsViewUrl(e.target.value);
            const sliceLinkUrl = linkUrl[linkUrl.length - 1] === "?" ? linkUrl.slice(0, linkUrl.length - 1) : linkUrl;
            onChange({
              target: { name: "linkUrl", value: sliceLinkUrl },
            });
          }}
        />
      ),
    },
    {
      title: "제목",
      key: "title",
      render: (_, record) => record.title,
    },
    {
      title: "게시일",
      key: "createdAt",
      align: "center",
      render: (_, record) => getDateByFormat(record.createdAt),
    },
  ];

  const handleSearch = (e) => {
    const value = e.target.value;
    setSearch(value);

    if (value.trim() === "") {
      setSearchList(fromBossNoticeList);
    } else {
      const filterList = fromBossNoticeList.filter((notice) => notice.title.indexOf(value) !== -1);
      setSearchList(filterList);
    }
  };

  return (
    <Radio.Group name="noticeId" defaultValue={notice}>
      <Form.Item label="공지사항 검색" rules={[{ required: true }]} style={{ marginTop: 5, marginBottom: 5 }}>
        <Input onChange={handleSearch} value={search} />
      </Form.Item>
      <Table
        {...commonTableProps}
        columns={columns}
        dataSource={search ? searchList : fromBossNoticeList}
        scroll={{ y: 400 }}
      />
    </Radio.Group>
  );
};

export default FromBossNoticeSelectForPopup;
</file>

