import { User } from "@src/api/fragments/types/User";
import { BsTrainingTagInput } from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { removeEdgeFromListCache } from "@src/app/providers/ApolloClientProvider/utils";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Form, Modal, Table, Typography } from "antd";
import React, { useState } from "react";

import { useBsTrainingTagDeleteMutation, useBsTrainingTagUpdateMutation } from "../../api/mutations";
import { bsTrainingTagListQuery } from "../../api/queries";
import {
  BsTrainingTagList,
  BsTrainingTagList_bsTrainingTagList_edges,
  BsTrainingTagList_bsTrainingTagList_edges_node,
} from "../../api/types/BsTrainingTagList";
import { BsTrainingTagSimpleBrandList_brands_edges_node } from "../../api/types/BsTrainingTagSimpleBrandList";
import { TrainingDocListViewRouteParams } from "../../urls";
import { convertFilterBsTrainingDocType } from "../../views/HqTrainingDocListView/utils";
import HqTrainingTagCreateForm from "./HqTrainingTagCreateForm";
import { getHqTrainingTagTableSettings } from "./HqTrainingTagTableSettings";

interface HqTrainingDocTagModalProps {
  open: boolean;
  onClose: () => void;
  menuType: TrainingDocListViewRouteParams["menuType"];
  brandList: BsTrainingTagSimpleBrandList_brands_edges_node[];
  tagListData: BsTrainingTagList_bsTrainingTagList_edges_node[];
  loading: boolean;
  user: User;
  setBrandId: React.Dispatch<React.SetStateAction<string>>;
}

const HqTrainingDocTagModal: React.FC<HqTrainingDocTagModalProps> = (props) => {
  const { open, onClose, menuType, tagListData, brandList, user, setBrandId } = props;
  const { isHqStaff } = user;
  const [selectedRowId, setSelectedRowId] = useState<string>("");
  const [form] = Form.useForm();
  const onCloseModal = () => {
    onClose();
    form.resetFields();
  };

  const resetFormField = () => {
    form.setFieldsValue({
      updateTagName: "",
      name: "",
    });
    setSelectedRowId(undefined);
  };
  const setEditableRow = (record: BsTrainingTagList_bsTrainingTagList_edges_node) => {
    form.setFields([
      {
        name: "updateTagName",
        value: record.name,
      },
    ]);
    setSelectedRowId(record.id);
  };

  const isEditing = (record: BsTrainingTagList_bsTrainingTagList_edges_node) => record.id === selectedRowId;
  const onEdit = (record: BsTrainingTagList_bsTrainingTagList_edges_node) => setEditableRow(record);
  const onCancel = () => resetFormField();

  const [bsTrainingTagUpdate, bsTrainingTagUpdateOpts] = useBsTrainingTagUpdateMutation({
    onCompleted: (data) => {
      const errors = data.bsTrainingTagUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("태그가 수정되었습니다.");
        onCancel();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  const [bsTrainingTagDelete, bsTrainingTagDeleteOpts] = useBsTrainingTagDeleteMutation({
    onCompleted: (data) => {
      const errors = data.bsTrainingTagDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("태그가 삭제되었습니다.");
        onCancel();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  const onSubmit = async (record: BsTrainingTagList_bsTrainingTagList_edges_node) => {
    const inputForm = form.getFieldsValue();
    const { updateTagName } = inputForm;
    const ownerBrand = isHqStaff ? user.brand.id : form.getFieldValue("ownerBrand");
    if (utils.isEmpty(ownerBrand)) {
      showNotificationError("브랜드를 선택해주세요.");
      return;
    }
    if (utils.isEmpty(updateTagName)) {
      showNotificationError("태그명은 1글자 이상이어야 합니다.");
      return;
    }
    const input: BsTrainingTagInput = {
      name: updateTagName,
      type: convertFilterBsTrainingDocType(menuType),
      ownerBrand,
    };
    bsTrainingTagUpdate({
      variables: { id: selectedRowId, input },
    });
  };
  const onDelete = async (record: BsTrainingTagList_bsTrainingTagList_edges_node) => {
    bsTrainingTagDelete({
      variables: { id: record.id },
      update: (cache) => {
        removeEdgeFromListCache<BsTrainingTagList, BsTrainingTagList_bsTrainingTagList_edges>({
          cache,
          query: bsTrainingTagListQuery,
          edgeField: "bsTrainingTagList",
          schemaName: "bsTrainingTagList",
          nodeId: record.id,
        });
      },
    });
  };

  const columns = getHqTrainingTagTableSettings({
    editingProps: {
      loading: bsTrainingTagUpdateOpts.loading || bsTrainingTagDeleteOpts.loading,
      selectedSalesId: selectedRowId,
      isEditing,
      onEdit,
      onCancel,
      onSubmit,
      onDelete,
    },
  });

  return (
    <Modal
      open={open}
      title={<Typography.Title level={4}>태그 관리</Typography.Title>}
      footer={<Button onClick={onCloseModal}>닫기</Button>}
      maskClosable={false}
    >
      <Form form={form} component={false}>
        <Card>
          <HqTrainingTagCreateForm
            form={form}
            menuType={menuType}
            brandList={brandList}
            user={user}
            setBrandId={setBrandId}
          />
          <Table
            {...commonTableProps}
            columns={columns}
            dataSource={tagListData}
            rowKey={(record) => record.id}
            loading={props.loading}
            pagination={false}
            components={{ body: { cell: EditableCell } }}
          />
        </Card>
      </Form>
    </Modal>
  );
};

export default HqTrainingDocTagModal;
</file>

