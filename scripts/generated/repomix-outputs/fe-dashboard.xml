import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Descriptions, Space, Typography } from "antd";
import React from "react";

import {
  MonthlyStockSnapshots,
  MonthlyStockSnapshots_monthlyStockSnapshots_edges_node,
  MonthlyStockSnapshotsVariables,
} from "../../api/types/MonthlyStockSnapshots";
import { MonthlyStockSnapshotsViewUrlQueryParams } from "../../urls";
import { createFilterStructure, MonthlyStockSnapshotsFilterKeys, MonthlyStockSnapshotsFilterOpts } from "./filter";
import MonthlyStockSnapshotsTableSettings from "./MonthlyStockSnapshotsTableSettings";

interface MonthlyStockSnapshotsPageProps
  extends PaginateListProps,
    FilterPageProps<MonthlyStockSnapshotsFilterKeys, MonthlyStockSnapshotsFilterOpts> {
  queryVariablesWithoutPagination: MonthlyStockSnapshotsVariables;
  fetchForDownload: (variables?: MonthlyStockSnapshotsVariables) => Promise<ApolloQueryResult<MonthlyStockSnapshots>>;
  snapshots: MonthlyStockSnapshots_monthlyStockSnapshots_edges_node[];
  // onFilterChange: (filter: IFilter<string>) => void;
  params: MonthlyStockSnapshotsViewUrlQueryParams;
}

const MonthlyStockSnapshotsPage: React.FC<MonthlyStockSnapshotsPageProps> = (props) => {
  const {
    params,
    disabled,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    onUpdateListSettings,
    fetchForDownload,
    snapshots,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const [showToBeChangedInfoData, setShowToBeChangedInfoData] =
    React.useState<MonthlyStockSnapshots_monthlyStockSnapshots_edges_node>(null);
  const { stoppedReasonChoices } = useShop();
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const columns = MonthlyStockSnapshotsTableSettings({ params, stoppedReasonChoices, setShowToBeChangedInfoData });

  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);

  const handleSave = (columns) => onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "monthlyStockSnapshots",
    isMultiLevel: true,
  };

  return (
    <Space direction="vertical" size={24}>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          onFilterChange={onFilterChange}
          filterStructure={filterStructure}
          tabExtra={
            <Space>
              <ColumnPicker
                columns={pickColumns}
                loading={disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </Space>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={disabled}
          columns={pickerSelectedColumns}
          dataSource={snapshots}
          footer={() => <TableListFooter {...props} />}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
        />
      </Card>
      <ConfirmModal
        modalTitleText={"특이 사항"}
        titleText={null}
        helpText={null}
        visible={!!showToBeChangedInfoData}
        contentNode={
          <>
            {showToBeChangedInfoData && (
              <>
                <Descriptions column={2}>
                  <Descriptions.Item label="제품코드">{showToBeChangedInfoData.sku}</Descriptions.Item>
                  <Descriptions.Item label="등록일">
                    {getDateByFormat(showToBeChangedInfoData.toBeChangedInfoCreatedAt, onlyDateFormat)}
                  </Descriptions.Item>
                </Descriptions>
                <Typography.Text strong>세부 정보</Typography.Text>
                <Typography.Text>{showToBeChangedInfoData.toBeChangedInfoDetail}</Typography.Text>
              </>
            )}
          </>
        }
        onOk={null}
        onCancel={() => setShowToBeChangedInfoData(null)}
        width={600}
        isContentNodeDivider={false}
        noFooterMode={true}
      />
    </Space>
  );
};

export default MonthlyStockSnapshotsPage;
</file>

