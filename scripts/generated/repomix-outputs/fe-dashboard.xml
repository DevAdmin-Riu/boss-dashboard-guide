import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useState } from "react";

import { useOrderLineBulkChangeExcludeSalesAvgStatsMutation } from "../../api/mutations";
import { OrderList } from "../../api/types/OrderList";
import {
  checkOrderedByStaffForBadStock,
  checkOrderedByStaffForBrand,
  checkOrderedByStaffForEtc,
  checkOrderedByUser,
} from "../../utils";
import { OrderCreateByStaffModal } from "../OrderCreateByStaffModal";
import { createFilterStructure, OrderLineDetailFilterKeys, OrderLineDetailListFilterOpts } from "./filters";
import { OrderLineDetailListTableSettingsIncludeVat } from "./OrderLineDetailListTableSettings";

export interface OrderLineDetailListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderLineDetailFilterKeys, OrderLineDetailListFilterOpts> {
  orderType: OrderType;
  orderLines: HqOrderLineList_orderLines_edges_node[];
  isAll: boolean;
  queryVariablesWithoutPagination: HqOrderLineListVariables;
  fetchForDownload: (variables?: Partial<HqOrderLineListVariables>) => Promise<ApolloQueryResult<HqOrderLineList>>;
  createAdminOrderButtonClick: () => void;
}

enum OrderListModalModeEnum {
  CreateOrderByStaff = "CreateOrderByStaff",
  ExcludeSalesAvgStatsChange = "ExcludeSalesAvgStatsChange",
}

const OrderLineDetailListPage: React.FC<OrderLineDetailListPageProps> = (props) => {
  const {
    orderType,
    currencySymbol,
    currentTab,
    filterOpts,
    tabs,
    queryVariablesWithoutPagination,
    isAll,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    fetchForDownload,
    createAdminOrderButtonClick,
    ...listProps
  } = props;
  const orderLineList = listProps.orderLines;
  const columns = OrderLineDetailListTableSettingsIncludeVat(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps?.settings?.columns
  );
  const handleSave = (columns: any) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const filterStructure = createFilterStructure(filterOpts, orderType, isAll);
  const isOrderedByUser = checkOrderedByUser(orderType);
  const isOrderedByStaffForBrand = checkOrderedByStaffForBrand(orderType);
  const isOrderedByStaffForBadStock = checkOrderedByStaffForBadStock(orderType);
  const isOrderedByStaffForEtc = checkOrderedByStaffForEtc(orderType);
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [modalMode, setModalMode] = useState<OrderListModalModeEnum>(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [changeExcludeStatsMutation, { loading: excludeStatsLoading }] =
    useOrderLineBulkChangeExcludeSalesAvgStatsMutation({
      onCompleted: (data) => {
        const errors = data.orderLineBulkChangeExcludeSalesAvgStats?.errors;
        if (errors?.length === 0) {
          showNotificationSuccess("수요 예측 상태가 변경되었습니다.");
          setSelectedRowIds([]);
        } else {
          showGqlErrors(errors);
        }
      },
    });

  const handleExcludeStatsConfirm = async () => {
    const filterOrderLineList = orderLineList.filter((item) => selectedRowIds.includes(item.id));
    if (filterOrderLineList.length === 0) {
      showNotificationWarn("선택된 주문 항목이 없습니다.");
      return;
    }

    const excludeStatsValue = filterOrderLineList[0].excludeStockAvgStats;
    await changeExcludeStatsMutation({
      variables: {
        ids: selectedRowIds,
        excludeStockAvgStats: !excludeStatsValue,
      },
    });
    resetForCloseModal();
  };

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const rowSelection: TableRowSelection<HqOrderLineList_orderLines_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys) => {
      // 전체 선택 감지 (선택 가능한 모든 항목이 선택된 경우)
      const selectableItems = orderLineList.filter((item) => item.trackInventory !== false);
      const isSelectAll = selectedRowKeys.length === selectableItems.length && selectableItems.length > 0;

      if (isSelectAll) {
        // 첫 번째 선택 가능한 항목의 excludeStockAvgStats 상태 확인
        const firstExcludeStatus = selectableItems[0]?.excludeStockAvgStats;

        // 다른 상태의 항목이 있는지 확인
        const hasConflict = selectableItems.some((item) => item.excludeStockAvgStats !== firstExcludeStatus);

        if (hasConflict) {
          showNotificationWarn("같은 수요 예측 상태인 항목들만 선택할 수 있습니다.");
          // 아무것도 선택하지 않음
          setSelectedRowIds([]);
          return;
        }
      } else if (selectedRowIds.length > 0 && selectedRowKeys.length > selectedRowIds.length) {
        // 개별 선택 시 기존 로직
        const firstSelectedItem = orderLineList.find((item) => item.id === selectedRowIds[0]);
        const firstExcludeStatus = firstSelectedItem?.excludeStockAvgStats;

        const newSelectedKeys = selectedRowKeys.filter((key) => !selectedRowIds.includes(key as string));
        const hasConflict = newSelectedKeys.some((key) => {
          const item = orderLineList.find((item) => item.id === key);
          return item?.excludeStockAvgStats !== firstExcludeStatus;
        });

        if (hasConflict) {
          showNotificationWarn("같은 수요 예측 제외 상태인 항목들만 선택할 수 있습니다.");
          return;
        }
      }

      setSelectedRowIds(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record) => ({
      disabled: record.trackInventory === false, // 위탁 상품은 선택 불가
    }),
  };

  const sectionName = isAll
    ? sectionNames.allOrderLines
    : makeNameByOrderType(orderType, sectionNames.orderLineDetails, false, false);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "orderLines",
  };

  const loading = listProps.disabled || excludeStatsLoading;

  const makeExtraUi = () => (
    <Space direction="horizontal" size={8}>
      {!isOrderedByUser && (
        <>
          <Button
            type="primary"
            shape="round"
            icon={<ArrowRightOutlined />}
            onClick={() => createAdminOrderButtonClick()}
          >
            개별 주문 생성
          </Button>
          <Button
            type="primary"
            shape="round"
            icon={<UploadOutlined />}
            onClick={() => setModalMode(OrderListModalModeEnum.CreateOrderByStaff)}
          >
            일괄 주문 생성
          </Button>
          <Button
            type={"default"}
            shape={"round"}
            icon={<DownloadOutlined />}
            href={
              (isOrderedByStaffForBrand && `${s3TemplateUrl}/staff_create_order_for_brand.xlsx`) ||
              (isOrderedByStaffForBadStock && `${s3TemplateUrl}/staff_create_order_for_open_mall.xlsx`) ||
              (isOrderedByStaffForEtc && `${s3TemplateUrl}/staff_create_order_for_etc.xlsx`)
            }
            target="_blank"
          >
            {makeNameByOrderType(orderType, "주문 양식", false, false)}
          </Button>
        </>
      )}
      {isAll && (
        <Button
          onClick={() => setModalMode(OrderListModalModeEnum.ExcludeSalesAvgStatsChange)}
          disabled={selectedRowIds.length === 0 || loading}
          type="primary"
          shape="round"
        >
          수요 예측 상태 변경
        </Button>
      )}
    </Space>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionName}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>
      <Card>
        <SpreadFilterBar<string, HqOrderLineListVariables, OrderList, HqOrderLineList_orderLines_edges_node>
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={true} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={loading}
          columns={pickerSelectedColumns}
          dataSource={orderLineList}
          rowSelection={isAll && rowSelection}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
        <OrderCreateByStaffModal
          open={modalMode === OrderListModalModeEnum.CreateOrderByStaff}
          disabled={loading}
          orderType={orderType}
          onClose={resetForCloseModal}
        />
        <ConfirmModal
          visible={modalMode === OrderListModalModeEnum.ExcludeSalesAvgStatsChange}
          onOk={handleExcludeStatsConfirm}
          onCancel={() => {
            if (!excludeStatsLoading) {
              resetForCloseModal();
            }
          }}
          okButtonProps={{ loading: excludeStatsLoading }}
          cancelText="취소"
          modalTitleText="수요 예측 상태 변경"
          maskClosable={false}
          helpText={(() => {
            if (orderLineList?.length === 0) {
              return null;
            }
            const filterOrderLineList = orderLineList.filter((item) => selectedRowIds.includes(item.id));
            const currentExcludeStatus = filterOrderLineList[0]?.excludeStockAvgStats;
            return (
              <>
                선택한 {selectedRowIds.length}개의 주문 항목을{" "}
                <strong>{currentExcludeStatus ? "수요 예측에 포함" : "수요 예측에서 제외"}</strong>
                하시겠습니까?
              </>
            );
          })()}
        />
      </Card>
    </Space>
  );
};
export default OrderLineDetailListPage;
</file>

<file path="src/app/views/order/orders/components/OrderLineDetailListPage/OrderLineDetailListTableSettings.tsx">
import { transformPaymentStatus } from "@assets/messages/status";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import StatusLabel from "@src/app/components/StatusLabel";
import { DateTime, getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { HqOrderLineList_orderLines_edges_node } from "@src/app/views/hqStaff/hqSection/api/types/HqOrderLineList";
import {
  checkOrderedByStaffForEtc,
  convertOrderTypeToWord,
  makePaymentMethodString,
} from "@src/app/views/order/orders/utils";
import { calcOrderLineTotalPrice } from "@utils/misc";
import { makeFulfillmentTypeText } from "@utils/tags";
import { Tag, Typography } from "antd";
import React from "react";

import { OrderLineDetailListPageProps } from "./OrderLineDetailListPage";

export function OrderLineDetailListTableSettingsIncludeVat(props: OrderLineDetailListPageProps) {
  const { onRowClick, orderType } = props;

  const isOrderedByStaffForEtc = checkOrderedByStaffForEtc(orderType);

  const orderComposedIdColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_COMPOSED_ID,
    align: "center",
    key: "orderComposedId",
    width: 100,
    render: (_, record) => (
      <Typography.Link onClick={() => onRowClick(record.order.id)}>{record.order.composedIdWithPrefix}</Typography.Link>
    ),
    renderExcel: (record) => record.order.composedIdWithPrefix,
  };
  const orderLineComposedIdColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
    align: "center",
    key: "orderLineComposedId",
    width: 120,
    render: (_, record) => record.composedIdWithPrefix,
  };
  const orderCreatedColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_DATE,
    key: "orderCreated",
    align: "center",
    width: 120,
    render: (_, record) => <DateTime date={record.order.created} />,
    renderExcel: (record) => getDateByFormat(record.order.created),
  };
  const orderCapturedAtColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.CAPTURED_DATE,
    key: "capturedAt",
    width: 120,
    render: (_, record) => (record.order.capturedAt ? <DateTime date={record.order.capturedAt} /> : "-"),
    renderExcel: (record) => record.order.capturedAt || "-",
  };
  const orderTypeColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_TYPE,
    key: "orderType",
    width: 100,
    render: (_, record) => <Typography>{convertOrderTypeToWord(record.order.type)}</Typography>,
    renderExcel: (record) => convertOrderTypeToWord(record.order.type),
  };

  const loginIdColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.user.ID,
    key: "userLoginId",
    width: 120,
    render: (_, record) => (record.order.user?.loginId ? record.order.user.loginId : "-"),
  };
  const firstNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.user.USER_NAME,
    key: "firstName",
    width: 200,
    render: (_, record) => record.order.user?.firstName || "-",
  };
  const brandCodeColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brand.BRAND_CODE,
    key: "brandCode",
    width: 120,
    render: (_, record) => record.order.user?.brand?.code || "-",
  };
  const brandNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brand.BRAND_NAME,
    key: "brandName",
    width: 200,
    render: (_, record) => record.order.user?.brand?.name || "-",
  };
  const brandStoreCodeColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brandStore.BRAND_STORE_CODE,
    key: "brandStoreCode",
    width: 120,
    render: (_, record) => record.order.user?.brandStoreUser?.brandStore?.code ?? "-",
  };

  const brandStoreNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brandStore.BRAND_STORE_NAME,
    key: "brandStoreName",
    width: 150,
    render: (_, record) => record.order.user?.brandStoreUser?.brandStore?.name ?? "-",
  };
  const addressFirstNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.delivery.DELIVERY_NAME,
    key: "addressFirstName",
    width: 100,
    render: (_, record) => record.order?.shippingAddress.firstName,
  };
  const shippingAddressPostalCodeColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: ["배송지", "우편번호"],
    key: "postalCode",
    width: 80,
    render: (_, record) => record?.order?.shippingAddress?.postalCode,
  };
  const shippingAddressStreetAddress1Column: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "left",
    title: columnNameConstant.delivery.DELIVERY_ADDRESS,
    key: "streetAddress1",
    width: 250,
    render: (_, record) => record?.order?.shippingAddress?.streetAddress1,
  };
  const shippingAddressStreetAddress2Column: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "left",
    title: columnNameConstant.delivery.DELIVERY_DETAIL_ADDRESS,
    key: "streetAddress2",
    width: 200,
    render: (_, record) => record?.order?.shippingAddress?.streetAddress2,
  };
  const staffNoteColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.STAFF_NOTE,
    key: "staffNote",
    width: 200,
    render: (_, record) => record.order?.staffNote || "-",
  };

  const productSkuColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "left",
    title: columnNameConstant.product.SKU,
    key: "productSku",
    width: 120,
    render: (_, record) => record.productSku,
  };
  const productNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "left",
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "productName",
    width: 200,
    render: (_, record) => record.productName,
  };
  const productUnitPriceGrossAmountColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: !isOrderedByStaffForEtc
      ? columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE
      : columnNameConstant.product.VENDOR_COST_PRICE(false),
    key: "unitPriceGrossAmount",
    width: 100,
    render: (_, record) => <NumberComponent value={record.unitPriceGrossAmount} />,
    renderExcel: (record) => record.unitPriceGrossAmount,
  };
  const productQuantityColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: columnNameConstant.orderLine.ORDER_QTY,
    key: "orderedOrFulfillQty",
    width: 80,
    render: (_, record) => <NumberComponent value={record.orderedOrFulfillQty} />,
    renderExcel: (record) => record.orderedOrFulfillQty,
  };
  const productFulfilledQuantityColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: columnNameConstant.orderLine.FULFILLED_QTY,
    key: "quantityFulfilled",
    width: 80,
    render: (_, record) => <NumberComponent value={record.quantityFulfilled} />,
    renderExcel: (record) => record.quantityFulfilled,
  };
  const productRefundedQuantityColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: columnNameConstant.orderLine.REFUNDED_QTY,
    key: "quantityRefunded",
    width: 80,
    render: (_, record) => <NumberComponent value={record.quantityRefunded} />,
    renderExcel: (record) => record.quantityRefunded,
  };

  const paymentStatusColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.PAYMENT_STATUS,
    key: "paymentStatus",
    width: 120,
    render: (_, record) => {
      const paymentStatus = transformPaymentStatus(record.order);
      return <StatusLabel useSmallDot status={paymentStatus.status} label={paymentStatus.localized} />;
    },
    renderExcel: (record) => transformPaymentStatus(record.order).localized,
  };
  const paymentMethodColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.common.PAYMENT_METHOD,
    key: "paymentMethod",
    width: 120,
    render: (_, record) => makePaymentMethodString(record.order),
  };
  const orderLineTotalPriceColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "right",
    title: columnNameConstant.orderLine.BRAND_PRODUCT_TOTAL_PRICE,
    key: "orderLineTotalPrice",
    width: 100,
    render: (_, record) => <NumberComponent value={calcOrderLineTotalPrice(record)} />,
    renderExcel: (record) => calcOrderLineTotalPrice(record),
  };

  const fulfillmentTypeColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.FULFILLMENT_TYPE,
    key: "fulfillmentType",
    width: 100,
    render: (_, record) => makeFulfillmentTypeText(record.trackInventory, record.variant.isVendorTrackInventory),
  };

  const excludeStockAvgStatsColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.EXCLUDE_STOCK_AVG_STATS,
    key: "excludeStockAvgStats",
    width: 100,
    render: (_, record) => {
      if (record.trackInventory === false) {
        return "-";
      }
      if (record.excludeStockAvgStats) {
        return <Tag color="red">제외</Tag>;
      }
      return <Tag color="green">포함</Tag>;
    },
    renderExcel: (record) => {
      if (record.trackInventory === false) {
        return "-";
      }
      if (record.excludeStockAvgStats) {
        return "제외";
      }
      return "포함";
    },
  };

  const childrenForOrder = [
    orderComposedIdColumn,
    orderLineComposedIdColumn,
    props.isAll && orderTypeColumn,
    orderCreatedColumn,
    !isOrderedByStaffForEtc && orderCapturedAtColumn,
  ].filter(Boolean);

  const childrenForUser = [
    !isOrderedByStaffForEtc && brandCodeColumn,
    !isOrderedByStaffForEtc && brandNameColumn,
    !isOrderedByStaffForEtc && brandStoreCodeColumn,
    !isOrderedByStaffForEtc && brandStoreNameColumn,
    !isOrderedByStaffForEtc && loginIdColumn,
    !isOrderedByStaffForEtc && firstNameColumn,
    isOrderedByStaffForEtc && addressFirstNameColumn,
    isOrderedByStaffForEtc && shippingAddressPostalCodeColumn,
    isOrderedByStaffForEtc && shippingAddressStreetAddress1Column,
    isOrderedByStaffForEtc && shippingAddressStreetAddress2Column,
    isOrderedByStaffForEtc && staffNoteColumn,
  ].filter(Boolean);
  const childrenForProduct = [
    productSkuColumn,
    productNameColumn,
    productUnitPriceGrossAmountColumn,
    productQuantityColumn,
    isOrderedByStaffForEtc && orderLineTotalPriceColumn,
    !isOrderedByStaffForEtc && productFulfilledQuantityColumn,
    !isOrderedByStaffForEtc && productRefundedQuantityColumn,
    props.isAll && fulfillmentTypeColumn,
    props.isAll && excludeStockAvgStatsColumn,
  ].filter(Boolean);
  const childrenForPayment = [paymentStatusColumn, paymentMethodColumn, orderLineTotalPriceColumn];
  const columns: DownloadableColumnsType<HqOrderLineList_orderLines_edges_node> = [
    { title: "주문 정보", children: childrenForOrder },
    { title: "주문자 정보", children: childrenForUser },
    { title: "상품 정보", children: childrenForProduct },
    !isOrderedByStaffForEtc && { title: "결제 정보", children: childrenForPayment },
  ].filter(Boolean);
  return columns;
}
</file>

<file path="src/app/views/order/orders/components/OrderLineListPage/filters.ts">
import filterMsg from "@assets/messages/filters";
import {
  OrderLineB2bStatusEnum,
  OrderStatusFilter,
  OrderTypeEnum,
  PurchaseOrderEventTypeFilter,
  VendorContactTypeEnum,
} from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { purchaseOrderLineEventTypeEnumChoices } from "@src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineListPage/filters";
import { vendorContactTypeChoices } from "@src/app/views/purchase/vendors/utils";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { OrderLineListViewUrlQueryParams } from "../../urls";
import { defaultPoEventTypeListForFulfillOrderLineList } from "../../utils";
import { checkIsListActionForFulfill, checkIsListActionForPurchase, checkIsListViewFulfilledByVendor } from "./utils";

export enum OrderLineListFilterKeys {
  orderStatus = "orderStatus",
  isByNonCourier = "isByNonCourier",
  b2bOrderSearch = "b2bOrderSearch",
  orderCreated = "orderCreated",
  orderCapturedAt = "orderCapturedAt",
  purchaseOrderDate = "purchaseOrderDate",
  askingPurchaseDate = "askingPurchaseDate",
  expectedPurchaseDate = "expectedPurchaseDate",
  fulfillmentCreated = "fulfillmentCreated",
