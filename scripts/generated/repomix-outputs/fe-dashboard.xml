<file path="src/app/views/hqStaff/hqSection/components/HqInfoProductPage/utils.ts">
import { StockStatusByEstShortageEnum } from "@src/api/types/globalTypes";
import { calcTotalExcludeVatByUnitExcludeVatAndQty, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformStockStatusByEstShortageEnum } from "@utils/misc";

import { BpvListForHq_brandProductVariants_edges_node } from "../../api/types/BpvListForHq";
import { HqInfoProductListItem, isBpBundle } from "./types";

export const getProductName = (item: HqInfoProductListItem): string => {
  if (isBpBundle(item)) {
    return item.name || "";
  }
  return item.brandProduct?.name || "";
};

export const makeBrandPriceExcludeVat = (record: HqInfoProductListItem): number => {
  const value = (record.costPriceExcludeVat || 0) + toPriceExcludeVat(record.deliveryFeeAmount);
  return value;
};

export const makeTotalStockQuantity = (record: BpvListForHq_brandProductVariants_edges_node): number =>
  record.productVariant?.stocks?.reduce((acc, stock) => acc + stock.quantity, 0) || 0;

export const makeTotalStockCostExcludeVat = (record: BpvListForHq_brandProductVariants_edges_node): number => {
  const totalStockQuantity = makeTotalStockQuantity(record);
  const isTaxFree = record.productVariant.product.isTaxFree;
  const brandPriceExcludeVat = makeBrandPriceExcludeVat(record);
  const value = calcTotalExcludeVatByUnitExcludeVatAndQty(brandPriceExcludeVat, totalStockQuantity, isTaxFree);
  return value;
};

export const makeEstShortagePeriod = (record: BpvListForHq_brandProductVariants_edges_node): number | string => {
  const value = record?.productVariant?.estShortageInfo?.estShortagePeriod;
  return value;
};

export const makeCriticalStockStatus = (stockStatus: StockStatusByEstShortageEnum, isHqMode: boolean) => {
  const text = transformStockStatusByEstShortageEnum(stockStatus, isHqMode);
  return text;
};
</file>

