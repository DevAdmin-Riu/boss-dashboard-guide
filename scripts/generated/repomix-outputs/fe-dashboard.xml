import { DownloadOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getDatesBetween, onlyDateFormat } from "@src/app/providers/DateProvider";
import { useBrandListForSalesStatsLazyQuery } from "@src/app/views/brand/brands/api/queries";
import { BrandListForSalesStats_brands_edges_node } from "@src/app/views/brand/brands/api/types/BrandListForSalesStats";
import { DownloadSalesByBrandModal } from "@src/app/views/order/orders/components/DownloadSalesDetailsModal/DownloadSalesByBrandModal";
import { FilterPageProps, ListSettings } from "@src/global/core/types/types";
import { excelDownload, generateExcelDownloadData } from "@utils/excel/excelDownload";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import moment from "moment";
import React, { useEffect, useState } from "react";

import { useSalesStatListLazyQuery } from "../../api/queries";
import { SalesStatList_salesStats, SalesStatListVariables } from "../../api/types/SalesStatList";
import { SalesStatListViewUrlQueryParams } from "../../urls";
import { getSalesStatsSum } from "../../utils";
import { SalesStatListFilterVariables, SalesStatShowColumnType } from "../../views/SalesStatListView/filters";
import { createFilterStructure, SalesStatFilterKeys, SalesStatListFilterOpts } from "./filters";
import { getSalesStatListTableSettings, getSalesStatTableSummary } from "./SalesStatListTableSettings";

export interface SalesStatListPageProps extends FilterPageProps<SalesStatFilterKeys, SalesStatListFilterOpts> {
  params: SalesStatListViewUrlQueryParams;
  filterVariables: SalesStatListFilterVariables;
  bossMarketId: string;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  settings: ListSettings<string>;
}

export interface SalesStatDataSourceProps {
  brand: BrandListForSalesStats_brands_edges_node;
  stats: {
    total: SalesStatList_salesStats[];
    exclusive: SalesStatList_salesStats[];
    packaging: SalesStatList_salesStats[];
    food: SalesStatList_salesStats[];
    equipment: SalesStatList_salesStats[];
  };
  statsSum: {
    total: SalesStatList_salesStats;
    exclusive: SalesStatList_salesStats;
    packaging: SalesStatList_salesStats;
    food: SalesStatList_salesStats;
    equipment: SalesStatList_salesStats;
  };
}

enum SalesStatListModalModeEnum {
  PrintSalesByBrand = "PrintSalesByBrand",
}

export const SalesStatListPage: React.FC<SalesStatListPageProps> = (props) => {
  const {
    params,
    filterVariables,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);
  const [dataSource, setDataSource] = useState<SalesStatDataSourceProps[]>([]);
  const [modalMode, setModalMode] = useState<SalesStatListModalModeEnum>(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [brandListRefetch, { loading: brandListLoading }] = useBrandListForSalesStatsLazyQuery();
  const [salesStatListRefetch, { loading: salesStatListLoading }] = useSalesStatListLazyQuery();
  const tableLoading = brandListLoading || salesStatListLoading;

  useEffect(() => {
    const refetchDataSource = async () => {
      const { isRunning, statDate: filterStatDate } = filterVariables;
      const { data: brandListData } = await brandListRefetch({
        variables: {
          filter: { brandSearch: params.brandSearch, isRunning, contractType: filterVariables.contractType },
          first: GrapheneRelayConnectionMaxLimitEnum.brands,
        },
      });
      const brandList = brandListData.brands.edges.map((edge) => edge.node);

      const { contractType, ...filterVariablesWithoutContractType } = filterVariables;
      const salesStatListVariables: SalesStatListVariables = {
        ...filterVariablesWithoutContractType,
        brandSearch: params.brandSearch,
      };
      const { data: salesStatListData } = await salesStatListRefetch({ variables: salesStatListVariables });
      const salesStatList = salesStatListData.salesStats;

      const { gte: startDate, lte: endDate } = filterStatDate || { gte: null, lte: null };
      const monthMomentArr = getDatesBetween([moment(startDate), moment(endDate)], "month").dates;

      const newDataSource = brandList.map((brand) => {
        const stats: SalesStatDataSourceProps["stats"] = {
          total: [],
          exclusive: [],
          packaging: [],
          food: [],
          equipment: [],
        };
        const statsByBrandId = salesStatList.filter((stat) => stat.brandGlobalId === brand.id);

        for (const monthMoment of monthMomentArr) {
          const statsByMonth = statsByBrandId.filter((stat) => stat.statDate === monthMoment.format(onlyDateFormat));
          const totalStat = statsByMonth.find((stat) => stat.columnType === SalesStatShowColumnType.TOTAL);
          const exclusiveStat = statsByMonth.find((stat) => stat.columnType === SalesStatShowColumnType.EXCLUSIVE);
          const packagingStat = statsByMonth.find((stat) => stat.columnType === SalesStatShowColumnType.PACKAGING);
          const foodStat = statsByMonth.find((stat) => stat.columnType === SalesStatShowColumnType.FOOD);
          const equipmentStat = statsByMonth.find((stat) => stat.columnType === SalesStatShowColumnType.EQUIPMENT);

          if (utils.isEmpty(totalStat) === false) {
            stats.total.push(totalStat);
          }
          if (utils.isEmpty(exclusiveStat) === false) {
            stats.exclusive.push(exclusiveStat);
          }
          if (utils.isEmpty(packagingStat) === false) {
            stats.packaging.push(packagingStat);
          }
          if (utils.isEmpty(foodStat) === false) {
            stats.food.push(foodStat);
          }
          if (utils.isEmpty(equipmentStat) === false) {
            stats.equipment.push(equipmentStat);
          }
        }

        const statsSum = {
          total: getSalesStatsSum(stats.total),
          exclusive: getSalesStatsSum(stats.exclusive),
          packaging: getSalesStatsSum(stats.packaging),
          food: getSalesStatsSum(stats.food),
          equipment: getSalesStatsSum(stats.equipment),
        };

        const dataToAdd: SalesStatDataSourceProps = { brand, stats, statsSum };
        return dataToAdd;
      });
      setDataSource(newDataSource);
    };

    refetchDataSource();
  }, [params]);

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const makeExtraUi = () => (
    <Space>
      <Button
        type="primary"
        shape="round"
        icon={<DownloadOutlined />}
        loading={printBtnLoading}
        disabled={tableLoading || printBtnLoading}
        onClick={onPrintClick}
      >
        월별 매출 다운로드
      </Button>
      <Button
        type="primary"
        shape="round"
        icon={<DownloadOutlined />}
        loading={printBtnLoading}
        onClick={() => setModalMode(SalesStatListModalModeEnum.PrintSalesByBrand)}
      >
        월별 매출 상세 데이터 다운로드
      </Button>
    </Space>
  );

  const columns = getSalesStatListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const columnKeyList = pickerSelectedColumns.map((item) => item.key).filter((item) => item);

  const onPrintClick = () => {
    setPrintBtnLoading(true);
    showDownloadingMessage();

    try {
      const { columns: columnTypes } = filterVariables;
      if (utils.isEmpty(columnTypes) || Object.values(columnTypes).every((value) => value === false)) {
        showNotificationWarn("출력할 카테고리가 없습니다.");
        return;
      }

      const { header, merges, excelColumns } = generateExcelDownloadData<SalesStatDataSourceProps>(columns, dataSource);
      if (!excelColumns || excelColumns.length <= 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      excelDownload({ title: "월별 매출", columns: excelColumns, header, merges, skipOriginHeader: true });

      showNotificationSuccess(commonMsg.downloadedToXls);
    } catch {
      showNotificationError("에러가 발생하였습니다");
    } finally {
      setPrintBtnLoading(false);
      destroyDownloadingMessage();
    }
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.salesStatByMonth}</Typography.Title>
          </Col>
          <Col>{makeExtraUi()}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={tableLoading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={tableLoading}
            rowKey={(record) => record.brand.id}
            columns={pickerSelectedColumns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            summary={(tableData) => getSalesStatTableSummary(tableData, props, columnKeyList)}
          />
          <DownloadSalesByBrandModal
            open={modalMode === SalesStatListModalModeEnum.PrintSalesByBrand}
            onClose={resetForCloseModal}
          />
        </Card>
      </Space>
    </>
  );
};
</file>

