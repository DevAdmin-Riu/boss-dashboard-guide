      PurchaseOrderLineFilterKeys.expectedPurchaseDate,
      filterMsg.poLineExpectedPurchaseDate,
      opts.expectedPurchaseDate.value
    ),
    active: opts.expectedPurchaseDate.active,
  };
  const askingPurchaseDateFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.askingPurchaseDate,
      filterMsg.poLineAskingPurchaseDate,
      opts.askingPurchaseDate.value
    ),
    active: opts.askingPurchaseDate.active,
  };

  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };

  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.orderSearch,
      "주문번호 / 주문상세번호",
      opts.orderSearch.value
    ),
    active: opts.orderSearch.active,
  };
  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.b2bOrderSearch,
      "주문번호 / 주문상세번호",
      opts.b2bOrderSearch.value
    ),
    active: opts.orderSearch.active,
  };

  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.vendorSearch,
      filterNameConstant.VENDOR_SEARCH,
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };

  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.brandSearch,
      isB2b ? filterNameConstant.BRAND_SEARCH_FOR_B2B : filterNameConstant.BRAND_SEARCH,
      opts.brandSearch.value
    ),
    active: opts.userSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.brandStoreSearch,
      filterNameConstant.BRAND_STORE_SEARCH,
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.userSearch,
      filterNameConstant.USER_SEARCH,
      opts.userSearch.value
    ),
    active: opts.userSearch.active,
  };

  const draftStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.draftStatusAt,
      "발주 작성일",
      opts.draftStatusAt.value
    ),
    active: opts.draftStatusAt.active,
  };
  const pendingStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.pendingStatusAt,
      "접수 대기일",
      opts.pendingStatusAt.value
    ),
    active: opts.pendingStatusAt.active,
  };
  const rejectedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.rejectedStatusAt,
      "거부일",
      opts.rejectedStatusAt.value
    ),
    active: opts.rejectedStatusAt.active,
  };
  const sendRejectedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.sendRejectedStatusAt,
      "거부 건 발송일",
      opts.sendRejectedStatusAt.value
    ),
    active: opts.sendRejectedStatusAt.active,
  };
  const receivedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.receivedStatusAt,
      "접수일",
      opts.receivedStatusAt.value
    ),
    active: opts.receivedStatusAt.active,
  };
  const reqSplitDeliveryStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.reqSplitDeliveryStatusAt,
      "분할납품 요청일",
      opts.reqSplitDeliveryStatusAt.value
    ),
    active: opts.reqSplitDeliveryStatusAt.active,
  };
  const approveReqSplitDeliveryStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.approveReqSplitDeliveryStatusAt,
      "분할납품 요청 승인일",
      opts.approveReqSplitDeliveryStatusAt.value
    ),
    active: opts.approveReqSplitDeliveryStatusAt.active,
  };
  const reqEpdUpdateStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.reqEpdUpdateStatusAt,
      "납품예정일 변경 요청일",
      opts.reqEpdUpdateStatusAt.value
    ),
    active: opts.reqEpdUpdateStatusAt.active,
  };
  const approveReqEpdUpdateStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.approveReqEpdUpdateStatusAt,
      "납품예정일 변경 요청 승인일",
      opts.approveReqEpdUpdateStatusAt.value
    ),
    active: opts.approveReqEpdUpdateStatusAt.active,
  };
  const dispatchFulfillmentStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.dispatchFulfillmentStatusAt,
      "출고지시일",
      opts.dispatchFulfillmentStatusAt.value
    ),
    active: opts.dispatchFulfillmentStatusAt.active,
  };

  const deliveryConfirmedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.deliveryConfirmedStatusAt,
      "배송확정일",
      opts.deliveryConfirmedStatusAt.value
    ),
    active: opts.deliveryConfirmedStatusAt.active,
  };
  const invoicePrintedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.invoicePrintedStatusAt,
