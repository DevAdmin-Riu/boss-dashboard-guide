      isPickerHide: true,
    });
  }

  columns.push({
    title: "합계",
    children: salesStatsSumColumns,
  });

  return columns;
};

export const getSalesStatTableSummary = (
  tableData: readonly SalesStatDataSourceProps[],
  props: SalesStatListPageProps,
  columnKeyList: any[]
) => {
  const { statDate, columns: columnTypes } = props?.filterVariables;
  const copiedTableData: SalesStatDataSourceProps[] = utils.deepCopy(tableData);
  const { gte: startDate, lte: endDate } = statDate || { gte: null, lte: null };
  const startMonth = moment(startDate);
  const endMonth = moment(endDate);
  const monthMomentArr = getDatesBetween([startMonth, endMonth], "month").dates;

  const retNumberElement = [];
  const fixedBrandColumnCnt = getColumnCnt(["code", "name", "bizRegNo", "bizName"], columnKeyList);
  const restBrandColumnCnt = getColumnCnt(
    ["contractType", "isRunning", "contractPeriod", "initialDistanceDate", "brandStaffName"],
    columnKeyList
  );
  const sumColumnCnt = columnKeyList.length;
  let startIndex: number = sumColumnCnt;
  const salesStatsColCount = 8;

  const doesColumnExist = (type: keyof typeof columnTypes) => columnTypes && columnTypes[type] === true;

  const processStatList = (statList: ExtendedSalesStatList_salesStats[], summaryKey: string) => {
    if (statList.length > 0) {
      const statSum = getSalesStatsSum(statList);
      retNumberElement.push(getSummaryTotalElement(statSum, summaryKey, startIndex));
    } else {
      retNumberElement.push(getSummaryEmptyTotalElement(summaryKey, startIndex));
    }
    startIndex += salesStatsColCount;
  };

  for (const monthMoment of monthMomentArr) {
    const totalStatList: ExtendedSalesStatList_salesStats[] = [];
    const exclusiveStatList: ExtendedSalesStatList_salesStats[] = [];
    const packagingStatList: ExtendedSalesStatList_salesStats[] = [];
    const foodStatList: ExtendedSalesStatList_salesStats[] = [];

    for (const record of copiedTableData) {
      if (record.brand.id === props.bossMarketId) {
        continue;
      }

      if (doesColumnExist("total")) {
        const salesStatTotal = getSalesStatByTypeAndMonth(
          record.stats,
          "total",
          monthMoment,
          record.brand.contractType
        );
        if (salesStatTotal) {
          totalStatList.push(salesStatTotal);
        }
      }
      if (doesColumnExist("exclusive")) {
        const salesStatExclusive = getSalesStatByTypeAndMonth(
          record.stats,
          "exclusive",
          monthMoment,
          record.brand.contractType
        );
        if (salesStatExclusive) {
          exclusiveStatList.push(salesStatExclusive);
        }
      }
      if (doesColumnExist("packaging")) {
        const salesStatPackaging = getSalesStatByTypeAndMonth(
          record.stats,
          "packaging",
          monthMoment,
          record.brand.contractType
        );
        if (salesStatPackaging) {
          packagingStatList.push(salesStatPackaging);
        }
      }
      if (doesColumnExist("food")) {
        const salesStatFood = getSalesStatByTypeAndMonth(record.stats, "food", monthMoment, record.brand.contractType);
        if (salesStatFood) {
          foodStatList.push(salesStatFood);
        }
      }
    }

    const monthStr = monthMoment.format(onlyMonthFormat);

    if (doesColumnExist("total")) {
      processStatList(totalStatList, monthStr + "total");
    }
    if (doesColumnExist("exclusive")) {
      processStatList(exclusiveStatList, monthStr + "exclusive");
    }
    if (doesColumnExist("packaging")) {
      processStatList(packagingStatList, monthStr + "packaging");
    }
    if (doesColumnExist("food")) {
      processStatList(foodStatList, monthStr + "food");
    }
  }

  const totalStatListForSum: ExtendedSalesStatList_salesStats[] = [];
  const exclusiveStatListForSum: ExtendedSalesStatList_salesStats[] = [];
  const packagingStatListForSum: ExtendedSalesStatList_salesStats[] = [];
  const foodStatListForSum: ExtendedSalesStatList_salesStats[] = [];

  for (const record of copiedTableData) {
    if (record.brand.id === props.bossMarketId) {
      continue;
    }

    if (doesColumnExist("total")) {
      const salesStatTotal = record.statsSum.total;
      if (salesStatTotal) {
        totalStatListForSum.push({
          ...salesStatTotal,
          brandContractType: record.brand.contractType,
        });
      }
    }
    if (doesColumnExist("exclusive")) {
      const salesStatExclusive = record.statsSum.exclusive;
      if (salesStatExclusive) {
        exclusiveStatListForSum.push({
          ...salesStatExclusive,
          brandContractType: record.brand.contractType,
        });
      }
    }
    if (doesColumnExist("packaging")) {
      const salesStatPackaging = record.statsSum.packaging;
      if (salesStatPackaging) {
        packagingStatListForSum.push({
          ...salesStatPackaging,
          brandContractType: record.brand.contractType,
        });
      }
    }
    if (doesColumnExist("food")) {
      const salesStatFood = record.statsSum.food;
      if (salesStatFood) {
        foodStatListForSum.push({
          ...salesStatFood,
          brandContractType: record.brand.contractType,
        });
      }
    }
  }

  if (doesColumnExist("total")) {
    processStatList(totalStatListForSum, "totalSum");
  }
  if (doesColumnExist("exclusive")) {
    processStatList(exclusiveStatListForSum, "exclusiveSum");
  }
  if (doesColumnExist("packaging")) {
    processStatList(packagingStatListForSum, "packagingSum");
  }
  if (doesColumnExist("food")) {
    processStatList(foodStatListForSum, "foodSum");
  }

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} colSpan={fixedBrandColumnCnt} align="center">
          <Typography.Text strong>합계</Typography.Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={fixedBrandColumnCnt} colSpan={restBrandColumnCnt} />
        {retNumberElement.map((element) => element)}
      </Table.Summary.Row>
    </Table.Summary>
  );
};

export const getSummaryTotalElement = (
  salesStatDataSource: ExtendedSalesStatList_salesStats,
  key: React.Key,
  startIndex: number
) => (
  <React.Fragment key={key}>
    <Table.Summary.Cell index={startIndex} align="right">
      <Typography.Text strong>
        <NumberComponent value={salesStatDataSource?.statTotalPriceExcludeVat} />
