  const validateSeasonalFields = (
    details: ProductBulkCreateDetail[] | ProductVariantBulkUpdateDetail[],
    isUpdateMode: boolean = false
  ) => {
    const seasonalErrors = [];

    for (const detail of details) {
      const isSeasonal = detail.isSeasonal;
      const peakSeasonStartDate = detail.peakSeasonStartDate;
      const peakSeasonEndDate = detail.peakSeasonEndDate;

      let identifier: string;
      if ("productSku" in detail) {
        // ProductVariantBulkUpdateDetail 타입 인 경우
        identifier = detail.productSku;
      } else if ("name" in detail) {
        // ProductBulkCreateDetail 타입 인 경우
        identifier = detail.name;
      }

      // 일괄 수정 모드일 때 시즌 관련 필드가 모두 비어있으면 스킵 (수정하지 않음)
      if (
        isUpdateMode &&
        utils.isEmpty(isSeasonal, true) &&
        utils.isEmpty(peakSeasonStartDate, true) &&
        utils.isEmpty(peakSeasonEndDate, true)
      ) {
        continue;
      }

      if (coerceExcelBoolean(isSeasonal) === true) {
        if (utils.isEmpty(peakSeasonStartDate, true) || utils.isEmpty(peakSeasonEndDate, true)) {
          seasonalErrors.push(identifier);
        }
      }
    }

    const isOk = seasonalErrors.length <= 0;
    if (!isOk) {
      showErrorMessageWithLabel(
