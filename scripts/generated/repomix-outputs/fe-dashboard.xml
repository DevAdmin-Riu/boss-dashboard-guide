import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SwapNavButtonBar } from "@src/app/components/Navigator/SwapNavButtonBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { checkIsEnableForFbvServiceByUser, transformIsFBV, transformIsFBVForHq } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Typography } from "antd";
import React from "react";

import { SalesList, SalesList_sales_edges_node, SalesListVariables } from "../../api/types/SalesList";
import { orderSalesListViewPath, OrderSalesListViewRouteParams } from "../../urls";
import { createFilterStructure, OrderSalesListFilterKeys, OrderSalesListFilterOpts } from "./filters";
import { getOrderSalesListTableSettings } from "./OrderSalesListTableSettings";

export interface OrderSalesListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderSalesListFilterKeys, OrderSalesListFilterOpts> {
  user: User;
  routeParams: OrderSalesListViewRouteParams;
  sales: SalesList_sales_edges_node[];
  ordersForSalesRefetch: () => void;
  queryVariables: SalesListVariables;

  queryVariablesWithoutPagination: SalesListVariables;
  fetchForDownload: (variables?: SalesListVariables) => Promise<ApolloQueryResult<SalesList>>;
}

const OrderSalesListPage: React.FC<OrderSalesListPageProps> = (props) => {
  const {
    user,
    routeParams,
    currentTab,
    filterOpts,
    tabs,
    sales,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    ordersForSalesRefetch,
    queryVariables,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const { isHqStaff } = user;
  const { viewType } = routeParams;
  const enableForFbvService = checkIsEnableForFbvServiceByUser(user);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts, routeParams);

  let sectionName = null;
  switch (viewType) {
    case "by-user":
      sectionName = sectionNames.salesA;
      break;
    case "by-staff-by-brand":
      sectionName = sectionNames.salesB;
      break;
    case "by-staff-for-bad-stock":
      sectionName = sectionNames.salesC;
      break;
    case "for-hq":
      sectionName = sectionNames.hqSales;
      break;
    default:
      break;
  }

  const sectionBtn = (
    <SwapNavButtonBar
      options={[false, true].map((isFbv) => ({
        text: `${isHqStaff ? transformIsFBVForHq(isFbv) : transformIsFBV(isFbv)} 상품`,
        url: orderSalesListViewPath({ ...routeParams, fulfilledBy: isFbv ? "vendor" : "boss" }),
      }))}
    />
  );

  const columns = getOrderSalesListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "sales",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between" gutter={[12, 12]}>
        {enableForFbvService && <Col span={24}>{sectionBtn}</Col>}
        <Col>
          <Space direction="vertical">
            <Typography.Title level={4}>{sectionName}</Typography.Title>
          </Space>
        </Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable<SalesList_sales_edges_node>
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          dataSource={sales}
          columns={pickerSelectedColumns}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};

export default OrderSalesListPage;
</file>

