} from "@src/app/views/purchase/purchaseOrders/api/queries";
import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseOrderLineList";
import { makePoLineQtyText, makePurchaseOrderLineNumber } from "@src/app/views/purchase/purchaseOrders/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import {
  Button,
  Col,
  DatePicker,
  Descriptions,
  Form,
  FormListFieldData,
  Input,
  InputNumber,
  Modal,
  Row,
  Space,
  Table,
  Typography,
} from "antd";
import { ColumnsType, ColumnType } from "antd/lib/table";
import moment, { Moment } from "moment";
import React, { useEffect } from "react";

import { usePurchaseOrderLineReqSplitDeliveryMutation } from "../../api/mutations";

type TFormData = StrictOmit<PurchaseOrderLineReqSplitDeliveryInput, "poLineId">;

interface VsPurchaseOrderLineReqSplitDeliveryModalProps {
  open: boolean;
  loading: boolean;
  isApproveMode: boolean;
  poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node | OrderLineList_orderLines_edges_node_purchaseOrderLine;
  onCancel: (shouldReset: boolean) => void;
}

const createInitialDetails = (
  count: number,
  poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node | OrderLineList_orderLines_edges_node_purchaseOrderLine
) =>
  Array.from({ length: count }, (_, index) => ({
    reqQuantity: null,
    reqEpd: index === 0 ? moment(poLine?.expectedPurchaseDate) : null,
    note: null,
  }));

export const VsPurchaseOrderLineReqSplitDeliveryModal: React.FC<VsPurchaseOrderLineReqSplitDeliveryModalProps> = (
  props
) => {
  const { open, loading, isApproveMode, poLine, onCancel } = props;
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const poLineId = poLine?.id;
  const poEventType = poLine?.purchaseOrder.eventType;
  const originQuantity = poLine?.quantity;

  const initialValues: TFormData = isApproveMode
    ? {
        details: poLine?.reqSplitDelivery?.details.map((detail) => ({
          reqQuantity: detail.reqQuantity,
          reqEpd: moment(detail.reqEpd),
          note: detail.note,
        })),
        reason: poLine?.reqSplitDelivery?.reason || "",
      }
    : {
        details: createInitialDetails(2, poLine),
        reason: null,
      };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [purchaseOrderLineReqSplitDelivery, purchaseOrderLineReqSplitDeliveryOpts] =
    usePurchaseOrderLineReqSplitDeliveryMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLineReqSplitDelivery.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 분납이 요청되었습니다.");
          onCancel(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery, orderLineListQuery],
    });

  const [purchaseOrderLineApproveReqSplitDelivery, purchaseOrderLineApproveReqSplitDeliveryOpts] =
    usePurchaseOrderLineApproveReqSplitDeliveryMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLineApproveReqSplitDelivery.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 분납 요청이 확인되었습니다.");
          onCancel(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
    });

  const modalLoading =
    loading || purchaseOrderLineReqSplitDeliveryOpts.loading || purchaseOrderLineApproveReqSplitDeliveryOpts.loading;

  const onSubmit = (formData: TFormData) => {
    const { details, reason } = formData;
    if (details.length < 2) {
      showNotificationError("분납 목록은 최소 2개 이상이어야 합니다.");
      return;
    }
    const splitReqQuantitySum = details.reduce((acc, cur) => acc + cur.reqQuantity, 0);
    if (originQuantity !== splitReqQuantitySum) {
      showNotificationError("분납 요청 수량의 합이 기존 발주 제품의 발주 수량과 일치하지 않습니다.");
      return;
    }
    const uniqueReqEpd = [];
    const duplicatedReqEpd = [];
    for (const detail of details) {
      const formattedReqEpd = moment(detail.reqEpd).format(onlyDateFormat);
      if (uniqueReqEpd.includes(formattedReqEpd)) {
        duplicatedReqEpd.push(formattedReqEpd);
      } else {
        uniqueReqEpd.push(formattedReqEpd);
      }
    }
    if (duplicatedReqEpd.length > 0) {
      showNotificationError("분납 요청 시 납품 예정일은 중복될 수 없습니다.");
      return;
    }

    // 분납 요청 확인 (리우 관리자)
    if (isApproveMode) {
      const formattedDetails: PurchaseOrderLineReqSplitDeliveryDetailInput[] = details.map((detail) => ({
        ...detail,
        reqEpd: moment(detail.reqEpd).format(onlyDateFormat),
      }));
      const input: PurchaseOrderLineApproveReqSplitDeliveryInput = { poLineId, details: formattedDetails };
      purchaseOrderLineApproveReqSplitDelivery({ variables: { input } });
      return;
    } else {
      // 분납 요청 (협력사 관리자)
      const formattedDetails: PurchaseOrderLineReqSplitDeliveryDetailInput[] = details.map((detail) => ({
        ...detail,
        reqEpd: moment(detail.reqEpd).format(onlyDateFormat),
      }));
      const input: PurchaseOrderLineReqSplitDeliveryInput = { poLineId, details: formattedDetails, reason };
      purchaseOrderLineReqSplitDelivery({ variables: { input } });
    }
  };

  const tableTitle = (add?: () => void) => (
    <Row justify="space-between" align="middle">
      <Col>
        <Typography.Text>
          <Typography.Text strong>분납 목록</Typography.Text>
          {!isApproveMode && <>(최소 2회)</>}
        </Typography.Text>
      </Col>
      {!isApproveMode && (
        <Col>
          <Button size="small" type="primary" onClick={() => add()}>
            추가
          </Button>
        </Col>
      )}
    </Row>
  );

  const disabledReqEpd = (current: Moment) => {
    if (!current) {
      return false;
    }
    // 오늘 이전 일자 선택 불가
    const isBeforeToday = current.isBefore(moment(), "day");
    return isBeforeToday;
  };

  const handleQuantityBlur = () => {
    const details = form.getFieldValue("details") || [];

    const emptyDetails = details.filter((detail) => !detail?.reqQuantity || detail.reqQuantity <= 0);
    if (emptyDetails.length === 1) {
      const sumOfEnteredQuantities = details.reduce((acc, cur) => {
        if (cur && cur.reqQuantity > 0) {
          return acc + cur.reqQuantity;
        }
        return acc;
      }, 0);

      const remainingQuantity = originQuantity - sumOfEnteredQuantities;

      if (remainingQuantity > 0) {
        const emptyDetailIndex = details.findIndex((detail) => !detail?.reqQuantity || detail.reqQuantity <= 0);
        form.setFieldValue(["details", emptyDetailIndex, "reqQuantity"], remainingQuantity);
      } else {
        showNotificationError("작성한 발주 수량이 기존 발주 수량과 일치하지 않습니다.");
      }
    }
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="분납 요청"
      open={open}
      maskClosable={false}
      width={750}
      okButtonProps={{ loading: modalLoading }}
      okText={isApproveMode ? "확인" : "요청"}
      onOk={form.submit}
      onCancel={() => onCancel(false)}
    >
      <Form
        size="small"
        layout="vertical"
        name="purchase-order-lines-req-split-delivery"
        form={form}
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Space direction="vertical" size="large">
          {!!poLine ? (
            <Descriptions
              bordered
              size="small"
              column={2}
              labelStyle={{ width: "20%" }}
              contentStyle={{ width: "30%" }}
            >
              <Descriptions.Item label={columnNameConstant.purchaseOrder.PO_LINE_NO}>
                {makePurchaseOrderLineNumber(poLine)}
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.purchaseOrder.PO_AMOUNT}>
                <Typography.Text strong>{makePoLineQtyText(poEventType, poLine)}</Typography.Text>
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.product.SKU}>{poLine.productSku || "-"}</Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.product.PRODUCT_NAME}>
                {poLine.productName || "-"}
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.purchaseOrder.ASKING_PO_DATE}>
                <DateTime date={poLine.askingPurchaseDate} onlyDate />
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_DATE}>
                <DateTime date={poLine.expectedPurchaseDate} onlyDate />
              </Descriptions.Item>
              <Descriptions.Item label={<RequiredTypography text="분납 사유" />}>
                {isApproveMode ? (
                  <>{poLine?.reqSplitDelivery?.reason}</>
                ) : (
                  <Form.Item
                    name={TypeSafeForm.getValidDataIndex("reason")}
                    style={{ marginBottom: 0 }}
                    rules={[{ required: true, type: "string", min: 1, message: formRuleMsg.min(1, "자") }]}
                  >
                    <Input.TextArea rows={4} placeholder="분납 사유를 입력해주세요. (최소 1자 이상)" />
                  </Form.Item>
                )}
              </Descriptions.Item>
            </Descriptions>
          ) : (
            <Loader />
          )}
          <Form.List name={TypeSafeForm.getValidDataIndex("details")}>
            {(fields, { add, remove }) => {
              const commonColumns: ColumnsType<FormListFieldData> = [
                {
                  title: columnNameConstant.purchaseOrder.PO_AMOUNT,
                  key: "reqQuantity",
                  align: "center",
                  width: 120,
                  render: (_, record) => (
                    <Form.Item
                      name={[record.name, "reqQuantity"]}
                      style={{ marginBottom: 0 }}
                      rules={[{ required: true, type: "integer", min: 1, message: formRuleMsg.min(1) }]}
                    >
                      <InputNumber
                        {...getInputNumberProps({ isCommaDisplay: true })}
                        addonAfter={getSalesUnitTypeText(poLine?.variant.salesUnitType)}
                        onBlur={handleQuantityBlur}
                      />
                    </Form.Item>
                  ),
                },
                {
                  title: columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_DATE,
                  key: "reqEpd",
                  align: "center",
                  width: 140,
                  render: (_, record) => (
                    <Form.Item
                      name={[record.name, "reqEpd"]}
                      style={{ marginBottom: 0 }}
                      rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
                    >
                      <DatePicker style={{ width: "100%" }} allowClear={false} disabledDate={disabledReqEpd} />
                    </Form.Item>
                  ),
                },
                {
                  title: "메모",
                  key: "note",
                  align: "left",
                  width: 200,
                  render: (_, record) => (
                    <>
                      <Form.Item name={[record.name, "note"]} hidden={isApproveMode} noStyle>
                        <Input.TextArea placeholder="메모를 입력해주세요." />
                      </Form.Item>
                      {isApproveMode && <Typography>{poLine?.reqSplitDelivery.details[record.name].note}</Typography>}
                    </>
                  ),
                },
              ];
              const poLineNumberColumn: ColumnType<FormListFieldData> = {
                title: columnNameConstant.purchaseOrder.PO_LINE_NO,
                key: "purchaseOrderLineNo",
                align: "center",
                width: 150,
                render: (_, _record, index) =>
                  index === 0 && poLine ? makePurchaseOrderLineNumber(poLine) : "신규 생성",
              };
              const removeColumn: ColumnType<FormListFieldData> = {
                key: "action",
                align: "center",
                width: 50,
                render: (_, record) =>
                  record.name !== 0 && (
                    <Button size="large" type="text" icon={<DeleteFilled />} onClick={() => remove(record.name)} />
                  ),
              };
              const columns = isApproveMode ? [poLineNumberColumn, ...commonColumns] : [...commonColumns, removeColumn];
              const tableWidthSum = utils.calcTableColsWidthSum(columns);

              return (
                <Table<FormListFieldData>
                  {...commonTableProps}
                  rowKey={(record) => record.key}
                  title={() => tableTitle(add)}
                  columns={columns}
                  dataSource={fields}
                  scroll={{ x: tableWidthSum }}
                />
              );
            }}
          </Form.List>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/vendorStaff/vsSection/components/VsPurchaseOrderLineModals/VsPurchaseOrderLinesDispatchFulfillmentModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import {
  OrderFulfillBulkInput,
  PurchaseOrderLinesDispatchFulfillmentDetailInput,
  SalesUnitTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import NumberComponent from "@src/app/components/Number";
import { DateTime } from "@src/app/providers/DateProvider";
import { ShopContext } from "@src/app/providers/ShopProvider";
import { useOrderFulfillBulkMutation } from "@src/app/views/order/orders/api/mutations";
import { orderLineListQuery } from "@src/app/views/order/orders/api/queries";
import {
  OrderLineList_orderLines_edges_node,
  OrderLineList_orderLines_edges_node_purchaseOrderLine,
} from "@src/app/views/order/orders/api/types/OrderLineList";
import { checkNeedDeliveryManInfoForConsignmentFulfill } from "@src/app/views/order/orders/components/OrderDeliveryListPage/utils";
import { getSalesUnitTypeText } from "@src/app/views/product/products/utils/data";
import {
  purchaseOrderLineCountQuery,
  purchaseOrderLineListQuery,
} from "@src/app/views/purchase/purchaseOrders/api/queries";
import {
  PurchaseOrderLineList_purchaseOrderLines_edges_node,
  PurchaseOrderLineList_purchaseOrderLines_edges_node_orderLine,
} from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseOrderLineList";
import {
  makeProductQtyPerBoxFromPoLine,
  makeProductSpecFromPoLine,
} from "@src/app/views/purchase/purchaseOrders/components/PurchaseOrderLineListPage/PurchaseOrderLineListTableSettings";
import { makePoLineQtyText, makePurchaseOrderLineNumber } from "@src/app/views/purchase/purchaseOrders/utils";
import { getDeliveryBoxCountConsiderAdjustPricePv } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form, Input, InputNumber, Modal, Space, Table, Typography } from "antd";
import { Rule } from "antd/lib/form";
import { ColumnsType, ColumnType } from "antd/lib/table";
import { DocumentNode } from "graphql";
import React, { useContext, useEffect } from "react";

import { usePurchaseOrderLinesDispatchFulfillmentMutation } from "../../api/mutations";

type TPoLine =
  | PurchaseOrderLineList_purchaseOrderLines_edges_node
  | OrderLineList_orderLines_edges_node_purchaseOrderLine;
type TOrderLine = PurchaseOrderLineList_purchaseOrderLines_edges_node_orderLine | OrderLineList_orderLines_edges_node;

interface VsPurchaseOrderLinesDispatchFulfillmentModalProps {
  open: boolean;
  loading: boolean;
  trackInventory: boolean;
  poLines: TPoLine[];
  orderLines: TOrderLine[];
  onCancel: (shouldReset: boolean) => void;
  isB2b: boolean;
  isByNonCourier: boolean;
}

// NOTE: 기존 재고 / 위탁이 같은 형식이었지만 B2B의 B2B 배송비가 포함되면서 PurchaseOrderLinesDispatchFulfillmentInput의 구조를 상속 받아서 b2bDeliveryFeeExcludeVat, orderLineId를 추가한 input type
export interface PurchaseOrderLinesDispatchFulfillmentFormInput
  extends PurchaseOrderLinesDispatchFulfillmentDetailInput {
  b2bDeliveryFeeExcludeVat: number;
  orderLineId: string;
}

export interface PurchaseOrderLinesDispatchFulfillmentFormType {
  details: Array<PurchaseOrderLinesDispatchFulfillmentFormInput | null>;
}

// TODO: VsPurchaseOrderLinesDispatchFulfillmentModal, makeFormInputByFragments, submitByFragments 에 출고 로직 처리가 3군데를 해야함 -> 개선 필요
export const VsPurchaseOrderLinesDispatchFulfillmentModal: React.FC<
  VsPurchaseOrderLinesDispatchFulfillmentModalProps
> = (props) => {
  const { open, loading, trackInventory, poLines, orderLines, onCancel, isB2b, isByNonCourier } = props;
  const shop = useContext(ShopContext);
  const { user } = useUser();
  const { isStaff } = user;
  const [form] = Form.useForm<PurchaseOrderLinesDispatchFulfillmentFormType>();
  const TypeSafeForm = getTypeSafeForm<PurchaseOrderLinesDispatchFulfillmentFormType>(form);

  const initialValues: PurchaseOrderLinesDispatchFulfillmentFormType = {
    details: poLines.map((poLine) => ({
      orderLineId: trackInventory === false && isByNonCourier ? poLine?.orderLine?.id : null,
      poLineId: poLine.id,
      purchaseQuantity: poLine.quantity,
      b2bDeliveryFeeExcludeVat: isB2b ? poLine?.b2bDeliveryFeeExcludeVat : 0,
    })),
  };

  const detailsWatched = TypeSafeForm.getUseFormWatched({ name: "details" });

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const refetchQueriesList: DocumentNode[] = [
    isStaff === false && purchaseOrderLineListQuery,
    purchaseOrderLineCountQuery,
    isStaff && orderLineListQuery,
  ].filter(Boolean) as DocumentNode[];

  const [purchaseOrderLinesDispatchFulfillment, purchaseOrderLinesDispatchFulfillmentOpts] =
    usePurchaseOrderLinesDispatchFulfillmentMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLinesDispatchFulfillment.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 출고 지시가 완료되었습니다.");
          onCancel(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: refetchQueriesList,
    });

  const [orderFulfillBulk, orderFulfillBulkOpts] = useOrderFulfillBulkMutation({
    onCompleted: (data) => {
      const errors = data.orderFulfillBulk.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 발주 품목의 출고 지시가 완료되었습니다.");
        onCancel(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: refetchQueriesList,
  });

  const modalLoading = loading || purchaseOrderLinesDispatchFulfillmentOpts.loading || orderFulfillBulkOpts.loading;

  const onSubmit = (formData: PurchaseOrderLinesDispatchFulfillmentFormType) => {
    if (trackInventory) {
      const overstockingQtyErrorElements = [];
      const trackInventoryFormData: PurchaseOrderLinesDispatchFulfillmentDetailInput[] = [];
      const { details } = formData;
      const allowedOverstockingRate = parseInt(shop.siteSettingsPluginInfo.allowedOverstockingRate, 10) || 0;
      for (const detail of details) {
        const { poLineId, purchaseQuantity } = detail;
        const poLine = (poLines as PurchaseOrderLineList_purchaseOrderLines_edges_node[]).find(
          (poLine) => poLine.id === poLineId
        );
        const overstockedQty = purchaseQuantity - Math.floor(poLine.quantity * ((100 + allowedOverstockingRate) / 100));
        if (overstockedQty > 0) {
          overstockingQtyErrorElements.push(makePurchaseOrderLineNumber(poLine));
        }
        trackInventoryFormData.push({
          poLineId,
          purchaseQuantity,
        });
      }

      if (overstockingQtyErrorElements.length > 0) {
        showNotificationError(
          <MultiLineTypography
            lines={[
              `납품 수량이 발주 수량의 ${allowedOverstockingRate}%를 초과할 수 없습니다.(발주상세번호)`,
              `[ ${overstockingQtyErrorElements.join(", ")} ]`,
            ]}
          />
        );
        return;
      }

      purchaseOrderLinesDispatchFulfillment({ variables: { input: { details: trackInventoryFormData } } });
    } else {
      // 위탁인 경우 isAdjustPrice 상품 수량 체크
      const adjustPriceQtyErrorElements = [];
      for (const detail of formData.details) {
        const { poLineId, purchaseQuantity } = detail;
        const poLine = poLines.find((pl) => pl.id === poLineId);
        if (poLine && poLine.variant?.isAdjustPrice) {
          const originalQuantity = poLine.quantity;
          if (purchaseQuantity < Math.max(1, originalQuantity - 1) || purchaseQuantity > originalQuantity + 1) {
            adjustPriceQtyErrorElements.push({
              lineNumber: makePurchaseOrderLineNumber(poLine),
              originalQty: originalQuantity,
              purchaseQty: purchaseQuantity,
            });
          }
        }
      }

      if (adjustPriceQtyErrorElements.length > 0) {
        const errorLines = adjustPriceQtyErrorElements.map(
          ({ lineNumber, originalQty }) =>
            `${lineNumber} (발주 수량: ${originalQty}, 허용 범위: ${Math.max(1, originalQty - 1)}~${originalQty + 1})`
        );
        showNotificationError(
          <MultiLineTypography
            lines={["납품 수량 조정 상품은 발주 수량에서 ±1 범위 내에서만 변경 가능합니다.", ...errorLines]}
          />
        );
        return;
      }

      const ordersToFulfill = orderLines.reduce<OrderFulfillBulkInput[]>((acc, orderLine) => {
        const { id: orderId, deliveryMethod } = orderLine.order;
        const b2bDeliveryFeeExcludeVat = isB2b
          ? formData.details.find((data) => orderLine.id === data.orderLineId)?.b2bDeliveryFeeExcludeVat
          : 0;

        const { isFulfilledByVendor } = orderLine;
        const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);

        // 현재 orderLine에 해당하는 poLine 찾기
        const correspondingPoLine = poLines.find((poLine) => poLine.orderLine.id === orderLine.id);
        const poLineIndex = poLines.findIndex((poLine) => poLine.orderLine.id === orderLine.id);
        const quantity: number = poLineIndex !== -1 ? formData.details[poLineIndex]?.purchaseQuantity : undefined;

        const variant = correspondingPoLine?.variant;
        const isAdjustPrice = variant?.isAdjustPrice || false;

        if (needDeliveryManInfoForConsignmentFulfill || isB2b) {
          // quantity가 없거나 0인 경우 스킵
          if (!quantity || quantity === 0) {
            return acc;
          }

          const orderToFulfill = {
            orderId,
            input: {
              lines: [
                {
                  orderLineId: orderLine.id,
                  stocks: [{ quantity, warehouse: undefined }],
                  b2bDeliveryFeeExcludeVat,
                },
              ],
              isFulfilledByVendor,
              deliveryMethod,
            },
          };
          acc.push(orderToFulfill);
        } else {
          // 납품 시 납품금액 확정 모드에서만 박스 당 수량으로 배송 박스 정해서 출고 로직 처리함. -> 추후 박스 당 중량 사용 제품은 모두 이 로직 적용으로 개선 고려
          if (isAdjustPrice) {
            const qtyPerDeliveryBox = variant.qtyPerDeliveryBox;
            const deliveryBoxCount = getDeliveryBoxCountConsiderAdjustPricePv(variant, quantity);
            let totalFulfilledQty = 0;
            for (let j = 0; j < deliveryBoxCount; j++) {
              const fulfillQty = j !== deliveryBoxCount - 1 ? qtyPerDeliveryBox : quantity - totalFulfilledQty;
              totalFulfilledQty += fulfillQty;
              const orderToFulfill = {
                orderId,
                input: {
                  lines: [
                    {
                      orderLineId: orderLine.id,
                      stocks: [{ quantity: fulfillQty, warehouse: undefined }],
                      b2bDeliveryFeeExcludeVat,
                    },
                  ],
                  isFulfilledByVendor,
                  deliveryMethod,
                },
              };
              acc.push(orderToFulfill);
            }
          } else {
            const quantityUnfulfilled =
              orderLine.orderedOrFulfillQty - orderLine.quantityFulfilled - orderLine.quantityRefunded;
            for (let i = 0; i < quantityUnfulfilled; i++) {
              const orderToFulfill = {
                orderId,
                input: {
                  lines: [
                    {
                      orderLineId: orderLine.id,
                      stocks: [{ quantity: 1, warehouse: undefined }],
                      b2bDeliveryFeeExcludeVat,
                    },
                  ],
                  isFulfilledByVendor,
                  deliveryMethod,
                },
              };
              acc.push(orderToFulfill);
            }
          }
        }
        return acc;
      }, []);
      orderFulfillBulk({ variables: { ordersToFulfill } });
    }
  };

  const columns: ColumnsType<TPoLine> = [
    {
      title: "발주 정보",
      children: [
        {
          title: columnNameConstant.purchaseOrder.PO_NO,
          key: "purchaseOrderNumber",
          align: "center",
          width: 120,
          render: (_, record) => record.purchaseOrder.code,
        } as ColumnType<TPoLine>,
        {
          title: columnNameConstant.purchaseOrder.PO_LINE_NO,
          key: "purchaseOrderLineNumber",
          align: "center",
          width: 150,
          render: (_, record) => makePurchaseOrderLineNumber(record),
        } as ColumnType<TPoLine>,
        {
          title: columnNameConstant.purchaseOrder.ASKING_PO_DATE,
          align: "center",
          key: "askingPurchaseDate",
          width: 120,
          render: (_, record) => <DateTime date={record.askingPurchaseDate} onlyDate />,
        } as ColumnType<TPoLine>,
        {
          title: columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_DATE,
          align: "center",
          key: "expectedPurchaseDate",
          width: 120,
          render: (_, record) => <DateTime date={record.expectedPurchaseDate} onlyDate />,
        } as ColumnType<TPoLine>,
        {
          title: columnNameConstant.purchaseOrder.PO_AMOUNT,
          align: "center",
          key: "quantity",
          width: 80,
          render: (_, record) => makePoLineQtyText(record.purchaseOrder.eventType, record),
        } as ColumnType<TPoLine>,
        {
          title: columnNameConstant.purchaseOrder.PURCHASE_QTY,
          align: "center",
          key: "purchaseQuantity",
          width: 130,
          render: (_, record, idx) => {
            const salesUnitTypeText = getSalesUnitTypeText(record.variant.salesUnitType);
            const precision = record.variant.orderQtyDecimalPlaces;
            const isAdjustPrice = record.variant.isAdjustPrice;

            return (
              <>
                <Form.Item name={[idx, "orderLineId"]} hidden>
                  <Input />
                </Form.Item>
                <Form.Item
                  style={{ margin: 0 }}
                  name={[idx, "purchaseQuantity"]}
                  rules={
                    [
                      precision === 0 && {
                        required: true,
                        type: "number",
                        min: 1,
                        message: formRuleMsg.min(1),
                      },
                    ].filter(Boolean) as Rule[]
                  }
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true, precision })}
                    disabled={!trackInventory && !isByNonCourier && !isAdjustPrice}
                    addonAfter={salesUnitTypeText}
                  />
                </Form.Item>
              </>
            );
          },
        } as ColumnType<TPoLine>,
        isB2b &&
          ({
            title: isStaff
              ? columnNameConstant.orderLine.B2B_DELIVERY_FEE_PURCHASE
              : columnNameConstant.orderLine.B2B_DELIVERY_FEE_SALE,
            align: "left",
            key: "b2bDeliveryFeeExcludeVat",
            width: 130,
            render: (_value, _record, idx) => (
              <>
                <Form.Item name={[idx, "poLineId"]} hidden>
                  <Input />
                </Form.Item>
                <Form.Item
                  style={{ margin: 0 }}
                  name={[idx, "b2bDeliveryFeeExcludeVat"]}
                  rules={[{ required: true, type: "integer", min: 0, message: formRuleMsg.min(1) }]}
                >
                  <InputNumber
                    {...getInputNumberProps({ isCommaDisplay: true })}
                    disabled={!trackInventory && !isB2b}
                  />
                </Form.Item>
              </>
            ),
          } as ColumnType<TPoLine>),
      ].filter(Boolean),
    },
    {
      title: "제품 정보",
      children: [
        {
          title: columnNameConstant.product.SKU,
          align: "center",
          key: "productSku",
          width: 120,
          render: (_, record) => record.productSku || "-",
        },
        {
          title: columnNameConstant.product.PRODUCT_NAME,
          key: "productName",
          align: "left",
          width: 200,
          render: (_, record) => record.productName || "-",
        },
        {
          title: columnNameConstant.product.DETAIL_INFO,
          key: "attributes",
          align: "left",
          width: 200,
          render: (_, record) => makeProductSpecFromPoLine(record),
        },
        {
          title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
          key: "qtyPerBox",
          align: "right",
          width: 90,
          render: (_, record) => makeProductQtyPerBoxFromPoLine(record, record.variant.qtyPerBoxUnitType),
        },
      ],
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const tableSummary = (tableData: readonly TPoLine[]) => {
    // 현재는 제품의 운영 단위 중 BOX로만 발주되고 있지만, 다른 단위로 발주가 될 경우를 대비하여 아래와 같이 운영 단위별로 합산하여 표시
    const totalPurchaseQtyPerSalesUnitType: Partial<Record<SalesUnitTypeEnum, number>> = {};
    tableData.forEach((poLine) => {
      const detailWatched = detailsWatched?.find((detail) => detail.poLineId === poLine.id);
      if (utils.isEmpty(detailWatched)) {
        return;
      }

      const salesUnitType = poLine.variant.salesUnitType;
      const purchaseQuantity = detailWatched.purchaseQuantity;
      if (totalPurchaseQtyPerSalesUnitType[salesUnitType]) {
        totalPurchaseQtyPerSalesUnitType[salesUnitType] += purchaseQuantity;
      } else {
        totalPurchaseQtyPerSalesUnitType[salesUnitType] = purchaseQuantity;
      }
    });

    return (
      <Table.Summary fixed>
        <Table.Summary.Row>
          <Table.Summary.Cell index={0} colSpan={5} align="center">
            <Typography.Text strong>총 {columnNameConstant.purchaseOrder.PURCHASE_QTY}</Typography.Text>
          </Table.Summary.Cell>
          <Table.Summary.Cell index={1} align="center">
            <Space direction="vertical" size={0}>
              {Object.entries(totalPurchaseQtyPerSalesUnitType).map(([salesUnitType, totalQty]) => (
                <NumberComponent
                  key={salesUnitType}
                  value={totalQty}
                  postFix={getSalesUnitTypeText(salesUnitType as SalesUnitTypeEnum)}
                />
              ))}
            </Space>
          </Table.Summary.Cell>
        </Table.Summary.Row>
      </Table.Summary>
    );
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="출고 지시"
      open={open}
      maskClosable={false}
      width={1200}
      okButtonProps={{ loading: modalLoading }}
      onOk={form.submit}
      onCancel={() => onCancel(false)}
    >
      <Form
        size="small"
        layout="vertical"
        name="purchase-order-lines-dispatch-fulfillment"
        form={form}
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Space direction="vertical" size="large">
          <Form.List name={TypeSafeForm.getValidDataIndex("details")}>
            {() => (
              <Table<TPoLine>
                {...commonTableProps}
                columns={columns}
                dataSource={poLines}
                scroll={{ x: tableWidthSum }}
                summary={tableSummary}
              />
            )}
          </Form.List>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

