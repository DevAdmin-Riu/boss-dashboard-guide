export const customerQAListQuery = gql`
  ${pageInfoFragment}
  ${customerQADetailFragment}
  query CustomerQAList(
    $sort: CustomerQASortingInput
    $filter: CustomerQAFilterInput
    $before: String
    $after: String
    $first: Int
    $last: Int
  ) {
    customerQAList(sortBy: $sort, filter: $filter, before: $before, after: $after, first: $first, last: $last) {
      pageInfo {
        ...PageInfoFragment
      }
      edges {
        node {
          ...CustomerQADetailFragment
        }
      }
      totalCount
    }
  }
`;
export const useCustomerQAListQuery = makeQuery<CustomerQAList, CustomerQAListVariables>(customerQAListQuery);

