export const getTableSummary = (tableData: readonly any[]) => {
  let normalCountSum = 0;
  let normalDeliveryFeeSum = 0;
  let returnCountSum = 0;
  let returnDeliveryFeeSum = 0;
  let totalCountSum = 0;
  let totalDeliveryFeeSum = 0;

  tableData.forEach((item) => {
    normalCountSum += Number(item.normal.count);
    normalDeliveryFeeSum += Number(item.normal.deliveryFeeSum);
    returnCountSum += Number(item.return.count);
    returnDeliveryFeeSum += Number(item.return.deliveryFeeSum);
    totalCountSum += Number(item.total.count);
    totalDeliveryFeeSum += Number(item.total.deliveryFeeSum);
  });

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center" colSpan={2}>
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={normalCountSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={2} align="right">
          <Text strong>100%</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={3} align="right">
          <Text strong>
            <NumberComponent value={toPriceExcludeVat(normalDeliveryFeeSum)} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={4} align="right">
          <Text strong>
            <NumberComponent value={returnCountSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={5} align="right">
          <Text strong>100%</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={6} align="right">
          <Text strong>
            <NumberComponent value={toPriceExcludeVat(returnDeliveryFeeSum)} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={7} align="right">
          <Text strong>
            <NumberComponent value={totalCountSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={8} align="right">
          <Text strong>100%</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={9} align="right">
          <Text strong>
            <NumberComponent value={toPriceExcludeVat(totalDeliveryFeeSum)} />
          </Text>
        </Table.Summary.Cell>
      </Table.Summary.Row>
    </Table.Summary>
  );
};
