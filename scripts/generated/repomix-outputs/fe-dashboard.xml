    };

  const discountRateColumn: DownloadableEditableColumnType<FbvBrandProductVariants_brandProductVariants_edges_node> = {
    title: columnNameConstant.brandProduct.DISCOUNT_RATE_PERCENT,
    key: "discountRate",
    align: "right",
    width: 80,
    render: (_, record) => {
      if (isEditing(record)) {
        const { priceExcludeVat: mallPrice, beforePriceExcludeVat: beforePrice } = formValuesWatched;
        if (utils.isEmpty(mallPrice) || utils.isEmpty(beforePrice)) {
          return "-";
        }
        const discountRate = utils.calcProfitRate(beforePrice, mallPrice);
        return discountRate;
      }

      return utils.calcProfitRate(record.beforePriceAmount, record.priceAmount);
    },
  };
  const operationColumn: DownloadableEditableColumnType<FbvBrandProductVariants_brandProductVariants_edges_node> = {
    title: "",
    key: "action",
    align: "center",
    fixed: fixedRightFlag,
    width: 150,
    render: (_, record) => {
      const commonButtonProps: ButtonProps = {
        size: "small",
        type: "primary",
      };
      const editable = isEditing(record);
      return editable ? (
        <Space size={"small"} direction={"horizontal"}>
          <Button {...commonButtonProps} disabled={loading} onClick={() => onSubmit(record)}>
            저장
          </Button>
          <Button {...commonButtonProps} disabled={loading} type={"default"} onClick={onCancel}>
            취소
          </Button>
        </Space>
      ) : (
        <Space size={"small"} direction={"horizontal"}>
          <Button {...commonButtonProps} disabled={!utils.isEmpty(editingId)} onClick={() => onEdit(record)}>
            수정
          </Button>
        </Space>
      );
    },
    doNotRenderExcel: true,
  };

  const isDeferredColumn: DownloadableEditableColumnType<FbvBrandProductVariants_brandProductVariants_edges_node> = {
    title: columnNameConstant.product.IS_DEFERRED,
    key: "isDeferred",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Tag color={record.productVariant.isDeferred ? "volcano" : "blue"}>
        {transformIsDeferred(record.productVariant.isDeferred)}
      </Tag>
    ),
    renderExcel: (record) => transformIsDeferred(record.productVariant.isDeferred),
  };

  const columns: EditableColumnsType<FbvBrandProductVariants_brandProductVariants_edges_node> = [
    skuColumn,
    bpSkuColumn,
    brandProductNameColumn,
    isStaff && brandCodeColumn, // 브랜드 코드
    isStaff && brandNameColumn, // 브랜드 명
    attributesColumn, // 상세 정보
    isTaxFreeColumn, // 과세 방식
    trackInventoryVariantTypeColumn, // 재고 운영
    isDeferredColumn, // 후정산 여부
    pvSalesStatusColumn, // 제품 상태
    salesStatusColumn, // 판매 상태
    forceNoNormalDisplayColumn, // 진열 상태
    stoppedAtColumn, // 중단일
    stoppedReasonColumn, // 중단사유
    isOnlyPayableByCashColumn, // 현금전용
    vendorCodeColumn, // 협력사 코드
    vendorNameColumn, // 협력사 명
    vendorExternalSkuColumn, // 협력사 상품 ID
    vendorExternalProductNameColumn, // 협력사 상품명(재고)
    vendorProductPriceAmountExcludeVatColumn, // 협력사 상품가(재고)
    vendorDeliveryFeeExcludeVatColumn, // 협력사 배송비(재고)
    consignmentVendorProductPriceAmountExcludeVatColumn, // 협력사 상품가(위탁)
    consignmentVendorDeliveryFeeExcludeVatColumn, // 협력사 상품가(위탁)
    consignmentVendorSumProductPriceAndDeliveryFeeExcludeVatColumn, // 협력사 상품가(위탁)
    vendorSumProductPriceAndDeliveryFeeExcludeVatColumn, // 공급원가
    priceAmountExcludeVatColumn, // 매장 판매가
    showBeforePriceColumn, // 할인 표시 여부
    beforePriceExcludeVatColumn, // 할인 전 판매가
    discountRateColumn, // 할인율
    operationColumn, // 버튼
  ].filter(Boolean);
  return columns;
};
</file>

<file path="src/app/views/product/products/components/FbvProductListPage/filters.ts">
import { sectionNames } from "@assets/messages/sectionNames";
import { SalesStatusEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { getSalesStatusChoices } from "@src/app/views/product/products/utils/data";
import { AutocompleteFilterOpts, FilterOpts } from "@src/global/core/types/types";
import {
  createAutocompleteField,
  createBooleanField,
  createOptionsField,
  createTextField,
} from "@utils/filters/fields";

export enum FbvBrandProductVariantListFilterKeys {
  categories = "categories",
  productSearch = "productSearch",
  brandProductSearch = "brandProductSearch",
  brandSearch = "brandSearch",
  vendorSearch = "vendorSearch",
  isTaxFree = "isTaxFree",
  trackInventory = "trackInventory",
  pvSalesStatus = "pvSalesStatus",
  externalProductSearch = "externalProductSearch",
}

export interface FbvBrandProductVariantListFilterOpts {
  categories: FilterOpts<string[]> & AutocompleteFilterOpts;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  isTaxFree: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  pvSalesStatus: FilterOpts<SalesStatusEnum[]>;
  externalProductSearch: FilterOpts<string>;
}

export function createFilterStructure(
  opts: FbvBrandProductVariantListFilterOpts
): IFilter<FbvBrandProductVariantListFilterKeys> {
  let displayOrder = 0;
  const categoriesFilter = {
    ...createAutocompleteField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.categories,
      sectionNames.categories,
      opts.categories.value,
      opts.categories.displayValues,
      true,
      opts.categories.choices,
      {
        hasMore: opts.categories.hasMore,
        initialSearch: "",
        loading: opts.categories.loading,
        onFetchMore: opts.categories.onFetchMore,
        onSearchChange: opts.categories.onSearchChange,
      }
    ),
    active: opts.categories.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };

  const vendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.vendorSearch,
      "협력사코드 / 협력사명",
      opts.vendorSearch.value
    ),
    active: opts.vendorSearch.active,
  };
  const isTaxFreeFilter = {
    ...createBooleanField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.isTaxFree,
      columnNameConstant.product.IS_TAX_FREE,
      opts.isTaxFree.value,
      {
        negative: "과세",
        positive: "면세",
      }
    ),
    active: opts.isTaxFree.active,
  };
  const trackInventoryFilter = {
    ...createBooleanField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.trackInventory,
      columnNameConstant.order.FULFILLMENT_TYPE,
      opts.trackInventory.value,
      {
        positive: "보관",
        negative: "위탁",
      }
    ),
    active: opts.trackInventory.active,
  };
  const pvSalesStatusFilter = {
    ...createOptionsField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.pvSalesStatus,
      "제품상태",
      opts.pvSalesStatus.value,
      true,
      getSalesStatusChoices(false, false, true)
    ),
    active: opts.pvSalesStatus.active,
  };
  const externalProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      FbvBrandProductVariantListFilterKeys.externalProductSearch,
      "협력사 상품ID / 협력사 상품명",
      opts.externalProductSearch.value
    ),
    active: opts.externalProductSearch.active,
  };

  return [
    categoriesFilter,
    productSearchFilter,
    brandProductSearchFilter,
    brandSearchFilter,
    vendorSearchFilter,
    isTaxFreeFilter,
    trackInventoryFilter,
    pvSalesStatusFilter,
    externalProductSearchFilter,
  ].filter(Boolean);
}
</file>

<file path="src/app/views/product/products/components/FileUpload/FileUpload.tsx">
import { Button } from "antd";
import React from "react";

export interface FileUploadProps {
  buttonText: string;
  onImageUpload: (file: File) => void;
  accept: string;
  disabled?: boolean;
}

const FileUpload: React.FC<FileUploadProps> = (props) => {
  const { buttonText, onImageUpload, accept, disabled = false } = props;
  const anchor = React.useRef<HTMLInputElement>();
  const handleImageUploadButtonClick = () => anchor.current.click();
  return (
    <>
      <Button type="default" onClick={handleImageUploadButtonClick} disabled={disabled}>
        {buttonText}
      </Button>
      <input
        id="fileUpload"
        style={{ display: "none" }}
        onChange={(event) => onImageUpload(event.target.files[0])}
        type="file"
        ref={anchor}
        accept={accept ? accept : "*"}
      />
    </>
  );
};

export default FileUpload;
</file>

<file path="src/app/views/product/products/components/MainPvListCard/MainPvListCard.tsx">
import { MainPvFragment } from "@src/api/fragments/types/MainPvFragment";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { utils } from "@utils/utils";
import { Badge, Button, Card, Empty, Space, Table, Tooltip, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import { getMainPvListTableSettings } from "./MainPvListTableSettings";

interface MainPvListCardProps {
  disabled: boolean;
  mainPvs: MainPvFragment[];
  onProductClick: (productId: string) => void;
  onBulkAssign: () => void;
  onBulkUnassign: (mainPvIds: string[]) => void;
}

export const MainPvListCard: React.FC<MainPvListCardProps> = (props) => {
  const { disabled, mainPvs, onProductClick, onBulkAssign, onBulkUnassign } = props;
  const [selectedRowKeys, setSelectedRowKeys] = useState<string[]>([]);
  const mainPvExist = utils.isEmpty(mainPvs) ? false : true;

  useEffect(() => {
    setSelectedRowKeys([]);
  }, [mainPvs]);

  const columns = getMainPvListTableSettings({ onProductClick });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<MainPvFragment> = {
    fixed: true,
    selectedRowKeys,
    onChange: (selectedRowKeys) => setSelectedRowKeys(selectedRowKeys as string[]),
  };

  return (
    <Card
      bodyStyle={{ padding: 0 }}
      title={
        <Tooltip title="이 제품을 부자재로 사용하는 연동 제품을 설정합니다. 아래 리스트에 추가된 제품이 판매될 경우, 이 제품의 재고가 판매 수량과 동일하게 차감됩니다.">
          <Badge size="small" count="?" offset={[10, 0]}>
            <Typography.Title level={4}>연동 제품 리스트</Typography.Title>
          </Badge>
        </Tooltip>
      }
      extra={
        <Space>
          <Button type="primary" disabled={disabled} onClick={onBulkAssign}>
            연동
          </Button>
          <Button
            danger
            type="primary"
            disabled={disabled || mainPvExist === false || selectedRowKeys.length === 0}
            onClick={() => onBulkUnassign(selectedRowKeys)}
          >
            연동 해제
          </Button>
        </Space>
      }
    >
      <Table
        {...commonTableProps}
        columns={columns}
        dataSource={mainPvs}
        rowSelection={rowSelection}
        scroll={{ x: tableWidthSum, y: 500 }}
        locale={{
          emptyText: <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description="부자재로써 연동된 제품이 없습니다." />,
        }}
      />
    </Card>
  );
};
</file>

<file path="src/app/views/product/products/components/MainPvListCard/MainPvListTableSettings.tsx">
import { MainPvFragment } from "@src/api/fragments/types/MainPvFragment";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { transformIsExclusive, transformTaxFree } from "@utils/misc";
import { Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "../../utils/data";

interface MainPvTableSettingsProps {
  onProductClick?: (productId: string) => void;
}

export const getMainPvListTableSettings = (props: MainPvTableSettingsProps): ColumnsType<MainPvFragment> => {
  const { onProductClick } = props;
  const {
    product: { SKU, PRODUCT_NAME, IS_TAX_FREE, DETAIL_INFO, PRODUCT_QTY_PER_BOX, VARIANT_NAME, IS_EXCLUSIVE },
    vendor: { CODE, VENDOR_NAME },
  } = columnNameConstant;

  const columns: ColumnsType<MainPvFragment> = [
    { title: SKU, key: "sku", width: 120, render: (_, record) => record.sku || "-" },
    {
      title: PRODUCT_NAME,
      key: "productName",
      width: 150,
      render: (_, record) => {
        const productName = record.product.name || "-";
        if (!!onProductClick) {
          return <Typography.Link onClick={() => onProductClick(record.product.id)}>{productName}</Typography.Link>;
        }
        return productName;
      },
    },
    { title: VARIANT_NAME, key: "variantName", width: 100, render: (_, record) => record.name || "-" },
    {
      title: DETAIL_INFO,
      key: "attributes",
      width: 200,
      render: (_, record) => {
        const hasVariants = !!record.product.productType.hasVariants;
        const targetAttributes = hasVariants ? record.attributes : record.product.attributes;
        return makeProductSpecTextFromAttr(targetAttributes) || "-";
      },
    },
    {
      title: PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "right",
      width: 80,
      render: (_, record) => makeProductQtyPerBoxText(record) || "-",
    },
    {
      title: CODE,
      key: "vendorCode",
      align: "center",
      width: 100,
      render: (_, record) => record.defaultVariantVendor?.vendor?.code || "-",
    },
    {
      title: VENDOR_NAME,
      key: "vendorName",
      align: "left",
      width: 150,
      render: (_, record) => record.defaultVariantVendor?.vendor?.name || "-",
    },
    {
      title: IS_TAX_FREE,
      align: "center",
      key: "isTaxFree",
      width: 80,
      render: (_, record) => transformTaxFree(record.product.isTaxFree),
    },
    {
      title: IS_EXCLUSIVE,
      key: "isExclusive",
      align: "center",
      width: 90,
      render: (_, record) => transformIsExclusive(record.product.isExclusive),
    },
  ];
  return columns;
};
</file>

<file path="src/app/views/product/products/components/MainPvsBulkAssignModal/filters.ts">
import { ProductVariantFilterInput } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createTextField } from "@utils/filters/fields";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

enum MainPvSearchFilterKeys {
  productSearch = "productSearch",
  vendorSearch = "vendorSearch",
}
type MainPvSearchFilters = Filters<MainPvSearchFilterKeys>;

interface MainPvSearchListFilterOpts {
  productSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
}

export const getFilterOpts = (filterVariables: ProductVariantFilterInput): MainPvSearchListFilterOpts => ({
  productSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
    value: filterVariables?.productSearch || "",
  },
  vendorSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
    value: filterVariables?.vendorSearch || "",
  },
});

export const createFilterStructure = (opts: MainPvSearchListFilterOpts): IFilter<MainPvSearchFilterKeys> => {
  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        MainPvSearchFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        MainPvSearchFilterKeys.vendorSearch,
        "협력사코드 / 협력사명",
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): MainPvSearchFilters {
  const { name } = filter;

  switch (name) {
    case MainPvSearchFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, MainPvSearchFilterKeys.productSearch);
    case MainPvSearchFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, MainPvSearchFilterKeys.vendorSearch);
  }
}

export function getFilterVariables(filters: Array<IFilterElement<string>>): ProductVariantFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return { ...queryParams, isSubPv: false, trackInventory: true };
}
</file>

<file path="src/app/views/product/products/components/MainPvsBulkAssignModal/MainPvsBulkAssignModal.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { SearchMainPvs_search_edges_node, SearchMainPvsVariables } from "@src/api/searches/types/SearchMainPvs";
import { useMainPvsSearch } from "@src/api/searches/useProductVariantSearch";
import { BulkAssignMainPvsToSubPvInput, ProductVariantManageEventTypeEnum } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilter from "@src/app/components/Filter/SpreadFilter";
import { TransferTable } from "@src/app/components/TransferTable";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Form, Input, Modal, Space } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { productVariantManageEventTypeChoices } from "../../utils/data";
import { getMainPvListTableSettings } from "../MainPvListCard/MainPvListTableSettings";
import { makePvOrBpvManageEventFormItems } from "../PvOrBpvManageEventModal";
import { createFilterStructure, getFilterOpts, getFilterVariables } from "./filters";

interface MainPvsBulkAssignModalProps {
  loading: boolean;
  open: boolean;
  subPvId: string;
  onSubmit: (formData: MainPvsBulkAssignModalForm) => void;
  onClose: () => void;
}

interface MainPvsBulkAssignModalForm extends BulkAssignMainPvsToSubPvInput {
  needReason: boolean;
}

export const MainPvsBulkAssignModal: React.FC<MainPvsBulkAssignModalProps> = (props) => {
  const { loading, open, subPvId, onSubmit, onClose } = props;
  const initialQueryVariables: SearchMainPvsVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: getFilterVariables([]),
  };
  const [queryVariables, setQueryVariables] = useState<SearchMainPvsVariables>(initialQueryVariables);
  const [confirmModalOpen, setConfirmModalOpen] = useState<boolean>(false);
  const [dataSourceToSubmit, setDataSourceToSubmit] = useState<SearchMainPvs_search_edges_node[]>([]);
  const mainPvIds = dataSourceToSubmit.map((mainPv) => mainPv.id);
  // 이미 다른 부자재로 연결된 제품들
  const mainPvsAssignedSubPv = dataSourceToSubmit.filter((mainPv) => utils.isEmpty(mainPv.subPv) === false);

  const [form] = Form.useForm<MainPvsBulkAssignModalForm>();

  const initialValues: MainPvsBulkAssignModalForm = {
    subPvId,
    mainPvIds,
    manageEvent: {
      type: ProductVariantManageEventTypeEnum.TYPE_SUB_PV,
      title: null,
      reason: null,
    },
    needReason: true,
  };

  const filterOpts = getFilterOpts(queryVariables.filter);
  const filterStructure = createFilterStructure(filterOpts);

  const columns: ColumnsType<SearchMainPvs_search_edges_node> = getMainPvListTableSettings({});
  columns.push({
    title: "소모 부자재",
    key: "subPvSku",
    fixed: "right",
    align: "left",
    width: 120,
    render: (_, record) => record.subPv?.sku || "-",
  });

  const { loadMore, result } = useMainPvsSearch({ skip: !open, variables: initialQueryVariables });
  const { data, loading: mainPvsLoading, refetch } = result;
  const dataSource = maybe(() => data.search.edges.map((edge) => edge.node), []).filter(
    (mainPv) => mainPv.subPv?.id !== subPvId
  );
  const hasMore = maybe(() => data.search.pageInfo.hasNextPage, false);

  useEffect(() => {
    if (open) {
      refetch();
    }
  }, [open]);

  const modalLoading = loading || mainPvsLoading;

  return (
    <Modal
      forceRender
      destroyOnClose
      width={1000}
      open={open}
      title="연동 제품 선택"
      okText="선택"
      okButtonProps={{ disabled: utils.isEmpty(dataSourceToSubmit), loading: modalLoading }}
      onOk={form.submit}
      onCancel={onClose}
      afterClose={() => {
        form.resetFields();
        setDataSourceToSubmit([]);
        setConfirmModalOpen(false);
      }}
      maskClosable={false}
    >
      <Form
        layout="vertical"
        form={form}
        initialValues={initialValues}
        onFinish={(formData) => {
          if (mainPvsAssignedSubPv.length > 0) {
            setConfirmModalOpen(true);
          } else {
            onSubmit({ ...formData, mainPvIds });
          }
        }}
      >
        <Form.Item hidden name="subPvId">
          <Input />
        </Form.Item>
        <Space direction="vertical" size="large">
          <SpreadFilter
            currencySymbol="원"
            menu={filterStructure}
            onFilterChange={(filters) => {
              if (!open) {
                return;
              }
              const filterVariables = getFilterVariables(filters);
              const newQueryVariables = { ...queryVariables, filter: filterVariables };
              setQueryVariables(newQueryVariables);
              refetch(newQueryVariables);
            }}
            onFilterReset={() => {
              setQueryVariables(initialQueryVariables);
              refetch(initialQueryVariables);
            }}
          />
          <TransferTable<SearchMainPvs_search_edges_node>
            loading={!open || modalLoading}
            columns={columns}
            dataSource={dataSource}
            fetchMore={{ loading: modalLoading, hasMore, onFetchMore: loadMore }}
            upperTableProps={{ title: "제품 검색 결과" }}
            onChange={setDataSourceToSubmit}
          />
          <Card type="inner" title="제품 관리 이력">
            {makePvOrBpvManageEventFormItems({
              loading: modalLoading,
              manageEventType: ProductVariantManageEventTypeEnum.TYPE_SUB_PV,
              choices: productVariantManageEventTypeChoices,
            })}
          </Card>
        </Space>
      </Form>
      <ConfirmModal
        visible={confirmModalOpen}
        titleText="이미 다른 부자재로 연결된 제품은 지금 요청한 부자재로 변경됩니다. 이대로 진행하겠습니까?"
        onOk={() => {
          onSubmit({ ...form.getFieldsValue(), mainPvIds });
          setConfirmModalOpen(false);
        }}
