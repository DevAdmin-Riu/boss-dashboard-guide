import { ProductVariantFilterInput } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createTextField } from "@utils/filters/fields";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

enum SubPvSearchFilterKeys {
  productSearch = "productSearch",
}
type SubPvSearchFilters = Filters<SubPvSearchFilterKeys>;

interface SubPvSearchListFilterOpts {
  productSearch: FilterOpts<string>;
}

export const getFilterOpts = (filterVariables: ProductVariantFilterInput): SubPvSearchListFilterOpts => ({
  productSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
    value: filterVariables?.productSearch || "",
  },
});

export const createFilterStructure = (opts: SubPvSearchListFilterOpts): IFilter<SubPvSearchFilterKeys> => {
  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        SubPvSearchFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): SubPvSearchFilters {
  const { name } = filter;

  switch (name) {
    case SubPvSearchFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, SubPvSearchFilterKeys.productSearch);
  }
}

export function getFilterVariables(filters: Array<IFilterElement<string>>): ProductVariantFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return { ...queryParams, isSubPv: true, trackInventory: true };
}
