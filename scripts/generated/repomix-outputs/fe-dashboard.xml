  Typography,
} from "antd";
import { DefaultOptionType } from "antd/lib/select";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect } from "react";

import { useMoveRackStockDetailMutation } from "../api/mutations";
import {
  productVariantDetailsForStockActionQuery,
  rackStockListForStockActionQuery,
  rackStockListQuery,
  useProductVariantDetailsForStockActionQuery,
  useRackStockListForStockActionQuery,
} from "../api/queries";
import {
  RackStockList_rackStocks_edges_node,
  RackStockList_rackStocks_edges_node_location,
} from "../api/types/RackStockList";
import {
  RackStockListForStockAction_rackStocks_edges_node,
  RackStockListForStockAction_rackStocks_edges_node_location,
} from "../api/types/RackStockListForStockAction";
import { StockListModalModeEnum } from "../views/StockListView/StockListView";
import {
  getOuterVariantForStockAction,
  getUniqueRackLocationsByRackStocks,
  makeRackLocationLabel,
  ProductInfoForStockAction,
} from "./ProductInfoForStockAction";

interface RackStockDetailMoveModalProps {
  open: boolean;
  loading: boolean;
  productVariantId: string;
  rackLocation:
    | RackStockList_rackStocks_edges_node_location
    | RackStockListForStockAction_rackStocks_edges_node_location;
  rackStock: RackStockList_rackStocks_edges_node | RackStockListForStockAction_rackStocks_edges_node;
  onClose: () => void;
}

interface RackStockDetailMoveForm extends RackStockDetailMoveInput {
  limitAssigned: boolean;
}

export const RackStockDetailMoveModal: React.FC<RackStockDetailMoveModalProps> = (props) => {
  const { open, loading, productVariantId, rackLocation, rackStock, onClose } = props;
  const [form] = Form.useForm<RackStockDetailMoveForm>();
  const TypeSafeForm = getTypeSafeForm<RackStockDetailMoveForm>(form);
  const limitAssignedWatched = TypeSafeForm.getUseFormWatched({ name: "limitAssigned" }) ?? true;
  const fromQuantityWatched = TypeSafeForm.getUseFormWatched({ name: "fromQuantity" }) || 0;
  const toDetailsWatched = TypeSafeForm.getUseFormWatched({ name: "toDetails" }) || [];
  const selectedLocationIds = toDetailsWatched?.map((detail) => detail?.toRackLocation);

  const initialValues: RackStockDetailMoveForm = {
    stockDetail: rackStock?.stockDetail?.id || null,
    fromRackLocation: rackLocation?.id,
    fromQuantity: null,
    toDetails: [{ toRackLocation: null, toQuantity: null }],
    reason: null,
    limitAssigned: true,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open, loading]);

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantDetailsForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { id: productVariantId },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);
  const outerVariant = getOuterVariantForStockAction(productVariant);

  const { data: rackStockData, loading: rackStockLoading } = useRackStockListForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.rackStocks, filter: { productVariant: productVariantId } },
  });
  const rackStocks = maybe(() => rackStockData.rackStocks.edges.map((edge) => edge.node), []);

  const findRackStock = maybe(() => rackStocks?.find((rackStockItem) => rackStockItem.id === rackStock?.id), null);
  const {
    loadMore: loadMoreLocations,
    search: searchLocations,
    result: searchLocationsOpts,
  } = useRackLocationSearch({ skip: !open || limitAssignedWatched, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchLocationsOpts.data.search.edges.map((edge) => edge.node), []);

  const [moveRackStockDetail, moveRackStockDetailOpts] = useMoveRackStockDetailMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.moveRackStockDetail.errors, "재고 이동 완료", () => {
        onClose();
      }),
    refetchQueries: [rackStockListQuery, productVariantDetailsForStockActionQuery, rackStockListForStockActionQuery],
  });

  const rackLocationsFromRackStocks = getUniqueRackLocationsByRackStocks(rackStocks);
  const getToDetailsColumnsSettings = ({ remove }): ColumnsType<FormListFieldData> => [
    {
      title: columnNameConstant.stock.LOCATION,
      key: "toRackLocation",
      align: "center",
      width: 240,
      render: (_, record) => {
        const { name } = record;
        const rackLocationsWithSearched = [...rackLocationsFromRackStocks, ...searchedRackLocations].filter(
          (location, index, self) => self.findIndex((l) => l.id === location.id) === index
        );
        const targetRackLocations = limitAssignedWatched ? rackLocationsFromRackStocks : rackLocationsWithSearched;
        const uniqueRackLocations = targetRackLocations.filter(
          (location, index, self) =>
            index === self.findIndex((t) => t.id === location.id) && location.id !== rackLocation?.id
        );
        const locationOptions: DefaultOptionType[] = uniqueRackLocations.map((location) => {
          const rackStocksByLocation = rackStocks.filter((stock) => stock.location.id === location.id);
          const totalRemainQuantity = rackStocksByLocation.reduce((acc, stock) => acc + stock.remainQuantity, 0);
          return {
            label: makeRackLocationLabel(location, totalRemainQuantity),
            value: location.id,
            labelText: location.name,
            disabled: selectedLocationIds.includes(location.id),
          };
        });
        const fetchMoreData = {
          hasMore: maybe(() => searchLocationsOpts.data.search.pageInfo.hasNextPage),
          loading: searchLocationsOpts.loading,
          onFetchMore: loadMoreLocations,
        };

        return (
          <Form.Item style={{ margin: 0 }} name={[name, "toRackLocation"]} rules={[{ required: true }]}>
            <Select
              showSearch
              size="small"
              {...getMobileSelectClassName()}
              style={{ width: "100%" }}
              placeholder="로케이션 선택"
              notFoundContent="선택 가능한 로케이션이 없습니다."
              loading={fetchMoreData.loading}
              options={locationOptions}
              onSearch={searchLocations}
              onDropdownVisibleChange={(open) => {
                if (open) {
                  searchLocations("");
                }
              }}
              filterOption={(input, option) =>
                typeof option?.labelText === "string" &&
                (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())
              }
              onPopupScroll={({ currentTarget }) => {
                const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                const { hasMore, loading, onFetchMore } = fetchMoreData;
                // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                  onFetchMore();
                }
              }}
            />
          </Form.Item>
        );
      },
    },
    {
      title: "수량",
      key: "toQuantity",
      align: "center",
      width: 100,
      render: (_, record) => {
        const { name } = record;
        return (
          <Form.Item style={{ margin: 0 }} name={[name, "toQuantity"]} rules={[{ required: true }]}>
            <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} size="small" />
          </Form.Item>
        );
      },
    },
    {
      key: "action",
      align: "center",
      width: 50,
      render: (_, record) => (
        <Button type="text" icon={<DeleteFilled />} size="large" onClick={() => remove(record.name)} />
      ),
    },
  ];

  const onSubmit = (formData: RackStockDetailMoveForm) => {
    const { limitAssigned, ...input } = formData;
    moveRackStockDetail({ variables: { input } });
  };

  const modalLoading = loading || productVariantLoading || rackStockLoading || moveRackStockDetailOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      width={850}
      title="재고 이동"
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading, disabled: !productVariant || utils.isEmpty(toDetailsWatched) }}
      onCancel={onClose}
      zIndex={1001}
    >
      <Form
        form={form}
        initialValues={initialValues}
        name="rack-stock-detail-move-form"
        layout="vertical"
        onFinish={onSubmit}
        onValuesChange={(changedValues) => {
          if ("toDetails" in changedValues) {
            const toDetails: RackStockDetailMoveToDetail[] = TypeSafeForm.getFieldValue("toDetails");
            const totalToQuantity = toDetails.reduce((acc, detail) => acc + detail?.toQuantity || 0, 0);
            TypeSafeForm.setFields([{ name: "fromQuantity", value: totalToQuantity }]);
          }
        }}
        validateMessages={{ required: formRuleMsg.required }}
      >
        {findRackStock && (
          <ProductInfoForStockAction
            modalMode={StockListModalModeEnum.RackStockDetailMove}
            loading={productVariantLoading}
            product={productVariant?.product}
            outerVariant={outerVariant}
            productVariant={productVariant}
            forMove={{ rackLocation, rackStock: findRackStock }}
            isFbv={false}
          />
        )}
        <Divider />
        <Form.Item name={TypeSafeForm.getValidDataIndex("limitAssigned")} valuePropName="checked" noStyle>
          <Checkbox>연동된 로케이션에서만 검색</Checkbox>
        </Form.Item>
        <Form.List
          name={TypeSafeForm.getValidDataIndex("toDetails")}
          rules={[
            {
              validator: (_, value: RackStockDetailMoveToDetail[]) => {
                const totalToQuantity = value.reduce((acc, detail) => acc + detail.toQuantity, 0);
                if (utils.isEmpty(rackStock?.remainQuantity) || rackStock.remainQuantity < totalToQuantity) {
                  return Promise.reject(new Error("이동 수량이 선택한 상세 재고에 남아 있는 재고수량 보다 많습니다."));
                }
                if (fromQuantityWatched !== totalToQuantity) {
                  return Promise.reject(new Error("이동할 수량과 이동될 로케이션 수량의 합이 일치하지 않습니다."));
                }
                return Promise.resolve();
              },
            },
          ]}
        >
          {(fields, { add, remove }, { errors }) => {
            const tableTitle = () => (
              <Row justify="space-between">
                <Typography.Title level={5}>이동 로케이션</Typography.Title>
                <Button type="primary" size="small" onClick={() => add()}>
                  추가
                </Button>
              </Row>
            );
            const columns = getToDetailsColumnsSettings({ remove });
            const tableWidthSum = utils.calcTableColsWidthSum(columns);

            return (
              <Table
                {...commonTableProps}
                title={tableTitle}
                rowKey={(record) => record.key}
                columns={columns}
                dataSource={fields}
                scroll={{ x: tableWidthSum, y: 500 }}
                footer={() => <Form.ErrorList errors={errors} />}
              />
            );
          }}
        </Form.List>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/SectorOrLocationLabelPrintModal.tsx">
import { InfoCircleOutlined, MinusCircleOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { BarcodePrefixEnum, convertValueToBarcodeImgUrl } from "@utils/barcode/convertBarcode";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { wordDownload } from "@utils/word/wordDownload";
import {
  Button,
  Col,
  Divider,
  Form,
  Input,
  InputNumber,
  Modal,
  Radio,
  Row,
  Select,
  Space,
  Tooltip,
  Typography,
} from "antd";
import { Document, ImageRun, ISectionOptions, ISectionPropertiesOptions, Paragraph, TextRun } from "docx";
import React, { useEffect, useState } from "react";

import { useDownloadRackLocationListForLabelLazyQuery, useDownloadRackSectorListForLabelQuery } from "../api/queries";

interface ILocationBySectorForm {
  sectorName: string;
}

interface IStandardLocation {
  zoneName: string;
  columnStartNumber: number;
  columnEndNumber: number;
}
interface IEtcLocation {
  locationName: string;
}
interface ILocationByGeneratorForm {
  standardLocationList: IStandardLocation[];
  etcLocationList: IEtcLocation[];
}

type SectorOrLocationLabelPrintFormMode = "sector" | "locationBySector" | "locationByGenerator";

interface SectorOrLocationLabelPrintModalProps {
  open: boolean;
  loading: boolean;
  onClose: () => void;
}

export const SectorOrLocationLabelPrintModal: React.FC<SectorOrLocationLabelPrintModalProps> = (props) => {
  const { open, loading, onClose } = props;
  const [formMode, setFormMode] = useState<SectorOrLocationLabelPrintFormMode>("sector");
  const [locationBySectorForm] = Form.useForm<ILocationBySectorForm>();
  const [locationByGeneratorForm] = Form.useForm<ILocationByGeneratorForm>();

  const locationBySectorInitialValues: ILocationBySectorForm = { sectorName: null };
  const locationByGeneratorInitialValues: ILocationByGeneratorForm = {
    standardLocationList: [],
    etcLocationList: [],
  };

  useEffect(() => {
    if (open) {
      locationBySectorForm.resetFields();
      locationByGeneratorForm.resetFields();
    }
  }, [open]);

  const { data: sectorData, loading: sectorLoading } = useDownloadRackSectorListForLabelQuery({
    skip: !open,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.default },
  });
  const sectorList = maybe(() => sectorData.rackSectors.edges.map((edge) => edge.node), []);

  const [locationBySectorFetch] = useDownloadRackLocationListForLabelLazyQuery();

  const modalLoading = loading || sectorLoading;

  const formModeOptions: Array<{ label: string; value: SectorOrLocationLabelPrintFormMode }> = [
    { label: "구역", value: "sector" },
    { label: "로케이션(구역별)", value: "locationBySector" },
    { label: "로케이션(직접 입력)", value: "locationByGenerator" },
  ];
  const sectorOptions: Array<{ label: string; value: string }> = sectorList.map((sector) => ({
    label: sector.name,
    value: sector.name,
  }));

  const wordPageProperties: ISectionPropertiesOptions = {
    page: {
      size: { width: "140mm", height: "90mm" },
      margin: { top: "0.15cm", right: "0.2cm", bottom: "0.2cm", left: "0.2cm" },
    },
  };
  const onLabelPrint = async (title: string, nameList: string[], prefix: BarcodePrefixEnum) => {
    // 비동기 작업을 병렬로 처리
    const sections = await Promise.all<ISectionOptions>(
      nameList.map(async (name) => {
        const barcodeImgUrl = await convertValueToBarcodeImgUrl({ type: "qrcode", value: name, prefix });
        const barcodeImage = new ImageRun({
          type: "png",
          data: barcodeImgUrl,
          transformation: { width: 200, height: 200 },
        });

        return {
          properties: wordPageProperties,
          children: [
            new Paragraph({
              alignment: "center",
              children: [new TextRun({ text: name, bold: true, size: "40pt" })],
            }),
            new Paragraph({
              spacing: { before: 100 },
              alignment: "center",
              children: [barcodeImage],
            }),
          ],
        };
      })
    );

    const doc = new Document({ sections });
    wordDownload({ title, doc });
    onClose();
  };

  const onSectorLabelPrint = () => {
    const sectorNameList = sectorList.map((sector) => sector.name);
    const title = "구역 라벨";
    onLabelPrint(title, sectorNameList, BarcodePrefixEnum.SECTOR);
  };

  const onLocationBySectorLabelPrint = async (formData: ILocationBySectorForm) => {
    const { sectorName } = formData;
    const { data: rackLocationData } = await locationBySectorFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.commonMaxLimit,
        filter: { sectorSearch: sectorName, canPicking: true },
      },
    });
    const locationList = maybe(() => rackLocationData.rackLocations.edges.map((edge) => edge.node), []);
    const locationNameList = locationList.map((location) => location.name);
    const title = `${sectorName} 구역 라벨`;
    onLabelPrint(title, locationNameList, BarcodePrefixEnum.LOCATION);
  };

  const onLocationByGeneratorLabelPrint = async (formData: ILocationByGeneratorForm) => {
    const { standardLocationList, etcLocationList } = formData;
    const locationNameList: string[] = [];

    standardLocationList.forEach((location) => {
      const { zoneName, columnStartNumber, columnEndNumber } = location;
      const flattenedLocationNameList = Array.from(
        { length: columnEndNumber - columnStartNumber + 1 },
        (_, index) => `${zoneName}-${utils.fillZero(columnStartNumber + index, 2)}`
      );
      locationNameList.push(...flattenedLocationNameList);
    });

    etcLocationList.forEach((location) => {
      const { locationName } = location;
      locationNameList.push(locationName);
    });

    const title = "로케이션 라벨";
    onLabelPrint(title, locationNameList, BarcodePrefixEnum.LOCATION);
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title="구역 및 로케이션 라벨 출력"
      confirmLoading={modalLoading}
      okText="출력"
      onOk={() => {
        switch (formMode) {
          case "sector":
            onSectorLabelPrint();
            break;
          case "locationBySector":
            locationBySectorForm.submit();
            break;
          case "locationByGenerator":
            locationByGeneratorForm.submit();
            break;
          default:
            break;
        }
      }}
      onCancel={onClose}
    >
      <Space direction="vertical">
        <Space direction="vertical" size={0}>
          <Typography.Text strong>출력 모드 선택</Typography.Text>
          <Radio.Group
            options={formModeOptions}
            value={formMode}
            onChange={(e) => {
              const selectedMode = e.target.value;
              setFormMode(selectedMode);
            }}
          />
        </Space>
        {formMode !== "sector" && <Divider />}
        <Form
          hidden={formMode !== "locationBySector"}
          form={locationBySectorForm}
          name="location-by-sector-form"
          layout="vertical"
          initialValues={locationBySectorInitialValues}
          onFinish={onLocationBySectorLabelPrint}
        >
          <Form.Item
            name="sectorName"
            label="구역 선택"
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          >
            <Select options={sectorOptions} />
          </Form.Item>
        </Form>
        <Form
          hidden={formMode !== "locationByGenerator"}
          form={locationByGeneratorForm}
          name="location-by-generator-form"
          layout="vertical"
          initialValues={locationByGeneratorInitialValues}
          onFinish={onLocationByGeneratorLabelPrint}
        >
          <Space direction="vertical" size="large" split={<Divider />}>
            <Form.List name="standardLocationList">
              {(fields, { add, remove }) => (
                <>
                  <Row style={{ marginBottom: 8 }} justify="space-between" align="middle">
                    <Tooltip
                      title={
                        <Space direction="vertical" size={0}>
                          <>구간 알파벳: A, 시작 열 번호: 1, 끝 열 번호: 10 입력 시</>
                          <>A-01, A-02, ..., A-10 의 값이 바코드로 변환되어 출력됩니다.</>
                        </Space>
                      }
                    >
                      <Typography.Text strong>
                        로케이션(열 입력) <InfoCircleOutlined />
                      </Typography.Text>
                    </Tooltip>
                    <Button size="small" type="primary" onClick={() => add()}>
                      추가
                    </Button>
                  </Row>
                  <Space direction="vertical">
                    {fields.map(({ key, name, ...restField }) => (
                      <Row key={key} gutter={12} align="middle">
                        <Col span={8}>
                          <Form.Item
                            {...restField}
                            style={{ margin: 0 }}
                            name={[name, "zoneName"]}
                            rules={[{ required: true, message: formRuleMsg.required }]}
                          >
                            <Input placeholder="구간 알파벳" />
                          </Form.Item>
                        </Col>
                        <Col span={6}>
                          <Form.Item
                            {...restField}
                            style={{ margin: 0 }}
                            name={[name, "columnStartNumber"]}
                            rules={[{ required: true, message: formRuleMsg.required }]}
                          >
                            <InputNumber {...getInputNumberProps({})} placeholder="시작 열 번호" />
                          </Form.Item>
                        </Col>
                        <Col span={1}>
                          <Typography.Text strong>~</Typography.Text>
                        </Col>
                        <Col span={6}>
                          <Form.Item
                            {...restField}
                            style={{ margin: 0 }}
                            name={[name, "columnEndNumber"]}
                            rules={[{ required: true, message: formRuleMsg.required }]}
                          >
                            <InputNumber {...getInputNumberProps({})} placeholder="끝 열 번호" />
                          </Form.Item>
                        </Col>
                        <Col span={1}>
                          <MinusCircleOutlined onClick={() => remove(name)} />
                        </Col>
                      </Row>
                    ))}
                  </Space>
                </>
              )}
            </Form.List>
            <Form.List name="etcLocationList">
              {(fields, { add, remove }) => (
                <>
                  <Row style={{ marginBottom: 8 }} justify="space-between" align="middle">
                    <Typography.Text strong>로케이션(기타)</Typography.Text>
                    <Button size="small" type="primary" onClick={() => add()}>
                      추가
                    </Button>
                  </Row>
                  <Row gutter={[12, 8]}>
                    {fields.map(({ key, name, ...restField }) => (
                      <Col key={key} span={8}>
                        <Row gutter={4} wrap={false} align="middle">
                          <Col flex="1 1 auto">
                            <Form.Item
                              {...restField}
                              style={{ margin: 0 }}
                              name={[name, "locationName"]}
                              rules={[{ required: true, message: formRuleMsg.required }]}
                            >
                              <Input placeholder="로케이션명" />
                            </Form.Item>
                          </Col>
                          <Col flex="0 0 auto">
                            <MinusCircleOutlined onClick={() => remove(name)} />
                          </Col>
                        </Row>
                      </Col>
                    ))}
                  </Row>
                </>
              )}
            </Form.List>
          </Space>
        </Form>
      </Space>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDetailAddEtcModal.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useRackLocationSearch from "@src/api/searches/useRackLocationSearch";
import { StockDetailAddEtcInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { FetchMoreProps, StrictOmit } from "@src/global/core/types/types";
import { makeVendorDisplayName, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Col, DatePicker, Divider, Form, Input, InputNumber, Modal, Row, Select, Space, Typography } from "antd";
import React, { useEffect } from "react";

import { useAddEtcStockDetailMutation, useFbvStockAddEtcMutation } from "../../stock/api/mutations";
import {
  getOuterVariantForStockAction,
  ProductInfoForStockAction,
} from "../../stock/components/ProductInfoForStockAction";
import { StockListModalModeEnum } from "../../stock/views/StockListView/StockListView";
import { useProductVariantDetailsForStockActionQuery } from "../api/queries";

export interface StockDetailAddEtcModalProps {
  open: boolean;
  loading: boolean;
  productVariantId: string;
  onClose: () => void;
  isFbv: boolean;
}

interface StockDetailAddEtcForm extends StrictOmit<StockDetailAddEtcInput, "stock"> {
  limitAssigned: boolean;
}

export const StockDetailAddEtcModal: React.FC<StockDetailAddEtcModalProps> = (props) => {
  const { open, loading, productVariantId, onClose, isFbv } = props;
  const [form] = Form.useForm<StockDetailAddEtcForm>();
  const TypeSafeForm = getTypeSafeForm<StockDetailAddEtcForm>(form);
  const limitAssignedWatched = TypeSafeForm.getUseFormWatched({ name: "limitAssigned" }) ?? true;

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantDetailsForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { id: productVariantId, includeRackStocks: true },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);
  const outerVariant = getOuterVariantForStockAction(productVariant);
  const rackStocks = productVariant?.rackStocks || [];
  const vendorOptions = productVariantData?.productVariant.productVariantVendors.map((product_variant_vendor) => {
    const vendor = product_variant_vendor.vendor;
    let displayName = makeVendorDisplayName(vendor);
    if (vendor.id === productVariantData?.productVariant.defaultVariantVendor.vendor.id) {
      displayName = `(기본) ${displayName}`;
    }
    return { label: displayName, value: vendor.id };
  });
  vendorOptions?.push({ label: "알 수 없음", value: "" });

  const initialValues: StockDetailAddEtcForm = {
    rackLocation: null,
    quantity: null,
    costPriceExcludeVat: null,
    reason: null,
    limitAssigned: true,
    vendor: undefined,
  };

  const {
    loadMore: loadMoreLocations,
    search: onSearchRackLocations,
    result: searchLocationsOpts,
  } = useRackLocationSearch({ skip: !open || limitAssignedWatched, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchLocationsOpts.data.search.edges.map((edge) => edge.node), []);

  const fetchMoreRackLocations: FetchMoreProps = {
    hasMore: maybe(() => searchLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchLocationsOpts.loading,
    onFetchMore: loadMoreLocations,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [addEtcStockDetail, addEtcStockDetailOpts] = useAddEtcStockDetailMutation({
    onCompleted: (data) => {
      const errors = data.addEtcStockDetail?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("기타 입고 처리 완료");
        onClose();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [fbvStockAddEtc, fbvStockAddEtcOpts] = useFbvStockAddEtcMutation({
    onCompleted: (data) => {
      const errors = data.fbvStockAddEtc?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("기타 입고 처리 완료");
        onClose();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const onSubmit = (formData: StockDetailAddEtcForm) => {
    const { limitAssigned, vendor, ...input } = formData;
    const stockId = maybe(() => productVariant.stocks[0].id, null);
    const parsedVendor = utils.isEmpty(vendor, true) ? null : vendor;
    const expDate = formData?.expDate ? getDateByFormat(formData.expDate, onlyDateFormat) : undefined;
    if (isFbv) {
      fbvStockAddEtc({ variables: { input: { stock: stockId, quantity: input.quantity, reason: input.reason } } });
    } else {
      addEtcStockDetail({ variables: { input: { ...input, stock: stockId, vendor: parsedVendor, expDate } } });
    }
  };

  const modalLoading =
    loading || productVariantLoading || addEtcStockDetailOpts?.loading || fbvStockAddEtcOpts?.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      width={750}
      title="기타 입고"
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading, disabled: !productVariant }}
      onCancel={onClose}
    >
      <Form
        form={form}
        initialValues={initialValues}
        name="stock-detail-add-etc-form"
        layout="vertical"
        onFinish={onSubmit}
      >
        <Space size="small" direction="vertical">
          <ProductInfoForStockAction
            modalMode={StockListModalModeEnum.StockDetailAdd}
            loading={productVariantLoading}
            product={productVariant?.product}
            outerVariant={outerVariant}
            productVariant={productVariant}
            forAdd={{
              rackStocks,
              searchedRackLocations,
              fetchMoreRackLocations,
              onSearchRackLocations,
              watchedValues: { limitAssigned: limitAssignedWatched },
            }}
            isFbv={isFbv}
          />
          <Divider />
          <Row gutter={[12, 8]} justify="space-between">
            {isFbv === false && (
              <Col xs={24} sm={12}>
                <Form.Item
                  name="vendor"
                  required
                  label={columnNameConstant.vendor.VENDOR_NAME}
                  rules={[
                    {
                      validator: (_, value) => {
                        if (value === initialValues.vendor) {
                          return Promise.reject("협력사를 선택해 주세요.");
                        }
                        return Promise.resolve();
                      },
                    },
                  ]}
                >
                  <Select style={{ width: "100%" }} placeholder="협력사 선택" options={vendorOptions} />
                </Form.Item>
              </Col>
            )}
            <Col xs={24} sm={isFbv ? 24 : 12}>
              <Form.Item
                name="quantity"
                label={columnNameConstant.stock.PURCHASE_TOTAL_QTY}
                rules={[{ required: true, message: "입고 수량을 입력해주세요" }]}
              >
                <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} placeholder="입고 수량" min={1} />
              </Form.Item>
            </Col>
            {isFbv === false && (
              <>
                <Col xs={24} sm={12}>
                  <Form.Item
                    name="costPriceExcludeVat"
                    label={
                      <Space direction="horizontal">
                        <Typography.Text>협력사 매입가</Typography.Text>
                        <Typography.Text type="danger" strong>
                          (부가세 별도 가격으로 입력해주세요.)
                        </Typography.Text>
                      </Space>
                    }
                    rules={[
                      { required: true, message: "협력사 매입가를 배송비가 포함된 부가세 별도 가격으로 입력해주세요" },
                    ]}
                  >
                    <InputNumber
                      {...getInputNumberProps({ isCommaDisplay: true })}
                      placeholder="협력사 매입가(배송비 포함, 부가세 별도)"
                      min={1}
                    />
                  </Form.Item>
                </Col>
                <Col xs={24} sm={12}>
                  <Form.Item
                    name="expDate"
                    label={columnNameConstant.stock.EXP_DATE}
                    rules={[{ required: productVariant?.requiredExpDateMgmt, message: "유통기한을 입력해주세요" }]}
                  >
                    <DatePicker style={{ width: "100%" }} />
                  </Form.Item>
                </Col>
              </>
            )}
            <Col xs={24} sm={24}>
              <Form.Item
                name="reason"
                label="입고사유"
                rules={[{ required: true, message: "입고사유를 입력해주세요" }]}
              >
                <Input placeholder="입고사유" />
              </Form.Item>
            </Col>
          </Row>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDetailAdjustToZeroModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { StockDetailAdjustToZeroInput } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Descriptions, Form, Input, Modal, Space, Typography } from "antd";
import React, { useEffect } from "react";

import {
  ProductVariantList_productVariants_edges_node,
  ProductVariantList_productVariants_edges_node_product,
  ProductVariantList_productVariants_edges_node_stocks,
} from "../../products/api/types/ProductVariantList";
import { useAdjustToZeroStockDetailMutation } from "../api/mutations";

const { Item: FItem } = Form;
const { Item: DItem } = Descriptions;

interface StockDetailAdjustToZeroModalProps {
  open: boolean;
  loading: boolean;
  stockId: string;
  productVariant: Pick<ProductVariantList_productVariants_edges_node, "sku"> & {
    product: Pick<ProductVariantList_productVariants_edges_node_product, "name">;
    stocks: Array<Pick<ProductVariantList_productVariants_edges_node_stocks, "id" | "quantity">>;
  };
  onClose: () => void;
}

export const StockDetailAdjustToZeroModal: React.FC<StockDetailAdjustToZeroModalProps> = (props) => {
  const { open, loading, stockId, productVariant, onClose } = props;
  const [form] = Form.useForm<StockDetailAdjustToZeroInput>();
  const stockQuantity = productVariant?.stocks?.find((stock) => stock.id === stockId)?.quantity;

  const initialValues: StockDetailAdjustToZeroInput = {
    stock: stockId,
    reason: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [adjustToZeroStockDetail, adjustToZeroStockDetailOpts] = useAdjustToZeroStockDetailMutation({
    onCompleted: (data) => {
      const errors = data.adjustToZeroStockDetail.errors;
      if (errors.length === 0) {
        showNotificationSuccess("음수 재고 조정 완료");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onSubmit = (formData: StockDetailAdjustToZeroInput) => {
    if (stockQuantity >= 0) {
      showNotificationError(
        "음수가 된 부자재 재고에 대한 조정 기능입니다. 음수가 아닌 부자재 재고는 조정할 수 없습니다."
      );
      return;
    }
    adjustToZeroStockDetail({ variables: { input: formData } });
  };

  const modalLoading = loading || adjustToZeroStockDetailOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title="음수 재고 조정"
      confirmLoading={modalLoading}
      onOk={form.submit}
      onCancel={onClose}
    >
      <Form layout="vertical" form={form} initialValues={initialValues} onFinish={onSubmit}>
        <FItem hidden name="stock">
          <Input />
        </FItem>
        <Space direction="vertical" size="large">
          <Descriptions bordered size="small" title={`제품 정보(${productVariant?.sku || "-"})`} column={1}>
            <DItem label="제품명">{productVariant?.product.name || "-"}</DItem>
            <DItem label="재고 수량">
              <Typography.Text strong type="danger">
                <NumberComponent value={stockQuantity} />
              </Typography.Text>
            </DItem>
          </Descriptions>
          <FItem name="reason" label="재고 조정 사유" rules={[{ required: true, message: formRuleMsg.required }]}>
            <Input.TextArea placeholder="사유를 입력해주세요." />
          </FItem>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDetailEventLabelPrintModal.tsx">
import { MinusSquareOutlined, PlusSquareOutlined } from "@ant-design/icons";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { SearchStockDetailEventsForLabel_search_edges_node } from "@src/api/searches/types/SearchStockDetailEventsForLabel";
import useRackLocationSearch from "@src/api/searches/useRackLocationSearch";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getMobileSelectClassName } from "@src/app/components/antd/Select/SelectProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, onlyDateFormat } from "@src/app/providers/DateProvider";
import { FetchMoreProps } from "@src/global/core/types/types";
import { BarcodePrefixEnum, convertValueToBarcodeImgUrl } from "@utils/barcode/convertBarcode";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { wordDownload } from "@utils/word/wordDownload";
import { Button, Col, Form, Input, InputNumber, Modal, Row, Select, Space, Table, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import { ColumnsType } from "antd/lib/table";
import { Document, ImageRun, ISectionOptions, Paragraph, TextRun } from "docx";
import moment from "moment";
import React, { useEffect } from "react";

import { getLocationNameForLabel } from "../utils";
import { makeRackLocationLabel } from "./ProductInfoForStockAction";

interface ISplitData {
  locationName: string;
  labelQty: number;
}

interface IStockDetailEventForm {
  sku: string;
  productName: string;
  stockedDate: string;
  splitData: ISplitData[];
}

interface IStockDetailEventLabelPrintForm {
  stockDetailEvents: IStockDetailEventForm[];
}

interface StockDetailEventLabelPrintModalProps {
  open: boolean;
  loading: boolean;
  stockDetailEvents: SearchStockDetailEventsForLabel_search_edges_node[];
  onClose: () => void;
}

export const StockDetailEventLabelPrintModal: React.FC<StockDetailEventLabelPrintModalProps> = (props) => {
  const { open, loading, stockDetailEvents, onClose } = props;
  const [form] = Form.useForm<IStockDetailEventLabelPrintForm>();

  const initialValues: IStockDetailEventLabelPrintForm = {
    stockDetailEvents: stockDetailEvents.map((event) => ({
      sku: event.stock?.productVariant.sku,
      productName: utils.trim(event.stock?.productVariant.product.name),
      stockedDate: moment(event.stockedDate).format(onlyDateFormat),
      splitData: [
        {
          locationName: getLocationNameForLabel({ stockDetailEvent: event }),
          labelQty: event.quantity,
        },
      ],
    })),
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
    if (stockDetailEvents.length === 0) {
      onClose();
    }
  }, [open]);

  const {
    loadMore: loadMoreRackLocations,
    search: searchRackLocations,
    result: searchRackLocationsOpts,
  } = useRackLocationSearch({ variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchRackLocationsOpts.data.search.edges.map((edge) => edge.node), []);
  // value를 뮤테이션이나 데이터 변경에 전달하는 것이 아니라, 단순 출력용이므로 value에 location.name 사용
  const locationOptions: DefaultOptionType[] = searchedRackLocations.map((location) => ({
    label: makeRackLocationLabel(location, null, { direction: "vertical", size: 0 }),
    value: location.name,
  }));

  const fetchMoreRackLocations: FetchMoreProps = {
    hasMore: maybe(() => searchRackLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchRackLocationsOpts.loading,
    onFetchMore: loadMoreRackLocations,
  };

  const {
    product: { SKU, PRODUCT_NAME },
    stock: { PURCHASE_TOTAL_QTY },
    purchaseOrder: { STOCKED_DATE },
  } = columnNameConstant;
  const columns: ColumnsType<SearchStockDetailEventsForLabel_search_edges_node> = [
    {
      title: SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record, idx) => {
        const sku = record.stock?.productVariant.sku;

        return (
          <>
            <Form.Item name={[idx, "sku"]} hidden>
              <Input />
            </Form.Item>
            <Typography>{sku}</Typography>
          </>
        );
      },
    },
    {
      title: PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 150,
      render: (_, record, idx) => (
        <>
          <Form.Item name={[idx, "productName"]} hidden>
            <Input />
          </Form.Item>
          <Typography>{utils.trim(record.stock?.productVariant.product.name)}</Typography>
        </>
      ),
    },
    {
      title: STOCKED_DATE,
      key: "stockedDate",
      align: "center",
      width: 120,
      render: (_, record, idx) => (
        <>
          <Form.Item name={[idx, "stockedDate"]} hidden>
            <Input />
          </Form.Item>
          <DateTime date={record.stockedDate} onlyDate />
        </>
      ),
    },
    {
      title: "로케이션",
      key: "locationName",
      align: "center",
      width: 140,
      fixed: "right",
      onCell: () => ({ colSpan: 0 }),
    },
    {
      title: "라벨 수량",
      key: "labelQty",
      fixed: "right",
      align: "center",
      width: 100,
      onCell: () => ({ colSpan: 2 }),
      render: (_, record, idx) => (
        <Form.List
          name={[idx, "splitData"]}
          rules={[
            {
              validator: (_, value: ISplitData[]) => {
                if (!value || value.length === 0) {
                  return Promise.reject(new Error(formRuleMsg.required));
                }
                return Promise.resolve();
              },
            },
          ]}
        >
          {(fields, { add, remove }, { errors }) => (
            <Space direction="vertical" size="small">
              {fields.map(({ key, name }) => (
                <Row key={key} justify="space-between" gutter={[8, 0]}>
                  <Col span={2}>
                    {name === 0 ? (
                      <Button
                        type="text"
                        icon={<PlusSquareOutlined />}
                        onClick={() =>
                          add({
                            locationName: getLocationNameForLabel({ stockDetailEvent: record }),
                            labelQty: null,
                          })
                        }
                      />
                    ) : (
                      <Button danger type="text" icon={<MinusSquareOutlined />} onClick={() => remove(name)} />
                    )}
                  </Col>
                  <Col span={12}>
                    <Form.Item name={[name, "locationName"]} style={{ margin: 0 }}>
                      <Select
                        showSearch
                        size="small"
                        style={{ width: 120 }}
                        {...getMobileSelectClassName()}
                        placeholder="로케이션 선택"
                        loading={fetchMoreRackLocations.loading}
                        dropdownMatchSelectWidth={false}
                        options={locationOptions}
                        onSearch={searchRackLocations}
                        onSelect={(_, option) =>
                          form.setFieldValue(
                            ["stockDetailEvents", idx, "splitData", name, "locationName"],
                            option.value
                          )
                        }
                        onDropdownVisibleChange={(open) => {
                          if (open) {
                            searchRackLocations("");
                          }
                        }}
                        filterOption={(input, option) =>
                          typeof option?.value === "string" &&
                          (option?.value ?? "").toLowerCase().includes(input.toLowerCase())
                        }
                        onPopupScroll={({ currentTarget }) => {
                          const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                          const { hasMore, loading, onFetchMore } = fetchMoreRackLocations;
                          // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                          if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                            onFetchMore();
                          }
                        }}
                      />
                    </Form.Item>
                  </Col>
                  <Col span={10}>
                    <Form.Item
                      name={[name, "labelQty"]}
                      style={{ margin: 0 }}
                      rules={[{ required: true, type: "integer", min: 1, message: formRuleMsg.min(1) }]}
                    >
                      <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: "100%" }} />
                    </Form.Item>
                  </Col>
                </Row>
              ))}
              <Form.ErrorList errors={errors} />
            </Space>
          )}
        </Form.List>
      ),
    },
    {
      title: PURCHASE_TOTAL_QTY,
      key: "quantity",
      fixed: "right",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record.quantity} />,
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const onSubmit = async (formData: IStockDetailEventLabelPrintForm) => {
    const { stockDetailEvents } = formData;
    // stockDetailEvents의 분할된 만큼 페이지 분리, labelQty 값만큼 stockDetailEvents 늘리기
    const expandedStockDetailEvents: Array<IStockDetailEventForm & ISplitData> = stockDetailEvents.flatMap((event) => {
      const expandedEvent = [];
      const { splitData } = event;
      const expandedEventBySplitData = splitData.map((split) => ({ ...event, ...split }));
      expandedEventBySplitData.forEach((splitEvent, idx) => {
        if (idx > 0) {
          expandedEvent.push(null);
        }
        expandedEvent.push(...Array(splitEvent.labelQty).fill(splitEvent));
      });
      return expandedEvent;
    });

    const sections = await Promise.all<ISectionOptions>(
      expandedStockDetailEvents.map(async (event) => {
        if (utils.isEmpty(event)) {
          return {
            properties: {
              page: {
                size: { width: "53mm", height: "34mm" },
                margin: { top: "0.15cm", right: "0.2cm", bottom: "0.2cm", left: "0.2cm" },
              },
            },
            children: [],
          };
        }

        const { sku, productName, stockedDate, locationName } = event;
        const barcodeImgUrl = await convertValueToBarcodeImgUrl({ value: sku, prefix: BarcodePrefixEnum.PRODUCT });
        const barcodeImage = new ImageRun({
          type: "png",
          data: barcodeImgUrl,
          transformation: { width: 150, height: 20 },
        });

        return {
          properties: {
            page: {
              size: { width: "53mm", height: "34mm" },
              margin: { top: "0.15cm", right: "0.2cm", bottom: "0.2cm", left: "0.2cm" },
            },
          },
          children: [
            new Paragraph({
              alignment: "center",
              children: [new TextRun({ text: sku, bold: true, size: "21pt" })],
            }),
            new Paragraph({
              alignment: "center",
              children: [barcodeImage],
            }),
            new Paragraph({ spacing: { before: 80 }, children: [new TextRun({ text: productName, size: "7pt" })] }),
            new Paragraph({ children: [new TextRun({ text: stockedDate, size: "7pt" })] }),
            new Paragraph({ alignment: "right", children: [new TextRun({ text: locationName, size: "7pt" })] }),
          ],
        };
      })
    );

    const doc = new Document({ sections });
    wordDownload({ title: "입고 라벨", doc });
    onClose();
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      width={900}
      title="입고 라벨 출력"
      confirmLoading={loading}
      okText="출력"
      onOk={form.submit}
      onCancel={onClose}
    >
      <Form
        name="product-events-label-print-form"
        form={form}
        size="small"
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Space direction="vertical">
          <Typography.Text strong type="warning">
            아래 리스트의 제품 라벨을 출력하기 위한 문서를 다운로드합니다.
          </Typography.Text>
          <Row justify="space-between">
            <Col>
              <Typography.Text strong>
                출력할 라벨 총 {<NumberComponent value={stockDetailEvents.length} postFix="종" />}
              </Typography.Text>
            </Col>
          </Row>
          <Form.List name="stockDetailEvents">
            {() => (
              <Table
                {...commonTableProps}
                loading={loading}
                columns={columns}
                dataSource={stockDetailEvents}
                scroll={{ x: tableWidthSum, y: 500 }}
              />
            )}
          </Form.List>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDetailEventListModal.tsx">
import { StockDetailEventsEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { durationSettingsForDaily } from "@src/app/components/CustomRangePicker/settings";
import { NumberComponent } from "@src/app/components/Number";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import { DateTime } from "@src/app/providers/DateProvider/DateTime";
import { checkIsInteger, getUserName, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Col, DatePicker, Modal, Radio, RadioChangeEvent, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { Moment } from "moment";
import React, { useEffect, useState } from "react";

import {
  getCostPriceExcludeVatByStockDetailEvent,
  getFromLocationByStockDetailEvent,
  getQuantityByStockDetailEvent,
  getStockDetailEventListQueryVariables,
  getStockDetailEventTypeName,
  getToLocationByStockDetailEvent,
  getVendorByStockDetailEvent,
  makeStockDetailEventInfoText,
} from "../../stock/utils";
import { useStockDetailEventListQuery } from "../api/queries";
import { StockDetailEventList_stockDetailEventList_edges_node } from "../api/types/StockDetailEventList";

const { RangePicker } = DatePicker;

export interface StockDetailEventListModalProps {
  open: boolean;
  variantId: string;
  isFulfilledByVendor: boolean;
  stockId?: string;
  onClose: () => void;
}

export const StockDetailEventListModal: React.FC<StockDetailEventListModalProps> = (props) => {
  const { open, variantId, stockId, onClose, isFulfilledByVendor } = props;
  const [dataSource, setDataSource] = useState<StockDetailEventList_stockDetailEventList_edges_node[]>([]);
  const [selectedDuration, setSelectedDuration] = useState<[Moment, Moment] | null>(null);
  const [dateVariable, setDateVariable] = useState<[Moment, Moment] | null>(null);
  const { user } = useAuth();

  const isHqStaffFbvMode = user.isHqStaff && isFulfilledByVendor;
  const isVendorStaffFbvMode = user.isVendorStaff && isFulfilledByVendor;

  const fbvStockDetailEventListQueryVariable = {
    fbvBrandId: isHqStaffFbvMode ? user?.brand.id : undefined,
    fbvVendorId: isVendorStaffFbvMode ? user?.vendor.id : undefined,
  };

  const { data, loading } = useStockDetailEventListQuery({
    skip: open === false,
    variables: getStockDetailEventListQueryVariables(dateVariable, {
      filter: { variantId, stock: stockId, ...fbvStockDetailEventListQueryVariable },
    }),
  });

  useEffect(() => {
    const stockDetailEvents = maybe(() => data?.stockDetailEventList?.edges?.map((edge) => edge?.node), []);
    setDataSource(stockDetailEvents);
  }, [loading]);

  const handleClose = () => {
    onClose();
    setDateVariable(null);
    setSelectedDuration(null);
    setDataSource([]);
  };

  const onRadioChange = ({ target: { value } }: RadioChangeEvent) => setSelectedDuration(value);

  const columns: ColumnsType<StockDetailEventList_stockDetailEventList_edges_node> = [
    {
      title: "일자",
      key: "date",
      align: "center",
      width: 120,
      render: (_, record) => (maybe(() => record?.date) ? <DateTime date={record.date} onlyDate={true} /> : "-"),
    },
    {
      title: "구분",
      key: "type",
      align: "center",
      width: 100,
      render: (_, record) => getStockDetailEventTypeName(record?.type),
    },
    {
      title: "수량",
      key: "quantity",
      align: "right",
      width: 80,
      render: (_, record) => {
        const quantity = getQuantityByStockDetailEvent(record);
        const isNegative = quantity < 0;
        const isMoved = record.type === StockDetailEventsEnum.MOVE;
        const isAdjustedToZero = record.type === StockDetailEventsEnum.ADJUST_TO_ZERO;
        const isInteger = checkIsInteger(quantity);
        return (
          <Typography.Text strong type={isMoved || isAdjustedToZero ? null : isNegative ? "danger" : "success"}>
            {(isMoved || isAdjustedToZero || isNegative) === false && "+"}
            <NumberComponent value={quantity} digits={isInteger ? 0 : 1} />
          </Typography.Text>
        );
      },
    },
    {
      title: "잔여재고",
      key: "stockQtySnapshot",
      align: "right",
      width: 100,
      render: (_, record) => {
        const stockQtySnapshot = record.stockQtySnapshot;
        if (utils.isEmpty(stockQtySnapshot)) {
          return "-";
        }
        return <NumberComponent value={stockQtySnapshot} />;
      },
    },
    isFulfilledByVendor === false && {
      title: "출발 로케이션",
      key: "fromLocation",
      align: "center",
      width: 160,
      render: (_, record) => {
        const location = getFromLocationByStockDetailEvent(record);
        if (location === "-") {
          return "-";
        }

        const parameters = utils.jsonParseWrapper(record.parameters);
        const warehouseName = parameters?.from_address || parameters?.address || "";
        const sectorName = parameters?.from_sector || parameters?.sector || "";

        // 물류센터 있음
        if (warehouseName && warehouseName !== "-") {
          return (
            <>
              <Typography.Text>{warehouseName}</Typography.Text>
              <br />
              <Typography.Text>
                {sectorName && sectorName !== "-" ? `${sectorName} / ${location}` : location}
              </Typography.Text>
            </>
          );
        }

        // 물류센터 없음, 구역만
        if (sectorName && sectorName !== "-") {
          return `${sectorName} / ${location}`;
        }

        // 로케이션만
        return location;
      },
    },
    isFulfilledByVendor === false && {
      title: "도착 로케이션",
      key: "toLocation",
      align: "center",
      width: 160,
      render: (_, record) => {
        const location = getToLocationByStockDetailEvent(record);
        if (location === "-") {
          return "-";
        }

        const parameters = utils.jsonParseWrapper(record.parameters);
        const warehouseName = parameters?.to_address || parameters?.address || "";
        const sectorName = parameters?.to_sector || parameters?.sector || "";

        // 물류센터 있음
        if (warehouseName && warehouseName !== "-") {
          return (
            <>
              <Typography.Text>{warehouseName}</Typography.Text>
              <br />
              <Typography.Text>
                {sectorName && sectorName !== "-" ? `${sectorName} / ${location}` : location}
              </Typography.Text>
            </>
          );
        }

        // 물류센터 없음, 구역만
        if (sectorName && sectorName !== "-") {
          return `${sectorName} / ${location}`;
        }

        // 로케이션만
        return location;
      },
    },
    isFulfilledByVendor === false && {
      title: "협력사",
      key: "vendor",
      align: "left",
      width: 150,
      render: (_, record) => getVendorByStockDetailEvent(record),
    },
    isFulfilledByVendor === false && {
      title: "협력사 매입가",
      key: "costPriceExcludeVat",
      align: "right",
      width: 100,
      render: (_, record) => (
        <NumberComponent value={getCostPriceExcludeVatByStockDetailEvent(record)} includeCurrency />
      ),
    },
    {
      title: "처리 담당자",
      key: "staff",
      align: "center",
      width: 100,
      render: (_, record) => getUserName(record.user),
    },
    {
      title: "비고",
      key: "info",
      align: "left",
      width: 250,
      render: (_, record) => makeStockDetailEventInfoText(record, isFulfilledByVendor),
    },
  ].filter(Boolean) as ColumnsType<StockDetailEventList_stockDetailEventList_edges_node>;
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const modalTitle = "재고 내역" + (dataSource.length > 0 ? `(${dataSource[0].stock.productVariant.sku})` : "");
  return (
    <Modal
      open={open}
      title={modalTitle}
      onCancel={handleClose}
      width={800}
      footer={
        <Button type={"default"} onClick={handleClose}>
          뒤로
        </Button>
      }
    >
      <Space direction="vertical" size={16}>
        <Radio.Group value={selectedDuration} onChange={onRadioChange} buttonStyle="solid">
          <Row justify="space-between">
            {durationSettingsForDaily.map((item, index) => (
              <Col key={`duration-setting-${index}`}>
                <Radio.Button key={index} value={item.value}>
                  {item.label}
                </Radio.Button>
              </Col>
            ))}
          </Row>
        </Radio.Group>
        <Row gutter={12}>
          <Col flex={1}>
            <RangePicker
              allowEmpty={[true, true]}
              value={selectedDuration}
              onChange={(values) => setSelectedDuration(values)}
            />
          </Col>
          <Col>
            <Button
              type="primary"
              onClick={() => {
                if (selectedDuration === null || selectedDuration.includes(null)) {
                  setDateVariable(null);
                } else {
                  setDateVariable(selectedDuration);
                }
              }}
            >
              조회
            </Button>
          </Col>
        </Row>
        <Table
          {...commonTableProps}
          loading={loading}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum, y: 400 }}
        />
      </Space>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDetailLossModal.tsx">
import { StockDetailLossInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Divider, Form, Input, InputNumber, Modal, Space } from "antd";
import React, { useEffect } from "react";

import { useLossStockDetailMutation } from "../../stock/api/mutations";
import {
  getOuterVariantForStockAction,
  ProductInfoForStockAction,
} from "../../stock/components/ProductInfoForStockAction";
import { StockListModalModeEnum } from "../../stock/views/StockListView/StockListView";
import { useProductVariantDetailsForStockActionQuery } from "../api/queries";
import { findRackStockForStockAction } from "../utils";

export interface StockDetailLossModalProps {
  open: boolean;
  loading: boolean;
  productVariantId: string;
  onClose: () => void;
  isFbv: boolean;
}

export const StockDetailLossModal: React.FC<StockDetailLossModalProps> = (props) => {
  const { open, loading, productVariantId, onClose, isFbv } = props;
  const [form] = Form.useForm<StockDetailLossInput>();
  const rackLocationWatched = Form.useWatch("rackLocation", form);
  const stockDetailWatched = Form.useWatch("stockDetail", form);

  const initialValues: StockDetailLossInput = {
    rackLocation: null,
    stockDetail: null,
    quantity: null,
    reason: null,
    isFulfilledByVendor: false,
  };

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantDetailsForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { id: productVariantId, includeRackStocks: true },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);
  const outerVariant = getOuterVariantForStockAction(productVariant);
  const rackStocks = productVariant?.rackStocks || [];
  const stocks = productVariant?.stocks || [];
  const stockId = stocks[0]?.id;
  const selectedRackStock = findRackStockForStockAction(rackStocks, rackLocationWatched, stockDetailWatched);
  const maxQuantity = (isFbv ? stocks[0]?.quantity : selectedRackStock?.remainQuantity) || 0;

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [lossStockDetail, lossStockDetailOpts] = useLossStockDetailMutation({
    onCompleted: (data) => {
      const errors = data.lossStockDetail.errors;
      if (errors.length === 0) {
        showNotificationSuccess("로스 처리 완료");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onSubmit = (formData: StockDetailLossInput) => {
    lossStockDetail({
      variables: {
        input: {
          ...formData,
          isFulfilledByVendor: isFbv,
          stock: isFbv ? stockId : undefined,
        },
      },
    });
  };

  const modalLoading = loading || productVariantLoading || lossStockDetailOpts?.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      width={850}
      title="로스처리"
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading, disabled: !productVariant }}
      onCancel={onClose}
    >
      <Form
        form={form}
        initialValues={initialValues}
        name="stock-detail-loss-form"
        layout="vertical"
        onValuesChange={(changedValues) => {
          if ("rackLocation" in changedValues) {
            form.resetFields(["stockDetail"]);
          }
        }}
        onFinish={onSubmit}
      >
        <Space size="middle" direction="vertical">
          <ProductInfoForStockAction
            modalMode={StockListModalModeEnum.StockDetailLoss}
            loading={productVariantLoading}
            product={productVariant?.product}
            outerVariant={outerVariant}
            productVariant={productVariant}
            forLoss={{
              rackStocks,
              stocks,
              watchedValues: { rackLocation: rackLocationWatched, stockDetail: stockDetailWatched },
            }}
            isFbv={isFbv}
          />
          <Divider />
          <Form.Item
            name="quantity"
            label="로스수량"
            dependencies={["stockDetail"]}
            rules={[
              { required: true, message: "로스 처리할 수량을 입력해주세요." },
              {
                type: "integer",
                max: maxQuantity,
                message: `로스 처리할 수량이 재고수량(${maxQuantity})보다 많습니다.`,
              },
            ]}
          >
            <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} placeholder="로스수량" min={1} />
          </Form.Item>
          <Form.Item name="reason" label="사유" rules={[{ required: true, message: "로스 처리 사유를 입력해주세요." }]}>
            <Input placeholder="로스 사유" />
          </Form.Item>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/StockDivideOrCombineModal.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useRackLocationSearch from "@src/api/searches/useRackLocationSearch";
import { StockDetailCombineInput, StockDetailDivideInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getMobileSelectClassName } from "@src/app/components/antd/Select/SelectProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import FormSpacer from "@src/app/components/FormSpacer";
import { orderLineListForFulfillQuery } from "@src/app/views/order/orders/api/queries";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Checkbox, Col, Divider, Form, Input, InputNumber, Modal, Radio, Row, Select, Space, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import React, { useEffect, useState } from "react";

import { getQtyPerBoxUnitTypeText } from "../../products/utils/data";
import { calcPackCount } from "../../products/utils/utils";
import { useCombineStockDetailMutation, useDivideStockDetailMutation } from "../api/mutations";
import { useProductVariantDetailsForStockActionQuery } from "../api/queries";
import {
  ProductVariantDetailsForStockAction_productVariant_inner,
  ProductVariantDetailsForStockAction_productVariant_outer,
} from "../api/types/ProductVariantDetailsForStockAction";
import { findRackStockForStockAction } from "../utils";
import { StockListModalModeEnum } from "../views/StockListView/StockListView";
import {
  getUniqueRackLocationsByRackStocks,
  makeRackLocationLabel,
  ProductInfoForStockAction,
} from "./ProductInfoForStockAction";

interface StockDivideOrCombineModalProps {
  open: boolean;
  loading: boolean;
  fixedMode?: "divide" | "combine";
  productVariantId: string;
  onClose: () => void;
}

interface StockDivideOrCombineForm {
  isDivide: boolean;
  packCount: number;
  fromRackLocation: string;
  fromStockDetail: string;
  toRackLocation: string;
  // 소분 여부에 따라 실제 뮤테이션의 outerQuantity 산출(소분할 경우 outerQuantity = quantity, 결합할 경우 outerQuantity = quantity / packCount)
  quantity: number;
  reason: string;
  // 적재할 로케이션 검색 시, 연동된 로케이션 내에서만 검색할지 여부
  limitAssigned: boolean;
}

export const StockDivideOrCombineModal: React.FC<StockDivideOrCombineModalProps> = (props) => {
  const { open, loading, fixedMode = null, productVariantId, onClose } = props;
  // 소분 모드 시 소분, 결합 모드 시 결합의 대상이 되는 제품
  const [fromVariant, setFromVariant] = useState<
    ProductVariantDetailsForStockAction_productVariant_outer | ProductVariantDetailsForStockAction_productVariant_inner
  >(null);
  // 소분 모드 시 결합, 결합 모드 시 소분의 대상이 되는 제품
  const [toVariant, setToVariant] = useState<
    ProductVariantDetailsForStockAction_productVariant_outer | ProductVariantDetailsForStockAction_productVariant_inner
  >(null);

  const [form] = Form.useForm<StockDivideOrCombineForm>();
  const isDivideWatched = Form.useWatch("isDivide", form);
  const fromRackLocationWatched = Form.useWatch("fromRackLocation", form);
  const fromStockDetailWatched = Form.useWatch("fromStockDetail", form);
  const packCountWatched = Form.useWatch("packCount", form);
  const quantityWatched = Form.useWatch("quantity", form);
  const limitAssignedWatched = Form.useWatch("limitAssigned", form) ?? true;
  const outerQuantityWatched = utils.isEmpty(quantityWatched)
    ? "-"
    : isDivideWatched
    ? quantityWatched * packCountWatched
    : quantityWatched % packCountWatched === 0
    ? quantityWatched / packCountWatched
    : "-";

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantDetailsForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { id: productVariantId, includeRackStocks: true },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);
  const outerVariant = maybe(() => (productVariant.isInner ? productVariant.outer : productVariant), null);
  const innerVariant = maybe(() => (productVariant.isInner ? productVariant : productVariant.inner), null);

  const isFixedMode = utils.isEmpty(fixedMode) === false;
  const initialIsDivide = isFixedMode ? fixedMode === "divide" : !!productVariant?.isInner ? false : true;
  const initialPackCount =
    open && utils.isEmpty(productVariant) === false ? calcPackCount(outerVariant, innerVariant) : null;

  const initialValues = {
    isDivide: initialIsDivide,
    fromRackLocation: null,
    fromStockDetail: null,
    toRackLocation: null,
    packCount: initialPackCount,
    quantity: null,
    reason: "",
    limitAssigned: true,
  };

  const {
    loadMore: loadMoreLocations,
    search: onSearchRackLocations,
    result: searchLocationsOpts,
  } = useRackLocationSearch({ skip: !open || limitAssignedWatched, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchLocationsOpts.data.search.edges.map((edge) => edge.node), []);

  const fetchMoreRackLocations: FetchMoreProps = {
    hasMore: maybe(() => searchLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchLocationsOpts.loading,
    onFetchMore: loadMoreLocations,
  };

  useEffect(() => {
    if (open) {
      // 소분할 경우 아우터박스 제품, 결합할 경우 이너박스 제품을 fromVariant로 설정
      const newFromVariant = initialValues.isDivide ? outerVariant : innerVariant;
      setFromVariant(newFromVariant);
      // 소분할 경우 이너박스 제품, 결합할 경우 아우터박스 제품을 toVariant로 설정
      const newToVariant = initialValues.isDivide ? innerVariant : outerVariant;
      setToVariant(newToVariant);
      form.resetFields();
    }
  }, [productVariant]);

  const selectedRackStock = findRackStockForStockAction(
    fromVariant?.rackStocks,
    fromRackLocationWatched,
    fromStockDetailWatched
  );
  const maxQuantity = selectedRackStock?.remainQuantity || 0;

  const [divideStockDetail, divideStockDetailOpts] = useDivideStockDetailMutation({
    onCompleted: (data) => {
      const errors = data?.divideStockDetail.errors;
      if (errors.length === 0) {
        showNotificationSuccess("재고 소분이 정상적으로 처리되었습니다.");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    // 재고 제품 출고대기(합포장) 페이지에서 소분이 요구되는 케이스 존재
    refetchQueries: [orderLineListForFulfillQuery],
  });

  const [combineStockDetail, combineStockDetailOpts] = useCombineStockDetailMutation({
    onCompleted: (data) => {
      const errors = data?.combineStockDetail.errors;
      if (errors.length === 0) {
        showNotificationSuccess("재고 결합이 정상적으로 처리되었습니다.");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onSubmit = (formData: StockDivideOrCombineForm) => {
    const { isDivide, fromRackLocation, fromStockDetail, toRackLocation, packCount, quantity, reason } = formData;
    if (!innerVariant || !outerVariant) {
      showNotificationError("상품 정보를 불러오는 중입니다. 새로고침 후 다시 시도해주세요.");
      return;
    }
    if (utils.isEmpty(innerVariant.stocks) || innerVariant.stocks.length === 0) {
      showNotificationError(
        `이너박스(${innerVariant.sku}) 재고가 없습니다. 이너박스 제품의 재고를 등록한 후 다시 시도해주세요.`
      );
      return;
    }
    if (utils.isEmpty(outerVariant.stocks) || outerVariant.stocks.length === 0) {
      showNotificationError(
        `아우터박스(${outerVariant.sku}) 재고가 없습니다. 아우터박스 제품의 재고를 등록한 후 다시 시도해주세요.`
      );
      return;
    }
    const selectedRackStock = fromVariant?.rackStocks.find(
      (rackStock) => rackStock?.stockDetail?.id === fromStockDetail
    );
    const maxQuantity = selectedRackStock?.remainQuantity || 0;
    if (maxQuantity <= 0) {
      showNotificationError("전환 가능한 재고가 없습니다.");
      return;
    }
    if (quantity <= 0) {
      showNotificationError("전환할 수량은 0보다 커야합니다.");
      return;
    }
    if (quantity > maxQuantity) {
      showNotificationError("전환할 수량이 전체 재고보다 많습니다.");
      return;
    }
    if (isDivide === false) {
      if (quantity < packCount) {
        showNotificationError("결합할 수량은 pack(아우터박스 입수량 / 이너박스 입수량)보다 작을 수 없습니다.");
        return;
      }
      if (quantity % packCount !== 0) {
        showNotificationError("결합할 수량은 pack(아우터박스 입수량 / 이너박스 입수량)의 배수로 입력해주세요.");
        return;
      }
    }

    const outerQuantity = isDivide ? quantity : Math.floor(quantity / packCount);
    const input: StockDetailDivideInput | StockDetailCombineInput = {
      innerStock: innerVariant?.stocks[0].id,
      outerStock: outerVariant?.stocks[0].id,
      fromStockDetail,
      fromRackLocation,
      toRackLocation,
      outerQuantity,
      reason,
    };
    if (isDivide) {
      divideStockDetail({ variables: { input } });
    } else {
      combineStockDetail({ variables: { input } });
    }
  };

  const rackLocationsFromRackStocks = getUniqueRackLocationsByRackStocks(toVariant?.rackStocks);
  const rackLocationsWithSearched = [...rackLocationsFromRackStocks, ...searchedRackLocations].filter(
    (location, index, self) => self.findIndex((l) => l.id === location.id) === index
  );
  const targetRackLocations = limitAssignedWatched ? rackLocationsFromRackStocks : rackLocationsWithSearched;
  const locationOptions: DefaultOptionType[] = targetRackLocations.map((location) => ({
    label: makeRackLocationLabel(location),
    labelText: location.name,
    value: location.id,
  }));

  const modalLoading =
    loading || productVariantLoading || divideStockDetailOpts.loading || combineStockDetailOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      width={850}
      title="재고 전환"
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading }}
      onCancel={onClose}
    >
      <Form
        form={form}
        layout="vertical"
        name="stock-divide-or-combine"
        initialValues={initialValues}
        onValuesChange={(changedValues) => {
          if ("isDivide" in changedValues) {
            const newFromVariant = changedValues.isDivide ? outerVariant : innerVariant;
            const newToVariant = changedValues.isDivide ? innerVariant : outerVariant;
            setFromVariant(newFromVariant);
            setToVariant(newToVariant);
            form.resetFields(["quantity", "fromRackLocation", "fromStockDetail", "toRackLocation"]);
          }
          if ("fromRackLocation" in changedValues) {
            form.resetFields(["fromStockDetail"]);
          }
        }}
        onFinish={onSubmit}
      >
        <Form.Item name="isDivide">
          <Radio.Group disabled={isFixedMode}>
            <Radio value={true}>소분(아우터 ➝ 이너)</Radio>
            <Radio value={false}>결합(이너 ➝ 아우터)</Radio>
          </Radio.Group>
        </Form.Item>

        <ProductInfoForStockAction
          modalMode={StockListModalModeEnum.StockDetailDivideOrCombine}
          loading={productVariantLoading}
          product={productVariant?.product}
          outerVariant={outerVariant}
          productVariant={fromVariant}
          forDivideOrCombine={{
            rackStocks: fromVariant?.rackStocks || [],
            watchedValues: { fromRackLocation: fromRackLocationWatched, fromStockDetail: fromStockDetailWatched },
          }}
          isFbv={false} // 소분/결합은 FBV 재고가 아닌 재고에서만 가능
        />
        <Divider />
        <FormSpacer />
        <Form.Item
          name="toRackLocation"
          label={
            <Space>
              <Typography>적재할 로케이션</Typography>
              <Form.Item name="limitAssigned" valuePropName="checked" noStyle>
                <Checkbox>
                  <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
                    연동된 로케이션에서만 검색
                  </Typography.Text>
                </Checkbox>
              </Form.Item>
            </Space>
          }
          rules={[{ required: true, message: "적재할 로케이션을 선택해주세요." }]}
        >
          <Select
            showSearch
            {...getMobileSelectClassName()}
            style={{ width: "100%" }}
            placeholder="적재할 로케이션 선택"
            notFoundContent="선택 가능한 로케이션이 없습니다."
            loading={fetchMoreRackLocations.loading}
            options={locationOptions}
            onSearch={onSearchRackLocations}
            onDropdownVisibleChange={(open) => {
              if (open) {
                onSearchRackLocations("");
              }
            }}
            filterOption={(input, option) =>
              typeof option?.labelText === "string" &&
              (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())
            }
            onPopupScroll={({ currentTarget }) => {
              const { scrollHeight, scrollTop, clientHeight } = currentTarget;
              const { hasMore, loading, onFetchMore } = fetchMoreRackLocations;
              // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
              if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                onFetchMore();
              }
            }}
          />
        </Form.Item>
        <FormSpacer />

        <Space direction="vertical" size="small">
          <Typography.Text strong>{columnNameConstant.product.PRODUCT_QTY_PER_BOX}</Typography.Text>
          <Row justify="space-between" align="bottom">
            <Col span={7}>
              <FormFieldAntd label={innerVariant?.sku}>
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  disabled
                  style={{ width: "100%" }}
                  value={innerVariant?.qtyPerBox}
                  addonAfter={getQtyPerBoxUnitTypeText(outerVariant?.qtyPerBoxUnitType)}
                />
              </FormFieldAntd>
            </Col>
            <Typography.Text strong>X</Typography.Text>
            <Col span={7}>
              <FormFieldAntd label="pack">
                <Form.Item name="packCount" noStyle>
                  <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} disabled style={{ width: "100%" }} />
                </Form.Item>
              </FormFieldAntd>
            </Col>
            <Typography.Text strong>=</Typography.Text>
            <Col span={7}>
              <FormFieldAntd label={outerVariant?.sku}>
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  disabled
                  style={{ width: "100%" }}
                  value={outerVariant?.qtyPerBox}
                  addonAfter={getQtyPerBoxUnitTypeText(outerVariant?.qtyPerBoxUnitType)}
                />
              </FormFieldAntd>
            </Col>
          </Row>
        </Space>

        <FormSpacer />

        <Row justify="space-between">
          <Col span={7}>
            <FormFieldAntd label={isDivideWatched ? "아우터박스 재고" : "이너박스 재고"}>
              <InputNumber
                {...getInputNumberProps({ isCommaDisplay: true })}
                disabled
                style={{ width: "100%" }}
                value={maxQuantity}
              />
            </FormFieldAntd>
          </Col>
          <Col span={7}>
            <FormFieldAntd label={isDivideWatched ? "소분대상" : "결합대상"}>
              <Form.Item
                name="quantity"
                dependencies={["fromStockDetail"]}
                rules={[
                  { required: true, message: "수량을 입력해주세요." },
                  {
                    type: "number",
                    max: maxQuantity,
                    message: `재고수량(${maxQuantity})보다 큰 수량은 입력할 수 없습니다.`,
                  },
                  {
                    validator: (_, value) => {
                      // 재고 결합인 경우, 수량을 packCount의 배수 단위로 입력하지 않으면 validate
                      if (isDivideWatched === false) {
                        if (value % packCountWatched !== 0) {
                          return Promise.reject("결합할 수량은 pack의 배수로 입력해주세요.");
                        }
                      }
                      return Promise.resolve();
                    },
                  },
                ]}
              >
                <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: "100%" }} min={0} />
              </Form.Item>
            </FormFieldAntd>
          </Col>
          <Col span={7}>
            <FormFieldAntd label={isDivideWatched ? "전환된 이너박스" : "결합된 아우터박스"}>
              <Input disabled style={{ width: "100%", color: "green" }} value={outerQuantityWatched} />
            </FormFieldAntd>
          </Col>
        </Row>
      </Form>
    </Modal>
  );
};
</file>

