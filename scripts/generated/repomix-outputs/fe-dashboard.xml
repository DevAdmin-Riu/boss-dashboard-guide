  const acceptedStatusAtColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> =
    createChangeTimeOrWriterColumn({
      status: RequestBossProductStatusEnum.ACCEPTED,
      title: columnNameConstant.requestProduct.ACCEPTED_DATE,
      key: "acceptedStatusAt",
