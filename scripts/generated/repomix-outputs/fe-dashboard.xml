import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

import { brandContractTypeChoices, salesStatShowColumnTypeChoices } from "../../utils";
import { SalesStatShowColumnType } from "../../views/SalesStatListView/filters";

export enum SalesStatFilterKeys {
  statDate = "statDate",
  brandSearch = "brandSearch",
  includeBossMrkt = "includeBossMrkt",
  isRunning = "isRunning",
  columns = "columns",
  contractType = "contractType",
}

export interface SalesStatListFilterOpts {
  statDate: FilterOpts<MinMax>;
  brandSearch: FilterOpts<string>;
  includeBossMrkt: FilterOpts<boolean>;
  isRunning: FilterOpts<boolean>;
  columns: FilterOpts<SalesStatShowColumnType[]>;
  contractType: FilterOpts<BrandContractTypeEnum[]>;
}

export function createFilterStructure(opts: SalesStatListFilterOpts): IFilter<SalesStatFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createMonthField(
        displayOrder++,
        SalesStatFilterKeys.statDate,
        filterNameConstant.STAT_DATE,
        opts.statDate.value
      ),
      active: opts.statDate.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatFilterKeys.columns,
        "카테고리",
        opts.columns.value,
        true,
        salesStatShowColumnTypeChoices
      ),
      active: opts.columns.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatFilterKeys.includeBossMrkt,
        filterNameConstant.INCLUDE_BOSS_MRKT,
        opts.includeBossMrkt.value,
        {
          negative: "미포함",
          positive: "포함",
        }
      ),
      active: opts.includeBossMrkt.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatFilterKeys.contractType,
        "계약방식",
        opts.contractType.value,
        true,
        brandContractTypeChoices
      ),
      active: opts.contractType.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createBooleanField(displayOrder++, SalesStatFilterKeys.isRunning, "계약상태", opts.isRunning.value, {
        negative: "종결",
        positive: "운영",
      }),
      active: opts.isRunning.active,
    },
  ];
}
