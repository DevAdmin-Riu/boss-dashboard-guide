import { message, notification } from "antd";
import { ArgsProps } from "antd/lib/notification";
import DOMPurify from "dompurify";
import React from "react";

export const notificationConfigDoNotDismiss: ArgsProps = {
  message: "",
  placement: "top",
  duration: 0,
};
export const notificationConfigAutoDismiss: ArgsProps = {
  message: "",
  placement: "top",
  duration: 5,
};

export const notificationConfigAutoQuickDismiss: ArgsProps = {
  message: "",
  placement: "top",
  duration: 1.5,
};

export const settingNotificationDefault = () => {
  notification.config(notificationConfigAutoDismiss);
};

export const showNotificationSuccess = (
  message: React.ReactNode,
  autoDismiss = true,
  quickDismiss = false,
  key = undefined
) => {
  const isString = typeof message === "string";
  const sanitizedErrorMessage = isString ? DOMPurify.sanitize(message) : message;
  const finalMessage = isString ? (
    <>
      <div dangerouslySetInnerHTML={{ __html: sanitizedErrorMessage as string }} />
    </>
  ) : (
    sanitizedErrorMessage
  );
  if (autoDismiss) {
    notification.success({
      ...(quickDismiss ? notificationConfigAutoQuickDismiss : notificationConfigAutoDismiss),
      message: finalMessage,
      key,
    });
  } else {
    notification.success({
      ...notificationConfigDoNotDismiss,
      message: finalMessage,
      key,
    });
  }
  return notification;
};

export const showNotificationSuccessQuickDismiss = (message: React.ReactNode) => {
  showNotificationSuccess(message, true, true);
};

