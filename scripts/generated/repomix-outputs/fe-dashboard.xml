import makeMutation from "@hooks/makeMutation";
import { addressFragment } from "@src/api/fragments/address";
import { shopErrorFragment } from "@src/api/fragments/errors";
import {
  boxSpecForPickingOrderFragment,
  mobileAppInfoFragment,
  shopBannerFragment,
  shopForSiteSettingsFragment,
} from "@src/api/fragments/shop";
import gql from "graphql-tag";

