      displayOrder++,
      OrderDeliveryFilterKeys.paymentSearch,
      "결제번호",
      opts.paymentSearch.value,
      "결제번호로 검색"
    ),
    active: opts.paymentSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(displayOrder++, OrderDeliveryFilterKeys.userSearch, "점주 ID / 점주명", opts.userSearch.value),
    active: opts.userSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderDeliveryFilterKeys.brandSearch,
      isB2b ? filterNameConstant.BRAND_SEARCH_FOR_B2B : filterNameConstant.BRAND_SEARCH,
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderDeliveryFilterKeys.brandStoreSearch,
      filterNameConstant.BRAND_STORE_SEARCH,
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const orderCreatedFilter = {
    ...createDateField(
      displayOrder++,
      OrderDeliveryFilterKeys.orderCreated,
      filterMsg.orderCreated,
      opts.orderCreated.value
    ),
    active: opts.orderCreated.active,
  };
  const orderCapturedAtFilter = {
    ...createDateField(
      displayOrder++,
      OrderDeliveryFilterKeys.orderCapturedAt,
      filterMsg.orderCapturedAt,
      opts.orderCapturedAt.value
    ),
    active: opts.orderCapturedAt.active,
  };
  const orderCapturedAtTimeFilter = {
    ...createDateTimeField(
      displayOrder++,
      OrderDeliveryFilterKeys.orderCapturedAtTime,
      filterMsg.orderCapturedAtTime,
      opts.orderCapturedAtTime.value
    ),
    active: opts.orderCapturedAtTime.active,
  };
  const createdFilter = {
    ...createDateField(
      displayOrder++,
      OrderDeliveryFilterKeys.created,
      filterMsg.fulfillmentCreated,
      opts.created.value
