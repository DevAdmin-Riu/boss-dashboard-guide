export function getB2bSettlementListTableSettings(props: IPurchaseTableSettingsProps) {
  const { routeParams, editingProps, formValuesWatched } = props;
  const isEditRequest = routeParams.status === "edit-request";
  const isClosingStatementList = routeParams.status === "closing-statement";
  const isPending = routeParams.status === "pending";
  const columns = [
    (isClosingStatementList || isPending) && makeStatusCol(isClosingStatementList || isPending),
    makeOrderComposedIdColumn(), // 주문번호
    makeOrderLineComposedIdColumn(), // 주문상세번호
    makeSalesCloseDateCol(), // 정산월
    makeOrderCreatedCol(), // 주문일
    makeB2bInvoicePrintedAt(editingProps), // 납품일
    !isClosingStatementList && !isPending && makeStatusCol(false), // 검토상태
    makeReqRevisionReasonColumn(), // 수정 요청사유
    brandCodeColumn(), // 브랜드코드
    brandNameColumn(), // 브랜드명
    makeProductSkuColumn(), // 제품코드
    makeProductNameColumn(), // 제품명
    makeBpSkuColumn(), // 상품코드
    makeBrandProductNameColumn(), // 상품명
    makeVariantNameColumn(), // 옵션명
    makeSpecTextColumn(), // 상세정보
    makeAttributeQuantityColumn(), // 수량
    makeTaxFreeOrNotColumn(), // 과세 여부
    makeOrderLineQuantityColumn(editingProps), // 납품 수량
    makeUnitPriceExcludeVatColumn(editingProps),
    makeB2bDeliveryFeeExcludeVatCol(editingProps),
    makeB2bTotalAmountExcludeVatCol(editingProps, formValuesWatched),
    makeB2bTotalVatAmountCol(editingProps, formValuesWatched), // 부가세
    makeB2bTotalAmountCol(editingProps, formValuesWatched), // 총합계
    makeOrderTypeColumn(), // 주문 구분
    (isClosingStatementList || isEditRequest) && editingProps && makeUpdateCol(editingProps),
    isPending && makeB2bUpdateRequestButtonCol(props.onShowReqRevisionModal),
  ].filter(Boolean);

  return columns;
}

