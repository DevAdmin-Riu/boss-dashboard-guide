  titleExcel: "매익률 (%) (ⓟ/ⓜ)",
  key: "profitRate",
  width: 120,
  align: "right",
  render: (_, record) => {
    const { purchaseOrder, variant, orderLine } = record;
    const poLineTotalPriceExcludeVat = calcPoLineTotalPriceExcludeVatWatched(props, record);
    const orderLineTotalPriceExcludeVat = calcOrderLineTotalPriceExcludeVat(
      orderLine.unitPriceGrossAmount,
      getPoLineExpectedPurchaseQty(purchaseOrder.eventType, record),
      orderLine.b2bDeliveryFeeExcludeVat,
      orderLine.isTaxFree,
      variant.priceDecimalPlaces
    );
    return utils.calcProfitRate(orderLineTotalPriceExcludeVat, poLineTotalPriceExcludeVat);
  },
});

const makeProfitInfoColumns = (
  props: StrictOmit<PurchaseOrderLineColProps, "sign" | "isVendorStaff">
): DownloadableEditableColumnsGroupType<PurchaseOrderLineList_purchaseOrderLines_edges_node> => ({
