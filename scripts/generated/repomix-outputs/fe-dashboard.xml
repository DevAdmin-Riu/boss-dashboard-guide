import { User } from "@src/api/fragments/types/User";
import { BrandStoreStatusEnum } from "@src/api/types/globalTypes";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { FromHqNoticeForHqDashboardList_fromHqNotices_edges_node } from "@src/app/views/hqStaff/hqHome/api/types/FromHqNoticeForHqDashboardList";
import { FromHqNotices_fromHqNotices_edges_node } from "@src/app/views/notice/notices/api/types/FromHqNotices";
import { utils } from "@utils/utils";
import { Table, Tag, Typography } from "antd";
import React from "react";

import { HqToUserNoticeListPageProps } from "./HqToUserNoticeListPage";

const { Text } = Typography;

export const makeNoticeIsFixedTag = (record: Pick<FromHqNotices_fromHqNotices_edges_node, "isFixed">) => {
  const tagText = record.isFixed ? "고정" : "일반";
  const tagColor = record.isFixed ? "error" : "processing";
  return <Tag color={tagColor}>{tagText}</Tag>;
};

type TNoticeToCalcReadRate =
  | FromHqNotices_fromHqNotices_edges_node
  | FromHqNoticeForHqDashboardList_fromHqNotices_edges_node;
const calcNoticeReadRate = (
  record: TNoticeToCalcReadRate,
  targetField: keyof TNoticeToCalcReadRate["noticeAvailableBrandStores"][number]
): number => {
  const noticeAvailableBrandStores = record.noticeAvailableBrandStores || [];
  const readCount = noticeAvailableBrandStores.filter((s) => {
    const value = s[targetField];
    if (typeof value === "boolean") {
      return value;
    }
    return false;
  }).length;

  let denominator = 0;
  if (record.availableToAllBrandStores) {
    denominator = record.ownerBrand?.numberOfActiveStores || 0;
  } else {
    denominator = noticeAvailableBrandStores.filter(
      (s) => s.brandStore && s.brandStore.status !== BrandStoreStatusEnum.STOPPED
    ).length;
  }
  if (denominator === 0) {
    return 0;
  }
  return readCount / denominator;
};

export const calcNoticeReadRateText = (
  record: TNoticeToCalcReadRate,
  targetField: keyof TNoticeToCalcReadRate["noticeAvailableBrandStores"][number]
): string => {
  const value = calcNoticeReadRate(record, targetField);
  return utils.convertToPercentFromDecimal(value);
};

export const getHqToUserNoticeListTableSettings = (props: HqToUserNoticeListPageProps) => {
  const { user, onRowClick } = props;
  const isStaff = user.isStaff;

  const brandCodeColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.brand.BRAND_CODE,
    width: 100,
    align: "center",
    key: "brandCode",
    render: (_, record) => record.ownerBrand?.code,
  };

  const brandNameColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.brand.BRAND_NAME,
    width: 100,
    align: "center",
    key: "brandName",
    render: (_, record) => record.ownerBrand?.name,
  };

  const isFixedColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.TYPE,
    width: 60,
    align: "center",
    key: "isFixed",
    render: (_, record) => makeNoticeIsFixedTag(record),
    renderExcel: (record) => (record.isFixed ? "고정" : "일반"),
  };

  const titleColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.common.TITLE,
    width: 200,
    key: "title",
    render: (_, record) => <Typography.Link onClick={() => onRowClick(record.id)}>{record.title}</Typography.Link>,
    renderExcel: (record) => record.title,
  };

  const writerColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.WRITER_ID,
    width: 100,
    align: "center",
    key: "writer",
    render: (_, record) => `${record.writer?.firstName}(${record.writer?.loginId})`,
  };

  const availableBrandStoresColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.AVAILABLE_BRAND_STORE,
    width: 140,
    align: "center",
    key: "availableBrandStores",
    render: (_, record) => {
      if (record.availableToAllBrandStores) {
        return "전체 공개";
      }
      const stores = record.noticeAvailableBrandStores || [];
      const names = stores.map((s) => s.brandStore.name);
      if (names.length <= 3) {
        return names.join(", ");
      }
      const displayed = names.slice(0, 3).join(", ");
      const remainingCount = names.length - 3;
      return `${displayed} 외 ${remainingCount}지점`;
    },
  };

  const isReadRateColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.READ_RATE_PERCENT.join(""),
    width: 80,
    align: "center",
    key: "isReadRate",
    render: (_, record) => calcNoticeReadRateText(record, "isRead"),
  };

  const hasConfirmedRateColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.CONFIRMED_RATE_PERCENT.join(""),
    width: 80,
    align: "center",
    key: "hasConfirmedRate",
    render: (_, record) => calcNoticeReadRateText(record, "hasConfirmed"),
  };

  const numberOfQasColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.notice.COMMENT_COUNT_NOT_ANSWERED,
    width: 120,
    align: "center",
    key: "numberOfQas",
    render: (_, record) => {
      const noticeBrandStoresQas = record.noticeBrandStoresQas || [];

      const totalCount = noticeBrandStoresQas.length;
      const unansweredCount = noticeBrandStoresQas.filter((qa) => !qa.isAnswered).length;

      return `${totalCount}(${unansweredCount})`;
    },
  };

  const createdAtColumn: DownloadableColumnType<FromHqNotices_fromHqNotices_edges_node> = {
    title: columnNameConstant.common.REGISTERED_DATE,
    key: "createdAt",
    align: "center",
    width: 120,
    render: (_, record) => <DateTime date={record?.createdAt} onlyDate />,
    renderExcel: (record) => getDateByFormat(record?.createdAt, onlyDateFormat) || "-",
  };

  const columns: DownloadableColumnsType<FromHqNotices_fromHqNotices_edges_node> = [
    isStaff && brandCodeColumn,
    isStaff && brandNameColumn,
    isFixedColumn,
    titleColumn,
    writerColumn,
    availableBrandStoresColumn,
    isReadRateColumn,
    hasConfirmedRateColumn,
    numberOfQasColumn,
    createdAtColumn,
  ].filter(Boolean);

  return columns;
};

export const getHqToUserNoticeListTableSummary = (
  tableData: readonly FromHqNotices_fromHqNotices_edges_node[],
  user: User
) => {
  const isStaff = user.isStaff;
  const totalCount = tableData.length;
  const totalCountColSpan = isStaff ? 6 : 4;

  let totalIsReadRate = 0;
  let totalHasConfirmedRate = 0;

  tableData.forEach((record) => {
    totalIsReadRate += calcNoticeReadRate(record, "isRead");
    totalHasConfirmedRate += calcNoticeReadRate(record, "hasConfirmed");
  });

  const totalIsReadRateText = utils.convertToPercentFromDecimal(totalIsReadRate / totalCount);
  const totalHasConfirmedRateText = utils.convertToPercentFromDecimal(totalHasConfirmedRate / totalCount);

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center" colSpan={totalCountColSpan}>
          <Text strong>평균 (총 {totalCount}건)</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="center">
          <Text strong>
            <NumberComponent value={totalIsReadRateText} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="center">
          <Text strong>
            <NumberComponent value={totalHasConfirmedRateText} />
          </Text>
        </Table.Summary.Cell>
      </Table.Summary.Row>
    </Table.Summary>
  );
};
</file>

