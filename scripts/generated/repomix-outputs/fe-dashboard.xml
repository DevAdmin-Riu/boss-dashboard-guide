    typeColumn,
    statusColumn,
    phoneColumn,
    emailColumn,
    contractColumn,
    bizRegNoColumn,
    bizCorpNameColumn,
    bizCeoNameColumn,
    bizTypeColumn,
    bizClassColumn,
    regionInfoNameColumn,
    addressColumn,
    hqStaffBrandStoresColumn,
    createdColumn,
    !isHqStaff && brandCodeColumn,
    !isHqStaff && brandNameColumn,
    !isHqStaff && vactAcctBankNameColumn,
    !isHqStaff && vactAcctNoColumn,
  ];
  return columns.filter(Boolean);
