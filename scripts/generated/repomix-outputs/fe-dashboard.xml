import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { NoticeInput } from "@src/api/types/globalTypes";
import { cleanFormDataUploadInputs } from "@src/app/components/antd/Form/utils";
import AssignBrandDialog from "@src/app/components/AssignBrandDialog";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { convertMarkdownToContentJsonStr } from "@src/app/components/Editor/utils";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import {
  useAssignBrandsToNoticeMutation,
  useNoticeDeleteMutation,
  useNoticeUpdateMutation,
  useUnassignBrandsFromNoticeMutation,
} from "../api/mutations";
import { useNoticeDetailsQuery } from "../api/queries";
import NoticeDetailsPage, {
  NoticeBasicInfoUpdateForm,
  NoticeVisibilityUpdateForm,
} from "../components/NoticeDetailsPage";
import { bossToHqNoticeListViewUrl, bossToUserNoticeListViewUrl, hqToUserNoticeListViewUrl } from "../urls";

interface NoticeDetailsViewProps {
  noticeId: string;
  isFromBossToHq: boolean;
}

export enum NoticeDetailsEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateVisibility = "UpdateVisibility",
}

enum NoticeDetailsModalModeEnum {
  Remove = "Remove",
  Assign = "Assign",
  Unassign = "Unassign",
  UnassignBulk = "UnassignBulk",
}

export const NoticeDetailsView: React.FC<NoticeDetailsViewProps> = ({ noticeId, isFromBossToHq }) => {
  const navigate = useNavigator();

  const [editMode, setEditMode] = useState<NoticeDetailsEditModeEnum>(null);
  const [modalMode, setModalMode] = useState<NoticeDetailsModalModeEnum>(null);
  const [idsForModal, setIdsForModal] = useState<string[]>([]);

  const onEdit = (mode: NoticeDetailsEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };

  const openModalWithoutNavigate = (modalMode: NoticeDetailsModalModeEnum, idsForModal?: string[]) => {
    setModalMode(modalMode);
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
  };

  const resetForCloseModal = () => {
    setIdsForModal([]);
    setModalMode(null);
  };

  const { data: noticeDetails, loading } = useNoticeDetailsQuery({
    skip: noticeId === undefined,
    variables: {
      id: noticeId,
    },
  });
  const notice = maybe(() => noticeDetails.notice, null);

  const getTargetListUrl = (brandId: string) => {
    if (utils.isEmpty(brandId, true) === false) {
      return hqToUserNoticeListViewUrl(brandId);
    }
    return isFromBossToHq ? bossToHqNoticeListViewUrl() : bossToUserNoticeListViewUrl();
  };

  const maxRowNumber = GrapheneRelayConnectionMaxLimitEnum.brands;
  const brandSearchVariable: SearchBrandsVariables = { first: maxRowNumber };
  const {
    search: searchBrand,
    loadMore: loadMoreBrand,
    result: resultBrand,
  } = useBrandSearch({ skip: modalMode !== NoticeDetailsModalModeEnum.Assign, variables: brandSearchVariable });

  const [assignBrand, assignBrandOpts] = useAssignBrandsToNoticeMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.assignBrandsToNotice.errors, "게시 브랜드 리스트에 브랜드를 연동했습니다."),
  });

  const [unassignBrand, unassignBrandOpts] = useUnassignBrandsFromNoticeMutation({
    onCompleted: (data) => {
      const errors = data.unassignBrandsFromNotice.errors;
      if (errors.length === 0) {
        const assignedPopupExist = data.unassignBrandsFromNotice.notice.popupCount > 0;
        if (assignedPopupExist) {
          showNotificationWarn(
            "(경고) 해당 공지사항을 연결한 팝업이 존재합니다. 공지사항 브랜드 리스트에서 브랜드를 제거 했지만 팝업에 연결된 공지사항을 제거해주시기 바랍니다."
          );
        } else {
          showNotificationSuccess("게시 브랜드 리스트에서 브랜드를 연동 해제했습니다.");
        }
        resetForCloseModal();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [noticeUpdate, noticeUpdateOpts] = useNoticeUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  const [noticeDelete, noticeDeleteOpts] = useNoticeDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.noticeDelete.errors, "공지사항이 삭제되었습니다.", () => {
        const targetListUrl = getTargetListUrl(data.noticeDelete.notice.ownerBrand?.id);
        navigate(targetListUrl);
      }),
  });

  const handleBack = () => {
    const targetListUrl = getTargetListUrl(notice.ownerBrand?.id);
    navigate(targetListUrl);
  };

  const availableBrandIdList = notice?.availableBrands.map((e) => e.id) || [];

  const handleBasicInfoUpdate = async (formData: NoticeBasicInfoUpdateForm) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: NoticeInput = {
      ...formData,
      content: convertedContent,
    };

    await noticeUpdate({ variables: { id: noticeId, input } });
  };

  const handleVisibilityUpdate = async (formData: NoticeVisibilityUpdateForm) => {
    const cleanedFormData = cleanFormDataUploadInputs(formData, ["thumbnail"]);

    const input: NoticeInput = {
      ...cleanedFormData,
    };
    await noticeUpdate({ variables: { id: noticeId, input } });
  };

  const handleAvailableToAllBrandsChange = (availableToAllBrands: boolean) => {
    noticeUpdate({ variables: { id: noticeId, input: { availableToAllBrands } } });
  };

  if (loading) {
    return <Loader />;
  }
  return (
    <>
      <WindowTitle title="공지사항 수정" />
      <NoticeDetailsPage
        notice={notice}
        disabled={loading || noticeUpdateOpts.loading || noticeDeleteOpts.loading}
        isFromBossToHq={isFromBossToHq}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBack={handleBack}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onVisibilityUpdate={handleVisibilityUpdate}
        onAvailableToAllBrandsChange={handleAvailableToAllBrandsChange}
        onDelete={() => openModalWithoutNavigate(NoticeDetailsModalModeEnum.Remove)}
        onBrandAssign={() => openModalWithoutNavigate(NoticeDetailsModalModeEnum.Assign)}
        onBrandUnassign={(brandId) => openModalWithoutNavigate(NoticeDetailsModalModeEnum.Unassign, [brandId])}
        onBrandUnassignBulk={(unassignList) =>
          openModalWithoutNavigate(NoticeDetailsModalModeEnum.UnassignBulk, unassignList)
        }
      />
      <ConfirmModal
        visible={modalMode === NoticeDetailsModalModeEnum.Remove}
        modalTitleText="공지사항 삭제"
        titleText={utils.formatMessage(commonMsg.confirmDelete, { name: maybe(() => notice.title, "...") })}
        onOk={() => noticeDelete({ variables: { id: noticeId } })}
        okButtonProps={{ danger: true, loading: noticeDeleteOpts.loading }}
        okText="삭제"
        onCancel={resetForCloseModal}
      />
      <AssignBrandDialog
        hasMore={resultBrand.data?.search?.pageInfo.hasNextPage}
        open={modalMode === NoticeDetailsModalModeEnum.Assign}
        onFetch={searchBrand}
        onFetchMore={loadMoreBrand}
        loading={resultBrand.loading || assignBrandOpts.loading}
        rowSelectionType={"checkbox"}
        onClose={resetForCloseModal}
        onSubmit={(brands) => {
          assignBrand({
            variables: {
              noticeId,
              brands: brands.map((brand) => brand.id),
            },
          });
        }}
        brands={maybe(() =>
          resultBrand.data.search.edges
            .map((edge) => edge.node)
            .filter((suggestedBrand) => !availableBrandIdList.includes(suggestedBrand.id))
        )}
      />
      <ConfirmModal
        visible={
          modalMode === NoticeDetailsModalModeEnum.UnassignBulk || modalMode === NoticeDetailsModalModeEnum.Unassign
        }
        modalTitleText="브랜드 연결 해제"
        titleText={
          idsForModal.length === 1
            ? "이 브랜드를 공지사항에서 연동 해제하시겠습니까?"
            : `${idsForModal.length}종의 브랜드를 공지사항에서 연동 해제하시겠습니까?`
        }
        onOk={() => unassignBrand({ variables: { noticeId, brands: idsForModal } })}
        okButtonProps={{ danger: true, loading: unassignBrandOpts.loading }}
        okText="해제"
        onCancel={resetForCloseModal}
      />
    </>
  );
};
</file>

