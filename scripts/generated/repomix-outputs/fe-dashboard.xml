import { DeleteOutlined } from "@ant-design/icons";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Modal, Row, Space, Tag, Typography } from "antd";
import { ColumnsType } from "antd/es/table";
import React, { useEffect, useState } from "react";

import { useBpvAssignBrandStoresMutation, useBpvUnassignBrandStoresMutation } from "../../api/mutations";
import { BrandStoreAddModal } from "../BrandStoreAddModal/BrandStoreAddModal";

interface BrandStore {
  id: string;
  code: string;
  name: string;
}

interface BrandProductStoreDisplayModalProps {
  open: boolean;
  loading: boolean;
  brandProductVariantId: string;
  brandProductSku: string;
  brandId: string;
  brandStores: BrandStore[];
  onClose: () => void;
}

export const BrandProductStoreDisplayModal: React.FC<BrandProductStoreDisplayModalProps> = (props) => {
  const { open, loading, brandProductVariantId, brandProductSku, brandId, brandStores, onClose } = props;

  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([]);
  const [storeAddModalOpen, setStoreAddModalOpen] = useState<boolean>(false);
  const [currentStores, setCurrentStores] = useState<BrandStore[]>([]);

  const [bpvAssignBrandStores, bpvAssignBrandStoresOpts] = useBpvAssignBrandStoresMutation({
    onCompleted: (data) => {
      if (data?.bpvAssignBrandStores?.errors?.length > 0) {
        showNotificationError("매장 추가에 실패했습니다.");
        return;
      }
      showNotificationSuccess("매장이 추가되었습니다.");
    },
  });

  const [bpvUnassignBrandStores, bpvUnassignBrandStoresOpts] = useBpvUnassignBrandStoresMutation({
    onCompleted: (data) => {
      if (data?.bpvUnassignBrandStores?.errors?.length > 0) {
        showNotificationError("매장 제외에 실패했습니다.");
        return;
      }
      showNotificationSuccess("매장이 제외되었습니다.");
    },
  });

  useEffect(() => {
    if (open) {
      setCurrentStores(brandStores);
      setSelectedRowKeys([]);
    }
  }, [open, brandStores]);

  const isDisplayAllStores = currentStores.length === 0;
  const badgeColor = isDisplayAllStores ? "blue" : "green";
  const badgeText = isDisplayAllStores ? "모든 매장 진열" : "특정 매장 진열";

  const handleRemoveSelected = () => {
    if (selectedRowKeys.length === 0) {
      showNotificationError("제외할 매장을 선택해주세요.");
      return;
    }
    bpvUnassignBrandStores({
      variables: {
        bpvId: brandProductVariantId,
        brandStoreIds: selectedRowKeys as string[],
      },
    });
  };

  const handleRemoveStore = (storeId: string) => {
    bpvUnassignBrandStores({
      variables: {
        bpvId: brandProductVariantId,
        brandStoreIds: [storeId],
      },
    });
  };

  const handleAddStores = (storeIds: string[]) => {
    bpvAssignBrandStores({
      variables: {
        bpvId: brandProductVariantId,
        brandStoreIds: storeIds,
      },
    });
    setStoreAddModalOpen(false);
  };

  const columns: ColumnsType<BrandStore> = [
    {
      title: "매장코드",
      key: "code",
      align: "center",
      width: 120,
      render: (_, record) => record.code || "-",
    },
    {
      title: "매장명",
      key: "name",
      align: "left",
      width: 200,
      render: (_, record) => record.name || "-",
    },
    {
      title: "제외",
      key: "action",
      align: "center",
      width: 80,
      render: (_, record) => (
        <Button
          type="text"
          danger
          icon={<DeleteOutlined />}
          onClick={() => handleRemoveStore(record.id)}
          disabled={mutationLoading}
        />
      ),
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection = {
    selectedRowKeys,
    onChange: (newSelectedRowKeys: React.Key[]) => {
      setSelectedRowKeys(newSelectedRowKeys);
    },
  };

  const mutationLoading = loading || bpvAssignBrandStoresOpts.loading || bpvUnassignBrandStoresOpts.loading;

  return (
    <>
      <Modal
        title={
          <Space direction="horizontal" style={{ width: "100%", justifyContent: "space-between" }}>
            <Typography.Text strong>({brandProductSku}) 진열 매장</Typography.Text>
            <Tag color={badgeColor}>{badgeText}</Tag>
          </Space>
        }
        open={open}
        width={600}
        closable={false}
        okText="저장"
        cancelText="닫기"
        onOk={onClose}
        onCancel={onClose}
        okButtonProps={{ loading: mutationLoading }}
        cancelButtonProps={{ disabled: mutationLoading }}
        maskClosable={false}
      >
        <Space direction="vertical" size={16} style={{ width: "100%" }}>
          <Row justify="end">
            <Space>
              <Button
                onClick={handleRemoveSelected}
                loading={bpvUnassignBrandStoresOpts.loading}
                disabled={mutationLoading || selectedRowKeys.length === 0}
              >
                선택 매장 제외
              </Button>
              <Button
                type="primary"
                onClick={() => setStoreAddModalOpen(true)}
                loading={bpvAssignBrandStoresOpts.loading}
                disabled={mutationLoading}
              >
                매장 추가
              </Button>
            </Space>
          </Row>
          <PatchedColumnsTable
            {...commonTableProps}
            loading={mutationLoading}
            rowKey="id"
            dataSource={currentStores}
            columns={columns}
            scroll={{ x: tableWidthSum, y: 400 }}
            rowSelection={rowSelection}
            locale={{
              emptyText: "진열 매장이 없습니다. 모든 매장에 진열됩니다.",
            }}
          />
        </Space>
      </Modal>
      <BrandStoreAddModal
        open={storeAddModalOpen}
        loading={mutationLoading}
        brandId={brandId}
        excludeStoreIds={currentStores.map((store) => store.id)}
        onAdd={handleAddStores}
        onBack={() => setStoreAddModalOpen(false)}
      />
    </>
  );
};
</file>

