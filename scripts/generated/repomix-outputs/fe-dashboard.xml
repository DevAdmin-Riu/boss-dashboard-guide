import makeQuery, { UseQueryResult } from "@hooks/makeQuery";
import useDebounce from "@hooks/useDebounce";
import gql from "graphql-tag";
import { useState } from "react";

import { CheckIfOrderExists, CheckIfOrderExistsVariables } from "./types/CheckIfOrderExists";
import { SearchCatalog, SearchCatalogVariables } from "./types/SearchCatalog";

const searchCatalog = gql`
  query SearchCatalog($first: Int!, $query: String) {
    categories(first: $first, filter: { search: $query }) {
      edges {
        node {
          id
          name
        }
      }
    }

    collections(first: $first, filter: { search: $query }) {
      edges {
        node {
          id
          name
          isPublished
          publicationDate
        }
      }
    }

    products(first: $first, filter: { search: $query }) {
      edges {
        node {
          id
          category {
            id
            name
          }
          name
        }
      }
    }
  }
`;

const useSearchCatalogQuery = makeQuery<SearchCatalog, SearchCatalogVariables>(searchCatalog);

type UseSearchCatalog = [UseQueryResult<SearchCatalog, SearchCatalogVariables>, (query: string) => void];

export const useSearchCatalog = (first: number): UseSearchCatalog => {
  const [query, setQuery] = useState("");
  const setQueryDebounced = useDebounce(setQuery);
  const result = useSearchCatalogQuery({
    skip: query === "",
    variables: {
      first,
      query,
    },
  });

  return [result, setQueryDebounced];
};

const checkIfOrderExists = gql`
  query CheckIfOrderExists($id: ID!) {
    order(id: $id) {
      id
      status
      isFullyTracking
      isFullyTrackingCompleted
    }
  }
`;

const useCheckIfOrderExistsQuery = makeQuery<CheckIfOrderExists, CheckIfOrderExistsVariables>(checkIfOrderExists);

type UseCheckIfOrderExists = [UseQueryResult<CheckIfOrderExists, CheckIfOrderExistsVariables>, (query: string) => void];

export const useCheckIfOrderExists = (): UseCheckIfOrderExists => {
  const [id, setId] = useState("");
  const setIdDebounced = useDebounce(setId);
  const result = useCheckIfOrderExistsQuery({
    skip: id === "",
    variables: {
      id,
    },
  });

  return [result, setIdDebounced];
};
</file>

<file path="src/app/components/Navigator/modes/commands/actions.ts">
import { UseNavigatorResult } from "@hooks/useNavigator";
import { categoryCreateViewUrl } from "@src/app/views/product/categories/urls";
import { collectionCreateViewUrl } from "@src/app/views/product/collections/urls";
import { productCreateViewUrl } from "@src/app/views/product/products/urls";
import { permissionGroupCreateViewUrl } from "@src/app/views/settings/permissionGroups/urls";
import navigatorModeMsg from "@src/global/assets/messages/navigatorMode";
import { utils } from "@utils/utils";
import { score } from "fuzzaldrin";

import { QuickSearchActionInput, QuickSearchMode } from "../../types";
import { sortScores } from "../utils";

const threshold = 0.05;
const maxActions = 5;

interface Command {
  label: string;
  onClick: () => boolean;
}
export function searchInCommands(
  search: string,
  navigate: UseNavigatorResult,
  setMode: (mode: QuickSearchMode) => void
): QuickSearchActionInput[] {
  const actions: Command[] = [
    {
      label: utils.formatMessage(navigatorModeMsg.createCategory),
      onClick: () => {
        navigate(categoryCreateViewUrl());
        return false;
      },
    },
    {
      label: utils.formatMessage(navigatorModeMsg.createCollection),
      onClick: () => {
        navigate(collectionCreateViewUrl);
        return false;
      },
    },
    {
      label: utils.formatMessage(navigatorModeMsg.createProduct),
      onClick: () => {
        navigate(productCreateViewUrl({ isFulfilledByVendor: false }));
        return false;
      },
    },
    {
      label: utils.formatMessage(navigatorModeMsg.createPermissionGroup),
      onClick: () => {
        navigate(permissionGroupCreateViewUrl);
        return false;
      },
    },
    {
      label: utils.formatMessage(navigatorModeMsg.helpMode),
      onClick: () => {
        setMode("help");
        return true;
      },
    },
  ];

  return actions.map((action) => ({
    label: action.label,
    onClick: action.onClick,
    score: score(action.label, search),
    text: action.label,
    type: "action",
  }));
}

function getCommandModeActions(
  query: string,
  navigate: UseNavigatorResult,
  setMode: (mode: QuickSearchMode) => void
): QuickSearchActionInput[] {
  return [...searchInCommands(query, navigate, setMode)]
    .filter((action) => action.score >= threshold)
    .sort(sortScores)
    .slice(0, maxActions);
}

export default getCommandModeActions;
</file>

