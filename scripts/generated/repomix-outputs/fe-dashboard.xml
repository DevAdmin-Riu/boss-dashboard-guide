import useNavigator from "@hooks/useNavigator";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useRequestPasswordResetMutation } from "../api/mutations";
import { RequestPasswordReset } from "../api/types/RequestPasswordReset";
import { ResetPasswordByEmailPage, ResetPasswordByEmailPageFormData } from "../components/ResetPasswordByEmailPage";
import { makeRedirectUrlToResetPassword, resetPasswordSuccessViewUrl } from "../urls";

export const ResetPasswordByEmailView: React.FC = () => {
  const [error, setError] = React.useState<string>();
  const navigate = useNavigator();

  const handleRequestPasswordReset = (data: RequestPasswordReset) => {
    const errors = data.requestPasswordReset.errors;
    if (errors.length === 0) {
      navigate(resetPasswordSuccessViewUrl);
    } else {
      if (errors.find((err) => err.field === "loginId")) {
        setError("존재하지 않는 계정입니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    }
  };

  const [requestPasswordReset, requestPasswordResetOpts] = useRequestPasswordResetMutation({
    onCompleted: handleRequestPasswordReset,
  });

  const handleSubmit = (data: ResetPasswordByEmailPageFormData) =>
    requestPasswordReset({
      variables: {
        loginId: data.loginId,
        redirectUrl: makeRedirectUrlToResetPassword(),
      },
    });

  return <ResetPasswordByEmailPage disabled={requestPasswordResetOpts.loading} error={error} onSubmit={handleSubmit} />;
};
</file>

