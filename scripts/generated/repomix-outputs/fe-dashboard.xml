  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  consultationDate: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: BrandStoreConsultationListFilterOpts,
  isStaff: boolean
): IFilter<BrandStoreConsultationListFilterKeys> {
  let filterStructure = [];

  const titleSearchFilter = {
    ...createTextField(0, BrandStoreConsultationListFilterKeys.titleSearch, "제목", opts.titleSearch.value),
    active: opts.titleSearch.active,
  };
  const reportSearchFilter = {
    ...createTextField(0, BrandStoreConsultationListFilterKeys.reportSearch, "보고서", opts.reportSearch.value),
    active: opts.reportSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      0,
      BrandStoreConsultationListFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      0,
      BrandStoreConsultationListFilterKeys.brandStoreSearch,
      "매장코드 / 매장명",
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const consultationDateFilter = {
    ...createDateField(0, BrandStoreConsultationListFilterKeys.consultationDate, "상담일", opts.consultationDate.value),
    active: opts.consultationDate.active,
  };

  filterStructure = [
    titleSearchFilter,
    reportSearchFilter,
    isStaff && brandSearchFilter,
    brandStoreSearchFilter,
    consultationDateFilter,
  ].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
</file>

