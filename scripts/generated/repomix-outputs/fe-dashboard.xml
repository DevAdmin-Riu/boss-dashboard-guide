  const columns: ColumnsType<AttributeList_attributes_edges_node> = [
    {
      title: attributeMsg.slug,
      align: "left",
      key: "slug",
      width: 120,
      render: (_, record) => <Typography.Link onClick={() => onRowClick(record.id)}>{record.slug}</Typography.Link>,
    },
    {
      title: attributeMsg.name,
      align: "left",
      key: "name",
      width: 120,
      render: (_, record) => record.name || "-",
    },
    {
      title: attributeMsg.inputType,
      align: "center",
      key: "inputType",
      width: 120,
      render: (_, record) => getAttributeInputTypeText(record.inputType),
