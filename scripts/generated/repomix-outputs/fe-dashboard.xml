import { User } from "@src/api/fragments/types/User";
import { PurchaseOrderLineStatusEnum } from "@src/api/types/globalTypes";
import { fileNameDateFormat, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { AttributeSlugEnum } from "@src/app/views/product/products/utils/data";
import { IRequestExcelDownloadProps, loadWorkbookByLinkByExceljs } from "@utils/excel/excelDownload";
import { replaceWorksheetDataArrByMapByExceljs } from "@utils/excel/templateDownload";
import { transformAddress } from "@utils/misc";
import { utils } from "@utils/utils";
import _ from "lodash";
import moment from "moment";

import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "../../api/types/PurchaseOrderLineList";
import {
  getPoLineStatusHistory,
  getPurchaseOrderDeliveryWarehouseAddress,
  makePurchaseOrderLineNumber,
} from "../../utils";
import { ICategoryMappingByPvId } from "./PoLinesInvoiceSentEmailCreateModal";

const keyNamesToReplace = {
  brandProductName: "[brandProductName]",
  createdAt: "[createdAt]",
  poLineNum: "[poLineNum]",
  staffName: "[staffName]",
  purchaseQty: "[purchaseQty]",
  poLineAddress: "[poLineAddress]",
  poLineAttrMaterial: "[poLineAttrMaterial]",
  poLineAttrColorAndPrint: "[poLineAttrColorAndPrint]",
  poLineAttrSize: "[poLineAttrSize]",
};

const makeDataMap = (user: User, poLine: PurchaseOrderLineList_purchaseOrderLines_edges_node) => {
  if (utils.isEmpty(poLine)) {
    return {};
  }

  const { purchaseOrder, orderLine, shippingAddress, purchaseQuantity, attributeData } = poLine;
  const parsedAttributeData = utils.jsonParseWrapper(attributeData);
  const attributeMap = {
    material: _.get(parsedAttributeData, AttributeSlugEnum.material),
    color: _.get(parsedAttributeData, AttributeSlugEnum.color),
    print: _.get(parsedAttributeData, AttributeSlugEnum.print),
    size: _.get(parsedAttributeData, AttributeSlugEnum.size),
  };
  const statusHistory = getPoLineStatusHistory(poLine, PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED);

  return {
    [keyNamesToReplace.brandProductName]: orderLine.productName || "-",
    [keyNamesToReplace.createdAt]: getDateByFormat(statusHistory?.createdAt, onlyDateFormat),
    [keyNamesToReplace.poLineNum]: makePurchaseOrderLineNumber(poLine),
    [keyNamesToReplace.staffName]: user.firstName || "-",
    [keyNamesToReplace.purchaseQty]: purchaseQuantity,
    [keyNamesToReplace.poLineAddress]: shippingAddress
      ? transformAddress(shippingAddress)
      : getPurchaseOrderDeliveryWarehouseAddress(purchaseOrder) || "-",
    [keyNamesToReplace.poLineAttrMaterial]: attributeMap.material || "-",
    [keyNamesToReplace.poLineAttrColorAndPrint]:
      [attributeMap.color, attributeMap.print].filter(Boolean).join(" / ") || "-",
    [keyNamesToReplace.poLineAttrSize]: attributeMap.size || "-",
  };
};

interface IGenerateExcelInfoProps {
  user: User;
  purchaseOrderLine: PurchaseOrderLineList_purchaseOrderLines_edges_node;
  categoryMappingByPvId: ICategoryMappingByPvId;
}

export const generatePoLineShipmentInspectionExcelInfo = async (
  props: IGenerateExcelInfoProps
): Promise<IRequestExcelDownloadProps | null> => {
  const { user, purchaseOrderLine, categoryMappingByPvId } = props;
  if (utils.isEmpty(purchaseOrderLine) || utils.isEmpty(categoryMappingByPvId)) {
    return null;
  }

  const category = categoryMappingByPvId[purchaseOrderLine.variant.id];
  if (utils.isEmpty(category?.shipmentInspectionFile)) {
    return null;
  }

  const templateFileUrl = category.shipmentInspectionFile.url;
  const workbook = await loadWorkbookByLinkByExceljs(templateFileUrl);

  const dataMap = makeDataMap(user, purchaseOrderLine);
  workbook.eachSheet((sheet) => {
    replaceWorksheetDataArrByMapByExceljs({ worksheet: sheet, dataMap });
  });

  const poLineNumber = makePurchaseOrderLineNumber(purchaseOrderLine);
  const title = `${poLineNumber}_출하검사서_${moment().format(fileNameDateFormat)}.xlsx`;

  return { title, workbook };
};
</file>

