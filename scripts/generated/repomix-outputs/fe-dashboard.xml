}
interface orderDeliveryuMultipleConfirmModalFormProps {
  fulfillmentsToUpdateTracking: FulfillmentUpdateItem[];
}

const OrderDeliveryMultipleConfirmModal: React.FC<OrderDeliveryMultipleConfirmModalProps> = (props) => {
  const {
    open,
    isByNonCourier,
    isB2b,
    isFbv,
    title,
    selectedFulfillmentIds,
    fulfillmentList: deliveryList,
    onClose,
    courierList,
    fulfillmentBulkUpdateTrackingMutation,
    fulfillmentBulkUpdateForFbvMutation,
  } = props;
  const [form] = Form.useForm<orderDeliveryuMultipleConfirmModalFormProps>();

  const isAllDeliveryMethod = isB2b || isFbv;
  const isShowCourierColumn = isAllDeliveryMethod || isByNonCourier === false;
  const isShowTruckColumn = isAllDeliveryMethod || isByNonCourier === true;
  const selectedFulfillmentList = deliveryList.filter((item) => selectedFulfillmentIds.includes(item.id));

  const initialValues = {
    [formListName]: selectedFulfillmentList.map((selectedFulfillment) => ({
      id: selectedFulfillment.id,
      deliveryMethod: selectedFulfillment.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER,
      courierId: isShowCourierColumn ? selectedFulfillment.courier?.id : undefined,
      trackingNumber: isShowCourierColumn ? selectedFulfillment.trackingNumber : undefined,
      vehicle: isShowTruckColumn ? selectedFulfillment.etcDeliveryManInfo?.vehicle : undefined,
      contact: isShowTruckColumn ? selectedFulfillment.etcDeliveryManInfo?.contact : undefined,

      // 직거래 배송정보 업데이트 시 필요한 값
      orderNumber: isFbv ? selectedFulfillment.order.number : undefined,
      fulfillmentOrder: isFbv ? selectedFulfillment.fulfillmentOrder : undefined,
    })),
  };

  useEffect(() => {
    form.setFieldValue(formListName, initialValues[formListName]);
  }, [JSON.stringify(initialValues)]);

  const onSubmit = (formData) => {
    const invalidItems = [];

    for (const item of formData[formListName]) {
      let isInvalid = false;

      // isAllDeliveryMethod가 true인 경우 (B2B, FBV)
      if (isAllDeliveryMethod) {
        const isCourierModeSelected = item.deliveryMethod === true;

        if (isCourierModeSelected) {
          // '택배'를 선택한 경우
          if (utils.isEmpty(item.courierId) || utils.isEmpty(item.trackingNumber)) {
            isInvalid = true;
          }
        } else {
          // '화물차'를 선택한 경우
          if (utils.isEmpty(item.vehicle) || utils.isEmpty(item.contact)) {
            isInvalid = true;
          }
        }
      }
      // isAllDeliveryMethod가 false인 경우 (일반 배송)
      else {
        if (isByNonCourier) {
          if (utils.isEmpty(item.vehicle) || utils.isEmpty(item.contact)) {
            isInvalid = true;
          }
        } else {
          if (utils.isEmpty(item.courierId) || utils.isEmpty(item.trackingNumber)) {
            isInvalid = true;
          }
        }
      }

      if (isInvalid) {
        if (!invalidItems.includes(item.id)) {
          invalidItems.push(item.id);
        }
      }
    }

    if (invalidItems.length > 0) {
      showNotificationError(
        "각 항목에 대해 배송 방식에 맞는 정보를 모두 입력해주세요. (택배사/송장번호 또는 차량/연락처)"
      );
      return;
    }

    if (isFbv) {
      const details: FulfillmentBulkUpdateForFbvDetail[] = formData[formListName].map(
        (item: FulfillmentUpdateItem) => ({
          orderNumber: Number(item.orderNumber),
          fulfillmentOrder: Number(item.fulfillmentOrder),
          deliveryMethod: item.deliveryMethod
            ? OrderDeliveryMethodsEnum.BY_COURIER
            : OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE,
          courierId: isShowCourierColumn ? item.courierId : undefined,
          trackingNumber: isShowCourierColumn ? item.trackingNumber : undefined,
          etcDeliveryManInfo: isShowTruckColumn
            ? {
                vehicle: item.vehicle,
                contact: item.contact,
              }
            : undefined,
        })
      );
      fulfillmentBulkUpdateForFbvMutation({
        variables: {
          input: {
            details,
          },
        },
      });
    } else {
      const fulfillmentsToUpdateTracking: FulfillmentBulkUpdateTrackingInput[] = formData[formListName].map(
        (item: FulfillmentUpdateItem) => {
          const convertDeliveryMethod = item.deliveryMethod
            ? OrderDeliveryMethodsEnum.BY_COURIER
            : OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE;
          const isByCourierDeliveryMethod =
            convertDeliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER && isShowCourierColumn;
          const isByTruckDeliveryMethod =
            convertDeliveryMethod === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE && isShowTruckColumn;
          return {
            fulfillmentId: item.id,
            input: {
              deliveryMethod: isAllDeliveryMethod
                ? item.deliveryMethod
                  ? OrderDeliveryMethodsEnum.BY_COURIER
                  : OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE
                : undefined,
              courierId: isByCourierDeliveryMethod ? item.courierId : undefined,
              trackingNumber: isByCourierDeliveryMethod ? item.trackingNumber : undefined,
              etcDeliveryManInfo: isByTruckDeliveryMethod
                ? {
                    vehicle: item.vehicle,
                    contact: item.contact,
                  }
                : undefined,
            },
          };
        }
      );

      fulfillmentBulkUpdateTrackingMutation({
        variables: {
          fulfillmentsToUpdateTracking,
          isPoLineDeliveryConfirmed: true,
        },
      });
    }
  };

  const columns = OrderDeliveryMultipleConfirmTableSettings({
    isByNonCourier,
    isB2b,
    isFbv,
    courierList,
    formListName,
  });

  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  return (
    <Modal
      open={open}
      title={title}
      maskClosable={false}
      forceRender
      destroyOnClose
      width={1200}
      onCancel={() => {
        onClose();
        form.resetFields();
      }}
      onOk={form.submit}
    >
      <Form
        size="small"
        layout="vertical"
        name="delivery-multiple-confirm"
        form={form}
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Space direction="vertical" size="large">
          <Form.List name={formListName}>
            {() => (
              <Table
                {...commonTableProps}
                columns={columns}
                dataSource={selectedFulfillmentList}
                scroll={{ x: tableWidthSum }}
              />
            )}
          </Form.List>
        </Space>
      </Form>
    </Modal>
  );
};

export default OrderDeliveryMultipleConfirmModal;
</file>

<file path="src/app/views/order/orders/components/OrderDeliveryMultipleConfirmModal/OrderDeliveryMultipleConfirmTableSettings.tsx">
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { transformAddress, transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import { Form, Input, InputNumber, Select, Switch } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { FulfillmentList_fulfillments_edges_node } from "../../api/types/FulfillmentList";

interface OrderDeliveryMultipleConfirmTableSettingsProps {
  isByNonCourier: boolean;
  isB2b: boolean;
  isFbv: boolean;
  courierList?: CourierList_couriers_edges_node[];

  formListName: string;
}

const fbvHiddenFormItem = (index: number): React.ReactNode => (
  <>
    <Form.Item hidden name={[index, "orderNumber"]}>
      <Input />
    </Form.Item>
    <Form.Item hidden name={[index, "fulfillmentOrder"]}>
      <Input />
    </Form.Item>
  </>
);

const FormItemStyle: React.CSSProperties = { marginBottom: 0 };

export const OrderDeliveryMultipleConfirmTableSettings = (props: OrderDeliveryMultipleConfirmTableSettingsProps) => {
  const { isByNonCourier, isB2b, isFbv, courierList, formListName } = props;
  const isAllDeliveryMethod = isB2b || isFbv;
  const isShowCourierColumn = isAllDeliveryMethod || isByNonCourier === false;
  const isShowTruckColumn = isAllDeliveryMethod || isByNonCourier === true;

  const columns: ColumnsType<FulfillmentList_fulfillments_edges_node> = [
    {
      title: columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID,
      key: "fulfillmentComposedId",
      align: "center",
      width: 130,
      render: (_, record: FulfillmentList_fulfillments_edges_node, index: number) => (
        <>
          {record.composedIdWithPrefix}
          <Form.Item name={[index, "id"]} hidden>
            <Input />
          </Form.Item>
          {isFbv && fbvHiddenFormItem(index)}
        </>
      ),
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record: FulfillmentList_fulfillments_edges_node) => record.lines[0].orderLine?.productSku,
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "center",
      width: 200,
      render: (_, record: FulfillmentList_fulfillments_edges_node) =>
        record.lines[0].orderLine?.variant?.product?.name || "-",
    },
    {
      title: columnNameConstant.fulfillment.ORDER_QUANTITY,
      key: "quantity",
      align: "center",
      width: 80,
      render: (_, record: FulfillmentList_fulfillments_edges_node) => record.lines[0].quantity,
    },
    isAllDeliveryMethod && {
      title: columnNameConstant.delivery.DELIVERY_METHOD,
      key: "deliveryMethod",
      align: "center",
      width: 120,
      render: (_, __, index: number) => (
        <Form.Item name={[index, "deliveryMethod"]} valuePropName="checked" style={FormItemStyle}>
          <Switch checkedChildren="택배" unCheckedChildren="화물차" size="default" />
        </Form.Item>
      ),
    },
    isShowCourierColumn && {
      title: columnNameConstant.delivery.COURIER_NAME,
      key: "courierName",
      align: "center",
      width: 120,
      render: (_, __, index: number) => (
        <Form.Item dependencies={[[formListName, index, "deliveryMethod"]]} style={FormItemStyle}>
          {({ getFieldValue }) => {
            const byCourier = getFieldValue([formListName, index, "deliveryMethod"]);
            return (
              <Form.Item name={[index, "courierId"]} style={FormItemStyle}>
                <Select
                  options={courierList?.map((item) => ({ label: item.name, value: item.id }))}
                  disabled={!byCourier}
                />
              </Form.Item>
            );
          }}
        </Form.Item>
      ),
    },
    isShowCourierColumn && {
      title: columnNameConstant.delivery.TRACKING_NO,
      key: "trackingNumber",
      align: "center",
      width: 140,
      render: (_, record: FulfillmentList_fulfillments_edges_node, index: number) => (
        <Form.Item
          dependencies={[
            [formListName, index, "deliveryMethod"],
            [formListName, index, "courierId"],
          ]}
          style={FormItemStyle}
        >
          {({ getFieldValue }) => {
            const byCourier = getFieldValue([formListName, index, "deliveryMethod"]);
            const courierId = getFieldValue([formListName, index, "courierId"]);
            const disabled = isAllDeliveryMethod ? !byCourier : false;
            const digitAllowedValues = courierList?.find((i) => i.id === courierId)?.digitAllowedValues;

            return (
              <Form.Item
                name={[index, "trackingNumber"]}
                rules={[
                  {
                    pattern: utils.makeLenRegex(digitAllowedValues),
                    message: `${digitAllowedValues?.join(",")} 자리로 입력해야 합니다`,
                  },
                ]}
                style={FormItemStyle}
              >
                <InputNumber {...getInputNumberProps({})} disabled={disabled} />
              </Form.Item>
            );
          }}
        </Form.Item>
      ),
    },
    isShowTruckColumn && {
      title: columnNameConstant.delivery.DELIVERY_VEHICLE_INFO,
      key: "deliveryVehicle",
      align: "center",
      width: 150,
      render: (_, __, index: number) => (
        <Form.Item dependencies={[[formListName, index, "deliveryMethod"]]} style={FormItemStyle}>
          {({ getFieldValue }) => {
            const byCourier = getFieldValue([formListName, index, "deliveryMethod"]);
            // 화물차 칸은 택배가 아닐 때(enabled when !byCourier)
            const disabled = isAllDeliveryMethod ? byCourier : false;
            return (
              <Form.Item name={[index, "vehicle"]} style={FormItemStyle}>
                <Input disabled={disabled} />
              </Form.Item>
            );
          }}
        </Form.Item>
      ),
    },
    isShowTruckColumn && {
      title: columnNameConstant.delivery.DELIVERY_MAN_CONTACT,
      key: "deliveryManContact",
      align: "center",
      width: 140,
      render: (_, __, index: number) => (
        <Form.Item dependencies={[[formListName, index, "deliveryMethod"]]} style={FormItemStyle}>
          {({ getFieldValue }) => {
            const byCourier = getFieldValue([formListName, index, "deliveryMethod"]);
            const disabled = isAllDeliveryMethod ? byCourier : false;
            return (
              <Form.Item name={[index, "contact"]} style={FormItemStyle}>
                <Input disabled={disabled} />
              </Form.Item>
            );
          }}
        </Form.Item>
      ),
    },
    {
      title: columnNameConstant.delivery.RECEIVER_NAME,
      key: "customerName",
      align: "center",
      width: 120,
      render: (_, record: FulfillmentList_fulfillments_edges_node) => record.order?.shippingAddress?.firstName || "-",
    },
    {
      title: columnNameConstant.delivery.PHONE,
      key: "customerPhone",
      align: "center",
      width: 150,
      render: (_, record: FulfillmentList_fulfillments_edges_node) =>
        transformPhoneNumber(record.order?.shippingAddress?.phone),
    },
    {
      title: columnNameConstant.delivery.DELIVERY_ADDRESS,
      key: "shippingAddress",
      align: "center",
      width: 250,
      render: (_, record: FulfillmentList_fulfillments_edges_node) => transformAddress(record?.order?.shippingAddress),
    },
  ].filter(Boolean) as ColumnsType<FulfillmentList_fulfillments_edges_node>;

  return columns;
};
