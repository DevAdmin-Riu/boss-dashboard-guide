  const prefixListViews =
    isB2b === true ? ListViews.PREFIX_VS_B2B_PURCHASE_ORDER_LINE_LIST : ListViews.PREFIX_VS_PURCHASE_ORDER_LINE_LIST;
  const routeParams = useParams<PurchaseOrderLineListViewRouteParams>();
  const { inventoryType, status, deliveryMethod } = routeParams;
  const isTrackInventory = inventoryType === "track-inventory";
  const isConsignment = inventoryType === "consignment";
  const isByNonCourier = deliveryMethod === "by-non-courier";
  const shop = useShop();
  const { user } = useUser();
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [showDeliveryConfirmModal, setShowDeliveryConfirmModal] = useState<boolean>(false);

  // 납품 시 금액확정 여부
  const useAdjustPricePv = user?.vendor?.useAdjustPricePv || false;

  const targetUrl = useMemo(
    () => (params: PurchaseOrderLineListViewUrlQueryParams) => {
      if (
        routeParams.status === PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT &&
        routeParams.deliveryMethod === "by-courier-price-adjust"
      ) {
        return vsPurchaseOrderLineListViewUrl(routeParams, params);
      }

      return isB2b
        ? vsB2bPurchaseOrderLineListViewUrl(routeParams, params)
        : vsPurchaseOrderLineListViewUrl(routeParams, params);
    },
    [isB2b, routeParams]
  );
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(prefixListViews, [inventoryType, status]),
  });

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  const { fetchForDownload } = utils.initListViewDownloadQuery(usePurchaseOrderLineListFilterDownloadQuery);
  const queryVariables = useMemo<PurchaseOrderLineListVariables>(() => {
    const filterVariables = getFilterVariables(params, routeParams);
    return {
      ...paginationState,
      filter: {
        ...filterVariables,
        vendorSearch: user.vendor.code,
        isB2b,
        deliveryMethods:
          isTrackInventory === false && isNeedDeliveryMethodFilterStatus(status) && isByNonCourier === false
            ? [OrderDeliveryMethodsEnum.BY_COURIER]
            : null,
        excludeDeliveryMethods:
          isTrackInventory === false && isNeedDeliveryMethodFilterStatus(status) && isByNonCourier
            ? [OrderDeliveryMethodsEnum.BY_COURIER]
            : null,
      },
      afterStatusList:
        status === "print-invoice"
          ? [PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT, PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED]
          : status === "complete-delivery"
          ? [
              PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
              PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
              PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
              PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
              PurchaseOrderLineStatusEnum.INSPECTED,
              PurchaseOrderLineStatusEnum.DELIVERED,
            ]
          : status === "all-status"
          ? [
              PurchaseOrderLineStatusEnum.CANCELED,
              PurchaseOrderLineStatusEnum.DELIVERED,
              PurchaseOrderLineStatusEnum.DELIVERY_CONFIRMED,
              PurchaseOrderLineStatusEnum.DISPATCH_FULFILLMENT,
              PurchaseOrderLineStatusEnum.DRAFT,
              PurchaseOrderLineStatusEnum.INVOICE_PRINTED,
              PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
              PurchaseOrderLineStatusEnum.INSPECTED,
              PurchaseOrderLineStatusEnum.PENDING,
              PurchaseOrderLineStatusEnum.RECEIVED,
              PurchaseOrderLineStatusEnum.REJECTED,
              PurchaseOrderLineStatusEnum.REQ_EPD_UPDATE,
              PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY,
              PurchaseOrderLineStatusEnum.STOCKED,
            ]
          : [],
      isVendorStaff: true,
    };
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = usePurchaseOrderLineListQuery({ variables: queryVariables });
  const purchaseOrderLines = maybe(() => data.purchaseOrderLines.edges.map((edge) => edge.node), []);

  const selectedPoLine = purchaseOrderLines.find((poLine) => poLine.id === params.id);
  const selectedPoLines = purchaseOrderLines.filter((poLine) => selectedRowIds.includes(poLine.id));

  const selectedFulfillmentIds = useMemo(() => {
    if (!isConsignment || selectedRowIds.length === 0) {
      return [];
    }

    const ids = selectedPoLines
      .map((poLine) => {
        const fulfillmentId = poLine.orderLine?.fulfillmentLines?.[0]?.fulfillment?.id;
        return fulfillmentId;
      })
      .filter(Boolean) as string[];

    return ids;
  }, [isConsignment, selectedPoLines, selectedRowIds]);

  const { data: fulfillmentData, loading: fulfillmentLoading } = useFulfillmentListQuery({
    skip: !showDeliveryConfirmModal || selectedFulfillmentIds.length === 0,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.reportDeliveryList,
      filter: {
        ids: selectedFulfillmentIds,
      },
      forStaffOrderDelivery: false,
      forVsOrderDelivery: true,
      forFbvOrderDelivery: false,
    },
  });
  const selectedFulfillments = maybe(() => fulfillmentData?.fulfillments.edges.map((edge) => edge.node), []);

  const { data: courierData, loading: courierLoading } = useCourierListQuery({
    skip: status !== "confirm-delivery",
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.couriers,
      filter: { isActive: true },
    },
  });
  const couriers = maybe(() => courierData?.couriers.edges.map((edge) => edge.node), []);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.purchaseOrderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PurchaseOrderLineListViewUrlDialog, PurchaseOrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setSelectedRowIds([]);
    }
  };

  const [purchaseOrderLinesDeliveryConfirmed, purchaseOrderLinesDeliveryConfirmedOpts] =
    usePurchaseOrderLinesDeliveryConfirmedMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLinesDeliveryConfirmed.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목이 배송 확정되었습니다.");
          setSelectedRowIds([]);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery],
    });

  const [fulfillmentBulkUpdateTracking, fulfillmentBulkUpdateTrackingOpts] = useFulfillmentBulkUpdateTrackingMutation({
    onCompleted: (data) => {
      const errors = data.fulfillmentBulkUpdateTracking.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 발주 품목이 배송 확정되었습니다.");
        setShowDeliveryConfirmModal(false);
        setSelectedRowIds([]);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [purchaseOrderLineListQuery],
  });

  const [purchaseOrderLinesInvoicePrint, purchaseOrderLinesInvoicePrintOpts] =
    usePurchaseOrderLinesInvoicePrintMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLinesInvoicePrint.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 거래명세서 출력이 완료되었습니다.");
          setSelectedRowIds([]);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery],
    });

  const [purchaseOrderLinesDelivered, purchaseOrderLinesDeliveredOpts] = usePurchaseOrderLinesDeliveredMutation({
    onCompleted: (data) => {
      const errors = data.purchaseOrderLinesDelivered.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 발주 품목이 배송 완료 처리되었습니다.");
        setSelectedRowIds([]);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [purchaseOrderLineAttachDeliveryConfirmDoc, purchaseOrderLineAttachDeliveryConfirmDocOpts] =
    usePurchaseOrderLineAttachDeliveryConfirmDocMutation({
      onCompleted: (data) => {
        const errors = data?.purchaseOrderLineAttachDeliveryConfirmDoc?.errors;
        if (errors?.length === 0) {
          showNotificationSuccess("납품확인서가 첨부되었습니다.");
          onModalClose(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
    });
  const [purchaseOrderLinesRevert, purchaseOrderLinesRevertOpts] = usePurchaseOrderLinesRevertMutation({
    refetchQueries: [purchaseOrderLineListQuery],
  });

  const handleLinesRevert = async (variables: PurchaseOrderLinesRevertVariables, message: string) => {
    const { data } = await purchaseOrderLinesRevert({
      variables,
    });
    const errors = data?.purchaseOrderLinesRevert?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess(`선택한 발주제품이 ${message} 처리 되었습니다.`);
      onModalClose(true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const onDeliveryConfirmed = async () => {
    if (isTrackInventory) {
      purchaseOrderLinesDeliveryConfirmed({ variables: { purchaseOrderLineIds: selectedRowIds } });
    } else if (isConsignment) {
      setShowDeliveryConfirmModal(true);
    }
  };

  const onDeliveryConfirmModalClose = () => {
    setShowDeliveryConfirmModal(false);
    setSelectedRowIds([]);
  };

  const onInvoicePrint = async () => {
    showDownloadingMessage();

    // 엑셀 다운로드가 성공하면 아래 뮤테이션 호출 O / 실패하면 호출 X
    onPurchaseOrderInvoiceExcelDownload(selectedPoLines, routeParams, user, isB2b)
      .then((res) => {
        if (res) {
          purchaseOrderLinesInvoicePrint({ variables: { purchaseOrderLineIds: selectedRowIds } });
        } else {
          showNotificationError("거래명세서 출력에 실패했습니다.");
        }
      })
      .finally(() => {
        destroyDownloadingMessage();
      });
  };

  const onDelivered = () => {
    purchaseOrderLinesDelivered({ variables: { purchaseOrderLineIds: selectedRowIds } });
  };

  const selectedRowExist = maybe(() => selectedRowIds.length > 0);

  const pageLoading =
    loading ||
    courierLoading ||
    fulfillmentLoading ||
    purchaseOrderLinesDeliveryConfirmedOpts.loading ||
    fulfillmentBulkUpdateTrackingOpts.loading ||
    purchaseOrderLinesInvoicePrintOpts.loading ||
    purchaseOrderLinesDeliveredOpts.loading ||
    purchaseOrderLineAttachDeliveryConfirmDocOpts.loading ||
    purchaseOrderLinesRevertOpts.loading;

  useEffect(() => {
    if (!selectedRowExist) {
      closeModal();
    }
  }, [selectedRowIds]);

  useEffect(() => {
    setSelectedRowIds([]);
  }, [loading, inventoryType, status]);

  const revertModalConfig = getRevertModalInfo({ status });
  return (
    <>
      <VsPurchaseOrderLineListPage
        params={params}
        currencySymbol={currencySymbol}
        settings={settings}
        currentTab={currentTab}
        disabled={pageLoading}
        filterOpts={getFilterOpts(params, routeParams)}
        purchaseOrderLines={purchaseOrderLines}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        sort={getSortParams(params)}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        onDeliveryConfirmed={onDeliveryConfirmed}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        onInvoicePrint={onInvoicePrint}
        onDelivered={onDelivered}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        isB2b={isB2b}
        isByNonCourier={isByNonCourier}
        ListNavigator={() =>
          isB2b === false && status === "all-status" ? (
            <>
              <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, VsPurchaseOrderLineUrlEnum>
                countOfStatus={null}
                urlList={vsTrackInventoryPurcahseOrderLineUrlList()}
                NavButtonName={vsTrackInventoryPurchaseOrderLineNavButtonName}
                skipQueryString={true}
              />
              <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, VsPurchaseOrderLineUrlEnum>
                countOfStatus={null}
                urlList={vsConsignmentPurchaseOrderLineUrlList().filter(
                  (item) =>
                    useAdjustPricePv ||
                    item.urlEnum !== VsPurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST
                )}
                NavButtonName={vsConsignmentPurchaseOrderLineNavButtonName}
                skipQueryString={true}
              />
            </>
          ) : (
            <ListNavigator<PurchaseOrderLineListViewUrlQueryParams, VsPurchaseOrderLineUrlEnum>
              countOfStatus={null}
              urlList={
                isB2b
                  ? vsB2bPurchaseOrderLineUrlList()
                  : isTrackInventory
                  ? vsTrackInventoryPurcahseOrderLineUrlList()
                  : vsConsignmentPurchaseOrderLineUrlList().filter(
                      (item) =>
                        useAdjustPricePv ||
                        item.urlEnum !== VsPurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST
                    )
              }
              NavButtonName={
                isB2b
                  ? vsB2bPurchaseOrderLineNavButtonName
                  : isTrackInventory
                  ? vsTrackInventoryPurchaseOrderLineNavButtonName
                  : vsConsignmentPurchaseOrderLineNavButtonName
              }
              skipQueryString={true}
            />
          )
        }
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <VsPurchaseOrderLinesRejectModal
        open={params.action === "reject-lines" && selectedRowExist}
        loading={loading}
        poLineIds={selectedRowIds}
        onCancel={onModalClose}
      />
      <VsPurchaseOrderLinesReceiveModal
        open={params.action === "receive-lines" && selectedRowExist}
        loading={loading}
        poLineIds={selectedRowIds}
        onCancel={onModalClose}
      />
      <VsPurchaseOrderLinesDispatchFulfillmentModal
        open={params.action === "dispatch-fulfillment" && selectedRowExist}
        loading={loading}
        trackInventory={isTrackInventory}
        poLines={selectedPoLines}
        orderLines={selectedPoLines.map((poLine) => poLine.orderLine)}
        onCancel={onModalClose}
        isB2b={isB2b}
        isByNonCourier={isByNonCourier}
      />
      <VsPurchaseOrderLinesReqEpdUpdateModal
        open={params.action === "req-epd-update" && selectedRowExist}
        loading={loading}
        isApproveMode={false}
        poLines={selectedPoLines}
        onCancel={onModalClose}
      />
      <VsPurchaseOrderLineReqSplitDeliveryModal
        open={params.action === "req-split-delivery" && !!selectedPoLine}
        loading={loading}
        isApproveMode={false}
        poLine={selectedPoLine}
        onCancel={onModalClose}
      />
      <PurchaseOrderLineAttachDeliveryConfirmDocModal
        open={params.action === "attach-delivery-confirm-doc"}
        onAttachDeliveryConfirmDocUpdate={(file) => {
          purchaseOrderLineAttachDeliveryConfirmDoc({
            variables: { id: selectedRowIds[0] as string, input: { deliveryConfirmDoc: file } },
          });
        }}
        loading={pageLoading}
        onCancel={() => onModalClose(true)}
      />
      {revertModalConfig !== null && (
        <>
          <PurchaseOrderRevertLinesModal
            open={params.action === "revert-lines" && selectedRowExist}
            revertModalConfig={revertModalConfig}
            handleLinesRevert={handleLinesRevert}
            onModalClose={() => onModalClose(false)}
            purchaseOrderLineIds={selectedRowIds as string[]}
          />
        </>
      )}
      {isConsignment && (
        <OrderDeliveryMultipleConfirmModal
          open={showDeliveryConfirmModal}
          onClose={onDeliveryConfirmModalClose}
          isByNonCourier={isByNonCourier}
          isB2b={isB2b}
          isFbv={false}
          title="배송 확정"
          selectedFulfillmentIds={selectedFulfillmentIds}
          fulfillmentList={selectedFulfillments}
          courierList={couriers}
          fulfillmentBulkUpdateTrackingMutation={fulfillmentBulkUpdateTracking}
        />
      )}
    </>
  );
};
</file>

<file path="src/app/views/vendorStaff/vsSection/index.tsx">
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import { OrderDeliveryListViewUrlQueryParams } from "../../order/orders/urls";
import { getOrderDeliveryListDefaultParams } from "../../order/orders/utils";
import { OrderDeliveryListView } from "../../order/orders/views/OrderDeliveryListView/OrderDeliveryListView";
import { StockListViewWrapper } from "../../product/stock";
import { vendorStockListViewPath } from "../../product/stock/urls";
import {
  PurchaseOrderLineListViewRouteParams,
  PurchaseOrderLineListViewUrlQueryParams,
  PurchaseOrderLineListViewUrlSortField,
} from "../../purchase/purchaseOrders/urls";
import { PurchaseListViewUrlQueryParams } from "../../purchase/purchases/urls";
import {
  vsOrderDeliveryListViewPathBByCourier,
  vsOrderDeliveryListViewPathBByNonCourier,
  vsPurchaseListViewPath,
  VsPurchaseListViewRouteParams,
  vsPurchaseOrderLineListViewPath,
} from "./urls";
import { getPurchaseOrderLineListDefaultParams, getVsPurchaseListDefaultParams } from "./utils";
import { VsPurchaseListView } from "./views/VsPurchaseListView/VsPurchaseListView";
import { VsPurchaseOrderLineListView } from "./views/VsPurchaseOrderLineListView/VsPurchaseOrderLineListView";

const VsPurchaseOrderLineListViewWrapper: React.FC<RouteComponentProps<PurchaseOrderLineListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const sortedParams: PurchaseOrderLineListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    { ...qs },
    PurchaseOrderLineListViewUrlSortField,
    PurchaseOrderLineListViewUrlSortField.poLineNo,
    false
  );
  const defaultParams = getPurchaseOrderLineListDefaultParams(match.params);
  const params: PurchaseOrderLineListViewUrlQueryParams = { ...defaultParams, ...sortedParams };

  return <VsPurchaseOrderLineListView defaultParams={defaultParams} params={params} isB2b={false} />;
};

const VsOrderDeliveryListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getOrderDeliveryListDefaultParams(location.pathname);
  const params: OrderDeliveryListViewUrlQueryParams = { ...defaultParams, ...qs };

  let isByNonCourier: boolean;
  if (location.pathname === vsOrderDeliveryListViewPathBByNonCourier) {
    isByNonCourier = true;
  } else if (location.pathname === vsOrderDeliveryListViewPathBByCourier) {
    isByNonCourier = false;
  }
  return (
    <OrderDeliveryListView
      defaultParams={defaultParams}
      params={params}
      isB2b={false}
      isByNonCourier={isByNonCourier}
    />
  );
};

const VsPurchaseListViewWrapper: React.FC<RouteComponentProps<VsPurchaseListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const isB2b = false;
  const defaultParams = getVsPurchaseListDefaultParams(match.params, isB2b);
  const params: PurchaseListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <VsPurchaseListView defaultParams={defaultParams} params={params} isB2b={isB2b} />;
};

const VsSection = () => (
  <>
    <Switch>
      <Route
        exact
        path={vsPurchaseOrderLineListViewPath({
          inventoryType: ":inventoryType",
          status: ":status",
          deliveryMethod: ":deliveryMethod?",
        })}
        component={VsPurchaseOrderLineListViewWrapper}
      />
      <Route exact path={vsOrderDeliveryListViewPathBByCourier} component={VsOrderDeliveryListViewWrapper} />
      <Route exact path={vsOrderDeliveryListViewPathBByNonCourier} component={VsOrderDeliveryListViewWrapper} />
      <Route
        exact
        path={vsPurchaseListViewPath({ fulfilledBy: ":fulfilledBy", status: ":status" })}
        component={VsPurchaseListViewWrapper}
      />
      <Route path={vendorStockListViewPath({ fbv: ":fbv?", type: ":type" })} component={StockListViewWrapper} />
    </Switch>
  </>
);

export default VsSection;
</file>

<file path="src/app/views/vendorStaff/vsSection/urls.ts">
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import { RouteParamsFulfilledByType } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

import {
  orderDeliveryListViewPathBByCourier,
  orderDeliveryListViewPathBByNonCourier,
  OrderDeliveryListViewUrlQueryParams,
} from "../../order/orders/urls";
import {
  purchaseOrderLineListViewPath,
  PurchaseOrderLineListViewRouteParams,
  PurchaseOrderLineListViewUrlQueryParams,
} from "../../purchase/purchaseOrders/urls";
import { PurchaseListViewUrlQueryParams, purchaseSectionUrl } from "../../purchase/purchases/urls";
import { vsB2bPurchaseOrderLineListViewPath } from "../vsB2bPurchaseOrder/urls";

export const vsSectionUrl = "/vs";

export const vsPurchaseOrderLineListViewPath = (routeParams: PurchaseOrderLineListViewRouteParams) =>
  urlJoin(vsSectionUrl, purchaseOrderLineListViewPath(routeParams));

export const vsPurchaseOrderLineListViewUrl = (
  routeParams: PurchaseOrderLineListViewRouteParams,
  params?: PurchaseOrderLineListViewUrlQueryParams
): string => {
  if (params === undefined) {
    return vsPurchaseOrderLineListViewPath(routeParams);
  } else {
    return urlJoin(vsPurchaseOrderLineListViewPath(routeParams), "?" + stringifyQs(params));
  }
};

export enum VsPurchaseOrderLineUrlEnum {
  ALL_STATUS = "all-status",
  RECEIVE = "receive",
  DISPATCH_FULFILLMENT = "dispatch-fulfillment",
  DISPATCH_FULFILLMENT_BY_COURIER = "dispatch-fulfillment-by-courier",
  DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST = "dispatch-fulfillment-by-courier-price-adjust",
  DISPATCH_FULFILLMENT_BY_NON_COURIER = "dispatch-fulfillment-by-non-courier",
  CONFIRM_DELIVERY = "confirm-delivery",
  PRINT_INVOICE = "print-invoice",
  COMPLETE_DELIVERY = "complete-delivery",
  DELIVERY_B_BY_NON_COURIER = "delivery-b-by-non-courier", // 화물차 (위탁) / B2B
  DELIVERY_B_BY_COURIER = "delivery-b-by-courier", // 택배 (위탁)
}

export const vsTrackInventoryPurchaseOrderLineNavButtonName = (urlEnum: VsPurchaseOrderLineUrlEnum) => {
  switch (urlEnum) {
    case VsPurchaseOrderLineUrlEnum.ALL_STATUS:
      return "전체 발주 내역";
    case VsPurchaseOrderLineUrlEnum.RECEIVE:
      return "발주 접수(재고)";
    case VsPurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT:
      return "출고 지시(재고)";
    case VsPurchaseOrderLineUrlEnum.CONFIRM_DELIVERY:
      return "배송 확정(재고)";
    case VsPurchaseOrderLineUrlEnum.PRINT_INVOICE:
      return "거래명세서 출력(재고)";
    case VsPurchaseOrderLineUrlEnum.COMPLETE_DELIVERY:
      return "배송 완료(재고)";
  }
};

export const vsTrackInventoryPurcahseOrderLineUrlList = (): Array<
  UrlListType<VsPurchaseOrderLineUrlEnum, PurchaseOrderLineListViewUrlQueryParams>
> => [
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "receive" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.RECEIVE,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "receive" }),
  },
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "dispatch-fulfillment" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "dispatch-fulfillment" }),
  },
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "confirm-delivery" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.CONFIRM_DELIVERY,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "confirm-delivery" }),
  },
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "print-invoice" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.PRINT_INVOICE,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "print-invoice" }),
  },
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "complete-delivery" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.COMPLETE_DELIVERY,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "track-inventory", status: "complete-delivery" }),
  },
  {
    path: vsPurchaseOrderLineListViewPath({ inventoryType: "all-inventory", status: "all-status" }),
    urlEnum: VsPurchaseOrderLineUrlEnum.ALL_STATUS,
    fnUrl: () => vsPurchaseOrderLineListViewPath({ inventoryType: "all-inventory", status: "all-status" }),
  },
];

export const vsConsignmentPurchaseOrderLineNavButtonName = (urlEnum: VsPurchaseOrderLineUrlEnum) => {
  switch (urlEnum) {
    case VsPurchaseOrderLineUrlEnum.ALL_STATUS:
      return "전체 발주 내역";
