import { CategoryTypeEnum, OrderType, OrderTypeEnum, SalesFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { OrderSalesListFilterKeys, OrderSalesListFilterOpts } from "../../components/OrderSalesListPage/filters";
import {
  OrderSalesListViewRouteParams,
  OrderSalesListViewUrlFilters,
  OrderSalesListViewUrlFiltersEnum,
  OrderSalesListViewUrlFiltersWithMultipleValuesEnum,
  OrderSalesListViewUrlQueryParams,
} from "../../urls";
import { getOrderTypeEnums } from "../OrderListView/filters";

const ORDER_SALES_FILTERS_KEY = "orderSalesFilters";

export function getFilterOpts(
  params: OrderSalesListViewUrlFilters,
  routeParams: OrderSalesListViewRouteParams
): OrderSalesListFilterOpts {
  const filterVariables = getFilterVariables(params, routeParams);
  const todayMoment = moment();

  return {
    eventedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.eventedAt.gte, filterVariables.eventedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.eventedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.eventedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    categoryType: {
      active: maybe(() => !utils.isEmpty(filterVariables.categoryType), false),
      value: maybe(
        () => dedupeFilter(filterVariables.categoryType.map((status) => findValueInEnum(status, CategoryTypeEnum))),
        []
      ),
    },
    trackInventory: {
      active: maybe(() => !utils.isEmpty(filterVariables.trackInventory), false),
      value: maybe(() => filterVariables.trackInventory, false),
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    paymentSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.paymentSearch, true), false),
      value: maybe(() => filterVariables.paymentSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    brandProductSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandProductSearch, true), false),
      value: maybe(() => filterVariables.brandProductSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch, true), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
    isOrderFromBossMrkt: {
      active: maybe(() => filterVariables.isOrderFromBossMrkt !== undefined, false),
      value: maybe(() => filterVariables.isOrderFromBossMrkt, false),
    },
    isInner: {
      active: maybe(() => filterVariables.isInner !== undefined, false),
      value: maybe(() => filterVariables.isInner, true),
    },
    exclusive: {
      active: maybe(() => filterVariables.exclusive !== undefined, false),
      value: maybe(() => filterVariables.exclusive, true),
    },
  };
}

export function getFilterVariables(
  params: OrderSalesListViewUrlFilters,
  routeParams: OrderSalesListViewRouteParams
): SalesFilterInput {
  const { viewType, fulfilledBy } = routeParams;
  const isFulfilledByVendor = fulfilledBy === "vendor";

  const orderType = [];
  switch (viewType) {
    case "by-user":
      orderType.push(...getOrderTypeEnums(OrderType.BY_USER));
      break;
    case "by-staff-by-brand":
      orderType.push(...getOrderTypeEnums(OrderType.BY_STAFF_FOR_BRAND));
      break;
    case "by-staff-for-bad-stock":
      orderType.push(...getOrderTypeEnums(OrderType.BY_STAFF_FOR_BAD_STOCK));
      break;
    case "for-hq":
      orderType.push(...[OrderTypeEnum.BY_USER, OrderTypeEnum.BY_STAFF_FOR_BRAND, OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND]);
      break;
    default:
      break;
  }

  const filterVariables: SalesFilterInput = {
    eventedAt: getGteLteVariables({
      gte: params.eventedAtFrom,
      lte: params.eventedAtTo,
    }),
    categoryType: maybe(() => params.categoryType.map((status) => findInEnum(status, CategoryTypeEnum))) || [],
    trackInventory: params.trackInventory !== undefined ? parseBoolean(params.trackInventory, false) : undefined,
    isFulfilledByVendor,
    isOrderFromBossMrkt:
      params.isOrderFromBossMrkt !== undefined ? parseBoolean(params.isOrderFromBossMrkt, false) : undefined,
    isInner: params.isInner !== undefined ? parseBoolean(params.isInner, true) : undefined,
    exclusive: params.exclusive !== undefined ? parseBoolean(params.exclusive, true) : undefined,
    isMainPv: true, // 비세트 상품 + 세트 상품 대표 구성품만 조회
    orderType,
    orderSearch: params.orderSearch !== undefined ? params.orderSearch : null,
    paymentSearch: params.paymentSearch !== undefined ? params.paymentSearch : null,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    brandStoreSearch: params.brandStoreSearch,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    mdSearch: params.mdSearch !== undefined ? params.mdSearch : null,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    brandProductSearch: params.brandProductSearch !== undefined ? params.brandProductSearch : null,
  };

  return filterVariables;
}

export function getFilterQueryParam(filter: IFilterElement<OrderSalesListFilterKeys>): OrderSalesListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case OrderSalesListFilterKeys.eventedAt:
      return getMinMaxQueryParam(
        filter,
        OrderSalesListViewUrlFiltersEnum.eventedAtFrom,
        OrderSalesListViewUrlFiltersEnum.eventedAtTo
      );
    case OrderSalesListFilterKeys.categoryType:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderSalesListViewUrlFiltersWithMultipleValuesEnum.categoryType,
        CategoryTypeEnum
      );
    case OrderSalesListFilterKeys.trackInventory:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.trackInventory);
    case OrderSalesListFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.orderSearch);
    case OrderSalesListFilterKeys.paymentSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.paymentSearch);
    case OrderSalesListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.brandSearch);
    case OrderSalesListFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.brandStoreSearch);
    case OrderSalesListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.userSearch);
    case OrderSalesListFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.mdSearch);
    case OrderSalesListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.productSearch);
    case OrderSalesListFilterKeys.brandProductSearch:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.brandProductSearch);
    case OrderSalesListFilterKeys.isOrderFromBossMrkt:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.isOrderFromBossMrkt);
    case OrderSalesListFilterKeys.isInner:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.isInner);
    case OrderSalesListFilterKeys.exclusive:
      return getSingleValueQueryParam(filter, OrderSalesListViewUrlFiltersEnum.exclusive);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<OrderSalesListViewUrlFilters>(ORDER_SALES_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  OrderSalesListViewUrlQueryParams,
  OrderSalesListViewUrlFilters
>({
  ...OrderSalesListViewUrlFiltersEnum,
  ...OrderSalesListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

