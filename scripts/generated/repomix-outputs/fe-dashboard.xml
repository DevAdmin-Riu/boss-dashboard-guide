import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { BsOpsCheckTemplateCreateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Form } from "antd";
import React from "react";

import { useBsOpsCheckTemplateCreateMutation } from "../api/mutations";
import { BsOpsCheckTemplateCreatePage } from "../components/BsOpsCheckTemplateCreatePage";
import { bsOpsCheckTemplateDetailsViewUrl, bsOpsCheckTemplateListViewUrl } from "../urls";

export const BsOpsCheckTemplateCreateView: React.FC = () => {
  const navigate = useNavigator();
  const { user } = useUser();
  const brandId = user.isHqStaff ? user.brand.id : null;

  const [form] = Form.useForm<BsOpsCheckTemplateCreateInput>();
  const TypeSafeForm = getTypeSafeForm<BsOpsCheckTemplateCreateInput>(form);

  const initialValues: BsOpsCheckTemplateCreateInput = {
    brand: brandId,
    title: null,
    description: null,
    categories: [{ name: null }],
  };

  const {
    loadMore: brandLoadMore,
    search: brandSearch,
    result: brandResult,
  } = useBrandSearch({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.brandsForSearch },
  });
  const brandList = maybe(() => brandResult.data.search.edges.map((edge) => edge.node), []);
  const fetchMoreReport: FetchMoreProps = {
    hasMore: maybe(() => brandResult.data.search.pageInfo.hasNextPage),
    loading: brandResult.loading,
    onFetchMore: brandLoadMore,
  };

  const [bsOpsCheckTemplateCreate, bsOpsCheckTemplateCreateOpts] = useBsOpsCheckTemplateCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bsOpsCheckTemplateCreate.errors, "점검 양식이 등록되었습니다.", () =>
        navigate(bsOpsCheckTemplateDetailsViewUrl(data.bsOpsCheckTemplateCreate.bsOpsCheckTemplate.id))
      ),
  });

  const handleBack = () => navigate(bsOpsCheckTemplateListViewUrl());

  const pageLoading = bsOpsCheckTemplateCreateOpts.loading;

  return (
    <>
      <Form
        form={form}
        name="bs-ops-check-template-create"
        layout="vertical"
        initialValues={initialValues}
        onFinish={(formData) => {
          bsOpsCheckTemplateCreate({ variables: { input: formData } });
        }}
      >
        <BsOpsCheckTemplateCreatePage
          TypeSafeForm={TypeSafeForm}
          loading={pageLoading}
          brandList={brandList}
          brandFetchMore={fetchMoreReport}
          onBrandSearch={brandSearch}
          onBack={handleBack}
        />
      </Form>
    </>
  );
};
</file>

