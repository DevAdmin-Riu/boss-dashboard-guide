import { CopyOutlined } from "@ant-design/icons";
import { commonMsg, formRuleMsg } from "@assets/messages/commonMsg";
import { BrandStoreBasicInfoUpdateInput, CountryCode } from "@src/api/types/globalTypes";
import { getFormItemClassName } from "@src/app/components/antd/Form/FormProps";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField from "@src/app/components/EditableField/EditableField";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  brandStoreContractChoices,
  brandStoreStatusChoices,
  brandStoreTypeChoices,
} from "@src/app/views/brand/brandStore/utils";
import { DeepPartial, makeAddressInputFromDaumPostcode, transformPhoneNumber } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Divider, Form, Input, Modal, Row, Space, Typography } from "antd";
import _ from "lodash";
import React, { useEffect, useState } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

import { useBrandStoreBasicInfoUpdateMutation } from "../api/mutations";
import { BrandStoreDetails_brandStore } from "../api/types/BrandStoreDetails";

interface BrandStoreBasicInfo {
  isHqStaff: boolean;
  brandStore: BrandStoreDetails_brandStore;
}

export const BrandStoreBasicInfo: React.FC<BrandStoreBasicInfo> = (props) => {
  const { isHqStaff, brandStore } = props;
  const [form] = Form.useForm<BrandStoreBasicInfoUpdateInput>();
  const TypeSafeForm = getTypeSafeForm<BrandStoreBasicInfoUpdateInput>(form);
  const [editMode, setEditMode] = useState(false);
  const [openSearchAddressModal, setOpenSearchAddressModal] = useState(false);

  const [brandStoreBasicInfoUpdate, brandStoreBasicInfoUpdateOpts] = useBrandStoreBasicInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandStoreBasicInfoUpdate.errors, commonMsg.savedChanges, () => {
        setEditMode(false);
      }),
  });

  const handleSubmit = async (formData: BrandStoreBasicInfoUpdateInput) => {
    const autoInput: DeepPartial<BrandStoreBasicInfoUpdateInput> = {
      brandStoreAddress: {
        input: {
          firstName: formData.name,
          phone: formData.aligoPhone,
        },
      },
    };
    await brandStoreBasicInfoUpdate({
      variables: {
        id: brandStore.id,
        input: _.merge({}, formData, autoInput),
      },
    });
  };

  const initialValues: BrandStoreBasicInfoUpdateInput = {
    name: brandStore.name,
    type: brandStore.type,
    status: brandStore.status,
    aligoPhone: transformPhoneNumber(brandStore.phone),
    email: brandStore.email,
    contract: brandStore.contract,
    bizRegNo: brandStore.bizRegNo,
    bizRegCorpName: brandStore.bizRegCorpName,
    bizRegCeoName: brandStore.bizRegCeoName,
    bizRegBizClass: brandStore.bizRegBizClass,
    bizRegBizType: brandStore.bizRegBizType,
    brandStoreAddress: {
      id: brandStore.address?.id ? brandStore.address.id : undefined,
      input: {
        postalCode: brandStore.address?.postalCode,
        city: brandStore.address?.city,
        countryArea: brandStore.address?.countryArea,
        country: CountryCode.KR,
        streetAddress1: brandStore.address?.streetAddress1,
        streetAddress2: brandStore.address?.streetAddress2,
      },
    },
  };

  const searchAddress = (address: Address) => {
    const input = makeAddressInputFromDaumPostcode(address);
    const touched = true;
    TypeSafeForm.setFields([
      { touched, name: "brandStoreAddress.input.postalCode", value: input.postalCode },
      { touched, name: "brandStoreAddress.input.city", value: input.city },
      { touched, name: "brandStoreAddress.input.country", value: input.country },
      { touched, name: "brandStoreAddress.input.countryArea", value: input.countryArea },
      { touched, name: "brandStoreAddress.input.streetAddress1", value: input.streetAddress1 },
    ]);
    setOpenSearchAddressModal(false);
  };

  // editMode가 true에서 false로 바뀌는 경우 form reset되어야 한다. useEffect 사용.
  useEffect(() => {
    if (!editMode) {
      form.resetFields();
    }
  }, [editMode]);

  return (
    <Form
      form={form}
      initialValues={initialValues}
      labelCol={{ span: 24 }}
      wrapperCol={{ span: 24 }}
      onFinish={handleSubmit}
      validateMessages={{ required: formRuleMsg.required }}
    >
      <Card
        title={
          <Space direction="horizontal" align="center">
            <Typography.Title level={4}>기본 정보</Typography.Title>
            <Typography.Text type={"secondary"}>
              매장코드: {brandStore.code} <Divider type="vertical" /> 등록일:
              {getDateByFormat(brandStore.created, onlyDateFormat)}
            </Typography.Text>
            {!isHqStaff && brandStore.ownerUser.vact && (
              <Typography.Text type={"secondary"}>
                충전금 가상계좌:
                <span
                  style={{ cursor: "pointer" }}
                  onClick={() => {
                    utils.copyToClipboard(brandStore.ownerUser.vact.acctNo);
                    showNotificationSuccess("가상계좌 번호를 복사하였습니다.");
                  }}
                >
                  {brandStore.ownerUser.vact.bankCode.bankName} - {brandStore.ownerUser.vact.acctNo} <CopyOutlined />
                </span>
              </Typography.Text>
            )}
          </Space>
        }
        extra={
          <FormSaveButton
            form={form}
            loading={brandStoreBasicInfoUpdateOpts.loading}
            isEditMode={editMode}
            onEdit={() => setEditMode(true)}
            onCancel={() => setEditMode(false)}
          />
