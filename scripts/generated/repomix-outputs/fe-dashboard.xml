import { FormChange } from "@hooks/useForm";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { CategoryKindEnum } from "@src/api/types/globalTypes";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Card, Col, Collapse, Input, Row } from "antd";
import React, { useState } from "react";

import { ProductForCreateVariant_product } from "../api/types/ProductForCreateVariant";
import {
  ProductVariantDetails_productVariant,
  ProductVariantDetails_productVariant_product,
} from "../api/types/ProductVariantDetails";
import {
  getProductVariantFirstAvailableForPurchaseDate,
  getProductVariantSku,
  getProductVariantStoppedAtDate,
} from "../utils/data";
import OnSaleNotificationModal from "./OnSaleNotificationModal";
import {
  getFormInputCommonProps,
  makeProductCardTitle,
  makeProductDecimalPlacesForm,
  makeProductQuantityForm,
  makeProductSalesStatusForm,
  makeProductStockInfoForm,
  OnSaleOptionsType,
} from "./ProductDetailsForm";
import { ProductVariantCreateData } from "./ProductVariantCreatePage/form";
import { ProductVariantUpdateData } from "./ProductVariantUpdatePage/form";

export interface ProductVariantBasicFormProps {
  data: ProductVariantCreateData | ProductVariantUpdateData;
  product: ProductForCreateVariant_product | ProductVariantDetails_productVariant_product;
  variant?: ProductVariantDetails_productVariant;
  onSaleByInnerToBrand?: boolean;
  disabled: boolean;
  // 직거래 상품은 비옵션형 제품으로만 생성하는 것이 정책. 따라서 옵션 생성/수정 시 isFulfilledByVendor 값은 항상 false이지만 제품 생성/수정 시와 props 통일하기 위해 추가
  isFulfilledByVendor: boolean;
  errors: ProductErrorFragment[];
  onChange: FormChange;
  onSaleOptions?: OnSaleOptionsType;
}

const makeVariantNameField = (props: ProductVariantBasicFormProps) => {
  const { data, errors, onChange, disabled } = props;
  const fieldKey = "name";
  const formErrors = getFormErrors([fieldKey], errors);

  return (
    <Col span={24}>
      <FormFieldAntd label="옵션명" error={formErrors[fieldKey]} errorMsg={makeGqlErrorMsg(formErrors[fieldKey])}>
        <Input
          {...getFormInputCommonProps(disabled)}
          name={fieldKey}
          status={!!formErrors[fieldKey] && "error"}
          placeholder="옵션명을 입력해주세요."
          value={data[fieldKey]}
          onChange={onChange}
        />
      </FormFieldAntd>
    </Col>
  );
};

export const ProductVariantBasicForm: React.FC<ProductVariantBasicFormProps> = (props) => {
  const { variant, product, data, onSaleOptions } = props;
  const shopData = useShop();
  const salesStoppedReasonChoices = shopData?.stoppedReasonChoices;
  const [isDeferredConfirmModal, setIsDeferredConfirmModal] = React.useState<boolean>(false);

  // 판매 가능 알림 모달 상태
  const [isOnSaleModalOpen, setIsOnSaleModalOpen] = useState(false);
  const [onSaleTargetVariantId, setOnSaleTargetVariantId] = useState<string | null>(null);

  const isCreateMode = utils.isEmpty(variant);
  const { canSaleByInner } = data;
  const showInnerVariantFields = canSaleByInner;
  const showVariantNameFields = isCreateMode === false;
  const isStandardCategoryKind = product?.category.kind === CategoryKindEnum.STANDARD;

  const sku = getProductVariantSku(variant);
  const firstAvailableForPurchaseDate = getProductVariantFirstAvailableForPurchaseDate(variant);
  const stoppedAtDate = getProductVariantStoppedAtDate(variant);
  const cardTitle = makeProductCardTitle(sku, firstAvailableForPurchaseDate, stoppedAtDate);

  // 이너박스용 onSaleOptions (이너의 firstAvailableForPurchase 및 innerVariantId 사용)
  const innerOnSaleOptions: OnSaleOptionsType | undefined = onSaleOptions
    ? {
        outerVariantId: onSaleOptions.outerVariantId,
        innerVariantId: onSaleOptions.innerVariantId,
        firstAvailableForPurchase: variant?.inner?.firstAvailableForPurchase,
        onClickOnSaleButton: onSaleOptions.onClickOnSaleButton,
        loading: onSaleOptions.loading,
      }
    : undefined;

  const handleOpenOnSaleModal = (isInner: boolean) => {
    const targetId = isInner ? onSaleOptions?.innerVariantId : onSaleOptions?.outerVariantId;
    if (targetId) {
      setOnSaleTargetVariantId(targetId);
      setIsOnSaleModalOpen(true);
    }
  };

  const handleOnSaleModalOk = (recipientList: string[]) => {
    if (onSaleTargetVariantId && onSaleOptions) {
      onSaleOptions.onClickOnSaleButton(onSaleTargetVariantId, recipientList);
    }
    setIsOnSaleModalOpen(false);
    setOnSaleTargetVariantId(null);
  };

  const handleOnSaleModalCancel = () => {
    setIsOnSaleModalOpen(false);
    setOnSaleTargetVariantId(null);
  };

  return (
    <>
      <Card title={cardTitle} bodyStyle={{ padding: 0 }}>
        <Collapse defaultActiveKey={["outer", "inner"]}>
          <Collapse.Panel header={showInnerVariantFields ? "아우터박스 기본 정보" : "제품 기본 정보"} key="outer">
            <Row gutter={[12, 12]}>
              {showVariantNameFields && makeVariantNameField(props)}
              {makeProductSalesStatusForm(props, salesStoppedReasonChoices, false, isCreateMode, onSaleOptions, () =>
                handleOpenOnSaleModal(false)
              )}
              {makeProductStockInfoForm(
                props,
                isDeferredConfirmModal,
                setIsDeferredConfirmModal,
                false,
                isStandardCategoryKind
              )}
              {makeProductDecimalPlacesForm(props, isCreateMode)}
            </Row>
          </Collapse.Panel>
          {showInnerVariantFields && (
            <Collapse.Panel header="이너박스 기본 정보" key="inner">
              <Row gutter={[12, 12]}>
                {makeProductSalesStatusForm(
                  props,
                  salesStoppedReasonChoices,
                  true,
                  isCreateMode,
                  innerOnSaleOptions,
                  () => handleOpenOnSaleModal(true)
                )}
                {makeProductQuantityForm(props, true, 0)}
              </Row>
            </Collapse.Panel>
          )}
        </Collapse>
      </Card>
      <OnSaleNotificationModal
        open={isOnSaleModalOpen}
        sku={onSaleOptions?.sku}
        loading={onSaleOptions?.loading}
        onOk={handleOnSaleModalOk}
        onCancel={handleOnSaleModalCancel}
      />
    </>
  );
};
</file>

