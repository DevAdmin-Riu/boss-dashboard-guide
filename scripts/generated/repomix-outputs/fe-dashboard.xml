  { label: "이탈", value: PreFounderConsultationResultEnum.DROP },
];

export const preFounderStatsDimensionChoices = [
  { label: columnNameConstant.preFounder.LEAD_SOURCE, value: PreFounderStatsDimensionEnum.SOURCE },
  { label: columnNameConstant.preFounder.DESIRED_REGION, value: PreFounderStatsDimensionEnum.REGION },
  { label: columnNameConstant.common.GENDER, value: PreFounderStatsDimensionEnum.GENDER },
];

export const makePreFounderLeadSourceText = (
  preFounder: Pick<HqPreFounderList_preFounderList_edges_node, "leadSource" | "leadSourceEtc">
) => {
  if (utils.isEmpty(preFounder)) {
    return "-";
  }
  const { leadSource, leadSourceEtc } = preFounder;
  const leadSourceText = utils.getLabelTextByValue(leadSource, preFounderLeadSourceChoices);
  if (leadSource === PreFounderLeadSourceEnum.ETC && !utils.isEmpty(leadSourceEtc)) {
    return `${leadSourceText} (${leadSourceEtc})`;
  }
  return leadSourceText;
};

export type TPreFounderBasicDocumentsObj = Partial<
  Record<PreFounderBasicDocumentTypeEnum, PreFounderBasicDocumentUpsertInput>
>;

export const makePreFounderBasicDocumentsObj = (
  basicDocuments: HqPreFounderDetails_preFounder_basicDocuments[]
): TPreFounderBasicDocumentsObj => {
  const basicDocumentsArr = basicDocuments || [];
  const basicDocumentTypeEnumList = Object.values(PreFounderBasicDocumentTypeEnum);
  const basicDocumentsObj = basicDocumentTypeEnumList.reduce<TPreFounderBasicDocumentsObj>((acc, docType) => {
    const existingDoc = basicDocumentsArr.find((doc) => doc.type === docType);
    const file = toUploadFormInitialValue(existingDoc, "fileName");
    acc[docType] = { type: docType, file };
    return acc;
  }, {});
  return basicDocumentsObj;
};

export const cleanPreFounderBasicDocumentsObj = (
  formData: IPreFounderCreateFormData | IPreFounderBasicInfoUpdateFormData
): PreFounderCreateInput | PreFounderBasicInfoUpdateInput => {
  const uploadFieldNamePathList: Array<FieldPath<IPreFounderCreateFormData | IPreFounderBasicInfoUpdateFormData>> = [];
  const basicDocumentTypeEnumList = Object.values(PreFounderBasicDocumentTypeEnum);
  basicDocumentTypeEnumList.forEach((docType) => {
    uploadFieldNamePathList.push(`basicDocumentsObj.${docType}.file`);
  });
  const cleanedInput = cleanFormDataUploadInputs(formData, uploadFieldNamePathList);
  const cleanedBasicDocuments = convertFormLinesObjToArr(cleanedInput.basicDocumentsObj, "type").filter(
    (doc) => doc.file !== undefined
  );

  // 반환할 입력 데이터 생성
  const input: PreFounderCreateInput | PreFounderBasicInfoUpdateInput = {
    ..._.omit(cleanedInput, ["basicDocumentsObj"]),
    basicDocuments: cleanedBasicDocuments,
  };

  return input;
};

export const getHqPreFounderStatListDefaultParams = (): HqPreFounderStatListViewUrlQueryParams => {
  const { gte, lte } = getDefaultGteLteVariablesForMonth();
  return { dimension: PreFounderStatsDimensionEnum.SOURCE, statDateFrom: gte, statDateTo: lte };
};
