      }
    }
  }
`;
export const useVsPurchaseOrderLinesInspectMutation = makeMutation<
  PurchaseOrderLinesInspect,
  PurchaseOrderLinesInspectVariables
>(VsPurchaseOrderLinesInspectMutation);

const purchaseOrderLinesDeliveredMutation = gql`
  ${purchaseOrderErrorFragment}
  mutation PurchaseOrderLinesDelivered($purchaseOrderLineIds: [ID]!) {
    purchaseOrderLinesDelivered(purchaseOrderLineIds: $purchaseOrderLineIds) {
      purchaseOrderLines {
        id
        status
      }
      errors: purchaseOrderErrors {
        ...PurchaseOrderErrors
      }
    }
  }
`;
export const usePurchaseOrderLinesDeliveredMutation = makeMutation<
  PurchaseOrderLinesDelivered,
  PurchaseOrderLinesDeliveredVariables
>(purchaseOrderLinesDeliveredMutation);

const purchaseBulkReqRevisionMutation = gql`
  ${statsErrorFragment}
  mutation PurchaseBulkReqRevision($ids: [ID]!, $purchaseCloseDate: Date!, $reqRevisionReason: String!) {
    purchaseBulkReqRevision(ids: $ids, purchaseCloseDate: $purchaseCloseDate, reqRevisionReason: $reqRevisionReason) {
      count
      errors: statsErrors {
        ...StatsErrorFragment
      }
    }
  }
`;
export const usePurchaseBulkReqRevisionMutation = makeMutation<
