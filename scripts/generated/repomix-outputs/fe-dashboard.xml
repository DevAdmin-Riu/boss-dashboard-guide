export const NewBrandDetailsPage: React.FC<BrandCreatePageProps> = ({
  brand,
  loading,
  onBack,
  onSubmit,
  openBrandStoreCreateModal,
  openHqStaffCreateModal,
}) => {
  const navigate = useNavigator();
  const initialValues = makeInitialForm(brand);

  const [form] = Form.useForm<BrandUpdateInput>();
  const TypeSafeForm = getTypeSafeForm<BrandUpdateInput>(form);

  const initialEditModes = Object.values(CollapseKeys).reduce(
    (acc, key) => ({ ...acc, [key]: false }),
    {} as Record<CollapseKeys, boolean>
  );
  const [editModes, setEditModes] = React.useState(initialEditModes);

  const handleEditModeChange = (keyToEnable: CollapseKeys) => {
    form.resetFields();
    setEditModes({ ...initialEditModes, [keyToEnable]: true });
  };

  const handleOnCancel = () => {
    form.resetFields();
    setEditModes({ ...initialEditModes });
  };

  const handleUpdate = async (formData: BrandUpdateInput) => {
    const uploadFieldNamePathList: Array<FieldPath<BrandUpdateInput>> = ["image", "bizRegImage", "accountImage"];
    if (formData.etcFiles && Array.isArray(formData.etcFiles)) {
      formData.etcFiles.forEach((_, index) => {
        uploadFieldNamePathList.push(`etcFiles.${index}.file`);
      });
    }
    const cleanedFormData = cleanFormDataUploadInputs(formData, uploadFieldNamePathList);

    const { data } = await onSubmit({
      variables: { id: brand.id, input: cleanedFormData },
    });

    const errors = data?.brandUpdate.errors;
    if (errors?.length === 0) {
      form.resetFields();
      setEditModes({ ...initialEditModes });
