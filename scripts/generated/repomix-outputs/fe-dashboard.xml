<file path="src/app/views/product/products/components/DownloadProductListModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { commonErrorMsg } from "@assets/messages/errors/commonError";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { excelDownload } from "@utils/excel/excelDownload";
import { transformIsFBV } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { Checkbox, Form, Modal } from "antd";
import React, { useEffect, useState } from "react";

import { useDownloadProductListLazyQuery } from "../api/queries";
import { DownloadProductListVariables } from "../api/types/DownloadProductList";
import { parseProductList } from "./ProductListPage/utils";

interface DownloadProductListModalProps {
  open: boolean;
  loading: boolean;
  isFulfilledByVendor: boolean;
  shop: ShopInfo_shop;
  onClose: () => void;
}

interface DownloadProductListForm {
  includeBrandInfo: boolean;
}

export const DownloadProductListModal: React.FC<DownloadProductListModalProps> = (props) => {
  const { open, loading, isFulfilledByVendor, shop, onClose } = props;
  const [loadingForReport, setLoadingForReport] = useState<boolean>(false);
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<DownloadProductListForm>(form);
  const formInstance = TypeSafeForm.formInstance;
  const initialValues: DownloadProductListForm = { includeBrandInfo: false };

  const buttonLoading = loading || loadingForReport;

  const [refetchForDownload] = useDownloadProductListLazyQuery();

  useEffect(() => {
    formInstance.resetFields();
  }, [open]);

  const onDownloadProductList = (formData: DownloadProductListForm) => {
    const title = `${transformIsFBV(isFulfilledByVendor)} 제품 리스트`;
    const { includeBrandInfo } = formData;
    const queryVariables: DownloadProductListVariables = {
      first: GrapheneRelayConnectionMaxLimitEnum.reportProductList,
      includeBrandInfo,
      isFulfilledByVendor,
    };

    setLoadingForReport(true);
    showDownloadingMessage();

    const handleErrorCatch = (e: any) => {
      showNotificationError(`${title} 다운로드 과정에서 에러가 발생하였습니다.`);
      throw e;
    };

    const handleRefetchFinally = () => {
      onClose();
      setLoadingForReport(false);
      destroyDownloadingMessage();
    };

    refetchForDownload({ variables: queryVariables })
      .then((resProductList) => {
        const { columns, colsInfo, header, merges } = parseProductList(
          resProductList,
          shop,
          includeBrandInfo,
          isFulfilledByVendor
        );
        if (!columns || columns.length <= 0) {
          showNotificationWarn("출력할 데이터가 없습니다.");
          return;
        }
        excelDownload({ title, columns, colsInfo, header, merges, skipOriginHeader: true });

        const products = resProductList?.data?.products;
        if (products?.edges?.length < products?.totalCount) {
          showNotificationWarn(commonErrorMsg.maxLimitIssue);
        } else {
          showNotificationSuccess(commonMsg.downloadedToXls);
        }
      })
      .catch(handleErrorCatch)
      .finally(handleRefetchFinally);
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title="제품 리스트 다운로드"
      okText="엑셀 출력"
      onOk={formInstance.submit}
      onCancel={onClose}
      okButtonProps={{ loading: buttonLoading }}
      cancelButtonProps={{ loading: buttonLoading, onClick: onClose }}
    >
      <Form
        form={formInstance}
        initialValues={initialValues}
        name="product-list-download-form"
        onFinish={onDownloadProductList}
      >
        <Form.Item name="includeBrandInfo" valuePropName="checked" label="브랜드 정보 포함">
          <Checkbox />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

