import { FormChange } from "@hooks/useForm";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { SearchVendorsVariables } from "@src/api/searches/types/SearchVendors";
import useVendorSearch from "@src/api/searches/useVendorSearch";
import { CategoryKindEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { makeVendorDisplayName, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Checkbox, Col, Input, InputNumber, Row, Select, Space, Switch, Typography } from "antd";
import { CheckboxChangeEvent } from "antd/lib/checkbox";
import React, { useMemo } from "react";

import { ProductCreateData } from "../ProductCreatePage/form";
import { getFormInputCommonProps, hasIsFbvProperty } from "../ProductDetailsForm";
import { ProductVariantCreateData } from "../ProductVariantCreatePage/form";
import { getSearchVendorsVariablesForPvv } from "./utils";

interface ProductDetailsFormProps {
  data: ProductCreateData | ProductVariantCreateData;
  isFulfilledByVendor: boolean;
  errors: ProductErrorFragment[];
  onChange: FormChange;
  disabled: boolean;
  categoryKind?: CategoryKindEnum;
}

// 타입 가드 함수 - ProductCreateData인지 확인
const isProductCreateData = (data: ProductCreateData | ProductVariantCreateData): data is ProductCreateData =>
  "defaultPvvIncludePurchaseB2bDeliveryFee" in data || "defaultPvvPurchaseB2bDeliveryFeeExcludeVat" in data;

const ProductDefaultVendor: React.FC<ProductDetailsFormProps> = (props) => {
  const { data, isFulfilledByVendor, onChange, disabled, categoryKind } = props;

  const isB2bCategoryKind = categoryKind === CategoryKindEnum.B2B;
  const isDevCategoryKind = categoryKind === CategoryKindEnum.DEV;

  const defaultPvvCostPriceExcludeVat =
    utils.isEmpty(data.defaultPvvProductPriceExcludeVat) === false &&
    utils.isEmpty(data.defaultPvvDeliveryFeeExcludeVat) === false
      ? data.defaultPvvProductPriceExcludeVat + data.defaultPvvDeliveryFeeExcludeVat
      : undefined;
  const defaultPvvConsignmentCostPriceExcludeVat =
    utils.isEmpty(data.defaultPvvConsignmentProductPriceExcludeVat) === false &&
    utils.isEmpty(data.defaultPvvConsignmentDeliveryFeeExcludeVat) === false
      ? data.defaultPvvConsignmentProductPriceExcludeVat + data.defaultPvvConsignmentDeliveryFeeExcludeVat
      : undefined;

  const precision = data.priceDecimalPlaces;

  const queryVariables = useMemo<SearchVendorsVariables>(
    () => getSearchVendorsVariablesForPvv(isFulfilledByVendor, isB2bCategoryKind),
    []
  );

  const {
    loadMore: loadMoreVendors,
    search: searchVendors,
    result: searchVendorsOpts,
  } = useVendorSearch({
    variables: queryVariables,
  });
  const vendors = maybe(() => searchVendorsOpts.data.search.edges.map((edge) => edge.node), []);
  const vendorOptions: Array<{ label: string; value: string }> = vendors.map((vendor) => {
    const displayName = makeVendorDisplayName(vendor);
    return { label: displayName, value: vendor.code };
  });

  const onChangeWithValue = (name: string, value: any) => onChange({ target: { name, value } });

  const makeTitle = (
    <Space>
      <Typography.Title level={4}>기본 협력사</Typography.Title>
    </Space>
  );
  return (
    <Card title={makeTitle}>
      <Row justify="end">
        <TableVatLegend isIncludeVat={false} size="small" />
      </Row>
      <Row justify="space-between" gutter={[12, 12]}>
        <Col span={24}>
          <FormFieldAntd isRequired label="협력사">
            <Select
              showSearch
              style={{ width: "100%" }}
              loading={searchVendorsOpts.loading}
              placeholder="협력사 선택"
              options={vendorOptions}
              filterOption={(input, option) =>
                typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase())
              }
              onChange={(value) => {
                onChangeWithValue("defaultPvvVendorCode", value);
              }}
              onSearch={searchVendors}
              onPopupScroll={({ currentTarget }) => {
                const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                const hasMore = maybe(() => searchVendorsOpts.data.search.pageInfo.hasNextPage);
                const searchLoading = searchVendorsOpts.loading;
                // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                if (scrollHeight - scrollTop === clientHeight && hasMore && searchLoading === false) {
                  loadMoreVendors();
                }
              }}
            />
          </FormFieldAntd>
        </Col>
        <Col span={8}>
          <FormFieldAntd label="활성화">
            <Switch
              onChange={(value) => {
                onChangeWithValue("defaultPvvIsActive", value);
              }}
              checked={data.defaultPvvIsActive}
            />
          </FormFieldAntd>
        </Col>
        <Col span={8}>
          <FormFieldAntd label="협력사 상품 ID">
            <Input
              {...getFormInputCommonProps(disabled)}
              name="defaultPvvExternalSku"
              placeholder="협력사 상품 ID를 입력해주세요."
              value={data.defaultPvvExternalSku}
              onChange={onChange}
            />
          </FormFieldAntd>
        </Col>
        <Col span={8}>
          <FormFieldAntd label="협력사 상품명">
            <Input
