<file path="src/app/views/order/orders/views/BatchPickingListView/filters.ts">
import { BatchPickingFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  createFilterTabUtils,
  createFilterUtils,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { BatchPickingFilterKeys, BatchPickingListFilterOpts } from "../../components/BatchPickingListPage/filters";
import {
  BatchPickingListViewUrlFilters,
  BatchPickingListViewUrlFiltersEnum,
  BatchPickingListViewUrlFiltersWithMultipleValuesEnum,
  BatchPickingListViewUrlQueryParams,
} from "../../urls";

export const BATCH_PICKING_FILTERS_KEY = "batchPickingFilters";

export function getFilterOpts(params: BatchPickingListViewUrlFilters): BatchPickingListFilterOpts {
  const filterVariables = getBatchPickingListUrlFilterVariables(params);

  return {
    batchCode: {
      active: maybe(() => !utils.isEmpty(filterVariables.batchCode, true), false),
      value: maybe(() => filterVariables.batchCode, ""),
    },
    warehouseAddress: {
      active: maybe(() => !utils.isEmpty(filterVariables.warehouseAddresses), false),
      value: maybe(() => filterVariables.warehouseAddresses, []),
    },
  };
}

export function getBatchPickingListUrlFilterVariables(params: BatchPickingListViewUrlFilters): BatchPickingFilterInput {
  return {
    batchCode: params.batchCode,
    warehouseAddresses: params.warehouseAddress,
    needToTrackingNumber: true,
  };
}

export function getFilterQueryParam(filter: IFilterElement<BatchPickingFilterKeys>): BatchPickingListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case BatchPickingFilterKeys.batchCode:
      return getSingleValueQueryParam(filter, BatchPickingListViewUrlFiltersEnum.batchCode);
    case BatchPickingFilterKeys.warehouseAddress:
      return getMultipleValueQueryParam(filter, BatchPickingListViewUrlFiltersWithMultipleValuesEnum.warehouseAddress);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BatchPickingListViewUrlFilters>(BATCH_PICKING_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BatchPickingListViewUrlQueryParams,
  BatchPickingListViewUrlFilters
>({ ...BatchPickingListViewUrlFiltersEnum });
</file>

