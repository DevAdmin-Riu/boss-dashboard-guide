  const isTrackInventoryList = inventoryType === "track-inventory";

  const fixedRightFlag = utils.fixedRightFlag();

  let title: DownloadableColumnType<PurchaseOrderLineList_purchaseOrderLines_edges_node>["title"] = "";
  const align: DownloadableColumnType<PurchaseOrderLineList_purchaseOrderLines_edges_node>["align"] = "center";
  const width: DownloadableColumnType<PurchaseOrderLineList_purchaseOrderLines_edges_node>["width"] = 100;
  let render: DownloadableColumnType<PurchaseOrderLineList_purchaseOrderLines_edges_node>["render"];
  switch (status) {
    case "dispatch-fulfillment":
      if (isTrackInventoryList) {
        title = "분납 요청";
        render = (_, record) => (
          <Button size="small" type="primary" onClick={() => openModal("req-split-delivery", { id: record.id })}>
            분납 요청
          </Button>
        );
      }
  }

  if (utils.isEmpty(render)) {
    return;
  }
  return {
    title,
    key: "action",
    align,
    width,
    fixed: fixedRightFlag,
    isPickerHide: true,
    doNotRenderExcel: true,
    render,
  };
};

const buttonWrapCol = ({
  disabled,
  selectedPurchaseOrderLineId,
  onLineDelete,
  isEditing,
  onEdit,
  onSubmit,
  onCancel,
  onLinesCancel,
  onLinesSend,
  onLineReqSplitDelivery,
  onApproveReqSplitDeliveryButtonClick,
}: {
  disabled: boolean;
  selectedPurchaseOrderLineId: string;
  onLineDelete: (variables: PurchaseOrderLineDeleteVariables) => void;
  isEditing: (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => boolean;
  onEdit: (record: PurchaseOrderLineList_purchaseOrderLines_edges_node) => void;
  onSubmit: (purchaseOrder: PurchaseOrderLineList_purchaseOrderLines_edges_node_purchaseOrder) => void;
  onCancel: () => void;
  onLinesCancel: (variables: PurchaseOrderLinesCancelVariables) => void;
  onLinesSend: (variables: PurchaseOrderLinesSendVariables) => void;
  onLineReqSplitDelivery: (id: string) => void;
  onApproveReqSplitDeliveryButtonClick: (id: string) => void;
}): DownloadableEditableColumnType<PurchaseOrderLineList_purchaseOrderLines_edges_node> => ({
  key: "button",
  align: "center",
  width: 150,
  fixed: utils.fixedRightFlag(),
  doNotRenderExcel: true,
  isPickerHide: true,
  render: (_, record) => {
    const status = record.status;
    const isNotSent = record.purchaseOrder.isSent === false;
    const isShowUpdateBtn =
      isNotSent ||
      isExistPurchaseOrderLineStatusIn(status, [PurchaseOrderLineStatus.DRAFT, PurchaseOrderLineStatus.REJECTED]);
    const isShowCancelBtn = isExistPurchaseOrderLineStatusIn(status, [PurchaseOrderLineStatus.REJECTED]);
    const isShowReqSplitDeliveryBtn = isExistPurchaseOrderLineStatusIn(status, [PurchaseOrderLineStatus.RECEIVED]);
    const isShowApproveReqSplitDeliveryBtn = isExistPurchaseOrderLineStatusIn(status, [
      PurchaseOrderLineStatus.REQ_SPLIT_DELIVERY,
    ]);
    const editable = isEditing(record);
    const UpdateButton = () =>
      editable ? (
        <Space size={"small"}>
          <Button
            disabled={utils.isEmpty(selectedPurchaseOrderLineId) || disabled}
            size="small"
            type={"primary"}
            onClick={() => {
              onSubmit(record.purchaseOrder);
            }}
          >
            저장
          </Button>
          <Button size="small" type={"default"} onClick={onCancel}>
            취소
          </Button>
        </Space>
      ) : (
        <Button
          disabled={!utils.isEmpty(selectedPurchaseOrderLineId) || disabled}
          size="small"
          type={"primary"}
          onClick={() => onEdit(record)}
        >
          수정
        </Button>
      );

    const DeleteButton = () => {
      const popConfirmText = `${record.productName}(${record.productSku}): 해당 제품을 삭제 하시겠습니까?`;

      return (
        <Popconfirm
          title={`${popConfirmText}`}
          onConfirm={() => onLineDelete({ id: record.purchaseOrder.id, lineId: record.id })}
          placement={"topRight"}
          disabled={disabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} danger disabled={disabled}>
            삭제
          </Button>
        </Popconfirm>
      );
    };
    const CancelButton = () => {
      const popConfirmText = `${record.productName}(${record.productSku}): 해당 제품을 발주취소 하시겠습니까?`;

      return (
        <Popconfirm
          title={`${popConfirmText}`}
          onConfirm={() =>
            onLinesCancel({
              purchaseOrderLineIds: [record.id],
            })
          }
          placement={"topRight"}
          disabled={disabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} danger disabled={disabled}>
            발주취소
          </Button>
        </Popconfirm>
      );
    };

    const SendButton = () => {
      const popConfirmText = `${record.productName}(${record.productSku}): 해당 제품을 발송(접수대기) 하시겠습니까?`;

      return (
        <Popconfirm
          title={`${popConfirmText}`}
          onConfirm={() =>
            onLinesSend({
              purchaseOrderLineIds: [record.id],
            })
          }
          placement={"topRight"}
          disabled={disabled}
          cancelText="닫기"
        >
          <Button size="small" type={"primary"} disabled={disabled}>
            발송
          </Button>
        </Popconfirm>
      );
    };

    const ReqSplitDeliveryButton = () => (
      <Button size="small" type="primary" onClick={() => onLineReqSplitDelivery(record.id)}>
        분납 요청
      </Button>
    );

    const ApproveReqSplitDeliveryButton = () => (
      <Button size="small" type={"primary"} onClick={() => onApproveReqSplitDeliveryButtonClick(record.id)}>
        요청 확인
      </Button>
    );

    return (
      <Space direction="horizontal">
        {isShowUpdateBtn && <UpdateButton />}
        {!editable && isNotSent && <DeleteButton />}
        {!editable && isShowCancelBtn && <SendButton />}
        {!editable && isShowCancelBtn && <CancelButton />}
        {!editable && isShowReqSplitDeliveryBtn && <ReqSplitDeliveryButton />}
        {!editable && isShowApproveReqSplitDeliveryBtn && <ApproveReqSplitDeliveryButton />}
      </Space>
    );
  },
});

