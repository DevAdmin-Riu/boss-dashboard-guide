        brandSearchFilter,
        brandStoreSearchFilter,
        productSearchFilter,
        creatorUserSearchFilter,
        agencyTypeFilter,
        chargeStatusFilter,
        deliveryStatusFilter,
      ];
      filters.forEach((filter, index) => {
        filter.displayOrder = index;
      });
      return filters;
    }
    case OrderType.BY_STAFF_FOR_BAD_STOCK: {
      const filters = [
        orderSearchFilter,
        paymentSearchFilter,
        productSearchFilter,
        createdFilter,
        chargeStatusFilter,
        deliveryStatusFilter,
      ];
      filters.forEach((filter, index) => {
        filter.displayOrder = index;
      });
      return filters;
    }
    default:
      return [];
  }
}
