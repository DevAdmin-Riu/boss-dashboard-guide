    return obj;
  },

  convToEnumKey: (enumValue: any, enumKeyValues: any[]) => {
    if (!enumValue || !enumKeyValues) {
      return undefined;
    }
    const enumKeyValue = enumKeyValues.find((x) => x.value === enumValue);
    if (enumKeyValue) {
      return enumKeyValue.key;
    }
    return undefined;
  },

  convToEnumKeys: (enumValueAry: any[], enumKeyValues: any[]) => {
    if (!enumValueAry || !enumKeyValues) {
      return undefined;
    }
    const enumKeys = [];
    const length = enumValueAry?.length;
    for (let i = 0; i < length; i++) {
      const enumValue = enumValueAry[i];
      const enumKeyValue = enumKeyValues.find((x) => x.value === enumValue);
      if (enumKeyValue) {
        enumKeys.push(enumKeyValue.key);
      }
    }
    return enumKeys;
  },

  convToEnumValues: (enumKeyAry: any[], enumKeyValues: any[]) => {
    if (!enumKeyAry || !enumKeyValues) {
      return undefined;
    }
    const enumValues = [];
    const length = enumKeyAry?.length;
    for (let i = 0; i < length; i++) {
      const enumKey = enumKeyAry[i];
      const enumKeyValue = enumKeyValues.find((x) => x.key === enumKey);
      if (enumKeyValue) {
        enumValues.push(enumKeyValue.value);
      }
    }
    return enumValues;
  },

  shallowEqualBoolean(object1, object2) {
    if (object1 === undefined && object2 !== undefined) {
      return false;
    }
    if (object1 !== undefined && object2 === undefined) {
      return false;
    }
    if (object1 === undefined && object2 === undefined) {
      return true;
    }

    const keys1 = Object.keys(object1);
    const keys2 = Object.keys(object2);

    if (keys1.length !== keys2.length) {
      return false;
    }

    for (const key of keys1) {
      if (utils.isTrueSet(object1[key]) !== utils.isTrueSet(object2[key])) {
        return false;
      }
    }

    return true;
  },

  shallowEqual(object1, object2) {
    if (object1 === undefined && object2 !== undefined) {
      return false;
    }
    if (object1 !== undefined && object2 === undefined) {
      return false;
    }
    if (object1 === undefined && object2 === undefined) {
      return true;
    }

    const keys1 = Object.keys(object1);
    const keys2 = Object.keys(object2);

    if (keys1.length !== keys2.length) {
      return false;
    }

    for (const key of keys1) {
      if (object1[key] !== object2[key]) {
        return false;
      }
    }

    return true;
  },

  deepEqual(object1, object2) {
    const isObject1 = utils.isObject(object1);
    const isObject2 = utils.isObject(object2);
    const checkDeepEqual = isObject1 && isObject2;

    if (checkDeepEqual === false) {
      // 300, "300" 은 같은 것으로 간주
      // eslint-disable-next-line eqeqeq
      return object1 == object2;
    }

    // "", undefined, null 은 같은 것으로 간주
    const isObjEmpty1 = utils.isEmpty(object1);
    const isObjEmpty2 = utils.isEmpty(object2);
    if (isObjEmpty1 && isObjEmpty2 === false) {
      return false;
    }
    if (isObjEmpty1 === false && isObjEmpty2) {
      return false;
    }
    if (isObjEmpty1 && isObjEmpty2) {
      return true;
    }

    const keys1 = Object.keys(object1);
    const keys2 = Object.keys(object2);

    if (keys1.length !== keys2.length) {
      return false;
    }

    for (const key of keys1) {
      const val1 = object1[key];
      const val2 = object2[key];

      if (utils.deepEqual(val1, val2) === false) {
        return false;
      }
    }

    return true;
  },

  callOpenApiValidateBizRegNo: async (
    bizRegNo,
    batchErrorMode: OpenApiBizRegNoBatchErrorMode = OpenApiBizRegNoBatchErrorMode.SIGLE_ERROR_MODE,
    errorNotiMode: OpenApiBizRegNoErrorNotiMode = OpenApiBizRegNoErrorNotiMode.NOTI_ERROR_ON_ERROR
  ): Promise<OpenApiBizRegNoReturnType> => {
    const config = {
      method: "post",
      url: PUBLIC_OPEN_API_DEF_URL,
      headers: {
        "Content-Type": PUBLIC_OPEN_API_CONTENT_TYPE,
        accept: PUBLIC_OPEN_API_CONTENT_TYPE,
      },
      data: {
        b_no: [bizRegNo.toString()],
      },
    };
    const { data: res } = await axios(config);
    const showNotification =
      errorNotiMode === OpenApiBizRegNoErrorNotiMode.NOTI_ERROR_ON_ERROR ? showNotificationError : showNotificationWarn;

    if (res.status_code === "OK") {
      const b_stt_cd = res.data[0]?.b_stt_cd;
      if (b_stt_cd === "01") {
        return OpenApiBizRegNoReturnType.OK;
      } else if (b_stt_cd === "02") {
        if (batchErrorMode === OpenApiBizRegNoBatchErrorMode.SIGLE_ERROR_MODE) {
          showNotification(`휴업 처리된 사업자번호 입니다.`);
        }
        return OpenApiBizRegNoReturnType.TEMPORARY_CLOSED;
      } else if (b_stt_cd === "03") {
        if (batchErrorMode === OpenApiBizRegNoBatchErrorMode.SIGLE_ERROR_MODE) {
          showNotification(`폐업 처리된 사업자번호 입니다.`);
        }
        return OpenApiBizRegNoReturnType.PERMANENT_CLOSED;
      } else {
        if (batchErrorMode === OpenApiBizRegNoBatchErrorMode.SIGLE_ERROR_MODE) {
          showNotification(`존재하지 않는 사업자번호 입니다.`);
        }
        return OpenApiBizRegNoReturnType.NOT_EXIST;
      }
    } else {
      // api 호출 실패 이므로 batchErrorMode 도 에러메시지 출력을 하고 다음 사업자등록증 검증을 진행하지 않는다
      showNotificationError(`사업자등록번호 검증 Open Api 호출 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.`);
      return OpenApiBizRegNoReturnType.FAIL;
    }
  },

  formattedPhoneNumber: (value) => {
    if (!value) {
      return "-";
    }
    const adjustValue = value.startsWith("+82") ? `0${value.replace("+82", "")}` : value;
    if (!adjustValue) {
      return "-";
    }

    const length = adjustValue.length;
    if (length === 9) {
      if (adjustValue.indexOf("02") === 0) {
        // 02-000-0000
        return adjustValue.replace(/(\d{2})(\d{3})(\d{4})/, "$1-$2-$3");
      } else if (adjustValue.indexOf("01") === 0) {
        const newAdjsutValue = adjustValue.substr(1, length - 1);
        //  0000-0000
        return newAdjsutValue.replace(/(\d{4})(\d{4})/, "$1-$2");
      }
      return value;
    } else if (length === 10) {
      if (adjustValue.indexOf("02") === 0) {
        // 02-0000-0000
        return adjustValue.replace(/(\d{2})(\d{4})(\d{4})/, "$1-$2-$3");
      } else {
        // 031-000-0000
        return adjustValue.replace(/(\d{3})(\d{3})(\d{4})/, "$1-$2-$3");
      }
    } else if (length === 11) {
      // 000-0000-0000
      return adjustValue.replace(/(\d{3})(\d{4})(\d{4})/, "$1-$2-$3");
    } else if (length === 12) {
      // 0000-0000-0000
      return adjustValue.replace(/(\d{4})(\d{4})(\d{4})/, "$1-$2-$3");
    }

    return value;
  },

  // 한국 전화번호를 국제 형식(+82)으로 변환
  convertPhoneToInternational: (value: string): string => {
    if (!value) {
      return value;
    }

    // 이미 +82 형식이면 그대로 반환
    if (value.startsWith("+82")) {
      return value.replace(/-/g, "");
    }

    // 하이픈 제거
    let phone = value.replace(/-/g, "");

    // 0으로 시작하면 +82로 변환
    if (phone.startsWith("0")) {
      phone = `+82${phone.substring(1)}`;
    }

    return phone;
  },

  // 국제 형식(+82)을 한국 전화번호로 변환
  convertPhoneToLocal: (value: string): string => {
    if (!value) {
      return value;
    }

    // +82 형식이면 0으로 변환
    if (value.startsWith("+82")) {
      return `0${value.substring(3)}`;
    }

    return value;
  },

  formattedNumberWithDigits: (value: string | number | null, digits: number = undefined) => {
    if (utils.isEmpty(value)) {
      return "-";
    }
    if (value === -0) {
      return 0;
    }
    try {
      if (digits) {
        return Number(value).toLocaleString(undefined, {
          minimumFractionDigits: digits,
          maximumFractionDigits: digits,
        });
      }
      return Number(value).toLocaleString();
    } catch {
      // @ts-ignore
    }
    return "-";
  },
  splitEmailList: (emailList: string): string[] => {
    if (utils.isEmpty(emailList)) {
      return [];
    }
    const splitRegExp = /[,; ]+/;
    return emailList
      .split(splitRegExp)
      .map((email) => email.trim())
      .filter((email) => email);
  },
  reverseSplitEmailList: (emailList: string[]): string => {
    if (utils.isEmpty(emailList)) {
      return "";
    }
    return emailList.join(", ");
  },
  summarizeArray: (array: string[], limit: number, itemTitle: string): string => {
    if (utils.isEmpty(array)) {
      return "-";
    }
    if (array.length <= limit) {
      return array.join(", ");
    }
    return `${array.slice(0, limit).join(", ")} 외 ${array.length - limit}개 ${itemTitle}`;
  },

  // NOTE: 테이블 구성 선택 관련 util 함수 목록
  getPickColumns: <T>(columns: DownloadableColumnsType<T>, localStoragePickColumns: string[]) => {
    const makePickerLabel = (title: ColumnTitle<T>) => (Array.isArray(title) ? title.join(" ") : title);

    // pick 컬럼 테이블 리스트 목록
    const pickColumns = columns.reduce((acc: ColumnPickerChoice[], cur, index) => {
      if ("children" in cur && Array.isArray(cur.children)) {
        // columnPickerDepth가 1로 설정된 경우 하위 children을 평탄화하지 않음
        const columnPickerDepth = (cur as any).columnPickerDepth;
        if (columnPickerDepth === 1) {
          // 1단계 그룹만 추가 (하위 컬럼은 제외)
          if (cur.isPickerHide !== true) {
            // 그룹에 key가 없으므로 생성
            const groupKey = cur.key || `group_${index}_${String(cur.title).replace(/\s/g, "_")}`;
            acc.push({
              label: makePickerLabel(cur.title),
              value: groupKey as string,
            });
          }
        } else {
          // columnPickerDepth가 없거나 1이 아닌 경우 기존대로 처리
          const child = cur.children.filter((child: DownloadableColumnType) => child.isPickerHide !== true);
          if (child.length > 0) {
            child.forEach((c) => {
              acc.push({
                label: makePickerLabel(c.title),
                value: c.key as string,
              });
            });
          }
        }
      } else {
        if (cur.isPickerHide !== true) {
          // 1단계 컬럼에 depth 정보 추가
          acc.push({
            label: makePickerLabel(cur.title),
            value: cur.key as string,
          });
        }
      }
      return acc;
    }, []);

    // 전체 컬럼 string list로 추출
    const defaultColumns: string[] = pickColumns.map((item) => item.value);
    const pickerSelectedColumns = columns.reduce((acc, cur, index) => {
      // columnPickerDepth가 1인 경우 특별 처리
      const columnPickerDepth = (cur as any).columnPickerDepth;

      // 선택된 컬럼이 존재 할 때 filtering
      if (localStoragePickColumns?.length > 0) {
        if ("children" in cur && Array.isArray(cur.children)) {
          // columnPickerDepth가 1이고 해당 그룹이 선택된 경우
          if (columnPickerDepth === 1) {
            // 그룹에 key가 없으므로 생성
            const groupKey = cur.key || `group_${index}_${String(cur.title).replace(/\s/g, "_")}`;
            if (localStoragePickColumns.includes(groupKey as string)) {
              acc.push(cur); // 그룹 전체를 추가 (하위 컬럼 포함)
            }
          } else {
            // columnPickerDepth가 1이 아닌 경우 기존 로직대로 처리
            const childList = cur.children.filter(
              (child: DownloadableColumnType) =>
                child.isPickerHide === true || localStoragePickColumns.includes(child.key as string)
            );
            if (childList.length > 0) {
              acc.push({
                title: cur.title,
                children: childList,
              });
            }
          }
        } else {
          if (cur.isPickerHide === true || localStoragePickColumns.includes(cur.key as string)) {
            acc.push(cur);
          }
        }
      } else {
        // 선택된 컬럼이 존재 하지 않으면 전체선택으로 변경
        // 해당 코드가 필요한 이유는
        // 기존 config.ts에 defaultListSettings에 설정을 일일이 하지 않음으로 인해
        // 초기값이 빈 배열인 경우 컬럼이 뜨지 않는 현상이 발생함으로 해당 코드 추가.
        if ("children" in cur && Array.isArray(cur.children) && cur.children.length > 0) {
          acc.push({
            title: cur.title,
            children: cur.children,
          });
        } else {
          acc.push(cur);
        }
      }
      return acc;
    }, []);

    // 로컬 스토리지에 선택한 컬럼 리스트가 존재하면 적용 아니면 전체 컬럼 리스트
    const initialColumns: string[] = localStoragePickColumns?.length > 0 ? localStoragePickColumns : defaultColumns;

    const createPickSummaryColumns = (keyValue, startIndex) =>
      pickerSelectedColumns.map((column) => {
        if ("children" in column && Array.isArray(column.children)) {
          return column.children.map((child) => {
            const summaryElement = child?.summaryInnerElement
              ? child.summaryInnerElement(keyValue[child.key], startIndex)
              : summaryDefaultCell(startIndex);
            startIndex++;
            return summaryElement;
          });
        } else {
          const summaryElement = column?.summaryInnerElement
            ? column.summaryInnerElement(keyValue[column.key], startIndex)
            : summaryDefaultCell(startIndex);
          startIndex++;
          return summaryElement;
        }
      });

    return {
      pickColumns,
      pickerSelectedColumns,
      initialColumns,
      createPickSummaryColumns,
    };
  },
  initListViewFilterTabs: <UrlDialog extends string, UrlQueryParams extends ActiveTab>({
    navigate,
    targetUrl,
    params,
    defaultParams = null,
    areFiltersApplied = null,
    getFilterTabs = null,
    deleteFilterTab = null,
    saveFilterTab = null,
    getActiveFilters = null,
    getFilterQueryParam = null,
    refetch = null,
    tabReset = null,
  }: {
    navigate: UseNavigatorResult;
    params: UrlQueryParams;
    defaultParams?: UrlQueryParams;
    targetUrl: (params?: UrlQueryParams) => string;
    areFiltersApplied?: (params: UrlQueryParams, defaultParams?: UrlQueryParams) => boolean;
    getFilterTabs?: () => GetFilterTabsOutput<any>;
    deleteFilterTab?: (tabIndex: number) => void;
    saveFilterTab?: (name: string, filters: Partial<UrlQueryParams>) => void;
    getActiveFilters?: (params: UrlQueryParams) => Partial<UrlQueryParams>;
    getFilterQueryParam?: (filter: IFilterElement, params: Partial<UrlQueryParams>) => Partial<UrlQueryParams>;
    refetch?: () => void;
    tabReset?: () => void;
  }) => {
    const tabs = getFilterTabs ? getFilterTabs() : [];
    const currentTab =
      params.activeTab === undefined
        ? areFiltersApplied
          ? areFiltersApplied(params, defaultParams)
            ? tabs.length + 1
            : 0
          : 0
        : parseInt(params.activeTab, 0);
    const [openModal, closeModal] = createDialogActionHandlers<UrlDialog, UrlQueryParams>(navigate, targetUrl, params);

    const handleTabChange = (tab: number) => {
      if (tabReset) {
        tabReset();
      }
      navigate(
        targetUrl({
          activeTab: tab.toString(),
          ...getFilterTabs()[tab - 1].data,
        })
      );
    };

    const handleFilterTabDelete = () => {
      deleteFilterTab(currentTab);
      navigate(targetUrl());
    };

    const handleFilterTabSave = (data: SaveFilterTabDialogFormData) => {
      saveFilterTab(data.name, getActiveFilters(params));
      handleTabChange(tabs.length + 1);
    };

    const [changeFilters, resetFilters] = createFilterHandlers({
      createUrl: targetUrl,
      getFilterQueryParam,
      navigate,
      params,
      refreshFn: refetch,
    });

    const onParamsChange = (newParams: Partial<UrlQueryParams>) => {
      const mergedParams = { ...defaultParams, ...params, ...newParams };
      navigate(targetUrl(mergedParams));
    };

    return {
      tabs,
      currentTab,
      openModal,
      closeModal,
      handleTabChange,
      handleFilterTabDelete,
      handleFilterTabSave,
      changeFilters,
      resetFilters,
      onParamsChange,
    };
  },
  initListViewSettings: ({
    params,
    listViewsName = null,
    setPaginationState = null,
  }: {
    params: Partial<any>;
    listViewsName?: ListViews;
    setPaginationState?: PaginationState;
  }) => {
    const navigate = useNavigator();
    const paginate = usePaginator();
    const { updateListSettings, settings } = useListSettings(listViewsName);
    const paginationState = setPaginationState
      ? setPaginationState
      : createPaginationState(settings?.rowNumber, params);

    return {
      navigate,
      paginate,
      updateListSettings,
      settings,
      paginationState,
    };
  },
  initListViewDownloadQuery: <TData, TVariables>(
    downloadQuery: () => UseLazyQueryResult<TData, TVariables>,
    downloadQueryVariable?: Partial<TVariables>
  ): {
    fetchForDownload: (variables?: TVariables) => Promise<ApolloQueryResult<TData>>;
  } => {
    const [triggerQuery] = downloadQuery();

    return {
      fetchForDownload: (variables?: TVariables) =>
        triggerQuery({
          variables: {
            ...(downloadQueryVariable || {}),
            ...variables,
          },
        }),
    };
  },

  initListViewPagination: ({ paginate, queryVariables = null, pageInfoPath, paginationState, params }) => {
    const queryVariablesWithoutPagination = {
      ...queryVariables,
      after: undefined,
      before: undefined,
      last: undefined,
      first: GrapheneRelayConnectionMaxLimitEnum.filterExcelDownload,
    };
    const { loadNextPage, loadPreviousPage, pageInfo } = paginate(
      maybe(() => pageInfoPath),
      paginationState,
      params
    );
    return { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo };
  },

  // filter 순서에 따라 ordering 처리
  filterDisplayOrdering: (list: any[]) => list.map((item, idx) => ({ ...item, displayOrder: idx })),

  // 우편번호 체크
  formatPostalCode: (postalCode: number | string | undefined): string => {
    if (utils.isEmpty(postalCode)) {
      return null;
    }
    return postalCode.toString().trim();
  },
  validateTemplateVersion: (sheetName: string, targetVersion: string) => {
    const sheetVersion = maybe(() => sheetName.split("-")[1], "");
    if (utils.isEmpty(sheetName, true) || utils.isEmpty(sheetVersion, true) || sheetVersion !== targetVersion) {
      showNotificationError(
        "최신 양식 버전이 아닙니다. 최신 양식을 다운 받은 후, 양식에 맞게 값 입력후 다시 시도해주세요."
      );
      return false;
    }
    return true;
  },
  formatListViewSegment: (part: string): string => part.toUpperCase().replace(/-/g, "_"),
  removeAllSpaces: (str: string): string => str.replace(/\s+/g, ""),
  generateListViewName(commonListViewName: ListViews, partList: string[]): ListViews | undefined {
    if (utils.isEmpty(commonListViewName) || utils.isEmpty(partList)) {
      return undefined;
    }
    if (partList.length === 0) {
      return commonListViewName;
    }
    const allPartList = partList.map((part) => utils.formatListViewSegment(part)).join("_");
    return `${commonListViewName}_${allPartList}` as ListViews;
  },
  fileDownload: (url: string) => {
    const link = document.createElement("a");
    const urlSplit = url.split("/");
    const fileName = urlSplit[urlSplit.length - 1];
    link.href = url;
    link.setAttribute("download", fileName);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  },

  getLabelTextByValue: (value: any, choices: Array<string | number | CheckboxOptionType | DefaultOptionType>) => {
    const choice = choices.find((c) => {
      if (typeof c === "string" || typeof c === "number") {
        return c === value;
      } else {
        return c.value === value;
      }
    });
    if (choice) {
      if (typeof choice === "string" || typeof choice === "number") {
        return choice;
      } else {
        return choice.label;
      }
    }
    return "-";
  },
  handleOnCompletedWithError: (
    errors: GqlErrorType[],
    successMsg: string | React.ReactNode,
    postAction?: () => void
  ) => {
    if (errors.length === 0) {
      if (!utils.isEmpty(successMsg)) {
        showNotificationSuccess(successMsg);
      }
      if (postAction) {
        postAction();
      }
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  },
  makeLenRegex: (digitAllowedValues = []) => {
    const parts = digitAllowedValues.map((d) => `\\d{${d}}`).join("|");
    return new RegExp(`^(?:${parts})$`);
  },
  formatNumberWithCommasRegex: (num: number | string | null | undefined, emptyString: string = "-"): string => {
    if (num === null || num === undefined) {
      return emptyString;
    }

    const numStr = String(num);

    // 소수점과 정수 부분을 분리
    const parts = numStr.split(".");
    // 정수 부분에만 콤마 추가 (음수 부호는 유지)
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    // 다시 합쳐서 반환
    return parts.join(".");
  },
  checkCountryOfOriginFind: (countryCode: string, allCountries: ShopInfo_shop_allCountries[]) => {
    if (utils.isEmpty(countryCode) || utils.isEmpty(allCountries)) {
      return false;
    }
    const country = allCountries.find((c) => c.code === countryCode.trim());
    return !utils.isEmpty(country);
  },
  getCountryOfOriginCode: (countryName: string, allCountries: ShopInfo_shop_allCountries[]) => {
    if (utils.isEmpty(countryName) || utils.isEmpty(allCountries)) {
      return "";
    }
    const country = allCountries.find((c) => c.country === countryName.trim());
    if (country && !utils.isEmpty(country.code)) {
      return country.code;
    }
    return "";
  },
  convertExcelDateToString: (value: any, formatStr: string = onlyDateFormat): any => {
    if (typeof value === "number" && isFinite(value)) {
      // 엑셀 날짜를 변환 (1900년 버그 보정을 위해 -2)
      return moment("1900-01-01")
        .add(value - 2, "days")
        .format(formatStr);
    }

    // 숫자가 아니면 원래 값을 그대로 반환
    return value;
  },
  getOptionsWithInitialValue: (
    options: ChoiceType[], // 원본 옵션 배열
    selectedId: string | null | undefined, // 현재 선택된 항목의 ID (value)
    selectedLabel: string | null | undefined // 현재 선택된 항목의 라벨 (label)
  ): ChoiceType[] => {
    // 1. 추가해야 할 선택된 값이 없으면 원본 옵션을 그대로 반환
    if (!selectedId || !selectedLabel) {
      return options;
    }

    // 2. 현재 선택된 값이 이미 옵션 목록에 있는지 확인
    const selectionExists = options.some((option) => option.value === selectedId);

    // 3. 이미 목록에 있다면, 원본 옵션을 그대로 반환
    if (selectionExists) {
      return options;
    }

    // 4. 목록에 없다면, 맨 앞에 추가하여 새로운 배열을 반환
    return [{ label: selectedLabel, value: selectedId }, ...options];
  },
  getUniqueArray: <T>(array: T[]): T[] => [...new Set(array)],
  // 성수기 기간 텍스트 생성 함수
  // 같은 월이면 "MM월 DD일 ~ DD일", 다른 월이면 "MM월 DD일 ~ MM월 DD일"
  formatPeakSeasonPeriod: (peakSeasonStartDate: string | null, peakSeasonEndDate: string | null): string => {
    if (!peakSeasonStartDate || !peakSeasonEndDate) {
      return "-";
    }

    const startDate = new Date(peakSeasonStartDate);
    const endDate = new Date(peakSeasonEndDate);

    const startMonth = startDate.getMonth() + 1;
    const startDay = startDate.getDate();
    const endMonth = endDate.getMonth() + 1;
    const endDay = endDate.getDate();

    if (startMonth === endMonth) {
      return `${startMonth}월 ${startDay}일 ~ ${endDay}일`;
    }

    return `${startMonth}월 ${startDay}일 ~ ${endMonth}월 ${endDay}일`;
  },
  truncatedText: (text: string, limit = 20) => {
    if (utils.isEmpty(text)) {
      return text;
    }
    const shortText = text.length > limit ? text.slice(0, limit) + "..." : text;
    return shortText;
  },
};
</file>

