import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { maybe } from "@utils/misc";
import { Button, Card, Checkbox, Collapse, Divider, Input, PageHeader, Space, Typography } from "antd";
import TextArea from "antd/lib/input/TextArea";
import moment from "moment";
import React from "react";

import { FromBossNotices_fromBossNotices_edges_node } from "../../../notices/api/types/FromBossNotices";
import { PopupDetails_popup } from "../../api/types/PopupDetails";
import FromBossNoticeSelectForPopup from "../FromBossNoticeSelectForPopup/FromBossNoticeSelectForPopup";
import PopupImage from "../PopupImage";
import PopupRangePicker from "../PopupRangePicker";

export interface PopupDetailsPageFormData {
  name: string;
  linkUrl: string;
  description: string;
  start: any;
  end: any;
  visibleToBrand: boolean;
  visibleToHqBrand: boolean;
  availableToAllBrands: boolean;
  updatedAt: any;
  notice: string;
}

interface PopupDetailsPageProps {
  popup: PopupDetails_popup;
  disabled: boolean;
  errors: BannerErrorFragment[];
  saveButtonBarState: ConfirmButtonTransitionState;
  onBack: () => void;
  onPcImageDelete: () => void;
  onMobileImageDelete: () => void;
  onPcImageUpload: (file: File) => void;
  onMobileImageUpload: (file: File) => void;
  onSubmit: (data: PopupDetailsPageFormData) => SubmitPromise;
  onBrandAssign: () => void;
  onBrandUnassign: (id: string, brandNameForModal: string) => void;
  onBrandUnassignBulk: (unassignList: string[]) => void;
  isHqPopup: boolean;
  fromBossNoticeList: FromBossNotices_fromBossNotices_edges_node[];
  onOpenMakeFromBossNoticeLinkModal: () => void;
  onOpenMakeCategoryLinkModal: () => void;
}

const PopupDetailsPage: React.FC<PopupDetailsPageProps> = ({
  popup,
  disabled,
  errors,
  saveButtonBarState,
  onBack,
  onPcImageDelete,
  onMobileImageDelete,
  onPcImageUpload,
  onMobileImageUpload,
  onSubmit,
  onBrandAssign,
  onBrandUnassign,
  onBrandUnassignBulk,
  onOpenMakeFromBossNoticeLinkModal,
  onOpenMakeCategoryLinkModal,
  isHqPopup,
  fromBossNoticeList,
}: PopupDetailsPageProps) => {
  const initialForm: PopupDetailsPageFormData = {
    name: maybe(() => popup.name, ""),
    linkUrl: maybe(() => popup.linkUrl, ""),
    description: maybe(() => popup.description, ""),
    start: maybe(() => popup.start, moment().format(onlyDateFormat)),
    end: maybe(() => popup.end, moment().endOf("month").format(onlyDateFormat)),
    visibleToBrand: maybe(() => popup.visibleToBrand, false),
    visibleToHqBrand: maybe(() => popup.visibleToHqBrand, false),
    availableToAllBrands: maybe(() => popup.availableToAllBrands, false),
    updatedAt: maybe(() => popup.updatedAt, ""),
    notice: maybe(() => popup.notice.id, null),
  };

  const formErrors = getFormErrors(
    ["name", "start", "end", "visibleToBrand", "visibleToHqBrand", "availableToAllBrands", "notice"],
    errors
  );

  return (
    <>
      <Form initial={initialForm} onSubmit={onSubmit} confirmLeave>
        {({ change, data, hasChanged, submit }) => (
          <>
            <AppHeader onBack={onBack}>{isHqPopup ? sectionNames.hqPopup : sectionNames.popup}</AppHeader>
            <PageHeader title={maybe(() => popup.name)} />
            <Grid>
              <Space direction="vertical" size="large">
                <Card title={<CardTitleAntd title="팝업 정보" />}>
                  <Space direction="vertical" size="large">
                    <FormFieldAntd label="팝업명">
                      <Input
                        placeholder="팝업명"
                        name="name"
                        defaultValue={data.name}
                        onChange={change}
                        status={!formErrors.name ? null : "error"}
                      />
                    </FormFieldAntd>
                    <FormFieldAntd
                      label="링크 URL"
                      description={
                        !isHqPopup && (
                          <Space direction="vertical" size={0}>
                            <Typography.Text type={"warning"}>
                              * 외부 URL의 경우에는 꼭 http로 시작하는 URL을 입력하세요.(PC의 경우 새 탭, 모바일의 경우
                              브라우저에서 열림)
                            </Typography.Text>
                            <Space>
                              <Button size="small" type="primary" onClick={onOpenMakeFromBossNoticeLinkModal}>
                                공지사항 링크
                              </Button>
                              <Button size="small" type="primary" onClick={onOpenMakeCategoryLinkModal}>
                                카테고리 링크
                              </Button>
                            </Space>
                          </Space>
                        )
                      }
                    >
                      <Input
                        placeholder="링크 URL을 입력해 주세요."
                        readOnly={isHqPopup}
                        disabled={isHqPopup}
                        name="linkUrl"
                        value={data.linkUrl}
                        defaultValue={data.linkUrl}
                        onChange={change}
                      />
                    </FormFieldAntd>
                    <FormFieldAntd label="메모">
                      <TextArea
                        rows={3}
                        name="description"
                        placeholder="메모를 입력해 주세요."
                        defaultValue={data.description}
                        onChange={change}
                      />
                    </FormFieldAntd>
                    {isHqPopup && (
                      <Collapse defaultActiveKey={["fromBossNoticeList"]} expandIconPosition="end" collapsible="header">
                        <Collapse.Panel key="fromBossNoticeList" header="공지사항 선택">
                          <FromBossNoticeSelectForPopup
                            fromBossNoticeList={fromBossNoticeList}
                            onChange={change}
                            notice={data.notice}
                          />
                        </Collapse.Panel>
                      </Collapse>
                    )}
                  </Space>
                </Card>
                <PopupImage
                  isPc={true}
                  image={maybe(() => popup.pcImage)}
                  onImageDelete={onPcImageDelete}
                  onImageUpload={onPcImageUpload}
                />
                <PopupImage
                  isPc={false}
                  image={maybe(() => popup.mobileImage)}
                  onImageDelete={onMobileImageDelete}
                  onImageUpload={onMobileImageUpload}
                />
                <AssignedBrandTable
                  disabled={disabled}
                  title={popup.name}
                  brands={popup.availableBrands}
                  originData={popup}
                  formData={data}
                  onChange={change}
                  onBrandAssign={onBrandAssign}
                  onBrandUnassign={onBrandUnassign}
                  onBrandUnassignBulk={onBrandUnassignBulk}
                />
              </Space>
              <Space direction="vertical" size="large">
                <Card title={<CardTitleAntd title="퍼블리싱" />}>
                  <Space direction="vertical" split={<Divider />}>
                    <FormFieldAntd label={<Typography style={{ marginBottom: 8 }}>팝업 게시 여부</Typography>}>
                      {isHqPopup ? (
                        <Checkbox
                          name="visibleToHqBrand"
                          checked={data.visibleToHqBrand}
                          disabled={disabled}
                          onChange={(e) => change({ target: { name: "visibleToHqBrand", value: e.target.checked } })}
                        >
                          가맹본부 게시 여부
                        </Checkbox>
                      ) : (
                        <Checkbox
                          name="visibleToBrand"
                          checked={data.visibleToBrand}
                          disabled={disabled}
                          onChange={(e) => change({ target: { name: "visibleToBrand", value: e.target.checked } })}
                        >
                          브랜드몰 게시 여부
                        </Checkbox>
                      )}
                    </FormFieldAntd>
                    <FormFieldAntd label={<Typography style={{ marginBottom: 8 }}>팝업 게시 기간</Typography>}>
                      <PopupRangePicker data={data} formErrors={formErrors} onChange={change} />
                    </FormFieldAntd>
                  </Space>
                </Card>
              </Space>
            </Grid>
            <SaveButtonBar
              disabled={disabled || !hasChanged}
              state={saveButtonBarState}
              onCancel={onBack}
              onSave={submit}
            />
          </>
        )}
      </Form>
    </>
  );
};
export default PopupDetailsPage;
</file>

