interface CustomerCreditsTableProps {
  customerName: string;
  customer: BrandAccountDetails_user;
}

const CustomerCreditsTable: React.FC<CustomerCreditsTableProps> = (props) => {
  const { customerName, customer } = props;
  const navigate = useNavigator();
  const [eventType, setEventType] = useState<PointsEventTypeEnum>(null);
  const cashableCredits = customer?.cashableCredits || 0;
  const nonCashableCredits = customer?.nonCashableCredits || 0;

  const columns = getCustomerPointsTableColumns(undefined, true);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const creditsEventList = maybe(() => customer?.creditsEvents?.edges?.map((creditsEvent) => creditsEvent.node), []);

  return (
    <>
      <Card
        title={
          <Typography.Title level={4} type="success">
            {paymentTerm.credits} 이용 내역
          </Typography.Title>
        }
        extra={
          <Space size="small" align="center">
            <Button
              shape="circle"
              type="text"
              disabled={cashableCredits === 0 && nonCashableCredits === 0}
              onClick={() => setEventType(PointsEventTypeEnum.DEDUCTION)}
            >
              <MinusCircleOutlined {...getIconProps({ size: 22 })} />
            </Button>
            <Button shape="circle" type="text" onClick={() => setEventType(PointsEventTypeEnum.RECHARGE)}>
              <PlusCircleOutlined {...getIconProps({ size: 22 })} />
            </Button>
            <Typography.Link
              strong
              onClick={() => navigate(creditsEventListViewUrl({ userSearch: customer?.loginId }))}
            >
              모든 이용 내역 보기
            </Typography.Link>
          </Space>
        }
        bodyStyle={{ padding: 0 }}
      >
        <TableVatLegend size="small" />
        <Table {...commonTableProps} columns={columns} dataSource={creditsEventList} scroll={{ x: tableWidthSum }} />
      </Card>
      <CreditsEventCreateModal
        open={eventType !== null}
        loading={false}
        eventType={eventType}
        customerName={customerName}
        customer={customer}
        onClose={() => setEventType(null)}
      />
    </>
  );
};

export default CustomerCreditsTable;
