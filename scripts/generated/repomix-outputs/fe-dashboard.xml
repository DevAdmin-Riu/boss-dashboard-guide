import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  pageContentViewPath,
  pageCreateViewPath,
  pageDetailsViewPath,
  pageListViewPath,
  PageListViewUrlQueryParams,
  PageListViewUrlSortField,
} from "./urls";
import { PageContentView } from "./views/PageContentView";
import { PageCreateView } from "./views/PageCreateView";
import { PageDetailsView } from "./views/PageDetailsView";
import { PageListView } from "./views/PageListView/PageListView";

const PageListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: PageListViewUrlQueryParams = asSortParams(qs, PageListViewUrlSortField, PageListViewUrlSortField.title);
  return <PageListView params={params} />;
};

const PageDetailsViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => (
  <PageDetailsView id={decodeURIComponent(match.params.id)} />
);

const PageContentViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => (
  <PageContentView slug={decodeURIComponent(match.params.slug)} />
);

const PageSection = () => (
  <>
    <WindowTitle title={sectionNames.pages} />
    <Switch>
      <Route exact path={pageListViewPath} component={PageListViewWrapper} />
      <Route exact path={pageCreateViewPath} component={PageCreateView} />
      <Route path={pageDetailsViewPath(":id")} component={PageDetailsViewWrapper} />
    </Switch>
  </>
);

export const PageContentSection = () => (
  <>
    <WindowTitle title={sectionNames.pages} />
    <Switch>
      <Route path={pageContentViewPath({ slug: ":slug" })} component={PageContentViewWrapper} />
    </Switch>
  </>
);

export default PageSection;
</file>

