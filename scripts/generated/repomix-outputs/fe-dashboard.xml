import axios from "axios";
import FileSaver from "file-saver";

import { destroyDownloadingMessage, showDownloadingMessage, showNotificationError } from "./notification/wrapper";
import { utils } from "./utils";
import { sendMessageToWebView, validateIsSufficientAppVersion } from "./webView";

// FileDownloadByLinkProps 수정 시, 모바일 앱에서도 동기화 필요
interface FileDownloadByLinkProps {
  link: string;
  fileName: string;
}
export const fileDownloadByLink = (props: FileDownloadByLinkProps) => {
  const { link, fileName } = props;

  if (utils.checkWebView()) {
    const requiredVersion = utils.checkWebViewIOS() ? "1.0.8" : "1.0.10";
    const isValid = validateIsSufficientAppVersion(requiredVersion);
    if (isValid === false) {
      return;
    }

    sendMessageToWebView("FILE_DOWNLOAD_BY_LINK", props);
  } else {
    showDownloadingMessage();
    axios
      .get(link, { responseType: "blob" })
      .then((response) => {
        FileSaver.saveAs(response.data as Blob, fileName);
      })
      .catch((error) => {
        console.error("다운로드 실패:", error);
        showNotificationError("다운로드에 실패했습니다. 새로고침 후 다시 시도해주세요.");
      })
      .finally(() => destroyDownloadingMessage());
  }
};
</file>

