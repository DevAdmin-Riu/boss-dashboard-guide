import { ChangeEvent, FormChange } from "@hooks/useForm";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { CategoryKindEnum, QtyPerBoxUnitTypeEnum, SalesUnitTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { FetchMoreProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Card, Col, Input, Row, Select, SelectProps, Space, Tag, Typography } from "antd";
import React, { useEffect } from "react";

import { categoryKindChoices } from "../../categories/utils";
import { ProductCreateFormData } from "./ProductCreatePage/form";
import { ProductUpdateFormData } from "./ProductUpdatePage/form";

interface ProductType {
  hasVariants: boolean;
  id: string;
  name: string;
}

export interface ProductOrganizationOptionProps {
  label: string;
  value: any;
  metadata?: any;
  disabled?: boolean;
  hasVariants?: boolean;
}

interface ProductOrganizationProps {
  isCreateMode: boolean;
  isFulfilledByVendor: boolean;
  categoryKind: CategoryKindEnum;
  categories?: ProductOrganizationOptionProps[];
  categoryInputDisplayValue: string;
  collections?: ProductOrganizationOptionProps[];
  collectionsInputDisplayValue: string[];
  data: ProductCreateFormData | ProductUpdateFormData;
  disabled: boolean;
  errors: ProductErrorFragment[];
  productType?: ProductType;
  productTypeInputDisplayValue?: string;
  productTypes?: ProductOrganizationOptionProps[];
  onCategoryKindChange?: (kind: CategoryKindEnum) => void;
  fetchCategories?: (query: string) => void;
  fetchCollections: (query: string) => void;
  fetchMoreCategories?: FetchMoreProps;
  fetchMoreCollections: FetchMoreProps;
  fetchMoreProductTypes?: FetchMoreProps;
  fetchProductTypes?: (data: string) => void;
  onCategoryChange: (event: ChangeEvent) => void;
  onCollectionChange: (event: ChangeEvent) => void;
  onProductTypeChange?: (event: ChangeEvent) => void;
  onChange?: FormChange;
  resetForm?: () => void;
}

const checkIsCreateData = (
  isCreateMode: boolean,
  data: ProductCreateFormData | ProductUpdateFormData
): data is ProductCreateFormData => isCreateMode;

export const ProductOrganization: React.FC<ProductOrganizationProps> = (props) => {
  const {
    isCreateMode,
    isFulfilledByVendor,
    categoryKind,
    categories,
    collections,
    data,
    disabled,
    errors,
    onCategoryKindChange,
    fetchCategories,
    fetchCollections,
    fetchMoreCategories,
    fetchMoreCollections,
    fetchMoreProductTypes,
    fetchProductTypes,
    productType,
    productTypes,
    onCategoryChange,
    onCollectionChange,
    onProductTypeChange,
    onChange,
    resetForm,
  } = props;
  // 현재 컬렉션은 운영되지 않는 정보 + 운영하더라도 생성 시점에는 선택하지 않을 것으로 판단되어 생성 시점에서는 UI 미노출
  const isUpdateMode = isCreateMode === false;
  const formErrors = getFormErrors(["productType", "category", "collections"], errors);

  const isB2bCategoryKind = categoryKind === CategoryKindEnum.B2B;

  const productTypeOptions: ProductOrganizationOptionProps[] = isB2bCategoryKind
    ? productTypes?.filter(
        (productType) => productType.hasVariants === false && productType.label.includes("기준 상품")
      )
    : productTypes;

  const makeProductTypeTag = () => {
    if (isCreateMode) {
      return null;
    }
    const productTypeName = maybe(() => productType.name, "-");
    const hasVariantsText = maybe(() => (productType.hasVariants ? commonMsg.configurable : commonMsg.simple), "-");
    return (
      <Tag color="green">
        {productTypeName}({hasVariantsText})
      </Tag>
    );
  };

  const cardTitle = (
    <Space>
      <Typography.Title level={4}>제품 분류</Typography.Title>
      {isFulfilledByVendor === false && makeProductTypeTag()}
    </Space>
  );

  const getCommonSelectProps = (onSearch: (data: string) => void, fetchMoreData: FetchMoreProps): SelectProps => ({
    showSearch: true,
    style: { width: "100%" },
    size: "large",
    disabled,
    loading: fetchMoreData.loading,
    filterOption: (input, option) =>
      typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase()),
    onSearch,
    onDropdownVisibleChange: (open) => {
      if (open) {
        onSearch("");
      }
    },
    onPopupScroll: ({ currentTarget }) => {
      const { scrollHeight, scrollTop, clientHeight } = currentTarget;
      const { hasMore, loading, onFetchMore } = fetchMoreData;
      // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
      if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
        onFetchMore();
      }
    },
  });

  const categoryOptions = utils.getOptionsWithInitialValue(categories, data.category, data.categoryLabel);

  // 직거래 상품인 경우 제품 타입이 1개만 존재하게 되며
  // 제품 타입을 설정 못하게 처리하고 default로 0번째 제품 타입을 설정.
  useEffect(() => {
    if (isCreateMode && isFulfilledByVendor && productTypes.length > 0) {
      onProductTypeChange({ target: { name: "productType", value: productTypes[0].value } });
    }
  }, [productTypes]);

  useEffect(() => {
    if (utils.isEmpty(onChange) || utils.isEmpty(resetForm)) {
      return;
    }
    // 우선 초기화 후, 각 카테고리 분류에 따라 지정이 필요한 값만 추가로 설정
    resetForm();

    const isB2bCategoryKind = categoryKind === CategoryKindEnum.B2B;
    const isDevCategoryKind = categoryKind === CategoryKindEnum.DEV;
    onChange({
      target: { name: "defaultPvvIncludePurchaseB2bDeliveryFee", value: isB2bCategoryKind || isDevCategoryKind },
    });

    switch (categoryKind) {
      case CategoryKindEnum.DEV:
        onChange({ target: { name: "isDevPv", value: true } });

        onChange({ target: { name: "isTaxFree", value: false } });
        onChange({ target: { name: "isExclusive", value: true } });
        onChange({ target: { name: "trackInventory", value: false } });
        onChange({ target: { name: "canSaleByInner", value: false } });
        break;
      case CategoryKindEnum.CREDITS_REFILL:
        onChange({ target: { name: "isForCreditsRefill", value: true } });

        onChange({ target: { name: "boxLength", value: 1 } });
        onChange({ target: { name: "boxWidth", value: 1 } });
        onChange({ target: { name: "boxHeight", value: 1 } });
        onChange({ target: { name: "qtyPerBox", value: 1 } });
        onChange({ target: { name: "qtyPerBoxUnitType", value: QtyPerBoxUnitTypeEnum.EA } });
        onChange({ target: { name: "salesUnitType", value: SalesUnitTypeEnum.PIECE } });
        break;
      case CategoryKindEnum.B2B:
        onChange({ target: { name: "uoq", value: 1 } });
        onChange({ target: { name: "isExclusive", value: true } });
        onChange({ target: { name: "trackInventory", value: false } });
        onChange({ target: { name: "canSaleByInner", value: false } });
        if (
          checkIsCreateData(isCreateMode, data) &&
          productTypeOptions?.some((option) => option.value === data.productType?.id) === false
        ) {
          onProductTypeChange({ target: { name: "productType", value: null } });
        }
        break;
    }
  }, [categoryKind]);

  const makeCategoryKindDescription = () => {
    let description: string;
    switch (categoryKind) {
      case CategoryKindEnum.STANDARD:
        description = "*포장보스에서 판매하는 일반 제품";
        break;
      case CategoryKindEnum.B2B:
        description = "*B2B 고객사에게만 판매하는 제품";
        break;
      case CategoryKindEnum.DEV:
        description = "*전용 제품 및 B2B 제품에 연동되는 개발비에 해당하는 제품";
        break;
      case CategoryKindEnum.CREDITS_REFILL:
        description = "*매출인식 브랜드의 충전금을 결제하기 위한 가상의 제품";
        break;
      default:
        return null;
    }
    const suffix = isCreateMode ? "을 생성합니다." : "입니다.";
    return description + suffix;
  };

  return (
    <Card title={cardTitle}>
      <Row gutter={[12, 12]} align="top" justify="start">
        {checkIsCreateData(isCreateMode, data) && (
          <Col xs={24} sm={8}>
            <FormFieldAntd
              isRequired
              label="제품 타입"
              error={formErrors.productType}
              errorMsg={makeGqlErrorMsg(formErrors.productType)}
            >
              <Select
                {...getCommonSelectProps(fetchProductTypes, fetchMoreProductTypes)}
                autoFocus={true}
                status={!!formErrors.productType ? "error" : ""}
                placeholder="제품 타입을 선택해 주세요."
                onChange={(value) => onProductTypeChange({ target: { name: "productType", value } })}
                options={productTypeOptions}
                value={data.productType?.id}
                disabled={isFulfilledByVendor}
              />
            </FormFieldAntd>
          </Col>
        )}
        <Col xs={24} sm={8}>
          <FormFieldAntd
            isRequired
            label="카테고리"
            error={formErrors.category}
            errorMsg={makeGqlErrorMsg(formErrors.category)}
            description={makeCategoryKindDescription()}
          >
            <Input.Group compact>
              <Select
                size="large"
                style={{ width: 120 }}
                onChange={onCategoryKindChange}
                options={categoryKindChoices.map((choice) => {
                  const disabled = isFulfilledByVendor ? choice.value !== CategoryKindEnum.STANDARD : false;
                  return { ...choice, disabled };
                })}
                placeholder={columnNameConstant.category.KIND}
                value={categoryKind}
                disabled={isUpdateMode}
              />
              <Select
                {...(isCreateMode && getCommonSelectProps(fetchCategories, fetchMoreCategories))}
                showSearch={true}
                style={{ width: "calc(100% - 120px)" }}
                size="large"
                status={!!formErrors.category ? "error" : ""}
                placeholder="카테고리를 선택해 주세요."
                onChange={(value) => onCategoryChange({ target: { name: "category", value } })}
                options={categoryOptions}
                defaultActiveFirstOption={false}
                filterOption={false}
                value={data.category}
                disabled={utils.isEmpty(categoryKind) || isUpdateMode}
                dropdownMatchSelectWidth={false}
              />
            </Input.Group>
          </FormFieldAntd>
        </Col>
        {data.isForCreditsRefill === false && isFulfilledByVendor === false && isUpdateMode && (
          <Col xs={24} sm={8}>
            <FormFieldAntd
              label="컬렉션"
              description="*선택사항. 컬렉션을 통해 테마관을 구성하는 등으로 활용할 수 있습니다."
              error={formErrors.collections}
              errorMsg={makeGqlErrorMsg(formErrors.collections)}
            >
              <Select
                {...getCommonSelectProps(fetchCollections, fetchMoreCollections)}
                mode="multiple"
                status={!!formErrors.collections ? "error" : ""}
                placeholder="컬렉션"
                onChange={(value) => onCollectionChange({ target: { name: "collections", value } })}
                options={collections}
                value={data.collections}
              />
            </FormFieldAntd>
          </Col>
        )}
      </Row>
    </Card>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductPoNote.tsx">
import { getFormErrors } from "@assets/messages/errors";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { Card, Input, Typography } from "antd";
import React from "react";

export interface ProductPoNoteFormData {
  poNote: string;
}

export interface ProductNoteProps {
  data: ProductPoNoteFormData;
  errors: ProductErrorFragment[];
  onChange: (event: React.ChangeEvent<any>) => void;
}

export const ProductPoNote: React.FC<ProductNoteProps> = (props) => {
  const { data, errors, onChange } = props;

  const formErrors = getFormErrors(["poNote"], errors);

  return (
    <Card title={<CardTitleAntd title={"발주 메모"} />}>
      <Input.TextArea
        rows={6}
        status={!!formErrors.poNote && "error"}
        name="poNote"
        placeholder="제품 발주 시 협력사에게 전달할 필요가 있는 메모를 입력해주세요."
        value={data?.poNote ? data?.poNote : ""}
        onChange={onChange}
      />
      {!!formErrors.poNote && <Typography.Text type={"danger"}>{makeGqlErrorMsg(formErrors.poNote)}</Typography.Text>}
    </Card>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductStocks.tsx">
import { FetchResult } from "@apollo/client";
import { FormChange } from "@hooks/useForm";
import { WarehouseFragment } from "@src/api/fragments/types/WarehouseFragment";
import {
  ExtendedProductUpdateAdditionalInput,
  ProductToBeChangedInfoCreateInput,
  ProductVariantInput,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
  StockInput,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { FieldPath } from "@src/app/components/antd/types/GenericFieldPath";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import EditableField from "@src/app/components/EditableField/EditableField";
import Link from "@src/app/components/Link";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import {
  ProductDetails_product_outerVariants,
  ProductDetails_product_outerVariants_stocks,
} from "@src/app/views/product/products/api/types/ProductDetails";
import { transformIsInner } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Form, Space, Table, Typography } from "antd";
import { ColumnsType, ColumnType } from "antd/lib/table";
import React, { useEffect, useState } from "react";

import { makeStockQtyAdjustButtons } from "../../stock/components/StockListPage/StockListTableSettings";
import { stockStatusRender } from "../../stock/utils";
import { StockListModalModeEnum } from "../../stock/views/StockListView/StockListView";
import { ExtendedProductUpdate } from "../api/types/ExtendedProductUpdate";
import { ProductVariantDetails_productVariant } from "../api/types/ProductVariantDetails";
import { productVariantManageEventTypeChoices, stockShortageStatusChoices } from "../utils/data";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "./PvOrBpvManageEventModal";

interface ProductStockDataSourceType extends StockInput {
  id: string;
  // 재고 내역 조회를 위해 각 로우마다 variantId를 저장
  variantId: string;
  sku: string;
  isInner: boolean;
  quantity?: number;
  // 제품 수정 페이지에서 기타 입고 / 로스 처리 등을 위해 생성된 stock id 저장(생성 시에는 빈 값)
  stockId?: string;
}

interface ProductStocksFormData {
  canSaleByInner: boolean;
  stocks: StockInput[];
  innerStocks: StockInput[];
  originStocks?: ProductDetails_product_outerVariants_stocks[] | null;
}

interface ProductStocksProps {
  data: ProductStocksFormData;
  productVariant?: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  disabled: boolean;
  warehouses: WarehouseFragment[];
  onChange: FormChange;
  onWarehouseConfigure: () => void;
  openModalWithoutNavigate?: (modalMode: StockListModalModeEnum, stockId?: string) => void;
  isFulfilledByVendor: boolean;
  onVariantUpdate?: (
    variantId: string,
    productVariantInput: ProductVariantInput,
    additionalInput: ExtendedProductUpdateAdditionalInput,
    productToBeChangedInfoCreateInput: ProductToBeChangedInfoCreateInput
  ) => Promise<FetchResult<ExtendedProductUpdate>>;
}

export type TPvBaseStockStatusFormData = Pick<ProductVariantInput, "stockStatusByDaily" | "innerStockStatusByDaily">;

// NOTE: productVariant 단위로 노출되는 재고 정보(비옵션형 제품 상세 또는 옵션 상세 페이지에 노출)
export const ProductStocks: React.FC<ProductStocksProps> = ({
  data,
  productVariant,
  disabled,
  warehouses,
  onChange,
  onWarehouseConfigure,
  openModalWithoutNavigate,
  isFulfilledByVendor,
  onVariantUpdate,
}) => {
  const isUpdateMode =
    utils.isEmpty(productVariant) === false &&
    utils.isEmpty(openModalWithoutNavigate) === false &&
    utils.isEmpty(onVariantUpdate) === false;
  const { canSaleByInner, stocks, innerStocks, originStocks } = data;
  const [dataSource, setDataSource] = useState<ProductStockDataSourceType[]>([]);
  const [form] = Form.useForm<TPvBaseStockStatusFormData>();
  const TypeSafeForm = getTypeSafeForm<TPvBaseStockStatusFormData>(form);
  const [manageEventModalOpen, setManageEventModalOpen] = useState<boolean>(false);
  const [isEditMode, setIsEditMode] = useState(false);

  const onEdit = () => {
    setIsEditMode(true);
  };
  const onEditCancel = () => {
    form.resetFields();
    setIsEditMode(false);
  };

  const innerVariant = productVariant?.inner;

  const initialValues: TPvBaseStockStatusFormData = {
    stockStatusByDaily: productVariant?.estShortageInfo?.stockStatusByDaily,
    innerStockStatusByDaily: innerVariant?.estShortageInfo?.stockStatusByDaily,
  };

  const onSubmit = ({ manageEvent }: ProductVariantManageEventModalForm) => {
    const formData = form.getFieldsValue();
    const additionalInput: ExtendedProductUpdateAdditionalInput = {
      manageEvent: manageEvent as ProductVariantManageEventInput,
    };
    onVariantUpdate(productVariant.id, formData, additionalInput, undefined).then((res) => {
      const errors = res?.data?.extendedProductUpdate?.errors;
      if (errors?.length === 0) {
        onEditCancel();
        setManageEventModalOpen(false);
      }
    });
  };

  const makeRowsByStocks = (stocks: StockInput[], isInner: boolean): ProductStockDataSourceType[] => {
    const targetVariant = isInner ? productVariant?.inner : productVariant;
    const stockRow = stocks.map((stock) => {
      const targetVariantStock = targetVariant?.stocks.find(
        (productStock) => productStock.warehouse.id === stock.warehouse
      );
      return {
        ...stock,
        isInner,
        id: `${stock.warehouse}_${isInner ? "inner" : "outer"}`,
        variantId: targetVariant?.id,
        sku: targetVariant?.sku || "-",
        quantity: targetVariantStock?.quantity,
        stockId: targetVariantStock?.id,
      };
    });
    return stockRow;
  };

  useEffect(() => {
    if (disabled === false && isFulfilledByVendor === false) {
      const firstWarehouse = warehouses.length > 0 ? warehouses[0] : null;
      // 아우터박스에 연동된 재고가 없을 경우, 기본 물류창고로 재고 등록
      if ((utils.isEmpty(stocks) || stocks.length === 0) && firstWarehouse) {
        const stock: StockInput = { warehouse: firstWarehouse.id };
        onChange({ target: { name: "stocks", value: [stock] } });
      }
      // 이너박스가 존재하는 경우에 한해 이너박스에 연동된 재고가 없을 경우, 기본 물류창고로 재고 등록
      if ((utils.isEmpty(innerStocks) || innerStocks.length === 0) && firstWarehouse) {
        const stock: StockInput = { warehouse: firstWarehouse.id };
        onChange({ target: { name: "innerStocks", value: [stock] } });
      }
    }
    const outerStockDataSource = makeRowsByStocks(stocks, false);
    const innerStockDataSource = canSaleByInner ? makeRowsByStocks(innerStocks, true) : [];
    const newDataSource = [...outerStockDataSource, ...innerStockDataSource];
    setDataSource(newDataSource);
  }, [stocks, innerStocks, originStocks, canSaleByInner, warehouses, productVariant]);

  const skuColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.product.SKU,
    key: "sku",
    align: "center",
    width: 120,
    render: (_, record) => record.sku,
  };
  const isInnerColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.product.IS_INNER,
    key: "isInner",
    align: "center",
    width: 100,
    render: (_, record) => transformIsInner(record.isInner),
  };
  const safetyStockStatusColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.stock.SAFETY_STOCK_STATUS,
    key: "safetyStockStatus",
    align: "center",
    width: 150,
    render: (_, record) =>
      stockStatusRender(productVariant, record.isInner, false, { direction: "horizontal", size: "small" }),
  };
  const stockShortageStatusColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.stock.STOCK_SHORTAGE_STATUS,
    key: "stockShortageStatus",
    width: 200,
    render: (_, record) => {
      // 아우터 pv: 위탁이면 악성재고 상태 non Editable
      // 이너 pv: 아우터가 재고 운영 이거나 이너 운영 안하면 non Editable
      const isNa = record.isInner ? innerVariant.estShortageInfo?.isNa : productVariant.estShortageInfo?.isNa;
      if (isNa) {
        return "-";
      }

      const fieldName: FieldPath<TPvBaseStockStatusFormData> = record.isInner
        ? "innerStockStatusByDaily"
        : "stockStatusByDaily";

      return (
        <EditableField
          type="select"
          options={stockShortageStatusChoices}
          name={fieldName}
          value={TypeSafeForm.getFieldValue(fieldName)}
          editMode={isEditMode}
        />
      );
    },
  };
  const quantityColumn: ColumnType<ProductStockDataSourceType> = {
    title: "재고",
    key: "quantity",
    align: "center",
    width: 140,
    render: (_, record) => {
      const targetVariant = record.isInner ? productVariant?.inner : productVariant;
      return makeStockQtyAdjustButtons(
        { ...targetVariant, isSubPv: productVariant.isSubPv },
        record.warehouse,
        openModalWithoutNavigate,
        isFulfilledByVendor
      );
    },
  };
  const stockDetailEventColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.stock.VIEW_DETAILS,
    key: "stockDetailEvent",
    align: "center",
    width: 100,
    render: (_, record) => (
      <Button
        disabled={disabled}
        style={{ width: 120 }}
        type="primary"
        onClick={() => openModalWithoutNavigate(StockListModalModeEnum.StockDetailEventList, record.variantId)}
      >
        상세 재고 내역
      </Button>
    ),
  };
  const locationColumn: ColumnType<ProductStockDataSourceType> = {
    title: columnNameConstant.stock.LOCATION,
    key: "location",
    align: "center",
    width: 200,
    render: (_, record) => (
      <Button
        type="primary"
        onClick={() => openModalWithoutNavigate(StockListModalModeEnum.RackStockList, record.variantId)}
      >
        로케이션 확인
      </Button>
    ),
  };

  const columns: ColumnsType<ProductStockDataSourceType> = [
    isUpdateMode && skuColumn,
    isFulfilledByVendor === false && isInnerColumn,
    isUpdateMode && isFulfilledByVendor === false && safetyStockStatusColumn,
    isUpdateMode && isFulfilledByVendor === false && stockShortageStatusColumn,
    isUpdateMode && quantityColumn,
    isUpdateMode && stockDetailEventColumn,
    isUpdateMode && isFulfilledByVendor === false && locationColumn,
  ].filter(Boolean);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const emptyText = utils.isEmpty(warehouses?.length) ? (
    <Space direction="vertical" size={0}>
      <Typography.Text type="secondary">
        물류센터가 등록되어 있지 않습니다. 재고를 등록하려면 물류센터가 등록되어야 합니다.
      </Typography.Text>
      <Link onClick={onWarehouseConfigure}>물류센터 등록하러가기</Link>
    </Space>
  ) : (
    <Typography.Text type="secondary">연동된 물류센터가 없습니다.</Typography.Text>
  );

  return (
    <Form
      name="base-selling-price-update"
      form={form}
      disabled={disabled}
      initialValues={initialValues}
      component={false}
      onFinish={() => setManageEventModalOpen(true)}
    >
      <Card
        title={<CardTitleAntd title="재고" />}
        extra={
          isUpdateMode && <FormSaveButton form={form} isEditMode={isEditMode} onEdit={onEdit} onCancel={onEditCancel} />
        }
        bodyStyle={{ padding: 0 }}
      >
        <Table
          {...commonTableProps}
          loading={disabled}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum }}
          locale={{ emptyText }}
        />
      </Card>
      {isUpdateMode && (
        <ProductVariantManageEventModal
          isCreateMode
          open={manageEventModalOpen}
          loading={disabled}
          manageEventType={ProductVariantManageEventTypeEnum.TYPE_STATUS}
          choices={productVariantManageEventTypeChoices}
          onSubmit={onSubmit}
          onCancel={() => setManageEventModalOpen(false)}
        />
      )}
    </Form>
  );
};
</file>

