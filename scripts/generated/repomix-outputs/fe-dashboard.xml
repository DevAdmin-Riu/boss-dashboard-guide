}

export interface PluginListFilterOpts {
  search: FilterOpts<string>;
  isActive: FilterOpts<boolean>;
}

export function createFilterStructure(opts: PluginListFilterOpts): IFilter<PluginFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createTextField(displayOrder++, PluginFilterKeys.search, "이름 / 설명", opts.search.value),
      active: opts.search.active,
    },
    {
      ...createBooleanField(displayOrder++, PluginFilterKeys.active, commonMsg.status, opts.isActive.value, {
        negative: filterMsg.deactivated,
        positive: filterMsg.active,
      }),
      active: opts.isActive.active,
    },
  ];
}
