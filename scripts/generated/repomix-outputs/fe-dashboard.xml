import { User_brand } from "@src/api/fragments/types/User";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { BrandProductStats_brandProductStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandProductStats";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  checkIsEnableForFbvServiceByBrand,
  transformIsExclusive,
  transformIsFBVForHq,
  transformIsInner,
  transformSalesStatusByBrandProductVariant,
  transformSalesStatusByProductVariant,
} from "@utils/misc";
import { utils } from "@utils/utils";
import { ColumnsType } from "antd/lib/table";
import React from "react";

export function getHqStatsProductTableSettings(brand: User_brand) {
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);
  const productColumns: ColumnsType<BrandProductStats_brandProductStats> = [];
  const fixedFlag = utils.fixedLeftFlag();

  productColumns.push({
    title: columnNameConstant.brandProduct.BP_SKU,
    align: "center",
    key: "bpSku",
    width: 140,
    render: (_, record) => record.bpSku ?? "-",
  });
  productColumns.push({
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    align: "center",
    key: "brandProductName",
    width: 150,
    render: (_, record) => (record.productInfo?.brandProductName ? record.productInfo?.brandProductName : "-"),
  });
  productColumns.push({
    title: columnNameConstant.product.VARIANT_NAME,
    align: "center",
    key: "variantName",
    width: 100,
    render: (_, record) => (record.productInfo?.variantName ? record.productInfo?.variantName : "-"),
  });
  productColumns.push({
    title: columnNameConstant.product.IS_INNER,
    key: "isInner",
    align: "center",
    width: 100,
    render: (_, record) => (record.bpBundleSalesStatus !== null ? "-" : transformIsInner(record.isInner)),
  });
  if (enableForFbvService) {
    productColumns.push({
      title: columnNameConstant.brand.IS_FBV_PRODUCT,
      key: "isFulfilledByVendor",
      align: "center",
      width: 120,
      render: (_, record) =>
        record.bpBundleSalesStatus !== null ? "-" : transformIsFBVForHq(record.isFulfilledByVendor),
    });
  }
  productColumns.push({
    title: columnNameConstant.brand.IS_EXCLUSIVE,
    key: "isExclusive",
    align: "center",
    width: 80,
    render: (_, record) => transformIsExclusive(record.isExclusive),
  });
  productColumns.push({
    title: columnNameConstant.product.SALES_STATUS,
    key: "salesStatusByProductVariant",
    align: "center",
    width: 80,
    render: (_, record) =>
      record.bpBundleSalesStatus !== null ? "-" : transformSalesStatusByProductVariant(record.variantSalesStatus),
  });
  productColumns.push({
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "salesStatusByBrandProductVariant",
    align: "center",
    width: 80,
    render: (_, record) => {
      // 세트상품인 경우 bpBundleSalesStatus 사용, 아닌 경우 bpvSalesStatus 사용
      const salesStatus = record.bpBundleSalesStatus ?? record.bpvSalesStatus;
      return transformSalesStatusByBrandProductVariant(salesStatus);
    },
  });
  productColumns.push({
    title: columnNameConstant.performance.CONTRACT_COST_PRICE,
    align: "right",
    key: "unitBrandPriceExcludeVat",
    width: 100,
    render: (_, record) => (
      <NumberComponent
        value={
          toPriceExcludeVat(record.statBrandUnitCostPrice, record.isTaxFree) +
          toPriceExcludeVat(record.statBrandUnitDeliveryFee)
        }
      />
    ),
  });
  productColumns.push({
    title: columnNameConstant.brandProduct.BRAND_STORE_SALE_PRICE,
    align: "right",
    key: "unitPriceExcludeVat",
    width: 100,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.statUnitPrice, record.isTaxFree)} />,
  });

  const saleColumns: ColumnsType<BrandProductStats_brandProductStats> = [];
  saleColumns.push({
    title: columnNameConstant.common.SALES_QTY,
    align: "center",
    key: "statQuantity",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statQuantity} />,
  });
  saleColumns.push({
    title: columnNameConstant.performance.SALES_TOTAL,
    align: "right",
    key: "statTotalPriceExcludeVat",
    width: 100,
    render: (_, record) => <NumberComponent value={record.statTotalPriceExcludeVat} />,
  });

  const columns: ColumnsType<BrandProductStats_brandProductStats> = [
    { title: "순위", key: "rank", align: "center", width: 50, fixed: fixedFlag, render: (_, __, index) => index + 1 },
    {
      title: "상품정보",
      key: "productInfo",
      children: productColumns,
    },
    {
      title: "판매 현황",
      key: "saleInfo",
      children: saleColumns,
    },
  ];
  return columns;
}
