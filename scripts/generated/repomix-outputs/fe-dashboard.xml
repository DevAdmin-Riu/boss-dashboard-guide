type BsOpsCheckReportTab = "summary" | "details" | "consultation" | "recheck";

interface BsOpsCheckReportDetailsPageProps {
  user: User;
  report: BsOpsCheckReportDetails_bsOpsCheckReport;
  summary: BsOpsCheckReportSummary_bsOpsCheckReportSummary;
  onRecheckRequest: (reportItem: BsOpsCheckReportDetails_bsOpsCheckReport_items) => void;
  onStatusUpdate: (variables: BsOpsRecheckReportItemStatusUpdateVariables) => Promise<boolean>;
  onBack: () => void;
}

export const BsOpsCheckReportDetailsPage: React.FC<BsOpsCheckReportDetailsPageProps> = (props) => {
  const { user, report, summary, onRecheckRequest, onStatusUpdate, onBack } = props;
  const isStaff = user.isStaff;
  const [activeTab, setActiveTab] = useState<BsOpsCheckReportTab>("summary");

  const makePageTitle = () => report.title;
  const makePageSubTitle = () => {
    const createdText = `${columnNameConstant.common.REGISTERED_DATE}: ${getDateByFormat(
      report.createdAt,
      onlyDateFormat
    )}`;
    const hqStaffBrandStores = report.brandStore.hqStaffBrandStores || [];
    const mainHqStaff = hqStaffBrandStores.find((s) => s.role === HqStaffBrandStoreRole.MAIN);
    const subHqStaff = hqStaffBrandStores.find((s) => s.role === HqStaffBrandStoreRole.SUB);
    const mainHqStaffText = `(주)${mainHqStaff?.user.firstName || "-"} / (부)${subHqStaff?.user.firstName || "-"}`;
    const hqStaffText = `${columnNameConstant.common.PERSON_IN_CHARGE}: ${mainHqStaffText}`;
    return [createdText, hqStaffText].join(" | ");
  };
  const makePageTitleTags = () => {
    const tagColor = report.isSubmitted ? "success" : "error";
    const tagText = transformIsSubmitted(report.isSubmitted);
    const submittedAtText = report.isSubmitted ? `(${getDateByFormat(report.submittedAt, onlyDateFormat)})` : "";
    const isSubmittedTag = (
      <Tag key="isSubmitted" color={tagColor}>
        {tagText}
        {submittedAtText}
      </Tag>
    );
    if (isStaff) {
      const brandNameTag = <Tag key="brandName">{report.brandStore.brand.name}</Tag>;
      return [isSubmittedTag, brandNameTag];
    }
    return [isSubmittedTag];
  };

  const segmentOptions: Array<{ label: string; value: BsOpsCheckReportTab }> = [
    { label: "요약", value: "summary" },
    { label: "상세점검", value: "details" },
    { label: "재점검 요청", value: "recheck" },
    { label: "상담일지", value: "consultation" },
  ];

  return (
    <Space direction="vertical" size="large">
      <AppHeader onBack={onBack}>{sectionNames.bsOpsCheckReportList}</AppHeader>
      <PageHeader title={makePageTitle()} subTitle={makePageSubTitle()} tags={makePageTitleTags()} />

      <Space direction="vertical">
        <Segmented
          options={segmentOptions}
          value={activeTab}
          onChange={(value) => setActiveTab(value as BsOpsCheckReportTab)}
        />
        <div>
          <div style={{ display: activeTab === "summary" ? "block" : "none" }}>
            <BsOpsCheckReportSummaryInfo summary={summary} />
          </div>
          <div style={{ display: activeTab === "details" ? "block" : "none" }}>
            <BsOpsCheckReportDetailsInfo report={report} onRecheckRequest={onRecheckRequest} />
          </div>
          <div style={{ display: activeTab === "recheck" ? "block" : "none" }}>
            <BsOpsRecheckReportItemList report={report} onStatusUpdate={onStatusUpdate} />
          </div>
          <div style={{ display: activeTab === "consultation" ? "block" : "none" }}>
            <BsOpsCheckReportConsultationInfo report={report} />
          </div>
        </div>
      </Space>
    </Space>
  );
};
