<file path="src/app/views/order/orders/components/RefundInfoTable/RefundInfoTable.tsx">
import { RefundQAQReasonType, RefundQAStatus } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { transformRefundReason } from "@src/app/views/question/components/CustomerRefundQuestionInspectTable/utils";
import { Descriptions, Tag } from "antd";
import React from "react";

import { OrderDetails_order } from "../../api/types/OrderDetails";
import { ROUND_TRIP_DELIVERY_FEE_PER_ITEM } from "../OrderRefundCreateModal/OrderRefundCreateModal";

interface RefundInfoTableProps {
  order: OrderDetails_order;
}

const RefundInfoTable: React.FC<RefundInfoTableProps> = (props) => {
  const { order } = props;
  const shop = useShop();
  const refundReasonChoices = { ...shop.refundReasonChoices };

  const filterRefundCustomerQuestion = order.refundQA.filter((item) => item.status === RefundQAStatus.REFUND_PENDING);

  if (filterRefundCustomerQuestion.length === 0) {
    return <></>;
  }

  const nowRefundCustomerQuestion = filterRefundCustomerQuestion[0];
  const refundQAId = atob(nowRefundCustomerQuestion.id).split(":")[1];
  const qReasonType = transformRefundReason(refundReasonChoices, nowRefundCustomerQuestion?.qReasonType);
  const qReasonText = nowRefundCustomerQuestion?.qReasonText ? nowRefundCustomerQuestion.qReasonText : "-";
  const qReasonTypeReturnFeeCheck =
    nowRefundCustomerQuestion?.qReasonType === RefundQAQReasonType.PRODUCT_DIFFERENT_ORDER ||
    nowRefundCustomerQuestion?.qReasonType === RefundQAQReasonType.SIMPLE_REMORSE;
  const qCreatedAt = nowRefundCustomerQuestion?.qCreatedAt;

  const inspectList = nowRefundCustomerQuestion?.inspectList;
  const customInspectList = inspectList.map((item) => {
    const findFulfillment = order.fulfillments.filter((filterItem) => filterItem.id === item.fulfillment.id);
    return {
      ...item,
      uniqueNumber: findFulfillment[0].composedIdWithPrefix,
    };
  });

  const qOrderLineInfo = JSON.parse(nowRefundCustomerQuestion.qOrderLineInfo);
  const qOrderLineInfos = qOrderLineInfo.map((item) => {
    const findOrderLineDetail = order.lines.filter((filterItem) => filterItem.id === item.order_line_id);
    return {
      ...item,
      productName: findOrderLineDetail[0].productName,
    };
  });

  // 실제 반품 수량 합계로 예상 반품비 계산
  const totalRefundQty = qOrderLineInfos
    .filter((item: { quantity: number }) => parseInt(item.quantity.toString(), 10) > 0)
    .reduce((sum: number, item: { quantity: number }) => sum + parseInt(item.quantity.toString(), 10), 0);

  const returnFee = qReasonTypeReturnFeeCheck ? totalRefundQty * ROUND_TRIP_DELIVERY_FEE_PER_ITEM : 0;

  return (
    <>
      <Descriptions
        bordered
        column={2}
        size="small"
        style={{ marginTop: 15 }}
        extra={<TableVatLegend isIncludeVat={true} />}
      >
        <Descriptions.Item label="문의 번호">{refundQAId}</Descriptions.Item>
        <Descriptions.Item label="문의 구분">{qReasonType}</Descriptions.Item>
        <Descriptions.Item label="문의 내용">{qReasonText}</Descriptions.Item>
        <Descriptions.Item label="문의한 시간">{getDateByFormat(qCreatedAt)}</Descriptions.Item>
        <Descriptions.Item label="반품 수량">
          {qOrderLineInfos
            .filter((item) => parseInt(item.quantity.toString(), 10) > 0)
            .map((item) => (
              <div key={item.order_line_id}>
                {item.productName} - {item.quantity}개
                <br />
              </div>
            ))}
        </Descriptions.Item>
        <Descriptions.Item label="예상 반품비">
          <NumberComponent value={returnFee} />
        </Descriptions.Item>
        <Descriptions.Item label="검수 정보" span={2}>
          {customInspectList.map((item) => (
            <span key={item.uniqueNumber} style={{ margin: "5px 15px 5px 0", display: "inline-block" }}>
              {item.uniqueNumber}
              <Tag color={item.inspect ? "green" : "red"}>{item.inspect ? "검수 완료" : "검수 불량"}</Tag>
            </span>
          ))}
        </Descriptions.Item>
      </Descriptions>
    </>
  );
};

export default RefundInfoTable;
</file>

