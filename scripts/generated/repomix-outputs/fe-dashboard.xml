    woodUnitDevCostExcludeVat: formData.woodUnitDevCostExcludeVat || 0,
    woodQtyForDevCost: formData.woodQtyForDevCost || 0,
    metalUnitDevCostExcludeVat: formData.metalUnitDevCostExcludeVat || 0,
