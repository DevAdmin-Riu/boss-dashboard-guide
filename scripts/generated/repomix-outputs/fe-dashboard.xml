<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderAddress.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { PurchaseOrderCreateInput, PurchaseOrderUpdateInput } from "@src/api/types/globalTypes";
import { makeAddressInputFromDaumPostcode, transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Form, FormInstance, Input, Modal, Row, Select, Typography } from "antd";
import React, { useState } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

import { EXTERNAL_WAREHOUSE_ID, IPoDeliveryAddress } from "./PurchaseOrderCreatePage/utils";

interface PurchaseOrderAddressProps {
  form: FormInstance<PurchaseOrderCreateInput | PurchaseOrderUpdateInput>;
  disabled: boolean;
  warehouseLoading: boolean;
  warehouses: IPoDeliveryAddress[];
}

export const PurchaseOrderAddress: React.FC<PurchaseOrderAddressProps> = ({
  form,
  disabled,
  warehouseLoading,
  warehouses,
}) => {
  const [open, setOpen] = useState<boolean>(false);

  const warehouseAddressWatched = Form.useWatch("warehouseAddress", form);
  const isExternalWarehouse = warehouseAddressWatched === EXTERNAL_WAREHOUSE_ID;

  const warehouseChoices = warehouses
    ?.map((address) => {
      const addressLabel = address.addressData?.companyName || address.warehouseName || "외부업체";
      return {
        label: addressLabel,
        value: address.id,
      };
    })
    .filter(Boolean);
  const searchAddress = (address: Address) => {
    const tempAddressObj = makeAddressInputFromDaumPostcode(address);
    form.setFieldsValue({ postalCode: tempAddressObj.postalCode, streetAddress1: tempAddressObj.streetAddress1 });
    setOpen(false);
  };

  return (
    <Card title={<Typography.Title level={4}>납품 장소</Typography.Title>}>
      <Form.Item name="warehouse" hidden>
        <Input />
      </Form.Item>
      <Row gutter={[12, 12]} align="bottom">
        <Col xs={24} sm={4}>
          <Form.Item
            name="warehouseAddress"
            label="납품처"
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          >
            <Select
              style={{ width: "100%" }}
              size={"large"}
              disabled={disabled || warehouseLoading}
              options={warehouseChoices}
              placeholder={"납품처 종류 선택"}
              onChange={(value) => {
                const selectedAddress = warehouses?.find((addr) => addr?.id === value);
                const addressData = selectedAddress?.addressData;
                const phone = utils.isEmpty(addressData?.phone) ? null : transformPhoneNumber(addressData.phone);

                form.setFieldsValue({
                  warehouse: selectedAddress?.warehouseId || null,
                  deliveryWarehouseName: selectedAddress?.warehouseName || "",
                  deliveryWarehouseManager: addressData?.firstName || "",
                  phone,
                  postalCode: addressData?.postalCode || "",
                  streetAddress1: addressData?.streetAddress1 || "",
                  streetAddress2: addressData?.streetAddress2 || "",
                });
              }}
            />
          </Form.Item>
        </Col>
        <Col xs={24} sm={6}>
          <Form.Item
            name="deliveryWarehouseName"
            label="외부 업체 상호명"
            rules={[{ required: true, message: formRuleMsg.required }]}
            hidden={!isExternalWarehouse}
          >
            <Input disabled={disabled} size={"large"} />
          </Form.Item>
        </Col>
        <Col xs={24} sm={6}>
          <Form.Item
            name="deliveryWarehouseManager"
            label="담당자"
            rules={[{ required: isExternalWarehouse, message: formRuleMsg.required }]}
          >
            <Input size={"large"} disabled={disabled} placeholder={"납품처 담당자 이름"} />
          </Form.Item>
        </Col>
        <Col xs={24} sm={8}>
          <Form.Item
            name="phone"
            label="연락처"
            rules={[{ required: isExternalWarehouse, message: formRuleMsg.required }]}
          >
            <Input size={"large"} disabled={disabled} placeholder={"납품처 담당자 연락처"} />
          </Form.Item>
        </Col>

        <Col xs={16} sm={12}>
          <Form.Item style={{ margin: 0 }} name="postalCode" label="우편 번호">
            <Input disabled={true} style={{ width: "100%" }} size={"large"} placeholder={"납품처 우편 번호"} />
          </Form.Item>
        </Col>
        <Col xs={8} sm={12}>
          <Button
            type={"primary"}
            style={{ width: "100%" }}
            size={"large"}
            disabled={disabled}
            onClick={() => setOpen(true)}
          >
            주소 검색
          </Button>
        </Col>
        <Col xs={24} sm={12}>
          <Form.Item style={{ margin: 0 }} name="streetAddress1" label="주소">
            <Input disabled={true} style={{ width: "100%" }} size={"large"} placeholder={"납품처 주소"} />
          </Form.Item>
        </Col>
        <Col xs={24} sm={12}>
          <Form.Item style={{ margin: 0 }} name="streetAddress2" label="상세주소">
            <Input disabled={disabled} style={{ width: "100%" }} size={"large"} placeholder={"납품처 상세주소"} />
          </Form.Item>
        </Col>
      </Row>
      <Modal
        title={"주소 검색"}
        open={open}
        footer={<Button onClick={() => setOpen(false)}>취소</Button>}
        destroyOnClose
        maskClosable={false}
      >
        <DaumPostcode onComplete={searchAddress} style={{ width: "100%" }} />
      </Modal>
    </Card>
  );
};
</file>

