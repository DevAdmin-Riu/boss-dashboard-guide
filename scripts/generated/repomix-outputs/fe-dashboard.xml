const ORDER_LINE_LIST_FILTERS_KEY = "orderLineListFilters";

export function getFilterOpts(
  params: OrderLineListViewUrlFilters,
  isB2b: boolean,
  pathname?: string
): OrderLineListFilterOpts {
  const filterVariables = getFilterVariables(params, isB2b, pathname);
  const todayMoment = moment();

  return {
    orderStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderStatus), false),
      value: maybe(() => dedupeFilter(filterVariables.orderStatus), []),
