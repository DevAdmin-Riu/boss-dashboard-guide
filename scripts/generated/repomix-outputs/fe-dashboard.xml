        metalUnitDevCostExcludeVat: null,
        metalQtyForDevCost: null,
        resinUnitDevCostExcludeVat: null,
        resinQtyForDevCost: null,
        filmUnitDevCostExcludeVat: null,
        filmQtyForDevCost: null,
        etcUnitDevCostExcludeVat: null,
        etcQtyForDevCost: null,
        vendorProductPriceExcludeVat: null,
        vendorDeliveryFeeExcludeVat: null,
        deliveryFeeExcludeVat: null,
        vendorConsignmentProductPriceExcludeVat: null,
        vendorConsignmentDeliveryFeeExcludeVat: null,
        consignmentDeliveryFeeExcludeVat: null,
        etcMemo: null,
        file: null,
        fileName: null,
      }
    : {
        ...selectedEstimate,
        category: selectedEstimate?.category.id,
        vendor: selectedEstimate?.vendor.id,
        isFileEmpty: false,
      };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const onModalClose = () => {
    form.resetFields();
    setSelectedEstimateId(null);
    onClose();
  };

  const {
    loadMore: loadMoreCategories,
    search: searchCategories,
    result: searchCategoriesOpts,
  } = useCategorySearch({ skip: !open, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const categories = maybe(() => searchCategoriesOpts.data.search.edges, []).map((edge) => edge.node);
  const categoryOptions = categories.map((category) => ({ label: getCategoryLabel(category), value: category.id }));
  if (
    !isCreateMode &&
    selectedEstimate?.category &&
    !categoryOptions.some((option) => option.value === selectedEstimate.category.id)
  ) {
    categoryOptions.push({ label: getCategoryLabel(selectedEstimate.category), value: selectedEstimate.category.id });
  }
  const categoryLoading = searchCategoriesOpts.loading;
  const hasMoreCategories = maybe(() => searchCategoriesOpts.data.search.pageInfo.hasNextPage, false);

  const {
    loadMore: loadMoreVendors,
    search: searchVendors,
    result: searchVendorsOpts,
  } = useVendorSearch({ skip: !open, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const vendors = maybe(() => searchVendorsOpts.data.search.edges, []).map((edge) => edge.node);
  const vendorOptions = vendors.map((vendor) => ({ label: makeVendorDisplayName(vendor), value: vendor.id }));
  if (
    !isCreateMode &&
    selectedEstimate?.vendor &&
    !vendorOptions.some((option) => option.value === selectedEstimate.vendor.id)
  ) {
    vendorOptions.push({ label: makeVendorDisplayName(selectedEstimate.vendor), value: selectedEstimate.vendor.id });
  }
  const vendorLoading = searchVendorsOpts.loading;
  const hasMoreVendors = maybe(() => searchVendorsOpts.data.search.pageInfo.hasNextPage, false);

  const [requestBossProductEstimateCreate, requestBossProductEstimateCreateOpts] =
    useRequestBossProductEstimateCreateMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductEstimateCreate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("협력사 매입가 등록이 완료되었습니다.");
          onModalClose();
