<file path="src/app/views/settings/productTypes/views/ProductTypeUpdateView/ProductTypeUpdateView.tsx">
import useAvailableAttributeSearch from "@hooks/useAvailableAttributeSearch";
import useNavigator from "@hooks/useNavigator";
import { useMetadataUpdate, usePrivateMetadataUpdate } from "@src/api/core/metadata/updateMetadata";
import { AttributeTypeEnum } from "@src/api/types/globalTypes";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { attributeDetailsViewUrl } from "@src/app/views/settings/attributes/urls";
import {
  useAssignAttributeMutation,
  useProductTypeAttributeReorderMutation,
  useProductTypeDeleteMutation,
  useProductTypeUpdateMutation,
  useUnassignAttributeMutation,
} from "@src/app/views/settings/productTypes/api/mutations";
import AssignAttributeDialog from "@src/app/views/settings/productTypes/components/AssignAttributeDialog";
import ProductTypeHasVariantsUncheckedDialog from "@src/app/views/settings/productTypes/components/ProductTypeHasVariantsUncheckedDialog";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { ReorderEvent } from "@src/global/core/types/types";
import createMetadataUpdateHandler from "@utils/handlers/metadataUpdateHandler";
import { maybe, transformIsFBV } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React, { useState } from "react";

import { useProductTypeDetailsQuery } from "../../api/queries";
import { AssignAttribute } from "../../api/types/AssignAttribute";
import { ProductTypeAttributeReorder } from "../../api/types/ProductTypeAttributeReorder";
import { ProductTypeDelete } from "../../api/types/ProductTypeDelete";
import { UnassignAttribute } from "../../api/types/UnassignAttribute";
import ProductTypeAttributeUnassignDialog from "../../components/ProductTypeAttributeUnassignDialog";
import ProductTypeBulkAttributeUnassignDialog from "../../components/ProductTypeBulkAttributeUnassignDialog";
import ProductTypeDeleteDialog from "../../components/ProductTypeDeleteDialog";
import ProductTypeDetailsPage, { ProductTypeUpdateForm } from "../../components/ProductTypeDetailsPage";
import { productTypeListViewUrl } from "../../urls";

interface ProductTypeUpdateViewProps {
  id: string;
}

enum ProductTypeModalModeEnum {
  Assign = "Assign",
  RemoveProductType = "RemoveProductType",
  Unassign = "Unassign",
  UnassignBulk = "UnassignBulk",
  UnassignHasVariants = "UnassignHasVariants",
}

export const ProductTypeUpdateView: React.FC<ProductTypeUpdateViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const [typeForModal, setTypeForModal] = useState(null);
  const [idForModal, setIdForModal] = useState(null);
  const [idsForModal, setIdsForModal] = useState([]);
  const [modalMode, setModalMode] = useState(null);
  const [hasVariantsForModal, setHasVariantsForModal] = useState(false);
  const resetForCloseModal = () => {
    setModalMode(null);
    setIdForModal(null);
    setTypeForModal(null);
    setIdsForModal([]);
    setHasVariantsForModal(false);
  };

  const openModalWithoutNavigate = (
    madalMode: ProductTypeModalModeEnum,
    id?,
    type?,
    idsForModal?: string[],
    hasVariants?: boolean
  ) => {
    setModalMode(madalMode);
    if (id) {
      setIdForModal(id);
    }
    if (type) {
      setTypeForModal(type);
    }
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
    if (hasVariants) {
      setHasVariantsForModal(hasVariants);
    }
  };

  const { loadMore, search, result } = useAvailableAttributeSearch({
    variables: {
      ...DEFAULT_INITIAL_SEARCH_DATA,
      id,
    },
  });
  const [errors, setErrors] = React.useState({
    addAttributeErrors: [],
    editAttributeErrors: [],
    formErrors: [],
  });

  const [updateProductType, updateProductTypeOpts] = useProductTypeUpdateMutation({
    onCompleted: (data) => {
      const errors = data.productTypeUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
        setErrors((prevErrors) => ({
          ...prevErrors,
          formErrors: errors,
        }));
      }
    },
  });

  const [updateMetadata] = useMetadataUpdate({});
  const [updatePrivateMetadata] = usePrivateMetadataUpdate({});

  const handleBack = () => navigate(productTypeListViewUrl());

  const handleProductTypeUpdate = async (formData: ProductTypeUpdateForm) => {
    if (formData.hasVariants && formData.isFulfilledByVendor) {
      showNotificationError(`${transformIsFBV(true)} 상품 전용 제품 타입은 옵션형 제품 타입이 될 수 없습니다.`);
      return;
    }
    const result = await updateProductType({
      variables: {
        id,
        input: {
          name: formData.name,
          hasVariants: formData.hasVariants,
          isFulfilledByVendor: formData.isFulfilledByVendor,
          productAttributes: formData.productAttributes.map((choice) => choice.value),
          variantAttributes: formData.variantAttributes.map((choice) => choice.value),
        },
      },
    });

    return result.data.productTypeUpdate.errors;
  };

  const { data, loading: dataLoading } = useProductTypeDetailsQuery({
    skip: id === undefined,
    variables: {
      id,
    },
  });
  const productType = data?.productType;

  if (productType === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  const productAttributeIdList = productType?.productAttributes.map((e) => e.id) || [];

  const variantAttributesIdList = productType?.variantAttributes.map((e) => e.id) || [];

  const handleAttributeAssignSuccess = (data: AssignAttribute) => {
    const errors = data.attributeAssign.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleAttributeUnassignSuccess = (data: UnassignAttribute) => {
    const errors = data.attributeUnassign.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleProductTypeDeleteSuccess = (data: ProductTypeDelete) => {
    const errors = data.productTypeDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess("제품 타입이 삭제되었습니다.");
      navigate(productTypeListViewUrl(), true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleProductTypeAttributeReorderSuccess = (data: ProductTypeAttributeReorder) => {
    const errors = data.productTypeReorderAttributes.errors;
    if (errors.length === 0) {
      showNotificationSuccess("제품 타입의 속성 순서가 변경되었습니다.");
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleSubmit = createMetadataUpdateHandler(
    data?.productType,
    handleProductTypeUpdate,
    (variables) => updateMetadata({ variables }),
    (variables) => updatePrivateMetadata({ variables })
  );

  const [deleteProductType, deleteProductTypeOpts] = useProductTypeDeleteMutation({
    onCompleted: handleProductTypeDeleteSuccess,
  });
  const [assignAttribute, assignAttributeOpts] = useAssignAttributeMutation({
    onCompleted: handleAttributeAssignSuccess,
  });
  const [unassignAttribute, unassignAttributeOpts] = useUnassignAttributeMutation({
    onCompleted: handleAttributeUnassignSuccess,
  });
  const [reorderAttribute] = useProductTypeAttributeReorderMutation({
    onCompleted: handleProductTypeAttributeReorderSuccess,
  });

  const handleProductTypeDelete = () => deleteProductType({ variables: { id } });
  const handleProductTypeVariantsToggle = (hasVariants: boolean) =>
    updateProductType({
      variables: {
        id,
        input: {
          hasVariants,
        },
      },
    });
  const handleHasVariantsUnassign = () =>
    updateProductType({
      variables: {
        id,
        input: {
          hasVariants: hasVariantsForModal,
          variantAttributes: [],
        },
      },
    });

  const handleAssignAttribute = (seletedIds: string[]) =>
    assignAttribute({
      variables: {
        id,
        operations: seletedIds.map((id) => ({ id, type: AttributeTypeEnum[typeForModal] })),
      },
    });

  const handleAttributeUnassign = () =>
    unassignAttribute({
      variables: {
        id,
        ids: [idForModal],
      },
    });

  const handleBulkAttributeUnassign = () =>
    unassignAttribute({
      variables: {
        id,
        ids: idsForModal,
      },
    });

  const loading = updateProductTypeOpts.loading || dataLoading;

  const handleAttributeReorder = (event: ReorderEvent, type: AttributeTypeEnum) => {
    if (event.newIndex !== event.oldIndex) {
      const attributes =
        type === AttributeTypeEnum.PRODUCT ? data.productType.productAttributes : data.productType.variantAttributes;

      reorderAttribute({
        variables: {
          move: {
            id: attributes[event.oldIndex].id,
            sortOrder: event.newIndex - event.oldIndex,
          },
          productTypeId: id,
          type,
        },
      });
    }
  };

  return (
    <>
      <WindowTitle title={maybe(() => data.productType.name)} />
      <ProductTypeDetailsPage
        disabled={loading}
        errors={errors.formErrors}
        pageTitle={maybe(() => data.productType.name)}
        productType={maybe(() => data.productType)}
        saveButtonBarState={updateProductTypeOpts.status}
        onAttributeAdd={(type) => openModalWithoutNavigate(ProductTypeModalModeEnum.Assign, null, type)}
        onAttributeClick={(attributeId) => navigate(attributeDetailsViewUrl(attributeId))}
        onAttributeReorder={handleAttributeReorder}
        onAttributeUnassign={(attributeId) => openModalWithoutNavigate(ProductTypeModalModeEnum.Unassign, attributeId)}
        onAttributeBulkUnassign={(attributeIds) =>
          openModalWithoutNavigate(ProductTypeModalModeEnum.UnassignBulk, null, null, attributeIds)
        }
        onBack={handleBack}
        onDelete={() => openModalWithoutNavigate(ProductTypeModalModeEnum.RemoveProductType)}
        onHasVariantsToggle={handleProductTypeVariantsToggle}
        onHasVariantsUnassign={(hasVariants) =>
          openModalWithoutNavigate(ProductTypeModalModeEnum.UnassignHasVariants, hasVariants)
        }
        onSubmit={handleSubmit}
      />
      {!dataLoading &&
        Object.keys(AttributeTypeEnum).map((key) => (
          <AssignAttributeDialog
            attributes={maybe(() =>
              result.data.productType.availableAttributes.edges
                .map((edge) => edge.node)
                .filter(
                  (suggestedAttributes) =>
                    !productAttributeIdList.includes(suggestedAttributes.id) &&
                    !variantAttributesIdList.includes(suggestedAttributes.id)
                )
            )}
            loading={result.loading || assignAttributeOpts.loading}
            onClose={resetForCloseModal}
            onSubmit={handleAssignAttribute}
            onFetch={search}
            onFetchMore={loadMore}
            onOpen={result.refetch}
            hasMore={maybe(() => result.data.productType.availableAttributes.pageInfo.hasNextPage, false)}
            open={modalMode === ProductTypeModalModeEnum.Assign && typeForModal === AttributeTypeEnum[key]}
            key={key}
          />
        ))}
      <ProductTypeDeleteDialog
        confirmButtonState={deleteProductTypeOpts.status}
        name={maybe(() => data.productType.name, "...")}
        open={modalMode === ProductTypeModalModeEnum.RemoveProductType}
        onClose={resetForCloseModal}
        onConfirm={handleProductTypeDelete}
      />
      <ProductTypeBulkAttributeUnassignDialog
        attributeQuantity={maybe(() => idsForModal.length)}
        confirmButtonState={unassignAttributeOpts.status}
        onClose={resetForCloseModal}
        onConfirm={handleBulkAttributeUnassign}
        open={modalMode === ProductTypeModalModeEnum.UnassignBulk}
        productTypeName={maybe(() => data.productType.name, "...")}
      />
      <ProductTypeAttributeUnassignDialog
        attributeName={maybe(
          () =>
            [...data.productType.productAttributes, ...data.productType.variantAttributes].find(
              (attribute) => attribute.id === idForModal
            ).name,
          "..."
        )}
        confirmButtonState={unassignAttributeOpts.status}
        onClose={resetForCloseModal}
        onConfirm={handleAttributeUnassign}
        open={modalMode === ProductTypeModalModeEnum.Unassign}
        productTypeName={maybe(() => data.productType.name, "...")}
      />
      <ProductTypeHasVariantsUncheckedDialog
        confirmButtonState={updateProductTypeOpts.status}
        onClose={resetForCloseModal}
        onConfirm={handleHasVariantsUnassign}
        open={modalMode === ProductTypeModalModeEnum.UnassignHasVariants}
        productTypeName={maybe(() => data.productType.name, "...")}
      />
    </>
  );
};
