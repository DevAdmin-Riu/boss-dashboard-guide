import { RequestBossProductFilterInput, RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  ReqBossProductListFilterKeys,
  ReqBossProductListListFilterOpts,
} from "../../components/ReqBossProductListPage/filters";
import {
  ReqBossProductListViewUrlFilters,
  ReqBossProductListViewUrlFiltersEnum,
  ReqBossProductListViewUrlFiltersWithMultipleValuesEnum,
  ReqBossProductListViewUrlQueryParams,
} from "../../urls";

const REQ_BOSS_PRODUCT_FILTERS_KEY = "reqBossProductFilters";

export function getFilterOpts(params: ReqBossProductListViewUrlFilters): ReqBossProductListListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  return {
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch || "",
    },
    requestNumber: {
      active: maybe(() => !utils.isEmpty(filterVariables.requestNumber, true), false),
      value: filterVariables.requestNumber || "",
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.status.map((contactType) => findValueInEnum(contactType, RequestBossProductStatusEnum))
          ),
        []
      ),
    },
    requestedStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.requestedStatusAt.gte, filterVariables.requestedStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.requestedStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.requestedStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    acceptedStatusAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.acceptedStatusAt.gte, filterVariables.acceptedStatusAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.acceptedStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.acceptedStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    reqAdditionalStatusAt: {
      active: maybe(
