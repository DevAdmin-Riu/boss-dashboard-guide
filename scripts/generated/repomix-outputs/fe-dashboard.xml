export const getTotalSales = (salesData: StoreSaleList_storeSales_salesData | null) => {
  if (!salesData) {
    return null;
  }

  return Object.values(salesData)
    .filter((v) => typeof v === "number") // 숫자만 남김
    .reduce((acc, val) => acc + (val as number), 0); // 타입 단언 추가
};

export const getAverageMonthlySales = (salesData: StoreSaleList_storeSales_salesData | null) => {
  if (!salesData) {
    return null;
  }

  const validValues = Object.values(salesData).filter((v) => typeof v === "number");
  const total = validValues.reduce((acc, val) => acc + (val as number), 0);

  return validValues.length ? total / validValues.length : 0;
};
export const makeSalesChartConfig = (salesData: StoreSaleList_storeSales_salesData | null): AreaConfig => {
  const monthKeys = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
  const monthLabels = ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"];

  const chartData = monthKeys.map((key, idx) => ({
    month: monthLabels[idx],
    value: salesData?.[key as keyof StoreSaleList_storeSales_salesData] || 0,
  }));

  const config: AreaConfig = {
    height: 300,
    data: chartData,
    xField: "month",
    yField: "value",
    yAxis: {
      label: {
        formatter: (v: string) => `${Number(v).toLocaleString()} 원`,
      },
    },
    xAxis: {
      range: [0, 1],
    },
    color: "#0E9CFF",
    areaStyle: {
      fill: "l(270) 0:#ffffff 0.5:#7CC9FF 1:#0E9CFF",
    },
    tooltip: {
      formatter: (datum) => ({
        name: "매출",
        value: datum.value.toLocaleString() + " 원",
      }),
    },
    point: {
      size: 4,
      shape: "circle",
      style: {
        fill: "white",
        stroke: "#0E9CFF",
        lineWidth: 2,
      },
    },
    interactions: [{ type: "marker-active" }],
  };

  return config;
};
export const getAverageMonthlySalesByPeong = (
  brandStore: BrandStoreDetails_brandStore,
  salesData: StoreSaleList_storeSales_salesData | null
) => {
  const pyeong = brandStore.operationalInfo?.pyeong;
  const averageMonthlySales = getAverageMonthlySales(salesData);
  if (!pyeong || pyeong === 0) {
    return null;
  }
  return Math.floor(averageMonthlySales / pyeong);
};

export const calcRelativeMove = <T>(siblings: T[], dragNode: T, key: keyof T, to: number): number => {
  let move: number = null;
  const currentIdx = siblings.findIndex((cat) => cat[key] === dragNode[key]);
  const targetIdx = Math.max(Math.min(to, siblings.length - 1), 0);
  if (targetIdx > currentIdx && to !== siblings.length) {
    move = targetIdx - currentIdx - 1;
  } else {
    move = targetIdx - currentIdx;
  }

  return move;
};

export type TFranchiseDocumentsObj = Partial<Record<FranchiseDocumentTypeEnum, BrandStoreFranchiseDocumentUpsertInput>>;

export const makeFranchiseDocumentsObj = (
  franchiseDocuments: Array<StrictOmit<BrandStoreDetails_brandStore_franchiseDocuments, "__typename">>
): TFranchiseDocumentsObj => {
  const documentsArr = franchiseDocuments || [];
  const documentTypeEnumList = Object.values(FranchiseDocumentTypeEnum);
  const documentsObj = documentTypeEnumList.reduce<TFranchiseDocumentsObj>((acc, docType) => {
    const existingDoc = documentsArr.find((doc) => doc.type === docType);
    const file = toUploadFormInitialValue(existingDoc, "fileName");
    acc[docType] = { type: docType, file };
    return acc;
  }, {});
  return documentsObj;
};

export const cleanFranchiseDocumentsObj = (
  formData: IBrandStoreContractInfoUpdateFormData | IPreFounderContractInfoUpdateFormData
): BrandStoreContractInfoUpdateInput | PreFounderContractInfoUpdateInput => {
  const uploadFieldNamePathList: Array<
    FieldPath<IBrandStoreContractInfoUpdateFormData | IPreFounderContractInfoUpdateFormData>
  > = [];
  const basicDocumentTypeEnumList = Object.values(FranchiseDocumentTypeEnum);
  basicDocumentTypeEnumList.forEach((docType) => {
    uploadFieldNamePathList.push(`franchiseDocumentsObj.${docType}.file`);
  });
  const cleanedInput = cleanFormDataUploadInputs(formData, uploadFieldNamePathList);
  const cleanedFranchiseDocuments = convertFormLinesObjToArr(cleanedInput.franchiseDocumentsObj, "type").filter(
    (doc) => doc.file !== undefined
  );

  // 반환할 입력 데이터 생성
  const input: BrandStoreContractInfoUpdateInput | PreFounderContractInfoUpdateInput = {
    ..._.omit(cleanedInput, ["franchiseDocumentsObj"]),
    franchiseDocuments: cleanedFranchiseDocuments,
  };

  return input;
};
