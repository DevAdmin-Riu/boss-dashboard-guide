import { CategoryTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { OrderFilterKeys } from "@src/app/views/order/orders/components/OrderListPage";
import { categoryTypeChoices } from "@src/app/views/product/products/utils/data";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { OrderSalesListViewRouteParams } from "../../urls";

export enum OrderSalesListFilterKeys {
  eventedAt = "eventedAt",
  categoryType = "categoryType",
  trackInventory = "trackInventory",
  orderSearch = "orderSearch",
  paymentSearch = "paymentSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  userSearch = "userSearch",
  productSearch = "productSearch",
  brandProductSearch = "brandProductSearch",
  mdSearch = "mdSearch",
  isOrderFromBossMrkt = "isOrderFromBossMrkt",
  isInner = "isInner",
  exclusive = "exclusive",
}

export interface OrderSalesListFilterOpts {
  eventedAt: FilterOpts<MinMax>;
  categoryType: FilterOpts<CategoryTypeEnum[]>;
  trackInventory: FilterOpts<boolean>;
  orderSearch: FilterOpts<string>;
  paymentSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  mdSearch: FilterOpts<string>;
  isOrderFromBossMrkt: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
  exclusive: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: OrderSalesListFilterOpts,
  routeParams: OrderSalesListViewRouteParams
): IFilter<OrderSalesListFilterKeys> {
  const { viewType } = routeParams;
  let displayOrder = 0;

  const orderSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.orderSearch,
      columnNameConstant.order.ORDER_COMPOSED_ID,
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const eventedAtFilter = {
    ...createDateField(displayOrder++, OrderSalesListFilterKeys.eventedAt, "결제일", opts.eventedAt.value),
    active: opts.eventedAt.active,
  };
  const paymentSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.paymentSearch,
      columnNameConstant.order.PAYMENT_NO,
      opts.paymentSearch.value,
      "결제번호로 검색"
    ),
    active: opts.paymentSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.brandSearch,
      filterNameConstant.BRAND_SEARCH,
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderFilterKeys.brandStoreSearch,
      filterNameConstant.BRAND_STORE_SEARCH,
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.userSearch,
      filterNameConstant.USER_SEARCH,
      opts.userSearch.value
    ),
    active: opts.userSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      OrderSalesListFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const mdSearchFilter = {
    ...createTextField(displayOrder++, OrderSalesListFilterKeys.mdSearch, "담당 MD", opts.mdSearch.value),
    active: opts.mdSearch.active,
  };
  const trackInventoryFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderSalesListFilterKeys.trackInventory,
      columnNameConstant.order.FULFILLMENT_TYPE,
      opts.trackInventory.value,
      {
        positive: "보관",
        negative: "위탁",
      }
    ),
    active: opts.trackInventory.active,
  };
  const categoryTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      OrderSalesListFilterKeys.categoryType,
      "제품 카테고리 분류",
      opts.categoryType.value,
      true,
      categoryTypeChoices
    ),
    active: opts.categoryType.active,
  };
  const isOrderFromBossMrKtFilter = {
    ...createBooleanField(
      displayOrder++,
      OrderSalesListFilterKeys.isOrderFromBossMrkt,
      "보스장터",
      opts.isOrderFromBossMrkt.value,
      {
        positive: "O",
        negative: "X",
      }
    ),
    active: opts.isOrderFromBossMrkt.active,
  };
  const isInnerFilterFilter = {
    ...createBooleanField(displayOrder++, OrderSalesListFilterKeys.isInner, "제품형태", opts.isInner.value, {
      negative: "아우터박스",
      positive: "이너박스",
    }),
    active: opts.isInner.active,
  };
  const isExclusiveFilter = {
    ...createBooleanField(displayOrder++, OrderSalesListFilterKeys.exclusive, "전용여부", opts.exclusive.value, {
      negative: "범용",
      positive: "전용",
    }),
    active: opts.exclusive.active,
  };

  switch (viewType) {
    case "by-user":
      return utils.filterDisplayOrdering([
        orderSearchFilter,
        eventedAtFilter,
        paymentSearchFilter,
        brandSearchFilter,
        brandStoreSearchFilter,
        userSearchFilter,
        productSearchFilter,
        brandProductSearchFilter,
        mdSearchFilter,
        trackInventoryFilter,
        isInnerFilterFilter,
        isExclusiveFilter,
        categoryTypeFilter,
        isOrderFromBossMrKtFilter,
      ]);
    case "by-staff-by-brand":
      return utils.filterDisplayOrdering([
        orderSearchFilter,
        eventedAtFilter,
        brandSearchFilter,
        brandStoreSearchFilter,
        userSearchFilter,
        productSearchFilter,
        brandProductSearchFilter,
        mdSearchFilter,
        trackInventoryFilter,
        isExclusiveFilter,
        categoryTypeFilter,
        isOrderFromBossMrKtFilter,
      ]);
    case "by-staff-for-bad-stock":
      return utils.filterDisplayOrdering([
        orderSearchFilter,
        productSearchFilter,
        eventedAtFilter,
        trackInventoryFilter,
        categoryTypeFilter,
        isOrderFromBossMrKtFilter,
      ]);
    case "for-hq":
      return utils.filterDisplayOrdering([orderSearchFilter, eventedAtFilter, userSearchFilter]);
    default:
      return [];
  }
}
