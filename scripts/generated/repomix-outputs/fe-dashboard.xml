export interface OrderDeliveryAllListPageProps
  extends PaginateListProps,
    FilterPageProps<OrderDeliveryFilterKeys, OrderDeliveryListFilterOpts> {
  params: OrderDeliveryListViewUrlQueryParams;
  deliveryAllList: DeliveryAllListTableDataType[];

  queryVariablesWithoutPagination: FulfillmentAllListVariables;
  fetchForDownload: (variables?: FulfillmentAllListVariables) => Promise<ApolloQueryResult<FulfillmentAllList>>;
}

export const OrderDeliveryAllListPage: React.FC<OrderDeliveryAllListPageProps> = (props) => {
  const {
    params,
    deliveryAllList,
    currentTab,
    tabs,
    filterOpts,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    onAll,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, OrderDeliveryViewTypeEnum.ALL, false, false, false);
  const [selectedFulfillmentIds, setSelectedFulfillmentIds] = useState<string[]>([]);
  const [expandedRowKeys, setExpandedRowKeys] = useState<string[]>([]);
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const { data: couriersData } = useCourierListQuery({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.couriers, filter: { isActive: true } },
  });
  const couriers = maybe(() => couriersData.couriers.edges.map((edge) => edge.node), []);

  const [fetchForPrintFulfillmentAllList] = useFulfillmentAllListFilterDownloadQuery();

  const [fulfillmentBulkTrackingCompleted, fulfillmentBulkTrackingCompletedOpts] =
    useFulfillmentBulkTrackingCompletedMutation({
      onCompleted: (data) => {
        const errors = data?.fulfillmentBulkTrackingCompleted?.errors;
        if (errors?.length !== 0) {
          showGqlErrors(errors);
        } else {
          const successCount = data?.fulfillmentBulkTrackingCompleted?.count;
          showNotificationSuccess(`배송완료 처리가 완료되었습니다. (${successCount}건)`);
          setSelectedFulfillmentIds([]);
        }
      },
      refetchQueries: [fulfillmentAllListQuery],
    });

  const queryVariablesForDailyReport: FulfillmentAllListVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.reportDailyFulfillment,
    filter: getDailyFulfillmentReportFilterVariables(),
    sort: getDeliveryReprintListSortQueryVariables({
      sort: OrderDeliveryReprintListViewUrlSortField.orderCreated,
    }),
  };

  const onPrintClick = (isDaily: boolean) => {
    setPrintBtnLoading(true);
    showDownloadingMessage();
    let variables = getPrintDeliveryAllListQueryVariables(params);
    if (isDaily) {
      variables = queryVariablesForDailyReport;
    }
    fetchForPrintFulfillmentAllList({ variables })
      .then((resFulfillments) => {
        const { columns, header, merges } = parseAllFulfillments(resFulfillments);
        if (!columns || columns.length <= 0) {
          showNotificationWarn("출력할 데이터가 없습니다.");
          return;
        }
        excelDownload({ title: sectionNames.deliveryAll, columns, header, merges, skipOriginHeader: true });
        if (resFulfillments?.data?.fulfillments?.edges?.length < resFulfillments?.data?.fulfillments?.totalCount) {
          showNotificationWarn(commonErrorMsg.maxLimitIssue);
        } else {
          showNotificationSuccess(commonMsg.downloadedToXls);
        }
      })
      .catch((e) => {
        showNotificationError("배송현황 리스트 다운로드 과정에서 에러가 발생하였습니다");
        throw e;
      })
      .finally(() => {
        setPrintBtnLoading(false);
        destroyDownloadingMessage();
      });
  };

  const makeExtraUi = () => (
    <Space>
      <Button
        loading={printBtnLoading}
        type="primary"
        shape="round"
        icon={<DownloadOutlined />}
        onClick={() => onPrintClick(true)}
      >
        당일 재고배송 리스트 다운로드
      </Button>
      <Button
        type="primary"
        shape="round"
        disabled={
          listProps?.disabled || selectedFulfillmentIds.length === 0 || fulfillmentBulkTrackingCompletedOpts.loading
        }
        onClick={() => fulfillmentBulkTrackingCompleted({ variables: { ids: selectedFulfillmentIds } })}
      >
        일괄 배송완료
      </Button>
    </Space>
  );

  const rowSelection: TableRowSelection<DeliveryAllListTableDataType> = {
    fixed: true,
    selectedRowKeys: selectedFulfillmentIds,
    getCheckboxProps: (record: DeliveryAllListTableDataType) => ({
      disabled: !checkFulfillmentDeliveryTracking(record) || record.isChild,
    }),
    onChange: (selectedRowKeys) => setSelectedFulfillmentIds(selectedRowKeys as string[]),
  };

  const rowExpandable: ExpandableConfig<DeliveryAllListTableDataType> = {
    fixed: "left",
    indentSize: 0,
    expandedRowKeys,
    rowExpandable: (record) => record.children?.length > 0,
    onExpandedRowsChange: (expandedKeys) => setExpandedRowKeys(expandedKeys as string[]),
  };

  const columns = getDeliveryAllListTableSettings(props, couriers);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const showTableTitle = deliveryAllList.some((fullfillmentLine) => fullfillmentLine?.children?.length > 0);
  const tableTitle = showTableTitle
    ? () => {
        const noExpanded = !expandedRowKeys || expandedRowKeys.length === 0;
        const arrowIcon = noExpanded ? <DownOutlined /> : <UpOutlined />;
        const buttonText = `배송내역 정보 ${noExpanded ? "펼치기" : "숨기기"}`;
        return (
          <Typography.Link
            style={{ color: "black" }}
            onClick={() => {
              if (noExpanded) {
                const allRowKeys = deliveryAllList
                  .filter((fulfillmentLine) => fulfillmentLine?.children?.length > 0)
                  .map((fulfillmentLine) => fulfillmentLine?.id);
                setExpandedRowKeys(allRowKeys);
              } else {
                setExpandedRowKeys([]);
              }
            }}
          >
            <Space direction={"horizontal"}>
              {arrowIcon}
              {buttonText}
            </Space>
          </Typography.Link>
        );
      }
    : null;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "fulfillments",
    processNodesToDataType: makeDeliveryAllListTableDataType,
    makeChildrenFlat: true,
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.deliveryAll}</Typography.Title>
        </Col>
        <Col>{makeExtraUi()}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          title={tableTitle}
          className={getTableClassName(["ant-table-title-no-border", "ant-table-tree-data"])}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={deliveryAllList}
          rowSelection={rowSelection}
          expandable={rowExpandable}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
</file>

