import { ApolloQueryResult, MutationFunction } from "@apollo/client";
import {
  BoxSizeTypeEnum,
  FulfillmentBulkUpdateTrackingInput,
  FulfillmentUpdateTrackingInput,
  OrderDeliveryMethodsEnum,
  OrderLineBoxSize,
} from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import {
  FulfillmentList,
  FulfillmentList_fulfillments_edges_node_etcDeliveryManInfo,
  FulfillmentListVariables,
} from "@src/app/views/order/orders/api/types/FulfillmentList";
import { makeDeliveryListTableDataType } from "@src/app/views/order/orders/utils";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { getFulfilledLocationsText } from "@src/app/views/product/stock/utils";
import { getVendorContactTypeText } from "@src/app/views/purchase/vendors/utils";
import { CourierList_couriers_edges_node } from "@src/app/views/settings/couriers/api/types/CourierList";
import { GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import {
  convertDeliveryTypeEnumToWord,
  getCourierId,
  makeVendorDisplayName,
  transformAddress,
  transformPhoneNumber,
} from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { showXlsInvalidFileError, showXlsInvalidRowError } from "@utils/notification/wrapperXls";
import { utils } from "@utils/utils";

import {
  FulfillmentBulkUpdateTracking,
  FulfillmentBulkUpdateTrackingVariables,
} from "../../api/types/FulfillmentBulkUpdateTracking";
import { DeliveryListTableDataType } from "./OrderDeliveryListTableSettings";

export const fulfillmentIdFieldName = "출고 ID";
export const trackingNumberFieldName = columnNameConstant.delivery.TRACKING_NO;
export const courierNameFieldName = columnNameConstant.delivery.COURIER_NAME;
export const etcDeliveryVehicleFieldName = columnNameConstant.delivery.DELIVERY_VEHICLE_INFO;
export const etcDeliveryManContactFieldName = columnNameConstant.delivery.DELIVERY_MAN_CONTACT;
const isDirectShippingFieldName = columnNameConstant.delivery.IS_DIRECT_SHIPPING;
const isDsDeliveryRequestDateFieldName = columnNameConstant.delivery.DELIVERY_REQUEST_DATE;

// NOTE: 위탁 배송 시, 컬럼 노출 분기 - return 값에 따라 아래 컬럼 노출
// true: 배차차량정보, 배송기사 연락처, 기타배송 배차정보 입력
// false: 택배사, 송장번호, 송장번호 입력
export const checkNeedDeliveryManInfoForConsignmentFulfill = (isByNonCourier: boolean) => isByNonCourier;

const checkBooleanFromExcelValue = (value: string) => {
  if (utils.isEmpty(value) || value === "-") {
    return false;
  }
  return true;
};

export const fulfillmentBulkUpdateTrackingHandler = async (
  jsonAry: any[],
  couriers: CourierList_couriers_edges_node[],
  fulfillmentBulkUpdateTracking: MutationFunction<
    FulfillmentBulkUpdateTracking,
    FulfillmentBulkUpdateTrackingVariables
  >,
  isB2b: boolean,
  isByNonCourier: boolean,
  isPoLineDeliveryConfirmed: boolean // 송장번호만 업데이트 하는 경우는 false, 배송 확정 하는경우는 true
) => {
  const length = jsonAry?.length;
  if (length <= 0) {
    showXlsInvalidFileError(length);
    return false;
  }

  const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);
  if (needDeliveryManInfoForConsignmentFulfill === false && couriers.length <= 0) {
    showNotificationError("택배사 정보 조회에 실패했습니다.");
    return false;
  }

  const fulfillmentBulkUpdateTrackingList = [];
  for (let i = 0; i < length; i++) {
    const json = jsonAry[i];

    if (!json) {
      showXlsInvalidRowError(json, i);
      break;
    }

    let input: FulfillmentUpdateTrackingInput;

    const fulfillmentId = json[`${fulfillmentIdFieldName}`];

    const isDirectShipping = checkBooleanFromExcelValue(json[`${isDirectShippingFieldName}`]);
    if (isDirectShipping) {
      const isTrackingDirectShipping = checkBooleanFromExcelValue(json[`${isDsDeliveryRequestDateFieldName}`]);
      if (!isTrackingDirectShipping) {
        showXlsInvalidRowError(json, i, isDsDeliveryRequestDateFieldName);
        continue;
      }
      input = { isTrackingDirectShipping };
    } else {
      const needDeliveryManInfoForConsignmentFulfill = checkNeedDeliveryManInfoForConsignmentFulfill(isByNonCourier);

      const etcDeliveryVehicle = json[`${etcDeliveryVehicleFieldName}`];
      const etcDeliveryManContact = String(json[`${etcDeliveryManContactFieldName}`] || "");
      const trackingNumber = String(json[`${trackingNumberFieldName}`] || "");
      const courierName = json[`${courierNameFieldName}`];
      const courierId = getCourierId(couriers, courierName);

      // 2. isB2b 값에 따라 로직을 완전히 분리합니다.
      if (isB2b) {
        const deliveryMethodName = json[`${columnNameConstant.delivery.DELIVERY_METHOD}`];
        if (deliveryMethodName !== "택배" && deliveryMethodName !== "화물차") {
          showXlsInvalidRowError(json, i, "배송 정보 누락", "배송 방식은 택배 또는 화물차 중 하나는 입력해야 합니다.");
          continue;
        }
        // ---------- B2B일 경우의 로직 ----------
        const hasEtcData = !!etcDeliveryVehicle || !!etcDeliveryManContact;
        const hasCourierData = !!courierId || !!trackingNumber;
        const deliveryMethod =
          deliveryMethodName === "택배"
            ? OrderDeliveryMethodsEnum.BY_COURIER
            : OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE;

        if (!hasEtcData && !hasCourierData) {
          showXlsInvalidRowError(
            json,
            i,
            "배송 정보 누락",
            "직접배송(차량, 연락처) 또는 택배사 정보(택배사, 운송장) 중 하나는 입력해야 합니다."
          );
          continue;
        }

        if (hasEtcData && deliveryMethod === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE) {
          if (!etcDeliveryVehicle || !etcDeliveryManContact) {
            showXlsInvalidRowError(json, i, "직접배송 정보 누락", "차량과 연락처를 모두 입력해야 합니다.");
            continue;
          }
          input = { etcDeliveryManInfo: { vehicle: etcDeliveryVehicle, contact: etcDeliveryManContact } };
        }
        if (hasCourierData && deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER) {
          if (!courierId) {
            showXlsInvalidRowError(json, i, courierNameFieldName, "유효하지 않은 택배사 이름입니다.");
            continue;
          }
          if (!trackingNumber) {
            showXlsInvalidRowError(json, i, trackingNumberFieldName);
            continue;
          }
          input = { courierId, trackingNumber, deliveryMethod };
        }
      } else {
        // ---------- B2B가 아닐 경우의 로직 (기존 로직) ----------
        if (needDeliveryManInfoForConsignmentFulfill) {
          if (!etcDeliveryVehicle || !etcDeliveryManContact) {
            showXlsInvalidRowError(json, i, "직접배송 정보 누락", "차량과 연락처를 모두 입력해야 합니다.");
            continue;
          }
          input = { etcDeliveryManInfo: { vehicle: etcDeliveryVehicle, contact: etcDeliveryManContact } };
        } else {
          if (!courierId) {
            showXlsInvalidRowError(json, i, courierNameFieldName, "유효하지 않은 택배사 이름입니다.");
            continue;
          }
          if (!trackingNumber) {
            showXlsInvalidRowError(json, i, trackingNumberFieldName);
            continue;
          }
          input = { courierId, trackingNumber };
        }
      }
    }

    const fulfillmentBulkUpdateTracking: FulfillmentBulkUpdateTrackingInput = { fulfillmentId, input };
    fulfillmentBulkUpdateTrackingList.push(fulfillmentBulkUpdateTracking);
  }

  if (fulfillmentBulkUpdateTrackingList.length > 0) {
    await fulfillmentBulkUpdateTracking({
      variables: {
        fulfillmentsToUpdateTracking: fulfillmentBulkUpdateTrackingList,
        isPoLineDeliveryConfirmed,
      },
    });
  } else {
    showNotificationError("업로드할 수 있는 데이터가 없습니다.");
  }
};

// 피킹리스트를 위한 parse함수
export function parseFulfillmentsForPickingList(resFulfillment: ApolloQueryResult<FulfillmentList>) {
  const fulfillmentData = resFulfillment.data?.fulfillments?.edges?.map((edge) => edge.node);
  const organizedData = makeDeliveryListTableDataType(fulfillmentData);

  const results = [];
  organizedData.forEach((data) => {
    const row = makeOneRowForPickingList(data);
    results.push(row);
    if (data.children) {
      data.children.forEach((child) => {
        const row = makeOneRowForPickingList(child);
        results.push(row);
      });
    }
  });
  // TODO 같은 주문건 내에서 랙 번호로 정렬해야함.

  // 배송관리번호로 1차 정렬, 출고위치로 2차 정렬
  results.sort((a, b) => {
    const orderNumberA = a[`${columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID}`].toLowerCase();
    const orderNumberB = b[`${columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID}`].toLowerCase();
    const warehouseA = a[`${columnNameConstant.delivery.FULFILLMENT_LOCATION}`].toLowerCase();
    const warehouseB = b[`${columnNameConstant.delivery.FULFILLMENT_LOCATION}`].toLowerCase();

    // 1차 정렬: 배송관리번호
    if (orderNumberA < orderNumberB) {
      return -1;
    }
    if (orderNumberA > orderNumberB) {
      return 1;
    }

    // 2차 정렬: 출고위치
    if (warehouseA < warehouseB) {
      return -1;
    }
    if (warehouseA > warehouseB) {
      return 1;
    }

    return 0;
  });

  return results;
}

const makeOneRowForPickingList = (data: DeliveryListTableDataType) => {
  const fulfillmentComposedId = data.fulfillmentComposedIdWithPrefix;
  const orderLineComposedId = data.orderLineComposedIdWithPrefix;

  const orderCreated = getDateByFormat(data.order.created);
  const orderCapturedAt = getDateByFormat(data.order.capturedAt);
  const fulfillmentCreated = getDateByFormat(data.created);
  const trackingStatus = data.trackingNumber ? "배송 중" : "배송준비 중";

  const brandName = data.userBrandName;
  const firstName = data.order.user.firstName ? data.order.user.firstName : "-";

  const productSku = data.orderLine.productSku;
  const productName = data.orderLine.variant.product.name;

  const variant = data?.orderLine?.variant;
  const hasVariants = !!variant?.product?.productType?.hasVariants;
  const targetAttributes = hasVariants ? variant?.attributes : variant?.product?.attributes;
  const attributes = makeProductSpecTextFromAttr(targetAttributes);
  const attrQuantity = makeProductQtyPerBoxText(variant);

  const vendorName = makeVendorDisplayName(data.vendor);
  const vendorSku = data.externalSku ? data.externalSku : "-";
  const vendorProductName = data.externalProductName ? data.externalProductName : "-";
  const vendorEmail = data.vendor?.email ? data.vendor?.email : "-";
  const vendorContactType = data.vendor?.contactType ? getVendorContactTypeText(data.vendor?.contactType) : "-";

  const deliveryMethod = convertDeliveryTypeEnumToWord(data.deliveryMethod);
  const productQuantity = data.quantity;
  const addressName = data.order.shippingAddress.firstName;
  const contact = transformPhoneNumber(data.order.shippingAddress.phone);
  const address = transformAddress(data.order.shippingAddress);
  const etcDeliveryManInfoText = utils.isEmpty(data.etcDeliveryManInfo)
    ? ""
    : makeEtcDeliveryManInfoText(data.etcDeliveryManInfo);

  const pickingLocationsText = getFulfilledLocationsText(data);
  const warehouseColumn = pickingLocationsText;

  const row = {
    [`${columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID}`]: fulfillmentComposedId,
    [`${columnNameConstant.order.ORDER_LINE_COMPOSED_ID}`]: orderLineComposedId,

    [`${columnNameConstant.order.ORDER_DATE}`]: orderCreated,
    [`${columnNameConstant.order.CAPTURED_DATE}`]: orderCapturedAt,
    [`${columnNameConstant.delivery.FULFILLMENT_DATE}`]: fulfillmentCreated,
    [`${columnNameConstant.delivery.DELIVERY_STATUS}`]: trackingStatus,

    [`${columnNameConstant.brand.BRAND_NAME}`]: brandName,
    [`${columnNameConstant.user.USER_NAME}`]: firstName,

    [`${columnNameConstant.product.SKU}`]: productSku,
    [`${columnNameConstant.product.PRODUCT_NAME}`]: productName,
    [`${columnNameConstant.product.DETAIL_INFO}`]: attributes,
    [`${columnNameConstant.product.PRODUCT_QTY_PER_BOX}`]: attrQuantity,

    [`${columnNameConstant.vendor.VENDOR_NAME}`]: vendorName,
    [`${columnNameConstant.vendor.EXTERNAL_SKU}`]: vendorSku,
    [`${columnNameConstant.vendor.EXTERNAL_PRODUCT_NAME}`]: vendorProductName,
    [`${columnNameConstant.vendor.VENDOR_EMAIL}`]: vendorEmail,
    [`${columnNameConstant.vendor.VENDOR_CONTACT_TYPE}`]: vendorContactType,

    [`${columnNameConstant.delivery.DELIVERY_METHOD}`]: deliveryMethod,
    [`${columnNameConstant.fulfillment.ORDER_QUANTITY}`]: productQuantity,
    [`${columnNameConstant.delivery.DELIVERY_NAME}`]: addressName,
    [`${columnNameConstant.delivery.PHONE}`]: contact,
    [`${columnNameConstant.delivery.DELIVERY_ADDRESS}`]: address,
    [`${columnNameConstant.delivery.FULFILLMENT_LOCATION}`]: warehouseColumn,
    [`${columnNameConstant.delivery.ETC_DELIVERY_INFO}`]: etcDeliveryManInfoText,
  };

  return row;
};

// 재고상품 관리(기타)의 피킹리스트에 쓰이는 Variables
export function getPrintDeliveryPickingListQueryVariables(selectedFulfillmentIds: string[]): FulfillmentListVariables {
