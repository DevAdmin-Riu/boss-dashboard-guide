import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  attributeCreateViewPath,
  attributeDetailsViewPath,
  attributeListViewPath,
  AttributeListViewUrlQueryParams,
  AttributeListViewUrlSortField,
} from "./urls";
import { AttributeCreateView } from "./views/AttributeCreateView/AttributeCreateView";
import { AttributeDetailsView } from "./views/AttributeDetailsView/AttributeDetailsView";
import { AttributeListView } from "./views/AttributeListView/AttributeListView";

const AttributeListWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: AttributeListViewUrlQueryParams = asSortParams(qs, AttributeListViewUrlSortField);

  return <AttributeListView params={params} />;
};

const AttributeDetailsViewWrapper: React.FC<RouteComponentProps<{ id: string }>> = ({ match }) => (
  <AttributeDetailsView id={decodeURIComponent(match.params.id)} />
);

export const AttributeSection: React.FC = () => (
  <>
    <WindowTitle title={sectionNames.attributes} />
    <Switch>
      <Route exact path={attributeListViewPath} component={AttributeListWrapper} />
      <Route exact path={attributeCreateViewPath} component={AttributeCreateView} />
      <Route path={attributeDetailsViewPath(":id")} component={AttributeDetailsViewWrapper} />
