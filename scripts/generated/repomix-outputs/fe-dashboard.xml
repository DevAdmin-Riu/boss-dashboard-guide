import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { AttributeSlugEnum } from "@src/app/views/product/products/utils/data";
import { useAttributeDetailsQuery } from "@src/app/views/settings/attributes/api/queries";
