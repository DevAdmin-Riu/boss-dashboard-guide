  BARCODE_SCANNED: string; // 변환된 바코드 데이터
}

type MessageHandlerMap = Partial<{
  [T in WebViewToWebMsgType]: (value: WebViewMessageValueMap[T]) => void;
}>;

interface UseWebViewMessageHandlerOptions {
  handlers: MessageHandlerMap; // type과 처리 로직 매핑
}

// NOTE: 각 handler 안에서 훅이 위치한 페이지 내의 실시간 값을 이용하기 위해선 useRef를 사용해야 함. ex) FulfillmentInspectListPage.tsx
export const useWebViewMessageHandler = ({ handlers }: UseWebViewMessageHandlerOptions) => {
  useEffect(() => {
    const eventTarget = utils.checkWebViewAndroid() ? document : window;

    const handleMessageFromWebView = (e: MessageEvent) => {
      const parsedData = utils.jsonParseWrapper(e.data);

      if (parsedData?.type && handlers[parsedData.type]) {
        // type에 해당하는 핸들러 실행
        handlers[parsedData.type](parsedData.value);
      }
    };

    eventTarget.addEventListener("message", handleMessageFromWebView);
    return () => eventTarget.removeEventListener("message", handleMessageFromWebView);
  }, []);
};
