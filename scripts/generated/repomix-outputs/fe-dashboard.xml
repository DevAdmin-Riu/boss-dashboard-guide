import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts } from "@src/global/core/types/types";
import { createBooleanField, createTextField } from "@utils/filters/fields";

export enum VendorListFilterKeys {
  vendorSearch = "vendorSearch",
  bizRegNo = "bizRegNo",
  isCreatedStaffUser = "isCreatedStaffUser",
  useBossProduct = "useBossProduct",
  useB2bProduct = "useB2bProduct",
  useFbvProduct = "useFbvProduct",
  hasLiabilityInsurance = "hasLiabilityInsurance",
  useFbvAlarm = "useFbvAlarm",
  usePoEmail = "usePoEmail",
  useDelegatedManagementForPo = "useDelegatedManagementForPo",
  useAutoConsignmentPo = "useAutoConsignmentPo",
}

export interface VendorListFilterOpts {
  vendorSearch: FilterOpts<string>;
  bizRegNo: FilterOpts<string>;
  isCreatedStaffUser: FilterOpts<boolean>;
  useBossProduct: FilterOpts<boolean>;
  useB2bProduct: FilterOpts<boolean>;
  useFbvProduct: FilterOpts<boolean>;
  hasLiabilityInsurance: FilterOpts<boolean>;
  useFbvAlarm: FilterOpts<boolean>;
  usePoEmail: FilterOpts<boolean>;
  useDelegatedManagementForPo: FilterOpts<boolean>;
  useAutoConsignmentPo: FilterOpts<boolean>;
}

export function createFilterStructure(opts: VendorListFilterOpts): IFilter<VendorListFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createTextField(
        displayOrder++,
        VendorListFilterKeys.vendorSearch,
        filterNameConstant.VENDOR_SEARCH,
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createTextField(displayOrder++, VendorListFilterKeys.bizRegNo, "사업자등록번호", opts.bizRegNo.value),
      active: opts.bizRegNo.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        VendorListFilterKeys.isCreatedStaffUser,
        "관리자계정",
        opts.isCreatedStaffUser.value,
        {
          negative: "없음",
          positive: "있음",
