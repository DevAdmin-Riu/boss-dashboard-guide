export const makeVendorNameCol = (
  editingProps?: IPurchaseTableSettingsPropsForEditing
): DownloadableEditableColumnType<Purchases_purchases_edges_node> => ({
  title: columnNameConstant.vendor.VENDOR_NAME,
  key: "vendorName",
  align: "left",
  width: 150,
  render: (_, record) => getPurchaseVendorName(record),
  onCell: (record) => {
    if (!editingProps) {
      return undefined;
    }
    const { isEditing, vendorOptions, vendorsSearch } = editingProps;
    const inputType = "searchSelect";
    const formItemName = "vendor";
    let editing = isEditing ? isEditing(record) : false;
    if (isTakeBackType(record.type)) {
      editing = false;
    }

    const params = utils.jsonParseWrapper(record.parameters);
    const vendor = params?.vendor;

    if (vendorOptions) {
      // vendorOptions에 현재 vendorName이 없는 경우 추가.
      const isExist = vendorOptions.some((option) => option.value === record.vendorId);
      if (!isExist) {
        vendorOptions.push({ label: makeVendorDisplayName(vendor), value: record.vendorId });
      }
      return {
        inputType,
        formItemName,
        editing,
        selectOptions: vendorOptions,
        onSearch: vendorsSearch,
      };
    } else {
      return null;
    }
  },
});
