import { WindowTitle } from "@src/app/components/WindowTitle";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  bannerCreateViewPath,
  bannerDetailsViewPath,
  BannerDetailsViewUrlQueryParams,
  bannerListViewPath,
  BannerListViewUrlQueryParams,
  BannerListViewUrlSortField,
} from "./urls";
import { BannerCreateView } from "./views/BannerCreateView";
import { BannerDetailsView } from "./views/BannerDetailsView";
import { BannerListView } from "./views/BannerListView/BannerListView";

const BannerListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: BannerListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    BannerListViewUrlSortField,
    BannerListViewUrlSortField.start,
    false
  );
  return <BannerListView params={params} />;
};

interface BannerDetailsRouteParams {
  id: string;
}
const BannerDetailsViewWrapper: React.FC<RouteComponentProps<BannerDetailsRouteParams>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: BannerDetailsViewUrlQueryParams = qs;

  return <BannerDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

const BannersSection = () => (
  <>
    <WindowTitle title={"배너 관리"} />
    <Switch>
      <Route exact path={bannerListViewPath} component={BannerListViewWrapper} />
      <Route exact path={bannerCreateViewPath} component={BannerCreateView} />
      <Route exact path={bannerDetailsViewPath(":id")} component={BannerDetailsViewWrapper} />
    </Switch>
  </>
);

export default BannersSection;
</file>

