export const warehouseDetailsViewPath = (id: string) => urlJoin(warehouseSectionUrl, id);
export type WarehouseDetailsViewUrlDialog =
  | "delete"
  | "add-warehouse-address"
  | "update-warehouse-address"
  | "delete-warehouse-address"
  | "add-rack-sector"
  | "update-rack-sector"
  | "delete-rack-sector"
  | "add-rack-location"
  | "update-rack-location"
  | "delete-rack-location";
export type WarehouseDetailsViewUrlQueryParams = Dialog<WarehouseDetailsViewUrlDialog> &
  Partial<{
    warehouseAddressId: string;
    rackSectorId: string;
    rackLocationId: string;
  }>;
export const warehouseDetailsViewUrl = (id: string, params?: WarehouseDetailsViewUrlQueryParams) =>
  warehouseDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);

export const warehouseCreateViewPath = urlJoin(warehouseSectionUrl, "add");
export const warehouseCreateViewUrl = warehouseCreateViewPath;
