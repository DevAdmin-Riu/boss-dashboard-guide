import useUser from "@hooks/useUser";
import { ModusignTemplateCreateInput } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog, { SaveFilterTabDialogFormData } from "@src/app/components/SaveFilterTabDialog";
import { ListViews, TabActionDialog } from "@src/global/core/types/types";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import {
  useModusignDocumentCreateMutation,
  useModusignTemplateCreateMutation,
  useModusignTemplateViewMutation,
} from "../../api/mutations";
import { useModusignTemplateListQuery } from "../../api/queries";
import { ModusignTemplateListVariables } from "../../api/types/ModusignTemplateList";
import ModusignTemplateCreateModal from "../../components/ModusignTemplateListPage/ModusignTemplateCreateModal";
import ModusignTemplateListPage from "../../components/ModusignTemplateListPage/ModusignTemplateListPage";
import {
  modusignDocumentConfirmUrl,
  modusignTemplateConfirmUrl,
  modusignTemplateListUrl,
  ModusignTemplateListUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

enum ModusignTemplateListViewModelEnum {
  CREATE_TEMPLATE = "CREATE_TEMPLATE",
  SHOW_IFRAME = "SHOW_IFRAME",
}

interface ModusignTemplateListViewProps {
  params: ModusignTemplateListUrlQueryParams;
}

const ModusignTemplateListView: React.FC<ModusignTemplateListViewProps> = (props) => {
  const { user } = useUser();
  const { params } = props;
  const [modalMode, setModalMode] = React.useState<ModusignTemplateListViewModelEnum | null>(null);
  const targetUrl = (params: ModusignTemplateListUrlQueryParams) => modusignTemplateListUrl(params);
  const redirectParams = { title: params.title, limit: params.limit, page: params.page };
  const modusignRedirectBaseUri = process.env.MODUSIGN_REDIRECT_URI;
  const modusignMetaDataRedirectUrl = modusignRedirectBaseUri + modusignTemplateConfirmUrl();
  const modusignTemplateRedirectUrl = modusignRedirectBaseUri + targetUrl(redirectParams);
  const modusignDocumentRedicrectUrl = modusignRedirectBaseUri + modusignDocumentConfirmUrl();

  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MODUSIGN_TEMPLATE_LIST,
  });

  const limit = settings.rowNumber;
  const currentPage = Number(params.page) || 1;
  const offset = (currentPage - 1) * limit;
  const brandCode = user?.brand?.code;
  const queryVariables: ModusignTemplateListVariables = React.useMemo(
    () => ({ filters: { ...getFilterVariables(params), brandCode }, limit, offset }),
    [params, settings?.rowNumber]
  );

  const paginationOnChange = (page: number) => {
    const newParams = { ...params, page };
    navigate(modusignTemplateListUrl(newParams));
  };

  const { data, loading, refetch } = useModusignTemplateListQuery({
    variables: {
      ...queryVariables,
      limit,
    },
  });

  const [modusignTemplateCreate, modusignTemplateCreateOpts] = useModusignTemplateCreateMutation({
    onCompleted: (data) => {
      const errors = data.modusignTemplateCreate.errors;
      if (errors.length === 0) {
        window.location.href = data.modusignTemplateCreate.embeddedUrl;
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [modusignTemplateView, modusignTemplateViewOpts] = useModusignTemplateViewMutation({
    onCompleted: (data) => {
      const errors = data.modusignTemplateView.errors;
      if (errors.length === 0) {
        window.location.href = data.modusignTemplateView.embeddedUrl;
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [modusignDocumentCreate, modusignDocumentCreateOpts] = useModusignDocumentCreateMutation({
    onCompleted: (data) => {
      const errors = data.modusignDocumentCreate.errors;
      if (errors.length === 0) {
        window.location.href = data.modusignDocumentCreate.embeddedUrl;
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onModusignTemplateCreate = (formData: ModusignTemplateCreateInput) => {
    modusignTemplateCreate({
      variables: {
        input: formData,
      },
    });
  };

  const onModusignTemplateView = (templateId: string) => {
    modusignTemplateView({
      variables: {
        input: {
          templateId,
          redirectUrl: modusignTemplateRedirectUrl,
        },
      },
    });
  };

  const onModusignDocumentCreate = (templateId: string) => {
    if (utils.isEmpty(brandCode)) {
      showNotificationError("접근 권한이 없습니다.");
      return;
    }
    if (utils.isEmpty(templateId)) {
      showNotificationError("템플릿 ID가 없습니다.");
      return;
    }
    modusignDocumentCreate({
      variables: {
        input: {
          templateId,
          redirectUrl: modusignDocumentRedicrectUrl,
          brandCode,
        },
      },
    });
  };

  const tabs = getFilterTabs ? getFilterTabs() : [];
  const currentTab =
    params.activeTab === undefined
      ? areFiltersApplied
        ? areFiltersApplied(params)
          ? tabs.length + 1
          : 0
        : 0
      : parseInt(params.activeTab, 0);
  const handleTabChange = (tab: number) => {
    navigate(
      targetUrl({
        activeTab: tab.toString(),
        ...getFilterTabs()[tab - 1].data,
      })
    );
  };
  const [openModal, closeModal] = createDialogActionHandlers<TabActionDialog, ModusignTemplateListUrlQueryParams>(
    navigate,
    targetUrl,
    params
  );
  const handleFilterTabDelete = () => {
    deleteFilterTab(currentTab);
    navigate(targetUrl(params));
  };

  const handleFilterTabSave = (data: SaveFilterTabDialogFormData) => {
    saveFilterTab(data.name, getActiveFilters(params));
    handleTabChange(tabs.length + 1);
  };

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: targetUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: refetch,
  });

  const onCreateTemplateModal = () => setModalMode(ModusignTemplateListViewModelEnum.CREATE_TEMPLATE);

  const disabled =
    loading ||
    modusignTemplateCreateOpts.loading ||
    modusignTemplateViewOpts.loading ||
    modusignDocumentCreateOpts.loading;

  return (
    <>
      <ModusignTemplateListPage
        params={params}
        settings={settings}
        onUpdateListSettings={updateListSettings}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        currentTab={currentTab}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onNextPage={null}
        onPreviousPage={null}
        disabled={disabled}
        templateList={maybe(() => data.modusignTemplateList.templates.map((template) => template, []))}
        onCreateTemplateModal={onCreateTemplateModal}
        totalCount={maybe(() => data.modusignTemplateList.count)}
        paginationOnChange={paginationOnChange}
        currentPage={currentPage}
        limit={limit}
        onModusignTemplateView={onModusignTemplateView}
        onModusignDocumentCreate={onModusignDocumentCreate}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <ModusignTemplateCreateModal
        open={modalMode === ModusignTemplateListViewModelEnum.CREATE_TEMPLATE}
        onClose={() => setModalMode(null)}
        onSubmit={(formData) =>
          onModusignTemplateCreate({ ...formData, brandCode, redirectUrl: modusignMetaDataRedirectUrl })
        }
      />
    </>
  );
};

export default ModusignTemplateListView;
</file>

