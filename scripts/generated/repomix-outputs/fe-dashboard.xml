import { formRuleMsg } from "@assets/messages/commonMsg";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Typography } from "antd";
import React, { useEffect } from "react";

interface B2BOrderLinesRejectForm {
  reason: string;
}

interface B2BOrderLineRejectModalProps {
  open: boolean;
  loading: boolean;
  orderLineId: string;
  onCancel: (shouldReset: boolean) => void;
  onSubmit: (reason: string) => void;
}

const B2bOrderLineRejectModal: React.FC<B2BOrderLineRejectModalProps> = (props) => {
  const { open, loading, orderLineId, onCancel, onSubmit } = props;
  const [form] = Form.useForm<B2BOrderLinesRejectForm>();
  const initialValues: B2BOrderLinesRejectForm = {
    reason: "",
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const onFinish = (values: B2BOrderLinesRejectForm) => {
    if (utils.isEmpty(orderLineId)) {
      showNotificationWarn("주문 거부에 실패했습니다. 주문 정보를 찾을 수 없습니다.");
      return;
    }
    const { reason } = values;
    if (reason.length < 5) {
      showNotificationWarn("주문 거부에 실패했습니다. 거부 사유는 최소 5자 이상이어야 합니다.");
      return;
    }
    onSubmit(reason);
  };

  const modalLoading = loading;

  return (
    <Modal
      closable={false}
      open={open}
      onCancel={() => onCancel(false)}
      onOk={form.submit}
      okText="거부"
      okButtonProps={{ danger: true, type: "primary", loading: modalLoading }}
      title="주문 접수 거부"
      zIndex={1050}
      maskClosable={false}
    >
      <Form form={form} initialValues={initialValues} onFinish={onFinish}>
        <Typography.Title level={4} style={{ marginBottom: 4 }}>
          거부 사유를 입력해주세요.
        </Typography.Title>
        <Form.Item
          name="reason"
          rules={[{ required: true, type: "string", min: 5, message: formRuleMsg.min(5, "자") }]}
        >
          <Input.TextArea
            rows={4}
            placeholder="거부 사유를 입력해주세요. (불가능한 납품요청일, 불가능한 납품수량 등)"
          />
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default B2bOrderLineRejectModal;
