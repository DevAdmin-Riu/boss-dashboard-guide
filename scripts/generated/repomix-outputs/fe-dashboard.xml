  queryVariablesWithoutPagination: RootCategoriesVariables;
  fetchForDownload: (variables?: RootCategoriesVariables) => Promise<ApolloQueryResult<RootCategories>>;
}

export const CategoryListPage: React.FC<CategoryListPageProps> = ({
  categories,
  currentTab,
  disabled,
  pageInfo,
  settings,
  tabs,
  onAdd,
  onAll,
  onNextPage,
  onPreviousPage,
  onRowClick,
  onTabChange,
  onTabDelete,
  onTabSave,
  onUpdateListSettings,
  onFilterChange,
  filterOpts,
  queryVariablesWithoutPagination,
  fetchForDownload,
  ...listProps
}) => {
  const sorterStructure = createSorterStructure();

  const filterStructure = createFilterStructure(filterOpts);
  const columns = getCategoryListTableSettings(onRowClick);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, settings.columns);
  const handleSave = (columns) => onUpdateListSettings("columns", columns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "categories",
  };

  return (
    <Space direction="vertical" size={24}>
