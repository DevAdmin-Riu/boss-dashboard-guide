      isConsignment && makeOrderComposedIdCol(), // 주문번호
      isConsignment && makeOrderLineComposedIdCol(isB2b), // 주문번호
      makePoAskingPurchaseDateCol(), // 납품 요청일
      isReceiveStatus === false && makeExpectedPurchaseDateCol(), // 납품 예정일
      ...productInfoColumns(true).children, // 협력사 여부 true 고정
      makeOnlyQuantityCol(), // 발주 수량
      makeOnlyExpectedPurchaseQuantityCol(), // 납품 수량(예정)
      makeOnlyQuantityUnitCol(), // 발주 단위
      makeVsUnitCostPriceExcludeVatCol(), // 개당단가
      makeQtyPerBoxUnitTypeCol(), // 입수량단위
      makeCostPriceExcludeVatCol(commonPropsForVsPriceInfo), // 박스단가
      makeTotalCostPriceExcludeVatCol(commonPropsForVsPriceInfo), // 제품총액
      !isByNonCourier && makeDevCostExcludeVatCol(commonPropsForVsPriceInfo), // 개발비
      !isByNonCourier && makeEtcExcludeVatCol(commonPropsForVsPriceInfo), // 기타비용
      makePoLineTotalPriceExcludeVatCol(commonPropsForVsPriceInfo), // 공급가액
      makeVatAmountCol(commonPropsForVsPriceInfo), // 부가세
      !isByNonCourier && makePoLineNoteCol(), // 제품 비고
