  id: string;
}
const ReqBossProductDetailsViewWrapper: React.FC<RouteComponentProps<ReqBossProductDetailsViewRouteProps>> = ({
  match,
  location,
}) => {
  const id = decodeURIComponent(match.params.id);
  const qs = parseQs(location.search.substr(1));
