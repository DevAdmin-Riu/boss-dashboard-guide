import { ApolloQueryResult } from "@apollo/client";
import { PriorityLevelEnum } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { getUserName, transformTrackInventoryVariantType } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";
import React from "react";

import { ProductVariantList_productVariants_edges_node } from "../../../products/api/types/ProductVariantList";
import { makeProductQtyPerBoxText } from "../../../products/utils/data";
import { calcPackCount } from "../../../products/utils/utils";
import { DownloadStockDetailEventList } from "../../api/types/DownloadStockDetailEventList";
import { MonthlyStockSnapshots_monthlyStockSnapshots_edges_node } from "../../api/types/MonthlyStockSnapshots";
import {
  getFromLocationByStockDetailEvent,
  getQuantityByStockDetailEvent,
  getStockDetailEventTypeName,
  getStockSpec,
  getToLocationByStockDetailEvent,
  makeStockDetailEventInfoText,
  TProductVariantForStockSalesKey,
} from "../../utils";

export const parseStockDetailEventList = (
  resStockDetailEventList: ApolloQueryResult<DownloadStockDetailEventList>,
  isFulfilledByVendor: boolean
) => {
  const columns = resStockDetailEventList.data?.stockDetailEventList.edges
    .map((edge) => edge.node)
    .flatMap((stockDetailEvent, idx) => {
      const variant = stockDetailEvent.stock?.productVariant;
      const product = variant?.product;

      const row = {
        No: idx + 1,
        [columnNameConstant.stock.STOCK_ADJ_DATE]: moment(stockDetailEvent.date).format(onlyDateFormat),
        [columnNameConstant.product.SKU]: variant?.sku || "-",
        [columnNameConstant.product.PRODUCT_NAME]: product?.name || "-",
        [columnNameConstant.product.DETAIL_INFO]: variant ? getStockSpec(variant) : "-",
        [columnNameConstant.product.PRODUCT_QTY_PER_BOX]: makeProductQtyPerBoxText(variant) || "-",
        [columnNameConstant.product.TRACK_INVENTORY]: variant
          ? transformTrackInventoryVariantType(variant.trackInventory)
          : "-",
        구분: getStockDetailEventTypeName(stockDetailEvent.type),
      };

      if (isFulfilledByVendor === false) {
        row["출발 로케이션"] = getFromLocationByStockDetailEvent(stockDetailEvent);
        row["도착 로케이션"] = getToLocationByStockDetailEvent(stockDetailEvent);
        row[columnNameConstant.vendor.VENDOR_NAME] = stockDetailEvent?.vendor || "-";
        row[columnNameConstant.purchaseOrder.VENDOR_COST_PRICE(false)] = stockDetailEvent?.costPriceExcludeVat || 0;
      }

      row["수량"] = getQuantityByStockDetailEvent(stockDetailEvent) || 0;
      row["잔여재고"] =
        utils.isEmpty(stockDetailEvent.stockQtySnapshot) === false ? stockDetailEvent.stockQtySnapshot : "-";
      row["처리 담당자"] = getUserName(stockDetailEvent.user);
      row["비고"] = makeStockDetailEventInfoText(stockDetailEvent, isFulfilledByVendor);

      return row;
    });

  return { columns };
};

// ==================== 판매 정보 컬럼 관련 상수 및 헬퍼 함수 ====================

// 판매정보 컬럼 타입
export const SALES_INFO_TYPE = {
  SEPARATED: "separated", // 판매정보 (아우터/이너분리)
  COMBINED: "combined", // 판매정보 (아우터 통합)
  PRODUCT_STATUS: "product_status", // 제품현황 (중요도 ~ 최대 재고)
  STOCK_STATUS: "stock_status", // 재고 상태
} as const;

export type SalesInfoType = (typeof SALES_INFO_TYPE)[keyof typeof SALES_INFO_TYPE];

// n/a 값 표시를 위한 설정
export const NA_VALUE_TEXT = "-";
export const naValueCellStyle: React.CSSProperties = {
  backgroundColor: "#f5f5f5",
};
export const naValueTextStyle: React.CSSProperties = {
  color: "#999",
};

export const getSalesValueByType = ({
  type,
  record,
  value,
  fieldKey,
  isFbv,
}: {
  type: SalesInfoType;
  record: ProductVariantList_productVariants_edges_node;
  value: number | PriorityLevelEnum;
  fieldKey?: keyof TProductVariantForStockSalesKey;
  isFbv?: boolean;
}): number | PriorityLevelEnum | typeof NA_VALUE_TEXT => {
  const { canSaleByInner, isInner } = record;
  const trackInventory = isInner ? record.outer?.trackInventory : record.trackInventory;

  switch (type) {
    case SALES_INFO_TYPE.SEPARATED: {
      if (!canSaleByInner || isFbv) {
        return isInner ? NA_VALUE_TEXT : value;
      }
      if (!isInner) {
        return value;
      }
      const packCount = calcPackCount(record.outer, record);
      const innerValueConverted =
        packCount && typeof value === "number" ? utils.convertToNumber(value / packCount, 2) : 0;
      return innerValueConverted;
    }

    case SALES_INFO_TYPE.COMBINED: {
      if (isInner || !trackInventory) {
        return NA_VALUE_TEXT;
      }
      if (!canSaleByInner) {
        return value;
      }

      if (typeof value === "number" && fieldKey && record.inner) {
        const innerValue = record.inner[fieldKey];
        const packCount = calcPackCount(record, record.inner);
        if (packCount > 0) {
          const innerValueConverted = utils.convertToNumber(innerValue / packCount, 2);
          return value + innerValueConverted;
        }
      }
      return value;
    }

    case SALES_INFO_TYPE.PRODUCT_STATUS:
    case SALES_INFO_TYPE.STOCK_STATUS: {
      if (trackInventory || isFbv) {
        return isInner ? NA_VALUE_TEXT : value;
      }
      return canSaleByInner ? (isInner ? value : NA_VALUE_TEXT) : NA_VALUE_TEXT;
    }

    default:
      return NA_VALUE_TEXT;
  }
};

// 타입 가드 함수
const isMonthlySnapshot = (
  record: ProductVariantList_productVariants_edges_node | MonthlyStockSnapshots_monthlyStockSnapshots_edges_node
): record is MonthlyStockSnapshots_monthlyStockSnapshots_edges_node => "outerTrackInventory" in record;

export const shouldShowNAValue = ({
  type,
  record,
  isFbv = false,
}: {
  type: SalesInfoType;
  record: ProductVariantList_productVariants_edges_node | MonthlyStockSnapshots_monthlyStockSnapshots_edges_node;
  isFbv?: boolean;
}): boolean => {
  // isFbv가 true면 항상 값을 표시
  if (isFbv) {
    return false;
  }

  const { isInner, canSaleByInner } = record;
  const trackInventory = isMonthlySnapshot(record)
    ? record.outerTrackInventory
    : isInner
    ? record.outer?.trackInventory ?? false
    : record.trackInventory ?? false;

  switch (type) {
    case SALES_INFO_TYPE.COMBINED:
      // inner는 무조건 n/a, outer는 trackInventory가 false일 때 n/a
      return isInner || !trackInventory;

    case SALES_INFO_TYPE.SEPARATED:
      // inner에서 canSaleByInner가 false일 때만 n/a
      return isInner && !canSaleByInner;

    case SALES_INFO_TYPE.PRODUCT_STATUS:
    case SALES_INFO_TYPE.STOCK_STATUS:
      // inner: trackInventory true면 n/a
      // outer: trackInventory false면 n/a
      return isInner ? trackInventory : !trackInventory;

    default:
      return false;
  }
};
</file>

