interface HqReqBossProductListViewWrapperProps extends RouteComponentProps<any> {
  isItFirstLoad: boolean;
  setIsItFirstLoad: React.Dispatch<React.SetStateAction<boolean>>;
}

const HqReqBossProductListViewWrapper: React.FC<HqReqBossProductListViewWrapperProps> = ({
  location,
  isItFirstLoad,
  setIsItFirstLoad,
}) => {
  const qs = parseQs(location.search.substr(1));
  const params: ReqBossProductListViewUrlQueryParams = qs;

  return <HqReqBossProductListView params={params} isItFirstLoad={isItFirstLoad} setIsItFirstLoad={setIsItFirstLoad} />;
};

const HqReqBossProductCreateViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: HqReqBossProductCreateViewUrlQueryParams = qs;
  return <HqReqBossProductCreateView params={params} />;
};

interface HqReqBossProductDetailsViewRouteProps {
  id: string;
}
const HqReqBossProductDetailsViewWrapper: React.FC<RouteComponentProps<HqReqBossProductDetailsViewRouteProps>> = ({
  match,
  location,
}) => {
  const id = decodeURIComponent(match.params.id);
  const qs = parseQs(location.search.substr(1));
  const params: ReqBossProductDetailsViewUrlQueryParams = qs;
  return <ReqBossProductDetailsView id={id} params={params} />;
};

export const HqReqBossProductSection = () => {
  const [isItFirstLoad, setIsItFirstLoad] = useState<boolean>(true);

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.hqRequestProduct} />
      <Switch>
        {hqReqBossProductUrlList.map((url) => (
          <Route
            key={url.path}
            exact
            path={url.path}
