<file path="src/app/providers/AuthProvider/AuthProvider.tsx">
import { ApolloClient, useApolloClient, useMutation } from "@apollo/client";
import { ExtraDataModeEnum } from "@assets/constants/config";
import { UserContext } from "@hooks/useUser";
import { useWebViewMessageHandler } from "@hooks/useWebViewMessageHandler";
import { User } from "@src/api/fragments/types/User";
import { RequestOriginTypeEnum } from "@src/api/types/globalTypes";
import {
  MobileDeviceUpdateOrCreate,
  MobileDeviceUpdateOrCreateVariables,
} from "@src/app/views/auth/api/types/MobileDeviceUpdateOrCreate";
import { IRootState } from "@src/global/redux/config/configStore";
import { MenuModeForHq } from "@src/global/redux/reducer/common.reducer";
import { menuModeForHqChange, menuModeForHqDelete } from "@src/global/redux/store/common.store";
import { dashboardBuildNumber } from "@utils/buildNumber";
import {
  isSupported as isCredentialsManagementAPISupported,
  login as loginWithCredentialsManagementAPI,
  saveCredentials,
} from "@utils/credentialsManagement";
import {
  checkIsEnableForB2bServiceByBrand,
  checkIsEnableForLinkersServiceByBrand,
  checkIsEnableForOnlyLinkersServiceByBrand,
  DeepPartial,
  getMutationStatus,
} from "@utils/misc";
import { showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { sendMessageToWebView } from "@utils/webView";
import _ from "lodash";
import React, { useContext, useEffect, useRef, useState } from "react";
import { useDispatch, useSelector } from "react-redux";

import {
  mobileDeviceUpdateOrCreateMutation,
  tokenAuthMutation,
  tokenRefreshMutation,
  tokenVerifyMutation,
} from "../../views/auth/api/mutations";
import { RefreshToken, RefreshTokenVariables } from "../../views/auth/api/types/RefreshToken";
import { TokenAuth, TokenAuthVariables } from "../../views/auth/api/types/TokenAuth";
import { VerifyToken, VerifyTokenVariables } from "../../views/auth/api/types/VerifyToken";
import { getTokens, isPersistTokenMode, removeTokens, setAuthToken, setTokens } from "../../views/auth/utils";

export function useAuthProvider(apolloClient: ApolloClient<any>) {
  const [userContext, setUserContext] = useState<undefined | User>(undefined);
  const autologinPromise = useRef<Promise<any>>();
  const refreshPromise = useRef<Promise<boolean>>();
  const dispatchRedux = useDispatch();
  const menuModeForHq = useSelector<IRootState, MenuModeForHq>((state) => state.common.menuModeForHq);

  const logout = () => {
    setUserContext(undefined);
    if (isCredentialsManagementAPISupported) {
      if (process.env.NODE_ENV === "production" || process.env.NODE_ENV === "staging") {
        navigator.credentials.preventSilentAccess();
      }
    }
    dispatchRedux(menuModeForHqDelete());
    removeTokens();
  };

  const [tokenAuth, tokenAuthResult] = useMutation<TokenAuth, TokenAuthVariables>(tokenAuthMutation, {
    client: apolloClient,
    onCompleted: (result) => {
      if (result.tokenCreate.errors.length > 0) {
        showNotificationError(result?.tokenCreate?.errors[0].message);
        logout();
      }

      const user = result.tokenCreate.user;

      // FIXME: Now we set state also when auth fails and returned user is
      // `null`, because the LoginView uses this `null` to display error.
      setUserContext(user);
      if (user) {
        const allowedLogin = user.isStaff || user.isHqStaff || user.isSuperuser || user.isVendorStaff;
        if (!allowedLogin) {
          logout();
          showNotificationError("관리자 페이지 접근 권한이 없습니다. 문제가 계속되는 경우 고객센터에 문의해 주세요.");
          return;
        }

        const persistToken = isPersistTokenMode(user);
        setTokens(result.tokenCreate.token, result.tokenCreate.csrfToken, persistToken);
      }
    },
    onError: (error) => {
      console.warn("login error", error.message);
      showNotificationError("관리자 페이지 접근 권한이 없습니다. 문제가 계속되는 경우 고객센터에 문의해 주세요.");
      logout();
    },
  });
  const [tokenRefresh] = useMutation<RefreshToken, RefreshTokenVariables>(tokenRefreshMutation, {
    client: apolloClient,
    onError: (error) => {
      console.warn("tokenRefresh error", error.message);
      showNotificationError(
        "로그인에 실패했습니다. 캐시 삭제 후 다시 시도해 주세요. 문제가 계속되는 경우 고객센터에 문의해 주세요."
      );
      logout();
    },
  });
  const [tokenVerify, tokenVerifyResult] = useMutation<VerifyToken, VerifyTokenVariables>(tokenVerifyMutation, {
    client: apolloClient,
    onCompleted: (result) => {
      if (result.tokenVerify === null) {
        logout();
      } else {
        const user = result.tokenVerify?.user;

        if (!!user) {
          setUserContext(user);
        }
      }
    },
    onError: (error) => {
      console.warn("tokenVerify error", error.message);
      showNotificationError(
        "로그인에 실패했습니다. 캐시 삭제 후 다시 시도해 주세요. 문제가 계속되는 경우 고객센터에 문의해 주세요."
      );
      logout();
    },
  });
  const [mobileDeviceUpdateOrCreate] = useMutation<MobileDeviceUpdateOrCreate, MobileDeviceUpdateOrCreateVariables>(
    mobileDeviceUpdateOrCreateMutation,
    { client: apolloClient }
  );

  const tokenAuthOpts = {
    ...tokenAuthResult,
    status: getMutationStatus(tokenAuthResult),
  };
  const tokenVerifyOpts = {
    ...tokenVerifyResult,
    status: getMutationStatus(tokenVerifyResult),
  };

  useEffect(() => {
    const token = getTokens().auth;
    if (!!token && !userContext) {
      autologinPromise.current = tokenVerify({ variables: { token } });
    } else {
      autologinPromise.current = loginWithCredentialsManagementAPI(login);
    }
  }, []);

  useEffect(() => {
    if (utils.isEmpty(userContext) === false) {
      const { isStaff, isHqStaff, brand } = userContext;
      if (isStaff && !utils.isEmpty(brand?.id)) {
        showNotificationWarn(
          `현재 로그인한 계정이 [${brand?.name}] 브랜드 매장 계정으로 선택되어 있습니다. 보스몰에 로그인해서 초기화해주시길 바랍니다.`
        );
      }

      if (isHqStaff) {
        const enableForOnlyLinkersService = checkIsEnableForOnlyLinkersServiceByBrand(brand);
        const enableForLinkersService = checkIsEnableForLinkersServiceByBrand(brand);
        const enableForB2bService = checkIsEnableForB2bServiceByBrand(brand);
        if (enableForB2bService) {
          dispatchRedux(menuModeForHqChange("b2b"));
        } else if (enableForOnlyLinkersService || (enableForLinkersService && menuModeForHq === "linkers")) {
          dispatchRedux(menuModeForHqChange("linkers"));
        } else {
          dispatchRedux(menuModeForHqChange("boss"));
        }
      }
    }
  }, [userContext]);

  const login = async (loginId: string, password: string) => {
    const extraData = utils.makeUserExtraData(ExtraDataModeEnum.login);
    const createTokenInput: TokenAuthVariables = {
      loginId,
      password,
      requestOrigin: RequestOriginTypeEnum.DASHBOARD,
      dashboardBuildNumber,
      extraData,
    };
    const result = await tokenAuth({
      variables: createTokenInput,
    });

    if (result && !result.data.tokenCreate.errors.length) {
      saveCredentials(result.data.tokenCreate.user, password);

      return result.data.tokenCreate.user;
    }

    return null;
  };

  const loginByToken = (auth: string, refresh: string, user: User) => {
    const persistToken = isPersistTokenMode(user);

    setUserContext(user);
    setTokens(auth, refresh, persistToken);
  };

  const refreshToken = (): Promise<boolean> => {
    if (!!refreshPromise.current) {
      return refreshPromise.current;
    }

    return new Promise((resolve) => {
      const token = getTokens().refresh;

      return tokenRefresh({ variables: { token } }).then((refreshData) => {
        if (!!refreshData.data.tokenRefresh?.token) {
          const persistToken = isPersistTokenMode(userContext);

          setAuthToken(refreshData.data.tokenRefresh.token, persistToken);
          return resolve(true);
        }

        return resolve(false);
      });
    });
  };

  // 기존의 userContext중에서 userPartialData에 존재하는 값들은 해당 값으로 Update한다. 재귀적 병합.
  const updateUser = (userPartialData: DeepPartial<User>) => {
    setUserContext((prevUser) => {
      if (!prevUser) {
        return undefined;
      }

      return _.merge({}, prevUser, userPartialData);
    });
  };

  const updateOrCreateMobileDevice = (deviceId: string, fcmToken: string) =>
    mobileDeviceUpdateOrCreate({
      variables: {
        input: {
          deviceId,
          fcmToken,
        },
      },
    });

  return {
    autologinPromise,
    login,
    loginByToken,
    logout,
    refreshToken,
    tokenAuthOpts,
    tokenVerifyOpts,
    userContext,
    updateUser,
    updateOrCreateMobileDevice,
  };
}

interface AuthProviderProps {
  children: React.ReactNode;
}

const AuthProvider: React.FC<AuthProviderProps> = ({ children }) => {
  const apolloClient = useApolloClient();
  const isWebView = utils.checkWebView();

  const {
    login,
    loginByToken,
    logout,
    tokenAuthOpts,
    refreshToken,
    tokenVerifyOpts,
    userContext,
    updateUser,
    updateOrCreateMobileDevice,
  } = useAuthProvider(apolloClient);

  useEffect(() => {
    if (isWebView && !utils.isEmpty(userContext?.id)) {
      sendMessageToWebView("REQ_MOBILE_DEVICE_INFO", null);
    }
  }, [userContext?.id]);

  useWebViewMessageHandler({
    handlers: {
      MOBILE_DEVICE_INFO: (value) => {
        const mobileDeviceInfo = utils.jsonParseWrapper(value);
        const { deviceId, fcmToken } = mobileDeviceInfo;
        updateOrCreateMobileDevice(deviceId, fcmToken);
      },
    },
  });

  return (
    <UserContext.Provider
      value={{
        login,
        loginByToken,
        logout,
        tokenAuthLoading: tokenAuthOpts.loading,
        tokenRefresh: refreshToken,
        tokenVerifyLoading: tokenVerifyOpts.loading,
        user: userContext,
        updateUser,
        updateOrCreateMobileDevice,
      }}
    >
      {children}
    </UserContext.Provider>
  );
};

export const useAuth = () => {
  const user = useContext(UserContext);
  const isAuthenticated = !!user.user;

  return {
    hasToken: !!getTokens(),
    isAuthenticated,
    tokenAuthLoading: user.tokenAuthLoading,
    tokenVerifyLoading: user.tokenVerifyLoading,
    user: user.user,
  };
};

export default AuthProvider;
</file>

