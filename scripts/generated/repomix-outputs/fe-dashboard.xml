import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { useSimpleBrandQuery } from "@src/app/views/brand/brands/api/queries";
import { useSimpleVendorQuery } from "@src/app/views/purchase/vendors/api/queries";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { useFbvPurchaseCostEventListFilterDownloadQuery, useFbvPurchaseCostEventListQuery } from "../../api/queries";
import { FbvPurchaseCostEventListVariables } from "../../api/types/FbvPurchaseCostEventList";
import { FbvPurchaseCostEventCreateModal } from "../../components/FbvPurchaseCostEventCreateModal";
import { FulfilledByVendorPurchaseCostEventListPage } from "../../components/FulfilledByVendorPurchaseCostEventListPage/FulfilledByVendorPurchaseCostEventListPage";
import {
  brandFulfilledByVendorPurchaseCostEventListViewUrl,
  fulfilledByVendorPurchaseCostEventListViewUrl,
  FulfilledByVendorPurchaseCostEventListViewUrlDialog,
  FulfilledByVendorPurchaseCostEventListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface FulfilledByVendorPurchaseCostEventListViewProps {
  vendor?: string;
  brand?: string;
  defaultParams: FulfilledByVendorPurchaseCostEventListViewUrlQueryParams;
  params: FulfilledByVendorPurchaseCostEventListViewUrlQueryParams;
}

export const FulfilledByVendorPurchaseCostEventListView: React.FC<FulfilledByVendorPurchaseCostEventListViewProps> = ({
  vendor: vendorId,
  brand: brandId,
  defaultParams,
  params,
}) => {
  const { user } = useUser();
  const brand = user?.brand;
  const vendor = user?.vendor;
  const isHqStaff = user?.isHqStaff;
  const targetUrl = (params?: FulfilledByVendorPurchaseCostEventListViewUrlQueryParams) =>
    isHqStaff
      ? fulfilledByVendorPurchaseCostEventListViewUrl(vendorId, params)
      : brandFulfilledByVendorPurchaseCostEventListViewUrl(brandId, params);
  const { navigate, paginate, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.FULFILLED_BY_VENDOR_PURCHASE_COST_EVENT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useFbvPurchaseCostEventListFilterDownloadQuery);

  const { data: simpleVendorData, loading: simpleVendorLoading } = useSimpleVendorQuery({
    skip: !isHqStaff,
    variables: { id: isHqStaff ? vendorId : vendor.id },
  });
  const simpleVendor = simpleVendorData?.vendor;

  const { data: simpleBrandData, loading: simpleBrandLoading } = useSimpleBrandQuery({
    skip: isHqStaff,
    variables: { id: isHqStaff ? brand?.id : brandId },
  });
  const simpleBrand = simpleBrandData?.brand;

  // NOTE: 잔액 수정 시, 최신 이벤트의 현재 잔액 정보를 모달에 전달하기 위해 first = 1로 추가 쿼리 호출
  const { data: latestEventData, loading: latestEventLoading } = useFbvPurchaseCostEventListQuery({
    skip: !brandId || !vendorId,
    variables: {
      first: 1,
      filter: {
        brand: isHqStaff ? brand?.id : brandId,
        vendor: isHqStaff ? vendorId : vendor.id,
      },
    },
  });
  const latestFulfilledByVendorPurchaseCostEvent = maybe(
    () => latestEventData.fbvPurchaseCostEvents.edges.map((edge) => edge.node)[0],
    null
  );

  const queryVariables: FbvPurchaseCostEventListVariables = React.useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.commonMaxLimit,
      filter: {
        ...getFilterVariables(params),
        brand: isHqStaff ? brand?.id : brandId,
        vendor: isHqStaff ? vendorId : vendor.id,
      },
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useFbvPurchaseCostEventListQuery({
    skip: !brandId || !vendorId,
    variables: queryVariables,
  });
  const fbvPurchaseCostEvent = maybe(() => data?.fbvPurchaseCostEvents.edges.map((edge) => edge.node), []);

  const { queryVariablesWithoutPagination } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.fbvPurchaseCostEvents?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    FulfilledByVendorPurchaseCostEventListViewUrlDialog,
    FulfilledByVendorPurchaseCostEventListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const pageLoading = simpleVendorLoading || simpleBrandLoading || latestEventLoading || loading;

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.fbv} />
      <FulfilledByVendorPurchaseCostEventListPage
        vendor={simpleVendor}
        brand={simpleBrand}
        disabled={pageLoading}
        fbvPurchaseCostEvent={fbvPurchaseCostEvent}
        onCreateFbvPurchaseCostEvent={(action) => openModal(action)}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        isHqStaff={isHqStaff}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <FbvPurchaseCostEventCreateModal
        open={[
          "create-fbv-purchase-cost-settlement",
          "create-fbv-purchase-cost-increase",
          "create-fbv-purchase-cost-decrease",
        ].includes(params.action)}
        loading={loading}
        action={params.action}
        brand={brand}
        vendor={simpleVendor}
        remainAmount={latestFulfilledByVendorPurchaseCostEvent?.amountAfter}
        onClose={closeModal}
        isHqStaff={isHqStaff}
      />
    </>
  );
};
</file>

