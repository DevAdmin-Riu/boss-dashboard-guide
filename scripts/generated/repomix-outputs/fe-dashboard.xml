  WarehouseDetailsViewUrlDialog,
  WarehouseDetailsViewUrlQueryParams,
} from "@src/app/views/settings/warehouses/urls";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import { getMutationStatus } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Modal } from "antd";
import React, { useCallback, useMemo } from "react";

import { configurationSectionUrl } from "../../../configuration";

interface WarehouseDetailsViewProps {
  id: string;
  params: WarehouseDetailsViewUrlQueryParams;
}

export const WarehouseDetailsView: React.FC<WarehouseDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const [openModal, closeModal] = createDialogActionHandlers<
    WarehouseDetailsViewUrlDialog,
    WarehouseDetailsViewUrlQueryParams
  >(navigate, (params) => warehouseDetailsViewUrl(id, params), params);
  const memoizedOpenModal = useCallback(openModal, []);

  const { data, loading } = useWarehouseDetails({ variables: { id } });

  const { data: rackSectorData, loading: rackSectorLoading } = useRackSectorListQuery({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.rackSectors },
  });
  // 배열 타입의 데이터가 props로 전달될 때는 새로운 참조로 인식되어 렌더링이 발생하므로 useMemo를 사용하여 최적화
  const rackSectors = useMemo(() => rackSectorData?.rackSectors.edges.map((edge) => edge.node) || [], [rackSectorData]);
  const selectedRackSector = rackSectors.find((sector) => sector.id === params?.rackSectorId);
  const selectedRackLocation = selectedRackSector?.locations.find((location) => location.id === params?.rackLocationId);
  const selectedWarehouseAddress = data?.warehouse?.addresses.find(
    (address) => address.id === params?.warehouseAddressId
  );
  const warehouseAddresses = data?.warehouse?.addresses || [];

  const [updateWarehouse, updateWarehouseOpts] = useWarehouseUpdateMutation({
    onCompleted: (data) => {
      const errors = data.updateWarehouse.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  const updateWarehouseTransitionState = getMutationStatus(updateWarehouseOpts);

  const [addRackSector, addRackSectorOpts] = useAddRackSectorMutation({
    onCompleted: (data) => {
      const errors = data.addRackSector?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("구역이 추가되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [rackSectorListQuery, warehouseDetailsQuery],
  });

  const [updateRackSector, updateRackSectorOpts] = useUpdateRackSectorMutation({
    onCompleted: (data) => {
      const errors = data.updateRackSector?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("구역 정보가 변경되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [rackSectorListQuery, warehouseDetailsQuery],
  });

  const [deleteRackSector, deleteRackSectorOpts] = useDeleteRackSectorMutation({
    onCompleted: (data) => {
      const errors = data.deleteRackSector?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 구역이 삭제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [rackSectorListQuery, warehouseDetailsQuery],
  });

  const [addRackLocation, addRackLocationOpts] = useAddRackLocationMutation({
    onCompleted: (data) => {
      const errors = data.addRackLocation?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("로케이션이 추가되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [rackSectorListQuery],
  });

  const [updateRackLocation, updateRackLocationOpts] = useUpdateRackLocationMutation({
    onCompleted: (data) => {
      const errors = data.updateRackLocation?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("로케이션 정보가 변경되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [deleteRackLocation, deleteRackLocationOpts] = useDeleteRackLocationMutation({
    onCompleted: (data) => {
      const errors = data.deleteRackLocation?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 로케이션이 삭제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [rackSectorListQuery],
  });

  const [createWarehouseAddress, createWarehouseAddressOpts] = useWarehouseAddressCreateMutation({
    onCompleted: (data) => {
      const errors = data.warehouseAddressCreate?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("물류센터 주소가 추가되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [warehouseDetailsQuery],
  });

  const [updateWarehouseAddress, updateWarehouseAddressOpts] = useWarehouseAddressUpdateMutation({
    onCompleted: (data) => {
      const errors = data.warehouseAddressUpdate?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("물류센터 주소 정보가 변경되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [warehouseDetailsQuery],
  });

  const [deleteWarehouseAddress, deleteWarehouseAddressOpts] = useWarehouseAddressDeleteMutation({
    onCompleted: (data) => {
      const errors = data.warehouseAddressDelete?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 물류센터 주소가 삭제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [warehouseDetailsQuery],
  });

  if (data?.warehouse === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={() => navigate(configurationSectionUrl)} />;
  }

  const handleSubmit = async (data: WarehouseDetailsPageFormData) => {
    const result = await updateWarehouse({
      variables: {
        id,
        input: {
          name: data.name,
        },
      },
    });

    return result.data.updateWarehouse.errors;
  };

  const disabled =
    loading ||
    rackSectorLoading ||
    updateWarehouseOpts.loading ||
    addRackSectorOpts.loading ||
    updateRackSectorOpts.loading ||
    deleteRackSectorOpts.loading ||
    addRackLocationOpts.loading ||
    updateRackLocationOpts.loading ||
    deleteRackLocationOpts.loading ||
    createWarehouseAddressOpts.loading ||
    updateWarehouseAddressOpts.loading ||
    deleteWarehouseAddressOpts.loading;

  return (
    <>
      <WindowTitle title={data?.warehouse?.name} />
      <WarehouseDetailsPage
        disabled={disabled}
        errors={updateWarehouseOpts.data?.updateWarehouse.errors || []}
        saveButtonBarState={updateWarehouseTransitionState}
        warehouse={data?.warehouse}
        rackSectors={rackSectors}
        onBack={() => navigate(configurationSectionUrl)}
        openModal={memoizedOpenModal}
        onSubmit={handleSubmit}
      />
      <RackSectorAddOrUpdateModal
        open={params.action === "add-rack-sector" || params.action === "update-rack-sector"}
        loading={disabled}
        isUpdateMode={params.action === "update-rack-sector"}
        rackSector={selectedRackSector}
        warehouseAddresses={warehouseAddresses}
        onSubmit={(input) => {
          if (params.action === "add-rack-sector") {
            addRackSector({ variables: { input } });
          } else {
            updateRackSector({ variables: { id: selectedRackSector?.id, input } });
          }
        }}
        onClose={closeModal}
      />
      <Modal
        open={params.action === "delete-rack-sector"}
        title="구역 삭제"
        okType="danger"
        okText="삭제"
        onOk={() => deleteRackSector({ variables: { id: selectedRackSector?.id } })}
        onCancel={closeModal}
        okButtonProps={{ disabled: loading }}
        cancelButtonProps={{ disabled: loading }}
      >
        구역 [{selectedRackSector?.name}]을/를 정말 삭제하시겠습니까?
      </Modal>
      <RackLocationAddOrUpdateModal
        open={params.action === "add-rack-location" || params.action === "update-rack-location"}
        loading={disabled}
        isUpdateMode={params.action === "update-rack-location"}
        rackSector={selectedRackSector}
        rackLocation={selectedRackLocation}
        onSubmit={(input) => {
          if (params.action === "add-rack-location") {
            addRackLocation({ variables: { input: { ...input, sector: selectedRackSector?.id } } });
          } else {
            updateRackLocation({ variables: { id: selectedRackLocation?.id, input } });
          }
        }}
        onClose={closeModal}
      />
      <Modal
        open={params.action === "delete-rack-location"}
        title="로케이션 삭제"
        okType="danger"
        okText="삭제"
        onOk={() => deleteRackLocation({ variables: { id: selectedRackLocation.id } })}
        onCancel={closeModal}
        okButtonProps={{ disabled: loading }}
        cancelButtonProps={{ disabled: loading }}
      >
        로케이션 [{selectedRackLocation?.name}]을/를 정말 삭제하시겠습니까?
      </Modal>
      <WarehouseAddressModal
        open={params.action === "add-warehouse-address" || params.action === "update-warehouse-address"}
        loading={disabled}
        isUpdateMode={params.action === "update-warehouse-address"}
        address={selectedWarehouseAddress}
        onSubmit={(input) => {
          if (params.action === "add-warehouse-address") {
            createWarehouseAddress({ variables: { warehouseId: id, input } });
          } else if (selectedWarehouseAddress?.id) {
            updateWarehouseAddress({ variables: { id: selectedWarehouseAddress.id, input } });
          }
        }}
        onClose={closeModal}
      />
      <Modal
        open={params.action === "delete-warehouse-address"}
        title="물류센터 주소 삭제"
        okType="danger"
        okText="삭제"
        onOk={() => deleteWarehouseAddress({ variables: { id: selectedWarehouseAddress?.id } })}
        onCancel={closeModal}
        okButtonProps={{ disabled: loading }}
        cancelButtonProps={{ disabled: loading }}
      >
        물류센터 주소 [{selectedWarehouseAddress?.companyName || "이 주소"}]를 정말 삭제하시겠습니까?
      </Modal>
    </>
  );
};
</file>

