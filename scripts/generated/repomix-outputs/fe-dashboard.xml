import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { asSortParams } from "@utils/sort";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  pluginDetailsViewPath,
  PluginDetailsViewUrlQueryParams,
  pluginListViewPath,
  PluginListViewUrlQueryParams,
  PluginListViewUrlSortField,
} from "./urls";
import { PluginsListView } from "./views/PluginListView/PluginListView";
import { PluginsDetailsView } from "./views/PluginsDetails";

const PluginListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: PluginListViewUrlQueryParams = asSortParams(qs, PluginListViewUrlSortField);
  return <PluginsListView params={params} />;
};

const PageDetailsViewWrapper: React.FC<RouteComponentProps<any>> = ({ match }) => {
  const qs = parseQs(location.search.substr(1));
  const params: PluginDetailsViewUrlQueryParams = qs;

  return <PluginsDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

const PluginsSection = () => (
  <>
    <WindowTitle title={sectionNames.plugins} />
    <Switch>
      <Route exact path={pluginListViewPath} component={PluginListViewWrapper} />
      <Route path={pluginDetailsViewPath(":id")} component={PageDetailsViewWrapper} />
    </Switch>
  </>
);

export default PluginsSection;
</file>

