  TaxInvoiceList_taxInvoiceList_edges_node,
  TaxInvoiceListVariables,
} from "../../api/types/TaxInvoiceList";
import { HqTaxInvoiceUrlTypeEnum } from "../../urls";
import { createFilterStructure, TaxInvoiceFilterKeys, TaxInvoiceListFilterOpts } from "./filter";
import getTaxInvoiceTableSetting from "./TaxInvoiceTableSetting";

interface TaxInvoiceListPageProps
  extends PaginateListProps,
    FilterPageProps<TaxInvoiceFilterKeys, TaxInvoiceListFilterOpts> {
  orderType: OrderType;
  hqUrlType: HqTaxInvoiceUrlTypeEnum;
  taxInvoices: TaxInvoiceList_taxInvoiceList_edges_node[];
  isStaff: boolean;
  queryVariablesWithoutPagination: TaxInvoiceListVariables;
  fetchForDownload: (variables?: TaxInvoiceListVariables) => Promise<ApolloQueryResult<TaxInvoiceList>>;
}

const TaxInvoiceListPage: React.FC<TaxInvoiceListPageProps> = (props) => {
  const {
    orderType,
    hqUrlType,
    currentTab,
    filterOpts,
    tabs,
    taxInvoices,
    isStaff,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, orderType, isStaff);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const columns = getTaxInvoiceTableSetting({ isStaff });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "taxInvoiceList",
  };

  const pageTitle = isStaff
    ? orderType === OrderType.BY_USER
      ? sectionNames.taxInvoiceRegular
      : sectionNames.taxInvoiceAgency
    : hqUrlType === HqTaxInvoiceUrlTypeEnum.PURCHASE
    ? sectionNames.hqTaxInvoicePurchase
    : sectionNames.hqTaxInvoiceSales;

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={props.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <TableVatLegend isIncludeVat={false} />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={props.disabled}
          columns={pickerSelectedColumns}
          dataSource={taxInvoices}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...props} />}
        />
      </Card>
    </Space>
  );
};

export default TaxInvoiceListPage;
</file>

