        value={isUpdate && props.template.title}
        editMode={isEditMode}
      />
      <EditableField
        type="textarea"
        name={TypeSafeForm.getValidDataIndex("description")}
        label="설명"
        rules={[{ required: true, message: formRuleMsg.required }]}
        value={isUpdate && props.template.description}
        editMode={isEditMode}
        rows={4}
      />
    </Card>
  );
};
