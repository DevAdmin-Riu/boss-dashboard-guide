<file path="src/app/components/SaveButtonBar/AntdSaveButtonBar.tsx">
import useWindowScroll from "@hooks/useWindowScroll";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { Affix, Button, Card, Col, Row, Space } from "antd";
import React, { useEffect } from "react";

import { useAppAction } from "../AppLayout/AppActionContext";
import { ConfirmButtonTransitionState } from "../ConfirmButton/ConfirmButton";

export interface ISaveButtonBarLabels {
  delete?: string;
  cancel?: string;
  reset?: string;
  save?: string;
}

interface AntdSaveButtonBarProps {
  disabled: boolean;
  state: ConfirmButtonTransitionState;
  labels?: ISaveButtonBarLabels;
  onCancel?: () => void;
  onDelete?: () => void;
  onReset?: () => void;
  onSave?: (event: any) => void;
}

const AntdSaveButtonBar: React.FC<AntdSaveButtonBarProps> = (props) => {
  const { disabled, state, labels, onCancel, onDelete, onReset, onSave } = props;
  const { anchor, docked, setDocked } = useAppAction();
  const scrollPosition = useWindowScroll();
  const loading = state === "loading";

  useEffect(() => {
    setDocked(disabled || loading);
  }, [disabled, state]);

  useEffect(
    () => () => {
      setDocked(true);
    },
    []
  );

  const scrolledToBottom =
    window.innerHeight === document.body.scrollHeight ||
    Math.ceil(scrollPosition.y + window.innerHeight) >= document.body.scrollHeight;

  return anchor ? (
    <Affix ref={() => anchor.current} style={{ marginTop: 24 }} offsetBottom={0}>
      <Card
        bordered
        style={
          scrolledToBottom
            ? null
            : {
                borderTopLeftRadius: 10,
                borderTopRightRadius: 10,
                boxShadow: "0 -2px 8px rgba(0, 0, 0, 0.3)",
              }
        }
      >
        <Row justify="space-between">
          <Col>
            {!!onDelete && (
              <Button danger size="large" type="primary" disabled={docked} loading={loading} onClick={onDelete}>
                {labels?.delete || buttonText.delete}
              </Button>
            )}
          </Col>
          <Col>
            <Space size="large">
              {!!onCancel && (
                <Button size="large" type="default" onClick={onCancel}>
                  {labels?.cancel || buttonText.back}
                </Button>
              )}
              {!!onReset && (
                <Button size="large" type="default" onClick={onReset}>
                  {labels?.reset || buttonText.reset}
                </Button>
              )}
              {!!onSave && (
                <Button size="large" type="primary" disabled={docked} loading={loading} onClick={onSave}>
                  {labels?.save || buttonText.save}
                </Button>
              )}
            </Space>
          </Col>
        </Row>
      </Card>
    </Affix>
  ) : null;
};
export default AntdSaveButtonBar;
</file>

<file path="src/app/components/SaveButtonBar/FormSaveButton.tsx">
import { Button, Form, FormInstance, Space } from "antd";
import React from "react";

export interface FormSaveButtonEditModeProps {
  isEditMode: boolean;
  loading?: boolean;
  onEdit: () => void;
  onCancel: () => void;
  buttonText?: {
    edit?: string;
    cancel?: string;
    save?: string;
  };
}

interface FormSaveButtonProps<T> extends FormSaveButtonEditModeProps {
  form: FormInstance<T>;
}

// NOTE: Form 안에서 사용되어야 form.isFieldsTouched()가 동작함.
export const FormSaveButton = <T,>(props: FormSaveButtonProps<T>) => {
  const { form, loading, isEditMode, onEdit, onCancel, buttonText } = props;

  return isEditMode ? (
    <Form.Item noStyle shouldUpdate>
      {() => (
        <Space>
          <Button
            type="default"
            onClick={(event) => {
              event.stopPropagation();
              onCancel();
              form.resetFields();
            }}
          >
            {buttonText?.cancel || "취소"}
          </Button>
          <Button
            type="primary"
            loading={loading}
            disabled={!form.isFieldsTouched()}
            onClick={(event) => {
              event.stopPropagation();
              form.submit();
            }}
          >
            {buttonText?.save || "저장"}
          </Button>
        </Space>
      )}
    </Form.Item>
  ) : (
    <Button
      type="primary"
      onClick={(event) => {
        event.stopPropagation();
        onEdit();
      }}
    >
      {buttonText?.edit || "수정"}
    </Button>
  );
};
</file>

