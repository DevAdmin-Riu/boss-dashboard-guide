<file path="src/app/views/settings/shipping/views/ShippingZoneDetailsView/data.ts">
import { ShippingMethodTypeEnum } from "@src/api/types/globalTypes";
import { ShippingZoneDetailsViewUrlQueryParams } from "@src/app/views/settings/shipping/urls";

import { ShippingRateCreateVariables } from "../../api/types/ShippingRateCreate";
import { ShippingRateUpdateVariables } from "../../api/types/ShippingRateUpdate";
import { ShippingZoneDetails_shippingZone_shippingMethods } from "../../api/types/ShippingZoneDetails";
import { IShippingZoneRateForm } from "../../components/ShippingZoneRateDialog";

function getValue(value: number, noLimits: boolean): number | null {
  return noLimits ? null : value;
}

export function getShippingRateCreateVariables(
  data: IShippingZoneRateForm,
  params: ShippingZoneDetailsViewUrlQueryParams,
  id: string
): ShippingRateCreateVariables {
  return {
    input: {
      maximumOrderPrice: params.type === ShippingMethodTypeEnum.PRICE ? getValue(data.maxValue, data.noLimits) : null,
      maximumOrderWeight: params.type === ShippingMethodTypeEnum.WEIGHT ? getValue(data.maxValue, data.noLimits) : null,
      minimumOrderPrice: params.type === ShippingMethodTypeEnum.PRICE ? getValue(data.minValue, data.noLimits) : null,
      minimumOrderWeight: params.type === ShippingMethodTypeEnum.WEIGHT ? getValue(data.minValue, data.noLimits) : null,
      name: data.name,
      price: data.isFree ? 0 : data.price,
      shippingZone: id,
      type: params.type,
    },
  };
}

export function getShippingRateUpdateVariables(
  data: IShippingZoneRateForm,
  shippingMethod: ShippingZoneDetails_shippingZone_shippingMethods,
  shippingZoneId: string
): ShippingRateUpdateVariables {
  const base: ShippingRateUpdateVariables = {
    id: shippingMethod.id,
    input: {
      name: data.name,
      price: data.isFree ? 0 : data.price,
      shippingZone: shippingZoneId,
      type: shippingMethod.type,
    },
  };

  if (shippingMethod.type === ShippingMethodTypeEnum.PRICE) {
    return {
      ...base,
      input: {
        ...base.input,
        maximumOrderPrice: getValue(data.maxValue, data.noLimits),
        minimumOrderPrice: getValue(data.minValue, data.noLimits),
      },
    };
  }

  return {
    ...base,
    input: {
      ...base.input,
      maximumOrderWeight: getValue(data.maxValue, data.noLimits),
      minimumOrderWeight: getValue(data.minValue, data.noLimits),
    },
  };
}
