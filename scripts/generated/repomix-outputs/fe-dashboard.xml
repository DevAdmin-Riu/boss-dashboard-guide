import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { usePluginsListQuery } from "../../api/queries";
import { PluginsVariables } from "../../api/types/Plugins";
import PluginsListPage from "../../components/PluginsListPage/PluginsListPage";
import {
  pluginDetailsViewUrl,
  pluginListViewUrl,
  PluginListViewUrlDialog,
  PluginListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface PluginsListViewProps {
  params: PluginListViewUrlQueryParams;
}

export const PluginsListView: React.FC<PluginsListViewProps> = ({ params }) => {
  const shop = useShop();
  const { user } = useAuth();
  const targetUrl = pluginListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PLUGIN_LIST,
  });

  const queryVariables: PluginsVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params), sort: getSortQueryVariables(params) }),
    [params, settings?.rowNumber]
  );
  const { data, loading, refetch } = usePluginsListQuery({
    variables: queryVariables,
  });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.plugins?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PluginListViewUrlDialog, PluginListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, pluginListViewUrl, params);
  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  let plugins = maybe(() => data.plugins.edges.map((edge) => edge.node));
  if (plugins && user.isSuperuser === false) {
    plugins = plugins.filter((node) => node.showInList);
  }

  return (
    <>
      <PluginsListPage
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        disabled={loading}
        filterOpts={getFilterOpts(params)}
        settings={settings}
        plugins={plugins}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAdd={() => navigate(configurationSectionUrl)}
        onAll={resetFilters}
        onBack={() => navigate(configurationSectionUrl)}
        onFilterChange={changeFilters}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(pluginDetailsViewUrl(id))}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

