<file path="src/app/views/order/orders/components/FbvOrderFulfillmentTrackingModal/FbvOrderFulfillmentTrackingModal.tsx">
import { MutationFunction } from "@apollo/client";
import { OrderDeliveryMethodsEnum } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import {
  CourierList_couriers_edges,
  CourierList_couriers_edges_node,
} from "@src/app/views/settings/couriers/api/types/CourierList";
import { utils } from "@utils/utils";
import { Form, InputNumber, Modal, Select, Skeleton } from "antd";
import React, { useEffect } from "react";

import {
  FulfillmentBulkUpdateForFbv,
  FulfillmentBulkUpdateForFbvVariables,
} from "../../api/types/FulfillmentBulkUpdateForFbv";
import { FulfillmentList_fulfillments_edges_node } from "../../api/types/FulfillmentList";
const { Option } = Select;

interface FbvOrderFulfillmentTrackingModalProps {
  fulfillment: FulfillmentList_fulfillments_edges_node;
  fulfillmentBulkUpdateForFbvMutation: MutationFunction<
    FulfillmentBulkUpdateForFbv,
    FulfillmentBulkUpdateForFbvVariables
  >;
  couriers: CourierList_couriers_edges[];
  open: boolean;
  loading: boolean;
  onClose(): any;
}

export const FbvOrderFulfillmentTrackingModal: React.FC<FbvOrderFulfillmentTrackingModalProps> = ({
  fulfillment,
  fulfillmentBulkUpdateForFbvMutation,
  couriers,
  open,
  onClose,
  loading,
}) => {
  const [form] = Form.useForm();
  useEffect(() => {
    if (form) {
      form.setFieldsValue({
        courierId: fulfillment?.courier?.id || undefined,
        trackingNumber: fulfillment?.trackingNumber,
      });
    }
  }, [fulfillment]);

  if (!fulfillment) {
    return null;
  }
  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title="송장번호 입력"
      open={open}
      cancelText={"뒤로"}
      okText={"확인"}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={{
          trackingNumber: fulfillment?.trackingNumber,
          courierId: fulfillment?.courier?.id,
        }}
        preserve={false}
        validateTrigger={"onSubmit"}
        layout="vertical"
        name="control-hooks"
        onFinish={(formData) => {
          const { trackingNumber, courierId } = formData;
          return fulfillmentBulkUpdateForFbvMutation({
            variables: {
              input: {
                details: [
                  {
                    orderNumber: Number(fulfillment.order.number),
                    fulfillmentOrder: Number(fulfillment.fulfillmentOrder),
                    deliveryMethod: OrderDeliveryMethodsEnum.BY_COURIER,
                    courierId,
                    trackingNumber,
                  },
                ],
              },
            },
          });
        }}
      >
        <Form.Item name="courierId" label="택배사" rules={[{ required: true }]}>
          {!loading ? (
            <Select
              onSelect={(
                _: string,
                option: {
                  item: CourierList_couriers_edges_node;
                }
              ) => {
                form.setFieldsValue({
                  digitAllowedValues: option.item.digitAllowedValues,
                });
              }}
              placeholder="택배사를 선택해주세요"
            >
              {couriers?.map((item, index) => {
                if (item.node.id === fulfillment?.courier?.id) {
                  form.setFieldsValue({
                    digitAllowedValues: item.node.digitAllowedValues,
                  });
                }
                return (
                  <Option key={index} value={item.node.id} item={item.node}>
                    {item.node.name}
                  </Option>
                );
              })}
            </Select>
          ) : (
            <Skeleton.Input active={true} block={true} />
          )}
        </Form.Item>
        <Form.Item
          noStyle
          shouldUpdate={(prevValues, currentValues) =>
            JSON.stringify(prevValues.digitAllowedValues?.sort()) !==
            JSON.stringify(currentValues.digitAllowedValues?.sort())
          }
        >
          {() => (
            <Form.Item
              name="trackingNumber"
              label="송장번호"
              rules={[
                {
                  required: true,
                  message: "송장번호를 입력해주세요",
                },
                {
                  pattern: utils.makeLenRegex(form.getFieldValue("digitAllowedValues")),
                  message: `${form.getFieldValue("digitAllowedValues")?.join(",")} 자리로 입력해야 합니다`,
                },
              ]}
            >
              {!loading ? (
                <InputNumber
                  {...getInputNumberProps({})}
                  placeholder={"송장번호를 입력해주세요"}
                  onChange={(value) =>
                    form.setFieldsValue({
                      trackingNumber: value,
                    })
                  }
                />
              ) : (
                <Skeleton.Input active={true} block={true} />
              )}
            </Form.Item>
          )}
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/order/orders/components/FulfillmentInspectListPage/filters.ts">
import { IFilter } from "@src/app/components/Filter";
import filterMsg from "@src/global/assets/messages/filters";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateTimeField, createTextField } from "@utils/filters/fields";

export enum FulfillmentInspectFilterKeys {
  deliveryStartDateTime = "deliveryStartDateTime",
  sectorSearch = "sectorSearch",
  locationSearch = "locationSearch",
  isInspectCompleted = "isInspectCompleted",
}

export interface FulfillmentInspectListFilterOpts {
  deliveryStartDateTime: FilterOpts<MinMax>;
  sectorSearch: FilterOpts<string>;
  locationSearch: FilterOpts<string>;
  isInspectCompleted: FilterOpts<boolean>;
}

export function createFilterStructure(opts: FulfillmentInspectListFilterOpts): IFilter<FulfillmentInspectFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createDateTimeField(
        displayOrder++,
        FulfillmentInspectFilterKeys.deliveryStartDateTime,
        filterMsg.deliveryStartDateTime,
        opts.deliveryStartDateTime.value
      ),
      active: opts.deliveryStartDateTime.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        FulfillmentInspectFilterKeys.isInspectCompleted,
        "검수완료 여부",
        opts.isInspectCompleted.value,
        {
          negative: "미완료",
          positive: "완료",
        }
      ),
      active: opts.isInspectCompleted.active,
      isRequired: true,
    },
    {
      ...createTextField(displayOrder++, FulfillmentInspectFilterKeys.sectorSearch, "구역명", opts.sectorSearch.value),
      active: opts.sectorSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        FulfillmentInspectFilterKeys.locationSearch,
        "로케이션명",
        opts.locationSearch.value
      ),
      active: opts.locationSearch.active,
    },
  ];
}
