import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  virtualAccountCreateViewPath,
  virtualAccountDetailsViewPath,
  VirtualAccountDetailsViewUrlQueryParams,
  virtualAccountListViewPath,
  VirtualAccountListViewUrlQueryParams,
} from "./urls";
import { VirtualAccountCreateView } from "./views/VirtualAccountCreateView";
import { VirtualAccountDetailsView } from "./views/VirtualAccountDetailsView";
import { VirtualAccountListView } from "./views/VirtualAccountListView/VirtualAccountListView";

const VirtualAccountListViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: VirtualAccountListViewUrlQueryParams = qs;

  return <VirtualAccountListView params={params} />;
};

interface VirtualAccountDetailsViewRouteProps {
  id: string;
}
const VirtualAccountDetailsViewWrapper: React.FC<RouteComponentProps<VirtualAccountDetailsViewRouteProps>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const params: VirtualAccountDetailsViewUrlQueryParams = qs;

  return <VirtualAccountDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

const VirtualAccountSection = () => (
  <>
    <WindowTitle title={sectionNames.permissionGroups} />
    <Switch>
      <Route exact path={virtualAccountListViewPath} component={VirtualAccountListViewWrapper} />
      <Route exact path={virtualAccountCreateViewPath} component={VirtualAccountCreateView} />
      <Route path={virtualAccountDetailsViewPath(":id")} component={VirtualAccountDetailsViewWrapper} />
