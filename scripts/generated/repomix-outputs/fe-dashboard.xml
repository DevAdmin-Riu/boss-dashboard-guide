const makeTypographyTextIncludeBrTag = (str: string, keySeed: string) => {
  const textAry = str.split("\n");

  const count = textAry.length;
  const retElement = [];

  for (let i = 0; i < count; i++) {
    const text = textAry[i];
    const textElement = <Typography.Text key={keySeed + "Ty" + i}>{text}</Typography.Text>;
    retElement.push(textElement);
    if (i < count - 1) {
      const brElement = <br key={keySeed + "br" + i} />;
      retElement.push(brElement);
    }
  }

  return retElement;
};

const makeNoteLink = (note: string) => {
  if (!note) {
    return "-";
  }

  const validUrls = utils.findValidUrls(note);

  if (!validUrls || validUrls.length <= 0) {
    return makeTypographyTextIncludeBrTag(note, "validUrls");
  }

  const validUrlCount = validUrls.length;

  const retElement = [];

  let eIndex;

  let remainNote = note;

  for (let i = 0; i < validUrlCount; i++) {
    const validUrl = validUrls[i];
    eIndex = remainNote.indexOf(validUrl);
    const linkElement = (
      <Typography.Link key={i} href={validUrl} target="_blank" className="ant-typography-break">
        {validUrl}
      </Typography.Link>
    );
    const urlLength = validUrl.length;

    if (eIndex === 0) {
      retElement.push(linkElement);
      remainNote = remainNote.substr(urlLength);
    } else {
      const text = remainNote.substr(0, eIndex);
      const textElementAry = makeTypographyTextIncludeBrTag(text, "text1");
      retElement.push(...textElementAry);
      retElement.push(linkElement);
      remainNote = remainNote.substr(eIndex + urlLength);
    }
  }

  if (remainNote.length > 0) {
    const textElementAry = makeTypographyTextIncludeBrTag(remainNote, "text2");
    retElement.push(...textElementAry);
  }

  return retElement;
};

