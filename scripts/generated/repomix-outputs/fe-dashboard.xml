import { EditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { Button, Space } from "antd";
import React from "react";

import { BsTrainingTagList_bsTrainingTagList_edges_node } from "../../api/types/BsTrainingTagList";

interface HqTrainingTagTableSettingsProps {
  editingProps: {
    loading: boolean;
    selectedSalesId: string;
    isEditing: (record: BsTrainingTagList_bsTrainingTagList_edges_node) => boolean;
    onEdit: (record: BsTrainingTagList_bsTrainingTagList_edges_node) => void;
    onCancel: () => void;
    onSubmit: (record: BsTrainingTagList_bsTrainingTagList_edges_node) => Promise<void>;
    onDelete: (record: BsTrainingTagList_bsTrainingTagList_edges_node) => Promise<void>;
  };
}

export const getHqTrainingTagTableSettings = (props: HqTrainingTagTableSettingsProps) => {
  const { editingProps } = props;
  const { isEditing, onEdit, onCancel, onSubmit, onDelete } = editingProps;
  const tagNameColumn: EditableColumnType<BsTrainingTagList_bsTrainingTagList_edges_node> = {
    title: "태그명",
    key: "tagName",
    align: "center",
    render: (_, record) => record.name,
    onCell: (record) => {
      if (!editingProps) {
        return undefined;
      }
      const inputType = "text";
      const formItemName = "updateTagName";
      const editing = isEditing ? isEditing(record) : false;
      return {
        inputType,
        formItemName,
        editing,
      };
    },
  };

  const actionColumn: EditableColumnType<BsTrainingTagList_bsTrainingTagList_edges_node> = {
    title: "",
    key: "action",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Space>
        {!isEditing(record) ? (
          <>
            <Button type="primary" size="small" onClick={() => onEdit(record)}>
              수정
            </Button>
            <Button type="primary" danger size="small" onClick={() => onDelete(record)}>
              삭제
            </Button>
          </>
        ) : (
          <>
            <Button type="primary" size="small" onClick={() => onSubmit(record)}>
              저장
            </Button>
            <Button size="small" onClick={() => onCancel()}>
              취소
            </Button>
          </>
        )}
      </Space>
    ),
  };

  return [tagNameColumn, actionColumn];
};
</file>

