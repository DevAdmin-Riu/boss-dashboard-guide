>(fbvPurchaseCostStatsForHqQuery, "no-cache");

export const fbvPurchaseCostStatsForVendorQuery = gql`
  query FbvPurchaseCostStatsForVendor($vendorId: ID!, $filter: FbvPurchaseCostStatsForVendorFilterInput!) {
    fbvPurchaseCostStatsForVendor(vendorId: $vendorId, filter: $filter) {
      brand {
        id
        name
        bizInfo {
          bizRegNo
          bizName
          bizRepName
          bizContact
          bizEmail
          bizHomepage
          bizAddress
          bizType
          bizClass
          taxInvoiceInChargePersonName
          taxInvoiceInChargePersonEmail
