<file path="src/app/views/product/stock/components/MonthlyStockSnapshotsPage/utils.tsx">
import { DefaultColor as defaultColor, StockStatusColor } from "@assets/constants/colors";
import { ProductVariantMonthlyStockSnapshotQtyPerBoxUnitType, QtyPerBoxUnitTypeEnum } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import { utils } from "@utils/utils";
import { Tag } from "antd";
import React from "react";

import { getQtyPerBoxUnitTypeText } from "../../../products/utils/data";

export const makeProductQtyPerBoxText = ({
  qtyPerBox,
  qtyPerBoxUnitType,
}: {
  qtyPerBox: number | null;
  qtyPerBoxUnitType: ProductVariantMonthlyStockSnapshotQtyPerBoxUnitType;
}) => {
  const checkQtyPerBox = utils.isEmpty(qtyPerBox);
  const checkQtyPerBoxUnitType = utils.isEmpty(qtyPerBoxUnitType);
  if (checkQtyPerBox && checkQtyPerBoxUnitType) {
    return "-";
  }

  let qtyPerBoxText = "";
  if (checkQtyPerBox === false) {
    qtyPerBoxText += qtyPerBox.toLocaleString();
    if (checkQtyPerBoxUnitType === false) {
      const qtyPerBoxUnitTypeText = getQtyPerBoxUnitTypeText(qtyPerBoxUnitType as unknown as QtyPerBoxUnitTypeEnum);
      qtyPerBoxText += " " + qtyPerBoxUnitTypeText;
    }
  }

  return qtyPerBoxText;
};

export const makeVendorDeliveryTruckWeight = ({
  vendorDeliveryTruckInfo,
  objectAttr,
  isHtml = true,
}: {
  vendorDeliveryTruckInfo: any;
  objectAttr: string;
  isHtml?: boolean;
}) => {
  const parsedVendorDeliveryTruckInfo = JSON.parse(vendorDeliveryTruckInfo);
  const checkVendorDeliveryTruckInfo = utils.isEmpty(parsedVendorDeliveryTruckInfo);
  if (checkVendorDeliveryTruckInfo || utils.isEmpty(parsedVendorDeliveryTruckInfo?.[objectAttr])) {
    return "-";
  }

  if (isHtml === false) {
    return parsedVendorDeliveryTruckInfo[objectAttr];
  }
  return <NumberComponent value={parsedVendorDeliveryTruckInfo[objectAttr]} />;
};

export const makeExistNeedToStock = ({
  existNeedToStock,
  isHtml = true,
}: {
  existNeedToStock: boolean;
  isHtml?: boolean;
}) => {
  const tagText = existNeedToStock ? "입고 예정" : "-";
  if (isHtml === false || tagText === "-") {
    return tagText;
  }
  const color = existNeedToStock ? StockStatusColor.willBeStocked : defaultColor;
  return <Tag color={color}>{tagText}</Tag>;
};
</file>

