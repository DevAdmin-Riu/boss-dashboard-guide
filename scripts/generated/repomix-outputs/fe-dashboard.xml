<file path="src/app/components/AssignProductVariantDialog/AssignProductVariantDialog.tsx">
import { ProductVariantListForSearch_productVariants_edges_node } from "@src/app/views/product/products/api/types/ProductVariantListForSearch";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { FetchMoreProps } from "@src/global/core/types/types";
import { transformTrackInventoryVariantType } from "@utils/misc";
import { utils } from "@utils/utils";
import { Input, Modal, Row, Space, Typography } from "antd";
import Table, { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect } from "react";

import { commonTableProps } from "../antd/Table/TableProps";
import { columnNameConstant } from "../ColumnHelper/columnConstant";

export interface AssignProductDialogProps extends FetchMoreProps {
  open: boolean;
  productVariants: ProductVariantListForSearch_productVariants_edges_node[];
  loading: boolean;
  checkType?: "radio" | "checkbox";
  onFetch: (value: string) => void;
  onSubmit: (data: ProductVariantListForSearch_productVariants_edges_node[]) => void;
  onClose: () => void;
}

const AssignProductVariantDialog: React.FC<AssignProductDialogProps> = (props) => {
  const {
    open,
    productVariants,
    loading,
    checkType = "checkbox",
    hasMore,
    onFetch,
    onFetchMore,
    onSubmit,
    onClose,
  } = props;
  const [selectedRowKeys, setSelectedRowKeys] = React.useState<React.Key[]>([]);

  useEffect(() => {
    if (open === false) {
      setSelectedRowKeys([]);
    }
  }, [open]);

  const columns: ColumnsType<ProductVariantListForSearch_productVariants_edges_node> = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.sku,
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 160,
      render: (_, record) => (
        <Typography.Text ellipsis={{ tooltip: record.product?.name }}>{record.product?.name}</Typography.Text>
      ),
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) =>
        utils.isEmpty(record.name, true) ? (
          "-"
        ) : (
          <Typography.Text ellipsis={{ tooltip: record.name }}>{record.name}</Typography.Text>
        ),
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 180,
      render: (_, record) => {
        const spedText = makeProductSpecTextFromAttr(record.product?.attributes);
        return utils.isEmpty(spedText, true) ? (
          "-"
        ) : (
          <Typography.Text ellipsis={{ tooltip: spedText }}>{spedText}</Typography.Text>
        );
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "attrQuantity",
      align: "right",
      width: 80,
      render: (_, record) => makeProductQtyPerBoxText(record),
    },
    {
      title: columnNameConstant.product.TRACK_INVENTORY,
      key: "trackInventoryVariantType",
      align: "center",
      width: 120,
      render: (_, record) => transformTrackInventoryVariantType(record.trackInventory),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<ProductVariantListForSearch_productVariants_edges_node> = {
    type: checkType,
    selectedRowKeys,
    onChange: (selectedRowKeys) => setSelectedRowKeys(selectedRowKeys),
  };

  const emptyText = "검색 결과가 없습니다.";

  const onOk = () => {
    const selectedData = productVariants.filter((variant) => selectedRowKeys.includes(variant.id));
    onSubmit(selectedData);
  };

  return (
    <Modal
      destroyOnClose
      forceRender
      title="제품 선택"
      open={open}
      width={700}
      onOk={onOk}
      onCancel={onClose}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Input.Search
          allowClear
          enterButton
          size="large"
          onSearch={onFetch}
          placeholder="제품 검색"
          loading={loading}
        />
        <Table
          {...commonTableProps}
          loading={loading}
          columns={columns}
          dataSource={productVariants}
          rowSelection={rowSelection}
          scroll={{ x: tableWidthSum, y: 500 }}
          locale={{ emptyText }}
          footer={
            hasMore &&
            (() => (
              <Row justify="center">
                <Typography.Link onClick={onFetchMore}>더 보기</Typography.Link>
              </Row>
            ))
          }
        />
      </Space>
    </Modal>
  );
};
export default AssignProductVariantDialog;
</file>

