}

enum BrandHistoryModalModeEnum {
  Remove = "Remove",
}

export const BrandHistoryDetailsView: React.FC<BrandHistoryDetailsViewProps> = ({ id }) => {
  const [addFileList, setAddFileList] = useState<UploadFile[]>([]);
  const [addDescList, setAddDescList] = useState<string[]>([]);
  const [updateDescList, setUpdateDescList] = useState<UpdateFileDescType[]>([]);
  const [deleteFileList, setDeleteFileList] = useState<DeleteFileType[]>([]);

  const navigate = useNavigator();

  const [updateBrandHistory, updateBrandHistoryOpts] = useBrandHistoryUpdateMutation({
    onCompleted: (data: UpdateBrandHistory) => {
      const errors = data.brandHistoryUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(brandHistoryDetailsViewUrl(id));
      } else {
        showGqlErrors(errors);
      }
    },
  });
  const handleDeleteSuccess = (data: DeleteBrandHistory) => {
    const errors = data.brandHistoryDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(brandHistoryListUrl);
    } else {
      showGqlErrors(errors);
    }
  };
  const [deleteBrandHistory, deleteBrandHistoryOpts] = useBrandHistoryDeleteMutation({
    onCompleted: handleDeleteSuccess,
  });

  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const openModalWithoutNavigate = (madalMode: BrandHistoryModalModeEnum) => {
    setModalMode(madalMode);
  };

  const handleBack = () => {
    navigate(brandHistoryListUrl);
  };

  const { data: brandHistoryDetails, loading } = useBrandHistoryQuery({
    skip: id === undefined,
    variables: {
      id,
    },
  });

  const brandHistory = brandHistoryDetails?.brandHistory;
  if (brandHistory === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  const handleBrandHistoryFileCreate = (data: BrandHistoryFileCreate) => {
    const errors = data.brandHistoryFileCreate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [createBrandHistoryFile] = useCreateBrandHistoryFileMutation({
    onCompleted: handleBrandHistoryFileCreate,
  });

  const handBrandHistoryFileUpdate = (data: BrandHistoryFileUpdate) => {
    const errors = data.brandHistoryFileUpdate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [updateBrandHistoryFile] = useUpdateBrandHistoryFileMutation({
    onCompleted: handBrandHistoryFileUpdate,
  });

  const handleBrandHistoryFileDelete = (data: BrandHistoryFileDelete) => {
    const errors = data.brandHistoryFileDelete.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [deleteBrandHistoryFile] = useDeleteBrandHistoryFileMutation({
    onCompleted: handleBrandHistoryFileDelete,
  });

  const createBrandHistoryFiles = async (addFileList: UploadFile[], addDescList: string[]) => {
    const length = addFileList?.length;
    for (let i = 0; i < length; i++) {
      await createBrandHistoryFile({
        variables: {
          input: {
            brandHistory: id,
            file: addFileList[i].originFileObj,
            fileName: addFileList[i].name,
            description: addDescList[i],
          },
        },
      });
    }
  };

  const updateBrandHistoryFiles = async (updateDescList: UpdateFileDescType[]) => {
    const length = updateDescList?.length;
    for (let i = 0; i < length; i++) {
      const updateDesc = updateDescList[i];
      const { id, description } = updateDesc;
      await updateBrandHistoryFile({
        variables: {
          id,
          input: {
            description,
          },
        },
      });
    }
  };

  const deleteBrandHistoryFiles = async (deleteFileList: DeleteFileType[]) => {
    const length = deleteFileList?.length;
    for (let i = 0; i < length; i++) {
      const deleteFile = deleteFileList[i];
      const { id } = deleteFile;
      await deleteBrandHistoryFile({
        variables: {
          id,
        },
      });
    }
  };

  const handleSubmit = async (formData: BrandHistoryDetailsPageFormData) => {
    await createBrandHistoryFiles(addFileList, addDescList);
    await updateBrandHistoryFiles(updateDescList);
    await deleteBrandHistoryFiles(deleteFileList);
    setAddFileList([]);
    setAddDescList([]);
    setUpdateDescList([]);
    setDeleteFileList([]);

    const result = await updateBrandHistory({
      variables: {
        id,
        input: {
          title: formData.title,
          content: convertMarkdownToContentJsonStr(formData.contentRaw),
        },
      },
    });
    return result.data.brandHistoryUpdate.errors;
  };

  return (
    <>
      <WindowTitle title="브랜드 이력 조회" />
      {brandHistory && (
        <>
          <BrandHistoryDetailsPage
            brandHistory={maybe(() => brandHistory)}
            disabled={loading || updateBrandHistoryOpts.loading || deleteBrandHistoryOpts.loading}
            errors={updateBrandHistoryOpts.data?.brandHistoryUpdate.errors || []}
            saveButtonBar={updateBrandHistoryOpts.status}
            onBack={handleBack}
            onSubmit={handleSubmit}
            onDelete={() => openModalWithoutNavigate(BrandHistoryModalModeEnum.Remove)}
            uploadFileController={{
              addFileList,
              addDescList,
              updateDescList,
              deleteFileList,
              setAddFileList,
              setAddDescList,
              setUpdateDescList,
              setDeleteFileList,
            }}
          />
          <ActionDialog
            confirmButtonState={deleteBrandHistoryOpts.status}
            onClose={resetForCloseModal}
            onConfirm={() => deleteBrandHistory({ variables: { id } })}
            title={"브랜드 이력 삭제"}
            variant="delete"
            open={modalMode === BrandHistoryModalModeEnum.Remove}
          >
            <DialogContentText>해당 글을 삭제하시겠습니까?</DialogContentText>
          </ActionDialog>
        </>
      )}
    </>
  );
};
</file>

