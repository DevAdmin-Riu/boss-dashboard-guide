import { useBannerListQuery } from "@src/app/views/notice/banners/api/queries";
import BannerListPage from "@src/app/views/notice/banners/components/BannerListPage";
import ShopBannerSettingsModal from "@src/app/views/notice/banners/components/ShopBannerSettingsModal";
import {
  bannerCreateViewUrl,
  bannerListViewUrl,
  BannerListViewUrlDialog,
  BannerListViewUrlQueryParams,
} from "@src/app/views/notice/banners/urls";
import { useShopBannerSettingsQuery } from "@src/app/views/settings/siteSettings/api/queries";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { getSortQueryVariables } from "./sort";

interface BannerListViewProps {
  params: BannerListViewUrlQueryParams;
}

export const BannerListView: React.FC<BannerListViewProps> = ({ params }) => {
  const targetUrl = bannerListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BANNER_LIST,
  });

  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data: bannerListData, loading: bannerListLoading } = useBannerListQuery({
    variables: queryVariables,
  });

  const { data: shopBannerSettingsData, loading: shopBannerSettingsLoading } = useShopBannerSettingsQuery({});

  const handleSort = createSortHandler(navigate, bannerListViewUrl, params);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: bannerListData?.banners?.pageInfo,
    paginationState,
    params,
  });

  const { openModal, closeModal } = utils.initListViewFilterTabs<BannerListViewUrlDialog, BannerListViewUrlQueryParams>(
    {
      navigate,
      targetUrl,
      params,
    }
  );

  return (
    <>
      <BannerListPage
        params={params}
        banners={maybe(() => bannerListData?.banners?.edges.map((edge) => edge.node))}
        disabled={bannerListLoading}
        settings={settings}
        onAdd={() => navigate(bannerCreateViewUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onUpdateListSettings={updateListSettings}
        openModal={openModal}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
      />
      {!shopBannerSettingsLoading ? (
        <ShopBannerSettingsModal
          shopBannerSettings={maybe(() => shopBannerSettingsData?.shop)}
          open={params.action === "update-shop-banner-settings"}
          loading={shopBannerSettingsLoading}
          onClose={closeModal}
        />
      ) : null}
    </>
  );
};
