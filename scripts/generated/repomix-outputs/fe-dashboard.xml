          />
        ))}
        <Route exact path={hqReqBossProductCreateViewPath} component={HqReqBossProductCreateViewWrapper} />
        <Route path={hqReqBossProductDetailsViewPath(":id")} component={HqReqBossProductDetailsViewWrapper} />
      </Switch>
    </>
  );
};
