import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { WindowTitle } from "@src/app/components/WindowTitle";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { PermissionData } from "@src/app/views/settings/permissionGroups/components/PermissionGroupDetailsPage";
import { permissionMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { usePermissionGroupCreate } from "../../api/mutations";
import { PermissionGroupCreate } from "../../api/types/PermissionGroupCreate";
import PermissionGroupCreatePage from "../../components/PermissionGroupCreatePage";
import { permissionGroupDetailsUrl, permissionGroupListViewUrl } from "../../urls";

export const PermissionGroupCreateView: React.FC = () => {
  const navigate = useNavigator();

  const shop = useShop();
  const user = useUser();

  const handleSuccess = (data: PermissionGroupCreate) => {
    const errors = data.permissionGroupCreate.errors;
    if (errors.length === 0) {
      showNotificationSuccess("권한 그룹이 추가되었습니다.");
      navigate(permissionGroupDetailsUrl(data.permissionGroupCreate.group.id));
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [createPermissionGroup, createPermissionGroupResult] = usePermissionGroupCreate({
    onCompleted: handleSuccess,
  });

  const errors = createPermissionGroupResult?.data?.permissionGroupCreate?.errors || [];

  const onSubmit = (formData) =>
    createPermissionGroup({
      variables: {
        input: {
          addPermissions: formData.hasFullAccess ? shop.permissions.map((perm) => perm.code) : formData.permissions,
          addUsers: [],
          name: formData.name,
        },
      },
    });

  const userPermissions = user?.user.userPermissions.map((p) => p.code) || [];

  const permissions: PermissionData[] =
    shop?.permissions.map(
      (p) =>
        ({
          ...p,
          disabled: !userPermissions.includes(p.code),
          lastSource: false,
        } as PermissionData)
    ) || [];

  return (
    <>
      <WindowTitle title={permissionMsg.createGroup} />
      <PermissionGroupCreatePage
        errors={errors}
        disabled={createPermissionGroupResult.loading}
        permissions={permissions}
        saveButtonBarState={createPermissionGroupResult.status}
        onSubmit={onSubmit}
        onBack={() => navigate(permissionGroupListViewUrl())}
      />
    </>
  );
};
</file>

