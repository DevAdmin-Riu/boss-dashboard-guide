  query ReserveChangePriceBaseList($first: Int, $after: String, $last: Int, $before: String) {
    reserveChangePriceBases(before: $before, after: $after, first: $first, last: $last) {
      edges {
        node {
          ...ReserveChangePriceBaseFragment
        }
      }
      pageInfo {
        hasPreviousPage
        hasNextPage
        startCursor
        endCursor
      }
      totalCount
    }
  }
`;

