import { firstDepthMenuTitle } from "@assets/messages/menuTitle";
import useNavigator from "@hooks/useNavigator";
import { FulfillmentLineBulkInspectDetail } from "@src/api/types/globalTypes";
import { WindowTitle } from "@src/app/components/WindowTitle";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { maybe, parseBoolean } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Form, Modal, Row, Space, Typography } from "antd";
import { useEffect, useMemo, useState } from "react";
import React from "react";

import { useFulfillmentLineBulkInspectMutation } from "../../api/mutations";
import {
  fulfillmentLinesByVariantQuery,
  fulfillmentListTotalUninspectedQtyQuery,
  useFulfillmentLinesByVariantQuery,
  useFulfillmentListTotalUninspectedQtyQuery,
} from "../../api/queries";
import { FulfillmentLinesByVariantVariables } from "../../api/types/FulfillmentLinesByVariant";
import { FulfillmentListTotalUninspectedQtyVariables } from "../../api/types/FulfillmentListTotalUninspectedQty";
import { FulfillmentInspectDetailModal } from "../../components/FulfillmentInspectDetailModal";
import FulfillmentInspectListPage from "../../components/FulfillmentInspectListPage/FulfillmentInspectListPage";
import { checkIsAllInspectCompletedWatched } from "../../components/FulfillmentInspectListPage/utils";
import { fulfillmentInspectListViewUrl, FulfillmentInspectListViewUrlQueryParams } from "../../urls";
import {
  getDailyUninspectedQtyFilterVariables,
  getFilterOpts,
  getFilterQueryParam,
  getFulfillmentFilterVariables,
  getFulfillmentLineFilterVariables,
} from "./filters";

interface FulfillmentInspectListViewProps {
  params: FulfillmentInspectListViewUrlQueryParams;
}

interface InspectDetailByVariant {
  variantId: string;
  inspectQtyByVariant: number;
}
export type TInspectByVariantLinesObj = Record<string, InspectDetailByVariant>;
export interface IFulfillmentInspectForm {
  manualInspectAllowed: boolean;
  linesObj: TInspectByVariantLinesObj;
}

enum FulfillmentInspectListModalModeEnum {
  Inspect = "Inspect",
  Reset = "Reset",
  ViewFulfillmentInspectDetail = "ViewFulfillmentInspectDetail",
}

export const FulfillmentInspectListView: React.FC<FulfillmentInspectListViewProps> = ({ params }) => {
  const navigate = useNavigator();
  const [form] = Form.useForm<IFulfillmentInspectForm>();
  const [modalMode, setModalMode] = useState<FulfillmentInspectListModalModeEnum>(null);
  const [selectedVariantId, setSelectedVariantId] = useState<string>(null);
  const [selectedWarehouseId, setSelectedWarehouseId] = useState<string>(null);

  const onModalOpen = (mode: FulfillmentInspectListModalModeEnum, variantId?: string) => {
    setModalMode(mode);
    if (!!variantId) {
      setSelectedVariantId(variantId);
    }
  };
  const onModalClose = () => {
    setModalMode(null);
    setSelectedVariantId(null);
  };

  const queryVariables = useMemo<FulfillmentLinesByVariantVariables>(
    () => ({
      fulfillmentFilter: getFulfillmentFilterVariables(params),
      fulfillmentLineFilter: getFulfillmentLineFilterVariables(params, selectedWarehouseId),
      isInspectCompleted: parseBoolean(params.isInspectCompleted, false),
    }),
    [params, selectedWarehouseId]
  );

  // NOTE: skip 조건은 FulfillmentInspectListPage의 validateQueryClick 함수와 동일하게 유지 필요
  const { data, loading, refetch } = useFulfillmentLinesByVariantQuery({
    skip: utils.allEmpty([params.sectorSearch, params.locationSearch], true),
    variables: queryVariables,
  });
  const dataSource = maybe(() => data.fulfillmentLinesByVariant, []);
  const currentTotalUninspectedQty = dataSource.reduce<number>((acc, record) => {
    const { fulfillmentLines } = record;
    const quantityByVariant = fulfillmentLines.reduce((acc, line) => acc + line.quantity, 0);
    const inspectedQtyByVariant = fulfillmentLines.reduce((acc, line) => acc + line.inspectedQty, 0);
    return acc + (quantityByVariant - inspectedQtyByVariant);
  }, null);

  const selectedRow = dataSource.find((item) => item.productVariant.id === selectedVariantId);

  const linesObjWatched = Form.useWatch("linesObj", form) || {};
  const isAllCompleted = checkIsAllInspectCompletedWatched(dataSource, linesObjWatched);

  const queryVariablesForDailyTotal = useMemo<FulfillmentListTotalUninspectedQtyVariables>(
    () => ({ filter: getDailyUninspectedQtyFilterVariables() }),
    []
  );
  const {
    data: totalUninspectedQtyData,
    loading: totalUninspectedQtyLoading,
    refetch: totalUninspectedQtyRefetch,
  } = useFulfillmentListTotalUninspectedQtyQuery({ variables: queryVariablesForDailyTotal });
  const dailyTotalUninspectedQty = maybe(() => totalUninspectedQtyData.fulfillments.totalUninspectedQty, null);

  const [fulfillmentLineBulkInspect, fulfillmentLineBulkInspectOpts] = useFulfillmentLineBulkInspectMutation({
    onCompleted: (data) => {
      const errors = data?.fulfillmentLineBulkInspect?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("검수한 정보가 저장되었습니다.");
        onModalClose();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [fulfillmentLinesByVariantQuery, fulfillmentListTotalUninspectedQtyQuery],
  });

  const handleBulkInspect = (formData: IFulfillmentInspectForm) => {
    const { linesObj } = formData;
    const details: FulfillmentLineBulkInspectDetail[] = [];

    // NOTE: 실무자는 productVariant 단위로 검수 수량을 파악하고 저장하지만, 실제 검수 수량은 fulfillmentLine에 저장되는 구조임.
    // 실무자가 제품 단위로 조회를 요청했고 출고건까지 선택하여 검수를 진행하는 것은 업무상 불편하고 한계가 있으므로,
    // 현재 조회된 fulfillmentLine를 순회하며 임의로 검수 수량을 설정하는 것으로 처리함. 추후 출고건별로 관리가 필요하다는 피드백이 생기면 그때 변경하는 것으로.
    dataSource.forEach((record) => {
      const { productVariant, fulfillmentLines } = record;
      const lineObjByVariantId = linesObj[productVariant.id];
      const { inspectQtyByVariant } = lineObjByVariantId || {};
      if (inspectQtyByVariant > 0) {
        // 남은 검수 수량
        let remainInspectQty = inspectQtyByVariant;

        // 검수 수량이 남아있는 fulfillmentLines에 대해 검수 수량을 설정
        const uninspectedFulfillmentLines = fulfillmentLines.filter((line) => line.quantity > line.inspectedQty);
        while (remainInspectQty > 0 && uninspectedFulfillmentLines.length > 0) {
          const fulfillmentLine = uninspectedFulfillmentLines.shift();
          const { id, quantity, inspectedQty } = fulfillmentLine;
          const uninspectedQty = quantity - inspectedQty;
          if (remainInspectQty <= uninspectedQty) {
            // 남은 검수 수량이 uninspectedQty보다 작거나 같으면 남은 검수 수량만큼 전달
            details.push({ id, inspectQty: remainInspectQty });
            remainInspectQty = 0;
          } else if (remainInspectQty > 0) {
            // 남은 검수 수량이 uninspectedQty보다 크면 uninspectedQty만큼 전달
            details.push({ id, inspectQty: uninspectedQty });
            remainInspectQty -= uninspectedQty;
          }
        }
      } else {
        return;
      }
    });

    fulfillmentLineBulkInspect({ variables: { input: { details } } });
  };

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: fulfillmentInspectListViewUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: () => {
      refetch();
      totalUninspectedQtyRefetch();
    },
  });

  const pageLoading = loading || totalUninspectedQtyLoading || fulfillmentLineBulkInspectOpts.loading;

  const initialValues: IFulfillmentInspectForm = {
    manualInspectAllowed: !utils.checkMobile(),
    linesObj: dataSource.reduce<TInspectByVariantLinesObj>((acc, record) => {
      const variantId = record.productVariant.id;
      acc[variantId] = { variantId, inspectQtyByVariant: 0 };
      return acc;
    }, {}),
  };

  const onLinesObjReset = () => {
    form.resetFields(["linesObj"]);
    onModalClose();
  };

  useEffect(() => {
    onLinesObjReset();
  }, [params, pageLoading]);

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.delivery} />
      <Form
        form={form}
        name="fulfillment-inspect-form"
        layout="vertical"
        initialValues={initialValues}
        onFinish={handleBulkInspect}
      >
        <FulfillmentInspectListPage
          params={params}
          loading={pageLoading}
          dataSource={dataSource}
          totalUninspectedQty={{ current: currentTotalUninspectedQty, daily: dailyTotalUninspectedQty }}
          form={form}
          selectedWarehouseId={selectedWarehouseId}
          onWarehouseSelect={setSelectedWarehouseId}
          onInspect={() => onModalOpen(FulfillmentInspectListModalModeEnum.Inspect)}
          onReset={() => onModalOpen(FulfillmentInspectListModalModeEnum.Reset)}
          onViewFulfillmentInspectDetail={(variantId) =>
            onModalOpen(FulfillmentInspectListModalModeEnum.ViewFulfillmentInspectDetail, variantId)
          }
          onParamsChange={(changedParams) => navigate(fulfillmentInspectListViewUrl({ ...params, ...changedParams }))}
          filterOpts={getFilterOpts(params, selectedWarehouseId)}
          onFilterChange={changeFilters}
          onFilterReset={resetFilters}
        />
      </Form>
      <Modal
        destroyOnClose
        closable={false}
        title="검수 정보 저장"
        open={modalMode === FulfillmentInspectListModalModeEnum.Inspect}
        footer={
          <Row justify="space-between">
            <Button onClick={onModalClose}>취소</Button>
            <Button type="primary" loading={fulfillmentLineBulkInspectOpts.loading} onClick={form.submit}>
              저장
            </Button>
          </Row>
        }
        maskClosable={false}
      >
        <Space direction="vertical" size={0}>
          {isAllCompleted ? (
            <Typography>조회된 제품이 모두 검수완료 되었습니다.</Typography>
          ) : (
            <Typography.Text strong type="warning">
              검수가 완료되지 않은 제품이 존재합니다.
            </Typography.Text>
          )}
          <Typography>검수한 정보를 저장하시겠습니까?</Typography>
        </Space>
      </Modal>
      <Modal
        destroyOnClose
        title="검수 정보 초기화"
        open={modalMode === FulfillmentInspectListModalModeEnum.Reset}
        footer={
          <Row justify="space-between">
            <Button onClick={onModalClose}>취소</Button>
            <Button danger type="primary" onClick={onLinesObjReset}>
              초기화
            </Button>
          </Row>
        }
        onCancel={onModalClose}
      >
        <Space direction="vertical" size={0}>
          <Typography>검수한 정보를 초기화하시겠습니까?</Typography>
          <Typography.Text strong type="warning">
            * 마지막 저장 시점 이후 검수한 정보가 모두 초기화됩니다.
          </Typography.Text>
        </Space>
      </Modal>
      <FulfillmentInspectDetailModal
        open={modalMode === FulfillmentInspectListModalModeEnum.ViewFulfillmentInspectDetail}
        sku={selectedRow?.productVariant.sku}
        fulfillmentLineIds={selectedRow?.fulfillmentLines.map((line) => line.id)}
        onClose={onModalClose}
      />
      {/* <Image
        style={{ display: "none" }}
        preview={{
          visible: modalMode === FulfillmentInspectListModalModeEnum.PreviewImg && !utils.isEmpty(selectedRow),
          src: getProductBoxImgUrl(selectedRow?.productVariant),
          onVisibleChange: (visible) => {
            if (!visible) {
              setSelectedVariantId(null);
            }
          },
        }}
      /> */}
    </>
  );
};
</file>

