import { RefundQAQType } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import DateTime from "@src/app/providers/DateProvider/DateTime";
import {
  ShopInfo_shop_refundReasonChoices,
  ShopInfo_shop_refundStatusTypeChoices,
  ShopInfo_shop_refundTypeChoices,
} from "@src/app/providers/ShopProvider/types/ShopInfo";
import {
  OrderDetails_order_lines,
  OrderDetails_order_refundQA,
} from "@src/app/views/order/orders/api/types/OrderDetails";
import {
  getRefundStatusTypeLabel,
  refundStatusTypeLabelColor,
} from "@src/app/views/question/components/RefundQuestionListTable/utils";
import { Col, Image, Row, Tag } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

export const getOrderRefundQuestionsTableColumns = (
  refundTypeChoices: ShopInfo_shop_refundTypeChoices[],
  refundStatusTypeChoices: ShopInfo_shop_refundStatusTypeChoices[],
  refundReasonChoices: ShopInfo_shop_refundReasonChoices[],
  lines: OrderDetails_order_lines[]
) => {
  const columns: ColumnsType<OrderDetails_order_refundQA> = [];
  columns.push({
    title: "문의일",
    align: "center",
    key: "qCreatedAt",
    width: 180,
    render: (_, record) => <DateTime date={record.qCreatedAt} />,
  });
  columns.push({
    title: "문의구분",
    align: "center",
    key: "qType",
    width: 100,
    render: (_, record) => refundTypeChoices.find((choice) => choice.value === record?.qType).label,
  });
  columns.push({
    title: "문의 사유",
    align: "center",
    key: "qType",
    width: 200,
    render: (_, record) => {
      const qTypeCheck = record.qType === RefundQAQType.EXCHANGE || record.qType === RefundQAQType.REFUND;
      return qTypeCheck ? (
        refundReasonChoices.filter((item) => item.value === record.qReasonType)[0].label || "-"
      ) : (
        <>주문취소 건</>
      );
    },
  });
  columns.push({
    title: "사유",
    align: "center",
    key: "qReasonText",
    width: 200,
    render: (_, record) => record.qReasonText,
  });
  columns.push({
    title: "요청내용",
    align: "center",
    key: "qOrderLineInfo",
    width: 500,
    render: (_, record) => {
      const refundTypeChoice = refundTypeChoices.find((choice) => choice.value === record?.qType);
      const orderLineInfos = JSON.parse(record?.qOrderLineInfo);
      orderLineInfos.forEach((orderLineinfo) => {
        const line = lines.find((line) => line.id === orderLineinfo.order_line_id);
        orderLineinfo.productName = line?.productName;
        orderLineinfo.price = line?.unitPriceGrossAmount;
        orderLineinfo.quantity = parseInt(orderLineinfo.quantity, 10);
      });

      return refundTypeChoice?.value !== RefundQAQType.CANCEL ? (
        <>
          {orderLineInfos
            .filter((item) => item.quantity !== 0)
            .map((orderLineInfo) => (
              <div key={orderLineInfo.order_line_id}>
                <Row justify={"space-between"}>
                  <Col span={20}>{orderLineInfo.productName}</Col>
                  <Col span={4}>
                    <Row justify="end">
                      <NumberComponent value={orderLineInfo.quantity} />개
                    </Row>
                  </Col>
                </Row>
                <hr />
              </div>
            ))}
          <Row gutter={[5, 5]}>
            {record.images.map((item) => (
              <Col span={8} key={item.id}>
                <Image width={"100%"} src={item.url} />
              </Col>
            ))}
          </Row>
        </>
      ) : (
        "전체"
      );
    },
  });
  columns.push({
    title: "문의 상태",
    align: "center",
    key: "qCreatedAt",
    width: 120,
    render: (_, record) => (
      <Tag color={refundStatusTypeLabelColor(record.status)}>
        {getRefundStatusTypeLabel(refundStatusTypeChoices, record.status)}
      </Tag>
    ),
  });
  columns.push({
    title: "거부사유",
    align: "center",
    key: "aRefuseReason",
    width: 200,
    render: (_, record) => record.aRefuseReason,
  });

  return columns;
};
</file>

