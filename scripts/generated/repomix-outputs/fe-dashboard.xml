import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Divider, Modal, Table, Typography } from "antd";
import React, { useState } from "react";

import { useProductVariantDetailsForStockActionQuery, useRackStockListForStockActionQuery } from "../../api/queries";
import { RackStockListForStockAction_rackStocks_edges_node } from "../../api/types/RackStockListForStockAction";
import { StockListModalModeEnum } from "../../views/StockListView/StockListView";
import { getOuterVariantForStockAction, ProductInfoForStockAction } from "../ProductInfoForStockAction";
import { RackStockDetailMoveModal } from "../RackStockDetailMoveModal";
import { getRackStockListForStockActionTableSettings } from "./RackStockListTableSettings";

interface RackStockListModalProps {
  open: boolean;
  loading: boolean;
  productVariantId: string;
  onClose: () => void;
}

export const RackStockListModal: React.FC<RackStockListModalProps> = (props) => {
  const { open, loading, productVariantId, onClose } = props;
  const [moveModalOpen, setMoveModalOpen] = useState<boolean>(false);
  const [selectedRow, setSelectedRow] = useState<RackStockListForStockAction_rackStocks_edges_node>(null);

  const openMoveModal = (record: RackStockListForStockAction_rackStocks_edges_node) => {
    setSelectedRow(record);
    setMoveModalOpen(true);
  };
  const closeMoveModal = () => {
    setSelectedRow(null);
    setMoveModalOpen(false);
  };

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantDetailsForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { id: productVariantId },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);
  const outerVariant = getOuterVariantForStockAction(productVariant);

  const { data: rackStockData, loading: rackStockLoading } = useRackStockListForStockActionQuery({
    skip: !open || utils.isEmpty(productVariantId, true),
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.rackStocks, filter: { productVariant: productVariantId } },
  });
  const rackStocks = maybe(() => rackStockData.rackStocks.edges.map((edge) => edge.node), []);

  const columns = getRackStockListForStockActionTableSettings({ openMoveModal });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const modalLoading = loading || productVariantLoading || rackStockLoading;
  const modalFooter = (
    <Button type="default" onClick={onClose}>
      닫기
    </Button>
  );

  return (
    <>
      <Modal open={open} title="로케이션 확인" width={850} onCancel={onClose} footer={modalFooter}>
        <ProductInfoForStockAction
          modalMode={StockListModalModeEnum.RackStockList}
          loading={productVariantLoading}
          product={productVariant?.product}
          outerVariant={outerVariant}
          productVariant={productVariant}
          isFbv={false}
        />
        <Divider />
        <Table
          {...commonTableProps}
          title={() => <Typography.Title level={5}>적재 로케이션</Typography.Title>}
          loading={modalLoading}
          columns={columns}
          dataSource={rackStocks}
          scroll={{ x: tableWidthSum }}
        />
      </Modal>
      <RackStockDetailMoveModal
        open={moveModalOpen}
        loading={modalLoading}
        productVariantId={productVariantId}
        rackLocation={selectedRow?.location}
        rackStock={selectedRow}
        onClose={closeMoveModal}
      />
    </>
  );
};
</file>

