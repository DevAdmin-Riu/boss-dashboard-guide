import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { useVendorListFilterDownloadQuery, useVendorListQuery } from "../../api/queries";
import { VendorsVariables } from "../../api/types/Vendors";
import VendorListPage from "../../components/VendorListPage/VendorListPage";
import {
  vendorCreateViewUrl,
  vendorListViewUrl,
  VendorListViewUrlDialog,
  VendorListViewUrlQueryParams,
  vendorUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface VendorListViewProps {
  params: VendorListViewUrlQueryParams;
}

export const VendorListView: React.FC<VendorListViewProps> = ({ params }) => {
  const targetUrl = vendorListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.VENDOR_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useVendorListFilterDownloadQuery);

  const queryVariables: VendorsVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useVendorListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.vendors?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<VendorListViewUrlDialog, VendorListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <VendorListPage
        settings={settings}
        disabled={loading}
        vendors={maybe(() => data.vendors.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(vendorUrl(id))}
        onAdd={() => navigate(vendorCreateViewUrl)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
