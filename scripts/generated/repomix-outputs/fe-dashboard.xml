import { utils } from "@utils/utils";
import React, { useState } from "react";

import { FulfillmentListVariables } from "../../api/types/FulfillmentList";
import { OrderDeliveryReprintListViewTypeEnum } from "../../components/OrderDeliveryReprintListPage/utils";
import OrderLineBoxSizeUpdateModal from "../../components/OrderLineBoxSizeUpdateModal";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getDeliveryReprintListFilterVariables,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  saveFilterTab,
} from "./filters";
import { getDeliveryReprintListSortQueryVariables } from "./sort";

interface OrderDeliveryReprintListViewProps {
  params: OrderDeliveryReprintListViewUrlQueryParams;
}

enum OrderDeliveryReprintListModalModeEnum {
  UpdateOrderLineBoxSize = "UpdateOrderLineBoxSize",
}

export const OrderDeliveryReprintListView: React.FC<OrderDeliveryReprintListViewProps> = ({ params }) => {
  const { orderDeliveryReprintListViewType } = params;
  const [modalMode, setModalMode] = useState<OrderDeliveryReprintListModalModeEnum>(null);
  const [selectedRowId, setSelectedRowId] = useState<string>(null);

  const onModalOpen = (mode: OrderDeliveryReprintListModalModeEnum, rowId?: string) => {
    setModalMode(mode);
    if (!!rowId) {
      setSelectedRowId(rowId);
    }
  };
  const onModalClose = () => {
    setModalMode(null);
    setSelectedRowId(null);
  };

  let targetUrl: (params?: OrderDeliveryReprintListViewUrlQueryParams) => string;
  switch (orderDeliveryReprintListViewType) {
    case OrderDeliveryReprintListViewTypeEnum.STOCK:
      targetUrl = orderDeliveryReprintListViewUrlA;
      break;
    case OrderDeliveryReprintListViewTypeEnum.PICKING_ORDER:
      targetUrl = orderDeliveryReprintListViewUrlB;
      break;
    default:
      targetUrl = orderDeliveryReprintListViewUrlA;
  }
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.DELIVERY_REPRINT_LIST,
  });

  const queryVariables = React.useMemo<FulfillmentListVariables>(
    () => ({
      ...paginationState,
      filter: getDeliveryReprintListFilterVariables(params),
      sort: getDeliveryReprintListSortQueryVariables(params),
      forStaffOrderDelivery: true,
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useFulfillmentListQuery({ initialListSkip: true, variables: queryVariables });
  const deliveryReprintList = maybe(() => data.fulfillments.edges.map((edge) => edge.node), []);
  const selectedRow = deliveryReprintList.find((item) => item.id === selectedRowId);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.fulfillments?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderDeliveryReprintListViewUrlDialog, OrderDeliveryReprintListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  return (
    <>
      <WindowTitle title={firstDepthMenuTitle.delivery} />
      <OrderDeliveryReprintListPage
        params={params}
        refetch={refetch}
        settings={settings}
        currentTab={currentTab}
        disabled={loading}
        filterOpts={getFilterOpts(params)}
        deliveryReprintList={deliveryReprintList}
        queryVariables={queryVariables}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onOrderLineBoxSizeUpdate={(rowId) =>
          onModalOpen(OrderDeliveryReprintListModalModeEnum.UpdateOrderLineBoxSize, rowId)
        }
        sort={getSortParams(params)}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <OrderLineBoxSizeUpdateModal
        open={modalMode === OrderDeliveryReprintListModalModeEnum.UpdateOrderLineBoxSize}
        orderLineId={selectedRow?.lines[0].orderLine.id}
        orderLineBoxSize={selectedRow?.lines[0].orderLine.boxSize}
        onClose={onModalClose}
      />
    </>
  );
};
</file>

