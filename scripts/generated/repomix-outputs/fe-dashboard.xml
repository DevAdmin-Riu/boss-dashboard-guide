  const params: OrderDeliveryListViewUrlQueryParams = { ...defaultParams, ...sortedParams };
  return <OrderDeliveryListView defaultParams={defaultParams} params={params} isB2b={true} isByNonCourier={false} />;
};

const B2bSection = (isStaff: boolean) => (
  <>
    <WindowTitle title={firstDepthMenuTitle.b2b} />
    <Switch>
      <Route exact path={b2bOrderLineListViewPath({ status: ":status" })} component={B2bOrderListViewWrapper} />
      <Route exact path={b2bPurchaseWriteListViewPath} component={B2bPurchaseWriteListViewWrapper} />
      <Route
        exact
