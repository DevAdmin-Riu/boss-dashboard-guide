export interface BrandVacsFeeEventListPageListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandVacsFeeEventFilterKeys, BrandVacsFeeEventListFilterOpts> {
  brandVacsFeeEvents: BrandVacsFeeEventList_brandVacsFeeEvents_edges_node[];
  queryVariablesWithoutPagination: BrandVacsFeeEventListVariables;
  fetchForDownload: (variables?: BrandVacsFeeEventListVariables) => Promise<ApolloQueryResult<BrandVacsFeeEventList>>;
}
const VacsFeeEventListPage: React.FC<BrandVacsFeeEventListPageListPageProps> = (props) => {
  const {
    brandVacsFeeEvents,
    currencySymbol,
    currentTab,
    filterOpts,
    tabs,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const { user } = useAuth();
  const isHqStaff = checkHqStaff(user);
  const filterStructure = createFilterStructure(filterOpts, isHqStaff);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const titleText = isHqStaff
