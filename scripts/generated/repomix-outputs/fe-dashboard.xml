<file path="src/app/views/brand/brands/components/BrandProductPackageTotal.tsx">
import CardSpacer from "@src/app/components/CardSpacer";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { Descriptions } from "antd";
import React from "react";

import { BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo } from "../api/types/BrandProductPackage";

interface BrandProductPackageTotalProps {
  brandProductVariantPackageInfoList: BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo[];
  etcDeliveryOriginFee: number;
  isTruckService: boolean;
}

const thStyle: React.CSSProperties = { width: "calc(100% / 6)", textAlign: "right" };

const BrandProductPackageTotal: React.FC<BrandProductPackageTotalProps> = (props) => {
  const { brandProductVariantPackageInfoList, etcDeliveryOriginFee, isTruckService } = props;

  // 패키지 상품에 추가 시킨 각 상품의 배송비 합계 계산
  const totalBrandProductDeliveryFee = brandProductVariantPackageInfoList.reduce((acc, cur) => {
    const deliveryFeeAmount = cur.brandProductVariant.deliveryFeeAmount;
    acc = acc + cur.quantity * deliveryFeeAmount;
    return acc;
  }, 0);
  // 부가세 별도
  const etcDeliveryFeeExcludeVat =
    toPriceExcludeVat(etcDeliveryOriginFee) - toPriceExcludeVat(totalBrandProductDeliveryFee) > 0
      ? toPriceExcludeVat(etcDeliveryOriginFee) - toPriceExcludeVat(totalBrandProductDeliveryFee)
      : 0;

  const priceSumExcludeVat = brandProductVariantPackageInfoList.reduce((acc, cur) => {
    const priceExcludeVat = toPriceExcludeVat(
      cur.brandProductVariant.priceAmount,
      cur.brandProductVariant.brandProduct?.product.isTaxFree
    );
    acc = acc + cur.quantity * priceExcludeVat;

    return acc;
  }, 0);

  const priceSumInclEtcDeliveryFeeExcludeVat = priceSumExcludeVat + etcDeliveryFeeExcludeVat;

  return (
    <>
      {isTruckService && (
        <>
          <Descriptions bordered title="화물차 배송 시" size={"middle"} extra={<TableVatLegend isIncludeVat={false} />}>
            <Descriptions.Item style={thStyle} label="총 상품 금액">
              <NumberComponent value={priceSumExcludeVat} />
            </Descriptions.Item>
            <Descriptions.Item style={thStyle} label="화물차 배송비">
              <NumberComponent value={etcDeliveryFeeExcludeVat} />
            </Descriptions.Item>
            <Descriptions.Item style={thStyle} label="최종 판매가">
              <NumberComponent value={priceSumInclEtcDeliveryFeeExcludeVat} />
            </Descriptions.Item>
          </Descriptions>
          <CardSpacer />
        </>
      )}
      <Descriptions bordered title="택배 배송 시" size={"middle"} extra={<TableVatLegend isIncludeVat={false} />}>
        <Descriptions.Item style={thStyle} label="총 상품 금액">
          <NumberComponent value={priceSumExcludeVat} />
        </Descriptions.Item>
        <Descriptions.Item style={thStyle} label="택배 배송비">
          <NumberComponent value={0} />
        </Descriptions.Item>
        <Descriptions.Item style={thStyle} label="최종 판매가">
          <NumberComponent value={priceSumExcludeVat} />
        </Descriptions.Item>
      </Descriptions>
    </>
  );
};

export default BrandProductPackageTotal;
</file>

<file path="src/app/views/brand/brands/components/BrandProductReorderModal.tsx">
import { MutationFunction } from "@apollo/client";
import Draggable from "@assets/icons/Draggable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
import { utils } from "@utils/utils";
import { Button, Modal, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";
import {
  SortableContainer,
  SortableContainerProps,
  SortableElement,
  SortableHandle,
  SortEnd,
} from "react-sortable-hoc";

import { BrandForBpvList_brand } from "../api/types/BrandForBpvList";
import { BrandProductListWithCategory_brandProducts_edges_node } from "../api/types/BrandProductListWithCategory";
import { BrandProductReorder, BrandProductReorderVariables } from "../api/types/BrandProductReorder";

interface BrandProductReorderModalProps {
  visible: boolean;
  loading: boolean;
  brand: BrandForBpvList_brand | null;
  brandProducts: BrandProductListWithCategory_brandProducts_edges_node[];
  onBrandProductReorder: MutationFunction<BrandProductReorder, BrandProductReorderVariables>;
  onClose: () => void;
}

const DragHandle = SortableHandle(() => <Draggable style={{ cursor: "grab" }} />);
const SortableItem = SortableElement((props: React.HTMLAttributes<HTMLTableRowElement>) => <tr {...props} />);
const SortableBody = SortableContainer((props: React.HTMLAttributes<HTMLTableSectionElement>) => <tbody {...props} />);

export const BrandProductReorderModal: React.FC<BrandProductReorderModalProps> = ({
  visible,
  loading,
  brand,
  brandProducts,
  onBrandProductReorder,
  onClose,
}) => {
  const brandName = brand?.name || "";

  const columns: ColumnsType<BrandProductListWithCategory_brandProducts_edges_node> = [
    {
      key: "sort",
      width: 40,
      align: "center",
      render: () => <DragHandle />,
    },
    {
      title: columnNameConstant.product.CATEGORY_NAME,
      key: "category",
      align: "center",
      width: 200,
      render: (_, record) => {
        const parentCategory = record.product?.category?.parent;
        return (
          <Typography>
            {parentCategory && `${parentCategory?.name} > `}
            {record.product?.category?.name}
          </Typography>
        );
      },
    },
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.product?.defaultVariant?.sku || "-",
    },
    {
      title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
      key: "brandProductName",
      align: "left",
      width: 150,
      render: (_, record) => record.name || "-",
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) => record.product?.defaultVariant?.name || "-",
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 200,
      render: (_, record) => {
        const hasVariants = !!record.product?.productType?.hasVariants;
        const targetAttributes = hasVariants ? record.product?.defaultVariant?.attributes : record.product?.attributes;
        return makeProductSpecTextFromAttr(targetAttributes) || "-";
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "center",
      width: 80,
      render: (_, record) => makeProductQtyPerBoxText(record.product?.defaultVariant) || "-",
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const modalFooter = (
    <Button type={"default"} onClick={onClose}>
      취소
    </Button>
  );

  const onSortEnd = ({ oldIndex, newIndex }: SortEnd) => {
    const oldIndexSortOrder = brandProducts[oldIndex].sortOrder;
    const newIndexSortOrder = brandProducts[newIndex].sortOrder;

    if (oldIndex !== newIndex) {
      onBrandProductReorder({
        variables: {
          move: { id: brandProducts[oldIndex].id, sortOrder: newIndexSortOrder - oldIndexSortOrder },
          brandId: brand?.id,
        },
      });
    }
  };

  const DraggableContainer = (props: SortableContainerProps) => (
    <SortableBody useDragHandle onSortEnd={onSortEnd} {...props} />
  );

  const DraggableBodyRow: React.FC<any> = ({ className, style, ...restProps }) => {
    const index = brandProducts?.findIndex((data) => data.id === restProps["data-row-key"]);
    return <SortableItem index={index} disabled={loading} {...restProps} />;
  };

  return (
    <Modal
      destroyOnClose
      open={visible}
      title={`${brandName} 상품 진열순서 변경`}
      width={1000}
      onCancel={onClose}
      footer={modalFooter}
    >
      <Table
        {...commonTableProps}
        loading={loading}
        dataSource={brandProducts}
        columns={columns}
        components={{ body: { wrapper: DraggableContainer, row: DraggableBodyRow } }}
        scroll={{ x: tableWidthSum, y: 700 }}
      />
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandProductVariantBulkUpdateOrCreateModal.tsx">
import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import {
  BrandProductVariantBulkCreateDetail,
  BrandProductVariantBulkUpdateDetail,
  BrandProductVariantManageEventInput,
  SalesStatusEnum,
  StoppedReasonTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import {
  useBpvListForUploadLazyQuery,
  useProductVariantListForUploadLazyQuery,
} from "@src/app/views/product/products/api/queries";
import {
  convertBpvUploadValuesToIncludeVat,
  convertUploadValuesToIncludeVat,
} from "@src/app/views/product/products/components/ProductListPage/utils";
import { makePvOrBpvManageEventFormItems } from "@src/app/views/product/products/components/PvOrBpvManageEventModal";
import { convertUploadValuesOfBaseProduct } from "@src/app/views/product/reserveChange/components/ReserveChangeAddModal";
import { coerceExcelBoolean, loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Form, Modal, Space, Typography } from "antd";
import React, { useRef, useState } from "react";

import { BrandProductVariantBulkCreate_brandProductVariantBulkCreate_errors } from "../api/types/BrandProductVariantBulkCreate";
import { BrandProductVariantBulkUpdate_brandProductVariantBulkUpdate_errors } from "../api/types/BrandProductVariantBulkUpdate";
import { brandProductVariantManageEventTypeChoices } from "../utils";

// Union type to handle both create and update details
type BrandProductVariantDetail = BrandProductVariantBulkCreateDetail & BrandProductVariantBulkUpdateDetail;

interface BrandProductVariantBulkUpdateOrCreateModalProps {
  open: boolean;
  loading: boolean;
  isCreateMode: boolean;
  onBulkUpdateOrCreate: (
    details: Array<BrandProductVariantDetail | null>,
    manageEvent?: BrandProductVariantManageEventInput
  ) => Promise<
    | BrandProductVariantBulkCreate_brandProductVariantBulkCreate_errors[]
    | BrandProductVariantBulkUpdate_brandProductVariantBulkUpdate_errors[]
  >;
  onClose: () => void;
  enableForB2bService: boolean;
}

interface BrandProductVariantBulkUpdateOrCreateForm {
  details: BrandProductVariantDetail[];
  manageEvent?: BrandProductVariantManageEventInput;
}

// 오류 배열과 제목, (선택적으로) mapper 함수를 받아 에러 메시지를 보여주는 헬퍼 함수
export const showError = <T,>(errorArray: T[], title: string, mapper?: (item: T) => string): void => {
  if (errorArray.length > 0) {
    const content = mapper ? errorArray.map(mapper).join(", ") : errorArray.join(", ");
    const errorMsg = (
      <>
        {title}
        <br />
        {content}
      </>
    );
    showNotificationError(errorMsg);
  }
};

export const BrandProductVariantBulkUpdateOrCreateModal: React.FC<BrandProductVariantBulkUpdateOrCreateModalProps> = (
  props
) => {
  const { open, loading, isCreateMode, onBulkUpdateOrCreate, onClose, enableForB2bService } = props;
  const upload = useRef<HTMLInputElement>();
  const [form] = Form.useForm();
  const handleUploadButtonClick = () => upload.current.click();
  const TypeSafeForm = getTypeSafeForm<BrandProductVariantBulkUpdateOrCreateForm>(form);
  const detailsWatcher = TypeSafeForm.getUseWatcherParams({ name: "details" });
  const detailsWatched = Form.useWatch(detailsWatcher.namePath, detailsWatcher.formInstance);
  const [selectedFile, setSelectedFile] = useState<string>();
  const [errorExist, setErrorExist] = useState<boolean>(false);

  const [refetchPvListForUpload] = useProductVariantListForUploadLazyQuery();
  const [refetchBpvListForUpload] = useBpvListForUploadLazyQuery();

  const onModalClose = () => {
    form.resetFields();
    setErrorExist(false);
    setSelectedFile(undefined);
    onClose();
  };

  const manageEventType = null;
  const initialValues: BrandProductVariantBulkUpdateOrCreateForm = {
    details: [],
    manageEvent: isCreateMode ? null : { type: manageEventType, title: "", reason: "" },
  };

  // 오류 배열과 제목, (선택적으로) mapper 함수를 받아 에러 메시지를 보여주는 헬퍼 함수
  function showError<T>(errorArray: T[], title: string, mapper?: (item: T) => string): void {
    if (errorArray.length > 0) {
      const content = mapper ? errorArray.map(mapper).join(", ") : errorArray.join(", ");
      const errorMsg = (
        <>
          {title}
          <br />
          {content}
        </>
      );
      showNotificationError(errorMsg);
    }
  }

  const salesStatusList = Object.values(SalesStatusEnum);
  const validateDetails = (details: BrandProductVariantDetail[], isCreateMode: boolean): boolean => {
    let isValid = true;

    // 1. 빈 값 체크 플래그
    let hasEmptyProductSku = false;
    let hasEmptyBpSku = false;
    let hasEmptyRegionCode = false;

    // 2. 상품코드별 브랜드 제품명 일관성 체크를 위한 맵과 오류 배열 (자세한 정보 포함)
    const skuBrandMap: Record<string, string> = {};
    const brandNameErrors: Array<{ sku: string; expected: string; found: string }> = [];

    // 3. 중복 체크를 위한 combineCode 추적
    const seenCombineCodes = new Set<string>();
    const duplicateCombineCodes: string[] = [];

    // 4. 배송비, 매입가, 판매가 값 검증용 배열
    const deliveryFeeErrors: string[] = [];
    const costPriceErrors: string[] = [];
    const priceErrors: string[] = [];

    // 5. 판매상태 체크
    const salesStatusErrors: string[] = [];

    // 6. 중단일, 중단사유, 기타 중단사유
    const stoppedAtErrors: string[] = [];
    const stoppedReasonErrors: string[] = [];
    const StoppedReasonEtcErrors: string[] = [];

    // 7. boolean 값들 체크
    const isExclusiveErrors: string[] = [];
    const isOnlyPayableByCashErrors: string[] = [];
    const isRcoinRewardForUsingPointErrors: string[] = [];
    const needDeliveryAdditionalFeeErrors: string[] = [];
    const forceNoNormalDisplayErrors: string[] = [];
    const includeSalesB2bDeliveryFeeErrors: string[] = [];

    // details 배열을 한 번 순회하면서 모든 검증 수행
    for (const detail of details) {
      // SKU 빈 값 체크
      if (isCreateMode) {
        // 추가 모드: productSku(제품코드) 검증
        if (utils.isEmpty(detail.productSku, true)) {
          hasEmptyProductSku = true;
          isValid = false;
        }
        // 권역 코드 빈 값 체크
        if (utils.isEmpty(detail.regionCode, true)) {
          hasEmptyRegionCode = true;
          isValid = false;
        }
      } else {
        // 수정 모드: bpSku(상품코드) 검증
        if (utils.isEmpty(detail.bpSku, true)) {
          hasEmptyBpSku = true;
          isValid = false;
        }
      }
      // 브랜드 상품명 일관성 체크 (수정 모드에서만)
      if (isCreateMode === false && detail.bpSku) {
        if (skuBrandMap[detail.bpSku] === undefined) {
          skuBrandMap[detail.bpSku] = detail.brandProductName;
        } else if (skuBrandMap[detail.bpSku] !== detail.brandProductName) {
          // 해당 SKU에 대해 예상 브랜드명과 다른 경우 상세 정보를 추가
          const existingError = brandNameErrors.find((err) => err.sku === detail.productSku);
          if (!existingError) {
            brandNameErrors.push({
              sku: detail.productSku,
              expected: skuBrandMap[detail.productSku],
              found: detail.brandProductName,
            });
          }
          isValid = false;
        }
      }
      // 중복 체크: combineCode 사용
      const combineCode = makeCombineCode(detail, isCreateMode);
      if (seenCombineCodes.has(combineCode)) {
        duplicateCombineCodes.push(combineCode);
        isValid = false;
      } else {
        seenCombineCodes.add(combineCode);
      }

      if (detail.price !== undefined && detail.price < 0) {
        priceErrors.push(combineCode);
        isValid = false;
      }

      const isEmptySalesStatus = utils.isEmpty(detail.salesStatus);
      const isInvalidSalesStatus = !salesStatusList.includes(detail.salesStatus);
      if (isEmptySalesStatus === false && isInvalidSalesStatus) {
        salesStatusErrors.push(combineCode);
        isValid = false;
      }

      // 판매 상태가 중단예정 or 중단일 경우 => "중단일", "중단사유" 체크
      if (
        isEmptySalesStatus === false &&
        isInvalidSalesStatus === false &&
        (detail.salesStatus === SalesStatusEnum.STOPPED || detail.salesStatus === SalesStatusEnum.WILL_BE_STOPPED)
      ) {
        if (
          detail.stoppedAt === undefined ||
          detail.stoppedAt === null ||
          !/^\d{4}-\d{2}-\d{2}$/.test(detail.stoppedAt) // YYYY-MM-DD 형식 체크
        ) {
          stoppedAtErrors.push(combineCode);
          isValid = false;
        }
        if (utils.isEmpty(detail.stoppedReason)) {
          stoppedReasonErrors.push(combineCode);
          isValid = false;
        }
        if (detail.stoppedReason === StoppedReasonTypeEnum.ETC && utils.isEmpty(detail.stoppedReasonEtc)) {
          StoppedReasonEtcErrors.push(combineCode);
          isValid = false;
        }
      }
      if (isCreateMode) {
        if (enableForB2bService) {
          if (
            detail.includeSalesB2bDeliveryFee === undefined ||
            coerceExcelBoolean(detail.includeSalesB2bDeliveryFee) === undefined
          ) {
            includeSalesB2bDeliveryFeeErrors.push(combineCode);
            isValid = false;
          }
        } else {
          if (detail.deliveryFee === undefined || detail.deliveryFee < 0) {
            deliveryFeeErrors.push(combineCode);
            isValid = false;
          }
          if (detail.costPriceExcludeVat === undefined || detail.costPriceExcludeVat < 0) {
            costPriceErrors.push(combineCode);
            isValid = false;
          }
          if (detail.isExclusive === undefined || coerceExcelBoolean(detail.isExclusive) === undefined) {
            isExclusiveErrors.push(combineCode);
            isValid = false;
          }
          if (
            detail.isOnlyPayableByCash === undefined ||
            coerceExcelBoolean(detail.isOnlyPayableByCash) === undefined
          ) {
            isOnlyPayableByCashErrors.push(combineCode);
            isValid = false;
          }
          if (
            detail.isRcoinRewardForUsingPoint === undefined ||
            coerceExcelBoolean(detail.isRcoinRewardForUsingPoint) === undefined
          ) {
            isRcoinRewardForUsingPointErrors.push(combineCode);
            isValid = false;
          }
        }
        if (
          detail.needDeliveryAdditionalFee === undefined ||
          coerceExcelBoolean(detail.needDeliveryAdditionalFee) === undefined
        ) {
          needDeliveryAdditionalFeeErrors.push(combineCode);
          isValid = false;
        }
        if (
          detail.forceNoNormalDisplay === undefined ||
          coerceExcelBoolean(detail.forceNoNormalDisplay) === undefined
        ) {
          forceNoNormalDisplayErrors.push(combineCode);
          isValid = false;
        }
      }
    }

    // 오류 메시지 출력
    const skuLabel = isCreateMode ? "제품코드" : "상품코드";

    if (hasEmptyProductSku) {
      showNotificationError("제품코드가 지정되지 않은 셀이 존재합니다.");
    }
    if (hasEmptyBpSku) {
      showNotificationError("상품코드가 지정되지 않은 셀이 존재합니다.");
    }
    if (hasEmptyRegionCode) {
      showNotificationError("직배송 상품 중 권역 코드가 지정되지 않은 셀이 존재합니다.");
    }
    showError(
      brandNameErrors,
      `상품명 통일 필수 (${skuLabel}):`,
      (err) => `${err.sku} (예상: ${err.expected}, 입력: ${err.found})`
    );
    showError(duplicateCombineCodes, `(${skuLabel}:권역 정보) 중복:`);
    showError(deliveryFeeErrors, `브랜드 배송비 오류 (${skuLabel}:권역 정보):`);
    showError(costPriceErrors, `브랜드 매입가 오류 (${skuLabel}:권역 정보):`);
    showError(priceErrors, `매장 판매가 오류 (${skuLabel}:권역 정보):`);
    showError(includeSalesB2bDeliveryFeeErrors, `판매가 배송비 포함 여부 오류 (${skuLabel}:권역 정보):`);
    showError(salesStatusErrors, `판매상태 오류 (${skuLabel}:권역 정보):`);
    showError(stoppedAtErrors, `중단일 오류 (${skuLabel}:권역 정보):`);
    showError(stoppedReasonErrors, `중단사유 오류 (${skuLabel}:권역 정보):`);
    showError(StoppedReasonEtcErrors, `기타 중단사유 오류 (${skuLabel}:권역 정보):`);
    showError(isExclusiveErrors, `전용 상품 여부 오류 (${skuLabel}:권역 정보):`);
    showError(isOnlyPayableByCashErrors, `현금 전용 여부 오류 (${skuLabel}:권역 정보):`);
    showError(isRcoinRewardForUsingPointErrors, `충전금 혜택 여부 오류 (${skuLabel}:권역 정보):`);
    showError(needDeliveryAdditionalFeeErrors, `도서산간 추가 배송비 청구 여부 오류 (${skuLabel}:권역 정보):`);
    showError(forceNoNormalDisplayErrors, `진열 상태 여부 오류 (${skuLabel}:권역 정보):`);

    return isValid;
  };

  const convertDetailsBooleanValue = (details: BrandProductVariantDetail[]): BrandProductVariantDetail[] =>
    details.map((detail) => ({
      ...detail,
      isExclusive: coerceExcelBoolean(detail.isExclusive) as boolean,
      isOnlyPayableByCash: coerceExcelBoolean(detail.isOnlyPayableByCash) as boolean,
      isRcoinRewardForUsingPoint: coerceExcelBoolean(detail.isRcoinRewardForUsingPoint) as boolean,
      needDeliveryAdditionalFee: coerceExcelBoolean(detail.needDeliveryAdditionalFee) as boolean,
      forceNoNormalDisplay: coerceExcelBoolean(detail.forceNoNormalDisplay) as boolean,
    }));

  const removeUnusedSkuFields = (
    details: BrandProductVariantDetail[],
    isCreateMode: boolean
  ): BrandProductVariantDetail[] =>
    details.map((detail) => {
      const cleaned = { ...detail };
      if (isCreateMode) {
        // 추가 모드: bpSku 제거
        delete cleaned.bpSku;
      } else {
        // 수정 모드: productSku 제거
        delete cleaned.productSku;
      }
      return cleaned;
    });

  const makeCombineCode = (detail: BrandProductVariantDetail, isCreateMode: boolean) => {
    const regionCode = detail.regionCode || "미지정";
    const sku = isCreateMode ? detail.productSku : detail.bpSku;
    return `${sku}:${regionCode}`;
  };

  const validateDataIsNonNull = (details: BrandProductVariantDetail[]) => {
    if (details === undefined || details.length <= 0) {
      showNotificationError("상품가 등록/수정을 위한 엑셀데이터에 데이터가 없거나 양식 오류로 처리할 수 없습니다.");
      return false;
    }
    return true;
  };

  const readUploadFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const sheetName = worksheet.name;

        // Select appropriate template version based on mode and brand type
        const templateVersion = isCreateMode
          ? enableForB2bService
            ? excelTemplateVersion.b2bBrandAddProduct
            : excelTemplateVersion.brandAddProduct
          : enableForB2bService
          ? excelTemplateVersion.b2bBrandUpdateProduct
          : excelTemplateVersion.brandUpdateProduct;

        if (utils.validateTemplateVersion(sheetName, templateVersion) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        const details = parseWorksheetToJsonArr<any>({ worksheet });
        details.forEach((detail) => {
          if (detail.stoppedAt instanceof Date) {
            // 예를 들어, toISOString().split('T')[0]를 사용해 "yyyy-mm-dd" 포맷 생성
            detail.stoppedAt = detail.stoppedAt.toISOString().split("T")[0];
          }
          delete detail.regionName;
        });

        if (validateDataIsNonNull(details) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        // NOTE: 상품가 일괄 등록/수정 시 입력된 sku에 따라 해당 상품의 면세 여부 정보를 가져오고, 입력된 가격 정보를 부가세 별도 가격으로 변환하여 저장.
        // 추가 모드: productSku 사용, 수정 모드: bpSku 사용
        let detailsIncludeVat: any[] = [];
        if (isCreateMode) {
          const skuList = details.map((detail) => detail.productSku);

          const { data: pvsData } = await refetchPvListForUpload({
            variables: { first: details.length, filter: { sku: skuList } },
          });
          const pvsForUpload = maybe(() => pvsData?.productVariants?.edges?.map((edge) => edge.node), []);
          detailsIncludeVat = convertUploadValuesToIncludeVat(details, pvsForUpload);
        } else {
          const bpSkuList = details.map((detail) => detail.bpSku);

          const { data: bpvsData } = await refetchBpvListForUpload({
            variables: { first: details.length, filter: { bpSku: bpSkuList } },
          });
          const bpvsForUpload = maybe(() => bpvsData?.brandProductVariants?.edges?.map((edge) => edge.node), []);
          detailsIncludeVat = convertBpvUploadValuesToIncludeVat(details, bpvsForUpload);
        }

        for (const detail of detailsIncludeVat) {
          delete detail.priceExcludeVat;
          delete detail.deliveryFeeExcludeVat;
        }

        // 확인 버튼 클릭 시점이 아닌, 엑셀 파일 선택 및 업로드 시점에 validation 체크
        const isValid = validateDetails(details, isCreateMode);
        if (!isValid) {
          return;
        }
        const convertDetailsStringToBoolean = convertDetailsBooleanValue(details);
        // 모드에 따라 사용하지 않는 SKU 필드 제거 (추가: bpSku 제거, 수정: productSku 제거)
        const cleanedDetails = removeUnusedSkuFields(convertDetailsStringToBoolean, isCreateMode);

        if (enableForB2bService) {
          details.forEach((detail) => ({
            ...detail,
            isExclusive: true,
            isOnlyPayableByCash: false,
            isRcoinRewardForUsingPoint: false,
          }));
        }

        TypeSafeForm.setFields([{ name: "details", value: cleanedDetails }]);
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const onSubmit = async (formData: BrandProductVariantBulkUpdateOrCreateForm) => {
    const { details, manageEvent } = formData;
    const convertedDetails = convertUploadValuesOfBaseProduct(details);
    const errors = await onBulkUpdateOrCreate(convertedDetails, manageEvent);
    if (errors.length <= 0) {
      onModalClose();
    }
  };

  const actionText = isCreateMode ? "등록" : "수정";
  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title={"상품 일괄 " + actionText}
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={form.submit}
      onCancel={onModalClose}
      okButtonProps={{ disabled: utils.isEmpty(detailsWatched) || loading }}
      cancelButtonProps={{ disabled: loading }}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="vertical"
        name="brand-product-variant-bulk-update-or-create-form"
        onFinish={onSubmit}
      >
        <Space direction="vertical" size={0}>
          <Form.Item
            name="details"
            label="상품 정보"
            rules={[{ required: true, message: `상품 일괄 ${actionText} 적용할 엑셀 파일을 선택해 주세요.` }]}
          >
            <Space direction="vertical" size={0}>
              <Button onClick={handleUploadButtonClick} type="primary">
                상품 정보 엑셀파일 선택
              </Button>
              {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
              {errorExist && <Typography.Text type="warning">엑셀 파일을 다시 선택해 주세요.</Typography.Text>}
              <input
                hidden={true}
                id="brandProductVariantBulkUpdateOrCreateInputFile"
                onChange={(e) => readUploadFile(e)}
                type="file"
                ref={upload}
                accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
              />
            </Space>
          </Form.Item>
          {isCreateMode === false && open && (
            <Card type="inner" title="상품 관리 이력">
              {makePvOrBpvManageEventFormItems({
                loading,
                manageEventType,
                choices: brandProductVariantManageEventTypeChoices,
              })}
            </Card>
          )}
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandProductVariantManageEventModal.tsx">
import {
  BrandProductVariantManageEventInput,
  BrandProductVariantManageEventTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { makePvOrBpvManageEventFormItems } from "@src/app/views/product/products/components/PvOrBpvManageEventModal";
import { Button, Form, Modal, ModalProps, Space } from "antd";
import React, { useEffect } from "react";

import { brandProductVariantManageEventTypeChoices } from "../utils";

export interface BrandProductVariantManageEventModalForm {
  manageEvent: BrandProductVariantManageEventInput;
  needReason: boolean;
}

interface BrandProductVariantManageEventFormItemsProps {
  loading: boolean;
  manageEventType: BrandProductVariantManageEventTypeEnum | null;
}

interface BrandProductVariantManageEventModalProps extends BrandProductVariantManageEventFormItemsProps {
  open: boolean;
  isCreateMode: boolean;
  showNeedReasonRadio: boolean;
  onManageEventChange?: (manageEvent: BrandProductVariantManageEventInput) => void;
  onSubmit?: (formData: BrandProductVariantManageEventModalForm) => void;
  onCancel: () => void;
}

export const BrandProductVariantManageEventModal: React.FC<BrandProductVariantManageEventModalProps> = (props) => {
  const { open, loading, isCreateMode, showNeedReasonRadio, manageEventType, onManageEventChange, onSubmit, onCancel } =
    props;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<BrandProductVariantManageEventModalForm>(form);

  const initialValues: BrandProductVariantManageEventModalForm = {
    manageEvent: {
      type: manageEventType,
      title: "",
      reason: "",
    },
    needReason: true,
  };

  useEffect(() => {
    form.resetFields();
  }, [open]);

  const modalTitle = `수정 사유 ${isCreateMode ? "추가" : "조회"}`;
  const commonModalProps: ModalProps = {
    open,
    title: modalTitle,
    destroyOnClose: true,
    forceRender: true,
    onCancel,
    footer: (
      <Space>
        <Button loading={loading} onClick={onCancel}>
          {isCreateMode ? "취소" : "닫기"}
        </Button>
        {isCreateMode && (
          <Button
            type="primary"
            loading={loading}
            onClick={() => {
              // 기존에 saleor에 존재하는 form의 change 이벤트를 antd의 Form 컴포넌트의 onValuesChange에 연동하면 각 Input의 입력 속도가 느려짐. 그래서 수정 중이 아닌 submit 시점에서 값을 onManageEventChange로 전달 후 submit 하도록 설정.
              if (onManageEventChange) {
                onManageEventChange(TypeSafeForm.getFieldValue("manageEvent"));
              }
              form.submit();
            }}
          >
            추가
          </Button>
        )}
      </Space>
    ),
  };

  // TODO: 관리 이력 리스트 페이지에서 이력 번호 클릭을 통해 조회할 경우, 전달되는 이력의 값을 readOnly로 표시
  if (isCreateMode === false) {
    return <Modal {...commonModalProps}></Modal>;
  }
  return (
    <Modal {...commonModalProps}>
      <Form
        layout="vertical"
        form={form}
        name="brand-product-variant-manage-event-form"
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        {makePvOrBpvManageEventFormItems({
          loading,
          manageEventType,
          choices: brandProductVariantManageEventTypeChoices,
          showNeedReasonRadio,
        })}
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandReverseFeeDepositEventModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { SearchBrandsVariables } from "@src/api/searches/types/SearchBrands";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { BrandContractTypeEnum, BrandReverseFeeDepositEventTypeEnum } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getFormInputNumberMinValueRule } from "@src/app/components/antd/Form/validators";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { useBrandCreateReverseFeeDepositEventMutation } from "@src/app/views/brand/brands/api/mutations";
import { BrandCreateReverseFeeDepositEventVariables } from "@src/app/views/brand/brands/api/types/BrandCreateReverseFeeDepositEvent";
import { brandReverseFeeDepositEventsQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Form, Input, InputNumber, Modal, Radio, Select } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect } from "react";

interface BrandReverseFeeDepositEventModalProps {
  open: boolean;
  onClose: () => void;
}
const BrandReverseFeeDepositEventModal: React.FC<BrandReverseFeeDepositEventModalProps> = (props) => {
  const { open, onClose } = props;

  const [searchedBrands, setSearchedBrands] = React.useState([]);

  const [openConfirmModal, setOpenConfirmModal] = React.useState(false);
  const [form] = useForm();
  const TypeSafeForm = getTypeSafeForm<BrandCreateReverseFeeDepositEventVariables>(form);

  const brandId = Form.useWatch("brandId", form);
  const qty = Form.useWatch(["input", "qty"], form);
  const eventType = Form.useWatch(["input", "eventType"], form);

  const [createReverseFeeDepositEvent, {}] = useBrandCreateReverseFeeDepositEventMutation({
    onCompleted: (data) => {
      const errors = data.brandCreateReverseFeeDepositEvent.errors;
      if (errors.length === 0) {
        showNotificationSuccess(
          eventType === BrandReverseFeeDepositEventTypeEnum.DECREASE_BY_ADMIN ? "외상 추가 완료." : "외상 차감 완료."
        );
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [brandReverseFeeDepositEventsQuery],
  });

  const brandSearchVariable: SearchBrandsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.brandsForSearch,
    contractType: [BrandContractTypeEnum.REVERSE_FEE],
  };
  const { loadMore, search, result } = useBrandSearch({ variables: brandSearchVariable });
  const fetchMoreData = {
    hasMore: maybe(() => result.data.search.pageInfo.hasNextPage),
    loading: result.loading,
    onFetchMore: loadMore,
  };

  useEffect(() => {
    setSearchedBrands(
      result.data?.search?.edges.map((edge) => ({
        label: edge.node.name,
        value: edge.node.id,
      }))
    );
  }, [result?.data?.search?.edges]);
  const brandFilterOption = (input: string, option: { label: string; value: string }) =>
    (option?.label ?? "").toLowerCase().includes(input.toLowerCase());

  return (
    <Modal
      forceRender
      closable={false}
      onOk={() => setOpenConfirmModal(true)}
      onCancel={onClose}
      open={open}
      title={"외상 조정"}
      okText="확인"
      cancelText="뒤로"
      okButtonProps={{
        disabled: qty === undefined || qty <= 0 || brandId === undefined,
      }}
      maskClosable={false}
    >
      <Form form={TypeSafeForm.formInstance} colon={false} labelCol={{ span: 24 }} wrapperCol={{ span: 24 }}>
        <Form.Item name="brandId" label="브랜드">
          <Select
            showSearch
            filterOption={brandFilterOption}
            onSearch={search}
            loading={fetchMoreData.loading}
            options={searchedBrands}
            onPopupScroll={fetchMoreData.onFetchMore}
          />
        </Form.Item>

        <Form.Item name={["input", "eventType"]} initialValue={BrandReverseFeeDepositEventTypeEnum.DECREASE_BY_ADMIN}>
          <Radio.Group>
            <Radio value={BrandReverseFeeDepositEventTypeEnum.DECREASE_BY_ADMIN}>추가</Radio>
            <Radio value={BrandReverseFeeDepositEventTypeEnum.INCREASE_BY_ADMIN}>차감</Radio>
          </Radio.Group>
        </Form.Item>
        <Form.Item shouldUpdate>
          {() => (
            <Form.Item
              labelCol={{ span: 24 }}
              wrapperCol={{ span: 24 }}
              rules={[{ required: true }, { type: "integer" }, getFormInputNumberMinValueRule({ min: 1 })]}
              name={["input", "qty"]}
              label={"금액"}
            >
              <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
            </Form.Item>
          )}
        </Form.Item>
        <Form.Item name={["input", "description"]} label="상세내역">
          <Input />
        </Form.Item>
        {openConfirmModal && (
          <ConfirmModal
            visible={openConfirmModal}
            onOk={() => {
              createReverseFeeDepositEvent({
                variables: {
                  ...TypeSafeForm.getFieldsValue(),
                },
              });
              setOpenConfirmModal(false);
            }}
            onCancel={() => setOpenConfirmModal(false)}
          />
        )}
      </Form>
    </Modal>
  );
};

export default BrandReverseFeeDepositEventModal;
</file>

