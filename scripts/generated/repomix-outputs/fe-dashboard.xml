import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { orderDetailsViewUrl } from "@src/app/views/order/orders/urls";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";
import { useParams } from "react-router";

import {
  useCustomerQuestionGetCountQuery,
  useQuestionListFilterDownloadQuery,
  useQuestionListQuery,
} from "../../api/queries";
import { RefundQuestionListVariables } from "../../api/types/RefundQuestionList";
import RefundQuestionListNav from "../../components/RefundQuestionListNav/RefundQuestionListNav";
import RefundQuestionListPage from "../../components/RefundQuestionListPage/RefundQuestionListPage";
import {
  RefundQuestionListViewRouteParams,
  refundQuestionListViewUrl,
  RefundQuestionListViewUrlDialog,
  RefundQuestionListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { getSortQueryVariables } from "./sort";

interface RefundQuestionListViewProps {
  defaultParams: RefundQuestionListViewUrlQueryParams;
  params: RefundQuestionListViewUrlQueryParams;
}

const RefundQuestionListView: React.FC<RefundQuestionListViewProps> = (props) => {
  const { defaultParams, params } = props;
  const routeParams = useParams<RefundQuestionListViewRouteParams>();
  const isFbv = routeParams.fulfilledBy === "vendor";

  const { user } = useUser();
  const { isVendorStaff } = user;

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(ListViews.REFUND_QUESTION_LIST, [
      routeParams.fulfilledBy,
      routeParams.status,
    ]),
  });
  const targetUrl = (params: RefundQuestionListViewUrlQueryParams) => refundQuestionListViewUrl(routeParams, params);

  const { fetchForDownload } = utils.initListViewDownloadQuery(useQuestionListFilterDownloadQuery);

  const queryVariables = React.useMemo<RefundQuestionListVariables>(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        isFbv,
        vendor: isVendorStaff ? user?.vendor?.id : null,
      },
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useQuestionListQuery({ variables: queryVariables });
  const { data: countData, refetch: countRefetch } = useCustomerQuestionGetCountQuery({
    variables: {
      filter: {
        isFbv,
        vendor: isVendorStaff ? user?.vendor?.id : null,
      },
    },
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.refundQuestions?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<RefundQuestionListViewUrlDialog, RefundQuestionListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const handleSort = createSortHandler(navigate, targetUrl, params);

  React.useEffect(() => {
    countRefetch();
  }, [params, settings?.rowNumber]);

  return (
    <>
      <RefundQuestionListNav countData={countData} />
      <RefundQuestionListPage
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        currentTab={currentTab}
        onFilterChange={changeFilters}
        filterOpts={getFilterOpts(params)}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onSort={handleSort}
        sort={getSortParams(params)}
        customerQuestions={maybe(() => data.refundQuestions.edges.map((edge) => edge.node))}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onRowRefundBtnClick={({ id, refundId }) =>
          navigate(`${orderDetailsViewUrl(id)}refund=${encodeURIComponent(refundId)}`)
        }
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};

export default RefundQuestionListView;
</file>

