          {
            record,
            courierDeliveryAdditionalFeeList,
            isConsignment: isConsignmentType,
            poEventType,
          },
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={totalCostPriceExcludeVat} />;
      },
      renderExcel: (record) =>
        calcPoLineTotalCostPriceExcludeVat(
          {
            record,
