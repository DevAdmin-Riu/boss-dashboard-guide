  };
  const buyMethodSearchFilter = {
    ...createTextField(0, PvEstimateListFilterKeys.buyMethodSearch, "구매방식", opts.buyMethodSearch.value),
    active: opts.buyMethodSearch.active,
  };
  const sameOrReplacementSearchFilter = {
    ...createTextField(
      0,
      PvEstimateListFilterKeys.sameOrReplacementSearch,
