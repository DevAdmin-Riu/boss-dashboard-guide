import { SendComplain, SendComplainVariables } from "./types/SendComplain";

const scheduleCreateMutation = gql`
  ${scheduleFragment}
  ${scheduleErrorFragment}
  mutation ScheduleCreate($input: ScheduleInput!) {
    scheduleCreate(input: $input) {
      schedule {
        ...ScheduleFragment
