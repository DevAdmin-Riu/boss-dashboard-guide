import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

import { typeChoices } from "./utils";

export enum PaidNoticeCountEventFilterKeys {
  brandSearch = "brandSearch",
  toFbvVendorSearch = "toFbvVendorSearch",
  created = "created",
  type = "type",
}

export interface PaidNoticeCountEventListFilterOpts {
  brandSearch: FilterOpts<string>;
  toFbvVendorSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  type: FilterOpts<PaidNoticeCountEventTypeEnum[]>;
}

export function createFilterStructure(
  opts: PaidNoticeCountEventListFilterOpts,
  isHqStaff: boolean
): IFilter<PaidNoticeCountEventFilterKeys> {
  let displayOrder = 0;
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      PaidNoticeCountEventFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const toFbvVendorSearchFilter = {
    ...createTextField(
      displayOrder++,
      PaidNoticeCountEventFilterKeys.toFbvVendorSearch,
      "협력사코드 / 협력사명",
      opts.toFbvVendorSearch.value
    ),
    active: opts.toFbvVendorSearch.active,
  };
  const createdFilter = {
    ...createDateField(displayOrder++, PaidNoticeCountEventFilterKeys.created, "추가/차감일", opts.created.value),
    active: opts.created.active,
  };
  const typeFilter = {
    ...createOptionsField(
      displayOrder++,
      PaidNoticeCountEventFilterKeys.type,
      "구분",
      opts.type.value,
      true,
      typeChoices
    ),
    active: opts.type.active,
  };
  return [isHqStaff === false && brandSearchFilter, toFbvVendorSearchFilter, createdFilter, typeFilter].filter(Boolean);
}
