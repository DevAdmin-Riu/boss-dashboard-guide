  const setEstimateDataTemplateUrl = `${s3TemplateUrl}/set_estimate_data.xlsx`;

  const columns = getPvEstimateListTableSettings();
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const purchaseTableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const rowSelection: TableRowSelection<PvEstimateAiList_pvEstimateAiList_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys) => {
      setSelectedRowIds(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record) => ({
      disabled:
        record.status === PvEstimateStatus.NA ||
        (selectedRowIds.length > 0 &&
          pvEstimateList.filter((item) => item.id === selectedRowIds[0])[0].status !== record.status),
    }),
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "pvEstimateList",
  };
  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.pvEstimate}</Typography.Title>
        </Col>
        <Col>
          <Space direction="horizontal" size="small">
            <Button
              type="primary"
              shape="round"
              disabled={selectedRowIds.length === 0}
              onClick={showBulkStatusUpdateModal}
            >
              채택 여부 변경
            </Button>
            <Button type="primary" shape="round" icon={<DownloadOutlined />} href={setEstimateDataTemplateUrl}>
              견적 양식 다운로드
            </Button>
            <Button type="primary" shape="round" onClick={showBulkCreateModal}>
              견적 데이터 저장
            </Button>
          </Space>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={listProps.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={pvEstimateList}
          rowSelection={rowSelection}
          scroll={{ x: purchaseTableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};

export default PvEstimatePage;
