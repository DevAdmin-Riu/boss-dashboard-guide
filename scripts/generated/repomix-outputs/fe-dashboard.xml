import { transformPaymentStatus } from "@assets/messages/status";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getStatisticClassName } from "@src/app/components/antd/Statistic/StatisticProps";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import StatusLabel from "@src/app/components/StatusLabel";
import { DateTime, getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { getStockSpec } from "@src/app/views/product/stock/utils";
import { checkIsInteger, convertDeliveryTypeEnumToWord, getBrandName, getDisplayInnerProductName } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Form, FormInstance, InputNumber, Statistic, Typography } from "antd";
import React from "react";

import { OrderLineListForFulfill_orderLines_edges_node } from "../../api/types/OrderLineListForFulfill";
import { UnfulfilledOrderLineListPageProps } from "./UnfulfilledOrderLineListPage";
import {
  getCheckboxDisabledProp,
  isUnfulfillmentViewPickingOrder,
  isUnfulfillmentViewStock,
  isUnfulfillmentViewStockEtc,
  submitFragmentedFulfillmentRow,
  UnfulfillmentViewTypeEnum,
} from "./utils";

export function getUnfulfilledOrderLineTableSettings(
  form: FormInstance,
  props: UnfulfilledOrderLineListPageProps
): DownloadableColumnsType<OrderLineListForFulfill_orderLines_edges_node> {
  const { unfulfillmentViewType } = props;
  const isFulfilledByVendor = unfulfillmentViewType === UnfulfillmentViewTypeEnum.FULFILLED_BY_VENDOR;
  const fixedRightFlag = isUnfulfillmentViewPickingOrder(unfulfillmentViewType) ? utils.fixedRightFlag() : undefined;

  let columns: DownloadableColumnsType<OrderLineListForFulfill_orderLines_edges_node>;
  const orderComposedIdColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_COMPOSED_ID,
    key: "orderComposedId",
    width: 100,
    render: (_, record) => (
      <Typography.Link onClick={() => props.onRowClick(record.order.id)}>
        {record.order.composedIdWithPrefix}
      </Typography.Link>
    ),
    renderExcel: (record) => record.order.composedIdWithPrefix,
  };
  const orderLineComposedIdColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
    key: "orderLineComposedId",
    width: 120,
    render: (_, record) => record.composedIdWithPrefix,
  };

  const orderCreatedColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_DATE,
    key: "created",
    width: 120,
    render: (_, record) => <DateTime date={record.order.created} />,
    renderExcel: (record) => getDateByFormat(record.order.created),
  };
  const paymentStatusColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.order.PAYMENT_STATUS,
    key: "paymentStatus",
    width: 120,
    render: (_, record) => {
      const paymentStatus = transformPaymentStatus(record.order);
      return <StatusLabel useSmallDot status={paymentStatus.status} label={paymentStatus.localized} />;
    },
    renderExcel: (record) => transformPaymentStatus(record.order).localized,
  };
  const brandCodeColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brand.BRAND_CODE,
    key: "brandCode",
    width: 100,
    render: (_, record) => record.order.user?.brand?.code,
  };
  const brandNameColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brand.BRAND_NAME,
    key: "brand",
    width: 120,
    render: (_, record) => getBrandName(record.order.user),
  };
  const userLoginIdColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.user.ID,
    key: "loginId",
    width: 120,
    render: (_, record) => record.order.user?.loginId,
  };
  const userFirstNameColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.user.USER_NAME,
    key: "firstName",
    width: 120,
    render: (_, record) => record.order.user?.firstName,
  };
  const deliveryMethodColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.delivery.DELIVERY_METHOD,
    key: "deliveryMethod",
    width: 120,
    render: (_, record) => convertDeliveryTypeEnumToWord(record.order.deliveryMethod),
  };
  const productSkuColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.product.SKU,
    key: "productSku",
    width: 120,
    render: (_, record) => record.productSku,
  };
  const productNameColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.product.PRODUCT_NAME,
    key: "productName",
    width: 150,
    render: (_, record) =>
      getDisplayInnerProductName(record.variant.product.name || "-", record.variant.isInner) || "-",
  };
  const variantNameColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    width: 100,
    render: (_, record) => record.variantName || "-",
  };
  const attributesColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    width: 200,
    render: (_, record) => getStockSpec(record.variant),
  };
  const quantityFixedColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.fulfillment.ORDER_QUANTITY,
    key: "quantity",
    width: 80,
    fixed: fixedRightFlag,
    render: (_, record) => (
      <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={record.orderedOrFulfillQty} />
    ),
    renderExcel: (record) => record.orderedOrFulfillQty,
  };
  const quantityUnfulfilledColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.fulfillment.WAITING,
    key: "quantityUnfulfilled",
    width: 80,
    render: (_, record) => (
      <Statistic
        className={getStatisticClassName(["ant-statistic-small"])}
        value={record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded}
      />
    ),
    renderExcel: (record) => record.orderedOrFulfillQty - record.quantityFulfilled - record.quantityRefunded,
  };
  const fragmentFullfillmentColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    align: "center",
    title: "분할 출고",
    key: "fragmentFullfillment",
    width: 120,
    render: (_, record) => (
      <Button
        type="primary"
        disabled={getCheckboxDisabledProp(record)}
        onClick={() => {
          submitFragmentedFulfillmentRow(form, record.id, props.onSubmit, isFulfilledByVendor);
        }}
      >
        {checkIsInteger(record.variant?.product?.moq) === false ||
        checkIsInteger(record.variant?.product?.uoq) === false
          ? "전량 출고"
          : "분할 출고"}
      </Button>
    ),
    renderExcel: (record) => {
      const moq = record.variant?.product?.moq;
      const uoq = record.variant?.product?.uoq;

      const buttonText = checkIsInteger(moq) === false || checkIsInteger(uoq) === false ? "전량 출고" : "분할 출고";

      return buttonText;
    },
  };
  // 재고제품 중 합포장 출고 시 이너제품의 재고 수량을 보여주기 위한 컬럼
  const innerStockQuantityColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
    title: "이너박스 재고",
    key: "innerStockQuantity",
    align: "center",
    width: 100,
    fixed: fixedRightFlag,
    render: (_, record) => (
      <Statistic
        className={getStatisticClassName(["ant-statistic-small"])}
        value={record.variant?.stocks?.reduce((acc, stock) => acc + stock.quantity, 0)}
      />
    ),
    renderExcel: (record) => record.variant?.stocks?.reduce((acc, stock) => acc + stock.quantity, 0),
  };
  // 재고제품 중 합포장 출고 시 소분할 아우터제품의 수량을 보여주기 위한 컬럼
  const outerVirtualAllocateColumn: DownloadableColumnType<OrderLineListForFulfill_orderLines_edges_node> = {
