import { BrandHistoryFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  BrandHistoryFilterKeys,
  BrandHistoryListFilterOpts,
} from "@src/app/views/brand/brandHistory/components/BrandHistoryListPage/filters";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  BrandHistoryListViewUrlFilters,
  BrandHistoryListViewUrlFiltersEnum,
  BrandHistoryListViewUrlQueryParams,
} from "../../urls";

export const BRAND_HISTORY_FILTERS_KEY = "brandHistoryFilters";

export function getFilterOpts(params: BrandHistoryListViewUrlFilters): BrandHistoryListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    writerSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.writerSearch, true), false),
      value: maybe(() => filterVariables.writerSearch, ""),
    },
    oldMdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.oldMdSearch, true), false),
      value: maybe(() => filterVariables.oldMdSearch, ""),
    },
  };
}

export function getFilterVariables(params: BrandHistoryListViewUrlFilters): BrandHistoryFilterInput {
  return {
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    title: params.title !== undefined ? params.title : null,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    writerSearch: params.writerSearch !== undefined ? params.writerSearch : null,
    oldMdSearch: params.oldMdSearch !== undefined ? params.oldMdSearch : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<BrandHistoryFilterKeys>): BrandHistoryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandHistoryFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        BrandHistoryListViewUrlFiltersEnum.createdFrom,
        BrandHistoryListViewUrlFiltersEnum.createdTo
      );
    case BrandHistoryFilterKeys.title:
      return getSingleValueQueryParam(filter, BrandHistoryListViewUrlFiltersEnum.title);
    case BrandHistoryFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandHistoryListViewUrlFiltersEnum.brandSearch);
    case BrandHistoryFilterKeys.writerSearch:
      return getSingleValueQueryParam(filter, BrandHistoryListViewUrlFiltersEnum.writerSearch);
    case BrandHistoryFilterKeys.oldMdSearch:
      return getSingleValueQueryParam(filter, BrandHistoryListViewUrlFiltersEnum.oldMdSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandHistoryListViewUrlFilters>(BRAND_HISTORY_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BrandHistoryListViewUrlQueryParams,
  BrandHistoryListViewUrlFilters
>(BrandHistoryListViewUrlFiltersEnum);
</file>

