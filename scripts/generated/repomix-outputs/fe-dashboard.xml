import { utils } from "@utils/utils";
import { Statistic } from "antd";
import React from "react";

import { getStatisticClassName, StatisticClassName } from "../antd/Statistic/StatisticProps";
import { IMoney } from "../Money";

export interface MoneyRangeProps {
  from?: IMoney;
  to?: IMoney;
  includeCurrency?: boolean;
  statisticClassName?: StatisticClassName[];
}

const formatMoney = (money: IMoney) => `${money.amount.toLocaleString()}`;

export const MoneyRange: React.FC<MoneyRangeProps> = ({
  from,
  to,
  includeCurrency,
  statisticClassName = ["ant-statistic-small"],
}) => {
  const value =
    from && to
      ? utils.formatMessage("{fromMoney} ~ {toMoney}", {
          fromMoney: formatMoney(from),
          toMoney: formatMoney(to),
        })
      : from && !to
      ? utils.formatMessage("{money} ~", {
          money: formatMoney(from),
        })
      : !from && to
      ? utils.formatMessage("~ {money}", {
          money: formatMoney(to),
        })
      : "-";
  return (
    <Statistic
      className={getStatisticClassName(statisticClassName)}
      value={value}
      suffix={includeCurrency ? "원" : null}
    />
  );
};

MoneyRange.defaultProps = {
  includeCurrency: true,
};
export default MoneyRange;
</file>

