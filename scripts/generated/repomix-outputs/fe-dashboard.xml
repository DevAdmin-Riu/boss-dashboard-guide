import useNavigator from "@hooks/useNavigator";
import StatusLabel from "@src/app/components/StatusLabel";
import { BannerList_banners_edges_node } from "@src/app/views/notice/banners/api/types/BannerList";
import { bannerDetailsViewUrl } from "@src/app/views/notice/banners/urls";
import { utils } from "@utils/utils";
import { Tag, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import moment from "moment";
import React from "react";

export function getBannerListTableSettings() {
  const navigate = useNavigator();
  const onEditClick = (record: BannerList_banners_edges_node) => {
    navigate(bannerDetailsViewUrl(record.id));
  };
  const columns: ColumnsType<BannerList_banners_edges_node> = [
    {
      title: "배너명",
      align: "left",
      key: "name",
      width: 200,
      render: (_, record) => <Typography.Link onClick={() => onEditClick(record)}>{record.name}</Typography.Link>,
    },
    {
      title: "게시 시작일",
      align: "center",
      key: "start",
      width: 120,
      render: (_, record) => record.start,
    },
    {
      title: "게시 마감일",
      align: "center",
      key: "end",
      width: 120,
      render: (_, record) =>
        moment(record.end).diff(moment(record.start), "years") <= 100 ? record.end : "마감일 미설정",
    },
    {
      title: "게시 여부",
      align: "center",
      key: "visibleToBrand",
      width: 80,
      render: (_, record) => <StatusLabel status={record.visibleToBrand ? "success" : "error"} useSmallDot={false} />,
    },
    {
      title: "게시 브랜드",
      align: "center",
      key: "availableBrands",
      width: 300,
      render: (_, record) => {
        if (record.availableToAllBrands) {
          return <Tag>전체 브랜드 게시</Tag>;
        }
        const availableBrandNames = record.availableBrands.map((brand) => brand.name);
        return utils.summarizeArray(availableBrandNames, 3, "브랜드");
      },
    },
  ];
  return columns;
}
