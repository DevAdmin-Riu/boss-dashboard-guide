  };

  const trackInventoryVariantTypeColumn: DownloadableColumnType<ProductDataSourceType> = {
    title: columnNameConstant.product.TRACK_INVENTORY,
    titleExcel: columnNameConstant.product.TRACK_INVENTORY,
    key: "trackInventoryVariantType",
    align: "center",
    width: 80,
    render: (_, record) => makeTrackInventoryVariantType(record),
