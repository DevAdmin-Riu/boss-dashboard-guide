import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import {
  productVariantForPurchaseOrderLineFragment,
  productVariantForStockPOLineFragment,
} from "@src/api/fragments/products";
import {
  purchaseOrderDetailsFragment,
  purchaseOrderForCreateFragment,
  purchaseOrderLineForListFragment,
  purchaseOrderPrintFragment,
} from "@src/api/fragments/purchaseOrders";
import gql from "graphql-tag";

import { PrintPurchaseOrder, PrintPurchaseOrderVariables } from "./types/PrintPurchaseOrder";
import { PurchaseLineCount, PurchaseLineCountVariables } from "./types/PurchaseLineCount";
import { PurchaseOrderDetails, PurchaseOrderDetailsVariables } from "./types/PurchaseOrderDetails";
import { PurchaseOrderLineCount, PurchaseOrderLineCountVariables } from "./types/PurchaseOrderLineCount";
import { PurchaseOrderLineList, PurchaseOrderLineListVariables } from "./types/PurchaseOrderLineList";
import { PurchaseOrderListForCreate, PurchaseOrderListForCreateVariables } from "./types/PurchaseOrderListForCreate";

export const purchaseOrderListForCreateQuery = gql`
  ${purchaseOrderForCreateFragment}
  ${pageInfoFragment}
  query PurchaseOrderListForCreate(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: PurchaseOrderFilterInput
    $sort: PurchaseOrderSortingInput
  ) {
    purchaseOrders(before: $before, after: $after, first: $first, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...PurchaseOrderForCreateFragment
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const usePurchaseOrderListForCreateQuery = makeQuery<
  PurchaseOrderListForCreate,
  PurchaseOrderListForCreateVariables
>(purchaseOrderListForCreateQuery);

export const purchaseOrderLineListQuery = gql`
  ${purchaseOrderLineForListFragment}
  ${pageInfoFragment}
  query PurchaseOrderLineList(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: PurchaseOrderLineFilterInput
    $sort: PurchaseOrderLineSortingInput
    $afterStatusList: [PurchaseOrderLineStatusEnum]
    $isVendorStaff: Boolean = false
  ) {
    purchaseOrderLines(before: $before, after: $after, first: $first, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...PurchaseOrderLineForListFragment
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const usePurchaseOrderLineListQuery = makeQuery<PurchaseOrderLineList, PurchaseOrderLineListVariables>(
