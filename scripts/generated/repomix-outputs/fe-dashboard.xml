export const getBrandStoreConsultationListTableSettings = (props: BrandStoreConsultationListPageProps) => {
  const { user, onShowDetailRecord } = props;
  const isStaff = user.isStaff;

  const titleColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: columnNameConstant.common.TITLE,
    key: "title",
    width: 200,
    render: (_, record) => record?.title || "-",
  };

  const reportColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: columnNameConstant.brandStore.REPORT,
    key: "report",
    width: 100,
    render: (_, record) => record?.report?.title || "-",
  };

  const brandCodeColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: columnNameConstant.brand.BRAND_CODE,
    key: "brandCode",
    align: "center",
    width: 100,
    render: (_, record) => record.brandStore.brand.code,
  };
  const brandNameColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: columnNameConstant.brand.BRAND_NAME,
    key: "brandName",
    width: 150,
    render: (_, record) => record.brandStore.brand.name,
  };
  const brandStoreCodeColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> =
    {
      title: columnNameConstant.brandStore.BRAND_STORE_CODE,
      key: "brandStoreCode",
      align: "center",
      width: 120,
      render: (_, record) => record.brandStore.code,
    };
  const brandStoreNameColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> =
    {
      title: columnNameConstant.brandStore.BRAND_STORE_NAME,
      key: "brandStoreName",
      width: 200,
      render: (_, record) => record.brandStore.name,
    };

  const createdAtColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: columnNameConstant.brandStore.CONSULTATION_DATE,
    key: "createdAt",
    align: "center",
    width: 120,
    render: (_, record) => getDateByFormat(record.createdAt, onlyDateFormat),
  };

  const showDetailColumn: DownloadableColumnType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = {
    title: "상세보기",
    key: "showDetail",
    align: "center",
    width: 100,
    render: (_, record) => <Button onClick={() => onShowDetailRecord(record)}>상세보기</Button>,
  };

  const columns: DownloadableColumnsType<BrandStoreConsultationList_brandStoreConsultationList_edges_node> = [
    titleColumn,
    reportColumn,
    isStaff && brandCodeColumn,
    isStaff && brandNameColumn,
    brandStoreCodeColumn,
    brandStoreNameColumn,
    createdAtColumn,
    !isStaff && showDetailColumn,
  ].filter(Boolean);
  return columns;
};
