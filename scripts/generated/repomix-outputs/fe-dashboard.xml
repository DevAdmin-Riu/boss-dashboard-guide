import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { ExclusiveVariantMonthlyStockInfoForBrandsVariables } from "../../api/types/ExclusiveVariantMonthlyStockInfoForBrands";
import {
  BrandExclusiveVariantStockInfoFilterKeys,
  BrandExclusiveVariantStockInfoListFilterOpts,
} from "../../components/BrandExclusiveVariantStockInfoListPage/filters";
import {
  BrandExclusiveVariantStockInfoListViewUrlFilters,
  BrandExclusiveVariantStockInfoListViewUrlFiltersEnum,
  BrandExclusiveVariantStockInfoListViewUrlQueryParams,
} from "../../urls";

const BRAND_EXCLUSIVE_VARIANT_STOCK_INFO_FILTERS_KEY = "brandExclusiveVariantStockInfoFilters";

export function getFilterOpts(
  params: BrandExclusiveVariantStockInfoListViewUrlQueryParams
): BrandExclusiveVariantStockInfoListFilterOpts {
  const todayMoment = moment().startOf("month");
  const filterVariables = getFilterVariables(params);

  return {
    statDate: {
      active: maybe(() => !utils.isEmpty(filterVariables.statDate), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, todayMoment.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.statDate.gte, todayMoment.format(onlyMonthFormat)),
      },
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(params.brandSearch, true), false),
      value: maybe(() => params.brandSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: BrandExclusiveVariantStockInfoListViewUrlFilters
): ExclusiveVariantMonthlyStockInfoForBrandsVariables {
  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<BrandExclusiveVariantStockInfoFilterKeys>
): BrandExclusiveVariantStockInfoListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandExclusiveVariantStockInfoFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        BrandExclusiveVariantStockInfoListViewUrlFiltersEnum.statDateFrom,
        BrandExclusiveVariantStockInfoListViewUrlFiltersEnum.statDateTo
      );
    case BrandExclusiveVariantStockInfoFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandExclusiveVariantStockInfoListViewUrlFiltersEnum.brandSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandExclusiveVariantStockInfoListViewUrlFilters>(
    BRAND_EXCLUSIVE_VARIANT_STOCK_INFO_FILTERS_KEY
  );

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BrandExclusiveVariantStockInfoListViewUrlQueryParams,
  BrandExclusiveVariantStockInfoListViewUrlFilters
>({ ...BrandExclusiveVariantStockInfoListViewUrlFiltersEnum });
</file>

