} from "./filters";

interface BrandStoreListViewProps {
  params: BrandStoreListViewUrlQueryParams;
}

enum BrandStoreListModalModeEnum {
  CreateBrandStore = "CreateBrandStore",
}

export const BrandStoreListView: React.FC<BrandStoreListViewProps> = ({ params }) => {
  const shop = useShop();
  const { user } = useAuth();
  const isHqStaff = user?.isHqStaff;
  const brandId = getBrandId(user);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BRAND_STORE_LIST,
  });
  const targetUrl = brandStoreListViewUrl;
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBrandStoreListFilterDownloadQuery);
  const [modalMode, setModalMode] = React.useState<BrandStoreListModalModeEnum>(null);

  const finalBrandStoreDetailsUrl = isHqStaff ? hqBrandStoreDetailsViewUrl : brandStoreDetailsViewUrl;

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const openModalWithoutNavigate = (modalMode: BrandStoreListModalModeEnum) => {
    setModalMode(modalMode);
  };

  const filter = getFilterVariables(params);
  if (isHqStaff) {
    filter.brandId = brandId;
  }
  const queryVariables: BrandStoreListVariables = React.useMemo(
    () => ({ ...paginationState, filter }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBrandStoreListQuery({ initialListSkip: true, variables: queryVariables });

  const filterOpts = getFilterOpts(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brandStores?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<BrandStoreListViewUrlDialog, BrandStoreListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <BrandStoreListPage
        shop={shop}
        isHqStaff={isHqStaff}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        me={maybe(() => user)}
        brandStores={maybe(() => data.brandStores.edges.map((edge) => edge.node))}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onBrandStoreCreate={() => openModalWithoutNavigate(BrandStoreListModalModeEnum.CreateBrandStore)}
        onRowClick={(id) => navigate(finalBrandStoreDetailsUrl(id))}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      {modalMode === BrandStoreListModalModeEnum.CreateBrandStore && (
        <BrandStoreCreateModal
          brandId={isHqStaff ? brandId : undefined}
          open={modalMode === BrandStoreListModalModeEnum.CreateBrandStore}
          onClose={resetForCloseModal}
          refetchQueries={[brandStoreListQuery]}
        />
      )}

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
