import { formRuleMsg } from "@assets/messages/commonMsg";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { purchaseLineCountQuery } from "@src/app/views/purchase/purchaseOrders/api/queries";
import { purchaseListQuery } from "@src/app/views/purchase/purchases/api/queries";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Typography } from "antd";
import moment from "moment";
import React, { useEffect } from "react";

import { usePurchaseBulkReqRevisionMutation } from "../../api/mutations";
import { PurchaseBulkReqRevisionVariables } from "../../api/types/PurchaseBulkReqRevision";

interface VsPurchaseBulkReqRevisionModalProps {
  open: boolean;
  loading: boolean;
  purchaseIds: string[];
  purchaseCloseDate: string | null;
  onCancel: (shouldReset: boolean) => void;
}

export const VsPurchaseBulkReqRevisionModal: React.FC<VsPurchaseBulkReqRevisionModalProps> = (props) => {
  const { open, loading, purchaseIds, purchaseCloseDate, onCancel } = props;
  const [form] = Form.useForm<PurchaseBulkReqRevisionVariables>();

  const initialValues: PurchaseBulkReqRevisionVariables = {
    ids: purchaseIds,
    purchaseCloseDate,
    reqRevisionReason: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [purchaseBulkReqRevision, purchaseBulkReqRevisionOpts] = usePurchaseBulkReqRevisionMutation({
    onCompleted: (data) => {
      const errors = data.purchaseBulkReqRevision.errors;
      if (errors.length === 0) {
        showNotificationSuccess(`선택한 ${data.purchaseBulkReqRevision.count}건의 정산 내역이 수정 요청되었습니다.`);
        onCancel(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [purchaseListQuery, purchaseLineCountQuery],
  });

  const onSubmit = (formData: PurchaseBulkReqRevisionVariables) => {
    if (purchaseIds.length === 0) {
      showNotificationWarn("발주 품목을 선택해주세요.");
      return;
    }
    if (utils.isEmpty(purchaseCloseDate)) {
      showNotificationError("마감월 필터 선택하여 조회 후 요청해주세요.");
      return;
    }

    const formattedPurchaseCloseDate = moment(purchaseCloseDate).endOf("month").format(onlyDateFormat);
    const { reqRevisionReason } = formData;
    purchaseBulkReqRevision({
      variables: { ids: purchaseIds, purchaseCloseDate: formattedPurchaseCloseDate, reqRevisionReason },
    });
  };

  const modalLoading = loading || purchaseBulkReqRevisionOpts.loading;

  return (
    <Modal
      closable={false}
      open={open}
      onCancel={() => onCancel(false)}
      onOk={form.submit}
      okText="요청"
      okButtonProps={{ danger: true, type: "primary", loading: modalLoading }}
      title="수정 요청"
      maskClosable={false}
    >
      <Form form={form} initialValues={initialValues} onFinish={onSubmit}>
        <Typography.Title level={4} style={{ marginBottom: 4 }}>
          수정 요청 사유를 입력해주세요.
        </Typography.Title>
        <Form.Item
          name="reqRevisionReason"
          rules={[{ required: true, type: "string", min: 1, message: formRuleMsg.min(1, "자") }]}
        >
          <Input.TextArea rows={4} placeholder="수정 요청 사유를 입력해주세요." />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

