<file path="src/app/views/purchase/purchaseOrders/components/PurchaseOrderCreatePage/utils.ts">
import { PurchaseOrderEventTypeEnum } from "@src/api/types/globalTypes";
import { ShopInfo_shop_defaultWarehouse } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { WarehouseWithAddressList_warehouses_edges_node_addresses } from "@src/app/views/settings/warehouses/api/types/WarehouseWithAddressList";
import { transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { PurchaseOrderDetails_purchaseOrder } from "../../api/types/PurchaseOrderDetails";
import { PurchaseOrderCreateViewRouteParams } from "../../urls";
import { calcConsignmentTakeBackCostPriceExcludeVat } from "../../utils";
import { makePoLineRowToAdd } from "../PurchaseOrderCreateLines/PurchaseOrderCreateLinesTableSettings";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePageFormData,
  TPurchaseOrderCreateLinesObj,
} from "./PurchaseOrderCreatePage";

export const makeUniquePoCreateLineKey = (variantId: string, orderLineId: string) => {
  if (utils.isEmpty(orderLineId, true)) {
    return variantId;
  }
  return `${variantId}-${orderLineId}`;
};

export const EXTERNAL_WAREHOUSE_ID = "externalWarehouseId";
export const VIRTUAL_WAREHOUSE_ID_PREFIX = "virtual-";

export interface IPoDeliveryAddress {
  id: string; // warehouse address ID
  warehouseId: string; // warehouse ID
  warehouseName: string;
  addressData: WarehouseWithAddressList_warehouses_edges_node_addresses | null; // address 정보
}

export function makePoDeliveryWarehouseList(defaultWarehouse: ShopInfo_shop_defaultWarehouse): IPoDeliveryAddress[] {
  const addressList: IPoDeliveryAddress[] = [];

  // defaultWarehouse의 addresses를 addressList에 추가
  if (defaultWarehouse?.addresses) {
    defaultWarehouse.addresses.forEach((address) => {
      if (address) {
        addressList.push({
          id: address.id,
          warehouseId: defaultWarehouse.id,
          warehouseName: address.companyName,
          addressData: address,
        });
      }
    });
  }

  // 외부업체 추가
  addressList.push({
    id: EXTERNAL_WAREHOUSE_ID,
    warehouseId: EXTERNAL_WAREHOUSE_ID,
    warehouseName: "외부업체",
    addressData: null,
  });

  return addressList;
}

const getTrackInventoryInitialValues = (
  warehouseList: IPoDeliveryAddress[],
  sourcePurchaseOrder: PurchaseOrderDetails_purchaseOrder | null,
  isB2b: boolean = false
): PurchaseOrderCreatePageFormData => {
  const commonInitialValues: Pick<
    PurchaseOrderCreatePageFormData,
    "eventType" | "purchaseOrderDate" | "defaultAskingPurchaseDate"
  > = {
    purchaseOrderDate: moment(),
    eventType: PurchaseOrderEventTypeEnum.REORDER,
    defaultAskingPurchaseDate: null,
  };

  if (utils.isEmpty(sourcePurchaseOrder)) {
    const defaultAddress = !utils.isEmpty(warehouseList) && warehouseList?.length > 0 ? warehouseList[0] : null;
    const addressData = defaultAddress?.addressData;

    const initialValuesWithoutSource: PurchaseOrderCreatePageFormData = {
      ...commonInitialValues,
      bySourcePo: null,
      sourcePurchaseOrder: null,
      vendor: null,
      warehouse: defaultAddress?.warehouseId,
      warehouseAddress: defaultAddress?.id,
      deliveryWarehouseName: defaultAddress?.warehouseName,
      deliveryWarehouseManager: addressData?.firstName,
      phone: utils.isEmpty(addressData?.phone) ? null : transformPhoneNumber(addressData?.phone),
      streetAddress1: addressData?.streetAddress1,
      streetAddress2: addressData?.streetAddress2,
      postalCode: addressData?.postalCode,
      isNotOrderableBeforeStocked: false,
      isForPackageOrder: false,
      linesObj: {},
      isB2b,
    };
    return initialValuesWithoutSource;
  } else {
    const initialValuesWithSource: PurchaseOrderCreatePageFormData = {
      ...commonInitialValues,
      bySourcePo: true,
      sourcePurchaseOrder: sourcePurchaseOrder.id,
      vendor: sourcePurchaseOrder.vendor.id,
      warehouse: sourcePurchaseOrder.warehouse.id,
      warehouseAddress: null,
      deliveryWarehouseName: sourcePurchaseOrder.deliveryWarehouseName,
      deliveryWarehouseManager: sourcePurchaseOrder.deliveryWarehouseManager,
      phone: utils.isEmpty(sourcePurchaseOrder.phone) ? null : transformPhoneNumber(sourcePurchaseOrder.phone),
      streetAddress1: sourcePurchaseOrder.streetAddress1,
      streetAddress2: sourcePurchaseOrder.streetAddress2,
      postalCode: sourcePurchaseOrder.postalCode,
      isNotOrderableBeforeStocked: sourcePurchaseOrder.isNotOrderableBeforeStocked,
      isForPackageOrder: sourcePurchaseOrder.isForPackageOrder,
      linesObj: {},
      isB2b,
    };
    return {
      ...initialValuesWithSource,
      linesObj: sourcePurchaseOrder.lines.reduce<TPurchaseOrderCreateLinesObj>((acc, line) => {
        const lineKey = makeUniquePoCreateLineKey(line.variant?.id, null);
        const poLineToAdd = makePoLineRowToAdd(
          line.variant,
          initialValuesWithSource,
          initialValuesWithSource.purchaseOrderDate
        );
        acc[lineKey] = {
          ...poLineToAdd,
          vendorId: initialValuesWithSource.vendor,
          quantity: line.quantity,
          costPriceExcludeVat: line.costPriceExcludeVat,
          note: line.note,
        };
        return acc;
      }, {}),
    };
  }
};

const getConsignmentInitialValues = (): PurchaseOrderCreatePageFormData => ({
  bySourcePo: null,
  sourcePurchaseOrder: null,
  purchaseOrderDate: moment(),
  eventType: PurchaseOrderEventTypeEnum.CONSIGNMENT,
  vendor: null,
  warehouse: null,
  warehouseAddress: null,
  deliveryWarehouseName: null,
  deliveryWarehouseManager: null,
  phone: null,
  streetAddress1: null,
  streetAddress2: null,
  postalCode: null,
  defaultAskingPurchaseDate: null,
  isNotOrderableBeforeStocked: false,
  isForPackageOrder: false,
  linesObj: {},
  isB2b: false,
});

const getTakeBackInitialValues = (
  routeParams: PurchaseOrderCreateViewRouteParams,
  takeBackPurchaseOrder: PurchaseOrderDetails_purchaseOrder | null,
  isB2b: boolean = false
): PurchaseOrderCreatePageFormData => {
  if (utils.isEmpty(takeBackPurchaseOrder)) {
    return null;
  }

  const isTrackInventoryTakeBackType = routeParams.createType === "track-inventory-take-back";
  return {
    bySourcePo: null,
    sourcePurchaseOrder: null,
    takeBackPurchaseOrder,
    purchaseOrderDate: moment(takeBackPurchaseOrder.purchaseOrderDate),
    eventType: isTrackInventoryTakeBackType
      ? PurchaseOrderEventTypeEnum.TAKE_BACK
      : PurchaseOrderEventTypeEnum.CONSIGNMENT_TAKE_BACK,
    vendor: takeBackPurchaseOrder.vendor?.id,
    warehouse: takeBackPurchaseOrder.warehouse?.id,
    warehouseAddress: null,
    deliveryWarehouseName: takeBackPurchaseOrder.deliveryWarehouseName,
    deliveryWarehouseManager: takeBackPurchaseOrder.deliveryWarehouseManager,
    phone: utils.isEmpty(takeBackPurchaseOrder.phone) ? null : transformPhoneNumber(takeBackPurchaseOrder.phone),
    streetAddress1: takeBackPurchaseOrder.streetAddress1,
    streetAddress2: takeBackPurchaseOrder.streetAddress2,
    postalCode: takeBackPurchaseOrder.postalCode,
    defaultAskingPurchaseDate: null,
    isNotOrderableBeforeStocked: false,
    isForPackageOrder: false,
    isB2b,
    linesObj: takeBackPurchaseOrder.lines.reduce<TPurchaseOrderCreateLinesObj>((acc, line) => {
      const lineKey = makeUniquePoCreateLineKey(line.variant?.id, line.orderLine?.id);
      acc[lineKey] = {
        lineKey,
        isSelected: false,
        askingPurchaseDate: moment(),
        rackLocation: null,
        takeBackPurchaseOrderLine: line,
        takeBackPurchaseOrderLineId: line.id,
        variant: line.variant,
        variantId: line.variant?.id,
        vendorId: null,
        orderLineId: line.orderLine?.id,
        quantity: line.remainQuantity,
        takeBackUnitCostDeliveryFeeExcludeVat: line.takeBackUnitCostDeliveryFeeExcludeVat,
        // 위탁 반품 발주서에서는 calcConsignmentTakeBackCostPriceExcludeVat(line) 값으로 반품 금액 설정
        costPriceExcludeVat: isTrackInventoryTakeBackType
          ? line.costPriceExcludeVat
          : calcConsignmentTakeBackCostPriceExcludeVat(line),
        etcExcludeVat: line.etcExcludeVat,
        note: null,
        b2bDeliveryFeeExcludeVat: 0,
      };
      return acc;
    }, {}),
  };
};

interface GetPoCreateFormInitialValuesProps {
  routeParams: PurchaseOrderCreateViewRouteParams;
  warehouseList: IPoDeliveryAddress[];
  purchaseOrder: PurchaseOrderDetails_purchaseOrder | null;
}
export const getPoCreateFormInitialValues = (
  props: GetPoCreateFormInitialValuesProps
): PurchaseOrderCreatePageFormData => {
  const { routeParams, warehouseList, purchaseOrder } = props;
  switch (routeParams.createType) {
    case "track-inventory":
      return getTrackInventoryInitialValues(warehouseList, purchaseOrder);
    case "consignment":
      return getConsignmentInitialValues();
    case "track-inventory-take-back":
    case "consignment-take-back":
      return getTakeBackInitialValues(routeParams, purchaseOrder);
  }
};

export const getSelectedVariantVendor = (line: IPurchaseOrderCreateLine) => {
  const selectedVariantVendor = line?.variant?.productVariantVendors?.find(
    (variantVendor) => variantVendor?.vendor?.id === line?.vendorId
  )?.vendor;
  return selectedVariantVendor;
};

export const getSafetyStockProductVariantList = (lines: IPurchaseOrderCreateLine[]) => {
  const productVariantList = [];
  for (const line of lines) {
    const isSafety = line.variant?.isSafety;
    if (isSafety) {
      const productVariantName = `${line.variant?.product?.name}(${line.variant?.sku})`;
      productVariantList.push(productVariantName);
    }
  }
  return productVariantList;
};
