  const requestedStatusAtColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> =
    createChangeTimeOrWriterColumn({
      status: RequestBossProductStatusEnum.REQUESTED,
      title: columnNameConstant.requestProduct.REQUEST_CREATED_DATE,
      key: "requestedStatusAt",
    });
  const reqAdditionalStatusAtColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> =
    createChangeTimeOrWriterColumn({
      status: RequestBossProductStatusEnum.REQ_ADDITIONAL,
      title: columnNameConstant.requestProduct.ADDITIONAL_REQUEST_DATE,
      key: "reqAdditionalStatusAt",
    });
  const vendorPriceStatusAtColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> =
    createChangeTimeOrWriterColumn({
      status: RequestBossProductStatusEnum.VENDOR_PRICE,
      title: columnNameConstant.requestProduct.QUOTATION_REQUEST_DATE,
      key: "vendorPriceStatusAt",
      width: 160,
    });
  const brandPriceStatusAtColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> =
    createChangeTimeOrWriterColumn({
      status: RequestBossProductStatusEnum.BRAND_PRICE,
      title: columnNameConstant.requestProduct.VENDOR_COST_PRICE_REGISTERED_DATE,
      key: "brandPriceStatusAt",
      width: 160,
