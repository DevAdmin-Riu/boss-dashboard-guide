  const [openModal, closeModal] = createDialogActionHandlers<
    BoxSpecForPickingOrderViewUrlDialog,
    BoxSpecForPickingOrderViewUrlQueryParams
  >(navigate, boxSpecForPickingOrderViewUrl, params);

  const { data, loading } = useBoxSpecForPickingOrderQuery({});
