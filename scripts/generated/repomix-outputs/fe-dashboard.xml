interface IMakeValidSalesValueByDuration {
  value: number;
  digits?: number;
  targetDateStr: string;
  duration: number;
  durationType: statsDateType;
  forExcel: boolean; // 엑셀 다운로드 시에는 엑셀에서 필터 등을 위해 해당 값을 숫자로 인식하도록 값이 없는 경우에도 0을 반환
}
export const makeValidSalesValueByDuration = (props: IMakeValidSalesValueByDuration) => {
  const { value, digits = 0, targetDateStr, duration, durationType, forExcel } = props;
  if (utils.isEmpty(value)) {
    return forExcel ? 0 : "-";
  }
  const targetDate = moment(targetDateStr);
  if (targetDate.isValid() === false) {
    return forExcel ? 0 : "-";
  }
  let refDate: Moment;
  const clonedToday = moment().clone();
  switch (durationType) {
    case statsDateType.MONTHLY:
      const startOfThisMonth = clonedToday.startOf("month");
      refDate = startOfThisMonth.subtract(duration, "months");
      break;
    case statsDateType.WEEKLY:
      const mondayOfThisWeek = clonedToday.startOf("isoWeek");
      refDate = mondayOfThisWeek.subtract(duration, "weeks");
      break;
    case statsDateType.DAILY:
      refDate = clonedToday.subtract(duration, "days");
      break;
    default:
      refDate = clonedToday;
      break;
  }
  // 입력 받은 날짜가 기준 날짜와 같거나 이전인 경우에만 통계값 표시
  const isValid = targetDate.isSameOrBefore(refDate);
  if (isValid === false) {
    return forExcel ? 0 : "-";
  }
  const valueWithDigits = utils.formattedNumberWithDigits(value, digits);
  return forExcel ? valueWithDigits : valueWithDigits.toLocaleString();
};

