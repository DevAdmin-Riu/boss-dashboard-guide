<file path="src/app/components/Navigator/modes/index.ts">
import { UseNavigatorResult } from "@hooks/useNavigator";

import { QuickSearchAction, QuickSearchMode } from "../types";
import getCatalogModeActions from "./catalog";
import getCommandModeActions from "./commands";
import getDefaultModeActions from "./default";
import getHelpModeActions from "./help";
import getOrdersModeActions from "./orders";
import { ActionQueries } from "./types";

function getModeActions(
  mode: QuickSearchMode,
  query: string,
  queries: ActionQueries,
  cbs: {
    navigate: UseNavigatorResult;
    setMode: (mode: QuickSearchMode) => void;
  }
): QuickSearchAction[] {
  switch (mode) {
    case "catalog":
      return getCatalogModeActions(query, cbs.navigate, queries.catalog);
    case "commands":
      return getCommandModeActions(query, cbs.navigate, cbs.setMode);
    case "help":
      return getHelpModeActions(query, cbs.setMode);
    case "orders":
      return getOrdersModeActions(query, cbs.navigate, queries.order);
    default:
      return getDefaultModeActions(query, cbs.navigate, cbs.setMode);
  }
}

export default getModeActions;
</file>

