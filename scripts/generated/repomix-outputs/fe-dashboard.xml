import { DownloadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { BrandSortField, StatReportingMode } from "@src/api/types/globalTypes";
import { DownloadStatsListModal } from "@src/app/components/DownloadStatsListModal/DownloadStatsListModal";
import { BrandListViewUrlSortField } from "@src/app/views/brand/brands/urls";
import { useBrandOrderStatsLazyQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { BrandOrderStatsVariables } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { excelDownload } from "@utils/excel/excelDownload";
import { checkIsEnableForFbvServiceByBrand, maybe } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { showGraphQLErrors } from "@utils/notification/wrapperGql";
import { Button, Card, Col, Divider, Row, Space, Typography } from "antd";
import React, { useState } from "react";

import { useBrandListForStatsLazyQuery, useBrandManagerInfoListLazyQuery } from "../../api/queries";
import { Brands, Brands_brands_edges_node, Brands_numberOfBrands, BrandsVariables } from "../../api/types/Brands";
import { getFilterVariables } from "../../views/BrandListView/filters";
import { getSortQueryVariables } from "../../views/BrandListView/sort";
import { BrandListTable } from "../BrandListTable/BrandListTable";
import { BrandFilterKeys, BrandListFilterOpts } from "./filters";
import { parseBrandListForStats, parseBrandManagerInfoList, TBrandOrderStatsWithBrand } from "./utils";

enum BrandListPageModalModeEnum {
  DownloadBrandList = "DownloadBrandList",
  DownloadBrandManagerInfoList = "DownloadBrandManagerInfoList",
}

interface BrandListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandFilterKeys, BrandListFilterOpts>,
    SortPage<BrandListViewUrlSortField> {
  numberOfBrands: Brands_numberOfBrands;
  brands: Brands_brands_edges_node[];
  onBrandProductListView: (id: string, code: string, name: string) => void;

  queryVariablesWithoutPagination: BrandsVariables;
  fetchForDownload: (variables?: BrandsVariables) => Promise<ApolloQueryResult<Brands>>;
}

export const makeCautionUiForGenerateBrandDailyStats = (title: string) => (
  <Space direction="vertical">
    <Typography.Text strong>{title}</Typography.Text>
    <Divider />
    <Divider />
    <Space direction="vertical" size="small">
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        1. 데이터가 많을 경우 처리 시간이 길어질 수 있습니다.
      </Typography.Text>
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        2. 매출 데이터 집계가 진행 중일 때, 다른 매출 데이터 집계를 중복해서 요청하지 마세요.
      </Typography.Text>
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        3. 매일 오전 3시에는 전날에 발생한 브랜드 매출 데이터 집계가 자동으로 처리됩니다. (수동 브랜드 매출 집계 불가
        시간: AM 02:00:00 ~ AM 03:59:59)
      </Typography.Text>
    </Space>
  </Space>
);

export const BrandListPage: React.FC<BrandListPageProps> = ({ numberOfBrands, ...brandListProps }) => {
  const [loadingForReport, setLoadingForReport] = useState<boolean>(false);
  const [modalMode, setModalMode] = useState<BrandListPageModalModeEnum>(null);
  const resetForCloseModal = () => setModalMode(null);
  const openModalWithoutNavigate = (modalMode: BrandListPageModalModeEnum) => setModalMode(modalMode);

  const [fetchForDownloadBrandList] = useBrandListForStatsLazyQuery();
  const [fetchForBrandManagerInfoList] = useBrandManagerInfoListLazyQuery();
  const [fetchForDownloadBrandOrderStats] = useBrandOrderStatsLazyQuery();

  const onDownloadManagerInfoList = () => {
    const queryVariables = {
      first: GrapheneRelayConnectionMaxLimitEnum.brands,
      filter: getFilterVariables({}),
      sort: getSortQueryVariables({ sort: BrandSortField.NAME }),
    };

    setLoadingForReport(true);
    showDownloadingMessage();

    const handleErrorCatch = (e: any) => {
      showNotificationError("업무 담당자 다운로드 과정에 애러가 발생하였습니다");
      throw e;
    };

    const handleRefetchFinally = () => {
      setLoadingForReport(false);
      destroyDownloadingMessage();
    };

    fetchForBrandManagerInfoList({ variables: queryVariables })
      .then((responseData) => {
        const errors = responseData?.errors;
        if (errors?.length > 0) {
          showGraphQLErrors(errors);
        } else {
          const brands = maybe(() => responseData?.data?.brands?.edges?.map((edge) => edge?.node), []);
          const { columns, header, merges } = parseBrandManagerInfoList(brands);

          if (!columns || columns.length <= 0) {
            showNotificationWarn("출력할 데이터가 없습니다.");
            return;
          }

          excelDownload({ title: "업무 담당자", columns, header, merges, skipOriginHeader: true });
        }
      })
      .catch(handleErrorCatch)
      .finally(handleRefetchFinally);
  };

  const onDownloadList = (durationVariable: string[]) => {
    const queryVariablesForBrandList = {
      first: GrapheneRelayConnectionMaxLimitEnum.brands,
      filter: getFilterVariables({}),
      sort: getSortQueryVariables({ sort: BrandSortField.NAME }),
    };

    setLoadingForReport(true);
    showDownloadingMessage();

    const handleErrorCatch = (e: any) => {
      showNotificationError("브랜드정보 다운로드 과정에 애러가 발생하였습니다");
      throw e;
    };

    const handleRefetchFinally = () => {
      setLoadingForReport(false);
      destroyDownloadingMessage();
    };

    fetchForDownloadBrandList({ variables: queryVariablesForBrandList })
      .then((responseData) => {
        const errors = responseData?.errors;
        if (errors?.length >= 0) {
          showGraphQLErrors(errors);
        } else {
          const brands = maybe(() => responseData?.data?.brands?.edges?.map((edge) => edge?.node), []);
          const brandOrderStatsList: Array<Promise<TBrandOrderStatsWithBrand>> = brands?.map(async (brand) => {
            const [startDate, endDate] = durationVariable;
            const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);
            const queryVariables: BrandOrderStatsVariables = {
              id: brand?.id,
              filter: {
                mode: StatReportingMode.MONTHLY,
                statDate: { gte: startDate, lte: endDate },
                isFulfilledByVendor: false,
              },
            };

            const { data: brandOrderStatsNonFbvRes } = await fetchForDownloadBrandOrderStats({
              variables: queryVariables,
            });
            const { data: brandOrderStatsOnlyFbvRes } = enableForFbvService
              ? await fetchForDownloadBrandOrderStats({
                  variables: {
                    ...queryVariables,
                    filter: { ...queryVariables.filter, isFulfilledByVendor: true },
                  },
                })
              : { data: null };
            const brandOrderStatsNonFbv = brandOrderStatsNonFbvRes?.brandOrderStats || [];
            const brandOrderStatsOnlyFbv = brandOrderStatsOnlyFbvRes?.brandOrderStats || [];
            return { brand, brandOrderStatsNonFbv, brandOrderStatsOnlyFbv };
          });

          Promise.all(brandOrderStatsList)
            .then((brandOrderStats) => {
              const { columns, header, merges } = parseBrandListForStats(brandOrderStats, durationVariable);
              if (!columns || columns.length <= 0) {
                showNotificationWarn("출력할 데이터가 없습니다.");
                return;
              }
              excelDownload({ title: "브랜드 정보", columns, header, merges, skipOriginHeader: true });
              resetForCloseModal();
            })
            .catch(handleErrorCatch)
            .finally(handleRefetchFinally);
        }
      })
      .catch(handleErrorCatch);
  };

  const printBrandInfoButton = (
    <>
      <Button
        type="primary"
        shape="round"
        icon={<DownloadOutlined />}
        onClick={() => openModalWithoutNavigate(BrandListPageModalModeEnum.DownloadBrandList)}
      >
        브랜드 정보 다운로드
      </Button>
      <Button type="primary" shape="round" icon={<DownloadOutlined />} onClick={() => onDownloadManagerInfoList()}>
        업무담당자 다운로드
      </Button>
    </>
  );

  const addBrandButton = (
    <Button type="primary" shape="round" onClick={brandListProps.onAdd}>
      브랜드 추가
    </Button>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Space align="end">
            <Typography.Title level={4}>{sectionNames.brandList}</Typography.Title>
            {numberOfBrands && (
              <Typography.Text strong type="danger">
                전체: {numberOfBrands?.total} 업체, 운영: {numberOfBrands?.running} 업체, 갱신임박:{" "}
                {numberOfBrands?.contractWarning} 업체
              </Typography.Text>
            )}
          </Space>
        </Col>
        <Col>
          <Space direction="horizontal" size="small">
            {printBrandInfoButton}
            {addBrandButton}
          </Space>
        </Col>
      </Row>
      <Card>
        <BrandListTable {...brandListProps} />
      </Card>
      <DownloadStatsListModal
        title="브랜드 정보 다운로드 (매출 내역)"
        open={modalMode === BrandListPageModalModeEnum.DownloadBrandList}
        loading={loadingForReport}
        onClose={resetForCloseModal}
        onDownload={onDownloadList}
        isMonthlyRange
      />
    </Space>
  );
};
</file>

