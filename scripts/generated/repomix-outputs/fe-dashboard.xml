import useModalDialogErrors from "@hooks/useModalDialogErrors";
import { StaffErrorFragment } from "@src/api/fragments/types/StaffErrorFragment";
import { SearchPermissionGroups_search_edges_node } from "@src/api/searches/types/SearchPermissionGroups";
import ConfirmButton, { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { FetchMoreProps, SearchPageProps } from "@src/global/core/types/types";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { Button, Checkbox, Form, Input, Modal, Space } from "antd";
import React from "react";

export interface AddMemberFormData {
  loginId: string;
  email: string;
  firstName: string;
  lastName: string;
  isMallStaff: boolean;
  permissionGroups: string[];
}

const initialForm: AddMemberFormData = {
  loginId: "",
  email: "",
  firstName: "",
  lastName: "",
  isMallStaff: false,
  permissionGroups: [],
};

interface StaffAddMemberDialogProps extends SearchPageProps {
  availablePermissionGroups: SearchPermissionGroups_search_edges_node[];
  confirmButtonState: ConfirmButtonTransitionState;
  disabled: boolean;
  errors: StaffErrorFragment[];
  fetchMorePermissionGroups: FetchMoreProps;
  open: boolean;
  onClose: () => void;
  onConfirm: (data: AddMemberFormData) => void;
}

const StaffAddMemberDialog: React.FC<StaffAddMemberDialogProps> = (props) => {
  const { confirmButtonState, errors, onClose, onConfirm, open } = props;

  const [form] = Form.useForm();
  const dialogErrors = useModalDialogErrors(errors, open);
  const formErrors = getFormErrors(["firstName", "email", "loginId", "isMallStaff"], dialogErrors);

  const onCancel = () => {
    form.resetFields();
    onClose();
  };

  const modalFooter = (
    <Space>
      <Button type="text" onClick={onClose}>
        뒤로
      </Button>
      <ConfirmButton
        transitionState={confirmButtonState}
        color="primary"
        variant="contained"
        type="submit"
        onClick={form.submit}
      >
        비밀번호 설정 이메일 보내기
      </ConfirmButton>
    </Space>
  );

  return (
    <Modal destroyOnClose open={open} title="관리자 추가" footer={modalFooter} onCancel={onCancel} maskClosable={false}>
      <Form
        form={form}
        initialValues={initialForm}
        layout="vertical"
        validateTrigger={"onSubmit"}
        onFinish={(formData) => onConfirm(formData)}
      >
        <Form.Item
          label="로그인 아이디"
          name="loginId"
          validateStatus={!!formErrors.loginId ? "error" : ""}
          help={!!formErrors.loginId && makeGqlErrorMsg(formErrors.loginId)}
        >
          <Input size="large" placeholder="로그인 아이디를 입력해 주세요." />
        </Form.Item>
        <Form.Item
          label="이름"
          name="firstName"
          validateStatus={!!formErrors.firstName ? "error" : ""}
          help={!!formErrors.firstName && makeGqlErrorMsg(formErrors.firstName)}
        >
          <Input size="large" placeholder="이름" />
        </Form.Item>
        <Form.Item
          label="이메일"
          name="email"
          rules={[
            {
              type: "email",
              message: "올바른 이메일 주소가 아닙니다.",
            },
          ]}
          validateStatus={!!formErrors.email ? "error" : ""}
          help={!!formErrors.email && makeGqlErrorMsg(formErrors.email)}
        >
          <Input size="large" />
        </Form.Item>
        <Form.Item name="isMallStaff" valuePropName="checked" noStyle>
          <Checkbox>보스몰 확인 전용 관리자</Checkbox>
        </Form.Item>
      </Form>
    </Modal>
  );
};
export default StaffAddMemberDialog;
</file>

