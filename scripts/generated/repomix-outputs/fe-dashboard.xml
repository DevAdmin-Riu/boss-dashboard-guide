import useUser from "@hooks/useUser";
import AppHeader from "@src/app/components/AppHeader";
import { BrandStoreBasicInfo } from "@src/app/views/brand/brandStore/components/BrandStoreBasicInfo";
import { BrandStoreContractInfo } from "@src/app/views/brand/brandStore/components/BrandStoreContractInfo";
import { BrandStoreCreditsTable } from "@src/app/views/brand/brandStore/components/BrandStoreCreditsTable";
import { BrandStoreOperationalInfo } from "@src/app/views/brand/brandStore/components/BrandStoreOperationalInfo";
import BrandStoreRcoinsTable from "@src/app/views/brand/brandStore/components/BrandStoreRcoinsTable";
import { BrandStoreSalesInfo } from "@src/app/views/brand/brandStore/components/BrandStoreSalesInfo";
import { BrandStoreUsers } from "@src/app/views/brand/brandStore/components/BrandStoreUsers";
import { HqStaffBrandStores } from "@src/app/views/brand/brandStore/components/HqStaffBrandStores";
import CustomerOrdersTable from "@src/app/views/customer/customers/components/CustomerOrdersTable";
import { hqOrderLineListViewUrl } from "@src/app/views/hqStaff/hqSection/urls";
import { orderDetailsViewUrl, orderListViewUrlA } from "@src/app/views/order/orders/urls";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { checkHqStaff, checkIsEnableForLinkersServiceByUser, getDisplayBrandStoreName, maybe } from "@utils/misc";
import { Col, PageHeader, Row, Segmented, Space } from "antd";
import React, { useState } from "react";

import { BrandStoreDetails_brandStore } from "../../api/types/BrandStoreDetails";
import BrandStoreManageEvent from "../BrandStoreManageEvent";
import { BrandStorePreFounderInfo } from "../BrandStorePreFounderInfo";

interface BrandStoreDetailsPageProps {
  brandStore: BrandStoreDetails_brandStore;
  navigate: (url: string, replace?: boolean, preserveQs?: boolean, state?: any) => void;
  loading: boolean;
  onBack: () => void;
  onClickAccount: (brandStoreId: string) => void;
}

type BrandStoreTab = "basic" | "oper" | "contract" | "sales";

const BrandStoreDetailsPage: React.FC<BrandStoreDetailsPageProps> = ({
  brandStore,
  navigate,
  loading,
  onBack,
  onClickAccount,
}: BrandStoreDetailsPageProps) => {
  if (!brandStore) {
    return <></>;
  }

  const { user } = useUser();
  const isHqStaff = checkHqStaff(user);
  const enableForLinkersService = checkIsEnableForLinkersServiceByUser(user);

  const orderListViewUrl = isHqStaff ? hqOrderLineListViewUrl : orderListViewUrlA;

  const [activeTab, setActiveTab] = useState<BrandStoreTab>("basic");

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.brandStoreList}</AppHeader>
      <PageHeader title={getDisplayBrandStoreName(brandStore)} />
      <Row gutter={24}>
        <Col span={17}>
          <Space direction="vertical" size={24}>
            {enableForLinkersService && (
              <Segmented
                options={[
                  { label: "기본정보", value: "basic" },
                  { label: "운영정보", value: "oper" },
                  { label: "계약정보", value: "contract" },
                  { label: "매출정보", value: "sales" },
                ]}
                value={activeTab}
                onChange={(value) => setActiveTab(value as BrandStoreTab)}
                style={{ marginTop: 24 }}
              />
            )}

            {activeTab === "basic" && <BrandStoreBasicInfo isHqStaff={isHqStaff} brandStore={brandStore} />}
            {activeTab === "oper" && <BrandStoreOperationalInfo brandStore={brandStore} />}
            {activeTab === "contract" && <BrandStoreContractInfo brandStore={brandStore} />}
            {activeTab === "sales" && <BrandStoreSalesInfo brandStore={brandStore} />}

            <CustomerOrdersTable
              orders={maybe(() => brandStore.orders.edges.map((edge) => edge.node), [])}
              onViewAllOrdersClick={() =>
                navigate(orderListViewUrl({ brandStoreSearch: maybe(() => brandStore.code) }))
              }
              onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
            />
            <BrandStoreCreditsTable brandStore={brandStore} />
            <BrandStoreRcoinsTable brandStore={brandStore} />
          </Space>
        </Col>
        <Col span={7}>
          <Space direction="vertical" size={24}>
            {enableForLinkersService && <HqStaffBrandStores brandStore={brandStore} onClickAccount={onClickAccount} />}
            <BrandStoreUsers brandStore={brandStore} onClickAccount={onClickAccount} />
            {!!brandStore.preFounder && <BrandStorePreFounderInfo preFounder={brandStore.preFounder} />}
            <BrandStoreManageEvent brandStoreId={brandStore.id} events={maybe(() => brandStore.manageEvents, [])} />
          </Space>
        </Col>
      </Row>
    </>
  );
};
export default BrandStoreDetailsPage;
</file>

