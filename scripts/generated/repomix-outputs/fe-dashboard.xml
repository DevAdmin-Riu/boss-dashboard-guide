interface BrandStoreContractInfoProps {
  brandStore: BrandStoreDetails_brandStore;
}

export const BrandStoreContractInfo: React.FC<BrandStoreContractInfoProps> = (props) => {
  const { brandStore } = props;
  const [form] = Form.useForm<IBrandStoreContractInfoUpdateFormData>();
  const TypeSafeForm = getTypeSafeForm<IBrandStoreContractInfoUpdateFormData>(form);
  const [editMode, setEditMode] = useState(false);
  const touched = true;

  // editMode가 true에서 false로 바뀌는 경우 form reset되어야 한다. useEffect 사용.
  useEffect(() => {
    if (!editMode) {
      form.resetFields();
    }
  }, [editMode]);

  const franchiseDocumentsObj = makeFranchiseDocumentsObj(brandStore.franchiseDocuments);

  const initialValues: IBrandStoreContractInfoUpdateFormData = {
    franchiseDocumentsObj,
    franchiseDisclosureDocumentProvidedType: brandStore.franchiseDisclosureDocumentProvidedType,
    franchiseDisclosureDocumentProvidedDate: brandStore.franchiseDisclosureDocumentProvidedDate,
    nearbyBrandStoresInfoProvidedType: brandStore.nearbyBrandStoresInfoProvidedType,
    nearbyBrandStoresInfoProvidedDate: brandStore.nearbyBrandStoresInfoProvidedDate,
    franchiseAgreementProvidedType: brandStore.franchiseAgreementProvidedType,
    franchiseAgreementProvidedDate: brandStore.franchiseAgreementProvidedDate,
    projectedSalesStatementProvidedType: brandStore.projectedSalesStatementProvidedType,
    projectedSalesStatementProvidedDate: brandStore.projectedSalesStatementProvidedDate,
    franchiseDepositType: brandStore.franchiseDepositType,
    franchiseDepositDate: brandStore.franchiseDepositDate,
    franchiseDepositAmount: brandStore.franchiseDepositAmount,
    isConsulted: brandStore.isConsulted,
    franchiseConsultationDate: brandStore.franchiseConsultationDate,

    contractDate: brandStore.contractDate,
    contractStartDate: brandStore.contractStartDate,
    openingDate: brandStore.openingDate,
    contractExpectedEndDate: brandStore.contractExpectedEndDate,
  };

  const [brandStoreContractInfoUpdate, brandStoreContractInfoUpdateOpts] = useBrandStoreContractInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandStoreContractInfoUpdate.errors, commonMsg.savedChanges, () => {
        setEditMode(false);
      }),
  });

  const handleSubmit = async (formData: IBrandStoreContractInfoUpdateFormData) => {
    const cleanedFranchiseDocumentsObjInput = cleanFranchiseDocumentsObj(formData);

    const input: BrandStoreContractInfoUpdateInput = { ...cleanedFranchiseDocumentsObjInput };
    await brandStoreContractInfoUpdate({
      variables: { id: brandStore.id, input },
    });
  };

  return (
    <Form
      form={form}
      initialValues={initialValues}
      labelCol={{ span: 24 }}
      wrapperCol={{ span: 24 }}
      onFinish={handleSubmit}
    >
      <Card
        title={<Typography.Title level={4}>계약 정보</Typography.Title>}
        extra={
          <FormSaveButton
            form={form}
            loading={brandStoreContractInfoUpdateOpts.loading}
            isEditMode={editMode}
            onEdit={() => setEditMode(true)}
            onCancel={() => setEditMode(false)}
          />
        }
      >
        <Space direction="vertical" split={<Divider />}>
          {makeFranchiseContractInfoFormFields(TypeSafeForm, editMode)}

          <Space direction="vertical">
            <Typography.Title level={5}>계약일정</Typography.Title>

            <Row gutter={[8, 0]}>
              {/* 계약일 */}
              <Col span={6}>
                <EditableField
                  label="계약일"
                  type="datepicker"
                  name={TypeSafeForm.getValidDataIndex("contractDate")}
                  value={brandStore.contractDate}
                  editMode={editMode}
                  placeholder="날짜 선택"
                  formDateFormat={onlyDateFormat}
                />
              </Col>

              {/* 계약시작일 */}
              <Col span={6}>
                <EditableField
                  label="계약시작일"
                  type="datepicker"
                  name={TypeSafeForm.getValidDataIndex("contractStartDate")}
                  value={brandStore.contractStartDate}
                  editMode={editMode}
                  placeholder="날짜 선택"
                  formDateFormat={onlyDateFormat}
                />
              </Col>

              {/* 개점일 */}
              <Col span={6}>
                <EditableField
                  label="개점일"
                  type="datepicker"
                  name={TypeSafeForm.getValidDataIndex("openingDate")}
                  value={brandStore.openingDate}
                  editMode={editMode}
                  placeholder="날짜 선택"
                  formDateFormat={onlyDateFormat}
                />
              </Col>

              {/* 계약종료예정일 + 버튼 */}
              <Col span={6}>
                <EditableField
                  label="계약종료예정일"
                  type="datepicker"
                  name={TypeSafeForm.getValidDataIndex("contractExpectedEndDate")}
                  value={brandStore.contractExpectedEndDate}
                  editMode={editMode}
                  placeholder="날짜 선택"
                  formDateFormat={onlyDateFormat}
                />
                <Row justify="end">
                  <Space.Compact>
                    <Button
                      icon={<MinusOutlined />}
                      disabled={!editMode}
                      onClick={() => {
                        const key = TypeSafeForm.getValidDataIndex("contractExpectedEndDate");
                        const value = form.getFieldValue(key);
                        const subtractedDate = moment(value).subtract(1, "year");
                        if (value) {
                          form.setFields([{ touched, name: key, value: subtractedDate }]);
                        }
                      }}
                    >
                      1년
                    </Button>
                    <Button
                      icon={<PlusOutlined />}
                      disabled={!editMode}
                      onClick={() => {
                        const key = TypeSafeForm.getValidDataIndex("contractExpectedEndDate");
                        const keyForContractStartDate = TypeSafeForm.getValidDataIndex("contractStartDate");
                        const value = form.getFieldValue(key);
                        const valueOfContractStartDate = form.getFieldValue(keyForContractStartDate);
                        if (value) {
                          form.setFields([{ touched, name: key, value: moment(value).add(1, "year") }]);
                        } else if (valueOfContractStartDate) {
                          form.setFields([
                            { touched, name: key, value: moment(valueOfContractStartDate).add(1, "year") },
                          ]);
                        }
                      }}
                    >
                      1년
                    </Button>
                  </Space.Compact>
                </Row>
              </Col>
            </Row>
          </Space>

          <Space direction="vertical">
            <Typography.Title level={5}>기타정보</Typography.Title>

            <Row gutter={[8, 0]}>
              {/* 가맹계약서(기타정보) */}
              <Col span={12}>
                <EditableField
                  type="upload"
                  label="가맹계약서(기타정보)"
                  singleFileMode
                  name={TypeSafeForm.getValidDataIndex("franchiseDocumentsObj.FRANCHISE_AGREEMENT_ETC.file")}
                  value={franchiseDocumentsObj.FRANCHISE_AGREEMENT_ETC?.file}
                  editMode={editMode}
                  uploadText="파일 업로드"
                />
              </Col>

              {/* 개점 확인서 */}
              <Col span={12}>
                <EditableField
                  type="upload"
                  label="개점 확인서"
                  singleFileMode
                  name={TypeSafeForm.getValidDataIndex("franchiseDocumentsObj.OPENING_CONFIRMATION.file")}
                  value={franchiseDocumentsObj.OPENING_CONFIRMATION?.file}
                  editMode={editMode}
                  uploadText="파일 업로드"
                />
              </Col>

              {/* 계약 이행 보증금 */}
              <Col span={12}>
                <EditableField
                  label="계약 이행 보증금"
                  type="number"
                  name={TypeSafeForm.getValidDataIndex("contractPerformanceDeposit")}
                  value={brandStore.contractPerformanceDeposit?.toLocaleString()}
                  editMode={editMode}
                  placeholder="0"
                  addonAfter="만원"
                />
              </Col>

              {/* 특약 */}
              <Col span={24}>
                <EditableField
                  label="특약"
                  type="textarea"
                  name={TypeSafeForm.getValidDataIndex("specialTerms")}
                  value={brandStore.specialTerms}
                  editMode={editMode}
                  placeholder="특약 내용을 입력해주세요"
                  autoSize={{ minRows: 2, maxRows: 6 }}
                />
              </Col>
            </Row>
          </Space>
        </Space>
      </Card>
    </Form>
  );
};
