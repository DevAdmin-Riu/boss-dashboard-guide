  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.HQ_REQUEST_FULFILLED_BY_VENDOR_PRODUCT_LIST,
  });

  const targetUrl: (params?: ReqFbvProductListViewUrlQueryParams) => string = isStaff
    ? reqFbvProductListViewUrl
    : hqReqFbvProductListViewUrl;
  const targetUrlForRowClick: (id: string) => string = isStaff
    ? reqFbvProductDetailsViewUrl
    : hqReqFbvProductDetailsViewUrl;

  const filterVariables: RequestFbvProductFilterInput = getFilterVariables(params);
  const queryVariables: RequestFbvProductListVariables = React.useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: isStaff ? filterVariables : { ...filterVariables, brand: brandId },
