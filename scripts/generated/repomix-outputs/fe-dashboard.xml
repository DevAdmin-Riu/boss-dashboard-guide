<file path="src/app/components/Metadata/utils.ts">
import { ChangeEvent } from "@hooks/useForm";

import { nameSeparator } from "./MetadataCard";
import { EventData, EventDataAction, EventDataField } from "./types";

export function parseEventData(event: ChangeEvent): EventData {
  let action: EventDataAction;
  let field: EventDataField = null;
  let fieldIndex: number = null;
  let value: string = null;

  if (event.target.name.includes(EventDataField.name)) {
    action = EventDataAction.update;
    field = EventDataField.name;
    fieldIndex = parseInt(event.target.name.split(nameSeparator)[1], 0);
    value = event.target.value;
  }
  if (event.target.name.includes(EventDataField.value)) {
    action = EventDataAction.update;
    field = EventDataField.value;
    fieldIndex = parseInt(event.target.name.split(nameSeparator)[1], 0);
    value = event.target.value;
  }
  if (event.target.name === EventDataAction.add) {
    action = EventDataAction.add;
  }
  if (event.target.name === EventDataAction.delete) {
    action = EventDataAction.delete;
    fieldIndex = event.target.value;
  }

  return {
    action,
    field,
    fieldIndex,
    value,
  };
}

export function getDataKey(isPrivate: boolean) {
  return isPrivate ? "privateMetadata" : "metadata";
}
</file>

<file path="src/app/components/MobileAppUpdateModal/MobileAppUpdateModal.tsx">
import { DEFAULT_MOBILE_APP_LATE_UPDATE_DAYS } from "@assets/constants/config";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { getMobileAppInfo } from "@utils/misc";
import { showNotificationInfo } from "@utils/notification/wrapper";
import { Button, Modal } from "antd";
import moment from "moment";
import React, { useEffect, useState } from "react";

import {
  appLateUpdateDayKey,
  checkMobileAppForcedUpdateRequired,
  checkMobileAppOptionalUpdateRequired,
  getCurrentDeviceMobileAppVersion,
} from "./utils";

export const MobileAppUpdateModal: React.FC = () => {
  const { mobileAppInfo } = useShop();
  const [modalOpen, setModalOpen] = useState<boolean>(false);
  const [laterClicked, setLaterClicked] = useState<boolean>(false);

  const currentDeviceMobileAppVersion = getCurrentDeviceMobileAppVersion();
  const forcedUpdateRequired = checkMobileAppForcedUpdateRequired(mobileAppInfo);
  const optionalUpdateRequired = checkMobileAppOptionalUpdateRequired(mobileAppInfo);

  useEffect(() => {
    setModalOpen(forcedUpdateRequired || optionalUpdateRequired);
  }, [mobileAppInfo, currentDeviceMobileAppVersion]);

  const dashboardAppInfo = getMobileAppInfo(mobileAppInfo, "dashboard");

  const onClickUpdate = () => window.open(dashboardAppInfo.storeLink);
  const onCloseModal = () => setModalOpen(false);
  const onClickLater = () => {
    setLaterClicked(true);
    onCloseModal();
  };
  const onAfterClose = () => {
    if (laterClicked) {
      const appLateUpdateDayToLocalStorage = moment()
        .add(DEFAULT_MOBILE_APP_LATE_UPDATE_DAYS, "day")
        .format(onlyDateFormat);
      localStorage.setItem(appLateUpdateDayKey, appLateUpdateDayToLocalStorage);
      showNotificationInfo(`업데이트 알림이 ${DEFAULT_MOBILE_APP_LATE_UPDATE_DAYS}일 후에 다시 표시됩니다.`);
      setLaterClicked(false);
    }
  };

  const modalText = forcedUpdateRequired
    ? "안정적인 서비스 제공을 위해 최신 버전으로 업데이트가 필요합니다. 업데이트 후 이용해주시기 바랍니다."
    : "더 나은 서비스를 위한 최신 버전이 업데이트 되었습니다. 업데이트 하시겠습니까?";
  const modalFooter = (
    <>
      {!forcedUpdateRequired && <Button onClick={onClickLater}>나중에</Button>}
      <Button type={"primary"} onClick={onClickUpdate}>
        업데이트
      </Button>
    </>
  );

  return (
    <Modal
      centered
      destroyOnClose
      title={"업데이트"}
      open={modalOpen}
      onCancel={!forcedUpdateRequired && onCloseModal}
      closable={!forcedUpdateRequired}
      footer={modalFooter}
      afterClose={onAfterClose}
    >
      {modalText}
    </Modal>
  );
};
</file>

<file path="src/app/components/MobileAppUpdateModal/utils.ts">
import { ShopInfo_shop_mobileAppInfo } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { getMobileAppInfo, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

export const appLateUpdateDayKey = "APP_LATE_UPDATE_DAY";

const mobileAppVersionRegText = "mobileAppVersion[0-9]?[0-9]?[0-9].[0-9]?[0-9]?[0-9].[0-9]?[0-9]?[0-9]";

// 유저의 실제 기기에 설치된 앱 버전 정보를 가져오는 함수
export const getCurrentDeviceMobileAppVersion = (): string => {
  const mobileAppVersionReg = new RegExp(`${mobileAppVersionRegText}`, "g");
  const matchedVersion = maybe(() => navigator.userAgent.match(mobileAppVersionReg)[0], "");
  const currentDeviceMobileAppVersion = matchedVersion.replace("mobileAppVersion", "");
  return currentDeviceMobileAppVersion;
};

// 모바일 앱 업데이트가 가능한지 확인하는 함수
const checkMobileAppUpdateAvailable = (mobileAppInfoList: ShopInfo_shop_mobileAppInfo[]): boolean => {
  const mobileAppVersionReg = new RegExp(`${mobileAppVersionRegText}`, "g");
  const matchedVersion = maybe(() => navigator.userAgent.match(mobileAppVersionReg)[0], "");
  // 웹뷰 앱이 아니거나, 기기에 설치된 모바일 앱 버전 정보가 없을 경우 return false
  if (!utils.checkWebView() || utils.isEmpty(matchedVersion, true)) {
    return false;
  }

  const currentMobileAppInfo = getMobileAppInfo(mobileAppInfoList, "dashboard");
  // 현재 모바일 앱 이름에 대한 정보가 없을 경우 return false
  if (!currentMobileAppInfo) {
    return false;
  }

  return true;
};

// 모바일 앱에 강제 업데이트가 필요한지 확인하는 함수
export const checkMobileAppForcedUpdateRequired = (mobileAppInfoList: ShopInfo_shop_mobileAppInfo[]): boolean => {
  const mobileAppUpdateAvailable = checkMobileAppUpdateAvailable(mobileAppInfoList);
  if (!mobileAppUpdateAvailable) {
    return false;
  }

  const currentDeviceMobileAppVersion = getCurrentDeviceMobileAppVersion();
  const currentMobileAppInfo = getMobileAppInfo(mobileAppInfoList, "dashboard");
  const forcedUpdateRequired = utils.compareVersions(
    currentDeviceMobileAppVersion,
    currentMobileAppInfo.minVersion,
    false
  );
  return forcedUpdateRequired;
};

// 모바일 앱에 선택 업데이트가 필요한지 확인하는 함수
export const checkMobileAppOptionalUpdateRequired = (mobileAppInfoList: ShopInfo_shop_mobileAppInfo[]): boolean => {
  const mobileAppUpdateAvailable = checkMobileAppUpdateAvailable(mobileAppInfoList);
  if (!mobileAppUpdateAvailable) {
    return false;
  }

  const appLateUpdateDayFromLocalStorage = localStorage.getItem(appLateUpdateDayKey);
  const isAfterAppLateUpdateDay = !!appLateUpdateDayFromLocalStorage
    ? moment().isAfter(appLateUpdateDayFromLocalStorage)
    : true;

  const currentDeviceMobileAppVersion = getCurrentDeviceMobileAppVersion();
  const currentMobileAppInfo = getMobileAppInfo(mobileAppInfoList, "dashboard");
  const optionalUpdateRequired =
    isAfterAppLateUpdateDay &&
    utils.compareVersions(currentDeviceMobileAppVersion, currentMobileAppInfo.latestVersion, false);
  return optionalUpdateRequired;
};
</file>

