import { UseNavigatorResult } from "@hooks/useNavigator";
import { SalesStatusEnum, StoppedReasonTypeEnum } from "@src/api/types/globalTypes";
import {
  DownloadableEditableColumnsType,
  DownloadableEditableColumnType,
} from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { NumberComponent } from "@src/app/components/Number";
import { TextWithLink } from "@src/app/components/TextWithLink";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { ShopInfo_shop_stoppedReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { makeSalesStatusByProductVariant } from "@src/app/views/product/products/components/ProductListPage/ProductListTableSettings";
import { fbvProductUpdateViewUrl, productUpdateViewUrl } from "@src/app/views/product/products/urls";
import { getForceNoNormalChoices, getSalesStatusChoices } from "@src/app/views/product/products/utils/data";
import { calcSumOfStockQuantity } from "@src/app/views/product/stock/components/StockListPage/StockListTableSettings";
