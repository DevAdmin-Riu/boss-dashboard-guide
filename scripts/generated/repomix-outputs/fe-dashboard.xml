>(purchaseOrderLineListQuery, "no-cache");

export const purchaseOrderDetailsQuery = gql`
  ${purchaseOrderDetailsFragment}
  ${productVariantForPurchaseOrderLineFragment}
  ${productVariantForStockPOLineFragment}
  query PurchaseOrderDetails($id: ID!) {
    purchaseOrder(id: $id) {
      ...PurchaseOrderDetailsFragment
      lines {
        id
        status
        variant {
          ...ProductVariantForPurchaseOrderLineFragment
          ...ProductVariantForStockPOLineFragment
        }
      }
    }
  }
`;
export const usePurchaseOrderDetailsQuery = makeQuery<PurchaseOrderDetails, PurchaseOrderDetailsVariables>(
  purchaseOrderDetailsQuery
);
export const usePurchaseOrderDetailsLazyQuery = makeLazyQuery<PurchaseOrderDetails, PurchaseOrderDetailsVariables>(
  purchaseOrderDetailsQuery
);

export const printPurchaseOrderQuery = gql`
  ${purchaseOrderPrintFragment}
  query PrintPurchaseOrder($id: ID!) {
    purchaseOrder(id: $id) {
      ...PurchaseOrderPrintFragment
    }
  }
`;
export const usePrintPurchaseOrderLazyQuery = makeLazyQuery<PrintPurchaseOrder, PrintPurchaseOrderVariables>(
