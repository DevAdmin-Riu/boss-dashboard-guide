import {
  hqAccountHqStaffListViewUrl,
  hqAccountStoreWorkerListViewUrl,
  hqBrandAccountDetailsViewUrl,
} from "@src/app/views/hqStaff/hqSection/urls";
import { ListViews } from "@src/global/core/types/types";
import { getBrandId, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import { customerListQuery, useCustomerListFilterDownloadQuery, useCustomerListQuery } from "../../api/queries";
import CustomerListPage from "../../components/CustomerListPage";
import {
  brandAccountDetailsUrl,
  customerHqStaffListViewUrl,
  CustomerListViewUrlDialog,
  CustomerListViewUrlQueryParams,
  customerStoreWorkerListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

enum CustomerListModalModeEnum {
  CreateHqStaff = "CreateHqStaff",
  CreateStoreWorker = "CreateStoreWorker",
}

interface CustomerListViewProps {
  params: CustomerListViewUrlQueryParams;
}

export const CustomerListView: React.FC<CustomerListViewProps> = ({ params }) => {
  // 사용자(가맹본부) or 사용자(매장)
  const isHqStaff = params.isHqStaff;
  const shop = useShop();
  const { user } = useAuth();
  const brandId = getBrandId(user);
  // hqStaff가 조회한건지.
  const isForBrand = Boolean(brandId);
  let targetUrl;
  // targetUrl을 isHqStaff, isForBrand에 따라 다르게 설정한다.
  if (isHqStaff && isForBrand) {
    targetUrl = hqAccountHqStaffListViewUrl;
  } else if (!isHqStaff && isForBrand) {
    targetUrl = hqAccountStoreWorkerListViewUrl;
  } else if (isHqStaff && !isForBrand) {
    targetUrl = customerHqStaffListViewUrl;
  } else {
    targetUrl = customerStoreWorkerListViewUrl;
  }

  const onRowClickUrl = isForBrand ? hqBrandAccountDetailsViewUrl : brandAccountDetailsUrl;

  const [hqStaffCreate, hqStaffCreateOpts] = useHqStaffCreateMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.hqStaffCreate.errors, "성공적으로 생성되었습니다."),
    refetchQueries: [customerListQuery],
  });

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.CUSTOMER_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useCustomerListFilterDownloadQuery);

  const [modalMode, setModalMode] = useState<CustomerListModalModeEnum>(null);

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const openModalWithoutNavigate = (modalMode: CustomerListModalModeEnum) => {
    setModalMode(modalMode);
  };

  const filter = getFilterVariables(params);
  if (isHqStaff) {
    filter.isHqStaff = true;
  } else {
    filter.isHqStaff = false;
  }
  if (brandId) {
    filter.brand = brandId;
  }

  const queryVariables: ListCustomersVariables = React.useMemo(
    () => ({ ...paginationState, filter }),
    [params, settings?.rowNumber]
  );

  const {
    data,
    loading: customerListLoading,
    refetch,
  } = useCustomerListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.customers?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<CustomerListViewUrlDialog, CustomerListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");

  const filterOpts = getFilterOpts(params);

  const loading = customerListLoading || hqStaffCreateOpts.loading;

  return (
    <>
      <CustomerListPage
        onRowClick={(id) => navigate(onRowClickUrl(id))}
        isHqStaff={isHqStaff}
        isForBrand={isForBrand}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        me={maybe(() => user)}
        customers={maybe(() => data.customers.edges.map((edge) => edge.node))}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onHqStaffCreate={() => openModalWithoutNavigate(CustomerListModalModeEnum.CreateHqStaff)}
        onStoreWorkerCreate={() => openModalWithoutNavigate(CustomerListModalModeEnum.CreateStoreWorker)}
        queryVariables={queryVariables}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      {modalMode === CustomerListModalModeEnum.CreateHqStaff && (
        <BrandHqStaffCreateModal
          open={modalMode === CustomerListModalModeEnum.CreateHqStaff}
          onClose={resetForCloseModal}
          onCreate={hqStaffCreate}
          brandId={brandId ? brandId : undefined}
        />
      )}
      {modalMode === CustomerListModalModeEnum.CreateStoreWorker && (
        <BrandStoreWorkerCreateModal
          open={modalMode === CustomerListModalModeEnum.CreateStoreWorker}
          onClose={resetForCloseModal}
          brandId={brandId ? brandId : undefined}
        />
      )}

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
    </>
  );
};
</file>

<file path="src/app/views/customer/customers/views/CustomerListView/filters.ts">
import { BrandStoreRoleEnum, CustomerFilterInput, HqStaffRoleEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  CustomerFilterKeys,
  CustomerListFilterOpts,
} from "@src/app/views/customer/customers/components/CustomerListPage";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment-timezone";

import {
  CustomerListViewUrlFilters,
  CustomerListViewUrlFiltersEnum,
  CustomerListViewUrlFiltersMultipleValuesEnum,
  CustomerListViewUrlQueryParams,
} from "../../urls";

export const CUSTOMER_FILTERS_KEY = "customerFilters";

export function getFilterOpts(params: CustomerListViewUrlFilters): CustomerListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch, true), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    hqStaffRole: {
      active: maybe(() => !utils.isEmpty(filterVariables.hqStaffRole, true), false),
      value: maybe(
        () => dedupeFilter(filterVariables.hqStaffRole.map((item) => findValueInEnum(item, HqStaffRoleEnum))),
        []
      ),
    },
    brandStoreRole: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreRole, true), false),
      value: maybe(
        () => dedupeFilter(filterVariables.brandStoreRole.map((item) => findValueInEnum(item, BrandStoreRoleEnum))),
        []
      ),
    },
    joined: {
      active: maybe(() => !utils.allEmpty([filterVariables.dateJoined.gte, filterVariables.dateJoined.lte]), false),
      value: {
        max: maybe(() => filterVariables.dateJoined.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.dateJoined.gte, todayMoment.format(onlyDateFormat)),
      },
    },
  };
}

export function getFilterVariables(params: CustomerListViewUrlFilters): CustomerFilterInput {
  return {
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    brandStoreSearch: params.brandStoreSearch !== undefined ? params.brandStoreSearch : null,
    hqStaffRole: maybe(() => params.hqStaffRole.map((item) => findInEnum(item, HqStaffRoleEnum))),
    brandStoreRole: maybe(() => params.brandStoreRole.map((item) => findInEnum(item, BrandStoreRoleEnum))),
    dateJoined: getGteLteVariables({
      gte: params.joinedFrom,
      lte: params.joinedTo,
    }),
  };
}

export function getFilterQueryParam(filter: IFilterElement<CustomerFilterKeys>): CustomerListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case CustomerFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, CustomerListViewUrlFiltersEnum.userSearch);
    case CustomerFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, CustomerListViewUrlFiltersEnum.brandSearch);
    case CustomerFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, CustomerListViewUrlFiltersEnum.brandStoreSearch);
    case CustomerFilterKeys.hqStaffRole:
      return getMultipleEnumValueQueryParam(
        filter,
        CustomerListViewUrlFiltersMultipleValuesEnum.hqStaffRole,
        HqStaffRoleEnum
      );
    case CustomerFilterKeys.brandStoreRole:
      return getMultipleEnumValueQueryParam(
        filter,
        CustomerListViewUrlFiltersMultipleValuesEnum.brandStoreRole,
        BrandStoreRoleEnum
      );
    case CustomerFilterKeys.joined:
      return getMinMaxQueryParam(
        filter,
        CustomerListViewUrlFiltersEnum.joinedFrom,
        CustomerListViewUrlFiltersEnum.joinedTo
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<CustomerListViewUrlFilters>(CUSTOMER_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  CustomerListViewUrlQueryParams,
  CustomerListViewUrlFilters
>(CustomerListViewUrlFiltersEnum);
</file>

