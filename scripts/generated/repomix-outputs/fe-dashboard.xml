import { AttributeFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import {
  AttributeFilterKeys,
  AttributeListFilterOpts,
} from "@src/app/views/settings/attributes/components/AttributeListPage";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

import {
  AttributeListViewUrlFilters,
  AttributeListViewUrlFiltersEnum,
  AttributeListViewUrlQueryParams,
} from "../../urls";

export const ATTRIBUTE_FILTERS_KEY = "attributeFilters";

export function getFilterOpts(params: AttributeListViewUrlFilters): AttributeListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    availableInGrid: {
      active: maybe(() => !utils.isEmpty(filterVariables.availableInGrid), false),
      value: maybe(() => filterVariables.availableInGrid, true),
    },
    filterableInDashboard: {
      active: maybe(() => !utils.isEmpty(filterVariables.filterableInDashboard), false),
      value: maybe(() => filterVariables.filterableInDashboard, true),
    },
    isVariantOnly: {
      active: maybe(() => !utils.isEmpty(filterVariables.isVariantOnly), false),
      value: maybe(() => filterVariables.isVariantOnly, true),
    },
    valueRequired: {
      active: maybe(() => !utils.isEmpty(filterVariables.valueRequired), false),
      value: maybe(() => filterVariables.valueRequired, true),
    },
    visibleInStorefront: {
      active: maybe(() => !utils.isEmpty(filterVariables.visibleInStorefront), false),
      value: maybe(() => filterVariables.visibleInStorefront, true),
    },
  };
}

export function getFilterVariables(params: AttributeListViewUrlFilters): AttributeFilterInput {
  return {
    availableInGrid: params.availableInGrid !== undefined ? parseBoolean(params.availableInGrid, false) : undefined,
    filterableInDashboard:
      params.filterableInDashboard !== undefined ? parseBoolean(params.filterableInDashboard, false) : undefined,
    isVariantOnly: params.isVariantOnly !== undefined ? parseBoolean(params.isVariantOnly, false) : undefined,
    valueRequired: params.valueRequired !== undefined ? parseBoolean(params.valueRequired, false) : undefined,
    visibleInStorefront:
      params.visibleInStorefront !== undefined ? parseBoolean(params.visibleInStorefront, false) : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<AttributeFilterKeys>): AttributeListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case AttributeFilterKeys.availableInGrid:
      return getSingleValueQueryParam(filter, AttributeListViewUrlFiltersEnum.availableInGrid);

    case AttributeFilterKeys.filterableInDashboard:
      return getSingleValueQueryParam(filter, AttributeListViewUrlFiltersEnum.filterableInDashboard);

    case AttributeFilterKeys.isVariantOnly:
      return getSingleValueQueryParam(filter, AttributeListViewUrlFiltersEnum.isVariantOnly);

    case AttributeFilterKeys.valueRequired:
      return getSingleValueQueryParam(filter, AttributeListViewUrlFiltersEnum.valueRequired);

    case AttributeFilterKeys.visibleInStorefront:
      return getSingleValueQueryParam(filter, AttributeListViewUrlFiltersEnum.visibleInStorefront);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<AttributeListViewUrlFilters>(ATTRIBUTE_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  AttributeListViewUrlQueryParams,
  AttributeListViewUrlFilters
>(AttributeListViewUrlFiltersEnum);
</file>

<file path="src/app/views/settings/attributes/views/AttributeListView/sort.ts">
import { AttributeSortField } from "@src/api/types/globalTypes";
import { AttributeListViewUrlSortField } from "@src/app/views/settings/attributes/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: AttributeListViewUrlSortField): AttributeSortField {
  switch (sort) {
    case AttributeListViewUrlSortField.name:
      return AttributeSortField.NAME;
    case AttributeListViewUrlSortField.slug:
      return AttributeSortField.SLUG;
    case AttributeListViewUrlSortField.valueRequired:
      return AttributeSortField.VALUE_REQUIRED;
    case AttributeListViewUrlSortField.availableInGrid:
      return AttributeSortField.AVAILABLE_IN_GRID;
    case AttributeListViewUrlSortField.isVariantOnly:
      return AttributeSortField.IS_VARIANT_ONLY;
    case AttributeListViewUrlSortField.filterableInDashboard:
      return AttributeSortField.FILTERABLE_IN_DASHBOARD;
    case AttributeListViewUrlSortField.visibleInStorefront:
      return AttributeSortField.VISIBLE_IN_STOREFRONT;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
</file>

