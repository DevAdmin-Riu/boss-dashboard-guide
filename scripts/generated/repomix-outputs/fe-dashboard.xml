} from "../../urls";

const PURCHASE_FILTERS_KEY = "purchaseFilters";

export function getFilterOpts(
  params: PurchaseListViewUrlFilters,
  routeParams: PurchaseListViewRouteParams
): PurchaseListFilterOpts {
  const filterVariables = getFilterVariables(params, routeParams);
  const todayMoment = moment();
  const lastMonth = todayMoment.clone().subtract(1, "month");
  const firstDayOfLastMonth = todayMoment.clone().subtract(1, "month").startOf("month").format(onlyDateFormat);
  const lastDayOfLastMonth = todayMoment.clone().subtract(1, "month").endOf("month").format(onlyDateFormat);

  return {
    purchaseDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.purchaseDate.gte, filterVariables.purchaseDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.purchaseDate.lte, lastDayOfLastMonth),
        min: maybe(() => filterVariables.purchaseDate.gte, firstDayOfLastMonth),
      },
    },
    purchaseOrderDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseOrderDate.gte, filterVariables.purchaseOrderDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseOrderDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.purchaseOrderDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    purchaseCloseDate: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.purchaseCloseDate.gte, filterVariables.purchaseCloseDate.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.purchaseCloseDate.lte, lastDayOfLastMonth),
        min: maybe(() => filterVariables.purchaseCloseDate.gte, firstDayOfLastMonth),
      },
    },
    purchaseCloseMonth: {
      active: maybe(() => !utils.isEmpty([filterVariables.purchaseCloseDate.gte]), false),
      value: maybe(
        () => moment(filterVariables.purchaseCloseDate.gte).format(onlyMonthFormat),
        lastMonth.format(onlyMonthFormat)
      ),
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => dedupeFilter(filterVariables.type), []),
    },
    purchaseOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.purchaseOrderSearch, true), false),
      value: maybe(() => filterVariables.purchaseOrderSearch, ""),
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    b2bOrderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bOrderSearch, true), false),
      value: maybe(() => filterVariables.b2bOrderSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
