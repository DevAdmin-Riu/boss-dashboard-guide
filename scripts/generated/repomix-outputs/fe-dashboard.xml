// 재고 관련 값 선택을 위한 헬퍼 함수
const getStockRelatedValue = <T>(
  variant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant,
  fieldName: "basicStockQty" | "safetyStockQty" | "rop30"
): T | null => {
  const canSaleByInner = variant.canSaleByInner;
  const trackInventory = variant.trackInventory;

  if (canSaleByInner && trackInventory === false) {
    return variant.inner?.[fieldName] ?? null;
  }
  return variant[fieldName] ?? null;
};

export interface Collection {
