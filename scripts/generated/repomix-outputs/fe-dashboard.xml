<file path="src/app/views/product/stock/components/RackStockListPage/utils.ts">
import { ApolloQueryResult } from "@apollo/client";
import { makeHeaderRowsAndMerges } from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";

import { UnfulfilledProductVariants } from "../../../products/api/types/UnfulfilledProductVariants";
import {
  DownloadRackLocationList,
  DownloadRackLocationList_rackLocations_edges_node,
  DownloadRackLocationList_rackLocations_edges_node_rackStocks,
} from "../../api/types/DownloadRackLocationList";

const defaultStrValue = "-";
const defaultNumValue = 0;

const rackLocationKeysToMerge = {
  sector: "[구역]\nsectorName",
  location: "[로케이션]\nlocationName",
  canNotSellToCustomers: "[판매 제한]\ncanNotSellToCustomers",
  canPicking: "[피킹 가능]\ncanPicking",
  canStock: "[입고 가능]\ncanStock",
  safetyPickingStock: "[피킹 로케이션 기준 재고수]\nsafetyPickingStock",
  productSku: "[자재코드]\nproductSku",
  quantity: "[재고수]\nquantity",
  quantityUnfulfilled: "[출고대기수량]\nquantityUnfulfilled",
  quantityInsufficient: "[부족수량]\nquantityInsufficient",
  totalLocationCnt: "[보관 로케이션]\ntotalLocationCnt",
  memo: "[메모]\nmemo",
};

// 로케이션마다 한 제품에 대한 재고 내역을 합친 데이터를 만들기 위한 인터페이스
interface TMergedRackLocation extends DownloadRackLocationList_rackLocations_edges_node {
  mergedRackStocks: DownloadRackLocationList_rackLocations_edges_node_rackStocks[];
}

export const parseRackLocationListAndUnfulfilledPv = (
  resRackLocationList: ApolloQueryResult<DownloadRackLocationList>,
  resUnfulfilledPVList: ApolloQueryResult<UnfulfilledProductVariants>
) => {
  const columns = [];
  const rackLocationList = maybe(() => resRackLocationList.data.rackLocations.edges.map((edge) => edge.node), []);
  const unfulfilledPVList = maybe(() => resUnfulfilledPVList.data.unfulfilledProductVariants, []);

  // 제품별로 보관하고 있는 총 로케이션 개수를 저장하는 객체
  const totalLocationCntByVariant: { [sku: string]: number } = {};
  // 피킹 로케이션에 보관하고 있는 제품별 총 재고 수량을 저장하는 객체
  const totalQuantityByVariantFromPickingLocation: { [sku: string]: number } = {};

  // 머지된 rackStocks를 가진 rackLocationList를 만들기 위한 배열 + 제품별 총 로케이션 개수와 피킹 로케이션에 보관하고 있는 제품별 총 재고 수량을 저장
  const mergedRackLocationList: TMergedRackLocation[] = rackLocationList.map((rackLocation) => {
    const { canPicking } = rackLocation;
    const rackStocks = maybe(() => rackLocation.rackStocks, []);
    // 한 로케이션 내에서 한 제품에 대한 2개 이상의 상세 재고를 합친, 제품 단위로 유니크한 rackStocks를 만들기 위한 배열
    // - 한 로케이션에 한 제품에 대한 재고 정보는 한 개임이 보장됨.
    const mergedRackStocks: DownloadRackLocationList_rackLocations_edges_node_rackStocks[] = rackStocks.reduce(
      (acc, rackStock) => {
        const { productVariant, remainQuantity } = rackStock;
        const sku = productVariant.sku;
        // 제품이 중복되는 rackStocks를 제품 단위로 재고 수량을 합친 유니크한 rackStocks로 머지
        const findIndex = acc.findIndex((item) => item.productVariant.sku === sku);
        if (findIndex === -1) {
          acc.push({ ...rackStock });
        } else {
          acc[findIndex].remainQuantity += remainQuantity;
        }
        return acc;
      },
      []
    );

    if (mergedRackStocks.length > 0) {
      mergedRackStocks.forEach((rackStock) => {
        const { productVariant, remainQuantity } = rackStock;
        const sku = productVariant.sku;
        // 제품별로 보관하고 있는 총 로케이션 개수를 저장
        if (totalLocationCntByVariant[sku]) {
          totalLocationCntByVariant[sku] += 1;
        } else {
          totalLocationCntByVariant[sku] = 1;
        }
        // 피킹 로케이션에 보관하고 있는 제품별 총 재고 수량을 저장
        if (canPicking) {
          if (totalQuantityByVariantFromPickingLocation[sku]) {
            totalQuantityByVariantFromPickingLocation[sku] += remainQuantity;
          } else {
            totalQuantityByVariantFromPickingLocation[sku] = remainQuantity;
          }
        }
      });
    }

    return { ...rackLocation, mergedRackStocks };
  });

  // 머지된 rackStocks를 가진 rackLocationList를 통해 엑셀 다운로드를 위한 columns, header, merges를 만들기
  mergedRackLocationList.forEach((rackLocation) => {
    const {
      name: locationName,
      sector,
      canNotSellToCustomers,
      canPicking,
      canStock,
      safetyPickingStock,
      mergedRackStocks,
    } = rackLocation;
    if (utils.isEmpty(mergedRackStocks) || mergedRackStocks.length === 0) {
      columns.push({
        [rackLocationKeysToMerge.sector]: sector.name || defaultStrValue,
        [rackLocationKeysToMerge.location]: locationName || defaultStrValue,
        [rackLocationKeysToMerge.canNotSellToCustomers]: canNotSellToCustomers,
        [rackLocationKeysToMerge.canPicking]: canPicking,
        [rackLocationKeysToMerge.canStock]: canStock,
        [rackLocationKeysToMerge.safetyPickingStock]: safetyPickingStock || defaultNumValue,
        [rackLocationKeysToMerge.productSku]: defaultStrValue,
        [rackLocationKeysToMerge.quantity]: defaultNumValue,
        [rackLocationKeysToMerge.quantityUnfulfilled]: defaultNumValue,
        [rackLocationKeysToMerge.quantityInsufficient]: defaultNumValue,
        [rackLocationKeysToMerge.totalLocationCnt]: defaultNumValue,
        [rackLocationKeysToMerge.memo]: defaultStrValue,
      });
    } else {
      mergedRackStocks.forEach((rackStock) => {
        const { productVariant, remainQuantity } = rackStock;
        const sku = productVariant.sku;
        const quantityUnfulfilled =
          unfulfilledPVList.find((item) => item.sku === sku)?.quantityUnfulfilled || defaultNumValue;
        const quantityInsufficient =
          totalQuantityByVariantFromPickingLocation[sku] - quantityUnfulfilled > 0
            ? 0
            : quantityUnfulfilled - totalQuantityByVariantFromPickingLocation[sku];
        const totalLocationCnt = totalLocationCntByVariant[sku] || defaultNumValue;
        const memo = rackStock.memo || defaultStrValue;

        columns.push({
          [rackLocationKeysToMerge.sector]: sector.name || defaultStrValue,
          [rackLocationKeysToMerge.location]: locationName || defaultStrValue,
          [rackLocationKeysToMerge.canNotSellToCustomers]: canNotSellToCustomers,
          [rackLocationKeysToMerge.canPicking]: canPicking,
          [rackLocationKeysToMerge.canStock]: canStock,
          [rackLocationKeysToMerge.safetyPickingStock]: safetyPickingStock || defaultNumValue,
          [rackLocationKeysToMerge.productSku]: sku || defaultStrValue,
          [rackLocationKeysToMerge.quantity]: remainQuantity || defaultNumValue,
          [rackLocationKeysToMerge.quantityUnfulfilled]: quantityUnfulfilled,
          [rackLocationKeysToMerge.quantityInsufficient]: quantityInsufficient || defaultNumValue,
          [rackLocationKeysToMerge.totalLocationCnt]: totalLocationCnt || defaultNumValue,
          [rackLocationKeysToMerge.memo]: memo,
        });
      });
    }
  });

  if (utils.isEmpty(columns) || columns.length === 0) {
    return { columns: [], header: [], merges: [] };
  }
  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
};
</file>

