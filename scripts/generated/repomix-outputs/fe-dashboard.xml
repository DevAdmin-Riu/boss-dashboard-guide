            size="small"
            labelStyle={{
              width: "100px",
              wordBreak: "keep-all",
              verticalAlign: "middle",
              whiteSpace: "nowrap",
            }}
            column={3}
          >
            <Descriptions.Item span={3} label={"은행명"}>
              {settlementAccountInfo?.bankName}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"계좌번호"}>
              {settlementAccountInfo?.accountNo}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"예금주"}>
              {settlementAccountInfo?.accountOwnerName}
            </Descriptions.Item>
            <Descriptions.Item span={3} label={"세금계산서"}>
              {taxInvoiceImageByHqStaffUrl && (
                <Typography.Link href={taxInvoiceImageByHqStaffUrl} target="_blank">
                  세금계산서 파일 열기
                </Typography.Link>
              )}
            </Descriptions.Item>
          </Descriptions>
        </Space>
      </>
    );
  };

  useEffect(() => {
    if (
      [
        MileageSettlementListConfirmModalModeEnum.CreateData,
        MileageSettlementListConfirmModalModeEnum.CreateBulkData,
      ].includes(confirmModalMode)
    ) {
      formForCreate.resetFields();
    }
  }, [confirmModalMode]);

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>{ListNavigator()}</Col>
          <Col>
            <Space>
              {makeExtraHandleUi()}
              {makeExtraExcelDownloadUi()}
            </Space>
          </Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={isLoading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node>
            {...commonTableProps}
            ref={tableRef}
            loading={loading}
            dataSource={dataSource}
            columns={pickerSelectedColumns}
            rowSelection={getRowSelection()}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            summary={(tableData) =>
              getMileageSettlementListTableSummary(tableData, urlType.urlEnum, createPickSummaryColumns)
            }
          />
          <ConfirmModal
            forceRender
            visible={
              confirmModalMode === MileageSettlementListConfirmModalModeEnum.CreateData ||
              confirmModalMode === MileageSettlementListConfirmModalModeEnum.CreateBulkData
            }
            width={tableWidthSumForCreateConfirm + 50}
            modalTitleText={getModalTitleText(confirmModalMode)}
            helpText={getHelpText(confirmModalMode)}
            okText={"확정"}
            okButtonProps={{ loading: mutationLoading }}
            onOk={handleConfirmModalOk}
            onCancel={onConfirmModalClose}
            contentNode={makeConfirmContentNodeForCreate()}
          />
          <ConfirmModal
            visible={
              confirmModalMode === MileageSettlementListConfirmModalModeEnum.TransferDoneData ||
              confirmModalMode === MileageSettlementListConfirmModalModeEnum.TransferDoneBulkData
            }
            modalTitleText={getModalTitleText(confirmModalMode)}
            helpText={getHelpText(confirmModalMode)}
            okText={"확정"}
            okButtonProps={{ loading: mutationLoading }}
            onOk={handleConfirmModalOk}
            onCancel={onConfirmModalClose}
          />
          <Modal
            key="reviewData"
            open={confirmModalMode === MileageSettlementListConfirmModalModeEnum.ReviewData}
            destroyOnClose
            closable={false}
            title="본부수익금 지급 검토"
            cancelText={"뒤로"}
            okText={"확인"}
            onOk={formForReview.submit}
            onCancel={onConfirmModalClose}
            maskClosable={false}
          >
            <Space direction="vertical" size="small">
              <Typography.Text strong>지급요청건을 승인하거나 반려해 주세요.</Typography.Text>
              <Typography.Text type="warning">
                제출된 세금계산서 및 계좌정보를 확인한 후 지급요청건을 승인하거나 반려해 주세요. 반려시 사유를 꼭
                입력해주세요.
              </Typography.Text>
            </Space>

            {makeConfirmContentNodeForReviewing()}
            <Divider />
            <Form
              preserve={false}
              form={formForReview}
              onFinish={(formData) => handleReview(formData)}
              initialValues={{
                reviewResult: true,
                rejectReason: "",
              }}
            >
              <Form.Item name="reviewResult" label="검토 결과">
                <Radio.Group>
                  <Radio value={true}>승인</Radio>
                  <Radio value={false}>반려</Radio>
                </Radio.Group>
              </Form.Item>
              <Form.Item
                noStyle
                shouldUpdate={(prevValues, currentValues) => prevValues.reviewResult !== currentValues.reviewResult}
              >
                {({ getFieldValue }) => {
                  const radioValue = getFieldValue("reviewResult");
                  if (radioValue === false) {
                    return (
                      <Form.Item
                        name="rejectReason"
                        label="반려 사유"
                        rules={[{ required: true, message: "반려 시 반려 사유를 입력하세요." }]}
                      >
                        <Input.TextArea />
                      </Form.Item>
                    );
                  } else {
                    return null;
                  }
                }}
              </Form.Item>
            </Form>
          </Modal>
          <Modal
            key="checkData"
            open={confirmModalMode === MileageSettlementListConfirmModalModeEnum.CheckData}
            destroyOnClose
            closable={false}
            title="본부수익금 지급 정보 조회"
            maskClosable={true}
            onCancel={onConfirmModalClose}
            footer={null}
          >
            {makeConfirmContentNodeForReviewing()}
          </Modal>
        </Card>
      </Space>
    </>
  );
};
