<file path="src/app/views/order/orders/components/FulfillmentInspectListPage/FulfillmentInspectListPage.tsx">
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { useWebViewMessageHandler } from "@hooks/useWebViewMessageHandler";
import { getCardClassName } from "@src/app/components/antd/Card/CardProps";
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { commonTableProps, getTableRowClassName } from "@src/app/components/antd/Table/TableProps";
import { IFilterElement } from "@src/app/components/Filter";
import CompactFilter from "@src/app/components/Filter/CompactFilter";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { CompactFilterPageProps } from "@src/global/core/types/types";
import { BarcodePrefixEnum } from "@utils/barcode/convertBarcode";
import { maybe } from "@utils/misc";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { sendMessageToWebView } from "@utils/webView";
import {
  Affix,
  Button,
  Card,
  Col,
  Form,
  FormInstance,
  Input,
  Row,
  Space,
  Switch,
  Table,
  TableProps,
  Tag,
  Typography,
} from "antd";
import { SizeType } from "antd/lib/config-provider/SizeContext";
import React, { useEffect, useRef, useState } from "react";

import { FulfillmentLinesByVariant_fulfillmentLinesByVariant } from "../../api/types/FulfillmentLinesByVariant";
import { FulfillmentInspectListViewUrlQueryParams } from "../../urls";
import {
  IFulfillmentInspectForm,
  TInspectByVariantLinesObj,
} from "../../views/FulfillmentInspectListView/FulfillmentInspectListView";
import { createFilterStructure, FulfillmentInspectFilterKeys, FulfillmentInspectListFilterOpts } from "./filters";
import {
  getFulfillmentInspectListTableSetting,
  getFulfillmentInspectListTableSettingForMobile,
  getFulfillmentInspectListTableSummary,
} from "./FulfillmentInspectListTableSettings";
import {
  checkIsAllInspectCompletedWatched,
  checkIsInspectCompletedWatched,
  checkIsInspectProgressWatched,
} from "./utils";
import { WarehouseSelectModal } from "./WarehouseSelectModal";

interface FulfillmentInspectListPageProps
  extends CompactFilterPageProps<FulfillmentInspectFilterKeys, FulfillmentInspectListFilterOpts> {
  params: FulfillmentInspectListViewUrlQueryParams;
  loading: boolean;
  dataSource: FulfillmentLinesByVariant_fulfillmentLinesByVariant[];
  totalUninspectedQty: {
    current: number;
    daily: number;
  };
  form: FormInstance<IFulfillmentInspectForm>;
  selectedWarehouseId: string;
  onWarehouseSelect: (warehouseId: string) => void;
  onInspect: () => void;
  onReset: () => void;
  onViewFulfillmentInspectDetail: (variantId: string) => void;
  onParamsChange: (changedParams: FulfillmentInspectListViewUrlQueryParams) => void;
}

const FulfillmentInspectListPage: React.FC<FulfillmentInspectListPageProps> = (props) => {
  const {
    params,
    loading,
    dataSource,
    totalUninspectedQty,
    form,
    selectedWarehouseId: initialWarehouseId,
    onWarehouseSelect,
    onInspect,
    onReset,
    onViewFulfillmentInspectDetail,
    onParamsChange,
    filterOpts,
    onFilterChange,
    onFilterReset,
  } = props;
  const shop = useShop();
  const filterStructure = createFilterStructure(filterOpts);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const [isAffixed, setIsAffixed] = useState<boolean>(false);
  const [warehouseModalOpen, setWarehouseModalOpen] = useState<boolean>(false);

  const isMobile = utils.checkMobile();
  const cardBodyPadding = isMobile ? 0 : undefined;
  const size: SizeType = isMobile ? "small" : undefined;
  const warnDuration = 3;

  // 물류센터 옵션 생성
  const warehouseAddresses = maybe(() => shop.defaultWarehouse.addresses, []);
  const warehouseOptions = warehouseAddresses.map((addr) => ({
    label: addr.companyName,
    value: addr.id,
  }));

  // 선택된 물류센터 정보
  const selectedWarehouse = warehouseAddresses.find((addr) => addr.id === initialWarehouseId);

  // 페이지 진입 시 물류센터 미선택이면 모달 자동 오픈
  useEffect(() => {
    if (!initialWarehouseId && warehouseOptions.length > 0) {
      setWarehouseModalOpen(true);
    }
  }, [initialWarehouseId, warehouseOptions.length]);

  const handleWarehouseConfirm = (warehouseId: string) => {
    onWarehouseSelect(warehouseId);
    setWarehouseModalOpen(false);
  };

  const handleWarehouseChange = () => {
    setWarehouseModalOpen(true);
  };

  const linesObjWatched = Form.useWatch("linesObj", form) || {};
  const linesArr = convertFormLinesObjToArr(linesObjWatched, "variantId");

  const inspectedLineExist = linesArr.some((line) => line.inspectQtyByVariant > 0);
  const isAllCompleted = checkIsAllInspectCompletedWatched(dataSource, linesObjWatched);

  // NOTE: 웹뷰로부터 전송되는 바코드 스캔 결과 처리 시, dataSource와 linesObjWatched의 실시간 값을 참조하기 위해 useRef 사용
  const webViewHandlerDataRef = useRef<{
    params: FulfillmentInspectListViewUrlQueryParams;
    dataSource: FulfillmentLinesByVariant_fulfillmentLinesByVariant[];
    linesObjWatched: TInspectByVariantLinesObj;
  }>({ params, dataSource, linesObjWatched });

  useEffect(() => {
    webViewHandlerDataRef.current.params = params;
  }, [params]);
  useEffect(() => {
    webViewHandlerDataRef.current.dataSource = dataSource;
  }, [dataSource]);
  useEffect(() => {
    webViewHandlerDataRef.current.linesObjWatched = linesObjWatched;
  }, [linesObjWatched]);

  useWebViewMessageHandler({
    handlers: {
      BARCODE_SCANNED: (value) => {
        const {
          params: currentParams,
          dataSource: currentDataSource,
          linesObjWatched: currentLinesObjWatched,
        } = webViewHandlerDataRef.current;
        const prefixLength = 4;
        const prefix = value.slice(0, prefixLength) as BarcodePrefixEnum;
        const scannedData = value.slice(prefixLength);

        switch (prefix) {
          case BarcodePrefixEnum.SECTOR:
            onParamsChange({ ...currentParams, sectorSearch: scannedData });
            return;
          case BarcodePrefixEnum.LOCATION:
            onParamsChange({ ...currentParams, locationSearch: scannedData });
            return;
          case BarcodePrefixEnum.PRODUCT:
            const warnMsgSuffix = `(제품코드: ${scannedData})`;
            const scannedLineIdx = currentDataSource.findIndex((record) => record.productVariant.sku === scannedData);
            if (scannedLineIdx < 0) {
              showNotificationWarn(
                "조회된 목록에 존재하지 않는 제품코드입니다." + warnMsgSuffix,
                undefined,
                warnDuration
              );
              sendMessageToWebView("BARCODE_ERROR", null);
              return;
            }

            const notCompletedLineList = currentDataSource.filter((record) => {
              const inspectQtyByVariantWatched = currentLinesObjWatched[record.productVariant.id].inspectQtyByVariant;
              const isCompletedWatched = checkIsInspectCompletedWatched(record, inspectQtyByVariantWatched);
              return !isCompletedWatched;
            });
            const notCompletedLineIdx = notCompletedLineList.findIndex(
              (record) => record.productVariant.sku === scannedData
            );
            if (notCompletedLineIdx < 0) {
              showNotificationWarn("검수 완료된 제품입니다." + warnMsgSuffix, undefined, warnDuration);
              sendMessageToWebView("BARCODE_ERROR", null);
              return;
            }

            const variantId = notCompletedLineList[notCompletedLineIdx].productVariant.id;
            const inspectQtyByVariantWatched = currentLinesObjWatched[variantId].inspectQtyByVariant;
            form.setFieldValue(["linesObj", variantId, "inspectQtyByVariant"], inspectQtyByVariantWatched + 1);
            return;
          default:
            const errorScannedData = utils.isEmpty(value, true) ? "스캔 결과 없음" : `스캔 결과: ${value}`;
            showNotificationWarn(
              `잘못된 바코드입니다. 다시 스캔해주세요.(${errorScannedData})`,
              undefined,
              warnDuration
            );
            sendMessageToWebView("BARCODE_ERROR", null);
            return;
        }
      },
    },
  });

  useEffect(() => {
    if (isAllCompleted) {
      onInspect();
    }
  }, [isAllCompleted]);

  const validateQueryClick = (filterData: Array<IFilterElement<FulfillmentInspectFilterKeys>>) => {
    // 구역, 로케이션 필터 중 최소 하나는 필수로 입력해야 함
    const sectorSearchActive = filterData.find((e) => e.name === FulfillmentInspectFilterKeys.sectorSearch).active;
    const locationSearchActive = filterData.find((e) => e.name === FulfillmentInspectFilterKeys.locationSearch).active;
    if (!sectorSearchActive && !locationSearchActive) {
      showNotificationWarn("구역 또는 로케이션 필터를 입력해주세요.", undefined, warnDuration);
      return false;
    }
    return true;
  };

  const columns = getFulfillmentInspectListTableSetting({ form, onViewFulfillmentInspectDetail });
  const columnsForMobile = getFulfillmentInspectListTableSettingForMobile({ form, onViewFulfillmentInspectDetail });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const pageTitle = (
    <Space direction="vertical" size={0}>
      <Form.Item
        style={{ margin: 0 }}
        name="manualInspectAllowed"
        valuePropName="checked"
        label={<Typography.Title level={5}>수동 검수 허용</Typography.Title>}
      >
        <Switch disabled={!isMobile} checkedChildren="ON" unCheckedChildren="OFF" />
      </Form.Item>
    </Space>
  );

  const extraUi = (
    <Space>
      <Button shape="round" size={size} disabled={!inspectedLineExist} onClick={onReset}>
        검수 초기화
      </Button>
      <Button type="primary" shape="round" size={size} disabled={!inspectedLineExist} onClick={onInspect}>
        검수 저장
      </Button>
    </Space>
  );

  const commonListTableProps: TableProps<FulfillmentLinesByVariant_fulfillmentLinesByVariant> = {
    ...commonTableProps,
    rowKey: (record) => record.productVariant.id,
    loading,
    dataSource,
    rowClassName: (record) => {
      const { id } = record.productVariant;
      const inspectQtyByVariantWatched = linesObjWatched[id]?.inspectQtyByVariant;
      const isCompletedWatched = checkIsInspectCompletedWatched(record, inspectQtyByVariantWatched);
      const isProgressWatched = checkIsInspectProgressWatched(record, inspectQtyByVariantWatched);
      const rowClassName = isCompletedWatched
        ? getTableRowClassName(["ant-table-row-complete"])
        : isProgressWatched
        ? getTableRowClassName(["ant-table-row-progress"])
        : null;
      return rowClassName;
    },
    summary: (dataSource) =>
      getFulfillmentInspectListTableSummary({
        dataSource,
        totalUninspectedQty,
        colCount: isMobile ? columnsForMobile.length : columns.length,
      }),
  };

  const responsiveTable = isMobile ? (
    <Table<FulfillmentLinesByVariant_fulfillmentLinesByVariant>
      {...commonListTableProps}
      ref={tableRef}
      columns={columnsForMobile}
    />
  ) : (
    <Table<FulfillmentLinesByVariant_fulfillmentLinesByVariant>
      {...commonListTableProps}
      ref={tableRef}
      columns={columns}
      scroll={{ x: tableWidthSum, y: tableScrollY }}
    />
  );

  return (
    <Space direction="vertical" size={size}>
      <Affix offsetTop={70} onChange={setIsAffixed}>
        <Card size="small" className={getCardClassName(isAffixed ? ["ant-card-shadow"] : [])}>
          <Row justify="space-between" align="bottom">
            <Col>{pageTitle}</Col>
            <Col>{extraUi}</Col>
          </Row>
        </Card>
      </Affix>

      {/* 물류센터 선택 표시 */}
      {selectedWarehouse && (
        <Card size="small">
          <Row justify="space-between" align="middle">
            <Col>
              <Space>
                <Typography.Text strong>물류센터:</Typography.Text>
                <Tag color="blue">{selectedWarehouse.companyName}</Tag>
              </Space>
            </Col>
            <Col>
              <Button size="small" onClick={handleWarehouseChange}>
                변경
              </Button>
            </Col>
          </Row>
        </Card>
      )}

      <Card bodyStyle={{ padding: cardBodyPadding }}>
        <Space direction="vertical" size={size}>
          <CompactFilter<FulfillmentInspectFilterKeys>
            autoCollapse={isMobile}
            filterStructure={filterStructure}
            subFilterKeys={[FulfillmentInspectFilterKeys.sectorSearch, FulfillmentInspectFilterKeys.locationSearch]}
            onFilterChange={onFilterChange}
            onFilterReset={onFilterReset}
            validateQueryClick={validateQueryClick}
          />

          <Form.Item name="linesObj" hidden>
            <Input />
          </Form.Item>
          {responsiveTable}
        </Space>
      </Card>

      {/* 물류센터 선택 모달 */}
      <WarehouseSelectModal
        open={warehouseModalOpen}
        warehouseOptions={warehouseOptions}
        selectedWarehouseId={initialWarehouseId}
        onConfirm={handleWarehouseConfirm}
