  publishDate: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: TrainingDocListFilterOpts,
  routeParams: TrainingDocListViewRouteParams,
  isStaff: boolean
) {
  const { menuType } = routeParams;
  const tagSearchFilter = {
    ...createTextField(0, TrainingDocListFilterKeys.tagSearch, "태그", opts.tagSearch.value),
    active: opts.tagSearch.active,
  };
  const titleSearchFilter = {
    ...createTextField(0, TrainingDocListFilterKeys.titleSearch, "제목", opts.titleSearch.value),
