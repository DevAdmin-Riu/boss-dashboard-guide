export enum OrderDetailsModalModeEnum {
  EditShippingAddress = "EditShippingAddress",
  Cancel = "Cancel",
  CancelFulfillment = "CancelFulfillment",
  Refund = "Refund",
  UpdateFulfillmentTrackingForCourier = "UpdateFulfillmentTrackingForCourier",
  UpdateFulfillmentTrackingForNonCourier = "UpdateFulfillmentTrackingForNonCourier",
  UpdateFulfillmentTrackingForDs = "UpdateFulfillmentTrackingForDs",
  UpdateFulfillmentTrackingForCompleted = "UpdateFulfillmentTrackingForCompleted",
  RefundQuestions = "RefundQuestions",
  RefundAndExchangeCreate = "RefundAndExchangeCreate",
  EstimatedArrivalDateUpdate = "EstimatedArrivalDateUpdateModal",
  PaymentStatusChange = "PaymentStatusChange",
}

interface OrderDetailsViewProps {
  id: string;
}

export const OrderDetailsView: React.FC<OrderDetailsViewProps> = ({ id }) => {
  const shop = React.useContext(ShopContext);
  const navigate = useNavigator();
  const location = useLocation();
  const search = location.search;
  const { user } = useUser();
  const { isHqStaff, isStaff } = user;
  const [refundId, setRefundId] = useState(null);

  const { data: courierData } = useCourierListQuery({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.couriers, filter: { isActive: true } },
  });
  const couriers = maybe(() => courierData.couriers.edges.map((edge) => edge.node), []);

  const handleFulfillmentUpdate = (data: FulfillmentUpdateTracking) => {
    const errors = data.fulfillmentUpdateTracking?.errors;
    if (errors.length === 0) {
      let successMsg = "";
      switch (modalMode) {
        case OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCourier:
          successMsg = "송장번호가 입력되었습니다.";
          break;
        case OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForNonCourier:
          successMsg = "기타배송 배차정보가 저장되었습니다.";
          break;
        case OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForDs:
          successMsg = "직배송 배송시작 여부가 갱신되었습니다.";
          break;
        case OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCompleted:
          successMsg = "배송 완료 상태가 갱신되었습니다.";
          break;
        default:
          break;
      }
      if (!utils.isEmpty(successMsg, true)) {
        showNotificationSuccess(successMsg);
      }
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [fulfillmentUpdateTracking] = useFulfillmentUpdateTrackingMutation({
    onCompleted: handleFulfillmentUpdate,
  });

  const handleFulfillmentCancel = (data: FulfillmentCancel) => {
    const errors = data.fulfillmentCancel?.errors;
    if (errors.length === 0) {
      showNotificationSuccess("출고 취소되었습니다.");
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [fulfillmentCancel, fulfillmentCancelOpts] = useFulfillmentCancelMutation({
    onCompleted: handleFulfillmentCancel,
  });

  const handleOrderCancel = (data: OrderCancel) => {
    const errors = data.orderCancel?.errors;
    if (errors.length === 0) {
      showNotificationSuccess("주문이 취소되었습니다.");
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [orderCancel, orderCancelOpts] = useOrderCancelMutation({
    onCompleted: handleOrderCancel,
  });

  const handleUpdateStaffPaymentChargeStatus = (data: UpdateStaffPaymentChargeStatus) => {
    const errors = data.updateStaffPaymentChargeStatus?.errors;
    if (errors.length === 0) {
      showNotificationSuccess("결제 상태가 변경되었습니다.");
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [updateStaffPaymentChargeStatus, updateStaffPaymentChargeStatusOpts] =
    useUpdateStaffPaymentChargeStatusMutation({
      onCompleted: handleUpdateStaffPaymentChargeStatus,
    });

  const handleOrderAddNote = (data: OrderAddNote) => {
    const errors = data.orderAddNote?.errors;
    if (errors.length === 0) {
      showNotificationSuccess("주문 내역에 메모를 추가했습니다.");
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [orderAddNote] = useOrderAddNoteMutation({
    onCompleted: handleOrderAddNote,
  });

  const [orderUpdate, orderUpdateOpts] = useOrderUpdateMutation({
    onCompleted: (data) => {
      const errors = data.orderUpdate?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("주문 배송지 주소를 수정했습니다.");
        resetForCloseModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [modalMode, setModalMode] = useState(null);
  const [idForModal, setIdForModal] = useState(null);
  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: OrderDetailsModalModeEnum, idForModal?: string) => {
    setModalMode(modalMode);
    if (idForModal) {
      setIdForModal(idForModal);
    }
  };

  const {
    data,
    loading,
    refetch: refetchOrderDetails,
  } = useOrderDetailsQuery({
    variables: {
      id,
      skipWhenHqStaff: false, // 가맹본부 여부를 전달
    },
  });

  const order = maybe(() => data?.order, null);

  const isB2bOrder = checkOrderedByStaffForB2b(order?.type);

  const queryVariablesForRefundedList: RefundedListVariables = useMemo(
    () => ({
      first: GrapheneRelayConnectionMaxLimitEnum.reportRefundedList,
      filter: { order: order?.id, isMainPv: true },
      sort: getRefundedListSortQueryVariables({ sort: RefundedListViewUrlSortField.refundedAt }),
    }),
    [order]
  );
  const { data: refundedData, refetch: refetchRefundedList } = useRefundedListQuery({
    skip: !order || isHqStaff || isB2bOrder,
    variables: queryVariablesForRefundedList,
  });
  const refundedList = maybe(() => refundedData.refundedOrderLines.edges.map((edge) => edge.node), []);

  const { data: warehouseData } = useWarehouseList({
    skip: !order || isHqStaff || isB2bOrder,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.warehouses,
    },
  });
  const warehouses = maybe(() => warehouseData.warehouses.edges.map((edge) => edge.node), []);

  const fulfillment = order?.fulfillments?.find((fulfillment) => fulfillment?.id === idForModal);
  const isCapturedStatus =
    order?.paymentStatus === PaymentChargeStatusEnum.PARTIALLY_CHARGED ||
    order?.paymentStatus === PaymentChargeStatusEnum.FULLY_CHARGED;
  const handleOrderCancelSubmit = () => {
    if (isCapturedStatus) {
      showNotificationError(
        "결제 완료된 주문은 취소가 불가능 합니다. 환불 처리 후 필요 시 상품 회수를 진행해야 합니다."
      );
      return;
    }
    orderCancel({ variables: { id } });
  };

  useEffect(() => {
    if (search === "") {
      return;
    }

    const refundFilter = search
      .slice(1)
      .split("&")
      .filter((item) => {
        const split = item.split("=");
        if (split[0] === "refund") {
          setRefundId(item.replace("refund=", ""));
          return item;
        }
      });

    if (refundFilter.length > 0) {
      openModalWithoutNavigate(OrderDetailsModalModeEnum.Refund);
    }
  }, []);

  if (loading) {
    return <Loader />;
  }
  if (utils.isEmpty(order)) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={historyBack} />;
  }

  const isOrderUserHqStaff = order.user?.isHqStaff || false;
  let onProfileViewUrl: (id: string) => string;
  const onProfileViewId: string = isOrderUserHqStaff ? order.user?.id : order?.user?.brandStoreUser?.brandStore?.id;
  if (isOrderUserHqStaff) {
    onProfileViewUrl = isHqStaff ? hqBrandAccountDetailsViewUrl : brandAccountDetailsUrl;
  } else {
    onProfileViewUrl = isHqStaff ? hqBrandStoreDetailsViewUrl : brandStoreDetailsViewUrl;
  }

  const isOrderedByHqStaffForBrand = checkOrderedByHqStaffForBrand(order?.type);

  return (
    <>
      <WindowTitle title={`주문 상세: ${order?.composedIdWithPrefix}`} />
      <OrderDetailsPage
        onNoteAdd={(variables) => orderAddNote({ variables: { input: variables, order: id } })}
        onBack={historyBack}
        order={order}
        refundedList={refundedList}
        couriers={couriers}
        userPermissions={user?.userPermissions || []}
        onOrderCancel={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.Cancel)}
        onFulfillmentCancel={(fulfillmentId) =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.CancelFulfillment, fulfillmentId)
        }
        onFulfillmentUpdateTrackingForCourier={(fulfillmentId) =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCourier, fulfillmentId)
        }
        onFulfillmentUpdateTrackingForNonCourier={(fulfillmentId) =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForNonCourier, fulfillmentId)
        }
        onFulfillmentUpdateTrackingForDs={(fulfillmentId) =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForDs, fulfillmentId)
        }
        onFulfillmentUpdateTrackingForCompleted={(fulfillmentId) =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCompleted, fulfillmentId)
        }
        onEstimatedArrivalDateUpdate={() =>
          openModalWithoutNavigate(OrderDetailsModalModeEnum.EstimatedArrivalDateUpdate)
        }
        onPaymentRefund={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.Refund)}
        onPaymentStatusChange={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.PaymentStatusChange)}
        onShippingAddressEdit={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.EditShippingAddress)}
        onProfileView={() => navigate(onProfileViewUrl(onProfileViewId))}
        onShowingAllRefundQs={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.RefundQuestions)}
        onRefundAndExchangeCreate={() => openModalWithoutNavigate(OrderDetailsModalModeEnum.RefundAndExchangeCreate)}
        isStaff={isStaff}
        isHqStaff={isHqStaff}
        isB2bOrder={isB2bOrder}
      />
      {(!isHqStaff || (isHqStaff && isOrderedByHqStaffForBrand)) && (
        <>
          <OrderCannotCancelOrderDialog
            onClose={resetForCloseModal}
            open={
              modalMode === OrderDetailsModalModeEnum.Cancel &&
              order?.fulfillments?.some((fulfillment) => fulfillment?.status === FulfillmentStatus.FULFILLED)
            }
          />
          <OrderCancelDialog
            confirmButtonState={orderCancelOpts.status}
            open={
              modalMode === OrderDetailsModalModeEnum.Cancel &&
              !order?.fulfillments?.some((fulfillment) => fulfillment?.status === FulfillmentStatus.FULFILLED)
            }
            onClose={resetForCloseModal}
            onSubmit={handleOrderCancelSubmit}
            shop={shop}
            order={order}
          />
          <OrderRefundQuestionsModal
            open={modalMode === OrderDetailsModalModeEnum.RefundQuestions}
            onClose={resetForCloseModal}
            refundQuestions={order?.refundQA}
            lines={order?.lines}
          />
          <OrderRefundAndExchangeCreateModal
            open={modalMode === OrderDetailsModalModeEnum.RefundAndExchangeCreate}
            onClose={resetForCloseModal}
            order={order}
          />
          <OrderRefundModal
            open={modalMode === OrderDetailsModalModeEnum.Refund}
            onClose={resetForCloseModal}
            order={order}
            refetchOrderDetails={() => {
              refetchOrderDetails();
              refetchRefundedList(queryVariablesForRefundedList);
            }}
            refundId={refundId}
          />
          <OrderChangePaymentStatusModal
            open={modalMode === OrderDetailsModalModeEnum.PaymentStatusChange}
            onSubmit={updateStaffPaymentChargeStatus}
            onClose={resetForCloseModal}
            payment={order?.lastPayment}
            paymentStatus={order?.paymentStatus}
            loading={updateStaffPaymentChargeStatusOpts.loading}
          />
          <FulfillmentCancelDialog
            open={modalMode === OrderDetailsModalModeEnum.CancelFulfillment}
            disabled={fulfillmentCancelOpts.loading}
            fulfillment={fulfillment}
            warehouses={warehouses}
            onConfirm={(formData: FulfillmentCancelInput) =>
              fulfillmentCancel({ variables: { id: idForModal, input: formData } })
            }
            onClose={resetForCloseModal}
          />
          <OrderFulfillmentTrackingModal
            couriers={couriers}
            open={!!idForModal && modalMode === OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCourier}
            initialValues={{
              trackingNumber: getStringOrPlaceholder(fulfillment?.trackingNumber),
              courierId: getStringOrPlaceholder(fulfillment?.courier?.id),
            }}
            onSubmit={(formData) => {
              const { trackingNumber, courierId } = formData;
              fulfillmentUpdateTracking({
                variables: {
                  id: idForModal,
                  input: { courierId, trackingNumber },
                  isPoLineDeliveryConfirmed: false,
                  returnOrder: true,
                },
              });
            }}
            onClose={resetForCloseModal}
          />
          <OrderFulfillmentTrackingDeliveryManInfoModal
            open={!!idForModal && modalMode === OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForNonCourier}
            initialValues={{ etcDeliveryManInfo: fulfillment?.etcDeliveryManInfo }}
            onSubmit={(formData) => {
              const { etcDeliveryManInfo } = formData;
              fulfillmentUpdateTracking({
                variables: {
                  id: idForModal,
                  input: { etcDeliveryManInfo },
                  isPoLineDeliveryConfirmed: false,
                  returnOrder: true,
                },
              });
            }}
            onClose={resetForCloseModal}
          />
          <OrderFulfillmentTrackingDirectShippingModal
            open={!!idForModal && modalMode === OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForDs}
            initialValues={{
              isTrackingDirectShipping: utils.isEmpty(fulfillment?.trackingNumber) === false,
            }}
            onSubmit={(formData) => {
              const { isTrackingDirectShipping } = formData;
              fulfillmentUpdateTracking({
                variables: {
                  id: idForModal,
                  input: { isTrackingDirectShipping },
                  isPoLineDeliveryConfirmed: false,
                  returnOrder: true,
                },
              });
            }}
            onClose={resetForCloseModal}
          />
          <OrderFulfillmentCompleteTrackingDialog
            open={!!idForModal && modalMode === OrderDetailsModalModeEnum.UpdateFulfillmentTrackingForCompleted}
            initialValues={{ isTrackingCompleted: fulfillment?.isTrackingCompleted }}
            onSubmit={(formData) => {
              const { isTrackingCompleted } = formData;
              fulfillmentUpdateTracking({
                variables: {
                  id: idForModal,
                  input: { isTrackingCompleted },
                  isPoLineDeliveryConfirmed: false,
                  returnOrder: true,
                },
              });
            }}
            onClose={resetForCloseModal}
          />
          <OrderAddressEditDialog
            open={modalMode === OrderDetailsModalModeEnum.EditShippingAddress}
            loading={orderUpdateOpts.loading}
            order={order}
            onConfirm={(data) => orderUpdate({ variables: { id, input: { shippingAddress: data } } })}
            onClose={resetForCloseModal}
          />
          <EstimatedArrivalDateUpdateModal
            open={modalMode === OrderDetailsModalModeEnum.EstimatedArrivalDateUpdate}
            order={order}
            onClose={resetForCloseModal}
          />
        </>
      )}
    </>
  );
};
</file>

