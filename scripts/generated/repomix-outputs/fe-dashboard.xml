interface BsOpsRecheckReportItemListProps {
  report: BsOpsCheckReportDetails_bsOpsCheckReport;
  onStatusUpdate: (variables: BsOpsRecheckReportItemStatusUpdateVariables) => Promise<boolean>;
}

export const BsOpsRecheckReportItemList: React.FC<BsOpsRecheckReportItemListProps> = (props) => {
  const { report, onStatusUpdate } = props;
  const [reReqModalOpen, setReReqModalOpen] = useState<boolean>(false);
  const [form] = Form.useForm<BsOpsRecheckReportItemStatusUpdateVariables>();
  const TypeSafeForm = getTypeSafeForm<BsOpsRecheckReportItemStatusUpdateVariables>(form);

  const initialValues: BsOpsRecheckReportItemStatusUpdateVariables = {
    id: null,
    input: {
      status: BsOpsRecheckReportItemStatusEnum.RE_REQUESTED,
      rejectReason: null,
    },
  };

  useEffect(() => {
    if (!reReqModalOpen) {
      form.resetFields();
    }
  }, [reReqModalOpen]);

  const categoryItemList = report.template.categories
    .flatMap((category) => category.children)
    .flatMap((child) => child.items);
  const reportItemList = report.items;
  const recheckItemList = reportItemList
    .filter((item) => !utils.isEmpty(item.recheckItem))
    .map((item) => item.recheckItem);

  const columns: ColumnsType<BsOpsCheckReportDetails_bsOpsCheckReport_items_recheckItem> = [
    {
      title: columnNameConstant.brandStore.STATUS,
      key: "status",
      align: "center",
      width: 100,
      render: (_, record) => utils.getLabelTextByValue(record.status, bsOpsRecheckReportItemStatusChoices),
    },
    {
      title: columnNameConstant.common.REGISTERED_DATE,
      key: "createdAt",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.createdAt} onlyDate />,
    },
    {
      title: columnNameConstant.brandStore.SUBMIT_DATE,
      key: "submittedAt",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.submittedAt} onlyDate />,
    },
    {
      title: "점검 항목",
      key: "categoryItem",
      width: 250,
      render: (_, record) => {
        const reportItem = reportItemList.find((item) => item.recheckItem?.id === record.id);
        const categoryItem = categoryItemList.find((item) => item.id === reportItem?.categoryItem.id);
        return <BsOpsCheckTemplateCategoryItem categoryItem={categoryItem} />;
      },
    },
    {
      title: "예상 처분",
      key: "expectedFineAndSuspension",
      width: 140,
      render: (_, record) => {
        const reportItem = reportItemList.find((item) => item.recheckItem?.id === record.id);
        const categoryItem = categoryItemList.find((item) => item.id === reportItem?.categoryItem?.id);

        return (
          <Space direction="vertical" size={0}>
            <Row justify="space-between">
              <Col>
                <Typography.Text type="secondary">과태료:</Typography.Text>
              </Col>
              <Col>
                <Typography.Text strong>
                  {categoryItem?.expectedFine != null ? `${categoryItem.expectedFine.toLocaleString()} 만원` : "-"}
                </Typography.Text>
              </Col>
            </Row>
            <Row justify="space-between">
              <Col>
                <Typography.Text type="secondary">영업정지:</Typography.Text>
              </Col>
              <Col>
                <Typography.Text strong>
                  {categoryItem?.expectedSuspension != null
                    ? `${categoryItem.expectedSuspension.toLocaleString()} 일`
                    : "-"}
                </Typography.Text>
              </Col>
            </Row>
          </Space>
        );
      },
    },
    {
      title: "답변",
      key: "answer",
      width: 150,
      render: (_, record) => {
        const reportItem = reportItemList.find((item) => item.recheckItem?.id === record.id);
        const recheckItem = reportItem?.recheckItem;
        return <BsOpsCheckAnswerJson answerJson={recheckItem?.answerJson} images={recheckItem?.images} />;
      },
    },
    {
      key: "action",
      align: "center",
      width: 120,
      render: (_, record) => {
        const btnDisabled =
          utils.isEmpty(record.answerJson) || record.status !== BsOpsRecheckReportItemStatus.SUBMITTED;

        return (
          <Space direction="vertical" size="small">
            <Button
              danger
              size="small"
              type="primary"
              disabled={btnDisabled}
              onClick={() => {
                setReReqModalOpen(true);
                TypeSafeForm.setFields([
                  { name: "id", value: record.id },
                  { name: "input.status", value: BsOpsRecheckReportItemStatusEnum.RE_REQUESTED },
                  { name: "input.rejectReason", value: null },
                ]);
              }}
            >
              재요청
            </Button>
            <Popconfirm
              title="해당 점검 항목을 완료 처리하시겠습니까?"
              placement="topRight"
              okText="완료"
              onConfirm={() =>
                onStatusUpdate({ id: record.id, input: { status: BsOpsRecheckReportItemStatusEnum.COMPLETED } })
              }
            >
              <Button size="small" type="primary" disabled={btnDisabled}>
                완료 처리
              </Button>
            </Popconfirm>
          </Space>
        );
      },
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Card title={<PageHeader title="재점검 요청" />}>
      <Table<BsOpsCheckReportDetails_bsOpsCheckReport_items_recheckItem>
        {...commonTableProps}
        columns={columns}
        dataSource={recheckItemList}
        scroll={{ x: tableWidthSum }}
      />

      <Modal
        forceRender
        destroyOnClose
        title="점검 재요청"
        open={reReqModalOpen}
        okText="재요청"
        okButtonProps={{ danger: true, type: "primary" }}
        onOk={form.submit}
        onCancel={() => setReReqModalOpen(false)}
        maskClosable={false}
      >
        <Form
          name="recheck-item-status-update"
          layout="vertical"
          form={form}
          initialValues={initialValues}
          onFinish={(formData) =>
            onStatusUpdate(formData).then((success) => {
              if (success) {
                setReReqModalOpen(false);
              }
            })
          }
        >
          <Form.Item name={TypeSafeForm.getValidDataIndex("id")} hidden>
            <Input />
          </Form.Item>
          <Form.Item name={TypeSafeForm.getValidDataIndex("input")} hidden>
            <Input />
          </Form.Item>
          <Form.Item name={TypeSafeForm.getValidDataIndex("input.rejectReason")} label="재요청 사유">
            <Input.TextArea rows={4} placeholder="재요청 사유를 입력해주세요." />
          </Form.Item>
        </Form>
      </Modal>
    </Card>
  );
};
</file>

