<file path="src/app/components/AppLayout/utils.ts">
import { IMenuItem } from "./menuStructureStaff";

const getMenuUrlList = (menuItems: IMenuItem[]): string[] => {
  const menuUrlList = menuItems.flatMap((menu) => {
    if (menu.hideCondition) {
      return [];
    }
    if (menu.url) {
      const childUrls = menu.children ? getMenuUrlList(menu.children) : [];
      const navUrls = menu.navUrlList ? menu.navUrlList : [];
      return [menu.url, ...childUrls, ...navUrls];
    } else if (menu.children) {
      return getMenuUrlList(menu.children);
    }
    return [];
  });
  return menuUrlList;
};

export const checkIsUrlIncludedByMenuStructure = (menuStructure: IMenuItem[], url: string) => {
  const menuUrlList = getMenuUrlList(menuStructure);
  return menuUrlList.some((menuUrl) => menuUrl.includes(url));
};
</file>

