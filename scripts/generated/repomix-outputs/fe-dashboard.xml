<file path="src/app/views/requestProduct/urls.ts">
import { UrlListType } from "@src/app/components/Navigator/ListNavigator";
import {
  ActiveTab,
  Dialog,
  Filters,
  FiltersWithMultipleValues,
  Pagination,
  SingleAction,
  TabActionDialog,
} from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export interface ReqBossProductUrlListType {
  url: string;
  urlEnum: ReqBossProductUrlEnum;
  fnUrl: (params?: ReqBossProductListViewUrlQueryParams) => string;
}

export const reqBossProductSectionUrl = "/req-boss-product";

export const reqBossProductListViewPath = reqBossProductSectionUrl;

export const reqBossProductListForAllViewPath = urlJoin(reqBossProductListViewPath, "all");
export const reqBossProductListForRequestedViewPath = urlJoin(reqBossProductListViewPath, "requested");
export const reqBossProductListForEstimateViewPath = urlJoin(reqBossProductListViewPath, "estimate");
export const reqBossProductListForConfirmedViewPath = urlJoin(reqBossProductListViewPath, "confirmed");
export const reqBossProductListForCompletedViewPath = urlJoin(reqBossProductListViewPath, "completed");

// TODO: 백엔드 참고하여, 리스트에 필요한 필터 추가로 작성
export enum ReqBossProductListViewUrlFiltersEnum {
  brandId = "brandId",
  brandSearch = "brandSearch",
  productSearch = "productSearch",
  requestNumber = "requestNumber",
  requestedStatusAtTo = "requestedStatusAtTo",
  requestedStatusAtFrom = "requestedStatusAtFrom",
  acceptedStatusAtTo = "acceptedStatusAtTo",
  acceptedStatusAtFrom = "acceptedStatusAtFrom",
  reqAdditionalStatusAtTo = "reqAdditionalStatusAtTo",
  reqAdditionalStatusAtFrom = "reqAdditionalStatusAtFrom",
  vendorPriceStatusAtTo = "vendorPriceStatusAtTo",
  vendorPriceStatusAtFrom = "vendorPriceStatusAtFrom",
  brandPriceStatusAtTo = "brandPriceStatusAtTo",
  brandPriceStatusAtFrom = "brandPriceStatusAtFrom",
  reqEstimateFixStatusAtTo = "reqEstimateFixStatusAtTo",
  reqEstimateFixStatusAtFrom = "reqEstimateFixStatusAtFrom",
  confirmedStatusAtTo = "confirmedStatusAtTo",
  confirmedStatusAtFrom = "confirmedStatusAtFrom",
  completedStatusAtTo = "completedStatusAtTo",
  completedStatusAtFrom = "completedStatusAtFrom",
  spec = "spec",
  material = "material",
  color = "color",
  isExclusive = "isExclusive",
}

export enum ReqBossProductListViewUrlFiltersWithMultipleValuesEnum {
  status = "status",
}

export type ReqBossProductListViewUrlFilters = Filters<ReqBossProductListViewUrlFiltersEnum> &
  FiltersWithMultipleValues<ReqBossProductListViewUrlFiltersWithMultipleValuesEnum>;
export type ReqBossProductListViewUrlDialog = "cancel" | TabActionDialog;
export type ReqBossProductListViewUrlQueryParams = Dialog<ReqBossProductListViewUrlDialog> &
  ReqBossProductListViewUrlFilters &
  Pagination &
  ActiveTab;

export const reqBossProductListViewUrl = (viewPath: string) => (params?: ReqBossProductListViewUrlQueryParams) =>
  params === undefined ? viewPath : urlJoin(viewPath, "?" + stringifyQs(params));

export enum ReqBossProductUrlEnum {
  ALL = "ALL",
  REQUESTED = "REQUESTED",
  ESTIMATE = "ESTIMATE",
  CONFIRMED = "CONFIRMED",
  COMPLETED = "COMPLETED",
}

export const getReqBossProductNavButtonName = (urlEnum: ReqBossProductUrlEnum): string => {
  switch (urlEnum) {
    case ReqBossProductUrlEnum.ALL:
      return "모든 단계 보기";
    case ReqBossProductUrlEnum.REQUESTED:
      return "포장보스 상품 요청";
    case ReqBossProductUrlEnum.ESTIMATE:
      return "상품 견적 작성";
    case ReqBossProductUrlEnum.CONFIRMED:
      return "최종 견적 확인";
    case ReqBossProductUrlEnum.COMPLETED:
