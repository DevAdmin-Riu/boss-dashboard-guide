import { utils } from "@utils/utils";
import { Select } from "antd";
import React from "react";

interface SearchSelectProps<T extends { label: string; value: string | number }> {
  initOptions: T[]; // 전체 카테고리 리스트
  value?: string;
  onChange: (value: string) => void; // 선택 변경 handler
  placeholder?: string;
  error?: boolean;
  size?: "large" | "middle" | "small";
}

export const SearchSelect = <T extends { label: string; value: string | number }>({
  initOptions,
  value,
  onChange,
  placeholder = "",
  error = false,
  size = "large",
}: SearchSelectProps<T>) => {
  const [searchText, setSearchText] = React.useState("");
  const [options, setOptions] = React.useState<T[]>(initOptions);

  // 검색어가 바뀔 때마다 필터링
  React.useEffect(() => {
    if (utils.isEmpty(searchText)) {
      setOptions(initOptions);
    } else {
      setOptions(initOptions.filter((option) => option.label.toLowerCase().includes(searchText.toLowerCase())));
    }
  }, [searchText, initOptions]);

  // initOptions 자체가 바뀔 때 (초기 로딩 등) 항상 옵션 리셋
  React.useEffect(() => {
    setOptions(initOptions);
  }, [initOptions]);

  return (
    <Select
      showSearch
      style={{ width: "100%" }}
      size={size}
      status={error ? "error" : ""}
      placeholder={placeholder}
      onChange={onChange}
      onSearch={setSearchText}
      filterOption={false}
      defaultActiveFirstOption={false}
      options={options}
      value={value}
    />
  );
};
</file>

