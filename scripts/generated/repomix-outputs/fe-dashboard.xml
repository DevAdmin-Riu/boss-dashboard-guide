interface TaxInvoiceViewButtonProps {
  taxInvoice: TaxInvoiceList_taxInvoiceList_edges_node;
}
const TaxInvoiceViewButton: React.FC<TaxInvoiceViewButtonProps> = (props) => {
  const { taxInvoice } = props;
  const [fetch] = useTaxInvoiceGetUrlLazyQuery();

  return (
    <Button
      size="small"
      type="primary"
      onClick={() => {
        fetch({ variables: { id: taxInvoice.id } })
          .then((res) => {
            const h = 1000;
            const w = 750;
            const left = innerWidth / 2 - h / 2 + screenX;
            const top = innerHeight / 2 - w / 2 + screenY;
            window.open(
              res.data.taxInvoiceUrl,
              "pop up bill tax invoice",
              "toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=no, resizable=no, copyhistory=no, width=" +
                h +
                ", height=" +
                w +
                ", top=" +
                top +
                ", left=" +
                left
            );
          })
          .catch(() => showNotificationError("에러 발생하였습니다"));
      }}
    >
      조회 (전자발행건)
      <SelectOutlined rotate={90} />
    </Button>
  );
};

