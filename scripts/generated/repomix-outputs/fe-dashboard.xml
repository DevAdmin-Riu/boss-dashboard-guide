  trackInventory: boolean;
  onLineDelete: (lineKey: string) => void;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
  isB2b: boolean;
  onShowNoteForUnitPrice: (noteForUnitPrice: string) => void;
  isStaff?: boolean;
}

export const getPurchaseOrderCreateLinesTableSettings = (props: PurchaseOrderCreateLinesTableSettingsProps) => {
  const {
    watchedValues,
    form,
    disabled,
    trackInventory,
    onLineDelete,
    openModalWithoutNavigate,
    isB2b = false,
    onShowNoteForUnitPrice,
    isStaff = false,
  } = props;

  const isB2bTackBack = isB2b && form.getFieldValue("eventType") === PurchaseOrderEventType.CONSIGNMENT_TAKE_BACK;

  const columns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [];
  const noFixedColumn: DownloadableColumnType<IPurchaseOrderCreateLine> = {
    title: "No",
    key: "number",
    fixed: utils.fixedLeftFlag(),
    align: "center",
    width: 50,
    render: (_, _record, idx) => idx + 1,
  };
  columns.push(noFixedColumn);

  if (trackInventory === false) {
    columns.push({
      title: columnNameConstant.order.ORDER_COMPOSED_ID,
      key: "orderComposedId",
      align: "center",
      width: 100,
      render: (_, record) => record.orderLine?.order?.composedIdWithPrefix,
    });
    columns.push({
      title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
      key: "orderLineComposedId",
      align: "center",
      width: 120,
      render: (_, record) => record.orderLine?.composedIdWithPrefix,
    });
  }
  columns.push({
    title: columnNameConstant.purchaseOrder.ASKING_PO_DATE,
    key: "askingPurchaseDate",
    align: "center",
    width: 170,
    render: (_, record) => {
      const disabledDate = (current: Moment) =>
        isB2b
          ? undefined
          : utils.isEmpty(watchedValues.purchaseOrderDate)
          ? current && current < moment(watchedValues.purchaseOrderDate).startOf("day")
          : false;
      return (
        <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "askingPurchaseDate"]}>
          <DatePicker style={{ width: "100%" }} disabledDate={disabledDate} allowClear={false} />
        </Form.Item>
      );
    },
    renderExcel: (record) => record.askingPurchaseDate,
  });

  const productColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 150,
      render: (_, record) => {
        const isProductVariantNoteExist = !utils.isEmpty(record.variant?.note, true);
        const onSkuClick = () =>
          openModalWithoutNavigate(PurchaseOrderModalModeEnum.QueryVariantNote, record.variantId);
        return isProductVariantNoteExist ? (
          <Button type={"text"} onClick={onSkuClick}>
            <Badge dot={isProductVariantNoteExist} offset={[5, 0]}>
              {record.variant?.sku}
            </Badge>
          </Button>
        ) : (
          <Typography.Text>{record.variant?.sku}</Typography.Text>
        );
      },
      renderExcel: (record) => record.variant?.sku,
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 200,
      render: (_, record) => record.variant?.product?.name || "-",
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) => record.variant?.name || "-",
    },
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 200,
      render: (_, record) => {
        const product = record.variant?.product;
        const hasVariants = product.productType.hasVariants;
        const targetAttributes = hasVariants ? record.variant?.attributes : product.attributes;
        return makeProductSpecTextFromAttr(targetAttributes) || "-";
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "right",
      width: 90,
      render: (_, record) => makeProductQtyPerBoxText(record.variant),
    },
    {
      title: columnNameConstant.common.LEAD_TIME,
      key: "poLeadTime",
      align: "center",
      width: 80,
      render: (_, record) => makePOLeadTimeFormat(record.variant.poLeadTime),
    },
    {
      title: columnNameConstant.product.PALLET_QTY,
      key: "palletQty",
      align: "right",
      width: 120,
      render: (_, record) => (record.variant?.palletQty ? getNumberFormat(record.variant?.palletQty) : "-"),
    },
    isB2b && {
      title: columnNameConstant.orderLine.INCLUDE_SALES_B2B_DELIVERY_FEE,
      key: "includePurchaseB2bDeliveryFee",
      align: "center",
      width: 120,
      render: (_, record) => (
        <DeliveryFeeInclusionStatus
          isIncluded={record.variant.defaultVariantVendor.includePurchaseB2bDeliveryFee}
          showStyles={false}
        />
      ),
      renderExcel: (record) => (record.isIncluded ? "포함" : "별도"),
    },
  ].filter(Boolean) as DownloadableColumnsType<IPurchaseOrderCreateLine>;

  const vendorColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.vendor.VENDOR_NAME,
      key: "vendor",
      align: "center",
      width: 200,
      render: (_, record) => {
        const vendorOptions: DefaultOptionType[] = record.variant?.productVariantVendors?.map(
          (productVariantVendor) => {
            const displayLabel = (
              <Tooltip title={productVariantVendor?.note} placement={"right"}>
                {makeVendorDisplayName(productVariantVendor.vendor)}
              </Tooltip>
            );
            return {
              label: displayLabel,
              disabled: !productVariantVendor?.isActive,
              value: productVariantVendor?.vendor?.id,
            };
          }
        );
        const onVendorChange = async (value: string) => {
          const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
            (variantVendor) => variantVendor?.vendor?.id === value
          );
          const stockCostPriceExcludeVat =
            selectedProductVariantVendor?.productPriceExcludeVat + selectedProductVariantVendor?.deliveryFeeExcludeVat;
          const consignmentCostPriceExcludeVat =
            selectedProductVariantVendor?.consignmentProductPriceExcludeVat +
            selectedProductVariantVendor?.consignmentDeliveryFeeExcludeVat;
          form.setFieldValue(
            ["linesObj", record.lineKey, "costPriceExcludeVat"],
            trackInventory ? stockCostPriceExcludeVat : consignmentCostPriceExcludeVat
          );
          if (trackInventory) {
            const quantity = selectedProductVariantVendor?.pricingBasisQty;
            form.setFieldValue(["linesObj", record.lineKey, "quantity"], quantity);
          }
        };
        return (
          <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "vendorId"]}>
            <Select style={{ width: "100%" }} options={vendorOptions} onChange={onVendorChange} />
          </Form.Item>
        );
      },
      renderExcel: (record) => {
        // record.vendorId에 맞는 displayLabel을 찾아서 return 한다.
        const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === record.vendorId
        );
        return makeVendorDisplayName(selectedProductVariantVendor?.vendor);
      },
    },
    {
      title: columnNameConstant.vendor.EXTERNAL_SKU,
      key: "externalSku",
      align: "center",
      width: 150,
      render: (_, record) => {
        const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === record.vendorId
        );
        return selectedProductVariantVendor?.externalSku || "-";
      },
    },
    {
      title: columnNameConstant.vendor.EXTERNAL_PRODUCT_NAME,
      key: "externalProductName",
      align: "center",
      width: 200,
      render: (_, record) => {
        const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === record.vendorId
        );
        const value = selectedProductVariantVendor?.externalProductName || "-";
        return value;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.PO_MOQ,
      key: "moq",
      align: "center",
      width: 110,
      render: (_, record) => {
        const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === record.vendorId
        );
        const value = selectedProductVariantVendor?.moq || "-";
        return value;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.PRICING_BASIS_QTY,
      key: "pricingBasisQty",
      align: "center",
      width: 110,
      render: (_, record) => {
        const selectedProductVariantVendor = record.variant?.productVariantVendors?.find(
          (variantVendor) => variantVendor?.vendor?.id === record.vendorId
        );
        const value = selectedProductVariantVendor?.pricingBasisQty || "-";
        return value;
      },
    },
    {
      title: "수량 별 단가",
      key: "noteForUnitPrice",
      align: "center",
      width: 90,
      render: (_, record) =>
        utils.isEmpty(record.variant.defaultVariantVendor.noteForUnitPrice) ? (
          <Typography.Text type="secondary">정보 없음</Typography.Text>
        ) : (
          <Button onClick={() => onShowNoteForUnitPrice(record.variant.defaultVariantVendor.noteForUnitPrice)}>
            상세보기
          </Button>
        ),
      renderExcel: (record) => record.variant.defaultVariantVendor.noteForUnitPrice || "-",
    },
  ];

  const productStockStatusColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.product.SALES_STATUS,
      key: "salesStatus",
      align: "center",
      width: 80,
      render: (_, record) => transformSalesStatusByProductVariant(record.variant?.salesStatus),
    },
    {
      title: columnNameConstant.stock.SAFETY_STOCK_STATUS,
      key: "isSafety",
      align: "center",
      width: 100,
      render: (_, record) => makeIsSafetyTag(record.variant),
      renderExcel: (record) => makeIsSafetyTag(record.variant, false) as string,
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_7_DAYS],
      key: "needToReorder7",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record.variant, 7),
      renderExcel: (record) => makeNeedToReorderTag(record.variant, 7, false) as string,
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_15_DAYS],
      key: "needToReorder15",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record.variant, 15),
      renderExcel: (record) => makeNeedToReorderTag(record.variant, 15, false) as string,
    },
    {
      title: [columnNameConstant.stock.ROP_STATUS, columnNameConstant.stock.LAST_30_DAYS],
      key: "needToReorder30",
      align: "center",
      width: 100,
      render: (_, record) => makeNeedToReorderTag(record.variant, 30),
      renderExcel: (record) => makeNeedToReorderTag(record.variant, 30, false) as string,
    },
    {
      title: columnNameConstant.stock.NEAR_OUT_OF_STOCK_STATUS,
      key: "isSalesSurge",
      align: "center",
      width: 100,
      render: (_, record) => makeIsSalesSurgeTag(record.variant),
      renderExcel: (record) => makeIsSalesSurgeTag(record.variant, false) as string,
    },
    isStaff && {
      title: "예상 소진일",
      key: "estimatedDepletionDate",
      align: "center",
      width: 120,
      render: (_, record) =>
        calculateEstimatedDepletionDate(
          record.variant,
          record.quantity || 0,
          record.askingPurchaseDate,
          watchedValues.purchaseOrderDate
        ),
      renderExcel: (record) =>
        calculateEstimatedDepletionDate(
          record.variant,
          record.quantity || 0,
          record.askingPurchaseDate,
          watchedValues.purchaseOrderDate
        ),
    },
    {
      title: columnNameConstant.product.ALLOW_AUTO_CONSIGNMENT,
      key: "allowAutoConsignment",
      align: "center",
      width: 80,
      render: (_, record) => makeAllowAutoConsignmentTag(record.variant),
      renderExcel: (record) => makeAllowAutoConsignmentTag(record.variant, false) as string,
    },

    {
      title: columnNameConstant.product.TO_BE_CHANGED_INFO,
      key: "toBeChanged",
      align: "center",
      width: 80,
      render: (_, record) => {
        if (record.variant.product.defaultVariant.toBeChangedInfo === null) {
          return <Button style={{ cursor: "default", backgroundColor: "gray", color: "#fff" }}>없음</Button>;
        } else {
          return (
            <Button
              onClick={() =>
                openModalWithoutNavigate(PurchaseOrderModalModeEnum.CheckToBeChangedInfo, record.variantId)
              }
              style={{ cursor: "default", backgroundColor: "red", color: "#fff" }}
            >
              확인
            </Button>
          );
        }
      },
      renderExcel: (record) => {
        if (record.variant.product.defaultVariant.toBeChangedInfo === null) {
          return "-";
        } else {
          return record.variant.product.defaultVariant.toBeChangedInfo.detail;
        }
      },
    },

    {
      title: columnNameConstant.stock.PREPARING_PRODUCT,
      key: "existNeedToStockPurchaseOrderLines",
      align: "center",
      width: 80,
      render: (_, record) => makeExistNeedToStockPoLinesTag(record.variant?.needToStockPurchaseOrderLines),
      renderExcel: (record) =>
        makeExistNeedToStockPoLinesTag(record.variant?.needToStockPurchaseOrderLines, false) as string,
    },
    {
      title: columnNameConstant.stock.SAFETY_STOCK_QTY,
      key: "safetyStockQty",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.variant?.safetyStockQty} />,
      renderExcel: (record) => record.variant?.safetyStockQty,
    },
    {
      title: [columnNameConstant.stock.ROP, columnNameConstant.stock.LAST_7_DAYS],
      key: "rop7",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.variant?.rop7} />,
      renderExcel: (record) => record.variant?.rop7,
    },
    {
      title: [columnNameConstant.stock.ROP, columnNameConstant.stock.LAST_15_DAYS],
      key: "rop15",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.variant?.rop15} />,
      renderExcel: (record) => record.variant?.rop15,
    },
    {
      title: [columnNameConstant.stock.ROP, columnNameConstant.stock.LAST_30_DAYS],
      key: "rop30",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.variant?.rop30} />,
      renderExcel: (record) => record.variant?.rop30,
    },
    isStaff && {
      title: ["최근 30일", "일 평균 판매량"],
      key: "last30DaysAvgSalesDailyQty",
      align: "right",
      width: 120,
      render: (_, record) => {
        const value = record.variant.last30DaysAvgSalesDailyQty;
        return value != null ? value.toFixed(2) : "-";
      },
      renderExcel: (record) => record.variant.last30DaysAvgSalesDailyQty || 0,
    },
    {
      title: ["최근 3개월", "월 평균 판매량"],
      key: "last3MonthAvgSaleAvgQty",
      align: "right",
      width: 120,
      render: (_, record) => getStockSalesValue(record.variant, "last3MonthsAvgSalesMonthlyQty"),
      renderExcel: (record) => getStockSalesValue(record.variant, "last3MonthsAvgSalesMonthlyQty", true),
    },
    {
      title: ["최근 2개월", "월 평균 판매량"],
      key: "last2MonthAvgSaleAvgQty",
      align: "right",
      width: 120,
      render: (_, record) => getStockSalesValue(record.variant, "last2MonthsAvgSalesMonthlyQty"),
      renderExcel: (record) => getStockSalesValue(record.variant, "last2MonthsAvgSalesMonthlyQty", true),
    },
    {
      title: columnNameConstant.stock.LAST_YEAR_SAME_MONTH,
      key: "lastYearSameMonthSalesQty",
      align: "right",
      width: 100,
      render: (_, record) => getStockLastYearSameMonthSalesQty(record.variant),
      renderExcel: (record) => getStockLastYearSameMonthSalesQty(record.variant, true),
    },
    {
      title: columnNameConstant.stock.THIS_MONTH_TIL_YESTERDAY,
      key: "thisMonthSaleQuantity",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record.variant?.thisMonthSalesQuantity} />,
      renderExcel: (record) => record.variant?.thisMonthSalesQuantity || 0,
    },
  ].filter(Boolean) as DownloadableColumnsType<IPurchaseOrderCreateLine>;

  const needToStockColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: ["가장 빠른", "입고예정일"],
      key: "closestNeedToStockDate",
      align: "center",
      width: 120,
      render: (_, record) => {
        const closestNeedToStockPoLine = getClosestNeedToStockPurchaseOrderLine(record.variant);
        if (utils.isEmpty(closestNeedToStockPoLine)) {
          return "-";
        }
        return moment(closestNeedToStockPoLine.expectedPurchaseDate).format(onlyDateFormat);
      },
    },
    {
      title: ["가장 빠른", "예정 수량"],
      key: "closestNeedToStockQty",
      align: "center",
      width: 120,
      render: (_, record) => {
        const closestNeedToStockPoLine = getClosestNeedToStockPurchaseOrderLine(record.variant);
        const poEventType = closestNeedToStockPoLine?.purchaseOrder.eventType;
        return <NumberComponent value={getPoLineExpectedPurchaseQty(poEventType, closestNeedToStockPoLine)} />;
      },
      renderExcel: (record) => {
        const closestNeedToStockPoLine = getClosestNeedToStockPurchaseOrderLine(record.variant);
        const poEventType = closestNeedToStockPoLine?.purchaseOrder.eventType;
        return getPoLineExpectedPurchaseQty(poEventType, closestNeedToStockPoLine) ?? 0;
      },
    },
    {
      title: "전체 수량",
      key: "sumOfNeedToStockQty",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.variant.qtyToBeStockedLongTerm} />,
      renderExcel: (record) => record.variant.qtyToBeStockedLongTerm,
    },
  ];

  const lastPurchaseDateColumn: DownloadableColumnType<IPurchaseOrderCreateLine> = {
    title: columnNameConstant.stock.LAST_PURCHASE_DATE,
    key: "lastStockedPoLinePurchaseDate",
    align: "center",
    width: 120,
    render: (_, record) => {
      if (utils.isEmpty(record.variant?.lastStockedPoLine?.purchaseDate)) {
        return "-";
      }
      return moment(record.variant.lastStockedPoLine.purchaseDate).format(onlyDateFormat);
    },
    renderExcel: (record) => {
      if (utils.isEmpty(record.variant?.lastStockedPoLine?.purchaseDate)) {
        return "-";
      }
      return moment(record.variant.lastStockedPoLine.purchaseDate).format(onlyDateFormat);
    },
  };

  const lastPurchaseQtyColumn: DownloadableColumnType<IPurchaseOrderCreateLine> = {
    title: columnNameConstant.stock.LAST_PURCHASE_QTY,
    key: "lastStockedPoLinePurchaseQuantity",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={record.variant?.lastStockedPoLine?.purchaseQuantity} />,
    renderExcel: (record) => record.variant?.lastStockedPoLine?.purchaseQuantity || 0,
  };

  const availableQtyColumn: DownloadableColumnType<IPurchaseOrderCreateLine> = {
    title: "현 재고(가용재고)",
    key: "availableQtyConsiderVirtualAlloc",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={getAvailableQtyConsiderVirtualAlloc(record.variant)} />,
    renderExcel: (record) => getAvailableQtyConsiderVirtualAlloc(record.variant) || 0,
  };

  let purchaseOrderColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    !trackInventory &&
      !isB2b && {
        title: "상품가",
        key: "consignmentProductPriceExcludeVat",
        align: "right",
        width: 120,
        render: (_, record) => <NumberComponent value={record.consignmentProductPriceExcludeVat} />,
        renderExcel: (record) => record.consignmentProductPriceExcludeVat,
      },
    !trackInventory &&
      !isB2b && {
        title: "배송비",
        key: "consignmentDeliveryFeeExcludeVat",
        align: "right",
        width: 120,
        render: (_, record) => <NumberComponent value={record.consignmentDeliveryFeeExcludeVat} />,
        renderExcel: (record) => record.consignmentDeliveryFeeExcludeVat,
      },
    !trackInventory &&
      !isB2b && {
        title: columnNameConstant.order.DELIVERY_ADDITIONAL_FEE,
        key: "consignmentUnitDeliveryAdditionalFeeExcludeVat",
        align: "right",
        width: 120,
        render: (_, record) => <NumberComponent value={record.consignmentUnitDeliveryAdditionalFeeExcludeVat} />,
        renderExcel: (record) => record.consignmentUnitDeliveryAdditionalFeeExcludeVat,
      },
    {
      title: isB2bTackBack ? "반품 수량" : columnNameConstant.purchaseOrder.PO_AMOUNT,
      key: "quantity",
      align: "center",
      width: 130,
      render: (_, record) => {
        if (trackInventory || isB2b) {
          const precision = record.variant.orderQtyDecimalPlaces;
          return (
            <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "quantity"]}>
              <InputNumber {...getInputNumberProps({ isCommaDisplay: true, precision })} disabled={disabled} min={1} />
            </Form.Item>
          );
        }
        return <NumberComponent value={record.quantity} />;
      },
      renderExcel: (record) => record.quantity,
    },
    {
      title: columnNameConstant.product.PURCHASE_UNIT,
      key: "salesUnitType",
      align: "center",
      width: 90,
      render: (_, record) => getSalesUnitTypeText(record.variant.salesUnitType),
      renderExcel: (record) => getSalesUnitTypeText(record.variant.salesUnitType),
    },
    {
      title: "매입가",
      key: "costPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        if (isB2b) {
          const precision = record.variant.priceDecimalPlaces;
          return (
            <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "costPriceExcludeVat"]}>
              <InputNumber {...getInputNumberProps({ isCommaDisplay: true, precision })} disabled={disabled} />
            </Form.Item>
          );
        }
        return <NumberComponent value={record.costPriceExcludeVat} />;
      },
      renderExcel: (record) => record.costPriceExcludeVat,
    },
    {
      title: columnNameConstant.purchaseOrder.COST_TOTAL_PRICE,
      key: "totalCostPriceExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        const value = calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.variant.product.isTaxFree,
          record.variant.priceDecimalPlaces
        );
        return <NumberComponent value={value} />;
      },
      renderExcel: (record) =>
        calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.variant.product.isTaxFree,
          record.variant.priceDecimalPlaces
        ),
    },
    isB2b &&
      isB2bTackBack === false && {
        title: columnNameConstant.orderLine.B2B_DELIVERY_FEE_PURCHASE,
        key: "b2bDeliveryFeeExcludeVat",
        align: "right",
        width: 120,
        render: (_, record) => (
          <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "b2bDeliveryFeeExcludeVat"]}>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              disabled={disabled || record.variant.defaultVariantVendor.includePurchaseB2bDeliveryFee}
              readOnly={isB2bTackBack}
              bordered={!isB2bTackBack}
            />
          </Form.Item>
        ),
        renderExcel: (record) => record.variant.defaultVariantVendor.purchaseB2bDeliveryFeeExcludeVat,
      },
    {
      title: "기타비용",
      key: "etcExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => (
        <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "etcExcludeVat"]}>
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            disabled={disabled || record.variant.isDeferred}
          />
        </Form.Item>
      ),
      renderExcel: (record) => record.etcExcludeVat,
    },
    {
      title: isB2bTackBack
        ? columnNameConstant.purchaseOrder.REFUNDED_PRODUCT_TOTAL_AMOUNT
        : columnNameConstant.purchaseOrder.PO_TOTAL_AMOUNT,
      key: "totalExcludeVat",
      align: "right",
      width: 120,
      render: (_, record) => {
        const totalExcludeVatByUnitExcludeVatAndQtyValue = calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.variant.product.isTaxFree,
          record.variant.priceDecimalPlaces
        );
        let value = totalExcludeVatByUnitExcludeVatAndQtyValue + record.etcExcludeVat;

        if (isB2b) {
          value += record.b2bDeliveryFeeExcludeVat;
        }
        return <NumberComponent value={value} />;
      },
      renderExcel: (record) =>
        calcTotalExcludeVatByUnitExcludeVatAndQty(
          record.costPriceExcludeVat,
          record.quantity,
          record.variant.product.isTaxFree,
          record.variant.priceDecimalPlaces
        ) + record.etcExcludeVat,
    },
  ];
  purchaseOrderColumns = purchaseOrderColumns.filter(Boolean);

  const addressColumns: DownloadableColumnsType<IPurchaseOrderCreateLine> = [
    {
      title: columnNameConstant.purchase.RECIPIENT,
      key: "firstName",
      align: "center",
      width: 150,
      render: (_, record) => record.orderLine?.order?.shippingAddress?.firstName || "-",
      renderExcel: (record) => record.orderLine?.order?.shippingAddress?.firstName || "-",
    },
    {
      title: columnNameConstant.common.PHONE,
      key: "phone",
      align: "center",
      width: 150,
      render: (_, record) => transformPhoneNumber(record.orderLine?.order?.shippingAddress?.phone) || "-",
      renderExcel: (record) => transformPhoneNumber(record.orderLine?.order?.shippingAddress?.phone) || "-",
    },
    {
      title: columnNameConstant.common.ADDRESS,
      key: "address",
      align: "center",
      width: 300,
      render: (_, record) => transformAddress(record.orderLine?.order?.shippingAddress),
      renderExcel: (record) => transformAddress(record.orderLine?.order?.shippingAddress),
    },
  ];

  columns.push({
    title: "제품 정보",
    children: productColumns,
  });
  columns.push({
    title: "발주 정보",
    children: purchaseOrderColumns,
  });
  columns.push({
    title: "협력사 정보",
    children: vendorColumns,
  });
  if (trackInventory) {
    columns.push({
      title: "제품 현황",
      children: productStockStatusColumns,
    });
    if (isStaff) {
      columns.push(lastPurchaseDateColumn);
    }
    if (isStaff) {
      columns.push(lastPurchaseQtyColumn);
    }
    columns.push({
      title: "입고 예정",
      children: needToStockColumns,
    });
    if (isStaff) {
      columns.push(availableQtyColumn);
    }
  }
  columns.push({
    title: "비고",
    key: "note",
    align: "left",
    width: 250,
    render: (_, record) => (
      <Form.Item style={{ margin: 0 }} name={["linesObj", record.lineKey, "note"]}>
        <Input.TextArea />
      </Form.Item>
    ),
    renderExcel: (record) => record.note,
  });
  if (trackInventory === false) {
    columns.push({
      title: "납품장소",
      children: addressColumns,
    });
  }
  if (trackInventory) {
    columns.push({
      key: "action",
      align: "center",
      width: 60,
      fixed: utils.fixedRightFlag(),
      render: (_, record) => (
        <Popconfirm
          title={`${record.variant?.product.name}: 발주제품에서 해당 제품을 삭제하시겠습니까?`}
          onConfirm={() => onLineDelete(record.lineKey)}
          placement={"topRight"}
        >
          <Button size={"large"} type={"link"} disabled={disabled} icon={<DeleteFilled />} />
        </Popconfirm>
      ),
      doNotRenderExcel: true,
    });
  }

  return columns;
};

// 재고, 위탁(협력사) 발주서 등록 시 발주 품목 폼 데이터 생성 - 재고 반품, 위탁 반품은 제외
export const makePoLineRowToAdd = (
  productVariant:
    | ProductVariantListToAdd_productVariants_edges_node
    | OrderLineListForPurchaseOrder_orderLines_edges_node_variant,
  purchaseOrder: PurchaseOrderCreatePageFormData | PurchaseOrderDetails_purchaseOrder,
  defaultAskingPurchaseDate: Moment,
  consignment?: {
    orderLine: OrderLineListForPurchaseOrder_orderLines_edges_node;
    courierDeliveryAdditionalFeeList: ShopInfo_shop_courierDeliveryAdditionalFeeList[];
  }
): IPurchaseOrderCreateLine => {
  const eventType = purchaseOrder?.eventType;
  const isForPackageOrder = purchaseOrder?.isForPackageOrder;
  const { defaultVariantVendor, productVariantVendors } = productVariant;
  const findDefaultVariantVendor = productVariantVendors?.find(
    (variantVendor) => variantVendor.id === defaultVariantVendor?.id
  );

  // 재고 발주서인 경우, 제품 협력사의 재고 판매 상품가 + 재고 판매 배송비
  const calcCostPriceExcludeVatForStock = (
    variantVendor: ProductVariantListToAdd_productVariants_edges_node_productVariantVendors
  ) => {
    if (utils.isEmpty(variantVendor)) {
      return null;
    }
    return variantVendor.productPriceExcludeVat + variantVendor.deliveryFeeExcludeVat;
  };

  // 재고 발주서가 아닌 경우, 제품 협력사의 위탁 판매 상품가 + 위탁 판매 배송비(단, 직배송인 경우는 주문 내역에 저장된 별도 직배송 매입가 사용)
  const calcCostPriceExcludeVatForConsignment = (
    variantVendor: ProductVariantListToAdd_productVariants_edges_node_productVariantVendors,
    orderLine?: OrderLineListForPurchaseOrder_orderLines_edges_node
  ) => {
    if (utils.isEmpty(variantVendor)) {
      return null;
    }

    const costPriceExcludeVatForConsignment =
      variantVendor.consignmentProductPriceExcludeVat + variantVendor.consignmentDeliveryFeeExcludeVat;
    if (utils.isEmpty(orderLine)) {
      return costPriceExcludeVatForConsignment;
    }

    return costPriceExcludeVatForConsignment;
  };

  const calcConsignmentUnitDeliveryAdditionalFeeExcludeVat = (
    orderLine: OrderLineListForPurchaseOrder_orderLines_edges_node,
    courierDeliveryAdditionalFeeList: ShopInfo_shop_courierDeliveryAdditionalFeeList[]
  ) => {
    const chargeDeliveryAdditionalFee = checkChargeDeliveryAdditionalFee(
      orderLine?.order.shippingAddress.postalCode,
      courierDeliveryAdditionalFeeList
    );
    const needDeliveryAdditionalFee = orderLine?.needDeliveryAdditionalFee;
    return chargeDeliveryAdditionalFee && needDeliveryAdditionalFee
      ? findDefaultVariantVendor?.vendor.consignmentUnitDeliveryAdditionalFeeExcludeVat
      : 0;
  };

  const commonPoLineRow: Pick<
    IPurchaseOrderCreateLine,
    "lineKey" | "isSelected" | "variant" | "vendorId" | "b2bDeliveryFeeExcludeVat"
  > = {
    lineKey: makeUniquePoCreateLineKey(productVariant?.id, consignment?.orderLine?.id),
    isSelected: true,
    variant: productVariant,
    vendorId: findDefaultVariantVendor?.vendor?.id,
    b2bDeliveryFeeExcludeVat: findDefaultVariantVendor?.purchaseB2bDeliveryFeeExcludeVat || 0,
  };
  const commonPurchaseOrderLineAddInput: Pick<
    PurchaseOrderLineAddInput,
    "variantId" | "askingPurchaseDate" | "etcExcludeVat" | "note"
  > = {
    variantId: productVariant?.id,
    askingPurchaseDate: defaultAskingPurchaseDate,
    etcExcludeVat: 0,
    note: productVariant.poNote,
  };

  const { isTrackInventoryPurchaseOrder, isTakeBackPurchaseOrder } = getCheckPurchaseOrderEventTypeResults(eventType);
  const isTrackInventory = isTrackInventoryPurchaseOrder || isTakeBackPurchaseOrder;
  if (isTrackInventory) {
    // 재고 발주서
    const quantity = findDefaultVariantVendor?.pricingBasisQty;
    const costPriceExcludeVatForTrackInventory = calcCostPriceExcludeVatForStock(findDefaultVariantVendor);
    const costPriceExcludeVatForConsignment = calcCostPriceExcludeVatForConsignment(findDefaultVariantVendor);
    // 패키지 구성품의 경우 재고 라고 할지라도 위탁 가격을 사용함.
    const costPriceExcludeVat = isForPackageOrder
      ? costPriceExcludeVatForConsignment
      : costPriceExcludeVatForTrackInventory;
    const purchaseOrderLineAddInput: PurchaseOrderLineAddInput = {
      ...commonPurchaseOrderLineAddInput,
      quantity,
      costPriceExcludeVat,
    };
    return { ...commonPoLineRow, ...purchaseOrderLineAddInput };
  } else {
    // 위탁(협력사) 발주서
    const { orderLine, courierDeliveryAdditionalFeeList } = consignment;
    const quantityUnfulfilled =
      orderLine?.orderedOrFulfillQty - orderLine?.quantityFulfilled - orderLine?.quantityRefunded;
    const costPriceExcludeVatForConsignment = calcCostPriceExcludeVatForConsignment(
      findDefaultVariantVendor,
      orderLine
    );
    const consignmentUnitDeliveryAdditionalFeeExcludeVat = calcConsignmentUnitDeliveryAdditionalFeeExcludeVat(
      orderLine,
      courierDeliveryAdditionalFeeList
    );
    const costPriceExcludeVat = costPriceExcludeVatForConsignment + consignmentUnitDeliveryAdditionalFeeExcludeVat;
    const purchaseOrderLineAddInput: PurchaseOrderLineAddInput = {
      ...commonPurchaseOrderLineAddInput,
      orderLineId: orderLine?.id,
      quantity: quantityUnfulfilled,
      costPriceExcludeVat,
    };
    return {
      ...commonPoLineRow,
      ...purchaseOrderLineAddInput,
      orderLine,
      consignmentProductPriceExcludeVat: findDefaultVariantVendor?.consignmentProductPriceExcludeVat,
      consignmentDeliveryFeeExcludeVat: findDefaultVariantVendor?.consignmentDeliveryFeeExcludeVat,
      consignmentUnitDeliveryAdditionalFeeExcludeVat,
    };
  }
};

export const showProductVariantVendorsErrorMsg = (failedProductVariantList: string[]) => {
  const failedProductVariantListText = failedProductVariantList.join(", ");
  showNotificationError(
    <MultiLineTypography
      lines={[
        "아래 제품은 협력사 정보가 지정되어 있지 않기 때문에 발주제품 추가에 실패했습니다.",
        failedProductVariantListText,
      ]}
    />
  );
};

export const makeStockPoLinesObj = (
  productVariantsData: ProductVariantListToAdd,
  data: PurchaseOrderCreatePageFormData
): TPurchaseOrderCreateLinesObj => {
  const selectedProductVariantList: TPurchaseOrderCreateLinesObj = {};
  const failedProductVariantList = [];
  productVariantsData.productVariants.edges.forEach((edge) => {
    const productVariant = edge?.node;
    if (productVariant?.productVariantVendors?.length === 0) {
      const productVariantNameWithSku = `${productVariant?.product?.name}(${productVariant?.sku})`;
      failedProductVariantList.push(productVariantNameWithSku);
    } else {
      const defaultDeliveryDate = data?.defaultAskingPurchaseDate || data?.purchaseOrderDate || moment();
      const line = makePoLineRowToAdd(productVariant, data, defaultDeliveryDate);
      selectedProductVariantList[line.lineKey] = line;
    }
  });
  if (failedProductVariantList.length > 0) {
    showProductVariantVendorsErrorMsg(failedProductVariantList);
  }
  return selectedProductVariantList;
};

export const makeConsignmentPoLinesObj = (
  orderLinesData: OrderLineListForPurchaseOrder,
  data: PurchaseOrderCreatePageFormData,
  courierDeliveryAdditionalFeeList: ShopInfo_shop_courierDeliveryAdditionalFeeList[],
  isB2b: boolean
): TPurchaseOrderCreateLinesObj => {
  const selectedProductVariantList: TPurchaseOrderCreateLinesObj = {};
  const failedProductVariantList = [];
  orderLinesData.orderLines.edges.forEach((edge) => {
    const orderLine = edge?.node;
    const productVariant = orderLine?.variant;
    if (productVariant?.productVariantVendors?.length === 0) {
      const productVariantNameWithSku = `${productVariant?.product?.name}(${productVariant?.sku})`;
      failedProductVariantList.push(productVariantNameWithSku);
    } else {
      const defaultDeliveryDate = isB2b
        ? orderLine?.order?.estimatedArrivalDate
          ? moment(orderLine?.order?.estimatedArrivalDate)
          : moment().add(orderLine?.variant?.poLeadTime, "days")
        : orderLine?.order?.estimatedArrivalDate
        ? moment(orderLine?.order?.estimatedArrivalDate)
        : moment();
      const line = makePoLineRowToAdd(productVariant, data, defaultDeliveryDate, {
        orderLine,
        courierDeliveryAdditionalFeeList,
      });
      selectedProductVariantList[line.lineKey] = line;
    }
  });
  if (failedProductVariantList.length > 0) {
    showProductVariantVendorsErrorMsg(failedProductVariantList);
  }
  return selectedProductVariantList;
};
