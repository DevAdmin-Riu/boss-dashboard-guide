      const qtyPerBox = detail.qtyPerBox;
      const boxLength = detail.boxLength;
      const boxWidth = detail.boxWidth;
      const boxHeight = detail.boxHeight;

      if (!utils.isEmpty(qtyPerBox) && qtyPerBox <= 0) {
        qtyPerBoxErrors.push(sku);
