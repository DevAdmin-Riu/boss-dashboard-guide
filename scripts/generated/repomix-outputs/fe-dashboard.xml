import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createMonthField, createOptionsField } from "@utils/filters/fields";
import moment from "moment";
import { Moment } from "moment";

export enum HqMileageSettlementFilterKeys {
  statDate = "statDate",
  settlementStatus = "settlementStatus",
}

export enum HqMonthlySettlementTypeEnum {
  ALL = "ALL",
  NOT_CONFIRMED = "NOT_CONFIRMED",
  CONFIRMED = "CONFIRMED",
  REVIEWING_BY_ADMIN = "REVIEWING_BY_ADMIN",
  PAID = "PAID",
}

export interface HqMileageSettlementListFilterOpts {
  statDate: FilterOpts<MinMax>;
  settlementStatus: FilterOpts<HqMonthlySettlementTypeEnum>;
}

export function createFilterStructure(opts: HqMileageSettlementListFilterOpts): IFilter<HqMileageSettlementFilterKeys> {
  let displayOrder = 0;
  // statDate - 2024년 1월 1일 이전은 선택 불가
  const disabledStatDate = (current: Moment) => current && current < moment("2024-01-01");

  return [
    {
      ...createMonthField(
        displayOrder++,
        HqMileageSettlementFilterKeys.statDate,
        filterNameConstant.STAT_DATE,
        opts.statDate.value,
        disabledStatDate
      ),
      active: opts.statDate.active,
      isRequired: true,
    },
    {
      // "확정"
      // "지급검토"
      // "지급대기"
      // "지급완료"
      ...createOptionsField(
        displayOrder++,
        HqMileageSettlementFilterKeys.settlementStatus,
        "상태",
        [opts.settlementStatus.value],
        false,
        [
          {
            label: "전체",
            value: HqMonthlySettlementTypeEnum.ALL,
          },
          {
            label: "미확정",
            value: HqMonthlySettlementTypeEnum.NOT_CONFIRMED,
          },
          {
            label: "확정",
            value: HqMonthlySettlementTypeEnum.CONFIRMED,
          },
          {
            label: "신청완료",
            value: HqMonthlySettlementTypeEnum.REVIEWING_BY_ADMIN,
          },
          {
            label: "지급완료",
            value: HqMonthlySettlementTypeEnum.PAID,
          },
        ]
      ),
      active: opts.settlementStatus.active,
    },
  ];
}
