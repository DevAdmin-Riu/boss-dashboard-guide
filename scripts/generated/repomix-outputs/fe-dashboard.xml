import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum FulfilledByVendorSettlementFilterKeys {
  statDate = "statDate",
  hasApplied = "hasApplied",
  settlementStatus = "settlementStatus",
  brandSearch = "brandSearch",
  mdSearch = "mdSearch",
}

export interface FulfilledByVendorSettlementListFilterOpts {
  statDate: FilterOpts<MinMax>;
  hasApplied: FilterOpts<boolean>;
  settlementStatus: FilterOpts<BrandMonthlySettlementStatusEnum[]>;
  brandSearch: FilterOpts<string>;
  mdSearch: FilterOpts<string>;
}

export const settlementStatusChoices = [
  { label: "미확정", value: BrandMonthlySettlementStatusEnum.CONFIRMED },
  { label: "지급검토", value: BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN },
  { label: "지급대기", value: BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT },
  { label: "지급완료", value: BrandMonthlySettlementStatusEnum.PAID },
];

export function createFilterStructure(
  opts: FulfilledByVendorSettlementListFilterOpts,
  isAllStatus: boolean = false,
  isReviewingByAdmin: boolean = false
): IFilter<FulfilledByVendorSettlementFilterKeys> {
  let displayOrder = 0;
  const filters: IFilter<FulfilledByVendorSettlementFilterKeys> = [
    {
      ...createMonthField(
        displayOrder++,
        FulfilledByVendorSettlementFilterKeys.statDate,
        filterNameConstant.STAT_DATE,
        opts.statDate.value
      ),
      active: opts.statDate.active,
      isRequired: true,
    },
  ];

  // 지급검토 탭에서만 hasApplied 필터 추가
  if (isReviewingByAdmin) {
    filters.push({
      ...createBooleanField(
        displayOrder++,
        FulfilledByVendorSettlementFilterKeys.hasApplied,
        "가맹본부 지급 신청",
        opts.hasApplied.value,
        { positive: "신청", negative: "미신청" }
      ),
      active: opts.hasApplied.active,
      isRequired: true,
    });
  }

  // 전체보기 탭에서만 settlementStatus 필터 추가
  if (isAllStatus) {
    filters.push({
      ...createOptionsField(
        displayOrder++,
        FulfilledByVendorSettlementFilterKeys.settlementStatus,
        "정산 상태",
        opts.settlementStatus.value,
        true,
        settlementStatusChoices
      ),
      active: opts.settlementStatus.active,
    });
  }

  filters.push(
    {
      ...createTextField(
        displayOrder++,
        FulfilledByVendorSettlementFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        FulfilledByVendorSettlementFilterKeys.mdSearch,
        "담당 MD",
        opts.mdSearch.value
      ),
      active: opts.mdSearch.active,
    }
  );

  return filters;
}
</file>

