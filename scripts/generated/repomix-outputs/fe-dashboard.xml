import { RefundQuestionFilterInput, RefundQuestionTypeEnum, RefundStatusTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  RefundQuestionListFilterKeys,
  RefundQuestionListFilterOpts,
} from "../../components/RefundQuestionListPage/filters";
import {
  decodeRefundQAIdToNumber,
  encodeRefundQANumberToId,
} from "../../components/RefundQuestionListTable/columnHelper";
import {
  RefundQuestionListViewUrlFilters,
  RefundQuestionListViewUrlFiltersEnum,
  RefundQuestionListViewUrlFilterWithMultipleValuesEnum,
  RefundQuestionListViewUrlQueryParams,
} from "../../urls";

export const REFUND_QUESTION_FILTERS_KEY = "refundQuestionFilters";

export function getFilterOpts(params: RefundQuestionListViewUrlFilters): RefundQuestionListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    id: {
      active: maybe(() => !utils.isEmpty(filterVariables.id, true), false),
      // 필터 input으로 전달되는 id는 실제 문자열 형태의 id 값. 필터에 보여지는 값는 디코딩 된 번호 형태의 값을 보여줘야 하므로 디코딩 된 값으로 전달
      value: maybe(() => decodeRefundQAIdToNumber(filterVariables.id), ""),
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.lte, filterVariables.created.gte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    questionType: {
      active: maybe(() => !utils.isEmpty(filterVariables.questionType), false),
      value: maybe(() => dedupeFilter(filterVariables.questionType), [RefundQuestionTypeEnum.CANCEL]),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => dedupeFilter(filterVariables.status), [RefundStatusTypeEnum.REQUESTED]),
    },
    answerCreated: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.answerCreated.gte, filterVariables.answerCreated.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.answerCreated.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.answerCreated.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    refundStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.refundStatus), false),
      value: maybe(() => filterVariables.refundStatus, false),
    },
    isRefused: {
      active: maybe(() => !utils.isEmpty(filterVariables.isRefused), false),
      value: maybe(() => filterVariables.isRefused, false),
    },
    refundStatusCreatedAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.refundStatusCreatedAt.gte, filterVariables.refundStatusCreatedAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.refundStatusCreatedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.refundStatusCreatedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch, true), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
  };
}

export function getFilterVariables(params: RefundQuestionListViewUrlFilters): RefundQuestionFilterInput {
  return {
    // 실제로 params로 전달되는 id는 디코딩 된 번호 형태의 값이므로 필터 input 전달 시엔 인코딩된 값으로 전달
    id: params.id !== undefined ? encodeRefundQANumberToId(params.id) : null,
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    questionType: maybe(() => params.questionType.map((status) => findInEnum(status, RefundQuestionTypeEnum))),
    status: maybe(() => params.status.map((status) => findInEnum(status, RefundStatusTypeEnum))),
    answerCreated: getGteLteVariables({
      gte: params.answerCreatedFrom,
      lte: params.answerCreatedTo,
    }),
    refundStatus: params.refundStatus !== undefined ? parseBoolean(params.refundStatus, true) : undefined,
    isRefused: params.isRefused !== undefined ? parseBoolean(params.isRefused, true) : undefined,
    refundStatusCreatedAt: getGteLteVariables({
      gte: params.refundStatusCreatedAtFrom,
      lte: params.refundStatusCreatedAtTo,
    }),
    orderSearch: params.orderSearch !== undefined ? params.orderSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<RefundQuestionListFilterKeys>
): RefundQuestionListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case RefundQuestionListFilterKeys.id:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.id);
    case RefundQuestionListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        RefundQuestionListViewUrlFiltersEnum.createdFrom,
        RefundQuestionListViewUrlFiltersEnum.createdTo
      );
    case RefundQuestionListFilterKeys.questionType:
      return getMultipleEnumValueQueryParam(
        filter,
        RefundQuestionListViewUrlFilterWithMultipleValuesEnum.questionType,
        RefundQuestionTypeEnum
      );
    case RefundQuestionListFilterKeys.status:
      return getMultipleEnumValueQueryParam(
        filter,
        RefundQuestionListViewUrlFilterWithMultipleValuesEnum.status,
        RefundStatusTypeEnum
      );
    case RefundQuestionListFilterKeys.answerCreated:
      return getMinMaxQueryParam(
        filter,
        RefundQuestionListViewUrlFiltersEnum.answerCreatedFrom,
        RefundQuestionListViewUrlFiltersEnum.answerCreatedTo
      );
    case RefundQuestionListFilterKeys.refundStatus:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.refundStatus);
    case RefundQuestionListFilterKeys.isRefused:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.isRefused);
    case RefundQuestionListFilterKeys.refundStatusCreatedAt:
      return getMinMaxQueryParam(
        filter,
        RefundQuestionListViewUrlFiltersEnum.refundStatusCreatedAtFrom,
        RefundQuestionListViewUrlFiltersEnum.refundStatusCreatedAtTo
      );
    case RefundQuestionListFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.orderSearch);
    case RefundQuestionListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.userSearch);
    case RefundQuestionListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, RefundQuestionListViewUrlFiltersEnum.brandSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<RefundQuestionListViewUrlFilters>(REFUND_QUESTION_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  RefundQuestionListViewUrlQueryParams,
  RefundQuestionListViewUrlFilters
>({ ...RefundQuestionListViewUrlFiltersEnum, ...RefundQuestionListViewUrlFilterWithMultipleValuesEnum });
