<file path="src/app/views/hqStaff/hqB2b/utils.ts">
import { SalesB2bStatusEnum } from "@src/api/types/globalTypes";

import { B2bSettlementForSalesViewUrlQueryParams } from "../../b2b/urls";
import { HqB2bSettlementListViewRouteParams } from "./urls";

export const getDefaultSalesB2bStatusListForHqB2bSettlementList = (
  routeParams: HqB2bSettlementListViewRouteParams
): SalesB2bStatusEnum[] => {
  const { status } = routeParams;

  let b2bStatus: SalesB2bStatusEnum[];
  switch (status) {
    case "stand-by":
      // 미정산
      b2bStatus = [SalesB2bStatusEnum.STANDBY, SalesB2bStatusEnum.REQ_REVISION, SalesB2bStatusEnum.REVISION];
      break;
    case "pending":
      // 정산 대상
      b2bStatus = [SalesB2bStatusEnum.PENDING];
      break;
    case "completed":
      // 정산 완료
      b2bStatus = [SalesB2bStatusEnum.CLOSED];
      break;
    case "all":
      // 전체 정산 내역
      return Object.values(SalesB2bStatusEnum);
  }

  return b2bStatus;
};

export const getHqB2bSettlementListDefaultParams = (
  routeParams: HqB2bSettlementListViewRouteParams
): B2bSettlementForSalesViewUrlQueryParams => ({
  b2bStatus: getDefaultSalesB2bStatusListForHqB2bSettlementList(routeParams),
});
</file>

<file path="src/app/views/hqStaff/hqBrandStore/components/HqBrandStoreMapListPage/filters.ts">
import { BrandStoreStatusEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { brandStoreStatusChoices } from "@src/app/views/brand/brandStore/utils";
import { FilterOpts } from "@src/global/core/types/types";
import { createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum HqBrandStoreMapListFilterKeys {
  brandStoreSearch = "brandStoreSearch",
  regionInfo = "regionInfo",
  status = "status",
}

export interface HqBrandStoreMapListFilterOpts {
  brandStoreSearch: FilterOpts<string>;
  regionInfo: FilterOpts<string[]>;
  status: FilterOpts<BrandStoreStatusEnum[]>;
}

export function createFilterStructure(
  opts: HqBrandStoreMapListFilterOpts,
  shop: ShopInfo_shop
): IFilter<HqBrandStoreMapListFilterKeys> {
  let filterStructure = [];

  const regionInfos = shop?.regionsInfo || [];
  const regionInfosOptions = regionInfos.map((region) => ({
    label: region.name,
    value: region.id,
  }));

  const brandStoreSearchFilter = {
    ...createTextField(
      0,
      HqBrandStoreMapListFilterKeys.brandStoreSearch,
      "매장코드 / 매장명",
      opts.brandStoreSearch.value
    ),
    active: opts.brandStoreSearch.active,
  };
  const regionInfoFilter = {
    ...createOptionsField(
      0,
      HqBrandStoreMapListFilterKeys.regionInfo,
      "지역",
      opts.regionInfo.value,
      true,
      regionInfosOptions
    ),
    active: opts.regionInfo.active,
  };
  const statusFilter = {
    ...createOptionsField(
      0,
      HqBrandStoreMapListFilterKeys.status,
      "상태",
      opts.status.value,
      false,
      brandStoreStatusChoices
    ),
    active: opts.status.active,
  };

  filterStructure = [brandStoreSearchFilter, regionInfoFilter, statusFilter].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
