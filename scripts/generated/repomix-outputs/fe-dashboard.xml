<file path="src/app/views/b2b/components/B2bSalesStatListPage/B2bSalesStatSummaryTable.tsx">
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { B2bSalesStats_b2bSalesStats } from "@src/app/views/b2b/api/types/B2bSalesStats";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { Col, Form, FormInstance, InputNumber, Row, Table } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { calculateDueMonth } from "./utils";

interface SummaryData {
  supplyValue: any;
  vatAmount: number;
  totalAmount: any;
  paymentDueDate: moment.Moment;
  unpaidAmount?: number;
}

interface B2bSalesStatSummaryTableProps {
  summaryData: SummaryData | null;
  salesCloseDateFormatted: string;
  salesCloseDate: string | null;
  salesStatsRecord: B2bSalesStats_b2bSalesStats | null;
  isInsideForm?: boolean;
  form?: FormInstance;
}

const B2bSalesStatSummaryTable: React.FC<B2bSalesStatSummaryTableProps> = ({
  summaryData,
  salesCloseDateFormatted,
  salesCloseDate,
  salesStatsRecord,
  isInsideForm = false,
  form,
}) => {
  const unpaidAmountWatched = isInsideForm && form ? Form.useWatch("unpaidAmount", form) : 0;
  const columns: ColumnsType<SummaryData> = [
    {
      title: columnNameConstant.sales.CLOSING_TARGET_MONTH,
      key: "salesCloseDate",
      align: "center",
      width: 120,
      render: () => salesCloseDateFormatted,
    },
    {
      title: columnNameConstant.tax.SUPPLY_AMOUNT,
      key: "supplyValue",
      align: "right",
      width: 150,
      render: (_, record) => getNumberFormat(record?.supplyValue || 0),
    },
    {
      title: columnNameConstant.tax.VAT_AMOUNT,
      key: "vatAmount",
      align: "right",
      width: 150,
      render: (_, record) => getNumberFormat(record?.vatAmount || 0),
    },
    {
      title: columnNameConstant.tax.TOTAL_AMOUNT,
      key: "totalAmount",
      align: "right",
      width: 150,
      render: (_, record) => getNumberFormat(record?.totalAmount || 0),
    },
    {
      title: columnNameConstant.sales.UNPAID_AMOUNT,
      key: "unpaidAmount",
      align: "right",
      width: 180,
      render: (_, record) => {
        if (isInsideForm) {
          return (
            <Form.Item
              name="unpaidAmount"
              style={{ margin: 0 }}
              rules={[{ required: true, message: "미수금을 입력해주세요" }]}
            >
              <InputNumber
                {...getInputNumberProps({ isCommaDisplay: true })}
                style={{ width: "100%" }}
                min={0}
                formatter={(value) => `${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ",")}
                parser={(value) => value!.replace(/\$\s?|(,*)/g, "") as any}
              />
            </Form.Item>
          );
        }
        return getNumberFormat(record?.unpaidAmount || 0);
      },
    },
    {
      title: columnNameConstant.sales.PAYMENT_DUE_AMOUNT,
      key: "paymentDueAmount",
      align: "right",
      width: 150,
      render: (_, record) => {
        if (isInsideForm) {
          const paymentDueAmount = (record?.totalAmount || 0) + (unpaidAmountWatched || 0);
          return getNumberFormat(paymentDueAmount);
        }
        const paymentDueAmount = (record?.totalAmount || 0) + (record?.unpaidAmount || 0);
        return getNumberFormat(paymentDueAmount);
      },
    },
    {
      title: columnNameConstant.sales.PAYMENT_DUE_MONTH,
      key: "paymentDueDate",
      align: "center",
      width: 120,
      render: (_, _record) => calculateDueMonth(salesCloseDate, salesStatsRecord?.brand?.b2bPayMethod),
    },
  ];

  return (
    <Row gutter={16}>
      <Col span={24}>
        <Table
          {...commonTableProps}
          dataSource={summaryData ? [summaryData] : []}
          rowKey={() => "summary"}
          columns={columns}
        />
      </Col>
    </Row>
  );
};

export default B2bSalesStatSummaryTable;
</file>

