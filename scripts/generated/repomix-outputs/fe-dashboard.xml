  open: boolean;
  loading: boolean;
  urlType: FbvOrderDeliveryUrlEnum;
  fulfillment: FulfillmentList_fulfillments_edges_node;
  couriers: CourierList_couriers_edges_node[];
  onSubmit: (formData: FulfillmentBulkUpdateForFbvDetail) => void;
  onClose: () => void;
}
export const FbvOrderFulfillmentChangeDeliveryMethodModal: React.FC<
  FbvOrderFulfillmentChangeDeliveryMethodModalProps
> = ({ open, loading, urlType, fulfillment, couriers, onSubmit, onClose }) => {
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);
  const deliveryMethodWatched = TypeSafeForm.getUseFormWatched({ name: "deliveryMethod" });
  const courierIdWatched = TypeSafeForm.getUseFormWatched({ name: "courierId" });
  const selectedCourier = couriers?.find((item) => item.id === courierIdWatched);
  const digitAllowedValues = selectedCourier?.digitAllowedValues;

  const initialValues: TFormData = {
    deliveryMethod: fulfillment?.deliveryMethod,
    courierId: fulfillment?.courier?.id,
    trackingNumber: fulfillment?.trackingNumber,
    etcDeliveryManInfo: fulfillment?.etcDeliveryManInfo,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const isFulfilled = urlType === FbvOrderDeliveryUrlEnum.FULFILLED;
  const title = isFulfilled ? "배송정보 입력" : "배송방식 변경";

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title={title}
      open={open}
      confirmLoading={loading}
      cancelText={"뒤로"}
      okText={"확인"}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        initialValues={initialValues}
        preserve={false}
        validateTrigger={"onSubmit"}
        form={form}
        layout="vertical"
        name="control-hooks"
        onFinish={(formData) =>
          onSubmit({
            ...formData,
            orderNumber: Number(fulfillment?.order.number),
            fulfillmentOrder: Number(fulfillment?.fulfillmentOrder),
          })
        }
      >
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("deliveryMethod")}
          label="배송방식"
          rules={[{ required: true }]}
        >
          <Radio.Group>
            <Radio value={OrderDeliveryMethodsEnum.BY_COURIER}>택배 배송</Radio>
            <Radio value={OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE}>화물차 배송</Radio>
          </Radio.Group>
        </Form.Item>

        {deliveryMethodWatched === OrderDeliveryMethodsEnum.BY_COURIER && (
          <>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("courierId")}
              label="택배사"
              rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
            >
              <Select
                placeholder="택배사를 선택해주세요"
                options={couriers?.map((item) => ({ label: item.name, value: item.id }))}
              />
            </Form.Item>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("trackingNumber")}
              label="송장번호"
              dependencies={["courierId"]}
              rules={[
                { required: true, message: formRuleMsg.required },
                {
                  pattern: utils.makeLenRegex(digitAllowedValues),
                  message: `${digitAllowedValues?.join(",")} 자리로 입력해야 합니다`,
                },
              ]}
            >
              <InputNumber {...getInputNumberProps({})} placeholder={"송장번호를 입력해주세요"} />
            </Form.Item>
          </>
        )}

        {deliveryMethodWatched === OrderDeliveryMethodsEnum.BY_TRUCK_SERVICE && (
          <>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("etcDeliveryManInfo.vehicle")}
              label={columnNameConstant.delivery.DELIVERY_VEHICLE_INFO}
              rules={[{ required: true, message: formRuleMsg.required }]}
            >
              <Input placeholder={"배차차량정보를 입력해주세요."} />
            </Form.Item>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("etcDeliveryManInfo.contact")}
              label={columnNameConstant.delivery.DELIVERY_MAN_CONTACT}
              rules={[{ required: true, message: formRuleMsg.required }]}
            >
              <Input placeholder={"배송기사 연락처를 입력해주세요."} />
            </Form.Item>
          </>
        )}
      </Form>
    </Modal>
  );
};
</file>

