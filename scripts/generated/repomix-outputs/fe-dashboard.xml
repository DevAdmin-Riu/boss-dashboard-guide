}

export const makeFilteredAttributesForMutationInput = (
  formData: ProductUpdateData | ProductCreateData | ProductVariantUpdateData | ProductVariantCreateData
) =>
  // attributes 중에서 slug가 boxSize인 attribute는 제외. 아우터박스의 규격(장폭고)에 따라 백엔드에서 boxSize 자동 수정.
  formData.attributes
    .filter((attribute) => attribute.data.slug !== AttributeSlugEnum.boxSize)
    .map((attribute) => {
      const isDirectlyInputType = attribute.data.inputType === AttributeInputTypeEnum.DIRECTLY;
      const values =
        attribute.value && utils.isEmpty(attribute.value[0], true)
          ? isDirectlyInputType
            ? [""]
            : []
          : attribute.value;
      return { id: attribute.id, values };
    });

export function getAttributeInputFromProductAttributes(
  productAttributes: ProductDetails_product_attributes[]
): ProductAttributeInput[] {
  return maybe(
    (): ProductAttributeInput[] =>
      productAttributes.map((attribute) => ({
        data: {
          inputType: attribute.attribute.inputType,
          valueRequired: attribute.attribute.valueRequired,
          values: attribute.attribute.values,
          slug: attribute.attribute.slug,
        },
        id: attribute.attribute.id,
        label: attribute.attribute.name,
        // 제품 속성 쿼리 리턴 값 중 직접 입력 방식인 속성은 slug가 null로 리턴되므로, slug와 동일하게 저장 및 수정되도록 처리한 name 값을 value로 설정
        value:
          attribute.attribute.inputType === AttributeInputTypeEnum.DIRECTLY
            ? attribute.values.map((value) => value.name)
            : attribute.values.map((value) => value.slug),
      })),
    []
  );
}

export function getAttributeInputFromProductType(productType: ProductType): ProductAttributeInput[] {
  return productType?.productAttributes.map((attribute) => ({
    data: {
      inputType: attribute.inputType,
      valueRequired: attribute.valueRequired,
      values: attribute.values,
      slug: attribute.slug,
    },
    id: attribute.id,
    label: attribute.name,
    value: [],
  }));
}

export function getAttributeInputFromVariant(variant: ProductVariantFragment): ProductAttributeInput[] {
  return maybe(
    (): ProductAttributeInput[] =>
      variant.attributes.map((attribute) => ({
        data: {
          inputType: attribute.attribute.inputType,
          valueRequired: attribute.attribute.valueRequired,
          values: attribute.attribute.values,
          slug: attribute.attribute.slug,
        },
        id: attribute.attribute.id,
        label: attribute.attribute.name,
        // 제품 속성 쿼리 리턴 값 중 직접 입력 방식인 속성은 slug가 null로 리턴되므로, slug와 동일하게 저장 및 수정되도록 처리한 name 값을 value로 설정
        value: maybe(
          () =>
            attribute.attribute.inputType === AttributeInputTypeEnum.DIRECTLY
              ? attribute.values.map((value) => value.name)
              : attribute.values.map((value) => value.slug),
          null
        ),
      })),
    []
  );
}

