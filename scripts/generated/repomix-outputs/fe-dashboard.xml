  return isHtml ? <NumberComponent value={etcExcludeVat} /> : etcExcludeVat ?? "-";
};

export const makePurchaseVatAmount = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const vatAmount = multiplePurchaseTypeTackBackValue(
    purchase.type,
    utils.convertToNumber(purchase?.vatAmount, purchase.purchaseOrderLine?.variant?.priceDecimalPlaces)
  );
  return isHtml ? <NumberComponent value={vatAmount} /> : vatAmount ?? "-";
};

export const makePurchaseTakeBackTotalDeliveryFeeExcludeVat = (
  purchase: Purchases_purchases_edges_node,
  isHtml: boolean = true
) => {
  const quantity = utils.convertToNumberWrapper(
    makePurchaseQuantity(purchase, false),
    purchase.purchaseOrderLine?.variant?.orderQtyDecimalPlaces
  );
  // quantity의 절대값을 구한다.

  const totalTakeBackDeliveryFeeExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
    purchase?.takeBackUnitCostDeliveryFeeExcludeVat,
    Math.abs(quantity),
    false
  );
  return isHtml ? (
    <NumberComponent value={totalTakeBackDeliveryFeeExcludeVat} />
  ) : (
    totalTakeBackDeliveryFeeExcludeVat ?? "-"
  );
};

export const makePurchaseTotalExcludeVat = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const quantity = utils.convertToNumberWrapper(
    makePurchaseQuantity(purchase, false),
    purchase.purchaseOrderLine?.variant?.orderQtyDecimalPlaces
  );
  const isB2b = purchase.purchaseOrder?.isB2b;
  const totalTakeBackDeliveryFeeExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
    purchase?.takeBackUnitCostDeliveryFeeExcludeVat,
    Math.abs(quantity),
    false
  );

  let totalExcludeVat =
    multiplePurchaseTypeTackBackValue(purchase.type, utils.convertToNumberWrapper(purchase?.costPriceExcludeVat)) +
    utils.convertToNumberWrapper(purchase?.devCostExcludeVat) +
    utils.convertToNumberWrapper(purchase?.etcExcludeVat) +
    utils.convertToNumberWrapper(totalTakeBackDeliveryFeeExcludeVat);

  if (isB2b) {
    totalExcludeVat += utils.convertToNumberWrapper(purchase?.b2bDeliveryFeeExcludeVat);
  }
  totalExcludeVat = utils.convertToNumber(totalExcludeVat, purchase.purchaseOrderLine?.variant?.priceDecimalPlaces);
  return isHtml ? <NumberComponent value={totalExcludeVat} /> : totalExcludeVat ?? "-";
};

export const makePurchaseTotalAmount = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const quantity = utils.convertToNumberWrapper(makePurchaseQuantity(purchase, false));
  const isB2b = purchase.purchaseOrder?.isB2b;
  const totalTakeBackDeliveryFeeExcludeVat = calcTotalExcludeVatByUnitExcludeVatAndQty(
    purchase?.takeBackUnitCostDeliveryFeeExcludeVat,
    Math.abs(quantity),
    false
  );

  let totalAmount =
    multiplePurchaseTypeTackBackValue(purchase.type, utils.convertToNumberWrapper(purchase?.costPriceExcludeVat)) +
    utils.convertToNumberWrapper(purchase?.devCostExcludeVat) +
    utils.convertToNumberWrapper(purchase?.etcExcludeVat) +
    utils.convertToNumberWrapper(totalTakeBackDeliveryFeeExcludeVat) +
    multiplePurchaseTypeTackBackValue(purchase.type, utils.convertToNumberWrapper(purchase?.vatAmount));
  if (isB2b) {
    totalAmount += utils.convertToNumberWrapper(purchase?.b2bDeliveryFeeExcludeVat);
  }
  totalAmount = utils.convertToNumber(totalAmount, purchase.purchaseOrderLine?.variant?.priceDecimalPlaces);
  return isHtml ? <NumberComponent value={totalAmount} /> : totalAmount ?? "-";
};

