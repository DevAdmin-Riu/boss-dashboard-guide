import { ApolloQueryResult } from "@apollo/client";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import useVendorSearch from "@src/api/searches/useVendorSearch";
import { PurchaseType, PurchaseUpdateInput } from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { makeConfirmNodeForPurchaseTotal } from "@src/app/views/vendorStaff/vsSection/components/VsPurchaseModals/VsPurchaseBulkCloseModal";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { makeVendorDisplayName, maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, DatePicker, Divider, Form, Input, Row, Space, Table, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import moment, { Moment } from "moment";
import React, { useEffect, useState } from "react";
import { useParams } from "react-router";

import { purchaseLineCountQuery } from "../../../purchaseOrders/api/queries";
import { makePurchaseOrderLineNumber } from "../../../purchaseOrders/utils";
import {
  usePurchaseBulkPendingMutation,
  usePurchaseCancelMutation,
  usePurchaseUpdateMutation,
} from "../../api/mutations";
import { purchaseListQuery } from "../../api/queries";
import { Purchases, Purchases_purchases_edges_node, PurchasesVariables } from "../../api/types/Purchases";
import { PurchaseListViewRouteParams, PurchaseListViewUrlDialog, PurchaseListViewUrlQueryParams } from "../../urls";
import { checkPurchaseCloseAvailable, checkPurchasePendingAvailable, disabledDateForPurchaseClose } from "../../utils";
import { createFilterStructure, PurchaseFilterKeys, PurchaseListFilterOpts } from "./filters";
import { getPurchaseListTableSettings, getPurchaseTableSettingsForConfirm } from "./PurchaseListTableSettings";

const { MonthPicker } = DatePicker;

interface PurchaseListPageProps extends PaginateListProps, FilterPageProps<PurchaseFilterKeys, PurchaseListFilterOpts> {
  params: PurchaseListViewUrlQueryParams;
  purchaseList: Purchases_purchases_edges_node[];
  openModal: (action: PurchaseListViewUrlDialog, newParams?: PurchaseListViewUrlQueryParams) => void;
  closeModal: () => void;

  queryVariablesWithoutPagination: PurchasesVariables;
  fetchForDownload: (variables?: PurchasesVariables) => Promise<ApolloQueryResult<Purchases>>;
  selectedRowIds: string[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<string[]>>;
  ListNavigator: () => React.ReactNode;
  isB2b: boolean;
  isFbv: boolean;
}

export interface ExtendedPurchaseUpdateInput extends PurchaseUpdateInput {
  costPriceExcludeVat: number;
}
interface PurchaseBulkPendingInput {
  purchaseCloseDate: Moment;
  pendingReason?: string;
}

export const PurchaseListPage: React.FC<PurchaseListPageProps> = (props) => {
  const {
    params,
    currentTab,
    filterOpts,
    tabs,
    purchaseList,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    openModal,
    closeModal,
    queryVariablesWithoutPagination,
    fetchForDownload,
    selectedRowIds,
    setSelectedRowIds,
    isB2b,
    isFbv,
    ListNavigator,
    ...listProps
  } = props;
  const routeParams = useParams<PurchaseListViewRouteParams>();
  const isFulfilledByVendorList = routeParams.fulfilledBy === "vendor";
  const isFulfilledByBossList = routeParams.fulfilledBy === "boss";
  const isPendingAvailableList = routeParams.status === "standby-or-pending" || routeParams.status === "revision";
  const navigate = useNavigator();
  const filterStructure = createFilterStructure(filterOpts, routeParams, isB2b);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [form] = Form.useForm<PurchaseUpdateInput & PurchaseBulkPendingInput>();
  const [selectedRowId, setSelectedRowId] = useState<string>("");

  const purchaseCloseDateWatched = Form.useWatch("purchaseCloseDate", form);

  const { search: vendorsSearch, result: vendorsResult } = useVendorSearch({
    skip: isFulfilledByVendorList || !isPendingAvailableList,
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA, isActive: true },
  });
  const vendors = maybe(() => vendorsResult?.data?.search?.edges?.map((edge) => edge?.node), []);
  const vendorOptions: Array<{ label: string; value: string }> = vendors?.map((vendor) => {
    const displayName = makeVendorDisplayName(vendor);
    return { label: displayName, value: vendor?.id };
  });

  const resetFormField = () => {
    form.resetFields();
    setSelectedRowId(undefined);
    setSelectedRowIds([]);
  };

  useEffect(() => {
    resetFormField();
  }, [listProps.disabled]);

  const devCostExcludeVatWatched = Form.useWatch("devCostExcludeVat", form);
  const quantityWatched = Form.useWatch("quantity", form);
  const etcExcludeVatWatched = Form.useWatch("etcExcludeVat", form);
  const unitCostPriceExcludeVatWatched = Form.useWatch("unitCostPriceExcludeVat", form);
  const b2bDeliveryFeeExcludeVatWatched = Form.useWatch("b2bDeliveryFeeExcludeVat", form);
  const costPriceExcludeVatWatched = quantityWatched * unitCostPriceExcludeVatWatched;

  const formValuesWatched: ExtendedPurchaseUpdateInput = {
    devCostExcludeVat: devCostExcludeVatWatched,
    quantity: quantityWatched,
    etcExcludeVat: etcExcludeVatWatched,
    unitCostPriceExcludeVat: unitCostPriceExcludeVatWatched,
    costPriceExcludeVat: costPriceExcludeVatWatched,
    b2bDeliveryFeeExcludeVat: b2bDeliveryFeeExcludeVatWatched,
  };

  const setEditableRow = (record: Purchases_purchases_edges_node) => {
    const parameters = utils.jsonParseWrapper(record.parameters) || {};
    form.setFields([
      { name: "devCostExcludeVat", value: record.devCostExcludeVat },
      { name: "etcExcludeVat", value: record.etcExcludeVat },
      {
        name: "unitCostPriceExcludeVat",
        value: parameters?.product?.unit_cost_price_exclude_vat
          ? Math.abs(parameters?.product?.unit_cost_price_exclude_vat)
          : 0,
      },
      { name: "vendor", value: record.vendorId },
      { name: "quantity", value: parameters?.product?.quantity },
      { name: "isTaxFree", value: parameters?.product?.is_tax_free },
    ]);
    if (isB2b) {
      form.setFields([{ name: "b2bDeliveryFeeExcludeVat", value: record.b2bDeliveryFeeExcludeVat }]);
    }
    setSelectedRowId(record.id);
  };

  const isEditing = (record: Purchases_purchases_edges_node) => record.id === selectedRowId;
  const onEdit = (record: Purchases_purchases_edges_node) => setEditableRow(record);

  const onCancel = () => resetFormField();

  const onSubmit = async () => {
    const inputForm = form.getFieldsValue();
    const { devCostExcludeVat, etcExcludeVat, unitCostPriceExcludeVat, vendor, quantity, b2bDeliveryFeeExcludeVat } =
      inputForm;
    const selectedPurchase = purchaseList.find((purchase) => purchase.id === selectedRowId);
    let input: PurchaseUpdateInput = {
      unitCostPriceExcludeVat,
      quantity,
    };
    const isTakeBack = selectedPurchase.type === PurchaseType.TAKE_BACK;
    const isConsignTakeBack = selectedPurchase.type === PurchaseType.CONSIGNMENT_TAKE_BACK;
    if (!(isTakeBack || isConsignTakeBack)) {
      // input에 devCostExcludeVat, etcExcludeVat, vendor 추가
      input = { ...input, devCostExcludeVat, etcExcludeVat, vendor };
    }
    if (isB2b && isConsignTakeBack === false) {
      input = { ...input, b2bDeliveryFeeExcludeVat };
    }
    purchaseUpdate({ variables: { id: selectedRowId, input } });
  };

  const rowSelection: TableRowSelection<Purchases_purchases_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys) => {
      setSelectedRowIds(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record: Purchases_purchases_edges_node) => ({
      disabled: isPendingAvailableList
        ? checkPurchasePendingAvailable(record.status) === false
        : routeParams.status === "pending"
        ? checkPurchaseCloseAvailable(record.status) === false
        : true,
    }),
  };

  const [purchaseBulkPending, purchaseBulkPendingOpts] = usePurchaseBulkPendingMutation({
    onCompleted: (data) => {
      const errors = data.purchaseBulkPending.errors;
      if (errors.length === 0) {
        const count = data.purchaseBulkPending.count;
        const successMsg = `선택한 ${getNumberFormat(count)}건의 매입 내역이 협력사에게 검토 요청되었습니다.`;
        showNotificationSuccess(successMsg);
        resetFormField();
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [purchaseListQuery, purchaseLineCountQuery],
  });

  const [purchaseCancel, purchaseCancelOpts] = usePurchaseCancelMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.purchaseCancel.errors;
        if (errors.length === 0) {
          showNotificationSuccess("매입 취소처리되었습니다.");
          resetFormField();
          closeModal();
        } else {
          showGqlErrors(errors);
        }
      }
    },
    refetchQueries: [purchaseListQuery, purchaseLineCountQuery],
  });

  const [purchaseUpdate, purchaseUpdateOpts] = usePurchaseUpdateMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.purchaseUpdate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("매입 수정처리되었습니다.");
          resetFormField();
        } else {
          showGqlErrors(errors);
        }
      }
    },
  });

  let pageTitle: string | null = null;
  let extraUi: React.ReactNode = null;
  let showRowSelection: boolean = true;

  const bulkBtnDisabled = selectedRowIds.length === 0 || listProps.disabled;
  switch (routeParams.status) {
    case "standby-or-pending":
    case "revision":
      if (isFulfilledByBossList) {
        extraUi = (
          <Space>
            <Form.Item name="purchaseCloseDate" noStyle>
              <MonthPicker
                style={{ width: 150 }}
                allowClear={false}
                disabledDate={(current) => {
                  // NOTE: B2B 매출/매입 정산을 2025-09-26부터 시스템 이용해 처리하기 시작하면서, 과거 오프라인 데이터도 시스템에서 차리하기 위해 B2B인 경우는 제한 제거.
                  if (isB2b) {
                    return false;
                  }
                  return disabledDateForPurchaseClose(current);
                }}
                placeholder="마감월 선택"
              />
            </Form.Item>
            <Button
              type="primary"
              shape="round"
              disabled={bulkBtnDisabled || purchaseBulkPendingOpts.loading || utils.isEmpty(purchaseCloseDateWatched)}
              onClick={() => openModal("bulk-pending-purchase", { ids: selectedRowIds })}
            >
              검토 요청
            </Button>
          </Space>
        );
      }
      break;
    case "pending":
      extraUi = (
        <Space>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("bulk-req-revision-purchase")}
          >
            수정 요청
          </Button>
          <Button
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("bulk-close-purchase")}
          >
            정산 내역 확정
          </Button>
        </Space>
      );
      break;
    case "closed":
      showRowSelection = false;
      break;
    case "all-status":
      pageTitle = isFbv ? "직거래 상품 매입 내역" : null;
      showRowSelection = false;
      break;
  }

  const makeConfirmContentNodeForPurchaseCancel = () => {
    const purchase = purchaseList.find((purchase) => purchase.id === params.id);
    if (!purchase) {
      return null;
    }
    const purchaseTableForConfirmColumns = getPurchaseTableSettingsForConfirm(isB2b);
    const purchaseTableForConfirmWidthSum = utils.calcTableColsWidthSum(purchaseTableForConfirmColumns);
    const contentNode = (
      <>
        <Typography.Title level={5}>
          발주상세번호: {makePurchaseOrderLineNumber(purchase.purchaseOrderLine)}
        </Typography.Title>
        <Divider />
        <Table
          {...commonTableProps}
          columns={purchaseTableForConfirmColumns}
          dataSource={[purchase]}
          scroll={{ x: purchaseTableForConfirmWidthSum }}
        />
      </>
    );

    return contentNode;
  };

  const makeConfirmContentNodeForPurchaseBulkPending = () => {
    if (!purchaseList || selectedRowIds.length <= 0) {
      return null;
    }
    // toSorted 메서드는 npm run check-watch에서 타입 에러로 인식하여 아래와 같이 수정함
    const selectedPurchaseList = purchaseList
      .filter((purchase) => selectedRowIds.includes(purchase.id))
      .slice()
      .sort((a, b) => a.vendorId.localeCompare(b.vendorId));
    const pendingReasonInput = routeParams.status === "revision" && (
      <Form.Item
        name="pendingReason"
        labelCol={{ span: 24 }}
        label={<Typography.Text strong>검토 의견</Typography.Text>}
      >
        <Input.TextArea placeholder="검토 요청 사유를 입력해주세요." rows={4} />
      </Form.Item>
    );

    const contentNode = (
      <Space direction="vertical" size="large">
        {makeConfirmNodeForPurchaseTotal(purchaseCloseDateWatched, selectedPurchaseList)}
        {pendingReasonInput}
      </Space>
    );

    return contentNode;
  };

  const mutationsLoadingBeforeClosed = purchaseCancelOpts.loading || purchaseUpdateOpts.loading;

  const purchaseTableColumns = getPurchaseListTableSettings({
    formValuesWatched,
    routeParams,
    navigate,
    isB2b,
    editingProps: {
      loading: mutationsLoadingBeforeClosed,
      selectedPurchaseId: selectedRowId,
      isEditing,
      vendorOptions,
      vendorsSearch,
      onEdit,
      onCancel,
      onSubmit,
      openModal,
    },
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    purchaseTableColumns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const purchaseTableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: purchaseTableColumns,
    dataKey: "purchases",
  };
  return (
    <Form form={form} component={false}>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          {pageTitle && (
            <Col>
              <Typography.Title level={4}>{pageTitle}</Typography.Title>
            </Col>
          )}
          {ListNavigator && <Col>{ListNavigator()}</Col>}
          <Col>{extraUi}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable<Purchases_purchases_edges_node>
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={purchaseList}
            rowSelection={showRowSelection && rowSelection}
            scroll={{ x: purchaseTableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
            components={{ body: { cell: EditableCell } }}
          />
        </Card>
      </Space>

      <ConfirmModal
        titleText="매입 취소 작업을 진행하시겠습니까?"
        helpText="아래 매입 정보를 다시 한번 확인하시고 맞으면 매입 취소 버튼을 눌러주세요."
        visible={params.action === "cancel-purchase"}
        contentNode={makeConfirmContentNodeForPurchaseCancel()}
        okButtonProps={{
          loading: purchaseCancelOpts.loading,
        }}
        okText={"매입 취소"}
        onOk={() => {
          purchaseCancel({ variables: { id: params.id } });
        }}
        onCancel={closeModal}
      />
      <ConfirmModal
        titleText="선택한 매입 내역 검토 요청을 진행하시겠습니까?"
        helpText="아래 매입 정보를 다시 한번 확인하시고 맞으면 검토 요청 버튼을 눌러주세요."
        visible={params.action === "bulk-pending-purchase"}
        contentNode={makeConfirmContentNodeForPurchaseBulkPending()}
        okButtonProps={{
          loading: purchaseBulkPendingOpts.loading,
        }}
        okText={"검토 요청"}
        onOk={async () => {
          const { purchaseCloseDate, pendingReason } = form.getFieldsValue();
          if (utils.isEmpty(purchaseCloseDate)) {
            showNotificationError("매입 마감월을 선택해주세요.");
            return;
          }
          const formattedPurchaseCloseDate = moment(purchaseCloseDate).endOf("month").format(onlyDateFormat);
          purchaseBulkPending({
            variables: { ids: selectedRowIds, purchaseCloseDate: formattedPurchaseCloseDate, pendingReason },
          });
        }}
        onCancel={closeModal}
      />
    </Form>
  );
};
</file>

<file path="src/app/views/purchase/purchases/components/PurchaseListPage/PurchaseListTableSettings.tsx">
import { UseNavigatorResult } from "@hooks/useNavigator";
import { PurchaseStatus, PurchaseType } from "@src/api/types/globalTypes";
import {
  DownloadableEditableColumnsType,
  DownloadableEditableColumnType,
} from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { DateTime, getDateByFormat, onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { orderDetailsViewUrl } from "@src/app/views/order/orders/urls";
