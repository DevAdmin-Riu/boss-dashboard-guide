    render: (_, record) => {
      const value = getMonthlySnapshotValue(record, fieldKey, SALES_INFO_TYPE.PRODUCT_STATUS);
      if (value === NA_VALUE_TEXT) {
        return <span style={naValueTextStyle}>{value}</span>;
      }
      // priorityLevel은 숫자 컴포넌트 사용 안함
      if (key === "priorityLevel") {
        return value;
      }
      return typeof value === "number" ? <NumberComponent value={value} /> : value;
    },
    renderExcel: (record) => {
      const value = getMonthlySnapshotValue(record, fieldKey, SALES_INFO_TYPE.PRODUCT_STATUS);
      return value === NA_VALUE_TEXT ? NA_VALUE_TEXT : record[fieldKey] || "-";
    },
  });

