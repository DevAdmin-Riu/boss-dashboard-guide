import {
  PurchaseOrderLineInspectResultEnum,
  PurchaseOrderLineStatus,
  PurchaseOrderLineStatusEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { WindowTitle } from "@src/app/components/WindowTitle";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { ListViews } from "@src/global/core/types/types";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form } from "antd";
import React, { useEffect, useMemo, useState } from "react";

import { usePurchaseOrderLinesInspectMutation } from "../../api/mutations";
import { usePurchaseOrderLineListQuery } from "../../api/queries";
import { PurchaseOrderLineListVariables } from "../../api/types/PurchaseOrderLineList";
import PurchaseOrderLineInspectPage from "../../components/PurchaseOrderLineInspectPage/PurchaseOrderLineInspectPage";
import { PurchaseOrderLineInspectViewUrlQueryParams, PurchaseOrderLineUrlEnum } from "../../urls";
import { PurchaseOrderLineInspectFormData, PurchaseOrderLineInspectResultFormEnum } from "./inspection";

interface PurchaseOrderLineInspectViewProps {
  params: PurchaseOrderLineInspectViewUrlQueryParams;
}

export const PurchaseOrderLineInspectView: React.FC<PurchaseOrderLineInspectViewProps> = ({ params }) => {
  const shop = useShop();
  const currencySymbol = shop?.localizedDefaultCurrency || "원";

  const [selectedRowIds, setSelectedRowIds] = useState<React.Key[]>([]);
  const [modalMode, setModalMode] = useState<"inspect-complete" | "inspect-cancel" | null>(null);
  const [initialSelectionDone, setInitialSelectionDone] = useState(false);

  // Form 초기화
  const [form] = Form.useForm<PurchaseOrderLineInspectFormData>();
  const TypeSafeForm = getTypeSafeForm<PurchaseOrderLineInspectFormData>(form);

  const poLineIds = params.poLineIds || [];

  const { paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(ListViews.PURCHASE_ORDER_LINE_LIST, [
      "track-inventory",
      PurchaseOrderLineUrlEnum.INSPECT,
    ]),
  });

  // status로 필터링하여 TO_BE_INSPECTED 상태의 항목만 가져오기
  const queryVariables = useMemo<PurchaseOrderLineListVariables>(
    () => ({
      ...paginationState,
      filter: {
        status: [PurchaseOrderLineStatusEnum.TO_BE_INSPECTED],
      },
    }),
    [paginationState]
  );

  const { data, loading } = usePurchaseOrderLineListQuery({
    variables: queryVariables,
  });

  const purchaseOrderLines = useMemo(() => {
    const allLines = data?.purchaseOrderLines?.edges.map((edge) => edge.node) || [];

    // poLineIds가 있으면 해당 ID의 데이터만 필터링
    let filteredLines = allLines;
    if (poLineIds.length > 0) {
      filteredLines = allLines.filter((line) => poLineIds.includes(line.id));
    }

    // needToInspect가 true이고 TO_BE_INSPECTED 상태인 항목만 필터링
    const validLines = filteredLines.filter(
      (line) => line.variant.needToInspect === true && line.status === PurchaseOrderLineStatus.TO_BE_INSPECTED
    );

    return validLines;
  }, [data, poLineIds]);

  // URL로 전달된 poLineIds가 있으면 초기 선택 상태로 설정 및 Form 초기값 설정
  useEffect(() => {
    if (!initialSelectionDone && purchaseOrderLines.length > 0) {
      const availableLineIds = purchaseOrderLines.filter((line) => poLineIds.includes(line.id)).map((line) => line.id);

      if (availableLineIds.length > 0) {
        setSelectedRowIds(availableLineIds);
      }

      // Form 초기값 설정
      const initialValues: PurchaseOrderLineInspectFormData = {
        lines: purchaseOrderLines.map(() => ({
          result: PurchaseOrderLineInspectResultFormEnum.NONE,
          report: undefined,
        })),
      };
      form.setFieldsValue(initialValues);
      setInitialSelectionDone(true);
    }
  }, [purchaseOrderLines, poLineIds, initialSelectionDone, form]);

  const [purchaseOrderLinesInspect, purchaseOrderLinesInspectOpts] = usePurchaseOrderLinesInspectMutation({});

  const handleBack = () => {
    window.history.back();
  };

  // 검수 결과 통계 계산
  const inspectStats = useMemo(() => {
    const formData = form.getFieldsValue();
    if (!formData?.lines) {
      return { pass: 0, fail: 0, total: 0, totalProducts: purchaseOrderLines.length };
    }

    let pass = 0;
    let fail = 0;

    formData.lines.forEach((line: any) => {
      if (line?.result === PurchaseOrderLineInspectResultEnum.PASS) {
        pass++;
      } else if (line?.result === PurchaseOrderLineInspectResultEnum.FAIL) {
        fail++;
      }
    });

    return { pass, fail, total: pass + fail, totalProducts: purchaseOrderLines.length };
  }, [form, modalMode, purchaseOrderLines.length]);

  const handleInspectComplete = async () => {
    const formData = await form.validateFields();

    const inspectedDetails = formData.lines
      .map((line, index) => ({
        ...line,
        id: purchaseOrderLines[index].id,
      }))
      .filter((line) => line.result !== PurchaseOrderLineInspectResultFormEnum.NONE);

    if (inspectedDetails.length === 0) {
      showNotificationError("검수가 완료된 품목이 없습니다. 합부판정을 선택해주세요.");
      return;
    }

    // 검수된 품목들의 상세 정보 준비
    const details = inspectedDetails.map((line) => ({
      poLineId: line.id,
      result: line.result as PurchaseOrderLineInspectResultEnum,
      report: line.report || null,
    }));

    const { data } = await purchaseOrderLinesInspect({
      variables: {
        input: {
          details,
        },
      },
    });

    const errors = data?.purchaseOrderLinesInspect?.errors;
    if (errors?.length === 0) {
      showNotificationSuccess("검수가 완료되었습니다.");
      handleBack();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const disabled = loading || purchaseOrderLinesInspectOpts.loading;

  // 조건에 부합하는 항목이 없으면 이전 페이지로 돌아가기
  useEffect(() => {
    if (!loading && purchaseOrderLines.length === 0 && data?.purchaseOrderLines) {
      handleBack();
    }
  }, [purchaseOrderLines, loading, data]);

  // 페이지네이션 초기화
  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.purchaseOrderLines?.pageInfo,
    paginationState,
    params,
  });

  return (
    <>
      <WindowTitle title="입고 검수" />
      <PurchaseOrderLineInspectPage
        disabled={disabled}
        currencySymbol={currencySymbol}
        purchaseOrderLines={purchaseOrderLines}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        onBack={handleBack}
        onInspectComplete={() => setModalMode("inspect-complete")}
        loading={loading}
        poLineIds={poLineIds}
        form={form}
        TypeSafeForm={TypeSafeForm}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        settings={settings}
        onUpdateListSettings={updateListSettings}
      />

      {/* 검수 완료 확인 모달 */}
      <ConfirmModal
        visible={modalMode === "inspect-complete"}
        okText="검수 완료"
        onOk={handleInspectComplete}
        onCancel={() => setModalMode(null)}
        modalTitleText="검수 완료 확인"
        titleText="선택한 발주제품의 검수를 완료하시겠습니까?"
        helpText={
          <div>
            <div style={{ marginBottom: 10 }}>
              <span style={{ color: "#52c41a", fontWeight: "bold" }}>합격: {inspectStats.pass}개</span>
              {" / "}
              <span style={{ color: "#ff4d4f", fontWeight: "bold" }}>불합격: {inspectStats.fail}개</span>
              {" / "}
              <span style={{ color: "#000", fontWeight: "bold" }}>
                총 {inspectStats.totalProducts}개 중 {inspectStats.total}개 검수
              </span>
            </div>
            <div>검수 완료된 제품은 재고 입고 페이지에서 입고 처리할 수 있습니다.</div>
          </div>
        }
      />
    </>
  );
};
</file>

