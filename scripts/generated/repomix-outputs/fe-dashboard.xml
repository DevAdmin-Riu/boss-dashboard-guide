import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createTextField } from "@utils/filters/fields";

export enum FbvOrderDeliveryListFilterKeys {
  orderCreated = "orderCreated",
  orderSearch = "orderSearch",
  brandSearch = "brandSearch",
  productSearch = "productSearch",
}

export interface FbvOrderDeliveryListFilterOpts {
  orderCreated: FilterOpts<MinMax>;
  orderSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
}

export function createFilterStructure(opts: FbvOrderDeliveryListFilterOpts): IFilter<FbvOrderDeliveryListFilterKeys> {
  let displayOrder = 0;

  const orderSearch = {
    ...createTextField(
      displayOrder++,
      FbvOrderDeliveryListFilterKeys.orderSearch,
      "주문번호 / 주문상세번호",
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const brandSearch = {
    ...createTextField(
      displayOrder++,
      FbvOrderDeliveryListFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const productSearch = {
    ...createTextField(
      displayOrder++,
      FbvOrderDeliveryListFilterKeys.productSearch,
      "상품코드 / 상품명",
      opts.productSearch.value
    ),
