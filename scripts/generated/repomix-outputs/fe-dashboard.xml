<file path="src/app/views/purchase/vendors/components/UseFbvBrandTable/UseFbvBrandTable.tsx">
import { VendorFragment_fbvBrands } from "@src/api/fragments/types/VendorFragment";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import {
  useBulkAssignBrandsToVendorMutation,
  useBulkUnassignBrandsFromVendorMutation,
} from "@src/app/views/stats/api/mutations";
import { utils } from "@utils/utils";
import { Button, Card, Row, Space, Table } from "antd";
import React from "react";

import FbvBrandAddModal from "../FbvBrandAddModal/FbvBrandAddModal";
import { getUseFbvBrandTableSettings } from "./UseFbvBrandTableSettings";

interface UseFbvBrandTableProps {
  vendorId: string;
  selectedFbvBrands: VendorFragment_fbvBrands[];
  disabled: boolean;
}

const UseFbvBrandTable: React.FC<UseFbvBrandTableProps> = (props) => {
  const { vendorId, selectedFbvBrands, disabled } = props;
  const [selectedRowKeys, setSelectedRowKeys] = React.useState<React.Key[]>([]);
  const [deleteModalOpen, setDeleteModalOpen] = React.useState(false);
  const [addModalOpen, setAddModalOpen] = React.useState(false);

  const columns = getUseFbvBrandTableSettings();

  const onSelectChange = (newSelectedRowKeys: React.Key[]) => {
    setSelectedRowKeys(newSelectedRowKeys);
  };
  const rowSelection = {
    selectedRowKeys,
    onChange: onSelectChange,
  };

  const [bulkAssignBrandsToVendor, bulkAssignBrandsToVendorOpts] = useBulkAssignBrandsToVendorMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bulkAssignBrandsToVendor.errors, "브랜드를 추가하였습니다.", () => {
        setSelectedRowKeys([]);
      }),
  });

  const [bulkUnassignBrandsFromVendor, bulkUnassignBrandsFromVendorOpts] = useBulkUnassignBrandsFromVendorMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.bulkUnassignBrandsFromVendor.errors, "브랜드를 제거하였습니다.", () => {
        setSelectedRowKeys([]);
        setDeleteModalOpen(false);
      }),
  });

  const loading = bulkAssignBrandsToVendorOpts.loading || bulkUnassignBrandsFromVendorOpts.loading;

  return (
    <>
      <Card
        title="거래 브랜드"
        extra={
          <Row justify="end">
            <Space>
              <Button
                danger
                type="default"
                disabled={disabled || loading || selectedRowKeys.length <= 0}
                onClick={() => {
                  setDeleteModalOpen(true);
                }}
              >
                선택 브랜드 제거
              </Button>
              <Button
                type="primary"
                disabled={disabled || loading}
                onClick={() => {
                  setAddModalOpen(true);
                }}
              >
                브랜드 추가
              </Button>
            </Space>
          </Row>
        }
        bodyStyle={{ padding: 0 }}
      >
        <Table
          {...commonTableProps}
          dataSource={selectedFbvBrands}
          loading={disabled}
          rowSelection={rowSelection}
          columns={columns}
        />
      </Card>

      <ConfirmModal
        visible={deleteModalOpen}
        modalTitleText="거래 브랜드 제거"
        titleText="정말로 선택한 브랜드를 제거 하시겠습니까?"
        okText="제거"
        okButtonProps={{ danger: true, type: "primary" }}
        onOk={() => {
          bulkUnassignBrandsFromVendor({
            variables: {
              input: {
                vendorId,
                brandIds: selectedRowKeys.map(String),
              },
            },
          });
        }}
        onCancel={() => {
          setDeleteModalOpen(false);
        }}
      />
      <FbvBrandAddModal
        open={addModalOpen}
        currentFbvBrands={selectedFbvBrands}
        onSubmit={(selectedBrandIdList) => {
          bulkAssignBrandsToVendor({
            variables: {
              input: {
                vendorId,
                brandIds: selectedBrandIdList,
              },
            },
          });
        }}
        onClose={() => setAddModalOpen(false)}
        loading={loading}
      />
    </>
  );
};

export default UseFbvBrandTable;
</file>

