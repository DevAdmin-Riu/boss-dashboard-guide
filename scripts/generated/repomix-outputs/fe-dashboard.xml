import useNavigator from "@hooks/useNavigator";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useAttributeCreateMutation } from "../../api/mutations";
import AttributePage, { AttributePageFormData } from "../../components/AttributePage";
import { attributeDetailsViewUrl, attributeListViewUrl } from "../../urls";

export const AttributeCreateView: React.FC = () => {
  const navigate = useNavigator();

  const [attributeCreate, attributeCreateOpts] = useAttributeCreateMutation({
    onCompleted: (data) => {
      const errors = data.attributeCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("속성 추가를 완료했습니다.");
        navigate(attributeDetailsViewUrl(data.attributeCreate.attribute.id));
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleCreate = async (data: AttributePageFormData) => {
    const input = {
      ...data,
      metadata: undefined,
      privateMetadata: undefined,
      values: [],
    };

    const result = await attributeCreate({ variables: { input } });
    return result.data.attributeCreate?.attribute?.id || null;
  };

  return (
    <>
      <AttributePage
        attribute={null}
        disabled={attributeCreateOpts.loading}
        errors={attributeCreateOpts.data?.attributeCreate.errors || []}
        onBack={() => navigate(attributeListViewUrl())}
        onDelete={undefined}
        onSubmit={handleCreate}
        saveButtonBarState={attributeCreateOpts.status}
      />
    </>
  );
};
