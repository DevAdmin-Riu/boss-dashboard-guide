import { SubmitPromise } from "@hooks/useForm";
import { AttributeTypeEnum } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { ReorderEvent, UserError } from "@src/global/core/types/types";
import { mapMetadataItemToInput } from "@utils/maps";
import { maybe, transformIsFBV } from "@utils/misc";
import { utils } from "@utils/utils";
import { Space, Switch } from "antd";
import React from "react";

import { ProductTypeDetails_productType } from "../../api/types/ProductTypeDetails";
import ProductTypeAttributes from "../ProductTypeAttributes/ProductTypeAttributes";
import { ProductTypeCreateForm } from "../ProductTypeCreatePage";
import ProductTypeDetails from "../ProductTypeDetails/ProductTypeDetails";

export interface ChoiceType {
  label: string;
  value: string;
}

export interface ProductTypeUpdateForm extends ProductTypeCreateForm {
  hasVariants: boolean;
  productAttributes: ChoiceType[];
  variantAttributes: ChoiceType[];
}

interface ProductTypeDetailsPageProps {
  errors: UserError[];
  productType: ProductTypeDetails_productType;
  disabled: boolean;
  pageTitle: string;
  saveButtonBarState: ConfirmButtonTransitionState;
  onAttributeAdd: (type: AttributeTypeEnum) => void;
  onAttributeClick: (id: string) => void;
  onAttributeReorder: (event: ReorderEvent, type: AttributeTypeEnum) => void;
  onAttributeUnassign: (id: string) => void;
  onAttributeBulkUnassign: (ids: string[]) => void;
  onBack: () => void;
  onDelete: () => void;
  onHasVariantsToggle: (hasVariants: boolean) => void;
  onHasVariantsUnassign: (hasVariants: boolean) => void;
  onSubmit: (data: ProductTypeUpdateForm) => SubmitPromise;
}

const ProductTypeDetailsPage: React.FC<ProductTypeDetailsPageProps> = ({
  disabled,
  errors,
  pageTitle,
  productType,
  saveButtonBarState,
  onAttributeAdd,
  onAttributeUnassign,
  onAttributeBulkUnassign,
  onAttributeReorder,
  onAttributeClick,
  onBack,
  onDelete,
  onHasVariantsToggle,
  onHasVariantsUnassign,
  onSubmit,
}) => {
  const formInitialData: ProductTypeUpdateForm = {
    name: maybe(() => productType.name) !== undefined ? productType.name : "",
    isFulfilledByVendor:
      maybe(() => productType.isFulfilledByVendor) !== undefined ? productType.isFulfilledByVendor : false,
    hasVariants: maybe(() => productType.hasVariants) !== undefined ? productType.hasVariants : false,
    metadata: productType?.metadata?.map(mapMetadataItemToInput),
    privateMetadata: productType?.privateMetadata?.map(mapMetadataItemToInput),
    productAttributes:
      maybe(() => productType.productAttributes) !== undefined
        ? productType.productAttributes.map((attribute) => ({
            label: attribute.name,
            value: attribute.id,
          }))
        : [],
    variantAttributes:
      maybe(() => productType.variantAttributes) !== undefined
        ? productType.variantAttributes.map((attribute) => ({
            label: attribute.name,
            value: attribute.id,
          }))
        : [],
  };

  return (
    <Form initial={formInitialData} onSubmit={onSubmit} confirmLeave>
      {({ change, data, hasChanged, submit }) => (
        <>
          <AppHeader onBack={onBack}>{sectionNames.productTypes}</AppHeader>
          <PageHeader title={pageTitle} />
          <Grid>
            <Space direction="vertical" size="large">
              <ProductTypeDetails
                isCreateMode={false}
                data={data}
                disabled={disabled}
                errors={errors}
                onChange={change}
              />

              <ProductTypeAttributes
                productType={productType}
                attributes={maybe(() => productType.productAttributes)}
                disabled={disabled}
                type={AttributeTypeEnum.PRODUCT}
                onAttributeAssign={onAttributeAdd}
                onAttributeClick={onAttributeClick}
                onAttributeReorder={(event: ReorderEvent) => onAttributeReorder(event, AttributeTypeEnum.PRODUCT)}
                onAttributeUnassign={onAttributeUnassign}
                onAttributeBulkUnassign={onAttributeBulkUnassign}
              />
              <FormFieldAntd
                label="옵션형 제품 타입"
                description={
                  data.isFulfilledByVendor &&
                  `${transformIsFBV(true)} 상품 전용 타입인 경우 옵션형 제품은 지원하지 않습니다.`
                }
              >
                <Switch
                  disabled={disabled || data.isFulfilledByVendor}
                  checked={data.hasVariants}
                  onChange={(value) => {
                    if (!value && productType.variantAttributes.length > 0) {
                      onHasVariantsUnassign(value);
                    } else {
                      onHasVariantsToggle(value);
                    }
                  }}
                  checkedChildren="ON"
                  unCheckedChildren="OFF"
                />
              </FormFieldAntd>
              {data.hasVariants && (
                <ProductTypeAttributes
                  productType={productType}
                  attributes={maybe(() => productType.variantAttributes)}
                  disabled={disabled}
                  type={AttributeTypeEnum.VARIANT}
                  onAttributeAssign={onAttributeAdd}
                  onAttributeClick={onAttributeClick}
                  onAttributeReorder={(event: ReorderEvent) => onAttributeReorder(event, AttributeTypeEnum.VARIANT)}
                  onAttributeUnassign={onAttributeUnassign}
                  onAttributeBulkUnassign={onAttributeBulkUnassign}
                />
              )}
            </Space>
          </Grid>
          <SaveButtonBar
            onCancel={onBack}
            onDelete={utils.isEmpty(productType) || productType.canDelete === false ? undefined : onDelete}
            onSave={submit}
            disabled={disabled || !hasChanged}
            state={saveButtonBarState}
          />
        </>
      )}
    </Form>
  );
};
export default ProductTypeDetailsPage;
</file>

