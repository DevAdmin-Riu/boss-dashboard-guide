  vsB2bOrderDeliveryListViewPathBByNonCourier,
  vsB2bPurchaseListViewPath,
  vsB2bPurchaseOrderLineListViewPath,
} from "./urls";

const VsB2bPurchaseOrderLineListViewWrapper: React.FC<RouteComponentProps<PurchaseOrderLineListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const sortedParams: PurchaseOrderLineListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    { ...qs },
    PurchaseOrderLineListViewUrlSortField,
    PurchaseOrderLineListViewUrlSortField.poLineNo,
    false
  );
  const defaultParams = getPurchaseOrderLineListDefaultParams(match.params);
  const params: PurchaseOrderLineListViewUrlQueryParams = { ...defaultParams, ...sortedParams };

  return <VsPurchaseOrderLineListView defaultParams={defaultParams} params={params} isB2b={true} />;
};

const VsB2bOrderDeliveryListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location, match }) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getOrderDeliveryListDefaultParams(location.pathname);
  const params: OrderDeliveryListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <OrderDeliveryListView defaultParams={defaultParams} params={params} isB2b={true} isByNonCourier={false} />;
};

const VsB2bPurchaseListViewWrapper: React.FC<RouteComponentProps<VsPurchaseListViewRouteParams>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const isB2b = true;
  const defaultParams = getVsPurchaseListDefaultParams(match.params, isB2b);
  const params: PurchaseListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <VsPurchaseListView defaultParams={defaultParams} params={params} isB2b={isB2b} />;
};

const VsB2bSection = () => (
  <>
    <Switch>
      <Route
        exact
        path={vsB2bPurchaseOrderLineListViewPath({
          inventoryType: ":inventoryType",
          status: ":status",
          deliveryMethod: ":deliveryMethod?",
        })}
        component={VsB2bPurchaseOrderLineListViewWrapper}
      />
      <Route exact path={vsB2bOrderDeliveryListViewPathBByNonCourier} component={VsB2bOrderDeliveryListViewWrapper} />
      <Route
        exact
        path={vsB2bPurchaseListViewPath({ fulfilledBy: ":fulfilledBy", status: ":status" })}
        component={VsB2bPurchaseListViewWrapper}
      />
    </Switch>
  </>
);

export default VsB2bSection;
</file>

