import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { Button, Col, Descriptions, Input, Tag, Typography } from "antd";
import moment from "moment";
import React from "react";

import { inspectListData } from "../CustomerRefundQuestionInspectTable/CustomerRefundQuestionInspectTable";

interface RefundInspectItemProps {
  item: inspectListData;
  inspectBtnClick: (e, memo) => void;
  onReturnCancel?: (item: inspectListData) => void;
}

const RefundInspectItem: React.FC<RefundInspectItemProps> = (props) => {
  const { item, inspectBtnClick, onReturnCancel } = props;
  const [memo, setMemo] = React.useState<string>("");
  const inspectNullCheck = item.inspect !== null;
  const inspectBoolean = item.inspect;

  const memoOnChange = (e) => {
    const target = e.target;
    const value = target.value;
    setMemo(value);
  };

  // 당일 반품 취소만 가능하도록 날짜 체크
  const todayDate = moment().format(onlyDateFormat);
  const returnCreatedDate = item.fulfillment?.returnCourierDeliveryFeeCreated
    ? moment(item.fulfillment.returnCourierDeliveryFeeCreated).format(onlyDateFormat)
    : null;
  const hasReturnRequest = !!item.fulfillment?.returnTransUniqueCd;
  const canCancelReturn = hasReturnRequest && returnCreatedDate === todayDate;

  return (
    <Col span={6} key={item.id}>
      <div
        style={{
          border: `1px solid #d9d9d9`,
          borderRadius: "5px",
          padding: "8px 12px",
          display: !inspectNullCheck && "flex",
          justifyContent: !inspectNullCheck && "center",
          cursor: inspectNullCheck ? "not-allowed" : "pointer",
          flexDirection: inspectNullCheck ? "initial" : "column",
          alignItems: "center",
          transition: "all 0.4s",
        }}
      >
        {inspectNullCheck && (
          <Tag color={inspectBoolean ? "geekblue" : "volcano"}>{inspectBoolean ? "검수 승인" : "검수 불량"}</Tag>
        )}

        <span style={{ marginLeft: 8, flex: 1, textAlign: "center" }}>
          {item.consignment && (
            <Tag color="#f50" style={{ marginRight: 5 }}>
              위탁
            </Tag>
          )}
          {item.uniqueId} - {item.productName}
        </span>
        {inspectNullCheck && (
          <>
            <hr />
            <Descriptions>
              <Descriptions.Item label="메모">
                <Typography.Text strong>{item.memo}</Typography.Text>
              </Descriptions.Item>
            </Descriptions>
          </>
        )}
        {!inspectNullCheck && (
          <>
            <div style={{ width: "100%", marginTop: 10 }}>
              <Input.TextArea rows={3} placeholder="검수에 대한 메모" onChange={memoOnChange} />
            </div>
            <div
              style={{
                display: "flex",
                flexWrap: "wrap",
                gap: 8,
                marginTop: 10,
              }}
            >
              {onReturnCancel && canCancelReturn && (
                <Button
                  danger
                  type="primary"
                  onClick={() => {
                    onReturnCancel(item);
                  }}
                >
                  반품 취소
                </Button>
              )}
              {hasReturnRequest && !canCancelReturn && (
                <Button color="gray" disabled>
                  반품 불가
                </Button>
              )}
              <Button
                type="primary"
                ghost
                danger
                data-id={item.id}
                data-status={false}
                onClick={(e) => {
                  inspectBtnClick(e, memo);
                }}
              >
                검수 불량
              </Button>
              <Button
                type="primary"
                ghost
                data-id={item.id}
                data-status={true}
                onClick={(e) => {
                  inspectBtnClick(e, memo);
                }}
              >
                검수 승인
              </Button>
            </div>
          </>
        )}
      </div>
    </Col>
  );
};

export default RefundInspectItem;
</file>

