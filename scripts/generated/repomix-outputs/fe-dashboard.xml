import { RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, onlyDateFormat } from "@src/app/providers/DateProvider";
import { findInEnum, transformIsExclusive } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Tag } from "antd";
import moment from "moment";
import React from "react";

import {
  RequestBossProductList_requestBossProductList_edges_node,
  RequestBossProductList_requestBossProductList_edges_node_statusHistories,
} from "../../api/types/RequestBossProductList";
import { ReqBossProductUrlEnum } from "../../urls";
import { getRequestBossProductStatusColor, getRequestBossProductStatusText } from "../../utils";
import { ReqBossProductListPageProps } from "./ReqBossProductListPage";

export const getReqBossProdIsExclusiveColor = (isExclusive: boolean) => (isExclusive ? "blue" : "green");

export const getStatusHistory = (
  status: RequestBossProductStatusEnum,
  histories: RequestBossProductList_requestBossProductList_edges_node_statusHistories[] | null
) => {
  if (utils.isEmpty(histories)) {
    return null;
  }
  const findStatus = histories.filter((item) => item.afterStatus === status);
  return findStatus.length > 0
    ? { createdAt: findStatus[0].createdAt, writerName: findStatus[0].writer?.firstName || "-" }
    : null;
};

interface createStatusColumnProps {
  status: RequestBossProductStatusEnum;
  title: string;
  key: string;
  width?: number;
  isShowWriterName?: boolean;
}

export const createChangeTimeOrWriterColumn = ({
  status,
  title,
  key,
  width,
  isShowWriterName,
}: createStatusColumnProps): DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> => ({
  title,
  align: "center",
  key,
  width: width ? width : isShowWriterName ? 100 : 120,
  render: (_, record) => {
    const statusHistoryInfo = getStatusHistory(status, record.statusHistories);
    return isShowWriterName ? (
      statusHistoryInfo?.writerName || "-"
    ) : (
      <DateTime date={statusHistoryInfo?.createdAt} onlyDate />
    );
  },
  renderExcel: (record) => {
    const statusHistoryInfo = getStatusHistory(status, record.statusHistories);
    return isShowWriterName
      ? statusHistoryInfo?.writerName || "-"
      : moment(statusHistoryInfo?.createdAt).format(onlyDateFormat);
  },
});

const getReqLeadTime = (record: RequestBossProductList_requestBossProductList_edges_node): number => {
  const statusHistories = record.statusHistories;
  const requestedDate = getStatusHistory(RequestBossProductStatusEnum.REQUESTED, statusHistories)?.createdAt;
  const completedDate = getStatusHistory(RequestBossProductStatusEnum.COMPLETED, statusHistories)?.createdAt;
  const cancelDate = getStatusHistory(RequestBossProductStatusEnum.CANCELED, statusHistories)?.createdAt;

  const lastDate = completedDate || cancelDate || undefined;
  if (lastDate === undefined) {
    return null;
  }

  const lastDateFormatted = moment(lastDate).format(onlyDateFormat);
  const requestedDateFormatted = moment(requestedDate).format(onlyDateFormat);

  const reqLeadTime = moment(lastDateFormatted).diff(moment(requestedDateFormatted), "days");
  return reqLeadTime;
};

export const getReqBossProductListTableSettings = (
  props: ReqBossProductListPageProps
): DownloadableColumnsType<RequestBossProductList_requestBossProductList_edges_node> => {
  const fixedLeftFlag = utils.fixedLeftFlag();
  const fixedRightFlag = utils.fixedRightFlag();
  const urlType = props.urlType;
  const requestNumberColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.requestProduct.REQUEST_NO,
    align: "center",
    key: "id",
    width: 120,
    render: (_, record) => record.requestNumber,
    fixed: fixedLeftFlag,
  };

  const brandCodeColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.brand.BRAND_CODE,
    align: "center",
    key: "brandCode",
    width: 120,
    render: (_, record) => record.brand.code,
  };

  const brandNameColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.brand.BRAND_NAME,
    align: "center",
    key: "brandName",
    width: 120,
    render: (_, record) => record.brand.name,
  };

  const staffNameColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: "요청 관리자",
    align: "center",
    key: "staffName",
    width: 100,
    render: (_, record) => record.reqStaff?.firstName || "-",
  };

  const statusColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.requestProduct.PROGRESS_STATUS,
    align: "center",
    key: "status",
    width: 120,
    render: (_, record) => {
      const statusEnum = findInEnum(record.status, RequestBossProductStatusEnum);
      const statusText = getRequestBossProductStatusText(statusEnum);
      const statusColor = getRequestBossProductStatusColor(statusEnum);
      return <Tag color={statusColor}>{statusText}</Tag>;
    },
    renderExcel: (record) => {
      const statusEnum = findInEnum(record.status, RequestBossProductStatusEnum);
      const statusText = getRequestBossProductStatusText(statusEnum);
      return statusText;
    },
  };
  const productNameColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    align: "left",
    key: "productName",
    width: 200,
    render: (_, record) => record.productName,
  };
  const specColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.product.SPEC,
    align: "left",
    key: "spec",
    width: 120,
    render: (_, record) => record.spec,
  };

  const materialColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.product.MATERIAL,
    align: "left",
    key: "material",
    width: 120,
    render: (_, record) => record.material,
  };
  const colorColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.product.COLOR,
    align: "left",
    key: "color",
    width: 120,
    render: (_, record) => record.color,
  };

  const reqLeadTimeColumn: DownloadableColumnType<RequestBossProductList_requestBossProductList_edges_node> = {
    title: columnNameConstant.requestProduct.REQUEST_LT,
    align: "right",
    key: "reqLeadTime",
    width: 80,
