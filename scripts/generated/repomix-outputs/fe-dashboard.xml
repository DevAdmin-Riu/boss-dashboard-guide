  StoreWorkerUpdateVariables,
} from "@src/app/views/brand/brandStore/api/types/StoreWorkerUpdate";
import {
  UnassignHqStaffSupervisor,
  UnassignHqStaffSupervisorVariables,
} from "@src/app/views/brand/brandStore/api/types/UnassignHqStaffSupervisor";
import { BrandStoreUsers } from "@src/app/views/brand/brandStore/components/BrandStoreUsers";
import { HqStaffBrandStoresByHqStaff } from "@src/app/views/brand/brandStore/components/HqStaffBrandStoresByHqStaff";
import { BrandAccountDetails_user } from "@src/app/views/customer/customers/api/types/BrandAccountDetails";
import CustomerAddresses from "@src/app/views/customer/customers/components/CustomerAddresses";
import CustomerOrdersTable from "@src/app/views/customer/customers/components/CustomerOrdersTable";
import { HqStaffBasicInfo } from "@src/app/views/customer/customers/components/HqStaffBasicInfo";
import { StoreWorkerBasicInfo } from "@src/app/views/customer/customers/components/StoreWorkerBasicInfo";
import { hqOrderLineListViewUrl } from "@src/app/views/hqStaff/hqSection/urls";
import { orderDetailsViewUrl, orderListViewUrlA } from "@src/app/views/order/orders/urls";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { checkStaff, getDisplayUserName, maybe } from "@utils/misc";
import { Col, PageHeader, Row, Space } from "antd";
import React from "react";

import CustomerCreditsTable from "../CustomerCreditsTable";
import CustomerRcoinsTable from "../CustomerRcoinsTable";

interface BrandAccountDetailsPageProps {
  brandAccountUser: BrandAccountDetails_user;
  onSubmitHqStaffUpdate: MutationFunction<HqStaffUpdate, HqStaffUpdateVariables>;
  onSubmitHqStaffSupervisorAssign: MutationFunction<AssignHqStaffSupervisor, AssignHqStaffSupervisorVariables>;
  onSubmitHqStaffSupervisorUnassign: MutationFunction<UnassignHqStaffSupervisor, UnassignHqStaffSupervisorVariables>;
  onSubmitStoreWorkerUpdate: MutationFunction<StoreWorkerUpdate, StoreWorkerUpdateVariables>;
  loading: boolean;
  onBack: () => void;
  onClickBrandStore: (brandStoreId: string) => void;
  onClickAccount: (brandStoreId: string) => void;
  onAddressManageClick: () => void;
  navigate: (url: string, replace?: boolean, preserveQs?: boolean, state?: any) => void;
}

const BrandAccountDetailsPage: React.FC<BrandAccountDetailsPageProps> = ({
  brandAccountUser,
  onSubmitHqStaffUpdate,
  onSubmitHqStaffSupervisorAssign,
  onSubmitHqStaffSupervisorUnassign,
  onSubmitStoreWorkerUpdate,
  onBack,
  onClickBrandStore,
  onClickAccount,
  onAddressManageClick,
  navigate,
}: BrandAccountDetailsPageProps) => {
  if (!brandAccountUser) {
    return <></>;
  }
  const { user } = useUser();

  const isHqStaff = brandAccountUser.isHqStaff;
  const isBrandStoreOwner = brandAccountUser.brandStoreUser?.role === BrandStoreRoleEnum.OWNER;
  const isStaff = checkStaff(user);

  const customerName = getDisplayUserName(brandAccountUser, true, false);

  const showCustomerAddresses = isStaff && (isHqStaff || isBrandStoreOwner);

  const orderListViewUrl = isHqStaff ? hqOrderLineListViewUrl : orderListViewUrlA;

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.customers}</AppHeader>
      <PageHeader title={getDisplayUserName(brandAccountUser, true, true)} />
      <Row gutter={24}>
        <Col span={17}>
          <Space direction="vertical" size={24}>
            {isHqStaff ? (
              <HqStaffBasicInfo brandAccountUser={brandAccountUser} onSubmit={onSubmitHqStaffUpdate} />
            ) : (
              <StoreWorkerBasicInfo
                brandAccountUser={brandAccountUser}
                onSubmit={onSubmitStoreWorkerUpdate}
                onClickBrandStore={onClickBrandStore}
              />
            )}
            <CustomerOrdersTable
              orders={maybe(() => brandAccountUser.orders.edges.map((edge) => edge.node))}
              onViewAllOrdersClick={() =>
                navigate(orderListViewUrl({ userSearch: maybe(() => brandAccountUser.loginId) }))
              }
              onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
            />
            {isHqStaff && (
              <>
                <CustomerCreditsTable customerName={customerName} customer={brandAccountUser} />
                <CustomerRcoinsTable customerName={customerName} customer={brandAccountUser} />
              </>
            )}
          </Space>
        </Col>
        <Col span={7}>
          <Space direction="vertical" size={24}>
            {isHqStaff ? (
              <HqStaffBrandStoresByHqStaff
                brandAccountUser={brandAccountUser}
                onAssign={onSubmitHqStaffSupervisorAssign}
                onUnassign={onSubmitHqStaffSupervisorUnassign}
                onClickBrandStore={onClickBrandStore}
              />
            ) : (
              <BrandStoreUsers
                brandStore={brandAccountUser.brandStoreUser.brandStore}
                onClickAccount={onClickAccount}
                readOnly={true}
              />
            )}
            {showCustomerAddresses && (
              <CustomerAddresses customer={brandAccountUser} onAddressManageClick={onAddressManageClick} />
            )}
          </Space>
        </Col>
      </Row>
    </>
  );
};
export default BrandAccountDetailsPage;
</file>

