import React from "react";

import { useCreditsEventListFilterDownloadQuery, useCreditsEventListQuery } from "../../api/queries";
import { CreditsEventListVariables } from "../../api/types/CreditsEventList";
import CreditsEventListPage from "../../components/CreditsEventListPage/CreditsEventListPage";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface CreditsEventListViewProps {
  params: CreditsEventListViewUrlQueryParams;
}

export const CreditsEventListView: React.FC<CreditsEventListViewProps> = ({ params }) => {
  const targetUrl = creditsEventListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.POINTS_EVENT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useCreditsEventListFilterDownloadQuery);
  const queryVariables = React.useMemo<CreditsEventListVariables>(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        viewMode: [CreditsEventViewModeEnum.ALL, CreditsEventViewModeEnum.ONLY_DASHBOARD],
      },
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useCreditsEventListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.creditsEvents?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<RcoinsEventListViewUrlDialog, RcoinsEventListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <CreditsEventListPage
        settings={settings}
        disabled={loading}
        pointsEvents={maybe(() => data.creditsEvents.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
