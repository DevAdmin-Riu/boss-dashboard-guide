import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  MileageSettlementFilterKeys,
  MileageSettlementListFilterOpts,
} from "../../components/MileageSettlementListPage/filters";
import { MileageSettlementListFilterVariables } from "../../components/MileageSettlementListPage/MileageSettlementListPage";
import {
  AdminMonthlySettlementUrlEnum,
  MileageSettlementListViewUrlFilters,
  MileageSettlementListViewUrlFiltersEnum,
  MileageSettlementListViewUrlFiltersWithMultipleValuesEnum,
  MileageSettlementListViewUrlQueryParams,
} from "../../urls";

const MILEAGE_SETTLEMENT_FILTERS_KEY = "mileageSettlementFilters";

export function getFilterOpts(
  params: MileageSettlementListViewUrlFilters,
  urlType: AdminMonthlySettlementUrlEnum
): MileageSettlementListFilterOpts {
  const filterVariables = getMileageSettlementListFilterVariables(params, urlType);
  const lastMonth = moment().subtract(1, "months");

  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, lastMonth.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.statDate.gte, lastMonth.format(onlyMonthFormat)),
      },
    },
    hasApplied: {
      active: maybe(() => filterVariables.hasApplied !== undefined, true),
      value: maybe(() => filterVariables.hasApplied, true),
    },
    settlementStatus: {
      active: maybe(() => filterVariables.settlementStatus && filterVariables.settlementStatus.length > 0, false),
      value: maybe(() => filterVariables.settlementStatus, []),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch, true), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
  };
}

export function getMileageSettlementListFilterVariables(
  params: MileageSettlementListViewUrlFilters,
  urlType: AdminMonthlySettlementUrlEnum
): MileageSettlementListFilterVariables {
  // urlType에 따른 settlementStatus 결정
  let settlementStatus: BrandMonthlySettlementStatusEnum[] | undefined;

  switch (urlType) {
    case AdminMonthlySettlementUrlEnum.NOT_CONFIRMED:
      // 미확정은 settlementStatus가 없는 것들
      settlementStatus = undefined;
      break;
    case AdminMonthlySettlementUrlEnum.REVIEWING_BY_ADMIN:
      // hasApplied 필터에 따라 settlementStatus 결정
      const hasApplied = params.hasApplied !== undefined ? params.hasApplied === "true" : true;
      if (hasApplied) {
        // 신청한 것만 보기: REVIEWING_BY_ADMIN만
        settlementStatus = [BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN];
      } else {
        // 미신청한 것만 보기: CONFIRMED만
        settlementStatus = [BrandMonthlySettlementStatusEnum.CONFIRMED];
      }
      break;
    case AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT:
      settlementStatus = [BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT];
      break;
    case AdminMonthlySettlementUrlEnum.PAID:
      settlementStatus = [BrandMonthlySettlementStatusEnum.PAID];
      break;
    case AdminMonthlySettlementUrlEnum.ALL_STATUS:
      // 전체보기는 필터에서 선택한 값 사용
      settlementStatus = maybe(() =>
        params.settlementStatus.map((item) => findInEnum(item, BrandMonthlySettlementStatusEnum))
      );
      break;
    default:
      settlementStatus = undefined;
  }

  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
    hasApplied: params.hasApplied !== undefined ? params.hasApplied === "true" : true,
    settlementStatus,
    brandSearch: params.brandSearch,
    mdSearch: params.mdSearch,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<MileageSettlementFilterKeys>
): MileageSettlementListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case MileageSettlementFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        MileageSettlementListViewUrlFiltersEnum.statDateFrom,
        MileageSettlementListViewUrlFiltersEnum.statDateTo
      );
    case MileageSettlementFilterKeys.hasApplied:
      return getSingleValueQueryParam(filter, MileageSettlementListViewUrlFiltersEnum.hasApplied);
    case MileageSettlementFilterKeys.settlementStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        MileageSettlementListViewUrlFiltersWithMultipleValuesEnum.settlementStatus,
        BrandMonthlySettlementStatusEnum
      );
    case MileageSettlementFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, MileageSettlementListViewUrlFiltersEnum.brandSearch);
    case MileageSettlementFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, MileageSettlementListViewUrlFiltersEnum.mdSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<MileageSettlementListViewUrlFilters>(MILEAGE_SETTLEMENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  MileageSettlementListViewUrlQueryParams,
  MileageSettlementListViewUrlFilters
>({ ...MileageSettlementListViewUrlFiltersEnum });
</file>

<file path="src/app/views/mileageSettlement/views/MileageSettlementListView/MileageSettlementListView.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { StatReportingMode } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import ListNavigator, { TCountOfStatus } from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { useBrandsOrderStatsForMileageLazyQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { BrandsOrderStatsForMileage } from "@src/app/views/hqStaff/hqSection/api/types/BrandsOrderStatsForMileage";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder } from "@utils/misc";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import React, { useCallback, useEffect, useMemo, useState } from "react";

import {
  useBrandMileageMonthlySettlementListLazyQuery,
  useBrandSettlementCountQuery,
  useBrandsForSettlementQuery,
} from "../../api/queries";
import {
  BrandMileageMonthlySettlements,
  BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node,
} from "../../api/types/BrandMileageMonthlySettlements";
import { BrandsForSettlement_brands_edges_node } from "../../api/types/BrandsForSettlement";
import { MileageSettlementListPage } from "../../components/MileageSettlementListPage/MileageSettlementListPage";
import { createMileageSettlementFromOrderStats } from "../../components/MileageSettlementListPage/utils";
import {
  AdminMonthlySettlementUrlEnum,
  getMileageSettlementNavButtonName,
  MileageSettlementListViewUrlDialog,
  MileageSettlementListViewUrlQueryParams,
  mileageSettlementUrlList,
  settlementListViewUrl,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getMileageSettlementListFilterVariables,
  saveFilterTab,
} from "./filters";

interface MileageSettlementListViewProps {
  defaultParams: MileageSettlementListViewUrlQueryParams;
  params: MileageSettlementListViewUrlQueryParams;
}

export const MileageSettlementListView: React.FC<MileageSettlementListViewProps> = ({ defaultParams, params }) => {
  const [countOfStatus, setCountOfStatus] = useState<TCountOfStatus<AdminMonthlySettlementUrlEnum>>(null);
  const [dataSource, setDataSource] = useState<
    BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node[]
  >([]);

  const currentUrlType = useMemo(() => {
    const currentPath = window.location.pathname;
    return mileageSettlementUrlList.find((item) => currentPath.includes(item.path)) || mileageSettlementUrlList[0];
  }, []);
  const targetUrl = settlementListViewUrl(currentUrlType.path);
  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MILEAGE_SETTLEMENT_LIST,
  });

  const filterVariables = React.useMemo(
    () => getMileageSettlementListFilterVariables(params, currentUrlType.urlEnum),
    [params, currentUrlType.urlEnum]
  );
  const filterOpts = useMemo(() => getFilterOpts(params, currentUrlType.urlEnum), [params, currentUrlType.urlEnum]);

  const {
    data: brandsData,
    loading: brandsLoading,
    refetch: brandsRefetch,
  } = useBrandsForSettlementQuery({
    variables: {
      first: 10000,
      filter: {
        isRunning: true,
        brandSearch: filterVariables.brandSearch || null,
        mdSearch: filterVariables.mdSearch || null,
      },
    },
    skip: currentUrlType.urlEnum !== AdminMonthlySettlementUrlEnum.NOT_CONFIRMED,
  });

  const [BrandsOrderStatsListFetch, { loading: orderStatListLoading }] = useBrandsOrderStatsForMileageLazyQuery();
  const [BrandMileageMonthlySettlementListFetch, { loading: settlementListLoading }] =
    useBrandMileageMonthlySettlementListLazyQuery();
  const tableLoading = brandsLoading || orderStatListLoading || settlementListLoading;

  const { data: countData } = useBrandSettlementCountQuery({
    variables: {
      filter: {
        isFulfilledByVendor: false,
        statDate: filterVariables.statDate,
        mode: StatReportingMode.MONTHLY,
      },
    },
    skip: !filterVariables.statDate,
  });

  useEffect(() => {
    if (countData?.brandSettlementCount) {
      const counts = countData.brandSettlementCount;
      const notConfirmedCount = Math.max(
        0,
        (counts.brandsOrderStatsCount || 0) -
          (counts.confirmedCount || 0) -
          (counts.reviewingByAdminCount || 0) -
          (counts.waitingForPaymentCount || 0) -
          (counts.paidCount || 0)
      );
      const reviewingCount = (counts.confirmedCount || 0) + (counts.reviewingByAdminCount || 0);

      const statusCounts: TCountOfStatus<AdminMonthlySettlementUrlEnum> = {
        [AdminMonthlySettlementUrlEnum.NOT_CONFIRMED]: notConfirmedCount,
        [AdminMonthlySettlementUrlEnum.REVIEWING_BY_ADMIN]: reviewingCount,
        [AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT]: counts.waitingForPaymentCount || 0,
        [AdminMonthlySettlementUrlEnum.PAID]: 0,
        [AdminMonthlySettlementUrlEnum.ALL_STATUS]: 0,
      };
      setCountOfStatus(statusCounts);
    }
  }, [countData]);

  const organizeDataForNotConfirmed = (
    brandsStatsList: ApolloQueryResult<BrandsOrderStatsForMileage>,
    brandsStatsConfirmedList: ApolloQueryResult<BrandMileageMonthlySettlements>
  ) => {
    if (!brandsStatsList || !brandsStatsConfirmedList) {
      return;
    }

    const brandInfoMap = new Map<string, BrandsForSettlement_brands_edges_node>();
    const confirmedSet = new Set<string>();

    if (brandsData?.brands) {
      brandsData.brands.edges.forEach((edge) => {
        brandInfoMap.set(edge.node.id, edge.node);
      });
    }

    brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.forEach((edge) => {
      if (edge.node.brand) {
        brandInfoMap.set(edge.node.brand.id, edge.node.brand);
      }
      confirmedSet.add(`${edge.node.brand?.id}|${edge.node.date}`);
    });

    const uniqueStatsMap = new Map<string, (typeof brandsStatsList.data.brandsOrderStats)[0]>();
    brandsStatsList.data.brandsOrderStats
      .filter((stats) => !confirmedSet.has(`${stats.brandGlobalId}|${stats.statDate}`))
      .forEach((stats) => {
        const key = `${stats.brandGlobalId}|${stats.statDate}`;
        if (!uniqueStatsMap.has(key)) {
          uniqueStatsMap.set(key, stats);
        }
      });

    const brandsOrderStatsNotConfirmed = Array.from(uniqueStatsMap.values())
      .filter((stats) => brandInfoMap.has(stats.brandGlobalId))
      .map((stats) => createMileageSettlementFromOrderStats(stats, brandInfoMap.get(stats.brandGlobalId)));

    setDataSource(brandsOrderStatsNotConfirmed);
  };

  const organizeDataForConfirmed = (brandsStatsConfirmedList: ApolloQueryResult<BrandMileageMonthlySettlements>) => {
    if (!brandsStatsConfirmedList) {
      return;
    }

    let settlements = brandsStatsConfirmedList.data.brandMileageMonthlySettlements.edges.map((edge) => edge.node);

    const { hasApplied } = filterVariables;
    if (currentUrlType.urlEnum === AdminMonthlySettlementUrlEnum.REVIEWING_BY_ADMIN && hasApplied !== undefined) {
      settlements = settlements.filter((settlement) => {
        const hasReviewRequested = !!settlement.settlementReviewRequestedDate;
        return hasApplied ? hasReviewRequested : !hasReviewRequested;
      });
    }

    setDataSource(settlements);
  };

  const refetchDataSource = useCallback(async () => {
    const { statDate, settlementStatus, brandSearch, mdSearch } = filterVariables;
    const hasSearchFilter = !!(brandSearch || mdSearch);

    if (currentUrlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED && !brandsData) {
      return;
    }

    let brandIds: string[] | undefined;

    if (currentUrlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED) {
      brandIds = brandsData?.brands?.edges.map((edge) => edge.node.id) || [];

      if (hasSearchFilter && brandIds.length === 0) {
        showNotificationError("검색 조건에 맞는 브랜드가 없습니다.");
        setDataSource([]);
        return;
      }
    } else if (hasSearchFilter) {
      const brandsResult = await brandsRefetch({
        first: 10000,
        filter: {
          isRunning: true,
          brandSearch: brandSearch || null,
          mdSearch: mdSearch || null,
        },
      });
      brandIds = brandsResult.data?.brands?.edges.map((edge) => edge.node.id) || [];

      if (brandIds.length === 0) {
        showNotificationError("검색 조건에 맞는 브랜드가 없습니다.");
        setDataSource([]);
        return;
      }
    }

    const brandsStatsConfirmedList = await BrandMileageMonthlySettlementListFetch({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.mileageSettlementBrandList,
        filter: {
          date: statDate,
          settlementStatus,
          brands: brandIds,
        },
      },
    });

    if (currentUrlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED) {
      const brandsStatsList = await BrandsOrderStatsListFetch({
        variables: {
          ids: brandIds,
          filter: {
            mode: StatReportingMode.MONTHLY,
            statDate,
            isFulfilledByVendor: false,
          },
        },
      });
      organizeDataForNotConfirmed(brandsStatsList, brandsStatsConfirmedList);
    } else {
      organizeDataForConfirmed(brandsStatsConfirmedList);
    }
  }, [filterVariables, currentUrlType.urlEnum, brandsData]);

  useEffect(() => {
    refetchDataSource();
  }, [refetchDataSource]);

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<MileageSettlementListViewUrlDialog, MileageSettlementListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch: refetchDataSource,
  });

  return (
    <>
      <MileageSettlementListPage
        onUpdateListSettings={updateListSettings}
        settings={settings}
        params={params}
        urlType={currentUrlType}
        filterVariables={filterVariables}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        dataSource={dataSource}
        loading={tableLoading}
        refetch={refetchDataSource}
        ListNavigator={() => (
          <ListNavigator<MileageSettlementListViewUrlQueryParams, AdminMonthlySettlementUrlEnum>
            countOfStatus={countOfStatus}
            urlList={mileageSettlementUrlList}
            NavButtonName={getMileageSettlementNavButtonName}
          />
        )}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

