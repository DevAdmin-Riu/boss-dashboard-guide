  // 도서산간 추가 배송비 계산 (조건 로직 적용 전)
  const calculateDeliveryAdditionalFeeExcludeVat = (record: SalesList_sales_edges_node) => {
    const isFirstOrderLine = record.orderLine.subId === 1;
    const isByCourier = record.order.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER;
    if (isByCourier) {
      const isPickingOrder = record.orderLine.isPickingOrder;
      if (isPickingOrder) {
        // 합포장 상품 주문 내역인 경우, 도서산간 추가 배송비는 합포장 상자 수 * 도서산간 지역 추가 배송비를 첫 번째 주문 상품에만 표시
        const pickingOrderLines = record.order.lines.filter((line) => line.isPickingOrder);
        const isFirstPickingOrderLine = record.orderLine.id === pickingOrderLines[0].id;
        if (isFirstPickingOrderLine) {
          const pickingOrderBoxCnt = record.order.pickingInfo.boxes.length;
          return toPriceExcludeVat(record.order.unitDeliveryAdditionalFee * pickingOrderBoxCnt);
        }
        return 0;
      } else {
        // 일반 상품 주문이고 도서산간 추가 배송비 청구 상품 주문인 경우, 도서산간 추가 배송비는 상품별 추가 배송비 * 상품 수량으로 표시
        if (record.orderLine.needDeliveryAdditionalFee) {
          // 납품 시 금액 조정 상품인 경우에는 납품 수량이 변경되어도 원래 주문 수량을 입력:  2.5 -> 2.51 이 납품되어도 2박스로 증가되면 곤란
          const quantity = record.variant.isAdjustPrice ? record.orderLine.quantity : record.quantity;
          const deliveryBoxCount = getDeliveryBoxCountConsiderAdjustPricePv(record.variant, quantity);

          // 세트상품인 경우 다른 구성품의 배송 박스 수도 합산
          // 다른 구성품들은 isAdjustPrice가 아니라고 가정하고 quantity를 그대로 배송 박스 수로 사용
          let bundleOtherDeliveryBoxCount = 0;
          if (checkIsBundleProduct(record.bundleOtherSales)) {
            bundleOtherDeliveryBoxCount = record
              .bundleOtherSales!.filter((sale) => sale != null)
              .reduce((sum, sale) => sum + sale.quantity, 0);
          }

          return toPriceExcludeVat(
            record.order.unitDeliveryAdditionalFee * (deliveryBoxCount + bundleOtherDeliveryBoxCount)
          );
        }
        return 0;
      }
    } else {
      // 기타 배송(ex. 화물차 배송)인 경우, 도서산간 추가 배송비가 상품별이 아닌 한 주문 단위로 저장됨
      if (isFirstOrderLine) {
        return toPriceExcludeVat(record.order.subtotalDeliveryAdditionalFee);
      }
      return 0;
    }
  };

