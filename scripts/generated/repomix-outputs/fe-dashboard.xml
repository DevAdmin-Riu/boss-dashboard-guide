import { CheckOutlined } from "@ant-design/icons";
import { Card, Col, Modal, Row, Space, Typography } from "antd";
import React, { useState } from "react";

interface WarehouseSelectModalProps {
  open: boolean;
  warehouseOptions: Array<{ label: string; value: string }>;
  selectedWarehouseId?: string;
  onConfirm: (warehouseId: string) => void;
  onCancel?: () => void;
}

export const WarehouseSelectModal: React.FC<WarehouseSelectModalProps> = (props) => {
  const { open, warehouseOptions, selectedWarehouseId, onConfirm, onCancel } = props;
  const [tempSelectedId, setTempSelectedId] = useState<string>(selectedWarehouseId);

  const handleConfirm = () => {
    if (tempSelectedId) {
      onConfirm(tempSelectedId);
    }
  };

  const handleCardClick = (warehouseId: string) => {
    setTempSelectedId(warehouseId);
  };

  return (
    <Modal
      open={open}
      title="물류센터 선택"
      okText="확인"
      cancelText="취소"
      onOk={handleConfirm}
      onCancel={onCancel}
      closable={!!selectedWarehouseId}
      maskClosable={!!selectedWarehouseId}
      okButtonProps={{ disabled: !tempSelectedId }}
      width={600}
    >
      <Space direction="vertical" size="middle" style={{ width: "100%" }}>
        <Typography.Text type="secondary">검수 작업을 진행할 물류센터를 선택하세요</Typography.Text>
        <Row gutter={[16, 16]}>
          {warehouseOptions.map((warehouse) => {
            const isSelected = tempSelectedId === warehouse.value;
            return (
              <Col span={12} key={warehouse.value}>
