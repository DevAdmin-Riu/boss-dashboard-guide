<file path="src/app/views/brand/brands/views/NewBrandDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { useBrandDetailsQuery } from "@src/app/views/brand/brands/api/queries";
import { NewBrandDetailsPage } from "@src/app/views/brand/brands/components/NewBrandDetailsPage";
import BrandHqStaffCreateModal from "@src/app/views/brand/brandStore/components/BrandHqStaffCreateModal";
import BrandStoreCreateModal from "@src/app/views/brand/brandStore/components/BrandStoreCreateModal";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import { useBrandUpdateMutation, useHqStaffCreateMutation } from "../api/mutations";
import { BrandDetailsViewUrlQueryParams, brandsListViewUrl } from "../urls";

interface BrandDetailsViewProps {
  id: string;
  params: BrandDetailsViewUrlQueryParams;
}

enum BrandDetailsModalModeEnum {
  CreateBrandStore = "CreateBrandStore",
  CreateHqStaff = "CreateHqStaff",
}

export const NewBrandDetailsView: React.FC<BrandDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const { data: brandDetailsData, loading: brandDetailsLoading } = useBrandDetailsQuery({
    variables: {
      id,
    },
  });
  const handleBack = () => navigate(brandsListViewUrl());

  const brand = brandDetailsData?.brand;

  const [updateBrand, updateBrandOpts] = useBrandUpdateMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.brandUpdate.errors, "브랜드 정보가 수정되었습니다."),
  });

  const [hqStaffCreate, hqStaffCreateOpts] = useHqStaffCreateMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.hqStaffCreate.errors, "성공적으로 생성되었습니다."),
  });

  if (brand === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  if (brandDetailsLoading) {
    return <Loader />;
  }

  const loading = brandDetailsLoading || updateBrandOpts.loading || hqStaffCreateOpts.loading;

  return (
    <>
      <WindowTitle title={"브랜드 상세"} />
      <NewBrandDetailsPage
        brand={brand}
        loading={loading}
        onBack={handleBack}
        onSubmit={updateBrand}
        openBrandStoreCreateModal={() => setModalMode(BrandDetailsModalModeEnum.CreateBrandStore)}
        openHqStaffCreateModal={() => setModalMode(BrandDetailsModalModeEnum.CreateHqStaff)}
      />

      {modalMode === BrandDetailsModalModeEnum.CreateBrandStore && (
        <BrandStoreCreateModal
          brandId={brand.id}
          open={modalMode === BrandDetailsModalModeEnum.CreateBrandStore}
          onClose={resetForCloseModal}
        />
      )}
      {modalMode === BrandDetailsModalModeEnum.CreateHqStaff && (
        <BrandHqStaffCreateModal
          open={modalMode === BrandDetailsModalModeEnum.CreateHqStaff}
          onClose={resetForCloseModal}
          onCreate={hqStaffCreate}
          brandId={brand.id}
        />
      )}
    </>
  );
};
</file>

