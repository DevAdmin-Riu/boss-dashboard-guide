import useNavigator from "@hooks/useNavigator";
import DialogContentText from "@material-ui/core/DialogContentText";
import { ConfigurationItemInput } from "@src/api/types/globalTypes";
import ActionDialog from "@src/app/components/ActionDialog";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { usePluginUpdate } from "../api/mutations";
import { usePluginDetailsQuery } from "../api/queries";
import { Plugin_plugin_configuration } from "../api/types/Plugin";
import PluginsDetailsPage, { PluginDetailsPageFormData } from "../components/PluginsDetailsPage";
import PluginSecretFieldDialog from "../components/PluginSecretFieldDialog";
import {
  pluginDetailsViewUrl,
  PluginDetailsViewUrlDialog,
  PluginDetailsViewUrlQueryParams,
  pluginListViewUrl,
} from "../urls";
import { isSecretField } from "../utils";

interface PluginsDetailsViewProps {
  id: string;
  params: PluginDetailsViewUrlQueryParams;
}

function getConfigurationInput(
  config: Plugin_plugin_configuration[] | null,
  input: ConfigurationItemInput[] | null
): ConfigurationItemInput[] | null {
  if (config === null || input === null) {
    return null;
  }

  return input
    .filter((field) => !isSecretField(config, field.name))
    .map((field) => ({
      name: field.name,
      value: field.value.toString(),
    }));
}

export const PluginsDetailsView: React.FC<PluginsDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const [openModal, closeModal] = createDialogActionHandlers<
    PluginDetailsViewUrlDialog,
    PluginDetailsViewUrlQueryParams
  >(navigate, (params) => pluginDetailsViewUrl(id, params), params);

  const [updatePlugin, updatePluginOpts] = usePluginUpdate({
    onCompleted: (data) => {
      const errors = data.pluginUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const { data, loading } = usePluginDetailsQuery({
    variables: { id },
  });

  const formErrors = updatePluginOpts.data?.pluginUpdate.errors || [];

  const handleFieldUpdate = (value: string) =>
    updatePlugin({
      variables: {
        id,
        input: {
          configuration: [
            {
              name: params.id,
              value,
            },
          ],
        },
      },
    });

  const handleSubmit = async (formData: PluginDetailsPageFormData) => {
    const result = await updatePlugin({
      variables: {
        id,
        input: {
          active: formData.active,
          showInList: formData.showInList,
          configuration: getConfigurationInput(data.plugin.configuration, formData.configuration),
        },
      },
    });

    return result.data.pluginUpdate.errors;
  };

  return (
    <>
      <WindowTitle title={data?.plugin?.name} />
      <PluginsDetailsPage
        disabled={loading}
        errors={formErrors}
        saveButtonBarState={!params.action ? updatePluginOpts.status : "default"}
        plugin={data?.plugin}
        onBack={() => navigate(pluginListViewUrl())}
        onClear={(id) =>
          openModal("clear", {
            id,
          })
        }
        onEdit={(id) =>
          openModal("edit", {
            id,
          })
        }
        onSubmit={handleSubmit}
      />
      {data?.plugin?.configuration && (
        <>
          <ActionDialog
            confirmButtonState={!!params.action ? updatePluginOpts.status : "default"}
            onClose={closeModal}
            open={params.action === "clear" && !!params.id}
            title="Authorization Field Delete"
            onConfirm={() => handleFieldUpdate(null)}
          >
            <DialogContentText>
              The plugin may stop working after this field is cleared. Are you sure you want to proceed?
            </DialogContentText>
          </ActionDialog>
          <PluginSecretFieldDialog
            confirmButtonState={!!params.action ? updatePluginOpts.status : "default"}
            field={data?.plugin?.configuration.find((field) => field.name === params.id)}
            onClose={closeModal}
            onConfirm={(formData) => handleFieldUpdate(formData.value)}
            open={params.action === "edit" && !!params.id}
          />
        </>
      )}
    </>
  );
};
</file>

