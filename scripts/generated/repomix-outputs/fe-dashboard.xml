>(brandReverseFeeDepositEventsQuery, "no-cache");

export const hqScheduleListQuery = gql`
  ${scheduleFragment}
  query HqScheduleList($first: Int, $after: String, $last: Int, $before: String, $filter: ScheduleFilterInput) {
    schedules(before: $before, after: $after, first: $first, last: $last, filter: $filter) {
      edges {
        node {
          ...ScheduleFragment
        }
      }
      totalCount
    }
  }
`;
export const useHqScheduleListQuery = makeQuery<HqScheduleList, HqScheduleListVariables>(hqScheduleListQuery);
</file>

