interface TVariantForDepletionDate extends TVariantForAvailableQtyConsiderVirtualAlloc {
  last30DaysAvgSalesDailyQty?: number | null;
  qtyToBeStockedLongTerm?: number | null;
}

/**
 * 재고 소진까지 걸리는 일 수 계산
 * @param variant - 제품 변형 정보
 * @param purchaseQty - 발주 수량
 * @returns 소진까지 걸리는 일 수 (0 이하면 0 반환)
 */
export const calculateDaysUntilDepletion = (variant: TVariantForDepletionDate | null, purchaseQty: number): number => {
  const last30DaysAvgSalesDailyQty = variant?.last30DaysAvgSalesDailyQty || 0;
  if (last30DaysAvgSalesDailyQty <= 0) {
    return 0;
  }

  const availableQty = getAvailableQtyConsiderVirtualAlloc(variant) || 0;
  const qtyToBeStocked = variant?.qtyToBeStockedLongTerm || 0;
  const totalQty = availableQty + qtyToBeStocked + purchaseQty;

  return totalQty / last30DaysAvgSalesDailyQty;
};

/**
 * 예상 소진일 계산
 * @param variant - 제품 변형 정보
 * @param purchaseQty - 발주 수량
 * @param askingPurchaseDate - 납품 요청일
 * @param purchaseOrderDate - 발주일 (fallback)
 * @returns 포맷된 예상 소진일 문자열 (YYYY-MM-DD) 또는 "-"
 */
export const calculateEstimatedDepletionDate = (
  variant: TVariantForDepletionDate | null,
  purchaseQty: number,
  askingPurchaseDate: string | null,
  purchaseOrderDate?: string | null
): string => {
  const daysUntilDepletion = calculateDaysUntilDepletion(variant, purchaseQty);
  if (daysUntilDepletion <= 0) {
    return "-";
  }

  const askingDate = askingPurchaseDate
    ? moment(askingPurchaseDate)
    : purchaseOrderDate
    ? moment(purchaseOrderDate)
    : moment();
  const estimatedDepletionDate = askingDate.clone().add(daysUntilDepletion, "days");
  return estimatedDepletionDate.format(onlyDateFormat);
};
