import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import { PvEstimateStatusEnum } from "@src/api/types/globalTypes";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { useInitialProductFilterDataQuery } from "@src/app/views/product/products/api/queries";
import { PvEstimateAiListVariables } from "@src/app/views/requestProduct/api/types/PvEstimateAiList";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import { usePvEstimateBulkUpdateMutation } from "../../api/mutations";
import { pvEstimateAiListQuery, usePvEstimateAiListLazyQuery, usePvEstimateAiListQuery } from "../../api/queries";
import PvEstimateBulkCreateModal from "../../components/PvEstimatePage/PvEstimateBulkCreateModal";
import PvEstimatePage from "../../components/PvEstimatePage/PvEstimatePage";
import PvEstimateStatusChangeModal from "../../components/PvEstimatePage/PvEstimateStatusChangeModal";
import { pvEstimateListViewUrl, PvEstimateListViewUrlDialog, PvEstimateListViewUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface PvEstimateViewProps {
  // Define any props if needed
  params: PvEstimateListViewUrlQueryParams;
}

export enum PvEstimateViewModalModeEnum {
  BULK_STATUS_UPDATE = "BULK_STATUS_UPDATE",
  BULK_CREATE = "BULK_CREATE",
}

const PvEstimateView: React.FC<PvEstimateViewProps> = (props) => {
  const { params } = props;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.PV_ESTIMATE_LIST,
  });
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [modalMode, setModalMode] = useState<PvEstimateViewModalModeEnum>(null);
  const targetUrl: (params?: PvEstimateListViewUrlQueryParams) => string = pvEstimateListViewUrl;
  const { fetchForDownload } = utils.initListViewDownloadQuery(usePvEstimateAiListLazyQuery);

  const queryVariables: PvEstimateAiListVariables = React.useMemo(
    () => ({
      ...paginationState,
      query: "",
      filter: getFilterVariables(params),
    }),
    [params, settings?.rowNumber]
  );

  const { data, refetch, loading } = usePvEstimateAiListQuery({ initialListSkip: true, variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.pvEstimateAiList?.pageInfo,
    paginationState,
    params,
  });

  const [pvEstimateBulkUpdate, pvEstimateBulkUpdateOpts] = usePvEstimateBulkUpdateMutation({
    onCompleted: (data) => {
      const errors = data.pvEstimateBulkUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("견적 채택 상태가 업데이트 되었습니다.");
        modalClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [pvEstimateAiListQuery],
  });

  const { data: initialFilterData, loading: loadingFilterData } = useInitialProductFilterDataQuery({
    variables: {
      categories: params.categories,
    },
  });

  const searchCategories = useCategorySearch({ variables: { ...DEFAULT_INITIAL_SEARCH_DATA } });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<PvEstimateListViewUrlDialog, PvEstimateListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const showBulkStatusUpdateModal = () => setModalMode(PvEstimateViewModalModeEnum.BULK_STATUS_UPDATE);
  const showBulkCreateModal = () => setModalMode(PvEstimateViewModalModeEnum.BULK_CREATE);
  const modalClose = () => setModalMode(null);

  const pvEstimateList = maybe(() => data.pvEstimateAiList.edges.map((edge) => edge.node), []);
  const initialFilterCategories = maybe(() => initialFilterData.categories.edges.map((edge) => edge.node), []);
  const disabled = pvEstimateBulkUpdateOpts.loading || loading || loadingFilterData;
  const filterOpts = getFilterOpts(params, { initial: initialFilterCategories, search: searchCategories });
  return (
    <>
      <PvEstimatePage
        params={params}
        settings={settings}
        disabled={disabled}
        pvEstimateList={pvEstimateList}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        openModal={openModal}
        closeModal={closeModal}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        showBulkStatusUpdateModal={showBulkStatusUpdateModal}
        showBulkCreateModal={showBulkCreateModal}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <PvEstimateStatusChangeModal
        open={modalMode === PvEstimateViewModalModeEnum.BULK_STATUS_UPDATE}
        onClose={modalClose}
        loading={disabled}
        onOk={(status: PvEstimateStatusEnum) => {
          pvEstimateBulkUpdate({
            variables: {
              input: {
                details: pvEstimateList
                  .filter((pvEstimate) => selectedRowIds.includes(pvEstimate.id))
                  .map((pvEstimate) => ({
                    code: pvEstimate.code,
                    status,
                  })),
              },
            },
          });
        }}
      />
      <PvEstimateBulkCreateModal
        open={modalMode === PvEstimateViewModalModeEnum.BULK_CREATE}
        onClose={modalClose}
        loading={disabled}
      />
    </>
  );
};

export default PvEstimateView;
</file>

