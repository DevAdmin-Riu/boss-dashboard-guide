import { UnfulfilledOrderLineListView } from "./views/UnfulfilledOrderLineListView/UnfulfilledOrderLineListView";

const OrderListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const isAll = location.pathname === allOrderListViewPath;
  // @ts-ignore
  const params: OrderListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    OrderListViewUrlSortField,
    OrderListViewUrlSortField.number,
    false
  );
  if (location.pathname === orderListViewPathC) {
    params.orderType = OrderType.BY_STAFF_FOR_BAD_STOCK;
  } else if (location.pathname === orderListViewPathB) {
    params.orderType = OrderType.BY_STAFF_FOR_BRAND;
  } else {
    params.orderType = OrderType.BY_USER;
  }

  return <OrderListView params={params} isAll={isAll} />;
};

const RefundedListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: RefundedListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    RefundedListViewUrlSortField,
    RefundedListViewUrlSortField.refundedAt,
    false
  );
  if (location.pathname === refundedListViewPathC) {
    params.orderType = OrderType.BY_STAFF_FOR_BAD_STOCK;
  } else if (location.pathname === refundedListViewPathB) {
    params.orderType = OrderType.BY_STAFF_FOR_BRAND;
  } else {
    params.orderType = OrderType.BY_USER;
  }
  return <RefundedListView params={params} />;
};

const OrderLineListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getOrderLineListDefaultParams(location.pathname);
  const params: OrderLineListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <OrderLineListView defaultParams={defaultParams} params={params} isB2b={false} />;
};

const UnfulfilledOrderLineListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const defaultParams = getUnfulfilledOrderLineListDefaultParams(location.pathname);
  const params: UnfulfilledOrderLineListViewUrlQueryParams = { ...defaultParams, ...qs };

  return <UnfulfilledOrderLineListView defaultParams={defaultParams} params={params} />;
};

const OrderSalesListViewWrapper: React.FC<RouteComponentProps<OrderSalesListViewRouteParams>> = ({
  location,
  match,
}) => {
  const { viewType } = match.params;
  const { user } = useUser();
  const { isHqStaff } = user;
  if (isHqStaff && viewType !== "for-hq") {
    return <NotFound type={ErrorPageEnum.PermissionDenied} />;
  }

  const qs = parseQs(location.search.substr(1));
  const params: OrderSalesListViewUrlQueryParams = qs;

  return <OrderSalesListView params={params} />;
};

const OrderLineDetailListViewWrapper: React.FC<RouteComponentProps<any>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  // @ts-ignore
  const params: OrderLineDetailListViewUrlQueryParams = asSortParams(
    // @ts-ignore
    qs,
    OrderLineListViewUrlSortField,
    OrderLineListViewUrlSortField.number,
    false
  );

  const isAll = location.pathname === orderLineDetailListViewPathAll;
  if (location.pathname === orderLineDetailListViewPathD) {
    params.orderType = OrderType.BY_STAFF_FOR_ETC;
  } else if (location.pathname === orderLineDetailListViewPathC) {
    params.orderType = OrderType.BY_STAFF_FOR_BAD_STOCK;
