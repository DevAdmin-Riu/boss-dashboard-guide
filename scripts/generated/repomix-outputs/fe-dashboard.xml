import { formRuleMsg } from "@assets/messages/commonMsg";
import {
  PurchaseOrderLinesApproveReqEpdUpdateInput,
  PurchaseOrderLinesReqEpdUpdateDetailInput,
  PurchaseOrderLinesReqEpdUpdateInput,
} from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import { DateTime, onlyDateFormat } from "@src/app/providers/DateProvider";
import { OrderLineList_orderLines_edges_node_purchaseOrderLine } from "@src/app/views/order/orders/api/types/OrderLineList";
import { usePurchaseOrderLinesApproveReqEpdUpdateMutation } from "@src/app/views/purchase/purchaseOrders/api/mutations";
import {
  purchaseOrderLineCountQuery,
  purchaseOrderLineListQuery,
} from "@src/app/views/purchase/purchaseOrders/api/queries";
import { PurchaseOrderLineList_purchaseOrderLines_edges_node } from "@src/app/views/purchase/purchaseOrders/api/types/PurchaseOrderLineList";
import { makePurchaseOrderLineNumber } from "@src/app/views/purchase/purchaseOrders/utils";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Col, DatePicker, Form, Input, Modal, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import moment, { Moment } from "moment";
import React, { useEffect, useState } from "react";

import { usePurchaseOrderLinesReqEpdUpdateMutation } from "../../api/mutations";

interface VsPurchaseOrderLinesReqEpdUpdateModalProps {
  open: boolean;
  loading: boolean;
  isApproveMode: boolean;
  poLines: Array<
    PurchaseOrderLineList_purchaseOrderLines_edges_node | OrderLineList_orderLines_edges_node_purchaseOrderLine
  >;
  onCancel: (shouldReset: boolean) => void;
}

export const VsPurchaseOrderLinesReqEpdUpdateModal: React.FC<VsPurchaseOrderLinesReqEpdUpdateModalProps> = (props) => {
  const { open, loading, isApproveMode, poLines, onCancel } = props;
  const [tempEpdUpdate, setTempEpdUpdate] = useState<Moment>(null);
  const [tempSelectedRowKeys, setTempSelectedRowKeys] = useState<string[]>([]);
  const [form] = Form.useForm<PurchaseOrderLinesReqEpdUpdateInput>();

  const initialValues: PurchaseOrderLinesReqEpdUpdateInput = {
    details: poLines?.map((line) => ({
      poLineId: line.id,
      reqEpdUpdate: isApproveMode ? moment(line.reqEpdUpdate) : moment(line.expectedPurchaseDate),
    })),
    reason: null,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [purchaseOrderLinesApproveReqEpdUpdate, purchaseOrderLinesApproveReqEpdUpdateOpts] =
    usePurchaseOrderLinesApproveReqEpdUpdateMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLinesApproveReqEpdUpdate?.errors;
        if (errors?.length === 0) {
          showNotificationSuccess("선택한 발주제품의 납품변경일 변경을 승인 하였습니다.");
          onCancel(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
    });

  const [purchaseOrderLinesReqEpdUpdate, purchaseOrderLinesReqEpdUpdateOpts] =
    usePurchaseOrderLinesReqEpdUpdateMutation({
      onCompleted: (data) => {
        const errors = data.purchaseOrderLinesReqEpdUpdate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("선택한 발주 품목의 납품예정일 변경이 요청되었습니다.");
          onCancel(true);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
      refetchQueries: [purchaseOrderLineListQuery, purchaseOrderLineCountQuery],
    });

  const modalLoading =
    loading || purchaseOrderLinesReqEpdUpdateOpts.loading || purchaseOrderLinesApproveReqEpdUpdateOpts.loading;

  const onSubmit = (formData: PurchaseOrderLinesReqEpdUpdateInput) => {
    const { details, reason } = formData;
    const sameEpdPoLineNumberList = [];
    for (const detail of details) {
      const { poLineId } = detail;
      const reqEpdUpdate = detail?.reqEpdUpdate as Moment;
      const originPoLine = poLines.find((line) => line.id === poLineId);
      const originEpd = originPoLine.expectedPurchaseDate;
      if (reqEpdUpdate.isSame(originEpd, "day")) {
        sameEpdPoLineNumberList.push(makePurchaseOrderLineNumber(originPoLine));
      }
    }
    if (sameEpdPoLineNumberList.length > 0) {
      showNotificationError(
        <MultiLineTypography
          lines={[
            "기존과 동일한 납품 예정일로 변경 요청할 수 없습니다.",
            `발주상세번호: ${sameEpdPoLineNumberList.join(", ")}`,
          ]}
        />
      );
      return;
    }

    const formattedDetails: PurchaseOrderLinesReqEpdUpdateDetailInput[] = details.map((detail) => ({
      poLineId: detail.poLineId,
      reqEpdUpdate: moment(detail.reqEpdUpdate).format(onlyDateFormat),
    }));

    if (isApproveMode) {
      const input: PurchaseOrderLinesApproveReqEpdUpdateInput = { details: formattedDetails };
      purchaseOrderLinesApproveReqEpdUpdate({ variables: { input } });
    } else {
      const input: PurchaseOrderLinesReqEpdUpdateInput = { details: formattedDetails, reason };
      purchaseOrderLinesReqEpdUpdate({ variables: { input } });
    }
  };

  const disabledReqEpdUpdate = (current: Moment) => {
    if (!current) {
      return false;
    }
    // 오늘 이전 일자 선택 불가
    const isBeforeToday = current.isBefore(moment(), "day");
    return isBeforeToday;
  };

  const tableTitle = () => (
    <Row justify="space-between" align="middle">
      <Col>
        <Typography.Text strong>변경 요청 제품 리스트</Typography.Text>
      </Col>
      <Col>
        <Space.Compact>
          <DatePicker
            style={{ width: 180 }}
            disabledDate={disabledReqEpdUpdate}
            placeholder="납품예정일 일괄 설정"
            value={tempEpdUpdate}
            onChange={setTempEpdUpdate}
          />
          <Button
            type="primary"
            disabled={!tempEpdUpdate || tempEpdUpdate.isValid() === false || tempSelectedRowKeys.length === 0}
            onClick={() => {
              const detailsValues: PurchaseOrderLinesReqEpdUpdateDetailInput[] = form.getFieldValue("details");
              const updatedDetails = detailsValues.map((detail) => {
                const { poLineId } = detail;
                if (tempSelectedRowKeys.includes(poLineId)) {
                  return { ...detail, reqEpdUpdate: tempEpdUpdate };
                }
                return detail;
              });
              form.setFieldsValue({ details: updatedDetails });
            }}
          >
            적용
          </Button>
        </Space.Compact>
      </Col>
    </Row>
  );
  const columns: ColumnsType<PurchaseOrderLineList_purchaseOrderLines_edges_node> = [
    {
      title: columnNameConstant.purchaseOrder.PO_NO,
      key: "purchaseOrderNumber",
      align: "center",
      width: 120,
      render: (_, record) => record.purchaseOrder.code,
    },
    {
      title: columnNameConstant.purchaseOrder.PO_LINE_NO,
      key: "purchaseOrderLineNumber",
      align: "center",
      width: 150,
      render: (_, record) => makePurchaseOrderLineNumber(record),
    },
    {
      title: columnNameConstant.product.SKU,
      align: "center",
      key: "productSku",
      width: 120,
      render: (_, record) => record.productSku || "-",
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 200,
      render: (_, record) => record.productName || "-",
    },
    {
      title: columnNameConstant.purchaseOrder.PURCHASED_EXPECTED_DATE,
      align: "center",
      key: "expectedPurchaseDate",
      width: 120,
      render: (_, record) => <DateTime date={record.expectedPurchaseDate} onlyDate />,
    },
    isApproveMode && {
      title: "변경 사유",
      align: "left",
      key: "reqEpdUpdateReason",
      width: 140,
