export function getBrandProductListForTableSettings(props: BrandProductListForTableSettingsProps) {
  const { isFbv, navigate } = props;
  const columns: ColumnsType<TBpvForAssignedBrand> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "brandCode",
      align: "center",
      width: 100,
      render: (_, record) => record.brand.code,
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "brandName",
      width: 150,
      render: (_, record) => record.brand.name,
    },
    {
      title: columnNameConstant.brand.IS_RUNNING,
      key: "brandIsRunning",
      align: "center",
      width: 80,
      render: (_, record) => getBrandRunningTypeText(record.brand.isRunning),
    },
    {
      title: columnNameConstant.product.IS_EXCLUSIVE,
      key: "isExclusive",
      align: "center",
      width: 80,
      render: (_, record) => transformIsExclusive(record.isExclusive),
    },
    {
      title: columnNameConstant.brandProduct.SALE_STATUS,
      key: "salesStatus",
      align: "center",
      width: 80,
      render: (_, record) => {
        const { salesStatus } = record;
        const tagColor = salesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
