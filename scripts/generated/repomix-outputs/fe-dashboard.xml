import { excelTemplateVersion } from "@assets/excelTemplateVersion";
import { loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Form, Modal, Space, Typography } from "antd";
import React, { useRef, useState } from "react";

interface CourierDeliveryAdditionalFeeInput {
  pcodeStart: string;
  pcodeEnd: string;
  unitAdditionalFeeExcludeVat: number;
  streetAddress?: string;
}

interface DeliveryAdditionalFeeBulkResetModalProps {
  visible: boolean;
  loading: boolean;
  onSubmit: (details: CourierDeliveryAdditionalFeeInput[]) => void;
  onCancel: () => void;
}

export const DeliveryAdditionalFeeBulkResetModal: React.FC<DeliveryAdditionalFeeBulkResetModalProps> = ({
  visible,
  loading,
  onSubmit,
  onCancel,
}) => {
  const upload = useRef<HTMLInputElement>();
  const [form] = Form.useForm();
  const [selectedFile, setSelectedFile] = useState<string>();
  const [details, setDetails] = useState<CourierDeliveryAdditionalFeeInput[]>([]);

  const handleUploadButtonClick = () => upload.current.click();

  const onModalClose = () => {
    form.resetFields();
    setSelectedFile(undefined);
    setDetails([]);
    onCancel();
  };

  const validateDetails = (details: CourierDeliveryAdditionalFeeInput[]): boolean => {
    if (!details || details.length === 0) {
      showNotificationError("엑셀 데이터가 비어있습니다.");
      return false;
    }

    const errors: string[] = [];
    const seenRanges = new Set<string>();

    for (const detail of details) {
      // 필수 필드 체크
      if (utils.isEmpty(detail.pcodeStart, true)) {
        errors.push("우편번호 시작이 누락된 행이 있습니다.");
        break;
      }
      if (utils.isEmpty(detail.pcodeEnd, true)) {
        errors.push("우편번호 종료가 누락된 행이 있습니다.");
        break;
      }
      if (detail.unitAdditionalFeeExcludeVat === undefined || detail.unitAdditionalFeeExcludeVat < 0) {
        errors.push("추가 배송비가 누락되었거나 잘못된 값입니다.");
        break;
      }

      // 우편번호 형식 체크
      if (!/^\d{5}$/.test(detail.pcodeStart)) {
        errors.push(`우편번호 시작이 5자리 숫자가 아닙니다: ${detail.pcodeStart}`);
        break;
      }
      if (!/^\d{5}$/.test(detail.pcodeEnd)) {
        errors.push(`우편번호 종료가 5자리 숫자가 아닙니다: ${detail.pcodeEnd}`);
        break;
      }

      // 우편번호 범위 체크
      if (parseInt(detail.pcodeEnd, 10) < parseInt(detail.pcodeStart, 10)) {
        errors.push(`우편번호 종료가 시작보다 작습니다: ${detail.pcodeStart} - ${detail.pcodeEnd}`);
        break;
      }

      // 중복 체크
      const rangeKey = `${detail.pcodeStart}-${detail.pcodeEnd}`;
      if (seenRanges.has(rangeKey)) {
        errors.push(`중복된 우편번호 범위가 있습니다: ${rangeKey}`);
        break;
      }
      seenRanges.add(rangeKey);
    }

    if (errors.length > 0) {
      errors.forEach((error) => showNotificationError(error));
      return false;
    }

    return true;
  };

  const readUploadFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
    e.preventDefault();
    if (e.target.files) {
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const sheetName = worksheet.name;

        if (utils.validateTemplateVersion(sheetName, excelTemplateVersion.deliveryAdditionalFeeBulkReset) === false) {
          setSelectedFile(undefined);
          return;
        }

        const parsedDetails = parseWorksheetToJsonArr<any>({ worksheet });
        // 필드명 매핑 (엑셀 헤더 -> 실제 필드명)
        const mappedDetails = parsedDetails.map((detail) => ({
          pcodeStart: detail["우편번호 시작"] || detail.pcodeStart || detail.pcode_start,
          pcodeEnd: detail["우편번호 종료"] || detail.pcodeEnd || detail.pcode_end,
          unitAdditionalFeeExcludeVat:
            detail["추가 배송비 (VAT 제외)"] ||
            detail.unitAdditionalFeeExcludeVat ||
            detail.unit_additional_fee_exclude_vat,
          streetAddress: detail["지역"] || detail.streetAddress || detail.street_address || undefined,
        }));

        if (validateDetails(mappedDetails) === false) {
          setSelectedFile(undefined);
          return;
        }

        setDetails(mappedDetails);
        form.setFieldsValue({ details: mappedDetails });
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }
    if (upload.current) {
      upload.current.value = "";
    }
  };

  const handleSubmit = () => {
    if (details.length === 0) {
      showNotificationError("엑셀 파일을 먼저 업로드해주세요.");
      return;
    }
    onSubmit(details);
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="도서/산간 일괄 리셋"
      open={visible}
      cancelText="취소"
      okText="리셋"
      onOk={handleSubmit}
      onCancel={onModalClose}
      okButtonProps={{ disabled: details.length === 0 || loading, danger: true }}
      cancelButtonProps={{ disabled: loading }}
      maskClosable={false}
    >
      <Form form={form} layout="vertical" name="delivery-additional-fee-bulk-reset-form">
        <Space direction="vertical" size={0} style={{ width: "100%" }}>
          <Typography.Text type="danger">
            ⚠️ 도서산간 추가 배송비 정보를 수정할 경우, 배송비 정보가 새로 입력하는 데이터로 변경됩니다. 만약 누락된
            지역이 있을 경우, 해당 지역의 추가 배송비가 설정되지 않으므로 주의해야 합니다.
          </Typography.Text>
          <Form.Item name="details" rules={[{ required: true, message: "엑셀 파일을 선택해 주세요." }]}>
            <Space direction="vertical" size={0}>
              <Button onClick={handleUploadButtonClick} type="primary">
                엑셀 파일 선택
              </Button>
              {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
              <input
                hidden={true}
                id="deliveryAdditionalFeeBulkResetInputFile"
                onChange={(e) => readUploadFile(e)}
                type="file"
                ref={upload}
                accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
              />
            </Space>
          </Form.Item>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/settings/deliveryAdditionalFee/components/DeliveryAdditionalFeeFormModal/DeliveryAdditionalFeeFormModal.tsx">
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Form, Input, InputNumber, Modal } from "antd";
import React from "react";

interface CourierDeliveryAdditionalFee {
  id: string;
  pcodeStart: string;
  pcodeEnd: string;
  unitAdditionalFeeExcludeVat: number;
  streetAddress: string;
}

interface DeliveryAdditionalFeeFormModalProps {
  visible: boolean;
  loading: boolean;
  editingData: CourierDeliveryAdditionalFee | null;
  existingFees: CourierDeliveryAdditionalFee[];
  onSubmit: (values: {
    pcodeStart: string;
    pcodeEnd: string;
    unitAdditionalFeeExcludeVat: number;
    streetAddress?: string;
  }) => void;
  onCancel: () => void;
}

export const DeliveryAdditionalFeeFormModal: React.FC<DeliveryAdditionalFeeFormModalProps> = ({
  visible,
  loading,
  editingData,
  existingFees,
  onSubmit,
  onCancel,
}) => {
  const [form] = Form.useForm();

  const initialValues = editingData
    ? {
        pcodeStart: editingData.pcodeStart,
        pcodeEnd: editingData.pcodeEnd,
        unitAdditionalFeeExcludeVat: editingData.unitAdditionalFeeExcludeVat,
        streetAddress: editingData.streetAddress,
      }
    : undefined;

  // 우편번호 구간 중복 검사 함수
  const checkPostalCodeOverlap = (start: string, end: string): boolean => {
    const newStart = parseInt(start, 10);
    const newEnd = parseInt(end, 10);

    const feesToCheck = existingFees.filter((fee) => fee.id !== editingData?.id);

    return feesToCheck.some((fee) => {
      const existingStart = parseInt(fee.pcodeStart, 10);
      const existingEnd = parseInt(fee.pcodeEnd, 10);

      // 구간 중복 체크: 새 구간이 기존 구간과 겹치는지 확인
      return (
        (newStart >= existingStart && newStart <= existingEnd) ||
        (newEnd >= existingStart && newEnd <= existingEnd) ||
        (newStart <= existingStart && newEnd >= existingEnd)
      );
    });
  };

  const handleOk = () => {
    form
      .validateFields()
      .then((values) => {
        onSubmit(values);
      })
      .catch((info) => {
        const errorFields = info.errorFields;
        if (errorFields && errorFields.length > 0) {
          showNotificationError(errorFields[0].errors[0]);
        }
      });
  };

  const handleCancel = () => {
    onCancel();
  };

  return (
    <Modal
      title={editingData ? "추가요금 수정" : "추가요금 추가"}
      open={visible}
      onOk={handleOk}
      onCancel={handleCancel}
      confirmLoading={loading}
      okText={editingData ? "수정" : "추가"}
      cancelText="취소"
      destroyOnClose
    >
      <Form key={editingData?.id || "create"} form={form} layout="vertical" initialValues={initialValues}>
        <Form.Item
          name="pcodeStart"
          label="우편번호 시작"
          rules={[
            { required: true, message: "우편번호 시작을 입력해주세요" },
            { pattern: /^\d{5}$/, message: "5자리 숫자를 입력해주세요" },
            ({ getFieldValue }) => ({
              validator(_, value) {
                const pcodeStart = getFieldValue("pcodeStart");
                const pcodeEnd = getFieldValue("pcodeEnd");
                if (utils.isEmpty(value) || utils.isEmpty(pcodeEnd)) {
                  return Promise.resolve();
                }
                if (checkPostalCodeOverlap(value, pcodeStart)) {
                  return Promise.reject(new Error("입력한 우편번호 시작 구간이 기존 구간과 중복됩니다"));
                }
                return Promise.resolve();
              },
            }),
          ]}
        >
          <Input placeholder="예: 63000" maxLength={5} />
        </Form.Item>

        <Form.Item
          name="pcodeEnd"
          label="우편번호 종료"
          rules={[
            { required: true, message: "우편번호 종료를 입력해주세요" },
            { pattern: /^\d{5}$/, message: "5자리 숫자를 입력해주세요" },
            ({ getFieldValue }) => ({
              validator(_, value) {
                const pcodeStart = getFieldValue("pcodeStart");
                const pcodeEnd = getFieldValue("pcodeEnd");
                if (utils.isEmpty(value) || utils.isEmpty(pcodeStart)) {
                  return Promise.resolve();
                }
                if (parseInt(value, 10) < parseInt(pcodeStart, 10)) {
                  return Promise.reject(new Error("종료 우편번호는 시작 우편번호보다 크거나 같아야 합니다"));
                }
                if (checkPostalCodeOverlap(pcodeEnd, value)) {
                  return Promise.reject(new Error("입력한 우편번호 종료 구간이 기존 구간과 중복됩니다"));
                }
                return Promise.resolve();
              },
            }),
          ]}
        >
          <Input placeholder="예: 63644" maxLength={5} />
        </Form.Item>

        <Form.Item
          name="unitAdditionalFeeExcludeVat"
          label="추가 배송비 (VAT 제외)"
          rules={[
            { required: true, message: "추가 배송비를 입력해주세요" },
            { type: "number", min: 1, message: "0보다 큰 값을 입력해주세요" },
          ]}
        >
          <InputNumber
            placeholder="예: 3000"
            style={{ width: "100%" }}
            min={0}
            formatter={(value) => `${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ",")}
            parser={(value) => Number(value?.replace(/\$\s?|(,*)/g, "") || 0) as any}
            addonAfter="원"
          />
        </Form.Item>

        <Form.Item name="streetAddress" label="지역 (선택)">
          <Input placeholder="예: 울릉도" />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

