  if (status === "closing-statement" || status === "pending") {
    const defaultParams = getB2bSalesStatListDefaultParams(match.params);
    const params: B2bSalesStatListViewUrlQueryParams = { ...defaultParams, ...qs };
    return <B2bSalesStatListView defaultParams={defaultParams} params={params} />;
  } else if (status === "taxinvoice") {
    const params: B2bTaxInvoiceListViewUrlQueryParams = qs;
    return <B2bTaxInvoiceListView params={params} isB2b={true} />;
  } else {
    const defaultParams = getB2bSettlementListDefaultParams(match.params);
