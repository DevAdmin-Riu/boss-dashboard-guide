  extractYearFormat,
  getDateByFormat,
  onlyDateFormat,
} from "@src/app/providers/DateProvider/DateTime";
import { getBrandMdName } from "@src/app/views/brand/brands/utils";
import {
  getCategoryTypeText,
  getProductAttrQtyFromSimpleAttribute,
  makeProductQtyPerBoxTextFromSimpleAttribute,
  makeProductSpecTextFromSimpleAttribute,
} from "@src/app/views/product/products/utils/data";
import {
  calcBundleOtherCurrentCostPriceTotal,
  calcBundleOtherDeliveryFeeTotal,
  calcBundleOtherUnitCostPriceTotal,
  calcBundleOtherUnitPriceTotal,
  checkIsBundleProduct,
} from "@utils/bundle/bundleUtils";
import {
  calcTotalExcludeVatByUnitExcludeVatAndQty,
  toPriceExcludeVat,
  toPriceIncludeVat,
} from "@utils/excel/excelDownload";
import {
  getDeliveryBoxCountConsiderAdjustPricePv,
  makePaymentNumberFormat,
  transformIsExclusive,
  transformIsFBV,
  transformIsInner,
  transformTaxFree,
} from "@utils/misc";
import { makeTagFulfillmentType, makeTagFulfillmentTypeText } from "@utils/tags";
import { utils } from "@utils/utils";
import { Typography } from "antd";
import React from "react";

import { SalesList_sales_edges_node } from "../../api/types/SalesList";
import { OrderSalesListPageProps } from "./OrderSalesListPage";

export function getOrderSalesListTableSettings(props: Pick<OrderSalesListPageProps, "routeParams" | "onRowClick">) {
  // 직거래 상품 주문인 경우 다음 컬럼은 미노출: 반품배송비, 본부수익금, 실 결제금액, 직배송 여부
  const { routeParams, onRowClick } = props;
  const { viewType, fulfilledBy } = routeParams;
  const isOrderedByStaffForBadStock = viewType === "by-staff-for-bad-stock";

  const isFulfilledByVendor = fulfilledBy === "vendor";
  const fulfilledByVendorPrefix = isFulfilledByVendor ? "가맹본부" : "브랜드";

  // 배송비 조건 로직 - 주문 상태와 환불 여부에 따라 배송비 값을 조정
  const applyDeliveryFeeCondition = (fee: number, record: SalesList_sales_edges_node): number => {
    const salesType = record.type;
    const fulfillmentsLength = record.order?.fulfillments?.length || 0;
    const refundOrderType = salesType === SalesTypeEnum.REFUND;

    // 1. 환불 주문이고 fulfillment가 없는 경우: 음수로 표시
    if (refundOrderType && fulfillmentsLength === 0) {
      return fee * -1;
    }

    // 2. 환불 주문이지만 fulfillment가 있는 경우: 0으로 표시
    if (refundOrderType && fulfillmentsLength > 0) {
      return 0;
    }

    // 3. 환불 주문이 아닌 경우: 원래 값 표시
    return fee;
  };

  // 기타 배송비
  const getEtcDeliveryFee = (record: SalesList_sales_edges_node): number => {
    const etcDeliveryFee = record.orderLine.etcDeliveryFee;
    return applyDeliveryFeeCondition(etcDeliveryFee, record);
  };

  const orderComposedIdColumn: DownloadableColumnType<SalesList_sales_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_COMPOSED_ID,
    key: "orderComposedId",
    fixed: "left",
    width: 100,
    render: (_, record) => (
      <Typography.Link onClick={() => onRowClick(record.order.id)}>{record.order.composedIdWithPrefix}</Typography.Link>
    ),
    renderExcel: (record) => record.order.composedIdWithPrefix,
  };
  const orderLineComposedIdColumn: DownloadableColumnType<SalesList_sales_edges_node> = {
    align: "center",
    title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
    key: "orderLineComposedId",
    fixed: "left",
    width: 130,
    render: (_, record) => record.orderLine.composedIdWithPrefix,
  };
