    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<ReqFbvProductListViewUrlDialog, ReqFbvProductListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <ReqFbvProductListPage
        settings={settings}
        onUpdateListSettings={updateListSettings}
        loading={loading}
        requestFbvProducts={requestFbvProducts}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onRequest={() => navigate(hqReqFbvProductCreateViewUrl())}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        isStaff={isStaff}
        onRowClick={(id) => navigate(targetUrlForRowClick(id))}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};

export default ReqFbvProductListView;
</file>

<file path="src/app/views/requestProduct/views/ReqBossProductDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import {
  RequestBossProductBrandPriceInput,
  RequestBossProductChangeStatusInput,
  RequestBossProductImageCreateInput,
  RequestBossProductMallPriceInput,
  RequestBossProductStatusEnum,
  RequestBossProductUpdateInput,
} from "@src/api/types/globalTypes";
import { hqReqBossProductDetailsViewUrl, hqReqBossProductUrlList } from "@src/app/views/hqStaff/hqRequestProduct/urls";
import { IRootState } from "@src/global/redux/config/configStore";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import { findInEnum, maybe } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Modal } from "antd";
import React, { useState } from "react";
import { useSelector } from "react-redux";

import { AttributeSlugEnum } from "../../product/products/utils/data";
import { useAttributeDetailsQuery } from "../../settings/attributes/api/queries";
import {
  useRequestBossProductBrandPriceSetMutation,
  useRequestBossProductChangeStatusMutation,
  useRequestBossProductImageCreateMutation,
  useRequestBossProductImageDeleteMutation,
  useRequestBossProductMallPriceSetMutation,
  useRequestBossProductUpdateMutation,
} from "../api/mutations";
import { useRequestBossProductDetailsQuery } from "../api/queries";
import { ReqBossProductBrandPriceSetModal } from "../components/ReqBossProductBrandPriceSetModal";
import { ReqBossProductChangeStatusModal } from "../components/ReqBossProductChangeStatusModal";
import { ReqBossProductDetailsPage } from "../components/ReqBossProductDetailsPage";
import { ReqBossProductEstimateModal } from "../components/ReqBossProductEstimateModal";
import { ReqBossProductMallPriceSetModal } from "../components/ReqBossProductMallPriceSetModal";
import {
  reqBossProductDetailsViewUrl,
  ReqBossProductDetailsViewUrlDialog,
  ReqBossProductDetailsViewUrlQueryParams,
  ReqBossProductUrlEnum,
  reqBossProductUrlList,
} from "../urls";
import { getReqBossProductUrlEnumByStatus, getRequestBossProductStatusText } from "../utils";

interface ReqBossProductDetailsViewProps {
  id: string;
  params: ReqBossProductDetailsViewUrlQueryParams;
}

export const ReqBossProductDetailsView: React.FC<ReqBossProductDetailsViewProps> = (props) => {
  const { id, params } = props;
  const navigate = useNavigator();
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const [updateFormChanged, setUpdateFormChanged] = useState<boolean>(false);
  const updateBtnText = isHqStaff ? "재접수" : "저장";
  const isReqBossListPrevAll = useSelector<IRootState, boolean>((state) => state.common.isReqBossListPrevAll);
  const [selectedEstimateId, setSelectedEstimateId] = useState<string | null>(null);

  const [openModal, closeModal] = createDialogActionHandlers<
    ReqBossProductDetailsViewUrlDialog,
    ReqBossProductDetailsViewUrlQueryParams
  >(
    navigate,
    (params) => {
      if (isStaff) {
        return reqBossProductDetailsViewUrl(id, params);
      } else if (isHqStaff) {
        return hqReqBossProductDetailsViewUrl(id, params);
      }
    },
    params
  );

  const { data: boxSizeTypeData, loading: boxSizeTypeLoading } = useAttributeDetailsQuery({
    skip: !isStaff,
    variables: { slug: AttributeSlugEnum.boxSize },
  });

  const boxSizeTypeValues = maybe(() => boxSizeTypeData.attribute.values, []);

  const { data, loading } = useRequestBossProductDetailsQuery({ variables: { id } });
  const requestBossProduct = maybe(() => data?.requestBossProduct, null);

  const [requestBossProductUpdate, requestBossProductUpdateOpts] = useRequestBossProductUpdateMutation({
    onCompleted: (data) => {
      const errors = data.requestBossProductUpdate.errors;
      if (errors.length === 0) {
        if (isStaff) {
          showNotificationSuccess("상품 등록 요청 정보가 수정되었습니다.");
        } else if (isHqStaff) {
          showNotificationSuccess("[재접수]가 완료되었습니다.");
        }
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [requestBossProductChangeStatus, requestBossProductChangeStatusOpts] =
    useRequestBossProductChangeStatusMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductChangeStatus.errors;
        if (errors.length === 0) {
          const status = data.requestBossProductChangeStatus.requestBossProduct.status;
          const statusText = getRequestBossProductStatusText(findInEnum(status, RequestBossProductStatusEnum));
          showNotificationSuccess(`[${statusText}] 상태로 변경되었습니다.`);
          closeModal();
        } else {
          showGqlErrors(errors);
        }
      },
    });

  const [requestBossProductImageCreate, requestBossProductImageCreateOpts] = useRequestBossProductImageCreateMutation({
    onCompleted: (data) => {
      const errors = data.requestBossProductImageCreate.errors;
      if (errors.length === 0) {
        setUpdateFormChanged(true);
        showNotificationSuccess(
          `선택한 상품 이미지가 업로드되었습니다. 나머지 정보를 확인 후, [${updateBtnText}] 버튼을 눌러주세요.`
        );
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [requestBossProductImageDelete, requestBossProductImageDeleteOpts] = useRequestBossProductImageDeleteMutation({
    onCompleted: (data) => {
      const errors = data.requestBossProductImageDelete.errors;
      if (errors.length === 0) {
        setUpdateFormChanged(true);
        showNotificationSuccess(
          `선택한 상품 이미지가 삭제되었습니다. 나머지 정보를 확인 후, [${updateBtnText}] 버튼을 눌러주세요.`
        );
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [requestBossProductBrandPriceSet, requestBossProductBrandPriceSetOpts] =
    useRequestBossProductBrandPriceSetMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductBrandPriceSet.errors;
        if (errors.length === 0) {
          showNotificationSuccess("브랜드 판매가가 설정되었습니다.");
          closeModal();
          setSelectedEstimateId(null);
        } else {
          showGqlErrors(errors);
        }
      },
    });

  const [requestBossProductMallPriceSet, requestBossProductMallPriceSetOpts] =
    useRequestBossProductMallPriceSetMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductMallPriceSet.errors;
        if (errors.length === 0) {
          showNotificationSuccess("매장 판매가가 설정되었습니다.");
          closeModal();
        } else {
          showGqlErrors(errors);
        }
      },
    });

  if (utils.isEmpty(requestBossProduct)) {
    return null;
  }

  const handleUpdate = async (input: RequestBossProductUpdateInput): Promise<boolean> => {
    const { data } = await requestBossProductUpdate({ variables: { id: requestBossProduct.id, input } });
    const errors = data?.requestBossProductUpdate.errors || [];
    return errors.length === 0;
  };

  const handleStatusChange = (input: RequestBossProductChangeStatusInput) => {
    requestBossProductChangeStatus({ variables: { id: requestBossProduct.id, input } });
  };

  const handleImageCreate = (input: RequestBossProductImageCreateInput) => {
    if (utils.isEmpty(input.image, true)) {
      showNotificationError("선택한 상품 이미지 정보가 없습니다. 새로고침 후 다시 시도해주세요.");
      return;
    }
    if (requestBossProduct.images.length > 2) {
      showNotificationError("상품 이미지 등록은 최대 3개까지 가능합니다.");
      return;
    }
    requestBossProductImageCreate({ variables: { input } });
  };

  const handleImageDelete = (imageId: string) => {
    if (utils.isEmpty(imageId, true)) {
      showNotificationError("선택한 상품 이미지 정보가 없습니다. 새로고침 후 다시 시도해주세요.");
      return;
    }
    requestBossProductImageDelete({ variables: { id: imageId } });
  };

  const handleBrandPriceSet = (input: RequestBossProductBrandPriceInput) => {
    if (utils.isEmpty(requestBossProduct.estimateList, true)) {
      showNotificationError("요청한 상품의 견적 정보가 없습니다. 견적 정보를 작성 후 다시 시도해주세요.");
      return;
    }
    const { brandProductPriceExcludeVat, brandDeliveryFeeExcludeVat } = input;
    if (utils.isEmpty(brandProductPriceExcludeVat, true) || brandProductPriceExcludeVat <= 0) {
      showNotificationError("브랜드 상품가는 0원보다 큰 금액으로 입력해주세요.");
      return;
    }
    if (utils.isEmpty(brandDeliveryFeeExcludeVat, true) || brandDeliveryFeeExcludeVat < 0) {
      showNotificationError("브랜드 배송비는 최소 0원 이상 입력해주세요.");
      return;
    }
    requestBossProductBrandPriceSet({ variables: { id: selectedEstimateId, input } });
  };

  const handleMallPriceSet = (input: RequestBossProductMallPriceInput) => {
    if (utils.isEmpty(requestBossProduct, true)) {
      showNotificationError("상품의 요청 정보가 없습니다. 요청 정보를 작성 후 다시 시도해주세요.");
      return;
    }
    const { mallProductPriceExcludeVat } = input;
    if (utils.isEmpty(mallProductPriceExcludeVat, true) || mallProductPriceExcludeVat <= 0) {
      showNotificationError("매장 판매가는 0원보다 큰 금액으로 입력해주세요.");
      return;
    }
    requestBossProductMallPriceSet({
      variables: { id: requestBossProduct.id, input: { ...input, estimate: selectedEstimateId } },
    });
  };

  const requestStatus = requestBossProduct.status;
  const targetUrlEnum = isReqBossListPrevAll
    ? ReqBossProductUrlEnum.ALL
    : getReqBossProductUrlEnumByStatus(findInEnum(requestStatus, RequestBossProductStatusEnum));
  const targetUrlList = isStaff ? reqBossProductUrlList : isHqStaff ? hqReqBossProductUrlList : [];
  const targetUrlObj = targetUrlList.find((item) => item.urlEnum === targetUrlEnum);

  const handleBack = () => navigate(targetUrlObj?.fnUrl());

  const pageLoading =
    loading ||
    boxSizeTypeLoading ||
    requestBossProductUpdateOpts.loading ||
    requestBossProductChangeStatusOpts.loading ||
    requestBossProductImageCreateOpts.loading ||
    requestBossProductImageDeleteOpts.loading ||
    requestBossProductBrandPriceSetOpts.loading ||
    requestBossProductMallPriceSetOpts.loading;

  const selectedEstimate = requestBossProduct?.estimateList.find((item) => item.id === selectedEstimateId);

  return (
    <>
      <ReqBossProductDetailsPage
        params={params}
        loading={pageLoading}
        requestBossProduct={requestBossProduct}
        updateMutationStatus={requestBossProductUpdateOpts.status}
        updateBtnText={updateBtnText}
        updateFormChanged={updateFormChanged}
        setUpdateFormChanged={setUpdateFormChanged}
        openModal={openModal}
        onUpdate={handleUpdate}
        onStatusChange={handleStatusChange}
        onImageCreate={handleImageCreate}
        onBack={handleBack}
        setSelectedEstimateId={setSelectedEstimateId}
        selectedEstimateId={selectedEstimateId}
      />

      <ReqBossProductChangeStatusModal
        open={
          params.action === "change-status-req-md-supplement" ||
          params.action === "change-status-req-additional" ||
          params.action === "change-status-req-estimate-fix" ||
          params.action === "change-status-canceled" ||
          params.action === "change-status-completed"
        }
        loading={pageLoading}
        afterStatus={
          params.action === "change-status-req-md-supplement"
            ? RequestBossProductStatusEnum.ACCEPTED
            : params.action === "change-status-req-additional"
            ? RequestBossProductStatusEnum.REQ_ADDITIONAL
            : params.action === "change-status-req-estimate-fix"
            ? RequestBossProductStatusEnum.REQ_ESTIMATE_FIX
            : params.action === "change-status-canceled"
            ? RequestBossProductStatusEnum.CANCELED
            : params.action === "change-status-completed"
            ? RequestBossProductStatusEnum.COMPLETED
            : null
        }
        onStatusChange={handleStatusChange}
        onClose={closeModal}
      />
      <Modal
        destroyOnClose
        title="이미지 삭제"
        open={params.action === "delete-image"}
        onOk={() => handleImageDelete(params.id)}
        okText="삭제"
        okButtonProps={{ danger: true, type: "primary" }}
        onCancel={closeModal}
      >
        선택한 상품 이미지를 삭제하시겠습니까?
      </Modal>
      <ReqBossProductEstimateModal
        open={params.action === "create-estimate" || params.action === "update-estimate"}
        isCreateMode={params.action === "create-estimate"}
        loading={pageLoading}
        requestBossProduct={requestBossProduct}
        onClose={closeModal}
        boxSizeTypeValues={boxSizeTypeValues}
        selectedEstimate={selectedEstimate}
        setSelectedEstimateId={setSelectedEstimateId}
      />
      <ReqBossProductBrandPriceSetModal
        open={params.action === "set-brand-price"}
        loading={pageLoading}
        estimate={selectedEstimate}
        onSubmit={handleBrandPriceSet}
        onClose={closeModal}
      />
      <ReqBossProductMallPriceSetModal
        open={params.action === "set-mall-price"}
        loading={pageLoading}
        estimate={selectedEstimate}
        onSubmit={handleMallPriceSet}
        onClose={closeModal}
      />
    </>
  );
};
</file>

