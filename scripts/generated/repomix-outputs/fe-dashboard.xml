<file path="src/app/views/product/stock/components/RackLocationSyncModal.tsx">
import { RackLocationSyncDetails, RackLocationSyncInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { loadWorkbookByBuffer, parseWorksheetToJsonArr } from "@utils/excel/excelDownload";
import { destroyUploadingMessage, showNotificationError, showUploadingMessage } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Form, Modal, Space, Typography } from "antd";
import React, { useRef, useState } from "react";

import { useSyncRackLocationMutation } from "../api/mutations";
import { rackStockListQuery } from "../api/queries";

interface RackLocationSyncModalProps {
  open: boolean;
  loading: boolean;
  onClose: () => void;
}

export const RackLocationSyncModal: React.FC<RackLocationSyncModalProps> = (props) => {
  const { open, loading, onClose } = props;
  const upload = useRef<HTMLInputElement>();
  const [selectedFile, setSelectedFile] = useState<string>();
  const [errorExist, setErrorExist] = useState<boolean>(false);

  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<RackLocationSyncInput>(form);
  const formInstance = TypeSafeForm.formInstance;
  const initialValues: RackLocationSyncInput = { details: [] };
  const detailsWatched = TypeSafeForm.getUseFormWatched({ name: "details" });

  const [syncRackLocation, syncRackLocationOpts] = useSyncRackLocationMutation({
    onCompleted: (data) => {
      utils.handleOnCompletedWithError(data.syncRackLocation?.errors, "재고 현황 갱신이 완료되었습니다.", () => {
        onModalClose();
      });
    },
    refetchQueries: [rackStockListQuery],
  });
  const modalLoading = loading || syncRackLocationOpts.loading;

  const onModalClose = () => {
    formInstance.resetFields();
    setErrorExist(false);
    setSelectedFile(undefined);
    onClose();
  };

  const handleUploadButtonClick = () => upload.current.click();

  const validateDataIsNonNull = (details: RackLocationSyncDetails[]) => {
    if (details === undefined || details.length <= 0) {
      showNotificationError("재고 현황 갱신을 위한 엑셀데이터에 데이터가 없거나 양식 오류로 처리할 수 없습니다.");
      return false;
    }
    return true;
  };

  const validateSectorNameEmpty = (details: RackLocationSyncDetails[]) => {
    for (const detail of details) {
      const sectorName = detail.sectorName;
      if (utils.isEmpty(sectorName, true)) {
        showNotificationError("구역명이 지정되지 않은 셀이 존재합니다.");
        return false;
      }
      return true;
    }
  };

  const validateLocationNameEmpty = (details: RackLocationSyncDetails[]) => {
    for (const detail of details) {
      const locationName = detail.locationName;
      if (utils.isEmpty(locationName, true)) {
        showNotificationError("로케이션명이 지정되지 않은 셀이 존재합니다.");
        return false;
      }
      return true;
    }
  };

  const validateProductSkuEmpty = (details: RackLocationSyncDetails[]) => {
    for (const detail of details) {
      const productSku = detail.productSku;
      if (utils.isEmpty(productSku, true)) {
        showNotificationError("제품코드가 지정되지 않은 셀이 존재합니다.");
        return false;
      }
      return true;
    }
  };

  const makeCombineCode = (detail: RackLocationSyncDetails) => {
    const sectorName = detail.sectorName;
    const locationName = detail.locationName;
    const sku = detail.productSku;
    return `${sectorName}:${locationName}:${sku}`;
  };

  const validateValueEmpty = (details: RackLocationSyncDetails[]) => {
    const canPickingErrors = [];
    const canStockErrors = [];
    const quantityErrors = [];
    const safetyPickingStockErrors = [];

    for (const detail of details) {
      const canPicking = detail.canPicking;
      const canStock = detail.canStock;
      const quantity = detail.quantity;
      const safetyPickingStock = detail?.safetyPickingStock;
      const combineCode = makeCombineCode(detail);

      if (utils.isEmpty(canPicking)) {
        canPickingErrors.push(combineCode);
      }
      if (utils.isEmpty(canStock)) {
        canStockErrors.push(combineCode);
      }
      if (utils.isEmpty(quantity) || quantity < 0) {
        quantityErrors.push(combineCode);
      }
      // 기준 재고는 필수 X. 단, 값이 있을 경우 0 이상이어야 함.
      if (!utils.isEmpty(safetyPickingStock) && quantity < 0) {
        safetyPickingStockErrors.push(combineCode);
      }
    }

    const isOk =
      canPickingErrors.length <= 0 &&
      canStockErrors.length <= 0 &&
      quantityErrors.length <= 0 &&
      safetyPickingStockErrors.length <= 0;

    if (!isOk) {
      if (canPickingErrors.length > 0) {
        const errorMsg = (
          <>
            피킹 가능 오류 (구역:로케이션:제품코드):
            <br />
            {canPickingErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
      if (canStockErrors.length > 0) {
        const errorMsg = (
          <>
            입고 가능 오류 (구역:로케이션:제품코드):
            <br />
            {canStockErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
      if (quantityErrors.length > 0) {
        const errorMsg = (
          <>
            재고수량 오류 (구역:로케이션:제품코드):
            <br />
            {quantityErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
      if (safetyPickingStockErrors.length > 0) {
        const errorMsg = (
          <>
            피킹 로케이션 기준 재고수량 오류 (구역:로케이션:제품코드):
            <br />
            {safetyPickingStockErrors.join(", ")}
          </>
        );
        showNotificationError(errorMsg);
      }
    }
    return isOk;
  };

  const readUploadFile = async (e) => {
    e.preventDefault();
    if (e.target.files) {
      setErrorExist(false);
      setSelectedFile(e.target.files[0].name);
      const reader = new FileReader();
      reader.onload = async (e) => {
        const data = e.target.result;
        const workbook = await loadWorkbookByBuffer(data as ArrayBuffer);
        const worksheet = workbook.worksheets[0];
        if (!worksheet) {
          showNotificationError("엑셀 파일에 시트가 존재하지 않습니다.");
          return;
        }
        const details = parseWorksheetToJsonArr<RackLocationSyncDetails>({ worksheet });

        if (validateDataIsNonNull(details) === false) {
          setSelectedFile(undefined);
          setErrorExist(true);
          return;
        }

        // 로케이션 별 재고 다운로드 시 추가된 컬럼이 존재하지만, 업로드 시에는 해당 컬럼을 사용하지 않으므로 input에 필요한 컬럼만 추출
        const detailsInput: RackLocationSyncDetails[] = details.map((detail) => ({
          sectorName: detail.sectorName,
          locationName: detail.locationName,
          canPicking: detail.canPicking,
          canStock: detail.canStock,
          productSku: detail.productSku,
          quantity: detail.quantity,
          safetyPickingStock: detail.safetyPickingStock,
        }));
        TypeSafeForm.setFields([{ name: "details", value: detailsInput }]);
      };
      reader.readAsArrayBuffer(e.target.files[0]);
    }

    if (upload.current) {
      upload.current.value = "";
    }
  };

  const onSubmit = (rackLocationSyncInput: RackLocationSyncInput) => {
    const handleErrorCatch = (e: any) => {
      showNotificationError("에러가 발생하였습니다");
      throw e;
    };

    showUploadingMessage();
    const { details } = rackLocationSyncInput;

    const validateAry = [];
    validateAry.push(validateSectorNameEmpty(details));
    validateAry.push(validateLocationNameEmpty(details));
    validateAry.push(validateProductSkuEmpty(details));
    validateAry.push(validateValueEmpty(details));

    if (validateAry.findIndex((v) => v === false) >= 0) {
      setSelectedFile(undefined);
      setErrorExist(true);
      destroyUploadingMessage();
      return;
    }

    syncRackLocation({ variables: { input: rackLocationSyncInput } })
      .catch(handleErrorCatch)
      .finally(destroyUploadingMessage);
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      title="재고 현황 갱신"
      open={open}
      cancelText="뒤로"
      okText="확인"
      onOk={formInstance.submit}
      onCancel={onModalClose}
      okButtonProps={{ disabled: utils.isEmpty(detailsWatched) || modalLoading }}
      cancelButtonProps={{ disabled: modalLoading }}
    >
      <Form
        form={formInstance}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="vertical"
        name="rack-location-sync-form"
        onFinish={onSubmit}
      >
        <Form.Item
          name="details"
          label="재고 현황 갱신 정보"
          rules={[{ required: true, message: "재고 현황 갱신 적용할 엑셀 파일을 선택해 주세요." }]}
        >
          <Space direction="vertical" size={0}>
            <Button onClick={handleUploadButtonClick} type="primary">
              재고 현황 갱신 엑셀파일 선택
            </Button>
            {selectedFile && <Typography.Text type="success">선택된 파일명: {selectedFile}</Typography.Text>}
            {errorExist && <Typography.Text type="warning">엑셀 파일을 다시 선택해 주세요.</Typography.Text>}
            <input
              hidden={true}
              id="rackLocationSyncInputFile"
              onChange={(e) => readUploadFile(e)}
              type="file"
              ref={upload}
              accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
            />
          </Space>
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/RackSectorAddOrUpdateModal.tsx">
import { RackSectorInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { WarehouseDetails_warehouse_addresses } from "@src/app/views/settings/warehouses/api/types/WarehouseDetails";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Select } from "antd";
import React, { useEffect } from "react";

import { RackSectorList_rackSectors_edges_node } from "../api/types/RackSectorList";

interface RackSectorAddOrUpdateModalProps {
  open: boolean;
  loading: boolean;
  isUpdateMode: boolean;
  rackSector?: RackSectorList_rackSectors_edges_node;
  warehouseAddresses?: WarehouseDetails_warehouse_addresses[];
  onSubmit: (rackSectorInput: RackSectorInput) => void;
  onClose: () => void;
}

export const RackSectorAddOrUpdateModal: React.FC<RackSectorAddOrUpdateModalProps> = (props) => {
  const { open, loading, isUpdateMode, rackSector, warehouseAddresses, onSubmit, onClose } = props;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<RackSectorInput>(form);
  const formInstance = TypeSafeForm.formInstance;
  const nameWatcher = TypeSafeForm.getUseWatcherParams({ name: "name" });
  const nameWatched = Form.useWatch(nameWatcher.namePath, nameWatcher.formInstance);

  const initialValues: RackSectorInput = React.useMemo(() => {
    if (isUpdateMode && rackSector) {
      return {
        name: rackSector.name,
        address: rackSector.address?.id,
      };
    }
    return { name: "", address: null };
  }, [isUpdateMode, rackSector]);

  useEffect(() => {
    if (open) {
      if (isUpdateMode && rackSector) {
        formInstance.setFieldsValue({
          name: rackSector.name,
          address: rackSector.address?.id || null,
        });
      } else {
        formInstance.resetFields();
      }
    }
  }, [open, formInstance, isUpdateMode, rackSector]);

  const modalTitle = isUpdateMode ? "구역 수정" : "구역 추가";
  const okText = isUpdateMode ? "수정" : "추가";

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      open={open}
      title={modalTitle}
      cancelText="닫기"
      okText={okText}
      onOk={formInstance.submit}
      onCancel={onClose}
      okButtonProps={{ disabled: utils.isEmpty(nameWatched) || loading }}
      cancelButtonProps={{ disabled: loading }}
    >
      <Form
        form={formInstance}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="vertical"
        name="rack-sector-add-form"
        onFinish={onSubmit}
      >
        <Form.Item name="name" label="구역 이름" rules={[{ required: true, message: "구역 이름을 입력해 주세요." }]}>
          <Input />
        </Form.Item>
        <Form.Item name="address" label="물류센터" rules={[{ required: true, message: "물류센터를 선택해 주세요." }]}>
          <Select placeholder="물류센터를 선택하세요">
            {warehouseAddresses?.map((addr) => (
              <Select.Option key={addr.id} value={addr.id}>
                {addr.companyName || "-"} ({addr.streetAddress1})
              </Select.Option>
            ))}
          </Select>
        </Form.Item>
      </Form>
    </Modal>
  );
};
