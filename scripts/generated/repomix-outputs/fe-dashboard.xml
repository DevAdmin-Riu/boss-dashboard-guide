import { FetchResult } from "@apollo/client";
import {
  ExtendedProductUpdateAdditionalInput,
  ProductToBeChangedInfoCreateInput,
  ProductVariantInput,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { utils } from "@utils/utils";
import { Card, Form } from "antd";
import React, { useEffect, useState } from "react";

import { ExtendedProductUpdate } from "../../api/types/ExtendedProductUpdate";
import { ProductDetails_product_outerVariants } from "../../api/types/ProductDetails";
import { productVariantManageEventTypeChoices } from "../../utils/data";
import { ProductUpdateData } from "../ProductUpdatePage/form";
import { ProductVariantUpdateData } from "../ProductVariantUpdatePage/form";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "../PvOrBpvManageEventModal";
import { getPvBaseSellPriceTableSettings } from "./PvBaseSellPriceTableSettings";

export type TPvBaseSellPriceFormData = Pick<
  ProductVariantInput,
  | "baseSellPriceExcludeVat"
  | "baseSellPriceSetDate"
  | "marketLowestPriceExcludeVat"
  | "marketLowestPriceSetDate"
  | "marketLowestPriceSource"
  | "innerBaseSellPriceExcludeVat"
  | "innerBaseSellPriceSetDate"
  | "innerMarketLowestPriceExcludeVat"
  | "innerMarketLowestPriceSetDate"
  | "innerMarketLowestPriceSource"
>;
export type TVariantForBaseSellPriceCard = Pick<
  ProductDetails_product_outerVariants,
  | "id"
  | "sku"
  | "isInner"
  | "baseSellPriceExcludeVat"
  | "baseSellPriceSetDate"
  | "marketLowestPriceExcludeVat"
  | "marketLowestPriceSetDate"
  | "marketLowestPriceSource"
>;
type TOuterVariantForBaseSellPriceCard = TVariantForBaseSellPriceCard & {
  inner: TVariantForBaseSellPriceCard;
};

interface PvBaseSellPriceCardProps {
  data: ProductUpdateData | ProductVariantUpdateData;
  productVariant: TOuterVariantForBaseSellPriceCard;
  disabled: boolean;
  onVariantUpdate: (
    variantId: string,
    productVariantInput: ProductVariantInput,
    additionalInput: ExtendedProductUpdateAdditionalInput,
    productToBeChangedInfoCreateInput: ProductToBeChangedInfoCreateInput
  ) => Promise<FetchResult<ExtendedProductUpdate>>;
}

export const PvBaseSellPriceCard: React.FC<PvBaseSellPriceCardProps> = (props) => {
  const { data, productVariant, disabled, onVariantUpdate } = props;
  const [form] = Form.useForm<TPvBaseSellPriceFormData>();
  const TypeSafeForm = getTypeSafeForm<TPvBaseSellPriceFormData>(form);
  const [isEditMode, setIsEditMode] = useState(false);
  const [dataSource, setDataSource] = useState<TVariantForBaseSellPriceCard[]>([]);
  const [manageEventModalOpen, setManageEventModalOpen] = useState<boolean>(false);

  const onEdit = () => {
    setIsEditMode(true);
  };
  const onEditCancel = () => {
    form.resetFields();
    setIsEditMode(false);
  };

  const { canSaleByInner } = data;
  const innerVariant = productVariant?.inner;

  const initialValues: TPvBaseSellPriceFormData = {
    baseSellPriceExcludeVat: productVariant?.baseSellPriceExcludeVat,
    baseSellPriceSetDate: productVariant?.baseSellPriceSetDate,
    marketLowestPriceExcludeVat: productVariant?.marketLowestPriceExcludeVat,
    marketLowestPriceSetDate: productVariant?.marketLowestPriceSetDate,
    marketLowestPriceSource: productVariant?.marketLowestPriceSource,
    innerBaseSellPriceExcludeVat: innerVariant?.baseSellPriceExcludeVat,
    innerBaseSellPriceSetDate: innerVariant?.baseSellPriceSetDate,
    innerMarketLowestPriceExcludeVat: innerVariant?.marketLowestPriceExcludeVat,
    innerMarketLowestPriceSetDate: innerVariant?.marketLowestPriceSetDate,
    innerMarketLowestPriceSource: innerVariant?.marketLowestPriceSource,
  };

  useEffect(() => {
    const newDataSource: TVariantForBaseSellPriceCard[] = [{ ...productVariant }];
    if (canSaleByInner) {
      newDataSource.push(innerVariant);
    }
    setDataSource(newDataSource);
  }, [canSaleByInner]);

  const onSubmit = ({ manageEvent }: ProductVariantManageEventModalForm) => {
    const formData = form.getFieldsValue();
    const additionalInput: ExtendedProductUpdateAdditionalInput = {
      manageEvent: manageEvent as ProductVariantManageEventInput,
    };
    onVariantUpdate(productVariant.id, formData, additionalInput, undefined).then((res) => {
      const errors = res?.data?.extendedProductUpdate?.errors;
      if (errors?.length === 0) {
        onEditCancel();
        setManageEventModalOpen(false);
      }
    });
  };

  const columns = getPvBaseSellPriceTableSettings({ TypeSafeForm, isEditMode });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Form
      name="base-selling-price-update"
      form={form}
      disabled={disabled}
      initialValues={initialValues}
      component={false}
      onFinish={() => setManageEventModalOpen(true)}
    >
      <Card
        title={<CardTitleAntd title="기준 판매가" />}
        extra={<FormSaveButton form={form} isEditMode={isEditMode} onEdit={onEdit} onCancel={onEditCancel} />}
        bodyStyle={{ padding: 0 }}
      >
        <PatchedColumnsTable
          {...commonTableProps}
          title={() => <TableVatLegend isIncludeVat={false} size="small" />}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
      <ProductVariantManageEventModal
        isCreateMode
        open={manageEventModalOpen}
        loading={disabled}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_BASE_SELL_PRICE}
        choices={productVariantManageEventTypeChoices}
        onSubmit={onSubmit}
        onCancel={() => setManageEventModalOpen(false)}
      />
    </Form>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductPricing/PvBaseSellPriceTableSettings.tsx">
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { FieldPath } from "@src/app/components/antd/types/GenericFieldPath";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import EditableField from "@src/app/components/EditableField/EditableField";
import { TextWithLink } from "@src/app/components/TextWithLink";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { transformIsInner } from "@utils/misc";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { TPvBaseSellPriceFormData, TVariantForBaseSellPriceCard } from "./PvBaseSellPriceCard";

interface PvBaseSellPriceTableSettingsProps {
  TypeSafeForm: TypeSafeForm<TPvBaseSellPriceFormData>;
  isEditMode: boolean;
}

export const getPvBaseSellPriceTableSettings = (props: PvBaseSellPriceTableSettingsProps) => {
  const { TypeSafeForm, isEditMode } = props;

  const columns: ColumnsType<TVariantForBaseSellPriceCard> = [
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => record.sku,
    },
    {
      title: columnNameConstant.product.IS_INNER,
      key: "isInner",
      align: "center",
      width: 100,
      render: (_, record) => transformIsInner(record.isInner),
    },
    {
      title: columnNameConstant.product.BASE_SELL_PRICE,
      children: [
        {
          title: columnNameConstant.product.BASE_SELL_PRICE,
          key: "baseSellPriceExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => {
            const fieldName: FieldPath<TPvBaseSellPriceFormData> = record.isInner
              ? "innerBaseSellPriceExcludeVat"
              : "baseSellPriceExcludeVat";

            return (
              <EditableField
                noStyle
                type="number"
                name={fieldName}
                value={TypeSafeForm.getFieldValue(fieldName)}
                editMode={isEditMode}
              />
            );
          },
        },
        {
          title: columnNameConstant.common.SET_DATE,
          key: "baseSellPriceSetDate",
          align: "center",
          width: 120,
          render: (_, record) => {
            const fieldName: FieldPath<TPvBaseSellPriceFormData> = record.isInner
              ? "innerBaseSellPriceSetDate"
              : "baseSellPriceSetDate";

            return (
              <EditableField
                noStyle
                type="datepicker"
                name={fieldName}
                value={TypeSafeForm.getFieldValue(fieldName)}
                formDateFormat={onlyDateFormat}
                editMode={isEditMode}
              />
            );
          },
        },
      ],
    },
    {
      title: columnNameConstant.product.MARKET_LOWEST_PRICE,
      children: [
        {
          title: columnNameConstant.product.MARKET_LOWEST_PRICE,
          key: "marketLowestPriceExcludeVat",
          align: "right",
          width: 120,
          render: (_, record) => {
