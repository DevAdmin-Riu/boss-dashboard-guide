import {
  OrderChargeStatusFilter,
  OrderDeliveryStatusFilter,
  OrderFilterInput,
  OrderPayMethodFilter,
  OrderType,
  OrderTypeEnum,
} from "@src/api/types/globalTypes";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { OrderFilterKeys, OrderListFilterOpts } from "@src/app/views/order/orders/components/OrderListPage/filters";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { IFilterElement } from "../../../../../components/Filter";
import {
  OrderListViewUrlFilters,
  OrderListViewUrlFiltersEnum,
  OrderListViewUrlFiltersWithMultipleValuesEnum,
  OrderListViewUrlQueryParams,
} from "../../urls";
import { convertOrderTypeToEnum } from "../../utils";

const ORDER_FILTERS_KEY = "orderFilters";

export function getFilterOpts(params: OrderListViewUrlFilters, isAll: boolean): OrderListFilterOpts {
  const filterVariables = getFilterVariables(params, isAll);
  const todayMoment = moment();

  const getDefaultTypeValue = () => {
    if (params.orderType === OrderType.BY_STAFF_FOR_BRAND) {
      return [OrderTypeEnum.BY_STAFF_FOR_BRAND, OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND];
    }
    return [OrderTypeEnum.BY_USER];
  };

  return {
    orderSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.orderSearch), false),
      value: maybe(() => filterVariables.orderSearch, ""),
    },
    paymentSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.paymentSearch), false),
      value: maybe(() => filterVariables.paymentSearch, ""),
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    capturedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.capturedAt.gte, filterVariables.capturedAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.capturedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.capturedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    brandStoreSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandStoreSearch), false),
      value: maybe(() => filterVariables.brandStoreSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    creatorUserSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.creatorUserSearch, true), false),
      value: maybe(() => filterVariables.creatorUserSearch, ""),
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(
        () => dedupeFilter(filterVariables.type.map((typeStatus) => findValueInEnum(typeStatus, OrderTypeEnum))),
        getDefaultTypeValue()
      ),
    },
    chargeStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.chargeStatus), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.chargeStatus.map((chargeStatus) => findValueInEnum(chargeStatus, OrderChargeStatusFilter))
          ),
        [OrderChargeStatusFilter.PENDING]
      ),
    },
    deliveryStatus: {
      active: maybe(() => !utils.isEmpty(filterVariables.deliveryStatus), false),
      value: maybe(
        () =>
          dedupeFilter(
            filterVariables.deliveryStatus.map((deliveryStatus) =>
              findValueInEnum(deliveryStatus, OrderDeliveryStatusFilter)
            )
          ),
        [OrderDeliveryStatusFilter.BEFORE_DELIVERY]
      ),
    },
    payMethod: {
      active: maybe(() => !utils.isEmpty(filterVariables.payMethod), false),
      value: maybe(
        () =>
          dedupeFilter(filterVariables.payMethod.map((payMethod) => findValueInEnum(payMethod, OrderPayMethodFilter))),
        []
      ),
    },
  };
}

export const getOrderTypeEnums = (orderType: OrderType): OrderTypeEnum[] => {
  const orderTypeEnum = [];
  switch (orderType) {
    case OrderType.BY_USER:
      orderTypeEnum.push(convertOrderTypeToEnum(orderType));
      break;
    case OrderType.BY_STAFF_FOR_BRAND:
      // MD 대행 + 가맹본부 대행 모두 포함
      orderTypeEnum.push(OrderTypeEnum.BY_STAFF_FOR_BRAND);
      orderTypeEnum.push(OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND);
      break;
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
    case OrderType.BY_STAFF_FOR_ETC:
      orderTypeEnum.push(convertOrderTypeToEnum(orderType));
      break;
    default:
      break;
  }
  return orderTypeEnum;
};

export function getFilterVariables(params: OrderListViewUrlFilters, isAll: boolean): OrderFilterInput {
  const orderTypeEnums = getOrderTypeEnums(params.orderType);

  // 대행주문 페이지에서는 사용자가 필터로 선택한 type 값을 사용
  const getTypeFilter = () => {
    if (isAll) {
      // 전체 주문 페이지: 필터 값이 있으면 사용, 없으면 모든 타입 포함
      return params.type && params.type.length > 0
        ? params.type.map((status) => findInEnum(status, OrderTypeEnum))
        : [
            OrderTypeEnum.BY_USER,
            OrderTypeEnum.BY_STAFF_FOR_BRAND,
            OrderTypeEnum.BY_HQ_STAFF_FOR_BRAND,
            OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK,
            OrderTypeEnum.BY_STAFF_FOR_ETC,
          ];
    }
    if (params.orderType === OrderType.BY_STAFF_FOR_BRAND && params.type && params.type.length > 0) {
      return params.type.map((status) => findInEnum(status, OrderTypeEnum));
    }
    return orderTypeEnums;
  };

  const filterVariables: OrderFilterInput = {
    brands: params.brands !== undefined ? params.brands : [],
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    capturedAt: getGteLteVariables({
      gte: params.capturedAtFrom,
      lte: params.capturedAtTo,
    }),
    orderSearch: params.orderSearch,
    paymentSearch: params.paymentSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
    userSearch: params.userSearch,
    productSearch: params.productSearch,
    creatorUserSearch: params.creatorUserSearch,
    chargeStatus: maybe(() => params.chargeStatus.map((status) => findInEnum(status, OrderChargeStatusFilter))),
    deliveryStatus: maybe(() => params.deliveryStatus.map((status) => findInEnum(status, OrderDeliveryStatusFilter))),
    payMethod: maybe(() => params.payMethod.map((status) => findInEnum(status, OrderPayMethodFilter))),
    // params로 전달되는 인자 중 type, orderType은 모두 주문 방식을 의미
    // 단, type은 전체 주문 리스트에서 사용자가 필터로 입력한 값, orderType은 페이지 url에 의해 고정되어 전달되는 값
    // 대행주문 페이지에서는 사용자가 선택한 type 필터 값을 사용 (MD 대행 / 가맹본부 대행 선택 가능)
    type: getTypeFilter(),
  };

  return filterVariables;
}

export function getFilterQueryParam(filter: IFilterElement<OrderFilterKeys>): OrderListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case OrderFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.orderSearch);

    case OrderFilterKeys.paymentSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.paymentSearch);
    case OrderFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        OrderListViewUrlFiltersEnum.createdFrom,
        OrderListViewUrlFiltersEnum.createdTo
      );
    case OrderFilterKeys.capturedAt:
      return getMinMaxQueryParam(
        filter,
        OrderListViewUrlFiltersEnum.capturedAtFrom,
        OrderListViewUrlFiltersEnum.capturedAtTo
      );
    case OrderFilterKeys.type:
      return getMultipleEnumValueQueryParam(filter, OrderListViewUrlFiltersWithMultipleValuesEnum.type, OrderTypeEnum);
    case OrderFilterKeys.chargeStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderListViewUrlFiltersWithMultipleValuesEnum.chargeStatus,
        OrderChargeStatusFilter
      );
    case OrderFilterKeys.deliveryStatus:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderListViewUrlFiltersWithMultipleValuesEnum.deliveryStatus,
        OrderDeliveryStatusFilter
      );
    case OrderFilterKeys.payMethod:
      return getMultipleEnumValueQueryParam(
        filter,
        OrderListViewUrlFiltersWithMultipleValuesEnum.payMethod,
        OrderPayMethodFilter
      );

    case OrderFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.userSearch);

    case OrderFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.productSearch);

    case OrderFilterKeys.creatorUserSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.creatorUserSearch);

    case OrderFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.brandSearch);

    case OrderFilterKeys.brandStoreSearch:
      return getSingleValueQueryParam(filter, OrderListViewUrlFiltersEnum.brandStoreSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<OrderListViewUrlFilters>(ORDER_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  OrderListViewUrlQueryParams,
  OrderListViewUrlFilters
>({
  ...OrderListViewUrlFiltersEnum,
  ...OrderListViewUrlFiltersWithMultipleValuesEnum,
});
</file>

