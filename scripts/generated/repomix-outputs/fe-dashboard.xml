export const getSalesStatusChoices = (
  isBpvMode: boolean,
  isFulfilledByVendor: boolean,
  excludeStopped: boolean = false,
  isCreateMode: boolean = false,
  firstAvailableForPurchase?: any
) => {
  const choices = [];
  if (isBpvMode === false && isFulfilledByVendor === false) {
    const value = SalesStatusEnum.PENDING;
    choices.push({
      label: transformSalesStatusByProductVariant(value),
      value,
    });
  }
  // firstAvailableForPurchase가 null이고 직거래 상품이 아닌 경우 ON_SALE 옵션 제외
  // (판매 가능 알림을 통해서만 ON_SALE로 변경 가능)
  const excludeOnSale = isFulfilledByVendor === false && firstAvailableForPurchase === null && !isCreateMode;
  if (!excludeOnSale) {
    const value = SalesStatusEnum.ON_SALE;
    choices.push({
      label: isBpvMode ? transformSalesStatusByBrandProductVariant(value) : transformSalesStatusByProductVariant(value),
      value,
    });
  }
  // 직거래 상품은 '정상' 또는 '단종'만 선택 가능
  if (isFulfilledByVendor === false && isCreateMode === false) {
    const value = SalesStatusEnum.WILL_BE_STOPPED;
    choices.push({
      label: isBpvMode ? transformSalesStatusByBrandProductVariant(value) : transformSalesStatusByProductVariant(value),
      value,
    });
  }
  if (excludeStopped === false && isCreateMode === false) {
    const value = SalesStatusEnum.STOPPED;
    choices.push({
      label: isBpvMode ? transformSalesStatusByBrandProductVariant(value) : transformSalesStatusByProductVariant(value),
      value,
    });
  }
  return choices;
};

export const getForceNoNormalChoices = (stoppedByStatus: boolean = false) => [
  // status가 중단이면 무조건 중단으로 표시한다.
  {
    label: stoppedByStatus ? "중단" : "진열",
