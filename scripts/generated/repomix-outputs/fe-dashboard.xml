import useNavigator from "@hooks/useNavigator";
import usePaginator, { createPaginationState } from "@hooks/usePaginator";
import { CategoryInput } from "@src/api/types/globalTypes";
import { cleanFormDataUploadInputs } from "@src/app/components/antd/Form/utils";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { PAGINATE_BY } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import _ from "lodash";
import React, { useState } from "react";

import { productCreateViewUrl, productUpdateViewUrl } from "../../products/urls";
import { useCategoryUpdateMutation } from "../api/mutations";
import { useCategoryDetailsQuery } from "../api/queries";
import {
  CategoryBasicInfoUpdateForm,
  CategoryDetailsPage,
  CategoryPageTab,
} from "../components/CategoryDetailsPage/CategoryDetailsPage";
import {
  categoryCreateViewUrl,
  categoryDetailsViewUrl,
  CategoryDetailsViewUrlQueryParams,
  categoryListViewUrl,
} from "../urls";

interface CategoryDetailsViewProps {
  params: CategoryDetailsViewUrlQueryParams;
  id: string;
}

export enum CategoryDetailsEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
}

export function getActiveTab(tabName: string): CategoryPageTab {
  return tabName === CategoryPageTab.products ? CategoryPageTab.products : CategoryPageTab.categories;
}

export const CategoryDetailsView: React.FC<CategoryDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();
  const paginate = usePaginator();

  const [editMode, setEditMode] = useState<CategoryDetailsEditModeEnum>(null);

  const onEdit = (mode: CategoryDetailsEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };

  const paginationState = createPaginationState(PAGINATE_BY, params);
  const { data, loading } = useCategoryDetailsQuery({
    variables: { ...paginationState, id },
  });
  const category = maybe(() => data.category);

  const [categoryUpdate] = useCategoryUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.categoryUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  if (loading) {
    return <Loader />;
  }

  const onTabChange = (tabKey: CategoryPageTab) => {
    navigate(
      categoryDetailsViewUrl(id, {
        activeTab: tabKey,
      }),
      undefined,
      undefined,
      { noScroll: true }
    );
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = paginate(
    params.activeTab === CategoryPageTab.categories
      ? maybe(() => data.category.children.pageInfo)
      : maybe(() => data.category.products.pageInfo),
    paginationState,
    params
  );

  const handleUpdate = async (formData: CategoryBasicInfoUpdateForm) => {
    const cleanedFormData = cleanFormDataUploadInputs(formData, ["backgroundImage"]);

    // 현재 정책상 카테고리 구분(kind)은 수정 불가하므로 기존 값을 그대로 전달
    const input: CategoryInput = {
      ...cleanedFormData,
      kind: category.kind,
    };

    await categoryUpdate({ variables: { id, input } });
  };

  return (
    <>
      <WindowTitle title={maybe(() => category.name)} />
      <CategoryDetailsPage
        onTabChange={onTabChange}
        currentTab={params.activeTab}
        category={category}
        disabled={loading}
        products={maybe(() => category.products.edges.map((edge) => edge.node))}
        subcategories={maybe(() => category.children.edges.map((edge) => edge.node))}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBasicInfoUpdate={handleUpdate}
        onCategoryAdd={() => navigate(categoryCreateViewUrl(id))}
        onProductAdd={() => navigate(productCreateViewUrl({ isFulfilledByVendor: false }))}
        onCategoryClick={(id) => navigate(categoryDetailsViewUrl(id))}
        onProductClick={(id) => navigate(productUpdateViewUrl(id))}
        onBack={() => navigate(maybe(() => categoryDetailsViewUrl(category.parent.id), categoryListViewUrl()))}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        pageInfo={pageInfo}
      />
    </>
  );
};
</file>

