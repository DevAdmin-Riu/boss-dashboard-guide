import PageHeader from "@src/app/components/PageHeader";
import { maybe, renderCollection } from "@utils/misc";
import { Button, Col, Row, Space, Typography } from "antd";
import React from "react";

import { CustomerAddresses_user, CustomerAddresses_user_addresses } from "../../api/types/CustomerAddresses";
import CustomerAddress from "../CustomerAddress/CustomerAddress";

export interface CustomerAddressListPageProps {
  customer: CustomerAddresses_user;
  disabled: boolean;
  onAdd: () => void;
  onEdit: (address: CustomerAddresses_user_addresses) => void;
  onRemove: (address: CustomerAddresses_user_addresses) => void;
  onSetAsDefault: (address: CustomerAddresses_user_addresses) => void;
}

const CustomerAddressListPage: React.FC<CustomerAddressListPageProps> = (props) => {
  const { customer, disabled, onAdd, onEdit, onRemove, onSetAsDefault } = props;

  const isEmpty = maybe(() => customer.addresses.length) === 0;
  const fullName = maybe(() => [customer.firstName].join(" "), "...");

  return (
    <>
      {!isEmpty && (
        <PageHeader title={`${fullName}의 배송지`}>
          <Button type={"primary"} onClick={onAdd}>
            주소 추가
          </Button>
        </PageHeader>
      )}
      {isEmpty ? (
        <Space direction={"vertical"} align={"center"} style={{ marginTop: 100 }} size={"large"}>
          <Typography.Title level={4}>이 회원의 주소록에 등록된 배송지가 없습니다.</Typography.Title>
          <Typography>아래 버튼을 눌러 배송지 주소를 추가할 수 있습니다.</Typography>
          <Button type={"primary"} onClick={onAdd}>
            주소 추가
          </Button>
        </Space>
      ) : (
        <Row gutter={[16, 16]}>
          {renderCollection(
            maybe(() => customer.addresses),
            (address, addressNumber) => (
              <Col xs={24} sm={12} lg={8} key={address?.id}>
                <CustomerAddress
                  customer={customer}
                  address={address}
                  addressNumber={addressNumber + 1}
                  disabled={disabled}
                  isDefaultShippingAddress={maybe(() => customer.defaultShippingAddress.id) === maybe(() => address.id)}
                  onEdit={() => onEdit(address)}
                  onRemove={() => onRemove(address)}
                  onSetAsDefault={() => onSetAsDefault(address)}
                  key={maybe(() => address.id, "skeleton")}
                />
              </Col>
            )
          )}
        </Row>
      )}
    </>
  );
};
export default CustomerAddressListPage;
</file>

