          <Col span={12}>
            <FItem {...commonFormItemProps} name="firstName" label="이름">
              <Input />
            </FItem>
          </Col>
          <Col span={12}>
            <FItem {...commonFormItemProps} name="phone" label="연락처">
              <Input />
            </FItem>
          </Col>
          <Col span={24}>
            <Card type="inner" title="배송지 주소">
              <Col span={24}>
                <FItem {...commonFormItemProps} label="우편번호">
