    makeOrderUserLoginIdCol(),
    makeOrderUserNameCol(),
    makeVendorExternalSkuCol(),
    makeVendorExternalProductNameCol(),
    makeProductSkuCol(),
    makeProductNameCol(),
    makeVariantNameCol(),
    makeProductSpecCol(),
    isFulfilledByBossList && makeQuantityInBoxCol(),
    isFulfilledByBossList && makePurchaseUnitCol(),
    makeProductIsTaxFreeCol(),
    makeQuantityCol(editingProps),
    isB2b === false && makeProductPriceExcludeVatCol(),
    isB2b === false && makeDeliveryFeeExcludeVatCol(),
    isB2b === false && makeConsignmentUnitDeliveryAdditionalFeeExcludeVatCol(),
    makeUnitPriceCol(editingProps),
    makeCostPriceExcludeVatCol(editingProps, formValuesWatched),
    makeDevCostExcludeVatCol(editingProps),
    makeEtcExcludeVatCol(editingProps),
    isB2b && makeB2bDeliveryFeeExcludeVatCol(editingProps, isB2b),
    isB2b === false && makeTotalTakeBackDeliveryFeeExcludeVatCol(),
    makeTotalExcludeVatCol(editingProps, formValuesWatched),
    makeVatAmountCol(editingProps, formValuesWatched),
    makeTotalAmountCol(editingProps, formValuesWatched),
    isFulfilledByBossList && makeTypeCol(isB2b),
    isFulfilledByBossList && makeIsNotOrderableBeforeStockedCol(),
    isFulfilledByBossList && makeIsForPackageOrderCol(),
    isPendingAvailableList && makeUpdateCol(editingProps),
    isPendingAvailableList && isB2b === false && makeIsCancelCol(editingProps),
  ].filter(Boolean);

  if (!isPendingAvailableList) {
    columns.forEach((column) => {
      delete column.onCell;
