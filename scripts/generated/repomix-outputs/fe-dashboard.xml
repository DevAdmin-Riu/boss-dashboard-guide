import { VendorHistoryFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { VendorHistoryFilterKeys, VendorHistoryListFilterOpts } from "../../components/VendorHistoryListPage/filters";
import {
  VendorHistoryListViewUrlFilters,
  VendorHistoryListViewUrlFiltersEnum,
  VendorHistoryListViewUrlQueryParams,
} from "../../urls";

export const VENDOR_HISTORY_FILTERS_KEY = "vendorHistoryFilters";

export function getFilterOpts(params: VendorHistoryListViewUrlFilters): VendorHistoryListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    writerSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.writerSearch, true), false),
      value: maybe(() => filterVariables.writerSearch, ""),
    },
  };
}

export function getFilterVariables(params: VendorHistoryListViewUrlFilters): VendorHistoryFilterInput {
  return {
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    title: params.title !== undefined ? params.title : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    writerSearch: params.writerSearch !== undefined ? params.writerSearch : null,
  };
}

export function getFilterQueryParam(filter: IFilterElement<VendorHistoryFilterKeys>): VendorHistoryListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case VendorHistoryFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        VendorHistoryListViewUrlFiltersEnum.createdFrom,
        VendorHistoryListViewUrlFiltersEnum.createdTo
      );
    case VendorHistoryFilterKeys.title:
      return getSingleValueQueryParam(filter, VendorHistoryListViewUrlFiltersEnum.title);
    case VendorHistoryFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, VendorHistoryListViewUrlFiltersEnum.vendorSearch);
    case VendorHistoryFilterKeys.writerSearch:
      return getSingleValueQueryParam(filter, VendorHistoryListViewUrlFiltersEnum.writerSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<VendorHistoryListViewUrlFilters>(VENDOR_HISTORY_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  VendorHistoryListViewUrlQueryParams,
  VendorHistoryListViewUrlFilters
>(VendorHistoryListViewUrlFiltersEnum);
</file>

