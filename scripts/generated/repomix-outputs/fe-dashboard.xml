  batchCode: FilterOpts<string>;
  warehouseAddress: FilterOpts<string[]>;
}

export function createFilterStructure(
  opts: BatchPickingListFilterOpts,
  warehouseAddresses?: Array<{ id: string; companyName: string }>
): IFilter<BatchPickingFilterKeys> {
  let displayOrder = 0;
  const batchCodeFilter = {
    ...createTextField(displayOrder++, BatchPickingFilterKeys.batchCode, filterMsg.batchCode, opts.batchCode.value),
    active: opts.batchCode.active,
  };
  const warehouseAddressFilter = {
    ...createOptionsField(
      displayOrder++,
