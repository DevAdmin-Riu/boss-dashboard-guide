<file path="src/app/views/hqStaff/hqHome/components/TitleOrderStatsForMain.tsx">
import { User_brand } from "@src/api/fragments/types/User";
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import { MultiLineTypography } from "@src/app/components/MultiLineTypography/MultiLineTypography";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { getFulfilledByVendorSettlementStatusStepsIndexForHqMain } from "@src/app/views/hqFulfilledByVendor/components/HqFulfilledByVendorSettlementListPage/utils";
import { hqFulfilledByVendorSettlementListViewUrl } from "@src/app/views/hqFulfilledByVendor/urls";
import { getMileageSettlementStatusStepsIndexForHqMain } from "@src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/utils";
