                              isRequired
                              form={form}
                              isTaxFree={isTaxFree}
                              label="매장 판매가"
                              priceExcludeVatField={{
                                name: TypeSafeForm.getValidDataIndex(
                                  `brandProductVariantsInfo.${variant.id}.priceExcludeVat`
