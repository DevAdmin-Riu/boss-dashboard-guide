        <Space>
          <Typography.Title level={5} type={"secondary"}>
            {`총 매장 수:${brandStoresTotalCount}`}
          </Typography.Title>
        </Space>
      }
      extra={<>{brandStoreCreateButton}</>}
    />
  );

  const getBrandMemberTableColumns = () => {
    const columns: ColumnsType<BrandDetails_brand_brandStores> = [
      {
        title: "No.",
        key: "index",
        align: "center",
        width: 40,
        render: (_, _record, index) => index + 1,
      },
      {
        title: columnNameConstant.brandStore.BRAND_STORE_CODE,
        key: "brandStoreCode",
        align: "center",
        width: 120,
        render: (_, record) => record.code || "-",
      },
      {
        title: columnNameConstant.brandStore.BRAND_STORE_NAME,
        key: "brandStoreName",
        align: "left",
        width: 200,
        render: (_, record) => (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.name || "-"}</Typography.Link>
        ),
      },
      {
        title: columnNameConstant.brandStore.TYPE,
        key: "type",
        align: "center",
        width: 60,
        render: (_, record) => utils.getLabelTextByValue(record.type, brandStoreTypeChoices),
      },
      {
        title: columnNameConstant.brandStore.REGION_INFO_NAME,
        key: "region",
        align: "center",
        width: 60,
        render: (_, record) => record.ownerUser.brandStoreAddress?.regionInfo.name || "-",
      },
      {
        title: columnNameConstant.brandStore.STATUS,
        key: "isActive",
        align: "center",
        width: 100,
        render: (_, record) => (
          <StatusLabel
            useSmallDot
            status={record.status === BrandStoreStatusEnum.OPERATING ? "success" : "error"}
            label={utils.getLabelTextByValue(record.status, brandStoreStatusChoices)}
          />
        ),
      },
      {
        title: columnNameConstant.common.PERSON_IN_CHARGE,
        key: "hqStaffBrandStores",
        align: "center",
        width: 160,
        render: (_, record) => {
          const staff = record.hqStaffBrandStores;
          return staff ? (
