  const makeAttributesColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 200,
    render: (_, record) => {
      const hasVariants = !!record.variant.product.productType.hasVariants;
      const targetAttributes = hasVariants ? record.variant.attributes : record.variant.product.attributes;
      return makeProductSpecTextFromAttr(targetAttributes) || "-";
    },
  };
  const makeAttrQuantityColumn: DownloadableEditableColumnType<OrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
    key: "attrQuantity",
    align: "right",
    width: 80,
