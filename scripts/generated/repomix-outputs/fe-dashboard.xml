import {
  FbvPurchaseCostEventFilterInput,
  FbvPurchaseCostEventType,
  FbvPurchaseCostEventTypeEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariablesForMonth,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
} from "@utils/filters";
import { findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  FulfilledByVendorPurchaseCostEventListFilterKeys,
  FulfilledByVendorPurchaseCostEventListFilterOpts,
} from "../../components/FulfilledByVendorPurchaseCostEventListPage/filters";
import {
  FulfilledByVendorPurchaseCostEventListViewUrlFilters,
  FulfilledByVendorPurchaseCostEventListViewUrlFiltersEnum,
  FulfilledByVendorPurchaseCostEventListViewUrlFiltersWithMultipleValuesEnum,
  FulfilledByVendorPurchaseCostEventListViewUrlQueryParams,
} from "../../urls";

const FULFILLED_BY_VENDOR_PURCHASE_COST_EVENT_LIST_FILTERS_KEY = "fulfilledByVendorPurchaseCostEventListFilters";

export function getFilterOpts(
  params: FulfilledByVendorPurchaseCostEventListViewUrlFilters
): FulfilledByVendorPurchaseCostEventListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();
  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyMonthFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyMonthFormat)),
      },
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(
        () => dedupeFilter(filterVariables.type.map((type) => findValueInEnum(type, FbvPurchaseCostEventTypeEnum))),
        []
      ),
    },
  };
}

export function getFilterVariables(
  params: FulfilledByVendorPurchaseCostEventListViewUrlFilters
): FbvPurchaseCostEventFilterInput {
  return {
    created: getGteLteVariablesForMonth({ gte: params.createdFrom, lte: params.createdTo }),
    type: maybe(() => params.type.map((status) => findInEnum(status, FbvPurchaseCostEventTypeEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof FulfilledByVendorPurchaseCostEventListFilterOpts>
): FulfilledByVendorPurchaseCostEventListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case FulfilledByVendorPurchaseCostEventListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        FulfilledByVendorPurchaseCostEventListViewUrlFiltersEnum.createdFrom,
        FulfilledByVendorPurchaseCostEventListViewUrlFiltersEnum.createdTo
      );
    case FulfilledByVendorPurchaseCostEventListFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        FulfilledByVendorPurchaseCostEventListViewUrlFiltersWithMultipleValuesEnum.type,
        FbvPurchaseCostEventType
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<FulfilledByVendorPurchaseCostEventListViewUrlFilters>(
    FULFILLED_BY_VENDOR_PURCHASE_COST_EVENT_LIST_FILTERS_KEY
  );

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  FulfilledByVendorPurchaseCostEventListViewUrlQueryParams,
  FulfilledByVendorPurchaseCostEventListViewUrlFilters
>({
  ...FulfilledByVendorPurchaseCostEventListViewUrlFiltersEnum,
  ...FulfilledByVendorPurchaseCostEventListViewUrlFiltersWithMultipleValuesEnum,
});
