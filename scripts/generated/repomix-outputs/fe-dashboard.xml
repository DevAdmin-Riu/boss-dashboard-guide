const calcOrderLineUnitProductPriceExcludeVat = (record: PurchaseOrderLineList_purchaseOrderLines_edges_node): number =>
  toPricePrecisionFixed(
    record.orderLine.unitPriceGrossAmount - record.orderLine.unitPriceVat,
    record.variant.priceDecimalPlaces
  );
const calcOrderLineTotalProductPriceExcludeVat = (
  record: PurchaseOrderLineList_purchaseOrderLines_edges_node
): number => {
  const quantity = getPoLineExpectedPurchaseQty(record.purchaseOrder.eventType, record);
  return toPriceExcludeVat(
    record.orderLine.unitPriceGrossAmount * quantity,
    record.orderLine.isTaxFree,
    record.variant.priceDecimalPlaces
  );
};

