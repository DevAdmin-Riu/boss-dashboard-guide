import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useMemo, useState } from "react";

import {
  useBrandStoreConsultationListFilterDownloadQuery,
  useBrandStoreConsultationListQuery,
} from "../../api/queries";
import {
  BrandStoreConsultationList_brandStoreConsultationList_edges_node,
  BrandStoreConsultationListVariables,
} from "../../api/types/BrandStoreConsultationList";
import BrandStoreConsultationCreateAndUpdateModal from "../../components/BrandStoreConsultationCreateAndUpdateModal";
import BrandStoreConsultationListPage from "../../components/BrandStoreConsultationListPage/BrandStoreConsultationListPage";
import {
  brandStoreConsultationListViewUrl,
  BrandStoreConsultationListViewUrlDialog,
  BrandStoreConsultationListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

export enum BrandStoreConsultationListModalModeEnum {
  CREATE_MODE = "CREATE_MODE",
  UPDATE_MODE = "UPDATE_MODE",
}

interface BrandStoreConsultationListViewProps {
  params: BrandStoreConsultationListViewUrlQueryParams;
}

export const BrandStoreConsultationListView: React.FC<BrandStoreConsultationListViewProps> = ({ params }) => {
  const { user } = useUser();
  const isStaff = user.isStaff;
  const [modalMode, setModalMode] = useState<BrandStoreConsultationListModalModeEnum>(null);
  const [selectedRowRecord, setSelectedRowRecord] =
    useState<BrandStoreConsultationList_brandStoreConsultationList_edges_node>(null);
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BS_OPS_CHECK_CONSULTATION_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useBrandStoreConsultationListFilterDownloadQuery);

  const targetUrl = brandStoreConsultationListViewUrl;

  const filter = getFilterVariables(params);
  const queryVariables = useMemo<BrandStoreConsultationListVariables>(
    () => ({ ...paginationState, filter, isStaff }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBrandStoreConsultationListQuery({
    initialListSkip: true,
    variables: queryVariables,
  });
  const brandStoreConsultationList = maybe(() => data.brandStoreConsultationList.edges.map((edge) => edge.node), []);

  const filterOpts = getFilterOpts(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.brandStoreConsultationList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<
    BrandStoreConsultationListViewUrlDialog,
    BrandStoreConsultationListViewUrlQueryParams
  >({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <BrandStoreConsultationListPage
        user={user}
        brandStoreConsultationList={brandStoreConsultationList}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        settings={settings}
        disabled={loading}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onShowDetailRecord={(record: BrandStoreConsultationList_brandStoreConsultationList_edges_node) => {
          setSelectedRowRecord(record);
          setModalMode(BrandStoreConsultationListModalModeEnum.UPDATE_MODE);
        }}
        onCreate={() => {
          setSelectedRowRecord(null);
          setModalMode(BrandStoreConsultationListModalModeEnum.CREATE_MODE);
        }}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />

      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
      <BrandStoreConsultationCreateAndUpdateModal
        open={
          modalMode === BrandStoreConsultationListModalModeEnum.CREATE_MODE ||
          (modalMode === BrandStoreConsultationListModalModeEnum.UPDATE_MODE && selectedRowRecord !== null)
        }
        onCancel={() => {
          setSelectedRowRecord(null);
          setModalMode(null);
        }}
        modalMode={modalMode}
        user={user}
        selectedRowRecord={selectedRowRecord}
      />
    </>
  );
};
</file>

