<file path="src/app/views/product/products/components/ProductVariantFile.tsx">
import { DeleteOutlined, UploadOutlined } from "@ant-design/icons";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import ConfirmModal from "@src/app/components/ConfirmModal";
import {
  ProductDetails_product_defaultVariant_designFiles,
  ProductDetails_product_defaultVariant_estimateFiles,
} from "@src/app/views/product/products/api/types/ProductDetails";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Button, Card, List, Typography, Upload } from "antd";
import React from "react";

import {
  useProductVariantDesignFileCreateMutation,
  useProductVariantDesignFileDeleteMutation,
  useProductVariantEstimateFileCreateMutation,
  useProductVariantEstimateFileDeleteMutation,
} from "../api/mutations";

interface ProductDesignImageProps {
  variantId: string;
  files:
    | Array<ProductDetails_product_defaultVariant_designFiles | null>
    | Array<ProductDetails_product_defaultVariant_estimateFiles | null>
    | null;
  fileType: "Design" | "Estimate";
}

const ProductVariantFile: React.FC<ProductDesignImageProps> = (props) => {
  const { variantId, files, fileType } = props;
  const [deleteConfirmModalOpen, setDeleteConfirmModalOpen] = React.useState<boolean>(false);
  const [designFileId, setDesignFileId] = React.useState<string | null>(null);

  const [createProductVariantDesignFile, _createProductVariantDesignFileOpts] =
    useProductVariantDesignFileCreateMutation({
      onCompleted: (data) => {
        const errors = data.productVariantDesignFileCreate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("디자인 파일이 저장되었습니다.");
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
    });

  const [createProductVariantEstimateFile, _createProductVariantEstimateFileOpts] =
    useProductVariantEstimateFileCreateMutation({
      onCompleted: (data) => {
        const errors = data.productVariantEstimateFileCreate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("견적서 파일이 저장되었습니다.");
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
    });

  const [deleteProductVariantDesignFile] = useProductVariantDesignFileDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productVariantDesignFileDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("디자인 파일이 삭제되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [deleteProductVariantEstimateFile] = useProductVariantEstimateFileDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productVariantEstimateFileDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("견적서 파일이 삭제되었습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const fileTypeMapping = {
    Design: {
      createMutation: createProductVariantDesignFile,
      deleteMutation: deleteProductVariantDesignFile,
      text: "디자인",
    },
    Estimate: {
      createMutation: createProductVariantEstimateFile,
      deleteMutation: deleteProductVariantEstimateFile,
      text: "견적서",
    },
  };

  const {
    createMutation: createFileMutation,
    deleteMutation: deleteFileMutation,
    text: fileTypeText,
  } = React.useMemo(() => fileTypeMapping[fileType], [fileType]);

  const deleteDesignFileFn = () => {
    if (designFileId === null) {
      showNotificationWarn("재시도 해주시기 바랍니다.");
      return;
    }

    deleteFileMutation({
      variables: {
        id: designFileId,
      },
    });
    modalCloseFn();
  };

  const modalCloseFn = () => {
    setDeleteConfirmModalOpen(false);
    setDesignFileId(null);
  };

  return (
    <>
      <ConfirmModal
        topOfMuiDialog
        visible={deleteConfirmModalOpen}
        modalTitleText={`${fileTypeText} 파일 삭제`}
        titleText={`${fileTypeText}파일을 삭제하시겠습니까?`}
        onOk={deleteDesignFileFn}
        onCancel={modalCloseFn}
      />
      <Card title={<CardTitleAntd title={`${fileTypeText} 파일`} />}>
        <Upload
          multiple={true}
          listType="text"
          showUploadList={false}
          customRequest={(props) => {
            if (files && files.length >= 3) {
              showNotificationWarn("디자인 파일은 3개까지만 등록 가능합니다.");
              return false;
            }
            createFileMutation({
              variables: {
                input: {
                  variant: variantId,
                  file: props.file,
                },
              },
            });
            setTimeout(() => {
              props.onSuccess("ok");
            }, 0);
          }}
          accept="*"
        >
          <Button icon={<UploadOutlined />}>업로드</Button>
        </Upload>
        <List>
          {files &&
            files.map((file, index) => (
              <List.Item
                key={file.id}
                actions={[
                  <DeleteOutlined
                    style={{ cursor: "pointer", color: "red" }}
                    onClick={() => {
                      setDesignFileId(file.id);
                      setDeleteConfirmModalOpen(true);
                    }}
                  />,
                ]}
              >
                <Typography.Link href={file?.url} download target="_blank">
                  {file.fileName}
                </Typography.Link>
              </List.Item>
            ))}
        </List>
      </Card>
    </>
  );
};

export default ProductVariantFile;
</file>

