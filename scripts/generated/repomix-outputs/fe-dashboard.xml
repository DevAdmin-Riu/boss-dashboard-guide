import { attributeMsg } from "@assets/messages/commonMsg";
import { AttributeInputTypeEnum, AttributeValueCreateInput, BoxSizeTypeEnum } from "@src/api/types/globalTypes";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";

import { AttributeSlugEnum } from "../../product/products/utils/data";
import { AttributeDetails_attribute } from "./api/types/AttributeDetails";
import { getValueKeyFromAttrValues } from "./components/AttributeValues";

export const attributeInputTypeChoices = [
  {
    label: attributeMsg.directly,
    value: AttributeInputTypeEnum.DIRECTLY,
  },
  {
    label: attributeMsg.dropdown,
    value: AttributeInputTypeEnum.DROPDOWN,
  },
  {
    label: attributeMsg.multiSelect,
    value: AttributeInputTypeEnum.MULTISELECT,
  },
];
export const getAttributeInputTypeText = (inputType: AttributeInputTypeEnum) => {
  const choice = attributeInputTypeChoices.find((c) => c.value === inputType);
  if (choice) {
    return choice.label;
  }
  return "-";
};

export const boxSizeTypeChoices = [
  {
    label: "없음",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_EMPTY,
  },
  {
    label: "폴리백",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_01,
  },
  {
    label: "85",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_85,
  },
  {
    label: "95",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_95,
  },
  {
    label: "105",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_105,
  },
  {
    label: "115",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_115,
  },
  {
    label: "125",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_125,
  },
  {
    label: "135",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_135,
  },
  {
    label: "145",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_145,
  },
  {
    label: "165",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_165,
  },
  {
    label: "초대형",
    value: BoxSizeTypeEnum.BOX_SIZE_TYPE_200,
  },
];
export const getBoxSizeTypeText = (boxSizeType: BoxSizeTypeEnum) => {
  const choice = boxSizeTypeChoices.find((c) => c.value === boxSizeType);
  if (choice) {
    return choice.label;
  }
  return "-";
};

// NOTE: 속성 상세 정보 중 박스타입(재고)에 한하여 attribute.values의 value 전달 받고 있음.
// 재고 택배비 - 데이터를 받아오는 순간, 부가세 별도 가격으로 파싱 처리
export const parseAttributeValueToExcludeVat = (attribute: AttributeDetails_attribute): AttributeDetails_attribute => {
  const parsedAttributeValues =
    attribute?.values.map((attrValue) => {
      const value = attrValue.value;
      if (attribute.slug === AttributeSlugEnum.boxSize) {
        const valueKey = getValueKeyFromAttrValues(attribute?.slug);
        const parsedValue = toPriceExcludeVat(value[valueKey]);
        return { ...attrValue, value: { ...value, [valueKey]: parsedValue } };
      }
      return attrValue;
    }) || [];
  return { ...attribute, values: parsedAttributeValues };
};

export const parseAttributeValueFormToIncludeVat = (
  attribute: AttributeDetails_attribute,
  formData: AttributeValueCreateInput
): AttributeValueCreateInput => {
  const value = formData.value;
  if (attribute.slug === AttributeSlugEnum.boxSize) {
    const valueKey = getValueKeyFromAttrValues(attribute.slug);
    const parsedValue = toPriceIncludeVat(value[valueKey]);
    return { ...formData, value: { ...value, [valueKey]: parsedValue } };
  }
  return formData;
};
</file>

