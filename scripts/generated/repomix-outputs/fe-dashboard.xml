import { BrandVacsFeeEventInput, BrandVacsFeeEventTypeEnum } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import {
  getFormInputNumberMaxValueRule,
  getFormInputNumberMinValueRule,
} from "@src/app/components/antd/Form/validators";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { StrictOmit } from "@src/global/core/types/types";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Form, Input, InputNumber, Modal } from "antd";
import React, { useEffect, useState } from "react";

import { useBrandCreateVacsFeeEventMutation } from "../api/mutations";
import { brandVacsFeeEventListQuery } from "../api/queries";
import { BrandDetails_brand } from "../api/types/BrandDetails";
import { getBrandVacsFeeEventTypeText } from "../utils";

type TFormData = StrictOmit<BrandVacsFeeEventInput, "type">;

interface BrandVacsFeeEventCreateModalProps {
  open: boolean;
  loading: boolean;
  brand: BrandDetails_brand;
  eventType: BrandVacsFeeEventTypeEnum;
  onClose: () => void;
}

export const BrandVacsFeeEventCreateModal: React.FC<BrandVacsFeeEventCreateModalProps> = (props) => {
  const { open, loading, brand, eventType, onClose } = props;
  const [openConfirmModal, setOpenConfirmModal] = useState<boolean>(false);
  const typeText = getBrandVacsFeeEventTypeText(eventType);
  const onModalClose = () => {
    setOpenConfirmModal(false);
    onClose();
  };

  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const initialValues: TFormData = {
    amountExcludeVat: undefined,
    description: undefined,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [brandCreateVacsFeeEvent, brandCreateVacsFeeEventOpts] = useBrandCreateVacsFeeEventMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandCreateVacsFeeEvent.errors, `충전금 수수료 ${typeText} 완료`, () => {
        onModalClose();
      }),
    refetchQueries: [brandVacsFeeEventListQuery],
  });

  const modalLoading = loading || brandCreateVacsFeeEventOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      onOk={() => {
        const errors = form.getFieldsError().filter(({ errors }) => errors.length > 0);
        if (errors.length > 0) {
          showNotificationError("입력값을 확인해주세요.");
        } else {
          setOpenConfirmModal(true);
        }
      }}
      onCancel={onModalClose}
      title={`충전금 수수료 ${typeText}`}
      okText={typeText}
      cancelText="뒤로"
      okButtonProps={{ loading: modalLoading }}
      maskClosable={false}
    >
      <Form
        form={TypeSafeForm.formInstance}
        layout="vertical"
        initialValues={initialValues}
        onFinish={(formData) =>
          brandCreateVacsFeeEvent({ variables: { brandId: brand?.id, input: { ...formData, type: eventType } } })
        }
      >
        <Form.Item
          name={TypeSafeForm.getValidDataIndex("amountExcludeVat")}
          label={utils.formatVatInfo("충전금 수수료")}
          rules={[
            { type: "integer" },
            { required: true, message: "충전금 수수료는 필수 입력입니다." },
            getFormInputNumberMinValueRule({ min: 1, message: "0원 이하는 입력할 수 없습니다." }),
            getFormInputNumberMaxValueRule({
              max: brand.remainVacsFeeExcludeVat,
              message: "잔여 충전금 수수료보다 많은 금액은 입력할 수 없습니다.",
            }),
          ]}
        >
          <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
        </Form.Item>
        <Form.Item name={TypeSafeForm.getValidDataIndex("description")} label="상세내용">
          <Input.TextArea placeholder="상세내용을 입력해 주세요." />
        </Form.Item>
        {openConfirmModal && (
          <ConfirmModal visible={openConfirmModal} onOk={form.submit} onCancel={() => setOpenConfirmModal(false)} />
        )}
      </Form>
    </Modal>
  );
};
</file>

