import "../ModusignTemplateConfirmView/ModusignTemplateConfirmView.scss";

import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { DigitalContractCountEventTypeEnum } from "@src/api/types/globalTypes";
import { useDigitalContractCountCreateMutation } from "@src/app/views/brand/brands/api/mutations";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Spin } from "antd";
import React, { useLayoutEffect } from "react";

import { ModusignDocumentConfirmUrlQueryParams, modusignDocumentListUrl } from "../../urls";

interface ModusignDocumentConfirmViewProps {
  params: ModusignDocumentConfirmUrlQueryParams;
}

const ModusignDocumentConfirmView: React.FC<ModusignDocumentConfirmViewProps> = (props) => {
  const { params } = props;
  const navigate = useNavigator();
  const { documentId } = params;
  const { user } = useUser();
  const brandId = user?.brand?.id;

  const isTemplateMetadataUpdateError = utils.isEmpty(brandId) || utils.isEmpty(params) || utils.isEmpty(documentId);
  if (isTemplateMetadataUpdateError) {
    showNotificationError("잘못된 접근입니다. 다시 시도해 주세요.");
    navigate(modusignDocumentListUrl(), true);
    return;
  }

  const [modusignTemplateMetadataUpdate] = useDigitalContractCountCreateMutation({
    onCompleted: (data) => {
      const errors = data.digitalContractCountCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("전자계약 서명이 완료되었습니다.");
        navigate(modusignDocumentListUrl(), true);
      } else {
        showNotificationError("전자계약 서명 시 오류가 발생하였습니다. 다시 시도해 주세요.");
        navigate(modusignDocumentListUrl(), true);
      }
    },
  });

  useLayoutEffect(() => {
    if (isTemplateMetadataUpdateError === false) {
      modusignTemplateMetadataUpdate({
        variables: {
          brandId,
          input: {
            description: "전자계약 서명",
            delta: 1,
            type: DigitalContractCountEventTypeEnum.DIGITAL_CONTRACT_CREATED,
            documentId,
          },
        },
      });
    }
  }, []);
  return (
    <div className="signature-overlay-mask">
      <Spin tip="잠시만 기다려 주세요..."></Spin>
    </div>
  );
};

export default ModusignDocumentConfirmView;
</file>

<file path="src/app/views/hqStaff/hqDigitalContract/views/ModusignDocumentListView/filters.ts">
import { ModusignDocStatusEnum, ModusignDocumentListFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getMinMaxQueryParam,
  getSingleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  ModusignDocumentListFilterKeys,
  ModusignDocumentListFilterOpts,
} from "../../components/ModusignDocumentListPage/filters";
import {
  ModusignDocumentListUrlFilters,
  ModusignDocumentListUrlFiltersEnum,
  ModusignDocumentListUrlQueryParams,
} from "../../urls";

const MODUSIGN_DOCUMENT_LIST_FILTERS_KEY = "modusignDocumentListFiltersKey";

export function getFilterOpts(params: ModusignDocumentListUrlFilters): ModusignDocumentListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(() => findValueInEnum(filterVariables.status, ModusignDocStatusEnum), undefined),
    },
    startedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.startedAtGte, filterVariables.startedAtLte]), false),
      value: {
        max: maybe(() => filterVariables.startedAtLte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.startedAtGte, todayMoment.format(onlyDateFormat)),
      },
    },
    updatedAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.updatedAtGte, filterVariables.updatedAtLte]), false),
      value: {
        max: maybe(() => filterVariables.updatedAtLte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.updatedAtGte, todayMoment.format(onlyDateFormat)),
      },
    },
  };
}

export function getFilterVariables(params: ModusignDocumentListUrlFilters): ModusignDocumentListFilterInput {
  return {
    title: params.title !== undefined ? params.title : undefined,
    status: params.status !== undefined ? findValueInEnum(params.status, ModusignDocStatusEnum) : null,
    brandCode: null,
    startedAtGte: params.startedAtGte !== undefined ? params.startedAtGte : undefined,
    startedAtLte: params.startedAtLte !== undefined ? params.startedAtLte : undefined,
    updatedAtGte: params.updatedAtGte !== undefined ? params.updatedAtGte : undefined,
    updatedAtLte: params.updatedAtLte !== undefined ? params.updatedAtLte : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ModusignDocumentListFilterKeys>
): ModusignDocumentListUrlFilters {
  const { name } = filter;

  switch (name) {
    case ModusignDocumentListFilterKeys.title:
      return getSingleValueQueryParam(filter, ModusignDocumentListUrlFiltersEnum.title);
    case ModusignDocumentListFilterKeys.status:
      return getSingleEnumValueQueryParam(filter, ModusignDocumentListUrlFiltersEnum.status, ModusignDocStatusEnum);
    case ModusignDocumentListFilterKeys.startedAt:
      return getMinMaxQueryParam(
        filter,
        ModusignDocumentListUrlFiltersEnum.startedAtGte,
        ModusignDocumentListUrlFiltersEnum.startedAtLte
      );
    case ModusignDocumentListFilterKeys.updatedAt:
      return getMinMaxQueryParam(
        filter,
        ModusignDocumentListUrlFiltersEnum.updatedAtGte,
        ModusignDocumentListUrlFiltersEnum.updatedAtLte
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } = createFilterTabUtils<ModusignDocumentListUrlFilters>(
  MODUSIGN_DOCUMENT_LIST_FILTERS_KEY
);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ModusignDocumentListUrlQueryParams,
  ModusignDocumentListUrlFilters
>({ ...ModusignDocumentListUrlFiltersEnum });
</file>

<file path="src/app/views/hqStaff/hqDigitalContract/views/ModusignDocumentListView/ModusignDocumentListView.tsx">
import useUser from "@hooks/useUser";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog, { SaveFilterTabDialogFormData } from "@src/app/components/SaveFilterTabDialog";
import { ListViews, TabActionDialog } from "@src/global/core/types/types";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React from "react";

import { useModusignDocumentViewMutation } from "../../api/mutations";
import { useModusignDocumentListQuery } from "../../api/queries";
import { ModusignDocumentListVariables } from "../../api/types/ModusignDocumentList";
import ModusignDocumentListPage from "../../components/ModusignDocumentListPage/ModusignDocumentListPage";
import { modusignDocumentListUrl, ModusignDocumentListUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface ModusignDocumentListViewProps {
  params: ModusignDocumentListUrlQueryParams;
}

const ModusignDocumentListView: React.FC<ModusignDocumentListViewProps> = (props) => {
  const { user } = useUser();
  const { params } = props;
  const targetUrl = (params: ModusignDocumentListUrlQueryParams) => modusignDocumentListUrl(params);

  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MODUSIGN_DOCUMENT_LIST,
  });

  const limit = settings.rowNumber;
  const currentPage = Number(params.page) || 1;
  const offset = (currentPage - 1) * limit;
  const brandCode = user?.brand?.code;
  const queryVariables: ModusignDocumentListVariables = React.useMemo(
    () => ({ filters: { ...getFilterVariables(params), brandCode }, limit, offset }),
    [params, settings?.rowNumber]
  );

  const paginationOnChange = (page: number) => {
    const newParams = { ...params, page };
    navigate(modusignDocumentListUrl(newParams));
  };

  const { data, loading, refetch } = useModusignDocumentListQuery({
    variables: {
      ...queryVariables,
      limit,
    },
  });

  const [modusignDocumentCreate, modusignDocumentCreateOpts] = useModusignDocumentViewMutation({
    onCompleted: (data) => {
      const errors = data.modusignDocumentView.errors;
      if (errors.length === 0) {
        window.open(data.modusignDocumentView.embeddedUrl);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onModusignDocumentView = (documentId: string) => {
    modusignDocumentCreate({
      variables: {
        input: {
          documentId,
        },
      },
    });
  };

  const tabs = getFilterTabs ? getFilterTabs() : [];
  const currentTab =
    params.activeTab === undefined
      ? areFiltersApplied
        ? areFiltersApplied(params)
          ? tabs.length + 1
          : 0
        : 0
      : parseInt(params.activeTab, 0);
  const handleTabChange = (tab: number) => {
    navigate(
      targetUrl({
        activeTab: tab.toString(),
        ...getFilterTabs()[tab - 1].data,
      })
    );
  };
  const [openModal, closeModal] = createDialogActionHandlers<TabActionDialog, ModusignDocumentListUrlQueryParams>(
    navigate,
    targetUrl,
    params
  );
  const handleFilterTabDelete = () => {
    deleteFilterTab(currentTab);
    navigate(targetUrl(params));
  };

  const handleFilterTabSave = (data: SaveFilterTabDialogFormData) => {
    saveFilterTab(data.name, getActiveFilters(params));
    handleTabChange(tabs.length + 1);
  };

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: targetUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: refetch,
  });

  const disabled = loading || modusignDocumentCreateOpts.loading;

  return (
    <>
      <ModusignDocumentListPage
        params={params}
        settings={settings}
        onUpdateListSettings={updateListSettings}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        currentTab={currentTab}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onNextPage={null}
        onPreviousPage={null}
        disabled={disabled}
        documentList={maybe(() => data.modusignDocumentList.documents.map((document) => document, []))}
        totalCount={maybe(() => data.modusignDocumentList.count)}
        paginationOnChange={paginationOnChange}
        currentPage={currentPage}
        limit={limit}
        onModusignDocumentView={onModusignDocumentView}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};

export default ModusignDocumentListView;
</file>

