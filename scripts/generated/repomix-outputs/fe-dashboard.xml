<file path="src/global/core/utils/kakao/kakaoMap.ts">
import { utils } from "@utils/utils";

// 카카오 관련 sdk를 추가로 사용하게 될 경우는 아래 정보를 플러그인로 분리하는 것도 고려
const KAKAO_MAP_APP_KEY = "21584d0b8c574288d7caccf8c383eeb3";
// 동적으로 로드하기 위해 autoload=false 옵션을 사용
const KAKAO_MAP_SDK_SCRIPT_URL = `//dapi.kakao.com/v2/maps/sdk.js?appkey=${KAKAO_MAP_APP_KEY}&autoload=false&libraries=services,clusterer,drawing`;

export const loadKakaoMapSdk = (): Promise<void> =>
  new Promise((resolve, reject) => {
    let retry = 0;
    const maxRetry = 60; // 60 * 50ms = 3초
    const scriptId = "kakao-map-sdk";

    const safeLoad = () => {
      if (window.kakao && window.kakao.maps && window.kakao.maps.load) {
        window.kakao.maps.load(resolve);
      } else if (retry < maxRetry) {
        retry += 1;
        setTimeout(safeLoad, 50);
      } else {
        reject(new Error("Kakao Map SDK 로딩 실패"));
      }
    };

    if (!document.getElementById(scriptId)) {
      const script = document.createElement("script");
      script.id = scriptId;
      script.src = KAKAO_MAP_SDK_SCRIPT_URL;
      script.async = true;
      document.head.appendChild(script);
      script.onload = safeLoad;
    } else if (window.kakao?.maps?.load) {
      window.kakao.maps.load(resolve);
    } else {
      safeLoad();
    }
  });

export interface MapLatLng {
  lat: number;
  lng: number;
}

export interface MapMarker extends MapLatLng {
  name?: string;
}

// 서울 시청 좌표. 현재 유저가 접근한 위치를 찾을 수 없을 때 사용.
const DEFAULT_MAP_CENTER_LATLNG: MapLatLng = { lat: 37.5665, lng: 126.978 };

export const getInitialMapCenter = (center: MapLatLng): Promise<MapLatLng> => {
  if (center && center.lat && center.lng) {
    return Promise.resolve(center);
  }
  return new Promise((resolve) => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
        () => resolve(DEFAULT_MAP_CENTER_LATLNG),
        { timeout: 3000 }
      );
    } else {
      resolve(DEFAULT_MAP_CENTER_LATLNG);
    }
  });
};

// 주소 → 좌표 변환 함수
export const getLatLngFromAddress = async (address: string): Promise<{ lat: number; lng: number } | null> => {
  if (utils.isEmpty(address, true)) {
    return Promise.resolve(null);
  }

  await loadKakaoMapSdk();
  return new Promise((resolve) => {
    if (!window.kakao?.maps) {
      return resolve(null);
    }
    const geocoder = new window.kakao.maps.services.Geocoder();
    geocoder.addressSearch(address, (result: any, status: any) => {
      if (status === window.kakao.maps.services.Status.OK && result[0]) {
        resolve({ lat: parseFloat(result[0].y), lng: parseFloat(result[0].x) });
      } else {
        resolve(null);
      }
    });
  });
};

interface ClusterStyleOption {
  // 원의 지름(px)
  size: number;
  // 중심 색상
  color: string;
  // 텍스트 크기(px)
  fontSize: number;
  fontWeight?: string;
}

const CLUSTER_STYLE_PRESETS: Record<number, ClusterStyleOption> = {
  10: { size: 56, color: "#6ec6ff", fontSize: 12 },
  30: { size: 76, color: "#2196f3", fontSize: 14 },
  50: { size: 100, color: "#1565c0", fontSize: 16 },
  100: { size: 130, color: "#002f6c", fontSize: 18 },
};

export const getMapClusterStyles = (calculator: number[]): React.CSSProperties[] =>
  calculator.map((num) => {
    const preset = CLUSTER_STYLE_PRESETS[num] || CLUSTER_STYLE_PRESETS[30];
    const size = preset.size;
    const color = preset.color;
    const fontSize = preset.fontSize;
    // 중심은 진하게, 바깥은 투명하게
    const background = `radial-gradient(circle, ${color} 45%, rgba(33,150,243,0.18) 75%, rgba(33,150,243,0.0) 100%)`;

    return {
      width: `${size}px`,
      height: `${size}px`,
      background,
      color: "#fff",
      borderRadius: "50%",
      fontSize: `${fontSize}px`,
      fontWeight: "bold",
      lineHeight: `${size}px`,
      textAlign: "center",
      boxShadow: "0 2px 12px rgba(0,0,0,0.18)",
      padding: "0",
      userSelect: "none",
    };
  });

// 주어진 좌표(lat, lng)가 다각형(polygon) 안에 포함되어 있는지를 Ray Casting 알고리즘으로 판단
// 다각형의 변 위에 점이 있을 경우에도 내부로 간주
export const checkIsLatLngInPolygon = (
  latLng: { lat: number; lng: number },
  polygonLatLngList: Array<{ lat: number; lng: number }>
): boolean => {
  let inside = false;

  const x = latLng.lng;
  const y = latLng.lat;

  // polygon의 각 변을 순회
  for (let i = 0, j = polygonLatLngList.length - 1; i < polygonLatLngList.length; j = i++) {
    const { lng: xi, lat: yi } = polygonLatLngList[i];
    const { lng: xj, lat: yj } = polygonLatLngList[j];

    // 아래 조건은:
    // 1. 현재 점 y가 두 꼭짓점 yi, yj 사이에 존재하는지 확인
    // 2. 점의 x보다 교차 지점의 x가 오른쪽에 있는지를 확인
    const intersects = yi > y !== yj > y && x <= ((xj - xi) * (y - yi)) / (yj - yi) + xi;
    if (intersects) {
      inside = !inside;
    }

    // 다각형의 선 위에 점이 있을 경우 내부로 간주
    const isOnLine = checkIsLatLngOnLineSegment(latLng, polygonLatLngList[j], polygonLatLngList[i]);
    if (isOnLine) {
      return true;
    }
  }

  return inside;
};

// 주어진 점이 선분(pStart-pEnd) 위에 정확히 위치하는지 판단
const checkIsLatLngOnLineSegment = (
  point: { lat: number; lng: number },
  pStart: { lat: number; lng: number },
  pEnd: { lat: number; lng: number }
): boolean => {
  const { lat, lng } = point;
  const { lat: x1, lng: y1 } = pStart;
  const { lat: x2, lng: y2 } = pEnd;

  const cross = (lat - x1) * (y2 - y1) - (lng - y1) * (x2 - x1);
  // 일직선이 아님
  if (Math.abs(cross) > 1e-10) {
    return false;
  }

  const dot = (lat - x1) * (x2 - x1) + (lng - y1) * (y2 - y1);
  if (dot < 0) {
    return false;
  }

  const squaredLength = (x2 - x1) ** 2 + (y2 - y1) ** 2;
  if (dot > squaredLength) {
    return false;
  }

  return true;
};
</file>

