import { User } from "@src/api/fragments/types/User";
import { RequestBossProductStatusEnum, RequestFbvProductStatusEnum } from "@src/api/types/globalTypes";
import { DescriptionsProps } from "antd";

import { getHqReqBossProductNavButtonName } from "../hqStaff/hqRequestProduct/urls";
import { getReqBossProductNavButtonName, ReqBossProductUrlEnum } from "./urls";

// NOTE: 보스 상품 요청 사항에서 입수량, 예상 월 사용량에 대한 기본 단위 - 요청 사항에서까지 견적과 마찬가지로 단위를 입력 받으면 너무 입력 항목이 불필요하게 많아지므로 요청 사항의 단위는 하드코딩 처리
export const reqBossProductQtyPerBoxUnitType = "EA";
export const reqBossProductEstMonthlyQtyUnitType = "BOX";

export const getReqBossProductDescProps = (maxColumns: number): DescriptionsProps => {
  const width = `${Math.floor(100 / (maxColumns * 2))}%`;

  return {
    bordered: true,
    size: "small",
    labelStyle: { width, fontSize: "12px" },
    contentStyle: { width, fontSize: "12px" },
  };
};

export const getRequestFbvProductStatusColor = (status: RequestFbvProductStatusEnum) => {
  if (status === RequestFbvProductStatusEnum.REQUESTED) {
    return "blue";
  }

  if (status === RequestFbvProductStatusEnum.COMPLETED) {
    return "blue";
  }

  if (status === RequestFbvProductStatusEnum.REJECTED) {
    return "red";
  }

  return "gray";
};

export const requestFbvProductStatusChoices = [
  {
    label: "등록요청",
    value: RequestFbvProductStatusEnum.REQUESTED,
  },
  {
    label: "완료",
    value: RequestFbvProductStatusEnum.COMPLETED,
  },
  {
    label: "반려",
    value: RequestFbvProductStatusEnum.REJECTED,
  },
];
export const getRequestFbvProductStatusText = (status: RequestFbvProductStatusEnum) => {
  const choice = requestFbvProductStatusChoices.find((c) => c.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

export const getRequestBossProductStatusColor = (status: RequestBossProductStatusEnum) => {
  const statusList = Object.values(RequestBossProductStatusEnum);
  const negativeStatusList = [
    RequestBossProductStatusEnum.REQ_ADDITIONAL,
    RequestBossProductStatusEnum.REQ_ESTIMATE_FIX,
    RequestBossProductStatusEnum.CANCELED,
  ];
  const positiveGoldStatusList = [RequestBossProductStatusEnum.VENDOR_PRICE];
  const positiveBlueStatusList = statusList.filter(
    (status) => !negativeStatusList.includes(status) && !positiveGoldStatusList.includes(status)
  );

  if (positiveBlueStatusList.includes(status)) {
    return "blue";
  }
  if (positiveGoldStatusList.includes(status)) {
    return "gold";
  }
  if (negativeStatusList.includes(status)) {
    return "red";
  }
  return "gray";
};

export const requestBossProductStatusChoices = [
  {
    label: "접수 대기",
    value: RequestBossProductStatusEnum.REQUESTED,
  },
  {
    label: "요청 접수",
    value: RequestBossProductStatusEnum.ACCEPTED,
  },
  {
    label: "보완 요청",
    value: RequestBossProductStatusEnum.REQ_ADDITIONAL,
  },
  {
    label: "협력사 매입가 검토",
    value: RequestBossProductStatusEnum.VENDOR_PRICE,
  },
  {
    label: "브랜드 판매가 검토",
    value: RequestBossProductStatusEnum.BRAND_PRICE,
  },
  {
    label: "견적 수정 요청",
    value: RequestBossProductStatusEnum.REQ_ESTIMATE_FIX,
  },
  {
    label: "확정 대기",
    value: RequestBossProductStatusEnum.PENDING_CONFIRM,
  },
  {
    label: "확정",
    value: RequestBossProductStatusEnum.CONFIRMED,
  },
  {
    label: "등록 완료",
    value: RequestBossProductStatusEnum.COMPLETED,
  },
  {
    label: "중단",
    value: RequestBossProductStatusEnum.CANCELED,
  },
];
export const getRequestBossProductStatusText = (status: RequestBossProductStatusEnum) => {
  const choice = requestBossProductStatusChoices.find((c) => c.value === status);
  if (choice) {
    return choice.label;
  }
  return "-";
};

export const checkIsStatusForRequested = (status: RequestBossProductStatusEnum) =>
  [
    RequestBossProductStatusEnum.REQUESTED,
    RequestBossProductStatusEnum.ACCEPTED,
    RequestBossProductStatusEnum.REQ_ADDITIONAL,
  ].includes(status);

export const checkIsStatusForEstimate = (status: RequestBossProductStatusEnum) =>
  [
    RequestBossProductStatusEnum.VENDOR_PRICE,
    RequestBossProductStatusEnum.BRAND_PRICE,
    RequestBossProductStatusEnum.REQ_ESTIMATE_FIX,
  ].includes(status);

export const checkIsStatusForConfirmed = (status: RequestBossProductStatusEnum) =>
  [RequestBossProductStatusEnum.PENDING_CONFIRM, RequestBossProductStatusEnum.CONFIRMED].includes(status);

export const checkIsStatusForCompleted = (status: RequestBossProductStatusEnum) =>
  [RequestBossProductStatusEnum.COMPLETED].includes(status);

export const checkIsStatusForCanceled = (status: RequestBossProductStatusEnum) =>
  [RequestBossProductStatusEnum.CANCELED].includes(status);

export const getReqBossProductUrlEnumByStatus = (status: RequestBossProductStatusEnum): ReqBossProductUrlEnum => {
  if (checkIsStatusForRequested(status)) {
    return ReqBossProductUrlEnum.REQUESTED;
  } else if (checkIsStatusForEstimate(status)) {
    return ReqBossProductUrlEnum.ESTIMATE;
  } else if (checkIsStatusForConfirmed(status)) {
    return ReqBossProductUrlEnum.CONFIRMED;
  } else if (checkIsStatusForCompleted(status)) {
    return ReqBossProductUrlEnum.COMPLETED;
  } else if (checkIsStatusForCanceled(status)) {
    return ReqBossProductUrlEnum.ALL;
  } else {
    return null;
  }
};

export const getRequestBossProductGroupStatusText = (status: RequestBossProductStatusEnum, user: User) => {
  if (!user || !status) {
    return "-";
  }
  const { isStaff, isHqStaff } = user;
  const targetFn = isStaff ? getReqBossProductNavButtonName : isHqStaff ? getHqReqBossProductNavButtonName : null;
  const urlEnum = getReqBossProductUrlEnumByStatus(status);
  const buttonName = targetFn(urlEnum);
  return buttonName || "-";
};

export const transformReqByProductVariant = (byProductVariant: boolean) =>
  byProductVariant ? "포장보스 상품 선택" : "직접 입력";
</file>

