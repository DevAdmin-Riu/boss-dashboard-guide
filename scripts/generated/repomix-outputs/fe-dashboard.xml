      maybe(() => params.deliveryStatus.map((status) => findInEnum(status, FulfillmentDeliveryStatusFilter))) || [],
    deliveryMethods:
      maybe(() => params.deliveryMethods.map((status) => findInEnum(status, OrderDeliveryMethodsEnum))) || [],
    isPickingOrder: params.isPickingOrder !== undefined ? parseBoolean(params.isPickingOrder, false) : undefined,
    orderType: maybe(() => params.orderType.map((status) => findInEnum(status, OrderTypeEnum))),
  };
}

function getCommonDeliveryListUrlFilterVariables(params: OrderDeliveryListViewUrlFilters): FulfillmentFilterInput {
  return {
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
