import { PurchaseBulkPending, PurchaseBulkPendingVariables } from "./types/PurchaseBulkPending";
import { PurchaseCancel, PurchaseCancelVariables } from "./types/PurchaseCancel";

const purchaseCancelMutation = gql`
  ${statsErrorFragment}
  mutation PurchaseCancel($id: ID!) {
    purchaseCancel(id: $id) {
      errors: statsErrors {
        ...StatsErrorFragment
      }
      purchase {
        id
        status
      }
    }
  }
`;
export const usePurchaseCancelMutation = makeMutation<PurchaseCancel, PurchaseCancelVariables>(purchaseCancelMutation);

const purchaseBulkCloseMutation = gql`
  ${statsErrorFragment}
  mutation PurchaseBulkClose($ids: [ID]!, $purchaseCloseDate: Date!) {
    purchaseBulkClose(ids: $ids, purchaseCloseDate: $purchaseCloseDate) {
      errors: statsErrors {
        ...StatsErrorFragment
      }
    }
  }
`;
export const usePurchaseBulkCloseMutation = makeMutation<PurchaseBulkClose, PurchaseBulkCloseVariables>(
  purchaseBulkCloseMutation
);

const purchaseBulkPendingMutation = gql`
  ${statsErrorFragment}
  mutation PurchaseBulkPending($ids: [ID]!, $purchaseCloseDate: Date!, $pendingReason: String) {
    purchaseBulkPending(ids: $ids, purchaseCloseDate: $purchaseCloseDate, pendingReason: $pendingReason) {
      errors: statsErrors {
        ...StatsErrorFragment
      }
      count
    }
  }
`;
export const usePurchaseBulkPendingMutation = makeMutation<PurchaseBulkPending, PurchaseBulkPendingVariables>(
  purchaseBulkPendingMutation
);

const purchaseUpdateMutation = gql`
  ${statsErrorFragment}
  mutation PurchaseUpdate($id: ID!, $input: PurchaseUpdateInput!) {
    purchaseUpdate(id: $id, input: $input) {
      errors: statsErrors {
        ...StatsErrorFragment
      }
      purchase {
        id
        status
        costPriceExcludeVat
        devCostExcludeVat
        b2bDeliveryFeeExcludeVat
        etcExcludeVat
        vatAmount
        vendorId
        parameters
        purchaseOrderLine {
          id
          quantity
        }
      }
    }
  }
`;
export const usePurchaseUpdateMutation = makeMutation<PurchaseUpdate, PurchaseUpdateVariables>(purchaseUpdateMutation);
</file>

