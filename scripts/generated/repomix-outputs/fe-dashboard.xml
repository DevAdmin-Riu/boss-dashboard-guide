<file path="src/app/views/brand/brands/components/BrandProductListTable/utils.ts">
import { utils } from "@utils/utils";

import {
  BrandProductList_brandProducts_edges_node_brandProductVariants,
  BrandProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions,
} from "../../api/types/BrandProductList";
import { BrandProductAndBrandProductPackageType } from "../../views/BrandProductListView/types";
import { checkIsPackageProduct } from "../BrandProductListPage/utils";
import { BrandProductDataSourceType } from "./BrandProductListTable";

export const getBrandProductNameText = (brandProductRow: BrandProductDataSourceType) => {
  const productName = brandProductRow?.product?.name || "-";
  const variantName = brandProductRow?.brandProductVariant?.productVariant?.name || "";
  const nameText = `${productName}` + (utils.isEmpty(variantName) ? "" : `(${variantName})`);

  return nameText;
};

export const getSelectedBrandProductVariantOrRegion = (
  record: BrandProductDataSourceType
):
  | BrandProductList_brandProducts_edges_node_brandProductVariants
  | BrandProductList_brandProducts_edges_node_brandProductVariants_brandProductVariantRegions =>
  record?.brandProductVariant;

const getDefaultBrandProductVariant = (brandProduct: BrandProductAndBrandProductPackageType) => {
  const { brandProductVariants } = brandProduct;
  if (utils.isEmpty(brandProductVariants) || brandProductVariants.length === 0) {
    return null;
  }

  const defaultBrandProductVariant = brandProductVariants?.find(
    (bpv) => bpv?.variantId === brandProduct?.product?.defaultVariantId
  );
  if (utils.isEmpty(defaultBrandProductVariant)) {
    return brandProductVariants[0];
  }
  return defaultBrandProductVariant;
};

const getBrandProductVariantsExcludeDefault = (brandProduct: BrandProductAndBrandProductPackageType) => {
  const { brandProductVariants } = brandProduct;
  const defaultBrandProductVariant = getDefaultBrandProductVariant(brandProduct);
  if (utils.isEmpty(brandProductVariants) || utils.isEmpty(defaultBrandProductVariant)) {
    return [];
  }
  return brandProductVariants.filter((bpv) => bpv?.id !== defaultBrandProductVariant?.id);
};

// 브랜드 상품 리스트 중 패키지 상품 외의 상품들을 rows로 변환
// withChildren이 true인 경우, children을 포함하여 rows를 반환 / false인 경우, children을 flat하게 펼쳐서 같은 뎁스로 반환
export const getBrandProductRows = (
  brandProducts: BrandProductAndBrandProductPackageType[],
  withChildren: boolean
): BrandProductDataSourceType[] => {
  const rows: BrandProductDataSourceType[] = [];
  brandProducts.forEach((brandProduct: BrandProductAndBrandProductPackageType) => {
    const defaultBrandProductVariant = getDefaultBrandProductVariant(brandProduct);
    const commonRow = { ...brandProduct, brandProductVariant: defaultBrandProductVariant };
    // 패키지 상품인 경우, rows에 추가하지 않음
    if (checkIsPackageProduct(brandProduct)) {
      return;
    }
    if (utils.isEmpty(defaultBrandProductVariant)) {
      return;
    }

    const brandProductVariantsExcludeDefault = getBrandProductVariantsExcludeDefault(brandProduct);

    const row = {
      ...commonRow,
      brandProductVariantRegion: null,
      children:
        brandProductVariantsExcludeDefault?.length > 0
          ? brandProductVariantsExcludeDefault.map((bpv) => ({
              ...brandProduct,
              brandProductVariant: bpv,
              brandProductVariantRegion: null,
            }))
          : null,
    };

    if (withChildren) {
      rows.push(row);
    } else {
      rows.push({ ...row, children: null });
      if (!!row?.children && row.children.length > 0) {
        row.children.forEach((bpvChild) => {
          rows.push({ ...bpvChild, children: null });
        });
      }
    }
  });
  return rows;
};

// 브랜드 상품 리스트 중 패키지 상품들을 rows로 변환
export const getBrandProductPackageRows = (
  brandProducts: BrandProductAndBrandProductPackageType[]
): BrandProductDataSourceType[] => {
  const rows: BrandProductDataSourceType[] = [];
  brandProducts
    .filter((item) => checkIsPackageProduct(item))
    .forEach((item) => {
      const row = {
        brandProductVariant: null,
        brandProductVariantRegion: null,
        product: null,
        children: null,
        ...item,
      };
      rows.push(row);
    });
  return rows;
};
</file>

