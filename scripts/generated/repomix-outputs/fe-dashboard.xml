export const getClosestNeedToStockPurchaseOrderLine = (
  productVariant: Pick<
    | ProductVariantList_productVariants_edges_node
    | BrandProductList_brandProducts_edges_node_brandProductVariants_productVariant,
    "needToStockPurchaseOrderLines"
  >,
  rank: number = 1
):
  | ProductVariantList_productVariants_edges_node_needToStockPurchaseOrderLines
  | BrandProductList_brandProducts_edges_node_brandProductVariants_productVariant_needToStockPurchaseOrderLines => {
  const lines = productVariant?.needToStockPurchaseOrderLines || [];
  if (!productVariant || lines.length === 0) {
    return null;
  }
  const validLines = lines.filter((line) => !utils.isEmpty(line.expectedPurchaseDate));

  if (validLines.length === 0) {
    return null;
  }

  const sortedLines = [...validLines].sort(
    (a, b) => moment(a.expectedPurchaseDate).valueOf() - moment(b.expectedPurchaseDate).valueOf()
  );

  // rank 는 1-based index → 배열 인덱스로 바꿔줌
  return sortedLines[rank - 1] || null;
};

