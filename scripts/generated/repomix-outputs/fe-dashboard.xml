import useMetadataChangeTrigger from "@src/api/core/metadata/useMetadataChangeTrigger";
import { ProductVariantFragment_inspectReportTemplate } from "@src/api/fragments/types/ProductVariantFragment";
import { SearchWarehouses_search_edges_node } from "@src/api/searches/types/SearchWarehouses";
import {
  PriorityLevelEnum,
  QtyPerBoxUnitTypeEnum,
  SalesStatusEnum,
  SalesUnitTypeEnum,
  StockInput,
} from "@src/api/types/globalTypes";
import { MetadataFormData } from "@src/app/components/Metadata";
import { ProductForCreateVariant_product } from "@src/app/views/product/products/api/types/ProductForCreateVariant";
import {
  getAttributeInputFromVariant,
  getVariantAttributeInputFromProduct,
} from "@src/app/views/product/products/utils/data";
import { getMakerLabel } from "@src/app/views/purchase/vendors/utils";
import { maybe } from "@utils/misc";
import React from "react";

import { ProductVariantDetails_productVariant } from "../../api/types/ProductVariantDetails";
import { calcPackCount } from "../../utils/utils";
import { ProductAttributeInput, ProductAttributeInputData } from "../ProductAttributes";

interface ProductVariantCreateFormData extends MetadataFormData {
  salesStatus: SalesStatusEnum;
  qtyPerBox: number;
  qtyPerBoxUnitType: QtyPerBoxUnitTypeEnum;
  priorityLevel: PriorityLevelEnum;
  salesUnitType: SalesUnitTypeEnum;
  boxLength: number;
  boxWidth: number;
  boxHeight: number;
  palletQty: number | null;
  palletM: number | null;
  palletN: number | null;
  palletO: number | null;
  maker: string;
  makerLabel: string;
  trackInventory: boolean;
  isVendorTrackInventory: boolean;
  allowAutoConsignment: boolean;
  isAdjustPrice: boolean;
  qtyPerDeliveryBox: number;
  autoTurnOffAllowAutoConsignment: boolean;
  isSubPv: boolean;
  canSaleByInner: boolean;
  requiredExpDateMgmt: boolean;
  note: string;
  poNote: string;
  isSeasonal: boolean;
  peakSeasonStartDate: string | null;
  peakSeasonEndDate: string | null;
  stockAdjustFactor: number;
  basicStockQty: number;
  safetyStockQty: number;
  rop: number;
  stocks: StockInput[];
  // 이너박스 정보(직배송 제품인 경우는 무관)
  innerMoq: number;
  innerUoq: number;
  packCount: number;
  innerQtyPerBox: number;
  innerBoxLength: number;
  innerBoxWidth: number;
  innerBoxHeight: number;
  innerStocks: StockInput[];
  innerSalesStatus: SalesStatusEnum;

  forceSoldOutNotice: boolean;
  innerForceSoldOutNotice: boolean;

  // 기본 협력사
  defaultPvvVendorCode: string;
  defaultPvvIsActive: boolean;
  defaultPvvExternalSku: string;
  defaultPvvExternalProductName: string;
  defaultPvvProductPriceExcludeVat: number;
  defaultPvvDeliveryFeeExcludeVat: number;
  defaultPvvConsignmentProductPriceExcludeVat: number;
  defaultPvvConsignmentDeliveryFeeExcludeVat: number;
  defaultPvvLeadTime: number;
  defaultPvvMoq: number;
  defaultPvvUoq: number;
  defaultPvvNote: string;
  defaultPvvNoteForUnitPrice: string;
  defaultPvvPricingBasisQty: number;

  priceDecimalPlaces: number;
  orderQtyDecimalPlaces: number;

  // 검수 정보
  needToInspect: boolean;
  inspectReason: string;
  inspectType: string;
  inspectMemo: string;
  inspectReportTemplate: ProductVariantFragment_inspectReportTemplate;

  countryOfOrigin: string | null;
}
export interface ProductVariantCreateData extends ProductVariantCreateFormData {
  attributes: ProductAttributeInput[];
  hasVariants: boolean;
  isDevPv: boolean;
  isForCreditsRefill: boolean;
}

interface UseProductVariantCreateFormOpts {
  warehouses: SearchWarehouses_search_edges_node[];
}

interface UseProductVariantCreateFormResult {
  change: FormChange;
  data: ProductVariantCreateData;
  // TODO: type FormsetChange
  handlers: Record<"selectAttribute", FormsetChange> & {
    changeMetadata: FormChange;
  };
  hasChanged: boolean;
  submit: () => void;
}

interface ProductVariantCreateFormProps extends UseProductVariantCreateFormOpts {
  children: (props: UseProductVariantCreateFormResult) => React.ReactNode;
  product: ProductForCreateVariant_product;
  copyVariant?: ProductVariantDetails_productVariant;
  onSubmit: (data: ProductVariantCreateData) => void;
}

const initial: ProductVariantCreateFormData = {
  salesStatus: undefined,
  innerSalesStatus: undefined,
  forceSoldOutNotice: false,
  innerForceSoldOutNotice: false,
  qtyPerBox: undefined,
  qtyPerBoxUnitType: undefined,
  priorityLevel: undefined,
  salesUnitType: undefined,
  boxLength: undefined,
  boxWidth: undefined,
  boxHeight: undefined,
  palletQty: undefined,
  palletM: undefined,
  palletN: undefined,
  palletO: undefined,
  maker: undefined,
  makerLabel: "",
  metadata: [],
  privateMetadata: [],
  trackInventory: true,
  isVendorTrackInventory: false,
  allowAutoConsignment: false,
  isAdjustPrice: false,
  qtyPerDeliveryBox: undefined,
  autoTurnOffAllowAutoConsignment: false,
  isSubPv: false,
  canSaleByInner: false,
  requiredExpDateMgmt: false,
  note: "",
  poNote: "",
  isSeasonal: false,
  peakSeasonStartDate: null,
  peakSeasonEndDate: null,
  stockAdjustFactor: 0,
  basicStockQty: undefined,
  safetyStockQty: undefined,
  rop: undefined,
  stocks: [],
  innerMoq: 1,
  innerUoq: 1,
  packCount: undefined,
  innerQtyPerBox: undefined,
  innerBoxLength: undefined,
  innerBoxWidth: undefined,
  innerBoxHeight: undefined,
  innerStocks: [],
  defaultPvvVendorCode: undefined,
  defaultPvvIsActive: true,
  defaultPvvExternalSku: "",
  defaultPvvExternalProductName: "",
  defaultPvvProductPriceExcludeVat: undefined,
  defaultPvvDeliveryFeeExcludeVat: undefined,
  defaultPvvConsignmentProductPriceExcludeVat: undefined,
  defaultPvvConsignmentDeliveryFeeExcludeVat: undefined,
  defaultPvvLeadTime: undefined,
  defaultPvvMoq: undefined,
  defaultPvvUoq: undefined,
  defaultPvvNote: "",
  defaultPvvNoteForUnitPrice: "",
  defaultPvvPricingBasisQty: undefined,
  priceDecimalPlaces: 0,
  orderQtyDecimalPlaces: 0,
  needToInspect: false,
  inspectReason: undefined,
  inspectType: undefined,
  inspectMemo: undefined,
  inspectReportTemplate: undefined,
  countryOfOrigin: undefined,
};

function useProductVariantCreateForm(
  product: ProductForCreateVariant_product,
  copyVariant: ProductVariantDetails_productVariant,
  onSubmit: (data: ProductVariantCreateData) => void,
  _opts: UseProductVariantCreateFormOpts
): UseProductVariantCreateFormResult {
  const [changed, setChanged] = React.useState(false);
  const triggerChange = () => setChanged(true);

  // copyVariant가 있으면 해당 데이터로 초기값 설정
  const initialData: ProductVariantCreateFormData = copyVariant
    ? {
        ...initial,
        salesStatus: copyVariant.salesStatus,
        innerSalesStatus: copyVariant.inner.salesStatus,
        forceSoldOutNotice: copyVariant.forceSoldOutNotice,
        innerForceSoldOutNotice: copyVariant.inner.forceSoldOutNotice,
        qtyPerBox: copyVariant.qtyPerBox,
        qtyPerBoxUnitType: copyVariant.qtyPerBoxUnitType,
        priorityLevel: copyVariant.priorityLevel,
        salesUnitType: copyVariant.salesUnitType,
        boxLength: copyVariant.boxLength,
        boxWidth: copyVariant.boxWidth,
        boxHeight: copyVariant.boxHeight,
        palletQty: copyVariant.palletQty,
        palletM: copyVariant.palletM,
        palletN: copyVariant.palletN,
        palletO: copyVariant.palletO,
        maker: copyVariant.maker?.id,
        makerLabel: copyVariant.maker ? getMakerLabel(copyVariant.maker) : "",
        trackInventory: copyVariant.trackInventory,
        allowAutoConsignment: copyVariant.allowAutoConsignment,
        isAdjustPrice: copyVariant.isAdjustPrice || false,
        qtyPerDeliveryBox: copyVariant.qtyPerDeliveryBox,
        autoTurnOffAllowAutoConsignment: copyVariant.autoTurnOffAllowAutoConsignment,
        isSubPv: copyVariant.isSubPv,
        canSaleByInner: copyVariant.canSaleByInner,
        requiredExpDateMgmt: copyVariant.requiredExpDateMgmt,
        note: copyVariant.note || "",
        poNote: copyVariant.poNote || "",
        isSeasonal: copyVariant.isSeasonal || false,
        peakSeasonStartDate: copyVariant.peakSeasonStartDate || null,
        peakSeasonEndDate: copyVariant.peakSeasonEndDate || null,
        stockAdjustFactor: copyVariant.stockAdjustFactor || 0,
        basicStockQty: copyVariant.basicStockQty,
        safetyStockQty: copyVariant.safetyStockQty,
        rop: copyVariant.rop7,
        innerMoq: copyVariant.inner.innerMoq || 1,
        innerUoq: copyVariant.inner.innerUoq || 1,
        packCount: maybe(() => calcPackCount(copyVariant, copyVariant.inner), null),
        innerQtyPerBox: copyVariant.inner.qtyPerBox,
        innerBoxLength: copyVariant.inner.boxLength,
        innerBoxWidth: copyVariant.inner.boxWidth,
        innerBoxHeight: copyVariant.inner.boxHeight,
        countryOfOrigin: copyVariant.countryOfOrigin?.code || null,
        priceDecimalPlaces: copyVariant.priceDecimalPlaces || 0,
        orderQtyDecimalPlaces: copyVariant.orderQtyDecimalPlaces || 0,
        needToInspect: copyVariant.needToInspect || false,
        inspectReason: copyVariant.inspectReason,
        inspectType: copyVariant.inspectType,
        inspectMemo: copyVariant.inspectMemo,
        inspectReportTemplate: copyVariant.inspectReportTemplate,
      }
    : initial;

  const form = useForm(initialData);
  const attributes = useFormset<ProductAttributeInputData>(
    copyVariant ? getAttributeInputFromVariant(copyVariant) : getVariantAttributeInputFromProduct(product)
  );
  const { makeChangeHandler: makeMetadataChangeHandler } = useMetadataChangeTrigger();

  const handleChange: FormChange = (event, cb) => {
    form.change(event, cb);
    triggerChange();
  };
  const changeMetadata = makeMetadataChangeHandler(handleChange);
  const handleAttributeChange: FormsetChange = (id, value) => {
    attributes.change(id, value === "" ? [] : [value]);
    triggerChange();
  };

  const data: ProductVariantCreateData = {
    ...form.data,
    attributes: attributes.data,
    hasVariants: true,
    isDevPv: false,
    isForCreditsRefill: false,
  };

  const submit = () => onSubmit(data);

  return {
    change: handleChange,
    data,
    handlers: {
      changeMetadata,
      selectAttribute: handleAttributeChange,
    },
    hasChanged: changed,
    submit,
  };
}

export const ProductVariantCreateForm: React.FC<ProductVariantCreateFormProps> = ({
  children,
  product,
  copyVariant,
  onSubmit,
  ...rest
}) => {
  const props = useProductVariantCreateForm(product, copyVariant, onSubmit, rest);

  return <form onSubmit={props.submit}>{children(props)}</form>;
};
