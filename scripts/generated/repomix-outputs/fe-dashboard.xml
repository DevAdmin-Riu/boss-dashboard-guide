<file path="src/app/views/hqStaff/hqPreFounder/components/PfConsultationCommentList.tsx">
import { preFounderConsultationForHqDetailsFragment } from "@src/api/fragments/preFounder";
import { PfConsultationCommentCreateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { updateMultipleFragments } from "@src/app/providers/ApolloClientProvider/utils";
import { detailDateFormat, getDateByFormat } from "@src/app/providers/DateProvider";
import { StrictOmit } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Comment, CommentProps, Divider, Form, Input, List, Row, Space, Typography } from "antd";
import { ListItemProps } from "antd/lib/list";
import moment from "moment";
import React from "react";

import { usePfConsultationCommentCreateMutation, usePfConsultationCommentDeleteMutation } from "../api/mutations";
import {
  HqPreFounderConsultationDetails_preFounderConsultation,
  HqPreFounderConsultationDetails_preFounderConsultation_comments,
} from "../api/types/HqPreFounderConsultationDetails";
import { PfConsultationCommentDeleteVariables } from "../api/types/PfConsultationCommentDelete";

type TPfConsultationCommentCreateFormData = StrictOmit<PfConsultationCommentCreateInput, "consultation">;

interface PfConsultationCommentListProps {
  consultation: HqPreFounderConsultationDetails_preFounderConsultation;
}

export const PfConsultationCommentList: React.FC<PfConsultationCommentListProps> = (props) => {
  const { consultation } = props;
  const comments = maybe(() => consultation.comments, []);
  const [createForm] = Form.useForm<TPfConsultationCommentCreateFormData>();
  const [replyCreateForm] = Form.useForm<TPfConsultationCommentCreateFormData>();
  const [deleteForm] = Form.useForm<PfConsultationCommentDeleteVariables>();
  const CreateTypeSafeForm = getTypeSafeForm<TPfConsultationCommentCreateFormData>(createForm);
  const ReplyCreateTypeSafeForm = getTypeSafeForm<TPfConsultationCommentCreateFormData>(replyCreateForm);
  const DeleteTypeSafeForm = getTypeSafeForm<PfConsultationCommentDeleteVariables>(deleteForm);

  const createContentWatched = CreateTypeSafeForm.getUseFormWatched({ name: "content" });
  const replyContentWatched = ReplyCreateTypeSafeForm.getUseFormWatched({ name: "content" });
  const parentIdToReplyWatched = ReplyCreateTypeSafeForm.getUseFormWatched({ name: "parent" });
  const idToDeleteWatched = DeleteTypeSafeForm.getUseFormWatched({ name: "id" });

  const replyInitialValues: TPfConsultationCommentCreateFormData = { parent: undefined, content: undefined };
  const deleteInitialValues: PfConsultationCommentDeleteVariables = { id: undefined };

  const [pfConsultationCommentCreate, pfConsultationCommentCreateOpts] = usePfConsultationCommentCreateMutation({
    onCompleted: (data) => {
      const createdComment = data.pfConsultationCommentCreate.pfConsultationComment;
      const parentExist = !!createdComment?.parent;
      const successMsg = parentExist ? "답글이 등록되었습니다." : "댓글이 등록되었습니다.";
      utils.handleOnCompletedWithError(data.pfConsultationCommentCreate.errors, successMsg, () => {
        if (parentExist) {
          replyCreateForm.resetFields();
        } else {
          createForm.resetFields();
        }
      });
    },
  });
  const [pfConsultationCommentDelete, pfConsultationCommentDeleteOpts] = usePfConsultationCommentDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.pfConsultationCommentDelete.errors, "댓글이 삭제되었습니다.", () => {
        deleteForm.resetFields();
      }),
  });

  const onCreate = (formData: TPfConsultationCommentCreateFormData) => {
    const input: PfConsultationCommentCreateInput = {
      ...formData,
      consultation: consultation.id,
    };
    pfConsultationCommentCreate({
      variables: { input },
      update: (cache, { data }) => {
        const newComment = data.pfConsultationCommentCreate.pfConsultationComment;
        if (!newComment) {
          return;
        }

        const consultationCacheId = cache.identify({ __typename: consultation.__typename, id: consultation.id });
        const updateFragment = preFounderConsultationForHqDetailsFragment;
        updateMultipleFragments({
          cache,
          cacheId: consultationCacheId,
          updates: [
            {
              fragment: updateFragment,
              fragmentName: "PreFounderConsultationForHqDetailsFragment",
              fieldName: "comments",
              updateFn: (prev) => {
                if (newComment.level === 0) {
                  return [...prev, { ...newComment, children: [] }];
                } else {
                  return prev.map((parentComment) => {
                    if (parentComment.id === input.parent) {
                      return { ...parentComment, children: [...(parentComment.children || []), newComment] };
                    }
                    return parentComment;
                  });
                }
              },
            },
          ],
        });
      },
    });
  };
  const onDelete = (formData: PfConsultationCommentDeleteVariables) => {
    pfConsultationCommentDelete({ variables: formData });
  };

  const makeCommentCreatedAtText = (createdAt: string) => {
    // 일정 시간 이내면 "몇 분 전", "몇 시간 전"으로 표시
    const now = moment();
    const createdDate = moment(createdAt);
    const diffInMs = now.diff(createdDate);
    const diffInMinutes = Math.floor(diffInMs / (1000 * 60));
    const diffInHours = Math.floor(diffInMs / (1000 * 60 * 60));

    if (diffInMinutes < 1) {
      return "방금 전";
    } else if (diffInMinutes < 60) {
      return `${diffInMinutes}분 전`;
    } else if (diffInHours < 24) {
      return `${diffInHours}시간 전`;
    }
    return getDateByFormat(createdAt, detailDateFormat);
  };

  const makeListItemProps = (): ListItemProps => ({ style: { padding: "0 24px" } });

  const makeCommentProps = (
    comment: Pick<
      HqPreFounderConsultationDetails_preFounderConsultation_comments,
      "id" | "createdAt" | "writer" | "level" | "isActive" | "content"
    >
  ): CommentProps => {
    const actionNodes = [];
    const { level, isActive } = comment;
    if (level === 0) {
      actionNodes.push(
        <Typography.Link
          key="reply"
          type="secondary"
          onClick={() => ReplyCreateTypeSafeForm.setFields([{ name: "parent", value: comment.id }])}
        >
          답글
        </Typography.Link>
      );
    }
    if (isActive) {
      actionNodes.push(
        <Typography.Link
          key="delete"
          type="secondary"
          onClick={() => DeleteTypeSafeForm.setFields([{ name: "id", value: comment.id }])}
        >
          삭제
        </Typography.Link>
      );
    }

    return {
      datetime: makeCommentCreatedAtText(comment.createdAt),
      author: comment.writer.firstName,
      content: (
        <Typography.Text type={comment.isActive ? undefined : "secondary"} style={{ whiteSpace: "pre-wrap" }}>
          {comment.content}
        </Typography.Text>
      ),
      actions: [
        <Space size="small" split={<Divider type="vertical" />}>
          {actionNodes}
        </Space>,
      ],
    };
  };

  const commentSubmitButtonWidth: React.CSSProperties["width"] = "80px";
  const contentInputWidth: React.CSSProperties["width"] = `calc(100vh - ${commentSubmitButtonWidth} + 10px)`;
  const contentHeight: React.CSSProperties["height"] = "64px";
  const replyContentHeight: React.CSSProperties["height"] = "48px";

  return (
    <Card>
      <Typography.Title level={5}>{`댓글 (${comments.length})`}</Typography.Title>
      <Space direction="vertical" size="large">
        <Form name="pf-consultation-comment-create" form={createForm} onFinish={onCreate}>
          <Input.Group compact>
            <Form.Item name={CreateTypeSafeForm.getValidDataIndex("content")}>
              <Input.TextArea
                style={{ width: contentInputWidth, height: contentHeight }}
                showCount
                maxLength={500}
                placeholder="댓글을 입력하세요."
              />
            </Form.Item>
            <Button
              style={{ width: commentSubmitButtonWidth, height: contentHeight }}
              type="primary"
              loading={pfConsultationCommentCreateOpts.loading}
              disabled={utils.isEmpty(createContentWatched, true)}
              onClick={createForm.submit}
            >
              등록
            </Button>
          </Input.Group>
        </Form>

        <Form
          name="pf-consultation-reply-comment-create"
          form={replyCreateForm}
          initialValues={replyInitialValues}
          onFinish={onCreate}
        >
          <Form.Item hidden name={ReplyCreateTypeSafeForm.getValidDataIndex("parent")}>
            <Input />
          </Form.Item>
          <List
            bordered
            itemLayout="vertical"
            dataSource={comments}
            renderItem={(comment) => (
              <List.Item key={comment.id} {...makeListItemProps()}>
                <Comment {...makeCommentProps(comment)}>
                  {comment.children && comment.children.length > 0 && (
                    <>
                      <Divider />
                      <List
                        itemLayout="vertical"
                        dataSource={comment.children}
                        renderItem={(childComment) => (
                          <List.Item key={childComment.id} {...makeListItemProps()}>
                            <Comment {...makeCommentProps(childComment)} />
                          </List.Item>
                        )}
                      />
                    </>
                  )}
                  {!!parentIdToReplyWatched && parentIdToReplyWatched === comment.id && (
                    <>
                      <Form.Item name={ReplyCreateTypeSafeForm.getValidDataIndex("content")}>
                        <Input.TextArea
                          style={{ height: replyContentHeight }}
                          showCount
                          maxLength={500}
                          placeholder="답글을 입력하세요."
                        />
                      </Form.Item>
                      <Row justify="end" style={{ marginBottom: 12 }}>
                        <Space size="small">
                          <Button size="small" onClick={() => replyCreateForm.resetFields()}>
                            취소
                          </Button>
                          <Button
                            size="small"
                            type="primary"
                            loading={pfConsultationCommentCreateOpts.loading}
                            disabled={utils.isEmpty(replyContentWatched, true)}
                            onClick={replyCreateForm.submit}
                          >
                            등록
                          </Button>
                        </Space>
                      </Row>
                    </>
                  )}
                </Comment>
              </List.Item>
            )}
            locale={{ emptyText: "등록된 댓글이 없습니다." }}
          />
        </Form>
      </Space>

      <Form
        name="pf-consultation-comment-delete"
        form={deleteForm}
        initialValues={deleteInitialValues}
        onFinish={onDelete}
      >
        <Form.Item hidden name={DeleteTypeSafeForm.getValidDataIndex("id")}>
          <Input />
        </Form.Item>
        <ConfirmModal
          visible={!!idToDeleteWatched}
          modalTitleText="댓글 삭제"
          titleText="댓글을 삭제하시겠습니까?"
          onOk={deleteForm.submit}
          onCancel={() => deleteForm.resetFields()}
          okText="삭제"
          okButtonProps={{ danger: true, type: "primary", loading: pfConsultationCommentDeleteOpts.loading }}
        />
      </Form>
    </Card>
  );
};
</file>

