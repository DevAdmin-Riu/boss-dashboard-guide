import { FulfillmentSortField } from "@src/api/types/globalTypes";
import { OrderDeliveryListViewUrlSortField } from "@src/app/views/order/orders/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: OrderDeliveryListViewUrlSortField): FulfillmentSortField {
  switch (sort) {
    case OrderDeliveryListViewUrlSortField.orderCreated:
      return FulfillmentSortField.ORDER_CREATION_DATE;
    case OrderDeliveryListViewUrlSortField.status:
      return FulfillmentSortField.STATUS;
    case OrderDeliveryListViewUrlSortField.created:
      return FulfillmentSortField.CREATION_DATE;
    default:
      return FulfillmentSortField.NUMBER;
  }
}

export const getDeliveryListSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
</file>

<file path="src/app/views/order/orders/views/OrderDeliveryReprintListView/filters.ts">
import {
  FulfillmentFilterInput,
  FulfillmentStatusFilter,
  OrderDeliveryMethodsEnum,
  TrackingNumberTypeFilter,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { ISOFormatWithTimeZone, onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  OrderDeliveryReprintFilterKeys,
  OrderDeliveryReprintListFilterOpts,
} from "@src/app/views/order/orders/components/OrderDeliveryReprintListPage/filters";
import {
  OrderDeliveryReprintListViewUrlFilters,
  OrderDeliveryReprintListViewUrlFiltersEnum,
  OrderDeliveryReprintListViewUrlFiltersWithMultipleValuesEnum,
  OrderDeliveryReprintListViewUrlQueryParams,
} from "@src/app/views/order/orders/urls";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { isOrderDeliveryReprintViewPickingOrder } from "../../components/OrderDeliveryReprintListPage/utils";

export const ORDER_REPRINT_FILTERS_KEY = "orderDeliveryReprintFilters";

export function getFilterOpts(params: OrderDeliveryReprintListViewUrlFilters): OrderDeliveryReprintListFilterOpts {
  const filterVariables = getDeliveryReprintListFilterVariables(params);
  const todayMoment = moment();

  return {
    orderCreated: {
      active: maybe(() => !utils.allEmpty([filterVariables.orderCreated.gte, filterVariables.orderCreated.lte]), false),
      value: {
        max: maybe(() => filterVariables.orderCreated.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.orderCreated.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    deliveryStartDateTime: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.deliveryStartDateTime.gte, filterVariables.deliveryStartDateTime.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.deliveryStartDateTime.lte, todayMoment.format(ISOFormatWithTimeZone)),
        min: maybe(() => filterVariables.deliveryStartDateTime.gte, todayMoment.format(ISOFormatWithTimeZone)),
      },
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: filterVariables.productSearch,
    },
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<OrderDeliveryReprintFilterKeys>
): OrderDeliveryReprintListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case OrderDeliveryReprintFilterKeys.orderCreated:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryReprintListViewUrlFiltersEnum.orderCreatedFrom,
        OrderDeliveryReprintListViewUrlFiltersEnum.orderCreatedTo
      );
    case OrderDeliveryReprintFilterKeys.deliveryStartDateTime:
      return getMinMaxQueryParam(
        filter,
        OrderDeliveryReprintListViewUrlFiltersEnum.deliveryStartDateTimeFrom,
        OrderDeliveryReprintListViewUrlFiltersEnum.deliveryStartDateTimeTo
      );
    case OrderDeliveryReprintFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryReprintListViewUrlFiltersEnum.brandSearch);
    case OrderDeliveryReprintFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryReprintListViewUrlFiltersEnum.userSearch);
    case OrderDeliveryReprintFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, OrderDeliveryReprintListViewUrlFiltersEnum.productSearch);
  }
}

// 시스템에서 출고 처리는 되었지만, 배송 완료되지 않은 택배 배송건에 대한 필터
// 운송장 재출력, 재고 배송 검수(택배) 페이지에 사용됨
export function getFilterVariablesAvailableForDeliveryReprint(isPickingOrder: boolean): FulfillmentFilterInput {
  return {
    isPickingOrder,
    isFulfilledByVendor: false,
    isTrackInventoryFulfillment: isPickingOrder ? undefined : true,
    deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
    status: [FulfillmentStatusFilter.FULFILLED],
    trackingNumberType: TrackingNumberTypeFilter.GOODSFLOW,
    trackingCompleted: false,
  };
}

export function getDeliveryReprintListFilterVariables(
  params: OrderDeliveryReprintListViewUrlFilters
): FulfillmentFilterInput {
  const { orderDeliveryReprintListViewType } = params;
  const isViewPickingOrder = isOrderDeliveryReprintViewPickingOrder(orderDeliveryReprintListViewType);
  const filterVariablesAvailableForDeliveryReprint = getFilterVariablesAvailableForDeliveryReprint(isViewPickingOrder);

  return {
    ...filterVariablesAvailableForDeliveryReprint,
    orderCreated: getGteLteVariables({
      gte: params.orderCreatedFrom,
      lte: params.orderCreatedTo,
    }),
    deliveryStartDateTime: getGteLteVariables({
      gte: params.deliveryStartDateTimeFrom,
      lte: params.deliveryStartDateTimeTo,
    }),
    brandSearch: params.brandSearch,
    userSearch: params.userSearch,
    productSearch: params.productSearch,
  };
}

export function getDailyFulfillmentReportFilterVariables(): FulfillmentFilterInput {
  const todayMoment = moment();
  const targetDate = todayMoment.format(onlyDateFormat);
  return {
    deliveryStartDate: getGteLteVariables({
      gte: targetDate,
      lte: targetDate,
    }),
    deliveryMethods: [OrderDeliveryMethodsEnum.BY_COURIER],
    status: [FulfillmentStatusFilter.FULFILLED],
    isTrackInventoryFulfillment: true,
    trackingCompleted: false,
  };
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<OrderDeliveryReprintListViewUrlFilters>(ORDER_REPRINT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  OrderDeliveryReprintListViewUrlQueryParams,
  OrderDeliveryReprintListViewUrlFilters
>({
  ...OrderDeliveryReprintListViewUrlFiltersEnum,
  ...OrderDeliveryReprintListViewUrlFiltersWithMultipleValuesEnum,
});
