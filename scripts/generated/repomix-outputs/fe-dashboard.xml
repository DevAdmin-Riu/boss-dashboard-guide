  const [editingId, setEditingId] = useState<string>("");

  const [bpBundleInfoUpdate] = useBpBundleInfoUpdateMutation({
    onCompleted: (data) => {
      const errors = data.bpBundleInfoUpdate.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("구성품명을 수정했습니다.");
        setEditingId("");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bpBundleInfoSetMain] = useBpBundleInfoSetMainMutation({
    onCompleted: (data) => {
      const errors = data.bpBundleInfoSetMain.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("대표 구성품으로 설정했습니다.");
        refetchBpBundle();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const isEditing = (record: BpBundle_bpBundle_bpBundleInfos) => record.id === editingId;

  const edit = (record: BpBundle_bpBundle_bpBundleInfos) => {
    form.setFieldsValue({ name: record.name });
    setEditingId(record.id);
  };

  const save = async (id: string) => {
    const values = await form.validateFields();
    await bpBundleInfoUpdate({
      variables: {
        id,
        input: {
          name: values.name,
          quantity: 1,
        },
      },
    });
  };

  const cancel = () => {
    setEditingId("");
  };

  const setMain = (record: BpBundle_bpBundle_bpBundleInfos) => {
    bpBundleInfoSetMain({
      variables: {
        bpBundleInfoId: record.id,
      },
    });
  };

  const columns = getBrandBundleAddedListTableColumns(isEditing, edit, save, cancel, editingId, setMain);

  const rowSelection: TableRowSelection<BpBundle_bpBundle_bpBundleInfos> = {
    fixed: true,
    selectedRowKeys: bundleDeleteSelectedRowIds,
    onChange: (newSelectedRowKeys: React.Key[]) => {
      setBundleDeleteSelectedRowIds(newSelectedRowKeys);
    },
  };

  return (
    <Form form={form} component={false} onFinish={() => save(editingId)}>
      <Table
        {...commonTableProps}
        components={{
          body: {
            cell: EditableCell,
          },
        }}
        rowKey={(record) => record.id}
        rowSelection={rowSelection}
        columns={columns}
        dataSource={bpBundleInfo}
        scroll={{ x: "max-content", y: 480 }}
        sticky={false}
        loading={loading}
      />
    </Form>
  );
};

export default BrandBundleAddedList;
</file>

