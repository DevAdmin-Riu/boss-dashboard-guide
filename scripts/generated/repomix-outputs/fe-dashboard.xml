      const excludedStatuses = [
        PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
        PurchaseOrderLineStatusEnum.INSPECTED,
        PurchaseOrderLineStatusEnum.STOCKED,
      ];
      if (excludedStatuses.includes(statusChoice.value)) {
        return false;
      }
    }

    // B2B인 경우 분납 관련 상태 제외
    if (isB2b) {
      const excludedB2bStatuses = [PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY];
      if (excludedB2bStatuses.includes(statusChoice.value)) {
        return false;
      }
    }

    // 전체 발주 내역이 아닌 경우, 현재 페이지에 해당하는 상태만 표시
    if (!isAllStatus) {
      const currentPageStatuses = getStatusesFromUrlParam(status as PurchaseOrderLineUrlEnum, inventoryType);
      if (!currentPageStatuses.includes(statusChoice.value)) {
        return false;
      }
    }

    return true;
  });
  const showStatusFilter = poLineStatusEnumChoices.length > 1;

  const statusFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.status,
      "세부 진행 상태",
      opts.status.value,
      true,
      getPurchaseOrderLineStatusEnumChoices(isB2b).filter((statusChoice) => {
        // 재고발주가 아닌 경우 검수/입고 관련 상태 제외
        if (!isTrackInventory) {
          const excludedStatuses = [
            PurchaseOrderLineStatusEnum.TO_BE_INSPECTED,
            PurchaseOrderLineStatusEnum.INSPECTED,
            PurchaseOrderLineStatusEnum.STOCKED,
          ];
          if (excludedStatuses.includes(statusChoice.value)) {
            return false;
          }
        }

        // B2B인 경우 분납 관련 상태 제외
        if (isB2b) {
          const excludedB2bStatuses = [PurchaseOrderLineStatusEnum.REQ_SPLIT_DELIVERY];
          if (excludedB2bStatuses.includes(statusChoice.value)) {
            return false;
          }
        }

        // 전체 발주 내역이 아닌 경우, 현재 페이지에 해당하는 상태만 표시
        if (!isAllStatus) {
          const currentPageStatuses = getStatusesFromUrlParam(status as PurchaseOrderLineUrlEnum, inventoryType);
          if (!currentPageStatuses.includes(statusChoice.value)) {
            return false;
          }
        }

        return true;
      })
    ),
    active: opts.status.active,
    isRequired: true,
  };

  const isNotOrderableBeforeStockedFilter = {
    ...createBooleanField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.isNotOrderableBeforeStocked,
