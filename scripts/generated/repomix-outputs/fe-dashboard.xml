        return getNumberFormat(calcVatByPriceIncludeVat(record.issuedAmount, record.isTaxFree));
      }
      return getNumberFormat(calcVatByPriceIncludeVat(record.totalAmount, record.isTaxFree));
    },
    renderExcel: (record) => {
      if (record?.status === TaxInvoiceStatus.ISSUED) {
        return calcVatByPriceIncludeVat(record.issuedAmount, record.isTaxFree);
      }
      return calcVatByPriceIncludeVat(record.totalAmount, record.isTaxFree);
    },
  };
  const issuedAmountColumn: DownloadableColumnType<TaxInvoiceList_taxInvoiceList_edges_node> = {
    align: "right",
    title: columnNameConstant.tax.TOTAL_AMOUNT,
    key: "issuedAmount",
    width: 100,
    render: (_, record) => {
      if (record?.status === TaxInvoiceStatus.ISSUED) {
        return getNumberFormat(record.issuedAmount);
      }
      return getNumberFormat(record.totalAmount);
    },
    renderExcel: (record) => {
      if (record?.status === TaxInvoiceStatus.ISSUED) {
        return record.issuedAmount;
      }
      return record.totalAmount;
    },
  };
  const taxInvoicesIssuedColumn: DownloadableColumnType<TaxInvoiceList_taxInvoiceList_edges_node> = {
    align: "center",
    title: columnNameConstant.tax.ISSUE_STATUS,
    key: "taxInvoicesIssued",
    width: 140,
    render: (_, record) => {
      if (record?.status === TaxInvoiceStatus.CANCELED) {
        return "발행 취소";
      } else if (record?.status === TaxInvoiceStatus.REQUESTED) {
        return "미발행";
      } else if (record?.status === TaxInvoiceStatus.OFFLINE_ISSUED) {
        return "수기 발행 완료";
      } else if (record?.status === TaxInvoiceStatus.ISSUED) {
        return <TaxInvoiceViewButton {...props} taxInvoice={record} />;
      }
      return "-";
    },
    doNotRenderExcel: true,
    isPickerHide: true,
  };
  const invoicerBizInfoColumn = {
    title: "공급자",
    children: [invoicerBizRegCorpNameColumn, invoicerBizRegNoColumn, invoicerBizRegCeoNameColumn],
  };
  const invoiceeBizInfoColumn = {
    title: "공급받는자",
    children: [invoiceeBizRegCorpNameColumn, invoiceeBizRegNoColumn, invoiceeBizRegCeoNameColumn],
  };
  const brandInfoColumn = {
    title: "고객사 정보",
    children: [brandCodeColumn, brandNameColumn],
  };
  const mdInfoColumn = {
    title: "MD 정보",
    children: [mdNameColumn, mdPhoneColumn],
  };
  const taxInvoiceInfoColumn = {
    title: "세금계산서",
    children: [isTaxFreeColumn, issuedAmountExcludeVatColumn, issuedAmountVatColumn, taxInvoicesIssuedColumn].filter(
      Boolean
    ),
  };

  if (isStaff) {
    return [
      writeDateColumn,
      issuedDateColumn,
      brandInfoColumn,
      invoicerBizInfoColumn,
      invoiceeBizInfoColumn,
      mdInfoColumn,
      taxInvoiceInfoColumn,
    ].filter(Boolean);
  } else {
    return [
      taxInvoicesIssuedColumn,
      writeDateColumn,
      isTaxFreeColumn,
      issuedAmountExcludeVatColumn,
      issuedAmountVatColumn,
      issuedAmountColumn,
    ];
  }
};

export default getB2bTaxInvoiceTableSetting;
</file>

<file path="src/app/views/b2b/components/B2bTaxInvoiceListPage/filter.ts">
import { TaxInvoiceStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum B2bTaxInvoiceFilterKeys {
  orderSearch = "orderSearch",
  b2bBrandSearch = "b2bBrandSearch",
  userSearch = "userSearch",
  writedAt = "writedAt",
  issuedAt = "issuedAt",
  isTaxFree = "isTaxFree",
  isFromRiu = "isFromRiu",
  isToHq = "isToHq",
  status = "status",
}

export interface B2bTaxInvoiceListFilterOpts {
  writedAt: FilterOpts<MinMax>;
  issuedAt: FilterOpts<MinMax>;
  b2bBrandSearch: FilterOpts<string>;
  isTaxFree: FilterOpts<boolean>;
  status: FilterOpts<TaxInvoiceStatusEnum[]>;
}

export function createFilterStructure(
  opts: B2bTaxInvoiceListFilterOpts,
  isStaff: boolean
): IFilter<B2bTaxInvoiceFilterKeys> {
  let displayOrder = 0;

  const writedAtFilter = {
    ...createDateField(displayOrder++, B2bTaxInvoiceFilterKeys.writedAt, "작성일", opts.writedAt.value),
    active: opts.writedAt.active,
  };
  const issuedAtFilter = {
    ...createDateField(displayOrder++, B2bTaxInvoiceFilterKeys.issuedAt, "발행일", opts.issuedAt.value),
    active: opts.issuedAt.active,
  };
  const b2bBrandSearchFilter = {
    ...createTextField(
      displayOrder++,
      B2bTaxInvoiceFilterKeys.b2bBrandSearch,
      filterNameConstant.BRAND_SEARCH_FOR_B2B,
      opts.b2bBrandSearch.value
    ),
    active: opts.b2bBrandSearch.active,
  };

  const statusFilter = {
    ...createOptionsField(displayOrder++, B2bTaxInvoiceFilterKeys.status, "발행 상태", opts.status.value, false, [
      { label: "발행대기", value: TaxInvoiceStatusEnum.REQUESTED },
      { label: "발행", value: TaxInvoiceStatusEnum.ISSUED },
      { label: "취소", value: TaxInvoiceStatusEnum.CANCELED },
    ]),
    active: opts.status.active,
  };

  const isTaxFreeFilter = {
    ...createBooleanField(displayOrder++, B2bTaxInvoiceFilterKeys.isTaxFree, "면세", opts.isTaxFree.value, {
      negative: "과세",
      positive: "면세",
    }),
    active: opts.isTaxFree.active,
  };

  return [writedAtFilter, issuedAtFilter, isStaff && b2bBrandSearchFilter, isTaxFreeFilter, statusFilter].filter(
    Boolean
  );
}
</file>

<file path="src/app/views/b2b/views/B2bOrderLineListView/B2bOrderLineListView.tsx">
import useUser from "@hooks/useUser";
import {
  OrderDirection,
  OrderLineB2bStatusEnum,
  OrderLineB2bUpdateInput,
  OrderLinesB2bReceiveDetailInput,
  OrderLinesB2bReceiveInput,
  OrderLinesB2bRejectDetailInput,
  OrderLineSortField,
  PurchaseOrderLineStatusEnum,
} from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import DeliveryFeeExcludedConfirmModal from "@src/app/components/DeliveryFeeExcludedConfirmModal";
import ListNavigator, { TCountOfStatus } from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { hqB2bOrderLineListViewUrl } from "@src/app/views/hqStaff/hqB2b/urls";
import {
  orderLineListQuery,
  useOrderLineListFilterDownloadQuery,
  useOrderLineListQuery,
} from "@src/app/views/order/orders/api/queries";
import { OrderLineListVariables } from "@src/app/views/order/orders/api/types/OrderLineList";
import {
  createAdminB2bOrderViewPath,
  orderDetailsViewUrl,
  OrderLineListViewUrlDialog,
  OrderLineListViewUrlQueryParams,
} from "@src/app/views/order/orders/urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "@src/app/views/order/orders/views/OrderLineListView/filters";
import { usePurchaseOrderLinesDeliveredMutation } from "@src/app/views/vendorStaff/vsSection/api/mutations";
import { ListViews, StrictOmit } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationInfo, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Form } from "antd";
import React, { useEffect, useState } from "react";
import { useParams } from "react-router";

import {
  useOrderLineB2bUpdateMuataion,
  useOrderLinesB2bCancelMutation,
  useOrderLinesB2bPendingMutation,
  useOrderLinesB2bReceiveMutation,
  useOrderLinesB2bRejectMutation,
} from "../../api/mutation";
import { b2bOrderLineCountQuery, useB2bOrderLineCountQuery } from "../../api/queries";
import { B2bOrderLineCount_b2bOrderLineCount } from "../../api/types/B2bOrderLineCount";
import B2bOrderLineListPage from "../../components/B2bOrderLineListPage/B2bOrderLineListPage";
import B2bOrderLineRejectModal from "../../components/B2bOrderLineModal/B2bOrderLineRejectModal";
import {
  B2bOrderLineListViewRouteParams,
  b2bOrderLineNavButtonName,
  B2bOrderLineUrlEnum,
  b2bOrderLineUrlList,
  b2bOrderListViewUrl,
} from "../../urls";

export interface OrderLineB2bUpdateForm extends StrictOmit<OrderLineB2bUpdateInput, "unitPrice"> {
  unitPriceExcludeVat: number;
}

interface B2bOrderLineListViewProps {
  defaultParams: OrderLineListViewUrlQueryParams;
  params: OrderLineListViewUrlQueryParams;
}

export const getStatusCount = (data: B2bOrderLineCount_b2bOrderLineCount): TCountOfStatus<B2bOrderLineUrlEnum> => {
  const { pendingCount, rejectedCount, receivedCount, dispatchFulfillmentCount, deliveryCount } = data;
  const totalAcceptCount = pendingCount + rejectedCount;
  return {
    [B2bOrderLineUrlEnum.ACCEPT]: totalAcceptCount,
    [B2bOrderLineUrlEnum.ALL]: undefined, // 전체 내역은 배지 표시 안 함
    [B2bOrderLineUrlEnum.PENDING_OR_REJECTED]: totalAcceptCount,
    [B2bOrderLineUrlEnum.ACCEPTED]: receivedCount,
    [B2bOrderLineUrlEnum.PROCESSING]: dispatchFulfillmentCount,
    [B2bOrderLineUrlEnum.DELIVERY]: deliveryCount,
    [B2bOrderLineUrlEnum.COMPLETED]: undefined, // 배송 완료는 배지 표시 안 함
  };
};

const B2bOrderLineListView: React.FC<B2bOrderLineListViewProps> = (props) => {
  const { defaultParams, params } = props;
  const { user } = useUser();
  const isStaff = user.isStaff;
  const routeParams = useParams<B2bOrderLineListViewRouteParams>();
  const [selectedRowIds, setSelectedRowIds] = useState<React.Key[]>([]);
  const [selectedRowId, setSelectedRowId] = useState<string>("");
  const [form] = Form.useForm<OrderLineB2bUpdateForm>();
  const [showDeliveryFeeExcludedModal, setShowDeliveryFeeExcludedModal] = useState(false);
  const [pendingReceiveInput, setPendingReceiveInput] = useState<OrderLinesB2bReceiveInput | null>(null);

  const { data: countData } = useB2bOrderLineCountQuery({
    variables: {
      filter: {
        brandId: isStaff ? undefined : user.brand.id,
      },
    },
  });

  let targetUrl: (params: OrderLineListViewUrlQueryParams) => string = null;
  let afterStatusList: OrderLineB2bStatusEnum[] = [];
  switch (routeParams.status) {
    case "accept":
      targetUrl = (params) => b2bOrderListViewUrl({ status: "accept" }, params);
      break;
    case "all":
      const b2bOrderListAllViewUrl = isStaff ? b2bOrderListViewUrl : hqB2bOrderLineListViewUrl;
      targetUrl = (params) => b2bOrderListAllViewUrl({ status: "all" }, params);
      afterStatusList = [
        OrderLineB2bStatusEnum.RECEIVED,
        OrderLineB2bStatusEnum.REJECTED,
        OrderLineB2bStatusEnum.CANCELED,
        OrderLineB2bStatusEnum.COMPLETED,
        OrderLineB2bStatusEnum.DISPATCH_FULFILLMENT,
      ];
      break;
    case "pending-or-rejected":
      targetUrl = (params) => hqB2bOrderLineListViewUrl({ status: "pending-or-rejected" }, params);
      break;
    case "accepted":
      targetUrl = (params) => hqB2bOrderLineListViewUrl({ status: "accepted" }, params);
      break;
    case "processing":
      targetUrl = (params) => hqB2bOrderLineListViewUrl({ status: "processing" }, params);
      break;
    case "delivery":
      targetUrl = (params) => hqB2bOrderLineListViewUrl({ status: "delivery" }, params);
      break;
    case "completed":
      targetUrl = (params) => hqB2bOrderLineListViewUrl({ status: "completed" }, params);
      break;
  }
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(
      isStaff ? ListViews.B2B_ORDER_LINE_LIST : ListViews.HQ_B2B_ORDER_LINE_LIST,
      [routeParams.status]
    ),
  });

  // NOTE: 다운로드 할 때 사용할 query
  const { fetchForDownload } = utils.initListViewDownloadQuery(useOrderLineListFilterDownloadQuery);

  const queryVariables = React.useMemo<OrderLineListVariables>(() => {
    const filterVariables = getFilterVariables(params, true);
    return {
      ...paginationState,
      filter: {
        ...filterVariables,
        brandSearch: isStaff ? filterVariables.brandSearch : user.brand.code,
        purchaseOrderLineStatus:
          routeParams.status === "delivery" ? [PurchaseOrderLineStatusEnum.INVOICE_PRINTED] : undefined,
      },
      sort: { direction: OrderDirection.DESC, field: OrderLineSortField.NUMBER },
      forB2b: true,
      afterStatusList,
    };
  }, [params, settings?.rowNumber]);

  const { data, loading, refetch } = useOrderLineListQuery({ variables: queryVariables });
  const orderLines = maybe(() => data.orderLines.edges.map((edge) => edge.node));

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.orderLines?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<OrderLineListViewUrlDialog, OrderLineListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const resetFormField = () => {
    form.resetFields();
    setSelectedRowId(undefined);
    setSelectedRowIds([]);
  };

  const [orderLinesB2bReceive, orderLinesB2bReceiveOpts] = useOrderLinesB2bReceiveMutation({
    onCompleted: (data) => {
      const errors = data.orderLinesB2bReceive.errors;
      if (errors.length === 0) {
        showNotificationSuccess("주문 접수가 완료되었습니다.");
        resetFormField();
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [orderLineListQuery, b2bOrderLineCountQuery],
  });

  const [orderLinesB2bCancel, orderLinesB2bCancelOpts] = useOrderLinesB2bCancelMutation({
    onCompleted: (data) => {
      const errors = data.orderLinesB2bCancel.errors;
      if (errors.length === 0) {
        showNotificationSuccess("주문 취소가 완료되었습니다.");
        resetFormField();
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [orderLineListQuery, b2bOrderLineCountQuery],
  });

  const [orderLineB2bUpdate, orderLineB2bUpdateOpts] = useOrderLineB2bUpdateMuataion({
    onCompleted: (data) => {
      if (data) {
        const errors = data.orderLineB2bUpdate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("정보가 수정되었습니다.");
          resetFormField();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
  });

  const [orderLinesB2bReject, orderLinesB2bRejectOpts] = useOrderLinesB2bRejectMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.orderLinesB2bReject.errors;
        if (errors.length === 0) {
          showNotificationSuccess("주문 접수가 거부되었습니다.");
          resetFormField();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
    refetchQueries: [orderLineListQuery, b2bOrderLineCountQuery],
  });

  const [orderLinesB2bPending, orderLinesB2bPendingOpts] = useOrderLinesB2bPendingMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.orderLinesB2bPending.errors;
        if (errors.length === 0) {
          showNotificationSuccess("주문 접수를 재요청 하였습니다.");
          resetFormField();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
    refetchQueries: [orderLineListQuery, b2bOrderLineCountQuery],
  });

  const [purchaseOrderLinesDelivered, purchaseOrderLinesDeliveredOpts] = usePurchaseOrderLinesDeliveredMutation({
    onCompleted: (data) => {
      const errors = data.purchaseOrderLinesDelivered.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 주문이 배송 완료 처리되었습니다.");
        setSelectedRowIds([]);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [orderLineListQuery, b2bOrderLineCountQuery],
  });

  const onOrderLineB2bUpdate = (id, input: OrderLineB2bUpdateInput) => {
    orderLineB2bUpdate({
      variables: {
        id,
        input,
      },
    });
  };
  const onOrderLinesB2bReceive = (input: OrderLinesB2bReceiveInput) => {
    // Check if any order line has delivery fee excluded
    const orderLineIds = input.details.map((d) => d.orderLineId);
    const hasExcludedDeliveryFee = orderLines.some((orderLine) => {
      if (!orderLineIds.includes(orderLine.id)) {
        return false;
      }
      return orderLine.brandProductVariant?.includeSalesB2bDeliveryFee === false;
    });

    if (hasExcludedDeliveryFee) {
      setPendingReceiveInput(input);
      setShowDeliveryFeeExcludedModal(true);
      return;
    }

    orderLinesB2bReceive({
      variables: {
        input,
      },
    });
  };

  const onOrderLinesB2bCancel = (orderLineIds: string[]) => {
    orderLinesB2bCancel({
      variables: {
        orderLineIds,
      },
    });
  };

  const onOrderLinesB2bReject = (details: OrderLinesB2bRejectDetailInput[], reason: string) => {
    orderLinesB2bReject({
      variables: {
        input: {
          details,
          reason,
        },
      },
    });
  };

  const onOrderLinesB2bPending = (orderLineIds: string[]) => {
    orderLinesB2bPending({
      variables: {
        orderLineIds,
      },
    });
  };

  const onPurchaseOrderLinesDelivered = () => {
    if (selectedRowIds.length === 0) {
      showNotificationInfo("배송 완료 처리할 주문을 선택해주세요.");
      return;
    }
    const purchaseOrderLineIds = orderLines
      .filter((orderLine) => selectedRowIds.includes(orderLine.id))
      .map((orderLine) => orderLine.purchaseOrderLine.id);
    purchaseOrderLinesDelivered({
      variables: {
        purchaseOrderLineIds,
      },
    });
  };

  const selectedRowIdsExist = maybe(() => selectedRowIds.length > 0);
  const selectedRowIdExist = !utils.isEmpty(selectedRowId);
  const onModalClose = (shouldReset: boolean) => {
    closeModal();
    if (shouldReset) {
      setSelectedRowIds([]);
    }
  };

  useEffect(() => {
    if (!selectedRowIdsExist) {
      closeModal();
    }
  }, [selectedRowIds]);

  return (
    <>
      <B2bOrderLineListPage
        params={params}
        settings={settings}
        currentTab={currentTab}
        disabled={
          loading ||
          orderLinesB2bReceiveOpts.loading ||
          orderLineB2bUpdateOpts.loading ||
          orderLinesB2bCancelOpts.loading ||
          orderLinesB2bRejectOpts.loading ||
          orderLinesB2bPendingOpts.loading ||
          purchaseOrderLinesDeliveredOpts.loading
        }
        filterOpts={getFilterOpts(params, true)}
        orderLines={orderLines}
        pageInfo={pageInfo}
        onRowClick={(id) => navigate(orderDetailsViewUrl(id))}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        isAll={false}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        createAdminOrderButtonClick={() => navigate(createAdminB2bOrderViewPath)}
        routeParams={routeParams}
        selectedRowIds={selectedRowIds}
        setSelectedRowIds={setSelectedRowIds}
        closeModal={closeModal}
        form={form}
        selectedRowId={selectedRowId}
        setSelectedRowId={setSelectedRowId}
        openModal={openModal}
        ListNavigator={() => (
          <ListNavigator<OrderLineListViewUrlQueryParams, B2bOrderLineUrlEnum>
            countOfStatus={countData ? getStatusCount(countData.b2bOrderLineCount) : null}
            urlList={b2bOrderLineUrlList(isStaff)}
            NavButtonName={b2bOrderLineNavButtonName}
            skipQueryString={true}
          />
        )}
        onOrderLineB2bUpdate={onOrderLineB2bUpdate}
        onOrderLinesB2bReceive={onOrderLinesB2bReceive}
        onOrderLinesB2bCancel={onOrderLinesB2bCancel}
        onOrderLinesB2bPending={onOrderLinesB2bPending}
        resetFormField={resetFormField}
        onDelivered={onPurchaseOrderLinesDelivered}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <ConfirmModal
        visible={params.action === "b2b-order-lines-receive" && selectedRowIdsExist}
        onOk={() => {
          const details = orderLines
            .filter((orderLine) => selectedRowIds.includes(orderLine.id))
            .map<OrderLinesB2bReceiveDetailInput>((orderLine) => ({
              orderLineId: orderLine.id,
              qty: orderLine.orderedOrFulfillQty,
              unitPrice: orderLine.unitPriceGrossAmount,
              unitPriceVat: orderLine.unitPriceVat,
              b2bDeliveryFeeExcludeVat: orderLine.b2bDeliveryFeeExcludeVat,
            }));

          onOrderLinesB2bReceive({
            details,
          });
        }}
        onCancel={() => onModalClose(false)}
        okButtonProps={{
          loading: !!pendingReceiveInput || orderLinesB2bReceiveOpts.loading,
        }}
        modalTitleText="주문 일괄 접수"
        titleText="선택한 주문을 일괄 접수 하시겠습니까?"
        helpText="일괄 발송된 제품은 접수대기 상태로 변경되며, 수정이나 취소가 불가합니다."
      />
      <B2bOrderLineRejectModal
        open={params.action === "b2b-order-lines-reject" && selectedRowIdExist}
        loading={loading}
        orderLineId={selectedRowId}
        onCancel={() => {
          onModalClose(false);
          resetFormField();
        }}
        onSubmit={(reason: string) => {
          onOrderLinesB2bReject([{ orderLineId: selectedRowId }], reason);
        }}
      />
      <DeliveryFeeExcludedConfirmModal
        visible={showDeliveryFeeExcludedModal}
        loading={orderLinesB2bReceiveOpts.loading}
        products={(() => {
          if (!pendingReceiveInput) {
            return [];
          }
          const orderLineIds = pendingReceiveInput.details.map((d) => d.orderLineId);
          return orderLines
            .filter(
              (orderLine) =>
                orderLineIds.includes(orderLine.id) &&
                orderLine.brandProductVariant?.includeSalesB2bDeliveryFee === false
            )
            .map((orderLine) => ({
              id: orderLine.id,
              sku: orderLine.productSku,
              productName: orderLine.productName,
              variantName: orderLine.variant.name,
              quantity: orderLine.orderedOrFulfillQty,
              deliveryFee: orderLine.b2bDeliveryFeeExcludeVat,
            }));
        })()}
        onConfirm={() => {
          if (pendingReceiveInput) {
            orderLinesB2bReceive({
              variables: {
                input: pendingReceiveInput,
              },
            });
          }
          setShowDeliveryFeeExcludedModal(false);
          setPendingReceiveInput(null);
        }}
        onCancel={() => {
          setShowDeliveryFeeExcludedModal(false);
          setPendingReceiveInput(null);
          closeModal(); // 첫 번째 모달도 닫기
        }}
        title="B2B 주문 접수 - 배송비 별도 상품 확인"
        subTitle="판매가 배송비 별도인 상품이 있으니 접수 전 판매 배송비를 입력했는지 확인해주세요."
      />
    </>
  );
};

