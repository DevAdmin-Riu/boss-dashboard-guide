    const input: ProductVariantInput = {
      // 제품 옵션 기본 정보
      name: data.name,
      salesStatus: data.salesStatus,
      stoppedReason: data.stoppedReason,
      stoppedReasonEtc: data.stoppedReasonEtc,
      trackInventory: data.trackInventory,
      isVendorTrackInventory: data.isVendorTrackInventory,
      forceSoldOutNotice: data.forceSoldOutNotice,
      canSaleByInner: data.canSaleByInner,
      requiredExpDateMgmt: data.requiredExpDateMgmt,
      // 제품 옵션 속성 정보
      attributes: makeFilteredAttributesForMutationInput(data),
      qtyPerBoxUnitType: data.qtyPerBoxUnitType,
      priorityLevel: data.priorityLevel,
      salesUnitType: data.salesUnitType,
      qtyPerBox: data.qtyPerBox,
      boxLength: data.boxLength,
      boxWidth: data.boxWidth,
      boxHeight: data.boxHeight,
      palletQty: data.palletQty,
      palletM: data.palletM,
      palletN: data.palletN,
      palletO: data.palletO,
      maker: data.maker,
      // 제품 옵션 재고 관련 정보
      stockAdjustFactor: data.stockAdjustFactor,
      allowAutoConsignment: data.allowAutoConsignment,
      autoTurnOffAllowAutoConsignment: data.autoTurnOffAllowAutoConsignment,
      isSubPv: data.isSubPv,
      // 이너박스 정보(직배송 제품인 경우는 무관)
      ...innerVariantInput,
      note: data.note,
      poNote: data.poNote,
      // 계절 제품 정보
      isSeasonal: data.isSeasonal,
      peakSeasonStartDate: data.peakSeasonStartDate,
      peakSeasonEndDate: data.peakSeasonEndDate,

      // 현재 실질적으로 사용되지 않는 필드 - 제품 중량(모든 variant에 null로 설정되어 있음)

      // 충전금 상품은 원산지 정보를 null로 보냄
      countryOfOrigin: data.isForCreditsRefill ? null : data.countryOfOrigin,
    };

    const result = await updateExtendedProduct({
      variables: {
        productVariantId: variantId,
        productVariantInput: input,
        additionalInput: { manageEvent: data.manageEvent },
        forVariantOnly: true,
      },
    });

    return [...result.data?.extendedProductUpdate.errors];
  };

  const handleCopyAdd = () => {
    navigate(productVariantCreateViewUrl(productId, { copyVariantId: variantId }));
  };

  const handleSubmit = createMetadataUpdateHandler(
    data?.productVariant,
    handleUpdate,
    (variables) => updateMetadata({ variables }),
    (variables) => updatePrivateMetadata({ variables })
  );

  const [openModal, closeModal] = createDialogActionHandlersForBulkAction<
    ProductVariantUpdateViewUrlDialog,
    ProductVariantUpdateViewUrlQueryParams
  >(navigate, (params) => productVariantUpdateViewUrl(productId, variantId, params), params);

  if (variant === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }
  if (variant === undefined) {
    return <></>;
  }

  const variantSku = getProductVariantSku(data?.productVariant);
  const variantName = data?.productVariant ? data.productVariant.name : "";
  const pageTitle = `선택된 옵션: ${variantName}` + (variantSku ? ` (제품코드: ${variantSku})` : "");

  return (
    <>
      <ProductVariantUpdatePage
        defaultVariantId={data?.productVariant.product.defaultVariant.id}
        errors={errors}
        onSetDefaultVariant={onSetDefaultVariant}
        saveButtonBarState={updateExtendedProductOpts.status}
        loading={disableFormSave}
        placeholderImage={placeholderImg}
        variant={variant}
        pageHeaderTitle={pageTitle}
        warehouses={warehouses?.data?.warehouses.edges.map((edge) => edge.node) || []}
        makers={maybe(() => searchMakersOpts.data.search.edges, []).map((edge) => edge.node)}
        fetchMakers={searchMakers}
        fetchMoreMakers={{
          hasMore: maybe(() => searchMakersOpts.data.search.pageInfo.hasNextPage),
          loading: searchMakersOpts.loading,
          onFetchMore: loadMoreMakers,
        }}
        onAdd={() => navigate(productVariantCreateViewUrl(productId))}
        onCopyAdd={handleCopyAdd}
        onBack={handleBack}
        onDelete={null}
        onImageSelect={handleImageSelect}
        onSubmit={handleSubmit}
        onWarehouseConfigure={() => navigate(warehouseCreateViewPath)}
        onVariantClick={(variantId) => {
          navigate(productVariantUpdateViewUrl(productId, variantId), true);
        }}
        onVariantReorder={handleVariantReorder}
        onVariantUpdate={(variantId, productVariantInput, additionalInput) =>
          updateExtendedProduct({ variables: { productVariantId: variantId, productVariantInput, additionalInput } })
        }
        onVariantVendorSetDefault={(productVariantId, variantVendorId, manageEvent) =>
          setProductVariantVendorDefault({ variables: { productVariantId, variantVendorId, manageEvent } })
        }
        onProductClick={(productId) => navigate(productUpdateViewUrl(productId))}
        onAssignSubPv={() => openModal("assign-sub-pv")}
        onUnassignSubPv={(subPvId) => openModal("unassign-sub-pv", { id: subPvId })}
        onBulkAssignMainPvs={() => openModal("bulk-assign-main-pvs")}
        onBulkUnassignMainPvs={(mainPvIds) => openModal("bulk-unassign-main-pvs", { ids: mainPvIds })}
        onAssignDevPv={() => openModal("assign-dev-pv")}
        onUnassignDevPv={() => openModal("unassign-dev-pv")}
        onProductVariantOnSale={(targetVariantId: string, recipientList: string[]) => {
          productVariantOnSale({ variables: { id: targetVariantId, recipientList } });
        }}
        productVariantOnSaleLoading={productVariantOnSaleOpts.loading}
      />

      <ProductVariantDeleteDialog
        confirmButtonState={deleteVariantOpts.status}
        onClose={() => navigate(productVariantUpdateViewUrl(productId, variantId))}
        onConfirm={() => deleteVariant({ variables: { id: variantId } })}
        open={params.action === "remove"}
        name={data?.productVariant?.name}
      />
      <SubPvAssignModal
        includeManageEvent
        loading={disableFormSave}
        open={params.action === "assign-sub-pv"}
        mainPvId={variant?.id}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          assignSubPvToMainPv({ variables: { input: { ...restInput } } });
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "unassign-sub-pv"}
        loading={disableFormSave}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_SUB_PV}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          unassignSubPvFromMainPv({
            variables: {
              input: {
                mainPvId: variant?.id,
                subPvId: params.id,
                ...restInput,
                manageEvent: formData.manageEvent as ProductVariantManageEventInput,
              },
            },
          });
        }}
        onCancel={closeModal}
      />
      <MainPvsBulkAssignModal
        loading={disableFormSave}
        open={params.action === "bulk-assign-main-pvs"}
        subPvId={variant?.id}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          bulkAssignMainPvsToSubPv({ variables: { input: { ...restInput } } });
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "bulk-unassign-main-pvs"}
        loading={disableFormSave}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_SUB_PV}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          bulkUnassignMainPvsFromSubPv({
            variables: {
              input: {
                subPvId: variant?.id,
                mainPvIds: historyState?.ids,
                ...restInput,
                manageEvent: formData.manageEvent as ProductVariantManageEventInput,
              },
            },
          });
        }}
        onCancel={closeModal}
      />
      <DevPvAssignModal
        isDevPvAssignMode
        loading={disableFormSave}
        open={params.action === "assign-dev-pv"}
        onSubmit={(formData) => {
          const { variantIds, manageEvent } = formData;
          updateExtendedProduct({
            variables: {
              productVariantId: variant.id,
              productVariantInput: { devPvs: variantIds },
              additionalInput: { manageEvent },
            },
          });
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "unassign-dev-pv"}
        loading={disableFormSave}
        manageEventType={null}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          updateExtendedProduct({
            variables: {
              productVariantId: variant.id,
              productVariantInput: { devPvs: [] },
              additionalInput: { manageEvent: formData.manageEvent as ProductVariantManageEventInput },
            },
          });
        }}
        onCancel={closeModal}
      />
    </>
  );
};
</file>

