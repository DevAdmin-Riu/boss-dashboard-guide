interface BrandMemberProps {
  brandStores: BrandDetails_brand_brandStores[] | null;
  openBrandStoreCreateModal: () => void;
}

export const BrandStores: React.FC<BrandMemberProps> = (props) => {
  const { brandStores, openBrandStoreCreateModal } = props;

  const navigate = useNavigator();
  const onRowClick = (id: string) => {
    navigate(brandStoreDetailsViewUrl(id));
  };

  const brandStoresTotalCount = maybe(() => brandStores?.length, 0);

  const brandStoreCreateButton = (
    <Button type="primary" shape="round" onClick={openBrandStoreCreateModal}>
