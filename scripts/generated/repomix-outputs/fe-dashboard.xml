<file path="src/app/views/hqStaff/hqSection/utils/productChartConfig.ts">
import { Datum, PieConfig } from "@ant-design/charts";
import { statsValueType } from "@utils/chart";
import { transformIsExclusive } from "@utils/misc";

import { BrandProductStats_brandProductStats } from "../api/types/BrandProductStats";
import { ProductStatsForTable } from "../components/HqStatsProduct/utils";

const commonPieChartConfig: PieConfig = {
  appendPadding: 10,
  data: [],
  angleField: "value",
  colorField: "type",
  radius: 0.8,
  label: { type: "spider", labelHeight: 28, content: ({ value }) => value.toLocaleString() },
  interactions: [{ type: "element-selected" }, { type: "element-active" }],
  tooltip: {
    showMarkers: false,
    formatter: (datum: Datum) => ({ name: datum.type, value: datum.value.toLocaleString() }),
  },
  statistic: {
    content: { style: { whiteSpace: "pre-wrap", overflow: "hidden", textOverflow: "ellipsis" } },
  },
};

const makeProductStatsData = (brandProductStats: ProductStatsForTable[], valueType: statsValueType) => {
  const data = [];

  if (valueType === statsValueType.TOTAL_PRICE) {
    brandProductStats.sort((a, b) => b.statTotalPriceExcludeVat - a.statTotalPriceExcludeVat);
  }
  for (const statsElement of brandProductStats) {
    const dataElement = {
      type: "",
      value: 0,
    };
    dataElement.type = `${statsElement.brandProductName} - ${statsElement.sku}`;
    if (statsElement) {
      switch (valueType) {
        case statsValueType.QUANTITY:
          dataElement.value = statsElement.statQuantity;
          break;
        case statsValueType.TOTAL_PRICE:
          dataElement.value = statsElement.statTotalPriceExcludeVat;
          break;
      }
    }
    data.push(dataElement);
  }

  const defaultData = {
    type: "없음",
    value: 0,
  };

  return data.length === 0 ? [defaultData] : data;
};

export const makeProductStatsChartConfig = (
  brandProductStats: ProductStatsForTable[],
  valueType: statsValueType
): PieConfig => {
  const config = {
    ...commonPieChartConfig,
    data: makeProductStatsData(brandProductStats, valueType),
    statistic: {
      content: {
        style: { whiteSpace: "pre-wrap", overflow: "hidden", textOverflow: "ellipsis" },
        content: `판매${valueType === statsValueType.QUANTITY ? "수량" : "금액"}\n상위 10 상품`,
      },
    },
  };

  return config;
};

// 상품 유형 차트는 상위 10개가 아닌 전체 상품을 대상으로 보여줘야 하므로 새로운 함수로 분기
const makeProductStatsDataForExclusiveRate = (brandProductStats: BrandProductStats_brandProductStats[]) => {
  const data = [];

  if (brandProductStats.length > 0) {
    const exclusiveStats = brandProductStats.filter((stats) => stats.isExclusive);
    const nonExclusiveStats = brandProductStats.filter((stats) => !stats.isExclusive);
    const exclusiveTotalPriceExcludeVat = exclusiveStats.reduce(
      (acc, stats) => acc + stats.statTotalPriceExcludeVat,
      0
    );
    const nonExclusiveTotalPriceExcludeVat = nonExclusiveStats.reduce(
      (acc, stats) => acc + stats.statTotalPriceExcludeVat,
      0
    );
    const totalPriceExcludeVat = exclusiveTotalPriceExcludeVat + nonExclusiveTotalPriceExcludeVat;
    data.push({
      type: transformIsExclusive(true),
      value: (exclusiveTotalPriceExcludeVat / totalPriceExcludeVat) * 100,
    });
    data.push({
      type: transformIsExclusive(false),
      value: (nonExclusiveTotalPriceExcludeVat / totalPriceExcludeVat) * 100,
    });
  }

  const defaultData = {
    type: "없음",
    value: 0,
  };

  return data.length === 0 ? [defaultData] : data;
};

export const makeProductStatsForExclusiveRateChartConfig = (
  brandProductStats: BrandProductStats_brandProductStats[]
): PieConfig => {
  const config = {
    ...commonPieChartConfig,
    data: makeProductStatsDataForExclusiveRate(brandProductStats),
    label: { type: "spider", labelHeight: 28, content: ({ value }) => `${value.toLocaleString()}%` },
    statistic: {
      content: {
        style: { whiteSpace: "pre-wrap", overflow: "hidden", textOverflow: "ellipsis" },
        content: "전용상품 여부에 따른 전체 판매총액 비율",
      },
    },
  };

  return config;
};
</file>

