import useUser from "@hooks/useUser";
import { BsTrainingDocInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import AppHeader from "@src/app/components/AppHeader";
import EditableField from "@src/app/components/EditableField/EditableField";
import { parseContentJsonStrToMarkdown } from "@src/app/components/Editor/utils";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import VisibilityCard from "@src/app/components/VisibilityCard";
import { formRuleMsg } from "@src/global/assets/messages/commonMsg";
import { utils } from "@utils/utils";
import { Col, Form, Row, Space } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useEffect } from "react";

import { BsTrainingDoc_bsTrainingDoc } from "../api/types/BsTrainingDoc";
import { BsTrainingTagList_bsTrainingTagList_edges_node } from "../api/types/BsTrainingTagList";
import { BsTrainingTagSimpleBrandList_brands_edges_node } from "../api/types/BsTrainingTagSimpleBrandList";
import { BsTrainingDocDetailsEditModeEnum } from "../views/HqTrainingDocDetailsView";
import { BsTrainingDocBasicInfo } from "./BsTrainingDocBasicInfo";
import { makeBsTrainingDocTag } from "./HqTrainingDocListPage/HqTrainingDocListTableSettings";

export type BsTrainingDocBasicInfoUpdateForm = Pick<BsTrainingDocInput, "title" | "content">;

export type BsTrainingDocVisibilityUpdateForm = Pick<
  BsTrainingDocInput,
  "isPublished" | "publicationDate" | "ownerBrand" | "tags"
>;

interface HqTrainingDocDetailsPageProps {
  title: string;
  disabled: boolean;
  bsTrainingDoc: BsTrainingDoc_bsTrainingDoc;
  tagList: BsTrainingTagList_bsTrainingTagList_edges_node[];
  brandList: BsTrainingTagSimpleBrandList_brands_edges_node[];
  editMode: BsTrainingDocDetailsEditModeEnum;
  onEdit: (mode: BsTrainingDocDetailsEditModeEnum) => void;
  onEditCancel: () => void;
  onBasicInfoUpdate: (formData: BsTrainingDocBasicInfoUpdateForm) => void;
  onVisibilityUpdate: (formData: BsTrainingDocVisibilityUpdateForm) => void;
  onBack: () => void;
}
const HqTrainingDocDetailsPage: React.FC<HqTrainingDocDetailsPageProps> = ({
  title,
  disabled,
  bsTrainingDoc,
  tagList,
  brandList,
  editMode,
  onEdit,
  onEditCancel,
  onBasicInfoUpdate,
  onVisibilityUpdate,
  onBack,
}) => {
  const appHeaderTitle = `${title} 관리`;
  const { user } = useUser();
  const [basicInfoForm] = useForm<BsTrainingDocBasicInfoUpdateForm>();
  const [visibilityForm] = useForm<BsTrainingDocVisibilityUpdateForm>();
  const VisibilityTypeSafeForm = getTypeSafeForm<BsTrainingDocVisibilityUpdateForm>(visibilityForm);
  const isEditing = utils.isEmpty(editMode) === false;

  const basicInfoInitialValues: BsTrainingDocBasicInfoUpdateForm = {
    title: bsTrainingDoc.title || "",
    content: parseContentJsonStrToMarkdown(bsTrainingDoc.content),
  };
  const visibilityInitialValues: BsTrainingDocVisibilityUpdateForm = {
    isPublished: bsTrainingDoc.isPublished,
    publicationDate: bsTrainingDoc.publicationDate,
    ownerBrand: bsTrainingDoc.ownerBrand?.id || undefined,
    tags: bsTrainingDoc.tags?.map((tag) => tag.id) || [],
  };

  useEffect(() => {
    switch (editMode) {
      case BsTrainingDocDetailsEditModeEnum.UpdateBasicInfo:
        basicInfoForm.resetFields();
        break;
      case BsTrainingDocDetailsEditModeEnum.UpdateVisibility:
        visibilityForm.resetFields();
        break;
      default:
        break;
    }
  }, [editMode]);

  const makeDisplayBrandName = (brand: BsTrainingTagSimpleBrandList_brands_edges_node): string => {
    if (utils.isEmpty(brand)) {
      return "-";
    }
    return `${brand.code} | ${brand.name}`;
  };

  const brandOptions = brandList.map((brand) => ({ label: makeDisplayBrandName(brand), value: brand.id }));
  const tagOptions = tagList.map((tag) => ({ label: tag.name, value: tag.id }));

  return (
    <>
      <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
      <PageHeader title={title} />

      <Grid>
        <Space direction="vertical" size="large">
          <Form
            form={basicInfoForm}
            name="bs-training-doc-basic-info"
            layout="vertical"
            disabled={disabled || (isEditing && editMode !== BsTrainingDocDetailsEditModeEnum.UpdateBasicInfo)}
            initialValues={basicInfoInitialValues}
            onFinish={onBasicInfoUpdate}
          >
            <BsTrainingDocBasicInfo
              isCreate={false}
              form={basicInfoForm}
              bsTrainingDoc={bsTrainingDoc}
              editModeProps={{
                isEditMode: editMode === BsTrainingDocDetailsEditModeEnum.UpdateBasicInfo,
                onEdit: () => onEdit(BsTrainingDocDetailsEditModeEnum.UpdateBasicInfo),
                onCancel: onEditCancel,
              }}
            />
          </Form>
        </Space>

        <Space direction="vertical" size="large">
          <Form
            form={visibilityForm}
            name="bs-training-doc-visibility"
            layout="vertical"
            disabled={disabled || (isEditing && editMode !== BsTrainingDocDetailsEditModeEnum.UpdateVisibility)}
            initialValues={visibilityInitialValues}
            onFinish={onVisibilityUpdate}
          >
            <VisibilityCard
              isCreate={false}
              form={visibilityForm}
              initialValues={visibilityInitialValues}
              editModeProps={{
                isEditMode: editMode === BsTrainingDocDetailsEditModeEnum.UpdateVisibility,
                onEdit: () => onEdit(BsTrainingDocDetailsEditModeEnum.UpdateVisibility),
                onCancel: onEditCancel,
              }}
            >
              <EditableField
                hidden={user.isHqStaff}
                type="select"
                name={VisibilityTypeSafeForm.getValidDataIndex("ownerBrand")}
                value={VisibilityTypeSafeForm.getFieldValue("ownerBrand")}
                editMode={editMode === BsTrainingDocDetailsEditModeEnum.UpdateVisibility}
                label="브랜드"
                placeholder="브랜드를 선택하세요"
                options={brandOptions}
                rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
              />
              <EditableField<string[]>
                type="select"
                name={VisibilityTypeSafeForm.getValidDataIndex("tags")}
                value={VisibilityTypeSafeForm.getFieldValue("tags")}
                renderValue={(value) => (
                  <Row gutter={4}>
                    {value?.map((tagId) => {
                      const tag = tagList.find((t) => t.id === tagId);
                      return <Col key={tagId}>{makeBsTrainingDocTag(tag)}</Col>;
                    })}
                  </Row>
                )}
                editMode={editMode === BsTrainingDocDetailsEditModeEnum.UpdateVisibility}
                label="태그"
                mode="multiple"
                placeholder="태그를 선택하세요"
                options={tagOptions}
              />
            </VisibilityCard>
          </Form>
        </Space>
      </Grid>
    </>
  );
};

export default HqTrainingDocDetailsPage;
</file>

