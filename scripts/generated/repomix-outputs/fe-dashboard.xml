import makeMutation from "@hooks/makeMutation";
import { addressFragment } from "@src/api/fragments/address";
import { customerAddressesFragment } from "@src/api/fragments/customers";
import { accountErrorFragment, pointsEventErrorFragment } from "@src/api/fragments/errors";
import { creditsEventFragmentForUserDetails, rcoinsEventFragmentForUserDetails } from "@src/api/fragments/points";
import gql from "graphql-tag";

import { CreateCustomerAddress, CreateCustomerAddressVariables } from "./types/CreateCustomerAddress";
import { CreditsEventCreate, CreditsEventCreateVariables } from "./types/CreditsEventCreate";
import { RcoinsBulkIncrease, RcoinsBulkIncreaseVariables } from "./types/RcoinsBulkIncrease";
import { RcoinsEventCreate, RcoinsEventCreateVariables } from "./types/RcoinsEventCreate";
import { RemoveCustomerAddress, RemoveCustomerAddressVariables } from "./types/RemoveCustomerAddress";
import { SetCustomerDefaultAddress, SetCustomerDefaultAddressVariables } from "./types/SetCustomerDefaultAddress";
import { UpdateCustomerAddress, UpdateCustomerAddressVariables } from "./types/UpdateCustomerAddress";

const setCustomerDefaultAddress = gql`
  ${accountErrorFragment}
  ${customerAddressesFragment}
  mutation SetCustomerDefaultAddress($addressId: ID!, $userId: ID!) {
    addressSetDefault(addressId: $addressId, userId: $userId) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      user {
        ...CustomerAddressesFragment
      }
    }
  }
`;
export const useSetCustomerDefaultAddressMutation = makeMutation<
  SetCustomerDefaultAddress,
  SetCustomerDefaultAddressVariables
>(setCustomerDefaultAddress);

const createCustomerAddress = gql`
  ${accountErrorFragment}
  ${customerAddressesFragment}
  ${addressFragment}
  mutation CreateCustomerAddress($id: ID!, $input: AddressInput!) {
    addressCreate(userId: $id, input: $input) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      address {
        ...AddressFragment
      }
      user {
        ...CustomerAddressesFragment
      }
    }
  }
`;
export const useCreateCustomerAddressMutation = makeMutation<CreateCustomerAddress, CreateCustomerAddressVariables>(
  createCustomerAddress
);

const updateCustomerAddress = gql`
  ${accountErrorFragment}
  ${addressFragment}
  mutation UpdateCustomerAddress($id: ID!, $input: AddressInput!) {
    addressUpdate(id: $id, input: $input) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      address {
        ...AddressFragment
      }
    }
  }
`;
export const useUpdateCustomerAddressMutation = makeMutation<UpdateCustomerAddress, UpdateCustomerAddressVariables>(
  updateCustomerAddress
);

const removeCustomerAddress = gql`
  ${accountErrorFragment}
  ${customerAddressesFragment}
  mutation RemoveCustomerAddress($id: ID!) {
    addressDelete(id: $id) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      user {
        ...CustomerAddressesFragment
      }
    }
  }
`;
export const useRemoveCustomerAddressMutation = makeMutation<RemoveCustomerAddress, RemoveCustomerAddressVariables>(
  removeCustomerAddress
);

const creditsEventCreate = gql`
  ${creditsEventFragmentForUserDetails}
  ${pointsEventErrorFragment}
  mutation CreditsEventCreate($userId: ID!, $input: CreditsEventCreateInput!) {
    creditsEventCreate(userId: $userId, input: $input) {
      user {
        id
        cashableCredits
        nonCashableCredits
        creditsEvents(first: 5) {
          edges {
            node {
              ...CreditsEventFragmentForUserDetails
            }
          }
        }
      }
      errors: pointsEventErrors {
        ...PointsEventErrorFragment
      }
    }
  }
`;
export const useCreditsEventCreateMutation = makeMutation<CreditsEventCreate, CreditsEventCreateVariables>(
  creditsEventCreate
);

const rcoinsEventCreate = gql`
  ${rcoinsEventFragmentForUserDetails}
  ${pointsEventErrorFragment}
  mutation RcoinsEventCreate($userId: ID!, $input: RcoinsEventCreateInput!) {
    rcoinsEventCreate(userId: $userId, input: $input) {
      user {
        id
        rcoins
        rcoinsEvents(first: 5) {
          edges {
            node {
              ...RcoinsEventFragmentForUserDetails
            }
          }
        }
      }
      errors: pointsEventErrors {
        ...PointsEventErrorFragment
      }
    }
  }
`;
export const useRcoinsEventCreateMutation = makeMutation<RcoinsEventCreate, RcoinsEventCreateVariables>(
  rcoinsEventCreate
);

const rcoinsBulkIncrease = gql`
  ${accountErrorFragment}
  mutation RcoinsBulkIncrease($input: RcoinsBulkIncreaseInput!) {
    rcoinsBulkIncrease(input: $input) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
    }
  }
`;
export const useRcoinsBulkIncreaseMutation = makeMutation<RcoinsBulkIncrease, RcoinsBulkIncreaseVariables>(
  rcoinsBulkIncrease
);
</file>

