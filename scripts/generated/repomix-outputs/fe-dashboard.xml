  images: Array<{ id: string; url: string }>;
}

export const BsOpsCheckAnswerJson: React.FC<BsOpsCheckAnswerJsonProps> = (props) => {
  const { answerJson, images } = props;
  const isMobile = utils.checkMobile();

  if (utils.isEmpty(answerJson)) {
    return (
      <Typography.Text strong type="warning">
        답변 없음
      </Typography.Text>
    );
  }

  const parseAnswerValue = (answerJson: BsOpsCheckReportDetails_bsOpsCheckReport_items_answerJson) => {
    const { type, value } = answerJson;
    switch (type) {
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO:
        return value === "true" ? "예" : value === "false" ? "아니오" : "-";
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.SCORE:
        return value ? `${value}점` : "-";
      case BsOpsCheckTemplateCategoryItemFormTypeEnum.SELECT:
        return value || "-";
      default:
        return "-";
    }
  };

  const checkShowReason = (answerJson: BsOpsCheckReportDetails_bsOpsCheckReport_items_answerJson) => {
    const { type, value } = answerJson;
    return type === BsOpsCheckTemplateCategoryItemFormTypeEnum.YES_NO && value === "false";
  };

  const showReason = checkShowReason(answerJson);
  const showImages = images.length > 0;

  const rowItems: Array<{ label: string; content: React.ReactNode; show: boolean }> = [
    { label: "답변", content: parseAnswerValue(answerJson), show: true },
    {
      label: "사유",
      content: <Typography style={{ whiteSpace: "pre-line" }}>{answerJson.reason || "-"}</Typography>,
      show: showReason,
    },
    {
      label: "첨부 이미지",
      content: (
        <Row gutter={4}>
          {images.map((image) => (
            <Col key={image.id} span={isMobile ? 8 : null}>
              <Image style={{ maxWidth: 120, maxHeight: 120 }} key={image.id} src={image.url} />
            </Col>
          ))}
        </Row>
      ),
      show: showImages,
    },
  ];

  return (
    <Row>
      {rowItems
        .filter((rowItem) => rowItem.show)
        .map((rowItem, idx) => (
          <Col span={24} key={idx}>
            <Row gutter={8}>
              <Col>
                <Typography.Text strong>{rowItem.label}:</Typography.Text>
              </Col>
              <Col>{rowItem.content}</Col>
            </Row>
          </Col>
        ))}
    </Row>
  );
};
