const getSalesStatByTypeAndMonth = (
  statData: SalesStatDataSourceProps["stats"],
  type: TSalesStatCategory,
  dateMoment: Moment,
  brandContractType: BrandContractTypeEnum
) => {
  const salesStatByType: ExtendedSalesStatList_salesStats[] = statData[type];
  if (utils.isEmpty(salesStatByType) || utils.isEmpty(dateMoment) || !dateMoment.isValid()) {
    return null;
  }
  return {
    ...salesStatByType.find((stat) => stat?.statDate === dateMoment.format(onlyDateFormat)),
    brandContractType,
  };
};

const createGetStatFromRecordFunc =
  (type: TSalesStatCategory, dateMoment: Moment) =>
  (record: SalesStatDataSourceProps): SalesStatList_salesStats =>
    getSalesStatByTypeAndMonth(record.stats, type, dateMoment, record.brand.contractType);

const createGetStatFromRecordFuncForSum =
  (type: TSalesStatCategory) =>
  (record: SalesStatDataSourceProps): SalesStatList_salesStats =>
    record.statsSum[type];

export const getSalesStatListTableSettings = (props: SalesStatListPageProps) => {
  const { statDate, columns: columnsTypes } = props.filterVariables;
  const { gte: startDate, lte: endDate } = statDate || { gte: null, lte: null };
  const startMonth = moment(startDate);
  const endMonth = moment(endDate);
  const monthMomentArr = getDatesBetween([startMonth, endMonth], "month").dates;

  const columns: DownloadableColumnsType<SalesStatDataSourceProps> = makeSalesStatBrandColumns();
  for (const monthMoment of monthMomentArr) {
    const salesStatsColumnsByMonth: DownloadableColumnsType<SalesStatDataSourceProps> = [];
    const monthStr = monthMoment.format(onlyMonthFormat);
    if (columnsTypes && columnsTypes?.total === true) {
      salesStatsColumnsByMonth.push({
        title: "총 매출(전체 상품)",
        key: monthStr + "total",
        children: makeSalesStatsColumns<SalesStatDataSourceProps>(createGetStatFromRecordFunc("total", monthMoment)),
        isPickerHide: true,
      });
    }
    if (columnsTypes && columnsTypes?.exclusive === true) {
      salesStatsColumnsByMonth.push({
        title: "전용 상품",
        key: monthStr + "exclusive",
        children: makeSalesStatsColumns<SalesStatDataSourceProps>(
