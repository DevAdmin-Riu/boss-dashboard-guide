import { BrandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { BrandFbvSettlements_brandFbvSettlements_edges_node } from "@src/app/views/mileageSettlement/api/types/BrandFbvSettlements";
import { BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node } from "@src/app/views/mileageSettlement/api/types/BrandMileageMonthlySettlements";
import { calcVatByPriceExcludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { transformIsFBVForHq } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Col, Descriptions, PageHeader, Row, Steps, Typography } from "antd";
import moment from "moment";
import React from "react";

import { makeOrderDateElement } from "../../hqSection/components/HqStatsOrder/utils";

export interface TitleOrderStatsForMainProps {
  title: string;
  recentTargetDay: moment.Moment;
  stats: BrandOrderStats;
  brand: User_brand;
  isFulfilledByVendor?: boolean;
  isLastMonth?: boolean;
  brandMileageLastMonthInfo?: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node;
  brandFulfilledByVendorLastMonthInfo?: BrandFbvSettlements_brandFbvSettlements_edges_node;
}

export const TitleOrderStatsForMain: React.FC<TitleOrderStatsForMainProps> = (props) => {
  const {
    title,
    recentTargetDay,
    stats,
    brand,
    isFulfilledByVendor,
    isLastMonth,
    brandMileageLastMonthInfo,
    brandFulfilledByVendorLastMonthInfo,
  } = props;
  const brandContractType = brand?.contractType;
  const targetDate = recentTargetDay.format(onlyDateFormat);
  const fbvTextForHq = transformIsFBVForHq(true);

  const brandOrderStats = stats?.brandOrderStats;
  const orderDateElement = makeOrderDateElement(targetDate, brandOrderStats);
  const statDeliveryFeeExcludeVat = toPriceExcludeVat(orderDateElement.statBrandDeliveryFee);
  const statTotalProfitExcludeVat =
    orderDateElement.statTotalPriceExcludeVat -
    orderDateElement.statRcoinsExcludeVat -
    orderDateElement.statBrandCostPriceExcludeVat -
    statDeliveryFeeExcludeVat -
    orderDateElement.statBrandPayingChargeExcludeVat;

  let statusInfoTitle: string;
  let stepsCurrent: number;
  let requestPageUrl: string;

  if (isFulfilledByVendor) {
    statusInfoTitle = `${fbvTextForHq} 상품 매입금`;
    stepsCurrent = getFulfilledByVendorSettlementStatusStepsIndexForHqMain(
      brandFulfilledByVendorLastMonthInfo?.settlementStatus
    );
    requestPageUrl = hqFulfilledByVendorSettlementListViewUrl();
  } else {
    statusInfoTitle = "본부수익금";
    stepsCurrent = getMileageSettlementStatusStepsIndexForHqMain(brandMileageLastMonthInfo?.settlementStatus);
    requestPageUrl = hqMileageSettlementListViewUrl();
  }

  const isMileage = brandContractType === BrandContractTypeEnum.MILEAGE;
  const isReverseFee = brandContractType === BrandContractTypeEnum.REVERSE_FEE;

  const styleForSubSummary: React.CSSProperties = {
    fontSize: "0.7rem",
    whiteSpace: "break-spaces",
    borderTop: "1px solid black",
  };
  const styleForMainSummary: React.CSSProperties = {
    fontSize: "1rem",
    color: "#0e9cff",
    fontWeight: "bold",
    whiteSpace: "break-spaces",
    borderTop: "1px solid black",
  };

  const commonItems = (
    <>
      <Descriptions.Item label={"매출"}>
        <NumberComponent value={orderDateElement.statTotalPriceExcludeVat} />
      </Descriptions.Item>
      <Descriptions.Item label={"매입"}>
        <NumberComponent value={orderDateElement.statBrandCostPriceExcludeVat} />
      </Descriptions.Item>
      <Descriptions.Item label={"사용 포인트"}>
        <NumberComponent value={orderDateElement.statRcoinsExcludeVat} />
      </Descriptions.Item>
    </>
  );
  const itemsForMileage = (
    <>
      <Descriptions.Item label={"배송비"}>
        <NumberComponent value={statDeliveryFeeExcludeVat} />
      </Descriptions.Item>
      <Descriptions.Item label={"결제 수수료"}>
        <NumberComponent value={orderDateElement.statBrandPayingChargeExcludeVat} />
      </Descriptions.Item>
      <Descriptions.Item label={"순이익"}>
        <NumberComponent value={statTotalProfitExcludeVat} />
      </Descriptions.Item>
    </>
  );
  const itemsForReverseFee = (
    <>
      <Descriptions.Item label={"순이익"} style={styleForMainSummary}>
        <NumberComponent value={statTotalProfitExcludeVat} />
      </Descriptions.Item>
    </>
  );
  const itemsForNotReverseFee = (
    <>
      <Descriptions.Item label={"본부수익금(공급가액)"} style={styleForSubSummary}>
        <NumberComponent value={orderDateElement.statMileageExcludeVat} />
      </Descriptions.Item>
      <Descriptions.Item label={"본부수익금(세액)"} style={styleForSubSummary}>
        <NumberComponent value={calcVatByPriceExcludeVat(orderDateElement.statMileageExcludeVat)} />
      </Descriptions.Item>
      <Descriptions.Item label={"본부수익금 총액"} style={styleForMainSummary}>
        <NumberComponent
          value={
            orderDateElement.statMileageExcludeVat + calcVatByPriceExcludeVat(orderDateElement.statMileageExcludeVat)
          }
        />
      </Descriptions.Item>
    </>
  );
  const itemsForFulfilledByVendor = (
    <>
      <Descriptions.Item
        label={`${fbvTextForHq} 상품 매입금(공급가액)`}
        style={{ ...styleForSubSummary, borderTop: null }}
      >
        <NumberComponent value={orderDateElement.statBrandCostPriceExcludeVatOnlyFbv} />
      </Descriptions.Item>
      <Descriptions.Item label={`${fbvTextForHq} 상품 매입금(세액)`} style={{ ...styleForSubSummary, borderTop: null }}>
        <NumberComponent
          value={
            orderDateElement.statBrandCostPriceIncludeVatOnlyFbv - orderDateElement.statBrandCostPriceExcludeVatOnlyFbv
          }
        />
      </Descriptions.Item>
      <Descriptions.Item label={`${fbvTextForHq} 상품 매입금 총액`} style={{ ...styleForMainSummary, borderTop: null }}>
        <NumberComponent value={orderDateElement.statBrandCostPriceIncludeVatOnlyFbv} />
      </Descriptions.Item>
    </>
  );

  // 이번달의 20일을 YYYY-MM-DD 형식 string으로 보관한다.
  const targetMonth20 = moment().date(20).format(onlyDateFormat);

  const isMobile: boolean = utils.checkMobile();
  const mileageSettlementStatusInfo = (
    <Row justify={"space-evenly"} align={"middle"} style={{ marginTop: "20px" }}>
      <Col span={4}>
        <Row justify={"center"}>
          <Typography.Title level={5}>{statusInfoTitle}</Typography.Title>
        </Row>
      </Col>
      <Col span={16}>
        <Steps
          current={stepsCurrent}
          items={[
            { title: <MultiLineTypography lines={["확정처리", "(포장보스)"]} /> },
            {
              title:
                stepsCurrent === 1 ? (
                  <Typography.Link href={requestPageUrl}>
                    <MultiLineTypography lines={["신청하기", "(가맹본부)"]} />
                  </Typography.Link>
                ) : (
                  <MultiLineTypography lines={["신청하기", "(가맹본부)"]} />
                ),
              description: <Typography.Text type={"danger"}>마감일 : {targetMonth20}</Typography.Text>,
            },
            { title: <MultiLineTypography lines={["지급검토", "(포장보스)"]} /> },
            { title: "지급완료" },
          ]}
        />
      </Col>
    </Row>
  );

  const mobileMileageSettlementStatusInfo = (
    <Row justify={"space-evenly"} align="middle" style={{ marginTop: "20px" }}>
      <Col span={24}>
        <Row justify={"start"}>
          <Typography.Title level={5}>{statusInfoTitle}</Typography.Title>
        </Row>
      </Col>
      <Col span={24}>
        <Steps
          current={stepsCurrent}
          items={[
            { title: "확정처리 (포장보스)", style: { display: "flex", width: "50%" } },
            {
              title:
                stepsCurrent === 1 ? (
                  <Typography.Link href={requestPageUrl}>신청하기 (가맹본부)</Typography.Link>
                ) : (
                  <>신청하기 (가맹본부)</>
                ),
              description: <Typography.Text type={"danger"}>마감일 : {targetMonth20}</Typography.Text>,
              style: { display: "flex", width: "50%" },
            },
            { title: "지급검토 (포장보스)", style: { display: "flex", width: "50%" } },
            { title: "지급완료", style: { display: "flex", width: "50%" } },
          ]}
          style={{
            display: "flex",
            justifyContent: "center",
            width: "100%",
            flexDirection: "row",
            flexWrap: "wrap",
            marginTop: 20,
          }}
          size="small"
        />
      </Col>
    </Row>
  );

  return (
    <>
      <PageHeader
        title={<Typography.Title level={4}>{title}</Typography.Title>}
        className="ant-page-header-no-margin"
      />
      <br />
      <Card>
        <TableVatLegend isIncludeVat={false} />
        <Descriptions
          bordered
          size="small"
          labelStyle={{
            width: "10%",
            wordBreak: "keep-all",
            verticalAlign: "middle",
            whiteSpace: "nowrap",
          }}
          contentStyle={{ width: "20%" }}
        >
          {isFulfilledByVendor ? (
            itemsForFulfilledByVendor
          ) : (
            <>
              {commonItems}
              {isMileage && itemsForMileage}
              {isReverseFee ? itemsForReverseFee : itemsForNotReverseFee}
            </>
          )}
        </Descriptions>
      </Card>
      {isLastMonth && !isReverseFee && (isMobile ? mobileMileageSettlementStatusInfo : mileageSettlementStatusInfo)}
    </>
  );
};
</file>

<file path="src/app/views/hqStaff/hqHome/utils/orderChartConfig.ts">
import { Datum } from "@ant-design/charts";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { getChartTickConfig, makeChartTickFormat, statsDateType, statsValueType } from "@utils/chart";
import moment from "moment";

const makeOrderStatsData = (
  startDayMoment: moment.Moment,
  duration: number,
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[],
  dateType: statsDateType.DAILY | statsDateType.MONTHLY,
  valueType: statsValueType
) => {
  // startDayMoment가  moment.add 연산으로 변경되면 안되므로 moment 객체 새로 생성해야 함
  const dateMoment = moment(startDayMoment);
  const data = [];

  const isDailyStatsMode = dateType === statsDateType.DAILY;

  for (let i = 0; i < duration; i++) {
    const date = dateMoment.format(onlyDateFormat);
    const dataElement = {
      date: isDailyStatsMode ? date : dateMoment.format(onlyMonthFormat),
      value: 0,
    };
    const statsOrderElement = parsedBrandOrderStats.find((stats) => stats.statDate === date);
    if (statsOrderElement) {
      switch (valueType) {
        case statsValueType.TOTAL_PRICE:
          dataElement.value = statsOrderElement.statTotalPriceExcludeVat;
          break;
        case statsValueType.COUNT:
          dataElement.value = statsOrderElement.statOrderCount;
          break;
        case statsValueType.MILEAGE:
          dataElement.value = statsOrderElement.statMileageExcludeVat;
          break;
        case statsValueType.BRAND_COST_PRICE_ONLY_FBV:
          dataElement.value = statsOrderElement.statBrandCostPriceExcludeVatOnlyFbv;
      }
    }

    data.push(dataElement);
    if (isDailyStatsMode) {
      dateMoment.add(1, "d");
    } else {
      dateMoment.add(1, "M");
    }
  }

  return data;
};

export const makeOrderStatsChartConfig = (
  startDayMoment: moment.Moment,
  duration: number,
  parsedBrandOrderStats: BrandOrderStats_brandOrderStats[],
  dateType: statsDateType.DAILY | statsDateType.MONTHLY,
  valueType: statsValueType
) => {
  // https://charts.ant.design/en/docs/api/common-graph/common-graph
  // https://g2plot.antv.vision/en/docs/api/components/axis#maxlimit

  const chartTickConfig = getChartTickConfig(parsedBrandOrderStats, valueType);
  const minLimit = chartTickConfig[0];
  const maxLimit = chartTickConfig[1];
  const tickCount = chartTickConfig[2];

  const config = {
    height: 150,
    yAxis: {
      minLimit,
      maxLimit,
      tickCount,
      label: {
        formatter: (v: string) => makeChartTickFormat(v),
      },
    },
    xAxis: {
      range: [0, 1],
    },
    data: makeOrderStatsData(startDayMoment, duration, parsedBrandOrderStats, dateType, valueType),
    xField: "date",
    yField: "value",
    label: {
      formatter: (datum: Datum) => datum?.value?.toLocaleString(),
    },
    color: "#0E9CFF",
    areaStyle: {
      fill: "l(270) 0:#ffffff 0.5:#7CC9FF 1:#0E9CFF",
    },
    point: {
      size: 4,
      shape: "circle",
      style: {
        fill: "white",
        stroke: "#0E9CFF",
        lineWidth: 2,
      },
    },
    tooltip: {
      showMarkers: false,
      formatter: (datum: Datum) => ({
        name: "값",
        value: datum?.value?.toLocaleString(),
      }),
    },
    state: {
      active: {
        style: {
          shadowBlur: 4,
          stroke: "#000",
          fill: "red",
        },
      },
    },

    interactions: [
      {
        type: "marker-active",
      },
    ],
  };
  return config;
};
</file>

<file path="src/app/views/hqStaff/hqHome/views/HqHomeView.tsx">
import { commonMsg } from "@assets/messages/commonMsg";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { BrandContractTypeEnum, PermissionEnum, StatReportingMode } from "@src/api/types/globalTypes";
import Loader from "@src/app/components/Loader";
import { PopupNoticeModal } from "@src/app/components/PopupNoticeModal/PopupNoticeModal";
import RequirePermissions from "@src/app/components/RequirePermissions";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { demoViewPath } from "@src/app/views/auth/urls";
import { useVactBrandAssignMutation } from "@src/app/views/hqStaff/hqHome/api/mutations";
import { ReverseFeeDepositInfoForMain } from "@src/app/views/hqStaff/hqHome/components/ReverseFeeDepositInfoForMain";
import {
  useBrandOrderStatsQuery,
  useBrandProductStatsUsingPeriod,
  useBrandUserStatsOrderByCountUsingPeriod,
} from "@src/app/views/hqStaff/hqSection/api/queries";
import { demoIds } from "@src/app/views/hqStaffDemo/hqDemoHome";
import {
  useBrandFbvSettlementsQuery,
  useBrandMileageMonthlySettlementListQuery,
} from "@src/app/views/mileageSettlement/api/queries";
import { useAccountSwitchBrandUpdateMutation } from "@src/app/views/settings/staff/api/mutations";
import { AccountSwitchBrandUpdate } from "@src/app/views/settings/staff/api/types/AccountSwitchBrandUpdate";
import { GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { statsDateType } from "@utils/chart";
import { getGteLteVariables } from "@utils/filters";
import { checkHqStaff, checkIsEnableForFbvServiceByBrand, getBrandId, maybe, transformIsFBVForHq } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Divider, Space } from "antd";
import moment from "moment";
import React, { useState } from "react";

import { BrandOrderStatsVariables } from "../../hqSection/api/types/BrandOrderStats";
import { BasicInfoForMain } from "../components/BasicInfoForMain";
import { BrandEtcFileListForHqModal } from "../components/BrandEtcFileListForHqModal";
import { EtcStatsForMain } from "../components/EtcStatsForMain";
import { OrderStatsForMain } from "../components/OrderStatsForMain";
import { TitleOrderStatsForMain } from "../components/TitleOrderStatsForMain";

enum HqHomeModalModeEnum {
  QueryEtcFileList = "QueryEtcFileList",
}

export const HqHomeView = () => {
  const { user, updateUser } = useUser();

  const handleAccountUpdate = (data: AccountSwitchBrandUpdate) => {
    const errors = data.accountSwitchBrandUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      window.location.reload();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [useAccountSwitchBrandUpdate] = useAccountSwitchBrandUpdateMutation({ onCompleted: handleAccountUpdate });

  // 가맹본부의 switchedBrand가 brand와 다른 경우 brand를 다시 switchedBrand를 update해줘서 원래 브랜드 데이터가 노출되도록 함.
  if (user.switchedBrand?.id !== user.brand.id && user.brand.id) {
    useAccountSwitchBrandUpdate({ variables: { input: { brandToBeChanged: user.brand.id } } });
  }
  const isHqStaff = checkHqStaff(user);
  if (!isHqStaff) {
    return null;
  }

  const navigate = useNavigator();
  if (demoIds.includes(user.loginId)) {
    navigate(demoViewPath);
  }

  const [modalMode, setModalMode] = useState<HqHomeModalModeEnum>(null);
  const openModal = (modalMode: HqHomeModalModeEnum) => setModalMode(modalMode);
  const closeModal = () => setModalMode(null);

  const monthlyStatsDuration = 3;
  const dailyStatsDuration = 7;

  const brandId = getBrandId(user);
  const brand = user?.brand;
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);

  const todayMoment = moment();
  const thisMonthStartDayMoment = moment().startOf("month");
  const thisMonthEndDayMoment = moment().endOf("month");
  const lastMonthStartDayMoment = moment().subtract(1, "M").startOf("month");
  const lastMonthEndDayMoment = moment().subtract(1, "M").endOf("month");
  const before7DaysMoment = moment().subtract(dailyStatsDuration - 1, "d");
  const before3MonthStartDayMoment = moment()
    .subtract(monthlyStatsDuration - 1, "M")
    .startOf("month");

  const titleOrderStats = `${todayMoment.format(onlyMonthFormat)} 판매 현황`;
  const titleOrderStatsLastMonth = `${lastMonthEndDayMoment.format(onlyMonthFormat)} 마감 내역`;

  const makeDateVariable = (startDate: any, endDate: any) =>
    getGteLteVariables({
      gte: startDate.format(onlyDateFormat),
      lte: endDate.format(onlyDateFormat),
    });

  const { data: brandMileageSettlementLastMonthData, loading: brandMileageSettlementLastMonthLoading } =
    useBrandMileageMonthlySettlementListQuery({
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.brands,
        filter: {
          brands: [brandId],
          date: makeDateVariable(lastMonthStartDayMoment, lastMonthEndDayMoment),
        },
      },
    });

  const { data: brandFbvSettlementLastMonthData, loading: brandFbvSettlementLastMonthLoading } =
    useBrandFbvSettlementsQuery({
      skip: !enableForFbvService,
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.brands,
        filter: {
          brands: [brandId],
          date: makeDateVariable(lastMonthStartDayMoment, lastMonthEndDayMoment),
        },
      },
    });

  const { data: orderStatsDuring7DaysData, loading: orderStatsDuring7DaysLoading } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: {
        mode: StatReportingMode.DAILY,
        statDate: makeDateVariable(before7DaysMoment, todayMoment),
      },
    },
  });

  const variablesFor3Months: BrandOrderStatsVariables = {
    id: brandId,
    filter: {
      mode: StatReportingMode.MONTHLY,
      statDate: makeDateVariable(before3MonthStartDayMoment, thisMonthEndDayMoment),
    },
  };
  const { data: orderStatsDuring3MonthsData, loading: orderStatsDuring3MonthsLoading } = useBrandOrderStatsQuery({
    variables: variablesFor3Months,
  });
  const { data: orderStatsDuring3MonthsDataExcludeFbv, loading: orderStatsDuring3MonthsLoadingExcludeFbv } =
    useBrandOrderStatsQuery({
      skip: !enableForFbvService,
      variables: { ...variablesFor3Months, filter: { ...variablesFor3Months.filter, isFulfilledByVendor: false } },
    });
  const { data: orderStatsDuring3MonthsDataOnlyFbv, loading: orderStatsDuring3MonthsLoadingOnlyFbv } =
    useBrandOrderStatsQuery({
      skip: !enableForFbvService,
      variables: { ...variablesFor3Months, filter: { ...variablesFor3Months.filter, isFulfilledByVendor: true } },
    });

  const { data: userStatsTodayData, loading: userStatsTodayLoading } = useBrandUserStatsOrderByCountUsingPeriod({
    variables: { id: brandId, first: 3 },
  });

  const { data: productStatsTodayData, loading: productStatsTodayLoading } = useBrandProductStatsUsingPeriod({
    variables: { id: brandId, first: 5 },
  });

  const queryLoading =
    brandMileageSettlementLastMonthLoading ||
    brandFbvSettlementLastMonthLoading ||
    orderStatsDuring7DaysLoading ||
    orderStatsDuring3MonthsLoading ||
    orderStatsDuring3MonthsLoadingExcludeFbv ||
    orderStatsDuring3MonthsLoadingOnlyFbv ||
    userStatsTodayLoading ||
    productStatsTodayLoading;

  const [vactBrandAssign] = useVactBrandAssignMutation({
    onCompleted: (data) => {
      const errors = data?.vactBrandAssign?.vacsErrors;
      if (errors.length > 0) {
        ShowNotificationError("가상계좌 발급 중 에러가 발생하였습니다. 관리자에게 문의하세요.");
      } else {
        showNotificationSuccess("가상계좌 발급이 완료되었습니다.");
        updateUser({ brand: { ...brand, ...data?.vactBrandAssign?.brand } });
      }
    },
    onError: () => ShowNotificationError("가상계좌 발급 중 에러가 발생하였습니다. 관리자에게 문의하세요."),
  });

  const makeOrderStatsForMainUi = (enableForFbvService: boolean) => {
    if (enableForFbvService) {
      return (
        <>
          {orderStatsDuring3MonthsDataExcludeFbv && (
            <>
              <TitleOrderStatsForMain
                isLastMonth
                title={titleOrderStatsLastMonth + `(${transformIsFBVForHq(false)} 상품)`}
                recentTargetDay={lastMonthStartDayMoment}
                stats={orderStatsDuring3MonthsDataExcludeFbv}
                brand={brand}
                brandMileageLastMonthInfo={
                  brandMileageSettlementLastMonthData?.brandMileageMonthlySettlements?.edges[0]?.node
                }
              />
              <TitleOrderStatsForMain
                title={titleOrderStats + `(${transformIsFBVForHq(false)} 상품)`}
                recentTargetDay={thisMonthStartDayMoment}
                stats={orderStatsDuring3MonthsDataExcludeFbv}
                brand={brand}
              />
            </>
          )}
          {orderStatsDuring3MonthsDataOnlyFbv && (
            <>
              <TitleOrderStatsForMain
                isLastMonth
                isFulfilledByVendor
                title={titleOrderStatsLastMonth + `(${transformIsFBVForHq(true)} 상품)`}
                recentTargetDay={lastMonthStartDayMoment}
                stats={orderStatsDuring3MonthsDataOnlyFbv}
                brand={brand}
                brandFulfilledByVendorLastMonthInfo={
                  brandFbvSettlementLastMonthData?.brandFbvSettlements?.edges[0]?.node
                }
              />
              <TitleOrderStatsForMain
                isFulfilledByVendor
                title={titleOrderStats + `(${transformIsFBVForHq(true)} 상품)`}
                recentTargetDay={thisMonthStartDayMoment}
                stats={orderStatsDuring3MonthsDataOnlyFbv}
                brand={brand}
              />
            </>
          )}
        </>
      );
    }
    return (
      orderStatsDuring3MonthsData && (
        <>
          <TitleOrderStatsForMain
            isLastMonth
            title={titleOrderStatsLastMonth}
            recentTargetDay={lastMonthStartDayMoment}
            stats={orderStatsDuring3MonthsData}
            brand={brand}
            brandMileageLastMonthInfo={
              brandMileageSettlementLastMonthData?.brandMileageMonthlySettlements?.edges[0]?.node
            }
          />
          <TitleOrderStatsForMain
            title={titleOrderStats}
            recentTargetDay={thisMonthStartDayMoment}
            stats={orderStatsDuring3MonthsData}
            brand={brand}
          />
        </>
      )
    );
  };

  return (
    <RequirePermissions
      userPermissions={user?.userPermissions || []}
      requiredPermissions={[PermissionEnum.MANAGE_HQ_STAT]}
    >
      {user?.switchedBrand?.hqPopups.length > 0 && (
        <PopupNoticeModal popupList={user?.switchedBrand?.hqPopups} switchedBrandId={user?.switchedBrand?.id} />
      )}
      <Space direction="vertical" size="small" split={<Divider />}>
        <BasicInfoForMain
          title={"기본 정보"}
          brand={brand}
          openEtcFileListModal={() => openModal(HqHomeModalModeEnum.QueryEtcFileList)}
        />
        {brand?.contractType === BrandContractTypeEnum.REVERSE_FEE && (
          <ReverseFeeDepositInfoForMain
            title={`외상 관리${enableForFbvService ? "(협력사: 리우)" : ""}`}
            brand={brand}
            vactBrandAssignCreateEvent={vactBrandAssign}
          />
        )}
        {queryLoading && <Loader />}
        {makeOrderStatsForMainUi(enableForFbvService)}
        {orderStatsDuring7DaysData && (
          <OrderStatsForMain
            title="최근 7일간 판매 현황"
            recentTargetDay={todayMoment}
            startDay={before7DaysMoment}
            duration={dailyStatsDuration}
            stats={orderStatsDuring7DaysData}
            dateType={statsDateType.DAILY}
            brand={brand}
          />
        )}
        {orderStatsDuring3MonthsData && (
          <OrderStatsForMain
            title="최근 3개월 판매 현황"
