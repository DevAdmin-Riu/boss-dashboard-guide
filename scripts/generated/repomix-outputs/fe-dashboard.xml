import { DownloadOutlined } from "@ant-design/icons";
import { s3TemplateUrl } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import AppHeader from "@src/app/components/AppHeader";
import { SwapNavButtonBar } from "@src/app/components/Navigator/SwapNavButtonBar";
import {
  makeDepositUis,
  makeExclusiveBpvGradeInfoUis,
  makeExclusiveBpvInfoUis,
} from "@src/app/views/hqStaff/hqSection/components/HqInfoProductPage/HqInfoProductPage";
import { FilterPageProps, ListProps } from "@src/global/core/types/types";
import { checkIsEnableForFbvServiceByBrand, transformIsFBV } from "@utils/misc";
import { Button, Card, Col, Row, Space, Tooltip, Typography } from "antd";
import React from "react";
import { useParams } from "react-router";

import { BpBundles_bpBundles_edges_node } from "../../api/types/BpBundles";
import { BrandForBpvList_brand } from "../../api/types/BrandForBpvList";
import { BrandProductPackages_brandProductPackages_edges_node } from "../../api/types/BrandProductPackages";
import { BrandProductListViewRouteParams, brandProductListViewUrl } from "../../urls";
