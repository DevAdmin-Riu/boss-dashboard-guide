import { DownloadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { OrderTypeEnum } from "@src/api/types/globalTypes";
import { CustomRangePickerProps } from "@src/app/components/CustomRangePicker/CustomRangePicker";
import { convertToDurationVariables } from "@src/app/components/DownloadStatsListModal/utils";
import { flattenColumns, makeOneRowForExcel } from "@src/app/components/Filter/SpreadFilter";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { getOrderSalesListTableSettings } from "@src/app/views/order/orders/components/OrderSalesListPage/OrderSalesListTableSettings";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { commonErrorMsg } from "@src/global/assets/messages/errors/commonError";
import { excelDownload } from "@utils/excel/excelDownload";
import { getGteLteVariables } from "@utils/filters";
import { transformIsFBV } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { showGraphQLErrors } from "@utils/notification/wrapperGql";
import { Button, Checkbox, Divider, Modal, ModalProps, PageHeader, Select, Space } from "antd";
import React, { useState } from "react";

import { useSalesListFilterDownloadQuery } from "../../api/queries";
import { SalesList, SalesListVariables } from "../../api/types/SalesList";

interface DownloadModalProps {
  onClose: () => void;
}

export const DownloadSalesByBrandModal: React.FC<ModalProps & DownloadModalProps> = (props) => {
  const { open, onClose } = props;
  const [selectedBrandId, setSelectedBrandId] = useState<string>(null);
  const [isFulfilledByVendor, setIsFulfilledByVendor] = useState<boolean>(false);
  const [selectedDuration, setSelectedDuration] = useState(null);
  const [loadingForReport, setLoadingForReport] = useState<boolean>(false);
  const [fetchForDownload] = useSalesListFilterDownloadQuery();

  const { search, result } = useBrandSearch({
    skip: open === false,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.brands },
  });
  const brandList = result.data?.search?.edges?.map((edge) => edge?.node) || [];
  const brandSelectOptions = brandList?.map((brand) => ({ label: brand.name, value: brand.id }));

  const reset = () => {
    setSelectedBrandId(null);
    setIsFulfilledByVendor(false);
    setSelectedDuration(null);
  };

  const onCloseWithReset = () => {
    onClose();
    reset();
  };

  const downloadToExcel = (responseData: ApolloQueryResult<SalesList>) => {
    const columns = getOrderSalesListTableSettings({
      routeParams: { viewType: null, fulfilledBy: isFulfilledByVendor ? "vendor" : "boss" },
    });
    const flattenedColumns = flattenColumns(columns);

    const rows = [];
    responseData.data.sales.edges.forEach((line, index) => {
      const row = makeOneRowForExcel(line.node, flattenedColumns, index);
      rows.push(row);
    });

    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const selectedBrandName = brandList.find((brand) => brand.id === selectedBrandId)?.name || "-";
    excelDownload({ title: `${selectedBrandName} 월별 매출 상세 데이터`, columns: rows });
    const data = responseData.data;
    if (data.sales?.edges?.length < data.sales?.totalCount) {
      showNotificationWarn(commonErrorMsg.maxLimitIssue);
    } else {
      showNotificationSuccess(commonMsg.downloadedToXls);
    }
    onCloseWithReset();
  };

  const onDownload = (durationVariable: string[]) => {
    setLoadingForReport(true);
    showDownloadingMessage();
    const queryVariables: SalesListVariables = {
      first: GrapheneRelayConnectionMaxLimitEnum.reportSalesList,
      filter: {
        brandId: selectedBrandId,
        isFulfilledByVendor,
        orderType: [OrderTypeEnum.BY_USER, OrderTypeEnum.BY_STAFF_FOR_BRAND],
        eventedAt: getGteLteVariables({
          gte: durationVariable[0],
          lte: durationVariable[1],
        }),
      },
    };

    fetchForDownload({ variables: queryVariables })
      .then(async (responseData) => {
        const errors = responseData?.errors;
        if (errors?.length >= 0) {
          showGraphQLErrors(errors);
        } else {
          downloadToExcel(responseData);
        }
      })
      .catch((e) => {
        showNotificationError("월별매출 상세 데이터 다운로드 과정에서 에러가 발생하였습니다");
        throw e;
      })
      .finally(() => {
        setLoadingForReport(false);
        destroyDownloadingMessage();
      });
  };

  const downloadBtnDisabled = selectedDuration === null;
  const extraUi = () => (
    <Space direction="horizontal">
      <Button onClick={reset}>초기화</Button>
      <Button
        disabled={downloadBtnDisabled}
        loading={loadingForReport}
        type="primary"
        icon={<DownloadOutlined />}
        onClick={() => {
          const durationVariable = convertToDurationVariables(selectedDuration);
          onDownload(durationVariable);
        }}
      >
        엑셀 출력
      </Button>
    </Space>
  );

  return (
    <Modal
      width={700}
      footer={null}
      {...props}
      destroyOnClose
      closable={false}
      onCancel={onCloseWithReset}
      title={<PageHeader title={"월별 매출 상세 데이터 다운로드"} extra={extraUi()} />}
      maskClosable={false}
    >
      <Space direction="vertical" split={<Divider />} size={0}>
        <FormFieldAntd label="브랜드 선택">
          <Select
            showSearch
            style={{ width: "100%" }}
            value={selectedBrandId}
            options={brandSelectOptions}
            onSearch={(value) => search(value)}
            onSelect={(value) => setSelectedBrandId(value)}
            filterOption={false}
            placeholder="브랜드 코드 또는 브랜드 이름으로 검색"
          />
        </FormFieldAntd>
        <FormFieldAntd
          label={`${transformIsFBV(true)} 상품 여부`}
          description={`체크할 경우, ${transformIsFBV(true)} 상품에 대한 매출 상세 데이터가 출력됩니다.`}
        >
          <Checkbox checked={isFulfilledByVendor} onChange={(e) => setIsFulfilledByVendor(e.target.checked)} />
        </FormFieldAntd>
        <CustomRangePickerProps isMonthlyRange initDuration={selectedDuration} onChange={setSelectedDuration} />
      </Space>
    </Modal>
  );
};
</file>

<file path="src/app/views/order/orders/components/EstimatedArrivalDateUpdateModal/EstimatedArrivalDateUpdateModal.tsx">
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { showNotificationError } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Checkbox, DatePicker, Form, Modal } from "antd";
import moment, { Moment } from "moment";
import React, { useEffect, useState } from "react";

import { useOrderUpdateMutation } from "../../api/mutations";
import { OrderDetails_order } from "../../api/types/OrderDetails";

interface IEstimatedArrivalDateForm {
  estimatedArrivalDate: Moment;
  estimatedArrivalDateDoesntMatter: boolean;
}

interface EstimatedArrivalDateUpdateModalProps {
  open: boolean;
  order: OrderDetails_order;
  onClose: () => void;
}

const EstimatedArrivalDateUpdateModal: React.FC<EstimatedArrivalDateUpdateModalProps> = (props) => {
  const { open, order, onClose } = props;
  const [form] = Form.useForm<IEstimatedArrivalDateForm>();
  const [hasChanged, setHasChanged] = useState<boolean>(false);

  const DPicker = DatePicker as any;

  const initialValues: IEstimatedArrivalDateForm = {
    estimatedArrivalDate: order?.estimatedArrivalDate ? moment(order.estimatedArrivalDate) : null,
    estimatedArrivalDateDoesntMatter: utils.isEmpty(order?.estimatedArrivalDate),
  };

  const estimatedArrivalDateDoesntMatterWatched = Form.useWatch("estimatedArrivalDateDoesntMatter", form);

  // estimatedArrivalDateDoesntMatterWatched가 true로 바뀐경우 date 값을 초기화 시킨다. useEffect 사용.
  useEffect(() => {
    if (estimatedArrivalDateDoesntMatterWatched) {
      form.setFields([{ name: "estimatedArrivalDate", value: null }]);
    }
  }, [estimatedArrivalDateDoesntMatterWatched]);

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const onModalClose = () => {
    setHasChanged(false);
    onClose();
  };

  const [orderProductPackageDeliveryUpdate, orderProductPackageDeliveryUpdateOpts] = useOrderUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.orderUpdate?.errors, "납품요청일이 변경되었습니다.", () => {
        onModalClose();
      }),
  });

  const handleSubmit = (formData: IEstimatedArrivalDateForm) => {
    const { estimatedArrivalDate, estimatedArrivalDateDoesntMatter } = formData;
    if (utils.isEmpty(estimatedArrivalDate) && !estimatedArrivalDateDoesntMatterWatched) {
      showNotificationError("납품요청일을 선택해주세요.");
      return;
    }
    const estimatedArrivalDateStr = estimatedArrivalDate?.format(onlyDateFormat);

    orderProductPackageDeliveryUpdate({
      variables: {
        id: order.id,
        input: {
          estimatedArrivalDate: estimatedArrivalDateStr,
          estimatedArrivalDateDoesntMatter,
        },
      },
    });
  };

  const modalLoading = orderProductPackageDeliveryUpdateOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={"납품요청일 변경"}
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading, disabled: !hasChanged }}
      onCancel={onModalClose}
      maskClosable={false}
    >
      <Form
        form={form}
        initialValues={initialValues}
        onValuesChange={() => setHasChanged(true)}
        onFinish={handleSubmit}
      >
        <Form.Item noStyle name={"estimatedArrivalDateDoesntMatter"} valuePropName="checked">
          <Checkbox style={{ marginBottom: ".75rem" }}>납품요청일 상관없음</Checkbox>
        </Form.Item>
        {estimatedArrivalDateDoesntMatterWatched || (
          <Form.Item name={"estimatedArrivalDate"}>
            <DPicker size="large" style={{ width: "100%" }} format={onlyDateFormat} />
          </Form.Item>
        )}
      </Form>
    </Modal>
  );
};

export default EstimatedArrivalDateUpdateModal;
</file>

