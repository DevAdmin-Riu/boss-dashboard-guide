import ShippingStatisticsPage from "../../components/ShippingStatisticsPage/ShippingStatisticsPage";
import {
  ShippingStatisticsViewUrl,
  ShippingStatisticsViewUrlDialog,
  ShippingStatisticsViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filter";

export interface ShippingStatisticsViewProps {
  defaultParams: ShippingStatisticsViewUrlQueryParams;
  params: ShippingStatisticsViewUrlQueryParams;
}

const ShippingStatisticsView: React.FC<ShippingStatisticsViewProps> = (props) => {
  const { defaultParams, params } = props;
  const targetUrl = ShippingStatisticsViewUrl;
  const { navigate, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MILEAGE_SETTLEMENT_LIST,
  });

  const queryVariables: CouriersDeliveryFeesStatsVariables = React.useMemo(
    () => ({
      collectedAt: getFilterVariables(params).collectedAt,
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useCouriersDeliveryFeesStatsQuery({
    initialListSkip: true,
    variables: queryVariables,
  });

  const { data: boxSizeTypeData, loading: boxSizeTypeLoading } = useAttributeDetailsQuery({
    variables: {
      slug: AttributeSlugEnum.boxSize,
    },
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<ShippingStatisticsViewUrlDialog, ShippingStatisticsViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const filterOpts = getFilterOpts(params);

  return (
    <>
      <ShippingStatisticsPage
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        dataSource={data?.couriersDeliveryFeesStats}
        boxSizeTypeData={boxSizeTypeData?.attribute}
        disabled={loading || boxSizeTypeLoading}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};

export default ShippingStatisticsView;
</file>

