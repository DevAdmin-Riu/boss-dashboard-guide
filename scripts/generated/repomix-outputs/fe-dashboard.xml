import React from "react";

import { BsOpsRecheckReportItemCount_bsOpsRecheckReportItemCount } from "../../api/types/BsOpsRecheckReportItemCount";
import {
  BsOpsRecheckReportItemList,
  BsOpsRecheckReportItemList_bsOpsRecheckReportItemList_edges_node,
  BsOpsRecheckReportItemListVariables,
} from "../../api/types/BsOpsRecheckReportItemList";
import { bsOpsRecheckReportItemStatusChoices } from "../../utils";
import { getBsOpsRecheckReportItemListTableSettings } from "./BsOpsRecheckReportItemListTableSettings";
import {
  BsOpsRecheckReportItemListFilterKeys,
  BsOpsRecheckReportItemListFilterOpts,
  createFilterStructure,
} from "./filters";

export interface BsOpsRecheckReportItemListPageProps
  extends PaginateListProps,
    FilterPageProps<BsOpsRecheckReportItemListFilterKeys, BsOpsRecheckReportItemListFilterOpts> {
  user: User;
  countData: BsOpsRecheckReportItemCount_bsOpsRecheckReportItemCount;
  bsOpsRecheckReportItemList: BsOpsRecheckReportItemList_bsOpsRecheckReportItemList_edges_node[];

  queryVariablesWithoutPagination: BsOpsRecheckReportItemListVariables;
  fetchForDownload: (
    variables?: BsOpsRecheckReportItemListVariables
  ) => Promise<ApolloQueryResult<BsOpsRecheckReportItemList>>;
}

export const BsOpsRecheckReportItemListPage: React.FC<BsOpsRecheckReportItemListPageProps> = (props) => {
  const {
    user,
    countData,
    bsOpsRecheckReportItemList,
    currencySymbol,
    currentTab,
    filterOpts,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const isStaff = user.isStaff;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts, isStaff);
  const columns = getBsOpsRecheckReportItemListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const pageTitle = sectionNames.bsOpsRecheckReportItemList;

  const makeCountText = () => {
    if (utils.isEmpty(countData)) {
      return null;
    }

    const statusList = [
      { status: BsOpsRecheckReportItemStatus.REQUESTED, count: countData.requestedCount },
      { status: BsOpsRecheckReportItemStatus.SUBMITTED, count: countData.submittedCount },
      { status: BsOpsRecheckReportItemStatus.RE_REQUESTED, count: countData.reRequestedCount },
      { status: BsOpsRecheckReportItemStatus.COMPLETED, count: countData.completedCount },
    ];

    const totalCount = statusList.reduce((sum, s) => sum + s.count, 0);

    const textArr = [
      `전체: ${totalCount}건`,
      ...statusList.map(
        ({ status, count }) => `${utils.getLabelTextByValue(status, bsOpsRecheckReportItemStatusChoices)}: ${count}건`
      ),
    ];

    return textArr.join(" | ");
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "bsOpsRecheckReportItemList",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
          <Typography.Text type="danger">{makeCountText()}</Typography.Text>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={bsOpsRecheckReportItemList}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
</file>

