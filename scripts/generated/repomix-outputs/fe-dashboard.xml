import { buttonText } from "@assets/messages/buttonText";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import ImageTile from "@src/app/components/ImageTile";
import ImageUpload from "@src/app/components/ImageUpload";
import Skeleton from "@src/app/components/Skeleton";
import { Button, Card } from "antd";
import React from "react";

import { BannerDetails_banner_mobileImage, BannerDetails_banner_pcImage } from "../../api/types/BannerDetails";

export interface BannerImageProps {
  isPc: boolean;
  image: BannerDetails_banner_pcImage | BannerDetails_banner_mobileImage;
  onImageDelete: () => void;
  onImageUpload: (file: File) => void;
}

export const BannerImage: React.FC<BannerImageProps> = (props) => {
  const { isPc, image, onImageDelete, onImageUpload } = props;
  const title = isPc ? "PC" : "모바일";
  const bannerSpec = isPc ? "1200X300px" : "400X180px";
  const anchor = React.useRef<HTMLInputElement>();

  const handleImageUploadButtonClick = () => anchor.current.click();

  return (
    <Card
      title={
        <CardTitleAntd
          title={`${title} 배너 | 권장 규격: ${bannerSpec}`}
          extra={
            <>
              <Button type="primary" onClick={handleImageUploadButtonClick}>
                {buttonText.uploadImage}
              </Button>
              <input
                id="fileUpload"
                style={{ display: "none" }}
                onChange={(event) => onImageUpload(event.target.files[0])}
                type="file"
                ref={anchor}
                accept="image/*"
              />
            </>
          }
        />
      }
    >
      {image === undefined ? (
        <Skeleton />
      ) : image === null ? (
        <ImageUpload onImageUpload={(files) => onImageUpload(files[0])} />
      ) : (
        <ImageTile image={image} onImageDelete={onImageDelete} />
      )}
    </Card>
  );
};
export default BannerImage;
