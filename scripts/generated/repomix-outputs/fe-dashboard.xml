import { BulkAction, Dialog, Pagination, SingleAction, Sort } from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const navigationSectionUrl = "/navigation";

export const menuListViewPath = navigationSectionUrl;
export type MenuListViewUrlDialog = "add" | "remove" | "remove-many";
export enum MenuListViewUrlSortField {
  name = "name",
  items = "items",
}
export type MenuListViewUrlSort = Sort<MenuListViewUrlSortField>;
export type MenuListViewUrlQueryParams = BulkAction &
  Dialog<MenuListViewUrlDialog> &
  MenuListViewUrlSort &
  Pagination &
  SingleAction;
export const menuListViewUrl = (params?: MenuListViewUrlQueryParams) =>
  urlJoin(menuListViewPath, "?" + stringifyQs(params));

export const menuDetailsViewPath = (id: string) => urlJoin(navigationSectionUrl, id);
export type MenuDetailsViewUrlDialog = "add-item" | "edit-item" | "remove";
export type MenuDetailsViewUrlQueryParams = Dialog<MenuDetailsViewUrlDialog> & SingleAction;
export const menuDetailsViewUrl = (id: string, params?: MenuDetailsViewUrlQueryParams) =>
  menuDetailsViewPath(encodeURIComponent(id)) + "?" + stringifyQs(params);
</file>

