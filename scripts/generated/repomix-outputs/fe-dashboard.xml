  params: FbvOrderDeliveryListViewUrlQueryParams;
  urlType: UrlListType<FbvOrderDeliveryUrlEnum, FbvOrderDeliveryListViewUrlQueryParams>;
  isStaff: boolean;
  isVendorStaff: boolean;
  fulfillmentsData: FulfillmentList_fulfillments_edges_node[];
  onChangeDeliveryMethod: (id: string) => void;
  onCompleteTracking: (id: string) => void;
  validateQueryClick?: () => boolean;
  onRowClick?: (id: string) => void;
  queryVariablesWithoutPagination: FulfillmentListVariables;
  fetchForDownload: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>;
  rowSelection: TableRowSelection<FulfillmentList_fulfillments_edges_node>;
}

const FbvOrderDeliveryListPage: React.FC<FbvOrderDeliveryListPageProps> = (props) => {
  const {
    params,
    urlType,
    isStaff,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    fulfillmentsData,
    onChangeDeliveryMethod,
    onCompleteTracking,
    validateQueryClick,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onRowClick,
    isVendorStaff,
    rowSelection,
    ...listProps
  } = props;
  const isFulfilled = urlType.urlEnum === FbvOrderDeliveryUrlEnum.FULFILLED;
  const isTracking =
    urlType.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_A ||
    urlType.urlEnum === FbvOrderDeliveryUrlEnum.TRACKING_B ||
    isFulfilled;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);

  const columns = getFbvOrderDeliveryListTableSettingIncludeVat({
    urlType: urlType.urlEnum,
    onChangeDeliveryMethod,
    onCompleteTracking,
    onRowClick,
    isStaff,
    isVendorStaff,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "fulfillments",
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            validateQueryClick={validateQueryClick}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={props.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          {isFulfilled && <TableVatLegend isIncludeVat={true} />}
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={fulfillmentsData}
            rowSelection={isTracking ? rowSelection : null}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};

