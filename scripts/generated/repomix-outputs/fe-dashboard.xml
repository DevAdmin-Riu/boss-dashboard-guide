<file path="src/app/components/ColumnPicker/ColumnPicker.tsx">
import { SettingOutlined } from "@ant-design/icons";
import useStateFromProps from "@hooks/useStateFromProps";
import { StrictOmit } from "@src/global/core/types/types";
import { toggle } from "@utils/lists";
import { showNotificationInfo } from "@utils/notification/wrapper";
import { Button, Popover, Tooltip } from "antd";
import React from "react";

import { makeFilterTabExtraNotSelectedText } from "../FilterBar/SpreadFilterBar";
import ColumnPickerContent, { ColumnPickerContentProps } from "./ColumnPickerContent";

export interface ColumnPickerProps
  extends StrictOmit<
    ColumnPickerContentProps,
    "selectedColumns" | "onCancel" | "onColumnToggle" | "onAllSelectOn" | "onAllSelectOff" | "onSave"
  > {
  className?: string;
  initialColumns: string[];
  initialOpen?: boolean;
  onSave: (columns: string[]) => void;
  isExpandedTableSetting?: boolean;
}

const ColumnPicker: React.FC<ColumnPickerProps> = (props) => {
  const { columns, initialColumns, initialOpen = false, loading, total, onSave, isExpandedTableSetting } = props;
  const [isExpanded, setExpansionState] = React.useState(false);
  const [selectedColumns, setSelectedColumns] = useStateFromProps(initialColumns);
  const notSelectedCount = Math.max(total - selectedColumns.length, 0);

  React.useEffect(() => {
    setTimeout(() => setExpansionState(initialOpen), 100);
  }, []);

  const handleOpenChange = (newOpen: boolean) => {
    setExpansionState(newOpen);
  };

  const handleCancel = () => {
    setExpansionState(false);
    setSelectedColumns(initialColumns);
  };

  const handleColumnToggle = (column: string) => setSelectedColumns(toggle(column, selectedColumns, (a, b) => a === b));

  const handleAllSelectOn = () => setSelectedColumns(columns.map((item) => item.value));
  const handleAllSelectOff = () => setSelectedColumns([]);

  const handleSave = () => {
    if (selectedColumns.length === 0) {
      showNotificationInfo("선택된 항목이 없습니다. 1개 이상 선택해주세요.");
      return;
    }
    setExpansionState(false);
    onSave(selectedColumns);
  };

  const popoverContent = (
    <ColumnPickerContent
      columns={columns}
      loading={loading}
      selectedColumns={selectedColumns}
      total={total}
      onCancel={handleCancel}
      onColumnToggle={handleColumnToggle}
      onAllSelectOn={handleAllSelectOn}
      onAllSelectOff={handleAllSelectOff}
      onSave={handleSave}
    />
  );

  return (
    <Popover
      placement="bottomRight"
      content={popoverContent}
      trigger="click"
      open={isExpanded}
      onOpenChange={handleOpenChange}
    >
      <Tooltip placement="topRight" title={makeFilterTabExtraNotSelectedText(notSelectedCount)}>
        <Button type="link" icon={<SettingOutlined />} onClick={() => setExpansionState((prevState) => !prevState)}>
          {isExpandedTableSetting && "2단 "}
          테이블 구성{notSelectedCount > 0 && `(${notSelectedCount})`}
        </Button>
      </Tooltip>
    </Popover>
  );
};

export default ColumnPicker;
</file>

<file path="src/app/components/ColumnPicker/ColumnPickerContent.tsx">
import { isSelected } from "@utils/lists";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space } from "antd";
import React from "react";

import ControlledCheckbox from "../ControlledCheckbox";

export interface ColumnPickerChoice {
  label: string | React.ReactNode;
  value: string;
}
export interface ColumnPickerContentProps {
  columns: ColumnPickerChoice[];
  selectedColumns: string[];
  loading: boolean;
  total?: number;
  onCancel: () => void;
  onColumnToggle: (column: string) => void;
  onAllSelectOn: () => void;
  onAllSelectOff: () => void;
  onSave: () => void;
}

const ColumnPickerContent: React.FC<ColumnPickerContentProps> = (props) => {
  const { columns, loading, selectedColumns, total, onCancel, onColumnToggle, onAllSelectOn, onAllSelectOff, onSave } =
    props;
  const isMobile: boolean = utils.checkMobile();
  const cardActions = [
    <Row justify="space-between">
      <Col>
        <Space direction="horizontal">
          <Button size="small" type="default" onClick={onAllSelectOn}>
            전체 선택
          </Button>
          <Button size="small" type="default" onClick={onAllSelectOff}>
            전체 해제
          </Button>
        </Space>
      </Col>
      <Col>
        <Space direction="horizontal">
          <Button size="small" type="default" onClick={onCancel}>
            취소
          </Button>
          <Button size="small" type="primary" onClick={onSave}>
            확인
          </Button>
        </Space>
      </Col>
    </Row>,
  ];

  return (
    <Card
      size="small"
      title={utils.formatMessage("{numberOfTotal}개 중 {numberOfSelected}개의 정보가 선택되었습니다.", {
        numberOfSelected: selectedColumns.length,
        numberOfTotal: total || columns.length,
      })}
      loading={loading}
      actions={cardActions}
      bordered={false}
      style={{ width: isMobile ? 330 : 500 }}
    >
      <Row>
        {columns.map((column) => (
          <Col span={isMobile ? 12 : 8} key={column.value}>
            <ControlledCheckbox
              checked={isSelected(column.value, selectedColumns, (a, b) => a === b)}
              name={column.value}
              label={column.label}
              onChange={() => onColumnToggle(column.value)}
              key={column.value}
            />
          </Col>
        ))}
      </Row>
    </Card>
  );
};

export default ColumnPickerContent;
</file>

