import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { BsOpsCheckTemplateBasicInfoUpdateInput } from "@src/api/types/globalTypes";
import Loader from "@src/app/components/Loader";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React, { useState } from "react";

import {
  useBsOpsCheckTemplateBasicInfoUpdateMutation,
  useBsOpsCheckTemplateCategoryUpdateMutation,
} from "../api/mutations";
import { useBsOpsCheckTemplateDetailsQuery } from "../api/queries";
import { BsOpsCheckTemplateCategoryUpdateVariables } from "../api/types/BsOpsCheckTemplateCategoryUpdate";
import { BsOpsCheckTemplateDetailsPage } from "../components/BsOpsCheckTemplateDetailsPage";
import { bsOpsCheckTemplateListViewUrl } from "../urls";

export enum BsOpsCheckTemplateEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateCategory = "UpdateCategory",
}

interface BsOpsCheckTemplateDetailsViewProps {
  id: string;
}

export const BsOpsCheckTemplateDetailsView: React.FC<BsOpsCheckTemplateDetailsViewProps> = ({ id }) => {
  const { user } = useUser();
  const isStaff = user.isStaff;
  const navigate = useNavigator();
  const [editMode, setEditMode] = useState<BsOpsCheckTemplateEditModeEnum>(null);

  const { data, loading } = useBsOpsCheckTemplateDetailsQuery({ variables: { id, isStaff } });
  const template = maybe(() => data.bsOpsCheckTemplate, null);

  const onEdit = (mode: BsOpsCheckTemplateEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };
  const handleBack = () => {
    navigate(bsOpsCheckTemplateListViewUrl());
  };

  const [bsOpsCheckTemplateBasicInfoUpdate] = useBsOpsCheckTemplateBasicInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bsOpsCheckTemplateBasicInfoUpdate.errors,
        "기본 정보가 수정되었습니다.",
        onEditCancel
      ),
  });
  const [bsOpsCheckTemplateCategoryUpdate] = useBsOpsCheckTemplateCategoryUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bsOpsCheckTemplateCategoryUpdate.errors,
        "카테고리 이름이 수정되었습니다.",
        onEditCancel
      ),
  });

  const handleBasicInfoUpdate = (formData: BsOpsCheckTemplateBasicInfoUpdateInput) => {
    bsOpsCheckTemplateBasicInfoUpdate({ variables: { id, input: formData } });
  };
  const handleCategoryUpdate = (formData: BsOpsCheckTemplateCategoryUpdateVariables) => {
    bsOpsCheckTemplateCategoryUpdate({ variables: formData });
  };

  if (loading) {
    return <Loader />;
  }

  return (
    <>
      <BsOpsCheckTemplateDetailsPage
        user={user}
        template={template}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onCategoryUpdate={handleCategoryUpdate}
        onBack={handleBack}
      />
    </>
  );
};
</file>

