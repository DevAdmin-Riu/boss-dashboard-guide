<file path="src/app/components/KakaoMap.tsx">
import { getInitialMapCenter, getMapClusterStyles, loadKakaoMapSdk, MapLatLng, MapMarker } from "@utils/kakao/kakaoMap";
import { utils } from "@utils/utils";
import React, { useCallback, useEffect, useRef, useState } from "react";

import Loader from "./Loader";

const mapColor = {
  primary: "#0e9cff",
  drawingStroke: "#ff9800",
  drawingFill: "#ffb74d",
};

interface ClusterProps {
  markers: MapMarker[];
  getClusterTexts?: (count: number) => string;
}

type DrawingMode = "marker" | "arrow" | "polyline" | "rectangle" | "circle" | "ellipse" | "polygon";
const convertDrawingMode = (mode: DrawingMode): any => {
  if (!window.kakao || !window.kakao.maps || !window.kakao.maps.Drawing) {
    throw new Error("Kakao Maps Drawing library is not loaded.");
  }
  const { kakao } = window;
  switch (mode) {
    case "marker":
      return kakao.maps.Drawing.OverlayType.MARKER;
    case "arrow":
      return kakao.maps.Drawing.OverlayType.ARROW;
    case "polyline":
      return kakao.maps.Drawing.OverlayType.POLYLINE;
    case "rectangle":
      return kakao.maps.Drawing.OverlayType.RECTANGLE;
    case "circle":
      return kakao.maps.Drawing.OverlayType.CIRCLE;
    case "ellipse":
      return kakao.maps.Drawing.OverlayType.ELLIPSE;
    case "polygon":
      return kakao.maps.Drawing.OverlayType.POLYGON;
    default:
      throw new Error(`Unknown drawing mode: ${mode}`);
  }
};
interface DrawingProps {
  mode: DrawingMode[];
  customByMode?: {
    [key in DrawingMode]?: {
      label?: string;
      buttonWidth?: string;
    };
  };
  polygonPathsList?: MapLatLng[][];
  onSave?: (data: any) => void;
}

interface KakaoMapProps {
  style: React.CSSProperties;
  center?: MapLatLng;
  cluster?: ClusterProps;
  drawing?: DrawingProps;
}

export const KakaoMap: React.FC<KakaoMapProps> = (props) => {
  const { style, center, cluster, drawing } = props;
  const { markers, getClusterTexts = (count: number) => `${count}개` } = cluster || {};
  const { mode, customByMode, polygonPathsList, onSave } = drawing || {};

  const container = useRef<HTMLDivElement>(null);
  const mapRef = useRef<any>(null);
  const zoomControlRef = useRef<any>(null);
  const circleObjectsRef = useRef<any[]>([]);
  const clustererRef = useRef<any>(null);
  const drawingManagerRef = useRef<any>(null);
  const toolboxRef = useRef<any>(null);
  // NOTE: 다각형 외에 다른 도형도 사용하는 경우가 생기면, polygonOverlayRef를 배열이 아닌 객체로 변경하여 관리하는 것이 좋을 듯(+ drawingOverlayRef로 네이밍 변경)
  const polygonOverlayRef = useRef<any[]>([]);
  const selectedDrawModeRef = useRef<DrawingMode | null>(null);
  const [loading, setLoading] = useState<boolean>(true);

  // 마커 및 반경 원 렌더링
  const renderMarkers = useCallback(() => {
    const { kakao } = window;
    if (!mapRef.current || !clustererRef.current || utils.isEmpty(markers)) {
      return;
    }

    // 이전 원 해제
    circleObjectsRef.current.forEach((circle) => circle.setMap(null));
    circleObjectsRef.current = [];

    clustererRef.current.clear();

    const kakaoMarkers = markers.map((m) => {
      const position = new kakao.maps.LatLng(m.lat, m.lng);
      const marker = new kakao.maps.Marker({ position });

      // 반경 원
      const circle = new kakao.maps.Circle({
        center: position,
        radius: 500,
        strokeWeight: 2,
        strokeColor: mapColor.primary,
        strokeOpacity: 0.4,
        fillColor: mapColor.primary,
        fillOpacity: 0.15,
      });
      circle.setMap(mapRef.current);
      circleObjectsRef.current.push(circle);

      if (m.name) {
        const content = `<div style="width:150px;border-radius:10px;text-align:center;padding:4px 0;">${m.name}</div>`;
        const infowindow = new kakao.maps.InfoWindow({ content });
        kakao.maps.event.addListener(marker, "mouseover", () => infowindow.open(mapRef.current, marker));
        kakao.maps.event.addListener(marker, "mouseout", () => infowindow.close());
      }
      return marker;
    });
    clustererRef.current.addMarkers(kakaoMarkers);
  }, [markers, mapRef, clustererRef]);

  const renderPolygon = useCallback(() => {
    const { kakao } = window;
    if (!mapRef.current || !drawingManagerRef.current || utils.isEmpty(polygonPathsList)) {
      return;
    }
    // 이전 다각형 해제
    polygonOverlayRef.current.forEach((polygon) => polygon.setMap(null));
    polygonOverlayRef.current = [];
    drawingManagerRef.current.clear();

    polygonPathsList.forEach((polygonPaths) => {
      const polygon = new kakao.maps.Polygon({
        path: polygonPaths.map((p) => new kakao.maps.LatLng(p.lat, p.lng)),
        strokeWeight: 2,
        strokeColor: mapColor.drawingStroke,
        strokeOpacity: 0.8,
        fillColor: mapColor.drawingFill,
        fillOpacity: 0.3,
      });
      polygon.setMap(mapRef.current);
      polygonOverlayRef.current.push(polygon);
    });
  }, [polygonPathsList, mapRef]);

  // 지도 및 컨트롤/클러스터러/드로잉 툴 최초 1회만 생성
  useEffect(() => {
    let destroyed = false;
    setLoading(true);

    loadKakaoMapSdk().then(() => {
      if (destroyed) {
        return;
      }
      const { kakao } = window;

      // 지도 최초 1회 생성
      if (!mapRef.current && container.current) {
        getInitialMapCenter(center).then((initialCenter) => {
          const centerLatLng = new kakao.maps.LatLng(initialCenter.lat, initialCenter.lng);
          const options = { center: centerLatLng, level: 5 };
          mapRef.current = new kakao.maps.Map(container.current, options);

          // 줌 컨트롤바 최초 1회만 생성
          if (!zoomControlRef.current) {
            zoomControlRef.current = new kakao.maps.ZoomControl();
            mapRef.current.addControl(zoomControlRef.current, kakao.maps.ControlPosition.RIGHT);
          }

          // 클러스터러 최초 1회만 생성
          if (!clustererRef.current) {
            const calculator = [10, 30, 50, 100];
            clustererRef.current = new kakao.maps.MarkerClusterer({
              map: mapRef.current,
              averageCenter: true,
              texts: getClusterTexts,
              calculator,
              styles: getMapClusterStyles(calculator),
            });
          }

          // DrawingManager/Toolbox 최초 1회만 생성
          if (mode && mode.length > 0 && !drawingManagerRef.current && !toolboxRef.current) {
            const strokeColor = mapColor.drawingStroke;
            const fillColor = mapColor.drawingFill;
            const fillOpacity = 0.5;
            const hintStrokeStyle = "dashdot";
            const drawingMode = mode.map(convertDrawingMode);
            const draggable = true;
            const removable = true;

            const drawingOptions = {
              map: mapRef.current,
              drawingMode,
              guideTooltip: ["draw", "drag", "edit"],
              markerOptions: { draggable, removable },
              arrowOptions: { draggable, removable, strokeColor, hintStrokeStyle },
              polylineOptions: { draggable, removable, strokeColor, hintStrokeStyle },
              rectangleOptions: { draggable, removable, strokeColor, fillColor, fillOpacity },
              circleOptions: { draggable, removable, strokeColor, fillColor, fillOpacity },
              ellipseOptions: { draggable, removable, strokeColor, fillColor, fillOpacity },
              polygonOptions: { draggable, removable, strokeColor, fillColor, fillOpacity },
            };

            drawingManagerRef.current = new kakao.maps.Drawing.DrawingManager(drawingOptions);
            drawingManagerRef.current.addListener("drawend", () => {
              highlightButton(null);
            });

            const customToolbox = document.createElement("div");
            customToolbox.style.display = "flex";
            customToolbox.style.flexDirection = "column";
            customToolbox.style.alignItems = "flex-start";
            customToolbox.style.gap = "12px";

            const drawBtnGroup = document.createElement("div");
            drawBtnGroup.style.display = "flex";
            drawBtnGroup.style.flexDirection = "row";
            drawBtnGroup.style.gap = "8px";

            const drawDefaultLabelByMode: Record<DrawingMode, string> = {
              marker: "마커",
              arrow: "화살표",
              polyline: "선",
              rectangle: "사각형",
              circle: "원",
              ellipse: "타원",
              polygon: "다각형",
            };

            const buttonRefs: Record<DrawingMode, HTMLButtonElement> = {} as any;

            const commonButtonStyles: React.CSSProperties = {
              minWidth: "100px",
              padding: "6px 12px",
              fontSize: "14px",
              backgroundColor: "#ffffff",
              color: "#333",
              fontWeight: "normal",
              border: "1px solid #d9d9d9",
              borderRadius: "6px",
              borderColor: "#d9d9d9",
              boxShadow: "0 2px 0 rgba(0,0,0,0.02)",
              cursor: "pointer",
              transition: "all 0.2s ease-in-out",
            };

            const activeButtonStyles: React.CSSProperties = {
              backgroundColor: "#e6f7ff",
              borderColor: "#91d5ff",
              color: "#1890ff",
              fontWeight: "bold",
            };

            const highlightButton = (drawMode: DrawingMode | null) => {
              selectedDrawModeRef.current = drawMode;
              // 모든 버튼 초기화
              Object.entries(buttonRefs).forEach(([_mode, btn]) => {
                Object.assign(btn.style, commonButtonStyles);
              });

              if (drawMode && buttonRefs[drawMode]) {
                const btn = buttonRefs[drawMode];
                Object.assign(btn.style, activeButtonStyles);
              }
            };

            // 도형 도구 버튼들 생성
            mode.forEach((drawMode) => {
              const overlayType = convertDrawingMode(drawMode);
              const label = customByMode?.[drawMode]?.label ?? drawDefaultLabelByMode[drawMode];
              const btn = document.createElement("button");

              btn.innerText = label;
              Object.assign(btn.style, { width: customByMode?.[drawMode]?.buttonWidth }, commonButtonStyles);
              btn.onclick = () => {
                drawingManagerRef.current.select(overlayType);
                highlightButton(drawMode);
              };

              buttonRefs[drawMode] = btn;
              drawBtnGroup.appendChild(btn);
            });

            // 도형 해제 버튼 추가
            const cancelBtn = document.createElement("button");
            cancelBtn.innerText = "선택 해제";
            Object.assign(cancelBtn.style, commonButtonStyles);
            cancelBtn.onclick = () => {
              drawingManagerRef.current.cancel();
              highlightButton(null);
            };
            drawBtnGroup.appendChild(cancelBtn);

            // 저장 및 초기화 버튼
            const actionButtonStyles: React.CSSProperties = {
              minWidth: "70px",
            };

            const clearBtn = document.createElement("button");
            Object.assign(clearBtn.style, commonButtonStyles, actionButtonStyles);
            clearBtn.innerText = "초기화";
            clearBtn.onclick = () => {
              drawingManagerRef.current.clear();
              highlightButton(null);
            };
            drawBtnGroup.appendChild(clearBtn);

            if (!!onSave) {
              const saveBtn = document.createElement("button");
              Object.assign(saveBtn.style, commonButtonStyles, actionButtonStyles);
              saveBtn.innerText = "저장";
              saveBtn.style.backgroundColor = mapColor.primary;
              saveBtn.style.color = "#fff";
              saveBtn.onclick = () => {
                const data = drawingManagerRef.current.getData();
                onSave(data);
              };
              drawBtnGroup.appendChild(saveBtn);
            }

            customToolbox.appendChild(drawBtnGroup);

            // 지도에 컨트롤로 추가
            mapRef.current.addControl(customToolbox, kakao.maps.ControlPosition.TOPLEFT);
          }

          renderMarkers();
          setLoading(false);
        });
      }
    });

    return () => {
      destroyed = true;
      // 클러스터러/마커/원 해제
      if (clustererRef.current) {
        clustererRef.current.clear();
        clustererRef.current.setMap(null);
        clustererRef.current = null;
      }
      // 지도 해제
      if (mapRef.current) {
        mapRef.current = null;
      }
      // 줌 컨트롤 해제
      if (zoomControlRef.current) {
        zoomControlRef.current = null;
      }
      // 원 해제
      circleObjectsRef.current.forEach((circle) => circle.setMap(null));
      circleObjectsRef.current = [];
      // 드로잉 툴 해제
      if (drawingManagerRef.current) {
        drawingManagerRef.current = null;
      }
      if (toolboxRef.current) {
        toolboxRef.current = null;
      }
    };
    // center, markers 등 변경 시에는 별도 useEffect에서 처리
  }, []);

  // center, markers 변경 시 지도 중심 이동/마커 갱신만
  useEffect(() => {
    if (mapRef.current && center) {
      const { kakao } = window;
      const centerLatLng = new kakao.maps.LatLng(center.lat, center.lng);
      mapRef.current.panTo(centerLatLng);
    }
  }, [center]);

  useEffect(() => {
    if (mapRef.current && clustererRef.current) {
      renderMarkers();
    }
  }, [markers]);

  useEffect(() => {
    if (mapRef.current && drawingManagerRef.current && polygonPathsList) {
      renderPolygon();
    }
  }, [polygonPathsList]);

  return (
    <div style={{ width: "100%", height: "100%", ...style }} ref={container}>
      {loading && <Loader />}
    </div>
  );
};
</file>

