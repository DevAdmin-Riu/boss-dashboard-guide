    .filter((menu) => checkShowMenu(isHqStaff, userPermissions, menu))
    .map((menu) => ({
      ...menu,
      children: menu.children?.filter((child) => checkShowMenu(isHqStaff, userPermissions, child)),
    }));

  const isWebView = utils.checkWebView();
  const hasUnreadPushSendEvent = user.hasUnreadPushSendEvent;

  useEffect(() => {
    if (isWebView) {
      sendMessageToWebView("SET_DRAWER_OPEN", isDrawerOpened);
    }
  }, [isDrawerOpened]);

  useWebViewMessageHandler({
    handlers: {
      SET_DRAWER_OPEN: (value) => {
        setDrawerState(value);
      },
    },
  });

  const navigateToHome = () => navigate("/");

  const handleLogout = () => {
    navigateToHome();
    logout();
  };

  const handleViewerProfile = () => {
    navigate(staffDetailsViewUrl(user.id));
  };

  const handleViewerPushSendEventList = () => {
    navigate(pushSendEventListViewUrl());
  };

  const [vactAssign] = useVactAssignMutation({
    onCompleted: (data) => {
      const errors = data?.vactAssign?.vacsErrors;
      if (errors.length > 0) {
        ShowNotificationError("가상계좌 발급 중 에러가 발생하였습니다. 관리자에게 문의하세요.");
      } else {
        showNotificationSuccess("가상계좌 발급이 완료되었습니다.");
        updateUser({ ...user, ...data?.vactAssign?.user });
      }
    },
    onError: () => ShowNotificationError("가상계좌 발급 중 에러가 발생하였습니다. 관리자에게 문의하세요."),
  });

  const [modalMode, setModalMode] = useState<AppLayoutModeEnum>(null);
  const openModal = (modalMode: AppLayoutModeEnum) => setModalMode(modalMode);
  const closeModal = () => setModalMode(null);

  const handleMenuItemClick = (url: string, newTab = false) => {
    if (newTab) {
      window.open(url, "_blank");
    } else {
      setDrawerState(false);
      navigate(url);
    }
  };

  const handleIsMenuSmall = () => {
    setMenuSmall(!isMenuSmall);
  };

  const handleErrorBack = () => {
    navigateToHome();
    dispatchAppState({
      payload: {
        error: null,
      },
      type: "displayError",
    });
  };

  return (
    <>
      {/* NOTE: 가맹본부일 경우 검색이 필요 없을 것으로 판단되고, 검색 허용이 되더라도 대부분이 접근 금지 페이지로 이동 됨. 추후 보이게 하더라도 searchInViews 함수에서 검색 가능한 범위 수정 후 적용 진행. */}
      {!isHqStaff && <Navigator visible={isNavigatorVisible} setVisibility={setNavigatorVisibility} />}
      <AppHeaderContext.Provider value={appHeaderAnchor}>
        <AppActionContext.Provider
          value={{
            anchor: appActionAnchor,
            docked,
            setDocked,
          }}
        >
          <div className={classes.root}>
            <div className={classes.sideBar}>
              <ResponsiveDrawer onClose={() => setDrawerState(false)} open={isDrawerOpened} small={!isMenuSmall}>
                <Link
                  onClick={navigateToHome}
                  className={classNames(classes.logo, {
                    [classes.logoSmall]: isMenuSmall,
                    [classes.logoDark]: false,
                  })}
                >
                  <Image
                    preview={false}
                    src={isBrandUser && user?.brand?.image?.url ? user?.brand?.image?.url : pojangbossLogoSmall}
                    fallback={pojangbossLogoSmall}
                    width={"100%"}
                    alt="logo"
                  />
                </Link>
                <Hidden smDown>
                  <div
                    className={classNames(classes.isMenuSmall, {
                      [classes.isMenuSmallHide]: isMenuSmall,
                      [classes.isMenuSmallDark]: false,
                    })}
                    onClick={handleIsMenuSmall}
                  >
                    <SVG src={menuArrowIcon} style={{ marginLeft: 8 }} />
                  </div>
                </Hidden>
                <MenuList
                  menuItems={filteredMenuItems}
                  isMenuSmall={!isMenuSmall}
                  onMenuItemClick={handleMenuItemClick}
                />
              </ResponsiveDrawer>
            </div>
            <div
              className={classNames(classes.content, {
                [classes.contentToggle]: isMenuSmall,
              })}
            >
              {appState.loading && <LinearProgress className={classes.appLoader} color="primary" />}
              <MobileAppInstallHeader />
              <div className={classes.viewContainer}>
                <Container>
                  <PageHeader
                    className={classes.header}
                    title={
                      <>
                        {isHqStaff && (
                          <Typography.Title className={classes.headerTitle} level={5}>
                            {user.brand?.name} 본부 대시보드
                          </Typography.Title>
                        )}
                        <div
                          className={classNames(classes.menuIcon, {
                            [classes.menuIconOpen]: false,
                            [classes.menuIconDark]: false,
                          })}
                          onClick={() => setDrawerState(!isDrawerOpened)}
                        >
                          <span />
                          <span />
                          <span />
                          <span />
                        </div>
                      </>
                    }
                    breadcrumb={null}
                    subTitle={
                      <Space>
                        {isHqStaff && isMobile === false && <ManualDownloadButton />}
                        <div ref={appHeaderAnchor} />
                      </Space>
                    }
                    extra={
                      <>
                        <div className={classes.spacer} />
                        <div className={classes.userBar}>
                          {!isHqStaff && (
                            <Hidden smDown>
                              <NavigatorButton
                                isMac={navigator.platform.toLowerCase().includes("mac")}
                                onClick={() => setNavigatorVisibility(true)}
                              />
                            </Hidden>
                          )}
                          <div className={classes.userMenuContainer} ref={anchor}>
                            <Space size={0}>
                              {showCreditsInfo && (
                                <Space direction="horizontal" style={{ marginRight: "1rem" }}>
                                  {user.brand.code === "NQY39CUA" && (
                                    <Typography.Text strong className={classes.userInfo}>
                                      외상 충전금 20,000,000원(~2026년 9월 10일까지)
                                    </Typography.Text>
                                  )}
                                  <Typography.Text strong style={{ color: "#1890ff" }} className={classes.userInfo}>
                                    {`충전금: ${formattedCredits}원`}
                                  </Typography.Text>
                                  <Button
                                    size="small"
                                    type="primary"
                                    onClick={() => openModal(AppLayoutModeEnum.HQ_STAFF_VACS_INFO)}
                                  >
                                    충전
                                  </Button>
                                  <HqStaffVacsInfoModal
                                    open={modalMode === AppLayoutModeEnum.HQ_STAFF_VACS_INFO}
                                    onCancel={closeModal}
                                    user={user}
                                    vactAssign={vactAssign}
                                  />
                                </Space>
                              )}
                              <Typography.Text
                                type="secondary"
                                style={{ marginRight: "1rem" }}
                                className={classes.userInfo}
                              >
                                {`${user.firstName} (${user.loginId})`}
                              </Typography.Text>
                              {isHqStaff && isMobile && <ManualDownloadButton iconMode />}
                              <Tooltip placement="bottomRight" title="알림 센터">
                                <Badge dot={hasUnreadPushSendEvent} offset={[-10, 10]}>
                                  <Button
                                    {...commonButtonPropsForLayoutIcon}
                                    icon={<BellOutlined />}
                                    onClick={handleViewerPushSendEventList}
                                    data-test="pushSendEventsButton"
                                  />
                                </Badge>
                              </Tooltip>
                              <Tooltip placement="bottomRight" title="계정 설정">
                                <Button
                                  {...commonButtonPropsForLayoutIcon}
                                  icon={<SettingOutlined />}
                                  onClick={handleViewerProfile}
                                  data-test="accountSettingsButton"
                                />
                              </Tooltip>
                              <Tooltip placement="bottomRight" title="로그아웃">
                                <Button
                                  {...commonButtonPropsForLayoutIcon}
                                  icon={<LogoutOutlined />}
                                  onClick={handleLogout}
                                  data-test="logOutButton"
                                />
                              </Tooltip>
                            </Space>
                          </div>
                        </div>
                      </>
                    }
                  />

                  <main className={classes.view}>
                    {appState.error ? (
                      appState.error === "unhandled" && (
                        <ErrorPage type={ErrorPageEnum.AppError} onBack={handleErrorBack} />
                      )
                    ) : (
                      <>
                        <MobileAppUpdateModal />
                        <BreadcrumbMenu menuItems={filteredMenuItems} />
                        {children}
                      </>
                    )}
                  </main>
                </Container>
              </div>
              <div
                className={classNames(classes.appAction, {
                  [classes.appActionDocked]: docked,
                })}
                ref={appActionAnchor}
              />
            </div>
          </div>
        </AppActionContext.Provider>
      </AppHeaderContext.Provider>
    </>
  );
};

export default AppLayout;
function ShowNotificationError(arg0: string) {
  throw new Error("Function not implemented.");
}
