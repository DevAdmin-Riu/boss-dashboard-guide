  isCreate: true;
  form: FormInstance<PageCreateForm>;
}
interface UpdateProps {
  isCreate: false;
  form: FormInstance<PageBasicInfoUpdateForm>;
  page: PageDetails_page;
  editModeProps: FormSaveButtonEditModeProps;
}
type PageInfoProps = CreateProps | UpdateProps;

const PageInfo: React.FC<PageInfoProps> = (props) => {
