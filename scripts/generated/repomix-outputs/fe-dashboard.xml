<file path="src/app/views/brand/brands/components/BrandCollapseComponents/BrandReverseFeeInfo.tsx">
import { BrandCreateInput, BrandUpdateInput } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField, { NonEditableField } from "@src/app/components/EditableField/EditableField";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { Money } from "@src/app/components/Money";
import { transformPhoneNumber } from "@utils/misc";
import { Checkbox, Col, Form, Row, Switch, Typography } from "antd";
import React, { useEffect, useState } from "react";

interface BrandReverseFeeInfoProps {
  isCreate: boolean;
  TypeSafeForm: TypeSafeForm<BrandCreateInput | BrandUpdateInput>;
  editMode?: boolean;
  reverseFeeDeposit?: number;
  reverseFeeDepositAlarmThreshold?: number;
  reverseFeeDepositMinLimitation?: number;
}

export const BrandReverseFeeInfo: React.FC<BrandReverseFeeInfoProps> = (props) => {
  const {
    isCreate,
    TypeSafeForm,
    editMode,
    reverseFeeDeposit,
    reverseFeeDepositAlarmThreshold,
    reverseFeeDepositMinLimitation,
  } = props;

  const realEditMode = isCreate || editMode;

  const value = TypeSafeForm.getFieldValue("reverseFeeDepositAlarmDays");
  const initialIsReverseFeeDepositAlarmDays = Array.isArray(value) && value.length > 0;

  const [isReverseFeeDepositAlarmDays, setIsReverseFeeDepositAlarmDays] = useState<boolean>(
    initialIsReverseFeeDepositAlarmDays
  );

  const reverseFeeDepositAlarmDaysOptions = Array.from({ length: 31 }, (_, i) => ({
    label: String(i + 1),
    value: String(i + 1),
  }));

  useEffect(() => {
    if (!isReverseFeeDepositAlarmDays) {
      TypeSafeForm.setFields([
        {
          touched: true,
          name: "reverseFeeDepositAlarmDays",
          value: [],
        },
      ]);
    }
  }, [isReverseFeeDepositAlarmDays]);

  return (
    <>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <NonEditableField
            label={<Typography.Text type={"danger"}>외상 잔액</Typography.Text>}
            value={<Money money={{ amount: reverseFeeDeposit > 0 ? 0 : -reverseFeeDeposit }} />}
          />
        </Col>
        <Col xs={24} sm={4}>
          <NonEditableField
            label={<Typography.Text type={"success"}>충전 잔액</Typography.Text>}
            value={<Money money={{ amount: reverseFeeDeposit > 0 ? reverseFeeDeposit : 0 }} />}
          />
        </Col>
        <Col xs={24} sm={4}></Col>
        <Col xs={24} sm={4}>
          <EditableField
            label="외상 한도"
            type={"number"}
            name={TypeSafeForm.getValidDataIndex("minusReverseFeeDepositMinLimitation")}
            renderValue={() => (
              <Money
                money={{
                  amount: reverseFeeDepositMinLimitation != null ? reverseFeeDepositMinLimitation : 0,
                }}
              />
            )}
            isCommaDisplay={false}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <NonEditableField label="외상 경고" value={<Money money={{ amount: -reverseFeeDepositAlarmThreshold }} />} />
        </Col>
      </Row>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <EditableField
            type="input"
            label="통신판매업 신고번호"
            name={TypeSafeForm.getValidDataIndex("reverseFeeMailOrderSales.regNum")}
            value={TypeSafeForm.getFieldValue("reverseFeeMailOrderSales.regNum")}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            type="input"
            label="개인정보보호책임자 성명"
            name={TypeSafeForm.getValidDataIndex("reverseFeeMailOrderSales.privacyInChargePersonName")}
            value={TypeSafeForm.getFieldValue("reverseFeeMailOrderSales.privacyInChargePersonName")}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            type="input"
            label="개인정보보호책임자 소속"
            name={TypeSafeForm.getValidDataIndex("reverseFeeMailOrderSales.privacyInChargeTeam")}
            value={TypeSafeForm.getFieldValue("reverseFeeMailOrderSales.privacyInChargeTeam")}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            type="input"
            label="개인정보보호책임자 연락처"
            name={TypeSafeForm.getValidDataIndex("reverseFeeMailOrderSales.privacyInChargePhone")}
            value={TypeSafeForm.getFieldValue("reverseFeeMailOrderSales.privacyInChargePhone")}
            renderValue={transformPhoneNumber}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            type="input"
            label="개인정보보호책임자 이메일"
            name={TypeSafeForm.getValidDataIndex("reverseFeeMailOrderSales.privacyInChargeEmail")}
            value={TypeSafeForm.getFieldValue("reverseFeeMailOrderSales.privacyInChargeEmail")}
            editMode={realEditMode}
          />
        </Col>
      </Row>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <EditableField
            label="본부 → 매장 세금계산서 발행"
            type="switch"
            name={TypeSafeForm.getValidDataIndex("useFromHqTaxInvoice")}
            value={TypeSafeForm.getFieldValue("useFromHqTaxInvoice")}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            label="리우 → 본부 세금계산서 발행"
            type="switch"
            name={TypeSafeForm.getValidDataIndex("useToHqTaxInvoice")}
            value={TypeSafeForm.getFieldValue("useToHqTaxInvoice")}
            editMode={realEditMode}
          />
        </Col>
      </Row>
      <Row gutter={[8, 0]}>
        <FormFieldAntd label={<Typography.Title level={5}>외상 정기 알림</Typography.Title>}>
          <Col xs={24} sm={4}>
            <Switch
              checked={isReverseFeeDepositAlarmDays}
              onChange={(checked) => setIsReverseFeeDepositAlarmDays(checked)}
              disabled={!realEditMode}
            />
          </Col>
        </FormFieldAntd>
      </Row>
      <Row gutter={[8, 0]}>
        <Col span={24}>
          <Form.Item
            name={TypeSafeForm.getValidDataIndex("reverseFeeDepositAlarmDays")}
            noStyle
            hidden={!isReverseFeeDepositAlarmDays}
          >
            <Checkbox.Group options={reverseFeeDepositAlarmDaysOptions} disabled={!realEditMode} />
          </Form.Item>
        </Col>
      </Row>
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandExclusiveVariantStockInfoListPage/BrandExclusiveVariantStockInfoListPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { commonMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { FilterPageProps, ListProps } from "@src/global/core/types/types";
import { excelDownload, generateExcelDownloadData } from "@utils/excel/excelDownload";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Typography } from "antd";
import React from "react";

import { ExclusiveVariantMonthlyStockInfoForBrandsVariables } from "../../api/types/ExclusiveVariantMonthlyStockInfoForBrands";
import {
  getBrandExclusiveVariantStockInfoListTableSettings,
  getBrandExclusiveVariantStockInfoListTableSummary,
  IBrandExclusiveVariantStockInfoDataSource,
} from "./BrandExclusiveVariantStockInfoListTableSettings";
import {
  BrandExclusiveVariantStockInfoFilterKeys,
  BrandExclusiveVariantStockInfoListFilterOpts,
  createFilterStructure,
} from "./filters";

export interface BrandExclusiveVariantStockInfoListPageProps
  extends ListProps,
    FilterPageProps<BrandExclusiveVariantStockInfoFilterKeys, BrandExclusiveVariantStockInfoListFilterOpts> {
  filterVariables: ExclusiveVariantMonthlyStockInfoForBrandsVariables;
  loading: boolean;
  dataSource: IBrandExclusiveVariantStockInfoDataSource[];
}

export const BrandExclusiveVariantStockInfoListPage: React.FC<BrandExclusiveVariantStockInfoListPageProps> = (
  props
) => {
  const {
    loading,
    dataSource,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const columns = getBrandExclusiveVariantStockInfoListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const columnKeyList = pickerSelectedColumns.map((item) => item.key).filter((item) => item);

  const onPrintClick = () => {
    showDownloadingMessage();

    try {
      const { header, merges, excelColumns } = generateExcelDownloadData<IBrandExclusiveVariantStockInfoDataSource>(
        columns,
        dataSource
      );
      if (!excelColumns || excelColumns.length <= 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      excelDownload({ title: "전용 및 악성 재고 현황", columns: excelColumns, header, merges, skipOriginHeader: true });

      showNotificationSuccess(commonMsg.downloadedToXls);
    } catch {
      showNotificationError("다운로드 중 에러가 발생하였습니다");
    } finally {
      destroyDownloadingMessage();
    }
  };

  const makeExtraUi = () => (
    <Space>
      <Button type="primary" shape="round" icon={<DownloadOutlined />} disabled={loading} onClick={onPrintClick}>
        전용/악성 재고 현황 다운로드
      </Button>
    </Space>
  );

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.brandExclusiveVariantStockInfoList}</Typography.Title>
          </Col>
          <Col>{makeExtraUi()}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable<IBrandExclusiveVariantStockInfoDataSource>
            {...commonTableProps}
            ref={tableRef}
            loading={loading}
            rowKey={(record) => record.brand.id}
            columns={pickerSelectedColumns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            summary={(dataSource) =>
              getBrandExclusiveVariantStockInfoListTableSummary(dataSource, props, columnKeyList)
            }
          />
        </Card>
      </Space>
    </>
  );
};
</file>

