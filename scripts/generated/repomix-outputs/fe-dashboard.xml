import { RefundQAHistoryStatus, RefundQAStatus } from "@src/api/types/globalTypes";
import { getDateByFormat } from "@src/app/providers/DateProvider";

import { RefundQuestionList_refundQuestions_edges_node_customerQuestionHistory } from "../../api/types/RefundQuestionList";

export const refundStatusTypeLabelColor = (status: RefundQAStatus) => {
  switch (status) {
    case RefundQAStatus.REFUND_SUCCESS:
      return "#87d068";
    case RefundQAStatus.REQUESTED:
      return "blue";
    case RefundQAStatus.REJECT:
      return "#cd201f";
    case RefundQAStatus.COLLECTED_INSPECT:
      return "purple";
    case RefundQAStatus.REFUND_PENDING:
      return "#108ee9";
    default:
      break;
  }
};

export const getRefundStatusTypeLabel = (refundStatusTypeChoices, status) => {
  const index = refundStatusTypeChoices.findIndex((item) => item.value === status);
  if (index === -1) {
    return "-";
  }
  return refundStatusTypeChoices[index].label;
};

export const getHistoryTime = (
  customerQuestionHistory: RefundQuestionList_refundQuestions_edges_node_customerQuestionHistory[],
  status: RefundQAHistoryStatus
) => {
  const findStatusIdx = customerQuestionHistory.findIndex((item) => item.status === status);
  if (findStatusIdx === -1) {
    return "-";
  }

  return getDateByFormat(customerQuestionHistory[findStatusIdx].createAt);
};

export const mergeRefundReasonChoices = (refundReasonChoices, refundCancelReasonChoices) => {
  const refundReasonChoicesWithCancel = [...refundReasonChoices, ...refundCancelReasonChoices];
  return refundReasonChoicesWithCancel;
};
