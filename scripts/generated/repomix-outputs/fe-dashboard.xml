import SpreadFilter from "@src/app/components/Filter/SpreadFilter";
import TableListFooter from "@src/app/components/TableListFooter";
import { HqReqBossProductCreateViewUrlQueryParams } from "@src/app/views/hqStaff/hqRequestProduct/urls";
import { FilterProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Space, Table } from "antd";
import React from "react";

import { InitialProductVariantForReqFilterData_categories_edges_node } from "../../api/types/InitialProductVariantForReqFilterData";
import { ProductVariantListForReq_productVariants_edges_node } from "../../api/types/ProductVariantListForReq";
import { ProductVariantListForReqViewUrlQueryParams } from "../../urls";
import { getFilterOpts } from "../../views/ProductVariantListForReqView/filters";
import { createFilterStructure, ProductVariantListForReqFilterKeys } from "../ProductVariantListForReqPage/filters";
import { getProductVariantListForReqTableSettings } from "./ProductVariantListForReqTableSettings";

export interface ProductVariantListForReqTableProps
  extends PaginateListProps,
    FilterProps<ProductVariantListForReqFilterKeys> {
  params: ProductVariantListForReqViewUrlQueryParams | HqReqBossProductCreateViewUrlQueryParams;
  loading: boolean;
  productVariants: ProductVariantListForReq_productVariants_edges_node[];
  categoriesForFilter: {
    initial: InitialProductVariantForReqFilterData_categories_edges_node[];
    search: UseSearchResult<SearchCategories, SearchCategoriesVariables>;
  };
  onFilterReset: () => void;
}

export const ProductVariantListForReqTable: React.FC<ProductVariantListForReqTableProps> = (props) => {
  const {
    loading,
    params,
    productVariants,
    categoriesForFilter,
    onFilterReset,
    onFilterChange,
    onRowClick,
    ...listProps
  } = props;
  const { user } = useUser();
  const filterOpts = getFilterOpts(params, categoriesForFilter);
  const filterStructure = createFilterStructure(filterOpts, user);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const columns = getProductVariantListForReqTableSettings({ user, onRowClick });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Space direction="vertical" size="large">
      <SpreadFilter
        currencySymbol="원"
        menu={filterStructure}
        onFilterChange={onFilterChange}
        onFilterReset={onFilterReset}
      />
      <Table
        {...commonTableProps}
        ref={tableRef}
        tableLayout="fixed"
        loading={loading}
        columns={columns}
        dataSource={productVariants}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
        footer={() => <TableListFooter {...listProps} />}
      />
    </Space>
  );
};
