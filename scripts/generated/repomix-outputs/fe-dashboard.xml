import NumberComponent from "@src/app/components/Number";
import { onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { purchaseLineCountQuery } from "@src/app/views/purchase/purchaseOrders/api/queries";
import { usePurchaseBulkCloseMutation } from "@src/app/views/purchase/purchases/api/mutations";
import { purchaseListQuery } from "@src/app/views/purchase/purchases/api/queries";
import { Purchases_purchases_edges_node } from "@src/app/views/purchase/purchases/api/types/Purchases";
import {
  makePurchaseTotalAmount,
  makePurchaseTotalExcludeVat,
  makePurchaseVatAmount,
} from "@src/app/views/purchase/purchases/components/PurchaseListPage/utils";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Descriptions, Divider, Modal, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

export const makeConfirmNodeForPurchaseTotal = (
  purchaseCloseData: Moment,
  purchases: Purchases_purchases_edges_node[]
) => {
  const totalAmountExcludeVat = purchases.reduce((acc, cur) => {
    const totalAmountExcludeVatByPurchase = makePurchaseTotalExcludeVat(cur, false) as number;
    return acc + totalAmountExcludeVatByPurchase;
  }, 0);
  const totalVat = purchases.reduce((acc, cur) => {
    const vatAmountByPurchase = makePurchaseVatAmount(cur, false) as number;
    return acc + vatAmountByPurchase;
  }, 0);
  const totalAmount = purchases.reduce((acc, cur) => {
    const totalAmountByPurchase = makePurchaseTotalAmount(cur, false) as number;
    return acc + totalAmountByPurchase;
  }, 0);

  return (
    <Space direction="vertical">
      <Typography.Title level={5}>마감월: {purchaseCloseData?.format(onlyMonthFormat)}</Typography.Title>
      <Descriptions bordered size="small" column={1} title="정산 대상 정보">
        <Descriptions.Item label="공급가액" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalAmountExcludeVat} />
        </Descriptions.Item>
        <Descriptions.Item label="부가세" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalVat} />
        </Descriptions.Item>
        <Descriptions.Item label="총 합계" contentStyle={{ float: "right" }}>
          <NumberComponent includeCurrency value={totalAmount} />
        </Descriptions.Item>
      </Descriptions>
    </Space>
  );
};

interface VsPurchaseBulkCloseModalProps {
  open: boolean;
  loading: boolean;
  purchases: Purchases_purchases_edges_node[];
  purchaseCloseDate: string | null;
  onCancel: (shouldReset: boolean) => void;
}

export const VsPurchaseBulkCloseModal: React.FC<VsPurchaseBulkCloseModalProps> = (props) => {
  const { open, loading, purchases, purchaseCloseDate, onCancel } = props;
  const purchaseIds = purchases.map((purchase) => purchase.id);
  const purchaseCloseDateMoment = moment(purchaseCloseDate).endOf("month");

  const [purchaseBulkClose, purchaseBulkCloseOpts] = usePurchaseBulkCloseMutation({
    onCompleted: (data) => {
      const errors = data.purchaseBulkClose.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 정산 내역이 확정되었습니다.");
        onCancel(true);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [purchaseListQuery, purchaseLineCountQuery],
  });

  const onSubmit = () => {
    purchaseBulkClose({
      variables: { ids: purchaseIds, purchaseCloseDate: purchaseCloseDateMoment.format(onlyDateFormat) },
    });
  };

  const modalLoading = loading || purchaseBulkCloseOpts.loading;

  return (
    <Modal
      forceRender
      destroyOnClose
      title="정산 확정"
      open={open}
      okText="확정"
      confirmLoading={modalLoading}
      onOk={onSubmit}
      onCancel={() => onCancel(false)}
    >
      <Typography>선택된 {getNumberFormat(purchaseIds?.length)}건의 정신 내역을 확정 처리 하시겠습니까?</Typography>
      <Divider />
      {makeConfirmNodeForPurchaseTotal(purchaseCloseDateMoment, purchases)}
    </Modal>
  );
};
</file>

