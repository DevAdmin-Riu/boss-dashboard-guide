  if (open && data?.orders?.edges?.length < data?.orders.totalCount) {
    showNotificationWarn(commonErrorMsg.maxLimitIssue);
  }

  return (
    <Modal
      width={700}
      title={`${userName} 상품구매내역`}
      open={open}
      onCancel={handleClose}
      footer={[
        <Button type="default" onClick={handleClose}>
          뒤로
        </Button>,
      ]}
    >
      {data && (
        <Table
          {...commonTableProps}
          columns={columns}
          dataSource={rearrangeToOrderLine(data?.orders)}
          scroll={{ x: tableWidthSum, y: 400 }}
