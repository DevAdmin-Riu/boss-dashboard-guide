import useNavigator from "@hooks/useNavigator";
import { useMetadataUpdate, usePrivateMetadataUpdate } from "@src/api/core/metadata/updateMetadata";
import { WindowTitle } from "@src/app/components/WindowTitle";
import createMetadataCreateHandler from "@utils/handlers/metadataCreateHandler";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useProductTypeCreateMutation } from "../api/mutations";
import { ProductTypeCreate as ProductTypeCreateMutation } from "../api/types/ProductTypeCreate";
import ProductTypeCreatePage, { ProductTypeCreateForm } from "../components/ProductTypeCreatePage";
import { productTypeDetailsViewUrl, productTypeListViewUrl } from "../urls";

export const ProductTypeCreateView: React.FC = () => {
  const navigate = useNavigator();

  const [updateMetadata] = useMetadataUpdate({});
  const [updatePrivateMetadata] = usePrivateMetadataUpdate({});

  const handleCreateSuccess = (data: ProductTypeCreateMutation) => {
    const errors = data.productTypeCreate.errors;
    if (errors.length === 0) {
      showNotificationSuccess("제품 타입을 추가했습니다.");
      navigate(productTypeDetailsViewUrl(data.productTypeCreate.productType.id));
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [createProductType, createProductTypeOpts] = useProductTypeCreateMutation({
    onCompleted: handleCreateSuccess,
  });

  const handleCreate = async (formData: ProductTypeCreateForm) => {
    const result = await createProductType({
      variables: {
        input: {
          name: formData.name,
          hasVariants: false,
          // NOTE: 직거래 상품 타입 전용 여부는 옵션형 제품 타입인 경우엔 활성화 불가.
          isFulfilledByVendor: formData.isFulfilledByVendor,
        },
      },
    });

    return result.data?.productTypeCreate.productType?.id || null;
  };
  const handleSubmit = createMetadataCreateHandler(handleCreate, updateMetadata, updatePrivateMetadata);

  return (
    <>
      <WindowTitle title="제품 타입 추가" />
      <ProductTypeCreatePage
        errors={createProductTypeOpts.data?.productTypeCreate.errors || []}
        pageTitle="제품 타입 추가"
        saveButtonBarState={createProductTypeOpts.status}
        onBack={() => navigate(productTypeListViewUrl())}
        onSubmit={handleSubmit}
      />
    </>
  );
};
</file>

