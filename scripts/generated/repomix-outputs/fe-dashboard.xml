export const transformBusinessNumber = (bizNumber) => {
  // 숫자를 문자열로 변환
  const numStr = bizNumber.toString();

  // 숫자가 정확히 10자리인지 확인
  if (numStr.length !== 10) {
    return numStr;
  }

  // 숫자를 사업자등록번호 형식으로 변환
  return `${numStr.substring(0, 3)}-${numStr.substring(3, 5)}-${numStr.substring(5)}`;
};

