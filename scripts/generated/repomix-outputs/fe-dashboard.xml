import {
  ActiveTab,
  Dialog,
  Filters,
  Pagination,
  SingleAction,
  Sort,
  TabActionDialog,
} from "@src/global/core/types/types";
import { stringify as stringifyQs } from "qs";
import urlJoin from "url-join";

export const pluginSectionUrl = "/plugins";

export const pluginListViewPath = pluginSectionUrl;
export enum PluginListViewUrlFiltersEnum {
  search = "search",
  active = "active",
}
export type PluginListViewUrlFilters = Filters<PluginListViewUrlFiltersEnum>;
export type PluginListViewUrlDialog = TabActionDialog;
export enum PluginListViewUrlSortField {
  name = "name",
  active = "active",
}
export type PluginListViewUrlSort = Sort<PluginListViewUrlSortField>;
export type PluginListViewUrlQueryParams = ActiveTab &
  Dialog<PluginListViewUrlDialog> &
  PluginListViewUrlFilters &
  Pagination &
  PluginListViewUrlSort &
  SingleAction;
export const pluginListViewUrl = (params?: PluginListViewUrlQueryParams) =>
  urlJoin(pluginListViewPath, "?" + stringifyQs(params));

export const pluginDetailsViewPath = (id: string) => urlJoin(pluginSectionUrl, id);
export type PluginDetailsViewUrlDialog = "clear" | "edit";
export type PluginDetailsViewUrlQueryParams = Dialog<PluginDetailsViewUrlDialog> & SingleAction;
export const pluginDetailsViewUrl = (id: string, params?: PluginDetailsViewUrlQueryParams) =>
  pluginDetailsViewPath(encodeURIComponent(id)) + "/?" + stringifyQs(params);
