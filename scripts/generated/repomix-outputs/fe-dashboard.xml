    key: "baseSellPriceSetDate",
    align: "center",
    width: 120,
    render: (_, record) => getDateByFormat(record.variant?.baseSellPriceSetDate, onlyDateFormat),
  };
  const marketLowestPriceExcludeVatColumn: DownloadableColumnType<ProductDataSourceType> = {
    title: columnNameConstant.product.MARKET_LOWEST_PRICE,
