<file path="src/app/components/Collapse/CollapseList.tsx">
import { Collapse } from "antd";
import { Descriptions } from "antd";
import type { ColumnsType } from "antd/es/table";
import React from "react";

import { DownloadableColumnType } from "../antd/Table/TableProps";

const { Panel } = Collapse;

export interface CollapseListProps<TParent, TChild> {
  /** 최상위 데이터 배열 */
  dataSource: TParent[];
  /** 각 부모 아이템의 고유키 프로퍼티명 (예: "id") */
  parentKey: keyof TParent;
  /** 자식 배열이 담긴 프로퍼티명 (예: "rackStocks") */
  childrenKey: keyof TParent;
  /** 부모 패널 헤더를 렌더할 콜백 */
  renderParent: (parent: TParent) => React.ReactNode;
  /** 자식 패널 헤더를 렌더할 콜백 */
  renderChildHeader: (child: TChild) => React.ReactNode;
  /** 자식 패널 컨텐츠를 렌더할 콜백 */
  renderChildContent: (child: TChild) => React.ReactNode;
  /** 자식 패널 extra 영역(버튼 등)을 렌더할 콜백 */
  renderChildExtra?: (parent: TParent, child: TChild) => React.ReactNode;
  /** 부모 패널 style */
  panelStyle?: React.CSSProperties;
  /** 자식 패널 style */
  childPanelStyle?: React.CSSProperties;
}

const CollapseList = <TParent extends Record<string, any>, TChild>(
  props: CollapseListProps<TParent, TChild>
): JSX.Element => {
  const {
    dataSource,
    parentKey,
    childrenKey,
    renderParent,
    renderChildHeader,
    renderChildContent,
    renderChildExtra,
    panelStyle,
    childPanelStyle,
  } = props;

  return (
    <>
      {dataSource.map((parent) => {
        const key = String(parent[parentKey]);
        const children = (parent[childrenKey] as TChild[]) || [];

        return (
          <Collapse key={key} style={panelStyle}>
            <Panel header={renderParent(parent)} key={key}>
              {children.map((child, index) => {
                const childKey = `${key}-${(child as any)[parentKey] ?? index}`;
                return (
                  <Collapse key={childKey} style={childPanelStyle}>
                    <Panel
                      header={renderChildHeader(child)}
                      key={childKey}
                      className="collapse-child-panel-direction-column"
                      extra={renderChildExtra?.(parent, child)}
                    >
                      {renderChildContent(child)}
                    </Panel>
                  </Collapse>
                );
              })}
            </Panel>
          </Collapse>
        );
      })}
    </>
  );
};

export default CollapseList;

interface CreateDescriptionsRendererOptions<T> {
  columns: ColumnsType<T>;
  filter?: (column: DownloadableColumnType<T>) => boolean;
  bordered?: boolean;
  size?: "small" | "middle" | "default";
  column?: number | { xs?: number; sm?: number; md?: number };
  labelStyle?: React.CSSProperties;
}

export const createDescriptionsRenderer =
  <T extends object>({
    columns,
    filter = () => true,
    bordered = true,
    size = "small",
    column = { xs: 1, sm: 1, md: 2 },
    labelStyle,
  }: CreateDescriptionsRendererOptions<T>) =>
  (record: T): React.ReactNode =>
    (
      <Descriptions bordered={bordered} size={size} column={column} labelStyle={labelStyle}>
        {columns.filter(filter).map((column, index) => {
          const { title, key, render } = column;
          return (
            <Descriptions.Item key={String(key)} label={title}>
              {render?.(null, record, index)}
            </Descriptions.Item>
          );
        })}
      </Descriptions>
    );
</file>

