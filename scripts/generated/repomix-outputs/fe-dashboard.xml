import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import { PopupList_popups_edges_node } from "@src/app/views/notice/popups/api/types/PopupList";
import {
  hqPopupListViewUrl,
  popupListViewUrl,
  PopupListViewUrlQueryParams,
  PopupListViewUrlSortField,
} from "@src/app/views/notice/popups/urls";
import { PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Segmented, Space, Table, Typography } from "antd";
import React from "react";

import { getPopupListTableSettings } from "./PopupListTableSettings";
import { createSorterStructure } from "./sorters";

export interface PopupListPageProps extends PaginateListProps, SortPage<PopupListViewUrlSortField> {
  params: PopupListViewUrlQueryParams;
  popups: PopupList_popups_edges_node[];
  isHqPopup: boolean;
}

const makePopupButtonUi = (onAdd) => (
  <Space size={8}>
    <Button type="primary" shape="round" onClick={onAdd}>
      팝업 추가
    </Button>
  </Space>
);

export type popupTab = "bossToHq" | "bossToUser";

const PopupListPage: React.FC<PopupListPageProps> = (props) => {
  const navigate = useNavigator();
  const { popups, sort, onAdd, onSort, isHqPopup, ...listProps } = props;
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getPopupListTableSettings(props);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const popupTabValue: popupTab = isHqPopup ? "bossToHq" : "bossToUser";

  const onClickNoticeTab = (value: popupTab) => {
    if (value === "bossToHq") {
      navigate(hqPopupListViewUrl());
    } else {
      navigate(popupListViewUrl());
    }
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.bossPopup}</Typography.Title>

          <Segmented
            options={[
              { label: "포장보스 → 가맹본부", value: "bossToHq" },
              { label: "포장보스 → 매장", value: "bossToUser" },
            ]}
            value={popupTabValue}
            onChange={(value: popupTab) => onClickNoticeTab(value)}
            style={{ marginTop: 24 }}
          />
        </Col>
        <Col>{makePopupButtonUi(onAdd)}</Col>
      </Row>

      <Card>
        <Row justify="end">
          <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
        </Row>
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={getPopupListTableSettings(props)}
          dataSource={popups}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...props} />}
        />
      </Card>
    </Space>
  );
};

export default PopupListPage;
</file>

<file path="src/app/views/notice/popups/components/PopupListPage/PopupListTableSettings.tsx">
import useNavigator from "@hooks/useNavigator";
import StatusLabel from "@src/app/components/StatusLabel";
import { PopupList_popups_edges_node } from "@src/app/views/notice/popups/api/types/PopupList";
import { hqPopupDetailsViewUrl, popupDetailsViewUrl } from "@src/app/views/notice/popups/urls";
import { utils } from "@utils/utils";
import { Tag, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import moment from "moment";
import React from "react";

import { PopupListPageProps } from "./PopupListPage";

export function getPopupListTableSettings(props: PopupListPageProps) {
  const navigate = useNavigator();
  const onEditClick = (record: PopupList_popups_edges_node) => {
    navigate(props.isHqPopup ? hqPopupDetailsViewUrl(record.id) : popupDetailsViewUrl(record.id));
  };
  const columns: ColumnsType<PopupList_popups_edges_node> = [
    {
      title: "팝업명",
      align: "left",
      key: "name",
      width: 200,
      render: (_, record) => <Typography.Link onClick={() => onEditClick(record)}>{record.name}</Typography.Link>,
    },
    {
      title: "게시 시작일",
      align: "center",
      key: "start",
      width: 120,
      render: (_, record) => record.start,
    },
    {
      title: "게시 마감일",
      align: "center",
      key: "end",
      width: 120,
      render: (_, record) =>
        moment(record.end).diff(moment(record.start), "years") <= 100 ? record.end : "마감일 미설정",
    },
    {
      title: "게시 여부",
      align: "center",
      key: "visibleToBrand",
      width: 80,
      render: (_, record) => (
        <StatusLabel
          status={(props.isHqPopup ? record.visibleToHqBrand : record.visibleToBrand) ? "success" : "error"}
          useSmallDot={false}
        />
      ),
    },
    {
      title: "게시 브랜드",
      align: "center",
      key: "availableBrands",
      width: 300,
      render: (_, record) => {
        if (record.availableToAllBrands) {
          return <Tag>전체 브랜드 게시</Tag>;
        }
        const availableBrandNames = record.availableBrands.map((brand) => brand.name);
        return utils.summarizeArray(availableBrandNames, 3, "브랜드");
      },
    },
  ];
  return columns;
}
