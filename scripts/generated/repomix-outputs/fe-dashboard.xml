        }
        return <Tag color="geekblue">정상</Tag>;
      },
    },
    {
      title: columnNameConstant.purchaseOrder.INSPECT_REPORT,
      key: "reportFile",
      width: 120,
      align: "center",
      render: (_, record) => {
        const reportFile = record.reportFile;
        if (!reportFile?.url) {
          return "-";
        }

        return (
          <Button
            type="primary"
            shape="round"
            icon={<DownloadOutlined />}
            href={reportFile.url}
            target="_blank"
            rel="noopener noreferrer"
          >
