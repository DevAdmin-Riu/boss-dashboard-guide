<file path="src/app/views/purchase/vendors/components/FbvBrandAddModal/FbvBrandAddModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { VendorFragment_fbvBrands } from "@src/api/fragments/types/VendorFragment";
import { SearchBrandsSimple_search_edges_node } from "@src/api/searches/types/SearchBrandsSimple";
import { useBrandsSearchSimple } from "@src/api/searches/useBrandSearch";
import { BrandServiceTypeEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Input, Modal, Row, Space, Typography } from "antd";
import Table, { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useState } from "react";

interface FbvBrandAddModalProps {
  open: boolean;
  currentFbvBrands: VendorFragment_fbvBrands[];
  onClose: () => void;
  onSubmit: (selectedBrandIdList: string[]) => void;
  loading: boolean;
}

const FbvBrandAddModal: React.FC<FbvBrandAddModalProps> = (props) => {
  const { open, currentFbvBrands, onClose, onSubmit, loading } = props;
  const currentFbvBrandIdList = maybe(() => currentFbvBrands.map((b) => b.id), []);
  const [selectedBrandIdList, setSelectedBrandIdList] = useState<string[]>([]);

  const { loadMore, search, result } = useBrandsSearchSimple({
    skip: !open,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.commonMaxLimit,
      isRunning: true,
      enabledServices: [BrandServiceTypeEnum.FBV],
    },
  });
  const hasMoreBrands = maybe(() => result.data.search.pageInfo.hasNextPage, false);
  const searchedBrandList = maybe(() => result.data.search.edges.map((edge) => edge.node), []);
  const filteredBrandList = searchedBrandList.filter((brand) => !currentFbvBrandIdList.includes(brand.id));

  const handleClose = () => {
    setSelectedBrandIdList([]);
    onClose();
  };

  const handleSubmit = () => {
    onSubmit(selectedBrandIdList);
    handleClose();
  };

  const columns: ColumnsType<SearchBrandsSimple_search_edges_node> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "code",
      align: "center",
      width: 120,
      render: (_, record) => maybe(() => record.code, "-"),
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "name",
      align: "center",
      width: 200,
      render: (_, record) => maybe(() => record.name, "-"),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<SearchBrandsSimple_search_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedBrandIdList,
    onChange: (selectedRowKeys, _selectedRows) => setSelectedBrandIdList(selectedRowKeys as string[]),
  };

  const submitBtnDisabled = selectedBrandIdList.length === 0;
  const modalFooter = (
    <Space>
      <Button type="default" onClick={handleClose}>
        뒤로
      </Button>
      <Button type="primary" disabled={submitBtnDisabled || loading} onClick={handleSubmit}>
        추가
      </Button>
    </Space>
  );

  return (
    <Modal
      destroyOnClose
      title="브랜드 추가"
      open={open}
      onCancel={handleClose}
      footer={modalFooter}
      width={750}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Input.Search enterButton size="large" name="query" onSearch={search} placeholder="브랜드 검색" />
        <Table
          {...commonTableProps}
          columns={columns}
          dataSource={filteredBrandList}
          rowSelection={rowSelection}
          scroll={{ x: tableWidthSum, y: 500 }}
          footer={
            hasMoreBrands &&
            (() => (
              <Row justify="center">
                <Typography.Link onClick={loadMore}>더 보기</Typography.Link>
              </Row>
            ))
          }
        />
      </Space>
    </Modal>
  );
};

export default FbvBrandAddModal;
</file>

