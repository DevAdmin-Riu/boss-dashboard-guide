<file path="src/app/views/b2b/components/B2bSalesStatListPage/B2bSalesStatListTableSettings.tsx">
import { DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { B2bSalesStats_b2bSalesStats } from "@src/app/views/b2b/api/types/B2bSalesStats";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { Button } from "antd";
import React from "react";

import { calculateDueMonth } from "./utils";

interface TableSettingsProps {
  onShowSendModal: (record: B2bSalesStats_b2bSalesStats) => void;
  isClosingStatement: boolean;
  isStaff: boolean;
}

export const getB2bSalesStatListTableSettings = ({
  onShowSendModal,
  isClosingStatement,
  isStaff,
}: TableSettingsProps) => {
  const statDateColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: "정산월",
    key: "statDate",
    align: "center",
    width: 120,
    render: (_, record) => getDateByFormat(record.statDate, onlyMonthFormat) || "-",
  };
  const brandCodeColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.brand.CLIENT_COMPANY_CODE,
    key: "brandCode",
    width: 100,
    align: "center",
    render: (_, record) => record.brand?.code || "-",
  };
  const brandNameColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.brand.CLIENT_COMPANY_NAME,
    key: "brandName",
    width: 150,
    align: "left",
    render: (_, record) => record.brand?.name || "-",
  };
  const statTotalExcludeVatColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.tax.SUPPLY_AMOUNT,
    key: "statTaxableTotal",
    width: 120,
    align: "right",
    render: (_, record) => {
      const taxableTotal = record?.statTaxableTotal || 0;
      const taxfreeTotal = record?.statTaxfreeTotal || 0;
      const totalExcludeVat = toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;
      return getNumberFormat(totalExcludeVat);
    },
    renderExcel: (record) => {
      const taxableTotal = record?.statTaxableTotal || 0;
      const taxfreeTotal = record?.statTaxfreeTotal || 0;
      return toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;
    },
  };
  const statTotalVatColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.tax.VAT_AMOUNT,
    key: "statVatTotal",
    width: 120,
    align: "right",
    render: (_, record) => {
      const statTotal = record.statTaxableTotal + record.statTaxfreeTotal;
      const taxableTotal = record?.statTaxableTotal || 0;
      const taxfreeTotal = record?.statTaxfreeTotal || 0;
      const totalExcludeVat = toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;
      return getNumberFormat(statTotal - totalExcludeVat);
    },
    renderExcel: (record) => {
      const statTotal = record.statTaxableTotal + record.statTaxfreeTotal;
      const taxableTotal = record?.statTaxableTotal || 0;
      const taxfreeTotal = record?.statTaxfreeTotal || 0;
      const totalExcludeVat = toPriceExcludeVat(taxableTotal, false) + taxfreeTotal;
      return statTotal - totalExcludeVat;
    },
  };
  const statTotalColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.tax.TOTAL_AMOUNT,
    key: "statTotal",
    width: 150,
    align: "right",
    render: (_, record) => getNumberFormat(record.statTaxableTotal + record.statTaxfreeTotal),
    renderExcel: (record) => record.statTaxableTotal + record.statTaxfreeTotal,
  };

  const unpaidAmountColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.sales.UNPAID_AMOUNT,
    key: "unpaidAmount",
    width: 150,
    align: "right",
    render: (_, record) => getNumberFormat(record.unpaidAmount),
    renderExcel: (record) => record.unpaidAmount,
  };

  const paymentDueAmountColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.sales.PAYMENT_DUE_AMOUNT,
    key: "paymentDueAmount",
    width: 150,
    align: "right",
    render: (_, record) => getNumberFormat(record.statTaxableTotal + record.statTaxfreeTotal + record.unpaidAmount),
    renderExcel: (record) => record.statTaxableTotal + record.statTaxfreeTotal + record.unpaidAmount,
  };

  const paymentDueDateColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: columnNameConstant.sales.PAYMENT_DUE_MONTH,
    key: "paymentDueDate",
    width: 120,
    align: "center",
    render: (_, record) => calculateDueMonth(record.statDate, record?.brand?.b2bPayMethod, onlyMonthFormat),
  };

  const onSendColumn: DownloadableColumnType<B2bSalesStats_b2bSalesStats> = {
    title: isClosingStatement ? "발송" : "세부 내역 확인",
    key: "send",
    width: 120,
    align: "center",
    render: (_, record) => (
      <Button onClick={() => onShowSendModal(record)} type="primary" className="btn btn-primary btn-sm">
        {isClosingStatement ? "마감명세서 발송" : "세부 내역 확인"}
      </Button>
    ),
  };

  return [
    statDateColumn,
    isStaff && brandCodeColumn,
    isStaff && brandNameColumn,
    statTotalExcludeVatColumn,
    statTotalVatColumn,
    statTotalColumn,
    unpaidAmountColumn,
    paymentDueAmountColumn,
    paymentDueDateColumn,
    onSendColumn,
  ].filter(Boolean);
};
