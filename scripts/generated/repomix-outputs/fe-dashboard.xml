export const makeNameByOrderType = (
  orderType: OrderType,
  sectionName: string,
  isHqStaff: boolean,
  includeOrderString: boolean = true
) => {
  if (isHqStaff) {
    return sectionName;
  }

  let sectionNamePrefix: string = "";
  switch (orderType) {
    case OrderType.BY_USER:
      sectionNamePrefix = orderTypeTerm.byUser;
      break;
    case OrderType.BY_STAFF_FOR_BRAND:
      sectionNamePrefix = orderTypeTerm.byStaffForBrand;
      break;
    case OrderType.BY_STAFF_FOR_BAD_STOCK:
      sectionNamePrefix = orderTypeTerm.byStaffForBadStock;
      break;
    case OrderType.BY_STAFF_FOR_ETC:
      sectionNamePrefix = orderTypeTerm.byStaffForEtc;
      break;
    default:
      break;
  }

  return includeOrderString ? `${sectionNamePrefix} 주문 ${sectionName}` : `${sectionNamePrefix} ${sectionName}`;
};

