import { CollectionSortField } from "@src/api/types/globalTypes";
import { CollectionListViewUrlSortField } from "@src/app/views/product/collections/urls";
import { createGetSortQueryVariables } from "@utils/sort";

export function getSortQueryField(sort: CollectionListViewUrlSortField): CollectionSortField {
  switch (sort) {
    case CollectionListViewUrlSortField.name:
      return CollectionSortField.NAME;
    case CollectionListViewUrlSortField.available:
      return CollectionSortField.AVAILABILITY;
    case CollectionListViewUrlSortField.productCount:
      return CollectionSortField.PRODUCT_COUNT;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);
