  virtualAccountList: VirtualAccountStatuses_virtualAccountStatuses_edges_node[];
}

const VirtualAccountList: React.FC<VirtualAccountListProps> = (props) => {
  const { virtualAccountList, onRowClick, ...listProps } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const processVirtualAccountList = virtualAccountList.map((item, idx) => {
    const newItem = { key: idx, ...item };
    return newItem;
  });

  const columns: ColumnsType<VirtualAccountStatuses_virtualAccountStatuses_edges_node> = [
    {
      title: "기관코드",
      key: "orgCd",
      align: "center",
      width: 120,
      render: (_, record) => (
        <Typography.Link onClick={() => onRowClick(record.id)}>{record.orgCd || "-"}</Typography.Link>
