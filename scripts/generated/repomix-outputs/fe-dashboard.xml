import { RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

import { ReqBossProductUrlEnum } from "../../urls";

export enum ReqBossProductListFilterKeys {
  brandId = "brandId",
  brandSearch = "brandSearch",
  productSearch = "productSearch",
  requestNumber = "requestNumber",
  status = "status",
  requestedStatusAt = "requestedStatusAt",
  acceptedStatusAt = "acceptedStatusAt",
  reqAdditionalStatusAt = "reqAdditionalStatusAt",
  vendorPriceStatusAt = "vendorPriceStatusAt",
  brandPriceStatusAt = "brandPriceStatusAt",
  reqEstimateFixStatusAt = "reqEstimateFixStatusAt",
  pendingConfirmStatusAt = "pendingConfirmStatusAt",
  confirmedStatusAt = "confirmedStatusAt",
  completedStatusAt = "completedStatusAt",
  spec = "spec",
  material = "material",
  color = "color",
  isExclusive = "isExclusive",
}

export interface ReqBossProductListListFilterOpts {
  brandSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  requestNumber: FilterOpts<string>;
  status: FilterOpts<RequestBossProductStatusEnum[]>;
  requestedStatusAt: FilterOpts<MinMax>;
  acceptedStatusAt: FilterOpts<MinMax>;
  reqAdditionalStatusAt: FilterOpts<MinMax>;
  vendorPriceStatusAt: FilterOpts<MinMax>;
  brandPriceStatusAt: FilterOpts<MinMax>;
  reqEstimateFixStatusAt: FilterOpts<MinMax>;
  pendingConfirmStatusAt: FilterOpts<MinMax>;
  confirmedStatusAt: FilterOpts<MinMax>;
  completedStatusAt: FilterOpts<MinMax>;
  spec: FilterOpts<string>;
  material: FilterOpts<string>;
  color: FilterOpts<string>;
  isExclusive: FilterOpts<boolean>;
}

const requestedStatusFilter = {
  label: "접수 대기",
  value: RequestBossProductStatusEnum.REQUESTED,
};
const acceptedStatusFilter = {
  label: "요청 접수",
  value: RequestBossProductStatusEnum.ACCEPTED,
};
const reqAdditionalStatusFilter = {
  label: "보완 요청",
  value: RequestBossProductStatusEnum.REQ_ADDITIONAL,
};
const vendorPriceStatusFilter = {
  label: "협력사 매입가 검토",
  value: RequestBossProductStatusEnum.VENDOR_PRICE,
};
const brandPriceStatusFilter = {
  label: "브랜드 판매가 검토",
  value: RequestBossProductStatusEnum.BRAND_PRICE,
};
const reqEstimateFixStatusFilter = {
  label: "견적 수정 요청",
  value: RequestBossProductStatusEnum.REQ_ESTIMATE_FIX,
};
const pendingConfirmStatusFilter = {
  label: "확정 대기",
  value: RequestBossProductStatusEnum.PENDING_CONFIRM,
};
const confirmedStatusFilter = {
  label: "확정",
  value: RequestBossProductStatusEnum.CONFIRMED,
};
const completedStatusFilter = {
  label: "등록 완료",
  value: RequestBossProductStatusEnum.COMPLETED,
};
const canceledStatusFilter = {
  label: "중단",
  value: RequestBossProductStatusEnum.CANCELED,
};

export const getListByUrlType = (urlType: ReqBossProductUrlEnum) => {
  switch (urlType) {
    case ReqBossProductUrlEnum.REQUESTED:
      return [requestedStatusFilter, acceptedStatusFilter, reqAdditionalStatusFilter];
    case ReqBossProductUrlEnum.ESTIMATE:
      return [vendorPriceStatusFilter, brandPriceStatusFilter, reqEstimateFixStatusFilter];
    case ReqBossProductUrlEnum.CONFIRMED:
      return [pendingConfirmStatusFilter, confirmedStatusFilter];
    case ReqBossProductUrlEnum.COMPLETED:
      return [completedStatusFilter];
    case ReqBossProductUrlEnum.ALL:
      return [
        requestedStatusFilter,
        acceptedStatusFilter,
        reqAdditionalStatusFilter,
        vendorPriceStatusFilter,
        brandPriceStatusFilter,
        reqEstimateFixStatusFilter,
        pendingConfirmStatusFilter,
        confirmedStatusFilter,
        completedStatusFilter,
        canceledStatusFilter,
      ];
    default:
      return [];
  }
};

export function createFilterStructure(
  opts: ReqBossProductListListFilterOpts,
  urlType: ReqBossProductUrlEnum
): IFilter<ReqBossProductListFilterKeys> {
  const {
    requestProduct: {
      REQUEST_NO,
      PROGRESS_STATUS,
      REQUEST_CREATED_DATE,
      ACCEPTED_DATE,
      ADDITIONAL_REQUEST_DATE,
      QUOTATION_REQUEST_DATE,
      VENDOR_COST_PRICE_REGISTERED_DATE,
      QUOTATION_FIX_REQUEST_DATE,
      QUOTATION_REGISTERED_DATE,
      QUOTATION_CONFIRMED_DATE,
      REGISTERED_DONE_DATE,
    },
  } = columnNameConstant;

  const brandSearchFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };

  const productSearchFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.productSearch, "상품명", opts.productSearch.value),
    active: opts.productSearch.active,
  };

  const isExclusiveFilter = {
    ...createBooleanField(0, ReqBossProductListFilterKeys.isExclusive, "전용여부", opts.isExclusive.value, {
      negative: "범용",
      positive: "전용",
    }),
    active: opts.isExclusive.active,
  };
  const requestNumberFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.requestNumber, REQUEST_NO, opts.requestNumber.value),
    active: opts.requestNumber.active,
  };

  const statusFilter = {
    ...createOptionsField(
      0,
      ReqBossProductListFilterKeys.status,
      PROGRESS_STATUS,
      opts.status.value,
      true,
      getListByUrlType(urlType)
    ),
    active: opts.status.active,
  };

  const requestStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.requestedStatusAt,
      REQUEST_CREATED_DATE,
      opts.requestedStatusAt.value
    ),
    active: opts.requestedStatusAt.active,
  };
  const acceptedStatusAtFilter = {
    ...createDateField(0, ReqBossProductListFilterKeys.acceptedStatusAt, ACCEPTED_DATE, opts.acceptedStatusAt.value),
    active: opts.acceptedStatusAt.active,
  };
  const reqAdditionalStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.reqAdditionalStatusAt,
      ADDITIONAL_REQUEST_DATE,
      opts.reqAdditionalStatusAt.value
    ),
    active: opts.reqAdditionalStatusAt.active,
  };
  const vendorPriceStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.vendorPriceStatusAt,
      QUOTATION_REQUEST_DATE,
      opts.vendorPriceStatusAt.value
    ),
    active: opts.vendorPriceStatusAt.active,
  };
  const brandPriceStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.brandPriceStatusAt,
      VENDOR_COST_PRICE_REGISTERED_DATE,
      opts.brandPriceStatusAt.value
    ),
    active: opts.brandPriceStatusAt.active,
  };
  const reqEstimateFixStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.reqEstimateFixStatusAt,
      QUOTATION_FIX_REQUEST_DATE,
      opts.reqEstimateFixStatusAt.value
    ),
    active: opts.reqEstimateFixStatusAt.active,
  };

  const pendingConfirmStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.pendingConfirmStatusAt,
      QUOTATION_REGISTERED_DATE,
      opts.pendingConfirmStatusAt.value
    ),
    active: opts.pendingConfirmStatusAt.active,
  };
  const confirmedStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.confirmedStatusAt,
      QUOTATION_CONFIRMED_DATE,
      opts.confirmedStatusAt.value
    ),
    active: opts.confirmedStatusAt.active,
  };

  const completedStatusAtFilter = {
    ...createDateField(
      0,
      ReqBossProductListFilterKeys.completedStatusAt,
      REGISTERED_DONE_DATE,
      opts.completedStatusAt.value
    ),
    active: opts.completedStatusAt.active,
  };

  const specFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.spec, "규격", opts.spec.value),
    active: opts.spec.active,
  };
  const materialFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.material, "재질", opts.material.value),
    active: opts.material.active,
  };
  const colorFilter = {
    ...createTextField(0, ReqBossProductListFilterKeys.color, "색상", opts.color.value),
    active: opts.color.active,
  };

  // 상품 요청
  if (urlType === ReqBossProductUrlEnum.REQUESTED) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestStatusAtFilter,
      acceptedStatusAtFilter,
      reqAdditionalStatusAtFilter,
      brandSearchFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.ESTIMATE) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestStatusAtFilter,
      vendorPriceStatusAtFilter,
      brandPriceStatusAtFilter,
      reqEstimateFixStatusAtFilter,
      brandSearchFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.CONFIRMED) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestStatusAtFilter,
      pendingConfirmStatusAtFilter,
      confirmedStatusAtFilter,
      brandSearchFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.COMPLETED) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestStatusAtFilter,
      completedStatusAtFilter,
      brandSearchFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.ALL) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      brandSearchFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
      requestStatusAtFilter,
    ]);
  }
}
</file>

