import { ProductOrder, ProductOrderField } from "@src/api/types/globalTypes";
import { ProductListViewUrlQueryParams, ProductListViewUrlSortField } from "@src/app/views/product/products/urls";
import { getOrderDirection } from "@utils/sort";

export function getSortQueryField(sort: ProductListViewUrlSortField): ProductOrderField {
  switch (sort) {
    case ProductListViewUrlSortField.name:
      return ProductOrderField.NAME;
    case ProductListViewUrlSortField.sku:
      return ProductOrderField.SKU;
    case ProductListViewUrlSortField.price:
      return ProductOrderField.PRICE;
    case ProductListViewUrlSortField.isTaxFree:
      return ProductOrderField.TAX_FREE;
    case ProductListViewUrlSortField.costPrice:
      return ProductOrderField.COST_PRICE;
    case ProductListViewUrlSortField.deliveryFee:
      return ProductOrderField.DELIVERY_FEE;
    case ProductListViewUrlSortField.productType:
      return ProductOrderField.TYPE;
    default:
      return undefined;
  }
}

export function getSortQueryVariables(params: ProductListViewUrlQueryParams): ProductOrder {
  if (params.sort === ProductListViewUrlSortField.attribute) {
    return {
      attributeId: params.attributeId,
      direction: getOrderDirection(params.asc),
    };
  }
  return {
    direction: getOrderDirection(params.asc),
    field: getSortQueryField(params.sort),
  };
}
