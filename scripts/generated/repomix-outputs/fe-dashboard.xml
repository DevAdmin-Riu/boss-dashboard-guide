            name
          }

          fbvDeliveryConditions(vendorId: $vendorId) {
            id
            created
            vendor {
              id
            }
            disallowDeliveryDate
            possibleDeliveryDays
            minimumOrderPrice
            isBaseUser
          }
        }
      }
    }
  }
`;

export const useFbvCustomerList = makeQuery<FbvCustomerList, FbvCustomerListVariables>(fbvCustomerListQuery);
export const useFbvCustomerListLazy = makeLazyQuery<FbvCustomerList, FbvCustomerListVariables>(fbvCustomerListQuery);
