import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { SalesStatusEnum } from "@src/api/types/globalTypes";
import { convertFormLinesObjToArr } from "@src/app/components/antd/Form/utils";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { flattenColumns, makeOneRowForExcel } from "@src/app/components/Filter/SpreadFilter";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { useOrderLineListForPurchaseOrderLazyQuery } from "@src/app/views/order/orders/api/queries";
import NoteForUnitPriceInfoModal from "@src/app/views/order/orders/components/NoteForUnitPriceInfoModal/NoteForUnitPriceInfoModal";
import {
  useProductVariantListForSearchQuery,
  useProductVariantListToAddLazyQuery,
} from "@src/app/views/product/products/api/queries";
import {
  ProductVariantListForSearch_productVariants_edges_node,
  ProductVariantListForSearchVariables,
} from "@src/app/views/product/products/api/types/ProductVariantListForSearch";
import { catchForExcelDownloadError, excelDownload, makeHeaderRowsAndMerges } from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import {
  destroyDownloadingMessage,
  showNotificationError,
  showNotificationInfo,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, DatePicker, Form, FormInstance, Input, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React, { useEffect, useState } from "react";

import { consignmentPurchaseOrderLineKeys, trackInventoryPurchaseOrderLineKeys } from "../../utils";
import { PurchaseOrderModalModeEnum } from "../../view/PurchaseOrderDetailsView";
import {
  IPurchaseOrderCreateLine,
  PurchaseOrderCreatePageFormData,
  TPurchaseOrderCreateLinesObj,
} from "../PurchaseOrderCreatePage/PurchaseOrderCreatePage";
import PurchaseOrderLineAddModal from "../PurchaseOrderLineAddModal/PurchaseOrderLineAddModal";
import {
  getPurchaseOrderCreateLinesTableSettings,
  makeConsignmentPoLinesObj,
  makeStockPoLinesObj,
} from "./PurchaseOrderCreateLinesTableSettings";

interface PurchaseOrderCreateLinesProps {
  form: FormInstance<PurchaseOrderCreatePageFormData>;
  disabled: boolean;
  trackInventory: boolean;
  modalMode: PurchaseOrderModalModeEnum;
  openModalWithoutNavigate: (modalMode: PurchaseOrderModalModeEnum, idForModal: string) => void;
  resetForCloseModal: () => void;
  isB2b: boolean;
  isStaff?: boolean;
}

export const PurchaseOrderCreateLines: React.FC<PurchaseOrderCreateLinesProps> = ({
  form,
  disabled,
  trackInventory,
  modalMode,
  openModalWithoutNavigate,
  resetForCloseModal,
  isB2b,
  isStaff = false,
}) => {
  const { courierDeliveryAdditionalFeeList } = useShop();
  const [tableLoading, setTableLoading] = useState<boolean>(false);
  const [showAddConfirmModal, setShowAddConfirmModal] = useState<boolean>(false);
  const [confirmModalTitleText, setConfirmModalTitleText] = useState<string>("");
  const [dataSourceToAdd, setDataSourceToAdd] = useState<ProductVariantListForSearch_productVariants_edges_node[]>([]);
  const [addedLineKeyList, setAddedLineKeyList] = useState<string[]>([]);
  const [showNoteForUnitPrice, setShowNoteForUnitPrice] = useState<string | null>(null);

  // sku에 맞는 수량 일괄 수정을 위한 state들
  const [skuStr, setSkuStr] = useState<string>("");
  const [quantityStr, setQuantityStr] = useState<string>("");

  const [fetchProductVariants] = useProductVariantListToAddLazyQuery();
  const [fetchOrderLines] = useOrderLineListForPurchaseOrderLazyQuery();

  const purchaseOrderDateWatched = Form.useWatch("purchaseOrderDate", form);
  const isForPackageOrderWatched = Form.useWatch("isForPackageOrder", form);
  const linesObjWatched = Form.useWatch("linesObj", form);

  // addedLineKeyList 순서대로 정렬하여 dataSource에 넣어주기
  const dataSource = convertFormLinesObjToArr(linesObjWatched, "lineKey").sort((a, b) => {
    const aIdx = addedLineKeyList.indexOf(a.lineKey);
    const bIdx = addedLineKeyList.indexOf(b.lineKey);
    return aIdx - bIdx;
  });

  const watchedValues = {
    purchaseOrderDate: purchaseOrderDateWatched,
  };

  const queryVariablesForSearch: ProductVariantListForSearchVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: {
      salesStatus: [SalesStatusEnum.ON_SALE, SalesStatusEnum.PENDING],
      isInner: false,
      isFulfilledByVendor: false,
    },
  };
  const {
    data: productVariantListForSearchData,
    loading: productVariantListForSearchLoading,
    refetch: refetchProductVariantsForSearch,
  } = useProductVariantListForSearchQuery({
    skip: trackInventory === false || modalMode !== PurchaseOrderModalModeEnum.AddProduct,
    variables: queryVariablesForSearch,
  });

  const getQueryVariablesForAdd = (ids: string[]) => {
    const defaultVariables = { first: GrapheneRelayConnectionMaxLimitEnum.default, includeStock: trackInventory };
    const filterVariables = { ids };
    if (trackInventory === false) {
      return { ...defaultVariables, filter: filterVariables };
    }
    return {
      ...defaultVariables,
      filter: {
        ...filterVariables,
        salesStatus: [SalesStatusEnum.ON_SALE, SalesStatusEnum.PENDING],
      },
    };
  };

  const onPoLineRemove = (lineKey: string) => {
    const linesObj = { ...linesObjWatched };
    delete linesObj[lineKey];
    const newLineKeyList = addedLineKeyList.filter((key) => key !== lineKey);

    // form.setFieldsValue는 기존 값에 spread 연산으로 새로운 값을 넣어주는 방식이라, 제거가 반영되지 않음
    // ex) const arr = { a: 1, b: 2 } 에서 delete arr[b] 후, form.setFieldsValue({ arr }) 하면 { a: 1, b: 2 }가 그대로 남아있음
    form.setFieldValue("linesObj", linesObj);
    setAddedLineKeyList(newLineKeyList);
  };

  const onPoLineBulkAdd = (variantOrOrderLineIds: string[]) => {
    if (utils.isEmpty(variantOrOrderLineIds)) {
      return;
    }

    setTableLoading(true);
    const purchaseOrderData = form.getFieldsValue();
    const queryVariables = getQueryVariablesForAdd(variantOrOrderLineIds);
    if (trackInventory) {
      fetchProductVariants({ variables: queryVariables })
        .then((res) => {
          const addedlinesObj = makeStockPoLinesObj(res.data, purchaseOrderData);
          const linesObj = { ...linesObjWatched, ...addedlinesObj };
          const newLineKeyList = Object.keys(linesObj).sort();

          form.setFieldValue("linesObj", linesObj);
          setAddedLineKeyList((prev) => [...prev, ...newLineKeyList]);
        })
        .finally(() => setTableLoading(false));
    } else {
      fetchOrderLines({ variables: queryVariables })
        .then((res) => {
          const addedlinesObj = makeConsignmentPoLinesObj(
            res.data,
            purchaseOrderData,
            courierDeliveryAdditionalFeeList,
            isB2b
          );
          const linesObj = { ...linesObjWatched, ...addedlinesObj };
          const newLineKeyList = Object.keys(linesObj).sort();
          form.setFieldValue("linesObj", linesObj);
          setAddedLineKeyList((prev) => [...prev, ...newLineKeyList]);
        })
        .finally(() => setTableLoading(false));
    }
  };

  const onStockPoLineAddWithConfirm = (productVariants: ProductVariantListForSearch_productVariants_edges_node[]) => {
    const beStoppedList = [];
    const willBeStoppedList = [];
    productVariants.forEach((variant) => {
      const productVariantNameWithSku = `${variant?.product?.name || "-"}(${variant?.sku || "-"})`;
      if (variant.salesStatus === SalesStatusEnum.STOPPED) {
        beStoppedList.push(productVariantNameWithSku);
      }
      if (variant.salesStatus === SalesStatusEnum.WILL_BE_STOPPED) {
        willBeStoppedList.push(productVariantNameWithSku);
      }
    });

    if (beStoppedList.length > 0) {
      const beStoppedVariantsText = beStoppedList.join(", ");
      const errMsg = `[ ${beStoppedVariantsText} ]: 해당 제품은 단종된 제품입니다. 단종된 제품은 발주 제품으로 추가할 수 없습니다.`;
      showNotificationError(errMsg);
      return;
    }

    if (willBeStoppedList.length > 0) {
      const willBeStoppedVariantsText = willBeStoppedList.join(", ");
      const titleText = `[ ${willBeStoppedVariantsText} ]: 해당 제품은 단종 예정 제품입니다. 발주 제품 추가를 진행하시겠습니까?`;
      setConfirmModalTitleText(titleText);
      setShowAddConfirmModal(true);
      setDataSourceToAdd(productVariants);
    } else {
      const variantIds = productVariants.map((variant) => variant.id);
      onPoLineBulkAdd(variantIds);
      resetForCloseModal();
    }
  };

  useEffect(() => {
    const targetKeys = trackInventory ? trackInventoryPurchaseOrderLineKeys : consignmentPurchaseOrderLineKeys;
    const ids = JSON.parse(localStorage.getItem(targetKeys));
    onPoLineBulkAdd(ids);
    localStorage.removeItem(targetKeys);
  }, []);

  // isPackageProductsPurchaseOrder 발주구분에서 패키지 구성품으로 바뀌거나 반대로 바뀌는 경우. 매입가 다시 불러와서 저장해야함.
  useEffect(() => {
    if (!utils.isEmpty(addedLineKeyList) && trackInventory) {
      onPoLineBulkAdd(addedLineKeyList);
    }
  }, [isForPackageOrderWatched]);

  const onShowNoteForUnitPrice = (noteForUnitPrice: string) => setShowNoteForUnitPrice(noteForUnitPrice);
  const columns = getPurchaseOrderCreateLinesTableSettings({
    watchedValues,
    form,
    disabled,
    trackInventory,
    onLineDelete: onPoLineRemove,
    openModalWithoutNavigate,
    isB2b,
    onShowNoteForUnitPrice,
    isStaff,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const onExcelDownload = () => {
    try {
      const flattenedColumns = flattenColumns(columns);

      const rows = [];
      dataSource.forEach((line, index) => {
        const row = makeOneRowForExcel(line, flattenedColumns, index);
        rows.push(row);
      });

      if (!rows || rows.length === 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
      excelDownload({ title: "발주 제품 리스트", columns: rows, header, merges, skipOriginHeader: true });
      destroyDownloadingMessage();
    } catch (e) {
      catchForExcelDownloadError(e);
    }
  };

  const onDefaultAskingPurchaseDateChange = (defaultAskingPurchaseDate: Moment | null) => {
    const apdUpdatedLinesObj = Object.keys(linesObjWatched).reduce<TPurchaseOrderCreateLinesObj>((acc, key) => {
      const line = linesObjWatched[key];
      const updatedLine: IPurchaseOrderCreateLine = { ...line, askingPurchaseDate: defaultAskingPurchaseDate };
      acc[key] = updatedLine;
      return acc;
    }, {});
    form.setFieldValue("linesObj", apdUpdatedLinesObj);
  };

  const disabledDefaultDeliveryDate = isB2b
    ? undefined
    : (current: Moment) => current && current < moment(purchaseOrderDateWatched).startOf("day");
  const cardTitle = (
    <Space>
      <Typography.Title level={4}>발주제품</Typography.Title>
      <Form.Item name="defaultAskingPurchaseDate" noStyle>
        <DatePicker
          style={{ width: 200 }}
          allowClear={false}
          disabledDate={disabledDefaultDeliveryDate}
          placeholder={"납품 요청일 기본값"}
          onChange={onDefaultAskingPurchaseDateChange}
        />
      </Form.Item>
    </Space>
  );

  const changeQuantityAll = () => {
    const skuList = skuStr.split("\n");
    const quantityList = quantityStr.split("\n");

    if (skuList.length !== quantityList.length) {
      showNotificationWarn("제품코드와 수량의 개수가 일치하지 않습니다.");
      return;
    }

    let changesMessage = "변경된 제품 목록:\n";
    let hasChanges = false;

    const updatedLinesObj = Object.keys(linesObjWatched).reduce<TPurchaseOrderCreateLinesObj>((acc, key) => {
      const line = linesObjWatched[key];
      const sku = line.variant?.sku || "";
      const idx = skuList.indexOf(sku);

      if (idx !== -1) {
        const newQuantity = Number(quantityList[idx]);
        const oldQuantity = line.quantity;

        if (oldQuantity !== newQuantity) {
          changesMessage += `- ${sku}, 기존 : ${oldQuantity} → ${newQuantity}\n`;
          hasChanges = true;
        }

        acc[key] = { ...line, quantity: newQuantity };
      } else {
        acc[key] = line;
      }

      return acc;
    }, {});

    form.setFieldValue("linesObj", updatedLinesObj);

    // ✅ 변경된 내용이 있으면 메시지 출력
    if (hasChanges) {
      showNotificationInfo(changesMessage.trim(), undefined, undefined, { whiteSpace: "pre-line" }); // 줄바꿈 정리 후 출력
    } else {
      showNotificationInfo("변경된 제품이 없습니다.");
    }
  };

  // 발주제품 추가, 삭제는 재고 상품 발주인 경우에만 가능
  const cardExtra = (
    <Space align="end">
      {trackInventory && (
        <>
          <FormFieldAntd label="제품코드">
            <Input.TextArea
              style={{ width: 120 }}
              autoSize={{ maxRows: 2 }}
              value={skuStr}
              onChange={(e) => setSkuStr(e.target.value)}
            />
          </FormFieldAntd>
          <FormFieldAntd label="수량">
            <Input.TextArea
              style={{ width: 80 }}
              autoSize={{ maxRows: 2 }}
              value={quantityStr}
              onChange={(e) => setQuantityStr(e.target.value)}
            />
          </FormFieldAntd>
          <Button type={"primary"} shape="round" onClick={changeQuantityAll}>
            일괄 변경
          </Button>
        </>
      )}
      <Button type={"primary"} disabled={disabled} shape="round" onClick={onExcelDownload}>
        엑셀 다운로드
      </Button>
      {trackInventory && (
        <Button
          type={"primary"}
          disabled={disabled}
          shape="round"
          onClick={() => openModalWithoutNavigate(PurchaseOrderModalModeEnum.AddProduct, null)}
        >
          추가
        </Button>
      )}
    </Space>
  );

  return (
    <>
      <Card title={cardTitle} extra={cardExtra} bodyStyle={{ padding: 0 }}>
        <TableVatLegend isIncludeVat={false} size="small" />
        <Form.Item name="linesObj" hidden>
          <Input />
        </Form.Item>
        <PatchedColumnsTable<IPurchaseOrderCreateLine>
          {...commonTableProps}
          loading={tableLoading}
          rowKey={(record) => record.lineKey}
          dataSource={dataSource}
          columns={columns}
          sticky={{ offsetHeader: 80, offsetScroll: 100 }}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
      <PurchaseOrderLineAddModal
        open={modalMode === PurchaseOrderModalModeEnum.AddProduct}
        loading={productVariantListForSearchLoading}
        initialQueryVariables={queryVariablesForSearch}
        refetchProductVariants={refetchProductVariantsForSearch}
        onClose={resetForCloseModal}
        onSubmit={onStockPoLineAddWithConfirm}
        productVariants={maybe(() =>
          productVariantListForSearchData?.productVariants?.edges
            .map((edge) => edge.node)
            .filter(
              (suggestedProductVariant) =>
                !addedLineKeyList.includes(suggestedProductVariant.id) &&
                !utils.isEmpty(suggestedProductVariant?.defaultVariantVendor)
            )
        )}
      />
      <ConfirmModal
        modalTitleText={"발주 제품 추가"}
        visible={showAddConfirmModal}
        titleText={confirmModalTitleText}
        okText={"추가"}
        onOk={() => {
          const variantIds = dataSourceToAdd.map((variant) => variant.id);
          onPoLineBulkAdd(variantIds);
          setShowAddConfirmModal(false);
          resetForCloseModal();
        }}
        okButtonProps={{ disabled }}
        onCancel={() => {
          setShowAddConfirmModal(false);
          openModalWithoutNavigate(PurchaseOrderModalModeEnum.AddProduct, null);
        }}
      />
      <NoteForUnitPriceInfoModal
        open={showNoteForUnitPrice !== null}
        onCancel={() => setShowNoteForUnitPrice(null)}
        showNoteForUnitPrice={showNoteForUnitPrice}
      />
    </>
  );
};
</file>

