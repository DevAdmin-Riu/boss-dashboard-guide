<file path="src/app/views/hqStaff/hqRequestProduct/components/BrandSelectionStep.tsx">
import { SearchOutlined, ShopOutlined } from "@ant-design/icons";
import useBrandSearch from "@src/api/searches/useBrandSearch";
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { getBrandContractTypeText } from "@src/app/views/brand/brands/utils";
import { maybe } from "@utils/misc";
import { Card, Col, Empty, Input, Row, Space, Spin, Tag, Typography } from "antd";
import React, { useEffect, useState } from "react";

const { Search } = Input;
const { Text } = Typography;

interface BrandSelectionStepProps {
  selectedBrand: any;
  onBrandSelect: (brand: any) => void;
}

// 계약 타입별 태그 색상 정의
const getContractTypeTagColor = (type: BrandContractTypeEnum): string => {
  switch (type) {
    case BrandContractTypeEnum.MILEAGE:
      return "green"; // 수익배분 - 녹색
    case BrandContractTypeEnum.FEE:
      return "blue"; // 공급수수료 - 파란색
    case BrandContractTypeEnum.REVERSE_FEE:
      return "orange"; // 본부 매출 인식 - 주황색
    case BrandContractTypeEnum.B2B:
      return "purple"; // B2B - 보라색
    default:
      return "default";
  }
};

export const BrandSelectionStep: React.FC<BrandSelectionStepProps> = ({ selectedBrand, onBrandSelect }) => {
  const [searchQuery, setSearchQuery] = useState("");

  const { search, result } = useBrandSearch({
    variables: {
      first: 20,
      query: searchQuery,
    },
  });

  useEffect(() => {
    search("");
  }, []);

  const brands = maybe(() => result.data.search.edges.map((edge) => edge.node), []);

  return (
    <Card title={<CardTitleAntd title="브랜드 선택" />}>
      <Space direction="vertical" size="large" style={{ width: "100%" }}>
        <div>
          <Text type="secondary">상품 요청을 생성할 브랜드를 선택해주세요</Text>
        </div>

        <Search
          placeholder="브랜드명 또는 브랜드 코드로 검색"
          allowClear
          enterButton={<SearchOutlined />}
          onSearch={(value) => {
            setSearchQuery(value);
            search(value);
          }}
          onChange={(e) => !e.target.value && search("")}
        />

        <div style={{ position: "relative", minHeight: 200 }}>
          {result.loading && brands.length > 0 && (
            <div
              style={{
                position: "absolute",
                top: 0,
                left: 0,
                right: 0,
                bottom: 0,
                backgroundColor: "rgba(255, 255, 255, 0.6)",
                display: "flex",
                justifyContent: "center",
                alignItems: "center",
                zIndex: 1,
              }}
            >
              <Spin size="large" />
            </div>
          )}

          {!result.loading && brands.length === 0 ? (
            <Empty description="검색 결과가 없습니다" image={Empty.PRESENTED_IMAGE_SIMPLE} />
          ) : result.loading && brands.length === 0 ? (
            <div style={{ textAlign: "center", padding: "40px 0" }}>
              <Spin size="large" />
            </div>
          ) : (
            <Row gutter={[16, 16]}>
              {brands.map((brand) => (
                <Col key={brand.id} xs={24} sm={12} md={8} lg={6}>
                  <Card
                    hoverable
                    onClick={() => onBrandSelect(brand)}
                    style={{
                      cursor: "pointer",
                      height: "100%",
                      border: selectedBrand?.id === brand.id ? "2px solid #1890ff" : "1px solid #d9d9d9",
                      backgroundColor: selectedBrand?.id === brand.id ? "#f0f5ff" : undefined,
                    }}
                    bodyStyle={{
                      textAlign: "center",
                      padding: "20px",
                    }}
                  >
                    <Space direction="vertical" size="small">
                      {brand.image?.url ? (
                        <img
                          src={brand.image.url}
                          alt={brand.image.alt || brand.name}
                          style={{
                            width: 32,
                            height: 32,
                            objectFit: "contain",
                            borderRadius: 4,
                            border: selectedBrand?.id === brand.id ? "2px solid #1890ff" : "1px solid #f0f0f0",
                          }}
                        />
                      ) : (
                        <ShopOutlined
                          style={{
                            fontSize: 32,
                            color: selectedBrand?.id === brand.id ? "#1890ff" : "#8c8c8c",
                          }}
                        />
                      )}
                      <Typography.Title level={5} style={{ margin: 0 }}>
                        {brand.name}
                      </Typography.Title>
                      <Text type="secondary">코드: {brand.code}</Text>
                      {brand.contractType && (
