import { buttonText } from "@src/global/assets/messages/buttonText";
import { Checkbox, Divider, Form, Input, Modal, Space, Typography } from "antd";
import { filter } from "fuzzaldrin";
import React, { useEffect } from "react";

interface FormData {
  countries: string[];
  query: string;
  restOfTheWorld: boolean;
}

export interface ShippingZoneCountriesAssignDialogProps {
  countries: ShopInfo_shop_shippingCountries[];
  initial: string[];
  isDefault: boolean;
  open: boolean;
  onClose: () => void;
  onConfirm: (data: FormData) => void;
}

const ShippingZoneCountriesAssignDialog: React.FC<ShippingZoneCountriesAssignDialogProps> = (props) => {
  const { isDefault, onClose, countries, open, initial, onConfirm } = props;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<FormData>(form);
  const queryWatcher = TypeSafeForm.getUseWatcherParams({ name: "query" });
  const queryWatched = Form.useWatch(queryWatcher.namePath, queryWatcher.formInstance);

  const initialValues: FormData = {
    countries: initial,
    query: "",
    restOfTheWorld: isDefault,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  return (
    <Modal
      forceRender
      destroyOnClose
      title="지역 연동"
      open={open}
      okText={buttonText.assign}
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Typography>아래 리스트에서 지역을 선택하세요</Typography>
      <Divider />
      <Form form={form} layout="vertical" initialValues={initialValues} onFinish={onConfirm}>
        <Form.Item label="빠른 선택" name="restOfTheWorld" valuePropName="checked">
          <Checkbox>
            <Space direction="vertical" size={0}>
              <Typography>전국</Typography>
              <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
