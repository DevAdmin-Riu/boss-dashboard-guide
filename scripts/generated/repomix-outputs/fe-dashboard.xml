import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { simpleAddressFragment } from "@src/api/fragments/address";
import { brandStoreStoreUsersFragment } from "@src/api/fragments/brandStore";
import {
  customerAddressesFragment,
  customerFragment,
  userAddressesFragment,
  userHqStaffBrandStoresFragment,
} from "@src/api/fragments/customers";
import { orderFragmentForUserDetails } from "@src/api/fragments/orders";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import { creditsEventFragmentForUserDetails, rcoinsEventFragmentForUserDetails } from "@src/api/fragments/points";
import {
  BrandAccountDetails,
  BrandAccountDetailsVariables,
} from "@src/app/views/customer/customers/api/types/BrandAccountDetails";
import gql from "graphql-tag";

import { CustomerAddresses, CustomerAddressesVariables } from "./types/CustomerAddresses";
import {
  CustomersDefaultShippingAddress,
  CustomersDefaultShippingAddressVariables,
} from "./types/CustomersDefaultShippingAddress";
import { ListCustomers, ListCustomersVariables } from "./types/ListCustomers";
import { UserAddresses, UserAddressesVariables } from "./types/UserAddresses";

export const customerListQuery = gql`
  ${customerFragment}
  ${pageInfoFragment}
  query ListCustomers(
    $after: String
    $before: String
    $first: Int
    $last: Int
    $filter: CustomerFilterInput
    $sort: UserSortingInput
  ) {
    customers(after: $after, before: $before, first: $first, last: $last, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...CustomerFragment
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const useCustomerListQuery = makeQuery<ListCustomers, ListCustomersVariables>(customerListQuery);
export const useCustomerListFilterDownloadQuery = makeLazyQuery<ListCustomers, ListCustomersVariables>(
  customerListQuery,
  "no-cache"
);

export const customerAddressesQuery = gql`
  ${customerAddressesFragment}
  query CustomerAddresses($id: ID!) {
    user(id: $id) {
      ...CustomerAddressesFragment
    }
  }
`;
export const useCustomerAddressesQuery = makeQuery<CustomerAddresses, CustomerAddressesVariables>(
  customerAddressesQuery
);

// 가맹본부 대행 주문 생성 시 기본 배송지 조회용
export const customersDefaultShippingAddressQuery = gql`
  ${simpleAddressFragment}
  query CustomersDefaultShippingAddress($filter: CustomerFilterInput) {
    customers(first: 100, filter: $filter) {
      edges {
        node {
          id
          loginId
          defaultShippingAddress {
            ...SimpleAddressFragment
          }
        }
      }
    }
  }
`;
export const useCustomersDefaultShippingAddressLazyQuery = makeLazyQuery<
  CustomersDefaultShippingAddress,
  CustomersDefaultShippingAddressVariables
>(customersDefaultShippingAddressQuery);

export const brandAccountDetailsQuery = gql`
  ${orderFragmentForUserDetails}
  ${creditsEventFragmentForUserDetails}
  ${rcoinsEventFragmentForUserDetails}
  ${brandStoreStoreUsersFragment}
  ${userHqStaffBrandStoresFragment}
  ${simpleAddressFragment}
  query BrandAccountDetails($id: ID!) {
    user(id: $id) {
      id
      isHqStaff
      loginId
      hqStaffRole
      aligoPhone
      email
      firstName
      dateJoined
      lastLogin
      cashableCredits
      nonCashableCredits
      rcoins
      brand {
        id
        name
      }
      orders(first: 5) {
        edges {
          node {
            ...OrderFragmentForUserDetails
          }
        }
      }
      creditsEvents(first: 5) {
        edges {
          node {
            ...CreditsEventFragmentForUserDetails
          }
        }
      }
      rcoinsEvents(first: 5) {
        edges {
          node {
            ...RcoinsEventFragmentForUserDetails
          }
        }
      }
      defaultShippingAddress {
        ...SimpleAddressFragment
      }
      brandStoreUser {
        id
        role
        brandStore {
          id
          code
          name
          ...BrandStoreStoreUsersFragment
        }
      }
      ...UserHqStaffBrandStoresFragment
    }
  }
`;
export const useBrandAccountDetailsQuery = makeQuery<BrandAccountDetails, BrandAccountDetailsVariables>(
  brandAccountDetailsQuery
);

export const userAddressesQuery = gql`
  ${userAddressesFragment}
  query UserAddresses($id: ID!) {
    user(id: $id) {
      ...UserAddressesFragment
    }
  }
`;
export const useUserAddressesLazyQuery = makeLazyQuery<UserAddresses, UserAddressesVariables>(userAddressesQuery);
</file>

