<file path="src/app/views/auth/utils.ts">
import { ApolloError } from "@apollo/client";
import { setContext } from "@apollo/client/link/context";
import { ErrorResponse, onError } from "@apollo/client/link/error";
import { User } from "@src/api/fragments/types/User";
import { PermissionEnum } from "@src/api/types/globalTypes";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { findValueInEnum } from "@utils/misc";
import { showGqlErrorInfo } from "@utils/notification/wrapperGql";
import { GraphQLError } from "graphql";

export enum JWTError {
  invalid = "InvalidTokenError",
  invalidSignature = "InvalidSignatureError",
  expired = "ExpiredSignatureError",
}

export function isJwtError(error: GraphQLError): boolean {
  let jwtError: boolean;
  try {
    jwtError = !!findValueInEnum(error.extensions.exception.code, JWTError);
  } catch (e) {
    jwtError = false;
  }

  return jwtError;
}

export function isTokenExpired(error: GraphQLError): boolean {
  return error.extensions.exception.code === JWTError.expired;
}

interface ResponseError extends ErrorResponse {
  networkError?: Error & {
    statusCode?: number;
    bodyText?: string;
  };
}

export const invalidateTokenLink = onError((error: ResponseError) => {
  if ((error.networkError && error.networkError.statusCode === 401) || error.graphQLErrors?.some(isJwtError)) {
    if (error.graphQLErrors[0].extensions.code !== JWTError.expired) {
      removeTokens();
    }
  }
});

export const tokenLink = setContext((_, context) => {
  const authToken = getTokens().auth;

  return {
    ...context,
    headers: {
      ...context.headers,
      Authorization: authToken ? `JWT ${authToken}` : null,
    },
  };
});

export const authLink = invalidateTokenLink.concat(tokenLink);

export enum TOKEN_STORAGE_KEY {
  AUTH = "auth",
  CSRF = "csrf",
}

export const getTokens = () => ({
  auth: localStorage.getItem(TOKEN_STORAGE_KEY.AUTH) || sessionStorage.getItem(TOKEN_STORAGE_KEY.AUTH),
  refresh: localStorage.getItem(TOKEN_STORAGE_KEY.CSRF) || sessionStorage.getItem(TOKEN_STORAGE_KEY.CSRF),
});

export const setTokens = (auth: string, csrf: string, persist: boolean) => {
  if (persist) {
    localStorage.setItem(TOKEN_STORAGE_KEY.AUTH, auth);
    localStorage.setItem(TOKEN_STORAGE_KEY.CSRF, csrf);
  } else {
    sessionStorage.setItem(TOKEN_STORAGE_KEY.AUTH, auth);
    sessionStorage.setItem(TOKEN_STORAGE_KEY.CSRF, csrf);
  }
};

export const setAuthToken = (auth: string, persist: boolean) => {
  if (persist) {
    localStorage.setItem(TOKEN_STORAGE_KEY.AUTH, auth);
  } else {
    sessionStorage.setItem(TOKEN_STORAGE_KEY.AUTH, auth);
  }
};

export const removeTokens = () => {
  localStorage.removeItem(TOKEN_STORAGE_KEY.AUTH);
  sessionStorage.removeItem(TOKEN_STORAGE_KEY.AUTH);
};

export async function handleQueryAuthError(
  error: ApolloError,
  tokenRefresh: () => Promise<boolean>,
  logout: () => void
) {
  if (error.graphQLErrors.some(isJwtError)) {
    if (error.graphQLErrors.every(isTokenExpired)) {
      const success = await tokenRefresh();

      if (!success) {
        logout();
        showGqlErrorInfo(commonMsg.sessionExpired, "TokenRefreshFail");
      }
    } else {
      logout();
      showGqlErrorInfo(commonMsg.sessionExpired, "JwtError");
    }
  } else if (!error.graphQLErrors.every((err) => err.extensions?.exception?.code === "PermissionDenied")) {
    showGqlErrorInfo(error.message, "ApolloError");
  }
}

export const isPersistTokenMode = (user: User) => {
  if (!user) {
    return false;
  } else {
    return true;
  }
};

export const hasPermission = (permission: PermissionEnum, userPermissions: PermissionEnum[]) =>
  userPermissions.includes(permission);

// checkPermissions 에 포함된 permission 중 하나라도 유저가 퍼미션이 있으면 허용하기 위한 조건
export const checkHasAnyPermissions = (checkPermissions: PermissionEnum[], userPermissions: PermissionEnum[]) => {
  if (!checkPermissions || checkPermissions.length <= 0) {
    return true;
  }
  return checkPermissions.some((v) => userPermissions.includes(v));
};

// checkPermissions 에 포함된 모든 permission 을 유저가 가졌을 때 허용하기 위한 조건
export const checkHasAllPermissions = (checkPermissions: PermissionEnum[], userPermissions: PermissionEnum[]) => {
  if (!checkPermissions || checkPermissions.length <= 0) {
    return true;
  }
  return checkPermissions
    .map((permission) => userPermissions.includes(permission))
    .reduce((prev, curr) => prev && curr);
};
</file>

