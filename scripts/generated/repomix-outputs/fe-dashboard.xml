interface HqB2bSettlementListPageProps
  extends PaginateListProps,
    FilterPageProps<HqB2bSettlementFilterKeys, HqB2bSettlementListFilterOpts> {
  params: B2bSettlementForSalesViewUrlQueryParams;
  salesList: SalesListForB2b_sales_edges_node[];
  openModal: (action: B2bSettlementForSalesViewUrlDialog) => void;
  closeModal: () => void;
  selectedRowIds: string[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<string[]>>;
  ListNavigator: () => React.ReactNode;
}

const HqB2bSettlementListPage: React.FC<HqB2bSettlementListPageProps> = (props) => {
  const {
    params,
    currentTab,
    filterOpts,
    tabs,
    salesList,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    openModal,
    closeModal,
    selectedRowIds,
    setSelectedRowIds,
    ListNavigator,
    ...listProps
  } = props;
  const routeParams = useParams<HqB2bSettlementListViewRouteParams>();
  const filterStructure = createFilterStructure(filterOpts, routeParams);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const rowSelection: TableRowSelection<Purchases_purchases_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
  };

  let extraUi: React.ReactNode = null;
  let showRowSelection: boolean = true;

  const bulkBtnDisabled = selectedRowIds.length === 0 || listProps.disabled;
  switch (routeParams.status) {
    case "stand-by":
      showRowSelection = false;
      break;
    case "pending":
      extraUi = (
        <Space>
          <Button
            danger
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled}
            onClick={() => openModal("bulk-req-revision-sales")}
          >
            수정 요청
          </Button>
          <Button type="primary" shape="round" disabled={bulkBtnDisabled} onClick={() => openModal("bulk-close-sales")}>
            정산 내역 확정
          </Button>
        </Space>
      );
      break;
    case "completed":
      showRowSelection = false;
      break;
    case "all":
      showRowSelection = false;
      break;
    default:
      extraUi = null;
  }

  const columns = getHqB2bSettlementListTableSettings({ routeParams });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const purchaseTableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>{ListNavigator()}</Col>
          <Col>{extraUi}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={salesList}
            rowSelection={showRowSelection && rowSelection}
            scroll={{ x: purchaseTableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};

export default HqB2bSettlementListPage;
</file>

