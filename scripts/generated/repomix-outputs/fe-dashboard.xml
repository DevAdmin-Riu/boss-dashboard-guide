import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { WindowTitle } from "@src/app/components/WindowTitle";
import {
  useAddRackLocationMutation,
  useAddRackSectorMutation,
  useDeleteRackLocationMutation,
  useDeleteRackSectorMutation,
  useUpdateRackLocationMutation,
  useUpdateRackSectorMutation,
} from "@src/app/views/product/stock/api/mutations";
import { rackSectorListQuery, useRackSectorListQuery } from "@src/app/views/product/stock/api/queries";
import { RackLocationAddOrUpdateModal } from "@src/app/views/product/stock/components/RackLocationAddOrUpdateModal";
import { RackSectorAddOrUpdateModal } from "@src/app/views/product/stock/components/RackSectorAddOrUpdateModal";
