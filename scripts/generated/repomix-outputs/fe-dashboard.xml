  };
  const firstNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.user.USER_NAME,
    key: "firstName",
    width: 150,
    render: (_, record) => record.order.user?.firstName,
  };

  const bpSkuColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    width: 140,
    render: (_, record) => record.brandProductVariant?.bpSku || "-",
  };
  const productNameColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
