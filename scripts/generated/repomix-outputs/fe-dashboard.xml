import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import DialogContentText from "@material-ui/core/DialogContentText";
import usePermissionGroupSearch from "@src/api/searches/usePermissionGroupSearch";
import { AccountInput, BrandContractTypeEnum } from "@src/api/types/globalTypes";
import ActionDialog from "@src/app/components/ActionDialog";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getStringOrPlaceholder } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import {
  useAccountUpdate,
  useChangeStaffPassword,
  useStaffAvatarDelete,
  useStaffAvatarUpdate,
  useStaffMemberDelete,
  useStaffMemberUpdate,
} from "../api/mutations";
import { useStaffMemberDetailsForHqQuery, useStaffMemberDetailsQuery } from "../api/queries";
import { AccountUpdate } from "../api/types/AccountUpdate";
import { ChangeStaffPassword } from "../api/types/ChangeStaffPassword";
import { StaffAvatarDelete } from "../api/types/StaffAvatarDelete";
import { StaffAvatarUpdate } from "../api/types/StaffAvatarUpdate";
import { StaffMemberDelete } from "../api/types/StaffMemberDelete";
import { StaffMemberDetails } from "../api/types/StaffMemberDetails";
import { StaffMemberDetailsForHq } from "../api/types/StaffMemberDetailsForHq";
import { StaffMemberUpdate } from "../api/types/StaffMemberUpdate";
import StaffDetailsPage, { StaffDetailsFormData } from "../components/StaffDetailsPage/StaffDetailsPage";
import StaffPasswordResetDialog from "../components/StaffPasswordResetDialog";
import { staffDetailsViewUrl, StaffDetailsViewUrlQueryParams, staffListViewUrl } from "../urls";
import { groupsDiff } from "../utils";

interface StaffDetailsViewProps {
  id: string;
  params: StaffDetailsViewUrlQueryParams;
}

export const StaffDetailsView: React.FC<StaffDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const { user } = useUser();

  const isStaff = user.isStaff || user.isSuperuser;

  const closeModal = () =>
    navigate(
      staffDetailsViewUrl(id, {
        ...params,
        action: undefined,
      })
    );

  const handleChangePassword = (data: ChangeStaffPassword) => {
    const errors = data.passwordChange.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      closeModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [changePassword, changePasswordOpts] = useChangeStaffPassword({
    onCompleted: handleChangePassword,
  });

  const handleBack = () => (isStaff ? navigate(staffListViewUrl()) : navigate("/"));

  const {
    loadMore: loadMorePermissionGroups,
    search: searchPermissionGroups,
    result: searchPermissionGroupsOpts,
  } = isStaff
    ? usePermissionGroupSearch({
        variables: DEFAULT_INITIAL_SEARCH_DATA,
      })
    : { loadMore: undefined, search: undefined, result: undefined };

  const { data, loading } = isStaff
    ? useStaffMemberDetailsQuery({
        variables: { id },
      })
    : useStaffMemberDetailsForHqQuery({});

  const handleStaffMemberUpdate = (data: StaffMemberUpdate) => {
    const errors = data.staffUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleAccountUpdate = (data: AccountUpdate) => {
    const errors = data.accountUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleStaffMemberDelete = (data: StaffMemberDelete) => {
    const errors = data.staffDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(staffListViewUrl());
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleStaffMemberAvatarUpdate = (data: StaffAvatarUpdate) => {
    const errors = data.userAvatarUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const handleStaffMemberAvatarDelete = (data: StaffAvatarDelete) => {
    const errors = data.userAvatarDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      navigate(staffDetailsViewUrl(id));
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [updateStaffMember, updateResult] = useStaffMemberUpdate({
    onCompleted: handleStaffMemberUpdate,
  });

  const [updateAccount, updateAccountResult] = useAccountUpdate({
    onCompleted: handleAccountUpdate,
  });

  const [deleteStaffMember, deleteResult] = useStaffMemberDelete({
    onCompleted: handleStaffMemberDelete,
  });

  const handleDeleteStaff = () => {
    deleteStaffMember({
      variables: { id },
    });
  };

  const [updateStaffAvatar] = useStaffAvatarUpdate({
    onCompleted: handleStaffMemberAvatarUpdate,
  });

  const [deleteStaffAvatar, deleteAvatarResult] = useStaffAvatarDelete({
    onCompleted: handleStaffMemberAvatarDelete,
  });

  const staffMember = isStaff ? (data as StaffMemberDetails)?.user : (data as StaffMemberDetailsForHq)?.me;
  const isUserSameAsViewer = user?.id === staffMember?.id;

  const handleSubmit = async (formData: StaffDetailsFormData) => {
    if (isStaff) {
      const input = {
        loginId: formData.loginId,
        email: formData.email,
        firstName: formData.firstName,
        isActive: formData.isActive,
        lastName: formData.lastName,
        ...groupsDiff(staffMember, formData),
      };
      const result = await updateStaffMember({
        variables: {
          id,
          input,
        },
      });

      return result?.data?.staffUpdate?.errors;
    }
    const input: AccountInput = {
      loginId: formData.loginId,
      email: formData.email,
      firstName: formData.firstName,
    };
    const brand = user?.brand;
    if (brand?.contractType === BrandContractTypeEnum.REVERSE_FEE) {
      input.brandId = brand.id;
      input.minusReverseFeeDepositAlarmThreshold = formData.minusReverseFeeDepositAlarmThreshold;
      input.minQty = formData.minQty;
    }

    const result = await updateAccount({
      variables: {
        input,
      },
    });

    return result?.data?.accountUpdate?.errors;
  };

  if (staffMember === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }
  return (
    <>
      <WindowTitle title={getStringOrPlaceholder(staffMember?.email)} />
      <StaffDetailsPage
        brand={user?.brand}
        errors={isStaff ? updateResult?.data?.staffUpdate?.errors || [] : []}
        canEditAvatar={isUserSameAsViewer}
        canEditPreferences={isUserSameAsViewer}
        canEditStatus={!isUserSameAsViewer}
        canRemove={!isUserSameAsViewer}
        disabled={loading}
        onBack={handleBack}
        initialSearch=""
        onChangePassword={() =>
          navigate(
            staffDetailsViewUrl(id, {
              action: "change-password",
            })
          )
        }
        onDelete={() =>
          navigate(
            staffDetailsViewUrl(id, {
              action: "remove",
            })
          )
        }
        onSubmit={handleSubmit}
        onImageUpload={(file) =>
          updateStaffAvatar({
            variables: {
              image: file,
            },
          })
        }
        onImageDelete={() =>
          navigate(
            staffDetailsViewUrl(id, {
              action: "remove-avatar",
            })
          )
        }
        staffMember={staffMember}
        saveButtonBarState={isStaff ? updateResult.status : updateAccountResult.status}
        availablePermissionGroups={searchPermissionGroupsOpts?.data?.search.edges.map((edge) => edge.node)}
        fetchMorePermissionGroups={{
          hasMore: searchPermissionGroupsOpts?.data?.search.pageInfo.hasNextPage,
          loading: searchPermissionGroupsOpts?.loading,
          onFetchMore: loadMorePermissionGroups,
        }}
        onSearchChange={searchPermissionGroups}
      />
      <ActionDialog
        open={params.action === "remove"}
        title="관리자 삭제"
        confirmButtonState={deleteResult.status}
        variant="delete"
        onClose={closeModal}
        onConfirm={handleDeleteStaff}
      >
        <DialogContentText>
          {`${getStringOrPlaceholder(staffMember?.email)}를 관리자에서 제외하시겠습니까?`}
        </DialogContentText>
      </ActionDialog>
      <ActionDialog
        open={params.action === "remove-avatar"}
        title="대표 이미지 삭제"
        confirmButtonState={deleteAvatarResult.status}
        variant="delete"
        onClose={closeModal}
        onConfirm={deleteStaffAvatar}
      >
        <DialogContentText>
          {`${getStringOrPlaceholder(staffMember?.email)}의 대표 이미지를 삭제하시겠습니까?`}
        </DialogContentText>
      </ActionDialog>
      <StaffPasswordResetDialog
        confirmButtonState={changePasswordOpts.status}
        errors={changePasswordOpts?.data?.passwordChange?.errors || []}
        open={params.action === "change-password"}
        onClose={closeModal}
        onSubmit={(data) =>
          changePassword({
            variables: data,
          })
        }
      />
    </>
  );
};
</file>

