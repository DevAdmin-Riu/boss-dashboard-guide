import useNavigator from "@hooks/useNavigator";
import { DeleteFileType, UpdateFileDescType } from "@src/app/components/UploadFiles";
import { WindowTitle } from "@src/app/components/WindowTitle";
import BrandHistoryCreatePage, {
  BrandHistoryCreatePageFormData,
} from "@src/app/views/brand/brandHistory/components/BrandHistoryPage/BrandHistoryCreatePage";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { UploadFile } from "antd";
import queryString from "query-string";
import React, { useState } from "react";

import {
  useBrandHistoryCreateMutation,
  useCreateBrandHistoryFileMutation,
  useDeleteBrandHistoryFileMutation,
  useUpdateBrandHistoryFileMutation,
} from "../api/mutations";
import { BrandHistoryFileCreate } from "../api/types/BrandHistoryFileCreate";
import { BrandHistoryFileDelete } from "../api/types/BrandHistoryFileDelete";
import { BrandHistoryFileUpdate } from "../api/types/BrandHistoryFileUpdate";
import { CreateBrandHistory } from "../api/types/CreateBrandHistory";
import { brandHistoryDetailsViewUrl, brandHistoryListUrl } from "../urls";

export interface BrandHistoryCreateViewProps {
  id: string;
}

export const BrandHistoryCreateView: React.FC<BrandHistoryCreateViewProps> = () => {
  const [addFileList, setAddFileList] = useState<UploadFile[]>([]);
  const [addDescList, setAddDescList] = useState<string[]>([]);
  const [updateDescList, setUpdateDescList] = useState<UpdateFileDescType[]>([]);
  const [deleteFileList, setDeleteFileList] = useState<DeleteFileType[]>([]);

  const navigate = useNavigator();

  // 브랜드 상세페이지에서 넘어오는 경우에만 존재함.
  const brandId = queryString.parse(location.search).brand as string;

  const [createBrandHistory, createBrandHistoryOpts] = useBrandHistoryCreateMutation({
    onCompleted: (data: CreateBrandHistory) => {
      const errors = data.brandHistoryCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        navigate(brandHistoryDetailsViewUrl(data.brandHistoryCreate.brandHistory.id));
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const handleBack = () => {
    navigate(brandHistoryListUrl);
  };

  const handleBrandHistoryFileCreate = (data: BrandHistoryFileCreate) => {
    const errors = data.brandHistoryFileCreate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [createBrandHistoryFile] = useCreateBrandHistoryFileMutation({
    onCompleted: handleBrandHistoryFileCreate,
  });

  const handBrandHistoryFileUpdate = (data: BrandHistoryFileUpdate) => {
    const errors = data.brandHistoryFileUpdate.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [updateBrandHistoryFile] = useUpdateBrandHistoryFileMutation({
    onCompleted: handBrandHistoryFileUpdate,
  });

  const handleBrandHistoryFileDelete = (data: BrandHistoryFileDelete) => {
    const errors = data.brandHistoryFileDelete.errors;
    if (errors.length >= 0) {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [deleteBrandHistoryFile] = useDeleteBrandHistoryFileMutation({
    onCompleted: handleBrandHistoryFileDelete,
  });

  const createBrandHistoryFiles = async (addFileList: UploadFile[], addDescList: string[], id) => {
    const length = addFileList?.length;
    for (let i = 0; i < length; i++) {
      await createBrandHistoryFile({
        variables: {
          input: {
            brandHistory: id,
            file: addFileList[i].originFileObj,
            fileName: addFileList[i].name,
            description: addDescList[i],
          },
        },
      });
    }
  };

  const updateBrandHistoryFiles = async (updateDescList: UpdateFileDescType[]) => {
    const length = updateDescList?.length;
    for (let i = 0; i < length; i++) {
      const updateDesc = updateDescList[i];
      const { id, description } = updateDesc;
      await updateBrandHistoryFile({
        variables: {
          id,
          input: {
            description,
          },
        },
      });
    }
  };

  const deleteBrandHistoryFiles = async (deleteFileList: DeleteFileType[]) => {
    const length = deleteFileList?.length;
    for (let i = 0; i < length; i++) {
      const deleteFile = deleteFileList[i];
      const { id } = deleteFile;
      await deleteBrandHistoryFile({
        variables: {
          id,
        },
      });
    }
  };

  const handleSubmit = async (formData: BrandHistoryCreatePageFormData) => {
    const result = await createBrandHistory({
      variables: {
        input: {
          title: formData.title,
          content: JSON.stringify({
            content: formData.contentRaw,
          }),
          brand: brandId ? brandId : formData.brand,
        },
      },
    });
    await createBrandHistoryFiles(addFileList, addDescList, result.data.brandHistoryCreate.brandHistory.id);
    await updateBrandHistoryFiles(updateDescList);
    await deleteBrandHistoryFiles(deleteFileList);
    setAddFileList([]);
    setAddDescList([]);
    setUpdateDescList([]);
    setDeleteFileList([]);
    return result.data.brandHistoryCreate.errors;
  };

  return (
    <>
      <WindowTitle title="브랜드 이력 생성" />
      <BrandHistoryCreatePage
        disabled={createBrandHistoryOpts.loading}
        brandId={brandId}
        errors={createBrandHistoryOpts.data?.brandHistoryCreate.errors || []}
        saveButtonBar={createBrandHistoryOpts.status}
        onBack={handleBack}
        onSubmit={handleSubmit}
        uploadFileController={{
          addFileList,
          addDescList,
          updateDescList,
          deleteFileList,
          setAddFileList,
          setAddDescList,
          setUpdateDescList,
          setDeleteFileList,
        }}
      />
    </>
  );
};
</file>

