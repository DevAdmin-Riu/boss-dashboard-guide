  const [searchVendorList, setSearchVendorList] = React.useState<Vendors_vendors_edges_node[]>([]);
  const filterStructure = createFilterStructure(filterOpts, isStaff);
  const [isChanged, setIsChanged] = React.useState<boolean>(false);
  const [selectVendorName, setSelectVendorName] = React.useState<string>(null);
  const [open, setOpen] = React.useState<boolean>(false);
  const [vendorRecord, setVendorRecord] = React.useState<vendorInfoAndTarget>(null);

  const checkVendor = () => {
    if (vendorId === null) {
      customShowNotificationWarn("협력사를 선택해주세요.");
      return false;
    }
    return true;
  };

  const getHqListShippingDaySettingFormFieldVal = (field: string, defaultValue: any) => {
    const value = vendorHqListShippingDaySettingTableForm.getFieldValue(field);
    return value === undefined ? defaultValue : value;
  };

  const disabledToggleFn = (id: string, disabled: boolean) => {
    days.forEach((day) => {
      const checkBoxElement = document.getElementById(`${id}-${day}`) as HTMLInputElement;
      checkBoxElement.disabled = disabled;
    });
  };

  const vendorHqShippingDaySettingBarFormInitSet = () => {
    vendorHqShippingDaySettingBarForm.setFieldsValue({
      mon: false,
      tue: false,
      wed: false,
      thu: false,
      fri: false,
      sat: false,
      sun: false,
      disallowDeliveryDate: false,
      minimumOrderPrice: null,
    });
  };

  const disallowDeliveryDateToggle = (id, disallowDeliveryDate) => {
    if (disallowDeliveryDate) {
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-mon`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-tue`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-wed`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-thu`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-fri`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-sat`, false);
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${id}-sun`, false);

      disabledToggleFn(id, true);
    } else {
      disabledToggleFn(id, false);
    }
  };

  const formSubmit = () => {
    const isSelectedVendor = checkVendor();
    if (isSelectedVendor === false) {
      return false;
    }

    if (hqList.length === 0) {
      customShowNotificationWarn("매장 정보가 존재하지 않습니다.");
      return false;
    }

    const fbvDeliveryConditionBulkDetailDataList = hqList.reduce((acc, cur) => {
      const minimumOrderPrice = getHqListShippingDaySettingFormFieldVal(`${cur.id}-minimumOrderPrice`, null);
      const obj: FbvDeliveryConditionBulkDetails = {
        vendorCode,
        loginId: cur.loginId,
        disallowDeliveryDate: getHqListShippingDaySettingFormFieldVal(`${cur.id}-disallowDeliveryDate`, false),
        minimumOrderPrice: minimumOrderPrice < 0 ? 0 : minimumOrderPrice,
        possibleDeliveryDays: {
          monday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-mon`, false),
          tuesday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-tue`, false),
          wednesday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-wed`, false),
          thursday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-thu`, false),
          friday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-fri`, false),
          saturday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-sat`, false),
          sunday: getHqListShippingDaySettingFormFieldVal(`${cur.id}-sun`, false),
        },
      };
      acc.push(obj);
      return acc;
    }, []);

    fbvDeliveryConditionBulkUpdateOrCreate({
      variables: {
        input: {
          details: fbvDeliveryConditionBulkDetailDataList,
        },
      },
    });
    setIsChanged(false);
  };

  const settingSaveOnClick = () => {
    vendorHqShippingDaySettingBarForm.submit();
  };
  const settingInitOnClick = () => {
    setIsChanged(false);
    initialFormHqList(hqList);
  };

  const rowSelection = {
    onChange: (selectedRowKeys) => {
      setSelectedRowKeys([...selectedRowKeys]);
    },
    selectedRowKeys,
    fixed: true,
  };

  const columns = getHqListTableSettings({
    disallowDeliveryDateToggle,
    isStaff,
    onSetDefaultVariant: props.onSetDefaultVariant,
  });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const withVendorCheck = (action) =>
    function (...args) {
      if (!checkVendor()) {
        return false;
      }

      if (selectedRowKeys.length === 0) {
        customShowNotificationWarn("선택된 매장이 없습니다.");
        return false;
      }
      setIsChanged(true);
      return action(...args);
    };

  // NOTE: 배송요일 일괄 설정
  const bulkDaysSetting = withVendorCheck(() => {
    const days = [
      { label: "mon", value: vendorHqShippingDaySettingBarForm.getFieldValue("mon") },
      { label: "thu", value: vendorHqShippingDaySettingBarForm.getFieldValue("thu") },
      { label: "wed", value: vendorHqShippingDaySettingBarForm.getFieldValue("wed") },
      { label: "tue", value: vendorHqShippingDaySettingBarForm.getFieldValue("tue") },
      { label: "fri", value: vendorHqShippingDaySettingBarForm.getFieldValue("fri") },
      { label: "sat", value: vendorHqShippingDaySettingBarForm.getFieldValue("sat") },
      { label: "sun", value: vendorHqShippingDaySettingBarForm.getFieldValue("sun") },
    ];
    selectedRowKeys.forEach((item) => {
      const disallowDeliveryDate: boolean = getHqListShippingDaySettingFormFieldVal(
        `${item}-disallowDeliveryDate`,
        false
      );
      days.forEach((day) => {
        if (disallowDeliveryDate === false) {
          vendorHqListShippingDaySettingTableForm.setFieldValue(`${item}-${day.label}`, day.value);
        }
      });
    });
  });
  // NOTE: 배송요일 지정불가 일괄 설정
  const bulkDisallowDeliveryDate = withVendorCheck(() => {
    const disallowDeliveryDate = vendorHqShippingDaySettingBarForm.getFieldValue("disallowDeliveryDate");
    selectedRowKeys.forEach((item) => {
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${item}-disallowDeliveryDate`, disallowDeliveryDate);
      disallowDeliveryDateToggle(item, disallowDeliveryDate);
    });
  });
  // NOTE: 최소주문금액 일괄 설정
  const bulkMinimumOrderPrice = withVendorCheck(() => {
    const minimumOrderPrice = vendorHqShippingDaySettingBarForm.getFieldValue("minimumOrderPrice");
    selectedRowKeys.forEach((item) => {
      vendorHqListShippingDaySettingTableForm.setFieldValue(`${item}-minimumOrderPrice`, minimumOrderPrice);
    });
  });

  const vendorChangedAfterEvent = (record: Vendors_vendors_edges_node) => {
    setIsVendorChanging(true); // 협력사 변경 시작
    setVendorId(record.id);
    setVendorCode(record.code);
    setSelectVendorName(record.name);
    setHqList([]); // 데이터 초기화
    onAll(); // 필터 초기화 (resetFilters)
    vendorHqShippingDaySettingBarFormInitSet();
    setSelectedRowKeys([]);
    setIsChanged(false);
    setVendorRecord(null);
  };

  return (
    <>
      <Row gutter={[24, 24]}>
        <Col span={6}>
          <Card
            title="협력사 리스트"
            bodyStyle={{ padding: 0 }}
            extra={
              <>
                {isChanged && (
                  <Tag color="volcano" style={{ width: "100%", textAlign: "center", fontSize: 13 }}>
                    저장 필요
                  </Tag>
                )}
              </>
            }
          >
            <Row>
              <Input
                style={{ margin: 10 }}
                value={searchVendorKeyword}
                placeholder="협력사 검색"
                suffix={<SearchOutlined />}
                onChange={(e) => {
                  const target = e.target;
                  const value = target.value;
                  setSearchVendorKeyword(value);

                  const filterVendorList = vendorList.filter(
                    (item) => item.name.includes(value) || item.code.includes(value)
                  );
                  setSearchVendorList(filterVendorList);
                }}
              />
            </Row>
            {selectVendorName && (
              <Row>
                <Typography.Title level={5} style={{ margin: 10 }}>
                  {selectVendorName}
                </Typography.Title>
              </Row>
            )}
            <Table
              {...commonTableProps}
              className="vendorHqShippingDaySettingTable"
              dataSource={searchVendorKeyword === "" ? vendorList : searchVendorList}
              columns={getVendorListTableSettings(vendorId)}
              rowClassName={(record) => (record.id === vendorId ? "vendor-select-active" : "")}
              scroll={{ y: tableScrollY }}
              onRow={(record: Vendors_vendors_edges_node) => ({
                onClick: (e) => {
                  const target = e.currentTarget;
                  if (vendorId === record.id) {
                    return;
                  }
                  if (isChanged) {
                    setOpen(true);
                    setVendorRecord({ record, target });
                    return;
                  }

                  vendorChangedAfterEvent(record);
                },
              })}
            />
          </Card>
        </Col>
        <Col span={18}>
          <Card title="협력사 별 매장 설정">
            <SpreadFilterBar
              currentTab={currentTab}
              onAll={onAll}
              onTabChange={onTabChange}
              onTabDelete={onTabDelete}
              onTabSave={onTabSave}
              tabs={tabs}
              onFilterChange={onFilterChange}
              filterStructure={filterStructure}
              isDownloadable={true}
              validateQueryClick={validateQueryClick}
            />
            <Form
              form={vendorHqShippingDaySettingBarForm}
              layout="horizontal"
              onFinish={formSubmit}
              initialValues={{
                mon: false,
                tue: false,
                wed: false,
                thu: false,
                fri: false,
                sat: false,
                sun: false,
                disallowDeliveryDate: false,
                minimumOrderPrice: null,
              }}
            >
              <VendorHqShippingDaySettingBar
                settingSaveOnClick={settingSaveOnClick}
                settingInitOnClick={settingInitOnClick}
                bulkDaysSetting={bulkDaysSetting}
                bulkDisallowDeliveryDate={bulkDisallowDeliveryDate}
                bulkMinimumOrderPrice={bulkMinimumOrderPrice}
                finalSubmitLoading={fbvDeliveryConditionBulkUpdateOrCreateOpts.loading}
              />
            </Form>
            <Form
              form={vendorHqListShippingDaySettingTableForm}
              onFieldsChange={() => {
                setIsChanged(true);
              }}
            >
              <Table
                {...commonTableProps}
                className="vendorHqListShippingDaySettingTable"
                ref={tableRef}
                dataSource={hqList}
                columns={columns}
                loading={disabled}
                scroll={{ x: tableWidthSum, y: tableScrollY }}
                rowSelection={rowSelection}
              />
            </Form>
          </Card>
        </Col>
      </Row>
      <ConfirmModal
        visible={open}
        onCancel={() => setOpen(false)}
        onOk={() => {
          setOpen(false);
          vendorChangedAfterEvent(vendorRecord.record);
        }}
        modalTitleText="협력사 변경"
        titleText="협력사 변경 여부 확인"
        helpText="협력사를 변경하면 변경된 설정을 잃어버릴 수 있습니다. 변경하시겠습니까?"
        okText="변경"
        cancelText="취소"
      />
    </>
  );
};

export default VendorHqShippingDaySettingPage;
</file>

