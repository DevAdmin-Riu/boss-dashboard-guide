import TimelineNote from "@src/app/components/Timeline/TimelineNote";
import { utils } from "@utils/utils";
import { Descriptions, Divider, Empty, Space, Tag, Timeline, Typography } from "antd";
import React from "react";

import {
  RequestBossProductDetails_requestBossProduct_allStatusHistories,
  RequestBossProductDetails_requestBossProduct_allStatusHistories_priceInfo,
} from "../api/types/RequestBossProductDetails";
import {
  getReqBossProductDescProps,
  getRequestBossProductStatusColor,
  getRequestBossProductStatusText,
} from "../utils";

const { Item: DItem } = Descriptions;

interface RequestBossProductStatusHistoryProps {
  histories: RequestBossProductDetails_requestBossProduct_allStatusHistories[];
}

export const RequestBossProductStatusHistory: React.FC<RequestBossProductStatusHistoryProps> = (props) => {
  const { histories } = props;
  const { user } = useUser();
  const { isStaff, isHqStaff } = user;

  const makePriceInfoDescriptions = (history: RequestBossProductDetails_requestBossProduct_allStatusHistories) => {
    const { afterStatus, priceInfo } = history;

    const getVendorPriceItems = (priceInfo) => [
      { label: "재고 협력사 상품가(ⓐ)", value: priceInfo.vendorProductPriceExcludeVat },
      { label: "재고 협력사 배송비(ⓑ)", value: priceInfo.vendorDeliveryFeeExcludeVat },
      {
        label: "재고 협력사 매입가(ⓐ+ⓑ)",
        value: priceInfo.vendorProductPriceExcludeVat + priceInfo.vendorDeliveryFeeExcludeVat,
      },
      { label: "재고 판매 택배비(ⓒ)", value: priceInfo.deliveryFeeExcludeVat },
      {
        label: "재고 공급원가(ⓐ+ⓑ+ⓒ)",
        value:
          priceInfo.vendorProductPriceExcludeVat +
          priceInfo.vendorDeliveryFeeExcludeVat +
          priceInfo.deliveryFeeExcludeVat,
      },
      { label: "위탁 협력사 상품가(ⓐ)", value: priceInfo.vendorConsignmentProductPriceExcludeVat },
      { label: "위탁 협력사 배송비(ⓑ)", value: priceInfo.vendorConsignmentDeliveryFeeExcludeVat },
      {
        label: "위탁 협력사 매입가(ⓐ+ⓑ)",
        value: priceInfo.vendorConsignmentProductPriceExcludeVat + priceInfo.vendorConsignmentDeliveryFeeExcludeVat,
      },
      { label: "위탁 판매 택배비(ⓒ)", value: priceInfo.consignmentDeliveryFeeExcludeVat },
      {
        label: "위탁 공급원가(ⓐ+ⓑ+ⓒ)",
        value:
          priceInfo.vendorConsignmentProductPriceExcludeVat +
          priceInfo.vendorConsignmentDeliveryFeeExcludeVat +
          priceInfo.consignmentDeliveryFeeExcludeVat,
      },
    ];
    const getBrandPriceItems = (priceInfo) => [
      { label: "브랜드 상품가(ⓐ)", value: priceInfo.brandProductPriceExcludeVat },
      { label: "브랜드 배송비(ⓑ)", value: priceInfo.brandDeliveryFeeExcludeVat },
      {
        label: "브랜드 판매가(ⓐ+ⓑ)",
        value: priceInfo.brandProductPriceExcludeVat + priceInfo.brandDeliveryFeeExcludeVat,
      },
    ];

    const priceInfoItems: Array<Array<{ label: string; value: number }>> = [];
    const subItems: number[] = [];
    const processPriceInfo = (info: RequestBossProductDetails_requestBossProduct_allStatusHistories_priceInfo) => {
      switch (afterStatus) {
        case RequestBossProductStatusEnum.BRAND_PRICE:
          return isStaff ? [...getVendorPriceItems(info)] : [];
        case RequestBossProductStatusEnum.PENDING_CONFIRM:
          if (isStaff) {
            return [...getVendorPriceItems(info), ...getBrandPriceItems(info)];
          } else if (isHqStaff) {
            return [...getBrandPriceItems(info)];
          }
          return [];
        case RequestBossProductStatusEnum.CONFIRMED: {
          const mallProductPriceItem = {
            label: "매장 판매가",
            value: priceInfo[0].mallProductPriceExcludeVat,
          };
          if (isStaff) {
            return [...getVendorPriceItems(info), ...[...getBrandPriceItems(info), mallProductPriceItem]];
          } else if (isHqStaff) {
            return [...getBrandPriceItems(info), mallProductPriceItem];
          }
          return [];
        }
        default:
          return [];
      }
    };

    // priceInfo 배열 순회 후, 각 항목에 대해 처리된 결과를 priceInfoItems에 추가
    priceInfo.forEach((info) => {
      const items = processPriceInfo(info);
      if (items.length > 0) {
        subItems.push(info.subId);
        priceInfoItems.push(items);
      }
    });

    if (priceInfoItems.length === 0) {
      return undefined;
    }
    return (
      <>
        {priceInfoItems.map((priceInfoItem, priceInfoItemIndex) => (
          <Descriptions
            style={{ marginTop: priceInfoItemIndex === 0 ? 0 : 10 }}
            key={priceInfoItemIndex}
            {...getReqBossProductDescProps(5)}
            layout="vertical"
            title={subItems.length > 0 && `No.${subItems[priceInfoItemIndex]} 견적서`}
            column={5}
            extra={<TableVatLegend isIncludeVat={false} />}
          >
            {priceInfoItem.map((item, itemIndex) => (
              <DItem key={itemIndex} label={item.label}>
                <NumberComponent value={item.value} />
              </DItem>
            ))}
          </Descriptions>
        ))}
      </>
    );
  };
  return (
    <Space direction="vertical" size="large">
      <Typography.Title level={4}>요청 처리 내역</Typography.Title>
      <Divider />
      {histories ? (
        <Timeline>
          {histories.map((history) => {
            const { beforeStatus, afterStatus, reason, priceInfo } = history;
            const beforeStatusText = getRequestBossProductStatusText(beforeStatus);
            const beforeStatusColor = getRequestBossProductStatusColor(beforeStatus);
            const afterStatusText = getRequestBossProductStatusText(afterStatus);
            const afterStatusColor = getRequestBossProductStatusColor(afterStatus);
            const tagForStatusChanged = beforeStatus ? (
              <Space>
                <Tag color={beforeStatusColor}>{beforeStatusText}</Tag>→
                <Tag color={afterStatusColor}>{afterStatusText}</Tag>
              </Space>
            ) : (
              <Tag color={afterStatusColor}>{afterStatusText}</Tag>
            );
            return (
              <Timeline.Item key={history.id} color={afterStatusColor}>
                <TimelineNote
                  date={history.createdAt}
                  user={history.writer}
                  tag={tagForStatusChanged}
                  message={utils.isEmpty(reason, true) ? undefined : reason}
                >
                  {utils.isEmpty(priceInfo) ? undefined : makePriceInfoDescriptions(history)}
                </TimelineNote>
              </Timeline.Item>
            );
          })}
        </Timeline>
      ) : (
        <Empty description="내역 없음" />
      )}
    </Space>
  );
};
</file>

