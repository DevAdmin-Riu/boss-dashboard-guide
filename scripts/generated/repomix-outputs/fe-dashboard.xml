export const couriersDeliveryFeesQuery = gql`
  ${pageInfoFragment}
  query CouriersDeliveryFees(
    $filter: CouriersDeliveryFeeFilterInput
    $before: String
    $after: String
    $first: Int
    $last: Int
  ) {
    couriersDeliveryFees(filter: $filter, before: $before, after: $after, first: $first, last: $last) {
      edges {
        node {
          id
          created
          collectedAt
          isCollectedCorrected
          isReturn
          isReturnCancel
          returnCancelDate
          order {
            id
            composedIdWithPrefix
            type
            lines {
              id
              subId
            }
            staffNote
          }
          fulfillment {
            id
            composedIdWithPrefix
            lines {
              orderLine {
                id
                composedIdWithPrefix
              }
            }
            courier {
              id
            }
          }
          productInfo
          deliveryInfo
          deliveryFee
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;

