import { BrandStoreRequestToHqStatus } from "@src/api/types/globalTypes";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { DateTime } from "@src/app/providers/DateProvider/DateTime";
import { utils } from "@utils/utils";
import { Tag, Typography } from "antd";
import { ColumnsType, ColumnType } from "antd/lib/table";
import React from "react";

import { BrandStoreRequestToHqList_brandStoreRequestToHqList_edges_node } from "../../api/types/BrandStoreRequestToHqList";
import { brandStoreRequestToHqStatusChoices } from "../../utils";
import { BrandStoreRequestToHqListPageProps } from "./BrandStoreRequestToHqListPage";

export const makeBsRequestToHqStatusTag = (
  request: Pick<BrandStoreRequestToHqList_brandStoreRequestToHqList_edges_node, "status">
) => {
  let statusTagColor = "";
  const statusText = utils.getLabelTextByValue(request?.status, brandStoreRequestToHqStatusChoices);
  switch (request?.status) {
    case BrandStoreRequestToHqStatus.WAITING:
      statusTagColor = "error";
      break;
    case BrandStoreRequestToHqStatus.ACCEPTED:
      statusTagColor = "processing";
      break;
    case BrandStoreRequestToHqStatus.DONE:
      statusTagColor = "success";
      break;
    default:
      statusTagColor = "default";
      break;
  }

  return <Tag color={statusTagColor}>{statusText}</Tag>;
