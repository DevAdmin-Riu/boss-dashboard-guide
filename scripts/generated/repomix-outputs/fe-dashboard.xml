<file path="src/app/views/hqFulfilledByVendor/components/HqFulfilledByVendorSettlementListPage/HqFulfilledByVendorSettlementListTableSettings.tsx">
import { BrandMonthlySettlementStatusEnum, StatReportingMode } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import { renderStatDate } from "@src/app/views/mileageSettlement/components/MileageSettlementListPage/utils";
import { transformIsFBVForHq } from "@utils/misc";
import { Button, Typography } from "antd";
import Table, { ColumnsType } from "antd/lib/table";
import React from "react";

import { Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq } from "../../utils";

const { Text } = Typography;

export function getFulfilledByVendorSettlementListTableSettings(
  dateType: StatReportingMode,
  setUpdateDataId: React.Dispatch<React.SetStateAction<string>>,
  setOpenConfirmModal: React.Dispatch<React.SetStateAction<boolean>>,
  loading: boolean
) {
  const statFulfilledByVendorColumns: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [
    {
      title: "매입(부가세별도)",
      align: "right",
      key: "statBrandCostPriceExcludeVatOnlyFbv",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statBrandCostPriceExcludeVatOnlyFbv} />,
    },
    {
      title: <Typography.Text style={{ fontSize: 10 }}>세액</Typography.Text>,
      align: "right",
      key: "statBrandCostPriceVatOnlyFbv",
      width: 100,
      render: (_, record) => (
        <Typography.Text style={{ fontSize: 10 }}>
          <NumberComponent
            value={record.statBrandCostPriceIncludeVatOnlyFbv - record.statBrandCostPriceExcludeVatOnlyFbv}
          />
        </Typography.Text>
      ),
    },
    {
      title: "합계금액",
      align: "right",
      key: "statBrandCostPriceIncludeVatOnlyFbv",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statBrandCostPriceIncludeVatOnlyFbv} />,
    },
    {
      title: "수수료",
      align: "right",
      key: "statBrandPayingChargeIncludeVatOnlyFbv",
      width: 120,
      render: (_, record) => <NumberComponent value={record.statBrandPayingChargeIncludeVatOnlyFbv} />,
    },
    {
      title: "최종대금",
      align: "right",
      key: "totalStatBrandPayingChargeOnlyFbv",
      width: 120,
      render: (_, record) => (
        <NumberComponent
          value={record.statBrandCostPriceIncludeVatOnlyFbv - record.statBrandPayingChargeIncludeVatOnlyFbv}
        />
      ),
    },
  ];

  const statusColumn: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [];
  statusColumn.push({
    title: "상태",
    align: "center",
    key: "settlementStatus",
    width: 120,
    render: (_, record) => {
      switch (record.settlementStatus) {
        case BrandMonthlySettlementStatusEnum.CONFIRMED:
          return (
            <>
              <Text type="success">확정</Text>
              <br />
              <Button
                type="primary"
                shape="round"
                loading={loading}
                onClick={() => {
                  setUpdateDataId(record.settlementId);
                  setOpenConfirmModal(true);
                }}
              >
                신청하기
              </Button>
            </>
          );
        case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
        case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
          return <Text type="success">신청완료</Text>;
        case BrandMonthlySettlementStatusEnum.PAID:
          return <Text type="success">지급완료</Text>;
        default:
          return <Text type="warning">미확정</Text>;
      }
    },
  });
  statusColumn.push({
    title: "반려사유",
    align: "center",
    key: "rejectReason",
    width: 120,
    render: (_, record) => {
      // settlementStatus 가 confirmed인 경우에만 반려사유를 노출하고 다른 경우에는 노출하지않는다.
      if (record.settlementStatus === BrandMonthlySettlementStatusEnum.CONFIRMED) {
        return <Text type="danger">{record.rejectReason}</Text>;
      } else {
        return <Text>-</Text>;
      }
    },
  });

  const columns: ColumnsType<Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq> = [
    {
      title: "구분",
      align: "center",
      key: "statDate",
      fixed: "left",
      width: 200,
      render: (_, record) => renderStatDate(record.statDate, dateType),
    },
    {
      title: <Typography.Title level={5}>{transformIsFBVForHq(true)} 상품 매입금</Typography.Title>,
      children: statFulfilledByVendorColumns,
    },
    { title: <Typography.Title level={5}>현황</Typography.Title>, children: statusColumn },
  ];

  return columns;
}

export function getFulfilledByVendorSettlementListTableSummary(tableData: readonly any[]) {
  let statBrandCostPriceExcludeVatOnlyFbvSum = 0;
  let statBrandCostPriceVatOnlyFbvSum = 0;
  let statBrandCostPriceIncludeVatOnlyFbvSum = 0;
  let statBrandPayingChargeIncludeVatOnlyFbvSum = 0;
  let totalStatBrandPayingChargeOnlyFbvSum = 0;

  tableData.forEach(
    ({
      statBrandCostPriceExcludeVatOnlyFbv,
      statBrandCostPriceIncludeVatOnlyFbv,
      statBrandPayingChargeIncludeVatOnlyFbv,
    }) => {
      statBrandCostPriceExcludeVatOnlyFbvSum += statBrandCostPriceExcludeVatOnlyFbv;
      statBrandCostPriceVatOnlyFbvSum += statBrandCostPriceIncludeVatOnlyFbv - statBrandCostPriceExcludeVatOnlyFbv;
      statBrandCostPriceIncludeVatOnlyFbvSum += statBrandCostPriceIncludeVatOnlyFbv;
      statBrandPayingChargeIncludeVatOnlyFbvSum += statBrandPayingChargeIncludeVatOnlyFbv;
      totalStatBrandPayingChargeOnlyFbvSum +=
        statBrandCostPriceIncludeVatOnlyFbv - statBrandPayingChargeIncludeVatOnlyFbv;
    }
  );

  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} align="center">
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={statBrandCostPriceExcludeVatOnlyFbvSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={statBrandCostPriceVatOnlyFbvSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={statBrandCostPriceIncludeVatOnlyFbvSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={statBrandPayingChargeIncludeVatOnlyFbvSum} />
          </Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={1} align="right">
          <Text strong>
            <NumberComponent value={totalStatBrandPayingChargeOnlyFbvSum} />
          </Text>
        </Table.Summary.Cell>
      </Table.Summary.Row>
    </Table.Summary>
  );
}
