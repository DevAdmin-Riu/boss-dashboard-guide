<file path="src/app/views/product/products/components/ProductVariantVendorCreateOrUpdateModal.tsx">
import { PauseOutlined, PlusOutlined } from "@ant-design/icons";
import { commonMsg, formRuleMsg } from "@assets/messages/commonMsg";
import { SearchVendorsVariables } from "@src/api/searches/types/SearchVendors";
import useVendorSearch from "@src/api/searches/useVendorSearch";
import {
  CategoryKindEnum,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
  ProductVariantVendorCreateInput,
  ProductVariantVendorUpdateInput,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import RequiredTypography from "@src/app/components/RequiredTypography";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { StrictOmit } from "@src/global/core/types/types";
import { makeVendorDisplayName, maybe, transformIsFBV } from "@utils/misc";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Checkbox, Col, Descriptions, Form, Input, InputNumber, Modal, Row, Select, Switch, Typography } from "antd";
import { CheckboxChangeEvent } from "antd/lib/checkbox";
import React, { useEffect, useMemo } from "react";

import { useProductVariantVendorCreateMutation, useProductVariantVendorUpdateMutation } from "../api/mutations";
import { productDetailsQuery, productVariantDetailsQuery } from "../api/queries";
import {
  ProductDetails_product,
  ProductDetails_product_outerVariants,
  ProductDetails_product_outerVariants_productVariantVendors,
} from "../api/types/ProductDetails";
import {
  ProductVariantDetails_productVariant,
  ProductVariantDetails_productVariant_productVariantVendors,
} from "../api/types/ProductVariantDetails";
import { productVariantManageEventTypeChoices } from "../utils/data";
import { getSearchVendorsVariablesForPvv } from "./ProductDefaultVendor/utils";
import { makePvOrBpvManageEventFormItems } from "./PvOrBpvManageEventModal";

const { Item: DItem } = Descriptions;
const { Item: FItem } = Form;

interface ProductVariantVendorCreateOrUpdateModalProps {
  isCreateMode: boolean;
  open: boolean;
  loading: boolean;
  precision: number;
  product: Pick<ProductDetails_product, "isFulfilledByVendor" | "category">;
  productVariant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  productVariantVendor?:
    | ProductDetails_product_outerVariants_productVariantVendors
    | ProductVariantDetails_productVariant_productVariantVendors;
  onClose: () => void;
}

interface ProductVariantVendorCreateModalForm extends StrictOmit<ProductVariantVendorCreateInput, "productVariant"> {
  needReason: boolean;
}
interface ProductVariantVendorUpdateModalForm extends ProductVariantVendorUpdateInput {
  needReason: boolean;
}
type TFormData = ProductVariantVendorCreateModalForm | ProductVariantVendorUpdateModalForm;

export const ProductVariantVendorCreateOrUpdateModal: React.FC<ProductVariantVendorCreateOrUpdateModalProps> = (
  props
) => {
  const { isCreateMode, open, loading, product, productVariant, productVariantVendor, onClose, precision } = props;
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);
  const productPriceExcludeVatWatched = TypeSafeForm.getUseFormWatched({ name: "productPriceExcludeVat" });
  const deliveryFeeExcludeVatWatched = TypeSafeForm.getUseFormWatched({ name: "deliveryFeeExcludeVat" });
  const costPriceExcludeVat = productPriceExcludeVatWatched + deliveryFeeExcludeVatWatched;
  const consignmentProductPriceExcludeVatWatched = TypeSafeForm.getUseFormWatched({
    name: "consignmentProductPriceExcludeVat",
  });
  const consignmentDeliveryFeeExcludeVatWatched = TypeSafeForm.getUseFormWatched({
    name: "consignmentDeliveryFeeExcludeVat",
  });
  const consignmentCostPriceExcludeVat =
    consignmentProductPriceExcludeVatWatched + consignmentDeliveryFeeExcludeVatWatched;

  const includePurchaseB2bDeliveryFeeWatched: boolean = TypeSafeForm.getUseFormWatched({
    name: "includePurchaseB2bDeliveryFee",
  });
  const isB2bCategoryKind = product.category.kind === CategoryKindEnum.B2B;
  const isDevCategoryKind = product.category.kind === CategoryKindEnum.DEV;

  const initialManageEventValue: ProductVariantManageEventInput = {
    type: ProductVariantManageEventTypeEnum.TYPE_VENDOR,
    title: "",
    reason: "",
  };
  const initialValues: TFormData = isCreateMode
    ? {
        vendor: null,
        isActive: true,
        externalSku: "",
        externalProductName: "",
        productPriceExcludeVat: null,
        deliveryFeeExcludeVat: null,
        consignmentProductPriceExcludeVat: null,
        consignmentDeliveryFeeExcludeVat: null,
        leadTime: null,
        moq: null,
        pricingBasisQty: null,
        note: "",
        noteForUnitPrice: "",
        manageEvent: initialManageEventValue,
        needReason: true,
      }
    : { ...productVariantVendor, manageEvent: initialManageEventValue, needReason: true };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const queryVariables = useMemo<SearchVendorsVariables>(
    () => getSearchVendorsVariablesForPvv(product.isFulfilledByVendor, isB2bCategoryKind),
    []
  );

  const {
    loadMore: loadMoreVendors,
    search: searchVendors,
    result: searchVendorsOpts,
  } = useVendorSearch({
    skip: isCreateMode === false,
    variables: queryVariables,
  });

  const [createProductVariantVendor, createProductVariantVendorOpts] = useProductVariantVendorCreateMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantVendorCreate?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("제품 협력사가 추가되었습니다.");
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [productDetailsQuery, productVariantDetailsQuery],
  });

  const [updateProductVariantVendor, updateProductVariantVendorOpts] = useProductVariantVendorUpdateMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantVendorUpdate?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        onClose();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const checkIsCreateInput = (
    _input: StrictOmit<ProductVariantVendorCreateInput, "productVariant"> | ProductVariantVendorUpdateInput
  ): _input is StrictOmit<ProductVariantVendorCreateInput, "productVariant"> => isCreateMode;

  const onSubmit = (formData: TFormData) => {
    const { needReason, ...restInput } = formData;
    const validateUpdateInput = () => {
      const {
        isActive,
        productPriceExcludeVat,
        deliveryFeeExcludeVat,
        consignmentProductPriceExcludeVat,
        consignmentDeliveryFeeExcludeVat,
        purchaseB2bDeliveryFeeExcludeVat,
        moq,
        leadTime,
      } = restInput;
      const isDefault = productVariant.defaultVariantVendor?.id === productVariantVendor?.id;
      if (isDefault === true && isActive === false) {
        showNotificationError("기본 옵션으로 지정된 협력사는 비활성화 설정이 불가합니다.");
        return false;
      }
      const trackInventory = productVariant.trackInventory;
      if (trackInventory) {
        if (
          productVariant?.isDeferred === false &&
          (utils.isEmpty(productPriceExcludeVat) || productPriceExcludeVat <= 0) &&
          (utils.isEmpty(consignmentProductPriceExcludeVat) || consignmentProductPriceExcludeVat <= 0)
        ) {
          showNotificationError(
            "재고 운영 제품인 경우, 협력사 재고 상품가와 협력사 위탁 상품가 둘 중 하나는 0 보다 큰 값 이어야 합니다."
          );
          return false;
        }
      } else {
        if (
          productVariant?.isDeferred === false &&
          (utils.isEmpty(consignmentProductPriceExcludeVat) || consignmentProductPriceExcludeVat <= 0)
        ) {
          showNotificationError(
            `재고 미운영이거나 ${transformIsFBV(true)} 상품인 경우, 협력사 위탁 상품가는 0 보다 큰 값 이어야 합니다.`
          );
          return false;
        }
      }
      const isFulfilledByVendor = product.isFulfilledByVendor;
      if (isB2bCategoryKind === false && isDevCategoryKind === false) {
        if (!isFulfilledByVendor && (utils.isEmpty(deliveryFeeExcludeVat) || deliveryFeeExcludeVat < 0)) {
          showNotificationError("협력사 재고 배송비는 0 이상의 값 이어야 합니다.");
          return false;
        }
        if (utils.isEmpty(consignmentDeliveryFeeExcludeVat) || consignmentDeliveryFeeExcludeVat < 0) {
          showNotificationError("협력사 위탁 배송비는 0 이상의 값 이어야 합니다.");
          return false;
        }
      } else {
        if (
          includePurchaseB2bDeliveryFeeWatched === false &&
          (utils.isEmpty(purchaseB2bDeliveryFeeExcludeVat) || purchaseB2bDeliveryFeeExcludeVat < 0)
        ) {
          showNotificationError("협력사 위탁 배송비는 필수 입력 항목입니다.");
          return false;
        }
      }

      if (utils.isEmpty(moq)) {
        showNotificationError("협력사 발주 MOQ는 필수 입력 항목입니다.");
        return false;
      }
      if (utils.isEmpty(leadTime) || leadTime <= 0) {
        showNotificationError("협력사 L/T는 필수 입력 항목이며 0보다 큰 값이어야 합니다.");
        return false;
      }
      return true;
    };

    if (checkIsCreateInput(restInput)) {
      const validateCreateInput = () => {
        const { vendor } = restInput;
        if (utils.isEmpty(productVariant)) {
          showNotificationError("제품 정보가 올바르지 않습니다. 새로고침 후 다시 시도해주십시오.");
          return false;
        }
        if (utils.isEmpty(vendor)) {
          showNotificationError("협력사 업체를 선택해주십시오.");
          return false;
        }
        return validateUpdateInput();
      };
      if (validateCreateInput() === false) {
        return;
      }

      createProductVariantVendor({ variables: { input: { ...restInput, productVariant: productVariant.id } } });
    } else {
      if (validateUpdateInput() === false) {
        return;
      }

      if (productVariant?.isDeferred) {
        restInput.productPriceExcludeVat = 0;
        restInput.deliveryFeeExcludeVat = 0;
        restInput.consignmentProductPriceExcludeVat = 0;
        restInput.consignmentDeliveryFeeExcludeVat = 0;
      }

      updateProductVariantVendor({ variables: { input: restInput, id: productVariantVendor?.id } });
    }
  };

  const vendors = maybe(() => searchVendorsOpts.data.search.edges.map((edge) => edge.node), []);
  const existVendorIds = maybe(
    () => productVariant.productVariantVendors.map((variantVendor) => variantVendor.vendor.id),
    []
  );
  const filteredVendors = vendors.filter((vendor) => !existVendorIds.includes(vendor.id));
  const vendorOptions: Array<{ label: string; value: string }> = filteredVendors.map((vendor) => {
    const displayName = makeVendorDisplayName(vendor);
    return { label: displayName, value: vendor.id };
  });

  const variantVendorName = makeVendorDisplayName(productVariantVendor?.vendor);
  const modalTitle = isCreateMode ? "제품 협력사 추가" : `제품 협력사 정보 수정(${variantVendorName})`;
  const modalLoading = loading || createProductVariantVendorOpts.loading || updateProductVariantVendorOpts.loading;

  return (
    <Modal
      forceRender
      maskClosable={false}
      destroyOnClose
      open={open}
      width={750}
      title={modalTitle}
      cancelText="뒤로"
      okText="저장"
      onOk={form.submit}
      okButtonProps={{ loading: modalLoading }}
      onCancel={onClose}
    >
      <Form
        form={form}
