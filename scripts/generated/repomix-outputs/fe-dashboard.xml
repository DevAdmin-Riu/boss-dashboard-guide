function getAttributeValueChoices(id: string, attributes: ProductAttributeInput[]) {
  const attribute = attributes.find((attr) => attr.id === id);
  const noChoiceAvailable = attribute.data.valueRequired === false;
  const choices = noChoiceAvailable ? [{ label: "선택 안함", value: "" }] : [];
  attribute.data.values.forEach((attributeValue) =>
    choices.push({
      label: attributeValue.name,
      value: attributeValue.slug,
    })
  );
  return choices;
}

const getAttributeValue = (attribute: ProductAttributeInput) =>
  attribute.data.inputType === AttributeInputTypeEnum.MULTISELECT ? attribute.value : attribute.value[0];

const makeLabelWithTooltip = (dataKey: keyof Pick<TData, "stockAdjustFactor" | "rop">) => {
  let label: string;
  let tooltipTitle: string | React.ReactNode;
  switch (dataKey) {
    case "stockAdjustFactor":
      label = columnNameConstant.stock.ADJ_FACTOR;
      tooltipTitle = (
        <MultiLineTypography
          lines={[
            // 툴팁 내에서 흰색 글자로 보여야 하기 때문에 별도로 스타일 지정하여 lines에 전달
            <Typography.Text style={{ color: "white" }}>
              • 재발주점 계산식에서 더하기로 이 값만큼 보정됩니다. (-1000 ~ 1000 사이의 값으로 입력해 주세요.)
            </Typography.Text>,
          ]}
        />
      );
      break;
    case "rop":
      label = columnNameConstant.stock.ROP;
      tooltipTitle = "최근 30일 평균 판매량 기준";
      break;
  }

  if (!label || !tooltipTitle) {
    return label;
  }

  return (
    <Tooltip title={tooltipTitle}>
      <Badge size="small" count="?" offset={[10, 0]}>
        {label}
      </Badge>
    </Tooltip>
  );
};

