import filterMsg from "@assets/messages/filters";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum BsOpsCheckTemplateListFilterKeys {
  isVisible = "isVisible",
  titleSearch = "titleSearch",
  brandSearch = "brandSearch",
  created = "created",
  visibleDate = "visibleDate",
}

export interface BsOpsCheckTemplateListFilterOpts {
  isVisible: FilterOpts<boolean>;
  titleSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  created: FilterOpts<MinMax>;
  visibleDate: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: BsOpsCheckTemplateListFilterOpts,
  isStaff: boolean
): IFilter<BsOpsCheckTemplateListFilterKeys> {
  let filterStructure = [];

  const isVisibleFilter = {
    ...createBooleanField(0, BsOpsCheckTemplateListFilterKeys.isVisible, "공개여부", opts.isVisible.value, {
      positive: filterMsg.published,
      negative: filterMsg.hidden,
    }),
    active: opts.isVisible.active,
  };
  const titleSearchFilter = {
    ...createTextField(0, BsOpsCheckTemplateListFilterKeys.titleSearch, "제목", opts.titleSearch.value),
    active: opts.titleSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      0,
      BsOpsCheckTemplateListFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const createdFilter = {
    ...createDateField(0, BsOpsCheckTemplateListFilterKeys.created, "생성일", opts.created.value),
    active: opts.created.active,
  };
  const visibleDateFilter = {
    ...createDateField(0, BsOpsCheckTemplateListFilterKeys.visibleDate, "공개일", opts.visibleDate.value),
    active: opts.visibleDate.active,
  };

  filterStructure = [
    isVisibleFilter,
    titleSearchFilter,
    isStaff && brandSearchFilter,
    createdFilter,
    visibleDateFilter,
  ].filter(Boolean);

  return utils.filterDisplayOrdering(filterStructure);
}
</file>

