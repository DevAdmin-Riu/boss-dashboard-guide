  if (urlType === ReqBossProductUrlEnum.REQUESTED) {
    columns = columns.concat([acceptedStatusAtColumn, reqAdditionalStatusAtColumn]);
  } else if (urlType === ReqBossProductUrlEnum.ESTIMATE) {
    columns = columns.concat([vendorPriceStatusAtColumn, brandPriceStatusAtColumn, reqEstimateFixStatusAtColumn]);
  } else if (urlType === ReqBossProductUrlEnum.CONFIRMED) {
    columns = columns.concat([pendingConfirmedStatusAtColumn, confirmedStatusAtColumn]);
  } else if (urlType === ReqBossProductUrlEnum.COMPLETED) {
    columns = columns.concat([completedStatusAtColumn]);
  } else if (urlType === ReqBossProductUrlEnum.ALL) {
    columns = [
      requestNumberColumn,
      statusColumn,
      { title: "브랜드 정보", children: [brandCodeColumn, brandNameColumn, staffNameColumn] },
