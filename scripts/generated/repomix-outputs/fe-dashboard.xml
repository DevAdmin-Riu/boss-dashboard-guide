<file path="src/app/views/brand/brands/components/BrandGroupCreateOrUpdateModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg, formRuleMsg } from "@assets/messages/commonMsg";
import { SearchBrandsSimple_search_edges_node } from "@src/api/searches/types/SearchBrandsSimple";
import { useBrandsSearchSimple } from "@src/api/searches/useBrandSearch";
import { BrandGroupCreateInput, BrandGroupUpdateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import EditableField from "@src/app/components/EditableField/EditableField";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { StrictOmit } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Form, Input, Modal, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useState } from "react";

import {
  useBrandGroupCreateMutation,
  useBrandGroupUpdateMutation,
  useBulkAssignBrandsToBrandGroupMutation,
  useBulkUnassignBrandsFromBrandGroupMutation,
} from "../api/mutations";
import { brandGroupListQuery } from "../api/queries";
import {
  BrandGroupList_brandGroupList_edges_node,
  BrandGroupList_brandGroupList_edges_node_brands,
} from "../api/types/BrandGroupList";
import { BulkAssignBrandsToBrandGroupVariables } from "../api/types/BulkAssignBrandsToBrandGroup";
import { BulkUnassignBrandsFromBrandGroupVariables } from "../api/types/BulkUnassignBrandsFromBrandGroup";

type TBrandGroupFormData = BrandGroupCreateInput | BrandGroupUpdateInput;
type TBulkAssignBrandsFormData = StrictOmit<BulkAssignBrandsToBrandGroupVariables, "brandGroupId">;
type TBulkUnassignBrandsFormData = StrictOmit<BulkUnassignBrandsFromBrandGroupVariables, "brandGroupId">;

interface CommonProps {
  open: boolean;
  onClose: () => void;
}
interface CreateProps {
  isCreate: true;
}
interface UpdateProps {
  isCreate: false;
  brandGroup: BrandGroupList_brandGroupList_edges_node;
}

type BrandGroupCreateOrUpdateModalProps = CommonProps & (CreateProps | UpdateProps);

export const BrandGroupCreateOrUpdateModal: React.FC<BrandGroupCreateOrUpdateModalProps> = (props) => {
  const { open, isCreate, onClose } = props;
  const [isEditMode, setIsEditMode] = useState(isCreate ? true : false);
  const [brandGroupForm] = Form.useForm<TBrandGroupFormData>();
  const [bulkAssignBrandsForm] = Form.useForm<TBulkAssignBrandsFormData>();
  const [bulkUnassignBrandsForm] = Form.useForm<TBulkUnassignBrandsFormData>();
  const BrandGroupTypeSafeForm = getTypeSafeForm<TBrandGroupFormData>(brandGroupForm);
  const BulkAssignBrandsTypeSafeForm = getTypeSafeForm<TBulkAssignBrandsFormData>(bulkAssignBrandsForm);
  const BulkUnassignBrandsTypeSafeForm = getTypeSafeForm<TBulkUnassignBrandsFormData>(bulkUnassignBrandsForm);

  const isUpdate = isCreate === false;
  const assignedBrandList = maybe(() => (isUpdate ? props.brandGroup.brands : []), []);
  const assignedBrandIdList = assignedBrandList.map((brand) => brand.id);

  const selectedAssignBrandIdWatched = BulkAssignBrandsTypeSafeForm.getUseFormWatched({ name: "brandIds" }) || [];
  const selectedUnassignBrandIdWatched = BulkUnassignBrandsTypeSafeForm.getUseFormWatched({ name: "brandIds" }) || [];

  const makeBrandGroupInitialValues = (): TBrandGroupFormData => {
    if (isUpdate) {
      const { brandGroup } = props;
      if (utils.isEmpty(brandGroup)) {
        return undefined;
      }

      const initialValues: BrandGroupUpdateInput = {
        name: brandGroup.name,
        bizCorpName: brandGroup.bizCorpName,
        bizRegNo: brandGroup.bizRegNo,
      };
      return initialValues;
    }
    return undefined;
  };

  useEffect(() => {
    brandGroupForm.resetFields();
  }, [open, isCreate, isEditMode]);

  const { loadMore, search, result } = useBrandsSearchSimple({
    skip: !open || isCreate,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.brandsForSearch },
  });
  const hasMoreBrands = maybe(() => result.data.search.pageInfo.hasNextPage, false);
  const searchedBrandList = maybe(() => result.data.search.edges.map((edge) => edge.node), []);
  const filteredBrandList = searchedBrandList.filter((brand) => !assignedBrandIdList.includes(brand.id));

  const [brandGroupCreate, brandGroupCreateOpts] = useBrandGroupCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandGroupCreate.errors, "브랜드 그룹이 추가되었습니다.", () => {
        onClose();
      }),
    refetchQueries: [brandGroupListQuery],
  });
  const [brandGroupUpdate, brandGroupUpdateOpts] = useBrandGroupUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandGroupUpdate.errors, commonMsg.savedChanges, () => {
        setIsEditMode(false);
      }),
  });
  const [bulkAssignBrandsToBrandGroup, bulkAssignBrandsToBrandGroupOpts] = useBulkAssignBrandsToBrandGroupMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.bulkAssignBrandsToBrandGroup.errors,
        "선택된 브랜드가 그룹에 연동되었습니다.",
        () => {
          BulkAssignBrandsTypeSafeForm.setFields([{ name: "brandIds", value: [] }]);
        }
      ),
  });
  const [bulkUnassignBrandsFromBrandGroup, bulkUnassignBrandsFromBrandGroupOpts] =
    useBulkUnassignBrandsFromBrandGroupMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.bulkUnassignBrandsFromBrandGroup.errors,
          "선택된 브랜드가 그룹에서 연동 해제되었습니다.",
          () => {
            BulkUnassignBrandsTypeSafeForm.setFields([{ name: "brandIds", value: [] }]);
          }
        ),
    });

  const onBrandGroupSubmit = (formData: TBrandGroupFormData) => {
    if (isCreate) {
      brandGroupCreate({ variables: { input: formData as BrandGroupCreateInput } });
    }
    if (isUpdate) {
      const { brandGroup } = props;
      brandGroupUpdate({ variables: { id: brandGroup.id, input: formData as BrandGroupUpdateInput } });
    }
  };

  const brandColumns: ColumnsType<Pick<BrandGroupList_brandGroupList_edges_node_brands, "id" | "code" | "name">> = [
    {
      title: columnNameConstant.brand.BRAND_CODE,
      key: "code",
      align: "center",
      width: 120,
      render: (_, record) => record.code,
    },
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "name",
      width: 150,
      render: (_, record) => record.name,
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(brandColumns);

  const assignRowSelection: TableRowSelection<BrandGroupList_brandGroupList_edges_node_brands> = {
    fixed: "left",
    selectedRowKeys: selectedAssignBrandIdWatched,
    onChange: (selectedRowKeys) =>
      BulkAssignBrandsTypeSafeForm.setFields([{ name: "brandIds", value: selectedRowKeys as string[] }]),
  };
  const unassignRowSelection: TableRowSelection<SearchBrandsSimple_search_edges_node> = {
    fixed: "left",
    selectedRowKeys: selectedUnassignBrandIdWatched,
    onChange: (selectedRowKeys) =>
      BulkUnassignBrandsTypeSafeForm.setFields([{ name: "brandIds", value: selectedRowKeys as string[] }]),
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      maskClosable={false}
      width={600}
      title={isCreate ? "브랜드 그룹 추가" : "브랜드 그룹 수정"}
      open={open}
      footer={
        <Button type="default" onClick={onClose}>
          닫기
        </Button>
      }
    >
      <Space direction="vertical" size="large">
        <Form
          name="brand-group-create-or-update"
          form={brandGroupForm}
          initialValues={makeBrandGroupInitialValues()}
          onFinish={onBrandGroupSubmit}
          validateMessages={{ required: formRuleMsg.required }}
          labelAlign="left"
          labelCol={{ span: 6 }}
          wrapperCol={{ span: 18 }}
        >
          <Card
            size="small"
            title="그룹 정보"
            extra={
              isCreate ? (
                <Form.Item shouldUpdate noStyle>
                  {() => (
                    <Button
                      type="primary"
                      loading={brandGroupCreateOpts.loading}
                      disabled={!brandGroupForm.isFieldsTouched()}
                      onClick={brandGroupForm.submit}
                    >
                      추가
                    </Button>
                  )}
                </Form.Item>
              ) : (
                <FormSaveButton
                  form={brandGroupForm}
                  loading={brandGroupUpdateOpts.loading}
                  isEditMode={isEditMode}
                  onEdit={() => setIsEditMode(true)}
                  onCancel={() => {
                    setIsEditMode(false);
                  }}
                />
              )
            }
          >
            <EditableField
              type="input"
              bold={false}
              label={columnNameConstant.brand.BRAND_GROUP_NAME}
              name={BrandGroupTypeSafeForm.getValidDataIndex("name")}
              value={makeBrandGroupInitialValues()?.name}
              rules={[{ required: true }]}
              placeholder="브랜드 그룹 이름을 입력해주세요."
              editMode={isEditMode}
            />

            <EditableField
              type="input"
              bold={false}
              label={columnNameConstant.brand.REP_BIZ_CORP_NAME}
              name={BrandGroupTypeSafeForm.getValidDataIndex("bizCorpName")}
              value={makeBrandGroupInitialValues()?.bizCorpName}
              placeholder="대표 상호를 입력해주세요."
              editMode={isEditMode}
            />

            <EditableField
              type="input"
              bold={false}
              label={columnNameConstant.brand.REP_BIZ_REG_NO}
              name={BrandGroupTypeSafeForm.getValidDataIndex("bizRegNo")}
              value={makeBrandGroupInitialValues()?.bizRegNo}
              placeholder="대표 사업자등록번호를 입력해주세요."
              editMode={isEditMode}
            />
          </Card>
        </Form>

        <Card size="small" title="연동 브랜드">
          {isUpdate ? (
            <Space direction="vertical" size="small">
              <Form
                name="bulk-unassign-brands-from-brand-group"
                form={bulkUnassignBrandsForm}
                onFinish={(formData) => {
                  bulkUnassignBrandsFromBrandGroup({ variables: { brandGroupId: props.brandGroup.id, ...formData } });
                }}
              >
                <Form.Item name={BulkUnassignBrandsTypeSafeForm.getValidDataIndex("brandIds")} hidden>
                  <Input />
                </Form.Item>
                <Table<BrandGroupList_brandGroupList_edges_node_brands>
                  {...commonTableProps}
                  title={() => (
                    <Row justify="space-between" align="middle">
                      <Typography.Text>연동된 브랜드 {assignedBrandList.length}개</Typography.Text>
                      <Button
                        danger
                        type="primary"
                        onClick={bulkUnassignBrandsForm.submit}
                        disabled={selectedUnassignBrandIdWatched.length === 0}
                        loading={bulkUnassignBrandsFromBrandGroupOpts.loading}
                      >
                        연동 해제
                      </Button>
                    </Row>
                  )}
                  columns={brandColumns}
                  dataSource={assignedBrandList}
                  rowSelection={unassignRowSelection}
                  scroll={{ x: tableWidthSum, y: 300 }}
                />
              </Form>

              <Form
                name="bulk-assign-brands-to-brand-group"
                form={bulkAssignBrandsForm}
                onFinish={(formData) => {
                  bulkAssignBrandsToBrandGroup({ variables: { brandGroupId: props.brandGroup.id, ...formData } });
                }}
              >
                <Form.Item name={BulkAssignBrandsTypeSafeForm.getValidDataIndex("brandIds")} hidden>
                  <Input />
                </Form.Item>
                <Table<SearchBrandsSimple_search_edges_node>
                  {...commonTableProps}
                  title={() => (
                    <Space direction="vertical" size="small">
                      <Row justify="space-between" align="middle">
                        <Typography.Text>검색된 브랜드(연동된 브랜드 제외)</Typography.Text>
                        <Button
                          type="primary"
                          onClick={bulkAssignBrandsForm.submit}
                          disabled={selectedAssignBrandIdWatched.length === 0}
                          loading={bulkAssignBrandsToBrandGroupOpts.loading}
                        >
                          연동
                        </Button>
                      </Row>
                      <Input.Search enterButton allowClear onSearch={search} placeholder="브랜드 검색" />
                    </Space>
                  )}
                  columns={brandColumns}
                  dataSource={filteredBrandList}
                  rowSelection={assignRowSelection}
                  scroll={{ x: tableWidthSum, y: 300 }}
                  footer={
                    hasMoreBrands &&
                    (() => (
                      <Row justify="center">
                        <Typography.Link onClick={loadMore}>더 보기</Typography.Link>
                      </Row>
                    ))
                  }
                />
              </Form>
            </Space>
          ) : (
            <Typography.Text type="warning">브랜드 그룹 생성 후 브랜드를 연동할 수 있습니다.</Typography.Text>
          )}
        </Card>
      </Space>
    </Modal>
  );
};
</file>

