export const isOrderCanceled = (order: IOrderForPaymentStatus): boolean =>
  // 취소는 전액환불 + 배송대기 조합이거나(고객 주문 취소) order status가 CANCEL 경우
  order.status === OrderStatus.CANCELED ||
  (order.paymentStatus === PaymentChargeStatusEnum.FULLY_REFUNDED && order.status === OrderStatus.UNFULFILLED);

export const makePaymentMethodString = (order: Pick<OrderList_orders_edges_node, "payInfo">): string => {
  const combinePayMethod = [];
  if (order.payInfo.isTossRiuPay) {
    combinePayMethod.push("카드 (보스페이)");
  } else if (order.payInfo.isCardPay) {
    combinePayMethod.push("카드 (일반)");
  } else if (order.payInfo.isVbankPay) {
    combinePayMethod.push("가상계좌");
  } else if (order.payInfo.isDeferredPay) {
    combinePayMethod.push("후불결제");
  }
  if (order.payInfo.isCreditsPay) {
    combinePayMethod.push("충전금");
  }
  if (order.payInfo.isRcoinsPay) {
    combinePayMethod.push("포인트");
  }
  return combinePayMethod.join(" + ");
};

