interface HqTrainingDocListPageProps
  extends PaginateListProps,
    FilterPageProps<TrainingDocListFilterKeys, TrainingDocListFilterOpts> {
  bsTrainingDocList: BsTrainingDocList_bsTrainingDocList_edges_node[];
  user: User;

  queryVariables: BsTrainingDocListVariables;
  queryVariablesWithoutPagination: BsTrainingDocListVariables;
  onTagAdd: () => void;
  onDocDelete: (docId: string) => void;
}

const HqTrainingDocListPage: React.FC<HqTrainingDocListPageProps> = (props) => {
  const {
    bsTrainingDocList,
    user,
    currencySymbol,
    currentTab,
    filterOpts,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    queryVariables,
    queryVariablesWithoutPagination,
    onTagAdd,
    onDocDelete,
    onRowClick,
    ...listProps
  } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const routeParams = useParams<TrainingDocListViewRouteParams>();

  const filterStructure = createFilterStructure(filterOpts, routeParams, user.isStaff);
  const columns = getHqTrainingDocListTableSettings({ onRowClick, isStaff: user.isStaff, onDocDelete });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);

  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  let pageTitle: string = "";
  let addButton: JSX.Element | null = null;
  if (routeParams.menuType === "operation-manual") {
    pageTitle = sectionNames.operationManuals;
    addButton = (
      <Button type="primary" shape="round" onClick={onAdd}>
        매뉴얼 작성
      </Button>
    );
  } else if (routeParams.menuType === "menu-recipe") {
    pageTitle = sectionNames.menuRecipes;
    addButton = (
      <Button type="primary" shape="round" onClick={onAdd}>
        레시피 작성
      </Button>
    );
  }

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
        <Col>
          <Space>
            <Button type="primary" shape="round" onClick={onTagAdd}>
              태그 관리
            </Button>
            {addButton}
          </Space>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={false}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={columns}
          dataSource={bsTrainingDocList}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};

export default HqTrainingDocListPage;
