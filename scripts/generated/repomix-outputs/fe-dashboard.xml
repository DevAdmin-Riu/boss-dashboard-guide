<file path="src/app/views/settings/navigation/views/MenuDetailsView/MenuDetailsView.tsx">
import useNavigator from "@hooks/useNavigator";
import DialogContentText from "@material-ui/core/DialogContentText";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import useCollectionSearch from "@src/api/searches/useCollectionSearch";
import ActionDialog from "@src/app/components/ActionDialog";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { categoryDetailsViewUrl } from "../../../../product/categories/urls";
import { collectionDetailsViewUrl } from "../../../../product/collections/urls";
import { pageDetailsViewUrl } from "../../../pages/urls";
import {
  useMenuDeleteMutation,
  useMenuItemCreateMutation,
  useMenuItemUpdateMutation,
  useMenuUpdateMutation,
} from "../../api/mutations";
import { menuDetailsQuery, useMenuDetailsQuery } from "../../api/queries";
import { MenuItemCreateVariables } from "../../api/types/MenuItemCreate";
import { MenuItemUpdateVariables } from "../../api/types/MenuItemUpdate";
import MenuDetailsPage, { MenuDetailsSubmitData } from "../../components/MenuDetailsPage";
import { findNode, getNode } from "../../components/MenuDetailsPage/tree";
import MenuItemDialog, { MenuItemDialogFormData, MenuItemType } from "../../components/MenuItemDialog";
import { getItemId, getItemType, unknownTypeError } from "../../components/MenuItems";
import { menuDetailsViewUrl, MenuDetailsViewUrlQueryParams, menuListViewUrl } from "../../urls";
import { handleDelete, handleItemCreate, handleItemUpdate, handleUpdate } from "./successHandlers";
import {
  getInitialDisplayValue,
  getMenuItemCreateInputData,
  getMenuItemInputData,
  getMoves,
  getRemoveIds,
} from "./utils";

interface MenuDetailsViewProps {
  id: string;
  params: MenuDetailsViewUrlQueryParams;
}

export const MenuDetailsView: React.FC<MenuDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const categorySearch = useCategorySearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA },
  });
  const collectionSearch = useCollectionSearch({
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA },
  });

  const closeModal = () =>
    navigate(
      menuDetailsViewUrl(id, {
        ...params,
        action: undefined,
        id: undefined,
      }),
      true
    );

  const handleItemClick = (id: string, type: MenuItemType) => {
    switch (type) {
      case "category":
        navigate(categoryDetailsViewUrl(id));
        break;

      case "collection":
        navigate(collectionDetailsViewUrl(id));
        break;

      case "page":
        navigate(pageDetailsViewUrl(id));
        break;

      case "link":
        window.open(id, "blank");
        break;

      default:
        throw unknownTypeError;
    }
  };

  const handleBack = () => navigate(menuListViewUrl());

  const { data, loading } = useMenuDetailsQuery({
    skip: id === undefined,
    variables: {
      id,
    },
  });
  if (data === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }

  const handleQueryChange = (query: string) => {
    categorySearch.search(query);
    collectionSearch.search(query);
  };

  const categories = maybe(() => categorySearch.result.data.search.edges.map((edge) => edge.node), []);

  const collections = maybe(() => collectionSearch.result.data.search.edges.map((edge) => edge.node), []);

  const [menuDelete, menuDeleteOpts] = useMenuDeleteMutation({
    onCompleted: (data) => handleDelete(data, navigate),
  });

  const [menuUpdate, menuUpdateOpts] = useMenuUpdateMutation({
    onCompleted: handleUpdate,
    refetchQueries: [menuDetailsQuery],
  });

  const [menuItemCreate, menuItemCreateOpts] = useMenuItemCreateMutation({
    onCompleted: (data) => handleItemCreate(data, closeModal),
  });

  const [menuItemUpdate, menuItemUpdateOpts] = useMenuItemUpdateMutation({
    onCompleted: (data) => handleItemUpdate(data, id, navigate),
  });

  // This is a workaround to let know <MenuDetailsPage />
  // that it should clean operation stack if mutations
  // were successful
  const handleMenuUpdateSubmit = async (data: MenuDetailsSubmitData) => {
    const result = await menuUpdate({
      variables: {
        id,
        moves: getMoves(data),
        name: data.name,
        removeIds: getRemoveIds(data),
      },
    });

    return [
      ...result.data.menuItemBulkDelete.errors,
      ...result.data.menuItemMove.errors,
      ...result.data.menuUpdate.errors,
    ];
  };

  const handleItemCreateSubmit = (data: MenuItemDialogFormData) => {
    const variables: MenuItemCreateVariables = {
      input: getMenuItemCreateInputData(id, data),
    };

    menuItemCreate({ variables });
  };

  const handleItemUpdateSubmit = (data: MenuItemDialogFormData) => {
    const variables: MenuItemUpdateVariables = {
      id: params.id,
      input: getMenuItemInputData(data),
    };

    menuItemUpdate({ variables });
  };

  const menuItem = maybe(() => getNode(data.menu.items, findNode(data.menu.items, params.id)));

  const initialFormData: MenuItemDialogFormData = {
    id: maybe(() => getItemId(menuItem)),
    name: maybe(() => menuItem.name, "..."),
    type: maybe<MenuItemType>(() => getItemType(menuItem), "category"),
  };

  return (
    <>
      <MenuDetailsPage
        disabled={loading}
        errors={[
          ...(menuUpdateOpts.data?.menuUpdate.errors || []),
          ...(menuUpdateOpts.data?.menuItemMove.errors || []),
          ...(menuUpdateOpts.data?.menuUpdate.errors || []),
        ]}
        menu={maybe(() => data.menu)}
        onBack={() => navigate(menuListViewUrl())}
        onDelete={() =>
          navigate(
            menuDetailsViewUrl(id, {
              action: "remove",
            })
          )
        }
        onItemAdd={() =>
          navigate(
            menuDetailsViewUrl(id, {
              action: "add-item",
            })
          )
        }
        onItemClick={handleItemClick}
        onItemEdit={(itemId) =>
          navigate(
            menuDetailsViewUrl(id, {
              action: "edit-item",
              id: itemId,
            })
          )
        }
        onSubmit={handleMenuUpdateSubmit}
        saveButtonState={menuUpdateOpts.status}
      />
      <ActionDialog
        open={params.action === "remove"}
        onClose={closeModal}
        confirmButtonState={menuDeleteOpts.status}
        onConfirm={() => menuDelete({ variables: { id } })}
        variant="delete"
        title="보스몰 메뉴 삭제"
      >
        <DialogContentText>
          {utils.formatMessage(commonMsg.confirmDelete, {
            name: maybe(() => data.menu.name, "..."),
          })}
        </DialogContentText>
      </ActionDialog>
      <MenuItemDialog
        open={params.action === "add-item"}
        categories={categories}
        collections={collections}
        errors={maybe(() => menuItemCreateOpts.data.menuItemCreate.errors, [])}
        loading={categorySearch.result.loading || collectionSearch.result.loading}
        confirmButtonState={menuItemCreateOpts.status}
        disabled={menuItemCreateOpts.loading}
        onClose={closeModal}
        onSubmit={handleItemCreateSubmit}
        onQueryChange={handleQueryChange}
      />
      <MenuItemDialog
        open={params.action === "edit-item"}
        categories={categories}
        collections={collections}
        errors={maybe(() => menuItemUpdateOpts.data.menuItemUpdate.errors, [])}
        initial={initialFormData}
        initialDisplayValue={getInitialDisplayValue(menuItem)}
        loading={categorySearch.result.loading || collectionSearch.result.loading}
        confirmButtonState={menuItemUpdateOpts.status}
        disabled={menuItemUpdateOpts.loading}
        onClose={closeModal}
        onSubmit={handleItemUpdateSubmit}
        onQueryChange={handleQueryChange}
      />
    </>
  );
};
</file>

<file path="src/app/views/settings/navigation/views/MenuDetailsView/successHandlers.ts">
import { UseNavigatorResult } from "@hooks/useNavigator";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";

import { MenuDelete } from "../../api/types/MenuDelete";
import { MenuItemCreate } from "../../api/types/MenuItemCreate";
import { MenuItemUpdate } from "../../api/types/MenuItemUpdate";
import { MenuUpdate } from "../../api/types/MenuUpdate";
import { menuDetailsViewUrl, menuListViewUrl } from "../../urls";

export function handleItemCreate(data: MenuItemCreate, closeModal: () => void) {
  const errors = data.menuItemCreate.errors;
  if (errors.length === 0) {
    closeModal();
    showNotificationSuccess(commonMsg.savedChanges);
  } else {
    showGqlErrors(errors, makeGqlErrorMsg);
  }
}

export function handleItemUpdate(data: MenuItemUpdate, id: string, navigate: UseNavigatorResult) {
  const errors = data.menuItemUpdate.errors;
  if (errors.length === 0) {
    showNotificationSuccess(commonMsg.savedChanges);
    navigate(
      menuDetailsViewUrl(id, {
        action: undefined,
        id: undefined,
      })
    );
  } else {
    showGqlErrors(errors, makeGqlErrorMsg);
  }
}

export function handleDelete(data: MenuDelete, navigate: UseNavigatorResult) {
  const errors = data.menuDelete.errors;
  if (errors.length === 0) {
    showNotificationSuccess(commonMsg.savedChanges);
    navigate(menuListViewUrl(), true);
  } else {
    showGqlErrors(errors, makeGqlErrorMsg);
  }
}

export function handleUpdate(data: MenuUpdate) {
  if (
    data.menuItemBulkDelete.errors.length === 0 &&
    data.menuItemMove.errors.length === 0 &&
    data.menuUpdate.errors.length === 0
  ) {
    showNotificationSuccess(commonMsg.savedChanges);
  } else {
    {
      const errors = data.menuItemBulkDelete.errors;
      if (errors.length !== 0) {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    }
    {
      const errors = data.menuItemMove.errors;
      if (errors.length !== 0) {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    }
    {
      const errors = data.menuUpdate.errors;
      if (errors.length !== 0) {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    }
  }
}
</file>

<file path="src/app/views/settings/navigation/views/MenuDetailsView/utils.ts">
import { MenuItemCreateInput, MenuItemInput, MenuItemMoveInput } from "@src/api/types/globalTypes";

import { MenuDetails_menu_items } from "../../api/types/MenuDetails";
import { MenuDetailsSubmitData } from "../../components/MenuDetailsPage";
import { MenuItemDialogFormData } from "../../components/MenuItemDialog";
import { unknownTypeError } from "../../components/MenuItems";

export function getMenuItemInputData(data: MenuItemDialogFormData): MenuItemInput {
  const variables: MenuItemInput = {
    name: data.name,
  };
  switch (data.type) {
    case "category":
      variables.category = data.id;
      break;

    case "collection":
      variables.collection = data.id;
      break;

    case "page":
      variables.page = data.id;
      break;

    case "link":
      variables.url = data.id;
      break;

    default:
      throw unknownTypeError;
  }

  return variables;
}

export function getMenuItemCreateInputData(menu: string, data: MenuItemDialogFormData): MenuItemCreateInput {
  const variables: MenuItemCreateInput = {
    menu,
    name: data.name,
  };
  switch (data.type) {
    case "category":
      variables.category = data.id;
      break;

    case "collection":
      variables.collection = data.id;
      break;

    case "page":
      variables.page = data.id;
      break;

    case "link":
      variables.url = data.id;
      break;

    default:
      throw unknownTypeError;
  }

  return variables;
}

export function getInitialDisplayValue(item: MenuDetails_menu_items): string {
  if (!item) {
    return "...";
  }
  if (item.category) {
    return item.category.name;
  } else if (item.collection) {
    return item.collection.name;
  } else if (item.page) {
    return item.page.title;
  } else if (item.url) {
    return item.url;
  } else {
    return "";
  }
}

export function getMoves(data: MenuDetailsSubmitData): MenuItemMoveInput[] {
  return data.operations
    .filter((operation) => operation.type === "move")
    .map((moveOperation) => ({
      itemId: moveOperation.id,
      parentId: moveOperation.parentId,
      move: moveOperation.move,
    }));
}

export function getRemoveIds(data: MenuDetailsSubmitData): string[] {
  return data.operations.filter((operation) => operation.type === "remove").map((operation) => operation.id);
}
</file>

<file path="src/app/views/settings/navigation/views/MenuListView/MenuListView.tsx">
import { buttonText } from "@assets/messages/buttonText";
import useBulkActions from "@hooks/useBulkActions";
import { configurationSectionUrl } from "@src/app/views/settings/configuration";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { ListViews } from "@src/global/core/types/types";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import { Button, Modal } from "antd";
import React from "react";

import { useMenuBulkDeleteMutation, useMenuCreateMutation, useMenuDeleteMutation } from "../../api/mutations";
import { menuListQuery, useMenuListQuery } from "../../api/queries";
import { MenuBulkDelete } from "../../api/types/MenuBulkDelete";
import { MenuCreate } from "../../api/types/MenuCreate";
import { MenuDelete } from "../../api/types/MenuDelete";
import MenuCreateDialog from "../../components/MenuCreateDialog";
import MenuListPage from "../../components/MenuListPage";
import { menuDetailsViewUrl, menuListViewUrl, MenuListViewUrlDialog, MenuListViewUrlQueryParams } from "../../urls";
import { getSortQueryVariables } from "./sort";

interface MenuListViewProps {
  params: MenuListViewUrlQueryParams;
}
export const MenuListView: React.FC<MenuListViewProps> = ({ params }) => {
  const { isSelected, listElements, reset, toggle, toggleAll } = useBulkActions(params?.ids);
  const targetUrl = menuListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MENU_LIST,
  });

  const queryVariables = React.useMemo(
    () => ({
      ...paginationState,
      sort: getSortQueryVariables(params),
    }),
    [params, settings?.rowNumber]
  );
  const { data, loading } = useMenuListQuery({
    variables: queryVariables,
  });

  const handleCreate = (data: MenuCreate) => {
    const errors = data.menuCreate.errors;
    if (errors.length === 0) {
      showNotificationSuccess("보스몰 메뉴가 추가되었습니다.");
      navigate(menuDetailsViewUrl(data.menuCreate.menu.id));
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleBulkDelete = (data: MenuBulkDelete) => {
    const errors = data.menuBulkDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      closeModal();
      reset();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleDelete = (data: MenuDelete) => {
    const errors = data.menuDelete.errors;
    if (errors.length === 0) {
      showNotificationSuccess("보스몰 메뉴가 삭제되었습니다.");
      closeModal();
      // 선택된 메뉴가 삭제되었으므로 선택된 메뉴를 초기화 - reset 하지 않으면 listElements에 삭제된 메뉴가 남아있어서 이후 bulkACtion 에서 이슈 발생함
      reset();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.menus?.pageInfo,
    paginationState,
    params,
  });

  const [openModal, closeModal] = createDialogActionHandlers<MenuListViewUrlDialog, MenuListViewUrlQueryParams>(
    navigate,
    targetUrl,
    params
  );

  const handleSort = createSortHandler(navigate, menuListViewUrl, params);

  const [menuCreate, menuCreateOpts] = useMenuCreateMutation({
    onCompleted: handleCreate,
  });
  const [menuDelete, menuDeleteOpts] = useMenuDeleteMutation({
    onCompleted: handleDelete,
    refetchQueries: [menuListQuery],
  });
  const [bulkMenuDelete, bulkMenuDeleteOpts] = useMenuBulkDeleteMutation({
    onCompleted: handleBulkDelete,
    refetchQueries: [menuListQuery],
  });

  return (
    <>
      <MenuListPage
        disabled={loading || bulkMenuDeleteOpts.loading || menuCreateOpts.loading || menuDeleteOpts.loading}
        menus={maybe(() => data.menus.edges.map((edge) => edge.node))}
        settings={settings}
        onAdd={() => navigate(menuListViewUrl({ action: "add" }))}
        onBack={() => navigate(configurationSectionUrl)}
        onDelete={(id) => menuDelete({ variables: { id } })}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onRowClick={(id) => navigate(menuDetailsViewUrl(id))}
        onSort={handleSort}
        pageInfo={pageInfo}
        selectedRowKeys={listElements}
        isChecked={isSelected}
        selected={listElements.length}
        sort={getSortParams(params)}
        toggle={toggle}
        toggleAll={toggleAll}
        toolbar={
          <Button
            danger
            type="primary"
            shape="round"
            disabled={listElements.length === 0}
            onClick={() => openModal("remove-many", { ids: listElements })}
          >
            일괄 {buttonText.remove}
          </Button>
        }
      />
      <MenuCreateDialog
        open={params.action === "add"}
        disabled={menuCreateOpts.loading}
        onSubmit={(input) => menuCreate({ variables: { input } })}
        onClose={closeModal}
      />
      <Modal
        title="보스몰 메뉴 삭제"
        open={params.action === "remove-many" && maybe(() => params?.ids?.length > 0)}
        onOk={() => bulkMenuDelete({ variables: { ids: params?.ids } })}
        okButtonProps={{ danger: true, loading: bulkMenuDeleteOpts.loading }}
        onCancel={closeModal}
      >
        {params?.ids?.length}개의 보스몰 메뉴를 삭제하시겠습니까?
      </Modal>
    </>
  );
};
</file>

