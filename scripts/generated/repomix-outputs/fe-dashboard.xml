import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { FilterPageProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Table, Typography } from "antd";
import React, { useEffect, useState } from "react";

import {
  HqPreFounderStatList,
  HqPreFounderStatList_preFounderStatsByField,
  HqPreFounderStatListVariables,
} from "../../api/types/HqPreFounderStatList";
import { createFilterStructure, HqPreFounderStatListFilterKeys, HqPreFounderStatListFilterOpts } from "./filters";
import { getHqPreFounderStatListTableSettings } from "./HqPreFounderStatListTableSettings";
import { getPreFounderStatFieldValueList } from "./utils";

export interface HqPreFounderStatListPageProps
  extends FilterPageProps<HqPreFounderStatListFilterKeys, HqPreFounderStatListFilterOpts> {
  shop: ShopInfo_shop;
  preFounderStatList: HqPreFounderStatList_preFounderStatsByField[];
  loading: boolean;

  queryVariables: HqPreFounderStatListVariables;
  fetchForDownload: (variables?: HqPreFounderStatListVariables) => Promise<ApolloQueryResult<HqPreFounderStatList>>;
}

export const HqPreFounderStatListPage: React.FC<HqPreFounderStatListPageProps> = (props) => {
  const {
    shop,
    preFounderStatList,
    loading,
    currencySymbol,
    currentTab,
    filterOpts,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    queryVariables,
    fetchForDownload,
  } = props;
  const [dataSource, setDataSource] = useState<HqPreFounderStatList_preFounderStatsByField[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);
  const columns = getHqPreFounderStatListTableSettings(props);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const makeNewDataSource = (
    statList: HqPreFounderStatList_preFounderStatsByField[]
  ): HqPreFounderStatList_preFounderStatsByField[] => {
    const targetFieldValueList = getPreFounderStatFieldValueList(queryVariables.dimension, shop);

    if (utils.isEmpty(targetFieldValueList)) {
      return [];
    }
    const newDataSource = targetFieldValueList.map<HqPreFounderStatList_preFounderStatsByField>((fieldValue) => {
      const existingStat = statList.find((item) => item.fieldValue === fieldValue);
      if (existingStat) {
        return existingStat;
      } else {
        return { fieldValue, counts: [], __typename: "PreFounderStatByField" };
      }
    });
    return newDataSource;
  };

  useEffect(() => {
    const newDataSource = makeNewDataSource(preFounderStatList);
    setDataSource(newDataSource);
  }, [loading]);

  const pageTitle = <Typography.Title level={4}>{sectionNames.preFounderStatList}</Typography.Title>;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination: queryVariables,
    columnsForDownload: columns,
    processNodesToDataType: (nodes) => makeNewDataSource(nodes),
    dataKey: "preFounderStatsByField",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>{pageTitle}</Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <Table<HqPreFounderStatList_preFounderStatsByField>
          {...commonTableProps}
          ref={tableRef}
          rowKey={(record) => record.fieldValue}
          loading={loading}
          columns={columns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
        />
      </Card>
    </Space>
  );
};
</file>

