<file path="src/app/views/requestProduct/components/ReqBossProductChangeStatusModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { RequestBossProductChangeStatusInput, RequestBossProductStatusEnum } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Form, Input, Modal, Typography } from "antd";
import { Rule } from "antd/lib/form";
import React, { useEffect } from "react";

type TFormData = StrictOmit<RequestBossProductChangeStatusInput, "afterStatus">;

interface ReqBossProductChangeStatusModalProps {
  open: boolean;
  loading: boolean;
  afterStatus: RequestBossProductStatusEnum;
  onStatusChange: (input: RequestBossProductChangeStatusInput) => void;
  onClose: () => void;
}

export const ReqBossProductChangeStatusModal: React.FC<ReqBossProductChangeStatusModalProps> = (props) => {
  const { open, loading, afterStatus, onStatusChange, onClose } = props;
  const [form] = Form.useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const onModalClose = () => {
    form.resetFields();
    onClose();
  };

  const initialValues: TFormData = { reason: undefined };

  let modalTitle: string = null;
  let modalContent: string = null;
  let okButtonText: string = null;
  let okButtonDanger: boolean = false;
  let reasonLabel: string = null;
  let reasonRules: Rule[] = [];
  switch (afterStatus) {
    case RequestBossProductStatusEnum.ACCEPTED:
      modalTitle = "MD 수정 요청";
      okButtonText = "MD 수정 요청";
      okButtonDanger = true;
      reasonLabel = "MD 수정 요청 내용";
      reasonRules = [{ required: true, type: "string", min: 10, message: formRuleMsg.min(10, "자") }];
      break;
    case RequestBossProductStatusEnum.REQ_ADDITIONAL:
      modalTitle = "보완 요청";
      okButtonText = "보완 요청";
      okButtonDanger = true;
      reasonLabel = "보완 요청 내용";
      reasonRules = [{ required: true, type: "string", min: 10, message: formRuleMsg.min(10, "자") }];
      break;
    case RequestBossProductStatusEnum.REQ_ESTIMATE_FIX:
      modalTitle = "견적 수정 요청";
      okButtonText = "수정 요청";
      okButtonDanger = true;
      reasonLabel = "수정 요청 내용";
      reasonRules = [{ required: true, message: formRuleMsg.required }];
      break;
    case RequestBossProductStatusEnum.CANCELED:
      modalTitle = "요청 중단";
      okButtonText = "중단";
      okButtonDanger = true;
      modalContent = "요청을 중단하시겠습니까?";
      break;
    case RequestBossProductStatusEnum.COMPLETED:
      modalTitle = "요청 등록 완료";
      okButtonText = "등록 완료";
      modalContent = "요청을 등록 완료하시겠습니까?";
      break;
    default:
      break;
  }

  useEffect(() => {
    form.resetFields();
  }, [open]);

  const onSubmit = (formData: TFormData) => {
    const { reason, ...restFormData } = formData;
    if (utils.isEmpty(reasonLabel, true)) {
      onStatusChange({ ...restFormData, afterStatus });
    } else {
      onStatusChange({ ...formData, afterStatus });
    }
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title={modalTitle}
      open={open}
      onOk={form.submit}
      okText={okButtonText}
      okButtonProps={{ loading, danger: okButtonDanger, type: "primary" }}
      onCancel={onModalClose}
      maskClosable={false}
    >
      {!!modalContent && <Typography>{modalContent}</Typography>}
      <Form form={form} layout="vertical" initialValues={initialValues} onFinish={onSubmit}>
        <Form.Item
          hidden={utils.isEmpty(reasonLabel, true)}
          name={TypeSafeForm.getValidDataIndex("reason")}
          label={reasonLabel}
          rules={reasonRules}
        >
          <Input.TextArea placeholder="내용을 입력해주세요." />
        </Form.Item>
      </Form>
    </Modal>
  );
};
</file>

