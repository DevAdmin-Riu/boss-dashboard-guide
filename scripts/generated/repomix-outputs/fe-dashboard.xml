      value: maybe(() => filterVariables.brandSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
  };
}

export function getFilterVariables(
  params: BrandVacsFeeEventListViewUrlFilters,
  user: User
): BrandVacsFeeEventFilterInput {
  const isHqStaff = checkHqStaff(user);
  return {
    created: getGteLteVariables({ gte: params.createdFrom, lte: params.createdTo }),
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    brand: isHqStaff ? user.brand.id : null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<BrandVacsFeeEventFilterKeys>
): BrandVacsFeeEventListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case BrandVacsFeeEventFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        BrandVacsFeeEventListViewUrlFiltersEnum.createdFrom,
        BrandVacsFeeEventListViewUrlFiltersEnum.createdTo
      );
    case BrandVacsFeeEventFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandVacsFeeEventListViewUrlFiltersEnum.brandSearch);
    case BrandVacsFeeEventFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, BrandVacsFeeEventListViewUrlFiltersEnum.userSearch);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<BrandVacsFeeEventListViewUrlFilters>(BRAND_VACS_FEE_EVENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  BrandVacsFeeEventListViewUrlQueryParams,
  BrandVacsFeeEventListViewUrlFilters
>({ ...BrandVacsFeeEventListViewUrlFiltersEnum });
</file>

