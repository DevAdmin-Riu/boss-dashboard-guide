  calcTableColsWidthSum: (cols: ColumnsType<any>): number => {
    const defaultWidth = 100;
    const widthSum = cols?.reduce((acc, cur) => {
      if (!cur) {
        return acc;
      }
      const hasChildren = "children" in cur;
      if (hasChildren) {
        const children = cur?.children;
        const widthSum = utils.calcTableColsWidthSum(children);
        return acc + widthSum;
      }
      const invalidCur = utils.isEmpty(cur) || utils.isEmpty(cur?.width);
      if (invalidCur) {
        return acc + defaultWidth;
      }
      const width = typeof cur.width === "string" ? parseInt(cur.width, 10) : cur.width;
      return acc + width;
    }, 0);
    return widthSum;
  },
  isDivisible: (dividend: number, divisor: number): boolean => {
    const EPSILON = 1e-10; // 부동소수점 허용 오차
    if (divisor === 0) {
      throw new Error("0으로 나눌 수 없습니다.");
    }
    return Math.abs(dividend % divisor) < EPSILON;
  },

  checkLoginId: (str) => {
