<file path="src/app/views/stats/components/SalesStatDiffListPage/filters.ts">
import { BrandContractTypeEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

import { brandContractTypeChoices } from "../../utils";

export enum SalesStatDiffFilterKeys {
  statDateA = "statDateA",
  statDateB = "statDateB",
  brandSearch = "brandSearch",
  includeBossMrkt = "includeBossMrkt",
  isRunning = "isRunning",
  contractType = "contractType",
}

export interface SalesStatDiffListFilterOpts {
  statDateA: FilterOpts<MinMax>;
  statDateB: FilterOpts<MinMax>;
  includeBossMrkt: FilterOpts<boolean>;
  isRunning: FilterOpts<boolean>;
  brandSearch: FilterOpts<string>;
  contractType: FilterOpts<BrandContractTypeEnum[]>;
}

export function createFilterStructure(opts: SalesStatDiffListFilterOpts): IFilter<SalesStatDiffFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createDateField(displayOrder++, SalesStatDiffFilterKeys.statDateA, "기준 기간(A)", opts.statDateA.value),
      active: opts.statDateA.active,
      isRequired: true,
    },
    {
      ...createDateField(displayOrder++, SalesStatDiffFilterKeys.statDateB, "비교 기간(B)", opts.statDateB.value),
      active: opts.statDateB.active,
      isRequired: true,
    },
    {
      ...createBooleanField(
        displayOrder++,
        SalesStatDiffFilterKeys.includeBossMrkt,
        filterNameConstant.INCLUDE_BOSS_MRKT,
        opts.includeBossMrkt.value,
        {
          negative: "미포함",
          positive: "포함",
        }
      ),
      active: opts.includeBossMrkt.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatDiffFilterKeys.contractType,
        "계약방식",
        opts.contractType.value,
        true,
        brandContractTypeChoices
      ),
      active: opts.contractType.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatDiffFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createBooleanField(displayOrder++, SalesStatDiffFilterKeys.isRunning, "계약상태", opts.isRunning.value, {
        negative: "종결",
        positive: "운영",
      }),
      active: opts.isRunning.active,
    },
  ];
}
</file>

<file path="src/app/views/stats/components/SalesStatDiffListPage/SalesStatDiffListPage.tsx">
import { DownloadOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonMsg } from "@assets/messages/commonMsg";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { DateRangeInput } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { useBrandListForSalesStatsLazyQuery } from "@src/app/views/brand/brands/api/queries";
import { BrandListForSalesStats_brands_edges_node } from "@src/app/views/brand/brands/api/types/BrandListForSalesStats";
import { FilterPageProps, ListSettings } from "@src/global/core/types/types";
import { excelDownload, generateExcelDownloadData } from "@utils/excel/excelDownload";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationError,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { useSalesStatListLazyQuery } from "../../api/queries";
import { SalesStatList_salesStats, SalesStatListVariables } from "../../api/types/SalesStatList";
import { SalesStatDiffListViewUrlQueryParams } from "../../urls";
import { getSalesStatsDiff, getSalesStatsSum } from "../../utils";
import { SalesStatDiffListFilterVariables } from "../../views/SalesStatDiffListView/filters";
import { createFilterStructure, SalesStatDiffFilterKeys, SalesStatDiffListFilterOpts } from "./filters";
import { getSalesStatDiffListTableSettings, getSalesStatDiffSummary } from "./SalesStatDiffListTableSettings";

export interface SalesStatDiffListVariables {
  brandSearch?: string | null;
  statDateA: DateRangeInput;
  statDateB: DateRangeInput;
  includeBossMrkt: boolean;
  isRunning?: boolean;
}

export interface SalesStatDiffListPageProps
  extends FilterPageProps<SalesStatDiffFilterKeys, SalesStatDiffListFilterOpts> {
  params: SalesStatDiffListViewUrlQueryParams;
  filterVariables: SalesStatDiffListFilterVariables;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  settings: ListSettings<string>;
}

export interface SalesStatDiffDataSourceProps {
  brand: BrandListForSalesStats_brands_edges_node;
  stats: {
    totalA: SalesStatList_salesStats;
    totalB: SalesStatList_salesStats;
    diff: SalesStatList_salesStats;
  };
}

export const SalesStatDiffListPage: React.FC<SalesStatDiffListPageProps> = (props) => {
  const {
    params,
    filterVariables,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);
  const [dataSource, setDataSource] = useState<SalesStatDiffDataSourceProps[]>([]);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [brandListRefetch, { loading: brandListLoading }] = useBrandListForSalesStatsLazyQuery();
  const [salesStatListFetch, { loading: salesStatListLoading }] = useSalesStatListLazyQuery();
  const tableLoading = brandListLoading || salesStatListLoading;

  useEffect(() => {
    const refetchDataSource = async () => {
      const { includeBossMrkt, isRunning, contractType } = filterVariables;
      const { data: brandListData } = await brandListRefetch({
        variables: {
          filter: { brandSearch: params.brandSearch, isRunning, contractType },
          first: GrapheneRelayConnectionMaxLimitEnum.brands,
        },
      });
      const brandList = brandListData.brands.edges.map((edge) => edge.node);

      const commonVariables: SalesStatListVariables = {
        brandSearch: params.brandSearch,
        columns: { total: true },
        statDate: null,
        includeBossMrkt,
        isRunning,
      };
      const { statDateA, statDateB } = filterVariables;

      const salesStatDiffListVariablesA: SalesStatListVariables = { ...commonVariables, statDate: statDateA };
      const salesStatDiffListVariablesB: SalesStatListVariables = { ...commonVariables, statDate: statDateB };
      const [{ data: salesStatListDataA }, { data: salesStatListDataB }] = await Promise.all([
        salesStatListFetch({ variables: salesStatDiffListVariablesA }),
        salesStatListFetch({ variables: salesStatDiffListVariablesB }),
      ]);
      const salesStatListA = salesStatListDataA.salesStats;
      const salesStatListB = salesStatListDataB.salesStats;

      const newDataSource = brandList.map((brand) => {
        const salesStatsA: SalesStatList_salesStats[] = salesStatListA.filter(
          (stat) => stat.brandGlobalId === brand.id
        );
        const totalA = getSalesStatsSum(salesStatsA);

        const salesStatsB: SalesStatList_salesStats[] = salesStatListB.filter(
          (stat) => stat.brandGlobalId === brand.id
        );
        const totalB = getSalesStatsSum(salesStatsB);
        const diff = getSalesStatsDiff(totalA, totalB);

        const dataToAdd: SalesStatDiffDataSourceProps = { brand, stats: { totalA, totalB, diff } };
        return dataToAdd;
      });
      setDataSource(newDataSource);
    };

    refetchDataSource();
  }, [params]);

  const onPrintClick = () => {
    setPrintBtnLoading(true);
    showDownloadingMessage();

    try {
      const { header, merges, excelColumns } = generateExcelDownloadData<SalesStatDiffDataSourceProps>(
        columns,
        dataSource
      );
      if (!columns || columns.length <= 0) {
        showNotificationWarn("출력할 데이터가 없습니다.");
        return;
      }
      excelDownload({ title: "실적 비교 내역", columns: excelColumns, header, merges, skipOriginHeader: true });
      showNotificationSuccess(commonMsg.downloadedToXls);
    } catch {
      showNotificationError("에러가 발생하였습니다");
    } finally {
      setPrintBtnLoading(false);
      destroyDownloadingMessage();
    }
  };

  const makeExtraUi = () => (
    <Space>
      <Button
        type="primary"
        shape="round"
        icon={<DownloadOutlined />}
        disabled={tableLoading || printBtnLoading}
        loading={printBtnLoading}
        onClick={onPrintClick}
      >
        실적 비교 내역 다운로드
      </Button>
    </Space>
  );

  const columns = getSalesStatDiffListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const columnKeyList = pickerSelectedColumns.map((item) => item.key).filter((item) => item);

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.salesStatsDiffByPeriod}</Typography.Title>
          </Col>
          <Col>{makeExtraUi()}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={tableLoading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={tableLoading}
            rowKey={(record) => record.brand.id}
            columns={pickerSelectedColumns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            summary={(tableData) => getSalesStatDiffSummary(tableData, columnKeyList)}
          />
        </Card>
      </Space>
    </>
  );
};
</file>

<file path="src/app/views/stats/components/SalesStatDiffListPage/SalesStatDiffListTableSettings.tsx">
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { Typography } from "antd";
import Table from "antd/lib/table";
import moment from "moment";
import React from "react";

import { ExtendedSalesStatList_salesStats, getSalesStatsSum, TSalesStatCategory } from "../../utils";
import {
  getSummaryTotalElement,
  makeSalesStatBrandColumns,
  makeSalesStatsColumns,
} from "../SalesStatListPage/SalesStatListTableSettings";
import { SalesStatDiffDataSourceProps, SalesStatDiffListPageProps } from "./SalesStatDiffListPage";

const { Text } = Typography;

export const getColumnCnt = (columnList: string[], allColumnList: string[]) =>
  columnList.reduce((acc, cur) => {
    allColumnList.includes(cur) ? acc++ : acc;
    return acc;
  }, 0);

const createGetStatFromRecordFunc =
  (type: TSalesStatCategory) =>
  (record: SalesStatDiffDataSourceProps): ExtendedSalesStatList_salesStats => {
    const stat = record.stats[type];
    if (!stat) {
      return null;
    }
    return {
      ...stat,
      brandContractType: record.brand?.contractType,
    };
  };

export const getSalesStatDiffListTableSettings = (props: SalesStatDiffListPageProps) => {
  const { statDateA, statDateB } = props?.filterVariables;
  const dateAFromStr = moment(statDateA.gte).format(onlyDateFormat);
  const dateAToStr = moment(statDateA.lte).format(onlyDateFormat);
  const dateBFromStr = moment(statDateB.gte).format(onlyDateFormat);
  const dateBToStr = moment(statDateB.lte).format(onlyDateFormat);

  const columns: DownloadableColumnsType<SalesStatDiffDataSourceProps> = makeSalesStatBrandColumns();
  columns.push({
    title: `${dateAFromStr}~${dateAToStr}(A)`,
    children: makeSalesStatsColumns<SalesStatDiffDataSourceProps>(createGetStatFromRecordFunc("totalA")),
  });
  columns.push({
    title: `${dateBFromStr}~${dateBToStr}(B)`,
    children: makeSalesStatsColumns<SalesStatDiffDataSourceProps>(createGetStatFromRecordFunc("totalB")),
  });
  columns.push({
    title: "비교(A-B)",
    children: makeSalesStatsColumns<SalesStatDiffDataSourceProps>(createGetStatFromRecordFunc("diff")),
  });

  return columns;
};

export const getSalesStatDiffSummary = (tableData: readonly SalesStatDiffDataSourceProps[], columnKeyList: any[]) => {
  const totalAStatList = tableData.map((data) => ({
    ...data.stats.totalA,
    brandContractType: data.brand?.contractType,
  }));
  const totalBStatList = tableData.map((data) => ({
    ...data.stats.totalB,
    brandContractType: data.brand?.contractType,
  }));
  const diffStatList = tableData.map((data) => ({
    ...data.stats.diff,
    brandContractType: data.brand?.contractType,
  }));

  const totalAStatSum = getSalesStatsSum(totalAStatList);
  const totalBStatSum = getSalesStatsSum(totalBStatList);
  const diffStatSum = getSalesStatsSum(diffStatList);

  const fixedBrandColumnCnt = getColumnCnt(["code", "name", "bizRegNo", "bizName"], columnKeyList);
  const restBrandColumnCnt = getColumnCnt(
    ["contractType", "isRunning", "contractPeriod", "initialDistanceDate", "brandStaffName"],
    columnKeyList
  );
  const summaryColumnCnt = 8;
  return (
    <Table.Summary fixed>
      <Table.Summary.Row>
        <Table.Summary.Cell index={0} colSpan={fixedBrandColumnCnt} align="center">
          <Text strong>합계</Text>
        </Table.Summary.Cell>
        <Table.Summary.Cell index={fixedBrandColumnCnt} colSpan={restBrandColumnCnt} />
        {getSummaryTotalElement(totalAStatSum, "SumTotalA", 8)}
        {getSummaryTotalElement(totalBStatSum, "SumTotalB", 8 + summaryColumnCnt)}
        {getSummaryTotalElement(diffStatSum, "SumDiff", 8 + summaryColumnCnt * 2)}
      </Table.Summary.Row>
    </Table.Summary>
  );
};
</file>

