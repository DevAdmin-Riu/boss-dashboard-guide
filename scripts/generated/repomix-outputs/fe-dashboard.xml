import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React from "react";

import { AttributeList_attributes_edges_node } from "../../api/types/AttributeList";
import { getAttributaeListTableSettings } from "./AttributeListTableSettings";
import { AttributeFilterKeys, AttributeListFilterOpts, createFilterStructure } from "./filters";
import { createSorterStructure } from "./sorters";

export interface AttributeListPageProps
  extends PaginateListProps,
    FilterPageProps<AttributeFilterKeys, AttributeListFilterOpts>,
    SortPage<AttributeListViewUrlSortField> {
  attributes: AttributeList_attributes_edges_node[];
  onBack: () => void;
}

const AttributeListPage: React.FC<AttributeListPageProps> = (props) => {
  const {
    attributes,
    currencySymbol,
    filterOpts,
    onAdd,
    onBack,
    onFilterChange,
    currentTab,
    onAll,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const sorterStructure = createSorterStructure();
  const columns = getAttributaeListTableSettings(props);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.configuration}</AppHeader>

      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.attributes}</Typography.Title>
          </Col>
          <Col>
            <Button type="primary" shape="round" onClick={onAdd}>
              속성 추가
            </Button>
          </Col>
        </Row>

        <Card>
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            filterStructure={filterStructure}
            tabs={tabs}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabExtra={
              <SorterDropdown sorterStructure={sorterStructure} sort={listProps.sort} onSort={listProps.onSort} />
            }
          />
          <Table
            bordered
            size="small"
            loading={listProps.disabled}
            rowKey={(record) => record.id}
            dataSource={attributes}
            columns={columns}
            scroll={{ x: tableWidthSum, y: 500 }}
            sticky={{ offsetHeader: 80, offsetScroll: 20 }}
            footer={() => <TableListFooter {...listProps} />}
            pagination={false}
          />
        </Card>
      </Space>
    </>
  );
};
export default AttributeListPage;
</file>

