import { CloseOutlined } from "@ant-design/icons";
import { User } from "@src/api/fragments/types/User";
import { getDescriptionsClassName } from "@src/app/components/antd/Descriptions/DescriptionsProps";
import { detailDateFormatWithHourMinute, getDateRangeByFormat } from "@src/app/providers/DateProvider";
import { Button, Descriptions, Row, Space, Tag, Typography } from "antd";
