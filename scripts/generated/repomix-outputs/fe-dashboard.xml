  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { PurchaseFilterKeys, PurchaseListFilterOpts } from "../../components/PurchaseListPage/filters";
import {
  PurchaseListViewRouteParams,
  PurchaseListViewUrlFilters,
  PurchaseListViewUrlFiltersEnum,
  PurchaseListViewUrlFiltersWithMultipleValues,
