<file path="src/app/views/product/categories/api/queries.ts">
import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { categoryDetailsFragment, categoryFragment } from "@src/api/fragments/categories";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import gql from "graphql-tag";

import { Categories, CategoriesVariables } from "./types/Categories";
import { CategoryDetails, CategoryDetailsVariables } from "./types/CategoryDetails";
import { RootCategories, RootCategoriesVariables } from "./types/RootCategories";

export const rootCategoriesQuery = gql`
  ${categoryFragment}
  ${pageInfoFragment}
  query RootCategories(
    $first: Int
    $after: String
    $last: Int
    $before: String
    $filter: CategoryFilterInput
    $sort: CategorySortingInput
  ) {
    categories(level: 0, first: $first, after: $after, last: $last, before: $before, filter: $filter, sortBy: $sort) {
      edges {
        node {
          ...CategoryFragment
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;
export const useRootCategoriesQuery = makeQuery<RootCategories, RootCategoriesVariables>(rootCategoriesQuery);

export const useRootCategoriesFilterDownloadQuery = makeLazyQuery<RootCategories, RootCategoriesVariables>(
  rootCategoriesQuery,
  "no-cache"
);

export const categoryDetailsQuery = gql`
  ${categoryFragment}
  ${categoryDetailsFragment}
  ${pageInfoFragment}
  query CategoryDetails($id: ID!, $first: Int, $after: String, $last: Int, $before: String) {
    category(id: $id) {
      ...CategoryDetailsFragment
      children(first: $first, after: $after, last: $last, before: $before) {
        edges {
          node {
            ...CategoryFragment
          }
        }
        pageInfo {
          ...PageInfoFragment
        }
      }
      products(first: $first, after: $after, last: $last, before: $before) {
        pageInfo {
          ...PageInfoFragment
        }
        edges {
          cursor
          node {
            id
            name
            productType {
              id
              name
            }
          }
        }
      }
    }
  }
`;
export const useCategoryDetailsQuery = makeQuery<CategoryDetails, CategoryDetailsVariables>(categoryDetailsQuery);

export const categoriesQuery = gql`
  ${pageInfoFragment}
  query Categories($after: String, $first: Int!, $level: Int, $filter: CategoryFilterInput) {
    categories(after: $after, first: $first, level: $level, filter: $filter) {
      edges {
        node {
          id
          name
          type
          parent {
            id
            name
          }
        }
      }
      pageInfo {
        ...PageInfoFragment
      }
    }
  }
`;

export const useCategoriesQuery = makeQuery<Categories, CategoriesVariables>(categoriesQuery, "cache-first");
</file>

