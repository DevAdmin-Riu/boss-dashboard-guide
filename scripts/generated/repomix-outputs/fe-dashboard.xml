  deliveredStatusAt: FilterOpts<MinMax>;
  stockedStatusAt: FilterOpts<MinMax>;
  canceledStatusAt: FilterOpts<MinMax>;
}

export function createFilterStructure(
  opts: VsPurchaseOrderLineListFilterOpts,
  routeParams: PurchaseOrderLineListViewRouteParams,
  isB2b: boolean = false
): IFilter<VsPurchaseOrderLineFilterKeys> {
  let displayOrder = 0;
  const { status } = routeParams;

  // 발주서 번호
  const purchaseOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.purchaseOrderSearch,
      "발주서번호",
      opts.purchaseOrderSearch.value
    ),
    active: opts.purchaseOrderSearch.active,
  };

  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };

  // 발주일
  const purchaseOrderDateFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.purchaseOrderDate,
      filterMsg.purchaseOrderDate,
      opts.purchaseOrderDate.value
    ),
    active: opts.purchaseOrderDate.active,
  };

  // 발주 제품 납품 요청일
  const askingPurchaseDateFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.askingPurchaseDate,
      filterMsg.poLineAskingPurchaseDate,
      opts.askingPurchaseDate.value
    ),
    active: opts.askingPurchaseDate.active,
  };

  const eventTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.eventType,
      filterMsg.purchaseOrderEventType,
      opts.eventType.value,
      true,
      purchaseOrderLineEventTypeEnumChoices(isB2b).filter((status) =>
        getPoEventTypeFromPoLineRouteParams(routeParams).includes(status.value)
      )
    ),
    active: opts.eventType.active,
    isRequired: true,
  };

  const expectedPurchaseDateFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.expectedPurchaseDate,
      filterMsg.poLineExpectedPurchaseDate,
      opts.expectedPurchaseDate.value
    ),
    active: opts.expectedPurchaseDate.active,
  };

  const draftStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.draftStatusAt,
      "발주 작성일",
      opts.draftStatusAt.value
    ),
    active: opts.draftStatusAt.active,
  };
  const pendingStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.pendingStatusAt,
      "접수 대기일",
      opts.pendingStatusAt.value
    ),
    active: opts.pendingStatusAt.active,
  };
  const rejectedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.rejectedStatusAt,
      "거부일",
      opts.rejectedStatusAt.value
    ),
    active: opts.rejectedStatusAt.active,
  };
  const receivedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.receivedStatusAt,
      "접수일",
      opts.receivedStatusAt.value
    ),
    active: opts.receivedStatusAt.active,
  };
  const reqSplitDeliveryStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.reqSplitDeliveryStatusAt,
      "분할납품 요청일",
      opts.reqSplitDeliveryStatusAt.value
    ),
    active: opts.reqSplitDeliveryStatusAt.active,
  };
  const reqEpdUpdateStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.reqEpdUpdateStatusAt,
      "납품예정일 변경 요청일",
      opts.reqEpdUpdateStatusAt.value
    ),
    active: opts.reqEpdUpdateStatusAt.active,
  };
  const dispatchFulfillmentStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.dispatchFulfillmentStatusAt,
      "출고지시일",
      opts.dispatchFulfillmentStatusAt.value
    ),
    active: opts.dispatchFulfillmentStatusAt.active,
  };

  const deliveryConfirmedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.deliveryConfirmedStatusAt,
      "배송확정일",
      opts.deliveryConfirmedStatusAt.value
    ),
    active: opts.deliveryConfirmedStatusAt.active,
  };
  const invoicePrintedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.invoicePrintedStatusAt,
      "거래명세서 출력일",
      opts.invoicePrintedStatusAt.value
    ),
    active: opts.invoicePrintedStatusAt.active,
  };
  const stockedStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.stockedStatusAt,
      "입고일",
      opts.stockedStatusAt.value
    ),
    active: opts.stockedStatusAt.active,
  };
  const deliveredStatusAtFilter = {
    ...createDateField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.deliveredStatusAt,
      "배송 완료일",
      opts.deliveredStatusAt.value
    ),
    active: opts.deliveredStatusAt.active,
  };

  const poLineStatusEnumChoices = purchaseOrderLineStatusEnumChoices(isB2b).filter((status) =>
    getVsPoLineStatusFromPoLineRouteParams(routeParams).includes(status.value)
  );
  const showStatusFilter = poLineStatusEnumChoices.length > 1;
  const statusFilter = {
    ...createOptionsField(
      displayOrder++,
      VsPurchaseOrderLineFilterKeys.status,
      "세부 진행 상태",
      opts.status.value,
      true,
      poLineStatusEnumChoices
    ),
    active: opts.eventType.active,
    isRequired: true,
  };

  const receiveFilters = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부 진행 상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    productSearchFilter, // 제품코드 / 제품명
    purchaseOrderDateFilter, // 발주일
    askingPurchaseDateFilter, // 납품요청일
  ];

  const dispatchFulfillmentFilters = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부 진행 상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    purchaseOrderDateFilter, // 발주일
    askingPurchaseDateFilter, // 납품요청일
    expectedPurchaseDateFilter, // 납품예정일
    productSearchFilter, // 제품코드 / 제품명
  ];

  const confirmDeliveryFilters = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부 진행 상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    purchaseOrderDateFilter, // 발주일
    expectedPurchaseDateFilter, // 납품예정일
    dispatchFulfillmentStatusAtFilter, // 출고 지시일
    productSearchFilter, // 제품코드 / 제품명
  ];

  const printInvoiceFilters = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부 진행 상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    purchaseOrderDateFilter, // 발주일
    expectedPurchaseDateFilter, // 납품예정일
    dispatchFulfillmentStatusAtFilter, // 출고 지시일
    deliveryConfirmedStatusAtFilter, // 배송 확정일
    productSearchFilter, // 제품코드 / 제품명
  ];
  const completeDeliveryFilters = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부 진행 상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    purchaseOrderDateFilter, // 발주일
    dispatchFulfillmentStatusAtFilter, // 출고 지시일
    deliveryConfirmedStatusAtFilter, // 배송 확정일
    invoicePrintedStatusAtFilter, // 거래명세서 출력일
    deliveredStatusAtFilter, // 배송 완료일
    productSearchFilter, // 제품코드 / 제품명
  ];

  const allStatus = [
    eventTypeFilter, // 발주 구분
    showStatusFilter && statusFilter, // 세부진행상태
    purchaseOrderSearchFilter, // 발주서 번호 / 발주상세 번호
    productSearchFilter, // 제품코드 / 제품명
    draftStatusAtFilter, // 발주 작성일
    pendingStatusAtFilter, // 접수 대기일
    rejectedStatusAtFilter, // 거부일
    receivedStatusAtFilter, // 접수일
    reqSplitDeliveryStatusAtFilter, // 분할납품 요청일
    reqEpdUpdateStatusAtFilter, // 납품예정일 변경 요청일
    dispatchFulfillmentStatusAtFilter, // 출고지시일
    deliveryConfirmedStatusAtFilter, // 배송확정일
    invoicePrintedStatusAtFilter, // 거래명세서 출력일
    stockedStatusAtFilter, // 입고일
    deliveredStatusAtFilter, // 배송 완료일
  ];

  let filterList = [];
  switch (status) {
    case "receive":
      filterList = receiveFilters;
      break;
    case "dispatch-fulfillment":
      filterList = dispatchFulfillmentFilters;
      break;
    case "confirm-delivery":
      filterList = confirmDeliveryFilters;
      break;
    case "print-invoice":
      filterList = printInvoiceFilters;
      break;
    case "complete-delivery":
      filterList = completeDeliveryFilters;
      break;
    case "all-status":
      filterList = allStatus;
      break;
    default:
      break;
  }
  return utils.filterDisplayOrdering(filterList.filter(Boolean));
}
</file>

