import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { SalesStatListPage } from "../../components/SalesStatListPage/SalesStatListPage";
import { salesStatListViewUrl, SalesStatListViewUrlDialog, SalesStatListViewUrlQueryParams } from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getSalesStatListFilterVariables,
  saveFilterTab,
} from "./filters";

interface SalesStatListViewProps {
  defaultParams: SalesStatListViewUrlQueryParams;
  params: SalesStatListViewUrlQueryParams;
}

export const SalesStatListView: React.FC<SalesStatListViewProps> = ({ defaultParams, params }) => {
  const shop = useShop();
  const bossMarketId = shop.bossMarket.id;
  const targetUrl = salesStatListViewUrl;
  const { navigate, updateListSettings, settings } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.SALES_STAT_LIST,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<SalesStatListViewUrlDialog, SalesStatListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
  });

  const filterVariables = React.useMemo(() => getSalesStatListFilterVariables(params), [params]);

  const filterOpts = getFilterOpts(params);

  return (
    <>
      <SalesStatListPage
        onUpdateListSettings={updateListSettings}
        settings={settings}
        params={params}
        filterVariables={filterVariables}
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        bossMarketId={bossMarketId}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
    </>
  );
};
</file>

