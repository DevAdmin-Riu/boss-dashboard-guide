<file path="src/app/views/brand/brands/components/BrandBundleUpdateModal.tsx">
import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
import { BpBundleUpdateInput, SalesStatusEnum } from "@src/api/types/globalTypes";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { maybe } from "@utils/misc";
import { showNotificationInfo, showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Col, Form, Modal, Row, Space } from "antd";
import moment from "moment";
import React, { useEffect, useState } from "react";

import {
  useBpBundleInfoBulkAddMutation,
  useBpBundleInfoBulkDeleteMutation,
  useBpBundleUpdateMutation,
} from "../api/mutations";
import { useBpBundleQuery, useProductVariantsForBundleLazyQuery } from "../api/queries";
import BrandBundleAddedList from "./BrandBundleAddedList/BrandBundleAddedList";
import BrandBundleAddList from "./BrandBundleAddList/BrandBundleAddList";
import BrandBundleInfoUpdate from "./BrandBundleInfoUpdate";
import BrandBundleSalesInfo from "./BrandBundleSalesInfo";
import BrandBundleTotal from "./BrandBundleTotal";

interface BrandBundleUpdateModalProps {
  open: boolean;
  brandId: string;
  selectedBundleId: string;
  onClose: () => void;
  refetchDataSource: () => Promise<void>;
}

const BrandBundleUpdateModal: React.FC<BrandBundleUpdateModalProps> = (props) => {
  const { open, selectedBundleId, onClose, refetchDataSource } = props;

  const [bundleAddSelectedRowIds, setBundleAddSelectedRowIds] = useState<React.Key[]>([]);
  const [bundleDeleteSelectedRowIds, setBundleDeleteSelectedRowIds] = useState<React.Key[]>([]);

  const [form] = Form.useForm<BpBundleUpdateInput>();
  const showBeforePriceWatched = Form.useWatch("showBeforePrice", form);
  const [formChanged, setFormChanged] = useState<boolean>(false);

  const [fetchProductVariants, { data: productVariantsData, loading: productVariantsLoading }] =
    useProductVariantsForBundleLazyQuery();
  const productVariants = maybe(() => productVariantsData?.productVariants.edges.map((edge) => edge.node), []);

  const handleSearch = (query: string) => {
    fetchProductVariants({
      variables: {
        first: 100,
        filter: {
          trackInventory: true,
          allowAutoConsignment: false,
          salesStatus: [SalesStatusEnum.ON_SALE, SalesStatusEnum.PENDING],
          isInner: false,
          search: query || undefined,
        },
      },
    });
  };

  const {
    data: bpBundleData,
    loading: bpBundleLoading,
    refetch: refetchBpBundle,
  } = useBpBundleQuery({
    skip: !open || utils.isEmpty(selectedBundleId, true),
    variables: { id: selectedBundleId },
  });
  const bpBundle = maybe(() => bpBundleData.bpBundle, null);
  const bpBundleInfoList = bpBundle?.bpBundleInfos || [];

  const bundledPvIdList = bpBundleInfoList.map((item) => item.pv.id);
  const notBundledPvList = productVariants.filter((item) => !bundledPvIdList.includes(item.id));

  const [bpBundleInfoBulkAdd, bpBundleInfoBulkAddOpts] = useBpBundleInfoBulkAddMutation({
    onCompleted: (data) => {
      const errors = data.bpBundleInfoBulkAdd.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("세트 상품에 구성품을 추가했습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bpBundleInfoBulkDelete, bpBundleInfoBulkDeleteOpts] = useBpBundleInfoBulkDeleteMutation({
    onCompleted: (data) => {
      const errors = data.bpBundleInfoBulkDelete.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("세트 상품에서 구성품을 삭제했습니다.");
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bpBundleUpdate, bpBundleUpdateOpts] = useBpBundleUpdateMutation({
    onCompleted: (data) => {
      const errors = data.bpBundleUpdate.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("세트 상품 정보를 업데이트 했습니다.");
        refetchDataSource();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const onModalClose = () => {
    setBundleAddSelectedRowIds([]);
    setBundleDeleteSelectedRowIds([]);
    onClose();
  };

  const addProductVariant = () => {
    if (bpBundle?.forceNoNormalDisplay === false) {
      showNotificationInfo("현재 진열중인 세트 상품에는 구성품 추가를 할 수 없습니다.");
      return;
    }
    if (bundleAddSelectedRowIds.length === 0) {
      showNotificationInfo("1개 이상 선택해 주셔야 추가가 가능합니다.");
      return;
    }

    const addProductVariantList = bundleAddSelectedRowIds.reduce((acc, cur) => {
      const obj = {
        pv: cur,
        bpBundle: selectedBundleId,
      };
      acc.push(obj);
      return acc;
    }, []);

    bpBundleInfoBulkAdd({
      variables: {
        input: [...addProductVariantList],
      },
    });
    setBundleAddSelectedRowIds([]);
    setBundleDeleteSelectedRowIds([]);
  };

  const deleteProductVariant = async () => {
    if (bpBundle?.forceNoNormalDisplay === false) {
      showNotificationInfo("현재 진열중인 세트 상품은 구성품 삭제를 할 수 없습니다.");
      return;
    }
    if (bundleDeleteSelectedRowIds.length === 0) {
      showNotificationInfo("1개 이상 선택해 주셔야 삭제가 가능합니다.");
      return;
    }

    await bpBundleInfoBulkDelete({
      variables: {
        ids: bundleDeleteSelectedRowIds as string[],
      },
    });
    setBundleAddSelectedRowIds([]);
    setBundleDeleteSelectedRowIds([]);
  };

  const initialValues: BpBundleUpdateInput = {
    name: bpBundle?.name || "",
    isOnlyPayableByCash: bpBundle?.isOnlyPayableByCash ?? false,
    isRcoinRewardForUsingPoint: bpBundle?.isRcoinRewardForUsingPoint ?? false,
    needDeliveryAdditionalFee: bpBundle?.needDeliveryAdditionalFee ?? false,
    salesStatus: bpBundle?.salesStatus || SalesStatusEnum.PENDING,
    stoppedAt: bpBundle?.stoppedAt ? moment(bpBundle.stoppedAt) : null,
    stoppedReason: bpBundle?.stoppedReason || null,
    stoppedReasonEtc: bpBundle?.stoppedReasonEtc || "",
    forceNoNormalDisplay: bpBundle?.forceNoNormalDisplay ?? false,
    costPriceExcludeVat: bpBundle?.costPriceExcludeVat ?? 0,
    deliveryFee: toPriceExcludeVat(bpBundle?.deliveryFeeAmount ?? 0) ?? 0,
    price: (bpBundle?.priceAmount ?? 0) - (bpBundle?.priceVat ?? 0),
    priceVat: bpBundle?.priceVat ?? 0,
    showBeforePrice: bpBundle?.showBeforePrice ?? false,
    beforePrice: toPriceExcludeVat(bpBundle?.beforePriceAmount ?? 0) ?? 0,
  };

  const onFormFinish = (values: BpBundleUpdateInput) => {
    const priceVat = values.priceVat ?? 0;
    const priceIncludeVat = (values.price ?? 0) + priceVat;

    bpBundleUpdate({
      variables: {
        id: selectedBundleId,
        input: {
          name: values.name,
          isOnlyPayableByCash: values.isOnlyPayableByCash,
          isRcoinRewardForUsingPoint: values.isRcoinRewardForUsingPoint,
          needDeliveryAdditionalFee: values.needDeliveryAdditionalFee,
          salesStatus: values.salesStatus,
          stoppedAt: values.stoppedAt ? values.stoppedAt.format("YYYY-MM-DD") : null,
          stoppedReason: values.stoppedReason,
          stoppedReasonEtc: values.stoppedReasonEtc || null,
          forceNoNormalDisplay: values.forceNoNormalDisplay,
          costPriceExcludeVat: values.costPriceExcludeVat,
          deliveryFee: toPriceIncludeVat(values.deliveryFee ?? 0) ?? 0,
          price: priceIncludeVat,
          priceVat,
          showBeforePrice: values.showBeforePrice,
          beforePrice: toPriceIncludeVat(values.beforePrice ?? 0) ?? 0,
        },
      },
    });
    setFormChanged(false);
  };

  useEffect(() => {
    form.resetFields();
  }, [form, bpBundle]);

  const modalLoading = productVariantsLoading || bpBundleLoading;
  const buttonLoading =
    bpBundleInfoBulkAddOpts.loading || bpBundleInfoBulkDeleteOpts.loading || bpBundleUpdateOpts.loading;
  return (
    <>
      <Modal
        forceRender
        destroyOnClose
        closable={false}
        title={`${bpBundle?.bpSku || ""} 세트 구성`}
        open={open}
        width={1300}
        maskClosable={false}
        footer={
          <>
            <Button onClick={onModalClose}>닫기</Button>
            <Button loading={buttonLoading} type="primary" onClick={() => form.submit()} disabled={!formChanged}>
              저장
            </Button>
          </>
        }
      >
        {bpBundle && (
          <Form
            form={form}
            onFinish={onFormFinish}
            initialValues={initialValues}
            onFieldsChange={() => setFormChanged(true)}
            layout="vertical"
          >
            <Space direction="vertical" size="small" style={{ width: "100%" }}>
              <BrandBundleInfoUpdate
                selectedRowId={selectedBundleId}
                bpBundle={bpBundle}
                bpBundleUpdate={bpBundleUpdate}
              />
              <BrandBundleAddList
                productVariants={notBundledPvList}
                bundleSelectedRowIds={bundleAddSelectedRowIds}
                setBundleSelectedRowIds={setBundleAddSelectedRowIds}
                onSearch={handleSearch}
                loading={productVariantsLoading}
              />
              <Row justify="center" gutter={[8, 8]}>
                <Col>
                  <Button
                    loading={buttonLoading}
                    onClick={() => {
                      addProductVariant();
                    }}
                  >
                    추가 <ArrowDownOutlined />
                  </Button>
                </Col>
                <Col>
                  <Button
                    loading={buttonLoading}
                    onClick={() => {
                      deleteProductVariant();
                    }}
                  >
                    삭제 <ArrowUpOutlined />
                  </Button>
                </Col>
              </Row>
              <BrandBundleAddedList
                loading={modalLoading}
                bpBundleInfo={bpBundleInfoList}
                bundleDeleteSelectedRowIds={bundleDeleteSelectedRowIds}
                setBundleDeleteSelectedRowIds={setBundleDeleteSelectedRowIds}
                refetchBpBundle={refetchBpBundle}
              />
              <BrandBundleTotal bpBundleInfoList={bpBundleInfoList} />
              <BrandBundleSalesInfo
                form={form}
                showBeforePriceWatched={showBeforePriceWatched}
                bpBundleInfoList={bpBundleInfoList}
              />
            </Space>
          </Form>
        )}
      </Modal>
    </>
  );
};

export default BrandBundleUpdateModal;
</file>

