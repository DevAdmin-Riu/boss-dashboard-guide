  brandSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
}

export const createFilterStructure = (
  opts: VendorHqShippingDaySettingFilterOpts,
  isStaff: boolean
): IFilter<VendorHqShippingDaySettingFilterKeys> => {
  let displayOrder = 0;
  const brandFilter = {
    ...createTextField(
      displayOrder++,
      VendorHqShippingDaySettingFilterKeys.brandSearch,
      "브랜드코드 / 브랜드명",
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const userFilter = {
    ...createTextField(
      displayOrder++,
      VendorHqShippingDaySettingFilterKeys.userSearch,
      "ID / 사용자명",
      opts.userSearch.value
    ),
    active: opts.userSearch.active,
  };
  if (isStaff) {
    return [brandFilter, userFilter];
  }
  return [userFilter];
};
