import makeQuery, { makeLazyQuery } from "@hooks/makeQuery";
import { pageInfoFragment } from "@src/api/fragments/pageInfo";
import { vendorHistoryFragment } from "@src/api/fragments/vendor";
import gql from "graphql-tag";

import { VendorHistories, VendorHistoriesVariables } from "./types/VendorHistories";
import { VendorHistory, VendorHistoryVariables } from "./types/VendorHistory";

const vendorHistoryList = gql`
  ${vendorHistoryFragment}
  ${pageInfoFragment}
  query VendorHistories(
    $filter: VendorHistoryFilterInput
    $sort: VendorHistorySortingInput
    $after: String
    $before: String
    $first: Int
    $last: Int
  ) {
    vendorHistories(filter: $filter, sortBy: $sort, after: $after, before: $before, first: $first, last: $last) {
      pageInfo {
        ...PageInfoFragment
      }
      edges {
        node {
          ...VendorHistoryFragment
        }
      }
    }
  }
`;
export const useVendorHistoryListQuery = makeQuery<VendorHistories, VendorHistoriesVariables>(vendorHistoryList);
export const useVendorHistoryListFilterDownloadQuery = makeLazyQuery<VendorHistories, VendorHistoriesVariables>(
  vendorHistoryList,
  "no-cache"
);

const vendorHistory = gql`
  ${vendorHistoryFragment}
  query VendorHistory($id: ID!) {
    vendorHistory(id: $id) {
      ...VendorHistoryFragment
    }
  }
`;

export const useVendorHistoryQuery = makeQuery<VendorHistory, VendorHistoryVariables>(vendorHistory);
</file>

