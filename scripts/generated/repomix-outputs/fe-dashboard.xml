  AttributeSlugEnum,
  getAttrAndValuesBySlug,
  getCategoryLabel,
  makeProductQtyPerBoxText,
} from "@src/app/views/product/products/utils/data";
import { Button } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { ProductVariantListForReq_productVariants_edges_node } from "../../api/types/ProductVariantListForReq";

interface ProductVariantListForReqTableSettingsProps {
  user: User;
  onRowClick: (id: string) => void;
}

export const getProductVariantListForReqTableSettings = (
  props: ProductVariantListForReqTableSettingsProps
): ColumnsType<ProductVariantListForReq_productVariants_edges_node> => {
  const { user, onRowClick } = props;
  const { isHqStaff } = user;
  const productText = isHqStaff ? "상품" : "제품";
  const {
    product: { SKU, PRODUCT_NAME },
    brandProduct: { BRAND_PRODUCT_NAME, BP_SKU: BRAND_PRODUCT_SKU },
  } = columnNameConstant;

  const columns: ColumnsType<ProductVariantListForReq_productVariants_edges_node> = [
    {
      key: "actions",
      width: 100,
      fixed: "left",
      render: (_, record) => (
        <Button type="primary" onClick={() => onRowClick(record.id)}>
          {productText}선택
        </Button>
      ),
    },
    {
      title: isHqStaff ? `포장보스 ${BRAND_PRODUCT_SKU}` : SKU,
      key: "sku",
      width: 120,
      render: (_, record) => record.sku || "-",
    },
    {
      title: isHqStaff ? BRAND_PRODUCT_NAME : PRODUCT_NAME,
      key: "productName",
      width: 200,
      render: (_, record) => record.product.name || "-",
    },
    {
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      width: 120,
      render: (_, record) => record.name || "-",
    },
    { title: "분류", key: "category", width: 200, render: (_, record) => getCategoryLabel(record.product.category) },
    {
      title: columnNameConstant.product.SPEC,
      key: "size",
