<file path="src/app/views/order/orders/components/CreateAdminOrderUserSearchModal/CreateAdminOrderCustomerListTableSettings.tsx">
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { Button } from "antd";
