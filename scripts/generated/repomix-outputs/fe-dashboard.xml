<file path="src/app/views/brand/brandStore/components/BsOpsCheckTemplateCreatePage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import useUser from "@hooks/useUser";
import { SearchBrands_search_edges_node } from "@src/api/searches/types/SearchBrands";
import { BsOpsCheckTemplateCreateInput } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import AppHeader from "@src/app/components/AppHeader";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { FetchMoreProps } from "@src/global/core/types/types";
import { Form, PageHeader, Select, Space } from "antd";
import React from "react";

import { BsOpsCheckTemplateBasicInfo } from "./BsOpsCheckTemplateBasicInfo";
import { BsOpsCheckTemplateCategoryList } from "./BsOpsCheckTemplateCategoryList/BsOpsCheckTemplateCategoryList";

interface BsOpsCheckTemplateCreatePageProps {
  TypeSafeForm: TypeSafeForm<BsOpsCheckTemplateCreateInput>;
  loading: boolean;
  brandList: SearchBrands_search_edges_node[];
  brandFetchMore: FetchMoreProps;
  onBrandSearch: (search: string) => void;
  onBack: () => void;
}

export const BsOpsCheckTemplateCreatePage: React.FC<BsOpsCheckTemplateCreatePageProps> = (props) => {
  const { TypeSafeForm, loading, brandList, brandFetchMore, onBrandSearch, onBack } = props;
  const { user } = useUser();
  const { formInstance } = TypeSafeForm;

  const brandOptions = brandList.map((brand) => ({
    label: `${brand.name} (${brand.code})`,
    value: brand.id,
  }));

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.bsOpsCheckTemplateList}</AppHeader>
      <PageHeader title="점검 양식 등록" />

      <Space direction="vertical" size="large">
        <Form.Item
          style={{ marginTop: 24, marginBottom: 0 }}
          name={TypeSafeForm.getValidDataIndex("brand")}
          label="브랜드 선택"
          hidden={user.isHqStaff}
        >
          <Select
            showSearch
            options={brandOptions}
            filterOption={(input, option) => option?.label?.toLowerCase().includes(input.toLowerCase())}
            onSearch={onBrandSearch}
            loading={brandFetchMore.loading}
            onPopupScroll={({ currentTarget }) => {
              const { scrollHeight, scrollTop, clientHeight } = currentTarget;
              const { hasMore, loading, onFetchMore } = brandFetchMore;
              // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
              if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                onFetchMore();
              }
            }}
          />
        </Form.Item>
        <BsOpsCheckTemplateBasicInfo isCreate TypeSafeForm={TypeSafeForm} />
        <BsOpsCheckTemplateCategoryList isCreate TypeSafeForm={TypeSafeForm} />
      </Space>

      <Form.Item noStyle shouldUpdate>
        {() => (
          <AntdSaveButtonBar
            disabled={!formInstance.isFieldsTouched()}
            state={loading ? "loading" : "default"}
            labels={{ save: "등록" }}
            onCancel={onBack}
            onSave={formInstance.submit}
          />
        )}
      </Form.Item>
    </>
  );
};
</file>

<file path="src/app/views/brand/brandStore/components/BsOpsCheckTemplateDetailsPage.tsx">
import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import { User } from "@src/api/fragments/types/User";
import { BsOpsCheckTemplateBasicInfoUpdateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import Grid from "@src/app/components/Grid";
import { DateTime } from "@src/app/providers/DateProvider";
import { maybe, transformIsSubmitted } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Form, PageHeader, Space, Table, Tag, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useEffect } from "react";

import { BsOpsCheckTemplateCategoryUpdateVariables } from "../api/types/BsOpsCheckTemplateCategoryUpdate";
import {
  BsOpsCheckTemplateDetails_bsOpsCheckTemplate,
  BsOpsCheckTemplateDetails_bsOpsCheckTemplate_reports_edges_node,
} from "../api/types/BsOpsCheckTemplateDetails";
import { bsOpsCheckReportListViewUrl } from "../urls";
import { BsOpsCheckTemplateEditModeEnum } from "../views/BsOpsCheckTemplateDetailsView";
import { BsOpsCheckTemplateBasicInfo } from "./BsOpsCheckTemplateBasicInfo";
import { BsOpsCheckTemplateCategoryList } from "./BsOpsCheckTemplateCategoryList/BsOpsCheckTemplateCategoryList";

interface BsOpsCheckTemplateDetailsPageProps {
  user: User;
  template: BsOpsCheckTemplateDetails_bsOpsCheckTemplate;
  editMode: BsOpsCheckTemplateEditModeEnum;
  onEdit: (mode: BsOpsCheckTemplateEditModeEnum) => void;
  onEditCancel: () => void;
  onBasicInfoUpdate: (formData: BsOpsCheckTemplateBasicInfoUpdateInput) => void;
  onCategoryUpdate: (formData: BsOpsCheckTemplateCategoryUpdateVariables) => void;
  onBack: () => void;
}

export const BsOpsCheckTemplateDetailsPage: React.FC<BsOpsCheckTemplateDetailsPageProps> = (props) => {
  const { user, template, editMode, onEdit, onEditCancel, onBasicInfoUpdate, onCategoryUpdate, onBack } = props;
  const isStaff = user.isStaff;
  const navigate = useNavigator();
  const [basicInfoForm] = Form.useForm<BsOpsCheckTemplateBasicInfoUpdateInput>();
  const [categoryForm] = Form.useForm<BsOpsCheckTemplateCategoryUpdateVariables>();
  const BasicInfoTypeSafeForm = getTypeSafeForm<BsOpsCheckTemplateBasicInfoUpdateInput>(basicInfoForm);
  const CategoryTypeSafeForm = getTypeSafeForm<BsOpsCheckTemplateCategoryUpdateVariables>(categoryForm);

  const basicInfoInitialValues: BsOpsCheckTemplateBasicInfoUpdateInput = {
    isVisible: template.isVisible,
    title: template.title,
    description: template.description,
  };
  // NOTE: 카테고리 리스트에서 카테고리 선택 시, 선택한 카테고리 값으로 초기화
  const categoryInitialValues: BsOpsCheckTemplateCategoryUpdateVariables = { id: null, input: { name: null } };

  const isEditing = utils.isEmpty(editMode) === false;

  useEffect(() => {
    switch (editMode) {
      case BsOpsCheckTemplateEditModeEnum.UpdateBasicInfo:
        basicInfoForm.resetFields();
        break;
      case BsOpsCheckTemplateEditModeEnum.UpdateCategory:
        categoryForm.resetFields();
        break;
      default:
        break;
    }
  }, [editMode]);

  const reportList = maybe(() => template.reports.edges.map((edge) => edge.node), []);
  const reportListColumns: ColumnsType<BsOpsCheckTemplateDetails_bsOpsCheckTemplate_reports_edges_node> = [
    {
      title: columnNameConstant.brandStore.STATUS,
      key: "status",
      align: "center",
      width: 100,
      render: (_, record) => transformIsSubmitted(record.isSubmitted),
    },
    {
      title: columnNameConstant.common.TITLE,
      key: "title",
      width: 150,
      render: (_, record) => record.title,
    },
    {
      title: columnNameConstant.common.REGISTERED_DATE,
      key: "createdAt",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.createdAt} onlyDate />,
    },
    {
      title: columnNameConstant.brandStore.SUBMIT_DATE,
      key: "submittedAt",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.submittedAt} onlyDate />,
    },
  ];
  const reportListTableWidthSum = utils.calcTableColsWidthSum(reportListColumns);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.bsOpsCheckTemplateList}</AppHeader>
      <PageHeader title={template.title} tags={isStaff && <Tag>{template.brand.name}</Tag>} />

      <Grid>
        <Space direction="vertical" size="large">
          <Form
            name="bs-ops-check-template-basic-info-update"
            layout="vertical"
            disabled={isEditing && editMode !== BsOpsCheckTemplateEditModeEnum.UpdateBasicInfo}
            form={basicInfoForm}
            initialValues={basicInfoInitialValues}
            onFinish={onBasicInfoUpdate}
          >
            <BsOpsCheckTemplateBasicInfo
              isCreate={false}
              TypeSafeForm={BasicInfoTypeSafeForm}
              template={template}
              editModeProps={{
                isEditMode: editMode === BsOpsCheckTemplateEditModeEnum.UpdateBasicInfo,
                onEdit: () => onEdit(BsOpsCheckTemplateEditModeEnum.UpdateBasicInfo),
                onCancel: onEditCancel,
              }}
            />
          </Form>
          <Form
            name="bs-ops-check-template-category-update"
            layout="vertical"
            disabled={isEditing && editMode !== BsOpsCheckTemplateEditModeEnum.UpdateCategory}
            form={categoryForm}
            initialValues={categoryInitialValues}
            onFinish={onCategoryUpdate}
          >
            <BsOpsCheckTemplateCategoryList
              isCreate={false}
              TypeSafeForm={CategoryTypeSafeForm}
              template={template}
              editModeProps={{
                isEditMode: editMode === BsOpsCheckTemplateEditModeEnum.UpdateCategory,
                onEdit: () => onEdit(BsOpsCheckTemplateEditModeEnum.UpdateCategory),
                onCancel: onEditCancel,
              }}
            />
          </Form>
        </Space>
        <Space direction="vertical" size="large">
          <Card
            title={
              <PageHeader
                title="점검 보고서(최근 10개)"
                subTitle={`작성중: ${template.reportsCount.notSubmittedCount} | 제출: ${template.reportsCount.submittedCount}`}
                extra={
                  <Typography.Link strong onClick={() => navigate(bsOpsCheckReportListViewUrl({ viewType: "list" }))}>
                    모든 보고서 보기
                  </Typography.Link>
                }
              />
            }
            bodyStyle={{ padding: 0 }}
          >
