import { UploadFileControlType, UploadFileListType } from "@src/app/components/UploadFiles";
import VendorHistoryFileUpload from "@src/app/views/purchase/vendors/views/vendorHistory/components/VendorHistoryPage/VendorHistoryFileUpload";
import { maybe } from "@utils/misc";
import { Col, Row, Select } from "antd";
import React, { useEffect } from "react";

import { UpdateVendorHistory_vendorHistoryUpdate_errors } from "../../api/types/UpdateVendorHistory";

export interface VendorHistoryCreatePageFormData {
  vendor: string;
  contentRaw: string;
  title: string;
  files: UploadFileListType;
}

export interface VendorHistoryCreatePageProps {
  disabled: boolean;
  vendorId: string;
  errors: UpdateVendorHistory_vendorHistoryUpdate_errors[];
  saveButtonBar: ConfirmButtonTransitionState;
  onBack: () => void;
  onSubmit: (data: VendorHistoryCreatePageFormData) => SubmitPromise;
  uploadFileController?: UploadFileControlType;
}
const VendorHistoryCreatePage: React.FC<VendorHistoryCreatePageProps> = ({
  disabled,
  vendorId,
  errors,
  saveButtonBar,
  onBack,
  onSubmit,
  uploadFileController,
}: VendorHistoryCreatePageProps) => {
  const [searchedVendors, setSearchedVendors] = React.useState([]);
  const formErrors = getFormErrors(["title", "content"], errors);
  const pageTitle = "협력사 이력 생성";
  const appHeaderTitle = `${pageTitle} 관리`;

  const isEditable = true;

  const bannerVendorSearchVariable: SearchVendorsVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.vendorsForHistory,
    ids: vendorId ? [vendorId] : [],
  };
  const { loadMore, search, result } = useVendorSearch({ variables: bannerVendorSearchVariable });
  const fetchMoreData = {
    hasMore: maybe(() => result.data.search.pageInfo.hasNextPage),
    loading: result.loading,
    onFetchMore: loadMore,
  };

  useEffect(() => {
    setSearchedVendors(
      result.data?.search?.edges.map((edge) => ({
        label: edge.node.name,
        value: edge.node.id,
      }))
    );
  }, [result?.data?.search?.edges]);

  const vendorFilterOption = (input: string, option: { label: string; value: string }) =>
    (option?.label ?? "").toLowerCase().includes(input.toLowerCase());

  return (
    <Form
      initial={{
        title: "",
        contentRaw: "",
        vendor: vendorId ? vendorId : "",
        files: {
          addFileList: [],
          addDescList: [],
          updateDescList: [],
          deleteFileList: [],
        },
      }}
      onSubmit={onSubmit}
      confirmLeave
    >
      {({ change, data, hasChanged, submit }) => (
        <>
          <AppHeader onBack={onBack}>{appHeaderTitle}</AppHeader>
          <PageHeader title={pageTitle} />
          <Row>
            <Col span={24}>
              <Select
                showSearch
                defaultValue={vendorId ? vendorId : null}
                disabled={!!vendorId}
                style={{ width: "300px" }}
                placeholder="협력사 선택"
                loading={fetchMoreData.loading}
                onSearch={(value) => search(value)}
                onChange={(value) => change({ target: { name: "vendor", value } })}
                options={searchedVendors}
                filterOption={vendorFilterOption}
                onPopupScroll={({ currentTarget }) => {
                  const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                  const { hasMore, loading, onFetchMore } = fetchMoreData;
                  // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                  if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                    onFetchMore();
                  }
                }}
              />
              <FormSpacer />
              <Card>
                <TextField
                  label="제목"
                  name="title"
                  disabled={disabled || !isEditable}
                  value={data.title}
                  onChange={change}
                  error={!!formErrors.title}
                  fullWidth
                />
              </Card>
              <FormSpacer />
              <Card>
                <ToastEditor
                  name="contentRaw"
                  initialValue={"운영 이력을 작성해주세요"}
                  onChange={change}
                  isEditable={isEditable}
                />
              </Card>
              <FormSpacer />
            </Col>
          </Row>
          <VendorHistoryFileUpload uploadFileController={uploadFileController} onChange={change} />
          {isEditable && (
            <SaveButtonBar state={saveButtonBar} disabled={disabled || !hasChanged} onCancel={onBack} onSave={submit} />
          )}
        </>
      )}
    </Form>
  );
};

export default VendorHistoryCreatePage;
</file>

