<file path="src/app/views/brand/brands/components/BrandPackageListTable/BrandPackageListTable.tsx">
import { PlusOutlined } from "@ant-design/icons";
import { UseNavigatorResult } from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { FilterPageProps, ListProps } from "@src/global/core/types/types";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Row, Space } from "antd";
import React from "react";

import { BrandForBpvList_brand } from "../../api/types/BrandForBpvList";
import { BrandProductPackages_brandProductPackages_edges_node } from "../../api/types/BrandProductPackages";
import {
  BrandProductFilterKeys,
  BrandProductListFilterOpts,
  createFilterStructure,
} from "../BrandProductListPage/filters";
import { getBrandPackageListTableColumns } from "./BrandPackageListTableSettings";
import { BrandPackageTableDataType } from "./types";

interface BrandPackageListTableProps
  extends ListProps,
    FilterPageProps<BrandProductFilterKeys, BrandProductListFilterOpts> {
  brand: BrandForBpvList_brand;
  packages: BrandProductPackages_brandProductPackages_edges_node[];
  loading: boolean;
  navigate: UseNavigatorResult;
  onProductPackageCreate?: () => void;
  onProductPackageUpdate: (record: BrandPackageTableDataType) => void;
  onProductPackageDelete: (record: BrandPackageTableDataType) => void;
}

export const BrandPackageListTable: React.FC<BrandPackageListTableProps> = (props) => {
  const {
    //  brand,
    packages,
    loading,
    navigate,
    onProductPackageCreate,
    onProductPackageUpdate,
    onProductPackageDelete,
    filterOpts,
    currencySymbol,
    currentTab,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts, true);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  // 패키지 상세보기 핸들러
  const handleViewPackageInfo = (record: BrandPackageTableDataType) => {
    onProductPackageUpdate(record);
  };

  // 패키지 삭제 핸들러
  const handleDeletePackage = (record: BrandPackageTableDataType) => {
    if (record.visible) {
      showNotificationWarn("판매중인 패키지 상품은 삭제할 수 없습니다.");
      return;
    }
    onProductPackageDelete(record);
  };

  // 테이블 헤더 - 패키지 추가 버튼만 표시
  const tableTitle = onProductPackageCreate
    ? () => (
        <Row justify="end" align="bottom">
          <Space>
            <Button type="primary" icon={<PlusOutlined />} onClick={onProductPackageCreate} disabled={loading}>
              패키지 상품 추가
            </Button>
          </Space>
        </Row>
      )
    : undefined;

  // 테이블 데이터 변환
  const tableDataSource: BrandPackageTableDataType[] = packages.map((pkg, index) => ({
    ...pkg,
    no: index + 1,
  }));

  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);

  // 테이블 컬럼 설정
  const columns = getBrandPackageListTableColumns({
    navigate,
    disabled: loading,
    onProductPackageUpdate: handleViewPackageInfo,
    onProductPackageDelete: handleDeletePackage,
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload: () =>
      Promise.resolve({ data: { dataSource: tableDataSource }, loading: undefined, networkStatus: undefined }),
    queryVariablesWithoutPagination: null,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "dataSource",
  };

  return (
    <>
      <SpreadFilterBar
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterStructure={filterStructure}
        tabs={tabs}
        onAll={onAll}
        onFilterChange={onFilterChange}
        onTabChange={onTabChange}
        onTabDelete={onTabDelete}
        onTabSave={onTabSave}
        tabExtra={
          <>
            <ColumnPicker
              columns={pickColumns}
              loading={loading}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          </>
        }
        isDownloadable={true}
        excelDownloadProps={excelDownloadProps}
      />
      <TableVatLegend isIncludeVat={false} />
      <PatchedColumnsTable
        {...commonTableProps}
        ref={tableRef}
        loading={loading}
        title={tableTitle}
        dataSource={tableDataSource}
        columns={pickerSelectedColumns}
        scroll={{ x: tableWidthSum, y: tableScrollY }}
      />
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandPackageListTable/BrandPackageListTableSettings.tsx">
import { UseNavigatorResult } from "@hooks/useNavigator";
import {
  DownloadableEditableColumnsType,
  DownloadableEditableColumnType,
} from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { NumberComponent } from "@src/app/components/Number";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Button, Space, Tag } from "antd";
import React from "react";

import { BrandPackageTableDataType } from "./types";
import { getDeliveryMethods } from "./utils";

interface BrandPackageListTableColumnProps {
  navigate?: UseNavigatorResult;
  disabled: boolean;
  onProductPackageUpdate: (record: BrandPackageTableDataType) => void;
  onProductPackageDelete: (record: BrandPackageTableDataType) => void;
}

export const getBrandPackageListTableColumns = (
  props: BrandPackageListTableColumnProps
): DownloadableEditableColumnsType<BrandPackageTableDataType> => {
  const { disabled, onProductPackageUpdate, onProductPackageDelete } = props;

  const fixedLeftFlag = utils.fixedLeftFlag();
  const fixedRightFlag = utils.fixedRightFlag();

  // No 컬럼
  const noColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: "No",
    key: "no",
    align: "center",
    fixed: fixedLeftFlag,
    width: 60,
    render: (_text, _record, index) => index + 1,
    isPickerHide: true,
  };

  // 상품코드 컬럼
  const productCodeColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    fixed: fixedLeftFlag,
    width: 140,
    render: (_, record) => record.bpSku,
    isPickerHide: true,
  };

  // 상품명 컬럼
  const productNameColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "name",
    align: "left",
    width: 200,
    render: (_, record) => record.name || "-",
  };

  // 판매상태 컬럼
  const salesStatusColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "salesStatus",
    align: "center",
    width: 100,
    render: (_, record) => {
      const isVisible = record.visible;
      const tagColor = isVisible ? "green" : "default";
      const tagText = isVisible ? "판매" : "중단";
      return <Tag color={tagColor}>{tagText}</Tag>;
    },
    renderExcel: (record) => (record.visible ? "판매" : "중단"),
  };

  // 배송방법 컬럼
  const deliveryMethodColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: "배송방법",
    key: "deliveryMethod",
    align: "center",
    width: 120,
    render: (_, record) => {
      const methods = getDeliveryMethods(record);

      if (methods.length === 0) {
        return "-";
      }

      return (
        <Space direction="vertical" size={0}>
          {methods.map((method) => (
            <Tag key={method}>{method}</Tag>
          ))}
        </Space>
      );
    },
    renderExcel: (record) => {
      const methods = getDeliveryMethods(record);
      return methods.length > 0 ? methods.join(", ") : "-";
    },
  };

  // 화물차 배송비 컬럼
  const truckDeliveryFeeColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.delivery.TRUCK_DELIVERY_FEE,
    key: "truckDeliveryFee",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.etcDeliveryFee) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.etcDeliveryFee),
  };

  const additionalFeeForEtcDeliveryColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.order.DELIVERY_ADDITIONAL_FEE,
    key: "additionalFeeForEtcDelivery",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.additionalFeeForEtcDelivery) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.additionalFeeForEtcDelivery),
  };

  // 총 상품금액 컬럼
  const totalAmountColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: columnNameConstant.brandProduct.TOTAL_BRAND_PRODUCT_PRICE,
    key: "totalAmount",
    align: "right",
    width: 120,
    render: (_, record) => <NumberComponent value={toPriceExcludeVat(record.totalPriceWoEtcDeliveryFee) || 0} />,
    renderExcel: (record) => toPriceExcludeVat(record.totalPriceWoEtcDeliveryFee),
  };

  // 패키지 구성 버튼 컬럼
  const packageInfoColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: "패키지 구성",
    key: "packageInfo",
    align: "center",
    width: 120,
    render: (_, record) => (
      <Button size="small" type="primary" disabled={disabled} onClick={() => onProductPackageUpdate(record)}>
        상세보기
      </Button>
    ),
    doNotRenderExcel: true,
  };

  // 패키지 삭제 컬럼
  const deleteColumn: DownloadableEditableColumnType<BrandPackageTableDataType> = {
    title: "패키지 삭제",
    key: "delete",
    align: "center",
    fixed: fixedRightFlag,
    width: 100,
    render: (_, record) => (
      <Button size="small" danger disabled={disabled || record.visible} onClick={() => onProductPackageDelete(record)}>
        삭제
      </Button>
    ),
    doNotRenderExcel: true,
    isPickerHide: true,
  };

  // 컬럼 구성 (1차 헤더: 상품 정보)
  const columns: DownloadableEditableColumnsType<BrandPackageTableDataType> = [
    noColumn,
    productCodeColumn,
    {
      title: "상품 정보",
      key: "productInfo",
      children: [
        productNameColumn,
        salesStatusColumn,
        deliveryMethodColumn,
        truckDeliveryFeeColumn,
        additionalFeeForEtcDeliveryColumn,
        totalAmountColumn,
        packageInfoColumn,
      ],
    },
    deleteColumn,
  ];

  return columns;
};
