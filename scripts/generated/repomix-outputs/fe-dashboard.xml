import { Button, Card, Collapse, Descriptions, Space, Typography } from "antd";
import React from "react";

import { SiteSettings_shop } from "../../api/types/SiteSettings";
import { SiteSettingsViewUrlDialog, SiteSettingsViewUrlQueryParams } from "../../urls";
import { getMobileAppName } from "./utils";

interface SiteSettingsMobileAppInfoProps {
  disabled: boolean;
  shop: SiteSettings_shop;
  onModalOpen: (action: SiteSettingsViewUrlDialog, newParams?: SiteSettingsViewUrlQueryParams) => void;
}

const SiteSettingsMobileAppInfo: React.FC<SiteSettingsMobileAppInfoProps> = (props) => {
  const { disabled, shop, onModalOpen } = props;
  const mobileAppInfo = shop?.mobileAppInfo;

  const cardExtra = (
    <Button type="primary" disabled={disabled} onClick={() => onModalOpen("create-mobile-app-info")}>
      추가
    </Button>
  );

  return (
    <Card title={"모바일 앱 정보"} extra={cardExtra}>
      {!!mobileAppInfo && mobileAppInfo.length > 0 ? (
        <Collapse defaultActiveKey={mobileAppInfo.map((item) => item.id)}>
          {mobileAppInfo.map((item) => {
            const mobileAppName = getMobileAppName(item.type);
            const panelExtra = (
              <Space>
                <Button
                  type="primary"
                  size="small"
                  disabled={disabled}
                  onClick={() => onModalOpen("update-mobile-app-info", { id: item.id })}
                >
