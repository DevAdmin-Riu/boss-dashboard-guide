import { FormChange } from "@hooks/useForm";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getFieldError } from "@src/global/assets/messages/errors";
import { UserError } from "@src/global/core/types/types";
import { transformIsFBV } from "@utils/misc";
import { Card, Input, Space, Switch, Tag, Typography } from "antd";
import React from "react";

interface ProductTypeDetailsProps {
  data: {
    name: string;
    isFulfilledByVendor: boolean;
  };
  disabled: boolean;
  isCreateMode: boolean;
  errors: UserError[];
  onChange: FormChange;
}

const ProductTypeDetails: React.FC<ProductTypeDetailsProps> = (props) => {
  const { data, disabled, isCreateMode, errors, onChange } = props;
  const isUpdateMode = !isCreateMode;
  const nameFieldError = getFieldError(errors, "name");
  const isFulfilledByVendorFieldError = getFieldError(errors, "isFulfilledByVendor");
  const cardTitle = (
    <Space>
      <Typography.Title level={4}>{commonMsg.generalInformations}</Typography.Title>
      {isUpdateMode && data.isFulfilledByVendor && <Tag color="magenta">{transformIsFBV(true)} 상품 전용 타입</Tag>}
    </Space>
  );

  return (
    <Card title={cardTitle}>
      <Space direction="vertical" size="large">
        <FormFieldAntd label="타입명" error={nameFieldError} errorMsg={nameFieldError?.message}>
          <Input
            name="name"
            disabled={disabled}
            value={data.name}
            onChange={onChange}
            placeholder="타입명을 입력해주세요."
          />
        </FormFieldAntd>
        {isCreateMode && (
          <FormFieldAntd
            label={`${transformIsFBV(true)} 상품 타입 전용 여부`}
            error={isFulfilledByVendorFieldError}
            errorMsg={isFulfilledByVendorFieldError?.message}
          >
            <Switch
              disabled={disabled}
              checked={data.isFulfilledByVendor}
              onChange={(checked) => onChange({ target: { name: "isFulfilledByVendor", value: checked } })}
              checkedChildren="ON"
              unCheckedChildren="OFF"
            />
          </FormFieldAntd>
        )}
      </Space>
    </Card>
  );
};
export default ProductTypeDetails;
</file>

