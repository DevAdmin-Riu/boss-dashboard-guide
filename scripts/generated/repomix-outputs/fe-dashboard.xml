<file path="src/app/views/order/orders/components/PickingOrderFulfillModal/PickingOrderFulfillModal.tsx">
import { PickingOrderFulfillInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { StockDivideOrCombineModal } from "@src/app/views/product/stock/components/StockDivideOrCombineModal";
import { utils } from "@utils/utils";
import { Empty, Form, Modal, Space, Table, Typography } from "antd";
import React, { useEffect, useState } from "react";

import { OrderLineListForFulfill_orderLines_edges_node } from "../../api/types/OrderLineListForFulfill";
import { getPickingOrderFulfillTableSettings } from "./PickingOrderFulfillTableSettings";

interface PickingOrderFulfillModalProps {
  open: boolean;
  loading: boolean;
  orderLines: OrderLineListForFulfill_orderLines_edges_node[];
  onSubmit: (formData: PickingOrderFulfillInput) => void;
  onClose: () => void;
}

export const PickingOrderFulfillModal: React.FC<PickingOrderFulfillModalProps> = (props) => {
  const { open, loading, orderLines, onSubmit, onClose } = props;
  const [openDivideOrCombineModal, setOpenDivideOrCombineModal] = useState<boolean>(false);
  const [idForModal, setIdForModal] = useState<string>(null);
  const [dataSource, setDataSource] = useState<OrderLineListForFulfill_orderLines_edges_node[]>([]);

  const [form] = Form.useForm<PickingOrderFulfillInput>();
  const TypeSafeForm = getTypeSafeForm<PickingOrderFulfillInput>(form);
  const formInstance = TypeSafeForm.formInstance;

  const onDivideOrCombine = (variantId: string) => {
    setIdForModal(variantId);
    setOpenDivideOrCombineModal(true);
  };
  const onDivideOrCombineCancel = () => {
    setIdForModal(null);
    setOpenDivideOrCombineModal(false);
  };

  useEffect(() => {
    if (open) {
      const pickingDisabledOrderLines = orderLines.filter((orderLine) => orderLine.remainOuterVirtualAllocate > 0);
      const orderLinesForPicking: OrderLineListForFulfill_orderLines_edges_node[] = pickingDisabledOrderLines.reduce(
        (acc, orderLine) => {
          const parsedVariantIds = acc.map((parsedOrderLine) => parsedOrderLine.variant.id);
          const { variant } = orderLine;
          if (parsedVariantIds.includes(variant.id)) {
            const idx = acc.findIndex((item) => item.variant.id === variant.id);
            acc[idx].remainOuterVirtualAllocate += orderLine.remainOuterVirtualAllocate;
          } else {
            acc.push({ ...orderLine });
          }
          return acc;
        },
        []
      );
      setDataSource(orderLinesForPicking);

      // 남은 가상 예약 재고 수량이 0인 주문건만 피킹 가능
      const pickingAvailableOrderLines = orderLines.filter((orderLine) => orderLine.remainOuterVirtualAllocate === 0);
      const orderLineIds = pickingAvailableOrderLines.map((orderLine) => orderLine.id);
      formInstance.setFields([{ name: "orderLineIds", value: orderLineIds }]);
    }
  }, [open, orderLines]);

  const columns = getPickingOrderFulfillTableSettings({ onDivideOrCombine });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <Modal
      forceRender
      destroyOnClose
      width={800}
      title="이너박스 재고 부족 알림"
      open={open}
      cancelText="뒤로"
      okText="피킹 진행"
      onOk={form.submit}
      okButtonProps={{ loading }}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        form={formInstance}
        layout="vertical"
        name="picking-order-fulfill-form"
        validateTrigger="onSubmit"
        onFinish={() => {
          const input = TypeSafeForm.getFieldsValue();
          onSubmit(input);
        }}
      >
        <Space direction="vertical" size="large">
          <Space direction="vertical" size={0}>
            <Typography>
              피킹 진행하려는 주문 중, 다음 제품의 이너박스 재고가 부족해 해당 제품을 주문한 건을 제외하고 피킹이
              진행됩니다.
            </Typography>
            <Typography>
              해당 건의 피킹을 진행하기 위해서는 아우터박스 재고를 소분한 뒤 다시 피킹을 진행해야 합니다.
            </Typography>
          </Space>

          <Typography>계속 진행하시겠습니까?</Typography>

          <Table
            {...commonTableProps}
            loading={loading}
            columns={columns}
            dataSource={dataSource}
            scroll={{ x: tableWidthSum, y: 500 }}
            locale={{
              emptyText: (
                <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description="재고가 부족한 이너박스 제품이 없습니다." />
              ),
            }}
          />
        </Space>
      </Form>

      {!!idForModal && (
        <StockDivideOrCombineModal
          open={openDivideOrCombineModal}
          loading={loading}
          fixedMode="divide"
          productVariantId={idForModal}
          onClose={onDivideOrCombineCancel}
        />
      )}
    </Modal>
  );
};
</file>

