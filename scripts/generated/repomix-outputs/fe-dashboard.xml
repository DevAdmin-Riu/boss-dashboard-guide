import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopInfo_shop_stoppedReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { FilterPageProps, ListSettings } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Typography } from "antd";
import React from "react";

import {
  SalesStatByProductForBrandList,
  SalesStatByProductForBrandList_salesStatsByProductForBrand,
  SalesStatByProductForBrandListVariables,
} from "../../api/types/SalesStatByProductForBrandList";
import {
  createFilterStructure,
  SalesStatByProductForBrandFilterKeys,
  SalesStatByProductForBrandFilterOpts,
} from "./filters";
import { getSalesStatByProductForBrandListTableSettings } from "./SalesStatByProductForBrandListTableSettings";

export interface SalesStatByProductForBrandListPageProps
  extends FilterPageProps<SalesStatByProductForBrandFilterKeys, SalesStatByProductForBrandFilterOpts> {
  data: SalesStatByProductForBrandList_salesStatsByProductForBrand[];
  queryVariablesWithoutPagination: SalesStatByProductForBrandListVariables;
  loading: boolean;
  fetchForDownload: (
    variables?: Partial<SalesStatByProductForBrandListVariables>
  ) => Promise<ApolloQueryResult<SalesStatByProductForBrandList>>;
  onUpdateListSettings: (key: keyof ListSettings<string>, value: any) => void;
  settings: ListSettings<string>;
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[];
}

export const SalesStatByProductForBrandListPage: React.FC<SalesStatByProductForBrandListPageProps> = (props) => {
  const {
    data,
    loading,
    fetchForDownload,
    queryVariablesWithoutPagination,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
  } = props;
  const filterStructure = createFilterStructure(filterOpts);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const columns = getSalesStatByProductForBrandListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "salesStatsByBrand",
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.salesStatsByProductForBrand}</Typography.Title>
          </Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={loading}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <PatchedColumnsTable<SalesStatByProductForBrandList_salesStatsByProductForBrand>
            {...commonTableProps}
            ref={tableRef}
            loading={loading}
            rowKey={(record) => `${record.variant.id}-${record.vendorInfo}`}
            columns={pickerSelectedColumns}
            dataSource={data}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
          />
        </Card>
      </Space>
    </>
  );
};
