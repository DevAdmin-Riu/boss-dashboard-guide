              <ConfirmButton
                disabled={disabled}
                onClick={onSave}
                transitionState={state}
                data-test="button-bar-confirm"
                onTransitionToDefault={() => appAction.setDocked(true)}
              >
                {labels?.save || buttonText.save}
              </ConfirmButton>
            </CardContent>
          </Card>
        </>
      </div>
    </Portal>
  ) : null;
};
export default SaveButtonBar;
