  const isAllStatus = status === PurchaseOrderLineUrlEnum.ALL;
  const eventTypeFilter = {
    ...createOptionsField(
      displayOrder++,
      PurchaseOrderLineFilterKeys.eventType,
      filterMsg.purchaseOrderEventType,
      opts.eventType.value,
      true,
      purchaseOrderLineEventTypeEnumChoices(isB2b).filter((status) =>
        getPoEventTypeFromPoLineRouteParams(routeParams).includes(status.value)
      )
    ),
    active: opts.eventType.active,
    isRequired: true,
  };

  // 상태 필터 - 선택할 수 있는 상태 옵션이 1개 이상인 경우 표시
  const poLineStatusEnumChoices = getPurchaseOrderLineStatusEnumChoices(isB2b).filter((statusChoice) => {
    // 재고발주가 아닌 경우 검수/입고 관련 상태 제외
