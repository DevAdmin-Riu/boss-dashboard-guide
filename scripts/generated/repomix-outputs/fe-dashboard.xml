    active: opts.pvEstimateSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(0, PvEstimateListFilterKeys.brandSearch, "요청 브랜드", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };
