export type CollectionBasicInfoUpdateForm = Pick<
  CollectionInput,
  "name" | "slug" | "backgroundImage" | "backgroundImageAlt"
>;

export interface CollectionVisibilityUpdateForm extends Pick<CollectionInput, "isPublished" | "publicationDate"> {
  isFeatured: boolean;
}

interface CollectionDetailsPageProps extends PaginateListProps {
  collection: CollectionDetails_collection;
  isFeatured: boolean;
  editMode: CollectionDetailsEditModeEnum;
  onEdit: (mode: CollectionDetailsEditModeEnum) => void;
  onEditCancel: () => void;
  onBasicInfoUpdate: (formData: CollectionBasicInfoUpdateForm) => void;
  onVisibilityUpdate: (formData: CollectionVisibilityUpdateForm) => void;
  onCollectionRemove: () => void;
  onProductUnassign: (id: string, productNameForModal: string) => void;
  onProductsUnassign: (ids: string[]) => void;
  onBack: () => void;
}

const CollectionDetailsPage: React.FC<CollectionDetailsPageProps> = ({
  collection,
  disabled,
  isFeatured,
  editMode,
  onEdit,
  onEditCancel,
  onBasicInfoUpdate,
  onVisibilityUpdate,
  onCollectionRemove,
  onBack,
  ...collectionProductsProps
}: CollectionDetailsPageProps) => {
  const [basicInfoForm] = Form.useForm<CollectionBasicInfoUpdateForm>();
  const [visibilityForm] = Form.useForm<CollectionVisibilityUpdateForm>();
  const VisibilityTypeSafeForm = getTypeSafeForm<CollectionVisibilityUpdateForm>(visibilityForm);
  const isEditing = utils.isEmpty(editMode) === false;

  const basicInfoInitialValues: CollectionBasicInfoUpdateForm = {
    name: collection.name,
    slug: collection.slug || "",
    backgroundImage: toUploadFormInitialValue(collection.backgroundImage, "alt"),
    backgroundImageAlt: collection.backgroundImage?.alt,
  };
  const visibilityInitialValues: CollectionVisibilityUpdateForm = {
    isFeatured,
    isPublished: collection.isPublished,
    publicationDate: collection.publicationDate,
  };

  useEffect(() => {
    basicInfoForm.resetFields();
    visibilityForm.resetFields();
  }, [editMode]);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.collections}</AppHeader>
