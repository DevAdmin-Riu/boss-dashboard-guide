import { ApolloQueryResult } from "@apollo/client";
import { buttonText } from "@assets/messages/buttonText";
import { commonMsg } from "@assets/messages/commonMsg";
import { commonErrorMsg } from "@assets/messages/errors/commonError";
import { useListQuerySkip } from "@hooks/useListQuerySkip";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { newLineStr } from "@src/app/components/ColumnHelper/columnConstant";
import { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { getDateByFormat } from "@src/app/providers/DateProvider";
import filterMsg from "@src/global/assets/messages/filters";
import { MissingRenderExcelError } from "@src/global/core/errors/MissingRenderExcelError";
import {
  calculateTableHeaderMaxRowDepth,
  catchForExcelDownloadError,
  excelDownload,
  generateExcelHeaderAndMerges,
  getExcelColumnTitle,
  makeHeaderRowsAndMerges,
} from "@utils/excel/excelDownload";
import {
  destroyDownloadingMessage,
  showDownloadingMessage,
  showNotificationSuccess,
  showNotificationWarn,
} from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Checkbox, Collapse, Row, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React, { useEffect, useMemo, useRef, useState } from "react";
import { useLocation } from "react-router";

import SpreadFilterContent from "./SpreadFilterContent";
import { IFilter, IFilterElement } from "./types";
import useFilter from "./useFilter";

export const makeOneRowForExcel = (data, columnsForDownload, index) => {
  const returnData: { [key: string]: any } = {};

  columnsForDownload.forEach((column) => {
    if (column.doNotRenderExcel) {
      return;
    }
    const title = getExcelColumnTitle(column);
    const key = title;
    if (key) {
      const defaultValue = "-";
      let renderValue;

      // column.key가 있으면 데이터에서 직접 값을 가져올 수 있는지 확인
      if (column.key && data[column.key] !== undefined && !column.render && !column.renderExcel) {
        renderValue = data[column.key];
      } else if (column.render && column.renderExcel) {
        // renderExcel, render 둘다 정의되어 있으면 renderExcel을 우선한다.
        renderValue = column.renderExcel(data, index);
        returnData[key] = utils.isEmpty(renderValue, true) ? defaultValue : renderValue;
        // 이 이상 진행할 필요 없음.
        return;
      } else if (column.render) {
        renderValue = column.render(undefined, data);
      }
      if (typeof renderValue !== "string" && typeof renderValue !== "number") {
        // renderValue가 string도 number도 아닌 경우 아래 실행
        // renderExcel이 정의되어 있지 않다면? error가 발생된다.
        try {
          renderValue = column.renderExcel(data, index);
        } catch (e) {
          throw new MissingRenderExcelError(column.key);
        }
      }
      returnData[key] = utils.isEmpty(renderValue, true) ? defaultValue : renderValue;
    }
  });

  return returnData;
};
const parseForDownload = (
  res: ApolloQueryResult<any>,
  dataKey: string,
  columnsForDownload: DownloadableColumnsType<any>,
  processNodesToDataType?: (nodes: any[]) => any[],
  makeChildrenFlat?: boolean
) => {
  const resData = res.data[dataKey];
  // refetch의 결과가 edges로 되어있는 경우와 아닌 경우가 있음. ex) 가맹본부 어드민 > 협력사 별 채무 관리 리스트에서는 first, edges 없이 데이터 array 형태로 바로 리턴 됨.
  let dataNodes = [];
  if ("edges" in resData) {
    dataNodes = res.data[dataKey].edges.map((edge) => edge.node);
  } else {
    dataNodes = res.data[dataKey];
  }
  if (processNodesToDataType) {
    dataNodes = processNodesToDataType(dataNodes);
  }
  if (makeChildrenFlat) {
    const dataNodesChildrenFlat = [];
    dataNodes.forEach((node) => {
      dataNodesChildrenFlat.push(node);
      if (node.children) {
        node.children.forEach((child) => {
          dataNodesChildrenFlat.push(child);
        });
      }
    });
    dataNodes = dataNodesChildrenFlat;
  }

  // 이름은 columns지만 실제론 rows..
  const columns = [];
  dataNodes.forEach((data, index) => {
    const row = makeOneRowForExcel(data, columnsForDownload, index);
    columns.push(row);
  });

  if (!columns || columns.length === 0) {
    return { columns: [], header: [], merges: [] };
  }
  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
};

interface SpreadFilterProps<
  TFilterKeys extends string = string,
  TVariables = any,
  TResult = any,
  TResultNode = any,
  TDataType = any
> {
  menu: IFilter<TFilterKeys>;
  currencySymbol: string;
  currentTab?: number;
  tabActionButtons?: React.ReactNode;
  onAll?: () => void;
  onFilterChange: (filter: Array<IFilterElement<string>>) => void;
  onFilterReset?: () => void;
  isDownloadable?: boolean;
  excelDownloadProps?: DownloadRelatedProps<TVariables, TResult, TResultNode, TDataType>;
  validateQueryClick?: () => boolean;
}

// isOnlyChildTitle를 true로 할때는 조심해야함. title이 같은 값이 있는 경우 1개만 나옴.
export const flattenColumns = (
  columns: DownloadableColumnsType,
  isOnlyChildTitle: boolean = false,
  includeFullPath: boolean = false
): DownloadableColumnType[] => {
  const flattened: DownloadableColumnType[] = [];
  const titleCounter: { [key: string]: number } = {};

  const flatten = (cols: DownloadableColumnsType, parentPath: string[] = []) => {
    for (const col of cols) {
      if (col.doNotRenderExcel) {
        continue;
      }
      if ("children" in col && col.children.length > 0) {
        // children이 있으면 재귀적으로 처리
        const colTitle = getExcelColumnTitle(col) as string;
        flatten(col.children, [...parentPath, colTitle]);
      } else {
        // 리프 노드만 추가
        const colCopy = { ...col };
        const colTitle = getExcelColumnTitle(col) as string;

        if (isOnlyChildTitle) {
          colCopy.title = colTitle;
        } else if (includeFullPath && parentPath.length > 0) {
          // 전체 경로를 포함
          colCopy.title = `[${parentPath.join(" > ")}]${newLineStr(colTitle)}`;
        } else if (parentPath.length > 0) {
          // 직접 부모만 포함 (기본 동작)
          const directParent = parentPath[parentPath.length - 1];
          colCopy.title = `[${directParent}]${newLineStr(colTitle)}`;
        } else {
          colCopy.title = colTitle;
        }

        // 중복된 title 처리
        const baseTitle = colCopy.title as string;
        if (titleCounter[baseTitle]) {
          titleCounter[baseTitle]++;
          colCopy.title = `${baseTitle} (${titleCounter[baseTitle]})`;
        } else {
          titleCounter[baseTitle] = 1;
        }

        flattened.push(colCopy);
      }
    }
  };

  flatten(utils.deepCopy(columns));
  return flattened;
};

const SpreadFilter = <
  TKeys extends string = string,
  TVariables = any,
  TResult = any,
  TResultNode = any,
  TDataType = any
>(
  props: SpreadFilterProps<TKeys, TVariables, TResult, TResultNode, TDataType>
) => {
  const {
    menu,
    currencySymbol,
    currentTab,
    onAll,
    onFilterChange,
    onFilterReset,
    tabActionButtons,
    isDownloadable = false,
    excelDownloadProps,
    validateQueryClick,
  } = props;

  const [isMultipleSearch, setIsMultipleSearch] = useState(true);

  const {
    queryVariablesWithoutPagination = {} as TVariables,
    columnsForDownload = [],
    dataKey = "",
    fetchForDownload = () => Promise.resolve({} as ApolloQueryResult<any>),
    processNodesToDataType = undefined,
    makeChildrenFlat = false,
  } = excelDownloadProps || {};
  const componentRef = useRef<HTMLDivElement>();
  const queryBtnRef = useRef<HTMLButtonElement>();
  const location = useLocation();
  const [data, dispatch, filterClear, filterReset] = useFilter(menu);
  const [updatedTime, setUpdatedTime] = useState<Moment>(null);
  const [printBtnLoading, setPrintBtnLoading] = useState<boolean>(false);
  const [queryClickLocked, setQueryClickLocked] = useState<boolean>(false);
  const { skipState: listQuerySkipState } = useListQuerySkip();

  // 최초 진입 시 비어있는 페이지는 캐싱되는 데이터와 함께 업데이트 시각도 리덕스에 저장
  const initialListQuerySkip = listQuerySkipState.initialValue === true;
  const updatedTimeToDisplay = initialListQuerySkip
    ? listQuerySkipState.updatedAtBySearchStr[location.search] || "-"
    : getDateByFormat(updatedTime);

  const isMobile = utils.checkMobile();

  useEffect(() => {
    setIsMultipleSearch(!isMobile);
  }, [isMobile]);

  const activeFilterCount = useMemo(
    () => data.reduce((acc, filterElement) => acc + (filterElement.active ? 1 : 0), 0),
    [data]
  );

  const validateActiveFilterValue = (filter: Array<IFilterElement<string>>) => {
    const activeFilter = filter.filter((filterElement) => filterElement.active);
    const emptyValueFilterAry = activeFilter.filter(
      (filterElement) => filterElement.value.length === 0 || filterElement.value.every((v) => utils.isEmpty(v, true))
    );
    if (emptyValueFilterAry.length > 0) {
      const filterLabelsText = emptyValueFilterAry.map((filterElement) => filterElement.label).join(", ");
      showNotificationWarn(`[${filterLabelsText}] 필터 값을 입력 또는 선택한 뒤 조회해 주세요.`);
      return false;
    }
    return true;
  };

  const validateFilters = (): boolean => {
    const isValid = validateQueryClick ? validateQueryClick() : true;

    if (!isValid) {
      return false;
    }
    const validateAry = [];
    validateAry.push(validateActiveFilterValue(data));
    if (validateAry.findIndex((v) => v === false) >= 0) {
      return false;
    }
    return true;
  };

  const onPrintClick = () => {
    const isValidFilters = validateFilters();
    if (!isValidFilters) {
      return;
    }

    setPrintBtnLoading(true);
    showDownloadingMessage();
    fetchForDownload(queryVariablesWithoutPagination)
      .then((res) => {
        // 멀티레벨 헤더 처리 체크
        let columnsToUse = columnsForDownload;
        let headerResult = null;
        let mergesResult = null;
        let skipOriginHeader = false;

        if (excelDownloadProps?.isMultiLevel) {
          try {
            // 기존의 generateExcelHeaderAndMerges 함수 사용
            const maxRow = calculateTableHeaderMaxRowDepth(columnsForDownload);

            if (maxRow > 2) {
              // 3단계 이상인 경우 기존 함수 사용
              const { header, merges } = generateExcelHeaderAndMerges(columnsForDownload, maxRow);

              const cleanHeaders = header.map((row) =>
                row.map((cell) => {
                  if (typeof cell === "string") {
                    if (cell.startsWith("=")) {
                      return "'" + cell;
                    }
                    return cell;
                  }
                  return cell;
                })
              );

              // 플랫한 컬럼 생성 (리프 컬럼만)
              const flatColumns = flattenColumns(columnsForDownload);

              // 병합 정보 검증
              const validMerges = merges.filter((merge) => {
                const isValid =
                  merge.s.r >= 0 &&
                  merge.s.c >= 0 &&
                  merge.e.r < maxRow &&
                  merge.e.c < flatColumns.length &&
                  merge.s.r <= merge.e.r &&
                  merge.s.c <= merge.e.c;
                if (!isValid) {
                  console.warn("잘못된 병합 정보:", merge);
                }
                return isValid;
              });

              columnsToUse = flatColumns;
              headerResult = cleanHeaders;
              mergesResult = validMerges;
              skipOriginHeader = true;
            }
          } catch (error) {
            console.warn("멀티레벨 헤더 처리 중 오류 발생, 기존 방식으로 처리합니다:", error);
          }
        }

        // 기존 방식으로 처리 (멀티레벨이 비활성화되었거나 실패한 경우)
        if (!headerResult) {
          const flattenedColumns = flattenColumns(columnsToUse);
          const { columns, header, merges } = parseForDownload(
            res,
            dataKey,
            flattenedColumns,
            processNodesToDataType,
            makeChildrenFlat
          );

          if (!columns || columns.length <= 0) {
            showNotificationWarn("출력할 데이터가 없습니다.");
            return;
          }

          // header의 0번째 값가 1번째 값이 완전히 일치하는 경우.
          if (header.length > 1 && header[0].every((v, i) => v === header[1][i])) {
            excelDownload({ title: "검색 결과 리스트", columns });
          } else {
            excelDownload({ title: "검색 결과 리스트", columns, header, merges, skipOriginHeader: true });
          }
        } else {
          // 멀티레벨 헤더로 처리
          const { columns } = parseForDownload(res, dataKey, columnsToUse, processNodesToDataType, makeChildrenFlat);

          if (!columns || columns.length <= 0) {
            showNotificationWarn("출력할 데이터가 없습니다.");
            return;
          }

          excelDownload({
            title: "검색 결과 리스트",
            columns,
            header: headerResult,
            merges: mergesResult,
            skipOriginHeader,
          });
        }

        if (res?.data[dataKey].edges?.length < res?.data[dataKey].totalCount) {
          showNotificationWarn(commonErrorMsg.maxLimitIssue);
        } else {
          showNotificationSuccess(commonMsg.downloadedToXls);
        }
      })
      .catch((e) => {
        catchForExcelDownloadError(e);
      })
      .finally(() => {
        setPrintBtnLoading(false);
        destroyDownloadingMessage();
      });
  };

  useEffect(() => {
    const handleEnterPress = (event) => {
      if (event.key === "Enter") {
        if (event.target.tagName === "TEXTAREA" && !event.ctrlKey && isMultipleSearch) {
          // `textarea`에서는 줄바꿈 허용
          return;
        }

        if (queryBtnRef.current) {
          queryBtnRef.current.click();
        }
      }
    };

    // `ref`가 정의된 경우에만 이벤트 리스너 추가
    const currentRef = componentRef.current;
    if (currentRef) {
      currentRef.addEventListener("keydown", handleEnterPress);
    }

    // Clean-up: 이벤트 리스너 제거
    return () => {
      if (currentRef) {
        currentRef.removeEventListener("keydown", handleEnterPress);
      }
    };
  }, [isMultipleSearch]);

  const setUpdatedNow = () => {
    if (initialListQuerySkip) {
      return;
    }
    setUpdatedTime(moment());
  };

  // 필터 정보가 변경(탭이 변경되는 시점과 동일)될 때마다 해당 탭에 맞는 필터로 초기화
  useEffect(() => {
    filterReset();
    setUpdatedNow();
  }, [currentTab, location.pathname]);

  const onResetClick = () => {
    // 탭 존재하는 필터(리스트 페이지)인 경우, 전체 탭으로 이동하는 것을 초기화로 간주
    if (!!onAll) {
      onAll();
    } else {
      if (!!onFilterReset) {
        onFilterReset();
      }
      filterClear();
    }
    setUpdatedNow();
  };

  const onQueryClick = (e: React.MouseEvent<HTMLElement, MouseEvent>) => {
    // 중복 조회 클릭 방지(0.5초)
    if (queryClickLocked) {
      return;
    }
    setQueryClickLocked(true);
    setTimeout(() => setQueryClickLocked(false), 500);

    e.preventDefault();

    const isValidFilters = validateFilters();
    if (!isValidFilters) {
      return;
    }

    setUpdatedNow();
    onFilterChange(data);
  };

  // currentTab이 존재하지 않는 경우(필터의 탭이 없는 경우)는 초기화 버튼 미노출
  const currentTabExist = utils.isEmpty(currentTab) === false;
  const showResetBtn = currentTabExist || !!onFilterReset;
  const resetBtnDisabled = !!onAll && currentTab === 0;
  const actionButtons = isMobile ? (
    <Space direction="vertical" align="end">
      <Checkbox
        checked={isMultipleSearch}
        onChange={(e) => {
          setIsMultipleSearch(e.target.checked);
        }}
      >
        복수검색
      </Checkbox>
      {isDownloadable && (
        <Button
          size="small"
          type="default"
          onClick={onPrintClick}
          loading={printBtnLoading}
          disabled={listQuerySkipState.value}
        >
          {buttonText.excelDownload}
        </Button>
      )}
      <Button ref={queryBtnRef} size="small" type="primary" onClick={onQueryClick} loading={printBtnLoading}>
        {buttonText.query}
      </Button>
      {showResetBtn && (
        <Button
          size="small"
          type="default"
          disabled={resetBtnDisabled}
          onClick={onResetClick}
          loading={printBtnLoading}
        >
          {buttonText.clear}
        </Button>
      )}
      {tabActionButtons}
    </Space>
  ) : (
    <Space>
      {tabActionButtons}
      {isDownloadable && (
        <Button
          size="small"
          type="primary"
          onClick={onPrintClick}
          loading={printBtnLoading}
          disabled={listQuerySkipState.value}
        >
          {buttonText.excelDownload}
        </Button>
      )}
      {showResetBtn && (
        <Button
          size="small"
          type="default"
          disabled={resetBtnDisabled}
          onClick={onResetClick}
          loading={printBtnLoading}
        >
          {buttonText.clear}
        </Button>
      )}
      <Button ref={queryBtnRef} size="small" type="primary" onClick={onQueryClick} loading={printBtnLoading}>
        {buttonText.query}
      </Button>
    </Space>
  );

  return (
    <div ref={componentRef}>
      <Space direction="vertical">
        <Row justify="end" style={{ marginRight: 8 }}>
          <Typography.Text type="secondary" style={{ fontSize: 12 }}>
            업데이트 : {updatedTimeToDisplay}
          </Typography.Text>
        </Row>
        <Collapse defaultActiveKey={["1"]} collapsible="header">
          <Collapse.Panel
            key="1"
            header={
              <Typography>
                {filterMsg.cardTitle}({activeFilterCount})
              </Typography>
            }
            extra={actionButtons}
          >
            <SpreadFilterContent currencySymbol={currencySymbol} filters={data} onFilterPropertyChange={dispatch} />
          </Collapse.Panel>
        </Collapse>
      </Space>
    </div>
  );
};
