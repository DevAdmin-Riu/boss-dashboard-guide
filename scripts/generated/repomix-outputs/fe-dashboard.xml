}
export const pageContentViewPath = (routeParams: PageContentViewRouteParams) =>
  urlJoin(pageContentSectionUrl, routeParams.slug);
export const pageContentViewUrl = (routeParams: PageContentViewRouteParams) => pageContentViewPath(routeParams);
