import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import NoteForUnitPriceInfoModal from "@src/app/views/order/orders/components/NoteForUnitPriceInfoModal/NoteForUnitPriceInfoModal";
import {
  ProductVariantList,
  ProductVariantList_productVariants_edges_node,
  ProductVariantListVariables,
} from "@src/app/views/product/products/api/types/ProductVariantList";
import {
  StockListViewRouteParams,
  StockListViewUrlQueryParams,
  StockListViewUrlSortField,
} from "@src/app/views/product/stock/urls";
import { trackInventoryPurchaseOrderLineKeys } from "@src/app/views/purchase/purchaseOrders/utils";
import { WarehouseSimpleList_warehouses_edges_node } from "@src/app/views/settings/warehouses/api/types/WarehouseSimpleList";
import { FilterPageProps, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { isStoppedSalesStatus, isWillBeStoppedSalesStatus } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Divider, Row, Space, Typography } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import React, { useEffect, useMemo, useState } from "react";
import { useParams } from "react-router";

import { StockListModalModeEnum } from "../../views/StockListView/StockListView";
import { createFilterStructure, StockFilterKeys, StockFilterOpts } from "./filters";
import { createSorterStructure } from "./sorters";
import { getStockListTableSettings } from "./StockListTableSettings";

export interface StockListPageProps
  extends PaginateListProps,
    FilterPageProps<StockFilterKeys, StockFilterOpts>,
    SortPage<StockListViewUrlSortField> {
  params: StockListViewUrlQueryParams;
  shop: ShopInfo_shop;
  currencySymbol: string;
  variants: ProductVariantList_productVariants_edges_node[];
  warehouses: WarehouseSimpleList_warehouses_edges_node[];
  openModalWithoutNavigate: (modalMode: StockListModalModeEnum, idForModal?: string) => void;
  openStockDetailEventModal: (variantId: string, stockId: string) => void;
  onUpdateStockProduct: (productId: string, variantId?: string, brandProductVariantId?: string) => void;
  onPurchaseOrderCreate: () => void;
  queryVariablesWithoutPagination: ProductVariantListVariables;
  fetchForDownload: (variables?: ProductVariantListVariables) => Promise<ApolloQueryResult<ProductVariantList>>;
  isStaffFbvMode: boolean;
  isHqStaffFbvMode: boolean;
  isVendorStaffFbvMode: boolean;
  isFbv: boolean;
}

export const makeCautionUiForGenerateProductVariantMonthlySales = (title) => (
  <Space direction="vertical">
    <Typography.Text strong>{title}</Typography.Text>
    <Divider />
    <Divider />
    <Space direction="vertical" size="small">
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        1. 데이터가 많을 경우 처리 시간이 길어질 수 있습니다.
      </Typography.Text>
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        2. 월별 판매량 데이터 집계가 진행 중일 때, 다른 데이터 집계를 중복해서 요청하지 마세요.
      </Typography.Text>
      <Typography.Text type="danger" style={{ fontSize: "14px" }}>
        3. 매월 오전 1시에는 전월에 발생한 상품 판매량 데이터 집계가 자동으로 처리됩니다. (수동 상품 판매량 집계 불가
        시간: AM 00:00:00 ~ AM 01:59:59)
      </Typography.Text>
    </Space>
  </Space>
);

const makeNewDataSource = (
  nodes: ProductVariantList_productVariants_edges_node[]
): ProductVariantList_productVariants_edges_node[] =>
  nodes.map((variant) => {
    const { defaultVariantVendor, productVariantVendors } = variant;
    if (utils.isEmpty(defaultVariantVendor)) {
      return variant;
    }
    return {
      ...variant,
      productVariantVendors,
    };
  });

const StockListPage: React.FC<StockListPageProps> = (props) => {
  const {
    disabled,
    variants,
    currentTab,
    filterOpts,
    tabs,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    openModalWithoutNavigate,
    onPurchaseOrderCreate,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onUpdateListSettings,
  } = props;
  const routeParams = useParams<StockListViewRouteParams>();
  const stockAdjustmentDisabled = routeParams.type === "type-a";
  const filterStructure = createFilterStructure(
    filterOpts,
    props.isFbv,
    props.isHqStaffFbvMode,
    props.isVendorStaffFbvMode
  );
  const sorterStructure = createSorterStructure();
  const [dataSource, setDataSource] = useState<ProductVariantList_productVariants_edges_node[]>(variants);
  const [selectedRowIds, setSelectedRowIds] = useState<string[]>([]);
  const [showNoteForUnitPrice, setShowNoteForUnitPrice] = useState<string | null>(null);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  useEffect(() => {
    const parsedDataSource = makeNewDataSource(variants);
    setDataSource(parsedDataSource);
  }, [variants]);

  const onShowNoteForUnitPrice = (noteForUnitPrice: string) => {
    setShowNoteForUnitPrice(noteForUnitPrice);
  };

  const purchaseOrderBtnDisabled = disabled || selectedRowIds.length === 0;
  const onPurchaseOrderClick = () => {
    localStorage.setItem(trackInventoryPurchaseOrderLineKeys, JSON.stringify(selectedRowIds));
    onPurchaseOrderCreate();
  };

  const rowSelection: TableRowSelection<ProductVariantList_productVariants_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys, _selectedRows) => setSelectedRowIds(selectedRowKeys as string[]),
    getCheckboxProps: (record) => {
      const { salesStatus, isInner } = record;
      const isStopped = isStoppedSalesStatus(salesStatus);
      const isWillBeStopped = isWillBeStoppedSalesStatus(salesStatus);
      const props = {
        disabled: isStopped || isWillBeStopped || isInner || utils.isEmpty(record?.defaultVariantVendor?.id),
      };
      return props;
    },
  };

  const columns = useMemo(
    () => getStockListTableSettings(props, routeParams, onShowNoteForUnitPrice),
    [
      props.shop,
      props.warehouses,
      props.isHqStaffFbvMode,
      props.isVendorStaffFbvMode,
      props.isFbv,
      routeParams.type,
      openModalWithoutNavigate,
      props.openStockDetailEventModal,
      props.onUpdateStockProduct,
      onShowNoteForUnitPrice,
    ]
  );

  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);

  const handleSave = (columns: string[]) => onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "productVariants",
    processNodesToDataType: makeNewDataSource,
    isMultiLevel: true,
  };

  let pageTitle: string = "";
  let extraUi: React.ReactNode = null;
  switch (routeParams.type) {
    case "type-a":
      pageTitle = sectionNames.stocksA;
      extraUi = (
        <Button type="primary" shape="round" disabled={purchaseOrderBtnDisabled} onClick={onPurchaseOrderClick}>
          선택 상품 발주
        </Button>
      );
      break;
    case "type-b":
      pageTitle = sectionNames.stocksB;
      extraUi = (
        <Button
          type="primary"
          shape="round"
          icon={<DownloadOutlined />}
          onClick={() => openModalWithoutNavigate(StockListModalModeEnum.PrintStockDetailEventList)}
        >
          조정내역 다운로드
        </Button>
      );
      break;
  }

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{pageTitle}</Typography.Title>
        </Col>
        {extraUi && (
          <Col>
            <Space direction="horizontal" size="small">
              {extraUi}
            </Space>
          </Col>
        )}
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          onFilterChange={onFilterChange}
          filterStructure={filterStructure}
          tabExtra={
            <Space>
              <ColumnPicker
                columns={pickColumns}
                loading={disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
              <SorterDropdown sorterStructure={sorterStructure} sort={props.sort} onSort={props.onSort} />
            </Space>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={disabled}
          rowSelection={stockAdjustmentDisabled && rowSelection}
          columns={pickerSelectedColumns}
          dataSource={dataSource}
          footer={() => <TableListFooter {...props} />}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
        />
      </Card>

      <NoteForUnitPriceInfoModal
        open={showNoteForUnitPrice !== null}
        onCancel={() => setShowNoteForUnitPrice(null)}
        showNoteForUnitPrice={showNoteForUnitPrice}
      />
    </Space>
  );
};
export default StockListPage;
</file>

