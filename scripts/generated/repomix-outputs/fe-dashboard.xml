      return [requestedStatusFilter, acceptedStatusFilter, reqAdditionalStatusFilter];
    case ReqBossProductUrlEnum.ESTIMATE:
      return [vendorPriceStatusFilter, brandPriceStatusFilter, reqEstimateFixStatusFilter];
    case ReqBossProductUrlEnum.CONFIRMED:
      return [pendingConfirmStatusFilter, confirmedStatusFilter];
    case ReqBossProductUrlEnum.ALL:
      return [
        requestedStatusFilter,
        acceptedStatusFilter,
        reqAdditionalStatusFilter,
        vendorPriceStatusFilter,
        brandPriceStatusFilter,
        reqEstimateFixStatusFilter,
        pendingConfirmStatusFilter,
        confirmedStatusFilter,
        completedStatusFilter,
        canceledStatusFilter,
      ];
    default:
      return [];
  }
};

export function createFilterStructure(
  opts: HqReqBossProductListListFilterOpts,
  urlType: ReqBossProductUrlEnum
): IFilter<HqReqBossProductListFilterKeys> {
  const {
    requestProduct: {
      REQUEST_NO,
      PROGRESS_STATUS,
      REQUEST_CREATED_DATE,
      ACCEPTED_DATE,
      ADDITIONAL_REQUEST_DATE,
      QUOTATION_REQUEST_DATE,
      VENDOR_COST_PRICE_REGISTERED_DATE,
      QUOTATION_FIX_REQUEST_DATE,
      QUOTATION_REGISTERED_DATE,
      QUOTATION_CONFIRMED_DATE,
      REGISTERED_DONE_DATE,
    },
  } = columnNameConstant;

  const productSearchFilter = {
    ...createTextField(0, HqReqBossProductListFilterKeys.productSearch, "상품명", opts.productSearch.value),
    active: opts.productSearch.active,
  };
  const isExclusiveFilter = {
    ...createBooleanField(0, HqReqBossProductListFilterKeys.isExclusive, "전용여부", opts.isExclusive.value, {
      negative: "범용",
      positive: "전용",
    }),
    active: opts.isExclusive.active,
  };

  const requestNumberFilter = {
    ...createTextField(0, HqReqBossProductListFilterKeys.requestNumber, REQUEST_NO, opts.requestNumber.value),
    active: opts.requestNumber.active,
  };

  const statusFilter = {
    ...createOptionsField(
      0,
      HqReqBossProductListFilterKeys.status,
      PROGRESS_STATUS,
      opts.status.value,
      true,
      getListByUrlType(urlType)
    ),
    active: opts.status.active,
  };

  const requestedStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.requestedStatusAt,
      REQUEST_CREATED_DATE,
      opts.requestedStatusAt.value
    ),
    active: opts.requestedStatusAt.active,
  };
  const acceptedStatusAtFilter = {
    ...createDateField(0, HqReqBossProductListFilterKeys.acceptedStatusAt, ACCEPTED_DATE, opts.acceptedStatusAt.value),
    active: opts.acceptedStatusAt.active,
  };
  const reqAdditionalStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.reqAdditionalStatusAt,
      ADDITIONAL_REQUEST_DATE,
      opts.reqAdditionalStatusAt.value
    ),
    active: opts.reqAdditionalStatusAt.active,
  };
  const vendorPriceStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.vendorPriceStatusAt,
      QUOTATION_REQUEST_DATE,
      opts.vendorPriceStatusAt.value
    ),
    active: opts.vendorPriceStatusAt.active,
  };
  const brandPriceStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.brandPriceStatusAt,
      VENDOR_COST_PRICE_REGISTERED_DATE,
      opts.brandPriceStatusAt.value
    ),
    active: opts.brandPriceStatusAt.active,
  };
  const reqEstimateFixStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.reqEstimateFixStatusAt,
      QUOTATION_FIX_REQUEST_DATE,
      opts.reqEstimateFixStatusAt.value
    ),
    active: opts.reqEstimateFixStatusAt.active,
  };

  const pendingConfirmStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.pendingConfirmStatusAt,
      QUOTATION_REGISTERED_DATE,
      opts.pendingConfirmStatusAt.value
    ),
    active: opts.pendingConfirmStatusAt.active,
  };
  const confirmedStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.confirmedStatusAt,
      QUOTATION_CONFIRMED_DATE,
      opts.confirmedStatusAt.value
    ),
    active: opts.confirmedStatusAt.active,
  };

  const completedStatusAtFilter = {
    ...createDateField(
      0,
      HqReqBossProductListFilterKeys.completedStatusAt,
      REGISTERED_DONE_DATE,
      opts.completedStatusAt.value
    ),
    active: opts.completedStatusAt.active,
  };

  const specFilter = {
    ...createTextField(0, HqReqBossProductListFilterKeys.spec, "규격", opts.spec.value),
    active: opts.spec.active,
  };
  const materialFilter = {
    ...createTextField(0, HqReqBossProductListFilterKeys.material, "재질", opts.material.value),
    active: opts.material.active,
  };
  const colorFilter = {
    ...createTextField(0, HqReqBossProductListFilterKeys.color, "색상", opts.color.value),
    active: opts.color.active,
  };

  // 상품 요청
  if (urlType === ReqBossProductUrlEnum.REQUESTED) {
    // 가맹본부
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestedStatusAtFilter,
      acceptedStatusAtFilter,
      reqAdditionalStatusAtFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.ESTIMATE) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestedStatusAtFilter,
      vendorPriceStatusAtFilter,
      brandPriceStatusAtFilter,
      reqEstimateFixStatusAtFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.CONFIRMED) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestedStatusAtFilter,
      pendingConfirmStatusAtFilter,
      confirmedStatusAtFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.COMPLETED) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      requestedStatusAtFilter,
      completedStatusAtFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
    ]);
  } else if (urlType === ReqBossProductUrlEnum.ALL) {
    return utils.filterDisplayOrdering([
      requestNumberFilter,
      statusFilter,
      isExclusiveFilter,
      productSearchFilter,
      specFilter,
      materialFilter,
      colorFilter,
      requestedStatusAtFilter,
    ]);
  }
}
