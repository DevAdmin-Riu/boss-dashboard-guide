import { HqOrderLineList_orderLines_edges_node } from "../../api/types/HqOrderLineList";
import { vendorNameForNonFulfilledByVendor } from "../../views/HqOrderLineListView/filters";
import { HqOrderLineListPageProps } from "./HqOrderLineListPage";

const transformOrderLineVendor = (orderLine: HqOrderLineList_orderLines_edges_node) => {
  const isFulfilledByVendor = orderLine.isFulfilledByVendor;
  if (!isFulfilledByVendor) {
    return vendorNameForNonFulfilledByVendor;
  }
  return orderLine.vendor?.name || "-";
};

export function getHqOrderLineTableSettings(props: HqOrderLineListPageProps) {
  const { brand, onRowClick } = props;
  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);

  const orderNumberColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_COMPOSED_ID,
    align: "center",
    key: "orderNumber",
    width: 100,
    render: (_, record) => (
      <Typography.Link onClick={() => onRowClick(record.order.id)}>{record.order.composedIdWithPrefix}</Typography.Link>
    ),
    renderExcel: (record) => record.order.composedIdWithPrefix,
  };
  const orderLineComposedIdColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_LINE_COMPOSED_ID,
    align: "center",
    key: "orderLineComposedId",
    width: 120,
    render: (_, record) => record.composedIdWithPrefix,
  };
  const orderCreatedColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    title: columnNameConstant.order.ORDER_DATE,
    key: "orderCreated",
    align: "center",
    width: 120,
    render: (_, record) => <DateTime date={record.order.created} />,
    renderExcel: (record) => getDateByFormat(record.order.created),
  };
  const orderVendorColumn: DownloadableColumnType<HqOrderLineList_orderLines_edges_node> = {
    align: "center",
    title: columnNameConstant.vendor.VENDOR_NAME,
    key: "orderVendor",
