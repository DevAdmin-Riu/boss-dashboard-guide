              </FItem>
            </Col>
            <Col xs={24} sm={16}>
              <FItem
                label="박스타입"
                name="boxSizeType"
                rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
              >
                <Select
                  style={{ width: "50%" }}
                  options={boxSizeTypeChoices.filter(
                    (boxSize) => boxSize.value !== BoxSizeTypeEnum.BOX_SIZE_TYPE_EMPTY
                  )}
                  filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                  placeholder="박스타입(박스 크기) 선택"
                  onChange={(value) => {
                    if (!isDeliveryFeeAmountManualWatched) {
                      const separateBoxSizeTypeString = value.split("BOX_SIZE_TYPE_")[1];
                      const deliveryFee = boxSizeTypeValues.find(
                        (boxSizeType) => boxSizeType.slug === separateBoxSizeTypeString
