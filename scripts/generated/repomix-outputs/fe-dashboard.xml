  isTrueSet: (value) => value === "true" || value === true,
  isFileOrBlob: (obj: any): obj is File | Blob => {
    if (typeof Blob === "undefined" || typeof File === "undefined") {
      // 환경에 따라 File/Blob이 정의되지 않은 경우를 대비 (Node 환경 등) by GPT
      return false;
    }
    return obj instanceof File || obj instanceof Blob;
