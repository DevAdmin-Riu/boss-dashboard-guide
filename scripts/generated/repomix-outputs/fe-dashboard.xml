<file path="src/app/views/product/products/components/PvOrBpvManageEventModal.tsx">
import { UploadOutlined } from "@ant-design/icons";
import { formRuleMsg } from "@assets/messages/commonMsg";
import {
  BrandProductVariantManageEventInput,
  BrandProductVariantManageEventTypeEnum,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
} from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { utils } from "@utils/utils";
import { Button, Col, Form, Input, Modal, ModalProps, Radio, Row, Select, Space, Upload } from "antd";
import React, { useEffect } from "react";

export interface ProductVariantManageEventModalForm {
  manageEvent: ProductVariantManageEventInput | BrandProductVariantManageEventInput;
  needReason: boolean;
}

interface ManageEventChoices {
  label: string;
  value: ProductVariantManageEventTypeEnum | BrandProductVariantManageEventTypeEnum;
}

interface ProductVariantManageEventFormItemsProps {
  loading: boolean;
  manageEventType: ProductVariantManageEventTypeEnum | BrandProductVariantManageEventTypeEnum | null;
  choices: ManageEventChoices[];
  showNeedReasonRadio?: boolean;
  title?: string;
  reason?: string;
  file?: File | null;
}

interface ProductVariantManageEventModalProps extends ProductVariantManageEventFormItemsProps {
  open: boolean;
  isCreateMode: boolean;
  onManageEventChange?: (manageEvent: ProductVariantManageEventInput | BrandProductVariantManageEventInput) => void;
  onSubmit?: (formData: ProductVariantManageEventModalForm) => void;
  onCancel: () => void;
}

export const makePvOrBpvManageEventFormItems = ({
  loading,
  manageEventType,
  choices,
  showNeedReasonRadio = true,
  title = null,
}: ProductVariantManageEventFormItemsProps) => {
  const normFile = (e) => {
    if (Array.isArray(e)) {
      return e;
    }
    return e && e.file;
  };
  return (
    <Row gutter={[8, 0]}>
      {showNeedReasonRadio && (
        <Col xs={24} sm={12}>
          <Form.Item name="needReason" label="수정사유를 남기시겠습니까?" style={{ marginTop: 15 }}>
            <Radio.Group>
              <Radio value={true}>예</Radio>
              <Radio value={false}>아니오</Radio>
            </Radio.Group>
          </Form.Item>
        </Col>
      )}
      <Col xs={24} sm={12}>
        <Form.Item
          colon={false}
          wrapperCol={{ span: 24 }}
          name={["manageEvent", "type"]}
          label="분류"
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select
            disabled={loading || utils.isEmpty(manageEventType) === false}
            placeholder="분류 선택"
            options={choices}
          />
        </Form.Item>
      </Col>
      <Form.Item
        noStyle
        shouldUpdate={(prevValues, currentValues) => prevValues.needReason !== currentValues.needReason}
      >
        {({ getFieldValue }) => {
          const radioValue = getFieldValue("needReason");

          if (radioValue === true) {
            return (
              <>
                <Col xs={24} sm={24}>
                  <Form.Item
                    colon={false}
                    wrapperCol={{ span: 24 }}
                    name={["manageEvent", "title"]}
                    label="제목"
                    rules={[{ required: true, message: formRuleMsg.required }]}
                  >
                    <Input disabled={loading || utils.isEmpty(title) === false} placeholder="제목을 입력해 주세요." />
                  </Form.Item>
                </Col>
                <Col xs={24} sm={24}>
                  <Form.Item
                    colon={false}
                    wrapperCol={{ span: 24 }}
                    name={["manageEvent", "reason"]}
                    label="수정사유"
                    rules={[{ required: true, message: formRuleMsg.required }]}
                  >
                    <Input.TextArea disabled={loading} placeholder="수정사유를 입력해 주세요." />
                  </Form.Item>
                </Col>
              </>
            );
          } else {
            return null;
          }
        }}
      </Form.Item>
      <Col xs={24} sm={24}>
        <Form.Item name={["manageEvent", "file"]} label="참고자료" valuePropName="file" getValueFromEvent={normFile}>
          <Upload beforeUpload={() => false} maxCount={1}>
            <Button icon={<UploadOutlined />} type="primary">
              파일 추가
            </Button>
          </Upload>
        </Form.Item>
      </Col>
    </Row>
  );
};

export const ProductVariantManageEventModal: React.FC<ProductVariantManageEventModalProps> = (props) => {
  const {
    open,
    loading,
    isCreateMode,
    showNeedReasonRadio = true,
    manageEventType,
    choices,
    title,
    reason,
    file,
    onManageEventChange,
    onSubmit,
    onCancel,
  } = props;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<ProductVariantManageEventModalForm>(form);

  const initialValues: ProductVariantManageEventModalForm = {
    manageEvent: {
      type: manageEventType,
      title: title ? title : "",
      reason: reason ? reason : "",
      file: file ? file : null,
    },
    needReason: true,
  };

  useEffect(() => {
    form.resetFields();
  }, [open]);

  const modalTitle = `수정 사유 ${isCreateMode ? "추가" : "조회"}`;
  const commonModalProps: ModalProps = {
    open,
    title: modalTitle,
    destroyOnClose: true,
    forceRender: true,
    onCancel,
    footer: (
      <Space>
        <Button loading={loading} onClick={onCancel}>
          {isCreateMode ? "취소" : "닫기"}
        </Button>
        {isCreateMode && (
          <Button
            type="primary"
            loading={loading}
            onClick={() => {
              // 기존에 saleor에 존재하는 form의 change 이벤트를 antd의 Form 컴포넌트의 onValuesChange에 연동하면 각 Input의 입력 속도가 느려짐. 그래서 수정 중이 아닌 submit 시점에서 값을 onManageEventChange로 전달 후 submit 하도록 설정.
              if (onManageEventChange) {
                onManageEventChange(TypeSafeForm.getFieldValue("manageEvent"));
              }
              form.submit();
            }}
          >
            추가
          </Button>
        )}
      </Space>
    ),
  };

  // TODO: 관리 이력 리스트 페이지에서 이력 번호 클릭을 통해 조회할 경우, 전달되는 이력의 값을 readOnly로 표시
  if (isCreateMode === false) {
    return <Modal {...commonModalProps}></Modal>;
  }
  return (
    <Modal {...commonModalProps}>
      <Form
        layout="vertical"
        form={form}
        name="product-variant-manage-event-form"
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        {makePvOrBpvManageEventFormItems({
          loading,
          manageEventType,
          choices,
          showNeedReasonRadio,
          title,
        })}
      </Form>
    </Modal>
  );
};
