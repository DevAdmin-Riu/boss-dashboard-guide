                        <Descriptions.Item span={1} label={"제품형태"}>
                          {transformIsInner(variant.isInner)}
                        </Descriptions.Item>
                        <Descriptions.Item span={1} label={"식자재 여부"}>
                          {getCategoryTypeText(findValueInEnum(selectedProduct.category.type, CategoryTypeEnum))}
                        </Descriptions.Item>
                        <Descriptions.Item span={1} label={"규격"}>
                          {getProductSpecText(selectedProduct, 0)}
                        </Descriptions.Item>
                        <Descriptions.Item span={1} label={"입수량"}>
                          {makeProductQtyPerBoxText(variant)}
                        </Descriptions.Item>
                        <Descriptions.Item span={1} label={"재고 운영"}>
                          {getTransformedTrackInventoryVariantType(selectedProduct, 0)}
                        </Descriptions.Item>
                        <Descriptions.Item span={1} label={"공급 원가"}>
                          <NumberComponent value={variantPriceExcludeVat} />
                        </Descriptions.Item>
                        <Descriptions.Item span={2} label={"기준 판매가 정보"}>
                          <Space direction="vertical" size={0}>
                            <Row>
                              {columnNameConstant.product.BASE_SELL_PRICE}:{" "}
