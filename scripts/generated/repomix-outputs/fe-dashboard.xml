import {
  RequestBossProductDetails_requestBossProduct,
  RequestBossProductDetails_requestBossProduct_estimateList,
} from "../api/types/RequestBossProductDetails";

const { Item: FItem } = Form;

const defaultText = "-";

type TCreateForm = StrictOmit<RequestBossProductEstimateCreateInput, "request">;
type TUpdateForm = RequestBossProductEstimateUpdateInput;
type TEstimateForm = TCreateForm | TUpdateForm;

interface ReqBossProductEstimateModalProps {
  open: boolean;
  isCreateMode: boolean;
  loading: boolean;
  requestBossProduct: RequestBossProductDetails_requestBossProduct;
  onClose: () => void;
  boxSizeTypeValues: AttributeDetails_attribute_values[];
  selectedEstimate: RequestBossProductDetails_requestBossProduct_estimateList;
  setSelectedEstimateId: React.Dispatch<React.SetStateAction<string>>;
}

export const ReqBossProductEstimateModal: React.FC<ReqBossProductEstimateModalProps> = (props) => {
  const {
    open,
    isCreateMode,
    loading,
    requestBossProduct,
    onClose,
    boxSizeTypeValues,
    selectedEstimate,
    setSelectedEstimateId,
  } = props;
  const [form] = Form.useForm<TEstimateForm>();
  const { id: requestId, productName, isExclusive } = requestBossProduct;

  const isDeliveryFeeAmountManualWatched = Form.useWatch("isDeliveryFeeAmountManual", form) || false;
  const vendorProductPriceExcludeVatWatched = Form.useWatch("vendorProductPriceExcludeVat", form);
  const vendorDeliveryFeeExcludeVatWatched = Form.useWatch("vendorDeliveryFeeExcludeVat", form);
  const deliveryFeeExcludeVatWatched = Form.useWatch("deliveryFeeExcludeVat", form);
  const vendorConsignmentProductPriceExcludeVatWatched = Form.useWatch("vendorConsignmentProductPriceExcludeVat", form);
  const vendorConsignmentDeliveryFeeExcludeVatWatched = Form.useWatch("vendorConsignmentDeliveryFeeExcludeVat", form);
  const copperUnitDevCostExcludeVatWatched = Form.useWatch("copperUnitDevCostExcludeVat", form);
  const copperQtyForDevCostWatched = Form.useWatch("copperQtyForDevCost", form);
  const woodUnitDevCostExcludeVatWatched = Form.useWatch("woodUnitDevCostExcludeVat", form);
  const woodQtyForDevCostWatched = Form.useWatch("woodQtyForDevCost", form);
  const metalUnitDevCostExcludeVatWatched = Form.useWatch("metalUnitDevCostExcludeVat", form);
  const metalQtyForDevCostWatched = Form.useWatch("metalQtyForDevCost", form);
  const resinUnitDevCostExcludeVatWatched = Form.useWatch("resinUnitDevCostExcludeVat", form);
  const resinQtyForDevCostWatched = Form.useWatch("resinQtyForDevCost", form);
  const filmUnitDevCostExcludeVatWatched = Form.useWatch("filmUnitDevCostExcludeVat", form);
  const filmQtyForDevCostWatched = Form.useWatch("filmQtyForDevCost", form);
  const etcUnitDevCostExcludeVatWatched = Form.useWatch("etcUnitDevCostExcludeVat", form);
  const etcQtyForDevCostWatched = Form.useWatch("etcQtyForDevCost", form);
  const consignmentDeliveryFeeExcludeVatWatched = Form.useWatch("consignmentDeliveryFeeExcludeVat", form);
  const fileWatched = Form.useWatch("file", form) || null;
  const isFileEmptyWatched = Form.useWatch("isFileEmpty", form) || false;

  const showSavedFile =
    isFileEmptyWatched === false && utils.isEmpty(fileWatched) && utils.isEmpty(selectedEstimate?.fileUrl) === false;

  const initialValues: TEstimateForm = isCreateMode
