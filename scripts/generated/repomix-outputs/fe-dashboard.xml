import useNavigator from "@hooks/useNavigator";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import { useHqStaffUpdateMutation } from "@src/app/views/brand/brands/api/mutations";
import {
  useHqStaffSupervisorAssignMutation,
  useHqStaffSupervisorUnassignMutation,
  useStoreWorkerUpdateMutation,
} from "@src/app/views/brand/brandStore/api/mutations";
import { brandStoreDetailsViewUrl } from "@src/app/views/brand/brandStore/urls";
import BrandAccountDetailsPage from "@src/app/views/customer/customers/components/HqStaffDetailsPage";
import { hqBrandStoreDetailsViewUrl } from "@src/app/views/hqStaff/hqBrandStore/urls";
import {
  hqAccountHqStaffListViewUrl,
  hqAccountStoreWorkerListViewUrl,
  hqBrandAccountDetailsViewUrl,
} from "@src/app/views/hqStaff/hqSection/urls";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { getBrandId, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import React from "react";

import { useBrandAccountDetailsQuery } from "../api/queries";
import {
  brandAccountDetailsUrl,
  customerAddressesViewUrl,
  customerHqStaffListViewUrl,
  customerStoreWorkerListViewUrl,
} from "../urls";

interface BrandAccountDetailsViewProps {
  id: string;
}

export const BrandAccountDetailsView: React.FC<BrandAccountDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();

  const { user } = useAuth();
  const brandId = getBrandId(user);
  const isForBrand = Boolean(brandId);

  const { data: userData, loading: userQueryLoading } = useBrandAccountDetailsQuery({
    variables: { id },
  });

  const isHqStaff = maybe(() => userData?.user.isHqStaff);
  let backTargetUrl;
  // targetUrl을 isHqStaff, isForBrand에 따라 다르게 설정한다.
  if (isHqStaff && isForBrand) {
    backTargetUrl = hqAccountHqStaffListViewUrl;
  } else if (!isHqStaff && isForBrand) {
    backTargetUrl = hqAccountStoreWorkerListViewUrl;
  } else if (isHqStaff && !isForBrand) {
    backTargetUrl = customerHqStaffListViewUrl;
  } else {
    backTargetUrl = customerStoreWorkerListViewUrl;
  }

  const onClickBrandStore = (brandStoreId: string) => {
    isForBrand ? navigate(hqBrandStoreDetailsViewUrl(brandStoreId)) : navigate(brandStoreDetailsViewUrl(brandStoreId));
  };

  const onClickAccount = (brandStoreId: string) => {
    isForBrand ? navigate(hqBrandAccountDetailsViewUrl(brandStoreId)) : navigate(brandAccountDetailsUrl(brandStoreId));
  };

  const handleBack = () => navigate(backTargetUrl());

  const [hqStaffUpdate, hqStaffUpdateOpts] = useHqStaffUpdateMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.hqStaffUpdate.errors, commonMsg.savedChanges),
  });

  const [hqStaffSupervisorAssign, hqStaffSupervisorAssignOpts] = useHqStaffSupervisorAssignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.assignHqStaffSupervisor.errors, "담당자로 설정되었습니다."),
  });

  const [hqStaffSupervisorUnassign, hqStaffSupervisorUnassignOpts] = useHqStaffSupervisorUnassignMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.unassignHqStaffSupervisor.errors, "담당자 해제되었습니다."),
  });

  const [storeWorkerUpdate, storeWorkerUpdateOpts] = useStoreWorkerUpdateMutation({
    onCompleted: (data) => utils.handleOnCompletedWithError(data.storeWorkerUpdate.errors, commonMsg.savedChanges),
  });

  const loading =
    userQueryLoading ||
    hqStaffUpdateOpts.loading ||
    hqStaffSupervisorUnassignOpts.loading ||
    hqStaffSupervisorAssignOpts.loading ||
    storeWorkerUpdateOpts.loading;

  return (
    <>
      <WindowTitle title={maybe(() => userData.user.loginId)} />
      <BrandAccountDetailsPage
        brandAccountUser={maybe(() => userData?.user)}
        onSubmitHqStaffUpdate={hqStaffUpdate}
        onSubmitHqStaffSupervisorAssign={hqStaffSupervisorAssign}
        onSubmitHqStaffSupervisorUnassign={hqStaffSupervisorUnassign}
        onSubmitStoreWorkerUpdate={storeWorkerUpdate}
        loading={loading}
        onBack={handleBack}
        onClickBrandStore={onClickBrandStore}
        onClickAccount={onClickAccount}
        onAddressManageClick={() => navigate(customerAddressesViewUrl(id))}
        navigate={navigate}
      />
    </>
  );
};
</file>

<file path="src/app/views/customer/customers/views/CustomerAddressesView.tsx">
import ActionDialog from "@src/app/components/ActionDialog";
import ErrorPage, { ErrorPageEnum } from "@src/app/components/ErrorPage";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { historyBack } from "@src/app/routes/Routes";
import { CustomerAddresses_user_addresses } from "@src/app/views/customer/customers/api/types/CustomerAddresses";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Typography } from "antd";
import React, { useState } from "react";

import {
  useCreateCustomerAddressMutation,
  useRemoveCustomerAddressMutation,
  useSetCustomerDefaultAddressMutation,
  useUpdateCustomerAddressMutation,
} from "../api/mutations";
import { useCustomerAddressesQuery } from "../api/queries";
import { CreateCustomerAddress } from "../api/types/CreateCustomerAddress";
import { RemoveCustomerAddress } from "../api/types/RemoveCustomerAddress";
import { SetCustomerDefaultAddress } from "../api/types/SetCustomerDefaultAddress";
import { UpdateCustomerAddress } from "../api/types/UpdateCustomerAddress";
import { AddressFormModal } from "../components/AddressFormModal";
import CustomerAddressListPage from "../components/CustomerAddressListPage";

interface CustomerAddressesViewProps {
  id: string;
}

export enum AddressModalModeEnum {
  CreateAddress = "CreateAddress",
  EditAddress = "EditAddress",
  RemoveAddress = "RemoveAddress",
  ApproveAddress = "ApproveAddress",
  RejectAddress = "RejectAddress",
}

export const CustomerAddressesView: React.FC<CustomerAddressesViewProps> = ({ id }) => {
  const [addressForModal, setAddressForModal] = useState(null);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
    setAddressForModal(null);
  };

  const openModalWithoutNavigate = (modalMode: AddressModalModeEnum, address?: CustomerAddresses_user_addresses) => {
    setModalMode(modalMode);
    if (address) {
      setAddressForModal(address);
    }
  };

  const handleSetAddressAsDefault = (data: SetCustomerDefaultAddress) => {
    const errors = data.addressSetDefault.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleAddressCreate = (data: CreateCustomerAddress) => {
    const errors = data.addressCreate.errors;
    if (errors.length === 0) {
      resetForCloseModal();
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleAddressUpdate = (data: UpdateCustomerAddress) => {
    const errors = data.addressUpdate.errors;
    if (errors.length === 0) {
      resetForCloseModal();
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const handleAddressRemove = (data: RemoveCustomerAddress) => {
    const errors = data.addressDelete.errors;
    if (errors.length === 0) {
      resetForCloseModal();
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [createCustomerAddress] = useCreateCustomerAddressMutation({
    onCompleted: handleAddressCreate,
  });

  const [updateCustomerAddress] = useUpdateCustomerAddressMutation({
    onCompleted: handleAddressUpdate,
  });

  const [removeCustomerAddress, removeCustomerAddressOpts] = useRemoveCustomerAddressMutation({
    onCompleted: handleAddressRemove,
  });

  const [setCustomerDefaultAddress] = useSetCustomerDefaultAddressMutation({
    onCompleted: handleSetAddressAsDefault,
  });

  const { data: customerData, loading: customerDataLoading } = useCustomerAddressesQuery({
    variables: { id },
  });

  const user = customerData?.user;
  if (user === null) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={historyBack} />;
  }

  return (
    <>
      <WindowTitle title={maybe(() => user.loginId)} />
      <CustomerAddressListPage
        customer={user}
        disabled={customerDataLoading}
        onAdd={() => openModalWithoutNavigate(AddressModalModeEnum.CreateAddress)}
        onEdit={(address) => openModalWithoutNavigate(AddressModalModeEnum.EditAddress, address)}
        onRemove={(address) => openModalWithoutNavigate(AddressModalModeEnum.RemoveAddress, address)}
        onSetAsDefault={(address) =>
          setCustomerDefaultAddress({
            variables: { addressId: address.id, userId: id },
          })
        }
      />
      <AddressFormModal
        customer={user}
        address={undefined}
        open={modalMode === AddressModalModeEnum.CreateAddress}
        variant="create"
        hideModal={resetForCloseModal}
        title="회원 주소 생성"
        createCustomerAddress={createCustomerAddress}
        updateCustomerAddress={updateCustomerAddress}
      />
      <AddressFormModal
        customer={user}
        address={maybe(() => user.addresses.find((addr) => addr.id === addressForModal.id))}
        open={modalMode === AddressModalModeEnum.EditAddress}
        variant="edit"
        hideModal={resetForCloseModal}
        title="회원 주소 수정"
        createCustomerAddress={createCustomerAddress}
        updateCustomerAddress={updateCustomerAddress}
      />
      <ActionDialog
        open={modalMode === AddressModalModeEnum.RemoveAddress}
        variant="delete"
        title="주소 삭제"
        confirmButtonState={removeCustomerAddressOpts.status}
        onClose={resetForCloseModal}
        onConfirm={() =>
          removeCustomerAddress({
            variables: {
              id: addressForModal.id,
            },
          })
        }
      >
        <Typography>배송지 목록에서 이 주소를 삭제하시겠습니까?</Typography>
      </ActionDialog>
    </>
  );
};
</file>

