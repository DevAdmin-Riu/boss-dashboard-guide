import useModalDialogErrors from "@hooks/useModalDialogErrors";
import { ProductErrorFragment } from "@src/api/fragments/types/ProductErrorFragment";
import { AttributeValueCreateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import FormSpacer from "@src/app/components/FormSpacer";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { maybe } from "@utils/misc";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Form, Input, InputNumber, Modal, Space, Typography } from "antd";
import React, { useEffect } from "react";

import { AttributeDetails_attribute, AttributeDetails_attribute_values } from "../../api/types/AttributeDetails";
import { parseAttributeValueFormToIncludeVat } from "../../utils";
import { getAttrNameLabel, getAttrSlugLabel, getAttrValueLabel, getValueKeyFromAttrValues } from "../AttributeValues";

export interface AttributeValueEditDialogProps {
  open: boolean;
  disabled: boolean;
  attribute: AttributeDetails_attribute;
  attributeValue: AttributeDetails_attribute_values | null;
  errors: ProductErrorFragment[];
  onSubmit: (data: AttributeValueCreateInput) => void;
  onClose: () => void;
}

const AttributeValueEditDialog: React.FC<AttributeValueEditDialogProps> = ({
  open,
  disabled,
  attribute,
  attributeValue,
  errors: apiErrors,
  onSubmit,
  onClose,
}) => {
  const isCreateMode = attributeValue === null;
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<AttributeValueCreateInput>(form);
  const formInstance = TypeSafeForm.formInstance;
  const errors = useModalDialogErrors(apiErrors, open);
  const formErrors = getFormErrors(["name", "value"], errors);
  const initialValues = { name: maybe(() => attributeValue.name, ""), value: maybe(() => attributeValue.value, {}) };

  useEffect(() => {
    formInstance.setFieldsValue(initialValues);
  }, [open]);

  const modalTitle = isCreateMode ? "값 추가" : "값 수정";
  const modalFooter = (
    <Space>
      <Button type="default" onClick={onClose}>
        뒤로
      </Button>
      <Button type="primary" onClick={formInstance.submit}>
        저장
      </Button>
    </Space>
  );

  const slugFormItemLabel = getAttrSlugLabel(attribute?.slug);
  const nameFormItemLabel = getAttrNameLabel(attribute?.slug);
  const valueFormItemLabel = getAttrValueLabel(attribute?.slug);
  const valueFormItemKey = getValueKeyFromAttrValues(attribute?.slug);

  return (
    <Modal
      destroyOnClose
      forceRender
      open={open}
      title={modalTitle}
      footer={modalFooter}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        name="attribute-value-edit-form"
        form={formInstance}
        initialValues={initialValues}
        layout="vertical"
        validateTrigger="onSubmit"
        onFinish={(formData) => {
          const parsedFormData = parseAttributeValueFormToIncludeVat(attribute, formData);
          onSubmit(parsedFormData);
        }}
      >
        <Space direction="vertical" size={0}>
          <Form.Item
            name="name"
            label={nameFormItemLabel}
            style={{ margin: 0 }}
            validateStatus={!!formErrors.name ? "error" : ""}
            help={makeGqlErrorMsg(formErrors.name)}
          >
            <Input placeholder={nameFormItemLabel} disabled={disabled} />
          </Form.Item>
          <Typography.Text type="warning">입력한 값은 {slugFormItemLabel}과/와 동일하게 설정됩니다.</Typography.Text>
        </Space>
        <FormSpacer />
        {!utils.isEmpty(valueFormItemLabel) && (
          <Form.Item
            name={["value", valueFormItemKey]}
            label={valueFormItemLabel}
            validateStatus={!!formErrors.value ? "error" : ""}
            help={makeGqlErrorMsg(formErrors.value)}
          >
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              disabled={disabled}
              placeholder={valueFormItemLabel as string}
            />
          </Form.Item>
        )}
      </Form>
    </Modal>
  );
};

export default AttributeValueEditDialog;
</file>

