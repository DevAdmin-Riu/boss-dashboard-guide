export enum RiuMinusProfitBpvListFilterKeys {
  productExclusive = "productExclusive",
  trackInventory = "trackInventory",
  brandIsRunning = "brandIsRunning",
  productSearch = "productSearch",
  brandProductSearch = "brandProductSearch",
  brandSearch = "brandSearch",
  vendorSearch = "vendorSearch",
  pvSalesStatus = "pvSalesStatus",
}

export interface RiuMinusProfitBpvListFilterOpts {
  productExclusive: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  brandIsRunning: FilterOpts<boolean>;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  pvSalesStatus: FilterOpts<SalesStatusEnum[]>;
}

export function createFilterStructure(opts: RiuMinusProfitBpvListFilterOpts): IFilter<RiuMinusProfitBpvListFilterKeys> {
  let displayOrder = 0;
  const filterStructure: IFilter<RiuMinusProfitBpvListFilterKeys> = [];
  filterStructure.push(
    {
      ...createTextField(
        displayOrder++,
        RiuMinusProfitBpvListFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        RiuMinusProfitBpvListFilterKeys.productExclusive,
        "제품 " + columnNameConstant.product.IS_EXCLUSIVE,
        opts.productExclusive.value,
        {
          negative: transformIsExclusive(false),
          positive: transformIsExclusive(true),
        }
      ),
      active: opts.productExclusive.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        RiuMinusProfitBpvListFilterKeys.trackInventory,
        columnNameConstant.product.TRACK_INVENTORY,
        opts.trackInventory.value,
        {
          negative: transformTrackInventoryVariantType(false),
          positive: transformTrackInventoryVariantType(true),
        }
      ),
      active: opts.trackInventory.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        RiuMinusProfitBpvListFilterKeys.pvSalesStatus,
        columnNameConstant.product.SALES_STATUS,
        opts.pvSalesStatus.value,
        true,
        getSalesStatusChoices(false, false)
      ),
