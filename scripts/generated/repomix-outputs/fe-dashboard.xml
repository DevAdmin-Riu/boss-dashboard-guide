import { MutationFunction } from "@apollo/client";
import useUser from "@hooks/useUser";
import { HqStaffRoleEnum, HqStaffUpdateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField from "@src/app/components/EditableField/EditableField";
import { FormSaveButton } from "@src/app/components/SaveButtonBar/FormSaveButton";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { HqStaffUpdate, HqStaffUpdateVariables } from "@src/app/views/brand/brands/api/types/HqStaffUpdate";
import { brandHqStaffRoleChoices, brandHqStaffRoleChoicesWOAdmin } from "@src/app/views/brand/brandStore/utils";
import { BrandAccountDetails_user } from "@src/app/views/customer/customers/api/types/BrandAccountDetails";
import { transformPhoneNumber } from "@utils/misc";
import { Card, Col, Form, Row, Space, Typography } from "antd";
import React from "react";
import { useEffect, useState } from "react";

interface HqStaffBasicInfoProps {
  brandAccountUser: BrandAccountDetails_user;
  onSubmit: MutationFunction<HqStaffUpdate, HqStaffUpdateVariables>;
}

export const HqStaffBasicInfo: React.FC<HqStaffBasicInfoProps> = (props) => {
  const { brandAccountUser, onSubmit } = props;
  const { user } = useUser();
  const isStaff = user.isStaff;
  const [form] = Form.useForm<HqStaffUpdateInput>();
  const [editMode, setEditMode] = useState(false);

  const TypeSafeForm = getTypeSafeForm<HqStaffUpdateInput>(form);

  const handleSubmit = async (formData: HqStaffUpdateInput) => {
    const result = await onSubmit({ variables: { id: brandAccountUser.id, input: formData } });
    if (result?.data?.hqStaffUpdate?.errors.length === 0) {
      setEditMode(false);
    }
  };

  const initialValues: HqStaffUpdateInput = {
    firstName: brandAccountUser.firstName,
    loginId: brandAccountUser.loginId,
    hqStaffRole: brandAccountUser.hqStaffRole,
    aligoPhone: transformPhoneNumber(brandAccountUser.aligoPhone),
    email: brandAccountUser.email,
  };

  // editMode가 true에서 false로 바뀌는 경우 form reset되어야 한다. useEffect 사용.
  useEffect(() => {
    if (!editMode) {
      form.resetFields();
    }
  }, [editMode]);

  return (
    <Form
      form={form}
      initialValues={initialValues}
      labelCol={{ span: 24 }}
      wrapperCol={{ span: 24 }}
      onFinish={handleSubmit}
    >
      <Card
        title={
          <Space direction="horizontal" align="center">
            <Typography.Title level={4}>사용자 정보</Typography.Title>
            <Typography.Text type={"secondary"}>
              가입일: {getDateByFormat(brandAccountUser.dateJoined, onlyDateFormat)}, 최근 접속일:{" "}
              {getDateByFormat(brandAccountUser.lastLogin, onlyDateFormat)}
            </Typography.Text>
          </Space>
        }
        extra={
          <FormSaveButton
            form={form}
