<file path="src/app/views/order/orders/components/OrderRefundQuestion/OrderRefundQuestion.tsx">
import { RefundQAQReasonType, RefundQAQType, RefundQAStatus } from "@src/api/types/globalTypes";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { ShopInfo_shop_refundTypeChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";
import useShop from "@src/app/providers/ShopProvider/useShop";
import {
  OrderDetails_order_lines,
  OrderDetails_order_refundQA,
  OrderDetails_order_refundQA_qRefundAccountInfo,
} from "@src/app/views/order/orders/api/types/OrderDetails";
import { transformRefundReason } from "@src/app/views/question/components/CustomerRefundQuestionInspectTable/utils";
import {
  getRefundStatusTypeLabel,
  refundStatusTypeLabelColor,
} from "@src/app/views/question/components/RefundQuestionListTable/utils";
import { findBankNameByCode } from "@utils/misc";
import { showNotificationError, showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import {
  Button,
  Card,
  Checkbox,
  Col,
  Form,
  Image,
  Input,
  notification,
  Radio,
  Row,
  Space,
  Tag,
  Typography,
} from "antd";
import { CheckboxValueType } from "antd/lib/checkbox/Group";
import axios from "axios";
import React from "react";

import {
  useCustomerRefundProductCombinedCreateMutation,
  useCustomerRefundQuestionReplyMutation,
} from "../../api/mutations";
import { ROUND_TRIP_DELIVERY_FEE_PER_ITEM } from "../OrderRefundCreateModal/OrderRefundCreateModal";

interface RefundFulfillmentData {
  label: string;
  value: string;
  trackInventory: boolean;
}

interface OrderRefundQuestionProps {
  orderId: string;
  refundQuestions: OrderDetails_order_refundQA[];
  lines: OrderDetails_order_lines[];
  onShowingAllRefundQs: () => void;
  refundFulfillmentData: RefundFulfillmentData[];
  isShowRefundQuestionForm: boolean;
}

export interface IOrderLineInfo {
  quantity: number;
  order_line_id: string;
  productName: string;
  price: number;
  productSku?: string;
  isBundle?: boolean;
  isMainPv?: boolean | null;
  bundleName?: string | null;
  componentName?: string | null;
  bundleInfoQty?: number | null;
}

export const OrderRefundQuestion: React.FC<OrderRefundQuestionProps> = ({
  refundQuestions,
  lines,
  onShowingAllRefundQs,
  orderId,
  refundFulfillmentData,
  isShowRefundQuestionForm,
}) => {
  const shop = useShop();
  const {
    goodsflowPluginConfig,
    refundTypeChoices,
    refundReasonChoices,
    refundBankCodeChoices,
    refundStatusTypeChoices,
  } = shop;
  const [refundRejectAndApprove, setRefundRejectAndApprove] = React.useState<null | boolean>(null);
  const [isProductReturned, setIsProductReturned] = React.useState<boolean>(true);
  const [rejectText, setRejectText] = React.useState<string>("");
  const [approveText, setApproveText] = React.useState<string>("");
  const [_finalCheck, setFinalCheck] = React.useState<boolean>(false);
  const [returnFulfillmentIdList, setReturnFulfillmentIdList] = React.useState<CheckboxValueType[]>([]);
  const [returnFulfillmentTrackingNumberList, setReturnFulfillmentTrackingNumberList] = React.useState<
    CheckboxValueType[]
  >([]);

  const processingRefundQuestion = refundQuestions.find(
    (refundQuestion) => refundQuestion.status !== RefundQAStatus.QUESTION_CLOSE
  );
  let refundTypeChoice: ShopInfo_shop_refundTypeChoices;
  let orderLineInfos: IOrderLineInfo[];
  let qRefundAccountInfo: OrderDetails_order_refundQA_qRefundAccountInfo;
  let reasonText: string;
  // processingRefundQuestion이 존재하지 않을 수 있음.
  if (processingRefundQuestion) {
    reasonText = transformRefundReason(refundReasonChoices, processingRefundQuestion.qReasonType);
    refundTypeChoice = refundTypeChoices.find((choice) => choice.value === processingRefundQuestion?.qType);
    orderLineInfos = JSON.parse(processingRefundQuestion?.qOrderLineInfo);
    orderLineInfos.forEach((orderLineInfo) => {
      const line = lines.find((line) => line.id === orderLineInfo.order_line_id);
      orderLineInfo.productName = line?.productName;
      orderLineInfo.price = line?.unitPriceGrossAmount;
      orderLineInfo.productSku = line?.productSku;
      orderLineInfo.isBundle = line?.bundleOtherOrderLines?.length > 0 || false;
      orderLineInfo.isMainPv = line?.isMainPv;
      orderLineInfo.bundleInfoQty = line?.bundleInfoQty;
      // 세트 상품인 경우 세트 상품명과 구성품명 설정
      if (line?.bpBundle?.name) {
        orderLineInfo.bundleName = line.bpBundle.name;
        const matchingBundleInfo = line.bpBundle.bpBundleInfos?.find((info) => info?.pv?.id === line.variant?.id);
        orderLineInfo.componentName = matchingBundleInfo?.name || line.productName;
      }
    });
    qRefundAccountInfo = processingRefundQuestion.qRefundAccountInfo;
  }

  const refundTypeValue = refundTypeChoice?.value as RefundQAQType;
  const isEtcType = refundTypeValue === RefundQAQType.ETC;
  const isExchangeOrRefundType = [RefundQAQType.EXCHANGE, RefundQAQType.REFUND].includes(refundTypeValue);

  const rejectTextOnChange = (e) => {
    setRejectText(e.target.value);
  };
  const approveTextOnChange = (e) => {
    setApproveText(e.target.value);
  };

  const onRejectAndApproveRadio = (e) => {
    setRefundRejectAndApprove(e.target.value);
  };

  const onIsProductReturnedRadio = (e) => {
    setIsProductReturned(e.target.value);
  };

  const [customerRefundQuestionReply, customerRefundQuestionReplyOpts] = useCustomerRefundQuestionReplyMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.customerRefundQuestionReply.errors, "문의 처리가 완료되었습니다."),
    onError: () => {
      showNotificationError(
        "문의를 최종 처리하는 부분에서 에러가 발생하였습니다. 관리자에게 문의 남겨주시기 바랍니다."
      );
    },
  });

  const [customerRefundProductCombinedCreate, customerRefundProductCombinedCreateOpts] =
    useCustomerRefundProductCombinedCreateMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(data.customerRefundProductCombined.errors, "문의 처리가 완료되었습니다."),
      onError: () => {
        showNotificationError(
          "문의를 최종 처리하는 부분에서 에러가 발생하였습니다. 관리자에게 문의 남겨주시기 바랍니다."
        );
      },
    });

  const mutationLoading = customerRefundQuestionReplyOpts.loading || customerRefundProductCombinedCreateOpts.loading;

  const finalOnClick = async () => {
    if (isEtcType) {
      await customerRefundQuestionReply({
        variables: {
          id: processingRefundQuestion.id,
          input: { isRefused: false, aApproveMessage: approveText.trim() },
        },
      });
      return;
    }

    const trackInventoryList = refundFulfillmentData.filter((item) => item.trackInventory === true);
    const returnFulfillmentIdGoodsFlowList = trackInventoryList.reduce((acc, cur) => {
      const id = cur.value.split("|||")[0];
      const isIncludes = returnFulfillmentIdList.includes(id);
      if (isIncludes) {
        acc.push(id);
      }

      return acc;
    }, []);

    const returnFulfillmentIdListLength = returnFulfillmentIdList.length;
    const returnFulfillmentTrackInventoryListLength = returnFulfillmentIdGoodsFlowList.length;

    if (
      !refundRejectAndApprove &&
      isProductReturned &&
      returnFulfillmentIdListLength === 0 &&
      returnFulfillmentTrackInventoryListLength === 0
    ) {
      showNotificationWarn("반품 상품을 선택해주세요.");
      return;
    }

    if (totalRefundPrice() < 0 && !refundRejectAndApprove) {
      notification.info({
        message:
          "환불 해야 할 금액이 0보다 작습니다. 이러한 경우 정산 or 결산에 문제가 발생할 수 있으므로 해당건은 환불이 불가능한 문의 주문건 입니다.",
      });
      return;
    }

    let isRefused = false;
    if (refundRejectAndApprove) {
      // 거부
      if (rejectText.trim().length < 10) {
        notification.error({ message: "거부 사유는 10자 이상이어야 합니다.", placement: "top" });
        return;
      }
      isRefused = true;
    } else {
      if (returnFulfillmentTrackInventoryListLength > 0) {
        // NOTE: 굿스플로 반품 신청
        const productReturnResponse = await requestReturn(returnFulfillmentIdGoodsFlowList);
        if (!productReturnResponse.success) {
          showNotificationSuccess("반품 자동 신청이 완료되었습니다.");
          return;
        }
      }
    }

    // NOTE: 위탁건 id list 분리
    const consignmentFulfillmentIds = returnFulfillmentIdList.reduce((acc, cur) => {
      const find = returnFulfillmentIdGoodsFlowList.findIndex((item) => item === cur);
      if (find === -1) {
        acc.push(cur);
      }
      return acc;
    }, []);

    // NOTE: 하나의 mutation으로 합쳐진 호출
    await customerRefundProductCombinedCreate({
      variables: {
        input: {
          idForReply: processingRefundQuestion.id,
          inputForReply: {
            isRefused,
            aRefuseReason: rejectText.trim(),
            aApproveMessage: approveText.trim(),
            isProductReturned: refundRejectAndApprove === true ? null : isProductReturned,
          },
          idForTracking: orderId,
          inputForTracking: {
            refundQaId: processingRefundQuestion.id,
            fulfillmentIds: returnFulfillmentIdList.map((item) => item.toString()),
            trackingNumbers: returnFulfillmentTrackingNumberList.map((item) => item.toString()),
            consignmentFulfillmentIds,
          },
        },
      },
    });
  };

  const trackingCheckBoxOnChange = (e) => {
    const target = e.target;
    const value = target.value;
    const checked = target.checked;
    const valueSplit = value.split("|||");

    const idValue: string = valueSplit[0].toString();
    const trackingNumberValue: string = valueSplit[1].toString();

    const deepCopyIdList = [...returnFulfillmentIdList];
    const deepCopyTrackingNumberList = [...returnFulfillmentTrackingNumberList];
    if (checked) {
      deepCopyIdList.push(idValue);
      deepCopyTrackingNumberList.push(trackingNumberValue);
    } else {
      const findIndexIdList = returnFulfillmentIdList.findIndex((item) => item === idValue);
      const findIndexTrackingNumberList = returnFulfillmentTrackingNumberList.findIndex(
        (item) => item === trackingNumberValue
      );
      if (findIndexIdList !== -1 && findIndexTrackingNumberList !== -1) {
        deepCopyIdList.splice(findIndexIdList, 1);
        deepCopyTrackingNumberList.splice(findIndexTrackingNumberList, 1);
      }
    }
    setReturnFulfillmentIdList(deepCopyIdList);
    setReturnFulfillmentTrackingNumberList(deepCopyTrackingNumberList);
  };

  const requestReturn = async (returnFulfillmentIdList) => {
    let returnValue;
    const requestUrl = (goodsflowPluginConfig || []).find(({ field }) => field === "request_return_url")?.value || "";
    const params = {
      selectedFulfillmentIds: returnFulfillmentIdList,
    };
    await axios
      .post(`${requestUrl}`, params)
      .then((resolve) => {
        const { data } = resolve;
        returnValue = data;
        if (data.success === false) {
          const error = data.error;
          notification.error({ message: error.message, placement: "top" });
        }
      })
      .catch((error) => {
        notification.error({ message: error.message, placement: "top" });
      });

    return returnValue;
  };

  const checkRefundReturnDeliveryFee: boolean =
    processingRefundQuestion?.qReasonType === RefundQAQReasonType.SIMPLE_REMORSE ||
    processingRefundQuestion?.qReasonType === RefundQAQReasonType.PRODUCT_DIFFERENT_ORDER;

  const getTotalRefundCount = () =>
    orderLineInfos.reduce((acc, cur) => {
      acc = acc + parseInt(cur.quantity.toString(), 10);
      return acc;
    }, 0);
  const getTotalPrice = () =>
    orderLineInfos.reduce((acc, cur) => {
      const qty = utils.isEmpty(cur.bundleInfoQty) === false ? cur.quantity / cur.bundleInfoQty : cur.quantity;
      acc = acc + cur.price * qty;
      return acc;
    }, 0);

  const getTotalRefundDeliveryPrice = () => ROUND_TRIP_DELIVERY_FEE_PER_ITEM * getTotalRefundCount();

  const totalRefundPrice = () =>
    checkRefundReturnDeliveryFee ? getTotalPrice() - getTotalRefundDeliveryPrice() : getTotalPrice();

  // refundQuestions 감지로 해당 상태 안보이게 처리
  // eslint-disable-next-line @typescript-eslint/no-empty-function
  React.useEffect(() => {
    setFinalCheck(true);
  }, [refundQuestions]);

  return (
    <Card
      title={<Typography.Title level={4}>교환/반품/기타문의</Typography.Title>}
      extra={
        <Row justify={"center"}>
          <Typography.Link strong color="primary" onClick={onShowingAllRefundQs}>
            문의 내역 보기
          </Typography.Link>
        </Row>
      }
    >
      <Form>
        {processingRefundQuestion ? (
          <Space direction="vertical">
            <Row justify="space-between">
              <Typography.Title level={5}>{refundTypeChoice?.label} </Typography.Title>
              <Tag color={refundStatusTypeLabelColor(processingRefundQuestion.status)}>
                {getRefundStatusTypeLabel(refundStatusTypeChoices, processingRefundQuestion.status)}
              </Tag>
            </Row>

            {isExchangeOrRefundType && (
              <Card type="inner" title={<Typography.Title level={5}>신청 상품</Typography.Title>}>
                <TableVatLegend isIncludeVat={true} />
                {orderLineInfos
                  .filter((item) => parseInt(item.quantity.toString(), 10) > 0)
                  .map((orderLineInfo, idx) => (
                    <Row key={idx}>
                      <Col span={12}>
                        <Row align="middle">
                          {orderLineInfo.bundleName && orderLineInfo.isMainPv === true && (
                            <Tag color="blue" style={{ marginRight: 4 }}>
                              대표
                            </Tag>
                          )}
                          {orderLineInfo.bundleName
                            ? `${orderLineInfo.bundleName} - ${orderLineInfo.componentName}`
                            : orderLineInfo.productName}
                        </Row>
                      </Col>
                      <Col span={4}>
                        <Row justify="end">
                          <NumberComponent value={orderLineInfo.quantity} postFix="개" />
                        </Row>
                      </Col>
                      <Col span={8}>
                        <Row justify="end">
                          <NumberComponent
                            value={
                              orderLineInfo.price *
                              (utils.isEmpty(orderLineInfo.bundleInfoQty) === false
                                ? orderLineInfo.quantity / orderLineInfo.bundleInfoQty
                                : orderLineInfo.quantity)
                            }
                            includeCurrency
                          />
                        </Row>
                      </Col>
                    </Row>
                  ))}
                <hr />
                {checkRefundReturnDeliveryFee && (
                  <Row>
                    <Col span={12}>
                      <Row justify="start">
                        <Typography.Text type="danger" strong>
                          반품 배송비
                        </Typography.Text>
                      </Row>
                    </Col>
                    <Col span={12}>
                      <Row justify="end">
                        <Typography.Text type="danger" strong>
                          <NumberComponent value={-getTotalRefundDeliveryPrice()} includeCurrency />
                        </Typography.Text>
                      </Row>
                    </Col>
                  </Row>
                )}
                <Row>
                  <Col span={12}>
                    <Row justify="start">
                      <Typography.Text type="danger" strong>
                        최종 환불 금액
                      </Typography.Text>
                    </Row>
                  </Col>
                  <Col span={12}>
                    <Row justify="end">
                      <Typography.Text type="danger" strong>
                        <NumberComponent value={totalRefundPrice()} includeCurrency />
                      </Typography.Text>
                    </Row>
                  </Col>
                </Row>
              </Card>
            )}
            {isEtcType ? (
              <Card type="inner" title={<Typography.Title level={5}>문의 내용</Typography.Title>}>
                <Typography.Text>{processingRefundQuestion.qReasonText}</Typography.Text>
              </Card>
            ) : (
              <Card type="inner" title={<Typography.Title level={5}>신청 사유</Typography.Title>}>
                <Typography.Text strong style={{ display: "block" }}>
                  {reasonText}
                </Typography.Text>
                <Typography.Text strong style={{ display: "block" }}>
                  {processingRefundQuestion.qReasonText}
                </Typography.Text>
              </Card>
            )}

            <Card type="inner" title={<Typography.Title level={5}>첨부 사진</Typography.Title>}>
              {refundQuestions[0].images.length > 0 ? (
                <Row gutter={[5, 5]}>
                  {refundQuestions[0].images.map((item) => (
                    <Col span={8} key={item.id}>
                      <Image width={"100%"} src={item.url} />
                    </Col>
                  ))}
                </Row>
              ) : (
                <Typography.Text>첨부 사진이 없습니다.</Typography.Text>
              )}
            </Card>

            {isShowRefundQuestionForm &&
              (isEtcType ? (
                <Space direction="vertical" size="small">
                  <Row>
                    <Input.TextArea
                      rows={4}
                      placeholder="답변을 작성해 주세요."
                      onChange={approveTextOnChange}
                      value={approveText}
                    />
                  </Row>
                  <Row>
                    <Button block type="primary" loading={mutationLoading} onClick={finalOnClick}>
                      답변 완료
                    </Button>
                  </Row>
                </Space>
              ) : (
                <Space direction="vertical" size="small">
                  {utils.isEmpty(qRefundAccountInfo) === false && (
                    <Card title={<Typography.Title level={5}>환불 계좌 정보</Typography.Title>}>
                      <Typography.Text>
                        은행:
                        {findBankNameByCode(refundBankCodeChoices, qRefundAccountInfo.bankCode)}
                        <br />
                        계좌번호: {qRefundAccountInfo.accountNumber}
                        <br /> 예금주: {qRefundAccountInfo.accountHolderName}
                      </Typography.Text>
                    </Card>
                  )}
                  <Row>
                    <Col span={24}>
                      <Form.Item valuePropName="changed" style={{ margin: 0 }}>
                        <Radio.Group onChange={onRejectAndApproveRadio}>
                          <Radio value={true}>문의 반려</Radio>
                          <Radio value={false}>문의 승인 후 검수</Radio>
                        </Radio.Group>
                      </Form.Item>
                    </Col>
                  </Row>
                  {refundRejectAndApprove && (
                    <Row>
                      <Input.TextArea
                        rows={4}
                        placeholder="거부사유를 작성해주세요."
                        onChange={rejectTextOnChange}
                        value={rejectText}
                      />
                    </Row>
                  )}
                  {refundRejectAndApprove === false && (
                    <Row>
                      <Col span={24}>
                        <Form.Item valuePropName="changed" style={{ margin: 0 }}>
                          <Radio.Group onChange={onIsProductReturnedRadio} defaultValue={isProductReturned}>
                            <Radio value={false}>환불/교환 진행 (상품 회수 안함)</Radio>
                            <Radio value={true}>환불/교환 및 상품 회수 진행</Radio>
                          </Radio.Group>
                        </Form.Item>
                      </Col>
                    </Row>
                  )}
                  {refundRejectAndApprove === false && isProductReturned === true && refundFulfillmentData && (
                    <Card type="inner" title={<Typography.Title level={5}>송장 리스트</Typography.Title>}>
                      <Form.Item valuePropName="checked" style={{ margin: 0 }}>
                        <Checkbox.Group>
                          {refundFulfillmentData.map((item) => (
                            <Checkbox
                              key={item.value}
                              style={{ marginLeft: 0 }}
                              onChange={trackingCheckBoxOnChange}
                              value={item.value}
                              checked={false}
                            >
                              {item.label}
                            </Checkbox>
                          ))}
                        </Checkbox.Group>
                      </Form.Item>
                    </Card>
                  )}
                  {refundRejectAndApprove === false && (
                    <Row>
                      <Input.TextArea
                        rows={4}
                        placeholder="승인시 전달할 메시지를 작성해 주세요."
                        onChange={approveTextOnChange}
                        value={approveText}
                      />
                    </Row>
                  )}
                  {refundRejectAndApprove !== null && (
                    <Row>
                      <Button block type="primary" loading={mutationLoading} onClick={finalOnClick}>
                        최종 {refundRejectAndApprove ? "반려" : "접수 승인"} 확인
                      </Button>
                    </Row>
                  )}
                </Space>
              ))}
          </Space>
        ) : (
          <Typography.Text type="secondary">진행 중인 문의가 없습니다.</Typography.Text>
        )}
      </Form>
    </Card>
  );
};
export default OrderRefundQuestion;
</file>

<file path="src/app/views/order/orders/components/OrderRefundQuestion/utils.ts">
import { RefundQAQReasonType } from "@src/api/types/globalTypes";

export const cancelTypeTransform = (cancelType: RefundQAQReasonType) => {
  switch (cancelType) {
    case RefundQAQReasonType.PRICE:
      return "더 저렴한 상품 존재";
    case RefundQAQReasonType.SIMPLE_REMORSE:
      return "단순 변심";
  }
};

export const refundTypeTransform = (refundType: RefundQAQReasonType) => {
  switch (refundType) {
    case RefundQAQReasonType.PRODUCT_DEFECT:
      return "상품이 파손";
    case RefundQAQReasonType.PRODUCT_DIFFERENT:
      return "주문 상품과 다름";
    case RefundQAQReasonType.QUANTITY_DIFFERENT:
      return "상품 수량이 다름";
    case RefundQAQReasonType.SIMPLE_REMORSE:
      return "단순 변심";
  }
};
