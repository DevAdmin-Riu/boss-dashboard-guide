    },
  };
}

export const getPurchaseTypeFilterVariablesFromPurchaseRouteParams = (
  routeParams: PurchaseListViewRouteParams | VsPurchaseListViewRouteParams,
  isB2b: boolean
) => {
  // B2B 인 경우
  if (isB2b) {
    return [PurchaseTypeEnum.CONSIGNMENT, PurchaseTypeEnum.CONSIGNMENT_TAKE_BACK];
  }

  const isFulfilledByVendorList = routeParams.fulfilledBy === "vendor";
  // B2B 아닌 경우 운영Admin / 협력사Admin 분기
  if (isFulfilledByVendorList) {
    return [PurchaseTypeEnum.FULFILLED_BY_VENDOR];
  } else {
    return [
      PurchaseTypeEnum.INITIAL_ORDER,
      PurchaseTypeEnum.REORDER,
      PurchaseTypeEnum.TAKE_BACK,
      PurchaseTypeEnum.CONSIGNMENT,
      PurchaseTypeEnum.CONSIGNMENT_TAKE_BACK,
    ];
  }
};

export function getFilterVariables(
  params: PurchaseListViewUrlFilters,
  routeParams: PurchaseListViewRouteParams
): PurchaseFilterInput {
  return {
    // 현재 사용자들이 기능을 사용하지 못하므로 undefined로 설정 후 추후에 다시 pending(대행 매입 확정) 인 경우에 true로 설정 필요
    useDelegatedManagementForPo: undefined,
    purchaseDate: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    purchaseOrderDate: getGteLteVariables({
      gte: params.purchaseOrderDateFrom,
      lte: params.purchaseOrderDateTo,
    }),
    purchaseCloseDate: getPurchaseCloseDateFilterVariableFromParams(params, routeParams),
    type: maybe(() => params.type.map((type) => findValueInEnum(type, PurchaseTypeEnum))),
    isNotOrderableBeforeStocked:
      params.isNotOrderableBeforeStocked !== undefined
        ? parseBoolean(params.isNotOrderableBeforeStocked, false)
        : undefined,
    isForPackageOrder:
      params.isForPackageOrder !== undefined ? parseBoolean(params.isForPackageOrder, false) : undefined,
    vendorContactType:
      params.vendorContactType !== undefined ? findValueInEnum(params.vendorContactType, VendorContactTypeEnum) : null,
    purchaseOrderSearch: params.purchaseOrderSearch !== undefined ? params.purchaseOrderSearch : null,
    orderSearch: params.orderSearch !== undefined ? params.orderSearch : null,
    b2bOrderSearch: params.b2bOrderSearch !== undefined ? params.b2bOrderSearch : null,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    status: maybe(() => params.status.map((status) => findValueInEnum(status, PurchaseStatusEnum))),
  };
}

export const getStatusFilterVariableFromPurchaseRouteParams = (
  routeParams: PurchaseListViewRouteParams
): PurchaseStatusEnum[] => {
  const { fulfilledBy, status } = routeParams;
  const isFulfilledByBossList = fulfilledBy === "boss";
  const isFulfilledByVendorList = fulfilledBy === "vendor";
  let availableFilterStatus: PurchaseStatusEnum[] = [];
  switch (status) {
    case "standby-or-pending":
      if (isFulfilledByBossList) {
        availableFilterStatus = [PurchaseStatusEnum.STANDBY, PurchaseStatusEnum.PENDING];
      } else if (isFulfilledByVendorList) {
        availableFilterStatus = [PurchaseStatusEnum.STANDBY];
      }
      break;
    case "revision":
      availableFilterStatus = [PurchaseStatusEnum.REQ_REVISION, PurchaseStatusEnum.REVISION];
      break;
    case "pending":
      availableFilterStatus = [PurchaseStatusEnum.PENDING];
      break;
    case "closed":
      availableFilterStatus = [PurchaseStatusEnum.CLOSED];
      break;
    case "all-status":
      if (isFulfilledByBossList) {
        availableFilterStatus = Object.values(PurchaseStatusEnum);
      } else if (isFulfilledByVendorList) {
        availableFilterStatus = [PurchaseStatusEnum.STANDBY, PurchaseStatusEnum.CLOSED, PurchaseStatusEnum.CANCELED];
      }
      break;
  }
  return availableFilterStatus;
};

export function getFilterQueryParam(filter: IFilterElement<PurchaseFilterKeys>): PurchaseListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case PurchaseFilterKeys.purchaseDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.createdFrom,
        PurchaseListViewUrlFiltersEnum.createdTo
      );
    case PurchaseFilterKeys.purchaseOrderDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.purchaseOrderDateFrom,
        PurchaseListViewUrlFiltersEnum.purchaseOrderDateTo
      );
    case PurchaseFilterKeys.purchaseCloseDate:
      return getMinMaxQueryParam(
        filter,
        PurchaseListViewUrlFiltersEnum.purchaseCloseDateFrom,
        PurchaseListViewUrlFiltersEnum.purchaseCloseDateTo
      );
    case PurchaseFilterKeys.purchaseCloseMonth:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.purchaseCloseMonth);
    case PurchaseFilterKeys.type:
      return getMultipleValueQueryParam(filter, PurchaseListViewUrlFiltersWithMultipleValues.type);
    case PurchaseFilterKeys.purchaseOrderSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.purchaseOrderSearch);
    case PurchaseFilterKeys.orderSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.orderSearch);
    case PurchaseFilterKeys.b2bOrderSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.b2bOrderSearch);
    case PurchaseFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.productSearch);
    case PurchaseFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.vendorSearch);
    case PurchaseFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.brandSearch);
    case PurchaseFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, PurchaseListViewUrlFiltersEnum.userSearch);
    case PurchaseFilterKeys.status:
      return getMultipleValueQueryParam(filter, PurchaseListViewUrlFiltersWithMultipleValues.status);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PurchaseListViewUrlFilters>(PURCHASE_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PurchaseListViewUrlQueryParams,
  PurchaseListViewUrlFilters
>({ ...PurchaseListViewUrlFiltersEnum, ...PurchaseListViewUrlFiltersWithMultipleValues });
</file>

