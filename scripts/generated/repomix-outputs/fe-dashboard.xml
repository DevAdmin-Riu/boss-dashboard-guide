import { toggle } from "@utils/lists";
import { Checkbox, Col, Collapse, Radio, Row } from "antd";
import React from "react";

import { FilterBaseFieldProps } from "./types";

const FilterOptionField: React.FC<FilterBaseFieldProps> = ({ disabled, filterField, onFilterPropertyChange }) => {
  const handleSelect = (value: string) => {
    const selectedValue = filterField.value.filter((v) => v !== undefined);

    onFilterPropertyChange({
      payload: {
        name: filterField.name,
        update: {
          value: filterField.multiple ? toggle(value, selectedValue, (a, b) => a === b) : [value],
          active: true,
        },
      },
      type: "set-property",
    });
  };

  const hasOptionsMoreThan20 = filterField.options.length > 20;
  const renderOptions = () => (
    <Row justify="start">
      {filterField.options.map((option, idx) => (
        <Col key={idx}>
          {filterField.multiple ? (
            <Checkbox
              name={filterField.name}
              disabled={disabled}
              checked={filterField.active ? filterField.value.includes(option.value) : false}
              onChange={() => handleSelect(option.value)}
            >
              {option.label}
            </Checkbox>
          ) : (
            <Radio
              name={filterField.name}
              disabled={disabled}
              checked={filterField.active ? filterField.value[0] === option.value : false}
              onChange={() => handleSelect(option.value)}
            >
              {option.label}
            </Radio>
          )}
        </Col>
      ))}
    </Row>
  );

  return hasOptionsMoreThan20 ? (
    <Collapse collapsible="header">
      <Collapse.Panel key="1" header="선택 옵션 펼치기 / 접기">
        {renderOptions()}
      </Collapse.Panel>
    </Collapse>
  ) : (
    renderOptions()
  );
};

export default FilterOptionField;
