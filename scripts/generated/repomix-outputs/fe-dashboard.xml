import useBulkActions from "@hooks/useBulkActions";
import useNavigator from "@hooks/useNavigator";
import useStateFromProps from "@hooks/useStateFromProps";
import useUser from "@hooks/useUser";
import useStaffMemberSearch from "@src/api/searches/useStaffMemberSearch";
import useShop from "@src/app/providers/ShopProvider/useShop";
import MembersErrorDialog from "@src/app/views/settings/permissionGroups/components/MembersErrorDialog";
import { arePermissionsExceeded, permissionsDiff, usersDiff } from "@src/app/views/settings/permissionGroups/utils";
import { DEFAULT_INITIAL_SEARCH_DATA } from "@src/global/assets/constants/config";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { getSortParams } from "@utils/sort";
import { Button } from "antd";
import React, { useState } from "react";

import { usePermissionGroupUpdate } from "../../api/mutations";
import { usePermissionGroupDetailsQuery } from "../../api/queries";
import { PermissionGroupUpdate } from "../../api/types/PermissionGroupUpdate";
import AssignMembersDialog from "../../components/AssignMembersDialog";
import PermissionGroupDetailsPage, {
  PermissionGroupDetailsPageFormData,
} from "../../components/PermissionGroupDetailsPage";
import UnassignMembersDialog from "../../components/UnassignMembersDialog";
import {
  permissionGroupDetailsUrl,
  PermissionGroupDetailsViewUrlQueryParams,
  permissionGroupListViewUrl,
} from "../../urls";

interface PermissionGroupDetailsViewProps {
  id: string;
  params: PermissionGroupDetailsViewUrlQueryParams;
}

enum PermissionModalModeEnum {
  Assign = "Assign",
  Unassign = "Unassign",
  UnassignError = "UnassignError",
}

export const PermissionGroupDetailsView: React.FC<PermissionGroupDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();
  const shop = useShop();
  const user = useUser();

  const { data, loading } = usePermissionGroupDetailsQuery({
    variables: { id, userId: user?.user.id },
  });

  const [membersList, setMembersList] = useStateFromProps(data?.permissionGroup.users);

  const [membersModified, setMembersModified] = useState(false);

  const {
    search,
    result: searchResult,
    loadMore,
  } = useStaffMemberSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });

  const handleUpdateSuccess = (data: PermissionGroupUpdate) => {
    const errors = data.permissionGroupUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      resetForCloseModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
      if (errors.some((e) => e.field === "removeUsers")) {
        openModalWithoutNavigate(PermissionModalModeEnum.UnassignError);
      }
    }
  };

  const [permissionGroupUpdate, permissionGroupUpdateResult] = usePermissionGroupUpdate({
    onCompleted: handleUpdateSuccess,
  });

  const [idsForModal, setIdsForModal] = useState([]);
  const [modalMode, setModalMode] = useState(null);
  const resetForCloseModal = () => {
    setModalMode(null);
    setIdsForModal([]);
  };

  const openModalWithoutNavigate = (madalMode: PermissionModalModeEnum, idsForModal?: string[]) => {
    setModalMode(madalMode);
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
  };

  const { isSelected, listElements, toggle, toggleAll } = useBulkActions(idsForModal);

  const handleSort = createSortHandler(navigate, (params) => permissionGroupDetailsUrl(id, params), params);

  const unassignMembers = () => {
    setMembersList(membersList?.filter((m) => !listElements.includes(m.id)));
    setMembersModified(true);
    resetForCloseModal();
  };

  const isGroupEditable = (data?.user.editableGroups || []).filter((g) => g.id === id).length > 0;

  const lastSourcesOfPermission = (data?.user.userPermissions || [])
    .filter((perm) => perm.sourcePermissionGroups.length === 1 && perm.sourcePermissionGroups[0].id === id)
    .map((perm) => perm.code);

  const userPermissions = user?.user.userPermissions.map((p) => p.code) || [];

  const permissions = (shop?.permissions || []).map((perm) => ({
    ...perm,
    disabled: !userPermissions.includes(perm.code),
    lastSource: lastSourcesOfPermission.includes(perm.code),
  }));

  const permissionsExceeded = arePermissionsExceeded(data?.permissionGroup, user.user);
  const disabled = loading || !isGroupEditable || permissionsExceeded;

  const handleSubmit = async (formData: PermissionGroupDetailsPageFormData) => {
    const result = await permissionGroupUpdate({
      variables: {
        id,
        input: {
          name: formData.name,
          ...permissionsDiff(data?.permissionGroup, formData),
          ...usersDiff(data?.permissionGroup, formData),
        },
      },
    });

    return result.data.permissionGroupUpdate.errors;
  };

  return (
    <>
      <PermissionGroupDetailsPage
        permissionGroup={data?.permissionGroup}
        permissionsExceeded={permissionsExceeded}
        members={membersList || []}
        membersModified={membersModified}
        onBack={() => navigate(permissionGroupListViewUrl())}
        onAssign={() => openModalWithoutNavigate(PermissionModalModeEnum.Assign)}
        onUnassign={(ids) => openModalWithoutNavigate(PermissionModalModeEnum.Unassign, ids)}
        errors={permissionGroupUpdateResult?.data?.permissionGroupUpdate.errors || []}
        onSubmit={handleSubmit}
        permissions={permissions}
        saveButtonBarState={permissionGroupUpdateResult.status}
        disabled={disabled}
        toggle={toggle}
        toggleAll={toggleAll}
        selectedRowKeys={listElements}
        isChecked={isSelected}
        selected={listElements.length}
        sort={getSortParams(params)}
        toolbar={
          <Button
            danger
            type="primary"
            disabled={disabled || listElements.length === 0}
            onClick={() => openModalWithoutNavigate(PermissionModalModeEnum.Unassign, listElements)}
          >
            일괄 {buttonText.unassign}
          </Button>
        }
        onSort={handleSort}
      />
      <AssignMembersDialog
        loading={disabled || searchResult.loading}
        staffMembers={maybe(
          () =>
            searchResult?.data?.search.edges
              .map((edge) => edge.node)
              .filter((suggestedMember) => !membersList.map((member) => member.id).includes(suggestedMember.id)),
          []
        )}
        onSearchChange={search}
        onFetchMore={loadMore}
        hasMore={searchResult?.data?.search.pageInfo.hasNextPage}
        initialSearch=""
        open={modalMode === PermissionModalModeEnum.Assign}
        onClose={resetForCloseModal}
        onSubmit={(formData) => {
          setMembersList([...membersList, ...formData.filter((member) => !membersList.includes(member))]);
          setMembersModified(true);
          resetForCloseModal();
        }}
      />
      <UnassignMembersDialog
        onConfirm={unassignMembers}
        confirmButtonState={permissionGroupUpdateResult.status}
        quantity={listElements.length}
        open={modalMode === PermissionModalModeEnum.Unassign}
        onClose={resetForCloseModal}
      />
      <MembersErrorDialog
        onConfirm={resetForCloseModal}
        confirmButtonState={permissionGroupUpdateResult.status}
        open={modalMode === PermissionModalModeEnum.UnassignError}
        onClose={resetForCloseModal}
      />
    </>
  );
};
</file>

