<file path="src/app/components/AssignedBrandTable.tsx">
import { DeleteFilled } from "@ant-design/icons";
import { FormChange } from "@hooks/useForm";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import {
  BannerList_banners_edges_node,
  BannerList_banners_edges_node_availableBrands,
} from "@src/app/views/notice/banners/api/types/BannerList";
import { utils } from "@utils/utils";
import { Button, Card, Row, Space, Switch, Table, Typography } from "antd";
import type { ColumnsType } from "antd/es/table";
import React from "react";

import { CardTitleAntd } from "./CardTitle/CardTitleAntd";
import { columnNameConstant } from "./ColumnHelper/columnConstant";

interface AssignedBrandTableProps {
  brands: Array<Pick<BannerList_banners_edges_node_availableBrands, "id" | "name">>;
  title: string;
  disabled: boolean;
  originData: Pick<BannerList_banners_edges_node, "availableToAllBrands">;
  formData: {
    availableToAllBrands: boolean;
  };
  onChange: FormChange;
  onBrandAssign: () => void;
  onBrandUnassign: (id: string, brandNameForModal: string) => void;
  onBrandUnassignBulk: (unassignList: string[]) => void;
}

const AssignedBrandTable: React.FC<AssignedBrandTableProps> = (props) => {
  const {
    title,
    brands,
    disabled,
    originData,
    formData,
    onChange,
    onBrandAssign,
    onBrandUnassign,
    onBrandUnassignBulk,
  } = props;
  const [selectedRowKeys, setSelectedRowKeys] = React.useState<React.Key[]>([]);
  const { availableToAllBrands: originAvailableToAllBrands } = originData;
  const { availableToAllBrands: formAvailableToAllBrands } = formData;

  const onSelectChange = (newSelectedRowKeys: React.Key[]) => {
    setSelectedRowKeys(newSelectedRowKeys);
  };

  const rowSelection = {
    selectedRowKeys,
    onChange: onSelectChange,
  };
  const hasSelected = selectedRowKeys.length > 0;

  const columns: ColumnsType<BannerList_banners_edges_node_availableBrands> = [
    {
      title: columnNameConstant.brand.BRAND_NAME,
      key: "name",
      align: "center",
      width: 200,
      render: (_, record) => record.name || "-",
    },
    {
      title: "삭제",
      key: "action",
      align: "center",
      width: 80,
      render: (_, record) => (
        <Button
          type="text"
          icon={<DeleteFilled />}
          size="large"
          onClick={() => onBrandUnassign(record.id, record.name)}
        />
      ),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const tableTitle = () => (
    <Row justify={hasSelected ? "space-between" : "end"}>
      {hasSelected && <Typography>{selectedRowKeys.length}개 브랜드를 선택했습니다.</Typography>}
      <Space>
        <Button
          danger
          type="default"
          disabled={disabled || selectedRowKeys.length <= 0}
          onClick={() => onBrandUnassignBulk(selectedRowKeys.map(String))}
        >
          선택 브랜드 제거
        </Button>
        <Button type="primary" disabled={disabled} onClick={onBrandAssign}>
          브랜드 추가
        </Button>
      </Space>
    </Row>
  );

  return (
    <Card
      title={
        <CardTitleAntd
          title={`${title} 게시 브랜드`}
          extra={
            <Space>
              <Typography>전체 브랜드 게시</Typography>
              <Switch
                checkedChildren="ON"
                unCheckedChildren="OFF"
                checked={formAvailableToAllBrands}
                onChange={(value) => onChange({ target: { name: "availableToAllBrands", value } })}
              />
            </Space>
          }
        />
      }
      bodyStyle={{ padding: 0 }}
    >
      {formAvailableToAllBrands === false &&
        (originAvailableToAllBrands ? (
          <Row justify="center" style={{ padding: "48px 0" }}>
            <Typography.Text strong type="warning">
              저장 버튼을 클릭한 후, 게시할 브랜드를 선택할 수 있습니다.
            </Typography.Text>
          </Row>
        ) : (
          <Table
            {...commonTableProps}
            title={tableTitle}
            columns={columns}
            dataSource={brands}
            rowSelection={rowSelection}
            scroll={{ x: tableWidthSum, y: 500 }}
          />
        ))}
    </Card>
  );
};
export default AssignedBrandTable;
