  const isReverseFeeBrand = contractType === BrandContractTypeEnum.REVERSE_FEE;
  const isNotRunningContractStatus = checkIsNotRunningContractStatusEnum(contractStatus);
  const enableForFbvService = enabledServices.includes(BrandServiceTypeEnum.FBV);
  const enableForLinkersService = enabledServices.includes(BrandServiceTypeEnum.LINKERS);

  const makePageTitleText = () => {
    const defaultText = `${brand.name} (브랜드코드: ${brand.code})`;
    if (brand.staff?.firstName) {
      return `${defaultText} (담당 MD: ${brand.staff?.firstName})`;
    }
    return defaultText;
  };

  const makeContractStatusDescription = () => {
    switch (contractStatus) {
      case BrandContractStatusEnum.IN_CONSULTING:
        return "포장보스 도입 상담 중인 브랜드입니다.";
      case BrandContractStatusEnum.FAILED:
        return "포장보스 도입 상담에 실패한 브랜드입니다.";
      case BrandContractStatusEnum.CONTRACT_WARNING:
        return "물품공급계약의 갱신이 필요합니다.";
      case BrandContractStatusEnum.EXPIRED:
        return "물품공급계약이 만료된 브랜드입니다.";
      case BrandContractStatusEnum.RUNNING:
      default:
        return "";
    }
  };

  const makePageTitle = () => {
