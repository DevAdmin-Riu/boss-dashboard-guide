export const transformStockStatusByEstShortageEnum = (stockStatus: StockStatusByEstShortageEnum, isHqMode: boolean) => {
  if (utils.isEmpty(stockStatus)) {
    return "-";
  }

  if (stockStatus === StockStatusByEstShortageEnum.CRITICAL) {
    return "악성 재고";
  }

  if (stockStatus === StockStatusByEstShortageEnum.NORMAL) {
    return "정상";
  }

  if (stockStatus === StockStatusByEstShortageEnum.NONE) {
    return "-";
  }

  if (isHqMode) {
    switch (stockStatus) {
      case StockStatusByEstShortageEnum.SLOW_CYCLE:
        return "저회전 재고";
      case StockStatusByEstShortageEnum.WARNING:
        return "경과 재고";
    }
  } else {
    switch (stockStatus) {
      case StockStatusByEstShortageEnum.SLOW_CYCLE:
      case StockStatusByEstShortageEnum.WARNING:
        return "정상";
    }
  }
  return "-";
};

