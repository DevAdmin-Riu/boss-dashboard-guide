<file path="src/app/views/brand/brands/components/BrandCollapseComponents/BrandPaymentInfo.tsx">
import { BrandContractTypeEnum, BrandCreateInput, BrandUpdateInput, PgTypeEnum } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import EditableField, { NonEditableField } from "@src/app/components/EditableField/EditableField";
import NumberComponent from "@src/app/components/Number";
import useShop from "@src/app/providers/ShopProvider/useShop";
import { brandPgTypeChoices } from "@src/app/views/brand/brands/utils";
import { Col, Row } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import React from "react";

interface BrandPaymentInfoProps {
  isCreate: boolean;
  TypeSafeForm: TypeSafeForm<BrandCreateInput | BrandUpdateInput>;
  editMode?: boolean;
  contractType: BrandContractTypeEnum;
}

export const BrandPaymentInfo: React.FC<BrandPaymentInfoProps> = (props) => {
  const { isCreate, TypeSafeForm, editMode, contractType } = props;

  const shopData = useShop();

  const pgType = TypeSafeForm.getUseFormWatched({ name: "pgType" });
  let pgBpCardPayingChargeRate: number = null;
  let pgCardPayingChargeRate: number = null;
  let pgVbankPayingChargeExcludeVat: number = null;
  switch (pgType) {
    case PgTypeEnum.TOSS:
      pgBpCardPayingChargeRate = shopData.tossPluginInfo.bpCardPayingChargeRate;
      pgCardPayingChargeRate = shopData.tossPluginInfo.cardPayingChargeRate;
      pgVbankPayingChargeExcludeVat = shopData.tossPluginInfo.vbankPayingChargeExcludeVat;
      break;
    case PgTypeEnum.INICIS:
      pgCardPayingChargeRate = shopData.inicisPluginInfo.cardPayingChargeRate;
      pgVbankPayingChargeExcludeVat = shopData.inicisPluginInfo.vbankPayingChargeExcludeVat;
      break;
  }

  const isReverseFeeBrand = contractType === BrandContractTypeEnum.REVERSE_FEE;
  const isPgToss = pgType === PgTypeEnum.TOSS;
  const isPgInicis = pgType === PgTypeEnum.INICIS;

  const isCardPayAllowed = TypeSafeForm.getUseFormWatched({ name: "isCardPayAllowed" });
  const isVbankPayAllowed = TypeSafeForm.getUseFormWatched({ name: "isVbankPayAllowed" });

  const realEditMode = isCreate || editMode;

  const pgTypeOptionsByContractType: DefaultOptionType[] = isReverseFeeBrand
    ? brandPgTypeChoices
    : brandPgTypeChoices.map((pgType) => {
        if (pgType.value === PgTypeEnum.INICIS) {
          return { ...pgType, disabled: true };
        }
        return pgType;
      });

  return (
    <>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <EditableField
            label="이용 PG사"
            type="select"
            options={pgTypeOptionsByContractType}
            name={TypeSafeForm.getValidDataIndex("pgType")}
            value={TypeSafeForm.getFieldValue("pgType")}
            editMode={realEditMode}
          />
        </Col>
      </Row>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <NonEditableField label="간편 결제 수수료" value={<NumberComponent value={pgBpCardPayingChargeRate} />} />
        </Col>
        <Col xs={24} sm={4}>
          <NonEditableField label="카드 결제 수수료" value={<NumberComponent value={pgCardPayingChargeRate} />} />
        </Col>
        <Col xs={24} sm={4}>
          <NonEditableField
            label="가상계좌 결제 수수료"
            value={<NumberComponent value={pgVbankPayingChargeExcludeVat} />}
          />
        </Col>
      </Row>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <EditableField
            label="카드 결제"
            type="switch"
            name={TypeSafeForm.getValidDataIndex("isCardPayAllowed")}
            value={TypeSafeForm.getFieldValue("isCardPayAllowed")}
            editMode={realEditMode}
          />
        </Col>
        {isCardPayAllowed && (
          <>
            <Col xs={24} sm={4}>
              <EditableField
                label="브랜드 수수료(카드, %)"
                type="number"
                precision={2}
                name={TypeSafeForm.getValidDataIndex("cardPayingChargeRate")}
                value={TypeSafeForm.getFieldValue("cardPayingChargeRate")}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={4}>
              <EditableField
                label="직거래 수수료(카드, %)"
                type="number"
                precision={2}
                name={TypeSafeForm.getValidDataIndex("fbvCardPayingChargeRate")}
                value={TypeSafeForm.getFieldValue("fbvCardPayingChargeRate")}
                editMode={realEditMode}
              />
            </Col>
          </>
        )}
      </Row>
      <Row gutter={[8, 0]}>
        <Col xs={24} sm={4}>
          <EditableField
            label="가상계좌 결제"
            type="switch"
            name={TypeSafeForm.getValidDataIndex("isVbankPayAllowed")}
            value={TypeSafeForm.getFieldValue("isVbankPayAllowed")}
            editMode={realEditMode}
          />
        </Col>
        {isVbankPayAllowed && (
          <>
            <Col xs={24} sm={4}>
              <EditableField
                label="브랜드 수수료(가상계좌, 원)"
                type="number"
                precision={2}
                name={TypeSafeForm.getValidDataIndex("vbankPayingChargeExcludeVat")}
                value={TypeSafeForm.getFieldValue("vbankPayingChargeExcludeVat")}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={4}>
              <EditableField
                label="직거래 수수료(가상계좌, 원)"
                type="number"
                precision={2}
                name={TypeSafeForm.getValidDataIndex("fbvVbankPayingChargeExcludeVat")}
                value={TypeSafeForm.getFieldValue("fbvVbankPayingChargeExcludeVat")}
                editMode={realEditMode}
              />
            </Col>
          </>
        )}
      </Row>
      {isReverseFeeBrand && (
        <Row gutter={[8, 0]}>
          {isPgToss && (
            <>
              <Col span={24}>
                <EditableField
                  type="input"
                  label="Client Key(매출인식, 토스)"
                  name={TypeSafeForm.getValidDataIndex("reverseFeeTossClientKey")}
                  value={TypeSafeForm.getFieldValue("reverseFeeTossClientKey")}
                  editMode={realEditMode}
                />
              </Col>
              <Col span={24}>
                <EditableField
                  type="input"
                  label="Secret Key(매출인식, 토스)"
                  name={TypeSafeForm.getValidDataIndex("reverseFeeTossSecretKey")}
                  value={TypeSafeForm.getFieldValue("reverseFeeTossSecretKey")}
                  editMode={realEditMode}
                />
              </Col>
            </>
          )}
          {isPgInicis && (
            <>
              <Col span={24}>
                <EditableField
                  type="input"
                  label="Merchant ID(매출인식, 이니시스)"
                  name={TypeSafeForm.getValidDataIndex("reverseFeeInicisMerchantId")}
                  value={TypeSafeForm.getFieldValue("reverseFeeInicisMerchantId")}
                  editMode={realEditMode}
                />
              </Col>
              <Col span={24}>
                <EditableField
                  type="input"
                  label="Sign Key(매출인식, 이니시스)"
                  name={TypeSafeForm.getValidDataIndex("reverseFeeInicisSignKey")}
                  value={TypeSafeForm.getFieldValue("reverseFeeInicisSignKey")}
                  editMode={realEditMode}
                />
              </Col>
            </>
          )}
        </Row>
      )}
    </>
  );
};
</file>

