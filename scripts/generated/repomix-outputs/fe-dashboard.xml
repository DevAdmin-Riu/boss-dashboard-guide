export function getFilterVariables(params: HqReqBossProductListViewUrlFilters): RequestBossProductFilterInput {
  return {
    brandSearch: params.brandSearch,
    productSearch: params.productSearch,
    requestNumber: params.requestNumber,
    requestedStatusAt: getGteLteVariables({
      lte: params.requestedStatusAtTo,
      gte: params.requestedStatusAtFrom,
    }),
    acceptedStatusAt: getGteLteVariables({
      lte: params.acceptedStatusAtTo,
      gte: params.acceptedStatusAtFrom,
    }),
    reqAdditionalStatusAt: getGteLteVariables({
      lte: params.reqAdditionalStatusAtTo,
      gte: params.reqAdditionalStatusAtFrom,
    }),
    vendorPriceStatusAt: getGteLteVariables({
      lte: params.vendorPriceStatusAtTo,
      gte: params.vendorPriceStatusAtFrom,
    }),
    brandPriceStatusAt: getGteLteVariables({
      lte: params.brandPriceStatusAtTo,
      gte: params.brandPriceStatusAtFrom,
    }),
    reqEstimateFixStatusAt: getGteLteVariables({
      lte: params.reqEstimateFixStatusAtTo,
      gte: params.reqEstimateFixStatusAtFrom,
    }),
    confirmedStatusAt: getGteLteVariables({
      lte: params.confirmedStatusAtTo,
      gte: params.confirmedStatusAtFrom,
    }),
    completedStatusAt: getGteLteVariables({
      lte: params.completedStatusAtTo,
      gte: params.completedStatusAtFrom,
    }),
    status: params.status as RequestBossProductStatusEnum[],
    spec: params.spec,
    material: params.material,
    color: params.color,
    isExclusive: params.isExclusive !== undefined ? parseBoolean(params.isExclusive, false) : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof HqReqBossProductListListFilterOpts>
): HqReqBossProductListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case HqReqBossProductListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.brandSearch);
    case HqReqBossProductListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.productSearch);
    case HqReqBossProductListFilterKeys.requestNumber:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.requestNumber);
    case HqReqBossProductListFilterKeys.status:
      return getMultipleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersWithMultipleValuesEnum.status);
    case HqReqBossProductListFilterKeys.requestedStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.requestedStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.requestedStatusAtTo
      );
    case HqReqBossProductListFilterKeys.acceptedStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.acceptedStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.acceptedStatusAtTo
      );
    case HqReqBossProductListFilterKeys.reqAdditionalStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.reqAdditionalStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.reqAdditionalStatusAtTo
      );
    case HqReqBossProductListFilterKeys.vendorPriceStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.vendorPriceStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.vendorPriceStatusAtTo
      );
    case HqReqBossProductListFilterKeys.brandPriceStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.brandPriceStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.brandPriceStatusAtTo
      );
    case HqReqBossProductListFilterKeys.reqEstimateFixStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.reqEstimateFixStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.reqEstimateFixStatusAtTo
      );
    case HqReqBossProductListFilterKeys.confirmedStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.confirmedStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.confirmedStatusAtTo
      );
    case HqReqBossProductListFilterKeys.completedStatusAt:
      return getMinMaxQueryParam(
        filter,
        HqReqBossProductListViewUrlFiltersEnum.completedStatusAtFrom,
        HqReqBossProductListViewUrlFiltersEnum.completedStatusAtTo
      );
    case HqReqBossProductListFilterKeys.spec:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.spec);
    case HqReqBossProductListFilterKeys.material:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.material);
    case HqReqBossProductListFilterKeys.color:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.color);
    case HqReqBossProductListFilterKeys.isExclusive:
      return getSingleValueQueryParam(filter, HqReqBossProductListViewUrlFiltersEnum.isExclusive);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqReqBossProductListViewUrlFilters>(REQ_BOSS_PRODUCT_FILTERS_KEY);

