import useShop from "@src/app/providers/ShopProvider/useShop";
import { ColumnsType } from "antd/lib/table";

import { RefundQuestionList_refundQuestions_edges_node } from "../../api/types/RefundQuestionList";
import {
  customerQuestionIdColumn,
  orderIdColumn,
  questionInspectCompletedAtColumn,
  questionInspectStatusColumn,
  questionReasonTextColumn,
  questionRefundReasonColumn,
  questionStatusColumn,
  questionTypeColumn,
  questionUserBrandCodeColumn,
  questionUserBrandNameColumn,
  questionUserFirstNameColumn,
  questionUserLoginIdColumn,
} from "../RefundQuestionListTable/columnHelper";
import { mergeRefundReasonChoices } from "../RefundQuestionListTable/utils";
interface getCustomerRefundQuestionInspectListTableColumnsProps {
  onRowClick: (number) => any;
  listProps: any;
  onRowRefundBtnClick: ({ id, refundId }) => void;
}

export const getCustomerRefundQuestionInspectListTableColumns = (
  props: getCustomerRefundQuestionInspectListTableColumnsProps
) => {
  const { onRowClick } = props;
  // const sort = listProps.sort;
  // const onSort = listProps.onSort;

  const shop = useShop();
  const refundTypeChoices = shop.refundTypeChoices;
  const refundReasonChoices = shop.refundReasonChoices;
  const refundCancelReasonChoices = shop.refundCancelReasonChoices;
  // refundReasonChoices와 refundCancelReasonChoices를 합친 새로운 choices를 만듬.
  const refundReasonChoicesWithCancel = mergeRefundReasonChoices(refundReasonChoices, refundCancelReasonChoices);

  const refundStatusTypeChoices = shop.refundStatusTypeChoices;
  const columns: ColumnsType<RefundQuestionList_refundQuestions_edges_node> = [
    orderIdColumn(onRowClick),
    customerQuestionIdColumn(),
    questionUserFirstNameColumn(),
    questionUserLoginIdColumn(),
    questionUserBrandNameColumn(),
    questionUserBrandCodeColumn(),
    questionTypeColumn(refundTypeChoices),
    questionStatusColumn(refundStatusTypeChoices),
    questionInspectStatusColumn(),
    questionInspectCompletedAtColumn(),
    questionRefundReasonColumn(refundReasonChoicesWithCancel),
    questionReasonTextColumn(),
  ];

  return columns;
};
