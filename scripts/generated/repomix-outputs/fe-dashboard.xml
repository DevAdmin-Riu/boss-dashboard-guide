import useNavigator from "@hooks/useNavigator";
import ActionDialog from "@src/app/components/ActionDialog";
import { ProductImagePage } from "@src/app/views/product/products/components/ProductImagePage";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import React from "react";

import { useProductCommonImageDeleteMutation, useProductCommonImageUpdateMutation } from "../api/mutations";
import { useProductCommonImagesQuery } from "../api/queries";
import { productCiEditViewUrl, ProductCiEditViewUrlQueryParams, productCiViewPath } from "../urls";

interface ProductCommonImageEditProps {
  imageId: string;
  params: ProductCiEditViewUrlQueryParams;
}

export const ProductCiEditView: React.FC<ProductCommonImageEditProps> = ({ imageId, params }) => {
  const navigate = useNavigator();

  const { data, loading } = useProductCommonImagesQuery({});

  const handleBack = () => {
    navigate(productCiViewPath);
  };

  const [updateImage, updateResult] = useProductCommonImageUpdateMutation({
    onCompleted: (data) => {
      const errors = data.productCommonImageUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [deleteImage, deleteResult] = useProductCommonImageDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productCommonImageDelete.errors;
      if (errors.length === 0) {
        const images = data.productCommonImageDelete.shop.productCommonImages;
        if (images?.length > 0) {
          showNotificationSuccess("이미지가 삭제되었습니다.");
          const firstImageId = images[0].id;
          navigate(productCiEditViewUrl(firstImageId));
        } else {
          showNotificationSuccess("이미지가 모두 삭제되어 이전페이지로 이동합니다.");
          handleBack();
        }
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleDelete = () => deleteImage({ variables: { id: imageId } });
  const handleImageClick = (id: string) => navigate(productCiEditViewUrl(id));
  const handleUpdate = (formData: { description: string }) => {
    updateImage({
      variables: {
        alt: formData.description,
        id: imageId,
      },
    });
  };
  const image = data?.shop?.productCommonImages
    ? data?.shop?.productCommonImages.find((e) => e.id === imageId)
    : undefined;

  return (
    <>
      <ProductImagePage
        backButtonTitle={"공통 상세페이지 관리"}
        disabled={loading}
        image={image || null}
        images={data?.shop?.productCommonImages}
        onBack={handleBack}
        onDelete={() =>
          navigate(
            productCiEditViewUrl(imageId, {
              action: "remove",
            })
          )
        }
        onRowClick={handleImageClick}
        onSubmit={handleUpdate}
        saveButtonBarState={updateResult.status}
      />
      <ActionDialog
        onClose={() => navigate(productCiEditViewUrl(imageId), true)}
        onConfirm={handleDelete}
        open={params.action === "remove"}
        title={"이미지 삭제"}
        variant="delete"
        confirmButtonState={deleteResult.status}
      >
        이 이미지를 삭제하시겠습니까?
      </ActionDialog>
    </>
  );
};
</file>

