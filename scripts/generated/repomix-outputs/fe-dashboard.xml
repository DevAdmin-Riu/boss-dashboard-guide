import { B2bSalesStatsByBrandFilterInput, BrandB2bPayMethodEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariablesForMonth,
  getMultipleValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  B2bSalesStatByBrandFilterKeys,
  B2bSalesStatByBrandFilterOpts,
} from "../../components/B2bSalesStatByBrandListPage/filters";
import {
  B2bSalesStatByBrandListViewUrlFilters,
  B2bSalesStatByBrandListViewUrlFiltersEnum,
  B2bSalesStatByBrandListViewUrlFiltersWithMultipleValuesEnum,
  B2bSalesStatByBrandListViewUrlQueryParams,
} from "../../urls";

const B2B_SALES_STAT_BY_BRAND_FILTERS_KEY = "b2bSalesStatByBrandFilters";

export function getFilterOpts(params: B2bSalesStatByBrandListViewUrlFilters): B2bSalesStatByBrandFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    statDateMonth: {
      active: maybe(() => !utils.isEmpty([filterVariables.statDate.gte]), false),
      value: maybe(
        () => moment(filterVariables.statDate.gte).format(onlyMonthFormat),
        moment().format(onlyMonthFormat)
      ),
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    b2bPayMethods: {
      active: maybe(() => !utils.isEmpty(filterVariables.b2bPayMethods), false),
      value: maybe(() => dedupeFilter(filterVariables.b2bPayMethods), []),
    },
  };
}

export function getFilterVariables(params: B2bSalesStatByBrandListViewUrlFilters): B2bSalesStatsByBrandFilterInput {
  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateMonth, lte: params.statDateMonth }),
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : undefined,
    b2bPayMethods: maybe(() => params.b2bPayMethods.map((method) => findInEnum(method, BrandB2bPayMethodEnum))),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<B2bSalesStatByBrandFilterKeys>
): B2bSalesStatByBrandListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case B2bSalesStatByBrandFilterKeys.statDateMonth:
      return getSingleValueQueryParam(filter, B2bSalesStatByBrandListViewUrlFiltersEnum.statDateMonth);
    case B2bSalesStatByBrandFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, B2bSalesStatByBrandListViewUrlFiltersEnum.brandSearch);
    case B2bSalesStatByBrandFilterKeys.b2bPayMethods:
      return getMultipleValueQueryParam(
        filter,
        B2bSalesStatByBrandListViewUrlFiltersWithMultipleValuesEnum.b2bPayMethods
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<B2bSalesStatByBrandListViewUrlFilters>(B2B_SALES_STAT_BY_BRAND_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  B2bSalesStatByBrandListViewUrlQueryParams,
  B2bSalesStatByBrandListViewUrlFilters
>({ ...B2bSalesStatByBrandListViewUrlFiltersEnum, ...B2bSalesStatByBrandListViewUrlFiltersWithMultipleValuesEnum });
</file>

