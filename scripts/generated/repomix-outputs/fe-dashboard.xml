import { InputCheckDef } from "@assets/constants/define_inputCheck";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Rule } from "antd/lib/form";

export function getFormInputNumberMinValueRule(settings: { min: number; message?: string }): Rule {
  const defaultMessage = `최소 ${settings.min.toLocaleString()} 이상 입력해주세요`;
  return {
    validator: (_, value: number) => {
      const convValue = utils.convertToNumberWrapper(value);
      if (convValue >= settings.min) {
        return Promise.resolve();
      } else {
        const errorMsg = settings.message || defaultMessage;
        return Promise.reject(new Error(errorMsg));
      }
    },
  };
}

export function getFormInputNumberMaxValueRule(settings: { max: number; message?: string }): Rule {
  const defaultMessage = `최대 ${settings.max.toLocaleString()} 까지만 가능합니다`;
  return {
    validator: (_, value: number) => {
      const convValue = utils.convertToNumberWrapper(value);
      if (convValue <= settings.max) {
        return Promise.resolve();
      } else {
        const errorMsg = settings.message || defaultMessage;
        return Promise.reject(new Error(errorMsg));
      }
    },
  };
}

export function checkVatValueToPriceIncludeVat(
  vatValue: number,
  price: number,
  precision: number = 0
): {
  isValid: boolean;
  ceil: number;
  floor: number;
} {
  // 1. 공급가액(price)에서 부가세를 계산합니다.
  const baseVat = price - toPriceExcludeVat(price, false, precision);

  // 2. precision에 따른 승수(multiplier)를 계산합니다.
  const multiplier = Math.pow(10, precision);

  // 3. toFixed() 대신, 곱하고 내림/올림 후 다시 나누는 방식을 사용합니다.
  const floor = Math.floor(baseVat * multiplier) / multiplier;
  const ceil = Math.ceil(baseVat * multiplier) / multiplier;

  const isValid = vatValue === floor || vatValue === ceil;

  return { isValid, ceil, floor };
}

export function checkVatValueToPriceExcludeVat(
  vatValue: number,
  priceExcludeVat: number,
  precision: number = 0
): {
  isValid: boolean;
  ceil: number;
  floor: number;
} {
  const baseVat = priceExcludeVat / 10;

  // 1. precision에 따른 승수(multiplier)를 계산합니다.
  // precision이 0이면 1, 1이면 10, 2이면 100이 됩니다.
  const multiplier = Math.pow(10, precision);

  // 2. toFixed() 대신, 곱하고 내림/올림 후 다시 나누는 방식을 사용합니다.
  const floor = Math.floor(baseVat * multiplier) / multiplier;
  const ceil = Math.ceil(baseVat * multiplier) / multiplier;

  const isValid = vatValue === floor || vatValue === ceil;

  return { isValid, ceil, floor };
}

export function getFormInputNumberVatValueRule(settings: {
  priceExcludeVat: number;
  isTaxFree: boolean;
  message?: string;
  pricision?: number;
}) {
  const { priceExcludeVat, isTaxFree, message, pricision } = settings;
  return {
    validator: (_, value: number) => {
      // 면세인 경우, 부가세는 0으로 고정
      if (isTaxFree && value === 0) {
        return Promise.resolve();
      }

      const convValue = utils.convertToNumberWrapper(value);
      const baseValue = priceExcludeVat / 10;

      // pricision이 존재하고 0보다 클 경우: 소수점 허용 로직
      if (pricision && pricision > 0) {
        const factor = Math.pow(10, pricision);
        const floorVat = Math.floor(baseValue * factor) / factor;
        const ceilVat = Math.ceil(baseValue * factor) / factor;

        if (convValue === floorVat || convValue === ceilVat) {
          return Promise.resolve();
        } else {
          const defaultMessage = `${getNumberFormat(floorVat)} 또는 ${getNumberFormat(ceilVat)}만 가능`;
          return Promise.reject(new Error(message || defaultMessage));
        }
      }

      // 부가세 제외 금액을 10으로 나눈 후, 내림한 값과 올림한 값 중에서만 입력 가능
      const floorVat = Math.floor(priceExcludeVat / 10);
      const ceilVat = Math.ceil(priceExcludeVat / 10);

      if (convValue === floorVat || convValue === ceilVat) {
        return Promise.resolve();
      } else {
        const defaultMessage = `${getNumberFormat(floorVat)} 또는 ${getNumberFormat(ceilVat)}만 가능`;
        const errorMsg = message || defaultMessage;
        return Promise.reject(new Error(errorMsg));
      }
    },
  };
}

export const isValidLoginIdValidator = (): Rule[] => {
  const pattern = "^[a-zA-Z0-9]";
  const reg = new RegExp(`${pattern}`);

  return [
    {
      min: InputCheckDef.loginIdMin,
    },
    {
      max: InputCheckDef.loginIdMax,
    },
    {
      pattern: reg,
      message: "아이디: 영문 또는 숫자만 입력해 주세요. (특수문자 사용 불가)",
    },
  ];
};

export const isValidPasswordValidator = (): Rule[] => {
  const pattern = "^[a-zA-Z0-9`~!@@#$%^&*|\\'\";:/?]";
  const reg = new RegExp(`${pattern}`);
  const regexpContainsNumber = new RegExp(/[0-9]/);
  const regexpContainsLetter = new RegExp(/[a-zA-Z]/);

  return [
    {
      min: InputCheckDef.loginPasswordMin,
    },
    {
      max: InputCheckDef.loginPasswordMax,
    },
    {
      pattern: reg,
      message: "불가능한 특수문자를 입력했습니다.",
    },
    {
      pattern: regexpContainsNumber,
      message: "최소 1글자 이상의 숫자가 필요합니다.",
    },
    {
      pattern: regexpContainsLetter,
      message: "최소 1글자 이상의 영문이 필요합니다.",
    },
  ];
};

export const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

export const isValidEmail = (email: string): boolean => EMAIL_REGEX.test(email);

export const isValidMultipleEmailValidator = (): Rule[] => [
  {
    validator: (_, value) => {
      if (!value || value.length === 0) {
        return Promise.reject();
      }
      const invalidEmails = value.filter((email: string) => !isValidEmail(email));
      if (invalidEmails.length > 0) {
        return Promise.reject(`올바르지 않은 이메일: ${invalidEmails.join(", ")}`);
      }
      return Promise.resolve();
    },
  },
];

export const isValidMobileAppVersionValidator = (): Rule[] => {
  const pattern = "^(?:(?:[0-9]?[0-9]?)[0-9]\\.){2}(?:[0-9]?[0-9]?[0-9])$";
  const reg = new RegExp(`${pattern}`);

  return [
    {
      min: InputCheckDef.mobileAppVersionMin,
      message: `버전은 점(.) 포함 최소 ${InputCheckDef.mobileAppVersionMin}글자부터 가능합니다`,
    },
    {
      max: InputCheckDef.mobileAppVersionMax,
      message: `버전은 점(.) 포함 최대 ${InputCheckDef.mobileAppVersionMax}글자까지만 가능합니다`,
    },
    {
      pattern: reg,
      message: "모바일 앱 버전 형식에 알맞게 입력해주세요.",
    },
  ];
};
