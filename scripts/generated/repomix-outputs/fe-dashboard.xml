import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Space, Table, Typography } from "antd";
import React, { useState } from "react";

import { useProductVariantManageEventAddMutation } from "../../api/mutations";
import {
  ProductDetails_product_outerVariants,
  ProductDetails_product_outerVariants_recentManageEvents_edges_node,
} from "../../api/types/ProductDetails";
import {
  ProductVariantDetails_productVariant,
  ProductVariantDetails_productVariant_recentManageEvents_edges_node,
} from "../../api/types/ProductVariantDetails";
import { productVariantManageEventListViewUrl } from "../../urls";
import { productVariantManageEventTypeChoices } from "../../utils/data";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "../PvOrBpvManageEventModal";
import { getProductVariantManageEventsTableSettings } from "./ProductVariantManageEventsTableSettings";

interface ProductVariantManageEventsProps {
  productVariant: ProductDetails_product_outerVariants | ProductVariantDetails_productVariant;
  loading: boolean;
  onShowDetailInfoModal: (record: ProductVariantManageEventsTableDataSourceType) => void;
}

export type ProductVariantManageEventsTableDataSourceType =
  | ProductDetails_product_outerVariants_recentManageEvents_edges_node
  | ProductVariantDetails_productVariant_recentManageEvents_edges_node;

export const ProductVariantManageEvents: React.FC<ProductVariantManageEventsProps> = (props) => {
  const { productVariant, loading, onShowDetailInfoModal } = props;
  const navigate = useNavigator();
  const [manageEventModalOpen, setManageEventModalOpen] = useState<boolean>(false);
  const manageEventList = maybe(() => productVariant?.recentManageEvents.edges.map((edge) => edge.node), []);

  const [addProductVariantManageEvent, addProductVariantManageEventOpts] = useProductVariantManageEventAddMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantManageEventAdd?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("제품 관리 이력이 추가되었습니다.");
        setManageEventModalOpen(false);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });
  const mutationLoading = addProductVariantManageEventOpts.loading;
  const onAdd = ({ manageEvent }: ProductVariantManageEventModalForm) =>
    addProductVariantManageEvent({
      variables: { productVariantId: productVariant?.id, manageEvent: manageEvent as ProductVariantManageEventInput },
    });

  const columns = getProductVariantManageEventsTableSettings({ onShowDetailInfoModal });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const disabled = loading || mutationLoading;
  const makeExtraUi = () => (
    <Space>
      <Typography.Link strong disabled={disabled} onClick={() => navigate(productVariantManageEventListViewUrl())}>
        모든 이력 보기
      </Typography.Link>
      <Button type="primary" disabled={disabled} onClick={() => setManageEventModalOpen(true)}>
        수정 사유 추가
      </Button>
    </Space>
  );

  return (
    <>
      <Card
        title={<CardTitleAntd title={"제품 관리 이력 (최근 5건)"} />}
        bodyStyle={{ padding: 0 }}
        extra={makeExtraUi()}
      >
        <Table
          {...commonTableProps}
          loading={disabled}
          columns={columns}
          dataSource={manageEventList}
          scroll={{ x: tableWidthSum }}
        />
      </Card>
      <ProductVariantManageEventModal
        isCreateMode
        showNeedReasonRadio={false}
        open={manageEventModalOpen}
        loading={mutationLoading}
        manageEventType={null}
        choices={productVariantManageEventTypeChoices}
        onSubmit={onAdd}
        onCancel={() => setManageEventModalOpen(false)}
      />
    </>
  );
};
</file>

