<file path="src/app/components/antd/InputNumber/InputNumberProps.tsx">
import { utils } from "@utils/utils";
import { InputNumberProps } from "antd";
import React from "react";

export type InputNumberClassName =
  | "ant-input-number-right-align"
  | "ant-input-number-bold"
  | "ant-input-number-not-bordered";
export const getInputNumberClassName = (classes: InputNumberClassName[]) => classes.join(" ");

export const getInputNumberProps = (settings: {
  // Precision 0 이나 안넣으나 정수만 가능한 것은 동일.
  precision?: number;
  dynamicValidate?: {
    ref: HTMLInputElement;
    setValue?: (input: number) => void;
  };
  // 3자리마다 콤마 표시 여부. 기본은 false,
  isCommaDisplay?: boolean;
  bordered?: boolean;
}): InputNumberProps => {
  const { precision, isCommaDisplay = false } = settings;
  function onKeyPress(event: React.KeyboardEvent<HTMLInputElement>) {
    const keyValue = event.key;

    // 음수 기호를 별도로 처리
    if (keyValue === "-") {
      const inputElement = event.target as HTMLInputElement;
      const { selectionStart } = inputElement;
      // 음수 기호는 입력값이 비어 있거나, 첫 번째 위치에서만 허용
      if (selectionStart === 0 && !inputElement.value.includes("-")) {
        return;
      }
      event.preventDefault();
      return;
    }

    const inputElement = event.target as HTMLInputElement;
    const { selectionStart, selectionEnd } = inputElement;
    const inputValue = inputElement.value;
    const newValue =
      selectionStart === null && selectionEnd === null
        ? inputValue + keyValue
        : inputValue.slice(0, selectionStart) + keyValue + inputValue.slice(selectionEnd);
    if (utils.checkInputNumberWithPrecision(newValue, precision) === false) {
      event.preventDefault();
    }
  }

  function onPaste(event: React.ClipboardEvent<HTMLInputElement>) {
    const pastedText = event.clipboardData.getData("text");
    const inputElement = event.target as HTMLInputElement;
    const { selectionStart, selectionEnd } = inputElement;

    const inputValue = inputElement.value;
    const newValue =
      selectionStart === null && selectionEnd === null
        ? inputValue + pastedText
        : inputValue.slice(0, selectionStart) + pastedText + inputValue.slice(selectionEnd);
    if (utils.checkInputNumberWithPrecision(newValue, precision) === false) {
      event.preventDefault();
    }
  }

  function onInput(value) {
    // value에서 쉼표를 제거한다.(3자리마다 있는)
    const removedCommaValue = utils.removeComma(value);

    if (utils.checkInputNumberWithPrecision(removedCommaValue, precision)) {
      if (settings.dynamicValidate.setValue) {
        settings.dynamicValidate.setValue(removedCommaValue);
        settings.dynamicValidate.ref.blur();
        settings.dynamicValidate.ref.focus();
      }
    }
  }

  const formatter = (value: number | string) => {
    if (utils.isEmpty(value, true)) {
      return "";
    }

    const str = String(value);
    if (!isCommaDisplay) {
      return str;
    }
    // 숫자로 파싱해서 반올림이 필요한지 체크
    let num = parseFloat(str.replace(/,/g, ""));
    if (!isNaN(num) && typeof precision === "number") {
      const parts = String(num).split(".");
      if (parts[1]?.length! > precision) {
        // precision 자리로 반올림
        const factor = Math.pow(10, precision);
        num = Math.round(num * factor) / factor;
      }
    }

    // 다시 문자열로
    const [intPart, decPart] = String(num).split(".");
    // 정수부에만 콤마 추가
    const formattedInt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    // 소수부가 있으면 붙이고, 없으면 정수부만 반환
    return decPart !== undefined ? `${formattedInt}.${decPart}` : formattedInt;
  };

  const parser = (value: string) => {
    // value가 비어있는 경우, parseFloat 결과값이 NaN이 됨.
    // 대시보드의 antd 버전에서는 parser에서 NaN을 리턴해도 onChange에서 null로 리턴되지만, 보스몰과 로직 통일 위해 추가
    if (utils.isEmpty(value, true)) {
      return null;
    }
    if (value === "-") {
      return value;
    }
    if (isCommaDisplay) {
      return parseFloat(value!.replace(/\$\s?|(,*)/g, ""));
    }
    return parseFloat(value);
  };

  const className =
    settings.bordered === false
      ? getInputNumberClassName(["ant-input-number-right-align", "ant-input-number-not-bordered"])
      : getInputNumberClassName(["ant-input-number-right-align"]);

  return {
    controls: false,
    onKeyPress,
    onPaste,
    className,
    formatter,
    parser,
    ...(settings.dynamicValidate && { onInput }),
  };
};
</file>

