          requestedStatusAtColumn,
          acceptedStatusAtColumn,
          acceptedStatusWriterColumn,
          reqAdditionalStatusAtColumn,
          reqAdditionalStatusWriterColumn,
          vendorPriceStatusAtColumn,
          vendorPriceStatusWriterColumn,
          brandPriceStatusAtColumn,
          brandPriceStatusWriterColumn,
          reqEstimateFixStatusAtColumn,
          reqEstimateFixStatusWriterColumn,
          pendingConfirmedStatusAtColumn,
          pendingConfirmedStatusWriterColumn,
          confirmedStatusAtColumn,
          confirmedStatusWriterColumn,
          completedStatusAtColumn,
          completedStatusWriterColumn,
          canceledStatusAtColumn,
          canceledStatusWriterColumn,
        ],
      },
      showDetailColumn,
    ];
  }

  if (urlType !== ReqBossProductUrlEnum.ALL) {
    columns = columns.concat([
      brandCodeColumn,
      brandNameColumn,
      staffNameColumn,
      statusColumn,
      isExclusiveColumn,
      productNameColumn,
      specColumn,
      materialColumn,
      colorColumn,
      showDetailColumn,
    ]);
  }

  return columns;
};
