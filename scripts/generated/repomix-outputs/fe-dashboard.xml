import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import Loader from "@src/app/components/Loader";
import { WindowTitle } from "@src/app/components/WindowTitle";
import { IRootState } from "@src/global/redux/config/configStore";
import { MenuModeForHq } from "@src/global/redux/reducer/common.reducer";
import { utils } from "@utils/utils";
import React, { useEffect } from "react";
import { useSelector } from "react-redux";

import { hqB2bOrderLineListViewPath } from "../hqB2b/urls";
import { HqHomeView } from "./views/HqHomeView";
import { HqLinkersHomeView } from "./views/HqLinkersHome";

const HqHomeSection = () => {
  const navigate = useNavigator();
  const menuModeForHq = useSelector<IRootState, MenuModeForHq>((state) => state.common.menuModeForHq);

  useEffect(() => {
    if (utils.isEmpty(menuModeForHq)) {
      return;
    }

    if (menuModeForHq === "b2b") {
      const initialPathForB2b = hqB2bOrderLineListViewPath({ status: "pending-or-rejected" });
      navigate(initialPathForB2b);
    }
  }, [menuModeForHq]);

  switch (menuModeForHq) {
    case "boss":
      return (
        <>
          <WindowTitle title={sectionNames.hqHome} />
          <HqHomeView />
        </>
      );
    case "linkers":
      return (
        <>
          <WindowTitle title={sectionNames.hqLinkersHome} />
          <HqLinkersHomeView />
        </>
      );
    case "b2b":
    default:
      return <Loader />;
  }
};

export default HqHomeSection;
</file>

