<file path="src/app/components/EditableField/EditableField.tsx">
import { PlusOutlined, UploadOutlined } from "@ant-design/icons";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { FetchMoreProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import {
  Button,
  Checkbox,
  CheckboxOptionType,
  CheckboxProps,
  DatePicker,
  DatePickerProps,
  Form,
  FormInstance,
  Input,
  InputNumber,
  InputNumberProps,
  InputProps,
  Radio,
  RadioGroupProps,
  Rate,
  RateProps,
  Select,
  SelectProps,
  Switch,
  SwitchProps,
  Tooltip,
  Upload,
  UploadProps,
} from "antd";
import { PickerPanelDateProps } from "antd/lib/calendar/generateCalendar";
import { CheckboxGroupProps } from "antd/lib/checkbox";
import { FormItemProps, Rule } from "antd/lib/form";
import { NamePath } from "antd/lib/form/interface";
import { TextAreaProps } from "antd/lib/input";
import { DefaultOptionType } from "antd/lib/select";
import moment from "moment";
import React from "react";

import { FormItemClassName, getFormItemClassName } from "../antd/Form/FormProps";
import ToastEditor from "../Editor/ToastEditor";
import NumberComponent from "../Number";

const getEditableFieldFormItemClassName = (
  props: Pick<EditableFieldCommonProps<any>, "label" | "bold" | "smallLabel">
): string => {
  const { label, bold, smallLabel } = props;
  const classNames: FormItemClassName[] = [];
  if (!label) {
    classNames.push("ant-form-item-empty-label");
  } else {
    if (smallLabel) {
      classNames.push("ant-form-item-small-label");
    }
    if (bold) {
      classNames.push("ant-form-item-bold-label");
    }
  }
  return getFormItemClassName(classNames);
};

function isRenderableNode(value: any): value is React.ReactNode {
  if (utils.isEmpty(value, true)) {
    return false;
  }
  return (
    value === null ||
    value === undefined ||
    typeof value === "string" ||
    typeof value === "number" ||
    typeof value === "boolean" ||
    React.isValidElement(value)
  );
}
const wrapEditableFieldValue = (val: any) => (
  <div style={{ padding: "4px 11px", whiteSpace: "pre-line" }}>{isRenderableNode(val) ? val : "-"}</div>
);

interface EditableFieldCommonProps<T extends any | any[]> {
  label?: string | React.ReactNode;
  bold?: boolean;
  smallLabel?: boolean;
  name: NamePath;
  value?: T;
  renderValue?: (value: T) => any;
  editMode: boolean;
  rules?: Rule[];
  noStyle?: boolean;
  form?: FormInstance;
  hidden?: FormItemProps["hidden"];
  extra?: FormItemProps["extra"];
  formItemStyle?: React.CSSProperties;
}

type EditableInputFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<InputProps, "placeholder" | "disabled" | "suffix"> & {
    type: "input";
  };

type EditableTextAreaFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<TextAreaProps, "placeholder" | "disabled" | "autoSize" | "rows"> & {
    type: "textarea";
  };

type EditableEditorFieldProps<T = any> = EditableFieldCommonProps<T> & {
  type: "editor";
  editorInitialValue: string;
};

type EditableSelectFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<SelectProps, "mode" | "placeholder" | "disabled" | "options" | "dropdownMatchSelectWidth"> & {
    type: "select";
    searchProps?: {
      fetchMoreProps: FetchMoreProps;
      onSearch: (value: string) => void;
    };
  };

type EditableRadioFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<RadioGroupProps, "optionType" | "buttonStyle" | "size" | "options" | "onChange"> & {
    type: "radio";
  };

type EditableCheckboxFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<CheckboxProps, null> & {
    type: "checkbox";
    checkboxChildren?: React.ReactNode;
  };

type EditableCheckboxGroupFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<CheckboxGroupProps, "disabled" | "options"> & {
    type: "checkboxGroup";
  };

type EditableSwitchFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<SwitchProps, "checkedChildren" | "unCheckedChildren" | "disabled"> & {
    type: "switch";
  };

type EditableNumberFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<InputNumberProps, "placeholder" | "precision" | "addonAfter" | "disabled"> & {
    type: "number";
    isCommaDisplay?: boolean;
  };

type EditableRateFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<RateProps, "allowClear" | "allowHalf"> & {
    type: "rate";
  };

type EditableDatePickerFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<DatePickerProps, "placeholder" | "disabled" | "disabledDate" | "format"> &
  Pick<PickerPanelDateProps<any>, "showTime"> & {
    type: "datepicker";
    formDateFormat?: string;
  };

type EditableUploadFieldProps<T = any> = EditableFieldCommonProps<T> &
  Pick<UploadProps, "multiple" | "listType" | "accept" | "showUploadList" | "disabled"> & {
    type: "upload";
    singleFileMode?: boolean;
    uploadText?: string;
  };

type EditableFieldProps<T = any> =
  | EditableInputFieldProps<T>
  | EditableTextAreaFieldProps<T>
  | EditableEditorFieldProps<T>
  | EditableSelectFieldProps<T>
  | EditableRadioFieldProps<T>
  | EditableCheckboxFieldProps<T>
  | EditableCheckboxGroupFieldProps<T>
  | EditableSwitchFieldProps<T>
  | EditableNumberFieldProps<T>
  | EditableRateFieldProps<T>
  | EditableDatePickerFieldProps<T>
  | EditableUploadFieldProps<T>;

const EditableField = <T,>(props: EditableFieldProps<T>) => {
  const {
    label,
    bold = true,
    smallLabel = false,
    name,
    value,
    renderValue,
    editMode,
    rules = [],
    noStyle,
    form,
    hidden,
    extra,
    formItemStyle,
    ...restProps
  } = props;
  const valuePropName: FormItemProps["valuePropName"] =
    restProps.type === "checkbox" || restProps.type === "switch"
      ? "checked"
      : restProps.type === "upload"
      ? "fileList"
      : "value";

  const getValueProps: FormItemProps["getValueProps"] = (value) => {
    if (restProps.type === "switch" || restProps.type === "checkbox") {
      return { checked: !!value }; // boolean 변환 보장
    }

    if (restProps.type === "upload") {
      const { singleFileMode = false } = restProps;
      // singleFileMode이 true인 경우, value가 null인 경우 empty 배열로 반환, 값이 있는 경우 리스트로 반환.
      if (singleFileMode) {
        if (!value || (Array.isArray(value) && value.length === 0)) {
          return { fileList: [] };
        }
        // singleFileMode이 true인 경우, value는 단일 파일 객체여야 하므로 배열로 감싸서 반환
        const uid = value.uid || `${Date.now()}`;
        const isRealFile = value instanceof File;

        return {
          fileList: [
            {
              uid,
              name: value.name || "file",
              status: "done",
              url: value.url || undefined,
              ...(isRealFile ? { originFileObj: value } : {}),
            },
          ],
        };
      } else {
        return { value };
      }
    }
    if (restProps.type === "datepicker" && restProps.formDateFormat) {
      return {
        value: value ? moment(value, restProps.formDateFormat) : null,
      };
    }
    return { value };
  };

  const getValueFromEvent: FormItemProps["getValueFromEvent"] = (() => {
    switch (restProps.type) {
      case "upload":
        const { singleFileMode = false } = restProps;
        return (e) => {
          if (singleFileMode) {
            // singleFileMode이 true인 경우, fileList에서 첫 번째 파일만 반환
            if (Array.isArray(e)) {
              return e.length > 0 ? e[0].originFileObj : null;
            }
            if (e && e.fileList && e.fileList.length > 0) {
              return e.fileList[0].originFileObj;
            }
            return null;
          } else {
            return Array.isArray(e) ? e : e?.fileList;
          }
        };

      case "datepicker":
        const { formDateFormat } = restProps;
        if (formDateFormat) {
          return (date) => (date ? getDateByFormat(date, formDateFormat) : null);
        }
        // formDateFormat이 없으면 기본 동작에 맡기기 위해 undefined 반환
        return undefined;

      default:
        // ✨ 다른 모든 타입에 대해서는 undefined를 반환하여 Antd 기본 동작에 맡깁니다.
        return undefined;
    }
  })();

  const renderInput = () => {
    switch (restProps.type) {
      case "select":
        const { type: selectType, ...selectProps } = restProps;
        const isSearchSelect = !!selectProps.searchProps;
        if (isSearchSelect) {
          const { searchProps, ...selectPropsExcludeSearchProps } = selectProps;
          const { onSearch, fetchMoreProps } = searchProps;
          return (
            <Select
              showSearch
              filterOption={(input, option) =>
                typeof option?.label === "string" && option?.label?.toLowerCase().includes(input.toLowerCase())
              }
              onSearch={onSearch}
              loading={fetchMoreProps.loading}
              onPopupScroll={({ currentTarget }) => {
                const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                const { hasMore, loading, onFetchMore } = fetchMoreProps;
                // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                  onFetchMore();
                }
              }}
              {...selectPropsExcludeSearchProps}
            />
          );
        }
        return <Select {...selectProps} />;
      case "radio":
        const { type: radioType, ...radioProps } = restProps;
        return <Radio.Group {...radioProps} />;
      case "checkbox":
        const { type: checkboxType, checkboxChildren, ...checkboxProps } = restProps;
        return <Checkbox {...checkboxProps}>{checkboxChildren}</Checkbox>;
      case "checkboxGroup":
        const { type: checkboxGroupType, ...checkboxGroupProps } = restProps;
        return <Checkbox.Group {...checkboxGroupProps} />;
      case "switch":
        const { type: switchType, ...switchProps } = restProps;
        return <Switch {...switchProps} />;
      case "number":
        const { type: numberType, isCommaDisplay = true, precision, ...inputNumberProps } = restProps;
        return (
          <InputNumber
            style={{ width: "100%" }}
            {...inputNumberProps}
            {...getInputNumberProps({
              precision,
              isCommaDisplay,
            })}
          />
        );
      case "rate":
        const { type: rateType, ...rateProps } = restProps;
        return <Rate {...rateProps} />;
      case "datepicker":
        const { type: datePickerType, ...datePickerProps } = restProps;
        return <DatePicker format={onlyDateFormat} style={{ width: "100%" }} {...datePickerProps} />;
      case "textarea":
        const { type: textAreaType, ...textAreaProps } = restProps;
        return <Input.TextArea {...textAreaProps} />;
      case "editor":
        const { editorInitialValue } = restProps;
        return (
          <ToastEditor
            name="content"
            placeholder={"내용을 입력해주세요(최대 1,000자)"}
            isEditable={editMode}
            initialValue={editorInitialValue}
          />
        );
      case "upload":
        const { type: uploadType, ...uploadProps } = restProps;
        return (
          <Upload
            {...uploadProps}
            maxCount={uploadProps?.singleFileMode ? 1 : undefined}
            customRequest={({ onSuccess }) => {
              setTimeout(() => {
                onSuccess("ok");
              }, 0);
            }}
          >
            {uploadProps?.listType === "picture-card" ? (
              <div>
                <PlusOutlined />
                <div style={{ marginTop: 4 }}>{uploadProps.uploadText ?? "업로드"}</div>
              </div>
            ) : (
              <Button icon={<UploadOutlined />}>{uploadProps.uploadText ?? "업로드"}</Button>
            )}
          </Upload>
        );
      default:
        const { type: inputType, ...inputProps } = restProps;
        return <Input {...inputProps} />;
    }
  };

  const renderViewModeValue = () => {
    const renderValueWithOptions = (
      value: T,
      options: Array<string | number | CheckboxOptionType | DefaultOptionType>
    ) => {
      if (utils.isEmpty(value) || utils.isEmpty(options)) {
        return wrapEditableFieldValue(value);
      }

      if (Array.isArray(value)) {
        const arrValueText = value.map((v) => utils.getLabelTextByValue(v, options)).join(", ");
        return wrapEditableFieldValue(renderValue ? renderValue(value) : arrValueText);
      }
      const valueText = utils.getLabelTextByValue(value, options);
      return wrapEditableFieldValue(renderValue ? renderValue(value) : valueText);
    };

    switch (restProps.type) {
      case "editor":
        const { editorInitialValue } = restProps;
        return <ToastEditor name="content" isEditable={false} initialValue={editorInitialValue} />;
      case "select":
      case "radio":
      case "checkboxGroup":
        const { options } = restProps;
        return renderValueWithOptions(value, options);
      case "checkbox":
        return renderValue ? wrapEditableFieldValue(renderValue(value)) : <Checkbox checked={!!value} disabled />;
      case "switch":
        return <Switch checked={!!value} disabled />;
      case "number":
        const { type: numberType, ...numberProps } = restProps;
        const { isCommaDisplay = true, addonAfter } = numberProps;
        if (isCommaDisplay) {
          return wrapEditableFieldValue(<NumberComponent value={value as unknown as number} postFix={addonAfter} />);
        }
        return wrapEditableFieldValue(renderValue ? renderValue(value) : value);
      case "upload":
        const { type: uploadType, listType, ...otherProps } = restProps;
        const isEmptyFile = utils.isEmpty(value) || (Array.isArray(value) && value.length === 0);
        const fileList = isEmptyFile ? [] : ((Array.isArray(value) ? value : [value]) as any[]);
        const uploadProps = {
          listType,
          ...otherProps,
          ...(listType === "text" || listType === undefined
            ? {
                itemRender: (originNode, file) => {
                  const url = file.url;
                  const short = utils.truncatedText(url);
                  return (
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      <Tooltip title={url}>
                        <span>{short}</span>
                      </Tooltip>
                    </a>
                  );
                },
              }
            : {}),
        };
        return (
          <Upload
            {...uploadProps}
            disabled
            showUploadList={{
              showPreviewIcon: true,
              showDownloadIcon: false,
              showRemoveIcon: false,
            }}
            maxCount={uploadProps?.singleFileMode ? 1 : undefined}
            customRequest={({ onSuccess }) => {
              setTimeout(() => {
                onSuccess("ok");
              }, 0);
            }}
            fileList={fileList}
          >
            {isEmptyFile && "없음"}
          </Upload>
        );
      default:
        return wrapEditableFieldValue(renderValue ? renderValue(value) : value);
    }
  };

  return (
    <Form.Item
      style={formItemStyle}
      hidden={hidden}
      extra={extra}
      label={label ?? undefined}
      className={getEditableFieldFormItemClassName({ label, bold, smallLabel })}
      noStyle={noStyle}
      required={(() => {
        let isRequired = false;
        for (const rule of rules) {
          if (typeof rule === "function") {
            if (!form) {
              console.warn("EditableField: rules에 함수형 rule이 포함되어 있으나 form이 전달되지 않았습니다.");
              continue;
            }
            const result = rule(form);
            if (typeof result === "object" && result?.required) {
              isRequired = true;
              break;
            }
          } else if (typeof rule === "object" && rule?.required) {
            isRequired = true;
            break;
          }
        }
        return isRequired && editMode;
      })()}
    >
      <>
        <Form.Item
          name={name}
          hidden={!editMode}
          noStyle
          rules={editMode && rules}
          valuePropName={valuePropName}
          getValueFromEvent={getValueFromEvent}
          getValueProps={getValueProps}
        >
          {renderInput()}
        </Form.Item>
        {!editMode && renderViewModeValue()}
      </>
    </Form.Item>
  );
};

export default EditableField;

interface NonEditableFieldProps extends Pick<EditableFieldCommonProps<any>, "label" | "bold" | "smallLabel"> {
  value: any;
}

export const NonEditableField: React.FC<NonEditableFieldProps> = (props) => {
  const { label, bold = true, smallLabel = false, value } = props;
  const labelExist = utils.isEmpty(label) === false;
  const noStyle = !labelExist;

  return (
    <Form.Item
      noStyle={noStyle}
      label={label}
      className={getEditableFieldFormItemClassName({ label, bold, smallLabel })}
    >
      {wrapEditableFieldValue(value)}
    </Form.Item>
  );
};
</file>

<file path="src/app/components/Editor/ToastEditor.tsx">
// eslint-disable-next-line simple-import-sort/sort
import { ChangeEvent } from "@hooks/useForm";
import "@toast-ui/editor/dist/toastui-editor.css";
import "@toast-ui/editor/dist/toastui-editor-viewer.css";
import { Editor, Viewer } from "@toast-ui/react-editor";
import React, { useEffect, useRef, useImperativeHandle, forwardRef, useState } from "react";
import { useImageUploadMutation } from "@src/app/views/notice/notices/api/mutations";
import { showNotificationError } from "@utils/notification/wrapper";
import { VideoPlayerModal } from "../VideoPlayerModal/VideoPlayerModal";
import { utils } from "@utils/utils";

interface ToastEditorProps {
  name: string;
  initialValue?: string;
  onChange?: (event: ChangeEvent) => void;
  isEditable: boolean;
  editorRefProp?: React.RefObject<Editor>;
  placeholder?: string;
}

export interface ToastEditorHandle {
  getContent: () => string;
}

const ToastEditor = forwardRef<ToastEditorHandle, ToastEditorProps>((props, ref) => {
  const { name, initialValue = "", onChange, isEditable, editorRefProp, placeholder } = props;
  let editorRef = useRef<Editor>(null);
  const viewerRef = useRef<Viewer>(null);
  const [playingVideoId, setPlayingVideoId] = useState<string | null>(null);

  editorRef = editorRefProp || editorRef;

  useImperativeHandle(ref, () => ({
    getContent: () => {
      if (editorRef.current) {
        const editorInstance = editorRef.current.getInstance();
        return editorInstance.getMarkdown();
      }
      return "";
    },
  }));

  const [uploadImageMutation] = useImageUploadMutation({});

  const modifiedHandleImageUpload = async (blob: File, callback: (url: string, altText: string) => void) => {
    const time = Date.now();
    const fileName = `${time}_${blob.name}`;
    const file = new File([blob], fileName, { type: blob.type });

    try {
      const { data } = await uploadImageMutation({
        variables: {
          input: { image: file },
        },
      });

      if (data?.bbsUploadImage.imageUrl) {
        const imageUrl = data.bbsUploadImage.imageUrl;
        callback(imageUrl, "image");
      } else {
        showNotificationError(data?.bbsUploadImage.errors[0]?.message || "이미지 업로드에 실패했습니다.");
      }
    } catch (e) {
      console.error("Image upload failed:", e);
      showNotificationError("이미지 업로드 중 네트워크 오류가 발생했습니다.");
    }
  };

  useEffect(() => {
    const editor = editorRef.current?.getInstance();
    const viewer = viewerRef.current?.getInstance();

    if (isEditable && editor) {
      const currentContent = editor.getMarkdown();
      if (currentContent !== (initialValue ?? "")) {
        editor.setMarkdown(initialValue ?? "");
      }
    } else if (!isEditable && viewer) {
      viewer.setMarkdown(initialValue ?? "");
    }
  }, [initialValue, isEditable]);

  useEffect(() => {
    const editor = editorRef.current?.getInstance();
    if (!editor || !isEditable) {
      return;
    }

    const handleChange = () => {
      const markdownContent = editor.getMarkdown();
      // 부모 컴포넌트의 Form 핸들러와 연동하기 위한 이벤트 객체 형태로 전달
      onChange?.({
        target: {
          name,
          value: markdownContent,
        },
      });
    };

    editor.addHook("change", handleChange);

    // 컴포넌트가 사라질 때 hook을 제거합니다 (메모리 누수 방지).
    return () => {
      editor.removeHook("change");
    };
  }, [isEditable, name, onChange]); // onChange 함수 자체가 바뀔 경우를 대비해 의존성 배열에 포함

  useEffect(() => {
    const viewerEl = viewerRef.current?.getRootElement();
    if (!viewerEl || isEditable) {
      return;
    }

    const extractYoutubeId = (url: string): string | null => {
      // YouTube ID 추출 정규식
      const regex = /(?:youtube\.com\/(?:[^\/]+\/[^\/]+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
      const match = url.match(regex);
      return match ? match[1] : null;
    };

    const handleVideoPlayback = (url: string) => {
      const videoId = extractYoutubeId(url);
      if (videoId) {
        setPlayingVideoId(videoId);
        return true;
      }
      return false;
    };

    // Viewer 컨테이너에 클릭 이벤트 리스너 등록
    const handleClick = (event: MouseEvent) => {
      const target = event.target as HTMLElement;

      // 클릭된 요소가 <a> 태그인지 확인
      if (target.tagName === "A" && target.hasAttribute("href")) {
        const url = target.getAttribute("href") || "";

        // 유튜브 링크인지 확인
        if (handleVideoPlayback(url)) {
          event.preventDefault(); // 새 페이지로 이동하는 기본 동작을 막음
        }
      }
    };

    viewerEl.addEventListener("click", handleClick);

    return () => {
      viewerEl.removeEventListener("click", handleClick);
    };
  }, [isEditable, initialValue]);

  return (
    <>
      {isEditable ? (
        <Editor
          placeholder={placeholder}
          ref={editorRef}
          previewStyle="vertical"
          height="600px"
          initialEditType="wysiwyg"
          useCommandShortcut={true}
          hooks={{
            addImageBlobHook: modifiedHandleImageUpload,
          }}
          toolbarItems={[
            "heading",
            "bold",
            "italic",
            "strike",
            "hr",
            "quote",
            "ul",
            "ol",
            "task",
            "indent",
            "outdent",
            "table",
            "image",
            "link",
          ]}
        />
      ) : (
        <>
          <Viewer ref={viewerRef} linkAttribute={{ target: "_blank" }} />
          <VideoPlayerModal
            open={utils.isEmpty(playingVideoId) === false}
            videoId={playingVideoId}
            onClose={() => setPlayingVideoId(null)}
          />
        </>
      )}
    </>
  );
});

export default ToastEditor;
</file>

<file path="src/app/components/Editor/utils.ts">
import { utils } from "@utils/utils";

const encodeImageUrlsInMarkdown = (markdown: string): string =>
  markdown.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_match, alt, url) => {
    const trimmedUrl = url.trim();
    // 중복 인코딩 방지
    if (/%[0-9A-Fa-f]{2}/.test(trimmedUrl)) {
      return `![${alt}](${trimmedUrl})`;
    }
    const safeUrl = encodeURI(trimmedUrl);
    return `![${alt}](${safeUrl})`;
  });

const decodeImageUrlsInMarkdown = (markdown: string): string =>
  markdown.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_match, alt, url) => {
    const trimmedUrl = url.trim();
    // 인코딩된 URL만 디코딩
    if (/%[0-9A-Fa-f]{2}/.test(trimmedUrl)) {
      const decodedUrl = decodeURI(trimmedUrl);
      return `![${alt}](${decodedUrl})`;
    }
    return `![${alt}](${trimmedUrl})`;
  });

// 폼 값 초기화, ToastEditor의 initialValue 전달 시 사용
export const parseContentJsonStrToMarkdown = (contentJson: string | null | undefined): string => {
  if (utils.isEmpty(contentJson, true)) {
    return "";
  }
  try {
    const parsed = JSON.parse(contentJson);
    const markdown = typeof parsed === "object" && "content" in parsed ? parsed.content : parsed;
    return encodeImageUrlsInMarkdown(typeof markdown === "string" ? markdown : "");
  } catch (e) {
    return encodeImageUrlsInMarkdown(typeof contentJson === "string" ? contentJson : "");
  }
};

// 폼 제출(뮤테이션 호출) 시 사용
export const convertMarkdownToContentJsonStr = (markdown: string | null | undefined): string =>
  JSON.stringify({ content: decodeImageUrlsInMarkdown(markdown) });
</file>

<file path="src/app/components/ErrorPage/ErrorPage.tsx">
import { User_brand_staff } from "@src/api/fragments/types/User";
import { utils } from "@utils/utils";
import { Button, Col, Result, Row, Space } from "antd";
import React from "react";

import { getRowClassName } from "../antd/Row/RowProps";
import { PojangBossInfo } from "../PojangBossInfo/PojangBossInfo";

export enum ErrorPageEnum {
  NotFound = "NotFound",
  PermissionDenied = "PermissionDenied",
  DataMissing = "DataMissing",
  AppError = "AppError",
  ServerChecking = "ServerChecking",
}

interface ErrorPageProps {
  type: ErrorPageEnum;
  staff?: Pick<User_brand_staff, "firstName" | "aligoPhone" | "email">;
  onBack?: () => void;
}

const ErrorPage: React.FC<ErrorPageProps> = (props) => {
  const { type, staff, onBack } = props;
  const isMobileApp = utils.checkWebView();

  const subHeaderText =
    type === ErrorPageEnum.PermissionDenied
      ? "페이지 접근 권한이 없습니다."
      : type === ErrorPageEnum.DataMissing
      ? "데이터 조회에 실패했습니다."
      : type === ErrorPageEnum.AppError
      ? "페이지 갱신에 오류가 발생했습니다."
      : type === ErrorPageEnum.ServerChecking
      ? "서버 점검 중 입니다."
      : "접근하려는 페이지가 존재하지 않습니다.";

  const detailMsg = `오류가 반복되거나 긴급한 요청이 있다면 ${staff ? "담당 MD에게" : "고객센터에"} 문의해 주세요.`;

  const resultStatus =
    type === ErrorPageEnum.PermissionDenied
      ? "403"
      : type === ErrorPageEnum.DataMissing
      ? "error"
      : type === ErrorPageEnum.AppError
      ? "warning"
      : type === ErrorPageEnum.ServerChecking
      ? "500"
      : "404";

  return (
    <Row align="middle" justify="center" className={getRowClassName(["ant-row-center-box"])}>
      <Col span={24}>
        <Result
          status={resultStatus}
          title={subHeaderText}
          subTitle={detailMsg}
          extra={
            onBack && (
              <Space direction="vertical">
                {type !== ErrorPageEnum.ServerChecking && (
                  <Button size="large" onClick={onBack}>
                    홈으로 돌아가기
                  </Button>
                )}
                {isMobileApp && (
                  <Button type="primary" size="large" onClick={() => window.location.reload()}>
                    새로고침
                  </Button>
                )}
                <PojangBossInfo type="bg-white" staff={staff} />
              </Space>
            )
          }
        />
      </Col>
    </Row>
  );
};
export default ErrorPage;
