import { RackSectorList_rackSectors_edges_node } from "@src/app/views/product/stock/api/types/RackSectorList";
import { utils } from "@utils/utils";
import { Button, Card, Row, Table, Typography } from "antd";
import { ExpandableConfig } from "antd/lib/table/interface";
import React, { memo } from "react";

import { WarehouseDetailsViewUrlDialog, WarehouseDetailsViewUrlQueryParams } from "../../urls";
import {
  getExpandedRackLocationListTableSettings,
  getRackSectorListTableSettings,
} from "./RackSectorListTableSettings";

interface RackSectorListCardProps {
  disabled: boolean;
  rackSectors: RackSectorList_rackSectors_edges_node[];
  openModal: (action: WarehouseDetailsViewUrlDialog, newParams?: WarehouseDetailsViewUrlQueryParams) => void;
}

// NOTE: 로케이션 개수가 많아서 관련 액션 모달(로케이션 추가/수정/삭제) 렌더링 시 성능 이슈가 발생함 - 로케이션 개수가 많을수록 딜레이가 길게 발생
// 해당 이슈 해결하고자 props의 rackSectors, openModal과 RackSectorListCard 컴포넌트 자체를 메모이제이션 적용
export const RackSectorListCard: React.FC<RackSectorListCardProps> = memo((props) => {
  const { disabled, rackSectors, openModal } = props;

  const tableTitle = () => (
    <Row justify="end">
      <Button size="small" disabled={disabled} type="default" onClick={() => openModal("add-rack-sector")}>
        구역 추가
      </Button>
    </Row>
  );

  const columns = getRackSectorListTableSettings(props);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowExpandable: ExpandableConfig<RackSectorList_rackSectors_edges_node> = {
    fixed: true,
    indentSize: 0,
    rowExpandable: () => true,
    expandedRowRender: (record) => {
      const columnsForRackLocation = getExpandedRackLocationListTableSettings({ ...props, rackSector: record });
      const expandedTableWidthSum = utils.calcTableColsWidthSum(columnsForRackLocation);
      const locations = record?.locations || [];
      const emptyText = (
        <Typography.Text strong type="warning">
          이 구역은 비어 있습니다.
        </Typography.Text>
      );
      return (
        <Table
          {...commonTableProps}
          tableLayout="fixed"
          columns={columnsForRackLocation}
          dataSource={locations}
          expandable={{ indentSize: 1000 }}
          scroll={{ x: expandedTableWidthSum, y: 500 }}
          sticky={false}
          locale={{ emptyText }}
        />
      );
    },
  };

  return (
    <Card title={<CardTitleAntd title="구역/로케이션" />} bodyStyle={{ padding: 0 }}>
      <Table
        {...commonTableProps}
        title={tableTitle}
        loading={disabled}
        columns={columns}
        dataSource={rackSectors}
        expandable={rowExpandable}
        scroll={{ x: tableWidthSum, y: 500 }}
      />
    </Card>
  );
});
</file>

