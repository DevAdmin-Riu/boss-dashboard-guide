import { DEFAULT_INITIAL_SEARCH_DATA, PAGINATE_BY } from "@assets/constants/config";
import useNavigator from "@hooks/useNavigator";
import usePaginator, { createPaginationState } from "@hooks/usePaginator";
import useUser from "@hooks/useUser";
import useCategorySearch from "@src/api/searches/useCategorySearch";
import {
  RequestBossProductCreateByProductVariantInput,
  RequestBossProductCreateInput,
  SalesStatusEnum,
} from "@src/api/types/globalTypes";
import {
  useInitialProductVariantForReqFilterDataQuery,
  useProductVariantListForReqQuery,
} from "@src/app/views/requestProduct/api/queries";
import { ProductVariantListForReqVariables } from "@src/app/views/requestProduct/api/types/ProductVariantListForReq";
import { reqBossProductListForRequestedViewPath, reqBossProductListViewUrl } from "@src/app/views/requestProduct/urls";
import { getFilterVariables } from "@src/app/views/requestProduct/views/ProductVariantListForReqView/filters";
import { getFilterQueryParam } from "@src/app/views/requestProduct/views/ProductVariantListForReqView/filters";
import createDialogActionHandlers from "@utils/handlers/dialogActionHandlers";
import createFilterHandlers from "@utils/handlers/filterHandlers";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useEffect, useMemo, useState } from "react";

import {
  useRequestBossProductCreateByProductVariantMutation,
  useRequestBossProductCreateMutation,
} from "../api/mutations";
import {
  HqReqBossProductCreatePage,
  IReqBossProductCreateForm,
  TReqBossProductCreateByProductVariantForm,
} from "../components/HqReqBossProductCreatePage";
import {
  hqReqBossProductCreateViewUrl,
  HqReqBossProductCreateViewUrlDialog,
  HqReqBossProductCreateViewUrlQueryParams,
  hqReqBossProductDetailsViewUrl,
  hqReqBossProductListForRequestedViewPath,
  hqReqBossProductListViewUrl,
} from "../urls";

interface ReqBossProductCreateViewProps {
  params: HqReqBossProductCreateViewUrlQueryParams;
}

export const HqReqBossProductCreateView: React.FC<ReqBossProductCreateViewProps> = ({ params }) => {
  const navigate = useNavigator();
  const paginate = usePaginator();
  const { user } = useUser();
  const [skipQuery, setSkipQuery] = useState<boolean>(true);
  const paginationState = createPaginationState(PAGINATE_BY, params);

  const { isStaff, isHqStaff } = user;
  const needsBrandSelection = isStaff && !isHqStaff;
  const [selectedBrand, setSelectedBrand] = useState<any>(null);

  useEffect(() => {
    navigate(hqReqBossProductCreateViewUrl({}));
  }, []);

  const queryVariables: ProductVariantListForReqVariables = useMemo(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        excludeBrandId: selectedBrand?.id || user.brand?.id,
        salesStatus: [SalesStatusEnum.ON_SALE],
      },
    }),
    [params, selectedBrand, user.brand]
  );

  const {
    data: productVariantsData,
    loading: productVariantsLoading,
    refetch: productVariantsRefetch,
  } = useProductVariantListForReqQuery({ skip: skipQuery, variables: queryVariables });
  const productVariantsForReq = maybe(() => productVariantsData.productVariants.edges.map((edge) => edge.node), []);
  const productVariantsForReqPageInfo = maybe(() => productVariantsData.productVariants.pageInfo, null);

  const { data: initialFilterData } = useInitialProductVariantForReqFilterDataQuery({
    skip: skipQuery,
    variables: { categories: params.categories },
  });
  const initialFilterCategories = maybe(() => initialFilterData.categories.edges.map((edge) => edge.node), []);

  const searchCategories = useCategorySearch({
    skip: skipQuery,
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA },
  });

  const [requestBossProductCreate, requestBossProductCreateOpts] = useRequestBossProductCreateMutation({
    onCompleted: (data) => {
      const errors = data.requestBossProductCreate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("포장보스 상품 등록 요청이 완료되었습니다.");
        navigate(hqReqBossProductDetailsViewUrl(data.requestBossProductCreate.requestBossProduct.id));
      } else {
        showGqlErrors(errors);
      }
    },
  });

  const [requestBossProductCreateByProductVariant, requestBossProductCreateByProductVariantOpts] =
    useRequestBossProductCreateByProductVariantMutation({
      onCompleted: (data) => {
        const errors = data.requestBossProductCreateByProductVariant.errors;
        if (errors.length === 0) {
          showNotificationSuccess("포장보스 상품 등록 요청이 완료되었습니다.");
          navigate(hqReqBossProductDetailsViewUrl(data.requestBossProductCreateByProductVariant.requestBossProduct.id));
        } else {
          showGqlErrors(errors);
        }
      },
    });

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: productVariantsForReqPageInfo,
    paginationState,
    params,
  });

  const [openModal, closeModal] = createDialogActionHandlers<
    HqReqBossProductCreateViewUrlDialog,
    HqReqBossProductCreateViewUrlQueryParams
  >(navigate, hqReqBossProductCreateViewUrl, params);

  const [changeFilters, resetFilters] = createFilterHandlers({
    createUrl: hqReqBossProductCreateViewUrl,
    getFilterQueryParam,
    navigate,
    params,
    refreshFn: productVariantsRefetch,
  });

  const handleBack = () =>
    navigate(
      isStaff
        ? reqBossProductListViewUrl(reqBossProductListForRequestedViewPath)()
        : hqReqBossProductListViewUrl(hqReqBossProductListForRequestedViewPath)()
    );

  const handleCreate = (formData: IReqBossProductCreateForm) => {
    const { byProductVariant, imageList, ...restFormData } = formData;
    const brandId = selectedBrand?.id || user.brand?.id;
    const input: RequestBossProductCreateInput = {
      ...restFormData,
      brand: brandId,
      imageList: imageList.map((image) => image.originFileObj),
      // Add staff tracking comment if created by staff
      etcMemo:
        needsBrandSelection && selectedBrand
          ? `${formData.etcMemo || ""} [${selectedBrand.name}의 요청으로 생성]`.trim()
          : formData.etcMemo,
    };
    requestBossProductCreate({ variables: { input } });
  };

  const handleCreateByProductVariant = (formData: TReqBossProductCreateByProductVariantForm) => {
    const brandId = selectedBrand?.id || user.brand?.id;
    const input: RequestBossProductCreateByProductVariantInput = {
      ...formData,
      brand: brandId,
    };
    requestBossProductCreateByProductVariant({ variables: { input } });
  };

  const pageLoading =
    productVariantsLoading ||
    requestBossProductCreateOpts.loading ||
    requestBossProductCreateByProductVariantOpts.loading;

  return (
    <>
      <HqReqBossProductCreatePage
        loading={pageLoading}
        confirmButtonState={requestBossProductCreateOpts.status}
