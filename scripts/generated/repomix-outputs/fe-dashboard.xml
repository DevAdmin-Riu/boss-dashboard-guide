import { getFormErrors } from "@assets/messages/errors";
import { ShopErrorFragment } from "@src/api/fragments/types/ShopErrorFragment";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Card, DatePicker, InputNumber, Space, Typography } from "antd";
import moment, { Moment } from "moment";
import React from "react";

import { DirectShippingPageFormData } from "../SiteSettingsPage";

interface DirectShippingProps {
  data: DirectShippingPageFormData;
  errors: ShopErrorFragment[];
  disabled: boolean;
  onChange: (event: any) => void;
}

const DirectShipping: React.FC<DirectShippingProps> = ({ data, disabled, errors, onChange }) => {
  const formErrors = getFormErrors(["dsMinimumOrderPrice", "directShippingAvailableEndDate"], errors);

  const disabledDate = (current: Moment | null) => {
    if (!current) {
      return true;
    }

    const today = moment();
    return current < today;
  };

  return (
    <Card title={<CardTitleAntd title="직배송 설정" />}>
      <Space direction={"vertical"} size={"large"}>
        <FormFieldAntd
          label="최소 주문 금액(원)"
          description={
            <Typography.Text type={"warning"}>
              브랜드 상세페이지의 직배송 정보: 브랜드 권역별 최소 주문 금액 설정 시 기본 값으로 세팅, 부가세 별도/포함은
              직배송 협력 업체 정보 설정을 따름
            </Typography.Text>
          }
          error={formErrors.dsMinimumOrderPrice}
          errorMsg={makeGqlErrorMsg(formErrors.dsMinimumOrderPrice)}
        >
          <InputNumber
            {...getInputNumberProps({ isCommaDisplay: true })}
            disabled={disabled}
            size={"large"}
            style={{ width: "100%" }}
            status={!!formErrors.dsMinimumOrderPrice && "error"}
            name={"dsMinimumOrderPrice"}
            value={data.dsMinimumOrderPrice}
            onChange={(value: number) => {
              if (utils.isEmpty(value)) {
                onChange({ target: { name: "dsMinimumOrderPrice", value: null } });
              } else {
                onChange({ target: { name: "dsMinimumOrderPrice", value } });
              }
            }}
          />
        </FormFieldAntd>
        <FormFieldAntd
          label="직배송 가능 기간"
          description="직배송일로 선택 가능한 마지막 날짜를 입력해주세요.(매달 식자재 순기 공유받은 뒤 갱신 필요)"
          error={formErrors.directShippingAvailableEndDate}
          errorMsg={makeGqlErrorMsg(formErrors.directShippingAvailableEndDate)}
        >
          <DatePicker
            disabled={disabled}
            size={"large"}
            style={{ width: "100%" }}
            status={!!formErrors.directShippingAvailableEndDate && "error"}
            name={"directShippingAvailableEndDate"}
            disabledDate={disabledDate}
            value={data?.directShippingAvailableEndDate ? moment(data.directShippingAvailableEndDate) : null}
            onChange={(_value, valueString) => {
              onChange({ target: { name: "directShippingAvailableEndDate", value: valueString } });
            }}
          />
        </FormFieldAntd>
      </Space>
    </Card>
  );
};

export default DirectShipping;
</file>

