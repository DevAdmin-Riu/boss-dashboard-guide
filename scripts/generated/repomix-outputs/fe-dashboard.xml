    StatReportingMode.MONTHLY,
    urlType.urlEnum,
    onConfirmModalOpen,
    isLoading
  );
  const { pickColumns, pickerSelectedColumns, initialColumns, createPickSummaryColumns } = utils.getPickColumns(
    columns,
    props.settings.columns
  );
  const handleSave = (columns) => props.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const columnsForCreateConfirm = getMileageSettlementCreateConfirmTableSettings(
    TypeSafeFormForCreate,

    inputListWatchedForCreate
  );
  const tableWidthSumForCreateConfirm = utils.calcTableColsWidthSum(columnsForCreateConfirm);

  const handleConfirmModalOk = () => {
    switch (confirmModalMode) {
      case MileageSettlementListConfirmModalModeEnum.CreateData:
        formForCreate.submit();
        break;
      case MileageSettlementListConfirmModalModeEnum.CreateBulkData:
        formForCreate.submit();
        break;
      case MileageSettlementListConfirmModalModeEnum.TransferDoneData:
        handleTransferDone();
        break;
      case MileageSettlementListConfirmModalModeEnum.TransferDoneBulkData:
        handleTransferDoneBulkData();
        break;
      default:
        break;
    }
  };

  const makeSettlementCreateInputFromRecord = (
    record: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node,
    formData: MileageSettlementCreateFormData
  ): BrandMileageMonthlySettlementCreateInput => {
    if (utils.isEmpty(record)) {
      return null;
    }
    const { inputList } = formData;
    const foundInput = inputList.find((input) => input.recordId === record.id);
    const { decreaseDevCostIncludeVat } = foundInput;
    return {
      brand: record.brand.id,
      date: record.date,
      mileageExcludeVat: record.mileageExcludeVat,
      mileageVat: record.mileageVat,
      mileageIncludeVat: record.mileageIncludeVat,
      decreaseDevCostIncludeVat,
      totalPriceExcludeVat: record.totalPriceExcludeVat,
      rcoinsExcludeVat: record.rcoinsExcludeVat,
      brandCostPriceExcludeVat: record.brandCostPriceExcludeVat,
      returnDeliveryFee: record.returnDeliveryFee,
      brandPayingChargeExcludeVat: record.brandPayingChargeExcludeVat,
      brandDeliveryFee: record.brandDeliveryFee,
    };
  };

  const handleCreate = (formData: MileageSettlementCreateFormData) => {
    const selectedRecord = dataSource.find((record) => record.id === selectedRowId);
    const input = makeSettlementCreateInputFromRecord(selectedRecord, formData);
    settlementCreate({ variables: { input } });
  };

  const handleBulkCreate = (formData: MileageSettlementCreateFormData) => {
    const input = selectedRows.map<BrandMileageMonthlySettlementCreateInput>((row) =>
      makeSettlementCreateInputFromRecord(row, formData)
    );
    settlementBulkCreate({ variables: { input } });
  };

  const handleTransferDone = () => {
    settlementUpdate({
      variables: {
        id: selectedRowId,
        input: {
          settlementStatus: BrandMonthlySettlementStatusEnum.PAID,
        },
      },
    });
  };

  const handleTransferDoneBulkData = () => {
    // id만 추출해서 ids를 만든다.
    const ids = selectedRows.map((data) => data.id);
    settlementBulkUpdate({
      variables: {
        ids,
        settlementStatus: BrandMonthlySettlementStatusEnum.PAID,
      },
    });
  };

  const rowSelection: TableRowSelection<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node> = {
    fixed: true,
    onChange: (_selectedRowKeys, selectedRows) => setSelectedRows(selectedRows),
  };

  const getRowSelection =
    (): TableRowSelection<BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node> | null => {
      if (
        urlType.urlEnum === AdminMonthlySettlementUrlEnum.NOT_CONFIRMED ||
        urlType.urlEnum === AdminMonthlySettlementUrlEnum.WAITING_FOR_PAYMENT
