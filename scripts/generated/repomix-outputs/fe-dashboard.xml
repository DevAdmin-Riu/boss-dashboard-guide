                    utils.copyToClipboard(brand.vact.acctNo);
                    showNotificationSuccess("가상계좌 번호를 복사하였습니다.");
                  }}
                >
                  {brand.vact.acctNo}
                </span>
                <Divider type="vertical" style={{ borderLeftColor: "#91d5ff", margin: "0 8px" }} />
                {brand.vact.bankCode.bankName}
