            value={isUpdate && props.category.code}
            disabled={isUpdate}
            editMode={isUpdate ? false : isEditMode}
            rules={[{ required: true, message: formRuleMsg.required }]}
          />
        </Col>
        <Col xs={24} sm={12}>
          <EditableField
            type="select"
            name={TypeSafeForm.getValidDataIndex("type")}
            label="분류"
            value={isUpdate && props.category.type}
            options={categoryTypeChoices}
            disabled={parentExist}
            editMode={isEditMode}
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          />
        </Col>
        <Col xs={24} sm={12}>
          <EditableField
            type="select"
            name={TypeSafeForm.getValidDataIndex("kind")}
            label="구분"
            value={isUpdate && props.category.kind}
            options={categoryKindChoices}
            disabled={isUpdate}
            editMode={isUpdate ? false : isEditMode}
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          />
        </Col>
        {isB2bKind && (
          <Col xs={24} sm={12}>
            <EditableField
              type="upload"
              label="출하검사서 양식"
              singleFileMode
              name={TypeSafeForm.getValidDataIndex("shipmentInspectionFile")}
              value={
                isUpdate ? props.category.shipmentInspectionFile : TypeSafeForm.getFieldValue("shipmentInspectionFile")
              }
              editMode={isEditMode}
            />
          </Col>
        )}
      </Row>

      <Card type="inner" title={commonMsg.backgroundImage}>
        <Space direction="vertical" size="small" split={<Divider />}>
          <EditableField
            type="upload"
            listType="picture-card"
            singleFileMode
            name={TypeSafeForm.getValidDataIndex("backgroundImage")}
            value={TypeSafeForm.getFieldValue("backgroundImage")}
            editMode={isEditMode}
            showUploadList={{ showPreviewIcon: false }}
            accept="image/*"
          />
          <EditableField
            type="textarea"
            name={TypeSafeForm.getValidDataIndex("backgroundImageAlt")}
            label={commonMsg.backgroundImageHelp}
            placeholder={commonMsg.description}
            value={isUpdate && props.category.backgroundImage?.alt}
            editMode={isEditMode}
            disabled={utils.isEmpty(backgroundImageWatched)}
          />
        </Space>
      </Card>
    </Card>
  );
};
export default CategoryDetails;
