import { PlusOutlined } from "@ant-design/icons";
import { Card, Upload } from "antd";
import type { RcFile, UploadFile, UploadProps } from "antd/es/upload/interface";
import React from "react";

interface ExchangeAndRefundImageProps {
  maxFileLength: number;
  fileListValue: Array<UploadFile<any>>;
  setFileListValue: React.Dispatch<React.SetStateAction<Array<UploadFile<any>>>>;
}

const ExchangeAndRefundImage: React.FC<ExchangeAndRefundImageProps> = (props) => {
  const { maxFileLength, fileListValue, setFileListValue } = props;

  const onChange: UploadProps["onChange"] = ({ fileList: newFileList }) => {
    setFileListValue(newFileList);
  };

  const onPreview = async (file: UploadFile) => {
    let src = file.url as string;
    if (!src) {
      src = await new Promise((resolve) => {
        const reader = new FileReader();
        reader.readAsDataURL(file.originFileObj as RcFile);
        reader.onload = () => resolve(reader.result as string);
      });
    }
    const image = new Image();
    image.src = src;
    const imgWindow = window.open(src);
    imgWindow?.document.write(image.outerHTML);
  };

  return (
    <>
      <Card size="small">
        <Upload
          listType="picture-card"
          fileList={fileListValue}
          onChange={onChange}
          onPreview={onPreview}
          accept="image/*"
          beforeUpload={() => false}
        >
          {fileListValue.length < maxFileLength && (
            <div>
              <PlusOutlined />
              <div style={{ marginTop: 8 }}>사진 추가</div>
            </div>
          )}
        </Upload>
      </Card>
    </>
  );
};

export default ExchangeAndRefundImage;
</file>

