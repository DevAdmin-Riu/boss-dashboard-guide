<file path="src/app/views/product/products/components/FbvProductBrandList.tsx">
import { DEFAULT_INITIAL_SEARCH_DATA } from "@assets/constants/config";
import { FormChange } from "@hooks/useForm";
import { SearchFbvBrandsVariables } from "@src/api/searches/types/SearchFbvBrands";
import searchFbvBrands from "@src/api/searches/useFbvBrandSearch";
import { BrandServiceTypeEnum } from "@src/api/types/globalTypes";
import { FormFieldAntd } from "@src/app/components/FormFieldAntd";
import { maybe } from "@utils/misc";
import { Card, Col, Row, Select, Space, Typography } from "antd";
import React from "react";

interface FbvProductBrandListProps {
  isCreateMode: boolean;
  onChange: FormChange;
}

const FbvProductBrandList: React.FC<FbvProductBrandListProps> = (props) => {
  const { isCreateMode, onChange } = props;
  const onChangeWithValue = (name: string, value: any) => onChange({ target: { name, value } });

  const queryVariables: SearchFbvBrandsVariables = {
    ...DEFAULT_INITIAL_SEARCH_DATA,
    filter: { enabledServices: [BrandServiceTypeEnum.FBV] },
  };

  const {
    loadMore: loadMoreBrands,
    search: searchBrands,
    result: searchBrandsOpts,
  } = searchFbvBrands({
    variables: queryVariables,
  });
  const brandList = maybe(() => searchBrandsOpts.data.search?.edges.map((edge) => edge.node), []);

  if (searchBrandsOpts.loading && isCreateMode === false) {
    return <></>;
  }

  const makeTitle = (
    <Space>
      <Typography.Title level={4}>브랜드 설정</Typography.Title>
    </Space>
  );

  const brandOptions: Array<{ label: string; value: string }> = brandList.map((brand) => ({
    label: brand.name,
    value: brand.code,
  }));
  return (
    <Card title={makeTitle}>
      <Row justify="space-between" gutter={[12, 12]}>
        <Col span={24}>
          <FormFieldAntd isRequired label="브랜드">
            <Select
              showSearch
              style={{ width: "100%" }}
              loading={searchBrandsOpts.loading}
              placeholder="브랜드 선택"
              options={brandOptions}
              filterOption={(input, option) =>
                typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase())
              }
              onChange={(value) => {
                onChangeWithValue("bpvBrandCode", value);
              }}
              onSearch={searchBrands}
              onPopupScroll={({ currentTarget }) => {
                const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                const hasMore = maybe(() => searchBrandsOpts.data.search.pageInfo.hasNextPage);
                const searchLoading = searchBrandsOpts.loading;
                // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                if (scrollHeight - scrollTop === clientHeight && hasMore && searchLoading === false) {
                  loadMoreBrands();
                }
              }}
            />
          </FormFieldAntd>
        </Col>
      </Row>
    </Card>
  );
};

export default FbvProductBrandList;
</file>

<file path="src/app/views/product/products/components/OnSaleNotificationModal.tsx">
import { Form, Modal, Select, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React, { useMemo, useState } from "react";

import { usePermissionGroupByNameQuery } from "../api/queries";
import { PermissionGroupByName_permissionGroupByName_users } from "../api/types/PermissionGroupByName";

interface OnSaleNotificationModalProps {
  open: boolean;
  sku?: string;
  loading?: boolean;
  onOk: (recipientList: string[]) => void;
  onCancel: () => void;
}

const MD_PERMISSION_GROUP_NAME = "MD";

const OnSaleNotificationModal: React.FC<OnSaleNotificationModalProps> = ({ open, sku, loading, onOk, onCancel }) => {
  const [selectedUserIds, setSelectedUserIds] = useState<string[]>([]);

  const { data: permissionGroupData, loading: permissionGroupLoading } = usePermissionGroupByNameQuery({
    variables: { name: MD_PERMISSION_GROUP_NAME },
    skip: !open,
  });

  const users = permissionGroupData?.permissionGroupByName?.users || [];
  const activeUsers = useMemo(
    () =>
      users.filter(
        (user): user is PermissionGroupByName_permissionGroupByName_users => user !== null && user.isActive === true
      ),
    [users]
  );

  const userMap = useMemo(() => {
    const map = new Map<string, PermissionGroupByName_permissionGroupByName_users>();
    activeUsers.forEach((user) => {
      map.set(user.id, user);
    });
    return map;
  }, [activeUsers]);

  // Select용 옵션 (value는 id)
  const recipientOptions = activeUsers.map((user) => ({
    label: `${user.firstName} (${user.email})`,
    value: user.id,
  }));

  const columns: ColumnsType<PermissionGroupByName_permissionGroupByName_users> = [
    {
      title: "이름",
      key: "firstName",
      width: 120,
      render: (_, record) => record.firstName || "-",
    },
    {
      title: "이메일",
      key: "email",
      render: (_, record) => record.email || "-",
    },
  ];

  const handleOk = () => {
    if (loading) {
      return;
    }
    if (selectedUserIds.length > 0) {
      const emails = selectedUserIds
        .map((id) => userMap.get(id)?.email)
        .filter((email): email is string => email !== undefined);
      onOk(emails);
    }
  };

  const handleCancel = () => {
    setSelectedUserIds([]);
    onCancel();
  };

  return (
    <Modal
      title="판매 가능 알림"
      open={open}
      onOk={handleOk}
      onCancel={handleCancel}
      okText="확인"
      cancelText="취소"
      confirmLoading={loading}
      okButtonProps={{ disabled: selectedUserIds.length === 0 || loading }}
      width={600}
    >
      <Space direction="vertical" style={{ width: "100%" }} size="middle">
        <Typography.Text>
          {sku ? `${sku}의 ` : ""}상태를 정상으로 변경해 판매 가능한 상태로 변경하며 MD에게 알림을 발송하시겠습니까?
        </Typography.Text>

        <Form layout="vertical">
          <Form.Item label="받는 사람" required>
            <Select
              mode="multiple"
              placeholder="아래 테이블에서 선택해주세요"
              value={selectedUserIds}
              options={recipientOptions}
              loading={permissionGroupLoading}
              style={{ width: "100%" }}
              open={false}
            />
          </Form.Item>
        </Form>

        <Table
          rowKey="id"
          columns={columns}
          dataSource={activeUsers}
          loading={permissionGroupLoading}
          size="small"
          pagination={false}
          scroll={{ y: 200 }}
          rowSelection={{
            type: "checkbox",
            selectedRowKeys: selectedUserIds,
            onChange: (selectedRowKeys) => {
              setSelectedUserIds(selectedRowKeys as string[]);
            },
          }}
        />
      </Space>
    </Modal>
  );
};

export default OnSaleNotificationModal;
</file>

