    case HqMonthlySettlementTypeEnum.ALL:
      return null;
    // NOT CONFIRMED인 경우. 해당 쿼리 자체를 안날려야함. 여기에서는 일단 null로 넣고. params값으로 처리해아함
    case HqMonthlySettlementTypeEnum.NOT_CONFIRMED:
      return null;
    case HqMonthlySettlementTypeEnum.CONFIRMED:
      return [BrandMonthlySettlementStatusEnum.CONFIRMED];
    case HqMonthlySettlementTypeEnum.REVIEWING_BY_ADMIN:
      return [
        BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN,
        BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT,
      ];
    case HqMonthlySettlementTypeEnum.PAID:
      return [BrandMonthlySettlementStatusEnum.PAID];
  }
};

export function getFilterOpts(
  params: HqFulfilledByVendorSettlementListViewUrlFilters
): HqFulfilledByVendorSettlementListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const lastMonth = moment().subtract(1, "months");

  return {
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, lastMonth.format(onlyDateFormat)),
        min: maybe(() => filterVariables.statDate.gte, lastMonth.format(onlyDateFormat)),
      },
    },
    settlementStatus: {
      active: maybe(() => !utils.isEmpty(params.settlementStatus), false),
      value: maybe(() => findValueInEnum(params.settlementStatus, HqMonthlySettlementTypeEnum)),
    },
  };
}

export function getFilterVariables(
  params: HqFulfilledByVendorSettlementListViewUrlFilters
): HqFulfilledByVendorSettlementListFilterVariables {
  return {
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
    settlementStatus: params.settlementStatus !== undefined ? funcSettlementStatusValue(params.settlementStatus) : null,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<HqFulfilledByVendorSettlementFilterKeys>
): HqFulfilledByVendorSettlementListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case HqFulfilledByVendorSettlementFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        HqFulfilledByVendorSettlementListViewUrlFiltersEnum.statDateFrom,
        HqFulfilledByVendorSettlementListViewUrlFiltersEnum.statDateTo
      );
    case HqFulfilledByVendorSettlementFilterKeys.settlementStatus:
      return getSingleEnumValueQueryParam(
        filter,
        HqFulfilledByVendorSettlementListViewUrlFiltersEnum.settlementStatus,
        HqMonthlySettlementTypeEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<HqFulfilledByVendorSettlementListViewUrlFilters>(SALES_STAT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  HqFulfilledByVendorSettlementListViewUrlQueryParams,
  HqFulfilledByVendorSettlementListViewUrlFilters
>({
  ...HqFulfilledByVendorSettlementListViewUrlFiltersEnum,
});
