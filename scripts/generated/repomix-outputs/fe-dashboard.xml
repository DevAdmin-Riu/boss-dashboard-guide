// 이 위치에 있던 아래 함수명의 코드 삭제함.
// parseProduct - prdouct의 attribute를 parseAttributes에 의해 파싱하여 리턴하던 함수
// parseAttributes - 제품 속성 중 AttributeSlugEnum.qantity(입수량. 현재는 productVariant의 qtyPerBox 정보로 대체됨)가 존재하는 경우, AttributeSlugEnum.unitType(단위) 정보를 입수량에 더하여 텍스트로 만들고, 단위 속성을 제거
// createAttribute - 제품 속성을 임의로 생성하는 함수. parseAttritubes 코드 내에서 가격 정보에 대해 price가 존재하는 경우, AttributeSlugEnum.pricePerUnit(단가) 속성을 만들어서 추가하는 경우에만 사용되고 있었음. 단, 남은 코드에서 price가 항상 null로 입력 받으며 사용되지 않던 함수임.
// 결과적으로 제품 리스트에서 제품 속성에 대해 입수량가 존재하면, 단위 속성을 입수량의 value에 텍스트로 더해주고 단위 속성은 제거하도록 쓰이고 있었음.
// 제품의 속성 구조 변경, 입수량와 박스 규격의 정보가 productVariant의 정보로 변경됨에 따라 불필요한 과정으로 보이고, 다른 페이지에서의 속성 관리 로직과 통일을 위해, 추후 코드 관리에도 헷갈리거나 불필요한 관리가 요구될 것으로 보여 제거.

export const getMoneyFormat = (money: any | null, digits: number = 0) => {
  if (utils.isEmpty(money)) {
    return "-";
  }
  try {
    return `${utils.formattedNumberWithDigits(money, digits)}원`;
  } catch {
    // @ts-ignore
  }
  return "-";
};

export const getNumberFormat = (value: string | number | null) => {
  if (utils.isEmpty(value)) {
    return "-";
  }
  try {
    return Number(value).toLocaleString();
  } catch {
    // @ts-ignore
  }
  return "-";
};

export const getProductSku = (product: ProductList_products_edges_node | SearchProducts_search_edges_node) => {
  if (!product) {
    return undefined;
  }
  // union type 전달할 경우 find 에 대해 error TS2349: This expression is not callable. 오류가 나서 타입캐스팅함
  const variants = product.variants as Array<
    ProductList_products_edges_node_variants | SearchProducts_search_edges_node_variants
  >;
  const defaultVariant = variants ? variants.find((variant) => variant.id === product.defaultVariantId) : undefined;
  if (defaultVariant) {
    return defaultVariant.sku;
  }

  return undefined;
};

