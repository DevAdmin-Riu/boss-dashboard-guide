  };

  switch (type) {
    case OrderDeliveryViewTypeEnum.ALL:
      filterStructure = [
        isB2b === false && orderSearchFilter,
        isB2b && b2bOrderSearchFilter,
        paymentSearchFilter,
        userSearchFilter,
        brandSearchFilter,
        isB2b === false && brandStoreSearchFilter,
