<file path="src/app/components/Filter/useFilter.ts">
import { Dispatch, useEffect, useReducer } from "react";

import reduceFilter, { FilterReducerAction } from "./reducer";
import { IFilter, IFilterElement } from "./types";

export type UseFilter<T extends string> = [
  Array<IFilterElement<T>>,
  Dispatch<FilterReducerAction<T>>,
  () => void,
  () => void
];

function useFilter<T extends string>(initialFilter: IFilter<T>): UseFilter<T> {
  const [data, dispatchFilterAction] = useReducer<React.Reducer<IFilter<T>, FilterReducerAction<T>>>(
    reduceFilter,
    initialFilter
  );

  // 필터 활성화 여부와 값 초기화
  const clear = () =>
    dispatchFilterAction({
      payload: {
        new: initialFilter.map((each) => ({
          ...each,
          active: false,
          value: [],
        })),
      },
      type: "reset",
    });

  // 필터 초기화(현재 페이지 또는 탭의 필터 정보 그대로 reset)
  const reset = () =>
    dispatchFilterAction({
      payload: {
        new: initialFilter,
      },
      type: "reset",
    });

  const refresh = (filter: IFilter<T>) =>
    dispatchFilterAction({
      payload: {
        new: filter,
      },
      type: "merge",
    });

  useEffect(() => refresh(initialFilter), [initialFilter]);

  return [data, dispatchFilterAction, clear, reset];
}

export default useFilter;
</file>

<file path="src/app/components/FilterBar/SpreadFilterBar.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { DownloadableColumnsType } from "@src/app/components/antd/Table/TableProps";
import FilterPicker from "@src/app/components/FilterPicker/FilterPicker";
import { FilterPickerChoice } from "@src/app/components/FilterPicker/FilterPickerContent";
import filterMsg from "@src/global/assets/messages/filters";
import useFilterSettings from "@src/global/core/hooks/useFilterSettings";
import { FilterProps, TabPageProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Divider, Space, Tabs } from "antd";
import React, { useMemo } from "react";

import SpreadFilter from "../Filter/SpreadFilter";
import { IFilter } from "../Filter/types";
import FormSpacer from "../FormSpacer";

export const makeFilterTabExtraNotSelectedText = (notSelectedCount: number) =>
  notSelectedCount > 0 ? `선틱되지 않은 구성 항목이 ${notSelectedCount}개 있습니다.` : null;

export interface DownloadRelatedProps<TVariables = any, TResult = any, TResultNode = any, TDataType = any> {
  fetchForDownload: (variables?: TVariables) => Promise<ApolloQueryResult<TResult>>;
  queryVariablesWithoutPagination: TVariables;
  columnsForDownload: DownloadableColumnsType<TResultNode>;
  processNodesToDataType?: (nodes: TResultNode[]) => TDataType[];
  makeChildrenFlat?: boolean;
  dataKey: string;
  // 멀티레벨 헤더 설정 (3단계 이상 헤더 지원)
  isMultiLevel?: boolean;
}

interface SpreadFilterBarProps<
  TKeys extends string = string,
  TVariables = any,
  TResult = any,
  TResultNode = any,
  TDataType = any
> extends FilterProps<TKeys>,
    TabPageProps {
  filterStructure: IFilter<TKeys>;
  isDownloadable?: boolean;
  excelDownloadProps?: DownloadRelatedProps<TVariables, TResult, TResultNode, TDataType>;
  validateQueryClick?: () => boolean;
  getAvailableFilters?: (filterStructure: IFilter<TKeys>) => FilterPickerChoice[];
}

const SpreadFilterBar = <
  TKeys extends string = string,
  TVariables = any,
  TResult = any,
  TResultNode = any,
  TDataType = any
>(
  props: SpreadFilterBarProps<TKeys, TVariables, TResult, TResultNode, TDataType>
) => {
  const {
    currencySymbol,
    filterStructure: originalFilterStructure,
    currentTab,
    tabs,
    tabExtra,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    isDownloadable = false,
    excelDownloadProps,
    validateQueryClick,
    getAvailableFilters,
  } = props;

  const isMobile = utils.checkMobile();
  const isCustom = currentTab === tabs.length + 1;
  const displayTabAction: "save" | "delete" | null = currentTab === 0 ? null : isCustom ? "save" : "delete";

  const { settings: filterSettings, updateFilterSettings, resetFilterSettings } = useFilterSettings();

  const filterStructure = useMemo(() => {
    const { visibleFilters, hasCustomSettings } = filterSettings;

    // 사용자 설정이 없으면 모든 필터 표시
    if (!hasCustomSettings || visibleFilters.length === 0) {
      return originalFilterStructure;
    }

    const structureWithVisibility = originalFilterStructure.map((filter) => {
      // 필수 필터는 항상 표시
      if (filter.isRequired) {
        return filter;
      }

      const isVisible = visibleFilters.includes(filter.name);

      return {
        ...filter,
        visible: isVisible,
      };
    });

    return structureWithVisibility.filter((filter) => filter.visible !== false);
  }, [originalFilterStructure, filterSettings]);

  const availableFilters = useMemo(() => {
    if (getAvailableFilters) {
      return getAvailableFilters(originalFilterStructure);
    }

    const filters: FilterPickerChoice[] = [];

    originalFilterStructure.forEach((filter) => {
      // 필수 필터는 설정에서 제외
      if (filter.isRequired) {
        return;
      }

      filters.push({
        label: filter.label,
        value: filter.name,
      });
    });

    return filters;
  }, [originalFilterStructure, getAvailableFilters]);
  const tabActionButtons = (
    <>
      {displayTabAction === "save" && (
        <Button block type="primary" size="small" onClick={onTabSave}>
          {filterMsg.saveSearch}
        </Button>
      )}
      {displayTabAction === "delete" && (
        <Button block type="default" size="small" onClick={onTabDelete} danger>
          {filterMsg.deleteSearch}
        </Button>
      )}
    </>
  );

  const savedTabItems = tabs.map((tab, tabIdx) => ({ label: tab, key: String(tabIdx + 1) }));
  const notSavedTabItem = isCustom && { label: filterMsg.customFilter, key: String(tabs.length + 1) };
  const tabItems = useMemo(
    () => [{ label: "전체 목록", key: "0" }, ...savedTabItems, notSavedTabItem],
    [savedTabItems, notSavedTabItem]
  );

  const handleTabClick = (tabKey: string) => {
    const numberTabKey = Number(tabKey);
    if (numberTabKey === 0) {
      onAll();
    } else if (numberTabKey !== tabs.length + 1) {
      onTabChange(numberTabKey);
    }
  };

  const initialFiltersForPicker = useMemo(() => {
    const { visibleFilters, hasCustomSettings } = filterSettings;

    // 사용자 설정이 없으면 모든 필터 선택
    if (!hasCustomSettings || visibleFilters.length === 0) {
      return availableFilters.map((f) => f.value);
    }

    return visibleFilters;
  }, [filterSettings, availableFilters]);

  if (!filterStructure || filterStructure.length === 0) {
    return null;
  }

  const enhancedTabExtra = (
    <Space
      wrap
      direction="horizontal"
      size="small"
      split={<Divider style={{ borderColor: "black" }} type="vertical" />}
    >
      <FilterPicker
        filters={availableFilters}
        loading={false}
        initialFilters={initialFiltersForPicker}
        total={availableFilters.length}
        onSave={updateFilterSettings}
        onReset={resetFilterSettings}
      />
      {tabExtra}
    </Space>
  );

  return (
    <>
      {isMobile && enhancedTabExtra}
      <Tabs
        type="card"
        activeKey={currentTab.toString()}
        items={tabItems}
        tabBarExtraContent={!isMobile && enhancedTabExtra}
        onTabClick={handleTabClick}
      />
      <SpreadFilter<TKeys, TVariables, TResult, TResultNode, TDataType>
        menu={filterStructure}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        onAll={onAll}
        onFilterChange={onFilterChange}
        tabActionButtons={tabActionButtons}
        isDownloadable={isDownloadable}
        excelDownloadProps={excelDownloadProps}
        validateQueryClick={validateQueryClick}
      />
      <FormSpacer />
    </>
  );
};
export default SpreadFilterBar;
</file>

<file path="src/app/components/FilterPicker/FilterPicker.tsx">
import { SettingOutlined } from "@ant-design/icons";
import useStateFromProps from "@hooks/useStateFromProps";
import { StrictOmit } from "@src/global/core/types/types";
import { toggle } from "@utils/lists";
import { showNotificationInfo } from "@utils/notification/wrapper";
import { Button, Popover, Tooltip } from "antd";
import React from "react";

import { makeFilterTabExtraNotSelectedText } from "../FilterBar/SpreadFilterBar";
import FilterPickerContent, { FilterPickerContentProps } from "./FilterPickerContent";

export interface FilterPickerProps
  extends StrictOmit<
    FilterPickerContentProps,
    "selectedFilters" | "onCancel" | "onFilterToggle" | "onAllSelectOn" | "onAllSelectOff" | "onSave"
  > {
  className?: string;
  initialFilters: string[];
  initialOpen?: boolean;
  onSave: (filters: string[]) => void;
  onReset?: () => void;
}

const FilterPicker: React.FC<FilterPickerProps> = (props) => {
  const { filters, initialFilters, initialOpen = false, loading, total, onSave, onReset } = props;
  const [isExpanded, setExpansionState] = React.useState(false);
  const [selectedFilters, setSelectedFilters] = useStateFromProps(initialFilters);
  const notSelectedCount = Math.max(total - selectedFilters.length, 0);

  React.useEffect(() => {
    setTimeout(() => setExpansionState(initialOpen), 100);
  }, []);

  const handleOpenChange = (newOpen: boolean) => {
    setExpansionState(newOpen);
  };

  const handleCancel = () => {
    setExpansionState(false);
    setSelectedFilters(initialFilters);
  };

  const handleFilterToggle = (filter: string) => setSelectedFilters(toggle(filter, selectedFilters, (a, b) => a === b));

  const handleAllSelectOn = () => {
    setSelectedFilters(filters.map((item) => item.value));
  };

  const handleAllSelectOff = () => setSelectedFilters([]);

  const handleSave = () => {
    if (selectedFilters.length === 0) {
      showNotificationInfo("선택된 필터가 없습니다. 1개 이상 선택해주세요.");
      return;
    }
    setExpansionState(false);
    onSave(selectedFilters);
  };

  const handleReset = () => {
    if (onReset) {
      onReset();
      setSelectedFilters(filters.map((item) => item.value));
      setExpansionState(false);
      showNotificationInfo("필터 설정이 초기화되었습니다.");
    }
  };

  const popoverContent = (
    <FilterPickerContent
      filters={filters}
      loading={loading}
      selectedFilters={selectedFilters}
      total={total}
      onCancel={handleCancel}
      onFilterToggle={handleFilterToggle}
      onAllSelectOn={handleAllSelectOn}
      onAllSelectOff={handleAllSelectOff}
      onSave={handleSave}
      onReset={onReset ? handleReset : undefined}
    />
  );

  return (
    <Popover
      placement="bottomRight"
      content={popoverContent}
      trigger="click"
      open={isExpanded}
      onOpenChange={handleOpenChange}
    >
      <Tooltip placement="topRight" title={makeFilterTabExtraNotSelectedText(notSelectedCount)}>
        <Button
          type="text"
          icon={<SettingOutlined />}
          onClick={() => setExpansionState((prevState) => !prevState)}
          title="필터 구성"
        >
          필터 구성{notSelectedCount > 0 && `(${notSelectedCount})`}
        </Button>
      </Tooltip>
    </Popover>
  );
};

export default FilterPicker;
</file>

