export const HqScheduleListView: React.FC<HqScheduleLineListViewProps> = ({ params }) => {
  const navigate = useNavigator();
  const { user } = useUser();
  const [modalMode, setModalMode] = useState<ScheduleListModalModeEnum>(null);
  const [selectedRowId, setSelectedRowId] = useState<string>(null);

  const rangeStart = moment().startOf("month").startOf("week");
  const rangeEnd = rangeStart.clone().add(4, "weeks").endOf("week");
  const [calendarRange, setCalendarRange] = useState<[Moment, Moment]>([rangeStart, rangeEnd]);
  const [selectedDate, setSelectedDate] = useState<Moment>(moment());
  // search로 검색되는 GrapheneRelayConnectionMaxLimitEnum.listForLabel 이 맥스 임. 50명 넘어가면 이슈.
  const [allHqStaffList, setAllHqStaffList] = useState<SearchHqStaffs_search_edges_node[]>([]);
  const [scheduleList, setScheduleList] = useState<HqScheduleList_schedules_edges_node[]>([]);

  const onModalOpen = (mode: ScheduleListModalModeEnum, rowId?: string) => {
    setModalMode(mode);
    if (rowId) {
      setSelectedRowId(rowId);
    }
  };
  const onModalClose = () => {
    setModalMode(null);
    setSelectedRowId(null);
  };

  useEffect(() => {
    if (utils.isEmpty(params.writers)) {
      params.writers = [user.id];
      navigate(hqScheduleListViewUrl({ ...params }));
    }
  }, []);

  const activePeriod = useMemo<DateRangeInput>(() => {
    const [activeStart, activeEnd] = calendarRange;
    return getGteLteVariables({
      gte: activeStart.format(onlyDateFormat),
      lte: activeEnd.format(onlyDateFormat),
    });
  }, [calendarRange]);
  const filterVariables = useMemo<ScheduleFilterInput>(
    () => ({ ...getFilterVariables(params), activePeriod }),
    [params, calendarRange]
  );
  const queryVariables: HqScheduleListVariables = {
    first: GrapheneRelayConnectionMaxLimitEnum.schedule,
    filter: filterVariables,
  };
  const { data, loading, refetch } = useHqScheduleListQuery({
    forceFetchPolicy: "cache-first",
    skip: utils.isEmpty(params.writers),
    variables: queryVariables,
  });
  // 새 데이터가 유효할 때만 업데이트
  useEffect(() => {
    const newList = data?.schedules?.edges?.map((edge) => edge.node);
    if (newList && Array.isArray(newList)) {
      setScheduleList(newList);
    }
    if (utils.isEmpty(params.writers)) {
      setScheduleList([]);
    }
  }, [data]);

  const totalCount = maybe(() => data.schedules.totalCount, 0);
  const selectedSchedule = scheduleList.find((schedule) => schedule.id === selectedRowId);

  const hasMore = totalCount > GrapheneRelayConnectionMaxLimitEnum.schedule;
  if (hasMore) {
    showNotificationError("조회된 기간의 일정이 최대 조회 가능 개수를 초과했습니다. 관리자에게 문의해 주세요.");
  }

  const {
    loadMore: hqStaffsLoadMore,
    result: hqStaffs,
    search: searchHqStaffs,
  } = useHqStaffSearch({
    skip: utils.isEmpty(user?.brand?.id),
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.listForLabel, brand: user.brand.id },
  });
  const hqStaffList = maybe(() => hqStaffs.data.search.edges.map((edge) => edge.node), []).sort((a, b) => {
    // 현재 로그인한 사용자를 항상 첫 번째로
    if (a.id === user.id) {
      return -1;
    }
    if (b.id === user.id) {
      return 1;
    }
    return 0;
  });
  const fetchMoreHqStaffs = {
    hasMore: maybe(() => hqStaffs.data.search.pageInfo.hasNextPage),
    loading: hqStaffs.loading,
    onFetchMore: hqStaffsLoadMore,
  };

  // 모든 HQ 스태프 리스트가 비어있고, 더 가져올 수 없는 경우에만(hasMore가 없는 경우) 추가로 가져옴
  // 참고로 스태프수가 50명 이상인 경우, 검색으로 가져오는 것이 아니라 전체를 가져와야 함.(50명까지 가는 브랜드가 있을지 모르지만 그런 경우 이슈가 보고 될꺼니 괜찮을듯.)
  useEffect(() => {
    if (fetchMoreHqStaffs.hasMore === false && allHqStaffList.length === 0) {
      setAllHqStaffList(hqStaffList);
    }
  }, [fetchMoreHqStaffs.hasMore]);

  const [scheduleCreate, scheduleCreateOpts] = useScheduleCreateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.scheduleCreate?.errors, "일정이 등록되었습니다.", onModalClose),
  });

  const [scheduleUpdate, scheduleUpdateOpts] = useScheduleUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.scheduleUpdate?.errors, "일정이 수정되었습니다.", onModalClose),
  });

  const [scheduleDelete, scheduleDeleteOpts] = useScheduleDeleteMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.scheduleDelete?.errors, "일정이 삭제되었습니다.", onModalClose),
  });

  const handleCreateOrUpdateSubmit = async (formData: ScheduleForm) => {
    const {
      start,
      end,
      isAllDay,
      title,
      description,
      repeatType,
      repeatInterval,
      repeatUntil,
      repeatAnchorType,
      hasAlarm,
      alarmOffsetTime,
      participants,
    } = formData;
    const startMoment: Moment = isAllDay ? start.startOf("day") : start;
    const endMoment: Moment = isAllDay ? end.endOf("day") : end;
    const input: ScheduleInput = {
      start: startMoment.format(ISOFormatWithTimeZone),
      end: endMoment.format(ISOFormatWithTimeZone),
      title,
      description,
      repeatType,
      repeatInterval,
      repeatUntil: repeatUntil ? repeatUntil.format(onlyDateFormat) : null,
      repeatAnchorType,
      hasAlarm,
      alarmOffsetMinutes: alarmOffsetTime.hour * 60 + alarmOffsetTime.minute,
      participants,
    };

    if (modalMode === ScheduleListModalModeEnum.Create) {
      scheduleCreate({
        variables: { input },
        update: (cache, { data }) => {
          const newSchedule = data?.scheduleCreate?.schedule;
          addEdgeToListCache<HqScheduleList, HqScheduleList_schedules_edges>({
            cache,
            query: hqScheduleListQuery,
            edgeField: "schedules",
            schemaName: "schedules",
            newNode: newSchedule,
            makeEdges: (prevEdges, newNode) => [...prevEdges, { __typename: "ScheduleCountableEdge", node: newNode }],
            addCondition: (variables: HqScheduleListVariables) => {
              const { filter } = variables;
              const filterWriterIdList = filter?.writers || [];

              return filterWriterIdList.includes(newSchedule.writer.id);
            },
          });
        },
      });
    } else if (modalMode === ScheduleListModalModeEnum.Update && selectedRowId) {
      scheduleUpdate({ variables: { id: selectedRowId, input } });
    }
  };

  const handleDelete = () => {
    if (utils.isEmpty(selectedRowId, true)) {
      showNotificationError("삭제할 일정을 선택해주세요.");
      return;
    }

    scheduleDelete({
      variables: { id: selectedRowId },
      update: (cache, { data }) => {
        const errors = data?.scheduleDelete?.errors;
        if (errors && errors.length > 0) {
          return;
        }
        removeEdgeFromListCache<HqScheduleList, HqScheduleList_schedules_edges>({
          cache,
          query: hqScheduleListQuery,
          edgeField: "schedules",
          schemaName: "schedules",
          nodeId: selectedRowId,
        });
      },
    });
  };

  const onParamsChange = (newParams: HqScheduleListViewUrlQueryParams) => {
    navigate(hqScheduleListViewUrl({ ...params, ...newParams }));
  };

  useEffect(() => {
    setSelectedRowId(null);
  }, [location.pathname]);

  const pageLoading = loading || scheduleCreateOpts.loading || scheduleUpdateOpts.loading || scheduleDeleteOpts.loading;

  return (
    <>
      <HqScheduleListPage
        params={params}
        calendarRange={calendarRange}
        selectedDate={selectedDate}
        scheduleList={scheduleList}
        loading={pageLoading}
        refetch={refetch}
        onRangeChange={(startDate, endDate) => {
          setSelectedRowId(null);
          setCalendarRange([startDate, endDate]);
        }}
        onDateChange={(date) => {
          setSelectedRowId(null);
          setSelectedDate(date);
        }}
        onCreate={() => onModalOpen(ScheduleListModalModeEnum.Create)}
        onUpdate={(scheduleId) => onModalOpen(ScheduleListModalModeEnum.Update, scheduleId)}
        onDelete={(scheduleId) => onModalOpen(ScheduleListModalModeEnum.Delete, scheduleId)}
        onParamsChange={onParamsChange}
        allHqStaffList={allHqStaffList}
        fetchMoreHqStaffs={fetchMoreHqStaffs}
      />
      <ScheduleCreateOrUpdateModal
        open={modalMode === ScheduleListModalModeEnum.Create || modalMode === ScheduleListModalModeEnum.Update}
        isUpdateMode={modalMode === ScheduleListModalModeEnum.Update}
        loading={pageLoading}
        selectedDate={selectedDate}
        selectedSchedule={selectedSchedule}
        onSubmit={handleCreateOrUpdateSubmit}
        onDelete={() => onModalOpen(ScheduleListModalModeEnum.Delete, selectedRowId)}
        onClose={onModalClose}
        hqStaffList={hqStaffList}
        fetchMoreHqStaffs={fetchMoreHqStaffs}
        searchHqStaffs={searchHqStaffs}
      />
      <ConfirmModal
        visible={modalMode === ScheduleListModalModeEnum.Delete}
        modalTitleText="일정 삭제"
        titleText="정말로 선택한 일정을 삭제하시겠습니까?"
        helpText="삭제된 일정은 복구할 수 없습니다."
        okButtonProps={{ danger: true }}
        okText="삭제"
        onOk={handleDelete}
        onCancel={onModalClose}
      />
    </>
  );
};
</file>

