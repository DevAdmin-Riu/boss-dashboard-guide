export enum CollectionDetailsEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateVisibility = "UpdateVisibility",
}

enum CollectionDetailsModalModeEnum {
  Assign = "Assign",
  Unassign = "Unassign",
  UnassignBulk = "UnassignBulk",
  RemoveCollection = "RemoveCollection",
}

export const CollectionDetailsView: React.FC<CollectionDetailsViewProps> = ({ id, params }) => {
  const navigate = useNavigator();

  const [editMode, setEditMode] = useState<CollectionDetailsEditModeEnum>(null);
  const [modalMode, setModalMode] = useState<CollectionDetailsModalModeEnum | null>(null);
  const [idsForModal, setIdsForModal] = useState<string[]>([]);

  const onEdit = (mode: CollectionDetailsEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };
  const resetForCloseModal = () => {
    setModalMode(null);
    setIdsForModal([]);
  };
  const openModalWithoutNavigate = (modalMode: CollectionDetailsModalModeEnum, idsForModal?: string[]) => {
    setModalMode(modalMode);
    if (idsForModal) {
      setIdsForModal(idsForModal);
    }
  };
  const handleProductUnassign = (productId: string) => {
    openModalWithoutNavigate(CollectionDetailsModalModeEnum.Unassign, [productId]);
  };
  const handleProductsUnassign = (productIds: string[]) =>
    openModalWithoutNavigate(CollectionDetailsModalModeEnum.UnassignBulk, productIds);

  const paginate = usePaginator();
  const paginationState = createPaginationState(PAGINATE_BY, params);
  const handleBack = () => navigate(collectionListViewUrl());

  const { data, loading } = useCollectionDetailsQuery({
    skip: id === undefined,
    variables: { id, ...paginationState },
  });
  const collection = data?.collection;
  const shop = data?.shop;
  const isFeatured = maybe(() => shop.homepageCollection.id === collection.id, false);

  const { search, loadMore, result } = useProductSearch({
    skip: modalMode !== CollectionDetailsModalModeEnum.Assign,
    variables: { ...DEFAULT_INITIAL_SEARCH_DATA },
  });

  const [collectionUpdate] = useCollectionUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.collectionUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  const [collectionUpdateWithHomepage] = useCollectionUpdateWithHomepageMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.homepageCollectionUpdate.errors, commonMsg.savedChanges, onEditCancel),
  });

  const [collectionRemove, collectionRemoveOpts] = useCollectionRemoveMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.collectionDelete.errors, "컬렉션이 삭제되었습니다.", () =>
        navigate(collectionListViewUrl())
      ),
  });

  const [assignProduct, assignProductOpts] = useCollectionAssignProductMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.collectionAddProducts.errors, "컬렉션에 제품이 추가되었습니다."),
  });

  const [unassignProduct, unassignProductOpts] = useUnassignCollectionProductMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.collectionRemoveProducts.errors,
        "컬렉션에서 제품이 제외되었습니다.",
        resetForCloseModal
      ),
  });

  if (loading) {
    return <Loader />;
  }

  // InfiniteScroll 에 이미 등록되어 있는 상품 리스트 중 컬렉션 연동 상품(추천 상품)으로 연결한 것 필터링
  const collectionProductIdList = maybe(() => collection.products.edges.map((e) => e.node.id), []);

  const handleBasicInfoUpdate = async (formData: CollectionBasicInfoUpdateForm) => {
    const cleanedFormData = cleanFormDataUploadInputs(formData, ["backgroundImage"]);

    const input: CollectionInput = {
      ...cleanedFormData,
    };

    await collectionUpdate({ variables: { id, input } });
  };

  const handleVisibilityUpdate = async (formData: CollectionVisibilityUpdateForm) => {
    const input: CollectionInput = {
      ...formData,
    };

    const oldIsFeatured = isFeatured;
    const newIsFeatured = formData.isFeatured;
    if (oldIsFeatured !== newIsFeatured) {
      await collectionUpdateWithHomepage({ variables: { homepageId: formData.isFeatured ? id : null, id, input } });
    } else {
      await collectionUpdate({ variables: { id, input } });
    }
  };

  const { loadNextPage, loadPreviousPage, pageInfo } = paginate(
    collection?.products?.pageInfo,
    paginationState,
    params
  );

  return (
    <>
      <WindowTitle title={maybe(() => collection.name)} />
      <CollectionDetailsPage
        onAdd={() => openModalWithoutNavigate(CollectionDetailsModalModeEnum.Assign)}
        onBack={handleBack}
        disabled={loading}
        collection={collection}
        isFeatured={isFeatured}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onCollectionRemove={() => openModalWithoutNavigate(CollectionDetailsModalModeEnum.RemoveCollection)}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onVisibilityUpdate={handleVisibilityUpdate}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        pageInfo={pageInfo}
        onProductUnassign={handleProductUnassign}
        onProductsUnassign={handleProductsUnassign}
        onRowClick={(id) => navigate(productUpdateViewUrl(id))}
      />
      <AssignProductDialog
        hasMore={result.data?.search?.pageInfo.hasNextPage}
        open={modalMode === CollectionDetailsModalModeEnum.Assign}
        onFetch={search}
        onFetchMore={loadMore}
        loading={result.loading || assignProductOpts.loading}
        onClose={resetForCloseModal}
        onSubmit={(products) =>
          assignProduct({
            variables: {
              ...paginationState,
              collectionId: id,
              productIds: products.map((product) => product.id),
            },
          })
        }
        products={maybe(() =>
          result.data.search.edges
            .map((edge) => edge.node)
            .filter((suggestedProduct) => !collectionProductIdList.includes(suggestedProduct.id))
        )}
      />
      <ConfirmModal
        visible={modalMode === CollectionDetailsModalModeEnum.RemoveCollection}
        modalTitleText={collectionMsg.delete}
        titleText={utils.formatMessage(commonMsg.confirmDelete, { name: maybe(() => data.collection.name, "...") })}
        onOk={() => collectionRemove({ variables: { id } })}
        okButtonProps={{ danger: true, loading: collectionRemoveOpts.loading }}
        okText="삭제"
        onCancel={resetForCloseModal}
      />
      <ConfirmModal
        visible={
          modalMode === CollectionDetailsModalModeEnum.UnassignBulk ||
          modalMode === CollectionDetailsModalModeEnum.Unassign
        }
        modalTitleText={collectionMsg.unassign}
        titleText={
          idsForModal.length === 1
            ? "이 제품을 컬렉션에서 연동 해제하시겠습니까?"
            : `${idsForModal.length}종의 제품을 컬렉션에서 연동 해제하시겠습니까?`
        }
        onOk={() => unassignProduct({ variables: { ...paginationState, collectionId: id, productIds: idsForModal } })}
        okButtonProps={{ danger: true, loading: unassignProductOpts.loading }}
        okText="해제"
        onCancel={resetForCloseModal}
      />
    </>
  );
};
</file>

