<file path="src/app/views/brand/brands/components/BrandPackageInfoUpdate.tsx">
import { MutationFunction } from "@apollo/client";
import { formRuleMsg } from "@assets/messages/commonMsg";
import { BrandProductPackageUpdateInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import Loader from "@src/app/components/Loader";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { showNotificationWarn } from "@utils/notification/wrapper";
import { Button, Card, Checkbox, Col, Form, FormInstance, Input, InputNumber, Row, Select } from "antd";
import React, { useEffect } from "react";

import {
  BrandProductPackage_brandProductPackage,
  BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo,
} from "../api/types/BrandProductPackage";
import { BrandProductPackageUpdate, BrandProductPackageUpdateVariables } from "../api/types/BrandProductPackageUpdate";
import UploadImage from "./ImageUpload";

export interface BrandProductPackageUpdateFormData extends BrandProductPackageUpdateInput {
  etcDeliveryOriginFeeExcludeVat?: number;
  additionalFeeExcludeVatForEtcDelivery?: number;
}

interface BrandPackageInfoUpdateProps {
  form: FormInstance<BrandProductPackageUpdateFormData>;
  isTruckService: boolean;
  brandProductPackage: BrandProductPackage_brandProductPackage;
  brandProductVariantPackageInfoList: BrandProductPackage_brandProductPackage_brandProductVariantPackageInfo[];
  selectedRowId: string;
  updateLoading: boolean;
  brandProductPackageUpdate: MutationFunction<BrandProductPackageUpdate, BrandProductPackageUpdateVariables>;
}

const BrandPackageInfoUpdate: React.FC<BrandPackageInfoUpdateProps> = (props) => {
  const {
    form,
    isTruckService,
    selectedRowId,
    brandProductPackage,
    brandProductVariantPackageInfoList,
    updateLoading,
    brandProductPackageUpdate,
  } = props;
  const TypeSafeForm = getTypeSafeForm<BrandProductPackageUpdateFormData>(form);
  const visibleWatched = TypeSafeForm.getUseFormWatched({ name: "visible" });

  const initialValues: BrandProductPackageUpdateFormData = {
    name: brandProductPackage?.name,
    visible: brandProductPackage?.visible,
    etcDeliveryOriginFeeExcludeVat: toPriceExcludeVat(brandProductPackage?.etcDeliveryOriginFee),
    additionalFeeExcludeVatForEtcDelivery: toPriceExcludeVat(brandProductPackage?.additionalFeeForEtcDelivery),
    isByCourierAllowed: brandProductPackage?.isByCourierAllowed,
    isByTruckServiceAllowed: brandProductPackage?.isByTruckServiceAllowed,
  };

  const onFinish = (formData: BrandProductPackageUpdateFormData) => {
    const { visible, isByCourierAllowed, isByTruckServiceAllowed } = formData;
    if (visible && isByCourierAllowed === false && isByTruckServiceAllowed === false) {
      showNotificationWarn("판매 여부가 판매인 경우, 배송방법 사용여부는 1개 이상 필수 선택해야 합니다.");
      return;
    }

    const totalBrandProductDeliveryFee = brandProductVariantPackageInfoList.reduce((acc, cur) => {
      const deliveryFee = cur.brandProductVariant.deliveryFeeAmount;
      acc = acc + cur.quantity * deliveryFee;
      return acc;
    }, 0);
    const etcDeliveryOriginFee = isTruckService ? toPriceIncludeVat(formData.etcDeliveryOriginFeeExcludeVat) : 0;
    const etcDeliveryFee = isTruckService ? etcDeliveryOriginFee - totalBrandProductDeliveryFee : 0;
    const additionalFeeForEtcDelivery = isTruckService
      ? toPriceIncludeVat(formData.additionalFeeExcludeVatForEtcDelivery)
      : 0;

    const input: BrandProductPackageUpdateInput = {
      name: formData.name,
      visible: formData.visible,
      isByCourierAllowed: formData.isByCourierAllowed,
      isByTruckServiceAllowed: formData.isByTruckServiceAllowed,
      etcDeliveryOriginFee,
      etcDeliveryFee,
      additionalFeeForEtcDelivery,
    };

    brandProductPackageUpdate({ variables: { id: selectedRowId, input } });
  };

  useEffect(() => {
    if (isTruckService === false) {
      form.setFieldsValue({
        etcDeliveryOriginFeeExcludeVat: 0,
        additionalFeeExcludeVatForEtcDelivery: 0,
      });
    }
  }, [isTruckService]);

  return (
    <>
      {brandProductPackage === null ? (
        <Loader />
      ) : (
        <Form
          preserve={false}
          name="basic"
          form={form}
          layout="vertical"
          initialValues={initialValues}
          onFinish={onFinish}
          autoComplete="off"
          style={{ marginBottom: 10 }}
          validateMessages={{ required: formRuleMsg.required }}
        >
          <Row justify={"space-between"} gutter={[24, 12]}>
            <Col span={24}>
              <TableVatLegend isIncludeVat={false} size="small" />
              <Card
                type="inner"
                title="기본 정보"
                extra={
                  <Form.Item noStyle shouldUpdate>
                    {() => (
                      <Button
                        type="primary"
                        loading={updateLoading}
                        disabled={!form.isFieldsTouched()}
                        onClick={form.submit}
                      >
                        저장
                      </Button>
                    )}
                  </Form.Item>
                }
              >
                <Row justify={"space-between"} gutter={[24, 12]}>
                  <Col span={16}>
                    <Form.Item
                      style={{ marginBottom: 0 }}
                      label="상품명"
                      name={TypeSafeForm.getValidDataIndex("name")}
                      rules={[{ required: true }]}
                    >
                      <Input />
                    </Form.Item>
                  </Col>
                  <Col span={8}>
                    <Row justify="space-between">
                      <Col>
                        <Form.Item required={visibleWatched} label="배송방법 사용여부">
                          <Row gutter={4}>
                            <Col>
                              <Form.Item
                                noStyle
                                name={TypeSafeForm.getValidDataIndex("isByCourierAllowed")}
                                valuePropName="checked"
                              >
                                <Checkbox>택배 배송</Checkbox>
                              </Form.Item>
                            </Col>
                            <Col>
                              <Form.Item
                                noStyle
                                name={TypeSafeForm.getValidDataIndex("isByTruckServiceAllowed")}
                                valuePropName="checked"
                              >
                                <Checkbox>화물차 배송</Checkbox>
                              </Form.Item>
                            </Col>
                          </Row>
                        </Form.Item>
                      </Col>
                    </Row>
                  </Col>
                  <Col span={8}>
                    <Form.Item
                      style={{ marginBottom: 0 }}
                      label="판매 여부"
                      name={TypeSafeForm.getValidDataIndex("visible")}
                      rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
                    >
                      <Select
                        placeholder="판매 여부"
                        options={[
                          { label: "판매", value: true },
                          { label: "중단", value: false },
                        ]}
                      />
                    </Form.Item>
                  </Col>
                  <Col span={8}>
                    <Form.Item
                      style={{ marginBottom: 0 }}
                      label="화물차 배송비"
                      name={TypeSafeForm.getValidDataIndex("etcDeliveryOriginFeeExcludeVat")}
                      rules={[{ required: isTruckService }]}
                    >
                      <InputNumber
                        {...getInputNumberProps({ isCommaDisplay: true })}
                        size={"middle"}
                        style={{ width: "100%" }}
                        disabled={isTruckService === false}
                      />
                    </Form.Item>
                  </Col>
                  <Col span={8}>
                    <Form.Item
                      style={{ marginBottom: 0 }}
                      label="도서산간 지역 화물차 배송 추가 비용"
                      name={TypeSafeForm.getValidDataIndex("additionalFeeExcludeVatForEtcDelivery")}
                      rules={[{ required: isTruckService }]}
                    >
                      <InputNumber
                        {...getInputNumberProps({ isCommaDisplay: true })}
                        size={"middle"}
                        style={{ width: "100%" }}
                        disabled={isTruckService === false}
                      />
                    </Form.Item>
                  </Col>
                </Row>
              </Card>
            </Col>
            <Col span={12}>
              <UploadImage
                title="썸네일 이미지"
                image={brandProductPackage.thumbnailImage}
                onImageDelete={function (): void {
                  brandProductPackageUpdate({
                    variables: {
                      id: selectedRowId,
                      input: {
                        thumbnailImage: null,
                      },
                    },
                  });
                }}
                onImageUpload={function (file: File): void {
                  brandProductPackageUpdate({
                    variables: {
                      id: selectedRowId,
                      input: {
                        thumbnailImage: file,
                      },
                    },
                  });
                }}
              />
            </Col>
            <Col span={12}>
              <UploadImage
                title="디테일 이미지"
                image={brandProductPackage.detailImage}
                onImageDelete={function (): void {
                  brandProductPackageUpdate({
                    variables: {
                      id: selectedRowId,
                      input: {
                        detailImage: null,
                      },
                    },
                  });
                }}
                onImageUpload={function (file: File): void {
                  brandProductPackageUpdate({
                    variables: {
                      id: selectedRowId,
                      input: {
                        detailImage: file,
                      },
                    },
                  });
                }}
              />
            </Col>
          </Row>
        </Form>
      )}
    </>
  );
};

export default BrandPackageInfoUpdate;
</file>

<file path="src/app/views/brand/brands/components/BrandPackageUpdateModal.tsx">
import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { maybe } from "@utils/misc";
import { showNotificationInfo } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Button, Col, Form, Modal, Row, Space } from "antd";
import _ from "lodash";
import React, { useEffect, useState } from "react";

import {
  useBrandProductPackageInfoBulkAddMutation,
  useBrandProductPackageInfoBulkDeleteMutation,
  useBrandProductPackageInfoUpdateMutation,
  useBrandProductPackageUpdateMutation,
} from "../api/mutations";
import { useBrandProductListWithOnlyNonStoppedVariantsQuery, useBrandProductPackageQuery } from "../api/queries";
import BrandPackageInfoUpdate, { BrandProductPackageUpdateFormData } from "./BrandPackageInfoUpdate";
import { getBrandProductRows } from "./BrandProductListTable/utils";
import BrandProductPackageAddedList from "./BrandProductPackageAddedList/BrandProductPackageAddedList";
import BrandProductPackageAddList from "./BrandProductPackageAddList/BrandProductPackageAddList";
import BrandProductPackageTotal from "./BrandProductPackageTotal";

export interface IProductPackageInfoUpdate {
  id: string;
  quantity: number;
}

interface BrandPackageUpdateModalProps {
  open: boolean;
  brandId: string;
  selectedPackageId: string;
  onClose: () => void;
}

const BrandPackageUpdateModal: React.FC<BrandPackageUpdateModalProps> = (props) => {
  const { open, brandId, selectedPackageId, onClose } = props;
  // NOTE: 추가할 목록의 리스트
  const [packageAddSelectedRowIds, setPackageAddSelectedRowIds] = useState<React.Key[]>([]);
  const [packageDeleteSelectedRowIds, setPackageDeleteSelectedRowIds] = useState<React.Key[]>([]);

  const [updateForm] = Form.useForm<BrandProductPackageUpdateFormData>();
  const UpdateTypeSafeForm = getTypeSafeForm<BrandProductPackageUpdateFormData>(updateForm);
  const isByTruckServiceAllowedWatched = UpdateTypeSafeForm.getUseFormWatched({ name: "isByTruckServiceAllowed" });

  const { data: brandProductsData, loading: brandProductsLoading } = useBrandProductListWithOnlyNonStoppedVariantsQuery(
    {
      skip: !open,
      variables: {
        first: GrapheneRelayConnectionMaxLimitEnum.default,
        filter: { brand: brandId, isFulfilledByVendor: false },
      },
    }
  );
  const brandProducts = maybe(() => brandProductsData.brandProducts.edges.map((edge) => edge.node), []);

  const { data: brandProductPackageData, loading: brandProductPackageLoading } = useBrandProductPackageQuery({
    skip: !open || utils.isEmpty(selectedPackageId, true),
    variables: { id: selectedPackageId },
  });
  const brandProductPackage = maybe(() => brandProductPackageData.brandProductPackage, null);
  const brandProductVariantPackageInfoList = brandProductPackage?.brandProductVariantPackageInfo || [];

  const brandProductRows = getBrandProductRows(brandProducts, false);
  const packagedBpvIdList = brandProductVariantPackageInfoList.map((item) => item.brandProductVariant.id);
  // 패키지 구성품이 아닌 상품 리스트
  const notPackagedBpList = brandProductRows.filter((item) => !packagedBpvIdList.includes(item.brandProductVariant.id));

  // NOTE: ---------- 해당 modal에서만 사용되는 mutation ----------
  const [brandProductPackageInfoBulkAdd, brandProductPackageInfoBulkAddOpts] =
    useBrandProductPackageInfoBulkAddMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(data.brandProductPackageInfoBulkAdd.errors, "패키지에 상품을 추가했습니다."),
    });
  const [brandProductPackageInfoBulkDelete, brandProductPackageInfoBulkDeleteOpts] =
    useBrandProductPackageInfoBulkDeleteMutation({
      onCompleted: (data) =>
        utils.handleOnCompletedWithError(
          data.brandProductPackageInfoBulkDelete.errors,
          "패키지에 추가된 상품을 삭제했습니다."
        ),
    });
  const [brandProductPackageInfoUpdate, brandProductPackageInfoUpdateOpts] = useBrandProductPackageInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.brandProductPackageInfoUpdate.errors, "패키지 수량을 업데이트 했습니다."),
  });

  const [brandProductPackageUpdate, brandProductPackageUpdateOpts] = useBrandProductPackageUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.brandProductPackageUpdate.errors,
        "패키지 상품 정보를 업데이트 했습니다.",
        () => {
          updateForm.resetFields();
        }
      ),
  });
  // NOTE: ---------- 해당 modal에서만 사용되는 mutation ----------

  // NOTE: 모달 창 닫을 때 실행
  const onModalClose = () => {
    setPackageAddSelectedRowIds([]);
    setPackageDeleteSelectedRowIds([]);
    onClose();
  };

  // NOTE: 브랜드 제품 추가 이벤트
  const addBrandProduct = () => {
    if (brandProductPackage.visible) {
      showNotificationInfo("현재 판매중인 패키지에는 상품 추가를 할 수 없습니다.");
      return;
    }
    if (packageAddSelectedRowIds.length === 0) {
      showNotificationInfo("1개 이상 선택해 주셔야 추가가 가능합니다.");
      return;
    }

    const addBrandProductList = packageAddSelectedRowIds.reduce((acc, cur) => {
      const obj = {
        brandProductVariant: cur,
        brandProductPackage: selectedPackageId,
      };
      acc.push(obj);
      return acc;
    }, []);

    brandProductPackageInfoBulkAdd({
      variables: {
        input: [...addBrandProductList],
      },
    });
    setPackageAddSelectedRowIds([]);
    setPackageDeleteSelectedRowIds([]);
  };

  const deleteBrandProduct = async () => {
    if (brandProductPackage.visible) {
      showNotificationInfo("현재 판매중인 패키지는 상품 삭제를 할 수 없습니다.");
      return;
    }
    if (packageDeleteSelectedRowIds.length === 0) {
      showNotificationInfo("1개 이상 선택해 주셔야 삭제가 가능합니다.");
      return;
    }

    await brandProductPackageInfoBulkDelete({
      variables: {
        ids: packageDeleteSelectedRowIds as string[],
      },
    });
    setPackageAddSelectedRowIds([]);
    setPackageDeleteSelectedRowIds([]);
  };

  const productPackageInfoUpdate = ({ id, quantity }: IProductPackageInfoUpdate) => {
    brandProductPackageInfoUpdate({
      variables: {
        id,
        input: {
          quantity,
        },
      },
    });
  };

  useEffect(() => {
    if (open) {
      updateForm.resetFields();
    }
  }, [open]);

  const modalLoading = brandProductsLoading || brandProductPackageLoading;
  const buttonLoading = brandProductPackageInfoBulkAddOpts.loading || brandProductPackageInfoBulkDeleteOpts.loading;

  return (
    <>
      <Modal
        forceRender
        destroyOnClose
        closable={false}
        title={"패키지 수정"}
        open={open}
        width={1300}
        maskClosable={false}
        footer={
          <>
            <Button onClick={onModalClose}>닫기</Button>
          </>
        }
      >
        <Space direction="vertical" size="small">
          <BrandPackageInfoUpdate
            form={updateForm}
            selectedRowId={selectedPackageId}
            brandProductPackage={brandProductPackage}
            brandProductVariantPackageInfoList={brandProductVariantPackageInfoList}
            updateLoading={modalLoading || brandProductPackageUpdateOpts.loading}
            brandProductPackageUpdate={brandProductPackageUpdate}
            isTruckService={isByTruckServiceAllowedWatched}
          />
          <BrandProductPackageAddList
            brandProducts={notPackagedBpList}
            packageSelectedRowIds={packageAddSelectedRowIds}
            setPackageSelectedRowIds={setPackageAddSelectedRowIds}
          />
          <Row justify="center" gutter={[8, 8]}>
            <Col>
              <Button
                loading={buttonLoading}
                onClick={() => {
                  addBrandProduct();
                }}
              >
                추가 <ArrowDownOutlined />
              </Button>
            </Col>
            <Col>
              <Button
                loading={buttonLoading}
                onClick={() => {
                  deleteBrandProduct();
                }}
              >
                삭제 <ArrowUpOutlined />
              </Button>
            </Col>
          </Row>
          <BrandProductPackageAddedList
            loading={modalLoading || brandProductPackageInfoUpdateOpts.loading}
            brandProductVariantPackageInfo={brandProductVariantPackageInfoList}
            packageDeleteSelectedRowIds={packageDeleteSelectedRowIds}
            setPackageDeleteSelectedRowIds={setPackageDeleteSelectedRowIds}
            productPackageInfoUpdate={productPackageInfoUpdate}
          />
          <BrandProductPackageTotal
            brandProductVariantPackageInfoList={brandProductVariantPackageInfoList}
            etcDeliveryOriginFee={brandProductPackage?.etcDeliveryOriginFee}
            isTruckService={isByTruckServiceAllowedWatched}
          />
        </Space>
      </Modal>
    </>
  );
};

export default BrandPackageUpdateModal;
</file>

