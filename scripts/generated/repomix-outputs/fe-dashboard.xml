export const getOuterVariantForStockAction = (productVariant: ProductVariantDetailsForStockAction_productVariant) => {
  if (utils.isEmpty(productVariant)) {
    return null;
  }
  return productVariant.isInner ? productVariant.outer : productVariant;
};

export type TRackLocationForLabel = Pick<
  RackLocationForTagFragment,
  "id" | "name" | "canNotSellToCustomers" | "canPicking" | "canStock" | "isInitialOrderDefault" | "isReorderDefault"
> & {
  sector?: RackSectorWithAddressFragment | null;
};

export const makeRackLocationLabel = (
  location: TRackLocationForLabel,
  totalRemainQuantity?: number,
  spaceProps: SpaceProps = {}
) => {
  const address = location?.sector?.address?.companyName || "";
  const sector = location?.sector?.name || "";
  const locationName = location?.name || "";
  const isMobile = utils.checkMobile();

  const parts = [address, sector, locationName].filter((part) => part);
  const quantityText = utils.isEmpty(totalRemainQuantity) ? "" : ` (${totalRemainQuantity}개)`;

  // 모바일에서 3개 모두 있는 경우: 물류센터명 / 구역 (줄바꿈) 로케이션 (수량)

  if (isMobile) {
    const firstLine = `${address} / ${sector}`;
    const secondLine = `${locationName}${quantityText}`;

    return (
      <>
        <Typography style={{ display: "block" }}>{firstLine}</Typography>
        <Space>
          {secondLine}
          {makeRackLocationTags(location)}
        </Space>
      </>
    );
  }
  // 그 외: 물류센터명 / 구역 / 로케이션 (수량)
  const fullName = parts.join(" / ");
  const displayText = fullName + quantityText;

  return (
    <Space align="center" {...spaceProps}>
      <Typography>{displayText}</Typography>
      {makeRackLocationTags(location)}
    </Space>
  );
};

// 로케이션 리스트 생성 -> 중복되는 로케이션 제거
export const getUniqueRackLocationsByRackStocks = (
  rackStocks: Array<{
    location: TRackLocationForLabel;
  }>
) => {
  if (utils.isEmpty(rackStocks)) {
    return [];
  }
  return rackStocks.map((stock) => stock.location).filter((location, index, self) => self.indexOf(location) === index);
};

export const ProductInfoForStockAction: React.FC<ProductInfoForStockActionProps> = (props) => {
  const {
    modalMode,
    loading,
    product,
    outerVariant,
    productVariant,
    forAdd,
    forLoss,
    forMove,
    forDivideOrCombine,
    isFbv,
  } = props;

  if (loading) {
    return <Loader />;
  }
  if (utils.isEmpty(product) || utils.isEmpty(outerVariant) || utils.isEmpty(productVariant)) {
    return <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description="제품 정보가 없습니다." />;
  }

  const isMobile = utils.checkMobile();
  const { name: productName, attributes: productAttributes, productType } = product;
  const { name: variantName, attributes: variantAttributes, qtyPerBoxUnitType } = outerVariant;
  const { sku, isInner } = productVariant;
  // 재고 제품에 대한 입고, 로스, 이동, 로케이션 정보 조회 등을 위한 컴포넌트이므로 직배송 여부는 항상 false
  const isInnerText = transformIsInner(isInner);
  const targetAttributes = productType.hasVariants ? variantAttributes : productAttributes;
  const specText = makeProductSpecTextFromAttr(targetAttributes);
  const qtyPerBoxText = makeProductQtyPerBoxText({ ...productVariant, qtyPerBoxUnitType });

  const descriptionTitle = `제품 정보(${sku})`;
  const productInfo = (
    <>
      <Descriptions.Item label={columnNameConstant.product.PRODUCT_NAME} span={2}>
        {productName || "-"}
      </Descriptions.Item>
      <Descriptions.Item label={columnNameConstant.product.VARIANT_NAME} span={isMobile ? 2 : 1}>
        {variantName || "-"}
      </Descriptions.Item>
      <Descriptions.Item label={columnNameConstant.product.IS_INNER} span={isMobile ? 2 : 1}>
        {isInnerText}
      </Descriptions.Item>
      <Descriptions.Item label={columnNameConstant.product.DETAIL_INFO} span={isMobile ? 2 : 1}>
        {specText}
      </Descriptions.Item>
      <Descriptions.Item label={columnNameConstant.product.PRODUCT_QTY_PER_BOX} span={isMobile ? 2 : 1}>
        {qtyPerBoxText}
      </Descriptions.Item>
    </>
  );

  if (modalMode === StockListModalModeEnum.RackStockList) {
    return (
      <Descriptions
        bordered
        size="small"
        layout="horizontal"
        labelStyle={{ width: 120 }}
        title={descriptionTitle}
        column={2}
      >
        {productInfo}
      </Descriptions>
    );
  }

  const addSelectAvailable = modalMode === StockListModalModeEnum.StockDetailAdd && !utils.isEmpty(forAdd);
  const lossSelectAvailable = modalMode === StockListModalModeEnum.StockDetailLoss && !utils.isEmpty(forLoss);
  const moveSelectAvailable = modalMode === StockListModalModeEnum.RackStockDetailMove && !utils.isEmpty(forMove);
  const divideOrCombineSelectAvailable =
    modalMode === StockListModalModeEnum.StockDetailDivideOrCombine && !utils.isEmpty(forDivideOrCombine);

  const commonSelectProps = (itemName: string): SelectProps => ({
    showSearch: true,
    size: "small",
    style: { width: "100%" },
    dropdownMatchSelectWidth: false,
    placeholder: `${itemName} 선택`,
    filterOption: (input, option) =>
      (typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase())) ||
      (typeof option?.labelText === "string" && (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())),
    notFoundContent: `선택 가능한 ${itemName}이/가 없습니다.`,
  });

  const makeLocationItem = () => {
    const makeRackLocationOptions = (
      rackLocations: Array<
        Pick<
          RackLocationForTagFragment,
          | "id"
          | "name"
          | "canNotSellToCustomers"
          | "canPicking"
          | "canStock"
          | "isInitialOrderDefault"
          | "isReorderDefault"
        >
      >
    ): DefaultOptionType[] =>
      rackLocations.map((location) => ({
        label: makeRackLocationLabel(location),
        labelText: location.name,
        value: location.id,
      }));

    if (addSelectAvailable) {
      const { rackStocks, searchedRackLocations, fetchMoreRackLocations, onSearchRackLocations, watchedValues } =
        forAdd;
      const rackLocationsFromRackStocks = getUniqueRackLocationsByRackStocks(rackStocks);
      const rackLocationsWithSearched = [...rackLocationsFromRackStocks, ...searchedRackLocations].filter(
        (location, index, self) => self.findIndex((l) => l.id === location.id) === index
      );
      const targetRackLocations = watchedValues.limitAssigned ? rackLocationsFromRackStocks : rackLocationsWithSearched;

      const locationOptions = makeRackLocationOptions(targetRackLocations);

      return (
        <Space direction="vertical" size={0}>
          <Form.Item name="limitAssigned" valuePropName="checked" noStyle>
            <Checkbox>연동된 로케이션에서만 검색</Checkbox>
          </Form.Item>
          <Form.Item
            name="rackLocation"
            style={{ margin: 0 }}
            rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
          >
            <Select
              {...commonSelectProps("로케이션")}
              {...getMobileSelectClassName()}
              loading={fetchMoreRackLocations.loading}
              options={locationOptions}
              onSearch={onSearchRackLocations}
              onDropdownVisibleChange={(open) => {
                if (open) {
                  onSearchRackLocations("");
                }
              }}
              onPopupScroll={({ currentTarget }) => {
                const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                const { hasMore, loading, onFetchMore } = fetchMoreRackLocations;
                // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                  onFetchMore();
                }
              }}
            />
          </Form.Item>
        </Space>
      );
    } else if (lossSelectAvailable) {
      const { rackStocks } = forLoss;
      const rackLocations = getUniqueRackLocationsByRackStocks(rackStocks);
      const locationOptions = makeRackLocationOptions(rackLocations);

      return (
        <Form.Item
          name="rackLocation"
          style={{ margin: 0 }}
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select {...commonSelectProps("로케이션")} {...getMobileSelectClassName()} options={locationOptions} />
        </Form.Item>
      );
    } else if (moveSelectAvailable) {
      const { rackLocation } = forMove;
      return (
        <>
          <Form.Item hidden noStyle name="fromRackLocation">
            <Input />
          </Form.Item>
          {makeRackLocationLabel(rackLocation)}
        </>
      );
    } else if (divideOrCombineSelectAvailable) {
      const { rackStocks } = forDivideOrCombine;
      const rackLocations = getUniqueRackLocationsByRackStocks(rackStocks);
      const locationOptions = makeRackLocationOptions(rackLocations);

      return (
        <Form.Item
          name="fromRackLocation"
          style={{ margin: 0 }}
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select {...commonSelectProps("로케이션")} {...getMobileSelectClassName()} options={locationOptions} />
        </Form.Item>
      );
    } else {
      return "-";
    }
  };

  const makeStockDetailItem = () => {
    const makeSelectLabelByStockDetail = (
      stockDetail: RackStockListForStockAction_rackStocks_edges_node_stockDetail
    ) => {
      if (utils.isEmpty(stockDetail)) {
        return (
          <Typography.Text strong type="warning">
            상세 재고 정보 없음
          </Typography.Text>
        );
      }
      const vendorInfoText = utils.isEmpty(stockDetail.vendor)
        ? "협력사 정보 없음"
        : `${stockDetail.vendor.code}: ${stockDetail.vendor.name}`;
      const stockDetailCreatedText = `입고일: ${getDateByFormat(stockDetail.stockedAt, onlyDateFormat)}`;
      const costPriceExcludeVatText = `매입가${commonMsg.excludeVat}: ${getMoneyFormat(
        stockDetail.costPriceExcludeVat
      )}`;
      const listForLabel = [stockDetail.code, vendorInfoText, stockDetailCreatedText, costPriceExcludeVatText];
      return listForLabel.join(" | ");
    };

    const makeStockDetailOptions = (
      rackStocks: Array<
        Pick<
          | RackStockListForStockAction_rackStocks_edges_node
          | ProductVariantDetailsForStockAction_productVariant_rackStocks,
          "remainQuantity" | "location" | "stockDetail"
        >
      >
    ): DefaultOptionType[] => {
      const filteredRackStocks = rackStocks.filter((rackStock) => !!rackStock?.stockDetail);
      return filteredRackStocks.map((rackStock) => {
        const label = makeSelectLabelByStockDetail(rackStock.stockDetail);
        return { label, value: rackStock.stockDetail.id };
      });
    };

    if (lossSelectAvailable) {
      const { rackStocks, watchedValues } = forLoss;
      const selectDisabled = utils.isEmpty(watchedValues.rackLocation, true);
      const rackStocksByLocation = selectDisabled
        ? []
        : rackStocks.filter((rackStock) => rackStock.location.id === watchedValues.rackLocation);

      const rackStockOptions = makeStockDetailOptions(rackStocksByLocation);

      return (
        <Form.Item
          name="stockDetail"
          style={{ margin: 0 }}
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select {...commonSelectProps("상세 재고")} disabled={selectDisabled} options={rackStockOptions} />
        </Form.Item>
      );
    } else if (moveSelectAvailable) {
      const { rackStock } = forMove;

      return (
        <>
          <Form.Item name="stockDetail" style={{ margin: 0 }} hidden>
            <Input />
          </Form.Item>
          {makeSelectLabelByStockDetail(rackStock?.stockDetail)}
        </>
      );
    } else if (divideOrCombineSelectAvailable) {
      const { rackStocks, watchedValues } = forDivideOrCombine;
      const selectDisabled = utils.isEmpty(watchedValues.fromRackLocation, true);
      const rackStocksByLocation = selectDisabled
        ? []
        : rackStocks.filter((rackStock) => rackStock.location.id === watchedValues.fromRackLocation);

      const rackStockOptions = makeStockDetailOptions(rackStocksByLocation);

      return (
        <Form.Item
          name="fromStockDetail"
          style={{ margin: 0 }}
          rules={[{ required: true, message: formRuleMsg.requiredSelect }]}
        >
          <Select {...commonSelectProps("상세 재고")} disabled={selectDisabled} options={rackStockOptions} />
        </Form.Item>
      );
    } else {
      return "-";
    }
  };

  const makeRackStockRemainQuantity = () => {
    if (lossSelectAvailable) {
      const { rackStocks, stocks, watchedValues } = forLoss;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.stockDetail &&
          rackStock?.location?.id === watchedValues.rackLocation
      );

      const value = isFbv ? stocks[0].quantity : selectedRackStock?.remainQuantity;

      return (
        <Typography.Text strong type="danger">
          <NumberComponent value={value} />
        </Typography.Text>
      );
    } else if (moveSelectAvailable) {
      const { rackStock } = forMove;

      return (
        <>
          <Form.Item noStyle name="fromQuantity" hidden>
            <InputNumber />
          </Form.Item>
          <Typography.Text strong type="danger">
            <NumberComponent value={rackStock?.remainQuantity} />
          </Typography.Text>
        </>
      );
    } else if (divideOrCombineSelectAvailable) {
      const { rackStocks, watchedValues } = forDivideOrCombine;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.fromStockDetail &&
          rackStock?.location?.id === watchedValues.fromRackLocation
      );

      return (
        <Typography.Text strong type="danger">
          <NumberComponent value={selectedRackStock?.remainQuantity} />
        </Typography.Text>
      );
    } else {
      return 0;
    }
  };

  const makeRackStockExpDate = () => {
    if (lossSelectAvailable) {
      const { rackStocks, watchedValues } = forLoss;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.stockDetail &&
          rackStock?.location?.id === watchedValues.rackLocation
      );

      return (
        <Typography.Text strong>
          {getDateByFormat(selectedRackStock?.stockDetail?.expDate, onlyDateFormat)}
        </Typography.Text>
      );
    } else if (moveSelectAvailable) {
      const { rackStock } = forMove;

      return (
        <Typography.Text strong>{getDateByFormat(rackStock?.stockDetail?.expDate, onlyDateFormat)}</Typography.Text>
      );
    } else if (divideOrCombineSelectAvailable) {
      const { rackStocks, watchedValues } = forDivideOrCombine;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.fromStockDetail &&
          rackStock?.location?.id === watchedValues.fromRackLocation
      );

      return (
        <Typography.Text strong>
          {getDateByFormat(selectedRackStock?.stockDetail?.expDate, onlyDateFormat)}
        </Typography.Text>
      );
    } else {
      return "-";
    }
  };

  const makeRackStockExpDateStatus = () => {
    if (lossSelectAvailable) {
      const { rackStocks, watchedValues } = forLoss;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.stockDetail &&
          rackStock?.location?.id === watchedValues.rackLocation
      );
      const expDate = selectedRackStock?.stockDetail?.expDate;
      if (utils.isEmpty(expDate)) {
        return "-";
      }
      const expDateStatus = selectedRackStock?.stockDetail?.expDateStatus;
      return getExpDateStatusTag(expDateStatus);
    } else if (moveSelectAvailable) {
      const { rackStock } = forMove;
      const expDateStatus = rackStock?.stockDetail?.expDateStatus;
      const expDate = rackStock?.stockDetail?.expDate;
      if (utils.isEmpty(expDate)) {
        return "-";
      }
      return getExpDateStatusTag(expDateStatus);
    } else if (divideOrCombineSelectAvailable) {
      const { rackStocks, watchedValues } = forDivideOrCombine;
      const selectedRackStock = rackStocks.find(
        (rackStock) =>
          rackStock?.stockDetail?.id === watchedValues.fromStockDetail &&
          rackStock?.location?.id === watchedValues.fromRackLocation
      );
      const expDate = selectedRackStock?.stockDetail?.expDate;
      if (utils.isEmpty(expDate)) {
        return "-";
      }
      const expDateStatus = selectedRackStock?.stockDetail?.expDateStatus;
      return getExpDateStatusTag(expDateStatus);
    } else {
      return "-";
    }
  };

  const showRackStockDetailUi = [
    StockListModalModeEnum.StockDetailLoss,
    StockListModalModeEnum.RackStockDetailMove,
    StockListModalModeEnum.StockDetailDivideOrCombine,
  ].includes(modalMode);

  return (
    <Descriptions
      bordered={!isMobile}
      size="small"
      layout="horizontal"
      title={descriptionTitle}
      column={2}
      labelStyle={{ width: isMobile ? 100 : 120 }}
    >
      {productInfo}
      {isFbv === false && (
        <Descriptions.Item label={columnNameConstant.stock.LOCATION} span={2}>
          {makeLocationItem()}
        </Descriptions.Item>
      )}
      {showRackStockDetailUi && (
        <>
          {isFbv === false && (
            <>
              <Descriptions.Item label="상세 재고" span={2}>
                {makeStockDetailItem()}
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.stock.EXP_DATE} span={isMobile ? 2 : 1}>
                {makeRackStockExpDate()}
              </Descriptions.Item>
              <Descriptions.Item label={columnNameConstant.stock.EXP_DATE_STATUS} span={isMobile ? 2 : 1}>
                {makeRackStockExpDateStatus()}
              </Descriptions.Item>
            </>
          )}
          <Descriptions.Item labelStyle={{ width: "120px" }} label={columnNameConstant.stock.STOCK_QUANTITY} span={2}>
            {makeRackStockRemainQuantity()}
          </Descriptions.Item>
          {moveSelectAvailable && (
            <Descriptions.Item label="메모" span={2}>
              <RackStockDetailMemoComponent rackStock={forMove.rackStock} />
            </Descriptions.Item>
          )}
        </>
      )}
    </Descriptions>
  );
};
</file>

<file path="src/app/views/product/stock/components/ProductVariantLabelPrintModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { SearchProductVariantsForLabel_search_edges_node } from "@src/api/searches/types/SearchProductVariantsForLabel";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { BarcodePrefixEnum, convertValueToBarcodeImgUrl } from "@utils/barcode/convertBarcode";
import { utils } from "@utils/utils";
import { wordDownload } from "@utils/word/wordDownload";
import { Button, Col, Form, Input, InputNumber, Modal, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { Document, ImageRun, ISectionOptions, Paragraph, TextRun } from "docx";
import React, { useEffect } from "react";

import { getLocationNameForLabel } from "../utils";

interface IProductVariantForm {
  sku: string;
  productName: string;
  locationName: string;
  labelQty: number;
}

interface IProductVariantLabelPrintForm {
  allLabelQty: number;
  productVariants: IProductVariantForm[];
}

interface ProductVariantLabelPrintModalProps {
  open: boolean;
  loading: boolean;
  productVariants: SearchProductVariantsForLabel_search_edges_node[];
  onClose: () => void;
}

export const ProductVariantLabelPrintModal: React.FC<ProductVariantLabelPrintModalProps> = (props) => {
  const { open, loading, productVariants, onClose } = props;
  const [form] = Form.useForm<IProductVariantLabelPrintForm>();
  const allLabelQtyWatched = Form.useWatch("allLabelQty", form);

  const initialValues: IProductVariantLabelPrintForm = {
    allLabelQty: null,
    productVariants: productVariants.map((variant) => ({
      sku: variant.sku,
      productName: utils.trim(variant.product.name),
      locationName: getLocationNameForLabel({ productVariant: variant }),
      labelQty: null,
    })),
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
    if (productVariants.length === 0) {
      onClose();
    }
  }, [open]);

  const {
    product: { SKU, PRODUCT_NAME },
  } = columnNameConstant;
  const columns: ColumnsType<SearchProductVariantsForLabel_search_edges_node> = [
    {
      title: SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record, idx) => (
        <>
          <Form.Item name={[idx, "sku"]} hidden>
            <Input />
          </Form.Item>
          <Typography>{record.sku}</Typography>
        </>
      ),
    },
    {
      title: PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 150,
      render: (_, record, idx) => (
        <>
          <Form.Item name={[idx, "productName"]} hidden>
            <Input />
          </Form.Item>
          <Typography>{utils.trim(record.product.name)}</Typography>
        </>
      ),
    },
    {
      title: "출고 로케이션",
      key: "pickingLocation",
      align: "center",
      width: 120,
      render: (_, record, idx) => (
        <>
          <Form.Item name={[idx, "locationName"]} hidden>
            <Input />
          </Form.Item>
          <Typography>{getLocationNameForLabel({ productVariant: record })}</Typography>
        </>
      ),
    },
    {
      title: "라벨 수량",
      key: "labelQty",
      align: "right",
      width: 100,
      render: (_, _record, idx) => (
        <Form.Item
          name={[idx, "labelQty"]}
          style={{ margin: 0 }}
          rules={[{ required: true, type: "integer", min: 1, message: formRuleMsg.min(1) }]}
        >
          <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: "100%" }} />
        </Form.Item>
      ),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const onSubmit = async (formData: IProductVariantLabelPrintForm) => {
    const { productVariants } = formData;
    // productVariants의 labelQty 값만큼 productVariants 늘리기
    const expandedProductVariants: IProductVariantForm[] = productVariants.flatMap((variant) =>
      Array(variant.labelQty).fill(variant)
    );

    const sections = await Promise.all<ISectionOptions>(
      expandedProductVariants.map(async (variant) => {
        const { sku, productName, locationName } = variant;
        const barcodeImgUrl = await convertValueToBarcodeImgUrl({ value: sku, prefix: BarcodePrefixEnum.PRODUCT });
        const barcodeImage = new ImageRun({
          type: "png",
          data: barcodeImgUrl,
          transformation: { width: 150, height: 20 },
        });

        return {
          properties: {
            page: {
              size: { width: "53mm", height: "34mm" },
              margin: { top: "0.15cm", right: "0.2cm", bottom: "0.2cm", left: "0.2cm" },
            },
          },
          children: [
            new Paragraph({
              alignment: "center",
              children: [new TextRun({ text: sku, bold: true, size: "21pt" })],
            }),
            new Paragraph({
              alignment: "center",
              children: [barcodeImage],
            }),
            new Paragraph({
              spacing: { before: 80, after: 80 },
              children: [new TextRun({ text: productName, size: "7pt" })],
            }),
            new Paragraph({ alignment: "right", children: [new TextRun({ text: locationName, size: "7pt" })] }),
          ],
        };
      })
    );

    const doc = new Document({ sections });
    wordDownload({ title: "재고 라벨", doc });
    onClose();
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      width={700}
      title="재고 라벨 출력"
      confirmLoading={loading}
      okText="출력"
      onOk={form.submit}
      onCancel={onClose}
      maskClosable={false}
    >
      <Form
        name="product-variants-label-print-form"
        form={form}
        size="small"
        initialValues={initialValues}
        onFinish={onSubmit}
      >
        <Space direction="vertical">
          <Typography.Text strong type="warning">
            아래 리스트의 제품 라벨을 출력하기 위한 문서를 다운로드합니다.
          </Typography.Text>
          <Row justify="space-between">
            <Col>
              <Typography.Text strong>
                출력할 라벨 총 {<NumberComponent value={productVariants.length} postFix="종" />}
              </Typography.Text>
            </Col>
            <Col>
              <Input.Group compact>
                <Form.Item name="allLabelQty" label="라벨 수량 일괄 변경" style={{ margin: 0 }}>
                  <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: 100 }} />
                </Form.Item>
                <Button
                  type="default"
                  disabled={utils.isEmpty(allLabelQtyWatched)}
                  onClick={() => {
                    const allLabelQty = form.getFieldValue("allLabelQty");
                    const productVariants: IProductVariantForm[] = form.getFieldValue("productVariants");
                    const newProductVariants = productVariants.map((variant) => ({
                      ...variant,
                      labelQty: allLabelQty,
                    }));
                    form.setFieldsValue({ productVariants: newProductVariants });
                  }}
                >
                  적용
                </Button>
              </Input.Group>
            </Col>
          </Row>
          <Form.List name="productVariants">
            {() => (
              <Table
                {...commonTableProps}
                loading={loading}
                columns={columns}
                dataSource={productVariants}
                scroll={{ x: tableWidthSum, y: 500 }}
              />
            )}
          </Form.List>
        </Space>
      </Form>
    </Modal>
  );
};
</file>

<file path="src/app/views/product/stock/components/RackLocationAddOrUpdateModal.tsx">
import { RackLocationInput } from "@src/api/types/globalTypes";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { utils } from "@utils/utils";
import { Checkbox, Col, Descriptions, Divider, Form, Input, InputNumber, Modal, Row, Typography } from "antd";
import { useForm, useWatch } from "antd/lib/form/Form";
import React, { useEffect } from "react";

import {
  RackSectorList_rackSectors_edges_node,
  RackSectorList_rackSectors_edges_node_locations,
} from "../api/types/RackSectorList";

interface RackLocationAddOrUpdateModalProps {
  open: boolean;
  loading: boolean;
  isUpdateMode: boolean;
  rackSector: RackSectorList_rackSectors_edges_node;
  rackLocation: RackSectorList_rackSectors_edges_node_locations;
  onSubmit: (rackLocationInput: RackLocationInput) => void;
  onClose: () => void;
}

export const RackLocationAddOrUpdateModal: React.FC<RackLocationAddOrUpdateModalProps> = (props) => {
  const { open, loading, isUpdateMode, rackSector, rackLocation, onSubmit, onClose } = props;
  const [form] = useForm<RackLocationInput>();
  const initialValues: RackLocationInput = isUpdateMode
    ? {
        name: rackLocation?.name,
        canPicking: rackLocation?.canPicking,
        canStock: rackLocation?.canStock,
        canNotSellToCustomers: rackLocation?.canNotSellToCustomers,
        isInitialOrderDefault: rackLocation?.isInitialOrderDefault,
        isReorderDefault: rackLocation?.isReorderDefault,
        safetyPickingStock: rackLocation?.safetyPickingStock,
      }
    : {
        name: "",
        canPicking: false,
        canStock: false,
        canNotSellToCustomers: false,
        isInitialOrderDefault: false,
        isReorderDefault: false,
      };
  const nameWatched = useWatch("name", form);
  const canNotSellToCustomersWatched = useWatch("canNotSellToCustomers", form);

  // canNotSellToCustomersWatched가 true로 바뀐 경우, canPicking와 canStock를 false로 setting한다.
  useEffect(() => {
    if (canNotSellToCustomersWatched) {
      form.setFieldsValue({ canPicking: false, canStock: false });
    }
  }, [canNotSellToCustomersWatched]);

  useEffect(() => {
    form.resetFields();
  }, [open]);

  const modalTitle = isUpdateMode ? "로케이션 수정" : "로케이션 추가";
  const okText = isUpdateMode ? "수정" : "추가";

  return (
    <Modal
      forceRender
      destroyOnClose
      closable={false}
      open={open}
      title={modalTitle}
      cancelText="뒤로"
      okText={okText}
      onOk={form.submit}
      onCancel={onClose}
      okButtonProps={{ disabled: utils.isEmpty(nameWatched) || loading }}
      cancelButtonProps={{ disabled: loading }}
    >
      <Descriptions bordered size="small">
        <Descriptions.Item label="구역" contentStyle={{ width: "60%" }}>
          {rackSector?.name}
        </Descriptions.Item>
      </Descriptions>
      <Divider />
      <Form
        form={form}
        initialValues={initialValues}
        validateTrigger="onSubmit"
        layout="horizontal"
        labelCol={{ span: 6 }}
        wrapperCol={{ span: 18 }}
        name="rack-location-add-or-updateform"
        onFinish={onSubmit}
      >
        <Form.Item
          name="name"
          label="로케이션 이름"
          rules={[{ required: true, message: "로케이션 이름을 입력해 주세요." }]}
        >
          <Input />
        </Form.Item>
        <Form.Item label={columnNameConstant.stock.LOCATION_TYPE}>
          <Row>
            <Col xs={24} sm={24}>
              <Form.Item name="canNotSellToCustomers" valuePropName="checked" noStyle>
                <Checkbox>판매 제한</Checkbox>
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item name="canPicking" valuePropName="checked" noStyle>
                <Checkbox disabled={canNotSellToCustomersWatched}>피킹 가능</Checkbox>
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item name="canStock" valuePropName="checked" noStyle>
                <Checkbox disabled={canNotSellToCustomersWatched}>입고 가능</Checkbox>
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item name="isInitialOrderDefault" valuePropName="checked" noStyle>
                <Checkbox>초도발주 입고 기본값</Checkbox>
              </Form.Item>
            </Col>
            <Col xs={24} sm={12}>
              <Form.Item name="isReorderDefault" valuePropName="checked" noStyle>
                <Checkbox>재발주 입고 기본값</Checkbox>
              </Form.Item>
            </Col>
            <Col span={24}>
              <Typography.Text style={{ fontSize: "12px" }} type="warning">
                (초도발주, 재발주 입고 기본값은 각각 물류센터 중 1개만 허용)
              </Typography.Text>
            </Col>
          </Row>
        </Form.Item>
        <Form.Item name="safetyPickingStock" label={columnNameConstant.stock.BASELINE_STOCK_QTY}>
          <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
        </Form.Item>
      </Form>
    </Modal>
  );
};
