import * as ExcelJS from "exceljs";
import * as xlsx from "xlsx-js-style";

import { getExcelNumberFormat } from "./excelDownload";

// TODO: 추후 기존 xlsx-js-style 라이브러리를 exceljs로 대체하면서 기존 xlsx 유틸 제거 + exceljs 유틸 네이밍에서 ~ByExceljs 제거하는 리팩토링 작업 할 것.
// linesMaps에 대한 로직도 구현 후 주석 해제
// ============================= 이하 exceljs 이용한 유틸 =============================
interface IReplaceDataArrByMapByExceljs {
  worksheet: ExcelJS.Worksheet;
  dataMap: { [key: string]: any };
  // lineMaps: Array<{ [key: string]: any }>;
  // lineKey?: string;
}
export const replaceWorksheetDataArrByMapByExceljs = (props: IReplaceDataArrByMapByExceljs): ExcelJS.Worksheet => {
  // const { worksheet, dataMap, lineMaps, lineKey = "numIdx" } = props;
  const { worksheet, dataMap } = props;

  const dataMapKeyList = Object.keys(dataMap);

  worksheet.eachRow((row) => {
    row.eachCell((cell) => {
      const cellValue = cell.value?.toString();
      if (dataMapKeyList.includes(cellValue)) {
        const replacedValue = dataMap[cellValue];
        cell.value = replacedValue;
        cell.numFmt = getExcelNumberFormat(replacedValue);
      }
    });
  });

  return worksheet;
};
// ============================= 이상 exceljs 이용한 유틸 =============================

interface IExpandDataArrByLines {
  originWorksheet: xlsx.WorkSheet;
  dataArr: string[][]; // s3에서 가져온 양식을 csv 형태로 변환 후 split한 배열 ex) [ ["","",""], ["", "발 주 서", ""] ]
  lineCount: number; // 품목 로우 수 ex) 발주서에서 발주 품목 수
  lineKey?: string;
}
// lineCount(품목 로우 수)에 따라 dataArr의 품목 로우 수, 셀 머지, 로우 정보(높이) 복사
export const expandTemplateDataArrByLines = (
  props: IExpandDataArrByLines
): {
  expandedDataArr: string[][];
  expandedMerges: xlsx.Range[];
  expandedRowsInfo: xlsx.RowInfo[];
} => {
  const { dataArr, originWorksheet, lineCount, lineKey = "numIdx" } = props;
  const expandedDataArr: string[][] = [];
  const expandedMerges: xlsx.Range[] = [];
  const expandedRowsInfo: xlsx.RowInfo[] = [];

  dataArr.forEach((row, rowIdx) => {
    // 1. 품목 리스트 로우인 경우
    if (row.includes(lineKey)) {
      // 1-1. 품목 로우 수만큼 로우 복사
      const expandedLineRows = Array.from({ length: lineCount }, () => [...row]);
      expandedDataArr.push(...expandedLineRows);

      // 1-2. 셀 머지 추가 및 정리하여 한 번에 추가
      const originMerges = originWorksheet["!merges"] || [];
      const mergesBeforeLine = originMerges.filter((merge) => merge.s.r < rowIdx);
      const mergesAfterLine = originMerges.filter((merge) => merge.s.r > rowIdx);
      const lineMerges = originMerges.filter((merge) => merge.s.r === rowIdx);

      const shiftedMergesAfterLine = mergesAfterLine.map((merge) => {
        // 품목 아래 로우에 있는 셀(합계, 메모 등)에 대한 머지 처리 - 품목 수만큼 로우가 밀려나도록 수정
        const { s, e } = merge;
        const shiftedMerge = {
          s: { r: s.r + lineCount - 1, c: s.c },
          e: { r: e.r + lineCount - 1, c: e.c },
        };
        return shiftedMerge;
      });
      const expandedLineMerges = lineMerges.flatMap((merge) => {
        // 품목 로우에 대한 머지 처리 - 품목 로우 수만큼 품목 로우의 셀 머지 복사
        const { s, e } = merge;
        return Array.from({ length: lineCount }, (_, mergeIdx) => {
          const expandedMerge = { s: { r: s.r + mergeIdx, c: s.c }, e: { r: e.r + mergeIdx, c: e.c } };
          return expandedMerge;
        });
      });
      expandedMerges.push(...mergesBeforeLine, ...expandedLineMerges, ...shiftedMergesAfterLine);

      // 1-3. 해당 로우 및 추가되는 품목 로우만큼 로우 정보 제거
      const originRowsInfo = originWorksheet["!rows"];
      const rowsInfoBeforeLine = originRowsInfo.slice(0, rowIdx);
      const rowsInfoAfterLine = originRowsInfo.slice(rowIdx + 1);
      const lineRowsInfo = Array.from({ length: lineCount }, () => originRowsInfo[rowIdx]);
      expandedRowsInfo.push(...rowsInfoBeforeLine, ...lineRowsInfo, ...rowsInfoAfterLine);
    } else {
      // 2. 품목 외의 로우(상단 정보 또는 하단의 합계, 메모 영역)
      expandedDataArr.push(row);
    }
  });

  return { expandedDataArr, expandedMerges, expandedRowsInfo };
};

interface IReplaceDataArrByMapping {
  dataArr: string[][];
  dataMap: { [key: string]: any };
  lineMaps: Array<{ [key: string]: any }>;
  lineKey?: string;
}
export const replaceTemplateDataArrByMap = (props: IReplaceDataArrByMapping): string[][] => {
  const { dataArr, dataMap, lineMaps, lineKey = "numIdx" } = props;
  let currentLineNo = 0;
  let isInLineSection = false;

  const replacedDataArr = dataArr.map((row, rowIndex) => {
    // 품목 섹션 시작 감지
    if (row.includes(lineKey)) {
      isInLineSection = true;
      const lineMapping = lineMaps[currentLineNo];
      const replacedRow = row.map((cell, cellIndex) => {
        const key = cell.trim();
        // 템플릿 변수가 있는 경우에만 매핑
        if (lineMapping && lineMapping.hasOwnProperty(key)) {
          return lineMapping[key];
        }
        // 첫 10개 열까지는 유지, 그 이후는 빈 문자열로 (예시 데이터 제거)
        if (cellIndex >= 10) {
          return "";
        }
        // 템플릿 변수가 아닌 셀은 빈 문자열로
        return "";
      });
      currentLineNo++;
      return replacedRow;
    } else if (isInLineSection && row.includes("합 계")) {
      // 합계 행 처리
      isInLineSection = false;
      const replacedRow = row.map((cell, cellIndex) => {
        const key = cell.trim();
        if (dataMap.hasOwnProperty(key)) {
          return dataMap[key];
        }
        // 첫 10개 열까지는 유지, 그 이후는 빈 문자열로
        if (cellIndex >= 10) {
          return "";
        }
        return cell;
      });
      return replacedRow;
    } else {
      const replacedRow = row.map((cell) => {
        let replacedCell = cell;

        // 템플릿 변수 직접 치환
        const key = cell.trim();
        if (dataMap.hasOwnProperty(key)) {
          return dataMap[key];
        }

        // 괄호 안의 변수 패턴 치환 (예: ( month ) -> ( 2025-07 ))
        Object.keys(dataMap).forEach((varKey) => {
          const pattern = new RegExp(`\\(\\s*${varKey}\\s*\\)`, "g");
          if (pattern.test(replacedCell)) {
            replacedCell = replacedCell.replace(pattern, `( ${dataMap[varKey]} )`);
          }
        });

        return replacedCell;
      });
      return replacedRow;
    }
  });

  return replacedDataArr;
};

export const applyXlsxCellStyle = (
  styleProps: {
    alignVertical?: "top" | "center" | "bottom";
    bold?: boolean;
    fontSize?: number;
    fillColor?: string;
    border?: {
      strong?: boolean;
      directions: Array<"top" | "bottom" | "left" | "right">;
    };
  },
  cellStyle: { [key: string]: any }
): { [key: string]: any } => {
  const { alignVertical, bold, fontSize, border, fillColor } = styleProps;
  if (alignVertical) {
    cellStyle = { ...cellStyle, alignment: { ...cellStyle.alignment, vertical: alignVertical } };
  }
  if (bold) {
    cellStyle = { ...cellStyle, font: { ...cellStyle.font, bold: true } };
  }
  if (fontSize) {
    cellStyle = { ...cellStyle, font: { ...cellStyle.font, sz: fontSize } };
  }
  if (fillColor) {
    cellStyle = { ...cellStyle, fill: { ...cellStyle.fill, fgColor: { rgb: fillColor } } };
  }
  if (border) {
    border.directions.forEach((direction) => {
      cellStyle = {
        ...cellStyle,
        border: {
          ...cellStyle.border,
          [direction]: { style: border.strong ? "medium" : "thin", color: { rgb: "000000" } },
        },
      };
    });
  }
  return { ...cellStyle };
};
