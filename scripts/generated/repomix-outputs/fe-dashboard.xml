      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    deliveryStartDate: getGteLteVariables({
      gte: params.deliveryStartDateFrom,
      lte: params.deliveryStartDateTo,
    }),
    deliveryEndDate: getGteLteVariables({
      gte: params.deliveryEndDateFrom,
      lte: params.deliveryEndDateTo,
    }),
    orderSearch: params.orderSearch,
    b2bOrderSearch: params.b2bOrderSearch,
    paymentSearch: params.paymentSearch,
    userSearch: params.userSearch,
    brandSearch: params.brandSearch,
    brandStoreSearch: params.brandStoreSearch,
    productSearch: params.productSearch,
    fulfillVendorSearch: params.fulfillVendorSearch,
    isFulfilledByVendor: params.isNonFBV !== undefined ? parseBoolean(params.isNonFBV, false) === false : undefined,
