import useModalDialogErrors from "@hooks/useModalDialogErrors";
import Button from "@material-ui/core/Button";
import Dialog from "@material-ui/core/Dialog";
import DialogActions from "@material-ui/core/DialogActions";
import DialogContent from "@material-ui/core/DialogContent";
import DialogTitle from "@material-ui/core/DialogTitle";
import TextField from "@material-ui/core/TextField";
import { AccountErrorFragment } from "@src/api/fragments/types/AccountErrorFragment";
import ConfirmButton, { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import FormSpacer from "@src/app/components/FormSpacer";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { getFormErrors } from "@src/global/assets/messages/errors";
import { DialogProps } from "@src/global/core/types/types";
import { makeGqlErrorMsg } from "@utils/notification/wrapperGql";
import React from "react";

interface StaffPasswordResetDialogFormData {
  newPassword: string;
  oldPassword: string;
}
export interface StaffPasswordResetDialogProps extends DialogProps {
  confirmButtonState: ConfirmButtonTransitionState;
  errors: AccountErrorFragment[];
  onSubmit: (data: StaffPasswordResetDialogFormData) => void;
}

const initialForm: StaffPasswordResetDialogFormData = {
  newPassword: "",
  oldPassword: "",
};

const StaffPasswordResetDialog: React.FC<StaffPasswordResetDialogProps> = ({
  confirmButtonState,
  errors,
  open,
  onClose,
  onSubmit,
}) => {
  const dialogErrors = useModalDialogErrors(errors, open);

  const formErrors = getFormErrors(["oldPassword", "newPassword"], dialogErrors);

  return (
    <Dialog onClose={onClose} open={open} fullWidth maxWidth="sm">
      <DialogTitle>비밀번호 변경</DialogTitle>
      <Form initial={initialForm} onSubmit={onSubmit}>
        {({ change, data }) => (
          <>
            <DialogContent>
              <TextField
                error={!!formErrors.oldPassword}
                fullWidth
                helperText={makeGqlErrorMsg(formErrors.oldPassword)}
                label="이전 비밀번호"
                name="oldPassword"
                type="password"
                onChange={change}
              />
              <FormSpacer />
              <TextField
                error={!!formErrors.newPassword}
                fullWidth
                helperText={makeGqlErrorMsg(formErrors.newPassword) || "비밀번호는 8자 이상이어야 합니다."}
                label="새 비밀번호"
                name="newPassword"
                type="password"
                onChange={change}
              />
            </DialogContent>
            <DialogActions>
              <Button onClick={onClose}>{buttonText.back}</Button>
              <ConfirmButton
                disabled={data.newPassword.length < 8}
                transitionState={confirmButtonState}
                color="primary"
                variant="contained"
                type="submit"
              >
                {buttonText.save}
              </ConfirmButton>
            </DialogActions>
          </>
        )}
      </Form>
    </Dialog>
  );
};

export default StaffPasswordResetDialog;
</file>

