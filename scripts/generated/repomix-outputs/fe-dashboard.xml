import { User } from "@src/api/fragments/types/User";
import {
  DigitalContractCountEventFilterInput,
  DigitalContractCountEventTypeEnum,
  PaidNoticeCountEventTypeEnum,
} from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  dedupeFilter,
  getGteLteVariables,
  getMinMaxQueryParam,
  getMultipleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { checkHqStaff, findInEnum, findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  DigitalContractCountEventFilterKeys,
  DigitalContractCountEventListFilterOpts,
} from "../../components/DigitalContractCountEventListPage/filters";
import {
  DigitalContractCountEventListViewUrlFilters,
  DigitalContractCountEventListViewUrlFiltersEnum,
  DigitalContractCountEventListViewUrlFiltersWithMultipleValuesEnum,
  DigitalContractCountEventListViewUrlQueryParams,
} from "../../urls";

const DEV_COST_EVENT_FILTERS_KEY = "devCostEventFilters";

export function getFilterOpts(
  params: DigitalContractCountEventListViewUrlFilters,
  user: User
): DigitalContractCountEventListFilterOpts {
  const filterVariables = getFilterVariables(params, user);
  const todayMoment = moment();

  return {
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(
        () =>
          dedupeFilter(filterVariables.type.map((type) => findValueInEnum(type, DigitalContractCountEventTypeEnum))),
        []
      ),
    },
  };
}

export function getFilterVariables(
  params: DigitalContractCountEventListViewUrlFilters,
  user: User
): DigitalContractCountEventFilterInput {
  const isHqStaff = checkHqStaff(user);
  return {
    brandSearch: params.brandSearch !== undefined ? params.brandSearch : null,
    brand: isHqStaff ? user.brand.id : null,
    created: getGteLteVariables({
      gte: params.createdFrom,
      lte: params.createdTo,
    }),
    type: maybe(() => params.type.map((type) => findInEnum(type, DigitalContractCountEventTypeEnum)), []),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<DigitalContractCountEventFilterKeys>
): DigitalContractCountEventListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case DigitalContractCountEventFilterKeys.type:
      return getMultipleEnumValueQueryParam(
        filter,
        DigitalContractCountEventListViewUrlFiltersWithMultipleValuesEnum.type,
        PaidNoticeCountEventTypeEnum
      );
    case DigitalContractCountEventFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, DigitalContractCountEventListViewUrlFiltersEnum.brandSearch);
    case DigitalContractCountEventFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        DigitalContractCountEventListViewUrlFiltersEnum.createdFrom,
        DigitalContractCountEventListViewUrlFiltersEnum.createdTo
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<DigitalContractCountEventListViewUrlFilters>(DEV_COST_EVENT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  DigitalContractCountEventListViewUrlQueryParams,
  DigitalContractCountEventListViewUrlFilters
>({ ...DigitalContractCountEventListViewUrlFiltersEnum });
</file>

