    },
    renderExcel: (record) => getPurchaseOrderEventTypeText(record.purchaseOrderLine.purchaseOrder.eventType, isB2b),
  };

  const actionColumn: DownloadableColumnType<OrderLineList_orderLines_edges_node> = {
