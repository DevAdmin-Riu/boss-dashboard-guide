import { ISorter } from "@src/app/components/SorterDropdown/types";

import { PageListViewUrlSortField } from "../../urls";

export function createSorterStructure(): ISorter<PageListViewUrlSortField> {
  let displayOrder = 0;
  return [
    {
      displayOrder: displayOrder++,
      label: "제목",
      sortField: PageListViewUrlSortField.title,
