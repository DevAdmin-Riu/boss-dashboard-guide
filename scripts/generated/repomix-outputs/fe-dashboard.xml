import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { BrandProductPackageListFragment } from "@src/api/fragments/types/BrandProductPackageListFragment";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { Container } from "@src/app/components/Container";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Space } from "antd";
import React from "react";
import { useParams } from "react-router";

import { BrandProductPackages, BrandProductPackagesVariables, useBrandProductPackageQuery } from "../../api/queries";
import { HqInfoProductListViewRouteParams } from "../../urls";
import { makeHqInfoProductPageTypeSwapUi } from "../HqInfoProductPage/HqInfoProductPage";
import { createFilterStructure, HqInfoPackageFilterKeys, HqInfoPackageFilterOpts } from "./filters";
import { getHqPackageTableColumns } from "./HqInfoPackageTableSettings";
import PackageCompositionModal from "./PackageCompositionModal";

interface HqInfoPackagePageProps
  extends PaginateListProps,
    FilterPageProps<HqInfoPackageFilterKeys, HqInfoPackageFilterOpts> {
  packages: BrandProductPackageListFragment[];
  queryVariablesWithoutPagination: BrandProductPackagesVariables;
  fetchForDownload: (
    variables?: Partial<BrandProductPackagesVariables>
  ) => Promise<ApolloQueryResult<BrandProductPackages>>;
}

const HqInfoPackagePage: React.FC<HqInfoPackagePageProps> = (props) => {
  const {
    packages,
    currencySymbol,
    currentTab,
    filterOpts,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    fetchForDownload,
    queryVariablesWithoutPagination,
    ...listProps
  } = props;
  const { pageType } = useParams<HqInfoProductListViewRouteParams>();
  const [selectedPackageId, setSelectedPackageId] = React.useState<string | null>(null);

  // 패키지 상세 조회 쿼리
  const { data: packageDetailData } = useBrandProductPackageQuery({
    variables: { id: selectedPackageId },
    skip: !selectedPackageId,
  });

  const filterStructure = createFilterStructure(filterOpts);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  // 구성품 보기 버튼 클릭 핸들러
  const handleViewComposition = (packageId: string) => {
    setSelectedPackageId(packageId);
  };

  // 모달 닫기 핸들러
  const handleCloseModal = () => {
    setSelectedPackageId(null);
  };

  const columns = getHqPackageTableColumns({ onViewComposition: handleViewComposition });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: columns,
    dataKey: "brandProductPackages",
  };

  return (
    <Container>
      <Space direction="vertical" size={24} style={{ width: "100%" }}>
        {makeHqInfoProductPageTypeSwapUi(pageType)}
        <Card>
          <SpreadFilterBar
            currencySymbol={currencySymbol}
            currentTab={currentTab}
            filterStructure={filterStructure}
            tabs={tabs}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            isDownloadable
            excelDownloadProps={excelDownloadProps}
          />
          <PatchedColumnsTable
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={columns}
            dataSource={packages}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
      <PackageCompositionModal
        visible={!!selectedPackageId}
        packageData={packageDetailData?.brandProductPackage || null}
        onClose={handleCloseModal}
      />
    </Container>
  );
};

export default HqInfoPackagePage;
</file>

