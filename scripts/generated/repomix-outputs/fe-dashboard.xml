                  <DItem labelStyle={{ backgroundColor: "#EEEEB0" }} label="기타 개발비(ⓕ)">
                    <ReqBossDevCostTooltip
                      label="기타"
                      unitCost={estimate.etcUnitDevCostExcludeVat}
                      qty={estimate.etcQtyForDevCost}
                    />
                  </DItem>
                  <DItem
                    labelStyle={{
                      backgroundColor: "#EEEEB0",
                      borderTop: "1px solid #EEEEB0",
                      borderRight: "1px solid #EEEEB0",
                    }}
                    contentStyle={{ borderTop: "1px solid #fff" }}
                    label=""
                    span={2}
                  >
                    {""}
                  </DItem>
                  {brandDevCostInfo()}
                </>
              )}
            </>
          )}

          {!isStaff && isBrandDevCostInfoVisibleByStatus && brandDevCostInfo()}
          {open && (
            <>
              <DItem label="기타 참고 사항 (메모)" span={5}>
                {estimate.etcMemo || emptyText}
              </DItem>
              {isStaff && (
                <DItem label="첨부 자료" span={5}>
                  {utils.isEmpty(estimate?.fileUrl, true) ? (
                    "없음"
                  ) : (
                    <Typography>
                      파일명: <Typography.Link href={estimate?.fileUrl}>{estimate?.fileName || "-"}</Typography.Link>
                    </Typography>
                  )}
                </DItem>
              )}
            </>
          )}
        </Descriptions>

        {estimate.isPicked &&
          utils.isEmpty(request?.mallProductPriceExcludeVat) === false &&
          request.mallProductPriceExcludeVat > 0 && (
            <Descriptions
              bordered
              size="small"
              layout={isMobile ? "vertical" : "horizontal"}
              labelStyle={{ width: "20%" }}
            >
              <Descriptions.Item label="매장 판매가" labelStyle={{ backgroundColor: "#E0EBF6" }}>
                <NumberComponent value={request.mallProductPriceExcludeVat} />
              </Descriptions.Item>
            </Descriptions>
          )}
      </Space>
    </>
  );
};
