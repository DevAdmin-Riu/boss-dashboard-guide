import useAddressValidation from "@hooks/useAddressValidation";
import { SubmitPromise } from "@hooks/useForm";
import useStateFromProps from "@hooks/useStateFromProps";
import { ShopErrorFragment } from "@src/api/fragments/types/ShopErrorFragment";
import { AddressInput } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import CompanyAddressInput from "@src/app/components/CompanyAddressInput";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import createSingleAutocompleteSelectHandler from "@utils/handlers/singleAutocompleteSelectChangeHandler";
import { mapCountriesToChoices } from "@utils/maps";
import { maybe, transformAddressToForm } from "@utils/misc";
import { Divider, Space, Typography } from "antd";
import React from "react";

import { SiteSettings_shop } from "../../api/types/SiteSettings";
import { SiteSettingsViewUrlDialog, SiteSettingsViewUrlQueryParams } from "../../urls";
import DirectShipping from "../DirectShipping";
import SiteSettingsDetails from "../SiteSettingsDetails/SiteSettingsDetails";
import SiteSettingsMailing, { SiteSettingsMailingFormData } from "../SiteSettingsMailing";
import SiteSettingsMobileAppInfo from "../SiteSettingsMobileAppInfo";

export interface DirectShippingPageFormData {
  dsMinimumOrderPrice: number;
  directShippingAvailableEndDate: any | null;
}

export interface SiteSettingsPageFormData
  extends AddressInput,
    SiteSettingsMailingFormData,
    DirectShippingPageFormData {
  description: string;
  domain: string;
  name: string;
}

interface SiteSettingsPageProps {
  disabled: boolean;
  errors: ShopErrorFragment[];
  shop: SiteSettings_shop;
  saveButtonBarState: ConfirmButtonTransitionState;
  onModalOpen: (action: SiteSettingsViewUrlDialog, newParams?: SiteSettingsViewUrlQueryParams) => void;
  onBack: () => void;
  onSubmit: (data: SiteSettingsPageFormData) => SubmitPromise;
}

export function areAddressInputFieldsModified(data: AddressInput): boolean {
  return (
    ["city", "country", "countryArea", "phone", "postalCode", "streetAddress1", "streetAddress2"] as Array<
      keyof AddressInput
    >
  )
    .map((key) => data[key])
    .some((field) => field !== "");
}

const SiteSettingsPage: React.FC<SiteSettingsPageProps> = (props) => {
  const { disabled, errors, saveButtonBarState, shop, onModalOpen, onBack, onSubmit } = props;
  const [displayCountry, setDisplayCountry] = useStateFromProps(maybe(() => shop.companyAddress.country.code, ""));
  const { errors: validationErrors, submit: handleSubmitWithAddress } = useAddressValidation(onSubmit);

  const initialFormAddress = transformAddressToForm(shop?.companyAddress);
  const initialForm: SiteSettingsPageFormData = {
    ...initialFormAddress,
    customerSetPasswordUrl: maybe(() => shop.customerSetPasswordUrl, ""),
    description: maybe(() => shop.description, ""),
    domain: maybe(() => shop.domain.host, ""),
    name: maybe(() => shop.name, ""),
    dsMinimumOrderPrice: 0,
    directShippingAvailableEndDate: maybe(() => shop.directShippingAvailableEndDate, null),
  };

  return (
    <Form
      initial={initialForm}
      onSubmit={(data) => {
        const submitFunc = areAddressInputFieldsModified(data) ? handleSubmitWithAddress : onSubmit;
        return submitFunc(data);
      }}
      confirmLeave
    >
      {({ change, data, hasChanged, submit }) => {
        const countryChoices = mapCountriesToChoices(shop?.shippingCountries || []);
        const handleCountryChange = createSingleAutocompleteSelectHandler(change, setDisplayCountry, countryChoices);

        return (
          <>
            <AppHeader onBack={onBack}>{sectionNames.configuration}</AppHeader>
            <PageHeader title="사이트 기본 정보" />
            <Grid variant="inverted" split={<Divider />}>
              <Space direction={"vertical"}>
                <Typography.Title level={5}>{sectionNames.siteSettings}</Typography.Title>
                <Typography.Text type={"secondary"}>
                  브랜드몰의 기본 정보를 설정합니다. 브랜드몰의 URL 및 웹브라우저에 표시될 이름을 설정할 수 있습니다.
                </Typography.Text>
              </Space>
              <SiteSettingsDetails data={data} errors={errors} disabled={disabled} onChange={change} />

              <Space direction={"vertical"}>
                <Typography.Title level={5}>메일 설정</Typography.Title>
              </Space>
              <SiteSettingsMailing data={data} errors={errors} disabled={disabled} onChange={change} />

              <Space direction={"vertical"}>
                <Typography.Title level={5}>회사 정보</Typography.Title>
              </Space>
              <CompanyAddressInput
                data={data}
                displayCountry={displayCountry}
                countries={countryChoices}
                errors={[...errors, ...validationErrors]}
                disabled={disabled}
                header="회사 정보"
                onChange={change}
                onCountryChange={handleCountryChange}
              />

              <Space direction={"vertical"}>
                <Typography.Title level={5}>직배송 설정</Typography.Title>
                <Typography.Text type={"secondary"}>
                  직배송 업체(현재 웰스토리)의 최소 주문 금액 정보를 저장합니다.
                </Typography.Text>
              </Space>
              <DirectShipping data={data} errors={errors} disabled={disabled} onChange={change} />

              <Space direction={"vertical"}>
                <Typography.Title level={5}>모바일 앱 설정</Typography.Title>
                <Typography.Text type={"secondary"}>
                  포장보스 모바일 앱 업데이트 버전 및 알림, 딥링크, 앱 스토어 링크에 대한 정보를 저장합니다.
                </Typography.Text>
              </Space>
              <SiteSettingsMobileAppInfo disabled={disabled} shop={shop} onModalOpen={onModalOpen} />
            </Grid>
            <SaveButtonBar
              state={saveButtonBarState}
              disabled={disabled || !hasChanged}
              onCancel={onBack}
              onSave={submit}
            />
          </>
        );
      }}
    </Form>
  );
};

export default SiteSettingsPage;
</file>

