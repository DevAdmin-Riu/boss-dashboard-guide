import { AccountErrorFragment } from "@src/api/fragments/types/AccountErrorFragment";
import { AccountErrorCode, AddressInput } from "@src/api/types/globalTypes";
import { add, remove } from "@utils/lists";
import { transformAddressInputFromForm } from "@utils/misc";
import { useState } from "react";

export type AddressFormData = AddressInput;

interface UseAddressValidation<TInput, TOutput> {
  errors: AccountErrorFragment[];
  submit: (data: TInput & AddressFormData) => TOutput;
}

function useAddressValidation<TInput, TOutput>(
  onSubmit: (address: TInput & AddressInput) => TOutput
): UseAddressValidation<TInput, TOutput> {
  const [validationErrors, setValidationErrors] = useState<AccountErrorFragment[]>([]);

  const countryRequiredError: AccountErrorFragment = {
    __typename: "AccountError",
    code: AccountErrorCode.REQUIRED,
    message: AccountErrorCode.REQUIRED,
    field: "country",
  };

  return {
    errors: validationErrors,
    submit: (data: TInput & AddressFormData) => {
      try {
        setValidationErrors(remove(countryRequiredError, validationErrors, (a, b) => a.field === b.field));
        return onSubmit(transformAddressInputFromForm(data));
      } catch {
        setValidationErrors(add(countryRequiredError, validationErrors));
      }
    },
  };
}

export default useAddressValidation;
</file>

