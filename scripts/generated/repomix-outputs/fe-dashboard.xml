const HQ_PRE_FOUNDER_STAT_FILTERS_KEY = "hqPreFounderStatFilters";

export function getFilterOpts(params: HqPreFounderStatListViewUrlFilters): HqPreFounderStatListFilterOpts {
  const filterVariables = getFilterVariables(params);

  return {
    dimension: {
      active: maybe(() => !utils.isEmpty(filterVariables.dimension, true), false),
      value: maybe(() => findValueInEnum(filterVariables.dimension, PreFounderStatsDimensionEnum), undefined),
    },
    statDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.statDate.gte, filterVariables.statDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.statDate.lte, undefined),
        min: maybe(() => filterVariables.statDate.gte, undefined),
      },
    },
  };
}

export function getFilterVariables(params: HqPreFounderStatListViewUrlFilters): HqPreFounderStatListVariables {
  return {
    dimension: maybe(
      () => findInEnum(params.dimension, PreFounderStatsDimensionEnum),
      PreFounderStatsDimensionEnum.SOURCE
    ),
    statDate: getGteLteVariablesForMonth({ gte: params.statDateFrom, lte: params.statDateTo }),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<keyof HqPreFounderStatListFilterOpts>
): HqPreFounderStatListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case HqPreFounderStatListFilterKeys.dimension:
      return getSingleValueQueryParam(filter, HqPreFounderStatListViewUrlFiltersEnum.dimension);
    case HqPreFounderStatListFilterKeys.statDate:
      return getMinMaxQueryParam(
        filter,
        HqPreFounderStatListViewUrlFiltersEnum.statDateFrom,
        HqPreFounderStatListViewUrlFiltersEnum.statDateTo
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
