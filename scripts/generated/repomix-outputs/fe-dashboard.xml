  hqPreFounderConsultationDetailsViewUrl,
  hqPreFounderListViewUrl,
} from "../urls";
import { cleanPreFounderBasicDocumentsObj } from "../utils";
import { IPreFounderInfoFromDetailsPage } from "./HqPreFounderConsultationCreateView";

export enum HqPreFounderEditModeEnum {
  UpdateBasicInfo = "UpdateBasicInfo",
  UpdateContractInfo = "UpdateContractInfo",
  UpdateEvalInfo = "UpdateEvalInfo",
}

export enum HqPreFounderModalModeEnum {
  CreateBrandStore = "CreateBrandStore",
}

interface HqPreFounderDetailsViewProps {
  id: string;
}

export const HqPreFounderDetailsView: React.FC<HqPreFounderDetailsViewProps> = ({ id }) => {
  const { user } = useUser();
  const navigate = useNavigator();
  const [editMode, setEditMode] = useState<HqPreFounderEditModeEnum>(null);
  const [modalMode, setModalMode] = useState<HqPreFounderModalModeEnum>(null);

  const onEdit = (mode: HqPreFounderEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };
  const onModalOpen = (mode: HqPreFounderModalModeEnum, id?: string) => {
    setModalMode(mode);
  };
  const onModalClose = () => {
    setModalMode(null);
  };
  const handleBack = () => {
    navigate(hqPreFounderListViewUrl());
  };

  const { data, loading } = useHqPreFounderDetailsQuery({ variables: { id } });
  const preFounder = maybe(() => data.preFounder, null);

  const { data: evalItemListData } = usePreFounderEvalItemListQuery({
    skip: utils.isEmpty(user?.brand),
    variables: { brandId: user.brand.id },
  });
  const evalItemList = maybe(() => evalItemListData.preFounderEvalItemList, []);

  const [preFounderBasicInfoUpdate] = usePreFounderBasicInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.preFounderBasicInfoUpdate.errors,
        "기본 정보가 수정되었습니다.",
        onEditCancel
      ),
  });

  const [preFounderContractInfoUpdate] = usePreFounderContractInfoUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.preFounderContractInfoUpdate.errors,
        "계약 정보가 수정되었습니다.",
        onEditCancel
      ),
  });

  const [preFounderEvalAnswerBulkUpsert] = usePreFounderEvalAnswerBulkUpsertMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(
        data.preFounderEvalAnswerBulkUpsert.errors,
        "평가 정보가 수정되었습니다.",
        onEditCancel
      ),
  });

  const handleBasicInfoUpdate = (formData: IPreFounderBasicInfoUpdateFormData) => {
    const cleanedBasicDocumentsObjInput = cleanPreFounderBasicDocumentsObj(formData) as PreFounderBasicInfoUpdateInput;
    const address = utils.allEmpty(Object.values(formData?.address)) ? undefined : formData?.address;

    const input: PreFounderBasicInfoUpdateInput = { ...cleanedBasicDocumentsObjInput, address };
    preFounderBasicInfoUpdate({ variables: { id, input } });
  };

  const handleContractInfoUpdate = (formData: IPreFounderContractInfoUpdateFormData) => {
    const cleanedContractDocumentsObjInput = cleanFranchiseDocumentsObj(formData);

    const input: PreFounderContractInfoUpdateInput = { ...cleanedContractDocumentsObjInput };
    preFounderContractInfoUpdate({ variables: { id, input } });
  };

  const handleEvalAnswerBulkUpsert = (formData: TPreFounderEvalAnswerBulkUpsertFormData) => {
    const { details } = formData;
    const touchedDetails = details.filter((detail) => {
      const keyList = Object.keys(detail) as Array<keyof typeof detail>;
      // item 외의 필드 중 하나라도 값이 있으면 뮤테이션에 전달
      return keyList.filter((key) => key !== "item").some((key) => detail[key] !== undefined);
    });
    preFounderEvalAnswerBulkUpsert({ variables: { preFounder: preFounder.id, details: touchedDetails } });
  };

  if (loading) {
    return <Loader />;
  }

  return (
    <>
      <HqPreFounderDetailsPage
        preFounder={preFounder}
        evalItemList={evalItemList}
        editMode={editMode}
        onEdit={onEdit}
        onEditCancel={onEditCancel}
        onBasicInfoUpdate={handleBasicInfoUpdate}
        onContractInfoUpdate={handleContractInfoUpdate}
        onEvalAnswerBulkUpsert={handleEvalAnswerBulkUpsert}
        onConsultationCreate={() => {
          const preFounderInfoForConsultationCreate: IPreFounderInfoFromDetailsPage = {
            id: preFounder.id,
            name: preFounder.name,
          };
          navigate(hqPreFounderConsultationCreateViewUrl(), undefined, undefined, preFounderInfoForConsultationCreate);
        }}
        onConsultationUpdate={(id) => navigate(hqPreFounderConsultationDetailsViewUrl(id))}
        onBrandStoreCreate={() => onModalOpen(HqPreFounderModalModeEnum.CreateBrandStore)}
        onBack={handleBack}
      />
      <BrandStoreCreateModal
        brandId={user?.brand?.id}
        preFounder={preFounder}
        open={modalMode === HqPreFounderModalModeEnum.CreateBrandStore}
        onClose={onModalClose}
      />
    </>
  );
};
</file>

