import {
  getPurchaseProductIsTaxFree,
  getPurchaseProductName,
  getPurchaseTypeTagColor,
  getPurchaseVariantName,
  getPurchaseVendorCode,
  getPurchaseVendorName,
  isTakeBackType,
  makePurchaseB2bDeliveryFeeExcludeVat,
  makePurchaseConsignmentUnitDeliveryAdditionalFeeExcludeVat,
  makePurchaseCostPriceExcludeVat,
  makePurchaseDeliveryFeeExcludeVat,
