import Button from "@material-ui/core/Button";
import Card from "@material-ui/core/Card";
import CardContent from "@material-ui/core/CardContent";
import { makeStyles } from "@material-ui/core/styles";
import CardTitle from "@src/app/components/CardTitle";
import ImageTile from "@src/app/components/ImageTile";
import ImageUpload from "@src/app/components/ImageUpload";
import { ShopInfoForProductCommonImages_shop_productCommonImages } from "@src/app/views/notice/productCi/api/types/ShopInfoForProductCommonImages";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { ReorderAction } from "@src/global/core/types/types";
import createMultiFileUploadHandler from "@utils/handlers/multiFileUploadHandler";
import classNames from "classnames";
import React from "react";
import { SortableContainer, SortableElement } from "react-sortable-hoc";

import { ProductDetails_product_images } from "../api/types/ProductDetails";

const useStyles = makeStyles(
  (theme) => ({
    fileField: {
      display: "none",
    },
    icon: {
      color: "rgba(255, 255, 255, 0.54)",
    },
    image: {
      height: "100%",
      objectFit: "contain",
      userSelect: "none",
      width: "100%",
    },
    imageContainer: {
      "&:hover, &.dragged": {
        "& $imageOverlay": {
          display: "block",
        },
      },
      background: "#ffffff",
      border: "1px solid #eaeaea",
      borderRadius: theme.spacing(),
      height: 140,
      margin: "auto",
      overflow: "hidden",
      padding: theme.spacing(2),
      position: "relative",
      width: 140,
    },
    imageGridContainer: {
      position: "relative",
    },
    imageOverlay: {
      background: "rgba(0, 0, 0, 0.6)",
      cursor: "move",
      display: "none",
      height: 140,
      left: 0,
      padding: theme.spacing(2),
      position: "absolute",
      top: 0,
      width: 140,
    },
    imageOverlayToolbar: {
      alignContent: "flex-end",
      display: "flex",
      position: "relative",
      right: -theme.spacing(3),
      top: -theme.spacing(2),
    },
    imageUpload: {
      height: "100%",
      left: 0,
      outline: 0,
      position: "absolute",
      top: 0,
      width: "100%",
    },
    imageUploadActive: {
      zIndex: 1,
    },
    imageUploadIconActive: {
      display: "block",
    },
    root: {
      display: "grid",
      gridColumnGap: theme.spacing(2),
      gridRowGap: theme.spacing(2),
      gridTemplateColumns: "repeat(4, 1fr)",
      [theme.breakpoints.down("sm")]: {
        gridTemplateColumns: "repeat(3, 1fr)",
      },
      [theme.breakpoints.down("xs")]: {
        gridTemplateColumns: "repeat(2, 1fr)",
      },
    },
    rootDragActive: {
      opacity: 0.2,
    },
  }),
  { name: "ProductImages" }
);

interface ProductImagesProps {
  placeholderImage?: string;
  images: Array<ProductDetails_product_images | ShopInfoForProductCommonImages_shop_productCommonImages>;
  loading?: boolean;
  onImageDelete: (id: string) => void;
  onImageEdit: (id: string) => void;
  onImageReorder?: ReorderAction;
  onImageUpload(file: File);
}

interface SortableImageProps {
  image: {
    id: string;
    alt?: string;
    url: string;
  };
  onImageEdit: (id: string) => void;
  onImageDelete: (id: string) => void;
}

const SortableImage = SortableElement<SortableImageProps>(({ image, onImageEdit, onImageDelete }) => (
  <ImageTile
    image={image}
    onImageEdit={onImageEdit ? () => onImageEdit(image.id) : undefined}
    onImageDelete={onImageDelete ? () => onImageDelete(image.id) : undefined}
  />
));

interface ImageListContainerProps {
  className: string;
  items: Array<ProductDetails_product_images | ShopInfoForProductCommonImages_shop_productCommonImages>;
  preview: Array<ProductDetails_product_images | ShopInfoForProductCommonImages_shop_productCommonImages>;
  onImageDelete: (id: string) => void;
  onImageEdit: (id: string) => void;
}

const ImageListContainer = SortableContainer<ImageListContainerProps>(
  ({ items, preview, onImageDelete, onImageEdit, ...props }) => (
    <div {...props}>
      {items.map((image, index) => (
        <SortableImage
          key={image.id}
          index={index}
          image={image}
          onImageEdit={onImageEdit ? onImageEdit : null}
          onImageDelete={onImageDelete ? onImageDelete : null}
        />
      ))}
      {preview
        .sort((a, b) => (a.sortOrder > b.sortOrder ? 1 : -1))
        .map((image) => (
          <ImageTile key={image.id} loading={true} image={image} />
        ))}
    </div>
  )
);

export const ProductImages: React.FC<ProductImagesProps> = (props) => {
  const { images, placeholderImage, loading, onImageEdit, onImageDelete, onImageReorder, onImageUpload } = props;

  const classes = useStyles(props);

  const upload = React.useRef(null);
  const [imagesToUpload, setImagesToUpload] = React.useState<ProductDetails_product_images[]>([]);

  const handleImageUpload = createMultiFileUploadHandler(onImageUpload, {
    onAfterUpload: () => setImagesToUpload((prevImagesToUpload) => prevImagesToUpload.slice(1)),
    onStart: (files) => {
      Array.from(files).forEach((file, fileIndex) => {
        const reader = new FileReader();
        reader.onload = (event) => {
          setImagesToUpload((prevImagesToUpload) => [
            ...prevImagesToUpload,
            {
              __typename: "ProductImage",
              alt: "",
              id: "",
              sortOrder: fileIndex,
              url: event.target.result as string,
            },
          ]);
        };
        reader.readAsDataURL(file);
      });
    },
  });

  return (
    <Card>
      <CardTitle
        title="이미지"
        toolbar={
          <>
            <Button
              onClick={() => upload.current.click()}
              disabled={loading}
              variant="text"
              color="primary"
              data-test="button-upload-image"
            >
              {buttonText.uploadImage}
            </Button>
            <input
              className={classes.fileField}
              id="fileUpload"
              onChange={(event) => handleImageUpload(event.target.files)}
              multiple
              type="file"
              ref={upload}
              accept="image/*"
            />
          </>
        }
      />
      <div className={classes.imageGridContainer}>
        {images === undefined ? (
          <CardContent>
            <div className={classes.root}>
              <div className={classes.imageContainer}>
                <img className={classes.image} src={placeholderImage} />
              </div>
            </div>
          </CardContent>
        ) : images.length > 0 ? (
          <>
            <ImageUpload
              className={classes.imageUpload}
              isActiveClassName={classes.imageUploadActive}
              hideUploadIcon={true}
              iconContainerActiveClassName={classes.imageUploadIconActive}
              onImageUpload={handleImageUpload}
            >
              {({ isDragActive }) => (
                <CardContent>
                  <ImageListContainer
                    distance={20}
                    helperClass="dragged"
                    axis="xy"
                    items={images}
                    preview={imagesToUpload}
                    onSortEnd={onImageReorder}
                    className={classNames({
                      [classes.root]: true,
                      [classes.rootDragActive]: isDragActive,
                    })}
                    onImageDelete={onImageDelete}
                    onImageEdit={onImageEdit}
                  />
                </CardContent>
              )}
            </ImageUpload>
          </>
        ) : (
          <ImageUpload onImageUpload={handleImageUpload} />
        )}
      </div>
    </Card>
  );
};
</file>

<file path="src/app/views/product/products/components/ProductInfoUpdateNotice.tsx">
import { DeleteOutlined, PaperClipOutlined } from "@ant-design/icons";
import { FetchResult } from "@apollo/client";
import {
  ExtendedProductUpdateAdditionalInput,
  ProductToBeChangedInfoCreateInput,
  ProductVariantInput,
  ProductVariantManageEventInput,
  ProductVariantManageEventTypeEnum,
} from "@src/api/types/globalTypes";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { ExtendedProductUpdate } from "@src/app/views/product/products/api/types/ExtendedProductUpdate";
import { showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import { Button, Card, Col, Empty, Row, Space, Typography } from "antd";
import TextArea from "antd/lib/input/TextArea";
import React from "react";

import { ProductDetails_product } from "../api/types/ProductDetails";
import { ProductVariantDetails_productVariant_product } from "../api/types/ProductVariantDetails";
import { productVariantManageEventTypeChoices } from "../utils/data";
import { checkHasVariants } from "../utils/utils";
import FileUpload from "./FileUpload/FileUpload";
import { ProductVariantManageEventModal, ProductVariantManageEventModalForm } from "./PvOrBpvManageEventModal";

interface ProductInfoUpdateNoticeProps {
  product: ProductDetails_product | ProductVariantDetails_productVariant_product;
  onVariantUpdate: (
    variantId: string,
    productVariantInput: ProductVariantInput,
    additionalInput: ExtendedProductUpdateAdditionalInput,
    productToBeChangedInfoCreateInput?: ProductToBeChangedInfoCreateInput
  ) => Promise<FetchResult<ExtendedProductUpdate>>;
}

const ProductInfoUpdateNotice: React.FC<ProductInfoUpdateNoticeProps> = (props) => {
  const { product, onVariantUpdate } = props;

  if (product === undefined) {
    return <></>;
  }

  // 옵션형 제품인지 확인
  const hasVariants = checkHasVariants(product);
  const hasDefaultVariant = !!product.defaultVariant?.id;

  // 옵션형 제품이면서 옵션이 없는 경우
  if (hasVariants && !hasDefaultVariant) {
    return (
      <Card title={<CardTitleAntd title={"특이 사항"} />}>
        <Empty
          image={Empty.PRESENTED_IMAGE_SIMPLE}
          description={
            <Space direction="vertical" align="center">
              <Typography.Text>옵션형 제품은 옵션을 먼저 추가해주세요.</Typography.Text>
              <Typography.Text type="secondary">제품 옵션 추가 후 특이사항을 입력할 수 있습니다.</Typography.Text>
            </Space>
          }
        />
      </Card>
    );
  }

  const toBeChangedInfo = product.defaultVariant?.toBeChangedInfo;
  const isToBeChangedInfo = !!toBeChangedInfo;
  const [file, setFile] = React.useState<File | null>(null);
  const [title, setTitle] = React.useState<string>("");
  const [isAdd, setIsAdd] = React.useState<boolean>(false);
  const [detail, setDetail] = React.useState<string>("");
  const [manageEventType, setManageEventType] = React.useState<ProductVariantManageEventTypeEnum | null>(
    ProductVariantManageEventTypeEnum.TYPE_TO_BE_CHANGED
  );

  // 초기화 event
  const initData = () => {
    setTitle("");
    setIsAdd(false);
    setDetail("");
    setFile(null);
    setManageEventType(null);
  };

  const [manageEventModalOpen, setManageEventModalOpen] = React.useState<boolean>(false);
  const makeExtraUi = () => {
    // 옵션형 제품이면서 옵션이 없는 경우 버튼 비활성화
    const isDisabled = isAdd || isToBeChangedInfo || (hasVariants && !hasDefaultVariant);

    return (
      <Space>
        <Button type="primary" disabled={isDisabled} onClick={() => setIsAdd(true)}>
          추가
        </Button>
      </Space>
    );
  };

  // textarea change event
  const detailOnChange = (e) => {
    const target = e.currentTarget;
    const value = target.value;
    setDetail(value);
  };

  // 제품 관리 이력 추가 최종 제출 event
  const onSubmit = ({ manageEvent }: ProductVariantManageEventModalForm) => {
    const variantId = product.defaultVariant?.id;

    if (!variantId) {
      showNotificationError("기본 옵션이 설정되지 않았습니다. 제품 옵션을 먼저 추가해주세요.");
      return;
    }

    onVariantUpdate(
      variantId,
      undefined,
      {
        manageEvent: manageEvent as ProductVariantManageEventInput,
        productToBeChangedInfoId: toBeChangedInfo?.id,
      },
      !toBeChangedInfo
        ? {
            productVariant: variantId,
            detail,
            attachmentFile: file,
            attachmentFileName: file?.name,
          }
        : undefined
    );

    initData();
    setManageEventModalOpen(false);
  };

  // 처음 저장 버튼 클릭 event
  const onFirstSubmit = () => {
    // 옵션 검증
    if (hasVariants && !hasDefaultVariant) {
      showNotificationError("옵션형 제품은 옵션을 먼저 추가해주세요.");
      return;
    }

    if (detail.length < 10) {
      showNotificationWarn("변경되는 정보를 10자 이상 입력해 주세요.");
      return;
    }
    setTitle("특이 사항 등록");
    setManageEventType(ProductVariantManageEventTypeEnum.TYPE_REG_CHANGED);
    setManageEventModalOpen(true);
  };

  // 처음 취소 버튼 클릭 event
  const onFirstStepCancel = () => {
    setManageEventModalOpen(false);
    initData();
  };

  // 반영 버튼 클릭 event
  const onFinalSubmit = () => {
    setTitle("특이 사항 처리");
    setManageEventType(ProductVariantManageEventTypeEnum.TYPE_TO_BE_CHANGED);
    setDetail(toBeChangedInfo.detail + " 처리 확정");
    setManageEventModalOpen(true);
  };

  return (
    <>
      <Card title={<CardTitleAntd title={"특이 사항"} />} extra={makeExtraUi()}>
        {isToBeChangedInfo || isAdd ? (
          <Row justify={"center"} gutter={[8, 8]}>
            <Col span={12}>
              <TextArea
                rows={4}
                placeholder="제품 발주 시 참고해야 하는 특이 사항을 입력해주세요(예: 디자인 변경, 시즌 제품으로 6~7월 발주수량 주의)."
                onChange={detailOnChange}
                defaultValue={!isToBeChangedInfo ? detail : toBeChangedInfo?.detail}
                disabled={isToBeChangedInfo}
              />
            </Col>
            <Col span={12}>
              <div style={{ display: "flex", marginBottom: 5, justifyContent: "space-between" }}>
                <FileUpload
                  buttonText={"파일 업로드"}
                  onImageUpload={function (file: File): void {
                    if (file) {
                      setFile(file);
                    }
                  }}
                  accept={"*"}
                  disabled={isToBeChangedInfo}
                />
                <div>
                  {!isToBeChangedInfo ? (
                    <>
                      <Button type="primary" onClick={onFirstSubmit} style={{ marginRight: 8 }}>
                        저장
                      </Button>
                      <Button type="primary" onClick={onFirstStepCancel}>
                        취소
                      </Button>
                    </>
                  ) : (
                    <Button type="primary" onClick={onFinalSubmit}>
                      처리
                    </Button>
                  )}
                </div>
              </div>
              {file !== null && (
                <Row
                  justify={"space-between"}
                  align={"middle"}
                  style={{
                    backgroundColor: "#f1f1f1",
                    padding: "3px 2px",
                  }}
                >
                  <Row align={"middle"}>
                    <PaperClipOutlined style={{ marginRight: 10, fontSize: "20px" }} />
                    <Typography.Text>{file.name}</Typography.Text>
                  </Row>
                  <DeleteOutlined
                    style={{ marginRight: 5, fontSize: "20px", color: "red" }}
                    onClick={() => setFile(null)}
                  />
                </Row>
              )}
              {isToBeChangedInfo && toBeChangedInfo?.attachmentFileUrl && (
                <Row
                  justify={"space-between"}
                  align={"middle"}
                  style={{
                    backgroundColor: "#f1f1f1",
                    padding: "3px 2px",
                  }}
                >
                  <Row align={"middle"}>
                    <PaperClipOutlined style={{ marginRight: 10, fontSize: "20px" }} />
                    <a href={toBeChangedInfo?.attachmentFileUrl} download={toBeChangedInfo?.attachmentFileUrl}>
                      {toBeChangedInfo?.attachmentFileName}
                    </a>
                  </Row>
                </Row>
              )}
            </Col>
          </Row>
        ) : (
          <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} />
        )}
      </Card>
      <ProductVariantManageEventModal
        isCreateMode
        open={manageEventModalOpen}
        manageEventType={manageEventType}
        choices={productVariantManageEventTypeChoices}
        title={title}
        reason={detail}
        onSubmit={onSubmit}
        onCancel={() => setManageEventModalOpen(false)}
        loading={false}
      />
    </>
  );
};

export default ProductInfoUpdateNotice;
</file>

