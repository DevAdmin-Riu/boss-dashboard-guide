<file path="src/app/components/antd/DatePicker/MobileDatePicker.tsx">
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { DatePicker, DatePickerProps, Typography } from "antd";
import { DatePicker as DatePickerM } from "antd-mobile";
import { Precision } from "antd-mobile/es/components/date-picker/date-picker-utils";
import moment from "moment";
import React, { useState } from "react";

export type MobileDatePickerProps = DatePickerProps & {
  mobilePopupTitle?: string | React.ReactNode;
};

const getPrecisionFromPicker = (picker?: string): Precision => {
  switch (picker) {
    case "year":
      return "year";
    case "quarter":
      return "quarter";
    case "month":
      return "month";
    case "week":
      return "week";
    case "date":
      return "day";
    case "time":
      return "second";
    default:
      return "day";
  }
};

const renderLabel = (type: Precision, data: number): string => {
  const labels: Record<Precision, string> = {
    year: `${data}년`,
    month: `${data}월`,
    day: `${data}일`,
    hour: `${data}시`,
    minute: `${data}분`,
    second: `${data}초`,
    week: `${data}주`,
    quarter: `${data}분기`,
    "week-day": `${data}요일`,
  };
  return labels[type] || `${data}`;
};

export const MobileDatePicker = React.forwardRef<React.Component, MobileDatePickerProps>((props, ref) => {
  const { mobilePopupTitle, ...datePickerProps } = props;
  const [visible, setVisible] = useState<boolean>(false);

  const popupTitleToUser = mobilePopupTitle || "날짜 선택";
  const type = getPrecisionFromPicker(datePickerProps.picker);
  const parsedFormat = typeof datePickerProps.format === "string" ? datePickerProps.format : onlyDateFormat;

  const onOpen = () => setVisible(true);
  const onClose = () => setVisible(false);

  const renderLabelNode = (type: Precision, data: number) => {
    const label = renderLabel(type, data);
    const fontSize = datePickerProps?.picker === "time" ? 12 : 14;
    return <Typography.Text style={{ fontSize }}>{label}</Typography.Text>;
  };

  return (
    <DatePicker
      {...datePickerProps}
      ref={ref}
      inputReadOnly
      onClick={onOpen}
      panelRender={() => (
        <DatePickerM
          mouseWheel
          visible={visible}
          title={popupTitleToUser}
          precision={type}
          value={datePickerProps.value?.toDate()}
          renderLabel={renderLabelNode}
          confirmText="확인"
          cancelText="취소"
          onConfirm={(value) => {
            const momentValue = moment(value);
            const dateString = momentValue.format(parsedFormat);
            datePickerProps.onChange?.(momentValue, dateString);
          }}
          onClose={onClose}
        />
      )}
    />
  );
});
</file>

