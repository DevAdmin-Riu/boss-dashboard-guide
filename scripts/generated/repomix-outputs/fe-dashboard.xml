interface RcoinsEventListViewProps {
  params: RcoinsEventListViewUrlQueryParams;
}

export const RcoinsEventListView: React.FC<RcoinsEventListViewProps> = ({ params }) => {
  const targetUrl = rcoinsEventListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.RCOINS_EVENT_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useRcoinsEventListFilterDownloadQuery);

  const queryVariables = React.useMemo<RcoinsEventListVariables>(
    () => ({ ...paginationState, filter: getFilterVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useRcoinsEventListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.rcoinsEvents?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<RcoinsEventListViewUrlDialog, RcoinsEventListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <RcoinsEventListPage
        settings={settings}
        disabled={loading}
        rcoinsEvents={maybe(() => data.rcoinsEvents.edges.map((edge) => edge.node))}
        pageInfo={pageInfo}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        onRcoinsEventBulkIncrease={() => openModal("bulk-increase")}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <RcoinsBulkIncreaseModal open={params.action === "bulk-increase"} onClose={closeModal} />
    </>
  );
};
