<file path="src/app/views/order/orders/components/OrderChangePaymentStatusModal/OrderChangePaymentStatusModal.tsx">
import { DownloadOutlined, UploadOutlined } from "@ant-design/icons";
import { MutationFunction } from "@apollo/client";
import { PaymentChargeStatusEnum, UpdateStaffPaymentChargeStatusInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { OrderDetails_order_lastPayment } from "@src/app/views/order/orders/api/types/OrderDetails";
import { showNotificationError } from "@utils/notification/wrapper";
import { Button, Form, Input, Modal, Radio, Typography, Upload, UploadFile, UploadProps } from "antd";
import React, { useEffect, useState } from "react";

import {
  UpdateStaffPaymentChargeStatus,
  UpdateStaffPaymentChargeStatusVariables,
} from "../../api/types/UpdateStaffPaymentChargeStatus";

interface OrderRefundQuestionsModalProps {
  open: boolean;
  onClose: () => void;
  payment: OrderDetails_order_lastPayment;
  paymentStatus: PaymentChargeStatusEnum;
  loading: boolean;
  onSubmit: MutationFunction<UpdateStaffPaymentChargeStatus, UpdateStaffPaymentChargeStatusVariables>;
}
const OrderChangePaymentStatusModal: React.FC<OrderRefundQuestionsModalProps> = (props) => {
  const { open, onClose, payment, paymentStatus, loading, onSubmit } = props;

  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<UpdateStaffPaymentChargeStatusInput>(form);
  const chargeStatusWatched = TypeSafeForm.getUseFormWatched({ name: "chargeStatus" });

  const [fileList, setFileList] = useState<UploadFile[]>([]);

  const uploadProps: UploadProps = {
    onRemove: (file) => {
      setFileList([]);
    },
    beforeUpload: (file) => {
      setFileList([file]);
      return false;
    },
    fileList,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
      setFileList([]);
    }
  }, [open]);

  const handleOnFinish = (data: UpdateStaffPaymentChargeStatusInput) => {
    if (fileList.length > 0) {
      data.receiptFile = fileList[0];
    } else if (chargeStatusWatched === PaymentChargeStatusEnum.BEING_APPROVED) {
      showNotificationError("파일을 업로드해주세요.");
      return;
    }

    onSubmit({
      variables: {
        id: payment.id,
        input: data,
        skipWhenHqStaff: false,
      },
    });
  };

  return (
    <Modal
      width={1200}
      forceRender
      destroyOnClose
      closable={false}
      maskClosable={false}
      title="대행 주문 결제 상태 변경"
      open={open}
      onOk={form.submit}
      onCancel={onClose}
      okButtonProps={{ loading }}
    >
      <Form form={form} onFinish={handleOnFinish} preserve={false}>
        {paymentStatus === PaymentChargeStatusEnum.PENDING && (
          <>
            <Typography.Text strong>이 주문이 결제 완료 증빙 자료를 첨부한 뒤 변경 가능합니다.</Typography.Text>
            <br />
            <Upload {...uploadProps}>
              <Button icon={<UploadOutlined />} loading={loading}>
                파일 업로드
              </Button>
            </Upload>
          </>
        )}
        {paymentStatus === PaymentChargeStatusEnum.BEING_APPROVED && (
          <>
            <Typography.Text strong>증빙 자료를 확인한 뒤 변경 가능합니다.</Typography.Text>
            <br />
            <Button icon={<DownloadOutlined />} href={payment?.receiptFile?.url}>
              증빙 파일 다운로드
            </Button>
          </>
        )}
        {paymentStatus === PaymentChargeStatusEnum.PENDING ? (
          <Form.Item
            name={TypeSafeForm.getValidDataIndex("chargeStatus")}
            initialValue={PaymentChargeStatusEnum.BEING_APPROVED}
            hidden
          >
            <Input />
          </Form.Item>
        ) : (
          <Form.Item
            name={TypeSafeForm.getValidDataIndex("chargeStatus")}
            rules={[{ required: true, message: "변경될 상태를 선택해주세요." }]}
          >
            <Radio.Group>
              <Radio value={PaymentChargeStatusEnum.PENDING}>반려(결제 대기로 변경)</Radio>
              <Radio value={PaymentChargeStatusEnum.FULLY_CHARGED}>승인(결제 완료로 변경)</Radio>
            </Radio.Group>
          </Form.Item>
        )}
        {chargeStatusWatched === PaymentChargeStatusEnum.PENDING && (
          <Form.Item
            name={TypeSafeForm.getValidDataIndex("receiptRefusedReason")}
            label={"반려 사유"}
            rules={[{ required: true, message: "반려 사유를 입력해주세요." }]}
          >
            <Input.TextArea />
          </Form.Item>
        )}
      </Form>
    </Modal>
  );
};
export default OrderChangePaymentStatusModal;
</file>

