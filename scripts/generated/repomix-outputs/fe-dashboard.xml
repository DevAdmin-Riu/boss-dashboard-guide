import { BrandFilterInput } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createBooleanField, createOptionsField, createTextField } from "@utils/filters/fields";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

export interface IBrandForAssginedProductFilterVariables extends Pick<BrandFilterInput, "brandSearch"> {
  pvId: string;
  includeIsNotRunning: boolean;
}

enum BrandForAssignedProductSearchFilterKeys {
  pvId = "pvId",
  brandSearch = "brandSearch",
  includeIsNotRunning = "includeIsNotRunning",
}
type BrandForAssignedProductSearchFilters = Filters<BrandForAssignedProductSearchFilterKeys>;

interface BrandForAssignedProductSearchListFilterOpts {
  pvId: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  includeIsNotRunning: FilterOpts<boolean>;
}

export const getFilterOpts = (
  filterVariables: IBrandForAssginedProductFilterVariables
): BrandForAssignedProductSearchListFilterOpts => ({
  pvId: {
    active: maybe(() => !utils.isEmpty(filterVariables.pvId, true), false),
    value: filterVariables?.pvId,
  },
  brandSearch: {
    active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
    value: filterVariables?.brandSearch,
  },
  includeIsNotRunning: {
    active: maybe(() => !utils.isEmpty(filterVariables.includeIsNotRunning, true), false),
    value: filterVariables?.includeIsNotRunning,
  },
});

export const createFilterStructure = (
  opts: BrandForAssignedProductSearchListFilterOpts,
  pvOptions: Array<{ label: string; value: string }>
): IFilter<BrandForAssignedProductSearchFilterKeys> => {
  let displayOrder = 0;
  return [
    {
      ...createOptionsField(
        displayOrder++,
        BrandForAssignedProductSearchFilterKeys.pvId,
        columnNameConstant.product.SKU,
        [opts.pvId.value],
        false,
        pvOptions
      ),
      active: opts.pvId.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        BrandForAssignedProductSearchFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createBooleanField(
        displayOrder++,
        BrandForAssignedProductSearchFilterKeys.includeIsNotRunning,
        "종결 브랜드 포함",
        opts.includeIsNotRunning.value,
        {
          negative: "미포함",
          positive: "포함",
        }
      ),
      active: opts.includeIsNotRunning.active,
      isRequired: true,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): BrandForAssignedProductSearchFilters {
  const { name } = filter;

  switch (name) {
    case BrandForAssignedProductSearchFilterKeys.pvId:
      return getSingleValueQueryParam(filter, BrandForAssignedProductSearchFilterKeys.pvId);
    case BrandForAssignedProductSearchFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, BrandForAssignedProductSearchFilterKeys.brandSearch);
    case BrandForAssignedProductSearchFilterKeys.includeIsNotRunning:
      return getSingleValueQueryParam(filter, BrandForAssignedProductSearchFilterKeys.includeIsNotRunning);
  }
}

export function getFilterVariables(filters: Array<IFilterElement<string>>): IBrandForAssginedProductFilterVariables {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});

  return {
    pvId: queryParams?.pvId,
    brandSearch: queryParams?.brandSearch,
    includeIsNotRunning: parseBoolean(queryParams?.includeIsNotRunning, false),
  };
}
</file>

