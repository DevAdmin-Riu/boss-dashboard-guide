        break;
      }
      // 아래에서 선언한 필터는 위탁인 경우(대행 배송 확정 페이지)에만 사용됨을 강조하기 위해 아래에 선언함
      const poEventTypeFilter = {
        ...createOptionsField(
          displayOrder++,
          OrderDeliveryFilterKeys.purchaseOrderEventType,
          filterMsg.purchaseOrderEventType,
          opts.purchaseOrderEventType.value,
          true,
          purchaseOrderLineEventTypeEnumChoices(isB2b).filter((status) =>
            getPoEventTypeFromPoLineRouteParams({
              inventoryType: "consignment",
              status: "confirm-delivery",
            }).includes(status.value)
          )
        ),
        active: opts.purchaseOrderEventType.active,
        isRequired: true,
      };
      const purchaseOrderDateFilter = {
        ...createDateField(
          displayOrder++,
          OrderDeliveryFilterKeys.purchaseOrderDate,
          "발주일",
          opts.purchaseOrderDate.value
        ),
        active: opts.purchaseOrderDate.active,
      };
      const askingPurchaseDateFilter = {
        ...createDateField(
          displayOrder++,
          OrderDeliveryFilterKeys.askingPurchaseDate,
          filterMsg.poLineAskingPurchaseDate,
          opts.askingPurchaseDate.value
        ),
        active: opts.askingPurchaseDate.active,
      };
      const expectedPurchaseDateFilter = {
        ...createDateField(
          displayOrder++,
          OrderDeliveryFilterKeys.expectedPurchaseDate,
          filterMsg.poLineExpectedPurchaseDate,
          opts.expectedPurchaseDate.value
        ),
        active: opts.expectedPurchaseDate.active,
      };
      const poLineVendorOrderStatusFilter = {
        ...createOptionsField(
          displayOrder++,
          OrderDeliveryFilterKeys.poLineVendorOrderStatus,
          "협력사 주문 상태",
          opts.poLineVendorOrderStatus.value,
          true,
          [
            { label: "대기", value: PoLineVendorOrderStatusEnum.STANDBY },
            { label: "주문완료", value: PoLineVendorOrderStatusEnum.ORDERED },
          ]
        ),
        active: opts.poLineVendorOrderStatus.active,
      };

      filterStructure = [
        poEventTypeFilter,
        isB2b === false && orderSearchFilter,
        isB2b && b2bOrderSearchFilter,
        purchaseOrderSearchFilter,
        purchaseOrderDateFilter,
        askingPurchaseDateFilter,
        isStaff && expectedPurchaseDateFilter,
        productSearchFilter,
        fulfillVendorSearchFilter,
        brandSearchFilter,
        isB2b === false && brandStoreSearchFilter,
        isB2b === false && userSearchFilter,
        paymentSearchFilter,
        orderCreatedFilter,
        orderCapturedAtTimeFilter,
        shippingAddressFilter,
        deliveryStatusFilter,
        trackingNumberFilter,
        poLineVendorOrderStatusFilter,
      ];
      break;
    case OrderDeliveryViewTypeEnum.STOCK_ETC:
      filterStructure = [
        orderSearchFilter,
        paymentSearchFilter,
        userSearchFilter,
        brandSearchFilter,
        isB2b === false && brandStoreSearchFilter,
        orderCreatedFilter,
        orderCapturedAtFilter,
        createdFilter,
        deliveryMethodsFilter,
        deliveryStartDateFilter,
        deliveryEndDateFilter,
        deliveryStatusFilter,
      ];
      break;
    default:
      return [];
  }

  return utils.filterDisplayOrdering(filterStructure.filter(Boolean));
}
</file>

