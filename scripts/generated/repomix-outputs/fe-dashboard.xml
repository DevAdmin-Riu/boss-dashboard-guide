import { BrandFilterInput } from "@src/api/types/globalTypes";
import { IFilter, IFilterElement } from "@src/app/components/Filter";
import { FilterOpts, Filters } from "@src/global/core/types/types";
import { getSingleValueQueryParam } from "@utils/filters";
import { createBooleanField, createTextField } from "@utils/filters/fields";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

enum BrandsVariableSearchFiltersEnum {
  isRunning = "isRunning",
  search = "search",
}

type BrandsVariantSearchFilters = Filters<BrandsVariableSearchFiltersEnum>;

interface BrandsVariantSearchListFilterOpts {
  search: FilterOpts<string>;
  isRunning: FilterOpts<boolean>;
}

// NOTE: 보스장터 이용 브랜드 모달 내에서만 사용하기 위한 필터 옵션 구성 함수.
// 기존 리스트 페이지의 getFilterOpts와 다르기 때문에 리스트 페이지 생성 시 해당 함수 말고 다른 페이지의 getFilterOpts 참고할 것.
export const getFilterOpts = (filterVariables: BrandFilterInput): BrandsVariantSearchListFilterOpts => ({
  search: {
    active: maybe(() => !utils.isEmpty(filterVariables.search, true), false),
    value: filterVariables.search || "",
  },
  isRunning: {
    active: maybe(() => !utils.isEmpty(filterVariables.isRunning), false),
    value: maybe(() => filterVariables.isRunning, true),
  },
});

export const createFilterStructure = (
  opts: BrandsVariantSearchListFilterOpts
): IFilter<BrandsVariableSearchFiltersEnum> => {
  let displayOrder = 0;
  return [
    {
      ...createTextField(displayOrder++, BrandsVariableSearchFiltersEnum.search, "브랜드명", opts.search.value),
      active: opts.search.active,
      smColSpan: 24,
    },
    {
      ...createBooleanField(
        displayOrder++,
        BrandsVariableSearchFiltersEnum.isRunning,
        "운영여부",
        opts.isRunning.value,
        {
          negative: "미운영",
          positive: "운영",
        }
      ),
      active: opts.isRunning.active,
    },
  ];
};

function getFilterQueryParam(filter: IFilterElement<string>): BrandsVariantSearchFilters {
  const { name } = filter;

  switch (name) {
    case BrandsVariableSearchFiltersEnum.search:
      return getSingleValueQueryParam(filter, BrandsVariableSearchFiltersEnum.search);
    case BrandsVariableSearchFiltersEnum.isRunning:
      return getSingleValueQueryParam(filter, BrandsVariableSearchFiltersEnum.isRunning);
  }
}

export function getBrandsVariantSearchFilterVariables(filters: Array<IFilterElement<string>>): BrandFilterInput {
  const queryParams = filters
    .filter((filter) => filter.active)
    .map((filter) => getFilterQueryParam(filter))
    .reduce((acc, cur) => ({ ...acc, ...cur }), {});
  return {
    search: queryParams.search,
    isRunning: queryParams.isRunning !== undefined ? parseBoolean(queryParams.isRunning, true) : undefined,
  };
}
