      {
        label: "비공개",
        value: PublishedEnum.HIDDEN,
      },
    ]),
    active: opts.published.active,
  };
  const createdDateFilter = {
    ...createDateField(0, TrainingDocListFilterKeys.createdDate, "등록일", opts.createdDate.value),
    active: opts.createdDate.active,
  };
  const publishDateFilter = {
    ...createDateField(0, TrainingDocListFilterKeys.publishDate, "공개일", opts.publishDate.value),
    active: opts.publishDate.active,
  };

  let filterList: IFilter<TrainingDocListFilterKeys> = [];

  switch (menuType) {
    case "operation-manual":
    case "menu-recipe":
      filterList = [
        tagSearchFilter,
        titleSearchFilter,
        isStaff && brandSearchFilter,
        createdDateFilter,
        publishDateFilter,
        publishedFilter,
      ];
      break;
    default:
      filterList = [];
  }

  return utils.filterDisplayOrdering(filterList.filter(Boolean));
}
