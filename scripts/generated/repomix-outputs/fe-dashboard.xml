export function getPoLineStatusFromPoLineRouteParams(
  routeParams: PurchaseOrderLineListViewRouteParams
): PurchaseOrderLineStatusEnum[] {
  const { inventoryType, status } = routeParams;

  // ":status" 같은 라우트 파라미터는 무시
  if (typeof status !== "string" || status.startsWith(":")) {
    return [];
  }

  // ":inventoryType" 같은 라우트 파라미터는 무시
  if (typeof inventoryType !== "string" || inventoryType.startsWith(":")) {
    return [];
  }

  // 타입 안전성 확보
  if (isValidPurchaseOrderLineUrl(status)) {
    return getStatusesFromUrlParam(status, inventoryType);
  }

  return [];
}
