<file path="src/app/views/order/orders/components/CreateAdminOrderAddressSetModal/CreateAdminOrderAddressSetModal.tsx">
import { SearchCustomersForAdminOrder_search_edges_node } from "@src/api/searches/types/SearchCustomersForAdminOrder";
import { UserAddresses_user_addresses } from "@src/app/views/customer/customers/api/types/UserAddresses";
import { makeAddressInputFromDaumPostcode } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Empty, Form, FormInstance, Input, Modal, Radio, Row, Space } from "antd";
import React, { useEffect } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

import { AddressTileOption } from "./AddressTileOption";

interface CreateAdminOrderAddressSetModalProps {
  open: boolean;
  footer?: React.ReactNode;
  title: string;
  form: FormInstance;
  daumPostcodeOpen: boolean;
  setDaumPostcodeOpen: React.Dispatch<React.SetStateAction<boolean>>;
  selectedAddressIdWatched: string | null;
  selectAddressModeWatched: boolean;
  useBpSkuMode: boolean;
  customerUserWatched: SearchCustomersForAdminOrder_search_edges_node;
  userAddresses: UserAddresses_user_addresses[] | null;
}

const CreateAdminOrderAddressSetModal: React.FC<CreateAdminOrderAddressSetModalProps> = (props) => {
  const {
    open,
    footer,
    title,
    form,
    daumPostcodeOpen,
    setDaumPostcodeOpen,
    selectedAddressIdWatched,
    selectAddressModeWatched,
    useBpSkuMode,
    customerUserWatched,
    userAddresses,
  } = props;

  const searchAddress = (address: Address) => {
    const input = makeAddressInputFromDaumPostcode(address);
    form.setFieldValue("postalCode", input.postalCode);
    form.setFieldValue("streetAddress1", input.streetAddress1);
    setDaumPostcodeOpen(false);
  };

  useEffect(() => {
    if (useBpSkuMode && selectAddressModeWatched) {
      if (utils.isEmpty(selectedAddressIdWatched)) {
        const defaultShippingAddress = customerUserWatched?.defaultShippingAddress;
        if (defaultShippingAddress) {
          form.setFieldsValue({ selectedAddressId: defaultShippingAddress?.id });
        } else {
          form.setFieldsValue({ selectedAddressId: null });
        }
      }
    }
  }, [useBpSkuMode, selectAddressModeWatched, customerUserWatched, selectedAddressIdWatched]);

  return (
    <Modal open={open} closable={false} footer={footer} title={title} maskClosable={false}>
      <Space style={{ display: daumPostcodeOpen ? "none" : "block" }}>
        {useBpSkuMode && (
          <>
            <Row justify="space-between" gutter={[12, 18]}>
              <Form.Item name="selectedAddressId" noStyle>
                <Input type="hidden" />
              </Form.Item>
              <Form.Item name="selectAddressMode">
                <Radio.Group>
                  <Radio value={false}>직접입력</Radio>
                  <Radio value={true}>주소록</Radio>
                </Radio.Group>
              </Form.Item>
            </Row>
          </>
        )}
        {selectAddressModeWatched ? (
          <Row gutter={[24, 24]}>
            {userAddresses && userAddresses.length > 0 ? (
              userAddresses.map((address, idx) => (
                <Col key={idx} span={24}>
                  <AddressTileOption
                    key={`addressTile-${address.id}`}
                    address={address}
                    defaultShippingAddressId={customerUserWatched?.defaultShippingAddress?.id}
                    onChange={() => {
                      form.setFieldsValue({ selectedAddressId: address.id });
                    }}
                    checked={address.id === selectedAddressIdWatched}
                  />
                </Col>
              ))
            ) : (
              <Empty description="등록된 배송지 주소가 없습니다." style={{ padding: 16 }} />
            )}
          </Row>
        ) : (
          <>
            <Row justify="space-between" gutter={[12, 18]}>
              <Col span={12}>
                <label>
                  받는 사람(주문자)
                  <Form.Item name="firstName">
                    <Input />
                  </Form.Item>
                </label>
              </Col>
              <Col span={12}>
                <label>
                  받는 사람 연락처
                  <Form.Item name="phone">
                    <Input />
                  </Form.Item>
                </label>
              </Col>
            </Row>
            <Col span={24}>
              <Card type="inner" title="배송지 주소">
                <label>
                  우편번호
                  <div style={{ marginBottom: 8 }}>
                    <Form.Item name="postalCode" noStyle>
                      <Input style={{ width: "50%" }} disabled />
                    </Form.Item>
                    <Button style={{ marginLeft: 8 }} type="primary" onClick={() => setDaumPostcodeOpen(true)}>
                      주소 검색
                    </Button>
                  </div>
                </label>
                <label>
                  주소
                  <Form.Item name="streetAddress1" style={{ marginBottom: 8 }}>
                    <Input disabled />
                  </Form.Item>
                </label>
                <label>
                  상세주소
                  <Form.Item name="streetAddress2" style={{ marginBottom: 8 }}>
                    <Input />
                  </Form.Item>
                </label>
              </Card>
            </Col>
          </>
        )}
      </Space>
      {daumPostcodeOpen && <DaumPostcode onComplete={searchAddress} style={{ width: "100%" }} />}
    </Modal>
  );
};

export default CreateAdminOrderAddressSetModal;
</file>

