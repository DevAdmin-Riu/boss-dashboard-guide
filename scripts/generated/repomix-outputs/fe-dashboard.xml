import useUser from "@hooks/useUser";
import ConfirmModal from "@src/app/components/ConfirmModal";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import ListNavigator, { TCountOfStatus } from "@src/app/components/Navigator/ListNavigator";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import {
  HqB2bSettlementListViewRouteParams,
  hqB2bSettlementListViewUrl,
  hqB2bSettlementNavButtonName,
  HqB2bSettlementUrlEnum,
  hqB2bSettlementUrlList,
} from "@src/app/views/hqStaff/hqB2b/urls";
import { useTaxInvoiceIssueMutation } from "@src/app/views/order/taxInvoice/api/mutations";
import { useTaxInvoiceListDownloadQuery, useTaxInvoiceListQuery } from "@src/app/views/order/taxInvoice/api/queries";
import { TaxInvoiceListVariables } from "@src/app/views/order/taxInvoice/api/types/TaxInvoiceList";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";
import { useParams } from "react-router";

import { useB2bSalesCountQuery } from "../../api/queries";
import { B2bSalesCount_b2bSalesCount } from "../../api/types/B2bSalesCount";
import B2bTaxInvoiceListPage from "../../components/B2bTaxInvoiceListPage/B2bTaxInvoiceListPage";
import {
  B2bSettlementForSalesViewUrlDialog,
  B2bSettlementForSalesViewUrlQueryParams,
  B2bSettlementListViewRouteParams,
  b2bSettlementListViewUrl,
  b2bSettlementNavButtonName,
  B2bSettlementUrlEnum,
  b2bSettlementUrlList,
  B2bTaxInvoiceListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filter";

interface B2bTaxInvoiceListViewProps {
  params: B2bTaxInvoiceListViewUrlQueryParams;
  isB2b: boolean;
}
export const getStatusCount = (
  data: B2bSalesCount_b2bSalesCount,
  isStaff: boolean
): TCountOfStatus<B2bSettlementUrlEnum> | TCountOfStatus<HqB2bSettlementUrlEnum> => {
  const { standByCount, reqRevisionCount, revisionCount } = data;
  const totalEditRequestCount = reqRevisionCount + revisionCount;

  if (isStaff) {
    return {
      [B2bSettlementUrlEnum.ALL]: 0,
      [B2bSettlementUrlEnum.IN_PROGRESS]: standByCount,
      [B2bSettlementUrlEnum.EDIT_REQUEST]: totalEditRequestCount,
      [B2bSettlementUrlEnum.CLOSING_STATEMENT]: 0,
      [B2bSettlementUrlEnum.AGENCY_PENDING]: 0,
      [B2bSettlementUrlEnum.CLOSED]: 0, // closedCount가 API에 없음
      [B2bSettlementUrlEnum.TAXINVOICE]: 0, // taxInvoiceCount가 API에 없음
    } as TCountOfStatus<B2bSettlementUrlEnum>;
  } else {
    return {
      [HqB2bSettlementUrlEnum.STAND_BY]: standByCount,
      [HqB2bSettlementUrlEnum.PENDING]: totalEditRequestCount,
      [HqB2bSettlementUrlEnum.COMPLETED]: 0, // completedCount가 API에 없음
      [HqB2bSettlementUrlEnum.ALL]: 0,
      [HqB2bSettlementUrlEnum.TAXINVOICE]: 0, // taxInvoiceCount가 API에 없음
    } as TCountOfStatus<HqB2bSettlementUrlEnum>;
  }
};

const B2bTaxInvoiceListView: React.FC<B2bTaxInvoiceListViewProps> = (props) => {
  const { params } = props;
  const routeParams = useParams<B2bSettlementListViewRouteParams | HqB2bSettlementListViewRouteParams>();
  const { user } = useUser();
  const { isStaff } = user;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: isStaff ? ListViews.B2B_SETTLEMENT_LIST_TAXINVOICE : ListViews.HQ_B2B_SETTLEMENT_LIST_TAXINVOICE,
  });
  const [taxInvoiceId, setTaxInvoiceId] = useState<string>(null);

  const targetUrl = (params: B2bSettlementForSalesViewUrlQueryParams) =>
    isStaff
      ? b2bSettlementListViewUrl(routeParams as unknown as B2bSettlementListViewRouteParams, params)
      : hqB2bSettlementListViewUrl(routeParams as unknown as HqB2bSettlementListViewRouteParams, params);
  const { fetchForDownload } = utils.initListViewDownloadQuery(useTaxInvoiceListDownloadQuery);

  const { data: countData } = useB2bSalesCountQuery({
    variables: {
      filter: {
        brandId: isStaff ? undefined : user.brand.id,
      },
    },
  });

  const queryVariables: TaxInvoiceListVariables = React.useMemo(() => {
    const variable = {
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        isB2b: true,
      },
    };

    if (isStaff === true) {
      return variable;
    } else if (isStaff === false) {
      return {
        ...variable,
        filter: {
          ...variable.filter,
          b2bBrand: user.brand.id,
        },
      };
    }
  }, [params, settings?.rowNumber]);

  const {
    data,
    loading: useTaxInvoiceListQueryLoading,
    refetch,
  } = useTaxInvoiceListQuery({ variables: queryVariables });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.taxInvoiceList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<B2bSettlementForSalesViewUrlDialog, B2bTaxInvoiceListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const [taxInvoiceIssue, taxInvoiceIssueOpts] = useTaxInvoiceIssueMutation({
    onCompleted: (data) => {
      const errors = data.taxInvoiceIssue.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("세금계산서 발행을 신청했습니다.");
        setTaxInvoiceId(null);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const handleTaxInvoiceIssue = (id: string) => {
    taxInvoiceIssue({
      variables: {
        id,
      },
    });
  };

  const onTaxInvoiceIssued = (id: string) => {
    setTaxInvoiceId(id);
    openModal("tax-invoice-issued");
  };

  const loading = useTaxInvoiceListQueryLoading || taxInvoiceIssueOpts.loading;
  return (
    <>
      <B2bTaxInvoiceListPage
        disabled={loading}
        settings={settings}
        taxInvoices={maybe(() => data.taxInvoiceList.edges.map((edge) => edge.node), [])}
        pageInfo={pageInfo}
        onAdd={undefined}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        currentTab={currentTab}
        fetchForDownload={fetchForDownload}
        filterOpts={getFilterOpts(params)}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTaxInvoiceIssued={(id: string) => onTaxInvoiceIssued(id)}
        onTabChange={handleTabChange}
        onAll={resetFilters}
        isStaff={isStaff}
        ListNavigator={
          isStaff
            ? () => (
                <ListNavigator<B2bSettlementForSalesViewUrlQueryParams, B2bSettlementUrlEnum>
                  countOfStatus={
                    countData
                      ? (getStatusCount(countData.b2bSalesCount, true) as TCountOfStatus<B2bSettlementUrlEnum>)
                      : null
                  }
                  urlList={b2bSettlementUrlList()}
                  NavButtonName={b2bSettlementNavButtonName}
                  skipQueryString={true}
                />
              )
            : () => (
                <ListNavigator<B2bSettlementForSalesViewUrlQueryParams, HqB2bSettlementUrlEnum>
                  countOfStatus={
                    countData
                      ? (getStatusCount(countData.b2bSalesCount, false) as TCountOfStatus<HqB2bSettlementUrlEnum>)
                      : null
                  }
                  urlList={hqB2bSettlementUrlList()}
                  NavButtonName={hqB2bSettlementNavButtonName}
                  skipQueryString={true}
                />
              )
        }
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <ConfirmModal
        visible={params.action === "tax-invoice-issued" && taxInvoiceId !== null}
        onOk={() => handleTaxInvoiceIssue(taxInvoiceId)}
        onCancel={closeModal}
        modalTitleText="세금계산서 발행"
        helpText="세금계산서를 발행하시겠습니까?"
      />
    </>
  );
};

export default B2bTaxInvoiceListView;
</file>

