<file path="src/app/views/notice/notices/components/RequestToHqCommentList.tsx">
import { utils } from "@utils/utils";
import { List, Typography } from "antd";
import React, { useEffect, useRef } from "react";

import { BrandStoreRequestToHqDetails_brandStoreRequestToHq_comments } from "../api/types/BrandStoreRequestToHqDetails";

interface RequestToHqCommentListProps {
  comments: BrandStoreRequestToHqDetails_brandStoreRequestToHq_comments[];
}

export const RequestToHqCommentList: React.FC<RequestToHqCommentListProps> = ({ comments }) => {
  const listRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (listRef.current) {
      listRef.current.scrollTo({
        top: listRef.current.scrollHeight,
        behavior: "smooth",
      });
    }
  }, [comments.length]);

  if (utils.isEmpty(comments)) {
    return null; // 아무것도 렌더링하지 않음
  }

  return (
    <div ref={listRef} style={{ maxHeight: "50vh", overflow: "auto" }}>
      <List
        dataSource={comments}
        renderItem={(comment) => {
          const isFromHq = comment.isFromHq;
          return (
            <div
              style={{
                display: "flex",
                justifyContent: !isFromHq ? "flex-start" : "flex-end",
                marginBottom: 12,
              }}
            >
              <div
                style={{
                  backgroundColor: !isFromHq ? "#f0f0f0" : "#d6f4ff",
                  padding: "8px 12px",
                  borderRadius: 8,
                  maxWidth: "70%",
                  textAlign: "left",
                }}
              >
                <Typography.Text style={{ fontSize: 12, color: "#888" }}>
                  {new Date(comment.createdAt).toLocaleString()}
                </Typography.Text>
                <div style={{ marginTop: 4 }}>
                  <Typography.Text style={{ whiteSpace: "pre-line" }}>{comment.content}</Typography.Text>
                </div>
              </div>
            </div>
          );
        }}
      />
    </div>
  );
};
</file>

<file path="src/app/views/notice/notices/views/BossToHqNoticeListView/BossToHqNoticeListView.tsx">
import useUser from "@hooks/useUser";
import { NoticeFilterInput } from "@src/api/types/globalTypes";
import {
  bossToHqNoticeCreateViewUrl,
  bossToHqNoticeDetailsViewUrl,
  bossToHqNoticeListViewUrl,
  BossToHqNoticeListViewUrlQueryParams,
} from "@src/app/views/notice/notices/urls";
import { ListViews } from "@src/global/core/types/types";
import createSortHandler from "@utils/handlers/sortHandler";
import { maybe } from "@utils/misc";
import { getSortParams } from "@utils/sort";
import { utils } from "@utils/utils";
import React from "react";

import { useFromBossNoticeListQuery } from "../../api/queries";
import { FromBossNoticesVariables } from "../../api/types/FromBossNotices";
import BossToHqNoticeListPage from "../../components/BossToHqNoticeListPage";
import { getSortQueryVariables } from "./sort";

interface BossToHqNoticeListViewProps {
  params: BossToHqNoticeListViewUrlQueryParams;
  isHqNotice: boolean;
}

// 포장보스 → 가맹본부 공지
export const BossToHqNoticeListView: React.FC<BossToHqNoticeListViewProps> = ({ params, isHqNotice }) => {
  const { user } = useUser();
  const isAdmin = user?.isStaff || user?.isSuperuser;

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.BOSS_TO_HQ_NOTICE_LIST,
  });

  const filterVariables: NoticeFilterInput = { isHqNotice, availableBrand: user?.brand?.id };
  const queryVariables: FromBossNoticesVariables = React.useMemo(
    () => ({ ...paginationState, sort: getSortQueryVariables(params), filter: filterVariables }),
    [params]
  );

  const { data, loading } = useFromBossNoticeListQuery({ variables: queryVariables });

  const handleSort = createSortHandler(navigate, bossToHqNoticeListViewUrl, params);

  const { loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.fromBossNotices?.pageInfo,
    paginationState,
    params,
  });

  return (
    <>
      <BossToHqNoticeListPage
        onAdd={() => navigate(bossToHqNoticeCreateViewUrl)}
        disabled={loading}
        notices={maybe(() => data.fromBossNotices.edges.map((edge) => edge.node))}
        settings={settings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onSort={handleSort}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        sort={getSortParams(params)}
        onRowClick={(id) => navigate(bossToHqNoticeDetailsViewUrl(id))}
        isAdmin={isAdmin}
      />
    </>
  );
};
