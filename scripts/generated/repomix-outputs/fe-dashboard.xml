import { ProductVariantFragment } from "@src/api/fragments/types/ProductVariantFragment";
import { SearchProducts_search_edges_node } from "@src/api/searches/types/SearchProducts";
import { utils } from "@utils/utils";

import { ProductDetails_product } from "../api/types/ProductDetails";
import { ProductVariantList_productVariants_edges_node_outer } from "../api/types/ProductVariantList";

export const checkHasVariants = (product: Pick<SearchProducts_search_edges_node, "productType">) => {
  if (!product) {
    return false;
  }
  return product.productType.hasVariants;
};

// 기초 재고 = 최근 30일 일평균 판매량 * 발주 리드타임(L/T)
export const calcBasicStockQty = ({
  last30DaysAvgSalesDailyQty,
  poLeadTime,
}: {
  last30DaysAvgSalesDailyQty: number;
  poLeadTime: number;
}) => {
  if (utils.isEmpty(last30DaysAvgSalesDailyQty) || utils.isEmpty(poLeadTime)) {
    return undefined;
  }
  return utils.convertToNumber(last30DaysAvgSalesDailyQty * poLeadTime, 2);
};

// 안전 재고 = 최근 30일 일평균 판매량 * 30 * 중요도 팩터
export const calcSafetyStockQty = ({
  last30DaysAvgSalesDailyQty,
  priorityLevelNumericValue,
}: {
  last30DaysAvgSalesDailyQty: number;
  priorityLevelNumericValue: number;
}) => {
  if (utils.isEmpty(last30DaysAvgSalesDailyQty) || utils.isEmpty(priorityLevelNumericValue)) {
    return undefined;
  }
  return utils.convertToNumber(last30DaysAvgSalesDailyQty * 30 * priorityLevelNumericValue, 2);
};

// 재발주점 = 안전 재고 + 기초재고
export const calcRop = ({
  last30DaysAvgSalesDailyQty,
  poLeadTime,
  stockAdjustFactor,
  priorityLevelNumericValue,
}: {
  last30DaysAvgSalesDailyQty: number;
  poLeadTime: number;
  stockAdjustFactor: number;
  priorityLevelNumericValue: number;
}) => {
  const safetyStockQty = calcSafetyStockQty({
    last30DaysAvgSalesDailyQty,
    priorityLevelNumericValue,
  });
  const basicStockStockQty = calcBasicStockQty({
    last30DaysAvgSalesDailyQty,
    poLeadTime,
  });
  if (utils.isEmpty(safetyStockQty) || utils.isEmpty(basicStockStockQty)) {
    return undefined;
  }
  return utils.convertToNumber(safetyStockQty + basicStockStockQty + stockAdjustFactor, 2);
};

export const calcPackCount = (outerVariant: { qtyPerBox: number }, innerVariant: { qtyPerBox: number }) => {
  if (!outerVariant || !innerVariant) {
    return 1;
  }
  if (outerVariant.qtyPerBox <= 0 || innerVariant.qtyPerBox <= 0) {
    return 1;
  }
  return Math.ceil(outerVariant.qtyPerBox / innerVariant.qtyPerBox);
};

export const calcInnerPVVendorProductPriceExcludeVatByOuter = (
  outerVariant: ProductVariantFragment | ProductVariantList_productVariants_edges_node_outer,
  packCount: number
) => {
  if (!outerVariant || packCount <= 0) {
    return 0;
  }
  const defaultVariantVendor = (outerVariant.productVariantVendors as Array<{ id; productPriceExcludeVat }>).find(
    (vendor) => vendor.id === outerVariant.defaultVariantVendor?.id
  );
  if (!defaultVariantVendor) {
    return 0;
  }
  return Math.round(defaultVariantVendor.productPriceExcludeVat / packCount);
};

export const calcInnerPVVendorDeliveryFeeExcludeVatByOuter = (
  outerVariant: ProductVariantFragment | ProductVariantList_productVariants_edges_node_outer,
  packCount: number
) => {
  if (!outerVariant || packCount <= 0) {
    return 0;
  }
  const defaultVariantVendor = (outerVariant.productVariantVendors as Array<{ id; deliveryFeeExcludeVat }>).find(
    (vendor) => vendor.id === outerVariant.defaultVariantVendor?.id
  );
  if (!defaultVariantVendor) {
    return 0;
  }
  return Math.round(defaultVariantVendor.deliveryFeeExcludeVat / packCount);
};

export const calcInnerPVVendorCostPriceExcludeVatByOuter = (
  outerVariant: ProductVariantFragment | ProductVariantList_productVariants_edges_node_outer,
  packCount: number
) => {
  if (!outerVariant || packCount <= 0) {
    return 0;
  }
  const defaultVariantVendor = (outerVariant.productVariantVendors as Array<{ id }>).find(
    (vendor) => vendor.id === outerVariant.defaultVariantVendor?.id
  );
  if (!defaultVariantVendor) {
    return 0;
  }
  const productPriceExcludeVat = calcInnerPVVendorProductPriceExcludeVatByOuter(outerVariant, packCount);
  const deliveryFeeExcludeVat = calcInnerPVVendorDeliveryFeeExcludeVatByOuter(outerVariant, packCount);
  return productPriceExcludeVat + deliveryFeeExcludeVat;
};

export const getDefaultVariant = (product: ProductDetails_product) => {
  if (!product) {
    return null;
  }
  const { outerVariants } = product;
  if (utils.isEmpty(product.defaultVariant) || utils.isEmpty(outerVariants) || outerVariants.length === 0) {
    return null;
  }
  const defaultVariant = outerVariants.find((variant) => variant.id === product.defaultVariant.id);
  return utils.isEmpty(defaultVariant) ? outerVariants[0] : defaultVariant;
};
