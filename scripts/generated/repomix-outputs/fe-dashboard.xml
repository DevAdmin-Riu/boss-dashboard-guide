import { DownloadOutlined, UploadOutlined } from "@ant-design/icons";
import { ApolloQueryResult } from "@apollo/client";
import { s3TemplateUrl } from "@assets/constants/config";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { User } from "@src/api/fragments/types/User";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { ShopInfo_shop } from "@src/app/providers/ShopProvider/types/ShopInfo";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { numberOfBrandStores } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React, { useState } from "react";

import {
  BrandStoreList,
  BrandStoreList_brandStores_edges_node,
  BrandStoreListVariables,
} from "../../api/types/BrandStoreList";
import { BrandStoreBulkCreateModal } from "../BrandStoreBulkCreateModal";
import { getBrandStoreListTableSettings } from "./BrandStoreTableSettings";
import { BrandStoreListFilterKeys, BrandStoreListFilterOpts, createFilterStructure } from "./filters";

enum BrandStoreListModalModeEnum {
  BulkCreate = "BulkCreate",
}

export interface BrandStoreListPageProps
  extends PaginateListProps,
    FilterPageProps<BrandStoreListFilterKeys, BrandStoreListFilterOpts> {
  me: User;
  brandStores: BrandStoreList_brandStores_edges_node[];
  shop: ShopInfo_shop;
  isHqStaff: boolean;
  onBrandStoreCreate: () => void;

  queryVariablesWithoutPagination: BrandStoreListVariables;
  fetchForDownload: (variables?: BrandStoreListVariables) => Promise<ApolloQueryResult<BrandStoreList>>;
}
const BrandStoreListPage: React.FC<BrandStoreListPageProps> = (props) => {
  const {
    shop,
    isHqStaff,
    me,
    currencySymbol,
    currentTab,
    filterOpts,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    onBrandStoreCreate,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;

  const [modalMode, setModalMode] = useState<BrandStoreListModalModeEnum>(null);
  const totalBrandStores = numberOfBrandStores(me);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const filterStructure = createFilterStructure(filterOpts, isHqStaff, shop);
  const columns = getBrandStoreListTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const titleText = isHqStaff ? `전체 매장 수(운영 중): ${totalBrandStores}` : sectionNames.brandStoreList;

  const brandStoreCreateButtons = (
    <Space direction="horizontal" size={8}>
      <Button type="primary" shape="round" onClick={onBrandStoreCreate}>
        매장 생성
      </Button>
      <Button
        type="primary"
        shape="round"
        icon={<UploadOutlined />}
        onClick={() => setModalMode(BrandStoreListModalModeEnum.BulkCreate)}
      >
        매장 일괄 생성
      </Button>
      <Button
        type="default"
        shape="round"
        icon={<DownloadOutlined />}
        href={`${s3TemplateUrl}/brand_store_bulk_create.xlsx`}
        target="_blank"
      >
        매장 생성 양식
      </Button>
    </Space>
  );

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "brandStores",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{titleText}</Typography.Title>
        </Col>
        <Col>{brandStoreCreateButtons}</Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={listProps.brandStores}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
        <BrandStoreBulkCreateModal
          open={modalMode === BrandStoreListModalModeEnum.BulkCreate}
          disabled={listProps.disabled}
          onClose={resetForCloseModal}
        />
      </Card>
    </Space>
  );
};
export default BrandStoreListPage;
</file>

