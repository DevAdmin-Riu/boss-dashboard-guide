import { ApolloQueryResult } from "@apollo/client";
import { commonMsg } from "@assets/messages/commonMsg";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import {
  BrandProductStats,
  BrandProductStats_brandProductStats,
} from "@src/app/views/hqStaff/hqSection/api/types/BrandProductStats";
import { SimpleAttribute } from "@src/app/views/product/products/utils/data";
import { makeHeaderRowsAndMerges, toPriceExcludeVat } from "@utils/excel/excelDownload";
import {
  transformIsExclusive,
  transformIsInner,
  transformSalesStatusByBrandProductVariant,
  transformSalesStatusByProductVariant,
} from "@utils/misc";
import { utils } from "@utils/utils";

export interface ProductStatsForTable extends BrandProductStats_brandProductStats {
  rank: number;
  sku: string;
  brandProductName: string;
  variantName: string;
  simpleAttribute: SimpleAttribute;
  unitPrice: number;
  brandUnitCostPrice: number;
  brandUnitDeliveryFee: number;
  profitRate: string;
  statQuantity: number;
  statTotalPriceExcludeVat: number;
}

const productStatsKeysToMerge = {
  product: "[상품 정보]",
  sale: "[판매 현황]",
};

export function parseProductStats(res: ApolloQueryResult<BrandProductStats>) {
  const data = getProductStatsForTable(res.data?.brandProductStats);

  const results: any = data.flatMap((stat: ProductStatsForTable) => {
    const rank = stat.rank;
    const isBundle = stat.bpBundleSalesStatus !== null;

    const sku = stat.sku || "-";
    const brandProductName = stat.brandProductName || "-";
    const variantName = stat.variantName || "-";
    // 세트상품인 경우 "-" 표시
    const isInner = isBundle ? "-" : transformIsInner(stat.isInner);
    const isExclusive = transformIsExclusive(stat.isExclusive);
    // 세트상품인 경우 "-" 표시
    const variantSalesStatus = isBundle ? "-" : transformSalesStatusByProductVariant(stat.variantSalesStatus);
    // 세트상품인 경우 bpBundleSalesStatus 사용, 아닌 경우 bpvSalesStatus 사용
    const bpvSalesStatus = transformSalesStatusByBrandProductVariant(stat.bpBundleSalesStatus ?? stat.bpvSalesStatus);
    const unitBrandPriceExcludeVat =
      toPriceExcludeVat(stat.brandUnitCostPrice, stat.isTaxFree) + toPriceExcludeVat(stat.brandUnitDeliveryFee);
    const unitPriceExcludeVat = toPriceExcludeVat(stat.unitPrice, stat.isTaxFree);

    const statQuantity = stat.statQuantity;
    const statTotalPriceExcludeVat = stat.statTotalPriceExcludeVat;

    const row = {
      순위: rank,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.SKU]: sku,
      [productStatsKeysToMerge.product + "\n상품명"]: brandProductName,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.VARIANT_NAME]: variantName,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.IS_INNER]: isInner,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.brand.IS_EXCLUSIVE]: isExclusive,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.SALES_STATUS]: variantSalesStatus,
      [productStatsKeysToMerge.product + "\n" + columnNameConstant.brandProduct.SALE_STATUS]: bpvSalesStatus,
      [productStatsKeysToMerge.product + "\n계약 매입가\n" + commonMsg.excludeVat]: unitBrandPriceExcludeVat,
      [productStatsKeysToMerge.product + "\n매장 판매가\n" + commonMsg.excludeVat]: unitPriceExcludeVat,
      [productStatsKeysToMerge.sale + "\n판매수량"]: statQuantity,
      [productStatsKeysToMerge.sale + "\n판매총액\n" + commonMsg.excludeVat]: statTotalPriceExcludeVat,
    };

    return row;
  });

  const defaultRow = {
    순위: "-",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.SKU]: "없음",
    [productStatsKeysToMerge.product + "\n상품명"]: "없음",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.VARIANT_NAME]: "없음",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.IS_INNER]: "없음",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.brand.IS_EXCLUSIVE]: "없음",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.product.SALES_STATUS]: "없음",
    [productStatsKeysToMerge.product + "\n" + columnNameConstant.brandProduct.SALE_STATUS]: "없음",
    [productStatsKeysToMerge.product + "\n계약 매입가\n" + commonMsg.excludeVat]: 0,
    [productStatsKeysToMerge.product + "\n매장 판매가\n" + commonMsg.excludeVat]: 0,
    [productStatsKeysToMerge.sale + "\n판매수량"]: 0,
    [productStatsKeysToMerge.sale + "\n판매총액\n" + commonMsg.excludeVat]: 0,
  };

  const columns = results.length === 0 ? [defaultRow] : results;
  const { header, merges } = makeHeaderRowsAndMerges(columns[0]);
  return { columns, header, merges };
}

export function getProductStatsForTable(dataSource: BrandProductStats_brandProductStats[]): ProductStatsForTable[] {
  const dataForTable = [];
  const length = dataSource.length;

  for (let i = 0; i < length; i++) {
    const statsElement = dataSource[i];
    const dataElement: ProductStatsForTable = {
      ...statsElement,
      rank: i + 1,
      sku: "",
      brandProductName: "",
      variantName: "",
      simpleAttribute: null,
      unitPrice: 0,
      brandUnitCostPrice: 0,
      brandUnitDeliveryFee: 0,
      profitRate: "",
      statQuantity: 0,
      statTotalPriceExcludeVat: 0,
    };

    dataElement.sku = statsElement.productInfo.productSku;
    dataElement.brandProductName = statsElement.productInfo.brandProductName;
    dataElement.variantName = statsElement.productInfo.variantName;
    dataElement.simpleAttribute = statsElement.productInfo.attributeData;
    dataElement.unitPrice = statsElement.statUnitPrice;
    dataElement.brandUnitCostPrice = statsElement.statBrandUnitCostPrice;
    dataElement.brandUnitDeliveryFee = statsElement.statBrandUnitDeliveryFee;
    dataElement.profitRate = utils.calcBrandProfitRate(
      statsElement.statUnitPrice,
      statsElement.statBrandUnitCostPrice + statsElement.statBrandUnitDeliveryFee
    );
    dataElement.statQuantity = statsElement.statQuantity;
    dataElement.statTotalPriceExcludeVat = statsElement.statTotalPriceExcludeVat;

    dataForTable.push(dataElement);
  }
  return dataForTable;
}
</file>

