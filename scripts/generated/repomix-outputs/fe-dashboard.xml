import { useWarehouseList } from "@src/app/views/settings/warehouses/api/queries";
import { warehouseCreateViewPath } from "@src/app/views/settings/warehouses/urls";
import { DEFAULT_INITIAL_SEARCH_DATA, GrapheneRelayConnectionMaxLimitEnum } from "@src/global/assets/constants/config";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import createDialogActionHandlersForBulkAction from "@utils/handlers/dialogActionHandlersForBulkAction";
import { getMutationState, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrorInfo, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Divider, Space, Typography } from "antd";
import React from "react";
import { useLocation } from "react-router";

import { productDetailsQuery, useBrandProductVariantQuery, useProductDetailsQuery } from "../../api/queries";
import {
  BrandProductVariant_brandProductVariant,
  BrandProductVariant_brandProductVariant_brandProduct_product,
} from "../../api/types/BrandProductVariant";
import { FbvMixedProductUpdate } from "../../api/types/FbvMixedProductUpdate";
import { ProductDetails_product, ProductDetails_product_outerVariants } from "../../api/types/ProductDetails";
import { ProductImageCreateVariables } from "../../api/types/ProductImageCreate";
import { DevPvAssignModal } from "../../components/DevPvAssignModal/DevPvAssignModal";
import { MainPvsBulkAssignModal } from "../../components/MainPvsBulkAssignModal/MainPvsBulkAssignModal";
import { ProductUpdatePage } from "../../components/ProductUpdatePage/ProductUpdatePage";
import { ProductVariantManageEventModal } from "../../components/PvOrBpvManageEventModal";
import { SubPvAssignModal } from "../../components/SubPvAssignModal/SubPvAssignModal";
import {
  productCreateViewUrl,
  productImageViewUrl,
  productUpdateViewUrl,
  ProductUpdateViewUrlDialog,
  ProductUpdateViewUrlQueryParams,
  productVariantCreateViewUrl,
  productVariantUpdateViewUrl,
} from "../../urls";
import { getProductVariantSku, productVariantManageEventTypeChoices } from "../../utils/data";
import { getDefaultVariant } from "../../utils/utils";
import {
  createImageReorderHandler,
  createImageUploadHandler,
  createUpdateHandler,
  createVariantReorderHandler,
} from "./handlers";

interface ProductUpdateViewProps {
  id: string;
  params: ProductUpdateViewUrlQueryParams;
  isFbv: boolean;
}

export const ProductUpdateView: React.FC<ProductUpdateViewProps> = ({ id, params, isFbv }) => {
  const location = useLocation();
  const historyState = location?.state as { ids: string[] };
  const navigate = useNavigator();
  const { user } = useUser();
  const { isStaff } = user;

  const {
    loadMore: loadMoreCollections,
    search: searchCollections,
    result: searchCollectionsOpts,
  } = useCollectionSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });

  const {
    loadMore: loadMoreMakers,
    search: searchMakers,
    result: searchMakersOpts,
  } = useMakerSearch({
    variables: DEFAULT_INITIAL_SEARCH_DATA,
  });

  const warehouses = useWarehouseList({
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.warehouses,
    },
  });

  const { data, loading, refetch } = isFbv
    ? useBrandProductVariantQuery({ variables: { id } })
    : useProductDetailsQuery({ variables: { id } });

  const productData = data
    ? "product" in data
      ? data?.product
      : data?.brandProductVariant?.brandProduct.product
    : null;
  const [product] = useStateFromProps(productData);

  const brandProductVariant: BrandProductVariant_brandProductVariant =
    data && "brandProductVariant" in data && data?.brandProductVariant;

  const handleUpdateExtendedProduct = (data: ExtendedProductUpdate) => {
    const errors = data.extendedProductUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
      closeModal();
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [updateExtendedProduct, updateExtendedProductOpts] = useExtendedProductUpdateMutation({
    onCompleted: handleUpdateExtendedProduct,
  });

  const handleFbvMixedProductUpdate = (data: FbvMixedProductUpdate) => {
    const errors = data.fbvMixedProductUpdate.errors;
    if (errors.length === 0) {
      showNotificationSuccess(commonMsg.savedChanges);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };
  const [fbvMixedProductUpdate, fbvMixedProductUpdateOpts] = useFbvMixedProductUpdateMutation({
    onCompleted: handleFbvMixedProductUpdate,
  });

  const [reorderProductImages, reorderProductImagesOpts] = useProductImagesReorder({});

  const [createProductImage, createProductImageOpts] = useProductImageCreateMutation({
    onCompleted: (data) => {
      const errors = data.productImageCreate.errors;
      if (errors.length !== 0) {
        if (errors.find((error) => error.field === ("image" as keyof ProductImageCreateVariables))) {
          showGqlErrorInfo("이미지 필드 오류로 제품 이미지 생성에 실패했습니다.", "ImageError");
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
  });

  const [deleteProductImage] = useProductImageDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productImageDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [productVariantOnSale, productVariantOnSaleOpts] = useProductVariantOnSaleMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantOnSale?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("판매 가능 알림이 발송되었습니다.");
        refetch();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bulkProductVariantDelete, bulkProductVariantDeleteOpts] = useProductVariantBulkDeleteMutation({
    onCompleted: (data) => {
      const errors = data.productVariantBulkDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess(commonMsg.savedChanges);
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [productDetailsQuery],
  });

  const [setProductVariantVendorDefault, setProductVariantVendorDefaultOpts] =
    useProductVariantVendorSetDefaultMutation({
      onCompleted: (data) => {
        const errors = data?.productVariantVendorSetDefault?.errors;
        if (errors?.length === 0) {
          showNotificationSuccess(commonMsg.savedChanges);
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      },
    });

  const [assignSubPvToMainPv, assignSubPvToMainPvOpts] = useAssignSubPvToMainPvMutation({
    onCompleted: (data) => {
      const errors = data?.assignSubPvToMainPv?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("선택한 제품이 소모 부자재로 연동되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [unassignSubPvFromMainPv, unassignSubPvFromMainPvOpts] = useUnassignSubPvFromMainPvMutation({
    onCompleted: (data) => {
      const errors = data?.unassignSubPvFromMainPv?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("연동되어있던 소모 부자재 제품이 연동 해제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bulkAssignMainPvsToSubPv, bulkAssignMainPvsToSubPvOpts] = useBulkAssignMainPvsToSubPvMutation({
    onCompleted: (data) => {
      const errors = data?.bulkAssignMainPvsToSubPv?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("선택한 제품들에 대한 부자재로 연동되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [bulkUnassignMainPvsFromSubPv, bulkUnassignMainPvsFromSubPvOpts] = useBulkUnassignMainPvsFromSubPvMutation({
    onCompleted: (data) => {
      const errors = data?.bulkUnassignMainPvsFromSubPv?.errors;
      if (errors?.length === 0) {
        showNotificationSuccess("선택한 제품들에 대한 부자재 연동이 해제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const [openModal, closeModal] = createDialogActionHandlersForBulkAction<
    ProductUpdateViewUrlDialog,
    ProductUpdateViewUrlQueryParams
  >(navigate, (params) => productUpdateViewUrl(id, params), params);

  const brandProductVariantId =
    isFbv && data && "brandProductVariant" in data && data?.brandProductVariant?.brandProduct.product?.id;

  const windowTitle = `${product?.name || "-"} 제품 상세`;

  const handleBack = () => history.back();
  const handleVariantAdd = () => navigate(productVariantCreateViewUrl(id));

  const handleImageDelete = (id: string) => deleteProductImage({ variables: { id } });
  const productId = isFbv ? brandProductVariant?.brandProduct?.product?.id : id;
  const handleImageEdit = (imageId: string) => navigate(productImageViewUrl(productId, imageId));
  const handleSubmit = createUpdateHandler(
    product,
    brandProductVariant,
    (variables) => updateExtendedProduct({ variables }),
    (variables) => fbvMixedProductUpdate({ variables })
  );
  const handleImageUpload = createImageUploadHandler(isFbv ? brandProductVariantId : id, (variables) =>
    createProductImage({ variables })
  );
  const handleImageReorder = createImageReorderHandler(product, (variables) => reorderProductImages({ variables }));

  const [reorderProductVariants, reorderProductVariantsOpts] = useProductVariantReorderMutation({
    onCompleted: (data) => {
      const errors = data?.productVariantReorder?.errors;
      if (errors.length === 0) {
        showNotificationSuccess("옵션 순서가 변경되었습니다.");
      }
    },
  });

  const handleVariantReorder = createVariantReorderHandler(product, (variables) =>
    reorderProductVariants({ variables })
  );

  const disableFormSave =
    fbvMixedProductUpdateOpts.loading ||
    updateExtendedProductOpts.loading ||
    createProductImageOpts.loading ||
    reorderProductImagesOpts.loading ||
    reorderProductVariantsOpts.loading ||
    setProductVariantVendorDefaultOpts.loading ||
    assignSubPvToMainPvOpts.loading ||
    unassignSubPvFromMainPvOpts.loading ||
    bulkAssignMainPvsToSubPvOpts.loading ||
    bulkUnassignMainPvsFromSubPvOpts.loading ||
    loading;

  const formTransitionState = getMutationState(
    updateExtendedProductOpts.called,
    updateExtendedProductOpts.loading,
    maybe(() => updateExtendedProductOpts.data.extendedProductUpdate.errors)
  );

  const collections = maybe(() => searchCollectionsOpts.data.search.edges, []).map((edge) => edge.node);
  const makers = maybe(() => searchMakersOpts.data.search.edges, []).map((edge) => edge.node);
  const formErrors = [...maybe(() => updateExtendedProductOpts.data.extendedProductUpdate.errors, [])];
  const onSetDefaultVariant = useOnSetDefaultVariant(product?.id, null);

  if (product === null && loading === false) {
    return <ErrorPage type={ErrorPageEnum.DataMissing} onBack={handleBack} />;
  }
  if (utils.isEmpty(product)) {
    return <></>;
  }

  const defaultVariant = getDefaultVariant(product);
  const sku = getProductVariantSku(defaultVariant as ProductDetails_product_outerVariants);

  const copyProduct = (
    product: ProductDetails_product | BrandProductVariant_brandProductVariant_brandProduct_product
  ) => {
    navigate(
      productCreateViewUrl({ isFulfilledByVendor: product.isFulfilledByVendor, categoryKind: product.category.kind }),
      false,
      false,
      { productForCopy: product }
    );
  };

  return (
    <>
      <WindowTitle title={windowTitle} />
      <ProductUpdatePage
        isStaff={isStaff}
        collections={collections}
        makers={makers}
        disabled={disableFormSave}
        onSetDefaultVariant={onSetDefaultVariant}
        errors={formErrors}
        fetchCollections={searchCollections}
        fetchMakers={searchMakers}
        saveButtonBarState={formTransitionState}
        images={maybe(() => product.images)}
        header={windowTitle}
        placeholderImage={placeholderImg}
        product={product}
        brandProductVariant={brandProductVariant || null}
        warehouses={warehouses?.data?.warehouses.edges.map((edge) => edge.node) || []}
        variants={maybe(() => product.outerVariants)}
        onBack={handleBack}
        onCopy={() => openModal("copy")}
        onDelete={null}
        onSubmit={handleSubmit}
        onWarehouseConfigure={() => navigate(warehouseCreateViewPath)}
        onVariantAdd={handleVariantAdd}
        onVariantShow={(variantId) => navigate(productVariantUpdateViewUrl(product.id, variantId))}
        onVariantUpdate={(variantId, productVariantInput, additionalInput, productToBeChangedInfoCreateInput) =>
          updateExtendedProduct({
            variables: {
              productVariantId: variantId,
              productVariantInput,
              productToBeChangedInfoCreateInput,
              additionalInput,
            },
          })
        }
        onVariantVendorSetDefault={(productVariantId, variantVendorId, manageEvent) =>
          setProductVariantVendorDefault({ variables: { productVariantId, variantVendorId, manageEvent } })
        }
        onVariantReorder={handleVariantReorder}
        onProductClick={(productId) => navigate(productUpdateViewUrl(productId))}
        onAssignSubPv={() => openModal("assign-sub-pv")}
        onUnassignSubPv={(subPvId) => openModal("unassign-sub-pv", { id: subPvId })}
        onBulkAssignMainPvs={() => openModal("bulk-assign-main-pvs")}
        onBulkUnassignMainPvs={(mainPvIds) => openModal("bulk-unassign-main-pvs", { ids: mainPvIds })}
        onAssignDevPv={() => openModal("assign-dev-pv")}
        onUnassignDevPv={() => openModal("unassign-dev-pv")}
        onAssignStandardPv={() => openModal("assign-standard-pv")}
        onUnassignStandardPv={() => openModal("unassign-standard-pv")}
        onImageUpload={handleImageUpload}
        onImageEdit={handleImageEdit}
        onImageDelete={handleImageDelete}
        onImageReorder={handleImageReorder}
        onProductVariantOnSale={(targetVariantId: string, recipientList: string[]) => {
          productVariantOnSale({ variables: { id: targetVariantId, recipientList } });
        }}
        productVariantOnSaleLoading={productVariantOnSaleOpts.loading}
        fetchMoreCollections={{
          hasMore: maybe(() => searchCollectionsOpts.data.search.pageInfo.hasNextPage),
          loading: searchCollectionsOpts.loading,
          onFetchMore: loadMoreCollections,
        }}
        fetchMoreMakers={{
          hasMore: maybe(() => searchMakersOpts.data.search.pageInfo.hasNextPage),
          loading: searchMakersOpts.loading,
          onFetchMore: loadMoreMakers,
        }}
      />
      <ActionDialog
        open={params.action === "copy"}
        onClose={closeModal}
        confirmButtonState={"default"}
        onConfirm={() => copyProduct(product)}
        variant="default"
        title="제품 복사 생성"
        children={
          <Space direction="vertical">
            <Typography.Text strong>제품코드: {sku ? sku : "-"}</Typography.Text>
            <Typography.Text strong>제품명: {product ? product.name : "-"}</Typography.Text>
            <Divider />
            <Typography.Text>위 제품을 복사해서 제품을 새로 생성하시겠습니까?</Typography.Text>
          </Space>
        }
      ></ActionDialog>
      <ActionDialog
        open={params.action === "remove-variants"}
        onClose={closeModal}
        confirmButtonState={bulkProductVariantDeleteOpts.status}
        onConfirm={() =>
          bulkProductVariantDelete({
            variables: {
              ids: historyState?.ids,
            },
          })
        }
        variant="delete"
        title="제품 옵션 삭제"
      >
        <DialogContentText>
          {historyState?.ids?.length === 1
            ? "이 옵션을 삭제하시겠습니까?"
            : `${historyState?.ids?.length}개의 옵션을 삭제하시겠습니까?`}
        </DialogContentText>
      </ActionDialog>
      <SubPvAssignModal
        includeManageEvent
        loading={disableFormSave}
        open={params.action === "assign-sub-pv"}
        mainPvId={defaultVariant?.id}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          assignSubPvToMainPv({ variables: { input: { ...restInput } } });
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "unassign-sub-pv"}
        loading={disableFormSave}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_SUB_PV}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          unassignSubPvFromMainPv({
            variables: {
              input: {
                mainPvId: defaultVariant?.id,
                subPvId: params.id,
                ...restInput,
                manageEvent: formData.manageEvent as ProductVariantManageEventInput,
              },
            },
          });
        }}
        onCancel={closeModal}
      />
      <MainPvsBulkAssignModal
        loading={disableFormSave}
        open={params.action === "bulk-assign-main-pvs"}
        subPvId={defaultVariant?.id}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          bulkAssignMainPvsToSubPv({ variables: { input: { ...restInput } } });
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "bulk-unassign-main-pvs"}
        loading={disableFormSave}
        manageEventType={ProductVariantManageEventTypeEnum.TYPE_SUB_PV}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          const { needReason, ...restInput } = formData;
          bulkUnassignMainPvsFromSubPv({
            variables: {
              input: {
                subPvId: defaultVariant.id,
                mainPvIds: historyState?.ids,
                ...restInput,
                manageEvent: formData.manageEvent as ProductVariantManageEventInput,
              },
            },
          });
        }}
        onCancel={closeModal}
      />
      <DevPvAssignModal
        loading={disableFormSave}
        open={params.action === "assign-dev-pv" || params.action === "assign-standard-pv"}
        isDevPvAssignMode={params.action === "assign-dev-pv"}
        onSubmit={(formData) => {
          const { variantIds, manageEvent } = formData;
          if (params.action === "assign-dev-pv") {
            updateExtendedProduct({
              variables: {
                productVariantId: defaultVariant.id,
                productVariantInput: { devPvs: variantIds },
                additionalInput: { manageEvent },
              },
            });
          } else {
            updateExtendedProduct({
              variables: {
                productVariantId: defaultVariant.id,
                productVariantInput: { devPvOf: variantIds[0] },
                additionalInput: { manageEvent },
              },
            });
          }
        }}
        onClose={closeModal}
      />
      <ProductVariantManageEventModal
        isCreateMode
        open={params.action === "unassign-dev-pv" || params.action === "unassign-standard-pv"}
        loading={disableFormSave}
        manageEventType={null}
        choices={productVariantManageEventTypeChoices}
        onSubmit={(formData) => {
          if (params.action === "unassign-dev-pv") {
            updateExtendedProduct({
              variables: {
                productVariantId: defaultVariant.id,
                productVariantInput: { devPvs: [] },
                additionalInput: { manageEvent: formData.manageEvent as ProductVariantManageEventInput },
              },
            });
          } else {
            updateExtendedProduct({
              variables: {
                productVariantId: defaultVariant.id,
                productVariantInput: { devPvOf: null },
                additionalInput: { manageEvent: formData.manageEvent as ProductVariantManageEventInput },
              },
            });
          }
        }}
        onCancel={closeModal}
      />
    </>
  );
};
</file>

<file path="src/app/views/product/products/views/ProductVariantManageEventListView/filters.ts">
import { ProductVariantManageEventFilterInput, ProductVariantManageEventTypeEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  ProductVariantManageEventListFilterKeys,
  ProductVariantManageEventListFilterOpts,
} from "../../components/ProductVariantManageEventListPage/filters";
import {
  ProductVariantManageEventListViewUrlFilters,
  ProductVariantManageEventListViewUrlFiltersEnum,
  ProductVariantManageEventListViewUrlQueryParams,
} from "../../urls";

const PRODUCT_VARIANT_MANAGE_EVENT_LIST_FILTERS_KEY = "productVariantManageEventListFilters";

export function getFilterOpts(
  params: ProductVariantManageEventListViewUrlFilters
): ProductVariantManageEventListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    created: {
      active: maybe(() => !utils.allEmpty([filterVariables.created.gte, filterVariables.created.lte]), false),
      value: {
        max: maybe(() => filterVariables.created.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.created.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    type: {
      active: maybe(() => !utils.isEmpty(filterVariables.type), false),
      value: maybe(() => filterVariables.type, null),
    },
    title: {
      active: maybe(() => !utils.isEmpty(filterVariables.title, true), false),
      value: maybe(() => filterVariables.title, ""),
    },
    onlyReasonExist: {
      active: maybe(() => !utils.isEmpty(filterVariables.onlyReasonExist, true), false),
      value: maybe(() => filterVariables.onlyReasonExist, true),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch, true), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch, true), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    userSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.userSearch, true), false),
      value: maybe(() => filterVariables.userSearch, ""),
    },
    isTbcInfoFrom: {
      active: maybe(() => !utils.isEmpty(filterVariables.isTbcInfoFrom), false),
      value: maybe(() => filterVariables.isTbcInfoFrom, false),
    },
  };
}

export function getFilterVariables(
  params: ProductVariantManageEventListViewUrlFilters
): ProductVariantManageEventFilterInput {
  return {
    created: getGteLteVariables({ gte: params.createdFrom, lte: params.createdTo }),
    type: params.type !== undefined ? findValueInEnum(params.type, ProductVariantManageEventTypeEnum) : null,
    title: params.title !== undefined ? params.title : null,
    onlyReasonExist: params.onlyReasonExist !== undefined ? parseBoolean(params.onlyReasonExist, false) : true,
    productSearch: params.productSearch !== undefined ? params.productSearch : null,
    vendorSearch: params.vendorSearch !== undefined ? params.vendorSearch : null,
    userSearch: params.userSearch !== undefined ? params.userSearch : null,
    isTbcInfoFrom: params.isTbcInfoFrom !== undefined ? parseBoolean(params.isTbcInfoFrom, false) : undefined,
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ProductVariantManageEventListFilterKeys>
): ProductVariantManageEventListViewUrlFilters {
  const { name } = filter;
  switch (name) {
    case ProductVariantManageEventListFilterKeys.created:
      return getMinMaxQueryParam(
        filter,
        ProductVariantManageEventListViewUrlFiltersEnum.createdFrom,
        ProductVariantManageEventListViewUrlFiltersEnum.createdTo
      );
    case ProductVariantManageEventListFilterKeys.type:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.type);
    case ProductVariantManageEventListFilterKeys.title:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.title);
    case ProductVariantManageEventListFilterKeys.onlyReasonExist:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.onlyReasonExist);
    case ProductVariantManageEventListFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.productSearch);
    case ProductVariantManageEventListFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.vendorSearch);
    case ProductVariantManageEventListFilterKeys.userSearch:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.userSearch);
    case ProductVariantManageEventListFilterKeys.isTbcInfoFrom:
      return getSingleValueQueryParam(filter, ProductVariantManageEventListViewUrlFiltersEnum.isTbcInfoFrom);
  }
}
export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<ProductVariantManageEventListViewUrlFilters>(PRODUCT_VARIANT_MANAGE_EVENT_LIST_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ProductVariantManageEventListViewUrlQueryParams,
  ProductVariantManageEventListViewUrlFilters
>({
  ...ProductVariantManageEventListViewUrlFiltersEnum,
});
