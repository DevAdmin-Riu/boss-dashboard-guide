import { WindowTitle } from "@src/app/components/WindowTitle";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { parse as parseQs } from "qs";
import React from "react";
import { Route, RouteComponentProps, Switch } from "react-router-dom";

import {
  shippingZoneCreateViewPath,
  shippingZoneDetailsViewPath,
  ShippingZoneDetailsViewUrlQueryParams,
  shippingZoneListViewPath,
  ShippingZoneListViewUrlQueryParams,
} from "./urls";
import { ShippingZoneCreateView } from "./views/ShippingZoneCreateView";
import { ShippingZoneDetailsView } from "./views/ShippingZoneDetailsView/ShippingZoneDetailsView";
import { ShippingZoneListView } from "./views/ShippingZoneListView";

const ShippingZonesListViewWrapper: React.FC<RouteComponentProps<{}>> = ({ location }) => {
  const qs = parseQs(location.search.substr(1));
  const params: ShippingZoneListViewUrlQueryParams = qs;
  return <ShippingZoneListView params={params} />;
};

interface ShippingZoneDetailsRouteProps {
  id: string;
}
const ShippingZoneDetailsViewWrapper: React.FC<RouteComponentProps<ShippingZoneDetailsRouteProps>> = ({
  location,
  match,
}) => {
  const qs = parseQs(location.search.substr(1));
  const params: ShippingZoneDetailsViewUrlQueryParams = qs;
  return <ShippingZoneDetailsView id={decodeURIComponent(match.params.id)} params={params} />;
};

export const ShippingRouter: React.FC = () => (
  <>
    <WindowTitle title={sectionNames.shipping} />
    <Switch>
      <Route exact path={shippingZoneListViewPath} component={ShippingZonesListViewWrapper} />
      <Route exact path={shippingZoneCreateViewPath} component={ShippingZoneCreateView} />
      <Route path={shippingZoneDetailsViewPath(":id")} component={ShippingZoneDetailsViewWrapper} />
    </Switch>
  </>
);
export default ShippingRouter;
