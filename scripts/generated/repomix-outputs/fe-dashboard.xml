<file path="src/app/views/customer/customers/components/AddressFormModal.tsx">
import { MutationFunction } from "@apollo/client";
import { CountryCode } from "@src/api/types/globalTypes";
import { getCollapseClassName } from "@src/app/components/antd/Collapse/CollapseProps";
import { getFormItemClassName } from "@src/app/components/antd/Form/FormProps";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getModalClassName } from "@src/app/components/antd/Modal/ModalProps";
import { makeAddressInputFromDaumPostcode, transformPhoneNumber } from "@utils/misc";
import { Button, Col, Collapse, Form, Input, Modal, Row, Typography } from "antd";
import { useForm } from "antd/es/form/Form";
import React from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

import { CreateCustomerAddress, CreateCustomerAddressVariables } from "../api/types/CreateCustomerAddress";
import { CustomerAddresses_user, CustomerAddresses_user_addresses } from "../api/types/CustomerAddresses";
import { UpdateCustomerAddress, UpdateCustomerAddressVariables } from "../api/types/UpdateCustomerAddress";

type AddressFormType = CreateCustomerAddressVariables | UpdateCustomerAddressVariables;

interface AddressFormModalProps {
  customer: CustomerAddresses_user;
  address: CustomerAddresses_user_addresses;
  hideModal: () => void;
  open: boolean;
  title: string;
  variant: "create" | "edit";
  createCustomerAddress?: MutationFunction<CreateCustomerAddress, CreateCustomerAddressVariables>;
  updateCustomerAddress: MutationFunction<UpdateCustomerAddress, UpdateCustomerAddressVariables>;
}

export const AddressFormModal: React.FC<AddressFormModalProps> = ({
  createCustomerAddress,
  updateCustomerAddress,
  hideModal,
  title,
  open,
  variant,
  address,
  customer,
}: AddressFormModalProps) => {
  const [form] = useForm<AddressFormType>();
  const TypeSafeForm = getTypeSafeForm<AddressFormType>(form);

  const [visibleSearchAddressForm, setVisibleSearchAddressForm] = React.useState(false);

  // 주소 검색으로 입력된 값으로 폼 값 세팅
  const searchAddress = (address: Address) => {
    const input = makeAddressInputFromDaumPostcode(address);
    TypeSafeForm.setFields([
      { name: "input.postalCode", value: input.postalCode },
      { name: "input.city", value: input.city },
      { name: "input.countryArea", value: input.countryArea },
      { name: "input.streetAddress1", value: input.streetAddress1 },
    ]);
    setVisibleSearchAddressForm(false);
  };

  React.useEffect(() => {
    // 주소 수정 모드 폼 초기화
    if (address) {
      TypeSafeForm.setFields([
        { name: "input.firstName", value: address?.firstName },
        { name: "input.phone", value: transformPhoneNumber(address?.phone) },
        { name: "input.postalCode", value: address?.postalCode },
        { name: "input.streetAddress1", value: address?.streetAddress1 },
        { name: "input.streetAddress2", value: address?.streetAddress2 },
        { name: "input.city", value: address?.city },
        { name: "input.countryArea", value: address?.countryArea },
      ]);
    }
  }, [address, customer]);

  const makeTitleUis = () => {
    const titleText = visibleSearchAddressForm ? "주소검색" : title;

    return (
      <>
        <Typography.Title level={4}>{titleText}</Typography.Title>
        {visibleSearchAddressForm && (
          <Typography.Text type="warning">검색된 주소 결과에서 정확한 주소지를 선택해 주세요.</Typography.Text>
        )}
      </>
    );
  };

  return (
    <Modal
      closable={false}
      title={makeTitleUis()}
      centered
      forceRender
      onCancel={() => {
        if (visibleSearchAddressForm) {
          setVisibleSearchAddressForm(false);
        } else {
          hideModal();
          form.resetFields();
        }
      }}
      onOk={() => TypeSafeForm.formInstance.submit()}
      okText="저장"
      okButtonProps={{ disabled: visibleSearchAddressForm }}
      open={open}
      className={getModalClassName(["ant-modal-full-screen"])}
      destroyOnClose
      maskClosable={false}
    >
      <Collapse
        defaultActiveKey="false"
        activeKey={String(visibleSearchAddressForm)}
        className={getCollapseClassName(["ant-collapse-no-style"])}
      >
        <Collapse.Panel forceRender header={null} key="false">
          <Form
            form={form}
            preserve={false}
            labelCol={{ span: 24 }}
            onFinish={async () => {
              if (variant === "create") {
                await createCustomerAddress({
                  variables: {
                    id: customer?.id,
                    input: {
                      ...TypeSafeForm.getFieldValue("input"),
                      country: CountryCode.KR,
                    },
                  },
                });
              } else {
                await updateCustomerAddress({
                  variables: {
                    id: address!.id,
                    input: {
                      ...TypeSafeForm.getFieldValue("input"),
                      country: CountryCode.KR,
                    },
                  },
                });
              }
            }}
          >
            <Typography.Title level={5}>배송지 주소</Typography.Title>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("input.firstName")}
              label="받으실 분"
              rules={[
                {
                  whitespace: true,
                  required: true,
                  message: "받으실 분은 필수항목입니다.",
                },
              ]}
            >
              <Input />
            </Form.Item>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex("input.phone")}
              label="연락처"
              rules={[
                {
                  whitespace: true,
                  required: true,
                  message: "연락처는 필수항목입니다.",
                },
              ]}
            >
              <Input />
            </Form.Item>
            <Row gutter={8}>
              <Col flex={1} style={{ width: "10%" }}>
                <Form.Item
                  name={TypeSafeForm.getValidDataIndex("input.postalCode")}
                  label="우편번호"
                  rules={[
                    {
                      required: true,
                      message: "우편번호는 필수항목입니다.",
                    },
                  ]}
                >
                  <Input disabled />
                </Form.Item>
              </Col>
              <Col>
                <Form.Item className={getFormItemClassName(["ant-form-item-empty-label"])}>
                  <Button
                    onClick={() => {
                      setVisibleSearchAddressForm(true);
                    }}
                  >
                    주소검색
                  </Button>
                </Form.Item>
              </Col>
            </Row>

            <Form.Item
              label="주소"
              rules={[
                {
                  required: true,
                  message: "주소는 필수항목입니다.",
                },
              ]}
            >
              <Input value={TypeSafeForm.getFieldValue("input.streetAddress1")} disabled />
            </Form.Item>

            <Form.Item name={TypeSafeForm.getValidDataIndex("input.streetAddress2")} label="상세주소">
              <Input />
            </Form.Item>
          </Form>
        </Collapse.Panel>
        <Collapse.Panel header="" key="true">
          <DaumPostcode onComplete={searchAddress} autoClose={false} submitMode={false} />
        </Collapse.Panel>
      </Collapse>
    </Modal>
  );
};
</file>

