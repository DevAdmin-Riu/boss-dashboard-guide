<file path="src/app/views/hqStaff/hqSection/components/HqStatsUser/utils.ts">
import { ApolloQueryResult } from "@apollo/client";
import { commonMsg } from "@assets/messages/commonMsg";
import { BrandUserStatsOrderByCapturedTotal } from "@src/app/views/hqStaff/hqSection/api/types/BrandUserStatsOrderByCapturedTotal";

export function parseUserStats(res: ApolloQueryResult<BrandUserStatsOrderByCapturedTotal>) {
  const statTotalColName = `판매총액\n${commonMsg.excludeVat}`;
  const results: any = res.data?.brandUserStats.flatMap((stat) => {
    const userName: string = stat.brandStoreName || stat.userInfo?.firstName || "-";
    const statOrderCount: number = stat.statOrderCount;
    const statTotalPriceExcludeVat: number = stat.statTotalPriceExcludeVat;
    const statQuantity: number = stat.statQuantity;

    const row = {
      매장명: userName,
      [statTotalColName]: statTotalPriceExcludeVat,
      주문건수: statOrderCount,
      판매수량: statQuantity,
    };

    return row;
  });

  const defaultRow = {
    매장명: "없음",
    [statTotalColName]: 0,
    "결제 건수": 0,
    주문건수: 0,
    판매수량: 0,
  };

  return results.length === 0 ? [defaultRow] : results;
}
