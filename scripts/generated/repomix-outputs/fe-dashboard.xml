import React, { useState } from "react";
import DaumPostcode, { Address } from "react-daum-postcode";

export interface CompanyAddressFormProps {
  countries: SingleAutocompleteChoiceType[];
  data: AddressInput;
  displayCountry: string;
  errors: Array<AccountErrorFragment | ShopErrorFragment | WarehouseErrorFragment>;
  disabled: boolean;
  onChange: (event: ChangeEvent) => void;
  onCountryChange: (event: ChangeEvent) => void;
}

const useStyles = makeStyles(
  {
    root: {},
  },
  { name: "CompanyAddressForm" }
);

function getErrorMessage(err: AccountErrorFragment | ShopErrorFragment | WarehouseErrorFragment): string {
  if (err) {
    return makeGqlErrorMsg(err);
  }
  return undefined;
}

const CompanyAddressForm: React.FC<CompanyAddressFormProps> = (props) => {
  const { data, disabled, errors, onChange } = props;

  const classes = useStyles(props);

  const formFields = [
    "firstName",
    "streetAddress1",
    "streetAddress2",
    "city",
    "postalCode",
    "country",
    "countryArea",
    "companyArea",
    "phone",
  ];
  const formErrors = getFormErrors(formFields, errors);

  const [visible, setVisible] = useState(false);
  const searchAddress = (address: Address) => {
    const tempAddressObj = makeAddressInputFromDaumPostcode(address);
    for (const key in tempAddressObj) {
      if (tempAddressObj.hasOwnProperty(key)) {
        const event: React.ChangeEvent<any> = {
          bubbles: false,
          cancelable: false,
          currentTarget: undefined,
          isDefaultPrevented(): boolean {
            throw new Error("Function not implemented.");
          },
          target: {
            name: key,
            value: tempAddressObj[key],
          },
          defaultPrevented: false,
          nativeEvent: undefined,
          eventPhase: 0,
          isPropagationStopped(): boolean {
            throw new Error("Function not implemented.");
          },
          isTrusted: false,
          persist(): void {
            throw new Error("Function not implemented.");
          },
          preventDefault(): void {
            throw new Error("Function not implemented.");
          },
          stopPropagation(): void {
            throw new Error("Function not implemented.");
          },
          timeStamp: 0,
          type: "",
        };
        onChange(event);
      }
    }
    setVisible(false);
  };

  return (
    <>
      {visible && <DaumPostcode onComplete={searchAddress} style={{ width: 550 }} />}
      {!visible && (
        <div className={classes.root}>
          <TextField
            disabled={disabled}
            error={!!formErrors.firstName}
            fullWidth
            helperText={getErrorMessage(formErrors.firstName)}
            label={addressMsg.firstName}
            name="firstName"
            value={data.firstName}
            onChange={onChange}
          />
          <FormSpacer />
          <TextField
            disabled={disabled}
            error={!!formErrors.phone}
            fullWidth
            helperText={getErrorMessage(formErrors.phone)}
            label={addressMsg.phone}
            name="phone"
            value={data.phone}
            onChange={onChange}
          />
          <FormSpacer />
          <TextField
            disabled={true}
            error={!!formErrors.postalCode}
            helperText={getErrorMessage(formErrors.postalCode)}
            label={addressMsg.postalCode}
            name="postalCode"
            onChange={onChange}
            value={data.postalCode}
            fullWidth
          />
          <FormSpacer />
          <Grid>
            <TextField
              disabled={true}
              error={!!formErrors.streetAddress1}
              helperText={getErrorMessage(formErrors.streetAddress1)}
              label={addressMsg.address1}
              name="streetAddress1"
              onChange={onChange}
              value={data.streetAddress1}
              fullWidth
            />
            <Button
              variant="contained"
              size="small"
              color="primary"
              onClick={(evt) => {
                evt.preventDefault();
                setVisible(true);
              }}
              fullWidth
            >
              {addressMsg.search}
            </Button>
          </Grid>
          <FormSpacer />
          <TextField
            disabled={disabled}
            error={!!formErrors.streetAddress2}
            helperText={getErrorMessage(formErrors.streetAddress2)}
            label={addressMsg.address2}
            name="streetAddress2"
            onChange={onChange}
            value={data.streetAddress2}
            fullWidth
          />
          <FormSpacer />
        </div>
      )}
    </>
  );
};
export default CompanyAddressForm;
