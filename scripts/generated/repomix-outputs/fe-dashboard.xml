  pvEstimateSearch = "pvEstimateSearch",
  brandSearch = "brandSearch",
  mdSearch = "mdSearch",
  prevProductNameSearch = "prevProductNameSearch",
  buyMethodSearch = "buyMethodSearch",
  sameOrReplacementSearch = "sameOrReplacementSearch",
  productSearch = "productSearch",
  makerSkuSearch = "makerSkuSearch",
  shapeSearch = "shapeSearch",
  sCWSpecSearch = "sCWSpecSearch",
  materialSpecSearch = "materialSpecSearch",
  colorSpecSearch = "colorSpecSearch",
  makerSearch = "makerSearch",
  vendorSearch = "vendorSearch",
  // boolean
  isExclusive = "isExclusive",
  trackInventory = "trackInventory",
  // date
  estimateDate = "estimateDate",
  // multiple values
  categories = "categories",
  type = "type",
  status = "status",
}

export interface PvEstimateListFilterOpts {
  aiQuerySearch: FilterOpts<string>; // AI 검색어,
  categories: FilterOpts<string[]> & AutocompleteFilterOpts; // 카테고리,
  pvEstimateSearch: FilterOpts<string>; // 견적 ID,
  brandSearch: FilterOpts<string>; // 요청 브랜드
  mdSearch: FilterOpts<string>; // 담당 MD
  prevProductNameSearch: FilterOpts<string>; // 기존 상품명
  buyMethodSearch: FilterOpts<string>; // 구매방식
  sameOrReplacementSearch: FilterOpts<string>; // 동일/대체
  productSearch: FilterOpts<string>; // 제품코드/제품명
  makerSkuSearch: FilterOpts<string>; // 품번(제조사)
  shapeSearch: FilterOpts<string>; // 형태
  sCWSpecSearch: FilterOpts<string>; // 규격/용량
  materialSpecSearch: FilterOpts<string>; // 재질/두께
  colorSpecSearch: FilterOpts<string>; // 색상/인쇄도수
  makerSearch: FilterOpts<string>; // 제조사
  vendorSearch: FilterOpts<string>; // 협력사ID/협력사명
  isExclusive: FilterOpts<boolean>; // 구분(전용/범용)
  trackInventory: FilterOpts<boolean>; // 운영방식(재고/위탁)
  estimateDate: FilterOpts<MinMax>; // 견적일
