import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider/DateTime";
import { brandHqStaffRoleChoices, brandStoreRoleChoicesWOOwner } from "@src/app/views/brand/brandStore/utils";
import { ListCustomers_customers_edges_node } from "@src/app/views/customer/customers/api/types/ListCustomers";
import { getBrandName, getDisplayUserName, transformPhoneNumber } from "@utils/misc";
import { utils } from "@utils/utils";
import { Typography } from "antd";
import React from "react";

import { CustomerListPageProps } from "./CustomerListPage";

export function getCustomerTableSettings(props: CustomerListPageProps) {
  const isHqStaff = props.isHqStaff;
  const isForBrand = props.isForBrand;
  const onRowClick = props.onRowClick;

  const userLoginIdColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.USER_ID,
    width: 200,
    align: "center",
    key: "loginId",
    render: (_, record) => (
      <Typography>
        <Typography.Link onClick={() => onRowClick(record?.id)}>{record?.loginId || "-"}</Typography.Link>
      </Typography>
    ),
    renderExcel: (record) => record.loginId,
  };
  const userNameColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.USER_NAME,
    width: 200,
    align: "center",
    key: "userName",
    render: (_, record) => getDisplayUserName(record),
  };

  const brandCodeColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brand.BRAND_CODE,
    width: 100,
    align: "center",
    key: "brandCode",
    render: (_, record) => record.brand?.code || "-",
  };

  const brandNameColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brand.BRAND_NAME,
    width: 160,
    align: "center",
    key: "brandName",
    render: (_, record) => getBrandName(record),
  };

  const brandStoreCodeColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brandStore.BRAND_STORE_CODE,
    width: 120,
    align: "center",
    key: "brandStoreCode",
    render: (_, record) => record.brandStoreUser?.brandStore?.code || "-",
  };

  const brandStoreNameColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brandStore.BRAND_STORE_NAME,
    width: 120,
    align: "center",
    key: "brandStoreName",
    render: (_, record) => record.brandStoreUser?.brandStore?.name || "-",
  };

  const hqStaffRoleColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brand.PERMISSION,
    key: "hqStaffRole",
    align: "center",
    width: 100,
    render: (_, record) => utils.getLabelTextByValue(record.hqStaffRole, brandHqStaffRoleChoices) || "-",
  };

  const brandStoreUserRoleColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.brand.PERMISSION,
    key: "brandStoreUserRole",
    align: "center",
    width: 100,
    render: (_, record) =>
      record.brandStoreUser?.role
        ? utils.getLabelTextByValue(record.brandStoreUser.role, brandStoreRoleChoicesWOOwner)
        : "-",
  };

  const userPhoneColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.PHONE,
    width: 140,
    align: "center",
    key: "phone",
    render: (_, record) => transformPhoneNumber(record.aligoPhone),
  };

  const userEmailColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.BRAND_STORE_EMAIL,
    width: 200,
    align: "center",
    key: "email",
    render: (_, record) => record.email || "-",
  };

  const lastLogInColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.LAST_LOGIN_DATE,
    width: 160,
    align: "center",
    key: "lastLogIn",
    render: (_, record) => getDateByFormat(record.lastLogin, onlyDateFormat),
  };

  const dateJoinedColumn: DownloadableColumnType<ListCustomers_customers_edges_node> = {
    title: columnNameConstant.user.JOINED_DATE,
    width: 160,
    align: "center",
    key: "dateJoined",
    render: (_, record) => getDateByFormat(record.dateJoined, onlyDateFormat),
  };

  let columns: DownloadableColumnsType<ListCustomers_customers_edges_node> = [];
  // 가뱅본부의 경우.
  if (isForBrand) {
    columns = [
      userLoginIdColumn,
      userNameColumn,
      !isHqStaff && brandStoreCodeColumn,
      !isHqStaff && brandStoreNameColumn,
      isHqStaff && hqStaffRoleColumn,
      !isHqStaff && brandStoreUserRoleColumn,
      userPhoneColumn,
      userEmailColumn,
      lastLogInColumn,
      dateJoinedColumn,
    ];
  } else {
    // 운영 Admin의 경우
    columns = [
      userLoginIdColumn,
      userNameColumn,
      brandCodeColumn,
      brandNameColumn,
      !isHqStaff && brandStoreCodeColumn,
      !isHqStaff && brandStoreNameColumn,
      isHqStaff && hqStaffRoleColumn,
      !isHqStaff && brandStoreUserRoleColumn,
      userPhoneColumn,
      userEmailColumn,
      lastLogInColumn,
      dateJoinedColumn,
    ];
  }

  return columns.filter(Boolean);
}
</file>

<file path="src/app/views/customer/customers/components/CustomerListPage/filters.ts">
import filterMsg from "@assets/messages/filters";
import { BrandStoreRoleEnum, HqStaffRoleEnum } from "@src/api/types/globalTypes";
import { IFilter } from "@src/app/components/Filter";
import { brandHqStaffRoleChoices, brandStoreRoleChoicesWOOwner } from "@src/app/views/brand/brandStore/utils";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum CustomerFilterKeys {
  joined = "joined",
  userSearch = "userSearch",
  brandStoreSearch = "brandStoreSearch",
  brandSearch = "brandSearch",
  hqStaffRole = "hqStaffRole",
  brandStoreRole = "brandStoreRole",
}

export interface CustomerListFilterOpts {
  joined: FilterOpts<MinMax>;
  userSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  hqStaffRole: FilterOpts<HqStaffRoleEnum[]>;
  brandStoreRole: FilterOpts<BrandStoreRoleEnum[]>;
}

export function createFilterStructure(
  opts: CustomerListFilterOpts,
  isHqStaff: boolean,
  isForBrand: boolean
): IFilter<CustomerFilterKeys> {
  let filterStructure = [];

  const userSearchFilter = {
    ...createTextField(0, CustomerFilterKeys.userSearch, "ID / 사용자명", opts.userSearch.value),
    active: opts.userSearch.active,
  };

  const brandSearchFilter = {
    ...createTextField(0, CustomerFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };

  const brandStoreSearchFilter = {
    ...createTextField(0, CustomerFilterKeys.brandStoreSearch, "매장코드 / 매장명", opts.brandStoreSearch.value),
    active: opts.brandStoreSearch.active,
  };

  const hqStaffRoleFilter = {
    ...createOptionsField(
      0,
      CustomerFilterKeys.hqStaffRole,
      "권한",
      opts.hqStaffRole.value,
      true,
      brandHqStaffRoleChoices
    ),
    active: opts.hqStaffRole.active,
  };

  const brandStoreRoleFilter = {
    ...createOptionsField(
      0,
      CustomerFilterKeys.brandStoreRole,
      "권한",
      opts.brandStoreRole.value,
      true,
      brandStoreRoleChoicesWOOwner
    ),
    active: opts.brandStoreRole.active,
  };

  const joinedFilter = {
    ...createDateField(0, CustomerFilterKeys.joined, filterMsg.joinDate, opts.joined.value),
    active: opts.joined.active,
  };

  if (isForBrand) {
    filterStructure = [
      userSearchFilter,
      !isHqStaff && brandStoreSearchFilter,
      isHqStaff && hqStaffRoleFilter,
      !isHqStaff && brandStoreRoleFilter,
      joinedFilter,
    ];
  } else {
    filterStructure = [
      userSearchFilter,
      brandSearchFilter,
      !isHqStaff && brandStoreSearchFilter,
      isHqStaff && hqStaffRoleFilter,
      !isHqStaff && brandStoreRoleFilter,
      joinedFilter,
    ];
  }

  return utils.filterDisplayOrdering(filterStructure.filter(Boolean));
}
</file>

