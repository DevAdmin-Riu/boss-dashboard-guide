import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import {
  RequestBossProductChangeStatusInput,
  RequestBossProductImageCreateInput,
  RequestBossProductStatus,
  RequestBossProductStatusEnum,
  RequestBossProductUpdateInput,
} from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import AntdSaveButtonBar from "@src/app/components/SaveButtonBar/AntdSaveButtonBar";
import { findInEnum } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, ButtonProps, Card, Divider, Form, PageHeader, Space, Tag } from "antd";
import React, { useEffect, useState } from "react";

import { RequestBossProductDetails_requestBossProduct } from "../api/types/RequestBossProductDetails";
import {
  productVariantListForReqViewUrl,
  ReqBossProductDetailsViewUrlDialog,
  ReqBossProductDetailsViewUrlQueryParams,
} from "../urls";
import {
  checkIsStatusForRequested,
  getRequestBossProductGroupStatusText,
  getRequestBossProductStatusColor,
  getRequestBossProductStatusText,
} from "../utils";
import { BossProductRequestedInfo } from "./BossProductRequestedInfo";
import { ReqBossProductEstimateInfo } from "./ReqBossProductEstimateInfo";
import { makeDirectRequestFormItems } from "./ReqBossProductFormItems";
import { RequestBossProductStatusHistory } from "./ReqBossProductStatusHistory";

interface ReqBossProductDetailsPageProps {
  params: ReqBossProductDetailsViewUrlQueryParams;
  loading: boolean;
  requestBossProduct: RequestBossProductDetails_requestBossProduct;
  updateMutationStatus: ConfirmButtonTransitionState;
  updateBtnText: string;
  updateFormChanged: boolean;
  setUpdateFormChanged: React.Dispatch<React.SetStateAction<boolean>>;
  openModal: (action: ReqBossProductDetailsViewUrlDialog, newParams?: ReqBossProductDetailsViewUrlQueryParams) => void;
  onUpdate: (input: RequestBossProductUpdateInput) => Promise<boolean>;
  onStatusChange: (input: RequestBossProductChangeStatusInput) => void;
  onImageCreate: (input: RequestBossProductImageCreateInput) => void;
  onBack: () => void;
  setSelectedEstimateId: React.Dispatch<React.SetStateAction<string>>;
  selectedEstimateId: string;
}

// NOTE: 포장보스 요청 상세 페이지는 요청의 상태, 운영 MD or 가맹본부 여부 등에 따라 취할 수 있는 액션이 다양하게 분기되므로 액션 버튼은 모두 우측 상단에 몰아서 배치
export const ReqBossProductDetailsPage: React.FC<ReqBossProductDetailsPageProps> = (props) => {
  const {
    loading,
    requestBossProduct,
    updateMutationStatus,
    updateBtnText,
    updateFormChanged,
    setUpdateFormChanged,
    openModal,
    onUpdate,
    onStatusChange,
    onImageCreate,
    onBack,
    setSelectedEstimateId,
    // selectedEstimateId,
  } = props;
  const navigate = useNavigator();
  const [isUpdateMode, setIsUpdateMode] = useState<boolean>(false);
  const [updateForm] = Form.useForm<RequestBossProductUpdateInput>();

  const { user } = useUser();
  const { isStaff, isHqStaff } = user;
  const { isExclusive, status, images, estimateList, allStatusHistories } = requestBossProduct;
  const statusEnum = findInEnum(status, RequestBossProductStatusEnum);
  const groupStatusText = getRequestBossProductGroupStatusText(statusEnum, user);
  const statusText = getRequestBossProductStatusText(statusEnum);
  const statusColor = getRequestBossProductStatusColor(statusEnum);
  const isEstimateEmpty = utils.isEmpty(estimateList, true);
  const isCanceled = status === RequestBossProductStatus.CANCELED;
  const isVendorPrice = status === RequestBossProductStatus.VENDOR_PRICE;
  const isStatusForRequested = checkIsStatusForRequested(statusEnum);
  // 상품 요청 상태 이후(견적 작성부터) 견적 사항 섹션 노출
  const showEstimate = isStatusForRequested === false;
  const isActiveEstimateCreateButton = isStaff && isVendorPrice && estimateList.length < 5;

  const pageTitle = isStaff ? sectionNames.reqBossProduct : isHqStaff ? sectionNames.hqReqBossProduct : "-";
  const pageSubTitle = isCanceled ? statusText : `${groupStatusText} - ${statusText}`;

  const pickedFirstEstimateList = [...requestBossProduct.estimateList];
  pickedFirstEstimateList.sort((a, b) => a.subId - b.subId);

  const pickedIndex = pickedFirstEstimateList.findIndex((estimate) => estimate.isPicked);
  if (pickedIndex !== -1) {
    // 해당 항목을 배열에서 제거 후 맨 앞에 추가
    const [pickedEstimate] = pickedFirstEstimateList.splice(pickedIndex, 1);
    pickedFirstEstimateList.unshift(pickedEstimate);
  }

  const updateFormInitialValues: RequestBossProductUpdateInput = { ...requestBossProduct };

  const onUpdateFormCancel = () => {
    setUpdateFormChanged(false);
    setIsUpdateMode(false);
  };

  useEffect(() => {
    updateForm.resetFields();
  }, [isUpdateMode]);

  let actionButtons: React.ReactNode = null;
  let statusReasonTitle: string = "";
  let estimateExtra: (estimateId: string) => JSX.Element = (estimateId) => null;
  const actBtnLoading = loading;
  const actBtnDisabled = isUpdateMode;
  const commonActBtnProps: ButtonProps = { type: "primary", loading: actBtnLoading, disabled: actBtnDisabled };
  switch (status) {
    case RequestBossProductStatus.REQUESTED:
      if (isStaff) {
        actionButtons = (
          <Button
            {...commonActBtnProps}
            onClick={() => onStatusChange({ afterStatus: RequestBossProductStatusEnum.ACCEPTED })}
          >
            접수
          </Button>
        );
      }
      break;
    case RequestBossProductStatus.ACCEPTED:
      if (isStaff) {
        actionButtons = (
          <Space>
            <Button {...commonActBtnProps} danger onClick={() => openModal("change-status-req-additional")}>
              보완 요청
            </Button>
            <Button {...commonActBtnProps} type="default" onClick={() => setIsUpdateMode(true)}>
              직접 수정
            </Button>
            <Divider type="vertical" style={{ borderColor: "black" }} />
            <Button
              {...commonActBtnProps}
              onClick={() => navigate(productVariantListForReqViewUrl(requestBossProduct.id))}
            >
              기등록
            </Button>
            <Button
              {...commonActBtnProps}
              onClick={() => onStatusChange({ afterStatus: RequestBossProductStatusEnum.VENDOR_PRICE })}
            >
              견적 요청
            </Button>
          </Space>
        );
      }
      break;
    case RequestBossProductStatus.REQ_ADDITIONAL:
      statusReasonTitle = "보완 요청 내용";
      if (isHqStaff) {
        actionButtons = (
          <Button {...commonActBtnProps} danger onClick={() => setIsUpdateMode(true)}>
            요청 수정
          </Button>
        );
      }
      break;
    case RequestBossProductStatus.VENDOR_PRICE:
      if (isStaff) {
        estimateExtra = (estimateId: string) => (
          <Space>
            <Button
              {...commonActBtnProps}
              type="default"
              onClick={() => {
                openModal("update-estimate");
                setSelectedEstimateId(estimateId);
              }}
            >
              협력사 매입가 수정
            </Button>
          </Space>
        );
        actionButtons = (
          <Space>
            {isEstimateEmpty && (
              <>
                <Button {...commonActBtnProps} danger onClick={() => openModal("change-status-req-md-supplement")}>
                  MD 수정 요청
                </Button>
                <Divider type="vertical" style={{ borderColor: "black" }} />
              </>
            )}
            <Button
              {...commonActBtnProps}
              disabled={actBtnDisabled || isEstimateEmpty}
              onClick={() => onStatusChange({ afterStatus: RequestBossProductStatusEnum.BRAND_PRICE })}
            >
              협력사 매입가 검토 완료
            </Button>
          </Space>
        );
      }
      break;
    case RequestBossProductStatus.BRAND_PRICE:
    case RequestBossProductStatus.REQ_ESTIMATE_FIX:
      if (status === RequestBossProductStatus.REQ_ESTIMATE_FIX) {
        statusReasonTitle = "수정 요청 내용";
      }
      if (isStaff) {
        estimateExtra = (estimateId: string) => (
          <Space>
            <Button
              {...commonActBtnProps}
              type="default"
              onClick={() => {
                openModal("update-estimate");
                setSelectedEstimateId(estimateId);
              }}
            >
              견적 수정
            </Button>
            <Button
              {...commonActBtnProps}
              onClick={() => {
                openModal("set-brand-price");
                setSelectedEstimateId(estimateId);
              }}
            >
              브랜드 판매가 설정
            </Button>
          </Space>
        );
        const invalidBrandPrices =
          estimateList.length > 0 &&
          estimateList.filter(
            (estimate) =>
              utils.isEmpty(estimate.brandProductPriceExcludeVat) || estimate.brandProductPriceExcludeVat <= 0
          ).length !== 0;

        actionButtons = (
          <Space>
            <Button
              {...commonActBtnProps}
              disabled={actBtnDisabled || invalidBrandPrices}
              onClick={() => onStatusChange({ afterStatus: RequestBossProductStatusEnum.PENDING_CONFIRM })}
            >
              견적 {status === RequestBossProductStatus.REQ_ESTIMATE_FIX ? "수정" : "작성"} 완료
            </Button>
          </Space>
        );
      }
      break;
    case RequestBossProductStatus.PENDING_CONFIRM:
      if (isHqStaff) {
        estimateExtra = (estimateId: string) => (
          <Space>
            <Button
              {...commonActBtnProps}
              onClick={() => {
                openModal("set-mall-price");
                setSelectedEstimateId(estimateId);
              }}
            >
              견적 확정
            </Button>
          </Space>
        );
      }
      actionButtons = (
        <Space>
          <Button
            {...commonActBtnProps}
            type="default"
            onClick={() => {
              openModal("change-status-req-estimate-fix");
            }}
          >
            수정 요청
          </Button>
        </Space>
      );
      break;
    case RequestBossProductStatus.CONFIRMED:
      if (isStaff) {
        actionButtons = (
          <Space>
            <Button {...commonActBtnProps} danger onClick={() => openModal("change-status-canceled")}>
              요청 중단
            </Button>
            <Button {...commonActBtnProps} onClick={() => openModal("change-status-completed")}>
              등록 완료
            </Button>
          </Space>
        );
      }
      break;
    default:
      break;
  }

  return (
    <>
      <Form
        form={updateForm}
        layout="vertical"
        initialValues={updateFormInitialValues}
        onValuesChange={() => setUpdateFormChanged(true)}
        onFinish={(formData) =>
          onUpdate(formData).then((res) => {
            if (res) {
              onUpdateFormCancel();
            }
          })
        }
      >
        <AppHeader onBack={onBack}>{pageTitle}</AppHeader>
        <PageHeader
          title="요청 세부 정보"
          subTitle={<Tag color={statusColor}>{pageSubTitle}</Tag>}
          extra={actionButtons}
        />

        <Space direction="vertical" size="large">
          {[RequestBossProductStatus.REQ_ADDITIONAL, RequestBossProductStatus.REQ_ESTIMATE_FIX].includes(status) &&
            allStatusHistories.length > 0 && (
              <Card title={<CardTitleAntd title={statusReasonTitle} />}>{allStatusHistories[0].reason}</Card>
            )}
          <Card title={<CardTitleAntd title="요청 사항" />}>
            {isUpdateMode ? (
              makeDirectRequestFormItems(isExclusive, {
                fileList: images.map((image) => ({ ...image, uid: image.id, name: null })),
                onChange: ({ file }) => {
                  if (file.status === "uploading") {
                    onImageCreate({ request: requestBossProduct.id, image: file.originFileObj });
                  }
                },
                onRemove: (file) => openModal("delete-image", { id: file.uid }),
              })
            ) : (
              <BossProductRequestedInfo
                isCreateMode={false}
                data={requestBossProduct}
                dataImageList={requestBossProduct.images}
              />
            )}
          </Card>
          {showEstimate && (
            <Card
              title={<CardTitleAntd title="견적 사항" />}
              extra={
                isActiveEstimateCreateButton && (
                  <Button {...commonActBtnProps} onClick={() => openModal("create-estimate")}>
                    협력사 매입가 등록
                  </Button>
                )
              }
            >
              {pickedFirstEstimateList.map((estimate, index) => (
                <ReqBossProductEstimateInfo
                  key={estimate.id}
                  request={requestBossProduct}
                  estimate={estimate}
                  estimateExtra={estimateExtra}
                  index={index}
                />
              ))}
            </Card>
          )}
          <RequestBossProductStatusHistory histories={allStatusHistories} />
        </Space>
      </Form>

      {isUpdateMode && (
        <AntdSaveButtonBar
          disabled={!updateFormChanged || loading}
          state={updateMutationStatus}
          labels={{ save: updateBtnText, cancel: "취소" }}
          onCancel={onUpdateFormCancel}
          onSave={updateForm.submit}
        />
      )}
    </>
  );
};
</file>

