import { CreateAdminAtProductVariantList_productVariants_edges_node } from "@src/app/views/product/products/api/types/CreateAdminAtProductVariantList";
import { makeProductQtyPerBoxText } from "@src/app/views/product/products/utils/data";
import { getStockSpec } from "@src/app/views/product/stock/utils";
import { calcVatByPriceIncludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";

import { ICreateAdminOrderFormLine } from "../../views/CreateAdminOrderView/CreateAdminOrderView";

export const getSku = (record: CreateAdminAtProductVariantList_productVariants_edges_node) => record.sku;

export const getProductName = (record: CreateAdminAtProductVariantList_productVariants_edges_node) =>
  record?.product?.name || "-";

export const getProductVariantName = (record: CreateAdminAtProductVariantList_productVariants_edges_node) =>
  record?.name || "-";

export const getAttributes = (record: CreateAdminAtProductVariantList_productVariants_edges_node) =>
  getStockSpec(record) || "-";

export const getQtyPerBox = (record: CreateAdminAtProductVariantList_productVariants_edges_node) =>
  makeProductQtyPerBoxText(record) || "-";

export const getTrackInventory = (record: CreateAdminAtProductVariantList_productVariants_edges_node) =>
  record.trackInventory;

export const getProductVariantObj = (
  record: CreateAdminAtProductVariantList_productVariants_edges_node
): ICreateAdminOrderFormLine => {
  const isTaxFree = record?.product?.isTaxFree;
  const initialPrice = 0;

  // 면세 여부에 따라 부가세를 올바르게 계산
  const priceExcludeVat = toPriceExcludeVat(initialPrice, isTaxFree);
  const priceVat = calcVatByPriceIncludeVat(initialPrice, isTaxFree);

  return {
    id: record.id,
    sku: getSku(record),
    bpSku: "-",
    productName: getProductName(record),
    brandProductName: "-",
    variantName: getProductVariantName(record),
    attributes: getAttributes(record),
    qtyPerBox: getQtyPerBox(record),
    trackInventory: getTrackInventory(record),
    isVendorTrackInventory: record.isVendorTrackInventory,
    priceIncludeVat: initialPrice,
    priceExcludeVat: priceExcludeVat || 0,
    priceVat: priceVat || 0,
    qty: 0,
    decreaseStockFlag: false,
    isTaxFree,
    pricePrecision: record.priceDecimalPlaces,
    orderQtyPrecision: record.orderQtyDecimalPlaces,
    isDeferred: record.isDeferred,
    needDeliveryAdditionalFee: record.needDeliveryAdditionalFee,
    isAdjustPrice: record.isAdjustPrice,
    qtyPerDeliveryBox: record.qtyPerDeliveryBox,
  };
};
