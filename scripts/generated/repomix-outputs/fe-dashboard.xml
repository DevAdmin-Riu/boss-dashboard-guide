import { BpvListForHq_brandProductVariants_edges_node } from "@src/app/views/hqStaff/hqSection/api/types/BpvListForHq";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "@src/app/views/product/products/utils/data";
