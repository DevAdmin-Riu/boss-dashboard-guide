export const purchaseOrderLineUrlList = (
  trackInventory: boolean,
  currentRouteParams: PurchaseOrderLineListViewRouteParams,
  viewUrl: (
    routeParams: PurchaseOrderLineListViewRouteParams,
    params?: PurchaseOrderLineListViewUrlQueryParams
  ) => string,
  viewPath: (routeParams: PurchaseOrderLineListViewRouteParams) => string,
  isB2b: boolean = false
): Array<UrlListType<PurchaseOrderLineUrlEnum, PurchaseOrderLineListViewUrlQueryParams>> => {
  // Helper function to create a URL list item with reduced duplication
  const createUrlListItem = (
    urlEnum: PurchaseOrderLineUrlEnum,
    routeParams: PurchaseOrderLineListViewRouteParams,
    fnUrlOverride?: () => string,
    pathOverride?: string
  ): UrlListType<PurchaseOrderLineUrlEnum, PurchaseOrderLineListViewUrlQueryParams> => {
    const fnUrl = fnUrlOverride || (() => viewUrl(routeParams));
    const path = pathOverride || viewPath(routeParams);
    return {
      urlEnum,
      fnUrl,
      path,
    };
  };

  return [
    createUrlListItem(PurchaseOrderLineUrlEnum.DRAFT, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.DRAFT,
    }),
    createUrlListItem(PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.PENDING_OR_REJECTED,
    }),
    createUrlListItem(PurchaseOrderLineUrlEnum.DELEGATED_RECEIVE, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.RECEIVE,
    }),
    createUrlListItem(PurchaseOrderLineUrlEnum.IN_PRODUCTION, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.IN_PRODUCTION,
    }),
    trackInventory &&
      createUrlListItem(PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT, {
        ...currentRouteParams,
        status: PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
      }),
    !trackInventory &&
      !isB2b &&
      createUrlListItem(
        PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER,
        {
          ...currentRouteParams,
          status: PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
          deliveryMethod: "by-courier",
        },
        () => orderLineListForFulfillViewUrlByCourier(),
        orderLineListForFulfillViewPathByCourier
      ),
    !trackInventory &&
      !isB2b &&
      createUrlListItem(
        PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_COURIER_PRICE_ADJUST,
        {
          ...currentRouteParams,
          status: PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
          deliveryMethod: "by-courier-price-adjust",
        },
        () => orderLineListForFulfillViewUrlByCourierPriceAdjust(),
        orderLineListForFulfillViewPathByCourierPriceAdjust
      ),
    !trackInventory &&
      createUrlListItem(
        PurchaseOrderLineUrlEnum.DELEGATED_DISPATCH_FULFILLMENT_BY_NON_COURIER,
        {
          ...currentRouteParams,
          status: PurchaseOrderLineUrlEnum.DISPATCH_FULFILLMENT,
          deliveryMethod: "by-non-courier",
        },
        () => (isB2b ? orderLineListB2bForFulfillViewUrl() : orderLineListForFulfillViewUrlByNonCourier()),
        isB2b ? orderLineListB2bForFulfillViewPath : orderLineListForFulfillViewPathByNonCourier
      ),
    createUrlListItem(PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.REQ_EPD_UPDATE,
    }),
    (trackInventory || isB2b) &&
      createUrlListItem(PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY, {
        ...currentRouteParams,
        status: PurchaseOrderLineUrlEnum.REQ_SPLIT_DELIVERY,
      }),
    trackInventory &&
      createUrlListItem(PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY, {
        ...currentRouteParams,
        status: PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY,
      }),
    !trackInventory &&
      !isB2b &&
      createUrlListItem(
        PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_COURIER,
        {
          ...currentRouteParams,
          status: PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY,
          deliveryMethod: "by-courier",
        },
        () => orderDeliveryListViewUrlBByCourier(),
        orderDeliveryListViewPathBByCourier
      ),
    !trackInventory &&
      createUrlListItem(
        PurchaseOrderLineUrlEnum.DELEGATED_CONFIRM_DELIVERY_BY_NON_COURIER,
        {
          ...currentRouteParams,
          status: PurchaseOrderLineUrlEnum.CONFIRM_DELIVERY,
          deliveryMethod: "by-non-courier",
        },
        () => (isB2b ? orderDeliveryListViewUrlB2b() : orderDeliveryListViewUrlBByNonCourier()),
        isB2b ? orderDeliveryListViewPathB2b : orderDeliveryListViewPathBByNonCourier
      ),
    createUrlListItem(PurchaseOrderLineUrlEnum.PRINT_INVOICE, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.PRINT_INVOICE,
    }),
    trackInventory &&
      createUrlListItem(PurchaseOrderLineUrlEnum.INSPECT, {
        ...currentRouteParams,
        status: PurchaseOrderLineUrlEnum.INSPECT,
      }),
    trackInventory &&
      createUrlListItem(PurchaseOrderLineUrlEnum.ADD_STOCK, {
        ...currentRouteParams,
        status: PurchaseOrderLineUrlEnum.ADD_STOCK,
      }),
    createUrlListItem(PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.COMPLETE_DELIVERY,
    }),
    createUrlListItem(PurchaseOrderLineUrlEnum.ALL, {
      ...currentRouteParams,
      status: PurchaseOrderLineUrlEnum.ALL,
    }),
  ].filter(Boolean);
};
</file>

<file path="src/app/views/purchase/purchaseOrders/utils.ts">
import {
