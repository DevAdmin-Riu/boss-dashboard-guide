  defaultPvvDeliveryFeeExcludeVat: undefined,
  defaultPvvConsignmentProductPriceExcludeVat: undefined,
  defaultPvvConsignmentDeliveryFeeExcludeVat: undefined,
  defaultPvvLeadTime: undefined,
  defaultPvvMoq: undefined,
  defaultPvvUoq: undefined,
  defaultPvvNote: "",
  defaultPvvNoteForUnitPrice: "",
  defaultPvvPricingBasisQty: undefined,
  defaultPvvIncludePurchaseB2bDeliveryFee: false,
  defaultPvvPurchaseB2bDeliveryFeeExcludeVat: 0,
  bpvBrandCode: undefined,
  isOnlyPayableByCash: false,
  bpvShowBeforePrice: false,
  bpvBeforePriceExcludeVat: undefined,
  bpvPriceExcludeVat: undefined,
  bpvPriceVat: undefined,
  priceDecimalPlaces: 0,
  orderQtyDecimalPlaces: 0,
  isDeferred: false,
  needToInspect: false,
  inspectReason: undefined,
  inspectType: undefined,
  inspectMemo: undefined,
  inspectReportTemplate: undefined,
  countryOfOrigin: undefined,
};

function useProductCreateForm(
  initial: Partial<ProductCreateFormData>,
  onSubmit: (data: ProductCreateData) => Promise<boolean>,
  opts: UseProductCreateFormOpts
): UseProductCreateFormResult {
  const initialProductType =
    opts.productTypes?.find((productType) => initial?.productType?.id === productType.id) || null;

  const form = useForm({
    ...defaultInitialFormData,
    ...initial,
  });

  const attributes = useFormset(
    initial?.productAttributes
      ? getAttributeInputFromProductAttributes(initial?.productAttributes)
      : initial?.productType
      ? getAttributeInputFromProductType(initialProductType)
      : []
  );

  const [productType, setProductType] = useStateFromProps<ProductType>(initialProductType || null);

  const [changed, setChanged] = React.useState<boolean>(false);
  const triggerChange = () => setChanged(true);

  const handleChange: FormChange = (event, cb) => {
    form.change(event, cb);
    triggerChange();
  };

  const handleCollectionSelect = handleChange;
  const handleCategorySelect = createCategorySelectHandler(handleChange, opts.setSelectedCategory, opts.categories);
  const handleAttributeChange = createAttributeChangeHandler(attributes.change, triggerChange);
  const handleAttributeMultiChange = createAttributeMultiChangeHandler(
    attributes.change,
    attributes.data,
    triggerChange
  );
  const handleProductTypeSelect = createProductTypeSelectHandler(
    attributes.set,
    setProductType,
    opts.productTypes,
    triggerChange
  );
  const changeProductInfoNoti = handleChange;

  const data: ProductCreateData = {
    ...form.data,
    attributes: attributes.data,
    productType,
    hasVariants: productType?.hasVariants,
  };

  const submit = () => onSubmit(data);

  return {
    change: handleChange,
    data,
    handlers: {
      changeProductInfoNoti,
      selectAttribute: handleAttributeChange,
      selectAttributeMultiple: handleAttributeMultiChange,
      selectCategory: handleCategorySelect,
      selectCollection: handleCollectionSelect,
      selectProductType: handleProductTypeSelect,
    },
    hasChanged: changed,
    submit,
    reset: form.reset,
  };
}

const ProductCreateForm: React.FC<ProductCreateFormProps> = ({ children, initial, onSubmit, ...rest }) => {
  const props = useProductCreateForm(initial || {}, onSubmit, rest);

  return <form onSubmit={props.submit}>{children(props)}</form>;
};

export default ProductCreateForm;
