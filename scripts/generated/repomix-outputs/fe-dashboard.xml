import { RequestFbvProductFilterInput, RequestFbvProductStatusEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleEnumValueQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import {
  ReqFbvProductProductFilterKeys,
  ReqFbvProductProductListFilterOpts,
} from "../../components/ReqFbvProductListPage/filters";
import {
  ReqFbvProductListViewUrlFilters,
  ReqFbvProductListViewUrlFiltersEnum,
  ReqFbvProductListViewUrlQueryParams,
} from "../../urls";

const REQ_FBV_PRODUCT_FILTERS_KEY = "reqFbvProductFilters";

export function getFilterOpts(params: ReqFbvProductListViewUrlFilters): ReqFbvProductProductListFilterOpts {
  const filterVariables = getFilterVariables(params);
  const todayMoment = moment();

  return {
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch), false),
      value: maybe(() => filterVariables.brandSearch, ""),
    },
    mdSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.mdSearch), false),
      value: maybe(() => filterVariables.mdSearch, ""),
    },
    vendorSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.vendorSearch), false),
      value: maybe(() => filterVariables.vendorSearch, ""),
    },
    productSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.productSearch), false),
      value: maybe(() => filterVariables.productSearch, ""),
    },
    status: {
      active: maybe(() => !utils.isEmpty(filterVariables.status), false),
      value: maybe(
        () => findValueInEnum(filterVariables.status, RequestFbvProductStatusEnum),
        RequestFbvProductStatusEnum.REQUESTED
      ),
    },
    createdAt: {
      active: maybe(() => !utils.allEmpty([filterVariables.createdAt.gte, filterVariables.createdAt.lte]), false),
      value: {
        max: maybe(() => filterVariables.createdAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.createdAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    lastChangedAt: {
      active: maybe(
        () => !utils.allEmpty([filterVariables.lastChangedAt.gte, filterVariables.lastChangedAt.lte]),
        false
      ),
      value: {
        max: maybe(() => filterVariables.lastChangedAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.lastChangedAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
  };
}

export function getFilterVariables(params: ReqFbvProductListViewUrlFilters): RequestFbvProductFilterInput {
  return {
    brandSearch: params.brandSearch,
    mdSearch: params.mdSearch,
    vendorSearch: params.vendorSearch,
    productSearch: params.productSearch,
    status: params.status !== undefined ? findValueInEnum(params.status, RequestFbvProductStatusEnum) : null,
    createdAt: getGteLteVariables({
      gte: params.createdAtFrom,
      lte: params.createdAtTo,
    }),
    lastChangedAt: getGteLteVariables({
      gte: params.lastChangedAtFrom,
      lte: params.lastChangedAtTo,
    }),
  };
}

export function getFilterQueryParam(
  filter: IFilterElement<ReqFbvProductProductFilterKeys>
): ReqFbvProductListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case ReqFbvProductProductFilterKeys.createdAt:
      return getMinMaxQueryParam(
        filter,
        ReqFbvProductListViewUrlFiltersEnum.createdAtFrom,
        ReqFbvProductListViewUrlFiltersEnum.createdAtTo
      );
    case ReqFbvProductProductFilterKeys.lastChangedAt:
      return getMinMaxQueryParam(
        filter,
        ReqFbvProductListViewUrlFiltersEnum.lastChangedAtFrom,
        ReqFbvProductListViewUrlFiltersEnum.lastChangedAtTo
      );
    case ReqFbvProductProductFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, ReqFbvProductListViewUrlFiltersEnum.brandSearch);
    case ReqFbvProductProductFilterKeys.mdSearch:
      return getSingleValueQueryParam(filter, ReqFbvProductListViewUrlFiltersEnum.mdSearch);
    case ReqFbvProductProductFilterKeys.vendorSearch:
      return getSingleValueQueryParam(filter, ReqFbvProductListViewUrlFiltersEnum.vendorSearch);
    case ReqFbvProductProductFilterKeys.productSearch:
      return getSingleValueQueryParam(filter, ReqFbvProductListViewUrlFiltersEnum.productSearch);
    case ReqFbvProductProductFilterKeys.status:
      return getSingleEnumValueQueryParam(
        filter,
        ReqFbvProductListViewUrlFiltersEnum.status,
        RequestFbvProductStatusEnum
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<ReqFbvProductListViewUrlFilters>(REQ_FBV_PRODUCT_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  ReqFbvProductListViewUrlQueryParams,
  ReqFbvProductListViewUrlFilters
>({
  ...ReqFbvProductListViewUrlFiltersEnum,
});
