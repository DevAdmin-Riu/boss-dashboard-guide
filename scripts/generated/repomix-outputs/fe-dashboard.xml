import { makeStyles } from "@material-ui/core/styles";
import Typography from "@material-ui/core/Typography";
import { VendorManageEventType } from "@src/api/types/globalTypes";
import Form from "@src/app/components/Form";
import Hr from "@src/app/components/Hr";
import Skeleton from "@src/app/components/Skeleton";
import Timeline, { TimelineAddNote } from "@src/app/components/Timeline/Timeline";
import TimelineNote from "@src/app/components/Timeline/TimelineNote";
import { utils } from "@utils/utils";
import React from "react";

import { Vendor_vendor_events } from "../api/types/Vendor";

export interface FormData {
  message: string;
}

const getEventMessage = (event: Vendor_vendor_events) => {
  const parameters = utils.jsonParseWrapper(event?.parameters) || {};
  const message = parameters?.message ? parameters?.message : "-";

  switch (event.type) {
    case VendorManageEventType.NOTE_ADDED:
      return message;
    case VendorManageEventType.CREATED:
      return "협력사 생성";
    case VendorManageEventType.UPDATED:
      return "협력사 정보 수정";
    default:
      return message;
  }
};

const useStyles = makeStyles(
  (theme) => ({
    header: {
      fontWeight: 500,
      marginBottom: theme.spacing(1),
    },
    root: { marginTop: theme.spacing(4) },
    user: {
      marginBottom: theme.spacing(1),
    },
  }),
  { name: "VendorManageHistory" }
);

interface VendorManageHistoryProps {
  history: Vendor_vendor_events[];
  onNoteAdd: (data: FormData) => void;
}

// Deprecated. 협력사 운영이력 따로 만듬.
export const VendorManageHistory: React.FC<VendorManageHistoryProps> = (props) => {
  const { history, onNoteAdd } = props;
  const classes = useStyles(props);

  return (
    <div className={classes.root}>
      <Typography className={classes.header} color="textSecondary">
        협력사 관리 내역
      </Typography>
      <Hr />
      {history ? (
        <Timeline>
          <Form initial={{ message: "" }} onSubmit={onNoteAdd} resetOnSubmit>
            {({ change, data, reset, submit }) => (
              <TimelineAddNote message={data.message} reset={reset} onChange={change} onSubmit={submit} />
            )}
          </Form>
          {history
            .slice()
            .reverse()
            .map((event) => (
              <TimelineNote date={event.date} user={event.user} message={getEventMessage(event)} key={event.id} />
            ))}
        </Timeline>
      ) : (
        <Skeleton />
      )}
    </div>
  );
};
</file>

