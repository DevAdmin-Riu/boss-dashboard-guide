import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { DownloadableColumnsType, DownloadableEditableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import EditableField from "@src/app/components/EditableField/EditableField";
import NumberComponent from "@src/app/components/Number";
import { DateTime, getDateByFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { utils } from "@utils/utils";
import { Button, Collapse, Descriptions, DescriptionsProps, Popconfirm, Row, Space } from "antd";
import React from "react";

import { getNumberFormat, makeProductQtyPerBoxText } from "../../../products/utils/data";
import { RackStockList_rackStocks_edges_node } from "../../api/types/RackStockList";
import { StockDetailExpDateUpdateVariables } from "../../api/types/StockDetailExpDateUpdate";
import {
  getExpDateStatusTag,
  getRackLocationStatus,
  makeRackLocationTags,
  makeRackLocationTagTextArr,
  stockDetailExpDateStatusChoices,
} from "../../utils";

export interface RackStockListTableSettingsProps {
  TypeSafeForm: TypeSafeForm<StockDetailExpDateUpdateVariables>;
  editingProps: {
    isEditing: (record: RackStockList_rackStocks_edges_node) => boolean;
    onEdit: (record: RackStockList_rackStocks_edges_node) => void;
    onCancel: () => void;
    disabled: boolean;
    loading: boolean;
  };
  onEmptyRackStockDetailDelete: (record: RackStockList_rackStocks_edges_node) => void;
  onRackStockDetailMove: (record: RackStockList_rackStocks_edges_node) => void;
}

const checkStockDetailEmpty = (record: RackStockList_rackStocks_edges_node) =>
  utils.isEmpty(record.stockDetail) && record.remainQuantity <= 0;

const makeRackStockActionButton = (
  props: RackStockListTableSettingsProps,
  record: RackStockList_rackStocks_edges_node
) => {
  const { editingProps, onEmptyRackStockDetailDelete, onRackStockDetailMove } = props;
  const { disabled } = editingProps || {};

  return checkStockDetailEmpty(record) ? (
    <Button danger type="primary" size="small" disabled={disabled} onClick={() => onEmptyRackStockDetailDelete(record)}>
      재고 연동 해제
    </Button>
  ) : (
    <Button type="primary" size="small" disabled={disabled} onClick={() => onRackStockDetailMove(record)}>
      재고 이동
    </Button>
  );
};

const makeExpDateEditableField = (
  props: RackStockListTableSettingsProps,
  record: RackStockList_rackStocks_edges_node
) => {
  const { TypeSafeForm, editingProps } = props;
  const { isEditing, onEdit, onCancel, disabled, loading } = editingProps || {};
  const stockDetailEmpty = checkStockDetailEmpty(record);

  return (
    <Space size={0} wrap>
      <EditableField
        noStyle
        type="datepicker"
        name={TypeSafeForm.getValidDataIndex("input.expDate")}
        editMode={isEditing(record)}
        value={record.stockDetail?.expDate}
        formDateFormat={onlyDateFormat}
      />
      {isEditing(record) ? (
        <Space>
          <Button size="small" disabled={loading} onClick={onCancel}>
            취소
          </Button>
          <Popconfirm
            title="유통기한 변경"
            placement="topRight"
            cancelText="닫기"
            onConfirm={TypeSafeForm.formInstance.submit}
          >
            <Button size="small" type="primary" disabled={loading}>
              저장
            </Button>
          </Popconfirm>
        </Space>
      ) : (
        <Button onClick={() => onEdit(record)} type="primary" size="small" disabled={stockDetailEmpty || disabled}>
          수정
        </Button>
      )}
    </Space>
  );
};

