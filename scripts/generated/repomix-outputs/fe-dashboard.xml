import { PublishedEnum } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  createFilterTabUtils,
  createFilterUtils,
  getGteLteVariables,
  getMinMaxQueryParam,
  getSingleValueQueryParam,
} from "@utils/filters";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import moment from "moment";

import { TrainingDocListFilterKeys, TrainingDocListFilterOpts } from "../../components/HqTrainingDocListPage/filters";
import {
  TrainingDocListViewFilters,
  TrainingDocListViewRouteParams,
  TrainingDocListViewUrlFiltersEnum,
  TrainingDocListViewUrlQueryParams,
} from "../../urls";

const TRAINING_DOC_LIST_VIEW_FILTERS_KEY = "TRAINING_DOC_LIST_VIEW_FILTERS_KEY";

export function getFilterOpts(
  params: TrainingDocListViewUrlQueryParams,
  routeParams: TrainingDocListViewRouteParams
): TrainingDocListFilterOpts {
  const filterVariables = getFilterVariables(params, routeParams);
  const todayMoment = moment();
  return {
    tagSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.tagSearch, true), false),
      value: filterVariables.tagSearch || "",
    },
    titleSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.titleSearch, true), false),
      value: filterVariables.titleSearch || "",
    },
    brandSearch: {
      active: maybe(() => !utils.isEmpty(filterVariables.brandSearch, true), false),
      value: filterVariables.brandSearch || "",
    },

    published: {
      active: maybe(() => !utils.isEmpty(filterVariables.published), false),
      value: maybe(() => findValueInEnum(filterVariables.published, PublishedEnum), undefined),
    },
    createdDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.createdDate.gte, filterVariables.createdDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.createdDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.createdDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    publishDate: {
      active: maybe(() => !utils.allEmpty([filterVariables.publishDate.gte, filterVariables.publishDate.lte]), false),
      value: {
        max: maybe(() => filterVariables.publishDate.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.publishDate.gte, todayMoment.format(onlyDateFormat)),
      },
    },
  };
}

export function getFilterVariables(
  params: TrainingDocListViewUrlQueryParams,
  routeParams: TrainingDocListViewRouteParams
) {
  return {
    tagSearch: params.tagSearch,
    titleSearch: params.titleSearch,
    brandSearch: params.brandSearch,
    published: params.published !== undefined ? findValueInEnum(params.published, PublishedEnum) : null,
    createdDate: getGteLteVariables({
      gte: params.createdDateFrom,
      lte: params.createdDateTo,
    }),
    publishDate: getGteLteVariables({
      gte: params.publishDateFrom,
      lte: params.publishDateTo,
    }),
  };
}

export function getFilterQueryParam(filter: IFilterElement<TrainingDocListFilterKeys>) {
  const { name } = filter;

  switch (name) {
    case TrainingDocListFilterKeys.tagSearch:
      return getSingleValueQueryParam(filter, TrainingDocListViewUrlFiltersEnum.tagSearch);
    case TrainingDocListFilterKeys.titleSearch:
      return getSingleValueQueryParam(filter, TrainingDocListViewUrlFiltersEnum.titleSearch);
    case TrainingDocListFilterKeys.brandSearch:
      return getSingleValueQueryParam(filter, TrainingDocListViewUrlFiltersEnum.brandSearch);
    case TrainingDocListFilterKeys.published:
      return getSingleValueQueryParam(filter, TrainingDocListViewUrlFiltersEnum.published);
    case TrainingDocListFilterKeys.createdDate:
      return getMinMaxQueryParam(
        filter,
        TrainingDocListViewUrlFiltersEnum.createdDateFrom,
        TrainingDocListViewUrlFiltersEnum.createdDateTo
      );
    case TrainingDocListFilterKeys.publishDate:
      return getMinMaxQueryParam(
        filter,
        TrainingDocListViewUrlFiltersEnum.publishDateFrom,
        TrainingDocListViewUrlFiltersEnum.publishDateTo
      );
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } = createFilterTabUtils<TrainingDocListViewFilters>(
  TRAINING_DOC_LIST_VIEW_FILTERS_KEY
);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  TrainingDocListViewUrlQueryParams,
  TrainingDocListViewFilters
>({
  ...TrainingDocListViewUrlFiltersEnum,
});
</file>

<file path="src/app/views/hqStaff/HqTrainingDoc/views/HqTrainingDocListView/HqTrainingDocListView.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import useUser from "@hooks/useUser";
import { BrandServiceTypeEnum, BsTrainingDocFilterInput } from "@src/api/types/globalTypes";
import ConfirmModal from "@src/app/components/ConfirmModal";
import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import React, { useState } from "react";
import { useParams } from "react-router";

import { useBsTrainingDocDeleteMutation } from "../../api/mutations";
import {
  useBsTrainingDocListQuery,
  useBsTrainingTagListQuery,
  useBsTrainingTagSimpleBrandListQuery,
} from "../../api/queries";
import { BsTrainingDocListVariables } from "../../api/types/BsTrainingDocList";
import HqTrainingDocListPage from "../../components/HqTrainingDocListPage/HqTrainingDocListPage";
import HqTrainingDocTagModal from "../../components/HqTrainingTagModal/HqTrainingTagModal";
import {
  hqTrainingDocCreateViewUrl,
  hqTrainingDocDetailsViewUrl,
  hqTrainingDocListViewUrl,
  trainingDocCreateViewUrl,
  trainingDocDetailsViewUrl,
  TrainingDocListViewRouteParams,
  trainingDocListViewUrl,
  TrainingDocListViewUrlDialog,
  TrainingDocListViewUrlQueryParams,
} from "../../urls";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";
import { convertFilterBsTrainingDocType } from "./utils";

interface HqTrainingDocListViewProps {
  params: TrainingDocListViewUrlQueryParams;
}

enum HqTrainingDocListModalModeEnum {
  ADD_TAG = "ADD_TAG",
  DELETE_DOC = "DELETE_DOC",
}

const HqTrainingDocListView: React.FC<HqTrainingDocListViewProps> = (props) => {
  const { params } = props;
  const { user } = useUser();
  const { isHqStaff } = user;
  const routeParams = useParams<TrainingDocListViewRouteParams>();
  const [modalMode, setModalMode] = useState<HqTrainingDocListModalModeEnum | null>(null);
  const [selectedRowId, setSelectedRowId] = useState<string | null>(null);
  const [brandId, setBrandId] = useState<string | null>(null);

  const resetForCloseModal = () => {
    setModalMode(null);
  };

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: utils.generateListViewName(ListViews.TRANING_DOC_LIST, [routeParams.menuType]),
  });
  const targetListUrl = (params?: TrainingDocListViewUrlQueryParams) =>
    isHqStaff ? hqTrainingDocListViewUrl(routeParams, params) : trainingDocListViewUrl(routeParams, params);
  const targetAddUrl = (routeParams: TrainingDocListViewRouteParams) =>
    isHqStaff ? hqTrainingDocCreateViewUrl(routeParams) : trainingDocCreateViewUrl(routeParams);
  const targetDetailsUrl = (docId: string) =>
    isHqStaff ? hqTrainingDocDetailsViewUrl(docId) : trainingDocDetailsViewUrl(docId);

  const filterVariables: BsTrainingDocFilterInput = getFilterVariables(params, routeParams);

  const queryVariables: BsTrainingDocListVariables = React.useMemo(
    () => ({
      ...paginationState,
      filter: {
        ...filterVariables,
        ownerBrand: isHqStaff ? user?.brand.id : undefined,
        type: convertFilterBsTrainingDocType(routeParams.menuType),
      },
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useBsTrainingDocListQuery({ variables: queryVariables });

  const filterOpts = getFilterOpts(params, routeParams);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.bsTrainingDocList?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<TrainingDocListViewUrlDialog, TrainingDocListViewUrlQueryParams>({
    navigate,
    targetUrl: targetListUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const tagListQueryVariables: BsTrainingDocFilterInput = React.useMemo(
    () => ({
      ownerBrand: isHqStaff ? user?.brand.id : brandId,
      type: convertFilterBsTrainingDocType(routeParams.menuType),
    }),
    [params, routeParams.menuType, isHqStaff, user?.brand?.id, brandId]
  );

  const { data: tagListData, loading: tagListLoading } = useBsTrainingTagListQuery({
    skip: !isHqStaff && utils.isEmpty(brandId),
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: tagListQueryVariables,
    },
  });

  const { data: brandListData, loading: brandListLoading } = useBsTrainingTagSimpleBrandListQuery({
    forceFetchPolicy: "cache-first",
    skip: isHqStaff,
    variables: {
      first: GrapheneRelayConnectionMaxLimitEnum.default,
      filter: { enabledServices: [BrandServiceTypeEnum.LINKERS] },
    },
  });

  const [bsTrainingDocDelete, bsTrainingDocDeleteOpts] = useBsTrainingDocDeleteMutation({
    onCompleted: (data) => {
      const errors = data.bsTrainingDocDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("문서를 삭제하였습니다.");
        resetForCloseModal();
        refetch();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
  });

  const pageLoading = loading || tagListLoading || brandListLoading || bsTrainingDocDeleteOpts.loading;

  return (
    <>
      <HqTrainingDocListPage
        currentTab={currentTab}
        filterOpts={filterOpts}
        onFilterChange={changeFilters}
        onAll={resetFilters}
        onTabChange={handleTabChange}
        onTabDelete={() => openModal("delete-search")}
        onTabSave={() => openModal("save-search")}
        tabs={tabs.map((tab) => tab.name)}
        onAdd={() => navigate(targetAddUrl(routeParams))}
        onTagAdd={() => setModalMode(HqTrainingDocListModalModeEnum.ADD_TAG)}
        onDocDelete={(docId) => {
          setModalMode(HqTrainingDocListModalModeEnum.DELETE_DOC);
          setSelectedRowId(docId);
        }}
        onRowClick={(docId) => navigate(targetDetailsUrl(docId))}
        disabled={pageLoading}
        bsTrainingDocList={maybe(() => data.bsTrainingDocList.edges.map((edge) => edge.node))}
        user={user}
        settings={settings}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        pageInfo={pageInfo}
        queryVariables={queryVariables}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={maybe(() => tabs[currentTab - 1].name, "...")}
      />
      <HqTrainingDocTagModal
        open={modalMode === HqTrainingDocListModalModeEnum.ADD_TAG}
        onClose={resetForCloseModal}
        menuType={routeParams.menuType}
        brandList={maybe(() => brandListData.brands.edges.map((edge) => edge.node))}
        tagListData={maybe(() => tagListData.bsTrainingTagList.edges.map((edge) => edge.node))}
        loading={pageLoading}
        user={user}
        setBrandId={setBrandId}
      />
      <ConfirmModal
        visible={modalMode === HqTrainingDocListModalModeEnum.DELETE_DOC}
        titleText="정말로 해당 교육자료를 삭제하시겠습니까?"
        onOk={() => {
          bsTrainingDocDelete({
            variables: { id: selectedRowId },
          });
        }}
        onCancel={() => {
          setModalMode(null);
          setSelectedRowId(null);
        }}
      />
    </>
  );
};

export default HqTrainingDocListView;
</file>

