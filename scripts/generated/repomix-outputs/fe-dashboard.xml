                  hoverable
                  onClick={() => handleCardClick(warehouse.value)}
                  style={{
                    border: isSelected ? "2px solid #1890ff" : "1px solid #d9d9d9",
                    backgroundColor: isSelected ? "#e6f7ff" : "#ffffff",
                    cursor: "pointer",
                    height: "120px",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    position: "relative",
                  }}
                  bodyStyle={{
                    textAlign: "center",
                    width: "100%",
                    padding: "24px",
                  }}
                >
                  {isSelected && (
                    <CheckOutlined
                      style={{
                        position: "absolute",
                        top: 12,
                        right: 12,
                        fontSize: 20,
                        color: "#1890ff",
                      }}
                    />
                  )}
                  <Typography.Title
                    level={4}
                    style={{
                      margin: 0,
                      color: isSelected ? "#1890ff" : "#000000",
                      fontWeight: isSelected ? "bold" : "normal",
                    }}
                  >
                    {warehouse.label}
                  </Typography.Title>
                </Card>
              </Col>
            );
          })}
