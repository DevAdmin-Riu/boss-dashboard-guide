export const makePurchaseUnitPriceEa = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const params = utils.jsonParseWrapper(purchase.parameters);
  const product = params?.product;
  const attributes = product?.attributes;
  const quantityInBox = attributes?.quantity;
  // json Object 이름 변경 이전 구조 호환성을 위해 아래 처럼 처리
  const unitCostPriceExcludeVat = product?.unit_cost_price_exclude_vat;
  const isB2b = purchase.purchaseOrder?.isB2b;
  const priceDecimalPlaces = isB2b ? purchase.purchaseOrderLine?.variant?.priceDecimalPlaces : 1;
  const unitCostPriceEa =
    quantityInBox && unitCostPriceExcludeVat
      ? utils.convertToNumber(unitCostPriceExcludeVat / quantityInBox, priceDecimalPlaces)
      : 0;

  return isHtml ? <NumberComponent value={unitCostPriceEa} /> : unitCostPriceEa ?? "-";
};

export const makePurchaseQuantity = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const params = utils.jsonParseWrapper(purchase.parameters);
  const product = params?.product;
  const quantity = multiplePurchaseTypeTackBackValue(
    purchase.type,
    utils.convertToNumber(product?.quantity, purchase.purchaseOrderLine?.variant?.orderQtyDecimalPlaces)
  );
  return isHtml ? <NumberComponent value={quantity} /> : quantity ?? "-";
};

export const makePurchaseCostPriceExcludeVat = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
