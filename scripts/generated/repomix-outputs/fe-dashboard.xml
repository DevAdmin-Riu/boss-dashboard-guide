          <DItem label={IS_EXCLUSIVE}>{transformIsExclusive(product.isExclusive)}</DItem>
          <DItem label={TRACK_INVENTORY}>{transformTrackInventoryVariantType(productVariant.trackInventory)}</DItem>
          <DItem label={ALLOW_AUTO_CONSIGNMENT}>{transformAllowAutoConsignment(productVariant)}</DItem>
          <DItem label={"이너박스 운영 여부"}>{transformCanSaleByInner(productVariant.canSaleByInner)}</DItem>
          <DItem label={IS_INNER}>{transformIsInner(productVariant.isInner)}</DItem>
