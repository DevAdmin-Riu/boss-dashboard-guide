<file path="src/app/views/order/orders/components/RefundedListPage/filters.ts">
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createTextField } from "@utils/filters/fields";

export enum RefundedFilterKeys {
  orderSearch = "orderSearch",
  paymentSearch = "paymentSearch",
  userSearch = "userSearch",
  brandSearch = "brandSearch",
  productSearch = "productSearch",
  brandProductSearch = "brandProductSearch",
  refundedAt = "refundedAt",
}

export interface RefundedListFilterOpts {
  orderSearch: FilterOpts<string>;
  paymentSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  refundedAt: FilterOpts<MinMax>;
}

export function createFilterStructure(opts: RefundedListFilterOpts, isHqStaff: boolean): IFilter<RefundedFilterKeys> {
  let displayOrder = 0;
  const filters = [
    {
      ...createDateField(displayOrder++, RefundedFilterKeys.refundedAt, "환불일", opts.refundedAt.value),
      active: opts.refundedAt.active,
    },
    {
      ...createTextField(
        displayOrder++,
        RefundedFilterKeys.orderSearch,
        "주문번호",
        opts.orderSearch.value,
        "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
      ),
      active: opts.orderSearch.active,
    },
    !isHqStaff && {
      ...createTextField(
        displayOrder++,
        RefundedFilterKeys.paymentSearch,
        "결제번호",
        opts.paymentSearch.value,
        "결제번호로 검색"
      ),
      active: opts.paymentSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        RefundedFilterKeys.userSearch,
        filterNameConstant.USER_SEARCH,
        opts.userSearch.value
      ),
      active: opts.userSearch.active,
    },
    !isHqStaff && {
      ...createTextField(
        displayOrder++,
        RefundedFilterKeys.brandSearch,
        filterNameConstant.BRAND_SEARCH,
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    isHqStaff
      ? {
          ...createTextField(
            displayOrder++,
            RefundedFilterKeys.brandProductSearch,
            filterNameConstant.BRAND_PRODUCT_SEARCH,
            opts.brandProductSearch.value
          ),
          active: opts.brandProductSearch.active,
        }
      : {
          ...createTextField(
            displayOrder++,
            RefundedFilterKeys.productSearch,
            filterNameConstant.PRODUCT_SEARCH,
            opts.productSearch.value
          ),
          active: opts.productSearch.active,
        },
  ];
  return filters.filter(Boolean);
}
