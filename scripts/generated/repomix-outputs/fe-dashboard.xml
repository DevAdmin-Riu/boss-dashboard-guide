export const getExclusiveVariantsTableColumns = (pageType: HqInfoProductListType | ":pageType") => {
  const fixedFlag = utils.fixedLeftFlag();
  const isGeneralProductPage = pageType === "general";

  const bpSkuColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.brandProduct.BP_SKU,
    key: "bpSku",
    align: "center",
    width: 140,
    render: (_, record) => record.bpSku,
    fixed: fixedFlag,
  };

  const brandProductNameColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.brandProduct.BRAND_PRODUCT_NAME,
    key: "brandProductName",
    align: "left",
    width: 150,
    render: (_, record) => getProductName(record) || "-",
    fixed: fixedFlag,
  };

  const variantNameColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.product.VARIANT_NAME,
    key: "variantName",
    align: "left",
    width: 100,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return record.productVariant.product.productType.hasVariants ? record.productVariant.name || "-" : "-";
    },
  };

  const isInnerColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.product.IS_INNER,
    key: "isInner",
    align: "center",
    width: 100,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return transformIsInner(record.productVariant.isInner);
    },
  };

  const attributesColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.product.DETAIL_INFO,
    key: "attributes",
    align: "left",
    width: 200,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      const variant = record.productVariant;
      const product = variant?.product;
      const hasVariants = !!product?.productType?.hasVariants;
      const targetAttributes = hasVariants ? variant?.attributes : product?.attributes;
      return makeProductSpecTextFromAttr(targetAttributes) || "-";
    },
  };

  const qtyPerBoxColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
    key: "qtyPerBox",
    align: "right",
    width: 80,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return makeProductQtyPerBoxText(record.productVariant) || "-";
    },
  };

  const salesStatusByProductVariantColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.product.SALES_STATUS,
    key: "salesStatusByProductVariant",
    align: "center",
    width: 80,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return transformSalesStatusByProductVariant(record.productVariant.salesStatus);
    },
  };

  const salesStatusByBrandProductVariantColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: columnNameConstant.brandProduct.SALE_STATUS,
    key: "salesStatusByBrandProductVariant",
    align: "center",
    width: 80,
    render: (_, record) => transformSalesStatusByBrandProductVariant(record.salesStatus),
  };

  const stoppedAtByProductVariantColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: "단종 일자",
    key: "stoppedAtByProductVariant",
    align: "center",
    width: 120,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return record.salesStatus === SalesStatusEnum.STOPPED
        ? getDateByFormat(record.productVariant.stoppedAt, onlyDateFormat)
        : "-";
    },
  };

  const firstAvailableForPurchaseColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: "판매 시작 일자",
    key: "firstAvailableForPurchase",
    align: "center",
    width: 120,
    render: (_, record) => {
      if (isBpBundle(record)) {
        return "-";
      }
      return getDateByFormat(record.productVariant.firstAvailableForPurchase, onlyDateFormat);
    },
  };

  const stoppedAtByBrandProductVariantColumn: DownloadableColumnType<HqInfoProductListItem> = {
    title: "판매 중단 일자",
    key: "stoppedAtByBrandProductVariant",
    align: "center",
    width: 120,
    render: (_, record) =>
      record.salesStatus === SalesStatusEnum.ON_SALE ? "-" : getDateByFormat(record.stoppedAt, onlyDateFormat),
