import { PluginFilterInput } from "@src/api/types/globalTypes";
import { IFilterElement } from "@src/app/components/Filter";
import { PluginFilterKeys, PluginListFilterOpts } from "@src/app/views/settings/plugin/components/PluginsListPage";
import { createFilterTabUtils, createFilterUtils, getSingleValueQueryParam } from "@utils/filters";
import { maybe, parseBoolean } from "@utils/misc";
import { utils } from "@utils/utils";

import { PluginListViewUrlFilters, PluginListViewUrlFiltersEnum, PluginListViewUrlQueryParams } from "../../urls";

export const PLUGIN_FILTERS_KEY = "pluginFilters";

export function getFilterOpts(params: PluginListViewUrlFilters): PluginListFilterOpts {
  const filterVariables = getFilterVariables(params);
  return {
    search: {
      active: maybe(() => !utils.isEmpty(filterVariables.search, true), false),
      value: maybe(() => filterVariables.search, ""),
    },
    isActive: {
      active: maybe(() => !utils.isEmpty(filterVariables.active), false),
      value: filterVariables.active || true,
    },
  };
}

export function getFilterVariables(params: PluginListViewUrlFilters): PluginFilterInput {
  return {
    search: params.search,
    active: params.active !== undefined ? parseBoolean(params.active, true) : undefined,
  };
}

export function getFilterQueryParam(filter: IFilterElement<PluginFilterKeys>): PluginListViewUrlFilters {
  const { name } = filter;

  switch (name) {
    case PluginFilterKeys.search:
      return getSingleValueQueryParam(filter, PluginListViewUrlFiltersEnum.search);
    case PluginFilterKeys.active:
      return getSingleValueQueryParam(filter, PluginListViewUrlFiltersEnum.active);
  }
}

export const { deleteFilterTab, getFilterTabs, saveFilterTab } =
  createFilterTabUtils<PluginListViewUrlFilters>(PLUGIN_FILTERS_KEY);

export const { areFiltersApplied, getActiveFilters } = createFilterUtils<
  PluginListViewUrlQueryParams,
  PluginListViewUrlFilters
>(PluginListViewUrlFiltersEnum);
</file>

