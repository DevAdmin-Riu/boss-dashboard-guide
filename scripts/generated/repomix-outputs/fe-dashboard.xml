export const checkProductVariantUpdateRequired = (
  variant: ProductVariantDetails_productVariant,
  data: ProductVariantUpdateData
) => {
  if (!data) {
    return false;
  }

  if (data.trackInventory === false) {
    if (data.salesStatus === SalesStatusEnum.WILL_BE_STOPPED) {
      showNotificationError("위탁 제품은 단종 예정으로 변경할 수 없습니다.");
      return false;
    }
    const variantVendors = variant.productVariantVendors || [];
    const defaultVariantVendor =
      variantVendors.find((variantVendor) => variantVendor.id === variant.defaultVariantVendor?.id) ||
      variantVendors[0];
    if (
      !!defaultVariantVendor &&
      variant.isDeferred === false &&
      defaultVariantVendor.consignmentProductPriceExcludeVat <= 0
    ) {
      showNotificationError("기본 협력사의 위탁 상품가가 0 이하면 재고 미운영으로 설정할 수 없습니다.");
      return false;
    }
  }

  if ([SalesStatusEnum.WILL_BE_STOPPED, SalesStatusEnum.STOPPED].includes(data.salesStatus)) {
    if (utils.isEmpty(data.stoppedReason)) {
      showNotificationError("제품 상태가 정상이 아닌 경우 단종 사유를 입력해 주세요.");
      return false;
    }
    if (data.stoppedReason === StoppedReasonTypeEnum.ETC && utils.isEmpty(data.stoppedReasonEtc)) {
      showNotificationError("단종 사유가 기타인 경우 단종 상세 사유를 입력해 주세요.");
      return false;
    }
  }

  const commonCheck = commonCheckProductVariantRequired(data, variant.firstAvailableForPurchase, false);
  if (commonCheck === false) {
    return false;
  }

  const requiredAttributeIds = data?.attributes
    .filter((attribute) => attribute.data.valueRequired)
    .map((attribute) => attribute.id);
  if (requiredAttributeIds.length > 0) {
    const inputAttributeIds = data.attributes
      .filter((attribute) => utils.isEmpty(attribute.value) === false)
      .map((attribute) => attribute.id);
    const missingAttributeIds = requiredAttributeIds.filter((id) => !inputAttributeIds.includes(id));
    if (missingAttributeIds.length > 0) {
      showNotificationError("필수 속성을 입력 또는 선택해 주세요.");
      return false;
    }
  }

  return true;
};

