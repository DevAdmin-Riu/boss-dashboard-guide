import { PurchaseOrderLineSortField } from "@src/api/types/globalTypes";
import { getOrderDirection } from "@utils/sort";

import { PurchaseOrderLineListViewUrlQueryParams, PurchaseOrderLineListViewUrlSortField } from "../../urls";

export function getSortQueryField(sort: PurchaseOrderLineListViewUrlSortField): PurchaseOrderLineSortField {
  switch (sort) {
    case PurchaseOrderLineListViewUrlSortField.poLineNo:
      return PurchaseOrderLineSortField.PO_LINE_NO;
    case PurchaseOrderLineListViewUrlSortField.poDate:
      return PurchaseOrderLineSortField.PO_DATE;
    case PurchaseOrderLineListViewUrlSortField.expectedPurchaseDate:
      return PurchaseOrderLineSortField.EXPECTED_PURCHASE_DATE;
    default:
      return undefined;
  }
}

export function getSortQueryVariables(params: PurchaseOrderLineListViewUrlQueryParams) {
  const field = getSortQueryField(params.sort);
  if (!!field) {
    return {
      direction: getOrderDirection(params.asc),
      field,
    };
  }

  return undefined;
}
