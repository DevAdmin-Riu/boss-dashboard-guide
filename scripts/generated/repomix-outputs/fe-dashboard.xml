import makeMutation from "@hooks/makeMutation";
import { pageErrorFragment } from "@src/api/fragments/errors";
import { pageDetailsFragment } from "@src/api/fragments/pages";
import gql from "graphql-tag";

import { PageBulkDelete, PageBulkDeleteVariables } from "./types/PageBulkDelete";
import { PageBulkPublish, PageBulkPublishVariables } from "./types/PageBulkPublish";
import { PageCreate, PageCreateVariables } from "./types/PageCreate";
import { PageDelete, PageDeleteVariables } from "./types/PageDelete";
import { PageUpdate, PageUpdateVariables } from "./types/PageUpdate";

const pageCreate = gql`
  ${pageErrorFragment}
  mutation PageCreate($input: PageInput!) {
    pageCreate(input: $input) {
      errors: pageErrors {
        ...PageErrorFragment
      }
      page {
        id
      }
    }
  }
`;
export const usePageCreateMutation = makeMutation<PageCreate, PageCreateVariables>(pageCreate);

const pageUpdate = gql`
  ${pageDetailsFragment}
  ${pageErrorFragment}
  mutation PageUpdate($id: ID!, $input: PageInput!) {
    pageUpdate(id: $id, input: $input) {
      errors: pageErrors {
        ...PageErrorFragment
      }
      page {
        ...PageDetailsFragment
      }
    }
  }
`;
export const usePageUpdateMutation = makeMutation<PageUpdate, PageUpdateVariables>(pageUpdate);

const pageDelete = gql`
  ${pageErrorFragment}
  mutation PageDelete($id: ID!) {
    pageDelete(id: $id) {
      errors: pageErrors {
        ...PageErrorFragment
      }
    }
  }
`;
export const usePageDeleteMutation = makeMutation<PageDelete, PageDeleteVariables>(pageDelete);

const pageBulkPublish = gql`
  ${pageErrorFragment}
  mutation PageBulkPublish($ids: [ID]!, $isPublished: Boolean!) {
    pageBulkPublish(ids: $ids, isPublished: $isPublished) {
      errors: pageErrors {
        ...PageErrorFragment
      }
    }
  }
`;
export const usePageBulkPublish = makeMutation<PageBulkPublish, PageBulkPublishVariables>(pageBulkPublish);

const pageBulkDelete = gql`
  ${pageErrorFragment}
  mutation PageBulkDelete($ids: [ID]!) {
    pageBulkDelete(ids: $ids) {
      errors: pageErrors {
        ...PageErrorFragment
      }
    }
  }
`;
export const usePageBulkDeleteMutation = makeMutation<PageBulkDelete, PageBulkDeleteVariables>(pageBulkDelete);
</file>

