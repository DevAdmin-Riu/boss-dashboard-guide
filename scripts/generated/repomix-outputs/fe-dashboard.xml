const courierCreateMutation = gql`
  ${courierErrorFragment}
  mutation CourierCreate($input: CourierCreateInput!) {
    courierCreate(input: $input) {
      errors: courierErrors {
        ...CourierErrorFragment
      }
      courier {
        id
      }
    }
  }
`;
export const useCourierCreateMutation = makeMutation<CourierCreate, CourierCreateVariables>(courierCreateMutation);

const courierUpdateMutation = gql`
  ${courierErrorFragment}
  ${courierFragment}
  mutation CourierUpdate($id: ID!, $input: CourierUpdateInput!) {
    courierUpdate(id: $id, input: $input) {
      errors: courierErrors {
        ...CourierErrorFragment
      }
      courier {
        ...CourierFragment
      }
    }
  }
`;
export const useCourierUpdateMutation = makeMutation<CourierUpdate, CourierUpdateVariables>(courierUpdateMutation);
