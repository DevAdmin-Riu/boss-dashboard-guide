import { ApolloQueryResult } from "@apollo/client";
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { useCourierListQuery } from "@src/app/views/settings/couriers/api/queries";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Card, Row, Space, Table, Typography } from "antd";
import React from "react";

import {
  CouriersDeliveryFees,
  CouriersDeliveryFees_couriersDeliveryFees_edges_node,
  CouriersDeliveryFeesVariables,
} from "../../api/types/CouriersDeliveryFees";
import { createFilterStructure, ShippingHistoryFilterKeys, ShippingHistoryFilterOpts } from "./filter";
import { getShippingHistoryListTableSettings } from "./ShippingHistoryListTableSettings";

export interface ShippingHistoryPageProps
  extends PaginateListProps,
    FilterPageProps<ShippingHistoryFilterKeys, ShippingHistoryFilterOpts> {
  dataSource: CouriersDeliveryFees_couriersDeliveryFees_edges_node[];
  fetchForDownload: (
    variables?: Partial<CouriersDeliveryFeesVariables>
  ) => Promise<ApolloQueryResult<CouriersDeliveryFees>>;
  queryVariablesWithoutPagination: CouriersDeliveryFeesVariables;
  requestCancelReturn: ({ id, transUniqueCd }: { id: any; transUniqueCd: any }) => Promise<void>;
  onReturnCancel: (id: string, transUniqueCd: string) => void;
}

const ShippingHistoryListPage: React.FC<ShippingHistoryPageProps> = (props) => {
  const {
    currentTab,
    onAll,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    onFilterChange,
    filterOpts,
    disabled,
    dataSource,
    onUpdateListSettings,
    fetchForDownload,
    queryVariablesWithoutPagination,
  } = props;

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const { data: couriersData } = useCourierListQuery({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.couriers },
  });
  const couriers = maybe(() => couriersData.couriers.edges.map((edge) => edge.node), []);
  const columns = getShippingHistoryListTableSettings(props, couriers);

  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(columns, props.settings.columns);

  const handleSave = (columns) => onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const filterStructure = createFilterStructure(filterOpts);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "couriersDeliveryFees",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Typography.Title level={4}>{sectionNames.shippingHistory}</Typography.Title>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          onFilterChange={onFilterChange}
          filterStructure={filterStructure}
          tabExtra={
            <Space>
              <ColumnPicker
                columns={pickColumns}
                loading={disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </Space>
          }
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={disabled}
          columns={pickerSelectedColumns}
          dataSource={dataSource}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...props} />}
        />
      </Card>
    </Space>
  );
};

export default ShippingHistoryListPage;
</file>

