        false
      ),
      value: {
        max: maybe(() => filterVariables.pendingConfirmStatusAt.lte, todayMoment.format(onlyDateFormat)),
        min: maybe(() => filterVariables.pendingConfirmStatusAt.gte, todayMoment.format(onlyDateFormat)),
      },
    },
    confirmedStatusAt: {
