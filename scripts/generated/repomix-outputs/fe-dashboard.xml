export const makePurchaseQuantityInBox = (purchase: Purchases_purchases_edges_node, isHtml: boolean = true) => {
  const params = utils.jsonParseWrapper(purchase.parameters);
  const product = params?.product;
  const simpleAttribute = product?.attributes;
