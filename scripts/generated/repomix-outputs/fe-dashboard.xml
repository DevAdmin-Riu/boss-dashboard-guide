import { SubmitPromise } from "@hooks/useForm";
import useNavigator from "@hooks/useNavigator";
import useStateFromProps from "@hooks/useStateFromProps";
import { StaffErrorFragment } from "@src/api/fragments/types/StaffErrorFragment";
import { User_brand } from "@src/api/fragments/types/User";
import { SearchPermissionGroups_search_edges_node } from "@src/api/searches/types/SearchPermissionGroups";
import AccountPermissionGroups from "@src/app/components/AccountPermissionGroups";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import AccountStatus from "@src/app/components/AppStatus";
import StaffUsageCountCard from "@src/app/components/Card/StaffUsageCountCard";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Form from "@src/app/components/Form";
import Grid from "@src/app/components/Grid";
import { MultiAutocompleteChoiceType } from "@src/app/components/MultiAutocompleteSelectField";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import useLocale from "@src/app/providers/LocaleProvider/useLocale";
import { commonMsg } from "@src/global/assets/messages/commonMsg";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FetchMoreProps, SearchPageProps } from "@src/global/core/types/types";
import createMultiAutocompleteSelectHandler from "@utils/handlers/multiAutocompleteSelectChangeHandler";
import {
  checkIsEnableForFbvServiceByBrand,
  checkIsEnableForLinkersServiceByBrand,
  getDisplayUserName,
} from "@utils/misc";
import { Card, Space, Table, Typography } from "antd";
import React from "react";

import { pageContentViewUrl } from "../../../pages/urls";
import { StaffMemberDetails_user } from "../../api/types/StaffMemberDetails";
import StaffPassword from "../StaffPassword/StaffPassword";
import StaffPreferences from "../StaffPreferences";
import StaffProperties from "../StaffProperties/StaffProperties";
import { brandListColumns } from "./utils";

export interface StaffDetailsFormData {
  loginId: string;
  email: string;
  firstName: string;
  isActive: boolean;
  lastName: string;
  minusReverseFeeDepositAlarmThreshold: number;
  minQty: number;
  permissionGroups: string[];
}

export interface StaffDetailsPageProps extends SearchPageProps {
  brand: User_brand;
  availablePermissionGroups: SearchPermissionGroups_search_edges_node[];
  canEditAvatar: boolean;
  canEditPreferences: boolean;
  canEditStatus: boolean;
  canRemove: boolean;
  disabled: boolean;
  fetchMorePermissionGroups: FetchMoreProps;
  saveButtonBarState: ConfirmButtonTransitionState;
  staffMember: StaffMemberDetails_user;
  errors: StaffErrorFragment[];
  onBack: () => void;
  onChangePassword: () => void;
  onDelete?: () => void;
  onImageDelete: () => void;
  onSubmit: (data: StaffDetailsFormData) => SubmitPromise;
  onImageUpload(file: File);
}

const StaffDetailsPage: React.FC<StaffDetailsPageProps> = ({
  brand,
  availablePermissionGroups,
  canEditAvatar,
  canEditPreferences,
  canEditStatus,
  canRemove,
  disabled,
  errors,
  fetchMorePermissionGroups,
  initialSearch,
  onBack,
  onChangePassword,
  onDelete,
  onImageDelete,
  onImageUpload,
  onSearchChange,
  onSubmit,
  saveButtonBarState,
  staffMember,
}: StaffDetailsPageProps) => {
  const navigate = useNavigator();
  const { locale, setLocale } = useLocale();
  const [permissionGroupsDisplayValues, setPermissionGroupsDisplayValues] = useStateFromProps<
    MultiAutocompleteChoiceType[]
  >(
    (staffMember?.permissionGroups || []).map((group) => ({
      disabled: !group.userCanManage,
      label: group.name,
      value: group.id,
    })) || []
  );

  const enableForFbvService = checkIsEnableForFbvServiceByBrand(brand);
  const enableForLinkersService = checkIsEnableForLinkersServiceByBrand(brand);

  const isPaidNoticeCountCardShow = enableForFbvService && brand?.useFbvPaidNotice;
  const isDigitalContractCountCardShow = enableForLinkersService && brand?.useDigitalContract;
  const initialForm: StaffDetailsFormData = {
    loginId: staffMember?.loginId || "",
    email: staffMember?.email || "",
    firstName: staffMember?.firstName || "",
    isActive: !!staffMember?.isActive,
    lastName: staffMember?.lastName || "",
    permissionGroups: staffMember?.permissionGroups.map((pg) => pg.id) || [],
    minusReverseFeeDepositAlarmThreshold: -brand?.reverseFeeDepositAlarmThreshold,
    minQty: brand?.orgCode?.minQty,
  };

  return (
    <Form initial={initialForm} onSubmit={onSubmit} confirmLeave>
      {({ data: formData, change, hasChanged, submit, toggleValue }) => {
        const permissionGroupsChange = createMultiAutocompleteSelectHandler(
          toggleValue,
          setPermissionGroupsDisplayValues,
          permissionGroupsDisplayValues,
          availablePermissionGroups?.map((group) => ({
            label: group.name,
            value: group.id,
          })) || []
        );

        return (
          <>
            <AppHeader onBack={onBack}>{sectionNames.staff}</AppHeader>
            <PageHeader title={getDisplayUserName(staffMember)} />
            <Grid>
              <Space direction="vertical" size="large">
                <StaffProperties
                  brand={brand}
                  errors={errors}
                  data={formData}
                  disabled={disabled}
                  canEditAvatar={canEditAvatar}
                  staffMember={staffMember}
                  onChange={change}
                  onImageUpload={onImageUpload}
                  onImageDelete={onImageDelete}
                />
                {canEditPreferences && <StaffPassword onChangePassword={onChangePassword} />}
                <Card>
                  <Typography.Link strong onClick={() => navigate(pageContentViewUrl({ slug: "privacy" }))}>
                    개인정보처리방침
                  </Typography.Link>
                </Card>
              </Space>
              <Space direction="vertical" size="large" style={{ display: "flex" }}>
                {isPaidNoticeCountCardShow && (
                  <StaffUsageCountCard
                    mainTitle="알림톡 발송 카운트 1회/10원(부가세 별도)"
