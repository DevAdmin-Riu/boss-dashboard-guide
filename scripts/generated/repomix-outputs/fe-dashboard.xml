interface StockListViewProps {
  defaultParams: StockListViewUrlQueryParams;
  params: StockListViewUrlQueryParams;
}

export enum StockListModalModeEnum {
  StockDetailAdd = "StockDetailAdd",
  StockDetailLoss = "StockDetailLoss",
  StockDetailAdjustToZero = "StockDetailAdjustToZero",
  RackStockDetailMove = "RackStockDetailMove",
  RackStockList = "RackStockList",
  StockDetailEventList = "StockDetailEventList",
  StockDetailDivideOrCombine = "StockDetailDivideOrCombine",
  ProductToBeChangedInfo = "ProductToBeChangedInfo",
  PrintStockDetailEventList = "PrintStockDetailEventList",
}

export const StockListView: React.FC<StockListViewProps> = ({ defaultParams, params }) => {
  const routeParams = useParams<StockListViewRouteParams>();
  const { fbv: productType } = routeParams;
  const isFulfilledByVendor = productType === "fbv";
  const { user } = useAuth();
  const shop = useShop();

  const isStaffFbvMode = user.isStaff && isFulfilledByVendor;
  const isHqStaffFbvMode = user.isHqStaff && isFulfilledByVendor;
  const isVendorStaffFbvMode = user.isVendorStaff && isFulfilledByVendor;

  const [loadingForReport, setLoadingForReport] = useState<boolean>(false);
  const [modalMode, setModalMode] = useState<StockListModalModeEnum>(null);
  const [idForModal, setIdForModal] = useState<string>(null);
  const [additionalIdForModal, setAdditionalIdForModal] = useState<string>(null);
  const resetForCloseModal = () => {
    setIdForModal(null);
    setModalMode(null);
  };
  const openModalWithoutNavigate = (modalMode: StockListModalModeEnum, idForModal: string) => {
    setModalMode(modalMode);
    setIdForModal(idForModal);
  };

  const handleOpenStockDetailEventModal = (newVariantId: string, stockId: string) => {
    setAdditionalIdForModal(newVariantId);
    setIdForModal(stockId);
    setModalMode(StockListModalModeEnum.StockDetailEventList);
  };

  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.STOCK_LIST,
  });
  const { fetchForDownload: fetchForStockDetailEventListDownload } = utils.initListViewDownloadQuery(
    useDownloadStockDetailEventListQuery
  );

  const currencySymbol = maybe(() => shop.localizedDefaultCurrency, "원");
  const queryVariables = useMemo<ProductVariantListVariables>(
    () => ({
      ...paginationState,
      filter: {
        ...getFilterVariables(params),
        isFulfilledByVendor,
        brandIds: user && user.isHqStaff ? [user.brand.id] : null,
        vendorIds: user && user.isVendorStaff ? [user.vendor.id] : null,
      },
      sort: getSortQueryVariables(params),
      dependOnUser: isVendorStaffFbvMode ? false : true,
    }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useProductVariantListQuery({ initialListSkip: true, variables: queryVariables });
  const productVariants = maybe(() => data.productVariants.edges.map((edge) => edge.node), []);

  const { fetchForDownload } = utils.initListViewDownloadQuery(useProductVariantListFilterDownloadQuery);

  const targetUrl = (params: StockListViewUrlQueryParams) =>
    isHqStaffFbvMode
      ? hqStockListViewUrl(routeParams, params)
      : isVendorStaffFbvMode
      ? vendorStockListViewUrl(routeParams, params)
      : stockListViewUrl(routeParams, params);

  const handleSort = createSortHandler(navigate, targetUrl, params);

  const handleStockProductUpdate = (productId: string, variantId?: string, brandProductVariantId?: string) =>
    variantId
      ? navigate(productVariantUpdateViewUrl(productId, variantId))
      : navigate(
          isFulfilledByVendor ? hqFbvProductUpdateViewUrl(brandProductVariantId) : productUpdateViewUrl(productId)
        );

  const { data: warehousesData, loading: warehousesLoading } = useWarehouseSimpleList({
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.warehouses },
  });
  const warehouses = maybe(() => warehousesData.warehouses.edges.map((edge) => edge.node), []);

  const onDownloadStockDetailEventList = (durationVariable: string[]) => {
    const [gte, lte] = durationVariable;
    const queryVariables: DownloadStockDetailEventListVariables = {
      first: GrapheneRelayConnectionMaxLimitEnum.reportStockDetailEventList,
      filter: {
        date: { gte, lte },
        excludeType: [StockDetailEventsEnum.FULFILLMENT, StockDetailEventsEnum.FULFILLMENT_CANCEL],
        fbvBrandId: isHqStaffFbvMode ? user?.brand.id : undefined,
        fbvVendorId: isVendorStaffFbvMode ? user?.vendor.id : undefined,
        isFbv: isFulfilledByVendor,
      },
      sort: getStockDetailEventSortVariables(),
    };

    setLoadingForReport(true);
    showDownloadingMessage();

    const handleErrorCatch = (e: any) => {
      showNotificationError("재고조정내역 다운로드 과정에서 에러가 발생하였습니다.");
      throw e;
    };

    const handleRefetchFinally = () => {
      setLoadingForReport(false);
      destroyDownloadingMessage();
      resetForCloseModal();
    };

    fetchForStockDetailEventListDownload(queryVariables)
      .then((responseData) => {
        const errors = responseData?.errors;
        if (errors?.length >= 0) {
          showGraphQLErrors(errors);
        } else {
          const { columns } = parseStockDetailEventList(responseData, isFulfilledByVendor);
          if (!columns || columns.length <= 0) {
            showNotificationWarn("출력할 데이터가 없습니다.");
            return;
          }
          excelDownload({ title: "재고 조정내역", columns });
          if (
            responseData?.data?.stockDetailEventList?.edges?.length <
            responseData?.data?.stockDetailEventList?.totalCount
          ) {
            showNotificationWarn(commonErrorMsg.maxLimitIssue);
          } else {
            showNotificationSuccess(commonMsg.downloadedToXls);
          }
        }
      })
      .catch((e) => handleErrorCatch(e))
      .finally(handleRefetchFinally);
  };

  const filterOpts = getFilterOpts(params);

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.productVariants?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<StockListViewUrlDialog, StockListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    defaultParams,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  return (
    <>
      <StockListPage
        params={params}
        shop={shop}
        settings={settings}
        disabled={loading || warehousesLoading}
        variants={productVariants}
        warehouses={warehouses}
        pageInfo={pageInfo}
        onAdd={undefined}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        onUpdateStockProduct={handleStockProductUpdate}
        openModalWithoutNavigate={openModalWithoutNavigate}
        openStockDetailEventModal={handleOpenStockDetailEventModal}
        onPurchaseOrderCreate={() => navigate(purchaseOrderCreateViewUrl({ createType: "track-inventory" }))}
        currencySymbol={currencySymbol}
        currentTab={currentTab}
        filterOpts={filterOpts}
        sort={getSortParams(params)}
        onSort={handleSort}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={getFilterTabs().map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
        isStaffFbvMode={isStaffFbvMode}
        isHqStaffFbvMode={isHqStaffFbvMode}
        isVendorStaffFbvMode={isVendorStaffFbvMode}
        isFbv={isFulfilledByVendor}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
