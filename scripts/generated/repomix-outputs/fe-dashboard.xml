} from "../../api/types/BrandReverseFeeDepositEvents";
import { getReverseFeeTableSettings } from "./CustomerTableSettings";
import { createFilterStructure, HqInfoReverseFeeFilterKeys, HqInfoReverseFeeListFilterOpts } from "./filters";

interface HqInfoReverseFeePageProps
  extends PaginateListProps,
    FilterPageProps<HqInfoReverseFeeFilterKeys, HqInfoReverseFeeListFilterOpts> {
  onCreateReverseFeeEvent: () => void;
  brandReverseFee: BrandReverseFeeDepositEvents_brandReverseFeeDepositEvents_edges_node[];
  queryVariables: BrandReverseFeeDepositEventsVariables;
  reverseFeeDeposit?: number;
  queryVariablesWithoutPagination: BrandReverseFeeDepositEventsVariables;
  fetchForDownload: (
    variables?: BrandReverseFeeDepositEventsVariables
  ) => Promise<ApolloQueryResult<BrandReverseFeeDepositEvents>>;
  user: User;
}

const HqInfoReverseFeePage: React.FC<HqInfoReverseFeePageProps> = ({
  currencySymbol,
  currentTab,
  filterOpts,
  onAdd,
  onAll,
  onFilterChange,
  onTabChange,
  onTabDelete,
  onTabSave,
  tabs,
  queryVariables,
  reverseFeeDeposit,
  queryVariablesWithoutPagination,
  fetchForDownload,
  user,
  onCreateReverseFeeEvent,
  ...listProps
}) => {
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const structure = createFilterStructure(filterOpts, user);
  const columns = getReverseFeeTableSettings({ user });
  const tableWidthSum = utils.calcTableColsWidthSum(columns);
  const titleText = "금융 거래 내역";

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: columns,
    dataKey: "brandReverseFeeDepositEvents",
  };

  const addBrandButton = (
    <Button type="primary" shape="round" onClick={onCreateReverseFeeEvent}>
      외상 조정
    </Button>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{titleText}</Typography.Title>
        </Col>
        <Col>
          <Space direction="horizontal" size="small">
            {addBrandButton}
          </Space>
        </Col>
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={structure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={columns}
          dataSource={listProps.brandReverseFee}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
export default HqInfoReverseFeePage;
</file>

