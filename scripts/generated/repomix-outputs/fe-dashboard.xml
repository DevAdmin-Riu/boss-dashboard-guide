  const baseMakerOptions = makers.map((maker) => ({ label: getMakerLabel(maker), value: maker.id }));
  const makerOptions = utils.getOptionsWithInitialValue(baseMakerOptions, data[makerKey], data.makerLabel);

  return (
    <Row gutter={[12, 12]} align="middle">
      <Col xs={24} sm={6}>
        <RequiredTypography text={"제조사"} isRequired={true} />
      </Col>
      <Col xs={24} sm={18}>
        <Row justify="space-between" align="bottom">
          <Col span={24}>
            <FormFieldAntd label={""} error={formErrors} errorMsg={makeGqlErrorMsg(formErrors[makerKey])}>
              <Select
                showSearch
                size="large"
                disabled={disabled}
                style={{ width: "100%" }}
                loading={fetchMoreMakers.loading}
                status={!!formErrors[makerKey] ? "error" : ""}
                options={makerOptions}
                filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                placeholder="제조사 선택"
                value={data[makerKey]}
                onChange={(value) => onChangeWithValue(makerKey, value)}
                onSearch={fetchMakers}
                onPopupScroll={({ currentTarget }) => {
                  const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                  const { hasMore, loading, onFetchMore } = fetchMoreMakers;
                  // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                  if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                    onFetchMore();
                  }
                }}
              />
            </FormFieldAntd>
          </Col>
        </Row>
      </Col>
    </Row>
  );
};

const makeInspectionInfoFields = (props: ProductAttributesProps) => {
  const { data, disabled, onChange } = props;

  // 검수보고서 파일 리스트 생성 함수
  const getFileList = () => {
    const template = data.inspectReportTemplate;

    if (!template) {
      return [];
    }

    // 새로 선택한 파일 (File 객체)
    if (template instanceof File) {
      return [
        {
          uid: "-1",
          name: template.name,
          status: "done" as const,
        },
      ];
    }

    // 기존 서버의 파일 (url 포함 객체)
    if (template.url) {
      return [
        {
          uid: "-2",
          name: template.name || "기존 검수보고서 양식",
          status: "done" as const,
          url: template.url,
        },
      ];
    }

    return [];
  };

  return (
    <>
      <Row gutter={[12, 12]} align="middle">
        <Col span={8}>
          <FormFieldAntd label="검수 대상">
            <Switch
              disabled={disabled}
              checked={data.needToInspect}
              checkedChildren="ON"
              unCheckedChildren="OFF"
              onChange={(value) => onChange({ target: { name: "needToInspect", value } })}
            />
          </FormFieldAntd>
        </Col>
        <Col span={8}>
          <FormFieldAntd label="검수 사유">
            <Input
              size="large"
              disabled={disabled || data.needToInspect === false}
              placeholder="검수 사유 입력"
              value={data.inspectReason || ""}
              onChange={(e) => onChange({ target: { name: "inspectReason", value: e.target.value } })}
            />
          </FormFieldAntd>
        </Col>
        <Col span={8}>
          <FormFieldAntd label="검수 방식">
            <Input
              size="large"
              disabled={disabled || data.needToInspect === false}
              placeholder="검수 방식 입력"
              value={data.inspectType || ""}
              onChange={(e) => onChange({ target: { name: "inspectType", value: e.target.value } })}
            />
          </FormFieldAntd>
        </Col>
      </Row>
      <Row gutter={[12, 12]}>
        <Col span={24}>
          <FormFieldAntd label="검수 시 유의 사항">
            <Input.TextArea
              size="large"
              rows={3}
              disabled={disabled || data.needToInspect === false}
              placeholder="검수 시 유의 사항을 입력해주세요"
              value={data.inspectMemo || ""}
              onChange={(e) => onChange({ target: { name: "inspectMemo", value: e.target.value } })}
            />
          </FormFieldAntd>
        </Col>
      </Row>
      <Row gutter={[12, 12]}>
        <Col span={24}>
          <FormFieldAntd label="검수보고서 양식">
            <Upload
              disabled={disabled || data.needToInspect === false}
              maxCount={1}
              beforeUpload={(file) => {
                onChange({ target: { name: "inspectReportTemplate", value: file } });
                return false;
              }}
              onRemove={() => {
                onChange({ target: { name: "inspectReportTemplate", value: null } });
              }}
              fileList={getFileList()}
            >
              <Button icon={<UploadOutlined />} disabled={disabled}>
                파일 선택
              </Button>
            </Upload>
            <Typography.Text type="secondary" style={{ fontSize: "12px", display: "block", marginTop: "8px" }}>
              검수보고서 양식 파일을 업로드해주세요. 저장 시 함께 업로드됩니다.
            </Typography.Text>
          </FormFieldAntd>
        </Col>
      </Row>
    </>
  );
};

const makeAttributeFields = (props: ProductAttributesProps) => {
  const { data, disabled, errors, onSingleAttrChange, onMultiAttrChange } = props;
  const { attributes } = data;

  return (
    <Row gutter={[12, 12]}>
      {attributes.map((attribute) => {
        const error = errors.find((err) => err.attributes?.includes(attribute.id));
        const placeholder = getAttributeInputTypeText(attribute.data.inputType);
        const options = getAttributeValueChoices(attribute.id, attributes);
        const value = getAttributeValue(attribute);
        const slug = attribute.data.slug;
        const isBoxType = slug === AttributeSlugEnum.boxSize;

        const disabledFinal = disabled || isBoxType;

        return (
          <Col key={attribute.id} xs={24} sm={12}>
            <FormFieldAntd
              label={attribute.label}
              error={error}
              errorMsg={makeGqlErrorMsg(error)}
              isRequired={attribute.data.valueRequired}
            >
              {attribute.data.inputType === AttributeInputTypeEnum.DIRECTLY ? (
                <Input
                  size="large"
                  disabled={disabledFinal}
                  status={!!error ? "error" : undefined}
                  placeholder={placeholder}
                  onChange={(event) => onSingleAttrChange(attribute.id, event.target.value)}
                  value={value}
                />
              ) : (
                <Select
                  showSearch
                  key={attribute.id}
                  style={{ width: "100%" }}
                  size="large"
                  disabled={disabledFinal}
                  status={!!error ? "error" : ""}
                  placeholder={placeholder}
                  options={options}
                  onChange={(value) => {
                    if (attribute.data.inputType === AttributeInputTypeEnum.MULTISELECT) {
                      onMultiAttrChange(attribute.id, value);
                    } else {
                      onSingleAttrChange(attribute.id, value);
                    }
                  }}
                  filterOption={(input, option) => (option?.label ?? "").toLowerCase().includes(input.toLowerCase())}
                  value={value}
                />
              )}
            </FormFieldAntd>
          </Col>
        );
      })}
    </Row>
  );
};

// NOTE: 이전에 제품 상세, 옵션 상세에 따라 ProductVariantAttributes 컴포넌트와 분기되어 렌더링 했지만, 이제는 ProductAttributes 컴포넌트 하나로 통합되어 렌더링 됨.
// 직거래 상품은 팔레트 정보 일괄 0으로 입력 처리하므로, 팔레트 정보 필드는 미노출.
export const ProductAttributes: React.FC<ProductAttributesProps> = (props) => {
  const { isProductPage, isFulfilledByVendor, data } = props;
  const isFulfilledByBoss = isFulfilledByVendor === false;
  const { attributes, hasVariants, trackInventory, canSaleByInner } = props.data;

  return (
    <Card title={<CardTitleAntd title="속성" />} bodyStyle={{ padding: 0 }}>
      <Collapse defaultActiveKey={["box", "purchaseOrder", "inspectionInfo", "attributes"]}>
        {/* 옵션형 제품의 제품 상세 페이지인 경우 - 박스 규격, 입수량 필드는 미노출. 옵션 단위에서 수정 가능하도록. */}
        {(isProductPage && hasVariants) === false && (
          <>
            <Collapse.Panel header="기본 정보" key="box">
              <Space direction="vertical" size="middle" split={<Divider style={{ margin: 0 }} />}>
                {makeBoxSizeFields(props, false)}
                {canSaleByInner && makeBoxSizeFields(props, true)}
                {makeQtyPerBoxFields(props)}
                {isFulfilledByBoss && makePalletFields(props)}

                {makeMakerField(props)}
                {data.isForCreditsRefill === false && makeCountryField(props)}
              </Space>
            </Collapse.Panel>
            <Collapse.Panel header="발주 정보" key="purchaseOrder">
              <Space direction="vertical" size="middle" split={<Divider style={{ margin: 0 }} />}>
                {makeSalesUnitTypeField(props)}
                {makePoLeadTimeField(props)}
                {isFulfilledByBoss && (trackInventory || canSaleByInner) && makeQtyForStockFields(props)}
                {makeSeasonalProductField(props)}
              </Space>
            </Collapse.Panel>
            {(trackInventory || canSaleByInner) && (
              <Collapse.Panel header="검수 정보" key="inspectionInfo">
                <Space direction="vertical" size="middle" split={<Divider style={{ margin: 0 }} />}>
                  {makeInspectionInfoFields(props)}
                </Space>
              </Collapse.Panel>
            )}
          </>
        )}
        <Collapse.Panel header={`속성 ${attributes.length}개`} key="attributes">
          {makeAttributeFields(props)}
        </Collapse.Panel>
      </Collapse>
    </Card>
  );
};
