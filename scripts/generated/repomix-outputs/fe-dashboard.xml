import { fileNameDateFormat } from "@src/app/providers/DateProvider";
import {
  destroyDownloadingMessage,
  showDownloadingMessageWritingToWord,
  showNotificationError,
} from "@utils/notification/wrapper";
import { Document, Packer } from "docx";
import saveAs from "file-saver";
import moment from "moment";

interface WordDownloadProps {
  title: string;
  doc: Document;
}

export const wordDownload = (props: WordDownloadProps) => {
  const { title, doc } = props;
  showDownloadingMessageWritingToWord();

  const wordFileName = `${title}-${moment().format(fileNameDateFormat)}.docx`;

  Packer.toBlob(doc)
    .then((blob) => {
      saveAs(blob, wordFileName);
