import { InfoCircleOutlined } from "@ant-design/icons";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import {
  BrandContractStatusEnum,
  BrandContractTypeEnum,
  BrandCreateInput,
  BrandEtcFileTypeEnum,
  BrandServiceTypeEnum,
  BrandUpdateInput,
} from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps, getTableClassName } from "@src/app/components/antd/Table/TableProps";
import { FieldPath } from "@src/app/components/antd/types/GenericFieldPath";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import EditableField from "@src/app/components/EditableField/EditableField";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  brandB2bPayMethodChoices,
  brandContractFileTypeChoices,
  brandContractStatusChoices,
  brandContractTypeChoices,
  brandDeliveryFeeTypeChoices,
  brandExclusiveBpvTypeChoices,
  brandFeeFileTypeChoices,
  brandServiceChoices,
  checkIsNotRunningContractStatusEnum,
} from "@src/app/views/brand/brands/utils";
import { checkIsEnableForOnlyLinkersServiceByBrand } from "@utils/misc";
import { utils } from "@utils/utils";
import { Col, Divider, Form, Input, Row, Tooltip, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

type TFormData = BrandCreateInput | BrandUpdateInput;

interface BrandContractInfoProps {
  isCreate: boolean;
  TypeSafeForm: TypeSafeForm<TFormData>;
  editMode?: boolean;
}

export const BrandContractInfo: React.FC<BrandContractInfoProps> = (props) => {
  const { isCreate, TypeSafeForm, editMode } = props;

  const { tableRef: etcTableRef, tableScrollY: etcTableScrollY } = useTableScrollInitialize();
  const { tableRef: feeTableRef, tableScrollY: feeTableScrollY } = useTableScrollInitialize();

  const realEditMode = isCreate || editMode;

  const etcFileColumns: ColumnsType<{ key: number }> = [
    {
      title: "계약서",
      key: "type",
      align: "center",
      width: 90,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.type`;
        return (
          <>
            <Typography.Text>{brandContractFileTypeChoices[index]?.label}</Typography.Text>
            <Form.Item name={TypeSafeForm.getValidDataIndex(namePath)} hidden={true}>
              <Input />
            </Form.Item>
          </>
        );
      },
    },
    {
      title: "갱신일",
      key: "contractDate",
      align: "center",
      width: 90,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.contractDate`;
        return (
          <EditableField
            type="datepicker"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            formDateFormat={onlyDateFormat}
          />
        );
      },
    },
    {
      title: "계약 시작일",
      key: "startDate",
      align: "center",
      width: 90,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.startDate`;
        return (
          <EditableField
            type="datepicker"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            placeholder="시작일 선택"
            formDateFormat={onlyDateFormat}
          />
        );
      },
    },
    {
      title: "계약 종료일",
      key: "endDate",
      align: "center",
      width: 90,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.endDate`;
        return (
          <EditableField
            type="datepicker"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            placeholder="종료일 선택"
            formDateFormat={onlyDateFormat}
          />
        );
      },
    },
    {
      title: [columnNameConstant.brand.INSURANCE_DEPOSIT, columnNameConstant.brand.DEPOSIT],
      key: "insuranceDeposit",
      align: "center",
      width: 120,
      render: (_, __, index) => {
        const isDeposit =
          brandContractFileTypeChoices[index]?.value === BrandEtcFileTypeEnum.INSURANCE_CONTRACT ||
          brandContractFileTypeChoices[index]?.value === BrandEtcFileTypeEnum.DEPOSIT_CONTRACT;

        let postFixFormName: "deposit" | "insuranceDeposit";
        switch (brandContractFileTypeChoices[index]?.value) {
          case BrandEtcFileTypeEnum.INSURANCE_CONTRACT:
            postFixFormName = "insuranceDeposit";
            break;
          case BrandEtcFileTypeEnum.DEPOSIT_CONTRACT:
            postFixFormName = "deposit";
            break;
          default:
            break;
        }
        const namePath: FieldPath<TFormData> = `etcInfo.${postFixFormName}`;

        return isDeposit ? (
          <EditableField
            type="number"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
          />
        ) : (
          "-"
        );
      },
    },
    {
      title: "비고",
      key: "description",
      width: 160,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.description`;
        return (
          <EditableField
            type="input"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
          />
        );
      },
    },
    {
      title: "첨부자료",
      key: "file",
      align: "center",
      width: 80,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index}.file`;
        return (
          <EditableField
            type="upload"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            uploadText={"업로드"}
            singleFileMode={true}
          />
        );
      },
    },
  ];

  const offset = brandContractFileTypeChoices.length;

  const feeFileColumns: ColumnsType<{ key: number }> = [
    {
      title: "수수료",
      key: "type",
      align: "center",
      width: 80,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index + offset}.type`;
        return (
          <>
            <Typography.Text>{brandFeeFileTypeChoices[index]?.label}</Typography.Text>
            <Form.Item name={TypeSafeForm.getValidDataIndex(namePath)} hidden={true}>
              <Input />
            </Form.Item>
          </>
        );
      },
    },
    {
      title: "갱신일",
      key: "contractDate",
      align: "center",
      width: 90,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index + offset}.contractDate`;
        return (
          <EditableField
            type="datepicker"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            formDateFormat={onlyDateFormat}
          />
        );
      },
    },
    {
      title: "수수료(%)",
      key: "insuranceDeposit",
      width: 40,
      render: (_, __, index) => {
        let postFixFormName: "brandWarehouseFeeRate" | "vendorWarehouseFeeRate" | "commonFeeRate";
        switch (brandFeeFileTypeChoices[index]?.value) {
          case BrandEtcFileTypeEnum.BRAND_WAREHOUSE_FEE:
            postFixFormName = "brandWarehouseFeeRate";
            break;
          case BrandEtcFileTypeEnum.VENDOR_WAREHOUSE_FEE:
            postFixFormName = "vendorWarehouseFeeRate";
            break;
          case BrandEtcFileTypeEnum.COMMON_FEE:
            postFixFormName = "commonFeeRate";
            break;
        }
        const namePath: FieldPath<TFormData> = `etcInfo.${postFixFormName}`;

        return (
          <EditableField
            type="number"
            precision={2}
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
          />
        );
      },
    },
    {
      title: "비고",
      key: "description",
      width: 160,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index + offset}.description`;
        return (
          <EditableField
            type="input"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
          />
        );
      },
    },
    {
      title: "첨부자료",
      key: "file",
      align: "center",
      width: 80,
      render: (_, __, index) => {
        const namePath: FieldPath<TFormData> = `etcFiles.${index + offset}.file`;
        return (
          <EditableField
            type="upload"
            name={TypeSafeForm.getValidDataIndex(namePath)}
            value={TypeSafeForm.getFieldValue(namePath)}
            editMode={realEditMode}
            uploadText={"업로드"}
            singleFileMode={true}
          />
        );
      },
    },
  ];

  const etcTableWidthSum = utils.calcTableColsWidthSum(etcFileColumns);
  const feeTableWidthSum = utils.calcTableColsWidthSum(feeFileColumns);

  const contractType = TypeSafeForm.getUseFormWatched({ name: "contractType" });
  const contractStatus = TypeSafeForm.getUseFormWatched({ name: "contractStatus" });
  const enabledServices = TypeSafeForm.getUseFormWatched({ name: "enabledServices" }) || [];
  const enableForB2bService = enabledServices.includes(BrandServiceTypeEnum.B2B);
  const enableForFbvService = enabledServices.includes(BrandServiceTypeEnum.FBV);
  const enableForLinkersService = enabledServices.includes(BrandServiceTypeEnum.LINKERS);
  const enableForOnlyLinkersService = checkIsEnableForOnlyLinkersServiceByBrand({ enabledServices });

  const isNotRunningContractStatus = checkIsNotRunningContractStatusEnum(contractStatus);
  const disabledForContractType = enableForB2bService || enableForOnlyLinkersService;
  const disabledForEnableRcoinReward =
    contractType === BrandContractTypeEnum.REVERSE_FEE || enableForFbvService === true || enableForOnlyLinkersService;

  const brandContractStatusChoicesForUser = isCreate
    ? brandContractStatusChoices.filter((c) =>
        [BrandContractStatusEnum.RUNNING, BrandContractStatusEnum.IN_CONSULTING].includes(c.value)
      )
    : brandContractStatusChoices;
  const brandContractTypeChoicesForUser = brandContractTypeChoices.map((c) => {
    if (utils.isEmpty(enabledServices)) {
      return c;
    }
    const isB2bChoice = c.value === BrandContractTypeEnum.B2B;
    if (isB2bChoice) {
      return { ...c, disabled: enableForB2bService === false };
    }
    return { ...c, disabled: enableForB2bService };
  });
  const brandServiceChoicesForUser = brandServiceChoices.map((c) => {
    if (utils.isEmpty(enabledServices)) {
      return c;
    }
    const isB2bChoice = c.value === BrandServiceTypeEnum.B2B;
    if (isB2bChoice) {
      return { ...c, disabled: enableForB2bService === false };
    }
    return { ...c, disabled: enableForB2bService };
  });

  return (
    <>
      <Row gutter={[8, 0]}>
        <Col span={24}>
          <Row gutter={[8, 0]}>
            <Col xs={24} sm={6}>
              <EditableField
                label={columnNameConstant.brand.CONTRACT_STATUS}
                type="select"
                options={brandContractStatusChoicesForUser}
                name={TypeSafeForm.getValidDataIndex("contractStatus")}
                value={TypeSafeForm.getFieldValue("contractStatus")}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label={columnNameConstant.brand.IS_RUNNING}
                type="switch"
                disabled={isNotRunningContractStatus}
                name={TypeSafeForm.getValidDataIndex("isRunning")}
                value={TypeSafeForm.getFieldValue("isRunning")}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label={columnNameConstant.brand.ENABLED_SERVICES}
                type="checkboxGroup"
                options={brandServiceChoicesForUser}
                name={TypeSafeForm.getValidDataIndex("enabledServices")}
                value={TypeSafeForm.getFieldValue("enabledServices")}
                editMode={realEditMode}
              />
            </Col>
          </Row>
        </Col>
        {!isNotRunningContractStatus && (
          <>
            <Col xs={24} sm={enableForB2bService ? 5 : 6}>
              <EditableField
                label={columnNameConstant.brand.CONTRACT_TYPE}
                type="select"
                options={brandContractTypeChoicesForUser}
                name={TypeSafeForm.getValidDataIndex("contractType")}
                value={TypeSafeForm.getFieldValue("contractType")}
                disabled={disabledForContractType}
                editMode={realEditMode}
              />
            </Col>
            {enableForB2bService && (
              <Col xs={24} sm={4}>
                <EditableField
                  label="B2B 결제 조건"
                  type="select"
                  options={brandB2bPayMethodChoices}
                  name={TypeSafeForm.getValidDataIndex("b2bPayMethod")}
                  value={TypeSafeForm.getFieldValue("b2bPayMethod")}
                  editMode={realEditMode}
                />
              </Col>
            )}
            <Col xs={24} sm={enableForB2bService ? 5 : 6}>
              <EditableField
                label={columnNameConstant.brand.MILEAGE_RATE.join("")}
                type="number"
                precision={2}
                name={TypeSafeForm.getValidDataIndex("mileageRate")}
                value={TypeSafeForm.getFieldValue("mileageRate")}
                disabled={enableForOnlyLinkersService}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={enableForB2bService ? 5 : 6}>
              <EditableField
                label="배송비 가맹점 청구"
                type="select"
                options={brandDeliveryFeeTypeChoices}
                name={TypeSafeForm.getValidDataIndex("deliveryFeeType")}
                value={TypeSafeForm.getFieldValue("deliveryFeeType")}
                disabled={enableForOnlyLinkersService}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={enableForB2bService ? 5 : 6}>
              <EditableField
                label="전용상품 운영기준"
                type="select"
                options={brandExclusiveBpvTypeChoices}
                name={TypeSafeForm.getValidDataIndex("exclusiveBpvType")}
                value={TypeSafeForm.getFieldValue("exclusiveBpvType")}
                disabled={enableForOnlyLinkersService}
                editMode={realEditMode}
              />
            </Col>
          </>
        )}
      </Row>
      {!enableForB2bService && !isNotRunningContractStatus && (
        <>
          <Divider />
          <Row gutter={[8, 8]}>
            <Col span={24}>
              <Typography.Text strong type="secondary">
                부가 서비스
              </Typography.Text>
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label={
                  <Tooltip
                    placement="topLeft"
                    title={`매장이 충전금으로 ${columnNameConstant.brandProduct.POINT_BENEFIT} 상품 결제 시 포인트를 지급합니다.`}
                  >
                    충전금 혜택 <InfoCircleOutlined />
                  </Tooltip>
                }
                type="switch"
                name={TypeSafeForm.getValidDataIndex("enableRcoinRewardForUsingPoint")}
                value={TypeSafeForm.getFieldValue("enableRcoinRewardForUsingPoint")}
                disabled={disabledForEnableRcoinReward}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label={columnNameConstant.brand.IS_BOSS_MARKET_USE.join(" ")}
                type="switch"
                name={TypeSafeForm.getValidDataIndex("isBossMarketUse")}
                value={TypeSafeForm.getFieldValue("isBossMarketUse")}
                disabled={enableForOnlyLinkersService}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label="전자계약"
                type="switch"
                name={TypeSafeForm.getValidDataIndex("useDigitalContract")}
                value={TypeSafeForm.getFieldValue("useDigitalContract")}
                disabled={enableForLinkersService === false}
                editMode={realEditMode}
              />
            </Col>
            <Col xs={24} sm={6}>
              <EditableField
                label="직거래 협력사 알림톡 발송"
                type="switch"
                name={TypeSafeForm.getValidDataIndex("useFbvPaidNotice")}
                value={TypeSafeForm.getFieldValue("useFbvPaidNotice")}
                disabled={enableForFbvService === false}
                editMode={realEditMode}
              />
            </Col>
          </Row>
        </>
      )}
      {!isNotRunningContractStatus && (
        <>
          <Divider />
          <PatchedColumnsTable
            {...commonTableProps}
            className={getTableClassName(["ant-no-padding-table"])}
            ref={etcTableRef}
            rowKey={(record) => record.key}
            columns={etcFileColumns}
            dataSource={brandContractFileTypeChoices.map((_, index) => ({ key: index }))}
            scroll={{ x: etcTableWidthSum, y: etcTableScrollY }}
          />
          <PatchedColumnsTable
            {...commonTableProps}
            className={getTableClassName(["ant-no-padding-table"])}
            ref={feeTableRef}
            rowKey={(record) => record.key}
            columns={feeFileColumns}
            dataSource={brandFeeFileTypeChoices.map((_, index) => ({ key: index }))}
            scroll={{ x: feeTableWidthSum, y: feeTableScrollY }}
          />
        </>
      )}
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandCollapseComponents/BrandFbvInfo.tsx">
import { BrandCreateInput, BrandUpdateInput } from "@src/api/types/globalTypes";
import { TypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import EditableField from "@src/app/components/EditableField/EditableField";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { extractHourMinuteFormat, onlyDateFormat } from "@src/app/providers/DateProvider";
import { BrandDetails_brand } from "@src/app/views/brand/brands/api/types/BrandDetails";
import { BrandVacsFeeEventTable } from "@src/app/views/brand/brands/components/BrandVacsFeeEventTable";
import { getFbvLastOrderDate } from "@src/app/views/brand/brands/utils";
import { utils } from "@utils/utils";
import { Col, Form, Input, InputNumber, Row, TimePicker, Typography } from "antd";
import moment from "moment/moment";
import React, { useEffect, useState } from "react";

interface BrandFbvInfoProps {
  isCreate: boolean;
  TypeSafeForm: TypeSafeForm<BrandCreateInput | BrandUpdateInput>;
  editMode?: boolean;
  brand?: BrandDetails_brand;
}

export const BrandFbvInfo: React.FC<BrandFbvInfoProps> = (props) => {
  const { isCreate, TypeSafeForm, editMode, brand } = props;

  const realEditMode = isCreate || editMode;

  const [lastOrderInfo, setLastOrderInfo] = useState<string>("");

  const fbvLastOrderInfoDayWatched = TypeSafeForm.getUseFormWatched({ name: "fbvLastOrderInfo.day" });
  const fbvLastOrderInfoHourWatched = TypeSafeForm.getUseFormWatched({ name: "fbvLastOrderInfo.hour" });

  useEffect(() => {
    const data = {
      lastOrderDay: fbvLastOrderInfoDayWatched,
      lastOrderHour: fbvLastOrderInfoHourWatched,
    };
    const lastOrderDate = getFbvLastOrderDate(data);
    setLastOrderInfo(lastOrderDate.format(onlyDateFormat));
  }, [fbvLastOrderInfoDayWatched, fbvLastOrderInfoHourWatched]);

  return (
    <>
      <Row gutter={[8, 0]}>
        <Col span={24}>
          <Row justify="end">
            <TableVatLegend isIncludeVat={false} />
          </Row>
        </Col>
        <Col xs={24} sm={12}>
          <Typography.Title level={5}>주문 마감 시간</Typography.Title>
          배송{" "}
          <Form.Item name={TypeSafeForm.getValidDataIndex("fbvLastOrderInfo.day")} noStyle>
            <InputNumber
              {...getInputNumberProps({ isCommaDisplay: true })}
              size="small"
              style={{ width: 50, margin: "0 2px" }}
              placeholder="며칠"
              disabled={!realEditMode}
            />
          </Form.Item>
          일 전의
          <Form.Item name={TypeSafeForm.getValidDataIndex("fbvLastOrderInfo.hour")} hidden>
            <Input />
          </Form.Item>
          <TimePicker
            format={extractHourMinuteFormat}
            style={{ width: 70, margin: "0 2px" }}
            size="small"
            suffixIcon={"시"}
            showNow={false}
            disabled={!realEditMode}
            value={moment(fbvLastOrderInfoHourWatched || 0, extractHourMinuteFormat)}
            onSelect={(val) => {
              if (utils.isEmpty(val)) {
                return false;
              }
              TypeSafeForm.setFields([
                {
                  touched: true,
                  name: "fbvLastOrderInfo.hour",
                  value: Number(val.format(extractHourMinuteFormat).substring(0, 2)),
                },
              ]);
            }}
            onChange={(val) => {
              TypeSafeForm.setFields([
                {
                  touched: true,
                  name: "fbvLastOrderInfo.hour",
                  value: Number(val.format(extractHourMinuteFormat).substring(0, 2)),
                },
              ]);
            }}
            minuteStep={60}
          />
          에 해당 배송일로 주문이 마감됩니다. 현재 시점 기준 지정 가능한 가장 빠른 배송일{" "}
          {<Typography.Text mark>{lastOrderInfo}</Typography.Text>} 입니다.
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            label="충전금 계좌 발행 수수료"
            type="number"
            name={TypeSafeForm.getValidDataIndex("vacsCreateFeeExcludeVat")}
            value={TypeSafeForm.getFieldValue("vacsCreateFeeExcludeVat")}
            editMode={realEditMode}
          />
        </Col>
        <Col xs={24} sm={4}>
          <EditableField
            label="충전금 이체 시 수수료"
            type="number"
            name={TypeSafeForm.getValidDataIndex("vacsChargeFeeExcludeVat")}
            value={TypeSafeForm.getFieldValue("vacsChargeFeeExcludeVat")}
            editMode={realEditMode}
          />
        </Col>
      </Row>
      {!isCreate && <BrandVacsFeeEventTable brand={brand} />}
    </>
  );
};
</file>

<file path="src/app/views/brand/brands/components/BrandCollapseComponents/BrandOrderStat.tsx">
import { paymentTerm } from "@assets/messages/commonMsg";
import { BrandOrderStatFilterInput, StatReportingMode } from "@src/api/types/globalTypes";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import Money from "@src/app/components/Money";
import NumberComponent from "@src/app/components/Number";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { getDatesBetween, onlyDateFormat, onlyMonthFormat } from "@src/app/providers/DateProvider";
import { useBrandOrderStatsQuery } from "@src/app/views/hqStaff/hqSection/api/queries";
import { BrandOrderStats_brandOrderStats } from "@src/app/views/hqStaff/hqSection/api/types/BrandOrderStats";
import { makeOrderDateElement } from "@src/app/views/hqStaff/hqSection/components/HqStatsOrder/utils";
import { StrictOmit } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { getGteLteVariables } from "@utils/filters";
import { checkIsEnableForB2bServiceByBrand, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Row, Space, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import moment from "moment-timezone";
import React, { useEffect, useState } from "react";

import { useExclusiveVariantMonthlyStockInfoForBrandQuery } from "../../api/queries";
import { BrandDetails_brand } from "../../api/types/BrandDetails";

interface TBrandOrderStatData extends BrandOrderStats_brandOrderStats {
  // YYYY-MM
  monthStr: string;
}

interface TBrandExclusiveStockData
  extends Pick<
    BrandDetails_brand,
    | "inStockExclusiveVariantsCount"
    | "totalExclusiveBpvCost"
    | "totalExclusivePvCost"
    | "criticalExclusiveVariantsCount"
    | "criticalTotalExclusiveBpvCost"
    | "criticalTotalExclusivePvCost"
  > {
  // YYYY-MM
  monthStr: string;
}

interface BrandOrderStatProps {
  brand: BrandDetails_brand;
}

export const BrandOrderStat: React.FC<BrandOrderStatProps> = (props) => {
  const { brand } = props;
  const brandId = brand.id;
  const enableForB2bService = checkIsEnableForB2bServiceByBrand(brand);

  const [orderStatDataSource, setOrderStatDataSource] = useState<TBrandOrderStatData[]>([]);
  const [exclusiveStockDataSource, setExclusiveStockDataSource] = useState<TBrandExclusiveStockData[]>([]);

  const { dates } = getDatesBetween([moment().subtract(2, "months"), moment()], "month");
  const [thirdMonthMoment, lastMonthMoment, todayMoment] = dates.map((date) => date.clone());
  const thisMonthStr = todayMoment.format(onlyMonthFormat);
  const lastMonthStr = lastMonthMoment.format(onlyMonthFormat);
  const thirdMonthStr = thirdMonthMoment.format(onlyMonthFormat);

  const todayMonthGte = todayMoment.startOf("month").format(onlyDateFormat);
  const todayMonthLte = todayMoment.endOf("month").format(onlyDateFormat);

  const lastMonthGte = lastMonthMoment.startOf("month").format(onlyDateFormat);
  const lastMonthLte = lastMonthMoment.endOf("month").format(onlyDateFormat);

  const thirdMonthGte = thirdMonthMoment.startOf("month").format(onlyDateFormat);
  const thirdMonthLte = thirdMonthMoment.endOf("month").format(onlyDateFormat);

  const commonFilterVariables: StrictOmit<BrandOrderStatFilterInput, "statDate"> = {
    mode: StatReportingMode.MONTHLY,
  };

  const { data: curMonthData, loading: curMonthLoading } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: { ...commonFilterVariables, statDate: getGteLteVariables({ gte: todayMonthGte, lte: todayMonthLte }) },
    },
  });

  const { data: lastMonthData, loading: lastMonthLoading } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: { ...commonFilterVariables, statDate: getGteLteVariables({ gte: lastMonthGte, lte: lastMonthLte }) },
    },
  });

  const { data: thirdMonthData, loading: thirdMonthLoading } = useBrandOrderStatsQuery({
    variables: {
      id: brandId,
      filter: { ...commonFilterVariables, statDate: getGteLteVariables({ gte: thirdMonthGte, lte: thirdMonthLte }) },
    },
  });

  // 1, 2개월 전 데이터 조회
  const { data: exclusiveStockInfoData, loading: exclusiveStockInfoLoading } =
    useExclusiveVariantMonthlyStockInfoForBrandQuery({
      variables: { id: brandId, statDate: { gte: thirdMonthGte, lte: lastMonthLte } },
    });
  const exclusiveStockInfo = maybe(() => exclusiveStockInfoData.exclusiveVariantMonthlyStockInfoForBrand, []);

  useEffect(() => {
    if (!curMonthData) {
      return;
    }

    const processOrderStatData = (
      monthStr: string,
      data: BrandOrderStats_brandOrderStats[] | undefined,
      rangeStart: string
    ): TBrandOrderStatData | null => {
      if (!data) {
        return null;
      }
      return {
        monthStr,
        ...data[0],
        ...makeOrderDateElement(rangeStart, data),
      };
    };

    const thisMonthDataProcessed = processOrderStatData(thisMonthStr, curMonthData?.brandOrderStats, todayMonthGte);
    const lastMonthDataProcessed = processOrderStatData(lastMonthStr, lastMonthData?.brandOrderStats, lastMonthGte);
    const thirdMonthDataProcessed = processOrderStatData(thirdMonthStr, thirdMonthData?.brandOrderStats, thirdMonthGte);

    const newOrderStatDataSource = [thisMonthDataProcessed, lastMonthDataProcessed, thirdMonthDataProcessed].filter(
      Boolean
    );
    setOrderStatDataSource(newOrderStatDataSource);
  }, [thirdMonthLoading, lastMonthLoading, curMonthLoading]);

  useEffect(() => {
    if (!brand) {
      return;
    }

    const processExclusiveStockData = (
      monthStr: string,
      data:
        | Pick<
            BrandDetails_brand,
            | "inStockExclusiveVariantsCount"
            | "totalExclusiveBpvCost"
            | "totalExclusivePvCost"
            | "criticalExclusiveVariantsCount"
            | "criticalTotalExclusiveBpvCost"
            | "criticalTotalExclusivePvCost"
          >
        | undefined
    ): TBrandExclusiveStockData | null => ({
      monthStr,
      inStockExclusiveVariantsCount: data?.inStockExclusiveVariantsCount,
      totalExclusiveBpvCost: data?.totalExclusiveBpvCost,
      totalExclusivePvCost: data?.totalExclusivePvCost,
      criticalExclusiveVariantsCount: data?.criticalExclusiveVariantsCount,
      criticalTotalExclusiveBpvCost: data?.criticalTotalExclusiveBpvCost,
      criticalTotalExclusivePvCost: data?.criticalTotalExclusivePvCost,
    });

    const newExclusiveStockDataSource: TBrandExclusiveStockData[] = [processExclusiveStockData(thisMonthStr, brand)];
    [lastMonthStr, thirdMonthStr].forEach((monthStr) => {
      const monthData = exclusiveStockInfo.find((info) => moment(info.statDate).format(onlyMonthFormat) === monthStr);
      newExclusiveStockDataSource.push(processExclusiveStockData(monthStr, monthData));
    });

    setExclusiveStockDataSource(newExclusiveStockDataSource);
  }, [brandId, exclusiveStockInfoLoading]);

  const orderStatColumns: ColumnsType<TBrandOrderStatData> = [
    {
      title: "월",
      key: "month",
      align: "center",
      width: 80,
      render: (_, record) => record.monthStr,
    },
    enableForB2bService === false && {
      title: "반품배송비",
      key: "statReturnDeliveryFeeExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: toPriceExcludeVat(record.statReturnDeliveryFee) }} />,
    },
    enableForB2bService === false && {
      title: "본부수익금",
      key: "statMileageExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statMileageExcludeVat }} />,
    },
    {
      title: "판매 총액",
      key: "statTotalPriceExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statTotalPriceExcludeVat }} />,
    },
    enableForB2bService === false && {
      title: ["사용", `${paymentTerm.cashableCredits}`],
      key: "statCashableCreditsExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statCashableCreditsExcludeVat }} />,
    },
    enableForB2bService === false && {
      title: ["사용", `${paymentTerm.nonCashableCredits}`],
      key: "statNonCashableCreditsExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statNonCashableCreditsExcludeVat }} />,
    },
    enableForB2bService === false && {
      title: ["사용", `${paymentTerm.rcoins}`],
      key: "statRcoinsExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statRcoinsExcludeVat }} />,
    },
    {
      title: "계약 매입 총액",
      key: "statBrandCostPriceExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statBrandCostPriceExcludeVat }} />,
    },
    enableForB2bService === false && {
      title: "계약 배송비 총액",
      key: "statBrandDeliveryFeeExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: toPriceExcludeVat(record.statBrandDeliveryFee) }} />,
    },
    enableForB2bService && {
      title: "B2B 배송비 총액",
      key: "statB2bDeliveryFeeExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: toPriceExcludeVat(record.statB2bDeliveryFeeExcludeVat) }} />,
    },
    enableForB2bService === false && {
      title: "청구 결제 수수료",
      key: "statBrandPayingChargeExcludeVat",
      align: "right",
      width: 150,
      render: (_, record) => <Money money={{ amount: record.statBrandPayingChargeExcludeVat }} />,
    },
  ];
  const filteredOrderStatColumns = orderStatColumns.filter(Boolean);
  const orderStatTableWidthSum = utils.calcTableColsWidthSum(filteredOrderStatColumns);

  const exclusiveStockColumns: ColumnsType<TBrandExclusiveStockData> = [
    {
      title: "월",
      key: "month",
      align: "center",
      width: 80,
      render: (_, record) => record.monthStr,
    },
    {
      title: columnNameConstant.brand.IN_STOCK_EXCLUSIVE_PV_COUNT,
      key: "inStockExclusiveVariantsCount",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record.inStockExclusiveVariantsCount} />,
    },
    {
      title: columnNameConstant.brand.TOTAL_EXCLUSIVE_PV_COST,
      key: "totalExclusiveBpvCost",
      align: "right",
      width: 120,
      render: (_, record) => <Money money={{ amount: toPriceExcludeVat(record.totalExclusiveBpvCost) }} />,
    },
    {
      title: columnNameConstant.brand.CRITICAL_IN_STOCK_EXCLUSIVE_PV_COUNT,
      key: "criticalExclusiveVariantsCount",
      align: "right",
      width: 100,
      render: (_, record) => <NumberComponent value={record.criticalExclusiveVariantsCount} />,
    },
    {
      title: columnNameConstant.brand.CRITICAL_TOTAL_EXCLUSIVE_PV_COST,
      key: "criticalTotalExclusiveBpvCost",
      align: "right",
      width: 120,
      render: (_, record) => <Money money={{ amount: toPriceExcludeVat(record.criticalTotalExclusiveBpvCost) }} />,
    },
  ];
  const exclusiveStockTableWidthSum = utils.calcTableColsWidthSum(exclusiveStockColumns);

  return (
    <Space direction="vertical">
      <PatchedColumnsTable<TBrandOrderStatData>
        {...commonTableProps}
        rowKey={(record) => record.monthStr}
        title={() => (
          <Row justify="space-between">
            <Typography.Text strong>매출 정보 (최근 {orderStatDataSource.length}개월)</Typography.Text>
