export const parseOrderNumberAndFulfillmentOrderFormat = (OrderNumberAndFulfillmentOrder: string) => {
  // NOTE: 직거래 상품인 경우 주문 번호의 prefix는 "#"으로 시작함. B2B 주문에 대해서도 이 유틸을 쓸 경우 B2B 주문 번호의 prefix("B-#")도 조건에 추가해야 함.
  if (OrderNumberAndFulfillmentOrder.startsWith("#")) {
    const parts = OrderNumberAndFulfillmentOrder.slice(1).split("-");
    if (parts.length === 2) {
      return {
        orderNumber: parts[0] !== "?" ? parts[0] : null,
        fulfillmentOrder: parts[1] !== "?" ? parts[1] : null,
      };
    }
  }
  return {
    orderNumber: null,
    fulfillmentOrder: null,
  };
};

export const checkIsPointsOnlyPay = (token: string) => {
  if (!token) {
    return false;
  }
  return token.toUpperCase() === "POINTS_ONLY";
};

// 가상 계좌 token
// 토스: "가상계좌" / 이니시스: "VBANK"
export const checkIsVbankPay = (token: string) => {
  if (!token) {
    return false;
  }
  const toUpper = token.toUpperCase();
  return toUpper === "가상계좌" || toUpper === "VBANK";
};

// 신용카드 token
// 토스: "카드" / 이니시스: "CARD", "VCARD"
export const checkIsCardPay = (token: string) => {
  if (!token) {
    return false;
  }
  const toUpper = token.toUpperCase();
  return toUpper === "카드" || toUpper === "CARD" || toUpper === "VCARD";
};

export const checkIsDeferredPay = (token: string) => {
  if (!token) {
    return false;
  }
  const toUpper = token.toUpperCase();
  return toUpper === "DEFERRED";
};

export const makePayMethodForPgRefund = (payMethod: PgRefundEventPayMethodEnum | string) => {
  if (!payMethod) {
    return "-";
  }
  // enum으로 처리되기 이전에는 이니시스 환불 수단이 문자열로 처리되어있었기 때문에 이전 데이터를 위해 문자열도 처리
  switch (payMethod) {
    case PgRefundEventPayMethodEnum.TOSS_CARD:
    case PgRefundEventPayMethodEnum.INICIS_CARD:
    case "CARD":
    case "VCARD":
      return "신용카드";
    case PgRefundEventPayMethodEnum.TOSS_VBANK:
    case PgRefundEventPayMethodEnum.INICIS_VBANK:
    case "VACCT":
      return "가상계좌";
    default:
      return "?";
  }
};

export const makeStatusForPgRefund = (status: PgRefundEventStatusEnum) => {
  if (!status) {
    return "-";
  }
  switch (status) {
    case PgRefundEventStatusEnum.REQUESTED:
      return "요청 발송";
    case PgRefundEventStatusEnum.SUCCESS:
      return "정상 처리";
    case PgRefundEventStatusEnum.FAIL:
      return "실패";
    default:
      return "?";
  }
};

export const checkRefundedByPaymentChargeStatus = (chargeStatus: PaymentChargeStatusEnum) =>
  chargeStatus === PaymentChargeStatusEnum.PARTIALLY_REFUNDED ||
  chargeStatus === PaymentChargeStatusEnum.FULLY_REFUNDED;

export const makeCombinePayMethod = (
  payment: {
    token: string;
    cashableCredits: number;
    nonCashableCredits: number;
    rcoins: number;
    isTossRiuPay: boolean;
  },
  orderType: OrderType
) => {
  if (!payment) {
    return "-";
  }
  const { token, cashableCredits, nonCashableCredits, rcoins, isTossRiuPay } = payment;
  if (!token) {
    return "-";
  }

  const combinePayMethod = [];

  if (checkIsPointsOnlyPay(token) === false) {
    if (isTossRiuPay) {
      combinePayMethod.push("카드 (보스페이)");
    } else if (checkIsCardPay(token)) {
      combinePayMethod.push("카드 (일반)");
    } else if (checkIsVbankPay(token)) {
      combinePayMethod.push("가상계좌");
    } else if (checkIsDeferredPay(token)) {
      if (checkOrderedByStaffForBrand(orderType)) {
        combinePayMethod.push("후불 결제");
      } else if (checkOrderedByStaffForBadStock(orderType)) {
        combinePayMethod.push("외부 결제");
      }
    }
  }

  if (cashableCredits + nonCashableCredits > 0) {
    combinePayMethod.push(`${paymentTerm.credits}`);
  }
  if (rcoins > 0) {
    combinePayMethod.push(`${paymentTerm.rcoins}`);
  }
  return combinePayMethod.join(" + ");
};

