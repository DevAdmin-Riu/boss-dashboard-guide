import DeleteFilterTabDialog from "@src/app/components/DeleteFilterTabDialog";
import SaveFilterTabDialog from "@src/app/components/SaveFilterTabDialog";
import { ListViews } from "@src/global/core/types/types";
import { getStringOrPlaceholder, maybe } from "@utils/misc";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Modal, Typography } from "antd";
import React from "react";

import { useMakerDeleteMutation } from "../../api/mutations";
import { makerListQuery, useMakerListFilterDownloadQuery, useMakerListQuery } from "../../api/queries";
import { MakersVariables } from "../../api/types/Makers";
import { MakerCreateOrUpdateModal } from "../../components/MakerCreateOrUpdateModal";
import MakerListPage from "../../components/MakerListPage/MakerListPage";
import { makerListViewUrl, MakerListViewUrlDialog, MakerListViewUrlQueryParams } from "../../urls";
import { getMakerLabel } from "../../utils";
import {
  areFiltersApplied,
  deleteFilterTab,
  getActiveFilters,
  getFilterOpts,
  getFilterQueryParam,
  getFilterTabs,
  getFilterVariables,
  saveFilterTab,
} from "./filters";

interface MakerListViewProps {
  params: MakerListViewUrlQueryParams;
}

export const MakerListView: React.FC<MakerListViewProps> = ({ params }) => {
  const targetUrl = makerListViewUrl;
  const { navigate, paginate, updateListSettings, settings, paginationState } = utils.initListViewSettings({
    params,
    listViewsName: ListViews.MAKER_LIST,
  });
  const { fetchForDownload } = utils.initListViewDownloadQuery(useMakerListFilterDownloadQuery);

  const queryVariables: MakersVariables = React.useMemo(
    () => ({ ...paginationState, filter: getFilterVariables(params) }),
    [params, settings?.rowNumber]
  );

  const { data, loading, refetch } = useMakerListQuery({ initialListSkip: true, variables: queryVariables });
  const makers = maybe(() => data.makers.edges.map((edge) => edge.node), []);
  const isMakerSelected = utils.isEmpty(params.id, true) === false && makers.some((maker) => maker.id === params.id);
  const selectedMaker = isMakerSelected ? makers.find((maker) => maker.id === params.id) : null;

  const [deleteMaker, deleteMakerOpts] = useMakerDeleteMutation({
    onCompleted: (data) => {
      const errors = data.makerDelete.errors;
      if (errors.length === 0) {
        showNotificationSuccess("선택한 제조사가 삭제되었습니다.");
        closeModal();
      } else {
        showGqlErrors(errors, makeGqlErrorMsg);
      }
    },
    refetchQueries: [makerListQuery],
  });

  const { queryVariablesWithoutPagination, loadNextPage, loadPreviousPage, pageInfo } = utils.initListViewPagination({
    paginate,
    queryVariables,
    pageInfoPath: data?.makers?.pageInfo,
    paginationState,
    params,
  });

  const {
    tabs,
    currentTab,
    openModal,
    closeModal,
    handleTabChange,
    handleFilterTabDelete,
    handleFilterTabSave,
    changeFilters,
    resetFilters,
  } = utils.initListViewFilterTabs<MakerListViewUrlDialog, MakerListViewUrlQueryParams>({
    navigate,
    targetUrl,
    params,
    areFiltersApplied,
    getFilterTabs,
    deleteFilterTab,
    saveFilterTab,
    getActiveFilters,
    getFilterQueryParam,
    refetch,
  });

  const pageLoading = loading || deleteMakerOpts.loading;

  return (
    <>
      <MakerListPage
        settings={settings}
        disabled={pageLoading}
        makers={makers}
        pageInfo={pageInfo}
        onAdd={() => openModal("create-maker")}
        onUpdate={(id) => navigate(makerListViewUrl({ action: "update-maker", id }))}
        onDelete={(id) => navigate(makerListViewUrl({ action: "delete-maker", id }))}
        onNextPage={loadNextPage}
        onPreviousPage={loadPreviousPage}
        onUpdateListSettings={updateListSettings}
        currentTab={currentTab}
        filterOpts={getFilterOpts(params)}
        onFilterChange={changeFilters}
        onTabSave={() => openModal("save-search")}
        onTabDelete={() => openModal("delete-search")}
        onTabChange={handleTabChange}
        tabs={tabs.map((tab) => tab.name)}
        onAll={resetFilters}
        queryVariablesWithoutPagination={queryVariablesWithoutPagination}
        fetchForDownload={fetchForDownload}
      />
      <SaveFilterTabDialog open={params.action === "save-search"} onClose={closeModal} onSubmit={handleFilterTabSave} />
      <DeleteFilterTabDialog
        open={params.action === "delete-search"}
        onClose={closeModal}
        onSubmit={handleFilterTabDelete}
        tabName={getStringOrPlaceholder(tabs[currentTab - 1]?.name)}
      />
      <MakerCreateOrUpdateModal
        open={params.action === "create-maker" || params.action === "update-maker"}
        loading={pageLoading}
        maker={selectedMaker}
        onClose={closeModal}
      />
      <Modal
        open={isMakerSelected && params.action === "delete-maker"}
        title="제조사 삭제"
        okButtonProps={{ danger: true, loading: pageLoading }}
        okText="삭제"
        onOk={() => deleteMaker({ variables: { id: selectedMaker?.id } })}
        onCancel={closeModal}
      >
        <Typography>선택한 제조사({getMakerLabel(selectedMaker)})를 삭제하시겠습니까?</Typography>
      </Modal>
    </>
  );
};
</file>

