import "./ModusignTemplateConfirmView.scss";

import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { utils } from "@utils/utils";
import { Spin } from "antd";
import React, { useLayoutEffect } from "react";

import { useModusignTemplateMetadataUpdateMutation } from "../../api/mutations";
import { ModusignTemplateConfirmUrlQueryParams, modusignTemplateListUrl } from "../../urls";

interface ModusignTemplateConfirmViewProps {
  params: ModusignTemplateConfirmUrlQueryParams;
}

const ModusignTemplateConfirmView: React.FC<ModusignTemplateConfirmViewProps> = (props) => {
  const { params } = props;
  const navigate = useNavigator();
  const { templateId, eventType } = params;
  const { user } = useUser();
  const brandCode = user?.brand?.code;

  const isTemplateMetadataUpdateError =
    utils.isEmpty(brandCode) || utils.isEmpty(params) || utils.isEmpty(templateId) || utils.isEmpty(eventType);
  if (isTemplateMetadataUpdateError) {
    showNotificationError("잘못된 접근입니다. 다시 시도해 주세요.");
    navigate(modusignTemplateListUrl(), true);
    return;
  }

  const [modusignTemplateMetadataUpdate] = useModusignTemplateMetadataUpdateMutation({
    onCompleted: (data) => {
      const errors = data.modusignTemplateMetadataUpdate.errors;
      if (errors.length === 0) {
        showNotificationSuccess("서식이 생성되었습니다.");
        navigate(modusignTemplateListUrl(), true);
      } else {
        showNotificationError("서식 생성에 실패했습니다. 다시 시도해 주세요.");
        navigate(modusignTemplateListUrl(), true);
      }
    },
  });

  useLayoutEffect(() => {
    if (isTemplateMetadataUpdateError === false) {
      modusignTemplateMetadataUpdate({
        variables: {
          input: {
            brandCode,
            templateId,
          },
        },
      });
    }
  }, []);
  return (
    <div className="signature-overlay-mask">
      <Spin tip="잠시만 기다려 주세요..."></Spin>
    </div>
  );
};

export default ModusignTemplateConfirmView;
</file>

