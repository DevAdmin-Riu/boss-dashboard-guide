import { PayloadAction } from "@reduxjs/toolkit";

export type MenuModeForHq = "boss" | "linkers" | "b2b";

export interface ListQuerySkipState {
  initialValue: boolean;
  value: boolean;
  // 최초 진입 시 비어있는 페이지는 캐싱되는 데이터와 함께 업데이트 시각도 리덕스에 저장
  updatedAtBySearchStr: {
    [searchStr: string]: string;
  };
}

export interface CommonState {
  isReqBossListPrevAll: boolean;
  isCustomMenuChangeFlag: boolean;
  menuModeForHq?: MenuModeForHq;
  listQuerySkip: {
    [key: string]: ListQuerySkipState;
  };
}

export const initialState: CommonState = {
  isReqBossListPrevAll: false,
  isCustomMenuChangeFlag: false,
  listQuerySkip: {},
};

export const commonReducer = {
  isReqBossListPrevAllChange: (state, action: PayloadAction<boolean>) => {
    state.isReqBossListPrevAll = action.payload;
  },
  isCustomMenuChangeFlagChange: (state, action: PayloadAction<boolean>) => {
    state.isCustomMenuChangeFlag = action.payload;
  },
  menuModeForHqChange: (state: CommonState, action: PayloadAction<MenuModeForHq>) => {
    state.menuModeForHq = action.payload;
  },
  menuModeForHqDelete: (state: CommonState) => {
    delete state.menuModeForHq;
  },
  listQuerySkipChange: (state: CommonState, action: PayloadAction<{ key: string; skipState: ListQuerySkipState }>) => {
    const { key, skipState } = action.payload;
    state.listQuerySkip[key] = skipState;
  },
};
