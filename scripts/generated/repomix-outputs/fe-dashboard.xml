import {
  getDisplayInnerProductName,
  maybe,
  transformIsExclusive,
  transformIsInner,
  transformSalesStatusByProductVariant,
  transformStoppedReason,
  transformTaxFree,
  transformTrackInventoryVariantType,
} from "@utils/misc";
import { utils } from "@utils/utils";
import { Space, Tag, TagProps, Tooltip, Typography } from "antd";
import React from "react";

import { categoryKindChoices } from "../../../categories/utils";
import { GridAttributes_availableInGrid_edges_node } from "../../api/types/GridAttributes";
import { ProductList_products_edges_node_variants } from "../../api/types/ProductList";
import { ProductVariantList_productVariants_edges_node } from "../../api/types/ProductVariantList";
import { makeProductQtyPerBoxText, makeProductSpecTextFromAttr } from "../../utils/data";
import { checkHasVariants } from "../../utils/utils";
import { ProductDataSourceType } from "./ProductListPage";
import { makePrefixForProductPrice } from "./utils";

interface ProductListTableSettingsProps extends PaginateListProps {
  isFulfilledByVendor: boolean;
  availableInGridAttributes: GridAttributes_availableInGrid_edges_node[];
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[];
}

export const makeProductHasVariants = (
  product: ProductDataSourceType | SearchProducts_search_edges_node,
  isHtml: boolean = true
) => {
  const hasVariants = checkHasVariants(product);
  const variants = product.variants as Array<
    ProductList_products_edges_node_variants | SearchProducts_search_edges_node_variants
  >;
  const outerVariants = variants?.filter((variant) => variant.isInner === false) || [];
  const hasVariantsTagColor: TagProps["color"] = hasVariants ? "orange" : "default";
  const hasVariantsText = hasVariants ? `${commonMsg.configurable}(${outerVariants.length}개)` : commonMsg.simple;

  return isHtml ? <Tag color={hasVariantsTagColor}>{hasVariantsText}</Tag> : hasVariantsText;
};

export const makeSalesStatusByProductVariant = (
  productVariant: Pick<
    ProductVariantList_productVariants_edges_node,
    "salesStatus" | "stoppedAt" | "stoppedReason" | "stoppedReasonEtc"
  >,
  stoppedReasonChoices: ShopInfo_shop_stoppedReasonChoices[],
  isHtml: boolean = true
) => {
  if (!productVariant) {
    return "-";
  }

  const { salesStatus, stoppedAt, stoppedReason, stoppedReasonEtc } = productVariant;
  const stoppedAtText = `단종일: ${getDateByFormat(stoppedAt, onlyDateFormat)}`;
  const stoppedReasonText = transformStoppedReason(stoppedReasonChoices, stoppedReason, stoppedReasonEtc);
  const stoppedText =
    salesStatus === SalesStatusEnum.WILL_BE_STOPPED ? (
      stoppedReasonText
    ) : salesStatus === SalesStatusEnum.STOPPED ? (
      <>
        {stoppedReasonText}
        <br />({stoppedAtText})
      </>
    ) : null;
  const salesStatusTagColor: TagProps["color"] = salesStatus === SalesStatusEnum.ON_SALE ? "default" : "gray";
  const salesStatusText = transformSalesStatusByProductVariant(salesStatus);

  return isHtml ? (
    <Tooltip title={stoppedText} placement="top">
      <Tag color={salesStatusTagColor}>{salesStatusText}</Tag>
    </Tooltip>
  ) : (
    salesStatusText
  );
};

const makeTrackInventoryVariantType = (product: ProductDataSourceType, isHtml: boolean = true) => {
  const variant = product?.variant;
  if (!variant) {
    return "-";
  }

  const isTrackInventoryVariant = variant.trackInventory;
  const isAllowAutoConsignment = variant.allowAutoConsignment;
  const color = isTrackInventoryVariant ? "purple" : "blue";

  if (isHtml) {
    return (
      <Space direction="vertical" size="small">
        <Tag color={color}>{transformTrackInventoryVariantType(isTrackInventoryVariant)}</Tag>
        {isAllowAutoConsignment && <Tag color={"orange"}>자동위탁</Tag>}
      </Space>
    );
  } else {
    // 텍스트로 반환
    const tags = [];
    tags.push(transformTrackInventoryVariantType(isTrackInventoryVariant));
    if (isAllowAutoConsignment) {
      tags.push("자동위탁");
    }

    return tags.join(", ");
  }
};

// (재고 판매 or 직배송) 협력사 매입가 - 재고 미운영 제품은 협력사 매입가를 표시하지 않음(이너박스 제품은 해당 제품의 협력사 매입가 표시)
export const getVariantCostPriceExcludeVat = (
  variant: Pick<ProductList_products_edges_node_variants, "trackInventory" | "costPriceExcludeVat">
) => {
  if (!variant) {
    return null;
  }
  const { trackInventory, costPriceExcludeVat } = variant;
  if (!trackInventory || utils.isEmpty(costPriceExcludeVat)) {
    return null;
  }
  return costPriceExcludeVat;
};

// (재고 판매 or 직배송) 택배비 - 재고 미운영 제품은 택배비를 표시하지 않음(이너박스 제품은 해당 값이 존재하지 않음)
export const getVariantDeliveryFeeExcludeVat = (
  variant: Pick<ProductList_products_edges_node_variants, "isInner" | "trackInventory" | "deliveryFeeAmount">
) => {
  if (!variant) {
    return null;
  }
  const { trackInventory, isInner, deliveryFeeAmount } = variant;
  if (!trackInventory || isInner || utils.isEmpty(deliveryFeeAmount)) {
    return null;
  }
  return toPriceExcludeVat(deliveryFeeAmount, false);
};

// 위탁 판매 협력사 매입가 - 재고 운영 or 직배송 제품은 위탁 판매 협력사 매입가를 표시하지 않음(이너박스 제품은 해당 값이 존재하지 않음)
export const getVariantConsignmentCostPriceExcludeVat = (
  variant: Pick<ProductList_products_edges_node_variants, "isInner" | "consignmentCostPriceExcludeVat">
) => {
  if (!variant) {
    return null;
  }
  const { isInner, consignmentCostPriceExcludeVat } = variant;
  if (isInner || utils.isEmpty(consignmentCostPriceExcludeVat)) {
    return null;
  }
  return consignmentCostPriceExcludeVat;
};

// 위탁 판매 택배비 - 재고 운영 or 직배송 제품은 위탁 판매 택배비를 표시하지 않음(이너박스 제품은 해당 값이 존재하지 않음)
export const getVariantConsignmentDeliveryFeeExcludeVat = (
  variant: Pick<ProductList_products_edges_node_variants, "isInner" | "consignmentDeliveryFeeAmount">
) => {
  if (!variant) {
    return null;
  }
  const { isInner, consignmentDeliveryFeeAmount } = variant;
  if (isInner || utils.isEmpty(consignmentDeliveryFeeAmount)) {
    return null;
  }
  return toPriceExcludeVat(consignmentDeliveryFeeAmount, false);
};

// 소분 판매 비용 - 이너박스 제품만 해당
export const getVariantInnerIncidentalCostExcludeVat = (
  variant: Pick<ProductList_products_edges_node_variants, "isInner" | "innerIncidentalCostAmount">
) => {
  if (!variant) {
    return null;
  }
  const { isInner, innerIncidentalCostAmount } = variant;
  if (!isInner || utils.isEmpty(innerIncidentalCostAmount)) {
    return null;
  }
  return toPriceExcludeVat(innerIncidentalCostAmount, false);
};

// 재고 판매 공급원가
export const getVariantPriceExcludeVat = (
  variant: Pick<
    ProductList_products_edges_node_variants,
    "isInner" | "trackInventory" | "costPriceExcludeVat" | "deliveryFeeAmount" | "innerIncidentalCostAmount"
  >
) =>
  getVariantCostPriceExcludeVat(variant) +
  getVariantDeliveryFeeExcludeVat(variant) +
  getVariantInnerIncidentalCostExcludeVat(variant);

// 위탁 판매 공급원가
export const getVariantConsignmentPriceExcludeVat = (
  variant: Pick<
    ProductList_products_edges_node_variants,
    "isInner" | "consignmentCostPriceExcludeVat" | "consignmentDeliveryFeeAmount"
  >
) => getVariantConsignmentCostPriceExcludeVat(variant) + getVariantConsignmentDeliveryFeeExcludeVat(variant);

export const getProductListTableSettings = ({
