const scheduleUpdateMutation = gql`
  ${scheduleFragment}
  ${scheduleErrorFragment}
  mutation ScheduleUpdate($id: ID!, $input: ScheduleInput!) {
    scheduleUpdate(id: $id, input: $input) {
      schedule {
        ...ScheduleFragment
      }
      errors: scheduleErrors {
        ...ScheduleErrorFragment
      }
    }
  }
`;
export const useScheduleUpdateMutation = makeMutation<ScheduleUpdate, ScheduleUpdateVariables>(scheduleUpdateMutation);

const scheduleDeleteMutation = gql`
  ${scheduleErrorFragment}
  mutation ScheduleDelete($id: ID!) {
    scheduleDelete(id: $id) {
      errors: scheduleErrors {
        ...ScheduleErrorFragment
      }
    }
  }
`;
export const useScheduleDeleteMutation = makeMutation<ScheduleDelete, ScheduleDeleteVariables>(scheduleDeleteMutation);

const sendComplainMutation = gql`
  mutation SendComplain($input: SendComplainInput!) {
    sendComplain(input: $input) {
      errors {
