  fulfillmentCourierName: "fulfillmentCourierName", // 택배사
  fulfillmentTrackingNumber: "fulfillmentTrackingNumber", // 송장번호
  fulfillmentEtcDeliveryVehicle: "fulfillmentEtcDeliveryVehicle", // 배차차량정보
  fulfillmentEtcDeliveryManContact: "fulfillmentEtcDeliveryManContact", // 배송기사 연락처

  note: "note", // 발주서 메모
  // TODO: 여기에 새로운 템플릿 키 추가
  // 예: newFieldKey: "newFieldKey", // 새로운 필드 설명
};

const getPoLineQuantity = (
  purchaseOrder: PrintPurchaseOrder_purchaseOrder,
  purchaseOrderLine: PrintPurchaseOrder_purchaseOrder_lines
) => multiplePoEventTypeTackBackValue(purchaseOrder?.eventType, purchaseOrderLine.quantity) || defaultNumValue;

export const calcPoLineUnitCostPriceExcludeVat = (
  purchaseOrderLine: Pick<PrintPurchaseOrder_purchaseOrder_lines, "costPriceExcludeVat" | "attributeData">
) => {
  let unitCostPriceExcludeVat: number;
  const costPriceExcludeVat = purchaseOrderLine.costPriceExcludeVat;
  const simpleAttribute = utils.jsonParseWrapper(purchaseOrderLine.attributeData);
  if (utils.isEmpty(simpleAttribute) === false) {
    const qtyPerBox = simpleAttribute?.quantity;
    if (qtyPerBox) {
      unitCostPriceExcludeVat = utils.convertToNumber(costPriceExcludeVat / qtyPerBox, 1);
    }
  }
  return unitCostPriceExcludeVat;
};

const getTotalCostPriceExcludeVat = (purchaseOrderLine: PrintPurchaseOrder_purchaseOrder_lines) => {
  const { quantity, costPriceExcludeVat, isTaxFree } = purchaseOrderLine;
  return calcTotalExcludeVatByUnitExcludeVatAndQty(costPriceExcludeVat, quantity, isTaxFree);
};

const getTotalExcludeVat = (purchaseOrderLine: PrintPurchaseOrder_purchaseOrder_lines, isB2b: boolean) => {
  const totalCostPriceExcludeVat = getTotalCostPriceExcludeVat(purchaseOrderLine);
  const { devCostExcludeVat, etcExcludeVat, b2bDeliveryFeeExcludeVat } = purchaseOrderLine;
  const totalExcludeVat = totalCostPriceExcludeVat + devCostExcludeVat + etcExcludeVat;

  if (isB2b) {
    return totalExcludeVat + b2bDeliveryFeeExcludeVat;
  }
  return totalExcludeVat;
};

interface FlattenPoLines extends PrintPurchaseOrder_purchaseOrder_lines {
  fulfillment?: PrintPurchaseOrder_purchaseOrder_lines_orderLine_fulfillmentLines_fulfillment;
}

// 발주서 - 발주 품목 테이블 로우 생성
const makePoLineMap = (
  purchaseOrder: PrintPurchaseOrder_purchaseOrder,
  purchaseOrderLine: FlattenPoLines,
  customRowNumber: number = 1
) => {
  const eventType = purchaseOrder.eventType;
  const {
    isConsignmentPurchaseOrder,
    isConsignmentTakeBackPurchaseOrder,
    isTrackInventoryPurchaseOrder,
    isTakeBackPurchaseOrder,
  } = getCheckPurchaseOrderEventTypeResults(eventType);
  let isInventoryType = isTrackInventoryPurchaseOrder || isTakeBackPurchaseOrder;
  isInventoryType = purchaseOrder.isForPackageOrder ? false : isInventoryType;

  const purchaseOrderLineCode = makePurchaseOrderLineNumberWithPoAndLine(purchaseOrder, purchaseOrderLine);
  const specText = makeProductSpecFromPoLine(purchaseOrderLine);
  const productSpecText = utils.isEmpty(purchaseOrderLine?.variantName)
    ? specText
    : `${purchaseOrderLine.variantName}; ${specText}`;
  const orderLine = purchaseOrderLine?.orderLine;
  const variant = purchaseOrderLine?.variant;
  const orderComposedId = orderLine?.order?.composedIdWithPrefix;
  const orderLineComposedIdWithPrefix = orderLine?.composedIdWithPrefix;
  // 반품 발주서인 경우, 수량은 음수로 표시
  const quantityForPrint = getPoLineQuantity(purchaseOrder, purchaseOrderLine);
  const costPriceExcludeVat = purchaseOrderLine.costPriceExcludeVat;
  const totalCostPriceExcludeVat = getTotalCostPriceExcludeVat(purchaseOrderLine);
  const totalExcludeVat = getTotalExcludeVat(purchaseOrderLine, purchaseOrder.isB2b);
  const vatAmount = purchaseOrderLine.vatAmount;
  const orderShippingAddress = orderLine?.order?.shippingAddress;

  const unitCostPriceExcludeVat = calcPoLineUnitCostPriceExcludeVat(purchaseOrderLine);
  const row = {
    [keyNamesToReplace.numIdx]: purchaseOrderLine.sortOrder,
    [keyNamesToReplace.eventType]: getPurchaseOrderEventTypeText(purchaseOrder.eventType, purchaseOrder.isB2b),
    [keyNamesToReplace.askingPurchaseDate]: purchaseOrderLine.askingPurchaseDate || defaultStrValue,
    [keyNamesToReplace.externalSku]: purchaseOrderLine.externalSku || defaultStrValue,
    [keyNamesToReplace.productSku]: purchaseOrderLine.productSku || defaultStrValue,
    [keyNamesToReplace.productName]: purchaseOrderLine.productName || defaultStrValue,
    [keyNamesToReplace.variantName]: purchaseOrderLine.variantName || defaultStrValue,
    [keyNamesToReplace.productSpec]: productSpecText || defaultStrValue,
    [keyNamesToReplace.qtyInBox]: makeProductQtyPerBoxFromPoLine(purchaseOrderLine, variant?.qtyPerBoxUnitType),
    [keyNamesToReplace.isTaxFree]: transformTaxFree(purchaseOrderLine.isTaxFree),
    [keyNamesToReplace.quantity]: `${quantityForPrint}`,
    [keyNamesToReplace.salesUnitType]: getSalesUnitTypeText(variant?.salesUnitType) || defaultStrValue,
    [keyNamesToReplace.unitCostPriceExcludeVat]: unitCostPriceExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.qtyPerBoxUnitType]: getQtyPerBoxUnitTypeText(variant?.qtyPerBoxUnitType) || defaultStrValue,
    [keyNamesToReplace.costPriceExcludeVat]: costPriceExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.totalExcludeVatByLine]: totalExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.totalCostPriceExcludeVat]: totalCostPriceExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.devCostExcludeVat]: purchaseOrderLine.devCostExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.etcExcludeVat]: purchaseOrderLine.etcExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.b2bDeliveryFeeExcludeVat]:
      purchaseOrderLine.b2bDeliveryFeeExcludeVat?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.vatAmount]: vatAmount?.toLocaleString() || defaultNumValue,
    [keyNamesToReplace.lineNote]: purchaseOrderLine.note || defaultStrValue,
    // TODO: 여기에 발주 품목별 데이터 추가 (각 라인마다 반복되는 데이터)
    // 예: [keyNamesToReplace.newField]: purchaseOrderLine.newField || defaultStrValue,
  };

  if (isInventoryType) {
    row[keyNamesToReplace.code] = purchaseOrder.code || defaultStrValue;
    row[keyNamesToReplace.purchaseOrderDate] = purchaseOrder.purchaseOrderDate || defaultStrValue;
    row[keyNamesToReplace.deliveryWarehouseAddress] = transformAddress(purchaseOrder);
    row[keyNamesToReplace.deliveryWarehouseManager] = purchaseOrder.deliveryWarehouseManager || defaultStrValue;
    row[keyNamesToReplace.deliveryWarehousePhone] = transformPhoneNumber(purchaseOrder.phone);
    row[keyNamesToReplace.note] = purchaseOrder.note || defaultStrValue;
  } else {
    const fulfillment = purchaseOrderLine?.fulfillment;
    const etcDeliveryManInfo = fulfillment?.etcDeliveryManInfo;
    row[keyNamesToReplace.fulfillmentId] = fulfillment?.id || defaultStrValue;
    row[keyNamesToReplace.poLineCode] = purchaseOrderLineCode || defaultStrValue;
    row[keyNamesToReplace.orderNumber] = orderComposedId || defaultStrValue;
    row[keyNamesToReplace.orderDetailNumber] = orderLineComposedIdWithPrefix || defaultStrValue;
    row[keyNamesToReplace.orderAddressFirstName] = orderLine?.order.shippingAddress.firstName || defaultStrValue;
    row[keyNamesToReplace.orderPhone] = transformPhoneNumber(orderShippingAddress?.phone) || defaultStrValue;
    row[keyNamesToReplace.orderAddress] = transformAddress(orderShippingAddress, false);
    row[keyNamesToReplace.orderCustomerNote] = orderLine.order?.customerNote || defaultStrValue;
    row[keyNamesToReplace.fulfillmentCourierName] = fulfillment?.courier?.name || defaultStrValue;
    row[keyNamesToReplace.fulfillmentTrackingNumber] = fulfillment?.trackingNumber || defaultStrValue;
    row[keyNamesToReplace.fulfillmentEtcDeliveryVehicle] = etcDeliveryManInfo?.vehicle || defaultStrValue;
    row[keyNamesToReplace.fulfillmentEtcDeliveryManContact] = etcDeliveryManInfo?.contact || defaultStrValue;
  }
  // 패키지 구성품의 경우.
  if (purchaseOrder.isForPackageOrder) {
    row[keyNamesToReplace.orderAddressFirstName] =
      purchaseOrder.deliveryWarehouseManager || row[keyNamesToReplace.orderAddressFirstName];
    row[keyNamesToReplace.orderPhone] = transformPhoneNumber(purchaseOrder.phone) || row[keyNamesToReplace.orderPhone];
    row[keyNamesToReplace.orderAddress] = transformAddress(purchaseOrder);
  }

  if (isConsignmentPurchaseOrder || isConsignmentTakeBackPurchaseOrder) {
    return {
      ...row,
      [keyNamesToReplace.numIdx]: customRowNumber,
      [keyNamesToReplace.poLineCode]: `${purchaseOrderLineCode}-${utils.fillZero(customRowNumber, 3)}`,
    };
  }
  return row;
};

export const onPurchaseOrderDownloadOrSend = async ({
  resPurchaseOrder,
  isSendingMode,
  onSend,
  user,
}: {
  resPurchaseOrder: ApolloQueryResult<PrintPurchaseOrder>;
  isSendingMode: boolean;
  // isSendingMode가 true인 경우, 처리 함수
  onSend?: (file: File) => void;
  user: User;
}) => {
  const purchaseOrder = resPurchaseOrder?.data?.purchaseOrder;
  const poLines = purchaseOrder?.lines || [];

  if (poLines.length <= 0) {
    showNotificationWarn("출력할 발주 품목이 없는 발주서입니다.");
    return;
  }

  const {
    isTrackInventoryPurchaseOrder,
    isTakeBackPurchaseOrder,
    isConsignmentPurchaseOrder,
    isConsignmentTakeBackPurchaseOrder,
  } = getCheckPurchaseOrderEventTypeResults(purchaseOrder.eventType);
  let isTrackInventory = isTrackInventoryPurchaseOrder || isTakeBackPurchaseOrder;
  isTrackInventory = purchaseOrder?.isForPackageOrder ? false : isTrackInventory;

  const poLinesByCourier = poLines.filter(
    (line) => line.orderLine?.order.deliveryMethod === OrderDeliveryMethodsEnum.BY_COURIER
  );
  const poLinesByNonCourier = poLines.filter(
    (line) => line.orderLine?.order.deliveryMethod !== OrderDeliveryMethodsEnum.BY_COURIER
  );
  const byCourierExist = poLinesByCourier.length > 0;
  const byNonCourierExist = poLinesByNonCourier.length > 0;
  if (byCourierExist && byNonCourierExist) {
    showNotificationWarn("발주 품목 중 택배 배송과 택배가 아닌 배송이 혼합되어 있어서 출력할 수 없습니다.");
    return;
  }

  const sheetName = isTrackInventory ? 0 : byCourierExist ? 1 : 2;
  const isNonCourierDelivery = sheetName === 2; // 2번 sheet 사용 여부

  // 실제 발주수량에서 위탁 발주인 경우, 발주수량은 1로 처리
  const flattenPoLines = poLines.reduce<FlattenPoLines[]>((acc, line) => {
    const { quantity } = line;
    const { isB2b } = purchaseOrder;
    // 위탁 발주서이면서 b2b가 아니고, 택배 배송인 경우만 발주 품목을 나누어야 함
    const needSplitPoLine =
      (isConsignmentPurchaseOrder || isConsignmentTakeBackPurchaseOrder) && quantity > 1 && !isB2b && byCourierExist;
    if (needSplitPoLine) {
      const unitVatAmount = utils.convertToNumber(line.vatAmount / quantity, 1);
      for (let i = 0; i < quantity; i++) {
        const fulfillment = line.orderLine?.fulfillmentLines?.[i]?.fulfillment;
        const customLine: FlattenPoLines = { ...line, quantity: 1, vatAmount: unitVatAmount, fulfillment };
        acc.push(customLine);
      }
    } else {
      const fulfillment = line.orderLine?.fulfillmentLines?.[0]?.fulfillment;
      const customLine: FlattenPoLines = { ...line, quantity, fulfillment };
      acc.push(customLine);
    }
    return acc;
  }, []);

  const templateVersion = "20251218-00";
  const templateFileUrl = `${s3TemplateUrl}/purchase_order_${templateVersion}.xlsx`;
  // s3에 업로드 되어 있는 발주서 양식 파일 가져오기
  const fetchRes = await fetch(templateFileUrl);
  const blob = await fetchRes.blob();
  const reader = new FileReader();
  // 가져온 파일 양식을 그대로 출력하는 것이 아니라, 값 대체 + 스타일 별도 적용(스타일 정보까지 못 가져오기 때문)하여 다운로드 처리
  reader.onload = () => {
    const data = reader.result;
    const originWorkbook = xlsx.read(data, { type: "array", cellStyles: true });
    const originWorksheet = originWorkbook.Sheets[sheetName];
    const csvStr = xlsx.utils.sheet_to_csv(originWorksheet);
    // row의 첫 번째 셀에 빈 문자열은 s3에 업로드 되어 있는 발주서 양식이 좌측에 한 칸 비어있기 때문에 추가
    const poDataArr = csvStr.split("\n").map((row) => [...row.split(",")]);

    let customRowNumber = 1;
    const poLineMaps: Array<{ [key: string]: any }> = [];
    flattenPoLines.forEach((line) => {
      const poLineMap = makePoLineMap(purchaseOrder, line, customRowNumber);
      poLineMaps.push(poLineMap);
      customRowNumber++;
    });

    const totalPoLineRowCnt = poLineMaps.length;

    const {
      expandedDataArr: expandedPoDataArr,
      expandedMerges,
      expandedRowsInfo,
    } = expandTemplateDataArrByLines({ originWorksheet, dataArr: poDataArr, lineCount: totalPoLineRowCnt });
    let dataMap = {};
    const poVendor = purchaseOrder.vendor;
    const managers = makeVendorManagerInfo(poVendor.managers);
    if (isNonCourierDelivery) {
      dataMap = {
        purchaseOrderCode: purchaseOrder.code,
        purchaseDate: getDateByFormat(purchaseOrder.created, onlyDateFormat),
        supplierCompanyName: poVendor.name,
        supplierCeo: poVendor.ceo || defaultStrValue,
        supplierBizRegNo: poVendor.bizRegNo || defaultStrValue,
        supplierCompanyAddress: poVendor.address || defaultStrValue,
        supplierManagerName: managers.length > 0 ? managers[0].name : defaultStrValue,
        supplierManagerPhone: managers.length > 0 ? transformPhoneNumber(managers[0].phone) : defaultStrValue,
        supplierManagerEmail: managers.length > 0 ? managers[0].email : defaultStrValue,
        receiverManagerName: user.firstName,
        receiverManagerEmail: user.email,
      };
    }
    const replacedDataArr = replaceTemplateDataArrByMap({
      dataArr: expandedPoDataArr,
      dataMap,
      lineMaps: poLineMaps,
    });

    // 생성할 워크북 및 워크시트 생성
    const newWorkbook = xlsx.utils.book_new();
    const newWorksheet = xlsx.utils.aoa_to_sheet(replacedDataArr, {});

    // 기존 양식의 컬럼, 로우 정보 및 발주 품목 수에 따라 추가된 머지 정보 적용
    newWorksheet["!cols"] = originWorksheet["!cols"];
    newWorksheet["!rows"] = expandedRowsInfo;
    newWorksheet["!merges"] = expandedMerges;

    // NOTE: 스타일 적용
    // 1. 각 스타일을 적용할 셀 or 로우를 저장
    // 2. 1번에서 구한 조건에 해당하는 셀에 스타일 적용. 양식이 변경될 경우 체크하여 수정 필요(거의 하드코딩에 가까움)

    // 볼드, 색상(옅은 회색) 처리할 로우 번호
    const rowsToBold = [1];
    const rowsToFillGrey = [1];

    // 테두리(일반) 스타일 적용할 셀 이름
    const cellsToBorder = [];
    if (isTrackInventory) {
      // 발주 품목 셀
      cellsToBorder.push(...getCellRangeArr("A1", `AA${totalPoLineRowCnt + 1}`));
    } else if (isNonCourierDelivery === false) {
      // 발주 품목 셀
      cellsToBorder.push(...getCellRangeArr("A1", `AE${totalPoLineRowCnt + 1}`));
    } else if (isNonCourierDelivery) {
      // isNonCourierDelivery인 경우 border 적용할 셀들
      cellsToBorder.push(...getCellRangeArr("AA2", "AA3"));
      cellsToBorder.push(...getCellRangeArr("AB2", "AB3"));
      cellsToBorder.push(...getCellRangeArr("AC2", "AC3"));
      cellsToBorder.push(...getCellRangeArr("B5", "AC10"));

      // 11행부터 totalPoLineRowCnt + 11행까지 B~AC 열 (header row 포함)
      for (let row = 11; row <= totalPoLineRowCnt + 11; row++) {
        cellsToBorder.push(...getCellRangeArr(`B${row}`, `AC${row}`));
      }
    }

    for (const cell in newWorksheet) {
      if (typeof newWorksheet[cell] != "object") {
        continue;
      }

      const currentCell = newWorksheet[cell];
      const matchedNumberArr = cell.match(/\d+/);
      const rowNumber = !utils.isEmpty(matchedNumberArr) && parseInt(matchedNumberArr[0], 10);
      applyNumberCellFormat(currentCell);

      // wrapText 설정: 1번 sheet(택배)는 false, 나머지는 true
      const wrapText = sheetName === 1 ? false : true;
      const commonCellStyle = {
        ...defaultExcelCellStyle,
        alignment: { ...defaultExcelCellStyle.alignment, wrapText },
        border: {},
        // b2b 발주서인 경우 기본 폰트 사이즈를 20으로 설정
        ...(isNonCourierDelivery && { font: { ...defaultExcelCellStyle.font, sz: 20 } }),
      };
      let cellStyle: { [key: string]: any } = { ...commonCellStyle };
      if (isNonCourierDelivery) {
        // N2 셀인 경우 font-size: 50, bold 처리
        if (cell === "J2") {
          cellStyle = applyXlsxCellStyle({ fontSize: 50, bold: true }, cellStyle);
        }

        // bold 처리할 셀들
        const boldCells = [
          "AA2",
          "AB2",
          "AC2",
          "H6",
          "V6",
          ...getCellRangeArr("B5", "B6"),
          ...getCellRangeArr("D5", "D9"),
          ...getCellRangeArr("J5", "J8"),
          ...getCellRangeArr("P5", "P6"),
          ...getCellRangeArr("R5", "R9"),
          ...getCellRangeArr("X6", "X9"),
        ];

        // B11~AC11 범위 추가
        const row11Cells = getCellRangeArr("B11", "AC11");
        boldCells.push(...row11Cells);

        if (boldCells.includes(cell)) {
          cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
        }

        // fillColor #e8e8e8 처리할 셀들
        const fillGreyCells = ["B5", "B6", "P5", "P6"];
        fillGreyCells.push(...row11Cells); // B11~AC11도 추가

        if (fillGreyCells.includes(cell)) {
          cellStyle = applyXlsxCellStyle({ fillColor: "E8E8E8" }, cellStyle);
        }

        // 먼저 cellsToBorder에 포함된 모든 셀에 일반 border 적용
        if (cellsToBorder.includes(cell)) {
          cellStyle = applyXlsxCellStyle({ border: { directions: ["top", "bottom", "left", "right"] } }, cellStyle);
        }

        // 그 다음 두꺼운 테두리 처리 (덮어씌우기)
        // B5~AC5 (1줄)
        if (cell.match(/^([B-Z]|A[A-C])5$/)) {
          const borders = [];
          if (cell === "B5") {
            borders.push("left", "top", "bottom");
          } else if (cell === "AC5") {
            borders.push("right", "top", "bottom");
          } else {
            borders.push("top", "bottom");
          }
          if (borders.length > 0) {
            cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: borders } }, cellStyle);
          }
        }

        // B6~AC9 사각형 영역
        if (cell.match(/^([B-Z]|A[A-C])[6-9]$/)) {
          const match = cell.match(/^([A-Z]+)(\d+)$/);
          if (match) {
            const colLetter = match[1];
            const rowNum = parseInt(match[2], 10);
            const borders = [];
            if (colLetter === "B" && rowNum >= 6 && rowNum <= 9) {
              borders.push("left");
            }
            if (colLetter === "AC" && rowNum >= 6 && rowNum <= 9) {
              borders.push("right");
            }
            if (rowNum === 6) {
              borders.push("top");
            }
            if (rowNum === 9) {
              borders.push("bottom");
            }
            if (borders.length > 0) {
              cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: borders } }, cellStyle);
            }
          }
        }

        // B10~AC10 (1줄)
        if (cell.match(/^([B-Z]|A[A-C])10$/)) {
          const borders = [];
          if (cell === "B10") {
            borders.push("left", "top", "bottom");
          } else if (cell === "AC10") {
            borders.push("right", "top", "bottom");
          } else {
            borders.push("top", "bottom");
          }
          if (borders.length > 0) {
            cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: borders } }, cellStyle);
          }
        }

        // B11~AC{11+totalPoLineRowCnt} 사각형 영역 (header row 포함)
        const lastRow = 11 + totalPoLineRowCnt;
        if (cell.match(/^([B-Z]|A[A-C])\d+$/)) {
          const match = cell.match(/^([A-Z]+)(\d+)$/);
          if (match) {
            const colLetters = match[1];
            const rowNum = parseInt(match[2], 10);

            if (rowNum >= 11 && rowNum <= lastRow) {
              const borders = [];
              // 왼쪽 테두리 (B열)
              if (colLetters === "B") {
                borders.push("left");
              }
              // 오른쪽 테두리 (AC열)
              if (colLetters === "AC") {
                borders.push("right");
              }
              // 상단 테두리 (11행)
              if (rowNum === 11) {
                borders.push("top");
              }
              // 하단 테두리 (마지막 행)
              if (rowNum === lastRow) {
                borders.push("bottom");
              }

              if (borders.length > 0) {
                cellStyle = applyXlsxCellStyle({ border: { strong: true, directions: borders } }, cellStyle);
              }
            }
          }
        }
      } else {
        if (rowsToBold.includes(rowNumber)) {
          cellStyle = applyXlsxCellStyle({ bold: true }, cellStyle);
        }
        if (rowsToFillGrey.includes(rowNumber)) {
          cellStyle = applyXlsxCellStyle({ fillColor: "ECECEC" }, cellStyle);
        }
        if (cellsToBorder.includes(cell)) {
          cellStyle = applyXlsxCellStyle({ border: { directions: ["top", "bottom", "left", "right"] } }, cellStyle);
        }
      }
      currentCell.s = cellStyle;
    }

    xlsx.utils.book_append_sheet(newWorkbook, newWorksheet);
    if (!isSendingMode) {
      const xlsxFileName = `${purchaseOrder.code}-${moment().format(fileNameDateFormat)}.xlsx`;
      excelDownloadByWorkBook({ workBook: newWorkbook, title: xlsxFileName });
    } else {
      const xlsxFileName = `주식회사_리우_부자재_발주서_${moment().format(fileNameDateFormat)}.xlsx`;
      const xlsxFile = convertWorkBookToXlsxFile({ title: xlsxFileName, workBook: newWorkbook });
      onSend(xlsxFile);
    }
  };
  reader.readAsArrayBuffer(blob);
  return;
};
