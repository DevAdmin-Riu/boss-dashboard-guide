              </Typography.Text>
            </Space>
          </Checkbox>
        </Form.Item>
        <Divider />
        <Form.Item label="지역 검색" name="query">
          <Input placeholder="지역 이름으로 검색" />
        </Form.Item>
        <Form.Item label="지역 리스트" name="countries">
          <Checkbox.Group>
            {filter(countries, queryWatched, {
              key: "country",
            }).map((country) => (
              <Checkbox key={country.code} value={country.code}>
                {country.country}
              </Checkbox>
            ))}
          </Checkbox.Group>
        </Form.Item>
      </Form>
    </Modal>
  );
};
export default ShippingZoneCountriesAssignDialog;
