import { ApolloQueryResult } from "@apollo/client";
import useNavigator from "@hooks/useNavigator";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { OrderType, SalesB2bStatusEnum, SalesB2bUpdateInput } from "@src/api/types/globalTypes";
import { EditableCell } from "@src/app/components/antd/Table/editableCell";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import ConfirmModal from "@src/app/components/ConfirmModal";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import {
  useSalesB2bBulkBeforeSendMutation,
  useSalesB2bUpdateMutation,
} from "@src/app/views/hqStaff/hqB2b/api/mutations";
import { salesListForB2bQuery } from "@src/app/views/hqStaff/hqB2b/api/queries";
import {
  SalesListForB2b,
  SalesListForB2b_sales_edges_node,
  SalesListForB2bVariables,
} from "@src/app/views/hqStaff/hqB2b/api/types/SalesListForB2b";
import { getB2bSettlementListTableSettings } from "@src/app/views/hqStaff/hqB2b/components/HqB2bSettlementListPage/HqB2bSettlementListTableSettings";
import { makeConfirmNodeForSalesTotal } from "@src/app/views/hqStaff/hqB2b/components/HqB2bSettlementModals/HqB2bSettlementBulkCloseModal";
import { getNumberFormat } from "@src/app/views/product/products/utils/data";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { toPriceExcludeVat, toPriceIncludeVat } from "@utils/excel/excelDownload";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, DatePicker, Form, Row, Space, Table } from "antd";
import { TableRowSelection } from "antd/lib/table/interface";
import { Moment } from "moment";
import moment from "moment";
import React, { useEffect, useState } from "react";
import { useParams } from "react-router";

import { b2bSalesCountQuery } from "../../api/queries";
import {
  B2bSettlementForSalesViewUrlDialog,
  B2bSettlementForSalesViewUrlQueryParams,
  B2bSettlementListViewRouteParams,
} from "../../urls";
import { B2bSettlementFilterKeys, B2bSettlementListFilterOpts, createFilterStructure } from "./filters";

const { MonthPicker } = DatePicker;

interface B2bSettlementListPageProps
  extends PaginateListProps,
    FilterPageProps<B2bSettlementFilterKeys, B2bSettlementListFilterOpts> {
  params: B2bSettlementForSalesViewUrlQueryParams;
  salesList: SalesListForB2b_sales_edges_node[];
  openModal: (action: B2bSettlementForSalesViewUrlDialog, newParams?: B2bSettlementForSalesViewUrlQueryParams) => void;
  closeModal: () => void;

  queryVariablesWithoutPagination: SalesListForB2bVariables;
  fetchForDownload: (variables?: SalesListForB2bVariables) => Promise<ApolloQueryResult<SalesListForB2b>>;
  selectedRowIds: string[];
  setSelectedRowIds: React.Dispatch<React.SetStateAction<string[]>>;
  ListNavigator: () => React.ReactNode;
}

export interface SalesB2bUpdateForm extends SalesB2bUpdateInput {
  unitPriceExcludeVat: number;
  unpaidAmount?: number;
}

export const B2bSettlementListPage: React.FC<B2bSettlementListPageProps> = (props) => {
  const {
    params,
    currentTab,
    filterOpts,
    tabs,
    salesList,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    openModal,
    closeModal,
    queryVariablesWithoutPagination,
    fetchForDownload,
    selectedRowIds,
    setSelectedRowIds,
    ListNavigator,
    ...listProps
  } = props;
  const routeParams = useParams<B2bSettlementListViewRouteParams>();
  const navigate = useNavigator();
  const filterStructure = createFilterStructure(filterOpts, routeParams);
  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const [form] = Form.useForm<SalesB2bUpdateForm>();
  const [selectedRowId, setSelectedRowId] = useState<string>("");

  const salesB2bCloseDateWatched: Moment = Form.useWatch("salesB2bCloseDate", form) || null;

  const resetFormField = () => {
    form.resetFields();
    setSelectedRowId(undefined);
    setSelectedRowIds([]);
  };

  useEffect(() => {
    resetFormField();
  }, [listProps.disabled]);

  const unitPriceExcludeVatWatched = Form.useWatch("unitPriceExcludeVat", form);
  const quantityWatched = Form.useWatch("quantity", form);
  const b2bDeliveryFeeExcludeVatWatched = Form.useWatch("b2bDeliveryFeeExcludeVat", form);
  const formValuesWatched: SalesB2bUpdateForm = {
    unitPriceExcludeVat: unitPriceExcludeVatWatched,
    quantity: quantityWatched,
    b2bDeliveryFeeExcludeVat: b2bDeliveryFeeExcludeVatWatched,
  };

  const setEditableRow = (record: SalesListForB2b_sales_edges_node) => {
    form.setFields([
      {
        name: "unitPriceExcludeVat",
        value: toPriceExcludeVat(record.unitPrice, record.isTaxFree, record.variant.priceDecimalPlaces),
      },
      { name: "quantity", value: Math.abs(record.quantity) },
      { name: "b2bDeliveryFeeExcludeVat", value: record.b2bDeliveryFeeExcludeVat },
    ]);
    setSelectedRowId(record.id);
  };

  const isEditing = (record: SalesListForB2b_sales_edges_node) => record.id === selectedRowId;
  const onEdit = (record: SalesListForB2b_sales_edges_node) => setEditableRow(record);

  const onCancel = () => resetFormField();

  const onSubmit = async (record: SalesListForB2b_sales_edges_node) => {
    const inputForm = form.getFieldsValue();
    const { unitPriceExcludeVat, b2bDeliveryFeeExcludeVat, quantity } = inputForm;
    const isB2bTakeBackType = record.order.type === OrderType.BY_STAFF_FOR_B2B_TAKE_BACK;
    const isTaxFree = record.isTaxFree;
    const input: SalesB2bUpdateInput = {
      unitPrice: toPriceIncludeVat(unitPriceExcludeVat, isTaxFree, record.variant.priceDecimalPlaces),
      b2bDeliveryFeeExcludeVat: isB2bTakeBackType ? undefined : b2bDeliveryFeeExcludeVat,
      quantity: "" + (isB2bTakeBackType ? quantity * -1 : quantity),
    };
    salesB2bUpdate({ variables: { id: selectedRowId, input } });
  };

  const rowSelection: TableRowSelection<SalesListForB2b_sales_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedRowIds,
    onChange: (selectedRowKeys) => {
      setSelectedRowIds(selectedRowKeys as string[]);
    },
    getCheckboxProps: (record: SalesListForB2b_sales_edges_node) => ({
      disabled: record.b2bStatus === SalesB2bStatusEnum.REQ_REVISION,
    }),
  };

  const [salesB2bBulkPending, salesB2bBulkPendingOpts] = useSalesB2bBulkBeforeSendMutation({
    onCompleted: (data) => {
      const errors = data.salesB2bBulkBeforeSend.errors;
      if (errors.length === 0) {
        const count = data.salesB2bBulkBeforeSend.count;
        const successMsg = `선택한 ${getNumberFormat(count)}건의 매출 내역이 발송 대기 처리 되었습니다.`;
        showNotificationSuccess(successMsg);
        resetFormField();
        closeModal();
      } else {
        showGqlErrors(errors);
      }
    },
    refetchQueries: [salesListForB2bQuery, b2bSalesCountQuery],
  });

  const [salesB2bUpdate, salesB2bUpdateOpts] = useSalesB2bUpdateMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.salesB2bUpdate.errors;
        if (errors.length === 0) {
          showNotificationSuccess("매출 수정처리되었습니다.");
          resetFormField();
        } else {
          showGqlErrors(errors);
        }
      }
    },
  });

  let extraUi: React.ReactNode = null;
  let showRowSelection: boolean = true;

  const bulkBtnDisabled = selectedRowIds.length === 0 || listProps.disabled;
  switch (routeParams.status) {
    case "in-progress":
    case "edit-request":
      extraUi = (
        <Space>
          <Form.Item name="salesB2bCloseDate" noStyle>
            <MonthPicker style={{ width: 150 }} allowClear={false} placeholder="정산월 선택" />
          </Form.Item>
          <Button
            type="primary"
            shape="round"
            disabled={bulkBtnDisabled || salesB2bBulkPendingOpts.loading || utils.isEmpty(salesB2bCloseDateWatched)}
            onClick={() => openModal("bulk-pending-sales", { ids: selectedRowIds })}
          >
            발송 대기
          </Button>
        </Space>
      );
      break;
    case "closed":
      showRowSelection = false;
      break;
    case "all":
      showRowSelection = false;
      break;
  }

  const makeConfirmContentNodeForSalesBulkPending = () => {
    if (!salesList || selectedRowIds.length <= 0) {
      return null;
    }
    const selectedPurchaseList = salesList.filter((sales) => selectedRowIds.includes(sales.id));

    const contentNode = <>{makeConfirmNodeForSalesTotal(salesB2bCloseDateWatched, selectedPurchaseList)}</>;

    return contentNode;
  };

  const mutationsLoadingBeforeClosed = salesB2bUpdateOpts.loading;

  const salesTableColumns = getB2bSettlementListTableSettings({
    formValuesWatched,
    navigate,
    routeParams,
    editingProps: {
      loading: mutationsLoadingBeforeClosed,
      selectedSalesId: selectedRowId,
      isEditing,
      onEdit,
      onCancel,
      onSubmit,
      openModal,
    },
  });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    salesTableColumns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const purchaseTableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "sales",
  };

  return (
    <Form form={form} component={false}>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>{ListNavigator()}</Col>
          <Col>{extraUi}</Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <TableVatLegend isIncludeVat={false} />
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={salesList}
            rowSelection={showRowSelection && rowSelection}
            scroll={{ x: purchaseTableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
            components={{ body: { cell: EditableCell } }}
          />
        </Card>
      </Space>

      <ConfirmModal
        titleText="선택한 매출 내역 발송 대기를 진행하시겠습니까?"
        helpText="아래 매출 정보를 다시 한번 확인하시고 맞으면 발송 대기 버튼을 눌러주세요."
        visible={params.action === "bulk-pending-sales"}
        contentNode={makeConfirmContentNodeForSalesBulkPending()}
        okButtonProps={{
          loading: salesB2bBulkPendingOpts.loading,
        }}
        okText={"발송 대기"}
        onOk={() => {
          if (utils.isEmpty(salesB2bCloseDateWatched)) {
            showNotificationError("매출 마감월을 선택해주세요.");
            return;
          }
          const formattedsalesB2bCloseDate = moment(salesB2bCloseDateWatched).endOf("month").format(onlyDateFormat);
          salesB2bBulkPending({ variables: { ids: selectedRowIds, salesCloseDate: formattedsalesB2bCloseDate } });
        }}
        onCancel={closeModal}
      />
    </Form>
  );
};
</file>

<file path="src/app/views/b2b/components/B2bSettlementListPage/filters.ts">
import { OrderTypeEnum, SalesB2bStatusEnum } from "@src/api/types/globalTypes";
import { filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createDateField, createMonthField, createOptionsField, createTextField } from "@utils/filters/fields";

import { B2bSettlementListViewRouteParams } from "../../urls";
import { getDefaultSalesB2bStatusListForB2bSettlementList, SalesB2bStatusChoices } from "../../utils";

export enum B2bSettlementFilterKeys {
  b2bOrderSearch = "b2bOrderSearch", // b2b 주문번호/주문상세번호
  productSearch = "productSearch", // 제품코드/제품명
  brandProductSearch = "brandProductSearch", // 상품코드/상품명
  brandSearch = "brandSearch", // 고객사코드/고객사명
  salesCloseDate = "salesCloseDate", // 정산월
  b2bOrderCreatedAt = "b2bOrderCreatedAt", // b2b 주문일
  b2bInvoicePrintedAt = "b2bInvoicePrintedAt", // b2b 납품일
  b2bStatus = "b2bStatus", // 검토상태
  orderType = "orderType", // 주문 구분 (B2B 주문, B2B 반품) orderType
}

export interface B2bSettlementListFilterOpts {
  b2bOrderSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  brandProductSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  salesCloseDate: FilterOpts<MinMax>;
  b2bOrderCreatedAt: FilterOpts<MinMax>;
  b2bInvoicePrintedAt: FilterOpts<MinMax>;
  b2bStatus: FilterOpts<SalesB2bStatusEnum[]>;
  orderType: FilterOpts<OrderTypeEnum[]>;
}

export function createFilterStructure(
  opts: B2bSettlementListFilterOpts,
  routeParams: B2bSettlementListViewRouteParams
): IFilter<B2bSettlementFilterKeys> {
  let displayOrder = 0;
  const availableFilterStatus = getDefaultSalesB2bStatusListForB2bSettlementList(routeParams);
  const filteredStatusOptions = SalesB2bStatusChoices.filter((status) => availableFilterStatus.includes(status.value));
  const showStatusFilter = filteredStatusOptions.length > 1;
  const isInProgress = routeParams.status === "in-progress";

  const b2bOrderSearchFilter = {
    ...createTextField(
      displayOrder++,
      B2bSettlementFilterKeys.b2bOrderSearch,
      filterNameConstant.ORDER_SEARCH,
      opts.b2bOrderSearch.value
    ),
    active: opts.b2bOrderSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      displayOrder++,
      B2bSettlementFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const brandProductSearchFilter = {
    ...createTextField(
      displayOrder++,
      B2bSettlementFilterKeys.brandProductSearch,
      filterNameConstant.BRAND_PRODUCT_SEARCH,
      opts.brandProductSearch.value
    ),
    active: opts.brandProductSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(
      displayOrder++,
      B2bSettlementFilterKeys.brandSearch,
      filterNameConstant.BRAND_SEARCH_FOR_B2B,
      opts.brandSearch.value
    ),
    active: opts.brandSearch.active,
  };
  const salesCloseDateFilter = {
    ...createMonthField(displayOrder++, B2bSettlementFilterKeys.salesCloseDate, "정산월", opts.salesCloseDate.value),
    active: opts.salesCloseDate.active,
  };
  const b2bOrderCreatedAtFilter = {
    ...createDateField(
      displayOrder++,
      B2bSettlementFilterKeys.b2bOrderCreatedAt,
      "주문일",
      opts.b2bOrderCreatedAt.value
    ),
    active: opts.b2bOrderCreatedAt.active,
  };
  const b2bInvoicePrintedAtFilter = {
    ...createDateField(
      displayOrder++,
      B2bSettlementFilterKeys.b2bInvoicePrintedAt,
      "납품일",
      opts.b2bInvoicePrintedAt.value
    ),
    active: opts.b2bInvoicePrintedAt.active,
  };

  const statusFilter = {
    ...createOptionsField(
      displayOrder++,
      B2bSettlementFilterKeys.b2bStatus,
      "검토상태",
      opts.b2bStatus.value,
      true,
      filteredStatusOptions
    ),
    active: opts.b2bStatus.active,
    isRequired: true,
  };

  const typeFilter = {
    ...createOptionsField(displayOrder++, B2bSettlementFilterKeys.orderType, "주문 구분", opts.orderType.value, true, [
      {
        label: "B2B 주문",
        value: OrderTypeEnum.BY_STAFF_FOR_B2B,
      },
      {
        label: "B2B 반품",
        value: OrderTypeEnum.BY_STAFF_FOR_B2B_TAKE_BACK,
      },
    ]),
    active: opts.orderType.active,
  };

  return [
    showStatusFilter && statusFilter,
    b2bOrderSearchFilter,
    productSearchFilter,
    brandProductSearchFilter,
    brandSearchFilter,
    isInProgress === false && salesCloseDateFilter,
    b2bOrderCreatedAtFilter,
    b2bInvoicePrintedAtFilter,
    typeFilter,
  ].filter(Boolean);
}
</file>

<file path="src/app/views/b2b/components/B2bTaxInvoiceListPage/B2bTaxInvoiceIssuedModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import { TaxInvoiceBulkOfflineIssueInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime, onlyDateFormat } from "@src/app/providers/DateProvider";
import { TaxInvoiceList_taxInvoiceList_edges_node } from "@src/app/views/order/taxInvoice/api/types/TaxInvoiceList";
import { calcVatByPriceIncludeVat, toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { DatePicker, Form, Input, InputNumber, Modal, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import moment from "moment";
import React, { useEffect } from "react";

import { TaxInvoiceIssueMode } from "./B2bTaxInvoiceListPage";

const { Text } = Typography;

interface B2bTaxInvoiceIssueModalProps {
  open: boolean;
  selectedTaxInvoices: TaxInvoiceList_taxInvoiceList_edges_node[];
  issueMode: TaxInvoiceIssueMode | null;
  loading?: boolean;
  onClose: () => void;
  onSubmit: (formData: TaxInvoiceBulkOfflineIssueInput) => Promise<void>;
}

const B2bTaxInvoiceIssuedModal: React.FC<B2bTaxInvoiceIssueModalProps> = (props) => {
  const { open, selectedTaxInvoices, issueMode, loading = false, onClose, onSubmit } = props;
  const [form] = Form.useForm<TaxInvoiceBulkOfflineIssueInput>();
  const TypeSafeForm = getTypeSafeForm<TaxInvoiceBulkOfflineIssueInput>(form);

  useEffect(() => {
    if (open && selectedTaxInvoices && selectedTaxInvoices.length > 0) {
      const formDetails = selectedTaxInvoices.map((invoice) => ({
        id: invoice.id,
        writeDate: invoice.writeDate || moment().format(onlyDateFormat),
        totalAmount: invoice.totalAmount || 0,
      }));
      form.setFieldsValue({ details: formDetails });
    }
  }, [open, selectedTaxInvoices, form]);

  const watchedDetails = Form.useWatch("details", form) || [];

  const columns: ColumnsType<TaxInvoiceList_taxInvoiceList_edges_node> = [
    {
      align: "center",
      title: columnNameConstant.tax.WRITTEN_DATE,
      key: "writeDate",
      width: 120,
      render: (_, record, index) => {
        const isReadOnly = issueMode === TaxInvoiceIssueMode.ELECTRONIC;
        const writeDate = record.writeDate;

        if (isReadOnly) {
          return writeDate ? <DateTime onlyDate date={writeDate} /> : "-";
        }

        return (
          <>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex(`details.${index}.id`)}
              style={{ display: "none" }}
              initialValue={record.id}
              noStyle
            >
              <Input type="hidden" />
            </Form.Item>
            <Form.Item
              name={TypeSafeForm.getValidDataIndex(`details.${index}.writeDate`)}
              rules={[{ required: true, message: formRuleMsg.required }]}
              style={{ margin: 0 }}
              initialValue={writeDate || moment().format(onlyDateFormat)}
              getValueProps={(value) => ({
                value: value ? moment(value) : undefined,
              })}
              getValueFromEvent={(date) => (date ? date.format(onlyDateFormat) : null)}
            >
              <DatePicker format={onlyDateFormat} style={{ width: "100%" }} />
            </Form.Item>
          </>
        );
      },
    },
    {
      title: "공급받는자",
      children: [
        {
          align: "center",
          title: columnNameConstant.user.CORP_NAME,
          key: "invoiceeBizRegCorpName",
          width: 120,
          render: (_, record) => record.invoiceeBizInfo?.bizRegCorpName || "-",
        },
        {
          align: "center",
          title: columnNameConstant.common.BIZ_REG_NO,
          key: "invoiceeBizRegNo",
          width: 120,
          render: (_, record) => record.invoiceeBizInfo?.bizRegNo || "-",
        },
        {
          align: "center",
          title: columnNameConstant.user.CEO_NAME,
          key: "invoiceeBizRegCeoName",
          width: 100,
          render: (_, record) => record.invoiceeBizInfo?.bizRegCeoName || "-",
        },
      ],
    },
    {
      title: "총합",
      key: "totalAmount",
      width: 150,
      align: "right",
      render: (_, record, index) => {
        const isReadOnly = issueMode === TaxInvoiceIssueMode.ELECTRONIC;
        const totalAmount = record.totalAmount;

        if (isReadOnly) {
          return <NumberComponent value={totalAmount} />;
        }

        return (
          <Form.Item
            name={TypeSafeForm.getValidDataIndex(`details.${index}.totalAmount`)}
            rules={[
              { required: true, message: formRuleMsg.required },
              { type: "number", min: 0, message: formRuleMsg.min(0) },
            ]}
            style={{ margin: 0 }}
            initialValue={totalAmount || 0}
          >
            <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} style={{ width: "100%" }} />
          </Form.Item>
        );
      },
    },
    {
      title: "공급가액",
      key: "supplyAmount",
      width: 120,
      align: "right",
      render: (_, record, index) => {
        const totalAmount = watchedDetails[index]?.totalAmount || record.totalAmount || 0;
        return (
          <Text type="secondary">
            <NumberComponent value={toPriceExcludeVat(totalAmount, record.isTaxFree)} />
          </Text>
        );
      },
    },
    {
      title: "부가세",
      key: "vatAmount",
      width: 100,
      align: "right",
      render: (_, record, index) => {
        const totalAmount = watchedDetails[index]?.totalAmount || record.totalAmount || 0;
        return (
          <Text type="secondary">
            <NumberComponent value={calcVatByPriceIncludeVat(totalAmount, record.isTaxFree)} />
          </Text>
        );
      },
    },
  ];

  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const handleSubmit = async () => {
    try {
      // 전자발행은 Form 검증이 필요 없음
      if (issueMode === TaxInvoiceIssueMode.ELECTRONIC) {
        await onSubmit({ details: [] });
        return;
      }

      // 수기발행일 때만 Form 검증
      const values = await form.validateFields();
      const cleanedValues = {
        ...values,
        details: values.details.map((detail: any) => ({
          id: detail.id,
          writeDate: moment.isMoment(detail.writeDate) ? detail.writeDate.format(onlyDateFormat) : detail.writeDate,
          totalAmount: detail.totalAmount,
        })),
      };
      await onSubmit(cleanedValues);
    } catch (error) {
      console.error("Validation failed:", error);
    }
  };

  const handleClose = () => {
    form.resetFields();
    onClose();
  };

  const getModalTitle = () => {
    if (!issueMode) {
      return "";
    }
    return issueMode === TaxInvoiceIssueMode.ELECTRONIC ? "전자 발행" : "수기 발행";
  };

  return (
    <Modal
      title={getModalTitle()}
      open={open}
      onCancel={handleClose}
      onOk={handleSubmit}
      width={800}
      okText={issueMode === TaxInvoiceIssueMode.ELECTRONIC ? "확인" : "발행"}
      cancelText="취소"
      confirmLoading={loading}
      maskClosable={false}
    >
      <Form form={form} layout="vertical" preserve={false}>
        <Space direction="vertical">
          {issueMode === TaxInvoiceIssueMode.ELECTRONIC ? (
            <Text strong>선택한 세금계산서를 발행 요청 하시겠습니까?</Text>
          ) : (
            <>
              <Text strong>선택한 세금계산서를 수기 발행 하시겠습니까?</Text>
              <Text strong>수기 발행 시 작성일 및 공급가액, 세액을 수정할 수 있습니다.</Text>
            </>
          )}
          <Text strong>발행일: </Text>
        </Space>

        <Table {...commonTableProps} scroll={{ x: tableWidthSum }} columns={columns} dataSource={selectedTaxInvoices} />
      </Form>
    </Modal>
  );
};

export default B2bTaxInvoiceIssuedModal;
</file>

<file path="src/app/views/b2b/components/B2bTaxInvoiceListPage/B2bTaxInvoiceListPage.tsx">
import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import {
  TaxInvoiceBulkOfflineIssueDetailInput,
  TaxInvoiceBulkOfflineIssueInput,
  TaxInvoiceStatus,
} from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import TableVatLegend from "@src/app/components/TableVat/TableVatLegend";
import {
  TaxInvoiceList,
  TaxInvoiceList_taxInvoiceList_edges_node,
  TaxInvoiceListVariables,
} from "@src/app/views/order/taxInvoice/api/types/TaxInvoiceList";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { showNotificationSuccess, showNotificationWarn } from "@utils/notification/wrapper";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table } from "antd";
import React, { useState } from "react";

import { useTaxInvoiceBulkIssueMutation, useTaxInvoiceBulkOfflineIssueMutation } from "../../api/mutation";
import B2bTaxInvoiceIssuedModal from "./B2bTaxInvoiceIssuedModal";
import getB2bTaxInvoiceTableSetting from "./B2bTaxInvoiceListTableSettings";
import { B2bTaxInvoiceFilterKeys, B2bTaxInvoiceListFilterOpts, createFilterStructure } from "./filter";

export enum TaxInvoiceIssueMode {
  ELECTRONIC = "ELECTRONIC", // 전자발행 (읽기전용)
  MANUAL = "MANUAL", // 수기발행 (수정가능)
}

interface B2bTaxInvoiceListPageProps
  extends PaginateListProps,
    FilterPageProps<B2bTaxInvoiceFilterKeys, B2bTaxInvoiceListFilterOpts> {
  taxInvoices: TaxInvoiceList_taxInvoiceList_edges_node[];
  isStaff: boolean;
  queryVariablesWithoutPagination: TaxInvoiceListVariables;
  fetchForDownload: (variables?: TaxInvoiceListVariables) => Promise<ApolloQueryResult<TaxInvoiceList>>;
  ListNavigator: () => React.ReactNode;
  onTaxInvoiceIssued: (id: string) => void;
}

const B2bTaxInvoiceListPage: React.FC<B2bTaxInvoiceListPageProps> = (props) => {
  const {
    currentTab,
    filterOpts,
    tabs,
    taxInvoices,
    isStaff,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ListNavigator,
    onTaxInvoiceIssued,
    ...listProps
  } = props;
  const filterStructure = createFilterStructure(filterOpts, isStaff);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const [selectedRows, setSelectedRows] = useState<TaxInvoiceList_taxInvoiceList_edges_node[]>([]);
  const [issueMode, setIssueMode] = useState<TaxInvoiceIssueMode | null>(null);
  const [taxInvoiceBulkOfflineIssueMutation, taxInvoiceBulkOfflineIssueMutationOpts] =
    useTaxInvoiceBulkOfflineIssueMutation({
      onCompleted(data) {
        if (data.taxInvoiceBulkOfflineIssue?.errors?.length > 0) {
          showGqlErrors(data.taxInvoiceBulkOfflineIssue.errors);
          return;
        }
        showNotificationSuccess("세금계산서가 성공적으로 수기발행되었습니다.");
      },
    });
  const [taxInvoiceBulkIssueMutation, taxInvoiceBulkIssueMutationOpts] = useTaxInvoiceBulkIssueMutation({
    onCompleted(data) {
      if (data.taxInvoiceBulkIssue?.errors?.length > 0) {
        showGqlErrors(data.taxInvoiceBulkIssue.errors);
        return;
      }
      showNotificationSuccess("선택한 세금계산서의 전자발행이 완료되었습니다.");
    },
  });

  const columns = getB2bTaxInvoiceTableSetting({ isStaff });
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const rowSelection = {
    onChange: (_: React.Key[], selectedRows: TaxInvoiceList_taxInvoiceList_edges_node[]) => {
      setSelectedRows(selectedRows);
    },
    getCheckboxProps: (record: TaxInvoiceList_taxInvoiceList_edges_node) => ({
      disabled: record?.status !== TaxInvoiceStatus.REQUESTED,
    }),
    selectedRowKeys: selectedRows.map((row) => row.id),
  };
  const handleSave = (columns: any) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);

  const handleElectronicIssue = () => {
    if (selectedRows.length === 0) {
      showNotificationWarn("발행할 세금계산서를 선택해주세요.");
      return;
    }
    setIssueMode(TaxInvoiceIssueMode.ELECTRONIC);
  };

  const handleManualIssue = () => {
    if (selectedRows.length === 0) {
      showNotificationWarn("발행할 세금계산서를 선택해주세요.");
      return;
    }
    setIssueMode(TaxInvoiceIssueMode.MANUAL);
  };

  const handleIssueSubmit = async (formData: TaxInvoiceBulkOfflineIssueInput) => {
    try {
      if (issueMode === TaxInvoiceIssueMode.ELECTRONIC) {
        const ids = selectedRows.map((row) => row.id);
        await taxInvoiceBulkIssueMutation({
          variables: {
            ids,
          },
        });
      } else {
        const detailsInput = formData.details.map((detail: TaxInvoiceBulkOfflineIssueDetailInput) => ({
          id: detail.id,
          writeDate: detail.writeDate,
          totalAmount: detail.totalAmount,
        }));

        await taxInvoiceBulkOfflineIssueMutation({
          variables: {
            input: {
              details: detailsInput,
            } as TaxInvoiceBulkOfflineIssueInput,
          },
        });
      }
      setSelectedRows([]);
      setIssueMode(null);
    } catch (error) {
      showGqlErrors(error);
    }
  };

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "taxInvoiceList",
  };
  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between" align="middle">
        <Col>{ListNavigator()}</Col>
        <Col>
          <Space>
            <Button type="primary" onClick={handleElectronicIssue}>
              전자발행
            </Button>
            <Button type="primary" onClick={handleManualIssue}>
              수기발행
            </Button>
          </Space>
        </Col>
      </Row>

      <Card>
        <SpreadFilterBar
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          filterStructure={filterStructure}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <ColumnPicker
              columns={pickColumns}
              loading={props.disabled}
              initialColumns={initialColumns}
              total={pickColumns?.length}
              onSave={handleSave}
            />
          }
        />
        <TableVatLegend isIncludeVat={false} />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={props.disabled}
          columns={pickerSelectedColumns}
          dataSource={taxInvoices}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          rowSelection={rowSelection}
          footer={() => <TableListFooter {...props} />}
        />
      </Card>

      {issueMode !== null && (
        <B2bTaxInvoiceIssuedModal
          open={true}
          selectedTaxInvoices={selectedRows}
          issueMode={issueMode}
          loading={taxInvoiceBulkOfflineIssueMutationOpts.loading || taxInvoiceBulkIssueMutationOpts.loading}
          onClose={() => {
            setIssueMode(null);
            setSelectedRows([]);
          }}
          onSubmit={handleIssueSubmit}
        />
      )}
    </Space>
  );
};

export default B2bTaxInvoiceListPage;
</file>

