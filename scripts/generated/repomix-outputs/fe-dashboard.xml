}

interface HqPreFounderConsultationDetailsViewProps {
  id: string;
}

export const HqPreFounderConsultationDetailsView: React.FC<HqPreFounderConsultationDetailsViewProps> = ({ id }) => {
  const navigate = useNavigator();
  const [editMode, setEditMode] = useState<HqPreFounderConsultationEditModeEnum>(null);

  const onEdit = (mode: HqPreFounderConsultationEditModeEnum) => {
    setEditMode(mode);
  };
  const onEditCancel = () => {
    setEditMode(null);
  };

  const { data, loading } = useHqPreFounderConsultationDetailsQuery({ variables: { id } });
  const consultation = maybe(() => data.preFounderConsultation, null);

  const [preFounderConsultationUpdate] = usePreFounderConsultationUpdateMutation({
    onCompleted: (data) =>
      utils.handleOnCompletedWithError(data.preFounderConsultationUpdate.errors, "상담 정보가 수정되었습니다.", () => {
        onEditCancel();
      }),
  });

  const handleUpdate = (formData: PreFounderConsultationUpdateInput) => {
    const convertedContent = convertMarkdownToContentJsonStr(formData.content);

    const input: PreFounderConsultationUpdateInput = { ...formData, content: convertedContent };
    preFounderConsultationUpdate({ variables: { id, input } });
  };

  const handleBack = () => {
    navigate(hqPreFounderDetailsViewUrl(consultation?.preFounder.id));
  };

  if (loading) {
    return <Loader />;
  }
  return (
    <>
      <HqPreFounderConsultationDetailsPage
