<file path="src/app/views/hqMileageSettlement/components/HqMileageSettlementListPage/utils.ts">
import { commonMsg } from "@assets/messages/commonMsg";
import { BrandMonthlySettlementStatusEnum } from "@src/api/types/globalTypes";
import { onlyMonthFormat } from "@src/app/providers/DateProvider";
import { Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq } from "@src/app/views/hqMileageSettlement/utils";
import { BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node } from "@src/app/views/mileageSettlement/api/types/BrandMileageMonthlySettlements";
import { getMileageSettlementStatusTextForAdmin } from "@src/app/views/mileageSettlement/components/MileageSettlementListPage/utils";
import {
  calcVatByPriceExcludeVat,
  excelDownload,
  makeHeaderRowsAndMerges,
  toPriceExcludeVat,
} from "@utils/excel/excelDownload";
import { destroyDownloadingMessage, showNotificationError, showNotificationWarn } from "@utils/notification/wrapper";
import moment from "moment";

export const overwriteStatForHq = (
  brandStats: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq,
  confirmedDataNode: BrandMileageMonthlySettlements_brandMileageMonthlySettlements_edges_node
) => {
  brandStats = {
    ...brandStats,
    // 확정된 데이터들은 확정된 데이터 값으로 덮어써야함.(스냅샷 뜬 데이터이므로)
    statMileageExcludeVat: confirmedDataNode?.mileageExcludeVat || brandStats.statMileageExcludeVat,
    statTotalPriceExcludeVat: confirmedDataNode?.totalPriceExcludeVat || brandStats.statTotalPriceExcludeVat,
    statRcoinsExcludeVat: confirmedDataNode?.rcoinsExcludeVat || brandStats.statRcoinsExcludeVat,
    statBrandPayingChargeExcludeVat:
      confirmedDataNode?.brandPayingChargeExcludeVat || brandStats.statBrandPayingChargeExcludeVat,
    statBrandDeliveryFee: confirmedDataNode?.brandDeliveryFee || brandStats.statBrandDeliveryFee,
    statReturnDeliveryFee: confirmedDataNode?.returnDeliveryFee || brandStats.statReturnDeliveryFee,
    statBrandCostPriceExcludeVat:
      confirmedDataNode?.brandCostPriceExcludeVat || brandStats.statBrandCostPriceExcludeVat,
    settlementStatus: confirmedDataNode?.settlementStatus || null,
    rejectReason: confirmedDataNode?.rejectReason || null,
    settlementId: confirmedDataNode?.id || null,
    decreaseDevCostIncludeVat: confirmedDataNode?.decreaseDevCostIncludeVat,
  };
  return brandStats;
};

export const handleClickExcelDownloadForHq = (
  dataSource: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[],
  brandName: string
) => {
  try {
    const { rows, colsInfo, header, merges } = parseMileageSettlementListForHq(dataSource);
    if (!rows || rows.length <= 0) {
      showNotificationWarn("출력할 데이터가 없습니다.");
      return;
    }
    const title = `본부수익금 신청 리스트(${brandName})`;
    excelDownload({ title, columns: rows, header, merges, colsInfo, skipOriginHeader: true });
  } catch (e) {
    showNotificationError("에러가 발생하였습니다");
    throw e;
  } finally {
    destroyDownloadingMessage();
  }
};

const parseMileageSettlementListForHq = (dataSource: Extended_BrandsOrderStatsMonthly_brandsOrderStats_For_Hq[]) => {
  const rows = [];

  dataSource.forEach((data, index) => {
    // 구분
    const statDate = moment(data.statDate).format(onlyMonthFormat);

    // [전체 주문]
    // 매출 (부가세 별도)
    const statTotalPriceExcludeVat = data.statTotalPriceExcludeVat;
    // 사용 포인트 (부가세 별도)
    const statRcoinsExcludeVat = data.statRcoinsExcludeVat;
    // 매입 (부가세 별도)
    const statBrandCostPriceExcludeVat = data.statBrandCostPriceExcludeVat;
    // 반품배송비 (부가세 별도)
    const statReturnDeliveryFeeExcludeVat = toPriceExcludeVat(data.statReturnDeliveryFee);
    // 배송비 (부가세 별도)
    const statBrandDeliveryFeeExcludeVat = toPriceExcludeVat(data.statBrandDeliveryFee);
    // PG결제수수료 (부가세 별도)
    const statBrandPayingChargeExcludeVat = data.statBrandPayingChargeExcludeVat;

    // [본부수익금]
    // 공급가액
    const statMileageExcludeVat = data.statMileageExcludeVat;
    // 세액
    const statMileageVat = calcVatByPriceExcludeVat(data.statMileageExcludeVat);
    // 합계금액
    const statMileageIncludeVat = statMileageExcludeVat + statMileageVat;

    // [본부수익금 정산처리 정보]
    // 상태
    const statusText = getMileageSettlementStatusTextForAdmin(data.settlementStatus);
    // 반려사유
    const rejectReason = data.rejectReason ? data.rejectReason : "-";

    const stateDate = {
      구분: statDate,
    };
    const orderInfo = {
      [mileageSettlementKeysToMerge.order + "\n매출\n" + commonMsg.excludeVat]: statTotalPriceExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n사용 포인트\n" + commonMsg.excludeVat]: statRcoinsExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n매입\n" + commonMsg.excludeVat]: statBrandCostPriceExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n반품배송비\n" + commonMsg.excludeVat]: statReturnDeliveryFeeExcludeVat,
      [mileageSettlementKeysToMerge.order + "\n배송비\n" + commonMsg.excludeVat]: statBrandDeliveryFeeExcludeVat,
      [mileageSettlementKeysToMerge.order + "\nPG결제수수료\n" + commonMsg.excludeVat]: statBrandPayingChargeExcludeVat,
    };
    const mileageInfo = {
      [mileageSettlementKeysToMerge.mileage + "\n공급가액"]: statMileageExcludeVat,
      [mileageSettlementKeysToMerge.mileage + "\n세액"]: statMileageVat,
      [mileageSettlementKeysToMerge.mileage + "\n합계금액"]: statMileageIncludeVat,
    };

    const statusInfo = {
      [mileageSettlementKeysToMerge.status + "\n상태"]: statusText,
      [mileageSettlementKeysToMerge.status + "\n반려사유"]: rejectReason,
    };

    const mergedRows = {
      ...stateDate,
      ...orderInfo,
      ...mileageInfo,
      ...statusInfo,
    };
    rows.push(mergedRows);
  });

  const { header, merges } = makeHeaderRowsAndMerges(rows[0]);
  const colsInfo = rows.length > 0 ? Object.keys(rows[0]).map(() => ({ wch: 10 })) : [];
  return { rows, colsInfo, header, merges };
};

const mileageSettlementKeysToMerge = {
  order: "[전체 주문]",
  mileage: "[본부수익금]",
  status: "[현황]",
};

export const getMileageSettlementStatusStepsIndexForHqMain = (status: BrandMonthlySettlementStatusEnum) => {
  switch (status) {
    case BrandMonthlySettlementStatusEnum.CONFIRMED:
      return 1;
    case BrandMonthlySettlementStatusEnum.REVIEWING_BY_ADMIN:
    case BrandMonthlySettlementStatusEnum.WAITING_FOR_PAYMENT:
      return 2;
    case BrandMonthlySettlementStatusEnum.PAID:
      return 3;
    default:
      return 0;
  }
};
</file>

