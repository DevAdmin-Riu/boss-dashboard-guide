import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React from "react";

import { Makers, Makers_makers_edges_node, MakersVariables } from "../../api/types/Makers";
import { createFilterStructure, MakerFilterKeys, MakerListFilterOpts } from "./filters";
import { getMakerTableSettings } from "./MakerListTableSettings";

export interface MakerListPageProps extends PaginateListProps, FilterPageProps<MakerFilterKeys, MakerListFilterOpts> {
  makers: Makers_makers_edges_node[];
  onUpdate: (makerId: string) => void;
  onDelete: (makerId: string) => void;

  queryVariablesWithoutPagination: MakersVariables;
  fetchForDownload: (variables?: MakersVariables) => Promise<ApolloQueryResult<Makers>>;
}

const MakerListPage: React.FC<MakerListPageProps> = (props) => {
  const {
    currentTab,
    filterOpts,
    tabs,
    makers,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const filterStructure = createFilterStructure(filterOpts);
  const columns = getMakerTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const tableTitle = () => (
    <Typography.Text strong type="warning">
      연결된 제품이 존재하는 제조사는 수정/삭제가 불가합니다.
    </Typography.Text>
  );

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "makers",
  };

  return (
    <>
      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.makers}</Typography.Title>
          </Col>
          <Col>
            <Button type="primary" shape="round" onClick={onAdd}>
              제조사 추가
            </Button>
          </Col>
        </Row>
        <Card>
          <SpreadFilterBar
            currentTab={currentTab}
            onAll={onAll}
            onFilterChange={onFilterChange}
            onTabChange={onTabChange}
            onTabDelete={onTabDelete}
            onTabSave={onTabSave}
            tabs={tabs}
            filterStructure={filterStructure}
            isDownloadable={true}
            excelDownloadProps={excelDownloadProps}
            tabExtra={
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            }
          />
          <Table
            {...commonTableProps}
            ref={tableRef}
            title={tableTitle}
            loading={listProps.disabled}
            columns={pickerSelectedColumns}
            dataSource={makers}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};

export default MakerListPage;
</file>

