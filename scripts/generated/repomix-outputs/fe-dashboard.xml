import { Button } from "antd";
import React from "react";
import urljoin from "url-join";

const emptyLink = "#";

const getSlideItems = (prefix: "pc" | "mobile") => [
  {
    imageUrl: `${prefix}_banner_boss-1.png`,
    imageLink: "http://www.우아한놈들.com/",
  },
  {
    imageUrl: `${prefix}_banner_boss-2.jpg`,
    imageLink: emptyLink,
  },
  {
    imageUrl: `${prefix}_banner_boss-3.jpg`,
    imageLink: emptyLink,
  },
  {
    imageUrl: `${prefix}_banner_boss-4.jpg`,
    imageLink: emptyLink,
  },
];

interface LoginAdsBannerProps {
  // 로그인 폼 내부에 표시되는지 여부
  inner: boolean;
}

export const LoginAdsBanner: React.FC<LoginAdsBannerProps> = (props) => {
  const { inner } = props;

  return (
    <CustomCarousel
      autoplay
      easing="ease"
      arrows={true}
      prevArrow={<Button style={{ opacity: 0.6 }} type="primary" shape="circle" icon={<LeftOutlined />} />}
