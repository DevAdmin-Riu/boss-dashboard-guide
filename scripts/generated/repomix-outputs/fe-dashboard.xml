import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { User_brand } from "@src/api/fragments/types/User";
import { BrandEtcFileTypeEnum, BrandExclusiveBpvGradeTypeEnum } from "@src/api/types/globalTypes";
import { getDescriptionsClassName } from "@src/app/components/antd/Descriptions/DescriptionsProps";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import { SwapNavButtonBar } from "@src/app/components/Navigator/SwapNavButtonBar";
import TableVatLegend, { SMALL_FONT_SIZE, SMALL_SIZE_PADDING } from "@src/app/components/TableVat/TableVatLegend";
import { useAuth } from "@src/app/providers/AuthProvider/AuthProvider";
import { BrandForBpvList_brand } from "@src/app/views/brand/brands/api/types/BrandForBpvList";
import {
  getDepositExcludeVatByBrand,
  getInsuranceDepositExcludeVatByBrand,
} from "@src/app/views/brand/brands/components/BrandListPage/utils";
import { getBrandEtcFileDateRangeText } from "@src/app/views/brand/brands/utils";
import { BpvListForHq, BpvListForHqVariables } from "@src/app/views/hqStaff/hqSection/api/types/BpvListForHq";
import { HqInfoProductListType, hqInfoProductListViewPath } from "@src/app/views/hqStaff/hqSection/urls";
import { FilterPageProps } from "@src/global/core/types/types";
import { toPriceExcludeVat } from "@utils/excel/excelDownload";
import { utils } from "@utils/utils";
import { Card, Col, Descriptions, Row, Space } from "antd";
import React from "react";

import { transformHqInfoProductPageType } from "../../utils";
import { createFilterStructure, HqInfoProductFilterKeys, HqInfoProductFilterOpts } from "./filters";
import { getExclusiveVariantsTableColumns } from "./HqInfoProductPageTableSettings";
import { HqInfoProductListItem } from "./types";

interface HqInfoProductPageProps extends FilterPageProps<HqInfoProductFilterKeys, HqInfoProductFilterOpts> {
  exclusiveVariants: HqInfoProductListItem[];
  pageType: HqInfoProductListType | ":pageType";
  queryVariablesWithoutPagination: BpvListForHqVariables;
  fetchForDownload: (variables?: Partial<BpvListForHqVariables>) => Promise<ApolloQueryResult<BpvListForHq>>;
  disabled?: boolean;
}

export const makeExclusiveBpvGradeInfoUis = (brand: User_brand | BrandForBpvList_brand) => {
  const exclusiveBpvGradeInfo = brand.exclusiveBpvGradeInfo;
  if (utils.isEmpty(exclusiveBpvGradeInfo)) {
    return null;
  }
  const avgSalesPriceExcludeVatText =
    exclusiveBpvGradeInfo.type === BrandExclusiveBpvGradeTypeEnum.PREMIER
      ? `${utils.convertToNumberWrapper(exclusiveBpvGradeInfo.fromAvgSalesPriceExcludeVat).toLocaleString()}원 이상`
      : `${utils.convertToNumberWrapper(exclusiveBpvGradeInfo.toAvgSalesPriceExcludeVat).toLocaleString()}원 미만`;
  const rateText = `${utils.convertToNumberWrapper(exclusiveBpvGradeInfo.rate).toLocaleString()}%`;
  return (
    <>
      <TableVatLegend isIncludeVat={false} size="small" />
      <Descriptions
        className={getDescriptionsClassName(["ant-descriptions-item-label-centered"])}
        layout="vertical"
        bordered
        size="small"
        style={{ textAlign: "center" }}
        labelStyle={{
          wordBreak: "keep-all",
          verticalAlign: "middle",
          whiteSpace: "nowrap",
          fontWeight: "bold",
          fontSize: SMALL_FONT_SIZE,
        }}
        contentStyle={{
          fontSize: SMALL_FONT_SIZE,
        }}
      >
        <Descriptions.Item label="기준 구간" style={{ padding: SMALL_SIZE_PADDING }}>
          {exclusiveBpvGradeInfo.type}
        </Descriptions.Item>
        <Descriptions.Item label="기준 월평균매출" style={{ padding: SMALL_SIZE_PADDING }}>
          {avgSalesPriceExcludeVatText}
        </Descriptions.Item>
        <Descriptions.Item label="기준 전용재고비율" style={{ padding: SMALL_SIZE_PADDING }}>
          {rateText}
        </Descriptions.Item>
      </Descriptions>
    </>
  );
};

// 과세/면세 상품 혼합 매출, 재고금액에 대해 면세 포함 여부 무시하고 그냥 부가세 별도 금액으로 표시하는 것으로 요청 받음
export const makeExclusiveBpvInfoUis = (brand: User_brand | BrandForBpvList_brand) => {
  const last3MonthMonthlyAvgSalesPriceExcludeVat = toPriceExcludeVat(brand.last3MonthMonthlyAvgSalesPrice, false);
  const avgSalesText = utils.isEmpty(last3MonthMonthlyAvgSalesPriceExcludeVat)
    ? "-"
    : `${last3MonthMonthlyAvgSalesPriceExcludeVat.toLocaleString()}원`;
  const inStockCount = brand.inStockExclusiveVariantsCount;
  const totalCostExcludeVat = toPriceExcludeVat(brand.totalExclusiveBpvCost, false);
  const totalCostExcludeVatText = utils.isEmpty(totalCostExcludeVat) ? "-" : totalCostExcludeVat.toLocaleString();
  const totalCostRate =
    utils.isEmpty(totalCostExcludeVat) === false &&
    utils.isEmpty(last3MonthMonthlyAvgSalesPriceExcludeVat) === false &&
    last3MonthMonthlyAvgSalesPriceExcludeVat > 0
      ? utils.convertToNumberWrapper(
          utils.convertToPercentFromDecimal(totalCostExcludeVat / last3MonthMonthlyAvgSalesPriceExcludeVat),
          1
        )
      : undefined;
  const totalCostRateText = utils.isEmpty(totalCostRate) ? "-" : `${totalCostRate.toLocaleString()}%`;
  const exclusiveBpvGradeInfo = brand.exclusiveBpvGradeInfo;
  const exceedRate = utils.isEmpty(totalCostRate)
    ? undefined
    : utils.convertToNumberWrapper(totalCostRate - exclusiveBpvGradeInfo.rate, 1);
  const exceedRateText = utils.isEmpty(exceedRate) ? "-" : `${exceedRate.toLocaleString()}%`;
  const isExceed = utils.isEmpty(exceedRate) === false && exceedRate > 0;
  const criticalCount = brand.criticalExclusiveVariantsCount;
  const totalCriticalCostExcludeVat = toPriceExcludeVat(brand.criticalTotalExclusiveBpvCost, false);
  const totalCriticalCostExcludeVatText = utils.isEmpty(totalCriticalCostExcludeVat)
    ? "-"
    : totalCriticalCostExcludeVat.toLocaleString();
  const totalCriticalCostRate =
    utils.isEmpty(totalCriticalCostExcludeVat) === false &&
    utils.isEmpty(last3MonthMonthlyAvgSalesPriceExcludeVat) &&
    last3MonthMonthlyAvgSalesPriceExcludeVat > 0
      ? utils.convertToNumberWrapper(
          utils.convertToPercentFromDecimal(totalCriticalCostExcludeVat / last3MonthMonthlyAvgSalesPriceExcludeVat),
          1
        )
      : undefined;
  const totalCriticalCostRateText = utils.isEmpty(totalCriticalCostRate)
    ? "-"
    : `${totalCriticalCostRate.toLocaleString()}%`;
  return (
    <>
      <TableVatLegend isIncludeVat={false} size="small" />
      <Descriptions
        className={getDescriptionsClassName(["ant-descriptions-item-label-centered"])}
        layout="vertical"
        bordered
        size="small"
        style={{ textAlign: "center" }}
        labelStyle={{
          wordBreak: "keep-all",
          verticalAlign: "middle",
          whiteSpace: "nowrap",
          fontWeight: "bold",
          fontSize: SMALL_FONT_SIZE,
        }}
        contentStyle={{
          fontSize: SMALL_FONT_SIZE,
        }}
        column={8}
      >
        <Descriptions.Item label="3개월 월평균매출" style={{ padding: SMALL_SIZE_PADDING }}>
          {avgSalesText}
        </Descriptions.Item>
        <Descriptions.Item
          label={columnNameConstant.brand.IN_STOCK_EXCLUSIVE_PV_COUNT.join(" ")}
          style={{ padding: SMALL_SIZE_PADDING }}
        >
          {inStockCount}
        </Descriptions.Item>
        <Descriptions.Item
          label={columnNameConstant.brand.TOTAL_EXCLUSIVE_PV_COST}
          style={{ padding: SMALL_SIZE_PADDING }}
        >
          {totalCostExcludeVatText}
        </Descriptions.Item>
        <Descriptions.Item label="비율" style={{ padding: SMALL_SIZE_PADDING }}>
          {totalCostRateText}
        </Descriptions.Item>
        <Descriptions.Item
          label="초과"
          labelStyle={isExceed ? { color: "red" } : undefined}
          contentStyle={isExceed ? { color: "red" } : undefined}
          style={{ padding: SMALL_SIZE_PADDING }}
        >
          {exceedRateText}
        </Descriptions.Item>
        <Descriptions.Item
          label={columnNameConstant.brand.CRITICAL_IN_STOCK_EXCLUSIVE_PV_COUNT.join(" ")}
          style={{ padding: SMALL_SIZE_PADDING }}
        >
          {criticalCount}
        </Descriptions.Item>
        <Descriptions.Item
          label={columnNameConstant.brand.CRITICAL_TOTAL_EXCLUSIVE_PV_COST}
          style={{ padding: SMALL_SIZE_PADDING }}
        >
          {totalCriticalCostExcludeVatText}
        </Descriptions.Item>
        <Descriptions.Item label="비율" style={{ padding: SMALL_SIZE_PADDING }}>
          {totalCriticalCostRateText}
        </Descriptions.Item>
      </Descriptions>
    </>
  );
};

export const makeDepositUis = (brand: User_brand | BrandForBpvList_brand) => {
  const insuranceDepositExcludeVat = getInsuranceDepositExcludeVatByBrand(brand);
  const insuranceDepositExcludeVatText = utils.isEmpty(insuranceDepositExcludeVat)
    ? "-"
    : `${insuranceDepositExcludeVat.toLocaleString()}원`;
  const insuranceContractDateRange = getBrandEtcFileDateRangeText(
    brand.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.INSURANCE_CONTRACT)
  );
  const depositExcludeVat = getDepositExcludeVatByBrand(brand);
  const depositText = utils.isEmpty(depositExcludeVat) ? "-" : `${depositExcludeVat.toLocaleString()}원`;
  const depositContractDateRange = getBrandEtcFileDateRangeText(
    brand.etcFiles?.find((etcFile) => etcFile.type === BrandEtcFileTypeEnum.DEPOSIT_CONTRACT)
  );
  // 과세/면세 상품 혼합 재고금액 무시하고 그냥 부가세 별도 금액으로 (보증금 부가세별도 + 보증보험 부가세별도) 와 비교하는 것으로 요청받음
  const totalCostExcludeVat = toPriceExcludeVat(brand.totalExclusiveBpvCost, false) || 0;
  const totalDepositExcludeVat = (insuranceDepositExcludeVat || 0) + (depositExcludeVat || 0);
  const diffExcludeVat = totalCostExcludeVat - totalDepositExcludeVat;
  const isExceed = totalDepositExcludeVat > 0 && diffExcludeVat > 0;
  const diffExcludeVatText = isExceed ? `${diffExcludeVat.toLocaleString()}원` : "-";
  return (
    <>
      <TableVatLegend isIncludeVat={false} size="small" />
      <Descriptions
        className={getDescriptionsClassName(["ant-descriptions-item-label-centered"])}
        layout="vertical"
        bordered
        size="small"
        style={{ textAlign: "center" }}
        labelStyle={{
          wordBreak: "keep-all",
          verticalAlign: "middle",
          whiteSpace: "nowrap",
          fontWeight: "bold",
          fontSize: SMALL_FONT_SIZE,
        }}
        contentStyle={{
          fontSize: SMALL_FONT_SIZE,
        }}
      >
        <Descriptions.Item label="보증보험" style={{ padding: SMALL_SIZE_PADDING }}>
          {insuranceDepositExcludeVatText} ({insuranceContractDateRange})
        </Descriptions.Item>
        <Descriptions.Item label="보증금" style={{ padding: SMALL_SIZE_PADDING }}>
          {depositText} ({depositContractDateRange})
        </Descriptions.Item>
        <Descriptions.Item
          label="보증보험/보증금 초과"
          style={{ padding: SMALL_SIZE_PADDING }}
          labelStyle={isExceed ? { color: "red" } : undefined}
          contentStyle={isExceed ? { color: "red" } : undefined}
        >
          {diffExcludeVatText}
        </Descriptions.Item>
      </Descriptions>
    </>
  );
};

export const makeHqInfoProductPageTypeSwapUi = (pageType: HqInfoProductListType | any) => {
  const pageTypeListToSwap: HqInfoProductListType[] = ["general", "package"];
  const showSwapNavBar = pageTypeListToSwap.includes(pageType);
  if (!showSwapNavBar) {
    return null;
  }

  return (
    <SwapNavButtonBar
      options={pageTypeListToSwap.map((pageType) => ({
        text: `${transformHqInfoProductPageType(pageType)} 상품`,
        url: hqInfoProductListViewPath({ pageType }),
      }))}
    />
  );
};

const HqInfoProductPage: React.FC<HqInfoProductPageProps> = (props) => {
  const {
    exclusiveVariants,
    currencySymbol,
    currentTab,
    filterOpts,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    pageType,
    fetchForDownload,
    queryVariablesWithoutPagination,
  } = props;
  const { user } = useAuth();
  const filterStructure = createFilterStructure(filterOpts, pageType);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getExclusiveVariantsTableColumns(pageType);
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const brand = user?.brand;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: columns,
    dataKey: "brandProductVariants",
  };

  return (
    <Space direction="vertical" size={24}>
      {makeHqInfoProductPageTypeSwapUi(pageType)}
      {pageType === "product" && brand && (
        <>
          <Row justify="space-between" gutter={[12, 12]}>
            {<Col span={7}>{makeExclusiveBpvGradeInfoUis(brand)}</Col>}
            {<Col span={17}>{makeExclusiveBpvInfoUis(brand)}</Col>}
          </Row>
          <Row justify="space-between" gutter={[12, 12]}>
            {<Col span={24}>{makeDepositUis(brand)}</Col>}
          </Row>
        </>
      )}
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable
          excelDownloadProps={excelDownloadProps}
        />
        <TableVatLegend isIncludeVat={false} />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          loading={props.disabled}
          columns={columns}
          dataSource={exclusiveVariants}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
        />
      </Card>
    </Space>
  );
};
export default HqInfoProductPage;
</file>

