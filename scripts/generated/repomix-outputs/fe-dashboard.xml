import { ApolloQueryResult } from "@apollo/client";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { User } from "@src/api/fragments/types/User";
import { HqStaffRoleEnum } from "@src/api/types/globalTypes";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import ColumnPicker from "@src/app/components/ColumnPicker";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { checkIsEnableForLinkersServiceByUser } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Row, Space, Table, Typography } from "antd";
import React from "react";

import {
  ListCustomers,
  ListCustomers_customers_edges_node,
  ListCustomersVariables,
} from "../../api/types/ListCustomers";
import { getCustomerTableSettings } from "./CustomerTableSettings";
import { createFilterStructure, CustomerFilterKeys, CustomerListFilterOpts } from "./filters";

export interface CustomerListPageProps
  extends PaginateListProps,
    FilterPageProps<CustomerFilterKeys, CustomerListFilterOpts> {
  me: User;
  customers: ListCustomers_customers_edges_node[];
  isHqStaff: boolean;
  isForBrand: boolean;
  queryVariables: ListCustomersVariables;
  onHqStaffCreate: () => void;
  onStoreWorkerCreate: () => void;

  queryVariablesWithoutPagination: ListCustomersVariables;
  fetchForDownload: (variables?: ListCustomersVariables) => Promise<ApolloQueryResult<ListCustomers>>;
}
const CustomerListPage: React.FC<CustomerListPageProps> = (props) => {
  const {
    isHqStaff,
    isForBrand,
    me,
    currencySymbol,
    currentTab,
    filterOpts,
    onAdd,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    tabs,
    onHqStaffCreate,
    onStoreWorkerCreate,
    queryVariables,
    queryVariablesWithoutPagination,
    fetchForDownload,
    onRowClick,
    ...listProps
  } = props;
  const enableForLinkersService = checkIsEnableForLinkersServiceByUser(me);

  const { tableRef, tableScrollY } = useTableScrollInitialize();

  const filterStructure = createFilterStructure(filterOpts, isHqStaff, isForBrand);
  const columns = getCustomerTableSettings(props);
  const { pickColumns, pickerSelectedColumns, initialColumns } = utils.getPickColumns(
    columns,
    listProps.settings.columns
  );
  const handleSave = (columns) => listProps.onUpdateListSettings("columns", columns);
  const tableWidthSum = utils.calcTableColsWidthSum(pickerSelectedColumns);
  const titleText = isHqStaff ? sectionNames.hqStaffList : sectionNames.storeWorkerList;

  const isMeHqAdmin = me?.hqStaffRole === HqStaffRoleEnum.ADMIN;

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: pickerSelectedColumns,
    dataKey: "customers",
  };

  const hqStaffCreateButton = (
    <Button type="primary" shape="round" onClick={onHqStaffCreate}>
      사용자(가맹본부) 생성
    </Button>
  );

  const storeWorkerCreateButton = (
    <Button type="primary" shape="round" onClick={onStoreWorkerCreate}>
      사용자(매장) 생성
    </Button>
  );

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{titleText}</Typography.Title>
        </Col>
        {enableForLinkersService &&
          (isHqStaff ? (
            isMeHqAdmin && (
              <Col>
                <Space direction="horizontal">{hqStaffCreateButton}</Space>
              </Col>
            )
          ) : (
            <Col>
              <Space direction="horizontal">{storeWorkerCreateButton}</Space>
            </Col>
          ))}
      </Row>
      <Card>
        <SpreadFilterBar
          currencySymbol={currencySymbol}
          currentTab={currentTab}
          filterStructure={filterStructure}
          tabs={tabs}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
          tabExtra={
            <>
              <ColumnPicker
                columns={pickColumns}
                loading={listProps.disabled}
                initialColumns={initialColumns}
                total={pickColumns?.length}
                onSave={handleSave}
              />
            </>
          }
        />
        <Table
          {...commonTableProps}
          ref={tableRef}
          loading={listProps.disabled}
          columns={pickerSelectedColumns}
          dataSource={listProps.customers}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};
export default CustomerListPage;
</file>

