  const productColumns: DownloadableColumnsType<HqInfoProductListItem> = [
    variantNameColumn,
    isInnerColumn,
    attributesColumn,
    qtyPerBoxColumn,
    salesStatusByProductVariantColumn,
    salesStatusByBrandProductVariantColumn,
    stoppedAtByProductVariantColumn,
    firstAvailableForPurchaseColumn,
    stoppedAtByBrandProductVariantColumn,
    isGeneralProductPage && isExclusiveColumn,
    isOnlyPayableByCashColumn,
    brandPriceExcludeVatColumn,
    priceExcludeVatColumn,
  ];

  const totalStockQuantityColumn: DownloadableColumnType<HqInfoProductListItem> = {
