      <PatchedColumnsTable<TBrandExclusiveStockData>
        {...commonTableProps}
        rowKey={(record) => record.monthStr}
        title={() => (
          <Row justify="space-between">
            <Typography.Text strong>전용/악성 재고 현황 (최근 {exclusiveStockDataSource.length}개월)</Typography.Text>
