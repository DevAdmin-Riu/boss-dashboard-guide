<file path="src/app/components/Card/BrandCountManagementCard.tsx">
import { MinusCircleOutlined, PlusCircleOutlined } from "@ant-design/icons";
import { ApolloError, MutationFunctionOptions, MutationResult } from "@apollo/client";
import { getIconProps } from "@src/app/components/antd/Icon/IconProps";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import ConfirmModal from "@src/app/components/ConfirmModal";
import { showNotificationError, showNotificationSuccess } from "@utils/notification/wrapper";
import { Button, Card, Col, Form, Input, InputNumber, Modal, Row, Space, Statistic, Typography } from "antd";
import { useForm } from "antd/lib/form/Form";
import React, { useState } from "react";

import { getTypeSafeForm } from "../antd/Form/utils";
import { Path, PathValue } from "../antd/types/GenericFieldPath";

interface BrandCountManagementCardProps<TFormData, TMutationData, TMutationVariables, TEventType extends string> {
  count: number;
  countUnit: string;
  rechargeHelpText: string;
  mutationHook: (
    options?: any
  ) => [(options?: MutationFunctionOptions<TMutationData, TMutationVariables>) => void, MutationResult<TMutationData>];
  onHistoryClick: () => void;
  makeMutationVariables: (formData: TFormData) => TMutationVariables;
  rechargeModeValue: TEventType;
  deductionModeValue: TEventType;
}

const BrandCountManagementCard = <
  TFormData,
  TMutationData,
  TMutationVariables extends object,
  TEventType extends string
>({
  count,
  countUnit,
  rechargeHelpText,
  mutationHook,
  onHistoryClick,
  makeMutationVariables,
  rechargeModeValue,
  deductionModeValue,
}: BrandCountManagementCardProps<TFormData, TMutationData, TMutationVariables, TEventType>) => {
  const [open, setOpen] = useState(false);
  const [openConfirmModal, setOpenConfirmModal] = useState(false);
  const [form] = useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const typeWatched = TypeSafeForm.getUseFormWatched({ name: "type" as Path<TFormData> });
  const deltaWatched = TypeSafeForm.getUseFormWatched({ name: "delta" as Path<TFormData> });

  const isDeductionMode = typeWatched === deductionModeValue;
  const isRechargeMode = typeWatched === rechargeModeValue;
  const typeText = isDeductionMode ? "차감" : isRechargeMode ? "충전" : "";

  const [runMutation, { loading }] = mutationHook({
    onCompleted: (data: TMutationData) => {
      const response = data[Object.keys(data)[0]];
      if (response.errors.length === 0) {
        showNotificationSuccess(`${countUnit} ${typeText} 완료`);
        setOpen(false);
      } else {
        showNotificationError(response.errors[0]?.message || `${countUnit} ${typeText} 실패`);
      }
    },
    onError: (error: ApolloError) => {
      showNotificationError(error.message);
    },
  });

  const handleOpenModal = (type: string) => {
    form.resetFields();
    TypeSafeForm.setFields([{ name: "type" as Path<TFormData>, value: type as PathValue<TFormData, Path<TFormData>> }]);
    setOpen(true);
  };

  const handleOk = () => {
    form
      .validateFields()
      .then(() => setOpenConfirmModal(true))
      .catch((info) => {
        if (info.errorFields && info.errorFields.length > 0) {
          for (const errorField of info.errorFields) {
            showNotificationError(errorField.errors[0]);
          }
        }
      });
  };

  const handleConfirm = () => {
    const formData = form.getFieldsValue();
    const variables = makeMutationVariables(formData);

    runMutation({ variables });
    setOpenConfirmModal(false);
  };

  return (
    <>
      <Card>
        <Row gutter={16}>
          <Col span={12}>
            <Statistic title={`${countUnit} 가능 수`} value={count} suffix="회" />
          </Col>
          <Col span={12}>
            <Space size="small" align="center">
              <Button
                shape="circle"
                type="text"
                disabled={count === 0}
                onClick={() => handleOpenModal(deductionModeValue)}
              >
                <MinusCircleOutlined {...getIconProps({ size: 22 })} />
              </Button>
              <Button shape="circle" type="text" onClick={() => handleOpenModal(rechargeModeValue)}>
                <PlusCircleOutlined {...getIconProps({ size: 22 })} />
              </Button>
              <Typography.Link strong onClick={onHistoryClick}>
                {countUnit} 충전/차감 내역 보기
              </Typography.Link>
            </Space>
          </Col>
        </Row>
      </Card>
      <Modal
        forceRender
        closable={false}
        onOk={handleOk}
        onCancel={() => setOpen(false)}
        open={open}
        title={`${countUnit} 카운트 ${typeText}`}
        okText="확인"
        cancelText="뒤로"
        okButtonProps={{
          disabled: deltaWatched === undefined || Number(deltaWatched) <= 0,
          loading,
        }}
        maskClosable={false}
      >
        <Form form={form} layout="vertical" initialValues={{ type: rechargeModeValue }}>
          <Form.Item name="type" hidden>
            <Input />
          </Form.Item>
          <Row gutter={[12, 12]}>
            <Col span={24}>
              <Form.Item
                name="delta"
                label={
                  <>
                    {countUnit} {typeText} 수{" "}
                    {isRechargeMode && (
                      <Typography.Text style={{ marginLeft: 6 }} type="warning">
                        {rechargeHelpText}
                      </Typography.Text>
                    )}
                  </>
                }
                rules={[{ required: true, message: "수량을 입력해주세요." }]}
              >
                <InputNumber
                  {...getInputNumberProps({ isCommaDisplay: true })}
                  addonAfter={"회"}
                  style={{ width: "100%" }}
                  min={1}
                />
              </Form.Item>
            </Col>
          </Row>
          <Row>
            <Col span={24}>
              <Form.Item name="description" label="사유" rules={[{ required: true, message: "사유를 입력해주세요." }]}>
                <Input.TextArea rows={4} placeholder="사유를 입력해주세요." />
              </Form.Item>
            </Col>
          </Row>
        </Form>
      </Modal>
      {openConfirmModal && (
        <ConfirmModal visible={openConfirmModal} onOk={handleConfirm} onCancel={() => setOpenConfirmModal(false)} />
      )}
    </>
  );
};

export default BrandCountManagementCard;
</file>

