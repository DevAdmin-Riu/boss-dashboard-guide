import {
  ProductVariantSortField,
  StockDetailEventSortField,
  StockDetailEventSortingInput,
} from "@src/api/types/globalTypes";
import { createGetSortQueryVariables, getOrderDirection } from "@utils/sort";

import { StockListViewUrlSortField } from "../../urls";

function getSortQueryField(sort: StockListViewUrlSortField): ProductVariantSortField {
  switch (sort) {
    case StockListViewUrlSortField.stockStatus:
      return ProductVariantSortField.STOCK_STATUS;
    case StockListViewUrlSortField.avgSales:
      return ProductVariantSortField.AVG_SALES;
    case StockListViewUrlSortField.vendor:
      return ProductVariantSortField.VENDOR;
    default:
      return undefined;
  }
}

export const getSortQueryVariables = createGetSortQueryVariables(getSortQueryField);

export function getStockDetailEventSortVariables(): StockDetailEventSortingInput {
  return {
    direction: getOrderDirection(false),
    field: StockDetailEventSortField.DATE,
  };
}
