<file path="src/app/views/notice/pushNotification/components/PushSendEventListPage.tsx">
import { NotificationOutlined } from "@ant-design/icons";
import { sectionNames } from "@assets/messages/sectionNames";
import useNavigator from "@hooks/useNavigator";
import { FixedSplitRow } from "@src/app/components/Grid/FixedSplitRow";
import Loader from "@src/app/components/Loader";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { utils } from "@utils/utils";
import { Alert, Button, Card, List, PageHeader, Row, Space, Typography } from "antd";
import moment from "moment";
import React from "react";

import { PushSendEventList_pushSendEventList_edges_node } from "../api/types/PushSendEventList";

type TPushSendEventObjGroupedByDate = Record<string, PushSendEventList_pushSendEventList_edges_node[]>;

interface PushSendEventListPageProps {
  pushSendEventList: PushSendEventList_pushSendEventList_edges_node[];
  loading: boolean;
  hasNextPage: boolean;
  pushNotificationEnabled: boolean;
  onOpenAppSettings: () => void;
  onLoadMore: () => void;
}

export const PushSendEventListPage: React.FC<PushSendEventListPageProps> = (props) => {
  const { pushSendEventList, loading, hasNextPage, pushNotificationEnabled, onOpenAppSettings, onLoadMore } = props;
  const navigate = useNavigator();
  const isWebView = utils.checkWebView();

  const objGroupedByDate: TPushSendEventObjGroupedByDate = {};
  pushSendEventList.forEach((event) => {
    const dateKey = moment(event.createdAt).format(onlyDateFormat);
    if (!objGroupedByDate[dateKey]) {
      objGroupedByDate[dateKey] = [event];
    } else {
      objGroupedByDate[dateKey].push(event);
    }
  });
  const sortedDateList = Object.keys(objGroupedByDate).sort((a, b) =>
    moment(b, onlyDateFormat).diff(moment(a, onlyDateFormat))
  );

  const makeLoadMoreNode = () => {
    if (loading) {
      return <Loader />;
    }
    if (pushSendEventList.length === 0) {
      return null;
    }
    return hasNextPage ? (
      <Button block onClick={onLoadMore}>
        더 보기
      </Button>
    ) : (
      <Row justify="center" style={{ margin: 12 }}>
        <Typography.Text type="secondary">더 이상 알림이 없습니다.</Typography.Text>
      </Row>
    );
  };

  return (
    <Space direction="vertical" size="large">
      <PageHeader title={sectionNames.pushSendEvent} />

      {isWebView && !pushNotificationEnabled && (
        <Alert
          showIcon
          icon={<NotificationOutlined />}
          type="info"
          message="알림을 켜고 중요한 소식을 받아보세요."
          action={
            <Button size="small" onClick={onOpenAppSettings}>
              알림 설정
            </Button>
          }
        />
      )}
      <Card bodyStyle={{ padding: 8 }}>
        {pushSendEventList.length === 0 ? (
          <Row justify="center" style={{ margin: 12 }}>
            <Typography.Text type="secondary">최근 알림이 없습니다.</Typography.Text>
          </Row>
        ) : (
          <Space direction="vertical" size="large">
            {sortedDateList.map((date) => {
              const dateMoment = moment(date, onlyDateFormat);
              const dateText = dateMoment.isSame(moment(), "day")
                ? "오늘"
                : dateMoment.isSame(moment().subtract(1, "day"), "day")
                ? "어제"
                : moment(date, onlyDateFormat).format("YYYY년 MM월 DD일");
              const eventListForDate = objGroupedByDate[date];

              return (
                <Card
                  key={date}
                  bordered={false}
                  size="small"
                  title={
                    <Row justify="center">
                      <Typography.Text type="secondary">{dateText}</Typography.Text>
                    </Row>
                  }
                  bodyStyle={{ padding: 0 }}
                >
                  <List
                    size="small"
                    itemLayout="vertical"
                    dataSource={eventListForDate}
                    renderItem={(event) => {
                      const createdAtTimeText = moment(event.createdAt).format("HH:mm");
                      const { title, content, data } = event.parameters;
                      const hasLinkUrl = data && data.linkUrl;

                      return (
                        <List.Item
                          key={event.id}
                          style={{ cursor: hasLinkUrl && "pointer" }}
                          onClick={() => {
                            if (hasLinkUrl) {
                              navigate(data.linkUrl);
                            }
                          }}
                        >
                          <List.Item.Meta
                            style={{ marginBottom: 8 }}
                            title={
                              <FixedSplitRow
                                align="top"
                                mainContent={<Typography.Title level={5}>{title}</Typography.Title>}
                                sideContent={
                                  <Typography.Text style={{ fontSize: 12 }} type="secondary">
                                    {createdAtTimeText}
                                  </Typography.Text>
                                }
                              />
                            }
                            description={content}
                          />
                        </List.Item>
                      );
                    }}
                  />
                </Card>
              );
            })}
            {makeLoadMoreNode()}
          </Space>
        )}
      </Card>
    </Space>
  );
};
</file>

<file path="src/app/views/notice/pushNotification/views/PushSendEventListView.tsx">
import useUser from "@hooks/useUser";
import { useWebViewMessageHandler } from "@hooks/useWebViewMessageHandler";
import { onlyDateFormat } from "@src/app/providers/DateProvider";
import { maybe } from "@utils/misc";
import { showGqlErrors } from "@utils/notification/wrapperGql";
import { utils } from "@utils/utils";
import { sendMessageToWebView } from "@utils/webView";
import moment from "moment";
import React, { useEffect, useState } from "react";

import { usePushSendEventBulkReadMutation } from "../api/mutations";
import { usePushSendEventListQuery } from "../api/queries";
import { PushSendEventListPage } from "../components/PushSendEventListPage";

export const PushSendEventListView: React.FC = () => {
  const { user, updateUser } = useUser();
  const [pushNotificationEnabled, setPushNotificationEnabled] = useState<boolean>(true);
  const isWebView = utils.checkWebView();

  const { data, loading, fetchMore } = usePushSendEventListQuery({
    variables: {
      first: 10,
      filter: {
        createdAt: {
          gte: moment().subtract(30, "days").format(onlyDateFormat),
          lte: moment().format(onlyDateFormat),
        },
      },
    },
  });
  const pushSendEventList = maybe(() => data.pushSendEventList.edges.map((edge) => edge.node), []);
  const pageInfo = maybe(() => data.pushSendEventList.pageInfo, null);

  const loadMore = () =>
    fetchMore({
      variables: {
        after: pageInfo.endCursor,
      },
      updateQuery: (previousResult, { fetchMoreResult }) => {
        if (!fetchMoreResult) {
          return previousResult;
        }
        const previousEdges = previousResult.pushSendEventList.edges;
        const fetchMoreEdges = fetchMoreResult.pushSendEventList.edges;
        fetchMoreResult.pushSendEventList.edges = [...previousEdges, ...fetchMoreEdges];
        return { ...fetchMoreResult };
      },
    });

  const [pushSendEventBulkRead] = usePushSendEventBulkReadMutation({
    onCompleted: (data) => {
      const errors = data.pushSendEventBulkRead.errors;
      if (errors.length === 0) {
        const updatedUser = data.pushSendEventBulkRead.user;
        updateUser(updatedUser);
      } else {
        showGqlErrors(errors);
      }
    },
  });
  const handlePushSendEventBulkRead = () => {
    const userId = user?.id;
    if (utils.isEmpty(userId, true)) {
      return;
    }

    pushSendEventBulkRead({ variables: { userId } });
  };

  useEffect(() => {
    if (isWebView) {
      sendMessageToWebView("REQ_PUSH_NOTIFICATION_ENABLED", null);
    }

    handlePushSendEventBulkRead();
  }, []);

  useWebViewMessageHandler({
    handlers: {
      PUSH_NOTIFICATION_ENABLED: (enabled) => {
        setPushNotificationEnabled(enabled);
      },
    },
  });

  const handleOpenAppSettings = () => {
    if (isWebView) {
      sendMessageToWebView("APP_SETTINGS_OPEN", null);
    }
  };

  return (
    <>
      <PushSendEventListPage
        pushSendEventList={pushSendEventList}
        loading={loading}
        hasNextPage={!!pageInfo?.hasNextPage}
        pushNotificationEnabled={pushNotificationEnabled}
        onOpenAppSettings={handleOpenAppSettings}
        onLoadMore={loadMore}
      />
    </>
  );
};
</file>

