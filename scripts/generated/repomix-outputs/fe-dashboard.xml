import makeMutation from "@hooks/makeMutation";
import { fragmentUser } from "@src/api/fragments/auth";
import { accountErrorFragment, staffErrorFragment } from "@src/api/fragments/errors";
import { staffMemberDetailsFragment } from "@src/api/fragments/staff";
import {
  AccountSwitchBrandUpdate,
  AccountSwitchBrandUpdateVariables,
} from "@src/app/views/settings/staff/api/types/AccountSwitchBrandUpdate";
import gql from "graphql-tag";

import { AccountUpdate, AccountUpdateVariables } from "./types/AccountUpdate";
import { BrandStaffAssign, BrandStaffAssignVariables } from "./types/BrandStaffAssign";
import { ChangeStaffPassword, ChangeStaffPasswordVariables } from "./types/ChangeStaffPassword";
import { StaffAvatarDelete } from "./types/StaffAvatarDelete";
import { StaffAvatarUpdate, StaffAvatarUpdateVariables } from "./types/StaffAvatarUpdate";
import { StaffMemberAdd, StaffMemberAddVariables } from "./types/StaffMemberAdd";
import { StaffMemberDelete, StaffMemberDeleteVariables } from "./types/StaffMemberDelete";
import { StaffMemberUpdate, StaffMemberUpdateVariables } from "./types/StaffMemberUpdate";

const staffMemberAddMutation = gql`
  ${staffErrorFragment}
  ${staffMemberDetailsFragment}
  mutation StaffMemberAdd($input: StaffCreateInput!) {
    staffCreate(input: $input) {
      errors: staffErrors {
        ...StaffErrorFragment
      }
      user {
        ...StaffMemberDetailsFragment
      }
    }
  }
`;

export const useStaffMemberAdd = makeMutation<StaffMemberAdd, StaffMemberAddVariables>(staffMemberAddMutation);

const staffMemberUpdateMutation = gql`
  ${staffErrorFragment}
  ${staffMemberDetailsFragment}
  mutation StaffMemberUpdate($id: ID!, $input: StaffUpdateInput!) {
    staffUpdate(id: $id, input: $input) {
      errors: staffErrors {
        ...StaffErrorFragment
      }
      user {
        ...StaffMemberDetailsFragment
      }
    }
  }
`;

export const useStaffMemberUpdate = makeMutation<StaffMemberUpdate, StaffMemberUpdateVariables>(
  staffMemberUpdateMutation
);

const accountUpdateMutation = gql`
  ${accountErrorFragment}
  ${fragmentUser}
  mutation AccountUpdate($input: AccountInput!) {
    accountUpdate(input: $input) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      user {
        ...User
      }
    }
  }
`;

export const useAccountUpdate = makeMutation<AccountUpdate, AccountUpdateVariables>(accountUpdateMutation);

const staffMemberDeleteMutation = gql`
  ${staffErrorFragment}
  mutation StaffMemberDelete($id: ID!) {
    staffDelete(id: $id) {
      errors: staffErrors {
        ...StaffErrorFragment
      }
    }
  }
`;

export const useStaffMemberDelete = makeMutation<StaffMemberDelete, StaffMemberDeleteVariables>(
  staffMemberDeleteMutation
);

const staffAvatarUpdateMutation = gql`
  ${accountErrorFragment}
  mutation StaffAvatarUpdate($image: Upload!) {
    userAvatarUpdate(image: $image) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      user {
        id
        avatar {
          url
        }
      }
    }
  }
`;

export const useStaffAvatarUpdate = makeMutation<StaffAvatarUpdate, StaffAvatarUpdateVariables>(
  staffAvatarUpdateMutation
);

const staffAvatarDeleteMutation = gql`
  ${accountErrorFragment}
  mutation StaffAvatarDelete {
    userAvatarDelete {
      errors: accountErrors {
        ...AccountErrorFragment
      }
      user {
        id
        avatar {
          url
        }
      }
    }
  }
`;

export const useStaffAvatarDelete = makeMutation<StaffAvatarDelete, StaffMemberDeleteVariables>(
  staffAvatarDeleteMutation
);

const changeStaffPassword = gql`
  ${accountErrorFragment}
  mutation ChangeStaffPassword($newPassword: String!, $oldPassword: String!) {
    passwordChange(newPassword: $newPassword, oldPassword: $oldPassword) {
      errors: accountErrors {
        ...AccountErrorFragment
      }
    }
  }
`;
export const useChangeStaffPassword = makeMutation<ChangeStaffPassword, ChangeStaffPasswordVariables>(
  changeStaffPassword
);

export const brandStaffAssign = gql`
  mutation BrandStaffAssign($brandId: ID!, $staffId: ID!) {
    brandStaffAssign(brandId: $brandId, staffId: $staffId) {
      brand {
        id
        name
        staff {
          id
          firstName
          aligoPhone
        }
      }
      accountErrors {
        field
        message
        code
      }
    }
  }
`;

export const useBrandStaffAssign = makeMutation<BrandStaffAssign, BrandStaffAssignVariables>(brandStaffAssign);

export const accountSwitchBrandUpdateMutation = gql`
  ${accountErrorFragment}
  mutation AccountSwitchBrandUpdate($input: AccountSwitchBrandUpdateInput!) {
    accountSwitchBrandUpdate(input: $input) {
      errors: accountErrors {
        ...AccountErrorFragment
        __typename
      }
      __typename
    }
  }
`;

export const useAccountSwitchBrandUpdateMutation = makeMutation<
  AccountSwitchBrandUpdate,
  AccountSwitchBrandUpdateVariables
>(accountSwitchBrandUpdateMutation);
