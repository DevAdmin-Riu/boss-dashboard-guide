import { OrderLineBoxSize, OrderLineUpdateBoxSizeInput } from "@src/api/types/globalTypes";
import { useOrderLineUpdateBoxSizeMutation } from "@src/app/views/order/orders/api/mutations";
import { showNotificationSuccess } from "@utils/notification/wrapper";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { Form, Modal, Select } from "antd";
import React, { useEffect } from "react";

import { boxSizeSelectOptions } from "../OrderDeliveryListPage/settings";
import { getBoxSizeLabelAndFormValue } from "../OrderDeliveryListPage/utils";

interface OrderLineBoxSizeUpdateModalProps {
  open: boolean;
  orderLineId: string;
  orderLineBoxSize: OrderLineBoxSize | null;
  onClose: () => any;
}

const OrderLineBoxSizeUpdateModal: React.FC<OrderLineBoxSizeUpdateModalProps> = ({
  open,
  orderLineId,
  orderLineBoxSize,
  onClose,
}) => {
  const [form] = Form.useForm<OrderLineUpdateBoxSizeInput>();

  const initialValues: OrderLineUpdateBoxSizeInput = {
    boxSize: getBoxSizeLabelAndFormValue(orderLineBoxSize)?.formValue,
  };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [orderLineUpdateBoxSize, orderLineUpdateBoxSizeOpts] = useOrderLineUpdateBoxSizeMutation({
    onCompleted: (data) => {
      if (data) {
        const errors = data.orderLineUpdateBoxSize.errors;
        if (errors.length === 0) {
          showNotificationSuccess("박스 사이즈를 변경했습니다");
          onClose();
        } else {
          showGqlErrors(errors, makeGqlErrorMsg);
        }
      }
    },
  });

  const selectOptions = boxSizeSelectOptions.map((item) => ({
    value: getBoxSizeLabelAndFormValue(item).formValue,
    label: getBoxSizeLabelAndFormValue(item)?.label,
  }));

  const onSubmit = (formData: OrderLineUpdateBoxSizeInput) => {
    const { boxSize } = formData;
    orderLineUpdateBoxSize({ variables: { id: orderLineId, input: { boxSize } } });
  };

  return (
    <Modal
      forceRender
      destroyOnClose
      title="박스 사이즈 변경"
      open={open}
      okButtonProps={{ loading: orderLineUpdateBoxSizeOpts.loading }}
      onOk={form.submit}
      onCancel={onClose}
    >
      <Form initialValues={initialValues} validateTrigger="onSubmit" form={form} onFinish={onSubmit}>
        <Form.Item name="boxSize" rules={[{ required: true }]}>
          <Select style={{ width: "100%" }} options={selectOptions} />
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default OrderLineBoxSizeUpdateModal;
</file>

<file path="src/app/views/order/orders/components/OrderLineDetailListPage/filters.ts">
import { OrderChargeStatusFilter, OrderPayMethodFilter, OrderType, OrderTypeEnum } from "@src/api/types/globalTypes";
import { columnNameConstant, filterNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { IFilter } from "@src/app/components/Filter";
import filterMsg from "@src/global/assets/messages/filters";
import { FilterOpts, MinMax } from "@src/global/core/types/types";
import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";
import { utils } from "@utils/utils";

export enum OrderLineDetailFilterKeys {
  orderCreated = "orderCreated",
  orderSearch = "orderSearch",
  userSearch = "userSearch",
  productSearch = "productSearch",
  brandSearch = "brandSearch",
  brandStoreSearch = "brandStoreSearch",
  chargeStatus = "chargeStatus",
  payMethod = "payMethod",
  type = "type",
  isTrackInventoryFulfillment = "isTrackInventoryFulfillment",
  excludeStockAvgStats = "excludeStockAvgStats",
}

export interface OrderLineDetailListFilterOpts {
  orderCreated: FilterOpts<MinMax>;
  orderSearch: FilterOpts<string>;
  userSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  brandSearch: FilterOpts<string>;
  brandStoreSearch: FilterOpts<string>;
  chargeStatus: FilterOpts<OrderChargeStatusFilter[]>;
  payMethod: FilterOpts<OrderPayMethodFilter[]>;
  type: FilterOpts<OrderTypeEnum[]>;
  isTrackInventoryFulfillment: FilterOpts<boolean>;
  excludeStockAvgStats: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: OrderLineDetailListFilterOpts,
  orderType: OrderType,
  isAll: boolean
): IFilter<OrderLineDetailFilterKeys> {
  const orderCreatedFilter = {
    ...createDateField(0, OrderLineDetailFilterKeys.orderCreated, filterMsg.orderCreated, opts.orderCreated.value),
    active: opts.orderCreated.active,
  };
  const orderSearchFilter = {
    ...createTextField(
      0,
      OrderLineDetailFilterKeys.orderSearch,
      "주문번호 / 주문상세번호",
      opts.orderSearch.value,
      "주문(상세)번호에 사용되는 접두사까지 붙여서 검색해 주세요."
    ),
    active: opts.orderSearch.active,
  };
  const userSearchFilter = {
    ...createTextField(0, OrderLineDetailFilterKeys.userSearch, "ID / 사용자명", opts.userSearch.value),
    active: opts.userSearch.active,
  };
  const productSearchFilter = {
    ...createTextField(
      0,
      OrderLineDetailFilterKeys.productSearch,
      filterNameConstant.PRODUCT_SEARCH,
      opts.productSearch.value
    ),
    active: opts.productSearch.active,
  };
  const brandSearchFilter = {
    ...createTextField(0, OrderLineDetailFilterKeys.brandSearch, "브랜드코드 / 브랜드명", opts.brandSearch.value),
    active: opts.brandSearch.active,
  };
  const brandStoreSearchFilter = {
    ...createTextField(0, OrderLineDetailFilterKeys.brandStoreSearch, "매장코드 / 매장명", opts.brandStoreSearch.value),
    active: opts.brandStoreSearch.active,
  };
  const chargeStatusFilter = {
    ...createOptionsField(0, OrderLineDetailFilterKeys.chargeStatus, "결제 상태", opts.chargeStatus.value, true, [
      {
        label: "결제 대기",
        value: OrderChargeStatusFilter.PENDING,
      },
      {
        label: "결제 완료",
        value: OrderChargeStatusFilter.CHARGED,
      },
      {
        label: "일부 환불",
        value: OrderChargeStatusFilter.PARTIALLY_REFUNDED,
      },
      {
        label: "전액 환불",
        value: OrderChargeStatusFilter.FULLY_REFUNDED,
      },
    ]),
    active: opts.chargeStatus.active,
    smColSpan: 8,
  };
  const orderTypeFilter = {
    ...createOptionsField(0, OrderLineDetailFilterKeys.type, "주문 방식", opts.type.value, true, [
      {
        label: "일반",
        value: OrderTypeEnum.BY_USER,
      },
      {
        label: "대행",
        value: OrderTypeEnum.BY_STAFF_FOR_BRAND,
      },
      {
        label: "오픈몰",
        value: OrderTypeEnum.BY_STAFF_FOR_BAD_STOCK,
      },
      {
        label: "기타배송",
        value: OrderTypeEnum.BY_STAFF_FOR_ETC,
      },
    ]),
    active: opts.type.active,
  };
  const payMethodFilter = {
    ...createOptionsField(0, OrderLineDetailFilterKeys.payMethod, "결제방식", opts.payMethod.value, true, [
      {
        label: "카드 (보스페이)",
        value: OrderPayMethodFilter.IS_TOSS_RIU_CARD_PAY,
      },
      {
        label: "카드 (일반)",
        value: OrderPayMethodFilter.IS_NORMAL_CARD_PAY,
      },
      {
        label: "가상계좌",
        value: OrderPayMethodFilter.IS_VBANK_PAY,
      },
      {
        label: "충전금",
        value: OrderPayMethodFilter.IS_CREDITS_PAY,
      },
      {
        label: "포인트",
        value: OrderPayMethodFilter.IS_RCOIN_PAY,
      },
    ]),
    active: opts.payMethod.active,
  };

  const isTrackInventoryFulfillmentFilter = {
    ...createBooleanField(
      0,
      OrderLineDetailFilterKeys.isTrackInventoryFulfillment,
      columnNameConstant.order.FULFILLMENT_TYPE,
      opts.isTrackInventoryFulfillment.value,
      {
        positive: "보관",
        negative: "위탁",
      }
    ),
    active: opts.isTrackInventoryFulfillment.active,
  };
  const excludeStockAvgStatsFilter = {
    ...createBooleanField(
      0,
      OrderLineDetailFilterKeys.excludeStockAvgStats,
      columnNameConstant.order.EXCLUDE_STOCK_AVG_STATS,
      opts.excludeStockAvgStats.value,
      {
        positive: "제외",
        negative: "포함",
      }
    ),
    active: opts.excludeStockAvgStats.active,
  };

  let filterStructure = [];
  switch (orderType) {
    case OrderType.BY_USER:
      if (isAll) {
        filterStructure = [
          orderCreatedFilter,
          orderSearchFilter,
          userSearchFilter,
          productSearchFilter,
          brandSearchFilter,
          brandStoreSearchFilter,
          orderTypeFilter,
          chargeStatusFilter,
          payMethodFilter,
          isTrackInventoryFulfillmentFilter,
          excludeStockAvgStatsFilter,
        ];
        break;
      } else {
        filterStructure = [
          orderCreatedFilter,
          orderSearchFilter,
          userSearchFilter,
          brandSearchFilter,
          brandStoreSearchFilter,
          productSearchFilter,
          chargeStatusFilter,
          payMethodFilter,
        ];
        break;
      }
    case OrderType.BY_STAFF_FOR_BRAND:
      filterStructure = [
        orderCreatedFilter,
        orderSearchFilter,
        userSearchFilter,
        brandSearchFilter,
        brandStoreSearchFilter,
        productSearchFilter,
        chargeStatusFilter,
      ];
      break;
    case OrderType.BY_STAFF_FOR_BAD_STOCK: {
      filterStructure = [orderCreatedFilter, orderSearchFilter, productSearchFilter, chargeStatusFilter];
      break;
    }
    case OrderType.BY_STAFF_FOR_ETC: {
      filterStructure = [orderCreatedFilter, orderSearchFilter, productSearchFilter];
      break;
    }
    default:
      break;
  }
  return utils.filterDisplayOrdering(filterStructure.filter(Boolean));
}
