import { ApolloQueryResult } from "@apollo/client";
import { sectionNames } from "@assets/messages/sectionNames";
import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { PatchedColumnsTable } from "@src/app/components/antd/Table/PatchedColumnsTable";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import SpreadFilterBar, { DownloadRelatedProps } from "@src/app/components/FilterBar/SpreadFilterBar";
import TableListFooter from "@src/app/components/TableListFooter";
import { FilterPageProps, PaginateListProps } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Card, Col, Row, Space, Typography } from "antd";
import React from "react";

import { FulfillmentList, FulfillmentListVariables } from "../../../../order/orders/api/types/FulfillmentList";
import { DeliveryListTableDataType } from "../../../../order/orders/components/OrderDeliveryListPage/OrderDeliveryListTableSettings";
import { createFilterStructure, HqOrderDeliveryFilterKeys, HqOrderDeliveryListFilterOpts } from "./filters";
import { getHqOrderDeliveryListColumns } from "./HqOrderDeliveryListTableSettings";

export interface HqOrderDeliveryListPageProps
  extends PaginateListProps,
    FilterPageProps<HqOrderDeliveryFilterKeys, HqOrderDeliveryListFilterOpts> {
  deliveryList: DeliveryListTableDataType[];
  queryVariablesWithoutPagination: FulfillmentListVariables;
  fetchForDownload: (variables?: FulfillmentListVariables) => Promise<ApolloQueryResult<FulfillmentList>>;
}

const HqOrderDeliveryListPage: React.FC<HqOrderDeliveryListPageProps> = (props) => {
  const {
    currentTab,
    filterOpts,
    tabs,
    deliveryList,
    onAll,
    onFilterChange,
    onTabChange,
    onTabDelete,
    onTabSave,
    queryVariablesWithoutPagination,
    fetchForDownload,
    ...listProps
  } = props;

  const filterStructure = createFilterStructure(filterOpts);
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns = getHqOrderDeliveryListColumns();
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const excelDownloadProps: DownloadRelatedProps = {
    fetchForDownload,
    queryVariablesWithoutPagination,
    columnsForDownload: columns,
    dataKey: "fulfillments",
  };

  return (
    <Space direction="vertical" size={24}>
      <Row justify="space-between">
        <Col>
          <Typography.Title level={4}>{sectionNames.deliveryAll}</Typography.Title>
        </Col>
      </Row>

      <Card>
        <SpreadFilterBar
          filterStructure={filterStructure}
          currentTab={currentTab}
          onAll={onAll}
          onFilterChange={onFilterChange}
          onTabChange={onTabChange}
          onTabDelete={onTabDelete}
          onTabSave={onTabSave}
          tabs={tabs}
          isDownloadable={true}
          excelDownloadProps={excelDownloadProps}
        />
        <PatchedColumnsTable
          {...commonTableProps}
          ref={tableRef}
          scroll={{ x: tableWidthSum, y: tableScrollY }}
          dataSource={deliveryList}
          columns={columns}
          loading={listProps.disabled}
          rowKey={(row) => row.id}
          footer={() => <TableListFooter {...listProps} />}
        />
      </Card>
    </Space>
  );
};

export default HqOrderDeliveryListPage;
</file>

