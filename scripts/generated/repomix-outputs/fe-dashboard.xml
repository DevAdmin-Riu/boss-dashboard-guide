<file path="src/app/views/question/components/CustomerRefundQuestionInspectTable/utils.ts">
import { RefundQAQReasonType, RefundQAStatus } from "@src/api/types/globalTypes";
import { ShopInfo_shop_refundReasonChoices } from "@src/app/providers/ShopProvider/types/ShopInfo";

export const fromObjToArr = (obj) => Object.values(obj);

export const valueFindCheck = (arr, findValue) => arr.find((item) => item.value === findValue);

export const transformRefundReason = (
  refundReasonChoices: ShopInfo_shop_refundReasonChoices[],
  qReasonType: RefundQAQReasonType
) => {
  const refundReasonChoicesArray = fromObjToArr(refundReasonChoices);
  const foundItem = valueFindCheck(refundReasonChoicesArray, qReasonType);
  return foundItem ? foundItem.label : "-";
};

export const isInspect = (status, productReturnedAt) =>
  status === RefundQAStatus.COLLECTED_INSPECT && productReturnedAt === null;
</file>

