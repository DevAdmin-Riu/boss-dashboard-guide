import { createBooleanField, createDateField, createOptionsField, createTextField } from "@utils/filters/fields";

export enum SalesStatByProductDiffFilterKeys {
  statDateA = "statDateA",
  statDateB = "statDateB",
  brandSearch = "brandSearch",
  vendorSearch = "vendorSearch",
  productSearch = "productSearch",
  categoryKind = "categoryKind",
  salesStatus = "salesStatus",
  isExclusive = "isExclusive",
  trackInventory = "trackInventory",
  isInner = "isInner",
}

export interface SalesStatByProductDiffListFilterOpts {
  statDateA: FilterOpts<MinMax>;
  statDateB: FilterOpts<MinMax>;
  brandSearch: FilterOpts<string>;
  vendorSearch: FilterOpts<string>;
  productSearch: FilterOpts<string>;
  categoryKind: FilterOpts<ProductCategoryKind[]>;
  salesStatus: FilterOpts<SalesStatusEnum[]>;
  isExclusive: FilterOpts<boolean>;
  trackInventory: FilterOpts<boolean>;
  isInner: FilterOpts<boolean>;
}

export function createFilterStructure(
  opts: SalesStatByProductDiffListFilterOpts
): IFilter<SalesStatByProductDiffFilterKeys> {
  let displayOrder = 0;
  return [
    {
      ...createDateField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.statDateA,
        "기준 기간(A)",
        opts.statDateA.value
      ),
      active: opts.statDateA.active,
      isRequired: true,
    },
    {
      ...createDateField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.statDateB,
        "비교 기간(B)",
        opts.statDateB.value
      ),
      active: opts.statDateB.active,
      isRequired: true,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.brandSearch,
        "브랜드코드 / 브랜드명",
        opts.brandSearch.value
      ),
      active: opts.brandSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.vendorSearch,
        "협력사코드 / 협력사명",
        opts.vendorSearch.value
      ),
      active: opts.vendorSearch.active,
    },
    {
      ...createTextField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.productSearch,
        filterNameConstant.PRODUCT_SEARCH,
        opts.productSearch.value
      ),
      active: opts.productSearch.active,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.categoryKind,
        "제품 구분",
        opts.categoryKind.value,
        true,
        productCategoryKindChoicesForSalesStatFilter
      ),
      active: opts.categoryKind.active,
      isRequired: true,
    },
    {
      ...createOptionsField(
        displayOrder++,
        SalesStatByProductDiffFilterKeys.salesStatus,
        "제품 상태",
        opts.salesStatus.value,
        true,
        [
          { label: "판매대기", value: SalesStatusEnum.PENDING },
          { label: "정상", value: SalesStatusEnum.ON_SALE },
          { label: "단종예정", value: SalesStatusEnum.WILL_BE_STOPPED },
          { label: "단종", value: SalesStatusEnum.STOPPED },
        ]
      ),
      active: opts.salesStatus.active,
