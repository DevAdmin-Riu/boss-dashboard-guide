  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open, selectedQuestion]);

  const [customerQAReplyCreate, customerQAReplyCreateOpts] = useCustomerQAReplyCreateMutation({
    onCompleted: (res) =>
      utils.handleOnCompletedWithError(res.customerQAReplyCreate.errors, "답변 작성이 완료되었습니다.", () => {
        onClose();
      }),
  });

  const [customerQAReplyUpdate, customerQAReplyUpdateOpts] = useCustomerQAReplyUpdateMutation({
    onCompleted: (res) =>
      utils.handleOnCompletedWithError(res.customerQAReplyUpdate.errors, "답변이 수정되었습니다.", () => {
        onClose();
      }),
  });

  const mutationLoading = customerQAReplyCreateOpts.loading || customerQAReplyUpdateOpts.loading;

  const onFinish = (formData: CustomerQAReplyInput) => {
    if (selectedQuestion.isAnswered) {
      customerQAReplyUpdate({ variables: { id: selectedQuestion.id, input: formData } });
    } else {
      customerQAReplyCreate({ variables: { id: selectedQuestion.id, input: formData } });
    }
  };

  if (utils.isEmpty(selectedQuestion)) {
    return <></>;
  }

  const qContent = selectedQuestion.qContent;
  const isAnswered = selectedQuestion.isAnswered;
  const qTitle = selectedQuestion.qTitle;

  const getModalTitle = () => {
    switch (selectedQuestion.qType) {
      case CustomerQATypeEnum.SUGGEST_SYSTEM:
        return sectionNames.customerQa.suggestSystem;
      case CustomerQATypeEnum.BOSS_QA:
        return sectionNames.customerQa.bossQa;
      default:
        return "문의";
    }
  };

  const paragrahStyle: CSSProperties = {
    minHeight: "15em",
    maxHeight: "15em",
    overflow: "auto",
    lineHeight: "1.5",
    whiteSpace: "pre-wrap",
    border: "1px solid #d9d9d9",
    padding: "8px",
  };

  return (
    <Form
      disabled={mutationLoading}
      form={form}
      initialValues={initialValues}
      onFinish={onFinish}
      validateMessages={{ required: formRuleMsg.required }}
    >
      <Modal
        forceRender
        destroyOnClose
        open={open}
        closable={false}
        maskClosable={false}
        onOk={form.submit}
        onCancel={onClose}
        title={getModalTitle()}
        confirmLoading={mutationLoading}
        width={750}
        footer={
          <FormSaveButton
            isEditMode
            form={form}
            onEdit={null}
            onCancel={onClose}
            buttonText={{
              save: isAnswered ? "답변수정" : "답변하기",
            }}
          />
        }
      >
        <Space direction="vertical">
          <Row justify="space-between">
            <Col>
              <Space>
                {makeIsAnsweredTag(isAnswered)}
                <Typography.Text strong>{qTitle}</Typography.Text>
              </Space>
            </Col>
            <Col>
              <Typography.Text>{getDateByFormat(selectedQuestion.qCreatedAt, onlyDateFormat)}</Typography.Text>
            </Col>
          </Row>
          <Typography.Paragraph style={paragrahStyle}>{qContent}</Typography.Paragraph>
        </Space>
        <Divider style={{ margin: "12px 0" }} />
        <Space direction="vertical">
          {isAnswered ? (
            <Row justify="space-between">
              <Col>
                <Typography.Text strong>답변</Typography.Text>
              </Col>
              <Col>
                <Typography.Text>{getDateByFormat(selectedQuestion.aCreatedAt, onlyDateFormat)}</Typography.Text>
              </Col>
            </Row>
          ) : (
            <Typography.Text strong>답변</Typography.Text>
          )}
          <Form.Item name={TypeSafeForm.getValidDataIndex("aContent")} rules={[{ required: true }]}>
            <Input.TextArea rows={10} placeholder="답변을 입력하세요." />
          </Form.Item>
        </Space>
      </Modal>
    </Form>
  );
};

export default CustomerQaFormModal;
</file>

