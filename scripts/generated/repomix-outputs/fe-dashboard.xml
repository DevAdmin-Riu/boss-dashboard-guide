import useNavigator from "@hooks/useNavigator";
import useUser from "@hooks/useUser";
import { RequestOriginTypeEnum } from "@src/api/types/globalTypes";
import { makeGqlErrorMsg, showGqlErrors } from "@utils/notification/wrapperGql";
import { parse as parseQs } from "qs";
import React from "react";
import { RouteComponentProps } from "react-router";

import { useSetPasswordMutation } from "../api/mutations";
import { SetPassword, SetPasswordVariables } from "../api/types/SetPassword";
import { NewPasswordByEmailPage, NewPasswordByEmailPageFormData } from "../components/NewPasswordByEmailPage";
import { NewPasswordViewUrlQueryParams } from "../urls";

export const NewPasswordByEmailView: React.FC<RouteComponentProps> = ({ location }) => {
  const navigate = useNavigator();
  const { loginByToken } = useUser();
  // @ts-ignore
  const params: NewPasswordViewUrlQueryParams = parseQs(location.search.substr(1));

  const handleSetPassword = async (data: SetPassword) => {
    const errors = data.setPassword.errors;
    if (errors.length === 0) {
      loginByToken(data.setPassword.token, data.setPassword.csrfToken, data.setPassword.user);
      navigate("/", true);
    } else {
      showGqlErrors(errors, makeGqlErrorMsg);
    }
  };

  const [setPassword, setPasswordOpts] = useSetPasswordMutation({
    onCompleted: handleSetPassword,
  });

  const handleSubmit = (data: NewPasswordByEmailPageFormData) => {
    const setPasswordInput: SetPasswordVariables = {
      loginId: params.loginId,
      password: data.password,
      requestOrigin: RequestOriginTypeEnum.DASHBOARD,
      token: params.token,
    };
    setPassword({
      variables: setPasswordInput,
    });
  };

  return (
    <NewPasswordByEmailPage
      errors={setPasswordOpts.data?.setPassword.errors || []}
      disabled={setPasswordOpts.loading}
      onSubmit={handleSubmit}
    />
  );
};
</file>

