<file path="src/app/views/hqStaff/hqSection/components/ScheduleCreateOrUpdateModal.tsx">
import { formRuleMsg } from "@assets/messages/commonMsg";
import useUser from "@hooks/useUser";
import { SearchHqStaffs_search_edges_node } from "@src/api/searches/types/SearchHqStaffs";
import { RepeatAnchorTypeEnum, RepeatTypeEnum, ScheduleInput } from "@src/api/types/globalTypes";
import { getTypeSafeForm } from "@src/app/components/antd/Form/utils";
import { getInputNumberProps } from "@src/app/components/antd/InputNumber/InputNumberProps";
import {
  detailDateFormatWithHourMinute,
  extractHourMinuteFormat,
  onlyDateFormat,
} from "@src/app/providers/DateProvider";
import { FetchMoreProps, StrictOmit } from "@src/global/core/types/types";
import { findValueInEnum, maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Checkbox, Col, DatePicker, Form, Input, InputNumber, Modal, Radio, Row, Select, Space } from "antd";
import moment, { Moment } from "moment";
import React, { useEffect } from "react";

import { HqScheduleList_schedules_edges_node } from "../api/types/HqScheduleList";
import { checkIsScheduleWriter, scheduleRepeatTypeChoices } from "../utils";
import { checkIsAllDaySchedule } from "./HqScheduleListPage/utils";

export interface ScheduleForm extends StrictOmit<ScheduleInput, "alarmOffsetMinutes"> {
  isAllDay: boolean;
  alarmOffsetTime: {
    hour: number | null;
    minute: number | null;
  };
}

const convertAlarmOffsetMinutesToFormValue = (alarmOffsetMinutes: number | null): ScheduleForm["alarmOffsetTime"] => {
  if (utils.isEmpty(alarmOffsetMinutes, true)) {
    return { hour: null, minute: null };
  }
  const hour = Math.floor(alarmOffsetMinutes / 60);
  const minute = alarmOffsetMinutes % 60;
  return { hour, minute };
};

interface ScheduleCreateOrUpdateModalProps {
  open: boolean;
  isUpdateMode: boolean;
  loading: boolean;
  onSubmit: (formData: ScheduleForm) => void;
  onDelete?: () => void;
  onClose: () => void;

  // create 시에 전달
  selectedDate?: Moment;
  // update 시에 전달
  selectedSchedule?: HqScheduleList_schedules_edges_node;

  hqStaffList: SearchHqStaffs_search_edges_node[];
  fetchMoreHqStaffs: FetchMoreProps;
  searchHqStaffs: (query: string) => void;
}

export const ScheduleCreateOrUpdateModal: React.FC<ScheduleCreateOrUpdateModalProps> = (props) => {
  const {
    open,
    isUpdateMode,
    loading,
    selectedDate,
    selectedSchedule,
    onSubmit,
    onDelete,
    onClose,
    hqStaffList,
    fetchMoreHqStaffs,
    searchHqStaffs,
  } = props;
  const { user } = useUser();
  const [form] = Form.useForm<ScheduleForm>();
  const TypeSafeForm = getTypeSafeForm<ScheduleForm>(form);

  const touched = true;
  const isScheduleWriter = checkIsScheduleWriter(selectedSchedule, user);
  const formDisabled = isUpdateMode ? !isScheduleWriter : false;

  const startWatched: Moment = TypeSafeForm.getUseFormWatched({ name: "start" });
  const endWatched: Moment = TypeSafeForm.getUseFormWatched({ name: "end" });
  const isAllDayWatched = TypeSafeForm.getUseFormWatched({ name: "isAllDay" });
  const repeatTypeWatched = TypeSafeForm.getUseFormWatched({ name: "repeatType" });
  const hasAlarmWatched = TypeSafeForm.getUseFormWatched({ name: "hasAlarm" });
  const alarmOffsetWatched = TypeSafeForm.getUseFormWatched({ name: "alarmOffsetTime" });

  const getAddonAfterByRepeatType = () => {
    switch (repeatTypeWatched) {
      case RepeatTypeEnum.DAILY:
        return "일마다";
      case RepeatTypeEnum.WEEKLY:
        return "주마다";
      case RepeatTypeEnum.MONTHLY:
        return "월마다";
      case RepeatTypeEnum.YEARLY:
        return "년마다";
      default:
        return null;
    }
  };

  // 필수 input이므로 start, end는 항상 존재하는 값이지만, repeatUntil은 선택적이므로 값이 없는 경우 null로 처리 필요
  const initialValues: ScheduleForm = isUpdateMode
    ? {
        ...selectedSchedule,
        start: moment(selectedSchedule.start),
        end: moment(selectedSchedule.end),
        isAllDay: checkIsAllDaySchedule(selectedSchedule),
        repeatType: findValueInEnum(selectedSchedule.repeatType, RepeatTypeEnum),
        repeatUntil: utils.isEmpty(selectedSchedule.repeatUntil) ? null : moment(selectedSchedule.repeatUntil),
        repeatAnchorType: findValueInEnum(selectedSchedule.repeatAnchorType, RepeatAnchorTypeEnum),
        alarmOffsetTime: convertAlarmOffsetMinutesToFormValue(selectedSchedule.alarmOffsetMinutes),
        participants: selectedSchedule.participants.map((p) => p.id),
      }
    : {
        start: utils.isEmpty(selectedDate)
          ? moment()
          : selectedDate.clone().set({
              hour: moment().hour() + 1,
              minute: 0,
              second: 0,
              millisecond: 0,
            }),
        end: utils.isEmpty(selectedDate)
          ? moment()
          : selectedDate.clone().set({
              hour: moment().hour() + 2,
              minute: 0,
              second: 0,
              millisecond: 0,
            }),
        isAllDay: false,
        title: null,
        description: null,
        repeatType: RepeatTypeEnum.NONE,
        repeatInterval: null,
        repeatUntil: null,
        repeatAnchorType: RepeatAnchorTypeEnum.NONE,
        hasAlarm: false,
        alarmOffsetTime: { hour: null, minute: null },
        participants: [],
      };

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const hqStaffsOptions = maybe(
    () =>
      hqStaffList.map((staff) => ({
        label: `${staff.firstName}(${staff.loginId})`,
        value: staff.id,
      })),
    []
  );

  return (
    <Form
      form={form}
      disabled={formDisabled}
      initialValues={initialValues}
      labelCol={{ span: 4 }}
      wrapperCol={{ span: 20 }}
      onFinish={onSubmit}
    >
      <Modal
        forceRender
        destroyOnClose
        closable={false}
        width={600}
        open={open}
        title={isUpdateMode ? "일정 상세" : "일정 등록"}
        footer={
          <Form.Item noStyle shouldUpdate>
            {() => (
              <Space>
                <Button type="default" disabled={false} onClick={onClose}>
                  닫기
                </Button>
                {!!onDelete && (
                  <Button danger type="primary" loading={loading} disabled={!isScheduleWriter} onClick={onDelete}>
                    삭제
                  </Button>
                )}
                <Button type="primary" loading={loading} disabled={!form.isFieldsTouched()} onClick={form.submit}>
                  {isUpdateMode ? "수정" : "등록"}
                </Button>
              </Space>
            )}
          </Form.Item>
        }
        maskClosable={false}
