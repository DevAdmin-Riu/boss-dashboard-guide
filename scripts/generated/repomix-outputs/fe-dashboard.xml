import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { makePublishedForBsNode } from "@src/app/components/VisibilityCard";
import { DateTime } from "@src/app/providers/DateProvider/DateTime";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Tag, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { FromBossNotices_fromBossNotices_edges_node } from "../../api/types/FromBossNotices";
import { HqToUserNoticeListPageProps } from "./BossToUserNoticeListPage";

export const getToUserNoticeListTableSettings = (props: HqToUserNoticeListPageProps) => {
  const { user, onRowClick, onKakaoClick } = props;
  const isStaff = user.isStaff;

  const handleSendKakao = (
    event: React.MouseEvent<HTMLElement, MouseEvent>,
    notice: FromBossNotices_fromBossNotices_edges_node
  ) => {
    event.stopPropagation();
    onKakaoClick(notice);
  };

  const columns: ColumnsType<FromBossNotices_fromBossNotices_edges_node> = [
    {
      title: columnNameConstant.common.TITLE,
      key: "title",
      align: "left",
      width: 200,
      render: (_, record) =>
        !!onRowClick ? (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.title || "-"}</Typography.Link>
        ) : (
          record.title || "-"
        ),
    },
    {
      title: columnNameConstant.common.REGISTERED_DATE,
      key: "createdAt",
      align: "center",
      width: 120,
      render: (_, record) => (record.createdAt ? <DateTime date={record.createdAt} /> : "-"),
    },
    {
      title: columnNameConstant.common.IS_PUBLISHED_FOR_BS,
      key: "isPublishedForBs",
      align: "center",
      width: 140,
      render: (_, record) => makePublishedForBsNode(record),
    },
  ];

  // 관리자로 접근한 경우 - 작성자 소속, 작성자(ID), 게시 브랜드 표시
  if (isStaff) {
    columns.push(
      {
        title: "작성자 소속",
        key: "author",
        align: "center",
        width: 100,
        render: (_, record) => (record.writer.isStaff ? "리우" : "가맹본부"),
      },
      {
        title: "작성자(ID)",
        key: "author",
        align: "center",
        width: 120,
        render: (_, record) => maybe(() => `${record.writer.firstName}(${record.writer.loginId})`, "-"),
      }
    );
  }
  if (isStaff) {
    columns.push({
      title: "게시 브랜드",
      align: "center",
      key: "availableBrands",
      width: 300,
      render: (_, record) => {
        if (record.availableToAllBrands) {
          return <Tag>전체 브랜드 게시</Tag>;
        }
        const availableBrandNames = record.availableBrands.map((brand) => brand.name);
        return utils.summarizeArray(availableBrandNames, 3, "브랜드");
      },
    });
  }

  if (!!onKakaoClick) {
    columns.push({
      title: "알림톡 전송",
      key: "kakaotalk",
      align: "center",
      width: 100,
      render: (_, record) => (
        <Button
          block
          size="small"
          type="primary"
          disabled={!record?.isPublished}
          onClick={(event) => handleSendKakao(event, record)}
        >
          전송
        </Button>
      ),
    });
  }

  return columns;
};
</file>

