import ConfirmModal from "@src/app/components/ConfirmModal";
import {
  getUniqueRackLocationsByRackStocks,
  makeRackLocationLabel,
} from "@src/app/views/product/stock/components/ProductInfoForStockAction";
import { buttonText } from "@src/global/assets/messages/buttonText";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Form, Modal, Radio, Select, Space, Typography } from "antd";
import { DefaultOptionType } from "antd/lib/select";
import React, { useEffect, useState } from "react";

import { OrderDetails_order_fulfillments } from "../api/types/OrderDetails";

export interface FulfillmentCancelDialogProps {
  open: boolean;
  disabled: boolean;
  fulfillment: OrderDetails_order_fulfillments;
  warehouses: WarehouseFragment[];
  onConfirm: (formData: FulfillmentCancelInput) => void;
  onClose: () => void;
}

export const FulfillmentCancelDialog: React.FC<FulfillmentCancelDialogProps> = (props) => {
  const { open, disabled, fulfillment, warehouses, onConfirm, onClose } = props;
  const [openConfirmModal, setOpenConfirmModal] = useState<boolean>(false);
  const [form] = Form.useForm();
  const TypeSafeForm = getTypeSafeForm<FulfillmentCancelInput>(form);
  const formInstance = TypeSafeForm.formInstance;
  const isRefundWatcher = TypeSafeForm.getUseWatcherParams({ name: "isRefund" });
  const isRefundWatched = Form.useWatch(isRefundWatcher.namePath, isRefundWatcher.formInstance);

  const rackLocationsAssignedFulfillmentLine =
    fulfillment?.lines
      ?.filter((line) => !utils.isEmpty(line?.stockDetailLines))
      .flatMap((line) => line.stockDetailLines)
      .filter((stockDetail) => !utils.isEmpty(stockDetail?.rackStockDetail?.location))
      .map((stockDetail) => stockDetail?.rackStockDetail?.location) || [];
  const defaultRackLocation =
    rackLocationsAssignedFulfillmentLine.length > 0 ? rackLocationsAssignedFulfillmentLine[0] : null;

  const initialValues: FulfillmentCancelInput = {
    warehouseId: null,
    isRefund: false,
    rackLocation: defaultRackLocation?.id,
  };

  const orderLine = fulfillment?.lines[0]?.orderLine;
  // fulfillment의 모든 lines의 orderLine의 값 중에 decreaseStockFlag가 하나라도 false가 있는지 확인한다.
  const decreaseStockFlag = fulfillment?.lines.some((line) => !line?.orderLine?.decreaseStockFlag);

  const productVariant = orderLine?.variant;
  const isTrackInventoryOrder = !!orderLine?.trackInventory;
  const warehouseRequired = isTrackInventoryOrder;
  const rackLocationRequired = isTrackInventoryOrder;

  const {
    loadMore: loadMoreLocations,
    search: searchLocations,
    result: searchLocationsOpts,
  } = useRackLocationSearch({ skip: !open, variables: DEFAULT_INITIAL_SEARCH_DATA });
  const searchedRackLocations = maybe(() => searchLocationsOpts.data.search.edges.map((edge) => edge.node), []);

  useEffect(() => {
    if (open) {
      formInstance.resetFields();
    }
  }, [open]);

  const radioOptions = [
    { label: "교환", value: false },
    { label: "반품", value: true },
  ];
  const warehouseOptions = isTrackInventoryOrder
    ? warehouses?.map((warehouse) => ({
        label: warehouse.name,
        value: warehouse.id,
      }))
    : [];

  const rackLocationsFromRackStocks = getUniqueRackLocationsByRackStocks(productVariant?.rackStocks || []);
  const rackLocations = [...rackLocationsFromRackStocks, ...searchedRackLocations];
  const locationOptions: DefaultOptionType[] = rackLocations.map((location) => ({
    label: makeRackLocationLabel(location),
    labelText: location.name,
    value: location.id,
  }));

  const fetchMoreData = {
    hasMore: maybe(() => searchLocationsOpts.data.search.pageInfo.hasNextPage),
    loading: searchLocationsOpts.loading,
    onFetchMore: loadMoreLocations,
  };

  const modalTitle = isRefundWatched ? "반품 출고 취소" : "교환 출고 취소";
  const modalMessage = isRefundWatched ? "반품으로 출고 취소하시겠습니까?" : "교환으로 출고 취소하시겠습니까?";
  const decreaseStockFlagMessage = "재고 감소 없는 기타 배송 주문의 경우 재고가 환입되지 않습니다.";

  return (
    <Modal
      forceRender
      destroyOnClose
      open={open}
      title={modalTitle}
      cancelText={buttonText.back}
      okText={buttonText.accept}
      onCancel={onClose}
      onOk={formInstance.submit}
      okButtonProps={{ loading: disabled }}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Form
          form={formInstance}
          initialValues={initialValues}
          name="fulfillment-cancel-form"
          layout="vertical"
          validateTrigger="onChange"
          onFinish={() => setOpenConfirmModal(true)}
        >
          <Form.Item required name="isRefund" label="교환/반품 선택">
            <Radio.Group options={radioOptions} />
          </Form.Item>
          {warehouseRequired && (
            <Form.Item
              required={warehouseRequired}
              name="warehouseId"
              label="물류센터 선택"
              rules={[
                {
                  required: warehouseRequired,
                  message: "재고 운영 제품은 재고를 되돌릴 물류센터를 선택해야 합니다.",
                },
              ]}
            >
              <Select
                style={{ width: "100%" }}
                filterOption={(input, option) =>
                  typeof option?.label === "string" && (option?.label ?? "").toLowerCase().includes(input.toLowerCase())
                }
                placeholder="물류센터 선택"
                options={warehouseOptions}
              />
            </Form.Item>
          )}
          {rackLocationRequired && (
            <Form.Item
              required={rackLocationRequired}
              name="rackLocation"
              label="로케이션 선택"
              rules={[
                {
                  required: rackLocationRequired,
                  message: "재고 운영 제품은 재고를 되돌릴 로케이션을 선택해야 합니다.",
                },
              ]}
            >
              <Select
                showSearch
                style={{ width: "100%" }}
                {...getMobileSelectClassName()}
                placeholder="로케이션 선택"
                notFoundContent="선택 가능한 로케이션이 없습니다."
                loading={fetchMoreData.loading}
                dropdownMatchSelectWidth={false}
                options={locationOptions}
                onSearch={searchLocations}
                onDropdownVisibleChange={(open) => {
                  if (open) {
                    searchLocations("");
                  }
                }}
                filterOption={(input, option) =>
                  typeof option?.labelText === "string" &&
                  (option?.labelText ?? "").toLowerCase().includes(input.toLowerCase())
                }
                onPopupScroll={({ currentTarget }) => {
                  const { scrollHeight, scrollTop, clientHeight } = currentTarget;
                  const { hasMore, loading, onFetchMore } = fetchMoreData;
                  // 스크롤이 끝까지 내려갔을 때 추가로 옵션 로딩
                  if (scrollHeight - scrollTop === clientHeight && hasMore && loading === false) {
                    onFetchMore();
                  }
                }}
              />
            </Form.Item>
          )}
        </Form>
        <Typography.Text strong type="warning">
          {modalMessage}
        </Typography.Text>
        {decreaseStockFlag && (
          <Typography.Text strong type="danger">
            {decreaseStockFlagMessage}
          </Typography.Text>
        )}
      </Space>
      {openConfirmModal && (
        <ConfirmModal
          visible={openConfirmModal}
          onOk={() => {
            const formData = formInstance.getFieldsValue();
            onConfirm(formData);
            setOpenConfirmModal(false);
          }}
          onCancel={() => setOpenConfirmModal(false)}
          topOfMuiDialog={true}
        />
      )}
    </Modal>
  );
};
</file>

<file path="src/app/views/order/orders/components/FulfillmentInspectDetailModal.tsx">
import { GrapheneRelayConnectionMaxLimitEnum } from "@assets/constants/config";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import NumberComponent from "@src/app/components/Number";
import { DateTime } from "@src/app/providers/DateProvider";
import { useProductVariantForInspectQuery } from "@src/app/views/product/products/api/queries";
import {
  ProductVariantForInspect_productVariant_rackStocks,
  ProductVariantForInspect_productVariant_rackStocks_location,
} from "@src/app/views/product/products/api/types/ProductVariantForInspect";
import { maybe } from "@utils/misc";
import { utils } from "@utils/utils";
import { Button, Card, Col, Image, Modal, Row, Space, Table, Tabs, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { useFulfillmentLineListForInspectQuery } from "../api/queries";
import { FulfillmentLineListForInspect_fulfillmentLines_edges_node } from "../api/types/FulfillmentLineListForInspect";

const tabKeys = {
  product: "product",
  delivery: "delivery",
};

interface RackStockDetailByPickingLocation {
  id: string;
  location: ProductVariantForInspect_productVariant_rackStocks_location;
  rackStockDetails: ProductVariantForInspect_productVariant_rackStocks[];
}

interface FulfillmentInspectDetailModalProps {
  open: boolean;
  sku: string;
  fulfillmentLineIds: string[];
  onClose: () => void;
}

export const FulfillmentInspectDetailModal: React.FC<FulfillmentInspectDetailModalProps> = (props) => {
  const { open, sku, fulfillmentLineIds, onClose } = props;
  const isMobile = utils.checkMobile();

  const querySkip = !open || !sku || fulfillmentLineIds.length === 0;

  const { data: productVariantData, loading: productVariantLoading } = useProductVariantForInspectQuery({
    skip: querySkip,
    variables: { sku },
  });
  const productVariant = maybe(() => productVariantData.productVariant, null);

  const { data: fulfillmentLineListData, loading: fulfillmentLineListLoading } = useFulfillmentLineListForInspectQuery({
    skip: querySkip,
    variables: { first: GrapheneRelayConnectionMaxLimitEnum.default, filter: { ids: fulfillmentLineIds } },
  });
  const fulfillmentLineList = maybe(() => fulfillmentLineListData.fulfillmentLines.edges.map((edge) => edge.node), []);

  const productImageList = maybe(() => productVariant.product.images, []);
  const filteredProductImageList = productImageList.filter((image) => !utils.isEmpty(image.url, true));
  const productImageNode = (
    <Card title="제품 이미지" size="small" loading={productVariantLoading}>
      {filteredProductImageList.length > 0 ? (
        <Row justify="start" gutter={[8, 8]}>
          {filteredProductImageList.map((img) => (
            <Col key={img.id}>
              <Image height={120} width={120} src={img.url} />
            </Col>
          ))}
        </Row>
      ) : (
        <Typography.Text type="secondary">등록된 이미지가 없습니다.</Typography.Text>
      )}
    </Card>
  );
  const rackStockDetailList = maybe(() => productVariant.rackStocks, []);
  const rackStockDetailListByPickingLocation = rackStockDetailList
    .reduce<RackStockDetailByPickingLocation[]>((acc, rackStockDetail) => {
      const location = rackStockDetail.location;
      if (utils.isEmpty(location) || location.canPicking === false) {
        return acc;
      }
      const locationId = location.id;
      const existingRow = acc.find((item) => item.id === locationId);
      if (utils.isEmpty(existingRow)) {
        acc.push({
          id: locationId,
          location: rackStockDetail.location,
          rackStockDetails: [rackStockDetail],
        });
      } else {
        existingRow.rackStockDetails.push(rackStockDetail);
      }
      return acc;
    }, [])
    .sort((a, b) => a.location.name.localeCompare(b.location.name));

  const columnsForProduct: ColumnsType<RackStockDetailByPickingLocation> = [
    {
      title: "피킹 로케이션",
      key: "locationName",
      align: "center",
      width: 120,
      render: (_, record) => record.location.name || "-",
    },
    {
      title: `${columnNameConstant.stock.STOCK_QUANTITY} 합계`,
      key: "remainQuantity",
      align: "center",
      width: 100,
      render: (_, record) => {
        const totalRemainQuantity = record.rackStockDetails.reduce((sum, detail) => sum + detail.remainQuantity, 0);
        return <NumberComponent value={totalRemainQuantity} />;
      },
    },
  ];
  const tableWidthSumForProduct = utils.calcTableColsWidthSum(columnsForProduct);

  const columnsForDelivery: ColumnsType<FulfillmentLineListForInspect_fulfillmentLines_edges_node> = [
    {
      title: columnNameConstant.delivery.FULFILLMENT_COMPOSED_ID,
      key: "fulfillmentComposedId",
      align: "center",
      width: 130,
      render: (_, record) => record.fulfillment.composedIdWithPrefix,
    },
    {
      title: columnNameConstant.delivery.DELIVERY_START_DATE,
      key: "deliveryStartDate",
      align: "center",
      width: 120,
      render: (_, record) => <DateTime date={record.fulfillment.deliveryStartDate} />,
    },
    {
      title: columnNameConstant.fulfillment.ORDER_QUANTITY,
      key: "quantity",
      align: "center",
      width: 100,
      render: (_, record) => <NumberComponent value={record.quantity} />,
    },
    {
      title: columnNameConstant.delivery.COURIER_NAME,
      key: "courierName",
      align: "center",
      width: 100,
      render: (_, record) => record.fulfillment.courier?.name || "-",
    },
    {
      title: columnNameConstant.delivery.TRACKING_NO,
      key: "trackingNumber",
      width: 120,
      render: (_, record) => record.fulfillment.trackingNumber,
    },
  ];
  const tableWidthSumForDelivery = utils.calcTableColsWidthSum(columnsForDelivery);

  return (
    <Modal
      destroyOnClose
      open={open}
      title={`검수 상세 정보(${sku})`}
      width={600}
      onCancel={onClose}
      footer={<Button onClick={onClose}>닫기</Button>}
    >
      <Tabs
        defaultActiveKey={tabKeys.product}
        type="card"
        size="small"
        items={[
          {
            key: tabKeys.product,
            label: "제품",
            children: (
              <Space direction="vertical">
                <Table<RackStockDetailByPickingLocation>
                  {...commonTableProps}
                  loading={productVariantLoading}
                  columns={columnsForProduct}
                  dataSource={rackStockDetailListByPickingLocation}
                  scroll={{ x: tableWidthSumForProduct, y: isMobile ? 200 : 400 }}
                />
                {productImageNode}
              </Space>
            ),
          },
          {
            key: tabKeys.delivery,
            label: "배송",
            children: (
              <Table<FulfillmentLineListForInspect_fulfillmentLines_edges_node>
                {...commonTableProps}
                loading={fulfillmentLineListLoading}
                columns={columnsForDelivery}
                dataSource={fulfillmentLineList}
                scroll={{ x: tableWidthSumForDelivery, y: isMobile ? 200 : 400 }}
              />
            ),
          },
        ]}
      />
    </Modal>
  );
};
</file>

