  trim: (str) => {
    const ret = str;
    if (ret) {
      return ret.trim();
    }
    return ret;
  },
  trimObject: <T extends Object>(obj: T): T => {
    const isFileOrBlob = utils.isFileOrBlob(obj);
    const isObject = utils.isObject(obj);
    if (isFileOrBlob || isObject === false || utils.isEmpty(obj)) {
      return obj;
    }

    const isArray = Array.isArray(obj);
    if (isArray) {
      // obj가 배열로 전달된 경우, 같은 타입인 배열로 리턴하기 위해 as unknown as T로 타입 지정
      return obj.map(utils.trimObject) as unknown as T;
    }

    const trimmedObj = Object.keys(obj).reduce((acc, key) => {
      const value = obj[key];
      const trimmedValue = typeof value === "string" ? utils.trim(value) : utils.trimObject(value);
      acc[key] = trimmedValue;
      return acc;
    }, {} as T);
    return trimmedObj;
  },
  isEmpty: (value, trim = true) => {
    if (value === null || value === undefined) {
      return true;
    }
    if (typeof value === "undefined" || value === "undefined") {
      return true;
    }
    if (typeof value === "string") {
      if (trim) {
        value = utils.trim(value);
      }
      if (value === "") {
        return true;
      }
    }
    // 일반적인 isNaN 메서드와 다르게, Number.isNaN은 값이 NaN 자체인 경우에만 true
    if (Number.isNaN(value)) {
      return true;
    }
    if (Array.isArray(value) && value.length < 1) {
      return true;
    }
    if (
      typeof value === "object" &&
      value.constructor.name === "Object" &&
      Object.keys(value).length < 1 &&
      // @ts-ignore
      Object.getOwnPropertyNames(value) < 1
    ) {
      return true;
    }
    // new String()
    if (typeof value === "object" && value.constructor.name === "String" && Object.keys(value).length < 1) {
      return true;
    }

    return false;
  },
  allEmpty: (valueAry: any[], trim = true) => {
    if (utils.isEmpty(valueAry, trim)) {
      return true;
    }
    return valueAry.every((value) => utils.isEmpty(value, trim));
  },
  toMoneyText: (value) => {
    const convNumber = utils.convertToNumber(value);

    if (convNumber === undefined) {
