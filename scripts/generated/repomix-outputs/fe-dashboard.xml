<file path="src/app/components/AssignProductDialog/AssignProductDialog.tsx">
import useSearchQuery from "@hooks/useSearchQuery";
import { SearchProducts_search_edges_node } from "@src/api/searches/types/SearchProducts";
import { makeProductHasVariants } from "@src/app/views/product/products/components/ProductListPage/ProductListTableSettings";
import {
  getProductSku,
  makeProductQtyPerBoxText,
  makeProductSpecTextFromAttr,
} from "@src/app/views/product/products/utils/data";
import { FetchMoreProps } from "@src/global/core/types/types";
import { transformTrackInventoryVariantType } from "@utils/misc";
import { utils } from "@utils/utils";
import { Input, Modal, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import { TableRowSelection } from "antd/lib/table/interface";
import React from "react";

import { commonTableProps } from "../antd/Table/TableProps";
import { columnNameConstant } from "../ColumnHelper/columnConstant";

export interface FormData {
  products: SearchProducts_search_edges_node[];
  query: string;
}

export interface AssignProductDialogProps extends FetchMoreProps {
  open: boolean;
  title?: string;
  products: SearchProducts_search_edges_node[];
  loading: boolean;
  // 직거래 상품 리스트에서 상품 추가 시, 일부 컬럼 미노출 하기 위해 전달 - 옵션명, 재고 운영, 옵션형 여부 컬럼 제외
  isFulfilledByVendor?: boolean;
  onClose: () => void;
  onFetch: (value: string) => void;
  onSubmit: (data: SearchProducts_search_edges_node[]) => void;
}

const getDefaultVariant = (product: SearchProducts_search_edges_node) =>
  product.variants?.find((variant) => variant.id === product.defaultVariantId);

const AssignProductDialog: React.FC<AssignProductDialogProps> = (props) => {
  const { title, hasMore, open, loading, products, isFulfilledByVendor, onClose, onFetch, onFetchMore, onSubmit } =
    props;
  const [query, onQueryChange, resetQuery] = useSearchQuery(onFetch);
  const [selectedProducts, setSelectedProducts] = React.useState<SearchProducts_search_edges_node[]>([]);

  const handleClose = () => {
    setSelectedProducts([]);
    resetQuery();
    onClose();
  };

  const handleSubmit = () => {
    onSubmit(selectedProducts);
    handleClose();
  };

  const columns: ColumnsType<SearchProducts_search_edges_node> = [];
  columns.push(
    {
      title: columnNameConstant.product.SKU,
      key: "sku",
      align: "center",
      width: 120,
      render: (_, record) => getProductSku(record),
    },
    {
      title: columnNameConstant.product.PRODUCT_NAME,
      key: "productName",
      align: "left",
      width: 150,
      render: (_, record) => record?.name || "-",
    }
  );
  if (!isFulfilledByVendor) {
    columns.push({
      title: columnNameConstant.product.VARIANT_NAME,
      key: "variantName",
      align: "left",
      width: 100,
      render: (_, record) => {
        const defaultVariant = getDefaultVariant(record);
        return defaultVariant?.name || "-";
      },
    });
  }
  columns.push(
    {
      title: columnNameConstant.product.DETAIL_INFO,
      key: "attributes",
      align: "left",
      width: 200,
      render: (_, record) => {
        const hasVariants = !!record?.productType?.hasVariants;
        const defaultVariant = getDefaultVariant(record);
        const targetAttributes = hasVariants ? defaultVariant?.attributes : record?.attributes;
        return makeProductSpecTextFromAttr(targetAttributes) || "-";
      },
    },
    {
      title: columnNameConstant.product.PRODUCT_QTY_PER_BOX,
      key: "qtyPerBox",
      align: "right",
      width: 80,
      render: (_, record) => makeProductQtyPerBoxText(getDefaultVariant(record)) || "-",
    }
  );
  if (!isFulfilledByVendor) {
    columns.push(
      {
        title: columnNameConstant.product.TRACK_INVENTORY,
        key: "trackInventoryVariantType",
        align: "center",
        width: 100,
        render: (_, record) => {
          const defaultVariant = record.variants
            ? record.variants.find((variant) => variant.id === record.defaultVariantId)
            : undefined;
          return transformTrackInventoryVariantType(defaultVariant?.trackInventory);
        },
      },
      {
        title: columnNameConstant.product.HAS_VARIANTS,
        key: "hasVariants",
        align: "center",
        width: 100,
        render: (_, record) => makeProductHasVariants(record),
      }
    );
  }
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const rowSelection: TableRowSelection<SearchProducts_search_edges_node> = {
    fixed: true,
    selectedRowKeys: selectedProducts.map((selected) => selected.id),
    onChange: (_selectedRowKeys, selectedRows) => setSelectedProducts(selectedRows),
  };

  return (
    <Modal
      destroyOnClose
      title={title || "제품 추가"}
      open={open}
      onCancel={handleClose}
      onOk={handleSubmit}
      okText="추가"
      okButtonProps={{ loading }}
      width={600}
      maskClosable={false}
    >
      <Space direction="vertical">
        <Input.Search value={query} onChange={onQueryChange} placeholder="제품코드 / 제품명 검색" loading={loading} />
        {products && (
          <Table
            {...commonTableProps}
            columns={columns}
            dataSource={products}
            rowSelection={{ ...rowSelection }}
            scroll={{ x: tableWidthSum, y: 500 }}
            footer={
              hasMore &&
              (() => (
                <Row justify="center">
                  <Typography.Link onClick={onFetchMore}>더 보기</Typography.Link>
                </Row>
              ))
            }
          />
        )}
      </Space>
    </Modal>
  );
};
export default AssignProductDialog;
</file>

