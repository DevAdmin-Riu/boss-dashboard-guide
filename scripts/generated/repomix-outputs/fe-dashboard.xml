import { CourierCreateInput } from "@src/api/types/globalTypes";
import AppHeader from "@src/app/components/AppHeader";
import { ConfirmButtonTransitionState } from "@src/app/components/ConfirmButton";
import Grid from "@src/app/components/Grid";
import PageHeader from "@src/app/components/PageHeader";
import SaveButtonBar from "@src/app/components/SaveButtonBar";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { utils } from "@utils/utils";
import { Form } from "antd";
import React, { useEffect, useState } from "react";

import CourierInfo from "../CourierInfo";

export interface CourierFormInput {
  name?: string | null;
  code?: string | null;
  codeGoodsflow?: string | null;
  trackingPage?: string | null;
  mobilePage?: string | null;
  strDigitAllowedValues?: string | null;
  isActive?: boolean | null;
  canTrace?: boolean | null;
}

interface CourierCreatePageProps {
  disabled: boolean;
  saveButtonBarState: ConfirmButtonTransitionState;
  onBack: () => void;
  onSubmit: (data: CourierCreateInput) => void;
}

const CourierCreatePage: React.FC<CourierCreatePageProps> = ({ disabled, onBack, onSubmit, saveButtonBarState }) => {
  const [hasChanged, setHasChanged] = useState<boolean>(false);
  const [form] = Form.useForm<CourierFormInput>();

  const initialValues: CourierFormInput = {
    name: "",
    code: "",
    codeGoodsflow: "",
    trackingPage: "",
    mobilePage: "",
    strDigitAllowedValues: null,
    isActive: true,
    canTrace: true,
  };

  useEffect(() => {
    form.resetFields();
  }, []);

  const onFinish = (values: CourierFormInput) => {
    onSubmit({
      name: values.name,
      code: values.code,
      codeGoodsflow: values.codeGoodsflow,
      trackingPage: values.trackingPage,
      mobilePage: values.mobilePage,
      digitAllowedValues: utils.isEmpty(values.strDigitAllowedValues)
        ? []
        : values.strDigitAllowedValues
            .split(",")
            .map((item) => Number(item))
            .sort((a, b) => a - b),
      isActive: values.isActive,
      canTrace: values.canTrace,
    });
  };

  return (
    <Form
      form={form}
      name="corier-create-form"
      disabled={disabled}
      layout="vertical"
      size="large"
      initialValues={initialValues}
      onValuesChange={() => setHasChanged(true)}
      onFinish={onFinish}
    >
      <AppHeader onBack={onBack}>{sectionNames.couriers}</AppHeader>
      <PageHeader title="택배사 추가" />
      <Grid>
        <CourierInfo />
      </Grid>
      <SaveButtonBar
        disabled={disabled || !hasChanged}
        onCancel={onBack}
        onSave={form.submit}
        state={saveButtonBarState}
      />
    </Form>
  );
};
export default CourierCreatePage;
</file>

