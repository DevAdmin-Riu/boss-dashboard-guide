<file path="src/app/components/BreadcrumbMenu/BreadcrumbMenu.tsx">
import { utils } from "@utils/utils";
import { Breadcrumb, Card } from "antd";
import React from "react";
import useRouter from "use-react-router";

import { IMenuItem } from "../AppLayout/menuStructureStaff";

interface BreadcrumbMenuProps {
  menuItems: IMenuItem[];
}

const BreadcrumbMenu: React.FC<BreadcrumbMenuProps> = (props) => {
  const { menuItems } = props;
  const { location } = useRouter();

  const pathName = location.pathname;

  if (pathName === "/") {
    return <></>;
  }

  let oneDepthValue: IMenuItem = null;
  let twoDepthValue: IMenuItem = null;

  for (const oneDepth of menuItems) {
    if (oneDepth.children === undefined) {
      continue;
    }
    for (const twoDepthChild of oneDepth.children) {
      const urls = [twoDepthChild.url];
      const baseUrls = [];
      if (!!twoDepthChild.navUrlList && twoDepthChild.navUrlList.length > 0) {
        urls.push(...twoDepthChild.navUrlList);
      }
      for (const url of urls) {
        const index = url.indexOf("?");
        const baseUrl = index === -1 ? url : url.substring(0, index);
        baseUrls.push(baseUrl);
      }

      if (baseUrls.includes(pathName)) {
        twoDepthValue = twoDepthChild;
        break;
      }
    }

    if (twoDepthValue !== null) {
      oneDepthValue = oneDepth;
      break;
    }
  }

  if (oneDepthValue === null || twoDepthValue === null) {
    return <></>;
  }

  const BreadCrumbItemList = [oneDepthValue, twoDepthValue];

  const isMobile = utils.checkMobile();
  if (isMobile) {
    return (
      <Breadcrumb separator=">">
        {BreadCrumbItemList.map((item, idx) => (
          <Breadcrumb.Item key={idx}>{item.label}</Breadcrumb.Item>
        ))}
      </Breadcrumb>
    );
  }
  return (
    <Card style={{ marginBottom: 20 }} size="small">
      <Breadcrumb separator=">" style={{ fontSize: 18, fontWeight: "bold" }}>
        {BreadCrumbItemList.map((item, idx) => (
          <Breadcrumb.Item key={idx}>{item.label}</Breadcrumb.Item>
        ))}
      </Breadcrumb>
    </Card>
  );
};

export default BreadcrumbMenu;
</file>

