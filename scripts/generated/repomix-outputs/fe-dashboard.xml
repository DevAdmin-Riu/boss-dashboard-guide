    active: opts.brandSearch.active,
  };
  const publishedFilter = {
    ...createOptionsField(0, TrainingDocListFilterKeys.published, "주문 구분", [opts.published.value], false, [
      {
        label: "공개",
        value: PublishedEnum.PUBLISHED,
