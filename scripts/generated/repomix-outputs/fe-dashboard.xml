import { sectionNames } from "@assets/messages/sectionNames";
import { RefundStatusTypeEnum } from "@src/api/types/globalTypes";

import { RefundQuestionListViewRouteParams, RefundQuestionListViewUrlQueryParams } from "./urls";

export const getRefundQuestionListPageTitle = (routeParams: RefundQuestionListViewRouteParams) => {
  const { fulfilledBy, status } = routeParams;
  const isFbv = fulfilledBy === "vendor";
  switch (status) {
    case "requested":
      return isFbv ? sectionNames.refundQuestion.vsRequested : sectionNames.refundQuestion.requested;
    case "accepted":
      return isFbv ? sectionNames.refundQuestion.vsAccepted : sectionNames.refundQuestion.accepted;
    case "reject":
      return sectionNames.refundQuestion.reject;
    case "change-pending":
      return sectionNames.refundQuestion.changePending;
    case "change-success":
      return sectionNames.refundQuestion.changeSuccess;
    case "collected-inspect":
      return sectionNames.refundQuestion.collectedInspect;
    case "refund-pending":
      return sectionNames.refundQuestion.refundPending;
    case "refund-success":
      return sectionNames.refundQuestion.refundSuccess;
    case "stock-included-requested":
      return sectionNames.refundQuestion.stockIncludedRequested;
    default:
      return sectionNames.refundQuestion.allList;
  }
};

export const getDefaultRefundQaStatusListForRefundQuestionList = (
  routeParams: RefundQuestionListViewRouteParams
): RefundStatusTypeEnum[] => {
  const { status } = routeParams;
  const refundQaStatusList: RefundStatusTypeEnum[] = [];
  switch (status) {
    case "requested":
      refundQaStatusList.push(RefundStatusTypeEnum.REQUESTED);
      break;
    case "accepted":
      refundQaStatusList.push(RefundStatusTypeEnum.ACCEPTED);
      break;
    case "reject":
      refundQaStatusList.push(RefundStatusTypeEnum.REJECT);
      break;
    case "change-pending":
      refundQaStatusList.push(RefundStatusTypeEnum.CHANGE_PENDING);
      break;
    case "change-success":
      refundQaStatusList.push(RefundStatusTypeEnum.CHANGE_SUCCESS);
      break;
    case "collected-inspect":
      refundQaStatusList.push(RefundStatusTypeEnum.COLLECTED_INSPECT);
      break;
    case "refund-pending":
      refundQaStatusList.push(RefundStatusTypeEnum.REFUND_PENDING);
      break;
    case "refund-success":
      refundQaStatusList.push(RefundStatusTypeEnum.REFUND_SUCCESS);
      break;
    case "stock-included-requested":
      refundQaStatusList.push(RefundStatusTypeEnum.STOCK_INCLUDED_REQUESTED);
      break;
    case "all":
      break;
  }

  return refundQaStatusList;
};

export const getRefundQuestionListDefaultParams = (
  routeParams: RefundQuestionListViewRouteParams
): RefundQuestionListViewUrlQueryParams => ({
  status: getDefaultRefundQaStatusListForRefundQuestionList(routeParams),
});
