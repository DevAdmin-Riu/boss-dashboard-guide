import { PvEstimateStatusEnum } from "@src/api/types/globalTypes";
import { Form, Modal, Radio, Typography } from "antd";
import React from "react";

interface PvEstimateStatusChangeModalProps {
  open: boolean;
  onClose: () => void;
  onOk: (status: PvEstimateStatusEnum) => void;
  loading: boolean;
}

const PvEstimateStatusChangeModal: React.FC<PvEstimateStatusChangeModalProps> = (props) => {
  const { open, onClose, onOk, loading } = props;
  const [form] = Form.useForm();
  const paragraphStyle = { marginBottom: 2 };
  return (
    <Modal
      open={open}
      onCancel={() => {
        onClose();
        form.resetFields();
      }}
      onOk={() => {
        const status: PvEstimateStatusEnum = form.getFieldValue("status");
        onOk(status);
      }}
      maskClosable={false}
      title={<Typography.Title level={4}>채택 여부 변경</Typography.Title>}
      cancelText="취소"
      confirmLoading={loading}
    >
      <Form form={form} initialValues={{ status: PvEstimateStatusEnum.APPROVED }} layout="vertical">
        <Typography.Paragraph style={paragraphStyle}>
          * 선택한 견적 전체의 채택 여부를 일괄로 변경합니다.
        </Typography.Paragraph>
        <Typography.Paragraph style={paragraphStyle}>
          - 이미 채택 또는 탈락한 견적도 다시 채택 여부를 변경할 수 있습니다.
        </Typography.Paragraph>
        <Form.Item name="status">
          <Radio.Group>
            <Radio value={PvEstimateStatusEnum.APPROVED}>채택</Radio>
            <Radio value={PvEstimateStatusEnum.REJECTED}>탈락</Radio>
          </Radio.Group>
        </Form.Item>
      </Form>
    </Modal>
  );
};

export default PvEstimateStatusChangeModal;
