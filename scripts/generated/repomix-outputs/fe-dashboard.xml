import { buttonText } from "@assets/messages/buttonText";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import { CardTitleAntd } from "@src/app/components/CardTitle/CardTitleAntd";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import { PermissionGroupDetails_permissionGroup_users } from "@src/app/views/settings/permissionGroups/api/types/PermissionGroupDetails";
import { sortMembers } from "@src/app/views/settings/permissionGroups/sort";
import { MembersListUrlSortField } from "@src/app/views/settings/permissionGroups/urls";
import { commonMsg, permissionMsg } from "@src/global/assets/messages/commonMsg";
import { ListActions, SortPage } from "@src/global/core/types/types";
import { getDisplayUserName } from "@utils/misc";
import { utils } from "@utils/utils";
import { Avatar, Button, Card, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { createSorterStructure } from "./sorters";

interface PermissionGroupProps extends ListActions, SortPage<MembersListUrlSortField> {
  users: PermissionGroupDetails_permissionGroup_users[];
  disabled: boolean;
  selectedRowKeys: string[];
  onUnassign: (ida: string[]) => void;
  onAssign: () => void;
}

const PermissionGroupMemberList: React.FC<PermissionGroupProps> = (props) => {
  const { disabled, users, selectedRowKeys, sort, toolbar, selected, onUnassign, onAssign, onSort, toggle, toggleAll } =
    props;
  const sorterStructure = createSorterStructure();
  const members = users?.slice().sort(sortMembers(sort?.sort, sort?.asc));
  const columns: ColumnsType<PermissionGroupDetails_permissionGroup_users> = [
    {
      title: "이름",
      key: "name",
      align: "left",
      width: 150,
      render: (_, record) => (
        <Space>
          <Avatar size={40} src={record.avatar?.url}>
            {record.firstName}
          </Avatar>
          <Space direction="vertical" size={0}>
            {getDisplayUserName(record)}
            <Typography.Text type="secondary" style={{ fontSize: "12px" }}>
              {!record ? "-" : record.isActive ? commonMsg.active : commonMsg.inactive}
            </Typography.Text>
          </Space>
        </Space>
      ),
    },
    {
      title: "이메일",
      key: "email",
      align: "center",
      width: 200,
      render: (_, record) => record.email || "-",
    },
    {
      key: "action",
      align: "center",
      width: 80,
      render: (_, record) => (
        <Button danger size="small" type="primary" onClick={() => onUnassign([record.id])} disabled={disabled}>
          {buttonText.unassign}
        </Button>
      ),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  const emptyText = (
    <Space direction="vertical">
      <Typography.Text type="secondary">이 그룹에 연동된 관리자가 없습니다.</Typography.Text>
      <Typography.Text type="secondary">'관리자 연동' 버튼을 통해 관리자를 연동해주세요.</Typography.Text>
    </Space>
  );

  return (
    <Card
      title={
        <CardTitleAntd
          title={permissionMsg.groupMembers}
          extra={
            <Space>
              <Button type="primary" onClick={onAssign} disabled={disabled}>
                관리자 연동
              </Button>
              {toolbar}
            </Space>
          }
        />
      }
      bodyStyle={{ padding: 0 }}
    >
      <Row justify="end">
        <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
      </Row>
      <Table
        {...commonTableProps}
        loading={disabled}
        columns={columns}
        dataSource={members}
        rowSelection={{
          fixed: true,
          selectedRowKeys,
          getCheckboxProps: () => ({ disabled }),
          onSelect: (record) => toggle(record.id),
          onSelectAll: (_selected, selectedRows) => toggleAll(selectedRows, selected),
        }}
        scroll={{ x: tableWidthSum }}
        locale={{ emptyText }}
      />
    </Card>
