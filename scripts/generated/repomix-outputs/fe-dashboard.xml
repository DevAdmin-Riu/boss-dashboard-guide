import { useTableScrollInitialize } from "@hooks/useTableScrollInitialize";
import { commonTableProps } from "@src/app/components/antd/Table/TableProps";
import AppHeader from "@src/app/components/AppHeader";
import NumberComponent from "@src/app/components/Number";
import { SorterDropdown } from "@src/app/components/SorterDropdown/SorterDropdown";
import TableListFooter from "@src/app/components/TableListFooter";
import { MenuListViewUrlSortField } from "@src/app/views/settings/navigation/urls";
import { sectionNames } from "@src/global/assets/messages/sectionNames";
import { ListActions, PaginateListProps, SortPage } from "@src/global/core/types/types";
import { utils } from "@utils/utils";
import { Button, Card, Col, Popconfirm, Row, Space, Table, Typography } from "antd";
import { ColumnsType } from "antd/lib/table";
import React from "react";

import { MenuList_menus_edges_node } from "../../api/types/MenuList";
import { createSorterStructure } from "./sorters";

export interface MenuListPageProps extends PaginateListProps, ListActions, SortPage<MenuListViewUrlSortField> {
  menus: MenuList_menus_edges_node[];
  selectedRowKeys: string[];
  onBack: () => void;
  onDelete: (id: string) => void;
}

const MenuListPage: React.FC<MenuListPageProps> = (props) => {
  const {
    menus,
    selectedRowKeys,
    sort,
    selected,
    toolbar,
    onAdd,
    onBack,
    onDelete,
    onSort,
    onRowClick,
    toggle,
    toggleAll,
    ...listProps
  } = props;
  const sorterStructure = createSorterStructure();
  const { tableRef, tableScrollY } = useTableScrollInitialize();
  const columns: ColumnsType<MenuList_menus_edges_node> = [
    {
      title: "보스몰 메뉴 이름",
      key: "name",
      align: "left",
      width: 200,
      render: (_, record) =>
        !!onRowClick ? (
          <Typography.Link onClick={() => onRowClick(record.id)}>{record.name || "-"}</Typography.Link>
        ) : (
          record.name || "-"
        ),
    },
    {
      title: "메뉴 수",
      key: "menuCnt",
      align: "right",
      width: 80,
      render: (_, record) => <NumberComponent value={record.items?.length} />,
    },
    {
      key: "action",
      align: "center",
      width: 100,
      render: (_, record) => (
        <Popconfirm
          title="선택한 메뉴를 정말로 삭제하시겠습니까?"
          onConfirm={() => onDelete(record.id)}
          okText="삭제"
          cancelText="취소"
          okButtonProps={{ danger: true }}
        >
          <Button danger size="small" type="primary" disabled={listProps.disabled}>
            삭제
          </Button>
        </Popconfirm>
      ),
    },
  ];
  const tableWidthSum = utils.calcTableColsWidthSum(columns);

  return (
    <>
      <AppHeader onBack={onBack}>{sectionNames.configuration}</AppHeader>

      <Space direction="vertical" size={24}>
        <Row justify="space-between">
          <Col>
            <Typography.Title level={4}>{sectionNames.navigation}</Typography.Title>
          </Col>
          <Col>
            <Space>
              <Button type="primary" shape="round" onClick={onAdd}>
                보스몰 메뉴 추가
              </Button>
              {toolbar}
            </Space>
          </Col>
        </Row>
        <Card>
          <Row justify="end">
            <SorterDropdown sorterStructure={sorterStructure} sort={sort} onSort={onSort} />
          </Row>
          <Table
            {...commonTableProps}
            ref={tableRef}
            loading={listProps.disabled}
            columns={columns}
            dataSource={menus}
            rowSelection={{
              fixed: true,
              selectedRowKeys,
              onSelect: (record) => toggle(record.id),
              onSelectAll: (_selected, selectedRows) => toggleAll(selectedRows, selected),
            }}
            scroll={{ x: tableWidthSum, y: tableScrollY }}
            footer={() => <TableListFooter {...listProps} />}
          />
        </Card>
      </Space>
    </>
  );
};
export default MenuListPage;
