<file path="src/app/views/settings/siteSettings/components/SiteSettingsMobileAppInfo/utils.ts">
import { MobileAppTypeEnum } from "@src/api/types/globalTypes";

export const getMobileAppName = (appType: MobileAppTypeEnum) => {
  switch (appType) {
    case MobileAppTypeEnum.DASHBOARD_ANDROID:
      return "포장보스 상점관리자 - 안드로이드";
    case MobileAppTypeEnum.DAHSBOARD_IOS:
      return "포장보스 상점관리자 - iOS";
    case MobileAppTypeEnum.STOREFRONT_ANDROID:
      return "포장보스 - 안드로이드";
    case MobileAppTypeEnum.STOREFRONT_IOS:
      return "포장보스 - iOS";
    default:
      return "-";
  }
};

export const getCleanedMobileAppVersion = (appVersion: string) => {
  const appVersionArr = appVersion.split(".");
  const cleanedAppVersionStr = appVersionArr
    .map((el) => {
      if (!isNaN(parseInt(el, 10))) {
        return parseInt(el, 10).toString();
      }
    })
    .join(".");

  return cleanedAppVersionStr;
};
</file>

