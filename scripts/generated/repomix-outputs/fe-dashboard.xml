type TFormData = StrictOmit<CreditsEventCreateInput, "type">;

interface CreditsEventCreateModalProps {
  open: boolean;
  loading: boolean;
  eventType: PointsEventTypeEnum;
  customerName: string;
  customer: BrandAccountDetails_user | BrandStoreDetails_brandStore_ownerUser;
  onClose: () => void;
}

export const CreditsEventCreateModal: React.FC<CreditsEventCreateModalProps> = (props) => {
  const { open, loading, eventType, customerName, customer, onClose } = props;
  const [confirmModalOpen, setConfirmModalOpen] = useState<boolean>(false);
  const cashableCredits = customer?.cashableCredits || 0;
  const nonCashableCredits = customer?.nonCashableCredits || 0;
  const eventTypeText = utils.isEmpty(eventType) ? "" : eventType === PointsEventTypeEnum.DEDUCTION ? "차감" : "충전";
  const maxCashableCredits = eventType === PointsEventTypeEnum.DEDUCTION ? cashableCredits : Infinity;
  const maxNonCashableCredits = eventType === PointsEventTypeEnum.DEDUCTION ? nonCashableCredits : Infinity;

  const [form] = useForm<TFormData>();
  const TypeSafeForm = getTypeSafeForm<TFormData>(form);

  const qtyWatched = TypeSafeForm.getUseFormWatched({ name: "qty" });
  const isCashableWatched = TypeSafeForm.getUseFormWatched({ name: "isCashable" });

  // 차감 모드에서 잔액이 0인 경우 해당 라디오 버튼 비활성화
  const isCashableDisabled = eventType === PointsEventTypeEnum.DEDUCTION && cashableCredits === 0;
  const isNonCashableDisabled = eventType === PointsEventTypeEnum.DEDUCTION && nonCashableCredits === 0;

  // 초기값: 차감 모드에서 cashableCredits가 0이면 nonCashableCredits 선택
  const defaultIsCashable = eventType === PointsEventTypeEnum.DEDUCTION && cashableCredits === 0 ? false : true;
  const initialValues: TFormData = { qty: undefined, description: undefined, isCashable: defaultIsCashable };

  const currentMaxCredits = isCashableWatched ? maxCashableCredits : maxNonCashableCredits;

  useEffect(() => {
    if (open) {
      form.resetFields();
    }
  }, [open]);

  const [creditsEventCreate, creditsEventCreateOpts] = useCreditsEventCreateMutation({
    onCompleted: (data) => {
      const errors = data.creditsEventCreate.errors;
      const updatedUser = data.creditsEventCreate.user;
      const selectedIsCashable = TypeSafeForm.getFieldValue("isCashable");
      const updatedBalance = selectedIsCashable ? updatedUser?.cashableCredits : updatedUser?.nonCashableCredits;
      const creditsTypeLabel = selectedIsCashable ? paymentTerm.cashableCredits : paymentTerm.nonCashableCredits;

      const successMsg = (
        <MultiLineTypography
          lines={[
            <Text strong>{customerName}</Text>,
            `${creditsTypeLabel}가 ${eventTypeText}되었습니다.`,
            <>
              <Text>
                (잔액: <Text strong>{updatedBalance != null ? updatedBalance.toLocaleString() : 0}원</Text>)
              </Text>
            </>,
          ]}
        />
      );
      utils.handleOnCompletedWithError(errors, successMsg, () => {
        setConfirmModalOpen(false);
        onClose();
      });
    },
  });

  return (
    <Modal
      forceRender
      closable={false}
      onCancel={onClose}
      open={open}
      title={
        <Typography.Text type="success">
          {customerName}: {paymentTerm.credits} {eventTypeText}
        </Typography.Text>
      }
      okText="확인"
      cancelText="뒤로"
      onOk={() => {
        form
          .validateFields()
          .then(() => {
            setConfirmModalOpen(true);
          })
          .catch((e) => {
            const errorMsg = e.errorFields[0].errors[0];
            showNotificationError(errorMsg);
          });
      }}
      okButtonProps={{
        loading: loading || creditsEventCreateOpts.loading,
        disabled: qtyWatched === undefined || qtyWatched <= 0,
      }}
      maskClosable={false}
    >
      <Form
        form={form}
        name="credits-event-create-form"
        colon={false}
        labelCol={{ span: 24 }}
        wrapperCol={{ span: 24 }}
        initialValues={initialValues}
        onFinish={(formData) => {
          creditsEventCreate({
            variables: { userId: customer?.id, input: { ...formData, type: eventType } },
            update: (cache, { data }) => {
              addEdgeToListCache<BrandStoreDetails, BrandStoreDetails_brandStore_ownerUser_creditsEvents_edges>({
                cache,
                query: brandStoreDetailsQuery,
                schemaName: "brandStore",
                edgeField: "brandStore.ownerUser.creditsEvents",
                newNode: data.creditsEventCreate.user.creditsEvents.edges[0],
                makeEdges: (edges, newEdge) => [newEdge, ...edges.slice(0, 4)],
              });
            },
          });
        }}
      >
        <Form.Item name={TypeSafeForm.getValidDataIndex("isCashable")} label="">
          <Radio.Group>
            <Radio value={true} disabled={isCashableDisabled}>
              {paymentTerm.cashableCredits}
            </Radio>
            <Radio value={false} disabled={isNonCashableDisabled}>
              {paymentTerm.nonCashableCredits}
            </Radio>
          </Radio.Group>
        </Form.Item>
        <Form.Item
          labelCol={{ span: 24 }}
          wrapperCol={{ span: 24 }}
          rules={[
            { required: true },
            { type: "integer" },
            getFormInputNumberMinValueRule({ min: 1 }),
            getFormInputNumberMaxValueRule({ max: currentMaxCredits }),
          ]}
          name={TypeSafeForm.getValidDataIndex("qty")}
          label={`${eventTypeText} 금액${
            currentMaxCredits !== Infinity ? ` (최대: ${currentMaxCredits.toLocaleString()}원)` : ""
          }`}
        >
          <InputNumber {...getInputNumberProps({ isCommaDisplay: true })} />
        </Form.Item>
        <Form.Item name={TypeSafeForm.getValidDataIndex("description")} label="상세내역">
          <Input />
        </Form.Item>
      </Form>
      {confirmModalOpen && (
        <ConfirmModal visible={confirmModalOpen} onOk={form.submit} onCancel={() => setConfirmModalOpen(false)} />
      )}
    </Modal>
  );
};
</file>

<file path="src/app/views/customer/customers/components/CreditsEventTableSettings.tsx">
import { UseNavigatorResult } from "@hooks/useNavigator";
import { CreditsEventType, RcoinsEventType } from "@src/api/types/globalTypes";
import { getStatisticClassName } from "@src/app/components/antd/Statistic/StatisticProps";
import { DownloadableColumnsType, DownloadableColumnType } from "@src/app/components/antd/Table/TableProps";
import { columnNameConstant } from "@src/app/components/ColumnHelper/columnConstant";
import { DateTime, getDateByFormat } from "@src/app/providers/DateProvider/DateTime";
import { brandDetailsViewUrl } from "@src/app/views/brand/brands/urls";
import { brandStoreDetailsViewUrl } from "@src/app/views/brand/brandStore/urls";
import { brandAccountDetailsUrl } from "@src/app/views/customer/customers/urls";
import { getBrandName, getDisplayUserName } from "@utils/misc";
import { Statistic, Tag, Typography } from "antd";
import React from "react";

import { CreditsEventList_creditsEvents_edges_node } from "../../points/api/types/CreditsEventList";
import { RcoinsEventList_rcoinsEvents_edges_node } from "../../points/api/types/RcoinsEventList";

const checkIsRechargeEvent = (type: CreditsEventType | RcoinsEventType) =>
  type === CreditsEventType.RECHARGE ||
  type === CreditsEventType.ADJUST_PRICE_RECHARGE ||
  type === CreditsEventType.CANCEL_ORDER ||
  type === CreditsEventType.REFUND ||
  type === RcoinsEventType.RECHARGE ||
  type === RcoinsEventType.CANCEL_ORDER ||
  type === RcoinsEventType.REFUND ||
  type === RcoinsEventType.REWARD;

// 회원 관리 > 충전금 이용 내역 리스트, 포인트 이용 내역 리스트 / 회원 상세 > 최근 충전금 이용 내역, 최근 포인트 이용 내역 테이블에서 모두 공통으로 사용
// navigate는 리스트 페이지에서만 전달
// isCredits는 충전금(true) / 포인트(false) 구분
export function getCustomerPointsTableColumns(navigate?: UseNavigatorResult, isCredits?: boolean) {
  const isListPage = !!navigate;

  const createdColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: columnNameConstant.user.CHARGE_DEDUCTED_DATE,
    align: "center",
    key: "created",
    width: 180,
    render: (_, record) => <DateTime date={record.created} />,
    renderExcel: (record) => getDateByFormat(record.created),
  };

  const brandCodeColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: columnNameConstant.brand.BRAND_CODE,
    align: "center",
    key: "brandCode",
    width: 100,
    render: (_, record) => record.user.brand.code || "-",
  };

  const brandNameColumn = (
    navigate
  ): DownloadableColumnType<CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node> => ({
    title: columnNameConstant.brand.BRAND_NAME,
    align: "center",
    key: "brandName",
    width: 150,
    render: (_, record) => (
      <Typography.Link onClick={() => navigate(brandDetailsViewUrl(record.user.brand.id))}>
        {getBrandName(record.user)}
      </Typography.Link>
    ),
    renderExcel: (record) => getBrandName(record.user) || "-",
  });

  const brandStoreCodeColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    align: "center",
    title: columnNameConstant.brandStore.BRAND_STORE_CODE,
    key: "brandStoreCode",
    width: 100,
    render: (_, record) => record.user?.brandStoreUser?.brandStore?.code ?? "-",
  };

  const brandStoreNameColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    align: "center",
    title: columnNameConstant.brandStore.BRAND_STORE_NAME,
    key: "brandStoreName",
    width: 150,
    render: (_, record) => {
      const brandStore = record.user?.brandStoreUser?.brandStore;
      return brandStore ? (
        <Typography.Link onClick={() => navigate(brandStoreDetailsViewUrl(brandStore.id))}>
          {brandStore.name}
        </Typography.Link>
      ) : (
        "-"
      );
    },
    renderExcel: (record) => record.user?.brandStoreUser?.brandStore?.name || "-",
  };

  const loginIdColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: columnNameConstant.user.ID,
    align: "center",
    key: "loginId",
    width: 100,
    render: (_, record) => record.user.loginId || "-",
  };

  const userNameColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: columnNameConstant.user.USER_NAME,
    align: "center",
    key: "userName",
    width: 200,
    render: (_, record) => (
      <Typography.Link onClick={() => navigate(brandAccountDetailsUrl(record.user.id))}>
        {record.user.firstName}
      </Typography.Link>
    ),
    renderExcel: (record) => getDisplayUserName(record.user) || "-",
  };

  const bizRegNoColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: columnNameConstant.common.BIZ_REG_NO,
    align: "center",
    key: "bizRegNo",
    width: 120,
    render: (_, record) => record.user.bizRegNo || "-",
  };

  const staffNameColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "담당자",
    align: "center",
    key: "staffName",
    width: 100,
    render: (_, record) => record.staff?.firstName || "-",
  };

  const descriptionColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "상세내용",
    align: "left",
    key: "description",
    width: 300,
    render: (_, record) => record.description || "-",
  };

  const isCashableColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "구분",
    align: "center",
    key: "isCashable",
    width: 120,
    render: (_, record) => {
      if ("isCashable" in record) {
        return <Tag color={record.isCashable ? "blue" : "red"}>{record.isCashable ? "출금 가능" : "출금 불가"}</Tag>;
      }
      return "-";
    },
    renderExcel: (record) => {
      if ("isCashable" in record) {
        return record.isCashable ? "출금 가능" : "출금 불가";
      }
      return "-";
    },
  };

  const rechargeColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "충전",
    align: "right",
    key: "recharge",
    width: 120,
    render: (_, record) =>
      checkIsRechargeEvent(record.type) ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-green"])}
          prefix={"+"}
          value={record.qty}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (checkIsRechargeEvent(record.type) ? record.qty : "-"),
  };

  const deductionColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "차감",
    align: "right",
    key: "deduction",
    width: 120,
    render: (_, record) =>
      !checkIsRechargeEvent(record.type) ? (
        <Statistic
          className={getStatisticClassName(["ant-statistic-small", "ant-statistic-red"])}
          prefix={"-"}
          value={record.qty}
        />
      ) : (
        "-"
      ),
    renderExcel: (record) => (!checkIsRechargeEvent(record.type) ? record.qty : "-"),
  };

  const qtyAfterColumn: DownloadableColumnType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = {
    title: "잔액",
    align: "right",
    key: "qtyAfter",
    width: 120,
    render: (_, record) => {
      const value = "totalAfter" in record ? record.totalAfter : record.qtyAfter;
      return <Statistic className={getStatisticClassName(["ant-statistic-small"])} value={value} />;
    },
    renderExcel: (record) => record.qtyAfter,
  };

  const columns: DownloadableColumnsType<
    CreditsEventList_creditsEvents_edges_node | RcoinsEventList_rcoinsEvents_edges_node
  > = [
    createdColumn,
    isListPage && brandCodeColumn,
    isListPage && brandNameColumn(navigate),
    isListPage && brandStoreCodeColumn,
    isListPage && brandStoreNameColumn,
    isListPage && loginIdColumn,
    isListPage && userNameColumn,
    isListPage && bizRegNoColumn,
    isListPage && staffNameColumn,
    descriptionColumn,
    isCredits && isCashableColumn,
    rechargeColumn,
    deductionColumn,
    qtyAfterColumn,
  ].filter(Boolean);

  return columns.filter(Boolean);
}
</file>

